+/* proto(requeue): the send controller is about to drop a scheduled packet or
+ * to chop its regenerated frames, and the packet holds this DATAGRAM frame.
+ * on_dg_write took the payload out of the application's queue, so the packet
+ * holds the only copy: keep it, in id order, for write_datagram.
+ */
+void
+lsquic_ietf_full_conn_dg_unsent (struct lsquic_conn *lconn, uint64_t dgram_id,
+                                        const void *data, size_t data_sz)
+{
+    struct ietf_full_conn *const conn = (struct ietf_full_conn *) lconn;
+    struct dg_unsent *du, **pp;
+
+    du = malloc(sizeof(*du) + data_sz);
+    if (!du)
+    {
+        LSQ_WARN("cannot keep unsent DATAGRAM frame %"PRIu64": malloc failed",
+                                                                    dgram_id);
+        return;
+    }
+    du->du_id = dgram_id;
+    du->du_len = data_sz;
+    memcpy(du->du_data, data, data_sz);
+    for (pp = &conn->ifc_dg_unsent; *pp && (*pp)->du_id <= dgram_id;
+                                                        pp = &(*pp)->du_next)
+        ;
+    du->du_next = *pp;
+    *pp = du;
+    conn->ifc_mflags |= MF_WANT_DATAGRAM_WRITE;
+    LSQ_DEBUG("handed back unsent DATAGRAM frame %"PRIu64" (%zu bytes)",
+                                                        dgram_id, data_sz);
+}
+
+
+/* proto(requeue): gen_datagram_frame callback that writes the first
+ * handed-back frame. */
+static ssize_t
+dg_unsent_write (struct lsquic_conn *lconn, void *buf, size_t sz)
+{
+    struct ietf_full_conn *const conn = (struct ietf_full_conn *) lconn;
+    const struct dg_unsent *const du = conn->ifc_dg_unsent;
+
+    if (du->du_len > sz)
+        return -1;
+    memcpy(buf, du->du_data, du->du_len);
+    conn->ifc_dg_id = du->du_id;
+    return du->du_len;
+}
