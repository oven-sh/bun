+/* proto(requeue): the packet is about to be dropped from the scheduled queue
+ * or to lose its regenerated frames before it is sent.  on_dg_write took the
+ * payload of each DATAGRAM frame out of the application's queue, so the
+ * packet holds the only copy.  Give each one back to the connection, which
+ * frames it again.  Returns the number of frames handed back.
+ */
+static unsigned
+send_ctl_hand_back_datagrams (struct lsquic_send_ctl *ctl,
+                                        struct lsquic_packet_out *packet_out)
+{
+    struct lsquic_conn *const lconn = ctl->sc_conn_pub->lconn;
+    struct packet_out_frec_iter pofi;
+    struct frame_rec *frec;
+    const void *data;
+    size_t data_sz;
+    unsigned n;
+
+    if (!(packet_out->po_frame_types & QUIC_FTBIT_DATAGRAM)
+            || !(lconn->cn_flags & LSCONN_IETF))
+        return 0;
+
+    n = 0;
+    for (frec = lsquic_pofi_first(&pofi, packet_out); frec;
+                                                frec = lsquic_pofi_next(&pofi))
+        if (QUIC_FRAME_DATAGRAM == frec->fe_frame_type
+            && lconn->cn_pf->pf_parse_datagram_frame(
+                    packet_out->po_data + frec->fe_off, frec->fe_len,
+                    &data, &data_sz) > 0)
+        {
+            lsquic_ietf_full_conn_dg_unsent(lconn, frec->fe_u.data,
+                                                            data, data_sz);
+            ++n;
+        }
+    LSQ_DEBUG("handed back %u DATAGRAM frame%s of packet #%"PRIu64, n,
+        n == 1 ? "" : "s", packet_out->po_packno);
+    return n;
+}
