#!/bin/sh
# Pushes every unit branch and the notes every 5 minutes, so that a restart of the machine loses little.
while true; do
  for u in parser typecheck cli conformance; do
    d=/workspace/wt/$u
    [ -d "$d" ] || continue
    b=$(git -C "$d" branch --show-current 2>/dev/null)
    [ "$b" = "robobun/abbc0c92/lint-$u" ] || continue
    if [ -n "$(git -C "$d" log --oneline "origin/$b..HEAD" 2>/dev/null | head -1)" ]; then
      git -C "$d" push -q origin "HEAD:$b" >/dev/null 2>&1 && echo "$(date +%H:%M) pushed $u" >> /workspace/tools/autopush.log
    fi
  done
  /workspace/tools/save-notes "autosave" >/dev/null 2>&1
  sleep 300
done
