#!/bin/sh
# Runs ONE heavy command (build, cargo, test) at a time on this machine, for every worktree.
# The machine has 32 GB for everything: two builds at a time end it. Job counts are capped for the same reason.
# usage: /workspace/tools/lk <command> [args...]
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-6}"
exec flock /workspace/tools/heavy.lock "$@"
