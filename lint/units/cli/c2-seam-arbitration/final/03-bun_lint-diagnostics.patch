index 0000000..9cb4376
--- /dev/null
+++ b/src/lint/scanner.rs
@@ -0,0 +1,70 @@
+//! Lines and characters of a position: `internal/scanner/scanner.go` and `ComputeECMALineStarts` of `internal/core/core.go`.
+
+/// The start of each line: a line ends after LF, CR, CR LF, U+2028 or U+2029.
+pub fn compute_ecma_line_starts(text: &[u8]) -> Vec<u32> {
+    // A position is a `u32`: what lies behind that range is not mapped.
+    let text = text.get(..u32::MAX as usize).unwrap_or(text);
+    let mut result: Vec<u32> = Vec::new();
+    let mut line_start: u32 = 0;
+    let mut pos: usize = 0;
+    while let Some(&b) = text.get(pos) {
+        pos += 1;
+        let ends_line = match b {
+            b'\n' => true,
+            b'\r' => {
+                if text.get(pos) == Some(&b'\n') {
+                    pos += 1;
+                }
+                true
+            }
+            // U+2028 and U+2029 are E2 80 A8 and E2 80 A9.
+            0xE2 => {
+                let is_separator = text.get(pos) == Some(&0x80)
+                    && matches!(text.get(pos + 1), Some(&0xA8) | Some(&0xA9));
+                if is_separator {
+                    pos += 2;
+                }
+                is_separator
+            }
+            _ => false,
+        };
+        if ends_line {
+            result.push(line_start);
+            line_start = u32::try_from(pos).unwrap_or(u32::MAX);
+        }
+    }
+    result.push(line_start);
+    result
+}
+
+/// The 0-based line whose start is the last one at or before `pos`.
+pub fn compute_line_of_position(line_starts: &[u32], pos: u32) -> usize {
+    match line_starts.binary_search(&pos) {
+        Ok(line) => line,
+        Err(next_line) => next_line.saturating_sub(1),
+    }
+}
+
+/// The 0-based line and the 0-based character, in UTF-16 code units, of a byte position.
+pub fn get_ecma_line_and_utf16_character_of_position(
+    text: &[u8],
+    line_starts: &[u32],
+    pos: u32,
+) -> (usize, usize) {
+    // Where the reference panics on a position outside the text, this takes the end of the text.
+    let pos = (pos as usize).min(text.len());
+    let line = compute_line_of_position(line_starts, u32::try_from(pos).unwrap_or(u32::MAX));
+    let line_start = line_starts.get(line).map_or(0, |&start| start as usize);
+    let character = text.get(line_start..pos).map_or(0, utf16_len);
+    (line, character)
+}
+
+/// The number of UTF-16 code units of UTF-8 text; each byte that is not part of valid UTF-8 counts as one.
+pub fn utf16_len(s: &[u8]) -> usize {
+    let mut n: usize = 0;
+    for chunk in s.utf8_chunks() {
+        n += chunk.valid().chars().map(char::len_utf16).sum::<usize>();
+        n += chunk.invalid().len();
+    }
+    n
+}
