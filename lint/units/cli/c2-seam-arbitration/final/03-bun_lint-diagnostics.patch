+//! `SortAndDeduplicateDiagnostics` of `internal/compiler/program.go` of typescript-go.
+
+use crate::diagnostic::{
+    Diagnostic, SourceFile, compare_diagnostics, equal_diagnostics,
+    equal_diagnostics_no_related_info,
+};
+
+/// The sort is stable: diagnostics that compare equal keep the order in which they were reported.
+pub fn sort_and_deduplicate_diagnostics(
+    files: &[SourceFile],
+    mut diagnostics: Vec<Diagnostic>,
+) -> Vec<Diagnostic> {
+    diagnostics.sort_by(|d1, d2| compare_diagnostics(files, d1, d2));
+    compact_and_merge_related_infos(files, diagnostics)
+}
+
+/// Keeps the first of each run of diagnostics that differ only by related information and gives it all of it.
+fn compact_and_merge_related_infos(
+    files: &[SourceFile],
+    diagnostics: Vec<Diagnostic>,
+) -> Vec<Diagnostic> {
+    let mut result: Vec<Diagnostic> = Vec::with_capacity(diagnostics.len());
+    let mut merged = false;
+    for d in diagnostics {
+        match result.last_mut() {
+            Some(last) if equal_diagnostics_no_related_info(files, last, &d) => {
+                last.related.extend(d.related);
+                merged = true;
+            }
+            _ => {
+                sort_merged_related_infos(files, result.last_mut(), merged);
+                merged = false;
+                result.push(d);
+            }
+        }
+    }
+    sort_merged_related_infos(files, result.last_mut(), merged);
+    result
+}
+
+fn sort_merged_related_infos(files: &[SourceFile], d: Option<&mut Diagnostic>, merged: bool) {
+    let Some(d) = d else { return };
+    if !merged {
+        return;
+    }
+    d.related
+        .sort_by(|r1, r2| compare_diagnostics(files, r1, r2));
+    d.related
+        .dedup_by(|r2, r1| equal_diagnostics(files, r1, r2));
+}
diff --git a/src/lint/scanner.rs b/src/lint/scanner.rs
