+//! The terminal format: Bun's code frame, with the code in front of the message.
+
+use core::fmt;
+use std::borrow::Cow;
+use std::io::Write;
+
+use crate::diagnostic::{Category, Diagnostic, FileId, MessageChain, SourceFile};
+use crate::diagnosticwriter::{FormattingOptions, write_flattened_diagnostic_message};
+use crate::tspath;
+
+struct ByteWriter<'a>(&'a mut Vec<u8>);
+
+impl fmt::Write for ByteWriter<'_> {
+    fn write_str(&mut self, s: &str) -> fmt::Result {
+        self.0.extend_from_slice(s.as_bytes());
+        Ok(())
+    }
+}
+
+/// One frame for each diagnostic, an empty line between two, as `bun_ast::Log::print` separates messages.
+pub fn write_code_frames<const ENABLE_ANSI_COLORS: bool>(
+    output: &mut Vec<u8>,
+    files: &[SourceFile],
+    diagnostics: &[Diagnostic],
+    format_opts: &FormattingOptions<'_>,
+) {
+    for (i, diagnostic) in diagnostics.iter().enumerate() {
+        if i > 0 {
+            output.extend_from_slice(b"\n\n");
+        }
+        let msg = to_msg(files, diagnostic, format_opts);
+        let _ = msg.write_format::<ENABLE_ANSI_COLORS>(&mut ByteWriter(output));
+    }
+    if !diagnostics.is_empty() {
+        output.push(b'\n');
+    }
+}
+
+fn to_msg(
+    files: &[SourceFile],
+    diagnostic: &Diagnostic,
+    format_opts: &FormattingOptions<'_>,
+) -> bun_ast::Msg {
+    let mut text: Vec<u8> = Vec::new();
+    let _ = write!(text, "{}: ", diagnostic.code);
+    bun_ast::Msg {
+        kind: match diagnostic.category {
+            Category::Error => bun_ast::Kind::Err,
+            Category::Warning => bun_ast::Kind::Warn,
+            Category::Suggestion | Category::Message => bun_ast::Kind::Note,
+        },
+        data: to_data(files, diagnostic, text, format_opts),
+        notes: diagnostic
+            .related
+            .iter()
+            .map(|related| to_data(files, related, Vec::new(), format_opts))
+            .collect(),
+        ..Default::default()
+    }
+}
+
+/// `text` holds what is printed in front of the message.
+fn to_data(
+    files: &[SourceFile],
+    diagnostic: &Diagnostic,
+    mut text: Vec<u8>,
+    format_opts: &FormattingOptions<'_>,
+) -> bun_ast::Data {
+    let chain: &[MessageChain] = &diagnostic.chain;
+    write_flattened_diagnostic_message(&mut text, &diagnostic.text, chain, b"\n");
+    bun_ast::Data {
+        text: Cow::Owned(text),
+        location: to_location(files, diagnostic.file, diagnostic, format_opts),
+    }
+}
+
+fn to_location(
+    files: &[SourceFile],
+    file: Option<FileId>,
+    diagnostic: &Diagnostic,
+    format_opts: &FormattingOptions<'_>,
+) -> Option<bun_ast::Location> {
+    let file = files.get(file?.0 as usize)?;
+    let range = bun_ast::Range {
+        loc: bun_ast::Loc {
+            start: i32::try_from(diagnostic.start).unwrap_or(i32::MAX),
+        },
+        len: i32::try_from(diagnostic.length).unwrap_or(i32::MAX),
+    };
+    let mut location = bun_ast::Location::init_or_null(Some(file.source()), range)?;
+    location.file = Cow::Owned(tspath::convert_to_relative_path(
+        file.file_name(),
+        format_opts.compare_paths_options,
+    ));
+    Some(location)
+}
