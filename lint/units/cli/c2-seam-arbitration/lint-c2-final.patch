+//! Port of the part of internal/tspath/path.go of typescript-go that names a file in a diagnostic.
+use bun_core::strings;
+
+const DIRECTORY_SEPARATOR: u8 = b'/';
+
+#[derive(Clone, Copy)]
+pub struct ComparePathsOptions<'a> {
+    pub use_case_sensitive_file_names: bool,
+    pub current_directory: &'a [u8],
+}
+
+/// What the reference asks the file system; this is the usual answer of the platform.
+pub const USE_CASE_SENSITIVE_FILE_NAMES: bool = !cfg!(any(windows, target_os = "macos"));
+
+fn is_any_directory_separator(char: u8) -> bool {
+    char == b'/' || char == b'\\'
+}
+
+fn is_volume_character(char: u8) -> bool {
+    char.is_ascii_alphabetic()
+}
+
+/// The length of the root of a name on disk, 0 for a relative name. The reference also knows URLs.
+pub fn get_root_length(path: &[u8]) -> usize {
+    let Some(&ch0) = path.first() else {
+        return 0;
+    };
+    if is_any_directory_separator(ch0) {
+        if path.get(1) != Some(&ch0) {
+            return 1;
+        }
+        let rest = path.get(2..).unwrap_or_default();
+        return match strings::index_of_char_usize(rest, ch0) {
+            Some(p1) => p1 + 2 + 1,
+            None => path.len(),
+        };
+    }
+    if is_volume_character(ch0) && path.get(1) == Some(&b':') {
+        return match path.get(2) {
+            None => 2,
+            Some(&ch2) if is_any_directory_separator(ch2) => 3,
+            Some(_) => 0,
+        };
+    }
+    0
+}
+
+pub fn is_rooted_disk_path(path: &[u8]) -> bool {
+    get_root_length(path) > 0
+}
+
+fn has_trailing_directory_separator(path: &[u8]) -> bool {
+    path.last().is_some_and(|&b| is_any_directory_separator(b))
+}
+
+pub fn normalize_slashes(path: &[u8]) -> Vec<u8> {
+    let mut result = path.to_vec();
+    for b in &mut result {
+        if *b == b'\\' {
+            *b = DIRECTORY_SEPARATOR;
+        }
+    }
+    result
+}
+
+/// `path` replaces `first_path` when it is absolute, else it is appended to it.
+pub fn combine_paths(first_path: &[u8], path: &[u8]) -> Vec<u8> {
+    let mut result = normalize_slashes(first_path);
+    if path.is_empty() {
+        return result;
+    }
+    let path = normalize_slashes(path);
+    if result.is_empty() || get_root_length(&path) != 0 {
+        return path;
+    }
+    if !has_trailing_directory_separator(&result) {
+        result.push(DIRECTORY_SEPARATOR);
+    }
+    result.extend_from_slice(&path);
+    result
+}
+
+// The root, then each name; the root of a relative path is empty.
+fn get_path_components(path: &[u8]) -> Vec<&[u8]> {
+    let (root, rest) = path
+        .split_at_checked(get_root_length(path))
+        .unwrap_or((path, b""));
+    let mut components: Vec<&[u8]> = vec![root];
+    components.extend(strings::split(rest, b"/"));
+    if components.len() > 1 && components.last().is_some_and(|last| last.is_empty()) {
+        components.pop();
+    }
+    components
+}
+
+fn reduce_path_components<'a>(components: &[&'a [u8]]) -> Vec<&'a [u8]> {
+    let Some((&root, names)) = components.split_first() else {
+        return Vec::new();
+    };
+    let mut reduced: Vec<&'a [u8]> = vec![root];
+    for &component in names {
+        if component.is_empty() || component == b"." {
+            continue;
+        }
+        if component == b".." {
+            if reduced.len() > 1 {
+                if reduced.last().is_some_and(|&last| last != b"..") {
+                    reduced.pop();
+                    continue;
+                }
+            } else if !root.is_empty() {
+                continue;
+            }
+        }
+        reduced.push(component);
+    }
+    reduced
+}
+
+fn get_path_from_path_components(path_components: &[&[u8]]) -> Vec<u8> {
+    let Some((&root, names)) = path_components.split_first() else {
+        return Vec::new();
+    };
+    let mut result = root.to_vec();
+    if !root.is_empty() && !has_trailing_directory_separator(root) {
+        result.push(DIRECTORY_SEPARATOR);
+    }
+    for (i, name) in names.iter().enumerate() {
+        if i > 0 {
+            result.push(DIRECTORY_SEPARATOR);
+        }
+        result.extend_from_slice(name);
+    }
+    result
+}
+
+/// The absolute form of a file name, with forward slashes and without `.` and `..`.
+pub fn get_normalized_absolute_path(file_name: &[u8], current_directory: &[u8]) -> Vec<u8> {
+    let combined = combine_paths(current_directory, file_name);
+    get_path_from_path_components(&reduce_path_components(&get_path_components(&combined)))
+}
+
+// ASCII letters only; the reference folds the case of every letter.
+fn equate_string_case_insensitive(a: &[u8], b: &[u8]) -> bool {
+    a.eq_ignore_ascii_case(b)
+}
+
+fn get_path_components_relative_to<'a>(
+    from: &'a [u8],
+    to: &'a [u8],
+    options: ComparePathsOptions<'_>,
+) -> Vec<&'a [u8]> {
+    let from_components = reduce_path_components(&get_path_components(from));
+    let to_components = reduce_path_components(&get_path_components(to));
+
+    let mut start = 0;
+    for (from_component, to_component) in from_components.iter().zip(&to_components) {
+        let equal = if start == 0 || !options.use_case_sensitive_file_names {
+            equate_string_case_insensitive(from_component, to_component)
+        } else {
+            from_component == to_component
+        };
+        if !equal {
+            break;
+        }
+        start += 1;
+    }
+
+    if start == 0 {
+        return to_components;
+    }
+
+    let mut result: Vec<&'a [u8]> = vec![b""];
+    result.extend(from_components.iter().skip(start).map(|_| &b".."[..]));
+    result.extend(to_components.iter().skip(start));
+    result
+}
+
+/// The name that a diagnostic prints: relative to the current directory when both have one root.
+pub fn convert_to_relative_path(
+    absolute_or_relative_path: &[u8],
+    options: ComparePathsOptions<'_>,
+) -> Vec<u8> {
+    if !is_rooted_disk_path(absolute_or_relative_path) {
+        return absolute_or_relative_path.to_vec();
+    }
+    let from = normalize_slashes(options.current_directory);
+    let to = combine_paths(options.current_directory, absolute_or_relative_path);
+    get_path_from_path_components(&get_path_components_relative_to(&from, &to, options))
+}
