+    let other = file(&mut files, "/other/b.ts", "../other/b.ts", "debugger;\n");
+    let nan = "Use the isNaN function to compare with NaN.";
+    let itself = "'a' is assigned to itself.";
+    let input = vec![
+        diag(Some(z), 0, 17, Code::Name("use-isnan"), nan),
+        diag(Some(z), 0, 9, Code::Name("use-isnan"), nan),
+        diag(Some(z), 30, 1, Code::Name("no-self-assign"), itself),
+        diag(Some(z), 30, 1, Code::Name("no-self-assign"), itself),
+        diag(Some(z), 0, 9, Code::Ts(2367), "A number."),
+        diag(Some(z), 0, 9, Code::Ts(10000), "A larger number."),
+        diag(Some(z), 0, 5, Code::Ts(2454), "A shorter span."),
+        diag(Some(z), 0, 9, Code::Name("no-compare"), "Another rule."),
+        Diagnostic {
+            category: Category::Warning,
+            ..diag(Some(z), 0, 9, Code::Name("use-isnan"), nan)
+        },
+        diag(Some(other), 0, 9, Code::Name("no-debugger"), DEBUGGER),
+        diag(None, 0, 0, Code::CANNOT_READ_FILE, "Without a file."),
+    ];
+    let sorted = sort_and_deduplicate_diagnostics(&files, input);
+    assert_eq!(
+        plain(&files, &sorted),
+        "error cannot-read-file: Without a file.\n\
+         ../other/b.ts(1,1): error no-debugger: Unexpected 'debugger' statement.\n\
+         z.ts(1,1): error TS2454: A shorter span.\n\
+         z.ts(1,1): warning use-isnan: Use the isNaN function to compare with NaN.\n\
+         z.ts(1,1): error no-compare: Another rule.\n\
+         z.ts(1,1): error use-isnan: Use the isNaN function to compare with NaN.\n\
+         z.ts(1,1): error TS2367: A number.\n\
+         z.ts(1,1): error TS10000: A larger number.\n\
+         z.ts(1,1): error use-isnan: Use the isNaN function to compare with NaN.\n\
+         z.ts(2,12): error no-self-assign: 'a' is assigned to itself.\n"
+    );
+
+    let related = |start: u32, text: &'static str| Diagnostic {
+        category: Category::Message,
+        ..diag(Some(z), start, 1, Code::Ts(2728), text)
+    };
+    let with = |related: Vec<Diagnostic>| Diagnostic {
+        related,
+        ..diag(Some(z), 0, 1, Code::Ts(2322), "One head.")
+    };
+    let merged = sort_and_deduplicate_diagnostics(
+        &files,
+        vec![
+            with(vec![related(5, "second")]),
+            with(vec![related(2, "first"), related(5, "second")]),
+            with(Vec::new()),
+        ],
+    );
+    assert_eq!(merged.len(), 1);
+    let starts: Vec<u32> = merged[0].related.iter().map(|r| r.start).collect();
+    assert_eq!(starts, [2, 5]);
+
+    let number = diag(Some(z), 0, 1, Code::Ts(1), "x");
+    let name = diag(Some(z), 0, 1, Code::Name("x"), "x");
+    assert_eq!(compare_diagnostics(&files, &name, &number), Ordering::Less);
+    assert!(!equal_diagnostics_no_related_info(&files, &name, &number));
+}
