+//! Port of internal/ast/diagnostic.go of typescript-go, for a diagnostic that holds its final text.
+use crate::source_file::{FileId, Files};
+use core::cmp::Ordering;
+use core::fmt;
+use std::borrow::Cow;
+
+/// In the order of the reference, which the sort uses.
+#[repr(u8)]
+#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Debug)]
+pub enum Category {
+    Warning,
+    Error,
+    Suggestion,
+    Message,
+}
+
+impl Category {
+    pub fn name(self) -> &'static str {
+        match self {
+            Category::Warning => "warning",
+            Category::Error => "error",
+            Category::Suggestion => "suggestion",
+            Category::Message => "message",
+        }
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Code {
+    /// The number of a TypeScript diagnostic, printed as `TS2322`.
+    Ts(u32),
+    /// The name of a lint rule, or one of the words below, printed as it is.
+    Name(&'static str),
+}
+
+impl Code {
+    /// An error or a warning of Bun's parser that has no TypeScript number.
+    pub const SYNTAX: Code = Code::Name("syntax");
+    /// Where the reference panics or asserts, and where a walk gives up.
+    pub const INTERNAL_ERROR: Code = Code::Name("internal-error");
+    pub const CANNOT_READ_FILE: Code = Code::Name("cannot-read-file");
+    pub const UNSUPPORTED_EXTENSION: Code = Code::Name("unsupported-extension");
+
+    // `Code()` of the reference: an external diagnostic has the number 0 there.
+    fn number(self) -> u32 {
+        match self {
+            Code::Ts(number) => number,
+            Code::Name(_) => 0,
+        }
+    }
+
+    // `Source()` of the reference: empty for a TypeScript diagnostic.
+    fn source(self) -> &'static str {
+        match self {
+            Code::Ts(_) => "",
+            Code::Name(name) => name,
+        }
+    }
+}
+
+impl fmt::Display for Code {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match *self {
+            Code::Ts(number) => write!(f, "TS{number}"),
+            Code::Name(name) => f.write_str(name),
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct MessageChain {
+    pub text: Cow<'static, [u8]>,
+    pub next: Vec<MessageChain>,
+}
+
+#[derive(Clone, Debug)]
+pub struct Diagnostic {
+    /// `None` for a diagnostic that belongs to no file.
+    pub file: Option<FileId>,
+    /// Byte offset into the text of `file`.
+    pub start: u32,
+    /// In bytes.
+    pub length: u32,
+    pub category: Category,
+    pub code: Code,
+    /// The message alone: without the code and without the chain.
+    pub text: Cow<'static, [u8]>,
+    pub chain: Vec<MessageChain>,
+    pub related: Vec<Diagnostic>,
+}
+
+/// Chains and related information nested deeper than this are neither compared nor printed.
+pub(crate) const MAX_NESTING: u32 = 200;
+
+fn get_diagnostic_path<'a>(files: &'a Files, d: &Diagnostic) -> &'a [u8] {
+    match d.file.and_then(|file| files.get(file)) {
+        Some(file) => file.file_name(),
+        None => b"",
+    }
+}
+
+pub fn equal_diagnostics(files: &Files, d1: &Diagnostic, d2: &Diagnostic) -> bool {
+    equal_diagnostics_at(files, d1, d2, 0)
+}
+
+fn equal_diagnostics_at(files: &Files, d1: &Diagnostic, d2: &Diagnostic, level: u32) -> bool {
+    if !equal_diagnostics_no_related_info(files, d1, d2) {
+        return false;
+    }
+    level >= MAX_NESTING
+        || (d1.related.len() == d2.related.len()
+            && d1
+                .related
+                .iter()
+                .zip(&d2.related)
+                .all(|(r1, r2)| equal_diagnostics_at(files, r1, r2, level + 1)))
+}
+
+// The text stands for the message and its arguments, which the reference compares apart.
+pub fn equal_diagnostics_no_related_info(files: &Files, d1: &Diagnostic, d2: &Diagnostic) -> bool {
+    get_diagnostic_path(files, d1) == get_diagnostic_path(files, d2)
+        && d1.start == d2.start
+        && d1.length == d2.length
+        && d1.code == d2.code
+        && d1.category == d2.category
+        && d1.text == d2.text
+        && equal_message_chain(&d1.chain, &d2.chain, 0)
+}
+
+fn equal_message_chain(c1: &[MessageChain], c2: &[MessageChain], level: u32) -> bool {
+    level >= MAX_NESTING
+        || (c1.len() == c2.len()
+            && c1.iter().zip(c2).all(|(n1, n2)| {
+                n1.text == n2.text && equal_message_chain(&n1.next, &n2.next, level + 1)
+            }))
+}
+
+// A longer chain first.
+fn compare_message_chain_size(c1: &[MessageChain], c2: &[MessageChain], level: u32) -> Ordering {
+    let c = c2.len().cmp(&c1.len());
+    if c != Ordering::Equal || level >= MAX_NESTING {
+        return c;
+    }
+    for (n1, n2) in c1.iter().zip(c2) {
+        let c = compare_message_chain_size(&n1.next, &n2.next, level + 1);
+        if c != Ordering::Equal {
+            return c;
+        }
+    }
+    Ordering::Equal
+}
+
+// The reference compares the arguments of each message here; this compares the texts.
+fn compare_message_chain_content(c1: &[MessageChain], c2: &[MessageChain], level: u32) -> Ordering {
+    if level >= MAX_NESTING {
+        return Ordering::Equal;
+    }
+    for (n1, n2) in c1.iter().zip(c2) {
+        let c = n1.text.cmp(&n2.text);
+        if c != Ordering::Equal {
+            return c;
+        }
+        let c = compare_message_chain_content(&n1.next, &n2.next, level + 1);
+        if c != Ordering::Equal {
+            return c;
+        }
+    }
+    Ordering::Equal
+}
+
+// More related information first.
+fn compare_related_info(
+    files: &Files,
+    r1: &[Diagnostic],
+    r2: &[Diagnostic],
+    level: u32,
+) -> Ordering {
+    let c = r2.len().cmp(&r1.len());
+    if c != Ordering::Equal || level >= MAX_NESTING {
+        return c;
+    }
+    for (d1, d2) in r1.iter().zip(r2) {
+        let c = compare_diagnostics_at(files, d1, d2, level + 1);
+        if c != Ordering::Equal {
+            return c;
+        }
+    }
+    Ordering::Equal
+}
+
+pub fn compare_diagnostics(files: &Files, d1: &Diagnostic, d2: &Diagnostic) -> Ordering {
+    compare_diagnostics_at(files, d1, d2, 0)
+}
+
+fn compare_diagnostics_at(files: &Files, d1: &Diagnostic, d2: &Diagnostic, level: u32) -> Ordering {
+    get_diagnostic_path(files, d1)
+        .cmp(get_diagnostic_path(files, d2))
+        .then_with(|| d1.start.cmp(&d2.start))
+        .then_with(|| end(d1).cmp(&end(d2)))
+        .then_with(|| d1.code.number().cmp(&d2.code.number()))
+        .then_with(|| d1.category.cmp(&d2.category))
+        .then_with(|| d1.code.source().cmp(d2.code.source()))
+        // The reference compares the message key and then the arguments here; this compares the text.
+        .then_with(|| d1.text.cmp(&d2.text))
+        .then_with(|| compare_message_chain_size(&d1.chain, &d2.chain, 0))
+        .then_with(|| compare_message_chain_content(&d1.chain, &d2.chain, 0))
+        .then_with(|| compare_related_info(files, &d1.related, &d2.related, level))
+}
+
+fn end(d: &Diagnostic) -> u64 {
+    u64::from(d.start) + u64::from(d.length)
+}
