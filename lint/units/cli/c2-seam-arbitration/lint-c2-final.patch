+use crate::diagnostic::{Category, Diagnostic};
+use crate::diagnosticwriter::write_flattened_diagnostic_message;
+use crate::source_file::Files;
+use bun_ast::{Data, Kind, Loc, Msg, Range};
+use core::fmt;
+use std::borrow::Cow;
+use std::io::Write;
+
+/// Bun's code frame for each diagnostic, the code in front of its text, as `Log::print` spaces them.
+pub fn write_code_frames<const ENABLE_ANSI_COLORS: bool>(
+    to: &mut impl fmt::Write,
+    files: &Files,
+    diagnostics: &[Diagnostic],
+) -> fmt::Result {
+    for (i, diagnostic) in diagnostics.iter().enumerate() {
+        if i > 0 {
+            to.write_str("\n\n")?;
+        }
+        to_msg(files, diagnostic).write_format::<ENABLE_ANSI_COLORS>(to)?;
+    }
+    if !diagnostics.is_empty() {
+        to.write_str("\n")?;
+    }
+    Ok(())
+}
+
+fn to_msg(files: &Files, diagnostic: &Diagnostic) -> Msg {
+    let mut text: Vec<u8> = Vec::new();
+    let _ = write!(&mut text, "{}: ", diagnostic.code);
+    write_flattened_diagnostic_message(&mut text, diagnostic, false);
+    Msg {
+        kind: match diagnostic.category {
+            Category::Error => Kind::Err,
+            Category::Warning => Kind::Warn,
+            Category::Suggestion | Category::Message => Kind::Note,
+        },
+        data: to_data(files, diagnostic, text),
+        notes: diagnostic
+            .related
+            .iter()
+            .map(|related| {
+                let mut text: Vec<u8> = Vec::new();
+                write_flattened_diagnostic_message(&mut text, related, false);
+                to_data(files, related, text)
+            })
+            .collect(),
+        ..Default::default()
+    }
+}
+
+fn to_data(files: &Files, diagnostic: &Diagnostic, text: Vec<u8>) -> Data {
+    let Some(file) = diagnostic.file.and_then(|file| files.get(file)) else {
+        return Data {
+            text: Cow::Owned(text),
+            location: None,
+        };
+    };
+    let range = Range {
+        loc: Loc {
+            start: i32::try_from(diagnostic.start).unwrap_or(i32::MAX),
+        },
+        len: i32::try_from(diagnostic.length).unwrap_or(i32::MAX),
+    };
+    let mut data = bun_ast::range_data(Some(file.source()), range, text);
+    if let Some(location) = &mut data.location {
+        location.file = Cow::Owned(file.display_name().to_vec());
+    }
+    data
+}
