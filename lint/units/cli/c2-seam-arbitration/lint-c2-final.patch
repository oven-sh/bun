+//! Port of the line map of internal/core/core.go and internal/scanner/scanner.go of typescript-go.
+use crate::source_file::SourceFile;
+
+/// The offset at which each line starts. LF, CR, CR LF, U+2028 and U+2029 end a line.
+pub fn compute_ecma_line_starts(text: &[u8]) -> Vec<u32> {
+    let mut result: Vec<u32> = Vec::new();
+    let mut pos: usize = 0;
+    let mut line_start: usize = 0;
+    while let Some(&b) = text.get(pos) {
+        pos += 1;
+        match b {
+            b'\r' => {
+                if text.get(pos) == Some(&b'\n') {
+                    pos += 1;
+                }
+            }
+            b'\n' => {}
+            0xE2 => match text.get(pos..pos + 2) {
+                Some([0x80, 0xA8 | 0xA9]) => pos += 2,
+                _ => continue,
+            },
+            _ => continue,
+        }
+        result.push(to_u32(line_start));
+        line_start = pos;
+    }
+    result.push(to_u32(line_start));
+    result
+}
+
+fn to_u32(value: usize) -> u32 {
+    u32::try_from(value).unwrap_or(u32::MAX)
+}
+
+/// The number of UTF-16 code units of `s`. A byte that is not part of valid UTF-8 counts as one.
+pub fn utf16_len(s: &[u8]) -> u32 {
+    let mut n: usize = 0;
+    for chunk in s.utf8_chunks() {
+        n += chunk.valid().chars().map(char::len_utf16).sum::<usize>();
+        n += chunk.invalid().len();
+    }
+    to_u32(n)
+}
+
+/// The index of the line that holds `pos`.
+pub fn compute_line_of_position(line_starts: &[u32], pos: u32) -> usize {
+    line_starts
+        .partition_point(|&start| start <= pos)
+        .saturating_sub(1)
+}
+
+/// The 0-based line of `pos` and its distance from the start of that line in UTF-16 code units.
+pub fn get_ecma_line_and_utf16_character_of_position(file: &SourceFile, pos: u32) -> (usize, u32) {
+    let line_map = file.ecma_line_map();
+    let text = file.text();
+    let line = compute_line_of_position(line_map, pos);
+    let line_start = line_map.get(line).copied().unwrap_or(0) as usize;
+    // Where the reference panics on a position behind the text, this takes the end of the text.
+    let end = (pos as usize).min(text.len());
+    (line, utf16_len(text.get(line_start..end).unwrap_or(b"")))
+}
