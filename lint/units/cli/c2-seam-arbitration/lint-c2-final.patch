+//! Port of the plain writer of internal/diagnosticwriter/diagnosticwriter.go of typescript-go.
+use crate::diagnostic::{Diagnostic, MAX_NESTING, MessageChain};
+use crate::scanner::get_ecma_line_and_utf16_character_of_position;
+use crate::source_file::Files;
+use std::io::Write;
+
+pub fn write_format_diagnostics(output: &mut Vec<u8>, files: &Files, diagnostics: &[Diagnostic]) {
+    for diagnostic in diagnostics {
+        write_format_diagnostic(output, files, diagnostic);
+    }
+}
+
+pub fn write_format_diagnostic(output: &mut Vec<u8>, files: &Files, diagnostic: &Diagnostic) {
+    if let Some(file) = diagnostic.file.and_then(|file| files.get(file)) {
+        let (line, character) =
+            get_ecma_line_and_utf16_character_of_position(file, diagnostic.start);
+        output.extend_from_slice(file.display_name());
+        let _ = write!(output, "({},{}): ", line + 1, u64::from(character) + 1);
+    }
+    let _ = write!(
+        output,
+        "{} {}: ",
+        diagnostic.category.name(),
+        diagnostic.code
+    );
+    write_flattened_diagnostic_message(output, diagnostic, true);
+    output.push(b'\n');
+}
+
+/// The text and, one line each and two more spaces per level, its chain.
+pub fn write_flattened_diagnostic_message(
+    output: &mut Vec<u8>,
+    diagnostic: &Diagnostic,
+    one_line_each: bool,
+) {
+    write_text(output, &diagnostic.text, one_line_each);
+    for chain in &diagnostic.chain {
+        flatten_diagnostic_message_chain(output, chain, 1, one_line_each);
+    }
+}
+
+fn flatten_diagnostic_message_chain(
+    output: &mut Vec<u8>,
+    chain: &MessageChain,
+    level: u32,
+    one_line_each: bool,
+) {
+    if level > MAX_NESTING {
+        return;
+    }
+    output.push(b'\n');
+    for _ in 0..level {
+        output.extend_from_slice(b"  ");
+    }
+    write_text(output, &chain.text, one_line_each);
+    for child in &chain.next {
+        flatten_diagnostic_message_chain(output, child, level + 1, one_line_each);
+    }
+}
+
+// A line break inside a text would read as the start of another diagnostic: it becomes one space.
+fn write_text(output: &mut Vec<u8>, text: &[u8], one_line: bool) {
+    if !one_line {
+        output.extend_from_slice(text);
+        return;
+    }
+    let mut bytes = text.iter().copied().peekable();
+    while let Some(b) = bytes.next() {
+        match b {
+            b'\r' => {
+                bytes.next_if_eq(&b'\n');
+                output.push(b' ');
+            }
+            b'\n' => output.push(b' '),
+            _ => output.push(b),
+        }
+    }
+}
