+//! Port of SortAndDeduplicateDiagnostics of internal/compiler/program.go of typescript-go.
+use crate::diagnostic::{
+    Diagnostic, compare_diagnostics, equal_diagnostics, equal_diagnostics_no_related_info,
+};
+use crate::source_file::Files;
+
+/// The sort is stable: diagnostics that compare equal print the same bytes.
+pub fn sort_and_deduplicate_diagnostics(
+    files: &Files,
+    mut diagnostics: Vec<Diagnostic>,
+) -> Vec<Diagnostic> {
+    diagnostics.sort_by(|d1, d2| compare_diagnostics(files, d1, d2));
+    compact_and_merge_related_infos(files, diagnostics)
+}
+
+// Diagnostics that differ only by related information become one that has all of it.
+fn compact_and_merge_related_infos(files: &Files, diagnostics: Vec<Diagnostic>) -> Vec<Diagnostic> {
+    let mut result: Vec<Diagnostic> = Vec::with_capacity(diagnostics.len());
+    let mut merged = false;
+    for d in diagnostics {
+        match result.last_mut() {
+            Some(last) if equal_diagnostics_no_related_info(files, last, &d) => {
+                last.related.extend(d.related);
+                merged = true;
+            }
+            _ => {
+                if merged {
+                    sort_and_compact_related_infos(files, result.last_mut());
+                    merged = false;
+                }
+                result.push(d);
+            }
+        }
+    }
+    if merged {
+        sort_and_compact_related_infos(files, result.last_mut());
+    }
+    result
+}
+
+fn sort_and_compact_related_infos(files: &Files, d: Option<&mut Diagnostic>) {
+    let Some(d) = d else { return };
+    d.related
+        .sort_by(|r1, r2| compare_diagnostics(files, r1, r2));
+    d.related
+        .dedup_by(|r2, r1| equal_diagnostics(files, r1, r2));
+}
