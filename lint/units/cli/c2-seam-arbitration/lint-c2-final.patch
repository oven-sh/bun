+use crate::diagnostic::{Category, Code, Diagnostic};
+use crate::source_file::FileId;
+use bun_ast::{Data, Kind, Msg};
+use std::borrow::Cow;
+
+/// What Bun's parser logged about `file`, as diagnostics. Debug and verbose messages are left out.
+pub fn diagnostics_from_msgs(file: FileId, msgs: Vec<Msg>, diagnostics: &mut Vec<Diagnostic>) {
+    for msg in msgs {
+        let category = match msg.kind {
+            Kind::Err => Category::Error,
+            Kind::Warn => Category::Warning,
+            Kind::Note => Category::Message,
+            Kind::Debug | Kind::Verbose => continue,
+        };
+        let code = match msg.code() {
+            Some(number) => Code::Ts(number),
+            None => Code::SYNTAX,
+        };
+        // A note has no number of its own.
+        let related = msg
+            .notes
+            .into_vec()
+            .into_iter()
+            .map(|note| from_data(file, note, Category::Message, Code::SYNTAX, Vec::new()))
+            .collect();
+        diagnostics.push(from_data(file, msg.data, category, code, related));
+    }
+}
+
+fn from_data(
+    file: FileId,
+    data: Data,
+    category: Category,
+    code: Code,
+    related: Vec<Diagnostic>,
+) -> Diagnostic {
+    let (file, start, length) = match &data.location {
+        Some(location) => (
+            Some(file),
+            u32::try_from(location.offset).unwrap_or(u32::MAX),
+            u32::try_from(location.length).unwrap_or(u32::MAX),
+        ),
+        None => (None, 0, 0),
+    };
+    Diagnostic {
+        file,
+        start,
+        length,
+        category,
+        code,
+        // A borrowed text of a `Msg` can point into its `Log` or its `Source`.
+        text: Cow::Owned(data.text.into_owned()),
+        chain: Vec::new(),
+        related,
+    }
+}
