+use crate::scanner::compute_ecma_line_starts;
+use crate::tspath::{self, ComparePathsOptions};
+use bun_ast::Source;
+use core::cell::OnceCell;
+
+/// The place of a file in [`Files`].
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub struct FileId(u32);
+
+pub struct SourceFile {
+    name: Box<[u8]>,
+    display: Box<[u8]>,
+    source: Source,
+    ecma_line_map: OnceCell<Vec<u32>>,
+}
+
+impl SourceFile {
+    /// Absolute and with forward slashes: what the diagnostics are ordered by.
+    pub fn file_name(&self) -> &[u8] {
+        &self.name
+    }
+
+    /// What is printed: the name relative to the working directory, with forward slashes.
+    pub fn display_name(&self) -> &[u8] {
+        &self.display
+    }
+
+    pub fn source(&self) -> &Source {
+        &self.source
+    }
+
+    /// What the offsets of the diagnostics count into.
+    pub fn text(&self) -> &[u8] {
+        self.source.contents()
+    }
+
+    pub fn ecma_line_map(&self) -> &[u32] {
+        self.ecma_line_map
+            .get_or_init(|| compute_ecma_line_starts(self.text()))
+    }
+}
+
+/// Every file that a diagnostic of one run can name.
+#[derive(Default)]
+pub struct Files {
+    files: Vec<SourceFile>,
+}
+
+impl Files {
+    /// `text` is the file without its byte order mark.
+    pub fn add(&mut self, name: Box<[u8]>, display: Box<[u8]>, text: Vec<u8>) -> Option<FileId> {
+        let id = FileId(u32::try_from(self.files.len()).ok()?);
+        // The path of the source borrows `name`, which lives as long as the source does.
+        let source = Source::init_path_string_owned(&name[..], text);
+        self.files.push(SourceFile {
+            name,
+            display,
+            source,
+            ecma_line_map: OnceCell::new(),
+        });
+        Some(id)
+    }
+
+    pub fn get(&self, file: FileId) -> Option<&SourceFile> {
+        self.files.get(file.0 as usize)
+    }
+}
+
+/// The names of an operand for [`Files::add`]: the absolute one, and the one that is printed.
+pub fn names_of(cwd: &[u8], operand: &[u8]) -> (Box<[u8]>, Box<[u8]>) {
+    let name = tspath::get_normalized_absolute_path(operand, cwd);
+    let display = tspath::convert_to_relative_path(
+        &name,
+        ComparePathsOptions {
