+
+// The first option of a list whose name is equal to a name under strings.EqualFold, as a search through the list finds it: two ASCII names fold together exactly when their lower case is one.
+export function optionFinder(options: readonly CommandLineOption[]): (name: string) => CommandLineOption | undefined {
+  const byLowerName = new Map<string, CommandLineOption>();
+  for (const option of options) {
+    const key = option.name.toLowerCase();
+    if (!byLowerName.has(key)) byLowerName.set(key, option);
+  }
+  const ascii = options.every(option => isAscii(option.name));
+  return name =>
+    ascii && isAscii(name) ? byLowerName.get(name.toLowerCase()) : options.find(option => equalFold(option.name, name));
+}
