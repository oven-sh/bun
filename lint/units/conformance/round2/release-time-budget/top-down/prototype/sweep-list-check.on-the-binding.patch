+// The lines in which the instances of every case differ from fixtures/instances.tsv, the list of the reference's run of its suite; the reference fails no instance, so an invalid one has no line there.
+function linesOffTheList(facts: Iterable<Fact>): string[] {
+  const listPath = join(import.meta.dir, "fixtures", "instances.tsv");
+  let list: Set<string>;
+  try {
+    list = new Set(readFileSync(listPath, "utf8").split("\n").slice(0, -1));
+  } catch (error) {
+    throw new FileError(`${listPath}: ${messageOf(error)}`);
+  }
+  const lineOf = (fact: Fact) =>
+    fact.status === "run" ? `${fact.name}\t${fact.kind}` : `${fact.name}\t${fact.status}\t${fact.reason}`;
+  const lines = new Set([...facts].map(lineOf));
+  return [
+    ...[...lines].filter(line => !list.has(line)).map(line => `not in the list: ${line}`),
+    ...[...list].filter(line => !lines.has(line)).map(line => `not enumerated: ${line}`),
+  ];
+}
