+/// Where a modifier of a parameter stands among the modifiers of one parameter: accessibility, then "override", then "readonly".
+pub(crate) fn parameter_modifier_rank(name: &[u8]) -> u8 {
+    match name {
+        b"readonly" => 3,
+        b"override" => 2,
+        _ => 1,
+    }
