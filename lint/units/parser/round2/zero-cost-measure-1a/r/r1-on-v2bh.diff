+    fn may_be_followed_by_cast_word(&self) -> bool {
+        let contents = self.lexer.contents;
+        let mut i = self.lexer.end;
+        while matches!(contents.get(i), Some(b' ' | b'\t')) {
+            i += 1;
+        }
+        match contents.get(i) {
+            Some(b'a' | b's' | b'/' | b'\\' | 0x0B | 0x0C) => true,
+            Some(byte) => *byte >= 0x80,
+            None => false,
+        }
+    }
