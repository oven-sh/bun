/// The sources that a lint parse does not read as tsc does, with what it makes of each.
#[rustfmt::skip]
const KNOWN_DIFFERENCES: &[(Dialect, &[u8], Made)] = &[
    (Dialect::Ts, b"import A from \"x\"\nwith { type: \"json\" };", Err((b"Expected \"(\" but found \"{\"", 23))),
    (Dialect::Ts, b"x = a ? y => q ? r : (b) : c => d;", Err((b"Expected \":\" but found \";\"", 33))),
    (Dialect::Ts, b"x = a ? b ? c : y => (d) : e => f;", Err((b"Expected \":\" but found \";\"", 33))),
    (Dialect::Ts, b"import \"x\"\nwith { type: \"json\" };", Err((b"Expected \"(\" but found \"{\"", 16))),
    (Dialect::Ts, b"import type A from \"x\"\nwith { type: \"json\" };", Err((b"Expected \"(\" but found \"{\"", 28))),
    (Dialect::Js, b"import A from \"x\"\nwith { type: \"json\" }; A;", Err((b"Expected \"(\" but found \"{\"", 23))),
    (Dialect::Js, b"import A from \"x\"\nwith { type: \"json\" };\nimport B from \"y\"\nwith (A) {}", Err((b"Expected \"(\" but found \"{\"", 23))),
];

