+/// Where the blanks that end at `at` start: spaces and tabs, no line break.
+fn blanks_before(contents: &[u8], mut at: usize) -> usize {
+    while at > 0 && matches!(contents.get(at - 1), Some(b' ' | b'\t')) {
+        at -= 1;
+    }
+    at
+}
