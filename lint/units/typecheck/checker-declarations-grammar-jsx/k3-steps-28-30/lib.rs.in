pub mod tscore {
    pub mod deps {
        pub use std::collections::HashMap;
        // Insertion-ordered map: enough of bun_collections::ArrayHashMap for the contract's golang.rs.
        pub struct ArrayHashMap<K, V> {
            keys: Vec<K>,
            values: Vec<V>,
        }
        impl<K: PartialEq, V> ArrayHashMap<K, V> {
            pub fn new() -> Self {
                Self { keys: Vec::new(), values: Vec::new() }
            }
            pub fn len(&self) -> usize {
                self.keys.len()
            }
            pub fn get(&self, key: &K) -> Option<&V> {
                let i = self.keys.iter().position(|k| k == key)?;
                self.values.get(i)
            }
            pub fn insert(&mut self, key: K, value: V) {
                match self.keys.iter().position(|k| *k == key) {
                    Some(i) => self.values[i] = value,
                    None => {
                        self.keys.push(key);
                        self.values.push(value);
                    }
                }
            }
            pub fn ordered_remove(&mut self, key: &K) {
                if let Some(i) = self.keys.iter().position(|k| k == key) {
                    self.keys.remove(i);
                    self.values.remove(i);
                }
            }
            pub fn keys(&self) -> &[K] {
                &self.keys
            }
            pub fn values(&self) -> &[V] {
                &self.values
            }
        }
    }
    #[path = "/workspace/notes/lint/units/typecheck/checker-data-model-contract/bottom-up/crate/src/tscore/golang.rs"]
