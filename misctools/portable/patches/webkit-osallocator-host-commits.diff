+
+// bun's portable image is a Linux program that a host runs on Windows and on macOS. The host says how its
+// memory behaves with an entry of the auxiliary vector (misctools/portable/host/linux_abi.h in bun's
+// repository). The kernel of Linux has no such entry: the value is 0.
+#define AT_BUN_HOST_MEMORY 0x62756e11
+// Memory is usable after it was committed, and what is committed is accounted, as on Windows. The host reserves
+// for an mmap with PROT_NONE, commits for the mprotect that makes the pages accessible, and decommits for
+// madvise(MADV_DONTNEED) on pages that are PROT_NONE. What is mapped with MAP_NORESERVE and accessible is
+// committed when code of the process faults on a page. A system call of the host's OS does not do that: it
+// fails on such a page.
+#define BUN_HOST_MEMORY_COMMITS 1
 #endif
 
 
 namespace WTF {
 
+#if OS(LINUX)
+bool OSAllocator::hostCommitsMemory()
+{
+    static std::once_flag onceKey;
+    static bool commits;
+    std::call_once(onceKey, [] {
+        // getauxval() sets errno for an entry that is not there.
+        int savedErrno = errno;
+        commits = getauxval(AT_BUN_HOST_MEMORY) & BUN_HOST_MEMORY_COMMITS;
+        errno = savedErrno;
+    });
+    return commits;
+}
+#endif
