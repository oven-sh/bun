+const PACKAGE_MANIFEST: &str =
+    r#"{ "name": "ext", "version": "1.0.0", "main": "index.js", "types": "index.d.ts" }"#;
+
+const PACKAGE_TYPES: &str = "export interface Request { url: string }
+export type Handler = (request: Request) => void;
+export declare namespace Shapes { interface Shape { s: number } }
+export declare class Emitter { on(name: string): this; }
+export interface Both { b: number }
+export declare const Both: Both;
+";
+
+#[test]
+fn an_import_of_what_no_source_declares_is_an_imported_type_where_it_is_a_type_alone() {
+    let main = "import type { Request, Handler, Shapes, Emitter, Both } from 'ext';
+export class Stated {
+    request = null as Request | null;
+    handlers = [] as Handler[];
+    shape = null as Shapes.Shape | null;
+    emitter = null as Emitter | null;
+    both = null as Both | null;
+}
+";
+    let files = [
+        ("main.ts", main),
+        ("node_modules/ext/package.json", PACKAGE_MANIFEST),
+        ("node_modules/ext/index.js", "export class Emitter {}\n"),
+        ("node_modules/ext/index.d.ts", PACKAGE_TYPES),
+    ];
+    // A class, and an interface that merges with a constant, can have a value in a bundle that holds the package.
+    let expected = [
+        "request: Request | null [Request is the type that /project/main.ts imports as Request]",
+        "handlers: Handler[] [Handler is the type that /project/main.ts imports as Handler]",
+        "shape: Shapes.Shape | null [Shapes is the type that /project/main.ts imports as Shapes]",
+        "emitter: Emitter | null [Emitter is Emitter of /project/main.ts]",
+        "both: Both | null [Both is Both of /project/main.ts]",
+    ];
+    assert_eq!(stated_members(&files), expected);
+}
+
