+/// In a stated text with `import("..").Name` at `at`: where the specifier starts and ends, then where `Name` does.
+fn parts_of_import_type(text: &[u8], at: usize) -> Option<[(usize, usize); 2]> {
     let specifier = text.get(at..)?.strip_prefix(b"import(")?;
     let quote = *specifier.first()?;
     let close = 1 + bun_core::strings::index_of_char_usize(&specifier[1..], quote)?;
     let name = specifier.get(close + 1..)?.strip_prefix(b").")?;
-    let start = text.len() - name.len();
-    Some((start, token_end(text, start, false)))
+    let (open, start) = (text.len() - specifier.len() + 1, text.len() - name.len());
+    Some([
+        (open, open + close - 1),
+        (start, token_end(text, start, false)),
+    ])
+}
+
+/// The path of a module, or a specifier of it, with no extension and no `/index`: what the two have in common.
+fn stem_of_module(path: &[u8]) -> &[u8] {
+    const EXTENSIONS: [&[u8]; 11] = [
+        b".d.ts", b".d.mts", b".d.cts", b".ts", b".tsx", b".mts", b".cts", b".js", b".jsx",
+        b".mjs", b".cjs",
+    ];
+    let mut stems = EXTENSIONS
+        .iter()
+        .filter_map(|extension| path.strip_suffix(*extension));
+    let stem = stems.next().unwrap_or(path);
+    stem.strip_suffix(b"/index").unwrap_or(stem)
+}
+
+/// The module that a relative `specifier` names in a text for a member of `importer`: the one source of that stem.
+fn module_of_specifier(
+    services: &mut Services<'_, '_, '_>,
+    sources: &[Option<Box<[u8]>>],
+    importer: FileId,
+    specifier: &[u8],
+) -> Option<SymbolRef> {
+    if !specifier.starts_with(b"./") && !specifier.starts_with(b"../") {
+        return None;
+    }
+    let directory = ancestors(sources.get(importer.idx())?.as_deref()?).nth(1)?;
+    let wanted = absolute(directory, stem_of_module(specifier));
+    let is_wanted = |path: &[u8]| {
+        let stem = stem_of_module(path);
+        stem == &wanted[..] || stem == &wanted[1..]
+    };
+    let mut found =
+        (sources.iter().enumerate()).filter(|(_, path)| path.as_deref().is_some_and(is_wanted));
+    let (file, _) = found.next().filter(|_| found.next().is_none())?;
+    services.symbol_at_location(NodeRef {
+        file: FileId(file as u32),
+        node: Node::FILE,
+    })
 }
 
