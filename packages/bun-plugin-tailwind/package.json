{
  "name": "bun-plugin-tailwind",
  "version": "0.2.0",
  "description": "Official Tailwind CSS plugin for Bun",
  "repository": {
    "type": "git",
    "url": "https://github.com/oven-sh/bun",
    "directory": "packages/bun-plugin-tailwind"
  },
  "homepage": "https://bun.com",
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build:native": "napi build --platform --release --no-js --manifest-path native/Cargo.toml --output-dir . --dts native/target/index.d.ts",
    "check:types": "tsc --noEmit",
    "prepublishOnly": "test $(ls *.node | wc -l) -eq 9"
  },
  "napi": {
    "binaryName": "bun-plugin-tailwind",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-musl",
      "aarch64-linux-android",
      "aarch64-pc-windows-msvc",
      "x86_64-pc-windows-msvc"
    ]
  },
  "dependencies": {
    "@tailwindcss/node": "^4.1.0",
    "@tailwindcss/oxide": "^4.1.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9",
    "@types/bun": "../bun-types",
    "typescript": "^5.9.3"
  },
  "files": [
    "README.md",
    "index.d.ts",
    "src",
    "*.node"
  ]
}
