 // every RAND_bytes call.
 uint64_t bssl::CRYPTO_get_fork_generation() { return 0; }
 
+// Every call already draws OS entropy, so there is nothing to advance.
+void CRYPTO_fork_detect_bump_generation() {}
+
 #endif
