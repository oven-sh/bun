+TEST(ForkDetect, BumpGenerationThenFork) {
+  uint64_t start = CRYPTO_get_fork_generation();
+  if (start == 0) {
+    GTEST_SKIP() << "Fork detection not supported. Skipping test.\n";
+  }
+
+  CRYPTO_fork_detect_bump_generation();
+  uint64_t bumped = CRYPTO_get_fork_generation();
+  EXPECT_NE(bumped, start);
+  EXPECT_NE(bumped, uint64_t{0});
+
+  // A real fork after a bump still advances the generation.
+  ForkInChild([&] { CheckGenerationAtLeastInChild("Child", bumped + 1); });
+
+  // We still observe `bumped`.
+  EXPECT_EQ(bumped, CRYPTO_get_fork_generation());
+}
