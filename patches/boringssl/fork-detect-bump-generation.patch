@@ -176,40 +182,88 @@ void bssl::CRYPTO_fork_detect_force_madv_wipeonfork_for_testing(int on) {
   g_force_madv_wipeonfork_enabled = on;
 }
 
+void CRYPTO_fork_detect_bump_generation() {
+  CRYPTO_once(&g_fork_detect_once, init_fork_detect);
+
+  Atomic<uint32_t> *const flag_ptr = g_fork_detect_addr;
+  if (flag_ptr == nullptr) {
+    // Without `MADV_WIPEONFORK` the generation is zero and every `RAND_bytes`
+    // call already draws OS entropy, so there is nothing to advance.
+    return;
+  }
+
+  // Clear the flag exactly as the kernel does after a fork. The next
+  // `CRYPTO_get_fork_generation` call on any thread then takes the lock above
+  // and advances the generation. The lock orders this store after any
+  // increment that is in flight, so that increment cannot overwrite the
+  // cleared flag with one and lose this bump.
+  MutexWriteLock lock(&g_fork_detect_lock);
+  flag_ptr->store(0);
+}
