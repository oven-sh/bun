 #elif defined(OPENSSL_FORK_DETECTION_PTHREAD_ATFORK)
 
 static CRYPTO_once_t g_pthread_fork_detection_once = CRYPTO_ONCE_INIT;
-static uint64_t g_atfork_fork_generation;
+static Atomic<uint64_t> g_atfork_fork_generation;
 
 static void we_are_forked() {
   // Immediately after a fork, the process must be single-threaded.
-  uint64_t value = g_atfork_fork_generation + 1;
+  uint64_t value = g_atfork_fork_generation.load() + 1;
   if (value == 0) {
     value = 1;
   }
-  g_atfork_fork_generation = value;
+  g_atfork_fork_generation.store(value);
 }
 
 static void init_pthread_fork_detection() {
   if (pthread_atfork(nullptr, nullptr, we_are_forked) != 0) {
     abort();
   }
-  g_atfork_fork_generation = 1;
+  g_atfork_fork_generation.store(1);
 }
 
 uint64_t bssl::CRYPTO_get_fork_generation() {
   CRYPTO_once(&g_pthread_fork_detection_once, init_pthread_fork_detection);
 
-  return g_atfork_fork_generation;
+  return g_atfork_fork_generation.load();
+}
+
+void CRYPTO_fork_detect_bump_generation() {
+  CRYPTO_once(&g_pthread_fork_detection_once, init_pthread_fork_detection);
+
+  uint64_t old_value = g_atfork_fork_generation.load();
+  uint64_t new_value;
+  do {
+    new_value = old_value + 1;
+    if (new_value == 0) {
+      new_value = 1;
+    }
+  } while (
+      !g_atfork_fork_generation.compare_exchange_weak(old_value, new_value));
 }
 
 #elif defined(OPENSSL_DOES_NOT_FORK)
 
 // These platforms are guaranteed not to fork, and therefore do not require
-// fork detection support. Returning a constant non zero value makes BoringSSL
-// assume address space duplication is not a concern and adding entropy to
-// every RAND_bytes call is not needed.
-uint64_t bssl::CRYPTO_get_fork_generation() { return 0xc0ffee; }
+// fork detection support. A constant non zero value makes BoringSSL assume
+// address space duplication is not a concern and adding entropy to every
+// RAND_bytes call is not needed. `CRYPTO_fork_detect_bump_generation` still
+// advances it, for duplication that happens outside the process, such as a
+// restored VM snapshot.
+static Atomic<uint64_t> g_fork_generation(0xc0ffee);
+
+uint64_t bssl::CRYPTO_get_fork_generation() { return g_fork_generation.load(); }
+
+void CRYPTO_fork_detect_bump_generation() {
+  uint64_t old_value = g_fork_generation.load();
+  uint64_t new_value;
+  do {
+    new_value = old_value + 1;
+    if (new_value == 0) {
+      new_value = 1;
+    }
+  } while (!g_fork_generation.compare_exchange_weak(old_value, new_value));
+}
 
 #else
 
