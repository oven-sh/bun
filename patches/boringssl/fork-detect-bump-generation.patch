+
+// The bump exists on every platform, including those without fork detection.
+#include <gtest/gtest.h>
+
+#if defined(OPENSSL_THREADS)
+#include <atomic>
+#include <thread>
+#include <vector>
+#endif
+
+BSSL_NAMESPACE_BEGIN
+namespace {
+
+TEST(ForkDetect, BumpGeneration) {
+  uint64_t start = CRYPTO_get_fork_generation();
+  CRYPTO_fork_detect_bump_generation();
+  uint64_t bumped = CRYPTO_get_fork_generation();
+
+  if (start == 0) {
+    // Without fork detection every call draws OS entropy. The generation
+    // stays zero so that behaviour is kept.
+    EXPECT_EQ(bumped, uint64_t{0});
+    return;
+  }
+
+  EXPECT_NE(bumped, start);
+  EXPECT_NE(bumped, uint64_t{0});
+  // The generation is stable until the next bump.
+  EXPECT_EQ(bumped, CRYPTO_get_fork_generation());
+
+  CRYPTO_fork_detect_bump_generation();
+  uint64_t bumped_again = CRYPTO_get_fork_generation();
+  EXPECT_NE(bumped_again, bumped);
+  EXPECT_NE(bumped_again, uint64_t{0});
+
+#if defined(OPENSSL_THREADS)
+  // Readers run concurrently with the bumps. Each reader must observe a
+  // non-decreasing sequence and never zero. The readers keep going until the
+  // bumps are done, so the two really interleave.
+  std::vector<std::thread> threads;
+  std::atomic<bool> failed(false);
+  std::atomic<int> ready(0);
+  std::atomic<bool> done(false);
+  for (int i = 0; i < 4; i++) {
+    threads.emplace_back([&] {
+      uint64_t last = CRYPTO_get_fork_generation();
+      ready.fetch_add(1);
+      while (!done.load()) {
+        uint64_t now = CRYPTO_get_fork_generation();
+        if (now == 0 || now < last) {
+          failed.store(true);
+        }
+        last = now;
+      }
+    });
+  }
+  while (ready.load() < 4) {
+    std::this_thread::yield();
+  }
+  for (int i = 0; i < 100; i++) {
+    CRYPTO_fork_detect_bump_generation();
+    std::this_thread::yield();
+  }
+  done.store(true);
+  for (auto &t : threads) {
+    t.join();
+  }
+  EXPECT_FALSE(failed.load());
+  uint64_t final_generation = CRYPTO_get_fork_generation();
+  EXPECT_NE(final_generation, bumped_again);
+  EXPECT_NE(final_generation, uint64_t{0});
+#endif  // OPENSSL_THREADS
+}
+
+}  // namespace
+BSSL_NAMESPACE_END
