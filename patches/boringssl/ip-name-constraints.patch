Implement IP address name constraints using RFC 5280 section 4.2.1.10.
BoringSSL's nc_match_single otherwise rejects GEN_IPADD as unsupported.

--- a/crypto/x509/v3_ncons.cc
+++ b/crypto/x509/v3_ncons.cc
@@ -507,6 +507,26 @@
   return X509_V_OK;
 }

+int nc_ip(const ASN1_OCTET_STRING *ip, const ASN1_OCTET_STRING *base) {
+  // RFC 5280, section 4.2.1.10 encodes an IP constraint as address || mask.
+  if (ip->length != 4 && ip->length != 16) {
+    return X509_V_ERR_UNSUPPORTED_NAME_SYNTAX;
+  }
+  if (base->length != 8 && base->length != 32) {
+    return X509_V_ERR_UNSUPPORTED_CONSTRAINT_SYNTAX;
+  }
+  if (ip->length * 2 != base->length) {
+    return X509_V_ERR_PERMITTED_VIOLATION;
+  }
+  const uint8_t *mask = base->data + ip->length;
+  for (int i = 0; i < ip->length; i++) {
+    if (((ip->data[i] ^ base->data[i]) & mask[i]) != 0) {
+      return X509_V_ERR_PERMITTED_VIOLATION;
+    }
+  }
+  return X509_V_OK;
+}
