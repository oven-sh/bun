+    uint16_t alignment;
+  } opaque;
+};
+
+// MLKEM512_private_key contains an ML-KEM-512 private key. The contents of this
+// object should never leave the address space since the format is unstable.
+struct MLKEM512_private_key {
+  union {
+    uint8_t bytes[512 * (2 + 2 + 4) + 32 + 32 + 32];
+    uint16_t alignment;
+  } opaque;
+};
