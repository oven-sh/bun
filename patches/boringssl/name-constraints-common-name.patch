+// Besides whole-label wildcards ("*.example.com"), common-name host matching in
+// the style of Node.js's `tls.checkServerIdentity` honours a single partial
+// wildcard in the leftmost label ("w*.example.com"), which
+// `x509v3_looks_like_dns_name` does not recognise. Widen such a label to "*" so
+// the name is recognised and `nc_dns` constrains it like the whole-label
+// wildcard that covers it.
+static void widen_partial_wildcard_label(unsigned char **inout,
+                                         size_t *inout_len) {
+  unsigned char *in = *inout;
+  size_t len = *inout_len;
+  size_t label_len = 0, stars = 0;
+  for (; label_len < len && in[label_len] != '.'; label_len++) {
+    unsigned char c = in[label_len];
+    if (c == '*') {
+      stars++;
+    } else if (!OPENSSL_isalnum(c) && c != '-' && c != '_') {
+      return;
+    }
+  }
+  if (stars != 1 || label_len < 2) {
+    return;
+  }
+  in += label_len - 1;
+  in[0] = '*';
+  *inout = in;
+  *inout_len = len - (label_len - 1);
+}
