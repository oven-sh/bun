+// OpenSSL's `cn2dnsid` only treats a commonName with at least two labels as a
+// DNS identifier.
+static bool has_inner_dot(const unsigned char *in, size_t len) {
+  if (len > 0 && in[len - 1] == '.') {
+    len--;
+  }
+  return OPENSSL_memchr(in, '.', len) != nullptr;
+}
