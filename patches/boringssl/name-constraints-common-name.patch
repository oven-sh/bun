+int bssl::x509_check_common_name_constraints(const X509 *x,
+                                             const NAME_CONSTRAINTS *nc) {
+  const auto *x_impl = FromOpaque(x);
+  for (const GENERAL_NAME *gen : x_impl->altname) {
+    if (gen->type == GEN_DNS) {
+      return X509_V_OK;
+    }
+  }
+
+  const X509_NAME *name = X509_get_subject_name(x);
+  for (int i = -1;;) {
+    i = X509_NAME_get_index_by_NID(name, NID_commonName, i);
+    if (i == -1) {
+      return X509_V_OK;
+    }
+
+    const ASN1_STRING *common_name =
+        X509_NAME_ENTRY_get_data(X509_NAME_get_entry(name, i));
+    unsigned char *idval;
+    int idlen = ASN1_STRING_to_UTF8(&idval, common_name);
+    if (idlen < 0) {
+      return X509_V_ERR_OUT_OF_MEM;
+    }
+    UniquePtr<unsigned char> free_idval(idval);
+    unsigned char *dns_id = idval;
+    size_t dns_id_len = (size_t)idlen;
+    while (dns_id_len > 0 && dns_id[dns_id_len - 1] == '\0') {
+      dns_id_len--;
+    }
+    if (OPENSSL_memchr(dns_id, '\0', dns_id_len) != nullptr) {
+      return X509_V_ERR_UNSUPPORTED_NAME_SYNTAX;
+    }
+    // On a certificate without a SAN extension this must cover every name
+    // `X509_check_host` may match against the common name, i.e.
+    // `x509v3_looks_like_dns_name`. Next to a SAN extension only Node.js-style
+    // matching consults the common name, and there, as in OpenSSL, a
+    // single-label name is not taken to be a DNS identifier.
+    widen_partial_wildcard_label(&dns_id, &dns_id_len);
+    if (!x509v3_looks_like_dns_name(dns_id, dns_id_len) ||
+        (x_impl->altname != nullptr && !has_inner_dot(dns_id, dns_id_len))) {
+      continue;
+    }
+
+    ASN1_IA5STRING dns_name;
+    dns_name.type = V_ASN1_IA5STRING;
+    dns_name.data = dns_id;
+    dns_name.length = (int)dns_id_len;
+    dns_name.flags = 0;
+    GENERAL_NAME gntmp;
+    gntmp.type = GEN_DNS;
+    gntmp.d.dNSName = &dns_name;
+    int r = nc_match(&gntmp, nc, /*case_insensitive_exclude_localpart=*/false);
+    if (r != X509_V_OK) {
+      return r;
+    }
+  }
+}
