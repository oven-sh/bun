+// A self-signed certificate whose keyUsage lacks keyCertSign (the shape of a
+// `dotnet dev-certs` or `openssl req -x509` server certificate) verifies when
+// an exact copy of it is a trust anchor, as in OpenSSL 3. Key usage still
+// rejects it as the issuer of any other certificate.
+TEST(X509Test, SelfSignedAnchorWithoutKeyCertSign) {
+  UniquePtr<EVP_PKEY> key = PrivateKeyFromPEM(kP256Key);
+  ASSERT_TRUE(key);
+
+  auto set_server_purpose = [](X509_STORE_CTX *ctx) {
+    X509_STORE_CTX_set_purpose(ctx, X509_PURPOSE_SSL_SERVER);
+  };
+
+  auto make_self_signed = [&](bool is_ca,
+                              std::optional<std::vector<KeyUsage>> usages) {
+    UniquePtr<X509> cert = MakeTestCert("Leaf", "Leaf", key.get(), is_ca);
+    if (cert == nullptr ||
+        !AddExtendedKeyUsage(cert.get(), {NID_server_auth}) ||
+        (usages.has_value() && !AddKeyUsage(cert.get(), *usages)) ||
+        !X509_sign(cert.get(), key.get(), EVP_sha256())) {
+      return UniquePtr<X509>();
+    }
+    return cert;
+  };
+
+  const std::vector<KeyUsage> kNoCertSign = {KeyUsage::kDigitalSignature,
+                                             KeyUsage::kKeyEncipherment};
+  const std::vector<KeyUsage> kCertSign = {KeyUsage::kDigitalSignature,
+                                           KeyUsage::kKeyCertSign};
+  struct {
+    bool is_ca;
+    std::optional<std::vector<KeyUsage>> usages;
+  } kShapes[] = {
+      {false, std::nullopt}, {false, kCertSign}, {false, kNoCertSign},
+      {true, std::nullopt},  {true, kCertSign},  {true, kNoCertSign},
+  };
+  for (const auto &shape : kShapes) {
+    SCOPED_TRACE(shape.is_ca);
+    SCOPED_TRACE(shape.usages.has_value());
+    UniquePtr<X509> cert = make_self_signed(shape.is_ca, shape.usages);
+    ASSERT_TRUE(cert);
+    EXPECT_TRUE(X509_get_extension_flags(cert.get()) & EXFLAG_SS);
+
+    // Pinned as a trusted stack entry and as a store entry.
+    EXPECT_EQ(X509_V_OK, Verify(cert.get(), {cert.get()}, {}, {}, 0,
+                                set_server_purpose));
+    UniquePtr<X509_STORE> store(X509_STORE_new());
+    ASSERT_TRUE(store);
+    ASSERT_TRUE(X509_STORE_add_cert(store.get(), cert.get()));
+    EXPECT_EQ(X509_V_OK, VerifyWithStore(cert.get(), store.get(), {}));
+
+    // Not pinned, it is an untrusted self-signed certificate, not a
+    // certificate with no issuer.
+    EXPECT_EQ(X509_V_ERR_DEPTH_ZERO_SELF_SIGNED_CERT,
+              Verify(cert.get(), {}, {}, {}, 0, set_server_purpose));
+
+    // Only an exact copy anchors it. A second self-signed certificate with
+    // the same subject and key usage is not the pinned one.
+    UniquePtr<X509> other = make_self_signed(shape.is_ca, shape.usages);
+    ASSERT_TRUE(other);
+    ASSERT_TRUE(ASN1_INTEGER_set_uint64(X509_get_serialNumber(other.get()), 43));
+    ASSERT_TRUE(X509_sign(other.get(), key.get(), EVP_sha256()));
+    EXPECT_EQ(X509_V_ERR_DEPTH_ZERO_SELF_SIGNED_CERT,
+              Verify(cert.get(), {other.get()}, {}, {}, 0, set_server_purpose));
+  }
+
+  // A trusted root whose keyUsage lacks keyCertSign may not issue anything:
+  // the chain builds, then the issuer edge fails with the root as the current
+  // certificate.
+  UniquePtr<X509> root = MakeTestCert("Root", "Root", key.get(), /*is_ca=*/true);
+  ASSERT_TRUE(root);
+  ASSERT_TRUE(AddKeyUsage(root.get(), kNoCertSign));
+  ASSERT_TRUE(X509_sign(root.get(), key.get(), EVP_sha256()));
+  UniquePtr<X509> leaf = MakeTestCert("Root", "Leaf", key.get(), /*is_ca=*/false);
+  ASSERT_TRUE(leaf);
+  ASSERT_TRUE(X509_sign(leaf.get(), key.get(), EVP_sha256()));
+  int depth = -1;
+  auto record_depth = [&](X509_STORE_CTX *ctx) {
+    X509_STORE_CTX_set_verify_cb(ctx, [](int ok, X509_STORE_CTX *inner) -> int {
+      if (!ok) {
+        *static_cast<int *>(X509_STORE_CTX_get_app_data(inner)) =
+            X509_STORE_CTX_get_error_depth(inner);
+      }
+      return ok;
+    });
+    X509_STORE_CTX_set_app_data(ctx, &depth);
+  };
+  EXPECT_EQ(X509_V_ERR_KEYUSAGE_NO_CERTSIGN,
+            Verify(leaf.get(), {root.get()}, {}, {}, 0, record_depth));
+  EXPECT_EQ(1, depth);
+
+  // An untrusted intermediate without keyCertSign below a good root: the
+  // chain builds through it and its CA check fails first.
+  UniquePtr<X509> real_root =
+      MakeTestCert("Root", "Root", key.get(), /*is_ca=*/true);
+  ASSERT_TRUE(real_root);
+  ASSERT_TRUE(AddKeyUsage(real_root.get(), kCertSign));
+  ASSERT_TRUE(X509_sign(real_root.get(), key.get(), EVP_sha256()));
+  UniquePtr<X509> intermediate =
+      MakeTestCert("Root", "Intermediate", key.get(), /*is_ca=*/true);
+  ASSERT_TRUE(intermediate);
+  ASSERT_TRUE(AddKeyUsage(intermediate.get(), kNoCertSign));
+  ASSERT_TRUE(X509_sign(intermediate.get(), key.get(), EVP_sha256()));
+  UniquePtr<X509> leaf2 =
+      MakeTestCert("Intermediate", "Leaf", key.get(), /*is_ca=*/false);
+  ASSERT_TRUE(leaf2);
+  ASSERT_TRUE(X509_sign(leaf2.get(), key.get(), EVP_sha256()));
+  EXPECT_EQ(X509_V_ERR_INVALID_CA,
+            Verify(leaf2.get(), {real_root.get()}, {intermediate.get()}, {}));
+
+  // `X509_check_issued` keeps the key usage check for its callers.
+  UniquePtr<X509> no_certsign = make_self_signed(false, kNoCertSign);
+  ASSERT_TRUE(no_certsign);
+  EXPECT_EQ(X509_V_ERR_KEYUSAGE_NO_CERTSIGN,
+            X509_check_issued(no_certsign.get(), no_certsign.get()));
+}
