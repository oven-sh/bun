+int bssl::x509_signing_allowed(const X509 *issuer) {
+  if (!x509v3_cache_extensions(const_cast<X509 *>(issuer))) {
+    return X509_V_ERR_UNSPECIFIED;
+  }
   if (ku_reject(issuer, X509v3_KU_KEY_CERT_SIGN)) {
     return X509_V_ERR_KEYUSAGE_NO_CERTSIGN;
   }
   return X509_V_OK;
 }
 
+int X509_check_issued(const X509 *issuer, const X509 *subject) {
+  int ret = x509_likely_issued(issuer, subject);
+  if (ret != X509_V_OK) {
+    return ret;
+  }
+  return x509_signing_allowed(issuer);
+}
