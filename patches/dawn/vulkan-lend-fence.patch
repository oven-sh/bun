+std::pair<VkFence, ExecutionSerial> Queue::LendFenceAfter(ExecutionSerial serial) {
+    using FenceAndSerial = std::pair<VkFence, ExecutionSerial>;
+    return mFencesInFlight.Use([&](auto fencesInFlight) -> FenceAndSerial {
+        auto it = std::ranges::upper_bound(*fencesInFlight, serial, {}, &FenceAndSerial::second);
+        if (it == fencesInFlight->end()) {
+            return {VK_NULL_HANDLE, GetLastSubmittedCommandSerial()};
+        }
+        mUnusedFences.Use([&](auto) { mLentFence = it->first; });
+        return *it;
+    });
+}
