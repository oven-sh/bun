+// Same as LikelySubtagsData::toLanguage(), toScript() and toRegion().
+struct LikelySubtags::Likely {
+    Likely(const LikelySubtags &data, int32_t index) {
+        int32_t encoded = data.lsrs[index];
+        if (encoded == 0) { return; }
+        if (encoded == 1) {
+            language = "skip";
+            script = "script";
+            return;
+        }
+        script = data.scripts[(encoded >> 24) & 0xff];
+        encoded &= 0xffffff;
+        language = decode(encoded % (27 * 27 * 27), 'a', languageChars);
+        encoded = encoded / (27 * 27 * 27) % (27 * 27);
+        region = encoded < 27 ? data.m49[encoded] : decode(encoded, 'A', regionChars);
+    }
+    Likely(const Likely &other) = delete;
+
+    const char *language = "";
+    const char *script = "";
+    const char *region = "";
+
+private:
+    static const char *decode(int32_t letters, char first, char (&chars)[4]) {
+        chars[0] = first + (letters % 27 - 1);
+        chars[1] = first + (letters / 27 % 27 - 1);
+        chars[2] = letters < 27 * 27 ? 0 : first + (letters / (27 * 27) - 1);
+        chars[3] = 0;
+        return chars;
+    }
+
+    char languageChars[4];
+    char regionChars[4];
+};
