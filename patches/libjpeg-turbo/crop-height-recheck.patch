--- a/src/turbojpeg-mp.c
+++ b/src/turbojpeg-mp.c
@@ -231,10 +231,22 @@
     THROW("Invalid argument");
 
   croppedHeight = dinfo->output_height;
 #if BITS_IN_JSAMPLE != 16
-  if (this->croppingRegion.y != 0 || this->croppingRegion.h != 0)
+  if (this->croppingRegion.y != 0 || this->croppingRegion.h != 0) {
+    /* tj3SetCroppingRegion() validated the cropping region against the
+       dimensions from an earlier jpeg_read_header() call.  This function
+       reads the header again, so output_height can be smaller now.  The
