+/* Bun: RGBA8 pixels of 1/2/4-bit samples that index *plte, 8 pixels per iteration. `depth` is a constant in each copy. */
+static inline void expand_packed_row_n(unsigned char *row, const unsigned char *scanline, const struct spng_plte_entry *plte, uint32_t width, const unsigned depth)
+{
+    const unsigned per = 8 / depth, mask = (1 << depth) - 1;
+    const uint32_t groups = width / 8;
+    uint32_t i, k;
+    unsigned j, b;
+
+    for(i=0; i < groups; i++)
+    {
+        struct spng_plte_entry px[8];
+
+        for(b=0; b < depth; b++)
+        {
+            const unsigned packed = scanline[(size_t)i * depth + b];
+
+            for(j=0; j < per; j++) px[b * per + j] = plte[(packed >> (8 - depth * (j + 1))) & mask];
+        }
+
+        memcpy(row + (size_t)i * 32, px, 32);
+    }
+
+    for(k = groups * 8; k < width; k++) memcpy(row + (size_t)k * 4, &plte[(scanline[k / per] >> (8 - depth * (k % per + 1))) & mask], 4);
+}
+
+static void expand_packed_row(unsigned char *row, const unsigned char *scanline, const struct spng_plte_entry *plte, uint32_t width, unsigned depth)
+{
+    if(depth == 1) expand_packed_row_n(row, scanline, plte, width, 1);
+    else if(depth == 2) expand_packed_row_n(row, scanline, plte, width, 2);
+    else expand_packed_row_n(row, scanline, plte, width, 4);
+}
+
+/* Bun: RGBA8 pixels of an 8-bit gray row (`n` 1) or gray+alpha row (`n` 2). `key` is the tRNS sample of a gray row, or 256. */
+static inline void gray8_row_to_rgba8(unsigned char *row, const unsigned char *scanline, uint32_t width, const unsigned n, const unsigned key)
+{
+    uint32_t i;
+
+    for(i=0; i < width; i++)
+    {
+        const unsigned gray = scanline[(size_t)i * n];
+
+        row[(size_t)i * 4] = row[(size_t)i * 4 + 1] = row[(size_t)i * 4 + 2] = gray;
+        row[(size_t)i * 4 + 3] = (n == 2) ? scanline[(size_t)i * 2 + 1] : (gray == key) ? 0 : 255;
+    }
+}
+
