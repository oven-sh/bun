+        else if(ctx->ihdr.color_type == SPNG_COLOR_TYPE_GRAYSCALE_ALPHA) gray8_row_to_rgba8(out, scanline, width, 2, 256);
+        else gray8_row_to_rgba8(out, scanline, width, 1, ctx->decode_flags.apply_trns ? ctx->trns.gray : 256);
+        return;
+    }
