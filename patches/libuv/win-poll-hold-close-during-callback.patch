-      handle->poll_cb(handle, uv_translate_sys_error(err), 0);
+      uv__poll_invoke_cb(handle, uv_translate_sys_error(err), 0);
     }
   } else {
     /* Got some events. */
     int events = req->u.io.overlapped.InternalHigh & handle->events & ~mask_events;
     if (events != 0) {
-      handle->poll_cb(handle, 0, events);
+      uv__poll_invoke_cb(handle, 0, events);
     }
   }
 
@@ -627,5 +642,8 @@
