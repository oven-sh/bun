+/* poll_cb may run the loop again (a nested uv_run) and close the handle in
+ * there. The callers below read the handle after poll_cb returns, so the nested
+ * run must not finish that close: uv__poll_endgame leaves a handle with this
+ * flag alone and the outermost caller queues the endgame again. Streams get the
+ * same guarantee from reqs_pending, which stays raised across their callbacks. */
+static void uv__poll_invoke_cb(uv_poll_t* handle, int status, int events) {
+  unsigned int nested = handle->flags & UV_HANDLE_POLL_IN_CALLBACK;
+
+  handle->flags |= UV_HANDLE_POLL_IN_CALLBACK;
+  handle->poll_cb(handle, status, events);
+  if (!nested)
+    handle->flags &= ~UV_HANDLE_POLL_IN_CALLBACK;
+}
+
+
 static void uv__fast_poll_process_poll_req(uv_loop_t* loop, uv_poll_t* handle,
     uv_req_t* req) {
   unsigned char mask_events;
@@ -174,7 +189,7 @@
     DWORD error = GET_REQ_SOCK_ERROR(req);
     if (error != WSAEINTR && handle->events != 0) {
       handle->events = 0; /* Stop the watcher */
-      handle->poll_cb(handle, uv_translate_sys_error(error), 0);
+      uv__poll_invoke_cb(handle, uv_translate_sys_error(error), 0);
     }
 
   } else if (afd_poll_info->NumberOfHandles >= 1) {
@@ -230,7 +245,7 @@
     }
 
     if (events != 0) {
-      handle->poll_cb(handle, 0, events);
+      uv__poll_invoke_cb(handle, 0, events);
