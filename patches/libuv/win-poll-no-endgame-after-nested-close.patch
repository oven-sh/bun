--- a/src/win/poll.c
+++ b/src/win/poll.c
@@ -241,9 +241,16 @@
   if ((handle->events & ~(handle->submitted_events_1 |
       handle->submitted_events_2)) != 0) {
     uv__fast_poll_submit_poll_req(loop, handle);
-  } else if ((handle->flags & UV_HANDLE_CLOSING) &&
+  } else if ((handle->flags & (UV_HANDLE_CLOSING | UV_HANDLE_CLOSED)) ==
+                 UV_HANDLE_CLOSING &&
              handle->submitted_events_1 == 0 &&
              handle->submitted_events_2 == 0) {
+    /* Not when UV_HANDLE_CLOSED is already set: poll_cb re-entered uv_run
+     * (Bun does this for synchronous waits), and the nested run closed this
+     * handle and ran its endgame. Queueing it again would run
+     * uv__poll_endgame a second time: uv__active_handle_rm twice and a
+     * second close_cb. (usockets keeps the handle allocated until the
+     * outermost run's check phase, so reading it here is fine.) */
     uv__want_endgame(loop, (uv_handle_t*) handle);
   }
 }
@@ -442,9 +449,11 @@
   if ((handle->events & ~(handle->submitted_events_1 |
       handle->submitted_events_2)) != 0) {
     uv__slow_poll_submit_poll_req(loop, handle);
-  } else if ((handle->flags & UV_HANDLE_CLOSING) &&
+  } else if ((handle->flags & (UV_HANDLE_CLOSING | UV_HANDLE_CLOSED)) ==
+                 UV_HANDLE_CLOSING &&
              handle->submitted_events_1 == 0 &&
              handle->submitted_events_2 == 0) {
+    /* See uv__fast_poll_process_poll_req. */
     uv__want_endgame(loop, (uv_handle_t*) handle);
   }
 }
