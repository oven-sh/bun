+/* A console in raw mode queues one input record per byte typed or pasted, and
+ * a ReadConsoleInputW call costs a kernel transition of ~15us, so reading one
+ * record per call caps raw-mode input at tens of KB/s. Read a batch per call
+ * instead. */
+#define UV_TTY_READ_BATCH 128
 
 /* TODO: put the parser states in a union - TTY handles are always half-duplex
  * so read-state can safely overlap write-state. */
@@ -512,6 +518,12 @@
       unsigned char last_key_len;                                             \
       WCHAR last_utf16_high_surrogate;                                        \
       INPUT_RECORD last_input_record;                                         \
+      /* Console records read by one ReadConsoleInputW call, and how many of  \
+       * them the raw reader still has to translate. Records stay here when a  \
+       * read_cb pauses reading, so a paused read does not drop input. */     \
+      INPUT_RECORD read_batch[UV_TTY_READ_BATCH];                             \
+      DWORD read_batch_len;                                                   \
+      DWORD read_batch_index;                                                 \
     } rd;                                                                     \
