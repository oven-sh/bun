+            Settings {
+                element_content_handlers,
+                document_content_handlers,
+                encoding: AsciiCompatibleEncoding::new(encoding).unwrap(),
+                ..Settings::new()
+            },
+            |c: &[u8]| output.extend_from_slice(c),
+        );
