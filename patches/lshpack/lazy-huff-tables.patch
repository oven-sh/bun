+     * The first to publish keeps its own; a later encode/decode load on any
+     * thread comes after that thread's own call returned, so it sees them. */
+    if (!__atomic_compare_exchange_n(&lshpack_huff_tables, &none, tables, 0,
+                                     __ATOMIC_RELEASE, __ATOMIC_ACQUIRE))
+        free(tables);
+}
