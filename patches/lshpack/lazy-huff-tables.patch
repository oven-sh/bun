 #include "huff-tables.h"
 
+#if LS_HPACK_USE_LARGE_TABLES && LS_HPACK_LAZY_LARGE_TABLES
+/* Bun: hencs[65536] (512 KB) and hdecs[65536] (256 KB) are pure functions of
+ * encode_table[257]. They are left out of .rodata, and built once, at the
+ * first lshpack/lsqpack init, in memory that is allocated then: ~250 us,
+ * identical hot-path lookup afterwards. As zero-filled data of the executable
+ * (.bss) they made it large enough for a transparent huge page.
+ * Non-static so lsqpack.c can use the same tables instead of carrying its
+ * own copy. */
+struct henc { unsigned lens; uint32_t code; };
+struct hdec { uint8_t lens; uint8_t out[3]; };
+struct lshpack_huff_tables { struct henc encs[65536]; struct hdec decs[65536]; };
+struct lshpack_huff_tables *lshpack_huff_tables;
+#define hencs (__atomic_load_n(&lshpack_huff_tables, __ATOMIC_RELAXED)->encs)
+#define hdecs (__atomic_load_n(&lshpack_huff_tables, __ATOMIC_RELAXED)->decs)
+
+#if __BYTE_ORDER == __LITTLE_ENDIAN
+#define HENC_I(i,j) (((j)<<8)|(i))
+#else
+#define HENC_I(i,j) (((i)<<8)|(j))
+#endif
+
+void
+lshpack_huff_tables_init (void)
+{
+    struct lshpack_huff_tables *tables, *none = NULL;
+    struct { uint8_t bits, sym; } *lut;
+
+    if (__atomic_load_n(&lshpack_huff_tables, __ATOMIC_ACQUIRE))
+        return;
+
+    /* Both start zeroed: an entry of decs that stays zero takes the slow path. */
+    tables = calloc(1, sizeof(*tables));
+    lut = calloc(1 << 15, sizeof(*lut));
+    if (!tables || !lut)
+        abort();
+
+    /* hencs: combine two encode_table entries. {64,0} marks pairs whose
+     * combined width overflows 32 bits (handled by the slow loop). */
+    for (unsigned i = 0; i < 256; ++i)
+    {
+        const unsigned bi = encode_table[i].bits;
+        const uint32_t ci = encode_table[i].code;
+        for (unsigned j = 0; j < 256; ++j)
+        {
+            const unsigned bj = encode_table[j].bits;
+            struct henc *h = &tables->encs[HENC_I(i, j)];
+            if (bi + bj <= 32)
+            {
+                h->lens = bi + bj;
+                h->code = (ci << bj) | encode_table[j].code;
+            }
+            else
+            {
+                h->lens = 64;
+                h->code = 0;
+            }
+        }
+    }
+
+    /* hdecs: for each 16-bit prefix, decode up to 3 symbols using a 15-bit
+     * direct LUT built from encode_table (codes <= 15 bits cover the common
+     * ASCII set; longer codes fall through to the slow path with lens==0). */
+    for (unsigned sym = 0; sym < 256; ++sym)
+    {
+        const unsigned b = encode_table[sym].bits;
+        if (b > 15)
+            continue;
+        const unsigned base = encode_table[sym].code << (15 - b);
+        for (unsigned k = 0; k < (1u << (15 - b)); ++k)
+        {
+            lut[base + k].bits = (uint8_t) b;
+            lut[base + k].sym = (uint8_t) sym;
+        }
+    }
+    for (unsigned idx = 0; idx < 65536; ++idx)
+    {
+        unsigned bits_left = 16, n = 0;
+        uint8_t out[3] = {0,0,0};
+        while (bits_left >= 5 && n < 3)
+        {
+            const unsigned rem = idx & ((1u << bits_left) - 1);
+            const unsigned key = bits_left >= 15
+                ? (rem >> (bits_left - 15))
+                : (rem << (15 - bits_left));
+            const unsigned b = lut[key].bits;
+            if (!b || b > bits_left)
+                break;
+            out[n++] = lut[key].sym;
+            bits_left -= b;
+        }
+        if (n)
+        {
+            tables->decs[idx].lens = (uint8_t)(((16 - bits_left) << 2) | n);
+            tables->decs[idx].out[0] = out[0];
+            tables->decs[idx].out[1] = out[1];
+            tables->decs[idx].out[2] = out[2];
+        }
+        /* else: leave zeroed — lens==0 triggers slow path */
+    }
