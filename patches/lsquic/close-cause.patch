+/* bun: why a connection closed.  lsquic_conn_status() gives no error code,
+ * and it reports every error that comes with a failed handshake as
+ * LSCONN_ST_VERNEG_FAILURE.
+ */
+enum lsquic_close_cause
+{
+    /* The connection is not closing. */
+    LSQ_CLOSE_NONE,
+    /* lsquic_conn_close(), a finished GOAWAY, or the peer's
+     * CONNECTION_CLOSE. */
+    LSQ_CLOSE_CLOSED,
+    /* This side aborted the connection: it found an error, the application
+     * called lsquic_conn_abort_error(), or a server's streams made no
+     * progress for es_noprogress_timeout. */
+    LSQ_CLOSE_ERROR,
+    LSQ_CLOSE_TIMED_OUT,
+    /* lsquic_conn_abort() */
+    LSQ_CLOSE_USER_ABORTED,
+    /* Stateless reset */
+    LSQ_CLOSE_RESET,
+    LSQ_CLOSE_HSK_FAILED,
+    LSQ_CLOSE_VERNEG_FAILED,
+};
+
+struct lsquic_close_info
+{
+    enum lsquic_close_cause cause;
+    /* For LSQ_CLOSE_ERROR: the error this side selects for its
+     * CONNECTION_CLOSE frame.  `is_app' is non-zero for an application
+     * error code (frame type 0x1d) and zero for a transport error code
+     * (frame type 0x1c).  Both are zero for every other cause. */
+    int                     is_app;
+    uint64_t                code;
+    /* The error message, NUL-terminated, or NULL.  It belongs to the
+     * connection: copy it before on_conn_closed() returns. */
+    const char             *reason;
+};
+
+/* bun: how a full IETF connection closed.  Call it from on_conn_closed().
+ *
+ * @retval  0   Success.
+ * @retval -1   This is not a full IETF connection.
+ */
+int
+lsquic_conn_close_info (lsquic_conn_t *, struct lsquic_close_info *info);
+
