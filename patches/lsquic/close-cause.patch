+/* bun: see lsquic.h.  The error is the one conn_close_error() selects for
+ * this side's CONNECTION_CLOSE frame.  immediate_close() does not always
+ * send it as selected: an application error in a Handshake packet goes out
+ * as APPLICATION_ERROR with no reason ([RFC 9000] Section 10.2.3), and a
+ * connection that cannot encrypt a packet yet sends no frame.
+ */
+int
+lsquic_conn_close_info (struct lsquic_conn *lconn,
+                                            struct lsquic_close_info *info)
+{
+    const struct ietf_full_conn *conn;
+    struct conn_err conn_err;
+    const char *wire_reason;
+
+    if ((lconn->cn_flags & (LSCONN_MINI|LSCONN_IETF)) != LSCONN_IETF)
+        return -1;
+    conn = (const struct ietf_full_conn *) lconn;
+
+    info->is_app = 0;
+    info->code = 0;
+    /* The text this side recorded.  It says more than the text that
+     * conn_close_error() sends when no error code is recorded. */
+    info->reason = conn->ifc_errmsg;
+
+    switch (ietf_full_conn_ci_status(lconn, NULL, 0))
+    {
+    case LSCONN_ST_VERNEG_FAILURE:
+        /* ci_status() returns this whenever IFC_ERROR and IFC_HSK_FAILED are
+         * both set.  Only a handshake that failed before version negotiation
+         * ended is a failed version negotiation.  Every other one is an
+         * error: a TLS alert, bad transport parameters. */
+        if (!(conn->ifc_flags & IFC_SERVER)
+                    && conn->ifc_u.cli.ifcli_ver_neg.vn_state != VN_END)
+        {
+            info->cause = LSQ_CLOSE_VERNEG_FAILED;
+            break;
+        }
+        /* fall through */
+    case LSCONN_ST_ERROR:
+        info->cause = LSQ_CLOSE_ERROR;
+        conn_err = conn_close_error(conn, &wire_reason);
+        info->is_app = conn_err.app_error;
+        info->code = conn_err.u.err;
+        break;
+    case LSCONN_ST_TIMED_OUT:
+        info->cause = LSQ_CLOSE_TIMED_OUT;
+        break;
+    case LSCONN_ST_USER_ABORTED:
+        info->cause = LSQ_CLOSE_USER_ABORTED;
+        break;
+    case LSCONN_ST_RESET:
+        info->cause = LSQ_CLOSE_RESET;
+        break;
+    case LSCONN_ST_HSK_FAILURE:
+        info->cause = LSQ_CLOSE_HSK_FAILED;
+        break;
+    case LSCONN_ST_CLOSED:
+        info->cause = LSQ_CLOSE_CLOSED;
+        break;
+    default:
+        info->cause = LSQ_CLOSE_NONE;
+        break;
+    }
+
+    return 0;
+}
