+/* bun: the DATAGRAM frames that were last reported LSQ_DG_LOST, oldest
+ * first.  A loss is a guess: the packet can still arrive, and the peer then
+ * acknowledges it.  ngtcp2 keeps a lost packet and reports that late
+ * acknowledgement (ack_datagram after lost_datagram), so node:quic has to:
+ * https://github.com/nodejs/node/blob/v26.3.0/deps/ngtcp2/ngtcp2/lib/ngtcp2_rtb.c#L491-L515
+ * https://github.com/nodejs/node/blob/v26.3.0/deps/ngtcp2/ngtcp2/lib/ngtcp2_rtb.c#L704-L716
+ * lsquic has dropped the packet by then, so the pair (packet number, id) is
+ * kept here.  Nothing in this list feeds loss detection or congestion
+ * control.
+ *
+ * Which packets are declared lost is not as in ngtcp2.  lsquic also gives
+ * up on packets when a retransmission timer expires (TLP, RTO), with no ACK
+ * of a later packet.  ngtcp2 only sends probes then.  For a packet that was
+ * slow, ngtcp2 reports the acknowledgement alone, and this list turns the
+ * report of lsquic into LSQ_DG_LOST followed by the late acknowledgement.
+ *
+ * A frame leaves the list when an ACK covers its packet, when an ACK is
+ * SC_LOST_DGRAM_REACH packets past it, or when SC_MAX_LOST_DGRAMS newer
+ * frames are lost.  Both numbers are choices made here.  ngtcp2 keeps a
+ * lost packet for 3 PTOs, and at most the newest
+ * max(3, min(256, packets in flight / 2)) lost packets:
+ * https://github.com/nodejs/node/blob/v26.3.0/deps/ngtcp2/ngtcp2/lib/ngtcp2_conn.c#L11418-L11431
+ * https://github.com/nodejs/node/blob/v26.3.0/deps/ngtcp2/ngtcp2/lib/ngtcp2_rtb.c#L1051-L1060
+ * https://github.com/nodejs/node/blob/v26.3.0/deps/ngtcp2/ngtcp2/lib/ngtcp2_rtb.c#L1195
+ * The list is longer than 3, because a retransmission timeout reports
+ * every DATAGRAM frame in flight at once.
+ */
+#define SC_MAX_LOST_DGRAMS 32
+#define SC_LOST_DGRAM_REACH 256
+
+struct lost_dgrams
+{
+    unsigned                    ld_count;
+    struct {
+        lsquic_packno_t         packno;
+        uint64_t                id;
+    }                           ld_el[SC_MAX_LOST_DGRAMS];
+};
+
+
+static void
+send_ctl_keep_lost_datagram (struct lsquic_send_ctl *ctl,
+                                        lsquic_packno_t packno, uint64_t id)
+{
+    struct lost_dgrams *ld = ctl->sc_lost_dgrams;
+
+    if (!ld)
+    {
+        ld = malloc(sizeof(*ld));
+        if (!ld)
+            return;
+        ld->ld_count = 0;
+        ctl->sc_lost_dgrams = ld;
+    }
+    if (SC_MAX_LOST_DGRAMS == ld->ld_count)
+        memmove(ld->ld_el, ld->ld_el + 1,
+                                --ld->ld_count * sizeof(ld->ld_el[0]));
+    ld->ld_el[ld->ld_count].packno = packno;
+    ld->ld_el[ld->ld_count].id = id;
+    ++ld->ld_count;
+    ctl->sc_flags |= SC_LOST_DGRAMS;
+}
+
+
+/* bun: an ACK covers the packet of a frame in the list: the packet was
+ * late.  Report the frame once and forget it.
+ */
+static void
+send_ctl_ack_lost_datagrams (struct lsquic_send_ctl *ctl,
+                                                const struct ack_info *acki)
+{
+    struct lost_dgrams *const ld = ctl->sc_lost_dgrams;
+    const struct lsquic_packno_range *const end
+                                        = acki->ranges + acki->n_ranges;
+    const struct lsquic_packno_range *range;
+    lsquic_packno_t packno;
+    unsigned i, n_kept;
+
+    for (i = 0, n_kept = 0; i < ld->ld_count; ++i)
+    {
+        packno = ld->ld_el[i].packno;
+        /* The ranges are in descending order */
+        for (range = acki->ranges; range < end && range->low > packno; ++range)
+            ;
+        if (range < end && packno <= range->high)
+            ctl->sc_enpub->enp_stream_if->on_datagram_late_ack(
+                            ctl->sc_conn_pub->lconn, ld->ld_el[i].id);
+        else if (largest_acked(acki) <= packno + SC_LOST_DGRAM_REACH)
+            ld->ld_el[n_kept++] = ld->ld_el[i];
+    }
+    ld->ld_count = n_kept;
+    if (0 == n_kept)
+        ctl->sc_flags &= ~SC_LOST_DGRAMS;
+}
