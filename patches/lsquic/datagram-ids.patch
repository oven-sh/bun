+/* bun: report each DATAGRAM frame in the packet under the id that
+ * write_datagram stored in its frame record.  DATAGRAM frames are never
+ * retransmitted (RFC 9221 Section 5), so each caller is the last place that
+ * can name them.
+ */
+static void
+send_ctl_report_datagrams (struct lsquic_send_ctl *ctl,
+        struct lsquic_packet_out *packet_out, enum lsquic_dg_status status)
+{
+    struct packet_out_frec_iter pofi;
+    struct frame_rec *frec;
+
+    if (!(packet_out->po_frame_types & QUIC_FTBIT_DATAGRAM)
+            || !ctl->sc_enpub->enp_stream_if->on_datagram_status)
+        return;
+
+    for (frec = lsquic_pofi_first(&pofi, packet_out); frec;
+                                                frec = lsquic_pofi_next(&pofi))
+        if (QUIC_FRAME_DATAGRAM == frec->fe_frame_type)
+            ctl->sc_enpub->enp_stream_if->on_datagram_status(
+                ctl->sc_conn_pub->lconn, frec->fe_u.data, status);
+}
