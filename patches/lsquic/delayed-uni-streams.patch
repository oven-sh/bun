+/* bun: lsquic_conn_cancel_pending_streams() for uni stream requests. */
+unsigned
+lsquic_conn_cancel_pending_uni_streams (struct lsquic_conn *lconn, unsigned n)
+{
+    struct ietf_full_conn *const conn = (struct ietf_full_conn *) lconn;
+    if (n > conn->ifc_n_delayed_uni_streams)
+        conn->ifc_n_delayed_uni_streams = 0;
+    else
+        conn->ifc_n_delayed_uni_streams -= n;
+    return conn->ifc_n_delayed_uni_streams;
+}
