+/* bun: until this is true, lsquic_conn_make_uni_stream() counts the request in
+ * ifc_n_delayed_uni_streams, as ifc_n_delayed_streams does for bidi. */
+static int
+can_create_uni_stream (const struct ietf_full_conn *conn)
+{
+    return handshake_done_or_doing_sess_resume(conn)
+        /* HTTP mode: on_settings_frame() creates the QPACK encoder stream.  A
+         * stream created before that takes its stream ID, and its credit when
+         * the peer only allows the three HTTP/3 streams. */
+        && (conn->ifc_flags & (IFC_HTTP|IFC_HAVE_PEER_SET)) != IFC_HTTP
+        && avail_streams_count(conn, conn->ifc_flags & IFC_SERVER, SD_UNI) > 0;
+}
