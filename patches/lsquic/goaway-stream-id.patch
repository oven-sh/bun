--- a/src/liblsquic/lsquic_full_conn_ietf.c
+++ b/src/liblsquic/lsquic_full_conn_ietf.c
@@ -9583,6 +9583,8 @@ on_goaway_client (void *ctx, uint64_t stream_id)
                 conn->ifc_u.cli.ifcli_min_goaway_stream_id);
             return;
         }
+        /* bun: a server that shuts down in two steps lowers the ID. */
+        conn->ifc_u.cli.ifcli_min_goaway_stream_id = stream_id;
     }
     else
     {
@@ -9605,6 +9607,22 @@ on_goaway_client (void *ctx, uint64_t stream_id)
 }
 
 
+/* bun: on_goaway_received() does not pass the ID.  Draft 27 gave it another
+ * meaning and on_goaway_client_27() does not store it. */
+lsquic_stream_id_t
+lsquic_conn_goaway_stream_id (const struct lsquic_conn *lconn)
+{
+    const struct ietf_full_conn *conn;
+
+    if ((lconn->cn_flags & (LSCONN_MINI|LSCONN_IETF|LSCONN_PEER_GOING_AWAY))
+                                    != (LSCONN_IETF|LSCONN_PEER_GOING_AWAY)
+        || lconn->cn_version == LSQVER_ID27)
+        return UINT64_MAX;
+    conn = (const struct ietf_full_conn *) lconn;
+    return conn->ifc_u.cli.ifcli_min_goaway_stream_id;
+}
