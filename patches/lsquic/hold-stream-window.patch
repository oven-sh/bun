+/* bun: the peer can send no more on this stream.  After a reset sf_read_off
+ * is the final size, not read_offset: an update would take the unread bytes'
+ * credit from the connection. */
+#define STREAM_RECV_WINDOW_DONE \
+                    (STREAM_FIN_RECVD|STREAM_RST_RECVD|STREAM_U_READ_DONE)
+
+
+/* bun: see lsquic.h */
+int
+lsquic_stream_hold_window (struct lsquic_stream *stream, int hold)
+{
+    if (stream->fc.sf_hold == (unsigned) !!hold)
+        return 0;
+    stream->fc.sf_hold = !!hold;
+    if (hold || (stream->stream_flags & STREAM_RECV_WINDOW_DONE))
+        return 0;
+    stream_consumed_bytes(stream);
+    return !!(stream->sm_qflags & SMQF_SEND_WUF);
+}
+
+
+/* bun: see lsquic.h */
+int
+lsquic_stream_grow_window (struct lsquic_stream *stream, unsigned window)
+{
+    if (stream->stream_flags & STREAM_RECV_WINDOW_DONE)
+        return 0;
+    stream->fc.sf_hold = 0;
+    if (stream->fc.sf_max_recv_win < window)
+        stream->fc.sf_max_recv_win = window;
+    stream_consumed_bytes(stream);
+    return 1;
+}
