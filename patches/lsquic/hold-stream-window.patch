+/* bun: see lsquic.h */
+void
+lsquic_stream_hold_window (struct lsquic_stream *stream, int hold)
+{
+    if (stream->fc.sf_hold == (unsigned) !!hold)
+        return;
+    stream->fc.sf_hold = !!hold;
+    /* After a reset sf_read_off is the final size, not read_offset: an
+     * update would take the unread bytes' credit from the connection. */
+    if (!hold && !(stream->stream_flags & (STREAM_RST_RECVD|STREAM_U_READ_DONE)))
+        stream_consumed_bytes(stream);
+}
+
+
+/* bun: see lsquic.h */
+void
+lsquic_stream_set_unread (struct lsquic_stream *stream, uint64_t unread)
+{
+    /* A stream whose final size is known needs no update. */
+    if (!(stream->stream_flags & (STREAM_FIN_RECVD|STREAM_RST_RECVD
+                                                    |STREAM_U_READ_DONE))
+            && lsquic_sfcw_fc_unread_changed(&stream->fc, unread))
+    {
+        if (!(stream->sm_qflags & SMQF_SENDING_FLAGS))
+            TAILQ_INSERT_TAIL(&stream->conn_pub->sending_streams, stream,
+                                                            next_send_stream);
+        stream->sm_qflags |= SMQF_SEND_WUF;
+        maybe_conn_to_tickable_if_writeable(stream, 1);
+    }
+}
