 /**
+ * bun: receive backpressure that leaves no data in the stream.  While the
+ * window is held, reads still credit the connection's window, but the stream's
+ * receive limit stays put and the peer gets no new MAX_STREAM_DATA.  An update
+ * queued before the hold still goes out, so the peer can send up to one window
+ * past the read offset.  Releasing the hold queues the update it held back,
+ * unless the stream was reset or read to its end.
+ *
+ * With lsquic_stream_wantread(s, 0) the unread data also uses up the
+ * connection's window, and it is dropped when the connection goes away.
+ */
+void
+lsquic_stream_hold_window (lsquic_stream_t *s, int hold);
