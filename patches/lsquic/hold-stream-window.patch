+/* bun: lsquic_stream_set_unread() */
+int
+lsquic_sfcw_fc_unread_changed (struct lsquic_sfcw *fc, uint64_t unread)
+{
+    const unsigned hold = fc->sf_hold;
+    int changed;
+
+    fc->sf_hold = 0;
+    fc->sf_read_off -= unread;
+    changed = lsquic_sfcw_fc_offsets_changed(fc);
+    fc->sf_read_off += unread;
+    fc->sf_hold = hold;
+    return changed;
+}
