+/* bun: see lsquic.h */
+void
+lsquic_stream_hold_window (struct lsquic_stream *stream, int hold)
+{
+    if (stream->fc.sf_hold == (unsigned) !!hold)
+        return;
+    stream->fc.sf_hold = !!hold;
+    /* After a reset, sf_read_off is the final size, not read_offset.  An update
+     * would take the credit for the unread bytes back from the connection. */
+    if (!hold && !(stream->stream_flags & (STREAM_RST_RECVD|STREAM_U_READ_DONE)))
+        stream_consumed_bytes(stream);
+}
