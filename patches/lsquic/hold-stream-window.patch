 /**
+ * bun: hold or release the stream's flow control window.  While it is held,
+ * the stream's receive limit does not advance: the stream is read as before,
+ * and the connection's window is credited as before, but reads earn the peer
+ * no new MAX_STREAM_DATA.  An update that a read queued before the hold still
+ * goes out, so the peer can send up to one window past the read offset at the
+ * hold.  A release queues the update that the hold kept back, unless the
+ * stream is reset or read to its end.  It goes out when the connection is
+ * next ticked.
+ *
+ * This is receive backpressure that leaves no data in the stream, unlike
+ * lsquic_stream_wantread(s, 0): data left there holds the connection's
+ * window too, and is dropped when the connection goes away.
+ */
+void
+lsquic_stream_hold_window (lsquic_stream_t *s, int hold);
+
+/**
+ * bun: the application still has `unread` of the bytes that it read from a
+ * stream whose window it holds.  The stream's window counts them as it counts
+ * the bytes that wait in the stream: the receive limit is one window past
+ * what the application has consumed, and it moves when less than half a
+ * window is left.  The connection's window does not count them.
+ *
+ * A held stream's limit moves only here.  The application calls this as it
+ * consumes what it read while it held the window.
+ */
+void
+lsquic_stream_set_unread (lsquic_stream_t *s, uint64_t unread);
