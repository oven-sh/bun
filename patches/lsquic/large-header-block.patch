     }
 #ifndef WIN32
-    unsigned char buf[buf_sz];
+    unsigned char stack_buf[max_push_size + max_prefix_size + MAX_HEADERS_SIZE];
+    if (max_headers_size > MAX_HEADERS_SIZE)
+    {
+        buf = malloc(buf_sz);
+        if (!buf)
+        {
+            LSQ_WARN("cannot allocate %zu bytes for header block", buf_sz);
+            return -1;
+        }
+    }
+    else
+        buf = stack_buf;
 #else
-    unsigned char *buf = _malloca(buf_sz);
+    buf = _malloca(buf_sz);
     if (!buf)
         return -1;
 #endif
@@ -4234,6 +4269,9 @@ send_headers_ietf (struct lsquic_stream *stream,
