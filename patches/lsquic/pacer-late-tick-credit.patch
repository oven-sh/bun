+                        && pacer->pa_next_sched < pacer->pa_credit_since)
+    {
+        LSQ_DEBUG("credit bounded to %"PRIu64" usec",
+                                            now - pacer->pa_credit_since);
+        pacer->pa_next_sched = pacer->pa_credit_since;
+    }
 }
 
 
