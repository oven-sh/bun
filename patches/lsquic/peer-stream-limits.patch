         conn->ifc_pii = &ext_prio_iter_if;
     else
         conn->ifc_pii = &orig_prio_iter_if;
+    /* bun: limits for the streams the peer opens.  The window that sizes
+     * MAX_STREAMS credit and the limit that incoming streams are checked
+     * against must both be the value gen_trans_params() advertises.
+     * Upstream seeds them in each constructor.  Its client reads
+     * es_max_streams_in (the gQUIC MIDS setting) for both directions and
+     * never es_init_max_streams_{bidi,uni}, and both constructors shift in
+     * 32 bits, so a limit of 2^30 or more wraps.  An HTTP client keeps
+     * upstream's 3 unidirectional streams (control and the two QPACK
+     * streams), whatever es_init_max_streams_uni says.
+     */
+    {
+        const unsigned peer_is_server = !(flags & IFC_SERVER);
+        unsigned uni = enpub->enp_settings.es_init_max_streams_uni;
+        if ((flags & (IFC_SERVER|IFC_HTTP)) == IFC_HTTP)
+            uni = 3;
+        conn->ifc_max_streams_in[SD_BIDI]
+                            = enpub->enp_settings.es_init_max_streams_bidi;
+        conn->ifc_max_streams_in[SD_UNI] = uni;
+        conn->ifc_max_allowed_stream_id[gen_sit(peer_is_server, SD_BIDI)]
+            = (lsquic_stream_id_t) conn->ifc_max_streams_in[SD_BIDI]
+                                                                << SIT_SHIFT;
+        conn->ifc_max_allowed_stream_id[gen_sit(peer_is_server, SD_UNI)]
+            = (lsquic_stream_id_t) uni << SIT_SHIFT;
+    }
     return 0;
 }
 
