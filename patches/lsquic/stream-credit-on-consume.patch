+/* bun: see lsquic.h */
+void
+lsquic_stream_credit_on_consume (struct lsquic_stream *stream)
+{
+    stream->sm_dflags |= SMDF_CREDIT_ON_CONSUME;
+}
+
+
+int
+lsquic_stream_credit (struct lsquic_stream *stream, uint64_t n)
+{
+    struct lsquic_sfcw *const fc = &stream->fc;
+
+    if (n > fc->sf_unconsumed)
+        n = fc->sf_unconsumed;
+    fc->sf_unconsumed -= n;
+    /* No larger limit is of use to the peer.  After a reset sf_read_off is
+     * the final size, which lsquic_sfcw_consume_rem() gave to the
+     * connection: stream_consumed_bytes() would take it back. */
+    if (n == 0 || (stream->stream_flags
+                & (STREAM_FIN_RECVD|STREAM_RST_RECVD|STREAM_U_READ_DONE)))
+        return 0;
+    if (stream->sm_qflags & SMQF_SEND_WUF)
+    {
+        /* Not on the wire yet: the frame takes the limit it finds. */
+        fc->sf_recv_off = fc->sf_read_off - fc->sf_unconsumed
+                                                    + fc->sf_max_recv_win;
+        return 0;
+    }
+    /* As after a read: the limit moves once less than half of the window is
+     * left. */
+    stream_consumed_bytes(stream);
+    return !!(stream->sm_qflags & SMQF_SEND_WUF);
+}
