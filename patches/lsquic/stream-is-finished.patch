 /**
  * Send RESET_STREAM(error_code) regardless of FIN state; the read side ends
  * only if the peer FIN'd/RST'd. maybe_reset skips RST when FIN was sent.
--- a/src/liblsquic/lsquic_stream.c
+++ b/src/liblsquic/lsquic_stream.c
@@ -4473,6 +4473,16 @@ lsquic_stream_get_error_code (const lsquic_stream_t *stream)
 }
 
 
+/* bun: whether the stream completed on its own (both sides closed and
+ * acknowledged) as opposed to being torn down with its connection. Valid
+ * inside on_close(). */
+int
+lsquic_stream_is_finished (const lsquic_stream_t *stream)
+{
+    return (stream->stream_flags & STREAM_FINISHED) != 0;
+}
