+/* bun: the Tickable Queue can give a connection that the running pass ticked
+ * already.  lsquic_engine_packet_in() queues a connection also during its
+ * tick or after it, and a callback that runs its application's event loop
+ * gets a packet read in the middle of a pass.  Such a connection stays on the
+ * queue for the next pass.  It is set aside here until the pop finds a
+ * connection that is still due, or none.  If more of them come than fit, the
+ * pass ends there.  Not inline: conn_iter_next_tickable() is in the tick loop.
+ */
+#if __GNUC__ || __clang__
+__attribute__((noinline))
+#endif
+static lsquic_conn_t *
+conn_iter_skip_ticked (struct lsquic_engine *engine, lsquic_conn_t *conn)
+{
+    lsquic_conn_t *ticked[8];
+    unsigned n_ticked = 0;
+
+    do
+    {
+        ticked[n_ticked++] = conn;
+        if (n_ticked < sizeof(ticked) / sizeof(ticked[0]))
+            conn = lsquic_mh_pop(&engine->conns_tickable);
+        else
+            conn = NULL;
+    }
+    while (conn && (conn->cn_flags & LSCONN_TICKED));
+
+    while (n_ticked > 0)
+    {
+        --n_ticked;
+        lsquic_mh_insert(&engine->conns_tickable, ticked[n_ticked],
+                                        ticked[n_ticked]->cn_last_ticked);
+    }
+
+    return conn;
+}
+
+
