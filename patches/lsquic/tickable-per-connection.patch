                                                         lsquic_conn_t *);
 
+/* bun: true if a request to make `conn' tickable can be dropped, because the
+ * engine looks at the connection again on its own:
+ *   - LSCONN_TICKING: it is inside ci_tick().
+ *   - LSCONN_TICKED: this pass ticked it and calls ci_is_tickable() at the end.
+ *   - LSCONN_CLOSING: the engine closed it.
+ *   - not hashed while the engine is processing: the engine is creating it,
+ *     and will queue it, or is destroying it.
+ * The three flags are only set while the engine is processing, so outside of
+ * that nothing is dropped, same as upstream.  A macro, because most files that
+ * include this header only see an incomplete struct lsquic_conn.
+ */
+#define lsquic_engine_has_conn_in_hand(enpub, conn) (                         \
+    ((conn)->cn_flags & (LSCONN_TICKING|LSCONN_TICKED|LSCONN_CLOSING))        \
+    || (((enpub)->enp_flags & ENPUB_PROC)                                     \
+                                && !((conn)->cn_flags & LSCONN_HASHED)))
+
 /* Put connection onto Advisory Tick Time  Queue if it is not already on it.
  */
 void
