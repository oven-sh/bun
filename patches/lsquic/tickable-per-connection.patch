@@ -100,6 +100,21 @@
 lsquic_engine_add_conn_to_tickable (struct lsquic_engine_public *,
                                                         lsquic_conn_t *);
 
+/* bun: true if a request to make `conn' tickable can be skipped, because the
+ * engine, which is processing, looks at the connection again without one.
+ * It is inside ci_tick() (LSCONN_TICKING).  Or the running pass ticked it and
+ * asks ci_is_tickable() at its end (LSCONN_TICKED).  Or the engine closed it
+ * (LSCONN_CLOSING).  Or it is not hashed: the engine is creating it, and
+ * queues it, or is destroying it.  The three flags are set only while the
+ * engine is processing, so outside of that no request is skipped, as before.
+ * A macro, because struct lsquic_conn is incomplete in most files that
+ * include this header.
+ */
+#define lsquic_engine_has_conn_in_hand(enpub, conn) (                         \
+    ((conn)->cn_flags & (LSCONN_TICKING|LSCONN_TICKED|LSCONN_CLOSING))        \
+    || (((enpub)->enp_flags & ENPUB_PROC)                                     \
+                                && !((conn)->cn_flags & LSCONN_HASHED)))
+
 /* Put connection onto Advisory Tick Time  Queue if it is not already on it.
  */
 void
