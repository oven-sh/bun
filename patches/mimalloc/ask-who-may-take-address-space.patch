+bool _mi_is_looking_in_room_kept_aside(void) {
+  return is_looking_again;
+}
+
+// A request that has found no memory looks again for as long as the embedder makes room.
+static mi_decl_cold void* mi_malloc_generic_in_room_kept_aside(mi_theap_t* theap, size_t size, size_t zero_huge_alignment, mi_page_t** ppage)
+{
+  const mi_address_space_keeper_t* const keeper = _mi_address_space_keeper();
+  if (keeper == NULL || is_looking_again || _mi_theap_heap(theap)->exclusive_arena != NULL) return NULL;
+  void* p = NULL;
+  is_looking_again = true;
+  for (size_t attempt = 0; p == NULL && keeper->make_room(size, attempt); attempt++) {
+    p = mi_malloc_generic_fallback(theap, size, zero_huge_alignment, ppage);
+  }
+  is_looking_again = false;
+  return p;
+}
