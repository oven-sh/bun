+// An embedder that keeps address space aside for requests that cannot fail.
+// `may_take` is asked before address space is taken from the system for a page of blocks that are larger than those of a
+// small page; false refuses it as the system would.
+// `make_room` is asked when a request has found no memory; true says to look again. `attempt` counts from 0 for each request.
+#define MI_ASKS_ADDRESS_SPACE_KEEPER  1
+typedef struct mi_address_space_keeper_s {
+  bool (*may_take)(size_t size);
+  bool (*make_room)(size_t size, size_t attempt);
+} mi_address_space_keeper_t;
+mi_decl_export void mi_register_address_space_keeper(const mi_address_space_keeper_t* keeper) mi_attr_noexcept;
+
 mi_decl_export void mi_collect(bool force)      mi_attr_noexcept;
 
