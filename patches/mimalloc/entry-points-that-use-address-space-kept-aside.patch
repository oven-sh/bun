+
+// ------------------------------------------------------
+// Requests of an interface that cannot say which of them can fail
+// ------------------------------------------------------
+
+static mi_decl_noinline void* mi_must_malloc_again(size_t size, size_t alignment, bool zero) mi_attr_noexcept {
+  const mi_address_space_keeper_t* const keeper = mi_new_begin_asking_again(false);
+  if (keeper == NULL) return NULL;
+  void* p;
+  if (alignment == 0) { p = (zero ? mi_zalloc(size) : mi_malloc(size)); }
+                 else { p = (zero ? mi_zalloc_aligned(size,alignment) : mi_malloc_aligned(size,alignment)); }
+  keeper->end_request_that_cannot_fail();
+  return p;
+}
+
+static mi_decl_noinline void* mi_must_realloc_again(void* p, size_t newsize, size_t alignment) mi_attr_noexcept {
+  const mi_address_space_keeper_t* const keeper = mi_new_begin_asking_again(false);
+  if (keeper == NULL) return NULL;
+  void* const q = (alignment == 0 ? mi_realloc(p,newsize) : mi_realloc_aligned(p,newsize,alignment));
+  keeper->end_request_that_cannot_fail();
+  return q;
+}
+
+mi_decl_nodiscard mi_decl_restrict void* mi_must_malloc(size_t size) mi_attr_noexcept {
+  void* const p = mi_theap_malloc(_mi_theap_default(), size);
+  if mi_unlikely(p == NULL) return mi_must_malloc_again(size, 0, false);
+  return p;
+}
+
+mi_decl_nodiscard mi_decl_restrict void* mi_must_zalloc(size_t size) mi_attr_noexcept {
+  void* const p = mi_theap_zalloc(_mi_theap_default(), size);
+  if mi_unlikely(p == NULL) return mi_must_malloc_again(size, 0, true);
+  return p;
 }
 
+mi_decl_nodiscard void* mi_must_realloc(void* p, size_t newsize) mi_attr_noexcept {
+  void* const q = mi_realloc(p, newsize);
+  if mi_unlikely(q == NULL) return mi_must_realloc_again(p, newsize, 0);
+  return q;
+}
+
+mi_decl_nodiscard mi_decl_restrict void* mi_must_malloc_aligned(size_t size, size_t alignment) mi_attr_noexcept {
+  void* const p = mi_malloc_aligned(size, alignment);
+  if mi_unlikely(p == NULL) return mi_must_malloc_again(size, alignment, false);
+  return p;
+}
+
+mi_decl_nodiscard mi_decl_restrict void* mi_must_zalloc_aligned(size_t size, size_t alignment) mi_attr_noexcept {
+  void* const p = mi_zalloc_aligned(size, alignment);
+  if mi_unlikely(p == NULL) return mi_must_malloc_again(size, alignment, true);
+  return p;
+}
+
+mi_decl_nodiscard void* mi_must_realloc_aligned(void* p, size_t newsize, size_t alignment) mi_attr_noexcept {
+  void* const q = mi_realloc_aligned(p, newsize, alignment);
+  if mi_unlikely(q == NULL) return mi_must_realloc_again(p, newsize, alignment);
+  return q;
+}
