+// Allocate the tld of this thread and its theap for the main heap
+static mi_theap_t* mi_thread_alloc_tld_and_theap(mi_heap_t* heap_main) {
+  mi_tld_t* tld = mi_tld_create(heap_main->subproc);
+  if (tld==NULL) return NULL;    // out-of-memory on tld allocation
+  mi_theap_t* theap;
+  if (tld==&mi_process_tld_main) {
+    theap = &mi_process_theap_main;          // initial theap is pre-allocated
+    theap->memid = _mi_memid_create_static(theap,sizeof(*theap));
+  }
+  else {
+    theap = _mi_theap_alloc(heap_main,tld);  // otherwise meta allocate
+    if (theap==NULL) { mi_tld_free(tld); return NULL; } // out-of-memory on theap allocation
+  }
+  _mi_theap_init(theap,heap_main,tld);
+  return theap;
+}
 
+// The thread that asks again for its tld and theap. What is kept in the tld of a thread is kept for it in the tld of `theap_meta`, where it allocates.
+static _Atomic(mi_threadid_t) thread_without_tld;
+
+mi_tld_t* _mi_tld_lent_to_this_thread(void) {
+  return (mi_atomic_load_relaxed(&thread_without_tld) == _mi_thread_id() ? _mi_subproc_main()->theap_meta->tld : NULL);
+}
+
+// A thread without them can allocate nothing, so they are a request that cannot fail. One thread at a time.
+static mi_decl_cold mi_theap_t* mi_thread_alloc_tld_and_theap_in_room_kept_aside(mi_heap_t* heap_main) {
+  const mi_address_space_keeper_t* const keeper = _mi_address_space_keeper();
+  if (keeper == NULL || !_mi_subproc_is_main(heap_main->subproc)) return NULL;
+  mi_threadid_t none = 0;
+  while (!mi_atomic_cas_weak_acq_rel(&thread_without_tld, &none, _mi_thread_id())) { none = 0; _mi_prim_thread_yield(); }
+  keeper->begin_request_that_cannot_fail();
+  mi_theap_t* const theap = mi_thread_alloc_tld_and_theap(heap_main);
+  keeper->end_request_that_cannot_fail();
+  mi_atomic_store_release(&thread_without_tld, (mi_threadid_t)0);
+  return theap;
+}
+
