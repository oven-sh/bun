+static mi_decl_noinline void mi_free_block_local_to_hand_out_next(mi_page_t* page, mi_block_t* block, bool check_full)
+{
+  mi_block_set_next(page, block, page->free);
+  page->free = block;
+  page->free_is_zero = false;
+  if mi_unlikely(mi_page_alloc_count(page) >= 0x8000) { _mi_page_update_stats(page); }
+  const size_t used = mi_xused_dec_used(&page->xused);
+  mi_assert_internal(mi_page_alloc_count(page) + mi_page_last_used(page) >= mi_page_used(page));
+  if mi_unlikely(used == 0) {
+    if (page->retire_expire==0) {
+      _mi_page_retire(page);
+    }
+  }
+  else if mi_unlikely(check_full && mi_page_is_in_full(page)) {
+    _mi_page_unfull(page);
+  }
+}
 
