+
+static mi_decl_thread bool is_allocating_page_of_large_blocks;
+
+bool _mi_is_allocating_page_of_large_blocks(void) {
+  return is_allocating_page_of_large_blocks;
+}
+
+#define MI_PIECES_ASIDE_MAX  (64)
+static struct { void* start; size_t size; mi_memid_t memid; } pieces_aside[MI_PIECES_ASIDE_MAX];
+static size_t pieces_aside_count;
+
+bool mi_keep_piece_aside(size_t size) mi_attr_noexcept {
+  if (pieces_aside_count >= MI_PIECES_ASIDE_MAX) return false;
+  mi_heap_t* const heap = mi_heap_main();
+  mi_memid_t memid = _mi_memid_none();
+  // the keeper may call this while it is asked about a page: it is not asked about the piece
+  const bool was_allocating_page_of_large_blocks = is_allocating_page_of_large_blocks;
+  is_allocating_page_of_large_blocks = false;
+  void* const start = _mi_arenas_alloc(heap, size, false /* commit */, false /* allow large */, NULL, 0 /* thread seq */, -1 /* numa node */, &memid);
+  is_allocating_page_of_large_blocks = was_allocating_page_of_large_blocks;
+  if (start == NULL) return false;
+  if (memid.initially_committed) { _mi_os_reset(heap->subproc, start, size); }  // what an earlier owner wrote need not stay resident
+  pieces_aside[pieces_aside_count].start = start;
+  pieces_aside[pieces_aside_count].size = size;
+  pieces_aside[pieces_aside_count].memid = memid;
+  pieces_aside_count++;
+  return true;
+}
+
+bool mi_release_piece_kept_aside(void) mi_attr_noexcept {
+  if (pieces_aside_count == 0) return false;
+  pieces_aside_count--;
+  _mi_arenas_free(mi_heap_main()->subproc, pieces_aside[pieces_aside_count].start, pieces_aside[pieces_aside_count].size, pieces_aside[pieces_aside_count].memid);
+  return true;
 }
 
