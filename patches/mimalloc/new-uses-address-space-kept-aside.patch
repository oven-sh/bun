+// A throwing `new` cannot fail: it says so to an embedder that keeps address space aside, and asks once more.
+static const mi_address_space_keeper_t* mi_new_begin_asking_again(bool nothrow) {
+  const mi_address_space_keeper_t* const keeper = (nothrow ? NULL : _mi_address_space_keeper());
+  if (keeper == NULL || keeper->begin_request_that_cannot_fail == NULL) return NULL;
+  keeper->begin_request_that_cannot_fail();
+  return keeper;
+}
