+bool _mi_prim_env_may_have_prefix(const char* prefix) {
+  const size_t len = _mi_strlen(prefix);
+  char** env = mi_get_environ();
+  if (env == NULL) return true;
+  int i = 0;
+  for (; i < 10000 && env[i] != NULL; i++) {
+    if (_mi_strnicmp(prefix, env[i], len) == 0) return true;
+  }
+  return (i >= 10000);
