+// Most processes have no `mimalloc_` variable at all. One pass over the environment finds that out,
+// instead of a pass per option (and per legacy name) that also reads every option's name.
+static bool mi_env_may_have_options(void) {
+  static _Atomic(int) state; // 0: unknown, 1: no, 2: maybe
+  int known = mi_atomic_load_relaxed(&state);
+  if (known == 0) {
+    known = (_mi_prim_env_may_have_prefix("mimalloc_") ? 2 : 1);
+    mi_atomic_store_relaxed(&state, known);
+  }
+  return (known == 2);
+}
