+// Where an embedder keeps address space aside there may be none left when a page of an arena is first used. The part of the
+// page map for it is made ahead, or what the arena holds beyond that part's end could not be handed out.
+// Not for an exclusive arena, which can be far larger than what is ever used of it.
+static void mi_arena_ensure_page_map(mi_arena_t* arena) {
+  if (arena->is_exclusive) return;
+  if (!_mi_page_map_ensure_range(mi_arena_start(arena), mi_arena_size(arena))) {
+    _mi_warning_message("unable to extend the page map for an arena\n");
+  }
+}
+
+void _mi_arenas_ensure_page_map(mi_subproc_t* subproc) {
+  const size_t count = mi_arenas_get_count(subproc);
+  for (size_t i = 0; i < count; i++) {
+    mi_arena_t* const arena = mi_arena_from_index(subproc, i);
+    if (arena != NULL) { mi_arena_ensure_page_map(arena); }
+  }
+}
