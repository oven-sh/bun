     config->page_size = (size_t)psize;
@@ -568,6 +602,13 @@ int _mi_prim_reuse(void* start, size_t size) {
 
 int _mi_prim_decommit(void* start, size_t size, bool* needs_recommit) {
   int err = 0;
+  if (unix_host_commits) {
