   Generic allocation
 ----------------------------------------------------------- */
 
+static mi_decl_thread mi_failed_request_t failed_request;
+
+// An outer request (aligned, realloc) is remembered after the plain request that it made.
+mi_decl_cold void _mi_remember_failed_request(void* block, size_t size, size_t alignment) {
+  failed_request.block = block;
+  failed_request.size = size;
+  failed_request.alignment = alignment;
+}
+
+bool mi_last_failed_request(mi_failed_request_t* request) mi_attr_noexcept {
+  *request = failed_request;
+  return (request->size != 0);
+}
+
 static mi_decl_noinline void* mi_malloc_generic_fallback(mi_theap_t* theap, size_t size, size_t zero_huge_alignment, mi_page_t** ppage)
