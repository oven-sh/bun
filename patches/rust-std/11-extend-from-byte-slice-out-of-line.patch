Appending bytes to a `Vec<u8>` is a call when the length is not known at compile time. It ends in a jump to `memcpy`.

diff -ru a/library/alloc/src/vec/spec_extend.rs b/library/alloc/src/vec/spec_extend.rs
--- a/library/alloc/src/vec/spec_extend.rs
+++ b/library/alloc/src/vec/spec_extend.rs
@@ -52,9 +52,35 @@
 where
     T: TrivialClone,
 {
-    fn spec_extend(&mut self, iterator: slice::Iter<'a, T>) {
+    default fn spec_extend(&mut self, iterator: slice::Iter<'a, T>) {
         let slice = iterator.as_slice();
         // ignore-tidy-undocumented-unsafe
         unsafe { self.append_elements(slice) };
     }
 }
+
+// Bytes appended to a `Vec<u8>`. A length known at compile time becomes a few stores, inline.
+// Any other length needs a call to `memcpy` anyway: one copy of the code, called.
+impl<'a> SpecExtend<&'a u8, slice::Iter<'a, u8>> for Vec<u8> {
+    #[inline]
+    fn spec_extend(&mut self, iterator: slice::Iter<'a, u8>) {
+        #[inline(never)]
+        fn append(vec: &mut Vec<u8>, slice: &[u8]) {
+            let (len, count) = (vec.len(), slice.len());
+            vec.reserve(count);
+            // SAFETY: `count` bytes were reserved. The length is set first, so that the copy is the
+            // last thing done here and its call can be a jump.
+            unsafe {
+                vec.set_len(len + count);
+                core::ptr::copy_nonoverlapping(slice.as_ptr(), vec.as_mut_ptr().add(len), count);
+            }
+        }
+        let slice = iterator.as_slice();
+        if core::intrinsics::is_val_statically_known(slice.len()) {
+            // SAFETY: `u8` is `Copy`.
+            unsafe { self.append_elements(slice) };
+        } else {
+            append(self, slice);
+        }
+    }
+}
