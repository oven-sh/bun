`Vec::with_capacity(n)` is a call to one function per element layout when `n` is not known at compile time.

diff -ru a/library/alloc/src/raw_vec/mod.rs b/library/alloc/src/raw_vec/mod.rs
--- a/library/alloc/src/raw_vec/mod.rs
+++ b/library/alloc/src/raw_vec/mod.rs
@@ -175,12 +175,33 @@
     #[cfg(not(no_global_oom_handling))]
     #[inline]
     pub(crate) fn with_capacity_in(capacity: usize, alloc: A) -> Self {
+        // A capacity known at compile time folds the checks away: inline. Any other capacity, with
+        // an allocator without state (`Global`): one copy of the checks per element layout, called.
+        if size_of::<A>() == 0
+            && !T::IS_ZST
+            && !core::intrinsics::is_val_statically_known(capacity)
+        {
+            let ptr = Self::allocate_out_of_line(capacity);
+            // SAFETY: `capacity` elements were allocated with an `A` (none if it is zero).
+            return unsafe { Self::from_raw_parts_in(ptr, capacity, alloc) };
+        }
         Self {
             inner: RawVecInner::with_capacity_in(capacity, alloc, T::LAYOUT),
             _marker: PhantomData,
         }
     }
 
+    /// The buffer of `with_capacity_in(capacity, alloc)`, handed back in a register.
+    #[cfg(not(no_global_oom_handling))]
+    #[inline(never)]
+    fn allocate_out_of_line(capacity: usize) -> *mut T {
+        // SAFETY: `A` has size zero, the caller holds one, and this one is never dropped.
+        let alloc: A = unsafe { core::mem::MaybeUninit::uninit().assume_init() };
+        let inner =
+            core::mem::ManuallyDrop::new(RawVecInner::with_capacity_in(capacity, alloc, T::LAYOUT));
+        inner.ptr.as_ptr().cast()
+    }
+
     /// A specialized version of `self.reserve(len, 1)` which requires the
     /// caller to ensure `len == self.capacity()`.
     #[cfg(not(no_global_oom_handling))]
