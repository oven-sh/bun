+use std::ops::{Deref, DerefMut};
+use std::sync::{Arc, mpsc};
+
+use calloop::ping::Ping;
+use parking_lot::{Condvar, Mutex};
+
+#[derive(Default)]
+struct Status {
+    is_busy: bool,
+    when_done: Option<Ping>,
+}
+
+type Job = Box<dyn FnOnce() + Send>;
+
+/// Draws on a thread of its own, so that the main thread does not wait for the display.
+/// Using the value waits until that thread is done with it.
+pub(crate) struct Offloaded<T> {
+    value: *mut T,
+    status: Arc<(Mutex<Status>, Condvar)>,
+    /// `None` draws on the main thread.
+    jobs: Option<mpsc::Sender<Job>>,
+}
+
+struct AssertSend<T>(T);
+
+// SAFETY: the contract of `Offloaded::run`.
+unsafe impl<T> Send for AssertSend<T> {}
+
+impl<T: 'static> Offloaded<T> {
+    pub(crate) fn new(value: T, stays: bool) -> std::io::Result<Self> {
+        let mut jobs = None;
+        if !stays {
+            let (sender, received) = mpsc::channel::<Job>();
+            let thread = std::thread::Builder::new().name("Render".into());
+            thread.spawn(move || received.into_iter().for_each(|job| job()))?;
+            jobs = Some(sender);
+        }
+        Ok(Self {
+            value: Box::into_raw(Box::new(value)),
+            status: Arc::default(),
+            jobs,
+        })
+    }
+
+    /// # Safety
+    /// `job` shares nothing with this thread that is not `Sync`, through the value or otherwise.
+    pub(crate) unsafe fn run(&mut self, job: impl FnOnce(&mut T) + 'static) {
+        let Some(jobs) = &self.jobs else {
+            return job(self);
+        };
+        self.wait();
+        self.status.0.lock().is_busy = true;
+        let (status, captured) = (self.status.clone(), AssertSend((self.value, job)));
+        let job = move || {
+            let captured = captured;
+            let (value, job) = captured.0;
+            // SAFETY: the other thread does not use the value while this one is busy.
+            let run = || job(unsafe { &mut *value });
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(run)).ok();
+            let mut locked = status.0.lock();
+            locked.is_busy = false;
+            status.1.notify_all();
+            if let Some(ping) = locked.when_done.take() {
+                ping.ping();
+            }
+        };
+        jobs.send(Box::new(job)).ok();
+    }
+}
+
+impl<T> Offloaded<T> {
+    fn wait(&self) {
+        let mut status = self.status.0.lock();
+        self.status.1.wait_while(&mut status, |it| it.is_busy);
+    }
+
+    pub(crate) fn is_busy(&self) -> bool {
+        self.status.0.lock().is_busy
+    }
+
+    /// Returns whether it is busy.
+    pub(crate) fn ping_when_done(&self, ping: &Ping) -> bool {
+        let mut status = self.status.0.lock();
+        status.when_done = status.is_busy.then(|| ping.clone());
+        status.is_busy
+    }
+}
+
+impl<T> Deref for Offloaded<T> {
+    type Target = T;
+
+    fn deref(&self) -> &T {
+        self.wait();
+        // SAFETY: only `run` makes the other thread use it, and that borrows `self` mutably.
+        unsafe { &*self.value }
+    }
+}
+
+impl<T> DerefMut for Offloaded<T> {
+    fn deref_mut(&mut self) -> &mut T {
+        self.wait();
+        // SAFETY: as in `deref`.
+        unsafe { &mut *self.value }
+    }
+}
+
+impl<T> Drop for Offloaded<T> {
+    fn drop(&mut self) {
+        self.wait();
+        // SAFETY: it is from `Box::into_raw`.
+        drop(unsafe { Box::from_raw(self.value) });
+    }
+}
