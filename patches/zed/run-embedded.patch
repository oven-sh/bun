+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use gpui::{DevicePixels, Size, embed::Painter};
+use wayland_client::protocol::{wl_buffer, wl_shm, wl_surface};
+use wayland_client::{Connection, Dispatch, QueueHandle};
+
+use crate::linux::shared_pixels::SharedPixels;
+use crate::linux::WaylandClientStatePtr;
+
+struct Buffer {
+    pixels: SharedPixels,
+    buffer: wl_buffer::WlBuffer,
+    is_busy: Arc<AtomicBool>,
+}
+
+impl Drop for Buffer {
+    fn drop(&mut self) {
+        self.buffer.destroy();
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct WaylandPixels {
+    buffers: Vec<Buffer>,
+}
+
+impl WaylandPixels {
+    pub(crate) fn has_room(&self) -> bool {
+        let busy = (self.buffers.iter()).filter(|it| it.is_busy.load(Ordering::Relaxed));
+        busy.count() < 2
+    }
+
+    pub(crate) fn draw(
+        &mut self,
+        painter: Painter,
+        size: Size<DevicePixels>,
+        surface: &wl_surface::WlSurface,
+        shm: &wl_shm::WlShm,
+        qh: &QueueHandle<WaylandClientStatePtr>,
+    ) -> std::io::Result<()> {
+        self.buffers.retain(|buffer| buffer.pixels.size == size);
+        let is_first = self.buffers.is_empty();
+        let is_free = |buffer: &Buffer| !buffer.is_busy.load(Ordering::Relaxed);
+        let index = match self.buffers.iter().position(is_free) {
+            Some(index) => index,
+            None => {
+                let pixels = SharedPixels::new(size)?;
+                let (width, height) = (size.width.0.max(1), size.height.0.max(1));
+                let pool = shm.create_pool(pixels.fd(), width * height * 4, qh, ());
+                let (format, is_busy) = (wl_shm::Format::Argb8888, Arc::<AtomicBool>::default());
+                let buffer = pool.create_buffer(
+                    0,
+                    width,
+                    height,
+                    width * 4,
+                    format,
+                    qh,
+                    is_busy.clone(),
+                );
+                pool.destroy();
+                self.buffers.push(Buffer {
+                    pixels,
+                    buffer,
+                    is_busy,
+                });
+                self.buffers.len() - 1
+            }
+        };
+        let buffer = &mut self.buffers[index];
+        let painted = buffer.pixels.paint(painter, size, false);
+        let damage = [painted.moved, painted.areas].concat();
+        if damage.is_empty() && !is_first {
+            return Ok(());
+        }
+        surface.attach(Some(&buffer.buffer), 0, 0);
+        for area in damage {
+            let (origin, size) = (area.origin, area.size);
+            surface.damage_buffer(origin.x.0, origin.y.0, size.width.0, size.height.0);
+        }
+        buffer.is_busy.store(true, Ordering::Relaxed);
+        Ok(())
+    }
+}
+
+impl Dispatch<wl_buffer::WlBuffer, Arc<AtomicBool>> for WaylandClientStatePtr {
+    fn event(
+        _: &mut Self,
+        _: &wl_buffer::WlBuffer,
+        _: wl_buffer::Event,
+        is_busy: &Arc<AtomicBool>,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        is_busy.store(false, Ordering::Relaxed);
+    }
+}
