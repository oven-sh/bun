+use gpui::{Bounds, DevicePixels, Size, embed::Painter};
+use x11rb::{
+    connection::{Connection as _, RequestConnection as _},
+    cookie::Cookie,
+    protocol::shm::{self, ConnectionExt as _},
+    protocol::xproto::{self, ConnectionExt as _},
+    xcb_ffi::XCBConnection,
+};
+
+use crate::linux::shared_pixels::SharedPixels;
+
+struct Buffer {
+    pixels: SharedPixels,
+    /// Unless the server is on another machine.
+    segment: Option<shm::Seg>,
+    /// What the window shows, including where it is covered.
+    pixmap: xproto::Pixmap,
+}
+
+pub(crate) struct X11Pixels {
+    xcb: &'static XCBConnection,
+    window: xproto::Window,
+    depth: u8,
+    gc: xproto::Gcontext,
+    buffer: Option<Buffer>,
+    /// The server is done with the last frame when it replies.
+    fence: Option<Cookie<'static, XCBConnection, xproto::GetInputFocusReply>>,
+    pub(crate) size: Size<DevicePixels>,
+    pub(crate) is_exposed: bool,
+}
+
+impl X11Pixels {
+    pub(crate) fn new(
+        xcb: &'static XCBConnection,
+        window: xproto::Window,
+        depth: u8,
+        size: Size<DevicePixels>,
+    ) -> anyhow::Result<Self> {
+        let formats = &xcb.setup().pixmap_formats;
+        anyhow::ensure!(
+            (formats.iter()).any(|format| format.depth == depth && format.bits_per_pixel == 32),
+            "The display does not have 32 bits per pixel"
+        );
+        let gc = xcb.generate_id()?;
+        let values = xproto::CreateGCAux::new().graphics_exposures(0);
+        xcb.create_gc(gc, window, &values)?.check()?;
+        Ok(Self {
+            xcb,
+            window,
+            depth,
+            gc,
+            buffer: None,
+            fence: None,
+            size,
+            is_exposed: true,
+        })
+    }
+
+    fn attach(&self, pixels: &SharedPixels) -> anyhow::Result<shm::Seg> {
+        let segment = self.xcb.generate_id()?;
+        let fd = pixels.fd().try_clone_to_owned()?;
+        self.xcb.shm_attach_fd(segment, fd, true)?.check()?;
+        Ok(segment)
+    }
+
+    pub(crate) fn release(&mut self) -> anyhow::Result<()> {
+        if let Some(buffer) = self.buffer.take() {
+            self.xcb.free_pixmap(buffer.pixmap)?.ignore_error();
+            if let Some(segment) = buffer.segment {
+                self.xcb.shm_detach(segment)?.ignore_error();
+            }
+            self.xcb.flush()?;
+        }
+        Ok(())
+    }
+
+    fn copy(
+        &self,
+        from: xproto::Drawable,
+        to: xproto::Drawable,
+        area: Bounds<DevicePixels>,
+        down: i32,
+    ) -> anyhow::Result<()> {
+        let (x, y) = (area.origin.x.0 as i16, area.origin.y.0 as i16);
+        let (width, height) = (area.size.width.0 as u16, area.size.height.0 as u16);
+        let above = y - down as i16;
+        (self.xcb)
+            .copy_area(from, to, self.gc, x, above, x, y, width, height)?
+            .ignore_error();
+        Ok(())
+    }
+
+    pub(crate) fn draw(&mut self, painter: Painter) -> anyhow::Result<()> {
+        if let Some(fence) = self.fence.take() {
+            fence.reply()?;
+        }
+        let area = |size: Size<DevicePixels>| size.width.0 * size.height.0;
+        let fits = |buffer: &Buffer| {
+            let capacity = buffer.pixels.size;
+            capacity.max(&self.size) == capacity && area(capacity) / 3 <= area(self.size)
+        };
+        if !self.buffer.as_ref().is_some_and(fits) {
+            let spare = if self.buffer.is_some() { 256 } else { 0 };
+            self.release()?;
+            let pixels = SharedPixels::new(self.size.map(|it| DevicePixels(it.0 + spare)))?;
+            let (segment, pixmap) = (self.attach(&pixels).ok(), self.xcb.generate_id()?);
+            let (width, height) = (pixels.size.width.0 as u16, pixels.size.height.0 as u16);
+            (self.xcb)
+                .create_pixmap(self.depth, pixmap, self.window, width, height)?
+                .ignore_error();
+            self.buffer = Some(Buffer {
+                pixels,
+                segment,
+                pixmap,
+            });
+        }
+        let Some(buffer) = &mut self.buffer else {
+            return Ok(());
+        };
+        let painted = buffer.pixels.paint(painter, self.size, true);
+        let pixmap = buffer.pixmap;
+        for area in &painted.moved {
+            self.copy(pixmap, pixmap, *area, painted.moved_by)?;
+        }
+        self.put(&painted.areas)?;
+        let mut damage = [painted.moved, painted.areas].concat();
+        if std::mem::take(&mut self.is_exposed) {
+            damage = vec![Bounds::new(Default::default(), self.size)];
+        }
+        for area in damage {
+            self.copy(pixmap, self.window, area, 0)?;
+        }
+        self.fence = Some(self.xcb.get_input_focus()?);
+        self.xcb.flush()?;
+        Ok(())
+    }
+
+    fn put(&self, areas: &[Bounds<DevicePixels>]) -> anyhow::Result<()> {
+        let Some(Buffer {
+            pixels,
+            segment,
+            pixmap,
+        }) = &self.buffer
+        else {
+            return Ok(());
+        };
+        let format = xproto::ImageFormat::Z_PIXMAP;
+        for Bounds { origin, size } in areas {
+            let (x, y, width, height) = (origin.x.0, origin.y.0, size.width.0, size.height.0);
+            if let Some(segment) = *segment {
+                let cookie = self.xcb.shm_put_image(
+                    *pixmap,
+                    self.gc,
+                    pixels.size.width.0 as u16,
+                    pixels.size.height.0 as u16,
+                    x as u16,
+                    y as u16,
+                    width as u16,
+                    height as u16,
+                    x as i16,
+                    y as i16,
+                    self.depth,
+                    format.into(),
+                    false,
+                    segment,
+                    0,
+                );
+                cookie?.ignore_error();
+                continue;
+            }
+            let rows = (self.xcb.maximum_request_bytes() - 64) / (width as usize * 4);
+            for top in (y..y + height).step_by(rows.max(1)) {
+                let bottom = (top + rows.max(1) as i32).min(y + height);
+                let starts = (top..bottom).map(|row| (row * pixels.size.width.0 + x) as usize);
+                let data: Vec<_> = starts
+                    .flat_map(|start| &pixels.data()[start..start + width as usize])
+                    .copied()
+                    .collect();
+                let cookie = self.xcb.put_image(
+                    format,
+                    *pixmap,
+                    self.gc,
+                    width as u16,
+                    (bottom - top) as u16,
+                    x as i16,
+                    top as i16,
+                    0,
+                    self.depth,
+                    data.as_flattened(),
+                );
+                cookie?.ignore_error();
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Drop for X11Pixels {
+    fn drop(&mut self) {
+        if let Ok(cookie) = self.xcb.free_gc(self.gc) {
+            cookie.ignore_error();
+        }
+        self.release().ok();
+        self.xcb.flush().ok();
+    }
+}
