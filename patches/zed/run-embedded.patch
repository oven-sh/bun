+//! Metal, or a layer that the host fills.
+
+use crate::renderer;
+use anyhow::Result;
+use gpui::{DevicePixels, HeadlessAtlas, PlatformAtlas, Scene, Size};
+use objc2::{rc::Retained, runtime::ProtocolObject};
+use objc2_quartz_core::{CALayer, CAMetalDrawable, CAMetalLayer};
+use std::sync::Arc;
+
+pub(crate) enum Drawing {
+    Metal(renderer::Renderer),
+    Host(Retained<CALayer>),
+}
+
+impl Drawing {
+    pub fn new(context: renderer::Context, use_display_p3: bool) -> Result<Self> {
+        if !gpui::embed::paints_pixels() {
+            return renderer::new_renderer(context, false, use_display_p3).map(Self::Metal);
+        }
+        let layer = CALayer::new();
+        layer.setMasksToBounds(true);
+        layer.setNeedsDisplayOnBoundsChange(true);
+        Ok(Self::Host(layer))
+    }
+
+    fn metal(&self) -> Option<&renderer::Renderer> {
+        match self {
+            Self::Metal(renderer) => Some(renderer),
+            Self::Host(_) => None,
+        }
+    }
+
+    fn with_metal(&mut self, f: impl FnOnce(&mut renderer::Renderer)) {
+        if let Self::Metal(renderer) = self {
+            f(renderer);
+        }
+    }
+
+    pub fn is_host(&self) -> bool {
+        self.metal().is_none()
+    }
+
+    pub fn layer(&self) -> Option<&CAMetalLayer> {
+        self.metal()?.layer()
+    }
+
+    pub fn layer_ptr(&self) -> *mut CALayer {
+        match self {
+            Self::Metal(renderer) => renderer.layer_ptr().cast(),
+            Self::Host(layer) => Retained::as_ptr(layer).cast_mut(),
+        }
+    }
+
+    pub fn sprite_atlas(&self) -> Arc<dyn PlatformAtlas> {
+        match self {
+            Self::Metal(renderer) => renderer.sprite_atlas().clone(),
+            Self::Host(_) => Arc::new(HeadlessAtlas::default()),
+        }
+    }
+
+    pub fn is_display_link_attached(&self) -> bool {
+        self.metal().is_some_and(|it| it.is_display_link_attached())
+    }
+
+    pub fn presents_with_transaction(&self) -> bool {
+        self.metal().is_some_and(|it| it.presents_with_transaction())
+    }
+
+    pub fn set_display_link_attached(&mut self, attached: bool) {
+        self.with_metal(|it| it.set_display_link_attached(attached));
+    }
+
+    pub fn set_presents_with_transaction(&mut self, on: bool) {
+        self.with_metal(|it| it.set_presents_with_transaction(on));
+    }
+
+    pub fn set_frame_drawable(
+        &mut self,
+        drawable: Option<Retained<ProtocolObject<dyn CAMetalDrawable>>>,
+    ) -> Option<Retained<ProtocolObject<dyn CAMetalDrawable>>> {
+        match self {
+            Self::Metal(renderer) => renderer.set_frame_drawable(drawable),
+            Self::Host(_) => None,
+        }
+    }
+
+    pub fn update_drawable_size(&mut self, size: Size<DevicePixels>) {
+        self.with_metal(|it| it.update_drawable_size(size));
+    }
+
+    pub fn update_transparency(&mut self, transparent: bool) {
+        self.with_metal(|it| it.update_transparency(transparent));
+    }
+
+    pub fn draw(&mut self, scene: &Scene) {
+        self.with_metal(|it| it.draw(scene));
+    }
+}
