+//! Hooks for a host that owns the thread and its event loop.
+
+use crate::{Bounds, DevicePixels, DispatchEventResult, Modifiers, PlatformInput, Size, WindowId};
+use std::{cell::RefCell, rc::Rc};
+
+/// A key as the platform reported it, before input methods and key bindings.
+#[derive(Clone, Copy, Debug)]
+pub struct RawKey {
+    /// Pressed, as opposed to released.
+    pub down: bool,
+    /// The evdev code, the `kVK_` code, or the scan code with 0xE000 for an extended key.
+    pub scan_code: u32,
+    /// The keysym or the virtual key, and 0 on macOS.
+    pub symbol: u32,
+    /// The state before this key.
+    pub modifiers: Modifiers,
+}
+
+/// Premultiplied BGRA.
+pub struct Pixels<'a> {
+    /// What has the same id was not changed since the host painted it.
+    pub id: u64,
+    #[expect(missing_docs)]
+    pub data: &'a mut [[u8; 4]],
+    #[expect(missing_docs)]
+    pub width: usize,
+    /// The window shows this much, from the top left.
+    pub shown: Size<DevicePixels>,
+    /// The platform keeps what it shows. It only reads `Painted::areas` from `data`.
+    pub platform_moves: bool,
+}
+
+/// What differs from the last time that the window was painted.
+#[derive(Default)]
+pub struct Painted {
+    /// In this order, each shows what was `moved_by` pixels above it. Already done in the pixels
+    /// unless `platform_moves`.
+    pub moved: Vec<Bounds<DevicePixels>>,
+    #[expect(missing_docs)]
+    pub moved_by: i32,
+    #[expect(missing_docs)]
+    pub areas: Vec<Bounds<DevicePixels>>,
+}
+
+#[expect(missing_docs)]
+pub type Painter = Box<dyn FnOnce(Pixels) -> Painted + Send>;
+
+/// `input` and `before_frame` are called before GPUI borrows the `App` for the same event.
+pub trait Host {
+    /// Precedes whatever the key causes.
+    fn raw_key(&self, key: RawKey);
+    /// `Some` keeps the event from the window.
+    fn input(&self, window: WindowId, input: &PlatformInput) -> Option<DispatchEventResult>;
+    /// The window draws when this returns.
+    fn before_frame(&self, window: WindowId);
+    /// The platform's loop cannot be reentered, so the host calls `frame` after `Platform::pump`.
+    fn defer_frame(&self, window: WindowId, frame: Box<dyn FnOnce()>);
+    /// For a node of `Window::send_a11y_update`. The `App` is borrowed.
+    fn a11y_action(&self, request: &accesskit::ActionRequest);
+    /// Whether the next window does without a GPU, where the platform can.
+    fn paints_pixels(&self) -> bool;
+    /// Whether this thread has nothing else to do than the UI.
+    fn has_time_to_paint(&self) -> bool;
+    /// Instead of drawing the scene.
+    fn painter(&self, window: WindowId) -> Option<Painter>;
+    /// Instead of drawing the scene. `layer` is the `CALayer` of the window's view.
+    #[cfg(target_os = "macos")]
+    fn present(&self, window: WindowId, layer: *mut std::ffi::c_void);
+    /// The window has another size, and shows what is drawn next together with that.
+    #[cfg(target_os = "macos")]
+    fn before_resized_frame(&self, window: WindowId);
+    /// Whether the click that activates the window counts as a click.
+    #[cfg(target_os = "macos")]
+    fn accepts_first_mouse(&self, window: WindowId, position: crate::Point<crate::Pixels>) -> bool;
+}
+
+thread_local! {
+    static HOST: RefCell<Option<Rc<dyn Host>>> = const { RefCell::new(None) };
+}
+
+/// Installs the hooks for this thread.
+pub fn set_host(host: Rc<dyn Host>) {
+    HOST.set(Some(host));
+}
+
+fn host() -> Option<Rc<dyn Host>> {
+    HOST.with_borrow(Clone::clone)
+}
+
+#[expect(missing_docs)]
+pub fn has_host() -> bool {
+    HOST.with_borrow(Option::is_some)
+}
+
+pub(crate) fn a11y_action(request: &accesskit::ActionRequest) -> bool {
+    host().map(|host| host.a11y_action(request)).is_some()
+}
+
+#[expect(missing_docs)]
+pub fn raw_key(key: RawKey) {
+    if let Some(host) = host() {
+        host.raw_key(key);
+    }
+}
+
+pub(crate) fn input(window: WindowId, input: &PlatformInput) -> Option<DispatchEventResult> {
+    host()?.input(window, input)
+}
+
+pub(crate) fn before_frame(window: WindowId) {
+    if let Some(host) = host() {
+        host.before_frame(window);
+    }
+}
+
+#[expect(missing_docs)]
+pub fn defer_frame(window: WindowId, frame: Box<dyn FnOnce()>) {
+    match host() {
+        Some(host) => host.defer_frame(window, frame),
+        None => frame(),
+    }
+}
+
+#[expect(missing_docs)]
+pub fn paints_pixels() -> bool {
+    host().is_some_and(|host| host.paints_pixels())
+}
+
+#[expect(missing_docs)]
+pub fn has_time_to_paint() -> bool {
+    host().is_some_and(|host| host.has_time_to_paint())
+}
+
+#[expect(missing_docs)]
+pub fn painter(window: WindowId) -> Option<Painter> {
+    host()?.painter(window)
+}
+
+#[expect(missing_docs)]
+#[cfg(target_os = "macos")]
+pub fn present(window: WindowId, layer: *mut std::ffi::c_void) {
+    if let Some(host) = host() {
+        host.present(window, layer);
+    }
+}
+
+#[expect(missing_docs)]
+#[cfg(target_os = "macos")]
+pub fn before_resized_frame(window: WindowId) {
+    if let Some(host) = host() {
+        host.before_resized_frame(window);
+    }
+}
+
+#[expect(missing_docs)]
+#[cfg(target_os = "macos")]
+pub fn accepts_first_mouse(window: WindowId, position: crate::Point<crate::Pixels>) -> bool {
+    host().is_none_or(|host| host.accepts_first_mouse(window, position))
+}
