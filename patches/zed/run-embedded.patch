+use std::os::fd::{AsFd, BorrowedFd, FromRawFd as _, OwnedFd};
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use gpui::{DevicePixels, Size, embed};
+
+/// What the host paints a window into where there is no GPU, and the display server reads.
+pub(crate) struct SharedPixels {
+    id: u64,
+    fd: OwnedFd,
+    data: *mut [u8; 4],
+    pub(crate) size: Size<DevicePixels>,
+}
+
+impl SharedPixels {
+    pub(crate) fn new(size: Size<DevicePixels>) -> std::io::Result<Self> {
+        static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+        let bytes = size.width.0.max(1) as usize * size.height.0.max(1) as usize * 4;
+        // SAFETY: the descriptor is new, and the kernel chooses the address.
+        unsafe {
+            let fd = libc::memfd_create(c"pixels".as_ptr(), libc::MFD_CLOEXEC);
+            if fd < 0 {
+                return Err(std::io::Error::last_os_error());
+            }
+            let owned = OwnedFd::from_raw_fd(fd);
+            if libc::ftruncate(fd, bytes as libc::off_t) < 0 {
+                return Err(std::io::Error::last_os_error());
+            }
+            let protection = libc::PROT_READ | libc::PROT_WRITE;
+            let data = libc::mmap(
+                std::ptr::null_mut(),
+                bytes,
+                protection,
+                libc::MAP_SHARED,
+                fd,
+                0,
+            );
+            if data == libc::MAP_FAILED {
+                return Err(std::io::Error::last_os_error());
+            }
+            Ok(Self {
+                id: NEXT_ID.fetch_add(1, Ordering::Relaxed),
+                fd: owned,
+                data: data.cast(),
+                size,
+            })
+        }
+    }
+
+    fn len(&self) -> usize {
+        self.size.width.0.max(1) as usize * self.size.height.0.max(1) as usize
+    }
+
+    pub(crate) fn fd(&self) -> BorrowedFd<'_> {
+        self.fd.as_fd()
+    }
+
+    pub(crate) fn data(&self) -> &[[u8; 4]] {
+        // SAFETY: the mapping has this length, and the server only reads it.
+        unsafe { std::slice::from_raw_parts(self.data, self.len()) }
+    }
+
+    pub(crate) fn paint(
+        &mut self,
+        painter: embed::Painter,
+        shown: Size<DevicePixels>,
+        platform_moves: bool,
+    ) -> embed::Painted {
+        // SAFETY: as in `data`.
+        let data = unsafe { std::slice::from_raw_parts_mut(self.data, self.len()) };
+        let (id, width) = (self.id, self.size.width.0.max(1) as usize);
+        painter(embed::Pixels {
+            id,
+            data,
+            width,
+            shown,
+            platform_moves,
+        })
+    }
+}
+
+impl Drop for SharedPixels {
+    fn drop(&mut self) {
+        // SAFETY: nothing borrows the mapping.
+        unsafe { libc::munmap(self.data.cast(), self.len() * 4) };
+    }
+}
