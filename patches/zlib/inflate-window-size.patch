Check the window size of a zlib header before storing it.

zlib-ng/zlib-ng@1bfa59ae1. Remove when the pinned source has it.

--- a/inflate.c
+++ b/inflate.c
@@ -537,12 +537,13 @@ int32_t Z_EXPORT PREFIX(inflate)(PREFIX3(stream) *strm, int32_t flush) {
             }
             DROPBITS(4);
             len = BITS(4) + 8;
-            if (state->wbits == 0)
-                state->wbits = len;
-            if (len > MAX_WBITS || len > state->wbits) {
+            /* Reject before storing, so a bad CINFO cannot stick in wbits. */
+            if (len > MAX_WBITS || (state->wbits != 0 && len > state->wbits)) {
                 SET_BAD("invalid window size");
                 break;
             }
+            if (state->wbits == 0)
+                state->wbits = len;
 #ifdef INFLATE_STRICT
             state->dmax = 1U << len;
 #endif
