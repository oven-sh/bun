Set the bytes after the decoded literals to zero.

A failed Huffman decode now returns before the literals are shifted rather than
after.

Remove when the pinned zstd source does the same.

--- a/lib/decompress/zstd_decompress_block.c
+++ b/lib/decompress/zstd_decompress_block.c
@@ -123,6 +123,26 @@
     }
 }
 
+/* Bun: sets the WILDCOPY_OVERLENGTH bytes after the literals to zero.
+ * ZSTD_allocateLiteralsBuffer() leaves that room after them, once split literals are shifted.
+ * Skips a NULL dst, which has no literals.
+ * Stops at block, the compressed input, if that overlaps dst.
+ */
+static void ZSTD_finishLiterals(ZSTD_DCtx* dctx, const void* dst, const BYTE* block)
+{
+    if (dctx->litBufferLocation == ZSTD_split)
+        ZSTD_memset(dctx->litExtraBuffer + ZSTD_LITBUFFEREXTRASIZE, 0, WILDCOPY_OVERLENGTH);
+    if (dst == NULL && dctx->litBufferLocation != ZSTD_not_in_dst)
+        return;
+    {   BYTE* const room = dctx->litBuffer + (dctx->litBufferEnd - dctx->litBuffer);
+        size_t length = WILDCOPY_OVERLENGTH;
+        if (dctx->litBufferLocation != ZSTD_not_in_dst
+            && block >= (const BYTE*)dst && block < room + WILDCOPY_OVERLENGTH)
+            length = block > room ? (size_t)(block - room) : 0;
+        ZSTD_memset(room, 0, length);
+    }
+}
