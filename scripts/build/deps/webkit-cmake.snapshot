    "${_cc_sanitize}=undefined" "$<$<NOT:$<COMPILE_LANGUAGE:Swift>>:-fno-sanitize=vptr>"
)

# in if(COMPILER_IS_GCC_OR_CLANG)
# in if(ENABLE_SANITIZERS)
