# in elseif(${SANITIZER} MATCHES "undefined") # if(${SANITIZER} MATCHES "address")
add_link_options("${_ld_sanitize}=undefined")

# in if(COMPILER_IS_GCC_OR_CLANG)
# in if(ENABLE_SANITIZERS)
# in foreach(SANITIZER ${ENABLE_SANITIZERS})
# in elseif(${SANITIZER} MATCHES "thread" AND NOT MSVC) # if(${SANITIZER} MATCHES "address")
add_compile_options("${_cc_sanitize}=thread")

# in if(COMPILER_IS_GCC_OR_CLANG)
# in if(ENABLE_SANITIZERS)
# in foreach(SANITIZER ${ENABLE_SANITIZERS})
# in elseif(${SANITIZER} MATCHES "thread" AND NOT MSVC) # if(${SANITIZER} MATCHES "address")
add_link_options("${_ld_sanitize}=thread")

# in if(COMPILER_IS_GCC_OR_CLANG)
# in if(ENABLE_SANITIZERS)
# in foreach(SANITIZER ${ENABLE_SANITIZERS})
# in elseif(${SANITIZER} MATCHES "memory" AND COMPILER_IS_CLANG AND NOT MSVC) # if(${SANITIZER} MATCHES "address")
add_compile_options("${_cc_sanitize}=memory")

# in if(COMPILER_IS_GCC_OR_CLANG)
# in if(ENABLE_SANITIZERS)
# in foreach(SANITIZER ${ENABLE_SANITIZERS})
# in elseif(${SANITIZER} MATCHES "memory" AND COMPILER_IS_CLANG AND NOT MSVC) # if(${SANITIZER} MATCHES "address")
add_link_options("${_ld_sanitize}=memory")

# in if(COMPILER_IS_GCC_OR_CLANG)
# in if(ENABLE_SANITIZERS)
# in foreach(SANITIZER ${ENABLE_SANITIZERS})
# in elseif(${SANITIZER} MATCHES "leak" AND NOT MSVC) # if(${SANITIZER} MATCHES "address")
add_compile_options("${_cc_sanitize}=leak")

# in if(COMPILER_IS_GCC_OR_CLANG)
# in if(ENABLE_SANITIZERS)
# in foreach(SANITIZER ${ENABLE_SANITIZERS})
# in elseif(${SANITIZER} MATCHES "leak" AND NOT MSVC) # if(${SANITIZER} MATCHES "address")
add_link_options("${_ld_sanitize}=leak")

# in if(COMPILER_IS_GCC_OR_CLANG)
# in if(ENABLE_SANITIZERS)
unset(_ld_sanitize)

# in if(COMPILER_IS_GCC_OR_CLANG)
# in if(ENABLE_SANITIZERS)
unset(_cc_sanitize)

# in if(UNIX AND NOT APPLE AND NOT ENABLED_COMPILER_SANITIZERS)
add_link_options(
    "$<$<OR:$<STREQUAL:$<TARGET_PROPERTY:TYPE>,SHARED_LIBRARY>,$<STREQUAL:$<TARGET_PROPERTY:TYPE>,MODULE_LIBRARY>>:LINKER:--no-undefined>"
)

# in if(CMAKE_CXX_COMPILER_ID MATCHES "GNU" AND WTF_CPU_MIPS)
webkit_prepend_global_compiler_flags(-mno-lxc1-sxc1)

