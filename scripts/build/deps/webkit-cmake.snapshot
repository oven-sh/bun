    OUTPUT ${_output}
    MAIN_DEPENDENCY ${_generator}
    DEPENDS ${_input} ${_additional_deps}
    COMMAND ${PYTHON_EXECUTABLE} ${_generator} ${_input} ${_output}
    VERBATIM
)

