{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Builtins are bundled into the binary and never emit declarations, so the base config's `composite`
    // (which turns on declaration-emit checks for every export) does not apply here.
    "composite": false,
    "esModuleInterop": true,
    // baseUrl needed until resolver fix propagates to system Bun used during build
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "types": [],
    "paths": {
      "internal/*": ["./internal/*"] //deprecated
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "./builtins.d.ts",
    "./private.d.ts",
    "../../packages/bun-types/index.d.ts"
  ]
}
