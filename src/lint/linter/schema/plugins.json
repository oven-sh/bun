            "type": ["boolean"]
          },
          "includeTypes": {
            "type": ["boolean"]
          }
        },
        "additionalProperties": false
      }
    ]
  },
  "import/no-internal-modules": {
    "schema": [
      {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "allow": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "forbid": {
                "type": "array",
