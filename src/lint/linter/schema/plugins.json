        "enum": ["absolute-first", "disable-absolute-first"]
      }
    ]
  },
  "import/no-extraneous-dependencies": {
    "schema": [
      {
        "type": "object",
        "properties": {
          "devDependencies": {
            "type": ["boolean", "array"]
          },
          "optionalDependencies": {
            "type": ["boolean", "array"]
          },
          "peerDependencies": {
            "type": ["boolean", "array"]
          },
          "bundledDependencies": {
            "type": ["boolean", "array"]
          },
          "packageDir": {
            "type": ["string", "array"]
          },
