                }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    ]
  },
  "import/no-unused-modules": {
    "schema": [
      {
        "properties": {
          "src": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ignoreExports": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "missingExports": {
            "type": "boolean"
          },
          "unusedExports": {
            "type": "boolean"
          },
          "ignoreUnusedTypeExports": {
            "type": "boolean"
          }
        },
        "anyOf": [
          {
            "properties": {
              "unusedExports": {
                "enum": [true]
              },
              "src": {
                "minItems": 1
              }
            },
            "required": ["unusedExports"]
          },
          {
            "properties": {
              "missingExports": {
                "enum": [true]
              }
            },
            "required": ["missingExports"]
          }
        ]
      }
    ]
  },
