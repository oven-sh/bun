//// type-identity/cycle-in-two-files-of-one-task-other.ts
// Two object types that are each other's type argument, imported by cycle-in-two-files-of-one-task.ts.
export interface A<T> { v: T }
export interface B<T> { w: T }
export type First = A<Second>;
export type Second = B<First>;
let first: First;
let second: Second;
//// type-identity/cycle-in-two-files-of-one-task.queries.txt
# The identity of a member of a cycle of types does not depend on which member a file asks about first, nor on what the checker has answered in an earlier file. One checker visits the two short files one after the other, because the long file makes them a small part of the program.
same: cycle-in-two-files-of-one-task.ts:6 identity `First` <=> cycle-in-two-files-of-one-task-other.ts:6 identity `First`
same: cycle-in-two-files-of-one-task.ts:5 identity `Second` <=> cycle-in-two-files-of-one-task-other.ts:7 identity `Second`
different: cycle-in-two-files-of-one-task.ts:6 identity `First` <=> cycle-in-two-files-of-one-task.ts:5 identity `Second`
//// type-identity/cycle-in-two-files-of-one-task.ts
// The identity of a member of a cycle of types does not depend on which member a file asks about first, nor on what the checker has answered in an earlier file. One checker visits the two short files one after the other, because the long file makes them a small part of the program.
import "./cycle-in-two-files-of-one-task-long";
import "./cycle-in-two-files-of-one-task-other";
import type { First, Second } from "./cycle-in-two-files-of-one-task-other";
let second: Second;
let first: First;
export {};
//// type-identity/declaration-order.queries.txt
# A type literal is a declaration with one order of members. Two type literals have two identities, whether they list the same members in another order or in the same one.
ordered: declaration-order.ts:3 has `{ b: string; a: number }` = b Field string checked string
ordered: declaration-order.ts:3 has `{ b: string; a: number }` = a Field number checked number
different: declaration-order.ts:2 identity `{ a: number; b: string }` <=> declaration-order.ts:3 identity `{ b: string; a: number }`
different: declaration-order.ts:2 identity `{ a: number; b: string }` <=> declaration-order.ts:4 identity `{ a: number; b: string }`
different: declaration-order.ts:5 identity `{ p: { a: number; b: string } }` <=> declaration-order.ts:6 identity `{ p: { b: string; a: number } }`
//// type-identity/declaration-order.ts
// A type literal is a declaration with one order of members. Two type literals have two identities, whether they list the same members in another order or in the same one.
let v1: { a: number; b: string };
let v2: { b: string; a: number };
let v3: { a: number; b: string };
let v4: { p: { a: number; b: string } };
let v5: { p: { b: string; a: number } };
export {};
//// type-identity/dense-cycle-of-tuple-aliases.queries.txt
# A cycle of types is described as one component, in time that does not grow with the number of paths through it. The identity of a member does not depend on where the walk enters the cycle, and members that are alike have one identity.
same: dense-cycle-of-tuple-aliases.ts:19 identity `T3` <=> dense-cycle-of-tuple-aliases.ts:20 identity `T3`
same: dense-cycle-of-tuple-aliases.ts:19 identity `T3` <=> dense-cycle-of-tuple-aliases.ts:21 identity `T9`
different: dense-cycle-of-tuple-aliases.ts:22 identity `U0` <=> dense-cycle-of-tuple-aliases.ts:23 identity `U1`
//// type-identity/dense-cycle-of-tuple-aliases.ts
// A cycle of types is described as one component, in time that does not grow with the number of paths through it. The identity of a member does not depend on where the walk enters the cycle, and members that are alike have one identity.
type T0 = [T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, T11, T12, T13];
type T1 = [T0, T2, T3, T4, T5, T6, T7, T8, T9, T10, T11, T12, T13];
type T2 = [T0, T1, T3, T4, T5, T6, T7, T8, T9, T10, T11, T12, T13];
type T3 = [T0, T1, T2, T4, T5, T6, T7, T8, T9, T10, T11, T12, T13];
type T4 = [T0, T1, T2, T3, T5, T6, T7, T8, T9, T10, T11, T12, T13];
type T5 = [T0, T1, T2, T3, T4, T6, T7, T8, T9, T10, T11, T12, T13];
type T6 = [T0, T1, T2, T3, T4, T5, T7, T8, T9, T10, T11, T12, T13];
type T7 = [T0, T1, T2, T3, T4, T5, T6, T8, T9, T10, T11, T12, T13];
type T8 = [T0, T1, T2, T3, T4, T5, T6, T7, T9, T10, T11, T12, T13];
type T9 = [T0, T1, T2, T3, T4, T5, T6, T7, T8, T10, T11, T12, T13];
type T10 = [T0, T1, T2, T3, T4, T5, T6, T7, T8, T9, T11, T12, T13];
type T11 = [T0, T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, T12, T13];
type T12 = [T0, T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, T11, T13];
type T13 = [T0, T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, T11, T12];
type U0 = [U1, number];
type U1 = [U0, string];
interface Box<T> { value: T }
let top: T3;
let argument: Box<T3>;
let alike: T9;
let first: U0;
let second: U1;
export {};
//// type-identity/function-types.queries.txt
# The compiler knows a function type by the declaration of its signature. Two that are written alike are two types, and so are the tuples that hold them. One declaration has one identity wherever it is named.
different: function-types.ts:3 identity `() => number` <=> function-types.ts:4 identity `() => number`
different: function-types.ts:3 identity `() => number` <=> function-types.ts:5 identity `F`
different: function-types.ts:7 identity `[F]` <=> function-types.ts:9 identity `[() => number]`

same: function-types.ts:5 identity `F` <=> function-types.ts:6 identity `F`
same: function-types.ts:5 identity `F` <=> function-types.ts:2 identity `() => number`
same: function-types.ts:7 identity `[F]` <=> function-types.ts:8 identity `[F]`
//// type-identity/function-types.ts
// The compiler knows a function type by the declaration of its signature. Two that are written alike are two types, and so are the tuples that hold them. One declaration has one identity wherever it is named.
type F = () => number;
let v1: () => number;
let v2: () => number;
let v3: F;
let v4: F;
let v5: [F];
let v6: [F];
let v7: [() => number];
export {};
//// type-identity/generic-instantiations.queries.txt
# An instantiated generic interface is identified by the interface and its type arguments, not by its structure.
same: generic-instantiations.ts:3 identity `Pair<number>` <=> generic-instantiations.ts:5 identity `Pair<number>`
different: generic-instantiations.ts:5 identity `Pair<number>` <=> generic-instantiations.ts:6 identity `Pair<string>`
different: generic-instantiations.ts:3 identity `Pair<number>` <=> generic-instantiations.ts:4 identity `{ first: number; second: number }`
//// type-identity/generic-instantiations.ts
// An instantiated generic interface is identified by the interface and its type arguments, not by its structure.
interface Pair<T> { first: T; second: T }
let v1: Pair<number>;
let v2: { first: number; second: number };
let v3: Pair<number>;
let v4: Pair<string>;
export {};
//// type-identity/generic-type-literal-instantiations.queries.txt
# The instantiations of one generic type literal are told apart by their type arguments: equal arguments are one identity wherever they are written.
same: generic-type-literal-instantiations.ts:4 identity `Box<number>` <=> generic-type-literal-instantiations.ts:5 identity `Box<number>`
different: generic-type-literal-instantiations.ts:4 identity `Box<number>` <=> generic-type-literal-instantiations.ts:6 identity `Box<string>`
different: generic-type-literal-instantiations.ts:7 identity `Pair<number, string>` <=> generic-type-literal-instantiations.ts:8 identity `Pair<string, number>`
same: generic-type-literal-instantiations.ts:9 identity `Box<Box<number>>` <=> generic-type-literal-instantiations.ts:10 identity `Box<Box<number>>`
different: generic-type-literal-instantiations.ts:4 identity `Box<number>` <=> generic-type-literal-instantiations.ts:9 identity `Box<Box<number>>`
different: generic-type-literal-instantiations.ts:4 identity `Box<number>` <=> generic-type-literal-instantiations.ts:2 identity `{ value: T }`
//// type-identity/generic-type-literal-instantiations.ts
// The instantiations of one generic type literal are told apart by their type arguments: equal arguments are one identity wherever they are written.
type Box<T> = { value: T };
type Pair<A, B> = { first: A; second: B };
let v1: Box<number>;
let v2: Box<number>;
let v3: Box<string>;
let v4: Pair<number, string>;
let v5: Pair<string, number>;
let v6: Box<Box<number>>;
let v7: Box<Box<number>>;
export {};
//// type-identity/identity-with-member-that-gave-up.queries.txt
# A member whose type does not resolve gives up by itself and takes the identity from no type that has it: neither from a type literal, which is identified by where it is written, nor from a computed type, which is identified by its members.
identity-with-member-that-gave-up.ts:7 origin `{ bad: Missing; good: number }` = type literal identity-with-member-that-gave-up.ts:7
identity-with-member-that-gave-up.ts:7 has `{ bad: Missing; good: number }` = bad Field gave up: ErrorType checked gave up: ErrorType
identity-with-member-that-gave-up.ts:8 origin `typeof spread` = computed
identity-with-member-that-gave-up.ts:8 has `typeof spread` = bad Field gave up: ErrorType checked gave up: ErrorType
different: identity-with-member-that-gave-up.ts:7 identity `{ bad: Missing; good: number }` <=> identity-with-member-that-gave-up.ts:8 identity `typeof spread`
different: identity-with-member-that-gave-up.ts:8 identity `typeof spread` <=> identity-with-member-that-gave-up.ts:9 identity `typeof sound`
same: identity-with-member-that-gave-up.ts:8 identity `typeof spread` <=> identity-with-member-that-gave-up.ts:10 identity `typeof spread`
//// type-identity/identity-with-member-that-gave-up.ts
// A member whose type does not resolve gives up by itself and takes the identity from no type that has it: neither from a type literal, which is identified by where it is written, nor from a computed type, which is identified by its members.
import type { Missing } from "./no-such-file";
declare const bad: { skipped: boolean; bad: Missing; good: number };
declare const good: { skipped: boolean; good: number };
const { skipped: s1, ...spread } = bad;
const { skipped: s2, ...sound } = good;
let v1: { bad: Missing; good: number };
let v2: typeof spread;
let v3: typeof sound;
let v4: typeof spread;
//// type-identity/intersection-order.queries.txt
# An intersection is identified by its parts in the order in which they are written: `A & B` and `B & A` are two identities, and `A & B` written twice is one.
intersection-order.ts:4 origin `A & B` = computed
different: intersection-order.ts:4 identity `A & B` <=> intersection-order.ts:5 identity `B & A`
