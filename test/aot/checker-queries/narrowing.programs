//// type-shape/intersections.queries.txt
# A primitive wins an intersection, `void` as `undefined`: a brand is a phantom that no value has. Object parts merge. A type parameter makes it a type variable whose constraint is the other parts. A union among several object parts makes it a type variable without a constraint.
intersections.ts:2 shape `string & { __brand: "id" }` = String
intersections.ts:3 shape `{ a: number } & { b: string }` = Object
intersections.ts:4 shape `(() => void) & { x: number }` = Function(1)
intersections.ts:5 shape `string & number` = Never
intersections.ts:6 shape `T & {}` = TypeVariable({})
intersections.ts:9 shape `NoInfer<string | A> & B` = TypeVariable(none)
intersections.ts:10 shape `void & { __brand: void }` = Undefined
intersections.ts:11 shape `number & { __tag: "id" }` = Number
intersections.ts:12 shape `"a" & { __brand: 1 }` = StringLiteral("a")
intersections.ts:13 shape `symbol & { __brand: 1 } & { __other: 2 }` = Symbol
