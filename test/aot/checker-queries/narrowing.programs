//// undefined-property/main.queries.txt
# The `error?: undefined` that `{ data: 1 }` gets beside `{ error: e }` is declared by that union, not by the first file of the same checker that used the name. heavy.ts makes a task hold more than one of the small files.
untyped.js:1 returns `make` = { data: number; error?: undefined; } | { data?: undefined; error: any; }
different: main.ts:4 identity `first(true)` <=> main.ts:5 identity `make(true, "e")`
same: untyped.js:2 identity `make(true, 1)` <=> main.ts:5 identity `make(true, "e")`
//// undefined-property/main.ts
import { total } from "./heavy.ts";
import { first } from "./first.ts";
import { make } from "./untyped.js";
export const typed = first(true);
export const untyped = make(true, "e");
export const sum = total;
//// undefined-property/untyped.js
export function make(c, e) { return c ? { data: 1 } : { error: e }; }
export const made = make(true, 1);
//// written-type/alias-from-declaration-file-keeps-program-types.queries.txt
# A generic alias of a `.d.ts` is a function over types. The program's type that it is applied to stays written, as under the same alias declared here. Only what the `.d.ts` adds is unwritten.
alias-from-declaration-file-keeps-program-types.ts:5 shape `Maybe<Point>` = Union(undefined | Point)
alias-from-declaration-file-keeps-program-types.ts:6 shape `Own<Point>` = Union(undefined | Point)
same: alias-from-declaration-file-keeps-program-types.ts:5 identity `Maybe<Point>` <=> alias-from-declaration-file-keeps-program-types.ts:6 identity `Own<Point>`
absent: alias-from-declaration-file-keeps-program-types.ts:5 written `Maybe<Point>` = unknown

alias-from-declaration-file-keeps-program-types.ts:7 shape `WithLabel<Point>` = Object
alias-from-declaration-file-keeps-program-types.ts:7 has `WithLabel<Point>` = x Field number checked number
alias-from-declaration-file-keeps-program-types.ts:7 has `WithLabel<Point>` = label Field unwritten checked string optional
//// written-type/alias-from-declaration-file-keeps-program-types.ts
// A generic alias of a `.d.ts` is a function over types. The program's type that it is applied to stays written, as under the same alias declared here. Only what the `.d.ts` adds is unwritten.
/// <reference path="./helper.d.ts" />
interface Point { x: number }
type Own<T> = T | undefined;
let a: Maybe<Point>;
let b: Own<Point>;
let c: WithLabel<Point>;
export {};
//// written-type/declaration-file-alias.d.ts
// Declarations nobody checked, for declaration-file-alias.ts.
type Port = number;
type Level = "high";
type Mode = "fast" | "slow";
type Pair = [number, string];
type Ports = number[];
type ByName = Map<string, number>;
type Later<T> = Promise<T>;
type Several<T> = T[];
type Options = { verbose: boolean };
interface Host { port: number; mode: Mode }
declare const hostPort: number;
//// written-type/declaration-file-alias.queries.txt
# A type that only a `.d.ts` declares is never tested: where the type cannot show who declared it, the written type is `unknown`. What the checked file writes around it stays.
declaration-file-alias.ts:7 written `Port` = unknown
declaration-file-alias.ts:7 variable `a` = unknown
declaration-file-alias.ts:8 written `Local` = unknown
declaration-file-alias.ts:9 written `Level` = unknown
declaration-file-alias.ts:10 written `Port | undefined` = unknown
declaration-file-alias.ts:11 written `Port[]` = unknown[]
declaration-file-alias.ts:11 shape `Port[]` = Array(unknown)
declaration-file-alias.ts:12 written `Map<string, Port>` = Map<string, unknown>
declaration-file-alias.ts:13 written `Mode` = unknown
declaration-file-alias.ts:13 shape `Mode` = Anything(Unknown)
declaration-file-alias.ts:14 written `Mode | undefined` = unknown
declaration-file-alias.ts:15 written `Mode[]` = unknown[]
declaration-file-alias.ts:15 shape `Mode[]` = Array(unknown)
declaration-file-alias.ts:16 written `Pair` = unknown
declaration-file-alias.ts:16 shape `Pair` = Anything(Unknown)
declaration-file-alias.ts:17 written `Host["port"]` = unknown
declaration-file-alias.ts:18 written `keyof Host` = unknown
declaration-file-alias.ts:19 written `typeof hostPort` = unknown
declaration-file-alias.ts:20 written `Field<Host>` = unknown
declaration-file-alias.ts:25 written `typeof mode` = unknown
declaration-file-alias.ts:25 shape `typeof mode` = Anything(Unknown)
declaration-file-alias.ts:25 variable `held` = unknown

# That the value is an array, a Map or a Promise is the word of the `.d.ts` too, also around a type of the program.
declaration-file-alias.ts:26 written `Ports` = unknown
declaration-file-alias.ts:26 shape `Ports` = Anything(Unknown)
declaration-file-alias.ts:27 written `ByName` = unknown
declaration-file-alias.ts:28 written `Later<Mine>` = unknown
declaration-file-alias.ts:29 written `Several<Mine>` = unknown
declaration-file-alias.ts:30 written `Ports[]` = unknown[]

# An object type shows who declared it, so it keeps its name and its shape says that it is not trusted.
declaration-file-alias.ts:21 shape `Options[]` = Array(Options)
declaration-file-alias.ts:21 shape `Options` = Object untrusted
declaration-file-alias.ts:22 written `Host` = Host
declaration-file-alias.ts:22 shape `Host` = Object untrusted

# The same forms over the program's own types are written.
declaration-file-alias.ts:23 written `Own` = number
declaration-file-alias.ts:24 written `Field<Mine>` = number
//// written-type/declaration-file-alias.ts
// A type that only a `.d.ts` declares is never tested: where the type cannot show who declared it, the written type is `unknown`. What the checked file writes around it stays.
/// <reference path="./declaration-file-alias.d.ts" />
interface Mine { port: number }
type Own = number;
type Local = Port;
type Field<T extends { port: unknown }> = T["port"];
let a: Port;
let b: Local;
let c: Level;
let d: Port | undefined;
let e: Port[];
let f: Map<string, Port>;
let g: Mode;
let h: Mode | undefined;
let i: Mode[];
let j: Pair;
let k: Host["port"];
let l: keyof Host;
let m: typeof hostPort;
let n: Field<Host>;
let o: Options[];
let p: Host;
let q: Own;
let r: Field<Mine>;
function s(mode?: Mode) { let held: typeof mode; }
let t: Ports;
let u: ByName;
let v: Later<Mine>;
let w: Several<Mine>;
let x: Ports[];
export {};
//// written-type/enum-access-again.ts
// Passes on what enum-access-other.ts exports.
export * from "./enum-access-other";
