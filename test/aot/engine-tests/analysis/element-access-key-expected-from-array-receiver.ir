# CHECK-NEXT: F2 v2 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Double integralKey tests=[key]
function f3 name="keys-that-are-no-index" parameters=[{type=Array<number>}, {type=string}, {type=symbol}, {type=number|string}, {type=undefined|number}, {type=string flags=[IsExpected]}] results=[{type=anything}] {
