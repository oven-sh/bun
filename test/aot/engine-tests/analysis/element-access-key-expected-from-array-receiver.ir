function f1 name="typed-array" parameters=[{type=Uint8Array}, {type=Buffer}, {type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: Uint8Array, v1: Buffer, v2: anything, v3: number):
    v4 = ElemGet v0, v2
    ElemSet v0, v2, v3
    v6 = ElemGet v1, v2
    v7 = ElemHas v0, v2
    Return v4
}
