# A key of which nothing is known is expected to be an index where the receiver is proven to be an array or a typed array
# FORM: Prepared
# RUN: element-access

module m0 path="main.js" displayPath="main.js"

function f0 name="array" parameters=[{type=Array<number>}, {type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: Array<number>, v1: anything, v2: number):
    v3 = ElemGet v0, v1
    ElemSet v0, v1, v2
    ElemDefine v0, v1, v2
    v6 = ElemHas v0, v1
    v7 = ElemDelete v0, v1
    Return v3
}
