function f4 name="receivers-that-say-nothing-of-the-key" parameters=[{type=Array<number> flags=[IsExpected]}, {type=Array<number>|Uint8Array}, {type=Map<number, number>}, {type=Arguments}, {type=string}, {type=anything}] results=[{type=anything}] {
