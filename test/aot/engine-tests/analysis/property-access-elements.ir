# CHECK-NOT: tests=
# CHECK: F2 v4 ElemSet: form=TypedArray level=Proven operation=PutTypedArrayElement class=[[uint8]] typedArray=TypeUint8
# CHECK-NOT: tests=
# CHECK: F2 v5 ElemGet: form=TypedArray level=Proven operation=GetTypedArrayElement class=[[uint8]] typedArray=TypeUint8 integralKey
# CHECK-NOT: tests=
function f3 name="typed-array-accesses-by-key-and-a-nullable-typed-array" parameters=[{type=Uint8Array}, {type=number}, {type=anything}, {type=bigint}, {type=string}, {type=undefined|Uint8Array}] results=[{type=anything}] {
  b0(v0: Uint8Array, v1: number, v2: anything, v3: bigint, v4: string, v5: undefined|Uint8Array):
