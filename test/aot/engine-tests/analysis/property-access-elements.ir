# The plan of an access under a computed key: a constant key is a name, a typed array needs no test, an array needs the tests its type does not prove
# FORM: Prepared
# RUN: element-access

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number}}]
layout L1 name="Named" fields=[{key="x" declared={type=number}}]

function f0 name="constant-keys" parameters=[{type=object}, {type="x"}, {type=@@iterator}, {type=number}] results=[{type=anything}] {
  b0(v0: object, v1: "x", v2: @@iterator, v3: number):
    v4 = ElemGet v0, v1
    ElemSet v0, v1, v3
    ElemDefine v0, v1, v3
    v7 = ElemHas v0, v1
    v8 = ElemDelete v0, v1
    v9 = ElemGet v0, v2
    Return v4
}
# CHECK: F0 v4 ElemGet: form=NamedKey level=Proven operation=PropGet
# CHECK-NEXT: F0 v5 ElemSet: form=NamedKey level=Proven operation=PropSet
# CHECK-NEXT: F0 v6 ElemDefine: form=NamedKey level=Proven operation=PropDefine
# CHECK-NEXT: F0 v7 ElemHas: form=NamedKey level=Proven operation=PropHas
# CHECK-NEXT: F0 v8 ElemDelete: form=NamedKey level=Proven operation=PropDelete
# CHECK-NEXT: F0 v9 ElemGet: form=NamedKey level=Proven operation=PropGet
function f1 name="keys-without-a-constant-name" parameters=[{type=object}, {type="0"}, {type="1.5"}, {type="x"|"y"}, {type=string}, {type=symbol}] results=[{type=anything}] {
  b0(v0: object, v1: "0", v2: "1.5", v3: "x"|"y", v4: string, v5: symbol):
    v6 = ElemGet v0, v1
    v7 = ElemGet v0, v2
    v8 = ElemGet v0, v3
    v9 = ElemGet v0, v4
    v10 = ElemGet v0, v5
    v11 = ElemDelete v0, v1
    Return v6
}
# CHECK-NEXT: F1 v6 ElemGet: form=ByKey level=Unknown
# CHECK-NEXT: F1 v7 ElemGet: form=ByKey level=Unknown
# CHECK-NEXT: F1 v8 ElemGet: form=ByKey level=Unknown
# CHECK-NEXT: F1 v9 ElemGet: form=ByKey level=Unknown
# CHECK-NEXT: F1 v10 ElemGet: form=ByKey level=Unknown
# CHECK-NEXT: F1 v11 ElemDelete: form=ByKey level=Unknown
function f2 name="typed-arrays" parameters=[{type=Uint8Array}, {type=number}, {type=int[0, 9]}] results=[{type=anything}] {
  b0(v0: Uint8Array, v1: number, v2: int[0, 9]):
    v3 = ElemGet v0, v1
    ElemSet v0, v1, v1
    v5 = ElemGet v0, v2
    Return v3
}
