# -- source: a-count-goes-up-once-in-front-of-each-read-of-a-list-that-ends-early.js
# function sum(state, list) { let total = 0; total += list[0]; state.count++; total += list[1]; state.count++; total += list[2]; state.count++; total += list[3]; total += list[4]; total += list[16]; total += list[17]; state.count++; total += list[18]; return total; }
# const state = { count: 0 };
# const plain = length => Array.from({ length }, (_, at) => at + 0.5);
# for (let length = 0; length < 20; length++) report(sum(state, plain(length)) + ":" + state.count);
# report("end");
# -- end of source
# Elements of a list of numbers are read one after the other and a count goes up between the reads: by four a call, also where the list ends early.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function sum(state, list) { let total = 0; total += list[0]; state.count++; total += list[1]; state.count++; total += list[2]; state.count++; total += list[3]; total += list[4]; total += list[16]; total += list[17]; state.count++; total += list[18]; return total; } const state = { count: 0 }; const plain = length => Array.from({ length }, (_, at) => at + 0.5); for (let length = 0; length < 20; length++) report(sum(state, plain(length)) + ":" + state.count); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 21 of 21 of 21
# CHECK-NEXT: exited with 0

