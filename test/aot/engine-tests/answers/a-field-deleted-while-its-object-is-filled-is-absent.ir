# function tell(label: string): void { let text = ""; for (let at = 0; at < said.length; at++) text += (at ? "," : "") + String(said[at]); report(label + " " + text);}
# function attempt(label: string, run: () => void): void { try { run();} catch (error) {} tell(label);}
# const seen: Thing[] = [];
# const later: (() => string)[] = [];
# function open(it: object): Record<string, unknown> { return it as Record<string, unknown>;}
# interface Thing { a: number; b: string; c: number }
# let underWay: Thing | undefined;
# function second(seed: number): string { const self = underWay; if (self) { delete open(new Proxy(self, {})).c;} return "b" + seed;}
# function ThingMaker(this: Thing, seed: number) { this.c = seed + 2; this.b = second(seed);}
# const Thing = ThingMaker as unknown as new (seed: number) => Thing;
# function again(one: Thing, seed: number): Thing { underWay = one; return one;}
# function left(): string { const text = seen.map(each => JSON.stringify(each) + Object.keys(each).join("+")).join("|") + "/" + later.map(each => each()).join("|"); return text;}
# function run(seed: number): void { for (let outer = 0; outer < 2; outer++) { const things: Thing[] = []; for (let at = 0; at < 3; at++) { try { things.push(again(new Thing(seed + outer + at), seed + outer + at + 5));} catch (error) {} } for (let inner = 0; inner < 3; inner++) { const one = things[(inner) % 3] ?? seen[0]; if (one) { say(one.a, one.b, one.c);} } say(left());} }
# attempt("one", () => run(1)); attempt("two", () => run(2));
# report("end");
# -- end of source
# A constructor function stores a field and calls a function that deletes a field of the object made before it, through a proxy: the field reads as undefined.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const said = []; function say(...seen) { for (let at = 0;at < seen.length; at++) said.push(seen[at]); } function tell(label) { let text = ""; for (let at = 0;at < said.length; at++) text += (at ? "," : "") + String(said[at]); report(label + " " + text); } function attempt(label, run) { try { run(); } catch (error) {} tell(label); } const seen = []; const later = []; function open(it) { return it; } let underWay; function second(seed) { const self = underWay; if (self) { delete open(new Proxy(self, {})).c; } return "b" + seed; } function ThingMaker(seed) { this.c = seed + 2; this.b = second(seed); } const Thing = ThingMaker; function again(one, seed) { underWay = one; return one; } function left() { const text = seen.map((each) => JSON.stringify(each) + Object.keys(each).join("+")).join("|") + "/" + later.map((each) => each()).join("|"); return text; } function run(seed) { for (let outer = 0;outer < 2; outer++) { const things = []; for (let at = 0;at < 3; at++) { try { things.push(again(new Thing(seed + outer + at), seed + outer + at + 5)); } catch (error) {} } for (let inner = 0;inner < 3; inner++) { const one = things[inner % 3] ?? seen[0]; if (one) { say(one.a, one.b, one.c); } } say(left()); } } attempt("one", () => run(1)); attempt("two", () => run(2)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
