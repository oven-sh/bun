# const kept = [];
# function* counts(from) { yield from; yield from + 1; yield from + 2; }
# function run(from, turns) { let said = ""; const steps = counts(from); let turn = 0; do { said += steps.next().value + ","; turn++; } while (turn < turns); kept.push(steps); return said; }
# report(run(10, 1)); report(run(20, 2)); report(run(30, 3)); report(kept[0].next().value);
# report("end");
# -- end of source
# One generator takes every step of a loop and is kept behind it: each step goes on where the one before stopped.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const kept = []; function* counts(from) { yield from; yield from + 1; yield from + 2; } function run(from, turns) { let said = ""; const steps = counts(from); let turn = 0; do { said += steps.next().value + ","; turn++; } while (turn < turns); kept.push(steps); return said; } report(run(10, 1)); report(run(20, 2)); report(run(30, 3)); report(kept[0].next().value); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 5 of 5 of 5
# CHECK-NEXT: exited with 0

