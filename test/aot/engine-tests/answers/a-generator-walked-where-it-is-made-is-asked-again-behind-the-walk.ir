# function* counts(from) { yield from; yield from + 1; return "end"; }
# function run(from) { const steps = counts(from); let sum = 0; for (const each of steps) sum += each; return sum + ":" + steps.next().done + ":" + steps.next().value; }
# function byHand(from) { const steps = counts(from); let said = ""; for (let step = steps.next(); !step.done; step = steps.next()) said += step.value + ","; return said + steps.next().done; }
# report(run(1)); report(byHand(5));
# report("end");
# -- end of source
# A generator that a loop has walked to its end is still an object: a step behind the loop says that it is done.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function* counts(from) { yield from; yield from + 1; return "end"; } function run(from) { const steps = counts(from); let sum = 0; for (const each of steps) sum += each; return sum + ":" + steps.next().done + ":" + steps.next().value; } function byHand(from) { const steps = counts(from); let said = ""; for (let step = steps.next(); !step.done; step = steps.next()) said += step.value + ","; return said + steps.next().done; } report(run(1)); report(byHand(5)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 3 of 3 of 3
# CHECK-NEXT: exited with 0

