# -- source: a-variable-of-the-function-above-is-read-anew-in-a-loop-that-has-it-stored.ts
# declare function report(value: unknown): void;
# const said: unknown[] = [];
# function say(...seen: unknown[]): void { for (let at = 0; at < seen.length; at++) said.push(seen[at]);}
# function tell(label: string): void { let text = ""; for (let at = 0; at < said.length; at++) text += (at ? "," : "") + String(said[at]); report(label + " " + text);}
# function attempt(label: string, run: () => void): void { try { run();} catch (error) {} tell(label);}
# async function attemptLater(label: string, run: () => Promise<void>): Promise<void> { try {} catch (error) {} tell(label);}
# function run(seed: number): void { let held: { value: number } = { value: seed }; function poke(by: number): void { held = { value: held.value + by + 1 };} const work = (turn: number): void => { let seen = ""; let at = 0; do { seen += "," + held.value; if (at === 1) poke(at);} while (++at < 4); say(seen);}; const step = (turn: number): void => { work(turn);}; step(1); step(2);}
# attempt("one", () => run(1)); attempt("two", () => run(2));
# report("end");
# -- end of source
# A loop in a closure reads a variable of the function above, and on one turn calls a function that stores to it: the next turn reads the new object.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const said = []; function say(...seen) { for (let at = 0;at < seen.length; at++) said.push(seen[at]); } function tell(label) { let text = ""; for (let at = 0;at < said.length; at++) text += (at ? "," : "") + String(said[at]); report(label + " " + text); } function attempt(label, run) { try { run(); } catch (error) {} tell(label); } async function attemptLater(label, run) { try {} catch (error) {} tell(label); } function run(seed) { let held = { value: seed }; function poke(by) { held = { value: held.value + by + 1 }; } const work = (turn) => { let seen = ""; let at = 0; do { seen += "," + held.value; if (at === 1) poke(at); } while (++at < 4); say(seen); }; const step = (turn) => { work(turn); }; step(1); step(2); } attempt("one", () => run(1)); attempt("two", () => run(2)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 3 of 3 of 3
# CHECK-NEXT: exited with 0

