# The first generator of a program is made in a realm that has forgotten its Structures: the stand-in for prototypes is of the Structure that compiled code compares with.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function make() { class B extends Array {} const D = new Proxy(B, {}); return new D(); } make(); class V2 {} class V3 extends V2 {} Object.defineProperty(V3.prototype, "0", {}); function lay() { Object.defineProperty(V2.prototype, "0", {}); } lay(); function* count() { yield 1; yield 2; } const list = [function* () {}(), count()]; for (let i = 0; i < list.length; i++) try { list[i][0][1].length; } catch (e) { report("caught"); } for (let i = 0; i < list.length; i++) { const step = list[i].next(); report(step.value + " " + step.done); } report(Object.getPrototypeOf(list[1]) === count.prototype); report(list[1] instanceof count); report(Object.getPrototypeOf(list[0]) === count.prototype); report(list[1].next().value); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
