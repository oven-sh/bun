# The first of two objects of a constructor function keeps the prototype that the function had when the object was made, though the function gets another between the two.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function launderZero() { return 0; } function launderKey(key) { return [key, "other"][launderZero()]; } function Q() {} const first = Q.prototype; first.describe = function () { return "first"; }; const second = { describe() { return "second"; }, other: "second" }; function warm(a) { const w = new Q(); return JSON.stringify(w) + Object.keys(w).length; } warm(9); function run(a) { const q = new Q(); Reflect.defineProperty(Q, "prototype", { value: second }); const x = 1; q[launderKey("b")] = x; const r = new Q(); Reflect.defineProperty(Q, "prototype", { value: first }); const y = 1; r.b = y; return String(q.describe() + " " + q.a) + " " + String(r.describe() + " " + r.a) + " " + ("other" in q) + " " + ("other" in r); } for (let turn = 0; turn < 3; turn++) report(run(turn)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 4 of 4 of 4
# CHECK-NEXT: exited with 0

