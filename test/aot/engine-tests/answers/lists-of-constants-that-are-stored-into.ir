# function fresh() { return [1, 2, 3]; }
# function storedInto(at, value) { const list = fresh(); list[at] = value; return list.join() + ":" + list.length + ":" + fresh().join(); }
# function grown(value) { const list = [1.5, 2.5]; list.push(value); return list.join() + ":" + [1.5, 2.5].length; }
# function cut() { const list = ["a", "b", "c"]; list.length = 1; return list.join() + ":" + ["a", "b", "c"].join(); }
# function reversedInALoop(turns) { let said = ""; for (let turn = 0; turn < turns; turn++) { const list = [1, 2, 3]; if (turn % 2) list.reverse(); said += list[0]; } return said; }
# function shared() { const first = fresh(), second = fresh(); first[0] = 9; return first[0] + ":" + second[0] + ":" + (first === second); }
# function nested() { const table = [[1, 2], [3, 4]]; table[0][1] = 9; return table.join("|") + ":" + [[1, 2], [3, 4]].join("|"); }
# function frozen() { "use strict"; const list = Object.freeze([1, 2]); try { list[0] = 5; } catch (error) { return error.name + ":" + list.join(); } return list.join(); }
# report(storedInto(0, 9)); report(storedInto(5, 9)); report(storedInto(1, "x")); report(storedInto(1, 0.5)); report(storedInto(-1, 7)); report(grown(3)); report(grown("z")); report(cut()); report(reversedInALoop(4)); report(shared()); report(nested()); report(frozen());
# report("end");
# -- end of source
# A list literal of constants is a new list each time it is evaluated: one is stored into, grown, cut, reversed and frozen, and the next evaluation gives the constants again.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function fresh() { return [1, 2, 3]; } function storedInto(at, value) { const list = fresh(); list[at] = value; return list.join() + ":" + list.length + ":" + fresh().join(); } function grown(value) { const list = [1.5, 2.5]; list.push(value); return list.join() + ":" + [1.5, 2.5].length; } function cut() { const list = ["a", "b", "c"]; list.length = 1; return list.join() + ":" + ["a", "b", "c"].join(); } function reversedInALoop(turns) { let said = ""; for (let turn = 0; turn < turns; turn++) { const list = [1, 2, 3]; if (turn % 2) list.reverse(); said += list[0]; } return said; } function shared() { const first = fresh(), second = fresh(); first[0] = 9; return first[0] + ":" + second[0] + ":" + (first === second); } function nested() { const table = [[1, 2], [3, 4]]; table[0][1] = 9; return table.join("|") + ":" + [[1, 2], [3, 4]].join("|"); } function frozen() { "use strict"; const list = Object.freeze([1, 2]); try { list[0] = 5; } catch (error) { return error.name + ":" + list.join(); } return list.join(); } report(storedInto(0, 9)); report(storedInto(5, 9)); report(storedInto(1, "x")); report(storedInto(1, 0.5)); report(storedInto(-1, 7)); report(grown(3)); report(grown("z")); report(cut()); report(reversedInALoop(4)); report(shared()); report(nested()); report(frozen()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 13 of 13 of 13
# CHECK-NEXT: exited with 0

