# -- source: the-first-callback-of-a-chain-reads-what-the-second-stores.js
# let shared = 0;
# function run(list) { shared = 1; const kept = list.map(x => x + shared).filter(x => (shared = shared * 5 + 1) > x); let sum = shared; for (const each of kept) sum += each; return sum; }
# report(run([1, 2, 3, 4])); report(run([1, 2, 3, 40]));
# report("end");
# -- end of source
# map() and filter() follow each other. All the calls of the first callback come before any call of the second, so each of them reads what the variable held ahead of the chain.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let shared = 0; function run(list) { shared = 1; const kept = list.map(x => x + shared).filter(x => (shared = shared * 5 + 1) > x); let sum = shared; for (const each of kept) sum += each; return sum; } report(run([1, 2, 3, 4])); report(run([1, 2, 3, 40])); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 3 of 3 of 3
# CHECK-NEXT: exited with 0

