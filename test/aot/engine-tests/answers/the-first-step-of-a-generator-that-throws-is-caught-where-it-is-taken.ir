# -- source: the-first-step-of-a-generator-that-throws-is-caught-where-it-is-taken.js
# let said = "";
# function* made(from) { if (from === 2) throw new RangeError("stop"); yield from; return "end"; }
# function run(seed) { try { { const steps = made(1); said += made(6).next().value; try { said += steps.next().value; } catch { said += "caught"; } said += steps.next().done; } if (seed === 1) return; { const steps = made(2); said += made(7).next().value; try { said += steps.next().value; } catch { said += "caught"; } said += steps.next().done; } } finally { said += "."; } }
# run(1); report(said); run(2); report(said);
# report("end");
# -- end of source
# The first step of a generator stands in a try block and the body throws ahead of its first yield: the handler around the step catches it, and the generator is done.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let said = ""; function* made(from) { if (from === 2) throw new RangeError("stop"); yield from; return "end"; } function run(seed) { try { { const steps = made(1); said += made(6).next().value; try { said += steps.next().value; } catch { said += "caught"; } said += steps.next().done; } if (seed === 1) return; { const steps = made(2); said += made(7).next().value; try { said += steps.next().value; } catch { said += "caught"; } said += steps.next().done; } } finally { said += "."; } } run(1); report(said); run(2); report(said); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 3 of 3 of 3
# CHECK-NEXT: exited with 0

