# -- source: what-a-method-says-ahead-of-a-test-that-fails-is-said-once.ts
# declare function report(value: unknown): void;
# const said: unknown[] = [];
# function say(...seen: unknown[]): void { for (let at = 0; at < seen.length; at++) said.push(seen[at]);}
# function tell(label: string): void { let text = ""; for (let at = 0; at < said.length; at++) text += (at ? "," : "") + String(said[at]); report(label + " " + text);}
# function attempt(label: string, run: () => void): void { try { run();} catch (error) {} tell(label);}
# class Box { value: number; more: number; constructor(value: number, more: number) {} }
# class Worker { scale = 2; work(box: Box, by: number): number { say("in", by); return box.value * by * this.scale + box.more;} }
# const worker = new Worker();
# function work(box: Box, by: number): number { return worker.work(box, by);}
# function run(seed: number): void { let sum = seed; const step = (turn: number): void => { const now: number = turn; for (let at = 0; at < 3; at++) sum += work(new Box(at, 1), now); say(work((((box: Box) => {})(new Box(now, 1))) as unknown as Box, now + 10));}; [3, 4].forEach(turn => step(turn));}
# attempt("one", () => run(1)); attempt("two", () => run(2));
# report("end");
# -- end of source
# A method says something and then reads fields of its operand. Handed what is no object of the class it says it once, and throws.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const said = []; function say(...seen) { for (let at = 0;at < seen.length; at++) said.push(seen[at]); } function tell(label) { let text = ""; for (let at = 0;at < said.length; at++) text += (at ? "," : "") + String(said[at]); report(label + " " + text); } function attempt(label, run) { try { run(); } catch (error) {} tell(label); } class Box { value; more; constructor(value, more) {} } class Worker { scale = 2; work(box, by) { say("in", by); return box.value * by * this.scale + box.more; } } const worker = new Worker; function work(box, by) { return worker.work(box, by); } function run(seed) { let sum = seed; const step = (turn) => { const now = turn; for (let at = 0;at < 3; at++) sum += work(new Box(at, 1), now); say(work(((box) => {})(new Box(now, 1)), now + 10)); }; [3, 4].forEach((turn) => step(turn)); } attempt("one", () => run(1)); attempt("two", () => run(2)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 3 of 3 of 3
# CHECK-NEXT: exited with 0

