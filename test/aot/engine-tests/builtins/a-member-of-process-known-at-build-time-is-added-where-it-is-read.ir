# The build knows process.arch, so the read becomes a text. process adds the member where it is first read, and the value whose keys are listed could be process:
# an InitializeBuiltin stands where the read stood. Nothing is read by name.
# FORM: AsRead
# RUN: pipeline ResolveAccesses

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Process
    v1 = PropGet v0 key="arch"
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v0 key="argv"
    v4 = Integer integer=2
    v5 = ElemGet v3, v4
    v6 = ElemGet v2, v5
    v7 = Builtin builtin=Reflect
    v8 = Builtin builtin=ReflectOwnKeys
    v9 = Call v8, v7, v6
    v10 = NewArray v1, v9 contents=anything
    Return v10
}
# CHECK-LABEL: function f0 name="main"
# CHECK-NOT: key="arch"
# CHECK: InitializeBuiltin builtin=ProcessArch
# CHECK-NOT: key="arch"
# CHECK: = String string=
