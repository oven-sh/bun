# An image over others takes over the members that the images below may write: Date.prototype.toString, Error.prototype.constructor, Performance.prototype.toJSON. They are constant unless written: the
# table never locked them, so no row for a pristine operand rests on them, and they are listed only so that this image does not lock them. `toString`, `constructor` and `toJSON` are looked up by join,
# slice and map: on a pristine array that is proven to hold no object none of the three holders can be met, and the rows for the pristine array stand
# FORM: Prepared
# RUN: pass ResolveBuiltins
# CHECK: v4: string = CallBuiltin v0, v1 overload=ArrayPrototypeJoin/0
# CHECK: v6: string = CallBuiltin v0 overload=ArrayPrototypeToString/0
# CHECK: v8: Array<undefined|number|string> = CallBuiltin v0, v2, v2 overload=ArrayPrototypeSlice/0

module m0 path="main.js" displayPath="main.js"
replaceablebuiltin member=DatePrototypeToString
replaceablebuiltin member=ErrorPrototypeConstructor
replaceablebuiltin member=PerformancePrototypeToJSON
function f0 name="holdsNoObject" parameters=[{type=Array<undefined|number|string, proven, pristine[Storage, Names]>}, {type=string}, {type=number}] results=[{type=undefined}] {
    v3 = Builtin builtin=ArrayPrototypeJoin
    v4 = Call v3, v0, v1
    v5 = Builtin builtin=ArrayPrototypeToString
    v6 = Call v5, v0
    v7 = Builtin builtin=ArrayPrototypeSlice
    v8 = Call v7, v0, v2, v2
    Return
}
