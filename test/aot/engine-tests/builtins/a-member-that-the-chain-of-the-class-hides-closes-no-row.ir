# Tests replace Object.prototype.toString and Function.prototype.toString, which the table locks, and add `format` to Object.prototype. join, slice and Array.prototype.toString look up `toString`
# on what they are handed. A row for a pristine array leaves out what a lookup ON THE ARRAY finds, and that goes along the chain of its class: `toString` finds Array.prototype.toString, which is
# still locked, and never comes to Object.prototype. Nothing that a test has put anywhere is found under a name that the three look up, so the rows for the pristine array stand
# FORM: Prepared
# RUN: pass ResolveBuiltins
# CHECK: v4: string = CallBuiltin v0, v1 overload=ArrayPrototypeJoin/0
# CHECK: v6: string = CallBuiltin v0 overload=ArrayPrototypeToString/0
# CHECK: v8: Array<undefined|number|string> = CallBuiltin v0, v2, v2 overload=ArrayPrototypeSlice/0

module m0 path="main.js" displayPath="main.js"
replaceablebuiltin member=FunctionPrototypeToString
replaceablebuiltin member=ObjectPrototypeToString
openedname holder=ObjectPrototype name="format"
function f0 name="holdsNoObject" parameters=[{type=Array<undefined|number|string, proven, pristine[Storage, Names]>}, {type=string}, {type=number}] results=[{type=undefined}] {
    v3 = Builtin builtin=ArrayPrototypeJoin
    v4 = Call v3, v0, v1
    v5 = Builtin builtin=ArrayPrototypeToString
    v6 = Call v5, v0
    v7 = Builtin builtin=ArrayPrototypeSlice
    v8 = Call v7, v0, v2, v2
    Return
}
