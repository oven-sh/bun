# A call of a callee expected to be one built-in reports the identity test of the callee, then the tests its operands need to match an overload
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests
# RUN(PLAN): test-placement
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
runtimefunction id=31 function=f0
runtimefunction id=89 function=f1
function f0 name="every" role=Library flags=[HasThis] enclosingRuntimeFunction=31 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=boolean}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Boolean boolean=true
    Return v3
}
function f1 name="some" role=Library flags=[HasThis] enclosingRuntimeFunction=89 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    Return v2
}

function f2 name="globalFunction" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="encodeURIComponent" [isFreeName]
    v3: anything ~ builtin(EncodeURIComponent) = Upcast v2 castType=anything
    v4 = Call v3, -, v0
    Return v4
}
# PLAN: function f2
# PLAN-NEXT: stretch 0: test TypeTest {{*}} testedType=builtin(EncodeURIComponent) before v4; uses v4;
# CHECK-LABEL: function f2 name="globalFunction"
# CHECK: [[isEncode2]]: boolean{{*}} = TypeTest v3 testedType=builtin(EncodeURIComponent)
# CHECK-NEXT: Branch [[isEncode2]] -> taken
# CHECK: v4: string = CallBuiltin -, v0 overload=EncodeURIComponent/0
# CHECK: frequency=Unlikely:
# CHECK-NEXT: anything = Call v3, -, v0

function f3 name="memberOfExpectedObject" parameters=[{type=builtin(Console) flags=[IsExpected]}, {type=string}] results=[{type=anything}] {
  b0(v0: anything ~ builtin(Console), v1: string):
    v2 = PropGet v0 key="log"
    v3: anything ~ builtin(ConsoleLog) = Upcast v2 castType=anything
    v4 = Call v3, v0, v1 calleeKey="log"
    Return v4
}
# The read is a use of its own: behind the tests of the object and of the member's location it is the member, which decides the test of the callee
# PLAN: function f3
# PLAN-NEXT: stretch 0: test TypeTest v0 testedType=builtin(Console) before v2; test IsBuiltinLocationUnchanged member=ConsoleLog before v2; test TypeTest v2 testedType=builtin(ConsoleLog) before v4; uses v2 v4;
# CHECK-LABEL: function f3 name="memberOfExpectedObject"
# CHECK: [[isConsole3]]: boolean{{*}} = TypeTest v0 testedType=builtin(Console)
# CHECK-NEXT: Branch [[isConsole3]] -> taken
# CHECK-NOT: PropGet
# CHECK: [[log3]]: builtin(ConsoleLog) = Builtin builtin=ConsoleLog
# CHECK: [[callee3]]: builtin(ConsoleLog) = Upcast [[log3]] castType=anything
# CHECK: true = TypeTest [[callee3]] testedType=builtin(ConsoleLog)
# CHECK-NOT: PropGet
# CHECK: undefined = CallBuiltin {{*}}v1 overload=ConsoleLog/
# CHECK: [[read3]]: anything = PropGet v0 key="log"
# CHECK-NEXT: [[readCallee3]]: anything ~ builtin(ConsoleLog) = Upcast [[read3]] castType=anything
# CHECK-NEXT: Jump -> next [[call3]]([[readCallee3]])
# CHECK-NEXT: [[call3]]([[passed3]]: anything ~ builtin(ConsoleLog)) frequency=Unlikely:
# CHECK-NEXT: anything = Call [[passed3]], v0, v1 calleeKey="log"
# CHECK: [[isUnchanged3]]: boolean = IsBuiltinLocationUnchanged member=ConsoleLog
# CHECK-NEXT: Branch [[isUnchanged3]] -> taken
# CHECK: frequency=Unlikely:

