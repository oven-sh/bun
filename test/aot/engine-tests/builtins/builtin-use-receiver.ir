# A read, store or call on a receiver expected to be an instance of a built-in class or a primitive reports the class test, then the pristine aspects its entry needs, and is resolved in the fast copy
# A receiver of a method call that is expected to be of one of several classes is tested for all of them at once. Nothing is resolved yet: what has passed is told apart like any value whose type lists them
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests
# RUN(PLAN): test-placement
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="inheritedConstant" parameters=[{type=Array flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ Array):
    v1 = PropGet v0 key="constructor"
    Return v1
}
# PLAN: function f0
# PLAN-NEXT: stretch 0: test TypeTest v0 testedType=Array before v1; test IsPristine v0 builtinClass=Array aspects=[Names] before v1; uses v1;
# CHECK-LABEL: function f0 name="inheritedConstant"
# CHECK: [[isArray0]]: boolean{{*}} = TypeTest v0 testedType=Array
# CHECK-NEXT: Branch [[isArray0]] -> taken [[tested0]](| 0), notTaken
# CHECK: v1: builtin(Array) = Builtin builtin=Array
# CHECK: frequency=Unlikely:
# CHECK-NEXT: anything = PropGet v0 key="constructor"
# CHECK: [[tested0]]([[array0]]: Array):
# CHECK-NEXT: boolean = IsPristine [[array0]] builtinClass=Array aspects=[Names]

function f1 name="ownPropertyOfInstances" parameters=[{type=Array flags=[IsExpected]}] results=[{type=anything}] {
