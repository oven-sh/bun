# CHECK: = TypeTest v0 testedType=Array
# CHECK-NOT: IsPristine
# CHECK: ([[array1]]: Array):
# CHECK-NOT: IsPristine
# CHECK: v1: int[0, 4294967295] = CallBuiltin [[array1]] overload=ArrayPrototypeLength/0
# CHECK-NOT: IsPristine
# CHECK: frequency=Unlikely:
# CHECK-NEXT: anything = PropGet v0 key="length"
# CHECK-NOT: IsPristine

function f2 name="entryNeedsStorage" parameters=[{type=Array flags=[IsExpected]}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything ~ Array, v1: anything):
    v2 = Builtin builtin=ArrayPrototypePush
    v3 = Call v2, v0, v1 calleeKey="push"
    Return v3
}
# PLAN: function f2
# PLAN-NEXT: stretch 0: test TypeTest v0 testedType=Array before v3; test IsPristine v0 builtinClass=Array aspects=[Storage] before v3; uses v3;
