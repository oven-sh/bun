# CHECK: v3: int[0, 4294967295] = CallBuiltin [[array2]], v1 overload=ArrayPrototypePush/0 [needsPristineReceiver]
# CHECK: frequency=Unlikely:
# CHECK-NEXT: anything = Call v2, v0, v1 calleeKey="push"
# CHECK: ([[array2]]: Array):
# CHECK-NEXT: boolean = IsPristine [[array2]] builtinClass=Array aspects=[Storage]

function f3 name="entryNeedsStorageAndNames" parameters=[{type=Array flags=[IsExpected]}] results=[{type=anything}] {
