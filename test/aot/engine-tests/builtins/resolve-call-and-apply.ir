# A built-in method called with an explicit this resolves by the type of this, and call and apply of a built-in function resolve as methods of that function, which ResolveCalls forwards
# FORM: Prepared
# RUN: pass ResolveBuiltins
# RUN(BOTH): pass ResolveBuiltins ResolveCalls ResolveBuiltins
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="callOnBuiltin" parameters=[{type=string}, {type=i32}] results=[{type=anything}] {
  b0(v0: string, v1: i32):
    v2 = Builtin builtin=StringPrototypeSlice
    v3 = PropGet v2 key="call"
    v4 = AssumeType v3 castType=builtin(FunctionPrototypeCall)
    v5 = Call v4, v2, v0, v1 calleeKey="call" callees=[builtin(FunctionPrototypeCall)]
    Return v5
}
# CHECK-LABEL: function f0 name="callOnBuiltin"
# CHECK-NOT: TypeTest
# CHECK: v5: {{*}} = CallBuiltin v2, v0, v1 overload=FunctionPrototypeCall/0
# BOTH-LABEL: function f0 name="callOnBuiltin"
# BOTH-NOT: TypeTest
# BOTH: v5: string = CallBuiltin v0, v1 overload=StringPrototypeSlice/0

function f1 name="applyOnBuiltin" parameters=[{type=Array<number>}] results=[{type=anything}] {
  b0(v0: Array<number>):
    v1 = Builtin builtin=MathMax
    v2 = Undefined
    v3 = PropGet v1 key="apply"
    v4 = AssumeType v3 castType=builtin(FunctionPrototypeApply)
    v5 = Call v4, v1, v2, v0 calleeKey="apply" callees=[builtin(FunctionPrototypeApply)]
    Return v5
}
# CHECK-LABEL: function f1 name="applyOnBuiltin"
# CHECK-NOT: TypeTest
# CHECK: v5: {{*}} = CallBuiltin v1, v2, v0 overload=FunctionPrototypeApply/0
# BOTH-LABEL: function f1 name="applyOnBuiltin"
# BOTH-NOT: overload=FunctionPrototypeApply
# BOTH: = IsPristine v0 builtinClass=Array aspects=[Storage, Names]
# BOTH: number = CallBuiltin -, v0 overload=MathMax/0 builtinCallForm=List [needsPristineReceiver]
# BOTH: frequency=Unlikely:
# BOTH-NEXT: anything = CallList v1, v2, v0

# Of a constructor of the host that does not stand on the global object the table does not say that it keeps `call`.
function f2 name="calleeNotProven" parameters=[{type=string}, {type=i32}] results=[{type=anything}] {
  b0(v0: string, v1: i32):
    v2 = Builtin builtin=BunGlob
    v3 = PropGet v2 key="call"
    v4 = Call v3, v2, v0, v1 calleeKey="call" callees=[builtin(FunctionPrototypeCall), ..]
    Return v4
}
# CHECK-LABEL: function f2 name="calleeNotProven"
# CHECK-NOT: CallBuiltin
# CHECK: v4: anything = Call v3, v2, v0, v1 calleeKey="call"

function f3 name="methodWithThis" parameters=[{type=string}, {type=i32}] results=[{type=anything}] {
