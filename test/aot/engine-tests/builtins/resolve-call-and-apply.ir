# A native function of the engine never has a `call` of its own and keeps its prototype, so the member of Function.prototype is found without a word from flow.
function f14 name="callOnNativeFunction" parameters=[{type=string}, {type=i32}] results=[{type=anything}] {
  b0(v0: string, v1: i32):
    v2 = Builtin builtin=StringPrototypeSlice
    v3 = PropGet v2 key="call"
    v4 = Call v3, v2, v0, v1 calleeKey="call"
    Return v4
}
# BOTH-LABEL: function f14 name="callOnNativeFunction"
# BOTH-NOT: = Call
# BOTH: string = CallBuiltin v0, v1 overload=StringPrototypeSlice/0

# Nor has a built-in function that the library writes in JavaScript.
