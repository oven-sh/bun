# encoder.encodeInto(text, destination) has an overload only for a Uint8Array: a Buffer is one, and a view of any other class chooses no overload, so the call is made with the operands as they come and the native function throws
# FORM: Prepared
# RUN: pass ResolveBuiltins

module m0 path="main.js" displayPath="main.js"
function f0 name="bytes" parameters=[{type=TextEncoder}, {type=string}, {type=Uint8Array}] results=[{type=anything}] {
  b0(v0: TextEncoder, v1: string, v2: Uint8Array):
    v3 = Builtin builtin=TextEncoderPrototypeEncodeInto
    v4 = Call v3, v0, v1, v2
    Return v4
}
# CHECK-LABEL: function f0 name="bytes"
# CHECK-NOT: AnyReceiver
# CHECK: CallBuiltin v0, v1, v2 overload=TextEncoderPrototypeEncodeInto/0
# CHECK-NOT: AnyReceiver

