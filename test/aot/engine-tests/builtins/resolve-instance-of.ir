# CHECK: frequency=Rare:
# CHECK-NEXT: boolean = InstanceOf v0, v1
# TWICE-LABEL: function f18 name="prototypeWithoutEntry"
# TWICE: = PropGet v1 key="prototype"
# TWICE-NOT: = PropGet v1 key="prototype"

