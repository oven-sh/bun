# instanceof with a built-in constructor is answered from the type of the value, or by a class test and a pristine test that can only answer yes. What is left walks the chain of the value for the prototype object
# OPTIONS: only-passes=ResolveBuiltins
# RUN: pipeline ResolveBuiltins
# RUN(TWICE): pass ResolveBuiltins ResolveBuiltins ResolveBuiltins
# TWICE: outcome: Changed
# TWICE: outcome: Changed
# TWICE: outcome: Unchanged

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = NewClosure function=f4
    v6 = NewClosure function=f5
    v7 = NewClosure function=f6
    v8 = NewClosure function=f7
    v9 = NewClosure function=f8
    v10 = NewClosure function=f9
    v11 = NewClosure function=f10
    v12 = NewClosure function=f11
    v13 = NewClosure function=f12
    v14 = NewClosure function=f13
    v15 = Call v1, -, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14
    v16 = Builtin builtin=BunGlob
    PropDefine v16, v2 key=@@hasInstance
    v18 = NewClosure function=f15
    v19 = NewClosure function=f16
    v20 = NewClosure function=f17
    v21 = NewClosure function=f18
    v22 = NewClosure function=f19
    v23 = Call v1, -, v18, v19, v20, v21, v22
    Return
}

function f1 name="primitive" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="Array" [isFreeName]
    v3 = InstanceOf v0, v2
    Return v3
}
# CHECK-LABEL: function f1 name="primitive"
# CHECK-NOT: InstanceOf
# CHECK: v3: false = Boolean
# CHECK-NEXT: Return v3

function f2 name="pristineArray" results=[{type=anything}] {
  b0():
    v0 = NewArray contents=anything
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="Array" [isFreeName]
    v3 = InstanceOf v0, v2
    v4 = PropGet v1 key="Object" [isFreeName]
    v5 = InstanceOf v0, v4
    v6 = PropGet v1 key="Map" [isFreeName]
    v7 = InstanceOf v0, v6
    v8 = NewArray v3, v5, v7 contents=anything
    Return v8
}
# CHECK-LABEL: function f2 name="pristineArray"
# CHECK-NOT: InstanceOf
# CHECK: Array<never, proven, pristine[Storage, Names, Dense]> = AssumeType v0
# CHECK-NOT: InstanceOf
# CHECK: v3: true = Boolean boolean=true
# CHECK-NOT: InstanceOf
# CHECK: v5: true = Boolean boolean=true
# CHECK-NOT: InstanceOf
# CHECK: v7: false = Boolean
# CHECK-NOT: InstanceOf

function f3 name="pristineMap" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Map" [isFreeName]
    v2 = Construct v1
    v3 = InstanceOf v2, v1
    v4 = PropGet v0 key="Object" [isFreeName]
    v5 = InstanceOf v2, v4
    v6 = PropGet v0 key="Array" [isFreeName]
    v7 = InstanceOf v2, v6
    v8 = NewArray v3, v5, v7 contents=anything
    Return v8
}
# CHECK-LABEL: function f3 name="pristineMap"
# CHECK-NOT: InstanceOf
# CHECK: v3: true = Boolean boolean=true
# CHECK-NOT: InstanceOf
# CHECK: v5: true = Boolean boolean=true
# CHECK-NOT: InstanceOf
# CHECK: v7: false = Boolean
# CHECK-NOT: InstanceOf

