# A constructor that the host puts on the global object is native: it takes no Symbol.hasInstance of its own and no other parent, whoever has had it in hand.
function f17 name="constructorOfTheHost" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=Blob
    v2 = InstanceOf v0, v1
    Return v2
}
# CHECK-LABEL: function f17 name="constructorOfTheHost"
# CHECK: = TypeTest v0 testedType=Blob
# CHECK: = Builtin builtin=BlobPrototype
# CHECK: boolean = HasInPrototypeChain
# CHECK-NOT: InstanceOf

# The table has no entry for FormData.prototype: it is read from the constructor, and what is no object there is left to the whole operation.
function f18 name="prototypeWithoutEntry" parameters=[{type=anything}] results=[{type=anything}] {
