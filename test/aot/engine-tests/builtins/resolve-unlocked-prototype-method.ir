# A method found on a prototype that is not always locked, or on an instance that can never be tested pristine, is tested by identity, and the failing side calls the value that was read
# FORM: Prepared
# RUN: pass ResolveBuiltins InsertObjectCoercibleChecks PlaceTypeTests
# CHECK: outcome: Unchanged
# CHECK: outcome: Changed
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="methodOfUnlockedPrototype" parameters=[{type=WeakRef}, {type=number}] results=[{type=anything}] {
  b0(v0: WeakRef, v1: number):
    v2 = PropGet v0 key="deref"
    v3 = Call v2, v0 calleeKey="deref"
    Return v3
}
# CHECK-LABEL: function f0 name="methodOfUnlockedPrototype"
# CHECK-NOT: IsPristine
# CHECK: v2: anything = PropGet v0 key="deref"
# CHECK-NEXT: Jump -> next [[test0]]()
# CHECK-NOT: IsPristine
# CHECK-NOT: PropGet
# CHECK: anything = CallBuiltin v0 overload=WeakRefPrototypeDeref/0
# CHECK-NOT: IsPristine
# CHECK-NOT: PropGet
# CHECK: [[test0]]():
# CHECK-NEXT: [[isDeref]]: boolean = TypeTest v2 testedType=builtin(WeakRefPrototypeDeref)
# CHECK-NEXT: Branch [[isDeref]] -> taken
# CHECK-NEXT: frequency=Unlikely:
# CHECK-NEXT: anything = Call v2, v0 calleeKey="deref"
# CHECK-NOT: IsPristine
# CHECK-NOT: PropGet

function f1 name="methodOfClassNeverPristine" parameters=[{type=Generator}, {type=number}] results=[{type=anything}] {
  b0(v0: Generator, v1: number):
    v2 = PropGet v0 key="next"
    v3 = Call v2, v0, v1 calleeKey="next"
    Return v3
}
# CHECK-LABEL: function f1 name="methodOfClassNeverPristine"
# CHECK-NOT: IsPristine
# CHECK: v2: anything = PropGet v0 key="next"
# CHECK-NEXT: Jump -> next [[test1]]()
# CHECK-NOT: IsPristine
# CHECK: object = CallBuiltin v0, v1 overload=GeneratorPrototypeNext/0
# CHECK-NOT: IsPristine
# CHECK: [[test1]]():
# CHECK-NEXT: [[isNext]]: boolean = TypeTest v2 testedType=builtin(GeneratorPrototypeNext)
# CHECK-NEXT: Branch [[isNext]] -> taken
# CHECK-NEXT: frequency=Unlikely:
# CHECK-NEXT: anything = Call v2, v0, v1 calleeKey="next"
# CHECK-NOT: IsPristine

function f2 name="getterOfUnlockedPrototype" parameters=[{type=DisposableStack}] results=[{type=anything}] {
  b0(v0: DisposableStack):
    v1 = PropGet v0 key="disposed"
    Return v1
}
# CHECK-LABEL: function f2 name="getterOfUnlockedPrototype"
# CHECK-NEXT: b0(v0: DisposableStack):
# CHECK-NEXT: v1: anything = PropGet v0 key="disposed"
# CHECK-NEXT: Return v1

function f3 name="methodOfClassTestedByItsStructure" parameters=[{type=Buffer}, {type=number}] results=[{type=anything}] {
  b0(v0: Buffer, v1: number):
    v2 = PropGet v0 key="readUInt8"
    v3 = Call v2, v0, v1 calleeKey="readUInt8"
    Return v3
}
# CHECK-LABEL: function f3 name="methodOfClassTestedByItsStructure"
# CHECK-NEXT: b0(v0: Buffer, v1: number):
# CHECK-NEXT: [[isPristine]]: boolean = IsPristine v0 builtinClass=Buffer aspects=[Names]
# CHECK-NEXT: Branch [[isPristine]] -> taken
# CHECK: v2: builtin(BufferPrototypeReadUInt8) = Builtin builtin=BufferPrototypeReadUInt8
# CHECK: int[0, 255] = CallBuiltin v0, v1 overload=BufferPrototypeReadUInt8/0
# CHECK: frequency=Unlikely:
# CHECK-NEXT: anything = PropGet v0 key="readUInt8"

function f4 name="unmatchedOperands" parameters=[{type=Buffer}, {type=string}] results=[{type=anything}] {
  b0(v0: Buffer, v1: string):
    v2 = PropGet v0 key="readUInt8"
    v3 = Call v2, v0, v1 calleeKey="readUInt8"
    Return v3
}
# CHECK-LABEL: function f4 name="unmatchedOperands"
# CHECK-NOT: CallBuiltin
# CHECK: v2: builtin(BufferPrototypeReadUInt8) = Builtin builtin=BufferPrototypeReadUInt8
# CHECK-NOT: CallBuiltin
# CHECK: v3: anything = Call v2, v0, v1 calleeKey="readUInt8"
# CHECK-NOT: CallBuiltin

function f5 name="callWithoutCalleeKey" parameters=[{type=Buffer}, {type=number}, {type=anything}] results=[{type=anything}] {
  b0(v0: Buffer, v1: number, v2: anything):
    v3 = Call v2, v0, v1
    Return v3
}
# CHECK-LABEL: function f5 name="callWithoutCalleeKey"
# CHECK-NEXT: b0(v0: Buffer, v1: number, v2: anything):
# CHECK-NEXT: v3: anything = Call v2, v0, v1
# CHECK-NEXT: Return v3

function f6 name="nullableReceiver" parameters=[{type=undefined|Generator}, {type=number}] results=[{type=anything}] {
  b0(v0: undefined|Generator, v1: number):
    v2 = PropGet v0 key="next"
    v3 = Call v2, v0, v1 calleeKey="next"
    Return v3
}
# CHECK-LABEL: function f6 name="nullableReceiver"
# CHECK: [[checked]]: Generator = RequireObjectCoercible v0 name="next"
# CHECK-NEXT: v2: anything = PropGet [[checked]] key="next"
# CHECK-NEXT: Jump -> next [[test6]]()
# CHECK: object = CallBuiltin [[checked]], v1 overload=GeneratorPrototypeNext/0
# CHECK: [[test6]]():
# CHECK-NEXT: boolean = TypeTest v2 testedType=builtin(GeneratorPrototypeNext)
# CHECK: frequency=Unlikely:
# CHECK-NEXT: anything = Call v2, [[checked]], v1 calleeKey="next"
