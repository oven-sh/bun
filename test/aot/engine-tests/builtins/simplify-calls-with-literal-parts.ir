# A call of a built-in that has a form for the members of a literal, with an object literal that nobody else sees, becomes a call of that form with the members as arguments. Native code reads no member by name, and no object is made.
# FORM: Prepared
# RUN: pass SimplifyBuiltinCalls
# RUN(DEAD): pass SimplifyBuiltinCalls EliminateDeadCode
# STATISTIC: LiteralArgumentsTakenApart = 7

module m0 path="main.js" displayPath="main.js"
layout L0 fields=[{key="headers" declared={type=anything}}, {key="status" declared={type=anything}}, {key="statusText" declared={type=anything}}]
layout L1 fields=[{key="status" declared={type=anything}}, {key="method" declared={type=anything}}]
layout L2 kind=Instance name="Init" fields=[{key="status" declared={type=anything}}] flow={baseState=None}
layout L3

function f0 name="statusAndHeaders" parameters=[{type=string}, {type=number}, {type=anything}] results=[{type=anything}] {
  b0(v0: string, v1: number, v2: anything):
    v3 = NewObject -, v1, v2 layout=L0 fields=[1, 0]
    v4 = CallBuiltin -, v0, v3 overload=Response/4
    Return v4
}
