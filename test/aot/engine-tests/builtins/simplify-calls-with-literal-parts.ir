# CHECK: [[absent0]]: undefined = Undefined
# CHECK-NEXT: v4: Response = CallBuiltin -, v0, v1, [[absent0]], v2 overload=CompilerHelpersNewResponseFromParts/0
# CHECK-NEXT: Return v4
# DEAD-LABEL: function f0 name="statusAndHeaders"
# DEAD-NOT: NewObject

