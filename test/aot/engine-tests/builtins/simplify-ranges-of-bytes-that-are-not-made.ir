# view.subarray(begin) that goes into encoder.encodeInto(text, ..) and nowhere else on its way there is not made. In its place travel the view and the place where the range starts, -1 where the value is what it is.
# Whoever else gets to see the range on another way has it made for him. Nobody may see it twice: two ranges made of one would be two objects.
# FORM: Prepared
# RUN: pass SimplifyBuiltinCalls

module m0 path="main.js" displayPath="main.js"
variable g0 name="kept" declared={type=anything} initialization=Undefined
function f0 name="oneAfterTheOther" parameters=[{type=TextEncoder}, {type=string}, {type=Uint8Array<int[0, 255], pristine[Names]>}, {type=number}] results=[{type=object}] {
  b0(v0: TextEncoder, v1: string, v2: Uint8Array<int[0, 255], pristine[Names]>, v3: number):
    v4 = CallBuiltin v2, v3 overload=TypedArrayPrototypeSubarray/0
    v5 = CallBuiltin v0, v1, v4 overload=TextEncoderPrototypeEncodeInto/0
    Return v5
}
# CHECK-LABEL: function f0 name="oneAfterTheOther"
# CHECK-NOT: TypedArrayPrototypeSubarray
# CHECK: [[start]]: int[-1, 2147483647] = CallBuiltin -, v2, v3 overload=CompilerHelpersStartOfRangeOfBytes/0
# CHECK-NEXT: v4: {{*}} = CallBuiltin -, v2, v3, [[start]] overload=CompilerHelpersViewOrRangeOfBytes/0
# CHECK-NEXT: v5: object = CallBuiltin -, v0, v1, v4, [[start]] overload=CompilerHelpersEncodeIntoRangeOfBytes/0
# CHECK-NEXT: Return v5

function f1 name="theWholeViewOnTheOtherWay" parameters=[{type=TextEncoder}, {type=string}, {type=Uint8Array<int[0, 255], pristine[Names]>}, {type=number}, {type=boolean}] results=[{type=object}] {
  b0(v0: TextEncoder, v1: string, v2: Uint8Array<int[0, 255], pristine[Names]>, v3: number, v4: boolean):
    Branch v4 -> taken b1(), notTaken b2(v2)
  b1():
    v5 = CallBuiltin v2, v3 overload=TypedArrayPrototypeSubarray/0
    Jump -> next b2(v5)
  b2(v6: Uint8Array):
    v7 = GetModuleVariable variable=g0
    v8 = CallBuiltin v0, v1, v6 overload=TextEncoderPrototypeEncodeInto/0
    Return v8
}
# CHECK-LABEL: function f1 name="theWholeViewOnTheOtherWay"
# CHECK-NOT: TypedArrayPrototypeSubarray
# CHECK: [[noneOfFirst]]: -1 = Integer integer=-1
# CHECK: Branch v4 -> taken b1(), notTaken b2(v2, [[noneOfFirst]])
# CHECK: [[startOfFirst]]: int[-1, 2147483647] = CallBuiltin -, v2, v3 overload=CompilerHelpersStartOfRangeOfBytes/0
# CHECK-NEXT: v5: {{*}} = CallBuiltin -, v2, v3, [[startOfFirst]] overload=CompilerHelpersViewOrRangeOfBytes/0
# CHECK-NEXT: Jump -> next b2(v5, [[startOfFirst]])
# CHECK: b2(v6: Uint8Array, [[mergedOfFirst]]: int[-1, 2147483647]):
# CHECK: v8: object = CallBuiltin -, v0, v1, v6, [[mergedOfFirst]] overload=CompilerHelpersEncodeIntoRangeOfBytes/0

function f2 name="somebodyElseSeesItOnAnotherWay" parameters=[{type=TextEncoder}, {type=string}, {type=Uint8Array<int[0, 255], pristine[Names]>}, {type=number}, {type=boolean}] results=[{type=anything}] {
  b0(v0: TextEncoder, v1: string, v2: Uint8Array<int[0, 255], pristine[Names]>, v3: number, v4: boolean):
    v5 = CallBuiltin v2, v3 overload=TypedArrayPrototypeSubarray/0
    v6 = Upcast v5 castType=anything
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    PutModuleVariable v6 variable=g0
    v8 = Undefined
    Return v8
  b2():
    v9 = CallBuiltin v0, v1, v5 overload=TextEncoderPrototypeEncodeInto/0
    Return v9
}
# CHECK-LABEL: function f2 name="somebodyElseSeesItOnAnotherWay"
# CHECK-NOT: TypedArrayPrototypeSubarray
# CHECK: [[startOfSecond]]: int[-1, 2147483647] = CallBuiltin -, v2, v3 overload=CompilerHelpersStartOfRangeOfBytes/0
# CHECK: b1():
# CHECK-NEXT: [[madeOfSecond]]: Uint8Array = CallBuiltin -, v6, [[startOfSecond]] overload=CompilerHelpersRangeOfBytes/0
# CHECK-NEXT: PutModuleVariable [[madeOfSecond]] variable=g0
# CHECK: v9: object = CallBuiltin -, v0, v1, v5, [[startOfSecond]] overload=CompilerHelpersEncodeIntoRangeOfBytes/0

function f3 name="whatHappensInBetweenChangesNothing" parameters=[{type=TextEncoder}, {type=string}, {type=Uint8Array<int[0, 255], pristine[Names]>}, {type=number}, {type=anything}] results=[{type=object}] {
