# `plan.shift()` in a loop, on a list of fractions: every element moves down by one place, eight of them a turn. The read at index + 1 stands in front of the store at
# index. Outside x86 base + (index << 3) is an instruction: all sixteen accesses go through one such sum, which takes the shift in, and differ in their offsets.
# `list.pop()` on a list of any kind reads and clears the last place in one of three arms, none in front of another: the sum is made once, where all three come from.
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN(SUMS): lower-to-b3 optimized loops entry-modules
# REQUIRES(SUMS): arm64 unsanitized-code
# RUN(ARM64): lower-to-air size loops entry-modules
# REQUIRES(ARM64): arm64 unsanitized-code
# RUN(X64): lower-to-air size loops entry-modules
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARMS): lower-to-air entry-modules
# REQUIRES(ARMS): arm64 unsanitized-code
# -- source: main.ts
# declare const input: any;
# function total(plan: number[]): number {
#   let sum = 0;
#   for (let n = plan.shift() ?? 0; n > 0; n = plan.shift() ?? 0) sum += n;
#   return sum;
# }
# function last(list: number[]): number {
#   return list.pop() ?? 0;
# }
# (globalThis as any).answer = total(new Array(100).fill(+input)) + last(JSON.parse(input));
# -- end of source
# SUMS-LABEL: steps by 8
# SUMS: Int64 b@[[offset]] = Shl(b@
# SUMS-NEXT: Int64 b@[[address]] = Add({{*}})
# SUMS-NOT: b@[[offset]]
# SUMS-COUNT-8: = Store(b@{{*}}, b@[[address]],
# SUMS-LABEL: end of loop
# ARM64: instructions: 19, patchpoints: 0, {{*}} steps by 8
# X64: instructions: 18, patchpoints: 0, {{*}} steps by 8
# ARMS-LABEL: name="last" role=Source
# ARMS-NOT: Lshift64
# ARMS: AddLeftShift64
# ARMS-NOT: Lshift64
# ARMS-NOT: AddLeftShift64
# ARMS-LABEL: end of function

