# function reverseInt8(list: Int8Array): void {
#   for (let low = 0, high = list.length - 1; low < high; low++, high--) {
#     const kept = list[low]!;
#     list[low] = list[high]!;
#     list[high] = kept;
#   }
# }
# function reverseUint8(list: Uint8Array): void {
#   for (let low = 0, high = list.length - 1; low < high; low++, high--) {
