#     if (shape.height > other.height) result += 131071; else if (shape.height < other.height) result -= 131071;
#     if (shape.label.length > other.label.length) result += 1048583;
#     if ((shape.flags | other.flags) & 0x40000000) result = -result;
#     return result;
# }
#
# const shapes: Shape[] = [];
