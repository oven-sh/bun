#
# function measure(shape: Shape, other: Shape, mask: number): number {
#     let result = 0;
#     if (shape.flags & 0x3C0001) result += shape.objectFlags & 0x1814000D;
#     if (other.flags & 0x3C0001) result += other.objectFlags & 0x1814000D;
