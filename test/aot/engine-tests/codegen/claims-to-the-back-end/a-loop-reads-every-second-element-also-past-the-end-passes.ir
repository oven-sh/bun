# A loop reads every second element of a view of numbers: within the view, and for more turns than the view has room for.
# FORM: AsRead
# RUN: run-in-shell
# OPTIONS: check=DecidedComparisons
# CHECK: 1600 24 0
# CHECK-NOT: AOT claim check
# CHECK: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0

function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=Float64Array
    v3 = Integer integer=64
    v4 = Construct v2, -, v3 calleeName="Float64Array"
    v5 = Convert v4 declared={type=undefined|null|Float64Array flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v6 = PropGet v5 key="fill"
    v7 = Integer integer=1
    v8 = Call v6, v5, v7 calleeKey="fill" calleeName="fill"
    v9 = Convert v8 declared={type=undefined|null|Float64Array flags=[OmitsNull, OmitsUndefined]} illTypedCause=FromLooseType
    v10 = Integer
    v11 = Convert v10 declared={type=number}
    v12 = Integer
    v13 = Convert v12 declared={type=number}
    Jump -> next b2(v11, v13)
  b2(v14: number, v15: number):
    LoopHint
    v17 = Integer integer=50
    v18 = Less v15, v17
    Branch v18 -> taken b3(| 0), notTaken b6(| 0)
  b3(v19):
    Jump -> next b4()
  b4():
    v20 = Integer integer=32
    v21 = Call v1, -, v9, v20 calleeName="sum"
    v22 = Convert v21 declared={type=number}
    v23 = Add v14, v22
    v24 = Convert v23 declared={type=number}
    Jump -> next b5()
  b5():
    v25 = Increment v19
    v26 = Convert v25 declared={type=number}
    Jump -> next b2(v24, v26)
  b6(v27):
    Jump -> next b7()
  b7():
    v28 = Builtin builtin=GlobalThis
    v29 = PropGet v28 key="print" [isFreeName]
    v30 = Integer integer=40
    v31 = Call v1, -, v9, v30 calleeName="sum"
    v32 = Convert v31 declared={type=number}
    v33 = Integer
    v34 = Call v1, -, v9, v33 calleeName="sum"
    v35 = Convert v34 declared={type=number}
    v36 = Call v29, -, v14, v32, v35 calleeName="print"
    v37 = Undefined
    Return v37
}

function f1 name="sum" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|Float64Array flags=[OmitsNull, OmitsUndefined]}, {type=number}] results=[{type=number}] {
  b0(v0: undefined|null|Float64Array, v1: number):
    Jump -> next b1()
  b1():
    v2 = Integer
    v3 = Convert v2 declared={type=number}
    v4 = Integer
    v5 = Convert v4 declared={type=number}
    Jump -> next b2(v3, v5)
  b2(v6: number, v7: number):
    LoopHint
    v9 = Less v7, v1
    Branch v9 -> taken b3(| 0, 1), notTaken b11(| 0, 1)
  b3(v10, v11):
    Jump -> next b4()
  b4():
    v12 = Integer integer=2
    v13 = Mul v10, v12
    v14 = Integer integer=1
    v15 = Add v13, v14
    v16 = ElemGet v0, v15
    v17 = Convert v16 declared={type=number}
    v18 = TypeTest v17 testedType=undefined
    Branch v18 -> taken b5(| 0), notTaken b7(| 0)
  b5(v19):
    Jump -> next b6()
  b6():
    v20 = Integer integer=-1
    Jump -> next b9(v20)
  b7(v21):
    Jump -> next b8()
  b8():
    Jump -> next b9(v21)
  b9(v22):
    v23 = Add v6, v22
    v24 = Convert v23 declared={type=number}
    Jump -> next b10()
  b10():
    v25 = Increment v10
    v26 = Convert v25 declared={type=number}
    Jump -> next b2(v24, v26)
  b11(v27, v28):
    Jump -> next b12()
  b12():
    v29 = Convert v6 declared={type=number}
    Return v29
}
