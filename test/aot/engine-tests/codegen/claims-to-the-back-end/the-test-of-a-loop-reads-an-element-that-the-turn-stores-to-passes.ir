    v38 = Convert v37 declared={type=undefined|null|string flags=[IsExpected]}
    v39 = Call v30, -, v33, v38 calleeName="print"
    v40 = Undefined
    Return v40
}

function f1 name="total" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|Array<number> flags=[IsExpected]}] results=[{type=number flags=[IsExpected]}] {
