    Jump -> next b8()
  b8():
    v21 = Increment v11
    v22 = Convert v21 declared={type=number flags=[IsExpected]}
    Jump -> next b2(v22)
  b9(v23):
    Jump -> next b10()
  b10():
    v24 = PropGet v4 key="push"
    v25 = Convert v24 declared={type=undefined|null|f2 flags=[IsExpected]}
    v26 = Integer integer=-1
    v27 = Call v25, v4, v26 calleeKey="push" calleeName="list.push"
