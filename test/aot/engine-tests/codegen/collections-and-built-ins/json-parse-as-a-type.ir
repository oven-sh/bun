  b1():
    v1 = Builtin builtin=JSON
    v2 = PropGet v1 key="parse"
    v3 = Convert v2 declared={type=builtin(JSONParse) flags=[IsExpected]}
    v4 = Call v3, v1, v0 calleeKey="parse" calleeName="JSON.parse"
    v5 = Convert v4 declared={type=undefined|null|L0 flags=[IsExpected]}
    v6 = Convert v5 declared={type=undefined|null|L0 site=w5 flags=[OmitsNull, OmitsUndefined]} illTypedCause=FromLooseType
    v7 = PropGet v6 key="x"
