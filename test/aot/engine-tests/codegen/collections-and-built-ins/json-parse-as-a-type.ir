  b2(v4: number):
    LoopHint
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = Less v4, v8
    Branch v9 -> taken b3(| 0), notTaken b6(| 0)
  b3(v10):
    Jump -> next b4()
  b4():
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="globalThis" [isFreeName]
    v13 = Convert v12 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v14 = Convert v13 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v15 = Builtin builtin=String
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="input" [isFreeName]
    v18 = Call v15, -, v17 calleeName="String"
    v19 = Convert v18 declared={type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v20 = Call v1, -, v19 calleeName="read"
    v21 = Convert v20 declared={type=number site=w4}
    PropSet v14, v21 key="answer"
    Jump -> next b5()
  b5():
    v23 = Increment v10
    v24 = Convert v23 declared={type=number site=w2}
    Jump -> next b2(v24)
  b6(v25):
    Jump -> next b7()
  b7():
