    v9 = Add v7, v8
    v10 = Convert v9 declared={type=number site=w1}
    Return v10
}

# JSON.parse whose result is cast to a type with a layout does not start with the built-in. One call opens the text, and the first character is looked at in place to skip white space.
# CHECK-LABEL: name="read" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Int64 b@[[opened]] = Patchpoint(b@{{*}}:Register({{*}}), b@{{*}}:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent|Writes:{{*}}:JSONSourceOpen)
# CHECK: Branch(b@[[opened]], Terminal, {{*}}:JSONSourceOpen)
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Rare:#
# CHECK: Int64 b@[[start]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|Reads:ParserState, {{*}}:JSONSourceStart)
# CHECK-NEXT: Int32 b@{{*}} = Load8Z(b@[[start]], ControlDependent|Reads:ParserState, {{*}}:JSONSkipWhitespace)
# The parser that was compiled for the layout is called directly. It answers with three words: whether the text fits, the object and the place where it stopped.
# CHECK: Int32, Int64, Int64 b@[[parsed]] = Patchpoint(b@{{*}}:Register({{*}}), resultConstraints = [Register({{*}}), Register({{*}}), Register({{*}})], ExitsSideways{{*}}:CallDirect)
# CHECK-NEXT: Int32 b@[[fits]] = Extract(b@[[parsed]], <<0, {{*}}:CallDirect)
# CHECK: Int32 b@[[doesFit]] = Equal(b@[[fits]], $1(b@{{*}}))
# CHECK: Branch(b@[[doesFit]], Terminal)
# To close the text, the place where the parser stopped is compared with the end of the text in place.
# CHECK: Int64 b@[[end]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|Reads:ParserState, {{*}}:JSONSourceClose)
# CHECK-NEXT: Int32 b@{{*}} = Equal(b@{{*}}, b@[[end]], {{*}}:JSONSourceClose)
# CHECK-LABEL: end of function
# One call each opens the text, parses, closes what was not closed in place, and abandons. The built-in itself is called at one place, for a text that does not fit the type.
# CALLS-LABEL: name="read" role=Source
# CALLS-COUNT-1: :JSONSourceOpen)
# CALLS-COUNT-1: ExitsSideways{{*}}:CallDirect)
# CALLS-NOT: = Patchpoint({{*}}:CallDirect)
# CALLS-COUNT-1: = Patchpoint({{*}}:JSONSourceClose)
# CALLS-NOT: = Patchpoint({{*}}:JSONSourceClose)
# CALLS-COUNT-1: ExitsSideways{{*}}:CallBuiltin)
# CALLS-NOT: ExitsSideways{{*}}:CallBuiltin)
# CALLS-COUNT-1: = Patchpoint({{*}}:JSONSourceAbandon)
# CALLS-NOT: = Patchpoint({{*}}:JSONSourceAbandon)
# CALLS-LABEL: end of function
# The counts hold calls, whose moves follow the calling convention: not for Windows.
# X64: instructions: 44, patchpoints: 8, rare instructions: 8
# ARM64: instructions: 53, patchpoints: 8, rare instructions: 9
