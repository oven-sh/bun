    Return v8
}

# Without a type for its result JSON.parse is a call of the built-in itself, as native code is called. The words that hold its function object and JSON, the receiver, are each loaded and tested; only an empty word goes to a rare call that fills it.
# CHECK-LABEL: name="read" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Int64 b@[[function]] = Load(b@{{*}}, ControlDependent|Reads:AllocatorState, {{*}}:CallBuiltin)
# CHECK-NEXT: Branch(b@[[function]], Terminal, {{*}}:CallBuiltin)
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Rare:#
# CHECK: Int64 b@[[receiver]] = Load(b@{{*}}, ControlDependent|Reads:AllocatorState, {{*}}:CallBuiltin)
# CHECK-NEXT: Branch(b@[[receiver]], Terminal, {{*}}:CallBuiltin)
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Rare:#
# CHECK: Int64 b@[[parsed]] = Patchpoint(b@{{*}}:Register({{*}}), b@{{*}}:Register({{*}}), b@{{*}}:Register({{*}}), $10(b@{{*}}):Register({{*}}), resultConstraints = Register({{*}}), ExitsSideways{{*}}:CallBuiltin)
# Nothing is known about what comes back: each member is read by name, by a call, and the addition is a call too.
# CHECK: Int64 b@[[x]] = Patchpoint(b@[[parsed]]:Register({{*}}), b@{{*}}:Register({{*}}), resultConstraints = Register({{*}}), ExitsSideways{{*}}:PropGet)
# CHECK: Int64 b@[[y]] = Patchpoint(b@[[parsed]]:Register({{*}}), b@{{*}}:Register({{*}}), resultConstraints = Register({{*}}), ExitsSideways{{*}}:PropGet)
# CHECK-NEXT: Int64 b@[[sum]] = Patchpoint(b@[[x]]:Register({{*}}), b@[[y]]:Register({{*}}), resultConstraints = Register({{*}}), ExitsSideways{{*}}:Add)
# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK-LABEL: end of function
# Four calls can throw, and there are no more.
# CALLS-LABEL: name="read" role=Source
# CALLS-COUNT-4: ExitsSideways
# CALLS-NOT: ExitsSideways
# CALLS-LABEL: end of function
# The counts hold calls, whose moves follow the calling convention: not for Windows.
# X64: instructions: 13, patchpoints: 6, rare instructions: 5
# ARM64: instructions: 17, patchpoints: 6, rare instructions: 6
