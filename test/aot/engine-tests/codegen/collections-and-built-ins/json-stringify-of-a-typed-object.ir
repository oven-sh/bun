# type Point = { x: number; y: number };
# function write(point: Point): string {
#   return JSON.stringify(point);
# }
# declare const input: any;
# (globalThis as any).answer = write({ x: +input, y: +input });
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 not-windows unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 not-windows unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=54 kind=Parameter function=f1
typesite w1 module=m0 position=39 kind=Result
typesite w2 module=m0 position=167 kind=CallResult
typesite w3 module=m0 position=87 kind=CallResult
layout L0 name="Point" module=m0 position=5 fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Convert v9 declared={type=number}
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="input" [isFreeName]
    v13 = Convert v12 declared={type=number flags=[IsExpected]}
    v14 = ToNumber v13
    v15 = Convert v14 declared={type=number}
    v16 = NewObject -, v10, v15 layout=L0 fields=[0, 1]
    v17 = FinishObject v16
    v18 = Call v1, -, v17 calleeName="write"
    v19 = Convert v18 declared={type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]}
    PropSet v5, v19 key="answer"
    v21 = Undefined
    Return v21
}
function f1 name="write" module=m0 position=39 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = Builtin builtin=JSON
    v2 = PropGet v1 key="stringify"
    v3 = Convert v2 declared={type=builtin(JSONStringify) flags=[IsExpected]}
    v4 = Call v3, v1, v0 calleeKey="stringify" calleeName="JSON.stringify"
    ReturnCall v4 casts=[{declared={type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]}}, {declared={type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}}]
}

# One JSON.stringify outside a loop calls the built-in itself, as native code is called. Three calls: one fetches its function object, one fetches JSON, the receiver, and the third is the call, with the object and undefined for the replacer.
# CHECK-LABEL: name="write" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[function]] = Patchpoint(resultConstraints = Register({{*}}), pureFunction = {{*}}:CallBuiltin)
# CHECK-NEXT: Int64 b@[[receiver]] = Patchpoint(resultConstraints = Register({{*}}), pureFunction = {{*}}:CallBuiltin)
# CHECK-NEXT: Int64 b@[[point]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[undefined]] = Const64(10, {{*}}:Undefined)
# CHECK-NEXT: Int64 b@[[text]] = Patchpoint(b@[[function]]:Register({{*}}), b@[[receiver]]:Register({{*}}), b@[[point]]:Register({{*}}), $10(b@[[undefined]]):Register({{*}}), resultConstraints = Register({{*}}), ExitsSideways{{*}}:CallBuiltin)
# Nothing tests which function the member holds, and the result is handed on as it is.
# CHECK-NEXT: Return(b@[[text]], Terminal)
# CHECK-LABEL: end of function
# The counts hold calls, whose moves follow the calling convention: not for Windows.
# X64: instructions: 5, patchpoints: 3
# ARM64: instructions: 8, patchpoints: 3
