# function elapsed(start: number): number {
#   return performance.now() - start;
# }
# declare const input: any;
# (globalThis as any).answer = elapsed(+input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 not-windows unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 not-windows unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=17 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=135 kind=CallResult
typesite w3 module=m0 position=51 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Call v1, -, v9 calleeName="elapsed"
    v11 = Convert v10 declared={type=number site=w2}
    PropSet v5, v11 key="answer"
    v13 = Undefined
    Return v13
}
function f1 name="elapsed" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="performance" [isFreeName]
    v3 = Convert v2 declared={type=builtin(GlobalThis_performance) flags=[IsExpected]}
    v4 = PropGet v3 key="now"
    v5 = Convert v4 declared={type=builtin(PerformanceNow) flags=[IsExpected]}
    v6 = Call v5, v3 calleeKey="now" calleeName="performance.now"
    v7 = Convert v6 declared={type=number site=w3} illTypedCause=DeclarationWithoutBody
    v8 = Sub v7, v0
    v9 = Convert v8 declared={type=number site=w1}
    Return v9
}

# performance.now calls the built-in itself, as native code is called. Three calls: one fetches its function object, one fetches performance, the receiver, and the third is the call.
# CHECK-LABEL: name="elapsed" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[function]] = Patchpoint(resultConstraints = Register({{*}}), pureFunction = {{*}}:CallBuiltin)
# CHECK-NEXT: Int64 b@[[receiver]] = Patchpoint(resultConstraints = Register({{*}}), pureFunction = {{*}}:CallBuiltin)
# CHECK-NEXT: Int64 b@[[now]] = Patchpoint(b@[[function]]:Register({{*}}), b@[[receiver]]:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent|Writes:{{*}}|Reads:ExternalState, {{*}}:CallBuiltin)
# The call cannot throw. The time comes back boxed: one test tells an integer from a double, and each takes one conversion.
# CHECK: Int32 b@[[isInteger]] = AboveEqual(b@[[now]], b@{{*}}, {{*}}:Sub)
# CHECK-NEXT: Branch(b@[[isInteger]], Terminal, {{*}}:Sub)
# CHECK: Double b@{{*}} = IToD(b@{{*}}, {{*}}:Sub)
# CHECK: Double b@[[elapsed]] = Sub(b@{{*}}, b@{{*}}, {{*}}:Sub)
# CHECK-NEXT: Return(b@[[elapsed]], Terminal)
# CHECK-NOT: ExitsSideways
# CHECK-LABEL: end of function
# The counts hold calls, whose moves follow the calling convention: not for Windows.
# X64: instructions: 12, patchpoints: 3
# ARM64: instructions: 14, patchpoints: 3
