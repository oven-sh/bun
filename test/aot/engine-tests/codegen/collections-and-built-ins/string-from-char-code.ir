  b4():
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="globalThis" [isFreeName]
    v13 = Convert v12 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v14 = Convert v13 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v15 = Builtin builtin=GlobalThis
    v16 = PropGet v15 key="input" [isFreeName]
    v17 = Convert v16 declared={type=i32 flags=[IsExpected]}
    v18 = Integer
    v19 = BitOr v17, v18
    v20 = Call v1, -, v19 calleeName="letter"
    v21 = Convert v20 declared={type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]}
    PropSet v14, v21 key="answer"
    Jump -> next b5()
  b5():
    v23 = Increment v10
    v24 = Convert v23 declared={type=number site=w2}
    Jump -> next b2(v24)
  b6(v25):
