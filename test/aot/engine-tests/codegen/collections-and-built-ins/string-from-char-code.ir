# function letter(code: number): string {
#   return String.fromCharCode(code & 127);
# }
# declare const input: any;
# (globalThis as any).answer = letter(input | 0);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=16 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=139 kind=CallResult
typesite w3 module=m0 position=49 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=i32 flags=[IsExpected]}
    v9 = Integer
    v10 = BitOr v8, v9
    v11 = Call v1, -, v10 calleeName="letter"
    v12 = Convert v11 declared={type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]}
    PropSet v5, v12 key="answer"
    v14 = Undefined
    Return v14
}
function f1 name="letter" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Builtin builtin=String
    v2 = Builtin builtin=StringFromCharCode
    v3 = Integer integer=127
    v4 = BitAnd v0, v3
    v5 = Call v2, v1, v4 calleeName="String.fromCharCode"
    ReturnCall v5 casts=[{declared={type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]}}, {declared={type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}}]
}

# String.fromCharCode of a code below 256 is a load from the table of one-character strings. The mask proves the bound, so there is no test, no call and no allocation.
# CHECK-LABEL: name="letter" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Int32 b@[[code]] = BitAnd(b@{{*}}, $127(b@{{*}}), {{*}}:BitAnd)
# CHECK: Int64 b@[[table]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|ReadsImmutable|Reads:AOTInstance_fixedFields, {{*}}:CallInline)
# CHECK: Int64 b@[[index]] = ZExt32(b@[[code]], {{*}}:CallInline)
# CHECK: Int64 b@[[offset]] = Shl(b@[[index]], $3(b@{{*}}), {{*}}:CallInline)
# CHECK: Int64 b@[[place]] = Add(b@[[offset]], b@[[table]], {{*}}:CallInline)
# CHECK-NEXT: Int64 b@[[letter]] = Load(b@[[place]], ControlDependent|ReadsImmutable|Reads:singleCharacterStrings, {{*}}:CallInline)
# CHECK-NEXT: Return(b@[[letter]], Terminal)
# CHECK-LABEL: end of function
# X64: instructions: 4, patchpoints: 0
# ARM64: instructions: 4, patchpoints: 0
