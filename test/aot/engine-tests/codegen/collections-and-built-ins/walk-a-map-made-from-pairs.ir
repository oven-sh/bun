# -- source: walk-a-map-made-from-pairs.ts
# // A Map made from a list of pairs has number keys, and its type also lists the pairs themselves. The walk reads wide keys in line: no step calls the stub.
# function sumOfKeys(map: Map<number, number>): number {
#   let total = 0;
#   for (const key of map.keys()) total += key;
#   return total;
# }
# declare const input: any;
# const map: Map<number, number> = new Map([+input, +input].map((x, j): [number, number] => [j, x]));
# (globalThis as any).answer = sumOfKeys(map);
# -- end of source
