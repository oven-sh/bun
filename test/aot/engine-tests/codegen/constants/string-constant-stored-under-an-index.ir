# function fill(list) { list[0] = "a text of the program"; list[1] = "another text of the program"; }
# fill(input);
# FORM: AsRead
# OPTIONS: disable=pass:InlineCalls
# RUN: generate-code calls
# REQUIRES: unsanitized-code
# A text that is stored under an index is a value and no key, so it need not be an atom: the stub that makes a new string creates it at its first use.
# CHECK-LABEL: f1: size=
# CHECK-NOT: stub CreateConstant.String
# CHECK: stub CreateConstant.NewString x2
# CHECK-NOT: stub CreateConstant.String

module m0 path="main.js" displayPath="main.js" flags=[KeepsError] body=f0 namespaceLayout=L(m0)
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="input" [isFreeName]
    v4 = Call v1, -, v3 calleeName="fill"
    v5 = Undefined
    Return v5
}
function f1 name="fill" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|Array<undefined|null|string> flags=[IsExpected]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|Array<undefined|null|string>):
    Jump -> next b1()
  b1():
    v1 = Integer
    v2 = String string="a text of the program"
    ElemSet v0, v1, v2
    v4 = Integer integer=1
    v5 = String string="another text of the program"
    ElemSet v0, v4, v5
    v7 = Undefined
    Return v7
}
