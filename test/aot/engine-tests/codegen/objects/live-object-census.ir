# Known numbers of objects, arrays, maps and closures are alive when the program exits, and 100,000 more objects are garbage by then. object-census.test.ts runs it with BUN_JSC_dumpAOTObjectCensusAtExit=1 and looks for those numbers in the census. The output is that of plain Bun.
# FORM: AsRead
# RUN: lower-to-b3 optimized f0
# REQUIRES: x86_64 unsanitized-code not-windows faulting-loop-polls

module m0 path="live-object-census.ts" displayPath="live-object-census.ts" body=f0 namespaceLayout=L(m0)
entry module=m0
layout L0 kind=Instance name="Point" module=m0 position=288 constructor=f1 fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Convert v2 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v4 = Integer
    v5 = Convert v4 declared={type=number}
    Jump -> next b1(v5)
  b1(v6: number):
    LoopHint
    v8 = Integer integer=-2
    v9 = Mul v8, v6
    v10 = Construct v3, -, v6, v9 calleeName="Point"
    v11 = Increment v6
    v12 = Convert v11 declared={type=number}
    Jump -> next b1(v12)
}
function f1 name="Point" module=m0 position=335 kind=BaseConstructor flags=[HasNewTarget, IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=number}, {type=number}] results=[{type=object flags=[IsFromCompiler]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] constructedClass=L0
