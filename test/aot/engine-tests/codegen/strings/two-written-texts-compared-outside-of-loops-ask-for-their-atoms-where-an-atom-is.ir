# const verbs = ["GET", "POST", "PUT", "GET"];
# function turn(i) {
#   const verb = verbs[i & 3];
#   return verb === "GET" ? 1 : verb === "POST" ? 2 : 3;
# }
# let answer = 0;
# for (let t = 0; t < turns; t++) for (let i = 0; i < 1024; i++) answer += turn(i);
# turn() by itself has no loop. Where the atom of a text lies is of use to a subject that holds an atom, so that arm makes the address, once for each text.
