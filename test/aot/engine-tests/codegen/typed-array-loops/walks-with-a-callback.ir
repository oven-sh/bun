# -- source: walks-with-a-callback.ts
# // forEach, every, some, find, findIndex, findLast, findLastIndex, reduce and reduceRight of a typed array whose class is known: each is a loop over the elements with the callback inlined, and nothing is called.
# function sum(list: Int32Array): number {
#   let total = 0;
#   list.forEach(x => {
#     total += x;
#   });
#   return total;
# }
# function allPositive(list: Float64Array): boolean {
#   return list.every(x => x > 0);
# }
# function anyNegative(list: Float64Array): boolean {
#   return list.some(x => x < 0);
# }
# function firstAbove(list: Uint8Array, least: number): number | undefined {
#   return list.find(x => x > least);
# }
# function indexAbove(list: Uint8Array, least: number): number {
#   return list.findIndex(x => x > least);
# }
# function lastAbove(list: Uint8Array, least: number): number | undefined {
#   return list.findLast(x => x > least);
# }
# function lastIndexAbove(list: Uint8Array, least: number): number {
#   return list.findLastIndex(x => x > least);
# }
# function folded(list: Int32Array): number {
#   return list.reduce((a, b) => a + b, 0);
# }
# function foldedFromTheEnd(list: Int32Array): number {
#   return list.reduceRight((a, b) => a + b, 0);
# }
# declare const input: any;
# const ints = new Int32Array(+input);
# const floats = new Float64Array(+input);
# const bytes = new Uint8Array(+input);
# console.log(sum(ints), allPositive(floats), anyNegative(floats), firstAbove(bytes, 1), indexAbove(bytes, 1), lastAbove(bytes, 1), lastIndexAbove(bytes, 1), folded(ints), foldedFromTheEnd(ints));
# -- end of source
