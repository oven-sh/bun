# function turn(i: number): number {
#   const n = (i & 255) + 2;
#   for (let d = 2; d * d <= n; d++) if (n % d === 0) return 0;
#   return 1;
# }
# declare const input: any;
# (globalThis as any).answer = turn(+input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: pipeline RemoveRedundantBarriers
# RUN(X64): lower-to-air loops f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air loops f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = ToNumber v6
    v8 = Call v1, -, v7 calleeName="turn"
    v9 = Convert v8 declared={type=number flags=[IsExpected]}
    PropSet v4, v9 key="answer"
    v11 = Undefined
    Return v11
}
function f1 name="turn" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=number}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Integer integer=255
    v2 = BitAnd v0, v1
    v3 = Integer integer=2
    v4 = Add v2, v3
    v5 = Convert v4 declared={type=number}
    v6 = Integer integer=2
    v7 = Convert v6 declared={type=number}
    Jump -> next b2(v7)
  b2(v8: number):
    LoopHint
    v10 = Mul v8, v8
    v11 = LessEq v10, v5
    Branch v11 -> taken b3(| 1), notTaken b8(| 1)
  b3(v12):
    Jump -> next b4()
  b4():
    v13 = Mod v12, v8
    v14 = Integer
    v15 = StrictEq v13, v14
    Branch v15 -> taken b5(), notTaken b6()
  b5():
    v16 = Integer
    v17 = Convert v16 declared={type=number}
    Return v17
  b6():
    Jump -> next b7()
  b7():
    v18 = Increment v8
    v19 = Convert v18 declared={type=number}
    Jump -> next b2(v19)
  b8(v20):
    Jump -> next b9()
  b9():
    v21 = Integer integer=1
    v22 = Convert v21 declared={type=number}
    Return v22
}

# No test bounds `d`, so nothing proves it an integer. It starts as an int32, goes up by one and divides an integer: it is expected to stay an int32 and is tested behind its step, and the remainder is one of integers.
# CHECK-LABEL: name="turn"
# CHECK: [[divisor]]: int[2, 2147483647] @Int32
# CHECK: = Mod v{{*}}, [[divisor]] form=Integers
# CHECK: = Increment [[divisor]] form=Integers
# What has left int32 goes on as a number, in a copy of the loop.
# CHECK: frequency=Rare:
# CHECK: = Mod v{{*}}, v{{*}} form=Numbers
# X64: loop #{{*}}, instructions: 11, patchpoints: 1, polls: 1
# ARM64: loop #{{*}}, instructions: 10, patchpoints: 1, polls: 1
