# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized loops f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air loops f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air loops f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = Call v1, -, v6 calleeName="indexOfComma"
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    PropSet v4, v8 key="answer"
    v10 = Undefined
    Return v10
}
function f1 name="indexOfComma" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=number flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    v1 = Integer
    v2 = Convert v1 declared={type=number flags=[IsExpected]}
    Jump -> next b2(v2)
  b2(v3):
    LoopHint
    v5 = PropGet v0 key="length"
    v6 = Convert v5 declared={type=number flags=[IsExpected]}
    v7 = Less v3, v6
    Branch v7 -> taken b3(| 0), notTaken b7(| 0)
  b3(v8):
    Jump -> next b4()
  b4():
    v9 = PropGet v0 key="charCodeAt"
    v10 = Convert v9 declared={type=undefined|null|function flags=[IsExpected]}
    v11 = Call v10, v0, v8 calleeKey="charCodeAt" calleeName="text.charCodeAt"
    v12 = Integer integer=44
    v13 = StrictEq v11, v12
    Branch v13 -> taken b5(), notTaken b6()
  b5():
    v14 = Convert v8 declared={type=number flags=[IsExpected]}
    Return v14
  b6():
    v15 = Increment v8
    v16 = Convert v15 declared={type=number flags=[IsExpected]}
    Jump -> next b2(v16)
  b7(v17):
    Jump -> next b8()
  b8():
    v18 = Integer integer=-1
    v19 = Convert v18 declared={type=number flags=[IsExpected]}
    Return v19
}

# As soon as `text` is seen to be a text, an inner loop reads its bytes in line. A counter under the length of a text is an int32 one step on, so the step is not tested, the turns can be counted, and eight are written out.
# CHECK-LABEL: steps by 8
# CHECK-NOT: :TypeTest)
# CHECK-NOT: isLoopPoll
# CHECK-LABEL: end of loop
# CHECK-LABEL: steps by 1
# CHECK-NOT: :TypeTest)
# CHECK-NOT: isLoopPoll
# CHECK-LABEL: end of loop
# X64: loop #{{*}}, instructions: 3, patchpoints: 1, {{*}} steps by 1
# X64: loop #{{*}}, instructions: 10, patchpoints: 8, {{*}} steps by 8
# ARM64: loop #{{*}}, instructions: 4, patchpoints: 1, {{*}} steps by 1
# ARM64: loop #{{*}}, instructions: 19, patchpoints: 8, {{*}} steps by 8
