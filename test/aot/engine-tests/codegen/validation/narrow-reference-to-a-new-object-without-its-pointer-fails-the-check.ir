# drop-guard=NewObject:0 leaves out, in every function, the first pointer beside a narrow reference that a NewObject defines. The check of references fails the build
# FORM: AsRead
# OPTIONS: references=narrow check=validate-reference-guards drop-guard=NewObject:0
# RUN: compile
# DIAGNOSTIC: NarrowReferenceWithoutPointer
# CHECK: image empty
# PROGRAM-OF: narrow-reference-to-a-new-object-has-a-pointer.ir
