# import vm from "node:vm"; vm.run("1");        node:vm: const { Script } = <the native binding>; export default { run: text => new Script(text) };
# The look goes from a native binding to the one object that its rows answer, so the read finds %NodeVMBinding%.Script, which evaluates text, and the store lets it go: whoever reaches the body of node:vm admits text.
# If the binding answered nothing that anybody follows, Script would have no use at all, and node:vm would run only in a program that is open for another reason
# OPTIONS: exclude=CodeOutsideImage
# RUN: image
# CHECK: flags {{*}}AdmitsUnknownJavaScript

layout L0 module=m1 fields=[{key="run" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}] namespaceLayout=L(m0)
module m1 path="node:vm" displayPath="node:vm" kind=RuntimeSource flags=[IsLoadedByImportOnly] exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeVm body=f1
entry module=m0
variable g0 name="Script" module=m1 declared={type=anything} initialization=Undefined
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = Builtin builtin=NodeVm
    v1 = PropGet v0 key="run"
    v2 = String string="1"
    v3 = Call v1, -, v2
    Return v3
}
function f1 module=m1 kind=Module role=Library thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame] {
  b0():
    v0 = NativeBinding builtin=NativeCppNodeVMCppBunCreateNodeVMBinding
    v1 = PropGet v0 key="Script"
    PutModuleVariable v1 variable=g0
    v3 = NewClosure function=f2
    v4 = NewObject -, v3 layout=L0 fields=[0]
    Return v4
}
function f2 name="run" module=m1 kind=Arrow role=Library length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Construct v1, -, v0
    Return v2
}
