# Every program has an async function, and the library reads `constructor` off values that nobody knows. Such a value may be the closure, above which %AsyncFunction%.prototype stands.
# If the name found %AsyncFunction% there, every such program would count as one that evaluates text: its image would admit code that nobody has read, and nothing could be trimmed
# import "node:vm"; take(async () => {});        node:vm: export default handed.constructor;
# A name that the text of the library alone spells finds no function whose call is an event: what the library does with what it names is the library's matter, and the run time refuses the text of whoever comes by an evaluator on that road.
# OPTIONS: exclude=CodeOutsideImage
# RUN: image
# CHECK: flags
# CHECK-NOT: AdmitsUnknownJavaScript
# RUN(CLOSED): image mechanisms=none
# CLOSED: flags
# CLOSED-NOT: AdmitsUnknownJavaScript

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}] namespaceLayout=L(m0)
module m1 path="node:vm" displayPath="node:vm" kind=RuntimeSource flags=[IsLoadedByImportOnly] exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeVm body=f1
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = NewClosure function=f2
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="take" [isFreeName]
    v3 = Call v2, -, v0
    Return v3
}
function f1 module=m1 kind=Module role=Library thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="handed" [isFreeName]
    v2 = PropGet v1 key="constructor"
    Return v2
}
function f2 module=m0 kind=Arrow flags=[IsAsync] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned] {
  b0():
    v0 = Undefined
    Return v0
}
