module m1 path="bun:jsc" displayPath="bun:jsc" kind=Runtime flags=[RejectsRequireCacheOverride] exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=BunJsc syntheticExports=[{name="heapSize" variable=g0 isKnownMember=true}]
entry module=m0
variable g0 name="heapSize" module=m1 declared={type=anything}
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="heapSize"
    v2 = Call v1 calleeName="heapSize"
    v3 = Undefined
    Return v3
}
