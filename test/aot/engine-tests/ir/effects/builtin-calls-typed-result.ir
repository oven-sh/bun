# CHECK-NEXT: v2 CallBuiltin: reads(ObjectFields, ShapeWords, OrderWords, NamedProperties, Elements, ArrayStorage, StringStorage, AllocatorState, RuntimeState) writes(StringStorage, AllocatorState, RuntimeState) throws collects
# CHECK-NEXT: v3 CallBuiltin: reads(ObjectFields, ShapeWords, OrderWords, NamedProperties, Elements, ArrayStorage, StringStorage, AllocatorState, RuntimeState) writes(StringStorage, AllocatorState, RuntimeState) throws collects
# CHECK-NEXT: v4 CallBuiltin: {{*}}throws{{*}}callsUnknownCode

function f3 name="helper" role=OutlinedBody parameters=[{type=undefined}, {type=string}, {type=object}] results=[{type=undefined}] {
  b0(v0: undefined, v1: string, v2: object):
    v3 = CallBuiltin -, v0, v1 overload=CompilerHelpersValidateByPlan/0
    v4 = CallBuiltin -, v2, v1 overload=CompilerHelpersValidateByPlan/0
