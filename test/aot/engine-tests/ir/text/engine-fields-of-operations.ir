# Every payload field, operand and flag that only the engine has on an operation or terminator of the wire, shown on the first use of each
# RUN: round-trip
# CHECK: typesite w0 module=m0 position=1 kind=Assertion
# CHECK-NEXT: expectedresult x0 type=anything
# CHECK-NEXT: layout L0 fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
# CHECK-NEXT: layout L1 kind=Instance name="Derived" module=m0 position=10 constructor=f3 fields=[{key=#"p"@L1 declared={type=anything} flags=[IsPrivate]}, {key=#"q"@L1 declared={type=anything} flags=[IsPrivate]}] flags=[HasHeritage]
