# Bun.spawn(["true"], { stdout: "ignore" })
# A child has a channel where `ipc` of the options is a function: the four functions of the library that serve the channel hang on Bun.spawn under the condition that an operand has that property.
# The options are a literal that is made for the call: nobody else has held it, so it has what is written in it. Its layout comes from the declared type and lists `ipc` all the same.
# If Link took the condition for one that may hold, every program that starts a child would hold the channel, and with it node:net and node:dgram.
# The controls stand beside this file: a-child-started-with-*.ir.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f1 unreached
# CHECK: function f2 unreached
# CHECK: function f3 unreached
# CHECK: function f4 unreached

layout L0 fields=[{key="ipc" declared={type=anything} flags=[IsNeverWritten]}, {key="stdout" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/Ipc.ts" displayPath="/$bun/js/builtins/Ipc.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=IpcParseHandle function=f1
runtimefunction id=IpcRestoreAdvancedBuffers function=f2
runtimefunction id=IpcSerialize function=f3
runtimefunction id=IpcTagAdvancedBuffers function=f4
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Bun
    v1 = PropGet v0 key="spawn"
    v2 = Convert v1 declared={type=builtin(BunSpawn) flags=[IsExpected]}
    v3 = String string="true"
    v4 = NewArray v3 contents=anything
    v5 = NewObject layout=L0
    v6 = String string="ignore"
    PropDefine v5, v6 key="stdout"
    v8 = FinishObject v5
    v9 = Call v2, v0, v4, v8 calleeKey="spawn" calleeName="Bun.spawn"
    v10 = Undefined
    Return v10
}
function f1 name="parseHandle" module=m1 kind=Method role=Library flags=[HasExplicitName] length=3 enclosingRuntimeFunction=IpcParseHandle thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    Return v0
}
function f2 name="restoreAdvancedBuffers" module=m1 kind=Method role=Library flags=[HasExplicitName] length=3 enclosingRuntimeFunction=IpcRestoreAdvancedBuffers thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    Return v0
}
function f3 name="serialize" module=m1 kind=Method role=Library flags=[HasExplicitName] length=3 enclosingRuntimeFunction=IpcSerialize thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    Return v0
}
function f4 name="tagAdvancedBuffers" module=m1 kind=Method role=Library flags=[HasExplicitName] length=3 enclosingRuntimeFunction=IpcTagAdvancedBuffers thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    Return v0
}
