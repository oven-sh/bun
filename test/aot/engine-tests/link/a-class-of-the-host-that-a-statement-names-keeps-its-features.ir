# new WebSocket("ws://localhost:1"); Bun.Glob.prototype.match
# A control of a-member-of-a-class-of-the-host-that-nobody-makes-keeps-none-of-the-features-of-the-class.ir: whoever names the class needs no instance to come to its members.
# RUN: features
# CHECK: by BunGlob

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="WebSocket" [isFreeName]
    v2 = String string="ws://localhost:1"
    v3 = Construct v1, -, v2
    v4 = Builtin builtin=Bun
    v5 = PropGet v4 key="Glob"
    v6 = PropGet v5 key="prototype"
    v7 = PropGet v6 key="match"
    Return v7
}
