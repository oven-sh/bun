# export const start = Bun.serve;
# Whoever has the namespace object of the file reads the variable without an operation that names it, so the look cannot follow every read: the store lets the function go, as it did.
# OPTIONS: exclude=CodeOutsideImage
# RUN: causes mechanisms=all
# CHECK: cause RunsUnseenCode BunServe
# CHECK: unseen-code can-run

variable g0 name="start" module=m0 declared={type=anything} flags=[IsImmutable]
module m0 path="main.mjs" displayPath="main.mjs" body=f0 exports=[{name="start" variable=g0}]
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Bun
    v1 = PropGet v0 key="serve"
    PutModuleVariable v1 variable=g0
    v3 = Undefined
    Return v3
}
