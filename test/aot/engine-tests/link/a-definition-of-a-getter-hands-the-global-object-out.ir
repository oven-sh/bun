# Object.defineProperty(globalThis, "whole", { get() { return this } })
# A control of a-copy-of-constant-data-onto-the-global-object-hands-nothing-out.ir: whoever reads the name runs the getter on the global object.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 unreached

layout L0 fields=[{key="get" declared={type=anything}}, {key="set" declared={type=anything} flags=[IsNeverWritten]}, {key="value" declared={type=anything} flags=[IsNeverWritten]}]
module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/stdio.ts" displayPath="/$bun/js/builtins/stdio.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=StdioGetLightStdioWriteStreams function=f1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = Builtin builtin=Object
    v2 = PropGet v1 key="defineProperty"
    v3 = Convert v2 declared={type=builtin(ObjectDefineProperty) flags=[IsExpected]}
    v4 = String string="whole"
    v5 = NewObject layout=L0
    v6 = NewClosure function=f2
    PropDefine v5, v6 key="get"
    v8 = FinishObject v5
    v9 = Call v3, v1, v0, v4, v8 calleeKey="defineProperty" calleeName="Object.defineProperty"
    v10 = Undefined
    Return v10
}
function f1 name="getLightStdioWriteStreams" module=m1 kind=Method role=Library flags=[HasExplicitName] length=7 enclosingRuntimeFunction=StdioGetLightStdioWriteStreams thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything, v6: anything):
    Return v0
}
function f2 module=m0 kind=Method thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
