# Object.defineProperty(globalThis, "whole", { get() {} }), as the front end writes it
# A control of a-definition-by-constant-data-on-the-global-object-hands-nothing-out.ir: whoever reads the name runs the getter on the global object.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 unreached

layout L0 fields=[{key="get" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/stdio.ts" displayPath="/$bun/js/builtins/stdio.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=StdioGetLightStdioWriteStreams function=f1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = Builtin builtin=Object
    v2 = Builtin builtin=ObjectDefineProperty
    v3 = String string="whole"
    v4 = NewObject layout=L0
    v5 = NewClosure function=f2
    PropDefine v4, v5 key="get"
    v7 = FinishObject v4
    v8 = Call v2, v1, v0, v3, v7 calleeName="Object.defineProperty"
    v9 = Undefined
    Return v9
}
function f1 name="getLightStdioWriteStreams" module=m1 kind=Method role=Library flags=[HasExplicitName] length=7 enclosingRuntimeFunction=StdioGetLightStdioWriteStreams thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything, v6: anything):
    Return v0
}
function f2 module=m0 kind=Method thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
