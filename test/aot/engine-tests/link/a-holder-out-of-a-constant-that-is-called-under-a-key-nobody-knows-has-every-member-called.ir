# const bun = Bun;  function call(name) { return bun[name](); }  call(process.argv[2]);
# The constant is Bun in the other body too, so the look at that body sees what is done to it there: a member under a key that nobody knows is read and called: Bun.build, Bun.plugin, any of them: code from outside the
# executable can run. To leave the store alone and follow nothing at the read would close the report of this program: Link follows the variable, and says less of such a call than the look does.
# OPTIONS: exclude=CodeOutsideImage
# RUN: causes mechanisms=all
# CHECK: unseen-code can-run

variable g0 name="bun" module=m0 declared={type=anything} flags=[IsImmutable]
module m0 path="main.mjs" displayPath="main.mjs" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Bun
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f1
    v3 = Builtin builtin=Process
    v4 = PropGet v3 key="argv"
    v5 = Integer integer=2
    v6 = ElemGet v4, v5
    v7 = Call v2, -, v6 calleeName="call"
    v8 = Undefined
    Return v8
}
function f1 name="call" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = CheckInitialized v1 name="bun"
    v3 = ElemGet v2, v0
    v4 = Call v3, v2
    Return v4
}
