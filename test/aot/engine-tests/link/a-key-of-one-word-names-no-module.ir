# const load = [require][index]; const wanted = { sqlite: 1 }; load(wanted);
# A key of one word is a field of the program's own: path, url, http, buffer, events. It names no module, though a module goes by that word.
# The other side: a-module-whose-name-is-a-key-of-a-literal-is-named-for-a-loader-that-nobody-follows.ir.
# OPTIONS: exclude=CodeOutsideImage,FeaturesNamedAtRunTime
# RUN: features
# CHECK-NOT: by NodeSqlite named

layout L0 module=m0 fields=[{key="sqlite" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs body=f0
module m1 path="node:sqlite" displayPath="node:sqlite" kind=Runtime exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeSqlite
entry module=m0
function f0 module=m0 kind=CommonJsModule flags=[IsSloppy] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = ModuleBuiltin builtin=ModuleRequire module=m0
    v1 = NewArray v0 contents=anything
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="index" [isFreeName]
    v4 = ElemGet v1, v3
    v5 = Integer integer=1
    v6 = NewObject -, v5 layout=L0 fields=[0]
    v7 = Call v4, -, v6 calleeName="load"
    Return v7
}
