# const load = [require][index]; const wanted = { "bun:jsc": 1 }; Object.keys(wanted).map(load);
# The key of a literal comes back as a text: Object.keys(), a loop over the object, JSON.stringify(). A key of more than one word that is the name of a module is heard as a text of that name is.
# Names from run time are held back here, as under --trim. Without the rule the module was never heard of, and a trimmed executable said MODULE_NOT_FOUND.
# The control: a-key-of-one-word-names-no-module.ir.
# OPTIONS: exclude=CodeOutsideImage,FeaturesNamedAtRunTime
# RUN: features
# CHECK: by BunJsc named
# CHECK: by BunJscHeapSize named

layout L0 module=m0 fields=[{key="bun:jsc" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs body=f0
module m1 path="bun:jsc" displayPath="bun:jsc" kind=Runtime exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=BunJsc
entry module=m0
function f0 module=m0 kind=CommonJsModule flags=[IsSloppy] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = ModuleBuiltin builtin=ModuleRequire module=m0
    v1 = NewArray v0 contents=anything
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="index" [isFreeName]
    v4 = ElemGet v1, v3
    v5 = Integer integer=1
    v6 = NewObject -, v5 layout=L0 fields=[0]
    v7 = Call v4, -, v6 calleeName="load"
    Return v7
}
