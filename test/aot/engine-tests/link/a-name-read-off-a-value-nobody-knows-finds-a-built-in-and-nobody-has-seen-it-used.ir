# const maker = JSON.parse("null"); maker(Bun); maker.build();
# Bun is let go, and `build` is read off a value nobody knows: it may be Bun.build, and nobody has seen that it is.
# RUN: features
# CHECK: feature Interpreter by BunBuild found-by-name at f0
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=JSON
    v1 = PropGet v0 key="parse"
    v2 = String string="null"
    v3 = Call v1, v0, v2 calleeKey="parse"
    v4 = Builtin builtin=Bun
    v5 = Call v3, -, v4
    v6 = PropGet v3 key="build"
    v7 = Call v6, v3 calleeKey="build"
    Return v7
}
