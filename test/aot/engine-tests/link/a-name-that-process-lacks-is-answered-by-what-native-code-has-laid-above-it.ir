# node:events hands native code the object that goes above the native prototype of `process`. A name that neither `process` nor that native prototype has is looked for there,
# and an accessor that a program has laid there gets `process` as `this`: `process` is out of sight from the read on. So it is with a store, which finds a setter.
#   makeProcessInheritFrom({});  process.madeUp;
# LIBRARY: own
# RUN: link lookups mechanisms=all
# CHECK: lookup let-go Process
# CHECK: lookup at-unseen Process

layout L0 module=m1 fields=[]
module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="node:events" displayPath="node:events" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeEvents body=f1
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = RequireModule module=m1 referrer=m0 specifier="node:events"
    v1 = Builtin builtin=Process
    v2 = PropGet v1 key="madeUp"
    v3 = Undefined
    Return v3
}
function f1 module=m1 kind=Module role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0 fields=[]
    v1 = NativeBinding builtin=NativeNewCppFunctionBunProcessCppJsFunctionMakeProcessInheritFrom
    v2 = Call v1, -, v0 calleeName="makeProcessInheritFrom"
    v3 = Undefined
    Return v3
}
