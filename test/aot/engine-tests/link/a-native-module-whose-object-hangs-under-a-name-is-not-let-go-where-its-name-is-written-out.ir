# const load = [require][index]; load("bun");
# The module answers with the object that hangs under the name Bun of the global object. Its members count as used where the program names them, whichever way it came by the object, so the written name of the module lets none of them go.
# OPTIONS: exclude=CodeOutsideImage,FeaturesNamedAtRunTime
# RUN: features
# CHECK-NOT: by BunBuild unnamed

module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs body=f0
module m1 path="bun" displayPath="bun" kind=Runtime exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=Bun
entry module=m0
function f0 module=m0 kind=CommonJsModule flags=[IsSloppy] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = ModuleBuiltin builtin=ModuleRequire module=m0
    v1 = NewArray v0 contents=anything
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="index" [isFreeName]
    v4 = ElemGet v1, v3
    v5 = String string="bun"
    v6 = Call v4, -, v5 calleeName="load"
    Return v6
}
