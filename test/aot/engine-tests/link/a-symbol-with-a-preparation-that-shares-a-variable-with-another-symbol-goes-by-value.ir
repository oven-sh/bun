# The other side of a-symbol-with-a-preparation-that-meets-another-symbol-at-a-key-goes-by-value.ir: the name is lost at a variable, ahead of the key.
#   const kHeaders = Symbol("kHeaders"), kOther = Symbol("kOther"), kLenient = Symbol("kLenient");
#   prepareHoldersBeforeLookupsUnder(kHeaders, prepare);  prepareHoldersBeforeLookupsUnder(kLenient, prepareOther);
#   let sometimes = kOther;  sometimes = kHeaders;  function look(o) { return o[sometimes]; }  look(o);
#   o[kHeaders];  o[kLenient]
# LIBRARY: own
# RUN: link accesses mechanisms=all
# STATISTIC: SymbolsWithPreparationThatGoByValue = 1
# CHECK-NOT: access f2
# CHECK-NOT: access f3
# CHECK: access f4 v2 under symbol("kLenient")@m1:2
# CHECK-NOT: access

layout L0 module=m1 fields=[{key=symbol("kHeaders")@m1:0 declared={type=anything}}, {key=symbol("kOther")@m1:1 declared={type=anything}}, {key=symbol("kLenient")@m1:2 declared={type=anything}}, {key="a" declared={type=anything}}]
variable g0 name="kHeaders" module=m1 declared={type=anything} flags=[IsImmutable]
variable g1 name="kLenient" module=m1 declared={type=anything} flags=[IsImmutable]
variable g2 name="sometimes" module=m1 declared={type=anything}
module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="node:http" displayPath="node:http" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeHttp body=f1
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = RequireModule module=m1 referrer=m0 specifier="node:http"
    v1 = Undefined
    Return v1
}
function f1 module=m1 kind=Module role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Symbol
    v1 = String string="kHeaders"
    v2 = Call v0, -, v1 calleeName="Symbol" callNumber=0
    PutModuleVariable v2 variable=g0
    v4 = String string="kOther"
    v5 = Call v0, -, v4 calleeName="Symbol" callNumber=1
    v6 = String string="kLenient"
    v7 = Call v0, -, v6 calleeName="Symbol" callNumber=2
    PutModuleVariable v7 variable=g1
    v9 = NativeBinding builtin=NativeNewCppFunctionBunCompiledModulesCppJsFunctionPrepareHoldersBeforeLookupsUnder
    v10 = NewClosure function=f5
    v11 = Call v9, -, v2, v10 calleeName="prepareHoldersBeforeLookupsUnder"
    v12 = NewClosure function=f6
    v13 = Call v9, -, v7, v12 calleeName="prepareHoldersBeforeLookupsUnder"
    v14 = NewObject layout=L0 fields=[]
    v15 = FinishObject v14
    PutModuleVariable v5 variable=g2
    PutModuleVariable v2 variable=g2
    v18 = NewClosure function=f2
    v19 = Call v18, -, v15
    v20 = NewClosure function=f3
    v21 = Call v20, -, v15
    v22 = NewClosure function=f4
    v23 = Call v22, -, v15
    v24 = Undefined
    Return v24
}
function f2 name="look" module=m1 role=Library length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g2
    v2 = ElemGet v0, v1
    Return v2
}
# REPEAT: function = 3..4 ; variable = 0..1
function f%(function) module=m1 role=Library length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g%(variable)
    v2 = ElemGet v0, v1
    Return v2
}
# END REPEAT
function f5 name="prepare" module=m1 role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f6 name="prepareOther" module=m1 role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
