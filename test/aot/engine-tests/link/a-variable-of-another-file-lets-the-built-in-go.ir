# No source gives this wire: the body of one file stores Bun.serve into a variable of another file that the wire calls immutable.
# That a variable is stored once is said of the body of its own file. A store from elsewhere lets the function go.
# OPTIONS: exclude=CodeOutsideImage
# RUN: causes mechanisms=all
# CHECK: cause RunsUnseenCode BunServe
# CHECK: unseen-code can-run

variable g0 name="serve" module=m1 declared={type=anything} flags=[IsImmutable]
module m0 path="main.mjs" displayPath="main.mjs" body=f0 requests=[{target=m1 completes=true}]
module m1 path="other.mjs" displayPath="other.mjs" body=f1
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Bun
    v1 = PropGet v0 key="serve"
    PutModuleVariable v1 variable=g0
    v3 = Undefined
    Return v3
}
function f1 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
