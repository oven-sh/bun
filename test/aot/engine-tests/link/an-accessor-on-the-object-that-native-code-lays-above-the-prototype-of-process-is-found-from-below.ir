  b0():
    v0 = NewClosure function=f2
    v1 = PropGet v0 key="prototype"
    v2 = NewClosure function=f3
    PropSet v1, v2 key="on"
    v4 = Integer integer=0
    PropSet v1, v4 key="_eventsCount"
    v6 = Builtin builtin=Object
    v7 = Builtin builtin=ObjectDefineProperties
    v8 = NewDictionary
    v9 = NewClosure function=f4
    v10 = NewObject -, v9 layout=L1 fields=[0]
    PropDefine v8, v10 key="noDeprecation"
    v12 = Call v7, v6, v1, v8 calleeName="Object.defineProperties"
    v13 = NativeBinding builtin=NativeNewCppFunctionBunProcessCppJsFunctionMakeProcessInheritFrom
    v14 = Call v13, -, v1 calleeName="makeProcessInheritFrom"
    v15 = Undefined
    Return v15
}
function f2 name="Bell" module=m1 role=Library flags=[HasThis, HasExplicitName] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] constructedClass=L0 {
  b0(v0: L0):
    v1 = Integer integer=0
