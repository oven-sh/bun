# An accessor that lies on the object under a name that the native prototype of `process` lacks is run by whoever asks `process` for that name, native code among them, with `process` as `this`.
#   function Bell() { this.rung = 0; }  Bell.prototype.on = function () { return 1; };  Bell.prototype._eventsCount = 0;  Object.defineProperties(Bell.prototype, { noDeprecation: { get() {} } });  makeProcessInheritFrom(Bell.prototype);
#   require("node:events");
