# Link keeps the names that lie on the prototype object of a constructor function one by one, and can say what a lookup from below finds there. Of any other object it does not say that: it leaves as every operand of native code does.
#   makeProcessInheritFrom({ on() {} });
#   require("node:events");
# LIBRARY: own
# RUN: link functions layouts mechanisms=all
# CHECK-NOT: function f4 unreached
# CHECK: layout L1 changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]

layout L0 kind=Instance name="Bell" module=m1 constructor=f2 fields=[{key="rung" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction]
layout L1 module=m1 fields=[{key="on" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="node:events" displayPath="node:events" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeEvents body=f1
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = RequireModule module=m1 referrer=m0 specifier="node:events"
    v1 = Undefined
    Return v1
}
function f1 module=m1 kind=Module role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = PropGet v0 key="prototype"
    v2 = NewClosure function=f3
    PropSet v1, v2 key="on"
    v4 = Integer integer=0
    PropSet v1, v4 key="_eventsCount"
    v6 = NewClosure function=f4
    v7 = NewObject -, v6 layout=L1 fields=[0]
    v8 = NativeBinding builtin=NativeNewCppFunctionBunProcessCppJsFunctionMakeProcessInheritFrom
    v9 = Call v8, -, v7 calleeName="makeProcessInheritFrom"
    v10 = Undefined
    Return v10
}
function f2 name="Bell" module=m1 role=Library flags=[HasThis, HasExplicitName] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] constructedClass=L0 {
  b0(v0: L0):
    v1 = Integer integer=0
    PropSet v0, v1 key="rung"
    v3 = Undefined
    Return v3
}
function f3 name="on" module=m1 role=Library flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    Return v1
}
function f4 module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
