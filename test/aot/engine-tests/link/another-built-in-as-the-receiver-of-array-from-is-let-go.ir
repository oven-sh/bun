# Array.from.call(Map, <a list that the program has just made>), as the front end writes it: the function called on `Map`
# The declared rows of Array.from speak of calls on `Array` alone. On another constructor the function constructs its receiver and fills what that makes: only the last row, which says nothing, stands
# for it. `Map` is let go with all that lies below it, and the function behind Map.groupBy is in the program.
# The other half: receiver-of-array-from-stays-in-sight-where-a-list-is-copied.ir.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 unreached
# CHECK-NOT: function f2 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/engine/ArrayConstructor.ts" displayPath="/$bun/js/engine/ArrayConstructor.ts" flags=[IsLibrary]
module m2 path="/$bun/js/engine/MapConstructor.ts" displayPath="/$bun/js/engine/MapConstructor.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=ArrayConstructorFrom function=f1
runtimefunction id=MapConstructorGroupBy function=f2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewArray contents=anything
    v1 = Builtin builtin=Map [isNotReadFromHolder]
    v2 = Builtin builtin=ArrayFrom [isNotReadFromHolder]
    v3 = Call v2, v1, v0
    Return v3
}
function f1 name="from" module=m1 kind=Method role=Library flags=[HasExplicitName] length=1 enclosingRuntimeFunction=ArrayConstructorFrom thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="groupBy" module=m2 kind=Method role=Library flags=[HasExplicitName] length=1 enclosingRuntimeFunction=MapConstructorGroupBy thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
