# console.log("ran"), built with --compile-exec-argv=--sql-preconnect
# With that option the host reads Bun.sql at its start and calls `connect` on it, natively, before the program begins. The text of the program names nothing of it. The front end lists the built-in
# (`usedatstart`), and it is let go: native code has it in hand, so the module of the library behind it is in the program.
# The control: built-in-that-no-embedded-option-uses-stays-out.ir.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 unreached
# RUN(NONE): link functions mechanisms=none
# NONE-NOT: function f1 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="bun:sql" displayPath="bun:sql" kind=RuntimeSource flags=[IsLoadedByImportOnly, IsHeldUnderNameWithoutPrefix] exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=BunSql body=f1
entry module=m0
usedatstart builtin=Bun_sql
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Console
    v1 = PropGet v0 key="log"
    v2 = Convert v1 declared={type=builtin(ConsoleLog) flags=[IsExpected]}
    v3 = String string="ran"
    v4 = Call v2, v0, v3 calleeKey="log" calleeName="console.log"
    Return v4
}
function f1 module=m1 kind=Module role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
