# LinkTables::calls lists a call by name with its one callee by what the flow knows while it runs: which layouts have escaped, and its own flags. The table of layouts, which says more, is written behind it.
# That is sound only because the flow lets a layout escape at each deed that may lay something over a method: another prototype, a definition, a store under a key that nobody knows, a store under `__proto__`.
# Whoever takes one of those escapes away turns this test red: the call in callB, callC, callD or callE would be listed with the method of the class, and it runs another function.
# class A { m() { return 1; } }
# class B { m() { return 1; } }
# class C { m() { return 1; } }
# class D { m() { return 1; } }
# class E { m() { return 1; } }
# function callA(o) { return o.m(); }
# function callB(o) { return o.m(); }
# function callC(o) { return o.m(); }
# function callD(o) { return o.m(); }
# function callE(o) { return o.m(); }
# function key() { return Date.now() > 0 ? "m" : "n"; }
# const other = { m() { return 2; } };
# const b = new B(); Object.setPrototypeOf(b, other);
# const c = new C(); Object.defineProperty(c, "m", { value: () => 2 });
# const d = new D(); d[key()] = () => 2;
# const e = new E(); e.__proto__ = other;
# console.log(callA(new A()), callB(b), callC(c), callD(d), callE(e));
# RUN: link calls mechanisms=all
# CHECK: call f1 v2 -> f8
# RUN(OTHERS): link calls mechanisms=all
# OTHERS-NOT: call f2 
# OTHERS-NOT: call f3 
# OTHERS-NOT: call f4 
# OTHERS-NOT: call f5 

