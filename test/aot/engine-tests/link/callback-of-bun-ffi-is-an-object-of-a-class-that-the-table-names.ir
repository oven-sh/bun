# hidden(require("bun:ffi")); setImmediate(() => {}), and the body of bun:ffi answers makeCallback(undefined, () => {})
# What the native function makes is a cell of one class of native code, which the table names.
# The control: row-of-native-code-that-answers-anything-lets-objects-of-any-class-exist.ir.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f4 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="bun:ffi" displayPath="bun:ffi" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=BunFfi body=f2
module m2 path="/$bun/js/builtins/Glob.ts" displayPath="/$bun/js/builtins/Glob.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=GlobScan function=f4
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="setImmediate" [isFreeName]
    v2 = Convert v1 declared={type=builtin(SetImmediate) flags=[IsExpected]}
    v3 = NewClosure function=f1
    v4 = Call v2, -, v3 calleeName="setImmediate"
    v5 = RequireModule module=m1 referrer=m0 specifier="bun:ffi"
    v6 = PropGet v0 key="hidden" [isFreeName]
    v7 = Call v6, -, v5
    Return v7
}
function f1 module=m0 kind=Arrow thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f2 module=m1 kind=Module role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NativeBinding builtin=NativeBindgenFfiBindTsMakeCallback
    v1 = Undefined
    v2 = NewClosure function=f3
    v3 = Call v0, -, v1, v2 calleeName="makeCallback"
    Return v3
}
function f3 module=m1 kind=Arrow role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f4 name="scan" module=m2 kind=Method role=Library flags=[HasExplicitName] length=1 enclosingRuntimeFunction=GlobScan thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
