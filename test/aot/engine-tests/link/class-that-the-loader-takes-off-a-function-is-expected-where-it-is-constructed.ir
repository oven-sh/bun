  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="x"
    v3 = Undefined
    Return v3
}
function f3 name="holder" module=m1 role=Library flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
    v0 = Undefined
    Return v0
}
