function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f5
    v1 = Convert v0 declared={type=f5 flags=[IsFromCompiler]}
    v2 = Integer integer=1
    v3 = Call v1, -, v2 calleeName="make"
    v4 = Integer integer=2
    v5 = Call v1, -, v4 calleeName="make"
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="print" [isFreeName]
    v8 = Call v7, -, v3, v5
    Return
}
