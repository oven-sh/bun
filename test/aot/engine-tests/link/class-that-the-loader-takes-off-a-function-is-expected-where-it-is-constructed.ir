# `import { Point } from "node:events"; function make(n) { return new Point(n); }`: the value of a module of the library is a function, and its classes hang on it as properties. The loader reads each name off that function into a variable.
# The value of a public module goes to unseen code, so nothing is proven of the read. What some store has laid under the name is held to lie there (Facts::held()): `new` tests for that function and goes straight to its body.
# Without it each `new` of a class of the library that is imported by name asks the run time for `this`.
# A read that the program itself writes finds what is laid on that one function under the name (LinkFlow::laidOnClosuresOf()), and nothing that is laid under the name on anything else: `holder.Point` in f4. So the constructors of the library's own classes do not meet.
# f0 = main, f1 = the body of the module, f2 = Point, f3 = the function that the module returns, f4 = byHand, f5 = make
# RUN(HELD): link held calls mechanisms=all
# HELD: call f4 {{*}} -> f2
# HELD: call f5 {{*}} -> f2
# RUN(PROVEN): link calls mechanisms=all
# PROVEN-NOT: {{*}} -> f2
# RUN(FORM): walk f5 mechanisms=all
# FORM: TypeTest {{*}}testedType=f2

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true isHoisted=true}]
module m1 path="node:events" displayPath="node:events" kind=RuntimeSource flags=[IsLoadedByImportOnly, RejectsRequireCacheOverride] exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeEvents body=f1 syntheticExports=[{name="Point" variable=g0}]
