# main.cjs, the entry of a closed executable: exports.parse = function (n) { return n }; exports.parse(1);
# The host looks for `then` on what the entry exports; a server it starts with what has `fetch` or `app`, the names on the entry's line: the exports themselves, or their `default`. Nothing lies under any of them: nobody else calls `parse`, and Bun.serve is not in use.
# OPTIONS: exclude=CodeOutsideImage
# RUN(LINK): link functions variables lookups mechanisms=all
# LINK: function f1 {{*}}callers-known
# LINK: variable g0 {{*}}writers-known
# LINK: lookup entry-hands-host-nothing 0
# RUN(FEATURES): features
# FEATURES-NOT: by BunServe

layout L0 module=m0 fields=[{key="parse" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="/main.cjs" displayPath="main.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0
entry module=m0 hostReads=[{exportName="default" builtin=BunServe namesLookedFor=["fetch", "app"]}, {exportName="then"}]
variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
function f0 name="file" module=m0 kind=CommonJsModule results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    PutModuleVariable v2 variable=g0
    v4 = GetModuleVariable variable=g0
    v5 = PropGet v4 key="parse"
    v6 = Integer integer=1
    v7 = Call v5, v4, v6 calleeKey="parse" calleeName="parse"
    Return
}
function f1 name="parse" module=m0 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
