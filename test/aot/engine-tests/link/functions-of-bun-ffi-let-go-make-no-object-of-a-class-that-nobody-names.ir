# const { callback, cfunction, closeCallback, dlopen, linkSymbols, viewSource, CString } = Bun.FFI; hidden(callback, cfunction, closeCallback, dlopen, linkSymbols, viewSource, CString); setImmediate(() => {})
# Whoever has a function may call it. Six of these had a row that said nothing, and CString was `any`: objects of any class might exist. Each row now says what native code makes: a library, a callback,
# a function, texts, or the error in place of throwing it.
# The control: undeclared-row-that-constructs-nothing-lets-objects-of-any-class-exist.ir.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f2 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/Glob.ts" displayPath="/$bun/js/builtins/Glob.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=GlobScan function=f2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="setImmediate" [isFreeName]
    v2 = Convert v1 declared={type=builtin(SetImmediate) flags=[IsExpected]}
    v3 = NewClosure function=f1
    v4 = Call v2, -, v3 calleeName="setImmediate"
    v5 = Builtin builtin=BunFFICallback
    v6 = Builtin builtin=BunFFICfunction
    v7 = Builtin builtin=BunFFICloseCallback
    v8 = Builtin builtin=BunFFIDlopen
    v9 = Builtin builtin=BunFFILinkSymbols
    v10 = Builtin builtin=BunFFIViewSource
    v11 = Builtin builtin=BunFFICString
    v12 = PropGet v0 key="hidden" [isFreeName]
    v13 = Call v12, -, v5, v6, v7, v8, v9, v10, v11
    Return v13
}
function f1 module=m0 kind=Arrow thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f2 name="scan" module=m1 kind=Method role=Library flags=[HasExplicitName] length=1 enclosingRuntimeFunction=GlobScan thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
