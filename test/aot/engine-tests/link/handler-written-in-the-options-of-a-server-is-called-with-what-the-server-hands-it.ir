# Bun.serve({ fetch(request) { console.log(request.method); return new Response("made up"); } })
# The row says what the server calls the handler with: a Request of its own and the server. The handler does not leave for code that nobody sees: its callers are known, and what it prints is a text, so no printer of objects comes in (f3).
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f1 callers-known
# CHECK: function f3 unreached
# What native code enters the handler by holds the argument against what the body believes, and stops.
# RUN(ENTRY): walk f1:GenericCallEntry mechanisms=all
# ENTRY: [[passes]]: boolean @Boolean = TypeTest [[request]] testedType=undefined|Request
# ENTRY: Branch [[passes]]
# ENTRY: CallDirect {{*}}function=f1
# ENTRY: CheckProof [[request]] checkedType=never
# RUN(BODY): walk f1:Body mechanisms=all
# BODY: b0(v0: undefined|Request

layout L0 fields=[{key="fetch" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/JSBufferPrototype.ts" displayPath="/$bun/js/builtins/JSBufferPrototype.ts" flags=[IsLibrary]
module m2 path="/$bun/js/builtins/UtilInspect.ts" displayPath="/$bun/js/builtins/UtilInspect.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=JSBufferPrototypeToJSON function=f2
runtimefunction id=UtilInspectStylizeWithNoColor function=f3
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Bun
    v1 = PropGet v0 key="serve"
    v2 = Convert v1 declared={type=builtin(BunServe) flags=[IsExpected]}
    v3 = NewClosure function=f1
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = FinishObject v4
    v6 = Call v2, v0, v5 calleeKey="serve" calleeName="Bun.serve"
    Return v6
}
function f1 name="fetch" module=m0 kind=Method flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="console" [isFreeName]
    v3 = Convert v2 declared={type=builtin(Console) flags=[IsExpected]}
    v4 = PropGet v3 key="log"
    v5 = Convert v4 declared={type=builtin(ConsoleLog) flags=[IsExpected]}
    v6 = PropGet v0 key="method"
    v7 = Call v5, v3, v6 calleeKey="log" calleeName="console.log"
    v8 = PropGet v1 key="Response" [isFreeName]
    v9 = Convert v8 declared={type=builtin(Response) flags=[IsExpected]}
    v10 = String string="made up"
    v11 = Construct v9, -, v10 calleeName="Response"
    Return v11
}
function f2 name="toJSON" module=m1 kind=Method role=Library flags=[HasExplicitName] enclosingRuntimeFunction=JSBufferPrototypeToJSON thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f3 module=m2 kind=Method role=Library length=1 enclosingRuntimeFunction=UtilInspectStylizeWithNoColor thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
