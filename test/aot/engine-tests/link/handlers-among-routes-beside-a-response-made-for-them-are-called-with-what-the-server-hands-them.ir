# Bun.serve({ routes: { "/made": request => new Response(request.url), "/up": new Response("made up") }, fetch: request => new Response("x") })
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f1 callers-known
# CHECK: function f2 callers-known

layout L0 fields=[{key="/made" declared={type=anything}}, {key="/up" declared={type=anything}}]
layout L1 fields=[{key="routes" declared={type=anything}}, {key="fetch" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Bun
    v1 = PropGet v0 key="serve"
    v2 = Convert v1 declared={type=builtin(BunServe) flags=[IsExpected]}
    v3 = NewClosure function=f1
    v4 = NewObject layout=L0
    PropDefine v4, v3 key="/made"
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="Response" [isFreeName]
    v8 = Convert v7 declared={type=builtin(Response) flags=[IsExpected]}
    v9 = String string="made up"
    v10 = Construct v8, -, v9 calleeName="Response"
    PropDefine v4, v10 key="/up"
    v12 = FinishObject v4
    v13 = NewClosure function=f2
    v14 = NewObject -, v12, v13 layout=L1 fields=[0, 1]
    v15 = FinishObject v14
    v16 = Call v2, v0, v15 calleeKey="serve" calleeName="Bun.serve"
    v17 = Undefined
    Return v17
}
function f1 module=m0 kind=Arrow length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="Response" [isFreeName]
    v3 = Convert v2 declared={type=builtin(Response) flags=[IsExpected]}
    v4 = PropGet v0 key="url"
    v5 = Construct v3, -, v4 calleeName="Response"
    Return v5
}
function f2 name="fetch" module=m0 kind=Arrow length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="Response" [isFreeName]
    v3 = Convert v2 declared={type=builtin(Response) flags=[IsExpected]}
    v4 = String string="x"
    v5 = Construct v3, -, v4 calleeName="Response"
    Return v5
}
