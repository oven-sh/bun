# import { read } from "node:path";  read();   where node:path is  const held = host("held");  function read() { return held; }  return { read };
# The loader fills `read` after the body has returned, so whoever calls it finds `held` stored.
# LIBRARY: own
# RUN(LINK): link variables mechanisms=all
# LINK: variable g1 {{*}}filled
# RUN(WALK): walk f2 mechanisms=all
# WALK: GetModuleVariable variable=g1
# WALK-NOT: undefined|
# RUN(SHELL): run-in-shell globalThis.host = text => text + "!";
# SHELL: exited with 0

layout L0 module=m1 fields=[{key="read" declared={type=anything} flags=[IsRequired]}]
variable g0 name="read" module=m1 declared={type=anything}
variable g1 name="held" module=m1 declared={type=anything} initialization=Undefined flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="node:path" displayPath="node:path" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodePath body=f1 syntheticExports=[{name="read" variable=g0 isKnownMember=true}]
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = Call v0 calleeName="read"
    v2 = Undefined
    Return v2
}
function f1 module=m1 kind=Module role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Symbol
    v1 = String string="held"
    v2 = Call v0, -, v1 calleeName="Symbol"
    PutModuleVariable v2 variable=g1
    v4 = NewClosure function=f2
    v5 = NewObject -, v4 layout=L0 fields=[0]
    v6 = FinishObject v5
    Return v6
}
function f2 name="read" module=m1 role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    Return v0
}
