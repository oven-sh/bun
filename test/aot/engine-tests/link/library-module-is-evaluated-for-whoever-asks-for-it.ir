# A module of the library is in the program for whoever loads it: library-is-no-entry.ir has one that nobody asks for. If a site that asks for it did not evaluate it, its body would be left out of the executable
# require("node:module");
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 unreached
# RUN(NONE): link functions mechanisms=none
# NONE-NOT: function f1 unreached
# RUN(UNITS): units-with-code f1:Body
# UNITS: unit f1:Body {{*}} bytes

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="node:module" displayPath="node:module" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeModule body=f1
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = RequireModule module=m1 referrer=m0 specifier="node:module"
    v1 = Undefined
    Return v1
}
function f1 module=m1 kind=Module role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = Integer integer=1
    v3 = Call v1, -, v2 calleeName="print"
    Return v3
}
