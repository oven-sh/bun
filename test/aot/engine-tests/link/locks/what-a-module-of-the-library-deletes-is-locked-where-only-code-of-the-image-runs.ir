# The same program where code outside the image is refused: a module of the library that the image does not hold cannot load, so nobody deletes the three: they are locked as their neighbor is
# Bun.FFI.callback; Bun.FFI.closeCallback; Bun.FFI.cfunction; Bun.FFI.viewSource
# RUN: locks open
# OPTIONS: exclude=CodeOutsideImage
# CHECK: locked BunFFICallback constant
# CHECK: locked BunFFICfunction constant
# CHECK: locked BunFFICloseCallback constant
# CHECK: locked BunFFIViewSource constant
# CHECK-NOT: open BunFFI

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Bun" [isFreeName]
    v2 = PropGet v1 key="FFI"
    v3 = PropGet v2 key="callback"
    v4 = PropGet v2 key="closeCallback"
    v5 = PropGet v2 key="cfunction"
    v6 = PropGet v2 key="viewSource"
    Return v6
}
