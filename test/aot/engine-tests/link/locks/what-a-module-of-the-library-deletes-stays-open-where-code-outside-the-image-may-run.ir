# bun:ffi deletes callback, closeCallback and cfunction from Bun.FFI at its top level. This image holds no code of it, and code outside the image may run: that code may load the module, which then runs from its text
# The build sees no write, and the three count as written all the same. Their neighbor is locked as ever
# Bun.FFI.callback; Bun.FFI.closeCallback; Bun.FFI.cfunction; Bun.FFI.viewSource
# RUN: locks open
# CHECK: locked BunFFIViewSource constant
# CHECK: open BunFFICallback written-under-its-name
# CHECK: open BunFFICfunction written-under-its-name
# CHECK: open BunFFICloseCallback written-under-its-name

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Bun" [isFreeName]
    v2 = PropGet v1 key="FFI"
    v3 = PropGet v2 key="callback"
    v4 = PropGet v2 key="closeCallback"
    v5 = PropGet v2 key="cfunction"
    v6 = PropGet v2 key="viewSource"
    Return v6
}
