# internal/net/isIP: const above = { up(by) { return by } }; export default { __proto__: above, grow(by) { return by }, size: 3 };      node:net: const all = require("internal/net/isIP"); export default all.grow(1);      main.js: require("node:net");
# The build admits code from outside the image. An uncompiled file of the library gets the record of the internal file from Bun's registry, and with it the object above it: it may call `up` and store into that object.
# The door freezes the record's own layout and lets go what lies in its own fields. Of the object above it knows nothing: so a record below a written prototype is not handed out frozen: it is let go whole, and what lies above it with it.
# RUN: link modules functions calls fields mechanisms=all
# CHECK-NOT: module m1 record-is-handed-out-frozen
# CHECK-NOT: function f4 callers-known
layout L0 module=m1 fields=[{key="grow" declared={type=anything} flags=[IsRequired]}, {key="size" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
layout L1 module=m1 fields=[{key="up" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m2 kind=Require completes=true}]
module m1 path="internal:net/isIP" displayPath="internal:net/isIP" kind=RuntimeSource flags=[IsLoadedByImportOnly, IsHeldUnderNameWithoutPrefix] exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=InternalNetIsIP body=f1
module m2 path="node:net" displayPath="node:net" kind=RuntimeSource flags=[IsHeldUnderNameWithoutPrefix] exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeNet body=f3
entry module=m0

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = RequireModule module=m2 referrer=m0 specifier="node:net"
    Return
}
function f1 module=m1 kind=Module role=Library results=[{type=anything}] {
    v0 = NewClosure function=f4
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = FinishObject v1
    v3 = NewClosure function=f2
    v4 = Integer integer=3
    v5 = NewObject -, v3, v4 layout=L0 fields=[0, 1]
    SetLiteralPrototype v5, v2
    v7 = FinishObject v5
    Return v7
}
function f2 name="grow" module=m1 role=Library length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 module=m2 kind=Module role=Library results=[{type=anything}] {
    v0 = RequireModule module=m1 referrer=m2 specifier="internal/net/isIP"
    v1 = PropGet v0 key="grow"
    v2 = Integer integer=1
    v3 = Call v1, v0, v2 calleeKey="grow" calleeName="grow"
    Return v3
}
function f4 name="up" module=m1 role=Library length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
