# print({}, hidden(process).width);
# The control of class-of-errors-let-go-holds-no-object-that-nobody-describes.ir: below `process` lie members whose rows answer "an object" and say no more.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/UtilInspect.ts" displayPath="/$bun/js/builtins/UtilInspect.ts" flags=[IsLibrary]
entry module=m0
layout L0 module=m0
runtimefunction id=UtilInspectStylizeWithNoColor function=f1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Process
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="hidden" [isFreeName]
    v3 = Call v2, -, v0
    v4 = PropGet v3 key="width"
    v5 = NewObject layout=L0
    v6 = FinishObject v5
    v7 = PropGet v1 key="print" [isFreeName]
    v8 = Call v7, -, v6, v4 calleeName="print"
    Return v8
}
function f1 module=m1 kind=Method role=Library length=1 enclosingRuntimeFunction=UtilInspectStylizeWithNoColor thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
