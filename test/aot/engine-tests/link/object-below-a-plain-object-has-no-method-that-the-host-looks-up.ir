# print(Object.create({ get: () => answer }));
# The twin of proxy-answers-under-the-symbol-that-the-host-looks-up.ir without the proxy: no code has the symbol and nothing answers under a key that it was not given: nothing is loaded.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f3 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/UtilInspect.ts" displayPath="/$bun/js/builtins/UtilInspect.ts" flags=[IsLibrary]
entry module=m0
layout L0 module=m0 fields=[{key="get" declared={type=anything} flags=[IsRequired]}]
runtimefunction id=UtilInspectStylizeWithNoColor function=f3
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = Builtin builtin=ObjectCreate
    v4 = Call v3, -, v2
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="print" [isFreeName]
    v7 = Call v6, -, v4 calleeName="print"
    v8 = Undefined
    Return v8
}
function f1 module=m0 kind=Arrow thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    Return v0
}
function f2 name="answer" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Call v2, -, v0
    Return v3
}
function f3 module=m1 kind=Method role=Library length=1 enclosingRuntimeFunction=UtilInspectStylizeWithNoColor thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
