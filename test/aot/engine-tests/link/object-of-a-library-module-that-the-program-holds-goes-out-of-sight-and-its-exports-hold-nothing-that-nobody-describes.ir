# print({}, hidden(require("bun:ffi")).width)
# THE MODULE's OWN OBJECT goes out of sight, and a name is read off a value that nobody knows: all that lies below the object is looked through, its export entries among them. Such an entry does not list
# its members, but it stands for no object of native code: what lies there was laid by the module's code, which the program holds. (A read of the export alone is followed as nothing and looks nothing through.)
# The control: object-of-a-library-module-that-the-program-does-not-hold-goes-out-of-sight-and-its-exports-may-hold-anything.ir.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f2 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="bun:ffi" displayPath="bun:ffi" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=BunFfi body=f1
module m2 path="/$bun/js/builtins/UtilInspect.ts" displayPath="/$bun/js/builtins/UtilInspect.ts" flags=[IsLibrary]
entry module=m0
layout L0 module=m0
layout L1 module=m1 fields=[{key="viewSource" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
runtimefunction id=UtilInspectStylizeWithNoColor function=f2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = RequireModule module=m1 referrer=m0 specifier="bun:ffi"
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="hidden" [isFreeName]
    v3 = Call v2, -, v0
    v4 = PropGet v3 key="width"
    v5 = NewObject layout=L0
    v6 = FinishObject v5
    v7 = PropGet v1 key="print" [isFreeName]
    v8 = Call v7, -, v6, v4 calleeName="print"
    Return v8
}
function f1 module=m1 kind=Module role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = FinishObject v1
    Return v2
}
function f2 module=m2 kind=Method role=Library length=1 enclosingRuntimeFunction=UtilInspectStylizeWithNoColor thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
