# main.cjs: exports.fetch = ..; other.cjs, a further entry: exports.parse = ... The word goes by the entry. A further entry has the reads of an entry point and those of a worker: four.
# OPTIONS: exclude=CodeOutsideImage
# RUN(LINK): link functions lookups mechanisms=all
# LINK-NOT: function f1 {{*}}callers-known
# LINK: function f3 {{*}}callers-known
# LINK-NOT: lookup entry-hands-host-nothing 0
# LINK: lookup entry-hands-host-nothing 1
# RUN(FEATURES): features
# FEATURES: by BunServe

layout L0 module=m0 fields=[{key="fetch" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
layout L1 module=m1 fields=[{key="parse" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="/main.cjs" displayPath="main.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0
module m1 path="/other.cjs" displayPath="other.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f2 exportsVariable=g1
entry module=m0 hostReads=[{exportName="default" builtin=BunServe namesLookedFor=["fetch", "app"]}, {exportName="then"}]
entry module=m1 hostReads=[{exportName="default" builtin=BunServe namesLookedFor=["fetch", "app"]}, {exportName="then"}, {exportName="default" builtin=BunServe namesLookedFor=["fetch", "app"]}, {exportName="then"}]
variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="exports" module=m1 declared={type=anything} initialization=Undefined
function f0 name="file" module=m0 kind=CommonJsModule results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    PutModuleVariable v2 variable=g0
    v4 = GetModuleVariable variable=g0
    v5 = PropGet v4 key="fetch"
    v6 = Integer integer=1
    v7 = Call v5, v4, v6 calleeKey="fetch" calleeName="fetch"
    Return
}
function f1 name="fetch" module=m0 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="file" module=m1 kind=CommonJsModule results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = FinishObject v1
    PutModuleVariable v2 variable=g1
    v4 = GetModuleVariable variable=g1
    v5 = PropGet v4 key="parse"
    v6 = Integer integer=1
    v7 = Call v5, v4, v6 calleeKey="parse" calleeName="parse"
    Return
}
function f3 name="parse" module=m1 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
