# Text that is evaluated finds the realm, under names that nobody sees. If the functions of the library that the realm holds stayed out of an open program, the interpreter would run their text
# (0, eval)(text);
# Every function that the host calls by its role is entered from outside, and every module of the library may be asked for by a name. No realm holds a function of the compiler: `createElement` stays out.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 unreached
# CHECK: function f2 unreached
# CHECK-NOT: function f3 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/engine/ArrayPrototype.ts" displayPath="/$bun/js/engine/ArrayPrototype.ts" flags=[IsLibrary]
module m2 path="node:module" displayPath="node:module" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeModule body=f3
entry module=m0
runtimefunction id=ArrayPrototypeMap function=f1
runtimefunction id=DecoratorsCreateElement function=f2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Eval
    v1 = String string="1"
    v2 = Call v0, -, v1 calleeName="eval"
    v3 = Undefined
    Return v3
}
function f1 name="map" module=m1 kind=Method role=Library flags=[HasThis, HasExplicitName] length=1 enclosingRuntimeFunction=ArrayPrototypeMap thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v0
}
function f2 name="createElement" module=m1 kind=Method role=Library flags=[HasExplicitName] length=1 enclosingRuntimeFunction=DecoratorsCreateElement thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 module=m2 kind=Module role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
