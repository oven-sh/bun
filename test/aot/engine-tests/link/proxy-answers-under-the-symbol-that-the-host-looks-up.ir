# print(Object.create(new Proxy({}, { get: () => answer })));
# The host prints an object by the method that it finds under Symbol.for("nodejs.util.inspect.custom"), and calls it with what it loads at its start. It loads that only where an object may have such a method.
# No code here has the symbol. A trap of a proxy answers under any key, that symbol too: on the proxy, and on whatever stands below it.
# The twin without a proxy: object-below-a-plain-object-has-no-method-that-the-host-looks-up.ir
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f3 unreached
# RUN(NONE): link functions mechanisms=none
# NONE-NOT: function f3 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/UtilInspect.ts" displayPath="/$bun/js/builtins/UtilInspect.ts" flags=[IsLibrary]
entry module=m0
layout L0 module=m0
layout L1 module=m0 fields=[{key="get" declared={type=anything} flags=[IsRequired]}]
runtimefunction id=UtilInspectStylizeWithNoColor function=f3
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = FinishObject v0
    v2 = NewClosure function=f1
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = Builtin builtin=Proxy
    v6 = Construct v5, -, v1, v4
    v7 = Builtin builtin=ObjectCreate
    v8 = Call v7, -, v6
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="print" [isFreeName]
    v11 = Call v10, -, v8 calleeName="print"
    v12 = Undefined
    Return v12
}
function f1 module=m0 kind=Arrow thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    Return v0
}
function f2 name="answer" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Call v2, -, v0
    Return v3
}
function f3 module=m1 kind=Method role=Library length=1 enclosingRuntimeFunction=UtilInspectStylizeWithNoColor thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
