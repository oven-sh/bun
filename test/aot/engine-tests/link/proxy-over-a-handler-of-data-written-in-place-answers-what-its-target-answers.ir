# print(Object.create(new Proxy({}, {})));
# The host asks what it prints for the method under Symbol.for("nodejs.util.inspect.custom"), up the chain. A proxy in the chain answers by its `get` trap, and without one the question goes on at the target.
# The handler is data that is written in place: it holds no function, the construction alone holds it, and in an executable Object.prototype takes no name. So no trap can come to lie in it, and the host loads nothing.
# The twin with a trap: proxy-answers-under-the-symbol-that-the-host-looks-up.ir. The twins that stay: the two files beside this one.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f1 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/UtilInspect.ts" displayPath="/$bun/js/builtins/UtilInspect.ts" flags=[IsLibrary]
entry module=m0
layout L0 module=m0
data d0 root=Object{layout=L0} module=m0
runtimefunction id=UtilInspectStylizeWithNoColor function=f1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = FinishObject v0
    v2 = Data data=d0
    v3 = Builtin builtin=Proxy
    v4 = Construct v3, -, v1, v2
    v5 = Builtin builtin=ObjectCreate
    v6 = Call v5, -, v4
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="print" [isFreeName]
    v9 = Call v8, -, v6 calleeName="print"
    v10 = Undefined
    Return v10
}
function f1 module=m1 kind=Method role=Library length=1 enclosingRuntimeFunction=UtilInspectStylizeWithNoColor thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
