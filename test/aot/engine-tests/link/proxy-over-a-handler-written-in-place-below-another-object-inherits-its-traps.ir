# print(Object.create(new Proxy({}, { __proto__: traps, set() { return true; } })));
# The literal names what stands above it, and a `get` may lie there, so the host loads what it prints objects with.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f2 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/UtilInspect.ts" displayPath="/$bun/js/builtins/UtilInspect.ts" flags=[IsLibrary]
entry module=m0
layout L0 module=m0
layout L1 module=m0 fields=[{key="set" declared={type=anything} flags=[IsRequired, IsMethod]}]
runtimefunction id=UtilInspectStylizeWithNoColor function=f2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = FinishObject v0
    v2 = NewClosure function=f1
    v3 = NewObject layout=L0
    v4 = FinishObject v3
    v5 = NewObject v4, v2 layout=L1 fields=[0]
    v6 = FinishObject v5
    v7 = Builtin builtin=Proxy
    v8 = Construct v7, -, v1, v6
    v9 = Builtin builtin=ObjectCreate
    v10 = Call v9, -, v8
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="print" [isFreeName]
    v13 = Call v12, -, v10 calleeName="print"
    v14 = Undefined
    Return v14
}
function f1 name="set" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    Return v0
}
function f2 module=m1 kind=Method role=Library length=1 enclosingRuntimeFunction=UtilInspectStylizeWithNoColor thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
