# const handler = { set() { return true; } }; print(handler); print(Object.create(new Proxy({}, handler)));
# Whoever else holds the literal can lay a `get` there, so the host loads what it prints objects with.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f2 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/UtilInspect.ts" displayPath="/$bun/js/builtins/UtilInspect.ts" flags=[IsLibrary]
entry module=m0
layout L0 module=m0
layout L1 module=m0 fields=[{key="set" declared={type=anything} flags=[IsRequired, IsMethod]}]
runtimefunction id=UtilInspectStylizeWithNoColor function=f2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = FinishObject v0
    v2 = NewClosure function=f1
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="print" [isFreeName]
    v7 = Call v6, -, v4 calleeName="print"
    v8 = Builtin builtin=Proxy
    v9 = Construct v8, -, v1, v4
    v10 = Builtin builtin=ObjectCreate
    v11 = Call v10, -, v9
    v12 = Call v6, -, v11 calleeName="print"
    v13 = Undefined
    Return v13
}
function f1 name="set" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    Return v0
}
function f2 module=m1 kind=Method role=Library length=1 enclosingRuntimeFunction=UtilInspectStylizeWithNoColor thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
