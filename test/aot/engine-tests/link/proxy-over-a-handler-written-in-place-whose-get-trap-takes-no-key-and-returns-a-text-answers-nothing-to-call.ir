# print(Object.create(new Proxy({}, { get() { return "a"; } })));
# The host calls what it finds under Symbol.for("nodejs.util.inspect.custom") only if that is a function. The handler keeps the `get` that it was written with, and Link says what that returns: a text.
# The trap takes no operand, so it does not come by the symbol that it is asked for either.
# The twin that returns a function: proxy-answers-under-the-symbol-that-the-host-looks-up.ir. The twin that takes the key: ..-whose-get-trap-takes-the-key-has-come-by-the-symbol.ir
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f2 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/UtilInspect.ts" displayPath="/$bun/js/builtins/UtilInspect.ts" flags=[IsLibrary]
entry module=m0
layout L0 module=m0
layout L1 module=m0 fields=[{key="get" declared={type=anything} flags=[IsRequired, IsMethod]}]
runtimefunction id=UtilInspectStylizeWithNoColor function=f2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = FinishObject v0
    v2 = NewClosure function=f1
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = Builtin builtin=Proxy
    v6 = Construct v5, -, v1, v4
    v7 = Builtin builtin=ObjectCreate
    v8 = Call v7, -, v6
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="print" [isFreeName]
    v11 = Call v10, -, v8 calleeName="print"
    v12 = Undefined
    Return v12
}
function f1 name="get" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
    Return v0
}
function f2 module=m1 kind=Method role=Library length=1 enclosingRuntimeFunction=UtilInspectStylizeWithNoColor thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
