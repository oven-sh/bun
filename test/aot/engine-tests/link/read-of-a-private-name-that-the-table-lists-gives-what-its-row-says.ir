# print({}); $asyncContext
# Library code names the private globals of the host: reads of an engine-private name off the global object. No program can spell such a name, so what lies there the host laid, and its row hangs on %PrivateGlobals%: an object, no symbol.
# The controls: read-of-a-private-name-whose-row-says-anything-may-give-any-symbol.ir, read-of-a-private-name-that-the-table-does-not-list-may-give-any-symbol.ir.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f1 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/UtilInspect.ts" displayPath="/$bun/js/builtins/UtilInspect.ts" flags=[IsLibrary]
entry module=m0
layout L0 module=m0
runtimefunction id=UtilInspectStylizeWithNoColor function=f1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key=@"asyncContext" [isFreeName]
    v2 = NewObject layout=L0
    v3 = FinishObject v2
    v4 = PropGet v0 key="print" [isFreeName]
    v5 = Call v4, -, v3 calleeName="print"
    Return v1
}
function f1 module=m1 kind=Method role=Library length=1 enclosingRuntimeFunction=UtilInspectStylizeWithNoColor thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
