# process.nextTick(() => {}); require("node:path").sep.scan()
# The table has an entry for each export of a module of the library, with a row that says nothing of what a read gives. Where the module is compiled with the program its own code makes what it exports, and Link sees that code:
# the row makes nothing. If it counted as a row of the host that says nothing of what it hands out, objects of any class might exist: the call would find `scan` on the prototype object of the class of Bun.Glob,
# and the function of the library behind it would be in the program.
# The control: read-of-an-export-of-a-library-module-that-is-not-compiled-lets-any-class-exist.ir.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f2 unreached
# CHECK-NOT: function f3 unreached
# CHECK-NOT: function f4 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/ProcessObjectInternals.ts" displayPath="/$bun/js/builtins/ProcessObjectInternals.ts" flags=[IsLibrary]
module m2 path="/$bun/js/builtins/Glob.ts" displayPath="/$bun/js/builtins/Glob.ts" flags=[IsLibrary]
module m3 path="node:path" displayPath="node:path" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodePath body=f4
entry module=m0
runtimefunction id=GlobScan function=f2
runtimefunction id=ProcessObjectInternalsInitializeNextTickQueue function=f3
