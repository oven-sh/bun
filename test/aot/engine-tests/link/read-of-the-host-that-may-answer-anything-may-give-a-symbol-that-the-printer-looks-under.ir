# Bun.argv; console.log(<a list that the program has just made>)
# The control of read-that-hands-back-what-the-program-handed-in-gives-no-symbol-that-nobody-has-seen.ir: the row says `any` and says nothing of its cell: it may answer a symbol under which the printer of
# objects looks for a method.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal:util/inspect" displayPath="internal:util/inspect" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=InternalUtilInspect body=f1
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Bun
    v1 = PropGet v0 key="argv"
    v2 = NewArray contents=anything
    v3 = Builtin builtin=Console
    v4 = PropGet v3 key="log"
    v5 = Convert v4 declared={type=builtin(ConsoleLog) flags=[IsExpected]}
    v6 = Call v5, v3, v2 calleeKey="log" calleeName="console.log"
    Return v6
}
function f1 module=m1 kind=Module role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
