# Array.from(JSON.parse(text), JSON.parse(text))
# Nobody knows whether the second operand is undefined, a function or something else. For each of the three a row says what happens on `Array`: the list is copied, the function is called for each item,
# a TypeError is thrown before anything else is touched. So Link, which goes through the rows with the operands, does not come to the row that says nothing, and sends neither the receiver nor the
# operands out of sight. The compiler's own quick form of Array.from(list, mapper) falls back on such a call.
# The control: another-built-in-as-the-receiver-of-array-from-is-let-go.ir.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 unreached
# CHECK: function f2 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/engine/ArrayConstructor.ts" displayPath="/$bun/js/engine/ArrayConstructor.ts" flags=[IsLibrary]
module m2 path="/$bun/js/engine/ArrayPrototype.ts" displayPath="/$bun/js/engine/ArrayPrototype.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=ArrayPrototypeFlatMap function=f2
runtimefunction id=ArrayConstructorFrom function=f1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=JSON
    v1 = PropGet v0 key="parse"
    v2 = Convert v1 declared={type=builtin(JSONParse) flags=[IsExpected]}
    v3 = String string="[]"
    v4 = Call v2, v0, v3 calleeKey="parse" calleeName="JSON.parse"
    v5 = Builtin builtin=Array [isNotReadFromHolder]
    v6 = Builtin builtin=ArrayFrom [isNotReadFromHolder]
    v7 = Call v6, v5, v4, v4 calleeName="Array.from"
    Return v7
}
function f1 name="from" module=m1 kind=Method role=Library flags=[HasExplicitName] length=1 enclosingRuntimeFunction=ArrayConstructorFrom thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="flatMap" module=m2 kind=Method role=Library flags=[HasExplicitName] length=1 enclosingRuntimeFunction=ArrayPrototypeFlatMap thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
