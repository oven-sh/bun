# hidden(Array.of); setImmediate(() => {})
# Array.of is let go, so any of its rows may apply. The second one is for another receiver: the table says nothing of its result, but it records what the row does: it constructs the receiver. So it makes what the rows of that
# constructor make, and whoever calls it so has the constructor, which is then let go itself. If the row counted as one that says nothing of what it makes, objects of any class might exist: native code would find Bun.Glob
# on the prototype object of its class, and the two functions of the library behind it would be in the program.
# The control: undeclared-row-that-constructs-nothing-lets-objects-of-any-class-exist.ir.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f2 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/Glob.ts" displayPath="/$bun/js/builtins/Glob.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=GlobScan function=f2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="setImmediate" [isFreeName]
    v2 = Convert v1 declared={type=builtin(SetImmediate) flags=[IsExpected]}
    v3 = NewClosure function=f1
    v4 = Call v2, -, v3 calleeName="setImmediate"
    v5 = Builtin builtin=ArrayOf
    v6 = PropGet v0 key="hidden" [isFreeName]
    v7 = Call v6, -, v5
    Return v7
}
function f1 module=m0 kind=Arrow thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f2 name="scan" module=m1 kind=Method role=Library flags=[HasExplicitName] length=1 enclosingRuntimeFunction=GlobScan thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
