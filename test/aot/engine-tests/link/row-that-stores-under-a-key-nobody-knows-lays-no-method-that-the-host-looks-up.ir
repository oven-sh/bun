# print(Object.defineProperty({}, JSON.parse(text), { value: () => 1 }));
# The host prints an object by the method that it finds under Symbol.for("nodejs.util.inspect.custom"), and loads what it calls that method with only where an object may have such a method.
# Nobody knows the key. It is that symbol only if the program can come by the symbol, and each way to it is heard by itself: as for `shelf[key] = f`, which syntax writes.
# The twin that has the symbol: row-that-stores-under-a-registered-symbol-may-lay-the-method-that-the-host-looks-up.ir
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f2 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/UtilInspect.ts" displayPath="/$bun/js/builtins/UtilInspect.ts" flags=[IsLibrary]
entry module=m0
layout L0 module=m0
layout L1 module=m0 fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
runtimefunction id=UtilInspectStylizeWithNoColor function=f2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = FinishObject v0
    v2 = Builtin builtin=JSON
    v3 = Builtin builtin=JSONParse
    v4 = String string="\"a\""
    v5 = Call v3, v2, v4
    v6 = NewClosure function=f1
    v7 = NewObject -, v6 layout=L1 fields=[0]
    v8 = FinishObject v7
    v9 = Builtin builtin=ObjectDefineProperty
    v10 = Call v9, -, v1, v5, v8
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="print" [isFreeName]
    v13 = Call v12, -, v10 calleeName="print"
    v14 = Undefined
    Return v14
}
function f1 module=m0 kind=Arrow thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f2 module=m1 kind=Method role=Library length=1 enclosingRuntimeFunction=UtilInspectStylizeWithNoColor thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
