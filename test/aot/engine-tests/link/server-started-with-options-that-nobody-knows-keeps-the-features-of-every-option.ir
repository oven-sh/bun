# Bun.serve(globalThis.options)
# RUN: features
# CHECK: feature Interpreter by BunServe
# CHECK: feature Temporal by BunServe

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Bun
    v1 = PropGet v0 key="serve"
    v2 = Convert v1 declared={type=builtin(BunServe) flags=[IsExpected]}
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="options"
    v5 = Call v2, v0, v4 calleeKey="serve" calleeName="Bun.serve"
    Return v5
}
