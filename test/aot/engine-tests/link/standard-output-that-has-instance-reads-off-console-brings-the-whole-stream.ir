# class Probe { static [Symbol.hasInstance](value) { return "mark" in value._stdout; } }  process.stdout.write("x"); console instanceof Probe
# As standard-output-off-what-has-instance-is-handed-brings-the-whole-stream-where-a-name-is-looked-for-in-it.ir, off `console`: the table writes "anything" for console._stdout,
# so what Link reads there is no built-in for it any more and no later use can say that it is asked for more: the read says so.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 unreached
# CHECK-NOT: function f2 unreached

layout L0 kind=Instance name="Probe" module=m0 constructor=f3
module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/stdio.ts" displayPath="/$bun/js/builtins/stdio.ts" flags=[IsLibrary]
module m2 path="/$bun/js/builtins/ProcessObjectInternals.ts" displayPath="/$bun/js/builtins/ProcessObjectInternals.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=ProcessObjectInternalsGetStdioWriteStream function=f2
runtimefunction id=StdioGetLightStdioWriteStreams function=f1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Process
    v1 = PropGet v0 key="stdout"
    v2 = PropGet v1 key="write"
    v3 = String string="x"
    v4 = Call v2, v1, v3 calleeKey="write"
    v5 = NewClosure function=f3
    v6 = NewClass v5 layout=L0
    v7 = NewClosure function=f4
    DefineMethod v6, v7 layout=L0 side=Static key=@@hasInstance
    v9 = FinishClass v6 layout=L0
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="console" [isFreeName]
    v12 = Convert v11 declared={type=builtin(Console) flags=[IsExpected]}
    v13 = InstanceOf v12, v9
    v14 = Undefined
    Return v14
}
function f1 name="getLightStdioWriteStreams" module=m1 kind=Method role=Library flags=[HasExplicitName] length=7 enclosingRuntimeFunction=StdioGetLightStdioWriteStreams thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything, v6: anything):
    Return v4
}
function f2 name="getStdioWriteStream" module=m2 kind=Method role=Library flags=[HasExplicitName] length=4 enclosingRuntimeFunction=ProcessObjectInternalsGetStdioWriteStream thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything):
    Return v0
}
function f3 name="Probe" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f4 name="[Symbol.hasInstance]" module=m0 kind=Method flags=[IsNamedByComputedKey] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="_stdout"
    v2 = PropHas v1 key="mark"
    Return v2
}
