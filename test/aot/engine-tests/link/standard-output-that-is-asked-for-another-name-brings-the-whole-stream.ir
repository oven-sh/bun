# process.stdout.write("x"); process.stdout.once
# The control of standard-output-that-is-only-written-to-brings-the-light-stream-alone.ir: `once` is no name that the light stream serves.
# LIBRARY: own
# RUN: link functions mechanisms=all
# RUN(LOOKUPS): link lookups mechanisms=all
# CHECK-NOT: function f1 unreached
# CHECK-NOT: function f2 unreached
# From there on the stream is an object that nobody knows, at the call in front of the read too.
# LOOKUPS: lookup name-read "once"
# LOOKUPS: lookup name-called "write"

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/stdio.ts" displayPath="/$bun/js/builtins/stdio.ts" flags=[IsLibrary]
module m2 path="/$bun/js/builtins/ProcessObjectInternals.ts" displayPath="/$bun/js/builtins/ProcessObjectInternals.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=ProcessObjectInternalsGetStdioWriteStream function=f2
runtimefunction id=StdioGetLightStdioWriteStreams function=f1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Process
    v1 = PropGet v0 key="stdout"
    v2 = PropGet v1 key="write"
    v3 = String string="x"
    v4 = Call v2, v1, v3 calleeKey="write"
    v5 = PropGet v1 key="once"
    Return v5
}
function f1 name="getLightStdioWriteStreams" module=m1 kind=Method role=Library flags=[HasExplicitName] length=7 enclosingRuntimeFunction=StdioGetLightStdioWriteStreams thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything, v6: anything):
    Return v4
}
function f2 name="getStdioWriteStream" module=m2 kind=Method role=Library flags=[HasExplicitName] length=4 enclosingRuntimeFunction=ProcessObjectInternalsGetStdioWriteStream thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything):
    Return v0
}
