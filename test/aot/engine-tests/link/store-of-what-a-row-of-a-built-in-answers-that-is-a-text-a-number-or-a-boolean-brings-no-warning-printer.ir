# process.env.TEXT = String(hidden); .NUMBER = Number(hidden); .TRUTH = Boolean(hidden)
# The object warns about a value that is stored into it and is no string, number or boolean. Nothing is known of `hidden`. But the operation names the function, nobody replaces it, and each of its rows for a
# call answers a text, a number or a boolean: native code calls neither function of the library.
# If only written constants and operators counted, every program that hands a child `{ ...process.env, COUNT: String(n) }` would hold the printer of warnings and all behind it.
# The controls stand beside this file: store-of-what-a-row-of-a-built-in-answers-*-brings-the-warning-printer.ir.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f1 unreached
# CHECK: function f2 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/ProcessObjectInternals.ts" displayPath="/$bun/js/builtins/ProcessObjectInternals.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=ProcessObjectInternalsCreateOnWarning function=f1
runtimefunction id=ProcessObjectInternalsInitializeNextTickQueue function=f2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Process
    v1 = PropGet v0 key="env"
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="hidden" [isFreeName]
    v4 = Builtin builtin=String [isNotReadFromHolder]
    v5 = Call v4, -, v3 calleeName="String"
    PropSet v1, v5 key="TEXT"
    v7 = Builtin builtin=Number [isNotReadFromHolder]
    v8 = Call v7, -, v3 calleeName="Number"
    PropSet v1, v8 key="NUMBER"
    v10 = Builtin builtin=Boolean [isNotReadFromHolder]
    v11 = Call v10, -, v3 calleeName="Boolean"
    PropSet v1, v11 key="TRUTH"
    Return v11
}
function f1 name="createOnWarning" module=m1 kind=Method role=Library flags=[HasExplicitName] length=4 enclosingRuntimeFunction=ProcessObjectInternalsCreateOnWarning thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything):
    Return v0
}
function f2 name="initializeNextTickQueue" module=m1 kind=Method role=Library flags=[HasExplicitName] length=3 enclosingRuntimeFunction=ProcessObjectInternalsInitializeNextTickQueue thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    Return v0
}
