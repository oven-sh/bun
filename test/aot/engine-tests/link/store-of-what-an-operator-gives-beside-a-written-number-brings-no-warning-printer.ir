    v31 = ToNumber v3
    PropSet v1, v31 key="NUMBER"
    v33 = String string="made up"
    v34 = Add v3, v33
    PropSet v1, v34 key="TEXT"
    v36 = Sub v3, v33
    PropSet v1, v36 key="LESS"
    v38 = Undefined
    v39 = Add v3, v38
