    v3 = PropGet v2 key="hidden" [isFreeName]
    v4 = Integer integer=1
    v5 = Add v3, v4
    PropSet v1, v5 key="LIMIT"
    v7 = Integer integer=2
    v8 = Mul v3, v7
    PropSet v1, v8 key="HALF"
    v10 = Integer
    v11 = BitOr v3, v10
    PropSet v1, v11 key="LOW"
    v13 = Sub v3, v7
    PropSet v1, v13 key="SUB"
    v15 = Div v3, v7
    PropSet v1, v15 key="DIV"
    v17 = Mod v3, v7
    PropSet v1, v17 key="MOD"
    v19 = Pow v3, v7
    PropSet v1, v19 key="POW"
    v21 = BitAnd v3, v7
    PropSet v1, v21 key="BITAND"
    v23 = BitXor v3, v7
    PropSet v1, v23 key="BITXOR"
    v25 = LShift v3, v7
    PropSet v1, v25 key="LSHIFT"
    v27 = RShift v3, v7
    PropSet v1, v27 key="RSHIFT"
    v29 = URShift v3, v3
