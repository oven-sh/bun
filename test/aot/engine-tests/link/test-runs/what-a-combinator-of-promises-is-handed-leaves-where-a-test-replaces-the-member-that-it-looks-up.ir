r.n; }\x0afunction gather(r) { let work = 0; for (let k = 0; k < 2; k++) work = (work + k) | 0; Promise.all([r]); return work; }\x0afunction sum(list) {\x0a  let work = 0; for (let k = 0; k < 2; k++) work = (work + k) | 0;\x0a  let total = 0;\x0a  for (let i = 0; i < list.length; i++) total += read(list[i]);\x0a  return total;\x0a}\x0atest(\x22the elements of a combinator go through a replaced member\x22, () => {\x0a  const original = Promise.resolve;\x0a  const originalThen = Promise.prototype.then;\x0a  const kept = [];\x0a  for (let i = 0; i < 300; i++) { const rec = make(i); gather(rec); kept.push(rec); }\x0a  const before = typeof read(kept[7]) + \x22 \x22 + sum(kept);\x0a  Promise.resolve = function (value) {\x0a    let work = 0; for (let k = 0; k < 2; k++) work = (work + k) | 0;\x0a    value.n = \x22t\x22;\x0a    return original.call(this, value);\x0a  };\x0a  for (let i = 0; i < 300; i++) gather(kept[i]);\x0a  Promise.resolve = original;\x0a  console.log(before, \x22|\x22, typeof read(kept[7]), String(sum(kept)).length);\x0a});\x0a" namespaceLayout=L(m0)
