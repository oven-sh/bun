# const whole = Object.prototype.valueOf.bind(globalThis); whole()[hidden]
# valueOf hands its receiver back: what is bound as its `this` comes out of each call, so the global object is let go where it is bound, and everything on it is kept.
# RUN: features
# CHECK: by BunFileSystemRouter

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ObjectPrototypeValueOf
    v1 = PropGet v0 key="bind"
    v2 = Builtin builtin=GlobalThis
    v3 = Call v1, v0, v2 calleeKey="bind"
    v4 = Call v3, -
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="hidden" [isFreeName]
    v7 = ElemGet v4, v6
    Return v7
}
