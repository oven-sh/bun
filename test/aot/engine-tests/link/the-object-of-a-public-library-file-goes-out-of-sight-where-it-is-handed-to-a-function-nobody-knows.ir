# import path, { join } from "node:path";  join("a");  globalThis.hook(path);
# The control of the-object-of-a-public-library-file-that-a-body-names-stays-in-sight.ir: the record goes to a function that nobody knows, and with it all that it holds.
# LIBRARY: own
# OPTIONS: exclude=CodeOutsideImage
# RUN: link fields variables functions modules mechanisms=all
# CHECK-NOT: field L0.1 "join" proven
# CHECK-NOT: function f2 unreached
# CHECK-NOT: function f3 callers-known
# CHECK-NOT: module m1 value-stays-with-compiled-code

layout L0 module=m1 fields=[{key="basename" declared={type=anything} flags=[IsRequired]}, {key="join" declared={type=anything} flags=[IsRequired]}]
variable g0 name="join" module=m1 declared={type=anything}
module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="node:path" displayPath="node:path" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodePath body=f1 syntheticExports=[{name="join" variable=g0 isKnownMember=true}]
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = String string="a"
    v2 = Call v0, -, v1 calleeName="join"
    v3 = Builtin builtin=NodePath
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="hook"
    v6 = Call v5, v4, v3 calleeKey="hook" calleeName="globalThis.hook"
    v7 = Undefined
    Return v7
}
function f1 module=m1 kind=Module role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewClosure function=f3
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = FinishObject v2
    Return v3
}
function f2 name="basename" module=m1 role=Library length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="join" module=m1 role=Library length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
