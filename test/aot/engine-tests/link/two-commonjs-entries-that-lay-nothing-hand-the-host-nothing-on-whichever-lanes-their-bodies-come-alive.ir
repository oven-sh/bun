# Two entries, main.cjs and other.cjs, each: exports.parse = function (n) { return n }; exports.parse(1);
# The bodies of entries come alive in one wave, on several lanes where the order is scattered: what the host looks for is asked of each body's own summary, and nothing is kept beside it.
# OPTIONS: exclude=CodeOutsideImage
# RUN: link lookups scattered mechanisms=all
# CHECK: lookup entry-hands-host-nothing 0
# CHECK: lookup entry-hands-host-nothing 1

layout L0 module=m0 fields=[{key="parse" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
layout L1 module=m1 fields=[{key="parse" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="/main.cjs" displayPath="main.cjs" kind=CommonJs flags=[KeepsError] exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0
module m1 path="/other.cjs" displayPath="other.cjs" kind=CommonJs flags=[KeepsError] exportRule=CommonJs requireResult=ModuleExports body=f2 exportsVariable=g1
entry module=m0 hostReads=[{exportName="default" builtin=BunServe namesLookedFor=["fetch", "app"]}, {exportName="then"}]
entry module=m1 hostReads=[{exportName="default" builtin=BunServe namesLookedFor=["fetch", "app"]}, {exportName="then"}]
variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="exports" module=m1 declared={type=anything} initialization=Undefined
function f0 name="file" module=m0 kind=CommonJsModule results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    PutModuleVariable v2 variable=g0
    v4 = GetModuleVariable variable=g0
    v5 = PropGet v4 key="parse"
    v6 = Integer integer=1
    v7 = Call v5, v4, v6 calleeKey="parse" calleeName="parse"
    Return
}
function f1 name="parse" module=m0 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="file" module=m1 kind=CommonJsModule results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = FinishObject v1
    PutModuleVariable v2 variable=g1
    v4 = GetModuleVariable variable=g1
    v5 = PropGet v4 key="parse"
    v6 = Integer integer=1
    v7 = Call v5, v4, v6 calleeKey="parse" calleeName="parse"
    Return
}
function f3 name="parse" module=m1 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
