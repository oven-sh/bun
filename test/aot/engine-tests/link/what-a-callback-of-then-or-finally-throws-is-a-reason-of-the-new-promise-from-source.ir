# What a callback of then | finally throws, and what a promise that it returns is rejected with, is a reason of the new promise: the handler behind it is handed more than the first promise was rejected with.
# Bun.sleep(0).finally(thrower).catch(behindFinally);  Bun.sleep(0).then(thrower, undefined).catch(behindThen);
# Nothing rejects the promise of Bun.sleep(). While the rows of then | finally gave the new promise the reason of the old one alone, each handler was proven to be handed undefined, and `typeof e` was folded.
# The last chain says that the others are not empty-handed: in this program the promises are followed, and what a handler is handed is proven where the rows know it.
# f1 = thrower, f2 = rejects, f3 = gives, f4 = behindFinally, f5 = behindThen, f6 = behindFinallyThatRejects, f7 = behindThenThatRejects, f8 = behindValue
# -- source: reason.ts
# let seen = "";
# function thrower() { throw "late"; }
# async function rejects() { throw "inner"; }
# function gives() { return "given"; }
# function behindFinally(e: unknown) { seen += typeof e; }
# function behindThen(e: unknown) { seen += typeof e; }
# function behindFinallyThatRejects(e: unknown) { seen += typeof e; }
# function behindThenThatRejects(e: unknown) { seen += typeof e; }
# function behindValue(v: unknown) { seen += typeof v; }
# Bun.sleep(0).finally(thrower).catch(behindFinally);
# Bun.sleep(0).then(thrower, undefined).catch(behindThen);
# Bun.sleep(0).finally(rejects).catch(behindFinallyThatRejects);
# Bun.sleep(0).then(rejects, null).catch(behindThenThatRejects);
# Bun.sleep(0).then(gives).then(behindValue);
# -- end of source
