# `Object.defineProperty({}, KEY, 5)`, KEY = { toString() { console.log("ran"); return "x"; } }: CODE OF THE PROGRAM RUNS IN FRONT OF A REFUSAL.
# Native code converts the key, and only then finds that 5 is no descriptor and throws. Link found the third operand surely outside every row, dropped the rows whole and let the call throw:
# nobody asked the key, its toString was not reached, and the compiled program threw another error without having run it.
# Now, where a call falls off the end of the rows of its built-in, what each refused row takes BESIDE what it refuses is applied as the row would apply it.
# A refused row is passed over where a row in front of it takes all that it takes: `Object.assign(T | undefined, source)` and `list.sort(closure | null)` move no table.
# const t = (l: string, r: () => unknown) => { try { console.log(l, "gave", String(r())); } catch (e) { console.log(l, "threw", (e as Error).name); } };
# const KEY: any = { toString() { console.log("ran"); return "x"; } };
# t("a", () => Object.defineProperty({}, KEY, 5 as any));
