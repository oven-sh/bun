# keeper(new AsyncDisposableStack())
# Somebody whom nobody follows holds the stack: native code, for all that Link knows. It may look under many a symbol of what it holds; under Symbol.asyncDispose nothing native looks but the rows that name it,
# and none of them may run here. So the method there, which is the engine's disposeAsync, is not called.
# If every member under a symbol counted as called, whatever has such a method (a child process, a terminal, an asynchronous iterator) would bring all that stands behind promises.
# The controls stand beside this file: what-lies-under-the-symbol-of-disposal-is-called-*.ir.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f1 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/engine/AsyncDisposableStackPrototype.ts" displayPath="/$bun/js/engine/AsyncDisposableStackPrototype.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=AsyncDisposableStackPrototypeDisposeAsync function=f1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="AsyncDisposableStack" [isFreeName]
    v2 = Convert v1 declared={type=builtin(AsyncDisposableStack) flags=[IsExpected]}
    v3 = Construct v2, - calleeName="AsyncDisposableStack"
    v4 = PropGet v0 key="keeper" [isFreeName]
    v5 = Call v4, -, v3
    v6 = Undefined
    v7 = Undefined
    Return v7
}
function f1 name="disposeAsync" module=m1 kind=Method role=Library flags=[HasExplicitName] enclosingRuntimeFunction=AsyncDisposableStackPrototypeDisposeAsync thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
