# -- source: pattern-in-a-loop-reads-a-list-in-line.js
# function summed(pairs) { let s = 0; for (let i = 0; i < pairs.length; i++) { const [a, b] = pairs[i]; s += a + b; } return s; }
# function once(pair) { const [a, b] = pair; return a + b; }
# globalThis.kept = [summed, once];
# console.log(summed([[1, 2], [3, 4]]), once([5, 6]));
# -- end of source
# A pattern whose steps stand in a row is one operation wherever it stands, and no test for a list stands in front of it. In a loop the code of the operation reads a list as lists are made in line,
# where it holds boxed values and as many of them as are taken: the cell says what it is, that it is as made and what kind of storage it has, the length is compared once, and each element is loaded and looked at for a hole.
# Whatever else comes goes to the stub, which is all there is outside a loop. The loop is built twice, for a list of lists and for whatever else comes: the second copy is rare, and its pattern takes the stub as well.
# OPTIONS: report=Flow
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: [[taken]]: {{*}} = DestructureIterable {{*}} count=2 [readsListsByIndex]
# CHECK: = ResultAt [[taken]]
# CHECK: = ResultAt [[taken]] index=1
# RUN(ALONE): walk f1 f2 mechanisms=all
# ALONE-NOT: = IsPristine
# ALONE-NOT: level=Proven
# RUN(FORMS): bytes-by-form mechanisms=all
# FORMS: DestructureIterable Always Anywhere Runtime 2
# FORMS: DestructureIterable Always Loop Open 1
# RUN(ONCE): emit f2:Body mechanisms=all
# ONCE-NOT: Butterfly_publicLength
# ONCE-NOT: JSCell_typeInfoFlags

