# Each loop asks on every turn for a function that the program has one object for, and calls something that may collect in between. The build checks at run time every load that it has moved.
# FORM: AsRead
# OPTIONS: check=MovedLoads
# RUN: lower-to-b3 optimized f1
# REQUIRES: x86_64 unsanitized-code not-windows faulting-loop-polls

module m0 path="loop-makes-function-every-turn-declared.js" displayPath="loop-makes-function-every-turn-declared.js" body=f0 namespaceLayout=L(m0)
entry module=m0
layout L0 kind=Environment module=m0 fields=[{key=@"binding.0" declared={type=number|absent flags=[IsExpected]}}] ownFieldCount=1
data d0 root=Array{contents=anything} module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Call v1 calleeName="counters"
    v3 = Undefined
    Return v3
}
function f1 name="counters" module=m0 position=225 flags=[HasExplicitName] thisType={type=anything} results=[{type=undefined|null|Array<undefined|null|function|f2> flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = NewObject layout=L0
    v1 = Integer
    v2 = Convert v1 declared={type=number flags=[IsExpected]}
    PutEnvironmentField v0, v2 layout=L0
    v4 = Data data=d0
    v5 = Convert v4 declared={type=undefined|null|Array<never> flags=[IsExpected]}
    v6 = Convert v5 declared={type=undefined|null|Array flags=[IsExpected]}
    Jump -> next b1()
  b1():
    LoopHint
    v8 = GetEnvironmentField v0 layout=L0
    v9 = CheckInitialized v8 name="c"
    v10 = Increment v9
    v11 = Convert v10 declared={type=number flags=[IsExpected]}
    PutEnvironmentField v0, v11 layout=L0
    v13 = PropGet v6 key="push"
    v14 = Convert v13 declared={type=undefined|null|function flags=[IsExpected]}
    v15 = NewClosure v0 function=f2
    v16 = Call v14, v6, v15 calleeKey="push" calleeName="all.push"
    v17 = GetEnvironmentField v0 layout=L0
    v18 = CheckInitialized v17 name="c"
    v19 = Integer integer=3
    v20 = Less v18, v19
    Branch v20 -> taken b1(), notTaken b2()
  b2():
    v21 = Convert v6 declared={type=undefined|null|Array<undefined|null|function|f2> flags=[IsExpected]}
    Return v21
}
function f2 module=m0 position=287 kind=Arrow captures=[{type=env L0 flags=[IsFromCompiler]}] thisType={type=anything} results=[{type=number flags=[IsExpected]}] functionTypes=[f3] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost]
function f3 module=m0 role=Signature thisType={type=anything} results=[{type=anything}]
