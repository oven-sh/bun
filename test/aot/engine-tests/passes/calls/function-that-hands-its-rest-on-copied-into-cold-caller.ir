# -- source: function-that-hands-its-rest-on-copied-into-cold-caller.ts
# // In code that seldom runs a call is worth its own bytes, and so is the list that is made for a rest parameter. A function that only hands its rest parameter on is
# // copied into its caller, the list goes, and the arguments reach the function behind it in registers: by a spread, by apply, behind a first argument, through two levels,
# // into a constructor and into Math.max.
# declare const input: any;
# function target(a: number, b: number, c: number): number {
#   let sum = a;
#   for (let index = 0; index < b; index++) sum += c * index;
#   return sum;
# }
# class Point {
#   sum: number;
#   constructor(a: number, b: number, c: number) {
#     this.sum = target(a, b, c);
#   }
# }
# function spreads(...args: [number, number, number]): number {
#   return target(...args);
# }
# function applies(this: unknown, ...args: [number, number, number]): number {
#   return target.apply(this, args);
# }
# function namesAndSpreads(name: string, ...args: [number, number, number]): number {
#   return name.length + target(...args);
# }
# function spreadsTwice(...args: [number, number, number]): number {
#   return spreads(...args);
# }
# function constructs(...args: [number, number, number]): Point {
#   return new Point(...args);
# }
# function largest(...values: number[]): number {
#   return Math.max(...values);
# }
# function bySpread(i: number): number {
#   return spreads(i, 2, 3);
# }
# function byApply(i: number): number {
#   return applies(i, 2, 3);
# }
# function behindName(i: number): number {
#   return namesAndSpreads("data", i, 2, 3);
# }
# function throughTwo(i: number): number {
#   return spreadsTwice(i, 2, 3);
# }
# function byNew(i: number): number {
#   return constructs(i, 2, 3).sum;
# }
# function byMax(i: number): number {
#   return largest(i, 2, 300);
# }
# const table: ((i: number) => number)[] = [bySpread, byApply, behindName, throughTwo, byNew, byMax];
# let total = 0;
# for (let index = 0; index < table.length; index++) total += table[index](+input);
# (globalThis as any).answer = total;
# export {};
# -- end of source
# FORM: AsRead
# OPTIONS: heat=EverythingIsCold
# RUN: pipeline FinishBirths
# RUN(X64): lower-to-air size f8 f9 f10 f11 f12 f13
# REQUIRES(X64): x86_64 unsanitized-code not-windows

