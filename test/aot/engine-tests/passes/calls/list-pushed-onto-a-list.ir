# -- source: list-pushed-onto-a-list.ts
# // `list.push(...other)` and its two older spellings append the elements of the other list in one operation and read the new length. No list of arguments is made and
# // Array.prototype.push is not called, but for a list that would not fit on the stack.
# declare const input: any;
# const other: number[] = [4, 5, 6];
# function spreads(list: number[]): number {
#   return list.push(...other);
# }
# function applies(list: number[]): number {
#   return list.push.apply(list, other);
# }
# function appliesThePrototypes(list: number[]): number {
#   return Array.prototype.push.apply(list, other);
# }
# function ignoresTheLength(list: number[]): number[] {
#   list.push(...other);
#   return list;
# }
# (globalThis as any).answer = [spreads([+input]), applies([+input]), appliesThePrototypes([+input]), ignoresTheLength([+input])];
# -- end of source
# FORM: AsRead
# OPTIONS: disable=pass:InlineCalls
# RUN: pipeline FinishBirths

