# -- source: short-function-whose-rest-goes-only-into-lists-copied-into-caller.ts
# // A short function without a loop whose rest parameter goes nowhere but into the lists of its calls is copied into whoever calls it directly, however seldom that runs:
# // the caller has made the rest parameter for the call, so both lists go and the arguments reach the callee in registers. Behind a first argument, behind `call`,
# // into a callback that was handed in, and into a method.
# declare const input: any;
# function target(a: number, b: number, c: number): number {
#   let sum = a;
#   for (let index = 0; index < b; index++) sum += c * index;
#   return sum;
# }
# function behindFirst(...args: [number, number]): number {
#   return target(1, ...args);
# }
# function behindCall(this: unknown, ...args: [number, number, number]): number {
#   return target.call(this, ...args);
# }
# function done(callback: (error: null, ...results: number[]) => number, ...results: number[]): number {
#   return callback(null, ...results);
# }
# function receive(error: null, a: number, b: number, c: number): number {
#   return error === null ? target(a, b, c) : 0;
# }
# class Logger {
#   total = 0;
#   write(a: number, b: number, c: number): number {
#     return (this.total = target(a, b, c));
#   }
#   log(...args: [number, number, number]): number {
#     return this.write(...args);
#   }
# }
# const logger = new Logger();
# // It keeps its rest parameter, so it stays a call.
# let kept: number[] = [];
# function keeps(...args: number[]): number {
#   kept = args;
#   return target(1, ...(args as [number, number]));
# }
# function first(i: number): number {
#   return behindFirst(i, 3);
# }
# function second(i: number): number {
#   return behindCall(i, 2, 3);
# }
# function third(i: number): number {
#   return done(receive as any, i, 2, 3);
# }
# function fourth(i: number): number {
#   return logger.log(i, 2, 3);
# }
# function fifth(i: number): number {
#   return keeps(i, 3) + kept.length;
# }
# const table: ((i: number) => number)[] = [first, second, third, fourth, fifth];
# let total = 0;
# for (let index = 0; index < table.length; index++) total += table[index](+input);
# (globalThis as any).answer = total;
# export {};
# -- end of source
# FORM: AsRead
# OPTIONS: heat=EverythingIsCold
# RUN: pipeline FinishBirths

