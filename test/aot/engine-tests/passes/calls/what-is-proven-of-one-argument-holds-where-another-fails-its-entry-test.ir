# One argument of `step` is parsed data that is held to a class, so the test at the entrance fails and the call goes on in the generic version.
# What is proven of the other arguments is proven there too: the fields of `point` are read from their slots, each once, and only `host.port` is read by name.
# -- source: what-is-proven-of-one-argument-holds-where-another-fails-its-entry-test.ts
# class Host {
#   name: string;
#   port: number;
#   constructor(name: string, port: number) {
#     this.name = name;
#     this.port = port;
#   }
# }
# class Point {
#   x: number;
#   y: number;
#   constructor(x: number, y: number) {
#     this.x = x;
#     this.y = y;
#   }
# }
# function step(host: Host, point: Point, scale: number): number {
#   let sum = point.x * scale + point.y;
#   sum += point.x * point.y;
#   return sum + host.port;
# }
# const hosts: Host[] = [new Host("made", 2), JSON.parse('{"name":"parsed","port":2}') as Host];
# const points = [new Point(1, 2), new Point(3, 4)];
# let total = 0;
# for (let i = 0; i < 100; ++i) total += step(hosts[i & 1]!, points[i & 1]!, i & 7);
# console.log(total);
# -- end of source
