# // The closure captures the field that was read first, a count that the method keeps, and the parameters.
# function Helper() {
#   this.calls = 0;
#   this.tag = "h";
# }
# Helper.prototype.define = function (target, key, depth) {
#   const tag = this.tag;
#   const mine = ++this.calls;
#   target[key] = function (more) {
