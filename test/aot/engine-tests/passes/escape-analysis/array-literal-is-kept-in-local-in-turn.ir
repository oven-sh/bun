    v1 = Convert v0 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = String string=""
    v3 = Convert v2 declared={type=undefined|null|string flags=[IsExpected]}
    v4 = Integer
    v5 = Convert v4 declared={type=number flags=[IsExpected]}
    Jump -> next b1(v3, v5)
  b1(v6, v7):
    LoopHint
    v9 = Call v1 calleeName="main"
    v10 = Convert v9 declared={type=undefined|null|string flags=[IsExpected]}
    v11 = Increment v7
    v12 = Convert v11 declared={type=number flags=[IsExpected]}
    Jump -> next b1(v10, v12)
}
