# What the host calls for every request or message runs as often as what a loop calls. In a very large program such a handler is cold, as every function that no loop of the program calls,
# but neither it nor what it calls is compact. A callback that is called once later is
# FORM: AsRead
# OPTIONS: only-passes=EstimateHeat limit=MaxWarmCodeValues:1
# RUN: pipeline EstimateHeat
# CHECK: f1 Cold 10 1
# CHECK-NEXT: f2 Cold 10 1
# CHECK-NEXT: f3 Cold 10 1
# CHECK-NEXT: f4 Cold 10 1
# CHECK-NEXT: f5 Compact 10 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Options" fields=[{key="fetch" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=BunServe
    v3 = Call v2, -, v1
    v4 = NewClosure function=f4
    v5 = Builtin builtin=EventEmitterPrototypeOn
    v6 = Builtin builtin=Process
    v7 = String string="message"
    v8 = Call v5, v6, v7, v4
    v9 = NewClosure function=f5
    v10 = Builtin builtin=QueueMicrotask
    v11 = Call v10, -, v9
    Return
}

