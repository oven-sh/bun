# The step over a Map or a Set answers undefined where it finds no entry, and its results stand in front of the test for an entry: they are never `never`, so the code behind a loop over a collection that is never filled stays.
# On the edge that has an entry the results are what the collection holds
#   const never = new Map(); for (const entry of never) print(entry)
#   const onOnePath = new Set(); if (flag()) onOnePath.add("a"); for (const element of onOnePath) print(element.length)
#   const elsewhere = new Map(); fill(elsewhere); for (const [key, value] of elsewhere) print(key, value)
#   print("end")
# The loops over the two collections that flow follows are expanded in front of the optimizer, the loop over the one that unknown code has seen by ExpandIteration
# RUN: pipeline ExpandProvenIterations
# CHECK-LABEL: function f0
# CHECK: Map<never, never, proven,
# CHECK: [[stepOfNever]]: undefined = MapNext
# CHECK: [[hasEntry]]: boolean = ResultAt [[stepOfNever]]
# CHECK: undefined = ResultAt [[stepOfNever]] index=2
# CHECK-NEXT: undefined = ResultAt [[stepOfNever]] index=3
# CHECK-NEXT: Branch [[hasEntry]]
# CHECK: [[stepOnOnePath]]: undefined = SetNext
# CHECK: [[element]]: undefined|"a" = ResultAt [[stepOnOnePath]] index=2
# CHECK: String string="end"
# CHECK: "a" = AssumeType [[element]] castType="a"
# RUN(LATER): pipeline ExpandIteration
# LATER-LABEL: function f0
# LATER: calleeName="fill"
# LATER: [[stepElsewhere]]: undefined = MapNext
# LATER: anything {{*}}= ResultAt [[stepElsewhere]] index=2
# LATER: String string="end"
# RUN(FINAL): pipeline CheckPlacement
# FINAL-LABEL: function f0
# FINAL: String string="end"

module m0 path="main.js" displayPath="main.js" body=f0
