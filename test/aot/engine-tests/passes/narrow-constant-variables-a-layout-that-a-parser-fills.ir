# interface Config { port: number }   interface Limits { most: number }   const DEFAULTS: Config = { port: 80 }; const LIMITS: Limits = { most: 5 }
# const parsed = JSON.parse(process.argv[2]) as Config; console.log(parsed.port, DEFAULTS.port, LIMITS.most)
# A parser makes objects of Config out of whatever its text holds, so `port` keeps its type. The literal alone makes a Limits, so `most` is 5
# FORM: AsRead
# RUN: pipeline NarrowConstantVariables
# CHECK: layout L0 name="Config" {{*}}{key="port" declared={type=number} {{*}}observedUses=[ReachesTypedParse, IsParsedByType]
# CHECK: layout L1 name="Limits" {{*}}{key="most" declared={type=5}

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="Config" module=m0 fields=[{key="port" declared={type=number} flags=[IsRequired]}]
layout L1 name="Limits" module=m0 fields=[{key="most" declared={type=number} flags=[IsRequired]}]
data d0 root=Object{layout=L0 members=[{key="port" value=Number{value=80}}]} module=m0
data d1 root=Object{layout=L1 members=[{key="most" value=Number{value=5}}]} module=m0

function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Data data=d0
    v1 = Convert v0 declared={type=undefined|null|L0 flags=[OmitsNull, OmitsUndefined]}
    v2 = Data data=d1
    v3 = Convert v2 declared={type=undefined|null|L1 flags=[OmitsNull, OmitsUndefined]}
    v4 = Builtin builtin=JSON
    v5 = PropGet v4 key="parse"
    v6 = Convert v5 declared={type=builtin(JSONParse) flags=[IsExpected]}
    v7 = Builtin builtin=Process
    v8 = PropGet v7 key="argv"
    v9 = Convert v8 declared={type=builtin(ProcessArgv) flags=[IsExpected]}
    v10 = Integer integer=2
    v11 = ElemGet v9, v10
    v12 = Convert v11 declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]} illTypedCause=ContainerWriterUnseen
    v13 = Call v6, v4, v12 calleeKey="parse" calleeName="JSON.parse"
    v14 = Convert v13 declared={type=undefined|null|L0 flags=[IsExpected]}
    v15 = Convert v14 declared={type=undefined|null|L0 flags=[OmitsNull, OmitsUndefined]} illTypedCause=FromLooseType
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="console" [isFreeName]
    v18 = Convert v17 declared={type=builtin(Console) flags=[IsExpected]}
    v19 = PropGet v18 key="log"
    v20 = Convert v19 declared={type=builtin(ConsoleLog) flags=[IsExpected]}
    v21 = PropGet v15 key="port"
    v22 = PropGet v1 key="port"
    v23 = PropGet v3 key="most"
    v24 = Call v20, v18, v21, v22, v23 calleeKey="log" calleeName="console.log"
    v25 = Undefined
    Return v25
}
