# The receiver is only expected to be of a host class, and the callee may be the method of that class or anything else. The rounds of the Optimize schedule end by themselves.
# FORM: AsRead
# RUN: pipeline EliminateGuards
# STATISTIC: MaxOptimizationRoundsHits = 0
# LOSS: MaxOptimizationRounds x0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}

function f1 name="stopListening" parameters=[{type=undefined|null|AbortSignal flags=[IsExpected]}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything ~ undefined|null|AbortSignal, v1: anything):
    v2 = PropGet v0 key="removeEventListener"
    v3 = String string="abort"
    v4 = Call v2, v0, v3, v1 calleeKey="removeEventListener"
    Return
}
