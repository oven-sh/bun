#   show("last " + on, { a: 1, ...(on && { c: 3 }) });
#   show("alone " + on, { ...(on && { c: 3 }) });
#   show("replaces what stands " + on, { a: 1, b: 2, ...(on && { a: 10 }), c: 3 });
#   show("is replaced " + on, { a: 1, ...(on && { b: 2 }), b: 20 });
