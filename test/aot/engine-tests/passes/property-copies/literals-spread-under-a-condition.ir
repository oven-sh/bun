#   show("an index " + on, { a: 1, ...(on && { 7: "seven", b: 2 }), c: 3 });
#   const symbol = Symbol("s");
#   show("a symbol " + on, { a: 1, ...(on && { [symbol]: 2, b: 3 }), c: 4 });
