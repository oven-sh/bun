#   show("a number for nothing " + on, { a: 1, ...((on ? 0 : { b: 2 }) as object) });
#   show("in order " + on, { a: tick("a"), ...(on && { b: tick("b"), c: tick("c") }), d: tick("d") });
# }
# // Not plain data, or seen by somebody else: these are copied as ever.
# for (const on of [true, false]) {
