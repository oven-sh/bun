# -- source: merged-objects-are-read-spread-on-way.js
# // Merged objects are read a spread on one way only.
# function productsOf(merged) {
#   let sum = 0;
#   for (let turn = 0; turn < 100; turn++) sum = (sum + merged.a * merged.b - merged.c) | 0;
#   return sum;
# }
# function sumsOf(merged) {
#   let sum = 0;
#   for (let turn = 0; turn < 100; turn++) sum += merged.a + merged.b + merged.c;
#   return sum;
# }
# function show(label, merged) {
#   console.log(label, productsOf(merged), sumsOf(merged), merged.a, merged.b, merged.c, "a" in merged, "b" in merged, "c" in merged);
# }
# function list(label, merged) {
#   console.log(label, Object.keys(merged).join(), JSON.stringify(merged), Reflect.ownKeys(merged).map(String).join());
# }
# const defaults = { a: 1, b: 2 };
# function spread(flag, options) { return { ...defaults, ...(flag && options) }; }
# function spreadEither(flag, options) { return { ...defaults, ...(flag ? options : { d: 4 }) }; }
# function assign(flag, options) { return Object.assign({}, defaults, flag ? options : undefined); }
# for (const flag of [true, false]) {
#   show("spread", spread(flag, { c: 3 }));
#   show("either", spreadEither(flag, { c: 3 }));
#   show("assigned", assign(flag, { c: 3 }));
# }
# -- end of source
