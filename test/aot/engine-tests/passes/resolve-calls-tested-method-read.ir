# What was read goes on as an argument of an edge, to where the ways that have failed a test meet, and is only called there too.
function f17 name="the-read-goes-on-as-an-argument-of-an-edge" parameters=[{type=L0 flags=[IsExpected]}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything ~ L0, v1: anything, v2: boolean):
    v3 = PropGet v0 key="run"
    v4 = Call v1
    Branch v2 -> taken b1(), notTaken b2(v3)
  b1():
    v5 = Call v3, v0, v4 calleeKey="run"
    Return v5
  b2(v6: anything) frequency=Unlikely:
    v7 = Call v6, v0, v4 calleeKey="run"
    Return v7
}
# CHECK-LABEL: function f17 name="the-read-goes-on-as-an-argument-of-an-edge"
# CHECK-NEXT: b0(v0: anything ~ L0, v1: anything, v2: boolean):
# CHECK-NEXT: = TypeTest v0 testedType=L0
# CHECK: v3: f1 = NewClosure function=f1
# CHECK-NEXT: v4: anything = Call v1
# CHECK-NEXT: Branch v2 -> taken {{*}}(), notTaken {{*}}(v3{{*}})
# And where it is passed on to somebody who keeps it, it is the object on the prototype, which the closure table holds.
function f18 name="the-argument-of-the-edge-is-returned" parameters=[{type=L0 flags=[IsExpected]}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything ~ L0, v1: anything, v2: boolean):
    v3 = PropGet v0 key="run"
    v4 = Call v1
    Branch v2 -> taken b1(), notTaken b2(v3)
  b1():
    v5 = Call v3, v0, v4 calleeKey="run"
    Return v5
  b2(v6: anything) frequency=Unlikely:
    Return v6
}
# CHECK-LABEL: function f18 name="the-argument-of-the-edge-is-returned"
# CHECK-NEXT: b0(v0: anything ~ L0, v1: anything, v2: boolean):
# CHECK-NEXT: = TypeTest v0 testedType=L0
# CHECK: v3: f1 = NewClosure function=f1 [isHeldByClosureTable]
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = PropGet v0 key="run"
# CHECK-NOT: NewClosure
