function f12 name="unknown-code-between-read-and-call" parameters=[{type=L0 flags=[IsExpected]}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything ~ L0, v1: anything):
    v2 = PropGet v0 key="run"
    v3 = Call v1
    v4 = Call v2, v0, v3 calleeKey="run"
    Return v4
}
# The function that a call enters is read before the arguments are computed: the tests stand in front of the read, and what the argument runs comes too late.
# CHECK-LABEL: function f12 name="unknown-code-between-read-and-call"
# CHECK-NEXT: b0(v0: anything ~ L0, v1: anything):
# CHECK-NEXT: = TypeTest v0 testedType=L0
