# // The loop asks six questions ahead of its turns. Behind all six answers it still counts as a loop that runs often, so its turns are written out.
# interface Table { step: number | string }
# function addUp(first: Table, second: Table, third: Table, start: number, turns: number): number {
#   let total = start;
#   for (let i = 0; i < turns; i++) total += ((first.step as number) & 1) + ((second.step as number) & 2) + ((third.step as number) & 4) + (i & 1);
#   return total;
# }
# function tableWith(step: number | string): Table {
#   const made = Object.create(null);
#   made[Date.now() > 0 ? "step" : "pace"] = step;
#   return made;
# }
# const one = tableWith(1);
# const two = tableWith(2);
# const four = tableWith(4);
# const words = tableWith("7");
