# -- source: a-loop-that-asks-for-a-name-once-stores-to-fields-under-other-names.ts
# // `table.step` is asked for once, ahead of the loop, where no turn can change what is found. A store to a field under another name cannot: `adds` gets a loop without the read.
# // What it reads of that field changes from turn to turn, so that read stays in the loop, and the rest goes ahead all the same.
# // A store to a field under the same name can change what is found, since the table may be that object or lie below it: `walks` keeps its read.
# class Pace { step = 1; total = 0 }
# interface Table { step: number }
# function adds(table: Table, pace: Pace, turns: number): number {
#   let sum = 0;
#   for (let i = 0; i < turns; i++) { pace.total = pace.total + 1; sum = (sum + table.step) | 0; }
#   return sum;
# }
# function walks(table: Table, pace: Pace, turns: number): number {
#   let sum = 0;
#   for (let i = 0; i < turns; i++) { pace.step = i & 3; sum = (sum + table.step) | 0; }
#   return sum;
# }
# function tableWith(step: number): Table {
#   const made = Object.create(null);
#   made[Date.now() > 0 ? "step" : "pace"] = step;
#   return made;
# }
# const table = tableWith(1);
# const pace = new Pace();
# let seen = 0;
# for (let round = 0; round < 100; round++) seen += adds(table, pace, 100) + walks(table, pace, 100) + walks(Object.create(pace), pace, 100);
# console.log(String(seen), String(pace.total));
# -- end of source
