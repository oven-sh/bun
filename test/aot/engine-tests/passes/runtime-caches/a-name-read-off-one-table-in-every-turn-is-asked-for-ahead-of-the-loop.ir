# -- source: a-name-read-off-one-table-in-every-turn-is-asked-for-ahead-of-the-loop.ts
# // `table.step` may run a getter, so by itself it stays in the loop. Where a turn runs no other code, what the read's site remembers is asked once, ahead of the loop.
# // A test of the answer is made there too, so the call behind its other answer does not keep the read in the loop. Any other answer enters a copy of the loop as it was.
# // A loop that calls something in every turn, or stores to an object, keeps its read.
# interface Table { step: number | string }
# function quiet(table: Table, turns: number): number {
#   let sum = 0;
#   for (let i = 0; i < turns; i++) sum = (sum + (table.step as number)) | 0;
#   return sum;
# }
# function decided(table: Table, turns: number, log: (turn: number) => void): number {
#   let sum = 0;
#   for (let i = 0; i < turns; i++) {
#     const step = table.step;
#     if (typeof step === "number") sum = (sum + step) | 0;
#     else log(i);
#   }
#   return sum;
# }
# function calls(table: Table, turns: number, each: (turn: number) => void): number {
#   let sum = 0;
#   for (let i = 0; i < turns; i++) { each(i); sum = (sum + (table.step as number)) | 0; }
#   return sum;
# }
# function stores(table: Table, turns: number, other: { [name: string]: number }, name: string): number {
#   let sum = 0;
#   for (let i = 0; i < turns; i++) { other[name] = i; sum = (sum + (table.step as number)) | 0; }
#   return sum;
# }
# function tableWith(step: number | string): Table {
#   const made = Object.create(null);
#   made[Date.now() > 0 ? "step" : "pace"] = step;
#   return made;
# }
# const table = tableWith(1);
# const words = tableWith("one");
# let logged = 0;
# let seen = 0;
# for (let round = 0; round < 100; round++) {
#   seen += quiet(table, 100) + decided(table, 100, turn => { logged += turn; }) + decided(words, 100, turn => { logged += turn; });
#   seen += calls(table, 100, turn => { table.step = turn & 3; }) + stores(table, 100, Object.create(null), "n" + round);
# }
# console.log(String(seen), String(logged));
# -- end of source
