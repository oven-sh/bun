# The type flow gives a field that holds arrays has proofs no test can give: a parser, validating or not, and a validator test the class of the array they created and assume the rest
# The results are handed to a built-in that looks at its operand and neither keeps nor writes it: a callee nobody knows may store into the arrays, and then nothing is proven of them
# FORM: AsRead
# OPTIONS: report=Declines only-passes=ResolveBuiltins,SelectTypedResults
# RUN: pipeline SelectTypedResults
# STATISTIC: TypedResultsSelected = 3
# STATISTIC: ParsersCreated = 6
# STATISTIC: ValidatorsCreated = 3
# CHECK-NOT: decline

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
expectedresult x0 type=L3 layouts=[L2, L3] validation=[{shape=Object{layout=L3 members=[{key="items" node=1 field=0}]} type=L3}, {shape=Array{element=2} type=Array<L2>}, {shape=Object{layout=L2 members=[{key="id" node=3 field=0}]} type=L2}, {shape=Primitive{primitive=Number} type=number}]
layout L0 name="Row" module=m0 position=10 fields=[{key="id" declared={type=number}}]
layout L1 name="Page" module=m0 position=20 fields=[{key="items" declared={type=Array<L0>}}, {key="total" declared={type=number}}]
layout L2 name="CheckedRow" module=m0 position=30 fields=[{key="id" declared={type=number}}]
layout L3 name="CheckedPage" module=m0 position=40 fields=[{key="items" declared={type=Array<L2>}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="text" [isFreeName]
    v2 = ToString v1
    v3 = Builtin builtin=ArrayIsArray
    v4 = CallDirect v2 function=f1
    v5 = Call v3, -, v4
    v6 = CallDirect v2 function=f2
    v7 = Call v3, -, v6
    v8 = PropGet v0 key="input" [isFreeName]
    v9 = CallDirect v8 function=f3
    v10 = Call v3, -, v9
    Return
}

function f1 name="converted" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = Builtin builtin=JSONParse
    v2 = Call v1, -, v0
    v3 = Convert v2 declared={type=undefined|null|L1} illTypedCause=FromLooseType
    Return v3
}
# CHECK-LABEL: function f1 name="converted"
# CHECK: = CallDirect {{*}} function=[[parserOfPage]]

function f2 name="validated" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = Builtin builtin=JSONParse
    v2 = Call v1, -, v0 expectedResult=x0
    Return v2
}
# CHECK-LABEL: function f2 name="validated"
# CHECK: = CallDirect {{*}} function=[[parserOfCheckedPage]]

function f3 name="validatedValue" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=BunBundleValidate
    v2 = Call v1, -, v0 expectedResult=x0
    Return v2
}
# CHECK-LABEL: function f3 name="validatedValue"
# CHECK: = CallDirect v0 function=[[validatorOfCheckedPage]]
# CHECK: function [[parserOfRows]] {{*}}role=Parser {{*}}type=undefined|Array<L0>}
# CHECK: function [[parserOfPage]] {{*}}role=Parser
# CHECK: ({{*}}: undefined|Array<L0>, {{*}}: boolean, {{*}}: undefined|number, {{*}}):
# CHECK-NEXT: LoopHint
# CHECK: ([[items]]: undefined|Array<L0>, {{*}}: boolean, {{*}}: undefined|number, {{*}}):
# CHECK: = CallDirect {{*}} function=[[parserOfRows]]
# CHECK: [[isArray]]: boolean = TypeTest [[items]] testedType=Array<L0>
# CHECK-NEXT: Branch [[isArray]] -> taken [[whenArray]](| 0), notTaken
# CHECK: [[whenArray]]([[array]]: Array<L0>):
# CHECK-NEXT: [[assumed]]: {{*}}pristine[Storage, Names]> = AssumeType [[array]] castType=Array<
# CHECK: = NewObject -, [[assumed]], {{*}} layout=L1 fields=[0, 1]
# CHECK: function [[parserOfCheckedPage]] {{*}}role=ValidatingParser
# CHECK: [[assumedChecked]]: {{*}}pristine[Storage, Names]> = AssumeType {{*}} castType=Array<
# CHECK: = NewObject -, [[assumedChecked]] layout=L3 fields=[0]
# CHECK: function [[validatorOfCheckedPage]] {{*}}role=Validator
# CHECK: [[assumedCopy]]: {{*}}pristine[Storage, Names]> = AssumeType {{*}} castType=Array<
# CHECK: = CloneAs {{*}}, [[assumedCopy]] layout=L3 fields=[0]
