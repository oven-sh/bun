# STATISTIC: ValidatorsCreated = 1

module m0 path="main.js" displayPath="main.js"
expectedresult x0 type=L0 layouts=[L0, L1] validation=[{shape=Object{layout=L0 members=[{key="a" node=1 field=0}, {key="b" node=2 field=1}]} type=L0}, {shape=Primitive{primitive=Number} type=number}, {shape=Object{layout=L1 members=[{key="x" node=1 field=0}]} type=L1}]
expectedresult x1 type=L1 layouts=[L1] validation=[{shape=Object{layout=L1 members=[{key="x" node=1 field=0}]} type=L1}, {shape=Primitive{primitive=Number} type=number}]
layout L0 name="Outer" fields=[{key="a" declared={type=number}}, {key="b" declared={type=L1}}]
layout L1 name="Inner" fields=[{key="x" declared={type=number}}]

function f0 name="threeNodes" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = CallBuiltin -, v0 overload=BunBundleValidate/0 expectedResult=x0
    Return v1
}
