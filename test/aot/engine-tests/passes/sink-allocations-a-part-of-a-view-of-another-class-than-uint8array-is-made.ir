# FORM: Prepared
# RUN: pass ResolveBuiltins SinkAllocations

module m0 path="main.js" displayPath="main.js"
function f0 name="aPartOfFloatsIsMade" parameters=[{type=TextEncoder}, {type=string}, {type=Float64Array<number, pristine[Names]>}, {type=int[0, 100]}, {type=int[0, 100]}] results=[{type=anything}] {
  b0(v0: TextEncoder, v1: string, v2: Float64Array<number, pristine[Names]>, v3: int[0, 100], v4: int[0, 100]):
    v5 = TypedArrayRange v2, v3, v4 valueType=Float64Array<number, pristine[Names]>
    v6 = Builtin builtin=TextEncoderPrototypeEncodeInto
    v7 = Call v6, v0, v1, v5
    v8 = PropGet v7 key="written"
    Return v8
}
# CHECK-LABEL: function f0 name="aPartOfFloatsIsMade"
# CHECK: TypedArrayRange v2, v3, v4
# CHECK-NOT: _inRanges
# CHECK: overload=TextEncoderPrototypeEncodeInto/{{*}} builtinCallForm=AnyReceiver
# CHECK-NOT: _inRanges

