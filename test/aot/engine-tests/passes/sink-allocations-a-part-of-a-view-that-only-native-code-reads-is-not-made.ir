# A native function whose row says that it only reads or writes the contents of a view takes an address and a count. A part of a view that goes nowhere else is not made: the call takes the view it was cut out of, and where the part starts and ends.
# FORM: Prepared
# RUN: pass SinkAllocations

module m0 path="main.js" displayPath="main.js"
variable g0 name="kept" declared={type=anything} initialization=Undefined
function f0 name="straightIntoTheCall" parameters=[{type=TextEncoder}, {type=string}, {type=Uint8Array<int[0, 255], pristine[Names]>}, {type=int[0, 100]}, {type=int[0, 100]}] results=[{type=anything}] {
  b0(v0: TextEncoder, v1: string, v2: Uint8Array<int[0, 255], pristine[Names]>, v3: int[0, 100], v4: int[0, 100]):
    v5 = TypedArrayRange v2, v3, v4 valueType=Uint8Array<int[0, 255], pristine[Names]>
    v6 = CallBuiltin v0, v1, v5 overload=TextEncoderPrototypeEncodeInto/0
    v7 = PropGet v6 key="written"
    Return v7
}
# CHECK-LABEL: function f0 name="straightIntoTheCall"
# CHECK-NOT: TypedArrayRange
# CHECK: [[counts]]: {{*}} = CallBuiltin -, v1, v2, v3, v4 overload=CompilerHelpersTextEncoder_prototype_encodeInto_inRanges/0 builtinCallForm=Fields
# CHECK-NOT: TypedArrayRange

