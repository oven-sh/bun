# -- source: callback-handed-down-stores-string.ts
# // A typed caller reads an object, makes a call and reads it again. A function that the caller hands to the callee stores a string into a number field of the object, which an object literal has made.
# type Pair = { left: number; right: number; note?: string };
#
# let victim: Pair | null = null;
# function strike(): boolean {
#   const target = victim;
#   if (target === null) return false;
#   victim = null;
#   (target as any).right = "text";
#   return true;
# }
#
# function callee(round: number, action: () => boolean): number {
#   action();
#   return round & 3;
# }
#
# function holder(p: Pair, round: number): string {
#   const before = p.left + p.right + ":" + p.note;
#   const got = callee(round, strike);
#   const after = p.left + "," + (p.right + 1) + "," + typeof p.right;
#   return before + " " + got + " " + after;
# }
#
# function outer(round: number): string {
#   const p: Pair = { left: round, right: round + 1 };
#   const before = p.left + p.right + ":" + p.note;
#   if (round === 150 || round === 151 || round === 299) victim = p;
#   const inner = holder(p, round);
#   const after = p.left + "," + (p.right + 1) + "," + typeof p.right;
#   return before + " [" + inner + "] " + after;
# }
#
# let digest = 0;
# for (let round = 0; round < 300; round++) {
#   const line = outer(round);
#   for (let index = 0; index < line.length; index++) digest = (digest * 31 + line.charCodeAt(index)) | 0;
#   if (round < 2 || (round >= 149 && round <= 152) || round === 299) console.log(round + ": " + line);
# }
# console.log("digest " + digest);
# -- end of source
# FORM: AsRead
# RUN: pipeline FinishBirths
# RUN(WHOLE): compile
# WHOLE: image not empty

