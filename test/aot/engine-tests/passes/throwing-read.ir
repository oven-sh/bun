# A read that always throws, under a try, in a loop. SeparateUnlikelyLoopPaths first makes two of the read: one that only asks the tables, which runs nothing, and the read itself on its failing side.
# On the path where the receiver is undefined the code behind the first goes, the failing side with it. What is left must be the read that throws: else control runs into nothing.
# -- source: throwing-read.js
# function caught(e) { return e instanceof Error && e.message.startsWith("fail ") ? e.message : "threw " + typeof e; }
# function f(L) {
#   let z = 0;
#   for (let i = 0; i < L.length; i++) {
#     try { L[i].x.y; } catch (err) { z++; }
#   }
#   return z;
# }
# let r;
# try { r = f([[[1]], {}]); } catch (e) { r = caught(e); }
# console.log(r);
# console.log(Array.from({ length: 3 }).length);
# -- end of source
# FORM: AsRead
# RUN: pipeline SeparateUnlikelyLoopPaths
# CHECK-LABEL: name="f"
# CHECK: never = PropGet [[receiver]] key="y" accessSite=[[site]] @
# CHECK-NEXT: Unreachable

