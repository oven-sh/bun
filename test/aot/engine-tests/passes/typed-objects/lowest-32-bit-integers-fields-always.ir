# -- source: lowest-32-bit-integers-fields-always.ts
# // Fields that hold 32-bit integers from their creation on, among them the lowest ones, are read under keys that are put together at run time and by names that a function is handed.
# const lowest: Record<string, number> = {
#   first: -2147483648,
#   second: -2147483647,
#   third: -2147483646,
#   fourth: -2147483645,
#   fifth: -2147483644,
#   sixth: -2147483643,
#   seventh: -2147483642,
#   zero: 0,
#   highest: 2147483647,
# };
# const sometimes: { low?: number; other: number } = { other: -2147483648 };
# const names: string[] = JSON.parse('["first","second","third","fourth","fifth","sixth","seventh","zero","highest","absent"]');
#
# function readUnder(record: Record<string, number>, head: string, tail: string): number | undefined {
#   return record[head + tail];
# }
# function readFrom(holder: any, name: string): unknown {
#   return holder[name];
# }
#
# for (let round = 0; round < 3; round++) {
#   for (const name of names) {
#     const cut = name.length >> 1;
#     console.log(round, name, readUnder(lowest, name.slice(0, cut), name.slice(cut)), readFrom(lowest, name));
#   }
#   console.log(round, readFrom(sometimes, "low"), readFrom(sometimes, "other"));
#   sometimes.low = round === 0 ? -2147483643 : -2147483648 + round;
# }
# lowest.first = 7;
# lowest.zero = -2147483648;
# for (const name of names) console.log(name, readFrom(lowest, name));
# -- end of source
# FORM: AsRead
# RUN: pipeline FinishBirths
# RUN(WHOLE): compile
# WHOLE: image not empty

