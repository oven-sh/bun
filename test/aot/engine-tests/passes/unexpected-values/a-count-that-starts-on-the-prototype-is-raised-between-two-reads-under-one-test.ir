# function Counter(name) { this.name = name }  Counter.prototype.count = 0  function hitBetweenReads(counter: Counter) { counter.name; counter.count++; return counter.name }
# An object has the count of its prototype until its first increment. Where the test of that slot fails, the count is read by name, and an arm that gave the object its field would come back into the typed code.
# The name is read again behind the increment, under the test that stands in front of it. The read by name may run a getter that deletes the name, so nothing that has read `count` by name comes back in between.
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot
# RUN: pipeline PlaceTypeTests
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Counter" constructor=f1 fields=[{key="name" declared={type=anything}}, {key="count" declared={type=number}}] flags=[IsConstructorFunction]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = PropGet v0 key="prototype"
    v2 = Integer
    PropSet v1, v2 key="count"
    v4 = Integer integer=1
    v5 = Construct v0, -, v4
    v6 = NewClosure function=f2
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="register" [isFreeName]
    v9 = Call v8, -, v5, v6
    v10 = Call v6, -, v5
    Return v10
}
function f1 name="Counter" flags=[HasThis] thisType={type=L0 flags=[IsExpected]} parameters=[{type=anything}] results=[{type=anything}] {
    PropSet v0, v1 key="name"
    Return
}
function f2 name="hitBetweenReads" parameters=[{type=L0 flags=[IsExpected]}] results=[{type=anything}] {
    v1 = PropGet v0 key="name"
    v2 = PropGet v0 key="count"
    v3 = Increment v2
    PropSet v0, v3 key="count"
    v5 = PropGet v0 key="name"
    Return v5
}
# CHECK-LABEL: function {{*}}name="hitBetweenReads"
# CHECK: [[tested]]: guard):
# CHECK-NEXT: {{*}} = GetSlot [[counter]], [[tested]] key="name" {{*}}
# CHECK-NEXT: [[hasCount]]: boolean = IsSlotFilled [[counter]] key="count" {{*}}
# CHECK-NEXT: Branch [[hasCount]] -> taken {{*}}(| 0), notTaken [[copy]]()
# CHECK: PutSlot [[counter]], {{*}} key="count" {{*}}
# CHECK-NEXT: {{*}} = GetSlot [[counter]], [[tested]] key="name" {{*}}
# CHECK-NOT: PutSlotOrAdd
# CHECK: [[copy]]() frequency=Unlikely:
# CHECK-NEXT: {{*}} = PropGet v0 key="count" {{*}}
# CHECK-NOT: PutSlotOrAdd
