# new Bun.Glob("*.js")
# RUN: pipeline Select
# CHECK: overload=BunGlob/1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=Bun
    v1 = PropGet v0 key="Glob"
    v2 = String string="*.js"
    v3 = Construct v1, -, v2
    Return v3
}
