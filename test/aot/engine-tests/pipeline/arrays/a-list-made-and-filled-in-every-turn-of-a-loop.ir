# -- source: a-list-made-and-filled-in-every-turn-of-a-loop.js
# // Every turn of a loop makes a list, keeps it in an object and fills it by storing at the counter of an inner loop.
# // Every copy of the list, also where the loop has a copy for unlikely paths, is made with room for all its elements, and the store of the likely path is expected to put its element behind the last one.
# const state = { words: [] };
# function refill(seed) {
#   const words = (state.words = []);
#   for (let k = 0; k < 16; k++) words[k] = (seed + k * 40503) | 0;
# }
# function mix() {
#   const w = state.words;
#   let sum = 0;
#   for (let k = 0; k < 16; k++) sum = (sum + (w[k] >>> 3) + w[(k + 9) & 15]) | 0;
#   return sum;
# }
# function sums(n) {
#   let sum = 0;
#   for (let i = 0; i < n; i++) {
#     refill(i);
#     sum = (sum + mix()) | 0;
#   }
#   return sum;
# }
# console.log(String(sums(1000)), String(sums(2000)));
# -- end of source
