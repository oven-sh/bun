#
# // What built-ins make, and heirs.
# walkAll("grouped", Map.groupBy([1, 2, 3, 4, 5], value => value % 2 ? "odd" : "even") as Map<string, unknown>);
# note("a union", walkSet(new Set([1, 2]).union(new Set([2, 3]))));
