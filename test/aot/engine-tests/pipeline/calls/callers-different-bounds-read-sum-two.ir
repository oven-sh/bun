# -- source: callers-different-bounds-read-sum-two.ts
# // A function that sums in two nests of loops is called with three different bounds, and each caller reads one field of the object it returns.
# // Flags: --aot-check=verify-each-pass --aot-heat=everything-is-hot
# type Pair = { x: number; y: number; z: number; label: string };
# function make(i: number, n: number): Pair {
#   let a = 0;
#   for (let k = 0; k < n; k++) {
#     a += k * i;
#     if (a > 1e9) a -= 7;
#     for (let j = 0; j < k; j++) {
#       a ^= j;
#       a += (j * 3) % 5;
#     }
#   }
#   let b = 0;
#   for (let k = 0; k < n; k++) {
#     b += k + i;
#     if (b > 1e9) b -= 9;
#     for (let j = 0; j < k; j++) {
#       b ^= j + 1;
#       b += (j * 5) % 7;
#     }
#   }
#   return { x: a, y: b, z: a + b, label: "p" + i };
# }
# export function onlyX(i: number): number {
#   return make(i, 3).x;
# }
# export function onlyY(i: number): number {
#   return make(i, 4).y;
# }
# export function onlyXAgain(i: number): number {
#   return make(i, 5).x + 1;
# }
# console.log(onlyX(1), onlyX(2), onlyY(1), onlyY(2), onlyXAgain(3));
# -- end of source
# FORM: AsRead
# OPTIONS: check=VerifyEachPass heat=EverythingIsHot
# RUN: pipeline FinishBirths
# RUN(WHOLE): compile
# WHOLE: image not empty

