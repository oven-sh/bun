# OPTIONS: heat=EverythingIsHot
# RUN: pipeline GenerateCode
# -- source: main.js
# class Top {
#   step() {
#     return 1;
#   }
# }
# class Middle extends Top {
#   step() {
#     return super.step() + 1;
#   }
# }
# class Low extends Middle {
#   step() {
#     return super.step() + 1;
#   }
# }
# class Lowest extends Low {
#   step() {
#     return super.step() + 1;
#   }
# }
# const lowest = new Lowest();
# function turn(i) {
#   return lowest.step() + (i & 1);
# }
# globalThis.answer = turn(+input);
# -- end of source
