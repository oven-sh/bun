# -- source: object-create-sinks-behind-a-test-of-its-prototype.ts
# // What Object.create makes needs no link where it is handed the prototype of its class. The loop over sinks() gets a test of that in front of the link, and the object is made
# // only where a test fails. kept() hands its object out, so it is made anyway: it keeps the link where it stood and gets no test, which would only cost it.
# const animal = {
#   legs: 4,
#   describe() {
#     return this.legs * 2;
#   },
# };
# const plant = {
#   leaves: 4,
#   describe() {
#     return this.leaves * 2;
#   },
# };
# const held: object[] = [];
# function sinks(i: number): number {
#   const dog = Object.create(animal);
#   dog.legs = i & 7;
#   return dog.describe();
# }
# function kept(i: number): number {
#   const fern = Object.create(plant);
#   fern.leaves = i & 7;
#   held[i & 1] = fern;
#   return fern.describe();
# }
# let sum = 0;
# const turns = Number(process.env.TURNS || 100);
# for (let i = 0; i < turns; i++) sum += sinks(i);
# for (let i = 0; i < turns; i++) sum += kept(i);
# console.log(sum, held.length);
# -- end of source
# FORM: AsRead
# On Windows process.env is a proxy that the library makes, and this file has no library: nothing is known to lie there, and what comes behind the read is not reached.
# REQUIRES: not-windows
# RUN: pipeline FinishBirths

