# -- source: parent-call-of-a-library-function-that-makes-no-object.js
# import { EventEmitter } from "node:events";
# function B(a) { EventEmitter.call(this); this.b = a; }
# Object.setPrototypeOf(B.prototype, EventEmitter.prototype);
# function turn(i) {
#   const v = new B(i & 7);
#   return v.b;
# }
# let sum = 0;
# for (let i = 0; i < 1000; i++) sum = (sum + turn(i)) | 0;
# console.log(sum);
# -- end of source
# FORM: AsRead
# RUN: pipeline FinishBirths
# `EventEmitter.call(this)`: the member is found above the function, and the test says that the function has got none of that name. The guards of a constructor function begin
# with the first object that it makes, and this one makes none: the side where the test fails lets them begin, so the test fails once and not at every call.
