#     let calls = 0;
#     function reads(scale) {
#       let total = 0;
#       calls++;
#       for (let i = 0; i < scale; i++) {
#         try {
#           if (held.n < 0) throw new RangeError("negative");
#           total += held.n;
#         } catch (error) {
