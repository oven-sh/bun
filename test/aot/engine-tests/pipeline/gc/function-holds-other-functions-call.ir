#       if (form === 3) leftBehind.push(handsOut);
#       return form === 2 ? uses : entry;
#     }
#     return scope(watched(weak, { n }));
#   });
# }
#
# function capturesWhatItIsGiven(called) {
#   let calls = 0;
#   function inner(scale) {
#     let total = 0;
#     calls++;
#     for (let i = 0; i < 2; i++) {
#       try {
#         if (scale > 1e6) throw new RangeError("large");
