# What tsc emits for a namespace into a .js file: `{}` in a variable of the file, filled by a function that is made for one call. The members are fields of birth.
# The function ends the birth behind its last store. A reader tests the cell once, and then each member is its constant: the cases of the switch compare with 0, 1 and 2.
# (The front end makes a literal of what is printed for an enum. A member that is a function keeps this from being one.)
# (NarrowConstantVariables sees that nobody comes between the birth of this object and the stores, and leaves no read to test the cell for. It is off here: the test is of objects that it cannot follow.)
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls disable=pass:NarrowConstantVariables
# RUN: pipeline FinishBirths
# CHECK: layout L1 {{*}}key="Start" declared={type=0}{{*}}occupancy=FilledWithValueAtBirth
# CHECK-LABEL: function f2 name="step"
# CHECK: [[state]]: {{*}} = GetSlot v0, {{*}} key="state"
# CHECK: [[namespace]]: L1 = RequireObjectCoercible
# CHECK-NEXT: = HasBirthFieldsFilled [[namespace]]
# CHECK: : 0 = Integer
# CHECK-NEXT: = StrictEq [[state]],
# CHECK: : 1 = Integer
# CHECK: = StrictEq [[state]],
# CHECK-NOT: GetSlotOrUndefined
# CHECK-NOT: IsSlotFilled
# CHECK-LABEL: function f3
# CHECK: PutSlot v0, -, {{*}} key="isLast"
# CHECK-NEXT: TryFinishBirth v0
# -- source: main.js
# var State;
# (function (State) {
#   State.Start = 0;
#   State.Middle = 1;
#   State.End = 2;
#   State.isLast = function (state) {
#     return state === State.End;
#   };
# })(State || (State = {}));
# class Machine {
#   constructor() {
#     this.state = State.Start;
#     this.steps = 0;
#   }
#   step(more) {
#     switch (this.state) {
#       case State.Start:
#         this.state = State.Middle;
#         break;
#       case State.Middle:
#         this.state = more ? State.Start : State.End;
#         break;
#       case State.End:
#         return false;
#       default:
#         throw new Error("unknown state");
#     }
#     this.steps++;
#     return true;
#   }
# }
# const machine = new Machine();
# for (let i = 0; machine.step(i < 100); i++);
# console.log(machine.steps, State.isLast(machine.state));
# -- end of source

