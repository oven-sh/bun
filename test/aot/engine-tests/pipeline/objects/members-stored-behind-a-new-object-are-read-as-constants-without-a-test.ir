# What tsc 3.9 to 4.x prints for an exported enum into a CommonJS file. Nobody sees the object before the function has filled it, so each member is read as its constant
# without a look at the object: the cases of the switch compare with 0, 1, 2 and so on, which B3 makes a table of.
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: pipeline Select
# CHECK-LABEL: name="step"
# CHECK-NOT: HasBirthFieldsFilled
# CHECK-NOT: GetSlot
# CHECK-NOT: GetModuleVariable
# CHECK: [[zero]]: 0 = Integer
# CHECK-NEXT: = StrictEq [[state]], [[zero]] form=Integers
# CHECK: = StrictEq [[state]], {{*}} form=Integers
# CHECK: = StrictEq [[state]], {{*}} form=Integers
# CHECK-LABEL: function
# -- source: main.cjs
# exports.State = void 0;
# var State;
# (function (State) {
#   State[State["S0"] = 0] = "S0";
#   State[State["S1"] = 1] = "S1";
#   State[State["S2"] = 2] = "S2";
#   State[State["S3"] = 3] = "S3";
#   State[State["S4"] = 4] = "S4";
#   State[State["S5"] = 5] = "S5";
#   State[State["S6"] = 6] = "S6";
#   State[State["S7"] = 7] = "S7";
#   State[State["S8"] = 8] = "S8";
#   State[State["S9"] = 9] = "S9";
# })(State = exports.State || (exports.State = {}));
# function step(state, bit) {
#   switch (state) {
#     case State.S0: return bit ? State.S1 : State.S1;
#     case State.S1: return bit ? State.S8 : State.S2;
#     case State.S2: return bit ? State.S5 : State.S3;
#     case State.S3: return bit ? State.S2 : State.S4;
#     case State.S4: return bit ? State.S9 : State.S5;
#     case State.S5: return bit ? State.S6 : State.S6;
#     case State.S6: return bit ? State.S3 : State.S7;
#     case State.S7: return bit ? State.S0 : State.S8;
#     case State.S8: return bit ? State.S7 : State.S9;
#     case State.S9: return bit ? State.S4 : State.S0;
#   }
#   return -1;
# }
# let state = State.S0;
# for (let i = 0; i < 100; i++) state = step(state, i & 1);
# console.log(state);
# -- end of source

module m0 path="main.cjs" displayPath="main.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0
entry module=m0
layout L0 kind=Environment module=m0 fields=[{key=@"binding.0" declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]} flags=[IsRequired] variableName="State"}] ownFieldCount=1
layout L1 module=m0 fields=[{key="State" declared={type=anything}}] ownFieldCount=1
layout L2 module=m0 position=430
data d0 root=Object{layout=L2} module=m0
variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
