# Two records have a function under one name that is only ever called. One arrives at a read by name whose receiver may be any object, and keeps its field. Flow saw the other arrive at no such read: it loses the field.
# FORM: AsRead
# RUN: run-in-shell
# STATISTIC: UnreadFieldsRemoved = 7
# CHECK: record0,record1,record2,
# CHECK-NEXT: trap0,trap1,trap2,
# CHECK-NEXT: apart1apart2
# CHECK: exited with 0
# -- source: main.ts
