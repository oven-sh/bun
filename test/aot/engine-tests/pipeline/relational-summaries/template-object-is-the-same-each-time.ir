# The array of strings that a tagged template hands to its tag is made once for the place in the program: every evaluation hands over the same frozen object. It looks like a literal and is no fresh object: libraries key their caches by it.
# FORM: AsRead
# RUN: lower-to-b3 optimized f0
# REQUIRES: x86_64 unsanitized-code not-windows faulting-loop-polls

module m0 path="template-object-is-the-same-each-time.ts" displayPath="template-object-is-the-same-each-time.ts" body=f0 namespaceLayout=L(m0)
entry module=m0
layout L0 name="Compiled" module=m0 position=1550 fields=[{key="parts" declared={type=number} flags=[IsRequired]}, {key="uses" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
variable g0 name="html" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
variable g1 name="compiled" module=m0 declared={type=undefined|null|absent|WeakMap<undefined|null|Array<undefined|null|string>, undefined|null|L0> flags=[OmitsNull, OmitsUndefined]} flags=[IsImmutable]
