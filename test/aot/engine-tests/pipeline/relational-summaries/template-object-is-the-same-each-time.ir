    v9 = Construct v8 calleeName="WeakMap"
    v10 = Convert v9 declared={type=undefined|null|WeakMap<undefined|null|Array<undefined|null|string>, undefined|null|L0> flags=[OmitsNull, OmitsUndefined]} illTypedCause=FromLooseType
    PutModuleVariable v10 variable=g1
    v12 = NewClosure function=f2
    v13 = Convert v12 declared={type=undefined|null|function|f2 flags=[OmitsNull, OmitsUndefined]}
    v14 = Undefined
    v15 = Convert v14 declared={type=undefined|null|L0 flags=[OmitsNull]} illTypedCause=FromLooseType
    v16 = Integer
    v17 = Convert v16 declared={type=number}
    Jump -> next b1(v15, v17)
  b1(v18: undefined|null|L0, v19: number):
    LoopHint
    v21 = Integer integer=300
    v22 = Less v19, v21
    Branch v22 -> taken b2(| 0), notTaken b3(| 0)
  b2(v23):
    v24 = String string="n"
    v25 = Add v24, v23
    v26 = Call v13, -, v25, v23 calleeName="render"
    v27 = Convert v26 declared={type=undefined|null|L0 flags=[OmitsNull, OmitsUndefined]}
    v28 = Increment v23
    v29 = Convert v28 declared={type=number}
    Jump -> next b1(v27, v29)
  b3(v30):
    v31 = Undefined
    Return v31
}
function f1 name="html" module=m0 position=1660 flags=[HasRestParameter, IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|Array<undefined|null|string> flags=[IsExpected]}, {type=Array flags=[IsFromCompiler, OmitsNull, OmitsUndefined]}] results=[{type=undefined|null|L0 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
