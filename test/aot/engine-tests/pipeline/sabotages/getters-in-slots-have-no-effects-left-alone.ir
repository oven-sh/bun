# Between two reads of a list of numbers stands the read of a getter that lies in a literal. At its fiftieth call the getter stores a text into the list.
# FORM: AsRead
# RUN: run-in-shell
# CHECK: 480 text,2.5,3.5
# CHECK: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 module=m0 fields=[{key="convert" declared={type=number} flags=[IsRequired]}, {key="hits" declared={type=number} flags=[IsRequired]}] declaredOrder=[1, 0]
variable g0 name="list" module=m0 declared={type=undefined|null|absent|Array<number> flags=[OmitsNull, OmitsUndefined]} flags=[IsImmutable]
data d0 root=Array{contents=number elements=[Number{value=1.5}, Number{value=2.5}, Number{value=3.5}]} module=m0

function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Data data=d0
    v3 = Convert v2 declared={type=undefined|null|Array<number> flags=[OmitsNull, OmitsUndefined]}
    PutModuleVariable v3 variable=g0
    v5 = Integer
    v6 = Convert v5 declared={type=number}
    v7 = NewObject -, v6 layout=L0 fields=[1]
    v8 = NewClosure function=f2
    DefineGetter v7, v8 key="convert"
    v10 = FinishObject v7
    v11 = Convert v10 declared={type=undefined|null|L0 flags=[OmitsNull, OmitsUndefined]}
    v12 = Integer
    v13 = Convert v12 declared={type=number}
    v14 = Integer
    v15 = Convert v14 declared={type=number}
    Jump -> next b2(v13, v15)
  b2(v16: number, v17: number):
    LoopHint
    v19 = Integer integer=80
    v20 = Less v17, v19
    Branch v20 -> taken b3(| 0), notTaken b6(| 0)
  b3(v21):
    Jump -> next b4()
  b4():
    v22 = Call v1, -, v11, v3 calleeName="read"
    v23 = Convert v22 declared={type=number}
    v24 = Add v16, v23
    v25 = Convert v24 declared={type=number}
    Jump -> next b5()
  b5():
    v26 = Increment v21
    v27 = Convert v26 declared={type=number}
    Jump -> next b2(v25, v27)
  b6(v28):
    Jump -> next b7()
  b7():
    v29 = Builtin builtin=GlobalThis
    v30 = PropGet v29 key="print" [isFreeName]
    v31 = PropGet v3 key="join"
    v32 = Call v31, v3 calleeKey="join" calleeName="list.join"
    v33 = Convert v32 declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v34 = Call v30, -, v16, v33 calleeName="print"
    v35 = Undefined
    Return v35
}

function f1 name="read" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|L0 flags=[OmitsNull, OmitsUndefined]}, {type=undefined|null|Array<number> flags=[OmitsNull, OmitsUndefined]}] results=[{type=number}] {
  b0(v0: undefined|null|L0, v1: undefined|null|Array<number>):
    Jump -> next b1()
  b1():
    v2 = Integer integer=1
    v3 = ElemGet v1, v2
    v4 = Convert v3 declared={type=number} illTypedCause=ContainerWriterUnseen
    v5 = PropGet v0 key="convert"
    v6 = Convert v5 declared={type=number}
    v7 = Integer integer=2
    v8 = ElemGet v1, v7
    v9 = Convert v8 declared={type=number} illTypedCause=ContainerWriterUnseen
    v10 = Add v4, v6
    v11 = Add v10, v9
    v12 = Convert v11 declared={type=number}
    Return v12
}

function f2 name="convert" module=m0 kind=Getter flags=[HasThis, IsChecked, HasExplicitName] thisType={type=anything} results=[{type=number}] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    v1 = Convert v0 declared={type=undefined|null|L0} illTypedCause=Assertion
    v2 = PropGet v1 key="hits"
    v3 = Increment v2
    v4 = Convert v3 declared={type=number}
    PropSet v1, v4 key="hits"
    v6 = Convert v0 declared={type=undefined|null|L0} illTypedCause=Assertion
    v7 = PropGet v6 key="hits"
    v8 = Integer integer=50
    v9 = StrictEq v7, v8
    Branch v9 -> taken b2(), notTaken b3()
  b2():
    v10 = GetModuleVariable variable=g0
    v11 = CheckInitialized v10 name="list"
    v12 = Convert v11 declared={type=undefined|null|Array flags=[OmitsNull, OmitsUndefined]}
    v13 = Integer
    v14 = String string="text"
    ElemSet v12, v13, v14
    Jump -> next b3()
  b3():
    v16 = Integer
    v17 = Convert v16 declared={type=number}
    Return v17
}
