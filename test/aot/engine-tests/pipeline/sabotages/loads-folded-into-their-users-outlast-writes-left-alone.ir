# An element of a view is read, the same element is stored to, and only then is what was read put to use.
# FORM: AsRead
# RUN: run-in-shell
# CHECK: 1068 180
# CHECK: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0

function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=Int32Array
    v3 = Integer integer=4
    v4 = Construct v2, -, v3 calleeName="Int32Array"
    v5 = Convert v4 declared={type=undefined|null|Int32Array flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v6 = Integer
    v7 = Convert v6 declared={type=number}
    v8 = Integer integer=1
    v9 = Convert v8 declared={type=number}
    Jump -> next b2(v7, v9)
  b2(v10: number, v11: number):
    LoopHint
    v13 = Integer integer=60
    v14 = LessEq v11, v13
    Branch v14 -> taken b3(| 0), notTaken b6(| 0)
  b3(v15):
    Jump -> next b4()
  b4():
    v16 = Integer integer=3
    v17 = Mul v15, v16
    v18 = Call v1, -, v5, v17 calleeName="exchange"
    v19 = Convert v18 declared={type=number}
    v20 = Add v10, v19
    v21 = Convert v20 declared={type=number}
    Jump -> next b5()
  b5():
    v22 = Increment v15
    v23 = Convert v22 declared={type=number}
    Jump -> next b2(v21, v23)
  b6(v24):
    Jump -> next b7()
  b7():
    v25 = Builtin builtin=GlobalThis
    v26 = PropGet v25 key="print" [isFreeName]
    v27 = Integer
    v28 = ElemGet v5, v27
    v29 = Convert v28 declared={type=number} illTypedCause=Assertion
    v30 = Call v26, -, v10, v29 calleeName="print"
    v31 = Undefined
    Return v31
}

function f1 name="exchange" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|Int32Array flags=[OmitsNull, OmitsUndefined]}, {type=number}] results=[{type=number}] {
  b0(v0: undefined|null|Int32Array, v1: number):
    Jump -> next b1()
  b1():
    v2 = Integer
    v3 = ElemGet v0, v2
    v4 = Convert v3 declared={type=number} illTypedCause=Assertion
    v5 = Integer
    ElemSet v0, v5, v1
    v7 = BitXor v4, v1
    v8 = Convert v7 declared={type=number}
    Return v8
}
