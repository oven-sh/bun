# The read of count stands first in a turn and the call that writes it last, so no pass carries the value round the loop: the read stays a load of its own in every turn.
# FORM: AsRead
# RUN: run-in-shell
# OPTIONS: check=MovedLoads
# CHECK: 0 1 2 3 4
# CHECK: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 kind=Instance name="Counter" module=m0 constructor=f2 fields=[{key="count" declared={type=number} flags=[IsRequired]}]
variable g0 name="bump" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
variable g1 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]

function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f2
    v1 = NewClass v0 layout=L0
