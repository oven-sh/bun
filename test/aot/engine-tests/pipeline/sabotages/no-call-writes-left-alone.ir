    v3 = FinishClass v1 layout=L0
    v4 = Convert v3 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v5 = Convert v3 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v6 = Construct v5 calleeName="Counter"
    v7 = Convert v6 declared={type=undefined|null|L0 flags=[OmitsNull, OmitsUndefined]} illTypedCause=UnprovenCallee
    v8 = Data data=d0
    v9 = Convert v8 declared={type=undefined|null|Array<number> flags=[OmitsNull, OmitsUndefined]}
    v10 = Integer
    v11 = Convert v10 declared={type=number}
    Jump -> next b2(v11)
  b2(v12: number):
    LoopHint
    v14 = Integer integer=5
    v15 = Less v12, v14
    Branch v15 -> taken b3(| 0), notTaken b6(| 0)
  b3(v16):
    Jump -> next b4()
  b4():
    v17 = PropGet v9 key="push"
    v18 = PropGet v7 key="count"
    v19 = Call v17, v9, v18 calleeKey="push" calleeName="seen.push"
    v20 = Convert v19 declared={type=number} illTypedCause=DeclarationWithoutBody
    v21 = GetModuleVariable variable=g0
    v22 = Integer integer=2
    v23 = Call v21, -, v7, v22 calleeName="bump"
    Jump -> next b5()
  b5():
    v24 = Increment v16
    v25 = Convert v24 declared={type=number}
    Jump -> next b2(v25)
  b6(v26):
    Jump -> next b7()
  b7():
    v27 = Builtin builtin=GlobalThis
    v28 = PropGet v27 key="print" [isFreeName]
    v29 = PropGet v9 key="join"
    v30 = String string=" "
    v31 = Call v29, v9, v30 calleeKey="join" calleeName="seen.join"
    v32 = Convert v31 declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v33 = Call v28, -, v32 calleeName="print"
    v34 = Undefined
    Return v34
}

function f1 name="bump" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|L0 flags=[OmitsNull, OmitsUndefined]}, {type=number}] results=[{type=anything}] {
  b0(v0: undefined|null|L0, v1: number):
    Jump -> next b1()
  b1():
    v2 = Integer
    v3 = Greater v1, v2
    Branch v3 -> taken b2(| 0), notTaken b4(| 0)
  b2(v4):
    Jump -> next b3()
  b3():
    v5 = GetModuleVariable variable=g0
    v6 = Integer integer=1
    v7 = Sub v4, v6
    v8 = Call v5, -, v0, v7 calleeName="bump"
    ReturnCall v8
  b4(v9):
