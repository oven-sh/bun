# The same where the first call that nobody reads is a call of a known function: for the passes that answer for calls of unknown ones.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass ResolveBuiltins
# CHECK: = CallDirect v0 function=f1
# CHECK: = Call v0

module m0 path="main.js" displayPath="main.js"

function f0 name="callsAKnownFunction" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f1
    v2 = Call v0, -
    Return v2
}
function f1 name="known" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = Call v0, -
    Return
}
