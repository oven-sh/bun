    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="print" [isFreeName]
    v4 = Convert v3 declared={type=undefined|null|f2 flags=[IsExpected]}
    v5 = Integer integer=8
    v6 = Call v1, -, v5 calleeName="spin"
    v7 = Convert v6 declared={type=undefined|null|string flags=[IsExpected]}
    v8 = Call v4, -, v7 calleeName="print"
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="print" [isFreeName]
    v11 = Convert v10 declared={type=undefined|null|f2 flags=[IsExpected]}
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="input" [isFreeName]
    v14 = Call v1, -, v13 calleeName="spin"
    v15 = Convert v14 declared={type=undefined|null|string flags=[IsExpected]}
    v16 = Call v11, -, v15 calleeName="print"
    v17 = Undefined
    Return v17
}

