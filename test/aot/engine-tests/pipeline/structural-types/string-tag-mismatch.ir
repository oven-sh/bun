# (emptied as any).kind = undefined;
# show("no tag", String(often(() => area(emptied))), often(() => radius(emptied)));
#
# const wide: Circle = { ...ring, kind: "circle" };
# show("spread", often(() => area(wide)), often(() => radius(wide)), describe(wide));
