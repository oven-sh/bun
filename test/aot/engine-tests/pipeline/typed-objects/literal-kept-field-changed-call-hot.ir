# }
# function three(x: number): [Flat, Flat, Flat] {
#   return [{ x, y: x + 1 }, new Point(x + 2, x + 3), new Point3(x, x, x)];
# }
# class Holder {
#   inner: Flat;
#   tag = "t";
#   constructor(x: number, kind: number) {
#     this.inner = { x, y: x };
#     change(this.inner, kind);
#     this.inner.y = x + 1;
