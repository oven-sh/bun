# What a type test leaves of a type need not lie inside the type: beside a class that no test tells (Object) an array loses what was proven of it. The way back from the slow copy of a loop into the fast one has such a test,
# so the variable of the loop comes out wider than it went in, by the proofs alone, and an upcast of it that was made earlier would cut it. The upcast becomes what the rules had proven before.
# -- source: upcast-of-a-widened-array.js
# var neverTaken = process.argv.length > 99;
# class NeverTakenKind { v = 1; neverTakenStep = 3; }
# const k0T = [];
# function k0(x, n) {
#   if (neverTaken) x = new NeverTakenKind();
#   let fuel = 3;
#   if (x instanceof NeverTakenKind) neverTakenAddsTo_v(x);
#   let a = 0, b = "s", c = x;
#   const holder = { get v() { [b, a] = [a, b]; return 1; } };
#   while (fuel !== fuel) fuel = [fuel];
#   while (a === c && fuel-- > 0) { holder.v; while (c !== c) c = [c]; k0T.push(c === a); }
#   return c === a;
# }
# console.log([k0(1, 0), k0("a", 0), k0({}, 2), k0T.join()].join(" "));
# -- end of source
# FORM: AsRead
# OPTIONS: check=VerifyEachPass
# RUN: pipeline PlaceTypeTests
# CHECK: name="k0"
# CHECK: testedType=L0|Array<int|"a"|L0|Array<int|"a"|L0|Array|Object, proven, pristine[Storage, Names, Dense]>|Object> @

