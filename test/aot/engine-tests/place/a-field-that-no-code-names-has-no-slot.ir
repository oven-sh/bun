# interface RecordO1 { firstO2?: number; neverNamedO3?: string; lastO4?: number }  made.firstO2 = 1; made[name] = "x"; made.lastO4 = 2
# No code names neverNamedO3, so the field has no slot. A store that finds the name at run time keeps the property with the undeclared ones
# FORM: AsRead
# RUN: plan-slots
# CHECK: L0 CompiledObject {{*}}fields=2
# CHECK-NEXT: "firstO2"
# CHECK-NEXT: "lastO4"
# CHECK-NEXT: extra
# CHECK-NOT: neverNamedO3

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="RecordO1" module=m0 fields=[{key="firstO2" declared={type=undefined|number}}, {key="lastO4" declared={type=undefined|number}}, {key="neverNamedO3" declared={type=undefined|null|string flags=[IsExpected, OmitsNull]} flags=[IsNeverWritten]}] declaredOrder=[0, 2, 1]
variable g0 name="name" module=m0 declared={type=undefined|null|string|absent flags=[OmitsNull, OmitsUndefined]} flags=[IsImmutable]
data d0 root=Object{layout=L0} module=m0

function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=Process
    v3 = PropGet v2 key="env"
    v4 = Convert v3 declared={type=builtin(ProcessEnv) flags=[IsExpected]}
    v5 = PropGet v4 key="NAME"
    v6 = Convert v5 declared={type=undefined|null|string flags=[OmitsNull]} illTypedCause=FromLooseType
    PutModuleVariable v6 variable=g0
    v8 = Data data=d0
    v9 = Convert v8 declared={type=undefined|null|number|string|symbol|bigint|L0 flags=[IsExpected, OmitsNull, OmitsUndefined]}
    v10 = Integer integer=1
    v11 = Convert v10 declared={type=undefined|number}
    PropSet v9, v11 key="firstO2"
    v13 = String string="x"
    v14 = Call v1, -, v9, v13 calleeName="store"
    v15 = Integer integer=2
    v16 = Convert v15 declared={type=undefined|number}
    PropSet v9, v16 key="lastO4"
    v18 = Builtin builtin=GlobalThis
    v19 = PropGet v18 key="console" [isFreeName]
    v20 = Convert v19 declared={type=builtin(Console) flags=[IsExpected]}
    v21 = PropGet v20 key="log"
    v22 = Convert v21 declared={type=builtin(ConsoleLog) flags=[IsExpected]}
    v23 = Builtin builtin=Object
    v24 = Builtin builtin=ObjectKeys
    v25 = Call v24, v23, v9 calleeName="Object.keys"
    v26 = Convert v25 declared={type=undefined|null|Array<undefined|null|string> flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v27 = PropGet v26 key="join"
    v28 = Call v27, v26 calleeKey="join" calleeName="join"
    v29 = Convert v28 declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v30 = Call v22, v20, v29 calleeKey="log" calleeName="console.log"
    v31 = Undefined
    Return v31
}

function f1 name="store" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|number|string|symbol|bigint|L0 flags=[IsExpected, OmitsNull, OmitsUndefined]}, {type=anything}] results=[{type=anything}] {
  b0(v0: undefined|null|number|string|symbol|bigint|L0, v1: anything):
    Jump -> next b1()
  b1():
    v2 = Convert v0 declared={type=undefined|null|object flags=[OmitsNull, OmitsUndefined]} illTypedCause=Assertion
    v3 = GetModuleVariable variable=g0
    v4 = CheckInitialized v3 name="name"
    ElemSet v2, v4, v1
    v6 = Undefined
    Return v6
}
