# A closure of a bound function is slim like the arrow functions beside it, whatever is done with it. In a runtime module, whose functions native code casts, it is slim only where every result of the calls of bind is only called: a read of name or of length and instanceof make it full. More than four captures make it full everywhere. It captures the closure of its target only where the target has captures of its own
# FORM: AsRead
# OPTIONS: only-passes=ResolveCalls,PlaceTypeTests,ChooseCallingConventions
# RUN: plan-slots closures
# RUN(SITES): place program
# STATISTIC: BoundFunctions = 7

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="bun:sqlite" displayPath="bun:sqlite" kind=RuntimeSource exportRule=RuntimeModule runtimeModule=BunSqlite body=f1
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = Undefined
    v4 = NewClosure function=f6
    v5 = PropGet v4 key="bind"
    v6 = Call v5, v4, v3, v2 calleeKey="bind"
    v7 = Call v6
    v8 = PropGet v6 key="name"
    v9 = NewClosure v2 function=f7
    v10 = PropGet v9 key="bind"
    v11 = Call v10, v9, v3, v2 calleeKey="bind"
    v12 = Call v11
    v13 = NewClosure v2, v2 function=f8
    v14 = PropGet v13 key="bind"
    v15 = Call v14, v13, v3, v2, v2 calleeKey="bind"
    v16 = Call v15
    Return
}
function f1 name="sqlite" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = Undefined
    v4 = NewClosure function=f2
    v5 = PropGet v4 key="bind"
    v6 = Call v5, v4, v3, v2 calleeKey="bind"
    v7 = Call v6
    v8 = NewClosure function=f3
    v9 = PropGet v8 key="bind"
    v10 = Call v9, v8, v3, v2 calleeKey="bind"
    v11 = Call v10
    v12 = PropGet v10 key="name"
    v13 = NewClosure function=f4
    v14 = PropGet v13 key="bind"
    v15 = Call v14, v13, v3, v2 calleeKey="bind"
    v16 = Call v15
    v17 = PropGet v15 key="length"
    v18 = NewClosure function=f5
    v19 = PropGet v18 key="bind"
    v20 = Call v19, v18, v3, v2 calleeKey="bind"
    v21 = Call v20
    v22 = InstanceOf v2, v20
