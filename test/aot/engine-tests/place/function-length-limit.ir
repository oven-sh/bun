# A function object records in 16 bits how many parameters its function declares. A function that declares 65,535 and is handed on as a value is placed
# RUN: compile
# CHECK: image

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = NewClosure function=f1
    PropSet v0, v1 key="kept" mode=Strict @10
    Return
}
function f1 name="many" length=65535 thisType={type=anything} results=[{type=anything}] {
    v0 = Integer integer=1
    Return v0
}
