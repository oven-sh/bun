# -- source: function-builtin-calls-iterator-bigint.js
# // Object.fromEntries asks an object for its iterator. The function that answers adds one to a captured variable, which the caller prints in front of the call and behind it.
# function scene() {
#   class Held {}
#   const held = new Held();
#   let ran = 0;
#   const descriptor = { value: true };
#   const descriptors = { size: descriptor };
#   Object.defineProperties(held, descriptors);
#   console.log("ran", ran);
#   function hook() {
#     ++ran;
#     const big = 1n;
#     return { next: big + 1 };
#   }
#   held[Symbol.iterator] = hook;
#   try {
#     Object.fromEntries(held);
#   } catch (error) {}
#   console.log("ran", ran);
#
# }
# for (let i = 0; i < 2; i++) {
#   scene();
# }
# -- end of source
