# Each module record has an entry, and one more ends the table. Only modules with a unique path are listed by path, so External and Runtime records are left out. A RuntimeSource record is also listed by its registry id
# LIBRARY: own
# RUN: tables
# RUN(ROWS): tables modules

variable g0 name="a" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="b" module=m1 declared={type=anything} initialization=Undefined
variable g2 name="c" module=m1 declared={type=anything} initialization=Undefined
variable g3 name="z" module=m3 declared={type=anything} initialization=Undefined
module m0 path="/a.ts" displayPath="a.ts" body=f0 requests=[{target=m1 completes=true}, {target=m3 completes=true}, {target=m4 completes=true}, {target=m5 completes=true}, {target=m6 completes=true}] exports=[{name="a" variable=g0}] requiredNames=[{module=m3 name="r"}]
module m1 path="/b.ts" displayPath="b.ts" body=f1 requests=[{target=m2 completes=true}] exports=[{name="b" variable=g1}, {name="c" variable=g2}]
module m2 path="/c.ts" displayPath="c.ts" body=f2 requests=[{target=m0 completes=true}] exports=[{name="n" kind=Namespace module=m1}]
module m3 path="/d.cjs" displayPath="d.cjs" kind=CommonJs flags=[IsLibrary] exportRule=CommonJs requireResult=ModuleExports syntheticExports=[{name="z" variable=g3 isKnownMember=true}]
module m4 path="x" displayPath="x" kind=External exportRule=CommonJsIgnoringAnnotation externalKind=HostValue referrer=m0
module m5 path="bun:sql" displayPath="bun:sql" kind=Runtime exportRule=RuntimeModule runtimeModule=BunSql
module m6 path="bun:sqlite" displayPath="bun:sqlite" kind=RuntimeSource exportRule=RuntimeModule runtimeModule=BunSqlite body=f4
modulefailure q0 importer=m0 specifier=""
modulefailure q1 importer=m0 specifier="missing"
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="name" [isFreeName]
    v2 = ModuleNamespace module=m0
    v3 = ElemGet v2, v1
    v4 = ModuleNamespace module=m1
    v5 = ElemGet v4, v1
    v6 = ModuleNamespace module=m2
    v7 = ElemGet v6, v1
    PutModuleVariable v1 variable=g0
    Return
}
function f1 name="second" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="name" [isFreeName]
    PutModuleVariable v1 variable=g1
    PutModuleVariable v1 variable=g2
    Return
}
function f2 name="third" module=m2 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f3 name="fourth" module=m3 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
  b0():
    Return
}
function f4 name="runtime" module=m6 kind=Module results=[{type=anything}] {
  b0():
    Return
}

