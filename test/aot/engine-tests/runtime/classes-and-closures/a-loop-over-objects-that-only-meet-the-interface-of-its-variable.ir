# FORM: AsRead
# OPTIONS: count-arrivals
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.given = { nothing() { return undefined; }, first(last, left) { const step = { kind: "step", run(host) { return left-- > 0 ? step : last; } }; return step; } }; const arrivals = () => { let sum = 0; const lines = aotRuntimeCounters().split("\n"); for (let i = 0; i < lines.length; i++) { const parts = lines[i].split("\t"); if (parts.length > 1 && parts[1].startsWith("arrival:")) sum += Number(parts[0]); } return sum; }; let marked; globalThis.mark = () => { marked = arrivals(); }; globalThis.report = (...values) => { const byName = arrivals() - marked; print(values.join(" ")); print(Math.round(byName / 10000), "accesses by name a turn"); };
# The steps are objects of the shell, which have the members of Step and none of the program's layouts. Only what is asked of a step goes by name: its `run` and the call. The fields of `this` do not.
# CHECK: 10002
# CHECK-NEXT: 2 accesses by name a turn
# CHECK-NEXT: exited with 0

