# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.argv = ["", "", "30"]; globalThis.collect = () => fullGC(); const counters = () => { const all = {}; const lines = aotRuntimeCounters().split("\n"); for (let i = 0; i < lines.length; i++) { const parts = lines[i].split("\t"); if (parts.length > 1) all[parts[1]] = Number(parts[0]); } return all; }; let marked; globalThis.mark = () => { marked = counters(); }; globalThis.report = (...values) => { let text = ""; for (let i = 0; i < values.length; i++) text += (i ? " " : "") + values[i]; print(text); const last = counters(); for (const name of ["counter:CompiledStructuresMade", "counter:AllocationSiteRecordsFilled", "counter:AssignmentPlansMade", "counter:FieldMovePlansMade", "counter:CopiesCollectedByName", "counter:SiteCacheRefills", "operation:operationAOTInByIdAndCache", "operation:operationAOTGetByIdAndCache", "operation:operationAOTPutByIdAndCache"]) print(name, (last[name] || 0) - (marked[name] || 0)); };
# Every turn makes the same short-lived objects, and a full collection follows each turn, when none of them is alive.
# What was learned about their layouts in the first ten turns is still good in the next twenty: nothing is made or filed again.
