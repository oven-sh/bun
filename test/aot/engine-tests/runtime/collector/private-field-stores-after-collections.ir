# CHECK-NEXT: TryPutProperties seldom
# CHECK-NEXT: PrivateDefine seldom
# CHECK-NEXT: PutByIdAndCache seldom
# CHECK-NEXT: DefineById seldom
# CHECK-NEXT: DefineField seldom
# CHECK-NEXT: PrivateSet seldom
# CHECK-NEXT: exited with 0

