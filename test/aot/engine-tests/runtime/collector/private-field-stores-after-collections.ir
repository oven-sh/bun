# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.argv = ["", "", "1000"]; globalThis.env = {}; globalThis.collect = () => fullGC(); globalThis.report = (...values) => { let text = ""; for (let i = 0; i < values.length; i++) text += (i ? " " : "") + values[i]; print(text); for (const name of ["TryPutProperties", "PrivateDefine", "PutByIdAndCache", "DefineById", "DefineField", "PrivateSet"]) { const calls = aotOperationCount("operationAOT" + name); print(name, calls < 100 ? "seldom" : calls); } };
# Objects of a class with private fields are made between full collections. However many collections have come, their fields are stored without the run time.
