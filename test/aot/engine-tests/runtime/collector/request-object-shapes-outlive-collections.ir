# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.argv = ["", "", "20"]; globalThis.collect = () => fullGC(); const counters = () => { const all = {}; const lines = aotRuntimeCounters().split("\n"); for (let i = 0; i < lines.length; i++) { const parts = lines[i].split("\t"); if (parts.length > 1) all[parts[1]] = Number(parts[0]); } return all; }; let marked; globalThis.mark = () => { marked = counters(); }; globalThis.report = (...values) => { let text = ""; for (let i = 0; i < values.length; i++) text += (i ? " " : "") + values[i]; print(text); const last = counters(); for (const name of ["counter:CompiledStructuresMade", "operation:operationAOTGetByIdAndCache", "operation:operationAOTIntToString"]) print(name, (last[name] || 0) - (marked[name] || 0)); const stores = (last["operation:operationAOTPutByIdAndCache"] || 0) - (marked["operation:operationAOTPutByIdAndCache"] || 0); print(stores <= 20 ? "at most one store asks after a collection" : stores); };
# Each request object gets another prototype and some properties that its class does not have. Between two requests none is alive, and twenty full collections come just then.
# From the tenth round on no shape is made again, no read asks again, and the strings of small numbers are still there.
# CHECK: 2085040
# CHECK-NEXT: counter:CompiledStructuresMade 0
# CHECK-NEXT: operation:operationAOTGetByIdAndCache 0
# CHECK-NEXT: operation:operationAOTIntToString 0
# CHECK-NEXT: at most one store asks after a collection
# CHECK-NEXT: exited with 0

