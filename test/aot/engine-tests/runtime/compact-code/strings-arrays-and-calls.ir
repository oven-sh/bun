# FORM: AsRead
# OPTIONS: heat=EverythingIsCold
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.argv = ["", "", "1"]; const counters = () => { const all = {}; const lines = aotRuntimeCounters().split("\n"); for (let i = 0; i < lines.length; i++) { const parts = lines[i].split("\t"); if (parts.length > 1) all[parts[1]] = Number(parts[0]); } return all; }; let marked; globalThis.mark = () => { marked = counters(); }; globalThis.report = (name, isRight) => { const now = counters(); let asked = ""; for (const key in now) if (key.startsWith("operation:") && now[key] - (marked[key] || 0) > 400) asked += " " + key.slice(22); print(name + (isRight ? ":" : " IS WRONG:") + (asked || " nothing")); };
# All code counts as cold here, so it is compact: it calls shared pieces where hot code has the work in line. Each idiom runs 500 rounds, then 4,000 more.
# Behind its name stand the operations of the run time that it entered in most of those rounds.
