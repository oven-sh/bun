# report(sum === units * 1260 ? "ok" : "no");
# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.argv = ["", "", "240"]; const counters = () => { const all = {}; const lines = aotRuntimeCounters().split("\n"); for (let i = 0; i < lines.length; i++) { const parts = lines[i].split("\t"); if (parts.length > 1) all[parts[1]] = Number(parts[0]); } return all; }; let marked; globalThis.mark = () => { marked = counters(); }; globalThis.report = (...values) => { let text = ""; for (let i = 0; i < values.length; i++) text += (i ? " " : "") + values[i]; print(text); const now = counters(); let asked = ""; for (const key in now) if (key.startsWith("operation:") && now[key] - (marked[key] || 0) >= 100) asked += " " + key.slice(22); print("asked in most rounds:" + (asked || " nothing")); };
# One class expression is evaluated many times, and each of its classes has a prototype object of its own. An object of any of them is made where the constructor is, without the run time.
# CHECK: ok
# CHECK-NEXT: asked in most rounds: nothing
# CHECK-NEXT: exited with 0

