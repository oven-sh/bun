# main.cjs requires pairs.cjs inside a function, so nothing proves that its constructor functions are created once.
# Each round parses a header with `new NullObject()`, whose prototype object has no prototype, and `new Pair(key, value)`.
# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.argv = ["", "", "4400"]; globalThis.report = (...values) => { let text = ""; for (let i = 0; i < values.length; i++) text += (i ? " " : "") + values[i]; print(text); for (const name of ["PutById", "PutByIdAndCache", "PutByIdSloppy"]) { const calls = aotOperationCount("operationAOT" + name); print(name, calls < 200 ? "seldom" : calls); } };
# What the constructor functions store into `this` stops asking the run time.
# CHECK: 2 13 4
# CHECK-NEXT: PutById seldom
# CHECK-NEXT: PutByIdAndCache seldom
# CHECK-NEXT: PutByIdSloppy seldom
# CHECK-NEXT: exited with 0

