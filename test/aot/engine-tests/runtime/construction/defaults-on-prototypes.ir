# `Message.prototype.url = "";` A default on the prototype is the idiom of libraries written before classes. The constructor's `this.url = url` finds a writable data property above the object
# and creates the property of the object, as where nothing is above it. Five idioms, each with the lines that store the defaults and without them:
# a constructor function . a constructor function below another . a class . a default under a symbol . a field that only some objects get
# FORM: AsRead
# OPTIONS: count-arrivals
# RUN: run-in-shell --aotCountsPath=/dev/null const counters = () => { const all = {}; const lines = aotRuntimeCounters().split("\n"); for (let i = 0; i < lines.length; i++) { const parts = lines[i].split("\t"); if (parts.length > 1) all[parts[1]] = Number(parts[0]); } return all; }; let marked; globalThis.mark = () => { marked = counters(); }; globalThis.report = (name, isRight) => { const now = counters(); let asked = "", byName = 0; for (const key in now) { const more = now[key] - (marked[key] || 0); if (key.startsWith("arrival:")) byName += more; if (key.startsWith("operation:") && more > 400) asked += " " + key.slice(22); } print(name + (isRight ? ": " : " IS WRONG: ") + Math.round(byName / 4000) + " by name a round, asks" + (asked || " nothing")); };
# Each constructs 500 objects, then 4,000 more. The defaults cost the constructor nothing: as many accesses go by name each round, and the same operations are entered, with them as without.
# CHECK: a constructor function, with defaults: 0 by name a round, asks nothing
# CHECK-NEXT: a constructor function, without: 0 by name a round, asks nothing
# CHECK-NEXT: a constructor function below another, with defaults: 0 by name a round, asks nothing
# CHECK-NEXT: a constructor function below another, without: 0 by name a round, asks nothing
# CHECK-NEXT: a class, with defaults: 2 by name a round, asks PutById RecordArrival
# CHECK-NEXT: a class, without: 0 by name a round, asks nothing
# CHECK-NEXT: a default under a symbol, with defaults: 0 by name a round, asks nothing
# CHECK-NEXT: a default under a symbol, without: 0 by name a round, asks nothing
# CHECK-NEXT: a field that only some objects get, with defaults: 0 by name a round, asks OwnPropertyKeys
# CHECK-NEXT: a field that only some objects get, without: 0 by name a round, asks OwnPropertyKeys
# CHECK-NEXT: exited with 0

