# Which operations of the run time the copies in a module's body call. The body runs once, so whatever an operation finds out about its source serves nobody.
# -- source: copies-of-literals-with-computed-members-call-no-operation.cjs
# // Spreads, a rest and Object.assign over two objects that are kept, in code that runs once. What the two literals hold is computed, so their members are laid down one by one
# // behind an allocation that lists none. The build knows their names all the same, in the order of the text.
# const count = isLoud ? 7 : 1;
# const first = { one: count, two: "s" + count, shared: count + 1, three: count > 3 };
# const second = { shared: count + 2, four: count / 2, five: null };
# const kept = [first, second];
# report("made");
# kept.push({ ...first, ...second });
# kept.push({ ...first, extra: second });
# kept.push({ extra: second, ...first });
# kept.push(Object.assign({}, first, second));
# const { shared, ...others } = first;
# kept.push(others);
# report(kept.map(one => Object.keys(one).join()).join(" "), shared);
# -- end of source
# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null const copies = () => aotRuntimeCounters().split("\n").filter(line => /\toperation:.*(Copy|Assign|OwnKeys)/.test(line)).map(line => line.replace("\t", " ")).join(", "); globalThis.isLoud = false; let before; globalThis.report = (...values) => { if (before === undefined) { before = copies(); return; } const after = copies(); print(values.join(" ")); print("operations that copy:", after === before ? "none" : after + " (" + before + ")"); };
# CHECK: one,two,shared,three shared,four,five one,two,shared,three,four,five one,two,shared,three,extra extra,one,two,shared,three one,two,shared,three,four,five one,two,three 2
# CHECK-NEXT: operations that copy: none
# CHECK-NEXT: exited with 0

