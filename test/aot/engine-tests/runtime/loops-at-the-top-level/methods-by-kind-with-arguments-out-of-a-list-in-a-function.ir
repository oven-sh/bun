# A loop costs the same wherever it stands: at the top level of a module, the way a first benchmark is written, and in a function that is called once.
# What a turn takes: calls into the run time, and instructions by the counter of the hardware, where that can be read. The file beside this one has the other place.
# -- source: main.ts
# declare const turns: string, given: string | undefined, report: (...values: unknown[]) => void;
# abstract class Shape { abstract scaled(by: number): number; }
# class Square extends Shape { constructor(readonly side: number) { super(); } scaled(by: number): number { return this.side * this.side * by; } }
# class Disc extends Shape { constructor(readonly radius: number) { super(); } scaled(by: number): number { return 3 * this.radius * this.radius * by; } }
# const shapes: Shape[] = [new Square(2), new Disc(1), new Square(3)];
# const factors: number[] = [1, 0.5];
# const count = Number(turns);
# function main() {
#   let sum = 0;
#   for (let i = 0; i < count; i++) {
#     sum += shapes[i % shapes.length]!.scaled(factors[i % factors.length]!);
#   }
#   report(sum);
# }
# main();
# -- end of source
# FORM: AsRead
# REPEAT: run = L0; loop = the_loop; most = 26.9
# RUN(%(run)): run-in-shell --aotCountsPath=/dev/null --useConcurrentGC=0 --numberOfGCMarkers=1 const calls = () => aotRuntimeCounters().split("\n").reduce((sum, line) => sum + (/\toperation:/.test(line) ? parseInt(line) : 0), 0); let callsBefore, instructionsBefore; globalThis.loop = "%(loop)".replaceAll("_", " "); globalThis.isLoud = false; Object.defineProperty(globalThis, "turns", { get() { callsBefore = calls(); instructionsBefore = aotInstructionCount(); return 100000; } }); globalThis.given = undefined; globalThis.apply = Reflect.apply; globalThis.report = (...values) => { const instructions = aotInstructionCount(); print(values.join(" ")); if (callsBefore === undefined) return; const taken = instructions === null ? 0 : Math.round((instructions - instructionsBefore) / 10000) / 10; print("a turn:", Math.round((calls() - callsBefore) / 10000) / 10, "calls into the run time,", taken <= %(most) ? "at most %(most) instructions" : taken + " instructions"); callsBefore = undefined; };
# REQUIRES(%(run)): x86_64 unsanitized-code not-windows faulting-loop-polls
