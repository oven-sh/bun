# What a turn of each loop of the program takes: calls into the run time, and instructions by the counter of the hardware, where that can be read.
# The shell hands in the name of the loop. It reads the counts where the program reads `turns`, in front of the loop, and where it reports, behind it.
# -- source: a-count-by-one.ts
# declare const loop: string, turns: string, isLoud: boolean, report: (...values: unknown[]) => void;
# // A long-lived object counts what it has served, one at a time. One day the count no longer fits 32 bits.
# class Server {
#   served = 0;
#   open = 0;
#   serve() {
#     this.served++;
#     this.open = (this.open + 1) & 1023;
#   }
# }
# function serveMany(server: Server, turns: number) {
#   for (let turn = 0; turn < turns; turn++) server.serve();
# }
# const server = new Server();
# serveMany(server, 5000);
# if (loop === "past 2 ** 31") Reflect.set(server, "served", 2 ** 31 - 1000);
# serveMany(server, 5000);
# serveMany(server, Number(turns));
# report(server.served, server.open, Object.keys(server).join());
# -- end of source
# FORM: AsRead
# REPEAT: run = L0 L1; loop = under_2_**_31 past_2_**_31; most = 12.9 13
# RUN(%(run)): run-in-shell --aotCountsPath=/dev/null --useConcurrentGC=0 --numberOfGCMarkers=1 const calls = () => aotRuntimeCounters().split("\n").reduce((sum, line) => sum + (/\toperation:/.test(line) ? parseInt(line) : 0), 0); let callsBefore, instructionsBefore; globalThis.loop = "%(loop)".replaceAll("_", " "); globalThis.isLoud = false; Object.defineProperty(globalThis, "turns", { get() { callsBefore = calls(); instructionsBefore = aotInstructionCount(); return 100000; } }); globalThis.given = undefined; globalThis.apply = Reflect.apply; globalThis.report = (...values) => { const instructions = aotInstructionCount(); print(values.join(" ")); if (callsBefore === undefined) return; const taken = instructions === null ? 0 : Math.round((instructions - instructionsBefore) / 10000) / 10; print("a turn:", Math.round((calls() - callsBefore) / 10000) / 10, "calls into the run time,", taken <= %(most) ? "at most %(most) instructions" : taken + " instructions"); callsBefore = undefined; };
# REQUIRES(%(run)): x86_64 unsanitized-code not-windows
# END REPEAT
# under 2 ** 31
# L0: 110000 432 served,open
# L0-NEXT: a turn: 0 calls into the run time, at most 12.9 instructions
# L0-NEXT: exited with 0
# past 2 ** 31
# L1: 2147587648 432 served,open
# L1-NEXT: a turn: 0 calls into the run time, at most 13 instructions
# L1-NEXT: exited with 0

