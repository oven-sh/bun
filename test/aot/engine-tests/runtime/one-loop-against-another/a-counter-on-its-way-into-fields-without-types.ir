# What a turn of each loop of the program takes: calls into the run time, and instructions by the counter of the hardware, where that can be read.
# The shell hands in the name of the loop. It reads the counts where the program reads `turns`, in front of the loop, and where it reports, behind it.
# -- source: a-counter-on-its-way-into-fields.ts
# // Flags: --aot-erase-types
# declare const loop: string, turns: string, isLoud: boolean, report: (...values: unknown[]) => void;
# // A counter that nothing bounds is stored into the fields of new objects. One day it no longer fits 32 bits.
# type Pair = { a: number; b: number };
# type Link = { next: Link | null; a: number; b: number };
# function make(kept: Pair[], turns: number, start: number) {
#   for (let i = start === 0 ? 0 : 2147483000, n = 0; n < turns; i++, n++) kept[n & 1023] = { a: i, b: i };
# }
# function read(kept: Pair[], turns: number) {
#   let sum = 0;
#   for (let turn = 0; turn < turns; turn++) sum += kept[turn & 1023]!.a - kept[turn & 1023]!.b + 1;
#   return sum;
# }
# function link(turns: number, start: number) {
#   let head: Link | null = null;
#   for (let i = start === 0 ? 0 : 2147483000, n = 0; n < turns; i++, n++) head = { next: head, a: i, b: i };
#   return head;
# }
# const start = loop.endsWith("past 2 ** 31") ? 1 : 0;
# const kept: Pair[] = [];
# for (let index = 0; index < 1024; index++) kept.push({ a: index, b: index });
# make(kept, loop.startsWith("make") ? Number(turns) : 2048, start);
# const head = link(loop.startsWith("link") ? Number(turns) : 2048, start);
# report(read(kept, loop.startsWith("read") ? Number(turns) : 1024), kept[5]!.a, head!.a, head!.next!.b);
# -- end of source
# FORM: AsRead
# REPEAT: run = L0 L1 L2 L3; loop = make_under_2_**_31 make_past_2_**_31 read_under_2_**_31 read_past_2_**_31; most = 78.3 78.3 17.9 17.9
# RUN(%(run)): run-in-shell --aotCountsPath=/dev/null --useConcurrentGC=0 --numberOfGCMarkers=1 const calls = () => aotRuntimeCounters().split("\n").reduce((sum, line) => sum + (/\toperation:/.test(line) ? parseInt(line) : 0), 0); let callsBefore, instructionsBefore; globalThis.loop = "%(loop)".replaceAll("_", " "); globalThis.isLoud = false; Object.defineProperty(globalThis, "turns", { get() { callsBefore = calls(); instructionsBefore = aotInstructionCount(); return 100000; } }); globalThis.given = undefined; globalThis.apply = Reflect.apply; globalThis.report = (...values) => { const instructions = aotInstructionCount(); print(values.join(" ")); if (callsBefore === undefined) return; const taken = instructions === null ? 0 : Math.round((instructions - instructionsBefore) / 10000) / 10; print("a turn:", Math.round((calls() - callsBefore) / 10000) / 10, "calls into the run time,", taken <= %(most) ? "at most %(most) instructions" : taken + " instructions"); callsBefore = undefined; };
# REQUIRES(%(run)): x86_64 unsanitized-code not-windows faulting-loop-polls
# END REPEAT
# make under 2 ** 31
# L0: 1024 99333 2047 2046
# L0-NEXT: a turn: 0 calls into the run time, at most 78.3 instructions
# L0-NEXT: exited with 0
# make past 2 ** 31
# L1: 1024 2147582333 2147485047 2147485046
# L1-NEXT: a turn: 0 calls into the run time, at most 78.3 instructions
# L1-NEXT: exited with 0
# read under 2 ** 31
# L2: 100000 1029 2047 2046
# L2-NEXT: a turn: 0 calls into the run time, at most 17.9 instructions
# L2-NEXT: exited with 0
# read past 2 ** 31
# L3: 100000 2147484029 2147485047 2147485046
# L3-NEXT: a turn: 0 calls into the run time, at most 17.9 instructions
# L3-NEXT: exited with 0

