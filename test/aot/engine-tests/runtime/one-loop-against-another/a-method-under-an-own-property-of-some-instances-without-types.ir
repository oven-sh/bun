# What a turn of each loop of the program takes: calls into the run time, and instructions by the counter of the hardware, where that can be read.
# The shell hands in the name of the loop. It reads the counts where the program reads `turns`, in front of the loop, and where it reports, behind it.
# -- source: a-method-under-an-own-property-of-some-instances.ts
# // Flags: --aot-erase-types
# declare const loop: string, turns: string, isLoud: boolean, report: (...values: unknown[]) => void;
# declare const apply: (callee: Function, receiver: unknown, list: unknown[]) => number;
# // `target.add(..)` on instances of a class whose constructor stores an own `add` on one road, beside the same call on a class that never does.
# // An instance without the own property calls the method of its class. The loops "handed in" are called by a function that is not of the program.
# class Plain {
#   heard = 0;
#   constructor(loud: boolean) {
#     if (loud) this.heard = 1;
#   }
#   add(step: number): number {
#     this.heard = (this.heard + step) | 0;
#     return this.heard & 1;
#   }
# }
# function addTwice(this: Hidden, step: number): number {
#   this.heard = (this.heard + step + step) | 0;
#   return this.heard & 1;
# }
# class Hidden {
#   heard = 0;
#   constructor(loud: boolean) {
#     if (loud) this.add = addTwice;
#   }
#   add(step: number): number {
#     this.heard = (this.heard + step) | 0;
#     return this.heard & 1;
#   }
# }
# class PlainGuest {
#   heard = 0;
#   constructor(loud: boolean) {
#     if (loud) this.heard = 1;
#   }
#   add(step: number): number {
#     this.heard = (this.heard + step) | 0;
#     return this.heard & 1;
#   }
# }
# function addThrice(this: HiddenGuest, step: number): number {
#   this.heard = (this.heard + step * 3) | 0;
#   return this.heard & 1;
# }
# class HiddenGuest {
#   heard = 0;
#   constructor(loud: boolean) {
#     if (loud) this.add = addThrice;
#   }
#   add(step: number): number {
#     this.heard = (this.heard + step) | 0;
#     return this.heard & 1;
#   }
# }
# function overPlain(target: Plain, rounds: number): number {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum = (sum + target.add(round)) | 0;
#   return sum;
# }
# function overHidden(target: Hidden, rounds: number): number {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum = (sum + target.add(round)) | 0;
#   return sum;
# }
# function overPlainGuest(target: PlainGuest, rounds: number): number {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum = (sum + target.add(round)) | 0;
#   return sum;
# }
# function overHiddenGuest(target: HiddenGuest, rounds: number): number {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum = (sum + target.add(round)) | 0;
#   return sum;
# }
# report(
#   overPlain(new Plain(isLoud), 5000),
#   overHidden(new Hidden(isLoud), 5000),
#   overHidden(new Hidden(!isLoud), 5000),
# );
# report(
#   apply(overPlainGuest, undefined, [new PlainGuest(isLoud), 5000]),
#   apply(overHiddenGuest, undefined, [new HiddenGuest(isLoud), 5000]),
#   apply(overHiddenGuest, undefined, [new HiddenGuest(!isLoud), 5000]),
# );
# const rounds = Number(turns);
# if (loop === "a class that never stores") report(overPlain(new Plain(isLoud), rounds));
# if (loop === "an instance without the own property") report(overHidden(new Hidden(isLoud), rounds));
# if (loop === "an instance with the own property") report(overHidden(new Hidden(!isLoud), rounds));
# if (loop === "a class that never stores, handed in")
#   report(apply(overPlainGuest, undefined, [new PlainGuest(isLoud), rounds]));
# if (loop === "an instance without the own property, handed in")
#   report(apply(overHiddenGuest, undefined, [new HiddenGuest(isLoud), rounds]));
# export {};
# -- end of source
# FORM: AsRead
# REPEAT: run = L0 L1 L2 L3; loop = a_class_that_never_stores an_instance_without_the_own_property a_class_that_never_stores,_handed_in an_instance_without_the_own_property,_handed_in; most = 8.9 9.9 13 44
# RUN(%(run)): run-in-shell --aotCountsPath=/dev/null --useConcurrentGC=0 --numberOfGCMarkers=1 const calls = () => aotRuntimeCounters().split("\n").reduce((sum, line) => sum + (/\toperation:/.test(line) ? parseInt(line) : 0), 0); let callsBefore, instructionsBefore; globalThis.loop = "%(loop)".replaceAll("_", " "); globalThis.isLoud = false; Object.defineProperty(globalThis, "turns", { get() { callsBefore = calls(); instructionsBefore = aotInstructionCount(); return 100000; } }); globalThis.given = undefined; globalThis.apply = Reflect.apply; globalThis.report = (...values) => { const instructions = aotInstructionCount(); print(values.join(" ")); if (callsBefore === undefined) return; const taken = instructions === null ? 0 : Math.round((instructions - instructionsBefore) / 10000) / 10; print("a turn:", Math.round((calls() - callsBefore) / 10000) / 10, "calls into the run time,", taken <= %(most) ? "at most %(most) instructions" : taken + " instructions"); callsBefore = undefined; };
# REQUIRES(%(run)): x86_64 unsanitized-code not-windows
