# An accessor that a statement puts on a prototype object is not there until the statement has run. Where the program may make objects below that prototype object first, the member says so:
# until then a store under the name creates a field. An accessor that is defined before anything can make such an object is not marked, whether a loop, a function that is called once or
# Object.defineProperties stands in between.
# -- source: an-accessor-defined-behind-the-first-objects-is-marked.js
# function Early() {}
# Object.defineProperty(Early.prototype, "open", {
#   get() {
#     return this.state !== 0;
#   },
#   set(given) {
#     this.state = given ? 1 : 0;
#   },
#   configurable: true,
# });
# function BelowEarly(options) {
#   this.state = 1;
#   if (options) this.open = false;
# }
# Object.setPrototypeOf(BelowEarly.prototype, Early.prototype);
# function Late() {}
# function BelowLate(value) {
#   this.value = value;
# }
# Object.setPrototypeOf(BelowLate.prototype, Late.prototype);
# class Installed {}
# class BelowInstalled extends Installed {
#   constructor(size) {
#     super();
#     this.size = size;
#   }
# }
# let taken = 0;
# function install() {
#   Object.defineProperties(Installed.prototype, {
#     size: {
#       set(given) {
#         taken += given;
#       },
#       configurable: true,
#     },
#   });
# }
# let sum = 0;
# for (let round = 0; round < 3; round++) sum += new BelowLate(round).value + new BelowEarly().state + new BelowInstalled(round).size;
# Object.defineProperty(Late.prototype, "value", {
#   set(given) {
#     taken += given;
#   },
#   configurable: true,
# });
# install();
# print(sum, String(new BelowLate(5).value), String(new BelowInstalled(6).size), taken, new BelowEarly({}).open);
# -- end of source
