# What a turn of each loop of the program takes: calls into the run time, and instructions by the counter of the hardware, where that can be read.
# The shell hands in the name of the loop. It reads the counts where the program reads `turns`, in front of the loop, and where it reports, behind it.
# -- source: an-object-put-together-from-others-and-kept.cjs
# // An object that is put together from other objects, by spreads and as the rest of a pattern, and then kept, beside a literal with the same fields that is kept. What the literal is
# // filled with is stored once more where it comes from: what the build knows of an object it reads from no object.
# const kept = [];
# const defaults = { host: "localhost", port: 80, secure: false };
# const given = { port: 8080, path: "/" };
# defaults.host = "localhost";
# given.port = 8080;
# given.path = "/";
# const record = { id: 7, name: "seven", secret: "x", age: 30 };
# const records = [
#   { id: 6, name: "six", secret: "w", age: 20 },
#   { secret: "y", id: 8, name: "eight" },
#   { name: "nine", secret: "z", id: 9, age: 3, more: 1 },
# ];
#
# function keepLiteral(i) {
#   const options = { host: defaults.host, port: given.port, secure: defaults.secure, path: given.path };
#   kept[i & 7] = options;
#   return options.port + options.host.length + options.path.length + (i & 3);
# }
# function keepSpreads(i) {
#   const options = { ...defaults, ...given };
#   kept[i & 7] = options;
#   return options.port + options.host.length + options.path.length + (i & 3);
# }
# function keepRest(i) {
#   const { secret, ...visible } = record;
#   kept[i & 7] = visible;
#   return visible.id + visible.age + visible.name.length + secret.length + (i & 3);
# }
# function keepRestOfOneOfThree(i) {
#   const { secret, ...visible } = records[i % 3];
#   kept[i & 7] = visible;
#   return visible.id + visible.name.length + secret.length + (i & 3);
# }
#
# function literals(rounds) {
#   let sum = 0;
#   for (let i = 0; i < rounds; i++) sum = (sum + keepLiteral(i)) | 0;
#   return sum;
# }
# function spreads(rounds) {
#   let sum = 0;
#   for (let i = 0; i < rounds; i++) sum = (sum + keepSpreads(i)) | 0;
#   return sum;
# }
# function rests(rounds) {
#   let sum = 0;
#   for (let i = 0; i < rounds; i++) sum = (sum + keepRest(i)) | 0;
#   return sum;
# }
# function restsOfOneOfThree(rounds) {
#   let sum = 0;
#   for (let i = 0; i < rounds; i++) sum = (sum + keepRestOfOneOfThree(i)) | 0;
#   return sum;
# }
#
# let warmedUp = 0;
# for (let round = 0; round < 10; round++)
#   warmedUp = (warmedUp + literals(500) + spreads(500) + rests(500) + restsOfOneOfThree(500)) | 0;
# report(warmedUp, JSON.stringify(kept));
# const rounds = Number(turns);
# if (loop === "literals") report(literals(rounds));
# if (loop === "spreads of two objects") report(spreads(rounds));
# if (loop === "the rest of a record") report(rests(rounds));
# if (loop === "the rest of one of three records") report(restsOfOneOfThree(rounds));
# -- end of source
# FORM: AsRead
# REPEAT: run = L0 L1 L2 L3; loop = literals spreads_of_two_objects the_rest_of_a_record the_rest_of_one_of_three_records; most = 142.2 142.7 140.8 183.8
# RUN(%(run)): run-in-shell --aotCountsPath=/dev/null --useConcurrentGC=0 --numberOfGCMarkers=1 const calls = () => aotRuntimeCounters().split("\n").reduce((sum, line) => sum + (/\toperation:/.test(line) ? parseInt(line) : 0), 0); let callsBefore, instructionsBefore; globalThis.loop = "%(loop)".replaceAll("_", " "); globalThis.isLoud = false; Object.defineProperty(globalThis, "turns", { get() { callsBefore = calls(); instructionsBefore = aotInstructionCount(); return 100000; } }); globalThis.given = undefined; globalThis.apply = Reflect.apply; globalThis.report = (...values) => { const instructions = aotInstructionCount(); print(values.join(" ")); if (callsBefore === undefined) return; const taken = instructions === null ? 0 : Math.round((instructions - instructionsBefore) / 10000) / 10; print("a turn:", Math.round((calls() - callsBefore) / 10000) / 10, "calls into the run time,", taken <= %(most) ? "at most %(most) instructions" : taken + " instructions"); callsBefore = undefined; };
# REQUIRES(%(run)): x86_64 unsanitized-code not-windows
