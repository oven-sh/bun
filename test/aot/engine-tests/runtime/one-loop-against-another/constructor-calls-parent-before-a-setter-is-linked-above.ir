# What a turn of each loop of the program takes: calls into the run time, and instructions by the counter of the hardware, where that can be read.
# The shell hands in the name of the loop. It reads the counts where the program reads `turns`, in front of the loop, and where it reports, behind it.
# -- source: constructor-calls-parent-before-a-setter-is-linked-above.js
# function Parent(value) {
#   this.value = value;
# }
# function Child(value) {
#   Parent.apply(this, arguments);
#   this.extra = 2;
# }
# Object.setPrototypeOf(Child.prototype, Parent.prototype);
# function turn(round) {
#   const made = new Child(round & 7);
#   return made.value + made.extra;
# }
# function sumOf(rounds) {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum = (sum + turn(round)) | 0;
#   return sum;
# }
# let warm = 0;
# for (let call = 0; call < 3; call++) warm = (warm + sumOf(Number(short))) | 0;
# report(warm, sumOf(Number(turns)));
# let taken = 0;
# Object.setPrototypeOf(Child.prototype, {
#   set value(given) {
#     taken += given;
#   },
# });
# report(sumOf(Number(short)), taken, String(new Child(3).value), Object.keys(new Child(4)).join());
# Object.setPrototypeOf(Child.prototype, {
#   get value() {
#     return 40;
#   },
#   set value(given) {
#     taken -= given;
#   },
# });
# report(sumOf(10), taken, new Child(5).value, Object.keys(new Child(6)).join());
# -- end of source
# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null --useConcurrentGC=0 --numberOfGCMarkers=1 const calls = () => aotRuntimeCounters().split("\n").reduce((sum, line) => sum + (/\toperation:/.test(line) ? parseInt(line) : 0), 0); let callsBefore, instructionsBefore; globalThis.short = "5000"; Object.defineProperty(globalThis, "turns", { get() { callsBefore = calls(); instructionsBefore = aotInstructionCount(); return 100000; } }); globalThis.given = undefined; globalThis.apply = Reflect.apply; globalThis.report = (...values) => { const instructions = aotInstructionCount(); print(values.join(" ")); if (callsBefore === undefined) return; const taken = instructions === null ? 0 : Math.round((instructions - instructionsBefore) / 10000) / 10; print("a turn:", Math.round((calls() - callsBefore) / 10000) / 10, "calls into the run time,", taken <= 8.9 ? "at most 8.9 instructions" : taken + " instructions"); callsBefore = undefined; };
# REQUIRES: x86_64 unsanitized-code not-windows faulting-loop-polls
# CHECK: 82500 550000
# CHECK-NEXT: a turn: 0 calls into the run time, at most 8.9 instructions
# CHECK-NEXT: 0 17500 undefined extra
# CHECK-NEXT: 420 17478 40 extra
# CHECK-NEXT: exited with 0

