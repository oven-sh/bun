# What a turn of each loop of the program takes: calls into the run time, and instructions by the counter of the hardware, where that can be read.
# The shell hands in the name of the loop. It reads the counts where the program reads `turns`, in front of the loop, and where it reports, behind it.
# -- source: constructor-passes-by-a-store-under-a-setter-that-was-defined-first.js
# function Parent() {}
# Object.defineProperty(Parent.prototype, "open", {
#   get() {
#     return this.state !== 0;
#   },
#   set(given) {
#     this.state = given ? 1 : 0;
#   },
#   configurable: true,
# });
# function Child(options) {
#   this.state = 1;
#   this.extra = 2;
#   this.more = 3;
#   if (options && options.open === false) this.open = false;
# }
# Object.setPrototypeOf(Child.prototype, Parent.prototype);
# function turn(round) {
#   const made = new Child(given);
#   return made.state + made.extra + made.more + (round & 1);
# }
# function sumOf(rounds) {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum = (sum + turn(round)) | 0;
#   return sum;
# }
# let warm = 0;
# for (let call = 0; call < 3; call++) warm = (warm + sumOf(Number(short))) | 0;
# report(warm, sumOf(Number(turns)));
# const shut = new Child({ open: false });
# report(shut.state, shut.open, Object.keys(shut).join());
# -- end of source
# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null --useConcurrentGC=0 --numberOfGCMarkers=1 const calls = () => aotRuntimeCounters().split("\n").reduce((sum, line) => sum + (/\toperation:/.test(line) ? parseInt(line) : 0), 0); let callsBefore, instructionsBefore; globalThis.short = "5000"; Object.defineProperty(globalThis, "turns", { get() { callsBefore = calls(); instructionsBefore = aotInstructionCount(); return 100000; } }); globalThis.given = undefined; globalThis.apply = Reflect.apply; globalThis.report = (...values) => { const instructions = aotInstructionCount(); print(values.join(" ")); if (callsBefore === undefined) return; const taken = instructions === null ? 0 : Math.round((instructions - instructionsBefore) / 10000) / 10; print("a turn:", Math.round((calls() - callsBefore) / 10000) / 10, "calls into the run time,", taken <= 29.9 ? "at most 29.9 instructions" : taken + " instructions"); callsBefore = undefined; };
# REQUIRES: x86_64 unsanitized-code not-windows faulting-loop-polls
# CHECK: 97500 650000
# CHECK-NEXT: a turn: 0 calls into the run time, at most 29.9 instructions
# CHECK-NEXT: 0 false state,extra,more
# CHECK-NEXT: exited with 0

