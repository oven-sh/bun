# What a turn of each loop of the program takes: calls into the run time, and instructions by the counter of the hardware, where that can be read.
# The shell hands in the name of the loop. It reads the counts where the program reads `turns`, in front of the loop, and where it reports, behind it.
# -- source: constructor-stores-through-a-setter-defined-on-the-prototype-of-its-own-class.js
# let taken = 0;
# class Made {
#   constructor(size) {
#     this.size = size;
#     this.extra = 2;
#   }
# }
# Object.defineProperty(Made.prototype, "size", {
#   set(value) {
#     taken = (taken + value) | 0;
#   },
#   get() {
#     return 1;
#   },
# });
# function turn(round) {
#   const made = new Made(round & 7);
#   return made.size + made.extra;
# }
# function sumOf(rounds) {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum = (sum + turn(round)) | 0;
#   return sum;
# }
# let warm = 0;
# for (let call = 0; call < 3; call++) warm = (warm + sumOf(Number(short))) | 0;
# report(warm, sumOf(Number(turns)), taken);
# report(Object.keys(new Made(3)).join(), new Made(4).size, taken);
# -- end of source
# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null --useConcurrentGC=0 --numberOfGCMarkers=1 const calls = () => aotRuntimeCounters().split("\n").reduce((sum, line) => sum + (/\toperation:/.test(line) ? parseInt(line) : 0), 0); let callsBefore, instructionsBefore; globalThis.short = "5000"; Object.defineProperty(globalThis, "turns", { get() { callsBefore = calls(); instructionsBefore = aotInstructionCount(); return 100000; } }); globalThis.given = undefined; globalThis.apply = Reflect.apply; globalThis.report = (...values) => { const instructions = aotInstructionCount(); print(values.join(" ")); if (callsBefore === undefined) return; const taken = instructions === null ? 0 : Math.round((instructions - instructionsBefore) / 10000) / 10; print("a turn:", Math.round((calls() - callsBefore) / 10000) / 10, "calls into the run time,", taken <= 12 ? "at most 12 instructions" : taken + " instructions"); callsBefore = undefined; };
# REQUIRES: x86_64 unsanitized-code not-windows faulting-loop-polls
# CHECK: 45000 300000 402500
# CHECK-NEXT: a turn: 0 calls into the run time, at most 12 instructions
# CHECK-NEXT: extra 1 402507
# CHECK-NEXT: exited with 0

