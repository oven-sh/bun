# What a turn of each loop of the program takes: calls into the run time, and instructions by the counter of the hardware, where that can be read.
# The shell hands in the name of the loop. It reads the counts where the program reads `turns`, in front of the loop, and where it reports, behind it.
# -- source: main.mjs
# // One class and one function, each written twice: as what a CommonJS file assigns to module.exports, and as the default export of a module. Both are imported by default.
# import AssignedCounter from "./assigned-counter.cjs";
# import assignedTwice from "./assigned-twice.cjs";
# import ExportedCounter from "./exported-counter.mjs";
# import exportedTwice from "./exported-twice.mjs";
# function withExported(turns) {
#   const counter = new ExportedCounter();
#   let sum = 0;
#   for (let i = 0; i < turns; i++) sum = (sum + counter.add(i) + exportedTwice(i)) | 0;
#   return sum;
# }
# function withAssigned(turns) {
#   const counter = new AssignedCounter();
#   let sum = 0;
#   for (let i = 0; i < turns; i++) sum = (sum + counter.add(i) + assignedTwice(i)) | 0;
#   return sum;
# }
# report(withExported(5000), withAssigned(5000), (loop === "out of a CommonJS file" ? withAssigned : withExported)(Number(turns)));
# -- source: assigned-counter.cjs
# module.exports = class Counter {
#   constructor() {
#     this.n = 1;
#   }
#   add(x) {
#     this.n = (this.n + x) | 0;
#     return this.n;
#   }
# };
# -- source: assigned-twice.cjs
# module.exports = function twice(x) {
#   return x * 2;
# };
# -- source: exported-counter.mjs
# export default class Counter {
#   constructor() {
#     this.n = 1;
#   }
#   add(x) {
#     this.n = (this.n + x) | 0;
#     return this.n;
#   }
# }
# -- source: exported-twice.mjs
# export default function twice(x) {
#   return x * 2;
# }
# -- end of source
# FORM: AsRead
# REPEAT: run = L0 L1; loop = out_of_a_module out_of_a_CommonJS_file; most = 9.9 11.9
# RUN(%(run)): run-in-shell --aotCountsPath=/dev/null --useConcurrentGC=0 --numberOfGCMarkers=1 const calls = () => aotRuntimeCounters().split("\n").reduce((sum, line) => sum + (/\toperation:/.test(line) ? parseInt(line) : 0), 0); let callsBefore, instructionsBefore; globalThis.loop = "%(loop)".replaceAll("_", " "); globalThis.isLoud = false; Object.defineProperty(globalThis, "turns", { get() { callsBefore = calls(); instructionsBefore = aotInstructionCount(); return 100000; } }); globalThis.given = undefined; globalThis.apply = Reflect.apply; globalThis.report = (...values) => { const instructions = aotInstructionCount(); print(values.join(" ")); if (callsBefore === undefined) return; const taken = instructions === null ? 0 : Math.round((instructions - instructionsBefore) / 10000) / 10; print("a turn:", Math.round((calls() - callsBefore) / 10000) / 10, "calls into the run time,", taken <= %(most) ? "at most %(most) instructions" : taken + " instructions"); callsBefore = undefined; };
# REQUIRES(%(run)): x86_64 unsanitized-code not-windows faulting-loop-polls
# END REPEAT
# out of a module
# L0: -616503980 -616503980 1870794128
# L0-NEXT: a turn: 0 calls into the run time, at most 9.9 instructions
# L0-NEXT: exited with 0
# out of a CommonJS file
# L1: -616503980 -616503980 1870794128
# L1-NEXT: a turn: 0 calls into the run time, at most 11.9 instructions
# L1-NEXT: exited with 0

