# What a turn of each loop of the program takes: calls into the run time, and instructions by the counter of the hardware, where that can be read.
# The shell hands in the name of the loop and the keys. It reads the counts where the program reads `turns`, in front of the loop, and where it reports, behind it.
# -- source: listeners-stored-under-each-listed-name-in-turn.ts
# // `events[name] = listener` under names that the build cannot read, where the fields have declared types and every store of the program keeps them.
# declare const keys: string, loop: string, turns: string;
# declare function report(...values: unknown[]): void;
# type Listener = () => void;
# type Held = Listener | Listener[] | undefined;
# interface Events {
#   [name: string]: Held;
#   close: Held;
#   error: Held;
#   data: Held;
#   end: Held;
#   readable: Held;
# }
# function listener() {}
# function room(): Events {
#   return { close: undefined, error: undefined, data: undefined, end: undefined, readable: undefined };
# }
# function fillWithFunctions(events: Events, names: string[], rounds: number) {
#   for (let round = 0; round < rounds; round++) for (let index = 0; index < 5; index++) events[names[index]] = listener;
#   return events.close === listener && events.readable === listener;
# }
# function fillWithLists(events: Events, names: string[], rounds: number) {
#   const list = [listener, listener];
#   for (let round = 0; round < rounds; round++) for (let index = 0; index < 5; index++) events[names[index]] = list;
#   return events.close === list && events.readable === list;
# }
# const names = keys.split(",");
# report(fillWithFunctions(room(), names, 1000), fillWithLists(room(), names, 1000));
# const rounds = Number(turns);
# if (loop === "functions") report(fillWithFunctions(room(), names, rounds));
# if (loop === "lists") report(fillWithLists(room(), names, rounds));
# -- end of source
# FORM: AsRead
# OPTIONS: references=narrow testing=NoLayoutIsMadeSeldom
# REPEAT: run = L0 L1; loop = functions lists; most = 327.9 353.9
# RUN(%(run)): run-in-shell --aotCountsPath=/dev/null --useConcurrentGC=0 --numberOfGCMarkers=1 const calls = () => aotRuntimeCounters().split("\n").reduce((sum, line) => sum + (/\toperation:/.test(line) ? parseInt(line) : 0), 0); let callsBefore, instructionsBefore; globalThis.loop = "%(loop)".replaceAll("_", " "); globalThis.keys = "close,error,end,data,readable"; Object.defineProperty(globalThis, "turns", { get() { callsBefore = calls(); instructionsBefore = aotInstructionCount(); return 100000; } }); globalThis.report = (...values) => { const instructions = aotInstructionCount(); print(values.join(" ")); if (callsBefore === undefined) return; const taken = instructions === null ? 0 : Math.round((instructions - instructionsBefore) / 10000) / 10; print("a turn:", Math.round((calls() - callsBefore) / 10000) / 10, "calls into the run time,", taken <= %(most) ? "at most %(most) instructions" : taken + " instructions"); callsBefore = undefined; };
# REQUIRES(%(run)): x86_64 unsanitized-code not-windows faulting-loop-polls
# END REPEAT
# functions
# L0: true true
# L0-NEXT: true
# L0-NEXT: a turn: 0 calls into the run time, at most 327.9 instructions
# L0-NEXT: exited with 0
# lists
# L1: true true
# L1-NEXT: true
# L1-NEXT: a turn: 0 calls into the run time, at most 353.9 instructions
# L1-NEXT: exited with 0

