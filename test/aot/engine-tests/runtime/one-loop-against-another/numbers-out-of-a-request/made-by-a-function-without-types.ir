# What a turn of each loop of the program takes: calls into the run time, and instructions by the counter of the hardware, where that can be read.
# The shell hands in the name of the loop. It reads the counts where the program reads `turns`, in front of the loop, and where it reports, behind it.
# -- source: made-by-a-function.ts
# // Flags: --aot-erase-types
# declare const loop: string, turns: string, isLoud: boolean, report: (...values: unknown[]) => void;
# type Pair = { a: number; b: number };
# type Row = { v: number };
# function PairOf(this: Pair, a: number, b: number) {
#   this.a = a;
#   this.b = b;
# }
# function make(kept: Pair[], turns: number, rows: Row[]) {
#   for (let turn = 0; turn < turns; turn++)
#     kept[turn & 1023] = new (PairOf as any)(rows[turn & 7]!.v, rows[turn & 7]!.v) as Pair;
# }
# function read(kept: Pair[], turns: number) {
#   let sum = 0;
#   for (let turn = 0; turn < turns; turn++) sum += kept[turn & 1023]!.a - kept[turn & 1023]!.b + 1;
#   return sum;
# }
# const texts: Record<string, string> = {
#   "small integers": "7",
#   "integers past 2 ** 32": "4294967303",
#   "fractions": "7.5",
#   "negative zeros": "-0",
# };
# const [verb, kind] = [loop.slice(0, 4), loop.slice(5)];
# const rows: Row[] = JSON.parse("[" + Array(8).fill(`{"v":${texts[kind]}}`).join() + "]");
# if (rows.length !== 8) rows.push({ v: 1 });
# const kept: Pair[] = [];
# for (let index = 0; index < 1024; index++) kept.push(new (PairOf as any)(index, index) as Pair);
# make(kept, verb === "make" ? Number(turns) : 1024, rows);
# report(
#   read(kept, verb === "read" ? Number(turns) : 1024),
#   kept[5]!.a,
#   Object.is(kept[5]!.b, -0),
#   Object.keys(kept[5]!).join(),
# );
# -- end of source
# FORM: AsRead
# REPEAT: run = L0 L1 L2 L3 L4; loop = make_small_integers read_small_integers read_integers_past_2_**_32 read_fractions read_negative_zeros; most = 110.3 20 20 20 20
# RUN(%(run)): run-in-shell --aotCountsPath=/dev/null --useConcurrentGC=0 --numberOfGCMarkers=1 const calls = () => aotRuntimeCounters().split("\n").reduce((sum, line) => sum + (/\toperation:/.test(line) ? parseInt(line) : 0), 0); let callsBefore, instructionsBefore; globalThis.loop = "%(loop)".replaceAll("_", " "); globalThis.isLoud = false; Object.defineProperty(globalThis, "turns", { get() { callsBefore = calls(); instructionsBefore = aotInstructionCount(); return 100000; } }); globalThis.given = undefined; globalThis.apply = Reflect.apply; globalThis.report = (...values) => { const instructions = aotInstructionCount(); print(values.join(" ")); if (callsBefore === undefined) return; const taken = instructions === null ? 0 : Math.round((instructions - instructionsBefore) / 10000) / 10; print("a turn:", Math.round((calls() - callsBefore) / 10000) / 10, "calls into the run time,", taken <= %(most) ? "at most %(most) instructions" : taken + " instructions"); callsBefore = undefined; };
# REQUIRES(%(run)): x86_64 unsanitized-code not-windows
# END REPEAT
# make small integers
# L0: 1024 7 false a,b
# L0-NEXT: a turn: 0 calls into the run time, at most 110.3 instructions
# L0-NEXT: exited with 0
# read small integers
# L1: 100000 7 false a,b
# L1-NEXT: a turn: 0 calls into the run time, at most 20 instructions
# L1-NEXT: exited with 0
# read integers past 2 ** 32
# L2: 100000 4294967303 false a,b
# L2-NEXT: a turn: 0 calls into the run time, at most 20 instructions
# L2-NEXT: exited with 0
# read fractions
# L3: 100000 7.5 false a,b
# L3-NEXT: a turn: 0 calls into the run time, at most 20 instructions
# L3-NEXT: exited with 0
# read negative zeros
# L4: 100000 0 true a,b
# L4-NEXT: a turn: 0 calls into the run time, at most 20 instructions
# L4-NEXT: exited with 0

