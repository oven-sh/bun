# What a turn of each loop of the program takes: calls into the run time, and instructions by the counter of the hardware, where that can be read.
# The shell hands in the name of the loop. It reads the counts where the program reads `turns`, in front of the loop, and where it reports, behind it.
# -- source: settings-merged-with-what-a-text-holds.cjs
# // Settings put together from defaults that the build can list and from an object that it cannot: what a text holds. The names of the defaults are there whatever the text brings, so
# // they are read from the object itself; what they hold is tested. A name that the text alone brings has a field too, because the program reads it. Beside them a literal with the same fields.
# const defaults = { host: "localhost", port: 80, secure: false, depth: 1 };
# const text = isLoud ? '{"port":"eighty"}' : '{"port":8080,"depth":3,"more":1}';
# const written = { host: "localhost", port: isLoud ? 1 : 8080, secure: false, depth: isLoud ? 1 : 3 };
# const spreadOut = { ...defaults, ...JSON.parse(text) };
# const assigned = Object.assign({}, defaults, JSON.parse(text));
#
# function readsOfWritten(rounds) {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum = (sum + written.port + written.depth + written.host.length + (written.secure ? 1 : 0)) | 0;
#   return sum;
# }
# function readsOfSpread(rounds) {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum = (sum + spreadOut.port + spreadOut.depth + spreadOut.host.length + (spreadOut.secure ? 1 : 0)) | 0;
#   return sum;
# }
# function readsOfAssigned(rounds) {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum = (sum + assigned.port + assigned.depth + assigned.host.length + (assigned.secure ? 1 : 0)) | 0;
#   return sum;
# }
#
# function readsOfWhatTheTextBroughtIntoSpread(rounds) {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum = (sum + spreadOut.more) | 0;
#   return sum;
# }
# function readsOfWhatTheTextBroughtIntoAssigned(rounds) {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum = (sum + assigned.more) | 0;
#   return sum;
# }
#
# report(readsOfWritten(5000), readsOfSpread(5000), readsOfAssigned(5000), readsOfWhatTheTextBroughtIntoSpread(5000), readsOfWhatTheTextBroughtIntoAssigned(5000), Object.keys(spreadOut).join(), spreadOut.more, Object.keys(assigned).join(), assigned.more);
# const rounds = Number(turns);
# if (loop === "reads of a literal") report(readsOfWritten(rounds));
# if (loop === "reads of a spread") report(readsOfSpread(rounds));
# if (loop === "reads of an assigned object") report(readsOfAssigned(rounds));
# if (loop === "reads of what the text brought into a spread") report(readsOfWhatTheTextBroughtIntoSpread(rounds));
# if (loop === "reads of what the text brought into an assigned object") report(readsOfWhatTheTextBroughtIntoAssigned(rounds));
# -- end of source
# FORM: AsRead
# REPEAT: run = L0 L1 L2 L3 L4; loop = reads_of_a_literal reads_of_a_spread reads_of_an_assigned_object reads_of_what_the_text_brought_into_a_spread reads_of_what_the_text_brought_into_an_assigned_object; most = 6.9 12.9 12.9 7.9 7.9
# RUN(%(run)): run-in-shell --aotCountsPath=/dev/null --useConcurrentGC=0 --numberOfGCMarkers=1 const calls = () => aotRuntimeCounters().split("\n").reduce((sum, line) => sum + (/\toperation:/.test(line) ? parseInt(line) : 0), 0); let callsBefore, instructionsBefore; globalThis.loop = "%(loop)".replaceAll("_", " "); globalThis.isLoud = false; Object.defineProperty(globalThis, "turns", { get() { callsBefore = calls(); instructionsBefore = aotInstructionCount(); return 100000; } }); globalThis.given = undefined; globalThis.apply = Reflect.apply; globalThis.report = (...values) => { const instructions = aotInstructionCount(); print(values.join(" ")); if (callsBefore === undefined) return; const taken = instructions === null ? 0 : Math.round((instructions - instructionsBefore) / 10000) / 10; print("a turn:", Math.round((calls() - callsBefore) / 10000) / 10, "calls into the run time,", taken <= %(most) ? "at most %(most) instructions" : taken + " instructions"); callsBefore = undefined; };
# REQUIRES(%(run)): x86_64 unsanitized-code not-windows
# END REPEAT
# reads of a literal
# L0: 40460000 40460000 40460000 5000 5000 host,port,secure,depth,more 1 host,port,secure,depth,more 1
# L0-NEXT: 809200000
# L0-NEXT: a turn: 0 calls into the run time, at most 6.9 instructions
# L0-NEXT: exited with 0
# reads of a spread
