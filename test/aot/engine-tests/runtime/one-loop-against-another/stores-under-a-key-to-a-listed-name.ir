# What a turn of each loop of the program takes: calls into the run time, and instructions by the counter of the hardware, where that can be read.
# The shell hands in the name of the loop and the key. It reads the counts where the program reads `turns`, in front of the loop, and where it reports, behind it.
# -- source: stores-under-a-key-to-a-listed-name.js
# // `holder[name] = value` under a name that the build cannot read and that a literal or a class of the program lists, where the value is an object.
# class Holder {
#   constructor(value) {
#     this.other = 1;
#     this.shelf = value;
#   }
# }
# function fill(holder, name, value, rounds) {
#   for (let round = 0; round < rounds; round++) holder[name] = value;
#   return holder.shelf === value;
# }
# const name = key;
# const value = { a: 1 };
# report(fill({ other: 1, shelf: value }, name, value, 5000), fill(new Holder(value), name, value, 5000));
# const rounds = Number(turns);
# if (loop === "a literal") report(fill({ other: 1, shelf: value }, name, value, rounds));
# if (loop === "an instance") report(fill(new Holder(value), name, value, rounds));
# -- end of source
# FORM: AsRead
# REPEAT: run = L0 L1; loop = a_literal an_instance; most = 57.9 57.9
# RUN(%(run)): run-in-shell --aotCountsPath=/dev/null --useConcurrentGC=0 --numberOfGCMarkers=1 const calls = () => aotRuntimeCounters().split("\n").reduce((sum, line) => sum + (/\toperation:/.test(line) ? parseInt(line) : 0), 0); let callsBefore, instructionsBefore; globalThis.loop = "%(loop)".replaceAll("_", " "); globalThis.key = ["sh", "elf"].join(""); Object.defineProperty(globalThis, "turns", { get() { callsBefore = calls(); instructionsBefore = aotInstructionCount(); return 100000; } }); globalThis.report = (...values) => { const instructions = aotInstructionCount(); print(values.join(" ")); if (callsBefore === undefined) return; const taken = instructions === null ? 0 : Math.round((instructions - instructionsBefore) / 10000) / 10; print("a turn:", Math.round((calls() - callsBefore) / 10000) / 10, "calls into the run time,", taken <= %(most) ? "at most %(most) instructions" : taken + " instructions"); callsBefore = undefined; };
# REQUIRES(%(run)): x86_64 unsanitized-code not-windows faulting-loop-polls
# END REPEAT
# a literal
# L0: true true
# L0-NEXT: true
# L0-NEXT: a turn: 0 calls into the run time, at most 57.9 instructions
# L0-NEXT: exited with 0
# an instance
# L1: true true
# L1-NEXT: true
# L1-NEXT: a turn: 0 calls into the run time, at most 57.9 instructions
# L1-NEXT: exited with 0

