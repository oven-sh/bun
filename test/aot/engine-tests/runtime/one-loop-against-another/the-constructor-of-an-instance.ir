# What a turn of each loop of the program takes: calls into the run time, and instructions by the counter of the hardware, where that can be read.
# The shell hands in the name of the loop. It reads the counts where the program reads `turns`, in front of the loop, and where it reports, behind it.
# -- source: the-constructor-of-an-instance.ts
# declare const loop: string, turns: string, isLoud: boolean, report: (...values: unknown[]) => void;
# // `other.constructor === this.constructor` and `new this.constructor(..)` on instances of one class that nothing ever changes, beside `other.next === this.next` and `new Point(..)`: the class says what lies under both names.
# class Point {
#   x: number;
#   constructor(x: number) { this.x = x; }
#   sameMethod(other: Point): boolean { return other.next === this.next; }
#   next(): Point { return new Point(this.x + 1); }
#   sameClass(other: Point): boolean { return other.constructor === this.constructor; }
#   clone(): Point { return new (this.constructor as typeof Point)(this.x + 1); }
# }
# function byMethod(rounds: number): number {
#   let point = new Point(0), same = 0;
#   const other = new Point(7);
#   for (let round = 0; round < rounds; round++) {
#     if (point.sameMethod(other)) same++;
#     point = point.next();
#   }
#   return same + point.x;
# }
# function byConstructor(rounds: number): number {
#   let point = new Point(0), same = 0;
#   const other = new Point(7);
#   for (let round = 0; round < rounds; round++) {
#     if (point.sameClass(other)) same++;
#     point = point.clone();
#   }
#   return same + point.x;
# }
# report(byMethod(5000), byConstructor(5000), (loop === "by the constructor" ? byConstructor : byMethod)(Number(turns)));
# export {};
# -- end of source
# FORM: AsRead
# REPEAT: run = L0 L1; loop = by_a_method by_the_constructor; most = 8.9 8.9
# RUN(%(run)): run-in-shell --aotCountsPath=/dev/null --useConcurrentGC=0 --numberOfGCMarkers=1 const calls = () => aotRuntimeCounters().split("\n").reduce((sum, line) => sum + (/\toperation:/.test(line) ? parseInt(line) : 0), 0); let callsBefore, instructionsBefore; globalThis.loop = "%(loop)".replaceAll("_", " "); globalThis.isLoud = false; Object.defineProperty(globalThis, "turns", { get() { callsBefore = calls(); instructionsBefore = aotInstructionCount(); return 100000; } }); globalThis.given = undefined; globalThis.apply = Reflect.apply; globalThis.report = (...values) => { const instructions = aotInstructionCount(); print(values.join(" ")); if (callsBefore === undefined) return; const taken = instructions === null ? 0 : Math.round((instructions - instructionsBefore) / 10000) / 10; print("a turn:", Math.round((calls() - callsBefore) / 10000) / 10, "calls into the run time,", taken <= %(most) ? "at most %(most) instructions" : taken + " instructions"); callsBefore = undefined; };
# REQUIRES(%(run)): x86_64 unsanitized-code not-windows faulting-loop-polls
# END REPEAT
# by a method
# L0: 10000 10000 200000
# L0-NEXT: a turn: 0 calls into the run time, at most 8.9 instructions
# L0-NEXT: exited with 0
# by the constructor
# L1: 10000 10000 200000
# L1-NEXT: a turn: 0 calls into the run time, at most 8.9 instructions
# L1-NEXT: exited with 0

