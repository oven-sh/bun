# What a turn of each loop of the program takes: calls into the run time, and instructions by the counter of the hardware, where that can be read.
# The shell hands in the name of the loop. It reads the counts where the program reads `turns`, in front of the loop, and where it reports, behind it.
# -- source: the-fields-of-a-merged-object.cjs
# // `sum = (sum + merged.a * merged.b - merged.c) | 0` and `sum += merged.a + merged.b + merged.c` over an object put together from defaults and options,
# // by a spread and by Object.assign onto an empty literal, beside the same loops over a literal with the same fields. The build does not know the three numbers: what it knows it
# // reads from no object.
# const [one, two, three] = isLoud ? [7, 8, 9] : [1, 2, 3];
# const defaults = { a: one, b: two };
# function spread(options) {
#   return { ...defaults, ...options };
# }
# function assign(options) {
#   return Object.assign({}, defaults, options);
# }
# const written = { a: one, b: two, c: three };
# const spreadOut = spread({ c: three });
# const assigned = assign({ c: three });
#
# function productsOfWritten(rounds) {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum = (sum + written.a * written.b - written.c) | 0;
#   return sum;
# }
# function productsOfSpread(rounds) {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum = (sum + spreadOut.a * spreadOut.b - spreadOut.c) | 0;
#   return sum;
# }
# function productsOfAssigned(rounds) {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum = (sum + assigned.a * assigned.b - assigned.c) | 0;
#   return sum;
# }
# function sumsOfWritten(rounds) {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum += written.a + written.b + written.c;
#   return sum;
# }
# function sumsOfSpread(rounds) {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum += spreadOut.a + spreadOut.b + spreadOut.c;
#   return sum;
# }
# function sumsOfAssigned(rounds) {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum += assigned.a + assigned.b + assigned.c;
#   return sum;
# }
#
# report(productsOfWritten(5000), productsOfSpread(5000), productsOfAssigned(5000));
# report(sumsOfWritten(5000), sumsOfSpread(5000), sumsOfAssigned(5000));
# const rounds = Number(turns);
# if (loop === "products of a literal") report(productsOfWritten(rounds));
# if (loop === "products of a spread") report(productsOfSpread(rounds));
# if (loop === "products of an assigned object") report(productsOfAssigned(rounds));
# if (loop === "sums of a literal") report(sumsOfWritten(rounds));
# if (loop === "sums of a spread") report(sumsOfSpread(rounds));
# if (loop === "sums of an assigned object") report(sumsOfAssigned(rounds));
# -- end of source
# FORM: AsRead
# REPEAT: run = L0 L1 L2 L3 L4 L5; loop = products_of_a_literal products_of_an_assigned_object sums_of_a_literal sums_of_an_assigned_object products_of_a_spread sums_of_a_spread; most = 11.9 11.9 5.9 5.9 11.9 5.9
# RUN(%(run)): run-in-shell --aotCountsPath=/dev/null --useConcurrentGC=0 --numberOfGCMarkers=1 const calls = () => aotRuntimeCounters().split("\n").reduce((sum, line) => sum + (/\toperation:/.test(line) ? parseInt(line) : 0), 0); let callsBefore, instructionsBefore; globalThis.loop = "%(loop)".replaceAll("_", " "); globalThis.isLoud = false; Object.defineProperty(globalThis, "turns", { get() { callsBefore = calls(); instructionsBefore = aotInstructionCount(); return 100000; } }); globalThis.given = undefined; globalThis.apply = Reflect.apply; globalThis.report = (...values) => { const instructions = aotInstructionCount(); print(values.join(" ")); if (callsBefore === undefined) return; const taken = instructions === null ? 0 : Math.round((instructions - instructionsBefore) / 10000) / 10; print("a turn:", Math.round((calls() - callsBefore) / 10000) / 10, "calls into the run time,", taken <= %(most) ? "at most %(most) instructions" : taken + " instructions"); callsBefore = undefined; };
# REQUIRES(%(run)): x86_64 unsanitized-code not-windows
# END REPEAT
# products of a literal
# L0: -5000 -5000 -5000
# L0-NEXT: 30000 30000 30000
# L0-NEXT: -100000
