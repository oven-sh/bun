# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.argv = ["", "", "2500", "tag"]; globalThis.report = (...values) => { let text = ""; for (let i = 0; i < values.length; i++) text += (i ? " " : "") + values[i]; print(text); for (const name of ["ResolvePromise", "ResolvePromiseOrReturnResult"]) { const calls = aotOperationCount("operationAOT" + name); print(name, calls < 200 ? "seldom" : calls); } print(aotOperationCount("operationAOTResolvePromise") + aotOperationCount("operationAOTResolvePromiseOrReturnResult") > 0 ? "asked at first" : "never asked"); };
# An async function returns an object that has a property its literal does not name, and one that had such a property and lost it.
# The first result of each kind asks the run time whether it has a `then`. The answer is kept with the shape of the object.
# CHECK: true
# CHECK-NEXT: ResolvePromise seldom
# CHECK-NEXT: ResolvePromiseOrReturnResult seldom
# CHECK-NEXT: asked at first
# CHECK-NEXT: exited with 0

