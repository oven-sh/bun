# class Point {
#   constructor(x) { this.x = x; }
# }
# const rounds = Number(argv[2]);
# async function awaits(value) {
#   let sum = 0;
#   for (let round = 0; round < rounds; round++) sum += (await value).x;
#   return sum;
# }
# const alone = [await awaits({ x: 1 }), await awaits(new Point(2))];
# const together = await Promise.all([awaits({ x: 3 }), awaits(new Point(4)), awaits({ x: 5 })]);
# report([...alone, ...together].map(sum => sum / rounds).join(" "));
# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.argv = ["", "", "2500"]; globalThis.report = (...values) => { let text = ""; for (let i = 0; i < values.length; i++) text += (i ? " " : "") + values[i]; print(text); for (const name of ["AwaitWithSavedFrame", "SaveFrameAndAwait"]) { const calls = aotOperationCount("operationAOT" + name); print(name, calls < 200 ? "seldom" : calls); } print(aotOperationCount("operationAOTAwaitWithSavedFrame") + aotOperationCount("operationAOTSaveFrameAndAwait") > 0 ? "asked at first" : "never asked"); };
# An await of an object without a `then` is an await of a settled value. Alone and beside other awaits, only the first suspension of each function asks the run time.
# CHECK: 1 2 3 4 5
# CHECK-NEXT: AwaitWithSavedFrame seldom
# CHECK-NEXT: SaveFrameAndAwait seldom
# CHECK-NEXT: asked at first
# CHECK-NEXT: exited with 0

