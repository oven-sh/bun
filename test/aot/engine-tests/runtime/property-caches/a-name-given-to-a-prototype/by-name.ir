# Six objects, each the prototype of the next, and four receivers of four shapes below them. A round reads a value, calls a method, runs a getter and misses a name on each receiver, and adds a name to four new objects.
# Between any two of 30 rounds one of the six is given a name that nobody reads: chain[0].unrelated0 = 0;
# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null const asked = () => aotOperationCount("operationAOTGetByIdAndCache") + aotOperationCount("operationAOTPutByIdAndCache") + aotOperationCount("operationAOTFillSiteCache"); let marked; globalThis.mark = () => { marked = asked(); }; globalThis.report = (...values) => { let text = ""; for (let i = 0; i < values.length; i++) text += (i ? " " : "") + values[i]; print(text); print(marked > 0 ? "the first rounds ask" : "nothing asks"); const later = asked() - marked; print(later < 90 ? "few ask later: a round that lost its caches would ask sixteen times" : later); };
# What is cached under the names that are read outlives the names that a prototype is given.
# CHECK: 64080
# CHECK-NEXT: the first rounds ask
# CHECK-NEXT: few ask later: a round that lost its caches would ask sixteen times
# CHECK-NEXT: exited with 0

