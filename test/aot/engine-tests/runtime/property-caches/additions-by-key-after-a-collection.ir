# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.argv = ["", "", "2500"]; globalThis.collect = () => fullGC(); globalThis.report = (...values) => { let text = ""; for (let i = 0; i < values.length; i++) text += (i ? " " : "") + values[i]; print(text); for (const name of ["PutByValGeneric", "PutByVal", "PutByValAndCache"]) { const calls = aotOperationCount("operationAOT" + name); print(name, calls < 200 ? "seldom" : calls); } print(aotOperationCount("operationAOTPutByValGeneric") + aotOperationCount("operationAOTPutByVal") + aotOperationCount("operationAOTPutByValAndCache") > 0 ? "asked at first" : "never asked"); };
