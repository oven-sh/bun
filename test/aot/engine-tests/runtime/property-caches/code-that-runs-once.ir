# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.argv = ["", ""]; const counters = () => { const all = {}; const lines = aotRuntimeCounters().split("\n"); for (let i = 0; i < lines.length; i++) { const parts = lines[i].split("\t"); if (parts.length > 1) all[parts[1]] = Number(parts[0]); } return all; }; let marked; globalThis.mark = () => { marked = counters(); }; globalThis.report = (name, sum) => { const now = counters(); const since = operation => (now["operation:operationAOT" + operation] || 0) - (marked["operation:operationAOT" + operation] || 0); const filed = since("GetByIdAndCache") + since("PutByIdAndCache"); print(name + ": " + sum + ", files " + (filed >= 12 ? "its answers" : filed) + ", asks without filing " + (since("GetById") + since("PutById"))); };
# 12 reads and 12 stores by name in code that runs once fill no cache: the object itself answers the reads, and each store asks the run time without filing anything.
# The same accesses in a loop file their answers in the first rounds, and nothing after that.
# CHECK: straight: 66, files 0, asks without filing 12
# CHECK-NEXT: a loop: 3366, files its answers, asks without filing 0
# CHECK-NEXT: the loop again: 33066, files 0, asks without filing 0
