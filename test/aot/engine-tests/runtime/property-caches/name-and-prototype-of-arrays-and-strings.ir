# function joined(list, f) { let text = ""; for (let i = 0; i < list.length; i++) text += (i ? " | " : "") + f(list[i]); return text; }
# const rounds = Number(argv[2]);
# function describe(value) {
#   return (value.name ?? "none") + " " + (value.prototype ?? "none") + " " + value.length;
# }
# const values = [[1, 2], "text", [0.5]];
# const seen = new Set();
# for (let round = 0; round < rounds; round++) seen.add(describe(values[round % 3]));
# report([...seen].join(" | "));
# values[0].name = "own";
# values[2].prototype = "own too";
# report(joined(values, describe), "|", describe([]));
# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.argv = ["", "", "2500"]; let reports = 0; globalThis.report = (...values) => { let text = ""; for (let i = 0; i < values.length; i++) text += (i ? " " : "") + values[i]; print(text); if (++reports === 2) { for (const name of ["GetById", "GetByIdAndCache", "GetGeneric"]) { const calls = aotOperationCount("operationAOT" + name); print(name, calls < 200 ? "seldom" : calls); } print(aotOperationCount("operationAOTGetById") + aotOperationCount("operationAOTGetByIdAndCache") + aotOperationCount("operationAOTGetGeneric") > 0 ? "asked at first" : "never asked"); } };
# `name` and `prototype` are read off arrays and a string, which have neither. The first read of each kind of receiver asks the run time.
# CHECK: none none 2 | none none 4 | none none 1
# CHECK-NEXT: own none 2 | none none 4 | none own too 1 | none none 0
# CHECK-NEXT: GetById seldom
# CHECK-NEXT: GetByIdAndCache seldom
# CHECK-NEXT: GetGeneric seldom
# CHECK-NEXT: asked at first
# CHECK-NEXT: exited with 0

