# class Core {
#   constructor(options) {
#     this.update = newOptions => {
#       this.options = { ...this.options, ...newOptions };
#       if (this.options.tree !== this.tree) { this.tree = this.options.tree; this.build(); }
#     };
#     this.build = () => { this.built = (this.built ?? 0) + 1; };
#     this.update(options);
#   }
#   get state() { return this.built; }
#   load() { return this.tree.length + this.state; }
# }
# class Router extends Core { constructor(options) { super(options); } }
# globalThis[argv.length > 99 ? argv[9] : "hidden"] = { make: options => new Router(options), read: router => router.tree };
# let sum = 0;
# const tree = [1, 2, 3];
# for (let round = 0; round < 4000; round++) {
#   const router = globalThis.hidden.make({ tree });
#   sum += router.load() + globalThis.hidden.read(router).length;
#   if (round % 1000 === 999) collect();
# }
# report(sum);
# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.argv = ["", ""]; globalThis.collect = () => fullGC(); const counters = () => { const all = {}; const lines = aotRuntimeCounters().split("\n"); for (let i = 0; i < lines.length; i++) { const parts = lines[i].split("\t"); if (parts.length > 1) all[parts[1]] = Number(parts[0]); } return all; }; globalThis.report = (...values) => { let text = ""; for (let i = 0; i < values.length; i++) text += (i ? " " : "") + values[i]; print(text); const now = counters(); let calls = 0; for (const key in now) if (/^operation:operationAOT(GetBy|GetGeneric|InBy|HasOwn)/.test(key)) calls += now[key]; print(calls < 400 ? "seldom asks the run time" : calls); };
# The constructor reads `this.tree` while its slot is still empty, and the lookup that files the answer is the one that gives the prototype objects their members. The read stays cached through 4,000 rounds and four collections.
# CHECK: 28000
# CHECK-NEXT: seldom asks the run time
# CHECK-NEXT: exited with 0

