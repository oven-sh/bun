# }
# const values = [new Source(), new Heir(), Plain.prototype, new Plain()];
# const seen = new Set();
# for (let round = 0; round < rounds; round++) seen.add(describe(values[round & 3]));
# report([...seen].join(" | "));
# Source.prototype[Symbol.asyncIterator] = function () {};
# Legacy.prototype[Symbol.iterator] = function () {};
# Object.defineProperty(Plain.prototype, Symbol.toStringTag, { get() { return "plain"; } });
# report(joined(values, describe));
# report(values[0].open, values[1].walk() + values[1].run(), values[3].walk(), Object.prototype.toString.call(values[3]));
# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.argv = ["", "", "2500"]; let reports = 0; globalThis.report = (...values) => { let text = ""; for (let i = 0; i < values.length; i++) text += (i ? " " : "") + values[i]; print(text); if (++reports === 3) { for (const name of ["GetById", "GetByIdAndCache", "GetGeneric"]) { const calls = aotOperationCount("operationAOT" + name); print(name, calls < 200 ? "seldom" : calls); } print(aotOperationCount("operationAOTGetById") + aotOperationCount("operationAOTGetByIdAndCache") + aotOperationCount("operationAOTGetGeneric") > 0 ? "asked at first" : "never asked"); } };
# Symbol.iterator, Symbol.asyncIterator and Symbol.toStringTag are read off objects of classes that declare none of them. The first read of each kind of receiver asks the run time.
# CHECK: undefined undefined none
# CHECK-NEXT: undefined function none | function undefined none | undefined undefined plain | undefined undefined plain
# CHECK-NEXT: true 3 3 [object plain]
# CHECK-NEXT: GetById seldom
# CHECK-NEXT: GetByIdAndCache seldom
# CHECK-NEXT: GetGeneric seldom
# CHECK-NEXT: asked at first
# CHECK-NEXT: exited with 0

