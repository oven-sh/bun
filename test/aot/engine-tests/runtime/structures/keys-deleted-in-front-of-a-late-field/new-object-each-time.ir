# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.env = {"TURNS": "10000", "COUNT": "5"}; const counters = () => { const all = {}; const lines = aotRuntimeCounters().split("\n"); for (let i = 0; i < lines.length; i++) { const parts = lines[i].split("\t"); if (parts.length > 1) all[parts[1]] = Number(parts[0]); } return all; }; let marked; globalThis.mark = () => { marked = counters(); }; let stopped; globalThis.stop = () => { stopped = counters(); }; globalThis.report = (...values) => { let text = ""; for (let i = 0; i < values.length; i++) text += (i ? " " : "") + values[i]; print(text); print(stopped["counter:CompiledStructuresMade"] - marked["counter:CompiledStructuresMade"], "Structures made in the last 5,000 turns"); };
# An instance gets keys that its class does not declare, then a field of the class is created behind them, so the order of the keys has a field in the middle.
# Then keys in front of that field are deleted. However many go, no Structure is made for them.
# CHECK: 60000 6:first,k0,k1..k2,k4,second 6:first,k0,k1..k2,k4,second 6 56
# CHECK-NEXT: 0 Structures made in the last 5,000 turns
# CHECK-NEXT: exited with 0

