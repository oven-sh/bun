# Four objects are each given 16 names by code that runs once: Made.prototype.method0 = .. . holder.member0 = .. . Object.defineProperty(defined, "member0", ..) . parsed.member0 = ..
# Then 500 objects out of JSON.parse are given the same 16 names in the same order.
# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null const made = () => { const sums = { more: 0, dictionaries: 0 }; const lines = aotRuntimeCounters().split("\n"); for (let i = 0; i < lines.length; i++) { const words = lines[i].split(" "); if (words[0] !== "made") continue; if (words[3].startsWith("Structure:a_property_more")) sums.more += Number(words[4]); if (words[3].startsWith("Structure:a_dictionary")) sums.dictionaries += Number(words[4]); } return sums; }; let marked; globalThis.mark = () => { marked = made(); }; globalThis.report = (name, sum) => { const now = made(); const more = now.more - marked.more, dictionaries = now.dictionaries - marked.dictionaries; print(name + ": " + sum + ", " + (more < (name.startsWith("500") ? 32 : 8) ? "few Structures" : more + " Structures") + ", " + (dictionaries < 4 ? "few dictionaries" : dictionaries + " dictionaries")); };
# The names that one object is given once are kept in one table: no Structure is made for each name. Objects that are given the same names again share their Structures.
# CHECK: a prototype object: 120, few Structures, few dictionaries
# CHECK-NEXT: a function: 120, few Structures, few dictionaries
# CHECK-NEXT: definitions on a function: 120, few Structures, few dictionaries
# CHECK-NEXT: what a built-in made: 120, few Structures, few dictionaries
# CHECK-NEXT: 500 objects that are given the same names: 7500, few Structures, few dictionaries
# CHECK-NEXT: exited with 0

