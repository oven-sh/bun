#       break;
#     case 0:
#       said += "|zero";
#       break;
#     default:
#       said += "|other";
#   }
#   return said;
# }
#
# function loosely(value: unknown): string {
#   return (value == "" ? "E" : "n") + (value != "" ? "n" : "E") + ("" == value ? "E" : "n");
# }
