# structuredClone(buffer, { transfer: [buffer] }); print(buffer.byteLength), validated.
# The entry only reads its first operand, and writes what the second holds under `transfer`. One object is both: what is declared for the list may happen to it.
# Once the check went by the position alone and refused the call: "argument 0: internal state changed byte length 8 -> 0".
# FORM: AsRead
# OPTIONS: validate
# RUN: run-in-shell globalThis.transferring = buffer => ({ transfer: [buffer] });
# CHECK: 0
# CHECK-NEXT: exited with 0

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = Builtin builtin=ArrayBuffer
    v2 = Integer integer=8
    v3 = Construct v1, -, v2
    v4 = PropGet v0 key="transferring" [isFreeName]
    v5 = Call v4, -, v3
    v6 = PropGet v0 key="structuredClone" [isFreeName]
    v7 = Call v6, -, v3, v5
    v8 = PropGet v3 key="byteLength"
    v9 = PropGet v0 key="print" [isFreeName]
    v10 = Call v9, -, v8
    Return
}
