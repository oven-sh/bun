# A generator with many yields is thrown into, walked by a loop and taken apart by a pattern
# -- source: steps.ts
# const printValue: any = console.log;
# let log = "";
# function* steps(x: any): any {
#   log += "s";
#   log += yield 0; yield* [1, x]; yield x + 2; log += yield 3; yield x + 4; if (x > 5) yield 5; yield x + 6; yield x + 7; if (x > 8) yield 8; yield x + 9; yield x + 10; if (x > 11) yield 11; yield x + 12; yield x + 13; yield x + 14; yield x + 15;
#   return "end";
# }
# {
#   const show = (step: any) => { try { const got = step(); return typeof got === "object" ? JSON.stringify(got) : String(got); } catch (error) { return "threw " + (error as any).message; } };
#   const walk = steps(1);
#   const said = [show(() => walk.throw(new Error("early"))), show(() => walk.next(7)), show(() => walk.next(8))];
#   let sum: any = 0; for (const each of steps(2)) { sum += each;  }
#   const [a, b] = steps(3);
#   printValue("steps ", said.join(" "), String(sum), a, b, log.length, log.slice(0, 40));
# }
