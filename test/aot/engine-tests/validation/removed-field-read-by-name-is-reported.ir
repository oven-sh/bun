# A validating build reports a read by name in compiled code that names a field removed as unread. The tables answer such a read without the run time.
# FORM: AsRead
# RUN: run-in-shell
# OPTIONS: validate sabotage=RemovedFieldsHaveUnknownReaders
# CHECK: AOT: a read names the field count of layout {{*}}, which was removed as unread
# CHECK: AOT validation: RemovedFieldNamed
# -- source: main.ts
# declare function print(...values: unknown[]): void;
# // The function of the record is only ever called, and the call reads it by name from a receiver that may be any object.
# import { attempt, holder, Other, otherHolder, pass, put, record, walk } from "./declared/index.js";
# put(holder, pass("part"), record);
# print(attempt(() => walk(holder, 3)));
# put(holder, pass("part"), pass(new Proxy({}, { get: (_, key) => (key === "read" ? (i: number) => "trap" + i : 5) })));
# print(attempt(() => walk(holder, 3)));
# (otherHolder as any)["part"] = Object.assign(new Other(), { ["read"]: (i: number) => "own" + i });
# -- source: declared/index.js
# export const pass = Function("value", "return value");
# export function put(target, key, value) {
#   target[key] = value;
# }
# export function attempt(act) {
#   try {
#     return String(act());
#   } catch (error) {
#     return error.constructor.name;
#   }
# }
# export class Part {}
# export function walk(holder, turns) {
#   let text = "";
#   for (let i = 0; i < turns; i++) text += (holder.part.count > 100 ? "" : holder.part.read(i)) + ",";
#   return text;
# }
# export const record = { open: null, port: 80, host: "h", read: i => "record" + i, count: 5 };
# export const holder = { id: 0, part: new Part() };
# export class Other {
#   read(i) {}
# }
# export const otherHolder = { id: 1, part: new Other() };
# -- source: declared/index.d.ts
# export declare const pass: any;
# export declare function put(target: any, key: string, value: unknown): void;
# export declare function attempt(act: () => unknown): string;
# export declare class Part {
#   [member: string]: any;
# }
# export type Holder = { id: number; part: Part };
# export declare function walk(holder: Holder, turns: number): string;
# export declare const record: any;
# export declare const holder: Holder;
# export declare class Other {
#   [member: string]: any;
# }
# export declare const otherHolder: { id: number; part: Other };
# -- end of source

