# function second(first, value) { first.x; value.x }  second.call(undefined, 1, "text")
# The row of Function.prototype.call lists its rest operand as the arguments of the function that it calls. They are handed on in order: the number is the first argument and the text the second.
# Native code says of no position that it leaves it empty, so each parameter may be undefined too (primitive0).
# RUN: valueflow-why values=f1:v2 values=f1:v3
# CHECK: values=f1:v2
# CHECK: operand 0 {{*}} 2 members: primitive0 primitive4
# CHECK: values=f1:v3
# CHECK: operand 0 {{*}} 2 members: primitive0 key{{*}}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=FunctionPrototypeCall
    v2 = Undefined
    v3 = Integer integer=1
    v4 = String string="text"
    v5 = Call v1, v0, v2, v3, v4
    Return
}
function f1 name="second" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="x"
    v3 = PropGet v1 key="x"
    Return v2
}
