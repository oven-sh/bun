entry module=m0
layout L0 name="Options" fields=[{key="data" declared={type=anything} flags=[IsRequired]}, {key="socket" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Undefined
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = Builtin builtin=Bun
    v4 = Builtin builtin=BunListen
    v5 = NewClosure function=f2
    v6 = Call v4, v3, v2
    v7 = PropGet v6 key="data"
    v8 = Call v7, -
    PropSet v6, v5 key="data" mode=Strict
    v10 = PropGet v6 key="data"
    v11 = Call v10, -
    Return
}
function f1 name="first" kind=Arrow results=[{type=anything}] {
