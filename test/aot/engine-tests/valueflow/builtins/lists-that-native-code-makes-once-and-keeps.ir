# -- source: lists-that-native-code-makes-once-and-keeps.js
# // Native code makes process.argv, process.execArgv and the list of built-in modules at the first read and keeps them. Nothing here changes one of them: each is a list of strings without holes that has what it was made with.
# import { builtinModules } from "node:module";
# function hasFlag(flag) {
#   return process.argv.includes(flag);
# }
# function ofTheRuntime(flag) {
#   return process.execArgv.indexOf(flag);
# }
# function isBuiltIn(name) {
#   return builtinModules.includes(name);
# }
# console.log(hasFlag(String(Date.now())), ofTheRuntime(String(Date.now())), isBuiltIn(String(Date.now())));
# -- end of source
# FORM: AsRead
# RUN: pipeline FinishBirths

