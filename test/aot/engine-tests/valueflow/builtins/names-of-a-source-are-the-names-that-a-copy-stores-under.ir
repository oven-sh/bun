# function Base() {}  Base.prototype.run = 1;  function Heir() {}
# const accessors = { other: { set: neverByKeys } };  Object.defineProperties(Heir.prototype, accessors);  kept.accessors = accessors;
# Heir.prototype[Object.keys(Base.prototype)[0]] = 2;
# const target = {};  Object.defineProperty(target, "other", { set: neverByAssign });  Object.assign(target, { run: 3 });
# The map of descriptors goes elsewhere only behind the call, so the call defines `other` and no other name. The prototype object of a constructor function lists the names that were stored on it.
# Object.assign stores under the names of the literal. So no store here is under `other`, and neither setter runs.
