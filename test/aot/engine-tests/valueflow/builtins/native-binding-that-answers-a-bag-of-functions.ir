# UNREACHED-NOT: unreached f3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Converted" fields=[{key="valueOf" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    Return
}
function f1 name="library" role=Library results=[{type=anything}] {
  b0():
    v0 = NativeBinding builtin=NativeCppProcessBindingTTYWrapCppCreateBunTTYFunctions
    v1 = PropGet v0 key="setRawMode"
    v2 = NewClosure function=f2
    v3 = NewClosure function=f3
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = FinishObject v4
    v6 = Call v1, -, v2, v5
    Return
}
function f2 name="inspected" results=[{type=anything}] {
  b0():
    Return
}
function f3 name="converted" results=[{type=anything}] {
  b0():
    Return
}
