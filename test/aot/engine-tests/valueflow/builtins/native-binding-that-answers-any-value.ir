# $cpp("JSCTestingHelpers.cpp", "createJSCTestingHelpers")(handed)
# `$cpp` and `$rust` answer whatever their native function returns: an object, a list of objects, a number. Nobody knows that value, nor what a call of it enters.
# The example is a binding for Bun's own tests: the table will not come to describe it.
# LIBRARY: own
# RUN: valueflow-solve calls
# CHECK: f1 v2 -> unknown
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    Return
}
function f1 name="library" role=Library results=[{type=anything}] {
  b0():
    v0 = NativeBinding builtin=NativeCppJSCTestingHelpersCppCreateJSCTestingHelpers
    v1 = NewClosure function=f2
    v2 = Call v0, -, v1
    Return
}
function f2 name="handed" results=[{type=anything}] {
  b0():
    Return
}
