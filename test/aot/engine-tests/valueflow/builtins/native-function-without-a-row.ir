# const native = $newCppFunction("InternalForTesting.cpp", "jsFunction_hasReifiedStatic", 2); native.call(receiver, handed)()
# The macro answers one native function, so the call is a call of its entry and of nothing else. The entry says nothing of the call: the receiver and the argument are handed over and entered, and nobody knows the answer.
# The example is a function for Bun's own tests: the table will not come to describe it.
# LIBRARY: own
# RUN: valueflow-solve calls
# CHECK: f1 v3 -> NativeFunctionsInternalForTestingCppJsFunction_hasReifiedStatic
# CHECK-NEXT: f1 v4 -> unknown
# CHECK: f2 v1 -> unknown
# CHECK: f3 v1 -> unknown
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f2
# UNREACHED-NOT: unreached f3
# UNREACHED: unreached f4

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    Return
}
function f1 name="library" role=Library results=[{type=anything}] {
  b0():
    v0 = NativeBinding builtin=NativeNewCppFunctionInternalForTestingCppJsFunction_hasReifiedStatic
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = Call v0, v1, v2
    v4 = Call v3
    v5 = NewClosure function=f4
    Return
}
function f2 name="receiver" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    Return
}
function f3 name="handed" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    Return
}
function f4 name="kept" results=[{type=anything}] {
  b0():
    Return
}
