# A reviver puts lists and an instance of the program into the holder, and JSON.parse deletes and defines in them
# -- source: reviver.js
# const numbers = [1, 2, 3, 4], objects = [{ q: 1 }, { q: 2 }], doubles = [1.5, 2.5, 3.5];
# class Held { first = { q: 1 }; second = { q: 2 }; }
# const held = new Held();
# function sum(list) { let total = 0; for (let i = 0; i < list.length; i++) total += list[i]; return total; }
# function attempt(read) { try { return read(); } catch (error) { return error.constructor.name; } }
# JSON.parse('{"a":1,"b":2,"c":3,"d":4,"e":5}', function (key, value) {
#   if (key === "a") { this.b = numbers; this.c = objects; this.d = doubles; this.e = held; }
#   if (this === numbers) return key === "1" ? undefined : key === "2" ? "s" : value;
#   if (this === objects) return key === "0" ? 5 : value;
#   if (this === doubles) return key === "1" ? undefined : value;
#   if (this === held) return key === "first" ? undefined : 7;
#   return value;
# });
