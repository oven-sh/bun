# -- source: the-index-that-a-built-in-hands-its-callback-is-a-number.ts
# // Array.from is declared to call its mapper with an item and an index. The index is a number that the built-in makes, so `k` is never undefined,
# // `b` is always filled with a number, and area() reads both slots without asking whether they are filled.
# class Triangle {
#   constructor(
#     public b: number,
#     public h: number,
#   ) {}
#   area() {
#     return (this.b * this.h) / 2;
#   }
# }
# const shapes = Array.from({ length: 8 }, (_, k) => new Triangle(k, 3));
# let sum = 0;
# for (let turn = 0; turn < 100; turn++) for (const shape of shapes) sum += shape.area();
# console.log(sum);
# -- end of source
# FORM: AsRead
# RUN: pipeline FinishBirths
# RUN(WHOLE): compile
# WHOLE: image not empty
# CHECK-LABEL: name="area"
# CHECK-NOT: IsSlotFilled
# CHECK-NOT: PropGet
# CHECK: Return

