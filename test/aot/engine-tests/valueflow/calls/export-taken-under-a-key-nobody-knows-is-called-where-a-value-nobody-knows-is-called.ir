# vm = require("node:vm"); taken = input(vm[name]); taken("1")
# As export-that-the-program-named-is-called-where-a-value-nobody-knows-is-called.ir, with a key that may be the name of any export.
# RUN: valueflow-solve calls
# CHECK: f0 v7 -> unknown
# CHECK: f2 v2 -> Eval
# RUN(UNSEEN): valueflow-solve unseen
# UNSEEN: unseen EvaluatesText Eval f2:v2
# UNSEEN: unseen-code yes

module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0
module m1 path="node:vm" displayPath="node:vm" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeVm body=f1
entry module=m0
layout L0 name="Exports" fields=[{key="run" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" module=m0 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = RequireModule module=m1 referrer=m0 specifier="node:vm"
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="name" [isFreeName]
    v3 = ElemGet v0, v2
    v4 = PropGet v1 key="input" [isFreeName]
    v5 = Call v4, -, v3
    v6 = String string="1"
    v7 = Call v5, -, v6
    Return
}
function f1 name="vm" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="run" module=m1 role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=Eval
    v2 = Call v1, -, v0
    Return v2
}
