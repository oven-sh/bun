# readline = require("node:readline"); first = readline.first; first(callback); eval(input); added = readline.added; added()
# Evaluated text names the modules of the library, so native code holds what those in the image export. Whatever the program can call has to work on a path that nobody follows too:
# the export that seen code calls is entered with operands nobody knows as well. The export beside it is still only held. It stays unreached, and so does the module that it requires.
# What is held is written like what has escaped, so a read of the object that holds the exports may find anything
# RUN: valueflow-solve calls
# CHECK: f0 v7 -> Eval
# CHECK-NEXT: f0 v9 -> unknown
# CHECK: f2 v1 -> unknown
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f1
# UNREACHED-NOT: unreached f2
# UNREACHED: unreached f3
# UNREACHED-NEXT: unreached f4
# UNREACHED-NOT: unreached f5
# RUN(ESCAPED): valueflow-why escaped=f2 escaped=f3
# ESCAPED: escaped=f2
# ESCAPED-NEXT: n0 escaped
# ESCAPED: escaped=f3
# ESCAPED-NEXT: not held
# RUN(UNSEEN): valueflow-solve unseen
# UNSEEN: unseen EvaluatesText Eval f0:v7
# UNSEEN: unseen-code yes
# UNSEEN-NEXT: modules-by-name yes
# UNSEEN-NEXT: held f3
# UNSEEN-NOT: held

