# With declared functions: What runs while a class is evaluated runs once a call, in the order of the text, and sees the call's own arguments and the counters around the function.
# -- source: declared-what-runs-while-a-class-out-of-a-function-is-evaluated.js
# // With declared functions: What runs while a class is evaluated runs once a call, in the order of the text, and sees the call's own arguments and the counters around the function.
# const log = [];
# let evaluations = 0;
# class Base { static inherited = "base"; }
# class Other { static inherited = "other"; }
