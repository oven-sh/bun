# console.log    delete console.warn; console.warn    console.__defineSetter__-like: { set error(v) {} } on console; console.error    console.info = undefined; console.info    console.nothingHere
# RegExp.prototype.lastIndex    RegExp.$1    Math.imul
# A read that starts at a built-in holder with a member of the name finds the member, so it does not answer undefined: the lookup never comes to the end of a chain.
# It may answer undefined where the member may be deleted, where an accessor with a setter alone may take its place, where undefined is stored, and where the holder has no such member.
# What the table lists at a prototype object for the instances of the class does not lie on that object, and a member that changes on its own may hold anything
# RUN: valueflow-apply
# CHECK: variable g0 name="kept" module=m0 declared={type=builtin(ConsoleLog)}
# CHECK: variable g1 name="deleted" module=m0 declared={type=anything}
# CHECK: variable g2 name="setterAlone" module=m0 declared={type=undefined|builtin(ConsoleError)}
# CHECK: variable g3 name="storedUndefined" module=m0 declared={type=undefined|builtin(ConsoleInfo)}
# CHECK: variable g4 name="noSuchMember" module=m0 declared={type=anything}
# CHECK: variable g5 name="ofInstances" module=m0 declared={type=undefined|number}
# CHECK: variable g6 name="changesOnItsOwn" module=m0 declared={type=undefined|string}
# CHECK: variable g7 name="locked" module=m0 declared={type=builtin(MathImul)}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="deleted" module=m0 declared={type=anything} initialization=Undefined
