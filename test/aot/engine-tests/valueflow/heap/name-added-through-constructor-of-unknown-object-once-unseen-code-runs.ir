# Bun.plugin(options); unknown = somethingNoTableLists; unknown.constructor.extra = one; Array.extra()
# A plugin lets in whole files that the build has not seen. Such code may patch the realm before anybody uses it, so nothing there is locked: the built-in objects of the realm are open, and it holds all of them.
# The unknown object may be an array, so the store may go to `Array`: what the program stores through the unknown object is found on every object that has escaped.
# name-added-through-constructor-of-unknown-object-where-text-is-evaluated.ir has the same program with eval in place of the plugin
# RUN: valueflow-solve calls
# CHECK: f0 v10 -> {{*}}f1
# RUN(UNSEEN): valueflow-solve unseen
# UNSEEN: unseen-code yes

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module parameters=[] results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=BunPlugin
    v1 = Undefined
    v2 = Call v0, v1, v1
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="somethingThatNoTableLists" [isFreeName]
    v5 = PropGet v4 key="constructor"
    v6 = NewClosure function=f1
    PropSet v5, v6 key="extra" mode=Strict
    v8 = Builtin builtin=Array
    v9 = PropGet v8 key="extra"
    v10 = Call v9, v8
    Return
}
function f1 name="one" results=[{type=anything}] {
  b0():
    Return
}
