  b0():
    v0 = Integer integer=1
    v1 = NewArray v0 contents=anything
    v2 = NewDictionary
    v3 = Integer integer=0
    v4 = String string="text"
    ElemSet v2, v3, v4 mode=Strict
    v6 = Builtin builtin=Object
    v7 = Builtin builtin=ObjectAssign
    v8 = Call v7, v6, v1, v2
    v9 = PropGet v1 key="map"
    v10 = NewClosure function=f4
    v11 = Call v9, v1, v10 calleeKey="map"
    Return v11
}
