    v2 = Builtin builtin=BufferAlloc
    v3 = Integer integer=2
    v4 = Call v2, -, v3
    v5 = Builtin builtin=Error
    v6 = String string="x"
    v7 = NewObject -, v4 layout=L0 fields=[0]
    v8 = FinishObject v7
    v9 = Construct v5, -, v6, v8
    v10 = PropGet v9 key="cause"
    v11 = Call v1, v0, v10
    Return v11
}
