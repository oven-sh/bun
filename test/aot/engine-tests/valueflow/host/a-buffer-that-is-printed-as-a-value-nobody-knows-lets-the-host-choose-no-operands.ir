module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="ErrorOptions" fields=[{key="cause" declared={type=anything}}] ownFieldCount=1
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=Console
