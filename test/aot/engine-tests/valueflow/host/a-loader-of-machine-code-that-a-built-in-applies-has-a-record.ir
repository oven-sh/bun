# Reflect.apply(process.dlopen, process, list)
# No operation spells the call out, so the record names no place. a-call-that-loads-machine-code-has-a-record.ir has the call
# RUN: valueflow-solve unseen
# CHECK: unseen RunsMachineCode ProcessDlopen
# CHECK-NEXT: unseen-code no

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Process
    v1 = PropGet v0 key="dlopen"
    v2 = Builtin builtin=ReflectApply
    v3 = NewArray
    v4 = Call v2, -, v1, v0, v3
    Return
}
