# console.log(new Error("x", { cause: new URL("http://a/") }).cause)
# What is printed is an object nobody knows. URL is in use and is listed with the feature of its class, so an instance may be among the objects nobody knows.
# Its method under Symbol.for("nodejs.util.inspect.custom") has no row. HostChoosesOperands (h7) goes up.
# RUN: valueflow-why timeline
# CHECK: flag h7

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="ErrorOptions" fields=[{key="cause" declared={type=anything}}] ownFieldCount=1
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=Console
    v1 = Builtin builtin=ConsoleLog
    v2 = Builtin builtin=URL
    v3 = String string="http://a/"
    v4 = Construct v2, -, v3
    v5 = Builtin builtin=Error
    v6 = String string="x"
    v7 = NewObject -, v4 layout=L0 fields=[0]
    v8 = FinishObject v7
    v9 = Construct v5, -, v6, v8
    v10 = PropGet v9 key="cause"
    v11 = Call v1, v0, v10
    Return v11
}
