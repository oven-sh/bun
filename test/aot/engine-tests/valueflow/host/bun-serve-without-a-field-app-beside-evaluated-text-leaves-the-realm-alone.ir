# new Function("return 1"); Bun.serve({ port: 0 })
# Text that is evaluated reaches the global scope, and what has escaped may then hold anything under any name: the options too, once the server keeps them. At the call they are the literal that is written there.
# So the call goes by the fields of what reaches it, and the evaluator beside it does not make a development server of every server: the code that runs stays text of the global scope
# RUN: valueflow-solve unseen
# CHECK: unseen-code yes
# RUN(REALM): valueflow-why flag=h19
# REALM: not held

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 fields=[{key="port" declared={type=number}}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Function
    v1 = String string="return 1"
    v2 = Construct v0, v0, v1
    v3 = Builtin builtin=Bun
    v4 = PropGet v3 key="serve"
    v5 = NewObject layout=L0
    v6 = Integer integer=0
    PropDefine v5, v6 key="port"
    v8 = FinishObject v5
    v9 = Call v4, v3, v8
    Return
}
