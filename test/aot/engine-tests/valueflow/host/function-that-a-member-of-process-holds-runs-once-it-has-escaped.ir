# publish(process.disconnect)
# The program hands the function over, and a call of a value nobody knows is a call of it.
# RUN: valueflow-solve used
# CHECK: run NativeFunctionsBunProcessCppBun__Process__disconnect
# CHECK-NOT: run NativeFunctionsBunProcessCppJsSend

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = Builtin builtin=Process
    v2 = PropGet v1 key="disconnect"
    v3 = PropGet v0 key="publish" [isFreeName]
    v4 = Call v3, -, v2
    Return
}
