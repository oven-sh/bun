    v3 = String string="abc"
    v4 = Call v2, v1, v3 calleeKey="from"
    v5 = PropGet v0 key="somethingThatNoTableLists" [isFreeName]
    v6 = Call v5, -, v4
    v7 = PropGet v0 key="keyThatNoTableLists" [isFreeName]
    v8 = ElemGet v6, v7
    Return
}
