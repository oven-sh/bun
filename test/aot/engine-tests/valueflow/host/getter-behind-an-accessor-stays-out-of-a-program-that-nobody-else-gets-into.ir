# The program names neither Buffer.prototype.offset nor process.send (runtimefunction 65565; 65559 is called on behalf of process.send), and nothing lets in code that the build has not seen.
# Only a read that the analysis sees enters the function behind the accessor. Entered from the start it would bring the unknown object into a program that has none.
# getter-behind-an-accessor-is-in-a-program-that-evaluates-text.ir has the same program with eval
# LIBRARY: own
# RUN: valueflow-solve unreached
# CHECK: unreached f1
# CHECK: unreached f2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
runtimefunction id=65559 function=f2
runtimefunction id=65565 function=f1
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f1 name="offset" role=Library flags=[HasThis] enclosingRuntimeFunction=65565 results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="byteOffset"
    Return v1
}
function f2 name="parseHandle" role=Library enclosingRuntimeFunction=65559 parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    Return v0
}
