# somethingThatNoTableLists()   The program names neither Buffer.prototype.offset nor process.send (runtimefunction 65565; 65559 is called on behalf of process.send), and lets in no code that the build has not seen.
# Only a read that names the accessor enters the function behind it. TODO: the program has values that nobody knows, and `unknown[key]` names no member of the host: where such a read hits the accessor
# at run time it is refused with the error that names it. Entering the function once a call may call whatever has escaped cures that (tried 00:33:12, taken out: one function more in the tests of T:codegen)
# LIBRARY: own
# RUN: valueflow-solve unreached
# CHECK: unreached f1
# CHECK: unreached f2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
runtimefunction id=65559 function=f2
runtimefunction id=65565 function=f1
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="somethingThatNoTableLists" [isFreeName]
    v2 = Call v1
    Return
}
function f1 name="offset" role=Library flags=[HasThis] enclosingRuntimeFunction=65565 results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="byteOffset"
    Return v1
}
function f2 name="parseHandle" role=Library enclosingRuntimeFunction=65559 parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
