# somethingThatNoTableLists()   The program names neither Buffer.prototype.offset nor process.send (runtimefunction 65567; 65561 is called on behalf of process.send), and lets in no code that the build has not seen.
# Only a read enters the function behind an accessor: one that names it, or one under a key nobody knows in a program that makes an instance. This program calls a value that nobody knows and reads nothing from it.
# getter-behind-an-accessor-is-in-a-program-that-reads-an-instance-under-a-key-nobody-knows.ir has such a read
# LIBRARY: own
# RUN: valueflow-solve unreached
# CHECK: unreached f1
# CHECK: unreached f2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
runtimefunction id=65561 function=f2
runtimefunction id=65567 function=f1
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="somethingThatNoTableLists" [isFreeName]
    v2 = Call v1
    Return
}
function f1 name="offset" role=Library flags=[HasThis] enclosingRuntimeFunction=65567 results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="byteOffset"
    Return v1
}
function f2 name="parseHandle" role=Library enclosingRuntimeFunction=65561 parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    Return v0
}
