# new Request("https://example.com"); publish(handedIn[someName])
# An object nobody knows may be the request, and a key nobody knows may spell `body`. That names no member of the host: the getter is native code, which is there whoever reads it,
# so the read uses nothing of what stands behind it. getter-behind-an-accessor-is-in-a-program-that-reads-an-instance-under-a-key-nobody-knows.ir has a getter that is a function of the library
# RUN: valueflow-solve used
# CHECK-NOT: RequestPrototypeBody

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="someName" [isFreeName]
    v2 = Builtin builtin=Request
    v3 = String string="https://example.com"
    v4 = Construct v2, -, v3
    v5 = PropGet v0 key="handedIn" [isFreeName]
    v6 = ElemGet v5, v1
    v7 = PropGet v0 key="publish" [isFreeName]
    v8 = Call v7, -, v6
    Return
}
