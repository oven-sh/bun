# process.send("careful"), where parseHandle hands its operand to a helper of its file, which calls it
# parseHandle (runtimefunction 65559) stands behind no built-in: no record says what it does with its operand. So its file is no file of code that records describe, and the helper's call of a callee
# nobody knows is a call of code that nobody compiles.
# In a file of such code: helper-that-only-the-code-behind-described-built-ins-can-name-is-such-code-too.ir
# LIBRARY: own
# The call of process.send may raise the flag by itself, so the test asks for every edge into the flags.
# RUN: valueflow-why timeline
# CHECK: flag h6
# CHECK: by CallGroup

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="Ipc.ts" displayPath="Ipc.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=65559 function=f1
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Process
    v1 = PropGet v0 key="send"
    v2 = String string="careful"
    v3 = Call v1, v0, v2
    Return
}
function f1 name="parseHandle" module=m1 role=Library enclosingRuntimeFunction=65559 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f2
    v2 = Call v1, -, v0
    Return v2
}
function f2 name="helper" module=m1 role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0, -
    Return v1
}
