# console.log({ holder: process })
# The formatter goes on down into what the literal holds.
# LIBRARY: own
# LOSS: MaxValueFlowMembersToldApart x2
# RUN: valueflow-why used-builtin=ProcessAllowedNodeEnvironmentFlags
# CHECK: used-builtin=ProcessAllowedNodeEnvironmentFlags
# CHECK-NEXT: by Lookup

layout L0 fields=[{key="holder" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Console
    v1 = Builtin builtin=ConsoleLog
    v2 = Builtin builtin=Process
    v3 = NewObject layout=L0
    PropDefine v3, v2 key="holder"
    v5 = FinishObject v3
    v6 = Call v1, v0, v5
    Return
}
