# console.log(process)
# The formatter walks over what it is handed. The host makes `allowedNodeEnvironmentFlags` with a function of the library when the name is first looked for, so the walk needs that function.
# `process` itself stays out of unknown hands.
# LIBRARY: own
# LOSS: MaxValueFlowMembersToldApart x2
# RUN: valueflow-why used-builtin=ProcessAllowedNodeEnvironmentFlags escaped-builtin=Process
# CHECK: used-builtin=ProcessAllowedNodeEnvironmentFlags
# CHECK-NEXT: by Lookup
# CHECK: escaped-builtin=Process
# CHECK-NEXT: not held

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Console
    v1 = Builtin builtin=ConsoleLog
    v2 = Builtin builtin=Process
    v3 = Call v1, v0, v2
    Return
}
