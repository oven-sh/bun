# ({ ...process })
# The copy reads every member, and one that the host makes at its first read is made here.
# LIBRARY: own
# RUN: valueflow-why used-builtin=ProcessAllowedNodeEnvironmentFlags escaped-builtin=Process
# CHECK: used-builtin=ProcessAllowedNodeEnvironmentFlags
# CHECK-NEXT: by Lookup
# CHECK: escaped-builtin=Process
# CHECK-NEXT: not held

layout L0 fields=[]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Process
    v1 = NewObject layout=L0
    CopyDataProperties v1, v0
    v3 = FinishObject v1
    Return
}
