module m6 path="/$bun/js/engine/WrapForValidIteratorPrototype.ts" displayPath="/$bun/js/engine/WrapForValidIteratorPrototype.ts" flags=[IsLibrary] positions={lineStarts=[0, 3, 61, 64, 134, 204, 216, 285, 353, 425, 499, 574, 577, 638, 707, 777, 837, 910, 981, 1051, 1122, 1186, 1259, 1331, 1335, 1336, 1421, 1444, 1446, 1464, 1465, 1496, 1554, 1602, 1642, 1770, 1771, 1856, 2053, 2055, 2056, 2143, 2197, 2199, 2217, 2218, 2249, 2307, 2355, 2395, 2523, 2524, 2579, 2687, 2728, 2762, 2825, 2865, 2910, 2970, 3012, 3062, 3111, 3152, 3154] whereThisIsMade=[1421, 1441]} functionText="/*\x0a * Copyright (C) 2024 Sosuke Suzuki <aosukeke@gmail.com>.\x0a *\x0a * Redistribution and use in source and binary forms, with or without\x0a * modification, are permitted provided that the following conditions\x0a * are met:\x0a * 1. Redistributions of source code must retain the above copyright\x0a *    notice, this list of conditions and the following disclaimer.\x0a * 2. Redistributions in binary form must reproduce the above copyright\x0a *    notice, this list of conditions and the following disclaimer in the\x0a *    documentation and/or other materials provided with the distribution.\x0a *\x0a * THIS SOFTWARE IS PROVIDED BY APPLE INC. ``AS IS'' AND ANY\x0a * EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE\x0a * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR\x0a * PURPOSE ARE DISCLAIMED.  IN NO EVENT SHALL APPLE INC. OR\x0a * CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL,\x0a * EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,\x0a * PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR\x0a * PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY\x0a * OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\x0a * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE\x0a * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\x0a */\x0a\x0a// https://tc39.es/proposal-iterator-helpers/#sec-wrapforvaliditeratorprototype.next\x0aexport function next()\x0a{\x0a    \x22use strict\x22;\x0a\x0a    // 1. Let O be this value.\x0a    // 2. Perform ? RequireInternalSlot(O, [[Iterated]]).\x0a    // 3. Let iteratorRecord be O.[[Iterated]].\x0a    if (!$isWrapForValidIterator(this))\x0a        $throwTypeError(\x22%WrapForValidIteratorPrototype%.next requires that |this| be a WrapForValidIteratorPrototype object\x22);\x0a\x0a    // 4. Return ? Call(iteratorRecord.[[NextMethod]], iteratorRecord.[[Iterator]]).\x0a    return $getWrapForValidIteratorInternalField(this, $wrapForValidIteratorFieldIteratedNextMethod).$call($getWrapForValidIteratorInternalField(this, $wrapForValidIteratorFieldIteratedIterator));\x0a}\x0a\x0a// https://tc39.es/proposal-iterator-helpers/#sec-wrapforvaliditeratorprototype.return\x0a$overriddenName = \x22return\x22; export function return_()\x0a{\x0a    \x22use strict\x22;\x0a\x0a    // 1. Let O be this value.\x0a    // 2. Perform ? RequireInternalSlot(O, [[Iterated]]).\x0a    // 3. Let iteratorRecord be O.[[Iterated]].\x0a    if (!$isWrapForValidIterator(this))\x0a        $throwTypeError(\x22%WrapForValidIteratorPrototype%.next requires that |this| be a WrapForValidIteratorPrototype object\x22);\x0a\x0a    // 3. Let iterator be O.[[Iterated]].[[Iterator]].\x0a    var iterator = $getWrapForValidIteratorInternalField(this, $wrapForValidIteratorFieldIteratedIterator);\x0a    // 4. Assert: iterator is an Object.\x0a    $assert($isObject(iterator));\x0a    // 5. Let returnMethod be ? GetMethod(iterator, \x22return\x22).\x0a    var returnMethod = iterator.return;\x0a    // 6. If returnMethod is undefined, then\x0a    //   a. Return CreateIterResultObject(undefined, true).\x0a    if ($isUndefinedOrNull(returnMethod))\x0a        return { value: $undefined, done: true };\x0a    // 7. Return ? Call(returnMethod, iterator).\x0a    return returnMethod.$call(iterator);\x0a}\x0a" namespaceLayout=L(m6)
