module m1 path="/$bun/js/engine/ArrayIteratorPrototype.ts" displayPath="/$bun/js/engine/ArrayIteratorPrototype.ts" flags=[IsLibrary] positions={lineStarts=[0, 25, 50, 68, 69, 102, 211, 212, 255, 382, 384] whereThisIsMade=[25, 45]} functionText="$visibility = \x22Private\x22;\x0aexport function next() {\x0a    \x22use strict\x22;\x0a\x0a    if (!$isArrayIterator(this))\x0a        $throwTypeError(\x22%ArrayIteratorPrototype%.next requires that |this| be an Array Iterator instance\x22);\x0a\x0a    const step = $stepArrayIterator(this);\x0a    return $makeIteratorResult($resultAt(step, $stepArrayIteratorResultValue), $resultAt(step, $stepArrayIteratorResultDone));\x0a}\x0a" namespaceLayout=L(m1)
module m2 path="/$bun/js/engine/GeneratorPrototype.ts" displayPath="/$bun/js/engine/GeneratorPrototype.ts" flags=[IsLibrary] positions={lineStarts=[0, 25, 55, 73, 74, 169, 230, 294, 351, 404, 475, 506, 543, 549, 595, 597, 598, 626, 651, 684, 702, 703, 800, 861, 925, 982, 1035, 1108, 1139, 1176, 1182, 1228, 1230, 1231, 1258, 1283, 1319, 1337, 1338, 1438, 1499, 1563, 1620, 1673, 1749, 1780, 1817, 1823, 1869, 1871] whereThisIsMade=[25, 45]} functionText="$visibility = \x22Private\x22;\x0aexport function next(value) {\x0a    \x22use strict\x22;\x0a\x0a    const step = $stepGenerator(this, $resumeModeNext, value, $generatorStepCheckIsGenerator);\x0a    let result = $resultAt(step, $stepGeneratorResultValue);\x0a    const status = $resultAt(step, $stepGeneratorResultStatus);\x0a    let done = status === $generatorStepStatusCompleted;\x0a    if (status === $generatorStepStatusNotStepped) {\x0a        const answer = $resumeGenerator(this, $resumeModeNext, value);\x0a        result = answer.value;\x0a        done = answer.done === true;\x0a    }\x0a    return $makeIteratorResult(result, done);\x0a}\x0a\x0a$overriddenName = \x22return\x22;\x0a$visibility = \x22Private\x22;\x0aexport function return_(value) {\x0a    \x22use strict\x22;\x0a\x0a    const step = $stepGenerator(this, $resumeModeReturn, value, $generatorStepCheckIsGenerator);\x0a    let result = $resultAt(step, $stepGeneratorResultValue);\x0a    const status = $resultAt(step, $stepGeneratorResultStatus);\x0a    let done = status === $generatorStepStatusCompleted;\x0a    if (status === $generatorStepStatusNotStepped) {\x0a        const answer = $resumeGenerator(this, $resumeModeReturn, value);\x0a        result = answer.value;\x0a        done = answer.done === true;\x0a    }\x0a    return $makeIteratorResult(result, done);\x0a}\x0a\x0a$overriddenName = \x22throw\x22;\x0a$visibility = \x22Private\x22;\x0aexport function throw_(exception) {\x0a    \x22use strict\x22;\x0a\x0a    const step = $stepGenerator(this, $resumeModeThrow, exception, $generatorStepCheckIsGenerator);\x0a    let result = $resultAt(step, $stepGeneratorResultValue);\x0a    const status = $resultAt(step, $stepGeneratorResultStatus);\x0a    let done = status === $generatorStepStatusCompleted;\x0a    if (status === $generatorStepStatusNotStepped) {\x0a        const answer = $resumeGenerator(this, $resumeModeThrow, exception);\x0a        result = answer.value;\x0a        done = answer.done === true;\x0a    }\x0a    return $makeIteratorResult(result, done);\x0a}\x0a" namespaceLayout=L(m2)
module m3 path="/$bun/js/engine/JSIteratorHelperPrototype.ts" displayPath="/$bun/js/engine/JSIteratorHelperPrototype.ts" flags=[IsLibrary] positions={lineStarts=[0, 74, 99, 124, 142, 143, 177, 241, 242, 334, 438, 499, 563, 620, 673, 753, 784, 821, 827, 873, 875, 876, 904, 932, 950, 951, 985, 1049, 1050, 1140, 1192, 1302, 1367, 1435, 1496, 1553, 1639, 1674, 1715, 1725, 1775, 1781, 1782, 1845, 1953, 1990, 2041, 2090, 2092] whereThisIsMade=[99, 119]} functionText="// As in GeneratorPrototype.ts, every path makes the result in one place.\x0a$visibility = \x22Private\x22;\x0aexport function next() {\x0a    \x22use strict\x22;\x0a\x0a    if (!$isIteratorHelper(this))\x0a        $throwTypeError(\x22|this| should be an iterator helper\x22);\x0a\x0a    const generator = $getIteratorHelperInternalField(this, $iteratorHelperFieldGenerator);\x0a    const step = $stepGenerator(generator, $resumeModeNext, undefined, $generatorStepCheckIsGenerator);\x0a    let result = $resultAt(step, $stepGeneratorResultValue);\x0a    const status = $resultAt(step, $stepGeneratorResultStatus);\x0a    let done = status === $generatorStepStatusCompleted;\x0a    if (status === $generatorStepStatusNotStepped) {\x0a        const answer = $resumeGenerator(generator, $resumeModeNext, undefined);\x0a        result = answer.value;\x0a        done = answer.done === true;\x0a    }\x0a    return $makeIteratorResult(result, done);\x0a}\x0a\x0a$overriddenName = \x22return\x22;\x0aexport function return_() {\x0a    \x22use strict\x22;\x0a\x0a    if (!$isIteratorHelper(this))\x0a        $throwTypeError(\x22|this| should be an iterator helper\x22);\x0a\x0a    var generator = $getIteratorHelperInternalField(this, $iteratorHelperFieldGenerator);\x0a    if (!$isGeneratorSuspendedAtStart(generator)) {\x0a        const step = $stepGenerator(generator, $resumeModeReturn, undefined, $generatorStepCheckIsGenerator);\x0a        let result = $resultAt(step, $stepGeneratorResultValue);\x0a        const status = $resultAt(step, $stepGeneratorResultStatus);\x0a        let done = status === $generatorStepStatusCompleted;\x0a        if (status === $generatorStepStatusNotStepped) {\x0a            const answer = $resumeGenerator(generator, $resumeModeReturn, undefined);\x0a            result = answer.value;\x0a            done = answer.done === true;\x0a        }\x0a        return $makeIteratorResult(result, done);\x0a    }\x0a\x0a    $resumeGenerator(generator, $resumeModeReturn, undefined);\x0a    var underlyingIterator = $getIteratorHelperInternalField(this, $iteratorHelperFieldUnderlyingIterator);\x0a    if (underlyingIterator !== null)\x0a        $iteratorGenericClose(underlyingIterator);\x0a    return $makeIteratorResult(undefined, true);\x0a}\x0a" namespaceLayout=L(m3)
module m4 path="/$bun/js/engine/MapIteratorPrototype.ts" displayPath="/$bun/js/engine/MapIteratorPrototype.ts" flags=[IsLibrary] positions={lineStarts=[0, 25, 50, 68, 69, 100, 204, 205, 246, 373, 375] whereThisIsMade=[25, 45]} functionText="$visibility = \x22Private\x22;\x0aexport function next() {\x0a    \x22use strict\x22;\x0a\x0a    if (!$isMapIterator(this))\x0a        $throwTypeError(\x22%MapIteratorPrototype%.next requires that |this| be a Map Iterator instance\x22);\x0a\x0a    const step = $stepMapIterator(this);\x0a    return $makeIteratorResult($resultAt(step, $stepArrayIteratorResultValue), $resultAt(step, $stepArrayIteratorResultDone));\x0a}\x0a" namespaceLayout=L(m4)
