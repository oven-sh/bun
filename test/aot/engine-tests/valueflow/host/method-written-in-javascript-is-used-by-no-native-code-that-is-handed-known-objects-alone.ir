# JSON.stringify({})
# The one object that JSON.stringify is handed is a literal of the program, so nobody calls Buffer.prototype.toJSON.
# LIBRARY: own
# RUN: valueflow-why used-builtin=BufferPrototypeToJSON
# CHECK: used-builtin=BufferPrototypeToJSON
# CHECK-NEXT: not held

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Empty" fields=[]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0 fields=[]
    v1 = Builtin builtin=JSONStringify
    v2 = Call v1, -, v0
    Return
}
