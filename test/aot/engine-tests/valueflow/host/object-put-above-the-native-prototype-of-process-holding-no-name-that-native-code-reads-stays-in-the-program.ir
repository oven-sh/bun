# const above = Object.create(null); above.on = on; above.emit = emit; Object.setPrototypeOf(Object.getPrototypeOf(process), above); process.noDeprecation
# Nothing on `above` lies under a name that a lookup of native code comes to it with, so neither `above`, nor what it holds, nor `process` is in unknown hands
# LIBRARY: own
# RUN: valueflow-why escaped=f1 escaped=f2 escaped-builtin=Process escaped-builtin=EventEmitterPrototype
# CHECK: escaped=f1
# CHECK-NEXT: not held
# CHECK-NEXT: escaped=f2
# CHECK-NEXT: not held
# CHECK-NEXT: escaped-builtin=Process
# CHECK-NEXT: not held
# CHECK-NEXT: escaped-builtin=EventEmitterPrototype
# CHECK-NEXT: not held

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Object
    v1 = Builtin builtin=ObjectCreate
    v2 = Null
    v3 = Call v1, v0, v2
    v4 = NewClosure function=f1
    PropSet v3, v4 key="on" mode=Strict
    v6 = NewClosure function=f2
    PropSet v3, v6 key="emit" mode=Strict
    v8 = Builtin builtin=ObjectSetPrototypeOf
    v9 = Builtin builtin=EventEmitterPrototype
    v10 = Call v8, v0, v9, v3
    v11 = Builtin builtin=Process
    v12 = PropGet v11 key="noDeprecation"
    Return
}
function f1 name="on" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="emit" results=[{type=anything}] {
  b0():
    Return
}
