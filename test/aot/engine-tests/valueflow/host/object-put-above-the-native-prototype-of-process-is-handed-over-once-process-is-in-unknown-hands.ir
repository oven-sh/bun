# const above = Object.create(null); above.helper = helper; Object.setPrototypeOf(Object.getPrototypeOf(process), above); handedOver(process)
# Whoever holds `process` climbs to %EventEmitter%.prototype and from there to `above`, and reads whatever lies there
# LIBRARY: own
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Object
    v1 = Builtin builtin=ObjectCreate
    v2 = Null
    v3 = Call v1, v0, v2
    v4 = NewClosure function=f1
    PropSet v3, v4 key="helper" mode=Strict
    v6 = Builtin builtin=ObjectSetPrototypeOf
    v7 = Builtin builtin=EventEmitterPrototype
    v8 = Call v6, v0, v7, v3
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="handedOver" [isFreeName]
    v11 = Builtin builtin=Process
    v12 = Call v10, -, v11
    Return
}
function f1 name="helper" results=[{type=anything}] {
  b0():
    Return
}
