# const above = { get on() { return handedOver(this); } }; Object.setPrototypeOf(Object.getPrototypeOf(process), above); handedOver(Object.getPrototypeOf(process)); process.on
# %EventEmitter%.prototype is in unknown hands, and beside the unknown object the chain of `process` no longer lists it. It is an object of the realm, which a store that nobody can place leaves as the table says,
# so it still has `on` among its own members and the read ends there: it answers the native method and nothing that is found through the unknown object
# LIBRARY: own
# RUN: valueflow-why escaped-builtin=EventEmitterPrototype values=f0:v11
# CHECK: escaped-builtin=EventEmitterPrototype
# CHECK-NEXT: n0 escaped
# CHECK: result n{{*}} 2 members: primitive0 EventEmitterPrototypeOn

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Object
    v1 = NewDictionary
    v2 = NewClosure function=f1
    DefineGetter v1, v2 key="on"
    v4 = Builtin builtin=ObjectSetPrototypeOf
    v5 = Builtin builtin=EventEmitterPrototype
    v6 = Call v4, v0, v5, v1
    v7 = Builtin builtin=Process
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="handedOver" [isFreeName]
    v10 = Call v9, -, v5
    v11 = PropGet v7 key="on"
    Return v11
}
function f1 name="on" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="handedOver" [isFreeName]
    v3 = Call v2, -, v0
    Return v3
}
