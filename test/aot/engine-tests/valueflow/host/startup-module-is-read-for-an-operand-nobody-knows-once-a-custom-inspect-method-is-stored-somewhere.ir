# thrown = new Error("x"); thrown.code = {}; thrown.code[Symbol.for("nodejs.util.inspect.custom")] = custom; try { throw thrown } catch (error) { console.log(error.code) }
# Nobody knows what was caught nor what it holds. A statement has stored a function under the name of the custom inspect method, so the formatter may find it on its operand,
# and it calls it with a function of a start-up module.
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached f1
# CHECK-NOT: unreached f2
# CHECK-NOT: unreached f3

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal/util/inspect" displayPath="internal/util/inspect" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=InternalUtilInspect body=f1
entry module=m0
layout L0 name="Exports" fields=[{key="inspect" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Code"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = NewObject layout=L1
    v2 = Builtin builtin=SymbolFor
    v3 = String string="nodejs.util.inspect.custom"
    v4 = Call v2, -, v3
    ElemSet v1, v4, v0
    Jump -> next b1()
  b1() handler=b2():
    v6 = Builtin builtin=Error
    v7 = String string="x"
    v8 = Construct v6, -, v7
    PropSet v8, v1 key="code"
    Throw v8
  b2() role=CatchHandler:
    v10 = CatchValue
    v11 = PropGet v10 key="code"
    v12 = Builtin builtin=Console
    v13 = Builtin builtin=ConsoleLog
    v14 = Call v13, v12, v11
    Return
}
function f1 name="inspectModule" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="inspect" module=m1 role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="custom" flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v1
}
