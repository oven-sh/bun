# new Bun.Transpiler(input)
# The transpiler makes text of text. It would run code only for a macro, and refuses macros in an image that admits no code from outside.
# So making one lets no code in, and the realm is not changed behind the analysis. plugin-changes-the-realm.ir has code that is started with a loader in its hands
# RUN: valueflow-why flag=h19 flag=h5
# CHECK: flag=h19
# CHECK-NEXT: not held
# CHECK: flag=h5
# CHECK-NEXT: not held

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Builtin builtin=BunTranspiler
    v3 = Construct v2, -, v1
    Return
}
