# process.helper = helper; Object.getPrototypeOf(process).other = other; handedOver(process)
# Whoever holds `process` reads whatever lies on it, and climbs to the native prototype above it
# LIBRARY: own
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Process
    v1 = NewClosure function=f1
    PropSet v0, v1 key="helper" mode=Strict
    v3 = Builtin builtin=EventEmitterPrototype
    v4 = NewClosure function=f2
    PropSet v3, v4 key="other" mode=Strict
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="handedOver" [isFreeName]
    v8 = Call v7, -, v0
    Return
}
function f1 name="helper" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="other" results=[{type=anything}] {
  b0():
    Return
}
