# process.env.HOME; new Worker(globalThis.file)
# On Windows process.env is a proxy that windowsEnv makes (runtimefunction 65583). The native constructor of a Worker copies the object that its thread has: it lists the names and reads
# what is under each. So the traps that answer a listing are entered, though no code of the program or of the library lists the object. A listing stores nothing: `set` is not entered.
# LIBRARY: own
# RUN: valueflow-solve unreached
# CHECK: unreached f5
# CHECK-NOT: unreached

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
runtimefunction id=65583 function=f1
layout L0 fields=[{key="get" declared={type=anything}}, {key="getOwnPropertyDescriptor" declared={type=anything}}, {key="ownKeys" declared={type=anything}}, {key="set" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Process
    v1 = PropGet v0 key="env"
    v2 = PropGet v1 key="HOME"
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="file" [isFreeName]
    v5 = Builtin builtin=Worker
    v6 = Construct v5, -, v4
    Return
}
function f1 name="windowsEnv" role=Library enclosingRuntimeFunction=65583 parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = NewClosure function=f2
    v7 = NewClosure function=f3
    v8 = NewClosure function=f4
    v9 = NewObject layout=L0
    PropDefine v9, v6 key="get"
    PropDefine v9, v7 key="getOwnPropertyDescriptor"
    PropDefine v9, v8 key="ownKeys"
    v13 = NewClosure function=f5
    PropDefine v9, v13 key="set"
    v15 = FinishObject v9
    v16 = Builtin builtin=Proxy
    v17 = Construct v16, -, v0, v15
    Return v17
}
function f2 name="get" role=Library parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ElemGet v0, v1
    Return v2
}
function f3 name="getOwnPropertyDescriptor" role=Library parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
function f4 name="ownKeys" role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f5 name="set" role=Library parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    Return
}
