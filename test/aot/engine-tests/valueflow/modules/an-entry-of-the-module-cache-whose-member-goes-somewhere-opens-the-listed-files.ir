# sink(require.cache[path].exports)
# The twin of an-entry-of-the-module-cache-that-is-only-tested-opens-nothing.ir: what require() answers for a file that the table lists goes somewhere, so anybody may call what the file exports
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached f2

module m0 path="main.test.js" displayPath="main.test.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="listed.js" displayPath="listed.js" flags=[IsListedInCache] body=f1 exports=[{name="exported" variable=g0}]
entry module=m0
variable g0 name="exported" module=m1 declared={type=anything} initialization=Function function=f2
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ModuleCache
    v1 = Builtin builtin=DateNow
    v2 = Call v1
    v3 = ToString v2
    v4 = ElemGet v0, v3
    v5 = Undefined
    v6 = StrictEq v4, v5
    v7 = ElemGet v0, v3
    v8 = PropGet v7 key="exports"
    v9 = StrictEq v8, v5
    v10 = ToBoolean v4
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="sink" [isFreeName]
    v13 = Call v12, -, v8
    Return
}
function f1 name="listed" module=m1 kind=Module results=[{type=anything}] {
    Return
}
function f2 name="exported" module=m1 results=[{type=anything}] {
    Return
}
