# import imported from "node:module"; let Module = imported; view = {}; Object.defineProperty(view, globalThis.key, { get: () => Module[globalThis.key] }); view.createRequire("/app/main.js")(globalThis.name)
# The read of node:module under a key nobody knows does not answer createRequire. The read that names createRequire on the object with the getter does.
# The call of what createRequire returns loads code by name, and no other call does.
# OPTIONS: testing=DelayFlowRules
# RUN: valueflow-solve unseen
# CHECK: unseen LoadsCodeByName ModuleRequire f0:v17
# CHECK-NOT: unseen LoadsCodeByName
# CHECK: unseen-code yes

module m0 path="/app/main.js" displayPath="main.js" kind=SourceText body=f0 requests=[{target=m1 completes=true}]
module m1 path="node:module" displayPath="node:module" kind=Runtime exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeModule
entry module=m0
variable g0 name="Module" module=m0 declared={type=anything} initialization=Undefined
layout L0 fields=[{key="get" declared={type=anything}}]
layout L1
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=NodeModule
    PutModuleVariable v0 variable=g0
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="key" [isFreeName]
    v4 = PropGet v2 key="name" [isFreeName]
    v5 = NewObject layout=L1
    v6 = FinishObject v5
    v7 = NewClosure function=f1
    v8 = NewObject layout=L0
    PropDefine v8, v7 key="get"
    v10 = FinishObject v8
    v11 = Builtin builtin=Object
    v12 = Builtin builtin=ObjectDefineProperty
    v13 = Call v12, v11, v6, v3, v10
    v14 = PropGet v6 key="createRequire"
    v15 = String string="/app/main.js"
    v16 = Call v14, v6, v15
    v17 = Call v16, -, v4
    Return v17
}
function f1 name="get" module=m0 kind=Arrow results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="key" [isFreeName]
    v2 = GetModuleVariable variable=g0
    v3 = ElemGet v2, v1
    Return v3
}
