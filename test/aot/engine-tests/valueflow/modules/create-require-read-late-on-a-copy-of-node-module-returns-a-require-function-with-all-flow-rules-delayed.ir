# import Module from "node:module"; copy = { ...Module }; hide(copy); step0 = { next: () => copy.createRequire("/app/main.js")(globalThis.name) }; step1 = { next: () => step0.next() }; and so on
# The copy and node:module are in unknown hands long before the function that calls createRequire is reached, so the callee may be anything beside createRequire.
# The call still returns a require function, and the call of that function loads code by name.
# OPTIONS: testing=DelayFlowRules,DelayOtherFlowRules
# RUN: valueflow-solve unseen
# CHECK: unseen LoadsCodeByName ModuleRequire f1:v6
# CHECK: unseen-code yes

module m0 path="/app/main.js" displayPath="main.js" kind=SourceText body=f0 requests=[{target=m1 completes=true}]
module m1 path="node:module" displayPath="node:module" kind=Runtime exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeModule
entry module=m0
layout L0 fields=[{key="next" declared={type=anything}}]
layout L1
variable g0 name="copy" module=m0 declared={type=anything}
variable g1 name="step0" module=m0 declared={type=anything}
variable g2 name="step1" module=m0 declared={type=anything}
variable g3 name="step2" module=m0 declared={type=anything}
variable g4 name="step3" module=m0 declared={type=anything}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="hide" [isFreeName]
    v2 = Builtin builtin=NodeModule
    v3 = NewObject layout=L1
    CopyDataProperties v3, v2
    v5 = FinishObject v3
    PutModuleVariable v5 variable=g0
    v7 = Call v1, -, v5
    v8 = NewClosure function=f1
    v9 = NewObject layout=L0
    PropDefine v9, v8 key="next"
    v11 = FinishObject v9
    PutModuleVariable v11 variable=g1
    v13 = NewClosure function=f2
    v14 = NewObject layout=L0
    PropDefine v14, v13 key="next"
    v16 = FinishObject v14
    PutModuleVariable v16 variable=g2
    v18 = NewClosure function=f3
    v19 = NewObject layout=L0
    PropDefine v19, v18 key="next"
    v21 = FinishObject v19
    PutModuleVariable v21 variable=g3
    v23 = NewClosure function=f4
    v24 = NewObject layout=L0
    PropDefine v24, v23 key="next"
    v26 = FinishObject v24
    PutModuleVariable v26 variable=g4
    v28 = PropGet v26 key="next"
    v29 = Call v28, v26
    Return v29
}
function f1 name="next" module=m0 kind=Arrow results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="name" [isFreeName]
    v2 = GetModuleVariable variable=g0
    v3 = PropGet v2 key="createRequire"
    v4 = String string="/app/main.js"
    v5 = Call v3, v2, v4
    v6 = Call v5, -, v1
    Return v6
}
function f2 name="next" module=m0 kind=Arrow results=[{type=anything}] {
    v0 = GetModuleVariable variable=g1
    v1 = PropGet v0 key="next"
    v2 = Call v1, v0
    Return v2
}
function f3 name="next" module=m0 kind=Arrow results=[{type=anything}] {
    v0 = GetModuleVariable variable=g2
    v1 = PropGet v0 key="next"
    v2 = Call v1, v0
    Return v2
}
function f4 name="next" module=m0 kind=Arrow results=[{type=anything}] {
    v0 = GetModuleVariable variable=g3
    v1 = PropGet v0 key="next"
    v2 = Call v1, v0
    Return v2
}
