# require.cache[name] = module; require("./first.cjs"); require("./second.cjs")()
# No module of the image is in the module cache, and a constant name is bound to its module by the build. So an entry that the program stores into the cache answers no require with a constant name:
# the call gets what second.cjs exports and nothing else, and nothing is loaded by name
# RUN: valueflow-solve unseen
# CHECK-NOT: unseen LoadsModuleByName
# CHECK: unseen-code no
# CHECK-NEXT: modules-by-name no
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED: unreached f1
# RUN(CALLS): valueflow-solve calls
# CALLS: f0 v10 -> {{*}}f5
# CALLS-NOT: f0 v10 -> {{*}}unknown
# CALLS-NOT: f0 v10 -> {{*}}f3

variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="exports" module=m1 declared={type=anything} initialization=Undefined
variable g2 name="exports" module=m2 declared={type=anything} initialization=Undefined
variable g3 name="exports" module=m3 declared={type=anything} initialization=Undefined
module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs flags=[KeepsError] exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0 requests=[{target=m2 kind=Require completes=true}, {target=m3 kind=Require completes=true}]
module m1 path="/app/other.cjs" displayPath="other.cjs" kind=CommonJs flags=[KeepsError] exportRule=CommonJs requireResult=ModuleExports body=f1 exportsVariable=g1
module m2 path="/app/first.cjs" displayPath="first.cjs" kind=CommonJs flags=[KeepsError] exportRule=CommonJs requireResult=ModuleExports body=f2 exportsVariable=g2
module m3 path="/app/second.cjs" displayPath="second.cjs" kind=CommonJs flags=[KeepsError] exportRule=CommonJs requireResult=ModuleExports body=f4 exportsVariable=g3
entry module=m0
function f0 name="main" module=m0 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = ModuleBuiltin builtin=ModuleRequire module=m0
    v1 = ModuleBuiltin builtin=ModuleObject module=m0
    v2 = ModuleBuiltin builtin=ImportMeta module=m0
    v3 = PropGet v2 key="path"
    v4 = PropGet v0 key="cache"
    ElemSet v4, v3, v1
    EvaluateModule module=m2 referrer=m0
    v7 = GetModuleVariable variable=g2
    EvaluateModule module=m3 referrer=m0
    v9 = GetModuleVariable variable=g3
    v10 = Call v9
    Return
}
function f1 name="other" module=m1 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    Return
}
function f2 name="first" module=m2 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    PutModuleVariable v0 variable=g2
    Return
}
function f3 name="exportedByFirst" module=m2 results=[{type=anything}] {
  b0():
    Return
}
function f4 name="second" module=m3 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f5
    PutModuleVariable v0 variable=g3
    Return
}
function f5 name="exportedBySecond" module=m3 results=[{type=anything}] {
  b0():
    Return
}
