# printed[Symbol.for("nodejs.util.inspect.custom")] = custom; console.log(printed); eval(String(Date.now())); holder = { kept: function () {} }
# Evaluated text reaches the global scope and holds what the modules of the library export. A function that the program keeps in an object that nobody is handed is out of its reach:
