# A function of a module of the library is seen code once the program asks for the module: its call of the evaluator is an event
# RUN: valueflow-solve unseen
# CHECK: unseen EvaluatesText Eval f2:v2
# CHECK: unseen-code yes

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="node:readline" displayPath="node:readline" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeReadline body=f1
entry module=m0
variable g0 name="kept" module=m1 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = String string="text"
    v2 = Call v0, -, v1
    Return
}
function f1 name="readline" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    Return
}
function f2 name="evaluate" module=m1 role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=Eval
    v2 = Call v1, -, v0
    Return v2
}
