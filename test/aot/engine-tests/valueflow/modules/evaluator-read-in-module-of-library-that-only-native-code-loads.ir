# CHECK: values=f1:v1
# CHECK: result {{*}} Function
# CHECK: values=f1:v2
# CHECK: result {{*}} 1 members: FunctionPrototype
# CHECK: values=f1:v3
# CHECK: result {{*}} 1 members: FunctionPrototypeCall
# RUN(UNSEEN): valueflow-solve unseen
# UNSEEN-NOT: unseen EvaluatesText
# UNSEEN: unseen-code no
# UNSEEN-NEXT: modules-by-name no

