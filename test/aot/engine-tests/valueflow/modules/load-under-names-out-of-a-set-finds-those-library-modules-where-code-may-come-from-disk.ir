# names = new Set; names.add("readline"); for (const name of names) await import(name)      beside node:os, which another written text stands for, and plugin.mjs
# Nothing is excluded, as in a test run: a name that the build does not know may find code on disk, and so may "undefined", which could be a package there.
# The loop uses the value of a step only where the step has not found the end, so the name is "readline" and nothing else: the load evaluates node:readline alone, and no code runs that the build has not seen.
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached f1
# CHECK: unreached f2
# CHECK-NEXT: unreached f3
# RUN(UNSEEN): valueflow-solve unseen
# UNSEEN: unseen-code no

module m0 path="/app/main.mjs" displayPath="main.mjs" flags=[HasTopLevelAwait] body=f0
module m1 path="node:readline" displayPath="node:readline" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeReadline body=f1
module m2 path="node:os" displayPath="node:os" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeOs body=f2
module m3 path="/app/plugin.mjs" displayPath="plugin.mjs" flags=[IsFoundByName] body=f3
entry module=m0
function f0 name="main" module=m0 kind=Module flags=[IsAsync] results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Set
    v1 = Construct v0
    v2 = PropGet v1 key="add"
    v3 = String string="readline"
    v4 = Call v2, v1, v3 calleeKey="add"
    v5 = IteratorOpen v1
    Jump -> next b1()
  b1():
    LoopHint
    v7 = IteratorResume v5
    v8 = ResultAt v7
    v9 = ResultAt v7 index=1
    Branch v8 -> taken b3(), notTaken b2()
  b2():
    v10 = ImportDynamic v9 referrer=m0
    v11 = Await v10
    Jump -> next b1()
  b3():
    Return
}
function f1 name="readline" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    Return
}
function f2 name="os" module=m2 kind=Module role=Library results=[{type=anything}] {
  b0():
    Return
}
function f3 name="plugin" module=m3 kind=Module results=[{type=anything}] {
  b0():
