# let name; name = "readline"; import(name); require(name)   beside node:os, which another written text stands for, and plugin.mjs, which a written path finds
# The values say what the name may be: undefined or "readline". So both loads evaluate node:readline and nothing else: not the other modules of the library that answer to a name,
# and no file of the program. The run time is handed a name all the same, so the image keeps its loader.
# The build excludes code outside the image, as an executable does by default: "undefined" names a package that is not in the image.
# OPTIONS: exclude=CodeOutsideImage
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached f1
# CHECK: unreached f2
# CHECK-NEXT: unreached f3
# RUN(UNSEEN): valueflow-solve unseen
# UNSEEN: unseen LoadsModuleByName f0:v3
# UNSEEN-NEXT: unseen LoadsModuleByName f0:v4
# UNSEEN-NEXT: unseen-code no
# UNSEEN-NEXT: modules-by-name yes

variable g0 name="name" module=m0 declared={type=anything} initialization=Undefined
module m0 path="/app/main.mjs" displayPath="main.mjs" body=f0
module m1 path="node:readline" displayPath="node:readline" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeReadline body=f1
module m2 path="node:os" displayPath="node:os" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeOs body=f2
module m3 path="/app/plugin.mjs" displayPath="plugin.mjs" flags=[IsFoundByName] body=f3
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="readline"
    PutModuleVariable v0 variable=g0
    v2 = GetModuleVariable variable=g0
    v3 = ImportDynamic v2 referrer=m0
    v4 = RequireDynamic v2 referrer=m0
    v5 = PropGet v4 key="readline"
    Return
}
function f1 name="readline" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    Return
}
function f2 name="os" module=m2 kind=Module role=Library results=[{type=anything}] {
  b0():
    Return
}
function f3 name="plugin" module=m3 kind=Module results=[{type=anything}] {
  b0():
    Return
}
