# require("./other.cjs"); require.cache[name].exports.handler()
# `require.cache` is the host's map of what it has loaded from outside the image. No module of the image is in it, so whoever reads it comes to no module object and to nothing that a file exports
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached f1
# CHECK: unreached f2
# CHECK-NEXT: unreached f3
# RUN(APPLY): valueflow-apply
# APPLY: variable g1 name="exports" {{*}}flow={writers=AllKnown stores=AtMostOnce

variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="exports" module=m1 declared={type=anything} initialization=Undefined
module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs flags=[KeepsError] exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0 requests=[{target=m1 kind=Require completes=true}]
module m1 path="/app/other.cjs" displayPath="other.cjs" kind=CommonJs flags=[KeepsError] exportRule=CommonJs requireResult=ModuleExports body=f1 exportsVariable=g1
entry module=m0
function f0 name="main" module=m0 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = ModuleBuiltin builtin=ModuleRequire module=m0
    v1 = ModuleBuiltin builtin=ImportMeta module=m0
    v2 = PropGet v1 key="path"
    EvaluateModule module=m1 referrer=m0 [isBare]
    v4 = PropGet v0 key="cache"
    v5 = ElemGet v4, v2
    v6 = PropGet v5 key="exports"
    v7 = PropGet v6 key="handler"
    v8 = Call v7, v6
    v9 = NewClosure function=f3
    Return
}
function f1 name="other" module=m1 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewDictionary
    PutModuleVariable v0 variable=g1
    v2 = NewClosure function=f2
    PropSet v0, v2 key="handler" mode=Strict
    Return
}
function f2 name="handler" module=m1 results=[{type=anything}] {
  b0():
    Return
}
function f3 name="nobodyCalls" module=m0 results=[{type=anything}] {
  b0():
    Return
}
