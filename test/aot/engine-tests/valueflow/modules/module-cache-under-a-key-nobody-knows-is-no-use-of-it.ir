# require("node:module")[name]
# The key names no member, so the read is no use of the module cache, and the module objects of the program stay where they are. The function of the library that makes the cache is in the image
# only for a program that names it: whoever comes to it under such a key gets the error of a function that was not compiled. module-cache-read-by-name-is-a-use-of-it.ir names it
# RUN: valueflow-why used-builtin=NodeModule_cache
# CHECK: not held

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=DateNow
    v1 = Call v0
    v2 = ToString v1
    v3 = Builtin builtin=NodeModule
    v4 = ElemGet v3, v2
    Return
}
