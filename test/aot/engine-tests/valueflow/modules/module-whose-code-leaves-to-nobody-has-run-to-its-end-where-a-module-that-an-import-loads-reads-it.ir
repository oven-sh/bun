# main.mjs: import("./c.mjs"); require("bun:jsc").drainMicrotasks()        c.mjs: import { v } from "./p.mjs"; export var seen = v        p.mjs: export var v = 1
# The call runs the jobs that wait, at any time. The code of p.mjs calls nothing and waits for nothing, so nothing else runs between its first operation and its last: no read sees undefined
# RUN: valueflow-apply
# CHECK: variable g0 name="v" {{*}}declared={type=1} initialization=Undefined flow={writers=AllKnown {{*}}initialization=StoredBeforeEveryRead
# CHECK-LABEL: function f1 name="c"
# CHECK: : 1 = GetModuleVariable variable=g0

variable g0 name="v" module=m3 declared={type=anything} initialization=Undefined
variable g1 name="seen" module=m1 declared={type=anything} initialization=Undefined
module m0 path="/app/main.mjs" displayPath="main.mjs" flags=[KeepsError] body=f0
module m1 path="/app/c.mjs" displayPath="c.mjs" flags=[KeepsError] body=f1 requests=[{target=m3 completes=true}] exports=[{name="seen" variable=g1}]
module m2 path="bun:jsc" displayPath="bun:jsc" kind=Runtime exportRule=RuntimeModule runtimeModule=BunJsc
module m3 path="/app/p.mjs" displayPath="p.mjs" flags=[KeepsError] body=f2 exports=[{name="v" variable=g0}]
entry module=m0
function f0 name="main" module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
    v0 = ImportModule module=m1 referrer=m0
    v1 = RequireModule module=m2 referrer=m0 specifier="bun:jsc"
    v2 = PropGet v1 key="drainMicrotasks"
    v3 = Call v2, v1
    Return
}
function f1 name="c" module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    PutModuleVariable v0 variable=g1
    Return
}
function f2 name="p" module=m3 kind=Module thisType={type=anything} results=[{type=anything}] {
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    Return
}
