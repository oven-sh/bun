# main.mjs: import Outer, { Inner } from "node:events"; unknown(Outer); new Inner()        node:events: function Outer() {}  function Inner() {}  Object.assign(Outer, { Inner }); export default Outer
# name-imported-from-library-module-that-exports-a-function-is-expected-to-be-what-the-library-stored.ir, with a copy in place of the store.
# What Object.assign copies onto an object is written nowhere on it: it lies on the source. The construction expects what the library wrote there under the name.
# RUN: valueflow-apply
# CHECK-LABEL: function f3 name="main"
# CHECK: = Construct v{{*}} callees=[f2, ..]

variable g0 name="Inner" module=m0 declared={type=anything}
variable g1 name="default" module=m0 declared={type=anything}
module m0 path="node:events" displayPath="node:events" kind=RuntimeSource flags=[IsLoadedByImportOnly] exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeEvents body=f0 syntheticExports=[{name="Inner" variable=g0 isKnownMember=true}, {name="default" variable=g1 isKnownMember=true}]
module m1 path="/app/main.mjs" displayPath="main.mjs" flags=[KeepsError] body=f3 requests=[{target=m0 completes=true}]
entry module=m1
layout L0 fields=[{key="Inner" declared={type=anything}}]
function f0 module=m0 kind=Module role=Library thisType={type=anything} results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Builtin builtin=Object
    v3 = Builtin builtin=ObjectAssign
    v4 = NewObject layout=L0
    PropDefine v4, v1 key="Inner"
    v6 = FinishObject v4
    v7 = Call v3, v2, v0, v6
    Return v0
}
function f1 name="Outer" module=m0 role=Library flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    Return
}
function f2 name="Inner" module=m0 role=Library flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    Return
}
function f3 name="main" module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="unknown" [isFreeName]
    v2 = GetModuleVariable variable=g1
    v3 = Call v1, -, v2
    v4 = GetModuleVariable variable=g0
    v5 = Construct v4
    Return
}
