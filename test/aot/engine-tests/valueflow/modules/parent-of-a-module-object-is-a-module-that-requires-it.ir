# main.cjs: module.exports = exportedByMain; require("./child.cjs"); require("./sibling.cjs")        child.cjs: module.parent.exports()
# `parent` answers the module object of a module that requires the one whose module object somebody has got hold of: that of main.cjs. It may also be that of a file from outside the image,
# whose exports nobody knows: the call hands its receiver to a callee nobody knows. One flag of the program stands for all four ways, so `children` leads on from main.cjs to sibling.cjs
