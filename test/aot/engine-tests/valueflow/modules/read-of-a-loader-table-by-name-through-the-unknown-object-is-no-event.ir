# handedOver(require("node:module")); other = require("./other.cjs"); handedOver(unknown._cache); other()
# `Module` is in unknown hands, and the program reads `_cache` from an object nobody knows: a field of its own, for all that the build can tell. That is no read of Module._cache,
# so the table of the loader is handed to nobody. entry-that-the-program-puts-into-the-module-cache-answers-no-constant-name.ir has a store that the build sees
# RUN: valueflow-solve unseen
# CHECK-NOT: unseen LoadsModuleByName
# CHECK: modules-by-name no
# RUN(WHY): valueflow-why escaped-builtin=NodeModule escaped-builtin=ModuleCache used-builtin=NodeModule_cache
# WHY: escaped-builtin=NodeModule
# WHY-NEXT: n0 escaped
# WHY: escaped-builtin=ModuleCache
# WHY-NEXT: not held
# WHY-NEXT: used-builtin=NodeModule_cache
# WHY-NEXT: not held
# RUN(CALLS): valueflow-solve calls
# CALLS: f0 v8 -> f2

variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="exports" module=m1 declared={type=anything} initialization=Undefined
module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs flags=[KeepsError] exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0 requests=[{target=m1 kind=Require completes=true}]
module m1 path="/app/other.cjs" displayPath="other.cjs" kind=CommonJs flags=[KeepsError] exportRule=CommonJs requireResult=ModuleExports body=f1 exportsVariable=g1
entry module=m0
function f0 name="main" module=m0 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="handedOver" [isFreeName]
    v2 = Builtin builtin=NodeModule
    v3 = Call v1, -, v2
    EvaluateModule module=m1 referrer=m0
    v5 = GetModuleVariable variable=g1
    v6 = PropGet v3 key="_cache"
    v7 = Call v1, -, v6
    v8 = Call v5
    Return
}
function f1 name="other" module=m1 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g1
    Return
}
function f2 name="exported" module=m1 results=[{type=anything}] {
  b0():
    Return
}
