# The build excludes code outside the image, as a hardened Bun does: the run time refuses a file with code that is not in the image.
# OPTIONS: exclude=CodeOutsideImage
# RUN: valueflow-solve calls
# CHECK: f0 v3 -> {{*}}f2
# CHECK-NOT: unknown

module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0
module m1 path="node:readline" displayPath="node:readline" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeReadline body=f1
entry module=m0
layout L0 name="Exports" fields=[{key="first" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" module=m0 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="readline"
    v1 = RequireDynamic v0 referrer=m0
    v2 = PropGet v1 key="first"
    v3 = Call v2, v1
    Return
}
function f1 name="readline" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="first" module=m1 role=Library results=[{type=anything}] {
  b0():
    Return
}
