# require.cache["readline"] = entry; require(["readline"][0]).first()
# require() looks in the table for a Node.js module that is named without `node:`, and answers with what the entry exports: overridableRequire() in CommonJS.ts.
# So beside a store into the table nobody knows what a load under such a name answers, though the build knows the name and the module that it finds.
# require-of-a-node-module-named-without-its-prefix-answers-the-module.ir has no store
# The build excludes code outside the image, as a hardened Bun does: the run time refuses a file with code that is not in the image.
# OPTIONS: exclude=CodeOutsideImage
# RUN: valueflow-solve calls
# CHECK: f0 v8 -> {{*}}unknown

module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0
module m1 path="node:readline" displayPath="node:readline" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeReadline body=f1
entry module=m0
layout L0 name="Exports" fields=[{key="first" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" module=m0 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ModuleCache
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="entry" [isFreeName]
    v3 = String string="readline"
    ElemSet v0, v3, v2
    v5 = String string="readline"
    v6 = RequireDynamic v5 referrer=m0
    v7 = PropGet v6 key="first"
    v8 = Call v7, v6
    Return
}
function f1 name="readline" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="first" module=m1 role=Library results=[{type=anything}] {
  b0():
    Return
}
