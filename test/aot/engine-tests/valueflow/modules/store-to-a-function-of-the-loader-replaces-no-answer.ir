# Module._resolveFilename = resolve; require("./first.cjs"); require("./second.cjs")()
# The run time refuses whoever puts a function of its own in the place of the loader's, also where the build has seen the store. So every require with a constant name goes on answering its own module,
# and nothing is loaded by name
# RUN: valueflow-solve unseen
# CHECK-NOT: unseen LoadsModuleByName
# CHECK: unseen-code no
# CHECK-NEXT: modules-by-name no
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED: unreached f1
# RUN(CALLS): valueflow-solve calls
# CALLS: f0 v7 -> {{*}}f6
# CALLS-NOT: f0 v7 -> {{*}}unknown
# CALLS-NOT: f0 v7 -> {{*}}f4

variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
