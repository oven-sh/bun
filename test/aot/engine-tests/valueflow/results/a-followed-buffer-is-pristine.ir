# buffer = Buffer.alloc(8);  bytes = new Uint8Array(8);  handedOver = Buffer.alloc(8); keep(handedOver);  changed = Buffer.alloc(8); changed.extra = 8
# A Buffer that flow follows keeps the behavior it is made with, like the bytes beside it. One that unknown code has got hold of, or that has got a property, does not
# RUN: valueflow-apply
# CHECK: variable g0 name="buffer" {{*}}declared={type=Buffer<{{*}}pristine[Storage, Names]>}
# CHECK: variable g1 name="bytes" {{*}}declared={type=Uint8Array<{{*}}pristine[Storage, Names]>}
# CHECK: variable g2 name="handedOver" {{*}}declared={type=Buffer}
# CHECK: variable g3 name="changed" {{*}}declared={type=Buffer}
# CHECK: module m0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="buffer" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="bytes" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="handedOver" module=m0 declared={type=anything} initialization=Undefined
variable g3 name="changed" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=BufferAlloc
    v1 = Integer integer=8
    v2 = Call v0, -, v1
    PutModuleVariable v2 variable=g0
    v4 = Builtin builtin=Uint8Array
    v5 = Construct v4, -, v1
    PutModuleVariable v5 variable=g1
    v7 = Call v0, -, v1
    PutModuleVariable v7 variable=g2
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="keep" [isFreeName]
    v11 = Call v10, -, v7
    v12 = Call v0, -, v1
    PutModuleVariable v12 variable=g3
    PropSet v12, v1 key="extra" mode=Strict
    Return
}
