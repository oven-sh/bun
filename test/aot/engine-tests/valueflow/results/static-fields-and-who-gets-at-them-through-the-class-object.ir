# A static field is a variable and a property of the class object at once: whoever gets at it through the class object counts among its readers and writers.
# A delete, a freeze and a store of a value outside the type empty the variable, so nobody knows its writers. No mark says which key is deleted, so the field beside it goes too; a store names its key, so the field beside it stays.
# A store under a key nobody knows is one more store. A class object that is handed to native code, listed or read under a key nobody knows is read, and a field that is defined behind the hand-over has no proof of its initialization.
#   class Deleted { static count = 1.5; static beside = 1.5 }  delete Deleted.count
#   class Frozen { static count = 1.5 }  Object.freeze(Frozen)
#   class StoredText { static count = 1.5; static beside = 1.5 }  StoredText.count = "text"
#   class StoredByKey { static count = 1.5 }  StoredByKey[name] = 1.5
#   class Printed { static early = 1.5; static { console.log(Printed) } static late = 1.5 }
#   class Listed { static count = 1.5 }  Object.keys(Listed)
#   class Plain { static count = 1.5 }  Plain.count
#   class ReadByKey { static count = 1.5 }  ReadByKey[name]
# FORM: AsRead
# RUN: valueflow-apply
# CHECK: layout L2 {{*}}staticNamesAreComplete=true
# CHECK: layout L3
# CHECK-NOT: staticNamesAreComplete=true
# CHECK: layout L4
# CHECK: variable g0 {{*}}cause=FieldDeleted}
# CHECK-NEXT: variable g1 {{*}}cause=FieldDeleted}
# CHECK-NEXT: variable g2 {{*}}cause=PropertyRedefined}
# CHECK-NEXT: variable g3 {{*}}cause=StoreOfOtherType}
# CHECK-NEXT: variable g4 {{*}}flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead reads=NeverRead}
# CHECK-NEXT: variable g5 {{*}}flow={writers=AllKnown initialization=StoredBeforeEveryRead reads=NeverRead}
# CHECK-NEXT: variable g6 {{*}}flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead}
# CHECK-NEXT: variable g7 {{*}}flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation}
# CHECK-NEXT: variable g8 {{*}}flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead}
# CHECK-NEXT: variable g9 {{*}}flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead}
# CHECK-NEXT: variable g10 {{*}}flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Deleted" constructor=f1 staticFields=[{key="count" variable=g0}, {key="beside" variable=g1}]
layout L1 kind=Instance name="Frozen" constructor=f2 staticFields=[{key="count" variable=g2}]
layout L2 kind=Instance name="StoredText" constructor=f3 staticFields=[{key="count" variable=g3}, {key="beside" variable=g4}]
layout L3 kind=Instance name="StoredByKey" constructor=f4 staticFields=[{key="count" variable=g5}]
layout L4 kind=Instance name="Printed" constructor=f5 staticFields=[{key="early" variable=g6}, {key="late" variable=g7}]
layout L5 kind=Instance name="Listed" constructor=f6 staticFields=[{key="count" variable=g8}]
layout L6 kind=Instance name="Plain" constructor=f7 staticFields=[{key="count" variable=g9}]
layout L7 kind=Instance name="ReadByKey" constructor=f8 staticFields=[{key="count" variable=g10}]
variable g0 module=m0 declared={type=number} owner=L0
variable g1 module=m0 declared={type=number} owner=L0
variable g2 module=m0 declared={type=number} owner=L1
variable g3 module=m0 declared={type=number} owner=L2
variable g4 module=m0 declared={type=number} owner=L2
variable g5 module=m0 declared={type=number} owner=L3
