# `new Worker("./w.js"); class Point {}  const point = new Point(); new point.constructor()`: flow knows the object and what its `constructor` reads, so no place starts a Worker without naming the constructor.
# FORM: AsRead
# RUN: valueflow-results
# CHECK-NOT: worker-start-without-name

module m0 path="/$bunfs/root/main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Worker" [isFreeName]
    v2 = Convert v1 declared={type=builtin(Worker) flags=[IsExpected]}
    v3 = String string="./w.js"
    v4 = Construct v2, -, v3
    v5 = NewClosure function=f1
    v6 = Construct v5, -
    v7 = PropGet v6 key="constructor"
    v8 = Construct v7, -
    Return
}
function f1 name="Point" module=m0 flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0):
    Return
}
