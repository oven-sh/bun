# -- source: only-prototype-change-goes-through-proxy.ts
# // The only prototype change goes through a proxy.
# class Cat {
#   name = "cat";
#   speak(): string {
#     return "meow";
#   }
# }
#
# class Robot {
#   name = "robot";
#   speak(): string {
#     return "beep";
#   }
# }
#
# function facts(c: Cat): string {
#   return c.speak() + " " + (c instanceof Cat) + " " + (c instanceof Robot) + " " + c.constructor.name;
# }
#
# let warm = 0;
# for (let i = 0; i < 2000; i++) warm += facts(new Cat()).length;
# console.log("2000 honest: " + warm);
#
# const cat = new Cat();
# console.log("before: " + facts(cat));
# Reflect.setPrototypeOf(new Proxy(cat, {}), Robot.prototype);
# console.log("after: " + facts(cat));
# console.log("another cat: " + facts(new Cat()));
#
# export {};
# -- end of source
# FORM: AsRead
# RUN: pipeline FinishBirths
# RUN(WHOLE): compile
# WHOLE: image not empty

