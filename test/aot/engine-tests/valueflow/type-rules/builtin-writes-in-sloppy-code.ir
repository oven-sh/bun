# DIAGNOSTIC: LockedBuiltinWriteIsIgnored
# DIAGNOSTIC: LockedBuiltinWriteMayRun
# RUN: pipeline FinishBirths
# RUN(WHOLE): compile
# WHOLE: image not empty

