# Two factories fill what two base factories have made, by constructors that nobody can name at build time, and each base factory hands its new object through one function that counts it and returns it. What that function answers a call with is what that call gave it: the names that a factory stores are fields of the class that its own base factory makes, and not of the other class.
# -- source: fields-of-objects-handed-through-a-function-that-returns-its-argument.js
# class NodeObject {
#   constructor(kind) {
#     this.kind = kind;
#     this.flags = 0;
#   }
# }
# class IdentifierObject {
#   constructor(kind) {
#     this.kind = kind;
#     this.flags = 0;
#   }
# }
# const allocator = { getNodeConstructor: () => NodeObject, getIdentifierConstructor: () => IdentifierObject };
# // A function that nobody knows at build time gets hold of the allocator.
# id(allocator);
# let count = 0;
# function countNode(node) {
#   count++;
#   return node;
# }
# function createBaseNode(kind) {
#   return countNode(new (allocator.getNodeConstructor())(kind));
# }
# function createBaseIdentifier(kind) {
#   return countNode(new (allocator.getIdentifierConstructor())(kind));
# }
# function createBinary(left, right) {
#   const node = createBaseNode(1);
#   node.left = left;
#   node.right = right;
#   return node;
# }
# function createIdentifier(text) {
#   const node = createBaseIdentifier(2);
#   node.escapedText = text;
#   return node;
# }
# function sum(node) {
#   return node.kind === 1 ? sum(node.left) + sum(node.right) : node.escapedText.length;
# }
# const tree = createBinary(createIdentifier("ab"), createBinary(createIdentifier("c"), createIdentifier("def")));
# print(String(sum(tree)));
# print(Object.keys(tree).join());
# print(Object.keys(tree.left).join());
# print(String(count));
# -- end of source
