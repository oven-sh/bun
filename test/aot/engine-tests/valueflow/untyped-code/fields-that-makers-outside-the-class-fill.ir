# A factory has an object made by a constructor that nobody can name at build time and fills it on. The names that it stores are fields of the classes that were followed to the call, marked as filled by their makers: a read tests the slot first. In a long function that is neither hot nor small, outside loops, such a read stays a read by name.
# -- source: fields-that-makers-outside-the-class-fill.js
# class NodeObject {
#   constructor(kind) {
#     this.kind = kind;
#     this.flags = 0;
#   }
# }
# function Node(kind) {
#   this.kind = kind;
#   this.flags = 0;
# }
# const allocator = { getNodeConstructor: () => Node };
# function setAllocator(other) {
#   Object.assign(allocator, other);
# }
# setAllocator({ getNodeConstructor: () => NodeObject });
# // A function that nobody knows at build time gets hold of the allocator.
# id(allocator);
# let NodeConstructor;
# function createBaseNode(kind) {
#   return new (NodeConstructor || (NodeConstructor = allocator.getNodeConstructor()))(kind);
# }
# function createBinary(left, right) {
#   const node = createBaseNode(1);
#   node.left = left;
#   node.right = right;
#   return node;
# }
# function createLeaf(text) {
#   const node = createBaseNode(2);
#   node.text = text;
#   return node;
# }
# function sum(node) {
#   return node.kind === 1 ? sum(node.left) + sum(node.right) : node.text.length;
# }
# const tree = createBinary(createLeaf("ab"), createBinary(createLeaf("c"), createLeaf("def")));
# print(String(sum(tree)));
# print(Object.keys(tree).join());
# print(Object.keys(tree.left).join());
# print(String(tree instanceof NodeObject));
# // Long, entered who knows how often, and no loop around the read.
# function describe(node, out) {
#   out.push("kind");
#   out.push(String(node.kind));
#   out.push("flags");
#   out.push(String(node.flags));
#   out.push("a", "b", "c", "d", "e", "f", "g", "h");
#   out.push(out.length > 3 ? "long" : "short");
#   out.push(out.length > 5 ? "longer" : "shorter");
#   out.push(out.length > 7 ? "longest" : "shortest");
#   out.push(String(out.length * 2 + 1), String(out.length * 3 + 2), String(out.length * 5 + 3));
#   out.push(String(out.length % 7), String(out.length % 11), String(out.length % 13));
#   out.push(typeof node.text);
#   return out.join();
# }
# allocator.describe = describe;
# print(id(allocator).describe(tree.left, []));
# -- end of source
