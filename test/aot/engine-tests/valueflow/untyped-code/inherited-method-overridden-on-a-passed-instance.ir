# A helper overrides a method on one instance that it is passed. The class inherits the method through an `extends` clause that flow cannot prove. The class gets no late field for the name: every call of the method would have to check it first.
# -- source: inherited-method-overridden-on-a-passed-instance.js
# function Emitter() {
#   this.count = 0;
# }
# Emitter.prototype.emit = function () {
#   return ++this.count;
# };
# const library = { Emitter };
# id(library);
# class Source extends library.Emitter {
#   push() {
#     return this.emit();
#   }
# }
# function capture(emitter) {
#   emitter.emit = function () {
#     return -1;
#   };
#   emitter.captured = true;
# }
# const helpers = { capture };
# const source = new Source();
# const other = new Source();
# id(helpers).capture(other);
# print(source.push(), source.push(), other.push());
# print(Object.keys(source).join(), Object.keys(other).join());
# -- end of source
# FORM: AsRead
# RUN: pipeline FinishBirths
# RUN(FLOW): valueflow-apply
# FLOW: layout {{*}}name="Source" {{*}}fields=[{key="count" declared={type=anything} flags=[IsAddedLate, IsEnforced]}, {key="captured" declared={type=anything} flags=[IsAddedLate, IsEnforced]}] supertypes
# RUN(RUNS): run-in-shell
# RUNS: 1 2 -1
# RUNS-NEXT: count count,emit,captured

