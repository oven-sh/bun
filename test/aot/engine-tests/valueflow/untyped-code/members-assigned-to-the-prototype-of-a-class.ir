# An accessor and a method that statements behind a class declaration put on its prototype object are members of the class, marked as assigned. A helper that defines properties on whatever it is passed adds none.
# -- source: members-assigned-to-the-prototype-of-a-class.js
# class Point {
#   constructor(x) {
#     this.x = x;
#   }
# }
# Object.defineProperty(Point.prototype, "double", {
#   get() {
#     return this.x * 2;
#   },
#   configurable: true,
# });
# Point.prototype.triple = function () {
#   return this.x * 3;
# };
# class Other {
#   constructor(x) {
#     this.x = x;
#   }
# }
# function define(object, key, get) {
#   Object.defineProperty(object, key, { get, configurable: true });
# }
# const holders = [{}, Object.getPrototypeOf(new Other(0))];
# for (const holder of holders) define(holder, "half", function () { return this.x / 2; });
# const point = new Point(2);
# print(point.double, point.triple(), new Other(4).half);
# -- end of source
