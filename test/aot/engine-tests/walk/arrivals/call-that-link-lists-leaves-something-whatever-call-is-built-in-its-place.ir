# CHECK-LABEL: code f1:Body
# CHECK: = CallDirect {{*}}function=f6
# CHECK-LABEL: code f2:Body
# CHECK: = CallDirect {{*}}function=f6
# CHECK-LABEL: code f6:Body
# CHECK: b0({{*}}: undefined|int[0, 2147483647] @

