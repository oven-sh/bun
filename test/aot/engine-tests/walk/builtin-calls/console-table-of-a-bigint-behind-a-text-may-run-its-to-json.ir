# console.table prints operands of which the first is no object as console.log does: "%j" calls the toJSON that a bigint inherits, which may write what the caller reads again behind the call
# let n = 0;
# BigInt.prototype.toJSON = function () { n++; return "big"; };
# function table(v) { const a = n; console.table("%s %j", undefined, v); return a + " " + n; }
# function tableOfNumber(v) { const a = n; console.table("%s %j", undefined, v); return a + " " + n; }
# function dir(v) { const a = n; console.dir(v); return a + " " + n; }
# function timeLog(v) { const a = n; console.timeLog("%j", "%j", v); return a + " " + n; }
# console.log(table(1n), tableOfNumber(2), dir(3n), timeLog(4n), n);
