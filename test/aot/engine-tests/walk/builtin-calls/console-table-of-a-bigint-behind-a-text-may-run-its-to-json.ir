# no other primitive is asked for a toJSON
# RUN(NUMBER): walk f2 mechanisms=all
# NUMBER-LABEL: code f2:Body
# NUMBER: = GetModuleVariable variable=g0
# NUMBER: = CallBuiltin {{*}}overload=ConsoleTable/0
# NUMBER-NOT: GetModuleVariable
# console.dir prints its first operand alone, and console.timeLog each operand by itself: neither reads a text for directives
# RUN(DIR): walk f3 mechanisms=all
# DIR-LABEL: code f3:Body
# DIR: = CallBuiltin {{*}}overload=ConsoleDir/0
# DIR-NOT: GetModuleVariable
# RUN(TIMELOG): walk f4 mechanisms=all
# TIMELOG-LABEL: code f4:Body
# TIMELOG: = CallBuiltin {{*}}overload=ConsoleTimeLog/0
# TIMELOG-NOT: GetModuleVariable

