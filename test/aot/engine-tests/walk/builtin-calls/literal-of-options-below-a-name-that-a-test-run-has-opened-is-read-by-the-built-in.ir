# CHECK-LABEL: code f1:Body
# CHECK: = NewObject
# CHECK-NOT: CompilerHelpersNewResponseFromParts
# RUN(OWN): walk f2 mechanisms=all
# OWN-LABEL: code f2:Body
# OWN-NOT: NewObject
# OWN: = CallBuiltin -, v0, v1, v2, v3 overload=CompilerHelpersNewResponseFromParts

