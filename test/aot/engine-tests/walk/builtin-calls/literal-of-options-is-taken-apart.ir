# The row of a built-in may name a function that takes the members of a literal one by one. Where the literal is fresh and holds no other name, its values are handed to that function, undefined for a name that it lacks,
# and the literal is never made. function taken(body, status, headers) { return new Response(body, { status, headers }); }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: [[lacking]]: undefined{{*}} = Undefined
# CHECK-NOT: NewObject
# CHECK: = CallBuiltin -, v0, v1, [[lacking]], v2 overload=CompilerHelpersNewResponseFromParts
# The operands go by the names, not by the order of the literal: function turned(body, status, statusText, headers) { return new Response(body, { headers, statusText, status }); }
# RUN(TURNED): walk f2 mechanisms=all
# TURNED-LABEL: code f2:Body
# TURNED-NOT: NewObject
# TURNED: = CallBuiltin -, v0, v1, v2, v3 overload=CompilerHelpersNewResponseFromParts
# Native code asks for `method` too, and the function takes none: function other(body, status, method) { return new Response(body, { status, method }); }
# RUN(OTHER): walk f4 mechanisms=all
# OTHER-LABEL: code f4:Body
# OTHER: = NewObject
# OTHER-NOT: CompilerHelpersNewResponseFromParts
# OTHER: = CallBuiltin {{*}}overload=Response/
# Somebody else holds the literal, and may change it while the headers are read: function left(body, status) { const init = { status }; sink(init); return new Response(body, init); }
# RUN(LEFT): walk f5 mechanisms=all
# LEFT-LABEL: code f5:Body
# LEFT: = NewObject
# LEFT-NOT: CompilerHelpersNewResponseFromParts
# LEFT: = CallBuiltin {{*}}overload=Response/
# function third(body, status, more) { return new Response(body, { status }, more); }
# RUN(THIRD): walk f6 mechanisms=all
# THIRD-LABEL: code f6:Body
# THIRD: = NewObject
# THIRD-NOT: CompilerHelpersNewResponseFromParts
# What the literal lacks is looked for above it: function below(body, status, above) { return new Response(body, { __proto__: above, status }); }
# RUN(BELOW): walk f7 mechanisms=all
# BELOW-LABEL: code f7:Body
# BELOW: = NewObject
# BELOW-NOT: CompilerHelpersNewResponseFromParts
# The same, where the allocation itself takes the object above.
# RUN(ALLOCATED): walk f3 mechanisms=all
# ALLOCATED-LABEL: code f3:Body
# ALLOCATED: = NewObject
# ALLOCATED-NOT: CompilerHelpersNewResponseFromParts
# function getter(body) { return new Response(body, { get status() { return 201; } }); }
# RUN(GETTER): walk f8 mechanisms=all
# GETTER-LABEL: code f8:Body
# GETTER: = NewObject
# GETTER-NOT: CompilerHelpersNewResponseFromParts
# Another function is new.target: function lower(body, status, target) { return Reflect.construct(Response, [body, { status }], target); } as the engine's own operation
# RUN(LOWER): walk f9 mechanisms=all
# LOWER-LABEL: code f9:Body
# LOWER: = NewObject
# LOWER-NOT: CompilerHelpersNewResponseFromParts
# Without the state of fresh objects nobody knows what the literal holds.
# RUN(WITHHELD): walk f1 mechanisms=all-EscapeAnalysis
# WITHHELD-LABEL: code f1:Body
# WITHHELD: = NewObject
# WITHHELD-NOT: CompilerHelpersNewResponseFromParts
# RUN(CLOSED): walk f1 mechanisms=all-BuiltinCalls
# CLOSED-LABEL: code f1:Body
# CLOSED: = NewObject
# CLOSED-NOT: CompilerHelpersNewResponseFromParts

