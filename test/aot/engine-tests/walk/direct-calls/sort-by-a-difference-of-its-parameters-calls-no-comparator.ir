# function upward(a, b) { const list = [a, b]; return list.sort((x, y) => x - y); }   downward: (x, y) => y - x   neither: (x, y) => x - x   sink(upward, downward, neither);
# On numbers nobody sees such a comparator run. The library has two functions that sort a short list of numbers where it lies without one call, and hand every other list to sort(): they take the list and the comparator.
# A comparator that is anything else goes to sort() itself.
# The library here is a stand-in.
# LIBRARY: own
# RUN: walk f1 mechanisms=all-Inlining
# CHECK-LABEL: code f1:Body
# CHECK: = CallDirect {{*}}function=f5
# RUN(DOWNWARD): walk f2 mechanisms=all-Inlining
# DOWNWARD-LABEL: code f2:Body
# DOWNWARD: = CallDirect {{*}}function=f6
# RUN(NEITHER): walk f3 mechanisms=all-Inlining
# NEITHER-LABEL: code f3:Body
# NEITHER: = CallDirect {{*}}function=f4

