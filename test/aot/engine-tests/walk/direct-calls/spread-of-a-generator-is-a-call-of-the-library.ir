  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f2
    v3 = NewClosure function=f3
    v4 = Call v1, -, v2, v3
    Return v4
}
function f1 name="count" module=m0 flags=[IsGenerator, HasThis, TakesCallee, IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: function, v2: number):
    Jump -> next b1()
  b1():
    InitialYield v2
    v4 = Yield v2, v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Switch v6 cases=[1, 2] -> case b2(), case b3(), otherwise b4()
  b2():
    Throw v5
  b3():
    Return v5
  b4():
    v7 = Undefined
    Return v7
}
