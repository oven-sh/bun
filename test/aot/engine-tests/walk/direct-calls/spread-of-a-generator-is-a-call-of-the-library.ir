# the operation of the run time that a spread is steps from native code, so each step of a generator would enter compiled code anew. Where a generator is proven of what is spread, a function of the library steps it, in compiled code from the first step to the last.
# It is entered with a generator that is as it was made: nothing in it can fail but the body. Whatever was changed goes to the operation, which words what it throws as a spread does.
# No operation of the body names the function. The summary lays down a call of the built-in that passes nothing, so Link enters its code for anybody.
# function* count(n: number) { yield n; }
# function all() { return [...count(3)]; }   function allOf(things: unknown) { return [...things]; }
# RUN: walk f2 mechanisms=all-Inlining
# CHECK-LABEL: code f2:Body
# CHECK: [[generator]]: coroutine(f1) {{*}} = CallDirect {{*}}function=f1
# CHECK: = IsUnmodifiedGenerator [[generator]]
# CHECK: = CallDirect {{*}}[[generator]]{{*}}function=f4
# RUN(CHANGED): walk f2 mechanisms=all-Inlining
# CHANGED: = AppendIterable
# of which nothing is proven: the operation lists what it can in one piece
# RUN(ANYTHING): walk f3 mechanisms=all-Inlining
# ANYTHING-LABEL: code f3:Body
# ANYTHING: = AppendIterable
# RUN(NEVER): walk f3 mechanisms=all-Inlining
# NEVER-NOT: function=f4
# NEVER-NOT: IsUnmodifiedGenerator
# RUN(WITHHELD): walk f2 mechanisms=none
# WITHHELD-NOT: function=f4
# RUN(LINK): link functions mechanisms=all
# LINK: function f4
# LINK: referrers anybody

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/prelude/iterator-consumers.ts" displayPath="/$bun/js/prelude/iterator-consumers.ts" flags=[IsLibrary]
entry module=m0
variable g0 name="count" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
runtimefunction id=IteratorConsumersAppendGenerator function=f4
