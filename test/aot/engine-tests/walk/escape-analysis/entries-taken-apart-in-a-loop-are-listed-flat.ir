# `for (const [key, value] of Object.entries(o))`: the loop alone takes the list, and a pattern of two takes each pair apart at once. Nobody gets hold of the list or of a pair, so neither is made:
# the compiler's own helper lists each key with its value behind it, once, where the call stands, and a turn reads two elements. Where the program keeps a pair the call stays what is written
# function listed(o) { let s = ""; for (const [key, value] of Object.entries(o)) s += key + value; return s; }
# function kept(o) { const pairs = []; for (const pair of Object.entries(o)) pairs.push(pair); return pairs; }
# globalThis.held = [listed, kept];
# console.log(listed({ a: 1 }), kept({ b: 2 }).length);
