with.\x0a  if (next === $generatorProtoNext) {\x0a    for (;;) {\x0a      const step = $stepGenerator(iterator, $resumeModeNext, undefined, $generatorStepCheckIsGenerator);\x0a      const value = $resultAt(step, $stepGeneratorResultValue);\x0a      const status = $resultAt(step, $stepGeneratorResultStatus);\x0a      // It is running, has ended, or is no generator: the method answers.\x0a      if (status === $generatorStepStatusNotStepped) break;\x0a      if (status === $generatorStepStatusCompleted) return;\x0a      $arrayPush(target, value);\x0a    }\x0a  }\x0a  for (;;) {\x0a    const item = $call(next, iterator);\x0a    if (!$isObject(item)) $throwTypeError(\x22Iterator result interface is not an object\x22);\x0a    if ((item).done) return;\x0a    $arrayPush(target, (item).value);\x0a  }\x0a}\x0a\x0a// `const [a, b] = items` of an object of the program's own. The run time would call `next` and `return` from native code, entering compiled code anew for each.\x0a// It does what the language says of a pattern of `count` places, in that order: it steps that often, and closes what is not done. `count` is not 0. No code of the program sees the list that it hands back.\x0a// THREE ERRORS QUOTE THE PATTERN, and a function of the library has no pattern to quote: so it throws none of them. It hands back a list that begins with the mark of a closed iterator, which no program ever holds,\x0a// and the run time throws from where the pattern stands: the mark alone: there is no method to call . the mark and a value: `next` or `return`, which is no function.\x0a$visibility = \x22Private\x22;\x0aexport function takeFromIterable(items, count) {\x0a  const iterator = openIterator(items);\x0a  if (iterator === undefined) return [$collectionIteratorClosedMark()];\x0a  const next = (iterator).next;\x0a  if (!$isCallable(next)) return [$collectionIteratorClosedMark(), next];\x0a  const taken = [];\x0a  for (let index = 0; index < count; index++) {\x0a    const value = stepIterator(iter