  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    PropSet v1, v0 key="setTimeout" mode=Sloppy [isFreeName]
    v3 = Undefined
    Return v3
}
function f4 name="waited" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="setTimeout" [isFreeName]
    v3 = Convert v2 declared={type=builtin(SetTimeout) flags=[IsExpected]}
    v4 = Integer integer=1
    v5 = Call v3, -, v0, v4 calleeName="setTimeout"
