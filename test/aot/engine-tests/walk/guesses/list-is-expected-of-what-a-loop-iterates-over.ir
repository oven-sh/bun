# nobody says what `table[key]` is: nothing is written, and Link holds nothing of it. By the protocol each step of a list makes an object, and the open makes the iterator. Most of what programs iterate over is a list,
# so a list is expected: one test in front of the loop, whose turns read a list as lists are made by index. Whatever else comes goes by the protocol
# function joined(table, key) { let s = ""; for (const v of table[key]) s += v; return s; }
# globalThis.kept = joined;
# console.log(joined(JSON.parse('{"a":[1,2]}'), "a"));
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: [[iterable]]: {{*}} = ElemGet
# CHECK: = TypeTest [[iterable]] testedType=Array
# CHECK: = IsPristine {{*}}builtinClass=Array
# CHECK: = PropGet {{*}}key=@@iterator
# CHECK: = PropGet {{*}}key="next"
# CHECK: isLoopHead=true
# CHECK: = GetArrayElement
# Without guesses: the protocol alone.
# RUN(CLOSED): walk f1 mechanisms=all-Guesses
# CLOSED-LABEL: code f1:Body
# CLOSED-NOT: IsPristine
# CLOSED: = PropGet {{*}}key="next"
# CLOSED-NOT: GetArrayElement

