# a loop of which nothing is known goes by the protocol: it reads `next` once and calls it for each step. Where that is the engine's own of a generator or of a Map's, a Set's or a list's iterator,
# the call would enter native code and make an object of what it hands out, which this code alone would get. A function of the library steps such an iterator without either.
# the test asks the function itself, once: in front of the loop where `next` lies in a parameter, and at the open, which lays its answer down as a fourth word, where the state lies in memory.
# whatever else `next` is, the step is written out as ever: a call of the library for each step would cost a loop over an iterator of the program's own.
# over an object of the program's own nothing is laid and nothing is asked but what was always asked.
# function each(things) { for (const thing of things) { if (keep(thing)) break; } }
# function eachOfOwn() { for (const thing of { v: 1 }) { if (keep(thing)) break; } }
# function eachOfDeclared(things: { v: number }) { for (const thing of things) { if (keep(thing)) break; } }     declared, and proven by nobody: no list is expected, so the protocol alone opens the iteration
# no step of such a loop follows the last one, and no close finds it done: so the iterator and `next` are values, and no cell is made for them.
# eachClosedBehind: the same, closed once more behind the loop: that close may find the iteration done, so the state lies in memory.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: [[next]]: {{*}} = PropGet {{*}}key="next"
# CHECK: = TypeTest {{*}}testedType=builtin(ArrayIteratorPrototypeNext)|builtin(CompilerHelpersNextOfStepsOverText)|builtin(GeneratorPrototypeNext)|builtin(MapIteratorPrototypeNext)|builtin(SetIteratorPrototypeNext)
# CHECK: [[handedOut]]: {{*}} = CallDirect {{*}}function=f3
# CHECK: = IsCollectionIteratorClosedMark [[handedOut]]
# RUN(WRITTEN): walk f1 mechanisms=all
# WRITTEN: key="done"
# WRITTEN: key="value"
# the protocol alone, in values
# RUN(VALUES): walk f7 mechanisms=all
# VALUES: = TypeTest {{*}}testedType=builtin(ArrayIteratorPrototypeNext)
# VALUES: = CallDirect {{*}}function=f3
# RUN(NOCELL): walk f7 mechanisms=all
# NOCELL-NOT: NewHeapWords
# the state in memory
# RUN(MEMORY): walk f8 mechanisms=all
# MEMORY: [[state]]: {{*}} = NewHeapWords numberOfWords=4
# MEMORY: [[verdict]]: {{*}} = TypeTest {{*}}testedType=builtin(ArrayIteratorPrototypeNext)|builtin(CompilerHelpersNextOfStepsOverText)|builtin(GeneratorPrototypeNext)|builtin(MapIteratorPrototypeNext)|builtin(SetIteratorPrototypeNext)
# MEMORY: = PutHeapFrameWord [[state]], {{*}}index=3
# MEMORY: = GetHeapFrameWord [[state]] index=3
# MEMORY: = CallDirect {{*}}function=f3
# RUN(ONCE): walk f8 mechanisms=all
# ONCE-COUNT-1: testedType=builtin(ArrayIteratorPrototypeNext)
# ONCE-NOT: testedType=builtin(ArrayIteratorPrototypeNext)
# an object of the program's own
# RUN(OWN): walk f6 mechanisms=all
# OWN: [[next]]: {{*}} = PropGet [[iterator]] key="next"
# OWN: = Call [[next]], [[iterator]]
# RUN(NOTHING): walk f6 mechanisms=all
# NOTHING-NOT: NewHeapWords
# NOTHING-NOT: function=f3
# NOTHING-NOT: builtin(MapIteratorPrototypeNext)
# RUN(WITHHELD): walk f1 mechanisms=none+DirectCalls
# WITHHELD-NOT: function=f3
# WITHHELD-NOT: numberOfWords=4

