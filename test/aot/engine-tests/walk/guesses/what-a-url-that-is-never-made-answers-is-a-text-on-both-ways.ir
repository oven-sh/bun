# a URL that is asked two questions is never made: each is answered out of the text on the common way and off the object on the rare one. Both getters give a text, so what meets behind the two ways is a text, and a method of it is found at the build.
# function partsOf(text) { if (typeof text === "string") { const url = new URL(text); return [url.pathname.split("/"), url.search]; } }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = PropGet {{*}}key="pathname"
# CHECK-NEXT: = TypeTest {{*}}testedType=string
# CHECK-NOT: key="split"
# CHECK: Array<string> {{*}}= CallInline {{*}}inlineBuiltin=StringSplit
# CHECK: = PropGet {{*}}key="search"
# CHECK-NEXT: = TypeTest {{*}}testedType=string

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="partsOf" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=string
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = Builtin builtin=URL
    v4 = Construct v3, -, v2 calleeName="URL"
    v5 = PropGet v4 key="pathname"
    v6 = PropGet v5 key="split"
    v7 = String string="/"
    v8 = Call v6, v5, v7 calleeKey="split"
    v9 = PropGet v4 key="search"
    v10 = NewArray v8, v9 contents=anything
    Return v10
  b2():
    v11 = Undefined
    Return v11
}
