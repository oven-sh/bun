# The head of a typed build may go by a word that was read out of a variable of the module in front of the loop only while the state holds the note that the variable is as it was there; whatever may write the variable ends the note.
# THE LIE, testing=VariablesThatBoundAreTakenToBeAsInFront: the head does not ask the note. Here an arm in the turn may run a getter that writes the bound, and behind `seen++` that arm stands in the typed build and comes round:
# the loop would run to a stale bound in silence: plain Bun prints 2 3 2.5, that build 6 12 2.5, exit 0, and no other net saw it. Where the loop is closed, a head that has gone by such a word while its turns may run other code,
# or write what the word rests on, stops the build by name. As users build, the try is put back and the loop claims nothing.
# class Box { constructor(public v: number) {} }
# let bound = 0, seen = 0, target = 0;
# const trap: any = {};
# Object.defineProperty(trap, "v", { get() { bound = target; return 1; } });
# function run(boxes: Box[]) { const k = boxes[0]; let hits = 0; for (let i = 0; i < bound; i++) { seen++; if (boxes[i & 3].v === k.v) hits++; } return hits; }
# const boxes: Box[] = [new Box(1), new Box(2), trap, new Box(3)];
# bound = 12; target = 2.5;
# console.log(run(boxes), seen, bound);
# DIAGNOSTIC: WordInFrontOfTypedBuildIsStale
# RUN: walk f1 mechanisms=all testing=VariablesThatBoundAreTakenToBeAsInFront

