# The bound of the counter is a `const` of the module. An arm in the turn may run other code (a getter), and behind `seen++` that arm stands in the typed build and comes round. Whatever it runs, it cannot write a variable that
# stays as it was filled: the note that the variable is as it was in front of the loop rests on nothing, so the head goes by the word from in front and the counter is an int32. A `let` in its place is read again in every turn.
# class Box { constructor(public v: number) {} }
# const N = Number(process.argv[2] ?? "12"); let seen = 0; const trap: any = {};
# Object.defineProperty(trap, "v", { get() { seen += 100; return 1; } });
# function run(boxes: Box[]) { const k = boxes[0]; let hits = 0; for (let i = 0; i < N; i++) { seen++; if (boxes[i & 3].v === k.v) hits++; } return hits; }
# console.log(run([new Box(1), new Box(2), process.argv[3] ? new Box(1) : trap, new Box(3)]), seen);
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: @Int32) isInLoop=true isLoopHead=true:
# CHECK-NEXT: = LoopHint
# CHECK-NEXT: = Less {{*}} form=Integers
# CHECK: = PropGet {{*}} key="v"

