# The bound of the counter is a variable of the module, and in front of the loop the state already knows what it holds: the constant 12, stored two lines above. There is nothing to ask and nothing to round: the finder gives
# nothing. It gave the variable: the loop was bought for its bound alone and could then ask no bound: a walk in vain as users build, and where code is verified and guesses fail unasked the walk of the function failed by name.
# What shows here is the walk in vain: the blocks that it built and that were dropped.
# let bound = 0;
# function run(n: number): number { if (n > 100) bound = n / 3; bound = 12; let s = 0; for (let i = 0; i < bound; i++) s += i & 7; return s; }
# console.log(run(Number(process.argv[2] ?? "7")), bound);
