# `i % N`, and N is a variable of the module that the loop's function reads in the turn; no turn writes it. It counts as made in front of the loop: there it is read once and asked for an int32 of at least 1,
# and what the test proves is what is known of the variable in the copy behind it: the remainder, the relation and the step are made on integers. Whatever else the variable holds, its dead zone too, takes the other copy.
# const N = Number(process.argv[2]);
# function sum() { let s = 0; for (let i = 0; i < N; i++) s = (s + i % N) | 0; return s; }
# (globalThis as any).kept = sum;
# console.log(sum());
