# The divisor is a `const` of the module, and every turn calls a function that nobody knows. The call cannot write a variable that stays as it was filled: it is asked once in front of the loop for an int32 of at least one,
# and what was shown is noted as the value of a binding that stays, so that the state hands it out in every turn behind the call: the remainder of the typed build is made in integers.
# const D = Number(process.argv[2] ?? "5"); let told = 0;
# const tell = [(x: number) => { told += x; }][JSON.parse("0")];
# function loud(n: number) { let s = 0; for (let i = 0; i < n; i++) { s = (s + i % D) | 0; tell(i % D); } return s; }
# console.log(loud(12), told);
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = RemainderByReciprocal 

