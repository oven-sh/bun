# CHECK-NEXT: Branch [[test]] ->
# CHECK: frequency=Rare isLoopHead=true
# CHECK: = Mod {{*}}form=Numbers
# CHECK: isInLoop=true isLoopHead=true
# CHECK: int[0, 999] @Int32 = RemainderByReciprocal 
# CHECK: @Int64 = Add {{*}}form=Integers

