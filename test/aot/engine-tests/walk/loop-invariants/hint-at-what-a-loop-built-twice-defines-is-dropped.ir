# `text = null` on the way out of the loop leaves a hint that the old text is let go. No value is live for the sake of a hint, so no edge out of the two copies brings the block a name for the text:
# whatever the walk last bound it to stands on another way out. The hint is not built
# class Box { x: number; constructor(x: number) { this.x = x; } }
# function released(o: Box, n: number) { let text: string | null = "a"; let i = 0; while (text !== null) { if (i >= n) break; if (o.x === i) { text = null; break; } text = text + "b"; i++; } return String(text) + i; }
# (globalThis as any).kept = released;
# console.log(released(new Box(2), 5));
# The guard at the entry is withheld: with it the parameters are proven in the whole body, and the loop has nothing to test.
# RUN: walk f1 mechanisms=all-ParameterGuards
# CHECK-LABEL: code f1:Body
# CHECK: frequency=Rare isLoopHead=true
# CHECK: isInLoop=true isLoopHead=true
# RUN(HINT): walk f1 mechanisms=all-ParameterGuards
# HINT-NOT: ReleaseHint
# The loop built once: the hint names the parameter of the head.
# RUN(ONCE): walk f1 mechanisms=all-ParameterGuards-LoopInvariants
# ONCE-LABEL: code f1:Body
# ONCE: ([[text]]: {{*}}) isInLoop=true isLoopHead=true
# ONCE: = ReleaseHint [[text]]

