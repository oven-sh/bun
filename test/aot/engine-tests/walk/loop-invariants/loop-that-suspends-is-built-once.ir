# a loop that may suspend is built once, and nothing stands in front of it: each turn tests the shape where the read stands
# class Box { x: number; constructor(x: number) { this.x = x; } }
# async function sum(o: Box, n: number) { let s = 0; for (let i = 0; i < n; i++) { s = (s + o.x) | 0; await null; } return s; }
# (globalThis as any).kept = sum;
# console.log(await sum(new Box(2), 5));
# RUN: walk f1:CoroutineBody mechanisms=all
# CHECK-LABEL: code f1:CoroutineBody
# CHECK-NOT: ShapeTest
# CHECK: isInLoop=true isLoopHead=true
# CHECK: = ShapeTest {{*}}L0
# RUN(ONCE): walk f1:CoroutineBody mechanisms=all
# ONCE-NOT: frequency=Rare isLoopHead=true

