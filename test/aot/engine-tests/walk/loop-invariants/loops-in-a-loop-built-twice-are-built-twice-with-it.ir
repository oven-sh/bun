# the tests stand in front of the outermost loop that does not change the values. The closed copy holds the loop inside once and opens no guess. In the copy behind the tests everything is proven,
# so the read stands in front of both loops. There the loop inside stands a second time, for a field that holds an integer
# class Box { x: number; constructor(x: number) { this.x = x; } }
# function sum(o: Box, n: number) { let s = 0; for (let i = 0; i < n; i++) { for (let j = 0; j < n; j++) s = (s + o.x) | 0; } return s; }
# (globalThis as any).kept = sum;
# console.log(sum(new Box(2), 5));
# The guard at the entry is withheld: with it the parameters are proven in the whole body, and the loop has nothing to test.
# RUN: walk f1 mechanisms=all-ParameterGuards
# CHECK-LABEL: code f1:Body
# CHECK: = ShapeTest {{*}}L0
# CHECK: frequency=Rare isLoopHead=true
# CHECK: frequency=Rare isLoopHead=true
# CHECK: = PropGet {{*}}key="x"
# CHECK: = GetSlot {{*}}key="x"
# CHECK: isInLoop=true isLoopHead=true
# CHECK: isInLoop=true isLoopHead=true
# CHECK: isInLoop=true isLoopHead=true
# CHECK-NOT: isLoopHead=true
# RUN(TESTS): walk f1 mechanisms=all-ParameterGuards
# TESTS: = ShapeTest
# TESTS-NOT: = ShapeTest

