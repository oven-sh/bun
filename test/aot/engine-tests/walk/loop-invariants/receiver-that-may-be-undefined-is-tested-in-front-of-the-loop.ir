# the guard at the entry lets undefined and null pass where the written type holds references, so in the fast version each access has the check that traps in front of it. The check may throw, so it stays in the loop,
# and the read that hangs on it stays with it. The shape is tested once in front of the loop, which is built twice: behind the test there is no check, and the read stands in front of the head.
# Where the test fails the value is undefined or null, and the other copy throws in the turn that comes to the access, or has no turn
# class Box { x: number; constructor(x: number) { this.x = x; } }
# function sum(o: Box | null | undefined, n: number) { let s = 0; for (let i = 0; i < n; i++) s = (s + o.x) | 0; return s; }
# (globalThis as any).kept = sum;
# console.log(sum(new Box(2), 5));
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: [[test]]: boolean @Boolean = ShapeTest {{*}}L0
# CHECK-NEXT: Branch [[test]] ->
# CHECK: frequency=Rare isLoopHead=true
# CHECK: = RequireObjectCoercible
# CHECK: = GetSlot {{*}}key="x"
# CHECK: = GetSlot {{*}}key="x"
# CHECK: isInLoop=true isLoopHead=true
# CHECK-NOT: RequireObjectCoercible
# CHECK-NOT: GetSlot
# With loop invariants withheld each turn checks and reads.
# RUN(ONCE): walk f1 mechanisms=all-LoopInvariants
# ONCE-LABEL: code f1:Body
# ONCE-NOT: ShapeTest
# ONCE: isInLoop=true isLoopHead=true
# ONCE: = RequireObjectCoercible
# ONCE: = GetSlot {{*}}key="x"

