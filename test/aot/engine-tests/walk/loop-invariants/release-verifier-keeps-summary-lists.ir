# "use strict"; let reader; let seen = ""; function go(turns) { let sum = 0; for (let outer = 0; outer < turns; outer++) for (let turn = 0; turn < turns; turn++) { sum += reader(turn); } return sum; }
# try { seen += String(go(Number("0"))); } catch (error) { seen += error.name; } const held = { width: Number("5") }; function read(turn) { return held.width + turn; } reader = read;
# try { seen += String(go(Number("3"))); } catch (error) { seen += error.name; } module.exports = seen;
# The walk hoists the read of `reader` into the preheader of the two loops. The code verifier accepts that read only after it checks summary lists.
# A build that does not verify code frees those lists after Link. These three commands always run the verifier, so they request the lists before the program is prepared.
# Without that request, a release testaot dereferenced a freed list here and crashed.
# AS-USERS-BUILD: only a build without checks frees the summary lists
