# The reciprocal is carried in front of a loop only where the remainder runs in every turn. Here it stands in an arm: the division stays, and the reciprocal that was tried in the turn is in nobody's way: the sweep drops it.
# function inAnArm(d: number) { let s = 0; for (let j = 0; j < 1000; j++) { if (j & 1) s = (s + j % d) | 0; } return s; }
# console.log(inAnArm(Number(process.argv[2] ?? "5")));
