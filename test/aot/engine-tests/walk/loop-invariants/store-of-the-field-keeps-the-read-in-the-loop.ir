# a turn stores into the field, so each turn reads it
# class Box { x: number; constructor(x: number) { this.x = x; } }
# function sum(o: Box, n: number) { let s = 0; for (let i = 0; i < n; i++) { s = (s + o.x) | 0; o.x = s; } return s; }
# console.log(sum(new Box(2), 5));
