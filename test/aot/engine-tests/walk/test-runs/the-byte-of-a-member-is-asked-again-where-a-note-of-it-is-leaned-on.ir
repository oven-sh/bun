# function lay() { let work = 0; for (let k = 0; k < 2; k++) work = (work + k) | 0; Math.floor = other; }
# function twice(count) { let said = 0; for (let at = 0; at < count; at++) { const first = Math.floor(at / 3); if (at === 5) lay(); const second = Math.floor(at / 3); said += first + second; } return said; }
# In a test run a test may replace Math.floor. The byte of the member is asked at the head of a turn, and the walk notes that it has passed: the second use in the turn is answered out of the note
# on the way on which nothing was written. The note is the walk's own book-keeping: if it outlived a write, the second use would call what the test has replaced, and nothing would say so.
# A build that checks proofs asks the byte again at each place where the note is leaned on, where it stands, and stops by name if the byte says otherwise.
# OPTIONS: admit=ReplacedBuiltins testing=CheckProofsAtRunTime
# RUN: walk f3 mechanisms=all
# CHECK-LABEL: code f3:Body
# The plain copy of the loop asks in every turn, at each use, and leans on the answer at once. The typed copy holds the call of lay(): it asks in the front through which a turn that ran other code comes round, and once more behind the call.
# CHECK: isInLoop=true isLoopHead=true
# CHECK: isInLoop=true isLoopHead=true
# CHECK: isInLoop=true isLoopHead=true
# CHECK-NEXT: = IsMemberAsBuilt builtin=MathFloor
# CHECK-NEXT: Branch
# CHECK: [[first]]: boolean @Boolean = IsMemberAsBuilt builtin=MathFloor
# CHECK-NEXT: CheckProof [[first]] checkedType=true {{*}}source=WhatIsRemembered
# CHECK: = CallDirect function=f1
# CHECK: = IsMemberAsBuilt builtin=MathFloor
# CHECK-NEXT: Branch
# CHECK: [[behind]]: boolean @Boolean = IsMemberAsBuilt builtin=MathFloor
# CHECK-NEXT: CheckProof [[behind]] checkedType=true {{*}}source=WhatIsRemembered
# On the way on which nothing was written the second use is answered out of the note.
# CHECK: [[second]]: boolean @Boolean = IsMemberAsBuilt builtin=MathFloor
# CHECK-NEXT: CheckProof [[second]] checkedType=true {{*}}source=WhatIsRemembered
