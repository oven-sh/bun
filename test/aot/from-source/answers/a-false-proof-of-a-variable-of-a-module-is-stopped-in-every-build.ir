# A value that is stored into a module variable either has been shown to have the variable's type or is checked. Link types the variable by the stores that it sees,
# and every function of the program reads the variable without a check.
# The failing control. Fault injection, testing=AssumeUnknownCallsReturnUndefined: Link assumes that the shell's `id` returns undefined, so `held` is a number or undefined, but a string is stored.
# In the first run the body of the function stores the string. It used to print "NaN" and continue.
# In the second run the function is called with an argument of another type than the declared one, so its slow version stores the string.
# Such a version goes through the walk, and the entry check is there too.
# OPTIONS: testing=AssumeUnknownCallsReturnUndefined
# RUN(STORED): run-in-shell mechanisms=all-Inlining globalThis.which = 1;
# STORED: bun: internal AOT error: type check failed
# STORED-NEXT: found string in a local variable
# STORED-NOT: went on
# STORED: crashed with
# RUN(SLOW): run-in-shell mechanisms=all-Inlining globalThis.which = 2;
# SLOW: bun: internal AOT error: type check failed
# SLOW-NEXT: found string in a local variable
# SLOW-NOT: went on
# SLOW: crashed with
# The passing control: the same store, of a value that fits.
# RUN(NONE): run-in-shell mechanisms=all globalThis.which = 0;
# NONE: 2.5
# NONE-NEXT: went on
# NONE-NEXT: exited with 0
# -- source: a-false-proof-of-a-variable-of-a-module-is-stopped-in-every-build.ts
# declare function id(value: unknown): any;
# declare function print(...values: unknown[]): void;
# declare const which: number;
# let held = 0.5;
# function set(flag: number) { held = flag ? 1.5 : id("text"); }
# function get() { return held + 1; }
# set(1);
# if (which === 1) set(0);
# if (which === 2) (set as any)("");
# print(String(get()));
# print("went on");
# -- end of source
