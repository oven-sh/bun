# const lib = { base: 1 };
# function early() { try { return lib.add(1, 2); } catch (error) { return error.constructor.name; } }
# print(typeof lib.add, early());
# Object.defineProperty(lib, "add", { enumerable: true, get: function () { return add; } });
# function called(t) { let s = 1; for (let i = 0; i < t; i++) s = lib.add(s, i); return s; }
