# f1 = first, f2 = second, f3 = onOneWay, f4 = inLoopWithin
# A test in front of a loop sends the whole loop away where it fails. So a variable of the file that is seen to hold one of a few closures is asked for them in front of a loop only where every turn of that very loop calls it.
# A hook that only one way through a turn calls, and one that a loop within calls, are not asked for there: where the hook is unset the work of the turns stays typed.
# RUN(ONEWAY): walk f3 mechanisms=all
# ONEWAY-NOT: testedType=f1|f2
# ONEWAY: Return v
# RUN(WITHIN): walk f4 mechanisms=all
# WITHIN-NOT: testedType=f1|f2
# WITHIN: isLoopHead=true
# RUN(UNSET): run-in-shell flag = function (which) { return false; };
# UNSET: 151 486 0
# UNSET-NEXT: exited with 0
# RUN(FIRST): run-in-shell flag = function (which) { return which === 1; };
# FIRST: 151 486 66
# FIRST-NEXT: exited with 0
# RUN(SECOND): run-in-shell flag = function (which) { return true; };
# SECOND: 151 486 -132
# SECOND-NEXT: exited with 0
