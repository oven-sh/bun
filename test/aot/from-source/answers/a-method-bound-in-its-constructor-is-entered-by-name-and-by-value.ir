# function byValue(t) { let s = 0; for (let i = 0; i < t + 3; i++) s = (s + loose(i)) | 0; return s; }
# function handed(holder, t) { let s = 0; for (let i = 0; i < t + 3; i++) s = (s + holder.turn(i)) | 0; return s; }
