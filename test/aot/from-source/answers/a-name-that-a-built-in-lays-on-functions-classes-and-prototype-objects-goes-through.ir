# class Failure { static make() { return "make"; } say() { return "say"; } }
# function plain() { return "plain"; }
# function Maker(n) { this.tag = n; }
# Maker.prototype.weigh = function () { return "weigh " + this.tag; };
# const made = new Maker(1);
# new Failure();
# Error.captureStackTrace(Failure);
# Error.captureStackTrace(Failure.prototype);
# Error.captureStackTrace(plain);
# Error.captureStackTrace(Maker);
# Error.captureStackTrace(Maker.prototype);
# print(typeof Failure.stack, typeof new Failure().stack, typeof plain.stack, typeof Maker.stack, typeof made.stack);
# print(Failure.make(), new Failure().say(), plain(), made.weigh(), Object.keys(Failure).length, Object.hasOwn(Failure.prototype, "stack"));
