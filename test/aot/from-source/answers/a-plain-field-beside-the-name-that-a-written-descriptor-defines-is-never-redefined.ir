# const lib = {};
# function fill(target) { target.add = function (a, b) { return a + b; }; Object.defineProperty(target, "marker", { value: true }); }
# fill(lib);
# function called(t) { let s = 1; for (let i = 0; i < t; i++) s = lib.add(s, i); return s; }
# print(called(5), called(6));
