# `box.late = value` where the layout has a slot for `late` and the maker left it empty: the store CREATES the field. Without mechanisms it goes by name: the field table finds the slot empty and hands the store to the short stub for a field
# that takes any value. What unseen code has done to the object or to its prototypes in front of the store: frozen . sealed . not extensible . another prototype with a setter | with a read-only value . an own setter . laid and deleted .
# a name in front . no prototype . a proxy above . a read-only value, then a setter, laid on the prototype of all, and taken off again. The value, the order of keys, the attributes, who was called. As plain, in both modes.
# RUN(NONE): run-in-shell mechanisms=none globalThis.log = []; globalThis.seen = () => log.splice(0).join("+"); globalThis.deeds = Box => { const list = []; const add = (name, deed) => list.push([name, make => { const box = make(false); return deed(box, make) || box; }]); add("0 as made", box => { }); add("1 laid by the maker", (box, make) => make(true)); add("2 frozen", box => { Object.freeze(box); }); add("3 sealed", box => { Object.seal(box); }); add("4 not extensible", box => { Object.preventExtensions(box); }); add("5 another prototype with a setter", box => { Object.setPrototypeOf(box, { set late(value) { log.push("set " + value); } }); }); add("6 another prototype with a value that is read only", box => { Object.setPrototypeOf(box, Object.freeze({ late: "fixed" })); }); add("7 an own setter", box => { Object.defineProperty(box, "late", { set(value) { log.push("own " + value); }, configurable: true }); }); add("8 laid, then deleted", box => { box.late = 1; delete box.late; }); add("9 a name in front", box => { box.more = 3; }); add("10 no prototype", box => { Object.setPrototypeOf(box, null); }); add("11 a proxy above", box => { Object.setPrototypeOf(box, new Proxy({}, { set(target, key, value, receiver) { log.push("trap " + String(key)); return Reflect.set(target, key, value, receiver); } })); }); add("12 as made, once more", box => { }); add("13 a value that is read only comes to lie on the prototype of all", box => { Object.defineProperty(Box.prototype, "late", { value: "above", writable: false, configurable: true }); }); add("14 a setter comes to lie there", box => { Object.defineProperty(Box.prototype, "late", { set(value) { log.push("above " + value); }, configurable: true }); }); add("15 and goes again", box => { delete Box.prototype.late; }); return list; };
