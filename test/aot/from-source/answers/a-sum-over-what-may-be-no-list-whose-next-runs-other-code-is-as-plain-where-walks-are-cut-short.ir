# A walk of a loop that is cut short inside the step is undone and walked again. The lines below are what plain Bun prints.
# RUN: run-in-shell mechanisms=all
# RUN: run-in-shell mechanisms=all testing=CutWalksOfLoopsShort:1:0
# RUN: run-in-shell mechanisms=all testing=CutWalksOfLoopsShort:2:1
# RUN: run-in-shell mechanisms=all testing=CutWalksOfLoopsShort:3:1
# RUN: run-in-shell mechanisms=all testing=CutWalksOfLoopsShort:5:2
# CHECK: 0 [seen 1,seen 2,seen 3,seen 4,12] ends |
# CHECK-NEXT: 0 [9] ends |
# CHECK-NEXT: 1 [seen 1,seen 2,seen 3,seen 4,12] ends |
# CHECK-NEXT: 1 [9] ends |
# CHECK-NEXT: exited with 0
