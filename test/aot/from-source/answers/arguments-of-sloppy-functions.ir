# function deleted(a) { delete arguments[0]; a = 3; return String(arguments[0]) + "," + a + "," + arguments.length; }
# function deletedAndSetAgain(a) { delete arguments[0]; arguments[0] = 4; return a + "," + arguments[0]; }
