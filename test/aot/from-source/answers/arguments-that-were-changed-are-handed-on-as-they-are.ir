# function target(a, b, c) { return "<" + [arguments.length, a, b, c].join("/") + ">"; }
# function stored() { arguments[0] = "s"; return target.apply(null, arguments); }
# function maybe(flag) { if (flag === 1) arguments[1] = "m"; return target.apply(null, arguments); }
# function cut(flag) { if (flag === 1) arguments.length = 1; return target.apply(null, arguments); }
# function grown(flag) { if (flag === 1) Array.prototype.push.call(arguments, "g"); return target.apply(null, arguments); }
# function touched(flag) { touch(flag, arguments); return target.apply(null, arguments); }
# function touch(flag, list) { if (flag === 1) list[0] = "t"; }
# function twice() { return target.apply(null, arguments) + target.apply(null, arguments); }
# function behind(flag) { if (flag === 0) return "early"; arguments[2] = "s"; return target.apply(null, arguments); }
# function longer(flag) { if (flag === 0) return "early"; arguments[1] = "l"; arguments.length = 3; return target.apply(null, arguments); }
# function first() { if (arguments.length === 0) return "none"; arguments[0] = "z"; return target.apply(null, arguments); }
# function shorter() { if (arguments.length === 0) return "none"; arguments.length = 1; return target.apply(null, arguments); }
# globalThis.fs = { stored, maybe, cut, grown, touched, twice, behind, longer, first, shorter };
