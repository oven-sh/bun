# Until the class of a constructor function begins, the read of its prototype object gives what `prototype` of the function holds then. So the read stays behind whatever may store to the property.
# Nothing has begun in the first turn, so the store there ends nothing, and the guards begin over the stored object at the `new` behind it. A read from in front of the loop would name the object that the function was born with.
# What is tested is no object of the function, so the chain is walked up to the object that was read. The function is at hand in front of the loop, so nothing but the store keeps the read in the loop.
# -- source: main.js
# "use strict";
# function Message(n) { this.n = n; }
# function run(store, make) { const Made = Message; let count = 0; for (let i = 0; i < 10; i++) { if (i === 0) store(); globalThis.last = new Made(1); if (make() instanceof Made) count++; } return count; }
# Function("return globalThis.register")()(run, Message);
# -- end of source
