# const fractions = [];
# const mixed = [];
# const texts = [];
# for (let i = 0; i < 4; i++) {
#   integers.push(i);
#   fractions.push(i + 0.5);
#   mixed.push(i < 2 ? i : i + 0.5);
#   texts.push("x" + i);
# }
# report(integers);
# report(fractions);
# report(mixed);
# report(texts);
# -- end of source
# RUN: run-in-shell globalThis.report = list => print(/ArrayWith\w+/.exec(describe(list))[0] + " " + list.join());
# CHECK: ArrayWithInt32 0,1,2,3
# CHECK-NEXT: ArrayWithDouble 0.5,1.5,2.5,3.5
# CHECK-NEXT: ArrayWithDouble 0,1,2.5,3.5
