# early() and inner() begin the guards of F in front of what they ask of them, each time they are entered. The run time is asked once, whatever comes of it: guards that have ended, or were refused, never begin again,
# and code that went on asking would pay for a guess that fails more than for no guess.
# In the run REPLACED the guards have begun and end with the object that `prototype` held. In the run REFUSED they are never armed: a list is no object that the run time takes for the prototype of a class.
# RUN: run-in-shell --aotCountsPath=/dev/null const calls = () => aotOperationCount("operationAOTBeginMemberGuards"); globalThis.report = () => calls() < 2 ? "asked at most once" : "asked again and again"; globalThis.first = () => { }; globalThis.change = () => { };
# CHECK: 6
# CHECK-NEXT: 50
# CHECK-NEXT: asked at most once
# CHECK-NEXT: exited with 0
# RUN(REPLACED): run-in-shell --aotCountsPath=/dev/null const calls = () => aotOperationCount("operationAOTBeginMemberGuards"); globalThis.report = () => calls() < 2 ? "asked at most once" : "asked again and again"; globalThis.first = () => { }; globalThis.change = (F) => { F.prototype = { m() { return 2; } }; };
# REPLACED: 6
# REPLACED-NEXT: 70
# REPLACED-NEXT: asked at most once
# REPLACED-NEXT: exited with 0
# RUN(REFUSED): run-in-shell --aotCountsPath=/dev/null const calls = () => aotOperationCount("operationAOTBeginMemberGuards"); globalThis.report = () => calls() < 2 ? "asked at most once" : "asked again and again"; globalThis.first = (F) => { const list = []; list.m = () => 3; F.prototype = list; }; globalThis.change = () => { };
