# RUN(BOTH): run-in-shell globalThis.when = 0; globalThis.report = () => { }; globalThis.change = P => { if (globalThis.when) { P.prototype.size = function () { return 100 + this.x; }; return; } P.prototype.other = 1; globalThis.when = 5; };
# BOTH: ,0,1,2,3,4,105,106,107
