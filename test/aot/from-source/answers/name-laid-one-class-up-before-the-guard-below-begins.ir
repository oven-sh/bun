# print(answers);
# report();
# -- end of source
# No Base is ever made: the guards behind which `first` and `second` are found are guards of Below. Base listens all the same, for the class below it.
# What is laid on the prototype object of Base, in front of the first Below or behind it, ends the guard of that name in Below, and nothing else.
# OPTIONS: mechanisms=all
# RUN(NEVER): run-in-shell --aotCountsPath=/dev/null globalThis.when = -1; globalThis.report = () => { const lines = aotRuntimeCounters().split("\n"); let ended = "0"; for (let i = 0; i < lines.length; i++) { if (lines[i].includes("counter:ClassGuardBitsInvalidated")) ended = lines[i].split("\t")[0]; } print("guards ended: " + ended); };
# NEVER: ,10:0,11:1,12:2,13:3,14:4,15:5,16:6,17:7
# NEVER-NEXT: guards ended: 0
# NEVER-NEXT: exited with 0
# RUN(BEFORE): run-in-shell globalThis.when = 0; globalThis.report = () => { }; globalThis.change = Base => { Base.prototype.first = function () { return 100; }; };
# BEFORE: ,110:100,110:100,110:100,110:100,110:100,110:100,110:100,110:100
# BEFORE-NEXT: exited with 0
# RUN(LATER): run-in-shell --aotCountsPath=/dev/null globalThis.when = 5; globalThis.change = Base => { Base.prototype.first = function () { return 100; }; }; globalThis.report = () => { const lines = aotRuntimeCounters().split("\n"); let ended = "0", counted = 0; for (let i = 0; i < lines.length; i++) { if (lines[i] && !lines[i].startsWith("0")) counted++; if (lines[i].includes("counter:ClassGuardBitsInvalidated")) ended = lines[i].split("\t")[0]; } print(counted && ended === "0" ? "compiled code ran and no guard ended" : "a guard ended wherever compiled code ran"); };
# LATER: ,10:0,11:1,12:2,13:3,14:4,110:100,110:100,110:100
# LATER-NEXT: a guard ended wherever compiled code ran
# LATER-NEXT: exited with 0
