# OPTIONS: several-realms admit=ReplacedBuiltins
# RUN: run-in-shell (function () { "use strict"; const second = createGlobalObject(); const start = globalThis.runCompiledEntryPoint; globalThis.runCompiledEntryPoint = entry => { second.runCompiledEntryPoint(entry); return start(entry); }; const kitOf = f => ({ make: f[0], asks: f[1], spoil: f[2] }); const kits = { }; const finish = () => { if (!kits.first || !kits.second) return; const a = kits.first, b = kits.second; const names = Object.keys(a.asks); const said = (kit, name, all) => { try { return String(kit.asks[name](all)); } catch (error) { return "throws " + error.name + ": " + error.message; } }; for (let turn = 0; turn < 3; turn++) for (const name of names) { said(a, name, a.make()); said(a, name, b.make()); said(b, name, a.make()); said(b, name, b.make()); } const early = { }; for (const name of names) early[name] = [b.make(), b.make(), a.make(), a.make()]; const asMade = { }; for (const name of names) asMade[name] = said(a, name, a.make()); b.spoil(); let right = 0, asked = 0; const hold = (label, got, expected) => { asked++; if (got === expected) right++; else print(label + ": " + got + " and not " + expected); }; for (const name of names) { hold("we ask theirs " + name, said(a, name, early[name][0]), "their " + name); hold("they ask theirs " + name, said(b, name, early[name][1]), "their " + name); hold("we ask ours " + name, said(a, name, early[name][2]), asMade[name]); hold("they ask ours " + name, said(b, name, early[name][3]), asMade[name]); } print(right + " of " + asked); }; globalThis.register = (...f) => { kits.first = kitOf(f); finish(); }; second.register = (...f) => { kits.second = kitOf(f); finish(); }; })();
