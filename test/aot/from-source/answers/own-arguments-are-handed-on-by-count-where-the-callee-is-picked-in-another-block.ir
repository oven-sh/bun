# The callee of apply() comes out of a copied function with two ways, so the call stands in another built block than the entry: the arguments object is built anew there, over the
# hidden list made again. That list is noted as made by the caller like the first, so the form by count finds it fresh: four reads of the frame and no arguments object on the ways up to four.
# -- source: main.js
# "use strict";
# function show(a, b, c) { return "<" + [arguments.length, a, b, c].join("/") + ">"; }
# function other(a) { return "other" + arguments.length + a; }
# function pick(o) { return o.flag ? o.first : show; }
# function picked() { return pick(this).apply(null, arguments); }
# globalThis.fs = { picked, flag: false, first: other };
# const fs = globalThis.fs;
# print(fs.picked(), fs.picked(1), fs.picked(1, 2, 3), fs.picked(1, 2, 3, 4, 5, 6));
# fs.flag = true;
# print(fs.picked(), fs.picked(7), fs.picked(1, 2, 3, 4, 5));
# -- end of source
# RUN: run-in-shell
# CHECK: <0///> <1/1//> <3/1/2/3> <6/1/2/3>
# CHECK-NEXT: other0undefined other17 other51
# CHECK-NEXT: exited with 0
# RUN(ENTRY): walk f4:GenericCallEntry mechanisms=all
