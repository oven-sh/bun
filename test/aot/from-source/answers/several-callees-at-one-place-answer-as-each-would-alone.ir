# -- source: main.js
# class A { k = 1; }
# class B { k = 2; }
# class D { k = 4; }
# class E extends A { m = 8; }
# function Old() { this.k = 16; }
# class Thrower { constructor() { throw new Error("thrown"); } }
# class First { constructor() { this.own = new.target === First; } }
# class Second { constructor() { this.own = new.target === Second; } }
# function make(k) { return class { k = k; }; }
# const Ten = make(10);
# const Twenty = make(20);
# function adder(n) { return (x) => x + n; }
# const twice = (x) => x * 2;
# const addFive = adder(5);
# function three(count) { let sum = 0; for (let i = 0; i < count; i++) { const C = i % 3 === 0 ? A : i % 3 === 1 ? B : D; sum += new C().k; } return sum; }
# function classAndFunction(count) { let sum = 0; for (let i = 0; i < count; i++) { const C = i & 1 ? A : Old; sum += new C().k; } return sum; }
# function derived(count) { let sum = 0; for (let i = 0; i < count; i++) { const C = i & 1 ? E : B; const o = new C(); sum += o.k + (o.m || 0); } return sum; }
# function calls(count) { let sum = 0; for (let i = 0; i < count; i++) { const f = i & 1 ? twice : addFive; sum += f(i); } return sum; }
# function throws(count) { let log = ""; for (let i = 0; i < count; i++) { const C = i & 1 ? Thrower : A; try { log += new C().k; } catch (error) { log += error.message; } } return log; }
# function stranger(count) { let sum = 0; const given = pick(B); for (let i = 0; i < count; i++) { const C = i & 1 ? A : given; sum += new C().k; } return sum; }
# function reflected(count) { let sum = 0; for (let i = 0; i < count; i++) { const C = i & 1 ? A : B; sum += Reflect.construct(C, []).k; } return sum; }
# function targets(count) { let all = true; for (let i = 0; i < count; i++) { const C = i & 1 ? First : Second; all = all && new C().own; } return all; }
# function twins(count) { let sum = 0; for (let i = 0; i < count; i++) { const C = i % 3 === 0 ? Ten : i % 3 === 1 ? Twenty : A; sum += new C().k; } return sum; }
