# The holders of the members are objects that the program made: `Base.prototype = {}`, `Message.prototype = Object.create(Base.prototype)`, and the function Message stands below the function Base, as $toClass() lays node's classes.
# The guards of Message begin with its first object, over those holders, and hold until somebody changes one. Text that the build has not seen changes one in turn 5 of the loop, or ahead of the first object.
# The test for an instance looks for @@hasInstance on Message, on Base and on Function.prototype.
# -- source: main.js
# "use strict";
# function Base() {}
# Base.prototype = {};
# Base.prototype.read = function () { return 3; };
# function Message(n) { this.n = n; }
# Message.prototype = Object.create(Base.prototype);
# Object.setPrototypeOf(Message, Base);
# Message.prototype.twice = function () { return this.n * 2; };
# function total(count, change) { let sum = 0; for (let i = 0; i < count; i++) { const made = new Message(1); if (i === 5) change(made); sum += made.twice() + made.read(); if (made instanceof Message) sum += 100; } return sum; }
# function hide(own) { const made = new Message(1); made.twice = own; return made.twice(); }
# Function("return globalThis.register")()(total, hide, Message, Base);
# -- end of source
