# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function upper() { return "abc".toUpperCase(); } function lower() { return "ABC def".toLowerCase(); } function padded() { return "7".padStart(3, "0"); } function paddedBehind() { return "ab".padEnd(5, "xy"); } function paddedWithNumber() { return "7".padStart(3, 0); } function repeated() { return "ab".repeat(3); } function replaced() { return "a-b-c".replace(/-/g, "_"); } function replacedOnce() { return "a-b-c".replace("-", "+"); } function swapped() { return "a-b".replace(/(\w)-(\w)/, "$2-$1"); } function searched() { return "a-b-c".search(/-/); } function refused() { return "ab".repeat(-1); } function tooLong() { return "ab".repeat(70000).length; } function grown() { return "".replaceAll("a", "$`"); } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } tell(upper); tell(lower); tell(padded); tell(paddedBehind); tell(paddedWithNumber); tell(repeated); tell(replaced); tell(replacedOnce); tell(swapped); tell(searched); tell(refused); tell(tooLong); tell(grown); tell(upper); tell(replaced); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
