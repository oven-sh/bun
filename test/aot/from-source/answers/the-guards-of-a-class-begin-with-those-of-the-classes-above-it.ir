# f3 = quiet
# Base makes no object of its own: it is only called by Heir. Its guards begin with those of Heir, so what begins the guards of Heir in front of the loop says that those of Base have begun too,
# and the read of `Base.call` begins nothing in the turn.
# RUN(BEGINS): walk f3 mechanisms=all
# BEGINS: BeginMemberGuards
# BEGINS: ) isInLoop=true isLoopHead=true
# BEGINS-NOT: BeginMemberGuards
# BEGINS: Return
# RUN: run-in-shell globalThis.hits = 0; globalThis.change = () => { }; globalThis.report = () => globalThis.hits;
