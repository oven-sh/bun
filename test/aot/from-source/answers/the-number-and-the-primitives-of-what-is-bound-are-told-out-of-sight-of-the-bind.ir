# function add(a, b) { return (a + b) | 0; }
# function line(a, b, x) { return (a * x + b) | 0; }
# function tag(label, x) { return label + x; }
# const plusFour = add.bind(null, 4), named = tag.bind(null, "n"), scale = line.bind(null, 3, 4);
# function overOne(t) { let s = t & 1; for (let i = 0; i < t + 3; i++) s = (s + plusFour(i)) | 0; return s; }
# function overTwo(t) { let s = t & 1; for (let i = 0; i < t + 3; i++) s = (s + scale(i)) | 0; return s; }
# function overText(t) { let s = ""; for (let i = 0; i < t + 3; i++) s += named(i); return s; }
# function overParameter(bound, t) { let s = t & 1; for (let i = 0; i < t + 3; i++) s = (s + bound(i)) | 0; return s; }
