# CHECK: 2,4,6 true 3
# CHECK-NEXT: 1.5,2.5 8
# CHECK-NEXT: function function 1
# CHECK-NEXT: true true TypedArray
# CHECK-NEXT: true 7,8 true
# CHECK-NEXT: true 2
# CHECK-NEXT: TypeError
# CHECK-NEXT: exited with 0
