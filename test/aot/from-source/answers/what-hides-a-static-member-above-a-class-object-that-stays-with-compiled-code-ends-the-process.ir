# declare function print(...values: unknown[]): void;
# declare function poke(...values: unknown[]): void;
# class Base {
#     static kept = 1;
#     static make() { return "base make"; }
#     static get label() { return "base label"; }
# }
# class Closed extends Base {
#     tag = 1;
#     static held = 3;
#     static weigh() { return "weigh"; }
# }
# const kept = new Closed();
# const other: any = {};
# const tell = () => Closed.weigh() + " " + Closed.make() + " " + Closed.label + " " + (kept instanceof Closed) + " " + (other instanceof Closed);
# print(tell());
# poke();
# print(tell());
# -- end of source
# Neither class object leaves compiled code, so compiled code goes from `Closed` to the static members of `Base`, and to the ordinary Symbol.hasInstance, without a look.
# Both classes have a static field. A static field takes a proof away from its own name alone, so the other names of the row are held as they are in a row without fields.
# `poke` is a free name that each run defines, and it is handed nothing. It climbs to the class objects from an object that it takes out of the heap: a name of their own that hides a member of the class above, another function under a member of their own, or Symbol.hasInstance on either, is ruled out and ends the process.
# A name that nobody above declares is not ruled out: compiled code may lay such names in sight, and reads them by name.
# The run time looks at the class objects behind the deed. What leaves every lookup as it was goes through: the method, the getter and Symbol.hasInstance laid on `Closed` with the very functions that stand above it.
# Stores in sight under the name of a static field of the row: stores-on-class-objects-of-a-row-with-a-static-field-go-through.ir. The green twin: deeds-on-a-class-object-that-unseen-code-was-handed-go-through.ir.
# OPTIONS: mechanisms=all
# RUN: run-in-shell globalThis.poke = () => { const given = aotFindObjectOfLayout(1).constructor; given.late = "late"; given.make = given.make; Object.defineProperty(given, "label", Object.getOwnPropertyDescriptor(Object.getPrototypeOf(given), "label")); Object.defineProperty(given, Symbol.hasInstance, { value: Function.prototype[Symbol.hasInstance] }); print(given.late); };
# CHECK: weigh base make base label true false
# CHECK-NEXT: late
# CHECK-NEXT: weigh base make base label true false
# CHECK-NEXT: exited with 0
