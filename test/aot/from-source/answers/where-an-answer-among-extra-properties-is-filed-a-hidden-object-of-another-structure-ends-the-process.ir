# An answer for a value or a getter among the extra properties of a compiled object is filed under the structure of the OBJECT and loaded off the hidden object at an offset that the hidden object's structure gave.
# The two go together because the structure of the object names that of its hidden object, and every road that changes the hidden object derives the structure of the object anew. That is held wherever an answer is taken off the structure that is named:
# at the door of the function that answers a read and of the one that files an answer at a place: values, getters and absences alike.
# The first run: properties come, go and come back by the roads of the language, a fresh place reads behind each: every answer is that of the language.
# The other runs are the red controls: a door left open on purpose gives the hidden object another structure and tells nobody: the next answer ends the process and says where. VALUE and GETTER end where an answer is filed
# (the tables hold the slot from the reads in front), MADE and ABSENT where a read is answered (a name that nobody has read yet; in ABSENT the name lies on the hidden object and the structure that is named says that it does not).
# f1 = make, f2 = depthFirst, f3 = depthNext, f4 = depthLast, f5 = girthFirst, f6 = girthNext, f7 = byKey, f8 = setSpan, f9 = brimOf
# -- source: where-an-answer-among-extra-properties-is-filed-a-hidden-object-of-another-structure-ends-the-process.ts
# declare function register(...handed: unknown[]): void;
# class Shelf { width: number; constructor(width: number) { this.width = width; } }
# function make(width: number): Shelf { return new Shelf(width); }
# function depthFirst(shelf: any): unknown { return shelf.depth; }
# function depthNext(shelf: any): unknown { return shelf.depth; }
# function depthLast(shelf: any): unknown { return shelf.depth; }
# function girthFirst(shelf: any): unknown { return shelf.girth; }
# function girthNext(shelf: any): unknown { return shelf.girth; }
# function byKey(shelf: any, key: string): unknown { return shelf[key]; }
# function setSpan(shelf: any, span: number): void { shelf.span = span; }
# function brimOf(shelf: any): unknown { return shelf.brim; }
# register(make, depthFirst, depthNext, depthLast, girthFirst, girthNext, byKey, setSpan, brimOf);
# -- end of source
# OPTIONS: mechanisms=all
# RUN: run-in-shell globalThis.register = (make, depthFirst, depthNext, depthLast, girthFirst, girthNext, byKey, setSpan, brimOf) => { const shelves = [make(1), make(2), make(3)]; const sum = read => { let total = 0; for (let turn = 0; turn < 300; turn++) for (const shelf of shelves) total += read(shelf) ?? 1000; return total; }; for (const shelf of shelves) { shelf.depth = shelf.width * 10; shelf.span = 1; Object.defineProperty(shelf, "girth", { get() { return this.width * 100; }, configurable: true, enumerable: true }); } print(aotPlaceOfProperty(shelves[0], "depth"), sum(depthFirst), sum(girthFirst)); for (const shelf of shelves) shelf.height = 5; print(sum(depthNext), sum(girthNext), sum(shelf => byKey(shelf, "span")), sum(brimOf)); for (let turn = 0; turn < 300; turn++) for (const shelf of shelves) setSpan(shelf, turn); print(sum(shelf => byKey(shelf, "span"))); for (const shelf of shelves) delete shelf.depth; print(sum(depthLast)); };
# REQUIRES: entries-of-bun
# CHECK: extra property 18000 180000
# CHECK-NEXT: 18000 180000 900 900000
# CHECK-NEXT: 269100
# CHECK-NEXT: 900000
# CHECK-NEXT: exited with 0
# RUN(VALUE): run-in-shell globalThis.register = (make, depthFirst, depthNext) => { const shelves = [make(1), make(2), make(3)]; const sum = read => { let total = 0; for (let turn = 0; turn < 300; turn++) for (const shelf of shelves) total += read(shelf); return total; }; for (const shelf of shelves) shelf.depth = shelf.width * 10; print(sum(depthFirst)); for (const shelf of shelves) print(aotAddExtraPropertyUnseen(shelf, "height", 5)); print("read", sum(depthNext)); };
# REQUIRES(VALUE): entries-of-bun
# VALUE: 18000
# VALUE-COUNT-3: true
# VALUE-NOT: read
# VALUE: AOT: where an answer is filed at a place, the properties that an object holds beside its fields are not laid out as the structure of the object says: it names structure {{*}}, they have {{*}}. This is a bug in Bun.
# VALUE: crashed with
