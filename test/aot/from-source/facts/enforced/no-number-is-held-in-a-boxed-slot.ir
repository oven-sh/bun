# a number is held where it lies raw: `kind` in four bytes. `pos`, any number, stays boxed, and in a boxed slot no number is held, int32 or not: the two markers would drag its arithmetic into floating point, and every store by name would pay the test of the type.
# a boolean, a text and a reference beside them are held.
# -- source: no-number-is-held-in-a-boxed-slot.ts
# declare function sink(...values: unknown[]): void;
# const enum Kind { Leaf, Branch }
# class Item { kind: Kind; pos: number; open: boolean; text: string; next: Item | undefined; constructor(kind: Kind, pos: number, text: string) { this.kind = kind; this.pos = pos; this.open = true; this.text = text; this.next = undefined; } }
# sink(Item, new Item(Kind.Leaf, 1, "a"));
# -- end of source
# RUN: facts enforced mechanisms=all
# CHECK: field {{*}} "kind" source=written type=i32 markers spares-test slot=OptionalInt32 held=
# CHECK-NEXT: field {{*}} "pos" source=written type=number markers spares-test slot=JSValue
# CHECK-NEXT: field {{*}} "open" source=written type=boolean markers spares-test {{*}}held=undefined|null|boolean
# CHECK-NEXT: field {{*}} "text" source=written type=undefined|null|string {{*}}held=undefined|null|string
# CHECK-NEXT: field {{*}} "next" source=written type=undefined|null|L{{*}}held=undefined|null|L
# RUN(NEVER): facts enforced mechanisms=all
# NEVER-NOT: slot=JSValue held=undefined|null|i
# NEVER-NOT: slot=JSValue held=undefined|null|number
# NEVER-NOT: differs-from-table
