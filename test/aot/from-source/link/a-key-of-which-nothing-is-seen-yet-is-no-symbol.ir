# A store under a key that is one symbol as far as is seen lets its object escape. "As far as is seen" leaves out what came by escape alone, so a key of which nothing had been seen yet counted as a symbol:
# here `this` of grind() is known by escape alone at first (the constructor goes through a table under a name nobody knows), `grain[i] * 3 - 1` is a number by escape alone, and the first look at
# `sacks[sack] = grain` sent the local map out of sight for good. The next look said no; whether the first one came at all hung on the order of arrivals, and Link given more said more (FlowNotMonotonic).
# A key is a symbol as far as is seen only where a symbol has been seen. L1 = the map.
# RUN: link layouts mechanisms=all
# CHECK: layout L1 changes=[GainsProperty] stays-with-compiled-code filled-under-computed-keys
# -- source: a-key-of-which-nothing-is-seen-yet-is-no-symbol.js
# function Mill() { this.hoppers = [[1, -11, 5]]; }
# Mill.prototype.grind = function (index) { var grain = this.hoppers[index], sacks = {}, full = 0; for (var i = grain.length - 1; i >= 0; i--) { var sack = grain[i] * 3 - 1; if (sacks[sack + 1]) full++; sacks[sack] = grain; } return Object.keys(sacks).join() + full; };
# const kinds = { mill: Mill };
# function make(name) { return new kinds[name](); }
