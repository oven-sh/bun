# `table[key].get(1)` where table is a record of the program that holds Nodes and key is a text nobody knows. Under such a key the read may also find a member of Object.prototype: Link says "an object of unseen code".
# On that object nobody knows what `get` is: the call runs unseen code. But that code is called ON THE UNSEEN OBJECT: a Node finds its `get` by its own lookup, in its class.
# Until now the call handed every receiver that arrives to unseen code: the Node, its fields and its class went out of sight by one read out of a table.
# The arguments go out as ever: `carried` is handed over in `give` and is out of sight.
# -- source: a-method-called-on-what-may-be-an-unseen-object-lets-no-receiver-in-sight-go.ts
# declare function text(): string;
# declare function sink(...values: unknown[]): void;
# class Node { v: number; constructor(v: number) { this.v = v; } get(n: number): number { return this.v + n; } take(c: Carried): number { return c.y; } }
# class Carried { y: number; constructor(y: number) { this.y = y; } }
# const table: Record<string, Node> = { a: new Node(1), b: new Node(2) }, carried = new Carried(5);
# function at(key: string): number { const found = table[key]; return found ? found.get(1) + found.v : -1; }
# function give(key: string): number { return table[key]!.take(carried); }
# sink(at(text()), at("b"), at(text()), give("a"));
# -- end of source
