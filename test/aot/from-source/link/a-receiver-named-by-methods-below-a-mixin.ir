# Only classes below one mixin have the method: a receiver that nothing else tells is the one whose structure tells its class.
# RUN: walk f2 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: HasStructureOfClass {{*}}layout=L2
# CHECK: AreMembersUnchanged conditions=[{layout=L2 key="spot"}]
# RUN(SLOPPY): walk f3 mechanisms=all
