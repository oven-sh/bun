# Five records of a written union meet, which is more than a set holds. A written union is no family of the flow: the five are united as what met, and the store of a name that none of them lists goes through what met.
# The name belongs in a field of each of the five, as it does where the store goes through a class with what extends it. The sixth literal never meets another: no store comes to it and it gets no field.
# TODO: Link: a name that is stored through records that met is appended to none of them, so it lies out of line in each
# -- source: stored-through-records-that-met.ts
# type U = { k: "a"; x: number } | { k: "b"; y: number } | { k: "c"; z: number } | { k: "d"; w: number } | { k: "e"; v: number } | { k: "f"; u: number } | { k: "g"; s: number };
# function tag(u: U) { (u as any).t = 1; }
# const a: U = { k: "a", x: 1 };
# const b: U = { k: "b", y: 2 };
# const c: U = { k: "c", z: 3 };
# const d: U = { k: "d", w: 4 };
# const e: U = { k: "e", v: 5 };
# const f: U = { k: "f", u: 6 };
# const g: U = { k: "g", s: 7 };
# const n = Date.now();
# tag(n > 4 ? a : n > 3 ? b : n > 2 ? e : n > 1 ? f : g);
# function read(u: { k: "c"; z: number }) { return (u as any).t; }
# read(c as any);
# -- end of source
# RUN: link fields layouts mechanisms=all
# CHECK: field L0.2 "t" appended proven=i32 writers-known
# CHECK: field L1.2 "t" appended proven=i32 writers-known
# CHECK: field L6.1 "z"
# CHECK-NOT: field L6.2
# CHECK: layout L0 {{*}}changes=[]
# CHECK-NEXT: layout L1 {{*}}changes=[]
# CHECK: layout L6 {{*}}changes=[]
# The members that have the name keep it in one place: 24 + 2 x 8 bytes take a cell of 48, and the word that is left over takes the name in both.
# RUN(PLAN): plan layouts mechanisms=all
# PLAN: layout L0 CompiledObject size=48 shapes
# PLAN: slot 2 "t" appended {{*}} Inline offset=40
# PLAN: layout L1 CompiledObject size=48 shapes
# PLAN: slot 2 "t" appended {{*}} Inline offset=40
# PLAN: layout L6 CompiledObject size=48 shapes
