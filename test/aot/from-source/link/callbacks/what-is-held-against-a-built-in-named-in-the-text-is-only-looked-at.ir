# As the library's filter() is written: `each` asks whether what it is handed is a function, then whether it IS the built-in Boolean, and otherwise only calls it: the comparison with a built-in that the text names keeps nothing and runs no code: the parameter keeps the word, so a caller may lend it a closure made for the call. `against` holds it against a variable: that does more, as before.
# f1 = each, f2 = against, f3 = maker
# -- source: held-against-a-built-in.ts
# declare function sink(...values: unknown[]): void;
# let held: ((x: number) => unknown) | undefined;
# function each(list: number[], f: (x: number) => unknown): number { if (typeof f !== "function") return -2; let t = 0; if (f === Boolean) { for (let i = 0; i < list.length; i++) if (list[i]) t++; return t; } for (let i = 0; i < list.length; i++) if (f(list[i])) t++; return t; }
# function against(list: number[], f: (x: number) => unknown): number { if (typeof f !== "function") return -2; let t = 0; if (f === held) return -1; for (let i = 0; i < list.length; i++) if (f(list[i])) t++; return t; }
# function maker(list: number[], k: number) { return each(list, x => x > k) + each(list, Boolean) + against(list, x => x < k); }
# sink(maker([1, 2], 1), maker([4], 5), () => held);
# -- end of source
# RUN: link functions mechanisms=all
# CHECK-LABEL: function f1
# CHECK: parameter 1 {{*}}only-called
# CHECK-LABEL: function f2
# CHECK-NOT: only-called
# CHECK-LABEL: function f3

