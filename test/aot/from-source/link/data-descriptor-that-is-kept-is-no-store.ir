# -- source: data-descriptor-that-is-kept-is-no-store.js
# function K(v) { this.v = v; }
# const kept = { value: function m() { return this.v; }, enumerable: false, configurable: true, writable: true };
# Object.defineProperty(K.prototype, "m", kept);
# sink(kept);
# sink(new K(1).m());
