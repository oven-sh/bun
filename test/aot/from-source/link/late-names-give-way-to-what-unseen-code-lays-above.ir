# The name has room in an Inner by an expectation. Code that nobody sees lays an accessor under it on Inner.prototype, takes it away, lays a value that may not be written, lays another object above one Inner:
# the store runs the setter or throws, the read runs the getter, as plain.
# RUN(HELD): link held fields mechanisms=all
# HELD: "late" appended
# RUN(ANSWERS): run-in-shell globalThis.register = (f, I) => { globalThis.filler = f; globalThis.layAccessorAbove = () => Object.defineProperty(I.prototype, "late", { get() { return "got"; }, set(v) { this.seen = v; }, configurable: true }); globalThis.takeAccessorAway = () => { delete I.prototype.late; }; globalThis.layReadOnlyAbove = () => Object.defineProperty(I.prototype, "late", { value: "fixed", writable: false, configurable: true }); globalThis.changeWhatStandsAbove = o => Object.setPrototypeOf(o, { set late(v) { this.seen = "other " + v; }, get late() { return "other"; } }); };
# ANSWERS: n,late 1 undefined
# ANSWERS-NEXT: n,seen got 2
# ANSWERS-NEXT: n,late 1 undefined
