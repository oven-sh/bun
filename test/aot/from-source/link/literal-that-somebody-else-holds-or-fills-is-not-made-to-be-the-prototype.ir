# A literal is known as the prototype object of a function only where the body that makes it is the only one to fill it, under written names, and hands it to nobody but the one store under `prototype`.
# Handed to a call ahead of the store . stored under two functions . filled under a key that is computed . filled by a spread: nobody follows it, nothing is expected of it, and the function and its layout go, as with any other object stored there.
# That each of them also lays a getter changes nothing.
# -- source: main.js
# function Handed() { this.a = 1; }
# function First() { this.b = 1; }
# function Second() { this.c = 1; }
# function Keyed() { this.d = 1; }
# function Spread() { this.e = 1; }
# const members = { m: function () { return 1; }, get g() { return 1; } };
# publish(members);
# Handed.prototype = members;
# First.prototype = Second.prototype = { m: function () { return 2; }, get g() { return 2; } };
# Keyed.prototype = { [name()]: function () { return 3; }, m: function () { return 3; }, get g() { return 3; } };
# Spread.prototype = { ...base(), m: function () { return 4; }, get g() { return 4; } };
# print(new Handed().m(), new First().m(), new Second().m(), new Keyed().m(), new Spread().m());
# -- end of source
# RUN(SCAN): summary f0
# SCAN-NOT: made-for-it
# SCAN-NOT: DefinesByDescriptor a
# RUN: link members layouts mechanisms=all
# CHECK-NOT: on-prototype
# CHECK: layout L0 {{*}}changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# CHECK: layout L1 {{*}}changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# CHECK: layout L2 {{*}}changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# CHECK: layout L3 {{*}}changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# CHECK: layout L4 {{*}}changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
