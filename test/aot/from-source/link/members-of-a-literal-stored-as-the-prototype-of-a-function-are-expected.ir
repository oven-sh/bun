# `Tally.prototype = { raise: function (v) { .. }, get paces() { .. } }`: the body makes the literal, fills it under written names and does nothing else with it but store it under `prototype`.
# So the summary knows it as what a read of that `prototype` gives: a value under a name is a store on the prototype object, a getter or a setter a definition there, as a descriptor that is written in the body lays one.
# If a getter cost the literal that, no row would list what it holds, and no method beside the getter would be expected.
# NO PROOF: an accessor runs code at lookups that no flow need see, so the store still lets the function and its layout go. The record of the class expects the functions, and the run time looks at the object that `prototype` holds where the first object is made.
# A name that is written again behind the store expects nothing, be it a second function, a descriptor or a value.
# f1 = Tally, f2 = Twice, f3 = raise, f4 = lower, f5 = paces, f6 and f7 = level, f11 = k
# -- source: main.js
# function Tally() { this.sum = 0; this.steps = 0; }
# function Twice() { this.n = 1; }
# Tally.prototype = {
#   raise: function (v) { this.sum = this.sum + v; this.steps = this.steps + 1; return this; },
#   lower: function () { this.steps = this.steps - 1; return this.sum; },
#   get paces() { return this.steps; },
#   get level() { return this.sum; },
#   set level(v) { this.sum = v; } };
# Twice.prototype = { m: function () { return 1; }, get g() { return 1; }, get h() { return 1; }, k: function () { return 1; } };
# Twice.prototype.m = function () { return 2; };
# Object.defineProperty(Twice.prototype, "g", { get: function () { return 2; }, configurable: true });
# Twice.prototype.h = 3;
# new Tally().raise(1).paces;
# new Twice().k();
# -- end of source
