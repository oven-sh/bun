# where a built-in throws, the engine goes over the frames of the calls that are open, and each call of a function of the program leaves frames. Whatever the rehearsal asks the engine to run costs it
# allowance: one operation a call that is open. 60,000 throws 200 calls deep end the run in front of the pattern behind them; the same 60,000 throws one call deep do not.
# The texts are printed in the order of their characters: /deep60000/ would stand in front of /flat60000/.
# -- source: the-frames-that-the-engine-goes-over-draw-on-the-allowance.ts
# function throws(turns: number): number { let done = 0; for (let i = 0; i < turns; i++) { try { JSON.parse("{"); } catch {} done++; } return done; }
# function deep(depth: number, turns: number): number { return depth > 0 ? deep(depth - 1, turns) : throws(turns); }
# new RegExp("flat" + throws(60000));
# new RegExp("deep" + deep(200, 60000));
# -- end of source
# RUN: regexp-texts mechanisms=all
# CHECK-NOT: text /deep60000/
# CHECK: text /flat60000/
