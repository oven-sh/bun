# The cells of the fields that a layout takes whole from its base are copied from the base only where the layout says of itself what its base says.
# A name is deleted from an object of the class below: there no field is known to be filled, the inherited ones included. In the base they all are.
# -- source: a-name-is-deleted-from-the-class-below-alone.ts
# class Base { a = 1; b = 2; }
# class Below extends Base { c?: number = 3; }
# const base = new Base();
# const below = new Below();
# delete below.c;
# console.log(base.a, base.b, below.a, below.c);
# -- end of source
# RUN: link fields mechanisms=all
# CHECK: field L0.0 "a" proven=int[0, 2147483647] writers-known written-at-construction-alone filled
# CHECK: field L0.1 "b" proven=int[0, 2147483647] writers-known written-at-construction-alone filled
# CHECK: field L1.1 "a" proven=int[0, 2147483647] writers-known written-at-construction-alone of-birth
# CHECK: field L1.2 "b" proven=int[0, 2147483647] writers-known written-at-construction-alone of-birth
