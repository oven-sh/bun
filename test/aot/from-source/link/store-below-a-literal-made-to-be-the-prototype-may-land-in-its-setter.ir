# `F.prototype = { set slot(v) { kept.push(v); } }`: what the constructor stores under `slot` is handed to the setter, which keeps it, and the object gets no property.
# The names of the literal are followed, and still the store under `prototype` lets F and its layout go, because the literal lays an accessor. With the layout goes what its field takes.
# If they stayed, `slot` would be proven filled, and `handed` of Q a number while the setter has kept the object and a text is stored there.
# G, whose literal lists a method alone and is made to be the prototype object, and R are the control. Each field has a name of its own, so no check goes by the number of a layout.
# -- source: main.js
# const kept = [];
# function F(v) { this.slot = v; }
# function G(v) { this.plain = v; }
# class Q { handed = 1; }
# class R { control = 1; }
# F.prototype = { set slot(v) { kept.push(v); } };
# G.prototype = { other: function () { return 1; } };
# new F(new Q());
# new G(new R());
# kept[0].handed = "s";
# -- end of source
