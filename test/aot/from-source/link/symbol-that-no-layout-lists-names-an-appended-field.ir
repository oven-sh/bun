# declare function report(value: unknown): void;
# const kRequest = Symbol("request");
# interface Tagged { [kRequest]: object | undefined; }
# class Socket { id = 1; }
# function attach(socket: Socket, request: object) { (socket as unknown as Tagged)[kRequest] = request; }
# function requestOf(socket: Socket) { return (socket as unknown as Tagged)[kRequest]; }
# const made = new Socket();
# attach(made, { n: 1 });
# report((requestOf(made) as any).n);
