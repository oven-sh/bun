# function make() {
#   var current = null;
#   function Item() { this.flags = 0; this.other = null; }
#   function note(item, first, second) { item.flags |= 2; item = { first: first, second: second }; return item; }
#   function visit(item) { current = item; note(current, 1, 2); return current.other; }
#   function leave() { current = null; }
#   return { Item, visit, leave };
# }
# var made = make();
# publish(made);
