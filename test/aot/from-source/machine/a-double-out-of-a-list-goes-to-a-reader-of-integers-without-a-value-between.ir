# function fold(bytes: Uint8Array): number { let c = -1; for (let i = 0; i < bytes.length; i++) c = table[(c ^ bytes[i]) & 255] ^ (c >>> 8); return (c ^ -1) >>> 0; }
# const few = [4000000000, 3000000000, , 7] as number[];
# function past(mask: number, n: number): number { let c = 1; for (let i = 0; i < n; i++) c = few[i & mask] ^ (c << 1); return c; }
# function turns(n: number): number { return Date.now() > 0 ? n : 0; }
