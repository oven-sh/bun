# A fence behind late stores of a new object. In the body of a generator, behind its first yield, a value that lives across a later yield is kept in the frame in the heap right behind its definition. A list that an operation of its own fills behind the allocation has its barrier behind the fill there; elsewhere the fence, as ever.
# The code below is what a copy in line of the library's function would give: NewArrayLike, TryFillNewArray, and the list used again behind the next yield. Nothing makes it out of a source today, so it is written by hand.
# f1 = make
# -- source: a-list-filled-behind-its-allocation-in-the-body-of-a-generator-has-its-barrier-behind-the-fill.ts
# declare function sink(...values: unknown[]): void;
# function* make(n: number, a: object) { yield 1; const made = new Array<object>(n).fill(a); yield made; }
# sink(make);
# -- end of source
# -- code
# code f1:CoroutineBody {
#   frame 0 callee=f1 callPosition=4294967295 module=m0
#   constants:
#     v5: undefined @JSValue = Undefined
#     v9: 1 @JSValue = Integer integer=1
#     v12: 2 @JSValue = Integer integer=2
#     v14: 3 @Int32 = Integer integer=3
#   b0(v0: anything?ParameterOfEscapedFunction @JSValue @51, v1: function?ParameterOfEscapedFunction @JSValue @51, v2: anything?ParameterOfEscapedFunction @JSValue @51, v3: anything?ParameterOfEscapedFunction @JSValue @51, v4: Generator @Cell @51) entry=0:
#     v6: undefined @Void = YieldBySavingFrame v4, v5, v2, v3, v0 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, maySuspend, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects] @77
#     v7: anything?UndescribedNativeResult @JSValue = ResultAt v6 @77
#     v8: int[0, 2] @Int32 = ResultAt v6 index=1 @77
#     v10: int[0, 2] @JSValue = Box v8 @77
#     v11: boolean @Boolean = StrictEq v10, v9 form=Generic @77
#     Branch v11 -> taken b1(), notTaken b2() @77
#   b1() frequency=Rare:
#     Throw v7 @77
#   b2():
#     v13: boolean @Boolean = StrictEq v10, v12 form=Generic @77
#     Branch v13 -> taken b3(), notTaken b4() @77
#   b3() frequency=Rare:
#     Return v7 @77
#   b4():
#     v15: undefined @Void = YieldBySavingFrame v4, v9, v2, v3, v0 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, maySuspend, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects] @90
#     v16: anything?UndescribedNativeResult @JSValue = ResultAt v15 @90
#     v17: int[0, 2] @Int32 = ResultAt v15 index=1 @90
#     Switch v17 cases=[1, 2] -> case b5(), case b6(), otherwise b7() @90
#   b5():
#     Throw v16 @90
#   b6():
#     Return v16 @90
#   b7():
#     v18: Array @Cell = NewArrayLike v14, v5 traits=[mayThrow, mayThrowByRule, mayCollect, mayTouchMemory] @116
#     v19: boolean @Boolean = TryFillNewArray v18, v3 traits=[mayWriteObservableState, mayTouchMemory] @116
#     v21: Array @JSValue = Box v18 @116
#     v22: undefined @Void = YieldBySavingFrame v4, v21, v2, v3, v0 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, maySuspend, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects] @142
#     v23: anything?UndescribedNativeResult @JSValue = ResultAt v22 @142
#     v24: int[0, 2] @Int32 = ResultAt v22 index=1 @142
#     Switch v24 cases=[1, 2] -> case b8(), case b9(), otherwise b10() @142
#   b8():
#     Throw v23 @142
#   b9():
#     Return v23 @142
#   b10():
#     v20: Array @JSValue = Box v18 @142
#     Return v20 @142
# }
# -- end of code
# RUN: emit-code mechanisms=all
# CHECK: unit f1:CoroutineBody
# CHECK: = Store(@[[list]], {{*}}InternalFields)
# CHECK: = Store({{*}}indexedContiguousProperties
# CHECK: = Load{{*}}(@[[list]], offset = {{*}}, collectorState
