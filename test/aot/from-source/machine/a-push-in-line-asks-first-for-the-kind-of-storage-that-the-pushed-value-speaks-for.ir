# -- source: a-push-in-line-asks-first-for-the-kind-of-storage-that-the-pushed-value-speaks-for.cjs
# function bits(n) { const out = []; for (let i = 0; i < n; i++) out.push(i & 1); return out; }
# function halves(n) { const out = []; for (let i = 0; i < n; i++) out.push(i * 0.5 + 0.25); return out; }
# function cells(n, o) { const out = []; for (let i = 0; i < n; i++) out.push(o); return out; }
# function behindOne(n) { const out = [n]; for (let i = 0; i < n; i++) out.push(i & 1); return out; }
# globalThis.keep = [bits, halves, cells, behindOne];
# -- end of source
# f1 = bits, f2 = halves, f3 = cells, f4 = behindOne
# Nothing is declared of the list. The push in line asked for the kinds of storage in one order whatever was pushed: lists of any values (9), of doubles (7), of int32s (5): a whole number ran seven instructions of questions
# and the third hit. The order follows what is known of the list, and the pushed value only where nothing is: a whole number onto a list born empty, or out of sight: lists of int32s first. Onto a list born in sight of a
# literal with elements, which is made for any values: that kind first, as before, and lists of int32s second, in line too, by the kind that is loaded once for both. A double keeps the old order: a double that is whole goes into a list as an int32, so it speaks for no kind.
# RUN: emit f1:Body mechanisms=all
# CHECK-LABEL: unit f1:Body
# CHECK: = Load8Z({{*}}JSArray_indexingTypeAndMisc)
# CHECK: = Equal({{*}}, @[[first]])
# CHECK: Int32 @[[first]] = Const32(5)
# RUN(DOUBLES): emit f2:Body mechanisms=all
# DOUBLES-LABEL: unit f2:Body
# DOUBLES: = Load8Z({{*}}JSArray_indexingTypeAndMisc)
# DOUBLES: = Equal({{*}}, @[[first]])
# DOUBLES: Int32 @[[first]] = Const32(9)
# RUN(CELLS): emit f3:Body mechanisms=all
# CELLS-LABEL: unit f3:Body
# CELLS: = Load8Z({{*}}JSArray_indexingTypeAndMisc)
# CELLS: = Equal({{*}}, @[[first]])
# CELLS: Int32 @[[first]] = Const32(9)
# RUN(BEHIND): emit f4:Body mechanisms=all
# BEHIND-LABEL: unit f4:Body
# BEHIND: Int32 @[[kind]] = Load8Z({{*}}JSArray_indexingTypeAndMisc)
# BEHIND: = Equal(@[[kind]], @[[first]])
# BEHIND: = Equal(@[[kind]], @[[second]])
# BEHIND: Int32 @[[first]] = Const32(9)
# BEHIND: Int32 @[[second]] = Const32(5)
