# This test covers the Saves at the heads (the entry blocks) of a framed part. `clear` sets up its frame late, in the branch that makes the call.
# `this` stays in a slot across the call. After the call only the slow path of the store to `#timer` reads it, as a cold operand from that slot, so the head of the branch saves it.
# Fault injection, testing=DropPatchOnlySaves: the pruning of those Saves ignores the locations that patches read, so it omits this Save and the slot is read without its value.
# The test requests no check, as in a user's build. The allocation is checked anyway, because a head omitted a Save, and the build fails with a named internal error.
# Without that check the build would succeed and the code would be wrong.
# f3 = clear
# -- source: a-save-at-a-head-that-a-cold-operand-alone-reads-and-that-is-left-out-stops-the-build-by-name.ts
# declare function sink(...values: unknown[]): void;
# declare function cancel(handle: unknown): void;
# class Sweeper {
#   #timer: unknown = null;
#   set(handle: unknown) { this.#timer = handle; }
#   clear() { if (this.#timer !== null) { cancel(this.#timer); this.#timer = null; } }
# }
# sink(Sweeper);
# -- end of source
# REQUIRES: x86_64
# AS-USERS-BUILD: the check of the allocation where a head leaves out a Save runs in every build, and under the check of the runner the allocation is checked anyway
# DIAGNOSTIC: WrongValueInSpillSlot f3
# RUN: emit f3 mechanisms=all testing=DropPatchOnlySaves
