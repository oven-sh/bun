#   fill(value: unknown) { this.a0 = value; this.a1 = value; this.a2 = value; this.a3 = value; this.a4 = value; this.a5 = value; this.a6 = value; this.a7 = value; }
#   clear() {
#     const timer = this.#timer;
#     const v0 = this.a0, v1 = this.a1, v2 = this.a2, v3 = this.a3, v4 = this.a4, v5 = this.a5, v6 = this.a6, v7 = this.a7;
#     if (timer !== null) { cancel(timer); sink(v0, v1, v2, v3, v4, v5, v6, v7); this.#timer = null; return true; }
#     return v0 === null && v1 === null && v2 === null && v3 === null && v4 === null && v5 === null && v6 === null && v7 === null;
#   }
# }
# sink(Sweeper);
# -- end of source
# REQUIRES: arm64
# AS-USERS-BUILD: the check of the slots stored at heads where a head leaves out a Save runs in every build, and under the check of the runner the allocation is checked anyway
# DIAGNOSTIC: SpillSlotLacksItsValue f4
# RUN: emit f4 mechanisms=all testing=SavesAtHeadsThatPatchesAloneReadAreLeftOut
