# The stores behind definitions. The encoder leaves out the store of a value into its slot where the allocator says that no step reads the slot. `this` waits in a slot across the call in `clear`, and the slow road of the store to `#timer` reads it out of that slot. THE LIE, testing=SpillsThatStepsReadAreTakenToBeReadByNone: the allocator says so of the slots that steps do read, so the store is left out and the slot is read without its value.
# No check is asked for here, as in a build of a user: the encoder asks at each read of a slot whether its store was left out, and the build stops by name. Without that question it would end well and the code would be wrong.
# f3 = clear
# -- source: a-slot-whose-store-is-left-out-though-it-is-read-stops-the-build-by-name.ts
# declare function sink(...values: unknown[]): void;
# declare function cancel(handle: unknown): void;
# class Sweeper {
#   #timer: unknown = null;
#   set(handle: unknown) { this.#timer = handle; }
#   clear() { if (this.#timer !== null) { cancel(this.#timer); this.#timer = null; } }
# }
# sink(Sweeper);
# -- end of source
# REQUIRES: x86_64
# AS-USERS-BUILD: the encoder's question at each read of a slot is asked in every build, and under the check of the runner the allocation is checked, which finds the same
# DIAGNOSTIC: SpillSlotLacksItsValue
# RUN: emit f3 mechanisms=all testing=SpillsThatStepsReadAreTakenToBeReadByNone
