# This test covers the stores that are omitted because no step reads their slot, on a processor that preserves many registers across a call.
# In the branch of `clear` that makes the calls, more values are needed after the calls than registers are preserved, so some stay in slots and are reloaded for the call to `sink`.
# Fault injection, testing=AssumeSpillSlotsDead: the allocator assumes that no step reads the slots that steps do read, and the encoder omits their stores.
# The test requests no check, as in a user's build. At each read of a slot the encoder checks whether the slot's store was omitted, and the build fails with a named internal error.
# Without that check the build would succeed and the code would read slots that nothing wrote.
# On x86-64 the entry of this function runs out of registers and the code has another shape. That case has its own test: a-slot-whose-store-is-left-out-though-it-is-read-stops-the-build-by-name.ir.
# f4 = clear
# -- source: a-slot-whose-store-is-left-out-though-it-is-read-where-more-values-wait-than-registers-are-kept-stops-the-build-by-name.ts
# declare function sink(...values: unknown[]): void;
# declare function cancel(handle: unknown): void;
# class Sweeper {
#   #timer: unknown = null;
#   a0: unknown = null;
#   a1: unknown = null;
#   a2: unknown = null;
#   a3: unknown = null;
#   a4: unknown = null;
#   a5: unknown = null;
#   a6: unknown = null;
#   a7: unknown = null;
#   set(handle: unknown) { this.#timer = handle; }
#   fill(value: unknown) { this.a0 = value; this.a1 = value; this.a2 = value; this.a3 = value; this.a4 = value; this.a5 = value; this.a6 = value; this.a7 = value; }
#   clear() {
#     const timer = this.#timer;
#     const v0 = this.a0, v1 = this.a1, v2 = this.a2, v3 = this.a3, v4 = this.a4, v5 = this.a5, v6 = this.a6, v7 = this.a7;
#     if (timer !== null) { cancel(timer); sink(v0, v1, v2, v3, v4, v5, v6, v7); this.#timer = null; return true; }
#     return v0 === null && v1 === null && v2 === null && v3 === null && v4 === null && v5 === null && v6 === null && v7 === null;
#   }
# }
# sink(Sweeper);
# -- end of source
# REQUIRES: arm64
# AS-USERS-BUILD: the encoder's question at each read of a slot is asked in every build, and under the check of the runner the allocation is checked, which finds the same
# DIAGNOSTIC: WrongValueInSpillSlot f4
# RUN: emit f4 mechanisms=all testing=AssumeSpillSlotsDead
