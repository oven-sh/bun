# function weigh(thing: HasV, depth: number): number {
#   if (depth > 0) return weigh(thing, depth - 1);
#   const before = thing.v;
#   thing.v = before + 1;
#   return before;
# }
# let sum = 0, behind = 0;
# for (let which = 0; which < 60; which++) { const thing = pick(which); sum += weigh(thing, 1); behind += thing.v; }
# print(sum, behind);
