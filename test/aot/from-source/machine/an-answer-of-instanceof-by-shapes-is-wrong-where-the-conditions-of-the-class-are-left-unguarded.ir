# RIGHT-NEXT: exited with 0
# RUN(WRONG): run-in-shell mechanisms=all testing=SkipClassGuards
# WRONG: 2 2
# WRONG-NEXT: exited with 0
# RUN(HELD): run-in-shell mechanisms=all testing=SkipClassGuards,CheckProofsAtRunTime
