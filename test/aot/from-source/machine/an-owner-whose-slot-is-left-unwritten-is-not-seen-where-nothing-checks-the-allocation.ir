# What the checks that run in every build do not cover. `total` calls on every way, so it sets up its frame at entry and has no framed part, and the order of its blocks is made once: in a build of a user nothing checks its allocation. THE LIE, testing=ValuesKeptForTheCollectorAreTakenToBeReadByStepsAlone, leaves out the store of `list` into the slot where the collector looks for it, and the build ends well. This file holds that down so that its twin means something: an-owner-whose-slot-is-left-unwritten-stops-the-build-by-name-where-the-order-of-blocks-was-made-again.ir stops on the same lie, and what differs is that the order was made again. A check that comes to cover such a procedure turns this file red: then it goes.
# f1 = total
# -- source: an-owner-whose-slot-is-left-unwritten-is-not-seen-where-nothing-checks-the-allocation.ts
# declare function print(value: unknown): void;
# function total(list: number[]): number { print(0); let sum = 0; for (let i = 0; i < list.length; i++) sum = (sum + list[i]) | 0; print(sum); return sum; }
# print(total([1, 2, 3]));
# -- end of source
# REQUIRES: x86_64
# AS-USERS-BUILD: the file shows what a build of a user does not check
# RUN: allocate f1 mechanisms=all testing=ValuesKeptForTheCollectorAreTakenToBeReadByStepsAlone
# CHECK: {{*}}= ArgumentReg
# CHECK-NOT: save
# CHECK: Patch
# CHECK: {{*}}isReadByNoStep
