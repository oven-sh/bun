# Where the block order of a procedure had to be computed again, its allocation, references and frame are checked in every build.
# `total` makes a call on every path, so it sets up its frame at entry and has no framed part. Nothing else requests a check of it.
# Its loop keeps a pointer into the storage of `list` across its poll, so `list` is kept for the collector in a slot that no step reads again.
# Fault injection, testing=IgnoreCollectorSpillReads: the allocator assumes that nothing reads that slot and omits its store.
# The switch testing=ForceFallbackBlockOrder orders the blocks as they are ordered the second time.
# The test requests no check, as in a user's build. The build fails with a named internal error because the block order was computed again.
# The same fault without that switch: an-owner-whose-slot-is-left-unwritten-is-not-seen-where-nothing-checks-the-allocation.ir.
# f1 = total
# -- source: an-owner-whose-slot-is-left-unwritten-stops-the-build-by-name-where-the-order-of-blocks-was-made-again.ts
# declare function print(value: unknown): void;
# function total(list: number[]): number { print(0); let sum = 0; for (let i = 0; i < list.length; i++) sum = (sum + list[i]) | 0; print(sum); return sum; }
# print(total([1, 2, 3]));
# -- end of source
# REQUIRES: x86_64
# AS-USERS-BUILD: the checks of a procedure whose order was made again run in every build, and under the check of the runner they run everywhere
# DIAGNOSTIC: InnerPointerWithoutOwner f1
# RUN: emit f1 mechanisms=all testing=ForceFallbackBlockOrder,IgnoreCollectorSpillReads
