# exec and test write lastIndex of a global or sticky pattern. A pattern that is frozen, or whose lastIndex is fixed, refuses the write inside the stub that stands for the method.
# The call of that stub names the built-in at its site, as its sisters in the same emitter do: the stack lists exec or test, and a function that left by a tail call of the method is not listed.
# RUN(SAID): run-in-shell mechanisms=all
# SAID: frozen exec,attempt test,attempt exec,keptExec test,keptTest
# SAID-NEXT: fixed exec,attempt test,attempt exec,keptExec test,keptTest
# SAID-NEXT: free ["b"] true 1 1
# SAID-NEXT: exited with 0
# RUN(HELD): run-in-shell mechanisms=all testing=CheckProofsAtRunTime
# HELD: frozen exec,attempt test,attempt exec,keptExec test,keptTest
# HELD-NEXT: fixed exec,attempt test,attempt exec,keptExec test,keptTest
# HELD-NEXT: free ["b"] true 1 1
# HELD-NEXT: exited with 0
# -- source: main.js
