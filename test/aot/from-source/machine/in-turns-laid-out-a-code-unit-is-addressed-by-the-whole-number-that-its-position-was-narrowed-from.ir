# -- source: in-turns-laid-out-a-code-unit-is-addressed-by-the-whole-number-that-its-position-was-narrowed-from.ts
# function startsOfLines(text: string): number[] { const result: number[] = []; let pos = 0; let lineStart = 0; while (pos < text.length) { const ch = text.charCodeAt(pos); pos++; switch (ch) { case 13: if (text.charCodeAt(pos) === 10) pos++; case 10: result.push(lineStart); lineStart = pos; break; default: if (ch > 127 && (ch === 0x2028 || ch === 0x2029)) { result.push(lineStart); lineStart = pos; } break; } } result.push(lineStart); return result; }
# (globalThis as any).kept = startsOfLines;
# console.log(startsOfLines("ab\r\ncd\ne").join());
# -- end of source
# f1 = startsOfLines
# `pos++` stands twice in the turn, so `pos` is counted in 64 bits; the walk narrows it to a word for the read, and the emitter extended the word again for the address. Of a phi the back end knows no range, so the
# truncation and the extension stayed: in each of the eight turns laid out the index was made in two instructions, though an address says base + counter + k in none. In turns laid out the read is addressed by the whole
# number itself, which by its own type is not negative.
# RUN(EVENT): compile CodeUnitIndexExtensionsRemoved mechanisms=all
# EVENT-NOT: statistic CodeUnitIndexExtensionsRemoved 0
# RUN(COUNT): compile UnrolledLoopsEmitted mechanisms=all
# COUNT-NOT: statistic UnrolledLoopsEmitted 0
# RUN: emit f1:Body mechanisms=all
# CHECK-LABEL: unit f1:Body
# CHECK: = Load8Z({{*}}, offset = 1, characters8
# CHECK: = Load8Z({{*}}, offset = 7, characters8
# CHECK: = Load16Z({{*}}, offset = 14, characters16
