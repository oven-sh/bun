# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: frequency=Rare
# CHECK: = BitAnd {{*}}form=Generic
# RUN(BYTES): bytes f1:Body mechanisms=all
# BYTES: BinaryOperation.BitAnd
# RUN(NEVER): bytes f1:Body mechanisms=all
# NEVER-NOT: BinaryOperation.BitAndAfterInt32Check
# RUN(MAIN): bytes f2:Body mechanisms=all
# MAIN: BinaryOperation.LessAfterInt32Check
