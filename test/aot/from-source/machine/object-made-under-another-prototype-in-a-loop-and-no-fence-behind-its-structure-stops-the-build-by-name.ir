# This test covers the fence after late stores to a new object. `fill` allocates its objects in a loop, with a prototype that is looked up at run time.
# Where that prototype is not the layout's, the structure is stored after the fence for the fields and needs a fence of its own.
# Fault injection, testing=SkipFencesAfterLateStores: the emitters omit that fence. Every build requires it, on every processor, so the build fails with a named internal error.
# Without the fault: object-made-under-another-prototype-in-a-loop-has-a-fence-behind-its-structure.ir.
# f3 = fill
# -- source: object-made-under-another-prototype-in-a-loop-and-no-fence-behind-its-structure-stops-the-build-by-name.ts
# declare function sink(...values: unknown[]): void;
# interface Mark { flags: number; name: string; who(): number }
# function MarkObject(this: Mark, flags: number, name: string) { this.flags = flags; this.name = name; }
# MarkObject.prototype.who = function () { return 2; };
# const allocator = { markConstructor: () => MarkObject as any as new (flags: number, name: string) => Mark };
# const Made = allocator.markConstructor();
# function create(flags: number, name: string): Mark { return new Made(flags, name); }
# const kept: Mark[] = [];
# for (let i = 0; i < 4; i++) kept.push(create(0, "x"));
# function fill(round: number) { for (let i = 0; i < kept.length; i++) kept[i] = create(i + round, "p"); }
# (MarkObject as any).prototype = { who() { return 2; } };
# fill(1);
# sink(kept[0].who());
# -- end of source
# DIAGNOSTIC: MissingFenceAfterLateStores
# RUN: emit f3 mechanisms=all testing=SkipFencesAfterLateStores
