# interface Stem extends Knot { part?: Part; more: number }
# interface Twig extends Knot { other: number }
# function KnotObject(this: Knot, kind: number) { this.kind = kind; this.flags = 0; }
# function make<T extends Knot>(kind: number): T { return new (KnotObject as any)(kind); }
# function makeLeaf(part: Part | undefined, open: boolean | undefined): Leaf { const leaf = make<Leaf>(1); leaf.part = part; leaf.open = open; return leaf; }
# function makeStem(part: Part | undefined): Stem { const stem = make<Stem>(2); stem.part = part; stem.more = 1; return stem; }
# function makeTwig(): Twig { const twig = make<Twig>(3); twig.other = 1; return twig; }
# function asksPart(knot: Leaf | Stem): string { if (knot.part) return "part"; return "none"; }
# function asksOpen(knot: Leaf): string { if (knot.open) return "open"; return "shut"; }
# function asLeaf(knot: Knot): Leaf | undefined { return knot.kind === 1 ? knot as Leaf : undefined; }
# sink(asksPart, asksOpen, asLeaf);
# for (let turn = 0; turn < 4; turn++) sink(makeLeaf(new Part(turn), true), makeLeaf(undefined, undefined), makeStem(undefined), makeTwig());
