# The base of the cell cage has a low half of zeros. So on x86-64 a constant of eight bits is a lea of four bytes off its register, not a move of five.
# REQUIRES: x86_64
# RUN: bytes f1 mechanisms=all-Inlining
# CHECK: unit f1:Body
# CHECK-NEXT: size=5 frame=none
# RUN(SHELL): run-in-shell mechanisms=all-Inlining
# SHELL: null,-128,127,-129,128
