# -- source: the-bits-of-two-tests-in-a-row-are-asked-at-once.ts
# declare function print(line: unknown): void;
# function kindOf(flags: number): number { flags |= 0; return flags & 1 ? 1 : flags & 6 ? 2 : flags & 8 ? 3 : flags & 48 ? 4 : flags & 64 ? 5 : 6; }
# (globalThis as any).keep = [kindOf];
# const asked: (flags: number) => number = (globalThis as any).keep[0];
# let said = "";
# for (let flags = 0; flags < 128; flags++) said += asked(flags);
# print(said);
# -- end of source
# f1 = kindOf
# `flags & A ? .. : flags & B ? .. : ..`: two tests of bits of one word that stand in a row are asked at once: `flags & (A | B)`. Where no bit of the two is set, which is one test in place of two, the
# way goes on behind both; where one is set, the first test by itself tells the two apart. No test more is written: the two masks are changed where they stand. A test that asks for two may be joined
# again: 1 | 6 | 8 = 15, 48 | 64 = 112: whoever has none of the seven bits is asked twice in place of five times.
# The answers: every word of seven bits, so each way out alone, several bits at once (the first written wins), and none.
# RUN: allocate f1:Body mechanisms=all
# CHECK-LABEL: unit f1:Body
# CHECK-NOT: BitAnd({{*}}, 8)
# CHECK-NOT: BitAnd({{*}}, 64)
# CHECK: Branch BitAnd({{*}}, 15)
# CHECK: Branch BitAnd({{*}}, 1)
# CHECK: Branch BitAnd({{*}}, 6)
# CHECK: Branch BitAnd({{*}}, 112)
# CHECK: Branch BitAnd({{*}}, 48)
# CHECK-NOT: BitAnd({{*}}, 8)
# CHECK-NOT: BitAnd({{*}}, 64)
# RUN(ANSWERS): run-in-shell
# ANSWERS: 61212121312121214121212131212121412121213121212141212121312121215121212131212121412121213121212141212121312121214121212131212121

