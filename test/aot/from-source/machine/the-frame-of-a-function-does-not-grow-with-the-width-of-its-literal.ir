# function copySixtyFour(n: RowSixtyFour, left: number): RowSixtyFour | null { return left === 0 ? null : { f0: n.f0 | 0, f1: n.f1 | 0, f2: n.f2 | 0, f3: n.f3 | 0, f4: n.f4 | 0, f5: n.f5 | 0, f6: n.f6 | 0, f7: n.f7 | 0, f8: n.f8 | 0, f9: n.f9 | 0, f10: n.f10 | 0, f11: n.f11 | 0, f12: n.f12 | 0, f13: n.f13 | 0, f14: n.f14 | 0, f15: n.f15 | 0, f16: n.f16 | 0, f17: n.f17 | 0, f18: n.f18 | 0, f19: n.f19 | 0, f20: n.f20 | 0, f21: n.f21 | 0, f22: n.f22 | 0, f23: n.f23 | 0, f24: n.f24 | 0, f25: n.f25 | 0, f26: n.f26 | 0, f27: n.f27 | 0, f28: n.f28 | 0, f29: n.f29 | 0, f30: n.f30 | 0, f31: n.f31 | 0, f32: n.f32 | 0, f33: n.f33 | 0, f34: n.f34 | 0, f35: n.f35 | 0, f36: n.f36 | 0, f37: n.f37 | 0, f38: n.f38 | 0, f39: n.f39 | 0, f40: n.f40 | 0, f41: n.f41 | 0, f42: n.f42 | 0, f43: n.f43 | 0, f44: n.f44 | 0, f45: n.f45 | 0, f46: n.f46 | 0, f47: n.f47 | 0, f48: n.f48 | 0, f49: n.f49 | 0, f50: n.f50 | 0, f51: n.f51 | 0, f52: n.f52 | 0, f53: n.f53 | 0, f54: n.f54 | 0, f55: n.f55 | 0, f56: n.f56 | 0, f57: n.f57 | 0, f58: n.f58 | 0, f59: n.f59 | 0, f60: n.f60 | 0, f61: n.f61 | 0, f62: n.f62 | 0, f63: n.f63 | 0, next: copySixtyFour(n.next!, left - 1) }; }
# sink(copyNine, copySixteen, copySixtyFour);
# -- end of source
# No more computed values of a literal wait for its birth than registers hold; the next opens the cell, and from there each value is stored as it is computed. So the frame is the same at nine,
# at sixteen and at sixty-four names. It used to be a word a name: 640 bytes at sixty-four, and a recursion of 12,000 overflowed that plain Bun runs.
# f1 = copyNine, f2 = copySixteen, f3 = copySixtyFour
# RUN: frame f1 f2 f3 mechanisms=all
# CHECK: unit f1:Body
# CHECK: size = [[frame]]
# CHECK: unit f2:Body
# CHECK: size = [[frame]]
# CHECK: unit f3:Body
# CHECK: size = [[frame]]
# RUN(BIRTH): walk f1 mechanisms=none
# BIRTH: = NewObject {{*}}fields=[0, 1, 2, 3, 4, 5, 6, 7]
# BIRTH: key="f8"
# BIRTH: key="next"
