# declare function sink(...values: unknown[]): void;
# type RowNine = { f0: number; f1: number; f2: number; f3: number; f4: number; f5: number; f6: number; f7: number; f8: number; next: RowNine | null };
# function copyNine(n: RowNine, left: number): RowNine | null { return left === 0 ? null : { f0: n.f0 | 0, f1: n.f1 | 0, f2: n.f2 | 0, f3: n.f3 | 0, f4: n.f4 | 0, f5: n.f5 | 0, f6: n.f6 | 0, f7: n.f7 | 0, f8: n.f8 | 0, next: copyNine(n.next!, left - 1) }; }
# type RowSixteen = { f0: number; f1: number; f2: number; f3: number; f4: number; f5: number; f6: number; f7: number; f8: number; f9: number; f10: number; f11: number; f12: number; f13: number; f14: number; f15: number; next: RowSixteen | null };
# function copySixteen(n: RowSixteen, left: number): RowSixteen | null { return left === 0 ? null : { f0: n.f0 | 0, f1: n.f1 | 0, f2: n.f2 | 0, f3: n.f3 | 0, f4: n.f4 | 0, f5: n.f5 | 0, f6: n.f6 | 0, f7: n.f7 | 0, f8: n.f8 | 0, f9: n.f9 | 0, f10: n.f10 | 0, f11: n.f11 | 0, f12: n.f12 | 0, f13: n.f13 | 0, f14: n.f14 | 0, f15: n.f15 | 0, next: copySixteen(n.next!, left - 1) }; }
