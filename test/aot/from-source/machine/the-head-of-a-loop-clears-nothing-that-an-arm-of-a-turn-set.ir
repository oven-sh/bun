# An arm of a turn makes a value that lives across an await of its own. The head of the loop does not know whether the last turn took the arm. What the arm set is cleared at the arm's own end, on
# the way back to the head, and not at the head in every turn: between the head's parameters and its poll nothing is set to zero (@2).
# -- source: the-head-of-a-loop-clears-nothing-that-an-arm-of-a-turn-set.cjs
# async function* turns(list, tick) { let count = 0; for (let i = 0; i < list.length; i++) { const x = list[i]; if (x > 100) { const held = { n: x }; await tick; count += held.n; continue; } yield count + x; } }
# (async () => { for await (const x of turns([1, 101, 2, 102, 103, 3], 0)) say(x); })();
# -- end of source
# RUN: emit f1:CoroutineBody mechanisms=all
# CHECK-LABEL: unit f1:CoroutineBody
# CHECK: = Phi(
# CHECK-NOT: = Store(@2, {{*}}, InternalFields)
# CHECK: MayCollect
# CHECK: = Store(@2, {{*}}, InternalFields)
# CHECK: entrypoint 1
