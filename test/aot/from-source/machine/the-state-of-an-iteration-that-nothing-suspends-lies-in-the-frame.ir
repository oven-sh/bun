# An iteration that goes by the protocol keeps three words: the iterator, its `next`, and whether it is done. The walk lays them into heap words, which is a cell with a header of 64 bytes.
# Where those words are alive at no suspension, and nothing mentions them but the reads and stores of the words themselves, they lie in a slot of the machine frame: no cell is made, no barrier follows a store,
# and what the words hold is kept alive by the scan of the stack. The slot is dead at suspensions: it is not saved with the frame.
# drain: nothing suspends at all. drainThenWait: the function suspends, behind the loop. drainAndWait: the await stands in the loop, so the words live across it: they stay in the heap.
# -- source: words.ts
# declare function sink(...values: unknown[]): void;
# function own(n: number) { return { [Symbol.iterator]() { let i = 0; return { next() { return i < n ? { done: false, value: i++ } : { done: true, value: 0 }; } }; } }; }
# function drain(n: number) { let s = 0; for (const v of own(n)) s += v; return s; }
# async function drainThenWait(n: number) { let s = 0; for (const v of own(n)) s += v; await null; return s; }
# async function drainAndWait(n: number) { let s = 0; for (const v of own(n)) { s += v; await null; } return s; }
# sink(drain(3), drainThenWait(3), drainAndWait(3));
# -- end of source
# f2 = drain, f3 = drainThenWait, f4 = drainAndWait
# RUN: walk f2 f3:CoroutineBody f4:CoroutineBody mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: = NewHeapWords numberOfWords=3
# CHECK-LABEL: code f3:CoroutineBody
# CHECK: = NewHeapWords numberOfWords=3
# CHECK-LABEL: code f4:CoroutineBody
# CHECK: = NewHeapWords numberOfWords=3
# RUN(PLAIN): frame f2 mechanisms=all
# PLAIN: slot0 at {{*}}, 24 bytes, dead at suspensions
# RUN(ELSEWHERE): frame f3:CoroutineBody mechanisms=all
# ELSEWHERE: slot0 at {{*}}, 24 bytes, dead at suspensions
# RUN(INSIDE): frame f4:CoroutineBody mechanisms=all
# INSIDE-NOT: 24 bytes
# RUN(WITHHELD): frame f2 mechanisms=all-CellsInFrames
# WITHHELD-NOT: 24 bytes
