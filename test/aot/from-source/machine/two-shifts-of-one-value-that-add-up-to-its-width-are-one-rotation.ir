# `(x << n) | (x >>> 32 - n)` is how a hash turns a word. It was mov, shl, mov, shr, or: five instructions for one.
# short: the two amounts do not add up to 32 . signed: `>>` brings in copies of the sign . other: two values: these three stay as they are written.
# -- source: two-shifts-of-one-value-that-add-up-to-its-width-are-one-rotation.ts
# declare function hidden(): number;
# declare function say(x: number): void;
# function left(n: number): number { const x = n | 0; return (x << 5) | (x >>> 27); }
# function right(n: number): number { const x = n | 0; return (x >>> 7) | (x << 25); }
# function mixed(n: number): number { const x = n | 0; return ((x >>> 2) | (x << 30)) ^ ((x >>> 13) | (x << 19)) ^ ((x << 10) ^ (x >>> 22)); }
# function short(n: number): number { const x = n | 0; return (x << 5) | (x >>> 26); }
# function signed(n: number): number { const x = n | 0; return (x << 5) | (x >> 27); }
# function other(n: number, m: number): number { const x = n | 0, y = m | 0; return (x << 5) | (y >>> 27); }
# for (let i = 0; i < 6; i++) { const x = hidden(); say(left(x)); say(right(x)); say(mixed(x)); say(short(x)); say(signed(x)); say(other(x, ~x)); }
