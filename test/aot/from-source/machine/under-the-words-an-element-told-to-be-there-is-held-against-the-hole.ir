# TAKEN: = IsElementPresent {{*}}arrayStorage=Int32
# TAKEN: @Int32 = GetArrayElement {{*}}arrayStorage=Int32
# RUN(RIGHT): run-in-shell mechanisms=all testing=CheckBoundsAtRunTime
