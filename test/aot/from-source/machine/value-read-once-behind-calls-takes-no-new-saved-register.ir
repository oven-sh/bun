# -- source: value-read-once-behind-calls.js
# function keep(a, b) { report(a); return b; }
# report(id(keep)(1, 2));
# -- end of source
# b lives across the calls and is read once, by the return. In memory it costs a store and a load. A callee-saved register that the function does not save yet costs the same two, and a move into it besides:
# it takes none, and neither does a. The twin, in which b is read twice: value-read-twice-behind-calls-takes-a-saved-register.ir
# f1 = keep
# REQUIRES: x86_64 unsanitized-code
# RUN: allocate f1:Body mechanisms=none
# CHECK-LABEL: unit f1:Body
# CHECK-NOT: usedCalleeSaves
# CHECK: needsFrameOutsideRareRegions
# RUN(RUNS): run-in-shell mechanisms=none globalThis.id = value => value; globalThis.report = value => print(String(value));
# RUNS: 1
# RUNS-NEXT: 2
# RUNS: exited with 0
