# `a` and `b` live across the yield. A turn reads `a` at its start and both again in arm after arm. No suspension can be come from between the first read of a turn and the others: each is read out
# of the frame where the turn first reads it on that way, and the name holds in every block below. So does the name of the frame's own pointer, which is read out of its slot once in a turn.
# In `twice` both names are read above an arm and again behind it: one read of each word (at 64 and 72) in the whole body.
# -- source: what-is-read-out-of-the-frame-of-a-generator-holds-in-the-blocks-below.cjs
# function* steps(a, b) { let count = 0, x = 0; for (;;) { if (a.flag ? x > b.n : x < a.n) count += b.n; else count -= a.n; if (b.flag ? x > a.n : x < b.n) count += a.n; else count -= b.n; if (a.flag ? x < b.n : x > a.n) count += a.n; else count -= b.n; x = yield count; if (x < 0) break; } }
# function* twice(a, out) { for (let x = 0;;) { out.push(a); if (x > 1) out.push(x); out.push(a); x = yield out.length; } }
# const it = steps({ n: 3, flag: true }, { n: 5, flag: false }); for (const x of [0, 4, 9, 2]) say(it.next(x).value); const list = []; const other = twice("a", list); for (const x of [0, 1, 2]) say(other.next(x).value); say(list.join());
# -- end of source
