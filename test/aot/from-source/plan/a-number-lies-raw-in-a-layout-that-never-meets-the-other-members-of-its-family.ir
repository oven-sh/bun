# -- source: main.ts
# declare function print(value: unknown): void;
# declare const given: number;
# type Length = number | `${number}%`;
# interface Size { width: number; height: number }
# interface Style { width: Length; height: Length; gap: number }
# const initial: Style = { width: 1, height: "50%", gap: 0 };
# class Box { readonly style: Style; width = 0; height = 0; constructor(style: Partial<Style>) { this.style = { ...initial, ...style }; } }
# function sizeOf(box: Box): Size { return { width: box.width * 1.5, height: box.height * 2.5 }; }
# const box = new Box({ width: given }), other = new Box({ gap: 2 });
# box.width = given / 3; box.height = given / 7;
# const size = sizeOf(box), second = sizeOf(other);
# print(size.width + size.height + second.width + second.height);
# print(box.style.width); print(other.style.height);
# -- end of source
# Partial<Style> fits whatever has a `width`, so the box, the size, the style and what the box is made of are one family, and their fields lie at the same offsets. No value is ever a box or a style, a size
# or a style: the box and the size keep their numbers raw, though the style holds texts under the same names.
