# CHECK-LABEL: layout L1 CompiledObject
# CHECK: "width" JSValue Inline
# CHECK-LABEL: layout L3 CompiledObject
# CHECK: "height" OptionalDouble Inline
# CHECK: "width" OptionalDouble Inline

