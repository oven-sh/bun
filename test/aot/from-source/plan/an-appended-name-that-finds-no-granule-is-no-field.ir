# f1 = make, f2 = fill, f3 = lay
# RUN: plan layouts mechanisms=all
# CHECK: layout L0 CompiledObject size=32 extension=520
# CHECK-NEXT: slot 0 "m0" JSValue OutOfLine offset=8 
# CHECK: slot 63 "m9" JSValue OutOfLine offset=512 
