# class Body extends Emitter { constructor(n) { super(); this.id = n; this.reset(); this.end = n; } reset() { this.force = 0; this.mass = 1; } }
# class Fiber { constructor(context) { this.setContext(context); this.id = 1; this.count = 0; } setContext(context) { this.context = context; this.cache = context; } }
# class Field { z = 1; constructor(n) { this.y = n; } }
# export function make(n) { const body = new Body(n); body.on(n); return [body, new Fiber(n), new Field(n)]; }
