# RUN: link functions mechanisms=all
# CHECK: function f2 cycle=
# CHECK: function f3 cycle=
# CHECK: function f4 closures-changed
# CHECK: function f5 closures-changed
# CHECK: function f6 closures-changed
# CHECK: function f7 closures-changed
# CHECK: function f8 closures-changed
# CHECK: function f9 closures-changed
# CHECK: function f10 closures-changed
