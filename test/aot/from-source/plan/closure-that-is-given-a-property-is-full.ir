#   const onlyRead = () => a + 1;
#   use(onlyRead.name, onlyRead.length, onlyRead.call(null), "x" in onlyRead);
#   const stored: any = () => a + 2;
#   stored.tag = 1;
#   const storedUnderSymbol: any = () => a + 3;
