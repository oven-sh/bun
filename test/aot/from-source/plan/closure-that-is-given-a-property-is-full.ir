#   const defined = () => a + 4;
#   Object.defineProperty(defined, "x", { value: 1 });
#   const copiedInto = () => a + 5;
#   Object.assign(copiedInto, { x: 1 });
#   const frozen = () => a + 6;
#   Object.freeze(frozen);
#   const movedBelow = () => a + 7;
#   Object.setPrototypeOf(movedBelow, null);
#   const deletedFrom: any = () => a + 8;
#   delete deletedFrom.name;
#   const namesItself: any = () => namesItself.tag + a;
#   namesItself.tag = 9;
