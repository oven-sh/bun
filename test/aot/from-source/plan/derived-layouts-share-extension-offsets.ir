# Two constructor functions make the objects of a tagged union. The first leaves `stage` and `paint` undefined, the second `paint` alone and lists no `stage`. `paint` is in the first granule of every member, so that one access finds it.
# -- source: granules.ts
# interface Paint { layers: number; color: string }
# interface Doll { kind: number; high: number; stage?: string[]; paint?: Paint }
# interface Queen extends Doll { kind: 1; train: Doll; pages: number }
# interface Fox extends Doll { kind: 2; tail: string }
# interface Tree extends Doll { kind: 3 }
# interface Moon extends Doll { kind: 4; face: string }
