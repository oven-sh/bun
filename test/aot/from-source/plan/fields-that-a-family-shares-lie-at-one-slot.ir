# function Pea(this: Seed, rows: number) { this.depth = rows & 3; this.rows = rows | 0; this.twin = undefined; }
# function sown(rows: number): Seed { if (rows > 4) return new (Pea as any)(rows); return new (Bean as any)(rows); }
