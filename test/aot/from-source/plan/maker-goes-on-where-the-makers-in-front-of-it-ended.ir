# -- source: maker-goes-on-where-the-makers-in-front-of-it-ended.ts
# declare function report(value: unknown): void;
# interface Stone { grams: number; vein?: number[]; day: number; cut?: string }
# interface Gem extends Stone { color?: string; facets: number }
# interface Ring extends Gem { band: Stone[] }
# interface Slab extends Stone { floor: string }
# const isVeined: boolean = (globalThis as any).isVeined;
# function Stone(this: Stone, grams: number) { this.grams = grams * 2; if (isVeined) this.vein = [grams]; }
# let days = 0;
# function dug(hours: number): Stone { let grams = 1; for (let hour = 1; hour < hours; hour++) grams += hour & 3; const stone: Stone = new (Stone as any)(grams); days = days + hours; stone.day = days; return stone; }
# function sawn(hours: number, cut: string): Stone { const stone = dug(hours); stone.cut = cut + hours; return stone; }
# function ground(facets: number): Gem { const gem = sawn(facets + 1, "g") as Gem; gem.color = undefined; gem.facets = facets; return gem; }
# function set(stones: number): Ring { const ring = ground(8) as Ring, band: Stone[] = []; while (band.length < stones) band.push(dug(2)); ring.band = band; return ring; }
# function laid(floor: string): Slab { const slab = sawn(floor.length, "s") as Slab; slab.floor = floor.toUpperCase(); return slab; }
# const ring = set(3);
# report(Object.keys(laid("hall")).join() + ring.band.length + Object.keys(ring).join() + ring.day);
# -- end of source
# `set()` stores behind `ground()`, which stores behind `sawn()`, which stores behind `dug()`, which constructs: an object has the names of all its makers, the innermost first.
# So an order of the image goes through the whole row of makers. It begins with what the layout lists, and also with what the constructor function creates ON EVERY WAY: `if (isVeined) this.vein = [grams]` creates nothing in nearly every run.
# What a maker stores on which other makers build lies in the cell, like what the constructor of a base class stores. What the last maker of a row stores only its own kind of object gets: it lies there too, since 24 + 8 x 8 bytes fit within one size class more, and narrow references make the cell 80 again.
# RUN: plan orders mechanisms=all
# CHECK: orders L0
# CHECK: order {{*}}: "grams" "vein" | "day" "cut" "floor"
# CHECK: order {{*}}: "grams" | "day" "cut" "color" "facets" "band"
# CHECK: order {{*}}: "grams" | "day" "cut" "floor"
# RUN(CELL): plan layouts mechanisms=all
# CELL: layout L0 CompiledObject
# CELL: slot 3 "cut" appended {{*}} Inline
# CELL: slot 4 "color" appended {{*}} Inline
# CELL: slot 5 "facets" appended {{*}} Inline
# CELL: slot 6 "band" appended {{*}} Inline
# CELL: slot 7 "floor" appended {{*}} Inline
