# RUN: plan layouts mechanisms=all
# CHECK: CompiledObject size=64
# CHECK-NEXT: slot 0 "add" DeferredClosure Inline
# CHECK-NEXT: slot 1 "double" DeferredClosure Inline
# CHECK-NEXT: slot 2 "halve" DeferredClosure Inline
# CHECK-NEXT: slot 3 "read" DeferredClosure Inline
# CHECK-NEXT: slot 4 "reset" DeferredClosure Inline
# CHECK-NEXT: slot 5 "subtract" DeferredClosure Inline
# CHECK-NEXT: slot 6 "x" OptionalDouble Inline
# CHECK-NEXT: slot 7 "y" OptionalDouble Inline
# CHECK-NEXT: slot 8 appended Cell32 Inline
# RUN(BOXED): plan layouts mechanisms=-TypedSlots
# BOXED: CompiledObject size=64
# BOXED-NEXT: slot 0 "add" DeferredClosure Inline offset=20
# BOXED-NEXT: slot 1 "double" DeferredClosure Inline offset=24
# BOXED: slot 6 "x" JSValue Inline
# BOXED-NEXT: slot 7 "y" JSValue Inline
# BOXED-NEXT: slot 8 appended Cell32 Inline offset=44
# BOXED-NEXT: extra-properties Cell32 Inline offset=16
# RUN(WITHHELD): plan layouts mechanisms=-Deferral
