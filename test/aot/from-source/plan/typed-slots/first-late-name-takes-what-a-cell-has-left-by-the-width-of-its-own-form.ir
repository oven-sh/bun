# RUN: plan layouts mechanisms=all
# CHECK: CompiledObject size=48
# CHECK-NEXT: slot 0 "a" OptionalCell32 Inline offset=24
# CHECK-NEXT: slot 1 "b" OptionalCell32 Inline offset=28
# CHECK-NEXT: slot 2 "c" OptionalCell32 Inline offset=32
# CHECK-NEXT: slot 3 "d" OptionalCell32 Inline offset=36
# CHECK-NEXT: slot 4 "e" OptionalCell32 Inline offset=40
# CHECK-NEXT: slot 5 "owner" appended OptionalCell32 Inline offset=44
# CHECK-NEXT: extra-properties Cell32 Inline offset=16
# RUN(WITHHELD): plan layouts mechanisms=-TypedSlots
# WITHHELD: CompiledObject size=80
# WITHHELD: slot 5 "owner" appended JSValue Inline offset=64
