# class Knot implements Tied {
#     a: Knot | null = null;
#     b: Knot | null = null;
# }
# function tie(tied: Tied, other: Knot) { tied.owner = other; tied.partner = other; tied.rival = other; }
# function countTies(tied: Tied) { return (tied.owner ? 1 : 0) + (tied.partner ? 2 : 0) + (tied.rival ? 4 : 0); }
# function count(knot: Knot) { return (knot.a ? 8 : 0) + (knot.b ? 16 : 0); }
# let sum = 0;
# let last = new Knot();
# for (let i = 0; i < 4; i++) {
