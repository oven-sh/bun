# -- source: slot-is-held-to-what-the-source-declares-where-link-holds-nothing.ts
# declare function sink(...values: unknown[]): void;
# interface Shape { tag: string | number; area: number; }
# class Circle implements Shape { tag: string; area: number; parts: number[]; next: Circle | undefined; open: any; #hidden: number; constructor(tag: string, area: number, parts: number[], next: Circle | undefined, open: any) { this.tag = tag; this.area = area; this.parts = parts; this.next = next; this.open = open; this.#hidden = area; } hidden() { return this.#hidden; } }
# class Square implements Shape { tag: number; area: number; constructor(tag: number, area: number) { this.tag = tag; this.area = area; } }
# function literal(area: number): { area: number } { return { area }; }
# function retag(shape: Shape, tag: number) { shape.tag = tag; }
# sink(Circle, Square, literal, retag);
# -- end of source
# The classes reach code that the build has not seen, which may construct with anything: Link holds nothing of the fields that the parameters fill. There a slot is held to what the source declares.
# Any type would be safe: every store is held to it, and a value that does not fit takes the field out of its slot. The form stays the widest, which has an empty state and which the closed reads find in the fewest instructions.
# A field of a class is defined as undefined in front of the body of the constructor, so the type takes undefined.
# ONLY AS FAR AS IT SPEAKS OF PRIMITIVES. `next: Circle`, `parts: number[]`: a written type says which members a value has, not which class has made it, and `any` passes every check:
# node:http's `socket: Socket` is stored an object of another class at every request, and held to the one class the field left its slot each time (fastify: 8 to 10% of a request). Which objects arrive is for the flow to see.
# `tag` lies at one slot in both members of the family, and a store through the family asks not which member it has: the two are held to one type.
# Nothing is held of `any`, of a private name, whose empty slot says that the object lacks the name, and of a literal, which fills its fields where it is made with whatever stands there.
# TODO: no slot is held to a type: held types bought nothing and cost the servers 1 to 5% (plan/AOTSlotPlan.cpp, typeHeldOfFieldForSlotPlan())
# RUN: plan layouts mechanisms=all
# CHECK: layout L0 CompiledObject
# CHECK: slot 1 "tag" JSValue Inline {{*}} type=undefined|null|number|string
# CHECK-NEXT: slot 2 "area" JSValue Inline {{*}} type=undefined|number
# CHECK-NEXT: slot 3 "parts" JSValue Inline
# CHECK-NOT: type=
# CHECK: layout L1 CompiledObject
# CHECK-NEXT: slot 0 "tag" JSValue Inline {{*}} type=undefined|null|number|string
# CHECK-NEXT: slot 1 "area" JSValue Inline {{*}} type=undefined|number
# CHECK: layout L2 CompiledObject
# CHECK-NEXT: slot 0 "area" JSValue Inline
# CHECK-NOT: type=
# CHECK: layout L3
# RUN(HELD): link held fields mechanisms=all
# HELD: field L0.2 "area" writers-known
# HELD-NOT: proven
# HELD: field L0.3
# The guard at the entry tests a parameter that is only stored, and the store through the family is typed.
# RUN(STORE): walk f2 mechanisms=all
# STORE-LABEL: code f2:Body
# STORE: b0({{*}}, [[tag]]: number @Double
# STORE: PutSlot {{*}} key="tag" receivers=[L0, L1]
# RUN(WITHHELD): plan layouts mechanisms=all-TypedSlots
# WITHHELD-NOT: type=
