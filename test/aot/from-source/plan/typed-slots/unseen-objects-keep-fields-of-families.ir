# declare function source(): any;
# class Mark { tag: string; constructor(tag: string) { this.tag = tag; } }
# class Call { kind: "call"; name: Mark; constructor(mark: Mark) { this.kind = "call"; this.name = mark; } }
# class Arrow { kind: "arrow"; name: never; constructor() { this.kind = "arrow"; this.name = undefined as never; } }
# class Above { value: string; constructor(value: string) { this.value = value; } }
# class Below extends Above { value: any = source(); }
# function nameOf(node: Call | Arrow): Mark | undefined { return node.name; }
# function rename(node: Call | Arrow) { const name = source(); if (typeof name === "object" && name) node.name = name as never; }
