# One constructor function makes the objects of three interfaces that a literal `kind` tells apart. It gives `stage` the constant undefined, the type lets the field be left out, and nothing that makes an object fills it:
# the slot is one granule of the Extension in the maker's layout and in the layout of every kind below it. `hand` is born undefined too, and the type requires it: it lies in the cell, where the maker's layout has it.
# -- source: kinds.ts
# interface Puppet { kind: number; hand: Puppet; strings: number; stage?: string[] }
# interface King extends Puppet { kind: 1; crown: string }
# interface Wolf extends Puppet { kind: 2; teeth: number }
# interface Pair extends Puppet { kind: 3; one: Puppet; other: Puppet }
# function PuppetMaker(this: Puppet, kind: number) { this.kind = kind; this.strings = kind * 4; this.hand = undefined!; this.stage = undefined; }
# const Puppet = PuppetMaker as unknown as new (kind: number) => Puppet;
# function king(gold: boolean): King { const king = new Puppet(1) as King; king.crown = gold ? "gold" : "tin"; return king; }
# function wolf(years: number): Wolf { const wolf = new Puppet(2) as Wolf; wolf.teeth = 42 - years; return wolf; }
# function pair(one: Puppet, other: Puppet): Pair { const pair = new Puppet(3) as Pair; pair.one = one; pair.other = other; one.hand = pair; other.hand = pair; return pair; }
# function plays(puppet: Puppet, scene: string): number { if (puppet.stage === undefined) puppet.stage = []; puppet.stage.push(scene); return puppet.stage.length; }
# const ruler = king(true), beast = wolf(3), both = pair(ruler, beast);
# console.log(Object.keys(both).join(), Object.keys(ruler).join(), plays(beast, "a") + plays(beast, "b"), ruler.stage === undefined, beast.teeth, ruler.hand === beast.hand);
# -- end of source
# RUN: plan layouts mechanisms=all
# CHECK: layout L0 CompiledObject
# CHECK: "hand" {{*}}Inline offset=[[hand]]
# CHECK-NEXT: "stage" JSValue OutOfLine offset=8 {{*}}may-exist-without-storage
# CHECK: layout [[king]] CompiledObject {{*}}shapes=
# CHECK: "hand" {{*}}Inline offset=[[hand]]
# CHECK-NEXT: "stage" JSValue OutOfLine offset=8 {{*}}may-exist-without-storage
# CHECK: "crown" {{*}}Inline
# CHECK: layout [[wolf]] CompiledObject {{*}}shapes=
# CHECK: "stage" JSValue OutOfLine offset=8 {{*}}may-exist-without-storage
# CHECK: "teeth" {{*}}Inline
# CHECK: layout [[pair]] CompiledObject {{*}}shapes=
# CHECK: "stage" JSValue OutOfLine offset=8 {{*}}may-exist-without-storage
# CHECK: "one" {{*}}Inline
