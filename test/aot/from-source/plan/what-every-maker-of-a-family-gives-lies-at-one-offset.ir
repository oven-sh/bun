# Two constructor functions make the objects of one family of interfaces that a literal `kind` tells apart. The first gives `stamp` between the names that both give. A smaller family inside has a name of its own, `label`, in a kind of each maker.
# What both makers give lies at one offset in both and in every kind below them, so a read off the family is one load. No cell grows.
# -- source: makers.ts
# declare function sink(...values: unknown[]): void;
# interface Base { kind: number; stamp: number; tint: number; owner: Base }
# interface Named extends Base { label: string }
# interface Num extends Base { kind: 1; value: number }
# interface Str extends Named { kind: 2; text: string }
# interface Word extends Named { kind: 3; width: number }
# interface Mark extends Base { kind: 4; sign: string }
# function BranchMaker(this: Base, kind: number) { this.kind = kind; this.stamp = 0; this.tint = 0; this.owner = undefined!; }
# function LeafMaker(this: Base, kind: number) { this.kind = kind; this.tint = 0; this.owner = undefined!; }
# const Branch = BranchMaker as unknown as new (kind: number) => Base;
# const Leaf = LeafMaker as unknown as new (kind: number) => Base;
# function num(value: number): Num { const node = new Branch(1) as Num; node.value = value; return node; }
# function str(text: string): Str { const node = new Branch(2) as Str; node.label = text; node.text = text; return node; }
# function word(label: string): Word { const node = new Leaf(3) as Word; node.label = label; node.width = 1; return node; }
# function mark(sign: string): Mark { const node = new Leaf(4) as Mark; node.sign = sign; return node; }
# function stampOf(node: Base): number { return node.stamp || (node.stamp = node.kind + 1); }
# function labelOf(node: Named): string { return node.label; }
# function top(node: Base): Base { while (node.owner) node = node.owner; return node; }
# const a = num(1), b = str("b"), c = word("c"), d = mark("d"); b.owner = a; c.owner = b; d.owner = c;
# sink(top(d) === a, stampOf(a) + stampOf(c), labelOf(b) + labelOf(c), a.tint + d.tint);
# -- end of source
# RUN: plan layouts mechanisms=all
# CHECK: layout L0 CompiledObject size=80
# CHECK-NEXT: "kind" {{*}}Inline offset=[[kind]]
# CHECK-NEXT: "stamp" {{*}}Inline offset=[[stamp]]
# CHECK-NEXT: "tint" {{*}}Inline offset=[[tint]]
# CHECK-NEXT: "owner" {{*}}Inline offset=[[owner]]
# CHECK: layout L1 CompiledObject size=80
# CHECK-NEXT: "kind" {{*}}Inline offset=[[kind]]
# CHECK-NEXT: "tint" {{*}}Inline offset=[[tint]]
# CHECK-NEXT: "owner" {{*}}Inline offset=[[owner]]
# CHECK-NEXT: "stamp" {{*}}Inline offset=[[stamp]]
