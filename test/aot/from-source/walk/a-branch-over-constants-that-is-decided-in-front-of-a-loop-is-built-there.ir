# "use strict";
# function level() { return process.env.TGM_LEVEL || "info"; }
# function direct(t) { let s = t & 1; for (let i = 0; i < 24; i++) s += (process.env.TGM_LEVEL || "info").length + i; return s; }
# function through(t) { let s = t & 1; for (let i = 24; i > 0; i--) s += level().length + i; return s; }
# globalThis.kept = [direct, through];
# console.log(direct(1), through(2));
# -- end of source
# `x || "info"` in every turn, x read in front of the loop. The truth of x stood in front too, but the branch on it stood in the turn, so what met behind it was a value of the turn: the text was made,
# asked whether it is a text and asked for its length in every turn: 12 instructions of 30. Both arms make nothing but constants, so the branch itself is built in front, the arms and their meeting
# with it, and the turn goes on without a branch. Only where the first turn is known to begin: a loop of no turn cannot pay, and one turn runs what it ran.
# RUN: compile BranchesOverConstantsBuiltInFrontOfLoops mechanisms=all
# REQUIRES: entries-of-bun
# CHECK: statistic BranchesOverConstantsBuiltInFrontOfLoops 2

