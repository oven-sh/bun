# "use strict";
# function kept(x) { let c = 0; for (let i = 0; i < 24; i++) { const isConst = x === "const"; if (isConst) c += 2; c += i; } return c; }
# globalThis.kept = kept;
# console.log(kept("const"), kept("let"), kept(5));
# -- end of source
# `const isConst = x === "const"; if (isConst) ..`: the comparison has two uses: the truth that is asked of it, and the proof on the edge of the branch, which narrows THE RESULT (to true), not what was
# compared. Whoever asked which operands the test narrows heard "not known" as soon as there was more than one use, and the comparison kept its general form: 14 instructions in every turn, where
# `if (x === "const")` stood in front of the loop. Now: the first user asks its truth, a branch alone uses that truth, and the proofs on its edges make up all the other uses: none of its operands is narrowed.
