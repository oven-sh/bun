# "use strict";
# function climb(at, word) { let sum = 0; while (at) { if (word === "const") sum += 1000; sum += at.weight; at = at.above; } return sum; }
# function turnsNotKnown(x, n) { let c = 0; for (let i = 0; i < n; i++) { if (x === "const") c += 2; c += i; } return c; }
# function turnsKnown(x) { let c = 0; for (let i = 0; i < 24; i++) { if (x === "const") c += 2; c += i; } return c; }
# globalThis.kept = [climb, turnsNotKnown, turnsKnown];
# console.log(climb({ weight: 1, above: { weight: 2 } }, "const"), turnsNotKnown("const", 3), turnsKnown("let"));
# -- end of source
# `x === "const"` in every turn, x from in front of the loop. StrictEq on a text declares that it may resolve a rope (writes, throws), so it could not leave a loop. The forms that hold a value against a
# WRITTEN text read the text alone: a rope goes into a local buffer, nothing is flattened, nothing is thrown, nothing is allocated: the answer hangs on the text alone. So the comparison is built in that
# form where it may then stand in front. THE SAID PRICE: a loop that takes no turn pays the comparison once (7 instructions), one turn 0 to 2; every further turn saves 7. No guard: a copy of the head's
# test costs 5 to 9 at every entry to spare those 7. Only what cannot fail and is as cheap as this leaves a loop whose first turn is not known.
# RUN: compile StringLiteralComparisonsHoisted mechanisms=all
# CHECK: statistic StringLiteralComparisonsHoisted 3

