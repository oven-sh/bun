# // Flags: --open-world
# const names = ["plum", "pear", "quince", "medlar", "damson", "sloe"];
# let changing = ["plum", "pear"];
# const grown = [];
# grown.push("plum", "pear");
# function overTheTable(held) { return names.some(name => held[name]); }
# function overWhatIsHandedIn(list, held) { return list.some(name => held[name]); }
# function overWhatMayBeAnotherList(held) { return changing.some(name => held[name]); }
# function found(held) { return names.find(name => held[name]); }
# function overWhatHasGrown(held) { return grown.some(name => held[name]); }
# function overAListOfItsOwn(held) { const own = ["plum", "pear"]; return own.some(name => held[name]); }
# sink(overTheTable, overWhatIsHandedIn, overWhatMayBeAnotherList, found, names, list => { changing = list; }, overWhatHasGrown, overAListOfItsOwn);
