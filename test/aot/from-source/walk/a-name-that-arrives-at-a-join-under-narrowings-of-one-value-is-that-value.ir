# -- source: a-name-that-arrives-at-a-join-under-narrowings-of-one-value-is-that-value.ts
# function startsReserved(name: string | undefined) { return (name as string).charCodeAt(0) === 95 && (name as string).charCodeAt(1) === 95 && (name as string).charCodeAt(2) !== 95; }
# (globalThis as any).kept = startsReserved;
# console.log(startsReserved("__a"), startsReserved("___"), startsReserved("a"));
# -- end of source
# f1 = startsReserved
# The guess that `name` is a text has a closed arm, which meets the typed one at every `&&`. There `name` arrives as "v0, which is a text" and as "v0, which is none": the join made a parameter for it: one value joined with
# itself, of which the join says no more than v0 says. The back end leads an edge that hands a constant truth past a join that only tests it only where the join has one parameter, so the false of `a && b` was made a word
# and tested again. The name is bound to v0: the join has the truth alone, and the next test asks v0.
# RUN(EVENT): compile NarrowedBindingsFoldedAtJoins mechanisms=all
# EVENT-NOT: statistic NarrowedBindingsFoldedAtJoins 0
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK-COUNT-2: = TypeTest v0 testedType=string
# RUN(JOIN): walk f1 mechanisms=all
# JOIN-LABEL: code f1:Body
# JOIN-NOT: @Boolean, v{{*}}: anything
