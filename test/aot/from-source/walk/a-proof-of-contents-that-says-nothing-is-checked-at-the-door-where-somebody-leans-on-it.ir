# RUN: walk f1 mechanisms=all
# CHECK: = ElemGet
# CHECK-NEXT: = CheckProof {{*}}source=ResultOfCall
# RUN(READ): walk f1 mechanisms=all
# READ-NOT: number|string|object?UnseenCode {{*}}source=Contents
