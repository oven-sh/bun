# "use strict";
# function row(given, count, first) {
#   const most = count | 0, kept = [first | 0];
#   for (let j = 1; j <= most; j++) { let least = given[j] + 1; const beside = kept[j - 1] + 2; if (beside < least) least = beside; kept[j] = least; }
#   return kept;
