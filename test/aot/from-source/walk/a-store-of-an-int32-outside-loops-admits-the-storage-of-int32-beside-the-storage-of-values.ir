# function Marks() { this.rows = []; for (var k = 0; k < 9; k++) this.rows[k] = 0; }
# Marks.prototype.mark = function (cell, bit) { this.rows[AT[cell]] |= bit; return this.depth(cell, bit); };
# Marks.prototype.depth = function (cell, bit) { return cell > 0 ? this.mark(cell - 1, bit << 1) : this.rows[0]; };
