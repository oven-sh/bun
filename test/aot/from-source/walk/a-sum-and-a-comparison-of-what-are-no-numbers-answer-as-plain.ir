# This test gives the speculation of a-sum-of-two-values-that-say-nothing-asks-both-for-numbers-where-the-turn-may-begin-again.ir operands that prove it wrong.
# The operands are strings, a string next to a number, null, BigInts, an object whose valueOf counts its calls, arrays, a boolean, NaN, -0 and a symbol.
# The first iteration restarts in the generic version. Every result is what plain Bun prints, and valueOf runs the same number of times.
# -- source: a-sum-and-a-comparison-of-what-are-no-numbers-answer-as-plain.js
# const sums = { go: (a, b) => a + b }, orders = { go: (a, b) => a < b }, names = JSON.parse('["go"]');
# const sum = sums[names[0]], less = orders[names[0]];
# let calls = 0;
# const counted = { valueOf() { calls++; return 4; } };
# function run(x, y) { let out; for (let i = 0; i < 3; i++) out = sum(x, y); return out; }
# function order(x, y) { let out; for (let i = 0; i < 3; i++) out = less(x, y); return out; }
# const pairs = [[1, 2], [0.5, "t"], ["t", 0.5], ["a", "b"], [null, undefined], [1n, 2n], [counted, 1], [[1], [2]], [true, 1], [NaN, 1], [-0, 0]];
# for (const [x, y] of pairs)
#   print(String(run(x, y)), String(order(x, y)));
# print(calls);
# try { run(Symbol("s"), 1); } catch (error) { print(error instanceof TypeError); }
# try { run(1n, 1); } catch (error) { print(error instanceof TypeError); }
# try { order(Symbol("s"), 1); } catch (error) { print(error instanceof TypeError); }
# print(order(1n, 1.5), order("10", 9), order("10", "9"));
# -- end of source
# RUN(ANSWERS): run-in-shell testing=CheckProofsAtRunTime,CheckWalkAtRunTime
# ANSWERS: 3 true
# ANSWERS: 0.5t false
# ANSWERS: t0.5 false
# ANSWERS: ab true
# ANSWERS: NaN false
# ANSWERS: 3 true
# ANSWERS: 5 false
# ANSWERS: 12 true
# ANSWERS: 2 false
# ANSWERS: NaN false
# ANSWERS: 0 false
# ANSWERS: 6
# ANSWERS: true
# ANSWERS: true
# ANSWERS: true
# ANSWERS: true false true

