# Three levels of loops, each with a sum at the first place of its head. A loop inside is walked within the typed copy of the loop around it; where its own first parameter misfits once, the mark of the loop AROUND was raised
# (the counter was looked up by the way's own head, not by the head that the edge comes round to): every typed copy was undone and the nest was slower than with no sum asked at all: 2,055 > 2,142; with the mark at its own head 1,996.
# f1 = levels
# LIBRARY: own
# -- source: main.js
# function levels(list, odd) { let s = 0; for (let a = 0; a < 2; a++) { let t = a; for (let b = 0; b < 2; b++) { let u = b * 0.5; for (let i = 0; i < list.length; i++) u = u + list[i]; t = t + u; } s = s + t; if (a) s = s + odd; } return s; }
# publish(levels);
# -- end of source
# RUN: compile SumsAskedForNumbersInFrontOfLoops LoopsWalkedAgainWithoutAskingSums mechanisms=all
# CHECK: statistic SumsAskedForNumbersInFrontOfLoops 14
# CHECK: statistic LoopsWalkedAgainWithoutAskingSums 0
# RUN(SHELL): run-in-shell globalThis.publish = (levels) => { let asked = 0; const weighs = { valueOf() { asked++; return 5; } }; const holes = [1.5, 2.5, 3.5]; delete holes[1]; const lists = () => [[1.5, 2.5, 3.5], [1, 2, 3], ["a", 2, 3], [1, "b", 3], [1, 2, "c"], [1, weighs, 3], [1, null, 3], [1, undefined, 3], holes, [], [1, 2n, 3], new Float64Array([1.5, 2.5]), "xy"]; let told = ""; for (let turn = 0; turn < 2; turn++) for (const list of lists()) { try { const got = levels(list, turn ? "7" : 2.5); told += " " + typeof got + ":" + String(got); } catch (e) { told += " " + e.constructor.name; } } print(told + " | " + asked); };
