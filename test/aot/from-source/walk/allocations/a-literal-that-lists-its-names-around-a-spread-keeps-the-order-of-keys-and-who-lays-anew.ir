# RUN(LINK): link fields
# LINK: field L
# LINK-NOT: "least" appended
# LINK-NOT: "element" appended
# RUN(ANSWERS): run-in-shell globalThis.normalize = p => p; globalThis.counted = () => { let n = 0; return { get once() { return ++n; } }; }; globalThis.hidden = () => Object.defineProperty({ seen: 1 }, "unseen", { value: 2, enumerable: false }); globalThis.withSymbol = () => ({ [Symbol("s")]: 1, t: 2 }); globalThis.throwing = () => ({ ok: 1, get bad() { throw new Error("thrown by the getter"); } });
# ANSWERS: names between: check,x,y,least | {"check":"a","x":1,"y":2,"least":3}
# ANSWERS-NEXT: the spread lays an earlier name anew: check,least | {"check":"over","least":3}
# ANSWERS-NEXT: a later name lays the spread's anew: check,least,z | {"check":"a","least":3,"z":1}
# ANSWERS-NEXT: nothing is spread: check,least | {"check":"a","least":3}
# ANSWERS-NEXT: null is spread: check,least | {"check":"a","least":3}
# ANSWERS-NEXT: indices come first: 0,1,check,x,least | {"0":"zero","1":"one","check":"a","x":1,"least":3}
# ANSWERS-NEXT: a getter is read once and laid as a value: check,once,least | {"check":"a","once":1,"least":3}
# ANSWERS-NEXT: a name that is not enumerable stays behind: check,seen,least | {"check":"a","seen":1,"least":3}
# ANSWERS-NEXT: a text is spread: 0,1,check,least | {"0":"h","1":"i","check":"a","least":3}
# ANSWERS-NEXT: the spread at the end: type,element,error | {"type":"over","element":7,"error":"bad"}
# ANSWERS-NEXT: an own __proto__: check,__proto__,least | true | 5
# ANSWERS-NEXT: a symbol: 1 | 4
# ANSWERS-NEXT: in order: first,middle,last | {"first":"first","middle":1,"last":"last"}
# ANSWERS-NEXT: a getter that throws: threw | {"threw":"thrown by the getter"}
# ANSWERS-NEXT: first,last,first
# ANSWERS-NEXT: deleted and laid again: check,x,least | {"check":"a","x":1,"least":4}
# ANSWERS-NEXT: an accessor over a listed name: check,x,least | {"check":"got","x":1,"least":4}
# ANSWERS-NEXT: true true false
# ANSWERS-NEXT: exited with 0
