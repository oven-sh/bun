# LIBRARY: own
# RUN: run-in-shell mechanisms=all globalThis.id = value => value;
# CHECK: Int32 1,2,3
# CHECK-NEXT: Int32 1,2,3
# CHECK-NEXT: Int32 1,2,3
# CHECK-NEXT: Double 1.5,2,3
# CHECK-NEXT: Double 1.5,2
