# CHECK-NEXT: Contiguous 1,b
# CHECK-NEXT: Contiguous 0.5,NaN
# CHECK-NEXT: 0,2,3,c,0.5 -Infinity
# CHECK-NEXT: 0,2,3,c,0.5 -Infinity
