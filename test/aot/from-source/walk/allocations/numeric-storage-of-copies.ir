# CHECK-NEXT: 0,2,3,c,0.5 -Infinity
# CHECK-NEXT: 0,2,c,0.5 -Infinity
# CHECK-NEXT: 0,1,c,0.5 -Infinity
# CHECK-NEXT: 0,b,c,0.5 -Infinity
