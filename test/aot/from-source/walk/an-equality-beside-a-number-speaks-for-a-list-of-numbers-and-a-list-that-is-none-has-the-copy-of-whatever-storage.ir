# "use strict";
# const list = JSON.parse("[0.5, 1.5, 2.5, 3.5]"), rows = JSON.parse("[null, 0, true, 1]");
# function unlike(l, x) { let c = 0; for (let i = 0; i < l.length; i++) if (l[i] !== x) c++; return c; }
# function f(t) { return unlike(list, t & 3) + unlike(rows, t & 1); }
# console.log(f(1), f(2));
# -- end of source
# Every caller of the function that counts by !== is in sight, so its parameter is known to be a list and the loop tells nothing apart in front. Nothing is known of the contents; the needle is a number. A relation beside a number spoke for a list of numbers, an equality
# did not: every element was read boxed out of whatever storage. An equality is weaker evidence: so the list is asked for storage of numbers, and a list that has none goes to a second quick copy that
# reads whatever storage, the copy that stood there before: a guess that fails costs one test. Where no second copy can be bought the guess is not made. Not in a loop that stands in another.
# f1 = unlike, f2 = f
