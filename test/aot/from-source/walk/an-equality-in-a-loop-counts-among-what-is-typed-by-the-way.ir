# class Knot { above: Knot | Bead | undefined; mark: number; constructor(above: Knot | Bead | undefined, mark: number) { this.above = above; this.mark = mark; } }
# class Bead { mark: number; tint = "red"; above: Knot | Bead | undefined; constructor(above: Knot | Bead | undefined, mark: number) { this.mark = mark; this.above = above; } }
# type Link = Knot | Bead;
# function isBelow(knot: Link | undefined, top: Link): boolean { while (knot) { if (knot === top) return true; knot = knot.above; } return false; }
# (globalThis as any).kept = isBelow;
