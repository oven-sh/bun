# const bytes = new Uint8Array(16); for (let i = 0; i < 16; i++) bytes[i] = i * 3;
# const withOwnIterator: any = new Uint8Array(4);
# function copyOfPart(): number { const part = bytes.slice(2, 6); let sum = 0; for (let i = 0; i < part.length; i++) sum += part[i]!; return sum; }
# function whatFromMakes(): number { const made = Uint16Array.from(bytes); let sum = 0; for (let i = 0; i < made.length; i++) sum += made[i]!; return sum; }
# function copyOfOther(): number { return withOwnIterator.slice(1, 3).length; }
# function fromOwnIterator(): string { return Uint16Array.from(withOwnIterator).join(); }
# const said: unknown[] = [copyOfPart(), whatFromMakes(), copyOfOther(), fromOwnIterator()];
# withOwnIterator[Symbol.iterator] = function* () { yield 5; yield 6; };
# said.push(copyOfPart(), whatFromMakes(), copyOfOther(), fromOwnIterator());
# sink(said.join(" | "));
