# declare function sink(...values: unknown[]): void;
# function* count(n: number): Generator<number, string, number | undefined> { let sum = 0; for (let i = 0; i < n; i++) sum += (yield i) ?? 0; return "sum " + sum; }
# function drive(walk: Generator<number, string, number | undefined>) { let n = 0; while (!walk.next(1).done) n++; return n; }
# let k = 0; const other = { next() { return { value: k, done: k++ > 2 }; } } as any;
# sink(drive(count(4)), drive(other));
