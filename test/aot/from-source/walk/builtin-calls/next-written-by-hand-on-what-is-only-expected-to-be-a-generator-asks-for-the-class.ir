# f1 = count, f2 = drive
# RUN: walk f2 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: b0([[walk]]: L{{*}}|Generator 
# CHECK: [[is]]: {{*}} = TypeTest [[walk]] testedType=Generator
# CHECK: [[generator]]: {{*}} = Narrowed [[walk]], [[is]]
# CHECK: = IsUnmodifiedGenerator [[generator]]
# CHECK: = StepGenerator [[generator]], {{*}}check=IsUnmodified
# RUN(NONE): walk f2 mechanisms=all
# NONE-NOT: = NewObject
