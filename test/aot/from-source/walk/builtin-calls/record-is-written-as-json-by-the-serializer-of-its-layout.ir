# outside a loop the site of JSON.stringify(row) is a builder, one test of the shape, a call of the serializer of the layout and the string. Whatever a test turns away gives the builder back and runs the call as written, in a rare block
# a replacer, a list of names and an indent are left to the call as written, and so is the body of a module, which runs once
# f1 = save, f2 = pick, f3 = replace, f4 = pretty
# -- source: record-is-written-as-json-by-the-serializer-of-its-layout.ts
# declare function sink(...values: unknown[]): void;
# type Row = { id: number; name: string; ok: boolean; score: number; tag: string; note: string };
# function save(row: Row) { return JSON.stringify(row); }
# function pick(row: Row) { return JSON.stringify(row, ["id"]); }
# function replace(row: Row, replacer: (key: string, value: unknown) => unknown) { return JSON.stringify(row, replacer); }
# function pretty(row: Row) { return JSON.stringify(row, null, 2); }
# const first: Row = { id: 1, name: "a", ok: true, score: 1.5, tag: "t", note: "n" };
# sink(save, pick, replace, pretty, first, save(first), save(first), JSON.stringify(first));
# -- end of source
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = StringBuilderBegin
# RUN(SHAPE): walk f1 mechanisms=all
# SHAPE: = ShapeTest
# RUN(CALLS): walk f1 mechanisms=all
# CALLS: = JSONAppendObject
# RUN(FINISHES): walk f1 mechanisms=all
# FINISHES: = StringBuilderFinish
# RUN(SLOW): walk f1 mechanisms=all
# SLOW: frequency=Rare
# SLOW: StringBuilderDiscard
# SLOW: = CallBuiltin
# RUN(FEWEST): walk f1 mechanisms=none+TypedOperations+Guesses+DirectCalls+BuiltinCalls
# FEWEST: = JSONAppendObject
# RUN(MEMBERS): walk f1 mechanisms=all
# MEMBERS-NOT: JSONAppendKey
# RUN(LIST): walk f2 mechanisms=all
# LIST-NOT: StringBuilderBegin
# RUN(REPLACER): walk f3 mechanisms=all
# REPLACER-NOT: StringBuilderBegin
# RUN(INDENT): walk f4 mechanisms=all
# INDENT-NOT: StringBuilderBegin
# RUN(ONCE): walk f0 mechanisms=all
