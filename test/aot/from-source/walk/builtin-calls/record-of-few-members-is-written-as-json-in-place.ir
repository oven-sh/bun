# a record of few members is written where the call stands, behind a look at its cell and a test of the order of its keys. In a loop the members of a longer record are written out too
# of a literal that is made for the call everything is known: no test, no rare block, one reservation. The brace or the comma, the quoted name and the colon are one constant, and an integer is written without the way through a double
# f1 = point, f2 = rows, f3 = tag
# -- source: record-of-few-members-is-written-as-json-in-place.ts
# declare function sink(...values: unknown[]): void;
# type Point = { x: number; label: string; on: boolean };
# type Row = { id: number; name: string; ok: boolean; score: number; tag: string; note: string };
# function point(p: Point) { return JSON.stringify(p); }
# function rows(row: Row, n: number) { let length = 0; for (let i = 0; i < n; i++) length += JSON.stringify(row).length; return length; }
# function tag(id: number, name: string) { return JSON.stringify({ id: id | 0, name: "n" + name, on: true }); }
# const p: Point = { x: 1, label: "a", on: true };
# const row: Row = { id: 1, name: "a", ok: true, score: 1.5, tag: "t", note: "n" };
# sink(point, rows, tag, p, row, point(p), point(p), rows(row, 2), rows(row, 3));
# -- end of source
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = StringBuilderBegin
# RUN(LOOKS): walk f1 mechanisms=all
# LOOKS: = HasNoExtraProperties
# RUN(ORDER): walk f1 mechanisms=all
# ORDER: = HasKeyOrder
# RUN(KEYS): walk f1 mechanisms=all
# KEYS: = StringBuilderReserve
# KEYS: = JSONAppendKey
# RUN(DROPS): walk f1 mechanisms=all
# DROPS: StringBuilderDiscard
# RUN(CALLS): walk f1 mechanisms=all
# CALLS-NOT: JSONAppendObject
# RUN(LOOP): walk f2 mechanisms=all
# LOOP: = JSONAppendKey
# RUN(LITERAL): walk f3 mechanisms=all
# LITERAL-LABEL: code f3:Body
# LITERAL: = StringBuilderReserve
# LITERAL: = JSONAppendKey {{*}}opensObject
# LITERAL: = JSONAppendInteger
# LITERAL: = JSONAppendKey {{*}}followsMember
# LITERAL: = JSONAppendString
# LITERAL: = JSONAppendBoolean
# LITERAL: = JSONAppendToken {{*}}jsonToken=CloseObject
# LITERAL: StringBuilderCommit
# LITERAL: = StringBuilderFinish
# RUN(ONE): walk f3 mechanisms=all
# ONE-COUNT-1: = StringBuilderReserve
# RUN(SURE): walk f3 mechanisms=all
# SURE-NOT: StringBuilderDiscard
# RUN(WHOLE): walk f3 mechanisms=all
# WHOLE-NOT: JSONAppendNumber
