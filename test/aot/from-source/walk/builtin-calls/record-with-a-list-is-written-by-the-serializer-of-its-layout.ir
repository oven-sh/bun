# a record that holds a list is written by the serializer of its layout, which walks the list by a loop: the site calls it and writes no member out. A record without a list, of few members, is written out at the site as ever
# each function is handed to code that nobody has seen
# f1 = listed, f2 = flat
# -- source: record-with-a-list-is-written-by-the-serializer-of-its-layout.ts
# declare function sink(...values: unknown[]): void;
# function listed(value: { ok: boolean; items: number[] }, n: number) { let length = 0; for (let i = 0; i < n; i++) length += JSON.stringify(value).length; return length; }
# function flat(value: { ok: boolean; total: number }, n: number) { let length = 0; for (let i = 0; i < n; i++) length += JSON.stringify(value).length; return length; }
# sink(listed, flat, listed({ ok: true, items: [1] }, 2), flat({ ok: true, total: 1 }, 2));
# -- end of source
# RUN: walk f1 mechanisms=all-ParameterGuards-LoopInvariants
# CHECK-LABEL: code f1:Body
# CHECK: = StringBuilderBegin
# CHECK: = JSONAppendObject
# RUN(FLAT): walk f2 mechanisms=all-ParameterGuards-LoopInvariants
# FLAT: = StringBuilderBegin
# FLAT-NOT: JSONAppendObject
