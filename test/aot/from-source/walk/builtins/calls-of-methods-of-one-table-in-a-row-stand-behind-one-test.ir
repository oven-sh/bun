# RUN(ADD): walk f1 mechanisms=all
# ADD: = IsSlotFilled {{*}}key="name"
# ADD: inlineBuiltin=MapSet
# RUN(COUNT): compile CollectionCallRunsGuardedOnce DuplicateCollectionStoresRemoved mechanisms=all
# COUNT: statistic CollectionCallRunsGuardedOnce 1
# COUNT-NOT: statistic DuplicateCollectionStoresRemoved 0
