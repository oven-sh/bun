# -- source: main.cjs
# "use strict";
# const lib = {}; (function (exports) { function add(a, b) { return a + b; } exports.add = add; })(lib);
# const T = { go(t, n) { let s = t & 7; for (let i = 0; i < n; i++) s = lib.add(s, i); return s; } };
# const k0 = JSON.parse('"go"'); function f(t) { return T[k0](t, JSON.parse("22000")) & 1023; }
# sink(f);
# -- end of source
# What a UMD file does: `exports.add = add` in a factory, so `lib.add` is proven undefined|add. The call as written, in the arm where the slot is empty, is heard as a call: the loop is bought twice,
# the slot is read and tested in front of the typed copy, and no turn of that copy tests anything. With the effects of a throw alone on the first walk the turns were quiet, nothing was bought,
# and every turn branched on the hoisted test: 55,100 > 115,600 instructions for 22,000 turns.
# The bound is asked in front as well. A loop whose bound is written and whose sum is proven asks nothing but the callee and is not bought yet.
# f3 = go
# RUN: walk f3 mechanisms=all
# CHECK-LABEL: code f3:Body
# CHECK: isLoopHead=true:
# CHECK: Call {{*}}calleeName="lib.add"
# CHECK: [[inFront]]: undefined|f4 @JSValue = GetSlotOrUndefined {{*}}key="add"
# CHECK: [[test]]: boolean @Boolean = TypeTest [[inFront]] testedType=f4
# CHECK: Branch [[test]]
# CHECK: isInLoop=true isLoopHead=true:
# CHECK-NOT: TypeTest
# CHECK: Return
# RUN(ANSWERS): run-in-shell globalThis.sink = f => { print(f(1)); print(f(2)); };
# ANSWERS: 393
# ANSWERS-NEXT: 394
# ANSWERS-NEXT: exited with 0
