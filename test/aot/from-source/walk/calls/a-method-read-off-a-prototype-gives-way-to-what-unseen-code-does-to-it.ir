# The method that `F.prototype.m.call(x, ..)` reads is a constant behind its guards. Code that nobody sees replaces the member, lays an accessor under the name, a bound function, a `call` of its own on the function, a whole new prototype object,
# deletes the member and lays another object above; a class beside the constructor function; an async callee. As plain.
# RUN(ANSWERS): run-in-shell globalThis.register = (B, K) => { const first = B.prototype.on, kind = K.prototype.on, whole = B.prototype; globalThis.change = step => { switch (step) { case 1: B.prototype.on = function other(ev) { this.count += 10; return "replaced"; }; K.prototype.on = function otherKind(ev) { this.count += 10; return "replaced kind"; }; return "a member replaced late"; case 2: Object.defineProperty(B.prototype, "on", { get() { return function got(ev) { this.count += 100; return "got"; }; }, configurable: true }); return "an accessor under the name"; case 3: delete B.prototype.on; B.prototype.on = first.bind({ count: 0 }); K.prototype.on = kind; return "a bound function under the name"; case 4: B.prototype.on = first; first.call = function () { return "own call"; }; return "call overridden on the function"; case 5: delete first.call; return "call as it was"; case 6: B.prototype = { on(ev) { this.count += 1000; return "whole"; } }; return "prototype laid anew, whole"; case 7: B.prototype = whole; delete B.prototype.on; Object.setPrototypeOf(B.prototype, { on(ev) { this.count += 7; return "from above"; } }); return "the member deleted, another object laid above"; default: Object.setPrototypeOf(B.prototype, Object.prototype); B.prototype.on = first; return "as written again"; } }; };
