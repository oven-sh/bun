# RUN(ANSWERS): run-in-shell globalThis.register = (...all) => { globalThis.deed = k => { const F = all[k], first = F.prototype.on; switch (k) { case 0: F.prototype.on = function other(ev) { this.count += 10; return "replaced"; }; return "the member replaced"; case 1: Object.defineProperty(F.prototype, "on", { get() { return function got(ev) { this.count += 100; return "got"; }; }, configurable: true }); return "an accessor under the name"; case 2: F.prototype.on = first.bind({ count: 0 }); return "a bound function under the name"; case 3: first.call = function () { return "own call"; }; return "a call of its own on the function"; case 4: F.prototype = { on(ev) { this.count += 1000; return "whole"; } }; return "the prototype laid anew, whole"; case 5: delete F.prototype.on; return "the member deleted"; case 6: delete F.prototype.on; Object.setPrototypeOf(F.prototype, { on(ev) { this.count += 7; return "from above"; } }); return "the member deleted, another object laid above"; default: Object.defineProperty(F.prototype, "on", { value: function laid(ev) { this.count += 5; return "laid"; } }); return "a class's member defined anew"; } }; };
