# function add(out: Float64Array, a: Float64Array, b: Float64Array): Float64Array { out[0] = a[0]! + b[0]!; out[1] = a[1]! + b[1]!; return out; }
# function dot(a: Float64Array, b: Float64Array): number { return a[0]! * b[0]! + a[1]! * b[1]!; }
# const N: any = {}; N.add = add; N.dot = dot;
# const o = new Float64Array(2), p = new Float64Array([1.5, 2.5]), q = new Float64Array([0.5, 0.25]);
# function f(t: number): number { p[0] = t & 7; let s = 0; for (let i = 0; i < 100; i++) { N.add(o, p, q); s += N.dot(o, p); } return s; }
# sink(f);
