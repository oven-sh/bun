# RUN: walk f1:SlowBody mechanisms=all
# CHECK-LABEL: code f1:SlowBody
# CHECK: = PropGet {{*}}key=symbol("hidden")
# RUN(STORE): walk f2:SlowBody mechanisms=all
# STORE-LABEL: code f2:SlowBody
# STORE: = PropSet {{*}}key=symbol("hidden")
# RUN(NEVER): walk f1:SlowBody mechanisms=all
# NEVER-NOT: = ElemGet
# RUN(CLOSED): walk f1:Body mechanisms=all testing=ForceWalkMode:Closed
# CLOSED-LABEL: code f1:Body
