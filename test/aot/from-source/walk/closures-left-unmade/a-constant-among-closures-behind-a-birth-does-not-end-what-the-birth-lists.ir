# function makeDial(start: number): Dial { let at = start; return { first: () => ++at, second: () => at + 1, third: () => at + 2, fourth: () => at + 3, fifth: () => at + 4, sixth: () => at + 5, seventh: () => at + 6, eighth: () => at + 7, ninth: () => at + 8, tenth: () => at + 9, step: 1, eleventh: () => at + 10, twelfth: () => at + 11 }; }
