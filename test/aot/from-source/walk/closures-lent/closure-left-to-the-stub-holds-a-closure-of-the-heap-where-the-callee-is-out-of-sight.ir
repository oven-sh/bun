# Nothing is known of `bus`. The arrow of `go` captures `f`, is written into the frame, and the stub of the call asks the word of whatever the name finds. `twice` only calls its first argument: the arrow stays where it is. `keep` does not: the stub moves the arrow. What the arrow holds lies in the heap from the start: the arrow goes to a callee out of sight, so `f` does not count as only called and `maker` makes its arrow in the heap.
# f2 = twice, f3 = keep, f1 = go, f4 = maker
# -- source: closure-left-to-the-stub-holds-a-closure-of-the-heap-where-the-callee-is-out-of-sight.ts
# declare function publish(...values: unknown[]): void;
# let held: (() => number) | undefined;
# function twice(job: () => number): number { return job() + job(); }
# function keep(job: () => number): number { held = job; return 1; }
# function go(bus: any, f: () => number): number { const t = bus.run(() => f() + 1); return t + 1; }
# function maker(bus: any, k: number): number { const t = go(bus, () => k); return t + 1; }
# publish(maker, twice, keep, () => held);
# -- end of source
# RUN: bytes f1 mechanisms=all-Inlining
# CHECK: CallMethod{{*}}Lending.First count 1
# RUN(NEVER): bytes f1 mechanisms=all-Inlining
# NEVER-NOT: NewSlimClosure.
# RUN(ASKED): bytes f1 mechanisms=all-Inlining
# ASKED-NOT: operationAOTMoveClosureToHeap
# RUN(MAKER): bytes f4 mechanisms=all-Inlining
# MAKER: NewSlimClosure.Plain
# RUN(SHELL): run-in-shell globalThis.publish = (maker, twice, keep, held) => { const calls = { run: twice }, keeps = { run: keep }, foreign = { run(job) { this.job = job; return job(); } }; print(maker(calls, 2), maker(keeps, 3), held()(), maker(calls, 4), held()(), maker(keeps, 5), held()()); print(maker(foreign, 6), foreign.job(), maker(foreign, 7), foreign.job()); const seen = new Set(); let sum = 0; for (let i = 0; i < 300; i++) { sum += maker(i % 2 ? calls : keeps, i); seen.add(held()); if (i % 50 === 49) gc(); } print(sum, held()(), seen.size); let wrong = 0, at = 0; for (const job of seen) { if (job() !== at + 1) wrong++; at += 2; } print(wrong); };
# SHELL: 8 3 4 12 4 3 6
# SHELL-NEXT: 9 7 10 8
# SHELL-NEXT: 46050 299 150
# SHELL-NEXT: 0
