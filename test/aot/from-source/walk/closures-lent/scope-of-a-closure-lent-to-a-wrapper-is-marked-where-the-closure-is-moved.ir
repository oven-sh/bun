# `later` captures what arrives in an arrow that `push` takes, out of sight: `f` does not count as only called, so the arrow of `counter` is made in the heap and keeps the scope of `n`: the cell is never handed back.
# `plain` lends to `twice`, which captures nothing: its cell is the next call's.
# f1 = later, f2 = twice, f3 = counter, f4 = plain
# -- source: scope-of-a-closure-lent-to-a-wrapper-is-marked-where-the-closure-is-moved.ts
# declare function print(...values: unknown[]): void;
# const kept: (() => number)[] = [];
# function later(f: () => number): number { kept.push(() => f()); return 1; }
# function twice(f: () => number): number { const t = f() + f(); return t; }
# function counter(start: number): number { let n = start; const t = later(() => ++n); return t + n; }
# function plain(start: number): number { let n = start; const t = twice(() => ++n); return t + n; }
# print(counter(10), counter(20), kept[0](), kept[1](), kept[0](), plain(1), counter(30), plain(2), kept[0](), kept[1](), kept[2]());
# -- end of source
