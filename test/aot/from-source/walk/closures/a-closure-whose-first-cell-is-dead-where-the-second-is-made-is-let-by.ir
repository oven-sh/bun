# function run(sources: Array<{ x: number; y: number }>): string { const said: Array<number | boolean> = []; for (let i = 0; i < sources.length; i++) { said.push(i); const made = { tag: i, ...sources[i], read: function self(): unknown { return self; } }; said.push(made.read() === made.read, made.read.name === "self"); } return said.join(" "); }
