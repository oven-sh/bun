# `new Node(kind, -1, -1)` of a constructor function whose body is copied: the allocation lists what the head of the body stores out of arguments and written constants, in the order of the stores, and no store is left
# the objects leave, so whoever gets one may lay a setter above them, or give the constructor another prototype: the guards in front of the allocation say both, and where they fail the construction as written makes a cell of its own
# f1 = Node, f2 = make
# -- source: allocation-lists-what-the-head-of-a-copied-constructor-function-stores.ts
# declare function sink(...values: unknown[]): void;
# function Node(this: any, kind: number, pos: number, end: number) { this.pos = pos; this.end = end; this.kind = kind; this.id = 0; this.flags = 0; this.parent = undefined; }
# function make(kind: number) { return new (Node as any)(kind, -1, -1); }
# sink(make);
# -- end of source
# RUN: walk f2 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: = NewObject {{*}}fields=[0, 1, 2, 3, 4, 5]
# RUN(FEWEST): walk f2 mechanisms=none+TypedOperations+Folding+EscapeAnalysis+DirectCalls+Inlining+Guesses
# FEWEST-LABEL: code f2:Body
# FEWEST: = NewObject {{*}}fields=[0, 1, 2, 3, 4, 5]
# RUN(NEVER): walk f2 mechanisms=all
# NEVER-NOT: PutSlot
# NEVER-NOT: TryFinishBirth
# the guards are asked in front of the allocation, nothing is asked of the cell, and on the failing way the construction stays as it is written
# RUN(LOOKS): walk f2 mechanisms=all
# LOOKS-LABEL: code f2:Body
# LOOKS: = AreMembersUnchanged
# LOOKS: = NewObject {{*}}fields=[
# LOOKS-NOT: = HasLayoutPrototype
# LOOKS: = Construct {{*}}calleeName="Node"
