# -- source: scope-is-made-on-the-rare-way-alone-where-a-call-borrows-the-arrow.ts
# declare function report(value: unknown): void;
# interface Row { id: number; name: string; }
# function forEach<T>(list: T[], f: (x: T) => void): void { for (let i = 0; i < list.length; i++) f(list[i]); }
# function total(rows: Row[]): number { let sum = 0; forEach(rows, row => { sum += row.id; }); return sum; }
# function totalThroughUnknown(rows: Row[], each: any): number { let sum = 0; each(rows, (row: Row) => { sum += row.id; }); return sum; }
# function totalCaught(rows: Row[]): number { let sum = 0; try { forEach(rows, row => { if (row.id > 5) throw new Error("over"); sum += row.id; }); } catch { return -sum; } return sum; }
# (globalThis as any).fns = { total, totalThroughUnknown, totalCaught, forEach };
# const rows: Row[] = [];
# for (let i = 0; i < 12; i++) rows.push({ id: i, name: "row" + i });
# report((globalThis as any).fns.total(rows) + 1);
# report((globalThis as any).fns.total(rows) + 1);
# report((globalThis as any).fns.totalThroughUnknown(rows, (globalThis as any).fns.forEach) + 1);
# report((globalThis as any).fns.totalThroughUnknown(rows, (globalThis as any).fns.forEach) + 1);
# report((globalThis as any).fns.totalCaught(rows) + 1);
# report((globalThis as any).fns.totalCaught(rows) + 1);
