# -- source: under-the-word-the-range-that-a-fold-rests-on-is-held-against-the-number.ts
# declare function print(...values: unknown[]): void;
# const given: number[] = JSON.parse("[1,3,3,3,5,2]");
# function pick(x: number, n: number): string { const i = x & 7, bound = n & 3; if (i < bound) { if (i < 3) return "low"; return "high"; } return "out"; }
# function bits(x: number, n: number): number { const i = (x & 7) - 1, bound = n & 3; if (0 <= i) { if (i < bound) return (i >>> 0) + 1; } return -1; }
# print(pick(given[0], given[1]), pick(given[2], given[3]), pick(given[4], given[5]), bits(given[0], given[1]), bits(given[2], given[3]));
# -- end of source
# f1 = pick, f2 = bits. Behind `i < bound`, bound from 0 to 3, the walk tells int[0, 2] of i, and `i < 3` is folded: no test, no other arm. In f2 `i >>> 0` hands i on, for it lies from 0 to 2.
# i is a raw int32. The value after the test is not boxed, so the switch that checks proofs (testing=CheckProofsAtRunTime, which --aot-harden=proof-checks enables) used to check nothing about it.
# A false range silently gave the other branch. Now the range is checked against the number where the fold is made. A default build checks nothing.
# RUN(HELD): walk f1 f2 mechanisms=all testing=CheckProofsAtRunTime
# HELD-LABEL: code f1:Body
# HELD: = Narrowed
# HELD: CheckProof {{*}}checkedType=int[0, 2] typeWithoutProof=i32 source=Test
# HELD-LABEL: code f2:Body
# HELD: CheckProof {{*}}checkedType=int[0, 2] typeWithoutProof=i32 source=Test
# RUN(PLAIN): walk f1 f2 mechanisms=all
# PLAIN-NOT: source=Test
# RUN(RIGHT): run-in-shell mechanisms=all testing=CheckProofsAtRunTime
# RIGHT: low out out 1 3
# RIGHT-NEXT: exited with 0
# Fault injection, testing=TreatEqualIntegersAsLess: the code generator compiles `<` of two integers as `<=`.
# So 3 passes `i < bound` with a bound of 3, and the fold silently decides the result for it.
# RUN(LIE): run-in-shell mechanisms=all testing=TreatEqualIntegersAsLess
# LIE: low low out
# RUN(STOPPED): run-in-shell mechanisms=all testing=CheckProofsAtRunTime,TreatEqualIntegersAsLess
# STOPPED: bun: internal AOT error: type check failed
# STOPPED-NEXT: in a value narrowed by a branch
# STOPPED-NOT: low low
# STOPPED: crashed with
