# const given: number[] = JSON.parse("[1,3,3,3,5,2]");
# function pick(x: number, n: number): string { const i = x & 7, bound = n & 3; if (i < bound) { if (i < 3) return "low"; return "high"; } return "out"; }
# function bits(x: number, n: number): number { const i = (x & 7) - 1, bound = n & 3; if (0 <= i) { if (i < bound) return (i >>> 0) + 1; } return -1; }
# print(pick(given[0], given[1]), pick(given[2], given[3]), pick(given[4], given[5]), bits(given[0], given[1]), bits(given[2], given[3]));
