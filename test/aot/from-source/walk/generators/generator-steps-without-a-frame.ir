# The step of a generator of numbers that goes from its yield round to its yield by arithmetic alone is a leaf: it runs on the words of the heap frame and makes no machine frame. Other ways give way to the resumption.
# f2 = count . f3 = halves . f4 = calls (no leaf: it calls) . f5 = sent (no leaf: it looks at what is sent)
# -- source: main.cjs
# "use strict";
# function* count(from, to) { for (let i = from; i <= to; i++) yield i; }
# function* halves(from, to, by) { for (let i = from / 2; i < to; i += by) yield i; }
# function* calls(from, to) { for (let i = from; i <= to; i++) { list([i]); yield i; } }
# function* sent(from, to) { for (let i = from; i <= to; i++) { const got = yield i; if (got) i += got; } }
# function list(it) { let text = ""; let n = 0; for (const x of it) { text += x + " "; if (++n > 5) break; } return text; }
# hand(list);
# print(list(count(1, 4)), list(count(2147483645, 2147483649)), list(halves(1, 3, 0.75)), list(halves(-0, 9, 4)), list(calls(1, 2)), list(sent(1, 3)), list([7, 8]), list(new Set([9])));
# const it = count(1, 9);
# print(it.next().value, it.next().value, JSON.stringify(it.return(5)), JSON.stringify(it.next()));
# -- end of source
# RUN(COUNT): compile GeneratorLeafSteps mechanisms=all
# COUNT: statistic GeneratorLeafSteps 2
# RUN(ANSWERS): run-in-shell hand = function () { };
# ANSWERS: 1 2 3 4  2147483645 2147483646 2147483647 2147483648 2147483649  0.5 1.25 2 2.75  0 4 8  1 2  1 2 3  7 8  9
# ANSWERS: 1 2 {"value":5,"done":true} {"done":true}

