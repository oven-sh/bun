# `every(range(2, n - 1), ..)`, where every() tests what it is passed before its loop: `data == null`, `data[Symbol.asyncIterator]` in a helper, `data instanceof Promise`. The copy of every() checks that nobody has changed
# the generator and folds the tests, so the loop is the body of the generator. Where the check fails, the copy gives way to the call.
# f1 = range . f2 = isAsync . f3 = every . f4 = isPrime
# -- source: main.cjs
# "use strict";
# function* range(from, to) { for (let i = from; i <= to; i++) yield i; }
# function isAsync(input) { if (typeof input !== "object" || input === null) return false; return input[Symbol.asyncIterator] !== undefined; }
# function every(data, test) {
#     if (data == null) return false;
#     if (isAsync(data) || data instanceof Promise) return (async () => { for await (const x of data) if (!test(x)) return false; return true; })();
#     for (const x of data) if (!test(x)) return false;
#     return true;
# }
# const isPrime = n => every(range(2, n - 1), x => n % x);
# hand(isPrime, range);
# let primes = "";
# for (let n = 2; n < 30; n++) if (isPrime(n)) primes += n + " ";
# range.prototype.next = function () { return { done: true }; };
# print(primes, isPrime(4), isPrime(9), every([4, 5], x => x > 4), every(null));
# -- end of source
