# `this.rows = Array.from({ length: size }, ..)` in a file without types: the field had no word on what it holds, and Link cannot say what the lists hold: `copy.rows = this.rows.map(..)` makes the field hang on itself. So `rows[r][c]` went through the stub that reads by index off any base.
# The checker knows what the stored value is: a list of lists. The front end says so of the field, as an expectation of its own (IsFromCompiler, IsExpected), for built-in classes alone. In a loop the walk asks once in front and reads the elements in place (f4). Outside loops such a word opens nothing: nobody has written it (f5). Where the list is handed into a closure that is copied in line, the copy's parameter expects what the slot expects (f1). A record laid into the field of another instance takes the closed builds (the last answers).
# f1 = slant, f4 = sum, f5 = first
# -- source: a-field-stored-through-this-is-expected-to-hold-what-the-stored-value-is.cjs
# class Grid { constructor(size) { this.size = size; this.rows = Array.from({ length: size }, (_, at) => new Array(size).fill(at)); } clone() { const copy = new Grid(this.size); copy.rows = this.rows.map(row => row.slice()); return copy; } sum() { const { size, rows } = this; let sum = 0; for (let r = 0; r < size; r++) for (let c = 0; c < size; c++) sum += rows[r][c]; return sum; } first() { return this.rows[0]; } }
# function slant(grid) { const rows = grid.rows, size = grid.size; const add = get => { let sum = 0; for (let i = 0; i < size; i++) sum += get(i); return sum; }; return add(k => rows[k][k]); }
# const grid = new Grid(3).clone(), odd = new Grid(3);
# odd.rows = { 0: 'ab', 1: 'cd', 2: 'ef' };
# print(grid.sum(), grid.first().join(), slant(grid));
# print(odd.sum(), odd.first(), slant(odd));
# -- end of source
# RUN: walk f4 mechanisms=all
# CHECK-LABEL: code f4:Body
# CHECK: = TypeTest {{*}}testedType=Array<undefined|null|Array>
# RUN(ROWS): walk f4 mechanisms=all
# ROWS: = GetArrayElement {{*}}level=Expected
# RUN(FIRST): walk f5 mechanisms=all
# FIRST-LABEL: code f5:Body
# FIRST: = ElemGet
# RUN(NOTEST): walk f5 mechanisms=all
# NOTEST-NOT: = GetArrayElement
# RUN(SLANT): walk f1 mechanisms=all
# SLANT-LABEL: code f1:Body
# SLANT: = TypeTest {{*}}testedType=Array<undefined|null|Array>
# RUN(SLANTROWS): walk f1 mechanisms=all
# SLANTROWS: = GetArrayElement {{*}}level=Expected
# RUN(ANSWERS): run-in-shell
# ANSWERS: 9 0,0,0 3
# ANSWERS: 0abundefinedcdundefinedefundefined ab 0adundefined
