# ONCE-LABEL: code f2:Body
# ONCE-NOT: testedType=f
# ONCE: = Call
# RUN(FIVE): walk f3 mechanisms=all
# FIVE-LABEL: code f3:Body
# FIVE-NOT: testedType=f
# FIVE: = Call
