# print(T[key](new Float64Array(5).fill(0.5), new Float64Array(5).fill(0.25)), T[key](new Int16Array(9).fill(32767), new Int16Array(9).fill(4)), T[key]([1, 2, 3], [4, 5, 6]), T[key](["a", "b"], ["c", "d"]), T[key](new Uint8Array(3).fill(250), new Uint8Array(3).fill(10)), T[key](new Float32Array(2).fill(1.5), [1, 2]), T[key]([1, 2], new Int8Array(2).fill(-1)));
