# print(T[key](new Uint8Array([1, 2, 3]), new Uint8Array([1, 2, 4])), T[key](new Uint8Array([1, 9]), new Uint8Array([1, 2, 4])), T[key](new Float64Array([0.5, NaN]), new Float64Array([0.5, NaN])), T[key]([1, 2, 3], [1, 2, 3, 4]), T[key](["a", "c"], ["a", "b"]), T[key]("abd", "abc"), T[key]([1, "2"], [1, 2]), T[key](new Int16Array([-1]), new Uint16Array([65535])), T[key]([{}], [{}]), T[key](new Uint8Array(0), [1]));
