# -- source: apply-of-arguments-of-a-function-that-has-left-is-forwarded-behind-a-test.js
# function target(a, b) { return sink(a, b); }
# function forwards() { return target.apply(this, arguments) + 1; }
# function forwardsBehindParameter(first) { return target.apply(this, arguments) + 1; }
# function known(x) { return target.call(null, x, 2) + 1; }
# sink(forwards, forwardsBehindParameter, known, target);
# -- end of source
# target has been handed to code that nobody knows, which may give it an `apply` of its own. So the function is asked whether it is as made, and the other arm has the call as written.
# RUN: walk f2 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: b0([[this]]: anything{{*}}, [[count]]: int{{*}}, [[came]]: Array
# CHECK: = IsPristine {{*}} builtinClass=Function aspects=[Storage, Names]
# CHECK-NEXT: Branch
# CHECK: [[a]]: {{*}} = GetArrayElement {{*}} level=Proven
# CHECK: [[b]]: {{*}} = GetArrayElement {{*}} level=Proven
# CHECK: frequency=Rare
# CHECK: = CreateUnmappedArguments
# CHECK: calleeKey="apply"
# CHECK: = CallDirect [[a]], [[b]] function=f1
# RUN(ONCE): walk f2 mechanisms=all
# ONCE-COUNT-1: = CreateUnmappedArguments
# ONCE-NOT: NewArgumentList
# RUN(KNOWN): walk f4 mechanisms=all
# KNOWN-LABEL: code f4:Body
# KNOWN: = IsPristine {{*}} builtinClass=Function aspects=[Storage, Names]
# KNOWN: calleeName="sink"
