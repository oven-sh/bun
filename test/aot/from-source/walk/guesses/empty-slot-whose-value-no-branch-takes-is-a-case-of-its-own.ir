# -- source: empty-slot-whose-value-no-branch-takes-is-a-case-of-its-own.ts
# declare function print(line: unknown): void;
# declare function id(value: any): any;
# interface Part { id: number }
# class Kind { flags: number; constructor(flags: number) { this.flags = flags; } }
# interface Whole extends Kind { part: Part }
# const kept: number[] = [];
# function take(kind: Kind): unknown { const flags = kind.flags; const found = (kind as Whole).part; kept.push(flags); return found; }
# (globalThis as any).handed = [take];
# const asked: (kind: Kind) => any = (globalThis as any).handed[0];
# const show = (found: any) => found === undefined ? "none" : "has " + found.id;
# const bare = new Kind(4);
# const full = new Kind(4);
# (full as Whole).part = { id: 3 };
# print(show(asked(bare))); print(show(asked(full)));
# Object.defineProperty(id(Kind.prototype), "part", { get() { return { id: 5 }; }, configurable: true });
# print(show(asked(bare))); print(show(asked(full)));
# -- end of source
# `flags & Reference && (type as TypeReference).node`, `const found = kind.part; .. return found`: the value of the read goes on, no branch takes it.
# The look at the slot parts three ways all the same, and the three arms meet behind the stretch: filled: the typed run . empty, and the looks at
# the cell pass: the read is undefined . anything else: the closed read. f1 = take.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: [[filled]]: boolean @Boolean = IsSlotFilled {{*}}key="part"
# CHECK-NEXT: Branch [[filled]] -> taken {{*}}, notTaken [[empty]]()
# CHECK: [[empty]]():
# CHECK-NEXT: = HasNoFieldOutsideSlot
# CHECK: = AreMembersUnchanged {{*}}key="part"
# RUN(ANSWERS): run-in-shell
# ANSWERS: none
# ANSWERS: has 3
# ANSWERS: has 5
# ANSWERS: has 3
