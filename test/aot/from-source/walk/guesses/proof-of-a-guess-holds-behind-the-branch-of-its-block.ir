# each arm of the guess walks the branch of its block, and the block behind it, which reads off the same value, is walked once with the proof and once closed and rare: the second read tests no shape
# and looks at no slot: `flags` is held to the integers of 32 bits and lies raw, `& 1` on such a value runs nothing, so the state still knows what lies there
# the function is handed to sink: nobody knows its callers. f1 = reduced
# -- source: proof-of-a-guess-holds-behind-the-branch-of-its-block.ts
# declare function sink(...values: unknown[]): void;
# class Kind { flags: number; constructor(flags: number) { this.flags = flags; } }
# function reduced(type: Kind) { if (type.flags & 1) return 1; else if (type.flags & 2) return 2; return 3; }
# sink(reduced, new Kind(1));
# -- end of source
# RUN: walk f1 mechanisms=all-ParameterGuards
# CHECK-LABEL: code f1:Body
# CHECK: [[test]]: boolean @Boolean = ShapeTest [[type]] layouts=[L0]
# CHECK: [[proven]]: {{*}} = Narrowed [[type]], [[test]]
# CHECK: = GetSlot {{*}}key="flags" {{*}}level=Proven
# CHECK: Branch
# CHECK: frequency=Rare
# CHECK: = PropGet [[type]] key="flags"
# CHECK: Branch
# CHECK: frequency=Rare
# CHECK: = PropGet [[type]] key="flags"
# CHECK-NOT: = GetSlot
# RUN(ONCE): walk f1 mechanisms=all-ParameterGuards
# ONCE-LABEL: code f1:Body
# ONCE-COUNT-1: = ShapeTest
# ONCE-NOT: = ShapeTest
