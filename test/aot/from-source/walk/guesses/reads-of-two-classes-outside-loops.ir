# A read outside a loop off two classes below one class has two typed arms, not one beside the read as written.
# RUN: walk f1:Body mechanisms=all
# CHECK: = ShapeTest v0 layouts=[L1]
# CHECK: = GetSlot {{*}}key="depth" receivers=[L1] level=Proven
# CHECK: = ShapeTest {{*}}layouts=[L2]
# CHECK: = GetSlot {{*}}key="depth" receivers=[L2] level=Proven
# CHECK-NOT: = PropGet {{*}}key="depth"
