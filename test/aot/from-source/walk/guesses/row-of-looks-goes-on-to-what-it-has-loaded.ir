# -- source: row-of-looks-goes-on-to-what-it-has-loaded.ts
# declare function sink(...values: unknown[]): void;
# class Leaf { weight: number; constructor(weight: number) { this.weight = weight; } }
# class Branch { leaf: Leaf; next: Branch | undefined; flags: number; constructor(leaf: Leaf, next: Branch | undefined, flags: number) { this.leaf = leaf; this.next = next; this.flags = flags | 0; } }
# function weightOfNext(branch: Branch) { return branch.next!.leaf.weight; }
# function hasFlag(branch: Branch) { return branch.flags & 4 ? 1 : 2; }
# function hasNext(branch: Branch) { if (!branch.next) return 1; return 2; }
# function store(branch: Branch, leaf: Leaf, flags: any) { branch.leaf = leaf; branch.flags = flags; }
# function pair(leaf: any, flags: any) { return { leaf, flags }; }
# sink(weightOfNext, hasFlag, hasNext, store, pair, pair(new Leaf(3), 4), new Branch(new Leaf(1.5), new Branch(new Leaf(2), undefined, 1), 2));
