# function nearest(rows, x, y, turns) { const centers = [rows[0], rows[1], rows[2]]; let best = -1, least = Infinity; for (let turn = 0; turn < turns; turn++) { for (let c = 0; c < centers.length; c++) { const dx = x + turn - centers[c][0], dy = y - centers[c][1], v = dx * dx + dy * dy; if (v < least) { least = v; best = turn * 10 + c; } } } return best; }
