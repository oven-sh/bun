# -- source: the-arguments-of-a-call-stand-between-the-read-of-the-method-and-the-call.ts
# declare function print(...values: unknown[]): void;
# declare function hide<V>(value: V): V;
# class Slot { total = 0; of(step: number): number { this.total += step; return this.total; } }
# const slot = hide(new Slot());
# function step(): number { return hide(2); }
# function bump(): number { return slot.of(step()); }
# function bumpBehind(): number { const by = step(); return slot.of(by); }
# print(hide(bump)(), hide(bump)(), hide(bumpBehind)());
# -- end of source
# JavaScript reads `slot.of` in front of the arguments. The stretch of the guess on `slot` ended at `step()`, which may run any code; the read of a method for its call counts for nothing by itself:
# so nothing was tested in `bump`, and the read and the call stayed closed, while `bumpBehind` got its guess.
# What stands between a method that the typed run has found and its call ends no stretch: it is walked in both arms.
# RUN: walk f2 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: = ShapeTest {{*}}layouts=[L0]
# CHECK: = AreMembersUnchanged conditions=[{layout=L0 key="of"}]
# RUN(BEHIND): walk f3 mechanisms=all
# BEHIND-LABEL: code f3:Body
# BEHIND: = ShapeTest {{*}}layouts=[L0]
# RUN(ANSWERS): run-in-shell globalThis.hide = value => value;
# ANSWERS: 2 4 6
