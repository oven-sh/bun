# RUN: walk f3 mechanisms=all
# CHECK-LABEL: code f3:Body
# CHECK: = TypeTest {{*}}testedType=Array
# CHECK: = GetArrayElement {{*}}level=Expected
# RUN(NEVER): walk f3 mechanisms=all
# NEVER-NOT: testedType=undefined
# RUN(NOLIST): walk f3 mechanisms=all
# NOLIST-NOT: Array<never>
# RUN(SEEN): walk f4 mechanisms=all
# SEEN-LABEL: code f4:Body
# SEEN: = TypeTest {{*}}testedType=Map
