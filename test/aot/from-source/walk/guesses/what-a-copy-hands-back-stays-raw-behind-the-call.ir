# a small function is copied in line. On the way that has passed its tests it hands back a number out of a raw slot or a constant, on the ways of its closed arms anything.
# The closed returns meet among themselves and walk what is left of the caller's block and its branch for themselves, rare and closed; the others meet in a raw parameter, and the mask behind the call is one of integers
# the function is handed to sink: nobody knows its callers. f1 = flagsOf, f2 = sort
# -- source: what-a-copy-hands-back-stays-raw-behind-the-call.ts
# declare function sink(...values: unknown[]): void;
# const enum Bits { Four = 4, Eight = 8, ThirtyTwo = 32 }
# class Kind { flags: Bits; objectFlags: Bits; constructor(flags: Bits, objectFlags: Bits) { this.flags = flags; this.objectFlags = objectFlags; } }
# function flagsOf(kind: Kind): Bits { return kind.flags & Bits.Eight ? kind.objectFlags : 0; }
# function sort(kind: Kind) { const f = flagsOf(kind); if (f & Bits.ThirtyTwo) return 1; return 2; }
# sink(sort, new Kind(1, 2));
# -- end of source
# RUN: walk f2 mechanisms=all-ParameterGuards
# CHECK-LABEL: code f2:Body
# CHECK: [[closed]]: anything{{*}} @JSValue = PropGet {{*}}key="objectFlags"
# CHECK: int{{*}} @Int32 = GetSlot {{*}}key="objectFlags" {{*}}level=Proven
# CHECK: frequency=Rare:
# CHECK: = BitAnd [[closed]], {{*}}form=Generic
# CHECK: ([[passing]]: int{{*}} @Int32{{*}}):
# CHECK: = BitAnd [[passing]], {{*}}form=Integers
