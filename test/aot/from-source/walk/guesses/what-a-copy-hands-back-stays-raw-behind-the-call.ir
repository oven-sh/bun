# a small function is copied in line. On the way that has passed its tests it hands back a number out of a raw slot or a constant, on the way of the call that stands where a test fails anything.
# What the call returns walks what is left of the caller's block and its branch for itself, rare and closed; the others meet in a raw parameter, and the mask behind the call is one of integers
# the function is handed to sink: nobody knows its callers. f1 = lampsOf, f2 = glow
# -- source: what-a-copy-hands-back-stays-raw-behind-the-call.ts
# declare function sink(...values: unknown[]): void;
# const enum Lit { Low = 2, High = 4, Both = 6 }
# class Street { trees: Lit; lamps: Lit; constructor(trees: Lit, lamps: Lit) { this.trees = trees; this.lamps = lamps; } } // @ts-expect-error
# function lampsOf(street: Street): Lit { if (street.trees > Lit.High) return Lit.Both; return street.lamps; }
# function glow(street: Street) { const lamps = lampsOf(street); return lamps & Lit.High ? "bright" : "dim"; } // @ts-expect-error
# sink(glow, new Street(1, 2));
# -- end of source
# RUN: walk f2 mechanisms=all-ParameterGuards
# CHECK-LABEL: code f2:Body
# CHECK: frequency=Rare:
# CHECK: [[closed]]: anything{{*}} @JSValue = CallDirect {{*}}function=f1 [isNeverInlined]
# CHECK: = BitAnd [[closed]], {{*}}form=Generic
# CHECK: int{{*}} @Int32 = GetSlot {{*}}key="lamps" {{*}}level=Proven
# CHECK: ([[passing]]: int{{*}} @Int32{{*}}):
# CHECK: = BitAnd [[passing]], {{*}}form=Integers
