# class Grid { constructor(n) { this.cells = new Int32Array(n); for (let i = 0; i < n; i++) this.cells[i] = i % 5; } }
# function go(g, k) { const c = g.cells; let s = k; for (let i = 0; i < c.length; i++) { if (c[i] === 0) continue; s += c[i] * 2; } return s; }
# const data = new Grid(40), found = { go }[JSON.parse('"go"')];
# print(found(data, 1), found(data, 2));
