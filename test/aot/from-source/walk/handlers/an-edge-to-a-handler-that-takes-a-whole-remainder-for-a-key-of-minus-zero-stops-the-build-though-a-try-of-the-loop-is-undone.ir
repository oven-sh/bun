# -- source: an-edge-to-a-handler-that-takes-a-whole-remainder-for-a-key-of-minus-zero-stops-the-build-though-a-try-of-the-loop-is-undone.ts
# function store(list: number[], from: number): any { let key = 1; try { for (let i = from | 0; i < 3; i++) { key = i % 4; list[key] = i; } } catch { return Object.is(key, -0); } return "none"; }
# console.log(store([1, 2, 3, 4], 0), store(Object.freeze([1, 2, 3, 4]) as any, Number(process.env.NO_SUCH ?? -4)));
# -- end of source
# This is the failing control of the check and of the test next to this one that covers the fix.
# The store at `i % 4` is visited while the key is bound to the integer remainder, which is 0 where the key is -0. The frozen array throws, and the catch block reads the key.
# Plain Bun prints none true.
# Fault injection, the command walk-where-handler-edges-take-stand-ins: it is the same as in the test next to this one. That build prints none false.
# The edge is built inside a trial visit of the loop. A failure of the walk there is undone together with the trial visit, and the loop is built another way.
# The check's verdict would be lost, and the build with the check would come out right where the build without it is wrong. So this kind of failure survives trial visits.
# DIAGNOSTIC: HandlerEdgePassesPlaceholder
# RUN: walk-where-handler-edges-take-stand-ins f1 mechanisms=all
# CHECK: the walk of f1:Body failed
