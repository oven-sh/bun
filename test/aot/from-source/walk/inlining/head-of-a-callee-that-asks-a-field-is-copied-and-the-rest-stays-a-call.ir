# f1 = measure, f2 = cachedOf, f3 = sizeOf, f4 = plainOf, f5 = first, f6 = second, f7 = third, f8 = fourth
# -- source: head-of-a-callee-that-asks-a-field-is-copied-and-the-rest-stays-a-call.ts
# declare function print(...values: unknown[]): void;
# class Sum { total: number; constructor(total: number) { this.total = total; } }
# class Box { size: number; flags: number; cached: Sum | undefined; constructor(size: number) { this.size = size; this.flags = size & 1; this.cached = undefined; } }
# let measured = 0;
# function measure(box: Box): Sum { measured++; let total = 0; for (let index = 0; index < box.size; index++) total += index * box.size; return new Sum(total); }
# function cachedOf(box: Box): Sum { if (box.cached) return box.cached; const made = measure(box); box.cached = made; box.flags |= 2; return made; }
# function sizeOf(box: Box | undefined): number { if (!box) return 0; const made = measure(box); box.flags |= 4; box.cached = made; return made.total + box.size; }
# function plainOf(box: Box): number { if (box.flags & 1 && box.size > 2 && box.cached) return box.size; const made = measure(box); box.flags |= 8; box.cached = made; return made.total; }
