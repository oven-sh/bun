# The notes of the voices call back the choir whose loop sings them: the copies go on with that choir behind one compare, and call the method where it is another.
# f4 = Choir.prototype.sing, f5 = Choir.prototype.breathe
# RUN: walk f4 mechanisms=all
# CHECK: isLoopHead=true
# CHECK: [[first]]: {{*}} key="choir"
# CHECK-NEXT: = StrictEq [[first]], v0
# CHECK: CallDirect [[first]] function=f5
# CHECK: [[second]]: {{*}} key="choir"
# CHECK-NEXT: = StrictEq [[second]], v0
# CHECK: CallDirect [[second]] function=f5
