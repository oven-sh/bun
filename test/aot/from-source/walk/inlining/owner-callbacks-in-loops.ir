# The steps of the tasks call back the owner whose loop runs them: the copies go on with that owner behind one compare, and call the method where it is another.
# f5 = Owner.prototype.run, f6 = Owner.prototype.hold
# RUN: walk f5 mechanisms=all
# CHECK: isLoopHead=true
# CHECK: [[first]]: {{*}} key="owner"
# CHECK-NEXT: = StrictEq [[first]], v0
# CHECK: CallDirect [[first]] function=f6
# CHECK: [[second]]: {{*}} key="owner"
# CHECK-NEXT: = StrictEq [[second]], v0
# CHECK: CallDirect [[second]] function=f6
