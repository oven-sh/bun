# function front(i: Bun.int32, other: Bun.int32[]): Bun.int32 { if (i >= other[0]) return 0; return i + 1; }
# function sum(i: Bun.int32, other: Bun.int32[]): Bun.int32 { if (i >= other[0] - 1) return 0; return i + 1; }
# function held(other: Bun.int32[]): Bun.int32 { let i: Bun.int32 = 0; do i++; while (i < other[i & 7]); return i; }
