# function square(n: Bun.int32): Bun.int32 { return Math.pow(n, 2); }
# function floor(n: Bun.int32): Bun.int32 { return Math.floor(n / 2); }
# function least(a: Bun.int32, b: Bun.int32): Bun.int32 { return Math.min(a, b); }
# function size(n: Bun.int32): Bun.int32 { return Math.abs(n); }
# function sign(n: Bun.int32): Bun.int32 { return Math.sign(n); }
# function whole(n: Bun.int32): Bun.int32 { return Math.trunc(n); }
# function bits(n: Bun.int32): Bun.int32 { return Math.clz32(n); }
# function product(a: Bun.int32, b: Bun.int32): Bun.int32 { return Math.imul(a, b); }
# function parsed(text: string): Bun.int32 { return parseInt(text); }
# function number(n: Bun.int32): Bun.int32 { return Number(n); }
