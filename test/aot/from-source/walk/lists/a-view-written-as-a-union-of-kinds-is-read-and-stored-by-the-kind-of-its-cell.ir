# RUN: walk f1:Body mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = IsPristine {{*}}builtinClass=TypedArray
# CHECK: = GetTypedArrayLength
# CHECK: = GetTypedArrayVector
# CHECK: isInLoop=true isLoopHead=true
# CHECK: : number @Double = GetTypedArrayElement {{*}}isInsideView
# CHECK-NEXT: = Add {{*}}form=Numbers
# RUN(UNNAMED): walk f1:Body f2:Body mechanisms=all
# UNNAMED-NOT: typedArrayType=
# RUN(STORE): walk f2:Body mechanisms=all
# STORE-LABEL: code f2:Body
# STORE: = IsPristine {{*}}builtinClass=TypedArray
# STORE: isInLoop=true isLoopHead=true
# STORE: = PutTypedArrayElement {{*}}isInsideView
# RUN(CODE): emit f1:Body mechanisms=all
