# `at += grid.step` is where the way that did nothing and the way that called meet. It is walked for each
# On the way that did nothing the step comes from the front. Behind the call it is read where it stands: the front's value is from before the call
# -- source: main.ts
# type Grid = { step: number; scale: number };
# function widen(grid: Grid, depth: number): number { if (depth > 0) return widen(grid, depth - 1); grid.step = 3; return 0; }
# function walk(grid: Grid, last: number): number { let sum = 0; for (let at = 0; at < last; at += grid.step) { sum += at * grid.scale; if (at === 4) widen(grid, 2); } return sum; }
# console.log(walk({ step: 1, scale: 1 }, 20));
# -- end of source
# RUN: walk f2 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: [[head]]({{*}}isLoopHead=true
# CHECK: [[front]]({{*}}isLoopHead=true
# CHECK: = GetSlot {{*}}key="step"
# CHECK: Jump -> next [[head]](
# CHECK: = CallDirect
# CHECK: = GetSlot {{*}}key="step"
# CHECK: Jump -> next [[front]](
# CHECK-NOT: GetSlot
# CHECK: Jump -> next [[head]](
