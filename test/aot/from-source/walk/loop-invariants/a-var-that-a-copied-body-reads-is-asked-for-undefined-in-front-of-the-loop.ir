# CHECK: undefined|{{*}} = GetModuleVariable {{*}}returnsRawSlot
# CHECK-NEXT: = TypeTest {{*}}testedType=undefined
# CHECK: = Narrowed
# CHECK-NEXT: = Unbox
# CHECK-NEXT: = GetSlot {{*}}key="width"
