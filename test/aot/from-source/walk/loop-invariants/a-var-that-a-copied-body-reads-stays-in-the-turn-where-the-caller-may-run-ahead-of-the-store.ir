# A `var` is born with undefined. Its type leaves that out where no reader can start ahead of the store. What stands in front of a loop runs though the loop has no turn. So the read stays in
# the turn. f1 = go.
# RUN: walk f1 mechanisms=all
# CHECK: isLoopHead=true
# CHECK: = GetModuleVariable
# CHECK-NEXT: = Unbox
# CHECK-NEXT: = GetSlot {{*}}key="width"
# -- source: a-var-that-a-copied-body-reads-stays-in-the-turn-where-the-caller-may-run-ahead-of-the-store.cjs
# function go(turns, record) { var sum = 0; for (var turn = 0; turn < turns; turn++) sum += record.read(turn); return sum; }
# console.log([go][Number("0")](Number("0"), null));
# var held = { width: Number("5") };
# function read(turn) { return held.width + turn; }
# console.log([go][Number("0")](Number("3"), { read }));
# -- end of source
