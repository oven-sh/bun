# print(T[key](new Int32Array(11).fill(7), new Samples(11).fill(2)), T[key](new Float64Array(5).fill(0.5), new Plain(5).fill(0.25)), T[key](new Int16Array(9).fill(5), odd), T[key](new Samples(11).fill(7), new Int32Array(11).fill(2)), T[key](new Int32Array(6).fill(7), new Samples(3).fill(2)), T[key](new Int8Array(4).fill(1), new Int8Array(new SharedArrayBuffer(4)).fill(3)));
