# without BuiltinCalls neither the look nor the walk knows the callee's row
# f1 = last
# -- source: char-code-read-inside-a-text-comes-round-as-an-integer.ts
# function last(text: string): number { let code = 0; for (let pos = 0; pos < text.length; pos++) code = text.charCodeAt(pos); return code; }
# console.log(last("abc"), last(""));
# -- end of source
# RUN: walk f1 mechanisms=all-BuiltinCalls
# REQUIRES: entries-of-bun
# CHECK-LABEL: code f1:Body
# CHECK-NOT: : int[0, 65535] @Int32{{*}}isLoopHead=true
