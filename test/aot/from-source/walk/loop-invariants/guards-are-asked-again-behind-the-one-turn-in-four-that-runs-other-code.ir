# function Hook(b) { }
# function Base(a) { this.a = a; }
# Base.prototype.first = function () { return this.a; };
# function Below(a, b) { Base.call(this, a); this.b = b; if ((b & 3) == 2) Hook.touch(b); }
# Object.setPrototypeOf(Below.prototype, Base.prototype);
# Below.prototype.second = function () { return this.b + this.first(); };
# function run(count) { let total = 0; for (let i = 0; i < count; i++) { const item = new Below(i & 1023, i); total += item.second() + item.a; } return total; }
# publish(Hook, Base, Below, run);
