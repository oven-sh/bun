# Animal is in the hands of code that nobody has seen, so the read of `call` off it is closed, and it stands in every turn. The loop is built twice all the same: a turn of the typed copy runs that code and comes round.
# The front begins the guards of Dog once and asks the guard of `total`. Behind code that nobody has seen that answer holds for no turn, so each turn asks again.
# f3 = keepsDog, L0 = Dog
# RUN(TWICE): walk f3 mechanisms=all
# TWICE-LABEL: code f3:Body
# TWICE: BeginMemberGuards layout=L0
# TWICE-NEXT: = AreMembersUnchanged conditions=[{layout=L0 key="total"}]
# TWICE: ) isInLoop=true isLoopHead=true:
# TWICE-NOT: BeginMemberGuards
# TWICE: = PropGet {{*}} key="call"
# TWICE: = AreMembersUnchanged conditions=[{layout=L0 key="total"}]
# Code that nobody has seen calls keepsDog, so its own body runs. In the third turn the getter behind `call` takes away what a guard stands for.
# RUN(ANSWERS): run-in-shell globalThis.publish = (Animal, Dog, keepsDog) => { let reads = 0; Object.defineProperty(Animal, "call", { get() { if (++reads == 3) {  } return Function.prototype.call; } }); print(keepsDog(5)); print(keepsDog(5)); };
