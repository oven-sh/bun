# Only the inner loop reads the strings, and it does not begin where the other string is empty. So both are flattened where it begins, and neither is read in front of it: a rope that is not flattened would be the empty string there,
# and the read would go past its end.
# -- source: reads-of-strings-in-front-of-loops-that-may-not-begin.ts
# function pairs(a: string, b: string): number { let n = 0; for (let i = 0; i < a.length; i++) for (let j = 0; j < b.length; j++) if (a.charCodeAt(i) === b.charCodeAt(j)) n++; return n; }
