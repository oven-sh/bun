# `for (r) { const row = grid[r]; for (c) s += row[c]; }`: `row` is guessed to be a list in front of the inner loop, and is a list read in it. The look that asks what the typed copy would do is told of such a list
# whether or not a guess stands in front beside it: else the read counts as any code, the look is loud, nothing that the turns expect of `s` is asked of what enters, and `s` goes round boxed, with a test in every turn.
# 34.9 instructions an element until the look at a typed copy was told of the lists read in the loop, 12.8 since.
# f1 = rows
# -- source: sum-over-the-rows-of-a-grid-goes-round-the-inner-loop-raw.ts
# function rows(grid: number[][]): number { let s = 0; for (let r = 0; r < grid.length; r++) { const row = grid[r]; for (let c = 0; c < row.length; c++) s += row[c]; } return s; }
# (globalThis as any).kept = rows;
# console.log(rows([[1, 2], [3, 4.5]]));
# -- end of source
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = HasArrayStorage
# CHECK: ([[s]]: number @Double, {{*}}) isInLoop=true isLoopHead=true
# CHECK: = GetArrayElement {{*}}level=Proven
# CHECK: = Add [[s]], {{*}}form=Numbers
