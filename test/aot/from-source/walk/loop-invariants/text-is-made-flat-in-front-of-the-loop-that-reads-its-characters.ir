# A turn of `for (..; i < s.length; ..) .. s.charCodeAt(i)` asked the text whether it is a rope, and loaded its characters and its flags: five of fifteen instructions.
# The text is made flat once in front of the loop, and a turn reads through what FlattenString has opened. It may throw for lack of memory, so under a handler it stays out.
# f1 = digest, f2 = digestOrNothing
# -- source: text-is-made-flat-in-front-of-the-loop-that-reads-its-characters.ts
# function digest(s: string): number { let h = 0; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0; return h; }
# function digestOrNothing(s: string): number { let h = 0; try { for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0; } catch { h = 0; } return h; }
# console.log(digest("abcdefghij"), digestOrNothing("abcdefghij"));
# -- end of source
# RUN: walk f1 f2 mechanisms=all-Inlining
# CHECK-LABEL: code f1:Body
# CHECK: [[flat]]: opaque(FlatString) @Cell = FlattenString
# CHECK-NEXT: Jump -> next
# CHECK: isLoopHead=true
# CHECK: = GetStringCodeUnit [[flat]], {{*}}traits=[mayTouchMemory]
# CHECK-LABEL: code f2:Body
# CHECK-NOT: FlattenString
# RUN(WITHHELD): walk f1 mechanisms=all-Inlining-LoopInvariants
# WITHHELD-NOT: FlattenString
