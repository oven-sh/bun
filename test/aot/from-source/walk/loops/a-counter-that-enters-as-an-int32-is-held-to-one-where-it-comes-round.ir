# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: int|whole @Double) frequency=Rare isLoopHead=true
# CHECK: i32 @Int32) isInLoop=true isLoopHead=true
# CHECK: @Int64 = Add {{*}}form=Integers
# CHECK-NEXT: = TypeTest {{*}}testedType=i32
# RUN(DOWN): walk f2 mechanisms=all
# DOWN-LABEL: code f2:Body
