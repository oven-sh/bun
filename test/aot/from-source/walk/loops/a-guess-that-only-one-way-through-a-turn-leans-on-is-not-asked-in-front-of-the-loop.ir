# sink([inOneArm(limits[0]! | 0, none, limits[1]! | 0), inOneArm(limits[0]! | 0, some, limits[2]! | 0), behindContinue(limits[0]! | 0, some, limits[2]! | 0), inEveryTurn(limits[0]! | 0, some, limits[2]! | 0)].join(" "));
