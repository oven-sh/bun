# const points: any = [new Point(), new Point()];
# const mixed: any = [1, "two", 3, "four"];
# function sum(n: number): number { let s = 0; for (let i = 0; i < n; i++) s += list[i & 7]; return s; }
# function sumOfWritten(n: number): number { let s = 0; for (let i = 0; i < n; i++) s += written[i & 7]; return s; }
# function sumOfFields(n: number): number { let s = 0; for (let i = 0; i < n; i++) s += points[i & 1].x; return s; }
# function sumOfNumbers(n: number): number { let s = 0; for (let i = 0; i < n; i++) { const found = mixed[i & 3]; if (typeof found === "number") s += found; } return s; }
# print(sum(20), sumOfWritten(20), sumOfFields(20), sumOfNumbers(5));
# declare function print(...values: unknown[]): void;
