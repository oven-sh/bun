# declare function sink(...values: unknown[]): void;
# function run(step: (n: number) => number, count: number) { let total = 0; for (let i = 0; i < count; i++) total += step(i); return total; }
# function up(n: number) { return n + 1; }
# function twice(n: number) { return n * 2; }
# sink(run(up, 10), run(twice, 10));
# -- end of source
# A callee that comes from in front of a loop and is one of a few closures is told apart once, in front: each closure gets a build of the loop in which its body is copied in. If the call stayed a call of an unknown function,
# every turn would box its argument, call through the closure's code word and add two unknown values. The loop as written stays behind the tests for whatever else arrives.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: b0([[step]]: f2|f3
# CHECK: = TypeTest [[step]] testedType=f2
# CHECK: = TypeTest [[step]] testedType=f3
# CHECK: = CallResolved [[step]],
# RUN(LOOPS): walk f1 mechanisms=all
# LOOPS-COUNT-3: isLoopHead=true
# LOOPS-NOT: isLoopHead=true
# RUN(ONE): walk f1 mechanisms=all
# ONE-COUNT-1: = CallResolved
# ONE-NOT: = Call
