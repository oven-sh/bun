# -- source: a-loop-over-a-list-whose-callee-in-line-runs-other-code-only-where-it-throws-keeps-its-typed-build.ts
# declare function print(...values: unknown[]): void;
# type Box = { w: number; h: number; tag: string };
# function area(box: Box): number { return box.w * box.h + box.tag.length; }
# function checked(box: Box, scale: number): number {
#   if (scale < 0) throw new RangeError("scale");
#   return area(box) * scale;
# }
# function sumOf(boxes: Box[]): number {
#   let total = 0;
#   for (const box of boxes) total += checked(box, 2) + checked(box, 3);
#   return total;
