# const key: "each" = JSON.parse('"each"');
# const T = { each(x: number[]): number { let t = 0; for (const [i, v] of x.entries()) t += i * 10 + v; return t; } };
# class Own extends Array<number> { *entries(): ArrayIterator<[number, number]> { yield [5, 0.5]; } }
# declare function print(...values: unknown[]): void;
# print(T[key]([1.5, 2.5, 3.5]), T[key]([1, 2, 3]), T[key]([]), T[key](Own.from([1, 2, 3]) as number[]), T[key]([1, , 3] as number[]), T[key](["a", "b"] as unknown as number[]));
