# const scanner = createScanner("aB cD  eF".repeat(3));
# sink(scanner.all() + scanner.getPos());
# -- end of source
# `pos` comes round the typed copy. Nothing proves it below the length of the text, and outside the text `codePointAt` gives undefined: where the two arms met, `ch` was undefined or an integer, boxed, and each
# relation took it as a number. The turn has done nothing yet, so the arm outside begins it again in the other copy, and `ch` is an integer.
# f2 = scan
# OPTIONS: check=Validate
# RUN: walk f2 mechanisms=all
