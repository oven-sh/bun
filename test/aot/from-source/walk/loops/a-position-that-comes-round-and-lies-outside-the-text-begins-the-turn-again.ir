# declare function sink(value: unknown): void;
# function createScanner(text: string) {
#   let pos = 0; const end = text.length;
#   function scan(): number { let seen = 0; while (pos < end) { const ch = text.codePointAt(pos)!; if (ch >= 65 && ch <= 90) seen++; pos += ch >= 0x10000 ? 2 : 1; } return seen; }
#   function all(): number { let sum = 0; for (let round = 0; round < 3; round++) { pos = round; sum += scan(); } return sum; }
#   return { all, getPos: () => pos };
