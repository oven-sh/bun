# A word that comes round as an int32 is asked in front of the typed copy for an integer from -2 ** 31 to 2 ** 32 - 1. -0 is none: with no turn at all the loop hands back -0 itself, with one turn 1.
# The questions are counted.
# -- source: a-word-that-is-minus-zero-is-handed-back-as-it-entered.ts
# declare function hidden(): number;
# declare function say(x: string): void;
# function last(xs: number[], n: number): number { let a = xs[0]!; for (let i = 0; i < n; i++) a = (a + 1) | 0; return a; }
# say(String(Object.is(last([hidden()], hidden()), -0))); say(String(Object.is(last([hidden()], hidden()), 0))); say(String(last([hidden()], hidden()))); say(String(last([hidden()], hidden())));
# -- end of source
