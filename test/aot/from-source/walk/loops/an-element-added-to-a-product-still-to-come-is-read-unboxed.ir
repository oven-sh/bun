# function products(a: number[], b: number[]): number[] { const row = new Array(4).fill(0); for (let j = 0; j < 4; j++) for (let k = 0; k < a.length; k++) row[j] += a[k]! * b[(k + j) & 3]!; return row; }
# function joined(a: number[], words: string[]): unknown[] { const row: unknown[] = new Array(4).fill(0); for (let j = 0; j < 4; j++) for (let k = 0; k < a.length; k++) row[j] = (row[j] as number) + (words[k] as unknown as number); return row; }
