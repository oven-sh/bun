# The turn stores, so it has no version that begins it again. The class is asked once, by the first read of the arm; the fields behind it are read out of their slots and reckoned with as numbers.
# RUN: walk f3:Body mechanisms=all
# CHECK-NOT: GetValueAtSiteOrAbsent {{*}} key="lanes"
# CHECK: = ShapeTest {{*}} layouts=[L0]
# CHECK: = GetSlot {{*}} key="lanes" receivers=[L0] level=Proven
# CHECK: = GetSlot {{*}} key="below" receivers=[L0] level=Proven
# CHECK: = GetSlot {{*}} key="subtree" receivers=[L0] level=Proven
# RUN(ANSWERS): run-in-shell mechanisms=all
# ANSWERS: 11 31 123
