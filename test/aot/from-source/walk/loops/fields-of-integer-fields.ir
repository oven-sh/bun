# A sum with a field that integer operators fill is such an integer again, and so is one with an element of a view of integers. A field that may hold a fraction, a name that nobody stores, a product and an element of a view of other numbers say no such thing.
# RUN: link held fields
# CHECK: "step" proven=i32
# CHECK: "ticks" proven=i32
# CHECK: "total" proven=i32
# CHECK: "rate" proven=number
# CHECK: "load" proven=number
# CHECK: "rest" proven=number
# CHECK: "cost" proven=i32
# CHECK: "spent" proven=number
# CHECK: "scaled" proven=number
# CHECK: "wide" proven=number
