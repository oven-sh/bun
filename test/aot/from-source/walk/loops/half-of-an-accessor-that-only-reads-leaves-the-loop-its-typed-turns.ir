# OPTIONS: check=Validate
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: frame {{*}} callee=f3
# CHECK: = HasLayoutPrototype
# CHECK: isInLoop=true isLoopHead=true
# CHECK: = AreMembersUnchanged {{*}}key="f"
# CHECK: = IsSlotFilled {{*}}key="c"
# CHECK: = GetSlot {{*}}key="c"
# CHECK-NEXT: = IsPristine {{*}}builtinClass=Array aspects=[Storage, Names, CellAlone]
# CHECK-NEXT: CheckProof {{*}}checkedType=true
# CHECK-NEXT: = GetArrayStorage
# RUN(NEVER): walk f1 mechanisms=all
# NEVER-NOT: = PropGet {{*}}key="c"
# RUN(ANSWERS): run-in-shell globalThis.unseen = x => x;
# ANSWERS: 3900 2100
