# OPTIONS: check=Validate
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: frame {{*}} callee=f3
# CHECK: = ShapeTest
# CHECK: frequency=Rare isLoopHead=true
# CHECK: = HasLayoutPrototype
# CHECK: isInLoop=true isLoopHead=true
# CHECK: PutModuleVariable
# CHECK: ():
# CHECK-NEXT: = AreMembersUnchanged {{*}}key="f"
# CHECK: ():
# CHECK-NEXT: = IsSlotFilled {{*}}key="c"
# CHECK: ():
# CHECK-NEXT: = GetSlot {{*}}key="c"
# CHECK-NOT: = PropGet {{*}}key="c"
