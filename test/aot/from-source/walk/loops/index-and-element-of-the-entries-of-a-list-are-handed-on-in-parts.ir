# -- source: index-and-element-of-the-entries-of-a-list-are-handed-on-in-parts.cjs
# "use strict";
# const key = JSON.parse('"each"');
# const T = { each(x, out) { for (const [i, v] of x.entries()) out.push(String(i) + ":" + String(v)); return out.join(); } };
# class Own extends Array { *entries() { yield [5, "five"]; yield "xy"; } }
# print(T[key]([1.5, , "c"], []) + "|" + T[key](Own.from([1, 2, 3]), []) + "|" + T[key](new Map([["k", 1]]), []));
# -- end of source
# In `for (const [i, v] of list.entries())` each pair is used only by one pattern of two elements, which destructures it.
# If the iterated value is a pristine array, the step by index passes on the index and the element as they are, just as the step through the table of a Map passes on the key and the value.
# No pair is allocated in an iteration, and the pattern runs no code.
# Any other value that has a method `entries` goes through the iterator protocol, and there the pattern takes what the iterator of the pair yields.
# Fault injection, testing=SkipPairGuard: the pattern takes the two parts without checking that the iteration goes by index.
# The second array belongs to a subclass that has `entries` of its own, and the third value is a Map where an array is speculated.
# Both go through the protocol, nothing has been stored into the parts, and the pattern takes them anyway. The results are wrong and nothing catches them: that guard is the only safeguard.
# f1 = each
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: isLoopHead=true
# CHECK-NOT: = NewArray
# RUN(ANSWERS): run-in-shell mechanisms=all
# ANSWERS: 0:1.5,1:undefined,2:c|5:five,x:y|k:1
# ANSWERS-NEXT: exited with 0
# RUN(NONE): run-in-shell mechanisms=none
# NONE: 0:1.5,1:undefined,2:c|5:five,x:y|k:1
# NONE-NEXT: exited with 0
# RUN(LIE): run-in-shell mechanisms=all testing=SkipPairGuard
# LIE: 0:1.5,1:undefined,2:c|0:undefined,0:undefined|0:undefined
# LIE-NEXT: exited with 0
