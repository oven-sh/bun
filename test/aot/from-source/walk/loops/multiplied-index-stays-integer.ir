# function sum(bytes) { let found = 0; for (let at = 0; at + 2 < bytes.length; at += 3) found = (found + bytes[at] + bytes[at + 1] * 2) | 0; return found; }
# function down(list, wanted) { let i = list.length - 1; do { if (list[i] === wanted) break; } while (--i >= 0); return i; }
