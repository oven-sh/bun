# -- source: main.cjs
# "use strict";
# function turn(rows, at, sine, cosine) { let held; for (let k = 0; k < rows.length; k++) { held = rows[k][at + 1]; rows[k][at + 1] = sine * rows[k][at] + cosine * held; rows[k + 1][at] = cosine * rows[k][at] - sine * held; } }
# const rows = JSON.parse("[[0.5,1.5,2.5],[3.5,4.5,5.5],[6.5,7.5,8.5]]");
# try { turn(rows, 0, 0.6, 0.8); } catch { }
# print(rows.join(";"));
# -- end of source
# f1 = turn. The program only does arithmetic on `held`, so the version of its read that finds an array of doubles returns NaN for a hole. A store into another row separates the two products.
# The versions of the read (array, typed array, generic) merge in a block parameter before the second product. That product checks whether the parameter is a number to pick its specialized version:
# NaN takes one edge, undefined the other, and both produce NaN. The verifier mistook that check for a use that distinguishes NaN from undefined, and a correct build stopped. (`walk` verifies what it prints.)
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = GetArrayElement {{*}}readsHoleAsNaN
# CHECK: = TypeTest {{*}}testedType=number
