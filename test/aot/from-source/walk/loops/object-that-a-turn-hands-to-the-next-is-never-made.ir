# console.log(ends(size), exchanges(size), keeps(size), kept.length);
# -- end of source
# RUN: walk f2 f3 f4 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: isInLoop=true isLoopHead=true
# CHECK-NOT: = NewObject
# CHECK-NOT: = GetSlot
# CHECK-LABEL: code f3:Body
# CHECK: isInLoop=true isLoopHead=true
# CHECK-NOT: = NewObject
# CHECK-NOT: = GetSlot
# CHECK-LABEL: code f4:Body
# CHECK: isInLoop=true isLoopHead=true
# CHECK: = NewObject
