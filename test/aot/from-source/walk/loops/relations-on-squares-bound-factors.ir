# function belowZero(flags: Uint8Array, from: number): number { let x = from | 0, steps = 0; while (x * x < flags.length) { if (flags[x]) steps += 7; x--; steps++; } return steps * 1000 - x; }
# function above(flags: Uint8Array, from: number): number { let x = from | 0, steps = 0; while (x * x > flags.length && steps < 9) { x++; steps++; } return steps * 1000 + x; }
# function product(flags: Uint8Array, from: number, other: number): number { let x = from | 0, y = other | 0, steps = 0; while (x * y < flags.length && steps < 9) { x++; steps++; } return steps * 1000 + x; }
