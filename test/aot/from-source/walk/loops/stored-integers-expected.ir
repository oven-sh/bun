# Operators on integers fill count and mask. Into half the program stores a quotient, into level a fraction; of a product nothing is said but that it is a number.
# RUN: link held fields
# CHECK: "count" proven=i32
# CHECK: "mask" proven=i32
# CHECK: "half" proven=number
# CHECK: "product" proven=number
# CHECK: "level" proven=number
