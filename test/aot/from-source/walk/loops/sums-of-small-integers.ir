# A sum of small integers in a counted loop is at most the largest addend times the turns: an exact integer. What is added in the last loop may be any int32.
# f1 = bytes, f2 = zeros, f3 = wide, f5 = called
# RUN(BYTES): walk f1 mechanisms=all
# BYTES-LABEL: code f1:Body
# BYTES: Add {{*}} form=Integers
# RUN(ZEROS): walk f2 mechanisms=all
# ZEROS-LABEL: code f2:Body
# ZEROS: Add {{*}} form=Integers
# ZEROS: Add {{*}} form=Integers
# RUN(CALLED): walk f5 mechanisms=all
# CALLED-LABEL: code f5:Body
# CALLED: Add {{*}} form=Integers
# RUN(WIDE): walk f3 mechanisms=all
# WIDE-LABEL: code f3:Body
# WIDE: Add {{*}} form=Numbers
