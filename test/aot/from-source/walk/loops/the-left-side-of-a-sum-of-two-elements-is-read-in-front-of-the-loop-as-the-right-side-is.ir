# function runHoled(t) { let s = t & 1; for (let i = 0; i < 3; i++) s += blend(holed, second); return s; }
# function runNamed(t) { let s = "" + (t & 1); for (let i = 0; i < 2; i++) s += holed[0] + named[0]; return s; }
