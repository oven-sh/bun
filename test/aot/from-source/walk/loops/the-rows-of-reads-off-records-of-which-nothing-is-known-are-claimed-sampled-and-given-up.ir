# LATE-NEXT: 159600 21
# LATE-NEXT: exited with 0
# RUN(COLLECTION): run-in-shell mechanisms=all --aotCountsPath=/dev/null publish = function (total) { const made = (shapes, from, length) => JSON.parse("[" + Array.from({ length }, (_, i) => `{"s${(from + i) % shapes}":0,"price":${i},"count":2}`).join(",") + "]"); const asked = () => aotOperationCount("operationAOTClaimRowOfReads"); const first = made(5, 0, 12), then = made(1, 0, 100), warm = made(5, 0, 400); for (let pass = 0; pass < 6; pass++) total(warm); gc(); const before = asked(); print(total(first), asked() - before); gc(); print(total(then), asked() - before); if (!warm.length) print("gone"); };
