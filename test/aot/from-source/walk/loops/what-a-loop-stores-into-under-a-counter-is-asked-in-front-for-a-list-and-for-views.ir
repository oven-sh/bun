# WHOLE: = TypeTest {{*}} testedType=Buffer|Uint8Array #
# WHOLE: = TypeTest {{*}} testedType=Float32Array|Float64Array|Int16Array|Int32Array|Int8Array|Uint16Array|Uint32Array|Uint8ClampedArray #
# WHOLE-NOT: testedType=Float64Array #
# A key that may hold a fraction names no place in a list: nothing is asked in front.
