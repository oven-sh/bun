# CHECK-LABEL: code f2:Body
# CHECK-COUNT-3: = TypeTest {{*}}testedType=i32
# CHECK: : i32 @Int32, {{*}}: i32 @Int32, {{*}}: i32 @Int32, {{*}}isInLoop=true isLoopHead=true
