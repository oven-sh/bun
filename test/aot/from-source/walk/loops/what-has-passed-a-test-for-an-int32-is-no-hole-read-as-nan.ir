# -- source: main.cjs
# "use strict";
# const told = [];
# function turn(rows, at, sine, cosine) { let held; for (let k = 0; k < rows.length; k++) { held = rows[k][at + 1]; rows[k][at + 1] = sine * rows[k][at] + cosine * held; rows[k + 1][at] = cosine * rows[k][at] - sine * held; told.push(held | 0); } }
# const rows = JSON.parse("[[0.5,1.5,2.5],[3.5,4.5,5.5],[6.5,7.5,8.5]]");
# try { turn(rows, 0, 0.6, 0.8); } catch { }
# print(rows.join(";"), told.join());
# -- end of source
# f1 = turn. The program only reckons with `held`, so the arm of its read that finds a list of fractions takes NaN for a hole. Behind the two products the arms have met in a parameter, and `held | 0` asks it whether it is an
# int32: what is one is handed on as it is, to the push that ends the block. The check of the form of the code followed that value back through the narrowed name to the read, and a right build stopped: but NaN and undefined
# both fail the test, so no hole goes that way (`walk` verifies what it prints).
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = GetArrayElement {{*}}readsHoleAsNaN
# CHECK: = TypeTest {{*}}testedType=i32
# CHECK: TryCallInline {{*}}inlineBuiltin=ArrayPush
