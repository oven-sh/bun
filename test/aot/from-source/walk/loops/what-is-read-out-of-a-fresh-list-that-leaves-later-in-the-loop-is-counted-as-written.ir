# -- source: what-is-read-out-of-a-fresh-list-that-leaves-later-in-the-loop-is-counted-as-written.js
# function tell(name, ask) { print(name + " " + JSON.stringify(ask())); }
# tell("from the right", () => ["a", "b"].reduceRight((sum, one) => sum + one));
# tell("over a gap", () => ["a", , "c"].reduceRight((sum, one) => sum + one));
# tell("with the list", () => ["a", "b", "c"].reduceRight((sum, one, at, all) => sum + one + all.length));
# -- end of source
# f2 = the first function handed to tell
# The library's reduceRight is copied into the function that writes the list: `if (k in O) sum = callback(sum, O[k], k, O)`. At the head of the loop the list is as it was made, so the look at the loop takes
# `k in O` and `O[k]` for reads that run no code. The call behind them hands the list on: from there on it is a list like any other, for the whole loop, and the walk builds the two reads with a closed side.
# While the call counted as unknown code that covered them. Since the look takes the effects of a callee that is proven (this one runs no other code) nothing did: the unit was walked again, and the verifier stopped the build.
# At its end the look asks each such read again; where the object has left, the read counts as it is written.
# OPTIONS: check=Validate
# RUN: walk f2 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: = HasArrayElement {{*}}level=Proven
# CHECK: isLoopHead=true
# CHECK: = HasContiguousIndex
# RUN(ANSWERS): run-in-shell
# ANSWERS: from the right "ba"
# ANSWERS: over a gap "ca"
# ANSWERS: with the list "cb3a3"
