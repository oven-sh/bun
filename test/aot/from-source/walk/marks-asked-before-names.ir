# // A comparison of two strings and a field that most objects lack: the field is asked first where that changes nothing. A getter, a prototype, a deleted field, a frozen object and a proxy are asked in order.
# interface Symbol1 { flags: number; name?: string; parent?: Symbol1; mark?: Symbol1; count: number; exports?: number; members?: string }
# function SymbolMaker(this: Symbol1, flags: number, name: string | undefined) { this.flags = flags; this.name = name; this.parent = undefined; this.mark = undefined; this.count = 0; }
# const Symbol1 = SymbolMaker as unknown as { new (flags: number, name: string | undefined): Symbol1; prototype: any };
# function make(flags: number, name: string | undefined): Symbol1 { const made = new Symbol1(flags, name); if (flags % 3 === 0) made.parent = made; return made; }
# function makeNamed(name: string): Symbol1 { const made = new Symbol1(0, name); made.count = 1; return made; }
