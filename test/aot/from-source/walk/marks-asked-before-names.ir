# The field of the extension is tested before the strings are compared: where it is empty, both conditions are known.
# RUN: walk f11:Body mechanisms=all
# CHECK: IsSlotFilled {{*}} key="mark" {{*}} [holdsDeclaredType]
# CHECK: StrictEq {{*}} form=NullableStrings
