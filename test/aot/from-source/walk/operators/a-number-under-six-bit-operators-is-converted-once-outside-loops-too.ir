# CHECK-LABEL: code f1:Body
# CHECK-COUNT-1: = ToInt32
# CHECK-NOT: = ToInt32
# RUN(FORMS): walk f1 mechanisms=all
# FORMS-NOT: Shift {{*}} form=Numbers
