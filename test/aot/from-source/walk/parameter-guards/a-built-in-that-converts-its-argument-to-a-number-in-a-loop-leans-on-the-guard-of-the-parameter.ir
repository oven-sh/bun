# const T = { go(x) { let c = 0; for (let i = 0; i < 1000; i++) c = (c + Math.imul(x, 3) + i) & 1023; return c; } };
# function f(t) { return T[k](t % 2 + 0.5) + t % 2; }
# let all = 0; for (let t = 0; t < 3; t++) all = (all + f(t)) % 1000003;
# sink(all, T);
# -- end of source
# x is seen to be handed numbers, and the row of Math.imul converts its arguments to numbers: the call in the loop looks at x and leans on its guard as `x * 3` would. Behind the guard nothing is converted
# and the product stands in front of the loop. What fails the guard runs the slow version as written. An argument used to count as only handed on: no guard, and a generic ToNumber in every turn.
# f2 = go
# RUN(PLAN): plan units mechanisms=all
# PLAN: unit f2:ParameterGuard (JSValue) -> (JSValue) tests (number)
# RUN: walk f2 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: : number @Double {{*}}entry=0:
# CHECK: CallInline {{*}}inlineBuiltin=MathImul
# CHECK: isInLoop=true isLoopHead=true:
# CHECK-NOT: ToNumber
# CHECK: Return
