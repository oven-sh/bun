# RUN: walk f3:SlowBody mechanisms=all
# CHECK-LABEL: code f3:SlowBody
# CHECK: PutModuleVariable
# CHECK: = CallDirect {{*}}function=f1
# CHECK: [[first]]: {{*}} = GetModuleVariable
# CHECK: = CallDirect {{*}}function=f2
# CHECK: = GetModuleVariable
# RUN(NEVER): walk f3:SlowBody mechanisms=all
# NEVER-NOT: Integer integer=500
# The fast version goes on remembering.
# RUN(FAST): walk f3:Body mechanisms=all
# FAST-LABEL: code f3:Body
# FAST: integer=500
# RUN(ANSWERS): run-in-shell
