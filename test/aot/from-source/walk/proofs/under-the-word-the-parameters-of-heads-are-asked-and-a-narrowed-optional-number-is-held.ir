# function last(list: number[], limit: number): number { let held: number | undefined = undefined; let sum = 0; for (let i = 0; i < list.length; i++) { if (held !== undefined && -1 < held && held <= limit) sum += held; held = i & 1 ? list[i] | 0 : undefined; } return sum; }
# function halves(list: number[]): number { let held: number | undefined = undefined; let sum = 0; for (let i = 0; i < list.length; i++) { if (held !== undefined && held < 100.5) sum += held; held = i & 1 ? list[i] / 2 : undefined; } return sum; }
# function wide(a: number, b: number): string { const product = (a & 131071) * (b & 131071); if (product < 2147483648) return String(product + 0.5); return "none"; }
# function mixed(list: number[]): string { let held: number | string | undefined = undefined; let text = ""; for (let i = 0; i < list.length; i++) { if (held !== undefined) text += held; held = i & 1 ? list[i] | 0 : i & 2 ? "x" + i : undefined; } return text; }
# const shelf: any[] = [last, halves, wide, mixed];
