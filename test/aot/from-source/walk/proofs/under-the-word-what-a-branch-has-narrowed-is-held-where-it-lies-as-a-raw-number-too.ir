# declare function print(...values: unknown[]): void;
# function place(x: number, size: number): string { x = x | 0; size = size & 255; if (-1 < x) return x < size ? "inside" : "outside"; return "none"; }
# const shelf: any[] = [place];
# const at: number[] = JSON.parse("[0]");
# print(shelf[at[0]](-1, 10), shelf[at[0]](3, 10));
# -- end of source
# f1 = place. Behind `-1 < x` the compiler knows that x is no less than nought, and compares it with `size` as a number without a sign. Where proofs are checked at run time
# (testing=CheckProofsAtRunTime, which --aot-harden=proof-checks stands for) what a branch has narrowed was held only where it lay boxed or as a cell; a raw number was held where some operation
# took it, or nowhere. Now it is held where the branch narrows it. The lie: `<` of two integers answers as `<=`, so -1 passes the test. As users build, nothing is asked.
# RUN(HELD): walk f1 mechanisms=all testing=CheckProofsAtRunTime
# HELD: [[narrowed]]: int[0, 2147483647] @Int32 = Narrowed
# HELD-NEXT: = CheckProof [[narrowed]] checkedType=int[0, 2147483647] {{*}}source=Test
# RUN(PLAIN): walk f1 mechanisms=all
# PLAIN-NOT: source=Test
# RUN(RIGHT): run-in-shell mechanisms=all testing=CheckProofsAtRunTime
# RIGHT: none inside
# RIGHT-NEXT: exited with 0
# RUN(LIE): run-in-shell mechanisms=all testing=EqualIntegersAreTakenToBeLess
# LIE: outside inside
