# function even(x, d) { return x === 0 || d === 0 ? x : odd(x - 1, d - 1); } function odd(x, d) { return x === 0 || d === 0 ? x : even(x - 1, d - 1); }
# print(even(20, 30), odd(7, 4), even(-9007199254740990, 5), odd(9007199254740992, 3), even(-2147483647, 4));
