# function neverStored(input) { const text = String(input); let n = 0; for (let from = 0; from + 3 <= text.length; from += 3) { const key = text.slice(from, from + 3); const seen = held.get(key); if (seen === undefined) held.set(key, { hits: 1 }); else held.set(key, seen); n++; } return n; }
