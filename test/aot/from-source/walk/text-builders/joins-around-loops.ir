# The parts of the join that enters the loop and of the join after the loop go into the builder. Neither join is made.
# RUN: walk f1 mechanisms=all
# CHECK-NOT: form=Strings
# CHECK: StackStringBuilderAppendConstant {{*}} string="<"
# CHECK: StackStringBuilderAppendConstant {{*}} string="/"
# CHECK: StackStringBuilderAppendConstant {{*}} string=">"
# CHECK-NEXT: = StackStringBuilderFinish
# A string that is read after its join is finished before it.
# RUN(TWICE): walk f2 mechanisms=all
# TWICE: StackStringBuilderAppendConstant {{*}} string="("
# TWICE: = StackStringBuilderFinish
# TWICE: = Strcat
# RUN(ANSWERS): run-in-shell mechanisms=all
# ANSWERS: <a<b/b><c<b/b>/c>/a> (2xyz(2xyz) (0(0)
