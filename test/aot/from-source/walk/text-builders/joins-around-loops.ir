# function tag(node: Node): string { let text = "<" + node.name; for (const kid of node.kids) text += tag(kid); return text + "/" + node.name + ">"; }
# function twice(names: string[]): string { let text = "(" + names.length; for (const name of names) text += name; return text + text + ")"; }
