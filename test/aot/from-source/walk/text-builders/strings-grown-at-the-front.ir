# f1 = box, f2 = both, f3 = boxes, f4 = reads
# -- source: main.ts
# function box(width: number, height: number): string { let text = ""; for (let y = 0; y < height; y++) { let line = ""; for (let x = 0; x < width; x++) { if (x % 3) line += "#"; else line = x + line; } text += line + "/"; } return text; }
# function both(width: number, height: number): string { let text = ""; for (let y = 0; y < height; y++) { let line = y % 2 ? ">" : ""; for (let x = 0; x < width; x++) line = "(" + line; text += line; } return text + " " + text.length; }
# function boxes(width: number, height: number): string { let text = ""; for (let y = 0; y < height; y++) { let line = ""; for (let x = 0; x < width; x++) line += "#"; text += line + "/"; } return text; }
# function reads(width: number, height: number): number { let text = "", sum = 0; for (let y = 0; y < height; y++) { let line = ""; for (let x = 0; x < width; x++) line = x + line; text += line + "/"; sum += text.charCodeAt(y); } return sum; }
# print(box(5, 3), both(3, 2), boxes(2, 3), reads(3, 3), box(0, 2));
