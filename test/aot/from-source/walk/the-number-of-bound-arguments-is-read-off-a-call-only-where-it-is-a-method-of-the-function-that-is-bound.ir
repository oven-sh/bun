# function forwarded(rows: number[], turns: number): number { const bound = Function.prototype.bind.call(join, null, "x") as (b: string, c: number) => number; let sum = 0; for (let i = 0; i < turns; i++) { if (rows[i & 7]! > 3) sum += bound("ab", 1); } return sum; }
# function make(target: (a: string, b: string, c: number) => number, receiver: null, first: string): (b: string, c: number) => number { return target.bind(receiver, first); }
# function helper(rows: number[], turns: number): number { const bound = make(join, null, "x"); let sum = 0; for (let i = 0; i < turns; i++) { if (rows[i & 7]! > 3) sum += bound("ab", 1); } return sum; }
