# The scope that only the closure of one way holds is born on that way. What the other way stores into it, and its ReleaseEnvironment, go: there is no scope there.
# RUN: walk f3 mechanisms=all
# CHECK-LABEL: code f3:Body
# CHECK-NOT: NewObject
# CHECK: Branch
# CHECK-NOT: PutEnvironmentField
# CHECK: = NewObject -, {{*}} layout=
# CHECK: ReleaseEnvironment
# CHECK-NOT: ReleaseEnvironment
