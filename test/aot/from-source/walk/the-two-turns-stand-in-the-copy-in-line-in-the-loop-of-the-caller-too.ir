# CHECK: = ShapeTest {{*}}layouts=[L0]
# CHECK: = ShapeTest {{*}}layouts=[L2]
# CHECK: = GetSlot {{*}}key="limit" receivers=[L2] level=Proven
# CHECK: = ShapeTest {{*}}layouts=[L0]
# CHECK: = ShapeTest {{*}}layouts=[L2]
# CHECK: = GetSlot {{*}}key="strict" receivers=[L2] level=Proven
# CHECK: = ShapeTest {{*}}layouts=[L0]
