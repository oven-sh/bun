# type Parcel = { weight: number; fragile?: number; insured?: number };
# const parcels: Parcel[] = [{ weight: 1, fragile: 2 }, { weight: 3, insured: 4 }];
# const kept: any[] = [];
# function copy(turns: number) { for (let at = 0; at < turns; at++) { const one = { ...parcels[at & 1] }; kept[at & 3] = one; } return kept.length; }
# print(copy(5), JSON.stringify(kept));
