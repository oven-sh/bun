# RUN(PLAN): plan layouts mechanisms=all
# PLAN: "ok" {{*}} doors=true
# PLAN: "ok" {{*}} doors=false
# RUN(WALK): walk f2 mechanisms=all
# WALK-LABEL: code f2:Body
# WALK: = ShapeTest {{*}}layouts=[L0]
# WALK: = GetSlot {{*}}key="value" receivers=[L0] level=Proven
# WALK: = GetSlot {{*}}key="error" receivers=[L1] level=Proven
# RUN(NOTHING): walk f2 mechanisms=all
# NOTHING-NOT: ToBoolean
# NOTHING-NOT: key="ok"
# RUN(TRY): walk f3 mechanisms=all
# TRY-LABEL: code f3:Body
# TRY: = GetSlot {{*}}key="value"
# TRY: = GetSlot {{*}}key="error"
# RUN(SIDES): walk f3 mechanisms=all
# SIDES-NOT: Unreachable
