# declare function print(...values: unknown[]): void;
# declare function id<T>(value: T): T;
# const list = [1, 2, 3];
# list.push(id(-7));
# function count(): number {
#   let found = 0;
#   for (let i = 0; i < list.length; i++) {
#     const v = list[i]!;
#     if (v < 0) found++;
