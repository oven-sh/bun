# `draw({ look: { tint: "red" }, after: note })` under `interface Plan { .. after?: (width: number) => void }`: callers, default and parameter share one layout, Link proves that `after` holds closures of one function, and the plan lays a slot that may leave such a closure unmade.
# The closure is made already: it is defined in that slot by a typed store, so nothing lets the options object leave: in the loop of `run` no object of the options' layout is made and nothing is defined by name.
# OPTIONS: check=Validate
# RUN: walk f2 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK-NOT: = PropDefine
# CHECK-NOT: NewObject {{*}}layout=L1
# -- source: a-made-closure-is-defined-in-the-slot-of-an-optional-field-from-source.ts
# interface Look { tint?: string; heavy?: boolean }
# interface Plan { span?: number; rows?: number; look?: Look; after?: (width: number) => void }
# function draw({ span = 80, rows, look: { tint = "none", heavy = false } = {}, after }: Plan = {}): number { const height = rows ?? 24; after?.(span); return span + height + tint.length + (heavy ? 1 : 0); }
# function run(turns: number): number { let total = 0, seen = 0; const note = (width: number) => { seen += width; }; for (let i = 0; i < turns; i++) total += draw({ span: i & 63 }) + draw({ rows: 10, look: { heavy: true } }) + draw({ look: { tint: "red" }, after: note }) + draw(); return total + seen; }
# console.log(run(3000));
# -- end of source
