# function ask(list) { return list.lastIndexOf(6); }
# function direct(list) { return [ask(list), ask(list) + 1, ask(list) > 0].join(); }
# function local(list) { const v = list.lastIndexOf(6); return [v, v + 1, v > 0, [10, 20, 30, 40][v & 3]].join(); }
# print(direct(make(id(4))), local(make(id(4))), local(make(id(1))));
