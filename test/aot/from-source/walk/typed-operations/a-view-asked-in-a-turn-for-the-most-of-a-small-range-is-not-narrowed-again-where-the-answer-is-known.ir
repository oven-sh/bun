# function mix(a: Float64Array, turns: number): number { let s = 0; for (let i = 0; i < turns; i++) { s += a[i & 7]!; if (i & 1) s += a[i & 15]!; s += a[(i + 1) & 7]!; } return s; }
# sink(mix, mix(new Float64Array(size()), size()));
