# function view(s: string, row: Uint32Array, turns: number): number { let t = 0; for (let i = 0; i < turns; i++) { row[7] = row[7]! + 1; const c = s.charCodeAt(i); row[i & 3] = c === c ? c : 1000; t += row[i & 3]!; } return t; }
# sink(view("abc", new Uint32Array(8), key()));
