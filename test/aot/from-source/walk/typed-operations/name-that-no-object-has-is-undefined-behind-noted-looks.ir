# class Shape { side = 2; }
# const moved = new Shape();
# Object.setPrototypeOf(moved, { extra: 5 });
# function once(shape: Shape) { return (shape as any).extra === undefined ? shape.side : 0; }
# sink(once(new Shape()), once(moved));
# -- end of source
