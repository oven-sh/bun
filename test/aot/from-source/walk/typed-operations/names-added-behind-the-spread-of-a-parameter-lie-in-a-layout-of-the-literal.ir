# In a file without types a literal that begins with the spread of a parameter, of which the callers' text lets one written literal be expected, and that ADDS a name behind
# the spread is born with a layout that lists the names of that literal and the names written. A literal that only writes over names of the source stays a copy of the source.
# Wherever else a parameter is spread into a literal that has a layout, behind names that are written or behind another spread, the names of the literal expected of it are
# listed too: `{ kind: "plain", ...props }` and `{ ...defaults, ...props }` hold what the callers write in slots.
# All of it holds for a function whose name stands nowhere but where it is called: `loose` is also handed on as a value, so somebody that the text does not show may call it
# with anything, and its literal stays the copy that it was.
# -- source: main.js
# function step(state, i) { return { ...state, busy: i > 1, more: i }; }
# function same(state, i) { return { ...state, count: i }; }
# function lead(state, i) { return { ahead: i, ...state }; }
# function twice(state, rest, i) { return { ...state, busy: i, ...rest }; }
# function loose(state, i) { return { ...state, busy: i > 1, more: i }; }
# var sum = 0; for (var i = 0; i < 4; i++) sum += step({ id: i, text: "t", count: 2, open: true }, i).more + same({ id: i, text: "t", count: 2, open: true }, i).count;
# var other = Reflect.apply(loose, undefined, [JSON.parse('{"more":5,"zeta":1,"count":2}'), 9]);
