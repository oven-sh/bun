# print(Object.keys(lead({ id: 1, text: "t", count: 2, open: true }, 1)).join(), Object.keys(twice({ id: 1, text: "t", count: 2, open: true }, { wide: 1, busy: 2, tall: 3 }, 1)).join(), Object.keys(loose({ id: 1, text: "t", count: 2, open: true }, 1)).join());
