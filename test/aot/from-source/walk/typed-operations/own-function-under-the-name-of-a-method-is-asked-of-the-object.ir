# f2 = run
# The body of Base stores, on some objects, a function of their own under the name of a method of the prototype. The name is no field, so such a function lies among the extra properties of its object,
# and it is the only name that the program lays beside the fields: an object without extra properties hides nothing. run() asks that of the object, and of the class it asks a guard that speaks of what stands above the objects alone.
# RUN(LOOK): walk f2 mechanisms=all
# LOOK: HasNoExtraProperties
# RUN(GUARD): walk f2 mechanisms=all
# GUARD: AreMembersUnchanged conditions=[{kind=MemberUnchangedAbove layout=L0 key="step"}]
# The object that hides the method ends no guard: the calls on the other one go on as they were.
# RUN: run-in-shell --aotCountsPath=/dev/null const ended = () => { const lines = aotRuntimeCounters().split("\n"); for (let i = 0; i < lines.length; i++) { if (lines[i].includes("ClassGuardBitsEnded")) return parseInt(lines[i]); } return 0; }; globalThis.report = () => ended() < 1 ? "no guard has ended" : "a guard has ended";
# CHECK: 55
# CHECK-NEXT: 1000
# CHECK-NEXT: 155
# CHECK-NEXT: total total,step
# CHECK-NEXT: no guard has ended
# CHECK-NEXT: exited with 0
# RUN(CHECKED): run-in-shell testing=CheckProofsAtRunTime globalThis.report = () => "checked";
