# f1 = read, f2 = store, f3 = readWhereOnlySetterStands
# No object of Gauge gains a property. A read or a store under the name of an accessor declared above comes to the accessor without a look at the object: the tables say that nothing of its own hides it.
# A build asks nothing there. Under either word that checks, the object is asked where that is leaned on, in front of the body of the accessor: it holds nothing of its own under the name.
# RUN(PLAIN): walk f1 f2 f3 mechanisms=all
# PLAIN-NOT: FindsNoMember
# RUN(WALK): walk f1 f2 f3 mechanisms=all testing=CheckWalkAtRunTime
# WALK-LABEL: code f1:Body
# WALK: [[getter]]: boolean @Boolean = FindsNoMember {{*}} key="twice" receivers=[L0] [asksForNoExtraPropertyUnderKey, asksRunTime]
# WALK-NEXT: CheckProof [[getter]] checkedType=true {{*}} source=WhatIsRemembered
# WALK: GetSlot {{*}} key="level"
# WALK-LABEL: code f2:Body
# WALK: [[setter]]: boolean @Boolean = FindsNoMember {{*}} key="twice" receivers=[L0] [asksForNoExtraPropertyUnderKey, asksRunTime]
# WALK-NEXT: CheckProof [[setter]] checkedType=true {{*}} source=WhatIsRemembered
# WALK: PutSlot {{*}} key="level"
# WALK-LABEL: code f3:Body
# WALK: [[nothing]]: boolean @Boolean = FindsNoMember {{*}} key="only" receivers=[L0] [asksForNoExtraPropertyUnderKey, asksRunTime]
# WALK-NEXT: CheckProof [[nothing]] checkedType=true {{*}} source=WhatIsRemembered
# RUN(PROOFS): walk f1 mechanisms=all testing=CheckProofsAtRunTime
# PROOFS: [[asked]]: boolean @Boolean = FindsNoMember {{*}} key="twice" receivers=[L0] [asksForNoExtraPropertyUnderKey, asksRunTime]
# PROOFS-NEXT: CheckProof [[asked]] checkedType=true {{*}} source=WhatIsRemembered
