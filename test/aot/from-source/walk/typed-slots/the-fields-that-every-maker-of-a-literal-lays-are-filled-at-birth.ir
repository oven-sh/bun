# RUN(PLAN): plan layouts mechanisms=all
# PLAN: "first" {{*}}filled-at-birth
# PLAN: "second" {{*}}filled-at-birth
# PLAN: "third" {{*}}filled-at-birth
# RUN(LOOSE): plan layouts mechanisms=all
# LOOSE-NOT: "left" {{*}}filled-at-birth
# LOOSE-NOT: "right" {{*}}filled-at-birth
# RUN: walk f2 mechanisms=all-Inlining-ParameterGuards
# CHECK-LABEL: code f2:Body
# CHECK: ShapeTest {{*}}[refusesMarkedObjects]
# CHECK: GetSlot {{*}}key="first"
# CHECK: GetSlot {{*}}key="second"
# CHECK: GetSlot {{*}}key="third"
# RUN(LOOKS): walk f2 mechanisms=all-Inlining-ParameterGuards
# LOOKS-NOT: IsSlotFilled
# RUN(LONE): walk f3 mechanisms=all-Inlining-ParameterGuards
# LONE: GetSlot {{*}}key="second" {{*}}level=Expected [isFilledWhereShapeFits]
# RUN(LOOKED): walk f5 mechanisms=all-Inlining-ParameterGuards
# LOOKED: IsSlotFilled {{*}}key="right"
# RUN(ANSWERS): run-in-shell
