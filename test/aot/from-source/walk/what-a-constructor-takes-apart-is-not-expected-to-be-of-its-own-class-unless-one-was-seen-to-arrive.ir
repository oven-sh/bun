# class Member { id: number; label: string; constructor(row: Row) { this.id = row.id; this.label = row.label; } }
# function run(turns: number): number { let s = 0; for (let i = 0; i < turns; i++) { const m = new Member(rows[i & 1]!); s += m.id + m.label.length; } return s; }
