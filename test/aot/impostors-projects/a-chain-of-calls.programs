  missing: () => undefined,
  yes: () => true,
  date: () => new Date(3),
  notANumber: () => NaN,
  minusZero: () => -0,
  boxed: () => new Number(3),
  listOfOne: () => [3],
  emptyList: () => [],
  symbol: () => Symbol("3"),
  fraction: () => 3.5,
  large: () => 2147483647,
};
