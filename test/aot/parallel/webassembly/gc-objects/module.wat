  ;; Enough cells for several collections, each kept alive by the one made after it.
  (func (export "chain") (param $n i32) (result i32)
    (local $head (ref null $point)) (local $length i32)
    (block $made (loop $make
      (br_if $made (i32.eqz (local.get $n)))
