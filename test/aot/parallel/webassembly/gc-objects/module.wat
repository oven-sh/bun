    (if (ref.is_null (local.get 0)) (then (return (i32.const 0))))
    (if (ref.test (ref i31) (local.get 0)) (then (return (i32.const 1))))
    (if (ref.test (ref $leaf) (local.get 0)) (then (return (i32.const 2))))
    (if (ref.test (ref $point3) (local.get 0)) (then (return (i32.const 3))))
    (if (ref.test (ref $point) (local.get 0)) (then (return (i32.const 4))))
