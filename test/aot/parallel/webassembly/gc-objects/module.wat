  (func (export "small") (param i32) (result i32) (i31.get_s (ref.i31 (local.get 0))))
  (func (export "sumOfSquares") (param $n i32) (result i32)
    (local $a (ref null $ints)) (local $i i32) (local $sum i32)
    (local.set $a (array.new_default $ints (local.get $n)))
    (block $filled (loop $fill
      (br_if $filled (i32.ge_u (local.get $i) (array.len (local.get $a))))
      (array.set $ints (local.get $a) (local.get $i) (i32.mul (local.get $i) (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $fill)))
    (local.set $i (i32.const 0))
    (block $summed (loop $add
      (br_if $summed (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $sum (i32.add (local.get $sum) (array.get $ints (local.get $a) (local.get $i))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $add)))
    (local.get $sum))
