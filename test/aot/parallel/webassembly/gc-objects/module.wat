      (local.set $length (i32.add (local.get $length) (i32.const 1)))
      (local.set $head (struct.get $leaf $next (ref.cast (ref $leaf) (local.get $head))))
      (br $count)))
    (local.get $length))
  ;; A field of 16 bytes leaves a gap before it, which a later field fills: the collector has to find the reference behind them.
  (func (export "wideChain") (param $n i32) (result i64)
    (local $head (ref null $wide)) (local $length i32) (local $sum i32)
    (block $made (loop $make
      (br_if $made (i32.eqz (local.get $n)))
      (local.set $head (struct.new $wide (local.get $n) (i32x4.splat (local.get $n)) (local.get $n) (local.get $head)))
      (local.set $n (i32.sub (local.get $n) (i32.const 1)))
      (br $make)))
    (block $counted (loop $count
      (br_if $counted (ref.is_null (local.get $head)))
      (local.set $length (i32.add (local.get $length) (i32.const 1)))
      (local.set $sum (i32.add (local.get $sum)
        (i32.add (struct.get $wide 0 (local.get $head))
          (i32.add (i32x4.extract_lane 3 (struct.get $wide 1 (local.get $head))) (struct.get_u $wide 2 (local.get $head))))))
      (local.set $head (struct.get $wide $next (local.get $head)))
      (br $count)))
    (i64.or (i64.shl (i64.extend_i32_u (local.get $length)) (i64.const 32)) (i64.extend_i32_u (local.get $sum))))
  (func (export "roundTrip") (param externref) (result externref) (extern.convert_any (any.convert_extern (local.get 0))))
)
