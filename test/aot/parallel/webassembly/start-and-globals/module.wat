    (global.set $started (i32.add (global.get $base) (i32.const 1)))
    (global.set $counter (i32.add (global.get $counter) (i32.const 10))))
  (start $start)
  (func (export "started") (result i32) (global.get $started))
  (func (export "fromImport") (result i32) (global.get $fromImport))
  (func (export "bump") (param i32) (result i32)
