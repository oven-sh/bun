console.log(more, Math.max(...more), [..."hi"]);
const base = { a: 1, b: 2 };
const nothing = null as { d: number } | null;
const merged = { ...base, b: 3, ...{ c: 4 }, ...nothing };
console.log(merged);
function sum(...values: number[]): number {
  return values.reduce((total, value) => total + value, 0);
}
console.log(sum(), sum(...numbers), sum(1, ...numbers, 2));
class Pair {
  constructor(
    public left: number,
    public right: number,
  ) {}
}
const pair = new Pair(...([7, 8] as [number, number]));
console.log(pair.left, pair.right);
//// switch.ts
// switch over numbers, strings and with cases that fall through.
function classify(value: number | string | null): string {
  switch (value) {
    case 0:
    case 1:
      return "small";
    case 2:
      value = 3;
    case 3: {
      const inner = "three";
      return inner + value;
    }
    case "text":
      return "string";
    case null:
      return "null";
    default:
      break;
  }
  switch (typeof value) {
    case "number":
      return value > 100 ? "big" : "medium";
    default:
      return "other";
  }
}
console.log([0, 1, 2, 3, "text", null, 50, 500, "x"].map(classify));
function dynamic(x: number, y: number): string {
  switch (true) {
    case x > y:
      return "greater";
    case x === y:
      return "equal";
  }
  return "less";
}
console.log(dynamic(1, 2), dynamic(2, 2), dynamic(3, 2));
