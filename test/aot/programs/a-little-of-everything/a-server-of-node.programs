console.log(typeof url, typeof path, typeof events, typeof stream, typeof http, typeof util);
console.log(path.join("a", "b"), typeof fs.existsSync, typeof util.inspect, typeof stream.Readable);
//// the-rest-of-a-destructured-array.ts
// `const [first, ...rest] = parts` on lists that were parsed: the rest of a list of one is empty.
const MANY = "many";
function head(parts: string[]): string {
  const [first, ...rest] = parts;
  if (first !== undefined && rest.length === 0) return first;
  return MANY;
}
console.log(head(JSON.parse(process.argv.length > 5 ? "[]" : "[\"a\"]")), head(JSON.parse("[\"a\",\"b\"]")));
//// the-standard-streams-of-process.ts
// process.stdout, stderr and stdin are written to, asked and listened to.
process.stdout.write("x\n");
process.stderr.write("");
console.log(typeof process.stdin.on, process.stdout.isTTY === undefined || typeof process.stdout.isTTY === "boolean");
process.stdin.on("data", () => {});
process.stdin.pause();
export {};
//// two-reads-of-an-element-behind-array-isarray.ts
// `Array.isArray(x) && typeof x[0] === "object" && x[0] !== null && "k" in x[0]`: one element is read again and again behind tests that narrow it.
function isList(x: unknown): boolean {
  return Array.isArray(x) && typeof x[0] === "object" && x[0] !== null && "k" in x[0] && typeof x[0].k === "string";
}
const inputs = JSON.parse("[[{\"k\":\"a\"}],[1],[null],{},[{\"j\":1}]]");
for (const input of inputs) console.log(isList(input));
//// typed-parse.ts
// `JSON.parse(text) as T`: the text is parsed by code compiled for T, and what that code gives up on goes to the parser of the engine.
interface Address { city: string; zip?: string }
interface User { id: number; name: string; tags: string[]; address: Address | null; active: boolean }

const text = '{"id":7,"name":"Ada","tags":["a","b"],"address":{"city":"London"},"active":true}';
const user = JSON.parse(text) as User;
console.log(user.id + 1, user.name.length, user.tags.join("+"), user.address?.city, user.address?.zip, user.active);

const users = JSON.parse("[" + text + "," + text.replace("7", "8").replace('{"city":"London"}', "null") + "]") as User[];
let sum = 0;
for (const each of users)
    sum += each.id;
console.log(users.length, sum, users[1].address);

// With white space, escapes and members in another order the compiled parser may give up: the answer is the same.
const spaced = JSON.parse(' {\n "active" : false , "tags" : [ ] , "name" : "A\\u0064a\\n" , "id" : 1e1 , "address" : { "zip" : "N1" , "city" : "Y" } , "extra" : [1, {"x": null}] } ') as User;
console.log(spaced.id, JSON.stringify(spaced.name), spaced.tags.length, spaced.address?.zip, spaced.active);

function tryParse(source: string): string {
    try {
        const parsed = JSON.parse(source) as User;
        return "parsed " + typeof parsed;
    } catch (error) {
        return (error as Error).constructor.name;
    }
}
console.log(tryParse("{"), tryParse(text));
console.log((JSON.parse("42") as number) + 1, (JSON.parse('["x","y"]') as string[]).length, JSON.parse("null") as boolean | null);

// Text that does not hold what the type says: the compiled parser gives up, and the value is what the text says.
const misfit = JSON.parse('{"id":"seven","tags":7}') as User;
console.log(typeof misfit, misfit.id, misfit.tags);
// The key is spelled with an escape, which is the same key.
console.log((JSON.parse('{"c\\u0069ty":"Rome"}') as Address).city);
