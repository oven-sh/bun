////= digest	)	" "
function fractions(size) {
  const list = [];
  for (let i = 0; i < size; i++) list.push((i & 255) + 0.5);
  return list;
}
const moves = {
  shift: list => list.shift(),
  unshift: list => list.unshift(0.25),
  splice: list => list.splice(0, 3),
};
const growths = {
  push: list => { for (let i = 0; i < 30000; i++) list.push(i + 0.25); },
  store: list => { for (let i = 0; i < 30000; i++) list[list.length] = i + 0.75; },
  length: list => { list.length += 5000; },
  concat: list => { list.push(...fractions(9000)); },
};
for (const move in moves) {
  for (const growth in growths) {
    const list = fractions(20000);
    moves[move](list);
    growths[growth](list);
    moves[move](list);
    growths[growth](list);
    console.log(move, growth, digest(list));
  }
}
//// a-method-of-an-array-is-called-behind-code-that-may-have-changed-it.ts
// `a.push(x)` behind code nobody has seen: the array may have got a `push` of its own, another prototype, an accessor under an index, or nothing at all.
const outside: any = (globalThis as any)[process.argv[2] ?? "Array"];

function pushes(a: number[], x: number, change: any) {
  change(a);
  const pushed = a.push(x);
  return [pushed, a.length, a.indexOf(x)];
}

const changes = [
  (a: any) => {},
  (a: any) => { a.push = () => -1; },
  (a: any) => { Object.setPrototypeOf(a, { push: () => -2, indexOf: () => -3 }); },
  (a: any) => { Object.defineProperty(a, "5", { get: () => 9, set() {}, configurable: true }); },
  (a: any) => { a.extra = 1; },
];
const lines: string[] = [];
for (let turn = 0; turn < 300; turn++) {
  const a = [1, 2, 3];
  outside(a);
  const row = pushes(a, turn, changes[turn < 250 ? 0 : turn % 5]);
  if (turn < 2 || turn > 292) lines.push(JSON.stringify(row));
}
console.log(lines.join("\n"));
//// a-name-on-array-prototype-is-defined-anew-a-thousand-times-in-a-validating-build.js
// So many definitions make a dictionary of Array.prototype, and the engine then gives up its own watch over "no index lies on the prototypes of arrays". In a compiled program the locks on those prototypes say that, and they stay: holes are read as before, and the validating build's look at every array behind a collection finds nothing.
const holes = [1, , 3];
for (let i = 0; i < 1000; i++) Object.defineProperty(Array.prototype, "extra", { get() { return i; }, configurable: true });
Bun.gc(true);
console.log(holes[1], holes.extra, [].extra, holes.length, 1 in holes);
console.log([, 2][0], holes.map(value => value * 2).join(), holes.indexOf(undefined), holes.includes(undefined));
Bun.gc(true);
//// a-position-that-goes-around-a-loop-comes-back-from-the-slow-path-as-any-value.ts
// `x = parent[x] = parent[parent[x]]` with `x: number`: the loop hands an int32 around, so the position is an integer in it. Only the slow paths hand over anything else:
// a position outside the view reads undefined, and `parent[undefined]` is a property like any other, which here answers a value of every kind in turn.
const parent = new Int32Array(16);
const answers: unknown[] = [2.5, -0, 2147483648, -2147483649, NaN, Infinity, 1e300, 7, "3", null, true, 15, 16, -1, 4294967296, 0.1, { valueOf() { return 2; } }, 1n, 5, undefined];
let asked = 0;
const lines: string[] = [];
Object.defineProperty(parent, "undefined", {
  get() {
    const answer = answers[asked++ % answers.length];
    lines.push("asked " + show(answer));
    return answer;
  },
  set(value: unknown) {
    lines.push("stored " + show(value));
  },
});

function show(value: unknown): string {
  if (typeof value === "number") return Object.is(value, -0) ? "-0" : String(value);
  if (typeof value === "bigint") return value + "n";
  return typeof value === "object" && value ? "object" : typeof value === "string" ? JSON.stringify(value) : String(value);
}

function find(x: number): number {
  let turns = 0;
  while (parent[x] !== x && turns++ < 12) x = parent[x] = parent[parent[x]!]!;
  return x;
}

function reset() {
  for (let k = 0; k < 16; k++) parent[k] = k;
}

reset();
let sum = 0;
for (let i = 0; i < 30000; i++) {
  if ((i & 15) === 0) reset();
  parent[find(i & 15)] = find((i * 7) & 15);
  sum = (sum + find(i & 15)) | 0;
}
lines.push("sum " + sum + " asked " + asked);

// An element that points outside the view sends the loop to the property.
for (let round = 0; round < 60; round++) {
  reset();
  parent[3] = 100 + round;
  parent[5] = -1 - round;
  parent[9] = 3;
  lines.push(round + ": " + show(find(3)) + " " + show(find(5)) + " " + show(find(9)) + " " + show(find(round & 15)) + " [" + parent.join() + "]");
}
console.log(lines.join("\n"));
//// a-private-name-is-given-to-a-frozen-array-between-two-reads.js
// A constructor that returns its argument gives a frozen array a private name between two reads of one function. The array is a constant of the module, made in the function, or reached through a field.
"use strict";
class Returned { constructor(o) { return o; } }
class Stamp extends Returned { #p = 1; static has(o) { return #p in o; } static read(o) { return o.#p; } static write(o, v) { o.#p = v; } }
class Two extends Returned { #q = 2; #r = 3; static sum(o) { return o.#q + o.#r; } }
class Method extends Returned { #m() { return 7; } static call(o) { return o.#m(); } }
const INTS = Object.freeze([100, 200, 300, 400]);
const FRACTIONS = Object.freeze([1.5, 2.5, 3.5, 4.5]);
const TEXTS = Object.freeze(["p", "q", "r", "s"]);
const OBJECTS = Object.freeze([{ n: 1 }, { n: 2 }, { n: 3 }, { n: 4 }]);
const INTS2 = Object.freeze([10, 20, 30, 40]);
const TEXTS2 = Object.freeze(["w", "x", "y", "z"]);
const INTS3 = Object.freeze([11, 21, 31, 41]);
const holder = { list: Object.freeze([5, 6, 7, 8]) };
const cases = {
  "constant-ints": () => { const x = INTS[0]; new Stamp(INTS); return x + " " + INTS[1] + " " + INTS[3] + " " + INTS.length + " " + Stamp.has(INTS); },
  "constant-fractions": () => { const x = FRACTIONS[0]; new Stamp(FRACTIONS); return x + " " + FRACTIONS[1] + " " + FRACTIONS[3] + " " + FRACTIONS.length; },
  "constant-texts": () => { const x = TEXTS[0]; new Stamp(TEXTS); return x + " " + TEXTS[1] + " " + TEXTS[3] + " " + TEXTS.length; },
  "constant-objects": () => { const x = OBJECTS[0].n; new Stamp(OBJECTS); return x + " " + OBJECTS[1].n + " " + OBJECTS[3].n + " " + OBJECTS.length; },
  "constant-in-a-loop": () => { let t = 0; for (let turn = 0; turn < 50; turn++) { for (let i = 0; i < INTS2.length; i++) t += INTS2[i]; if (turn === 25) new Stamp(INTS2); } return t + " " + Stamp.read(INTS2); },
  "constant-iterated": () => { let t = ""; for (const x of TEXTS2) t += x; new Stamp(TEXTS2); for (const x of TEXTS2) t += x; return t; },
  "two-names": () => { const x = INTS3[0]; new Two(INTS3); return x + " " + INTS3[1] + " " + Two.sum(INTS3); },
  "made-here": () => { let t = 0; for (let k = 0; k < 20000; k++) { const a = Object.freeze([k & 7, 1, 2]); t += a[0] + a[1] + a[2]; new Stamp(a); t += a[0] + a[1] + a[2]; } return t; },
  "made-here-texts": () => { let t = 0; for (let k = 0; k < 20000; k++) { const a = Object.freeze(["ab", "c"]); t += a[0].length + a[1].length; new Stamp(a); t += a[0].length + a[1].length; } return t; },
  "through-a-field": () => { const x = holder.list[0]; new Stamp(holder.list); return x + " " + holder.list[1] + " " + holder.list[3]; },
  "a-private-method": () => { const a = Object.freeze([1, 2, 3]); const x = a[0]; new Method(a); return x + " " + a[1] + " " + a[2] + " " + Method.call(a); },
  "written-afterwards": () => { const a = Object.freeze([1, 2, 3]); new Stamp(a); const x = a[0]; Stamp.write(a, 9); return x + " " + a[1] + " " + a[2] + " " + Stamp.read(a); },
  "stamped-twice-throws": () => { const a = Object.freeze([1, 2, 3]); new Stamp(a); const x = a[0]; let said = "nothing"; try { new Stamp(a); } catch (error) { said = error.constructor.name; } return x + " " + a[1] + " " + said; },
  "still-frozen": () => { const a = Object.freeze([1, 2, 3]); new Stamp(a); let refused = 0; for (const f of [() => { a[0] = 9; }, () => { a.push(4); }, () => { a.x = 1; }, () => { delete a[1]; }, () => { a.length = 0; }]) { try { f(); } catch { refused++; } } return refused + " " + a.join() + " " + Object.isFrozen(a) + " " + Object.keys(a) + " " + JSON.stringify(Object.getOwnPropertyDescriptor(a, 0)); },
