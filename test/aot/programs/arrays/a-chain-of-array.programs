for (let round = 0; round < 2000; round++) kept.push(joinValues(objects, [{ n: round }, "text" + round, round + 0.5]));
Bun.gc(true);
let sum = 0;
for (const list of kept) sum += (list[0] as { n: number }).n + (list[2] as { n: number }).n + (list[3] as string).length + (list[4] as number);
console.log(sum, kept[5][0] === objects[0], kept[1999][1] === objects[1]);

// An old array takes young objects.
const old: unknown[] = []; for (let i = 0; i < 40; i++) old.push(null);
old.length = 0; Bun.gc(true); Bun.gc(true);
for (let round = 0; round < 10; round++) { old.length = 0; pushAll(old, [{ n: round }, { n: round + 1 }, ["in", round]]); Bun.gc(false); }
console.log(JSON.stringify(old));

// Frozen and sealed sources, and a target that takes nothing more.
show("frozen source", joinValues(Object.freeze(["f", 1]) as unknown[], Object.seal([2.5]) as unknown[]));
try { pushAll(Object.freeze(["f"]) as unknown[], strings); } catch (error) { console.log((error as Error).constructor.name); }
try { pushAll(Object.preventExtensions(["f"]) as unknown[], strings); } catch (error) { console.log((error as Error).constructor.name); }
//// appends-to-full-vectors.js
// One more element for an array whose vector is full, by `push` and by a store at the length: every storage kind, every length around the steps of the growth, and the arrays whose storage is not a plain vector of their own.
const collect = globalThis.gc ?? (() => Bun.gc(true));
const lines = [];
const hidden = JSON.parse('{"zero":0,"one":1,"half":0.5,"word":"w","limit":140}');

function push(list, value) { list.push(value); return list; }
function storeAtLength(list, value) { list[list.length] = value; return list; }
function append(list, value) { if (list === undefined) return [value]; list.push(value); return list; }

const values = {
  integers: i => i + hidden.zero,
  doubles: i => i + hidden.half,
  strings: i => hidden.word + i,
  objects: i => ({ i }),
  integersThenDoubles: i => (i < 5 ? i : i + hidden.half),
  integersThenStrings: i => (i < 9 ? i : hidden.word + i),
  doublesThenObjects: i => (i < 3 ? i + hidden.half : { i }),
  doublesWithNaN: i => (i === 7 ? NaN : i + hidden.half),
  withUndefined: i => (i % 4 ? i : undefined),
};

function digest(list) {
  let text = "";
  for (let i = 0; i < list.length; i++) {
    const value = list[i];
    text += (i in list ? "" : "hole") + (typeof value === "object" && value !== null ? "{" + value.i + "}" : String(value)) + ",";
  }
  let sum = 0;
  for (let i = 0; i < text.length; i++) sum = (Math.imul(sum, 31) + text.charCodeAt(i)) | 0;
  return list.length + ":" + sum;
}

for (const [name, valueAt] of Object.entries(values)) {
  for (const [way, add] of [["push", push], ["store", storeAtLength]]) {
    const seen = [];
    let list = [];
    for (let i = 0; i < hidden.limit; i++) {
      list = add(list, valueAt(i));
      if (i < 12 || i % 16 > 13) seen.push(digest(list));
    }
    lines.push(name + " " + way + " " + digest(seen) + " " + digest(list));
  }
  let list;
  for (let i = 0; i < 40; i++) list = append(list, valueAt(i));
  lines.push(name + " append " + digest(list));
}

function tell(name, make) {
  for (const [way, add] of [["push", push], ["store", storeAtLength]]) {
    let outcome;
    try {
      const list = make();
      for (let i = 0; i < 20; i++) add(list, i + hidden.one);
      outcome = digest(list) + " " + Object.keys(list).length + " " + Object.getPrototypeOf(list).constructor.name;
    } catch (error) {
      outcome = error.constructor.name;
    }
    lines.push(name + " " + way + " " + outcome);
  }
}

class Stack extends Array {}
tell("named property", () => { const list = [1]; list.tag = "t"; return list; });
tell("many named properties", () => { const list = [1, 2, 3]; for (let i = 0; i < 9; i++) list["p" + i] = i; return list; });
tell("subclass", () => Stack.of(1, 2, 3));
tell("constant literal", () => [1, 2, 3]);
tell("constant literal of doubles", () => [1.5, 2.5, 3.5]);
tell("constant literal of strings", () => ["a", "b", "c"]);
tell("shifted", () => { const list = [1, 2, 3, 4, 5, 6, 7]; list.shift(); list.shift(); return list; });
tell("unshifted", () => { const list = [3]; list.unshift(1, 2); return list; });
tell("emptied", () => { const list = [1, 2, 3]; list.length = 0; return list; });
tell("shortened", () => { const list = [1, 2, 3, 4, 5, 6, 7]; list.length = 2; return list; });
tell("popped", () => { const list = [1, 2, 3]; list.pop(); list.pop(); list.pop(); return list; });
tell("with a hole", () => { const list = [1, , 3]; return list; });
tell("of a given length", () => new Array(3));
tell("of length zero", () => new Array(0));
tell("sparse", () => { const list = [1]; list[100000] = 2; return list; });
tell("frozen", () => Object.freeze([1, 2, 3]));
tell("sealed", () => Object.seal([1, 2, 3]));
tell("not extensible", () => Object.preventExtensions([1, 2, 3]));
tell("read-only length", () => Object.defineProperty([1, 2, 3], "length", { writable: false }));
tell("other prototype", () => Object.setPrototypeOf([1, 2, 3], { constructor: { name: "Other" }, push: Array.prototype.push }));
tell("sliced", () => [1, 2, 3, 4, 5].slice(1, 4));
tell("mapped", () => [1, 2, 3].map(x => x + hidden.half));
tell("keys of an object", () => Object.keys({ a: 1, b: 2, c: 3 }));
tell("parsed", () => JSON.parse("[1,2,3]"));
tell("split", () => "a,b,c".split(","));
tell("array-like", () => ({ length: 3, 0: 1, 1: 2, 2: 3, push: Array.prototype.push }));

{
  const old = [];
  const oldDoubles = [];
  const oldObjects = [];
  for (let round = 0; round < 12; round++) {
    for (let i = 0; i < 3; i++) {
      push(old, round * 3 + i);
      storeAtLength(oldDoubles, round + i + hidden.half);
      push(oldObjects, { i: round * 3 + i });
    }
    collect();
  }
  lines.push("across collections " + digest(old) + " " + digest(oldDoubles) + " " + digest(oldObjects));
}

{
  const holder = { lists: [] };
  collect();
  for (let round = 0; round < 6; round++) {
    const young = [];
    holder.lists.push(young);
    for (let i = 0; i < 4 + round * 5; i++) push(young, { i: round + i });
    collect();
    for (const list of holder.lists) storeAtLength(list, { i: round });
  }
  lines.push("grown, then collected " + holder.lists.map(digest).join(" "));
}

{
  const shared = [1];
  const alias = shared;
  for (let i = 0; i < 30; i++) (i % 2 ? push(shared, i) : storeAtLength(alias, i));
  lines.push("aliases " + (shared === alias) + " " + digest(alias));
}

{
  let kept = 0;
  for (let round = 0; round < 20000; round++) {
    let list;
    for (let i = 0; i < (round & 15); i++) list = append(list, { i });
    if (list) kept += list.length + list[list.length - 1].i;
  }
  lines.push("many short lists " + kept);
}

console.log(lines.join("\n"));
//// array-allocation-outside-hot-code.ts
// Arrays of holes, literals with holes, rest arrays and copies of typed arrays made in code that runs once or a few times: lengths on both sides of what the allocation stub takes, and free lists that run out.
const out: string[] = [];

function describe(list: readonly unknown[]): string {
  let present = 0;
  let sum = 0;
  for (let i = 0; i < list.length; i++) {
    if (!(i in list)) continue;
    present++;
    if (typeof list[i] === "number") sum += list[i] as number;
  }
  return list.length + "/" + present + "/" + sum;
}

function collect(first: unknown, ...rest: unknown[]): unknown[] {
  return rest;
}

function collectAll(...all: number[]): number[] {
  return all;
}

////= lines-35	numbersUpTo	count	numbers	1

function ofLength(length: number): unknown[] {
  return new Array(length);
}

function withHoles(first: unknown, last: unknown): unknown[] {
  return [first, , , last, ,];
}

const lengths = [0, 1, 2, 3, 4, 5, 6, 7, 8, 125, 126, 127, 128, 129, 254, 255, 256, 257, 300, 1000];

function checkEverything(label: string): void {
  for (const length of lengths) {
    const holes = ofLength(length);
    out.push(label + " holes " + length + " " + describe(holes));
    holes.push(length);
    holes[length + 2] = 1;
    out.push(label + " holes grown " + length + " " + describe(holes));

    const numbers = numbersUpTo(length);
    const rest = collect("first", ...numbers);
    out.push(label + " rest " + length + " " + describe(rest));
    rest.push(7);
    out.push(label + " rest grown " + length + " " + describe(rest));
    out.push(label + " all " + length + " " + describe(collectAll(...numbers)));

    out.push(label + " bytes " + length + " " + describe(Array.from(new Uint8Array(numbers))));
    out.push(label + " floats " + length + " " + describe(Array.from(new Float64Array(numbers))));
  }
  out.push(label + " none " + describe(collect("first")) + " " + describe(collect(undefined)) + " " + describe((collect as () => unknown[])()));
  out.push(label + " literal " + describe(withHoles(1, 2)) + " " + describe(withHoles("a", undefined)));
  for (const bad of [-1, 1.5, 2 ** 32, NaN]) {
    try {
      out.push(label + " bad length " + bad + " " + describe(ofLength(bad)));
    } catch (error) {
      out.push(label + " bad length " + bad + " " + (error as Error).name);
    }
  }
}

checkEverything("first");

const kept: unknown[][] = [];
for (let round = 0; round < 3000; round++) {
  const length = lengths[round % 12];
  kept[round % 64] = round & 1 ? ofLength(length) : collect(round, round, round + 1, round + 2);
}
let total = 0;
for (const list of kept) total += list.length;
out.push("kept " + total);

checkEverything("again");

console.log(out.join("\n"));
//// array-constants.ts
// Functions that return array literals of constant numbers: each call returns a fresh array, also at the limits of the int32 and safe-integer ranges.
const collect: () => void = (globalThis as any).gc ?? (() => {});
const out: string[] = [];
function show(a: readonly unknown[]): string { return a.map(v => Object.is(v, -0) ? "-0" : typeof v === "string" ? JSON.stringify(v) : String(v)).join(","); }
function ints(): number[] { return [1, 2, 3]; }
function one(): number[] { return [42]; }
function edges(): number[] { return [2147483647, 2147483648, -2147483648, -2147483649, 4294967296, 9007199254740991, -9007199254740991]; }
function doubles(): number[] { return [1.5, -0, 0, 1e300, 5e-324, -1.25, 0.1]; }
function wholeDoubles(): number[] { return [1.0, 2.0, 3.5]; }
function mixed(): unknown[] { return [undefined, null, true, false, 0, "a", "", "a", 1.25, "\u00e9\u4e2d", -0]; }
function strings(): string[] { return ["x", "y", "x", "longer than a few characters"]; }
function nothing(): unknown[] { return [undefined, undefined]; }
function nulls(): unknown[] { return [null]; }
function same1(): number[] { return [7, 8]; }
function same2(): number[] { return [7, 8]; }
