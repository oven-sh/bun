// Hot, and more is pushed than the literal has room for.
function often(start: number): number {
  let n: number = start;
  const list: number[] = [start];
  n += 6;
  list.push(n);
  list.push(n);
  list.push(n);
  list.push(n);
  list.push(n);
  list.push(n);
  list.push(n);
  list.push(n);
  list.push(n);
  let sum = 0;
  for (let x = 60; x < 62; x++) {
    n += x;
    sum += list[0] + list[1] + list[5] + list[9] + list.length;
  }
  return sum + n;
}
let total = 0;
for (let i = 0; i < 30000; i++) total += often(3);
console.log(total);

// Behind a spread.
function behindASpread(start: number, first: number[]): number {
  let n: number = start;
  n += 6;
  const list: number[] = [...first, n];
  for (let x = 60; x < 61; x++) {
    n += x;
    console.log(n, list.length, list[0], list[1], list[2]);
  }
  return n;
}
console.log(behindASpread(3, [1, 2]));

// What is stored through such an array is found by everybody else.
function storedThrough(start: number): string {
  let n: number = start;
  const list: number[] = [start];
  n += 6;
  list.push(n);
  for (let x = 60; x < 61; x++) {
    n += x;
    list[0] = 7;
    list[1] = list[0] + 1;
  }
  return JSON.stringify(list) + " " + list.join() + " " + list.indexOf(8) + " " + list.includes(7) + " " + n;
}
console.log(storedThrough(3));
//// an-array-of-numbers-read-by-two-counters-in-three-loops.ts
// The build of this program used to stop with an internal error: in drive_odd_positions an array of a module is read by the counters of two loops inside a third,
// and the copy that the compiler makes of the middle loop handed the tests of the array on to the inner loop under other names than the read used. Without arguments it prints "no row".
const argv: string[] = process.argv;
const ROW: string = argv[2] ?? "";
const COUNT: number = parseInt(argv[3] ?? "0", 10) | 0;
const parsed: any = JSON.parse(argv[4] ?? '{"list":[0,1,2,3,4,5,6,7],"halves":[0.5,1.5,2.5,3.5,4.5,5.5,6.5,7.5],"text":"alpha beta gamma delta epsilon","words":["alpha","beta","gamma","delta"],"colors":["red","green","blue","red"],"padded":["  a ","b","c  ","dd"]}');
let G1 = COUNT | 0, G2 = G1 + 1 | 0, G3 = G1 + 2 | 0, G4 = G1 + 3 | 0, G5 = G1 + 4 | 0, G6 = G1 + 5 | 0, G7 = G1 + 6 | 0, G8 = G1 + 7 | 0, G9 = G1 + 8 | 0, G10 = G1 + 9 | 0, G11 = G1 + 10 | 0, G12 = G1 + 11 | 0, G13 = G1 + 12 | 0, G15 = (COUNT & 1) | 0;
const TEXT: string = String(parsed.text);

// 4: module top level runs at most once: compact code
const topTrimmed: string = TEXT.trim();
const topFound: number = TEXT.indexOf(String(parsed.words[2]));
const topHas: boolean = TEXT.includes(String(parsed.words[3]));
const topLast: number = TEXT.lastIndexOf(String(parsed.words[1]));
const topChar: string = TEXT.charAt(COUNT & 3);

// 1: the smallest program of the finding
class Pair { a: number; b: number; constructor(a: number, b: number) { this.a = a; this.b = b; } sum(): number { return this.a + this.b; } }
