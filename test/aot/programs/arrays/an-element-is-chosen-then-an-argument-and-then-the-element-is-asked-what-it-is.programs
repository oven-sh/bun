////: classes-of-shapes-that-scale
abstract class Shape { abstract scaled(by: number): number; }
class Square extends Shape { constructor(readonly side: number) { super(); } scaled(by: number): number { return this.side * this.side * by; } }
class Disc extends Shape { constructor(readonly radius: number) { super(); } scaled(by: number): number { return 3 * this.radius * this.radius * by; } }
class Bar extends Shape { constructor(readonly length: number, public width: number) { super(); } scaled(by: number): number { return this.length * this.width * by; } }
//// a-method-by-kind-takes-an-argument-out-of-a-second-list-at-the-top-level.ts
////= classes-of-shapes-that-scale
const shapes: Shape[] = [new Square(2), new Disc(1), new Square(3)];
const factors: number[] = [1, 0.5];
let sum = 0;
for (let i = 0; i < 200; i++) sum += shapes[i % shapes.length]!.scaled(factors[i % factors.length]!);
console.log(sum);
//// a-method-by-kind-takes-an-argument-out-of-a-second-list-in-a-function.ts
////= classes-of-shapes-that-scale
function main() {
  const shapes: Shape[] = [new Square(2), new Disc(1), new Square(3), new Bar(2, 5)];
  const factors: number[] = [1, 0.5];
  let sum = 0;
  for (let i = 0; i < 200; i++) sum += shapes[i % shapes.length]!.scaled(factors[i % factors.length]!);
  console.log(sum);
}
main();
//// a-method-by-kind-is-called-on-what-stands-past-the-end-of-the-list.ts
////= classes-of-shapes-that-scale
const shapes: Shape[] = [new Square(2), new Disc(1), new Square(3)];
const factors: number[] = [1, 0.5];
let sum = 0;
let thrown = 0;
for (let i = 0; i < 200; i++) {
  try { sum += shapes[(i + 1) % 4]!.scaled(factors[i % factors.length]!); } catch (error) { if (error instanceof TypeError) thrown++; }
}
console.log(sum, thrown);
//// a-method-by-kind-is-called-on-what-stands-in-front-of-the-list.ts
////= classes-of-shapes-that-scale
const shapes: Shape[] = [new Square(2), new Disc(1), new Square(3)];
const factors: number[] = [1, 0.5];
let sum = 0;
let thrown = 0;
for (let i = 0; i < 200; i++) {
  try { sum += shapes[(i - 2) % 3]!.scaled(factors[i % factors.length]!); } catch (error) { if (error instanceof TypeError) thrown++; }
}
console.log(sum, thrown);
//// the-argument-of-a-method-by-kind-stands-past-the-end-of-its-list.ts
////= classes-of-shapes-that-scale
const shapes: Shape[] = [new Square(2), new Disc(1), new Square(3)];
const factors: number[] = [1, 0.5];
let sum = 0;
let none = 0;
for (let i = 0; i < 200; i++) {
  const scaled = shapes[i % shapes.length]!.scaled(factors[i % 3]!);
  if (Number.isNaN(scaled)) none++;
  else sum += scaled;
}
console.log(sum, none);
//// an-element-of-another-kind-is-stored-in-the-loop-that-calls-a-method-by-kind.ts
////= classes-of-shapes-that-scale
const shapes: Shape[] = [new Square(2), new Disc(1), new Square(3)];
const factors: number[] = [1, 0.5];
let sum = 0;
for (let i = 0; i < 200; i++) {
  if (i === 50) shapes[1] = new Square(7);
  if (i === 90) shapes[0] = new Bar(2, 2);
  sum += shapes[i % shapes.length]!.scaled(factors[i % factors.length]!);
}
console.log(sum);
//// the-list-grows-and-shrinks-in-the-loop-that-calls-a-method-by-kind.ts
////= classes-of-shapes-that-scale
const shapes: Shape[] = [new Square(2), new Disc(1)];
const factors: number[] = [1, 0.5];
let sum = 0;
for (let i = 0; i < 200; i++) {
  if (i === 50) shapes.push(new Bar(1, 2));
  if (i === 120) shapes.shift();
  sum += shapes[i % shapes.length]!.scaled(factors[i % factors.length]!);
}
console.log(sum);
//// a-field-of-the-chosen-element-is-stored-behind-a-test-of-its-class.ts
////= classes-of-shapes-that-scale
const shapes: Shape[] = [new Square(2), new Bar(1, 1), new Disc(3), new Bar(2, 5)];
const factors: number[] = [1, 0.5];
let sum = 0;
for (let i = 0; i < 200; i++) {
  const shape = shapes[i % shapes.length]!;
  const by = factors[i % 2]!;
  if (shape instanceof Bar) shape.width = (shape.width + 1) % 7;
  sum += shape.scaled(by);
}
console.log(sum, JSON.stringify(shapes));
//// a-number-a-text-or-nothing-is-chosen-then-a-factor-and-then-its-kind-is-asked.ts
const values: (number | string | null | undefined)[] = [1, "two", 3, null, undefined, 2.5];
const factors: number[] = [1, 0.5];
let sum = 0;
for (let i = 0; i < 200; i++) {
  const value = values[i % values.length];
  const by = factors[i % 2]!;
  sum += typeof value === "number" ? value * by : typeof value === "string" ? value.length * by : value === null ? -by : by;
}
console.log(sum);
//// an-element-of-a-list-with-a-hole-is-chosen-then-a-factor-and-then-its-kind-is-asked.ts
const values: (number | undefined)[] = [1, , 3];
let sum = 0;
for (let i = 0; i < 200; i++) {
  const value = values[i % values.length];
  const by = i & 1 ? 1 : 0.5;
  sum += typeof value === "number" ? value * by : -by;
}
console.log(sum);
