function show(a: ArrayLike<unknown>): string { return Array.from(a).map(v => Object.is(v, -0) ? "-0" : typeof v === "string" ? JSON.stringify(v) : String(v)).join(","); }
function written17(): number[] { const a = [-300,-293,-286,-279,-272,-265,-258,-251,-244,-237,-230,-223,-216,-209,-202,-195,-188]; a[3] = -1; return a; }
function written16(): number[] { const a = [-300,-293,-286,-279,-272,-265,-258,-251,-244,-237,-230,-223,-216,-209,-202,-195]; a[3] = -1; return a; }
