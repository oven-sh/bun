const makers: [string, () => ArrayLike<unknown>][] = [["written17", written17], ["written16", written16], ["written40", written40], ["pushed30", pushed30], ["doubles25", doubles25], ["mixed36", mixed36], ["typed100", typed100], ["floats50", floats50], ["sorted20", sorted20], ["becomesMixed20", becomesMixed20]];
