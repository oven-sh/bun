copy[0] = 100;
const literalAgain = () => [1, 2, 3];
console.log(copy, literalAgain(), joined(literalAgain(), literalAgain()));
//// atomics-on-integer-typed-arrays.ts
// Atomics on integer typed arrays with number index and operands compile to atomic instructions. Results, stored values and exceptions must match the runtime functions.
declare const console: { log(...v: unknown[]): void };
function counts(slots: Int32Array, n: number): number { let t = 0; for (let i = 0; i < n; i++) { t += Atomics.add(slots, 0, 1); Atomics.sub(slots, 1, 2); Atomics.store(slots, 2, i); t += Atomics.load(slots, 2); } return t + Atomics.load(slots, 0) * 3 + Atomics.load(slots, 1) * 5; }
function swaps(slots: Int32Array, n: number): number { let retries = 0; for (let i = 0; i < n; i++) { let held = Atomics.load(slots, 3); while (Atomics.compareExchange(slots, 3, held, held + 3) !== held) { retries++; held = Atomics.load(slots, 3); } } return retries * 1000 + Atomics.exchange(slots, 3, -1) + Atomics.load(slots, 3); }
function said(run: () => unknown): string { try { const v = run(); return Object.is(v, -0) ? "-0" : String(v); } catch (e) { return (e as Error).constructor.name; } }

function int8(a: Int8Array, i: number, v: number): string { return [Atomics.add(a, i, v), Atomics.and(a, i, v | 0x55), Atomics.or(a, i, v), Atomics.xor(a, i, 0x7f), Atomics.sub(a, i, v), Atomics.exchange(a, i, v), Atomics.compareExchange(a, i, v, v + 1), Atomics.load(a, i), Atomics.store(a, i, v), a[i]].join(); }
function uint8(a: Uint8Array, i: number, v: number): string { return [Atomics.add(a, i, v), Atomics.and(a, i, v | 0x55), Atomics.or(a, i, v), Atomics.xor(a, i, 0x7f), Atomics.sub(a, i, v), Atomics.exchange(a, i, v), Atomics.compareExchange(a, i, v, v + 1), Atomics.load(a, i), Atomics.store(a, i, v), a[i]].join(); }
function int16(a: Int16Array, i: number, v: number): string { return [Atomics.add(a, i, v), Atomics.and(a, i, v | 0x5555), Atomics.or(a, i, v), Atomics.xor(a, i, 0x7fff), Atomics.sub(a, i, v), Atomics.exchange(a, i, v), Atomics.compareExchange(a, i, v, v + 1), Atomics.load(a, i), Atomics.store(a, i, v), a[i]].join(); }
function uint16(a: Uint16Array, i: number, v: number): string { return [Atomics.add(a, i, v), Atomics.and(a, i, v | 0x5555), Atomics.or(a, i, v), Atomics.xor(a, i, 0x7fff), Atomics.sub(a, i, v), Atomics.exchange(a, i, v), Atomics.compareExchange(a, i, v, v + 1), Atomics.load(a, i), Atomics.store(a, i, v), a[i]].join(); }
function int32(a: Int32Array, i: number, v: number): string { return [Atomics.add(a, i, v), Atomics.and(a, i, v | 0x55555555), Atomics.or(a, i, v), Atomics.xor(a, i, 0x7fffffff), Atomics.sub(a, i, v), Atomics.exchange(a, i, v), Atomics.compareExchange(a, i, v, v + 1), Atomics.load(a, i), Atomics.store(a, i, v), a[i]].join(); }
function uint32(a: Uint32Array, i: number, v: number): string { return [Atomics.add(a, i, v), Atomics.and(a, i, v | 0x55555555), Atomics.or(a, i, v), Atomics.xor(a, i, 0x7fffffff), Atomics.sub(a, i, v), Atomics.exchange(a, i, v), Atomics.compareExchange(a, i, v, v + 1), Atomics.load(a, i), Atomics.store(a, i, v), a[i]].join(); }
function stores(a: Int32Array, v: number): string { return said(() => Atomics.store(a, 0, v)) + ":" + a[0]; }
function loads(a: Int32Array, i: number): string { return said(() => Atomics.load(a, i)); }
function adds(a: Int32Array, i: number, v: number): string { return said(() => Atomics.add(a, i, v)) + ":" + a[0]; }
function floats(a: Float64Array): string { return said(() => Atomics.load(a as any, 0)) + said(() => Atomics.add(a as any, 0, 1)); }
function clamped(a: Uint8ClampedArray): string { return said(() => Atomics.load(a as any, 0)) + said(() => Atomics.store(a as any, 0, 1)); }
function big(a: BigInt64Array): string { return said(() => Atomics.add(a, 0, 5n)) + said(() => Atomics.load(a, 0)) + said(() => Atomics.add(a as any, 0, 5)); }
class Own extends Int32Array { get length(): number { return 0; } }

const shared = new Int32Array(new SharedArrayBuffer(64));
const own = new Int32Array(16);
const out: string[] = [];
out.push(String(counts(shared, 1000)), String(swaps(shared, 1000)), String(counts(own, 10)), String(swaps(own, 10)));
for (const v of [1, -1, 127, 128, 255, 256, 65535, 65536, 2147483647, -2147483648, 4294967295, 4294967296, 1.9, -1.9, 0, -0, NaN, Infinity, -Infinity, 1e20]) {
  out.push(int8(new Int8Array(4), 1, v), uint8(new Uint8Array(4), 2, v), int16(new Int16Array(4), 3, v), uint16(new Uint16Array(4), 0, v), int32(new Int32Array(4), 1, v), uint32(new Uint32Array(4), 2, v), stores(own, v));
}
for (const i of [0, 15, 16, -1, 1.5, -0, NaN, Infinity, 4294967296, 1e20]) out.push(loads(own, i), adds(own, i, 1));
out.push(floats(new Float64Array(2)), clamped(new Uint8ClampedArray(2)), big(new BigInt64Array(2)));
const resizable = new ArrayBuffer(16, { maxByteLength: 64 }); const tracking = new Int32Array(resizable); const fixed = new Int32Array(resizable, 0, 2);
out.push(adds(tracking, 3, 7), loads(tracking, 4), loads(fixed, 1), loads(fixed, 2)); resizable.resize(32); out.push(loads(tracking, 4), adds(tracking, 7, 1), loads(fixed, 1)); resizable.resize(4); out.push(loads(tracking, 1), loads(tracking, 0), loads(fixed, 0), adds(fixed, 1, 1));
const growable = new SharedArrayBuffer(8, { maxByteLength: 32 }); const grown = new Int32Array(growable); out.push(loads(grown, 2)); growable.grow(16); out.push(loads(grown, 2), adds(grown, 3, 9), loads(grown, 3));
const gone = new Int32Array(4); structuredClone(gone.buffer, { transfer: [gone.buffer] }); out.push(loads(gone, 0), adds(gone, 0, 1), stores(gone, 1));
const subclass = new Own(4); out.push(adds(subclass, 3, 4), loads(subclass, 3), loads(subclass, 4));
out.push(said(() => Atomics.load(undefined as unknown as Int32Array, 0)), said(() => Atomics.add(null as unknown as Int32Array, 0, 1)), said(() => Atomics.add([1, 2] as any, 0, 1)));
console.log(out.join(" "));
//// bad-time-in-one-realm.js
// An index accessor on a prototype of arrays gives one realm a bad time and no other. First a node:vm context has one, then the compiled realm: each time the arrays, arguments objects and match results that the other realms create stay what they were.
const vm = require("vm");

function integers(first, last) {
  return [first, , last];
}

function doubles(first, last) {
  return [first + 0.5, , last + 0.5];
}

function strings(first, last) {
  return [String(first), , String(last)];
}

function constantIntegers() {
  return [1, 2, 3];
}

function constantDoubles() {
  return [1.5, 2.5, 3.5];
}

function constantStrings() {
  return ["a", "b", "c"];
}

function argumentsObject() {
  return arguments;
}

function matchResult(text) {
  return /(x)?c/.exec(text);
}

const kinds = [
  ["integers", () => integers(1, 3)],
  ["doubles", () => doubles(1, 3)],
  ["strings", () => strings(1, 3)],
  ["constant integers", constantIntegers],
  ["constant doubles", constantDoubles],
  ["constant strings", constantStrings],
  ["arguments", () => argumentsObject(1, 2, 3)],
  ["match result", () => matchResult("c")],
];

function readAndStore(created) {
  const before = String(created[1]);
  created[1] = "stored";
  return created.length + " " + before + " " + created[1];
}

function describeCompiledRealm() {
  return kinds.map(([name, create]) => name + ": " + readAndStore(create())).join(", ");
}

function createRealm() {
  const context = vm.createContext({});
  vm.runInContext("var stores = 0;", context);
  return context;
}

function describeContext(context) {
  return vm.runInContext("(() => { const holes = [1, , 3]; const before = String(holes[1]); holes[1] = 'stored'; return before + ' ' + holes[1] + ' ' + stores; })()", context);
}

const changed = createRealm();
const unchanged = createRealm();

function report(when) {
  console.log(when);
  console.log("  compiled realm: " + describeCompiledRealm());
  console.log("  changed context: " + describeContext(changed));
  console.log("  unchanged context: " + describeContext(unchanged));
  console.log("  array of the changed context: " + readAndStore(vm.runInContext("[1, , 3]", changed)));
  console.log("  array of the unchanged context: " + readAndStore(vm.runInContext("[1, , 3]", unchanged)));
}

report("before");

vm.runInContext("Object.defineProperty(Array.prototype, 1, { get() { return 'inherited'; }, set(value) { stores++; }, configurable: true });", changed);
report("after the accessor in the context");

class Rows extends Array {}
const rows = new Rows(3);
Object.defineProperty(Rows.prototype, 1, {
  get() {
    return "inherited";
  },
  configurable: true,
});
report("after the accessor in the compiled realm");
console.log("  subclass: " + rows.length + " " + rows[1] + " " + new Rows(2)[1] + " " + String(new Rows(2)[0]));
//// boolean-and-number-as-callbacks.ts
// `list.filter(Boolean)` and `list.map(Number)`: the engine's own Boolean and Number are not called once an element: the loop asks and converts in place. Whatever cannot be done in place (an object that converts itself, a symbol, a list that is no plain array, a function of the program that has the name) goes the way it always went. Held to plain Bun.
declare const console: { log(...values: unknown[]): void };
function show(value: unknown): string {
    if (Array.isArray(value)) {
        let text = "";
        for (let i = 0; i < value.length; i++) text += (i ? "," : "") + (i in value ? show(value[i]) : "hole");
        return value.constructor.name + "[" + text + "]";
    }
    if (Object.is(value, -0)) return "-0";
    if (typeof value === "string") return JSON.stringify(value);
    if (typeof value === "bigint") return value + "n";
    if (typeof value === "symbol" || typeof value === "function") return typeof value;
    if (typeof value === "object" && value !== null) return "{" + Object.keys(value).join() + "}";
    return String(value);
}
function tell(name: string, make: () => unknown): void {
    let text: string;
    try { text = show(make()); } catch (e) { text = "threw " + (e as Error).constructor.name + ": " + (e as Error).message; }
    console.log(name + ": " + text);
}
class Rows<T> extends Array<T> {}
const one = 1;
const rope = "1" + one + "2" + one;
const everything: unknown[] = [0, -0, NaN, 1, -1, 0.5, "", "a", " ", "0", null, undefined, false, true, {}, [], 0n, 1n, Symbol("s"), () => 0];

tell("everything", () => everything.filter(Boolean));
tell("strings or nothing", () => (["a", null, "", "b", undefined] as (string | null | undefined)[]).filter(Boolean));
tell("integers", () => [0, 1, 2, 0, 3].filter(Boolean));
tell("fractions", () => [0.5, 0, -0, 1.5, 0].filter(Boolean));
tell("objects", () => [{ a: 1 }, null, { b: 2 }].filter(Boolean));
tell("none", () => ([] as unknown[]).filter(Boolean));
tell("all false", () => [0, "", null].filter(Boolean));
tell("a hole", () => [1, , 2, , 0].filter(Boolean));
tell("a hole among fractions", () => [1.5, , 0, 2.5].filter(Boolean));
tell("with this", () => [0, 1].filter(Boolean, { any: 1 }));
tell("an heir", () => Rows.from([0, 1, "", "x"]).filter(Boolean));
tell("frozen", () => Object.freeze([0, 1, "", "x"]).filter(Boolean));
tell("like an array", () => Array.prototype.filter.call({ length: 3, 0: 0, 1: "x", 2: null }, Boolean));
tell("sparse", () => { const list: unknown[] = [1]; list[5000] = 2; list[9000] = 0; return list.filter(Boolean); });
tell("many", () => { const list: number[] = []; for (let i = 0; i < 3000; i++) list.push(i % 3); return list.filter(Boolean).length; });
tell("a function of the program that has the name", () => { const Boolean = (x: unknown) => x === 0; return [0, 1, 0].filter(Boolean); });
tell("kept in a variable", () => { const keep = Boolean; return [0, 1, ""].filter(keep); });
tell("the result is another list", () => { const list = [1, 2]; return list.filter(Boolean) !== list; });

tell("numerals", () => ["1", "2.5", "-3", "1e3", "0x10", "0b11", "  7  ", "", " ", "abc", "Infinity", "-Infinity", "-0", "+4", "1_000", "٣"].map(Number));
tell("a rope", () => [rope, rope + rope].map(Number));
tell("numbers", () => [1, 2.5, -0, NaN].map(Number));
tell("integers to numbers", () => [1, 2, 3].map(Number));
tell("fractions to numbers", () => [1.5, 2.5].map(Number));
tell("strings and numbers", () => (["1", 2, "3.5"] as unknown[]).map(Number));
tell("nothing, true and false", () => ([null, undefined, true, false] as unknown[]).map(Number));
tell("strings, then nothing", () => (["1", "2", null, "4"] as unknown[]).map(Number));
tell("big integers", () => ([1n, "2", 2n ** 70n] as unknown[]).map(Number));
tell("a symbol", () => (["1", Symbol("s")] as unknown[]).map(Number));
tell("objects that convert themselves", () => (["1", { valueOf: () => 7 }, [8], new Date(9), {}] as unknown[]).map(Number));
tell("an object that changes the list", () => { const list: unknown[] = ["1", null, "3", "4"]; list[1] = { valueOf() { list[2] = "30"; list.length = 3; return 2; } }; return list.map(Number); });
tell("no strings", () => ([] as string[]).map(Number));
tell("a hole among strings", () => ["1", , "3"].map(Number));
tell("a hole among fractions, to numbers", () => [1.5, , 3.5].map(Number));
tell("an heir of strings", () => Rows.from(["1", "2"]).map(Number));
tell("split", () => "3,1,2".split(",").map(Number));
tell("like an array of strings", () => Array.prototype.map.call({ length: 2, 0: "5", 1: "6" }, Number));
tell("many strings", () => { const list: string[] = []; for (let i = 0; i < 3000; i++) list.push(String(i)); const made = list.map(Number); return made.length + " " + made[2999]; });
tell("a function of the program named Number", () => { const Number = (x: unknown) => "n" + x; return ["1"].map(Number); });
tell("Number kept in a variable", () => { const convert = Number; return ["1", "x"].map(convert); });
//// buffer-copy-methods-class.js
// toReversed, toSorted and with create a typed array of the element type, so a Buffer gives a plain Uint8Array. slice and subarray ask the species.
function describe(label, bytes) {
  console.log(label, bytes instanceof Buffer, bytes instanceof Uint8Array, Object.getPrototypeOf(bytes) === Uint8Array.prototype, bytes.constructor.name, Array.from(bytes).join(), typeof bytes.readUInt8)
}
const buffer = Buffer.from([3, 1, 2])
describe("toReversed", buffer.toReversed())
describe("toSorted", buffer.toSorted())
describe("toSorted with a comparator", buffer.toSorted((a, b) => b - a))
describe("with", buffer.with(0, 9))
describe("subarray", buffer.subarray(1))
describe("slice", buffer.slice(1))
describe("the typed array's slice", Uint8Array.prototype.slice.call(buffer, 1))
describe("map", buffer.map(byte => byte * 2))
describe("filter", buffer.filter(byte => byte > 1))

class Bytes extends Uint8Array {
  first() { return this[0] }
}
const bytes = Bytes.of(5, 4)
for (const copy of [bytes.toReversed(), bytes.toSorted(), bytes.with(1, 7), bytes.slice(), bytes.subarray(0)])
  console.log(copy instanceof Bytes, copy.constructor.name, typeof copy.first, Array.from(copy).join())

function sumReversed(source) {
  const reversed = source.toReversed()
  let sum = 0
  for (let i = 0; i < reversed.length; i++) sum += reversed[i] * (i + 1)
  return sum + (reversed instanceof Buffer ? 1000 : 0)
}
console.log(sumReversed(buffer), sumReversed(Uint8Array.of(3, 1, 2)), sumReversed(bytes))
//// cached-store-shadows-array-method.js
// One compiled store site adds a name that shadows an array method to several arrays that already have named storage: every array must then use its own property.
function addByName(list) { list.tag = 1; list.push = function () { return -1; }; return list; }
function addByKey(list, key, value) { list.tag = 1; list[key] = value; return list; }
function addOtherName(list) { list.tag = 1; list.other = 2; return list; }
class ReturnsArgument { constructor(list) { list.tag = 1; return list; } }
class DefinesJoin extends ReturnsArgument { join = () => "own join"; }
for (let round = 1; round <= 4; round++) {
  const byName = addByName([round]);
  console.log(round, "by name", byName.push(3), byName.length);
  console.log(round, "by key", addByKey([round], "indexOf", () => "own indexOf").indexOf(round));
  console.log(round, "by symbol", [...addByKey([round], Symbol.iterator, function* () { yield "own iterator"; })].join());
  console.log(round, "toJSON", JSON.stringify(addByKey([round], "toJSON", () => "own toJSON")));
  console.log(round, "defined", String(new DefinesJoin([round, round])));
  const other = addOtherName([round]);
  console.log(round, "other name", other.push(3), other.length, other.other);
}
//// capacity-from-moving-lengths.ts
// Arrays filled by loops whose bound is the length of something else, where the bound moves, lies or is very large.
function copyCounted(xs: number[]) { const out: number[] = []; for (let i = 0; i < xs.length; i++) out.push(xs[i] * 2); return out; }
function copyForOf(xs: number[]) { const out: number[] = []; for (const x of xs) out.push(x + 1); return out; }
function growsWhileWalked(xs: number[]) { const out: number[] = []; for (const x of xs) { out.push(x); if (x === 3 && xs.length < 9) xs.push(30, 3); } return out; }
function shrinksWhileWalked(xs: number[]) { const out: number[] = []; for (let i = 0; i < xs.length; i++) { out.push(xs[i]); if (i % 2) xs.pop(); } return out; }
function leavesEarly(xs: number[], limit: number) { const out: number[] = []; for (let i = 0; i < xs.length; i++) { if (xs[i] > limit) break; out.push(xs[i]); } return out; }
function throwsInside(xs: number[]) { const out: number[] = []; try { for (const x of xs) { if (x < 0) throw new RangeError("negative"); out.push(x); } } catch (error) { out.push(-1); } return out; }
function fromBytes(bytes: Uint8Array) { const out: number[] = []; for (let i = 0; i < bytes.length; i++) out.push(bytes[i]); return out; }
function fromMap(map: Map<string, number>) { const out: number[] = []; for (let i = 0; i < map.size; i++) out.push(i); for (const [, value] of map) out.push(value); return out; }
function fromAnything(xs: any) { const out: any[] = []; for (let i = 0; i < xs.length; i++) out.push(xs[i]); return out; }
function intoItself(xs: number[]) { let rounds = 0; for (let i = 0; i < xs.length && rounds < 5; i++, rounds++) xs.push(i); return xs; }
function countdown(xs: number[]) { const out: number[] = []; for (let i = xs.length - 1; i >= 0; i--) out.push(xs[i]); return out; }
function literalInLoop(rows: number[][]) { const all: number[][] = []; for (const row of rows) { const out: number[] = [0]; for (let i = 0; i < row.length; i++) out.push(row[i]); all.push(out); } return all; }
class Loud extends Array<number> { pushes = 0; push(...items: number[]) { this.pushes += items.length; return super.push(...items); } }
function intoSubclass(xs: number[]) { const out = new Loud(); for (const x of xs) out.push(x); return [out.length, out.pushes, out[out.length - 1]]; }

const show = (label: string, value: unknown) => console.log(label, JSON.stringify(value));
show("counted", copyCounted([1, 2, 3]));
show("for of", copyForOf([1, 2, 3]));
show("empty", [copyCounted([]), copyForOf([])]);
show("holes", copyForOf([1, , 3] as number[]));
show("grows", growsWhileWalked([1, 3, 5]));
show("shrinks", shrinksWhileWalked([1, 2, 3, 4, 5, 6, 7]));
show("leaves early", leavesEarly([1, 2, 9, 4], 5));
show("throws", throwsInside([1, 2, -3, 4]));
show("bytes", fromBytes(new Uint8Array([7, 8, 9])));
const resizable = new Uint8Array(new ArrayBuffer(4, { maxByteLength: 16 }));
show("resizable", fromBytes(resizable).length);
const detached = new Uint8Array(8); detached.buffer.transfer();
show("detached", fromBytes(detached));
show("map", fromMap(new Map([["a", 5], ["b", 6]])));
show("string", fromAnything("abc"));
show("array-like", fromAnything({ length: 2, 0: "x", 1: "y" }));
show("negative length", fromAnything({ length: -5 }));
show("fraction", fromAnything({ length: 2.5, 0: 1, 1: 2, 2: 3 }));
let reads = 0;
show("getter", [fromAnything({ get length() { return ++reads < 4 ? 10 : 0; }, 0: "a", 1: "b", 2: "c" }), reads]);
show("proxy", fromAnything(new Proxy([1, 2], { get(target, key, receiver) { return key === "length" ? 3 : Reflect.get(target, key, receiver); } })));
show("itself", intoItself([9]));
show("countdown", countdown([1, 2, 3]));
show("rows", literalInLoop([[1], [], [2, 3, 4]]));
show("subclass", intoSubclass([4, 5, 6]));
const large = new Array<number>(300000).fill(1);
show("large", [copyCounted(large).length, copyForOf(large).length]);
