cells.push(['change first | very far', f31]);
function f32(list: number[]): unknown { let sum = 0; for (let i = 0; i < list.length && i < 300; i++) { if (i === 3) { list.length = 1; list.length = 12; } sum += list[i]; } return sum + '|' + list.length; }
