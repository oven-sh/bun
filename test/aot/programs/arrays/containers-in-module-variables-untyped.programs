late.push(() => ((grown = groups()), (grown = bound()), String(takeGrown(() => ((grown[5] = 7), grown.length)))));

let swapped: any;
const takeSwapped = (read: () => any): any => read();
roads.push(
  seed => (
    (swapped = [seed, seed + 1]),
    String(
      takeSwapped(() => {
        const before = swapped[0];
        swapped[0] = swapped[1];
        return before + ":" + swapped[0];
