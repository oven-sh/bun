//// element-getter-key-types.ts
// A typed read of an array element that is an accessor runs the getter, as in plain Bun.
// The result is the same however much the compiler knows about the key: a constant, a number, or a parameter that may be omitted or null.
declare const console: { log(...values: unknown[]): void };
const trace: string[] = [];
function withGetter(): string[] { const a = ["a", "b", "c"]; Object.defineProperty(a, "1", { get() { trace.push("getter"); return "got"; }, configurable: true }); return a; }
function elementAt(a: string[], i: number): string { return a[i]; }
let depth = 0;
function elementAtInFunctionThatCallsItself(a: string[], i: number): string { if (depth > 0) { depth--; elementAtInFunctionThatCallsItself(a, i); } return a[i]; }
function elementAtOptionalKey(a: string[], i?: number): string { if (depth > 0) { depth--; elementAtOptionalKey(a, i); } return a[i as number]; }
function elementAtKeyOrNull(a: string[], i: number | null): string { if (depth > 0) { depth--; elementAtKeyOrNull(a, i); } return a[i as number]; }
function tell(name: string, read: () => unknown): void {
    trace.length = 0;
    let line: string;
    try { line = String(read()); } catch (e) { line = "throws " + (e as Error).constructor.name; }
    console.log(name + ": " + line + " {" + trace.join(",") + "}");
}
for (let round = 0; round < 2; round++) {
    tell("the key a constant", () => withGetter()[1]);
    tell("the key a parameter", () => elementAt(withGetter(), 1));
    tell("in a function that calls itself", () => elementAtInFunctionThatCallsItself(withGetter(), 1));
    tell("the key may be left out", () => elementAtOptionalKey(withGetter(), 1));
    tell("the key may be null", () => elementAtKeyOrNull(withGetter(), 1));
    tell("beside the getter", () => [elementAt(withGetter(), 0), elementAtInFunctionThatCallsItself(withGetter(), 2), elementAtOptionalKey(withGetter(), 0), elementAtKeyOrNull(withGetter(), 2)]);
    tell("beyond the length", () => [elementAt(withGetter(), 3), elementAtInFunctionThatCallsItself(withGetter(), 3), elementAtOptionalKey(withGetter(), 3), elementAtKeyOrNull(withGetter(), 3)]);
    tell("the key left out", () => elementAtOptionalKey(["a", "b"]));
    tell("the key left out, and a property of that name", () => elementAtOptionalKey(Object.assign(["a", "b"], { undefined: "named undefined" })));
    tell("the key null", () => elementAtKeyOrNull(["a", "b"], null));
    tell("the key null, and a property of that name", () => elementAtKeyOrNull(Object.assign(["a", "b"], { null: "named null" }), null));
    tell("no whole number", () => [elementAtOptionalKey(["a", "b"], 0.5), elementAtOptionalKey(["a", "b"], -1), elementAtOptionalKey(["a", "b"], NaN), elementAtKeyOrNull(Object.assign(["a", "b"], { "0.5": "half" }), 0.5)]);
    tell("a store runs the setter", () => { const a = ["a", "b"]; Object.defineProperty(a, "1", { set(v: string) { trace.push("setter " + v); }, configurable: true }); a[1] = "stored"; return a.length; });
}
//// element-getter-read.ts
// Reads and stores of array elements that are accessors, own or inherited, or that reach a Proxy on the prototype chain. The getter, setter or trap runs as in plain Bun, whatever the declared array type.
declare const console: { log(...values: unknown[]): void };
function readAt(a: number[], i: number): number { return a[i]; }
function storeAt(a: number[], i: number, x: number): void { a[i] = x; }
function storeAll(a: number[], x: number): void { for (let i = 0; i < a.length; i++) a[i] = x; }
function readAll(a: number[]): number { let sum = 0; for (let i = 0; i < a.length; i++) sum += a[i]; return sum; }
function readString(a: string[], i: number): string { return a[i]; }
function readTuple(a: [number, number, number]): number { return a[1]; }
function readReadonly(a: readonly number[], i: number): number { return a[i]; }
function iterate(a: number[]): number { let sum = 0; for (const x of a) sum += x; return sum; }
function destructure(a: number[]): number { const [, second] = a; return second; }
function spread(a: number[]): string { return String([...a]); }
function join(a: number[]): string { return a.join(); }
function map(a: number[]): string { return String(a.map(x => x * 2)); }
function unknownByHalf(a: unknown[], x: number): unknown { return a[x / 2]; }
function anyByHalf(a: any[], x: number): any { return a[x / 2]; }
function unknownByFloor(a: unknown[], x: number): unknown { return a[Math.floor(x)]; }
function anyByHalfDoubled(a: any[], x: number): number { return a[x / 2] * 2; }
function mixedByHalf(a: (number | string)[], x: number): number | string { return a[x / 2]; }
function lengthsAround(a: unknown[], x: number): string { const before = a.length; const element = a[x / 2]; const after = a.length; return before + " " + after + " " + String(element); }
function lengthsAroundMixed(a: (number | string)[], x: number): string { const before = a.length; const element = a[x / 2]; const after = a.length; return before + " " + after + " " + String(element); }
const calls: string[] = [];
function tell(name: string, f: () => unknown): void {
  calls.length = 0;
  let text: string;
  try { text = String(f()); } catch (e) { text = e instanceof Error ? e.name : String(e); }
  console.log(name + ": " + text + " [" + calls.join() + "]");
}
const accessor = { get() { calls.push("get"); return 9; }, set(v: number) { calls.push("set " + v); }, configurable: true };
function withHole(): number[] { const a = [1.5, 2.5, 3.5]; delete (a as unknown[])[1]; return a; }
const kinds: [string, () => number[]][] = [
  ["an ordinary array", () => [1.5, 2.5, 3.5]],
  ["its own accessor", () => Object.defineProperty([1.5, 2.5, 3.5], "1", accessor)],
  ["an accessor on its prototype", () => Object.setPrototypeOf(withHole(), Object.create(Array.prototype, { 1: accessor }))],
  ["a Proxy as its prototype", () => Object.setPrototypeOf(withHole(), new Proxy(Array.prototype, { get(target, key, receiver) { if (key !== "1") return Reflect.get(target, key, receiver); calls.push("trap"); return 9; } }))],
];
for (const [kind, make] of kinds) {
  tell(kind + ", read", () => readAt(make(), 1));
  tell(kind + ", another element read", () => readAt(make(), 0));
  tell(kind + ", every element read", () => readAll(make()));
  tell(kind + ", stored to", () => storeAt(make(), 1, 7));
  tell(kind + ", every element stored to", () => storeAll(make(), 7));
}
const own = kinds[1][1];
tell("string[]", () => readString(Object.defineProperty(["a", "b"], "1", { get() { calls.push("get"); return "g"; } }), 1));
tell("a tuple", () => readTuple(own() as [number, number, number]));
tell("readonly number[]", () => readReadonly(own(), 1));
tell("for-of", () => iterate(own()));
tell("destructuring", () => destructure(own()));
tell("spread", () => spread(own()));
tell("join", () => join(own()));
tell("map", () => map(own()));
const growing = (): number[] => { const a = [1.5, 2.5, 3.5]; return Object.defineProperty(a, "1", { get() { calls.push("get"); a.push(0); return 9; }, configurable: true }); };
tell("unknown[], the key a number", () => unknownByHalf(own(), 2));
tell("any[], the key a number", () => anyByHalf(own(), 2));
tell("unknown[], the key from Math.floor", () => unknownByFloor(own(), 1.5));
tell("any[], the key a number, in arithmetic", () => anyByHalfDoubled(own(), 2));
tell("(number | string)[], the key a number", () => mixedByHalf(own(), 2));
tell("unknown[], the length read before and after, the getter grows the array", () => lengthsAround(growing(), 2));
tell("(number | string)[], the length read before and after, the getter grows the array", () => lengthsAroundMixed(growing(), 2));
//// element-getter-read-optional.ts
// A typed read of an array element that is an accessor runs the getter, as in plain Bun, also where the element type allows undefined.
declare const console: { log(...values: unknown[]): void };
function optional(a: (number | undefined)[], i: number): number | undefined { return a[i]; }
function optionalReadonly(a: readonly (number | undefined)[], i: number): number | undefined { return a[i]; }
function optionalTuple(a: [number, number | undefined, number]): number | undefined { return a[1]; }
function optionalTupleMember(a: [number, number?, number?]): number | undefined { return a[1]; }
function optionalDestructure(a: (number | undefined)[]): number | undefined { const [, second] = a; return second; }
function destructureWithDefault(a: number[]): number { const [, second = -1] = a; return second; }
function unknownElement(a: unknown[], i: number): unknown { return a[i]; }
function anyElement(a: any[], i: number): any { return a[i]; }
function nullish(a: readonly number[], i: number): number { return a[i] ?? -1; }
function stringOrUndefined(a: readonly (string | undefined)[], i: number): string | undefined { return a[i]; }
const calls: string[] = [];
function tell(name: string, f: () => unknown): void { calls.length = 0; let text: string; try { text = String(f()); } catch (e) { text = e instanceof Error ? e.name + ": " + e.message.split("\n")[0].slice(0, 52) : String(e); } console.log(name + ": " + text + " [" + calls.join() + "]"); }
const own = (): any => Object.defineProperty([1.5, 2.5, 3.5], "1", { get() { calls.push("get"); return 9; }, configurable: true });
const strings = (): any => Object.defineProperty(["a", "b", "c"], "1", { get() { calls.push("get"); return "g"; }, configurable: true });
tell("(number | undefined)[]", () => optional(own(), 1));
tell("readonly (number | undefined)[]", () => optionalReadonly(own(), 1));
tell("[number, number | undefined, number]", () => optionalTuple(own()));
tell("[number, number?, number?]", () => optionalTupleMember(own()));
tell("destructuring (number | undefined)[]", () => optionalDestructure(own()));
tell("destructuring with a default", () => destructureWithDefault(own()));
tell("unknown[]", () => unknownElement(own(), 1));
tell("any[]", () => anyElement(own(), 1));
tell("readonly number[] ?? -1", () => nullish(own(), 1));
tell("readonly (string | undefined)[]", () => stringOrUndefined(strings(), 1));
//// element-of-a-type-named-like-an-array.ts
// Element reads through every global type whose name ends in "Array": the twelve typed arrays, which vouch for their elements, and the six others, which do not.
function sumOf(list: Int8Array | Uint8Array | Uint8ClampedArray | Int16Array | Uint16Array | Int32Array | Uint32Array | Float32Array | Float64Array): number {
  let total = 0;
  for (let i = 0; i < list.length; i++) total += list[i]!;
  return total;
}
function sumOfHalves(list: Float16Array): number {
  return list[0]! + list[1]!;
}
function sumOfBig(list: BigInt64Array | BigUint64Array): bigint {
  return list[0]! + list[1]!;
}
function pastTheEnd(list: Float64Array, big: BigInt64Array): string {
  try {
    return typeof list[5] + " " + typeof big[5] + " " + typeof list[-1];
  } catch (error) {
    return "caught " + (error as Error).name;
  }
}
function lengthOfFirst(list: ConcatArray<string>): number {
  return list[0]!.length;
}
function lengthOfLast(list: ReadonlyArray<string>): number {
  return list[list.length - 1]!.length;
}
function groups(found: RegExpMatchArray): string {
  return found[0]!.length + " " + typeof found[1] + " " + typeof found[2] + " " + found.length;
}
function executed(found: RegExpExecArray): string {
  return found[0]! + " " + typeof found[2] + " " + found.index;
}
function places(found: RegExpIndicesArray): string {
  return found[0]!.join() + " " + typeof found[2];
}
function tag(parts: TemplateStringsArray, ..._values: unknown[]): number {
  return parts[0]!.length + parts[1]!.length + parts.length;
}

const numbers = [1, 2, 3];
console.log(
  sumOf(new Int8Array(numbers)), sumOf(new Uint8Array(numbers)), sumOf(new Uint8ClampedArray([1, 300])), sumOf(new Int16Array(numbers)), sumOf(new Uint16Array(numbers)),
  sumOf(new Int32Array(numbers)), sumOf(new Uint32Array([4294967295, 1])), sumOf(new Float32Array([0.5, 0.25])), sumOf(new Float64Array([1.5, NaN])), sumOf(new Float64Array([1.5, -0])),
);
console.log(sumOfHalves(new Float16Array([0.5, 1.5])), String(sumOfBig(new BigInt64Array([1n, -2n]))), String(sumOfBig(new BigUint64Array([1n, 2n]))));
console.log(pastTheEnd(new Float64Array(2), new BigInt64Array(2)));
console.log(lengthOfFirst(["abc", "d"]), lengthOfLast(["abc", "de"]));
console.log(groups("a1b22".match(/(\d)(x)?/)!), executed(/(\d)(x)?/.exec("a1b22")!), places(/(\d)(x)?/d.exec("a1b22")!.indices!));
console.log(tag`ab${1}c`);
//// element-reads-with-accessors.ts
declare const console: { log(...values: unknown[]): void };
let depth = 0;
function at<T>(array: readonly T[], index: number): unknown { if (depth > 0) { depth--; at(array, index); } return array[index | 0]; }
function atUnknown(array: unknown[], index: number): unknown { if (depth > 0) { depth--; atUnknown(array, index); } const integer = index | 0; return array[integer]; }
function atNumber(array: unknown[], index: number): unknown { if (depth > 0) { depth--; atNumber(array, index); } return array[index]; }
function describe(value: unknown): string { return value === undefined ? "undefined" : value === null ? "null" : typeof value + ":" + String(value); }
function report(name: string, run: () => unknown): void {
    let text: string;
    try { text = String(run()); } catch (error) { text = error instanceof TypeError ? "TypeError" : "threw " + String(error); }
    console.log(name + ": " + text);
}
let calls = 0;
const arrays: [string, () => unknown[]][] = [
    ["accessor among integers", () => { const array: unknown[] = [1, 2, 3]; Object.defineProperty(array, "1", { get() { calls++; return "computed"; } }); return array; }],
    ["accessor among doubles", () => { const array: unknown[] = [1.5, 2.5, 3.5]; Object.defineProperty(array, "1", { get() { calls++; return "computed"; } }); return array; }],
    ["accessor among strings", () => { const array: unknown[] = ["a", "b", "c"]; Object.defineProperty(array, "1", { get() { calls++; return "computed"; } }); return array; }],
    ["accessor past the end", () => { const array: unknown[] = ["a"]; Object.defineProperty(array, "2", { get() { calls++; return "computed"; } }); return array; }],
    ["accessor that throws", () => { const array: unknown[] = ["a", "b"]; Object.defineProperty(array, "1", { get() { calls++; throw new RangeError("no element"); } }); return array; }],
    ["accessor without a getter", () => { const array: unknown[] = ["a", "b"]; Object.defineProperty(array, "1", { set(_value: unknown) { calls++; } }); return array; }],
];
const indexes = [0, 1, 2, 3, 100, -1, 2147483647, -2147483648];
for (let round = 0; round < 2; round++) {
    for (const [name, make] of arrays) {
        for (const index of indexes) {
            report(name + " [" + index + "]", () => describe(at(make(), index)) + " " + describe(atUnknown(make(), index)) + " " + describe(atNumber(make(), index)));
        }
        report(name + " [1.5]", () => describe(atNumber(make(), 1.5)));
        report(name + " [NaN]", () => describe(atNumber(make(), NaN)));
    }
}
console.log("calls: " + calls);
//// element-reads-with-double-keys.ts
declare const console: { log(...values: unknown[]): void };
let deep = 0;
class Rec { constructor(public amount: number) {} }
function at<T>(a: readonly T[], i: number): unknown { if (deep > 0) { deep--; at(a, i); } return a[i]; }
function recAt(a: Rec[], i: number): Rec | undefined { if (deep > 0) { deep--; recAt(a, i); } return a[i]; }
function strAt(a: string[], i: number): string | undefined { if (deep > 0) { deep--; strAt(a, i); } return a[i]; }
function numAt(a: number[], i: number): number | undefined { if (deep > 0) { deep--; numAt(a, i); } return a[i]; }
function from<T>(a: readonly T[], start: number, f: (x: T) => void): void { if (deep > 0) { deep--; from(a, start, f); } for (let i = start; i < a.length; i++) f(a[i]); }
function downFrom<T>(a: readonly T[], start: number, f: (x: T) => void): void { if (deep > 0) { deep--; downFrom(a, start, f); } for (let i = start; i >= 0; i--) f(a[i]); }
function byHalves<T>(a: readonly T[], f: (x: T) => void): void { if (deep > 0) { deep--; byHalves(a, f); } for (let i = 0; i < a.length; i += 0.5) f(a[i]); }
function twoAt<T>(a: readonly T[], b: readonly T[], i: number): string { if (deep > 0) { deep--; twoAt(a, b, i); } return text(a[i]) + text(b[i]) + text(a[i + 1]) + text(b[i - 1]); }
function text(x: unknown): string { return x === undefined ? "U" : x === null ? "N" : typeof x === "number" ? (Object.is(x, -0) ? "-0" : String(x)) + "n" : x instanceof Rec ? "R" + x.amount : typeof x === "object" ? "{}" : typeof x + ":" + String(x); }
function tell(name: string, f: () => unknown): void { let t: string; try { t = String(f()); } catch (e) { t = e instanceof TypeError ? "TypeError" : e instanceof RangeError ? "RangeError" : "threw " + String(e); } console.log(name + ": " + t); }
const keys = [0, 1, 2, 3, 7, -0, -1, 0.5, 1.5, -0.5, NaN, Infinity, -Infinity, 2147483647, 2147483648, 4294967294, 4294967295, 4294967296, 9007199254740991, 9007199254740992, 1e21, 1e300, 5e-324, 1.0000000000000002];
const kinds: [string, () => unknown[]][] = [
    ["values", () => ["a", null, undefined, 7, 1.5]], ["whole", () => [1, 2, 3]], ["doubles", () => [1.5, -0, 2]], ["empty", () => []], ["holes", () => ["a", , "c"] as unknown[]], ["holes among doubles", () => [1.5, , 3.5] as unknown[]],
    ["named", () => { const a: unknown[] = ["a"]; const r = a as unknown as Record<string, unknown>; r["-1"] = "minus one"; r["1.5"] = "one and a half"; r["NaN"] = "nan"; r["Infinity"] = "inf"; r["4294967295"] = "max"; r["4294967296"] = "over"; r["1e+21"] = "big"; r["5e-324"] = "tiny"; r["9007199254740992"] = "2^53"; return a; }],
    ["sparse", () => { const a: unknown[] = ["a"]; a[4294967294] = "last"; a[2147483648] = "mid"; return a; }], ["frozen", () => Object.freeze(["a", 1.5]) as unknown[]], ["keys", () => Object.keys({ p: 1, q: 2 })],
];
for (let turn = 0; turn < 2; turn++) {
    for (const [name, make] of kinds) {
        tell(name + " at", () => { const a = make(); return keys.map(k => text(at(a, k))).join(" "); });
        tell(name + " two", () => { const a = make(), b = make(); return [0, 1, 0.5, -1, 2, NaN].map(k => twoAt(a, b, k)).join(" "); });
        if (name !== "sparse") for (const s of [0, 1, 0.5, -1, -0, 2, 100, NaN]) tell(name + " from " + s, () => { let t = ""; from(make(), s, x => { t += text(x); }); downFrom(make(), s, x => { t += text(x); }); return t; });
        if (name !== "sparse") tell(name + " by halves", () => { let t = ""; byHalves(make(), x => { t += text(x); }); return t; });
    }
    tell("recs", () => { const a = [new Rec(1), new Rec(2)]; return keys.map(k => text(recAt(a, k))).join(" "); });
    tell("strs", () => { const a = ["p", "q"]; return keys.map(k => text(strAt(a, k))).join(" "); });
    tell("nums", () => { const a = [0.5, 1.5]; return keys.map(k => text(numAt(a, k))).join(" "); });
}
//// elements-by-key-where-another-kind-arrives-than-the-type-says.ts
// An access by key that calls a stub picks the stub by what its receiver is expected to be: an Int32Array, a Uint8Array, an array of numbers. Whatever arrives gets the answer of the language.
const unseen = new Function("x", "return x") as <T>(x: T) => T;
interface Holder { ints: Int32Array; bytes: Uint8Array; numbers: number[] }
const show = (v: unknown): string => (typeof v === "number" && Object.is(v, -0) ? "-0" : typeof v === "object" && v !== null ? JSON.stringify(v) : String(v));

function readInt(h: Holder, i: number): unknown { return h.ints[i]; }
function readByte(h: Holder, i: number): unknown { return h.bytes[i]; }
function readNumber(h: Holder, i: number): unknown { return h.numbers[i]; }
function storeInt(h: Holder, i: number, v: number): void { h.ints[i] = v; }
function storeByte(h: Holder, i: number, v: number): void { h.bytes[i] = v; }
function storeNumber(h: Holder, i: number, v: number): void { h.numbers[i] = v; }
function readIntByValue(h: Holder, i: any): unknown { return h.ints[i]; }
function readNumberByValue(h: Holder, i: any): unknown { return h.numbers[i]; }
function storeIntByValue(h: Holder, i: any, v: any): void { h.ints[i] = v; }
function storeNumberByValue(h: Holder, i: any, v: any): void { h.numbers[i] = v; }

class Counted extends Int32Array { get total(): number { return this.length; } }
const detached = new Int32Array(4); structuredClone(detached.buffer, { transfer: [detached.buffer] });
const resizable = new Int32Array(new ArrayBuffer(16, { maxByteLength: 64 }));
const tracked = new Int32Array(resizable.buffer);
const frozen = Object.freeze([1.5, 2.5, 3.5]);
const sealed = Object.seal([1.5, 2.5, 3.5]);
const withHole = [1.5, , 3.5];
const readOnlyElement = [1.5, 2.5, 3.5]; Object.defineProperty(readOnlyElement, 1, { value: 9.5, writable: false });
const withGetter = [1.5, 2.5, 3.5]; Object.defineProperty(withGetter, 1, { get() { return "got"; }, set(v) { log.push("set " + v); } });
const log: string[] = [];
const proxy = new Proxy([1.5, 2.5], { get(t, k) { log.push("get " + String(k)); return Reflect.get(t, k); }, set(t, k, v) { log.push("put " + String(k)); return Reflect.set(t, k, v); } });

const kinds: [string, () => unknown][] = [
    ["Int32Array", () => new Int32Array([1, -2, 3, 2147483647])],
    ["Uint8Array", () => new Uint8Array([1, 2, 255, 4])],
    ["Int8Array", () => new Int8Array([1, -2, 127, 4])],
    ["Uint32Array", () => new Uint32Array([1, 4294967295, 3, 4])],
    ["Float64Array", () => new Float64Array([1.5, NaN, -0, 4])],
    ["Uint8ClampedArray", () => new Uint8ClampedArray([1, 2, 255, 4])],
    ["BigInt64Array", () => new BigInt64Array([1n, 2n, 3n, 4n])],
    ["subclass", () => new Counted([7, 8, 9, 10])],
    ["detached", () => detached],
    ["resizable", () => resizable],
    ["doubles", () => [1.5, 2.5, -0, 4.25]],
    ["constant doubles", () => [0.5, 1.5, 2.5, 3.5]],
    ["whole doubles", () => { const a = [1.5, 2, 3, 4]; a[0] = 1; return a; }],
    ["int32s", () => [1, 2, 3, 4]],
    ["values", () => ["a", {}, null, 4]],
    ["empty", () => []],
    ["hole", () => withHole.slice()],
    ["NaN inside", () => [1.5, NaN, 3.5]],
    ["frozen", () => frozen],
    ["sealed", () => sealed],
    ["read-only element", () => readOnlyElement],
    ["accessor element", () => withGetter],
    ["proxy", () => proxy],
    ["string", () => "abcd"],
    ["object with indices", () => ({ 0: "zero", 1: "one", length: 2 })],
    ["arguments", () => (function (..._: number[]) { return arguments; })(5, 6, 7)],
    ["number", () => 5],
    ["Map", () => new Map([[0, 1]])],
];
