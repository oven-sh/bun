roads.push(seed => ((frozen = Object.freeze([seed, seed + 1])), String(takeFrozen(() => frozen[1]))));
late.push(() => ((frozen = groups()), (frozen = bound()), String(takeFrozen(() => frozen[1]))));

let made: any;
