function churn(n: number) { for (let i = 0; i < n; i++) { ring[turn++ & 2047] = [i, i]; ring[turn++ & 2047] = { a: i, b: i, c: i, d: i, e: i, f: i }; ring[turn++ & 2047] = ranged([{ v: i }], i); } }
function ranged<T>(elements: T[], at: number): Ranged<T> {
