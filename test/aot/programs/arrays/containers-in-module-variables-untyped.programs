roads.push(seed => ((byCounter = [seed, seed + 1]), String(takeByCounter(() => byCounter[counter++ % 2]))));
late.push(() => ((byCounter = groups()), (byCounter = bound()), String(takeByCounter(() => byCounter[counter++ % 2]))));

