function «1»(): string {
    const seen: string[] = [];
    seen.push(show(«2».map((x: number) => x * 2)));
    seen.push(show(«2».includes(99)));
    seen.push(show(«2».join("-")));
    seen.push(show(«2».some((x: number) => x > 50)));
    seen.push(show(«2».length));
    seen.push(show([...«2»]));
    seen.push(show(«3»()));
    seen.push(show(«4»()));
    seen.push(show(«2».filter(isLarge)));
    return seen.join(" ");
}
