const copied = [1, 2, 3, 4, 5]; copied.copyWithin(0, 3); out.push("copyWithin: " + copied.join());
const flat = [[1, 2], [3, [4, 5]], 6].flat(2); flat.push(7); out.push("flat: " + flat.join());
