//// generic-loop-finds-own-element.ts
// forEach, some, every, reduce and `in` on what is no plain array (an instance of a class that extends Array, an object that is like an array) find an element that is there without asking the run time. What is absent is asked for the way the language has it.
declare const console: { log(...values: unknown[]): void };
declare const aotOperationCount: undefined | ((name: string) => number);
const counted = typeof aotOperationCount === "function" ? aotOperationCount : null;
const asked = () => (counted ? counted("operationAOTInByVal") + counted("operationAOTElementOrEmpty") : 0);
class Rows<T> extends Array<T> {}
class Inherits<T> extends Array<T> {}
(Inherits.prototype as any)[1] = "inherited";
function filled<L extends unknown[]>(list: L, ...values: unknown[]): L { for (const value of values) list.push(value); return list; }
function walk(list: any): string {
    let said = "";
    list.forEach((x: unknown, i: number) => { said += i + ":" + x + " "; });
    said += list.some((x: unknown) => x === "nowhere") + " ";
    said += list.every((x: unknown) => x !== "nowhere") + " ";
    said += list.reduce((sum: any, x: unknown) => sum + String(x).length, 0) + " ";
    said += (0 in list) + " " + (1 in list) + " " + (2 in list) + " ";
    return said;
}
function tell(name: string, list: unknown, isFoundInPlace: boolean): void {
    walk(list);
    const before = asked();
    let said = "";
    for (let round = 0; round < 100; round++) said = walk(list);
    const times = asked() - before;
    console.log(name + ": " + said + (!counted || (isFoundInPlace ? times === 0 : times > 0)));
}
const likeAnArray = (members: object) => Object.assign(Object.create({ forEach: Array.prototype.forEach, some: Array.prototype.some, every: Array.prototype.every, reduce: Array.prototype.reduce }), members);
tell("strings", filled(new Rows<string>(), "a", "b", "c"), true);
tell("integers", filled(new Rows<number>(), 1, 2, 3), true);
tell("numbers", filled(new Rows<number>(), 1.5, 2.5, 3.5), true);
tell("like an array", likeAnArray({ length: 3, 0: "a", 1: "b", 2: "c" }), true);
tell("an array", ["a", "b", "c"], true);
tell("a hole below an element of the prototype", (() => { const list = filled(new Inherits<string>(), "a", "b", "c"); delete list[1]; return list; })(), false);
tell("a hole", (() => { const list = filled(new Rows<string>(), "a", "b", "c"); delete list[1]; return list; })(), false);
tell("a hole in an array", (() => { const list = ["a", "b", "c"]; delete list[1]; return list; })(), true);
tell("shorter than it says", likeAnArray({ length: 3, 0: "a" }), false);
//// growth-in-counted-loops.js
// Arrays that counted loops append to: parameters, fields, literals longer than any planned capacity, arrays that cannot grow in place, loops that end early, and arrays replaced inside the loop.
function checksum(array) {
  let sum = 0;
  for (let i = 0; i < array.length; i++) sum = (Math.imul(sum, 31) + (array[i] | 0)) | 0;
  return array.length + ":" + sum;
}

function fill(list, n) {
  for (let i = 0; i < n; i++) list.push(i);
  return list;
}

function fillDown(list, n) {
  for (let i = n; i > 0; i--) list.push(i);
  return list;
}

function fillInclusive(list, n) {
  for (let i = 0; i <= n; i++) list.push(i * 0.5);
  return list;
}

function fillTwice(list, n) {
  for (let i = 0; i < n; i++) {
    list.push(i);
    list.push(-i);
  }
  return list;
}

function collect(n) {
  const kept = [];
  for (let i = 0; i < n; ++i) kept.push(i);
  return kept;
}

function copyInto(out, from) {
  for (let i = 0; i < from.length; i++) out.push(from[i]);
  return out;
}

class Bag {
  constructor() {
    this.items = [];
  }
  addAll(from) {
    for (let i = 0; i < from.length; i++) this.items.push(from[i]);
    return this;
  }
}

class Chunks {
  constructor() {
    this.current = [];
    this.full = [];
  }
  addAll(from, size) {
    for (let i = 0; i < from.length; i++) {
      this.current.push(from[i]);
      if (this.current.length === size) {
        this.full.push(this.current);
        this.current = [];
      }
    }
    return this;
  }
}

function fillUntilThrow(list, n, limit) {
  try {
    for (let i = 0; i < n; i++) {
      if (i === limit) throw new RangeError("stop");
      list.push(i);
    }
  } catch (error) {
    return error.message + " " + checksum(list);
  }
  return checksum(list);
}

function attempt(action) {
  try {
    return String(action());
  } catch (error) {
    return error.constructor.name;
  }
}

for (const n of [0, 1, 5, 6, 7, 100, 5000, 150000]) {
  console.log(n, checksum(fill([], n)), checksum(fillDown([], n)), checksum(fillInclusive([], n)), checksum(fillTwice([], n)), checksum(collect(n)));
  const source = collect(n);
  console.log(checksum(copyInto([], source)), checksum(copyInto([1, 2, 3], source)), checksum(new Bag().addAll(source).addAll(source).items));
}

const chunks = new Chunks().addAll(collect(100000), 8);
console.log(chunks.full.length, chunks.current.length, checksum(chunks.full[12499]));

console.log(checksum(fill([0.5, 1.5], 1000)), checksum(fill(["a", "b"], 1000)), checksum(fill([, , 1], 1000)));
console.log(fill([1, 2, 3], -5).length, fill([1, 2, 3], NaN).length, fill([1, 2, 3], 2.5).length, fill([1, 2, 3], "4").length);
console.log(attempt(() => fill(Object.freeze([1, 2]), 10).length), attempt(() => fill(Object.seal([1, 2]), 10).length), attempt(() => fill(Object.preventExtensions([1, 2]), 10).length));

const sparse = [];
sparse[200000] = 1;
console.log(fill(sparse, 100).length, sparse[200001], sparse[200100]);

const named = [1];
named.label = "kept";
console.log(checksum(fill(named, 5000)), named.label);

class Stack extends Array {}
console.log(checksum(fill(new Stack(), 5000)), fill(new Stack(), 3) instanceof Stack);

const constant = () => [1, 2, 3, 4];
console.log(checksum(fill(constant(), 2000)), checksum(constant()));

console.log(fillUntilThrow([], 1000000, 10), fillUntilThrow([], 20, 50));

const shared = [];
for (let round = 0; round < 2000; round++) fill(shared, 3);
console.log(checksum(shared));
//// holes-and-numbers-that-fit-no-integer-among-numbers-read-as-integers.ts
// An element of a `number[]` that goes straight into `^`, `|`, `>>`, or is the index of the next read: whether it is there and whether it is whole or fits an integer is asked at once.
// A hole is read as undefined, NaN as NaN, and a number outside every integer is wrapped as ECMAScript says: none is taken for another.
function xorAll(numbers: number[]): number {
  let result = 0;
  for (let i = 0; i < numbers.length; i++) result ^= numbers[i]!;
  return result;
}
function orEach(numbers: number[]): string {
  let text = "";
  for (const each of numbers) text += (each | 0) + ",";
  return text;
}
function shifted(numbers: number[], index: number): number {
  return numbers[index]! >> 1;
}
function unsigned(numbers: number[], index: number): number {
  return numbers[index]! >>> 0;
}
function chase(numbers: number[], start: number): unknown {
  let at: number = start;
  at = numbers[at]!;
  at = numbers[at]!;
  at = numbers[at]!;
  return at;
}
function storeAndChase(numbers: number[], start: number): unknown {
  let at: number = start;
  numbers[at] = at;
  at = numbers[at + 1]!;
  numbers[at] = at;
  at = numbers[at + 1]!;
  return at;
}
function firstTwo(numbers: number[]): number {
  const [a, b] = numbers;
  return a! ^ b!;
}
function show(value: unknown): string {
  return Object.is(value, -0) ? "-0" : String(value);
}
function describe(numbers: number[]): string {
  let text = "";
  for (let i = 0; i < numbers.length && i < 8; i++) text += (i in numbers ? show(numbers[i]) : "hole") + ",";
  return text + numbers.length;
}

const kinds: [string, () => number[]][] = [
  ["whole", () => [1, 2, 3, 0, 2]],
  ["fractions", () => [1.5, 2, 0.25, 3, 1]],
  ["a hole", () => { const a: number[] = [1, 2, 3, 4, 0]; delete a[2]; return a; }],
  ["a hole at the start", () => { const a: number[] = [1, 2, 3, 4, 0]; delete a[0]; return a; }],
  ["only holes", () => { const a: number[] = [0.5]; a.length = 4; delete a[0]; return a; }],
  ["NaN", () => [1, NaN, 3, 1, 0]],
  ["infinite", () => [1, Infinity, -Infinity, 1, 0]],
  ["negative zero", () => [-0, 1, -0, 0, 2]],
  ["two to the 31", () => [2147483648, -2147483649, 4294967296, 4294967295.5, 1]],
  ["two to the 53", () => [9007199254740992, -9007199254740992, 9007199254740993, 1, 0]],
  ["the ends of int64", () => [9223372036854775807, -9223372036854775808, 9223372036854775808 * 2, -9223372036854777856, 18446744073709551616]],
  ["huge", () => [1e300, -1e300, 1.7976931348623157e308, 5e-324, 1e21]],
  ["negative", () => [-1, -2, -3.5, 4, 0]],
  ["past the end", () => [7, 100, 5, 4294967295, 4294967294]],
];
for (let round = 0; round < 3; round++) {
  for (const [what, make] of kinds) {
    const numbers = make();
    const answers = [xorAll(numbers), orEach(numbers), firstTwo(numbers)];
    for (let i = 0; i < 6; i++) answers.push(shifted(numbers, i), unsigned(numbers, i), show(chase(numbers, i)));
    console.log(what, "|", answers.join(" "), "|", describe(numbers));
    const stored = [];
    for (let i = 0; i < 4; i++) stored.push(show(storeAndChase(numbers, i)));
    console.log(what, "stores |", stored.join(" "), "|", describe(numbers));
  }
}
//// holes-in-the-loops-of-map-filter-and-their-like.ts
// `k in array` skips a hole in the loops of map, filter, forEach, some, every, reduce and their like. The arm of the hole is a slow path of the compiled loop: arrays that are all holes, half holes or get their holes while the loop runs give what plain Bun gives, and so do prototypes that fill a hole.
const launder = new Function("v", "return v") as <V>(v: V) => V;
function show(what: string, f: () => unknown) { let last: unknown; for (let round = 0; round < 300; round++) last = f(); console.log(what, JSON.stringify(last, (_, v) => (v === undefined ? "undefined" : v))); }
function list(a: unknown[]): unknown[] { const seen: unknown[] = []; for (let i = 0; i < a.length; i++) seen.push(i in a ? a[i] : "hole"); return [a.length, seen]; }
function sparse(n: number, step: number): number[] { const a: number[] = new Array(n); for (let i = 0; i < n; i += step) a[i] = i; return a; }
function punched(n: number, at: number): string[] { const a: string[] = []; for (let i = 0; i < n; i++) a.push("s" + i); delete a[at]; return a; }

for (const step of [1, 2, 3, 100]) {
  show("map " + step, () => list(sparse(7, step).map((v) => v + 1)));
  show("map into objects " + step, () => list(sparse(7, step).map((v) => ({ v }))));
  show("filter " + step, () => list(sparse(7, step).filter((v) => v >= 0)));
  show("forEach " + step, () => { const seen: number[] = []; sparse(7, step).forEach((v, i) => seen.push(v, i)); return seen; });
  show("some " + step, () => { let calls = 0; const found = sparse(7, step).some((v) => (calls++, v > 100)); return [found, calls]; });
  show("every " + step, () => { let calls = 0; const all = sparse(7, step).every((v) => (calls++, v >= 0)); return [all, calls]; });
  show("reduce " + step, () => sparse(7, step).reduce((sum, v, i) => sum + v * 10 + i, 0));
  show("reduceRight " + step, () => sparse(7, step).reduceRight((text, v) => text + v, ""));
  show("indexOf " + step, () => [sparse(7, step).indexOf(undefined as never), sparse(7, step).lastIndexOf(6), sparse(7, step).includes(undefined as never)]);
  show("find sees holes " + step, () => { let calls = 0; sparse(7, step).find(() => (calls++, false)); return calls; });
  show("flatMap " + step, () => list(sparse(7, step).flatMap((v) => [v, v])));
}
show("no element at all", () => { let calls = 0; const a: number[] = new Array(5); return [list(a.map(() => calls++)), list(a.filter(() => (calls++, true))), calls]; });
show("a deleted text", () => list(punched(5, 2).map((s) => s + "!")));
show("the first is deleted", () => list(punched(5, 0).map((s) => s.length)));
show("the last is deleted", () => list(punched(5, 4).filter(() => true)));
show("the callback deletes what is ahead", () => { const a = punched(6, 1); const seen: string[] = []; a.forEach((s, i) => { seen.push(s); delete a[i + 2]; }); return seen; });
show("the callback fills the hole ahead", () => { const a = sparse(6, 2); return list(a.map((v, i) => { a[i + 1] = 100 + i; return v; })); });
show("the callback makes the array sparse", () => { const a = sparse(4, 1); const seen: number[] = []; a.forEach((v) => { seen.push(v); a[50000] = 1; }); return [seen, a.length]; });
show("an array from outside", () => list(launder(sparse(6, 2)).map((v) => v * 2)));
show("in, by hand", () => { const a = sparse(8, 3); let present = 0, absent = 0; for (let i = 0; i < a.length; i++) { if (i in a) present += a[i]; else absent++; } return [present, absent]; });
show("in, by hand, nothing else", () => { const a = sparse(8, 3); let present = 0; for (let i = 0; i < a.length; i++) { if (i in a) present += a[i]; } return present; });
show("in, beyond the length and below zero", () => { const a = sparse(3, 1); return [3 in a, -1 in a, 1.5 in a, 2 in a, "1" in a, "length" in a]; });
class Inherits extends Array<number> {}
Object.defineProperty(Inherits.prototype, 1, { value: "from the prototype", configurable: true, writable: true });
show("a prototype fills the hole", () => { const a = new Inherits(3); a[0] = 0; a[2] = 2; return [list(Array.prototype.map.call(a, (v) => v)), 1 in a, a[1]]; });
//// holes-reach-arrays-through-other-code.js
// An array that looks whole where it is read gets its hole somewhere else: in a callback, a method, a generator, a later turn of the event loop, through a container or beside an array from outside.
const lines = [];
function show(name, f) { try { lines.push(name + ": " + f()); } catch (error) { lines.push(name + ": threw " + error.name); } }

function inSortCallback() {
  const a = [5, 3, 4, 1, 2];
  let calls = 0;
  a.sort((x, y) => { if (++calls === 2) delete a[4]; return x - y; });
  let s = "";
  for (let i = 0; i < a.length; i++) s += (i in a ? "" : "hole ") + a[i] + ",";
  return s;
}
show("sort callback deletes", () => inSortCallback().length > 0);

function inForEach() {
  const a = [1, 2, 3, 4];
  let s = "";
  a.forEach((v, i) => { if (i === 0) delete a[2]; s += v + ","; });
  for (let i = 0; i < a.length; i++) s += (i in a ? "" : "hole ") + a[i] + ",";
  return s;
}
show("forEach callback deletes", inForEach);

function inMap() {
  const a = [1, 2, 3, 4];
  const b = a.map((v, i) => { if (i === 0) a.length = 2; return v * 2; });
  let s = "";
  for (let i = 0; i < b.length; i++) s += (i in b ? "" : "hole ") + b[i] + ",";
  return s + b.length;
}
show("map callback shortens its source", inMap);

function mapOfHoles() {
  const b = [1, , 3].map(v => v * 2);
  let s = "";
  for (let i = 0; i < b.length; i++) s += (i in b ? "" : "hole ") + b[i] + ",";
  return s;
}
show("map of holes", mapOfHoles);

function filterOfHoles() {
  const b = [1, , 3, , 5].filter(() => true);
  let s = "";
  for (let i = 0; i < b.length; i++) s += (i in b ? "" : "hole ") + b[i] + ",";
  return s;
}
show("filter of holes", filterOfHoles);

class Stack {
  constructor() { this.items = [1, 2, 3]; }
  drop(i) { delete this.items[i]; }
  grow(n) { this.items.length = n; }
  text() { let s = ""; for (let i = 0; i < this.items.length; i++) s += (i in this.items ? "" : "hole ") + this.items[i] + ","; return s; }
}
function inMethod() { const t = new Stack(); t.drop(1); return t.text(); }
show("method deletes", inMethod);
function inOtherMethod() { const t = new Stack(); t.grow(5); return t.text(); }
show("method lengthens", inOtherMethod);

function* walker(list) { for (let i = 0; i < list.length; i++) yield (i in list ? "" : "hole ") + list[i]; }
function inGenerator() {
  const a = ["a", "b", "c", "d"];
  const w = walker(a);
  let s = w.next().value + ",";
  delete a[2];
  for (const v of w) s += v + ",";
  return s;
}
show("deleted while a generator walks", inGenerator);

function throughMap() {
  const a = [1.5, 2.5, 3.5];
  const m = new Map([["k", a]]);
  delete m.get("k")[1];
  let s = "";
  for (let i = 0; i < a.length; i++) s += (i in a ? "" : "hole ") + a[i] + ",";
  return s;
}
show("through a Map", throughMap);

function throughNesting() {
  const inner = [1, 2, 3];
  const outer = [inner, [4, 5, 6]];
  for (const row of outer) delete row[0];
  let s = "";
  for (let i = 0; i < inner.length; i++) s += (i in inner ? "" : "hole ") + inner[i] + ",";
  return s;
}
show("through the array that holds it", throughNesting);

function besideParsed(text) {
  const a = text.length > 3 ? JSON.parse(text) : [1, 2, 3];
  const b = text.length > 3 ? [1, 2, 3] : JSON.parse(text);
  delete a[1];
  let s = "";
  for (let i = 0; i < a.length; i++) s += (i in a ? "" : "hole ") + a[i] + ",";
  for (let i = 0; i < b.length; i++) s += (i in b ? "" : "hole ") + b[i] + ",";
  return s;
}
show("beside a parsed array", () => besideParsed("[7, 8, 9]"));

function cloned() {
  const a = structuredClone([1, , 3]);
  let s = "";
  for (let i = 0; i < a.length; i++) s += (i in a ? "" : "hole ") + a[i] + ",";
  return s;
}
show("a clone of holes", () => (typeof structuredClone === "function" ? cloned() : "1,hole undefined,3,"));

function storedUndefined() {
  const a = [1, 2, 3];
  a.push(undefined);
  a.fill(undefined, 0, 1);
  let s = "";
  for (let i = 0; i < a.length; i++) s += (i in a ? "" : "hole ") + a[i] + ",";
  let sum = 0;
  for (const v of a) sum += v === undefined ? 100 : v;
  return s + sum;
}
show("undefined is no hole", storedUndefined);

function prototypeAnswersForHole() {
  const a = [1, 2, 3];
  Object.setPrototypeOf(a, { 1: "from the prototype", __proto__: Array.prototype });
  delete a[1];
  let s = "";
  for (let i = 0; i < a.length; i++) s += a[i] + ",";
  return s;
}
show("a prototype answers for the hole", prototypeAnswersForHole);

const shared = [1, 2, 3, 4];
function readShared() { let s = ""; for (let i = 0; i < shared.length; i++) s += (i in shared ? "" : "hole ") + shared[i] + ","; return s; }
show("module variable, before", readShared);
function holeLater() { delete shared[1]; }
holeLater();
show("module variable, after", readShared);

async function acrossAwait() {
  const a = [1, 2, 3, 4];
  const other = Promise.resolve().then(() => { delete a[3]; a.length = 6; });
  let s = "";
  for (let i = 0; i < a.length; i++) { s += (i in a ? "" : "hole ") + a[i] + ","; await null; }
  await other;
  return s;
}
acrossAwait().then(text => {
  show("deleted in another turn", () => text);
  console.log(lines.join("\n"));
});
//// hundreds-of-names-that-are-no-index-in-a-validating-build.ts
// Negative numbers name properties of an array, no elements, and some hundreds of them make a dictionary of its structure. None of them shadows a member of Array.prototype, so what is proven of the array's names stays true, and a validating build has nothing to find.
type Path = { oldPos: number; steps: number };
// The shortest edit between two lists: the best path of each diagonal is kept in one array, and the diagonals left of the middle have negative numbers.
function edits(a: string[], b: string[]): number {
  const bestPath: (Path | undefined)[] = [{ oldPos: -1, steps: 0 }];
  const follow = (path: Path, diagonal: number): number => {
    let oldPos = path.oldPos, newPos = oldPos - diagonal;
    while (newPos + 1 < b.length && oldPos + 1 < a.length && a[oldPos + 1] === b[newPos + 1]) { newPos++; oldPos++; }
    path.oldPos = oldPos;
    return newPos;
  };
  if (follow(bestPath[0]!, 0) + 1 >= b.length && bestPath[0]!.oldPos + 1 >= a.length) return 0;
  for (let length = 1; length <= a.length + b.length; length++) {
    for (let diagonal = -length; diagonal <= length; diagonal += 2) {
      const remove = bestPath[diagonal - 1], add = bestPath[diagonal + 1];
      if (remove) bestPath[diagonal - 1] = undefined;
      const canAdd = add !== undefined && add.oldPos - diagonal >= 0 && add.oldPos - diagonal < b.length;
      const canRemove = remove !== undefined && remove.oldPos + 1 < a.length;
      if (!canAdd && !canRemove) { bestPath[diagonal] = undefined; continue; }
      const path: Path = !canRemove || (canAdd && remove!.oldPos < add!.oldPos) ? { oldPos: add!.oldPos, steps: add!.steps + 1 } : { oldPos: remove!.oldPos + 1, steps: remove!.steps + 1 };
      const newPos = follow(path, diagonal);
      if (path.oldPos + 1 >= a.length && newPos + 1 >= b.length) return path.steps;
      bestPath[diagonal] = path;
    }
  }
  return -1;
}
for (const count of [1, 64, 65, 150]) {
  const a = Array.from({ length: count }, (_, i) => "a" + i), b = Array.from({ length: count }, (_, i) => "b" + i);
  console.log(count, edits(a, b));
}

function lengths(a: number[], n: number): number {
  let sum = 0;
  for (let i = -n; i < 0; i++) { a[i] = 1; if (sum === -1) a.pop(); sum += a.length; }
  return sum;
}
for (const count of [128, 129, 300]) console.log(count, lengths([1, 2, 3], count));

function named(count: number): string {
  const a: number[] = [1, 2, 3];
  for (let i = 0; i < count; i++) (a as any)["name" + i] = i;
  a.push(4);
  return a.map(value => value * 2).join() + " " + a.pop() + " " + Object.keys(a).length + " " + (a as any)["name" + (count - 1)];
}
for (const count of [10, 300]) console.log(count, named(count));
