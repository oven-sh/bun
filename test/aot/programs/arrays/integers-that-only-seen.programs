//// local-arrays-any-index.ts
// Arrays that are made, read at an index that is only known when the program runs, and dropped: rest parameters of functions that are inlined, and literals. Every index: inside, the length, beyond, negative, the largest array index and what lies behind it. Two reads in one expression, reads in nested loops, behind a condition, under try, in a loop that leaves early. Elements that are numbers, undefined, NaN, -0, records, strings, mixed. And the neighbours that must stay as they are: an index that is no whole number, a store, a push, an array that is handed on.
declare const console: { log(...values: unknown[]): void };
class Rec { constructor(public id: number) {} }
function show(v: unknown): string { return v instanceof Rec ? "#" + v.id : v === undefined ? "undefined" : v === null ? "null" : typeof v === "string" ? "'" + v + "'" : Object.is(v, -0) ? "-0" : String(v); }
function sum(...xs: number[]): number { let s = 0; for (let k = 0; k < xs.length; k++) s += xs[k]; return s; }
function sumDown(...xs: number[]): number { let s = 0; for (let k = xs.length - 1; k >= 0; k--) s += xs[k]; return s; }
function pairs(...xs: number[]): number { let s = 0; for (let i = 0; i < xs.length; i++) for (let j = 0; j < xs.length; j++) s += xs[i] * xs[j] + xs[j]; return s; }
function atInt(i: number, ...xs: number[]): number | undefined { return xs[i | 0]; }
function atUint(i: number, ...xs: number[]): number | undefined { return xs[i >>> 0]; }
function atNumber(i: number, ...xs: number[]): number | undefined { return xs[i]; }
function neighbours(i: number, ...xs: number[]): string { const k = i | 0; return show(xs[k]) + show(xs[k + 1]) + show(xs[k - 1]) + show(xs[k]); }
function firstBig(least: number, ...xs: number[]): number { for (let k = 0; k < xs.length; k++) { if (xs[k] >= least) return k; } return -1; }
function guarded(i: number, ...rs: Rec[]): string { try { return "#" + rs[i | 0].id; } catch (e) { return "caught " + (e instanceof TypeError); } }
function maybe(flag: boolean, i: number, ...xs: number[]): number | undefined { if (flag) return xs[i | 0]; return xs.length; }
function recAt(i: number, ...rs: Rec[]): Rec | undefined { return rs[i | 0]; }
function textAt(i: number, ...ts: string[]): string | undefined { return ts[i | 0]; }
function anyAt(i: number, ...vs: unknown[]): unknown { return vs[i | 0]; }
function literalAt(i: number, a: number, b: number): number | undefined { const both = [a, b]; return both[i | 0]; }
function emptyAt(i: number): unknown { const none: unknown[] = []; return none[i | 0]; }
function storedThenRead(i: number, ...xs: number[]): number | undefined { xs[1] = 40; return xs[i | 0]; }
function pushedThenRead(i: number, ...xs: number[]): number | undefined { xs.push(50); return xs[i | 0]; }
let seen: number[] = [];
function handedOn(i: number, ...xs: number[]): number | undefined { seen = xs; return xs[i | 0]; }
function four(i: number, a: number): number | undefined { const few = [a, 2.5, a + 1, 4.5]; return few[i | 0]; }
function five(i: number, a: number): number | undefined { const some = [a, 2.5, a + 1, 4.5, 5.5]; return some[i | 0]; }
function nine(i: number): number | undefined { const many = [1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5, 9.5]; return many[i | 0]; }
const values: number[] = []; for (let i = 0; i < 8; i++) values.push(i + 0.5);
const indexes = [0, 1, 2, 3, 4, -1, -2, 2147483647, -2147483648, 4294967294, 4294967295, 4294967296, 9007199254740991, 0.5, 1.5, -0.5, NaN, Infinity, -Infinity, -0];
const r1 = new Rec(1), r2 = new Rec(2), r3 = new Rec(3);
const out: string[] = [];
for (let round = 0; round < 3; round++) {
  let t = 0;
  for (let i = 0; i < values.length; i++) { const v = values[i]; t += sum(v, v + 1, v + 2) + sumDown(v, 1, v) + pairs(v, 2) + sum(v) + sum() + firstBig(3, v, v + 1, v + 2, v + 3); }
  out.push("sums " + t + " " + show(sum(values[8], 1)) + show(sum(NaN, 1)) + show(sum(-0)) + show(Object.is(sum(-0, -0), -0)) + show(sumDown(values[9], values[0])));
  let line = "";
  for (const i of indexes) line += show(atInt(i, 1.5, 2.5, 3.5)) + "," + show(atUint(i, 1.5, 2.5, 3.5)) + "," + show(atNumber(i, 1.5, 2.5, 3.5)) + ";";
  out.push("every index " + line);
  line = ""; for (const i of indexes) line += neighbours(i, 1.5, values[9], -0, NaN) + ";"; out.push("neighbours " + line);
  line = ""; for (const i of indexes) line += guarded(i, r1, r2) + "," + show(recAt(i, r1, r2, r3)) + "," + show(textAt(i, "a", "b")) + "," + show(anyAt(i, 1, "a", null, undefined, r3, 0.5, true)) + ";"; out.push("others " + line);
  line = ""; for (const i of indexes) line += show(maybe(true, i, 1.5, 2.5)) + show(maybe(false, i, 1.5, 2.5)) + "," + show(literalAt(i, 7.5, values[round])) + "," + show(emptyAt(i)) + "," + show(atInt(i)) + "," + show(nine(i)) + "," + show(four(i, values[round])) + "," + show(five(i, values[round])) + ";"; out.push("literals " + line);
  line = ""; for (const i of indexes) { line += show(storedThenRead(i, 1.5, 2.5, 3.5)) + "," + show(pushedThenRead(i, 1.5, 2.5)) + "," + show(handedOn(i, 1.5, 2.5)) + show(seen.length) + ";"; } out.push("what must stay " + line);
}
for (const text of out) console.log(text);
//// local-boolean-arrays.ts
function paintedPosts(lastPost: number): string {
  const painted = new Array<boolean>(1 + lastPost).fill(false);
  for (let painter = 1; painter <= lastPost; painter++) {
    for (let post = painter * painter; post <= lastPost; post += painter + painter) painted[post] = true;
  }
  let bare = 0;
  let sumOfBare = 0;
  for (let post = 0; post <= lastPost; post++) {
    if (painted[post]) continue;
    bare++;
    sumOfBare += post;
  }
  return bare + ":" + sumOfBare;
}
function bornTrue(size: number): string {
  const open = new Array<boolean>(size).fill(true);
  for (let i = 0; i < size; i += 3) open[i] = false;
  let said = "";
  for (let i = 0; i < size; i++) said += open[i] ? "o" : ".";
  for (let i = 1; i < size; i += 4) open[i] = true;
  let count = 0;
  for (let i = 0; i < size; i++) if (open[i] === true) count++;
  return said + count;
}
function askedForItsLength(size: number): string {
  const marks = Array<boolean>(size).fill(false);
  for (let i = 0; i < marks.length; i += 2) marks[i] = true;
  let on = 0;
  for (let i = 0; i < marks.length; i++) if (marks[i]) on++;
  return on + " of " + marks.length;
}
function ofAConstantLength(seed: number): string {
  const seen = new Array<boolean>(10).fill(false);
  let digits = 0;
  for (let rest = seed; rest > 0; rest = Math.floor(rest / 10)) {
    const digit = rest % 10 | 0;
    if (digit >= 0 && digit < 10) {
      if (!seen[digit]) digits++;
      seen[digit] = true;
    }
  }
  return digits + " " + seen[0] + " " + seen[9];
}
function storesWhatATestSays(size: number): string {
  const even = new Array<boolean>(size).fill(false);
  const notEven = new Array<boolean>(size).fill(true);
  for (let i = 0; i < size; i++) {
    even[i] = i % 2 === 0;
    notEven[i] = i % 2 !== 0;
  }
  const kept: unknown[] = [];
  for (let i = 0; i < size; i++) kept.push(even[i], notEven[i]);
  return JSON.stringify(kept);
}
function twoAtOnce(size: number): number {
  const rows = new Array<boolean>(size).fill(false), columns = new Array<boolean>(size + 1).fill(false);
  for (let i = 0; i < size; i += 2) rows[i] = true;
  for (let i = 0; i <= size; i += 3) columns[i] = true;
  let both = 0;
  for (let i = 0; i < size; i++) if (rows[i] && columns[i]) both++;
  return both;
}
function bornInALoop(greatestSize: number): string {
  let said = "";
  for (let size = 0; size <= greatestSize; size += 3) {
    const flags = new Array<boolean>(size).fill(false);
    for (let i = 1; i < size; i += 2) flags[i] = true;
    let on = 0;
    for (let i = 0; i < size; i++) if (flags[i]) on++;
    said += on + "/" + size + " ";
  }
  return said;
}

function isReturned(size: number): boolean[] {
  const made = new Array<boolean>(size).fill(false);
  for (let i = 0; i < size; i += 2) made[i] = true;
  return made;
}
function describe(list: boolean[]): string {
  return Array.isArray(list) + " " + list.join("");
}
function isPassedOn(size: number): string {
  const made = new Array<boolean>(size).fill(false);
  for (let i = 0; i < size; i += 2) made[i] = true;
  return describe(made);
}
function isCaptured(size: number): () => number {
  const made = new Array<boolean>(size).fill(true);
  for (let i = 0; i < size; i += 2) made[i] = false;
  return () => made.filter(Boolean).length;
}
const keysOutOfData = [1, 3, 9, -2, 1.5];
function keyOutOfData(size: number): string {
  const keys = keysOutOfData;
  const hit = new Array<boolean>(size).fill(false);
  for (const key of keys) hit[key] = true;
  let said = "";
  for (const key of keys) said += hit[key] + ",";
  return said + hit.length + Object.keys(hit).length;
}
function storesPastTheEnd(size: number): string {
  const grows = new Array<boolean>(size).fill(false);
  for (let i = 0; i <= size; i++) grows[i] = true;
  return grows.length + " " + grows[size];
}
function mayReadBelowZero(size: number): string {
  const flags = new Array<boolean>(size).fill(true);
  let said = "";
  for (let i = size - 1; i < size && said.length < 40; i -= 2) said += flags[i] + " ";
  return said;
}
function fractionalSteps(size: number): string {
  const flags = new Array<boolean>(size).fill(false);
  for (let x = 0; x < size; x += 0.5) flags[x] = true;
  return flags.length + " " + Object.keys(flags).join();
}
function isNeverFilled(size: number): string {
  const holes = new Array<boolean>(size);
  for (let i = 0; i < size; i += 2) holes[i] = true;
  let said = "";
  for (let i = 0; i < size; i++) said += holes[i] + " ";
  return said;
}
function holdsOtherThings(size: number): string {
  const mixed: unknown[] = new Array<unknown>(size).fill(false);
  for (let i = 0; i < size; i += 2) mixed[i] = i;
  let said = "";
  for (let i = 0; i < size; i++) said += mixed[i] + " ";
  return said;
}
function isMadeShorter(size: number): string {
  const flags = new Array<boolean>(size).fill(true);
  flags.length = 1;
  let said = "";
  for (let i = 0; i < size; i++) said += flags[i] + " ";
  return said;
}
function outcome(run: () => unknown): string {
  let said: string;
  try {
    said = String(run());
  } catch (error) {
    said = (error as Error).constructor.name + ": " + (error as Error).message;
  }
  return said;
}
function withOddSizes(run: (size: number) => unknown): string {
  return [
    outcome(() => run(-1)),
    outcome(() => run(-2)),
    outcome(() => run(1.5)),
    outcome(() => run(NaN)),
    outcome(() => run(Infinity)),
    outcome(() => run(4294967296)),
    outcome(() => run(-0)),
  ].join(", ");
}

for (let round = 0; round < 2; round++) {
  console.log(paintedPosts(50), paintedPosts(2), paintedPosts(0), paintedPosts(-1), paintedPosts(1000));
  console.log(bornTrue(11), bornTrue(1), bornTrue(0), "|", askedForItsLength(7), askedForItsLength(1), "|", ofAConstantLength(9024409), ofAConstantLength(0));
  console.log(storesWhatATestSays(5), twoAtOnce(20), twoAtOnce(0), bornInALoop(10), bornInALoop(0), bornInALoop(-1));
