//// integers-that-only-seen-code-holds-are-taken-for-doubles-where-another-object-also-arrives.ts
// A literal of small integers that only code of the program holds is stored as 32-bit integers, and whoever reads it by its own name counts on that without a test. The same array also lies in a position of type `number[]` which something that is no array reaches through `any`: a variable, a captured variable, a field, a result, an element. The code behind that position counts on doubles, and may turn the storage into doubles the first time it meets the integers. Nothing of it can be seen: every line is plain Bun's.
// STATISTIC: IntegerArrayConversionsPlaced >= 1
const n = process.argv.length & 1;
////= lines-19	sum	xs	s	i	xs[i

const besideObject = [n + 1, n + 2, n + 3];
let variable: number[] = besideObject;
function putVariable(v: any) { variable = v; }
function totalOfVariable(): number { const xs = variable; let s = 0; for (let i = 0; i < xs.length; i++) s += xs[i]; return s; }
function readBesideObject(): number { return besideObject[0] + besideObject[1] + besideObject[2]; }

const besideFunction = [n + 1, n + 2, n + 3];
let second: number[] = besideFunction;
function putSecond(v: any) { second = v; }
function totalOfSecond(): number { const xs = second; let s = 0; for (let i = 0; i < xs.length; i++) s += xs[i]; return s; }
function readBesideFunction(): number { return besideFunction[0] + besideFunction[1] + besideFunction[2]; }

const besideString = [n + 1, n + 2, n + 3];
let third: number[] = besideString;
function putThird(v: any) { third = v; }
function totalOfThird(): number { const xs = third; let s = 0; for (let i = 0; i < xs.length; i++) s += xs[i]; return s; }
function readBesideString(): number { return besideString[0] + besideString[1] + besideString[2]; }

const inField = [n + 1, n + 2, n + 3];
class Box { list: number[]; constructor(list: number[]) { this.list = list; } }
const box = new Box(inField);
function putField(v: any) { box.list = v; }
function totalOfField(): number { const xs = box.list; let s = 0; for (let i = 0; i < xs.length; i++) s += xs[i]; return s; }
function readInField(): number { return inField[0] + inField[1] + inField[2]; }

const returned = [n + 1, n + 2, n + 3];
let turn = 0;
function pick(): number[] { turn++; return turn === 20001 ? ({ length: 0 } as any) : returned; }
function totalOfResult(): number { const xs = pick(); let s = 0; for (let i = 0; i < xs.length; i++) s += xs[i]; return s; }
function readReturned(): number { return returned[0] + returned[1] + returned[2]; }

const inRow = [n + 1, n + 2, n + 3];
const rows: number[][] = [inRow, { length: 0 } as any];
function totalOfRow(k: number): number { const xs = rows[k]; let s = 0; for (let i = 0; i < xs.length; i++) s += xs[i]; return s; }
function readInRow(): number { return inRow[0] + inRow[1] + inRow[2]; }

function capture() {
  const own = [n + 1, n + 2, n + 3];
  let captured: number[] = own;
  return {
    put(v: any) { captured = v; },
    total(): number { const xs = captured; let s = 0; for (let i = 0; i < xs.length; i++) s += xs[i]; return s; },
    read(): number { return own[0] + own[1] + own[2]; },
  };
}
const closures = capture();

const totals = [0, 0, 0, 0, 0, 0, 0];
for (let k = 0; k < 20000; k++) {
  totals[0] += totalOfVariable() + readBesideObject();
  totals[1] += totalOfSecond() + readBesideFunction();
  totals[2] += totalOfThird() + readBesideString();
  totals[3] += totalOfField() + readInField();
  totals[4] += totalOfResult() + readReturned();
  totals[5] += totalOfRow(0) + readInRow();
  totals[6] += closures.total() + closures.read();
}
putVariable({ length: 0 }); totals[0] += totalOfVariable(); putVariable(besideObject);
putSecond(sum); console.log(totalOfSecond()); putSecond(besideFunction);
putThird("xy"); console.log(totalOfThird()); putThird(besideString);
putField({ length: 0 }); totals[3] += totalOfField(); putField(inField);
totals[4] += totalOfResult();
totals[5] += totalOfRow(1);
closures.put({ length: 0 }); totals[6] += closures.total();

console.log("a variable, an object: " + totals[0] + " " + besideObject[0] + " " + besideObject[1] + " " + besideObject[2] + " " + readBesideObject() + " " + totalOfVariable());
console.log("a variable, a function: " + totals[1] + " " + besideFunction[0] + " " + besideFunction[1] + " " + besideFunction[2] + " " + readBesideFunction() + " " + totalOfSecond());
console.log("a variable, a string: " + totals[2] + " " + besideString[0] + " " + besideString[1] + " " + besideString[2] + " " + readBesideString() + " " + totalOfThird());
console.log("a field: " + totals[3] + " " + inField[0] + " " + inField[1] + " " + inField[2] + " " + readInField() + " " + totalOfField());
console.log("a result: " + totals[4] + " " + returned[0] + " " + returned[1] + " " + returned[2] + " " + readReturned());
console.log("an element: " + totals[5] + " " + inRow[0] + " " + inRow[1] + " " + inRow[2] + " " + readInRow() + " " + totalOfRow(0));
console.log("a captured variable: " + totals[6] + " " + closures.read());
//// interfaces-that-extend-array-types.ts
// An interface that extends an array type describes arrays that have some more properties, as TypeScript's NodeArray<T> does. Loops, indexes, lengths, patterns, spreads and methods
// treat such a value as the array it is, and the properties beside the elements are read and stored by name. A value that only looks like one (an object written by hand, a subclass
// with an iterator of its own, an array whose own Symbol.iterator was replaced) goes through the same functions and answers as in plain Bun.
interface Range {
  pos: number
  end: number
}
interface Item {
  kind: number
  text: string
}
interface ItemList<T extends Item> extends ReadonlyArray<T>, Range {
  readonly hasTrailingComma: boolean
  flags: number
}
interface MutableItemList<T extends Item> extends Array<T>, Range {
  hasTrailingComma: boolean
  flags: number
}
interface NamedItemList extends ItemList<Item> {
  name: string
}
interface Holder {
  kind: number
  items: ItemList<Item>
  more: ItemList<Item> | undefined
}

function createList<T extends Item>(elements: readonly T[], hasTrailingComma?: boolean): ItemList<T> {
  const list = elements.slice() as MutableItemList<T>
  list.pos = -1
  list.end = -1
  list.hasTrailingComma = !!hasTrailingComma
  list.flags = 0
  for (const element of list) list.flags |= element.kind
  return list
}
function item(kind: number): Item {
  return { kind, text: "i" + kind }
}
function sumByLoop(list: ItemList<Item>): number {
  let sum = 0
  for (const element of list) sum += element.kind
  return sum
}
function sumByIndex(list: ItemList<Item>): number {
  let sum = 0
  for (let i = 0; i < list.length; i++) sum += list[i].kind
  return sum
}
function firstTwo(list: ItemList<Item>): string {
  const [first, second] = list
  return (first ? first.text : "-") + (second ? second.text : "-")
}
function spreadOf(list: ItemList<Item>): Item[] {
  return [...list, item(100)]
}
function texts(list: ItemList<Item>): string {
  return list.map(element => element.text).join()
}
function asPlainArray(list: readonly Item[]): number {
  let sum = 0
  for (const element of list) sum += element.kind * 2
  return sum
}
function rangeOf(list: Range): string {
  return list.pos + ".." + list.end
}
function describe(list: ItemList<Item>): string {
  return [
    sumByLoop(list), sumByIndex(list), firstTwo(list), spreadOf(list).length, texts(list), asPlainArray(list), rangeOf(list), list.hasTrailingComma, list.flags, list.length,
    Array.isArray(list), Object.keys(list).join(), JSON.stringify(list), "pos" in list, list.some(element => element.kind === 2), list.indexOf(list[0]),
  ].join(" | ")
}
function attempt(action: () => string): string {
  try {
    return action()
  } catch (error) {
    return (error as Error).constructor.name
  }
}

const lists: ItemList<Item>[] = []
for (let length = 0; length < 7; length++) {
  const elements: Item[] = []
  for (let i = 0; i < length; i++) elements.push(item(i + 1))
  lists.push(createList(elements, length % 2 === 1))
}
for (const list of lists) console.log(describe(list))

const holders: Holder[] = []
for (let i = 0; i < 5000; i++) holders.push({ kind: i, items: lists[i % lists.length], more: i % 3 ? undefined : createList([item(i)]) })
let total = 0
for (const holder of holders) {
  total += sumByLoop(holder.items)
  if (holder.more) for (const element of holder.more) total += element.kind
}
console.log(total)

const named = createList([item(7), item(8)]) as unknown as NamedItemList & { name: string }
named.name = "named"
console.log(describe(named), named.name)

const mutable = createList([item(1)]) as unknown as MutableItemList<Item>
mutable.push(item(2), item(3))
mutable.pos = 5
mutable.end = 9
mutable.length = 2
console.log(describe(mutable))
let seen = ""
for (const element of mutable) {
  seen += element.text
  if (mutable.length < 5) mutable.push(item(mutable.length + 10))
}
console.log(seen, mutable.length)

const byHand = {
  0: item(1), 1: item(2), length: 2, pos: 3, end: 4, hasTrailingComma: false, flags: 3,
  *[Symbol.iterator]() { yield item(40); yield item(41) },
  map(callback: (element: Item) => string) { return [callback(item(50))] },
  some() { return false },
  indexOf() { return -7 },
} as unknown as ItemList<Item>
console.log(attempt(() => describe(byHand)))

class Reversed<T> extends Array<T> {
  *[Symbol.iterator](): ArrayIterator<T> {
    for (let i = this.length - 1; i >= 0; i--) yield this[i]
  }
}
const reversed = Reversed.from([item(1), item(2), item(3)]) as unknown as MutableItemList<Item>
reversed.pos = 0
reversed.end = 1
reversed.hasTrailingComma = true
reversed.flags = 0
console.log(attempt(() => describe(reversed)))

