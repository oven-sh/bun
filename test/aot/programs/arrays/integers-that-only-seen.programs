//// maps-and-sets-from-every-maker-are-walked.ts
// Compiled code reads the table of a Map or a Set without asking what kind of storage it is: in an executable every Map and every Set has the compiled kind, whoever made it. Here each maker there is makes one (the constructors over every kind of source, copies, the Set methods, groupBy, structuredClone, the deserializer, a message channel's clone, subclasses, another realm, host objects that hand out Maps), and each is walked, asked and changed by fast code and by cold code
import { deserialize, serialize } from "node:v8";
import { runInNewContext } from "node:vm";

const opaque = <T>(value: T): T => Reflect.get({ value }, ["val", "ue"].join("")) as T;
const lines: string[] = [];
const show = (value: unknown): string => (typeof value === "object" && value !== null ? JSON.stringify(value) : String(value));

function walkMap(map: Map<unknown, unknown>): string {
  let text = "";
  for (const [key, value] of map) text += show(key) + ">" + show(value) + ";";
  return text;
}
function walkSet(set: Set<unknown>): string {
  let text = "";
  for (const key of set) text += show(key) + ";";
  return text;
}
function walkByMethods(collection: Map<unknown, unknown> | Set<unknown>): string {
  let text = "";
  collection.forEach((value: unknown, key: unknown) => { text += show(key) + "=" + show(value) + ","; });
  text += "|" + [...collection.keys()].map(show).join() + "|" + [...collection.values()].map(show).join() + "|" + Array.from(collection.entries(), pair => pair.map(show).join(":")).join();
  const iterator = collection[Symbol.iterator]();
  for (let step = iterator.next(); !step.done; step = iterator.next()) text += "/" + show(step.value);
  return text;
}
function lookAtMap(title: string, map: Map<unknown, unknown>): void {
  const keys = [...map.keys()];
  let text = title + " size " + map.size + " by value " + Reflect.get(map, "size") + ": " + walkMap(map) + " " + walkByMethods(map);
  for (const key of keys) text += " " + map.has(key) + show(map.get(key));
  text += " " + map.has("absent") + show(map.get("absent"));
  // Entries come and go under a walk that is under way.
  let steps = 0;
  for (const [key] of map) {
    if (steps === 0) { map.set("added " + title, steps); map.delete(keys[keys.length - 1]); }
    if (++steps > 50) break;
    text += "~" + show(key);
  }
  map.set(1.5, "wide"); map.set("text", { a: 1 });
  text += " then " + map.size + ": " + walkMap(map);
  map.clear();
  text += " cleared " + map.size + walkMap(map);
  map.set("again", 1);
  lines.push(text + " " + walkMap(map));
}
function lookAtSet(title: string, set: Set<unknown>): void {
  const keys = [...set];
  let text = title + " size " + set.size + " by value " + Reflect.get(set, "size") + ": " + walkSet(set) + " " + walkByMethods(set);
  for (const key of keys) text += " " + set.has(key);
  text += " " + set.has("absent");
  let steps = 0;
  for (const key of set) {
    if (steps === 0) { set.add("added " + title); set.delete(keys[keys.length - 1]); }
    if (++steps > 50) break;
    text += "~" + show(key);
  }
  set.add(1.5); set.add("text");
  text += " then " + set.size + ": " + walkSet(set);
  set.clear();
  text += " cleared " + set.size + walkSet(set);
  set.add("again");
  lines.push(text + " " + walkSet(set));
}

const pairs: [unknown, unknown][] = [["a", 1], ["b", { x: 2 }], [3, "three"], [null, undefined], [true, 4.5]];
const items: unknown[] = ["a", "b", 3, null, true, 4.5, undefined];
function* generated<T>(list: T[]): Generator<T> { for (const item of list) yield item; }
class OwnMap<K, V> extends Map<K, V> { tag = "own"; }
class OwnSet<T> extends Set<T> { tag = "own"; }
const source = new Map(pairs), sourceSet = new Set(items);

const maps: Record<string, () => Map<unknown, unknown>> = {
  empty: () => new Map(),
  "of null": () => new Map(null),
  "of an array": () => new Map(pairs),
  "of a generator": () => new Map(generated(pairs)),
  "of a map": () => new Map(source),
  "of an empty map": () => new Map(new Map()),
  "of entries": () => new Map(source.entries()),
  "of object entries": () => new Map<unknown, unknown>(Object.entries({ p: 1, q: "two" })),
  "by value": () => new (opaque(Map))(pairs),
  "by Reflect": () => Reflect.construct(Map, [pairs]),
  "by Reflect for a subclass": () => Reflect.construct(Map, [pairs], OwnMap),
  subclass: () => new OwnMap(pairs),
  "copy of a subclass": () => new Map(new OwnMap(pairs)),
  groupBy: () => Map.groupBy([1, 2, 3, 4, 5], n => (n % 2 ? "odd" : "even")),
  structuredClone: () => structuredClone(source),
  "structuredClone of an empty one": () => structuredClone(new Map()),
  "inside a clone": () => (structuredClone({ inner: [source] }) as { inner: Map<unknown, unknown>[] }).inner[0],
  deserialized: () => deserialize(serialize(source)),
  "another realm": () => runInNewContext("new Map([['a', 1], [2, 'b']])"),
  "another realm's constructor": () => new (runInNewContext("Map"))(pairs),
  "search parameters": () => new Map(new URLSearchParams("a=1&b=2&a=3")),
  headers: () => new Map(new Headers({ "x-a": "1", "x-b": "2" })),
  "form data": () => { const form = new FormData(); form.append("f", "1"); form.append("g", "2"); return new Map(form as unknown as Iterable<[unknown, unknown]>); },
  "filled by getOrInsert": () => { const map = new Map<unknown, unknown>(); const any = map as any; if (typeof any.getOrInsert === "function") { any.getOrInsert("a", 1); any.getOrInsertComputed("b", () => 2); } else { map.set("a", 1); map.set("b", 2); } return map; },
};
const sets: Record<string, () => Set<unknown>> = {
  empty: () => new Set(),
  "of undefined": () => new Set(undefined),
  "of an array": () => new Set(items),
  "of numbers": () => new Set([1, 2, 3, 4.5]),
  "of a string": () => new Set("hello"),
  "of a generator": () => new Set(generated(items)),
  "of a set": () => new Set(sourceSet),
  "of an empty set": () => new Set(new Set()),
  "of keys of a map": () => new Set(source.keys()),
  "by value": () => new (opaque(Set))(items),
  "by Reflect": () => Reflect.construct(Set, [items]),
  subclass: () => new OwnSet(items),
  "copy of a subclass": () => new Set(new OwnSet(items)),
  union: () => sourceSet.union(new Set(["z", 9])),
  "union with a map": () => sourceSet.union(source),
  intersection: () => sourceSet.intersection(new Set(["a", 3, "z"])),
  difference: () => sourceSet.difference(new Set(["a", 3, "z"])),
  symmetricDifference: () => sourceSet.symmetricDifference(new Set(["a", 3, "z"])),
  "union of empty ones": () => new Set().union(new Set()),
  structuredClone: () => structuredClone(sourceSet),
  deserialized: () => deserialize(serialize(sourceSet)),
  "another realm": () => runInNewContext("new Set(['a', 1, 2.5])"),
  "typed array": () => new Set(new Uint8Array([1, 2, 2, 3])),
};
for (let round = 0; round < 3; round++) {
  for (const title in maps) lookAtMap(title, maps[title]());
  for (const title in sets) lookAtSet(title, sets[title]());
}
lines.push(String(sourceSet.isSubsetOf(sourceSet.union(new Set([0])))) + sourceSet.isSupersetOf(new Set(["a"])) + sourceSet.isDisjointFrom(new Set(["q"])));

// A clone that came through a message channel.
const channel = new MessageChannel();
const received = new Promise<{ map: Map<unknown, unknown>; set: Set<unknown> }>(resolve => { channel.port2.onmessage = event => resolve(event.data); });
channel.port1.postMessage({ map: source, set: sourceSet });
const message = await received;
channel.port1.close(); channel.port2.close();
lookAtMap("received", message.map);
lookAtSet("received", message.set);

const makers = Object.keys(maps).length + Object.keys(sets).length;
console.log(lines.length, makers);
console.log(lines.slice(0, makers).join("\n"));
console.log(lines.slice(-3).join("\n"));
console.log(lines.slice(0, makers).join() === lines.slice(makers, 2 * makers).join(), lines.slice(makers, 2 * makers).join() === lines.slice(2 * makers, 3 * makers).join());
//// methods-on-odd-arrays.ts
// Array methods that take a callback, over arrays that are sparse, inherit elements, or stop being ordinary arrays while the callback runs.
type A = any[];
const makers: [string, () => A][] = [
  ["plain", () => [1, 2, 3, 4]],
  ["doubles", () => [1.5, 2.5, 3.5, 4.5]],
  ["objects", () => ["a", "b", "c", "d"]],
  ["holes", () => [1, , 3, , 5]],
  ["onlyHoles", () => new Array(4)],
  ["sparse", () => { const a: A = [1, 2]; a[100000] = 3; a.length = 6; a[5] = 9; return a; }],
  ["inherited", () => { const a: A = [1, , 3]; Object.setPrototypeOf(a, Object.assign(Object.create(Array.prototype), { 1: "proto" })); return a; }],
  ["empty", () => []],
];
const spoilers: [string, (a: A, k: number) => void][] = [
  ["none", () => {}],
  ["push", (a, k) => { if (k === 1) a.push("pushed"); }],
  ["shrink", (a, k) => { if (k === 1) a.length = 2; }],
  ["toObjects", (a, k) => { if (k === 0) a[2] = { o: 1 }; }],
  ["toDoubles", (a, k) => { if (k === 0) a[2] = 0.25; }],
  ["punch", (a, k) => { if (k === 0) delete a[2]; }],
  ["far", (a, k) => { if (k === 1) a[50000] = "far"; }],
];
const show = (v: unknown): string => { try { return JSON.stringify(v) ?? String(v); } catch { return "?"; } };
function each(a: A, spoil: (a: A, k: number) => void): string {
  const seen: string[] = [];
  const note = (x: unknown, k: number) => { seen.push(k + ":" + show(x)); spoil(a, k); };
  const copy = () => a.slice();
  const out: string[] = [];
  const run = (name: string, f: (b: A) => unknown) => {
    const saved = copy(); seen.length = 0;
    let r: unknown; try { r = f(a); } catch (e) { r = "threw " + (e as Error).message; }
    out.push(name + "=" + show(r) + "[" + seen.join() + "]");
    a.length = 0; for (let i = 0; i < saved.length; i++) if (i in saved) a[i] = saved[i]; a.length = saved.length;
  };
  run("forEach", b => b.forEach((x, k) => note(x, k)));
  run("map", b => b.map((x, k) => { note(x, k); return [x]; }));
  run("filter", b => b.filter((x, k) => { note(x, k); return k !== 1; }));
  run("some", b => b.some((x, k) => { note(x, k); return k === 3; }));
  run("every", b => b.every((x, k) => { note(x, k); return k !== 3; }));
  run("find", b => b.find((x, k) => { note(x, k); return k === 3; }));
  run("findLast", b => b.findLast((x, k) => { note(x, k); return k === 0; }));
  run("findIndex", b => b.findIndex((x, k) => { note(x, k); return k === 3; }));
  run("findLastIndex", b => b.findLastIndex((x, k) => { note(x, k); return k === 0; }));
  run("reduce", b => b.reduce((s, x, k) => { note(x, k); return s + "," + show(x); }, "s"));
  run("reduce0", b => b.reduce((s, x, k) => { note(x, k); return s + "," + show(x); }));
  run("reduceN", b => b.reduce((s, x, k) => { note(x, k); return typeof x === "number" ? s + x : s; }, 0));
  run("reduceRight", b => b.reduceRight((s, x, k) => { note(x, k); return s + "," + show(x); }, "s"));
  run("reduceRight0", b => b.reduceRight((s, x, k) => { note(x, k); return s + "," + show(x); }));
  run("flatMap", b => b.flatMap((x, k) => { note(x, k); return k % 2 ? [x, [k]] : x; }));
  return out.join(" ");
}
for (let round = 0; round < 3; round++) {
  for (const [m, make] of makers) for (const [s, spoil] of spoilers) {
    const line = each(make(), spoil);
    if (round === 2) console.log(m, s, line);
  }
}
function thrower(a: A): string {
  try { a.map((x, k) => { if (k === 2) throw new Error("at " + k); return x; }); return "none"; }
  catch (e) { const stack = (e as Error).stack ?? ""; return (e as Error).message + " " + (stack.indexOf("map") < stack.indexOf("thrower")); }
}
console.log(thrower([1, 2, 3]), "|", thrower([1, , 3]), "|", thrower((() => { const a: A = [1, 2, 3]; a[90000] = 1; return a; })()));
//// mutated-arrays-passed-to-runtime.ts
// An array with an accessor for an element, with an own property that hides a built-in method, or with another prototype is still an array to the functions of the runtime that take one.
import { closeSync, openSync, readFileSync, readvSync, rmSync, writevSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

const file = join(tmpdir(), `arrays-handed-to-the-runtime-${process.pid}.bin`);
const first = new Uint8Array(4).fill(0x41);
const second = new Uint8Array(2).fill(0x42);
const row = (name: string, f: () => unknown) => {
  let r: unknown;
  try {
    r = f();
  } catch (e) {
    r = "THROWS " + (e as Error).message;
  }
  console.log(name + ": " + JSON.stringify(r));
};
function withAccessor<T>(head: T, tail: T): T[] {
  const array: T[] = [head];
  Object.defineProperty(array, 1, { enumerable: true, configurable: true, get: () => tail });
  return array;
}
function withOwnMethod<T>(...items: T[]): T[] {
  const array: T[] = [...items];
  Object.defineProperty(array, "push", { value: () => 0, configurable: true, writable: true });
  return array;
}
function withOtherPrototype<T>(...items: T[]): T[] {
  const array: T[] = [...items];
  Object.setPrototypeOf(array, Object.create(Array.prototype));
  return array;
}
function written(buffers: Uint8Array[]) {
  const fd = openSync(file, "w");
  try {
    return [writevSync(fd, buffers), readFileSync(file, "latin1")];
  } finally {
    closeSync(fd);
  }
}
function read(buffers: Uint8Array[]) {
  const fd = openSync(file, "r");
  try {
    return [readvSync(fd, buffers), buffers.length];
  } finally {
    closeSync(fd);
  }
}
row("writevSync, as made", () => written([first, second]));
row("writevSync, an accessor", () => written(withAccessor(first, second)));
row("writevSync, an own method", () => written(withOwnMethod(first, second)));
row("writevSync, another prototype", () => written(withOtherPrototype(first, second)));
row("readvSync, an accessor", () => read(withAccessor(new Uint8Array(4), new Uint8Array(2))));
row("readvSync, an own method", () => read(withOwnMethod(new Uint8Array(4), new Uint8Array(2))));
row("Buffer.concat, an accessor", () => Buffer.concat(withAccessor(first, second)).toString("latin1"));
row("Buffer.from, an own method", () => Buffer.from(withOwnMethod(65, 66)).toString("latin1"));
row("Buffer.from, an accessor", () => Buffer.from(withAccessor(65, 66)).toString("latin1"));
row("emitWarning, an own method", () => process.emitWarning("w", withOwnMethod("a") as any));
row("emitWarning, as made", () => process.emitWarning("w", ["a"] as any));
row("Blob, an accessor", () => new Blob(withAccessor("a", "b")).size);
row("Blob, an own method", () => new Blob(withOwnMethod("a", "b")).size);
row("tls, as made", () => Bun.listen({ hostname: "127.0.0.1", port: 0, socket: { data() {} }, tls: { ca: ["x"] } }).stop());
row("tls, an own method", () => Bun.listen({ hostname: "127.0.0.1", port: 0, socket: { data() {} }, tls: { ca: withOwnMethod("x") } }).stop());
row("tls, an accessor", () => Bun.listen({ hostname: "127.0.0.1", port: 0, socket: { data() {} }, tls: { ca: withAccessor("x", "y") } }).stop());
row("spawnSync, an own method", () => Bun.spawnSync(withOwnMethod("/bin/echo", "said")).stdout.toString());
row("spawnSync, an accessor", () => Bun.spawnSync(withAccessor("/bin/echo", "said")).stdout.toString());
row("structuredClone, an own method", () => structuredClone(withOtherPrototype(1, 2)));
row("inspect", () => [Bun.inspect(withOwnMethod(1, 2)), Bun.inspect(withOtherPrototype(1, 2)), Bun.inspect(withAccessor(1, 2))]);
row("deepEquals", () => [Bun.deepEquals(withOtherPrototype(1, 2), [1, 2]), Bun.deepEquals(withAccessor(1, 2), [1, 2])]);
row("JSON", () => [withOwnMethod(1, 2), withOtherPrototype(1, 2), withAccessor(1, 2)]);
rmSync(file, { force: true });
//// named-properties.ts
// Arrays that get a handful of named properties right after they are made, as a syntax tree's node lists do.
interface NodeArray<T> extends Array<T> { pos: number; end: number; hasTrailingComma: boolean; transformFlags: number }
interface Tagged<T> extends Array<T> { owner: object | undefined; label: string }
const host = globalThis as any
const collect: () => void = host.Bun ? () => host.Bun.gc(true) : host.gc
function createNodeArray<T>(elements: T[], hasTrailingComma?: boolean): NodeArray<T> {
  const array = (elements.length >= 1 && elements.length <= 4 ? elements.slice() : elements) as NodeArray<T>
  array.pos = -1
  array.end = -1
  array.hasTrailingComma = !!hasTrailingComma
  array.transformFlags = 0
  return array
}
function tag<T>(elements: T[], owner: object | undefined, label: string): Tagged<T> {
  const array = elements as Tagged<T>
  array.owner = owner
  array.label = label
  return array
}
const show = (what: string, array: any[]) => console.log(what, array.length, JSON.stringify(array), Object.keys(array).join(), JSON.stringify(Object.entries(array).filter(([key]) => isNaN(Number(key)))))
show("empty", createNodeArray([]))
show("numbers", createNodeArray([1, 2, 3], true))
show("doubles", createNodeArray([1.5, 2.5]))
show("strings", createNodeArray(["a", "b", "c", "d", "e"]))
show("mixed", createNodeArray([1, "a", null, undefined, {}, [1]]))
show("holes", createNodeArray([1, , 3] as number[]))
show("long", createNodeArray(Array.from({ length: 40 }, (_, i) => i)))
// They are still arrays.
const list = createNodeArray<number>([])
for (let i = 0; i < 100; i++) list.push(i * i)
list.pos = 5; list.end += 10; list.transformFlags |= 6
console.log(list.length, list[99], list.pos, list.end, list.hasTrailingComma, list.transformFlags, Array.isArray(list), list.slice(0, 2).join(), (list.slice(0, 2) as any).pos, list.map(x => x)[3], list.indexOf(81), list.pop(), list.length)
list.length = 2
console.log(JSON.stringify(list), list.pos, Object.keys(list).join())
// Many of them, of every size, kept over collections.
const kept: NodeArray<number | string>[] = []
let sum = 0
for (let i = 0; i < 60000; i++) {
  const elements: (number | string)[] = []
  for (let j = 0; j < i % 9; j++) elements.push(j % 2 ? "s" + j : i + j)
  const array = createNodeArray(elements, i % 2 === 0)
  array.end = i
  sum += array.length + array.pos + array.transformFlags + (array.hasTrailingComma ? 1 : 0)
  if (i % 3000 === 0) kept.push(array)
  if (i % 25000 === 24999) collect()
}
collect()
console.log(sum, kept.map(array => array.length + ":" + array.end + ":" + array.join("")).join(" "))
// Values that are cells, stored into arrays that have grown old.
const old: number[][] = []
for (let i = 0; i < 3000; i++) old.push([i, i + 1, i + 2, i + 3, i + 4])
collect()
const tagged = old.map((elements, i) => tag(elements, i % 3 ? { id: i } : undefined, "label" + i))
collect()
let ids = 0
for (const array of tagged) ids += ((array.owner as { id: number } | undefined)?.id ?? 1) + array.label.length + array[4]
console.log(ids)
// Arrays that are not as they were made.
const frozen = Object.freeze([1, 2])
try { createNodeArray([...frozen, 3, 4, 5].slice(0, 5)); tag(frozen as number[], undefined, "x"); console.log("stored") } catch (error) { console.log((error as Error).constructor.name) }
const already = [1, 2, 3, 4, 5] as NodeArray<number>
already.end = 7
show("already", createNodeArray(already))
const other = [1, 2, 3, 4, 5] as any
other.first = "first"
show("other", createNodeArray(other))
class List<T> extends Array<T> { extra = "own" }
const derived = new List<number>()
derived.push(1, 2, 3, 4, 5)
show("derived", createNodeArray(derived))
console.log(derived instanceof List, (derived as any).pos)
//// named-properties-added-together.js
// Several named properties stored to a fresh array one after the other are added by one structure transition. The array ends up as it would store by store.
"use strict";
const collect = typeof gc === "function" ? gc : () => Bun.gc(true);
const show = (label, array) => console.log(label + ":", array.length, JSON.stringify(array), "keys", Object.keys(array).join(), "values", Object.keys(array).map(key => String(array[key])).join("|"));
function attempt(label, make) {
  try {
    let array;
    for (let i = 1; i <= 3; i++) array = make(i);
    show(label, array);
  } catch (error) {
    console.log(label + ":", error.name + ": " + error.message);
  }
}

function markInt32(i, input, groups) {
  const array = [i, i + 1, i + 2];
  array.index = i;
  array.input = input;
  array.groups = groups;
  return array;
}
////= lines-70	markDouble	[i + 0.5, i + 1.5]
////= lines-70	markObjects	[{ i }, "text", i]
function markEmpty(i, input, groups) {
  const array = [];
  array.index = i;
  array.input = input;
  array.groups = groups;
  return array;
}
////= lines-70	markHoles	new Array(3)
show("int32", markInt32(1, "a", undefined));
show("double", markDouble(1, "b", null));
show("objects", markObjects(1, "c", "named"));
show("empty", markEmpty(1, "d", 4));
show("holes", markHoles(1, "e", 5));

const survivors = [];
let checksum = 0;
for (let i = 0; i < 20000; i++) {
  const int32 = markInt32(i, "int32", undefined);
  const double = markDouble(i, "double", null);
  const objects = markObjects(i, "objects", { name: i });
  const empty = markEmpty(i, "empty", i);
  const holes = markHoles(i, "holes", i);
  checksum += int32.index + int32[2] + int32.input.length + double.index + double[1] + objects[0].i + objects.groups.name + empty.length + empty.groups + holes.length + holes.index;
  if (i % 5000 === 0) survivors.push(int32, double, objects, empty, holes);
  if (i % 7000 === 6999) collect();
}
collect();
console.log("20000 of each:", checksum);
for (const array of survivors) {
  array.push(1.5, "pushed");
  array.later = array.index + 1;
  show("survivor", array);
}

