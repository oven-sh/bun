  const first = count(c);
  const second = c.reduce((t, v) => t + (v > 1 ? v : 0), 0);
  return first + "," + second;
}
let out = "";
let last = "";
for (let turn = 0; turn < 60; turn++) {
  out = "";
  for (const list of [[3.5, 0.5, 1.5, 6.5], put(), [4.5, 7.5, 0.5, 8.5], [0.25, 0.75, 1.25, 1.75]]) out += look(list) + "; ";
  if (turn && out !== last) console.log("changed in turn", turn, out);
  last = out;
