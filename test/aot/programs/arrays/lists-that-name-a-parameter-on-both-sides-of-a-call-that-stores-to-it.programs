//// a-list-names-a-parameter-on-both-sides-of-a-call-that-stores-an-int32-to-it-and-a-closure-keeps-it.js
const f = (n) => { const a = [n, (() => n >>>= 0)(), n]; return () => a; };
const g = f(1.5);
for (const e of g()) console.log(e);
console.log(g().indexOf(1), g().includes(1.5), g().reduce((x, y) => x + y, 0));
//// a-list-names-a-parameter-on-both-sides-of-a-call-that-stores-an-int32-to-it-and-a-for-of-loop-walks-it.js
const f = (n) => { for (const e of [n, (() => n |= 0)(), n]) console.log(e); };
f(1.5);
//// a-list-names-a-parameter-on-both-sides-of-a-call-that-stores-an-int32-to-it-and-a-pattern-takes-it-apart.js
const f = (n) => { const [x, y, z] = [n, (() => n >>= 1)(), n]; console.log(x, y, z); };
f(5.5);
//// a-list-names-a-parameter-on-both-sides-of-a-call-that-stores-an-int32-to-it-and-is-changed-afterwards.js
const f = (n) => { const a = [n, (() => n |= 0)(), n]; a.push(n + 0.5); a[1] = 0.25; a.length = 3; a.reverse(); a.sort(); console.log(a.join()); for (const e of a) console.log(e); };
f(1.5);
//// a-list-names-a-parameter-on-both-sides-of-a-call-that-stores-an-int32-to-it-and-is-handed-to-a-function.js
const show = (a) => { let t = 0; for (let i = 0; i < a.length; i++) t += a[i]; console.log(t, a[0], a[2]); };
const f = (n) => { show([n, (function () { return n ^= 1; })(), n]); };
f(3.75);
//// a-list-names-a-parameter-on-both-sides-of-a-call-that-stores-an-int32-to-it-and-is-kept-in-a-field.js
class Holder { constructor(n) { this.list = [n, (() => n &= 7)(), n]; } sum() { let t = 0; for (const e of this.list) t += e; return t; } }
const h = new Holder(9.5);
console.log(h.sum(), h.list[0], h.list[1], h.list[2]);
//// a-list-names-a-parameter-on-both-sides-of-a-call-that-stores-an-int32-to-it-and-is-kept-in-a-variable-of-the-module.js
let kept;
const f = (n) => { kept = [n, ({ m() { return n <<= 1; } }).m(), n]; };
f(2.5);
for (const e of kept) console.log(e);
console.log(kept.map((e) => e * 2).join());
//// a-list-names-a-parameter-on-both-sides-of-a-call-that-stores-an-int32-to-it-and-is-read-by-index.js
const f = (n) => { const a = [n, (() => n |= 0)(), n]; console.log(a[0], a[1], a[2], a.length); };
f(1.5);
//// a-list-names-a-parameter-on-both-sides-of-a-call-that-stores-an-int32-to-it-and-is-returned.js
const f = (n) => [n, (() => n |= 0)(), n];
const r = f(1.5);
for (const e of r) console.log(e);
console.log(r[0] + r[1] + r[2]);
//// a-list-names-a-parameter-on-both-sides-of-an-awaited-call-that-stores-an-int32-to-it.mjs
const f = async (n) => { const store = async () => n |= 0; const a = [n, await store(), n]; for (const e of a) console.log(e); };
await f(1.5);
//// a-list-with-a-hole-names-a-parameter-on-both-sides-of-a-call-that-stores-an-int32-to-it.js
const f = (n) => { const a = [n, (() => n |= 0)(), n, , n]; console.log(a.length, a[0], a[1], a[2], a[3], a[4]); for (const e of a) console.log(e); };
f(1.5);
//// lists-name-a-parameter-that-a-call-stores-an-int32-to-and-each-gets-another-kind-of-value.js
