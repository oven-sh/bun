    ["a literal of anything, twice", () => { const make = (): unknown[] => [7, 8, 9]; const first = make() as number[]; sum(first); first[0] = 0.5; return make() as number[]; }],
    ["Array.from", () => Array.from([4, 3, 2, 1] as unknown[]) as number[]],
