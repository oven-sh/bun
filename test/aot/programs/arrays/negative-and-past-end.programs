//// no-cells-for-arrays-that-carry-arguments.js
// 10,000 rounds of calls that hand over an array which is made for the call alone and which the callee only reads: a literal, a literal that the callee hands on, the surplus arguments of a function that uses `arguments`,
// and the rest array of a function that is called through a value. One call in each round keeps its array. Each function calls itself, so that it is not taken into its caller.
// object-census.test.ts runs it without collections, so that the census at exit counts every array that was made. The output is that of plain Bun.
let sum = 0;
const kept = [];

function total(list, depth) {
  if (depth > 0) return total(list, depth - 1);
  let result = list.length;
  for (let i = 0; i < list.length; i++) result += list[i].n;
  return result;
}

function keeps(list, depth) {
  if (depth > 0) return keeps(list, depth - 1);
  kept.push(list);
  return list.length;
}

function counts(a, depth) {
  // No tail call: the frame that the surplus arguments lie in has to be there while the callee runs.
  if (depth > 0) return counts(a, depth - 1, arguments[2], arguments[3], arguments[4]) + 0;
  return arguments.length + arguments[2].n + arguments[4].n;
}

const table = {
  rest(depth, ...values) {
    let result = values.length;
    for (let i = 0; i < values.length; i++) result += values[i].n;
    return result;
  },
};
const names = ["rest"];

for (let i = 0; i < 10000; i++) {
  const a = { n: i };
  const b = { n: 1 };
  sum += total([a, b, a], 1) + keeps([a, b, a, b], 1) + counts(a, 1, a, b, a) + table[names[i % names.length]](0, a, b, a, b, a);
}
console.log(sum, kept.length, kept[9999][0].n);
//// no-list-for-calls-without-surplus-arguments.js
// 20,000 calls by name of a function that hands its `arguments` to native code, none of them with a surplus argument. The function calls itself, so that it is not taken into its caller.
// object-census.test.ts runs it without collections, so that the census at exit counts every array that was made, and looks for empty ones. The output is that of plain Bun.
let sum = 0;
const seen = new Set();

function look(a, depth) {
  if (depth > 0) return look(a + 1, depth - 1);
  seen.add(Object.keys(arguments).length);
  sum += arguments.length + a;
}

for (let i = 0; i < 10000; i++) look(i, 1);
console.log(sum, [...seen].join());
//// no-list-for-rest-arrays-that-are-passed-on.js
// 10,000 rounds of a function that is called through a value and passes its rest array on behind two values, `f(a, b, ...rest)`, to a function that takes two values by name and the others in a rest parameter.
// `reads` only reads its rest array; `keeps` keeps it, so one array a call has to be a cell, and no more than one.
// object-census.test.ts runs it without collections, so that the census at exit counts every array and every closure that was made. The output is that of plain Bun.
let sum = 0;
const kept = [];

function reads(a, b, ...rest) {
  let result = a.n + b.n + rest.length;
  for (let i = 0; i < rest.length; i++) result += rest[i].n;
  return result;
}

function keeps(a, b, ...rest) {
  kept.push(rest);
  return a.n + b.n + rest.length;
}

const table = {
  passesOnToReader(...args) {
    return reads(args.length ? one : two, two, ...args);
  },
  passesOnToKeeper(...args) {
    return keeps(one, two, ...args);
  },
};
const one = { n: 1 };
const two = { n: 2 };
const names = ["passesOnToReader", "passesOnToKeeper"];

for (let i = 0; i < 10000; i++) {
  const a = { n: i };
  sum += table[names[i % 1]](a, one, a) + table[names[1 - (i % 1)]](a, one, a, two);
}
console.log(sum, kept.length, kept[9999].length, kept[9999][0].n, new Set(kept).size);
