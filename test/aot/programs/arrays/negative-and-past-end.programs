for (let turn = 0; turn < 2; turn++) {
    for (const [name, make] of makers) {
        console.log(name + ", turn " + turn);
        tell("sum", () => { const a = make(); return sum(a) + " " + show(a); });
        tell("sumOf", () => { const a = make(); return sumOf(a) + " " + show(a); });
        tell("sumDown", () => { const a = make(); return sumDown(a) + " " + show(a); });
        tell("largest", () => { const a = make(); return largest(a) + " " + show(a); });
        tell("find", () => { const a = make(); return find(a, 3) + " " + find(a, 2.5) + " " + find(a, -7) + " " + show(a); });
        tell("absent", () => { const a = make(); return absent(a) + " " + show(a); });
        tell("fill whole", () => { const a = make(); return fill(a, 7) + " " + show(a); });
        tell("fill half", () => { const a = make(); return fill(a, 0.5) + " " + show(a); });
        tell("fill NaN", () => { const a = make(); return fill(a, NaN) + " " + show(a); });
        tell("fill -0", () => { const a = make(); return fill(a, -0) + " " + show(a); });
        tell("fillIndex", () => { const a = make(); return fillIndex(a) + " " + show(a); });
        tell("fillZero", () => { const a = make(); return fillZero(a) + " " + show(a); });
        tell("copy", () => { const a = make(), b = make(); fill(b, 0); return copy(a, b) + " " + show(a) + " " + show(b); });
        tell("copy onto itself", () => { const a = make(); return copy(a, a) + " " + show(a); });
        tell("copy into doubles", () => { const a = make(), b = [0.5, 0.5]; return copy(a, b) + " " + show(b); });
        tell("copy from doubles", () => { const a = [0.5, 1.5], b = make(); return copy(a, b) + " " + show(b); });
        tell("scale", () => { const a = make(); return scale(a, 2) + " " + show(a); });
        tell("scale by a half", () => { const a = make(); return scale(a, 0.5) + " " + show(a); });
        tell("bump", () => { const a = make(); return bump(a) + " " + show(a); });
        tell("dot", () => { const a = make(), b = make(); return dot(a, b) + " " + dot(a, a) + " " + show(a); });
        tell("gather", () => { const a = JSON.parse("[0,1,0,1]") as number[], b = make(); return gather(a, b) + " " + show(a) + " " + show(b); });
        tell("bits", () => { const a = make(); return bits(a) + " " + show(a); });
        tell("append", () => { const a = make(); return append(a, 20, 1) + " " + show(a); });
        tell("append halves", () => { const a = make(); return append(a, 3, 0.5) + " " + show(a); });
        tell("pushAll", () => { const a = make(); return pushAll(a, 20, 1) + " " + show(a); });
        tell("pushAll halves", () => { const a = make(); return pushAll(a, 3, 0.5) + " " + show(a); });
        tell("one", () => { const a = make(); return one(a, 0) + " " + one(a, 1) + " " + one(a, 99) + " " + one(a, -1) + " " + show(a); });
        tell("put", () => { const a = make(); put(a, 0, 11); put(a, 1, 1.5); put(a, 9, 3); return show(a); });
        tell("nested", () => { const a = make(), b = make(); return nested(a, b) + " " + nested(a, a) + " " + show(a); });
        tell("rows", () => { const m = [make(), make(), [0.5], make()]; return rows(m) + " " + show(m[0]) + " " + show(m[3]); });
        tell("storeSumStore", () => { const a = make(); return storeSumStore(a) + " " + show(a); });
        tell("readSumRead", () => { const a = make(); return readSumRead(a) + " " + show(a); });
        tell("throughTwoViews", () => { const a = make(); return throughTwoViews(a, a) + " " + show(a); });
        tell("pushSumPush", () => { const a = make(); return pushSumPush(a, a) + " " + show(a); });
        tell("storeInLoopAroundSum", () => { const a = make(); return storeInLoopAroundSum(a) + " " + show(a); });
        tell("sumTwice", () => { const a = make(); return sumTwice(a) + " " + show(a); });
        tell("sumThenStoreWhole", () => { const a = make(); return sumThenStoreWhole(a, 40) + " " + show(a); });
        tell("storeCallStore", () => { const a = make(); return storeCallStore(a) + " " + show(a); });
        tell("storeCallStoreTwice", () => { const a = make(); return storeCallStoreTwice(a) + " " + show(a); });
        tell("readCallRead", () => { const a = make(); return readCallRead(a) + " " + show(a); });
        tell("storeCallThroughAnother", () => { const a = make(); return storeCallThroughAnother(a) + " " + show(a); });
        tell("viewsAroundCall", () => { const a = make(); return viewsAroundCall(a, a) + " " + show(a); });
        tell("pushAroundCall", () => { const a = make(); return pushAroundCall(a, a) + " " + show(a); });
        tell("storesInLoopAroundCall", () => { const a = make(); return storesInLoopAroundCall(a) + " " + show(a); });
        tell("wholeStoresInLoopAroundCall", () => { const a = make(); return wholeStoresInLoopAroundCall(a, 4) + " " + show(a); });
        tell("readCallStore", () => { const a = make(); return readCallStore(a) + " " + show(a); });
        tell("readCallPush", () => { const a = make(); return readCallPush(a) + " " + show(a); });
        tell("readCallFillZero", () => { const a = make(); return readCallFillZero(a) + " " + show(a); });
        tell("readCallStoreThroughAnother", () => { const a = make(); return readCallStoreThroughAnother(a) + " " + show(a); });
        tell("rowsAroundCall", () => { const rows = [make(), make(), make()]; return rowsAroundCall(rows) + " " + show(rows[0]) + show(rows[2]); });
        tell("rowsAroundCallThroughAnother", () => { const rows = [make(), make()]; return rowsAroundCallThroughAnother(rows) + " " + show(rows[1]); });
        tell("rowsLargestAroundCall", () => { const rows = [make(), make()]; return rowsLargestAroundCall(rows) + " " + show(rows[0]); });
        tell("rowsAroundLongCall", () => { const rows = [make(), make(), make()]; return rowsAroundLongCall(rows) + " " + show(rows[0]) + show(rows[2]); });
        tell("rowsLargestAroundLongCall", () => { const rows = [make(), make()]; return rowsLargestAroundLongCall(rows) + " " + show(rows[0]); });
        tell("rowsTwiceAroundLongCall", () => { const rows = [make(), make()]; return rowsTwiceAroundLongCall(rows) + " " + show(rows[1]); });
        tell("rowsOfAnythingAroundLongCall", () => { const rows = [make(), make()]; const seen: unknown[] = []; return rowsOfAnythingAroundLongCall(rows, seen) + " " + show(seen) + show(rows[1]); });
        tell("longCallAlone", () => { const a = make(); return longCallAlone(a) + " " + show(a); });
        tell("emptyLoop", () => { const a = make(); return emptyLoop(a, 0) + " " + emptyLoop(a, 2) + " " + show(a); });
        tell("nilInFrontOfLoop", () => { const a = make(); return nilInFrontOfLoop(undefined, 0) + " " + nilInFrontOfLoop(undefined, 2) + " " + nilInFrontOfLoop(a, 2) + " " + show(a); });
        tell("chosenInLoop", () => { const a = make(), b = make(); return chosenInLoop(a, b) + " " + show(a) + " " + show(b); });
        tell("methods afterwards", () => { const a = make(); sum(a); return a.indexOf(3) + " " + a.includes(2) + " " + a.lastIndexOf(1) + " " + a.join("-") + " " + a.slice(1, 3).join() + " " + a.concat([1.5]).join() + " " + [...a].reverse().join() + " " + a.map(x => x + 1).join() + " " + a.filter(x => x > 1).length + " " + a.reduce((t, x) => t + x, 0) + " " + Math.max(...a) + " " + [...a].sort((x, y) => y - x).join() + " " + Object.keys(a).join() + " " + Array.isArray(a); });
        tell("a text stored afterwards", () => { const a = make(); sum(a); (a as unknown[])[1] = "x"; return show(a); });
        tell("undefined stored afterwards", () => { const a = make(); sum(a); (a as unknown[])[1] = undefined; return show(a) + " " + absent(a); });
    }
}
//// number-arrays-every-indexing-type.ts
declare const console: { log(...values: unknown[]): void };
function sum(a: number[]): number { let t = 0; for (let i = 0; i < a.length; i++) t += a[i]; return t; }
function sumOf(a: number[]): number { let t = 0; for (const x of a) t += x; return t; }
function product(a: number[]): number { let t = 1; for (const x of a) t *= x; return t; }
function below(a: number[], limit: number): number { let n = 0; for (let i = 0; i < a.length; i++) if (a[i] < limit) n++; return n; }
function notBelow(a: number[], limit: number): number { let n = 0; for (let i = 0; i < a.length; i++) if (!(a[i] < limit)) n++; return n; }
function bits(a: number[]): number { let t = 0; for (const x of a) t ^= x | 0; return t; }
function absent(a: number[]): number { let n = 0; for (let i = 0; i < a.length; i++) if (a[i] === undefined) n++; return n; }
function absentOf(a: number[]): number { let n = 0; for (const x of a) if (x === undefined) n++; return n; }
function kept(a: number[]): string { let s = ""; for (const x of a) s += String(x) + ","; return s; }
function both(a: number[]): string { let t = 0, n = 0; for (const x of a) { t += x; if (x === undefined) n++; } return t + " " + n; }
function text(a: number[]): string { let s = ""; for (let i = 0; i < a.length; i++) s = s + a[i]; return s; }
function last(a: number[]): number { return a[a.length - 1]; }
function plusOne(a: number[], i: number): number { return a[i] + 1; }
function carried(a: number[]): number | undefined { let x: number | undefined = -1; for (let i = 0; i < a.length; i++) x = a[i]; return x; }
function two(a: number[], b: number[]): number { let t = 0; for (let i = 0; i < a.length; i++) t += a[i] * b[i]; return t; }
function tell(name: string, a: () => number[]): void {
    const show = (f: () => unknown) => { try { const v = f(); return Object.is(v, -0) ? "-0" : String(v); } catch (e) { return e instanceof TypeError ? "TypeError" : "threw"; } };
    console.log(name + ": " + [() => sum(a()), () => sumOf(a()), () => product(a()), () => below(a(), 2), () => notBelow(a(), 2), () => bits(a()), () => absent(a()), () => absentOf(a()), () => kept(a()), () => both(a()), () => text(a()), () => last(a()), () => plusOne(a(), 1), () => plusOne(a(), 99), () => carried(a()), () => two(a(), a()), () => two(a(), [1])].map(show).join(" | "));
}
for (let turn = 0; turn < 2; turn++) {
    tell("doubles", () => [1.5, 2.5, -3.25]);
    tell("whole numbers", () => [1, 2, 3]);
    tell("pushed halves", () => { const a: number[] = []; for (let i = 0; i < 4; i++) a.push(i / 2); return a; });
    tell("pushed whole", () => { const a: number[] = []; for (let i = 0; i < 4; i++) a.push(i); return a; });
    tell("empty", () => []);
    tell("NaN stored", () => [1.5, NaN, 2.5]);
    tell("NaN pushed", () => { const a = [1.5]; a.push(NaN); a.push(0 / 0); return a; });
    tell("-0", () => [-0, -0]);
    tell("infinities", () => [Infinity, -Infinity, 1]);
    tell("a hole among doubles", () => { const a = [1.5, 2.5, 3.5]; delete (a as unknown[])[1]; return a; });
    tell("a hole among whole numbers", () => { const a = [1, 2, 3]; delete (a as unknown[])[1]; return a; });
    tell("a hole at the end", () => { const a = [1.5, 2.5]; a.length = 3; return a; });
    tell("all holes", () => new Array<number>(3));
    tell("values", () => { const a: unknown[] = [1.5, "x", 3]; a[1] = 2; return a as number[]; });
    tell("values with a hole", () => { const a: unknown[] = [1.5, "x", 3]; delete a[1]; return a as number[]; });
    tell("undefined among values", () => [1.5, undefined as unknown as number, 3]);
    tell("JSON whole", () => JSON.parse("[1,2,3]"));
    tell("JSON mixed", () => JSON.parse("[1,2.5,3]"));
    tell("sparse", () => { const a = [1.5, 2.5]; a[150000] = 1; a.length = 4; return a; });
    tell("frozen", () => Object.freeze([1.5, 2.5]) as number[]);
    tell("denormals", () => [5e-324, 2.1219957905e-314, 1.7976931348623157e308]);
    tell("large whole", () => [2147483647, 2147483648, -2147483649, 9007199254740991]);
}
//// number-arrays-from-everywhere.ts
// Typed functions over `number[]` (two sums, a read, a chain of reads, a store, a loop of stores, push, includes, indexOf, map, a pattern) get arrays from every source: literals of whole numbers, of fractions and of variables, empty literals that are pushed into, JSON.parse, Array.from, `new Array(n)`, the methods of the library, holes, frozen and sealed arrays, one constant literal evaluated many times, own properties named -1 and 1.5, subclasses, other prototypes, another realm, a proxy. Whatever storage an array arrives with, every function answers as in plain Bun, the first time it sees the array and the second, and 0 and -0 stay apart.
// STATISTIC: ElementPresenceTestsPlaced >= 1
// STATISTIC: IntegerArrayConversionsPlaced >= 1
import vm from "node:vm";

////= show-3

////= list	Object.getPrototypeOf(a) === Array.prototype ? text : text + " with another prototype"

////= lines-19	sum	a	total	i	a[i

////= lines-38	sumOf	a	total

function at(a: number[], i: number): number {
  return a[i];
}

function chase(a: number[], k: number): number {
  k = a[k];
  k = a[k];
  k = a[k];
  return k;
}

////= lines-36	put	number	v

function scale(a: number[], by: number): void {
  for (let i = 0; i < a.length; i++) a[i] = a[i] * by;
}

////= lines-39	add	number	push

////= lines-39	has	boolean	includes

////= lines-39	where	number	indexOf

function doubled(a: number[]): number[] {
  return a.map(value => value * 2);
}

function firstLessSecond(a: number[]): number {
  const [first, second] = a;
  return first - second;
}

let traps = "";
const logging: ProxyHandler<number[]> = {
  get(target, key, receiver) {
    traps += " get:" + String(key);
    return Reflect.get(target, key, receiver);
  },
  set(target, key, value, receiver) {
    traps += " set:" + String(key);
    return Reflect.set(target, key, value, receiver);
  },
  has(target, key) {
    traps += " has:" + String(key);
    return Reflect.has(target, key);
  },
};

function attempt(run: () => string): string {
  let text: string;
  try {
    text = run();
  } catch (error) {
    text = "threw " + (error as Error).constructor.name;
  }
  if (traps !== "") text += " (traps:" + traps + ")";
  traps = "";
  return text;
}

// What the function answers or throws, and what the array is afterwards.
function outcome(a: number[], run: (a: number[]) => string): string {
  const text = attempt(() => run(a));
  return (text === "" ? "" : text + " ") + attempt(() => list(a));
}

const one = JSON.parse("1") as number;
const half = JSON.parse("0.5") as number;
const nan = Number(JSON.parse('"x"'));

function constant(): number[] {
  return [1, 2, 3];
}

function constantFractions(): number[] {
  return [0.5, 1.5, 2.5];
}

function rest(...values: number[]): number[] {
  return values;
}

////= changed

class Numbers extends Array<number> {}
class Padded extends Array<number> {}
(Padded.prototype as unknown as Record<string, number>)["1"] = 40;

const otherRealm = vm.createContext({});
const realmWithAnInheritedElement = vm.createContext({});
vm.runInContext("Array.prototype[1] = 20;", realmWithAnInheritedElement);

const makers: [string, () => number[]][] = [
  ["whole numbers", constant],
  ["fractions", constantFractions],
  ["whole numbers around a fraction", () => [1, 2.5, 3]],
  ["variables that hold whole numbers", () => [one, one + 1, one + 2]],
  ["variables that hold fractions", () => [half, half + 1, half + 2]],
  ["a variable that holds NaN", () => [nan, 2, 3]],
  ["NaN", () => [NaN, 2, 3]],
  ["numbers past 32 bits", () => [2147483647, 2147483648, -2147483649, 9007199254740991]],
  ["infinities", () => [Infinity, -Infinity, 1e308]],
  ["[-0]", () => [-0]],
  ["[0]", () => [0]],
  ["variables that hold 0 and -0", () => [one - one, -(one - one)]],
  ["empty", () => []],
  ["whole numbers pushed", () => changed([], a => (a.push(1), a.push(2), a.push(3)))],
  ["fractions pushed", () => changed([], a => (a.push(0.5), a.push(1.5), a.push(2.5)))],
  ["whole numbers and then a fraction pushed", () => changed([], a => (a.push(1), a.push(2), a.push(2.5)))],
  ["whole numbers stored one behind the other", () => changed([], a => ((a[0] = 1), (a[1] = 2), (a[2] = 3)))],
  ["JSON.parse", () => JSON.parse("[1,2,3]") as number[]],
  ["JSON.parse, fractions", () => JSON.parse("[0.5,1.5,2.5]") as number[]],
  ["JSON.parse, both", () => JSON.parse("[1,2.5,3]") as number[]],
  ["JSON.parse, -0", () => JSON.parse("[-0,0]") as number[]],
  ["JSON.parse, empty", () => JSON.parse("[]") as number[]],
  ["Array.from a length", () => Array.from({ length: 3 }, (_, i) => i)],
  ["Array.from a length, fractions", () => Array.from({ length: 3 }, (_, i) => i / 2)],
  ["Array.from a set", () => Array.from(new Set([1, 2, 3]))],
  ["Array.from bytes", () => Array.from(new Uint8Array([1, 2, 3]))],
  ["Array.from doubles", () => Array.from(new Float64Array([1, NaN, -0]))],
  ["Array.of", () => Array.of(1, 2, 3)],
  ["new Array(3).fill(0)", () => new Array<number>(3).fill(0)],
  ["new Array(3).fill(0.5)", () => new Array<number>(3).fill(0.5)],
  ["new Array(3)", () => new Array<number>(3)],
  ["new Array(3), one stored", () => changed(new Array<number>(3), a => (a[1] = 2))],
  ["new Array(1, 2, 3)", () => new Array<number>(1, 2, 3)],
  ["[1, , 3]", () => [1, , 3] as number[]],
  ["[0.5, , 2.5]", () => [0.5, , 2.5] as number[]],
  ["a hole made by delete", () => changed(JSON.parse("[1,2,3]") as number[], a => delete a[1])],
  ["a hole made by delete among fractions", () => changed(constantFractions(), a => delete a[1])],
  ["a length made longer", () => changed(constant(), a => (a.length = 5))],
  ["a length made shorter", () => changed(constant(), a => (a.length = 2))],
  ["an element past the end", () => changed(constant(), a => (a[6] = 7))],
  ["split and converted", () => "1,2,3".split(",").map(Number)],
  ["Object.values", () => Object.values({ a: 1, b: 2, c: 3 })],
  ["spread", () => [...constant()]],
  ["spread of a set", () => [...new Set([1, 2.5, 3])]],
  ["slice", () => constant().slice()],
  ["slice of a parsed array", () => (JSON.parse("[0,1,2,3,4]") as number[]).slice(1, 4)],
  ["concat", () => constant().concat(constantFractions())],
  ["filter", () => [1, 9, 2, 8, 3].filter(value => value < 5)],
  ["map to whole numbers", () => constant().map(value => value | 0)],
  ["map to fractions", () => constant().map(value => value / 4)],
  ["flat", () => [[1], [2, 3]].flat()],
  ["sorted", () => [3, 1, 2].sort((left, right) => left - right)],
  ["reversed", () => [3, 2, 1].reverse()],
  ["spliced out", () => [0, 1, 2, 3, 4].splice(1, 3)],
  ["rest parameters", () => rest(1, 2, 3)],
  ["rest parameters, fractions", () => rest(0.5, 1.5)],
  ["held a text once", () => changed(["x", 2, 3] as unknown[] as number[], a => (a[0] = 1))],
  ["held a fraction once", () => changed([0.5, 2, 3], a => (a[0] = 1))],
  ["frozen", () => changed(constant(), a => Object.freeze(a))],
  ["frozen fractions", () => changed(constantFractions(), a => Object.freeze(a))],
  ["frozen, parsed", () => changed(JSON.parse("[1,2,3]") as number[], a => Object.freeze(a))],
  ["Object.freeze([1, 2])", () => Object.freeze([1, 2]) as number[]],
  ["sealed", () => changed(constant(), a => Object.seal(a))],
  ["not extensible", () => changed(constant(), a => Object.preventExtensions(a))],
  ["a length that is read-only", () => changed(constant(), a => Object.defineProperty(a, "length", { writable: false }))],
  ["own properties -1 and 1.5", () => changed(constant(), a => (((a as unknown as Record<string, number>)["-1"] = 10), ((a as unknown as Record<string, number>)["1.5"] = 20)))],
  ["own properties -1 and 1.5 stored by number", () => changed(constantFractions(), a => ((a[-1] = 10), (a[1.5] = 20)))],
  ["own properties NaN and 4294967295", () => changed(constant(), a => ((a[NaN] = 30), (a[4294967295] = 40)))],
  ["an own name", () => changed(constant(), a => ((a as unknown as Record<string, number>).name = 6))],
  ["an own getter at 1", () => changed(constant(), a => Object.defineProperty(a, 1, { get: () => 50, enumerable: true, configurable: true }))],
  ["a read-only element at 1", () => changed(constant(), a => Object.defineProperty(a, 1, { value: 2.5, writable: false, enumerable: true, configurable: true }))],
  ["was sparse", () => changed(constant(), a => ((a[1000000] = 4), (a.length = 4)))],
  ["a subclass", () => changed(new Numbers(), a => a.push(1, 2, 3))],
  ["a subclass, fractions", () => changed(new Numbers(), a => a.push(0.5, 1.5, 2.5))],
  ["a subclass, from", () => Numbers.from([1, 2, 3])],
  ["a subclass, of", () => Numbers.of(1, 2, 3)],
  ["a subclass with an element on its prototype", () => changed(new Padded(), a => (a.push(1, 2, 3), delete a[1]))],
  ["a hole over another prototype's element", () => changed([1, , 3] as number[], a => Object.setPrototypeOf(a, { __proto__: Array.prototype, 1: 30 }))],
  ["a hole among fractions over another prototype's element", () => changed([0.5, , 2.5] as number[], a => Object.setPrototypeOf(a, { __proto__: Array.prototype, 1: 30.5 }))],
  ["another prototype with elements past the end", () => changed(constant(), a => Object.setPrototypeOf(a, { __proto__: Array.prototype, 3: 60, "-1": 70, "1.5": 80 }))],
  ["another realm", () => vm.runInContext("[1, 2, 3]", otherRealm) as number[]],
  ["another realm, fractions", () => vm.runInContext("[0.5, 1.5, 2.5]", otherRealm) as number[]],
  ["another realm, a hole", () => vm.runInContext("[1, , 3]", otherRealm) as number[]],
  ["another realm, a hole over an inherited element", () => vm.runInContext("[1, , 3]", realmWithAnInheritedElement) as number[]],
  ["a proxy", () => new Proxy([1, 2, 3], logging) as number[]],
  ["a proxy of fractions", () => new Proxy([0.5, 1.5, 2.5], logging) as number[]],
  ["a proxy of a hole", () => new Proxy([1, , 3] as number[], logging) as number[]],
];

const keys = [0, 1, 2, 3, -1, 1.5, -0, NaN, 4294967295, 4294967296];
const places: [string, (a: number[]) => number][] = [
  ["0", () => 0],
  ["1", () => 1],
  ["the length", a => a.length],
  ["the length + 2", a => a.length + 2],
  ["-1", () => -1],
  ["1.5", () => 1.5],
  ["-0", () => -0],
];
const values = [7, 0.5, -0, nan];

function exercise(name: string, make: () => number[], lines: string[]): void {
  const tell = (what: string, run: () => string): void => void lines.push(name + " | " + what + ": " + attempt(run));
  tell("summed", () => {
    const a = make();
    return show(sum(a)) + " " + show(sum(a)) + " " + show(sumOf(a)) + " " + show(sumOf(a)) + " " + list(a);
  });
  tell("summed by for-of first", () => {
    const a = make();
    return show(sumOf(a)) + " " + show(sum(a)) + " " + list(a);
  });
  tell("read", () => {
    const a = make();
    let text = "";
    for (const key of keys) text += show(at(a, key)) + " ";
    for (const key of keys) text += show(at(a, key)) + " ";
    return text + list(a);
  });
  tell("chased", () => {
    const a = make();
    return show(chase(a, 0)) + " " + show(chase(a, 1)) + " " + show(chase(a, 2)) + " " + show(chase(a, 1.5)) + " " + show(chase(a, -1));
  });
  for (const [label, place] of places) {
    tell("stored at " + label, () => values.map(value => outcome(make(), a => (put(a, place(a), value), show(sum(a))))).join(" ; "));
  }
  tell("summed, then stored into", () =>
    outcome(make(), a => {
      const before = sum(a);
      put(a, 0, 8);
      put(a, 1, 8.5);
      return show(before) + " " + show(sum(a));
    }),
  );
  tell("scaled", () => [2, 0.5, -1, nan].map(by => outcome(make(), a => (scale(a, by), ""))).join(" ; "));
  tell("pushed into", () => values.map(value => outcome(make(), a => add(a, value) + " " + add(a, 1) + " " + show(sum(a)))).join(" ; "));
  tell("searched", () => {
    const a = make();
    let text = "";
    for (const value of [1, 2, 3, 0, -0, 0.5, 2.5, nan, 20, 30, 40, 50, Infinity, 2147483648]) text += (has(a, value) ? "y" : "n") + where(a, value) + " ";
    return text + (has(a, undefined as unknown as number) ? "y" : "n") + where(a, undefined as unknown as number);
  });
  tell("summed, then searched", () => {
    const a = make();
    return show(sum(a)) + " " + has(a, 3) + " " + where(a, 3) + " " + has(a, 2.5) + " " + where(a, 2.5) + " " + has(a, nan);
  });
  tell("doubled", () => {
    const a = make();
    return list(doubled(a)) + " " + list(doubled(doubled(a))) + " " + list(a);
  });
  tell("taken apart", () => {
    const a = make();
    return show(firstLessSecond(a)) + " " + show(firstLessSecond(a));
  });
}

function exerciseAll(): string[] {
  const lines: string[] = [];
  for (const [name, make] of makers) exercise(name, make, lines);
  return lines;
}

const firstTime = exerciseAll();
for (const line of firstTime) console.log(line);
const secondTime = exerciseAll();
let differences = 0;
for (let i = 0; i < firstTime.length; i++) {
  if (firstTime[i] === secondTime[i]) continue;
  differences++;
  console.log("the second time: " + secondTime[i]);
}
console.log("lines that differ the second time: " + differences);

// One array that every function sees again and again, and one literal that many arrays come from.
const shared: number[] = [4, 5, 6];
const parsed = JSON.parse("[4,5,6]") as number[];
for (const [name, a] of [["declared", shared], ["parsed", parsed]] as [string, number[]][]) {
