    say(Kind.name + " whole", () => put(of(1, 2), of(7, 8), 0) + put(of(1, 2), of(), 2) + put(of(), of(), 0) + putAtStart(of(), of()));
    for (const offset of [4, 5, 6, -1, 1.5, -0, NaN, Infinity, -Infinity, 4294967296, 2147483648, "1", "x", null, undefined, true, { valueOf: () => 1 }])
