//// the-length-of-a-list-literal-is-read-under-a-constant-and-stands-in-a-list-literal.ts
const k = "length";
console.log([[5][k]]);
//// the-length-of-a-list-out-of-a-call-is-read-under-a-constant-and-stands-in-a-list-literal.ts
const k = "length";
function g() { return [5]; }
console.log([g()[k]]);
//// the-lengths-of-two-typed-lists-are-read-under-a-parameter-of-a-literal-type-and-returned-in-a-list.ts
function f(a: number[], b: number[], k: "length"): number[] { return [a[k], b[k]]; }
console.log(f([5], [], "length"));
//// the-length-of-a-list-is-read-under-a-constant-into-a-variable-that-stands-in-a-list-literal.ts
const k = "length";
const x = [5][k];
console.log([x]);
const a = [5];
console.log([a[k]]);
//// the-length-of-a-list-is-read-under-a-parameter-and-under-the-variable-of-a-loop.js
function h(k) { return [[5][k]]; }
console.log(h("length"));
for (const k of ["length"]) console.log([[5][k]]);
//// the-length-of-a-list-of-fractions-is-read-under-a-constant-and-the-list-that-holds-it-is-read.js
function g() { return [5.5]; }
const k = "length";
const o = [g()[k]];
console.log(o, o[0] + 1);
//// the-length-of-a-list-is-read-under-a-constant-and-the-list-that-holds-it-is-read-in-another-function.js
function g() { return [5]; }
const k = "length";
const keep = [];
function put(v) { keep.push(v); }
put([g()[k]]);
function rd() { let s = 0; for (const o of keep) s += o[0]; return s; }
console.log(rd(), keep);
//// the-length-of-a-list-is-read-under-a-parameter-and-pushed-to-a-list-that-is-read-in-another-function.js
function g() { return [5]; }
const keep = [];
function put(v) { keep.push(v); }
function h(k) { const o = []; o.push(g()[k]); put(o); }
h("length");
function rd() { let s = 0; for (const o of keep) s += o[0]; return s; }
console.log(rd(), keep);
//// the-length-of-a-list-is-read-under-a-template-and-the-list-that-holds-it-is-read-in-another-function.js
function g() { return [5]; }
const keep = [];
function put(v) { keep.push(v); }
const w = "len";
put([g()[`${w}gth`]]);
function rd() { let s = 0; for (const o of keep) s += o[0]; return s; }
console.log(rd(), keep);
//// the-length-of-a-list-is-read-under-a-constant-and-the-list-that-holds-it-is-copied.js
function g() { return [5, 6]; }
const k = "length";
const keep = [];
function put(v) { keep.push(v); }
put([g()[k]].concat([g()[k]]));
put([g()[k]].slice());
put([g()[k]].filter(() => true));
function rd() { let s = 0; for (const o of keep) s += o[0]; return s; }
console.log(rd(), keep);
