////: attempt
function attempt(run: () => string): string {
  let text: string;
  try {
    text = run();
  } catch (error) {
    text = "threw " + (error as Error).constructor.name;
  }
  if (events !== "") text += " (" + events.trim() + ")";
  events = "";
  return text;
}
////: attempt-5
function attempt(action) {
  try {
    return String(action());
  } catch (error) {
    return error.«1»e;
  }
}
////: build
function build<T>(n: number, element: (k: number) => T, holes: number): T[] {
  const a: T[] = [];
  for (let k = 0; k < n; k++) a.push(element(k));
  if (holes) for (let k = 1; k < n; k += holes) delete a[k];
  return a;
}
////: changed
function changed(a: number[], change: (a: number[]) => void): number[] {
  change(a);
  return a;
}
////: digest
function digest(list«1» {
  let sum = 0;
  let holes = 0;
  for (let i = 0; i < list.length; i++) {
    const value = list[i];
    if (value === undefined) holes++;
    else sum = (sum + value * (i + 1)) % 1000003;
  }
  return list.length + «2» + sum + «2» + holes;
}
////: inRuns
function inRuns(parts: string[]): string {
  let text = "";
  for (let i = 0; i < parts.length; ) {
    let end = i + 1;
    while (end < parts.length && parts[end] === parts[i]) end++;
    text += (i > 0 ? " ; " : "") + parts[i] + (end - i > 1 ? "*" + (end - i) : "");
    i = end;
  }
  return text;
}
