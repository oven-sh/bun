//// spread-into-literals.js
function report(name, run) {
    let text;
    try { text = String(run()); } catch (error) { text = "threw " + error.name; }
    console.log(name + " -> " + text);
}
function summary(array) {
    let sum = 0;
    let holes = 0;
    for (let index = 0; index < array.length; index++) {
        if (!(index in array)) holes++;
        const value = array[index];
        sum += typeof value === "number" ? value : value === undefined ? 0 : 1;
    }
    return array.length + " " + sum + " " + holes;
}
function integers(count) {
    const array = [];
    for (let index = 0; index < count; index++)
        array.push(index);
    return array;
}

for (const first of [0, 1, 70000, 200000]) {
    for (const second of [0, 1, 70000, 200000]) {
        const a = integers(first);
        const b = integers(second);
        report("integers " + first + " and " + second, () => summary([...a, ...b]));
    }
}

report("holes read as undefined", () => summary([...[1, , 3], ...[, 5]]));
report("literal holes", () => summary([1, , ...[2], , 3]));
report("doubles into contiguous", () => summary(["text", ...[1.5, 2.5], {}, ...[3.5]]));
report("long doubles into contiguous", () => summary(["text", ...integers(70000).map(value => value + 0.5)]));
report("integers into doubles", () => summary([0.5, ...[1, 2]]));
report("strings into integers", () => summary([1, ...["a", "b"]]));

report("typed array", () => summary([...new Uint8Array([1, 2, 3]), ...new Float64Array([0.5])]));
report("empty typed array", () => summary([...new Int32Array(0)]));
report("detached typed array", () => {
    const buffer = new ArrayBuffer(8);
    const view = new Uint8Array(buffer);
    buffer.transfer();
    return summary([...view]);
});

report("Map", () => [...new Map([[1, 2], [3, 4]])].join("|"));
report("Map keys", () => [...new Map([[1, 2], [3, 4]]).keys()].join("|"));
report("Set", () => [...new Set([1, 2, 2, 3])].join("|"));
report("string", () => [..."a\u{1F600}b"].length);
report("generator", () => [...(function* () { yield 1; yield 2; })()].join("|"));

report("array with own iterator", () => {
    const array = [1, 2, 3];
    array[Symbol.iterator] = function* () { yield "own"; };
    return [...array].join("|");
});
class Plain extends Array {}
report("subclass without iterator", () => [...Plain.of(1, 2, 3)].join("|"));
class Reversed extends Array {
    *[Symbol.iterator]() { for (let index = this.length - 1; index >= 0; index--) yield this[index]; }
}
report("subclass with iterator", () => [...Reversed.of(1, 2, 3)].join("|"));

report("not iterable", () => [...5]);
report("null", () => [...null]);

let closed = 0;
const failing = {
    [Symbol.iterator]() {
        let count = 0;
        return {
            next() {
                if (++count > 2) throw new RangeError("stop");
                return { value: count, done: false };
            },
            return() { closed++; return {}; },
        };
    },
};
let literal = "not assigned";
report("next throws", () => { literal = [0, ...failing, 9]; return literal; });
console.log(literal, closed);
//// spread-kinds.ts
// Spreads into array literals of numbers, of integers and of values, with elements before, between and behind them: sources of every length, however they keep their elements, with holes at the start, in the middle and at the end, with a property of their own, frozen, shared until written to.
declare const console: { log(...values: unknown[]): void };
function numbers(a: number[], b: number[], v: number): number[] { return [v, ...a, v, v, ...b, v]; }
function numbersFirst(a: number[], b: number[], v: number): number[] { return [...a, v, ...b]; }
function numbersOnly(a: number[], b: number[], c: number[]): number[] { return [...a, ...b, ...c]; }
function integers(a: number[], b: number[]): number[] { return [1, ...a, 2, 3, ...b, 4, 5, 6]; }
function values(a: unknown[], b: unknown[], v: unknown): unknown[] { return [v, ...a, v, v, ...b, v]; }
function texts(a: string[], b: string[]): string[] { return ["<", ...a, "|", ...b, ">", ">", ">", ">", ">"]; }
function mixed(a: number[], b: string[]): (number | string)[] { return ["n", ...a, 0.5, ...b, 1]; }
function inLoop(a: number[], b: number[]): number[] { let out: number[] = []; for (let i = 0; i < 3; i++) out = [i, ...a, i + 0.5, ...b, ...out.slice(0, 2), i]; return out; }
function textsInLoop(a: string[], b: string[]): string[] { let out: string[] = []; for (let i = 0; i < 3; i++) out = ["<", ...a, ...b, ...out.slice(0, 2), ">", ">"]; return out; }
function sum(...all: number[]): number { let t = 0; for (const x of all) t += x === undefined ? 1000 : x; return t; }
function passed(a: number[], b: number[]): number { return sum(1, ...a, 2, ...b, 3); }
function show(a: readonly unknown[]): string {
  let text = a.length + ":"; let run = 0;
  for (let i = 0; i < a.length; i++) { if (!(i in a)) text += "_"; else if (i < 6 || i > a.length - 7) text += String(a[i]) + ","; else run++; }
  let check = 0; for (let i = 0; i < a.length; i++) { const v = a[i]; check = (check * 31 + (typeof v === "number" ? v * 2 : v === undefined ? 7 : String(v).length)) % 1000003; }
  return text + "(" + run + ")#" + check;
}
const lengths = [0, 1, 2, 3, 4, 5, 7, 8, 15, 16, 31, 63, 64, 65, 100, 127, 128, 200, 254, 255, 256, 300];
const kinds: [string, (n: number) => any[]][] = [
  ["int32s", n => Array.from({ length: n }, (_, i) => i + 1)],
  ["doubles", n => Array.from({ length: n }, (_, i) => i + 0.5)],
  ["values", n => Array.from({ length: n }, (_, i) => (i % 3 ? i : i + 0.25) as unknown).concat([]).map(x => x)],
  ["a hole first", n => { const a = Array.from({ length: n }, (_, i) => i + 0.5); delete a[0]; return a; }],
  ["a hole in the middle", n => { const a = Array.from({ length: n }, (_, i) => i + 0.5); delete a[n >> 1]; return a; }],
  ["a hole last", n => { const a = Array.from({ length: n }, (_, i) => i + 0.5); delete a[n - 1]; return a; }],
  ["a hole among int32s", n => { const a = Array.from({ length: n }, (_, i) => i + 1); delete a[n >> 1]; return a; }],
  ["only holes", n => new Array(n)],
  ["a property of its own", n => Object.assign(Array.from({ length: n }, (_, i) => i + 0.5), { extra: 1 })],
  ["frozen", n => Object.freeze(Array.from({ length: n }, (_, i) => i + 0.5)) as any[]],
  ["not a number among doubles", n => Array.from({ length: n }, (_, i) => (i === 1 ? NaN : i + 0.5))],
];
for (const [kind, make] of kinds) for (const n of lengths) {
  const a = make(n); const b = make(n >> 1);
  console.log(kind, n, show(numbers(a, b, 0.25)), show(numbersFirst(a, b, 9)), show(numbersOnly(a, b, a)), show(integers(a, b)), show(values(a, b, "v")), show(mixed(a, ["s", "t"])), show(inLoop(a, b)), n <= 100 ? passed(a, b) : "-");
}
for (const n of lengths) {
  const a = Array.from({ length: n }, (_, i) => "s" + i); const b = a.slice(n >> 1); const holey = a.slice(); delete holey[n >> 1];
  console.log("strings", n, show(texts(a, b)), show(texts(holey, a)), show(textsInLoop(a, b)), show(values(a, holey, 1)), show(mixed([1, 2.5], a)));
}
const literal = (): number[] => [1, 2, 3]; const halves = (): number[] => [0.5, 1.5];
console.log(show(numbers(literal(), halves(), 7)), show(integers(literal(), literal())), show(values(literal(), halves(), null)), show(numbersOnly(halves(), literal(), halves())));
//// spread-of-long-arrays.ts
// Spreading an array of a hundred thousand elements or more copies it as a short one is copied.
function sum(list: readonly unknown[]): string {
  let h = 0;
  for (let i = 0; i < list.length; i++) {
    const x = list[i];
    h = (h * 31 + (typeof x === "number" ? Math.round(x * 4) : typeof x === "string" ? x.length + 1 : x === undefined ? 7 : x === null ? 11 : (x as { id: number }).id)) % 1000003;
  }
  return list.length + ":" + h;
}
function integers(n: number): number[] { const a: number[] = []; for (let i = 0; i < n; i++) a.push(i); return a; }
function fractions(n: number): number[] { const a: number[] = []; for (let i = 0; i < n; i++) a.push(i + 0.25); return a; }
function objects(n: number): { id: number }[] { const a: { id: number }[] = []; for (let i = 0; i < n; i++) a.push({ id: i % 977 }); return a; }
function strings(n: number): string[] { const a: string[] = []; for (let i = 0; i < n; i++) a.push("s" + (i % 100)); return a; }
function mixed(n: number): (number | string | null | undefined)[] { const a: (number | string | null | undefined)[] = []; for (let i = 0; i < n; i++) a.push(i % 4 === 0 ? i : i % 4 === 1 ? "m" : i % 4 === 2 ? null : undefined); return a; }
const sizes = [99998, 99999, 100000, 100001, 150000, 262144];
let out = "";
for (const n of sizes) {
  const i = integers(n), f = fractions(n), o = objects(n), s = strings(n), m = mixed(n);
  const copies = [[...i], [...f], [...o], [...s], [...m]];
  out += n + " " + copies.map(sum).join(" ") + "\n";
  out += [sum([-1, ...i]), sum([...i, -1]), sum([0.5, ...i]), sum(["x", ...i, ...f]), sum([...f, ...i]), sum([...i, ...i]), sum([...o, ...s, null]), sum([1, 2, 3, ...f, 4])].join(" ") + "\n";
  const copy = [...i];
  copy.push(1, 2, 3);
  copy[5] = -5;
  out += sum(copy) + " " + sum(i) + " " + (copy === i) + " " + copy.indexOf(n - 1) + "\n";
}
const holey = integers(120000);
delete holey[77777];
const withHole = [...holey];
out += sum(withHole) + " " + (77777 in withHole) + " " + (77777 in holey) + "\n";
const nans = fractions(120000);
nans[5] = NaN;
const withNaN = [...nans];
out += withNaN.length + " " + Number.isNaN(withNaN[5]) + " " + withNaN[6] + "\n";
const frozen = Object.freeze(integers(110000));
out += sum([...frozen]) + " " + Object.isFrozen([...frozen]) + "\n";
class List extends Array<number> {}
const heir = new List();
for (let k = 0; k < 110000; k++) heir.push(k);
const fromHeir = [...heir];
out += sum(fromHeir) + " " + (fromHeir instanceof List) + "\n";
function count(...all: number[]): number { return all.length; }
out += [...integers(130000)].length + " " + Math.max(...integers(100)) + " " + count(...integers(1000)) + "\n";
console.log(out);
//// spreads-and-patterns-by-stub.js
// Spreads and array patterns over plain arrays stay out of C++. Every other source gives what bun run gives.
import vm from "node:vm";

const count = globalThis.aotOperationCount ?? (() => 0);

function describeElements(list) {
  let description = list.length + ":";
  for (let i = 0; i < list.length; i++) description += " " + (i in list ? (Object.is(list[i], -0) ? "-0" : String(list[i])) : "hole");
  return description;
}
function makeArray(length, valueAt) {
  const list = [];
  for (let i = 0; i < length; i++) list.push(valueAt(i));
  return list;
}
function copyOf(a) { return [...a]; }
function copyBetween(a, b) { return [0, ...a, 1, ...b]; }
function copyAfterText(a, b) { return ["start", ...a, "end", ...b]; }
function firstThree(a) {
  const [x, y, z] = a;
  return [x, y, z];
}
function printCase(name, a, b) {
  console.log(name, "|", describeElements(copyOf(a)), "|", describeElements(copyBetween(a, b)), "|", describeElements(firstThree(a)));
}

const integers = makeArray(5, i => i);
const doubles = makeArray(5, i => i + 0.5);
const strings = makeArray(5, i => "s" + i);
const integers64 = makeArray(64, i => i);
const doubles64 = makeArray(64, i => i + 0.25);
const strings64 = makeArray(64, i => "t" + i);
const integers65 = makeArray(65, i => i);
const doubles65 = makeArray(65, i => i + 0.25);
const strings65 = makeArray(65, i => "u" + i);
const shortList = makeArray(2, i => i + 0.5);
const literalIntegers = [1, 2, 3];
const literalDoubles = [1.5, 2.5, 3.5];
const literalStrings = ["a", "b", "c"];

printCase("integers", integers, doubles);
printCase("doubles", doubles, strings);
printCase("strings", strings, integers);
printCase("integer holes", [1, , 3], integers);
printCase("double holes", [1.5, , 3.5], doubles);
printCase("string holes", ["a", , "c"], strings);
printCase("empty", [], []);
printCase("integers 64", integers64, integers65);
printCase("doubles 64", doubles64, doubles65);
printCase("strings 64", strings64, strings65);
printCase("integers 65", integers65, integers64);
printCase("doubles 65", doubles65, doubles64);
printCase("strings 65", strings65, strings64);
printCase("short", shortList, shortList);
printCase("literal integers", literalIntegers, literalDoubles);
printCase("literal doubles", literalDoubles, literalStrings);
printCase("literal strings", literalStrings, literalIntegers);
printCase("negative zero", [-0, 1.5], [-0, 2.5]);
printCase("set", new Set([1, "two", 3.5]), new Set());
printCase("string", "héllo", "ab");
printCase("iterable object", { *[Symbol.iterator]() { yield 1; yield "two"; } }, []);
printCase("generator", (function* () { yield 1; yield 2.5; yield "three"; })(), (function* () { yield 4; })());

const plainSources = [integers, doubles, strings, integers64, doubles64, strings64, shortList];
let appendsBefore = count("operationAOTAppendSpread");
let readsBefore = count("operationAOTReadBatchedElements");
let total = 0;
for (let round = 0; round < 1000; round++) {
  for (const source of plainSources) {
    total += copyAfterText(source, source).length;
    const [x, y, z] = source;
    if (x !== source[0] || y !== source[1] || z !== source[2]) total = -1;
  }
}
console.log("copied", total, count("operationAOTAppendSpread") === appendsBefore, count("operationAOTReadBatchedElements") === readsBefore);

class Rows extends Array {}
const subclassInstance = new Rows();
subclassInstance.push(1, 2, 3);
printCase("subclass instance", subclassInstance, subclassInstance);

const ownIterator = [1, 2, 3];
ownIterator[Symbol.iterator] = function* () { yield "own"; };
printCase("own iterator", ownIterator, ownIterator);

const replacedPrototype = [1, 2, 3];
Object.setPrototypeOf(replacedPrototype, { *[Symbol.iterator]() { yield "prototype"; } });
printCase("replaced prototype", replacedPrototype, replacedPrototype);

const frozen = Object.freeze([1, 2, 3]);
printCase("frozen", frozen, frozen);
console.log("frozen copy", Object.isFrozen(copyOf(frozen)));

const otherRealm = vm.runInNewContext("[1, 2.5, 'three']");
printCase("other realm", otherRealm, otherRealm);
console.log("other realm copy", copyOf(otherRealm) instanceof Array);

try {
  copyOf(null);
  console.log("null spread did not throw");
} catch (error) {
  console.log("null spread", error instanceof TypeError);
}

let halfBuilt;
const throwsInNext = {
  [Symbol.iterator]() {
    let step = 0;
    return {
      next() {
        if (step++ === 1) throw new RangeError("next failed");
        return { done: false, value: step };
      },
    };
  },
};
try {
  halfBuilt = [1, ...throwsInNext, 2];
} catch (error) {
  console.log("throwing next", error instanceof RangeError, halfBuilt === undefined);
}
//// spreads-in-loops.ts
// Spreads into array literals and argument lists inside loops: records, numbers, strings; sources with holes, frozen, of a subclass, with an iterator of their own, sparse, empty, and iterables that are no arrays.
declare const console: { log(...values: unknown[]): void };
class Rec { constructor(public n: number) {} }
function joinRecs(a: Rec[], b: Rec[], extra: Rec): Rec[] { let out: Rec[] = []; for (let i = 0; i < 3; i++) out = [extra, ...a, ...b, extra, ...out.slice(0, 2)]; return out; }
function joinNumbers(a: number[], b: number[]): number[] { let out: number[] = []; for (let i = 0; i < 3; i++) out = [...a, i, ...b, 0.5, ...out.slice(0, 1)]; return out; }
function joinTexts(a: string[], b: Iterable<string>): string[] { let out: string[] = []; for (let i = 0; i < 2; i++) out = ["<", ...a, ...b, ">"]; return out; }
function total(...values: number[]): number { let t = 0; for (const v of values) t += v; return t; }
function callWith(a: number[], b: number[]): number { let t = 0; for (let i = 0; i < 3; i++) t += total(...a, i, ...b); return t; }
function show(a: readonly unknown[]): string { return a.length + ":" + a.map(v => v instanceof Rec ? "R" + v.n : v === undefined ? "undefined" : String(v)).join(","); }
const recs = [new Rec(1), new Rec(2)]; const holes = [new Rec(1), , new Rec(3)] as Rec[]; const frozen = Object.freeze([new Rec(7)]) as Rec[];
class Recs extends Array<Rec> {} const derived = new Recs(); derived.push(new Rec(21));
class Odd extends Array<Rec> { *[Symbol.iterator](): ArrayIterator<Rec> { yield new Rec(99); } } const odd = new Odd(); odd.push(new Rec(1), new Rec(2));
const sparse: Rec[] = []; sparse[12] = new Rec(12);
for (let round = 0; round < 2; round++) {
    for (const a of [recs, holes, frozen, derived, odd, sparse, []]) console.log(show(joinRecs(a, recs, new Rec(0))), show(joinRecs(recs, a, new Rec(0))));
    for (const a of [[1, 2, 3], [0.5, 1.5], [1, , 3] as number[], [0.5, , 2.5] as number[], [NaN, -0], JSON.parse("[4,5,6.5]") as number[], []]) console.log(show(joinNumbers(a, [7, 8])), show(joinNumbers([0.25], a)), callWith(a, [1]), callWith([2.5], a));
    console.log(show(joinTexts(["a", "b"], new Set(["x", "y"]))), show(joinTexts([], "héllo")), show(joinTexts(["q"], ["r", "s"].values())), show(joinTexts(["q"], new Map([["k", 1]]).keys())));
}
//// storage-follows-the-elements.ts
// The code that creates an array allocates the storage that fits the elements the build found for it, and the code that reads it expects that storage. Each array here is created with small integers in view and then gets, at run time, what such storage cannot hold: a fraction, NaN, -0, undefined, a string, a hole, an element far past the end, a shorter and a longer length. Every read answers as in plain Bun.
function sum(list: number[]): string {
  let total = 0, holes = 0;
  for (let i = 0; i < list.length; ++i) {
    const element = list[i];
    if (element === undefined) ++holes; else total += element;
  }
  return total + " (" + list.length + " long, " + holes + " missing)";
}
function chase(list: number[], key: number): number {
  key = list[key];
  key = list[key];
  key = list[key];
  return key;
}
function integers(count: number): number[] {
  const list: number[] = [];
  for (let i = 0; i < count; ++i) list.push((i * 7 + 1) & 7);
  return list;
}
const count = process.argv.length > 100 ? 3 : 8;

const plain = integers(count);
console.log("integers:", sum(plain), chase(plain, 1), chase(plain, 7), chase(plain, 100));

const withFraction = integers(count);
withFraction.push(0.5);
console.log("a fraction:", sum(withFraction), withFraction[8], chase(withFraction, 8));

const withNaN = integers(count);
withNaN[2] = NaN;
console.log("NaN:", sum(withNaN), withNaN[2], chase(withNaN, 2));

const withNegativeZero = integers(count);
withNegativeZero[0] = -0;
console.log("-0:", sum(withNegativeZero), Object.is(withNegativeZero[0], -0), 1 / withNegativeZero[0]);

const withUndefined = integers(count) as (number | undefined)[];
withUndefined[3] = undefined;
console.log("undefined:", sum(withUndefined as number[]), withUndefined[3], 3 in withUndefined);

const withString = integers(count) as unknown[];
withString[1] = "one";
console.log("a string:", withString.join(), typeof withString[1], typeof withString[2]);

const withHole = integers(count);
delete withHole[4];
console.log("a hole:", sum(withHole), 4 in withHole, withHole[4]);

const farPastTheEnd = integers(count);
farPastTheEnd[100] = 1;
console.log("far past the end:", sum(farPastTheEnd), farPastTheEnd[100], farPastTheEnd[99]);

const veryFar = integers(count);
veryFar[5000000] = 2;
console.log("very far past the end:", veryFar.length, veryFar[5000000], veryFar[4999999], veryFar[1]);

const shorter = integers(count);
shorter.length = 2;
console.log("a shorter length:", sum(shorter), shorter[2], chase(shorter, 0));

const longer = integers(count);
longer.length = 12;
console.log("a longer length:", sum(longer), longer[11], 11 in longer);

const ofHoles: number[] = new Array(5);
ofHoles[1] = 3;
console.log("new Array(5):", sum(ofHoles), ofHoles[0], ofHoles[1]);

const large = integers(count);
large.push(2147483648, -2147483649);
console.log("past 32 bits:", sum(large), large[8], large[9]);

const named = integers(count) as number[] & Record<string, number>;
named["undefined"] = 42;
named["-1"] = 43;
named["1.5"] = 44;
console.log("names that are no indexes:", named[undefined as unknown as number], named[-1], named[1.5], chase(named, 100), sum(named));

function make(first: unknown): unknown[] { return [first]; }
const madeWithInteger = make(1), madeWithString = make("s");
console.log("one literal, two contents:", madeWithInteger[0], madeWithString[0], madeWithInteger.length + madeWithString.length);
