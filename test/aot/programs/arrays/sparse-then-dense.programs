//// sparse-then-dense.js
// Arrays filled from the last index down or in shuffled order start out sparse and end up dense; arrays that stay sparse, hold an accessor at an index or have a read-only length behave as in plain Bun.
const collect = globalThis.Bun ? full => globalThis.Bun.gc(full) : full => (full ? fullGC() : edenGC());

function hashText(hash, text) {
  for (let i = 0; i < text.length; i++) hash = (Math.imul(hash, 31) + text.charCodeAt(i)) | 0;
  return hash;
}

function textOf(element) {
  return typeof element === "object" ? JSON.stringify(element) : String(element);
}

function describe(array) {
  let holes = 0;
  for (let i = 0; i < array.length; i++) if (!(i in array)) holes++;
  const json = JSON.stringify(array);
  let visited = 0;
  let iterated = 0;
  for (const element of array) {
    visited++;
    iterated = hashText(iterated, textOf(element));
  }
  return `length ${array.length}, holes ${holes}, keys ${Object.keys(array).length}, JSON ${json.length} ${hashText(0, json)}, for-of ${visited} ${iterated}`;
}

////= attempt-5	constructor.name + ": " + error.messag

function store(array, index, value) {
  "use strict";
  array[index] = value;
}

function fillDescending(array, first, last, createElement) {
  for (let i = first; i >= last; i--) array[i] = createElement(i);
}

function descendingOrder(count) {
  const order = [];
  for (let i = count - 1; i >= 0; i--) order.push(i);
  return order;
}

function shuffledOrder(count) {
  const order = descendingOrder(count);
  let state = count;
  for (let i = count - 1; i > 0; i--) {
    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
    const j = (state >>> 8) % (i + 1);
    const swapped = order[i];
    order[i] = order[j];
    order[j] = swapped;
  }
  return order;
}

const elementKinds = {
  integers: i => i,
  doubles: i => i + 0.5,
  strings: i => "s" + i,
  objects: i => ({ id: i }),
  mixed: i => [i, i + 0.25, "m" + i, { id: i }, null, undefined][i % 6],
};

function fill(label, order, createElement) {
  const count = order.length;
  const denseEnough = count >> 3;
  const checkpoints = new Set([denseEnough - 1, denseEnough + 1, count]);
  if (count < 100000) checkpoints.add(1).add(denseEnough).add(count >> 1);
  const array = [];
  let stored = 0;
  for (const index of order) {
    array[index] = createElement(index);
    if (checkpoints.has(++stored)) console.log(`${label} after ${stored}: ${describe(array)}`);
  }
  let mismatches = 0;
  for (let i = 0; i < count; i++) if (textOf(array[i]) !== textOf(createElement(i))) mismatches++;
  array.push(createElement(count));
  array.push(-1, 2.5, "pushed", { pushed: true });
  console.log(`${label} pushed: mismatches ${mismatches}, ${describe(array)}, popped ${textOf(array.pop())} ${textOf(array.pop())}, length ${array.length}`);
  return array;
}

function checkEveryKind() {
  for (const count of [600, 1500, 9000]) {
    for (const [kind, createElement] of Object.entries(elementKinds)) {
      fill(`${kind} ${count} descending`, descendingOrder(count), createElement);
      fill(`${kind} ${count} shuffled`, shuffledOrder(count), createElement);
    }
  }
  for (const kind of ["integers", "mixed"]) {
    fill(`${kind} 120000 descending`, descendingOrder(120000), elementKinds[kind]);
    fill(`${kind} 120000 shuffled`, shuffledOrder(120000), elementKinds[kind]);
  }
}

function checkSparseAgainAfterDense() {
  const array = fill("dense twice", descendingOrder(2000), elementKinds.strings);
  const start = array.length;
  fillDescending(array, start + 7999, start, elementKinds.doubles);
  console.log(`dense twice, second fill: ${describe(array)}, push ${array.push("pushed")}`);
}

function checkHolesRemain() {
  const array = [];
  for (let i = 4998; i >= 0; i -= 2) array[i] = { id: i };
  console.log(`every other index: ${describe(array)}, ${textOf(array[4997])} ${textOf(array[4998])}, push ${array.push("pushed")}`);
  for (let i = 4997; i >= 0; i -= 2) array[i] = i;
  console.log(`every index: ${describe(array)}`);
}

function checkDeleteAndShortenWhileSparse() {
  const array = [];
  fillDescending(array, 3999, 3600, elementKinds.strings);
  for (let i = 3999; i >= 3600; i -= 3) delete array[i];
  console.log(`deleted while sparse: ${describe(array)}`);
  array.length = 3700;
  console.log(`shortened while sparse: ${describe(array)}`);
  fillDescending(array, 3650, 0, elementKinds.integers);
  console.log(`filled afterwards: ${describe(array)}, push ${array.push("pushed")}`);
}

function checkYoungElementsInOldArray() {
  const array = [];
  array[3999] = { id: 3999 };
  collect(true);
  fillDescending(array, 3998, 0, elementKinds.objects);
  collect(false);
  const garbage = [];
  for (let i = 0; i < 20000; i++) garbage[i % 64] = { id: -i, text: "garbage " + i };
  collect(false);
  let total = 0;
  for (const element of array) total += element.id;
  console.log(`young elements in an old array: ${describe(array)}, total ${total}, garbage ${garbage.length}`);
}

function checkStaysSparse() {
  const array = [];
  array[200000] = "last";
  for (let i = 0; i < 2000; i++) array[i * 97] = i;
  console.log(`stays sparse: ${describe(array)}`);
  console.log(`stays sparse: push ${array.push("pushed")}, ${textOf(array[200000])} ${textOf(array[200001])} ${textOf(array[199999])}, ${describe(array)}`);
}

function checkMaximumIndex() {
  const array = [];
  array[4294967294] = "last";
  fillDescending(array, 99, 0, elementKinds.integers);
  console.log(`maximum index: length ${array.length}, keys ${Object.keys(array).length}, ${textOf(array[4294967294])}`);
  console.log(`maximum index: push ${attempt(() => array.push("pushed"))}, length ${array.length}, keys ${Object.keys(array).length}`);
}

function checkGetterAtIndex() {
  const array = [];
  let reads = 0;
  Object.defineProperty(array, 2999, { get: () => "read " + ++reads, enumerable: true, configurable: true });
  fillDescending(array, 2998, 0, elementKinds.integers);
  console.log(`getter: ${describe(array)}, reads ${reads}`);
  console.log(`getter: store ${attempt(() => store(array, 2999, "stored"))}, push ${array.push("pushed")}, ${textOf(array[2999])}, reads ${reads}`);
  Object.defineProperty(array, 2999, { value: "data", writable: true, enumerable: true, configurable: true });
  console.log(`getter redefined as data: ${describe(array)}, reads ${reads}`);
}

function checkSetterAtIndex() {
  const array = [];
  const received = [];
  Object.defineProperty(array, 10, { get: () => received.length, set: value => received.push(value), enumerable: true, configurable: true });
  fillDescending(array, 2999, 0, elementKinds.integers);
  console.log(`setter: ${describe(array)}, received ${received.join()}, push ${array.push("pushed")}`);
}

function checkReadOnlyLength() {
  const array = [];
  array[2999] = "last";
  Object.defineProperty(array, "length", { writable: false });
  fillDescending(array, 2998, 0, elementKinds.integers);
  console.log(`read-only length: ${describe(array)}`);
  console.log(`read-only length: push ${attempt(() => array.push("pushed"))}, store ${attempt(() => store(array, 3000, "stored"))}, length ${array.length}, ${3000 in array}`);
}

function checkNonExtensible() {
  const array = [];
  array[2999] = "last";
  array[5] = "five";
  Object.preventExtensions(array);
  let failures = 0;
  for (let i = 2998; i >= 0; i--) {
    try {
      store(array, i, i);
    } catch {
      failures++;
    }
  }
  console.log(`non-extensible: ${describe(array)}, failures ${failures}, ${textOf(array[5])}, push ${attempt(() => array.push("pushed"))}`);
}

function checkNamedProperty() {
  const array = [];
  array.label = "named";
  fillDescending(array, 2999, 0, elementKinds.strings);
  console.log(`named property: ${describe(array)}, ${array.label}, push ${array.push("pushed")}`);
}

function checkSubclass() {
  class List extends Array {}
  const list = new List();
  fillDescending(list, 2999, 0, elementKinds.doubles);
  console.log(`subclass: ${describe(list)}, push ${list.push("pushed")}, ${list instanceof List} ${list.slice(0, 2) instanceof List}`);
}

checkEveryKind();
checkSparseAgainAfterDense();
checkHolesRemain();
checkDeleteAndShortenWhileSparse();
checkYoungElementsInOldArray();
checkStaysSparse();
checkMaximumIndex();
checkGetterAtIndex();
checkSetterAtIndex();
checkReadOnlyLength();
checkNonExtensible();
checkNamedProperty();
checkSubclass();
//// splice-at-a-position-typed-number.ts
// The position and the count of a splice are typed `number` and hold whole numbers, fractions, NaN, infinities, -0, numbers beyond int32: with the result used, unused, and taken apart.
function insertAt(list: number[], at: number, value: number): void { list.splice(at, 0, value); }
function removeAt(list: string[], at: number, count: number): string[] { return list.splice(at, count); }
function replaceAt(list: (string | number)[], at: number, count: number, a: string, b: number): number { const [first] = list.splice(at, count, a, b); return typeof first === "number" ? first : -1; }
function pick(values: number[], i: number): number { let chosen: number; if (i % 3 === 0) chosen = values[i % values.length]; else if (i % 3 === 1) chosen = values[(i * 7) % values.length] / 1; else chosen = i % 5; return chosen; }
const positions = [0, 1, 2, 3.5, -1, -2.5, NaN, Infinity, -Infinity, -0, 2 ** 31, -(2 ** 31) - 1, 2 ** 32 + 1, 1e300, 0.999, 4, 100];
const lines: string[] = [];
for (let round = 0; round < 400; round++) {
  const at = pick(positions, round), count = pick(positions, round + 5);
  const numbers = [1, 2, 3, 4, 5];
  insertAt(numbers, at, 9);
  const texts = ["a", "b", "c", "d", "e", "f"];
  const removed = removeAt(texts, at, count);
  const mixed: (string | number)[] = [1, "x", 2, "y"];
  const first = replaceAt(mixed, at, count, "new", 7);
  if (round < 60 || round % 37 === 0) lines.push([at, count, numbers.join(), texts.join(""), removed.join(""), mixed.join(), first].join(" | "));
}
console.log(lines.join("\n"));
// As in a sorted insertion: the position is a variable without an initial value that two branches fill.
function reorder(items: number[]): number[] {
  const result: number[] = [];
  let special = -1, cutoff = 0, index = 0;
  for (const item of items) {
    let spliceIndex: number;
    if (item % 4 === 0) { special++; spliceIndex = special; cutoff++; } else { index = item % 3 === 0 ? cutoff : index + 1; spliceIndex = Math.min(index, result.length); }
    result.splice(spliceIndex, 0, item);
  }
  return result;
}
let sum = 0;
for (let i = 0; i < 3000; i++) sum += reorder([i, i + 1, i + 2, i + 3, i + 4, i + 5, i + 6])[i % 7];
console.log(sum, reorder([8, 3, 4, 1, 12, 9, 5, 16]).join());
//// splice-literal-delete-count.ts
// a.splice(start, D, ..) with D written as 0, 1, 2 or 3 and 0 to 9 inserted elements, against the same edit made element by element: int32s, doubles, strings and mixed values, holes, full and spare capacity, short and long tails, every kind of start. Then arrays whose storage cannot be edited in place.
class Rec { constructor(public id: number) {} }

////= lines	spliceNumbers0	number	0
////= lines	spliceNumbers1	number	1
////= lines	spliceNumbers2	number	2
////= lines	spliceNumbers3	number	3
////= lines	spliceValues0	unknown	0
////= lines	spliceValues1	unknown	1
////= lines	spliceValues2	unknown	2
////= lines	spliceValues3	unknown	3
type Splice<T> = (a: T[], s: number, x: T[]) => T[];
const numberSplices: Splice<number>[] = [spliceNumbers0, spliceNumbers1, spliceNumbers2, spliceNumbers3];
const valueSplices: Splice<unknown>[] = [spliceValues0, spliceValues1, spliceValues2, spliceValues3];

function show(v: unknown): string { return v instanceof Rec ? "#" + v.id : v === undefined ? "undefined" : v === null ? "null" : typeof v === "string" ? "'" + v + "'" : Object.is(v, -0) ? "-0" : String(v); }
function showAt(a: readonly unknown[], k: number): string { return (k in a ? show(a[k]) : "_") + ","; }
function list(a: readonly unknown[]): string { let t = a.length + "["; for (let k = 0; k < a.length; k++) t += showAt(a, k); return t + "]"; }
function expected(a: readonly unknown[], start: number, deleteCount: number, items: readonly unknown[]): string {
  const n = a.length, relative = start !== start ? 0 : Math.trunc(start);
  const from = relative < 0 ? Math.max(n + relative, 0) : Math.min(relative, n), count = Math.min(deleteCount, n - from);
  let removed = count + "[", edited = n - count + items.length + "[";
  for (let k = 0; k < count; k++) removed += showAt(a, from + k);
  for (let k = 0; k < from; k++) edited += showAt(a, k);
  for (const item of items) edited += show(item) + ",";
  for (let k = from + count; k < n; k++) edited += showAt(a, k);
  return removed + "] " + edited + "]";
}
let checks = 0, bad = 0;
function check<T>(name: string, splice: Splice<T>, a: T[], start: number, deleteCount: number, items: T[]): void {
  const want = expected(a, start, deleteCount, items), removed = splice(a, start, items), got = list(removed) + " " + list(a);
  checks++;
  if (got !== want && bad++ < 12) console.log("DIFFERS: " + name + "\n  got  " + got + "\n  want " + want);
}
function build<T>(n: number, element: (k: number) => T, hasSpareCapacity: boolean, holes: number): T[] {
  const a: T[] = [];
  for (let k = 0; k < n; k++) a.push(element(k));
  const result = hasSpareCapacity ? a : a.slice();
  if (holes) for (let k = 1; k < n; k += holes) delete result[k];
  return result;
}
const int32At = (k: number) => k * 3, doubleAt = (k: number) => k + 0.5, stringAt = (k: number): unknown => "t" + k;
const mixedAt = (k: number): unknown => (k % 4 === 0 ? undefined : k % 4 === 1 ? null : k % 4 === 2 ? -0 : new Rec(k));

for (const n of [0, 1, 2, 3, 5, 8, 33, 34, 35, 36, 70]) {
  for (const start of [0, 1, 2, n >> 1, n - 2, n - 1, n, n + 1, -1, -2, -n, -n - 1, 0.5, -1.5, NaN, Infinity, -Infinity, 2 ** 31, -(2 ** 31) - 1, 2 ** 32 + 1]) {
    for (let deleteCount = 0; deleteCount <= 3; deleteCount++) {
      for (let inserted = 0; inserted <= 9; inserted++) {
        const int32s: number[] = [], fractions: number[] = [], oddNumbers: number[] = [], values: unknown[] = [];
        for (let k = 0; k < inserted; k++) { int32s.push(100 + k); fractions.push(100.25 + k); oddNumbers.push(k === inserted - 1 ? NaN : k ? 100.25 + k : -0); values.push(k % 3 === 0 ? "x" + k : k % 3 === 1 ? new Rec(100 + k) : k); }
        for (const hasSpareCapacity of [false, true]) {
          const at = " n=" + n + " start=" + start + " delete=" + deleteCount + " insert=" + inserted + (hasSpareCapacity ? " spare" : " full");
          const numbers = numberSplices[deleteCount], anything = valueSplices[deleteCount];
          check("int32s into int32s" + at, numbers, build(n, int32At, hasSpareCapacity, 0), start, deleteCount, int32s);
          check("fractions into int32s" + at, numbers, build(n, int32At, hasSpareCapacity, 0), start, deleteCount, fractions);
          check("int32s into doubles" + at, numbers, build(n, doubleAt, hasSpareCapacity, 0), start, deleteCount, int32s);
          check("fractions into doubles" + at, numbers, build(n, doubleAt, hasSpareCapacity, 0), start, deleteCount, fractions);
          check("NaN and -0 into doubles" + at, numbers, build(n, doubleAt, hasSpareCapacity, 0), start, deleteCount, oddNumbers);
          check("int32s into doubles with holes" + at, numbers, build(n, doubleAt, hasSpareCapacity, 3), start, deleteCount, int32s);
          check("values into strings" + at, anything, build(n, stringAt, hasSpareCapacity, 0), start, deleteCount, values);
          check("values into mixed values" + at, anything, build(n, mixedAt, hasSpareCapacity, 0), start, deleteCount, values);
          check("values into strings with holes" + at, anything, build(n, stringAt, hasSpareCapacity, 2), start, deleteCount, values);
          check("values into int32s" + at, anything, build<unknown>(n, int32At, hasSpareCapacity, 0), start, deleteCount, values);
          check("values into doubles" + at, anything, build<unknown>(n, doubleAt, hasSpareCapacity, 0), start, deleteCount, values);
        }
      }
    }
  }
}
