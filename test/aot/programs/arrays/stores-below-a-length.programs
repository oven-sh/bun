//// stores-below-a-length-the-array-no-longer-has.js
// A key that was found below the length of an array is inside it for good only while the array never gets shorter. Every case makes it shorter between the comparison and the store, by another door.
function empty(list) { list.length = 0; }
function emptyAndGive(list, value) { list.length = 0; return value; }
const lines = [];
function run(name, f) { try { lines.push(name + ": " + f()); } catch (error) { lines.push(name + ": threw " + error.name); } }
