function f2() {
  const a = [1, 2, 3, 4, 5, 6];
  for (let k = 0; k < a.length; k++) { if (k === 3) {  } a[k] = 7; if (k > 8) break; }
  let s = "";
  for (let i = 0; i < a.length; i++) s += (i in a ? "" : "hole ") + a[i] + ",";
  s += "|";
  for (const v of a) s += v + ",";
  return s + "|" + a.length;
}
