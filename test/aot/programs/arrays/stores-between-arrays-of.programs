        tell(name + " of", () => { let s = ""; eachOf(make(), x => { s += text(x) + " "; }); return s; });
        tell(name + " beyond", () => { let s = ""; beyond(make(), x => { s += text(x) + " "; }); return s; });
        tell(name + " down", () => { let s = ""; down(make(), x => { s += text(x) + " "; }); return s; });
