//// stores-between-arrays-of-every-storage.ts
function fill(list: any[], from: any[]): void { for (let i = 0; i < from.length; i++) list[i] = from[i]; }
const texts = ["[1.5,2.5,3.5]", "[1,2,3]", "[{},\"a\",null]", "[1,2.5,\"x\"]", "[]", "[1.5,null,3]"];
for (const target of texts) {
  for (const source of texts) {
    const list = JSON.parse(target) as any[];
    const from = JSON.parse(source) as any[];
    fill(list, from);
    list[list.length + 1] = 7;
    list[0] = from;
    console.log(target, source, JSON.stringify(list), list.length);
  }
}
//// stores-under-numbers-that-are-no-index-in-a-validating-build.js
// -1, 1.5, 4294967295 and their like name properties of an array, no elements. Such a data property is stored, read back, tested for, listed, copied, updated and deleted, as in plain Bun, and a validating build has nothing to find: the array keeps what is proven of its names and of its storage.
function show(what, f) { let last; for (let round = 0; round < 300; round++) last = f(); console.log(what, JSON.stringify(last)); }
for (const key of [-1, 1.5, 4294967295, -0.5, 1e21, NaN, Infinity]) {
  show("literal, read back " + key, () => { const a = [1, 2, 3]; a[key] = 5; return [a[key], a.length]; });
  show("in " + key, () => { const a = [1, 2, 3]; a[key] = 5; return [key in a, String(key) in a, Object.hasOwn(a, key)]; });
  show("keys " + key, () => { const a = [1, 2, 3]; a[key] = 5; return [Object.keys(a), Object.getOwnPropertyNames(a).length]; });
  show("for-in " + key, () => { const a = [1, 2, 3]; a[key] = 5; const seen = []; for (const k in a) seen.push(k); return seen; });
  show("entries " + key, () => { const a = [1, 2, 3]; a[key] = 5; return Object.entries(a); });
  show("spread into an object " + key, () => { const a = [1, 2, 3]; a[key] = 5; return { ...a }; });
  show("assign " + key, () => { const a = [1, 2, 3]; a[key] = 5; return Object.assign({}, a); });
  show("delete " + key, () => { const a = [1, 2, 3]; a[key] = 5; const gone = delete a[key]; return [gone, a[key], key in a]; });
  show("update " + key, () => { const a = [1, 2, 3]; a[key] = 5; a[key] += 2; a[key]++; return a[key]; });
}
show("constant -1", () => { const a = [1, 2, 3]; a[-1] = 5; return [a[-1], -1 in a, Object.keys(a), a.at(-1)]; });
show("constant 1.5", () => { const a = [1, 2, 3]; a[1.5] = 5; return [a[1.5], 1.5 in a, Object.keys(a)]; });
show("a loop that runs below zero", () => { const a = [1, 2, 3]; for (let i = 2; i >= -2; i--) a[i] = i; let sum = 0; for (let i = 2; i >= -2; i--) sum += a[i]; return [sum, a.length, Object.keys(a)]; });
show("handed to a function", () => { const a = [1, 2, 3]; (function (list, at) { list[at] = 9; })(a, -1); return [a[-1], Object.keys(a)]; });
show("an accessor under -1", () => { const a = [1, 2, 3]; Object.defineProperty(a, -1, { get() { return "got"; }, configurable: true }); return [a[-1], a.length]; });
//// subclass-and-proxy-elements.ts
declare const console: { log(...values: unknown[]): void };

const events: string[] = [];
function flushEvents(): string {
    const text = events.join(",");
    events.length = 0;
    return text;
}
function describe(value: unknown): string {
    return typeof value === "symbol" ? "symbol" : typeof value + ":" + String(value);
}
function report(name: string, run: () => unknown): void {
    let text: string;
    try { text = describe(run()); } catch (error) { text = "threw " + (error as Error).name; }
    console.log(name + " -> " + text + " [" + flushEvents() + "]");
}
function read(array: unknown[], key: any): unknown { return array[key]; }
function store(array: unknown[], key: any, value: unknown): unknown { array[key] = value; return array.length; }

class Stack<T> extends Array<T> {
    push(...items: T[]): number {
        events.push("own push");
        return super.push(...items);
    }
    slice(start?: number, end?: number): T[] {
        events.push("own slice");
        return super.slice(start, end);
    }
}
Object.defineProperty(Stack.prototype, "4", {
    get() { events.push("get 4"); return "from getter"; },
    set(value: unknown) { events.push("set 4 " + String(value)); },
    configurable: true,
});

const marker = Symbol("marker");
const keys: [string, any][] = [
    ["0", 0], ["1", 1], ["4", 4], ["9", 9], ["-1", -1], ["1.5", 1.5], ["string 1", "1"],
    ["string name", "name"], ["null", null], ["undefined", undefined], ["symbol", marker], ["length", "length"],
];

function makeStack(): Stack<unknown> {
    const stack = new Stack<unknown>();
    stack.push("a", "b", "c");
    flushEvents();
    return stack;
}
function makeProxied(): unknown[] {
    const array: unknown[] = ["a", "b", "c"];
    const handler: ProxyHandler<any> = {
        get(target: any, key: string | symbol, receiver: unknown): unknown {
            events.push("trap get " + String(key));
            return Reflect.get(target, key, receiver);
        },
        set(target: any, key: string | symbol, value: unknown, receiver: unknown): boolean {
            events.push("trap set " + String(key));
            return Reflect.set(target, key, value, receiver);
        },
    };
    Object.setPrototypeOf(array, new Proxy(Array.prototype, handler));
    return array;
}
function makePlain(): unknown[] { return ["a", "b", "c"]; }

const makers: [string, () => unknown[]][] = [["stack", makeStack], ["proxied", makeProxied], ["plain", makePlain]];
for (const [name, make] of makers) {
    for (const [label, key] of keys) {
        report(name + " read " + label, () => read(make(), key));
        if (label !== "length")
            report(name + " store " + label, () => { const array = make(); const length = store(array, key, "new"); return String(length) + " " + String(read(array, key)); });
    }
}

report("own push runs", () => { const stack = makeStack(); return stack.push("d"); });
report("own slice runs", () => makeStack().slice(1).length);
report("slice keeps subclass", () => makeStack().slice(1) instanceof Stack);
report("spread of subclass", () => [...makeStack()].join("|"));
report("literal from proxied", () => [...makeProxied()].length);

function sumNumbers(values: number[]): number {
    let sum = 0;
    for (let index = 0; index < values.length; index++) sum += values[index];
    return sum;
}
const numbers: number[] = [1, 2, 3];
numbers[1] = 20;
numbers[3] = 4.5;
numbers.push(5);
report("plain numbers sum", () => sumNumbers(numbers));
report("plain numbers slice", () => numbers.slice(1, 3).join("|"));
report("plain numbers past the end", () => numbers[100]);
//// the-array-that-map-makes-of-numbers-is-read-as-numbers.ts
// `list.map(v => (v + k) | 0)[0]` with a list of which nothing is proven: the array that map makes takes numbers only and is read as a number[], so it is allocated with storage for
// numbers. It is an ordinary array all the same: holes stay holes, and whatever is stored into it later is found again.
const hidden = (value: unknown): any => JSON.parse(JSON.stringify(value));
function firstOfMapped(list: number[], k: number): number {
  return list.map((v: number): number => (v + k) | 0)[0]!;
}
function mapped(list: number[], k: number): number[] {
  const result = list.map((v: number): number => (v + k) | 0);
  if (result[0]! > 1000) return [];
  return result;
}
function halves(list: number[]): number {
  return list.map((v: number): number => v / 2)[1]!;
}
function notNumbers(list: number[]): number {
  return list.map((v: number): number => v / 0 - v / 0)[0]!;
}
function describe(list: unknown[]): string {
  const parts: string[] = [];
  for (let i = 0; i < list.length; i++) parts.push(i in list ? typeof list[i] + ":" + String(list[i]) : "hole");
  return list.length + " [" + parts.join(", ") + "] " + JSON.stringify(list);
}
const sparse: number[] = [1, 2, 3, 4];
delete (sparse as any)[1];
for (let round = 0; round < 3; round++) {
  const list: number[] = hidden([round + 1, 2, 3]);
  console.log(firstOfMapped(list, round), firstOfMapped(hidden([]), 1), firstOfMapped(hidden([1.5, 2]), 1), firstOfMapped(sparse, round));
  console.log(halves(list), halves(hidden([7])), notNumbers(list));
  const result = mapped(list, 10);
  console.log(describe(result), describe(mapped(sparse, 1)), describe(mapped(hidden([]), 1)));
  (result as unknown[]).push("text");
  result[0] = 0.5;
  (result as unknown[])[1] = { a: round };
  result[6] = -0;
  console.log(describe(result), Object.is(result[6], -0), result.indexOf(0.5), result.includes(NaN));
  const frozen = Object.freeze(mapped(list, 1));
  try { (frozen as number[])[0] = 9; console.log("stored"); } catch (error) { console.log((error as Error).name); }
  console.log(describe(frozen as number[]), mapped(hidden(["a", "b"]), 1).join());
}
//// the-largest-and-the-smallest-of-a-spread-array.ts
// Math.max(...list) and Math.min(...list) are a loop over the elements where the list is an array of int32, of doubles or of boxed elements that are numbers.
// Anything else among the elements (a hole, undefined, a text, an object with valueOf) and any other way to walk the list is the call as the language describes it.
const lines: string[] = [];
function show(v: unknown): string { return Object.is(v, -0) ? "-0" : String(v); }
function say(label: string, ...values: unknown[]): void { lines.push(label + ": " + values.map(show).join(" ")); }

function largest(list: number[]): number { return Math.max(...list); }
function smallest(list: number[]): number { return Math.min(...list); }
function largestOfAny(list: unknown[]): number { return Math.max(...(list as number[])); }
function smallestOfAny(list: unknown[]): number { return Math.min(...(list as number[])); }
function both(label: string, list: number[]): void { say(label, largest(list), smallest(list), largestOfAny(list), smallestOfAny(list)); }
function attempt(label: string, f: () => unknown): void { try { say(label, f()); } catch (error) { say(label, (error as Error).constructor.name); } }

const integers = [3, 1, 4, 1, 5, 9, 2, 6];
const doubles = [3.5, 1.25, -4.75, 9.125];
both("int32", integers);
both("doubles", doubles);
both("mapped", integers.map((x) => x));
both("mapped to doubles", integers.map((x) => x / 2));
both("filtered", integers.filter((x) => x > 2));
both("parsed", JSON.parse("[7, 2.5, -1, 1e300]") as number[]);
{
  const boxed: unknown[] = ["text", 1, 2.5, -7, 2 ** 40];
  boxed.shift();
  both("boxed, once with a text", boxed as number[]);
  const mixed: unknown[] = [{}, 1]; mixed[0] = -0; mixed[1] = 0;
  both("boxed zeros", mixed as number[]);
  mixed[0] = 0; mixed[1] = -0;
  both("boxed zeros the other way", mixed as number[]);
  mixed[1] = NaN;
  both("boxed with NaN", mixed as number[]);
  mixed[0] = Infinity; mixed[1] = -Infinity;
  both("boxed infinities", mixed as number[]);
  mixed.length = 0;
  both("boxed and empty", mixed as number[]);
}
both("empty", []);
both("one", [42]);
both("zeros", [0, -0]); both("zeros the other way", [-0, 0]); both("double zeros", [-0, 0.5, 0]);
both("NaN first", [NaN, 1, 2]); both("NaN last", [1.5, 2, NaN]);
{
  const holes: unknown[] = [{}, 1, 2, 3]; holes[0] = 5; delete holes[2];
  say("a hole among boxed elements", largestOfAny(holes), smallestOfAny(holes));
  const intHoles = [1, 2, 3]; delete intHoles[1];
  both("a hole among int32", intHoles);
  const doubleHoles = [1.5, 2.5, 3.5]; delete doubleHoles[0];
  both("a hole among doubles", doubleHoles);
  const parent = Object.create(Array.prototype) as number[];
  parent[2] = 100;
  Object.setPrototypeOf(holes, parent);
  say("the hole is filled from the prototype", largestOfAny(holes), smallestOfAny(holes));
  Object.setPrototypeOf(intHoles, parent); parent[1] = -100;
  both("and the one among int32", intHoles);
}
say("undefined", largestOfAny([1, undefined, 3]), smallestOfAny([1, undefined, 3]));
say("null", largestOfAny([1, null, 3]), smallestOfAny([1, null, 3]));
say("booleans", largestOfAny([false, true]), smallestOfAny([false, true]));
say("texts", largestOfAny(["10", "9", 3]), smallestOfAny(["10", "9", 3]), largestOfAny([1, "x"]));
{
  const order: string[] = [];
  const object = (name: string, value: number) => ({ valueOf() { order.push(name); return value; } });
  say("objects", largestOfAny([1, object("a", 5), NaN, object("b", 7), 2]), order.join());
  order.length = 0;
  const list: unknown[] = [1, 2, 3];
  list[1] = { valueOf() { order.push("changes"); list[2] = 1000; list.length = 2; return 2; } };
  say("an element changes the list", largestOfAny(list), order.join(), list.length);
}
attempt("a bigint", () => largestOfAny([1, 2n]));
attempt("a symbol", () => smallestOfAny([1, Symbol("s")]));
attempt("throws in the middle", () => largestOfAny([1, { valueOf() { throw new RangeError("no"); } }, 2n]));
{
  const long: unknown[] = [{}];
  for (let i = 0; i < 20000; i++) long[i] = (i * 7919) % 20011;
  say("long and boxed", largestOfAny(long), smallestOfAny(long));
  long[19999] = 0.5 - 1;
  say("long with a double at the end", largestOfAny(long), smallestOfAny(long));
}
{
  class List extends Array<number> {}
  const list = List.from([4, 8, 2]);
  both("a subclass", list);
  both("frozen", Object.freeze([6, 7, 5]) as number[]);
  const own = [1, 2, 3];
  (own as unknown as { [Symbol.iterator]: () => Iterator<number> })[Symbol.iterator] = function* () { yield 10; yield 20; };
  both("its own iterator", own);
}
let total = 0;
const boxedAgain = integers.map((x) => x * 1.5);
for (let round = 0; round < 3000; round++) total += largest(boxedAgain) + smallest(boxedAgain) + largest(integers) + smallest(doubles);
say("often", total);
console.log(lines.join("\n"));
//// the-library-hands-doubles-to-callbacks-as-they-are.ts
// The loops of Array.prototype over storage of doubles: what the callback is handed (NaN, -0, infinities, the smallest and the largest numbers, integers kept as doubles), holes between them,
// and the arrays that filter, map, flatMap, slice and concat make of them, from none to many elements.
const launder = new Function("v", process.env.LAUNDER_TEXT ?? "return v") as <V>(v: V) => V;
const text = (v: unknown): string => (Object.is(v, -0) ? "-0" : Array.isArray(v) ? "[" + Array.from(v, (each, i) => (i in v ? text(each) : "hole")).join(",") + "]" : typeof v === "string" ? JSON.stringify(v) : String(v));
const show = (label: string, ...values: unknown[]) => console.log(label, values.map(text).join(" | "));
const lists: [string, () => number[]][] = [
  ["odd numbers", () => [0.5, NaN, -0, Infinity, -Infinity, 5e-324, 1.7976931348623157e308, 4294967296.5, -1.5]],
  ["integers beside a fraction", () => [1, 2, 0.5, 3, 2147483648, -2147483649, 9007199254740991]],
  ["holes", () => [0.5, , NaN, , -0, ,] as number[]],
  ["parsed", () => JSON.parse("[0.5,1,-0,1e308,2.5]") as number[]],
  ["made by map", () => [1, 2, 3].map((v) => v / 2)],
  ["one", () => [0.25]],
  ["none, once doubles", () => { const list = [0.5]; list.length = 0; return list; }],
];
for (const [label, make] of lists) {
  const handed: unknown[] = [];
  const note = launder((v: unknown, i: number) => { handed.push(i, v); return false; });
  make().some(note); show(label + " some", handed);
  handed.length = 0; make().forEach(note); show(label + " forEach", handed);
  handed.length = 0; make().find(note); show(label + " find", handed);
  handed.length = 0; make().findLast(note); show(label + " findLast", handed);
  show(label + " map", make().map(launder((v: number) => v)), make().map(launder((v: number) => -v)), make().map(launder((v: number) => String(v))));
  show(label + " filter", make().filter(launder(() => true)), make().filter(launder((v: number) => v !== v)), make().filter(launder((v: number) => Object.is(v, -0))), make().filter(launder(() => false)));
  show(label + " reduce", make().reduce(launder((all: unknown[], v: number, i: number) => (all.push(i, v), all)), [] as unknown[]));
  show(label + " reduceRight", make().reduceRight(launder((all: unknown[], v: number, i: number) => (all.push(i, v), all)), [] as unknown[]));
  show(label + " flatMap", make().flatMap(launder((v: number) => [v, v])));
  show(label + " every", make().every(launder((v: number) => typeof v === "number")), make().findIndex(launder((v: number) => v !== v)), make().findLastIndex(launder((v: number) => Object.is(v, -0))));
}
for (let kept = 0; kept <= 20; kept++) {
  const source = Array.from({ length: 24 }, (_, i) => i + 0.5);
  const result = launder(source).filter(launder((v: number) => v < kept));
  result.push(-1);
  show("kept " + kept, result.length, result[0], result[result.length - 2], result[result.length - 1], Object.keys(result).length);
}
const grown = launder([0.5, 1.5]).filter(launder(() => false));
grown[3] = 1; show("a store beyond the end of an empty result", grown, grown.length);
const named = launder([0.5]).filter(launder(() => false)) as number[] & { note?: string };
named.note = "kept"; named.push(1, 2, 3, 4, 5, 6, 7); show("names and elements on an empty result", named, named.note);
class Kept extends Array<number> {}
show("a derived class", Kept.from([0.5, 1.5]).filter(launder((v: number) => v > 1)) instanceof Kept, Kept.from([0.5, 1.5]).filter(launder(() => false)).length);
//// the-loops-of-the-library-count-in-integers.ts
// some | every | forEach | map | filter | find | findIndex | findLast | reduce | indexOf over arrays of every kind of storage and over objects that only look like arrays:
// the index that the callback gets, what happens when the callback changes the array under the loop, and lengths up to 2 ** 53 - 1, where the counter is no index any more.
const launder = new Function("v", process.env.LAUNDER_TEXT ?? "return v") as <V>(v: V) => V;
const show = (label: string, ...values: unknown[]) => console.log(label, values.map((v) => (Object.is(v, -0) ? "-0" : typeof v === "object" ? JSON.stringify(v) : String(v))).join(" | "));
type Test = (value: unknown, index: number, list: unknown) => unknown;

function all(label: string, make: () => unknown[], test: Test) {
  const seen: string[] = [];
  const spy: Test = (value, index, list) => { seen.push(typeof index + ":" + index); return test(value, index, list); };
  show(label + " some", make().some(launder(spy)), seen.join(","));
  seen.length = 0; show(label + " every", make().every(launder(spy)), seen.join(","));
  seen.length = 0; make().forEach(launder(spy)); show(label + " forEach", seen.join(","));
  seen.length = 0; show(label + " map", make().map(launder(spy)), seen.join(","));
  seen.length = 0; show(label + " filter", make().filter(launder(spy)), seen.join(","));
  seen.length = 0; show(label + " find", make().find(launder(spy)), seen.join(","));
  seen.length = 0; show(label + " findIndex", make().findIndex(launder(spy)), seen.join(","));
  seen.length = 0; show(label + " findLast", make().findLast(launder(spy)), seen.join(","));
  seen.length = 0; show(label + " reduce", make().reduce((sum: number, value, index) => { seen.push(String(index)); return sum + index; }, 0), seen.join(","));
}

all("int32", () => [1, 2, 3, 4], (v) => v === 3);
all("doubles", () => [0.5, 1.5, 2.5], (v) => (v as number) > 2);
all("boxed", () => ["a", {}, 3, null], (v) => v === null);
all("holes", () => [1, , 3, , 5], (v) => v === 5);
all("holes alone", () => new Array(3), () => true);
all("empty", () => [], () => true);
all("from unseen code", () => launder(JSON.parse("[1,2,3]")), (v) => v === 2);
all("grows under the loop", () => [1, 2, 3], (v, i, list) => { (list as unknown[]).push(i); return false; });
all("shrinks under the loop", () => [1, 2, 3, 4, 5], (v, i, list) => { (list as unknown[]).length = 3; return false; });
all("emptied under the loop", () => [1, 2, 3], (v, i, list) => { (list as unknown[]).length = 0; return false; });
all("turns to doubles under the loop", () => [1, 2, 3], (v, i, list) => { (list as unknown[])[2] = 0.5; return false; });
all("turns to boxed under the loop", () => [1, 2, 3], (v, i, list) => { (list as unknown[])[2] = "text"; return false; });
all("gets a hole under the loop", () => [1, 2, 3], (v, i, list) => { delete (list as unknown[])[2]; return false; });
all("becomes sparse under the loop", () => [1, 2, 3], (v, i, list) => { (list as unknown[])[100000] = 1; (list as unknown[]).length = 3; return false; });
all("gets an accessor under the loop", () => [1, 2, 3], (v, i, list) => { if (!i) Object.defineProperty(list, "2", { get() { return "got"; }, configurable: true }); return v === "got"; });
all("gets another prototype under the loop", () => [1, , 3], (v, i, list) => { Object.setPrototypeOf(list, { 1: "inherited", __proto__: Array.prototype }); return v === "inherited"; });

const methods = ["some", "every", "forEach", "map", "filter", "find", "findIndex", "indexOf", "includes", "lastIndexOf"] as const;
function onObject(label: string, make: () => object, limit: number) {
  for (const name of methods) {
    const seen: number[] = [];
    let result: unknown;
    try {
      const method = (Array.prototype as any)[name] as Function;
      result = name === "indexOf" || name === "includes" || name === "lastIndexOf"
        ? method.call(make(), "wanted")
        : method.call(make(), launder((value: unknown, index: number) => { seen.push(index); if (seen.length >= limit) { if (name === "every") return false; if (name === "forEach" || name === "map" || name === "filter") throw new Error("enough"); return true; } return name === "every"; }));
    } catch (error) { result = (error as Error).constructor.name + ": " + (error as Error).message; }
    show(label + " " + name, result, seen.join(","));
  }
}
onObject("three", () => ({ length: 3, 0: "a", 1: "wanted", 2: "c" }), 9);
onObject("length is text", () => ({ length: "2", 0: "a", 1: "wanted" }), 9);
onObject("length is a fraction", () => ({ length: 2.9, 0: "a", 1: "b", 2: "wanted" }), 9);
onObject("length is negative", () => ({ length: -5, 0: "wanted" }), 9);
onObject("length is NaN", () => ({ length: NaN, 0: "wanted" }), 9);
onObject("text", () => new String("abc"), 9);
onObject("typed array", () => new Uint8Array([1, 2, 3]), 9);
function early(label: string, length: number, keys: number[]) {
  const object: Record<string, unknown> = { length };
  for (const key of keys) object[key] = "at " + key;
  const seen: string[] = [];
  show(label, Array.prototype.find.call(launder(object), (value: unknown, index: number) => { seen.push(index + "=" + value); return seen.length === 3; }), seen.join(","));
  seen.length = 0;
  show(label + " from the end", Array.prototype.findLast.call(launder(object), (value: unknown, index: number) => { seen.push(index + "=" + value); return seen.length === 3; }), seen.join(","));
}
