console.log(caughtInLoop(new Uint8Array(4), 4, 1), "|", byName.caughtInLoop(new Uint8Array(4), 4, 7));
console.log(rows(new Uint8Array(6), 2, 3, 5), "|", byName.rows(new Uint8Array(6), 2, 3, 1), "|", rows(new Uint8Array(4), 2, 3, 9));
