function use4(text: string, round: number): string {
  const many: string[] = [text, text];
  const loose = many as any;
  function* steps(): Generator<string, void, unknown> {
    const before = new Point(round, 8);
    yield "";
    const answer = (() => {
      try {
        return (1.5).toFixed(loose[0]);
      } catch (error) {}
