async function outcomeOf(run: () => Promise<unknown>, withTicks: boolean): Promise<string> {
  const ticker = withTicks ? startTicker() : null;
  let outcome: string;
  try {
    outcome = "gives " + describe(await run());
  } catch (error) {
    outcome = "rejects with " + describe(error);
  }
  if (!ticker) return outcome;
  ticker.isOn = false;
  return outcome + " after " + ticker.count + " ticks";
}
async function runAwaited(withTicks: boolean): Promise<void> {
  lines.push(withTicks ? "== awaited, beside other jobs" : "== awaited, alone");
  for (const [label, , awaited, guarded, gathered] of rows) {
    lines.push(label + ", awaited twice: " + (await outcomeOf(() => awaited(4), withTicks)));
    lines.push(label + ", awaited in a try: " + (await outcomeOf(() => guarded(6), withTicks)));
    lines.push(label + ", in Promise.all: " + (await outcomeOf(() => gathered(8), withTicks)));
  }
}
async function runKept(): Promise<void> {
  lines.push("== the promise is kept");
  for (const [label, call] of rows) {
    const promise = call(10);
    const ticker = startTicker();
    const isOrdinary = promise instanceof Promise && Object.getPrototypeOf(promise) === Promise.prototype;
    const outcome = await new Promise<string>(resolve => {
      promise.then(
        value => resolve("fulfilled with " + describe(value) + " at tick " + ticker.count),
        error => resolve("rejected with " + describe(error) + " at tick " + ticker.count),
      );
    });
    ticker.isOn = false;
    lines.push(label + ", then(): " + (isOrdinary ? "an ordinary promise, " : "NO ORDINARY PROMISE, ") + outcome);

    const late = call(12);
    for (let turn = 0; turn < 6; turn++) await settled;
    lines.push(label + ", awaited six turns later: " + (await outcomeOf(() => late, true)));

    const two = [call(14), call(14)];
    lines.push(label + ", two calls: " + (two[0] === two[1] ? "THE SAME PROMISE" : "two promises") + ", " + (await outcomeOf(() => Promise.allSettled(two), false)));
  }
}
async function runDropped(): Promise<void> {
  lines.push("== nobody takes the promise");
  for (const [label, call] of rows) {
    lines.push(label + ":");
    const promise = call(16);
    namesOfPromises.set(promise, "the promise of the call");
    await afterTimer();
    promise.catch(ignore);
    namesOfPromises.delete(promise);
  }
}

////= lines	returnsTheCall	n	number	number	givesANumber
async function waitsAndReturnsTheCall(n: number): Promise<number> {
  await settled;
  return givesANumber(n);
}
async function waitsAndReturnsACallThatThrows(n: number): Promise<number> {
  await settled;
  return throwsAnError(n);
}
async function awaitsEither(n: number): Promise<unknown> {
  return await (n % 2 ? givesANumber(n) : givesAString(n));
}
async function awaitsEitherOrAValue(n: number): Promise<unknown> {
  return await (n % 2 ? givesARecord(n) : n);
}
async function awaitsNestedCalls(n: number): Promise<number> {
  return await givesANumber(await givesANumber(await givesANumber(n)));
}
async function awaitsInAFinally(n: number): Promise<string> {
  let text = "";
  try {
    text += await throwsAnError(n);
  } catch (error) {
    text += caught(error) + ", " + (await givesAString(n));
  } finally {
    text += ", " + (await givesANumber(n));
  }
  return text;
}
async function throwsPastItsFinally(n: number): Promise<number> {
  try {
    return await throwsAnError(n);
  } finally {
    lines.push("  the finally of the caller runs");
  }
}
async function runOtherWays(withTicks: boolean): Promise<void> {
  lines.push(withTicks ? "== other ways to call, beside other jobs" : "== other ways to call, alone");
  const ways: [label: string, run: () => Promise<unknown>][] = [
    ["call()", () => givesANumber.call(null, 1)],
    ["apply()", () => givesANumber.apply(null, [2])],
    ["bind()", () => givesANumber.bind(null, 3)()],
    ["Reflect.apply()", () => Reflect.apply(givesANumber, undefined, [4])],
    ["awaited call()", async () => await givesANumber.call(null, 5)],
    ["a callback of map", () => Promise.all([1, 2, 3].map(givesANumber))],
    ["a callback of map that reads arguments", () => Promise.all([1, 2].map(readsArguments))],
    ["a then handler", () => settled.then(() => 6).then(givesANumber)],
    ["a then handler that throws", () => settled.then(() => 7).then(throwsAnError)],
    ["a catch handler", () => Promise.reject(8).catch(givesANumber)],
    ["a finally handler", () => Promise.resolve(9).finally(() => givesAString(9))],
    ["a finally handler that throws", () => Promise.resolve(10).finally(() => throwsAnError(10))],
    ["race", () => Promise.race([givesANumber(11), givesAString(11)])],
    ["race with one that waits", () => Promise.race([waitsOnce(12), givesAString(12)])],
    ["allSettled", () => Promise.allSettled([throwsAnError(13), givesANumber(13), givesAThenable(13)])],
    ["any", () => Promise.any([throwsAnError(14), givesARejectedPromise(14), givesANumber(14)])],
    ["Promise.resolve of the call", () => Promise.resolve(givesANumber(15))],
    ["returned by a function that never awaits", () => returnsTheCall(16)],
    ["returned by a function that has waited", () => waitsAndReturnsTheCall(17)],
    ["a call that throws, returned by a function that has waited", () => waitsAndReturnsACallThatThrows(18)],
    ["one of two calls, the first", () => awaitsEither(19)],
    ["one of two calls, the second", () => awaitsEither(20)],
    ["a call or a value, the call", () => awaitsEitherOrAValue(21)],
    ["a call or a value, the value", () => awaitsEitherOrAValue(22)],
    ["calls in the arguments of calls", () => awaitsNestedCalls(23)],
    ["calls in try, catch and finally", () => awaitsInAFinally(24)],
    ["a call that throws past a finally", () => throwsPastItsFinally(25)],
    ["a string for a number", async () => await givesANumber("26" as any)],
    ["a symbol for a number", async () => await givesAString(Symbol("27") as any)],
    ["a bigint for a number", async () => await givesANumber(28n as any)],
    ["a thenable for a number", async () => await awaitsOnlyWhenAsked(thenableFor(29) as any, false)],
    ["a method on another object", async () => await service.read.call({ base: "base " } as any, 30)],
    ["a method on null", async () => await service.read.call(null as any, 31)],
    ["a private method on another object", async () => await service.open.call({ base: 1 } as any, 32)],
    ["new", async () => new (givesANumber as any)(33)],
  ];
  for (const [label, run] of ways) lines.push(label + ": " + (await outcomeOf(run, withTicks)));
}

function runProperties(): void {
  lines.push("== what the functions are");
  const asyncFunctionPrototype: object = Object.getPrototypeOf(waitsOnce);
  const functions: [label: string, f: Function][] = [
    ["declared", givesANumber],
    ["with a default", throwsInItsHead],
    ["with a rest", takesARest],
    ["an arrow function", arrow],
    ["a method", service.read],
    ["a static method", Service.fixed],
    ["a member of a literal", literal.member],
    ["a closure", closure],
  ];
  for (const [label, f] of functions) {
    lines.push(
      label + ": " + [typeof f, JSON.stringify(f.name), f.length, Object.getPrototypeOf(f) === asyncFunctionPrototype, Object.prototype.toString.call(f), "prototype" in f, Object.getOwnPropertyNames(f).sort().join("+")].join(" "),
    );
  }
}

////= lines-25	makesAnError	Error	return	Error	"made "
////= lines	makesItBelow	n	number	Error	makesAnError
// Not `return new Error(..)`: plain Bun's transpiler writes that as `return Error(..)`, a proper tail call, which takes the frame of this function out of the trace.
let lastMade: Error | undefined;
function makesItInAPlainFunction(n: number): Error {
  const made = new Error("made in a plain function " + n);
  lastMade = made;
  return made;
}
////= lines	makesItThroughAPlainFunction	n	number	Error	makesItInAPlainFunction
////= lines	throwsItBelow	n	number	number	raise
class Maker {
  async make(n: number): Promise<Error> {
    return new Error("made by a method " + n);
  }
}
const maker = new Maker();
// Each caller makes its call either before it has ever been suspended, on the stack of its own caller, or behind an await, entered by a job.
////= lines-15	awaitsWhatIsMade	makesAnError	1
////= lines-15	awaitsWhatIsMadeBelow	makesItBelow	2
////= lines-15	awaitsWhatAPlainFunctionMakes	makesItThroughAPlainFunction	3
async function awaitsWhatAMethodMakes(waitsFirst: boolean): Promise<unknown> {
  if (waitsFirst) await settled;
  return await maker.make(4);
}
////= lines-5	catchesWhatIsThrown	throwsAnError	5
////= lines-5	catchesWhatIsThrownBelow	throwsItBelow	6
////= lines-5	catchesWhatTheHeadThrows	throwsInItsHead	7
async function keepsThePromiseFirst(waitsFirst: boolean): Promise<unknown> {
  if (waitsFirst) await settled;
  const kept = makesAnError(8);
  return await kept;
}
async function returnsThePromise(waitsFirst: boolean): Promise<unknown> {
  if (waitsFirst) await settled;
  return makesAnError(9);
}
async function gathersWhatIsMade(waitsFirst: boolean): Promise<unknown> {
  if (waitsFirst) await settled;
  const [first] = await Promise.all([makesAnError(10), waitsOnce(10)]);
  return first;
}
const stackCases: [label: string, run: (waitsFirst: boolean) => Promise<unknown>][] = [
  ["made", awaitsWhatIsMade],
  ["made a call below", awaitsWhatIsMadeBelow],
  ["made in a plain function", awaitsWhatAPlainFunctionMakes],
  ["made by a method", awaitsWhatAMethodMakes],
  ["thrown", catchesWhatIsThrown],
  ["thrown a call below", catchesWhatIsThrownBelow],
  ["thrown in the head", catchesWhatTheHeadThrows],
  ["the promise is kept first", keepsThePromiseFirst],
  ["the promise is returned", returnsThePromise],
  ["in Promise.all", gathersWhatIsMade],
];
async function collectsStacks(): Promise<void> {
  for (const waitsFirst of [false, true]) {
    for (const [label, run] of stackCases) lines.push(label + (waitsFirst ? ", behind an await of the caller: " : ", before the caller has waited: ") + names(await run(waitsFirst)));
  }
}
////= lines-16	callsTheCollector	collectsStacks

async function sums(rounds: number): Promise<number> {
  let sum = 0;
  for (let i = 0; i < rounds; i++) sum += await givesANumber(i);
  return sum;
}
async function sumsOfSeveralKinds(rounds: number): Promise<string> {
  let sum = 0;
  let failures = 0;
  for (let i = 0; i < rounds; i++) {
    sum += (await givesAnInstance(i)).y + (await givesARecord(i)).n + (await service.read(i)) + (await givesAString(i)).length;
    try {
      sum += await throwsForOddNumbers(i);
    } catch {
      failures++;
    }
  }
  return sum + " and " + failures + " failures";
}

for (const withTicks of [false, true, false, true]) await runAwaited(withTicks);
await runKept();
await runDropped();
for (const withTicks of [false, true]) await runOtherWays(withTicks);
runProperties();
lines.push("== stacks");
await callsTheCollector();
lines.push("== loops");
for (const withTicks of [false, true]) {
  lines.push("20000 awaited calls" + (withTicks ? ", beside other jobs: " : ", alone: ") + (await outcomeOf(() => sums(20_000), withTicks)));
  lines.push("2000 rounds of several kinds" + (withTicks ? ", beside other jobs: " : ", alone: ") + (await outcomeOf(() => sumsOfSeveralKinds(2_000), withTicks)));
}
await afterTimer();
lines.push("touched " + touched);
console.log(lines.join("\n"));

export {};
//// async-generator-asked-again-while-stepped.ts
// While `for await` or `yield*` of the program steps an async generator, the generator is asked again: by its own body, which calls its own next(), return() or throw(), once or several
// times, at the first step or at a later one, ahead of an await or behind it, and then goes on, throws or returns; by a second loop that joins in the middle of the stream; by hand from the
// loop's own body; by a job from outside while the body waits. Every request queues behind the step in progress and is answered in its turn, and the loop gets what is left.
// Beside every run a chain of `then` callbacks notes the turns of the job queue.
type Numbers = AsyncGenerator<number, unknown, unknown>;
type Ask = (self: Numbers) => void;
interface Cell { self?: Numbers; }
let log: string[] = [];
let answers: Promise<void>[] = [];
const out: string[] = [];
////= note
function show(value: unknown): string {
    if (value instanceof Error) return value.name + "(" + value.message + ")";
    if (typeof value === "object" && value !== null) return JSON.stringify(value);
    return String(value);
}
////= ticker-3
// Runs in the job of that turn.
function runInTurn(turn: number, run: () => void): void {
    let last: Promise<void> = Promise.resolve();
    for (let i = 1; i < turn; i++) last = last.then(() => undefined);
    answers.push(last.then(run));
}
function watch(label: string, request: Promise<IteratorResult<number, unknown>>): void {
    answers.push(request.then(result => note(label + " is answered " + show(result)), error => note(label + " is rejected " + show(error))));
}

async function* asksItself(cell: Cell, at: number, ask: Ask, where: string, catches: boolean): Numbers {
    try {
        for (let i = 0; i < 5; i++) {
            if (i === at) {
                if (where === "behind an await") await null;
                if (where === "behind a wait") await outside();
                note("the body asks");
                ask(cell.self!);
                note("the body has asked");
                if (where === "ahead of an await") await null;
                if (where === "ahead of a wait") await outside();
                if (where === "and then throws") throw new RangeError("thrown behind the requests");
                if (where === "and then returns") return "returned behind the requests";
            }
            note("yields " + i);
            const sent = yield i;
            note("behind yield " + i + (sent === undefined ? "" : ", was sent " + show(sent)));
        }
        return "the end";
    } catch (error) {
        if (!catches) throw error;
        note("the body caught " + show(error));
        yield -1;
        return "the end behind the catch";
    } finally {
        note("the body's finally");
    }
}
function makeAsking(at: number, ask: Ask, where: string, catches: boolean): Numbers {
    const cell: Cell = {};
    return (cell.self = asksItself(cell, at, ask, where, catches));
}
async function* counts(n: number): Numbers {
    try {
        for (let i = 0; i < n; i++) { note("yields " + i); yield i; }
        return "the end";
    } finally {
        note("the producer's finally");
    }
}
async function* waitsAheadOfEachYield(n: number): Numbers {
    try {
        for (let i = 0; i < n; i++) { note("waits " + i); await outside(); note("yields " + i); yield i; }
        return "the end";
    } finally {
        note("the producer's finally");
    }
}
async function* relays(label: string, source: Numbers): Numbers {
    for await (const x of source) { note(label + " relays " + x); yield x; }
    note(label + " ends");
    return label + "'s end";
}
async function* forwards(label: string, source: Numbers): Numbers {
    const returned = yield* source;
    note(label + " was returned " + show(returned));
    return label + "'s end";
}

async function consumes(label: string, source: Numbers, isResumedFirst: boolean): Promise<void> {
    if (isResumedFirst) await null;
    try {
        for await (const x of source) note(label + " got " + x);
        note(label + " is through");
    } catch (error) {
        note(label + " caught " + show(error));
    }
}
async function consumesAndCalls(label: string, source: Numbers, at: number, call: () => void): Promise<void> {
    await null;
    try {
        for await (const x of source) {
            note(label + " got " + x);
            if (x === at) { call(); note(label + " has called"); }
        }
        note(label + " is through");
    } catch (error) {
        note(label + " caught " + show(error));
    }
}
async function consumesAfter(label: string, gate: Promise<void>, source: Numbers): Promise<void> {
    await gate;
    for await (const x of source) note(label + " got " + x);
    note(label + " is through");
}
async function consumesOne(label: string, source: Numbers): Promise<void> {
    for await (const x of source) { note(label + " got " + x + " and leaves"); break; }
    note(label + " is through");
}

async function scene(title: string, start: () => Promise<void>[]): Promise<void> {
    for (const company of ["alone", "behind jobs", "ahead of jobs"]) {
        log = [];
        answers = [];
        const all: Promise<void>[] = [];
        if (company === "behind jobs") all.push(ticker("t", 14));
        all.push(...start());
        note("back in the scene");
        if (company === "ahead of jobs") all.push(ticker("t", 14));
        await Promise.all(all);
        // A request may start another one.
        for (let seen = 0; seen < answers.length; ) { seen = answers.length; await Promise.all(answers); }
        out.push(title + ", " + company + ": " + log.join(" | "));
    }
}

const asks: [string, Ask][] = [
    ["next", self => watch("next", self.next())],
    ["next with a value", self => watch("next", self.next("a word"))],
    ["return", self => watch("return", self.return("returned"))],
    ["return of a promise", self => watch("return", self.return(Promise.resolve("returned by a promise")))],
    ["return of a rejected promise", self => watch("return", self.return(Promise.reject(new RangeError("the returned promise is rejected"))))],
    ["throw", self => watch("throw", self.throw(new RangeError("thrown in")))],
    ["next twice", self => { watch("first", self.next()); watch("second", self.next("second word")); }],
    ["next, return, next", self => { watch("first", self.next()); watch("return", self.return("returned")); watch("last", self.next()); }],
    ["throw, next", self => { watch("throw", self.throw(new RangeError("thrown in"))); watch("next", self.next()); }],
    ["return twice", self => { watch("first", self.return("once")); watch("second", self.return("twice")); }],
    ["six times next", self => { for (let i = 0; i < 6; i++) watch("next " + i, self.next(i)); }],
];
for (const [kind, ask] of asks) {
    for (const at of [0, 2]) {
        const title = "the body asks for " + kind + " at step " + at;
        for (const where of ["", "ahead of an await", "behind an await", "ahead of a wait", "behind a wait", "and then throws", "and then returns"])
            await scene(title + (where && ", " + where), () => [consumes("a", makeAsking(at, ask, where, false), true)]);
        await scene(title + ", and catches", () => [consumes("a", makeAsking(at, ask, "", true), true)]);
        await scene(title + ", the loop in its first run", () => [consumes("a", makeAsking(at, ask, "", false), false)]);
        await scene(title + ", under for await", () => [consumes("a", relays("r", makeAsking(at, ask, "", false)), true)]);
        await scene(title + ", under yield*", () => [consumes("a", forwards("f", makeAsking(at, ask, "", true)), true)]);
    }
}

await scene("a second loop joins in its first run", () => {
    const shared = counts(7);
    return [consumesAndCalls("a", shared, 2, () => answers.push(consumes("b", shared, false)))];
});
await scene("a second loop joins behind an await", () => {
    const shared = counts(7);
    return [consumesAndCalls("a", shared, 2, () => answers.push(consumes("b", shared, true)))];
});
await scene("a second loop that has waited joins", () => {
    const shared = counts(7);
    const gate = Promise.withResolvers<void>();
    return [consumesAfter("b", gate.promise, shared), consumesAndCalls("a", shared, 2, () => gate.resolve())];
});
await scene("a second loop joins, takes one and leaves", () => {
    const shared = counts(7);
    return [consumesAndCalls("a", shared, 2, () => answers.push(consumesOne("b", shared)))];
});
await scene("a second loop joins through a generator", () => {
    const shared = counts(7);
    return [consumesAndCalls("a", shared, 2, () => answers.push(consumes("b", relays("r", shared), true)))];
});
await scene("a second and a third loop join", () => {
    const shared = counts(9);
    return [consumesAndCalls("a", shared, 1, () => { answers.push(consumes("b", shared, false)); answers.push(consumes("c", forwards("f", shared), false)); })];
});
await scene("two loops from the start", () => {
    const shared = counts(6);
    return [consumes("a", shared, true), consumes("b", shared, true)];
});
await scene("two loops from the start over a generator that waits", () => {
    const shared = waitsAheadOfEachYield(4);
    return [consumes("a", shared, true), consumes("b", shared, false)];
});
const byHand: [string, Ask][] = [
    ["next", self => watch("by hand", self.next())],
    ["next three times", self => { for (let i = 0; i < 3; i++) watch("by hand " + i, self.next()); }],
    ["return", self => watch("by hand", self.return("enough"))],
    ["throw", self => watch("by hand", self.throw(new RangeError("thrown by hand")))],
    ["return, next", self => { watch("return", self.return("enough")); watch("next", self.next()); }],
];
for (const [kind, ask] of byHand) {
    await scene("the loop's body asks for " + kind, () => {
        const shared = counts(6);
        return [consumesAndCalls("a", shared, 2, () => ask(shared))];
    });
    await scene("the loop's body asks the end of its chain for " + kind, () => {
        const shared = counts(6);
        return [consumesAndCalls("a", relays("s", forwards("f", shared)), 2, () => ask(shared))];
    });
    for (const turn of [1, 2, 3, 4, 6]) {
        await scene("a job in turn " + turn + " asks for " + kind + " while the body waits", () => {
            const shared = waitsAheadOfEachYield(4);
            runInTurn(turn, () => { note("the job asks"); ask(shared); });
            return [consumes("a", shared, true)];
        });
        await scene("a job in turn " + turn + " asks for " + kind, () => {
            const shared = counts(4);
            runInTurn(turn, () => { note("the job asks"); ask(shared); });
            return [consumes("a", shared, true)];
        });
    }
}
console.log(out.join("\n"));
export {};
//// async-generator-body-throws-while-stepped.ts
// The body of an async generator throws while `for await` or `yield*` of the program steps it: ahead of the first yield, between yields, behind an await that goes on in place and behind
// one that waits, in a finally at the end of the stream and in a finally that a `break` or a throw of the loop's body runs. What is thrown: an error, undefined, null, zero, a thenable, a
// promise, an iterator result. The loop stands in a try, in a catch, in a finally, under a finally alone and under no handler at all, in an async function and in an async generator.
// A chain of `then` callbacks beside every run shows in which turn of the job queue the handler runs. Afterwards the generator is completed: next(), return() and throw() say so.
// At the end: generators that recurse until the stack is full, and a thousand streams in a row that end in a throw.
type Numbers = AsyncGenerator<number, any, unknown>;
type Consumer = (label: string, source: Numbers) => Promise<unknown>;
let log: string[] = [];
const out: string[] = [];
////= note
function show(value: unknown): string {
    if (value instanceof Error) return value.name + "(" + value.message + ")";
    if (value instanceof Promise) return "a promise";
    if (typeof value === "object" && value !== null) return JSON.stringify(value);
    return typeof value + " " + String(value);
}
////= ticker-3
const anError = (): unknown => new RangeError("thrown by the producer");

async function* throwsAt(at: number, make: () => unknown, where: string): Numbers {
    note("the producer starts");
    for (let i = 0; ; i++) {
        if (i === at) {
            if (where === "behind an await") await null;
            if (where === "behind a wait") await outside();
            note("the producer throws");
            throw make();
        }
        note("yields " + i);
        yield i;
    }
}
async function* throwsInFinally(n: number, where: string): Numbers {
    try {
        for (let i = 0; i < n; i++) { note("yields " + i); yield i; }
    } finally {
        if (where === "behind an await") await null;
        if (where === "behind a wait") await outside();
        note("the finally throws");
        throw new RangeError("thrown in the finally");
    }
}
async function* throwsThroughFinally(at: number): Numbers {
    try {
        try {
            for (let i = 0; ; i++) { if (i === at) throw new RangeError("thrown under two finallys"); yield i; }
        } finally {
            note("the inner finally");
            await null;
            note("the inner finally goes on");
        }
    } finally {
        note("the outer finally");
        await outside();
        note("the outer finally goes on");
    }
}
async function* throwsInACall(at: number): Numbers {
    const fail = (depth: number): number => { if (depth === 0) throw new RangeError("thrown three calls down"); return fail(depth - 1) + 1; };
    for (let i = 0; ; i++) yield i === at ? fail(3) : i;
}
async function* passesOn(label: string, source: Numbers): Numbers {
    try {
        for await (const x of source) { note(label + " relays " + x); yield x; }
    } finally {
        note(label + "'s finally");
        await null;
        note(label + "'s finally goes on");
    }
}
async function* catchesAndGoesOn(label: string, source: Numbers): Numbers {
    try {
        for await (const x of source) yield x;
    } catch (error) {
        note(label + " caught " + show(error));
        yield -1;
        note(label + " goes on");
    }
    yield -2;
}
async function* throwsSomethingElse(label: string, source: Numbers): Numbers {
    try {
        for await (const x of source) yield x;
    } catch (error) {
        note(label + " caught " + show(error));
        throw new TypeError("thrown by " + label + " in its place");
    }
}
async function* forwards(source: Numbers): Numbers {
    return yield* source;
}
async function* forwardsAndCatches(label: string, source: Numbers): Numbers {
    try {
        yield* source;
    } catch (error) {
        note(label + " caught " + show(error));
        yield -1;
    }
}

async function inATry(label: string, source: Numbers): Promise<void> {
    await null;
    try {
        for await (const x of source) note(label + " got " + x);
        note(label + " is through");
    } catch (error) {
        note(label + " caught " + show(error));
    } finally {
        note(label + "'s finally");
    }
}
async function inATryInItsFirstRun(label: string, source: Numbers): Promise<void> {
    try {
        for await (const x of source) note(label + " got " + x);
        note(label + " is through");
    } catch (error) {
        note(label + " caught " + show(error));
    } finally {
        note(label + "'s finally");
    }
}
async function inACatch(label: string, source: Numbers): Promise<void> {
    await null;
    try {
        throw new Error("the first error");
    } catch (first) {
        try {
            for await (const x of source) note(label + " got " + x);
            note(label + " is through");
        } catch (error) {
            note(label + " caught " + show(error) + " while it handled " + show(first));
        }
    }
}
async function inAFinally(label: string, source: Numbers): Promise<string> {
    await null;
    try {
        return label + " returned from its try";
    } finally {
        try {
            for await (const x of source) note(label + " got " + x);
            note(label + " is through");
        } catch (error) {
            note(label + " caught " + show(error));
        }
    }
}
async function underAFinallyAlone(label: string, source: Numbers): Promise<void> {
    await null;
    try {
        for await (const x of source) note(label + " got " + x);
        note(label + " is through");
    } finally {
        note(label + "'s finally");
        await null;
        note(label + "'s finally goes on");
    }
}
async function underNoHandler(label: string, source: Numbers): Promise<void> {
    await null;
    for await (const x of source) note(label + " got " + x);
    note(label + " is through");
}
async function inTwoLoops(label: string, source: Numbers): Promise<void> {
    await null;
    for (let round = 0; round < 2; round++) {
        try {
            for await (const x of source) note(label + " got " + x + " in round " + round);
            note(label + " is through round " + round);
        } catch (error) {
            note(label + " caught " + show(error) + " in round " + round);
        }
    }
}
////= lines-37	leavesAtOne	break
////= lines-37	throwsAtOne	throw new Error("thrown by the loop's body")
async function awaitedByAnother(label: string, source: Numbers): Promise<void> {
    await null;
    try {
        await underNoHandler(label, source);
        note(label + "'s caller goes on");
    } catch (error) {
        note(label + "'s caller caught " + show(error));
    }
}

async function afterwards(source: Numbers): Promise<void> {
    note("afterwards next " + show(await source.next()));
    note("return " + show(await source.return("asked to return")));
    try {
        note("throw " + show(await source.throw(new Error("thrown at a completed generator"))));
    } catch (error) {
        note("throw gave back " + show(error));
    }
    note("next " + show(await source.next()));
}
async function scene(title: string, consume: Consumer, make: () => Numbers): Promise<void> {
    for (const company of ["alone", "behind jobs", "ahead of jobs"]) {
        log = [];
        const source = make();
        const ahead = company === "behind jobs" ? ticker("t", 12) : undefined;
        const ended = consume("a", source).then(value => note("a's promise is fulfilled with " + show(value)), error => note("a's promise is rejected with " + show(error)));
        note("back in the scene");
        const behind = company === "ahead of jobs" ? ticker("t", 12) : undefined;
        await ended;
        await ahead;
        await behind;
        await afterwards(source);
        out.push(title + ", " + company + ": " + log.join(" | "));
    }
}

const consumers: [string, Consumer][] = [
    ["in a try", inATry],
    ["in a try, in its first run", inATryInItsFirstRun],
    ["in a catch", inACatch],
    ["in a finally", inAFinally],
    ["under a finally alone", underAFinallyAlone],
    ["under no handler", underNoHandler],
    ["in two loops", inTwoLoops],
    ["awaited by another function", awaitedByAnother],
];
for (const [how, consume] of consumers) {
    for (const at of [0, 2]) {
        for (const where of ["", "behind an await", "behind a wait"])
            await scene("thrown at step " + at + (where && ", " + where) + ", the loop " + how, consume, () => throwsAt(at, anError, where));
    }
    await scene("thrown through two finallys, the loop " + how, consume, () => throwsThroughFinally(1));
    await scene("thrown three calls down, the loop " + how, consume, () => throwsInACall(1));
    await scene("thrown in the finally at the end, the loop " + how, consume, () => throwsInFinally(2, ""));
}

const thrown: [string, () => unknown][] = [
    ["undefined", () => undefined],
    ["null", () => null],
    ["zero", () => 0],
    ["a string", () => "a word"],
    ["a record", () => ({ code: 7 })],
    ["a thenable", () => ({ then(resolve: (value: string) => void): void { note("THE THROWN THENABLE IS ASKED"); resolve("adopted"); } })],
    ["a promise", () => Promise.resolve("inside")],
    ["an iterator result of the engine", () => [7][Symbol.iterator]().next()],
    ["an iterator result that says done", () => [][Symbol.iterator]().next()],
    ["something that looks like an iterator result", () => ({ value: 8, done: false })],
];
for (const [what, make] of thrown) {
    for (const at of [0, 1]) {
        await scene(what + " thrown at step " + at, inATry, () => throwsAt(at, make, ""));
        await scene(what + " thrown at step " + at + " under for await", inATry, () => passesOn("r", throwsAt(at, make, "")));
        await scene(what + " thrown at step " + at + " under yield*", underNoHandler, () => forwards(throwsAt(at, make, "")));
    }
}

for (const where of ["", "behind an await", "behind a wait"]) {
    const title = "a finally that throws" + (where && " " + where);
    await scene(title + ", over nothing", inATry, () => throwsInFinally(0, where));
    await scene(title + ", at the end", inATry, () => throwsInFinally(2, where));
    await scene(title + ", at the end, under no handler", underNoHandler, () => throwsInFinally(1, where));
    await scene(title + ", at a break", leavesAtOne, () => throwsInFinally(4, where));
    await scene(title + ", at a throw of the loop's body", throwsAtOne, () => throwsInFinally(4, where));
    await scene(title + ", at a break, under for await", leavesAtOne, () => passesOn("r", throwsInFinally(4, where)));
    await scene(title + ", at a break, under yield*", leavesAtOne, () => forwards(throwsInFinally(4, where)));
}

const chains: [string, () => Numbers][] = [
    ["for await passes it on", () => passesOn("r", throwsAt(1, anError, ""))],
    ["two pass it on", () => passesOn("s", passesOn("r", throwsAt(1, anError, "")))],
    ["two pass on what is thrown at once", () => passesOn("s", passesOn("r", throwsAt(0, anError, "")))],
    ["two pass on what is thrown behind a wait", () => passesOn("s", passesOn("r", throwsAt(1, anError, "behind a wait")))],
    ["yield* passes it on", () => forwards(throwsAt(1, anError, ""))],
    ["yield* twice", () => forwards(forwards(throwsAt(1, anError, "behind an await")))],
    ["the middle catches and goes on", () => passesOn("s", catchesAndGoesOn("r", throwsAt(1, anError, "")))],
    ["the middle catches what is thrown at once", () => passesOn("s", catchesAndGoesOn("r", throwsAt(0, anError, "")))],
    ["the middle catches under yield*", () => forwards(forwardsAndCatches("f", throwsAt(1, anError, "")))],
    ["the middle throws something else", () => passesOn("s", throwsSomethingElse("r", throwsAt(1, anError, "")))],
    ["the top catches", () => catchesAndGoesOn("s", passesOn("r", throwsThroughFinally(1)))],
];
for (const [title, make] of chains) {
    for (const [how, consume] of [consumers[0], consumers[1], consumers[5]]) await scene(title + ", the loop " + how, consume, make);
}

// Each body steps another generator of its kind until the stack is full: the last step finds no room for the body it has already asked. How deep that is differs from one way of running
// the program to the other, and so does the number of turns the error takes on its way up, so no turns are noted here.
async function* recursesWithForAwait(): Numbers {
    for await (const x of recursesWithForAwait()) yield x;
}
async function* recursesWithYieldStar(): Numbers {
    yield* recursesWithYieldStar();
}
async function fillsTheStack(source: Numbers, isResumedFirst: boolean): Promise<string> {
    if (isResumedFirst) await null;
    try {
        for await (const x of source) note("GOT " + x);
        return "the loop is through";
    } catch (error) {
        return "caught " + (error instanceof RangeError ? "a RangeError" : show(error)) + ", afterwards next " + show(await source.next());
    }
}
for (const isResumedFirst of [true, false]) {
    const how = isResumedFirst ? "" : ", the loop in its first run";
    out.push("for await until the stack is full" + how + ": " + (await fillsTheStack(recursesWithForAwait(), isResumedFirst)));
    out.push("yield* until the stack is full" + how + ": " + (await fillsTheStack(recursesWithYieldStar(), isResumedFirst)));
}

// Many streams that end in a throw, one behind the other and all in place: what one leaves behind would show in the next.
async function countsCaught(rounds: number): Promise<string> {
    await null;
    let sum = 0, caught = 0;
    for (let round = 0; round < rounds; round++) {
        try {
            for await (const x of quietlyThrowsAt(round % 5)) sum += x;
        } catch (error) {
            if (error instanceof RangeError) caught++;
        }
    }
    return "sum " + sum + ", caught " + caught;
}
async function* quietlyThrowsAt(at: number): Numbers {
    for (let i = 0; ; i++) { if (i === at) throw new RangeError("quietly"); yield i; }
}
out.push("a thousand streams that end in a throw: " + (await countsCaught(1000)));
console.log(out.join("\n"));
export {};
//// async-generator-delegates-to-sync.ts
// `yield*` in an async generator over what is only sync iterable: arrays, sets, maps, sync generators of the program, iterators written by hand:
// empty, of one, of several; what they return; what next(v), throw(e) and return(v) of the outer generator hand to the inner one; elements that are promises
// (fulfilled, pending, rejected), thenables, records; inner iterators that throw; alone, resumed behind a wait, and beside other jobs with a ticker that shows every turn.
let log: string[] = [];
////= note-2
function rejected(text: string): Promise<never> {
    const promise = Promise.reject(new Error(text));
    promise.catch(() => undefined);
    return promise;
}
const thenable = { then(resolve: (value: string) => void): void { note("then is called"); resolve("from then"); } };
function* nothing(): Generator<never, string> { note("nothing runs"); return "nothing returned"; }
function* one(): Generator<string, string> { yield "only"; return "one returned"; }
function* three(): Generator<number, number> { let t = 0; for (let i = 1; i <= 3; i++) { yield i; t += i; } return t; }
function* listens(): Generator<string, string, unknown> {
    const first = yield "say something";
    const second = yield "heard " + JSON.stringify(first);
    return "last heard " + JSON.stringify(second);
}
function* cleansUp(): Generator<number, string> {
    try { yield 1; yield 2; return "ran through"; } catch (error) { note("inner caught " + (error as Error).message); yield 99; return "behind the catch"; } finally { note("inner finally"); }
}
function* throwsAtOnce(): Generator<number> { throw new Error("thrown at once"); }
function* throwsLater(): Generator<number> { yield 1; throw new Error("thrown later"); }
function* queuesAJob(): Generator<number> { Promise.resolve().then(() => note("the inner one's job")); yield 1; yield 2; }
function* yieldsPromises(): Generator<unknown> { yield Promise.resolve("fulfilled"); yield outside().then(() => "was pending"); yield thenable; yield { n: 1 }; }
function* yieldsARejection(): Generator<unknown> { try { yield 1; yield rejected("rejected element"); yield 3; } finally { note("inner finally"); } }
function byHand(steps: unknown[]): Iterable<unknown> {
    let i = 0;
    return { [Symbol.iterator]() { return { next(...sent: unknown[]) { note("next with " + sent.length + " arguments"); return i < steps.length ? { value: steps[i++], done: false } : { value: "by hand is over", done: true }; } }; } };
}
////= kinds
async function* delegates(make: () => Iterable<unknown>): AsyncGenerator<unknown, string, unknown> {
    note("outer begins");
    const returned = yield* make();
    note("inner returned " + JSON.stringify(returned));
    return "outer is over";
}
async function* delegatesTwice(make: () => Iterable<unknown>): AsyncGenerator<unknown, string, unknown> {
    const first = yield* make();
    const second = yield* make();
    return JSON.stringify(first) + " and " + JSON.stringify(second);
}
async function* delegatesBehindAWait(make: () => Iterable<unknown>): AsyncGenerator<unknown, string, unknown> {
    await outside();
    const returned = yield* make();
    await outside();
    return "behind the waits " + JSON.stringify(returned);
}
////= byLoop
////= byNext
async function thrownInto(source: AsyncGenerator<unknown, string, unknown>): Promise<void> {
    try {
        note("first " + JSON.stringify(await source.next()));
        note("thrown into " + JSON.stringify(await source.throw(new Error("from outside"))));
        note("then " + JSON.stringify(await source.next()));
        note("then " + JSON.stringify(await source.next()));
    } catch (error) {
        note("caught " + (error as Error).message);
    }
}
////= returnedInto
async function* through(source: AsyncGenerator<unknown, string, unknown>): AsyncGenerator<unknown, string, unknown> {
    return yield* source;
}
////= resumed
const lines: string[] = [];
////= scene
for (const [kind, make] of kinds) {
    await scene(kind + ", a loop", () => byLoop(delegates(make)));
    await scene(kind + ", a loop, resumed", () => resumed(() => byLoop(delegates(make))));
    await scene(kind + ", a loop beside jobs", () => Promise.all([ticker("t", 14), byLoop(delegates(make))]));
    await scene(kind + ", a loop, resumed beside jobs", () => Promise.all([resumed(() => byLoop(delegates(make))), ticker("t", 16)]));
    await scene(kind + ", next with values", () => byNext(delegates(make)));
    await scene(kind + ", next with values, resumed", () => resumed(() => byNext(delegates(make))));
    await scene(kind + ", twice", () => resumed(() => byNext(delegatesTwice(make))));
    await scene(kind + ", behind a wait", () => byLoop(delegatesBehindAWait(make)));
    await scene(kind + ", through another generator", () => resumed(() => byLoop(through(delegates(make)))));
    await scene(kind + ", thrown into", () => resumed(() => thrownInto(delegates(make))));
    await scene(kind + ", returned into", () => resumed(() => returnedInto(delegates(make))));
    await scene(kind + ", two at once", () => Promise.all([byLoop(delegates(make)), byLoop(delegates(make))]));
}
console.log(lines.join("\n"));
