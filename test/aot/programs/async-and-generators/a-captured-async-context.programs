//// a-captured-async-context-is-kept-alive-by-what-waits.js
// Each store is an object that only the async context refers to while the function that entered it is suspended: on a pending promise, on a call, on a queued job.
// The collector runs in between, and the store has to be there afterwards.
const { AsyncLocalStorage } = require("node:async_hooks");
const storage = new AsyncLocalStorage();
let resolvers = [];
const pending = () => new Promise(resolve => resolvers.push(resolve));
async function suspendsOnce(value) {
  await null;
  return value;
}
async function waits(i) {
  await pending();
  const afterPromise = storage.getStore().i;
  await suspendsOnce(i);
  const afterCall = storage.getStore().i;
  await i;
  return afterPromise === i && afterCall === i && storage.getStore().i === i && storage.getStore().filler.length === 64;
}
async function main() {
  let right = 0;
  for (let round = 0; round < 40; round++) {
    const waiting = [];
    for (let i = 0; i < 50; i++) waiting.push(storage.run({ i, filler: new Array(64).fill(round) }, () => waits(i)));
    Bun.gc(true);
    const resolveAll = resolvers;
    resolvers = [];
    for (const resolve of resolveAll) resolve();
    Bun.gc(true);
    for (const answer of await Promise.all(waiting)) right += answer ? 1 : 0;
    const garbage = [];
    for (let i = 0; i < 2000; i++) garbage.push({ i, text: "x" + i });
  }
  console.log(right, storage.getStore());
}
main();
//// a-difference-is-alive-across-an-await.js
// A difference that only the end of its block hands on is alive across the await that stands behind it in that block: it is saved with the frame, so it is computed in front of the await.
// Nothing tells the build what `counted` answers, so the difference has a way for numbers and a way for everything else, and the two meet behind the await.
const counted = typeof aCounterThatIsNotThere === "function" ? aCounterThatIsNotThere : null;
let ticks = 0;
function entered() {
  return counted ? counted("one") + counted("two") : (ticks += 3);
}
const lines = [];
async function* later(n) {
  yield n;
}
async function measureLater(label, make) {
  await make(0).next();
  const before = entered();
  const steps = [];
  for (let i = 0; i < 40; i++) {
    const generator = make(i);
    if (i % 4 === 1) steps.push(generator.next());
  }
  const entries = entered() - before;
  let sum = 0;
  for (const step of await Promise.all(steps)) sum += step.value;
  lines.push(label + ": " + sum + ", " + entries);
}
await measureLater("first", i => later(i));
await measureLater("second", i => later(i + 1));
console.log(lines.join("\n"));
//// a-generator-expanded-into-its-caller-keeps-the-first-value-when-the-member-turns-up-on-the-prototype.ts
class Step {
  declare id: number;
  declare result?: number;
  constructor(id: number) {
    this.id = id;
  }
}
function* stepwise(step: Step): Generator<number | undefined, string, void> {
  yield step.result;
  yield step.result;
  return `${step.result} [${Object.keys(step)}]`;
}
function drain(step: Step) {
  const steps = stepwise(step);
  const first = steps.next().value;
  steps.next();
  return `${first} ${steps.next().value}`;
}
console.log(drain(new Step(1)));
(Step.prototype as any)[["re", "sult"].join("")] = 60;
console.log(drain(new Step(2)));
