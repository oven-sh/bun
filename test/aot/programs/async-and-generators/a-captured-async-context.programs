//// an-object-returned-from-a-try-whose-finally-awaits-in-a-validating-build.js
// The object that is returned is built behind the finally block, and until then the array in it is carried there. Where the try block throws there is no array to carry, and nothing looks at its place: neither the program nor the checks of a validating build.
async function collect(resource, list, change) { try { return { changed: [...list.map(change)] } } finally { await resource.close() } }
async function keep(resource, list, wanted) { try { return { kept: [...list.filter(wanted)], count: list.length } } finally { await resource.close() } }
const resource = { closed: 0, async close() { this.closed++ } };
const same = value => value, fails = value => { throw new Error("thrown at " + value) };
for (const [name, list, change] of [["first", ["p"], same], ["second", ["q"], fails], ["third", ["r", "s"], same], ["fourth", [], fails]]) {
  try { console.log(name, JSON.stringify(await collect(resource, list, change)), resource.closed) } catch (error) { console.log(name, "caught", error.message, resource.closed) }
  try { console.log(name, JSON.stringify(await keep(resource, list, change)), resource.closed) } catch (error) { console.log(name, "caught", error.message, resource.closed) }
}
//// async-awaited-by-async-generators.ts
// Async generators that await async functions of the program: functions that return at once, behind a settled await, behind an await that waits in earnest,
// that throw; numbers, texts, records, thenables; one waiter, a generator and a function waiting for one promise, a promise nobody waits for yet;
// alone and beside other jobs, with a ticker that shows every turn of the job queue.
let log: string[] = [];
////= note-2
interface Chunk { n: number; }
const thenable = { then(resolve: (value: string) => void): void { note("then is called"); resolve("from then"); } };
type Helper = (i: number) => Promise<unknown>;
const helpers: [string, Helper][] = [
    ["at once, a number", async i => i],
    ["at once, a record", async i => ({ n: i } as Chunk)],
    ["behind a settled await, a number", async i => { await undefined; note("helper returns"); return i; }],
    ["behind a settled await, a record", async i => { await undefined; note("helper returns"); return { n: i } as Chunk; }],
    ["behind a wait, a number", async i => { await outside(); note("helper returns"); return i; }],
    ["behind a wait, a text", async i => { await outside(); note("helper returns"); return "text " + i; }],
    ["behind a wait, a record", async i => { await outside(); note("helper returns"); return { n: i } as Chunk; }],
    ["behind a wait, undefined", async () => { await outside(); note("helper returns"); }],
    ["behind a wait, a thenable", async () => { await outside(); note("helper returns"); return thenable; }],
    ["behind a wait, a promise", async i => { await outside(); note("helper returns"); return Promise.resolve(i); }],
    ["behind a wait, it throws", async i => { await outside(); note("helper throws"); throw new Error("thrown " + i); }],
    ["behind two waits", async i => { await outside(); await outside(); note("helper returns"); return i; }],
    ["queues a job and returns", async i => { await outside(); Promise.resolve().then(() => note("the helper's job")); note("helper returns"); return i; }],
];
async function* awaits(helper: Helper, n: number): AsyncGenerator<string> {
    for (let i = 0; i < n; i++) {
        note("awaits " + i);
        try {
            yield JSON.stringify(await helper(i));
        } catch (error) {
            yield "caught " + (error as Error).message;
        }
    }
}
async function* awaitsKept(helper: Helper): AsyncGenerator<string> {
    const kept = helper(1);
    await outside(); await outside(); await outside(); await outside();
    note("awaits what was kept");
    try {
        yield JSON.stringify(await kept);
    } catch (error) {
        yield "caught " + (error as Error).message;
    }
}
async function* shares(promise: Promise<unknown>, label: string): AsyncGenerator<string> {
    try {
        yield label + " " + JSON.stringify(await promise);
    } catch (error) {
        yield label + " caught " + (error as Error).message;
    }
}
async function collect(source: AsyncGenerator<string>): Promise<void> {
    for await (const x of source) note("got " + x);
}
async function waitsToo(promise: Promise<unknown>): Promise<void> {
    try {
        note("the function got " + JSON.stringify(await promise));
    } catch (error) {
        note("the function caught " + (error as Error).message);
    }
}
////= resumed
const lines: string[] = [];
////= scene
for (const [title, helper] of helpers) {
    await scene(title + ", alone", () => collect(awaits(helper, 2)));
    await scene(title + ", resumed", () => resumed(() => collect(awaits(helper, 2))));
    await scene(title + ", beside jobs", () => Promise.all([ticker("t", 14), collect(awaits(helper, 2))]));
    await scene(title + ", resumed beside jobs", () => Promise.all([resumed(() => collect(awaits(helper, 2))), ticker("t", 16)]));
    await scene(title + ", kept", () => collect(awaitsKept(helper)));
    await scene(title + ", a generator and a function wait", () => { const promise = helper(5); return Promise.all([collect(shares(promise, "first")), waitsToo(promise)]); });
    await scene(title + ", a function and a generator wait", () => { const promise = helper(6); return Promise.all([waitsToo(promise), collect(shares(promise, "second"))]); });
    await scene(title + ", two generators wait", () => { const promise = helper(7); return Promise.all([collect(shares(promise, "first")), collect(shares(promise, "second"))]); });
    await scene(title + ", two streams at once", () => Promise.all([collect(awaits(helper, 2)), collect(awaits(helper, 2))]));
}
console.log(lines.join("\n"));
//// async-frames-behind-a-function-that-finished-before.ts
const settled = Promise.resolve(0);
const frames = (error: Error) => String(error.stack).split("\n").slice(1).map(line => line.trim().replace(/\(?\S*[\\/]/, "")).join(" | ");
////= makesLater
async function inner(which: number): Promise<Error> {
  if (which === 1) return await makesLater();
  return new Error("other");
}
////= lines-10	outer	which	number	Error	await	inner
for (let which = 0; which < 2; which++) console.log(frames(await outer(which)));
//// async-frames-end-at-a-returned-promise.mjs
async function one() { await 1; return two(); }
async function two() { await 1; return new Error("a").stack; }
const outer = async () => (await one()).split("\n").slice(1).map(line => line.trim().split(" (")[0]).join(" | ");
console.log(await outer());
//// async-frames-of-functions-whose-arguments-are-tested.ts
// The tests of the arguments of an async function stand in a function of their own in front of the typed body. That function waits for the body, and it is no frame of the program:
// each async function shows once in the frames of an error that native code creates, whatever the limit.
import { promises } from "node:fs";
const missing = "/nonexistent-path/does-not-exist.txt";
type Source = "node:fs" | "Bun.file";
async function innermost(source: Source): Promise<unknown> {
  if (source === "node:fs") return await promises.readFile(missing);
  return await Bun.file(missing).text();
}
async function middle(source: Source): Promise<unknown> {
  const result = await innermost(source);
  return result;
}
////= lines-10	outermost	source	Source	unknown	await	middle
async function rejection(run: () => Promise<unknown>): Promise<string> {
  try { await run(); return "fulfilled"; } catch (error) { return JSON.stringify(((error as Error).stack ?? "").split("\n").slice(1).map(line => line.trim().replace(/\(.*[\\\/]/, "("))); }
}
async function main(): Promise<void> {
  for (const source of ["node:fs", "Bun.file"] as const) {
    for (const limit of [1, 2, 3, 4, 5, 10]) {
      Error.stackTraceLimit = limit;
      console.log(source, limit, await rejection(() => outermost(source)));
    }
  }
}
main();
//// async-frames-of-the-second-stack-trace.ts
const settled = Promise.resolve(0);
const names = (error: Error) => error.stack!.split("\n").slice(1).map(line => line.trim().replace(/ ?\(?[^ (]*:\d+:\d+\)?$/, "")).join(" | ");
////= makesLater
async function outer(): Promise<Error> {
  return await makesLater();
}
for (let round = 0; round < 2; round++) console.log(names(await outer()));
//// async-functions-that-never-await.ts
// An async function without an await runs to its end inside the call. Its caller gets a promise all the same, and whoever awaits the call waits for as many turns of the job queue as in plain Bun,
// whatever the function returns (a number, an object, a thenable, a promise in any state) or throws, in its body or in the head that evaluates its parameters. The calls are awaited at once, in a
// try, later, never, and as elements of Promise.all. A rejection that nobody handles is reported once, one that is handled is not, and the stack of an error names the same functions and positions.
// STATISTIC: AsyncWorkersMade >= 20
declare const setUnhandledRejectionCallback: undefined | ((callback: (promise: Promise<unknown>, reason: unknown) => void) => void);
Error.stackTraceLimit = 12;
const settled = Promise.resolve();
const shared = Promise.resolve(99);
const lines: string[] = [];
let touched = 0;

function ignore(): void {}
////= afterTimer
////= afterTwoJobs
// A chain of jobs that runs beside what is tested: a turn that is lost or added shows in the count.
////= Ticker
////= startTicker
// The text of a TypeError is the engine's: only its name is compared.
function describe(value: unknown): string {
  if (value instanceof TypeError) return "a TypeError";
  if (value instanceof Error) return value.name + " (" + value.message + ")";
  if (value instanceof Promise) return "a promise";
  if (typeof value === "function") return "a function";
  if (Array.isArray(value)) return "[" + value.map(element => describe(element)).join(", ") + "]";
  if (typeof value === "object" && value !== null) return "{" + Object.entries(value).map(([key, member]) => key + ": " + describe(member)).join(", ") + "}";
  if (typeof value === "string") return JSON.stringify(value);
  return typeof value === "bigint" ? value + "n" : String(value);
}
function pair(first: unknown, second: unknown): string {
  return describe(first) + " then " + describe(second);
}
function caught(error: unknown): string {
  return "caught " + describe(error);
}
////= names

const namesOfPromises = new Map<Promise<unknown>, string>();
function reportUnhandled(reason: unknown, promise: Promise<unknown>): void {
  lines.push("  nobody handles the rejection of " + (namesOfPromises.get(promise) ?? "a promise without a name") + ": " + describe(reason));
}
if (typeof setUnhandledRejectionCallback === "function") setUnhandledRejectionCallback((promise, reason) => reportUnhandled(reason, promise));
else process.on("unhandledRejection", reportUnhandled);

////= Point
class Deferred {
  constructor(readonly value: number) {}
  then(resolve: (value: number) => void): void {
    lines.push("  then of an instance is called");
    resolve(this.value);
  }
}
function thenableFor(value: number): PromiseLike<number> {
  return {
    then(resolve: any): any {
      lines.push("  then is called");
      resolve(value);
    },
  };
}
function raise(n: number): number {
  throw new RangeError("thrown below " + n);
}

////= lines-9	givesANumber	number	return	n	1
async function givesAFraction(n: number): Promise<number> {
  return n / 4;
}
////= lines-9	givesAString	string	return	"s"	n
