//// a-variable-stored-in-the-catch-of-a-generator-is-compared-with-its-old-value.ts
// A generator gives a variable a new object in a catch. Behind the catch and a call, the variable is compared with a constant that still holds the old object.
function show(o: unknown): string {
  if (o === null || typeof o !== "object") return String();
  return o.constructor.name;
}
////= Point-2
const given: number[] = JSON.parse("[0.5]");
function fail(): void {
  throw new Error("no");
}
function* run(): Generator<unknown> {
  let o1 = new Point(0, given[0]);
  const o2 = o1;
  try {
    yield fail();
    o1.y;
  } catch {
    o1 = new Point(o1.x, o1.y);
  }
  const { x } = o2;
  return show(o1) + (o1 === o2);
}
function drive(): unknown {
  const steps = run();
  let result = steps.next();
  for (let i = 0; i < 60 && !result.done; ) result = steps.next();
  return result.value;
}
let wrong = 0;
for (let k0 = 0; k0 < 4000; k0++) if (drive() !== "Pointfalse") wrong++;
console.log(wrong);
//// an-async-function-that-is-seldom-called-walks-rows.ts
// Async functions that stand behind many conditions or in a catch clause, so that nothing says they run often, walk what they are handed with for..of, with a spread and by index.
// What arrives is what the types say, and then it is not.
type Row = { id: number };

////= lines-47	walks	const row of rows) n += row
////= lines-47	walksInCatch	const row of rows) n += row
async function spreadsInLoop(rows: Row[], times: number): Promise<number> {
  let n = 0;
  for (let i = 0; i < times; i++) {
    const copy = [...rows];
    n += copy[i % copy.length].id + rows[0].id;
  }
  await null;
  return n;
}
////= lines-47	byIndex	let i = 0; i < rows.length; i++) n += rows[i]

const rows: Row[] = JSON.parse('[{"id":1},{"id":2},{"id":3}]');
const odd: any = [{ id: 1 }, { id: "two" }, { get id() { return 3; } }, Object.create({ id: 4 })];
const notAnArray: any = new Set(rows);
const flags: number[] = JSON.parse("[1,1,1,1,1]");
const out: unknown[] = [];
if (flags[0]) if (flags[1]) if (flags[2]) if (flags[3]) if (flags[4]) {
  out.push(await walks(rows, rows[0]), await walks(odd, odd[1]), await walks(notAnArray, rows[2]));
  out.push(await spreadsInLoop(rows, 4), await spreadsInLoop(odd, 4));
  out.push(await byIndex(rows, rows[0]), await byIndex(odd, odd[1]));
}
try {
  if (flags[0]) throw new Error("x");
} catch {
  out.push(await walksInCatch(rows, rows[0]), await walksInCatch(odd, odd[3]));
}
console.log(JSON.stringify(out));
