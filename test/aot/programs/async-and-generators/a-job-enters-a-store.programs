////: a-job-enters-a-store
import { AsyncLocalStorage, AsyncResource } from "node:async_hooks";
import { drainMicrotasks } from "bun:jsc";
let store = «1»;
const say = (...words) => console.log(...words, store.getStore());
const queues = () => {
  «2»
};
setImmediate(() => {
  queues();
  drainMicrotasks();
  say("behind the jobs:");
  setImmediate(() => say("in the next turn:"));
});
