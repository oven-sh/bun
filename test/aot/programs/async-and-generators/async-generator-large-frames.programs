//// async-generator-own-properties.ts
// Async generator objects that the program has given properties of their own: a harmless one, `next`, `return`, `throw`, Symbol.asyncIterator;
// as data, as accessors, added before the loop and in the middle of it, taken away again; consumed by `for await`, by `yield*` and by next() written out.
const lines: string[] = [];
async function* count(label: string, n: number): AsyncGenerator<string, string> {
    try {
        for (let i = 0; i < n; i++) yield label + i;
        return label + " is over";
    } finally {
        lines.push(label + " is closed");
    }
}
async function* other(): AsyncGenerator<string> {
    yield "from the other";
}
async function collect(title: string, source: AsyncIterable<string>, limit = 99): Promise<void> {
    const seen: string[] = [];
    try {
        for await (const x of source) { seen.push(x); if (seen.length >= limit) break; }
    } catch (error) {
        seen.push("caught " + (error instanceof TypeError ? "TypeError" : (error as Error).message));
    }
    lines.push(title + ": " + seen.join(" "));
}
async function* through(source: AsyncGenerator<string, string>): AsyncGenerator<string> {
    yield "returned: " + (yield* source);
}
function withProperty<T extends object>(target: T, key: PropertyKey, value: unknown): T {
    return Object.defineProperty(target, key, { value, enumerable: true, configurable: true, writable: true });
}
let calls = 0;
const kinds: [string, () => AsyncGenerator<string, string>][] = [
    ["as made", () => count("a", 2)],
    ["a harmless property", () => withProperty(count("b", 2), "result", Promise.resolve(1))],
    ["two harmless properties", () => withProperty(withProperty(count("c", 2), "result", 1), "label", "c")],
    ["a symbol of its own", () => withProperty(count("d", 2), Symbol("mine"), 1)],
    ["next of its own", () => { const g = count("e", 2); return withProperty(g, "next", () => { calls++; return Promise.resolve({ done: calls % 3 === 0, value: "own next " + calls }); }); }],
    ["next of its own that calls the real one", () => { const g = count("f", 2); const real = g.next.bind(g); return withProperty(g, "next", () => { lines.push("next is called"); return real(); }); }],
    ["an iterator method of its own", () => withProperty(count("g", 2), Symbol.asyncIterator, () => other())],
    ["an iterator method that is undefined", () => withProperty(count("h", 2), Symbol.asyncIterator, undefined)],
    ["return of its own", () => { const g = count("i", 3); return withProperty(g, "return", (value: string) => { lines.push("own return"); return Promise.resolve({ done: true, value }); }); }],
    ["next as a getter", () => { const g = count("j", 2); const real = g.next; return Object.defineProperty(g, "next", { get() { lines.push("next is read"); return real; }, configurable: true }); }],
    ["next added and taken away", () => { const g = withProperty(count("k", 2), "next", () => { throw new Error("never"); }); delete (g as any).next; return g; }],
    ["frozen", () => Object.freeze(count("l", 2))],
    ["many properties", () => { const g = count("m", 2); for (let i = 0; i < 80; i++) (g as any)["p" + i] = i; return g; }],
];
for (const [title, make] of kinds) {
    await collect(title, make());
    await collect(title + ", broken off", make(), 1);
    await collect(title + ", through yield*", through(make()));
}
{
    const g = count("n", 4);
    const seen: string[] = [];
    for await (const x of g) {
        seen.push(x);
        if (x === "n1") withProperty(g, "next", () => Promise.resolve({ done: true, value: "late next" }));
    }
    lines.push("next added in the middle of a loop: " + seen.join(" "));
}
console.log(lines.join("\n"));
//// async-generator-prototype-changes.js
// `for await` and `yield*` over async generators whose prototype chain the program has changed: the `prototype` object of the generator function gets a `next`, a `return`,
// an iterator method or a harmless property, is replaced by another object or by a number, and the generator object itself gets another prototype or none.
// `next` is read once, when the loop opens: a change in the middle of a loop is seen by the next loop only.
const lines = [];
function makeCount(label) {
    return async function* (n) {
        try {
            for (let i = 0; i < n; i++) yield label + i;
            return label + " is over";
        } finally {
            lines.push(label + " is closed");
        }
    };
}
async function* other() { yield "from the other"; }
async function collect(title, source, limit = 99) {
    await null;
    const seen = [];
    try {
        for await (const x of source) { seen.push(x); if (seen.length >= limit) break; }
    } catch (error) {
        seen.push("caught " + (error instanceof TypeError ? "TypeError" : error.message));
    }
    lines.push(title + ": " + seen.join(" "));
}
async function* through(source) { yield "returned: " + (yield* source); }

const realNext = Object.getPrototypeOf(makeCount("z").prototype).next;
let calls = 0;
const kinds = [
    ["as made", () => makeCount("a")(2)],
    ["a harmless property on the prototype", () => { const f = makeCount("b"); f.prototype.label = "b"; return f(2); }],
    ["next on the prototype", () => { const f = makeCount("c"); f.prototype.next = () => Promise.resolve({ done: ++calls % 3 === 0, value: "other next " + calls }); return f(2); }],
    ["next on the prototype that calls the real one", () => { const f = makeCount("d"); f.prototype.next = function (value) { lines.push("next is called"); return realNext.call(this, value); }; return f(2); }],
    ["next on the prototype, as a getter", () => { const f = makeCount("e"); Object.defineProperty(f.prototype, "next", { get() { lines.push("next is read"); return realNext; } }); return f(2); }],
    ["an iterator method on the prototype", () => { const f = makeCount("f"); f.prototype[Symbol.asyncIterator] = () => other(); return f(2); }],
    ["an undefined iterator method on the prototype", () => { const f = makeCount("g"); f.prototype[Symbol.asyncIterator] = undefined; return f(2); }],
    ["return on the prototype", () => { const f = makeCount("h"); f.prototype.return = value => { lines.push("other return"); return Promise.resolve({ done: true, value }); }; return f(3); }],
    ["next added after the generator was made", () => { const f = makeCount("i"); const g = f(2); f.prototype.next = () => Promise.resolve({ done: true, value: "late" }); return g; }],
    ["next added and taken away", () => { const f = makeCount("j"); f.prototype.next = () => { throw new Error("never"); }; delete f.prototype.next; return f(2); }],
    ["another object as the prototype", () => { const f = makeCount("k"); f.prototype = Object.create(Object.getPrototypeOf(f.prototype)); return f(2); }],
    ["an object without the methods as the prototype", () => { const f = makeCount("l"); f.prototype = {}; return f(2); }],
    ["a number as the prototype", () => { const f = makeCount("m"); f.prototype = 5; return f(2); }],
    ["the prototype of another generator function", () => { const g = makeCount("n")(2); Object.setPrototypeOf(g, makeCount("o").prototype); return g; }],
    ["a prototype with a next of its own", () => { const g = makeCount("p")(2); Object.setPrototypeOf(g, { __proto__: Object.getPrototypeOf(g), next: () => Promise.resolve({ done: true, value: "never seen" }) }); return g; }],
    ["no prototype", () => Object.setPrototypeOf(makeCount("q")(2), null)],
    ["a frozen prototype", () => { const f = makeCount("r"); Object.freeze(f.prototype); return f(2); }],
];
for (const [title, make] of kinds) {
    await collect(title, make());
    await collect(title + ", broken off", make(), 1);
    await collect(title + ", through yield*", through(make()));
}
{
    const f = makeCount("s");
    const seen = [];
    for await (const x of f(4)) {
        seen.push(x);
        if (x === "s1") f.prototype.next = () => Promise.resolve({ done: true, value: "late next" });
    }
    lines.push("next added in the middle of a loop: " + seen.join(" "));
    await collect("the loop after it", f(4));
}
{
    const g = makeCount("t")(4);
    const seen = [];
    for await (const x of g) {
        seen.push(x);
        if (x === "t1") Object.setPrototypeOf(g, null);
    }
    lines.push("the prototype taken away in the middle of a loop: " + seen.join(" "));
}
console.log(lines.join("\n"));
//// async-generator-step-interleaving.ts
// `for await` and next() over async generators of the program: in which order the producer, the consumer and everything else run:
// a consumer in its first run and one that has been resumed, alone, ahead of other jobs and behind them; every kind of yielded value;
// awaits between yields; chains; several requests at once; return() and throw() while suspended; await in finally.
let log: string[] = [];
////= note
function show(value: unknown): string {
    if (value instanceof Error) return value.name + "(" + value.message + ")";
    if (Array.isArray(value)) return "[" + value.map(show).join(",") + "]";
    if (typeof value === "object" && value !== null) return value.constructor?.name + JSON.stringify(value);
    return typeof value + " " + String(value);
}
////= ticker
// Settled by a job two turns on: whoever awaits it waits in earnest, and nobody has to stand by to release it.
////= outside
class Thenable {
    constructor(private label: string, private value: number) {}
    then(onFulfilled: (value: number) => void): void {
        note(this.label + " then is called");
        onFulfilled(this.value);
    }
}
const settled = Promise.resolve(10);

async function* numbers(n: number): AsyncGenerator<number> {
    note("numbers starts");
    for (let i = 0; i < n; i++) { note("yields " + i); yield i; note("behind yield " + i); }
    note("numbers ends");
}
async function* ofManyKinds(label: string): AsyncGenerator<unknown> {
    yield 1.5;
    yield "text";
    yield undefined;
    yield null;
    yield { value: 1, done: true };
    yield [1, 2];
    yield Promise.resolve("fulfilled");
    yield new Thenable(label, 7);
    yield settled;
    yield outside().then(() => "released");
    yield { then: 5 };
    yield Object.defineProperty({}, "then", { get() { note(label + " then is read"); return undefined; } });
}
async function* awaitsBetween(n: number): AsyncGenerator<number> {
    for (let i = 0; i < n; i++) { note("awaits " + i); const v = await settled; note("awaited " + i); yield i + v; }
}
async function* awaitsOutside(n: number): AsyncGenerator<number> {
    for (let i = 0; i < n; i++) { note("waits " + i); await outside(); note("waited " + i); yield i; yield i + 100; }
}
async function* queuesJobs(n: number): AsyncGenerator<number> {
    for (let i = 0; i < n; i++) { Promise.resolve().then(() => note("job of the producer " + i)); yield i; }
}
async function* doubled(source: AsyncIterable<number>): AsyncGenerator<number> {
    note("doubled starts");
    for await (const x of source) { note("doubles " + x); yield x * 2; }
    note("doubled ends");
}
async function* delegates(n: number): AsyncGenerator<number> {
    yield -1;
    const returned = yield* returnsSomething(n);
    note("delegate returned " + returned);
    yield -2;
}
async function* returnsSomething(n: number): AsyncGenerator<number, string> {
    for (let i = 0; i < n; i++) yield i;
    return "the end";
}
async function* throwsAt(n: number): AsyncGenerator<number> {
    for (let i = 0; ; i++) { if (i === n) throw new RangeError("at " + n); yield i; }
}
async function* yieldsRejected(): AsyncGenerator<number> {
    yield 1;
    try { yield Promise.reject(new Error("rejected operand")) as Promise<number>; } catch (error) { note("producer caught " + show(error)); }
    yield 2;
}
async function* cleansUp(label: string): AsyncGenerator<number> {
    try {
        for (let i = 0; ; i++) yield i;
    } finally {
        note(label + " finally starts");
        await null;
        note(label + " finally goes on");
        await settled;
        note(label + " finally ends");
    }
}
async function* takesWhatIsSent(): AsyncGenerator<number, void, string | undefined> {
    let sent = yield 0;
    for (let i = 1; i < 4; i++) { note("was sent " + sent); sent = yield i; }
}
function fail(text: string): number { throw new RangeError(text); }
async function* bindsParameters(n: number = fail("while the parameters are bound"), { step }: { step: number } = { step: 1 }): AsyncGenerator<number> {
    note("binds parameters starts");
    for (let i = 0; i < n; i += step) yield i;
}
async function* throwsBehindAwaits(n: number): AsyncGenerator<number> {
    for (let i = 0; ; i++) { await settled; if (i === n) fail("behind awaits"); yield i; await null; }
}
async function* catchesWhatItsSourceThrows(source: AsyncIterable<number>): AsyncGenerator<number> {
    try { for await (const x of source) yield x; } catch (error) { note("the middle caught " + show(error)); yield -1; }
}
class Stream {
    constructor(private n: number) {}
    async *[Symbol.asyncIterator](): AsyncGenerator<string> {
        for await (const x of this.#inner()) yield "event " + x;
    }
    async *#inner(): AsyncGenerator<number> {
        for (let i = 0; i < this.n; i++) yield i;
    }
}

const kinds = 25;
async function run(kind: number, label: string, isResumedFirst: boolean): Promise<void> {
    if (isResumedFirst) await null;
    note(label + " begins");
    try {
        switch (kind) {
        case 0: for await (const x of numbers(3)) note(label + " got " + x); break;
        case 1: for await (const x of ofManyKinds(label)) note(label + " got " + show(x)); break;
        case 2: for await (const x of awaitsBetween(3)) note(label + " got " + x); break;
        case 3: for await (const x of awaitsOutside(2)) note(label + " got " + x); break;
        case 4: for await (const x of queuesJobs(3)) note(label + " got " + x); break;
        case 5: for await (const x of doubled(numbers(3))) note(label + " got " + x); break;
        case 6: for await (const x of doubled(doubled(awaitsBetween(2)))) note(label + " got " + x); break;
        case 7: for await (const x of delegates(2)) note(label + " got " + x); break;
        case 8: for await (const x of throwsAt(2)) note(label + " got " + x); break;
        case 9: for await (const x of yieldsRejected()) note(label + " got " + x); break;
        case 10: for await (const x of cleansUp(label)) { note(label + " got " + x); if (x === 2) break; } break;
        case 11: for await (const x of cleansUp(label)) { note(label + " got " + x); if (x === 1) throw new Error("thrown by the consumer"); } break;
        case 12: for await (const x of doubled(cleansUp(label))) { note(label + " got " + x); if (x === 2) break; } break;
        case 13: for await (const x of new Stream(3)) note(label + " got " + x); break;
        case 14: {
            const g = numbers(3);
            for (let step = await g.next(); !step.done; step = await g.next()) note(label + " got " + step.value);
            note(label + " behind the end " + show(await g.next()));
            break;
        }
        case 15: {
            const g = numbers(4);
            const all = [g.next(), g.next(), g.next()];
            note(label + " asked three times");
            for (const step of all) note(label + " got " + show(await step));
            for await (const x of g) note(label + " then got " + x);
            break;
        }
        case 16: {
            const g = cleansUp(label);
            note(label + " got " + show(await g.next()));
            const first = g.next(), returned = g.return(42), behind = g.next();
            note(label + " got " + show(await first) + " " + show(await returned) + " " + show(await behind));
            break;
        }
        case 17: {
            const g = cleansUp(label);
            note(label + " got " + show(await g.next()));
            try { await g.throw(new Error("thrown in")); } catch (error) { note(label + " got back " + show(error)); }
            note(label + " got " + show(await g.next()));
            const fresh = numbers(2);
            note(label + " returned ahead of the start " + show(await fresh.return(5)) + " " + show(await fresh.next()));
            break;
        }
        case 18: {
            const g = takesWhatIsSent();
            note(label + " got " + show(await g.next("lost")));
            for (const text of ["a", "b", "c", "d"]) note(label + " got " + show(await g.next(text)));
            break;
        }
        case 19: {
            const g = numbers(6);
            for await (const x of g) { note(label + " got " + x); if (x === 1) break; }
            note(label + " behind the break " + show(await g.next()));
            let sum = 0;
            for await (const x of numbersQuietly(200)) sum += x;
            note(label + " sum " + sum);
            break;
        }
        case 20: for await (const x of bindsParameters(3, { step: 2 })) note(label + " got " + x); break;
        case 21: {
            let made: AsyncGenerator<number> | undefined;
            try { made = bindsParameters(); } catch (error) { note(label + " the call threw " + show(error)); }
            note(label + " made " + typeof made);
            for await (const x of bindsParameters(2)) note(label + " got " + x);
            break;
        }
        case 22: for await (const x of throwsBehindAwaits(2)) note(label + " got " + x); break;
        case 23: for await (const x of doubled(throwsBehindAwaits(1))) note(label + " got " + x); break;
        case 24: for await (const x of doubled(catchesWhatItsSourceThrows(throwsAt(1)))) note(label + " got " + x); break;
        }
        note(label + " is through");
    } catch (error) {
        note(label + " caught " + show(error));
    }
}
async function* numbersQuietly(n: number): AsyncGenerator<number> { for (let i = 0; i < n; i++) yield i; }

// Two consumers of two producers at once, and two of one.
async function consumer(label: string, source: AsyncGenerator<number>): Promise<void> {
    for await (const x of source) note(label + " got " + x);
    note(label + " is through");
}

const out: string[] = [];
function flush(title: string): void {
    out.push(title + ": " + log.join(" | "));
    log = [];
}
for (let kind = 0; kind < kinds; kind++) {
    for (const isResumedFirst of [false, true]) {
        for (const company of ["alone", "ahead of jobs", "behind jobs"]) {
            const ahead = company === "behind jobs" ? ticker("t", 9) : undefined;
            const running = run(kind, "c" + kind, isResumedFirst);
            note("back in the module");
            const behind = company === "ahead of jobs" ? ticker("t", 9) : undefined;
            await running;
            await ahead;
            await behind;
            flush(kind + (isResumedFirst ? " resumed " : " first run ") + company);
        }
    }
}
await Promise.all([consumer("a", numbersQuietly(3)), consumer("b", numbersQuietly(3)), ticker("t", 8)]);
flush("two of two");
const shared = numbersQuietly(6);
await Promise.all([consumer("a", shared), consumer("b", shared), ticker("t", 8)]);
flush("two of one");
console.log(out.join("\n"));
//// async-generator-stepped-by-a-first-activation.ts
// `for await` over an async generator of the program is the first thing that suspends its function: nothing has saved the function's frame yet, so the first step has nobody to hand its
// value to but a promise, and the steps behind it go the short way. At the top level of a module that has not awaited anything, at the top level later on, and in async functions, arrows,
// methods and generators that are called by the module, by a job, by a timer, by a function that a job has resumed, by the body of a generator that is being stepped, and many at once.
// Streams of several values, of one, of none, streams that throw at once, that wait first, and loops that leave at the first value.
// Beside every run a chain of `then` callbacks notes the turns of the job queue.
type Numbers = AsyncGenerator<number, void, unknown>;
let log: string[] = [];
const out: string[] = [];
////= note
function flush(title: string): void {
    out.push(title + ": " + log.join(" | "));
    log = [];
}
function show(value: unknown): string {
    return value instanceof Error ? value.name + "(" + value.message + ")" : String(value);
}
////= ticker-3
async function* counts(label: string, n: number): Numbers {
    note(label + " starts");
    for (let i = 0; i < n; i++) { note(label + " yields " + i); yield i; }
    note(label + " ends");
}
async function* throwsAtOnce(label: string): Numbers {
    note(label + " throws");
    throw new RangeError("thrown by " + label);
}
async function* waitsFirst(label: string, n: number): Numbers {
    note(label + " waits");
    await outside();
    for (let i = 0; i < n; i++) { note(label + " yields " + i); yield i; }
}
async function* cleansUp(label: string): Numbers {
    try {
        for (let i = 0; ; i++) { note(label + " yields " + i); yield i; }
    } finally {
        note(label + "'s finally");
    }
}

// The module has not been suspended yet.
const besideTheFirstLoop = ticker("t", 8);
for await (const x of counts("p", 3)) note("the module got " + x);
note("the module is through");
await besideTheFirstLoop;
flush("at the top level, the module's first suspension");

for await (const x of counts("p", 3)) note("the module got " + x);
note("the module is through");
flush("at the top level, later, alone");

const besideALaterLoop = ticker("t", 8);
for await (const x of counts("p", 3)) note("the module got " + x);
note("the module is through");
await besideALaterLoop;
flush("at the top level, later, behind jobs");

async function loops(label: string, source: Numbers): Promise<string> {
    let sum = 0;
    for await (const x of source) { note(label + " got " + x); sum += x; }
    note(label + " is through");
    return label + "'s sum is " + sum;
}
const loopsInAnArrow = async (label: string, source: Numbers): Promise<string> => {
    let sum = 0;
    for await (const x of source) { note(label + " got " + x); sum += x; }
    note(label + " is through");
    return label + "'s sum is " + sum;
};
class Reader {
    constructor(private label: string) {}
    async read(source: Numbers): Promise<string> {
        let sum = 0;
        for await (const x of source) { note(this.label + " got " + x); sum += x; }
        note(this.label + " is through");
        return this.label + "'s sum is " + sum;
    }
    static async readAll(label: string, source: Numbers): Promise<string> {
        let sum = 0;
        for await (const x of source) { note(label + " got " + x); sum += x; }
        note(label + " is through");
        return label + "'s sum is " + sum;
    }
}
async function loopsAndCatches(label: string, source: Numbers): Promise<string> {
    try {
        for await (const x of source) note(label + " got " + x);
        return label + " is through";
    } catch (error) {
        note(label + " caught " + show(error));
        return label + " has caught";
    }
}
async function leavesAtOnce(label: string, source: Numbers): Promise<string> {
    for await (const x of source) { note(label + " got " + x + " and leaves"); break; }
    return label + " has left";
}
async function returnsFromTheLoop(label: string, source: Numbers): Promise<string> {
    for await (const x of source) return label + " returns with " + x;
    return label + " got nothing";
}
async function loopsTwice(label: string, first: Numbers, second: Numbers): Promise<string> {
    for await (const x of first) note(label + " got " + x);
    note(label + " is between its loops");
    for await (const x of second) note(label + " then got " + x);
    return label + " is through";
}
async function loopsOverALoop(label: string): Promise<string> {
    for await (const row of counts(label + "r", 2)) {
        for await (const column of counts(label + "c", 2)) note(label + " got " + row + "," + column);
    }
    return label + " is through";
}
async function callsOneThatLoops(label: string, source: Numbers): Promise<string> {
    const result = await loops(label, source);
    note(label + "'s caller goes on");
    return result;
}
async function* relays(label: string, source: Numbers): Numbers {
    for await (const x of source) { note(label + " relays " + x); yield x; }
}
async function* forwards(source: Numbers): Numbers {
    yield* source;
}
async function* startsALoopAtEachStep(label: string, n: number, started: Promise<string>[]): Numbers {
    for (let i = 0; i < n; i++) {
        started.push(loops(label + i, counts("q" + i, 2)));
        note(label + " yields " + i);
        yield i;
    }
}

type Start = (label: string) => Promise<string>;
const starts: [string, Start][] = [
    ["a function", label => loops(label, counts("p", 3))],
    ["an arrow", label => loopsInAnArrow(label, counts("p", 3))],
    ["a method", label => new Reader(label).read(counts("p", 3))],
    ["a static method", label => Reader.readAll(label, counts("p", 3))],
    ["a function over one value", label => loops(label, counts("p", 1))],
    ["a function over nothing", label => loops(label, counts("p", 0))],
    ["a function over what throws at once", label => loopsAndCatches(label, throwsAtOnce("p"))],
    ["a function without a handler over what throws at once", label => loops(label, throwsAtOnce("p"))],
    ["a function over what waits first", label => loops(label, waitsFirst("p", 2))],
    ["a function that leaves at the first value", label => leavesAtOnce(label, cleansUp("p"))],
    ["a function that returns from the loop", label => returnsFromTheLoop(label, cleansUp("p"))],
    ["a function that returns behind an empty loop", label => returnsFromTheLoop(label, counts("p", 0))],
    ["a function with two loops", label => loopsTwice(label, counts("p", 2), counts("q", 2))],
    ["a function with two loops, the first over nothing", label => loopsTwice(label, counts("p", 0), counts("q", 2))],
    ["a function with a loop in a loop", label => loopsOverALoop(label)],
    ["a function over for await", label => loops(label, relays("r", counts("p", 3)))],
    ["a function over yield*", label => loops(label, forwards(counts("p", 3)))],
    ["a function over a chain of three", label => loops(label, relays("r", forwards(counts("p", 2))))],
    ["a function that awaits one that loops", label => callsOneThatLoops(label, counts("p", 2))],
];
function watch(label: string, running: Promise<string>): Promise<void> {
    return running.then(value => note(label + "'s promise: " + value), error => note(label + "'s promise is rejected: " + show(error)));
}
async function resumedThenStarts(start: Start): Promise<void> {
    await null;
    const running = watch("a", start("a"));
    note("back in the function that a job has resumed");
    await null;
    note("that function went on");
    await running;
}
async function resumedThenAwaits(start: Start): Promise<void> {
    await null;
    try {
        note("the caller got: " + (await start("a")));
    } catch (error) {
        note("the caller caught " + show(error));
    }
}
const callers: [string, (start: Start) => Promise<void>][] = [
    ["the module", start => { const running = watch("a", start("a")); note("back in the module"); return running; }],
    ["a job", start => Promise.resolve().then(() => { const running = watch("a", start("a")); note("back in the job"); return running; })],
    ["a job of queueMicrotask", start => new Promise(resolve => { queueMicrotask(() => { watch("a", start("a")).then(resolve); note("back in the job"); }); })],
    ["a timer", start => new Promise(resolve => { setTimeout(() => { watch("a", start("a")).then(resolve); note("back in the timer"); }, 0); })],
    ["a function that a job has resumed", resumedThenStarts],
    ["a function that a job has resumed and that awaits the call", resumedThenAwaits],
    ["the module, three at once", start => { const all = ["a", "b", "c"].map(label => watch(label, start(label))); note("back in the module"); return Promise.all(all).then(() => undefined); }],
];
for (const [what, start] of starts) {
    for (const [who, call] of callers) {
        for (const company of ["alone", "behind jobs", "ahead of jobs"]) {
            const all: Promise<void>[] = [];
            if (company === "behind jobs") all.push(ticker("t", 10));
            all.push(call(start));
            if (company === "ahead of jobs") all.push(ticker("t", 10));
            await Promise.all(all);
            flush(what + ", called by " + who + ", " + company);
        }
    }
}

// The body of a generator that is being stepped starts functions that loop.
for (const isResumedFirst of [false, true]) {
    const started: Promise<string>[] = [];
    const consume = async (): Promise<void> => {
        if (isResumedFirst) await null;
        for await (const x of startsALoopAtEachStep("s", 3, started)) note("a got " + x);
        note("a is through");
    };
    await consume();
    for (const result of await Promise.all(started)) note(result);
    flush("functions that loop, started by the body of a generator whose consumer is " + (isResumedFirst ? "resumed" : "in its first run"));
}

// Every call is a first activation; each saves its frame at its first step.
async function quietSum(n: number): Promise<number> {
    let sum = 0;
    for await (const x of quiet(n)) sum += x;
    return sum;
}
async function* quiet(n: number): Numbers { for (let i = 0; i < n; i++) yield i; }
let total = 0;
for (let round = 0; round < 500; round++) total += await quietSum(round % 7);
const atOnce = await Promise.all(Array.from({ length: 200 }, (_, i) => quietSum(i % 5)));
out.push("five hundred calls in a row: " + total + ", two hundred at once: " + atOnce.reduce((sum, x) => sum + x, 0));
console.log(out.join("\n"));
export {};
//// async-generator-steps-and-host.ts
// `for await` over async generators of the program, and what the host sees of it: streams that wait for timers and then yield in bursts, through chains;
// the store of an AsyncLocalStorage in producer and consumer; next ticks and timers between the steps; rejections nobody handles; the stacks of errors made in a producer.
import { AsyncLocalStorage } from "node:async_hooks";

const log: string[] = [];
////= note
const storage = new AsyncLocalStorage<string>();
function where(): string {
    return storage.getStore() ?? "-";
}
function later(): Promise<void> {
    return new Promise(resolve => setTimeout(resolve, 1));
}
function names(error: unknown): string {
    const frames: string[] = [];
    for (const line of ((error as Error).stack ?? "").split("\n")) {
        const frame = /^\s*at (async )?(?:(.*?) \()?[^()]*?:(\d+):(\d+)\)?$/.exec(line) ?? /^(async )?(.*?)@.*?:(\d+):(\d+)$/.exec(line);
        if (frame) frames.push((frame[1] ?? "") + (frame[2] === "module code" || frame[2] === "<anonymous>" ? "" : frame[2] ?? "") + ":" + frame[3]);
    }
    return frames.join(" < ");
}

async function* bursts(chunks: number, each: number): AsyncGenerator<number> {
    for (let c = 0; c < chunks; c++) {
        await later();
        note("a chunk has come");
        for (let i = 0; i < each; i++) yield c * 10 + i;
    }
}
async function* lines(source: AsyncIterable<number>): AsyncGenerator<string> {
    for await (const x of source) yield "line " + x;
}
async function* events(source: AsyncIterable<string>): AsyncGenerator<{ text: string }> {
    for await (const text of source) { if (!text.endsWith("1")) yield { text }; }
}
async function streams(): Promise<void> {
    for await (const event of events(lines(bursts(3, 3)))) {
        note("got " + event.text);
        if (event.text === "line 10") {
            process.nextTick(() => note("a tick"));
            queueMicrotask(() => note("a job"));
            setTimeout(() => note("a timer"), 0);
        }
        if (event.text === "line 0") process.nextTick(() => note("a tick alone"));
        if (event.text === "line 20") setTimeout(() => note("a timer alone"), 0);
    }
    note("the stream has ended");
}

async function* tellsStore(label: string, n: number): AsyncGenerator<string> {
    for (let i = 0; i < n; i++) { yield label + i + " in " + where(); if (i === 1) await later(); }
}
async function* entersStore(): AsyncGenerator<string> {
    yield "before " + where();
    storage.enterWith("entered");
    yield "behind " + where();
    await null;
    yield "later " + where();
}
async function stores(): Promise<void> {
    const madeOutside = tellsStore("outside", 4);
    await storage.run("a", async () => {
        for await (const text of madeOutside) note(text + ", consumer in " + where());
        for await (const text of tellsStore("inside", 4)) note(text + ", consumer in " + where());
        for await (const text of lines2(tellsStore("chained", 3))) note(text + ", consumer in " + where());
    });
    await storage.run("b", async () => {
        for await (const text of entersStore()) note(text + ", consumer in " + where());
        note("behind the loop " + where());
    });
    note("at the end " + where());
}
async function* lines2(source: AsyncIterable<string>): AsyncGenerator<string> {
    for await (const text of source) yield text + " through " + where();
}

const unhandled: string[] = [];
process.on("unhandledRejection", (reason: unknown) => { unhandled.push((reason as Error).message); });
async function* fails(text: string, late: boolean): AsyncGenerator<number> {
    yield 1;
    if (late) await later();
    throw new Error(text);
}
async function drains(source: AsyncIterable<number>): Promise<number> {
    let n = 0;
    for await (const x of source) n += x;
    return n;
}
async function rejections(): Promise<void> {
    try { await drains(fails("one", false)); } catch (error) { note("caught " + (error as Error).message); }
    try { await drains(fails("two", true)); } catch (error) { note("caught " + (error as Error).message); }
    await later();
    note("unhandled so far: " + unhandled.join());
    drains(fails("three", false));
    drains(fails("four", true));
    fails("five", false).next();
    const g = fails("six", false);
    g.next();
    g.next();
    await later();
    await later();
    await later();
    note("unhandled: " + unhandled.slice().sort().join());
}

async function* makesErrors(): AsyncGenerator<Error> {
    yield new Error("first");
    yield new Error("second");
    await later();
    yield new Error("behind a timer");
    yield new Error("last");
}
async function* passesErrors(): AsyncGenerator<Error> {
    for await (const error of makesErrors()) yield error;
}
async function stacks(): Promise<void> {
    for await (const error of makesErrors()) note(error.message + ": " + names(error));
    await null;
    for await (const error of passesErrors()) note(error.message + ": " + names(error));
}

await streams();
await stores();
await rejections();
await stacks();
console.log(log.join("\n"));
//// async-generator-steps-avoid-runtime.ts
// next() of an async generator that `for await` or `yield*` of compiled code drives is carried out by a stub, whatever the generator function looks like: what it yields, how it takes its
// parameters, how many variables it has, how many other generator functions stand beside it. The program counts the entries of the operation that the stub leaves for.
declare const aotOperationCount: undefined | ((name: string) => number);
const counted = typeof aotOperationCount === "function" ? aotOperationCount : null;
function entered(): number { return counted ? counted("operationAOTAsyncIteratorStep") : 0; }
const lines: string[] = [];
type Stream = AsyncGenerator<unknown, void, unknown>;
interface Chunk { n: number; text: string; }
async function* yieldsItsVariable(count: number): Stream { for (let i = 0; i < count; i++) yield i; }
async function* yieldsAProduct(count: number): Stream { for (let i = 0; i < count; i++) yield i * 2; }
async function* yieldsASum(count: number): Stream { for (let i = 0; i < count; i++) yield i + 1; }
async function* yieldsAFraction(count: number): Stream { for (let i = 0; i < count; i++) yield i / 3; }
async function* yieldsARecord(count: number): Stream { for (let i = 0; i < count; i++) yield { n: i }; }
async function* yieldsALargerRecord(count: number): AsyncGenerator<Chunk, void, unknown> { for (let i = 0; i < count; i++) yield { n: i, text: "t" }; }
async function* yieldsAnArray(count: number): Stream { for (let i = 0; i < count; i++) yield [i, i]; }
async function* yieldsAString(count: number): Stream { for (let i = 0; i < count; i++) yield "s" + (i % 10); }
async function* yieldsNothingMuch(count: number): Stream { for (let i = 0; i < count; i++) yield undefined; }
async function* yieldsABoolean(count: number): Stream { for (let i = 0; i < count; i++) yield i % 2 === 0; }
async function* awaitsFirst(count: number): Stream { for (let i = 0; i < count; i++) { await null; yield i; } }
async function* awaitsAPromiseFirst(count: number): Stream { const settled = Promise.resolve(1); for (let i = 0; i < count; i++) yield i + await settled; }
async function* hasAFinally(count: number): Stream { try { for (let i = 0; i < count; i++) yield i; } finally { lines.length; } }
async function* hasACatch(count: number): Stream { for (let i = 0; i < count; i++) { try { yield i; } catch (error) { yield error; } } }
async function* hasManyVariables(count: number): Stream {
    let a = 1, b = 2, c = 3, d = 4, e = 5, f = 6, g = 7, h = 8, j = 9, k = 10, l = 11, m = 12, n = 13, o = 14, p = 15, q = 16;
    for (let i = 0; i < count; i++) {
        a += b; b += c; c += d; d += e; e += f; f += g; g += h; h += j; j += k; k += l; l += m; m += n; n += o; o += p; p += q; q = (q + a) % 97;
        a %= 97; b %= 97; c %= 97; d %= 97; e %= 97; f %= 97; g %= 97; h %= 97; j %= 97; k %= 97; l %= 97; m %= 97; n %= 97; o %= 97; p %= 97;
        yield a + b + c + d + e + f + g + h + j + k + l + m + n + o + p + q;
    }
}
async function* yieldsTwiceATurn(count: number): Stream { for (let i = 0; i < count; i += 2) { yield i; yield { n: i + 1 }; } }
async function* closesOverItsVariable(count: number): Stream { for (let i = 0; i < count; i++) { const read = () => i; yield read(); } }
async function* takesAPattern({ count }: { count: number }): Stream { for (let i = 0; i < count; i++) yield i; }
async function* takesADefault(count: number, step: number = 1): Stream { for (let i = 0; i < count; i += step) yield { n: i }; }
async function* takesARest(...counts: number[]): Stream { for (let i = 0; i < counts[0]; i++) yield i; }
async function* forwards(inner: Stream): Stream { yield* inner; }
async function* forwardsAPattern({ inner }: { inner: Stream }): Stream { yield* inner; }
async function* relays(inner: Stream): Stream { for await (const x of inner) yield x; }
class Holder {
    constructor(private base: number) {}
    async *stream(count: number): Stream { for (let i = 0; i < count; i++) yield this.base + i; }
    static async *ofClass(count: number): Stream { for (let i = 0; i < count; i++) yield { n: i }; }
}
const expression = async function* (count: number): Stream { for (let i = 0; i < count; i++) yield -i; };
const inObject = { async *stream(count: number): Stream { for (let i = 0; i < count; i++) yield [i]; } };
async function measure(label: string, calls: number, make: () => AsyncGenerator<unknown, void, unknown>): Promise<void> {
    await null;
    const before = entered();
    let steps = 0;
    for await (const x of make()) steps += x === lines ? 2 : 1;
    const entries = entered() - before;
    lines.push(label + ": " + steps + " steps, " + (entries * 20 < calls ? "few entries" : entries + " ENTRIES FOR " + calls + " CALLS OF next()"));
}
const N = 2000;
for (let round = 0; round < 2; round++) {
    await measure("yields its variable", N, () => yieldsItsVariable(N));
    await measure("yields a product", N, () => yieldsAProduct(N));
    await measure("yields a sum", N, () => yieldsASum(N));
    await measure("yields a fraction", N, () => yieldsAFraction(N));
    await measure("yields a record", N, () => yieldsARecord(N));
    await measure("yields a larger record", N, () => yieldsALargerRecord(N));
    await measure("yields an array", N, () => yieldsAnArray(N));
    await measure("yields a string", N, () => yieldsAString(N));
    await measure("yields nothing much", N, () => yieldsNothingMuch(N));
    await measure("yields a boolean", N, () => yieldsABoolean(N));
    await measure("awaits first", N, () => awaitsFirst(N));
    await measure("awaits a promise first", N, () => awaitsAPromiseFirst(N));
    await measure("has a finally", N, () => hasAFinally(N));
    await measure("has a catch", N, () => hasACatch(N));
    await measure("has many variables", N, () => hasManyVariables(N));
    await measure("yields twice a turn", N, () => yieldsTwiceATurn(N));
    await measure("closes over its variable", N, () => closesOverItsVariable(N));
    await measure("takes a pattern", N, () => takesAPattern({ count: N }));
    await measure("takes a default", N, () => takesADefault(N));
    await measure("takes a rest", N, () => takesARest(N, 1, 2));
    await measure("forwards", 2 * N, () => forwards(yieldsARecord(N)));
    await measure("forwards twice", 3 * N, () => forwards(forwards(yieldsItsVariable(N))));
    await measure("forwards what awaits", 2 * N, () => forwards(awaitsFirst(N)));
    await measure("forwards, by a pattern", 2 * N, () => forwardsAPattern({ inner: takesAPattern({ count: N }) }));
    await measure("relays", 2 * N, () => relays(yieldsALargerRecord(N)));
    await measure("relays what forwards", 3 * N, () => relays(forwards(yieldsAString(N))));
    await measure("a method", N, () => new Holder(round).stream(N));
    await measure("a static method", N, () => Holder.ofClass(N));
    await measure("a function expression", N, () => expression(N));
    await measure("a method of an object literal", N, () => inObject.stream(N));
}
console.log(lines.join("\n"));
//// async-generator-steps-with-then-on-object-prototype.ts
// In the middle of a stream that `for await` or `yield*` of the program steps, the program tries to give Object.prototype a `then`, promises another `constructor` and Promise another
// species, and puts them back two steps later. The producer tries it in the middle of a step, the loop between two steps. Plain Bun takes the changes: every iterator result is then adopted
// through `then`, and every promise that is awaited is asked for its constructor. A compiled program refuses them with a TypeError, because Object.prototype and Promise.prototype are locked
// there (type-rules/new-properties-on-builtin-prototypes, language/promise-and-symbol-constructors-keep-their-members), and the stream goes on as if nobody had tried.
// So the program judges each stream by what became of the change, and all ways of running it print the same. A change that was taken: the loop got what the changed prototype asks for.
// A change that was refused: values and turns of the job queue are those of the untouched stream, which is printed in full.
type Stream = AsyncGenerator<unknown, void, unknown>;
type Resolve = (value: unknown) => void;
type Hook = (index: number) => void;
interface Change {
    title: string;
    // Answers whether the change was taken.
    make: () => boolean;
    undo: () => void;
    replacesResults: boolean;
    wasNoticed: () => boolean;
}
let log: string[] = [];
const out: string[] = [];
let thenCalls = 0, thenReads = 0, constructorReads = 0;
////= note
////= ticker
function attempt(change: () => unknown): void {
    try {
        change();
    } catch (error) {
        if (!(error instanceof TypeError)) throw error;
    }
}

// What it resolves with inherits nothing, so it is not asked for a `then` in turn.
function adopts(this: { value?: unknown; done?: unknown }, resolve: Resolve): void {
    thenCalls++;
    const replaced = Object.create(null);
    replaced.value = this.done ? undefined : "replaced " + String(this.value);
    replaced.done = this.done;
    resolve(replaced);
}
function Other(): void {}
const objectPrototype = Object.prototype as any;
const promisePrototype = Promise.prototype as any;
const speciesAtTheStart = Object.getOwnPropertyDescriptor(Promise, Symbol.species)!;
const hasThen = (): boolean => Object.hasOwn(Object.prototype, "then");
const hasOtherConstructor = (): boolean => Object.getOwnPropertyDescriptor(Promise.prototype, "constructor")!.value !== Promise;
const hasOtherSpecies = (): boolean => Object.getOwnPropertyDescriptor(Promise, Symbol.species)!.get !== speciesAtTheStart.get;
const dropThen = (): void => attempt(() => delete objectPrototype.then);
const restoreConstructor = (): void => attempt(() => Object.defineProperty(Promise.prototype, "constructor", { value: Promise, writable: true, enumerable: false, configurable: true }));
const restoreSpecies = (): void => attempt(() => Object.defineProperty(Promise, Symbol.species, speciesAtTheStart));

const changes: Change[] = [
    {
        title: "then is assigned",
        make: () => { attempt(() => { objectPrototype.then = adopts; }); return hasThen(); },
        undo: dropThen, replacesResults: true, wasNoticed: () => thenCalls >= 2,
    },
    {
        title: "then is defined",
        make: () => { attempt(() => Object.defineProperty(Object.prototype, "then", { value: adopts, writable: true, enumerable: false, configurable: true })); return hasThen(); },
        undo: dropThen, replacesResults: true, wasNoticed: () => thenCalls >= 2,
    },
    {
        title: "then is defined through Reflect",
        make: () => { attempt(() => Reflect.defineProperty(Object.prototype, "then", { value: adopts, writable: true, enumerable: false, configurable: true })); return hasThen(); },
        undo: dropThen, replacesResults: true, wasNoticed: () => thenCalls >= 2,
    },
    {
        title: "then is a number",
        make: () => { attempt(() => { objectPrototype.then = 5; }); return hasThen(); },
        undo: dropThen, replacesResults: false, wasNoticed: () => true,
    },
    {
        title: "then is a getter",
        make: () => { attempt(() => Object.defineProperty(Object.prototype, "then", { get() { thenReads++; return undefined; }, enumerable: false, configurable: true })); return hasThen(); },
        undo: dropThen, replacesResults: false, wasNoticed: () => thenReads >= 2,
    },
    {
        title: "the constructor of promises is a getter",
        make: () => { attempt(() => Object.defineProperty(Promise.prototype, "constructor", { get() { constructorReads++; return Promise; }, enumerable: false, configurable: true })); return hasOtherConstructor(); },
        undo: restoreConstructor, replacesResults: false, wasNoticed: () => constructorReads >= 1,
    },
    {
        title: "the constructor of promises is another function",
        make: () => { attempt(() => { promisePrototype.constructor = Other; }); return hasOtherConstructor(); },
        undo: restoreConstructor, replacesResults: false, wasNoticed: () => true,
    },
    {
        title: "the species of Promise is another getter",
        make: () => { attempt(() => Object.defineProperty(Promise, Symbol.species, { get() { return Promise; }, configurable: true })); return hasOtherSpecies(); },
        undo: restoreSpecies, replacesResults: false, wasNoticed: () => true,
    },
];

async function* produces(n: number, hook: Hook): Stream {
    for (let i = 0; i < n; i++) { hook(i); note("yields " + i); yield i; }
    note("the producer ends");
}
async function* relays(source: Stream): Stream {
    for await (const x of source) { note("relays " + String(x)); yield x; }
    note("the relay ends");
}
async function* forwards(source: Stream): Stream {
    yield* source;
    note("the forwarder ends");
}
async function consumes(source: Stream, hook: Hook, got: unknown[]): Promise<void> {
    await null;
    for await (const x of source) {
        got.push(x);
        note("got " + String(x));
        hook(got.length);
    }
    note("the loop is through");
}

const doesNothing: Hook = () => {};
async function run(wrap: (source: Stream) => Stream, isMadeByProducer: boolean, jobs: number, change: Change | undefined): Promise<{ wasTaken: boolean; got: unknown[] }> {
    log = [];
    thenCalls = thenReads = constructorReads = 0;
    let wasTaken = false;
    // The results of the values 2 and 3 are made while the change holds.
    const hook: Hook = index => {
        if (change && index === 2) wasTaken = change.make();
        if (change && index === 4) change.undo();
    };
    const got: unknown[] = [];
    try {
        const beside = jobs ? ticker("t", jobs) : undefined;
        await consumes(wrap(produces(6, isMadeByProducer ? hook : doesNothing)), isMadeByProducer ? doesNothing : hook, got);
        await beside;
    } finally {
        change?.undo();
    }
    return { wasTaken, got };
}
function judge(change: Change, wasTaken: boolean, got: unknown[], depth: number, untouched: string): string {
    const replaced = "replaced ".repeat(depth);
    const expected = wasTaken && change.replacesResults ? "0,1," + replaced + "2," + replaced + "3,4,5" : "0,1,2,3,4,5";
    const isRight = got.join() === expected && (wasTaken ? change.wasNoticed() : thenCalls + thenReads + constructorReads === 0 && log.join(" | ") === untouched);
    return isRight ? "the stream is what the prototypes ask for" : "NOT WHAT THE PROTOTYPES ASK FOR, the change was " + (wasTaken ? "taken" : "refused") + ": " + log.join(" | ");
}

const shapes: [string, number, (source: Stream) => Stream][] = [
    ["a loop over a generator", 1, source => source],
    ["a loop over for await over a generator", 2, relays],
    ["a loop over yield* over a generator", 2, forwards],
    ["a loop over a chain of three", 3, source => relays(forwards(source))],
];
const companies: [string, number][] = [["alone", 0], ["beside jobs", 40]];
// All of them ahead of the first change: what plain Bun has once taken it remembers, also when it is put back.
const untouchedStreams = new Map<string, string>();
for (const [shape, , wrap] of shapes) {
    for (const [company, jobs] of companies) {
        await run(wrap, true, jobs, undefined);
        untouchedStreams.set(shape + ", " + company, log.join(" | "));
        out.push(shape + ", " + company + ", untouched: " + log.join(" | "));
    }
}
for (const [shape, depth, wrap] of shapes) {
    for (const [company, jobs] of companies) {
        const untouched = untouchedStreams.get(shape + ", " + company)!;
        for (const change of changes) {
            for (const isMadeByProducer of [true, false]) {
                const { wasTaken, got } = await run(wrap, isMadeByProducer, jobs, change);
                out.push(shape + ", " + company + ", " + change.title + " by " + (isMadeByProducer ? "the producer in the middle of a step" : "the loop between two steps") + ": " + judge(change, wasTaken, got, depth, untouched));
            }
        }
    }
}
out.push("at the end: " + [hasThen(), hasOtherConstructor(), hasOtherSpecies(), Promise.prototype.constructor === Promise].join());
console.log(out.join("\n"));
export {};
//// async-generator-yields-promises-and-thenables.ts
// What an async generator yields is awaited before the consumer gets it, so a step whose value is a promise or may have a `then` cannot hand its value over in place, however alone the
// stream is. Streams that yield promises (fulfilled, pending, rejected, of a subclass, with a `then` or a `constructor` of their own, of async functions) and thenables (that answer at once,
// later, twice, with another thenable, that reject, that throw), by turns with plain numbers; the same values returned. `yield*` hands on what its source gives and awaits nothing: a promise
// or a thenable from a hand-written iterator reaches the consumer as it is, while a sync iterable's values are awaited by its wrapper.
// Objects that went through many times without a `then` get one in the middle of a stream, on their class, on themselves, in a declared field, and lose it again.
// Beside every run a chain of `then` callbacks notes the turns of the job queue.
type Stream = AsyncGenerator<unknown, unknown, unknown>;
type Resolve = (value: unknown) => void;
type Make = (i: number) => unknown;
let log: string[] = [];
const out: string[] = [];
////= note
function show(value: unknown): string {
    if (value instanceof Error) return value.name + "(" + value.message + ")";
    if (value instanceof Promise) return "a promise";
    if (typeof value === "object" && value !== null) return value.constructor.name + JSON.stringify(value);
    return typeof value + " " + String(value);
}
////= ticker-3
class Thenable {
    constructor(public n: number) {}
    then(resolve: Resolve): void {
        note("Thenable.then " + this.n);
        resolve("from the thenable " + this.n);
    }
}
class Derived<T> extends Promise<T> {}
const settled = Promise.resolve("settled long ago");
async function doubles(n: number): Promise<number> { return n * 2; }
async function doublesLater(n: number): Promise<number> { await outside(); return n * 2; }
async function fails(n: number): Promise<number> { throw new RangeError("the async function failed " + n); }
function withOwnThen(n: number): Promise<number> {
    const promise = Promise.resolve(n);
    (promise as any).then = (resolve: Resolve): void => { note("the promise's own then is called"); resolve("from its own then " + n); };
    return promise;
}
function withOwnConstructor(n: number): Promise<number> {
    const promise = Promise.resolve(n);
    (promise as any).constructor = function Other(): void {};
    return promise;
}

const makers: [string, Make][] = [
    ["a number", i => i * 10],
    ["a fulfilled promise", i => Promise.resolve("fulfilled " + i)],
    ["one promise again and again", () => settled],
    ["a pending promise", i => outside().then(() => "released " + i)],
    ["a rejected promise", i => Promise.reject(new RangeError("rejected " + i))],
    ["a promise that is rejected later", i => outside().then(() => { throw new RangeError("rejected later " + i); })],
    ["the promise of an async function", i => doubles(i)],
    ["the promise of an async function that waits", i => doublesLater(i)],
    ["the promise of an async function that fails", i => fails(i)],
    ["a promise of a subclass", i => Derived.resolve("derived " + i)],
    ["a promise with its own then", withOwnThen],
    ["a promise with its own constructor", withOwnConstructor],
    ["a thenable", i => new Thenable(i)],
    ["a thenable that answers later", i => ({ then(resolve: Resolve): void { note("then is called"); outside().then(() => resolve("late " + i)); } })],
    ["a thenable that answers twice", i => ({ then(resolve: Resolve): void { note("then is called"); resolve("first " + i); resolve("second " + i); } })],
    ["a thenable that gives a thenable", i => ({ then(resolve: Resolve): void { note("the outer then is called"); resolve(new Thenable(i)); } })],
    ["a thenable that gives a promise", i => ({ then(resolve: Resolve): void { note("then is called"); resolve(doublesLater(i)); } })],
    ["a thenable that rejects", i => ({ then(_: Resolve, reject: Resolve): void { note("then is called"); reject(new RangeError("refused " + i)); } })],
    ["a thenable that throws", i => ({ then(): void { note("then is called"); throw new RangeError("thrown by then " + i); } })],
    ["a thenable that answers and then throws", i => ({ then(resolve: Resolve): void { resolve("answered " + i); throw new RangeError("too late " + i); } })],
    ["then is a number", i => ({ then: i })],
    ["then is a getter", i => Object.defineProperty({ n: i }, "then", { get() { note("then is read"); return undefined; }, enumerable: false })],
    ["then is a getter that throws", i => Object.defineProperty({ n: i }, "then", { get() { note("then is read"); throw new RangeError("thrown by the getter " + i); }, enumerable: false })],
    ["a record", i => ({ n: i })],
    ["a promise in a record", i => ({ n: i, inside: Promise.resolve(i) })],
    ["a promise in an array", i => [Promise.resolve(i)]],
];

async function* yieldsEach(make: Make, n: number): Stream {
    for (let i = 0; i < n; i++) { note("yields " + i); yield make(i); note("behind the yield " + i); }
    return "the end";
}
async function* yieldsByTurns(make: Make, n: number): Stream {
    for (let i = 0; i < n; i++) {
        try {
            note("yields " + i);
            yield i % 2 ? make(i) : i;
            note("behind the yield " + i);
        } catch (error) {
            note("the producer caught " + show(error));
        }
    }
    return "the end";
}
async function* returnsIt(make: Make): Stream {
    yield 0;
    note("returns");
    return make(1);
}
async function* returnsItFromATry(make: Make): Stream {
    try {
        yield 0;
        note("returns");
        return make(1);
    } catch (error) {
        note("the producer caught " + show(error));
        return "returned from the catch";
    } finally {
        note("the producer's finally");
    }
}
async function* relays(source: AsyncIterable<unknown>): Stream {
    for await (const x of source) { note("relays " + show(x)); yield x; }
    return "the relay's end";
}
async function* forwards(source: AsyncIterable<unknown> | Iterable<unknown>): Stream {
    const returned = yield* source;
    note("yield* was returned " + show(returned));
    return "the forwarder's end";
}
async function* forwardsAndCatches(source: AsyncIterable<unknown> | Iterable<unknown>): Stream {
    try {
        yield* source;
    } catch (error) {
        note("the forwarder caught " + show(error));
        yield "goes on behind the catch";
    }
    return "the forwarder's end";
}
function handWritten(label: string, n: number, make: Make): AsyncIterable<unknown> {
    let i = 0;
    return {
        [Symbol.asyncIterator]() {
            return {
                next(): Promise<IteratorResult<unknown, unknown>> {
                    note(label + ".next is called");
                    const result: IteratorResult<unknown, unknown> = i < n ? { value: make(i++), done: false } : { value: label + "'s end", done: true };
                    return Promise.resolve(result);
                },
                return(value?: unknown): Promise<IteratorResult<unknown, unknown>> {
                    note(label + ".return is called");
                    const result: IteratorResult<unknown, unknown> = { value, done: true };
                    return Promise.resolve(result);
                },
            };
        },
    };
}

async function consumes(source: AsyncIterable<unknown>, isResumedFirst: boolean): Promise<void> {
    if (isResumedFirst) await null;
    try {
        for await (const x of source) {
            note("got " + show(x));
            if (!(x instanceof Promise)) continue;
            try { note("in it is " + show(await x)); } catch (error) { note("it is rejected with " + show(error)); }
        }
        note("the loop is through");
    } catch (error) {
        note("the loop caught " + show(error));
    }
}
async function scene(title: string, make: () => AsyncIterable<unknown>): Promise<void> {
    for (const [company, isResumedFirst, jobs] of [["alone", true, 0], ["in its first run", false, 0], ["behind jobs", true, 14]] as [string, boolean, number][]) {
        log = [];
        const beside = jobs ? ticker("t", jobs) : undefined;
        await consumes(make(), isResumedFirst);
        await beside;
        out.push(title + ", " + company + ": " + log.join(" | "));
    }
}

for (const [what, make] of makers) {
    await scene("yields " + what, () => yieldsEach(make, 3));
    await scene("yields a number and " + what + " by turns", () => yieldsByTurns(make, 5));
    await scene("yields " + what + ", under for await", () => relays(yieldsByTurns(make, 4)));
    await scene("yields " + what + ", under yield*", () => forwards(yieldsByTurns(make, 4)));
    await scene("yields " + what + ", under yield* that catches", () => forwardsAndCatches(yieldsEach(make, 2)));
    await scene("returns " + what, () => forwards(returnsIt(make)));
    await scene("returns " + what + " from a try", () => forwards(returnsItFromATry(make)));
    await scene("a hand-written iterator gives " + what + ", under yield*", () => forwards(handWritten("h", 2, make)));
    await scene("a hand-written iterator gives " + what + ", under yield* twice", () => forwards(forwards(handWritten("h", 2, make))));
    await scene("a hand-written iterator gives " + what + ", under for await", () => relays(handWritten("h", 2, make)));
    await scene("an array holds " + what + ", under yield*", () => forwardsAndCatches([0, make(1), 2]));
}

// The thenable test of a step goes by what the object is now, not by what objects of its kind were.
class Parcel { constructor(public n: number) {} }
interface Reply { text: string; then?: (resolve: Resolve) => void; }
type Hook = (step: number) => void;
async function* yieldsParcels(n: number, hook: Hook): Stream {
    for (let i = 0; i < n; i++) { hook(i); yield new Parcel(i); }
    return "the end";
}
async function* yieldsTheSame(value: unknown, n: number, hook: Hook): Stream {
    for (let i = 0; i < n; i++) { hook(i); yield value; }
    return "the end";
}
// What the loop got, as runs of one kind: `Parcel{"n":#} x100, string opened # x3, ..`.
async function summarizes(source: Stream, hook: Hook): Promise<string> {
    await null;
    const runs: string[] = [];
    let kindOfRun = "", lengthOfRun = 0, seen = 0;
    for await (const x of source) {
        const kind = show(x).replace(/[0-9]+/, "#");
        if (kind !== kindOfRun) {
            if (lengthOfRun) runs.push(kindOfRun + " x" + lengthOfRun);
            kindOfRun = kind;
            lengthOfRun = 0;
        }
        lengthOfRun++;
        hook(++seen);
    }
    runs.push(kindOfRun + " x" + lengthOfRun);
    return runs.join(", ");
}
const doesNothing: Hook = () => {};
function between(from: number, to: number, give: () => void, take: () => void): Hook {
    return step => {
        if (step === from) give();
        if (step === to) take();
    };
}
const giveTheClass = (): void => { (Parcel.prototype as any).then = function (this: Parcel, resolve: Resolve): void { resolve("opened " + this.n); }; };
const takeFromTheClass = (): void => { delete (Parcel.prototype as any).then; };
async function report(title: string, jobs: number, run: () => Promise<string>): Promise<void> {
    const beside = jobs ? ticker("t", jobs) : undefined;
    const runs = await run();
    await beside;
    out.push(title + (jobs ? ", beside jobs: " : ", alone: ") + runs);
    log = [];
}
// Alone the objects go through a hundred times first. Beside jobs the stream is short, so that the jobs last longer than it does.
for (const [jobs, n, from] of [[0, 300, 100], [400, 30, 10]]) {
    const forThreeSteps = (give: () => void, take: () => void): Hook => between(from, from + 3, give, take);
    await report("the class gets a then from the loop", jobs, () => summarizes(yieldsParcels(n, doesNothing), forThreeSteps(giveTheClass, takeFromTheClass)));
    await report("the class gets a then from the producer", jobs, () => summarizes(yieldsParcels(n, forThreeSteps(giveTheClass, takeFromTheClass)), doesNothing));
    await report("the class gets a then from the loop, under a chain of three", jobs, () => summarizes(relays(forwards(yieldsParcels(n, doesNothing))), forThreeSteps(giveTheClass, takeFromTheClass)));
    await report("the class gets a then from the producer, under a chain of three", jobs, () => summarizes(forwards(relays(yieldsParcels(n, forThreeSteps(giveTheClass, takeFromTheClass)))), doesNothing));

    const parcel = new Parcel(7);
    const giveTheParcel = (): void => { (parcel as any).then = (resolve: Resolve): void => resolve("opened by its own then"); };
    const takeFromTheParcel = (): void => { delete (parcel as any).then; };
    await report("one instance gets a then from the loop", jobs, () => summarizes(yieldsTheSame(parcel, n, doesNothing), forThreeSteps(giveTheParcel, takeFromTheParcel)));
    await report("one instance gets a then from the producer", jobs, () => summarizes(yieldsTheSame(parcel, n, forThreeSteps(giveTheParcel, takeFromTheParcel)), doesNothing));

    const reply: Reply = { text: "bare" };
    const giveTheReply = (): void => { reply.then = resolve => resolve("the reply's field"); };
    const takeFromTheReply = (): void => { reply.then = undefined; };
    await report("a declared field gets a then from the loop", jobs, () => summarizes(yieldsTheSame(reply, n, doesNothing), forThreeSteps(giveTheReply, takeFromTheReply)));
    await report("a declared field gets a then from the producer", jobs, () => summarizes(yieldsTheSame(reply, n, forThreeSteps(giveTheReply, takeFromTheReply)), doesNothing));

    const parent: { then?: (resolve: Resolve) => void } = {};
    const child: unknown = Object.create(parent);
    const giveTheParent = (): void => { parent.then = resolve => resolve("the parent's then"); };
    const takeFromTheParent = (): void => { delete parent.then; };
    await report("the prototype of a plain object gets a then from the loop", jobs, () => summarizes(yieldsTheSame(child, n, doesNothing), forThreeSteps(giveTheParent, takeFromTheParent)));
    await report("the prototype of a plain object gets a then from the producer", jobs, () => summarizes(yieldsTheSame(child, n, forThreeSteps(giveTheParent, takeFromTheParent)), doesNothing));
}
console.log(out.join("\n"));
export {};
//// async-generators-and-for-await.ts
// Async generators and `for await`.
const log: string[] = []
const say = (s: string) => { log.push(s) }
const later = <T,>(v: T): Promise<T> => new Promise(resolve => resolve(v))
async function* count(n: number): AsyncGenerator<number, string, unknown> { for (let i = 0; i < n; i++) { say("before " + i); yield await later(i); say("after " + i) } return "finished" }
async function* guarded(): AsyncGenerator<number, string, unknown> { try { yield 1; yield 2; return "end" } catch (e) { say("caught " + e); yield 99; return "recovered" } finally { say("cleanup"); await later(0); say("cleaned") } }
async function* outer(): AsyncGenerator<number | string> { const r = yield* count(2); yield r; yield* [7, Promise.resolve(8)]; yield* guarded() }
function* sync() { yield 1; yield Promise.resolve(2); yield 3 }
async function main(): Promise<void> {
  let total = 0
  for await (const n of count(3)) total += n
  say("total " + total)
  for await (const n of guarded()) { say("got " + n); if (n === 1) break }
  try { for await (const n of guarded()) { say("got " + n); throw new Error("body") } } catch (e) { say((e as Error).message) }
  for await (const v of sync()) say("sync " + v)
  for await (const v of [later("a"), "b"]) say("array " + v)
  const all: (number | string)[] = []
  for await (const v of outer()) all.push(v)
  say(all.join())
  const g = count(2)
  const queued = [g.next(), g.next(), g.next(), g.next()]
  say(JSON.stringify(await Promise.all(queued)))
  const h = guarded(); await h.next()
  say(JSON.stringify(await h.throw("boom")) + JSON.stringify(await h.next()) + JSON.stringify(await h.next()))
  const r = guarded(); await r.next()
  say(JSON.stringify(await r.return("early")) + JSON.stringify(await r.return(later("again"))))
  const unstarted = guarded()
  say(JSON.stringify(await unstarted.return("never")) + " " + Object.prototype.toString.call(unstarted) + " " + (unstarted[Symbol.asyncIterator]() === unstarted))
  try { await guarded().throw(new Error("unstarted")) } catch (e) { say((e as Error).message) }
}
function old() { return arguments.length + ":" + Array.prototype.join.call(arguments, "-") + ":" + typeof arguments + ":" + Object.prototype.toString.call(arguments) }
function named(a: number, b = 5) { return a + b + arguments.length }
function viaArrow(this: unknown, a: number) { const inner = () => () => arguments.length + ":" + arguments[1] + ":" + a; return inner()() }
function withRest(first: number, ...others: number[]) { return arguments.length + ":" + first + ":" + others.join("+") }
say((viaArrow as any)(1, "second") + " " + withRest(1, 2, 3) + " " + withRest(9))
say((old as any)(1, "two", 3) + " " + (old as any)() + " " + named(1) + " " + named(1, 2))
main().then(() => console.log(log.join("\n")), e => console.log("failed", e, log.join("\n")))
//// async-generators-wake-suspended-consumers.ts
// A source that waits for something outside the pipeline wakes up while all its consumers are suspended. Each case logs the order in which the layers, other jobs and clean-up code run.
import { AsyncLocalStorage } from "node:async_hooks";
const storage = new AsyncLocalStorage<string>();
let lines: string[] = [];
const log = (text: string) => { lines.push(text); };
const show = (value: unknown): string => (value === undefined ? "undefined" : JSON.stringify(value));
type Stream = AsyncGenerator<any, any, any>;
let deliver: (value: any) => void = () => {};
let fail: (error: Error) => void = () => {};
const arrival = () => new Promise<any>((resolve, reject) => { deliver = resolve; fail = reject; });
const turns = async (count: number) => { for (let i = 0; i < count; i++) await null; };
async function* source(count: number): Stream {
  try {
    for (let i = 0; i < count; i++) { const value = await arrival(); log("source has " + show(value)); yield value; }
    return "source ended";
  } finally { log("source cleans up"); }
}
async function* relay(name: string, input: AsyncIterable<any>): Stream {
  try {
    for await (const value of input) { log(name + " has " + show(value)); yield value; log(name + " goes on"); }
  } finally { log(name + " cleans up"); }
}
async function* delegate(name: string, input: Stream): Stream {
  const result = yield* input;
  log(name + " got " + show(result));
  return result;
}
async function* throwsAt(limit: number, input: AsyncIterable<any>): Stream {
  let seen = 0;
  for await (const value of input) { if (++seen === limit) throw new Error("layer failed at " + seen); yield value; }
}
async function consume(name: string, input: AsyncIterable<any>, stopAt = Infinity): Promise<string> {
  let seen = 0;
  try {
    for await (const value of input) {
      log(name + " has " + show(value));
      Promise.resolve().then(() => log(name + "'s job"));
      if (++seen === stopAt) break;
    }
  } catch (error) { log(name + " caught " + (error as Error).message); }
  return name + " saw " + seen;
}
async function scene(title: string, run: () => Promise<void>) {
  lines = [];
  await run();
  await turns(40);
  console.log(title + ": " + lines.join(" | "));
}

await scene("three layers", async () => {
  const done = consume("top", relay("b", relay("a", source(2))));
  for (const value of [1, { v: 2 }, 3]) { await turns(10); log("deliver"); deliver(value); }
  log(await done);
});
await scene("delegation", async () => {
  const done = consume("top", delegate("outer", delegate("inner", source(2))));
  for (const value of ["x", "y", "z"]) { await turns(10); log("deliver"); deliver(value); }
  log(await done);
});
await scene("another job is queued first", async () => {
  const done = consume("top", relay("a", source(2)));
  await turns(10);
  deliver(1); Promise.resolve().then(() => log("job behind the delivery")).then(() => log("second job"));
  await turns(10);
  Promise.resolve().then(() => log("job in front of the delivery")); deliver(2);
  await turns(10); deliver(3);
  log(await done);
});
await scene("a layer throws", async () => {
  const done = consume("top", relay("b", throwsAt(2, relay("a", source(5)))));
  for (const value of [1, 2]) { await turns(10); deliver(value); }
  log(await done);
});
await scene("the source is rejected", async () => {
  const done = consume("top", relay("a", source(5)));
  await turns(10); deliver(1); await turns(10); fail(new Error("no more"));
  log(await done);
});
await scene("the consumer leaves", async () => {
  const done = consume("top", relay("b", relay("a", source(5))), 2);
  for (const value of [1, 2]) { await turns(10); deliver(value); }
  log(await done);
});
await scene("promises and thenables are yielded", async () => {
  async function* unwraps(input: AsyncIterable<any>): Stream { for await (const box of input) yield box[0]; }
  const done = consume("top", relay("b", unwraps(relay("a", source(5)))));
  const thenable = { then(resolve: (value: string) => void) { log("then is called"); resolve("from then"); } };
  for (const value of [Promise.resolve("settled"), thenable, [thenable], null, turns(3).then(() => "late"), 0]) { await turns(16); deliver([value]); }
  log(await done);
});
await scene("several requests wait", async () => {
  const middle = relay("a", source(3));
  const requests = [middle.next(), middle.next(), middle.next("sent")];
  for (const value of [1, 2, 3]) { await turns(10); deliver(value); }
  for (const request of requests) log(show(await request));
  log(show(await middle.return("closed")));
});
await scene("two consumers share a generator", async () => {
  const shared = relay("shared", source(4));
  const both = [consume("first", shared), consume("second", shared)];
  for (const value of [1, 2, 3, 4, 5]) { await turns(12); deliver(value); }
  for (const each of both) log(await each);
});
await scene("async contexts", async () => {
  async function* reads(name: string, input: AsyncIterable<any>): Stream { for await (const value of input) { log(name + " in " + storage.getStore()); yield value; } }
  const done = storage.run("consumer", async () => { for await (const value of reads("b", storage.run("inner", () => reads("a", source(2))))) log("top in " + storage.getStore() + " has " + value); });
  for (const value of [1, 2, 3]) { await turns(10); storage.run("deliverer " + value, () => deliver(value)); }
  await done;
});
await scene("collections between the layers", async () => {
  async function* collects(input: AsyncIterable<any>): Stream { for await (const value of input) { Bun.gc(true); yield { kept: value, more: [value, value] }; } }
  const done = consume("top", collects(collects(source(2))));
  for (const value of [{ a: 1 }, "text" + lines.length, 3]) { await turns(10); deliver(value); Bun.gc(true); }
  log(await done);
});
await scene("two hundred layers", async () => {
  let stream: Stream = source(2);
  for (let i = 0; i < 100; i++) stream = delegate2(plain(stream));
  let sum = 0;
  const done = (async () => { for await (const value of stream) sum += value; })();
  for (const value of [5, 7, 9]) { await turns(400); deliver(value); }
  await done; log("sum " + sum);
});
async function* plain(input: AsyncIterable<any>): Stream { for await (const value of input) yield value + 1; }
async function* delegate2(input: Stream): Stream { return yield* input; }
await scene("errors name the layers", async () => {
  async function* inner(input: AsyncIterable<any>): Stream { for await (const value of input) yield value; }
  async function outer(input: AsyncIterable<any>) { for await (const value of input) { const names = (new Error("here").stack ?? "").split("\n").slice(1).map(line => /at (?:async )?([\w.]+)/.exec(line)?.[1] ?? "?"); log(value + " in " + names.filter(name => name === "outer" || name === "inner" || name === "source").join(",")); } }
  const done = outer(inner(source(1)));
  await turns(10); deliver("a"); await turns(10); deliver("b");
  await done;
});
//// async-iterator-steps.js
// Steps of `for await` and `yield*` whose next method is one of the two built-in async ones: driven by an async function, an async generator and a module body, with an empty and a busy job queue.
// Also the cases that must stay ordinary calls: another next method, a receiver that is no generator, and next() written in the source, whose result objects the program keeps.
const lines = [];
const note = text => void lines.push(text);
const show = value => (value instanceof Error ? `${value.name}: ${value.message}` : JSON.stringify(value));

async function* count(label, limit) {
  try {
    for (let i = 0; i < limit; i++) yield label + i;
    return label + " result";
  } finally {
    note(label + " closed");
  }
}

async function* countAfterAwaits(label, limit) {
  for (let i = 0; i < limit; i++) {
    await null;
    yield await Promise.resolve(label + i);
  }
}

async function* echo(label) {
  let received = yield label + " started";
  while (received !== "stop") received = yield label + " got " + show(received);
  return label + " stopped";
}

async function* failsAt(label, limit) {
  for (let i = 0; i < limit; i++) yield label + i;
  throw new Error(label + " failed");
}

////= lines-33	driveFromFunction	note

async function* driveFromGenerator(source) {
  for await (const value of source) yield "relayed " + value;
}

async function* delegate(source) {
  const result = yield* source;
  yield "delegate result " + show(result);
}

function withBusyQueue(turns) {
  let turn = 0;
  const tick = () => {
    if (++turn <= turns) queueMicrotask(tick);
  };
  queueMicrotask(tick);
}

async function drivers() {
  await driveFromFunction("function", count("a", 3));
  await driveFromFunction("function, broken off", count("b", 3), 2);
  await driveFromFunction("function, awaits inside", countAfterAwaits("c", 3));
  await driveFromFunction("function, failure", failsAt("d", 2));
  await driveFromFunction("generator", driveFromGenerator(count("e", 3)));
  await driveFromFunction("generator, awaits inside", driveFromGenerator(countAfterAwaits("f", 3)));
  await driveFromFunction("generator, failure", driveFromGenerator(failsAt("g", 2)));
  await driveFromFunction("delegate", delegate(count("h", 2)));
  await driveFromFunction("delegate twice", delegate(delegate(count("i", 2))));
  await driveFromFunction("delegate, failure", delegate(failsAt("j", 1)));
  await driveFromFunction("empty", count("k", 0));
  withBusyQueue(40);
  await driveFromFunction("function, busy queue", count("l", 3));
  await driveFromFunction("generator, busy queue", driveFromGenerator(countAfterAwaits("m", 3)));
  await driveFromFunction("delegate, busy queue", delegate(count("n", 2)));
}

async function sentValues() {
  const outer = delegate(echo("echo"));
  for (const sent of [undefined, 1, { a: 1 }, undefined, "stop", "late"]) note("sent " + show(sent) + ": " + show(await outer.next(sent)));

  function argumentCounter() {
    let calls = 0;
    return {
      [Symbol.iterator]() {
        return this;
      },
      next(...sent) {
        return { done: ++calls > 3, value: `${sent.length} arguments ${show(sent)}` };
      },
    };
  }
  await driveFromFunction("sync next from for await", argumentCounter());
  const overSync = delegate(argumentCounter());
  for (const sent of ["first", "second", undefined, "fourth"]) note("sync next from yield*: " + show(await overSync.next(sent)));
}

async function otherNextMethods() {
  const builtinNext = Object.getPrototypeOf(count.prototype).next;
  const impostor = {
    next: builtinNext,
    [Symbol.asyncIterator]() {
      return this;
    },
  };
  await driveFromFunction("built-in next, receiver is no generator", impostor);
  await driveFromFunction("built-in next, receiver is no generator, delegated", delegate(impostor));

  const borrowed = count("o", 2);
  const borrower = {
    next: value => builtinNext.call(borrowed, value),
    [Symbol.asyncIterator]() {
      return this;
    },
  };
  await driveFromFunction("own next that borrows the built-in one", borrower);

  const replaced = count("p", 4);
  const seen = [];
  for await (const value of replaced) {
    seen.push(value);
    if (value === "p0") replaced.next = () => Promise.resolve({ done: true, value: "never read" });
    if (value === "p2") delete replaced.next;
  }
  note("next replaced inside the loop: " + seen.join(", "));

  const overridden = count("q", 4);
  let calls = 0;
  overridden.next = () => Promise.resolve({ done: ++calls > 2, value: "own " + calls });
  const fromOwn = [];
  for await (const value of overridden) {
    fromOwn.push(value);
    delete overridden.next;
  }
  note("own next removed inside the loop: " + fromOwn.join(", "));
}

async function keptResults() {
  const generator = count("r", 3);
  const first = await generator.next();
  const second = await generator.next();
  note(`results of next() in the source: ${first !== second}, ${show(first)}, ${show(second)}`);

  const shared = count("s", 6);
  const kept = [];
  for await (const value of shared) {
    kept.push(value);
    if (value === "s0" || value === "s2") kept.push(shared.next());
  }
  const settled = await Promise.all(kept);
  note("next() inside a loop over the same generator: " + settled.map(show).join(", "));
  const objects = settled.filter(step => typeof step === "object");
  note("kept results are distinct: " + (objects[0] !== objects[1]));
}

async function alternatingLoops() {
  const seen = [];
  async function loop(label, source) {
    for await (const value of source) {
      seen.push(label + value);
      await null;
    }
  }
  await Promise.all([loop("x:", count("t", 3)), loop("y:", countAfterAwaits("u", 3)), loop("z:", delegate(count("v", 2)))]);
  note("three loops at once: " + seen.join(", "));

  const nested = [];
  for await (const outer of count("w", 2)) {
    for await (const inner of count(outer + "/", 2)) nested.push(inner);
  }
  note("nested loops: " + nested.join(", "));
}

await drivers();
await sentValues();
await otherNextMethods();
await keptResults();
await alternatingLoops();

const atTopLevel = [];
for await (const value of count("module", 3)) atTopLevel.push(value);
for await (const value of driveFromGenerator(countAfterAwaits("module relay", 2))) atTopLevel.push(value);
for await (const value of [Promise.resolve("array 0"), "array 1"]) atTopLevel.push(value);
note("module body: " + atTopLevel.join(", "));

console.log(lines.join("\n"));
//// async-iterator-steps-interpreted-generators.js
// Async generators created from text at run time have the same built-in next method as compiled ones, so compiled `for await` and `yield*` step them too. They are not compiled generators: each step is an ordinary call.
// Interpreted loops over compiled generators go the other way.
const lines = [];
const show = value => (value instanceof Error ? `${value.name}: ${value.message}` : JSON.stringify(value));

const interpreted = new Function(`
  return {
    async *count(label, limit) {
      for (let i = 0; i < limit; i++) yield label + i;
      return label + " result";
    },
    async *countAfterAwaits(label, limit) {
      for (let i = 0; i < limit; i++) {
        await null;
        yield await Promise.resolve(label + i);
      }
    },
    async *echo(label) {
      let received = yield label + " started";
      while (received !== "stop") received = yield label + " got " + JSON.stringify(received);
      return label + " stopped";
    },
    async *failsAt(label, limit) {
      for (let i = 0; i < limit; i++) yield label + i;
      throw new Error(label + " failed");
    },
    async *relay(source) {
      for await (const value of source) yield "interpreted relay of " + value;
    },
    async *delegate(source) {
      return yield* source;
    },
  };
`)();

async function* count(label, limit) {
  for (let i = 0; i < limit; i++) yield label + i;
  return label + " result";
}

async function* relay(source) {
  for await (const value of source) yield "relay of " + value;
}

async function* delegate(source) {
  const result = yield* source;
  yield "delegate result " + show(result);
}

////= lines-33	collect	lines.push

lines.push("one next method: " + (interpreted.count("", 0).next === count("", 0).next));

await collect("function", interpreted.count("a", 3));
await collect("function, broken off", interpreted.count("b", 3), 2);
await collect("function, awaits inside", interpreted.countAfterAwaits("c", 3));
await collect("function, failure", interpreted.failsAt("d", 2));
await collect("function, empty", interpreted.count("e", 0));
await collect("generator", relay(interpreted.count("f", 3)));
await collect("generator, failure", relay(interpreted.failsAt("g", 1)));
await collect("delegate", delegate(interpreted.count("h", 2)));
await collect("delegate, failure", delegate(interpreted.failsAt("i", 1)));
await collect("interpreted loop over compiled", interpreted.relay(count("j", 3)));
await collect("interpreted delegate to compiled", delegate(interpreted.delegate(count("k", 2))));
await collect("alternating", relay(interpreted.relay(relay(interpreted.count("l", 2)))));

const outer = delegate(interpreted.echo("echo"));
for (const sent of [undefined, 1, { a: 1 }, undefined, "stop", "late"]) lines.push("sent " + show(sent) + ": " + show(await outer.next(sent)));

const order = [];
async function loop(label, source) {
  for await (const value of source) {
    order.push(label + value);
    await null;
  }
}
await Promise.all([loop("x:", count("m", 3)), loop("y:", interpreted.count("n", 3)), loop("z:", interpreted.countAfterAwaits("o", 2)), loop("w:", delegate(interpreted.count("p", 2)))]);
lines.push("four loops at once: " + order.join(", "));

const finished = interpreted.count("q", 1);
await collect("first loop", finished);
await collect("second loop over a finished generator", finished);

console.log(lines.join("\n"));
//// async-local-storage-across-streams.ts
// The store of an AsyncLocalStorage on both sides of every handover between async generators and async functions of the program, where somebody waits in earnest:
// next() written out and awaited by a function or by a generator in a store of its own; helpers awaited by generators; relays; two consumers in two stores that
// pull one stream in turn; a store entered in the middle. Waits are jobs (nothing else queued), jobs beside a ticker, and timers.
import { AsyncLocalStorage } from "node:async_hooks";

let log: string[] = [];
////= note
const storage = new AsyncLocalStorage<string>();
function where(): string {
    return storage.getStore() ?? "-";
}
type Wait = () => Promise<void>;
const waits: [string, Wait][] = [
    ["jobs", () => new Promise(resolve => { Promise.resolve().then(() => undefined).then(() => resolve()); })],
    ["a timer", () => new Promise(resolve => setTimeout(resolve, 1))],
    ["jobs in a store of their own", () => storage.run("w", () => new Promise<void>(resolve => { Promise.resolve().then(() => undefined).then(() => resolve()); }))],
];
function ticker(turns: number): Promise<void> {
    let last: Promise<void> = Promise.resolve();
    for (let i = 1; i <= turns; i++) last = last.then(() => undefined);
    return last;
}
async function* source(wait: Wait, n: number): AsyncGenerator<string, string> {
    for (let i = 0; i < n; i++) {
        note("source ahead of its wait in " + where());
        await wait();
        note("source behind its wait in " + where());
        yield "s" + i + "@" + where();
        note("source behind its yield in " + where());
    }
    return "over@" + where();
}
async function pulls(from: AsyncGenerator<string, string>, label: string): Promise<void> {
    for (;;) {
        const step = await from.next();
        note(label + " got " + step.value + " in " + where());
        if (step.done) return;
    }
}
async function* pullsAndYields(from: AsyncGenerator<string, string>, label: string): AsyncGenerator<string, string> {
    for (;;) {
        const step = await from.next();
        note(label + " got " + step.value + " in " + where());
        if (step.done) return step.value + "<" + where();
        yield step.value + "<" + where();
    }
}
async function* relay(from: AsyncGenerator<string, string>, store: string | null): AsyncGenerator<string, string> {
    async function pulled(): Promise<IteratorResult<string, string>> {
        const step = await from.next();
        note("pulled() behind next() in " + where());
        return step;
    }
    while (true) {
        const step = await (store === null ? pulled() : storage.run(store, pulled));
        note("relay behind pulled() in " + where());
        if (step.done === true) return step.value;
        yield step.value;
    }
}
async function helper(wait: Wait, i: number, store: string | null): Promise<{ n: number; at: string }> {
    if (store !== null) storage.enterWith(store);
    await wait();
    note("helper behind its wait in " + where());
    return { n: i, at: where() };
}
async function* awaitsHelpers(wait: Wait, store: string | null): AsyncGenerator<string> {
    for (let i = 0; i < 2; i++) {
        const made = await helper(wait, i, store);
        note("generator behind the helper in " + where());
        yield made.n + "@" + made.at + "<" + where();
    }
}
async function* entersAStore(wait: Wait): AsyncGenerator<string> {
    await wait();
    yield "before " + where();
    storage.enterWith("entered");
    await wait();
    yield "behind " + where();
}
async function collect(from: AsyncIterable<string>, label: string): Promise<void> {
    for await (const x of from) note(label + " got " + x + " in " + where());
    note(label + " is through in " + where());
}
async function inTurn(from: AsyncGenerator<string, string>): Promise<void> {
    const one = (label: string) => storage.run(label, async () => { const step = await from.next(); note(label + " got " + step.value + " in " + where()); });
    await one("x"); await one("y"); await Promise.all([one("x"), one("y")]); await one("x");
}
const lines: string[] = [];
async function scene(title: string, run: () => Promise<unknown>): Promise<void> {
    for (const beside of [false, true]) {
        log = [];
        await (beside ? Promise.all([ticker(30), run()]) : run());
        lines.push(title + (beside ? ", beside jobs" : "") + ": " + log.join(" | ") + " | at the end " + where());
    }
}
for (const [kind, wait] of waits) {
    await scene(kind + ": a function pulls, no store", () => pulls(source(wait, 2), "f"));
    await scene(kind + ": a function pulls in a", () => storage.run("a", () => pulls(source(wait, 2), "f")));
    await scene(kind + ": made in m, pulled in a", () => { const made = storage.run("m", () => source(wait, 2)); return storage.run("a", () => pulls(made, "f")); });
    await scene(kind + ": begun in m, pulled on in a", async () => { const made = source(wait, 3); await storage.run("m", async () => { note("first " + (await made.next()).value); }); await storage.run("a", () => pulls(made, "f")); });
    await scene(kind + ": a generator pulls in a, its consumer in b", () => { const middle = storage.run("a", () => pullsAndYields(source(wait, 2), "g")); return storage.run("b", () => collect(middle, "c")); });
    await scene(kind + ": a generator pulls, pulled by a function in b", () => storage.run("b", () => pulls(pullsAndYields(source(wait, 2), "g"), "f")));
    await scene(kind + ": relayed", () => storage.run("a", () => collect(relay(source(wait, 2), null), "c")));
    await scene(kind + ": relayed, pulled() in p", () => storage.run("a", () => collect(relay(source(wait, 2), "p"), "c")));
    await scene(kind + ": relayed twice", () => storage.run("a", () => collect(relay(relay(source(wait, 2), "p"), "q"), "c")));
    await scene(kind + ": helpers", () => storage.run("a", () => collect(awaitsHelpers(wait, null), "c")));
    await scene(kind + ": helpers that enter h", () => storage.run("a", () => collect(awaitsHelpers(wait, "h"), "c")));
    await scene(kind + ": helpers, no store", () => collect(awaitsHelpers(wait, null), "c"));
    await scene(kind + ": a store entered in the middle", () => storage.run("a", () => collect(entersAStore(wait), "c")));
    await scene(kind + ": two consumers in turn", () => inTurn(source(wait, 6)));
}
console.log(lines.join("\n"));
//// async-many-live-locals.ts
// An async function with many live local variables awaits other async functions on some paths and not on others.
declare const console: { log(...v: unknown[]): void };
async function g(a: number): Promise<number> { return a * 2; }
async function wide(a: number, flag: boolean): Promise<number> {
    const v0 = a * 2 + 0;
    const v1 = a * 3 + 1;
    const v2 = a * 4 + 2;
    const v3 = a * 5 + 3;
    const v4 = a * 6 + 4;
    const v5 = a * 7 + 5;
    const v6 = a * 8 + 6;
    const v7 = a * 9 + 7;
    const v8 = a * 10 + 8;
    const v9 = a * 11 + 9;
    const v10 = a * 12 + 10;
    const v11 = a * 13 + 11;
    let t = 0;
    if (flag) t += await g(0); else t -= await g(1);
    if (flag) t += await g(2); else t -= await g(3);
    if (flag) t += await g(4); else t -= await g(5);
    if (flag) t += await g(6); else t -= await g(7);
    if (flag) t += await g(8); else t -= await g(9);
    if (flag) t += await g(10); else t -= await g(11);
    if (flag) t += await g(12); else t -= await g(13);
    if (flag) t += await g(14); else t -= await g(15);
    if (flag) t += await g(16); else t -= await g(17);
    if (flag) t += await g(18); else t -= await g(19);
    return t + v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11;
}
async function straight(a: number): Promise<number> {
    const v0 = a * 2 + 0;
    const v1 = a * 3 + 1;
    const v2 = a * 4 + 2;
    const v3 = a * 5 + 3;
    const v4 = a * 6 + 4;
    const v5 = a * 7 + 5;
    const v6 = a * 8 + 6;
    const v7 = a * 9 + 7;
    const v8 = a * 10 + 8;
    const v9 = a * 11 + 9;
    const v10 = a * 12 + 10;
    const v11 = a * 13 + 11;
    let t = 0;
    t += await g(0);
    t += await g(1);
    t += await g(2);
    t += await g(3);
    t += await g(4);
    t += await g(5);
    t += await g(6);
    t += await g(7);
    t += await g(8);
    t += await g(9);
    return t + v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11;
}
async function looped(a: number, n: number): Promise<number> {
    const v0 = a * 2 + 0;
    const v1 = a * 3 + 1;
    const v2 = a * 4 + 2;
    const v3 = a * 5 + 3;
    const v4 = a * 6 + 4;
    const v5 = a * 7 + 5;
    const v6 = a * 8 + 6;
    const v7 = a * 9 + 7;
    const v8 = a * 10 + 8;
    const v9 = a * 11 + 9;
    const v10 = a * 12 + 10;
    const v11 = a * 13 + 11;
    let t = 0;
    for (let i = 0; i < n; i++) { if (i & 1) t += await g(i); else t -= await g(i + 1); try { t += await g(t); } catch (e) { t = -1; } }
    return t + v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11;
}
async function changing(a: number, flag: boolean): Promise<number> {
    let x = a, y = a + 1, z = a + 2;
    if (flag) { x += await g(0); } else { y += await g(1); }
    if (x > y) z = x - y;
    if (flag) { x += await g(1); } else { y += await g(2); }
    if (x > y) z = x - y;
    if (flag) { x += await g(2); } else { y += await g(3); }
    if (x > y) z = x - y;
    if (flag) { x += await g(3); } else { y += await g(4); }
    if (x > y) z = x - y;
    return x * 100 + y * 10 + z;
}
function* gen(a: number, flag: boolean): Generator<number> {
    const v0 = a * 2 + 0;
    const v1 = a * 3 + 1;
    const v2 = a * 4 + 2;
    const v3 = a * 5 + 3;
    const v4 = a * 6 + 4;
    const v5 = a * 7 + 5;
    if (flag) yield 0; else yield 0;
    if (flag) yield 1; else yield -1;
    if (flag) yield 2; else yield -2;
    if (flag) yield 3; else yield -3;
    if (flag) yield 4; else yield -4;
    yield v0 + v1 + v2 + v3 + v4 + v5;
}
(globalThis as any).kept = [g, wide, straight, looped, changing, gen];
Promise.all([wide(1, true), wide(2, false), straight(3), looped(4, 5), looped(1, 0), changing(1, true), changing(5, false)]).then(r => console.log(r.join(), [...gen(1, true)].join(), [...gen(2, false)].join()));
//// async-result-class-thenable.ts
// An async function that returns an object whose class has a `then` method adopts it. A typed object without one, in the same program, is still handed over as a value.
const log: string[] = []
const say = (s: string) => { log.push(s) }

////= lines-26	Point	x
class HasThen {
  then(resolve: (v: string) => void) { say("HasThen.then"); resolve("adopted from class") }
}

function describe(value: unknown): string {
  if (value instanceof Point) return "Point " + value.x
  if (value instanceof HasThen) return "HasThen was not adopted"
  return typeof value + " " + String(value)
}

async function returnPoint(): Promise<Point> { return new Point(2) }
async function returnHasThen(): Promise<string> { return new HasThen() as any }
async function pointAfterAwait(): Promise<Point> { await null; return new Point(2) }
async function hasThenAfterAwait(): Promise<string> { await null; return new HasThen() as any }

const cases: [string, () => Promise<unknown>][] = [
  ["point", returnPoint],
  ["has then", returnHasThen],
  ["point after await", pointAfterAwait],
  ["has then after await", hasThenAfterAwait],
]

function attach(name: string, promise: Promise<unknown>) {
  promise.then(v => say(name + " fulfilled: " + describe(v)), e => say(name + " rejected: " + describe(e)))
}

async function awaitedInLoop(): Promise<void> {
  for (let i = 0; i < 3; i++) {
    say("loop " + i + " " + describe(await returnPoint()))
    say("loop " + i + " " + describe(await returnHasThen()))
    say("loop " + i + " " + describe(await pointAfterAwait()))
    say("loop " + i + " " + describe(await hasThenAfterAwait()))
  }
}

say("start")
Promise.resolve().then(() => say("tick 1")).then(() => say("tick 2")).then(() => say("tick 3")).then(() => say("tick 4")).then(() => say("tick 5"))
for (const [name, run] of cases) attach(name, run())
for (const [name, run] of cases) {
  const promise = run()
  attach("first reaction, " + name, promise)
  attach("second reaction, " + name, promise)
}
awaitedInLoop().then(() => say("loop done"))
say("end of script")
setTimeout(() => console.log(log.join("\n")), 0)
//// async-result-resolution.ts
// How an async function settles its promise for each kind of result, and the order of every callback. No class here has a method named `then`: async-result-class-thenable.ts has one.
const log: string[] = []
const say = (s: string) => { log.push(s) }

////= lines-26	Point	x
////= lines-26	Size	width

function pointWithThen(x: number): Point {
  const p = new Point(x)
  ;(p as any).then = (resolve: (v: string) => void) => { say("extra then"); resolve("adopted from extra property") }
  return p
}
function throwingThenable(): any {
  return { then() { say("throwing then"); throw new Error("thenable threw") } }
}
function describe(value: unknown): string {
  if (value instanceof Point) return "Point " + value.x
  if (value instanceof Size) return "Size " + value.width
  if (value instanceof Error) return "Error " + value.message
  return typeof value + " " + String(value)
}

async function returnNumber(): Promise<number> { return 1 }
async function returnString(): Promise<string> { return "text" }
async function returnUndefined(): Promise<undefined> { return undefined }
async function returnPoint(): Promise<Point> { return new Point(2) }
async function returnPointWithThen(): Promise<Point | string> { return pointWithThen(3) }
async function returnSize(): Promise<Size> { return new Size(5) }
async function returnPromise(): Promise<number> { return Promise.resolve(4) }
async function returnThrowingThenable(): Promise<number> { return throwingThenable() }
async function throwError(): Promise<number> { throw new Error("thrown") }

async function numberAfterAwait(): Promise<number> { await null; return 1 }
async function stringAfterAwait(): Promise<string> { await null; return "text" }
async function undefinedAfterAwait(): Promise<undefined> { await null; return undefined }
async function pointAfterAwait(): Promise<Point> { await null; return new Point(2) }
async function pointWithThenAfterAwait(): Promise<Point | string> { await null; return pointWithThen(3) }
async function sizeAfterAwait(): Promise<Size> { await null; return new Size(5) }
async function promiseAfterAwait(): Promise<number> { await null; return Promise.resolve(4) }
async function throwingThenableAfterAwait(): Promise<number> { await null; return throwingThenable() }
async function throwErrorAfterAwait(): Promise<number> { await null; throw new Error("thrown") }

const direct: [string, () => Promise<unknown>][] = [
  ["number", returnNumber],
  ["string", returnString],
  ["undefined", returnUndefined],
  ["point", returnPoint],
  ["point with then", returnPointWithThen],
  ["size", returnSize],
  ["promise", returnPromise],
  ["throwing thenable", returnThrowingThenable],
  ["throw", throwError],
]
const afterAwait: [string, () => Promise<unknown>][] = [
  ["number after await", numberAfterAwait],
  ["string after await", stringAfterAwait],
  ["undefined after await", undefinedAfterAwait],
  ["point after await", pointAfterAwait],
  ["point with then after await", pointWithThenAfterAwait],
  ["size after await", sizeAfterAwait],
  ["promise after await", promiseAfterAwait],
  ["throwing thenable after await", throwingThenableAfterAwait],
  ["throw after await", throwErrorAfterAwait],
]

function attach(name: string, promise: Promise<unknown>) {
  promise.then(v => say(name + " fulfilled: " + describe(v)), e => say(name + " rejected: " + describe(e)))
}

async function awaitedInLoop(): Promise<void> {
  for (let i = 0; i < 3; i++) {
    say("loop " + i + " number " + (await returnNumber()))
    say("loop " + i + " string " + (await returnString()))
    say("loop " + i + " undefined " + (await returnUndefined()))
    say("loop " + i + " " + describe(await returnPoint()))
    say("loop " + i + " " + describe(await returnPointWithThen()))
    say("loop " + i + " " + describe(await returnSize()))
    say("loop " + i + " promise " + (await returnPromise()))
    say("loop " + i + " number after await " + (await numberAfterAwait()))
    say("loop " + i + " " + describe(await pointAfterAwait()))
    say("loop " + i + " " + describe(await pointWithThenAfterAwait()))
    say("loop " + i + " " + describe(await sizeAfterAwait()))
    try { await returnThrowingThenable() } catch (e) { say("loop " + i + " caught " + describe(e)) }
    try { await throwingThenableAfterAwait() } catch (e) { say("loop " + i + " caught " + describe(e)) }
    try { await throwError() } catch (e) { say("loop " + i + " caught " + describe(e)) }
    try { await throwErrorAfterAwait() } catch (e) { say("loop " + i + " caught " + describe(e)) }
  }
}

say("start")
Promise.resolve().then(() => say("tick 1")).then(() => say("tick 2")).then(() => say("tick 3")).then(() => say("tick 4")).then(() => say("tick 5"))
for (const [name, run] of direct) attach(name, run())
for (const [name, run] of afterAwait) attach(name, run())
for (const [name, run] of afterAwait) {
  const promise = run()
  attach("first reaction, " + name, promise)
  attach("second reaction, " + name, promise)
}
awaitedInLoop().then(() => say("loop done"))
say("end of script")
