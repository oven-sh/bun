    calls = 0; await byNext(how + ", next", large(3, waits, -1));
    calls = 0; await byLoop(how + ", forwarded", forwards(forwards(large(3, waits, -1))));
    calls = 0; await byNext(how + ", forwarded, next", forwards(large(3, waits, -1)));
    calls = 0; await byLoop(how + ", throws", large(3, waits, 1));
    calls = 0; await byNext(how + ", throws, forwarded", forwards(large(3, waits, 2)));
    calls = 0; await Promise.all([byLoop(how + ", side by side, first", large(2, waits, -1)), byNext(how + ", side by side, second", large(2, waits, -1))]);
}
