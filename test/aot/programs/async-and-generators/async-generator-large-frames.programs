////: lines-33
async function «1»(title, source, limit = Infinity) {
  const seen = [];
  try {
    for await (const value of source) {
      seen.push(value);
      if (seen.length >= limit) break;
    }
  } catch (error) {
    seen.push("caught " + show(error));
  }
  «2»(`${title}: ${seen.join(", ")}`);
}
