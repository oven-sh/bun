//// async-results-errors-order.ts
// Async functions: results, errors, and the exact order in which everything runs.
const log: string[] = []
const say = (s: string) => { log.push(s) }
async function plain(n: number): Promise<number> { say("plain " + n); return n * 2 }
async function one(n: number): Promise<number> { say("one in"); const a = await plain(n); say("one mid " + a); const b = await 5; say("one out"); return a + b }
async function failing(): Promise<number> { say("failing in"); await null; say("failing throws"); throw new Error("bad") }
async function catching(): Promise<string> {
  try { await failing(); return "no" } catch (e) { say("caught " + (e as Error).message); return "yes" } finally { say("finally") }
}
async function loop(k: number): Promise<number> { let t = 0; for (let i = 0; i < k; i++) { t += await plain(i); if (i === 1) continue } return t }
async function operands(): Promise<string> { const f = (a: number, b: number, c: number) => a + "," + b + "," + c; let x = 1; return f(x++, await plain(x), x++) + ";" + (x + (await plain(10)) + x) }
async function thenable(): Promise<number> { return await ({ then(resolve: (v: number) => void) { say("then called"); resolve(7) } } as any) }
async function rejected(): Promise<string> { try { await Promise.reject(new Error("r")) } catch (e) { return (e as Error).message } return "none" }
class Service {
  base = 100
  async get(n: number): Promise<number> { await null; return this.base + n }
  all = async (list: number[]): Promise<number[]> => { const out: number[] = []; for (const n of list) out.push(await this.get(n)); return out }
}
say("start")
one(1).then(v => say("one = " + v))
Promise.resolve().then(() => say("tick 1")).then(() => say("tick 2")).then(() => say("tick 3")).then(() => say("tick 4"))
catching().then(v => say("catching = " + v))
loop(3).then(v => say("loop = " + v))
operands().then(v => say("operands = " + v))
thenable().then(v => say("thenable = " + v))
rejected().then(v => say("rejected = " + v))
new Service().all([1, 2]).then(v => say("all = " + v.join()))
failing().catch(e => say("outer " + e.message))
const p = plain(9)
say("is promise " + (p instanceof Promise) + " " + Object.prototype.toString.call(p))
Promise.all([plain(1), one(2), 3]).then(v => say("Promise.all " + v.join()))
say("end of script")
setTimeout(() => console.log(log.join("\n")), 0)
//// async-return-value-escapes.ts
// The value that an async function returns escapes through its promise, so what callers await must be treated as escaped.
interface Box { value: number }
async function make(n: number): Promise<Box> { return { value: n } }
async function use(n: number): Promise<number> {
  const box = await make(n)
  return box.value
}
console.log(await use(1))
const kept: Box = await make(2)
;(globalThis as any).leak = kept
;(globalThis as any).leak.value = 40
console.log(kept.value + (await use(2)))
//// async-stack-trace-skips-generators.ts
// A suspended sync generator with a number, a pending promise and a function in its frame is not an async frame: stack traces of the async functions awaiting the promise never include it, and its own stack traces never include them.
const settled = Promise.resolve();
Error.stackTraceLimit = 12;
////= names

type Errors = Generator<Error, Promise<number>, void>;
const labels: ((count: number) => string)[] = [count => "even " + count, count => "odd " + count];
const promises: Promise<number>[] = [];
const resolvers: ((value: number) => void)[] = [];

function* createErrors(): Errors {
  let count = promises.length;
  const pending = new Promise<number>(resolve => void resolvers.push(resolve));
  const label = labels[count % labels.length];
  promises.push(pending);
  const end = count + 3;
  while (count < end) yield new Error(label(count++));
  return pending;
}

async function throwsOnceResolved(pending: Promise<number>): Promise<never> {
  throw new Error("resolved with " + (await pending));
}
async function middle(pending: Promise<number>): Promise<number> {
  return await throwsOnceResolved(pending);
}
////= lines-42	outer(pending: Promise<number>	middle(pending

function resumeOnce(errors: Errors): Error[] {
  return [errors.next().value as Error];
}
function resumeInForOf(errors: Errors): Error[] {
  const result: Error[] = [];
  for (const error of errors) result.push(error);
  return result;
}
function resumeInSpread(errors: Errors): Error[] {
  return [...errors];
}
function resumeInArrayFrom(errors: Errors): Error[] {
  return Array.from(errors);
}
function resumeInJob(errors: Errors): Promise<Error[]> {
  return settled.then(() => resumeOnce(errors));
}
async function resumeAfterAwait(errors: Errors): Promise<Error[]> {
  await settled;
  return resumeOnce(errors);
}

for (const resume of [resumeOnce, resumeInForOf, resumeInSpread, resumeInArrayFrom, resumeInJob, resumeAfterAwait]) {
  const errors = createErrors();
  console.log(resume.name + ", before the promise is awaited: " + names(errors.next().value));
  const index = promises.length - 1;
  const caught = outer(promises[index]);
  for (const error of await resume(errors)) console.log(resume.name + ", while the promise is awaited: " + error.message + ": " + names(error));
  resolvers[index](index);
  const thrown = await caught;
  console.log(resume.name + ", thrown after the await: " + thrown.message + ": " + names(thrown));
  const last = errors.next();
  console.log(resume.name + ", resumed again: " + (last.done ? "done" : names(last.value)));
}
//// async-stack-traces.ts
// The stack of an error made after an await names the async functions that wait for the one that made it, up to Error.stackTraceLimit.
const collect: (sync: boolean) => void = (globalThis as any).gc ?? (globalThis as any).Bun?.gc ?? (() => undefined);
const tick = Promise.resolve();
Error.stackTraceLimit = 10;
////= names

async function leaf(): Promise<Error> {
  await tick;
  return new Error("leaf");
}
async function chain(depth: number): Promise<Error> {
  if (depth) return await chain(depth - 1);
  return await leaf();
}
async function first(): Promise<Error> {
  const error = await second();
  return error;
}
async function second(): Promise<Error> {
  await tick;
  const error = await third(1);
  await tick;
  return error;
}
async function third(times: number): Promise<Error> {
  for (let i = 0; i < times; i++) await tick;
  return new RangeError("third");
}
////= Service	fetch	tick
async function throughAll(): Promise<Error> {
  const [error] = await Promise.all([leaf(), tick]);
  return error;
}
async function throughRace(): Promise<Error> {
  return await Promise.race([leaf()]);
}
async function throughAllSettled(): Promise<Error> {
  const [result] = await Promise.allSettled([leaf()]);
  return result.status === "fulfilled" ? result.value : new Error("rejected");
}
async function throughAny(): Promise<Error> {
  return await Promise.any([leaf()]);
}
async function notAwaited(): Promise<Error> {
  const pending = leaf();
  await tick;
  return await pending;
}
async function thrower(depth: number): Promise<never> {
  if (depth) return await thrower(depth - 1);
  await tick;
  throw new Error("thrown");
}
async function catches(): Promise<Error> {
  try {
    return await thrower(2);
  } catch (error) {
    return error as Error;
  }
}
async function inFinally(): Promise<Error> {
  try {
    await tick;
  } finally {
    await tick;
    return await leaf();
  }
}
async function* generated(): AsyncGenerator<Error> {
  await tick;
  yield await leaf();
  yield new Error("in the generator");
}
async function overGenerator(): Promise<Error[]> {
  const errors: Error[] = [];
  for await (const error of generated()) errors.push(error);
  return errors;
}
async function captured(): Promise<{ stack?: string }> {
  await tick;
  const holder: { stack?: string } = {};
  Error.captureStackTrace(holder);
  return holder;
}
async function capturedBelow(): Promise<{ stack?: string }> {
  return await captured();
}

async function main(): Promise<void> {
  for (const depth of [0, 1, 3, 8, 9, 10, 11, 30]) console.log("chain " + depth + ": " + names(await chain(depth)));
  console.log("first: " + names(await first()));
  console.log("methods: " + names(await new Service().load()));
  console.log("all: " + names(await throughAll()));
  console.log("race: " + names(await throughRace()));
  console.log("allSettled: " + names(await throughAllSettled()));
  console.log("any: " + names(await throughAny()));
  console.log("not awaited at once: " + names(await notAwaited()));
  console.log("caught: " + names(await catches()));
  console.log("finally: " + names(await inFinally()));
  for (const error of await overGenerator()) console.log("generator: " + names(error));
  console.log("captureStackTrace: " + names((await capturedBelow()) as Error));
  for (const limit of [0, 1, 2, 5, 20, 100]) {
    Error.stackTraceLimit = limit;
    console.log("limit " + limit + ": " + names(await chain(6)));
  }
  Error.stackTraceLimit = 10;
  const kept: Error[] = [];
  for (let i = 0; i < 300; i++) kept.push(await chain(i % 5));
  collect(true);
  console.log("read later: " + names(kept[4]) + " || " + names(kept[295]));
}
main();
//// await-after-a-nested-drain.ts
// A coroutine that a job has entered while nothing else is queued need not wait at an await of a settled value. Here such a coroutine calls into the host, which drains the job queue before it
// returns: other coroutines are entered and left below it, some end and resume their waiters, some drain the queue themselves. Whatever the coroutine does next (an await of a number, of a promise
// or of a call, a step of a stream, a yield, a return to its waiter, a throw) comes in the order of plain Bun, with nothing queued behind the drain and with a chain of jobs queued behind it.
declare const drainMicrotasks: undefined | (() => void);
const drain: () => void = typeof drainMicrotasks === "function" ? drainMicrotasks : require("bun:jsc").drainMicrotasks;
const settled = Promise.resolve();
const fulfilled = Promise.resolve("fulfilled");
const lines: string[] = [];
let log: string[] = [];

////= afterTimer
// A chain of jobs of a given length: a turn that is lost or added beside it shows in the order of the log.
////= beat	log	settled
async function steps(label: string, count: number): Promise<void> {
  for (let i = 1; i <= count; i++) {
    await null;
    log.push(label + " " + i);
  }
}
async function chain(depth: number): Promise<number> {
  await settled;
  const below = depth ? await chain(depth - 1) : 0;
  log.push("chain " + depth);
  return below + 1;
}
async function* counts(label: string, count: number): AsyncGenerator<number, void, unknown> {
  for (let i = 1; i <= count; i++) {
    log.push(label + " yields " + i);
    yield i;
  }
}
async function consumes(label: string, count: number): Promise<void> {
  await null;
  for await (const value of counts(label, count)) log.push(label + " got " + value);
}
async function drainsToo(): Promise<void> {
  await null;
  log.push("inner begins");
  void steps("innermost", 2);
  drain();
  log.push("inner drained");
  log.push("inner got " + (await 0));
  log.push("inner got " + (await quick(1)));
}
////= lines-9	quick	number	return	n	1
////= lines-19	once	1

let open: (value: string) => void = () => {};
let gate: Promise<string> = fulfilled;
const works = ["nothing", "then handlers", "async functions", "a chain", "a stream", "a function that drains", "what opens the gate"] as const;
type Work = (typeof works)[number];
function queue(work: Work): void {
  gate = new Promise<string>(resolve => {
    open = resolve;
  });
  log.push("begins");
  switch (work) {
    case "nothing":
      break;
    case "then handlers":
      beat("then", 3);
      break;
    case "async functions":
      void steps("a", 2);
      void steps("b", 3);
      break;
    case "a chain":
      void chain(3).then(length => log.push("chain gave " + length));
      break;
    case "a stream":
      void consumes("stream", 2);
      break;
    case "a function that drains":
      void drainsToo();
      beat("then", 2);
      break;
    case "what opens the gate":
      void steps("opener", 2).then(() => open("opened in the drain"));
      break;
  }
}
function drained(queuesBehind: boolean): void {
  log.push("drained");
  if (queuesBehind) beat("behind", 5);
}

type Scene = (work: Work, queuesBehind: boolean) => Promise<unknown>;

////= lines-14	awaitsNumbers	1	2
////= lines-14	awaitsAFulfilledPromise	fulfilled	fulfilled
async function awaitsTheGate(work: Work, queuesBehind: boolean): Promise<void> {
  await afterTimer();
  queue(work);
  drain();
  drained(queuesBehind);
  if (work !== "what opens the gate") void steps("late opener", 3).then(() => open("opened behind the drain"));
  log.push("got " + (await gate));
  log.push("got " + (await 2));
}
async function awaitsCalls(work: Work, queuesBehind: boolean): Promise<void> {
  await afterTimer();
  queue(work);
  drain();
  drained(queuesBehind);
  log.push("got " + (await quick(1)));
  log.push("got " + (await once(2)));
  log.push("got " + (await quick(3)));
}
////= lines-45	stepsAStream	void	for await (const value of counts("own stream", 2)) log.push("got " + value)
////= lines-45	loopsOverAnArray	void	for await (const value of [1, fulfilled]) log.push("got " + value)
async function drainsTwice(work: Work, queuesBehind: boolean): Promise<void> {
  await afterTimer();
  queue(work);
  drain();
  log.push("drained once");
  void steps("between", 2);
  drain();
  drained(queuesBehind);
  log.push("got " + (await 1));
}
async function drainsBetweenAwaits(work: Work, queuesBehind: boolean): Promise<void> {
  await afterTimer();
  log.push("got " + (await 1));
  queue(work);
  drain();
  drained(queuesBehind);
  log.push("got " + (await 2));
  void steps("again", 1);
  drain();
  log.push("drained again");
  log.push("got " + (await 3));
}
function drainsBelow(work: Work, queuesBehind: boolean, depth: number): void {
  if (depth) return drainsBelow(work, queuesBehind, depth - 1);
  queue(work);
  drain();
  drained(queuesBehind);
}
async function drainsInACallee(work: Work, queuesBehind: boolean): Promise<void> {
  await afterTimer();
  drainsBelow(work, queuesBehind, 3);
  log.push("got " + (await 1));
  log.push("got " + (await quick(2)));
}
async function drainsInACallback(work: Work, queuesBehind: boolean): Promise<void> {
  await afterTimer();
  [0].forEach(() => {
    queue(work);
    drain();
    drained(queuesBehind);
  });
  log.push("got " + (await 1));
  log.push("got " + (await fulfilled));
}
function* drainsInside(work: Work, queuesBehind: boolean): Generator<number, void, unknown> {
  yield 1;
  queue(work);
  drain();
  drained(queuesBehind);
  yield 2;
}
async function stepsAGeneratorThatDrains(work: Work, queuesBehind: boolean): Promise<void> {
  await afterTimer();
  for (const value of drainsInside(work, queuesBehind)) log.push("stepped to " + value);
  log.push("got " + (await 1));
  log.push("got " + (await fulfilled));
}

////= lines-45	drainsAndReturns	string	return "returned"
////= lines-45	drainsAndThrows	string	throw new RangeError("thrown")
async function waitsForACall(work: Work, queuesBehind: boolean): Promise<void> {
  log.push("the waiter got " + (await drainsAndReturns(work, queuesBehind)));
  log.push("the waiter got " + (await 1));
}
async function waitsForAVariable(work: Work, queuesBehind: boolean): Promise<void> {
  const pending = drainsAndReturns(work, queuesBehind);
  log.push("the waiter got " + (await pending));
  log.push("the waiter got " + (await 1));
}
async function waitsWithAnother(work: Work, queuesBehind: boolean): Promise<void> {
  const pending = drainsAndReturns(work, queuesBehind);
  void pending.then(value => log.push("a then got " + value));
  log.push("the waiter got " + (await pending));
}
async function catchesFromACall(work: Work, queuesBehind: boolean): Promise<void> {
  try {
    await drainsAndThrows(work, queuesBehind);
  } catch (error) {
    log.push("the waiter caught " + (error as Error).message);
  }
  log.push("the waiter got " + (await 1));
}
async function catchesFromAVariable(work: Work, queuesBehind: boolean): Promise<void> {
  const pending = drainsAndThrows(work, queuesBehind);
  try {
    await pending;
  } catch (error) {
    log.push("the waiter caught " + (error as Error).message);
  }
}

async function* drainsBetweenYields(work: Work, queuesBehind: boolean): AsyncGenerator<string, void, unknown> {
  yield "first";
  queue(work);
  drain();
  drained(queuesBehind);
  yield "second";
  log.push("the body got " + (await 1));
  yield "third";
}
async function consumesWhatDrains(work: Work, queuesBehind: boolean): Promise<void> {
  await afterTimer();
  for await (const value of drainsBetweenYields(work, queuesBehind)) log.push("the consumer got " + value);
}
async function asksWhatDrains(work: Work, queuesBehind: boolean): Promise<void> {
  await afterTimer();
  const stream = drainsBetweenYields(work, queuesBehind);
  for (let result = await stream.next(); !result.done; result = await stream.next()) log.push("next() gave " + result.value);
}
async function drainsInTheLoop(work: Work, queuesBehind: boolean): Promise<void> {
  await afterTimer();
  for await (const value of counts("own stream", 2)) {
    log.push("got " + value);
    if (value === 1) {
      queue(work);
      drain();
      drained(queuesBehind);
    }
  }
}
async function* relaysAndDrains(work: Work, queuesBehind: boolean): AsyncGenerator<number, void, unknown> {
  for await (const value of counts("inner stream", 2)) {
    if (value === 2) {
      queue(work);
      drain();
      drained(queuesBehind);
    }
    yield value;
  }
}
async function consumesARelay(work: Work, queuesBehind: boolean): Promise<void> {
  await afterTimer();
  for await (const value of relaysAndDrains(work, queuesBehind)) log.push("the consumer got " + value);
}

const scenes: [label: string, scene: Scene][] = [
  ["awaits numbers", awaitsNumbers],
  ["awaits a fulfilled promise", awaitsAFulfilledPromise],
  ["awaits a promise that is fulfilled in the drain or behind it", awaitsTheGate],
  ["awaits calls", awaitsCalls],
  ["steps a stream", stepsAStream],
  ["loops over an array with for await", loopsOverAnArray],
  ["drains twice", drainsTwice],
  ["drains between awaits", drainsBetweenAwaits],
  ["drains in a callee", drainsInACallee],
  ["drains in a callback of a built-in", drainsInACallback],
  ["steps a generator that drains", stepsAGeneratorThatDrains],
  ["returns to a function that awaited the call", waitsForACall],
  ["returns to a function that awaited a variable", waitsForAVariable],
  ["returns to a function and a then handler", waitsWithAnother],
  ["throws to a function that awaited the call", catchesFromACall],
  ["throws to a function that awaited a variable", catchesFromAVariable],
  ["the body of a stream drains between yields", consumesWhatDrains],
  ["the same, asked by next()", asksWhatDrains],
  ["the consumer of a stream drains in its loop", drainsInTheLoop],
  ["a stream between two others drains", consumesARelay],
];
for (const [label, scene] of scenes) {
  lines.push("== " + label);
  for (const work of works) {
    for (const queuesBehind of [false, true]) {
      log = [];
      await scene(work, queuesBehind);
      log.push("over");
      await afterTimer();
      lines.push(work + (queuesBehind ? ", jobs behind: " : ": ") + log.join(" | "));
    }
  }
}

async function drainsOften(rounds: number): Promise<number> {
  await afterTimer();
  let sum = 0;
  for (let i = 0; i < rounds; i++) {
    const pending = once(i);
    drain();
    sum += (await pending) + (await i) + (await quick(i));
  }
  return sum;
}
log = [];
lines.push("== a thousand drains", String(await drainsOften(1000)));
console.log(lines.join("\n"));

export {};
