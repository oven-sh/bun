async function byLoop(title: string, stream: AsyncGenerator<number, unknown>): Promise<void> {
    const got: number[] = [];
    try { for await (const x of stream) got.push(x); lines.push(title + ": " + got.join(" ")); } catch (error) { lines.push(title + ": " + got.join(" ") + " caught " + (error as Error).message); }
}
async function byNext(title: string, stream: AsyncGenerator<number, unknown>): Promise<void> {
    const got: string[] = [];
    try { for (;;) { const step = await stream.next(); got.push(String(step.value)); if (step.done) break; } lines.push(title + ": " + got.join(" ")); } catch (error) { lines.push(title + ": " + got.join(" ") + " caught " + (error as Error).message); }
}
for (const waits of [false, true]) {
