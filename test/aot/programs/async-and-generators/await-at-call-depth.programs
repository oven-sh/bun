async function numbersComeBack(): Promise<void> {
  const numbers = [0, -0, 1, -1, 0.5, NaN, Infinity, -Infinity, 2147483647, -2147483648, 2147483648, 4294967295, 9007199254740991, 5e-324, 1.7976931348623157e308];
