const patient = new Patient(10);

type Row = [label: string, make: () => unknown];
type Call = (value: any) => Promise<string>;

const numbers: Row[] = [
  ["21", () => 21],
  ["1.5", () => 1.5],
  ["the string 21", () => "21"],
  ["undefined", () => undefined],
  ["null", () => null],
  ["true", () => true],
  ["a bigint", () => 4n],
  ["a symbol", () => Symbol("s")],
  ["an object with valueOf", () => ({ valueOf: () => 8 })],
  ["an array", () => [3]],
  ["22", () => 22],
];
const resolutions: Row[] = [
  ["7", () => 7],
  ["a thenable", () => thenableFor("the argument", 8)],
  ["a fulfilled promise", () => Promise.resolve(9)],
  ["a rejected promise", () => Promise.reject(new RangeError("rejected"))],
  ["a pending promise", () => afterTwoJobs(10)],
  ["a function", () => () => 11],
  ["an object whose then is a number", () => ({ then: 12 })],
  [
    "an object whose then throws",
    () => ({
      get then(): unknown {
        throw new EvalError("then was read");
      },
    }),
  ],
  ["13", () => 13],
];
const points: Row[] = [
  ["a point", () => ({ x: 2, y: 3 })],
  ["a point with more", () => ({ x: 2, y: 3, z: 4 })],
  ["a point in another order", () => ({ y: 3, x: 2 })],
  ["strings for numbers", () => ({ x: "2", y: "3" })],
  ["a point without x", () => ({ y: 3 })],
  [
    "getters",
    () => ({
      get x(): number {
        lines.push("  x is read");
        return 5;
      },
      get y(): number {
        lines.push("  y is read");
        return 6;
      },
    }),
  ],
  ["an instance of a class", () => new Pixel(7, 8)],
  ["null", () => null],
  ["a number", () => 9],
  ["a point again", () => ({ x: 4, y: 5 })],
];
const meters: Row[] = [
  ["an instance", () => new Meter("m", 2)],
  ["an instance of a subclass", () => new Kilometer()],
  ["an object literal", () => ({ unit: "x", factor: 3 })],
  ["an object with the prototype alone", () => Object.create(Meter.prototype)],
  ["undefined", () => undefined],
  ["an instance again", () => new Meter("cm", 4)],
];
const texts: Row[] = [
  ["abc", () => "abc"],
  ["a number", () => 5],
  ["a String object", () => new String("abc")],
  ["an array", () => ["a"]],
  ["an object with the method", () => ({ toUpperCase: () => "OWN", length: 1 })],
  ["null", () => null],
  ["de", () => "de"],
];
const lists: Row[] = [
  ["three numbers", () => [1, 2, 3]],
  ["nothing", () => []],
  ["a fraction and a string", () => [1.5, "2"]],
  ["promises", () => [Promise.resolve(4), afterTwoJobs(5)]],
  ["a string", () => "12"],
  ["a set", () => new Set([4, 5])],
  ["what cannot be iterated", () => ({ length: 1 })],
  ["null", () => null],
  ["two numbers", () => [6, 7]],
];
const callbacks: Row[] = [
  ["a function", () => (n: number) => n * 2],
  ["a function that returns a string", () => (n: number) => "s" + n],
  ["an async function", () => async (n: number) => n],
  ["a function that throws", () => () => { throw new URIError("thrown by the callback"); }],
  ["null", () => null],
  ["a function again", () => (n: number) => n * 3],
];
const sources: Row[] = [
  ["the first class", () => new Quick(20)],
  ["the second class", () => new Patient(20)],
  ["a subclass", () => new Loud(20)],
  ["a method that returns a number", () => ({ read: (n: number) => n + 30 })],
  ["a method that returns a thenable", () => ({ read: (n: number) => thenableFor("the result", n + 40) })],
  ["the first class's method on another object", () => ({ base: "b", read: Quick.prototype.read })],
  ["the second class's method on another object", () => ({ base: 50, read: Patient.prototype.read })],
  ["no method", () => ({})],
  ["null", () => null],
  ["the second class again", () => new Patient(60)],
  ["the first class again", () => new Quick(60)],
];

// Each function awaits the same call twice: it has not been suspended before the first one, and a job has entered it before the second one.
const sites: [label: string, call: Call, rows: Row[]][] = [
  ["never awaits", async value => both(await neverAwaits(value), await neverAwaits(value)), numbers],
  ["awaits once", async value => both(await awaitsOnce(value), await awaitsOnce(value)), numbers],
  ["awaits odd numbers", async value => both(await awaitsOddNumbers(value), await awaitsOddNumbers(value)), numbers],
  ["returns its argument", async value => both(await returnsItsArgument(value), await returnsItsArgument(value)), resolutions],
  ["returns it later", async value => both(await returnsItLater(value), await returnsItLater(value)), resolutions],
  ["reads a record", async value => both(await readsARecord(value, 3), await readsARecord(value, 4)), points],
  ["reads a record, scaled by the value", async value => both(await readsARecord({ x: 1, y: 2 }, value), await readsARecord({ x: 3, y: 4 }, value)), numbers],
  ["reads an instance", async value => both(await readsAnInstance(value, 3), await readsAnInstance(value, 4)), meters],
  ["calls a string method", async value => both(await callsAStringMethod(value), await callsAStringMethod(value)), texts],
  ["calls it later", async value => both(await callsItLater(value), await callsItLater(value)), texts],
  ["sums an array", async value => both(await sumsAnArray(value), await sumsAnArray(value)), lists],
  ["has defaults", async value => both(await hasDefaults(value), await hasDefaults(value, value)), numbers],
  ["calls back", async value => both(await callsBack(value, 4), await callsBack(value, 5)), callbacks],
  ["takes a number or a string", async value => both(await takesEither(value), await takesEither(value)), numbers],
  ["calls typed functions", async value => both(await callsTypedFunctions(value), await callsTypedFunctions(value)), numbers],
  ["a method of either class", async value => both(await readsEither(value, 2), await readsEither(value, 3)), sources],
  ["a method of whatever comes", async value => both(await value.read(2), await value.read(3)), sources],
  ["a method of the first class", async value => both(await quick.read(value), await quick.read(value)), numbers],
  ["a method of the second class", async value => both(await patient.read(value), await patient.read(value)), numbers],
];

async function runSites(withTicks: boolean): Promise<void> {
  lines.push(withTicks ? "== beside other jobs" : "== alone");
  for (const [site, call, rows] of sites) {
    for (const [label, make] of rows) {
      const value = make();
      const stop = withTicks ? startTicks() : null;
      let outcome: string;
      try {
        outcome = await call(value);
      } catch (error) {
        outcome = "rejected with " + nameOf(error);
      }
      lines.push(site + ", " + label + ": " + outcome + (stop ? " after " + stop() + " ticks" : ""));
    }
  }
}

async function sumsReads(from: (Quick | Patient)[], rounds: number): Promise<number> {
  let sum = 0;
  for (let i = 0; i < rounds; i++) sum += await from[i % from.length].read(i);
  return sum;
}
async function sumsCalls(values: any[], rounds: number): Promise<string> {
  let sum = 0;
  let text = 0;
  for (let i = 0; i < rounds; i++) {
    const result: unknown = await awaitsOnce(values[i % values.length]);
    if (typeof result === "number") sum += result;
    else text += String(result).length;
  }
  return sum + " and " + text;
}

let opens: (() => void)[] = [];
function gate(): Promise<void> {
  return new Promise<void>(resolve => {
    opens.push(resolve);
  });
}
async function waitsAtTheGate(n: number): Promise<number> {
  await gate();
  return n;
}
async function callsWithItsType(n: number): Promise<number> {
  return 1 + (await waitsAtTheGate(n));
}
async function callsThroughAny(n: any): Promise<number> {
  return 1 + (await waitsAtTheGate(n));
}
class Near {
  async wait(n: number): Promise<number> {
    await gate();
    return n;
  }
}
class Far {
  async wait(n: number): Promise<number> {
    await gate();
    return -n;
  }
}
async function callsAMethod(where: Near | Far, n: number): Promise<number> {
  return 1 + (await where.wait(n));
}
const places: (Near | Far)[] = [new Near(), new Far()];

function livePromises(): number {
  if (!counted || typeof gc !== "function" || typeof memoryUsageStatistics !== "function") return 0;
  gc();
  return memoryUsageStatistics().objectTypeCounts.Promise ?? 0;
}
// A thousand chains of two functions, all suspended. An engine that makes a promise for every call holds three thousand.
async function census(label: string, start: (i: number) => Promise<number>): Promise<void> {
  const before = livePromises();
  const chains: Promise<number>[] = [];
  for (let i = 0; i < 1000; i++) chains.push(start(i));
  const held = livePromises() - before;
  for (const open of opens) open();
  opens = [];
  const values = await Promise.all(chains);
  lines.push(label + ": " + (held < 2500 ? "a chain holds the gate's promise and its own" : held + " PROMISES FOR 1000 CHAINS") + ", " + describe(values[0]) + " to " + describe(values[999]));
}
async function measure(label: string, calls: number, run: () => Promise<unknown>): Promise<void> {
  await null;
  const before = counted ? counted("operationAOTNewPromise") : 0;
  const result = await run();
  const entries = (counted ? counted("operationAOTNewPromise") : 0) - before;
  lines.push(label + ": " + describe(result) + ", " + (entries * 20 < calls ? "few entries" : entries + " ENTRIES FOR " + calls + " CALLS"));
}

for (const withTicks of [false, true, false, true]) await runSites(withTicks);
lines.push("== counts");
await census("arguments of the declared type", i => callsWithItsType(i));
await census("the declared type through any", i => callsThroughAny(i));
await census("another type through any", i => callsThroughAny("s" + i));
await census("both in turn", i => callsThroughAny(i % 2 ? i : "s" + i));
await census("methods of two classes", i => callsAMethod(places[i % 2], i));
await measure("methods of two classes in a loop", 20000, () => sumsReads([quick, patient], 20000));
await measure("methods of one class in a loop", 20000, () => sumsReads([patient], 20000));
await measure("numbers through any in a loop", 20000, () => sumsCalls([1, 2, 3], 20000));
await measure("numbers and strings through any in a loop", 20000, () => sumsCalls([1, "2", 3, "four"], 20000));
console.log(lines.join("\n"));

export {};
//// await-order-in-async-generators.ts
// `await` in an async generator and at the top level of a module: for each kind of awaited value, jobs run in the same order in code that runs once and in a loop of 10,000.
let log: string[] = [];
let currentStep = 0;
const say = (text: string): void => {
  log.push(text);
};
const show = (value: unknown): void => say("= " + String(value));

// Logs the next `turns` turns of the job queue, until the next step begins, so the log shows in which turn each await resumed.
function begin(name: string, turns: number): void {
  say(name);
  const step = ++currentStep;
  let turn = 0;
  const next = (): void => {
    if (step !== currentStep) return;
    say("turn " + ++turn);
    if (turn < turns) queueMicrotask(next);
  };
  if (turns) queueMicrotask(next);
}
function take(): string {
  const round = log.join(", ");
  log = [];
  return round;
}
function count(rounds: Map<string, number>): void {
  const round = take();
  rounds.set(round, (rounds.get(round) ?? 0) + 1);
}

class Derived<T> extends Promise<T> {
  then<A = T, B = never>(onFulfilled?: ((value: T) => A | PromiseLike<A>) | null, onRejected?: ((reason: unknown) => B | PromiseLike<B>) | null): Promise<A | B> {
    say("Derived.then");
    return super.then(onFulfilled, onRejected);
  }
}
const one = (): number => 1;
const two = (): string => "two";
const fulfilled = (): Promise<number> => Promise.resolve(3);
const rejected = (): Promise<number> => Promise.reject(new RangeError("four"));
const pending = (): Promise<number> =>
  new Promise<number>(resolve => {
    queueMicrotask(() =>
      queueMicrotask(() => {
        say("resolve");
        resolve(5);
      }),
    );
  });
function withOwnThen(): Promise<number> {
  const promise = Promise.resolve(6);
  (promise as any).then = (): void => say("own then was called");
  return promise;
}
const derived = (): Derived<number> => new Derived<number>(resolve => resolve(7));
const thenable = () => ({
  then(resolve: (value: number) => void): void {
    say("thenable.then");
    resolve(8);
  },
});
const plain = () => ({ value: 9 });
const untyped: unknown[] = [10, "eleven", Promise.resolve(12), null];

async function* awaitOnce(turns: number): AsyncGenerator<void> {
  begin("primitives", turns); show(await one()); show(await two());
  begin("fulfilled", turns); show(await fulfilled());
  begin("rejected", turns); try { show(await rejected()); } catch (error) { show(error); }
  begin("pending", turns); show(await pending());
  begin("own then", turns); show(await withOwnThen());
  begin("derived", turns); show(await derived());
  begin("thenable", turns); show(await thenable());
  begin("plain object", turns); show((await plain()).value);
  begin("untyped", turns); show(await untyped[0]); show(await untyped[1]); show(await untyped[2]); show(await untyped[3]);
  begin("end", 0);
  yield;
}
async function* awaitInLoop(): AsyncGenerator<void> {
  for (let round = 0; round < 10_000; round++) {
    const turns = round & 1 ? 4 : 0;
    begin("primitives", turns); show(await one()); show(await two());
    begin("fulfilled", turns); show(await fulfilled());
    begin("rejected", turns); try { show(await rejected()); } catch (error) { show(error); }
    begin("pending", turns); show(await pending());
    begin("own then", turns); show(await withOwnThen());
    begin("derived", turns); show(await derived());
    begin("thenable", turns); show(await thenable());
    begin("plain object", turns); show((await plain()).value);
    begin("untyped", turns); show(await untyped[0]); show(await untyped[1]); show(await untyped[2]); show(await untyped[3]);
    begin("end", 0);
    yield;
  }
}
async function roundsOf(generator: AsyncGenerator<void>): Promise<Map<string, number>> {
  const rounds = new Map<string, number>();
  for await (const _ of generator) count(rounds);
  return rounds;
}
function report(label: string, once: string[], inLoop: Map<string, number>): void {
  for (const round of once) console.log(label + ": " + round);
  console.log(label + ", in a loop: " + once.map(round => inLoop.get(round)).join() + " of " + inLoop.size + " kinds of rounds");
}

begin("primitives", 0); show(await one()); show(await two());
begin("fulfilled", 0); show(await fulfilled());
begin("rejected", 0); try { show(await rejected()); } catch (error) { show(error); }
begin("pending", 0); show(await pending());
begin("own then", 0); show(await withOwnThen());
begin("derived", 0); show(await derived());
begin("thenable", 0); show(await thenable());
begin("plain object", 0); show((await plain()).value);
begin("untyped", 0); show(await untyped[0]); show(await untyped[1]); show(await untyped[2]); show(await untyped[3]);
begin("end", 0);
const quietRound = take();

begin("primitives", 4); show(await one()); show(await two());
begin("fulfilled", 4); show(await fulfilled());
begin("rejected", 4); try { show(await rejected()); } catch (error) { show(error); }
begin("pending", 4); show(await pending());
begin("own then", 4); show(await withOwnThen());
begin("derived", 4); show(await derived());
begin("thenable", 4); show(await thenable());
begin("plain object", 4); show((await plain()).value);
begin("untyped", 4); show(await untyped[0]); show(await untyped[1]); show(await untyped[2]); show(await untyped[3]);
begin("end", 0);
const busyRound = take();

const roundsAtTopLevel = new Map<string, number>();
for (let round = 0; round < 10_000; round++) {
  const turns = round & 1 ? 4 : 0;
  begin("primitives", turns); show(await one()); show(await two());
  begin("fulfilled", turns); show(await fulfilled());
  begin("rejected", turns); try { show(await rejected()); } catch (error) { show(error); }
  begin("pending", turns); show(await pending());
  begin("own then", turns); show(await withOwnThen());
  begin("derived", turns); show(await derived());
  begin("thenable", turns); show(await thenable());
  begin("plain object", turns); show((await plain()).value);
  begin("untyped", turns); show(await untyped[0]); show(await untyped[1]); show(await untyped[2]); show(await untyped[3]);
  begin("end", 0);
  count(roundsAtTopLevel);
}
report("top level", [quietRound, busyRound], roundsAtTopLevel);

const onceInGenerator = [...(await roundsOf(awaitOnce(0))).keys(), ...(await roundsOf(awaitOnce(4))).keys()];
report("async generator", onceInGenerator, await roundsOf(awaitInLoop()));

export {};
//// await-paths.ts
// Every way through an `await`: on settled, pending and rejected promises, with locals that must survive the suspension, and several calls in flight at once.
declare const console: { log(...v: unknown[]): void };
const done = (v: number): Promise<number> => Promise.resolve(v);
const later = (v: number): Promise<number> => Promise.resolve().then(() => v);
const fails = (v: number): Promise<number> => Promise.resolve().then(() => { throw new RangeError("r" + v); });
const at = (bits: number, i: number, v: number): Promise<number> => (bits >> i & 1 ? later(v) : done(v));

async function defined(bits: number, a: number): Promise<number> {
    const early = a * 3;
    let t = await at(bits, 0, 1);
    const mid = t + early;                    // defined in the resume body
    if (bits & 64) t += await at(bits, 1, mid); else t -= await at(bits, 2, 2);
    const late = mid * 2 + t;
    t += await at(bits, 3, late);
    if (t & 1) return early + mid;            // uses on one way only
    t += await at(bits, 4, 5);
    return t + early + mid + late;
}
async function loops(bits: number, n: number): Promise<number> {
    let s = 0, last = -1; const k = n * 7;
    for (let i = 0; i < n; i++) {
        if (i & 1) { s += await at(bits, i & 7, i); last = i; }
        for (let j = 0; j < 3; j++) s += k + j;   // a loop without a suspension that uses what is kept
        if (s > 400) break;
    }
    return s * 10 + last + k;
}
async function guarded(bits: number, a: number): Promise<string> {
    let where = "start", x = a; const fixed = a + 100;
    try {
        x += await at(bits, 0, 1); where = "one";
        if (bits & 32) x += await fails(x);
        x += await at(bits, 1, 2); where = "two";
        if (bits & 16) throw new TypeError("t" + x);
        where = "three";
    } catch (e) {
        where += ":" + (e as Error).message; x += await at(bits, 2, fixed);
    } finally {
        where += ":f"; x += await at(bits, 3, 1000);
    }
    return where + x + ":" + fixed;
}
async function cases(bits: number, a: number): Promise<number> {
    const u = a + 1, v = a + 2, w = a + 3;
    const which = await at(bits, 0, a & 3);
    switch (which) {
    case 0: return u + v;
    case 1: return (await at(bits, 1, u)) + w;
    case 2: { const z = await at(bits, 2, v); return z + u + w; }
    default: return u * v * w;
    }
}
class Holder { n = 5; async m(bits: number, a: number): Promise<number> { const b = a + this.n; await at(bits, 0, 0); this.n++; const c = b + this.n; if (bits & 2) await at(bits, 2, 0); return a + b + c + this.n; } }
function* walk(a: number, flag: boolean): Generator<number, string, number> {
    const p = a + 1, q = a + 2; let got = 0;
    try {
        got += yield p;
        if (flag) got += yield q; else got -= yield p + q;
        for (let i = 0; i < 2; i++) got += yield i + got;
    } finally { got += 1000; yield got + p; }
    return "end" + (got + p + q);
}
function drive(flag: boolean, stop: number, how: number): string {
    const g = walk(1, flag); const out: string[] = [];
    for (let i = 0; i < 9; i++) {
        let r: IteratorResult<number, string>;
        try { r = i === stop ? (how ? g.throw(new Error("x")) : g.return("ret")) : g.next(i); } catch (e) { out.push("!" + (e as Error).message); continue; }
        out.push(String(r.value) + (r.done ? "." : ""));
    }
    return out.join();
}
async function main(): Promise<void> {
    let a = 0, b = 0, d = 0, m = 0; const seen = new Map<string, number>();
    for (let bits = 0; bits < 128; bits++) {
        a = (a * 31 + await defined(bits, bits % 5)) % 1000003;
        b = (b * 31 + await loops(bits, bits % 9)) % 1000003;
        d = (d * 31 + await cases(bits, bits % 7)) % 1000003;
        m = (m * 31 + await new Holder().m(bits, bits % 3)) % 1000003;
        const g = await guarded(bits, bits % 4); seen.set(g, (seen.get(g) ?? 0) + 1);
    }
    console.log(a, b, d, m, seen.size, [...seen].slice(0, 6).join(" "));
    // Several at once: their frames are their own.
    console.log((await Promise.all([defined(127, 1), defined(0, 1), defined(85, 2), loops(255, 8), guarded(48, 1), guarded(16, 2), cases(7, 2)])).join());
    for (const flag of [true, false]) for (let stop = 0; stop < 7; stop += 2) for (const how of [0, 1]) console.log(drive(flag, stop, how));
}
main();
