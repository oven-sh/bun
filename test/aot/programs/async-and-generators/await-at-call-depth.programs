//// await-at-call-depth.js
const log = [];
let sink = 0;

function later(value) {
  return new Promise(resolve => Promise.resolve().then(() => resolve(value)));
}
function failLater(message) {
  return new Promise((resolve, reject) => Promise.resolve().then(() => reject(new Error(message))));
}
const thenable = value => ({
  then(resolve) {
    resolve(value);
  },
});

async function awaitsOnce(value) {
  const got = await value;
  return [got];
}
async function awaitsTwice(first, second) {
  const a = await first;
  const b = await second;
  return [a, b];
}
async function awaitsInLoop(count) {
  let total = 0;
  for (let i = 0; i < count; i++) total += await later(i);
  return total;
}
async function catches(value) {
  try {
    return await value;
  } catch (error) {
    return "caught " + error.message;
  } finally {
    sink++;
  }
}
async function keepsLocals(a, b, c, d, e) {
  const before = [a, b, c, d, e].join();
  const x = await later(a + b);
  const y = await c;
  const z = await thenable(d + e);
  return before + "|" + [a, b, c, d, e, x, y, z].join();
}
const arrow = async value => (await value) + 1;
const holder = {
  base: 10,
  async method(value) {
    return this.base + (await value);
  },
};

function level1(f, x) { const p = f(x); sink++; return p; }
function level2(f, x) { const p = level1(f, x); sink++; return p; }
function level3(f, x) { const p = level2(f, x); sink++; return p; }
function level4(f, x) { const p = level3(f, x); sink++; return p; }
function level5(f, x) { const p = level4(f, x); sink++; return p; }
function level6(f, x) { const p = level5(f, x); sink++; return p; }
function recurse(depth, f, x) {
  if (!depth) return f(x);
  const p = recurse(depth - 1, f, x);
  sink++;
  return p;
}
async function asyncRecursion(depth) {
  if (!depth) return await later(0);
  return 1 + (await asyncRecursion(depth - 1));
}

const show = value => JSON.stringify(value);

async function main() {
  const values = [1, "text", null, undefined, Promise.resolve(2), later(3), thenable(4), { plain: true }];
  for (const value of values) log.push("once " + show(await awaitsOnce(value)));
  for (const value of [5, Promise.resolve(6), later(7), thenable(8)]) {
    log.push("at depth " + show(await level6(awaitsOnce, value)) + " " + show(await recurse(40, awaitsOnce, value)) + " " + show(await recurse(200, awaitsOnce, value)));
  }
  log.push("twice " + show(await awaitsTwice(later(1), later(2))) + show(await awaitsTwice(1, later(2))) + show(await awaitsTwice(later(1), 2)) + show(await awaitsTwice(1, 2)));
  log.push("loop " + (await awaitsInLoop(0)) + " " + (await awaitsInLoop(1)) + " " + (await awaitsInLoop(50)));
  log.push("catches " + [await catches(1), await catches(failLater("late")), await catches(Promise.reject(new Error("now"))), await level6(catches, failLater("deep"))].join(" | "));
  log.push("locals " + (await keepsLocals(1, 2, 3, 4, 5)) + " " + (await keepsLocals("a", "b", later("c"), "d", "e")));
  log.push("arrow and method " + (await arrow(1)) + " " + (await arrow(later(2))) + " " + (await holder.method(1)) + " " + (await holder.method(later(2))) + " " + (await level6(arrow, later(3))));
  log.push("async recursion " + (await asyncRecursion(0)) + " " + (await asyncRecursion(5)) + " " + (await asyncRecursion(100)));
  const order = [];
  await Promise.all([
    (async () => { order.push("a1"); await null; order.push("a2"); await later(); order.push("a3"); })(),
    (async () => { order.push("b1"); await later(); order.push("b2"); await null; order.push("b3"); })(),
    level6(async () => { order.push("c1"); await null; order.push("c2"); }),
  ]);
  log.push("order " + order.join());
  let uncaught;
  try {
    await level6(awaitsOnce, failLater("passes through"));
  } catch (error) {
    uncaught = error.message;
  }
  log.push("rejection " + uncaught);
  let total = 0;
  for (let i = 0; i < 20000; i++) total += (await level6(awaitsOnce, i & 7))[0];
  log.push("many " + total + " sink " + sink);
  console.log(log.join("\n"));
}
main();
//// await-chains-unwind-without-the-runtime.ts
// A chain of 20,000 async functions, each waiting for the next, unwinds innermost first once a timer settles the last one, and the stack does not grow with it. The end of a function hands its
// result to the one function that waits for it, whether that one awaited the call or a variable that holds the call's promise, with an empty job queue and beside other jobs. A job that a
// function queues before it ends still runs before its waiter, and a promise with several waiters serves them in the order in which they came.
// The program counts the entries of the operation that the end of an async function leaves for, which only the jsc shell can.
// STATISTIC: AwaitedCallsResolved >= 4
declare const aotOperationCount: undefined | ((name: string) => number);
const counted = typeof aotOperationCount === "function" ? aotOperationCount : null;
function entered(): number {
  return counted ? counted("operationAOTResolvePromiseOrReturnResult") : 0;
}
const chainLength = 20_000;
const settled = Promise.resolve();
const lines: string[] = [];
type Ending = "a number" | "a thenable" | "a promise" | "an error";

////= Ticker
let ticker: Ticker | null = null;
////= startTicker-2
function stopTicker(): void {
  if (ticker) ticker.isOn = false;
  ticker = null;
}
function now(): string {
  return ticker ? " at tick " + ticker.count : "";
}

let resumed: number[] = [];
let marks: string[] = [];
let markEvery = 5_000;
let hasOtherJobs = false;

////= afterTimer-2	tartTicker(
////= thenable
function didResume(depth: number): void {
  resumed.push(depth);
  if (depth % markEvery === 0) marks.push(depth + now());
  if (depth % markEvery === 1) settled.then(() => marks.push("the job of " + depth + " after " + resumed.length + now()));
}
function describe(value: unknown): string {
  return typeof value === "object" && value !== null ? JSON.stringify(value) : String(value);
}

async function innermost(ending: Ending): Promise<number> {
  await afterTimer();
  switch (ending) {
    case "an error":
      throw new RangeError("thrown by the innermost function");
    case "a thenable":
      return thenable(0);
    case "a promise":
      return settled.then(() => 0);
    default:
      return 0;
  }
}
////= awaitsCall
////= awaitsVariable
async function awaitsCallWithoutHandler(depth: number, ending: Ending): Promise<number> {
  await settled;
  const below = depth ? await awaitsCallWithoutHandler(depth - 1, ending) : await innermost(ending);
  didResume(depth);
  return below + 1;
}
async function awaitsVariableWithoutHandler(depth: number, ending: Ending): Promise<number> {
  await settled;
  const pending = depth ? awaitsVariableWithoutHandler(depth - 1, ending) : innermost(ending);
  const below = await pending;
  didResume(depth);
  return below + 1;
}
// No function of this chain has been suspended before it waits for the next one.
async function descendsOnTheStack(depth: number, ending: Ending): Promise<number> {
  const below = depth ? await descendsOnTheStack(depth - 1, ending) : await innermost(ending);
  didResume(depth);
  return below + 1;
}

////= lines-4	Parcel	label	string	weight	number
async function packs(): Promise<Parcel> {
  await afterTimer();
  return { label: "parcel", weight: 3 };
}
async function carriesAParcel(depth: number): Promise<Parcel> {
  await settled;
  const parcel = depth ? await carriesAParcel(depth - 1) : await packs();
  didResume(depth);
  return parcel;
}
async function writes(): Promise<string> {
  await afterTimer();
  return "text";
}
async function carriesText(depth: number): Promise<string> {
  await settled;
  const text = depth ? await carriesText(depth - 1) : await writes();
  didResume(depth);
  return depth % markEvery === 0 ? text + "!" : text;
}
////= lines-16	finishes	afterTimer
async function carriesNothing(depth: number): Promise<void> {
  await settled;
  if (depth) await carriesNothing(depth - 1);
  else await finishes();
  didResume(depth);
}

async function run(label: string, length: number, start: (depth: number) => Promise<unknown>, withOtherJobs: boolean): Promise<void> {
  resumed = [];
  marks = [];
  markEvery = length / 4;
  hasOtherJobs = withOtherJobs;
  const before = entered();
  let outcome: string;
  try {
    outcome = "fulfilled with " + describe(await start(length - 1));
  } catch (error) {
    outcome = "rejected with " + (error as Error).message;
  }
  stopTicker();
  const entries = entered() - before;
  const isInnermostFirst = resumed.every((depth, index) => depth === index);
  lines.push(label + (withOtherJobs ? ", other jobs queued: " : ", empty queue: ") + outcome + ", " + resumed.length + " went on, innermost first: " + isInnermostFirst + ", " + (entries * 20 < length ? "few entries" : entries + " ENTRIES FOR " + length + " FUNCTIONS"));
  lines.push("  " + marks.join(", "));
}

function afterAllJobs(): Promise<void> {
  return new Promise<void>(resolve => {
    setTimeout(resolve, 0);
  });
}
let kept: Promise<number>[] = [];
let log: string[] = [];
async function waitsFor(gate: Promise<number>): Promise<number> {
  const value = await gate;
  log.push("the innermost function goes on" + now());
  return value;
}
async function keepsItsPromise(depth: number, gate: Promise<number>): Promise<number> {
  await settled;
  const pending = depth ? keepsItsPromise(depth - 1, gate) : waitsFor(gate);
  kept[depth] = pending;
  if (depth === 1) pending.then(value => log.push("a then from before the await of 1 gets " + value + now()));
  const value = await pending;
  log.push(depth + " goes on with " + value + now());
  return value + 1;
}
async function alsoAwaits(label: string, promise: Promise<number>): Promise<void> {
  const value = await promise;
  log.push(label + " gets " + value + now());
}
async function severalWaiters(withOtherJobs: boolean): Promise<void> {
  kept = [];
  log = [];
  let open!: (value: number) => void;
  const gate = new Promise<number>(resolve => {
    open = resolve;
  });
  const whole = keepsItsPromise(8, gate);
  await afterAllJobs();
  kept[2].then(value => log.push("a then from after the await of 2 gets " + value + now()));
  void alsoAwaits("a second function at 3", kept[3]);
  void alsoAwaits("a second function at 4", kept[4]);
  void alsoAwaits("a third function at 4", kept[4]);
  kept[5].finally(() => log.push("a finally at 5" + now()));
  void Promise.all([kept[6], kept[0]]).then(values => log.push("all of 6 and 0 gets " + values.join(" and ") + now()));
  void Promise.race([kept[7]]).then(value => log.push("a race at 7 gets " + value + now()));
  if (withOtherJobs) startTicker();
  open(100);
  log.push("the gate is open");
  log.push("the whole chain gives " + (await whole) + now());
  await settled;
  await settled;
  await settled;
  stopTicker();
  lines.push(withOtherJobs ? "several waiters, other jobs queued:" : "several waiters, empty queue:");
  for (const line of log) lines.push("  " + line);
}

const chains: [label: string, chain: (depth: number, ending: Ending) => Promise<number>, endings: Ending[]][] = [
  ["awaits the call", awaitsCall, ["a number", "a thenable", "a promise", "an error"]],
  ["awaits a variable", awaitsVariable, ["a number", "a thenable", "a promise", "an error"]],
  ["awaits the call, no handler", awaitsCallWithoutHandler, ["a number", "an error"]],
  ["awaits a variable, no handler", awaitsVariableWithoutHandler, ["a number", "an error"]],
];
for (const [label, chain, endings] of chains) {
  for (const ending of endings) {
    for (const withOtherJobs of [false, true]) await run(label + ", " + ending, chainLength, depth => chain(depth, ending), withOtherJobs);
  }
}
for (const withOtherJobs of [false, true]) {
  await run("carries a record", chainLength, carriesAParcel, withOtherJobs);
  await run("carries a string", chainLength, carriesText, withOtherJobs);
  await run("carries nothing", chainLength, carriesNothing, withOtherJobs);
  for (const ending of ["a number", "a thenable", "an error"] as const) await run("descends on the stack, " + ending, 1_000, depth => descendsOnTheStack(depth, ending), withOtherJobs);
  await severalWaiters(withOtherJobs);
}
console.log(lines.join("\n"));

export {};
//// await-direct-call-beside-tested-values-makes-no-promise.ts
// A thousand calls of an async function that awaits another one by name, all suspended. The result of the await and the parameter are values whose types are tested, under try and finally: the awaited call makes no promise all the same.
// The expected text is that of compiled code: an engine that makes a promise for every call holds three thousand.
// STATISTIC: AwaitedCallsResolved >= 1
import { heapStats } from "bun:jsc";
let waiting: (() => void)[] = [];
let open = 0;
////= lines-27	gate	waiting
async function readSmall(name: string): Promise<number> {
  await gate();
  return name.length * 2;
}
async function readGuarded(name: string): Promise<number> {
  open++;
  try {
    const size = await readSmall(name);
    if (size > 100) throw new RangeError("too large: " + name);
    return size + 1;
  } finally {
    open--;
  }
}
////= livePromises

const names: any[] = [];
for (let i = 0; i < 1000; i++) names.push("n" + i);
const before = livePromises();
const reads: Promise<number>[] = [];
for (const name of names) reads.push(readGuarded(name));
const suspended = livePromises() - before;
console.log(suspended < 2500 ? "a read holds the gate's promise and its own" : "too many promises: " + suspended);
// The collector takes every word of the stack for a reference: a promise from before the calls that such a word held at the first count may be gone at the second.
console.log(suspended >= 1990 ? "the promises that are kept are there" : "too few promises: " + suspended);
console.log(open);
for (const resume of waiting) resume();
const sizes = await Promise.all(reads);
console.log(sizes.length, sizes[0], sizes[999], sizes.reduce((a, b) => a + b, 0), open);
//// await-direct-call-host-queues.ts
// `await f()` against process.nextTick, setImmediate, timers and queueMicrotask, with AsyncLocalStorage contexts, and what is reported as an unhandled rejection.
import { AsyncLocalStorage } from "node:async_hooks";
const log: string[] = [];
const storage = new AsyncLocalStorage<string>();
const settled = Promise.resolve(0);

async function quick(n: number): Promise<number> {
  return n * 3;
}
async function once(n: number): Promise<number> {
  const value = await quick(n);
  process.nextTick(() => log.push("tick from once " + n + " in " + storage.getStore()));
  return value + 1;
}
async function fails(n: number): Promise<number> {
  if (n > 0) throw new Error("fails " + n);
  return n;
}
async function failsLater(n: number): Promise<number> {
  await settled;
  if (n > 0) throw new Error("fails later " + n);
  return n;
}
async function readsStore(name: string): Promise<string> {
  const before = storage.getStore();
  await settled;
  return name + ": " + before + " then " + storage.getStore();
}
async function entersStore(name: string): Promise<string> {
  const inside = await storage.run(name, async () => {
    const first = await readsStore(name + " inside");
    return first + " | " + storage.getStore();
  });
  return inside + " | outside " + storage.getStore();
}
async function leavesStore(): Promise<string> {
  storage.enterWith("entered by the callee");
  await settled;
  return "callee has " + storage.getStore();
}
async function runner(name: string): Promise<void> {
  log.push(name + " begins in " + storage.getStore());
  for (let i = 0; i < 3; i++) {
    const value = await once(i);
    log.push(name + " step " + i + " = " + value + " in " + storage.getStore());
    if (i === 1) {
      queueMicrotask(() => log.push(name + " microtask in " + storage.getStore()));
      process.nextTick(() => log.push(name + " tick in " + storage.getStore()));
    }
  }
  await new Promise<void>(resolve => setImmediate(resolve));
  log.push(name + " after setImmediate " + (await quick(7)) + " in " + storage.getStore());
  await new Promise<void>(resolve => setTimeout(resolve, 1));
  log.push(name + " after a timer " + (await once(9)) + " in " + storage.getStore());
  log.push(await entersStore(name));
  log.push(name + ": " + (await leavesStore()) + ", caller has " + storage.getStore());
}

process.on("unhandledRejection", reason => {
  log.push("unhandled: " + (reason as Error).message);
});
process.on("rejectionHandled", () => {
  log.push("handled late");
});

async function main(): Promise<void> {
  process.nextTick(() => log.push("the first tick"));
  setImmediate(() => log.push("immediate"));
  const a = storage.run("A", () => runner("a"));
  const b = storage.run("B", () => runner("b"));
  log.push("main goes on");
  await Promise.all([a, b]);
  try { await fails(1); } catch (error) { log.push("caught " + (error as Error).message); }
  try { await failsLater(2); } catch (error) { log.push("caught " + (error as Error).message); }
  void fails(3);
  void failsLater(4);
  log.push("after " + (await fails(0)) + " " + (await failsLater(0)));
  await new Promise<void>(resolve => setTimeout(resolve, 5));
  const late = fails(5);
  await new Promise<void>(resolve => setTimeout(resolve, 5));
  try { await late; } catch (error) { log.push("caught late " + (error as Error).message); }
  await new Promise<void>(resolve => setTimeout(resolve, 5));
}
main().then(() => console.log(log.join("\n")));
//// await-direct-call-job-order.ts
// `await f()` of a directly called async function takes the same number of microtask ticks as any other await, checked against then callbacks, other awaits and nested calls.
const trace: string[] = [];
const ready = Promise.resolve("ready");
////= beat	trace	ready

////= lines-9	doubled	number	return	n	n
async function noted(n: number): Promise<void> {
  trace.push("noted " + n);
}
async function worded(n: number): Promise<string> {
  return "<" + n + ">";
}
async function boxed(n: number): Promise<{ held: number }> {
  return { held: n };
}
async function listed(n: number): Promise<number[]> {
  return [n, n * n];
}
async function paused(n: number): Promise<number> {
  trace.push("pause begins " + n);
  await ready;
  trace.push("pause ends " + n);
  return n - 1;
}
async function pausedThenNot(n: number): Promise<number> {
  const late = await paused(n);
  trace.push("late " + late);
  const early = await doubled(n);
  trace.push("early " + early);
  return late * early;
}
async function pausedWhenEven(n: number): Promise<number> {
  if (n % 2 === 0) await ready;
  return n;
}
async function second(n: number): Promise<number> {
  trace.push("second in " + n);
  const got = await pausedThenNot(n);
  trace.push("second out " + got);
  return got - 1;
}
async function third(n: number): Promise<number> {
  return 3 * (await second(n));
}
async function awaitedOperands(n: number): Promise<number> {
  return (await paused(await pausedWhenEven(n))) - (await doubled(await doubled(n)));
}

async function runner(who: string, n: number): Promise<number> {
  trace.push(who + " begins");
  let even = 0;
  for (let i = 0; i < 4; i++) {
    even += await pausedWhenEven(n + i);
    trace.push(who + " even " + even);
  }
  const far = await third(n);
  trace.push(who + " far " + far);
  const list = await listed(n);
  trace.push(who + " list " + list.join("+"));
  const box = await boxed(n);
  trace.push(who + " box " + box.held);
  trace.push(who + " word " + (await worded(n)));
  await noted(n);
  trace.push(who + " past the note");
  const twice = await doubled(n);
  trace.push(who + " twice " + twice);
  const operands = await awaitedOperands(n);
  trace.push(who + " operands " + operands);
  const rest = await paused(n);
  trace.push(who + " rest " + rest);
  return even + far + twice + operands + rest;
}

const throughAnArrow = async (n: number): Promise<number> => (await doubled(n)) + 1;

async function conduct(): Promise<void> {
  beat("short", 5);
  const left = runner("left", 4);
  ready.then(() => trace.push("a then between the runners"));
  beat("long", 45);
  const right = runner("right", 7);
  trace.push("both are under way");
  trace.push("conduct sees " + (await ready));
  trace.push("arrow " + (await throughAnArrow(6)));
  const [l, r] = [await left, await right];
  trace.push("runners " + l + " and " + r);
  beat("after", 10);
  trace.push("far again " + (await third(5)));
  trace.push("one more " + (await runner("alone", 2)));
}

const whole = conduct();
console.log("the module has run");
await whole;
console.log(trace.join("\n"));
//// await-direct-call-makes-no-promise.ts
// A thousand chains of async functions, five deep, each awaiting the next by name, all suspended: only the outermost call of a chain has a promise.
// The expected text is that of compiled code: an engine that makes a promise for every call holds six thousand.
import { heapStats } from "bun:jsc";
let waiting: (() => void)[] = [];
////= lines-27	gate	waiting
async function first(n: number): Promise<number> {
  await gate();
  return n;
}
async function second(n: number): Promise<number> {
  return (await first(n)) + 1;
}
async function third(n: number): Promise<number> {
  const value = await second(n);
  return value + 1;
}
async function fourth(n: number): Promise<number> {
  if (n < 0) return 0;
  return (await third(n)) + 1;
}
async function fifth(n: number): Promise<number> {
  try {
    return (await fourth(n)) + 1;
  } finally {
    finished++;
  }
}
let finished = 0;
////= livePromises

const before = livePromises();
const chains: Promise<number>[] = [];
for (let i = 0; i < 1000; i++) chains.push(fifth(i));
const suspended = livePromises() - before;
console.log(suspended < 2500 ? "a chain holds the gate's promise and its own" : "too many promises: " + suspended);
// The collector takes every word of the stack for a reference: a promise from before the calls that such a word held at the first count may be gone at the second.
console.log(suspended >= 1990 ? "the promises that are kept are there" : "too few promises: " + suspended);
for (const open of waiting) open();
const values = await Promise.all(chains);
console.log(values.length, values[0], values[999], values.reduce((a, b) => a + b, 0), finished);
//// await-direct-call-of-a-function-that-tests-its-arguments-makes-no-promise.ts
// A thousand calls of an async function that awaits another async function by name, all suspended. The argument is read from an object that came through `any`, so the callee tests it at its head, and the caller takes those tests in: the awaited call behind them makes no promise all the same.
// The expected text is that of compiled code: an engine that makes a promise for every call holds three thousand.
import { heapStats } from "bun:jsc";
type Pair = { a: number; b: number };
let waiting: (() => void)[] = [];
////= lines-27	gate	waiting
async function double(value: number): Promise<number> {
  await gate();
  return value * 2;
}
async function doubleOfFirst(pair: Pair): Promise<number> {
  return await double(pair.a);
}
////= livePromises

const pairs: any[] = [];
for (let i = 0; i < 1000; i++) pairs.push({ extra: "x", b: 0, a: i });
console.log(await Promise.all([doubleOfFirst({ a: 1, b: 2 }), (waiting.shift()!(), 0)]));
const before = livePromises();
const results: Promise<number>[] = [];
for (const pair of pairs) results.push(doubleOfFirst(pair));
const suspended = livePromises() - before;
console.log(suspended < 2500 ? "a call holds the gate's promise and its own" : "too many promises: " + suspended);
