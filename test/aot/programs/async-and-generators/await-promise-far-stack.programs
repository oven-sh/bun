//// every-job-under-the-store-it-captured.ts
// AsyncLocalStorage: jobs that follow one another have captured different stores, and each runs under its own. Nothing of a job's store is left behind it.
import { AsyncLocalStorage } from "node:async_hooks";

const lines: string[] = [];
function log(line: string) { lines.push(line); }
const macrotask = () => new Promise<void>(resolve => setTimeout(resolve, 1));
let storage!: AsyncLocalStorage<string>;
const here = () => String(storage?.getStore());

async function waits(name: string, count: number) {
  for (let i = 0; i < count; i++) { await null; log(name + " behind await " + i + " under " + here()); }
  return name;
}
async function* yields(name: string, count: number): AsyncGenerator<string> {
  for (let i = 0; i < count; i++) { await null; yield name + " yields " + i + " under " + here(); }
}
async function consumes(name: string, count: number) {
  for await (const value of yields(name, count)) log(value + ", seen under " + here());
}

log("== the first store is made in the middle of a drain");
{
  const before = [waits("a", 3), consumes("b", 2)];
  Promise.resolve().then(() => {
    storage = new AsyncLocalStorage<string>();
    storage.run("first", () => {
      before.push(waits("c", 3), consumes("d", 2));
      Promise.resolve().then(() => log("a handler under " + here()));
      queueMicrotask(() => log("a queued function under " + here()));
    });
    log("behind run: " + here());
  });
  Promise.resolve().then(() => log("the next handler under " + here()));
  await Promise.all(before);
  log("behind all: " + here());
  await macrotask();
  log("in a timer's turn: " + here());
}

log("== side by side");
{
  async function request(name: string) {
    log(name + " starts under " + here());
    await waits(name + ".w", 2);
    await consumes(name + ".c", 2);
    await Promise.resolve().then(() => log(name + " handler under " + here())).then(() => log(name + " link under " + here()));
    await new Promise<void>(resolve => queueMicrotask(() => { log(name + " queued under " + here()); resolve(); }));
    await Promise.reject(new Error(name)).catch(() => log(name + " catch under " + here()));
    try { await Promise.reject(new Error(name)); } catch { log(name + " caught under " + here()); }
    return name + " ends under " + here();
  }
  const all = [storage.run("one", request, "r1"), request("r0"), storage.run("two", request, "r2"), storage.run("one", request, "r3")];
  for (const line of await Promise.all(all)) log(line);
  log("behind all: " + here());
}

log("== what a job leaves does not outlive it");
{
  Promise.resolve().then(() => { storage.enterWith("left by a handler"); log("entered: " + here()); });
  Promise.resolve().then(() => log("the next handler: " + here()));
  queueMicrotask(() => log("the next queued function: " + here()));
  (async () => { await null; log("a coroutine: " + here()); storage.enterWith("left by a coroutine"); await null; log("the same coroutine: " + here()); })();
  (async () => { await null; await null; await null; log("another coroutine: " + here()); })();
  await macrotask();
  log("in a timer's turn: " + here());
}

log("== a store is captured where the reaction is made, not where the promise settles");
{
  let settle!: (value: string) => void;
  const promise = new Promise<string>(resolve => { settle = resolve; });
  storage.run("maker", () => { promise.then(() => log("then under " + here())); (async () => { await promise; log("await under " + here()); })(); });
  promise.then(() => log("then under " + here()));
  storage.run("settler", () => settle("x"));
  await macrotask();
}

log("== nested and left");
{
  await storage.run("outer", async () => {
    await null;
    log("outer: " + here());
    await storage.run("inner", async () => { await null; log("inner: " + here()); await waits("n", 1); });
    log("outer again: " + here());
    storage.exit(() => { log("outside: " + here()); Promise.resolve().then(() => log("a handler made outside: " + here())); });
    await null;
    log("outer at the end: " + here());
  });
  log("behind: " + here());
}

log("== many");
{
  let wrong = 0;
  async function one(id: string) {
    for (let i = 0; i < 3; i++) { await null; if (here() !== id) wrong++; }
    for await (const value of yields(id, 2)) if (!value.endsWith("under " + id) || here() !== id) wrong++;
    await Promise.resolve().then(() => { if (here() !== id) wrong++; });
  }
  const all: Promise<void>[] = [];
  for (let i = 0; i < 2000; i++) all.push(storage.run("s" + (i % 7), one, "s" + (i % 7)));
  await Promise.all(all);
  log("wrong " + wrong);
}
console.log(lines.join("\n"));
//// finally-shares-native-executables.ts
import { heapStats } from "bun:jsc";

class Query<T> extends Promise<T> {}

function countExecutables(): number {
  Bun.gc(true);
  return heapStats().objectTypeCounts.NativeExecutable ?? 0;
}

let ran = 0;
const settled: Promise<number>[] = [];
const before = countExecutables();
for (let i = 0; i < 2_000; i++) {
  settled.push(new Query<number>(resolve => resolve(i)).finally(() => void ran++));
  settled.push(new Query<number>((_, reject) => reject(new Error("rejected"))).finally(() => void ran++).catch(() => -1));
}
const whilePending = countExecutables() - before;
const values = await Promise.all(settled);
console.log(whilePending < 100 ? "finally() shares its executables" : "finally() allocated executables");
console.log(ran, values.length, values[0], values[1], values[3_998], values[3_999], settled[0] instanceof Query);
//// first-next-tick-in-microtask.ts
// The first process.nextTick of a program, made inside a microtask: its callback runs right behind that microtask.
// Awaits before it and behind it must keep their places.
const log: string[] = [];
////= note

async function leaf(label: string, value: number): Promise<number> {
    await null;
    note(label + " leaf " + value);
    return value + 1;
}

async function chain(label: string, ticksAt: number): Promise<void> {
    for (let i = 0; i < 6; i++) {
        const value = await leaf(label, i);
        note(label + " has " + value);
        if (i === ticksAt) {
            process.nextTick(() => note(label + " tick made at " + i));
            note(label + " asked for a tick");
            await null;
            note(label + " behind an await of null");
            await Promise.resolve(1);
            note(label + " behind an await of a fulfilled promise");
            for await (const item of [1, 2])
                note(label + " item " + item);
        }
    }
}

async function* numbers(label: string): AsyncGenerator<number> {
    for (let i = 0; i < 4; i++) {
        await null;
        yield i;
        note(label + " behind its yield of " + i);
    }
}

async function consume(label: string): Promise<void> {
    for await (const value of numbers(label))
        note(label + " sees " + value);
}

async function main(): Promise<void> {
    await chain("before any tick", -1);
    await consume("before any tick");
    await Promise.all([chain("first", 2), consume("beside")]);
    await Promise.all([chain("second", 1), consume("beside again")]);
    await chain("alone", 3);
    console.log(log.join("\n"));
}

main();
//// first-suspensions-of-many-frame-sizes.ts
// The first time an activation is suspended, the object that keeps its frame is made: at the first await of an async function, whether it awaits a promise, a call or a step of `for await`, and at
// the creation of a generator or an async generator. Here the frames keep 0, 1, 7, 40, 300 and 2,000 values alive, as variables and as parameters, in every representation: small and large
// integers, fractions, NaN, -0 and infinities, booleans, strings of both widths, ropes and slices, objects, arrays, BigInts, symbols, closures, unions and `any`. Nothing but the suspended frame refers
// to them while the collector runs, once for the young and once for all. Frames that have ended leave holes among those that wait, later frames fill the holes, and some functions collect as soon as they go on.
declare const gc: undefined | (() => void);
declare const edenGC: undefined | (() => void);
const collect: () => void = typeof gc === "function" ? gc : () => Bun.gc(true);
const collectYoung: () => void = typeof edenGC === "function" ? edenGC : require("bun:jsc").edenGC;
const lines: string[] = [];

let state = 12345;
function next(): number {
  state = (Math.imul(state, 1103515245) + 12345) & 0x7fffffff;
  return state % 1000;
}
////= lines-4	Box	value	number	text	string
////= lines-3	Point	readonly	x	number	y	number
type Either = number | string | boolean | null | undefined | Box;
type Adds = (n: number) => number;
type Steps = Generator<number, number, number>;
type StepsLater = AsyncGenerator<number, number, number>;
const letters = Array.from({ length: 64 }, (_, i) => String.fromCharCode(97 + (i % 26))).join("");

function box(): Box {
  const value = next();
  return { value, text: "b" + value };
}
function fraction(): number {
  return next() / 8;
}
function narrow(): string {
  return String(next() + 1000);
}
function int(): number {
  return next() | 0;
}
function either(): Either {
  switch (next() % 6) {
    case 0:
      return next();
    case 1:
      return "e" + next();
    case 2:
      return next() > 500;
    case 3:
      return null;
    case 4:
      return undefined;
    default:
      return box();
  }
}
function flag(): boolean {
  return next() > 500;
}
function big(): bigint {
  return BigInt(next()) * 12345678901234567890123n + 1n;
}
function large(): number {
  return next() * 4294967296 + next();
}
function special(): number {
  switch (next() % 5) {
    case 0:
      return NaN;
    case 1:
      return -0;
    case 2:
      return Infinity;
    case 3:
      return -Infinity;
    default:
      return 5e-324;
  }
}
function wide(): string {
  return String.fromCharCode(0x3b1 + (next() % 24), 0x4e00 + next());
}
function rope(): string {
  return narrow() + "+" + wide() + "+" + narrow();
}
function slice(): string {
  const start = next() % 40;
  return letters.slice(start, start + 20);
}
function point(): Point {
  return new Point(next(), next() / 2);
}
function list(): number[] {
  return [next(), next() / 4, next()];
}
function mark(): symbol {
  return Symbol("m" + next());
}
function adder(): Adds {
  const by = next();
  return n => n + by;
}
function parsed(): any {
  return JSON.parse('{"p":' + next() + ',"q":[' + next() + "]}");
}

function mix(hash: number, value: number): number {
  return (hash * 31 + value) % 1000003;
}
function ofNumber(h: number, v: number): number {
  if (v !== v) return mix(h, 11);
  if (v === 0) return mix(h, 1 / v < 0 ? 13 : 17);
  if (v === Infinity || v === -Infinity) return mix(h, v > 0 ? 19 : 23);
  if (v === 5e-324) return mix(h, 29);
  return mix(h, (v * 8) % 1000003);
}
function ofText(h: number, v: string): number {
  h = mix(h, v.length);
  for (let i = 0; i < v.length; i++) h = mix(h, v.charCodeAt(i));
  return h;
}
function ofBox(h: number, v: Box): number {
  return ofText(mix(h, v.value), v.text);
}
function ofEither(h: number, v: Either): number {
  if (typeof v === "number") return ofNumber(h, v);
  if (typeof v === "string") return ofText(h, v);
  if (typeof v === "boolean") return mix(h, v ? 3 : 5);
  if (v === null) return mix(h, 7);
  if (v === undefined) return mix(h, 9);
  return ofBox(h, v);
}
function ofFlag(h: number, v: boolean): number {
  return mix(h, v ? 1 : 2);
}
function ofBig(h: number, v: bigint): number {
  return mix(h, Number(v % 1000003n));
}
function ofPoint(h: number, v: Point): number {
  return mix(mix(h, v.x), v.y * 2);
}
function ofList(h: number, v: number[]): number {
  return mix(mix(mix(mix(h, v.length), v[0]), v[1] * 4), v[2]);
}
function ofMark(h: number, v: symbol): number {
  return ofText(h, v.description ?? "");
}
function ofAdder(h: number, v: Adds): number {
  return mix(h, v(1));
}
function ofParsed(h: number, v: any): number {
  return mix(mix(h, v.p), v.q[0]);
}
function fold(h: number, b: Box, d: number, s: string, i: number, e: Either, t: boolean, g: bigint, l: number, z: number, w: string, r: string, p: string, k: Point, a: number[], y: symbol, c: Adds, x: any): number {
  h = ofBox(h, b);
  h = ofNumber(h, d);
  h = ofText(h, s);
  h = ofNumber(h, i);
  h = ofEither(h, e);
  h = ofFlag(h, t);
  h = ofBig(h, g);
  h = ofNumber(h, l);
  h = ofNumber(h, z);
  h = ofText(h, w);
  h = ofText(h, r);
  h = ofText(h, p);
  h = ofPoint(h, k);
  h = ofList(h, a);
  h = ofMark(h, y);
  h = ofAdder(h, c);
  h = ofParsed(h, x);
  return h;
}

// Whatever is made for an activation before its parameters are evaluated is old when every sixteenth one is suspended for the first time.
let ages = 0;
function age(): number {
  if (++ages % 16 === 0) collect();
  return ages;
}
async function waitsFor(gate: Promise<number>): Promise<number> {
  return (await gate) + 1;
}
async function* streamOf(gate: Promise<number>): AsyncGenerator<number, void, unknown> {
  yield 1;
  yield await gate;
  yield 3;
}

async function awaits0(gate: Promise<number>, collects: boolean): Promise<number> {
  let h = await gate;
  if (collects) collect();
  return h;
}
