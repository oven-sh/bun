//// await-results-in-loops-and-handlers.ts
// What an await yields is of the type the checker gives it: strings, records, arrays, functions, maps, undefined, null: in straight code, in loops, inside try, after a rejection.

interface User { id: number; name: string; tags: string[]; boss: User | undefined; }
const lines: string[] = [];
function say(...parts: unknown[]) { lines.push(parts.map(part => typeof part === "object" && part !== null ? JSON.stringify(part) : String(part)).join(" ")); }

async function text(id: number): Promise<string> { await null; return "user" + id; }
async function textOrNothing(id: number): Promise<string | undefined | null> { await null; return id % 3 === 0 ? undefined : id % 3 === 1 ? null : "t" + id; }
async function user(id: number): Promise<User> { const name = await text(id); return { id, name, tags: [name], boss: undefined }; }
async function userOrNothing(id: number): Promise<User | undefined> { return id % 2 ? await user(id) : undefined; }
async function list(id: number): Promise<string[]> { return [await text(id), await text(id + 1)]; }
async function table(id: number): Promise<Map<string, number>> { return new Map([[await text(id), id]]); }
async function adder(id: number): Promise<(n: number) => number> { await null; return n => n + id; }
async function fails(id: number): Promise<User> { await null; throw new RangeError("no user " + id); }
function already(id: number): Promise<string> { return Promise.resolve("already" + id); }
function thenable(id: number): PromiseLike<string> { return { then(resolve) { resolve!("then" + id); return this as any; } }; }

class Store {
    private seen = 0;
    async get(id: number): Promise<User> { this.seen++; return await user(id); }
    async count(): Promise<number> { await null; return this.seen; }
}

async function main() {
    const store = new Store();
    say(await text(1), (await text(2)).length);
    for (let i = 0; i < 4; i++) {
        const t = await textOrNothing(i);
        say("text or nothing", t, t?.length, t ?? "none");
        const u = await user(i);
        say("user", u, u.tags.length, u.boss);
        const m = await userOrNothing(i);
        say("maybe", m?.name, m === undefined);
        const l = await list(i);
        say("list", l.join(), l.length);
        const map = await table(i);
        say("table", map.size, map.get("user" + i));
        say("adder", (await adder(i))(10));
        say("store", (await store.get(i)).name, await store.count());
        say("others", await already(i), await thenable(i), await i, await "plain", await undefined);
    }
    for (const id of [1, 2]) {
        try {
            const u = id === 1 ? await user(id) : await fails(id);
            say("inside try", u.name);
        } catch (error) {
            say("caught", (error as Error).name, (error as Error).message);
        } finally {
            say("finally", await text(id));
        }
    }
    const [a, b, c] = await Promise.all([text(7), user(8), list(9)]);
    say("all", a, b.name, c.length);
    const raced = await Promise.race([text(10), text(11)]);
    say("race", raced);
    let total = 0;
    for (let i = 0; i < 300; i++) total += (await text(i)).length + (await user(i)).id;
    say("total", total);
}
main().then(() => console.log(lines.join("\n")));
//// await-results-of-another-type-live-to-the-end.ts
// Ten awaits in a row whose results all live to the end of the function. At each position in turn the awaited value is not what its type says, and the rest of the function goes on as in plain Bun.
type Row = { id: number; name: string; tags: string[] };

function later<T>(value: T): Promise<T> {
    return new Promise(resolve => setTimeout(() => resolve(value), 0));
}

function makeRow(id: number, isOther: boolean): Row {
    if (isOther) {
        const other: any = { tags: ["x"], extra: true, name: "other" + id, id: String(id) };
        return other;
    }
    return { id, name: "row" + id, tags: ["a" + id, "b"] };
}

async function tenInARow(seed: number, otherAt: number): Promise<string> {
    const a = await later(makeRow(seed, otherAt === 0));
    const b = await later(makeRow(a.id + 1, otherAt === 1));
    const c = await later(makeRow(b.id + 1, otherAt === 2));
    const d = await later(makeRow(c.id + 1, otherAt === 3));
    const e = await later(makeRow(d.id + 1, otherAt === 4));
    const f = await later(makeRow(e.id + 1, otherAt === 5));
    const g = await later(makeRow(f.id + 1, otherAt === 6));
    const h = await later(makeRow(g.id + 1, otherAt === 7));
    const i = await later(makeRow(h.id + 1, otherAt === 8));
    const j = await later(makeRow(i.id + 1, otherAt === 9));
    return [a, b, c, d, e, f, g, h, i, j].map(row => row.name + ":" + row.tags.length + ":" + typeof row.id).join(",");
}

for (let otherAt = -1; otherAt < 10; otherAt++)
    console.log(await tenInARow(1, otherAt));
//// await-slow-paths.js
// Await of everything that is not a native promise, ordered against other microtasks, and generators whose prototype was replaced.
const log = line => console.log(line);

function thenableWithGetter(label, value) {
  return {
    get then() {
      log(label + ": then getter");
      return resolve => {
        log(label + ": then called");
        resolve(value);
      };
    },
  };
}

class CountingPromise extends Promise {}

function tick(label, count) {
  let promise = Promise.resolve();
  for (let i = 0; i < count; i++) promise = promise.then(() => log(label + " tick " + i));
  return promise;
}

async function awaitsInFunction(label) {
  log(label + ": start");
  log(label + ": thenable gave " + (await thenableWithGetter(label, 1)));
  log(label + ": subclass gave " + (await CountingPromise.resolve(2)));
  log(label + ": primitive gave " + (await 3));
  log(label + ": undefined gave " + (await undefined));
  log(label + ": native gave " + (await Promise.resolve(4)));
  return label + " done";
}

async function* awaitsInGenerator(label) {
  log(label + ": start");
  yield await thenableWithGetter(label, 1);
  yield await CountingPromise.resolve(2);
  yield await 3;
  yield await Promise.resolve(4);
  return label + " done";
}

async function throwsBeforeAwait() {
  log("throws before await: start");
  throw new Error("before the first await");
}

async function* throwsBeforeAwaitInGenerator() {
  log("generator throws before await: start");
  throw new Error("before the first await in a generator");
}

async function rejectsThroughThenable() {
  try {
    await {
      then(resolve, reject) {
        reject(new Error("rejected by thenable"));
      },
    };
  } catch (error) {
    return "caught " + error.message;
  }
}

async function throwingThenGetter() {
  try {
    await {
      get then() {
        throw new Error("then getter threw");
      },
    };
  } catch (error) {
    return "caught " + error.message;
  }
}

function* counts() {
  yield 1;
}
const replacement = {
  marker: "replaced",
  next() {
    return { done: true, value: "from replacement" };
  },
};
const beforeReplacement = counts();
counts.prototype = replacement;
const afterReplacement = counts();

async function main() {
  const inFunction = awaitsInFunction("function");
  const ticks = tick("function", 6);
  log(await inFunction);
  await ticks;

  const generator = awaitsInGenerator("generator");
  const generatorTicks = tick("generator", 6);
  for (let step = await generator.next(); ; step = await generator.next()) {
    log("generator step " + step.value + " " + step.done);
    if (step.done) break;
  }
  await generatorTicks;

  const rejected = throwsBeforeAwait();
  log("after call that throws before await");
  await rejected.catch(error => log("caught " + error.message));

  const rejectedGenerator = throwsBeforeAwaitInGenerator();
  log("after generator call");
  await rejectedGenerator.next().catch(error => log("caught " + error.message));

  log(await rejectsThroughThenable());
  log(await throwingThenGetter());

  log("before replacement: " + (beforeReplacement.marker === undefined) + " " + beforeReplacement.next().value);
  log("after replacement: " + afterReplacement.marker + " " + afterReplacement.next().value);
  log("instance of replaced function: " + (afterReplacement instanceof counts) + " " + (beforeReplacement instanceof counts));
}

main();
//// awaited-call-synchronous-throw.ts
// An async function that is awaited where it is called throws before its first await: arguments, the body up to the throw, other jobs and the handler run in the order of plain Bun.
const log: string[] = [];
function note(text: string): string { log.push(text); return text; }
function ticks(label: string, count: number): void { let chain: Promise<unknown> = Promise.resolve(); for (let i = 1; i <= count; i++) chain = chain.then(() => { log.push(label + i); }); }
function text(error: unknown): string { return error instanceof Error ? error.name + " " + error.message : String(error); }
async function throwsAtOnce(a: string, b: string): Promise<string> { note("body " + a + b); throw new Error("at once " + a); }
async function throwsInDefault(a: string = ((): string => { note("default"); throw new RangeError("in a default"); })()): Promise<string> { return a; }
async function throwsLater(a: string): Promise<string> { note("body " + a); await null; note("resumed " + a); throw new Error("later " + a); }
async function returnsAtOnce(a: string): Promise<string> { note("body " + a); return a; }
function throwsInArgument(): string { note("argument"); throw new TypeError("in an argument"); }
async function inTry(): Promise<void> { ticks("t", 3); try { note("before"); await throwsAtOnce(note("x"), note("y")); note("not reached"); } catch (error) { note("caught " + text(error)); } finally { note("finally"); } }
async function withoutHandler(): Promise<string> { ticks("t", 3); note("before"); return (await throwsAtOnce("p", "q")) + note("not reached"); }
async function inLoop(): Promise<void> { ticks("t", 6); for (let i = 0; i < 3; i++) { try { note("value " + (i === 1 ? await throwsAtOnce("i", String(i)) : await returnsAtOnce("i" + i))); } catch (error) { note("caught " + text(error)); } } }
async function defaultThrows(): Promise<void> { ticks("t", 3); try { await throwsInDefault(); } catch (error) { note("caught " + text(error)); } }
async function argumentThrows(): Promise<void> { ticks("t", 3); try { await returnsAtOnce(throwsInArgument()); } catch (error) { note("caught " + text(error)); } }
async function callOutsideTry(): Promise<void> { ticks("t", 3); const pending = throwsAtOnce("o", "t"); try { note("between"); await pending; } catch (error) { note("caught " + text(error)); } }
async function nestedCalls(): Promise<void> { ticks("t", 4); try { await returnsAtOnce(await throwsAtOnce("n", "1")); } catch (error) { note("caught " + text(error)); } }
async function inFinally(): Promise<void> { ticks("t", 3); try { try { note("try"); } finally { await throwsAtOnce("f", "1"); } } catch (error) { note("caught " + text(error)); } }
async function afterAwait(): Promise<void> { ticks("t", 4); try { await throwsLater("l"); } catch (error) { note("caught " + text(error)); } }
async function returned(): Promise<string> { ticks("t", 3); try { return await throwsAtOnce("r", "1"); } catch (error) { return note("caught " + text(error)); } }
async function throughTwoCallers(): Promise<void> { ticks("t", 5); try { await withoutHandler(); } catch (error) { note("caught outside " + text(error)); } }
for (const run of [inTry, withoutHandler, inLoop, defaultThrows, argumentThrows, callOutsideTry, nestedCalls, inFinally, afterAwait, returned, throughTwoCallers]) {
  log.length = 0;
  try { await run(); } catch (error) { note("rejected " + text(error)); }
  for (let i = 0; i < 8; i++) await null;
  console.log(run.name + ": " + log.join(", "));
}
//// awaited-calls-of-functions-that-end-alike.js
// Async functions that end alike, each awaited where it is called, at the top level of a module and in a function. The compiler calls such a function without a promise and shares code that occurs many times: the end of an async function, which resumes whoever awaits it, has to stay in the function.
const sleep = () => new Promise(resolve => setTimeout(resolve, 1));
await (async () => { await sleep(); console.log("top level", 1); })();
await (async () => { await null; console.log("top level", 2); })();
await (async () => { await sleep(); console.log("top level", 3); })();
await (async () => { await Promise.resolve(1).then(value => value); console.log("top level", 4); })();
async function main() {
  await (async () => { await null; console.log("function", 1); })();
  await (async () => { await null; console.log("function", 2); })();
  await (async () => { await null; console.log("function", 3); })();
  await (async () => { await null; console.log("function", 4); })();
  await (async () => { await null; console.log("function", 5); })();
  return "done";
}
console.log(await main());
//// awaited-promise-unescaped.ts
// The awaited value is a built-in promise that never escapes.
async function list(n: number) { const a: number[] = []; for (let i = 0; i < n; i++) a.push(i); return a }
async function table() { return new Map([["a", 1]]) }
async function use() {
  const a = await list(3)
  const m = await table()
  return a.length + m.size + a.filter(x => x > 0).length
}
console.log(await use())
//// awaited-steps-of-a-generator-that-lived-through-a-collection.mjs
// `await generator.next()` goes on in its turn among the other jobs whether or not the generator, its consumer or both have lived through a collection since the last step.
const ends = {
  throws: () => { throw new Error("the end"); },
  "falls off": () => {},
};
const collections = { full: () => Bun.gc(true), none: () => {} };

async function run(end, consumer, place, collection) {
  const lines = [];
  const collect = at => { if (at === place) collections[collection](); };
  const started = [];
  let self;
  const loop = async () => {
    try { for await (const value of self) lines.push("loop got " + value); lines.push("loop ends"); } catch (error) { lines.push("loop caught " + error.message); }
  };
  const byCall = async () => { const step = await self.next(); lines.push("call got " + step.value + " " + step.done); };
  self = (async function* () {
    collect(1); yield 1; collect(2);
    started.push(loop()); collect(3);
    started.push(byCall()); collect(4);
    lines.push("started");
    ends[end]();
  })();
  async function byFunction(generator, steps) {
    for (let i = 0; i < steps; i++) {
      try { collect(5 + i); const step = await generator.next(); lines.push("hand got " + step.value + " " + step.done); } catch (error) { lines.push("hand caught " + error.message); }
    }
  }
  async function* byGenerator(generator, steps) {
    for (let i = 0; i < steps; i++) {
      try { collect(5 + i); const step = await generator.next(); lines.push("hand got " + step.value + " " + step.done); } catch (error) { lines.push("hand caught " + error.message); }
    }
  }
  async function busy(turns) { for (let i = 0; i < turns; i++) { await null; lines.push("turn " + i); } }
  const others = busy(12);
  if (consumer === "function") await byFunction(self, 3);
  else await byGenerator(self, 3).next();
  await Promise.all(started);
  await others;
  return lines.join(" . ");
}

for (const end of Object.keys(ends)) {
  for (const consumer of ["function", "generator"]) {
    const expected = await run(end, consumer, 0, "none");
    console.log(end, "|", consumer, "|", expected);
    for (let place = 1; place <= 7; place++) {
      const order = await run(end, consumer, place, "full");
      console.log(end, "|", consumer, "| a collection at", place, order === expected ? "changes nothing" : "CHANGES THE ORDER: " + order);
    }
  }
}
//// awaited-steps-under-stores-that-wait-or-do-not.ts
// `await generator.next()` goes on under the store that was active at the await, whether the step is finished at once, behind other jobs, behind an await in the body, by a throw or by the end of the body,
// and whoever finishes it under whichever store.
import { AsyncLocalStorage } from "node:async_hooks";
const store = new AsyncLocalStorage<string>();
const lines: string[] = [];
const seen = (where: string) => void lines.push(where + " | " + String(store.getStore()));
const tick = () => new Promise<void>(resolve => queueMicrotask(resolve));
let release: ((value: number) => void) | undefined;
const gate = () => new Promise<number>(resolve => (release = resolve));

async function* atOnce(name: string) {
  for (let i = 0; i < 3; i++) { seen(name + " body " + i); yield i; }
  return "end of " + name;
}
async function* waits(name: string) {
  for (let i = 0; i < 2; i++) { seen(name + " before"); await tick(); seen(name + " behind"); yield i; }
}
async function* gated(name: string) {
  seen(name + " before the gate");
  const value = await gate();
  seen(name + " behind the gate");
  yield value;
  seen(name + " goes on");
}
async function* throwsAtOnce(name: string): AsyncGenerator<number> {
  yield 1;
  seen(name + " throws");
  throw new Error("thrown by " + name);
}
async function* throwsLater(name: string): AsyncGenerator<number> {
  await tick();
  seen(name + " throws later");
  throw new Error("thrown later by " + name);
}
async function* enters(name: string) {
  yield 1;
  store.enterWith("entered by " + name);
  seen(name + " entered");
  yield 2;
  await tick();
  seen(name + " behind its wait");
  yield 3;
}
async function* yieldsPromises(name: string) {
  yield Promise.resolve(name + " 1");
  yield store.run("inside " + name, () => tick().then(() => name + " 2"));
  yield { then(resolve: (value: string) => void) { seen(name + " then"); resolve(name + " 3"); } } as unknown as string;
}

async function byHand<T>(name: string, generator: AsyncGenerator<T, unknown, unknown>, steps: number) {
  for (let i = 0; i < steps; i++) {
    try {
      const step = await generator.next();
      seen(name + " got " + JSON.stringify(step.value) + " " + step.done);
    } catch (error) {
      seen(name + " caught " + (error as Error).message);
    }
  }
}
async function* byHandInGenerator<T>(name: string, generator: AsyncGenerator<T, unknown, unknown>, steps: number) {
  for (let i = 0; i < steps; i++) {
    const step = await generator.next();
    seen(name + " got " + JSON.stringify(step.value) + " " + step.done);
    yield step.value;
  }
}
async function busy(name: string, turns: number) {
  for (let i = 0; i < turns; i++) { await null; seen(name + " turn " + i); }
}

async function main() {
  await store.run("a", () => byHand("at once", atOnce("g1"), 5));
  await Promise.all([store.run("b", () => byHand("among jobs", atOnce("g2"), 5)), store.run("other", () => busy("busy", 6))]);
  await store.run("c", () => byHand("waits", waits("g3"), 3));
  const shared = waits("g4");
  await Promise.all([store.run("d1", () => byHand("first of two", shared, 2)), store.run("d2", () => byHand("second of two", shared, 2))]);
  const waiting = store.run("e", () => byHand("gated", gated("g5"), 2));
  await tick();
  store.run("opener", () => release!(7));
  await waiting;
  await store.run("f", () => byHand("throws", throwsAtOnce("g6"), 3));
  await store.run("g", () => byHand("throws later", throwsLater("g7"), 2));
  await store.run("h", () => byHand("enters", enters("g8"), 4));
  seen("behind enters");
  await store.run("i", () => byHand("promises", yieldsPromises("g9"), 4));
  await store.run("j", async () => { for await (const value of byHandInGenerator("in a generator", waits("g10"), 2)) seen("loop got " + value); });
  await store.run("k", () => byHand("over one that steps by hand", byHandInGenerator("inner", atOnce("g11"), 2), 3));

  // The body starts loops over its own generator and ends: their requests wait behind the one that is being answered, and the end of the body answers them all.
  for (const end of ["throws", "returns", "falls off"]) {
    for (const consumer of ["function", "generator"]) {
      for (const loops of [1, 2]) {
        const name = end + ", " + consumer + ", " + loops;
        let self: AsyncGenerator<number, unknown, unknown> | undefined;
        const started: Promise<void>[] = [];
        const loop = async (which: number) => {
          try { for await (const value of self!) seen(name + ": loop " + which + " got " + value); seen(name + ": loop " + which + " ends"); } catch (error) { seen(name + ": loop " + which + " caught " + (error as Error).message); }
        };
        const byCall = async () => { const step = await self!.next(); seen(name + ": a call got " + JSON.stringify(step.value) + " " + step.done); };
        self = (async function* (): AsyncGenerator<number, unknown, unknown> {
          yield 1;
          for (let which = 0; which < loops; which++) started.push(store.run("loop " + which, () => loop(which)));
          started.push(store.run("call", byCall));
          seen(name + ": started");
          if (end === "throws") throw new Error("the end of " + name);
          if (end === "returns") return "returned by " + name;
        })();
        if (consumer === "function") await store.run("l", () => byHand(name, self!, 3));
        else await store.run("l", async () => { try { for await (const value of byHandInGenerator(name, self!, 3)) seen(name + ": outer got " + JSON.stringify(value)); } catch (error) { seen(name + ": outer caught " + (error as Error).message); } });
        await Promise.all(started);
      }
    }
  }
  seen("end");
}
main().then(() => console.log(lines.join("\n")));
//// chains-of-waiters-resume-in-order.ts
// Eight async functions wait for one another and the innermost one waits for a promise. Once it is settled they go on from the inside out, a job each, and whatever else is queued keeps its place
// between them: then() reactions registered before and after the await, callbacks of queueMicrotask() and process.nextTick(), a second chain, a drain of the queue in the middle, results that are
// promises or thenables. The eight frames differ in size and each function finds its own values again. In the middle of one chain the program makes its first AsyncLocalStorage, then everything
// runs once more: every function goes on in the context in which it began to wait.
import { drainMicrotasks } from "bun:jsc";
import { AsyncLocalStorage } from "node:async_hooks";

const log: string[] = [];
let storage: AsyncLocalStorage<string> | undefined;
type Visit = (depth: number) => void;
const visitsNothing: Visit = () => {};

function deferred() {
  let resolve!: (value: number) => void;
  const promise = new Promise<number>(res => {
    resolve = res;
  });
  return { promise, resolve };
}
function turnOfTheEventLoop(): Promise<void> {
  return new Promise<void>(resolve => {
    setImmediate(resolve);
  });
}
function inContext<T>(name: string, action: () => T): T {
  return storage ? storage.run(name, action) : action();
}
function context(): string {
  return storage ? ", in " + storage.getStore() : "";
}
// One line a turn of the job queue, so a turn that is lost or added shows.
////= countTurns

let serial = 0;
////= lines-4	Pair	left	number	right	number
function whole(): number {
  return ++serial;
}
function half(): number {
  return ++serial / 2;
}
function text(): string {
  return "s" + ++serial;
}
function pair(): Pair {
  const left = ++serial;
  return { left, right: left * 3 };
}
function worth(value: string | Pair): number {
  return typeof value === "string" ? Number(value.slice(1)) : value.left + value.right;
}
function goesOn(chain: string, depth: number, value: number, kept: number, visit: Visit): void {
  visit(depth);
  log.push(chain + depth + " goes on with " + value + ", keeps " + kept + context());
}

async function depth8(chain: string, gate: Promise<number>, visit: Visit): Promise<number> {
  const value = await gate;
  goesOn(chain, 8, value, 0, visit);
  return value + 1;
}
async function depth7(chain: string, gate: Promise<number>, visit: Visit): Promise<number> {
  const a = whole();
  const value = await depth8(chain, gate, visit);
  goesOn(chain, 7, value, a, visit);
  return value + 1;
}
async function depth6(chain: string, gate: Promise<number>, visit: Visit): Promise<number> {
  const a = whole(), b = text();
  const value = await depth7(chain, gate, visit);
  goesOn(chain, 6, value, a + worth(b), visit);
  return value + 1;
}
async function depth5(chain: string, gate: Promise<number>, visit: Visit): Promise<number> {
  const a = whole(), b = text(), c = pair();
  const value = await depth6(chain, gate, visit);
  goesOn(chain, 5, value, a + worth(b) + worth(c), visit);
  return value + 1;
}
async function depth4(chain: string, gate: Promise<number>, visit: Visit): Promise<number> {
  const a = whole(), b = text(), c = pair(), d = half(), e = whole();
  const value = await depth5(chain, gate, visit);
  goesOn(chain, 4, value, a + worth(b) + worth(c) + d + e, visit);
  return value + 1;
}
async function depth3(chain: string, gate: Promise<number>, visit: Visit): Promise<number> {
  const a = whole(), b = text(), c = pair(), d = half(), e = whole(), f = text(), g = pair(), h = half();
  const value = await depth4(chain, gate, visit);
  goesOn(chain, 3, value, a + worth(b) + worth(c) + d + e + worth(f) + worth(g) + h, visit);
  return value + 1;
}
async function depth2(chain: string, gate: Promise<number>, visit: Visit): Promise<number> {
  const a = whole(), b = text(), c = pair(), d = half(), e = whole(), f = text(), g = pair(), h = half();
  const i = whole(), j = text(), k = pair(), l = half(), m = whole();
  const value = await depth3(chain, gate, visit);
  goesOn(chain, 2, value, a + worth(b) + worth(c) + d + e + worth(f) + worth(g) + h + i + worth(j) + worth(k) + l + m, visit);
  return value + 1;
}
async function depth1(chain: string, gate: Promise<number>, visit: Visit): Promise<number> {
  const a = whole(), b = text(), c = pair(), d = half(), e = whole(), f = text(), g = pair(), h = half();
  const i = whole(), j = text(), k = pair(), l = half(), m = whole(), n = text(), o = pair(), p = half();
  const q = whole(), r = text(), s = pair(), t = half(), u = whole();
  const value = await depth2(chain, gate, visit);
  const kept = a + worth(b) + worth(c) + d + e + worth(f) + worth(g) + h + i + worth(j) + worth(k) + l + m + worth(n) + worth(o) + p + q + worth(r) + worth(s) + t + u;
  goesOn(chain, 1, value, kept, visit);
  return value + 1;
}

// Each function holds the promise of the one below, so others can wait for it as well.
type Watch = (depth: number, below: Promise<number>) => void;
async function keepsPromise(depth: number, gate: Promise<number>, watch: Watch): Promise<number> {
  const below = depth === 8 ? gate : keepsPromise(depth + 1, gate, watch);
  watch(depth, below);
  const value = await below;
  log.push("k" + depth + " goes on with " + value + context());
  return value + 1;
}

type Leave = (depth: number, value: number) => any;
async function leavesWith(depth: number, gate: Promise<number>, leave: Leave): Promise<number> {
  const value = depth === 8 ? await gate : await leavesWith(depth + 1, gate, leave);
  log.push("r" + depth + " goes on with " + value + context());
  return leave(depth, value + 1);
}

async function awaitsTwice(depth: number, first: Promise<number>, second: Promise<number>): Promise<number> {
  const value = depth === 8 ? await first : await awaitsTwice(depth + 1, first, second);
  log.push("t" + depth + " goes on with " + value + context());
  const more = await second;
  log.push("t" + depth + " goes on again with " + more + context());
  return value + more;
}

function startChain(chain: string, gate: Promise<number>, visit: Visit): Promise<number> {
  return inContext("the starter of " + chain, () => depth1(chain, gate, visit));
}
function settle(gate: { resolve: (value: number) => void }, value: number): void {
  inContext("the resolver", () => gate.resolve(value));
}
function settleFromTheEventLoop(gate: { resolve: (value: number) => void }, value: number): void {
  setImmediate(() => settle(gate, value));
}

const scenarios: [title: string, body: () => Promise<void>][] = [
  [
    "nothing else is queued",
    async () => {
      const gate = deferred();
      const result = startChain("a", gate.promise, visitsNothing);
      settleFromTheEventLoop(gate, 100);
      log.push("result " + (await result) + context());
    },
  ],
  [
    "a chain of reactions starts behind the resolution",
    async () => {
      const gate = deferred();
      const result = startChain("a", gate.promise, visitsNothing);
      setImmediate(() => {
        settle(gate, 100);
        countTurns(12);
      });
      log.push("result " + (await result));
    },
  ],
  [
    "a chain of reactions starts in front of the resolution",
    async () => {
      const gate = deferred();
      const result = startChain("a", gate.promise, visitsNothing);
      setImmediate(() => {
        countTurns(12);
        settle(gate, 100);
      });
      log.push("result " + (await result));
    },
  ],
  [
    "reactions registered before and after the await",
    async () => {
      const gate = deferred();
      gate.promise.then(value => log.push("  reaction registered before the await: " + value + context()));
      const result = startChain("a", gate.promise, visitsNothing);
      gate.promise.then(value => log.push("  reaction registered after the await: " + value + context()));
      result.then(value => log.push("  reaction to the result, registered before it is awaited: " + value));
      settleFromTheEventLoop(gate, 100);
      log.push("result " + (await result));
      result.then(value => log.push("  reaction to the result, registered after it is settled: " + value));
    },
  ],
  [
    "every function queues a microtask",
    async () => {
      const gate = deferred();
      const result = startChain("a", gate.promise, depth => queueMicrotask(() => log.push("  microtask of " + depth + context())));
      settleFromTheEventLoop(gate, 100);
      log.push("result " + (await result));
    },
  ],
  [
    "every function calls process.nextTick",
    async () => {
      const gate = deferred();
      const result = startChain("a", gate.promise, depth => process.nextTick(() => log.push("  next tick of " + depth + context())));
      settleFromTheEventLoop(gate, 100);
      log.push("result " + (await result));
    },
  ],
  [
    "a microtask, a next tick, a reaction or nothing, by depth",
    async () => {
      const gate = deferred();
      const result = startChain("a", gate.promise, depth => {
        if (depth % 4 === 0) queueMicrotask(() => log.push("  microtask of " + depth));
        else if (depth % 4 === 1) process.nextTick(() => log.push("  next tick of " + depth));
        else if (depth % 4 === 2) Promise.resolve(depth).then(value => log.push("  reaction of " + value));
      });
      settleFromTheEventLoop(gate, 100);
      log.push("result " + (await result));
    },
  ],
  [
    "settled by a microtask between two others",
    async () => {
      const gate = deferred();
      const result = startChain("a", gate.promise, visitsNothing);
      queueMicrotask(() => log.push("  microtask in front"));
      queueMicrotask(() => settle(gate, 100));
      queueMicrotask(() => log.push("  microtask behind"));
      log.push("result " + (await result));
    },
  ],
  [
    "settled by a next tick between two others",
    async () => {
      const gate = deferred();
      const result = startChain("a", gate.promise, visitsNothing);
      process.nextTick(() => log.push("  next tick in front"));
      process.nextTick(() => settle(gate, 100));
      process.nextTick(() => log.push("  next tick behind"));
      log.push("result " + (await result));
    },
  ],
  [
    "settled by the function that awaits the result",
    async () => {
      const gate = deferred();
      const result = startChain("a", gate.promise, visitsNothing);
      await null;
      settle(gate, 100);
      log.push("result " + (await result));
    },
  ],
  [
    "two chains over one promise",
    async () => {
      const gate = deferred();
      const results = [startChain("a", gate.promise, visitsNothing), startChain("b", gate.promise, visitsNothing)];
      settleFromTheEventLoop(gate, 100);
      log.push("results " + (await Promise.all(results)).join(" "));
    },
  ],
  [
    "two chains over two promises that are settled together",
    async () => {
      const first = deferred(), second = deferred();
      const results = [startChain("a", first.promise, visitsNothing), startChain("b", second.promise, visitsNothing)];
      setImmediate(() => {
        settle(second, 200);
        settle(first, 100);
      });
      log.push("results " + (await Promise.all(results)).join(" "));
    },
  ],
  [
    "the fourth function of one chain settles the promise of another",
    async () => {
      const first = deferred(), second = deferred();
      const other = startChain("b", second.promise, visitsNothing);
      const result = startChain("a", first.promise, depth => {
        if (depth === 4) settle(second, 200);
      });
      settleFromTheEventLoop(first, 100);
      log.push("results " + (await result) + " " + (await other));
    },
  ],
  [
    "the sixth and the second function drain the queue",
    async () => {
      const gate = deferred();
      const result = startChain("a", gate.promise, depth => {
        if (depth !== 6 && depth !== 2) return;
        queueMicrotask(() => log.push("  microtask of " + depth));
        drainMicrotasks();
        log.push("  " + depth + " has drained the queue");
      });
      setImmediate(() => {
        settle(gate, 100);
        countTurns(6);
      });
      log.push("result " + (await result));
    },
  ],
  [
    "a whole chain runs inside the drain of another chain's third function",
    async () => {
      const first = deferred(), second = deferred();
      const other = startChain("b", second.promise, visitsNothing);
      const result = startChain("a", first.promise, depth => {
        if (depth !== 3) return;
        settle(second, 200);
        drainMicrotasks();
        log.push("  3 has drained the queue");
      });
      settleFromTheEventLoop(first, 100);
      log.push("results " + (await result) + " " + (await other));
    },
  ],
  [
    "promises that only the function above waits for",
    async () => {
      const gate = deferred();
      const result = inContext("the starter", () => keepsPromise(1, gate.promise, () => {}));
      setImmediate(() => {
        settle(gate, 100);
        countTurns(10);
      });
      log.push("result " + (await result));
    },
  ],
  [
    "promises with a reaction registered before the await",
    async () => {
      const gate = deferred();
      const result = inContext("the starter", () =>
        keepsPromise(1, gate.promise, (depth, below) => {
          below.then(value => log.push("  reaction in front of k" + depth + ": " + value + context()));
        }),
      );
      settleFromTheEventLoop(gate, 100);
      log.push("result " + (await result));
    },
  ],
  [
    "promises with a reaction registered after the await",
    async () => {
      const gate = deferred();
      const result = inContext("the starter", () =>
        keepsPromise(1, gate.promise, (depth, below) => {
          queueMicrotask(() => below.then(value => log.push("  reaction behind k" + depth + ": " + value + context())));
        }),
      );
      settleFromTheEventLoop(gate, 100);
      log.push("result " + (await result));
    },
  ],
  [
    "the sixth function returns a promise, the third a thenable",
    async () => {
      const gate = deferred();
      const result = inContext("the starter", () =>
        leavesWith(1, gate.promise, (depth, value) => {
          if (depth === 6) return Promise.resolve(value);
          if (depth !== 3) return value;
          return {
            then(resolve: (value: number) => void) {
              log.push("  then() of the thenable" + context());
              resolve(value);
            },
          };
        }),
      );
      setImmediate(() => {
        settle(gate, 100);
        countTurns(16);
      });
      log.push("result " + (await result));
    },
  ],
  [
    "the fifth function returns a promise that is settled later",
    async () => {
      const gate = deferred(), late = deferred();
      const result = inContext("the starter", () => leavesWith(1, gate.promise, (depth, value) => (depth === 5 ? late.promise : value)));
      settleFromTheEventLoop(gate, 100);
      await turnOfTheEventLoop();
      await turnOfTheEventLoop();
      log.push("  the late promise is settled");
      settleFromTheEventLoop(late, 500);
      log.push("result " + (await result));
    },
  ],
  [
    "every function awaits a second promise before it returns",
    async () => {
      const first = deferred(), second = deferred();
      const result = inContext("the starter", () => awaitsTwice(1, first.promise, second.promise));
      settleFromTheEventLoop(first, 100);
      await turnOfTheEventLoop();
      await turnOfTheEventLoop();
      log.push("  the second promise is settled");
      settleFromTheEventLoop(second, 1);
      log.push("result " + (await result));
    },
  ],
  [
    "every function awaits a second promise before it returns, beside a chain of reactions",
    async () => {
      const first = deferred(), second = deferred();
      const result = inContext("the starter", () => awaitsTwice(1, first.promise, second.promise));
      settleFromTheEventLoop(first, 100);
      await turnOfTheEventLoop();
      await turnOfTheEventLoop();
      setImmediate(() => {
        settle(second, 1);
        countTurns(20);
      });
      log.push("result " + (await result));
    },
  ],
];

async function runAll(): Promise<void> {
  for (const [title, body] of scenarios) {
    log.push("-- " + title);
    await body();
    await turnOfTheEventLoop();
    await turnOfTheEventLoop();
  }
}

await runAll();

