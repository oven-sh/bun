  h = fold(h, b17, d18, s19, i20, e21, t22, g23, l24, z25, w26, r27, p28, k29, a30, y31, c32, x33);
  h = ofBox(h, b34); h = ofNumber(h, d35); h = ofText(h, s36); h = ofNumber(h, i37); h = ofEither(h, e38); h = ofFlag(h, t39);
  return h;
}

