//// for-await-over-arrays.ts
// `for await` over arrays: as they are made, and in every way an array can stop iterating the way it was made.
const log: string[] = [];
function note(...parts: unknown[]): void {
    log.push(parts.map(part => String(part)).join(" "));
}

async function over(label: string, values: Iterable<unknown> | AsyncIterable<unknown>, leavesAt = -1): Promise<void> {
    let seen = 0;
    try {
        for await (const value of values) {
            note(label, "sees", value);
            if (seen++ === leavesAt) {
                note(label, "breaks");
                break;
            }
        }
        note(label, "ends");
    } catch (error) {
        note(label, "caught", error instanceof Error ? error.message : error);
    }
}

async function ticks(label: string, count: number): Promise<void> {
    for (let i = 0; i < count; i++) {
        await null;
        note(label, i);
    }
}

class Listing extends Array<number> {
    *[Symbol.iterator](): ArrayIterator<number> {
        note("Listing is asked for its iterator");
        for (let i = this.length; i-- > 0;)
            yield this[i];
    }
}

async function main(): Promise<void> {
    await over("empty", []);
    await over("numbers", [1, 2, 3]);
    await over("mixed", [1, "two", null, undefined, { toString: () => "five" }]);
    await over("promises", [Promise.resolve("a"), "b", Promise.resolve("c")]);
    await over("holes", [1, , 3]);
    await over("left early", [1, 2, 3, 4], 1);
    await over("rejected", [1, Promise.reject(new Error("no")), 3]);
    await over("thenable", [{ then(resolve: (value: string) => void) { note("then is called"); resolve("from then"); } }, "after"]);

    const growing = [1, 2];
    let grown = 0;
    for await (const value of growing) {
        note("growing sees", value);
        if (grown++ < 3)
            growing.push(value + 10);
    }
    const shrinking = [1, 2, 3, 4];
    for await (const value of shrinking) {
        note("shrinking sees", value);
        shrinking.pop();
    }

    const withAsync = [1, 2] as number[] & { [Symbol.asyncIterator]?: () => AsyncIterator<string> };
    withAsync[Symbol.asyncIterator] = async function* () {
        note("its own async iterator is asked for");
        yield "own async";
    };
    await over("own Symbol.asyncIterator", withAsync);

    const withSync = [1, 2];
    withSync[Symbol.iterator] = function* () {
        note("its own iterator is asked for");
        yield 7;
    } as any;
    await over("own Symbol.iterator", withSync);

    const withNull = [5, 6] as number[] & { [Symbol.asyncIterator]?: null };
    withNull[Symbol.asyncIterator] = null;
    await over("Symbol.asyncIterator is null", withNull);

    const named = [8, 9] as number[] & { name?: string };
    named.name = "has a property";
    await over("with a property", named);

    await over("subclass", Listing.from([1, 2, 3]));
    await over("frozen", Object.freeze([1, 2]));
    await over("doubles", [0.5, 1.5, -0]);
    await over("array iterator", [1, 2, 3].values());
    await over("entries", ["a", "b"].entries());
    await over("Set", new Set([1, 1, 2]));
    await over("Map", new Map([["k", 1]]));
    await over("string", "hé!");

    const inherits = Object.setPrototypeOf([1, 2], { [Symbol.iterator]: function* () { yield "from another prototype"; } }) as number[];
    await over("another prototype", inherits);

    await Promise.all([over("left", [1, 2, 3]), ticks("tick", 12), over("right", ["x", Promise.resolve("y")])]);

    let sum = 0;
    for (let round = 0; round < 200; round++) {
        for await (const value of [round, round + 1, round + 2])
            sum += value;
    }
    note("sum", sum);
    console.log(log.join("\n"));
}

main();
//// for-await-over-sync-iterables.ts
// `for await` over sync iterables of every kind, alone and beside other jobs: the order of everything that happens.
let seed = 4242;
////= random	below

let log: string[] = [];
////= note
function messageOf(error: unknown): string {
    return error instanceof Error ? error.message : String(error);
}

class Thenable implements PromiseLike<number> {
    constructor(private label: string, private value: number) {}
    then<A = number, B = never>(onFulfilled?: ((value: number) => A | PromiseLike<A>) | null): PromiseLike<A | B> {
        note(this.label + " then is called");
        onFulfilled?.(this.value);
        return new Promise<A | B>(() => {});
    }
}

let release: (() => void)[] = [];
function later(value: number): Promise<number> {
    return new Promise(resolve => { release.push(() => resolve(value)); });
}

type Item = number | Promise<number> | Thenable;

function* generated(label: string, kind: number, count: number): Generator<Item, string, unknown> {
    try {
        for (let i = 0; i < count; i++) {
            note(label + " makes " + i);
            switch ((kind + i) % 7) {
            case 0:
                yield i;
                break;
            case 1:
                yield Promise.resolve(i);
                break;
            case 2:
                Promise.resolve().then(() => note(label + " job queued while making " + i));
                yield i;
                break;
            case 3:
                yield later(i);
                break;
            case 4:
                yield new Thenable(label, i);
                break;
            case 5:
                if (kind === 5)
                    yield Promise.reject(new Error(label + " rejects " + i));
                else
                    yield i;
                break;
            default:
                if (kind === 6)
                    throw new Error(label + " throws at " + i);
                yield i;
            }
        }
        return "returned";
    } finally {
        note(label + " is closed");
    }
}

class Counter implements Iterable<Item> {
    constructor(private label: string, private count: number) {}
    [Symbol.iterator](): Iterator<Item> {
        note(this.label + " is asked for its iterator");
        let i = 0;
        const label = this.label;
        const count = this.count;
        return {
            next(): IteratorResult<Item> {
                note(label + " next " + i);
                return i < count ? { done: false, value: i++ } : { done: true, value: undefined };
            },
            return(): IteratorResult<Item> {
                note(label + " return");
                return { done: true, value: undefined };
            },
        };
    }
}

function iterableOf(label: string, kind: number, count: number): Iterable<Item> {
    switch (kind) {
    case 7:
        return new Counter(label, count);
    case 8:
        return new Set([1, 2, 3].slice(0, count));
    case 9:
        return new Map([[1, 1], [2, 2]]).keys();
    case 10:
        return [1, Promise.resolve(2), 3, later(4)].slice(0, count);
    case 11:
        return [5, 6, 7].slice(0, count).values();
    default:
        return generated(label, kind, count);
    }
}

async function inFunction(label: string, kind: number, count: number, leavesAt: number, startsLate: boolean): Promise<void> {
    if (startsLate)
        await null;
    let seen = 0;
    try {
        for await (const value of iterableOf(label, kind, count)) {
            note(label + " sees " + value);
            if (seen++ === leavesAt) {
                note(label + " breaks");
                break;
            }
        }
        note(label + " ends");
    } catch (error) {
        note(label + " caught " + messageOf(error));
    }
}

async function* inGenerator(label: string, kind: number, count: number): AsyncGenerator<number> {
    try {
        for await (const value of iterableOf(label, kind, count)) {
            note(label + " passes on " + value);
            yield value;
        }
    } catch (error) {
        note(label + " caught " + messageOf(error));
    }
}

async function throughGenerator(label: string, kind: number, count: number): Promise<void> {
    await null;
    for await (const value of inGenerator(label, kind, count))
        note(label + " gets " + value);
    note(label + " ends");
}

////= ticker-2

////= sumOf

function pump(done: () => boolean, finish: () => void): void {
    const waiting = release;
    release = [];
    for (const resolve of waiting)
        resolve();
    if (done())
        finish();
    else
        setTimeout(() => pump(done, finish), 0);
}

async function round(number: number, prints: boolean): Promise<void> {
    log = [];
    const work: Promise<void>[] = [];
    const loops = 1 + random(3);
    for (let i = 0; i < loops; i++) {
        const label = "l" + i;
        const kind = random(12);
        const count = random(5);
        if (random(3))
            work.push(inFunction(label, kind, count, random(4) ? -1 : random(3), !!random(2)));
        else
            work.push(throughGenerator(label, kind, count));
    }
    if (!random(3))
        work.push(ticker("t", 1 + random(8)));
    let finished = false;
    Promise.all(work).then(() => { finished = true; });
    await new Promise<void>(resolve => pump(() => finished, resolve));
    console.log(number, log.length, sumOf(log));
    if (prints)
        console.log(log.join("\n"));
}

async function main(): Promise<void> {
    for (let i = 0; i < 300; i++)
        await round(i, i % 100 === 7);
}

main();
