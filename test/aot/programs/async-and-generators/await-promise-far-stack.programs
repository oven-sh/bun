async function «1»(rounds: number): Promise<number> {
  await settled;
  let sum = 0;
  for (let i = 0; i < rounds; i++) sum += (await «2»(i)).y;
  return sum;
}
////: lines-13
async function «1»(gate: Promise<number>, collects: boolean): Promise<number> {
  return (await «2»(gate, collects)) + 1;
}
