{
  let total = 0;
  for (const value of each(new Range(0, 60000))) total += value as number;
  const texts = await gather(from((() => { let n = 0; return () => ({ value: `item ${n}`, done: n++ >= 30000 }); })()), 1e9);
  say("many", total, texts.length, texts[29999]);
}
