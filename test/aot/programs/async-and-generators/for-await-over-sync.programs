//// functions-that-read-their-arguments-from-the-stack-suspend-and-their-callers-go-on.js
const pending = () => new Promise(resolve => queueMicrotask(() => resolve(1)));

async function restAsync(...rest) {
    const first = await pending();
    const second = await pending();
    return rest.length + first + second;
}
async function argumentsAsync() {
    const count = arguments.length;
    return count + (await pending()) + arguments.length;
}
const arrowAsync = async (...rest) => {
    await pending();
    return rest.reduce((sum, value) => sum + value, 0);
};
function* restGenerator(...rest) {
    for (const value of rest) yield value;
}
function* argumentsGenerator() {
    for (let i = 0; i < arguments.length; i++) yield arguments[i];
}
async function* restAsyncGenerator(...rest) {
    for (const value of rest) {
        await pending();
        yield value;
    }
}
class Holder {
    async method(...rest) {
        await pending();
        return rest.length;
    }
    static async fixed() {
        await pending();
        return arguments.length;
    }
}

const table = { restAsync, argumentsAsync, arrowAsync, restGenerator, argumentsGenerator, restAsyncGenerator, method: new Holder().method, fixed: Holder.fixed };

function callByName(name, a, b, c, d, e, f) {
    const before = [a, b, c, d, e, f].join();
    const result = table[name](a, b, c, d, e, f);
    if (before !== [a, b, c, d, e, f].join()) throw new Error("the caller's values moved: " + name);
    return result;
}

function below(depth, name) {
    const x = depth * 3;
    const y = depth + 7;
    const result = depth ? below(depth - 1, name) : callByName(name, 1, 2, 3, 4, 5, 6);
    if (x !== depth * 3 || y !== depth + 7) throw new Error("a caller's value moved: " + name);
    return result;
}

async function total(value) {
    if (value[Symbol.asyncIterator]) {
        let sum = 0;
        for await (const part of value) sum += part;
        return sum;
    }
    if (value[Symbol.iterator]) {
        let sum = 0;
        for (const part of value) sum += part;
        return sum;
    }
    return await value;
}

const sums = {};
for (let round = 0; round < 200; round++) {
    for (const name of Object.keys(table)) {
        sums[name] = (sums[name] ?? 0) + (await total(below(round % 5, name))) + (await total(Reflect.apply(table[name], undefined, [1, 2, 3, 4, 5, 6, 7])));
    }
}
console.log(JSON.stringify(sums, null, 1));
//// generator-closures-own-prototypes.js
const closureCount = 300;
const makeGenerator = base => function* () { yield base };
const makeAsyncGenerator = base => async function* () { yield base };

function createInTurn(make) {
  const closures = [], objects = [];
  for (let i = 0; i < closureCount; i++) {
    const closure = make(i);
    closures.push(closure);
    objects.push(closure());
    if (i % 50 === 49) Bun.gc(true);
  }
  return { closures, objects };
}

function countMismatches({ closures, objects }) {
  let mismatches = 0;
  for (let i = 0; i < closureCount; i++) {
    const closure = closures[i], other = closures[(i + 1) % closureCount];
    if (Object.getPrototypeOf(objects[i]) !== closure.prototype) mismatches++;
    if (!(objects[i] instanceof closure)) mismatches++;
    if (objects[i] instanceof other) mismatches++;
    if (objects[(i + 1) % closureCount] instanceof closure) mismatches++;
  }
  return mismatches;
}

const generators = createInTurn(makeGenerator);
console.log("first objects:", countMismatches(generators));
console.log("distinct prototypes:", new Set(generators.closures.map(closure => closure.prototype)).size);
console.log("values:", generators.objects.reduce((sum, object) => sum + object.next().value, 0));

Bun.gc(true);
const secondObjects = generators.closures.map(closure => closure());
console.log("second objects:", countMismatches({ closures: generators.closures, objects: secondObjects }));

generators.closures.forEach((closure, i) => { closure.prototype.tag = i });
Bun.gc(true);
console.log("own tags:", generators.closures.every((closure, i) => closure().tag === i));

const asyncGenerators = createInTurn(makeAsyncGenerator);
console.log("async objects:", countMismatches(asyncGenerators));
console.log("async value:", (await asyncGenerators.objects[closureCount - 1].next()).value);

function* topLevel() { yield "top" }
const generatorPrototype = Object.getPrototypeOf(topLevel.prototype);
const original = topLevel.prototype;
const before = [topLevel(), topLevel(), topLevel()];
console.log("before replacement:", before.every(object => Object.getPrototypeOf(object) === original));

const replacement = Object.create(generatorPrototype);
replacement.label = "replacement";
topLevel.prototype = replacement;
const replaced = topLevel();
console.log("replaced prototype:", Object.getPrototypeOf(replaced) === replacement, replaced.label, replaced.next().value);
console.log("instanceof after replacement:", replaced instanceof topLevel, before[0] instanceof topLevel);
console.log("earlier object:", Object.getPrototypeOf(before[0]) === original, before[0].label, before[0].next().value);
console.log("spread under replacement:", [...topLevel()].join());

topLevel.prototype = 1;
const fallback = topLevel();
console.log("primitive prototype:", Object.getPrototypeOf(fallback) === generatorPrototype, fallback.next().value);

topLevel.prototype = original;
const restored = topLevel();
console.log("restored prototype:", Object.getPrototypeOf(restored) === original, restored instanceof topLevel, replaced instanceof topLevel);
Bun.gc(true);
console.log("after collection:", Object.getPrototypeOf(topLevel()) === original);
//// generator-creation.ts
// what a freshly made generator is, for every kind of generator function, the first time and every later time
const lines: string[] = [];
////= say
////= lines-23	declared	"end"
const expression = function* (n: number): Generator<number, void, unknown> {
  yield n;
};
class Holder {
  constructor(readonly base: number) {}
  *method(n: number): Generator<number, void, unknown> {
    yield this.base + n;
  }
  static *fixed(n: number): Generator<number, void, unknown> {
    yield n * 2;
  }
  *[Symbol.iterator](): Generator<number, void, unknown> {
    yield this.base;
  }
}
const literal = {
  *member(n: number): Generator<number, void, unknown> {
    yield n + 1;
  },
};
function makes(offset: number) {
  return function* inner(n: number): Generator<number, void, unknown> {
    yield n + offset;
  };
}
const holder = new Holder(10);
const first = makes(100);
const second = makes(200);
const makers: [string, Function, () => Generator<number, unknown, unknown>][] = [
  ["declared", declared, () => declared(2)],
  ["expression", expression, () => expression(2)],
  ["method", holder.method, () => holder.method(2)],
  ["static method", Holder.fixed, () => Holder.fixed(2)],
  ["Symbol.iterator", holder[Symbol.iterator], () => holder[Symbol.iterator]()],
  ["member of a literal", literal.member, () => literal.member(2)],
  ["closure", first, () => first(2)],
  ["another closure of the same function", second, () => second(2)],
];
const generatorPrototype = Object.getPrototypeOf(Object.getPrototypeOf(declared(0)));
for (let round = 0; round < 3; round++) {
  for (const [title, maker, make] of makers) {
    const a = make();
    const b = make();
    say(
      round,
      title,
      Object.getPrototypeOf(a) === maker.prototype,
      Object.getPrototypeOf(a) === Object.getPrototypeOf(b),
      Object.getPrototypeOf(Object.getPrototypeOf(a)) === generatorPrototype,
      a instanceof (maker as any),
      Object.prototype.toString.call(a),
      Object.getOwnPropertyNames(a).length,
      Object.isExtensible(a),
      a === (a[Symbol.iterator]() as unknown),
      a.next(),
      b.next(),
      a.next(),
    );
  }
}
say("closures of one function have their own prototypes", first.prototype === second.prototype, Object.getPrototypeOf(first(0)) === Object.getPrototypeOf(second(0)));
{
  const generator = declared(1);
  (generator as any).note = "kept";
  (generator as any)[3] = "element";
  say("a generator takes properties", Object.keys(generator), declared(1).hasOwnProperty("note"));
}
{
