function* guarded(log: string[]): Generator<string, string, unknown> {
  try {
    const got = yield "in try";
    log.push(`got ${got}`);
    yield "still in try";
    return "ended by itself";
  } catch (error) {
    log.push(`caught ${error}`);
    yield "after catch";
    return "ended after catch";
  } finally {
    log.push("finally");
    yield "from finally";
  }
}
function returnsEarly(iterator: Generator<string, string, unknown>): unknown[] {
  const seen: unknown[] = [iterator.next().value];
  const returned = iterator.return("asked to return");
  seen.push(returned.done, returned.value);
  const after = iterator.next();
  seen.push(after.done, after.value, iterator.next().done);
  return seen;
}
function throwsIn(iterator: Generator<string, string, unknown>): unknown[] {
  const seen: unknown[] = [iterator.next().value];
  const thrown = iterator.throw("thrown in");
  seen.push(thrown.done, thrown.value);
  for (;;) {
    const step = iterator.next();
    seen.push(step.value);
    if (step.done) return seen;
  }
}
{
  const log: string[] = [];
  say("return()", returnsEarly(guarded(log)), log);
  log.length = 0;
  say("throw()", throwsIn(guarded(log)), log);
}
function returnsBeforeTheStart(iterator: Program): unknown[] {
  const returned = iterator.return(9);
  return [returned.done, returned.value, iterator.next(0).done];
}
function throwsBeforeTheStart(iterator: Program): unknown {
  return iterator.throw(new Mine("before the start")).done;
}
say("return() before the start", returnsBeforeTheStart(tasks(2)));
{
  const iterator = tasks(2);
  attempt("throw() before the start", () => throwsBeforeTheStart(iterator));
  say("then", isOverAtOnce(iterator));
}

function* throwsAt(n: number): Program {
  for (let i = 0; i < n; i++) yield new Task(i);
  throw new Mine(`the body threw after ${n}`);
}
{
  const iterator = throwsAt(2);
  attempt("the body throws", () => drive(iterator));
  say("it is completed", isOverAtOnce(iterator), valueOfCompleted(iterator));
  function catches(generator: Program): string {
    try {
      for (;;) {
        const step = generator.next(0);
        if (step.done) return "ended";
      }
    } catch (error) {
      return `caught in the caller: ${(error as Error).message}; then done is ${generator.next(0).done}`;
    } finally {
      lines.push("the caller's finally ran");
    }
  }
  say(catches(throwsAt(1)));
}
{
  let self: Program;
  function* resumesItself(): Program {
    yield new Task(1);
    const step = self.next(0);
    return step.done ? 1 : 0;
  }
  self = resumesItself();
  say("first", firstValue(self));
  attempt("a generator that resumes itself", () => drive(self));
  say("then", isOverAtOnce(self));
}
{
  function* stackOf(): Generator<string, void, unknown> {
    yield (new Error("inside").stack ?? "").split("\n").length > 1 ? "has a stack" : "no stack";
  }
  function first(iterator: Generator<string, void, unknown>) {
    return iterator.next().value;
  }
  say("an error made in the body", first(stackOf()));
}
{
  function* deep(n: number): Generator<number, number, unknown> {
    if (!n) return 0;
    const inner = deep(n - 1);
    const step = inner.next();
    yield n;
    return step.done ? step.value + 1 : -1;
  }
  function last(iterator: Generator<number, number, unknown>): number {
    for (;;) {
      const step = iterator.next();
      if (step.done) return step.value;
    }
  }
  say("generators that step generators", last(deep(50)));
  function* endless(): Generator<number, number, unknown> {
    return endless().next().value as number;
  }
  attempt("without end", () => {
    try {
      return last(endless());
    } catch (error) {
      return error instanceof RangeError ? "RangeError" : String(error);
    }
  });
}
{
  let total = 0;
  for (let round = 0; round < 300; round++) total += drive(tasks(100));
  say("many steps", total);
}

console.log(lines.join("\n"));
//// generator-methods-on-escaped-generators.ts
// next(), return() and throw() on generators whose creation the caller cannot see.
const shelf: unknown[] = []
function hide<T>(value: T): T {
  shelf.push(value)
  return shelf[shelf.length - 1] as T
}
function show(label: string, action: () => unknown) {
  try {
    console.log(label, JSON.stringify(action()))
  } catch (error) {
    console.log(label, 'threw', error instanceof Error ? `${error.name}: ${error.message}` : String(error))
  }
}

function* count(from: number, to: number): Generator<number, string, number | undefined> {
  let total = 0
  for (let n = from; n < to; n++) total += (yield n) ?? 0
  return `sent ${total}`
}

const counted = hide(count(1, 4))
show('first', () => counted.next(100))
show('second', () => counted.next(10))
show('third', () => counted.next(20))
show('last', () => counted.next(30))
show('after the end', () => counted.next(40))
show('return after the end', () => counted.return('late'))
show('throw after the end', () => counted.throw(new RangeError('late')))

const shaped = hide(count(0, 2))
const one = shaped.next()
const two = shaped.next()
console.log(one === two, Object.keys(one).join(), Object.getPrototypeOf(one) === Object.prototype, JSON.stringify(Object.getOwnPropertyDescriptors(one)))
console.log(shaped[Symbol.iterator]() === shaped, Object.prototype.toString.call(shaped), typeof shaped.next, shaped.next.name, shaped.next.length, shaped.return.name, shaped.throw.name)
console.log(shaped.next === hide(count(0, 1)).next, Object.hasOwn(shaped, 'next'), String(shaped.next).includes('[native code]'))

function* failing(): Generator<number, void, void> {
  yield 1
  throw new TypeError('inside')
}
const failed = hide(failing())
show('before the failure', () => failed.next())
show('the failure', () => failed.next())
show('after the failure', () => failed.next())
show('return after the failure', () => failed.return())

let reentrant: Generator<string, string, void>
function* entersItself(): Generator<string, string, void> {
  let message = ''
  try {
    reentrant.next()
  } catch (error) {
    message = `${(error as Error).name}: ${(error as Error).message}`
  }
  yield message
  try {
    reentrant.return('x')
  } catch (error) {
    message = `${(error as Error).name}`
  }
  yield message
  try {
    reentrant.throw(1)
  } catch (error) {
    message = `${(error as Error).name}`
  }
  return message
}
reentrant = hide(entersItself())
show('enters itself by next', () => reentrant.next())
show('enters itself by return', () => reentrant.next())
show('enters itself by throw', () => reentrant.next())
show('and is done', () => reentrant.next())

const log: string[] = []
function* guarded(kind: string): Generator<string, string, string | undefined> {
  try {
    log.push('try')
    const sent = yield 'in try'
    log.push(`sent ${sent}`)
    return 'end of try'
  } catch (error) {
    log.push(`caught ${error}`)
    if (kind === 'rethrows') throw `again ${error}`
    yield 'in catch'
    return 'end of catch'
  } finally {
    log.push('finally')
    if (kind === 'yields in finally') yield 'in finally'
    if (kind === 'throws in finally') throw new Error('from finally')
    if (kind === 'returns in finally') return 'from finally'
  }
}
for (const kind of ['plain', 'yields in finally', 'throws in finally', 'returns in finally', 'rethrows']) {
  for (const method of ['return', 'throw'] as const) {
    const early = hide(guarded(kind))
    show(`${kind}: ${method} before the start`, () => early[method]('early'))
    show(`${kind}: next after that`, () => early.next())
    const started = hide(guarded(kind))
    started.next()
    show(`${kind}: ${method} at the yield`, () => started[method]('now'))
    show(`${kind}: next after that`, () => started.next('more'))
    show(`${kind}: and again`, () => started.next('more'))
  }
}
console.log(log.join(' | '))

const { next, return: finish, throw: raise } = Object.getPrototypeOf(Object.getPrototypeOf(hide(count(0, 1)))) as Generator<number, string, number>
const borrowed = hide(count(5, 7))
show('a borrowed next', () => next.call(borrowed, 1))
show('a borrowed next by apply', () => Reflect.apply(next, borrowed, []))
show('a borrowed return', () => finish.call(borrowed, 'stop'))
for (const receiver of [undefined, null, 1, 'text', {}, [], () => 1, Object.create(borrowed), (async function* () {})(), [][Symbol.iterator]()]) {
  show(`next on ${Object.prototype.toString.call(receiver)}`, () => next.call(receiver as any))
  show(`return on ${Object.prototype.toString.call(receiver)}`, () => finish.call(receiver as any, 'x'))
  show(`throw on ${Object.prototype.toString.call(receiver)}`, () => raise.call(receiver as any, 'x'))
}

class Tree {
  readonly value: number
  readonly children: Tree[]
  constructor(value: number, children: Tree[] = []) {
    this.value = value
    this.children = children
  }
  *walk(): Generator<number, number, void> {
    let seen = 1
    yield this.value
    for (const child of this.children) seen += yield* hide(child.walk())
    return seen
  }
}
const tree = new Tree(1, [new Tree(2, [new Tree(3), new Tree(4)]), new Tree(5)])
const walk = hide(tree.walk())
const visited: number[] = []
for (let step = walk.next(); ; step = walk.next()) {
  if (step.done) {
    console.log(visited.join(), step.value)
    break
  }
  visited.push(step.value)
}
console.log([...hide(tree.walk())].join(), Array.from(hide(tree.walk()), (n) => n * 2).join(), Math.max(...hide(tree.walk())))
const [head, , third, ...others] = hide(tree.walk())
console.log(head, third, others.join())

function* outer(inner: Generator<string, string, string | undefined>): Generator<string, string, string | undefined> {
  const result = yield* inner
  return `outer got ${result}`
}
for (const method of ['next', 'return', 'throw'] as const) {
  const delegating = hide(outer(hide(guarded('yields in finally'))))
  show(`delegating: start`, () => delegating.next())
  show(`delegating: ${method}`, () => delegating[method]('through'))
  show(`delegating: next`, () => delegating.next('after'))
  show(`delegating: next`, () => delegating.next('after'))
}

function* nested(depth: number): Generator<number, number, void> {
  if (depth === 0) return 0
  const inner = hide(nested(depth - 1))
  let step = inner.next()
  while (!step.done) {
    yield step.value
    step = inner.next()
  }
  yield depth
  return step.value + 1
}
shelf.length = 0
let sum = 0
const deep = hide(nested(200))
for (let step = deep.next(); ; step = deep.next()) {
  if (step.done) {
    console.log(sum, step.value)
    break
  }
  sum += step.value
}

function* allocating(rounds: number): Generator<{ id: number; text: string }, number, { id: number } | undefined> {
  let kept = 0
  for (let id = 0; id < rounds; id++) {
    const sent = yield { id, text: `record ${id}` }
    kept += sent ? sent.id : 0
  }
  return kept
}
shelf.length = 0
const records = hide(allocating(20000))
let checksum = 0
for (let step = records.next(); !step.done; step = records.next({ id: step.value.id })) checksum += step.value.text.length + step.value.id
console.log(checksum, JSON.stringify(records.next()))

const tagged = hide(count(0, 3)) as Generator<number, string, number | undefined> & { tag?: string }
tagged.tag = 'mine'
show('with an own property', () => [tagged.next(), tagged.tag, Object.keys(tagged)])
const shadowed = hide(count(0, 3)) as Generator<number, string, number | undefined>
Object.defineProperty(shadowed, 'next', { value: () => ({ value: -1, done: false }) })
show('with an own next', () => [shadowed.next(), next.call(shadowed, 0)])
let turns = 0
for (const value of shadowed) {
  if (++turns > 2) break
  console.log('for of sees', value)
}
//// generator-methods-that-are-replaced-shadowed-overridden-or-removed.js
// generator methods read without a lookup: every way the method behind a name can change
const out = [];
function say(...a) { out.push(a.join(" ")); }
class Range {
  constructor(n) { this.n = n; }
  *items() { for (let i = 0; i < this.n; i++) yield i; }
  *pairs(k) { for (let i = 0; i < this.n; i++) yield i * k; }
  static *upTo(n) { for (let i = 0; i < n; i++) yield i + 100; }
  sum() { let s = 0; for (const v of this.items()) s += v; return s; }
  sumPairs(k) { let s = 0; for (const v of this.pairs(k)) s += v; return s; }
}
class Evens extends Range {
  *items() { for (let i = 0; i < this.n; i++) yield i * 2; }
}
class Super extends Range {
  *items() { yield -1; yield* super.items(); }
}
function total(r) { let s = 0; for (const v of r.items()) s += v; return s; }
function warm(r) { let s = 0; for (let i = 0; i < 300; i++) s += total(r) + r.sum() + r.sumPairs(3); return s; }
const a = new Range(4), b = new Evens(4), c = new Super(3);
say("warm", warm(a), warm(b), warm(c));
say("identity", a.items === Range.prototype.items, b.items === Evens.prototype.items, b.items === a.items, a.items.name, a.items.length, a.pairs.length);
Range.prototype.items.tag = "tagged";
say("tag", a.items.tag, c.items.tag, Object.getPrototypeOf(Super.prototype).items.tag);
// an own property shadows
const shadow = new Range(4);
say("before shadow", total(shadow), shadow.sum());
shadow.items = function* () { yield 1000; };
say("shadow", total(shadow), shadow.sum(), total(a));
delete shadow.items;
say("shadow gone", total(shadow), shadow.sum());
// the generator's own prototype object is replaced
const kept = Range.prototype.items.prototype;
Range.prototype.items.prototype = { next() { return { done: true, value: undefined }; }, [Symbol.iterator]() { return this; } };
say("prototype of the generators replaced", total(a), a.sum(), total(c));
Range.prototype.items.prototype = kept;
say("and back", total(a), a.sum(), total(c));
kept.extra = 7;
say("extra", a.items().extra, b.items().extra);
// the prototype of one object changes
const moved = new Range(4);
say("moved before", total(moved));
Object.setPrototypeOf(moved, Evens.prototype);
say("moved", total(moved), moved.sum());
Object.setPrototypeOf(moved, { *items() { yield 5; yield 6; } });
say("moved again", total(moved));
// the method is replaced on the prototype
const old = Range.prototype.items;
Range.prototype.items = function* () { yield 42; };
say("replaced", total(a), a.sum(), total(b), total(c), a.items === old);
Range.prototype.items = function () { return [7, 8][Symbol.iterator](); };
say("replaced by a plain function", total(a), a.sum(), total(c));
Object.defineProperty(Range.prototype, "items", { get() { return function* () { yield 9; yield 9; }; }, configurable: true });
say("replaced by a getter", total(a), a.sum(), total(c));
delete Range.prototype.items;
try { say("deleted", total(a)); } catch (e) { say("deleted", e.constructor.name); }
Range.prototype.items = old;
say("restored", total(a), a.sum(), total(b), total(c));
// another this
say("call", [...old.call({ n: 2 })].join(), [...Evens.prototype.items.call(a)].join(), [...Range.upTo(2)].join(), [...Range.upTo.call(null, 3)].join());
Range.upTo = function* () { yield "static replaced"; };
say("static", [...Range.upTo(2)].join(), [...Evens.upTo(2)].join());
// a class evaluated many times
function make(k) { return class { *items() { yield k; yield k + 1; } }; }
const classes = []; for (let i = 0; i < 50; i++) classes.push(make(i));
let s = 0; for (let r = 0; r < 50; r++) for (const K of classes) s += total(new K());
say("many classes", s, classes[0].prototype.items === classes[1].prototype.items);
// the parent of a prototype changes
Object.setPrototypeOf(Evens.prototype, { *pairs(k) { yield k; }, n: 1 });
say("parent changed", b.sumPairs ? "has" : "none", [...b.pairs(5)].join(), total(b));
// generator objects are distinct, can be stepped by hand, returned, thrown into
const g1 = a.items(), g2 = a.items();
say("by hand", g1 === g2, g1.next().value, g1.next().value, g2.next().value, JSON.stringify(g1.return(9)), JSON.stringify(g1.next()));
try { g2.throw(new Error("thrown in")); } catch (e) { say("throw", e.message, JSON.stringify(g2.next())); }
say("toString", Object.prototype.toString.call(a.items()), typeof a.items, a.items.constructor.name, Object.getPrototypeOf(a.items()) === a.items.prototype);
try { new a.items(); } catch (e) { say("new", e.constructor.name); }
console.log(out.join("\n"));
