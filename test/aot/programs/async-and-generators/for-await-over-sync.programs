}
{
  const [a, b, c] = new Range(5, 7);
  const [first, ...rest] = new Range(1, 5);
  say("patterns", a, b, c === undefined, first, rest);
}

for (const [title, done] of [
  ["0", 0],
  ["an empty string", ""],
  ["null", null],
  ["undefined", undefined],
  ["NaN", NaN],
  ["1", 1],
  ["a string", "x"],
  ["an object", {}],
  ["0n", 0n],
] as [string, unknown][]) {
  let count = 0;
  say("done is", title, collect(from(() => (count++ < 2 ? { value: count, done } : { value: -1, done: true }))).length);
}
{
