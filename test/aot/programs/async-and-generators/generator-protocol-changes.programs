//// iteration-protocol.ts
// `for..of` and everything of the iterator protocol that a program can observe.
declare const console: { log(...v: unknown[]): void };
let log: string[] = []; const say = (s: string): void => { log.push(s); }; const flush = (title: string): void => { console.log(title + ": " + log.join(" ")); log = []; };
const kind = (e: unknown): string => (e as Error).constructor.name + ((e as Error).message.length < 12 ? "(" + (e as Error).message + ")" : "");
// The result is an object of a class with accessors: the order of the reads shows.
class Res { constructor(public v: number, public d: boolean, public bad: string) {} get done(): boolean { say("done"); if (this.bad === "done") throw new Error("done!"); return this.d; } get value(): number { say("value"); if (this.bad === "value") throw new Error("value!"); return this.v; } }
class Steps { i = 0; constructor(public n: number, public bad: string, public closing: string) {}
  next(): Res { say("next"); if (this.bad === "next" && this.i === 1) throw new Error("next!"); const at = this.i++; return new Res(at, at >= this.n, at === 1 ? this.bad : ""); }
  return(): { value: number, done: boolean } { say("return"); if (this.closing === "throws") throw new Error("return!"); if (this.closing === "no object") return 5 as any; return { value: 0, done: true }; } }
class Range { constructor(public n: number, public bad = "", public closing = "") {} [Symbol.iterator](): Steps { say("open"); return new Steps(this.n, this.bad, this.closing); } }
function whole(r: Range): number { let s = 0; for (const x of r) { say("body" + x); s += x; } return s; }
function broken(r: Range): number { let s = 0; for (const x of r) { say("body" + x); if (x === 1) break; s += x; } return s; }
function returned(r: Range): number { for (const x of r) { say("body" + x); if (x === 1) return 100 + x; } return -1; }
function thrown(r: Range): number { for (const x of r) { say("body" + x); if (x === 1) throw new Error("body!"); } return -1; }
function outer(r: Range, q: Range): number { let s = 0; again: for (const y of q) { for (const x of r) { say("body" + y + x); if (x === 1) continue again; s += x + y; } } return s; }
const attempt = (f: () => number): void => { try { say("=" + f()); } catch (e) { say("!" + kind(e)); } };
attempt(() => whole(new Range(2))); flush("whole");
attempt(() => whole(new Range(0))); flush("empty");
attempt(() => broken(new Range(3))); flush("break");
attempt(() => returned(new Range(3))); flush("return");
attempt(() => thrown(new Range(3))); flush("throw");
attempt(() => outer(new Range(3), new Range(2))); flush("continue outer");
for (const bad of ["next", "done", "value"]) { attempt(() => whole(new Range(3, bad))); flush(bad + " throws"); }
attempt(() => broken(new Range(3, "", "throws"))); flush("break, return throws");
attempt(() => thrown(new Range(3, "", "throws"))); flush("throw, return throws");
attempt(() => broken(new Range(3, "", "no object"))); flush("break, return yields no object");
attempt(() => thrown(new Range(3, "", "no object"))); flush("throw, return yields no object");
// No `return` method; `done` left out; an iterator that is its own iterable; a subclass that overrides; a union of two classes.
class Plain { i = 0; constructor(public n: number) {} next(): { value: number, done?: boolean } { if (this.i < this.n) return { value: this.i++ }; return { value: -1, done: true }; } [Symbol.iterator](): Plain { return this; } }
class Twice extends Plain { next(): { value: number, done?: boolean } { const r = super.next(); if (r.done) return r; return { value: r.value * 2 }; } }
function sum(p: Plain): number { let s = 0; for (const x of p) { if (x > 50) break; s += x; } return s; }
function either(p: Plain | Range): number { let s = 0; for (const x of p) s += x; return s; }
console.log("plain", sum(new Plain(4)), sum(new Twice(4)), sum(new Plain(0)), either(new Plain(3))); log = []; console.log("either", either(new Range(3)), log.length); log = [];
{ const p = new Plain(5); let first = 0; for (const x of p) { first = x; if (x === 1) break; } let rest = 0; for (const x of p) rest += x; console.log("resumed", first, rest); }
// The type is only a prediction: the object decides which method is found. An object from untyped code used as an interface; an inheriting object that overrides the method and returns something else; `next` as an accessor; `next` read once from an object from untyped code.
interface Walkable { [Symbol.iterator](): Plain }
function walk(w: Walkable): number { let s = 0; for (const x of w) { if (x > 50) break; s += x; } return s; }
// It has all that a Plain has, and is none: no object of the class.
const foreign = (n: number): Plain => { const it = { i: 0, n, next(): { value: number, done?: boolean } { say("foreign"); return it.i < n ? { value: 10 + it.i++ } : { value: 0, done: true }; }, return(): { value: number, done: boolean } { say("closed"); return { value: 0, done: true }; }, [Symbol.iterator](): Plain { return it; } }; return it; };
const stranger: Walkable = { [Symbol.iterator]() { return foreign(2); } };
class Heir extends Plain { [Symbol.iterator](): Plain { return foreign(3); } }
console.log("strangers", walk(stranger), walk(new Plain(3)), walk(new Heir(1)), sum(new Heir(1)), log.join()); log = [];
{ const far: Walkable = { [Symbol.iterator]() { return foreign(100); } }; let s = 0; for (const x of far) { if (x > 11) break; s += x; } console.log("a stranger is closed", s, log.join()); log = []; }
class Lazy { i = 0; get next(): () => { value: number, done: boolean } { say("get next"); return () => ({ value: this.i, done: this.i++ >= 2 }); } }
class HasLazy { [Symbol.iterator](): Lazy { return new Lazy(); } }
{ let s = 0; for (const x of new HasLazy()) s += x; console.log("next is an accessor", s, log.join()); log = []; }
// A record for an iterator: `next` is read ONCE: storing another in the loop changes nothing for this loop.
class Bag { constructor(public n: number) {} [Symbol.iterator](): { next: () => { value: number, done: boolean } } { let i = 0; const n = this.n; return { next: () => i < n ? { value: i++, done: false } : { value: 0, done: true } }; } }
function bag(b: Bag): number { let s = 0; for (const x of b) s += x; return s; }
console.log("record", bag(new Bag(4)), bag(new Bag(0)));
class Swapping { it: { next: () => { value: number, done: boolean } }; constructor(n: number) { let i = 0; this.it = { next: () => i < n ? { value: i++, done: false } : { value: 0, done: true } }; } [Symbol.iterator](): { next: () => { value: number, done: boolean } } { return this.it; } }
function swapped(w: Swapping): number { let s = 0; for (const x of w) { w.it.next = () => ({ value: 1000, done: true }); s += x; } return s; }
console.log("next stored to in the loop", swapped(new Swapping(3)));
// The forms of the loop head; a fresh binding for every iteration; nested; in a generator and in an async function.
class Pairs { constructor(public n: number) {} [Symbol.iterator](): PairSteps { return new PairSteps(this.n); } }
class PairSteps { i = 0; constructor(public n: number) {} next(): { value: [number, string], done: boolean } { const at = this.i++; return { value: [at, "s" + at], done: at >= this.n }; } }
{ let t = ""; for (const [a, b] of new Pairs(2)) t += a + b; const o = { p: 0 }; for (o.p of new Plain(3)) t += o.p; var v = 0; for (v of new Plain(2)) t += v; const fs: (() => number)[] = []; for (const x of new Plain(3)) fs.push(() => x); t += fs.map(f => f()).join(); for (const x of new Plain(2)) for (const y of new Plain(2)) t += "" + x + y; console.log("heads", t, v); }
function* through(p: Plain): Generator<number> { for (const x of p) { yield x; yield x * 10; } }
console.log("in a generator", [...through(new Plain(2))].join()); { const g = through(new Plain(5)); g.next(); g.next(); console.log(JSON.stringify(g.return(7)), JSON.stringify(g.next())); }
async function later(p: Plain): Promise<number> { let s = 0; for (const x of p) { s += await Promise.resolve(x); } return s; }
// What goes as before: arrays, strings, Map, Set, generators, arguments, typed arrays, `any`.
{ let t = ""; for (const x of [1, 2]) t += x; for (const c of "ab") t += c; for (const [k, w] of new Map([[1, "m"]])) t += k + w; for (const x of new Set([7])) t += x; for (const x of through(new Plain(1))) t += x; for (const x of new Uint8Array([3])) t += x; const a: any = new Plain(2); for (const x of a) t += x; console.log("as before", t); }
later(new Plain(4)).then(s => console.log("in an async function", s));
//// iterator-helper-closes-started-iterator.js
// An iterator helper that has started closes its underlying iterator once: when its return() is called, when a loop over it exits early, and when its callback throws. The result of the underlying return() must be an object, and an error of the callback wins over an error of return().
const log = [];
function underlying(close = () => ({})) {
  let count = 0;
  return {
    __proto__: Iterator.prototype,
    next() {
      log.push("next");
      return { value: ++count, done: false };
    },
    return() {
      log.push("return");
      return close();
    },
  };
}
function attempt(label, run) {
  log.length = 0;
  let outcome;
  try {
    outcome = "gives " + JSON.stringify(run());
  } catch (error) {
    outcome = "throws " + (error instanceof Error ? error.name + ": " + error.message : String(error));
  }
  console.log(label + ": " + outcome + " | " + log.join(" "));
}

const helpers = {
  map: (u, callback = x => x) => u.map(callback),
  filter: (u, callback = () => true) => u.filter(callback),
  flatMap: (u, callback = x => [x]) => u.flatMap(callback),
  take: u => u.take(3),
  drop: u => u.drop(1),
};

for (const [name, create] of Object.entries(helpers)) {
  attempt(name + ", next() then return()", () => {
    const helper = create(underlying());
    helper.next();
    return helper.return();
  });
  attempt(name + ", return() twice, then next()", () => {
    const helper = create(underlying());
    helper.next();
    helper.return();
    return [helper.return(), helper.next()];
  });
  attempt(name + ", break out of a loop", () => {
    for (const x of create(underlying())) break;
  });
  attempt(name + ", return out of a loop", () => {
    for (const x of create(underlying())) return x;
  });
  attempt(name + ", throw out of a loop", () => {
    for (const x of create(underlying())) throw "from the loop";
  });
  attempt(name + ", a pattern shorter than the iterator", () => {
    const [first, second] = create(underlying());
    return [first, second];
  });
  for (const primitive of [undefined, null, 1, "text", true]) {
    attempt(name + ", return() gives " + String(primitive), () => {
      const helper = create(underlying(() => primitive));
      helper.next();
      return helper.return();
    });
  }
  attempt(name + ", return() gives a function", () => {
    const helper = create(underlying(() => function () {}));
    helper.next();
    return helper.return();
  });
  attempt(name + ", return() throws", () => {
    const helper = create(underlying(() => { throw "from return()"; }));
    helper.next();
    return helper.return();
  });
  attempt(name + ", return() throws and a loop breaks", () => {
    for (const x of create(underlying(() => { throw "from return()"; }))) break;
  });
  attempt(name + ", return() throws and a loop throws", () => {
    for (const x of create(underlying(() => { throw "from return()"; }))) throw "from the loop";
  });
}

for (const name of ["map", "filter", "flatMap"]) {
  const fail = () => { throw "from the callback"; };
  attempt(name + ", the callback throws", () => helpers[name](underlying(), fail).next());
  attempt(name + ", the callback throws and return() throws", () => helpers[name](underlying(() => { throw "from return()"; }), fail).next());
  attempt(name + ", the callback throws and return() gives a number", () => helpers[name](underlying(() => 1), fail).next());
  attempt(name + ", the callback throws at the second value", () => {
    const helper = helpers[name](underlying(() => { throw "from return()"; }), x => { if (x === 2) throw "from the callback"; return [x]; });
    return [helper.next(), helper.next()];
  });
  attempt(name + ", next() and return() after the callback threw", () => {
    const helper = helpers[name](underlying(), fail);
    try { helper.next(); } catch {}
    return [helper.next(), helper.return()];
  });
}

////= attempt-3	"flatMap, return() while an inner iterator is open"	log.push("inner next"); return { value: 0, done: false }; }, return() { log.push("inner return"); return {}
////= attempt-3	"flatMap, the inner return() throws"	return { value: 0, done: false }; }, return() { log.push("inner return"); throw "from the inner return()"
attempt("flatMap, the callback gives a number", () => underlying(() => { throw "from return()"; }).flatMap(() => 1).next());
attempt("take, the limit is reached", () => {
  const helper = underlying().take(1);
  return [helper.next(), helper.next(), helper.next()];
});
attempt("take, the limit is reached and return() gives a number", () => {
  const helper = underlying(() => 1).take(1);
  helper.next();
  return helper.next();
});
attempt("a chain of helpers", () => {
  const helper = underlying().map(x => x + 1).filter(() => true).take(5).drop(0);
  helper.next();
  return helper.return();
});
attempt("an underlying iterator without return()", () => {
  const helper = { __proto__: Iterator.prototype, next() { log.push("next"); return { value: 1, done: false }; } }.map(x => x);
  helper.next();
  return helper.return();
});
//// iterator-helper-return-before-start.js
// An iterator helper's return() before its first next() closes the underlying iterator and returns an ordinary iterator result.
let closed = 0;
const underlying = { __proto__: Iterator.prototype, next() { return { value: 1, done: false }; }, return() { closed++; return {}; } };
const helper = underlying.map(x => x);
const result = helper.return();
console.log(JSON.stringify(result), Object.keys(result).join(), closed);
console.log(JSON.stringify(helper.next()), JSON.stringify(helper.return()), closed);
//// job-order-async-generators.ts
// The order in which things happen when async generators, `for await` and async functions run side by side.
// Each round builds a few chains from a seed. A chain awaits plain values, settled promises, promises that another chain settles later,
// thenables and calls of async functions. Everything that happens is written to one log, and the log is reduced to a checksum per round.
let log: string[] = [];
////= note

let seed = 1;
////= random	limit

let gates: ((value: number) => void)[] = [];
function gate(): Promise<number> {
    return new Promise<number>(resolve => {
        gates.push(resolve);
    });
}
function openGate(label: string): void {
    const resolve = gates.shift();
    if (resolve) {
        note(label + " opens a gate");
        resolve(gates.length);
    }
}

async function plain(value: number): Promise<number> {
    return value + 1;
}
async function slow(value: number): Promise<number> {
    await null;
    await undefined;
    return value + 2;
}
class Thenable {
    constructor(private label: string, private value: number) {}
    then(onFulfilled: (value: number) => void): void {
        note(this.label + " then is called");
        onFulfilled(this.value + 3);
    }
}
function thenable(label: string, value: number): Thenable {
    return new Thenable(label, value);
}

async function something(label: string, kind: number, value: number): Promise<number> {
    switch (kind) {
    case 0:
        return (await value) + 1;
    case 1:
        return await Promise.resolve(value);
    case 2:
        return await plain(value);
    case 3:
        return await slow(value);
    case 4:
        return await thenable(label, value);
    case 5:
        openGate(label);
        return value;
    case 6:
        try {
            return await Promise.reject(new Error("no " + value));
        } catch (error) {
            note(label + " caught " + String(error));
            return value;
        }
    default:
        return await gate();
    }
}

async function* source(label: string, count: number, kinds: number[]): AsyncGenerator<number, string, unknown> {
    note(label + " starts");
    try {
        for (let i = 0; i < count; i++) {
            const kind = kinds[i % kinds.length];
            let value = i;
            switch (kind) {
            case 0:
                value = (await i) + 1;
                break;
            case 1:
                value = await Promise.resolve(i);
                break;
            case 2:
                value = await plain(i);
                break;
            case 3:
                value = await slow(i);
                break;
            case 4:
                value = await thenable(label, i);
                break;
            case 5:
                openGate(label);
                break;
            case 6:
                value = await something(label, random(8), i);
                break;
            case 7:
                value = await gate();
                break;
            default:
                break;
            }
            note(label + " yields " + value);
            const sent = yield kind === 8 ? Promise.resolve(value) : value;
            if (sent !== undefined)
                note(label + " was sent " + String(sent));
        }
        return label + " is over";
    } finally {
        note(label + " leaves");
        if (count % 2)
            await null;
        note(label + " has left");
    }
}

async function* mapped(label: string, inner: AsyncGenerator<number, string, unknown>, awaitsToo: boolean): AsyncGenerator<number, string, unknown> {
    for await (const value of inner) {
        note(label + " takes " + value);
        if (awaitsToo)
            await null;
        yield value * 10;
    }
    return label + " is over";
}

async function* delegating(label: string, inner: AsyncGenerator<number, string, unknown>): AsyncGenerator<number, string, unknown> {
    const result = yield* inner;
    note(label + " got " + result);
    return label + " is over";
}

async function* overSync(label: string, values: (number | Promise<number>)[]): AsyncGenerator<number, void, unknown> {
    for await (const value of values) {
        note(label + " takes " + value);
        yield value;
    }
}

async function consume(label: string, chain: AsyncGenerator<number, unknown, unknown>, leavesAt: number): Promise<void> {
    let seen = 0;
    for await (const value of chain) {
        note(label + " sees " + value);
        if (++seen === leavesAt) {
            note(label + " breaks");
            break;
        }
    }
    note(label + " is done");
}

async function consumeByHand(label: string, chain: AsyncGenerator<number, unknown, unknown>, atOnce: number): Promise<void> {
    for (let round = 0; round < 4; round++) {
        const steps: Promise<IteratorResult<number, unknown>>[] = [];
        for (let i = 0; i < atOnce; i++)
            steps.push(chain.next(round * 10 + i));
        if (round === 2)
            steps.push(chain.return("closed by " + label));
        for (const step of steps) {
            const result = await step;
            note(label + " got " + String(result.value) + " " + result.done);
        }
    }
    note(label + " is done");
}

async function ticker(label: string, ticks: number): Promise<void> {
    for (let i = 0; i < ticks; i++) {
        await null;
        note(label + " " + i);
    }
}

function build(label: string, depth: number): AsyncGenerator<number, unknown, unknown> {
    const kinds: number[] = [];
    for (let i = 1 + random(4); i > 0; i--)
        kinds.push(random(10));
    let chain: AsyncGenerator<number, string, unknown> = source(label + ".0", 1 + random(6), kinds);
    for (let level = 1; level <= depth; level++)
        chain = random(3) ? mapped(label + "." + level, chain, random(2) === 0) : delegating(label + "." + level, chain);
    return chain;
}

function checksum(lines: string[]): number {
    let sum = 0;
    for (const line of lines) {
        for (let i = 0; i < line.length; i++)
            sum = (sum * 31 + line.charCodeAt(i)) % 1000000007;
        sum = (sum * 31 + 10) % 1000000007;
    }
    return sum;
}

async function round(number: number): Promise<void> {
    seed = number * 7919 + 1;
    log = [];
    gates = [];
    const running: Promise<void>[] = [];
    const chains = 1 + random(3);
    for (let i = 0; i < chains; i++) {
        const label = "c" + i;
        const chain = random(5) ? build(label, random(4)) : overSync(label, [1, Promise.resolve(2), 3, plain(3)]);
        running.push(random(4) ? consume(label, chain, random(3) ? 0 : 1 + random(4)) : consumeByHand(label, chain, 1 + random(3)));
    }
    if (random(3) === 0)
        running.push(ticker("tick", 3 + random(12)));
    let settled = false;
    const all = Promise.all(running).then(() => {
        settled = true;
    });
    for (let turn = 0; turn < 60 && !settled; turn++) {
        await new Promise<void>(resolve => setTimeout(resolve, 0));
        if (!settled)
            openGate("the round");
    }
    await (settled ? all : undefined);
    console.log(number, settled, log.length, checksum(log));
    if (number % 25 === 0)
        console.log(log.slice(0, 40).join(" | "));
}

async function main(): Promise<void> {
    for (let number = 1; number <= 150; number++)
        await round(number);
}

main();
//// job-order-async-returns.ts
// The order in which everything happens when async functions return to async functions that wait for them:
// alone (nothing else is queued), beside tickers, with several waiters on one promise, and with every kind of returned value.
import { AsyncLocalStorage } from "node:async_hooks";

let seed = 12345;
////= random	below

let log: string[] = [];
////= note

class Thenable implements PromiseLike<number> {
    constructor(private label: string, private value: number) {}
    then<A = number, B = never>(onFulfilled?: ((value: number) => A | PromiseLike<A>) | null): PromiseLike<A | B> {
        note(this.label + " then is called");
        onFulfilled?.(this.value + 5);
        return new Promise<A | B>(() => {});
    }
}

interface Box { value: number }
const storage = new AsyncLocalStorage<string>();
function where(): string {
    return storage.getStore() ?? "-";
}

let release: (() => void)[] = [];
function outside(): Promise<void> {
    return new Promise(resolve => { release.push(resolve); });
}

async function bottom(label: string, kind: number, value: number): Promise<number | Box> {
    note(label + " bottom starts in " + where());
    switch (kind) {
    case 0:
        await null;
        return value;
    case 1:
        await outside();
        return value + 1;
    case 2:
        await outside();
        return { value: value + 2 };
    case 3:
        await null;
        return Promise.resolve(value + 3);
    case 4:
        await outside();
        return new Thenable(label, value);
    case 5:
        await outside();
        throw new Error(label + " fails");
    case 6:
        return value + 6;
    case 7:
        try {
            await outside();
            return value + 7;
        } finally {
            note(label + " finally in " + where());
        }
    default:
        await outside();
        await null;
        await outside();
        return value + 8;
    }
}

function numberOf(result: number | Box): number {
    return typeof result === "number" ? result : result.value;
}

async function level(label: string, depth: number, kind: number, value: number): Promise<number> {
    if (!depth)
        return numberOf(await bottom(label, kind, value));
    let result: number;
    if ((depth + kind) % 4 === 3) {
        try {
            result = await level(label, depth - 1, kind, value);
        } catch (error) {
            note(label + " level " + depth + " caught " + String(error) + " in " + where());
            result = -depth;
        }
    } else if ((depth + kind) % 5 === 4)
        result = await storage.run(label + depth, () => level(label, depth - 1, kind, value));
    else
        result = await level(label, depth - 1, kind, value);
    note(label + " level " + depth + " has " + result + " in " + where());
    return result + 1;
}

////= ticker-2

async function twoWaiters(label: string, kind: number): Promise<void> {
    const shared = level(label, 1, kind, 100);
    const first = (async () => { note(label + " first has " + await shared); })();
    const second = (async () => { note(label + " second has " + await shared); })();
    shared.then(value => note(label + " then has " + value), error => note(label + " then fails " + String(error)));
    await Promise.allSettled([first, second]);
}

function pump(done: () => boolean, finish: () => void): void {
    const waiting = release;
    release = [];
    const only = random(3);
    waiting.forEach((resolve, index) => {
        if (only && index % 2 === only - 1 && waiting.length > 1)
            release.push(resolve);
        else
            resolve();
    });
    if (done())
        finish();
    else
        setTimeout(() => pump(done, finish), 0);
}

////= sumOf

async function round(number: number): Promise<void> {
    log = [];
    const work: Promise<unknown>[] = [];
    const chains = 1 + random(3);
    for (let i = 0; i < chains; i++) {
        const label = "c" + i;
        const depth = random(6);
        const kind = random(9);
        const started = random(4) ? level(label, depth, kind, i * 10) : storage.run("s" + i, () => level(label, depth, kind, i * 10));
        work.push(started.then(value => note(label + " ends with " + value), error => note(label + " ends failing " + String(error))));
    }
    if (!random(3))
        work.push(ticker("t", 1 + random(9)));
    if (!random(4))
        work.push(twoWaiters("w", random(9)));
    let finished = false;
    Promise.all(work).then(() => { finished = true; });
    await new Promise<void>(resolve => pump(() => finished, resolve));
    console.log(number, log.length, sumOf(log));
}

async function main(): Promise<void> {
    for (let i = 0; i < 200; i++)
        await round(i);
    log = [];
    let finished = false;
    level("alone", 5, 1, 1).then(value => {
        note("alone ends with " + value);
        finished = true;
    });
    await new Promise<void>(resolve => pump(() => finished, resolve));
    console.log(log.join("\n"));
}

main();
//// job-order-of-yields-of-proven-values.ts
// `yield e` in an async generator awaits `e` and hands it out. However much the build knows about `e` (a counter in a range, a constant, a string, a promise, a value nobody knows),
// a step takes the same turns of the job queue, which a ticker beside the loop shows.
const order: string[] = [];
const hidden = new Function("v", "return v" + String(order.length).slice(1)) as <V>(v: V) => V;
function ticker(label: string, turns: number): Promise<void> {
    let last: Promise<void> = Promise.resolve();
    for (let i = 1; i <= turns; i++) last = last.then(() => void order.push(label + i));
    return last;
}
async function* counters(n: number): AsyncGenerator<number> {
    for (let i = 0; i < n; i++) yield i;
}
async function* constants(): AsyncGenerator<number> {
    yield 1;
    yield 2;
}
async function* texts(n: number): AsyncGenerator<string> {
    for (let i = 0; i < n; i++) yield "t" + i;
}
async function* promises(n: number): AsyncGenerator<number> {
    for (let i = 0; i < n; i++) yield Promise.resolve(i * 10);
}
async function* unknownValues(values: unknown[]): AsyncGenerator<unknown> {
    for (const value of values) yield hidden(value);
}
async function* usedAfterwards(n: number): AsyncGenerator<number> {
    for (let i = 0; i < n; i++) {
        const sent = yield i;
        order.push("sent " + String(sent));
    }
}
async function run(label: string, source: AsyncGenerator<unknown>): Promise<void> {
    const beside = ticker(label + ".", 10);
    for await (const value of source) order.push(label + "=" + String(value));
    order.push(label + " ends");
    await beside;
}
await run("counters", counters(3));
await run("constants", constants());
await run("texts", texts(2));
await run("promises", promises(2));
await run("unknown", unknownValues([1, "two", Promise.resolve(3), { then(resolve: (value: number) => void) { resolve(4); } }]));
await run("sent", usedAfterwards(2));
const byHand = counters(2);
const beside = ticker("hand.", 8);
order.push(JSON.stringify(await byHand.next()), JSON.stringify(await byHand.next()), JSON.stringify(await byHand.next()));
await beside;
console.log(order.join("\n"));
export {};
//// later-awaits-on-pending-promises.ts
// From its second suspension on an activation registers itself with what it awaits: every kind of awaited value, in the order of jobs that the language gives
import { AsyncLocalStorage } from "node:async_hooks";

const log: string[] = [];
function deferred<T>() {
  let resolve!: (value: T | PromiseLike<T>) => void;
  let reject!: (reason: unknown) => void;
  const promise = new Promise<T>((res, rej) => {
    resolve = res;
    reject = rej;
  });
  return { promise, resolve, reject };
}
const tick = () => new Promise<void>(resolve => setImmediate(resolve));

async function awaitsTwice(name: string, first: Promise<number>, second: Promise<number>): Promise<number> {
  const a = await first;
  log.push(`${name} first ${a}`);
  const b = await second;
  log.push(`${name} second ${b}`);
  return a + b;
}

async function orderAmongReactions() {
  const first = deferred<number>();
  const second = deferred<number>();
  second.promise.then(v => log.push(`then before ${v}`));
  const one = awaitsTwice("one", first.promise, second.promise);
  const two = awaitsTwice("two", first.promise, second.promise);
  first.resolve(1);
  await tick();
  second.promise.then(v => log.push(`then after ${v}`));
  second.resolve(2);
  queueMicrotask(() => log.push("job behind the resolution"));
  log.push(`sums ${await one} ${await two}`);
}

async function onlyWaiter() {
  const first = deferred<number>();
  const second = deferred<number>();
  const sum = awaitsTwice("alone", first.promise, second.promise);
  first.resolve(10);
  await tick();
  second.resolve(20);
  Promise.resolve().then(() => log.push("job queued behind"));
  log.push(`alone ${await sum}`);
}

async function catchesLaterRejection(first: Promise<number>, second: Promise<number>) {
  await first;
  try {
    await second;
    log.push("not reached");
  } catch (error) {
    log.push(`caught ${(error as Error).message}`);
  }
  return "after catch";
}

async function rejections() {
  const first = deferred<number>();
  const second = deferred<number>();
  const result = catchesLaterRejection(first.promise, second.promise);
  first.resolve(0);
  await tick();
  second.reject(new Error("late"));
  log.push(await result);
}

async function resolvedWithPromise() {
  const first = deferred<number>();
  const outer = deferred<number>();
  const inner = deferred<number>();
  const sum = awaitsTwice("chained", first.promise, outer.promise);
  first.resolve(1);
  outer.resolve(inner.promise);
  await tick();
  inner.resolve(41);
  log.push(`chained ${await sum}`);
}

class OwnPromise<T> extends Promise<T> {}
async function otherAwaitedValues(gate: Promise<void>) {
  await gate;
  log.push(`subclass ${await OwnPromise.resolve(5)}`);
  log.push(`thenable ${await { then(resolve: (v: number) => void) { resolve(6); } }}`);
  log.push(`number ${await 7}`);
  log.push(`object ${JSON.stringify(await { plain: 8 })}`);
  log.push(`settled ${await Promise.resolve(9)}`);
  const late = deferred<number>();
  setImmediate(() => late.resolve(10));
  log.push(`pending ${await late.promise}`);
}

async function leaf(gates: Promise<number>[]): Promise<number> {
  let sum = 0;
  for (const gate of gates) sum += await gate;
  return sum;
}
async function middle(gates: Promise<number>[], own: Promise<number>): Promise<number> {
  const before = await own;
  const below = await leaf(gates);
  const again = await leaf(gates);
  return before + below + again;
}
async function top(gates: Promise<number>[], own: Promise<number>): Promise<string> {
  await own;
  try {
    return `top ${await middle(gates, own)}`;
  } catch (error) {
    return `top caught ${(error as Error).message}`;
  }
}

async function chainsOfCalls() {
  for (const fails of [false, true]) {
    const own = deferred<number>();
    const gates = [deferred<number>(), deferred<number>(), deferred<number>()];
    const result = top(gates.map(g => g.promise), own.promise);
    own.resolve(100);
    await tick();
    gates[0].resolve(1);
    await tick();
    gates[1].resolve(2);
    await tick();
    if (fails) gates[2].reject(new Error("third gate"));
    else gates[2].resolve(3);
    log.push(await result);
  }
}

async function manyFramesAcrossCollections() {
  const gates = Array.from({ length: 200 }, () => deferred<number>());
  const opened = deferred<number>();
  const sums = gates.map((gate, i) => awaitsTwice(`frame${i}`, opened.promise, gate.promise));
  opened.resolve(1);
  await tick();
  Bun.gc(true);
  gates.forEach((gate, i) => gate.resolve(i));
  Bun.gc(true);
  const total = (await Promise.all(sums)).reduce((a, b) => a + b, 0);
  log.splice(log.findIndex(line => line.startsWith("frame")));
  log.push(`frames ${total}`);
}

const storage = new AsyncLocalStorage<string>();
async function readsStore(name: string, first: Promise<number>, second: Promise<number>) {
  await first;
  log.push(`${name} ${storage.getStore()}`);
  await second;
  log.push(`${name} ${storage.getStore()}`);
  log.push(`${name} ${await leaf([second])} ${storage.getStore()}`);
}
async function contexts() {
  const first = deferred<number>();
  const second = deferred<number>();
  const a = storage.run("a", () => readsStore("in a", first.promise, second.promise));
  const b = storage.run("b", () => readsStore("in b", first.promise, second.promise));
  const none = readsStore("outside", first.promise, second.promise);
  first.resolve(1);
  await tick();
  storage.run("resolver", () => second.resolve(2));
  await Promise.all([a, b, none]);
}

process.on("unhandledRejection", reason => log.push(`unhandled ${(reason as Error).message}`));

await orderAmongReactions();
await onlyWaiter();
await rejections();
await resolvedWithPromise();
await otherAwaitedValues(tick());
await chainsOfCalls();
await manyFramesAcrossCollections();
await contexts();
await onlyWaiter();
await tick();
console.log(log.join("\n"));
//// long-async-generator-streams.ts
// Long streams: tens of thousands of turns, alone, chained, several at once, and waiting for jobs: the stack must not grow with the
// turns, whatever the collector does meanwhile.
async function* count(n: number): AsyncGenerator<number> {
    for (let i = 0; i < n; i++) yield i;
}
async function* objects(n: number): AsyncGenerator<{ i: number }> {
    for (let i = 0; i < n; i++) yield { i };
}
async function* doubled(source: AsyncIterable<number>): AsyncGenerator<number> {
    for await (const x of source) yield x * 2;
}
function later(): Promise<void> {
    return new Promise(resolve => { Promise.resolve().then(() => resolve()); });
}
async function* waits(n: number): AsyncGenerator<number> {
    for (let i = 0; i < n; i++) { await later(); yield i; }
}
async function sum(source: AsyncIterable<number>): Promise<number> {
    let t = 0;
    for await (const x of source) t += x;
    return t;
}
async function sumOfObjects(source: AsyncIterable<{ i: number }>): Promise<number> {
    let t = 0;
    const kept: { i: number }[] = [];
    for await (const x of source) {
        t += x.i;
        if (x.i % 1000 === 0) kept.push(x);
    }
    return t + kept.length;
}
const n = 40000;
console.log("alone", await sum(count(n)));
console.log("objects", await sumOfObjects(objects(n)));
console.log("chained", await sum(doubled(doubled(count(n)))));
console.log("two at once", (await Promise.all([sum(count(n)), sum(count(n))])).join(" "));
console.log("two chains at once", (await Promise.all([sum(doubled(count(n))), sum(doubled(count(n)))])).join(" "));
console.log("waits", await sum(waits(n)));
console.log("a chain that waits", await sum(doubled(waits(n))));
console.log("three of a kind", (await Promise.all([sum(waits(n)), sum(doubled(count(n))), sumOfObjects(objects(n))])).join(" "));
//// long-direct-await-chains.ts
// A chain of 20,000 async functions, each awaiting the next, resumes innermost first once a timer settles the last one, without a stack overflow: with an empty microtask queue, with other jobs queued, through a thenable, and on rejection.
const chainLength = 20_000;
const settled = Promise.resolve();
type Ending = "a number" | "a thenable" | "an error";
type Chain = (depth: number, ending: Ending) => Promise<number>;

let resumed: number[] = [];
let marks: string[] = [];
let ticks = 0;
let hasOtherJobs = false;
let isChainDone = false;

function tick(): void {
  ticks++;
  if (!isChainDone) settled.then(tick);
}
////= afterTimer-2	ettled.then(tick
////= thenable
function didResume(depth: number): void {
  resumed.push(depth);
  if (depth % 5_000 === 0 || depth === chainLength - 1) marks.push(depth + " at tick " + ticks);
}

async function innermost(ending: Ending): Promise<number> {
  await afterTimer();
  if (ending === "an error") throw new RangeError("thrown by the innermost function");
  return ending === "a thenable" ? thenable(0) : 0;
}
////= awaitsCall
////= awaitsVariable

async function run(chain: Chain, ending: Ending, withOtherJobs: boolean): Promise<void> {
  resumed = [];
  marks = [];
  ticks = 0;
  hasOtherJobs = withOtherJobs;
  isChainDone = false;
  let outcome: string;
  try {
    outcome = "fulfilled with " + (await chain(chainLength - 1, ending));
  } catch (error) {
    outcome = "rejected with " + (error as Error).message;
  }
  isChainDone = true;
  const isInnermostFirst = resumed.length === chainLength && resumed.every((depth, index) => depth === index);
  console.log(chain.name + ", " + ending + (withOtherJobs ? ", other jobs queued: " : ", empty queue: ") + outcome + ", innermost first: " + isInnermostFirst + (withOtherJobs ? ", " + marks.join(", ") : ""));
}

for (const chain of [awaitsCall, awaitsVariable]) {
  for (const ending of ["a number", "a thenable", "an error"] as const) {
    await run(chain, ending, false);
    await run(chain, ending, true);
  }
}
//// long-streams-via-next.ts
// Long streams pulled by next() written out: every step is an object of its own that the program may keep: some are kept for the whole run and read at the end,
// while the rest become garbage; numbers, texts and records are yielded; the puller is an async function, an async generator, or a relay with an async function inside;
// one stream, two side by side, and one whose steps are asked for ahead of their awaiting.
interface Chunk { n: number; text: string; }
async function* numbers(n: number): AsyncGenerator<number, string> { for (let i = 0; i < n; i++) yield i; return "numbers are over"; }
async function* texts(n: number): AsyncGenerator<string, string> { for (let i = 0; i < n; i++) yield "t" + i; return "texts are over"; }
async function* chunks(n: number): AsyncGenerator<Chunk, string> { for (let i = 0; i < n; i++) yield { n: i, text: "c" + i }; return "chunks are over"; }
async function* sometimesWaits(n: number): AsyncGenerator<number, string> {
    for (let i = 0; i < n; i++) { if (i % 7 === 3) await Promise.resolve().then(() => undefined); yield i; }
    return "over";
}
function weigh(value: unknown): number {
    return typeof value === "number" ? value : typeof value === "string" ? value.length : (value as Chunk).n + (value as Chunk).text.length;
}
async function byFunction<T>(source: AsyncGenerator<T, string>, kept: IteratorResult<T, string>[]): Promise<string> {
    let total = 0, steps = 0;
    for (;;) {
        const step = await source.next();
        if (steps++ % 97 === 0 || step.done) kept.push(step);
        if (step.done) return steps + " steps, " + total + ", " + step.value;
        total += weigh(step.value);
    }
}
async function* byGenerator<T>(source: AsyncGenerator<T, string>, kept: IteratorResult<T, string>[]): AsyncGenerator<T, string> {
    let steps = 0;
    for (;;) {
        const step = await source.next();
        if (steps++ % 97 === 0 || step.done) kept.push(step);
        if (step.done) return step.value;
        yield step.value;
    }
}
async function* relay<T>(source: AsyncGenerator<T, string>): AsyncGenerator<T, string> {
    const pulled = async (): Promise<IteratorResult<T, string>> => { try { return await source.next(); } catch (error) { throw error; } };
    while (true) {
        const step = await pulled();
        if (step.done === true) return step.value;
        yield step.value;
    }
}
async function ahead<T>(source: AsyncGenerator<T, string>, kept: IteratorResult<T, string>[]): Promise<string> {
    let total = 0, steps = 0;
    let coming = source.next();
    for (;;) {
        const next = source.next();
        const step = await coming;
        coming = next;
        if (steps++ % 97 === 0 || step.done) kept.push(step);
        if (step.done) return steps + " steps, " + total + ", " + step.value;
        total += weigh(step.value);
    }
}
function told<T>(kept: IteratorResult<T, string>[]): string {
    let total = 0;
    for (const step of kept) total += step.done ? 1000000 : weigh(step.value);
    return kept.length + " kept, " + new Set(kept).size + " different, " + total + ", keys " + Object.keys(kept[0]).join();
}
const lines: string[] = [];
async function scene<T>(title: string, run: (kept: IteratorResult<T, string>[]) => Promise<string>): Promise<void> {
    const kept: IteratorResult<T, string>[] = [];
    lines.push(title + ": " + await run(kept) + " | " + told(kept));
}
const n = 6000;
await scene<number>("numbers by a function", kept => byFunction(numbers(n), kept));
await scene<string>("texts by a function", kept => byFunction(texts(n), kept));
await scene<Chunk>("records by a function", kept => byFunction(chunks(n), kept));
await scene<number>("a stream that sometimes waits", kept => byFunction(sometimesWaits(n), kept));
await scene<Chunk>("records by a generator by a function", kept => byFunction(byGenerator(chunks(n), kept), kept));
await scene<Chunk>("records relayed twice", kept => byFunction(relay(relay(chunks(n))), kept));
await scene<number>("sometimes waits, relayed", kept => byFunction(relay(sometimesWaits(n)), kept));
await scene<string>("asked for ahead", kept => ahead(texts(n), kept));
await scene<number>("asked for ahead, sometimes waits", kept => ahead(sometimesWaits(n), kept));
await scene<Chunk>("two side by side", async kept => (await Promise.all([byFunction(chunks(n), kept), byFunction(relay(chunks(n)), kept)])).join(" & "));
await scene<number>("three kinds side by side", async kept => (await Promise.all([byFunction(numbers(n), kept), byFunction(sometimesWaits(n), kept), ahead(numbers(n), kept)])).join(" & "));
console.log(lines.join("\n"));
