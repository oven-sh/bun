    if (value === 0) text += "(" + seen[0].next().value + ")"
  }
  console.log(text)
}
////: throwing
function* throwing(when: number): Generator<number> {
  if (when === 0) throw new RangeError("at start")
  yield 1
  if (when === 1) throw new RangeError("after one")
  yield 2
}
////: thrown
function thrown(): void {
