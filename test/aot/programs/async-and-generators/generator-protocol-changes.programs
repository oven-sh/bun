//// loops-over-objects-whose-iterator-method-is-a-generator-that-is-replaced-shadowed-or-removed.js
// for-of over an object whose @@iterator is a generator method: every way that belief can end
const out = [];
function say(...a) { out.push(a.join(" ")); }
class Bag {
  constructor(...v) { this.v = v; }
  *[Symbol.iterator]() { for (let i = 0; i < this.v.length; i++) yield this.v[i]; }
}
class Twice extends Bag { *[Symbol.iterator]() { for (const x of this.v) { yield x; yield x; } } }
class Plain extends Bag { [Symbol.iterator]() { return this.v[Symbol.iterator](); } }
class Below extends Bag {}
function sum(b) { let s = 0; for (const x of b) s += x; return s; }
function first(b) { for (const x of b) return x; return -1; }
function spread(b) { return [...b].join(); }
function destructure(b) { const [p, q = "none"] = b; return p + ":" + q; }
function warm(b) { let s = 0; for (let i = 0; i < 300; i++) s += sum(b) + first(b); return s; }
const a = new Bag(1, 2, 3), t = new Twice(1, 2), p = new Plain(4, 5), w = new Below(6, 7);
say("warm", warm(a), warm(t), warm(p), warm(w), spread(a), spread(t), destructure(a), destructure(new Bag(1)));
// the order of events: the method is read, called, next is read once
const log = [];
const watched = new Proxy(a, { get(o, k, r) { log.push(String(k)); return Reflect.get(o, k, o); } });
say("proxy", sum(watched), log.join());
// an own @@iterator
const own = new Bag(1, 2, 3);
own[Symbol.iterator] = function* () { yield 50; };
say("own", sum(own), first(own), spread(own), sum(a));
delete own[Symbol.iterator];
say("own gone", sum(own));
// return() is called when the loop is left
class Closing { *[Symbol.iterator]() { try { yield 1; yield 2; } finally { say("finally ran"); } } }
say("left early", first(new Closing()));
try { for (const x of new Closing()) throw new Error("out"); } catch (e) { say("thrown out", e.message); }
outer: for (const x of new Closing()) { for (const y of new Closing()) continue outer; }
// the generators' own prototype gets a next | return
const mine = Bag.prototype[Symbol.iterator].prototype;
mine.next = function () { return { done: true }; };
say("next on the function's prototype", sum(a), sum(w), sum(t));
delete mine.next;
say("and gone", sum(a), sum(w));
mine.return = function (v) { say("my return"); return { done: true, value: v }; };
say("return on the function's prototype", first(a), first(t));
delete mine.return;
function attempt(name, f) { try { f(); say(name, "done"); } catch (e) { say(name, e.constructor.name); } }
// the method is replaced later
const old = Bag.prototype[Symbol.iterator];
Bag.prototype[Symbol.iterator] = function* () { yield 1000; };
say("replaced", sum(a), sum(w), sum(t), sum(p), first(a), spread(a), destructure(a));
Bag.prototype[Symbol.iterator] = function () { let n = 0; return { next() { return n++ < 2 ? { done: false, value: 7 } : { done: true } }, return() { say("object's return"); return {}; } }; };
say("replaced by a protocol object", sum(a), first(a), sum(w));
Bag.prototype[Symbol.iterator] = function () { return 5; };
attempt("gives a number", () => sum(a));
Bag.prototype[Symbol.iterator] = 5;
attempt("is a number", () => sum(a));
delete Bag.prototype[Symbol.iterator];
attempt("deleted", () => sum(a));
say("heirs with their own", sum(t), sum(p));
Object.defineProperty(Bag.prototype, Symbol.iterator, { get() { say("getter"); return old; }, configurable: true });
say("getter", sum(a), sum(w));
Object.defineProperty(Bag.prototype, Symbol.iterator, { value: old, writable: true, configurable: true });
say("restored", sum(a), sum(w), warm(a));
// the object's prototype moves
const moved = new Bag(1, 2, 3);
say("moved before", sum(moved));
Object.setPrototypeOf(moved, Twice.prototype); say("moved", sum(moved));
Object.setPrototypeOf(moved, Array.prototype); attempt("moved to Array.prototype", () => say(sum(moved)));
Object.setPrototypeOf(moved, null); attempt("moved to null", () => sum(moved));
// the list changes while it is walked; the generator throws; yields in a try
const growing = new Bag(1, 2); let n = 0; for (const x of growing) { if (n++ < 3) growing.v.push(x + 10); } say("growing", growing.v.join());
class Thrower { *[Symbol.iterator]() { yield 1; throw new RangeError("inside"); } }
attempt("throws inside", () => sum(new Thrower()));
class Args { *[Symbol.iterator]() { yield arguments.length; yield this === undefined; yield new.target === undefined; } }
say("arguments", spread(new Args()));
class Nested { constructor(k) { this.k = k; } *[Symbol.iterator]() { if (this.k > 0) { yield this.k; yield* new Nested(this.k - 1); } } }
say("nested", spread(new Nested(4)), sum(new Nested(10)));
say("uses", Array.from(a).join(), new Set(a).size, Math.max(...a), new Map([[1, a]]).get(1) === a, Object.fromEntries(new Bag(["k", 1]))["k"]);
Promise.all(new Bag(1, Promise.resolve(2))).then(v => { say("all", v.join()); console.log(out.join("\n")); });
//// loops-under-their-own-stores-over-one-generator.ts
// Several loops, each under an AsyncLocalStorage store of its own, step one async generator or one wrapped iterator. A loop goes on under the store that is active where its step is finished,
// from its first step on: whether or not the function of the loop has been suspended before makes no difference. (Node gives each loop its own store back.)
import { AsyncLocalStorage } from "node:async_hooks";
const storage = new AsyncLocalStorage<string>();
const lines: string[] = [];
async function* reads(name: string, count: number): AsyncGenerator<string> {
  for (let i = 0; i < count; i++) { await null; yield name + " " + i + " made under " + storage.getStore(); }
}
async function loop(name: string, source: AsyncIterable<string>): Promise<string> {
  for await (const value of source) lines.push(name + " under " + storage.getStore() + ": " + value);
  await null;
  return name + " ends under " + storage.getStore();
}
async function loopBehindAnAwait(name: string, source: AsyncIterable<string>): Promise<string> {
  await null;
  for await (const value of source) lines.push(name + " under " + storage.getStore() + ": " + value);
  return name + " ends under " + storage.getStore();
}
async function* passesOn(name: string, source: AsyncIterable<string>): AsyncGenerator<string> {
  for await (const value of source) yield name + " under " + storage.getStore() + ": " + value;
}
{
  const shared = storage.run("maker", () => reads("two", 4));
  lines.push(...(await Promise.all([storage.run("one", () => loop("a", shared)), storage.run("two", () => loop("b", shared))])));
}
{
  const shared = reads("three", 7);
  lines.push(...(await Promise.all([storage.run("one", () => loop("a", shared)), storage.run("two", () => loop("b", shared)), storage.run("three", () => loop("c", shared))])));
}
{
  const shared = reads("behind an await", 5);
  lines.push(...(await Promise.all([storage.run("one", () => loopBehindAnAwait("a", shared)), storage.run("two", () => loop("b", shared)), storage.run("three", () => loopBehindAnAwait("c", shared))])));
}
{
  const shared = reads("through generators", 4);
  lines.push(...(await Promise.all([storage.run("one", () => loop("a", passesOn("p", shared))), storage.run("two", () => loop("b", passesOn("q", shared)))])));
}
{
  // The generator is done when the second loop comes.
  const shared = reads("done", 1);
  lines.push(await storage.run("one", () => loop("a", shared)));
  lines.push(await storage.run("two", () => loop("b", shared)));
}
async function overAList(name: string, list: Iterable<string | Promise<string>>): Promise<string> {
  for await (const value of list) lines.push(name + " under " + storage.getStore() + ": " + value);
  return name + " ends under " + storage.getStore();
}
function* sync(): Generator<string> { yield "x under " + storage.getStore(); yield "y under " + storage.getStore(); yield "z under " + storage.getStore(); }
{
  lines.push(...(await Promise.all([storage.run("one", () => overAList("a", ["l", Promise.resolve("m")])), storage.run("two", () => overAList("b", ["n", Promise.resolve("o")]))])));
  const shared = sync();
  lines.push(...(await Promise.all([storage.run("one", () => overAList("a", shared)), storage.run("two", () => overAList("b", shared))])));
}
{
  // By hand beside a loop.
  const shared = reads("by hand", 4);
  const looped = storage.run("one", () => loop("a", shared));
  const stepped = storage.run("two", async () => { const step = await shared.next(); return "by hand under " + storage.getStore() + ": " + step.value; });
  lines.push(await stepped, await looped);
}
console.log(lines.join("\n"));
//// many-values-across-await-in-try.ts
// Many values stay alive over an `await` inside a `try` and then go into one array literal: a part of the saved frame lies far from the frame pointer.
declare const console: { log(...values: unknown[]): void };
class Rec { constructor(public n: number) {} }
let made = 0;
function rec(): Rec { return new Rec(++made); }
async function tick(): Promise<void> { await null; }
async function fails(value: unknown): Promise<never> { await tick(); throw value; }
function sum(all: Rec[]): number { let total = 0; for (const r of all) total = (total * 31 + r.n) % 1000003; return total; }
async function keeps500(): Promise<string> {
  const a0 = rec(), a1 = rec(), a2 = rec(), a3 = rec(), a4 = rec(), a5 = rec(), a6 = rec(), a7 = rec(), a8 = rec(), a9 = rec(), a10 = rec(), a11 = rec(), a12 = rec(), a13 = rec(), a14 = rec(), a15 = rec(), a16 = rec(), a17 = rec(), a18 = rec(), a19 = rec(), a20 = rec(), a21 = rec(), a22 = rec(), a23 = rec();
  const a24 = rec(), a25 = rec(), a26 = rec(), a27 = rec(), a28 = rec(), a29 = rec(), a30 = rec(), a31 = rec(), a32 = rec(), a33 = rec(), a34 = rec(), a35 = rec(), a36 = rec(), a37 = rec(), a38 = rec(), a39 = rec(), a40 = rec(), a41 = rec(), a42 = rec(), a43 = rec(), a44 = rec(), a45 = rec(), a46 = rec(), a47 = rec();
  const a48 = rec(), a49 = rec(), a50 = rec(), a51 = rec(), a52 = rec(), a53 = rec(), a54 = rec(), a55 = rec(), a56 = rec(), a57 = rec(), a58 = rec(), a59 = rec(), a60 = rec(), a61 = rec(), a62 = rec(), a63 = rec(), a64 = rec(), a65 = rec(), a66 = rec(), a67 = rec(), a68 = rec(), a69 = rec(), a70 = rec(), a71 = rec();
  const a72 = rec(), a73 = rec(), a74 = rec(), a75 = rec(), a76 = rec(), a77 = rec(), a78 = rec(), a79 = rec(), a80 = rec(), a81 = rec(), a82 = rec(), a83 = rec(), a84 = rec(), a85 = rec(), a86 = rec(), a87 = rec(), a88 = rec(), a89 = rec(), a90 = rec(), a91 = rec(), a92 = rec(), a93 = rec(), a94 = rec(), a95 = rec();
