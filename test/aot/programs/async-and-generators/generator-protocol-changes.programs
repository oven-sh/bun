  log.push("made")
  for (const value of made) log.push("value " + value)
  console.log(flush())
  const late = withDefault()
  log.push("made")
  for (const value of late) log.push("value " + value)
  console.log(flush())
  for (const value of withDefault(3)) log.push("value " + value)
  console.log(flush())
}
