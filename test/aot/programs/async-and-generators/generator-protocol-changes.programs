  const kept = throwing(0)
  try {
    for (const value of kept) log.push("value " + value)
  } catch (error) {
    log.push((error as Error).message)
  }
  const after = kept.next()
  console.log(flush(), after.done, after.value)
}
//// generator-protocol-changes.js
// The iterator protocol of a generator object changes after the object was created: `next` or `Symbol.iterator` is stored on the prototype of its generator function, that prototype gets another parent, the object gets an own `next` or another prototype. for-of, spread, array destructuring and yield* run the replacement as in plain Bun.
const lines = [];
const report = (label, ...lists) => lines.push(label + ": " + lists.map(list => "[" + list.map(String).join() + "]").join(" "));

////= lines-2	untouched
const createdFirst = [untouched(), untouched(), untouched(), untouched()];

const generatorPrototype = Object.getPrototypeOf(untouched.prototype);
const originalNext = generatorPrototype.next;
const originalReturn = generatorPrototype.return;

function scalingNext(sent) {
  const step = originalNext.call(this, sent);
  return step.done ? step : { done: false, value: step.value * 10 };
}
function reversingIterator() {
  const values = [];
  for (let step = originalNext.call(this); !step.done; step = originalNext.call(this)) values.unshift(step.value);
  return values[Symbol.iterator]();
}
const otherProtocol = {
  next: scalingNext,
  return(value) {
    lines.push("  other return");
    return originalReturn.call(this, value);
  },
  [Symbol.iterator]() {
    lines.push("  other Symbol.iterator");
    return this;
  },
};
function drain(generator) {
  const values = [];
  for (let step = originalNext.call(generator); !step.done; step = originalNext.call(generator)) values.push(step.value);
  return values;
}

////= lines-2	nextOnPrototype
function checkNextOnPrototype() {
  const looped = nextOnPrototype(), spreadOut = nextOnPrototype(), destructured = nextOnPrototype(), delegated = nextOnPrototype();
  nextOnPrototype.prototype.next = scalingNext;
  const seen = [];
  for (const value of looped) seen.push(value);
  const [first, second] = destructured;
  function* delegate() {
    yield* delegated;
  }
  report("prototype.next", seen, [...spreadOut], [first, second], drain(delegate()), [...nextOnPrototype()]);
}
checkNextOnPrototype();

////= lines-2	iteratorOnPrototype
function checkIteratorOnPrototype() {
  const looped = iteratorOnPrototype(), spreadOut = iteratorOnPrototype(), destructured = iteratorOnPrototype(), delegated = iteratorOnPrototype();
  iteratorOnPrototype.prototype[Symbol.iterator] = reversingIterator;
  const seen = [];
  for (const value of looped) seen.push(value);
  const [first, second] = destructured;
  function* delegate() {
    yield* delegated;
  }
  report("prototype[Symbol.iterator]", seen, [...spreadOut], [first, second], drain(delegate()), [...iteratorOnPrototype()]);
}
checkIteratorOnPrototype();

////= lines-2	parentOfPrototype
function checkParentOfPrototype() {
  const looped = parentOfPrototype(), spreadOut = parentOfPrototype(), destructured = parentOfPrototype(), delegated = parentOfPrototype();
  Object.setPrototypeOf(parentOfPrototype.prototype, otherProtocol);
  const seen = [];
  for (const value of looped) seen.push(value);
  const [first, second] = destructured;
  function* delegate() {
    yield* delegated;
  }
  report("setPrototypeOf(prototype)", seen, [...spreadOut], [first, second], drain(delegate()), [...parentOfPrototype()]);
}
checkParentOfPrototype();

////= lines-2	ownNext
function checkOwnNext() {
  const looped = ownNext(), spreadOut = ownNext(), destructured = ownNext(), delegated = ownNext();
  looped.next = spreadOut.next = destructured.next = delegated.next = scalingNext;
  const seen = [];
  for (const value of looped) seen.push(value);
  const [first, second] = destructured;
  function* delegate() {
    yield* delegated;
  }
  report("own next", seen, [...spreadOut], [first, second], drain(delegate()), [...ownNext()]);
}
checkOwnNext();

////= lines-2	prototypeOfObject
function checkPrototypeOfObject() {
  const looped = prototypeOfObject(), spreadOut = prototypeOfObject(), destructured = prototypeOfObject(), delegated = prototypeOfObject();
  for (const object of [looped, spreadOut, destructured, delegated]) Object.setPrototypeOf(object, otherProtocol);
  const seen = [];
  for (const value of looped) seen.push(value);
  const [first, second] = destructured;
  function* delegate() {
    yield* delegated;
  }
  report("setPrototypeOf(object)", seen, [...spreadOut], [first, second], drain(delegate()), [...prototypeOfObject()]);
}
checkPrototypeOfObject();

function* delegateTo(iterable) {
  yield* iterable;
}
function consume(label, [looped, spreadOut, destructured, delegated]) {
  const seen = [];
  for (const value of looped) seen.push(value);
  const [first, second] = destructured;
  report(label, seen, [...spreadOut], [first, second], drain(delegateTo(delegated)));
}
const makeCounter = () =>
  function* () {
    yield 1;
    yield 2;
    yield 3;
  };
const changes = {
  "prototype.next"(generatorFunction) {
    generatorFunction.prototype.next = scalingNext;
  },
  "prototype[Symbol.iterator]"(generatorFunction) {
    generatorFunction.prototype[Symbol.iterator] = reversingIterator;
  },
  "setPrototypeOf(prototype)"(generatorFunction) {
    Object.setPrototypeOf(generatorFunction.prototype, otherProtocol);
  },
  "own next"(generatorFunction, objects) {
    for (const object of objects) object.next = scalingNext;
  },
  "setPrototypeOf(object)"(generatorFunction, objects) {
    for (const object of objects) Object.setPrototypeOf(object, otherProtocol);
  },
};
for (const [name, change] of Object.entries(changes)) {
  const generatorFunction = makeCounter();
  const objects = [generatorFunction(), generatorFunction(), generatorFunction(), generatorFunction()];
  change(generatorFunction, objects);
  consume("closure, " + name, objects);
}
for (const [name, change] of Object.entries(changes)) {
  const generatorFunction = makeCounter();
  const object = generatorFunction();
  const seen = [];
  for (const value of object) {
    seen.push(value);
    if (value === 1) change(generatorFunction, [object]);
    if (value === 2) break;
  }
  report("during for-of, " + name, seen, drain(object));
}

////= lines-2	frozen
function checkFrozen() {
  const looped = Object.freeze(frozen());
  const seen = [];
  for (const value of looped) seen.push(value);
  report("frozen", [Object.isFrozen(looped)], seen);
  consume("frozen", [frozen(), frozen(), frozen(), frozen()].map(object => Object.freeze(object)));
}
checkFrozen();

function* failing() {
  yield 1;
  throw new Error("from the body");
}
function stepsAfterThrow(generator) {
  const next = generator.next();
  const returned = generator.return("returned");
  return [next.value, next.done, returned.value, returned.done];
}
function checkThrowInForOf() {
  const object = failing();
  const seen = [];
  try {
    for (const value of object) seen.push(value);
  } catch (error) {
    seen.push(error.message);
  }
  report("throw in for-of", seen, stepsAfterThrow(object));
}
checkThrowInForOf();
function checkThrowInSpread() {
  const object = failing();
  const seen = [];
  try {
    seen.push(...object);
  } catch (error) {
    seen.push(error.message);
  }
  report("throw in spread", seen, stepsAfterThrow(object));
}
checkThrowInSpread();
function checkThrowInDestructuring() {
  const object = failing();
  const seen = [];
  try {
    const [first, second] = object;
    seen.push(first, second);
  } catch (error) {
    seen.push(error.message);
  }
  report("throw in destructuring", seen, stepsAfterThrow(object));
}
checkThrowInDestructuring();
function checkThrowInDelegation() {
  const inner = failing();
  const outer = delegateTo(inner);
  const seen = [];
  try {
    for (const value of outer) seen.push(value);
  } catch (error) {
    seen.push(error.message);
  }
  report("throw in yield*", seen, stepsAfterThrow(inner), stepsAfterThrow(outer));
}
checkThrowInDelegation();
function* recovering(inner) {
  try {
    yield* inner;
  } catch (error) {
    yield "caught " + error.message;
  }
  yield "goes on";
}
function checkCaughtThrow() {
  const inner = failing();
  const outer = recovering(inner);
  const seen = [];
  for (const value of outer) seen.push(value);
  report("throw caught around yield*", seen, stepsAfterThrow(inner), stepsAfterThrow(outer));
}
checkCaughtThrow();

function checkUntouched() {
  consume("untouched, created first", createdFirst);
  Bun.gc(true);
  consume("untouched, created last", [untouched(), untouched(), untouched(), untouched()]);
  const seen = [];
  for (const value of untouched()) seen.push(value);
  report("untouched, direct", seen, [...untouched()], [Reflect.ownKeys(untouched.prototype).length]);
}
checkUntouched();

console.log(lines.join("\n"));
//// generator-prototype-fields-read-around-call.ts
// The first call of a generator function after a store to its `prototype` property makes the stored object a prototype. Fields of that object are read before and after the call.
type Point = { x: number; y: number; label: string };
function* steps(): Generator<number> { yield 1; }
async function* asyncSteps(): AsyncGenerator<number> { yield 1; }

function readAroundCall(point: Point): string {
  (steps as any).prototype = point;
  const x = point.x;
  const generator = steps();
  return x + point.y + point.label + " " + (Object.getPrototypeOf(generator) === point);
}

function readAroundAsyncCall(point: Point): string {
  (asyncSteps as any).prototype = point;
  const x = point.x;
  const generator = asyncSteps();
  return x + point.y + point.label + " " + (Object.getPrototypeOf(generator) === point);
}

for (let i = 0; i < 4; i++) {
  console.log(readAroundCall({ x: i + 0.5, y: i * 2, label: "sync" + i }));
  console.log(readAroundAsyncCall({ x: i + 0.25, y: i * 3, label: "async" + i }));
}
//// generator-prototype-mutation.ts
// `next`, `return` and `Symbol.iterator` are replaced on the prototype of a generator function, before and during a loop over its generators: loops, spreads and patterns see it as in plain Bun. Last, a generator whose parameters run code is closed before its first step.
const log: string[] = [];
function takeLog(): string { const text = log.join(","); log.length = 0; return "[" + text + "]"; }
function countdown(limit: number): () => any { let calls = 0; return () => ({ done: ++calls > limit, value: 100 }); }
function* untouched(n: number): Generator<number> { for (let i = 0; i < n; i++) yield i; }
function* gainsMember(n: number): Generator<number> { for (let i = 0; i < n; i++) yield i; }
function* nextReplaced(n: number): Generator<number> { for (let i = 0; i < n; i++) yield i; }
function* returnReplaced(n: number): Generator<number> { try { for (let i = 0; i < n; i++) yield i; } finally { log.push("finally"); } }
function* iteratorReplaced(n: number): Generator<number> { for (let i = 0; i < n; i++) yield i; }
function* replacedInLoop(n: number): Generator<number> { try { for (let i = 0; i < n; i++) yield i; } finally { log.push("finally"); } }
function* prototypeReplaced(n: number): Generator<number> { for (let i = 0; i < n; i++) yield i; }
function* parentReplaced(n: number): Generator<number> { for (let i = 0; i < n; i++) yield i; }
function* changedThroughObject(n: number): Generator<number> { for (let i = 0; i < n; i++) yield i; }
function sumUntouched(n: number): number { let sum = 0; for (const x of untouched(n)) sum += x; return sum; }
function sumGainsMember(n: number): number { let sum = 0; for (const x of gainsMember(n)) sum += x; return sum; }
function sumNextReplaced(n: number): number { let sum = 0; for (const x of nextReplaced(n)) sum += x; return sum; }
function sumIteratorReplaced(n: number): number { let sum = 0; for (const x of iteratorReplaced(n)) sum += x; return sum; }
function sumPrototypeReplaced(n: number): number { let sum = 0; for (const x of prototypeReplaced(n)) sum += x; return sum; }
function sumParentReplaced(n: number): number { let sum = 0; for (const x of parentReplaced(n)) sum += x; return sum; }
function sumChangedThroughObject(n: number): number { let sum = 0; for (const x of changedThroughObject(n)) sum += x; return sum; }
function stopsEarly(n: number): number { let sum = 0; for (const x of returnReplaced(n)) { if (x === 2) break; sum += x; } return sum; }
function replacesInLoop(n: number): number {
  let sum = 0;
  for (const x of replacedInLoop(n)) {
    if (x === 1) { replacedInLoop.prototype.next = countdown(0); replacedInLoop.prototype.return = function (): any { log.push("return set in the loop"); return { done: true, value: undefined }; }; }
    if (x === 3) break;
    sum += x;
  }
  return sum;
}
function sums(): string { return [sumUntouched(4), sumGainsMember(4), sumNextReplaced(4), sumIteratorReplaced(4), sumPrototypeReplaced(4), sumParentReplaced(4), sumChangedThroughObject(4)].join(" "); }
console.log("before: " + sums() + " " + stopsEarly(5) + " " + takeLog());
gainsMember.prototype.doubled = function* (this: Generator<number>): Generator<number> { for (const x of this) yield x * 2; };
console.log("a new member: " + sumGainsMember(4) + " " + [...(gainsMember(3) as any).doubled()].join());
nextReplaced.prototype.next = countdown(2);
console.log("next: " + sumNextReplaced(4) + " " + sumNextReplaced(4) + " [" + [...nextReplaced(3)].join() + "]");
delete nextReplaced.prototype.next;
console.log("next deleted: " + sumNextReplaced(4) + " [" + [...nextReplaced(3)].join() + "]");
returnReplaced.prototype.return = function (value: unknown): any { log.push("own return"); return { done: true, value }; };
console.log("return: " + stopsEarly(5) + " " + takeLog());
const [first, second] = returnReplaced(5);
console.log("return, from a pattern: " + first + " " + second + " " + takeLog());
iteratorReplaced.prototype[Symbol.iterator] = function (): any { return [7, 8][Symbol.iterator](); };
console.log("Symbol.iterator: " + sumIteratorReplaced(4) + " [" + [...iteratorReplaced(4)].join() + "]");
console.log("in the loop: " + replacesInLoop(5) + " " + takeLog() + " " + replacesInLoop(5) + " " + takeLog());
(prototypeReplaced as any).prototype = { next: countdown(1), [Symbol.iterator](): any { return this; } };
console.log("the prototype property: " + sumPrototypeReplaced(4) + " " + sumPrototypeReplaced(4));
Object.setPrototypeOf(parentReplaced.prototype, { next: countdown(3), [Symbol.iterator](): any { return this; } });
console.log("the prototype's prototype: " + sumParentReplaced(4) + " " + sumParentReplaced(4));
Object.getPrototypeOf(changedThroughObject(1)).next = countdown(1);
console.log("through a generator object: " + sumChangedThroughObject(4));
console.log("after: " + sums());
function* startsEagerly(n: number = (log.push("default"), 2)): Generator<number> { try { yield n; } finally { log.push("finally"); } }
const early = startsEagerly();
console.log("return before the first next: " + JSON.stringify(early.return(7)) + " " + JSON.stringify(early.next()) + " " + takeLog());
//// generator-prototype-per-closure.ts
// Every closure of a generator function has its own `prototype` object, whether the generator it creates is stepped, finished, looped over, escapes or is never created.
const sink: unknown[] = [];
function stepped() { function* g() { yield 1; } const it = g(); it.next(); return g; }
function finished() { function* g() { yield 1; } const it = g(); it.next(); it.return(0 as any); return g; }
function looped() { function* g() { yield 1; yield 2; } let sum = 0; for (const x of g()) sum += x; sink.push(sum); return g; }
function escaped() { function* g() { yield 1; } sink.push(g()); return g; }
function neverCalled() { return function* () { yield 1; }; }
function asyncGenerator() { async function* g() { yield 1; } g().next(); return g; }
const makers: [string, () => any][] = [["stepped", stepped], ["finished", finished], ["looped", looped], ["escaped", escaped], ["never called", neverCalled], ["async generator", asyncGenerator]];
for (const [name, make] of makers) {
  const a = make(), b = make();
  const checks = [a !== b, a.prototype !== b.prototype, a() instanceof a, a() instanceof b, b() instanceof b, Object.getPrototypeOf(a()) === a.prototype, Object.getPrototypeOf(a.prototype) === Object.getPrototypeOf(b.prototype)];
  a.prototype.tag = name;
  checks.push(a().tag === name, b().tag === undefined);
  const before = a();
  a.prototype = { replaced: true };
  checks.push(a().replaced === true, b().replaced === undefined, before.replaced === undefined, before.tag === name);
  console.log(name + ": " + checks.join(" "));
}
export {};
