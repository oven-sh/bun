//// stack-traces-through-generator-steps.ts
// which functions a stack trace made inside a generator's body names, for each way of stepping the generator
const lines: string[] = [];
function namesIn(stack: string | undefined): string {
  const names: string[] = [];
  for (const line of (stack ?? "").split("\n")) {
    if (line.endsWith("@[native code]")) continue;
    const found = /^\s*at (?:async )?(?:([^\s(]+) \()?/.exec(line) ?? /^([^@]*)@/.exec(line);
    if (!found) continue;
    const name = found[1] ?? "";
    if (name === "" || name === "module code" || name === "global code") break;
    names.push(name);
  }
  return names.join(" < ");
}
function* body(): Generator<string, void, unknown> {
  yield namesIn(new Error("in the body").stack);
  yield namesIn(new Error("in the body").stack);
}
function* throws(): Generator<string, void, unknown> {
  throw new Error("thrown in the body");
}
function* guarded(): Generator<string, string, unknown> {
  try {
    yield "first";
    return "not reached";
  } catch (error) {
    return "caught: " + namesIn(new Error("in catch").stack);
  } finally {
    lines.push("finally: " + namesIn(new Error("in finally").stack));
  }
}
const kept: any[] = [];
////= lines-21	keep	kept
function byName(iterator: any): unknown {
  return iterator.next().value;
}
function declared(generator: Generator<string, unknown, unknown>): unknown {
  return generator.next().value;
}
function loop(values: Iterable<string>): unknown {
  for (const value of values) return value;
}
function pattern(values: Iterable<string>): unknown {
  const [first] = values;
  return first;
}
function* delegates(inner: Iterable<string>): Generator<string, void, unknown> {
  yield* inner;
}
function spread(values: Iterable<string>): unknown {
  return [...values][0];
}
function returnsByName(iterator: any): unknown {
  iterator.next();
  return iterator.return("asked").value;
}
function throwsByName(iterator: any): unknown {
  iterator.next();
  return iterator.throw(new Error("thrown in")).value;
}
function returnsDeclared(generator: Generator<string, string, unknown>): unknown {
  generator.next();
  return generator.return("asked").value;
}
function throwsDeclared(generator: Generator<string, string, unknown>): unknown {
  generator.next();
  return generator.throw(new Error("thrown in")).value;
}
const ways: [string, (x: any) => unknown][] = [
  ["by name", byName],
  ["declared", declared],
  ["for..of", loop],
  ["pattern", pattern],
  ["spread", spread],
];
for (const [title, run] of ways) lines.push(`${title}: ${run(keep(body()))}`);
lines.push(`yield*, by name: ${byName(keep(delegates(keep(body()))))}`);
lines.push(`yield*, for..of: ${loop(keep(delegates(keep(body()))))}`);
for (const [title, run] of ways) {
  try {
    run(keep(throws()));
  } catch (error) {
    lines.push(`thrown, ${title}: ${namesIn((error as Error).stack)}`);
  }
}
lines.push(`return() by name: ${returnsByName(keep(guarded()))}`);
lines.push(`throw() by name: ${throwsByName(keep(guarded()))}`);
lines.push(`return() declared: ${returnsDeclared(keep(guarded()))}`);
lines.push(`throw() declared: ${throwsDeclared(keep(guarded()))}`);
console.log(lines.join("\n"));
//// state-changed-by-another-task-during-an-await.ts
// An async function or a generator that was started earlier holds an object in its suspended frame and stores to it while the caller waits: what the caller reads behind its own await is the new state.
async function report(name: string, run: () => unknown) {
  let result: string;
  try {
    result = String(await run());
  } catch (error) {
    result = "threw " + (error instanceof Error ? error.name : typeof error);
  }
  console.log(name, result);
}
class Dog {
  legs = 4;
}
const later = (): Promise<void> => new Promise(resolve => setTimeout(resolve, 0));

await report("cleared by an async arrow", async () => {
  const owner: { pet: Dog | null } = { pet: new Dog() };
  const other = (async () => {
    await later();
    owner.pet = null;
  })();
  if (owner.pet === null) return "null";
  await other;
  return owner.pet.legs;
});

async function clearLater(owner: { pet: Dog | null }) {
  await later();
  owner.pet = null;
}
await report("cleared by an async function that takes the object", async () => {
  const owner: { pet: Dog | null } = { pet: new Dog() };
  const other = clearLater(owner);
  const before = owner.pet === null;
  await other;
  return [before, owner.pet === null].join();
});

await report("counted by an async function that is not awaited", async () => {
  const counter = { n: 1 };
  (async () => {
    await null;
    counter.n += 10;
    await null;
    counter.n += 100;
  })();
  const first = counter.n;
  await later();
  return [first, counter.n].join();
});

function* steps(state: { n: number }) {
  state.n += 1;
  yield state.n;
  state.n += 10;
  yield state.n;
}
await report("changed by a generator between two reads", () => {
  const state = { n: 0 };
  const iterator = steps(state);
  const before = state.n;
  iterator.next();
  const between = state.n;
  iterator.next();
  return [before, between, state.n].join();
});

await report("an element stored while the caller waits", async () => {
  const list = [1, 2, 3];
  const other = (async () => {
    await later();
    list[1] = 20;
    list.push(4);
  })();
  const before = list[1] + list.length;
  await other;
  return [before, list[1] + list.length].join();
});
//// steps-by-hand-and-delegations-under-their-own-stores.ts
// An await goes on under the AsyncLocalStorage store that it was reached under, so whoever steps a shared async generator by `await generator.next()` keeps its own store,
// whichever store the generator is resumed under. A loop and `yield*` go on under the store that is active where their step is finished.
import { AsyncLocalStorage } from "node:async_hooks";
const storage = new AsyncLocalStorage<string>();
const lines: string[] = [];
async function* reads(name: string, count: number): AsyncGenerator<string> {
  for (let i = 0; i < count; i++) { await null; yield name + " " + i + " made under " + storage.getStore(); }
}
async function loop(name: string, source: AsyncIterable<string>): Promise<string> {
  for await (const value of source) lines.push(name + " under " + storage.getStore() + ": " + value);
  return name + " ends under " + storage.getStore();
}
async function byHand(name: string, source: AsyncGenerator<string>, awaitsFirst: boolean): Promise<string> {
  if (awaitsFirst) await null;
  for (let step = await source.next(); !step.done; step = await source.next()) lines.push(name + " under " + storage.getStore() + ": " + step.value);
  return name + " ends under " + storage.getStore();
}
async function* delegates(source: AsyncIterable<string>): AsyncGenerator<string> { yield* source; lines.push("delegator ends under " + storage.getStore()); }
async function* stepsByHand(name: string, source: AsyncGenerator<string>): AsyncGenerator<string> {
  for (let step = await source.next(); !step.done; step = await source.next()) yield name + " under " + storage.getStore() + ": " + step.value;
}
for (const awaitsFirst of [false, true]) {
  const shared = reads("by hand " + awaitsFirst, 5);
  lines.push(...(await Promise.all([storage.run("one", () => loop("a", shared)), storage.run("two", () => byHand("b", shared, awaitsFirst))])));
}
for (const awaitsFirst of [false, true]) {
  const shared = reads("both by hand " + awaitsFirst, 5);
  lines.push(...(await Promise.all([storage.run("one", () => byHand("a", shared, awaitsFirst)), storage.run("two", () => byHand("b", shared, awaitsFirst))])));
}
{
  const shared = reads("delegated", 5);
  lines.push(...(await Promise.all([storage.run("one", () => loop("a", delegates(shared))), storage.run("two", () => loop("b", delegates(shared)))])));
}
{
  const shared = reads("delegated, by hand", 5);
  lines.push(...(await Promise.all([storage.run("one", () => byHand("a", delegates(shared), false)), storage.run("two", () => byHand("b", delegates(shared), true))])));
}
{
  const shared = reads("by hand in a generator", 5);
  lines.push(...(await Promise.all([storage.run("one", () => loop("a", stepsByHand("p", shared))), storage.run("two", () => byHand("b", stepsByHand("q", shared), false))])));
}
{
  // Outside of every store, beside a loop under one.
  const shared = reads("outside", 4);
  lines.push(...(await Promise.all([storage.run("one", () => loop("a", shared)), byHand("b", shared, false), byHand("c", shared, true)])));
}
{
  // What is sent in arrives, and the steps of one function stand in their order.
  async function* echoes(): AsyncGenerator<string, void, string> { let got = "nothing"; for (let i = 0; i < 3; i++) got = yield "got " + got + " under " + storage.getStore(); }
  const shared = echoes();
  lines.push(await storage.run("one", async () => { const first = await shared.next("lost"); const second = await shared.next("x"); return first.value + " | " + second.value + " | " + storage.getStore(); }));
  lines.push(await storage.run("two", async () => { const third = await shared.next("y"); const last = await shared.next("z"); return third.value + " | " + last.done + " | " + storage.getStore(); }));
}
console.log(lines.join("\n"));
//// steps-taken-by-loops-in-async-generators.js
// The result object of a step that only a `for await` or a `yield*` takes is the engine's own, and the producer keeps it for its next step. Whoever takes the step gets the value that was
// yielded to it: a loop in an async generator, a `yield*`, two loops that take turns over one generator, and a loop that goes on while another still waits.
async function* inner() { yield { n: 1 }; yield { n: 2 }; return { n: 3 }; }
function* plain() { yield { n: 4 }; yield { n: 5 }; }
async function* delegates() { const last = yield* inner(); yield last; yield* plain(); }
async function* loops() { for await (const each of delegates()) yield each.n; }
async function collect(source) { const all = []; for await (const each of source) all.push(each); return JSON.stringify(all); }
console.log("one loop", await collect(loops()), await collect(delegates()));

async function* shared() { for (let i = 0; i < 6; i++) yield { i }; }
async function* relays(source) { for await (const each of source) { await null; yield each; } }
const one = shared();
console.log("two loops", ...(await Promise.all([collect(one), collect(one)])));
const other = shared();
console.log("two relays", ...(await Promise.all([collect(relays(other)), collect(relays(other))])));

// The value that a loop holds is its own: the next step of the producer does not change it.
async function* holds(source) {
  let before;
  for await (const each of source) {
    if (before) yield [before.i, each.i];
    before = each;
  }
}
console.log("held", await collect(holds(shared())));

// Steps that are asked for by hand get result objects of their own.
const byHand = shared();
const results = [await byHand.next(), await byHand.next()];
for await (const each of byHand) if (each.i === 3) break;
console.log("by hand", JSON.stringify(results), JSON.stringify(await byHand.next()));
//// suspend-and-resume-paths.ts
const collect: (sync: boolean) => void = (globalThis as any).gc ?? (globalThis as any).Bun?.gc ?? (() => undefined);
const tick = Promise.resolve();
const log: string[] = [];

function mix(a: number, b: number): number {
    return (a * 31 + b) % 1000003;
}

type Box = { value: number; name: string };

function box(value: number): Box {
    return { value, name: "b" + value };
}

function names(error: unknown): string {
    const frames: string[] = [];
    for (const line of ((error as Error).stack ?? "").split("\n")) {
        const frame = /^\s*at (async )?(?:(.*?) \()?[^()]*?:(\d+):(\d+)\)?$/.exec(line) ?? /^(async )?(.*?)@.*?:(\d+):(\d+)$/.exec(line);
        if (frame && frame[2] && frame[2] !== "module code" && frame[2] !== "<anonymous>")
            frames.push((frame[1] ?? "") + frame[2]);
    }
    return frames.join(" < ");
}

function* counts(seed: number): Generator<number, number, number> {
    const a = mix(seed, 1);
    const b = mix(a, 2);
    const c = box(mix(b, 3));
    let sent = yield mix(a, b);
    const d = mix(sent, c.value);
    try {
        sent = yield mix(d, a);
        const e = mix(sent, b);
        sent = yield mix(e, d);
        return mix(mix(a, b), mix(mix(c.value, d), mix(e, sent)));
    } catch (error) {
        log.push("caught in counts " + (error as Error).message + " " + mix(a, d));
        return mix(c.value, b);
    } finally {
        log.push("finally in counts " + mix(b, c.value));
    }
}

async function* streams(seed: number): AsyncGenerator<number, number, number> {
    const a = mix(seed, 4);
    const b = box(mix(a, 5));
    await tick;
    const c = mix(b.value, a);
    try {
        let sent = yield mix(a, c);
        const d = mix(sent, b.value);
        await tick;
        sent = yield mix(d, c);
        return mix(mix(a, b.value), mix(c, mix(d, sent)));
    } finally {
        await tick;
        log.push("finally in streams " + mix(a, mix(b.value, c)));
    }
}

async function thrownInto(seed: number, fails: Promise<number>): Promise<number> {
    const a = mix(seed, 6);
    const b = box(mix(a, 7));
    const c = mix(b.value, 8);
    const d = box(mix(c, a));
    try {
        const got = await fails;
        return mix(got, a);
    } catch (error) {
        collect(true);
        return mix(mix(a, b.value), mix(c, d.value)) + (error as Error).message.length;
    }
}

async function thrownThrough(seed: number, fails: Promise<number>): Promise<number> {
    const a = mix(seed, 9);
    const b = box(mix(a, 10));
    const got = await fails;
    return mix(mix(a, b.value), got);
}

async function inner(seed: number): Promise<Error> {
    const a = mix(seed, 11);
    const b = box(mix(a, 12));
    await tick;
    const c = mix(a, b.value);
    const error = new Error("made at " + c);
    log.push("inner keeps " + mix(a, mix(b.value, c)));
    return error;
}

async function outer(seed: number): Promise<string> {
    const a = mix(seed, 13);
    const b = box(mix(a, 14));
    const error = await inner(a);
    collect(true);
    return names(error) + " " + mix(a, b.value);
}

async function cellsAcrossCollections(seed: number): Promise<number> {
    const boxes: Box[] = [];
    const first = box(mix(seed, 15));
    const second = box(mix(first.value, 16));
    const third = box(mix(second.value, 17));
    const fourth = box(mix(third.value, 18));
    const fifth = box(mix(fourth.value, 19));
    const sixth = box(mix(fifth.value, 20));
    const seventh = box(mix(sixth.value, 21));
    for (let i = 0; i < 4; i++) {
        boxes.push(box(mix(i, first.value)));
        collect(true);
        await tick;
        collect(true);
        boxes.push(box(mix(i, seventh.value)));
    }
    let sum = 0;
    for (const each of [first, second, third, fourth, fifth, sixth, seventh, ...boxes])
        sum = mix(sum, each.value + each.name.length);
    return sum;
}

async function main(): Promise<void> {
    const results: (number | string)[] = [];

    const whole = counts(1);
    results.push(whole.next(0).value, whole.next(2).value, whole.next(3).value, whole.next(4).value);
    const thrown = counts(2);
    results.push(thrown.next(0).value, thrown.next(5).value, thrown.throw(new Error("from outside")).value);
    const returned = counts(3);
    results.push(returned.next(0).value, returned.next(6).value, returned.return(77).value, String(returned.next(0).done));

    const stream = streams(4);
    results.push((await stream.next(0)).value, (await stream.next(7)).value, (await stream.next(8)).value);
    const cut = streams(5);
    results.push((await cut.next(0)).value, (await cut.return(88)).value, String((await cut.next(0)).done));
    const broken = streams(6);
    results.push((await broken.next(0)).value);
    try {
        await broken.throw(new Error("into the stream"));
    } catch (error) {
        results.push((error as Error).message);
    }

    results.push(await thrownInto(7, tick.then((): number => { throw new Error("late"); })));
    results.push(await thrownInto(8, Promise.reject(new Error("at once"))));
    try {
        results.push(await thrownThrough(9, tick.then((): number => { throw new RangeError("through"); })));
    } catch (error) {
        results.push((error as Error).name);
    }
    results.push(await outer(10));
    results.push(...await Promise.all([cellsAcrossCollections(11), cellsAcrossCollections(12), outer(13)]));
    console.log(results.join("\n"));
    console.log(log.join("\n"));
}

main();
//// sync-iterables-delegated-to-and-awaited-over.ts
// `yield*` in an async generator and `for await` over what is iterable only synchronously: lists, their iterators, other collections, generators and iterators written by hand.
// Each value is awaited, each step takes its turns of the job queue, and what the consumer sends, throws or returns goes to the wrapper of the iterator.
const lines: string[] = [];
function log(line: string) { lines.push(line); }
////= show
////= ticks
async function turns(count: number) { for (let i = 0; i < count; i++) await null; }
async function drain(name: string, iterable: AsyncIterable<unknown>) {
  try { for await (const value of iterable) log(name + " got " + show(value)); log(name + " ends"); } catch (error) { log(name + " threw " + show(error)); }
}
async function* delegate(name: string, inner: Iterable<unknown>): AsyncGenerator<unknown, unknown, unknown> {
  log(name + " starts");
  try { const result = yield* inner as Iterable<unknown, unknown, unknown>; log(name + " result " + show(result)); return "returned by " + name; } finally { log(name + " finally"); }
}

log("== lists among other jobs");
for (const list of [[], [1], [1, 2, 3]]) { ticks("t" + list.length, 9); await drain("list" + list.length, delegate("d" + list.length, list)); await turns(10); }

log("== what the elements are");
{
  const thenable = { then(resolve: (value: string) => void) { log("then is called"); resolve("from a thenable"); } };
  ticks("e", 14);
  await drain("elements", delegate("d", [Promise.resolve("a promise"), thenable, undefined, null, { plain: 1 }, new Promise(resolve => setTimeout(resolve, 1, "late"))]));
  await drain("rejected", delegate("d", [1, Promise.reject(new Error("second is rejected")), 3]));
  await drain("rejected thenable", delegate("d", [{ then(_: unknown, reject: (reason: Error) => void) { reject(new Error("thenable rejects")); } }, 2]));
}

log("== iterators of lists");
{
  const list = ["a", "b", "c"];
  await drain("values", delegate("d", list.values()));
  await drain("keys", delegate("d", list.keys()));
  await drain("entries", delegate("d", list.entries()));
  const begun = list.values(); begun.next();
  await drain("begun", delegate("d", begun));
  await drain("exhausted", delegate("d", begun));
  log("left " + show(begun.next()));
  const shared = list.values();
  const first = delegate("first", shared), second = delegate("second", shared);
  log(show(await first.next()) + show(await second.next()) + show(await first.next()) + show(await second.next()) + show(await first.next()));
}

log("== other iterables");
{
  function* generator(): Generator<number, string, unknown> { try { const sent = yield 1; log("generator was sent " + show(sent)); yield 2; return "of the generator"; } finally { log("generator finally"); } }
  function list() { return arguments; }
  await drain("typed array", delegate("d", new Uint8Array([7, 8])));
  await drain("iterator of a typed array", delegate("d", new Uint8Array([7, 8]).values()));
  await drain("text", delegate("d", "h\u{1F600}"));
  await drain("set", delegate("d", new Set(["x", "y"])));
  await drain("map", delegate("d", new Map([["k", 1]])));
  await drain("arguments", delegate("d", (list as (...all: number[]) => Iterable<number>)(4, 5)));
  await drain("generator", delegate("d", generator()));
  class Sub extends Array<number> {}
  await drain("subclass", delegate("d", Sub.from([1, 2])));
  class Own extends Array<number> { *[Symbol.iterator](): ArrayIterator<number> { yield 42; } }
  await drain("own iterator method", delegate("d", Own.from([1, 2])));
  const holes = [1, , 3]; Object.defineProperty(holes, 1, { get() { log("getter of an element"); return "got"; } });
  await drain("getter", delegate("d", holes));
  await drain("array-like behind the method of lists", delegate("d", { length: 2, 0: "p", 1: "q", [Symbol.iterator]: Array.prototype.values } as unknown as Iterable<string>));
}

log("== the list changes meanwhile");
{
  const grows = [1, 2];
  for await (const value of delegate("d", grows)) { log("grows " + show(value)); if (grows.length < 4) grows.push(grows.length + 1); }
  const shrinks = [1, 2, 3, 4];
  for await (const value of delegate("d", shrinks)) { log("shrinks " + show(value)); shrinks.length = 2; }
}

log("== sent, thrown, returned");
{
  const sent = delegate("sent", [1, 2]);
  log(show(await sent.next("a")) + show(await sent.next("b")) + show(await sent.next("c")) + show(await sent.next("d")));
  ticks("r", 8);
  const returned = delegate("returned", [1, 2]);
  log(show(await returned.next())); log(show(await returned.return("asked")) + show(await returned.next()));
  const returnedPromise = delegate("returned a promise", [1, 2]);
  await returnedPromise.next(); log(show(await returnedPromise.return(Promise.resolve("asked by a promise"))));
  ticks("w", 8);
  const thrown = delegate("thrown", [1, 2]);
  log(show(await thrown.next()));
  try { log(show(await thrown.throw(new Error("into a list")))); } catch (error) { log("rejected with " + show(error)); }
  log(show(await thrown.next()));
  for await (const value of delegate("left early", [1, 2, 3])) { log("leaves at " + show(value)); break; }
  const byHand = {
    [Symbol.iterator]() { return this; }, i: 0,
    next(value: unknown) { log("next(" + show(value) + ", " + arguments.length + ")"); return { value: this.i, done: this.i++ > 1 }; },
    return(value: unknown) { log("return(" + show(value) + ")"); return { value: "closed", done: true }; },
    throw(error: unknown) { log("throw(" + show(error) + ")"); return { value: "recovered", done: false }; },
  };
  const hand = delegate("by hand", byHand);
  log(show(await hand.next("x")) + show(await hand.next("y")) + show(await hand.throw(new Error("z"))) + show(await hand.return("w")) + show(await hand.next()));
}

log("== an iterator of a list with a `next` of its own");
{
  const own = [5, 6].values(); (own as unknown as { next: unknown }).next = function () { log("own next"); return { done: true, value: "own" }; };
  await drain("own next", delegate("d", own));
  const counted = [5, 6].values(); const original = counted.next; let calls = 0;
  (counted as unknown as { next: unknown }).next = function (this: unknown) { calls++; return original.call(this); };
  await drain("counted", delegate("d", counted));
  log("calls " + calls);
  const none = [5].values(); (none as unknown as { next: unknown }).next = undefined;
  await drain("no next", delegate("d", none));
  const withReturn = [5, 6].values(); (withReturn as unknown as { return: unknown }).return = function (value: unknown) { log("own return(" + show(value) + ")"); return { done: true, value: "closed" }; };
  for await (const value of delegate("left early", withReturn)) { log("leaves at " + show(value)); break; }
  const withThrow = [5, 6].values(); (withThrow as unknown as { throw: unknown }).throw = function (error: unknown) { log("own throw(" + show(error) + ")"); return { done: false, value: "recovered" }; };
  const thrownInto = delegate("thrown into", withThrow);
  log(show(await thrownInto.next()) + show(await thrownInto.throw(new Error("e"))) + show(await thrownInto.next()) + show(await thrownInto.next()));
}

log("== for await");
{
  async function* inGenerator(list: Iterable<unknown>) { for await (const value of list) yield value; }
  ticks("f", 10);
  await drain("in a generator", inGenerator([1, Promise.resolve(2)]));
  await drain("in a generator, rejected", inGenerator([1, Promise.reject(new Error("no")), 3]));
  await drain("in a generator, iterator", inGenerator(["a", "b"].entries()));
  for await (const value of [1, 2].values()) log("in a function " + show(value));
  for await (const value of new Set([Promise.resolve("in a set")])) log("in a function " + show(value));
}

log("== many");
{
  const pending: number[] = [];
  async function* frames(count: number) { for (let i = 0; i < count; i++) { yield* pending; yield* [i]; yield* [i, i].keys(); } }
  let sum = 0;
  for await (const value of frames(3000)) sum += value;
  log("sum " + sum);
}
console.log(lines.join("\n"));
//// the-async-context-follows-awaits-timers-ticks-and-promises.js
// What AsyncLocalStorage.getStore() answers behind every kind of wait, in functions that run side by side under different stores, under none, and under a store entered half way.
const { AsyncLocalStorage, AsyncResource } = require("node:async_hooks");
const first = new AsyncLocalStorage();
const second = new AsyncLocalStorage();
const lines = [];
const seen = where => lines.push(where + " " + String(first.getStore()) + " " + String(second.getStore()));

const later = ms => new Promise(resolve => setTimeout(resolve, ms));
const tick = () => new Promise(resolve => process.nextTick(resolve));
const immediate = () => new Promise(resolve => setImmediate(resolve));
const micro = () => new Promise(resolve => queueMicrotask(resolve));
const thenable = value => ({ then(resolve) { seen("then of a thenable " + value); resolve(value); } });

async function finishesAtOnce(value) {
  return value;
}
async function suspendsOnce(value) {
  await null;
  return value;
}
async function suspendsTwice(name, value) {
  await null;
  seen(name + " inside, after one");
  await undefined;
  seen(name + " inside, after two");
  return value;
}
async function throwsLater(name) {
  await null;
  throw new Error(name);
}
async function* counts(name) {
  seen(name + " generator starts");
  yield 1;
  await null;
  seen(name + " generator goes on");
  yield 2;
}

async function everyWait(name) {
  seen(name + " start");
  await 1;
  seen(name + " number");
  await finishesAtOnce(1);
  seen(name + " call that finishes at once");
  await suspendsOnce(1);
  seen(name + " call that suspends");
  await suspendsTwice(name, 1);
  seen(name + " call that suspends twice");
  await Promise.resolve(1);
  seen(name + " settled promise");
  await micro();
  seen(name + " microtask");
  await tick();
  seen(name + " tick");
  await later(1);
  seen(name + " timer");
  await immediate();
  seen(name + " immediate");
  await thenable(name);
  seen(name + " thenable");
  await Promise.all([suspendsOnce(1), later(1), 2, finishesAtOnce(3)]);
  seen(name + " all");
  await Promise.race([later(1), later(2)]);
  seen(name + " race");
  try {
    await throwsLater(name);
  } catch {
    seen(name + " caught");
  }
  for await (const count of counts(name)) seen(name + " step " + count);
  await suspendsOnce(1).then(() => seen(name + " then"));
  seen(name + " after then");
  await suspendsOnce(1).finally(() => seen(name + " finally"));
  seen(name + " end");
}

// The promise is made under one store, awaited under a second and resolved under a third.
async function awaitsWhatOthersResolve() {
  let resolve;
  const promise = first.run("maker", () => new Promise(r => (resolve = r)));
  const waiting = first.run("waiter", async () => {
    await promise;
    seen("resolved by another");
    await suspendsOnce(1);
    seen("resolved by another, one wait on");
  });
  first.run("resolver", () => resolve(1));
  await waiting;
  seen("behind the waiter");
}

// A store that is entered half way holds for the rest of the function and for what it starts, and ends with the job for everybody else.
async function entersHalfWay() {
  await null;
  seen("before enterWith");
  first.enterWith("entered");
  seen("after enterWith");
  await suspendsOnce(1);
  seen("after enterWith, one wait on");
  const inner = suspendsTwice("started after enterWith", 1);
  first.enterWith("entered again");
  await inner;
  seen("after the second enterWith");
}
async function runsBesideIt() {
  for (let i = 0; i < 6; i++) {
    await null;
    seen("beside " + i);
  }
}

async function leavesAndBinds() {
  await first.run("outer", async () => {
    await null;
    first.exit(() => seen("exit"));
    await first.exit(async () => {
      await null;
      seen("exit, one wait on");
    });
    seen("behind exit");
    const bound = AsyncLocalStorage.bind(() => seen("bound"));
    const snapshot = AsyncLocalStorage.snapshot();
    const resource = new AsyncResource("test");
    await second.run("other", async () => {
      await first.run("inner", async () => {
        await null;
        bound();
        snapshot(() => seen("snapshot"));
        resource.runInAsyncScope(() => seen("resource"));
        seen("behind the three");
      });
      seen("behind inner");
    });
    seen("behind other");
  });
  seen("behind outer");
}

async function main() {
  seen("nothing entered yet");
  await everyWait("none");
  const before = lines.length;
  await Promise.all([
    first.run("a", () => everyWait("a")),
    everyWait("beside"),
    first.run("b", () => second.run("c", () => everyWait("bc"))),
    second.run("d", () => everyWait("d")),
  ]);
  // Whether the timer of one comes due in front of the immediate of another is the clock's to say, so the lines of the four are printed function by function.
  const sideBySide = lines.splice(before);
  for (const name of ["a", "beside", "bc", "d"]) lines.push(...sideBySide.filter(line => line.startsWith(name + " ") || line.startsWith("then of a thenable " + name + " ")));
  seen("behind all four");
  await awaitsWhatOthersResolve();
  await Promise.all([entersHalfWay(), runsBesideIt()]);
  seen("behind enterWith");
  await leavesAndBinds();
  first.disable();
  await first.run("again", () => suspendsTwice("after disable", 1));
  seen("end");
}
main().then(() => console.log(lines.join("\n")));
