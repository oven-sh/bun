//// next-requests-while-pending.ts
// next() written out on async generators that wait for something before they yield: who awaits the promise that next() handed back:
// an async function, an async generator, a then() callback, two of them, nobody yet, nobody ever; one request at a time and several at once;
// numbers, records and thenables yielded; the step objects are kept and compared: each step is an object of its own.
let log: string[] = [];
////= note-2
const thenable = { then(resolve: (value: string) => void): void { note("then is called"); resolve("from then"); } };
type Source = AsyncGenerator<unknown, unknown>;
const sources: [string, () => Source][] = [
    ["numbers", async function* () { for (let i = 0; i < 3; i++) { await outside(); note("yields " + i); yield i; } return "over"; }],
    ["records", async function* () { for (let i = 0; i < 3; i++) { await outside(); note("yields " + i); yield { n: i }; } return { last: true }; }],
    ["a thenable among them", async function* () { await outside(); yield 1; await outside(); yield thenable; await outside(); yield 3; }],
    ["two yields a wait", async function* () { for (let i = 0; i < 2; i++) { await outside(); yield "a" + i; yield "b" + i; } }],
    ["no wait", async function* () { yield 1; yield 2; }],
    ["a job queued ahead of the yield", async function* () { for (let i = 0; i < 2; i++) { await outside(); Promise.resolve().then(() => note("the source's job " + i)); yield i; } }],
    ["it throws", async function* () { await outside(); yield 1; await outside(); throw new Error("thrown by the source"); }],
    ["through yield*", async function* () { yield* (async function* () { await outside(); yield "inner"; await outside(); return "inner is over"; })(); yield "outer"; }],
];
function show(step: IteratorResult<unknown, unknown>): string {
    return (step.done ? "done " : "step ") + JSON.stringify(step.value) + " " + Object.keys(step).join(",");
}
const kept: object[] = [];
function keep(step: IteratorResult<unknown, unknown>): IteratorResult<unknown, unknown> {
    if (kept.includes(step)) note("THE SAME OBJECT TWICE");
    kept.push(step);
    return step;
}
async function byFunction(source: Source): Promise<void> {
    try {
        for (;;) { const step = keep(await source.next()); note(show(step)); if (step.done) return; }
    } catch (error) {
        note("caught " + (error as Error).message);
    }
}
async function* byGenerator(source: Source): AsyncGenerator<string> {
    try {
        for (;;) { const step = keep(await source.next()); yield show(step); if (step.done) return; }
    } catch (error) {
        yield "caught " + (error as Error).message;
    }
}
async function* relayed(source: Source): AsyncGenerator<unknown, unknown> {
    async function pulled(): Promise<IteratorResult<unknown, unknown>> {
        try { return await source.next(); } catch (error) { note("pulled caught"); throw error; }
    }
    while (true) {
        const step = keep(await pulled());
        if (step.done === true) return step.value;
        yield step.value;
    }
}
function byThen(source: Source): Promise<void> {
    return new Promise(resolve => {
        const pull = (): void => { source.next().then(step => { note(show(keep(step))); if (step.done) resolve(); else pull(); }, error => { note("then caught " + error.message); resolve(); }); };
        pull();
    });
}
async function collect(source: AsyncIterable<unknown>): Promise<void> {
    try {
        for await (const x of source) note("got " + JSON.stringify(x));
    } catch (error) {
        note("caught " + (error as Error).message);
    }
}
async function severalAtOnce(source: Source): Promise<void> {
    const steps = await Promise.allSettled([source.next(), source.next(), source.next(), source.next(), source.next()]);
    for (const step of steps) note(step.status === "fulfilled" ? show(keep(step.value)) : "rejected " + step.reason.message);
}
async function awaitedLater(source: Source): Promise<void> {
    const first = source.next();
    for (let i = 0; i < 6; i++) await outside();
    note("now awaited");
    try { note(show(keep(await first))); } catch (error) { note("caught " + (error as Error).message); }
    await byFunction(source);
}
async function awaitedByTwo(source: Source): Promise<void> {
    const first = source.next();
    const both = await Promise.allSettled([(async () => show(await first))(), (async () => show(await first))()]);
    for (const one of both) note(one.status === "fulfilled" ? one.value : "rejected");
    note("one object for both: " + ((await first) === (await first)));
    await byFunction(source);
}
async function neverAwaited(source: Source): Promise<void> {
    source.next().catch(() => undefined); source.next().catch(() => undefined);
    for (let i = 0; i < 8; i++) await outside();
    await byFunction(source);
}
async function* yieldsWhatNextHandsBack(source: Source): AsyncGenerator<IteratorResult<unknown, unknown>> {
    for (let i = 0; i < 5; i++) yield source.next();
}
async function* returnsWhatNextHandsBack(source: Source): AsyncGenerator<never, IteratorResult<unknown, unknown>> {
    return source.next();
}
async function yielded(source: Source): Promise<void> {
    try {
        for await (const step of yieldsWhatNextHandsBack(source)) note(show(keep(step)));
    } catch (error) {
        note("caught " + (error as Error).message);
    }
}
async function returned(source: Source): Promise<void> {
    try {
        const last = await returnsWhatNextHandsBack(source).next();
        note("returned " + last.done + " " + show(keep(last.value)));
    } catch (error) {
        note("caught " + (error as Error).message);
    }
    await byFunction(source);
}
const ways: [string, (source: Source) => Promise<void>][] = [
    ["the promise is yielded", yielded],
    ["the promise is returned", returned],
    ["an async function awaits", byFunction],
    ["an async generator awaits", source => collect(byGenerator(source))],
    ["relayed", source => collect(relayed(source))],
    ["relayed twice", source => collect(relayed(relayed(source)))],
    ["then", byThen],
    ["several at once", severalAtOnce],
    ["awaited later", awaitedLater],
    ["awaited by two", awaitedByTwo],
    ["never awaited", neverAwaited],
];
const lines: string[] = [];
async function scene(title: string, run: () => Promise<unknown>): Promise<void> {
    log = []; kept.length = 0;
    await run();
    lines.push(title + ": " + log.join(" | "));
}
for (const [way, go] of ways) {
    for (const [kind, make] of sources) {
        await scene(way + ", " + kind + ", alone", () => go(make()));
        await scene(way + ", " + kind + ", beside jobs", () => Promise.all([ticker("t", 20), go(make())]));
        await scene(way + ", " + kind + ", two at once", () => Promise.all([go(make()), go(make())]));
    }
}
console.log(lines.join("\n"));
//// object-literal-in-generator-frame.ts
// A generator that suspends in very many places keeps what lives across a suspension in its frame. An object literal that lives on is saved there when it is whole: behind the last of its first stores, though what those store is fetched out of the frame between them. The record also admits objects from elsewhere, so a store by its layout is only right while nobody else can have the object.
type Options = { first: unknown; second: unknown; third: unknown };
declare function give(): Options;
(globalThis as any).give = () => JSON.parse('{"first":1,"second":2,"third":"from outside"}');
function outside(): Options { const given: Options = give(); return given; }
const readers: (() => unknown)[] = [];
function* run(seed: number, given: unknown[]): Generator<number, string, number> {
  let total = seed;
  const one = given[0], two = given[1], three = given[2];
  total += yield total; total += yield total; total += yield total; total += yield total; total += yield total; total += yield total;
  total += yield total; total += yield total; total += yield total; total += yield total; total += yield total; total += yield total;
  total += yield total; total += yield total; total += yield total; total += yield total; total += yield total; total += yield total;
  total += yield total; total += yield total; total += yield total; total += yield total; total += yield total; total += yield total;
  total += yield total; total += yield total; total += yield total; total += yield total; total += yield total; total += yield total;
  total += yield total; total += yield total; total += yield total; total += yield total; total += yield total; total += yield total;
  const options: Options = { first: one, second: two, third: three };
  readers.push(() => options.first);
  total += yield total;
  return options.first + ":" + options.second + ":" + options.third + ":" + outside().third + ":" + total;
}
function drive(seed: number, given: unknown[]): string {
  const running = run(seed, given);
  let step = running.next(0);
  while (!step.done) step = running.next(1);
  return step.value;
}
console.log(drive(1, [1, "b", true]), drive(2, [null, undefined, 2.5]), readers.length, readers[0](), readers[1]());
//// one-throw-through-many-generator-frames.ts
// Three thousand generators, each stepping the next, and the innermost one throws: one error passes through three thousand frames, far from the end of the stack. It arrives as the value that was
// thrown, every finally runs, innermost first, every generator is completed afterwards, and the function that catches it finds its own values as they were. The same for frames that have been
// suspended before and are resumed for the throw, for throw() and return() sent in from outside, and for async generators. Beside each chain that throws stands the same chain that returns, so that
// the times behind the lines, which are not compared, tell the cost of the throw from the cost of making and stepping the generators.
// The program counts the entries of the two operations behind the creation of a generator, which only the jsc shell can.
declare const aotOperationCount: undefined | ((name: string) => number);
const counted = typeof aotOperationCount === "function" ? aotOperationCount : null;
////= lines-20	entries	"operationAOTNewGenerator"	"operationAOTSaveFrameAndYield"
const lines: string[] = [];
const frames = 3_000;
const rounds = 2;
type Numbers = Generator<number, number, unknown>;
type NumbersLater = AsyncGenerator<number, number, unknown>;
class Failure extends Error {
  constructor(readonly code: number) {
    super("failure " + code);
  }
}

let state = 20261019;
function draw(): number {
  state = (state * 48271) % 2147483647;
  return state % 1000;
}
let made = 0;
let cleaned = 0;
let lastCleaned = -1;
let outOfOrder = 0;
let isThrowing = false;
let thrownValue: unknown = undefined;
function bottom(): number {
  if (isThrowing) throw thrownValue;
  return 0;
}
function cleanUp(depth: number): void {
  cleaned++;
  if (depth !== lastCleaned + 1) outOfOrder++;
  lastCleaned = depth;
}
////= last
function describe(value: unknown): string {
  if (value instanceof Error) return value.name + " (" + value.message + ")";
  return typeof value + " " + String(value);
}

function* byNext(depth: number): Numbers {
  made++;
  if (!depth) return bottom();
  return byNext(depth - 1).next().value + 1;
}
function* byYieldStar(depth: number): Numbers {
  made++;
  if (!depth) return bottom();
  return (yield* byYieldStar(depth - 1)) + 1;
}
function* byForOf(depth: number): Numbers {
  made++;
  if (!depth) return bottom();
  for (const value of byForOf(depth - 1)) yield value;
  return depth;
}
function* bySpread(depth: number): Numbers {
  made++;
  if (!depth) return bottom();
  return [...bySpread(depth - 1)].length + depth;
}
function stepsTheNext(depth: number): number {
  return last(throughPlainFunctions(depth)) + 1;
}
function* throughPlainFunctions(depth: number): Numbers {
  made++;
  if (!depth) return bottom();
  return stepsTheNext(depth - 1) + 1;
}
class Walker {
  constructor(readonly step: number) {}
  *walk(depth: number): Numbers {
    made++;
    if (!depth) return bottom();
    return (yield* this.walk(depth - 1)) + this.step;
  }
}
const walker = new Walker(2);
function* keepsValues(depth: number): Numbers {
  made++;
  if (!depth) return bottom();
  const a = depth + 1, b = depth * 0.5, c = "c" + (depth % 10), d = [depth];
  const below = keepsValues(depth - 1).next().value;
  return (below + a + b + c.length + d.length) % 1009;
}
////= lines-38	hasAFinally	(yield* hasAFinally(depth - 1))
////= lines-38	hasAFinallyAroundNext	hasAFinallyAroundNext(depth - 1).next().value
function* catchesAndRethrows(depth: number): Numbers {
  made++;
  try {
    if (!depth) return bottom();
    return catchesAndRethrows(depth - 1).next().value + 1;
  } catch (error) {
    cleanUp(depth);
    throw error;
  }
}
function* everyTenthHasAFinally(depth: number): Numbers {
  made++;
  if (!depth) return bottom();
  if (depth % 10) return (yield* everyTenthHasAFinally(depth - 1)) + 1;
  try {
    return (yield* everyTenthHasAFinally(depth - 1)) + 1;
  } finally {
    cleaned++;
  }
}

// The function that catches holds values of its own across the whole descent.
function catches(start: (depth: number) => Numbers, depth: number): string {
  const a = draw(), b = draw(), c = draw(), d = draw() / 8, e = "e" + draw(), f = { n: draw() }, g = draw(), h = draw() / 16;
  const before = [a, b, c, d, e, f.n, g, h].join();
  let outcome: string;
  try {
    outcome = "returned " + last(start(depth));
  } catch (error) {
    outcome = "caught " + describe(error) + (error === thrownValue ? "" : ", WHICH IS NOT WHAT WAS THROWN");
  }
  const after = [a, b, c, d, e, f.n, g, h].join();
  return before === after ? outcome : outcome + ", THE VALUES OF THE CATCHER CHANGED FROM " + before + " TO " + after;
}
const endings: [ending: string, make: (() => unknown) | null][] = [
  ["returns", null],
  ["throws an error", () => new Failure(1)],
  ["throws a string", () => "a string"],
  ["throws undefined", () => undefined],
];
function reset(make: (() => unknown) | null): void {
  isThrowing = make !== null;
  thrownValue = make ? make() : undefined;
  lastCleaned = -1;
}
function counts(entriesBefore: number, start: number): string {
  const inRuntime = entries() - entriesBefore;
  const elapsed = Math.round(performance.now() - start);
  return made + " generators" + (cleaned ? ", " + cleaned + " cleaned up, " + outOfOrder + " out of order" : "") + ", " + (inRuntime < 5 + made / 20 ? "few entries" : inRuntime + " ENTRIES") + " " + elapsed + "ms";
}
function clearCounts(): void {
  made = 0;
  cleaned = 0;
  outOfOrder = 0;
}
function measure(label: string, depth: number, start: (depth: number) => Numbers, numberOfEndings: number = 2): void {
  for (const [ending, make] of endings.slice(0, numberOfEndings)) {
    clearCounts();
    const entriesBefore = entries();
    const begin = performance.now();
    const outcomes = new Set<string>();
    for (let round = 0; round < rounds; round++) {
      reset(make);
      outcomes.add(catches(start, depth));
    }
    lines.push(label + ", the innermost " + ending + ": " + [...outcomes].join(" / ") + ", " + counts(entriesBefore, begin));
  }
}

// Every frame of these chains is suspended once, by a yield of the innermost generator, before the step that ends the chain.
function* yieldsFirst(depth: number): Numbers {
  made++;
  if (!depth) {
    yield 0;
    return bottom();
  }
  return (yield* yieldsFirst(depth - 1)) + 1;
}
function* yieldsFirstInATry(depth: number): Numbers {
  made++;
  try {
    if (!depth) {
      yield 0;
      return bottom();
    }
    return (yield* yieldsFirstInATry(depth - 1)) + 1;
  } finally {
    cleanUp(depth);
  }
}
function* yieldsFirstThroughForOf(depth: number): Numbers {
  made++;
  if (!depth) {
    yield 0;
    return bottom();
  }
  for (const value of yieldsFirstThroughForOf(depth - 1)) yield value;
  return depth;
}
function show(step: IteratorResult<number, number>): string {
  return (step.done ? "returned " : "yielded ") + step.value;
}
function attempt(run: () => IteratorResult<number, number>): string {
  const a = draw(), b = draw(), c = draw() / 8, d = "d" + draw();
  const before = [a, b, c, d].join();
  let outcome: string;
  try {
    outcome = show(run());
  } catch (error) {
    outcome = "caught " + describe(error) + (error === thrownValue ? "" : ", WHICH IS NOT WHAT WAS THROWN");
  }
  return before === [a, b, c, d].join() ? outcome : outcome + ", THE VALUES OF THE CATCHER CHANGED";
}
function measureSuspended(label: string, start: (depth: number) => Numbers): void {
  const ways: [way: string, make: (() => unknown) | null, end: (generator: Numbers) => IteratorResult<number, number>][] = [
    ["is resumed and returns", null, generator => generator.next()],
    ["is resumed and throws", () => new Failure(2), generator => generator.next()],
    ["gets throw() from outside", () => new Failure(3), generator => generator.throw(thrownValue)],
    ["gets throw() of a string from outside", () => "a string", generator => generator.throw(thrownValue)],
    ["gets return() from outside", null, generator => generator.return(-5)],
  ];
  for (const [way, make, end] of ways) {
    clearCounts();
    const entriesBefore = entries();
    const begin = performance.now();
    const outcomes = new Set<string>();
    for (let round = 0; round < rounds; round++) {
      reset(make);
      const generator = start(frames);
      outcomes.add(show(generator.next()) + ", then " + attempt(() => end(generator)) + ", then " + show(generator.next()));
    }
    lines.push(label + ", the innermost " + way + ": " + [...outcomes].join(" / ") + ", " + counts(entriesBefore, begin));
  }
}

const kept: Numbers[] = [];
function* keepsSome(depth: number): Numbers {
  made++;
  if (!depth) return bottom();
  const inner = keepsSome(depth - 1);
  if (depth % 500 === 1) kept.push(inner);
  return inner.next().value + 1;
}
// A generator in the middle catches, and the frames above it go on as if nothing had happened.
function* oneCatches(depth: number, catcher: number): Numbers {
  made++;
  if (!depth) return bottom();
  if (depth !== catcher) return (yield* oneCatches(depth - 1, catcher)) + 1;
  try {
    return (yield* oneCatches(depth - 1, catcher)) + 1;
  } catch (error) {
    return error === thrownValue ? -1000 : -2000;
  }
}

async function* laterByForAwait(depth: number): NumbersLater {
  made++;
  try {
    if (!depth) return bottom();
    for await (const value of laterByForAwait(depth - 1)) yield value;
    return depth;
  } finally {
    cleanUp(depth);
  }
}
async function* laterByYieldStar(depth: number): NumbersLater {
  made++;
  if (!depth) return bottom();
  return (yield* laterByYieldStar(depth - 1)) + 1;
}
async function* laterBehindAnAwait(depth: number): NumbersLater {
  made++;
  if (!depth) {
    await null;
    return bottom();
  }
  return (await laterBehindAnAwait(depth - 1).next()).value + 1;
}
async function measureLater(label: string, depth: number, start: (depth: number) => NumbersLater): Promise<void> {
  for (const [ending, make] of endings) {
    clearCounts();
    const entriesBefore = entries();
    const begin = performance.now();
    const outcomes = new Set<string>();
    for (let round = 0; round < rounds; round++) {
      reset(make);
      const a = draw(), b = draw() / 8, c = "c" + draw();
      const before = [a, b, c].join();
      const stream = start(depth);
      let outcome: string;
      try {
        let step = await stream.next();
        while (!step.done) step = await stream.next();
        outcome = "returned " + step.value;
      } catch (error) {
        outcome = "caught " + describe(error) + (error === thrownValue ? "" : ", WHICH IS NOT WHAT WAS THROWN");
      }
      const after = await stream.next();
      outcomes.add(outcome + ", then " + after.done + " " + after.value + (before === [a, b, c].join() ? "" : ", THE VALUES OF THE CATCHER CHANGED"));
    }
    lines.push(label + ", the innermost " + ending + ": " + [...outcomes].join(" / ") + ", " + counts(entriesBefore, begin));
  }
}

lines.push("== frames that are entered for the first time");
measure("next()", frames, byNext, endings.length);
measure("yield*", frames, byYieldStar, endings.length);
measure("for-of", frames, byForOf);
measure("a spread, 300 frames", 300, bySpread);
measure("a plain function between the generators", frames, throughPlainFunctions);
measure("a method", frames, depth => walker.walk(depth));
measure("values that are used behind the step", frames, keepsValues);
measure("a finally in every frame, yield*", frames, hasAFinally);
measure("a finally in every frame, next()", frames, hasAFinallyAroundNext);
measure("a catch that throws again in every frame", frames, catchesAndRethrows);
measure("a finally in every tenth frame", frames, everyTenthHasAFinally);
for (const depth of [0, 1, 2, 3, 10, 100]) measure(depth + " frames above the innermost", depth, hasAFinally, endings.length);
lines.push("== frames that have been suspended");
measureSuspended("yield*", yieldsFirst);
measureSuspended("yield* in a try", yieldsFirstInATry);
measureSuspended("for-of", yieldsFirstThroughForOf);
lines.push("== afterwards");
clearCounts();
reset(() => new Failure(4));
kept.length = 0;
lines.push("some of the generators are kept: " + catches(keepsSome, frames) + ", then " + kept.map(generator => show(generator.next())).join(", "));
for (const catcher of [1, 2, 1_500, frames - 1, frames]) {
  reset(() => new Failure(5));
  lines.push("the generator " + catcher + " above the innermost catches: " + catches(depth => oneCatches(depth, catcher), frames));
}
lines.push("== async generators, 500 frames");
await measureLater("for await in a try", 500, laterByForAwait);
await measureLater("yield*", 500, laterByYieldStar);
await measureLater("next(), the innermost behind an await", 500, laterBehindAnAwait);
console.log(lines.join("\n"));

export {};
//// only-async-functions-are-async-frames.js
// Only async functions wait, so only they are async frames of an error that native code creates. A plain function between two of them has handed on the promise and returned.
const { promises } = require("node:fs");
const missing = "/nonexistent-path/does-not-exist.txt";
const framesOf = error => JSON.stringify((error.stack ?? "").split("\n").slice(1).map(line => line.trim().replace(/\(.*[\\\/]/, "(")));
async function innermost() { return await promises.readFile(missing); }
function handsOn() { return innermost(); }
const arrowHandsOn = () => handsOn();
async function throughPlainFunctions() { return await arrowHandsOn(); }
async function inLoop() {
  let last;
  for (let i = 0; i < 3; i++) {
    try { last = await arrowHandsOn(); } catch (error) { last = error; }
  }
  throw last;
}
async function inTryFinally() {
  let finished = 0;
  try { return await handsOn(); } finally { finished++; await null; }
}
async function awaitsTwice() {
  await null;
  const first = handsOn();
  await null;
  return await first;
}
const asyncArrow = async () => await handsOn();
async function throughAsyncArrow() { return await asyncArrow(); }
class Reader {
  read() { return innermost(); }
  async readAll() { return await this.read(); }
  static async open() { return await new Reader().readAll(); }
}
async function* generates() { yield await handsOn(); }
async function throughGenerator() { for await (const value of generates()) return value; }
async function report(name, run) {
  try { await run(); console.log(name, "fulfilled"); } catch (error) { console.log(name, framesOf(error)); }
}
async function main() {
  for (const limit of [2, 10]) {
    Error.stackTraceLimit = limit;
    await report("plain functions " + limit, throughPlainFunctions);
    await report("an arrow handed in " + limit, () => throughPlainFunctions());
    await report("in a loop " + limit, inLoop);
    await report("try and finally " + limit, inTryFinally);
    await report("awaits twice " + limit, awaitsTwice);
    await report("an async arrow " + limit, throughAsyncArrow);
    await report("methods " + limit, Reader.open);
    await report("an async generator " + limit, throughGenerator);
  }
}
main();
//// pending-request-handler-keeps-alive.ts
// A request handler that waits keeps alive only what it and its listeners still refer to: the body it has read is collected while its timer, its event listener and its abort listener stay.
// "an event listener" says what plain Bun says too: `body` is stored to by a closure, so it lies in the one environment of the scope, which the listener holds for `events`: the second buffer
// stays. The stored output may get better one day.
let round = 0;
let made = 0;
let collected = 0;
const registry = new FinalizationRegistry<number>(madeIn => {
  if (madeIn === round) collected++;
});
function watch<T extends object>(value: T): T {
  made++;
  registry.register(value, round);
  return value;
}
function once(f: () => number): number {
  return f();
}
let total = 0;
let release: () => void = () => {};
let parked: Promise<void> = Promise.resolve();
const timers: ReturnType<typeof setInterval>[] = [];
const target = new EventTarget();
let controller = new AbortController();

async function withAnAbortListener(request: Request) {
  const body = watch(await request.arrayBuffer());
  let state = 0;
  controller.signal.addEventListener("abort", () => {
    state++;
  });
  total += once(() => body.byteLength);
  await parked;
  return state;
}
async function withAnInterval(request: Request) {
  const body = watch(await request.arrayBuffer());
  let ticks = 0;
  timers.push(setInterval(() => {
    ticks++;
  }, 1000));
  total += once(() => body.byteLength);
  await parked;
  return ticks;
}
async function withAnEventListener(request: Request) {
  let body = watch(await request.arrayBuffer());
  let events = 0;
  target.addEventListener("ping", () => {
    events++;
  });
  total += once(() => {
    const length = body.byteLength;
    body = watch(new ArrayBuffer(8));
    return length;
  });
  await parked;
  return events;
}
async function withAResponse(request: Request) {
  const response = watch(new Response(await request.arrayBuffer()));
  let status = 0;
  const finish = () => ++status;
  total += once(() => response.status);
  await parked;
  return finish();
}
function notAsync(request: Request) {
  const copy = watch(request.clone());
  let calls = 0;
  total += once(() => copy.url.length);
  target.addEventListener("ping", () => {
    calls++;
  });
  return parked.then(() => calls);
}

async function judge(name: string, handler: (request: Request) => Promise<number>) {
  round++;
  made = collected = 0;
  controller = new AbortController();
  parked = new Promise<void>(resolve => {
    release = resolve;
  });
  const results: Promise<number>[] = [];
  for (let i = 0; i < 16; i++) results.push(handler(new Request("http://localhost/", { method: "POST", body: new Uint8Array(1024) })));
  for (let i = 0; i < 4; i++) {
    await Bun.sleep(1);
    Bun.gc(true);
  }
  await Bun.sleep(1);
  const verdict = collected * 4 >= made * 3 ? "collected" : collected * 4 <= made ? "kept" : collected + " of " + made;
  controller.abort();
  target.dispatchEvent(new Event("ping"));
  release();
  let sum = 0;
  for (const result of results) sum += await result;
  for (const timer of timers.splice(0)) clearInterval(timer);
  console.log(name + ": " + verdict + ", " + sum);
}

await judge("an abort listener", withAnAbortListener);
await judge("an interval", withAnInterval);
await judge("an event listener", withAnEventListener);
await judge("a response", withAResponse);
await judge("not async", notAsync);
console.log(total);
//// promise-all-and-who-waits-for-a-settled-promise.ts
// Promise.all over async calls, promises and plain values, and what happens when a promise is settled by a job: whoever waits for it, a coroutine, a handler or nobody, gets its turn in its place.
import { AsyncLocalStorage } from "node:async_hooks";

const lines: string[] = [];
function log(line: string) { lines.push(line); }
////= show
////= ticks
async function turns(count: number) { for (let i = 0; i < count; i++) await null; }
async function after<T>(count: number, value: T): Promise<T> { await turns(count); log("ready " + show(value)); return value; }
async function failsAfter(count: number, message: string): Promise<never> { await turns(count); log("fails " + message); throw new Error(message); }

log("== all of async calls");
{
  ticks("a", 8);
  log(show(await Promise.all([after(1, 1), after(3, 2), after(2, 3)])));
  log(show(await Promise.all([after(0, "x")])));
  log(show(await Promise.all([])));
  const [first, second] = await Promise.all([after(2, { a: 1 }), after(1, [1, 2])]);
  log(show(first) + " " + show(second));
}
log("== all of everything");
{
  ticks("b", 8);
  const thenable = { then(resolve: (value: string) => void) { log("then of the thenable"); resolve("thenable"); } };
  const mixed = await Promise.all([1, "two", null, undefined, Promise.resolve(5), after(2, 6), thenable, new Promise(resolve => setTimeout(resolve, 1, "timer")), Promise.resolve().then(() => "handler"), { plain: true }]);
  log(show(mixed) + " " + Array.isArray(mixed) + " " + mixed.length);
}
log("== one fails");
{
  ticks("c", 8);
  for (const make of [
    () => [after(1, 1), failsAfter(2, "second"), after(3, 3)],
    () => [failsAfter(0, "first"), after(1, 2)],
    () => [after(1, 1), after(1, 2), failsAfter(1, "last")],
    () => [failsAfter(1, "one"), failsAfter(1, "other")],
    () => [Promise.reject(new Error("rejected already")), after(1, 1)],
  ]) {
    try { log(show(await Promise.all(make()))); } catch (error) { log("caught " + show(error)); }
    await turns(4);
  }
}
log("== who waits for the promise of all");
{
  const all = Promise.all([after(1, 1), after(2, 2)]);
  all.then(value => log("a handler " + show(value)));
  (async () => log("a coroutine " + show(await all)))();
  all.then(value => log("another handler " + show(value)));
  await turns(6);
  const alone = Promise.all([after(1, 3)]);
  (async () => log("a coroutine alone " + show(await alone)))();
  await turns(5);
  const handled = Promise.all([after(1, 4)]);
  handled.then(value => log("a handler alone " + show(value)));
  await turns(5);
  const unwatched = Promise.all([after(1, 5)]);
  await turns(5);
  log("nobody waited: " + show(await unwatched));
  async function* yieldsAll() { yield await Promise.all([after(1, 6)]); yield Promise.all([after(1, 7)]); }
  for await (const value of yieldsAll()) log("a generator " + show(value));
}
log("== who waits for what a handler settles");
{
  ticks("d", 10);
  log("awaited " + (await Promise.resolve(1).then(value => value + 1)));
  log("awaited behind two " + (await Promise.resolve(1).then(value => value + 1).then(value => value + 1)));
  log("awaited a catch " + (await Promise.reject(1).catch(reason => (reason as number) + 1)));
  async function* inGenerator() { const got = await Promise.resolve("g").then(value => value + "!"); yield got; yield Promise.resolve("h").then(value => value + "!"); }
  for await (const value of inGenerator()) log("in a generator " + value);
  const shared = Promise.resolve("s").then(value => value + "!");
  const waiting = [1, 2, 3].map(async n => log("waiter " + n + " " + (await shared)));
  await Promise.all(waiting);
  let settle!: (value: string) => void;
  const deferred = new Promise<string>(resolve => { settle = resolve; });
  (async () => log("deferred " + (await deferred)))();
  Promise.resolve("by a handler").then(settle);
  await turns(4);
}
log("== under stores");
{
  const storage = new AsyncLocalStorage<string>();
  const here = () => String(storage.getStore());
  const results = await Promise.all([
    storage.run("one", async () => { const value = await Promise.all([after(1, 1), after(2, 2)]); return here() + " " + show(value); }),
    storage.run("two", async () => { const value = await Promise.resolve(3).then(x => { log("handler under " + here()); return x; }); return here() + " " + value; }),
    (async () => { await Promise.all([after(1, 4)]); return here(); })(),
  ]);
  log(show(results) + " behind: " + here());
}
log("== many and large");
{
  const large = await Promise.all(Array.from({ length: 2000 }, (_, i) => (i % 3 ? after2(i) : i)));
  async function after2(i: number) { await null; return i; }
  log("large " + large.length + " " + large.reduce((a, b) => a + b, 0));
  let sum = 0;
  for (let i = 0; i < 3000; i++) { const [a, b] = await Promise.all([after2(i), after2(i + 1)]); sum += a + b; }
  log("many " + sum);
  const objects = await Promise.all(Array.from({ length: 500 }, async (_, i) => { await null; return { i, list: [i, i + 1] }; }));
  log("objects " + objects.reduce((a, b) => a + b.list[1], 0));
}
console.log(lines.filter(line => !line.startsWith("ready ") || lines.length < 400).join("\n"));
//// promise-all-host-queues.ts
// `Promise.all([f(), g()])` with what only a whole runtime shows: unhandled rejections of calls whose list was never made, microtasks drained while the list is being made, AsyncLocalStorage, process.nextTick.
import { AsyncLocalStorage } from "node:async_hooks";
import { drainMicrotasks } from "bun:jsc";
const log: string[] = [];
const storage = new AsyncLocalStorage<string>();
const settled = Promise.resolve(0);

////= lines-8	atOnce	n	number	number
async function later(n: number, turns: number): Promise<number> {
  for (let i = 0; i < turns; i++) await settled;
  log.push("later ends " + n + " in " + storage.getStore());
  return n;
}
////= lines-25	failsAtOnce	number	throw	Error	"fails at once "
async function failsLater(n: number, turns: number): Promise<number> {
  for (let i = 0; i < turns; i++) await settled;
  throw new Error("fails later " + n);
}
function throwsPlainly(): number {
  throw new Error("thrown while the list is made");
}
function drains(n: number): number {
  log.push("draining " + n);
  drainMicrotasks();
  log.push("drained " + n);
  return n;
}
function pause(): Promise<void> {
  return new Promise<void>(resolve => setTimeout(resolve, 3));
}

process.on("unhandledRejection", reason => {
  log.push("unhandled: " + (reason as Error).message);
});
process.on("rejectionHandled", () => {
  log.push("handled late");
});

async function attempt(name: string, run: () => Promise<unknown>): Promise<void> {
  try {
    log.push(name + " gives " + JSON.stringify(await run()));
  } catch (error) {
    log.push(name + " throws " + (error as Error).message);
  }
  await pause();
}

async function main(): Promise<void> {
  await attempt("two fail", async () => await Promise.all([failsLater(1, 2), failsLater(2, 1), failsAtOnce(3)]));
  await attempt("the list is never made", async () => await Promise.all([failsLater(4, 1), failsAtOnce(5), later(6, 2), throwsPlainly()]));
  await attempt("drained between the calls", async () => await Promise.all([later(7, 1), later(8, 3), drains(9), atOnce(10)]));
  await attempt("a failure drained between the calls", async () => await Promise.all([failsLater(11, 1), drains(12), later(13, 1)]));
  await attempt("drained, then never made", async () => await Promise.all([failsLater(14, 1), later(15, 1), drains(16), throwsPlainly()]));
  await attempt("in a store", () => storage.run("outer", async () => {
    const values = await Promise.all([later(17, 1), storage.run("inner", () => later(18, 2)), atOnce(19)]);
    return [values, storage.getStore()];
  }));
  await attempt("with ticks", async () => {
    process.nextTick(() => log.push("a tick"));
    const values = await Promise.all([later(20, 1), atOnce(21)]);
    process.nextTick(() => log.push("another tick"));
    return values;
  });
}
main().then(() => console.log(log.join("\n")));
//// promise-all-of-direct-calls.ts
// `Promise.all([f(), g()])` over an array literal of calls of async functions: the order of jobs, which rejection wins, what each kind of element does, and that the result is an ordinary array.
const log: string[] = [];
const settled = Promise.resolve(0);
const collect: (sync?: boolean) => void = (globalThis as any).gc ?? (globalThis as any).Bun?.gc ?? (() => undefined);
////= ticks-2
function text(error: unknown): string {
  return error instanceof Error ? error.message : String(error);
}

async function atOnce(n: number): Promise<number> {
  log.push("atOnce " + n);
  return n;
}
async function later(n: number, turns: number): Promise<number> {
  log.push("later enters " + n);
  for (let i = 0; i < turns; i++) await settled;
  log.push("later ends " + n);
  return n;
}
async function object(n: number): Promise<{ n: number }> {
  if (n & 1) await settled;
  return { n };
}
////= lines-25	failsAtOnce	number	throw	Error	"fails at once "
async function failsLater(n: number, turns: number): Promise<number> {
  for (let i = 0; i < turns; i++) await settled;
  throw new Error("fails later " + n);
}
async function givesPromise(n: number): Promise<number> {
  return Promise.resolve(n);
}
async function givesThenable(n: number): Promise<number> {
  await settled;
  return { then(resolve: (value: number) => void) { log.push("the thenable is asked " + n); resolve(n); } } as PromiseLike<number>;
}
async function nested(n: number): Promise<number> {
  const [a, b] = await Promise.all([later(n, 1), atOnce(n + 1)]);
  return a + b;
}
function throwsPlainly(): number {
  throw new Error("thrown while the list is made");
}
const thenable: PromiseLike<string> = { then(resolve: any) { log.push("the plain thenable is asked"); resolve("from a thenable"); return undefined as any; } };

async function show(name: string, run: () => Promise<unknown>): Promise<void> {
  ticks(name, 9);
  try {
    log.push(name + " gives " + JSON.stringify(await run()));
  } catch (error) {
    log.push(name + " throws " + text(error));
  }
  for (let i = 0; i < 12; i++) await settled;
}

async function main(): Promise<void> {
  await show("both at once", async () => await Promise.all([atOnce(1), atOnce(2)]));
  await show("both later", async () => await Promise.all([later(1, 1), later(2, 3)]));
  await show("the first is slower", async () => await Promise.all([later(1, 4), later(2, 1), atOnce(3)]));
  await show("objects", async () => await Promise.all([object(1), object(2), object(3)]));
  await show("one element", async () => await Promise.all([later(1, 2)]));
  await show("no element", async () => await Promise.all([]));
  await show("values among calls", async () => await Promise.all([1, atOnce(2), "three", later(4, 1), null, undefined, { five: 5 }]));
  await show("promises among calls", async () => await Promise.all([settled, atOnce(2), Promise.resolve("three"), later(4, 2), new Promise(resolve => settled.then(() => resolve("five")))]));
  await show("a thenable among calls", async () => await Promise.all([later(1, 1), thenable, atOnce(3)]));
  await show("results that are promises", async () => await Promise.all([givesPromise(1), givesThenable(2), atOnce(3)]));
  await show("a conditional element", async () => await Promise.all([atOnce(1), log.length > 0 ? later(2, 1) : null, log.length < 0 ? later(3, 1) : null]));
  await show("an await in the list", async () => await Promise.all([later(1, 1), await later(2, 3), later(3, 1)]));
  await show("nested", async () => await Promise.all([nested(1), nested(10), Promise.all([atOnce(20), later(21, 2)])]));
  await show("fails at once", async () => await Promise.all([failsAtOnce(1), later(2, 2)]));
  await show("fails later", async () => await Promise.all([later(1, 3), failsLater(2, 1)]));
  await show("two fail, the second first", async () => await Promise.all([failsLater(1, 3), failsLater(2, 1), later(3, 5)]));
  await show("two fail at once", async () => await Promise.all([failsAtOnce(1), failsAtOnce(2)]));
  await show("the list is never made", async () => await Promise.all([later(1, 2), atOnce(2), throwsPlainly()]));
  await show("the pattern", async () => {
    const [a, { n }, c = "default"] = await Promise.all([later(1, 1), object(2), undefined]);
    return [a, n, c];
  });
  await show("the promise is kept", async () => {
    const all = Promise.all([later(1, 2), atOnce(2)]);
    log.push("kept is a promise " + (all instanceof Promise));
    all.then(values => log.push("then sees " + values.join()));
    const first = await all;
    const second = await all;
    return [first === second, Array.isArray(first), first.length];
  });
  await show("the result is an ordinary array", async () => {
    const values = await Promise.all([atOnce(1), later(2, 1)]);
    values.push(3);
    values[0] = 10;
    return [values, Object.getPrototypeOf(values) === Array.prototype, Object.keys(values)];
  });
  await show("not awaited", async () => {
    void Promise.all([later(1, 1), atOnce(2)]).then(values => log.push("unawaited gives " + values.join()));
    return "went on";
  });
  await show("returned", () => Promise.all([later(1, 1), atOnce(2)]));
  await show("in a plain function", async () => await ((): Promise<number[]> => Promise.all([later(1, 1), atOnce(2)]))());
  await show("with collections", async () => {
    const all = Promise.all([object(1), object(3), later(5, 4)]);
    collect(true);
    await settled;
    collect(true);
    const values = await all;
    collect(true);
    return values;
  });
  const many: Promise<number[]>[] = [];
  for (let i = 0; i < 100; i++) many.push(Promise.all([later(i, i % 4), atOnce(i), nested(i)]));
  const sums = (await Promise.all(many)).map(([a, b, c]) => a + b + c);
  log.push("many " + sums.reduce((a, b) => a + b, 0));
}

main().then(() => {
  let hash = 0;
  for (const line of log) for (let i = 0; i < line.length; i++) hash = (hash * 31 + line.charCodeAt(i)) | 0;
  for (const line of log.slice(0, 420)) console.log(line);
  console.log(log.length + " lines, hash " + hash);
});
//// promise-constructor-getter-throws.ts
// A promise whose `constructor` getter throws makes `await` throw at once, without a tick:
// in async functions and in async generators, at await, yield, yield* and return, caught and not caught.
const log: string[] = [];
////= note

function broken(id: string): Promise<number> {
    const promise = Promise.resolve(1);
    Object.defineProperty(promise, "constructor", {
        get() {
            note("constructor of " + id + " is read");
            throw new Error("broken " + id);
        },
    });
    return promise;
}

function tick(id: string): void {
    Promise.resolve().then(() => note("tick " + id));
}

function messageOf(error: unknown): string {
    return error instanceof Error ? error.message : String(error);
}

function watch(label: string, promise: Promise<unknown>): Promise<void> {
    return promise.then(value => note(label + " resolved " + JSON.stringify(value)), error => note(label + " rejected " + messageOf(error)));
}

async function awaitsInFunction(): Promise<void> {
    tick("f1");
    await broken("f1");
    note("f1 goes on");
}
async function catchesInFunction(): Promise<string> {
    tick("f2");
    try {
        await broken("f2");
    } catch (error) {
        note("f2 caught " + messageOf(error));
    }
    await null;
    return "f2 ends";
}
async function returnsInFunction(): Promise<number> {
    tick("f3");
    return broken("f3");
}
async function awaitsLater(): Promise<string> {
    await null;
    tick("f4");
    try {
        await broken("f4");
    } catch (error) {
        note("f4 caught " + messageOf(error));
    }
    try {
        await broken("f4 again");
    } finally {
        note("f4 finally");
    }
    return "never";
}

async function* awaits(): AsyncGenerator<number> {
    tick("g1");
    await broken("g1");
    note("g1 goes on");
}
async function* catchesAwait(): AsyncGenerator<number> {
    tick("g2");
    try {
        await broken("g2");
    } catch (error) {
        note("g2 caught " + messageOf(error));
    }
    yield 2;
    yield 22;
}
async function* yields(): AsyncGenerator<number> {
    tick("g3");
    yield broken("g3");
    note("g3 goes on");
}
async function* catchesYield(): AsyncGenerator<number> {
    tick("g4");
    try {
        yield broken("g4");
    } catch (error) {
        note("g4 caught " + messageOf(error));
    }
    yield 4;
}
async function* returns(): AsyncGenerator<number, number> {
    tick("g5");
    return broken("g5");
}
async function* catchesReturn(): AsyncGenerator<number, number> {
    tick("g6");
    try {
        return broken("g6");
    } catch (error) {
        note("g6 caught " + messageOf(error));
    }
    return 6;
}
async function* delegates(): AsyncGenerator<number> {
    tick("g7");
    yield* yields();
    note("g7 goes on");
}
async function* catchesDelegate(): AsyncGenerator<number> {
    tick("g8");
    try {
        yield* [1, broken("g8"), 3];
    } catch (error) {
        note("g8 caught " + messageOf(error));
    }
    yield 8;
}
async function* awaitsThenAwaits(): AsyncGenerator<number> {
    try {
        await broken("g9");
    } catch (error) {
        note("g9 caught " + messageOf(error));
    }
    await null;
    yield 9;
    try {
        await broken("g9 again");
    } catch (error) {
        note("g9 caught " + messageOf(error));
        yield 99;
    }
    await broken("g9 at last");
}
async function* plain(): AsyncGenerator<number> {
    yield 1;
    yield 2;
}

async function consume(label: string, source: AsyncGenerator<number, unknown>): Promise<void> {
    try {
        for await (const value of source)
            note(label + " sees " + value);
        note(label + " ends");
    } catch (error) {
        note(label + " caught " + messageOf(error));
    }
}

async function main(): Promise<void> {
    await Promise.all([
        watch("f1", awaitsInFunction()),
        watch("f2", catchesInFunction()),
        watch("f3", returnsInFunction()),
        watch("f4", awaitsLater()),
        watch("g1", awaits().next()),
        watch("g2", catchesAwait().next()),
        watch("g3", yields().next()),
        watch("g4", catchesYield().next()),
        watch("g5", returns().next()),
        watch("g6", catchesReturn().next()),
        watch("g7", delegates().next()),
        watch("g8", catchesDelegate().next()),
        note("all are started"),
    ]);
    note("--- consumed by for await");
    for (const [label, make] of [["g1", awaits], ["g2", catchesAwait], ["g3", yields], ["g4", catchesYield], ["g5", returns], ["g6", catchesReturn], ["g7", delegates], ["g8", catchesDelegate], ["g9", awaitsThenAwaits]] as const)
        await consume(label, make());
    note("--- several requests at once");
    for (const make of [awaits, catchesAwait, yields, catchesYield, returns, catchesReturn, awaitsThenAwaits]) {
        const generator = make();
        await Promise.all([watch("first", generator.next()), watch("second", generator.next()), watch("third", generator.next()), watch("fourth", generator.next())]);
    }
    note("--- return() and throw() with a broken promise");
    const unstarted = plain();
    await watch("return on one not started", unstarted.return(broken("r1")));
    await watch("next behind it", unstarted.next());
    const started = plain();
    await watch("next", started.next());
    await watch("return on one that is suspended", started.return(broken("r2")));
    await watch("next behind it", started.next());
    const ended = plain();
    for await (const value of ended)
        note("ended sees " + value);
    await Promise.all([watch("return on one that has ended", ended.return(broken("r3"))), watch("next in the same turn", ended.next()), watch("return again", ended.return(broken("r4")))]);
    const thrown = plain();
    await watch("next", thrown.next());
    await watch("throw", thrown.throw(broken("t1")));
    console.log(log.join("\n"));
}

main();
//// promise-executor-settles-once.js
// The resolving functions of `new Promise(executor)` settle the promise once. Every later call, and a later throw from the executor, is ignored.
async function report(label, promise) {
  try {
    console.log(label, "fulfilled", await promise);
  } catch (error) {
    console.log(label, "rejected", error.message);
  }
}

async function runJobs() {
  for (let turn = 0; turn < 8; turn++) await undefined;
}

await report("resolve, resolve", new Promise(resolve => { resolve(1); resolve(2); }));
await report("resolve, reject", new Promise((resolve, reject) => { resolve(1); reject(new Error("late")); }));
await report("resolve, throw", new Promise(resolve => { resolve(1); throw new Error("late"); }));
await report("reject, resolve", new Promise((resolve, reject) => { reject(new Error("first")); resolve(2); }));
await report("reject, reject", new Promise((resolve, reject) => { reject(new Error("first")); reject(new Error("second")); }));
await report("reject, throw", new Promise((resolve, reject) => { reject(new Error("first")); throw new Error("late"); }));
await report("throw", new Promise(() => { throw new Error("only"); }));

let resolveLater;
const resolvedInExecutor = new Promise(resolve => { resolveLater = resolve; resolve(1); });
resolveLater(2);
await report("resolve, resolve after the executor returned", resolvedInExecutor);

let fulfillInner;
const inner = new Promise(resolve => { fulfillInner = resolve; });
let outcome = "pending";
new Promise((resolve, reject) => { resolve(inner); resolve(4); reject(new Error("late")); }).then(
  value => { outcome = "fulfilled " + value; },
  error => { outcome = "rejected " + error.message; },
);
await runJobs();
console.log("resolve with a pending promise, resolve, reject:", outcome);
fulfillInner(3);
await runJobs();
console.log("after the pending promise is fulfilled:", outcome);

