//// promise-of-an-async-function-changed-by-evaluated-text.js
// Evaluated text calls an async function of the program, changes the promise that it gets and hands that promise back. With a `then` of its own alone an await still
// gives what the function returned: an await of a promise of the realm asks for `constructor` and not for `then`. With another `constructor` too, the `then` runs.
// The promises that the program gets from its own calls of the same functions are other objects: nothing was done to them.
async function count(n) {
  return n * 2;
}
async function label(n) {
  return { text: "n" + n };
}
const changeThen = new Function("f", "n", "const p = f(n); p.then = function (resolve) { resolve('changed ' + n); }; return p;");
const changeBoth = new Function("f", "n", "const p = f(n); p.constructor = Object; p.then = function (resolve) { resolve('changed ' + n); }; return p;");
const withThen = changeThen(count, process.argv.length);
const withBoth = changeBoth(count, process.argv.length);
console.log(await withThen, await withBoth, await changeBoth(label, process.argv.length + 1));
console.log(await count(process.argv.length), (await label(process.argv.length)).text);
const own = count(5);
console.log(own.then === Promise.prototype.then, withThen.then === Promise.prototype.then, own.constructor === Promise, withBoth.constructor === Promise, await own);
//// promise-resolve-of-literals-and-thenables.js
// Promise.resolve reads `then` of its argument at the call: literals with and without the member, and stores to it before and after.
function numberOrThenable(flag) {
  return Promise.resolve(flag ? 1 : { then(resolve) { resolve("from thenable"); } });
}

const shared = { v: 1 };
function install() { shared.then = function (resolve) { resolve("late"); }; }
async function awaited() { return typeof await Promise.resolve(shared); }

const steps = {
  [Symbol.asyncIterator]() {
    let i = 0;
    return { next() { return Promise.resolve({ done: i++ >= 2, value: "step " + i }); } };
  },
};

function overwritten(tag) {
  const holder = { then: undefined, v: tag };
  holder.then = function (resolve) { resolve("thenable " + tag); };
  const promise = Promise.resolve(holder);
  holder.then = undefined;
  return promise;
}

function storedLate(tag) {
  const holder = { then: undefined, v: tag };
  const promise = Promise.resolve(holder);
  holder.then = function (resolve) { resolve("thenable " + tag); };
  return promise;
}

function inherited(tag) {
  const base = { then: undefined };
  const heir = Object.create(base);
  base.then = function (resolve) { resolve("inherited " + tag); };
  const promise = Promise.resolve(heir);
  base.then = undefined;
  return promise;
}

let kept = null;
function escapedFirst(tag) {
  const holder = { then: undefined, v: tag };
  kept = holder;
  holder.then = function (resolve) { resolve("escaped " + tag); };
  const promise = Promise.resolve(holder);
  holder.then = undefined;
  return promise;
}

async function returned(tag) {
  const holder = { then: undefined, v: tag };
  holder.then = function (resolve) { resolve("returned " + tag); };
  queueMicrotask(() => { holder.then = undefined; });
  return holder;
}

async function main() {
  console.log(await numberOrThenable(true), await numberOrThenable(false));
  console.log(await awaited());
  install();
  console.log(await awaited());
  for await (const step of steps) console.log(step);
  for (let i = 0; i < 3; i++) {
    console.log("overwritten", await overwritten(i));
    console.log("stored late", typeof await storedLate(i));
    console.log("inherited", await inherited(i));
    console.log("escaped first", await escapedFirst(i), kept.then);
    console.log("returned", await returned(i));
  }
  console.log(await Promise.all([overwritten(7), { then(resolve) { resolve("in all"); } }, 3]));
}
main();
//// promise-resolve-thenables.ts
// Promise.resolve fulfills a new promise with a class instance directly, and adopts every value that has, gains or inherits a `then`.
const log: string[] = [];

type Settle = (value: unknown) => void;

////= Point

////= lines-11	Late	public	label	string

////= lines-11	Moved	public	label	string

class Derived<T> extends Promise<T> {}

function describe(value: unknown): string {
  if (value instanceof Point) return `Point(${value.x}, ${value.y})`;
  if (value instanceof Late) return `Late(${value.label})`;
  if (value instanceof Moved) return `Moved(${value.label})`;
  if (value instanceof Error) return `${value.name}(${value.message})`;
  return String(value);
}

async function report(label: string, promise: Promise<unknown>): Promise<void> {
  const seen = { outcome: "" };
  promise.then(
    value => {
      seen.outcome = "fulfilled with " + describe(value);
    },
    reason => {
      seen.outcome = "rejected with " + describe(reason);
    },
  );
  let turns = 0;
  while (!seen.outcome) {
    await undefined;
    turns++;
  }
  log.push(`${label}: ${seen.outcome} after ${turns}`);
}

////= lines-22	resolvePoint	point	Point

////= lines-22	resolveLate	late	Late

////= lines-22	resolveMoved	moved	Moved

function resolveNumberOrPoint(value: number | Point): Promise<unknown> {
  return Promise.resolve(value);
}

function resolveStringOrPoint(value: string | Point): Promise<unknown> {
  return Promise.resolve(value);
}

////= lines-22	resolveAnything	value	unknown

async function instances(): Promise<void> {
  const plain = new Point(1, 2);
  await report("instance", resolvePoint(plain));

  const thenable = new Point(3, 4);
  (thenable as any).then = function (this: Point, resolve: Settle): void {
    log.push(`then runs on ${describe(this)}`);
    resolve("adopted");
  };
  log.push("before the call");
  const adopted = resolvePoint(thenable);
  log.push("after the call");
  await report("instance with an own then", adopted);

  delete (thenable as any).then;
  await report("instance whose then is deleted", resolvePoint(thenable));

  const rejecting = new Point(5, 6);
  (rejecting as any).then = function (resolve: Settle, reject: Settle): void {
    reject("the reason");
    resolve("ignored");
  };
  await report("instance whose then rejects", resolvePoint(rejecting));

  const notCallable = new Point(7, 8);
  (notCallable as any).then = 9;
  await report("instance whose then is a number", resolvePoint(notCallable));

  const watched = new Point(10, 11);
  Object.defineProperty(watched, "then", {
    get() {
      log.push("then is read");
      return undefined;
    },
  });
  await report("instance whose then is a getter", resolvePoint(watched));

  const throwing = new Point(12, 13);
  Object.defineProperty(throwing, "then", {
    get() {
      throw new RangeError("then throws");
    },
  });
  await report("instance whose then throws", resolvePoint(throwing));

  const other = new Point(14, 15);
  (other as any).extra = "extra";
  await report("instance with another extra property", resolvePoint(other));
  await report("the first instance again", resolvePoint(plain));
}

async function prototypes(): Promise<void> {
  const late = new Late("first");
  await report("before the prototype has a then", resolveLate(late));
  (Late.prototype as any).then = function (this: Late, resolve: Settle): void {
    resolve(`then of ${this.label}`);
  };
  await report("after the prototype gained a then", resolveLate(late));
  await report("an instance created afterwards", resolveLate(new Late("second")));
  delete (Late.prototype as any).then;
  await report("after the prototype lost its then", resolveLate(late));

  const moved = new Moved("moved");
  await report("before the prototype is replaced", resolveMoved(moved));
  Object.setPrototypeOf(moved, {
    then(this: Moved, resolve: Settle): void {
      resolve(`then of ${this.label}`);
    },
  });
  await report("after the prototype is replaced", resolveMoved(moved));
  await report("an instance with the original prototype", resolveMoved(new Moved("unmoved")));
}

async function promises(): Promise<void> {
  const pristine = Promise.resolve("pristine");
  log.push(`promise: ${Promise.resolve(pristine) === pristine}`);

  const derived = new Derived<string>(resolve => resolve("derived"));
  const wrapped = Promise.resolve(derived);
  log.push(`subclass: ${wrapped === derived} ${wrapped instanceof Derived} ${wrapped.constructor === Promise}`);
  await report("subclass", wrapped);
  log.push(`resolve of the subclass: ${Derived.resolve(derived) === derived} ${Derived.resolve(pristine) === pristine} ${Derived.resolve(1) instanceof Derived}`);

  const ownConstructor = Promise.resolve("own constructor");
  (ownConstructor as any).constructor = Derived;
  const rewrapped = Promise.resolve(ownConstructor);
  log.push(`own constructor: ${rewrapped === ownConstructor} ${rewrapped instanceof Derived}`);
  await report("own constructor", rewrapped);

  const sameConstructor = Promise.resolve("same constructor");
  (sameConstructor as any).constructor = Promise;
  log.push(`own constructor that is Promise: ${Promise.resolve(sameConstructor) === sameConstructor}`);

  const watched = Promise.resolve("watched");
  Object.defineProperty(watched, "constructor", {
    get() {
      log.push("constructor is read");
      return Promise;
    },
  });
  log.push(`constructor getter: ${Promise.resolve(watched) === watched}`);

  const throwing = Promise.resolve("throwing");
  Object.defineProperty(throwing, "constructor", {
    get() {
      throw new RangeError("constructor throws");
    },
  });
  try {
    Promise.resolve(throwing);
    log.push("no error");
  } catch (error) {
    log.push(`caught ${describe(error)}`);
  }

  const ownThen = Promise.resolve("own then");
  (ownThen as any).then = function (resolve: Settle): void {
    resolve("from the own then");
  };
  log.push(`own then: ${Promise.resolve(ownThen) === ownThen}`);
  await report("own then", Promise.resolve(ownThen));
  await report("own then in a subclass promise", Derived.resolve(ownThen));
}

async function values(): Promise<void> {
  await report("no argument", Promise.resolve());
  await report("number", resolveNumberOrPoint(1.5));
  await report("instance where a number may come", resolveNumberOrPoint(new Point(16, 17)));
  await report("string", resolveStringOrPoint("text"));
  await report("instance where a string may come", resolveStringOrPoint(new Point(18, 19)));
  for (const value of [undefined, null, true, 0, NaN, "", 10n, Symbol("symbol"), [1, 2]]) await report(typeof value, resolveAnything(value));

  const callable = function (): void {};
  (callable as any).then = (resolve: Settle): void => resolve("from a function");
  await report("function with a then", resolveAnything(callable));

  const list = [1, 2];
  (list as any).then = (resolve: Settle): void => resolve("from an array");
  await report("array with a then", resolveAnything(list));

  await report(
    "literal with a then",
    Promise.resolve({
      then(resolve: Settle): void {
        resolve("from a literal");
      },
    }),
  );
}

async function hotLoop(): Promise<void> {
  let direct = 0;
  let adopted = 0;
  for (let i = 0; i < 20000; i++) {
    const point = new Point(i, -i);
    if (i % 1000 === 999) (point as any).then = (resolve: Settle): void => resolve(i);
    const value = await resolvePoint(point);
    if (value === point) direct++;
    else if (value === i) adopted++;
  }
  log.push(`${direct} direct, ${adopted} adopted`);
}

////= main	instances	prototypes	promises	values	hotLoop

main();

export {};
//// promise-subclass-construction.ts
// `super(executor)` in a class that extends Promise: what a program can see of it stays as the language says.
const log: string[] = [];
const say = (...parts: unknown[]) => log.push(parts.map(String).join(" "));

class Plain<T> extends Promise<T> {}

class WithField<T> extends Promise<T> {
  label = "field";
  constructor(executor: (resolve: (value: T | PromiseLike<T>) => void, reject: (reason?: unknown) => void) => void, readonly tag: string) {
    super(executor);
  }
}

class Keeps<T> extends Promise<T> {
  static get [Symbol.species]() {
    return Promise;
  }
  resolveLater!: (value: T) => void;
  rejectLater!: (reason: unknown) => void;
  constructor() {
    let resolveFunction: (value: T) => void, rejectFunction: (reason: unknown) => void;
    super((resolve, reject) => {
      resolveFunction = resolve;
      rejectFunction = reject;
    });
    this.resolveLater = resolveFunction!;
    this.rejectLater = rejectFunction!;
  }
}

class Lazy<T> extends Promise<T> {
  static get [Symbol.species]() {
    return Promise;
  }
  started = 0;
  then<A = T, B = never>(onFulfilled?: ((value: T) => A | PromiseLike<A>) | null, onRejected?: ((reason: unknown) => B | PromiseLike<B>) | null): Promise<A | B> {
    this.started++;
    return super.then(onFulfilled, onRejected);
  }
}

class Deeper<T> extends WithField<T> {
  constructor(executor: (resolve: (value: T) => void) => void) {
    super(executor, "deeper");
  }
}

const Alias = Promise;
class ThroughAlias<T> extends Alias<T> {
  constructor(executor: (resolve: (value: T) => void) => void) {
    super(executor);
  }
}

async function basics(): Promise<void> {
  const plain = new Plain<number>(resolve => resolve(1));
  say("plain", plain instanceof Plain, plain instanceof Promise, Object.getPrototypeOf(plain) === Plain.prototype, await plain);
  const field = new WithField<string>(resolve => resolve("value"), "tag");
  say("field", field.label, field.tag, Object.keys(field).join(), await field);
  const deeper = new Deeper<number>(resolve => resolve(3));
  say("deeper", deeper.tag, deeper instanceof WithField, Object.getPrototypeOf(deeper) === Deeper.prototype, await deeper);
  const alias = new ThroughAlias<number>(resolve => resolve(4));
  say("alias", alias instanceof ThroughAlias, await alias);
  const derived = plain.then(value => value + 1);
  say("derived", derived instanceof Plain, derived.constructor === Plain, await derived);
  const lazy = new Lazy<number>(resolve => resolve(5));
  const fromLazy = lazy.then(value => value * 2);
  say("lazy", lazy.started, fromLazy instanceof Lazy, fromLazy.constructor === Promise, await fromLazy, await lazy, lazy.started);
}

async function resolvingFunctions(): Promise<void> {
  const keeps = new Keeps<number>();
  say("functions", typeof keeps.resolveLater, keeps.resolveLater.length, keeps.rejectLater.length, JSON.stringify(keeps.resolveLater.name), Object.getPrototypeOf(keeps.resolveLater) === Function.prototype);
  say("result of resolve", keeps.resolveLater(1));
  keeps.resolveLater(2);
  keeps.rejectLater(new Error("late"));
  say("first wins", await keeps);
  const rejected = new Keeps<number>();
  rejected.rejectLater("reason");
  rejected.resolveLater(1);
  say("rejected", await rejected.catch(reason => "caught " + reason));
  const self = new Keeps<unknown>();
  self.resolveLater(self);
  say("self", await self.catch(error => (error as Error).constructor.name));
  const chained = new Keeps<unknown>();
  chained.resolveLater(new Plain<string>(resolve => resolve("inner")));
  say("chained", await chained);
  const thenable = new Keeps<unknown>();
  thenable.resolveLater({ then(resolve: (value: string) => void) { say("then called"); resolve("from thenable"); } });
  say("before");
  say("thenable", await thenable);
}

async function failures(): Promise<void> {
  const thrown = new Plain<number>(() => {
    throw new RangeError("in the executor");
  });
  say("thrown", await thrown.catch(error => (error as Error).message));
  const afterResolve = new Plain<number>(resolve => {
    resolve(7);
    throw new Error("ignored");
  });
  say("after resolve", await afterResolve);
  for (const executor of [undefined, null, 1, "text", {}, Symbol.iterator]) {
    try {
      new Plain<number>(executor as any);
      say("no error");
    } catch (error) {
      say("not callable", (error as Error).constructor.name, (error as Error).message);
    }
  }
  try {
    Reflect.construct(Plain, []);
  } catch (error) {
    say("no arguments", (error as Error).constructor.name);
  }
  say("more arguments", await Reflect.construct(Plain, [(resolve: (value: number) => void) => resolve(8), 1, 2]));
  try {
    (Plain as unknown as (executor: unknown) => unknown)(() => {});
  } catch (error) {
    say("called", (error as Error).constructor.name);
  }
}

async function newTargets(): Promise<void> {
  function Other() {}
  Other.prototype = { marker: "other" };
  const constructed = Reflect.construct(Plain, [(resolve: (value: number) => void) => resolve(1)], Other) as Promise<number> & { marker?: string };
  say("new.target", constructed.marker, constructed instanceof Plain, Object.getPrototypeOf(constructed) === Other.prototype);
  say("still a promise", await Promise.prototype.then.call(constructed, value => value));
  const order: string[] = [];
  const watched = new Proxy(function () {}, {
    get(target, key, receiver) {
      order.push("get " + String(key));
      return key === "prototype" ? Plain.prototype : Reflect.get(target, key, receiver);
    },
  });
  Reflect.construct(Plain, [() => order.push("executor")], watched);
  say("order", order.join());
  const orderWithBadExecutor: string[] = [];
  const watchedAgain = new Proxy(function () {}, {
    get(target, key, receiver) {
      orderWithBadExecutor.push("get " + String(key));
      return Reflect.get(target, key, receiver);
    },
  });
  try {
    Reflect.construct(Plain, [1], watchedAgain);
  } catch (error) {
    say("bad executor first", (error as Error).constructor.name, orderWithBadExecutor.join());
  }
  try {
    Reflect.construct(Plain, [() => say("the executor ran")], new Proxy(function () {}, {
      get(target, key, receiver) {
        if (key === "prototype") throw new ReferenceError("from the proxy");
        return Reflect.get(target, key, receiver);
      },
    }));
  } catch (error) {
    say("new.target throws", (error as Error).constructor.name, (error as Error).message);
  }
  function Primitive() {}
  Primitive.prototype = 1 as any;
  const fallsBack = Reflect.construct(Plain, [() => {}], Primitive);
  say("primitive prototype", Object.getPrototypeOf(fallsBack) === Promise.prototype);
}

async function order(): Promise<void> {
  const steps: string[] = [];
  const first = new Lazy<string>(resolve => {
    steps.push("executor");
    resolve("value");
  });
  steps.push("constructed");
  Promise.resolve().then(() => steps.push("job 1")).then(() => steps.push("job 2")).then(() => steps.push("job 3")).then(() => steps.push("job 4"));
  first.then(() => steps.push("reaction"));
  (async () => {
    await first;
    steps.push("awaited");
  })();
  for (let turn = 0; turn < 12; turn++) await undefined;
  say(steps.join());
}

function framesOf(error: Error): string {
  const names = String(error.stack).split("\n").map(line => line.replace(/@.*|\s*\(.*|^\s*at\s+/g, "").trim().replace(/^new /, ""));
  return names.filter(name => /^[A-Za-z]+$/.test(name) && name !== "construct").slice(0, 3).join(" < ");
}

function stackTraces(): void {
  let seen: Error | undefined;
  function looksFromExecutor(): void {
    new WithField<number>(() => {
      seen = new Error("look");
    }, "t");
  }
  for (let turn = 0; turn < 40; turn++) looksFromExecutor();
  say("from an executor:", framesOf(seen!));
  function looksThroughImplicitConstructor(): void {
    new Plain<number>(() => {
      seen = new Error("look");
    });
  }
  for (let turn = 0; turn < 40; turn++) looksThroughImplicitConstructor();
  say("through an implicit constructor:", framesOf(seen!));
}

async function many(): Promise<void> {
  let total = 0;
  for (let i = 0; i < 2000; i++) total += await new WithField<number>(resolve => resolve(i), "t");
  say("many", total);
}

await basics();
await resolvingFunctions();
await failures();
await newTargets();
await order();
stackTraces();
await many();
console.log(log.join("\n"));
//// promise-subclass-replaced-parent.js
// The parent of a class that extends Promise is looked up at every `super(executor)`.
class Plain extends Promise {}
class Child extends Promise {
  constructor(executor) {
    super(executor);
  }
}
class Impostor {
  constructor(executor) {
    this.seen = typeof executor;
  }
}
console.log("before", (await new Child(resolve => resolve(1))) === 1);
Object.setPrototypeOf(Child, Impostor);
const built = new Child(resolve => resolve(2));
console.log("replaced", built.seen, built instanceof Promise, Object.getPrototypeOf(built) === Child.prototype);
Object.setPrototypeOf(Child, Plain);
const throughPlain = new Child(resolve => resolve(3));
console.log("through another subclass", await throughPlain, Object.getPrototypeOf(throughPlain) === Child.prototype);
Object.setPrototypeOf(Child, Promise);
console.log("back", await new Child(resolve => resolve(4)));
Object.setPrototypeOf(Child, null);
try {
  new Child(resolve => resolve(5));
} catch (error) {
  console.log("no parent", error.constructor.name);
}
//// resolve-late-thenables.ts
// An async function's result and an awaited value are adopted through `then` once the object or its prototype chain has one, and pass through unchanged otherwise.
const log: string[] = [];

type Resolve = (value: unknown) => void;
type Then = (resolve: Resolve) => void;

////= lines-11	Account	public	id	number
////= Point
////= lines-11	Shape	public	sides	number
interface Download {
  url: string;
  then?: Then;
}
interface Upload {
  path: string;
  then?: unknown;
}
////= lines-4	Settings	depth	number	label	string

const returnAccount = async (account: Account): Promise<unknown> => account;
const awaitAccount = async (account: Account): Promise<unknown> => await account;
const returnDownload = async (download: Download): Promise<unknown> => download as unknown;
const awaitDownload = async (download: Download): Promise<unknown> => await (download as unknown);
const returnUpload = async (upload: Upload): Promise<unknown> => upload;
const awaitUpload = async (upload: Upload): Promise<unknown> => await upload;
const returnPoint = async (point: Point): Promise<unknown> => point;
const awaitPoint = async (point: Point): Promise<unknown> => await point;
const returnShape = async (shape: Shape): Promise<unknown> => shape;
const awaitShape = async (shape: Shape): Promise<unknown> => await shape;
const returnSettings = async (settings: Settings): Promise<unknown> => settings;
const awaitSettings = async (settings: Settings): Promise<unknown> => await settings;
const returnList = async (list: number[]): Promise<unknown> => list;
const awaitList = async (list: number[]): Promise<unknown> => await list;
const returnTable = async (table: Map<string, number>): Promise<unknown> => table;
const awaitTable = async (table: Map<string, number>): Promise<unknown> => await table;

function describe(value: unknown): string {
  if (value instanceof Map) return `Map(${value.size})`;
  if (typeof value === "object") return JSON.stringify(value);
  return String(value);
}

////= adopt

////= observe

async function classInstances(): Promise<void> {
  const first = new Account(1);
  await observe("instance", returnAccount(first), awaitAccount(first));
  (Account.prototype as any).then = function (this: Account, resolve: Resolve): void {
    log.push(`then of account ${this.id}`);
    resolve(`adopted from account ${this.id}`);
  };
  const second = new Account(2);
  await observe("instance created after the class gained then", returnAccount(second), awaitAccount(second));
  await observe("instance created before the class gained then", returnAccount(first), awaitAccount(first));
  delete (Account.prototype as any).then;
  await observe("instance after the class lost then", returnAccount(second), awaitAccount(second));
}

async function optionalFields(): Promise<void> {
  const plainDownload: Download = { url: "a" };
  const thenableDownload: Download = { url: "b", then: adopt("download b") };
  await observe("absent field, first of its type", returnDownload(plainDownload), awaitDownload(plainDownload));
  await observe("present field, second of its type", returnDownload(thenableDownload), awaitDownload(thenableDownload));
  plainDownload.then = adopt("download a");
  await observe("field assigned later", returnDownload(plainDownload), awaitDownload(plainDownload));

  const thenableUpload: Upload = { path: "c", then: adopt("upload c") };
  const plainUpload: Upload = { path: "d" };
  await observe("present field, first of its type", returnUpload(thenableUpload), awaitUpload(thenableUpload));
  await observe("absent field, second of its type", returnUpload(plainUpload), awaitUpload(plainUpload));
}

async function extraProperties(): Promise<void> {
  const point = new Point(1, 2);
  await observe("instance without extra properties", returnPoint(point), awaitPoint(point));
  (point as any).then = adopt("point");
  await observe("instance with an extra then", returnPoint(point), awaitPoint(point));
  const sibling = new Point(3, 4);
  await observe("sibling without extra properties", returnPoint(sibling), awaitPoint(sibling));
  (sibling as any).label = "sibling";
  await observe("sibling with another extra property", returnPoint(sibling), awaitPoint(sibling));
  delete (point as any).then;
  await observe("instance after its extra then is deleted", returnPoint(point), awaitPoint(point));
}

async function createdPrototypes(): Promise<void> {
  const root = Object.create(Object.prototype);
  Object.setPrototypeOf(Shape.prototype, Object.create(root));
  const shape = new Shape(3);
  await observe("created objects on the chain", returnShape(shape), awaitShape(shape));
  root.then = adopt("created prototype");
  await observe("created prototype with then", returnShape(shape), awaitShape(shape));
  delete root.then;
  await observe("created prototype after then is deleted", returnShape(shape), awaitShape(shape));

  const derived: Shape = Object.create(shape);
  await observe("object created from an instance", returnShape(derived), awaitShape(derived));
  (shape as any).then = adopt("instance used as a prototype");
  await observe("object created from a thenable instance", returnShape(derived), awaitShape(derived));
}

async function plainData(): Promise<void> {
  const settings: Settings = { depth: 2, label: "plain" };
  await observe("data object", returnSettings(settings), awaitSettings(settings));
  const list = [1, 2, 3];
  await observe("array", returnList(list), awaitList(list));
  const table = new Map([["one", 1]]);
  await observe("map", returnTable(table), awaitTable(table));
}

////= main	classInstances	optionalFields	extraProperties	createdPrototypes	plainData

main();

