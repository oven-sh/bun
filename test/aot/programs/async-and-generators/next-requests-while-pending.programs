////: create
function create«1» {
  let a = scramble(x);
  let b = scramble(x + 1);
  for (let i = 0; i < 2; i++) {
    a += scramble(a & 7);
    b += scramble(b & 7);
    if (a > 1e12) a = 1;
    if (b > 1e12) b = 2;
  }
  return «2»;
}
////: lines-22
