////: observe
async function observe(label: string, returned: Promise<unknown>, awaited: Promise<unknown>): Promise<void> {
  returned.then(value => log.push(`${label}: returned ${describe(value)}`));
  awaited.then(value => log.push(`${label}: awaited ${describe(value)}`));
  for (let turn = 1; turn <= 4; turn++) {
    await undefined;
    log.push(`${label}: turn ${turn}`);
  }
}
////: outside
function outside(): Promise<void> {
    return new Promise(resolve => { Promise.resolve().then(() => undefined).then(() => resolve()); });
}
////: random
function random(«1»: number): number {
    seed = (Math.imul(seed, 1103515245) + 12345) & 0x7fffffff;
    return Math.floor(seed / 65536) % «1»;
}
////: resumed
async function resumed(run: () => Promise<void>): Promise<void> {
    await outside();
    await run();
}
////: returnedInto
async function returnedInto(source: AsyncGenerator<unknown, string, unknown>): Promise<void> {
    try {
        note("first " + JSON.stringify(await source.next()));
        note("returned into " + JSON.stringify(await source.return("given up")));
        note("then " + JSON.stringify(await source.next()));
    } catch (error) {
        note("caught " + (error as Error).message);
    }
}
////: say
function say(...parts: unknown[]) {
  lines.push(parts.map(part => (typeof part === "string" ? part : JSON.stringify(part))).join(" "));
}
////: scene
async function scene(title: string, run: () => Promise<unknown>): Promise<void> {
    log = [];
    await run();
    lines.push(title + ": " + log.join(" | "));
}
////: show
function show(value: unknown): string {
  if (value instanceof Error) return value.constructor.name + ": " + value.message;
  return typeof value === "object" && value !== null ? JSON.stringify(value) : String(value);
}
////: startTicker
function startTicker(): Ticker {
  const own: Ticker = { count: 0, isOn: true };
  const step = (): void => {
    if (!own.isOn) return;
    own.count++;
    settled.then(step);
  };
  settled.then(step);
  return own;
}
////: startTicker-2
function startTicker(): void {
  const own: Ticker = { count: 0, isOn: true };
  const step = (): void => {
    if (!own.isOn) return;
    own.count++;
    settled.then(step);
  };
  ticker = own;
  settled.then(step);
}
////: stepped
function stepped(size: number): number | string {
  const steps = new Bag(size).values();
  let total = 0;
  try {
    for (let step = steps.next(); !step.done; step = steps.next()) total += step.value;
  } catch (error) {
    return (error as Error).stack!.split("\n").slice(0, 3).map(line => line.replace(/\(.*[\\/]/, "(").trim()).join(" | ");
  }
  return total;
}
////: sumOf
function sumOf(lines: string[]): number {
    let sum = 7;
    for (const line of lines) {
        for (let i = 0; i < line.length; i++)
            sum = (sum * 31 + line.charCodeAt(i)) % 1000000007;
    }
    return sum;
}
////: sumOfBag
function sumOfBag(size: number): number | string {
  let total = 0;
  try {
    for (const value of new Bag(size)) total += value;
  } catch (error) {
    return (error as Error).stack!.split("\n").slice(0, 3).map(line => line.replace(/\(.*[\\/]/, "(").trim()).join(" | ");
  }
  return total;
}
////: thenable
function thenable(value: number): PromiseLike<number> {
  return {
    then(resolve: any): any {
      resolve(value);
    },
  };
}
////: ticker
function ticker(label: string, turns: number): Promise<void> {
    let last: Promise<void> = Promise.resolve();
    for (let i = 1; i <= turns; i++) last = last.then(() => note(label + i));
    return last;
}
