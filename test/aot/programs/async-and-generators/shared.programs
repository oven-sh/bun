////: Span
class Span {
  constructor(
    public from: number,
    public to: number,
  ) {}
  *[Symbol.iterator]() {
    for (let k = this.from; k < this.to; k++) yield k;
  }
  *values() {
    for (let k = this.from; k < this.to; k++) yield k * 2;
  }
  *failing(): Generator<number> {
    yield this.from;
    throw new Error("from the body");
  }
}
