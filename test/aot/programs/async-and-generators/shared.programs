////: Bag
class Bag {
  constructor(public size: number) {}
  *values(): Generator<number> {
    for (let k = 0; k < this.size; k++) {
      if (k === 5) throw new Error("at the sixth");
      yield k;
    }
  }
  [Symbol.iterator]() {
    return this.values();
  }
}
////: Effect
class Effect {
  constructor(readonly value: number) {}
  [Symbol.iterator](): OneShot {
    return new OneShot(this);
  }
}
