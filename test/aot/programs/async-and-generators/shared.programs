////: Wider
class Wider extends Span {
  *[Symbol.iterator]() {
    yield -1;
    yield* super[Symbol.iterator]();
  }
}
////: adopt
function adopt(label: string): Then {
  return resolve => {
    log.push(`then of ${label}`);
    resolve(`adopted from ${label}`);
  };
}
////: afterTimer
function afterTimer(): Promise<void> {
  return new Promise<void>(resolve => {
    setTimeout(resolve, 0);
  });
}
////: afterTimer-2
function afterTimer(): Promise<void> {
  return new Promise<void>(resolve => {
    setTimeout(() => {
      if (hasOtherJobs) s«1»);
      resolve();
    }, 0);
  });
}
////: afterTwoJobs
function afterTwoJobs<T>(value: T): Promise<T> {
  return new Promise<T>(resolve => {
    settled.then(() => settled.then(() => resolve(value)));
  });
}
////: attempt
function attempt(title: string, run: () => unknown) {
  try {
    say(title, "->", run());
  } catch (error) {
    say(title, "threw", error instanceof Mine ? error.message : error instanceof Error ? error.constructor.name : error);
  }
}
////: awaitsCall
async function awaitsCall(depth: number, ending: Ending): Promise<number> {
  await settled;
  try {
    return 1 + (depth ? await awaitsCall(depth - 1, ending) : await innermost(ending));
  } finally {
    didResume(depth);
  }
}
////: awaitsVariable
async function awaitsVariable(depth: number, ending: Ending): Promise<number> {
  await settled;
  const pending = depth ? awaitsVariable(depth - 1, ending) : innermost(ending);
  try {
    return 1 + (await pending);
  } finally {
    didResume(depth);
  }
}
////: beat
function beat(label: string, beats: number): void {
  let done = 0;
  const step = (): void => {
    «1».push(label + " " + ++done);
    if (done < beats) «2».then(step);
  };
  «2».then(step);
}
////: byLoop
async function byLoop(source: AsyncGenerator<unknown, string, unknown>): Promise<void> {
    try {
        for await (const x of source) note("got " + JSON.stringify(x));
        note("the loop is over");
    } catch (error) {
        note("caught " + (error as Error).message);
    }
}
////: byNext
async function byNext(source: AsyncGenerator<unknown, string, unknown>): Promise<void> {
    try {
        for (let i = 0; ; i++) {
            const step = await source.next("sent " + i);
            note((step.done ? "done " : "step ") + JSON.stringify(step.value));
            if (step.done) return;
        }
    } catch (error) {
        note("caught " + (error as Error).message);
    }
}
////: countTurns
function countTurns(turns: number): void {
  let chain: Promise<void> = Promise.resolve();
  for (let turn = 1; turn <= turns; turn++) {
    chain = chain.then(() => {
      log.push("  turn " + turn);
    });
  }
}
////: kinds
const kinds: [string, () => Iterable<unknown>][] = [
    ["an empty array", () => []],
    ["an array of one", () => [{ n: 1 }]],
    ["an array of three", () => [1, "two", { n: 3 }]],
    ["an array with a hole and undefined", () => [1, , undefined, null] as unknown[]],
    ["an array of promises", () => [Promise.resolve("a"), outside().then(() => "b"), thenable, "c"]],
    ["an array with a rejection", () => [1, rejected("rejected in an array"), 3]],
    ["a set", () => new Set([1, 2])],
    ["a map", () => new Map([["k", 1]])],
    ["a text", () => "ab"],
    ["a generator of nothing", nothing],
    ["a generator of one", one],
    ["a generator of three", three],
    ["a generator that listens", listens],
    ["a generator that cleans up", cleansUp],
    ["a generator that throws at once", throwsAtOnce],
    ["a generator that throws later", throwsLater],
    ["a generator that queues a job", queuesAJob],
    ["a generator of promises", yieldsPromises],
    ["a generator with a rejection", yieldsARejection],
    ["by hand", () => byHand([1, 2])],
    ["by hand, empty", () => byHand([])],
];
////: last
function last(generator: Numbers): number {
  for (;;) {
    const step = generator.next();
    if (step.done) return step.value;
  }
}
////: leftEarly
function leftEarly(i: number): number {
  let total = 0;
  for (const value of new Span(0, 100)) {
    if (value > i) break;
    total += value;
  }
  return total;
}
