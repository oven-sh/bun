////: ticks
function ticks(name: string, count: number) {
  let chain = Promise.resolve();
  for (let i = 0; i < count; i++) chain = chain.then(() => log(name + " tick " + i));
}
////: ticks-2
function ticks(name: string, count: number): void {
  let chain: Promise<unknown> = settled;
  for (let i = 1; i <= count; i++) chain = chain.then(() => log.push(name + " tick " + i));
}
////: traced
function traced(): string {
  try {
    for (const value of new Span(1, 2).failing()) check += value;
  } catch (error) {
    return (error as Error).stack!.split("\n").slice(0, 3).map(line => line.replace(/\(.*[\\/]/, "(").trim()).join(" | ");
  }
  return "nothing thrown";
}
