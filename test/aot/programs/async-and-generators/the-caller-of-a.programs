//// the-head-of-a-generator-function-and-its-prototype-property.js
// A generator gets its prototype from the property `prototype` of its function as that is once the parameters are evaluated. A head with branches and no call leaves the property alone;
// a call, a getter or a store in any of its arms may change it.
const generatorPrototype = Object.getPrototypeOf(function* () {}).prototype;
const asyncGeneratorPrototype = Object.getPrototypeOf(async function* () {}).prototype;
const names = new Map([[generatorPrototype, "%GeneratorPrototype%"], [asyncGeneratorPrototype, "%AsyncGeneratorPrototype%"]]);
const named = (name, object = Object.create(generatorPrototype)) => { names.set(object, name); return object; };
const protoOf = generator => names.get(Object.getPrototypeOf(generator)) ?? "its own";
const line = (...parts) => console.log(parts.join(" "));

// Branches and constants alone.
function* constant(a = 1) { yield a; }
function* constants(a = 1, b = "two", c = a > 1 ? 3 : 4) { yield [a, b, c].join(); }
function* literal(options = { deep: false }, list = []) { yield options.deep + "," + list.length; }
named("constant.first", constant.prototype);
line(protoOf(constant()), protoOf(constant(5)), constant().next().value, constant(5).next().value);
constant.prototype = named("constant.second");
line(protoOf(constant()), protoOf(constant(5)), constant(undefined).next().value);
constant.prototype = 7;
line(protoOf(constant()), protoOf(constant(5)));
constant.prototype = null;
line(protoOf(constant()), protoOf(constant(5)));
constant.prototype = named("constant.third");
line(protoOf(constant()), protoOf(constant(5)));
named("constants", constants.prototype); named("literal", literal.prototype);
line(protoOf(constants()), constants().next().value, constants(2).next().value, constants(0, "b", 9).next().value, protoOf(literal()), literal().next().value, literal({ deep: true }, [1]).next().value);

// The default value changes the property.
function* stores(a = (stores.prototype = named("stores.by default"), 1)) { yield a; }
named("stores.first", stores.prototype);
line(protoOf(stores(0)), protoOf(stores()), protoOf(stores(0)));
function change(of, name, above = generatorPrototype) { of.prototype = named(name, Object.create(above)); return 1; }
function* calls(a = change(calls, "calls.by default")) { yield a; }
named("calls.first", calls.prototype);
line(protoOf(calls(0)), protoOf(calls()), protoOf(calls(0)));

// Only one arm of the head calls.
function* oneArm(a = 1, b = a > 1 ? change(oneArm, "oneArm.changed " + a) : 0) { yield a + b; }
named("oneArm.first", oneArm.prototype);
line(protoOf(oneArm()), protoOf(oneArm(1)), protoOf(oneArm(2)), protoOf(oneArm(1)), protoOf(oneArm(3, 0)), protoOf(oneArm(4)));

// The call stands in front of the branch, and behind it.
function* callFirst(a = change(callFirst, "callFirst.changed"), b = 2) { yield a + b; }
function* callLast(a = 1, b = change(callLast, "callLast.changed")) { yield a + b; }
named("callFirst.first", callFirst.prototype); named("callLast.first", callLast.prototype);
line(protoOf(callFirst(1, 1)), protoOf(callFirst(1)), protoOf(callFirst()), protoOf(callLast(1, 1)), protoOf(callLast()), protoOf(callLast(1, 1)));

// Getters, iterators and conversions in patterns.
function* pattern({ x = 1, y } = {}) { yield x + "," + y; }
named("pattern.first", pattern.prototype);
const sly = { get y() { pattern.prototype = named("pattern.by getter"); return 2; } };
line(protoOf(pattern()), protoOf(pattern({ x: 3 })), protoOf(pattern(sly)), protoOf(pattern()));
function* listPattern([first = 1, second] = []) { yield first + "," + second; }
named("listPattern.first", listPattern.prototype);
const slyList = { [Symbol.iterator]() { listPattern.prototype = named("listPattern.by iterator"); return [5, 6][Symbol.iterator](); } };
line(protoOf(listPattern()), protoOf(listPattern([1])), protoOf(listPattern(slyList)), listPattern(slyList).next().value);
function* computed({ [key()]: value = 0 } = {}) { yield value; }
function key() { computed.prototype = named("computed.by key"); return "k"; }
named("computed.first", computed.prototype);
line(protoOf(computed({ k: 1 })), computed({ k: 8 }).next().value);

// A head that throws gives no generator, and the change stays.
function* throwing(a = 1, b = a > 1 ? fail() : 0) { yield a + b; }
function fail() { throwing.prototype = named("throwing.changed"); throw new RangeError("head"); }
named("throwing.first", throwing.prototype);
try { throwing(2); } catch (error) { line(error.message); }
line(protoOf(throwing()));

// Methods, and functions that are handed around.
class Tree {
  *walk(depth = 0, step = depth ? 2 : 1) { yield depth + step; }
  static *make(count = 1) { yield count; }
}
named("walk", Tree.prototype.walk.prototype); named("make", Tree.make.prototype);
const tree = new Tree();
line(protoOf(tree.walk()), protoOf(tree.walk(1)), tree.walk(1).next().value, protoOf(Tree.make()), protoOf(Tree.make(2)));
Tree.prototype.walk.prototype = named("walk.second");
line(protoOf(tree.walk()), protoOf(tree.walk(1, 1)));
const handed = [constant, constants, oneArm, pattern];
line(handed.map(each => protoOf(each())).join(" | "), "|", handed.map(each => protoOf(Reflect.apply(each, undefined, [1]))).join(" | "));

// Each closure of a function has a property of its own.
const closures = [0, 1, 2].map(number => { function* inner(a = number) { yield a; } named("inner." + number, inner.prototype); return inner; });
line(closures.map(each => protoOf(each()) + ":" + each().next().value + ":" + each(9).next().value).join(" "));
closures[1].prototype = named("inner.1 again");
line(closures.map(each => protoOf(each(4))).join(" "));

// Often, with a change in the middle.
function* often(a = 1) { yield a; }
named("often.first", often.prototype);
const seen = new Map();
for (let round = 0; round < 20000; round++) {
  if (round === 12345) often.prototype = named("often.second");
  const name = protoOf(round & 1 ? often() : often(round));
  seen.set(name, (seen.get(name) ?? 0) + 1);
}
line([...seen].join(" "));

// Async generators.
async function* asyncConstant(a = 1) { yield a; }
async function* asyncCalls(a = change(asyncCalls, "asyncCalls.by default", asyncGeneratorPrototype), b = 2) { yield a + b; }
named("asyncConstant.first", asyncConstant.prototype); named("asyncCalls.first", asyncCalls.prototype);
line(protoOf(asyncConstant()), protoOf(asyncConstant(2)), protoOf(asyncCalls(1)), protoOf(asyncCalls()), protoOf(asyncCalls(1, 1)));
asyncConstant.prototype = named("asyncConstant.second", Object.create(asyncGeneratorPrototype));
line(protoOf(asyncConstant()), protoOf(asyncConstant(2)));
asyncConstant.prototype = undefined;
line(protoOf(asyncConstant()), protoOf(asyncConstant(2)));
line((await asyncConstant().next()).value, (await asyncConstant(3).next()).value, (await asyncCalls().next()).value);
//// the-jobs-of-coroutines-among-other-jobs.ts
// The jobs that finish a yield, resume a consumer and go on behind an await, each in its place among the jobs of promises, of queueMicrotask and of other coroutines.
import { AsyncLocalStorage } from "node:async_hooks";

const lines: string[] = [];
function log(line: string) { lines.push(line); }
////= show
////= ticks
function jobs(name: string, count: number) {
  let i = 0;
  const job = () => { log(name + " job " + i); if (++i < count) queueMicrotask(job); };
  queueMicrotask(job);
}
function later<T>(value: T, turns: number): Promise<T> {
  let promise: Promise<any> = Promise.resolve(value);
  for (let i = 0; i < turns; i++) promise = promise.then(x => x);
  return promise;
}
function fails(message: string, turns: number): Promise<never> {
  return later(0, turns).then(() => { throw new Error(message); });
}

async function* plain(name: string, count: number): AsyncGenerator<number, string> {
  for (let i = 0; i < count; i++) { log(name + " yields " + i); yield i; }
  return name + " end";
}
async function* waits(name: string, count: number, turns: number): AsyncGenerator<number, string> {
  for (let i = 0; i < count; i++) { log(name + " waits"); await later(0, turns); log(name + " yields " + i); yield i; }
  await null;
  return name + " end";
}
async function* relay(name: string, source: AsyncGenerator<number, string>): AsyncGenerator<number, string> {
  for await (const value of source) { log(name + " relays " + value); yield value + 100; }
  return name + " end";
}
async function loop(name: string, source: AsyncIterable<unknown>, stopAt?: unknown): Promise<string> {
  try {
    for await (const value of source) {
      log(name + " sees " + show(value));
      if (value === stopAt) { log(name + " leaves"); break; }
    }
    return name + " through";
  } catch (error) {
    return name + " caught " + show(error);
  }
}
async function scene(name: string, run: () => Promise<unknown>[] | Promise<unknown>) {
  log("== " + name);
  const started = run();
  for (const result of await Promise.allSettled(Array.isArray(started) ? started : [started])) log(name + ": " + show(result.status === "fulfilled" ? result.value : result.reason));
}

await scene("side by side", () => { ticks("a", 8); jobs("b", 8); return [loop("c", plain("d", 3)), loop("e", waits("f", 3, 1)), loop("g", plain("h", 2))]; });
await scene("relays", () => { ticks("a", 10); return [loop("b", relay("c", relay("d", plain("e", 3)))), loop("f", relay("g", waits("h", 2, 2)))]; });

async function* catches(name: string): AsyncGenerator<string> {
  try { await fails(name + " first", 1); } catch (error) { log(name + " caught " + show(error)); yield "recovered"; }
  try { yield fails(name + " yielded", 0) as never; } catch (error) { log(name + " caught " + show(error)); yield "again"; }
  await fails(name + " last", 2);
  yield "never";
}
await scene("rejections go into the body", () => { ticks("a", 12); jobs("b", 6); return [loop("c", catches("d")), loop("e", relay("f", catches("g") as never))]; });

async function* yieldsPromises(name: string): AsyncGenerator<unknown> {
  yield later(name + " later", 3);
  yield Promise.resolve(name + " settled");
  yield { then(resolve: (value: string) => void) { log(name + " then is called"); resolve(name + " thenable"); } };
  yield { value: 1, done: true };
  return later(name + " returned", 1);
}
await scene("what is yielded is awaited", () => { ticks("a", 14); return [loop("b", yieldsPromises("c")), loop("d", yieldsPromises("e"))]; });

await scene("requests by hand among the steps", () => {
  const generator = waits("a", 4, 1);
  ticks("b", 10);
  const first = generator.next().then(result => "by hand " + show(result));
  const looped = loop("c", { [Symbol.asyncIterator]: () => generator });
  const second = generator.next().then(result => "by hand " + show(result));
  return [first, looped, second];
});
await scene("closed while a job is queued", () => {
  const generator = plain("a", 5);
  const looped = loop("b", { [Symbol.asyncIterator]: () => generator });
  const closed = later(0, 2).then(() => generator.return("closed")).then(result => "return " + show(result));
  const thrown = later(0, 5).then(() => generator.throw(new Error("thrown in"))).then(result => "throw " + show(result), error => "throw failed " + show(error));
  jobs("c", 8);
  return [looped, closed, thrown];
});
await scene("left early", () => { ticks("a", 8); return [loop("b", relay("c", waits("d", 4, 1)), 101), loop("e", plain("f", 4), 0)]; });

const storage = new AsyncLocalStorage<string>();
async function* reads(name: string, count: number): AsyncGenerator<string> {
  for (let i = 0; i < count; i++) { await null; yield name + " made under " + storage.getStore(); }
}
async function readsLoop(name: string, source: AsyncGenerator<string>): Promise<string> {
  for await (const value of source) log(name + " under " + storage.getStore() + ": " + value);
  await null;
  return name + " ends under " + storage.getStore();
}
await scene("each under its own store", () => {
  const shared = storage.run("maker", () => reads("shared", 4));
  return [
    storage.run("one", () => readsLoop("a", reads("b", 3))),
    storage.run("two", () => readsLoop("c", reads("d", 3))),
    readsLoop("e", reads("f", 2)),
    storage.run("three", () => readsLoop("g", shared)),
  ];
});

async function step(generator: AsyncGenerator<number, string>): Promise<string> {
  const { value, done } = await generator.next();
  return show(value) + " " + done;
}
await scene("every step in a call of its own", async () => {
  const generator = waits("a", 2, 1);
  ticks("b", 12);
  const all: string[] = [];
  for (let i = 0; i < 4; i++) all.push(await step(generator));
  return all.join(", ");
});
await scene("many at once", () => {
  const all: Promise<string>[] = [];
  for (let i = 0; i < 6; i++) all.push(loop("l" + i, i % 2 ? relay("r" + i, plain("p" + i, i)) : waits("w" + i, i >> 1, i % 3)));
  return all;
});

async function* grows(count: number): AsyncGenerator<number[]> {
  for (let i = 0; i < count; i++) { await null; yield Array.from({ length: 50 }, (_, k) => k + i); }
}
await scene("with garbage", async () => {
  let sum = 0;
  for await (const list of grows(400)) sum += list[49];
  return sum;
});
async function* quiet(count: number, turns: number): AsyncGenerator<number> {
  for (let i = 0; i < count; i++) { if (turns) await later(0, turns); yield i; }
}
await scene("thousands at once", async () => {
  async function sumOf(source: AsyncIterable<number>): Promise<number> {
    let sum = 0;
    for await (const value of source) sum += value;
    return sum;
  }
  const all: Promise<number>[] = [];
  for (let i = 0; i < 6000; i++) {
    const generator = quiet(3, i % 3);
    if (i % 5 === 0) generator.next();
    all.push(sumOf(i % 2 ? generator : { [Symbol.asyncIterator]: () => generator }));
  }
  return (await Promise.all(all)).reduce((a, b) => a + b, 0);
});
await scene("a trace inside a body that a job resumed", async () => {
  async function* traced(): AsyncGenerator<boolean> { await null; yield String(new Error("here").stack).includes("traced"); }
  let seen = "";
  for await (const value of traced()) seen += value;
  return seen;
});

console.log(lines.join("\n"));
//// the-old-object-and-the-one-that-the-catch-of-a-generator-made-go-into-a-third.ts
// A generator gives a variable a new object in a catch. Behind the catch and a stop, the new object and the old one, which a constant still holds, go into a third: it holds two objects.
////= Point-2
class Other {
  x: number;
  y: number;
  tag = "other";
  constructor(x: number, y: number) {
    this.x = x;
    this.y = y;
  }
}
type Flat = Point | Other;
////= lines-3	Pair	public	a	Flat	b	Flat
const given: number[] = JSON.parse("[0.5]");
function fail(when: boolean): void {
  if (when) throw new Error("no");
}
function revived(o: Flat): Flat {
  return JSON.parse("[0]", (key, value) => (key === "0" ? o : value))[0];
}
function* run(p: number): Generator<unknown, string, unknown> {
  let out = "";
  let o1: Flat = revived(new Point(p, p * 2));
  const o2 = o1;
  try {
    yield fail(given[0] > p);
    out += o1.y;
  } catch {
    o1 = new Other(o1.x + 1, o1.y);
  }
  out += o2.x;
  yield p;
  out += " " + (o1 === o2);
  const pair = new Pair(o1, o2);
  out += " " + (pair.a === pair.b) + pair.a.x + "," + pair.b.x;
  return out;
}
const lines: string[] = [];
////= for
console.log(lines.join(" | "));
//// the-old-object-is-handed-to-a-method-of-the-one-that-the-catch-of-a-generator-made.ts
// A generator gives a variable a new object in a catch. Behind the catch, a call and a stop, the old object, which a constant still holds, is the argument of a method of the new one.
class Point {
  x: number;
  y: number;
  constructor(x: number, y: number) {
    this.x = x;
    this.y = y;
  }
  sum(other: Point): number {
    return this.x * 100 + other.x;
  }
}
const given: number[] = JSON.parse("[0.5, 1, 2]");
function show(o: unknown): string {
  if (o === null || typeof o !== "object") return String(o);
  return o.constructor.name;
}
function fail(when: boolean): void {
  if (when) throw new Error("no");
}
function* run(p: number): Generator<unknown, string, unknown> {
  let out = "";
  let o1 = new Point(p + 1, given[2]);
  const o2 = o1;
  try {
    yield p;
    fail(given[0] > p);
    o1.y;
  } catch {
    o1 = Object.assign(new Point(0, 0), o1, { x: o1.x + 1 });
  }
  o2.y += 1;
  out += show(o1);
  yield p;
  out += " " + o1.sum(o2) + "," + o2.sum(o1);
  return out;
}
const lines: string[] = [];
////= for
console.log(lines.join(" | "));
//// the-order-of-jobs-around-awaited-calls.js
// Async functions await each other's calls directly, in lists and through thenables. The order in which everything runs is written down.
import { AsyncLocalStorage } from "node:async_hooks";
const log = [];
const mark = t => { log.push(t); };
const ticks = (name, n) => { let p = Promise.resolve(); for (let i = 0; i < n; i++) p = p.then(() => mark(name + i)); };
const kinds = {
    value: () => 1, undefinedValue: () => undefined, promise: () => Promise.resolve("p"), rejected: () => Promise.reject(new Error("r")), pending: () => new Promise(r => setTimeout(() => r("t"), 1)),
    thenable: () => ({ then(ok) { mark("then called"); ok("th"); } }), slowThenable: () => ({ then(ok) { queueMicrotask(() => ok("slow")); } }), throwingThenable: () => ({ then() { throw new Error("tt"); } }), getterThenable: () => ({ get then() { mark("then read"); return undefined; } }),
    nonCallableThen: () => ({ then: 5 }), fn: () => function then() {}, subclass: () => (class P extends Promise {}).resolve("sub"), ownThen: () => { const p = Promise.resolve("o"); p.then = function (a, b) { mark("own then"); return Promise.prototype.then.call(this, a, b); }; return p; },
    otherConstructor: () => { const p = Promise.resolve("c"); p.constructor = function () {}; return p; }, asyncCall: () => leaf("inner"), self: () => null,
};
async function leaf(v) { mark("leaf " + v); return v; }
async function leafAwaits(v) { mark("leafAwaits in " + v); await null; mark("leafAwaits out " + v); return v; }
async function leafThrows(v) { mark("leafThrows " + v); throw new Error("thrown " + v); }
async function leafThrowsLate(v) { await null; throw new Error("late " + v); }
async function returns(make) { mark("returns in"); return make(); }
async function returnsAwait(make) { mark("returnsAwait in"); return await make(); }
async function returnsInTry(make) { try { return make(); } finally { mark("finally"); } }
async function direct(f, x) { mark("direct in"); try { const v = await f(x); mark("direct got " + text(v)); return v; } catch (e) { mark("direct caught " + e.message); return "c"; } }
async function twoDeep(f, x) { const v = await direct(f, x); mark("twoDeep got " + text(v)); return v; }
async function kept(f, x) { const p = f(x); mark("kept has " + (p instanceof Promise)); const v = await p; mark("kept got " + text(v)); return v; }
async function keptTwice(f, x) { const p = f(x); const a = await p, b = await p; mark("keptTwice " + text(a) + text(b)); p.then(v => mark("then on kept " + text(v))); return a; }
const text = v => v === null ? "null" : typeof v === "object" || typeof v === "function" ? typeof v : String(v);
async function scene(title, run) { log.push("== " + title); ticks("t", 8); try { mark("result " + text(await run())); } catch (e) { mark("failed " + (e && e.message)); } await new Promise(r => setTimeout(r, 3)); }
for (const [k, make] of Object.entries(kinds)) for (const outer of [returns, returnsAwait, returnsInTry]) for (const how of [direct, twoDeep, kept, keptTwice]) await scene(k + " " + outer.name + " " + how.name, () => how(outer, make));
for (const f of [leaf, leafAwaits, leafThrows, leafThrowsLate]) for (const how of [direct, twoDeep, kept, keptTwice]) await scene(f.name + " " + how.name, () => how(f, 1));
for (const name of ["all", "allSettled", "race", "any"]) {
    await scene(name + " of calls", async () => JSON.stringify(await Promise[name]([leaf(1), leafAwaits(2), leaf(3)])));
    await scene(name + " with a throw", async () => JSON.stringify(await Promise[name]([leaf(1), leafThrows(2), leafThrowsLate(3), leafAwaits(4)])));
    await scene(name + " of mixed", async () => JSON.stringify(await Promise[name]([leaf(1), 2, kinds.thenable(), Promise.resolve(4), returns(kinds.thenable), returns(kinds.promise)])));
    await scene(name + " of none", async () => name === "race" ? "never" : JSON.stringify(await Promise[name]([])));
    await scene(name + " of many", async () => JSON.stringify(await Promise[name](Array.from({ length: 300 }, (_, i) => i % 2 ? leaf(i) : leafAwaits(i)))).length);
    await scene(name + " mapped", async () => JSON.stringify(await Promise[name]([1, 2, 3].map(leafAwaits))));
    await scene(name + " of an iterable", async () => JSON.stringify(await Promise[name]((function* () { yield leaf(1); mark("between"); yield leafAwaits(2); })())));
}
