// The object Promise.withResolvers returns: its keys in creation order, its prototype, and functions that settle its promise.
const first = Promise.withResolvers()
console.log(Object.keys(first).join(), Object.getPrototypeOf(first) === Object.prototype, first.promise instanceof Promise, typeof first.resolve, typeof first.reject)
console.log(JSON.stringify(Object.getOwnPropertyDescriptor(first, "promise"), (key, value) => (key === "value" ? "promise" : value)))

const { promise, resolve } = Promise.withResolvers()
resolve(1)
const rejected = Promise.withResolvers()
rejected.reject(new Error("no"))
console.log(await promise, await rejected.promise.catch(error => error.message))

first.extra = 2
delete first.reject
console.log(Object.keys(first).join())
first.resolve("late")
console.log(await first.promise)

class Tracked extends Promise {}
const tracked = Promise.withResolvers.call(Tracked)
tracked.resolve(3)
console.log(tracked.promise instanceof Tracked, Object.keys(tracked).join(), await tracked.promise)
//// yield-star-and-for-await-over-values-nobody-knows.js
// `yield*` and `for await` over values that went through text evaluated at run time, so the build knows nothing about them: generators of the program as they were made,
// with a `next` of their own, under another prototype, already running or finished, and arrays, strings, sets and iterators written by hand. What is sent in, thrown in and
// returned in goes to the inner iterator, and every kind of value answers as the language says.
const lines = [];
const note = (label, ...values) => lines.push(label + ": " + values.map(value => (value === undefined ? "undefined" : JSON.stringify(value))).join(" "));
const hidden = new Function("v", "return v" + String(lines.length).slice(1));

function* numbers(label) {
    try {
        const a = yield label + 1;
        const b = yield label + 2 + String(a);
        return label + "done" + String(b);
    } catch (error) {
        yield label + "caught" + error;
        return label + "after catch";
    } finally {
        note("finally", label);
    }
}
function* delegate(inner) {
    const result = yield* inner;
    note("result of yield*", result);
    return result;
}
function drain(label, inner) {
    const outer = delegate(hidden(inner));
    const seen = [];
    let sent = 0;
    for (let step = outer.next(); ; step = outer.next("s" + ++sent)) {
        seen.push(step.value);
        if (step.done) break;
    }
    note(label, ...seen);
}
drain("generator", numbers("g"));
drain("array", [1, 2]);
drain("string", "a\u{1F600}b");
drain("set", new Set(["x", "y"]));
drain("map", new Map([["k", 1]]));
drain("typed array", new Uint8Array([5, 6]));
drain("arguments", (function () { return arguments; })(8, 9));

const ownNext = numbers("own");
ownNext.next = function (value) { return { done: value === "s2", value: "own next " + value }; };
drain("own next", ownNext);

const otherPrototype = numbers("proto");
Object.setPrototypeOf(otherPrototype, {
    [Symbol.iterator]() { return this; },
    next(value) { return { done: value !== undefined, value: "other prototype " + value }; },
});
drain("other prototype", otherPrototype);

const ownIterator = numbers("iter");
ownIterator[Symbol.iterator] = function () { return [10, 20][Symbol.iterator](); };
drain("own @@iterator", ownIterator);

const started = numbers("started");
started.next();
drain("started", started);

const finished = numbers("finished");
finished.return("early");
drain("finished", finished);

function throwsIn(label, inner) {
    const outer = delegate(hidden(inner));
    try {
        note(label, outer.next().value, outer.throw("boom").value, outer.next().value, outer.next().done);
    } catch (error) {
        note(label + " threw", error instanceof TypeError ? "TypeError" : error);
    }
}
throwsIn("throw into generator", numbers("t"));
throwsIn("throw into array", [1, 2, 3]);
throwsIn("throw into hand-written", {
    [Symbol.iterator]() { return this; },
    next() { return { done: false, value: "n" }; },
    throw(error) { return { done: false, value: "handled " + error }; },
});

function returnsIn(label, inner) {
    const outer = delegate(hidden(inner));
    note(label, outer.next().value, outer.return("out"), outer.next());
}
returnsIn("return into generator", numbers("r"));
returnsIn("return into array", [1, 2, 3]);
returnsIn("return into hand-written", {
    [Symbol.iterator]() { return this; },
    next() { return { done: false, value: "n" }; },
    return(value) { return { done: false, value: "not yet " + value }; },
});

function* running() {
    try {
        yield* hidden(self);
    } catch (error) {
        note("delegating to itself", error instanceof TypeError);
    }
}
const self = running();
self.next();

for (const value of [undefined, null, 1, {}, () => {}]) {
    try {
        delegate(hidden(value)).next();
        note("no error", typeof value);
    } catch (error) {
        note("not iterable", String(value), error instanceof TypeError);
    }
}

async function* asyncNumbers(label, count) {
    try {
        for (let i = 0; i < count; i++) yield label + i;
        return label + "done";
    } finally {
        note("async finally", label);
    }
}
async function collect(label, iterable, limit = 10) {
    const seen = [];
    try {
        for await (const value of hidden(iterable)) {
            seen.push(value);
            if (seen.length === limit) break;
        }
    } catch (error) {
        seen.push(error instanceof TypeError ? "TypeError" : error);
    }
    note(label, ...seen);
}
async function* asyncDelegate(inner) {
    return yield* hidden(inner);
}
await collect("async generator", asyncNumbers("a", 3));
await collect("broken off", asyncNumbers("b", 3), 2);
await collect("sync generator", numbers("s"));
await collect("array of promises", [Promise.resolve(1), 2, Promise.resolve(3)]);
await collect("rejected element", [1, Promise.reject("no")]);
await collect("through yield*", asyncDelegate(asyncNumbers("d", 2)));
await collect("sync through yield*", asyncDelegate(["p", Promise.resolve("q")]));

const asyncOwnNext = asyncNumbers("own", 3);
asyncOwnNext.next = async function () { return { done: true }; };
await collect("async own next", asyncOwnNext);

const asyncOtherPrototype = asyncNumbers("proto", 3);
let turns = 0;
Object.setPrototypeOf(asyncOtherPrototype, {
    [Symbol.asyncIterator]() { return this; },
    next() { return Promise.resolve({ done: ++turns > 2, value: "turn " + turns }); },
});
await collect("async other prototype", asyncOtherPrototype);

const order = [];
const first = (async () => { for await (const value of hidden(asyncNumbers("x", 3))) order.push(value); })();
const second = (async () => { for await (const value of hidden(asyncNumbers("y", 3))) order.push(value); })();
let ticks = Promise.resolve();
for (let i = 0; i < 12; i++) ticks = ticks.then(() => order.push("tick" + i));
await Promise.all([first, second, ticks]);
note("two loops and a ticker", ...order);

for (const value of [undefined, null, 1, {}]) await collect("not async iterable " + String(value), value);
console.log(lines.join("\n"));
//// yield-star-and-for-await-sources.js
// `yield*` and `for await` over each kind of source the iterator operations tell apart.
const log = (...parts) => console.log(parts.join(" "));

function* numbers() {
  try {
    yield 1;
    yield 2;
  } finally {
    log("numbers finally");
  }
}

function withOwnNext() {
  const generator = numbers();
  const next = generator.next;
  generator.next = function (value) {
    log("own next");
    return next.call(this, value);
  };
  return generator;
}

function* customized() {
  yield "sync";
}
customized.prototype[Symbol.asyncIterator] = function () {
  log("Symbol.asyncIterator");
  let index = 0;
  return {
    next() {
      log("async next");
      return Promise.resolve({ done: index >= 1, value: "async " + index++ });
    },
    return() {
      log("async return");
      return Promise.resolve({});
    },
  };
};

function syncOnly() {
  return {
    [Symbol.iterator]() {
      log("Symbol.iterator");
      let index = 0;
      return {
        next() {
          log("sync next");
          return {
            get done() {
              log("get done");
              return index >= 2;
            },
            get value() {
              log("get value");
              return index++;
            },
          };
        },
        return() {
          log("sync return");
          return {};
        },
      };
    },
  };
}

const sources = [
  ["generator", () => numbers()],
  ["own next", withOwnNext],
  ["prototype with Symbol.asyncIterator", () => customized()],
  ["array", () => [1, Promise.resolve(2)]],
  ["sync iterator only", syncOnly],
  ["number", () => 5],
];

async function* delegateAsync(source) {
  yield* source;
}

function* delegateSync(source) {
  yield* source;
}

async function attempt(label, body) {
  log("--", label);
  try {
    await body();
  } catch (error) {
    log(label, "threw", error instanceof Error ? error.name : String(error));
  }
}

async function main() {
  for (const [name, create] of sources) {
    await attempt("sync yield* over " + name, () => {
      for (const value of delegateSync(create())) log("value", value instanceof Promise ? "promise" : value);
    });
    await attempt("async yield* over " + name, async () => {
      for await (const value of delegateAsync(create())) log("value", value);
    });
    await attempt("for await over " + name, async () => {
      for await (const value of create()) log("value", value);
    });
    await attempt("for await with break over " + name, async () => {
      for await (const value of create()) {
        log("value", value);
        break;
      }
    });
  }

  await attempt("Symbol.asyncIterator is not callable", async () => {
    for await (const value of { [Symbol.asyncIterator]: 5 }) log("value", value);
  });
  await attempt("Symbol.asyncIterator returns a primitive", async () => {
    for await (const value of { [Symbol.asyncIterator]: () => 5 }) log("value", value);
  });
  await attempt("Symbol.iterator returns a primitive under yield*", () => {
    for (const value of delegateSync({ [Symbol.iterator]: () => 5 })) log("value", value);
  });

  await attempt("unmodified generators", async () => {
    async function* asyncNumbers() {
      yield 1;
      yield 2;
    }
    const values = [];
    for (const value of delegateSync(numbers())) values.push(value);
    for await (const value of delegateAsync(asyncNumbers())) values.push(value);
    for await (const value of asyncNumbers()) values.push(value);
    for await (const value of numbers()) values.push(value);
    log(values.join());
  });
}

main();
//// yield-star-forwarding.ts
// `yield*` from one async generator of the program to another: the step that is forwarded awaits nothing. Chains of one to four delegations over sources that wait, do not wait,
// or wait now and then; what the innermost returns comes out as the value of each `yield*`; next(v), throw(e) and return(v) go in to the innermost; who pulls at the top: `for await`,
// next() written out in a function or in a generator, then(); alone, beside other jobs with a ticker that shows every turn of the queue, and two chains at once.
let log: string[] = [];
////= note-2
type Stream = AsyncGenerator<unknown, unknown, unknown>;
const sources: [string, () => Stream][] = [
    ["waits", async function* () { for (let i = 0; i < 3; i++) { await outside(); yield { n: i }; } return "waits is over"; }],
    ["does not wait", async function* () { yield 1; yield "two"; yield { n: 3 }; return "does not wait is over"; }],
    ["waits now and then", async function* () { yield "a"; await outside(); yield "b"; yield "c"; await outside(); return { last: true }; }],
    ["empty", async function* () { return "empty is over"; }],
    ["empty behind a wait", async function* () { await outside(); return "empty behind a wait is over"; }],
    ["listens", async function* () { const first = yield "say something"; await outside(); const second = yield "heard " + JSON.stringify(first); return "last heard " + JSON.stringify(second); }],
    ["cleans up", async function* () { try { await outside(); yield 1; yield 2; return "ran through"; } catch (error) { note("innermost caught " + (error as Error).message); yield 99; return "behind the catch"; } finally { note("innermost finally"); } }],
    ["throws", async function* () { yield 1; await outside(); throw new Error("thrown by the innermost"); }],
    ["queues a job ahead of a yield", async function* () { await outside(); Promise.resolve().then(() => note("the innermost's job")); yield 1; yield 2; }],
    ["yields promises", async function* () { yield Promise.resolve("fulfilled"); yield outside().then(() => "was pending"); }],
];
async function* forwards(inner: Stream, label: string): Stream {
    const returned = yield* inner;
    note(label + " sees " + JSON.stringify(returned));
    return returned;
}
async function* forwardsBetweenItsOwn(inner: Stream): Stream {
    yield "ahead";
    const returned = yield* inner;
    yield "behind";
    return returned;
}
async function* forwardsBehindAWait(inner: Stream): Stream {
    await outside();
    return yield* inner;
}
function chain(make: () => Stream, depth: number): Stream {
    let stream = make();
    for (let i = 1; i <= depth; i++) stream = forwards(stream, "layer " + i);
    return stream;
}
////= lines-39	byLoop(stream: Stream	stream
async function byNext(stream: Stream): Promise<void> {
    try {
        for (let i = 0; ; i++) {
            const step = await stream.next("sent " + i);
            note((step.done ? "done " : "step ") + JSON.stringify(step.value));
            if (step.done) return;
        }
    } catch (error) {
        note("caught " + (error as Error).message);
    }
}
async function* byNextInAGenerator(stream: Stream): AsyncGenerator<string> {
    try {
        for (;;) {
            const step = await stream.next();
            yield (step.done ? "done " : "step ") + JSON.stringify(step.value);
            if (step.done) return;
        }
    } catch (error) {
        yield "caught " + (error as Error).message;
    }
}
function byThen(stream: Stream): Promise<void> {
    return new Promise(resolve => {
        const pull = (): void => { stream.next().then(step => { note((step.done ? "done " : "step ") + JSON.stringify(step.value)); if (step.done) resolve(); else pull(); }, error => { note("then caught " + error.message); resolve(); }); };
        pull();
    });
}
async function thrownInto(stream: Stream): Promise<void> {
    try {
        note("first " + JSON.stringify(await stream.next()));
        note("thrown into " + JSON.stringify(await stream.throw(new Error("from outside"))));
        note("then " + JSON.stringify(await stream.next()));
        note("then " + JSON.stringify(await stream.next()));
    } catch (error) {
        note("caught " + (error as Error).message);
    }
}
async function returnedInto(stream: Stream): Promise<void> {
    try {
        note("first " + JSON.stringify(await stream.next()));
        note("returned into " + JSON.stringify(await stream.return("given up")));
        note("then " + JSON.stringify(await stream.next()));
    } catch (error) {
        note("caught " + (error as Error).message);
    }
}
async function severalAtOnce(stream: Stream): Promise<void> {
    const steps = await Promise.allSettled([stream.next(), stream.next(), stream.next(), stream.next(), stream.next()]);
    for (const step of steps) note(step.status === "fulfilled" ? (step.value.done ? "done " : "step ") + JSON.stringify(step.value.value) : "rejected " + step.reason.message);
}
const lines: string[] = [];
////= scene
for (const [kind, make] of sources) {
    for (const depth of [1, 2, 4]) {
        await scene(kind + ", " + depth + " deep, a loop", () => byLoop(chain(make, depth)));
        await scene(kind + ", " + depth + " deep, next", () => byNext(chain(make, depth)));
    }
    await scene(kind + ", a loop beside jobs", () => Promise.all([ticker("t", 24), byLoop(chain(make, 2))]));
    await scene(kind + ", next beside jobs", () => Promise.all([ticker("t", 24), byNext(chain(make, 2))]));
    await scene(kind + ", next in a generator", () => byLoop(byNextInAGenerator(chain(make, 2))));
    await scene(kind + ", then", () => byThen(chain(make, 2)));
    await scene(kind + ", between its own", () => byLoop(forwardsBetweenItsOwn(chain(make, 1))));
    await scene(kind + ", behind a wait", () => byNext(forwardsBehindAWait(chain(make, 1))));
    await scene(kind + ", thrown into", () => thrownInto(chain(make, 2)));
    await scene(kind + ", returned into", () => returnedInto(chain(make, 2)));
    await scene(kind + ", several at once", () => severalAtOnce(chain(make, 2)));
    await scene(kind + ", two chains at once", () => Promise.all([byLoop(chain(make, 2)), byNext(chain(make, 3))]));
}
console.log(lines.join("\n"));
//// yield-star-over-declared-iterator-classes.ts
// yield* over objects whose Symbol.iterator is declared to return a class with next(), and { value, done } literals that are only read
const lines: string[] = [];
////= say
class Mine extends Error {}
////= attempt

////= Effect
class OneShot {
  called = false;
  constructor(readonly self: Effect) {}
  next(sent?: number): IteratorResult<Effect, number> {
    if (this.called) return { value: sent ?? -1, done: true };
    this.called = true;
    return { value: this.self, done: false };
  }
}
function* program(effects: Effect[]): Generator<Effect, number, number> {
  let sum = 0;
  for (const effect of effects) sum += yield* effect;
  return sum;
}
function run(iterator: Generator<Effect, number, number>, log?: unknown[]): number {
  let step = iterator.next(0);
  while (!step.done) {
    log?.push(step.value.value);
    step = iterator.next(step.value.value * 2);
  }
  return step.value;
}
{
  const log: unknown[] = [];
  say("as declared", run(program([new Effect(1), new Effect(2), new Effect(3)]), log), log);
  say("none", run(program([])));
}

class Twice extends OneShot {
  count = 0;
  override next(sent?: number): IteratorResult<Effect, number> {
    if (this.count++ < 2) return { value: this.self, done: false };
    return { value: (sent ?? 0) + 1000, done: true };
  }
}
class YieldsTwice extends Effect {
  override [Symbol.iterator](): OneShot {
    return new Twice(this);
  }
}
{
  const log: unknown[] = [];
  say("a subclass of the iterator class", run(program([new YieldsTwice(5), new Effect(1)]), log), log);
}
class LooksAlike extends Effect {
  override [Symbol.iterator](): OneShot {
    let calls = 0;
    const self = this;
    return {
      next(sent?: number) {
        return calls++ ? { value: (sent ?? 0) + 7, done: true } : { value: self, done: false };
      },
    } as unknown as OneShot;
  }
}
say("an object that only looks like the class", run(program([new LooksAlike(4), new Effect(1)])));
class GivesGenerator extends Effect {
  override [Symbol.iterator](): OneShot {
    const self = this;
    return (function* (): Generator<Effect, number, number> {
      const first = yield self;
      const second = yield self;
      return first + second;
    })() as unknown as OneShot;
  }
}
say("a generator in its place", run(program([new GivesGenerator(3), new Effect(1)])));

{
  const log: string[] = [];
  class Watched extends OneShot {
    override next(sent?: number): IteratorResult<Effect, number> {
      log.push(`next(${sent})`);
      return super.next(sent);
    }
    return(value: number): IteratorResult<Effect, number> {
      log.push(`return(${value})`);
      return { value: value + 1, done: true };
    }
    throw(error: unknown): IteratorResult<Effect, number> {
      log.push(`throw(${error})`);
      return { value: 50, done: true };
    }
  }
  class GivesWatched extends Effect {
    override [Symbol.iterator](): OneShot {
      log.push("Symbol.iterator");
      return new Watched(this);
    }
  }
  const returned = program([new GivesWatched(1), new GivesWatched(2)]);
  say("return() goes to the iterator", returned.next(0).done, returned.return(9), returned.next(0), log);
  log.length = 0;
  const thrown = program([new GivesWatched(1), new GivesWatched(2)]);
  say("throw() goes to the iterator", thrown.next(0).done, thrown.throw("t").done, thrown.next(4), log);
  log.length = 0;
  const plain = program([new Effect(1)]);
  plain.next(0);
  attempt("throw() where the class has none", () => plain.throw(new Mine("no throw method")));
  const alsoPlain = program([new Effect(1)]);
  alsoPlain.next(0);
  say("return() where the class has none", alsoPlain.return(3), alsoPlain.next(0));
}
{
  class Throws extends OneShot {
    override next(): IteratorResult<Effect, number> {
      throw new Mine("next threw");
    }
  }
  class GivesThrows extends Effect {
    override [Symbol.iterator](): OneShot {
      return new Throws(this);
    }
  }
  const iterator = program([new GivesThrows(1)]);
  attempt("next() throws", () => iterator.next(0));
  say("then", iterator.next(0));
}
{
  const original = OneShot.prototype.next;
  const iterator = program([new Effect(1), new Effect(2)]);
  const first = iterator.next(0);
  OneShot.prototype.next = function (this: OneShot, sent?: number) {
    return { value: (sent ?? 0) + 100000, done: true };
  };
  const rest = [iterator.next(5), iterator.next(6)];
  OneShot.prototype.next = original;
  say("next replaced on the prototype between delegations", first.done, rest);
}

{
  const own = new Effect(1);
  Object.defineProperty(own, Symbol.iterator, {
    value() {
      return new OneShot(new Effect(42));
    },
  });
  const log: unknown[] = [];
  say("an effect with its own Symbol.iterator", run(program([own, new Effect(2)]), log), log);
  const odd: any[] = [5, null];
  class GivesNumber extends Effect {
    override [Symbol.iterator](): OneShot {
      return odd[0];
    }
  }
  attempt("Symbol.iterator returns a number", () => run(program([new GivesNumber(1)])));
  class GivesNull extends Effect {
    override [Symbol.iterator](): OneShot {
      return odd[1];
    }
  }
  attempt("Symbol.iterator returns null", () => run(program([new GivesNull(1)])));
  class ThrowsAtOpening extends Effect {
    override [Symbol.iterator](): OneShot {
      throw new Mine("while opening");
    }
  }
  const iterator = program([new ThrowsAtOpening(1)]);
  attempt("Symbol.iterator throws", () => iterator.next(0));
  say("then", iterator.next(0));
  const hidden = new Effect(3);
  Object.defineProperty(hidden, Symbol.iterator, { value: undefined });
  attempt("its own Symbol.iterator is undefined", () => run(program([hidden])));
}

function onlyRead(x: number): number {
  const result = { value: x * 2, done: x > 3 };
  return result.done ? result.value : -result.value;
}
function merged(x: number): number {
  const result = x & 1 ? { value: x, done: true } : { value: x + 100, done: false };
  return result.done ? result.value : result.value + 1;
}
function kept(x: number): { value: number; done: boolean } {
  const result = { value: x, done: false };
  if (result.done) return { value: -1, done: true };
  return result;
}
function compared(x: number): boolean {
  const a = { value: x, done: true };
  const b = { value: x, done: true };
  return (a as unknown) === b || a.value !== b.value;
}
function written(x: number): number {
  const result = { value: x, done: false };
  result.value += 5;
  result.done = true;
  return result.done ? result.value : 0;
}
function otherOrder(x: number): string {
  const result = { done: x > 0, value: x };
  return Object.keys(result).join() + result.value + result.done;
}
function third(x: number): number {
  const result = { value: x, done: true, extra: 1 };
  return result.value + result.extra + (result.done ? 1 : 0);
}
function nested(x: number): number {
  const inner = { value: x, done: true };
  const outer = { value: inner, done: false };
  return outer.done ? 0 : outer.value.value;
}
function notBoolean(x: number): unknown {
  const result = { value: x, done: x as unknown };
  return [result.done, result.value];
}
function missing(x: number): unknown {
  const result: { value: number; done: boolean; other?: number } = { value: x, done: true };
  return [result.other, "toString" in result, result.value];
}
function inLoop(n: number): number {
  let result = { value: 0, done: false };
  while (!result.done) result = { value: result.value + 3, done: result.value > n };
  return result.value;
}
say("literals", onlyRead(2), onlyRead(5), merged(1), merged(2), kept(3), compared(1), written(1), otherOrder(2), third(3), nested(4), notBoolean(5), missing(6), inLoop(20));

{
  let total = 0;
  const effects: Effect[] = [];
  for (let i = 0; i < 500; i++) effects.push(new Effect(i));
  for (let round = 0; round < 40; round++) total += run(program(effects));
  say("many", total);
}

console.log(lines.join("\n"));
