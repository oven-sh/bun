//// thenable-test-per-object.ts
// An awaited or returned object is tested for `then` by itself: an instance of a Map subclass and an instance with an undeclared property pass through, a `then` on the class prototype is honored by every instance, and an own `then` by that instance alone.
const log: string[] = [];

type Resolve = (value: unknown) => void;
type Then = (resolve: Resolve) => void;

class Registry extends Map<string, number> {
  total(): number {
    let sum = 0;
    for (const value of this.values()) sum += value;
    return sum;
  }
}
class Inbox extends Map<string, number> {}
class Outbox extends Map<string, number> {}
class Deferred extends Map<string, number> {
  then(resolve: Resolve): void {
    log.push(`then of Deferred(${this.size})`);
    resolve(`adopted from Deferred(${this.size})`);
  }
}
////= Ticket
////= lines-11	Parcel	public	id	number

const returnRegistry = async (value: Registry): Promise<unknown> => value;
const awaitRegistry = async (value: Registry): Promise<unknown> => await value;
const returnInbox = async (value: Inbox): Promise<unknown> => value;
const awaitInbox = async (value: Inbox): Promise<unknown> => await value;
const returnOutbox = async (value: Outbox): Promise<unknown> => value;
const awaitOutbox = async (value: Outbox): Promise<unknown> => await value;
const returnDeferred = async (value: Deferred): Promise<unknown> => value as unknown;
const awaitDeferred = async (value: Deferred): Promise<unknown> => await (value as unknown);
const returnTicket = async (value: Ticket): Promise<unknown> => value;
const awaitTicket = async (value: Ticket): Promise<unknown> => await value;
const returnParcel = async (value: Parcel): Promise<unknown> => value;
const awaitParcel = async (value: Parcel): Promise<unknown> => await value;

function describe(value: unknown): string {
  if (value instanceof Map) return `Map(${value.size})`;
  if (typeof value === "object") return JSON.stringify(value);
  return String(value);
}

////= adopt

////= observe

async function mapSubclassPrototype(): Promise<void> {
  const first = new Registry();
  await observe("registry, nothing read from its class", returnRegistry(first), awaitRegistry(first));
  first.set("a", 1).set("b", 2);
  log.push(`total ${first.total()}`);
  await observe("registry with entries", returnRegistry(first), awaitRegistry(first));
  (first as any).note = "undeclared";
  await observe("registry with an undeclared property", returnRegistry(first), awaitRegistry(first));

  (Registry.prototype as any).then = function (this: Registry, resolve: Resolve): void {
    log.push(`then of Registry(${this.size})`);
    resolve(`adopted from Registry(${this.size})`);
  };
  const second = new Registry();
  await observe("registry created before its class gained then", returnRegistry(first), awaitRegistry(first));
  await observe("registry created after its class gained then", returnRegistry(second), awaitRegistry(second));
  delete (Registry.prototype as any).then;
  await observe("first registry after its class lost then", returnRegistry(first), awaitRegistry(first));
  await observe("second registry after its class lost then", returnRegistry(second), awaitRegistry(second));
}

async function mapSubclassInstances(): Promise<void> {
  const plain = new Inbox();
  const thenable = new Inbox();
  const sibling = new Inbox();
  await observe("inbox", returnInbox(plain), awaitInbox(plain));
  (thenable as any).then = adopt("inbox");
  await observe("inbox with an own then", returnInbox(thenable), awaitInbox(thenable));
  await observe("inbox tested before", returnInbox(plain), awaitInbox(plain));
  await observe("inbox not tested before", returnInbox(sibling), awaitInbox(sibling));
  const late = new Inbox();
  await observe("inbox created afterward", returnInbox(late), awaitInbox(late));
  (sibling as any).note = "undeclared";
  await observe("inbox with another own property", returnInbox(sibling), awaitInbox(sibling));
  delete (thenable as any).then;
  await observe("inbox after its own then is deleted", returnInbox(thenable), awaitInbox(thenable));

  const firstTested = new Outbox();
  (firstTested as any).then = adopt("outbox");
  await observe("outbox with an own then, first of its class", returnOutbox(firstTested), awaitOutbox(firstTested));
  const other = new Outbox();
  await observe("outbox, second of its class", returnOutbox(other), awaitOutbox(other));
}

async function mapSubclassMethod(): Promise<void> {
  const deferred = new Deferred();
  await observe("declared then, nothing read from its class", returnDeferred(deferred), awaitDeferred(deferred));
  deferred.set("a", 1);
  await observe("declared then, again", returnDeferred(deferred), awaitDeferred(deferred));
}

async function undeclaredProperties(): Promise<void> {
  const noted = new Ticket(1);
  (noted as any).note = "undeclared";
  await observe("ticket with an undeclared property, nothing read from its class", returnTicket(noted), awaitTicket(noted));
  const plain = new Ticket(2);
  await observe("ticket", returnTicket(plain), awaitTicket(plain));
  const thenable = new Ticket(3);
  (thenable as any).note = "undeclared";
  (thenable as any).then = adopt("ticket 3 itself");
  await observe("ticket with an undeclared property and an own then", returnTicket(thenable), awaitTicket(thenable));
  await observe("ticket with an undeclared property, again", returnTicket(noted), awaitTicket(noted));
  await observe("ticket, again", returnTicket(plain), awaitTicket(plain));

  (Ticket.prototype as any).then = function (this: Ticket, resolve: Resolve): void {
    log.push(`then of ${this.label()}`);
    resolve(`adopted from ${this.label()}`);
  };
  await observe("class gained then, ticket with an undeclared property", returnTicket(noted), awaitTicket(noted));
  await observe("class gained then, ticket", returnTicket(plain), awaitTicket(plain));
  await observe("class gained then, ticket with an own then", returnTicket(thenable), awaitTicket(thenable));
  delete (Ticket.prototype as any).then;
  await observe("class lost then, ticket with an undeclared property", returnTicket(noted), awaitTicket(noted));
  await observe("class lost then, ticket with an own then", returnTicket(thenable), awaitTicket(thenable));
  (noted as any).then = adopt("ticket 1 itself");
  await observe("undeclared property first, own then second", returnTicket(noted), awaitTicket(noted));

  const firstTested = new Parcel(1);
  (firstTested as any).then = adopt("parcel 1");
  await observe("parcel with an own then, first of its class", returnParcel(firstTested), awaitParcel(firstTested));
  const other = new Parcel(2);
  (other as any).note = "undeclared";
  await observe("parcel with another undeclared property", returnParcel(other), awaitParcel(other));
  (other as any).then = 5;
  await observe("parcel whose own then is not callable", returnParcel(other), awaitParcel(other));
}

async function main(): Promise<void> {
  await mapSubclassPrototype();
  await mapSubclassInstances();
  await mapSubclassMethod();
  await undeclaredProperties();
  console.log(log.join("\n"));
}

main();

export {};
//// throw-after-resume-rejects.ts
let middleFinallyRuns = 0;

function inner(value: number): number {
  throw new RangeError("inner " + value);
}
function middle(value: number): number {
  try {
    return inner(value + 1) + 1;
  } finally {
    middleFinallyRuns++;
  }
}
function messageOf(error: unknown): string {
  return error instanceof RangeError ? error.message : "another error";
}

async function rejectsAfterResume(gate: Promise<number>, seed: number): Promise<number> {
  const offset = seed * 2 + 1;
  const resumed = await gate;
  return middle(resumed) + offset;
}
async function catchesAfterResume(gate: Promise<number>, seed: number): Promise<string> {
  const offset = seed * 2 + 1;
  const resumed = await gate;
  try {
    return "returned " + (middle(resumed) + offset);
  } catch (error) {
    return "caught " + messageOf(error) + " " + offset;
  }
}

async function awaitingCaller(seed: number): Promise<string> {
  const whole = seed * 3 + 1, fraction = seed + 0.5, text = "s" + seed, object = { value: seed * 5 + 2 }, list = [seed, seed + 2];
  let release: (value: number) => void = () => {};
  const gate = new Promise<number>(resolve => { release = resolve; });
  const rejecting = rejectsAfterResume(gate, seed);
  const catching = catchesAfterResume(gate, seed);
  release(seed * 7);
  let outcome = "";
  try {
    outcome = "resolved " + (await rejecting);
  } catch (error) {
    outcome = "rejected " + messageOf(error);
  }
  return [outcome, await catching, whole, fraction, text, object.value, list.join("+")].join(" | ");
}

function* throwsThroughCall(seed: number) {
  yield seed;
  yield middle(seed);
  yield seed + 1;
}
function* catchesInBody(seed: number) {
  yield seed;
  try {
    yield middle(seed);
  } catch (error) {
    yield messageOf(error);
  }
  yield seed + 1;
}

function stepGenerators(): void {
  const throwing = throwsThroughCall(10);
  console.log(throwing.next());
  try {
    console.log(throwing.next());
  } catch (error) {
    console.log("generator threw", messageOf(error));
  }
  console.log(throwing.next());

  const catching = catchesInBody(20);
  for (let step = catching.next(); !step.done; step = catching.next())
    console.log(step.value);
  console.log(catching.next());
}

async function main(): Promise<void> {
  console.log(await awaitingCaller(4));
  console.log("finally runs", middleFinallyRuns);
  stepGenerators();
  console.log("finally runs", middleFinallyRuns);
}
main();
//// typed-async-functions-awaited-with-values-from-outside.ts
// A typed async function is awaited at once by a caller that has proven nothing of its argument: the tests of the argument stand between the two.
// Whichever way the call is compiled, the turns of the job queue come in the order of the specification, for a value that fits the type and for one that does not,
// and an error leaves through the await.
const outside: any = JSON.parse('{"number":4,"text":"four","nothing":null,"list":[1,"two",3,null,{"valueOf":1}]}');
const log: string[] = [];

async function suspends(id: number): Promise<number> {
  log.push("suspends begins " + id);
  await null;
  log.push("suspends goes on " + id);
  return id + 1;
}
async function neverSuspends(id: number): Promise<number> {
  log.push("neverSuspends " + id);
  return id + 1;
}
async function suspendsSometimes(id: number): Promise<number> {
  if (id > 2) await null;
  log.push("suspendsSometimes " + id);
  return id * 2;
}
async function throwsAtOnce(id: number): Promise<number> {
  if (typeof id !== "number") throw new TypeError("not a number: " + id);
  return id;
}
async function takesTwo(id: number, name: string): Promise<string> {
  await null;
  return name + id;
}

async function awaitsSuspends(x: any) { return await suspends(x); }
async function awaitsNeverSuspends(x: any) { return await neverSuspends(x); }
async function awaitsSometimes(x: any) { return await suspendsSometimes(x); }
async function awaitsThrower(x: any) { try { return await throwsAtOnce(x); } catch (error) { return "caught " + (error as Error).message; } }
async function awaitsTwo(x: any, y: any) { return await takesTwo(x, y); }
async function keepsThePromise(x: any) { const promise = suspends(x); const value = await promise; return [value, promise instanceof Promise, await promise]; }
async function awaitsInALoop(list: any) { let text = ""; for (const item of list) text += "," + String(await suspendsSometimes(item)); return text; }

function ticks(name: string, count: number): Promise<void> {
  let promise = Promise.resolve();
  for (let i = 0; i < count; i++) promise = promise.then(() => { log.push(name + " tick " + i); });
  return promise;
}

async function main() {
  for (const value of [outside.number, outside.text, outside.nothing, undefined]) {
    for (const run of [awaitsSuspends, awaitsNeverSuspends, awaitsSometimes, awaitsThrower]) {
      const beside = ticks(run.name, 6);
      const result = run(value).then(answer => { log.push(run.name + " answers " + String(answer)); });
      await Promise.all([beside, result]);
    }
  }
  const beside = ticks("two", 6);
  await Promise.all([beside, awaitsTwo(outside.number, outside.text).then(answer => { log.push("two answers " + answer); }), awaitsTwo(outside.text, outside.number).then(answer => { log.push("two answers " + answer); })]);
  log.push(JSON.stringify(await keepsThePromise(outside.number)));
  log.push(await awaitsInALoop(outside.list));
  console.log(log.join("\n"));
}
main();
//// using-and-await-using.ts
// `using` and `await using`.
const log: string[] = []
function res(name: string, fails = false) { return { name, [Symbol.dispose]() { log.push("dispose " + name); if (fails) throw new Error("dispose " + name + " failed") } } }
function ares(name: string, fails = false) { return { name, async [Symbol.asyncDispose]() { log.push("async dispose " + name); await null; log.push("async disposed " + name); if (fails) throw new Error(name + " failed") } } }
function plain(): string { using a = res("a"); using b = res("b"); using none = null; log.push("body " + a.name + b.name + none); return "returned" }
console.log(plain(), log.join()); log.length = 0
function early(n: number): number { for (let i = 0; i < 3; i++) { using r = res("r" + i); if (i === n) return i; if (i === 0) continue; log.push("end " + r.name) } return -1 }
console.log(early(1), log.join()); log.length = 0
function throws(): void { using a = res("a", true); using b = res("b", true); throw new Error("body") }
try { throws() } catch (e: any) { console.log(e.name, e.error.message, e.suppressed.name, e.suppressed.error.message, e.suppressed.suppressed.message, log.join()) } log.length = 0
function onlyDispose(): void { using a = res("a", true); log.push("fine") }
try { onlyDispose() } catch (e: any) { console.log(e.message, log.join()) } log.length = 0
try { (function () { using bad = {} as any })() } catch (e: any) { console.log(e.constructor.name) }
async function asyncOnes(): Promise<string> { await using a = ares("a"); using s = res("s"); await using b = ares("b"); log.push("body"); return "async returned" }
async function asyncFails(): Promise<void> { await using a = ares("a", true); throw new Error("async body") }
asyncOnes().then(v => { console.log(v, log.join()); log.length = 0; return asyncFails() }).catch(e => console.log(e.name, e.error.message, e.suppressed.message, log.join()))
//// values-dead-across-await.ts
// 1,000 calls of an async function are suspended at one await: the collector frees the object that only a local dead after the await refers to, and retains the object that the call reads after it resumes.
////= lines-3	Payload	public	id	number	label	string

const callCount = 1000;
// The collector scans the stack conservatively, so a stale word may retain a few dead objects.
const minCollectedCount = 900;
const idChange = 5000;
const deadReferences: WeakRef<Payload>[] = [];
const liveReferences: WeakRef<Payload>[] = [];
let openGate: () => void = () => {};
const gate = new Promise<void>(resolve => {
  openGate = resolve;
});

function watch(payload: Payload, references: WeakRef<Payload>[]): void {
  references.push(new WeakRef(payload));
}
function weigh(payload: Payload): number {
  return payload.id + payload.label.length;
}
function turn(): Promise<void> {
  return new Promise<void>(resolve => setTimeout(resolve, 0));
}

// `dead` is live across calls, so a stack slot or a callee-saved register may still refer to it at the await.
async function waitAtGate(index: number): Promise<number> {
  const dead = new Payload(index, "dead");
  const live = new Payload(index * 2, "live" + index);
  watch(dead, deadReferences);
  watch(live, liveReferences);
  const deadWeight = weigh(dead);
  await gate;
  return deadWeight + weigh(live);
}

const pendingResults: Promise<number>[] = [];
for (let index = 0; index < callCount; index++) pendingResults.push(waitAtGate(index));
// A WeakRef refers to its target strongly until the job that created it ends.
await turn();
Bun.gc(true);

let collectedDeadCount = 0;
for (const reference of deadReferences) if (!reference.deref()) collectedDeadCount++;
console.log(collectedDeadCount >= minCollectedCount ? "dead objects were collected" : "dead objects retained: " + (callCount - collectedDeadCount));

// This store rules out reading `id` before the await, so each call needs its live object after it resumes.
let collectedLiveCount = 0;
for (const reference of liveReferences) {
  const live = reference.deref();
  if (live) live.id += idChange;
  else collectedLiveCount++;
}
console.log(collectedLiveCount === 0 ? "live objects were retained" : "live objects collected: " + collectedLiveCount);

openGate();
let wrongCount = 0;
let sum = 0;
for (let index = 0; index < callCount; index++) {
  const result = await pendingResults[index];
  if (result !== index + "dead".length + index * 2 + idChange + ("live" + index).length) wrongCount++;
  sum += result;
}
console.log(`${callCount} calls resumed, ${wrongCount} wrong results, sum ${sum}`);
