//// values-live-across-calls-between-awaits.ts
let log: string[] = [];

function note(text: string): number {
    log.push(text);
    return log.length;
}

function mix(a: number, b: number): number {
    return (a * 31 + b) % 1000003;
}

function later<T>(value: T): Promise<T> {
    return Promise.resolve().then(() => value);
}

function fails(text: string): Promise<number> {
    return Promise.resolve().then((): number => { throw new Error(text); });
}

async function twoValues(a: number, b: number): Promise<number> {
    const first = mix(a, b);
    const second = mix(b, a);
    note("two " + first);
    const third = mix(first, second);
    const awaited = await later(third);
    note("two behind " + awaited);
    return mix(mix(first, second), mix(third, awaited));
}

async function manyValues(a: number, b: number, c: number, d: number): Promise<number> {
    const v1 = mix(a, b);
    const v2 = mix(b, c);
    const v3 = mix(c, d);
    const v4 = mix(d, a);
    const v5 = mix(v1, v2);
    const v6 = mix(v3, v4);
    const v7 = mix(v5, v6);
    const v8 = mix(v7, v1);
    note("many " + v8);
    const w1 = await later(mix(v1, v8));
    const x1 = mix(v2, w1);
    const x2 = mix(v3, x1);
    const x3 = mix(v4, x2);
    const x4 = mix(v5, x3);
    note("many between " + x4);
    const w2 = await later(mix(x4, v6));
    const y1 = mix(x1, w2);
    const y2 = mix(x2, y1);
    const y3 = mix(x3, y2);
    note("many behind " + y3);
    return mix(mix(mix(v7, v8), mix(y1, y2)), mix(y3, mix(w1, w2)));
}

async function neverWaits(a: number, b: number): Promise<number> {
    const first = mix(a, b);
    const second = mix(first, a);
    const value = await second;
    return mix(mix(first, second), mix(value, b));
}

async function inALoop(count: number, seed: number): Promise<number> {
    let sum = seed;
    const fixed = mix(seed, count);
    for (let i = 0; i < count; i++) {
        const before = mix(sum, i);
        const kept = mix(before, fixed);
        const got = i % 3 ? await later(kept) : await kept;
        sum = mix(mix(before, kept), mix(got, fixed));
    }
    return sum;
}

async function catches(a: number): Promise<number> {
    const first = mix(a, 1);
    const second = mix(a, 2);
    try {
        const third = mix(first, second);
        await fails("thrown " + third);
        return -1;
    } catch (error) {
        note((error as Error).message);
        return mix(first, second);
    } finally {
        note("finally " + mix(second, first));
    }
}

async function rejects(a: number): Promise<number> {
    const first = mix(a, 3);
    const got = await later(first);
    const second = mix(got, first);
    if (second >= 0)
        throw new Error("rejected " + second);
    return second;
}

async function awaitsOthers(a: number): Promise<number> {
    const first = mix(a, 5);
    const second = mix(first, 7);
    const r1 = await twoValues(first, second);
    const third = mix(r1, first);
    const r2 = await manyValues(first, second, third, r1);
    const fourth = mix(r2, second);
    const r3 = await neverWaits(third, fourth);
    let r4 = 0;
    try {
        r4 = await rejects(fourth);
    } catch (error) {
        r4 = note((error as Error).message);
    }
    return mix(mix(mix(first, second), mix(third, fourth)), mix(mix(r1, r2), mix(r3, r4)));
}

function callerThatKeepsValues(a: number, b: number): [number, Promise<number>[]] {
    const k1 = mix(a, b);
    const k2 = mix(k1, a);
    const k3 = mix(k2, b);
    const k4 = mix(k3, k1);
    const k5 = mix(k4, k2);
    const k6 = mix(k5, k3);
    const k7 = mix(k6, k4);
    const k8 = mix(k7, k5);
    const promises = [twoValues(k1, k2), manyValues(k3, k4, k5, k6), neverWaits(k7, k8), inALoop(7, k1), catches(k2), awaitsOthers(k3)];
    const sum = mix(mix(mix(k1, k2), mix(k3, k4)), mix(mix(k5, k6), mix(k7, k8)));
    return [sum, promises];
}

async function main(): Promise<void> {
    let total = 0;
    for (let round = 0; round < 6; round++) {
        const [sum, promises] = callerThatKeepsValues(round + 1, round * 3 + 2);
        const results = await Promise.all(promises);
        for (const result of results)
            total = mix(total, result);
        total = mix(total, sum);
    }
    const together = await Promise.all([inALoop(20, 1), inALoop(21, 2), awaitsOthers(9), awaitsOthers(10), manyValues(1, 2, 3, 4)]);
    console.log(total, together.join(","), log.length, log.slice(-6).join("|"));
}

main();
//// variable-stored-during-await.ts
// A variable stored once, while its reader is suspended, is loaded after the await. The negative cases are stored before the reader starts.
async function pause(): Promise<void> {}

let lateTable: number[];
const earlyTable: number[] = [10, 20, 30];

async function sumLateTable(): Promise<number> {
  await pause();
  let sum = 0;
  for (let i = 0; i < 3; i++) sum += lateTable[i];
  return sum;
}

async function sumEarlyTable(): Promise<number> {
  await pause();
  let sum = 0;
  for (let i = 0; i < 3; i++) sum += earlyTable[i];
  return sum;
}

function sumLateCapture(first: number): Promise<number> {
  let table: number[];
  async function sum(): Promise<number> {
    await pause();
    let total = 0;
    for (let i = 0; i < 3; i++) total += table[i];
    return total;
  }
  const pending = sum();
  table = [first, first + 1, first + 2];
  return pending;
}

function sumEarlyCapture(first: number): Promise<number> {
  const table: number[] = [first, first + 1, first + 2];
  async function sum(): Promise<number> {
    await pause();
    let total = 0;
    for (let i = 0; i < 3; i++) total += table[i];
    return total;
  }
  return sum();
}

function sumOwnCapture(first: number): number {
  let table: number[];
  const read = (i: number): number => table[i];
  table = [first, first * 2, first * 3];
  let total = 0;
  for (let i = 0; i < 3; i++) total += table[i] + read(i);
  return total;
}

const pending = sumLateTable();
lateTable = [1, 2, 3];
console.log(await pending, await sumEarlyTable());
for (let round = 0; round < 3; round++) {
  console.log(await sumLateCapture(round), await sumEarlyCapture(round), sumOwnCapture(round + 1));
}

export {};
//// waiter-order-after-resolve.js
// A coroutine resolves the promise that an async function waits for and goes on: the waiter runs before whatever the coroutine awaits, steps or yields next,
// whether the coroutine is an async function or the body of an async generator, and whoever entered it. A drain of the job queue in between runs the waiter too.
import { drainMicrotasks } from "bun:jsc";
const lines = [];
function defer() { let resolve; const promise = new Promise(r => { resolve = r; }); return { promise, resolve }; }
async function* count(n) { for (let i = 0; i < n; i++) yield i; }
async function consume(label, source) { await null; for await (const x of source) lines.push(label + " consumer got " + x); }

{
    const { promise, resolve } = defer();
    async function waiter() { await promise; lines.push("await: waiter"); }
    async function resolver() { await null; resolve(1); await 0; lines.push("await: resolver goes on"); }
    await Promise.all([waiter(), resolver()]);
}
{
    const { promise, resolve } = defer();
    async function waiter() { await promise; lines.push("await of a promise: waiter"); }
    async function resolver() { await null; resolve(1); await Promise.resolve(0); lines.push("await of a promise: resolver goes on"); }
    await Promise.all([waiter(), resolver()]);
}
{
    const { promise, resolve } = defer();
    async function waiter() { await promise; lines.push("step: waiter"); }
    async function resolver() { await null; resolve(1); for await (const x of count(2)) lines.push("step: resolver got " + x); }
    await Promise.all([waiter(), resolver()]);
}
{
    const { promise, resolve } = defer();
    async function waiter() { await promise; lines.push("return: waiter"); }
    async function resolver() { await null; resolve(1); lines.push("return: resolver is over"); }
    await Promise.all([waiter(), resolver().then(() => lines.push("return: its promise is settled"))]);
}
{
    const { promise, resolve } = defer();
    async function waiter() { await promise; lines.push("drain: waiter"); }
    async function resolver() { await null; resolve(1); drainMicrotasks(); lines.push("drain: resolver goes on"); }
    await Promise.all([waiter(), resolver()]);
}
{
    const first = defer(), second = defer();
    async function firstWaiter() { await first.promise; lines.push("two waiters: first"); }
    async function secondWaiter() { await second.promise; lines.push("two waiters: second"); }
    async function resolver() { await null; first.resolve(1); second.resolve(2); await 0; lines.push("two waiters: resolver goes on"); }
    await Promise.all([firstWaiter(), secondWaiter(), resolver()]);
}
{
    const { promise, resolve } = defer();
    async function waiter() { await promise; lines.push("body after an await: waiter"); }
    async function* resolver() { await null; resolve(1); yield "a"; lines.push("body after an await: goes on"); yield "b"; }
    await Promise.all([waiter(), consume("body after an await:", resolver())]);
}
{
    const { promise, resolve } = defer();
    async function waiter() { await promise; lines.push("body in a step: waiter"); }
    async function* resolver() { yield "a"; resolve(1); yield "b"; lines.push("body in a step: goes on"); }
    await Promise.all([waiter(), consume("body in a step:", resolver())]);
}
{
    const { promise, resolve } = defer();
    async function waiter() { await promise; lines.push("chain: waiter"); }
    async function* inner() { yield "a"; resolve(1); yield "b"; }
    async function* outer() { yield* inner(); for await (const x of inner()) yield "again " + x; }
    await Promise.all([waiter(), consume("chain:", outer())]);
}
{
    const { promise, resolve } = defer();
    async function waiter() { await promise; lines.push("by hand: waiter"); }
    async function* resolver() { yield "a"; resolve(1); yield "b"; }
    async function byHand() { await null; const g = resolver(); for (let r = await g.next(); !r.done; r = await g.next()) lines.push("by hand: got " + r.value); }
    await Promise.all([waiter(), byHand()]);
}
console.log(lines.join("\n"));
//// what-a-call-made-and-dropped-is-released-while-its-async-caller-waits.ts
async function keptOnceTheRestIsCollected<T>(label: string, make: (track: (blob: Blob) => Blob) => T): Promise<T> {
  let tracked = 0;
  let collected = 0;
  const registry = new FinalizationRegistry(() => collected++);
  const kept = make(blob => {
    tracked++;
    registry.register(blob, undefined);
    return blob;
  });
  let rounds = 0;
  while (collected < tracked && rounds < 300) {
    Bun.gc(true);
    await Bun.sleep(0);
    rounds++;
  }
  console.log(label, collected < tracked ? "is still held" : "was collected");
  return kept;
}

const texts = ["one", "two", "three"];
for (const round of [1, 2]) {
  const stream = await keptOnceTheRestIsCollected("round " + round + ": the Blob whose stream is kept", track => track(new Blob(texts)).stream());
  console.log(await Bun.readableStreamToText(stream));
}
//// what-an-async-function-returns.ts
// `return x` in an async function fulfills the promise with x, unless x is a promise or a thenable: then the promise takes what that one is fulfilled with.
// Every form in which a well-typed program returns one or the other.
////= lines-4	User	id	number	name	string
const tick = (): Promise<void> => Promise.resolve();

async function literal(n: number): Promise<User> {
  await tick();
  return { id: n, name: "literal" + n };
}
////= lines	promise	n	number	User	literal
////= lines-10	awaited	n	number	User	await	literal
function makeThenable(n: number): PromiseLike<User> {
  return {
    then<A, B>(resolve?: ((value: User) => A | PromiseLike<A>) | null): PromiseLike<A | B> {
      return Promise.resolve(resolve!({ id: n, name: "thenable" + n }));
    },
  };
}
////= lines	thenable	n	number	User	makeThenable
async function either(n: number): Promise<User> {
  const value: User | Promise<User> = n % 2 ? literal(n) : { id: n, name: "either" + n };
  return value;
}
async function conditional(n: number): Promise<User> {
  return n % 2 ? literal(n) : { id: n, name: "conditional" + n };
}
async function generic<T>(value: T | PromiseLike<T>): Promise<T> {
  return value;
}
async function genericAlone<T>(value: T): Promise<Awaited<T>> {
  return value as Awaited<T>;
}
////= lines-8	fromAny	value	any	User
////= lines-8	fromUnknown	value	unknown	unknown
////= lines-8	fromObject	value	object	object
async function optional(n: number): Promise<User | undefined> {
  if (n > 5) return undefined;
  if (n > 3) return;
  return { id: n, name: "optional" + n };
}
async function count(n: number): Promise<number> {
  return n * 2;
}
async function text(n: number): Promise<string> {
  return n > 1 ? "many" : Promise.resolve("one");
}
async function nothing(): Promise<void> {}
class Store {
  constructor(public base: number) {}
  async make(n: number): Promise<User> {
    return { id: n + this.base, name: "store" + n };
  }
  async again(n: number): Promise<User> {
    return this.make(n);
  }
}
const arrow = async (n: number): Promise<User> => ({ id: n, name: "arrow" + n });
const arrowPromise = async (n: number): Promise<User> => literal(n);
async function inTry(n: number): Promise<User> {
  try {
    if (n > 2) throw new Error("over");
    return { id: n, name: "try" + n };
  } catch {
    return literal(n);
  } finally {
    await tick();
  }
}

const show = (user: User | undefined): string => (user === undefined ? "none" : user.id + ":" + user.name);
const n = process.argv.length;
const store = new Store(10);
console.log(show(await literal(n)), show(await promise(n)), show(await awaited(n)), show(await thenable(n)));
console.log(show(await either(n)), show(await either(n + 1)), show(await conditional(n)), show(await conditional(n + 1)));
console.log(show(await generic<User>(literal(n))), show(await generic<User>({ id: n, name: "given" })), show(await generic<User>(makeThenable(n))));
console.log(show(await genericAlone(literal(n))), show(await genericAlone<User>({ id: n, name: "alone" })), await genericAlone(n));
console.log(show(await fromAny(literal(n))), show(await fromAny({ id: n, name: "any" })), show(await fromAny(makeThenable(n))));
console.log(show((await fromUnknown(literal(n))) as User), await fromUnknown(n), show((await fromObject(literal(n))) as User), show((await fromObject(makeThenable(n))) as User));
console.log(show(await optional(n)), show(await optional(n + 2)), show(await optional(n + 4)));
console.log((await count(n)) + 1, await text(n), await text(n - 1), await nothing());
console.log(show(await store.make(n)), show(await store.again(n)), show(await arrow(n)), show(await arrowPromise(n)));
console.log(show(await inTry(n)), show(await inTry(n + 1)));

// What comes through `any` need not be what the type says, neither at once nor once a promise or a thenable has settled.
const describe = (value: unknown): string => typeof value + ":" + String(value);
const number: User = await fromAny(Promise.resolve(42));
const string: User = await fromAny({
  then(resolve: (value: unknown) => void) {
    resolve("text");
  },
});
const plain: User = await fromAny(7);
console.log(describe(number), describe(string), describe(plain));
const inGeneric: User = await generic<User>(Promise.resolve<any>(true));
const inObject: object = await fromObject(Promise.resolve<any>(null));
console.log(describe(inGeneric), describe(inObject));
//// what-an-async-generator-throws-reaches-the-catch-around-the-loop.mjs
// What the body of an async generator throws rejects the step that was asked for: a `for await` around it goes to its `catch`, and nothing is left over for the end of the program.
// variant-stub-copies-1.test.ts always takes this program: there the code is laid out with several copies of the shared stubs, as in a very large program.
async function* producer(limit) {
  for (let i = 0; i < limit; i++) yield i;
  throw new RangeError("thrown by the producer");
}
async function consume(limit) {
  const seen = [];
  try {
    for await (const value of producer(limit)) seen.push(value);
    seen.push("through");
  } catch (error) {
    seen.push("caught " + error.message);
  }
  return seen.join();
}
console.log(await consume(0));
console.log(await consume(2));
const stepped = producer(1);
console.log(JSON.stringify(await stepped.next()));
console.log(await stepped.next().then(result => "fulfilled " + JSON.stringify(result), error => "rejected " + error.message));
console.log(JSON.stringify(await stepped.next()));
