//// the-parameters-of-a-generator-function-are-evaluated-at-the-call.js
// A call of a generator function evaluates the defaults and the patterns of its parameters and only then hands back the generator. What they read is changed
// between the call and the first next(). The generators are short, long, call themselves, hold a try, and are stepped by hand or by a loop.
let step = 1;
const box = { v: 1 };
const sink = [];
function read() { return step; }

function* short(by = step) { yield by; }
function* fromField(by = box.v) { yield by; }
function* fromPattern({ v }) { yield v; }
function* fromList([first]) { yield first; }
function* fromEarlierParameter(o, by = o.v) { yield by; }
function* fromLength(list, n = list.length) { yield n; }
function* fromNested({ inner: { v } }) { yield v; }
function* fromCall(by = read()) { yield by; }
function* callsItself(depth, by = step) { yield by; if (depth > 0) yield* callsItself(depth - 1); }
function* withFinally(by = step) { try { yield by; yield by + 1; } finally { sink.length = 0; } }
function* withCatch(by = step) { try { yield by; } catch (e) { yield -1; } }
function* delegates(by = step) { yield* [by, by + 1]; }
function* long(by = step) {
  let t = by;
  for (let i = 0; i < 3; i++) { t += i; yield t; t *= 2; yield t; t -= 3; yield t; t ^= 5; yield t; t += 7; yield t; t |= 1; yield t; t %= 1000; yield t; t += 11; yield t; }
  for (let i = 0; i < 3; i++) { t += i * 2; yield t; t *= 3; yield t; t -= 5; yield t; t ^= 9; yield t; t += 13; yield t; t |= 2; yield t; t %= 977; yield t; t += 17; yield t; }
  for (let i = 0; i < 3; i++) { t += i * 3; yield t; t *= 5; yield t; t -= 7; yield t; t ^= 3; yield t; t += 19; yield t; t |= 4; yield t; t %= 991; yield t; t += 23; yield t; }
}
class Holder { v = 1; *fromThis(by = this.v) { yield by; } static *fromStatic(by = Holder.s) { yield by; } static s = 1; }
const methods = { v: 1, *fromThis(by = this.v) { yield by; } };

const topLevel = callsItself(1);
step = 2;
const lines = ["at the top " + topLevel.next().value];

function ofItself() { step = 1; const it = callsItself(2); step = 2; return it.next().value; }
function ofLong() { step = 1; const it = long(); step = 2; return it.next().value; }
function ofLongInLoop(stop) { step = 1; const it = long(); step = 2; let sum = 0; for (const v of it) { sum += v; if (sum > stop) break; } return sum; }
function ofFinally() { step = 1; const it = withFinally(); step = 2; return it.next().value; }
function ofCatch() { step = 1; const it = withCatch(); step = 2; return it.next().value; }
function ofDelegate() { step = 1; const it = delegates(); step = 2; return it.next().value; }
function ofShortByHand() { step = 1; const it = short(); step = 2; const first = it.next(), second = it.next(); return first.value + ":" + second.done; }
function ofCall() { step = 1; const it = fromCall(); step = 2; return it.next().value; }
function field() { box.v = 1; const it = fromField(); box.v = 2; return it.next().value; }
function pattern() { const o = { v: 1 }; const it = fromPattern(o); o.v = 2; return it.next().value; }
function list() { const l = [1]; const it = fromList(l); l[0] = 2; return it.next().value; }
function earlier() { const o = { v: 1 }; const it = fromEarlierParameter(o); o.v = 2; return it.next().value; }
function length() { const l = [1]; const it = fromLength(l); l.push(2); return it.next().value; }
function nested() { const o = { inner: { v: 1 } }; const it = fromNested(o); o.inner = { v: 2 }; return it.next().value; }
function ofInstance() { const h = new Holder(); const it = h.fromThis(); h.v = 2; return it.next().value; }
function ofClass() { Holder.s = 1; const it = Holder.fromStatic(); Holder.s = 2; return it.next().value; }
function ofObject() { methods.v = 1; const it = methods.fromThis(); methods.v = 2; return it.next().value; }
function throwsAtTheCall() { let it; try { it = fromNested({}); } catch (e) { return "at the call " + e.constructor.name; } try { it.next(); } catch (e) { return "at next " + e.constructor.name; } return "nowhere"; }

const seen = new Set();
for (let turn = 0; turn < 2000; turn++) {
  seen.add([
    ofItself(), ofLong(), ofLongInLoop(50), ofFinally(), ofCatch(), ofDelegate(), ofShortByHand(), ofCall(),
    field(), pattern(), list(), earlier(), length(), nested(), ofInstance(), ofClass(), ofObject(), throwsAtTheCall(),
  ].join(" "));
}
console.log(lines.concat([...seen]).join("\n"));
//// the-prototype-object-of-a-generator-function-is-reached-in-other-ways.js
// The prototype object of a generator function is no generator, by whatever way the program gets hold of it: `next` called on it throws a TypeError.
function* numbers() { yield 2; }
async function* later() { yield 3; }
function attempt(name, run) {
  try { console.log(name, run()); } catch (error) { console.log(name, error instanceof TypeError); }
}
attempt("above a generator", () => Object.getPrototypeOf(numbers()).next());
attempt("reflect above a generator", () => Reflect.getPrototypeOf(numbers()).next());
attempt("__proto__", () => numbers().__proto__.next());
attempt("reflect get", () => Reflect.get(numbers, "prototype").next());
attempt("destructured", () => { const { prototype } = numbers; return prototype.next(); });
attempt("computed", () => numbers[["proto", "type"].join("")].next());
attempt("return", () => numbers.prototype.return(1));
attempt("throw", () => numbers.prototype.throw(1));
attempt("spread", () => [...numbers.prototype]);
attempt("for of", () => { for (const each of numbers.prototype) return each; });
numbers.prototype.twice = function () { return this.next().value * 2; };
attempt("a method stored there", () => numbers().twice());
attempt("a generator", () => numbers().next().value);
try { console.log("async", await later.prototype.next()); } catch (error) { console.log("async", error instanceof TypeError); }
try { console.log("async above", await Object.getPrototypeOf(later()).next()); } catch (error) { console.log("async above", error instanceof TypeError); }
console.log("async generator", (await later().next()).value);
//// the-values-of-an-own-async-iterator-are-not-awaited.ts
// `for await` and `yield*` await what the method `next` of an asynchronous iterator answers, and never the value in that answer: a promise that such an iterator hands out arrives as a promise.
// Only the wrapper around a synchronous iterator awaits the values, and an async generator what it yields by itself.
const lines: string[] = [];
function log(line: string) { lines.push(line); }
function kindOf(value: unknown): string {
  return typeof value + (value instanceof Promise ? " promise" : "") + (value !== null && typeof value === "object" && "then" in value ? " thenable" : "");
}
async function answers<T>(value: T): Promise<T> { return value; }
type Make = () => unknown;
const values: [string, Make][] = [
  ["a number", () => 7],
  ["Promise.resolve", () => Promise.resolve(7)],
  ["new Promise", () => new Promise(resolve => resolve(7))],
  ["what an async function answers", () => answers(7)],
  ["one that settles later", () => new Promise(resolve => setTimeout(resolve, 1, 7))],
  ["one that never settles", () => new Promise(() => {})],
  ["of a record", () => Promise.resolve({ n: 7 })],
  ["of a promise's handler", () => Promise.resolve(3).then(n => n + 4)],
  ["a thenable", () => ({ then(resolve: (n: number) => void) { resolve(7); } })],
  ["a subclass", () => (class extends Promise<number> {}).resolve(7)],
  ["undefined", () => undefined],
];
type Source = (make: Make) => AsyncIterable<unknown>;
class Queue implements AsyncIterable<unknown> {
  make: Make;
  constructor(make: Make) { this.make = make; }
  [Symbol.asyncIterator](): AsyncIterator<unknown> { let i = 0; const make = this.make; return { next: async () => (i++ < 2 ? { done: false, value: make() } : { done: true, value: make() }) }; }
}
const sources: [string, Source][] = [
  ["next is plain", make => ({ [Symbol.asyncIterator]() { let i = 0; return { next() { return (i++ < 2 ? { done: false, value: make() } : { done: true, value: make() }) as unknown as Promise<IteratorResult<unknown>>; } }; } })],
  ["next is async", make => ({ [Symbol.asyncIterator]() { let i = 0; return { async next() { return i++ < 2 ? { done: false, value: make() } : { done: true, value: make() }; } }; } })],
  ["next is an arrow", make => ({ [Symbol.asyncIterator]() { let i = 0; return { next: () => Promise.resolve(i++ < 2 ? { done: false, value: make() } : { done: true, value: make() }) }; } })],
  ["next answers a later promise", make => ({ [Symbol.asyncIterator]() { let i = 0; return { next: () => new Promise<IteratorResult<unknown>>(resolve => queueMicrotask(() => resolve(i++ < 2 ? { done: false, value: make() } : { done: true, value: make() }))) }; } })],
  ["a class", make => new Queue(make)],
  ["with return", make => ({ [Symbol.asyncIterator]() { let i = 0; return { async next() { return i++ < 2 ? { done: false, value: make() } : { done: true, value: make() }; }, async return(value?: unknown) { return { done: true, value }; } }; } })],
  ["the iterator is its own iterable", make => { let i = 0; const it = { [Symbol.asyncIterator]() { return it; }, async next() { return i++ < 2 ? { done: false, value: make() } : { done: true, value: make() }; } }; return it; }],
  ["an async generator that delegates", make => (async function* () { return yield* new Queue(make) as AsyncIterable<unknown, unknown, unknown>; })()],
  ["two that delegate", make => (async function* () { yield* (async function* () { yield* new Queue(make); })(); })()],
  // These await each value.
  ["an async generator that yields", make => (async function* () { yield make(); yield make(); return make(); })()],
  ["a list", make => [make(), make()] as unknown as AsyncIterable<unknown>],
  ["a sync generator", make => (function* () { yield make(); yield make(); return make(); })() as unknown as AsyncIterable<unknown>],
  ["an own sync iterator", make => ({ [Symbol.iterator]() { let i = 0; return { next() { return i++ < 2 ? { done: false, value: make() } : { done: true, value: make() }; } }; } }) as unknown as AsyncIterable<unknown>],
];
const neverSettles = "one that never settles";
// The first of them awaits what it returns.
const awaitsValues = new Set(["an async generator that delegates", "an async generator that yields", "a list", "a sync generator", "an own sync iterator"]);

for (const [sourceName, source] of sources) {
  for (const [valueName, make] of values) {
    if (valueName === neverSettles && awaitsValues.has(sourceName)) continue;
    const seen: string[] = [];
    for await (const value of source(make)) seen.push(kindOf(value));
    const awaited: string[] = [];
    if (valueName !== neverSettles) for await (const value of source(make)) awaited.push(JSON.stringify(await value) ?? "undefined");
    const delegated: string[] = [];
    const outer = (async function* () { const result = yield* source(make) as AsyncIterable<unknown, unknown, unknown>; delegated.push("result " + kindOf(result)); })();
    for (let step = await outer.next(); !step.done; step = await outer.next()) delegated.push(kindOf(step.value));
    const byHand: string[] = [];
    const iterable = source(make) as Partial<AsyncIterable<unknown>>;
    if (iterable[Symbol.asyncIterator]) { const iterator = iterable[Symbol.asyncIterator]!(); for (let i = 0; i < 3; i++) { const step = await iterator.next(); byHand.push((step.done ? "done " : "") + kindOf(step.value)); } }
    log(sourceName + " | " + valueName + " | for await: " + seen.join(", ") + " | awaited: " + awaited.join(", ") + " | yield*: " + delegated.join(", ") + " | by hand: " + byHand.join(", "));
  }
}

// The commonest text: a queue of promises, each awaited in the loop. (TypeScript says that the loop binds a number.)
async function total(queue: AsyncIterable<Promise<number>>): Promise<number> { let sum = 0; for await (const promise of queue) sum += await promise; return sum; }
log("total " + (await total(new Queue(() => Promise.resolve(21)) as AsyncIterable<Promise<number>>)));
async function settled(queue: AsyncIterable<Promise<number>>) { const all: unknown[] = []; for await (const promise of queue) all.push(promise); return (await Promise.all(all)).join("+") + " of " + all.map(kindOf).join(", "); }
log("settled " + (await settled(new Queue(() => answers(5)) as AsyncIterable<Promise<number>>)));
async function chained(queue: AsyncIterable<Promise<number>>) { const out: string[] = []; for await (const promise of queue) out.push(String(await (promise as unknown as Promise<number>).then(n => n * 2))); return out.join(); }
log("chained " + (await chained(new Queue(() => Promise.resolve(4)) as AsyncIterable<Promise<number>>)));
// First a number, then a promise.
{ let i = 0; const seen: string[] = []; for await (const value of new Queue(() => (i++ ? Promise.resolve(i) : i))) seen.push(kindOf(value)); log("mixed " + seen.join(", ")); }
// A rejected promise that is handed out is nobody's error until it is awaited.
{
  const seen: string[] = [];
  for await (const value of new Queue(() => { const rejected = Promise.reject(new Error("handed out")); rejected.catch(() => {}); return rejected; })) { seen.push(kindOf(value)); try { await value; } catch (error) { seen.push("caught " + (error as Error).message); } }
  log("rejected " + seen.join(", "));
}
// What the consumer returns through a delegation, and what the inner iterator answers to it.
{
  const inner = { [Symbol.asyncIterator]() { return this; }, async next() { return { done: false, value: Promise.resolve(1) }; }, async return(value?: unknown) { return { done: true, value: Promise.resolve("closed with " + String(value)) }; } };
  const outer = (async function* () { yield* inner; })();
  log("step " + kindOf((await outer.next()).value));
  const closed = await outer.return("x" as never);
  log("return " + closed.done + " " + kindOf(closed.value));
}
log("fromAsync " + (await Array.fromAsync(new Queue(() => Promise.resolve(7)))).map(kindOf).join(", "));
console.log(lines.join("\n"));
//// then-comes-and-goes-among-extra-properties.js
// An object is adopted through `then` exactly while it has one, also where `then` comes and goes among properties under computed keys, after objects with the same other properties were awaited and returned many times.
const log = [];
const named = (...parts) => parts.join("");

function makePoint(x) {
  return { x, y: 2 };
}
function adopt(label) {
  return function (resolve) {
    log.push(`then of ${label} ${this.x}`);
    resolve(`adopted from ${label}`);
  };
}
async function returns(value) {
  return value;
}
async function awaits(value) {
  return await value;
}
function describe(value) {
  return typeof value === "object" ? JSON.stringify(value) : String(value);
}
async function observe(label, value) {
  log.push(`${label}: returned ${describe(await returns(value))}`);
  log.push(`${label}: awaited ${describe(await awaits(value))}`);
  log.push(`${label}: resolved ${describe(await Promise.resolve(value))}`);
  log.push(`${label}: in all ${describe((await Promise.all([value]))[0])}`);
}

const tagged = makePoint(1);
tagged[named("t", "ag")] = "first";
const emptied = makePoint(2);
emptied[named("t", "ag")] = "gone";
delete emptied[named("t", "ag")];
let sum = 0;
for (let i = 0; i < 200; i++) sum += (await returns(tagged)).x + (await awaits(tagged)).y + (await returns(emptied)).x + (await awaits(emptied)).y;
log.push(`warm ${sum}`);
await observe("tagged", tagged);
await observe("emptied", emptied);

const sibling = makePoint(3);
sibling[named("t", "ag")] = "second";
await observe("sibling", sibling);
sibling[named("th", "en")] = adopt("sibling");
await observe("sibling with then", sibling);
await observe("tagged beside it", tagged);

tagged[named("th", "en")] = adopt("tagged");
await observe("tagged with then", tagged);
delete tagged[named("th", "en")];
await observe("tagged without then", tagged);
tagged[named("th", "en")] = 5;
await observe("tagged with a number", tagged);

emptied[named("th", "en")] = adopt("emptied");
await observe("emptied with then", emptied);
delete emptied[named("th", "en")];
await observe("emptied again", emptied);

const many = [];
for (let i = 0; i < 40; i++) {
  const point = makePoint(10 + i);
  point[named("t", "ag")] = i;
  if (i % 4 === 3) point[named("th", "en")] = adopt("every fourth");
  many.push(point);
}
for (const point of many) log.push(describe(await returns(point)));

const inheriting = makePoint(4);
inheriting[named("t", "ag")] = "third";
await observe("inheriting", inheriting);
Object.setPrototypeOf(inheriting, { then: adopt("the prototype") });
await observe("inheriting a then", inheriting);

console.log(log.join("\n"));
//// then-with-one-handler.ts
// promise.then(f), promise.then(undefined, f) and promise.catch(f) on promises in every state, among other reactions, and who runs when.
import { AsyncLocalStorage } from "node:async_hooks";

const lines: string[] = [];
function log(line: string) { lines.push(line); }
////= show
function deferred<T>() {
  let resolve!: (value: T | PromiseLike<T>) => void, reject!: (reason: unknown) => void;
  const promise = new Promise<T>((a, b) => { resolve = a; reject = b; });
  return { promise, resolve, reject };
}
const unhandled: string[] = [];
process.on("unhandledRejection", reason => { unhandled.push(show(reason)); });
async function turns(count: number) { for (let i = 0; i < count; i++) await null; }

{
  log("== pending, then settled");
  const a = deferred<number>(), b = deferred<number>(), c = deferred<number>(), d = deferred<number>();
  const fromA = a.promise.then(value => { log("a fulfilled " + value); return value + 1; });
  const fromB = b.promise.catch(reason => { log("b rejected " + show(reason)); return -1; });
  const fromC = c.promise.then(undefined, reason => { log("c rejected " + show(reason)); return -2; });
  const fromD = d.promise.then(value => { log("d fulfilled " + value); return value; });
  log(String(fromA instanceof Promise) + " " + String(fromA !== a.promise) + " " + String(Object.getPrototypeOf(fromB) === Promise.prototype));
  d.reject(new Error("d fails")); c.reject("c fails"); b.reject(new Error("b fails")); a.resolve(1);
  log("settled");
  for (const result of await Promise.allSettled([fromA, fromB, fromC, fromD])) log(show(result.status === "fulfilled" ? result.value : result.reason));
}
{
  log("== the handler that does not fit is passed by");
  const a = deferred<number>(), b = deferred<number>();
  const fromA = a.promise.catch(() => { log("never"); return 0; });
  const fromB = b.promise.then(() => { log("never"); return 0; });
  fromA.then(value => log("through " + value));
  fromB.catch(reason => log("through " + show(reason)));
  a.resolve(5); b.reject("no");
  await turns(4);
}
{
  log("== already settled");
  Promise.resolve(1).then(value => log("resolved " + value));
  Promise.reject(new Error("gone")).catch(reason => log("rejected " + show(reason)));
  Promise.reject("gone too").then(undefined, reason => log("rejected " + show(reason)));
  Promise.resolve(2).catch(() => log("never")).then(value => log("passed on " + value));
  queueMicrotask(() => log("a job between"));
  Promise.resolve(3).then(value => log("resolved " + value));
  await turns(4);
}
{
  log("== several reactions on one promise");
  const a = deferred<string>();
  a.promise.then(value => log("first " + value));
  a.promise.then(value => log("second " + value));
  a.promise.catch(() => log("never"));
  a.promise.then(value => log("fourth " + value), () => log("never"));
  (async () => { log("awaited " + (await a.promise)); })();
  a.promise.then(value => log("sixth " + value));
  a.resolve("x");
  await turns(4);
  const b = deferred<string>();
  (async () => { log("awaited first " + (await b.promise)); })();
  b.promise.then(value => log("then second " + value));
  b.resolve("y");
  await turns(4);
}
{
  log("== what a handler returns or throws");
  const a = deferred<number>();
  const chain = a.promise
    .then(value => Promise.resolve(value + 1))
    .then(value => ({ then(resolve: (value: number) => void) { log("then is called"); resolve(value + 1); } }) as unknown as PromiseLike<number>)
    .then(value => { log("got " + show(value)); throw new RangeError("thrown"); })
    .then(() => log("never"))
    .catch(reason => { log("caught " + show(reason)); return deferredLater(); })
    .then(value => log("late " + value));
  function deferredLater() { const later = deferred<string>(); turns(3).then(() => later.resolve("value")); return later.promise; }
  a.resolve(0);
  await chain;
  const self: { promise?: Promise<unknown> } = {};
  const b = deferred<number>();
  self.promise = b.promise.then(() => self.promise);
  b.resolve(0);
  await self.promise.catch(reason => log("itself: " + (reason as Error).constructor.name));
}
{
  log("== other things in the place of a handler");
  const handlers: unknown[] = [undefined, null, 5, "text", {}, Symbol.iterator];
  for (const other of handlers) {
    await Promise.resolve(1).then(value => { log("with " + typeof other + ": " + value); return value; }, other as never);
    await Promise.reject(2).then(other as never, reason => log("with " + typeof other + ": " + reason));
    await Promise.resolve(3).then(other as never).then(value => log("only " + typeof other + ": " + value));
  }
}
