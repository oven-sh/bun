//// built-ins-in-tail-position-that-need-tests.ts
// `return list.join(separator)` is a tail call. The frames that user code sees from inside the built-in, the errors the built-in throws and the depth that recursion reaches are those of plain Bun.
interface Options { list: unknown[]; numbers: number[]; text: string; separator: string; position: number }
const parsed: any = JSON.parse('{"list":[1,2],"numbers":[3,1,2],"text":"a,b","separator":",","position":1}');
function createOptions(values: any): Options {
  return { list: values.list, numbers: values.numbers, text: values.text, separator: values.separator, position: values.position };
}
let frames = "";
function capture(): void {
  frames = (new Error().stack ?? "").split("\n").slice(1).map(line => /at (\S+)/.exec(line)?.[1] ?? "?").filter(name => /^(capture|spy|join|at|slice|concat|indexOf|includes|split|padStart|run|outer|toString|valueOf)/.test(name)).join(" < ");
}
const spyText = { toString() { capture(); return ";"; } };
const spyNumber = { valueOf() { capture(); return 1; } };

function joinInTailPosition(o: Options): string { return o.list.join(o.separator); }
function atInTailPosition(o: Options): unknown { return o.list.at(o.position); }
function sliceInTailPosition(o: Options): unknown[] { return o.list.slice(o.position); }
function concatInTailPosition(o: Options): unknown[] { return o.list.concat(o.numbers); }
function indexOfInTailPosition(o: Options): number { return o.numbers.indexOf(o.position); }
function includesInTailPosition(o: Options): boolean { return o.numbers.includes(o.position); }
function splitInTailPosition(o: Options): string[] { return o.text.split(o.separator); }
function padStartInTailPosition(o: Options): string { return o.text.padStart(6, o.separator); }
const functions: ((o: Options) => unknown)[] = [joinInTailPosition, atInTailPosition, sliceInTailPosition, concatInTailPosition, indexOfInTailPosition, includesInTailPosition, splitInTailPosition, padStartInTailPosition];

function outer(run: (o: Options) => unknown, o: Options): string {
  frames = "";
  let answer: string;
  try { answer = JSON.stringify(run(o)) ?? "undefined"; } catch (error) { answer = (error as Error).constructor.name; }
  return answer + " [" + frames + "]";
}

const usual = createOptions(parsed);
let total = 0;
for (let i = 0; i < 3000; i++) for (const run of functions) total += String(run(usual)).length;
console.log(total);

const holey: unknown[] = [1, , 3];
const withOwnJoin: any = [1, 2]; withOwnJoin.join = () => { capture(); return "own"; };
class List extends Array<unknown> { at(): unknown { capture(); return "subclass"; } }
const cases: [string, any][] = [
  ["usual", {}], ["separator is an object", { separator: spyText }], ["separator is undefined", { separator: undefined }], ["separator is null", { separator: null }], ["separator is a number", { separator: 7 }],
  ["position is an object", { position: spyNumber }], ["position is undefined", { position: undefined }], ["position is text", { position: "1" }],
  ["an element has toString", { list: [spyText, 2] }], ["list has a hole", { list: holey }], ["list has its own join", { list: withOwnJoin }], ["list is of a subclass", { list: List.from([1, 2]) }],
  ["list is undefined", { list: undefined }], ["list is null", { list: null }], ["list is array-like", { list: { length: 1, 0: "x", join: Array.prototype.join, at: Array.prototype.at, slice: Array.prototype.slice, concat: Array.prototype.concat } }],
  ["list is a proxy", { list: new Proxy([1, 2], { get(target, key, receiver) { if (key === "length") capture(); return Reflect.get(target, key, receiver); } }) }],
  ["numbers is undefined", { numbers: undefined }], ["numbers is frozen", { numbers: Object.freeze([1, 2]) }], ["text is undefined", { text: undefined }], ["text is a number", { text: 5 }], ["text is an object", { text: new String("p,q") }],
];
for (const [name, changes] of cases) {
  const o = createOptions({ ...parsed, ...changes });
  console.log(name + ": " + functions.map(run => outer(run, o)).join(" | "));
}

// A chain of calls that ends in a built-in each time it comes back: the recursion goes through user code that the built-in calls.
let deepest = 0;
function descend(depth: number, o: Options): string {
  deepest = depth;
  if (depth === 500) return "bottom";
  const step = { toString() { return descend(depth + 1, o); } };
  const list: unknown[] = [step];
  return list.join(o.separator);
}
console.log(descend(0, usual), deepest);
//// built-ins-on-lists-with-named-properties.js
// Every array method that looks at the elements alone, called on lists that were given a property of their own: an ordinary name, a name that other methods look for, a name that looks like a number, a method of the same name, an accessor, an index accessor, another prototype, a frozen list.
const makers = {
  plain: () => [1, 2, 3, 4],
  named: () => { const a = [1, 2, 3, 4]; a.pos = 7; return a; },
  constructorOfItsOwn: () => { const a = [1, 2, 3, 4]; a.constructor = function () { return { made: true }; }; return a; },
  species: () => { const a = [1, 2, 3, 4]; a.constructor = { [Symbol.species]: function (n) { return { length: 0, species: n }; } }; return a; },
  notSpreadable: () => { const a = [1, 2, 3, 4]; a[Symbol.isConcatSpreadable] = false; return a; },
  minusOne: () => { const a = [1, 2, 3, 4]; a["-1"] = 9; return a; },
  fraction: () => { const a = [1, 2, 3, 4]; a[1.5] = 9; return a; },
  farIndex: () => { const a = [1, 2, 3, 4]; a[6] = 9; return a; },
  joinOfItsOwn: () => { const a = [1, 2, 3, 4]; a.join = () => "mine"; return a; },
  pushOfItsOwn: () => { const a = [1, 2, 3, 4]; a.push = function (v) { this[this.length] = v * 2; return -1; }; return a; },
  findOfItsOwn: () => { const a = [1, 2, 3, 4]; a.find = () => "mine"; return a; },
  namedAccessor: () => { const a = [1, 2, 3, 4]; Object.defineProperty(a, "pos", { get() { log.push("get pos"); return 7; }, enumerable: true }); return a; },
  indexAccessor: () => { const a = [1, 2, 3, 4]; Object.defineProperty(a, 1, { get() { log.push("get 1"); return 20; }, set(v) { log.push("set 1 " + v); }, configurable: true, enumerable: true }); return a; },
  otherPrototype: () => { const a = [1, 2, , 4]; Object.setPrototypeOf(a, { __proto__: Array.prototype, 2: "above" }); return a; },
  frozen: () => { const a = [1, 2, 3, 4]; a.pos = 7; return Object.freeze(a); },
  sealed: () => { const a = [1, 2, 3, 4]; a.pos = 7; return Object.seal(a); },
  holed: () => { const a = [1, , 3, 4]; a.pos = 7; return a; },
};
const methods = {
  push: a => a.push(5),
  pop: a => a.pop(),
  shift: a => a.shift(),
  unshift: a => a.unshift(0),
  at: a => a.at(-1),
  find: a => a.find(v => v > 1),
  findLast: a => a.findLast(v => v < 4),
  findIndex: a => a.findIndex(v => v === 3),
  findLastIndex: a => a.findLastIndex(v => v === 3),
  forEach: a => { let s = ""; a.forEach((v, i, self) => { s += v + ":" + i + (self === a ? "" : "!"); }); return s; },
  some: a => a.some(v => v === 3),
  every: a => a.every(v => v > 0),
  reduce: a => a.reduce((s, v) => s + v),
  reduceRight: a => a.reduceRight((s, v) => s + "" + v, ""),
  indexOf: a => a.indexOf(3),
  lastIndexOf: a => a.lastIndexOf(3),
  includes: a => a.includes(undefined),
  join: a => a.join("-"),
  fill: a => a.fill(8, 1, 2),
  reverse: a => a.reverse(),
  copyWithin: a => a.copyWithin(0, 2),
  toReversed: a => a.toReversed(),
  toSpliced: a => a.toSpliced(1, 1, "x"),
  with: a => a.with(0, "x"),
  slice: a => a.slice(1),
  concat: a => a.concat([5]),
  map: a => a.map(v => v * 2),
  filter: a => a.filter(v => v > 1),
  flat: a => a.flat(),
  toString: a => a.toString(),
};
let log = [];
function show(value) {
  if (Array.isArray(value)) { let text = "["; for (let i = 0; i < value.length; i++) text += (i ? "," : "") + (i in value ? String(value[i]) : "-"); return text + "]" + Object.keys(value).filter(key => !/^\d+$/.test(key)).join("|"); }
  return typeof value === "object" && value !== null ? JSON.stringify(value) : String(value);
}
for (const [madeAs, make] of Object.entries(makers)) {
  for (const [name, call] of Object.entries(methods)) {
    let line = "";
    for (let round = 0; round < 40; round++) {
      log = [];
      const list = make();
      let answer;
      try { answer = show(call(list)); } catch (error) { answer = error.constructor.name; }
      line = madeAs + " " + name + " " + answer + " " + show(list) + " " + log.join(";");
    }
    console.log(line);
  }
}
//// built-ins-see-stores-made-between-two-calls.js
const lines = [];
const say = (title, value) => lines.push(title + ": " + JSON.stringify(value));

function mapCopy() {
  const map = new Map();
  map.set("a", 1);
  const first = new Map(map);
  map.set("a", 2);
  const second = new Map(map);
  return [first.get("a"), second.get("a")];
}
say("new Map(map)", mapCopy());

function mapCopyInLoop() {
  const map = new Map();
  const seen = [];
  for (let i = 0; i < 3; i++) {
    map.set("a", i);
    seen.push(new Map(map).get("a"));
  }
  return seen;
}
say("new Map(map) in a loop", mapCopyInLoop());

function fromEntriesOfMap() {
  const map = new Map();
  map.set("a", 1);
  const first = Object.fromEntries(map);
  map.set("a", 2);
  return [first.a, Object.fromEntries(map).a];
}
say("Object.fromEntries(map)", fromEntriesOfMap());

function typedArrayOfList() {
  const list = [1, 2, 3];
  const first = new Uint8Array(list);
  list[0] = 99;
  const second = new Uint8Array(list);
  const third = new Float64Array(list);
  list[0] = 7;
  return [first[0], second[0], third[0], new Float64Array(list)[0]];
}
say("new Uint8Array(list)", typedArrayOfList());

function typedArrayOfListInLoop() {
  const list = [1, 2, 3];
  let sum = 0;
  for (let i = 0; i < 4; i++) {
    sum += new Int32Array(list)[0];
    list[0] = i * 10;
  }
  return sum;
}
say("new Int32Array(list) in a loop", typedArrayOfListInLoop());

function setOfBytes() {
  const bytes = new Uint8Array([1, 2, 3]);
  const first = new Set(bytes);
  bytes[0] = 99;
  return [first.has(1), first.has(99), new Set(bytes).has(99)];
}
say("new Set(bytes)", setOfBytes());

function textOfList() {
  const list = [1, 2, 3];
  const first = JSON.stringify(list);
  list[0] = 99;
  return [first, JSON.stringify(list)];
}
say("JSON.stringify(list)", textOfList());

function textOfListInLoop() {
  const list = [1, 2, 3];
  let text = "";
  for (let i = 0; i < 3; i++) {
    text += JSON.stringify(list);
    list[1] = i;
  }
  return text;
}
say("JSON.stringify(list) in a loop", textOfListInLoop());

function textOfRecord() {
  const record = { a: 1, inner: { b: 2 } };
  const first = JSON.stringify(record);
  record.inner.b = 3;
  const second = JSON.stringify(record);
  record.a = 4;
  return [first, second, JSON.stringify(record)];
}
say("JSON.stringify(record)", textOfRecord());

function textOfBytes() {
  const bytes = new Uint8Array([1, 2, 3]);
  const first = JSON.stringify(bytes);
  bytes[0] = 99;
  return [first, JSON.stringify(bytes)];
}
say("JSON.stringify(bytes)", textOfBytes());

function ownValuesOfBytes() {
  const bytes = new Uint8Array([1, 2, 3]);
  const before = [Object.values(bytes)[0], Object.entries(bytes)[0][1], Object.getOwnPropertyDescriptors(bytes)[0].value, Array.from(bytes)[0]];
  bytes[0] = 99;
  return [before, Object.values(bytes)[0], Object.entries(bytes)[0][1], Object.getOwnPropertyDescriptors(bytes)[0].value, Array.from(bytes)[0]];
}
say("own values of bytes", ownValuesOfBytes());

function arrayMethodsOnBytes() {
  const bytes = new Uint8Array([1, 2, 3]);
  const all = () => [
    Array.prototype.join.call(bytes, "a"),
    Array.prototype.toString.call(bytes),
    Array.prototype.flat.call(bytes)[0],
    Array.prototype.toReversed.call(bytes)[2],
    Array.prototype.with.call(bytes, 1, 5)[0],
    Array.prototype.toSpliced.call(bytes, 1, 1)[0],
    Object.prototype.toLocaleString.call(bytes),
  ];
  const first = all();
  bytes[0] = 99;
  return [first, all()];
}
say("methods of arrays on bytes", arrayMethodsOnBytes());

function joinTwice() {
  const bytes = new Uint8Array([1, 2, 3]);
  const first = Array.prototype.join.call(bytes, "a");
  bytes[0] = 99;
  return [first, Array.prototype.join.call(bytes, "a")];
}
say("join on bytes", joinTwice());

function sumOfBytes() {
  const bytes = new Uint8Array([1, 2, 3]);
  const first = Math.sumPrecise(bytes);
  bytes[0] = 99;
  return [first, Math.sumPrecise(bytes)];
}
say("Math.sumPrecise(bytes)", sumOfBytes());

function replacementList() {
  const list = [1, 2, 3];
  const first = "a".replace(/a/g, list);
  list[0] = 99;
  return [first, "a".replace(/a/g, list), "a".replaceAll(/a/g, list)];
}
say("a list as the replacement", replacementList());

function dateText() {
  const date = new Date(86400000);
  const first = date.toJSON();
  date.setTime(1000000000000);
  return [first, date.toJSON()];
}
say("date.toJSON()", dateText());

console.log(lines.join("\n"));
//// built-ins-that-write-bytes-and-last-index-through-properties.js
// A read, a call of a built-in that writes what was read by another way than a store, and the same read again, all in one function, in a loop.
function defineByte(u) { const before = u[0]; Object.defineProperty(u, "0", { value: before + 1 }); return before * 100 + u[0]; }
function reflectDefineByte(u) { const before = u[0]; Reflect.defineProperty(u, "0", { value: before + 1 }); return before * 100 + u[0]; }
function assignByte(u) { const before = u[0]; Object.assign(u, { 0: before + 1 }); return before * 100 + u[0]; }
function assignFromList(u) { const before = u[1]; Object.assign(u, [0, before + 1]); return before * 100 + u[1]; }
function reflectSetByte(u) { const before = u[0]; Reflect.set(u, 0, before + 1); return before * 100 + u[0]; }
function reflectSetByReceiver(u, o) { const before = u[0]; Reflect.set(o, "0", before + 1, u); return before * 100 + u[0]; }
function definesByte(u) { const before = u[0]; Object.defineProperties(u, { 0: { value: before + 1 } }); return before * 100 + u[0]; }
function defineLastIndex(re) { const before = re.lastIndex; Object.defineProperty(re, "lastIndex", { value: before + 1 }); return before * 100 + re.lastIndex; }
function reflectLastIndex(re) { const before = re.lastIndex; Reflect.set(re, "lastIndex", before + 1); return before * 100 + re.lastIndex; }
function assignLastIndex(re) { const before = re.lastIndex; Object.assign(re, { lastIndex: before + 1 }); return before * 100 + re.lastIndex; }
function defineLength(a) { const before = a.length; Object.defineProperty(a, "length", { value: before - 1 }); return before * 100 + a.length; }
function reflectLength(a) { const before = a.length; Reflect.set(a, "length", before - 1); return before * 100 + a.length; }
function assignLength(a) { const before = a.length; Object.assign(a, { length: before - 1 }); return before * 100 + a.length; }
function defineElement(a) { const before = a[0]; Object.defineProperty(a, "0", { value: before + 1 }); return before * 100 + a[0]; }
function freezeThenStore(a) { const before = a[0]; Object.freeze(a); try { a[0] = before + 1; } catch {} return before * 100 + a[0]; }
function freezeLastIndex(re) { Object.freeze(re); let threw = 0; try { re.lastIndex = 5; } catch { threw = 1; } return re.lastIndex * 10 + threw; }
function pushOnBytes(u) { const before = u.length; let threw = 0; try { Array.prototype.push.call(u, 9); } catch { threw = 1; } return before * 10 + threw; }
function pushPastEnd() { const a = []; a.length = 4294967295; let name = ""; try { a.push(1); } catch (e) { name = e.name; } return name + " " + a.length + " " + a[4294967295]; }
function fillByCall(u) { const before = u[0]; Array.prototype.fill.call(u, before + 1); return before * 100 + u[0]; }
function reverseByCall(u) { const before = u[0]; Array.prototype.reverse.call(u); return before * 100 + u[0]; }
function copyWithinByCall(u) { const before = u[0]; Array.prototype.copyWithin.call(u, 0, 1); return before * 100 + u[0]; }
function sortByCall(u) { const before = u[0]; Array.prototype.sort.call(u); return before * 100 + u[0]; }
function setDate(d) { const before = d.getTime(); Date.prototype.setTime.call(d, before + 1); return d.getTime() - before; }
const cases = {
  defineByte: () => defineByte(new Uint8Array([3, 4])), reflectDefineByte: () => reflectDefineByte(new Uint8Array([3, 4])), assignByte: () => assignByte(new Uint8Array([3, 4])),
  assignFromList: () => assignFromList(new Uint8Array([3, 4])), reflectSetByte: () => reflectSetByte(new Uint8Array([3, 4])), reflectSetByReceiver: () => reflectSetByReceiver(new Uint8Array([3, 4]), {}),
  definesByte: () => definesByte(new Uint8Array([3, 4])), defineLastIndex: () => defineLastIndex(/a/g), reflectLastIndex: () => reflectLastIndex(/a/g), assignLastIndex: () => assignLastIndex(/a/g),
  defineLength: () => defineLength([1, 2, 3]), reflectLength: () => reflectLength([1, 2, 3]), assignLength: () => assignLength([1, 2, 3]), defineElement: () => defineElement([1, 2, 3]),
  freezeThenStore: () => freezeThenStore([1, 2, 3]), freezeLastIndex: () => freezeLastIndex(/a/g), pushOnBytes: () => pushOnBytes(new Uint8Array(2)), pushPastEnd,
  fillByCall: () => fillByCall(new Uint8Array([3, 4])), reverseByCall: () => reverseByCall(new Uint8Array([3, 4])), copyWithinByCall: () => copyWithinByCall(new Uint8Array([3, 4])),
  sortByCall: () => sortByCall(new Uint8Array([9, 4])), setDate: () => setDate(new Date(5)),
};
for (const name in cases) { let last; for (let i = 0; i < (name === "pushPastEnd" ? 3 : 400); i++) last = cases[name](); console.log(name, last); }
//// callbacks-over-written-lists.js
// map, forEach, some, every, filter, find and findIndex on a list that is written for the call: the callbacks run in the order, with the operands and as often as plain Bun runs them.
const log = [];
const note = (label, value) => (log.push(label), value);
////= attempt-2	Array.isArray(answer) ? `${JSON.stringify(answer)} length ${answer.length}`
const one = () => 1 + log.length, two = () => 2 + log.length;

attempt("map", () => [one(), two()].map(value => value * 10));
attempt("map with the index", () => ["a", "b", "c"].map((value, index) => value + index));
attempt("map without parameters", () => [1, 2].map(() => note("call", 7)));
attempt("map, order", () => [note("a", 1), note("b", 2)].map(note("callback", value => note(`call ${value}`, value))));
attempt("map over nothing", () => [].map(value => note("call", value)));
attempt("map that throws", () => [1, 2, 3].map(value => { if (note(`call ${value}`, value) === 2) throw new RangeError("stop"); return value; }));
attempt("map with the list", () => [1, 2].map((value, index, list) => list.length + value));
attempt("map with the list, changed", () => [1, 2, 3].map((value, index, list) => { list[2] = 9; return value; }));
attempt("map with the rest", () => [1, 2].map((...all) => all.length));
attempt("map with arguments", () => [1, 2].map(function () { return arguments.length; }));
attempt("map with this", () => [1, 2].map(function (value) { return typeof this + value; }));
attempt("map with a receiver", () => [1, 2].map(function (value) { return this.base + value; }, { base: 10 }));
attempt("map with a receiver, an arrow", () => [1, 2].map(value => value + 1, { base: 10 }));
attempt("map with defaults", () => [undefined, 2].map((value = "d", index = "i") => `${value}${index}`));
attempt("map that takes apart", () => [[1, 2], [3, 4]].map(([first, second]) => first + second));
attempt("map with holes", () => [1, , 3].map(value => note("call", value * 2)));
attempt("map with a spread", () => [...[1, 2], 3].map(value => value * 2));
attempt("map with a built-in", () => ["1", "2", "3"].map(Number));
attempt("map with parseInt", () => ["10", "10", "10"].map(parseInt));
attempt("map with a bound function", () => [1, 2].map(Math.max.bind(null, 1.5)));
attempt("map with what is no function", () => [1].map(5));
attempt("map with what is no function, over nothing", () => [].map(undefined));
attempt("map with a class", () => [1].map(class {}));
attempt("map with a class, over nothing", () => [].map(class {}));
attempt("map with an async function", () => [1, 2].map(async value => value).every(promise => promise instanceof Promise));
attempt("map with a generator", () => [1].map(function* (value) { yield value; })[0].next().value);
attempt("map in map", () => [1, 2].map(row => [10, 20].map(column => row * column)));
attempt("map, a function that has a name", () => { const double = value => value * 2; return [1, 2].map(double).concat([3].map(double)); });
attempt("map, one of two functions", () => [1, 2].map(log.length ? value => value : value => -value));
attempt("map, a closure over a variable that changes", () => { let sum = 0; const sums = [1, 2, 3].map(value => (sum += value)); return [...sums, sum]; });
attempt("each evaluation makes its own", () => { const make = () => [1, 2].map(value => value); const first = make(), second = make(); first.push(3); return [first.length, second.length, first !== second]; });
attempt("an ordinary list", () => { const list = [1, 2].map(value => value); return [list.constructor === Array, Object.keys(list).join(), 1 in list]; });

attempt("forEach", () => [one(), two()].forEach(value => note(`call ${value}`)));
attempt("forEach with the index", () => ["a", "b"].forEach((value, index) => note(value + index)));
attempt("forEach with holes", () => [1, , 3].forEach(value => note(`call ${value}`)));
attempt("forEach that throws", () => [1, 2].forEach(value => { note(`call ${value}`); throw new TypeError("stop"); }));

attempt("some, found", () => [1, 2, 3].some(value => note(`call ${value}`, value === 2)));
attempt("some, not found", () => [1, 2, 3].some(value => note(`call ${value}`, value === 9)));
attempt("some over nothing", () => [].some(() => true));
attempt("some, what counts as true", () => [[0, "", null, undefined, NaN, 0n].some(value => value), [0, "a"].some(value => value), [{}].some(value => value), [-0].some(value => value)]);
attempt("every, all", () => [1, 2, 3].every(value => note(`call ${value}`, value > 0)));
attempt("every, not all", () => [1, 2, 3].every(value => note(`call ${value}`, value < 2)));
attempt("every over nothing", () => [].every(() => false));
attempt("find, found", () => [{ id: 1 }, { id: 2 }].find(item => note(`call ${item.id}`, item.id === 2)).id);
attempt("find, not found", () => [1, 2].find(value => value === 9));
attempt("find undefined", () => [undefined, 1].find(value => value === undefined));
attempt("find with holes", () => [, 1].find(value => note(`call ${value}`, value === undefined)));
attempt("findIndex, found", () => ["a", "b"].findIndex(value => value === "b"));
attempt("findIndex, not found", () => ["a", "b"].findIndex(value => value === "z"));
attempt("findIndex with the index", () => ["a", "b"].findIndex((value, index) => index === 1));
attempt("findLast", () => [1, 2, 3].findLast(value => note(`call ${value}`, value < 3)));

attempt("filter", () => [1, 2, 3, 4].filter(value => note(`call ${value}`, value % 2)));
attempt("filter, none", () => [1, 2].filter(() => false));
attempt("filter, all", () => [1, 2].filter(() => true));
attempt("filter with the index", () => ["a", "b", "c"].filter((value, index) => index !== 1));
