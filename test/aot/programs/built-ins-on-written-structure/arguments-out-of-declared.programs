////: attempt
const attempt = (label, run) => {
  try {
    show(label, run());
  } catch (error) {
    console.log(label, "throws", error.constructor.name, error.message.replace(/ \(evaluating.*$/, ""), "|", log.splice(0).join());
  }
};
////: attempt-2
function attempt(label, run) {
  let answer;
  try {
    answer = run();
  } catch (error) {
    answer = error.constructor.name;
  }
  console.log(label, «1» : String(answer), "|", log.splice(0).join());
}
//// arguments-out-of-declared-fields.ts
// Arguments of built-ins that are read out of fields declared string, function and list, of records whose contents come out of JSON.parse: split, forEach, new Error, padStart, join and replace answer as with literals, also where a field holds undefined, null or something of another type after all.
interface Options { separator: string; onDone: (n: number) => void; message: string; fill: string; names: string[] }
function run(text: string, opts: Options, xs: number[]): number {
  xs.forEach(opts.onDone);
  return text.split(opts.separator).length + new Error(opts.message).message.length + text.padStart(8, opts.fill).length + opts.names.join(opts.separator).length + text.replace(opts.separator, opts.fill).length;
}
const input: any = JSON.parse(process.argv[2] ?? '{"text":"a,b","sep":",","xs":[1,2],"m":"boom","fill":"*","names":["x","y"]}');
let sum = 0, total = 0;
const callbacks: any = { add: (n: number) => { sum += n; } };
const options: Options[] = [];
for (let i = 0; i < 4; i++) options.push({ separator: input.sep, onDone: callbacks.add, message: input.m, fill: input.fill, names: input.names });
for (let i = 0; i < 20000; i++) total += run(input.text, options[i & 3], input.xs);
console.log(total, sum);
const odd: any[] = [{ separator: undefined, onDone: callbacks.add, message: undefined, fill: undefined, names: ["x", "y"] }, { separator: null, onDone: callbacks.add, message: null, fill: null, names: ["x", "y"] }, { separator: 5, onDone: callbacks.add, message: 7, fill: 9, names: ["x", "y"] }, { separator: /,/, onDone: callbacks.add, message: { toString() { return "made"; } }, fill: ["-"], names: ["x", "y"] }];
for (const each of odd) console.log(run(input.text, each, input.xs), input.text.split(each.separator).join("|"), new Error(each.message).message, input.text.padStart(8, each.fill), each.names.join(each.separator), input.text.replace(each.separator, each.fill));
//// arguments-that-may-be-undefined-or-null.ts
// Arguments of built-ins whose declared type is an object type, and arguments that are read out of lists and so may be undefined. Each call also runs with undefined, null, primitives, a proxy and a function.
interface Options { target: object; record: Record<string, number>; prototype: object | null; key: string }
function createOptions(values: any): Options {
  return { target: values.target, record: values.record, prototype: values.prototype, key: values.key };
}
const parsed: any = JSON.parse('{"target":{"a":1,"b":2},"record":{"x":3},"prototype":{"p":4},"key":"a"}');

const calls: Record<string, (o: Options) => unknown> = {
  entries: o => Object.entries(o.record),
  values: o => Object.values(o.record),
  keys: o => Object.keys(o.target),
  ownKeys: o => Reflect.ownKeys(o.target),
  getPrototypeOf: o => Object.getPrototypeOf(o.target) === Object.prototype,
  reflectGetPrototypeOf: o => Reflect.getPrototypeOf(o.target) === Object.prototype,
  create: o => Object.getPrototypeOf(Object.create(o.prototype)) === o.prototype,
  reflectGet: o => Reflect.get(o.target, o.key),
  reflectHas: o => Reflect.has(o.target, o.key),
  hasOwn: o => Object.hasOwn(o.target, o.key),
  assign: o => Object.assign({}, o.target, o.record),
  isFrozen: o => Object.isFrozen(o.target),
  getOwnPropertyNames: o => Object.getOwnPropertyNames(o.target),
  getOwnPropertyDescriptor: o => Object.getOwnPropertyDescriptor(o.target, o.key),
  weakSetAdd: o => new WeakSet().add(o.target).has(o.target),
};
function show(run: (o: Options) => unknown, o: Options): string {
  try { return JSON.stringify(run(o)) ?? "undefined"; } catch (error) { return (error as Error).constructor.name; }
}
const usual = createOptions(parsed);
let total = 0;
for (let i = 0; i < 3000; i++) for (const name in calls) total += show(calls[name], usual).length;
console.log(total);
const odd: [string, unknown][] = [
  ["undefined", undefined], ["null", null], ["number", 7], ["text", "ab"], ["boolean", true], ["symbol", Symbol.iterator], ["bigint", 5n], ["list", [1, , 3]], ["function", function named(a: number) { return a; }],
  ["proxy", new Proxy({ a: 1 }, { ownKeys() { return ["a", "z"]; }, getOwnPropertyDescriptor(target, key) { return key === "z" ? { value: 9, enumerable: true, configurable: true } : Reflect.getOwnPropertyDescriptor(target, key); } })],
  ["object without prototype", Object.create(null)], ["instance", new (class Point { a = 1; get b() { return 2; } })()], ["frozen", Object.freeze({ a: 1 })], ["date", new Date(0)], ["map", new Map([["a", 1]])],
];
for (const field of ["target", "record", "prototype", "key"]) {
  for (const [name, value] of odd) {
    const o = createOptions({ ...parsed, [field]: value });
    console.log(field, name, Object.keys(calls).map(call => show(calls[call], o)).join(" "));
  }
}

// Flow sees every string that arrives here, and undefined where the index is past the end. Nobody passes null.
const texts: string[] = ["a,b,c", "d;e"], separators: string[] = [",", ";"];
function countPieces(text: string, separator: string): number { return text.split(separator).length; }
function pad(text: string, filler: string): string { return text.padStart(7, filler); }
function replaceFirst(text: string, pattern: string, replacement: string): string { return text.replace(pattern, replacement); }
const callbacks: ((n: number) => void)[] = [n => { total += n; }, n => { total -= n; }];
function each(list: number[], callback: (n: number) => void): void { list.forEach(callback); }
const lines: string[] = [];
for (let i = 0; i < 3000; i++) {
  const line = [countPieces(texts[i & 1], separators[i % 3]), pad(texts[i & 1], separators[i % 3]), replaceFirst(texts[i & 1], separators[i % 3], separators[(i + 1) % 3])].join(" ");
  try { each([1, 2], callbacks[i % 3]); } catch (error) { total += 100; }
  if (i < 6) lines.push(line);
}
console.log(lines.join("\n"), total);
//// array-from-and-integer-results.js
const lines = [];
function describe(value) {
  if (value === undefined) return "undefined";
  if (typeof value === "object" && value !== null) return Array.isArray(value) ? "[" + value.map(describe).join() + "]" : "{" + Object.keys(value).join() + "}";
  return typeof value + ":" + String(value);
}
function show(name, list) {
  const parts = [];
  for (let i = 0; i < list.length; i++) parts.push(i in list ? describe(list[i]) : "-");
  lines.push(name + ": " + parts.join(" "));
}

const members = new Set([{ a: 1 }, "text", undefined, 3]);
const table = new Map([["k", { v: 1 }], [undefined, undefined]]);
show("set", Array.from(members));
show("set values", Array.from(members.values()));
show("set entries", Array.from(members.entries()));
show("map", Array.from(table));
show("map keys", Array.from(table.keys()));
show("map values", Array.from(table.values()));
show("text", Array.from("a\u{1F600}b"));
show("text iterator", Array.from("xy"[Symbol.iterator]()));
show("list with a hole", Array.from([1, , 3]));
show("list iterator", Array.from([1, , 3].keys()));
show("like a list", Array.from({ length: 3, 0: "first", 2: "third" }));
show("nothing to go over", Array.from({}));
show("number", Array.from(5));

const ownSteps = new Set([1, 2]);
ownSteps[Symbol.iterator] = function* () { yield "own"; yield undefined; };
show("set with steps of its own", Array.from(ownSteps));
class Doubled extends Set { *[Symbol.iterator]() { for (const value of super.values()) { yield value; yield value; } } }
show("class below Set", Array.from(new Doubled(["d"])));
const steppedOnce = table.keys();
steppedOnce.next();
show("iterator that has taken a step", Array.from(steppedOnce));
const nextOfItsOwn = members.values();
nextOfItsOwn.next = function () { return { done: true }; };
show("iterator with a next of its own", Array.from(nextOfItsOwn));
const grows = new Set([1]);
show("set that grows while it is mapped", Array.from(grows, value => { if (value < 3) grows.add(value + 1); return value * 10; }));
class Stack extends Array {}
lines.push("class below Array: " + (Stack.from(members) instanceof Stack) + " " + Stack.from(members).length);
lines.push("another receiver: " + describe(Array.from.call(function (length) { this.given = length; }, new Set(["x"]))));

function firstField(list) { return list[0].a; }
lines.push("field of the first: " + firstField(Array.from(new Set([{ a: 41 }]))));

const counts = [];
counts.push(members.size, table.size, "abc".length, [1, 2].length);
counts.push("abc".indexOf("c"), "abc".indexOf("z"), "abcabc".lastIndexOf("b"), "abc".search(/c/), "abc".search(/z/));
counts.push([5, 6].indexOf(6), [5, 6].indexOf(7), [5, 6].lastIndexOf(5), [5, 6].findIndex(value => value > 5), [5, 6].findLastIndex(value => value > 9));
counts.push([].push(1, 2, 3), [1].unshift(0), "a".localeCompare("b"), "b".localeCompare("a"), "a".localeCompare("a"));
counts.push("a".codePointAt(0), Math.clz32(1), Math.clz32(0), Math.imul(65536, 65536), Math.imul(-1, 5));
counts.push(new Uint8Array(3).length, new Uint8Array(3).byteLength, new ArrayBuffer(7).byteLength, new Float64Array(2).byteOffset, new Uint8Array([9, 8]).indexOf(8));
const view = new DataView(new ArrayBuffer(8));
view.setInt32(0, -1);
counts.push(view.getInt8(0), view.getUint8(0), view.getInt16(0), view.getUint16(0), view.getInt32(0), view.getUint32(0));
show("counts", counts);
let sum = 0;
for (let i = 0; i < counts.length; i++) sum += counts[i];
lines.push("sum " + sum + " " + counts.every(Number.isInteger) + " " + counts.map(count => Object.is(count, -0)).includes(true));
const kept = new Set(counts);
const byCount = new Map(counts.map(count => [count, count / 2]));
lines.push("kept " + kept.size + " " + kept.has(-1) + " " + kept.has(4294967295) + " " + byCount.get(3) + " " + byCount.get(-1));
const indexes = [];
["x", "y", "z"].forEach((text, index, all) => { indexes.push(index / all.length); });
show("indexes", indexes);
show("indexes of a typed array", Array.from(new Uint8Array(3), (value, index) => index - 0.5));
show("indexes of reduce", ["x", "y"].reduce((list, text, index) => { list.push(index * 1.5); return list; }, []));
lines.push("what is no integer: " + "abc".charCodeAt(9) + " " + "abc".codePointAt(9) + " " + new Date(NaN).getFullYear() + " " + [].length / 0 + " " + Math.round(-0.2));
console.log(lines.join("\n"));
