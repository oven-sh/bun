//// literals-that-a-spread-completes.js
// What a list holds is known only where every element is written: spreads of generators, iterators with effects, arguments, sets that change, texts, replaced iterators and spreads in spreads.
const log = [];
const note = (label, value) => (log.push(label), value);
const look = (list, word) => `${list.includes(word)} ${list.indexOf(word)} [${list.join()}] ${list.length} ${[...list, word].length} ${new Set(list).size} ${list.map(value => `${value}!`).join("")} ${list.some(value => value === word)} ${list.filter(Boolean).length} ${list.concat([word]).length}`;
const show = (label, answer) => console.log(label, answer, "|", log.splice(0).join());

function* generator() { note("first"); yield "a"; note("second"); yield "b"; note("end"); }
function ofGenerator(word) { const list = [...generator()]; return look(list, word); }
show("a generator", ofGenerator("b"));
function ofGeneratorAndMore(word) { const list = ["x", ...generator(), "y"]; return look(list, word); }
show("a generator between elements", ofGeneratorAndMore("y"));
function searchedAtOnce(word) { return `${[...generator()].includes(word)} ${[...generator()].indexOf(word)} ${[...generator()].join("-")} ${[...generator()].map(value => value + value)} ${[...generator()].some(value => value === word)}`; }
show("a generator, used at once", searchedAtOnce("b"));

const counting = { from: 0, [Symbol.iterator]() { note("opened"); let step = this.from; return { next: () => (note(`step ${step}`), step < 2 ? { done: false, value: `v${step++}` } : { done: true }), return: () => (note("closed"), {}) }; } };
function ofIterator(word) { const list = [...counting]; return look(list, word); }
show("an iterator that is seen at work", ofIterator("v1"));
function ofIteratorTwice(word) { const list = [...counting, ...counting]; return look(list, word); }
show("an iterator, twice", ofIteratorTwice("v0"));
const failing = { *[Symbol.iterator]() { yield "a"; throw new RangeError("stop"); } };
function ofFailing() { try { const list = ["x", ...failing]; return look(list, "x"); } catch (error) { return error.constructor.name; } }
show("an iterator that throws", ofFailing());

function ofArguments() { const list = [...arguments]; return look(list, "b"); }
show("arguments", ofArguments("a", "b"));
show("arguments, none", ofArguments());
function ofRest(...rest) { const list = [...rest, "z"]; return look(list, "z"); }
show("a rest parameter", ofRest("a", "b"));
function ofParameter(given, word) { const list = [...given]; return look(list, word); }
show("a parameter: a list, a text, a set, a map, a typed array", [ofParameter(["p", "q"], "q"), ofParameter("pq", "q"), ofParameter(new Set(["p"]), "p"), ofParameter(new Map([["k", 1]]), "k"), ofParameter(new Uint8Array([1, 2]), 2)].join(" || "));
function ofNothing(given) { try { return look([...given], 1); } catch (error) { return error.constructor.name; } }
show("what cannot be spread", [ofNothing(null), ofNothing(undefined), ofNothing(5), ofNothing({})].join());

const growing = new Set(["a"]);
const ofGrowing = word => { const list = [...growing]; return look(list, word); };
show("a set, before", ofGrowing("b"));
growing.add("b");
show("a set, behind", ofGrowing("b"));
growing.delete("a");
show("a set, behind again", ofGrowing("a"));
const early = [...growing];
growing.add("late");
show("a list made of the set before it grew", look(early, "late"));
const fixedSet = new Set(["a", "b"]);
const ofFixedSet = word => look([...fixedSet], word);
show("a set nobody changes", ofFixedSet("b"));
const table = new Map([["k", "v"]]);
show("keys, values, entries", [look([...table.keys()], "k"), look([...table.values()], "v"), [...table.entries()].join("|"), [...table].length].join(" || "));

show("a text", look([..."abc"], "b"));
show("a text outside the basic plane", look([..."a😀"], "😀"));
show("an empty text", look([...""], ""));
const text = "xy";
show("a text that has a name", look([...text, "z"], "y"));

const replaced = ["a", "b"];
replaced[Symbol.iterator] = function* () { note("replaced"); yield "other"; };
show("a list with its own iterator", look([...replaced], "other"));
const inherited = Object.setPrototypeOf(["a"], { __proto__: Array.prototype, *[Symbol.iterator]() { yield "inherited"; } });
show("a list that inherits another iterator", look([...inherited], "inherited"));
class Stack extends Array { *[Symbol.iterator]() { yield "stack"; } }
show("a class below Array with its own iterator", look([...Stack.of("a")], "stack"));
const arrayLike = { length: 2, 0: "a", 1: "b" };
show("what only looks like a list", (() => { try { return look([...arrayLike], "a"); } catch (error) { return error.constructor.name; } })());

const inner = ["a", "b"], middle = [...inner, "c"], outer = ["z", ...middle, ...inner];
show("spreads in spreads, by name", [look(inner, "b"), look(middle, "c"), look(outer, "a")].join(" || "));
show("spreads in spreads, written", look([...[...["a"], "b"], ...[...[], ...["c"]]], "c"));
show("spreads in spreads, with a generator inside", look(["x", ...[...generator(), "y"]], "y"));
function nested(word) { const first = ["a"], second = [...first, word], third = [...second, ...first]; return `${look(first, word)} || ${look(second, word)} || ${look(third, word)}`; }
show("spreads in spreads, in a function", nested("w"));
const holes = [...[1, , 3]];
show("a spread of holes", `${holes.includes(undefined)} ${holes.indexOf(undefined)} ${1 in holes} ${holes.length}`);

const changedLater = ["a", "b"];
const copyBefore = [...changedLater];
const lookAtCopies = () => `${look(copyBefore, "c")} || ${look([...changedLater], "c")}`;
show("a spread of a list that changes later, before", lookAtCopies());
changedLater.push("c");
show("a spread of a list that changes later, behind", lookAtCopies());
const pushedBehind = [...inner];
pushedBehind.push("p");
show("a completed literal that is pushed to", look(pushedBehind, "p"));
let turns = 0;
for (let turn = 0; turn < 400; turn++) turns += [...generatorOf(turn % 3)].includes(1) ? 1 : 0;
function* generatorOf(count) { for (let index = 0; index < count; index++) yield index; }
log.length = 0;
show("in a loop", turns);
//// map-constructor-modified-pairs.js
const lines = [];
function describe(value) {
  if (value === undefined) return "undefined";
  if (value === null) return "null";
  if (typeof value === "object") return Array.isArray(value) ? "array(" + value.length + ")" : "object(" + Object.keys(value).join() + ")";
  return typeof value + "(" + String(value) + ")";
}
function report(name, table) {
  const parts = [];
  table.forEach((value, key) => { parts.push(describe(key) + "=>" + describe(value)); });
  lines.push(name + ": " + parts.join(" | "));
}

function untouched() {
  const table = new Map([["a", { inner: { deep: 1 } }], ["b", { inner: { deep: 2 } }]]);
  report("untouched", table);
  return table.get("a").inner.deep + table.get("b").inner.deep;
}
function computed(names) {
  const table = new Map(names.map((name, index) => [name, { at: index }]));
  report("computed", table);
  let sum = 0;
  for (const name of names) sum += table.get(name).at;
  return sum;
}
function storedAtZero() {
  const pair = ["a", { v: 1 }];
  pair[0] = { k: 2 };
  report("storedAtZero", new Map([pair]));
}
function storedAtOne() {
  const pair = ["a", { v: 1 }];
  pair[1] = "text";
  const table = new Map([pair]);
  report("storedAtOne", table);
  return table.get("a").length;
}
function storedByCallee() {
  const pair = ["a", { v: 1 }];
  swap(pair);
  report("storedByCallee", new Map([pair]));
}
function swap(list) { const first = list[0]; list[0] = list[1]; list[1] = first; }
function reversed() {
  const pair = ["a", { v: 1 }];
  pair.reverse();
  report("reversed", new Map([pair]));
}
function shifted() {
  const pair = ["a", { v: 1 }];
  pair.shift();
  report("shifted", new Map([pair]));
}
function popped() {
  const pair = ["a", { v: 1 }];
  pair.pop();
  const table = new Map([pair]);
  report("popped", table);
  return table.get("a") === undefined;
}
function unshifted() {
  const pair = ["a", { v: 1 }];
  pair.unshift(7);
  report("unshifted", new Map([pair]));
}
function cut() {
  const pair = ["a", { v: 1 }];
  pair.length = 1;
  report("cut", new Map([pair]));
}
function emptied() {
  const pair = ["a", { v: 1 }];
  pair.length = 0;
  report("emptied", new Map([pair]));
}
function deleted() {
  const pair = ["a", { v: 1 }];
  delete pair[1];
  report("deleted", new Map([pair]));
}
function deletedAboveAnotherList() {
  const pair = ["a", { v: 1 }];
  delete pair[1];
  Object.setPrototypeOf(pair, ["inherited key", "inherited value"]);
  report("deletedAboveAnotherList", new Map([pair]));
}
function redefined() {
  const pair = ["a", { v: 1 }];
  Object.defineProperty(pair, 1, { get() { return 42; } });
  const table = new Map([pair]);
  report("redefined", table);
  return table.get("a") + 1;
}
function filled() {
  const pair = ["a", { v: 1 }];
  pair.fill(false);
  report("filled", new Map([pair]));
}
function sorted() {
  const pair = ["b", "a"];
  pair.sort();
  report("sorted", new Map([pair]));
}
function copiedWithin() {
  const pair = ["a", { v: 1 }];
  pair.copyWithin(0, 1);
  report("copiedWithin", new Map([pair]));
}
function spliced() {
  const pair = ["a", { v: 1 }];
  pair.splice(0, 1, 1.5, 2.5);
  report("spliced", new Map([pair]));
}
function assigned() {
  const pair = ["a", { v: 1 }];
  Object.assign(pair, { 0: "assigned" }, ["again"]);
  report("assigned", new Map([pair]));
}
function storedThroughReflect() {
  const pair = ["a", { v: 1 }];
  Reflect.set(pair, "1", 9n);
  report("storedThroughReflect", new Map([pair]));
}
function handedToUnknownCode() {
  const pair = ["a", { v: 1 }];
  globalThis.keptPair = pair;
  globalThis[["kept", "Pair"].join("")][1] = Symbol.for("stored");
  const table = new Map([pair]);
  lines.push("handedToUnknownCode: " + typeof table.get("a"));
}
function touchedWhileTheListIsGoneOver() {
  const first = ["a", { v: 1 }];
  const second = ["b", { v: 2 }];
  function* entries() {
    yield first;
    second[1] = "late";
    yield second;
  }
  report("touchedWhileTheListIsGoneOver", new Map(entries()));
}
function touchedBySetOfSubclass() {
  const second = ["b", { v: 2 }];
  class Watching extends Map {
    set(key, value) {
      second[0] = 5;
      return super.set(key, value);
    }
  }
  report("touchedBySetOfSubclass", new Watching([["a", { v: 1 }], second]));
}
function listGoneOverAnotherWay() {
  const list = [["a", { v: 1 }]];
  list[Symbol.iterator] = function* () { yield [1, 2]; };
  report("listGoneOverAnotherWay", new Map(list));
}
function longerThanAPair() {
  report("longerThanAPair", new Map([["a", { v: 1 }, "third"]]));
}
function spreadBehindThePair(rest) {
  report("spreadBehindThePair", new Map([["a", { v: 1 }, ...rest]]));
}
function holeInThePair() {
  report("holeInThePair", new Map([["a", , { v: 1 }], [, "b"]]));
}
function entriesThatAreNoLists() {
  report("entriesThatAreNoLists", new Map([{ 0: "a", 1: { v: 1 } }, { 0: "b" }, new String("xy"), function named() {}]));
}
function pairsAmongOtherEntries(flag) {
  const entry = flag ? ["a", { v: 1 }] : { 0: { k: 1 }, 1: "value" };
  report("pairsAmongOtherEntries " + flag, new Map([entry, ["c", { v: 3 }]]));
}
function copyOfATable() {
  const first = new Map();
  first.set("a", { inner: { deep: 1 } });
  first.set(2, "two");
  const second = new Map(first);
  first.set("later", true);
  report("copyOfATable", second);
  return second.get("a").inner.deep;
}
function copyOfATableGoneOverAnotherWay() {
  const first = new Map([["a", 1]]);
  first[Symbol.iterator] = function* () { yield [{ k: 1 }, { v: 1 }]; };
  report("copyOfATableGoneOverAnotherWay", new Map(first));
}
function pairsOfSteps() {
  const first = new Map([["a", { v: 1 }]]);
  const kept = [];
  for (const entry of first) kept.push(entry);
  kept[0][1] = "stored into the pair of a step";
  report("pairsOfSteps", new Map(kept));
}
function entriesOfAnObject() {
  const entries = Object.entries({ a: { v: 1 }, b: { v: 2 } });
  entries.push([3, "three"]);
  report("entriesOfAnObject", new Map(entries));
}
function numbersAsValues() {
  const table = new Map([["a", 1], ["b", 2.5], ["c", -0], ["d", NaN]]);
  report("numbersAsValues", table);
  return table.get("a") + table.get("b") + 1 / table.get("c");
}
function numbersAsKeys() {
  const table = new Map([[1, "a"], [2.5, "b"], [-0, "c"], [NaN, "d"]]);
  report("numbersAsKeys", table);
  return [...table.keys()].map(key => 1 / key).join();
}
function weak() {
  const key = { isKey: true };
  const other = { isKey: false };
  const pair = [key, { v: 1 }];
  const table = new WeakMap([pair, [other, "text"]]);
  pair[1] = "too late";
  lines.push("weak: " + describe(table.get(key)) + " " + describe(table.get(other)) + " " + describe(table.get({})));
}
function refused() {
  for (const entries of [[1], ["ab"], [null], 5, [[{}, 1]]]) {
    try { lines.push("refused: " + new Map(entries).size); } catch (error) { lines.push("refused: " + error.constructor.name); }
    try { new WeakMap(entries); lines.push("refused weak: none"); } catch (error) { lines.push("refused weak: " + error.constructor.name); }
  }
}

lines.push(String(untouched()), String(computed(["x", "y", "z"])));
storedAtZero(); lines.push(String(storedAtOne())); storedByCallee(); reversed(); shifted(); lines.push(String(popped())); unshifted(); cut(); emptied(); deleted(); deletedAboveAnotherList();
lines.push(String(redefined())); filled(); sorted(); copiedWithin(); spliced(); assigned(); storedThroughReflect(); handedToUnknownCode(); touchedWhileTheListIsGoneOver(); touchedBySetOfSubclass();
listGoneOverAnotherWay(); longerThanAPair(); spreadBehindThePair([1, 2]); holeInThePair(); entriesThatAreNoLists(); pairsAmongOtherEntries(true); pairsAmongOtherEntries(false);
lines.push(String(copyOfATable())); copyOfATableGoneOverAnotherWay(); pairsOfSteps(); entriesOfAnObject(); lines.push(String(numbersAsValues()), numbersAsKeys()); weak(); refused();
console.log(lines.join("\n"));
//// maps-and-sets-of-written-lists.js
// new Map and new Set of lists that are written in the call: order of evaluation, equal keys, entries that are no objects, replaced set and add, classes below them.
const log = [];
const note = (label, value) => (log.push(label), value);
const text = value => (typeof value === "function" ? "function " + JSON.stringify(value.name) : Object.is(value, -0) ? "-0" : typeof value === "symbol" || typeof value === "bigint" ? String(value) : value === undefined ? "undefined" : Number.isNaN(value) ? "NaN" : JSON.stringify(value));
const show = (label, collection) => {
  const entries = collection instanceof Map ? [...collection].map(([key, value]) => text(key) + "=>" + text(value)) : [...collection].map(text);
  console.log(label, collection.constructor.name, collection.size, entries.join(" "), "|", log.splice(0).join());
};
