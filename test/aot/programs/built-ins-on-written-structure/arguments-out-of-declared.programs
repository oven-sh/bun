//// maps-copied-by-the-constructor.ts
const lines: string[] = [];
const say = (title: string, value: unknown) => lines.push(title + ": " + JSON.stringify(value));

class Declaration { constructor(public text: string) {} }
class Entry {
  members?: Map<string, Entry>;
  declarations: Declaration[] = [];
  constructor(public name: string) {}
}
class Impostor { name = 7; extra = "impostor"; }

function tableOf(names: string[]): Map<string, Entry> {
  const table = new Map<string, Entry>();
  for (const name of names) {
    const entry = new Entry(name);
    entry.declarations.push(new Declaration(name + "!"));
    table.set(name, entry);
  }
  return table;
}
function cloneOf(entry: Entry): Entry {
  const copy = new Entry(entry.name);
  if (entry.members) copy.members = new Map(entry.members);
  return copy;
}
function nameLength(entry: Entry, name: string): unknown {
  const found = entry.members!.get(name);
  return found ? found.name.length : "absent";
}

const root = new Entry("root");
say("no members", cloneOf(root).members === undefined);
root.members = tableOf(["alpha", "beta"]);
const clone = cloneOf(root);
say("same values", clone.members!.get("alpha") === root.members.get("alpha"));
say("another map", clone.members !== root.members);
clone.members!.set("gamma", new Entry("gamma"));
say("the original is untouched", [root.members.size, clone.members!.size]);
say("lengths", ["alpha", "beta", "gamma", "delta"].map(name => [nameLength(root, name), nameLength(clone, name)]));

(root.members as Map<string, unknown>).set("odd", new Impostor());
const cloneWithImpostor = cloneOf(root);
say("a value of another class is copied", [nameLength(cloneWithImpostor, "odd"), (cloneWithImpostor.members!.get("odd") as unknown as Impostor).extra]);
say("a copy of a copy", nameLength(cloneOf(cloneWithImpostor), "odd"));

function sumOf(numbers: Map<string, number>): number {
  let sum = 0;
  for (const name of ["a", "b", "c"]) sum += numbers.get(name)! + 1;
  return sum;
}
const small = new Map<string, number>();
small.set("a", 1);
small.set("b", 2);
small.set("c", 3);
say("small numbers", sumOf(new Map(small)));
small.set("b", 2 ** 40);
small.set("c", 0.5);
say("numbers that are no int32", sumOf(new Map(small)));
small.set("a", -0);
say("negative zero", Object.is(new Map(small).get("a"), -0));

say("keys stay keys", [...new Map(new Map<unknown, unknown>([[root, "value"], ["key", clone]])).keys()].map(key => typeof key));
say("undefined and null", [new Map(undefined).size, new Map(null).size]);

const withOwnIterator = new Map([["a", 1]]);
(withOwnIterator as any)[Symbol.iterator] = function* () { yield ["own", 2]; };
say("an iterator of its own", [...new Map(withOwnIterator)]);

const withOwnName = new Map([["a", 1]]);
(withOwnName as any).label = "named";
say("a property of its own", [...new Map(withOwnName)]);

class Reversed<K, V> extends Map<K, V> {
  *[Symbol.iterator](): MapIterator<[K, V]> { for (const [key, value] of [...super.entries()].reverse()) yield [key, value]; }
}
say("a subclass that iterates otherwise", [...new Map(new Reversed([["a", 1], ["b", 2]])).keys()]);

const relinked = new Map([["a", 1]]);
Object.setPrototypeOf(relinked, { __proto__: Map.prototype, *[Symbol.iterator]() { yield ["relinked", 3]; } });
say("another prototype", [...new Map(relinked as Map<string, number>)]);

const calls: unknown[] = [];
class Counting<K, V> extends Map<K, V> {
  set(key: K, value: V): this { calls.push([key, value]); return super.set(key, value); }
}
say("set of a subclass", [[...new Counting(new Map([["a", 1], ["b", 2]]))], calls]);

class Refusing<K, V> extends Map<K, V> {
  set(key: K, value: V): this { if (key === "b") throw new RangeError("refused " + String(value)); return super.set(key, value); }
}
try {
  new Refusing(new Map([["a", 1], ["b", 2]]));
  say("set that throws", "no error");
} catch (error) {
  say("set that throws", (error as Error).message);
}

class Keeping extends Map<string, Entry> {
  kept: Entry[] = [];
  set(key: string, value: Entry): this { (this.kept ??= []).push(value); value.name += "+"; return super.set(key, value); }
}
const keeping = new Keeping(tableOf(["kept"]));
say("set of a subclass changes a value", [keeping.get("kept")!.name, keeping.kept.length]);

say("a weak map of a map", new WeakMap(new Map([[root, 1]])).get(root));
try {
  new WeakMap(new Map([["text", 1]]) as never);
  say("a weak map refuses a string", "no error");
} catch (error) {
  say("a weak map refuses a string", (error as Error).constructor.name);
}

function unused(map: Map<string, number>): number {
  new Map(map);
  return map.size;
}
say("a copy that nobody uses", unused(small));

console.log(lines.join("\n"));
//// new-sets-without-operands.js
// `new Set()` without operands, with undefined and with null makes an empty set of the class itself: its prototype, its size, what it takes, what a class below Set makes, what Reflect.construct makes for another new.target, and a million of them across collections.
class Bag extends Set { extra = 1; }
function show(s) { return [Object.getPrototypeOf(s) === Set.prototype, s instanceof Set, Reflect.get(Set.prototype, "size", s), Object.prototype.toString.call(s), Object.keys(s).length, Object.isExtensible(s)].join(); }
function plain() { return new Set(); }
function withUndefined() { return new Set(undefined); }
function withNull() { return new Set(null); }
function filled() { const s = new Set(); s.add(1); s.add("a"); s.add(s); s.add(1); return s; }
function below() { return new Bag(); }
function forAnother() { return Reflect.construct(Set, [], Bag); }
function forObject() { return Reflect.construct(Set, [], Object); }
for (const make of [plain, withUndefined, withNull, filled, below, forAnother, forObject]) { let last; for (let i = 0; i < 2000; i++) last = make(); console.log(make.name, show(last), Set.prototype.has.call(last, 1), last.extra); }
let threw = ""; try { Set(); } catch (e) { threw = e.name; } console.log(threw);
const kept = []; let total = 0;
for (let i = 0; i < 1000000; i++) { const s = new Set(); if ((i & 1023) === 0) { s.add(i); kept.push(s); } total += s.size; }
console.log(total, kept.length, kept[5].has(5120), kept.every(s => s.size === 1));
const named = new Set(); named.label = "own"; named[0] = 1; console.log(named.label, named[0], named.size, JSON.stringify([...named]));
const frozen = Object.freeze(new Set()); frozen.add(1); console.log(frozen.size, Object.isFrozen(frozen));
console.log([...new Set().union(new Set([1]))].join(), new Set().isSubsetOf(new Set()), structuredClone(new Set()).size, new Set().entries().next().done);
//// object-assign-onto-a-written-object.js
// Object.assign onto an object literal, with literals and other values as sources: setters, getters, __proto__, order, symbols and sources that are no objects.
const log = [];
const note = (label, value) => (log.push(label), value);
const describe = object => Reflect.ownKeys(object).map(key => {
  const d = Object.getOwnPropertyDescriptor(object, key);
  const flags = (d.enumerable ? "e" : "-") + (d.configurable ? "c" : "-") + ("writable" in d ? (d.writable ? "w" : "-") : "a");
  return `${String(key)}:${flags}:${"value" in d ? (typeof d.value === "function" ? "f " + d.value.name : JSON.stringify(d.value)) : "accessor"}`;
}).join(" ");
const attempt = (label, run) => {
  try {
    const made = run();
    console.log(label, describe(made), "| proto", Object.getPrototypeOf(made) === Object.prototype, "|", log.splice(0).join());
    return made;
  } catch (error) {
    console.log(label, "throws", error.constructor.name, error.message.replace(/ \(evaluating.*$/, ""), "|", log.splice(0).join());
  }
};

attempt("three literals", () => Object.assign({}, { a: note("a", 1) }, { b: note("b", 2) }));
attempt("onto members", () => Object.assign({ a: 1, b: 2 }, { c: 3 }));
attempt("a member is replaced where it stands", () => Object.assign({ a: 1, b: 2 }, { c: 3, a: 4 }, { b: 5, d: 6 }));
attempt("order of evaluation", () => Object.assign({ a: note("t", 1) }, note("s1", { b: note("b", 2) }), { c: note("c", 3) }));
attempt("getters of a source run in the assignment", () => Object.assign({ a: note("a", 1) }, { get b() { return note("get b", 2); } }, { c: note("c", 3) }));
attempt("a setter of the target takes the value", () => Object.assign({ kept: 0, set a(v) { note("set a " + v); this.kept = v; } }, { a: 5, b: 6 }));
attempt("a getter alone refuses the store", () => Object.assign({ get a() { return 1; } }, { z: note("z", 0), a: 5, b: 6 }));
attempt("__proto__ written in a source names what lies above the source", () => Object.assign({}, { __proto__: { inherited: 1 }, a: 1 }));
attempt("__proto__ as an own member of a source sets what lies above the target", () => Object.assign({ a: 1 }, JSON.parse('{"__proto__": {"x": 1}, "b": 2}')));
attempt("__proto__ computed in a source", () => Object.assign({ a: 1 }, { ["__proto__"]: null, b: 2 }));
attempt("names of Object.prototype", () => Object.assign({}, { toString: 1, constructor: 2, valueOf: 3, hasOwnProperty: 4 }));
attempt("null and undefined are passed over", () => Object.assign({ a: 1 }, null, { b: 2 }, undefined, { c: 3 }));
attempt("primitives", () => Object.assign({}, "ab", 5, true, 10n, Symbol("s"), { c: 3 }));
attempt("an array", () => Object.assign({ 1: "kept", z: 0 }, ["zero", , "two"]));
attempt("symbols come last", () => Object.assign({}, { [Symbol.for("s")]: 1, b: 2 }, { a: 3, [Symbol.for("t")]: 4 }));
attempt("indexes come first", () => Object.assign({ b: 0 }, { 2: "two", a: 1, 0: "zero" }));
attempt("hidden members stay behind", () => Object.assign({}, Object.defineProperty({ a: 1 }, "hidden", { value: 2 })));
attempt("what a source inherits stays behind", () => Object.assign({}, Object.create({ inherited: 1 }, { own: { value: 2, enumerable: true } })));
attempt("read-only members become plain", () => Object.assign({}, Object.freeze({ a: 1 })));
attempt("a spread in the target", () => Object.assign({ ...{ a: 1, b: 2 }, c: 3 }, { b: 4, d: 5 }));
attempt("a spread argument", () => Object.assign({}, ...[{ a: 1 }, { b: 2 }]));
attempt("the target alone", () => Object.assign({ a: 1 }));
attempt("a source throws half way", () => Object.assign({}, { a: 1, get b() { throw new RangeError("no b"); }, c: 3 }));
attempt("methods keep their names", () => Object.assign({}, { run() {}, arrow: () => 1, plain: function () {} }));
let half;
try {
  Object.assign((half = { a: 0 }), { a: 1, b: 2 }, { get c() { throw new RangeError("stop"); } }, { d: 4 });
} catch {}
console.log("what came before the throw is there", describe(half));
const seen = [];
attempt("a getter of a source sees the target half made", () => {
  const target = { a: 1 };
  return Object.assign(target, { b: 2 }, { get c() { seen.push(Object.keys(target).join()); return 3; } }, { d: 4 });
});
console.log(seen.join(" "));
attempt("a source changes while it is copied", () => {
  const source = { get a() { delete this.b; this.c = "late"; return 1; }, b: 2 };
  return Object.assign({}, source);
});
const proxy = new Proxy({ a: 1, b: 2 }, {
  ownKeys: target => note("ownKeys", Reflect.ownKeys(target)),
  getOwnPropertyDescriptor: (target, key) => note("describe " + key, Reflect.getOwnPropertyDescriptor(target, key)),
  get: (target, key) => note("get " + key, target[key]),
});
attempt("a proxy for a source", () => Object.assign({ z: 0 }, proxy));
{
  const Object = { assign: (...all) => ({ mine: all.length }) };
  attempt("another Object", () => Object.assign({}, { a: 1 }, { b: 2 }));
}
const { assign } = Object;
attempt("the function in a variable", () => assign({}, { a: 1 }, { b: 2 }));

function options(given) {
  return Object.assign({}, { depth: 1, color: "red", deep: { x: 1 } }, given);
}
const all = [options(), options({ depth: 2 }), options({ extra: true, color: undefined }), options(null), options("xy")];
console.log("defaults and what is given", all.map(one => JSON.stringify(one)).join(" "));
all[0].deep.x = 2;
console.log("the values are shared, the objects are not", all[1].deep.x, all[0] !== all[1]);
let sum = 0;
for (let turn = 0; turn < 2000; turn++) {
  const made = Object.assign({}, { x: turn }, { y: turn + 1 }, turn % 3 ? { z: 1 } : null);
  sum += made.x + made.y + (made.z ?? 0);
