import { EventEmitter } from "node:events";

const lines: string[] = [];
const warm = 300;
const turn = () => new Promise<void>(resolve => setImmediate(resolve));
const names = ["_events", "_eventsCount", "_maxListeners"];
function made(object: any): string {
