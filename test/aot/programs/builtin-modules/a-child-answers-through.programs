    return;
  }
  console.log(title + ": " + Reflect.ownKeys(made).map(key => String(key) + "=" + show(made[key])).join(" | ") + " || " + [made._eventsCount, made._maxListeners, made.getMaxListeners(), made.listenerCount("x")].join());
}

