}
//// a-child-answers-through-the-channel-of-process.js
// A child that was started with a channel: its listener for "message" opens the channel, process.send answers through it, process.disconnect closes it.
const startedFromExecutable = /[$~]bun/i.test(process.argv[1]);
if (process.env.CHILD_WITH_CHANNEL) {
  process.on("message", message => {
    process.send({ answered: message, connected: process.connected, hasChannel: process.channel != null });
    if (message.last) process.disconnect();
  });
  process.on("disconnect", () => console.log("child: disconnect", process.connected));
} else {
  const received = [];
  const child = Bun.spawn({
    cmd: startedFromExecutable ? [process.execPath] : [process.execPath, process.argv[1]],
    env: { ...process.env, CHILD_WITH_CHANNEL: "1" },
    stdin: "ignore",
    stdout: "pipe",
    stderr: "inherit",
    ipc(message) { received.push(message); },
  });
  child.send({ text: "first", list: [1, 2, 3] });
  child.send({ text: "second", last: true });
  const [output, exitCode] = await Promise.all([new Response(child.stdout).text(), child.exited]);
  console.log(JSON.stringify(received));
  console.log(output.trim(), exitCode, typeof process.send, process.connected);
}
//// a-child-opens-the-channel-of-process-through-another-variable-and-a-computed-event.js
// The same child, written so that nothing spells it out: `process` comes through another variable and a function, the method and the event are computed. The channel is opened all the same.
const startedFromExecutable = /[$~]bun/i.test(process.argv[1]);
const listen = (emitter, method, event, listener) => emitter[method](event, listener);
if (process.env.CHILD_WITH_CHANNEL) {
  const self = [process][Number(process.env.CHILD_WITH_CHANNEL) - 1];
  const event = ["mess", "age"].join("");
  listen(self, ["o", "n"].join(""), event, message => {
    self[["se", "nd"].join("")]({ answered: message });
    if (message === "last") self.disconnect();
  });
  listen(self, "once", ["dis", "connect"].join(""), () => console.log("child: disconnect", self.connected));
} else {
  const received = [];
  const child = Bun.spawn({
    cmd: startedFromExecutable ? [process.execPath] : [process.execPath, process.argv[1]],
    env: { ...process.env, CHILD_WITH_CHANNEL: "1" },
    stdin: "ignore",
    stdout: "pipe",
    stderr: "inherit",
    ipc(message) { received.push(message); },
  });
  child.send("first");
  child.send("last");
  const [output, exitCode] = await Promise.all([new Response(child.stdout).text(), child.exited]);
  console.log(JSON.stringify(received), output.trim(), exitCode);
}
//// a-connection-in-use-outlives-the-keep-alive-timeout.js
// node:http leaves its keep-alive timer armed across requests; when it fires on a connection that has answered, it grants what is left of the idle time since the last answer.
// A connection in use outlives any number of timeouts, where the answer is written whole and where it is piped. An idle one is closed, and not before its time.
// A process that the machine holds for as long as the timeout closes connections in use under every engine, because timers fire before reads: such a try does not count.
import http from "node:http";
import net from "node:net";
import { Readable } from "node:stream";

const timeout = 600;
const server = http.createServer((request, response) => {
  if (request.url === "/piped") Readable.from(["a,", "b,", "c"]).pipe(response);
  else response.end("whole");
});
server.keepAliveTimeout = timeout;
server.keepAliveTimeoutBuffer = 0;

function useThenLeaveIdle(port) {
  return new Promise(resolve => {
    const began = performance.now();
    let text = "";
    let answered = 0;
    let lastAnswer = began;
    let longestWait = 0;
    let isIdle = false;
    const ask = () => client.write(`GET ${answered % 2 ? "/piped" : "/whole"} HTTP/1.1\r\nHost: localhost\r\n\r\n`);
    const client = net.connect(port, "127.0.0.1", ask);
    client.on("data", chunk => {
      text += chunk;
      if (!text.endsWith(answered % 2 ? "0\r\n\r\n" : "whole")) return;
      const now = performance.now();
      longestWait = Math.max(longestWait, now - lastAnswer);
      lastAnswer = now;
      text = "";
      answered++;
      if (now - began < timeout * 2.5) ask();
      else isIdle = true;
    });
    client.on("error", () => {});
    client.on("close", () => resolve({ isIdle, idleFor: performance.now() - lastAnswer, longestWait }));
  });
}

server.listen(0, "127.0.0.1", async () => {
  let result;
  for (let tries = 0; tries < 5; tries++) {
    result = await useThenLeaveIdle(server.address().port);
    if (result.longestWait < timeout / 2) break;
  }
  console.log(result.isIdle ? "in use for over two timeouts: still open" : "closed while in use");
  console.log(result.idleFor >= timeout * 0.9 ? "idle: closed, and not before its time" : "closed before its time");
  server.close();
});
//// a-connection-that-node-http-hands-over-is-closed.js
// A server of node:http hands a connection over to the listener for 'upgrade'. The library holds a promise for the connection, which it settles by itself when the socket closes:
// then the server can close. What is printed does not depend on which side notices the end first.
import http from "node:http";
import net from "node:net";

const seen = { upgrade: "", echoed: "", status: "", closedSides: 0 };
function sideClosed() {
  if (++seen.closedSides < 2) return;
  server.close(() => {
    console.log(seen.upgrade);
    console.log(seen.status);
    console.log(seen.echoed);
    console.log("closed");
  });
}

const server = http.createServer((request, response) => response.end("not handed over"));
server.on("upgrade", (request, socket, head) => {
  seen.upgrade = `${request.method} ${request.url} ${request.headers.upgrade} ${head.length}`;
  socket.write("HTTP/1.1 101 Switching Protocols\r\nUpgrade: echo\r\nConnection: Upgrade\r\n\r\n");
  socket.on("data", chunk => socket.write(String(chunk).toUpperCase()));
  socket.on("end", () => socket.end());
  socket.on("close", sideClosed);
});
server.listen(0, "127.0.0.1", () => {
  let text = "";
  let hasAsked = false;
  const client = net.connect(server.address().port, "127.0.0.1", () => {
    client.write("GET /chat HTTP/1.1\r\nHost: localhost\r\nConnection: Upgrade\r\nUpgrade: echo\r\n\r\n");
  });
  client.on("data", chunk => {
    text += chunk;
    const end = text.indexOf("\r\n\r\n");
    if (end < 0) return;
    if (!hasAsked) {
      hasAsked = true;
      seen.status = text.slice(0, text.indexOf("\r\n"));
      client.write("hello");
    }
    seen.echoed = text.slice(end + 4);
    if (seen.echoed === "HELLO") client.end();
  });
  client.on("close", sideClosed);
});
