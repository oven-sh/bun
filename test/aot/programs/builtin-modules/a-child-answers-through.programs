restore();

restore = replaceAll(forty, "forty");
callSome();
console.warn(11);
console.assert(false, 12);
(con.added39 as (value: number) => void)(13);
restore();
lines.push("added39 is " + typeof con.added39);

restore = replaceAll(Object.keys(console), "keys");
