  const second = new Event("b", first);
  const third = new Event("c", {
    get bubbles() {
      holder.value++;
      return {
        valueOf() {
          holder.value += 10;
          return 0;
        },
      };
    },
    get composed() {
      holder.value++;
      return 0;
    },
  });
