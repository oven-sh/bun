  const got: string[] = [];
  for await (const chunk of readable) got.push(chunk);
  lines.push("iterated " + got.join("|"));
  await turn();
})();
unwatch("a Readable that is iterated", true);

const server = createServer((req, res) => {
  if (req.method === "GET") return void res.end("got " + req.url);
  let body = "";
  req.on("data", chunk => (body += chunk));
  req.on("end", () => {
    res.writeHead(201, { "content-type": "text/plain" });
    res.write("posted ");
    res.end(body);
  });
});
await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
const address = server.address() as { port: number };
const url = "http://127.0.0.1:" + address.port;
lines.push(await (await fetch(url + "/warm")).text());
await turn();

watch();
lines.push(await (await fetch(url + "/one")).text());
await turn();
await turn();
unwatch("a GET without a body", false);

watch();
lines.push(await (await fetch(url + "/two", { method: "POST", body: "the body" })).text());
await turn();
await turn();
unwatch("a POST with a body", false);

lines.push(await (await fetch(url + "/three")).text());
await turn();
lines.push("seen behind the last watch: " + seen.length);

lines.push("-- a replacement that holds the ticks back");
const held: (() => void)[] = [];
process.nextTick = ((callback: (...all: unknown[]) => void, ...all: unknown[]) => void held.push(() => callback(...all))) as typeof process.nextTick;
const late = new Readable({ read() {} });
const events: string[] = [];
late.on("data", chunk => events.push("data " + chunk));
late.on("end", () => events.push("end"));
late.push("held");
late.push(null);
await turn();
lines.push("before: " + events.join() + " | held " + held.length);
process.nextTick = original;
while (held.length) held.shift()!();
await turn();
lines.push("after: " + events.join());

lines.push("-- an accessor");
let reads = 0;
Object.defineProperty(process, "nextTick", {
  configurable: true,
  get() {
    reads++;
    return original;
  },
});
await new Promise<void>(resolve => {
  const readable = new Readable({ read() {} });
  readable.on("data", () => {});
  readable.on("close", resolve);
  readable.push("a");
  readable.push(null);
});
Object.defineProperty(process, "nextTick", { configurable: true, writable: true, enumerable: true, value: original });
lines.push("read " + reads + " times");

lines.push("-- what is no function");
process.nextTick = 5 as unknown as typeof process.nextTick;
try {
  const readable = new Readable({ read() {} });
  readable.on("data", () => {});
  readable.push("a");
  lines.push("nothing thrown");
} catch (error) {
  lines.push((error as Error).constructor.name);
}
process.nextTick = original;

await new Promise<void>(resolve => server.close(() => resolve()));
console.log(lines.join("\n"));
//// req-headers-with-whatever-stands-in-front-of-raw-headers.js
// req.headers is built natively where a read of req.rawHeaders would reach IncomingMessage.prototype's own accessor. Whatever stands in front of that accessor (an own property, a class below, a prototype put in between, a proxy) is read instead, and the traps of a proxy run in the order of a lookup.
const http = require("node:http");
const lines = [];
const show = (label, value) => lines.push(label + ": " + JSON.stringify(value));
const pick = headers => ({ "x-one": headers["x-one"], "x-two": headers["x-two"], cookie: headers.cookie, "set-cookie": headers["set-cookie"] });
class Below extends http.IncomingMessage {
  get rawHeaders() { return ["X-One", "from the class below", "X-Two", "b"]; }
  set rawHeaders(value) {}
}
const cases = {
  plain(req) { show("plain", pick(req.headers)); show("plain raw", req.rawHeaders.filter((_, i) => i % 2 === 0).map(name => name.toLowerCase()).filter(name => name.startsWith("x-"))); },
  rawFirst(req) { const raw = req.rawHeaders; show("raw first", [raw.length > 0, pick(req.headers)]); },
  assigned(req) { req.rawHeaders = ["X-One", "assigned", "X-Two", "2"]; show("assigned", pick(req.headers)); },
  own(req) { Object.defineProperty(req, "rawHeaders", { value: ["X-One", "own", "X-One", "again"], configurable: true }); show("own", pick(req.headers)); },
  ownGetter(req) { Object.defineProperty(req, "rawHeaders", { get() { return ["X-Two", "own getter"]; }, configurable: true }); show("own getter", pick(req.headers)); },
  sameGetter(req) { Object.defineProperty(req, "rawHeaders", Object.getOwnPropertyDescriptor(http.IncomingMessage.prototype, "rawHeaders")); show("same getter", pick(req.headers)); },
  between(req) { Object.setPrototypeOf(req, Object.create(Object.create(http.IncomingMessage.prototype))); show("between", pick(req.headers)); },
  betweenWithName(req) { const middle = Object.create(http.IncomingMessage.prototype, { rawHeaders: { value: ["X-One", "in between"] } }); Object.setPrototypeOf(req, Object.create(middle)); show("between with the name", pick(req.headers)); },
  otherFold(req) { req._addHeaderLine = function (field, value, dest) { dest[field.toLowerCase()] = "folded " + value; }; show("other fold", pick(req.headers)); },
  twice(req) { show("twice", [req.headers === req.headers, pick(req.headers)]); },
  stored(req) { req.headers = { "x-one": "stored" }; show("stored", pick(req.headers)); },
  proxy(req) {
    const seen = [];
    const note = (trap, key) => { if (typeof key !== "symbol") seen.push(key === undefined ? trap : trap + " " + key); };
    const proxy = new Proxy(req, {
      get(target, key, receiver) { note("get", key); return Reflect.get(target, key, typeof key === "symbol" ? target : receiver); },
      set(target, key, value) { note("set", key); target[key] = value; return true; },
      has(target, key) { note("has", key); return key in target; },
      getOwnPropertyDescriptor(target, key) { note("getOwnPropertyDescriptor", key); return Reflect.getOwnPropertyDescriptor(target, key); },
      getPrototypeOf(target) { note("getPrototypeOf"); return Reflect.getPrototypeOf(target); },
    });
    show("proxy", pick(proxy.headers)); show("proxy traps", seen);
  },
  onPrototype() { let answer; try { answer = pick(http.IncomingMessage.prototype.headers); } catch (error) { answer = error.name; } show("on the prototype", answer); },
  withoutParent(req) { const get = Object.getOwnPropertyDescriptor(http.IncomingMessage.prototype, "headers").get; let answer; try { answer = Object.keys(get.call(Object.create(null))); } catch (error) { answer = error.name; } show("without a parent", answer); },
};
const names = Object.keys(cases);
function serve(options, list, done) {
  const server = http.createServer(options, (req, res) => { cases[req.url.slice(1)](req); res.end("ok"); });
  server.listen(0, "127.0.0.1", async () => {
    for (const name of list) for (let round = 0; round < 3; round++) {
      const before = lines.length;
      await new Promise(resolve => http.get({ port: server.address().port, host: "127.0.0.1", path: "/" + name, agent: false, headers: { "X-One": "1", "X-Two": ["a", "b"], Cookie: ["c=1", "d=2"] } }, res => { res.resume(); res.on("end", resolve); }));
      if (round) lines.length = before;
    }
    server.close(done);
  });
}
serve({}, names, () => { lines.push("-- a class below"); serve({ IncomingMessage: Below }, ["plain", "twice", "own", "between"], () => console.log(lines.join("\n"))); });
//// require-resolve-answers-the-name-of-a-built-in-module-as-it-was-asked.cjs
// require.resolve of a built-in module answers the name as it was asked: "fs" for "fs". Programs take `require.resolve(name) === name` for "this is a built-in module".
console.log("written:", require.resolve("fs"), require.resolve("node:fs"), require.resolve("path"), require.resolve("events"), require.resolve("bun:sqlite"), require.resolve("stream/promises"));
for (const name of ["fs", "node:fs", "path", "node:path", "events", "bun:sqlite", "stream/promises", "node:stream/promises"]) console.log(name, require.resolve(name), require.resolve(name) === name);
//// response-events-heard-and-unheard.ts
import { EventEmitter } from "node:events";
import { createServer, ServerResponse } from "node:http";
import type { IncomingMessage } from "node:http";
import { Stream } from "node:stream";

const lines: string[] = [];
const turn = () => new Promise<void>(resolve => setImmediate(resolve));
type Handler = (req: IncomingMessage, res: ServerResponse) => void;
let handler: Handler = (_req, res) => void res.end("plain");

const server = createServer((req, res) => handler(req, res));
await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
const url = "http://127.0.0.1:" + (server.address() as { port: number }).port;

async function ask(title: string, how: Handler) {
  lines.push("-- " + title);
  handler = how;
  for (let i = 0; i < 3; i++) {
    const answer = await (await fetch(url + "/" + i)).text();
    for (let turns = 0; turns < 4; turns++) await turn();
    lines.push("answer: " + answer);
  }
}

const names = ["socket", "prefinish", "finish", "close"];

for (let i = 0; i < 200; i++) await (await fetch(url + "/warm")).text();
await turn();

await ask("nobody listens", (_req, res) => void res.end("quiet"));

await ask("a listener for every event", (_req, res) => {
  for (const name of names) res.on(name, () => lines.push("heard " + name));
  res.end("heard");
});

await ask("two listeners for close, one once", (_req, res) => {
  res.on("close", () => lines.push("close 1, closed " + res.closed + ", destroyed " + res.destroyed));
  res.once("close", () => lines.push("close 2, listeners " + res.listenerCount("close")));
  res.end("twice");
});

await ask("a listener added by a listener", (_req, res) => {
  res.on("prefinish", () => {
    lines.push("prefinish");
    res.on("finish", () => {
      lines.push("finish");
      res.on("close", () => lines.push("close"));
    });
  });
  res.end("chain");
});

await ask("emit replaced on the response", (_req, res) => {
  const original = res.emit;
  res.emit = function (this: ServerResponse, name: string | symbol, ...rest: unknown[]) {
    lines.push("own emit " + String(name) + " " + rest.length);
    return original.call(this, name, ...rest);
  } as typeof res.emit;
  res.end("own");
});

{
  const original = ServerResponse.prototype.emit;
  ServerResponse.prototype.emit = function (this: ServerResponse, name: string | symbol, ...rest: unknown[]) {
    lines.push("class emit " + String(name) + " " + rest.length);
    return original.call(this, name, ...rest);
  } as typeof original;
  await ask("emit replaced on ServerResponse.prototype", (_req, res) => void res.end("class"));
  ServerResponse.prototype.emit = original;
}

{
  const seen: string[] = [];
  const original = EventEmitter.prototype.emit;
  EventEmitter.prototype.emit = function (this: EventEmitter, name: string | symbol, ...rest: unknown[]) {
    if (this instanceof ServerResponse) seen.push(String(name));
    return original.call(this, name, ...rest);
  } as typeof original;
  await ask("emit replaced on EventEmitter.prototype", (_req, res) => void res.end("base"));
  EventEmitter.prototype.emit = original;
  lines.push("seen: " + seen.join());
}

{
  const seen: string[] = [];
  const prototype = Stream.prototype as unknown as { emit?: typeof EventEmitter.prototype.emit };
  prototype.emit = function (this: EventEmitter, name: string | symbol, ...rest: unknown[]) {
    if (this instanceof ServerResponse) seen.push(String(name));
    return EventEmitter.prototype.emit.call(this, name, ...rest);
  };
  await ask("emit defined on Stream.prototype", (_req, res) => void res.end("stream"));
  delete prototype.emit;
  lines.push("seen: " + seen.join());
}

await ask("nobody listens again", (_req, res) => void res.end("quiet"));

await ask("the events object replaced", (_req, res) => {
  const events = Object.create(null);
  events.close = () => lines.push("close from another events object");
  (res as unknown as { _events: unknown })._events = events;
  res.end("replaced");
});

await ask("written in pieces, ended late", (_req, res) => {
  res.on("close", () => lines.push("close, finished " + res.writableFinished));
  res.write("a");
  setImmediate(() => {
    res.write("b");
    res.end("c");
  });
});

await ask("destroyed before it ends", (_req, res) => {
  res.on("close", () => lines.push("close, finished " + res.writableFinished + ", destroyed " + res.destroyed));
  res.on("finish", () => lines.push("finish"));
  res.write("part");
  setImmediate(() => res.destroy());
}).catch(error => lines.push("the client: " + (error as Error).name));
await turn();
await turn();

server.close();
await turn();
console.log(lines.join("\n"));
