process.nextTick(counted, "hooked", undefined);
process.nextTick(seen, 1, 2, 3, 4, 5, 6);
hook.disable();
process.nextTick(seen, "unhooked", 2);
await turn();
lines.push(...resources);
console.log(lines.join("\n"));
