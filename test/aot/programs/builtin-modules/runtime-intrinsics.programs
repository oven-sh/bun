process.nextTick(first);
last().args = [1, 2, 3, 4, 5, 6];
process.nextTick(first, 1);
last().args = undefined;
process.nextTick(first, 1, 2, 3, 4, 5);
last().args.length = 2;
process.nextTick(first, 1);
last().args = [];
