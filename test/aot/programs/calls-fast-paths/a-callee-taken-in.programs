block("untyped, it throws", () => m.sweep(locks, odd));
block("typed, nothing throws", () => sweepTyped(locks, () => {}));
block("typed, it throws", () => sweepTyped(locks, odd));
block("first", () => m.firstThatWorks((t: string) => "got " + t, ["bad", "bad", "web", "x"]));
