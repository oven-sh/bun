const loud = (k: string): void => { churn(k.length, 3); };
const atB = (k: string): void => { if (k === "b" || k === "ab") churn(k.length, 3); };
const fresh = (): Record<string, number> => ({ a: 1, b: 2, c: 3, d: 4 });

////= sweep	Typed(locks: Record<string, { options: number }>, remove: (f: string, o: number) => void): string	(e as Error)
////= lines	deletesTyped(o: Record<string, number>, act: (k: string) => void): string	act(k); } catch (e) { delete o.c;
