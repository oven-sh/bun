//// indirect-call-callee-with-properties.ts
// An indirect call of a function that was given a property is as fast as any other.
declare const console: any;
type L = (...args: any[]) => void;
let n = 0;
const table: L[] = [(v: number) => { n += v; }, (v: number) => { n -= v; }];
(table[0] as any).tag = "a"; (table[1] as any).tag = "b";
for (let i = 0; i < 5_000_000; i++) { table[i & 1](1); }
console.log(n);
export {};
//// indirect-call-rest-callee.ts
// An indirect call of a function with a rest parameter.
declare const console: any;
type L = (...args: any[]) => void;
let n = 0;
const keep: any[] = [];
const table: L[] = [(...v: number[]) => { keep[0] = v; n += v.length; }, (...v: number[]) => { keep[0] = v; n -= v.length; }];
for (let i = 0; i < 5_000_000; i++) { table[i & 1](1); }
console.log(n, keep[0].length);
export {};
//// inlining-exposes-direct-call.ts
// A call that became direct through inlining can itself be inlined without counting towards the depth limit.
declare const console: any;
let seen = 0;
function inner(a: number, b: number): number { seen += a; return a * 3 + b * 5 + (a > b ? 1 : 2); }
function button(p: number): number { seen += 1; return inner(p, p + 1) + inner(p + 2, p) + 7; }
function other(p: number): number { seen += 2; return inner(p, 1) - 11; }
function render(e: { type: (p: number) => number, props: number }): number { seen += 3; return e.type(e.props) + e.props * 2; }
export function viaLiteral(n: number): number { let sum = 0; for (let i = 0; i < n; i++) sum += render({ type: button, props: i }); return sum; }
export function viaLiteralOfTwo(n: number): number { let sum = 0; for (let i = 0; i < n; i++) sum += render({ type: i & 1 ? button : other, props: i }); return sum; }
function fourth(a: number, b: number): number { seen += a; return a * 3 + b * 5 + (a > b ? 1 : 2); }
function third(p: number): number { seen += 1; return fourth(p, p + 1) + fourth(p + 2, p) + 7; }
function second(p: number): number { seen += 3; return third(p) + p * 2; }
function first(p: number): number { seen += 4; return second(p) + p * 9 + (p > 3 ? 1 : 0); }
export function byName(n: number): number { let sum = 0; for (let i = 0; i < n; i++) sum += first(i); return sum; }
function thrower(p: number): number { if (p === 3) throw new RangeError("three"); return inner(p, 2); }
export function throughACopy(n: number): string { let sum = 0; try { for (let i = 0; i < n; i++) sum += render({ type: thrower, props: i }); } catch (error) { const e = error as Error; return sum + " " + e.message + " " + ["thrower", "render", "throughACopy"].map(name => new RegExp("\\b" + name + "\\b").test(e.stack ?? "")).join(); } return String(sum); }
function again(p: number): number { return p > 0 ? render({ type: again, props: p - 1 }) + 1 : inner(p, p); }
console.log(viaLiteral(10), viaLiteralOfTwo(10), byName(10), throughACopy(10), again(5), seen);
//// integer-conversions-across-a-catch-block.ts
// `x | 0` on sums, differences and quotients, and `Math.floor(x / y)` and the like, where a `catch` block lies between computing the value and using it.
declare const console: any;
const said: string[] = [];
function block(name: string, body: () => unknown) { calls = 0; try { said.push(name + ": " + body()); } catch (error) { said.push(name + ": THROWS " + String(error)); } }
let calls = 0, every = 3;
////= churn	"thrown"
function mayThrow(): void { if (every && ++calls % every === 0) churn(calls & 63, 3); }
function sum(n: number): number { let t = 1; for (let i = 0; i < n; i++) { t += i * 3; try { mayThrow(); } catch {} t ^= i + 1; } return t; }
function difference(n: number): number { let t = 100000; for (let i = 0; i < n; i++) { t -= i * 7; try { mayThrow(); } catch {} t |= i; } return t; }
function sumOfFractions(n: number): number { let t = 0.5; for (let i = 0; i < n; i++) { t += i * 3; try { mayThrow(); } catch {} t ^= i + 1; t += 0.25; } return t; }
function quotient(n: number, d: number): number { let s = 0; for (let i = 1; i <= n; i++) { const q = (i * 10) / d; try { mayThrow(); } catch {} s += q | 0; } return s; }
function floored(n: number, d: number): number { let s = 0; for (let i = 1; i <= n; i++) { const q = (i * 10 - 35) / d; try { mayThrow(); } catch {} s += Math.floor(q); } return s; }
function ceiled(n: number, d: number): number { let s = 0; for (let i = 1; i <= n; i++) { const q = (i * 10 - 35) / d; try { mayThrow(); } catch {} s += Math.ceil(q); } return s; }
function rounded(n: number, d: number): number { let s = 0; for (let i = 1; i <= n; i++) { const q = (i * 10 - 35) / d; try { mayThrow(); } catch {} s += Math.round(q); } return s; }
function truncated(n: number, d: number): number { let s = 0; for (let i = 1; i <= n; i++) { const q = (i * 10 - 35) / d; try { mayThrow(); } catch {} s += Math.trunc(q); } return s; }
function truncatedToInt32(n: number, x: number): number { let s = 0; for (let i = 1; i <= n; i++) { const q = Math.trunc(x * i + 0.5); try { mayThrow(); } catch {} s ^= q; } return s; }
function truthOfACast(n: number): number { let c = 0; for (let i = 0; i < n; i++) { const a = i % 3; const v = a && i * 2; try { mayThrow(); } catch {} if (v) c++; } return c; }
function once(x: number, y: number): number { const s = x + y * 3; try { mayThrow(); } catch {} return s ^ 5; }
function onceInTheHandler(x: number, y: number): number { const s = x + y * 3; try { mayThrow(); return -1; } catch { return s ^ 5; } }
function onceOfAQuotient(x: number, y: number): number { const q = (x * 10) / y; try { mayThrow(); } catch {} return (q | 0) + Math.floor(q) * 100; }
for (const [how, k] of [["never", 0], ["every third", 3], ["every second", 2], ["always", 1]] as [string, number][]) {
  every = k;
  block("a sum, " + how, () => [sum(5), sum(50), sum(500)].join());
  block("a difference, " + how, () => [difference(5), difference(50)].join());
  block("a sum of fractions, " + how, () => [sumOfFractions(5), sumOfFractions(50)].join());
