    if (t == null) x += 100; if (u === undefined) x += 200;
    x += (t as Wide).extra + (u as Wide).extra;
    holder.kept = t; holder.kept = u;
    x += t!.flags + u!.flags;
    return x + (t?.kind ?? 0) + (u?.kind ?? 0);
}
