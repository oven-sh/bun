    return seen;
}
//// a-callee-taken-in-makes-an-object-of-the-shape-that-the-caller-has-tested.ts
// A function reads a property of its parameter, calls what another property holds, and reads the first property again. The callee makes an object of the same shape and hands it to that function.
let calls = 0;
function leaf(a: number, b: number): number {
  calls += a;
  return a * 3 + b * 5 + (a > b ? 1 : 2);
}
function show(item: { step: (count: number) => number; count: number }): number {
  calls += 3;
  return item.step(item.count) + item.count * 2;
}
function descend(count: number): number {
  return count > 0 ? show({ step: descend, count: count - 1 }) + 1 : leaf(count, count);
}
const addOne = new Function("a", "return a + 1;") as (a: number) => number;
if (process.env.A_FILE_NAMED_AT_RUN_TIME) await import(process.env.A_FILE_NAMED_AT_RUN_TIME);
console.log(descend(5), calls, addOne(1));
//// a-method-is-read-before-its-arguments-are-computed.ts
// The method of a class is read before its arguments are computed: `slot.of(root().host)`, `shelf.get(codes[i])`. What the arguments do comes too late to change which function is called.
declare const process: { argv: string[] };
declare const console: { log(...values: any[]): void };
class Host { name = "host"; }
class Session { host = new Host(); turns = 0; }
class Slot { values = new Map<Host, number>(); of(host: Host): number { let value = this.values.get(host); if (value === undefined) this.values.set(host, value = this.values.size + 1); return value; } }
class Shelf { texts: string[] = []; get(index: number): string { return this.texts[index] ?? " "; } }
type Ledger = { codes: Int32Array; shelf: Shelf };
const session = new Session(), slot = new Slot(), shelf = new Shelf();
let hook: (() => void) | undefined;
function root(): Session { session.turns++; if (hook) hook(); return session; }
export function ofRoot(): number { return slot.of(root().host); }
export function entryAt(ledger: Ledger, i: number): string { return ledger.shelf.get(ledger.codes[i]!); }
for (let i = 0; i < 64; i++) shelf.texts.push(String.fromCharCode(65 + (i % 26)));
const ledger: Ledger = { codes: new Int32Array(256).map((_, i) => i % 64), shelf };
(globalThis as any).kept = [Slot, Shelf, Session, Host, ofRoot, entryAt];
const rounds = Number(process.argv[2] ?? 300000);
let sum = 0;
for (let i = 0; i < rounds; i++) sum += ofRoot() + entryAt(ledger, i & 255).length;
console.log(sum === rounds * 2);
//// a-written-type-argument-keeps-the-method-table.ts
// A type argument that the program writes at a call of a generic method says nothing about how the method is called: both calls go through the method table
// STATISTIC: TableCalls >= 2
interface Row { id: number }
interface Store { find<T>(id: number): T }
class Store1 implements Store { row: Row = { id: 1 }; find<T>(id: number): T { this.row.id = id + 1; return this.row as unknown as T; } }
class Store2 implements Store { row: Row = { id: 2 }; find<T>(id: number): T { this.row.id = id + 2; return this.row as unknown as T; } }
class Store3 implements Store { row: Row = { id: 3 }; find<T>(id: number): T { this.row.id = id + 3; return this.row as unknown as T; } }
class Store4 implements Store { row: Row = { id: 4 }; find<T>(id: number): T { this.row.id = id + 4; return this.row as unknown as T; } }
class Store5 implements Store { row: Row = { id: 5 }; find<T>(id: number): T { this.row.id = id + 5; return this.row as unknown as T; } }
class Store6 implements Store { row: Row = { id: 6 }; find<T>(id: number): T { this.row.id = id + 6; return this.row as unknown as T; } }
function findWritten(store: Store, id: number): number { return store.find<Row>(id).id; }
function findCast(store: Store, id: number): number { return (store.find(id) as Row).id; }

const stores: Store[] = [new Store1(), new Store2(), new Store3(), new Store4(), new Store5(), new Store6()];
let total = 0;
for (let i = 0; i < 6000; i++) total += findWritten(stores[i % 6], i & 3) * 2 + findCast(stores[i % 6], i & 3);

// A stranger reaches both functions, so that no parameter is known from its callers alone.
const stranger: any = JSON.parse(process.argv[2] ?? "null");
if (stranger !== null) for (const f of [findWritten, findCast] as any[]) total += f(stranger, stranger);
console.log(total);
