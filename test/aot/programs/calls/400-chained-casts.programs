"use strict";
function visit(tree, found, each) {
  if (Array.isArray(tree)) {
    let count = 0;
    for (let index = 0; index < tree.length; index++) count += visit(tree[index], found, each);
    return count;
  }
  const answer = each(tree);
  if (answer != null) found.push(answer);
  return 1;
}
function mapLeaves(tree, callback, receiver) {
  const found = [];
  let count = 0;
  // `callback` is a parameter that the inner function captures, and it is called through `call`.
  visit(tree, found, function (leaf) {
    return callback.call(receiver, leaf, count++);
  });
  return found;
}
exports.leaves = {
  map: mapLeaves,
  count(tree) {
    let seen = 0;
    mapLeaves(tree, function () {
      seen++;
    });
    return seen;
  },
  toList(tree) {
    return mapLeaves(tree, function (leaf) {
      return leaf;
    });
  },
};
//// a-callback-kept-in-a-field-comes-from-anywhere.ts
// The field of a class has a function type. What is stored there comes from typed code, from a parameter whose caller no type describes, and from text that is evaluated.
// Every one of them satisfies the type, is kept, is the same function when it is read again, and is called with the receiver that a call of a member has.
type Listener = (this: unknown, value: number) => number;
class Holder {
  listener: Listener;
  calls = 0;
  constructor(listener: Listener) { this.listener = listener; }
  fire(value: number): number { this.calls++; return this.listener(value); }
}
const launder = new Function("value", "return value") as <V>(value: V) => V;
const listeners: Listener[] = [
  value => value + 1,
  value => value * 2,
  function (this: unknown, value: number) { return this instanceof Holder ? value - 1 : -1; },
  launder(new Function("value", "return value * value") as Listener),
  launder(Math.abs as Listener),
  launder(((a: number) => a + 100).bind(null) as Listener),
];
let total = 0;
for (let round = 0; round < 50; round++) {
  for (const listener of listeners) {
    const holder = new Holder(listener);
    total = (total + holder.fire(round - 25)) % 1000003;
    if (holder.listener !== listener) console.log("another function");
    holder.listener = listeners[(round + 1) % listeners.length];
    total = (total + holder.fire(round)) % 1000003;
  }
}
console.log(total);
const holder = new Holder(listeners[0]);
for (const listener of listeners) {
  holder.listener = listener;
  console.log(holder.fire(-3), holder.listener === listener, Object.keys(holder).join());
}
//// a-caller-that-answers-some-of-the-tests-at-an-entrance.ts
// A function with typed parameters is entered through tests. A caller that has proven some of its operands enters behind the tests that it has answered,
// and whatever arrives for the others, through `any`, still gets the answer of the language: the tests that are left send it to the generic version.
// Built without inlining, so that the calls stay calls, with all code counted as hot, so that a shorter entrance pays, and with the compiler's own checks behind every pass.
class Box {
  constructor(public name: string, public size: number) {}
}
class Crate extends Box {
  constructor(name: string, size: number, public lid: boolean) {
    super(name, size);
  }
}

function combine(count: number, label: string, box: Box): string {
  return label + ":" + count * 2 + ":" + box.name + box.size;
}

function withProvenCountAndBox(count: number, label: any, box: Box): string {
  return combine(count, label, box);
}

function withProvenLabel(count: any, label: string, box: any): string {
  return combine(count, label, box);
}

function withNothingProven(count: any, label: any, box: any): string {
  return combine(count, label, box);
}

function withFewerArguments(count: number): string {
  try {
    return (combine as any)(count);
  } catch (error) {
    return (error as Error).constructor.name;
  }
}

function optional(first: number, second?: number, third: string = "d"): string {
  return first + "/" + second + "/" + third;
}

function callsOptional(first: number, second: any, third: any): string {
  return optional(first) + optional(first, second) + optional(first, second, third);
}

function descend(depth: number, trail: string, step: any): string {
  return depth <= 0 ? trail : descend(depth - 1, trail + step, step);
}

function makeCounter(start: number, unit: string) {
  function format(value: number, suffix: string): string {
    return unit + (start + value) + suffix;
  }
  function viaAny(value: number, suffix: any): string {
    return format(value, suffix);
  }
  return viaAny;
}

const labels: any[] = ["a", "b", 7, null, undefined, { toString: () => "object" }, ["x", "y"], true, 1.5, "c"];
const counts: any[] = [1, 2.5, "3", null, undefined, true, { valueOf: () => 9 }, -0, NaN, 4];
const boxes: any[] = [new Box("box", 1), new Crate("crate", 2, true), { name: "literal", size: 3 }, { name: 4, size: "five" }, new Box("again", 6)];

const seen = new Map<string, number>();
function note(text: string) {
  seen.set(text, (seen.get(text) ?? 0) + 1);
}

const counter = makeCounter(10, "#");
for (let turn = 0; turn < 3000; turn++) {
  const label = labels[turn % labels.length];
  const count = counts[turn % counts.length];
  const box = boxes[turn % boxes.length];
  note(withProvenCountAndBox(turn % 5, label, turn & 1 ? new Box("n", turn % 3) : new Crate("m", turn % 3, false)));
  note(withProvenLabel(count, "L" + (turn % 2), box));
  note(withNothingProven(count, label, box));
  note(withFewerArguments(turn % 2));
  note(callsOptional(turn % 3, count, label));
  note(descend(turn % 4, "t", label));
  note(counter(turn % 3, label));
}

for (const [text, times] of [...seen].sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))) console.log(times, text);
//// a-function-entered-through-call-makes-what-it-declares-anew-at-each-entry.js
// A function is entered through call, apply and Reflect.apply: once where it stands, twice, in a loop, and beside a plain call.
const made = [];
(function () {
  function Once() {}
  Once.prototype.tag = "once";
  made.push(new Once().tag, this === globalThis);
}).call(globalThis);
console.log(made.join());

const twice = function (tag) {
  function Inner() {}
  Inner.prototype.tag = tag;
  made.push(Inner);
  return new Inner();
};
const a = twice.call(null, "a");
const b = twice.call(null, "b");
console.log(a.tag, b.tag, a instanceof made[2], b instanceof made[2], made[2] === made[3]);

for (let i = 0; i < 3; i++) {
  (function (n) {
    function Turn() {}
    Turn.prototype.n = n;
    made.push(new Turn());
  }).call(null, i);
}
console.log(made.slice(4).map(turn => turn.n).join(), Object.getPrototypeOf(made[4]) === Object.getPrototypeOf(made[5]));

const both = function (tag) {
  let count = 0;
  return function () {
    return tag + ++count;
  };
};
const first = both.call(null, "x");
const second = both("y");
console.log(first(), first(), second(), first());

const applied = function () {
  function Kept() {}
  return Kept;
};
console.log(Reflect.apply(applied, null, []) === applied.apply(null, []));

function outer(tag) {
  return (function () {
    function Made() {}
    Made.prototype.tag = tag;
    return new Made();
  }).call(this);
}
console.log(outer("p").tag, outer("q").tag, Object.getPrototypeOf(outer("r")) === Object.getPrototypeOf(outer("s")));
