//// a-generator-method-is-looped-over-and-what-is-no-function-is-called.ts
// A loop over the generator that a method returns, and calls of values that are no functions: each throws a TypeError where it stands, behind its arguments, and a handler around it catches it.
declare const console: any;
class Span {
  constructor(public from: number, public to: number) {}
  *items() { for (let k = this.from; k < this.to; k++) yield k; }
  *pairs() { for (let k = this.from; k < this.to; k++) yield [k, k * k] as const; }
}
function sum(span: Span): number { let total = 0; for (const value of span.items()) total += value; return total; }
function sumOfSquares(span: Span): number { let total = 0; for (const [, square] of span.pairs()) total += square; return total; }
function firstOver(span: Span, limit: number): number { for (const value of span.items()) if (value > limit) return value; return -1; }
let total = 0;
for (let i = 0; i < 2000; i++) total += sum(new Span(i & 3, 8)) + sumOfSquares(new Span(0, i & 7)) + firstOver(new Span(0, 10), i & 15);
console.log(total);

const log: string[] = [];
function note(text: string): number { log.push(text); return log.length; }
function attempt(name: string, f: () => unknown) { try { console.log(name + ": " + f()); } catch (e: any) { console.log(name + ": " + e.constructor.name + ", " + log.join(" ")); } log.length = 0; }
const holder: any = { nothing: undefined, none: null, number: 1, text: "t", flag: true, symbol: Symbol("s"), big: 1n };
attempt("undefined", () => holder.nothing(note("a"), note("b")));
attempt("null", () => holder.none(note("a")));
attempt("a number", () => holder.number(note("a")));
attempt("a text", () => holder.text(note("a")));
attempt("a boolean", () => holder.flag(note("a")));
attempt("a symbol", () => holder.symbol(note("a")));
attempt("a bigint", () => holder.big(note("a")));
attempt("a constant", () => (undefined as any)(note("a")));
attempt("in tail position", () => { function f(): unknown { return (undefined as any)(note("t")); } return f(); });
attempt("behind a test", () => { const f: any = log.length > 5 ? () => 1 : undefined; return f(note("x")) + 1; });
attempt("caught inside", () => { try { (null as any)(note("in")); return "not reached"; } catch { return "caught " + log.join(" "); } finally { note("finally"); } });
attempt("a method taken away", () => { const span: any = new Span(0, 3); span.items = undefined; let n = 0; for (const v of span.items()) n += v; return n; });
attempt("a method deleted from the prototype", () => { delete (Span.prototype as any).pairs; return sumOfSquares(new Span(0, 3)); });
attempt("the other method still runs", () => sum(new Span(0, 4)));
//// a-list-too-long-for-the-stack-fails-inside-the-try-around-the-call.js
// The arguments of a call go onto the stack. A list of a million does not fit, so the call fails before the function is entered,
// also where the function itself can never throw. The error belongs to the try around the call.
function count() { return arguments.length; }
function countRest(...all) { return all.length; }
function first(a, b) { return a; }
function nothing() {}
class Count { constructor() { this.n = arguments.length; } }
class CountRest { constructor(...all) { this.n = all.length; } }
class Below extends Count { constructor(list) { super(...list); } }
class BelowRest extends CountRest { constructor(list) { super(...list); } }
class Passes extends Count {}
const holder = { count() { return arguments.length; }, nothing() {} };
function forward() { return count.apply(this, arguments); }
function tail(list) { "use strict"; return count(...list); }
function* steps(list) { try { yield count(...list); } catch (error) { yield "caught: " + error.message; } }

const big = new Array(1000000).fill(1);
const forms = {
  "arguments": () => { try { return count(...big); } catch (error) { return "caught: " + error.message; } },
  "rest": () => { try { return countRest(...big); } catch (error) { return "caught: " + error.message; } },
  "two parameters": () => { try { return first(...big); } catch (error) { return "caught: " + error.message; } },
  "an empty function": () => { try { return nothing(...big); } catch (error) { return "caught: " + error.message; } },
  "a method": () => { try { return holder.count(...big); } catch (error) { return "caught: " + error.message; } },
  "an empty method": () => { try { return holder.nothing(...big); } catch (error) { return "caught: " + error.message; } },
  "behind an element": () => { try { return count(0, ...big); } catch (error) { return "caught: " + error.message; } },
  "apply": () => { try { return count.apply(null, big); } catch (error) { return "caught: " + error.message; } },
  "apply, rest": () => { try { return countRest.apply(null, big); } catch (error) { return "caught: " + error.message; } },
  "Reflect.apply": () => { try { return Reflect.apply(count, null, big); } catch (error) { return "caught: " + error.message; } },
  "call": () => { try { return count.call(null, ...big); } catch (error) { return "caught: " + error.message; } },
  "bind": () => { try { return count.bind(null, ...big)(); } catch (error) { return "caught: " + error.message; } },
  "new": () => { try { return new Count(...big).n; } catch (error) { return "caught: " + error.message; } },
  "new, rest": () => { try { return new CountRest(...big).n; } catch (error) { return "caught: " + error.message; } },
  "Reflect.construct": () => { try { return Reflect.construct(Count, big).n; } catch (error) { return "caught: " + error.message; } },
  "super": () => { try { return new Below(big).n; } catch (error) { return "caught: " + error.message; } },
  "super, rest": () => { try { return new BelowRest(big).n; } catch (error) { return "caught: " + error.message; } },
  "a constructor nobody wrote": () => { try { return new Passes(...big).n; } catch (error) { return "caught: " + error.message; } },
  "a forwarder": () => { try { return forward(...big); } catch (error) { return "caught: " + error.message; } },
  "a tail call": () => { try { return tail(big); } catch (error) { return "caught: " + error.message; } },
  "a generator": () => steps(big).next().value,
  "finally": () => { let ran = false; try { try { return count(...big); } finally { ran = true; } } catch (error) { return "finally ran " + ran + ": " + error.message; } },
  "Date.now": () => { try { return typeof Date.now(...big); } catch (error) { return "caught: " + error.message; } },
  "performance.now": () => { try { return typeof performance.now(...big); } catch (error) { return "caught: " + error.message; } },
  "Array.isArray": () => { try { return Array.isArray(...big); } catch (error) { return "caught: " + error.message; } },
  "Object.is": () => { try { return Object.is(...big); } catch (error) { return "caught: " + error.message; } },
  "Math.hypot": () => { try { return Math.hypot(...big) > 0; } catch (error) { return "caught: " + error.message; } },
  "String.fromCharCode": () => { try { return String.fromCharCode(...big).length; } catch (error) { return "caught: " + error.message; } },
  "Array.of": () => { try { return Array.of(...big).length; } catch (error) { return "caught: " + error.message; } },
  "push": () => { const to = []; try { return to.push(...big); } catch (error) { return "caught: " + error.message + " " + to.length; } },
};
for (const name in forms) console.log(name + ":", forms[name]());

async function waits() { try { return count(...big); } catch (error) { return "caught: " + error.message; } }
console.log("an async function:", await waits());
console.log("a short list afterward:", count(...big.slice(0, 5)), countRest(...big.slice(0, 6)));
//// a-long-row-of-chained-calls-hands-over-closures.ts
// Each call of the row takes what the call before it answers. The function that the last closure calls is named nowhere else.
class Command {
  private names: string[] = [];
  private actions: Array<(value: number) => number> = [];

  option(name: string): this {
    this.names.push(name);
    return this;
  }

  action(run: (value: number) => number): this {
    this.actions.push(run);
    return this;
  }

  run(start: number): string {
    let value = start;
    for (const action of this.actions) value = action(value);
    return `${this.names.length} options, ${this.names.at(-1)} last: ${value}`;
  }
}

class Total {
  constructor(public sum: number) {}
  doubled(): Total {
    return new Total(this.sum * 2);
  }
}

function reachedThroughTheLastClosureAlone(value: number): number {
  return new Total(value).doubled().sum + 7;
}

const command = new Command()
  .option("o1")
  .option("o2")
  .option("o3")
  .option("o4")
  .option("o5")
  .option("o6")
  .action(value => value + 6)
  .option("o7")
  .option("o8")
  .option("o9")
  .option("o10")
  .option("o11")
  .option("o12")
  .action(value => value + 12)
  .option("o13")
  .option("o14")
  .option("o15")
  .option("o16")
  .option("o17")
  .option("o18")
  .action(value => value + 18)
  .option("o19")
  .option("o20")
  .option("o21")
  .option("o22")
  .option("o23")
  .option("o24")
  .action(value => value + 24)
  .action(value => reachedThroughTheLastClosureAlone(value));

console.log(command.run(1));
//// a-number-bound-to-a-plain-function-is-there-when-it-is-called-and-when-it-is-constructed.js
// A plain function can be constructed, so what `bind` makes of it can be too. The arguments that are bound here are numbers and booleans, which every caller passes as such.
const lines = [];
const say = (...parts) => lines.push(parts.map(part => (Object.is(part, -0) ? "-0" : String(part))).join(" "));

function multiply(a, b) {
  if (new.target) {
    this.product = a * b;
    this.target = new.target === multiply;
    return;
  }
  return a * b;
}
const triple = multiply.bind(null, 3);
let sum = 0;
for (let i = 0; i < 1000; i++) sum += triple(i & 255);
say("called", sum, triple.name, triple.length, typeof triple.prototype);
const made = new triple(5);
say("constructed", made.product, made.target, made instanceof multiply, made instanceof triple, Object.getPrototypeOf(made) === multiply.prototype);
say("by Reflect", Reflect.construct(triple, [6]).product, Reflect.construct(triple, [7], Array) instanceof Array);

const half = multiply.bind(null, 0.5);
say("a fraction", half(3), new half(4).product);
const nothing = multiply.bind(null, NaN);
say("no number", nothing(3), new nothing(4).product);
const negative = multiply.bind(null, -0);
say("minus zero", negative(3), new negative(4).product);
const large = multiply.bind(null, 2 ** 40);
say("past 32 bits", large(3), new large(4).product);
const both = multiply.bind(null, 6, 7);
say("both", both(), both(100), new both().product, both.length);
const more = multiply.bind(null, 6, 7, 8);
say("one too many", more(), new more().product, more.length);
const again = triple.bind(null, 4);
say("bound twice", again(), new again().product, again.name, again.length);

function choose(flag, a, b) {
  if (new.target) this.chosen = flag ? a : b;
  return flag ? a : b;
}
const first = choose.bind(null, true);
const second = choose.bind(null, false);
let chosen = 0;
for (let i = 0; i < 1000; i++) chosen += first(i, 1) + second(1, i);
say("a boolean", chosen, new first(1, 2).chosen, new second(1, 2).chosen);

function Point(x, y) {
  this.x = x;
  this.y = y;
}
Point.prototype.norm = function () {
  return this.x * this.x + this.y * this.y;
};
const OnTheLine = Point.bind(null, 3);
let norms = 0;
for (let i = 0; i < 1000; i++) norms += new OnTheLine(i & 7).norm();
say("a constructor function", norms, new OnTheLine(4) instanceof Point, Object.keys(new OnTheLine(4)).join());
try {
  class Below extends OnTheLine {}
  say("a class below it", new Below().x);
} catch (error) {
  say("a class below it", error.constructor.name);
}

console.log(lines.join("\n"));
//// a-parameter-that-is-only-cast-and-handed-on.ts
// A source that reuses its variables declares a parameter with a union and hands it on with a cast. All that such a body does with the value at its entrance is to check it for one type,
// and the compiler then tests for that type at the entrance. Every call here has to answer as it does without types: a cast does nothing at run time.
class Root {
  name = "root";
  size = 1;
}
class Leaf {
  name = "leaf";
  weight = 2.5;
}

function lengthOf(text: string): number {
  return text.length;
}
////= lines-27	nameOf	root	Root	root.size

function handsOn(value: string | number | boolean, twice: boolean): number {
  if (twice) return lengthOf(value as string) * 2;
  return lengthOf(value as string);
}
function handsOnObject(value: Root | Leaf | null): string {
  return nameOf(value as Root);
}
function reassigned(value: string | number): number {
  value = String(value) + "!";
  return lengthOf(value as string);
}
function reassignedOnOnePath(value: string | number, other: boolean): number {
  if (other) value = "other";
  return lengthOf(value as string);
}
function withDefault(value: string | number = "default"): number {
  return lengthOf(value as string);
}
function writesItsArguments(value: string | number): number {
  arguments[0] = "written";
  return lengthOf(value as string) + lengthOf(arguments[0] as string);
}
function changesHalfway(value: string | number, depth: number): number {
  if (depth === 0) return lengthOf(value as string);
  return changesHalfway(depth === 2 ? 42 : value, depth - 1);
}
function castOnOnePath(value: string | number, casts: boolean): number {
  if (casts) return lengthOf(value as string);
  return -1;
}
function downTheTree(root: Root | Leaf | string, depth: number): string {
  if (depth === 0) return nameOf(root as Root);
  return acrossTheTree(root as Root, depth - 1);
}
function acrossTheTree(root: Root, depth: number): string {
  return downTheTree(root, depth);
}
function captured(value: string | number): () => number {
  return () => lengthOf(value as string);
}

const out: unknown[] = [];
const show = (label: string, run: () => unknown) => {
  try {
    out.push(label + " " + String(run()));
  } catch (error) {
    out.push(label + " throws " + (error as Error).constructor.name);
  }
};
const byValue: Record<string, (...values: any[]) => unknown> = {
  handsOn, handsOnObject, reassigned, reassignedOnOnePath, withDefault, writesItsArguments, changesHalfway, castOnOnePath, downTheTree, captured,
};

show("string", () => handsOn("four", false) + handsOn("four", true));
show("number by value", () => byValue.handsOn!(7, false));
show("boolean by value", () => byValue.handsOn!(true, true));
show("undefined by value", () => byValue.handsOn!(undefined, false));
show("object with a length by value", () => byValue.handsOn!({ length: 9 }, true));
show("no argument", () => byValue.handsOn!());
show("root", () => handsOnObject(new Root()));
show("leaf by value", () => byValue.handsOnObject!(new Leaf()));
show("null", () => handsOnObject(null));
show("literal by value", () => byValue.handsOnObject!({ name: "made", size: 3 }));
show("reassigned", () => reassigned(12345) + reassigned("ab"));
show("reassigned on one path", () => [reassignedOnOnePath(5, true), reassignedOnOnePath("abc", false), byValue.reassignedOnOnePath!(5, false)].join());
show("default", () => [withDefault(), withDefault(undefined), withDefault("a"), byValue.withDefault!(7), byValue.withDefault!(null) === undefined].join());
show("default of null", () => byValue.withDefault!(null));
show("arguments", () => [writesItsArguments("ab"), byValue.writesItsArguments!(3)].join());
show("halfway", () => [changesHalfway("abc", 1), changesHalfway("abc", 3), changesHalfway("abc", 0)].join());
