console.log(lines.slice(0, 12).join("\n"));
console.log(lines.slice(-6).join("\n"));
let sum = 0;
for (const line of lines) for (let i = 0; i < line.length; i++) sum = (sum * 31 + line.charCodeAt(i)) | 0;
console.log(sum);
