////: Context
class Context {
  count = 0;
  add = (by: number): number => {
    this.count += by;
    return this.count;
  };
}
////: Context-2
////= Context
////= Named

////= sum
////: Named
class Named extends Context {
  name = "named";
}
////: attempt-2
function attempt(label: string, run: () => unknown): void {
    try {
        lines.push(label + ": " + String(run()));
    } catch (error) {
        lines.push(label + " throws " + (error as Error).constructor.name);
    }
}
////: moved
function moved(): string {
  const from = new Context();
  const into = new Named();
  from.count = 1000;
  move(from, into);
  return [sum(into), from.count, into.count, into.add === from.add].join(" ");
}
////: row-2
function row(n: string, f: () => unknown): void {
    let p: unknown; log.length = 0;
    try { p = f(); } catch (e: any) { lines.push(Promise.resolve(n + ": THREW TO THE CALLER " + e.constructor.name)); return; }
    const noted = log.splice(0).join(",");
    if (!(p instanceof Promise)) { lines.push(Promise.resolve(n + ": returned what is no promise: " + typeof p)); return; }
    lines.push(p.then(v => n + ": returned; fulfilled " + JSON.stringify(v) + (noted ? "; noted " + noted : ""), e => n + ": returned; rejected " + e.constructor.name + (noted ? "; noted " + noted : "")));
}
////: sum
function sum(context: Context): number {
  let total = 0;
  for (let i = 0; i < 100; i++) total += context.add(1);
  return total;
}
//// argument-lists-slow-paths.js
// Calls with an argument list or a spread on values nothing is known about: order of errors, array-likes, lists that change while they are read, and lists too long for the stack. One row differs from plain Bun: `apply` on what is no function throws before it reads the list, as the specification orders it. A list too long for the stack ends in a RangeError or, where the callee takes two parameters and the list need not be spread out, in the result: both count as survived.
////= errorName

function survives(run) {
  const outcome = errorName(run);
  return outcome === "RangeError" || outcome.startsWith("returned ") ? "survived" : outcome;
}

function loggingIterable(label, values) {
  return {
    [Symbol.iterator]() {
      console.log(label, "open");
      let index = 0;
      return {
        next() {
          console.log(label, "next", index);
          return index < values.length ? { value: values[index++], done: false } : { value: undefined, done: true };
        },
      };
    },
  };
}

function describeCall(...args) {
  return `${String(this)} [${args.map(String).join(", ")}] (${args.length})`;
}

