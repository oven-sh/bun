function nilTests(cb: Callback | undefined | null, depth: number): string { if (depth > 0) return nilTests(cb, depth - 1); return (cb ? cb() : -1) + " " + (cb === undefined) + (cb === null) + (cb == null) + !cb + !!cb + (cb?.() ?? "none"); }
