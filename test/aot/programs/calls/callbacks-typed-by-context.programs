//// callee-only-in-small-function-loop.ts
function check(value: number): number {
    if (value < 0) {
        let scaled = value;
        for (let i = 1; i <= 3; i++) scaled = scaled * 1.5 + i + Math.sqrt(scaled * scaled + i) + Math.abs(scaled - i) + Math.floor(scaled / i);
        return Math.round(scaled);
    }
    if (value % 3 === 0) throw new RangeError("a multiple of three: " + value);
    return value;
}

function countOf(values: number[]): string {
    let sum = 0, caught = "";
    for (let i = 0; i < values.length; i++) {
        try {
            sum += check(values[i]);
        } catch (error) {
            caught += (error as Error).name + " " + (error as Error).message.length + ",";
        } finally {
            sum += 0.5;
        }
    }
    return sum + " " + caught;
}

function firstThatThrows(value: number): number {
    if (value > 4) throw value;
    return value * 2;
}

function sumUntilItThrows(values: number[]): number {
    let sum = 0;
    for (const value of values) sum += firstThatThrows(value);
    return sum;
}

class Counter {
    count = 0;
    bump(by: number): number {
        if (by > 100) throw new Error("too much at " + this.count);
        this.count += by;
        return this.count;
    }
}

function bumpAll(counter: Counter, steps: number[]): number {
    let last = 0;
    for (let i = 0; i < steps.length; i++) last = counter.bump(steps[i]);
    return last;
}

function calledOnceOutsideALoop(value: number): number {
    if (value > 10) throw new Error("over ten");
    return value + 1;
}

function small(value: number): number {
    return calledOnceOutsideALoop(value) * 2;
}

const values = [1, 2, 3, -4, 5, 6, 7, -8.5, 9];
console.log(countOf(values));
for (let round = 0; round < 3; round++) console.log(round, countOf(values.slice(round)));
console.log(countOf([]));
try {
    console.log(sumUntilItThrows([1, 2, 3]));
    console.log(sumUntilItThrows([1, 2, 3, 4, 5, 6]));
} catch (thrown) {
    console.log("thrown", thrown);
}
const counter = new Counter();
try {
    console.log(bumpAll(counter, [1, 2, 3]));
    console.log(bumpAll(counter, [4, 500, 6]));
} catch (error) {
    console.log((error as Error).message, counter.count);
}
try {
    console.log(small(3), small(10));
    console.log(small(11));
} catch (error) {
    console.log((error as Error).message);
}
//// callee-saves-restored-on-every-exit.ts
type Item = { id: number; name: string; next: Item | null };

function make(id: number, next: Item | null): Item {
    return { id, name: "item" + id, next };
}

function weigh(item: Item): number {
    return item.id * 3 + item.name.length;
}

function describe(item: Item, prefix: string): string {
    return prefix + item.name + ":" + item.id;
}

function fail(item: Item): never {
    throw new Error("refused " + item.name);
}

function manyWaysOut(a: Item, b: Item, c: Item, mode: number): string {
    const first = weigh(a);
    const second = weigh(b);
    if (mode === 0)
        return describe(a, "zero ") + first;
    const third = weigh(c);
    if (mode === 1)
        return describe(b, "one ") + (first + second);
    if (mode === 2)
        return describe(c, "two ") + (first + second + third);
    if (mode === 3)
        fail(b);
    let text = "";
    for (let i = 0; i < mode; i++)
        text += describe(i % 2 ? a : c, String(i)) + (first - second + third) + ";";
    return text;
}

function caller(a: Item, b: Item, c: Item): string {
    const kept = weigh(a) + weigh(b);
    const label = describe(c, "kept ");
    let out = "";
    for (let mode = 0; mode < 7; mode++) {
        try {
            out += manyWaysOut(a, b, c, mode) + "|";
        } catch (error) {
            out += "caught " + (error as Error).message + "|";
        }
        out += kept + label + "|";
    }
    return out;
}

function oneKept(item: Item, times: number): number {
    let sum = 0;
    for (let i = 0; i < times; i++)
        sum += weigh(item);
    return sum;
}

function onlyKept(a: Item, b: Item): number {
    weigh(a);
    weigh(b);
    weigh(a);
    return weigh(b) + weigh(a);
}

function throughTailCall(a: Item, b: Item, depth: number): number {
    const here = weigh(a) + weigh(b);
    if (!depth)
        return here;
    return throughTailCall(b, a, depth - 1) + here;
}

function deep(item: Item, other: Item, depth: number): number {
    const before = weigh(item);
    const below = deep(other, item, depth + 1);
    return before + below + weigh(other);
}

function overflow(a: Item, b: Item): string {
    const kept = describe(a, "before ");
    const weight = weigh(b);
    try {
        deep(a, b, 0);
        return "no overflow";
    } catch (error) {
        return kept + " " + weight + " " + (error instanceof RangeError);
    }
}

function throwsThroughThreeFrames(a: Item, b: Item, c: Item): string {
    const x = weigh(a);
    const y = describe(b, "y ");
    function inner(level: number, p: Item, q: Item): number {
        const w = weigh(p);
        const v = weigh(q);
        if (!level)
            fail(q);
        return inner(level - 1, q, p) + w + v;
    }
    try {
        return String(inner(3, b, c));
    } catch (error) {
        return x + y + (error as Error).message;
    }
}

const a = make(1, null);
const b = make(22, a);
const c = make(333, b);
console.log(caller(a, b, c));
console.log(oneKept(c, 5), onlyKept(a, c), throughTailCall(a, b, 6));
console.log(overflow(a, c));
console.log(overflow(b, a));
console.log(throwsThroughThreeFrames(a, b, c));
//// callees-not-known-statically.ts
// Calls whose callee is not known statically: compiled functions of every kind, and values that are not functions.
class K { v = 1; constructor(public w = 2) {} m(a?: number, b?: number) { return [this?.v, a, b].join() } static s(x: number) { return x + 1 } }
function plain(a: unknown, b: unknown, c: unknown) { return [a, b, c].join("|") }
function rest(...all: unknown[]) { return all.length + ":" + all.join() }
function args() { return arguments.length }
function usesThis(this: unknown, a: number) { return typeof this + a }
function withProps(a: number) { return a * 2 }
;(withProps as any).extra = 5
const arrow = (a = 7, b?: number) => a + "/" + b
async function later(a: number) { return a + 1 }
function* gen(a: number) { yield a; yield a + 1 }
const bound = plain.bind(null, "B")
const table: any[] = [plain, rest, args, usesThis, withProps, arrow, bound, K.s, new K().m, Math.max, String, (x: any) => x, parseInt]
// Without an argument these get `undefined` for a `number`: type-rules/typed-functions-via-any-missing-arguments.
const needAnArgument = new Set<unknown>([usesThis, withProps, K.s])
function callAll(fs: any[]) {
  const out: string[] = []
  for (let i = 0; i < fs.length; i++) {
    const f = fs[i]
    out.push(needAnArgument.has(f) ? "-" : String(f()), String(f(1)), String(f(1, 2)), String(f(1, 2, 3)), String(f(1, 2, 3, 4, 5, 6, 7, 8, 9)))
  }
  return out.join(" ; ")
}
console.log(callAll(table))
const holder: any = { f: usesThis, g: new K().m, v: 9 }
console.log(holder.f(1), (0, holder.f)(2))
for (const bad of [K, undefined, null, 1, "s", {}, Symbol.iterator] as any[]) {
  try { console.log(bad(1)) } catch (e) { console.log((e as Error).constructor.name) }
}
const unknown: any[] = [later, gen]
unknown[0](1).then((v: number) => console.log("later", v))
console.log([...unknown[1](5)].join(), (withProps as any).extra, table[4](4))
//// callees-that-ignore-this-or-extra-arguments.js
// Calls with several possible callees: some ignore `this` or extra arguments, some reach them through `this`, `arguments` or a rest parameter.
const kept = [];
function ignoresAll(a) { return a; }
function usesThis(a) { kept.push(this); return a; }
function usesArguments(a) { kept.push(arguments[1]); return a; }
function usesRest(a, ...rest) { kept.push(rest[0]); return a; }
function countsArguments(a) { return arguments.length + a; }
const arrow = a => a + 1;
const callees = [ignoresAll, usesThis, usesArguments, usesRest, countsArguments, arrow];

function callAll(index) {
  const receiver = { tag: "receiver" + index, f: callees[index % callees.length] };
  const extra = { tag: "extra" + index };
  const result = receiver.f(index, extra);
  receiver.tag += "!";
  extra.tag += "?";
  return result;
}

function makePair(first) {
  return first
    ? { value: 1, get() { return 10; } }
    : { value: 2, get() { return this.value; } };
}

function readPair(first) {
  const pair = makePair(first);
  pair.value += 5;
  return pair.get();
}

let total = 0;
for (let i = 0; i < 1200; i++) total += callAll(i) + readPair(i % 2 === 0);
console.log(total, kept.length, kept.slice(-6).map(item => item.tag).join(","));
//// calling-non-functions.ts
// Values that are no functions (and some unusual ones that are) are called in every way, in `any`-typed code: a TypeError wherever the call stands, also where it is the last thing its function does.
declare const console: any;
type Fn = (x: number, b?: number, c?: number, d?: number, e?: number, f?: number, g?: number, h?: number, i?: number) => number;
interface Holder { m?: any; }
const inc: Fn = x => x + 1;
const twice: Fn = x => x * 2;
const proxied: Fn = new Proxy(inc, {});
const bound: Fn = inc.bind(null);
const revocable = Proxy.revocable(inc, {}); revocable.revoke(); const revoked: Fn = revocable.proxy;
const pair: [number, number] = [1, 2];
function read_m(h: Holder): any { return h.m; }
function r0(h: Holder, a: (any)[], p?: any) { const v = h.m; return v(1); }
function r1(h: Holder, a: (any)[], p?: any) { try { const v = h.m; return v(1); } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r2(h: Holder, a: (any)[], p?: any) { const v = h.m; var r: number; r = v(1); return r; }
function r3(h: Holder, a: (any)[], p?: any) { try { const v = h.m; var r: number; r = v(1); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r4(h: Holder, a: (any)[], p?: any) { return h.m(1); }
function r5(h: Holder, a: (any)[], p?: any) { try { return h.m(1); } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r6(h: Holder, a: (any)[], p?: any) { var r: number; r = h.m(1); return r; }
function r7(h: Holder, a: (any)[], p?: any) { try { var r: number; r = h.m(1); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r8(h: Holder, a: (any)[], p?: any) { return h.m!(1); }
function r9(h: Holder, a: (any)[], p?: any) { try { return h.m!(1); } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r10(h: Holder, a: (any)[], p?: any) { var r: number; r = h.m!(1); return r; }
function r11(h: Holder, a: (any)[], p?: any) { try { var r: number; r = h.m!(1); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r12(h: Holder, a: (any)[], p?: any) { return a[0](1); }
function r13(h: Holder, a: (any)[], p?: any) { try { return a[0](1); } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r14(h: Holder, a: (any)[], p?: any) { var r: number; r = a[0](1); return r; }
function r15(h: Holder, a: (any)[], p?: any) { try { var r: number; r = a[0](1); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r16(h: Holder, a: (any)[], p?: any) { return p(1); }
function r17(h: Holder, a: (any)[], p?: any) { try { return p(1); } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r18(h: Holder, a: (any)[], p?: any) { var r: number; r = p(1); return r; }
function r19(h: Holder, a: (any)[], p?: any) { try { var r: number; r = p(1); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r20(h: Holder, a: (any)[], p?: any) { return read_m(h)(1); }
function r21(h: Holder, a: (any)[], p?: any) { try { return read_m(h)(1); } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r22(h: Holder, a: (any)[], p?: any) { var r: number; r = read_m(h)(1); return r; }
function r23(h: Holder, a: (any)[], p?: any) { try { var r: number; r = read_m(h)(1); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r24(h: Holder, a: (any)[], p?: any) { return h.m(1, 2, 3, 4, 5, 6, 7, 8, 9); }
function r25(h: Holder, a: (any)[], p?: any) { try { return h.m(1, 2, 3, 4, 5, 6, 7, 8, 9); } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r26(h: Holder, a: (any)[], p?: any) { var r: number; r = h.m(1, 2, 3, 4, 5, 6, 7, 8, 9); return r; }
function r27(h: Holder, a: (any)[], p?: any) { try { var r: number; r = h.m(1, 2, 3, 4, 5, 6, 7, 8, 9); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r28(h: Holder, a: (any)[], p?: any) { return h.m(...pair); }
function r29(h: Holder, a: (any)[], p?: any) { try { return h.m(...pair); } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r30(h: Holder, a: (any)[], p?: any) { var r: number; r = h.m(...pair); return r; }
function r31(h: Holder, a: (any)[], p?: any) { try { var r: number; r = h.m(...pair); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r32(h: Holder, a: (any)[], p?: any) { const inner = () => { const v = h.m; return v(1); }; return inner(); }
function r33(h: Holder, a: (any)[], p?: any) { const inner = () => { try { const v = h.m; return v(1); } catch (e) { return e instanceof TypeError ? -1 : -2; } }; return inner(); }
function r34(h: Holder, a: (any)[], p?: any) { const inner = () => { const v = h.m; var r: number; r = v(1); return r; }; return inner(); }
function r35(h: Holder, a: (any)[], p?: any) { const inner = () => { try { const v = h.m; var r: number; r = v(1); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }; return inner(); }
function r36(h: Holder, a: (any)[], p?: any) { const inner = () => { return h.m(1); }; return inner(); }
function r37(h: Holder, a: (any)[], p?: any) { const inner = () => { try { return h.m(1); } catch (e) { return e instanceof TypeError ? -1 : -2; } }; return inner(); }
function r38(h: Holder, a: (any)[], p?: any) { const inner = () => { var r: number; r = h.m(1); return r; }; return inner(); }
function r39(h: Holder, a: (any)[], p?: any) { const inner = () => { try { var r: number; r = h.m(1); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }; return inner(); }
function r40(h: Holder, a: (any)[], p?: any) { const inner = () => { return h.m!(1); }; return inner(); }
function r41(h: Holder, a: (any)[], p?: any) { const inner = () => { try { return h.m!(1); } catch (e) { return e instanceof TypeError ? -1 : -2; } }; return inner(); }
function r42(h: Holder, a: (any)[], p?: any) { const inner = () => { var r: number; r = h.m!(1); return r; }; return inner(); }
function r43(h: Holder, a: (any)[], p?: any) { const inner = () => { try { var r: number; r = h.m!(1); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }; return inner(); }
function r44(h: Holder, a: (any)[], p?: any) { const inner = () => { return a[0](1); }; return inner(); }
function r45(h: Holder, a: (any)[], p?: any) { const inner = () => { try { return a[0](1); } catch (e) { return e instanceof TypeError ? -1 : -2; } }; return inner(); }
function r46(h: Holder, a: (any)[], p?: any) { const inner = () => { var r: number; r = a[0](1); return r; }; return inner(); }
function r47(h: Holder, a: (any)[], p?: any) { const inner = () => { try { var r: number; r = a[0](1); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }; return inner(); }
function r48(h: Holder, a: (any)[], p?: any) { const inner = () => { return p(1); }; return inner(); }
function r49(h: Holder, a: (any)[], p?: any) { const inner = () => { try { return p(1); } catch (e) { return e instanceof TypeError ? -1 : -2; } }; return inner(); }
function r50(h: Holder, a: (any)[], p?: any) { const inner = () => { var r: number; r = p(1); return r; }; return inner(); }
function r51(h: Holder, a: (any)[], p?: any) { const inner = () => { try { var r: number; r = p(1); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }; return inner(); }
function r52(h: Holder, a: (any)[], p?: any) { const inner = () => { return read_m(h)(1); }; return inner(); }
function r53(h: Holder, a: (any)[], p?: any) { const inner = () => { try { return read_m(h)(1); } catch (e) { return e instanceof TypeError ? -1 : -2; } }; return inner(); }
function r54(h: Holder, a: (any)[], p?: any) { const inner = () => { var r: number; r = read_m(h)(1); return r; }; return inner(); }
function r55(h: Holder, a: (any)[], p?: any) { const inner = () => { try { var r: number; r = read_m(h)(1); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }; return inner(); }
