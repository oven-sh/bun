    get(id: number): number {
      return id * 2;
    },
    step: (id: number): number => id * 3,
  };
}
function loopApi(api: Api, rounds: number, at: number, change: Change): number {
  let sum = 0;
  for (let i = 0; i < rounds; i++) {
    if (i === at) change(api, api);
    sum += api.get(i) + api.step(i);
  }
  return sum;
}
