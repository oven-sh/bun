//// deep-tail-recursion-through-call-and-apply.js
// Recursion 300,000 calls deep where each call goes through call, apply or Reflect.apply of a function nobody knows: the call they pass on is a tail call.
"use strict";
function attempt(name, run) {
  try {
    console.log(name + ": " + run());
  } catch (error) {
    console.log(name + ": " + error.constructor.name);
  }
}
const unknown = value => [value][0];
const depth = 300000;

function throughCall(n, total) {
  if (n === 0) return total;
  return unknown(throughCall).call(undefined, n - 1, total + n);
}
function throughCallWithManyArguments(n, a, b, c, d, e, f, g, h, i) {
  if (n === 0) return a + b + c + d + e + f + g + h + i;
  return unknown(throughCallWithManyArguments).call(undefined, n - 1, a + 1, b, c, d, e, f, g, h, i);
}
function throughCallWithoutArguments() {
  if (--remaining === 0) return "done";
  return unknown(throughCallWithoutArguments).call();
}
function throughApply(n, total) {
  if (n === 0) return total;
  return unknown(throughApply).apply(undefined, [n - 1, total + n]);
}
function throughApplyOfUnknownList(n, total) {
  if (n === 0) return total;
  return unknown(throughApplyOfUnknownList).apply(undefined, unknown([n - 1, total + n]));
}
function throughApplyOfArrayLike(n, total) {
  if (n === 0) return total;
  return unknown(throughApplyOfArrayLike).apply(undefined, unknown({ length: 2, 0: n - 1, 1: total + n }));
}
function throughApplyOfArguments(n, total) {
  if (n === 0) return total;
  arguments[0] = n - 1;
  arguments[1] = total + n;
  return unknown(throughApplyOfArguments).apply(undefined, arguments);
}
function throughApplyWithoutList() {
  if (--remaining === 0) return "done";
  return unknown(throughApplyWithoutList).apply(undefined, unknown(remaining % 2 ? undefined : null));
}
function throughReflectApply(n, total) {
  if (n === 0) return total;
  return Reflect.apply(unknown(throughReflectApply), undefined, [n - 1, total + n]);
}
function throughReflectApplyOfArrayLike(n, total) {
  if (n === 0) return total;
  return Reflect.apply(unknown(throughReflectApplyOfArrayLike), undefined, unknown({ length: 2, 0: n - 1, 1: total + n }));
}
function throughCallOfApply(n, total) {
  if (n === 0) return total;
  return Function.prototype.apply.call(unknown(throughCallOfApply), undefined, [n - 1, total + n]);
}

let remaining = 0;
attempt("call", () => throughCall(depth, 0));
attempt("call with ten arguments", () => throughCallWithManyArguments(depth, 1, 2, 3, 4, 5, 6, 7, 8, 9));
attempt("call without arguments", () => ((remaining = depth), throughCallWithoutArguments()));
attempt("apply", () => throughApply(depth, 0));
attempt("apply of an unknown list", () => throughApplyOfUnknownList(depth, 0));
attempt("apply of an array-like object", () => throughApplyOfArrayLike(depth, 0));
attempt("apply of arguments", () => throughApplyOfArguments(depth, 0));
attempt("apply without a list", () => ((remaining = depth), throughApplyWithoutList()));
attempt("Reflect.apply", () => throughReflectApply(depth, 0));
attempt("Reflect.apply of an array-like object", () => throughReflectApplyOfArrayLike(depth, 0));
attempt("call of apply", () => throughCallOfApply(depth, 0));
//// deep-tail-recursion-through-typed-results.ts
// Indirect tail calls through functions whose declared return types are number, string and an object type run in constant stack space. The result is tested where the cycle of tail calls is left, after the entire chain has run, against the return type of the function that was called from outside: a mismatch throws a TypeError, whatever the caller does with the value. The two rows that call through `any` record no line for the call site, so they print false for it.
interface Box { depth: number }
const hops = 1_000_000;
const opaque = new Function("value", "return value") as <T>(value: T) => T;
let calls = 0;
let callSiteLine = NaN;
function toNumber(n: number, next: any): number { calls++; return n === 0 ? 0.5 : next[n % next.length](n - 1, next); }
function toText(n: number, next: any): string { calls++; return n === 0 ? "end" : next[n % next.length](n - 1, next); }
function toBox(n: number, next: any): Box { calls++; return n === 0 ? { depth: n } : next[n % next.length](n - 1, next); }
const all = opaque([toNumber, toText, toBox]);
function lineOf(error: unknown): number { return Number(/:(\d+):\d+\)?\s*$/m.exec(String((error as Error).stack))?.[1]); }
function report(label: string, run: () => unknown): void {
  calls = 0;
  callSiteLine = NaN;
  try { console.log(label + ": " + String(run()) + " after " + calls + " calls"); }
  catch (error) { console.log(label + ": " + (error as Error).constructor.name + " after " + calls + " calls, thrown at the call site: " + (lineOf(error) === callSiteLine)); }
}
report("numbers", () => toNumber(hops, opaque([toNumber])) + 1);
report("strings", () => toText(hops, opaque([toText])).length);
report("objects", () => toBox(hops, opaque([toBox])).depth);
report("known callees", () => toNumber(hops, [toNumber]) + 1);
report("mixed callees, matches the caller's type", () => toText(hops, all).length);
report("mixed callees, returned as any", () => (toNumber as any)(hops, all));
report("mixed callees, stored as any", () => { const result: any = (toNumber as any)(hops, all); return result; });
report("mixed callees, used as a number", () => { callSiteLine = lineOf(new Error()); const result: number = toNumber(hops, all); return result; });
report("mixed callees, used as an object", () => { callSiteLine = lineOf(new Error()); const result: Box = toBox(hops, all); return result; });
report("numbers again", () => toNumber(hops, opaque([toNumber])) + 1);
export {};
//// deep-tail-recursion-where-one-function-answers-any-and-the-next-declares-a-type.ts
// Two functions call each other in tail position three million deep. One answers `any`, the other declares the type of its result, and nothing else ever comes back: the stack stays level, as it does with the types erased.
interface Box { depth: number }
const hops = 3_000_000;
function anyNumber(n: number, sum: number): any { return n === 0 ? sum : toNumber(n - 1, sum + 1); }
function toNumber(n: number, sum: number): number { return anyNumber(n, sum); }
function anyText(n: number, text: string): any { return n === 0 ? text : toText(n - 1, text); }
function toText(n: number, text: string): string { return anyText(n, text); }
function anyBox(n: number, box: Box): any { return n === 0 ? box : toBox(n - 1, box); }
function toBox(n: number, box: Box): Box { return anyBox(n, box); }
function anyOrNothing(n: number): any { return n === 0 ? undefined : toNumberOrNothing(n - 1); }
function toNumberOrNothing(n: number): number | undefined { return anyOrNothing(n); }
class Counter {
  any(n: number, sum: number): any { return n === 0 ? sum : this.typed(n - 1, sum + 2); }
  typed(n: number, sum: number): number { return this.any(n, sum); }
}
function report(label: string, run: () => unknown): void {
  try { console.log(label + ": " + String(run())); } catch (error) { console.log(label + ": " + (error as Error).constructor.name); }
}
report("a number", () => toNumber(hops, 0));
report("a string", () => toText(hops, "end"));
report("an object", () => toBox(hops, { depth: 5 }).depth);
report("a number or nothing", () => toNumberOrNothing(hops));
report("methods", () => new Counter().typed(hops, 0));
export {};
