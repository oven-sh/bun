round("renamed " + double.name);
Object.setPrototypeOf(double, { inherited: 1 });
round("another prototype " + double.inherited);
Object.freeze(double);
round("frozen");
callees.double = triple;
round("replaced in the table");
console.log(log.join("\n"));
