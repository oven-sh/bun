//// frame-value-read-after-join.ts
type Shape = { kind: number; flags: number; width: number; height: number; name: string; parent: Shape | null };

let log = "";

function note(text: string): number {
    log += text + ";";
    return log.length;
}

function shape(kind: number, flags: number, name: string, parent: Shape | null): Shape {
    return { kind, flags, width: kind * 2, height: flags + 1, name, parent };
}

function bothArmsReadIt(a: Shape, b: Shape, limit: number): number {
    const before = note(a.name);
    let sum = before;
    if (a.kind > limit)
        sum += a.width;
    else
        sum -= a.height;
    if (a.flags & 2)
        sum += b.kind;
    else
        sum += b.flags;
    sum += a.kind * 3 + b.width;
    const after = note(b.name);
    return sum + after + a.flags + b.height;
}

function oneArmNamesNothing(a: Shape, b: Shape, limit: number): number {
    const before = note(a.name);
    let sum = before + a.kind;
    if (limit > 3)
        sum += limit;
    if (limit > 5)
        sum *= 2;
    sum += a.width;
    if (limit > 7)
        sum -= b.kind;
    return sum + a.height + note(b.name) + a.flags;
}

function oneArmCalls(a: Shape, b: Shape, limit: number): number {
    const before = note(a.name);
    let sum = before + a.kind;
    if (limit > 3)
        sum += note("in the arm");
    sum += a.width;
    if (limit > 5)
        sum += b.kind;
    else
        sum += note(b.name);
    return sum + a.height + b.flags;
}

function oneArmChangesIt(a: Shape, b: Shape, limit: number): number {
    let current = a;
    const before = note(current.name);
    let sum = before + current.kind;
    if (limit > 3)
        current = b;
    sum += current.width;
    if (limit > 5)
        current = current.parent ?? a;
    else
        sum += current.flags;
    sum += current.height;
    return sum + note(current.name) + current.kind;
}

function joinsInALoop(list: Shape[], wanted: Shape, limit: number): number {
    let sum = note(wanted.name);
    for (let i = 0; i < list.length; i++) {
        const item = list[i];
        if (item.kind > limit)
            sum += wanted.kind;
        else
            sum += wanted.flags;
        sum += wanted.width + item.height;
        if (item.flags === wanted.flags)
            sum += note(item.name);
        sum += wanted.height;
    }
    return sum;
}

function nestedJoins(a: Shape, b: Shape, c: Shape, limit: number): number {
    let sum = note(a.name) + note(b.name) + note(c.name);
    if (a.kind > limit) {
        if (b.kind > limit)
            sum += c.kind;
        else
            sum += c.flags;
        sum += a.width;
    } else {
        if (c.kind > limit)
            sum += b.width;
        sum += a.height;
    }
    sum += a.flags + b.flags + c.width;
    return sum + note("end") + a.kind + b.height + c.height;
}

const root = shape(9, 1, "root", null);
const shapes: Shape[] = [];
for (let i = 0; i < 12; i++)
    shapes.push(shape(i % 5, i % 4, "s" + i, i % 3 ? root : null));

let total = 0;
for (let limit = 0; limit < 10; limit++) {
    for (let i = 0; i < shapes.length; i++) {
        const a = shapes[i];
        const b = shapes[(i + 5) % shapes.length];
        const c = shapes[(i + 7) % shapes.length];
        total += bothArmsReadIt(a, b, limit);
        total += oneArmNamesNothing(a, b, limit);
        total += oneArmCalls(a, b, limit);
        total += oneArmChangesIt(a, b, limit);
        total += nestedJoins(a, b, c, limit);
        total %= 1000003;
    }
    total += joinsInALoop(shapes, shapes[limit], limit);
    log = log.slice(-40);
}
console.log(total, log);
//// frame-value-tested-repeatedly.ts
type Shape = { kind: number; flags: number; width: number; height: number; name: string; parent: Shape | null };

let log = "";

function note(text: string): number {
    log += text + ";";
    return log.length;
}

function shape(kind: number, flags: number, name: string, parent: Shape | null): Shape {
    return { kind, flags, width: kind * 2, height: flags + 1, name, parent };
}

function manyTests(a: Shape, b: Shape, limit: number): number {
    const before = note(a.name);
    if (a.kind === 1)
        return before;
    if (a.flags & 4)
        return before + 1;
    if (a.width > limit)
        return before + 2;
    if (b.kind === a.kind)
        return before + 3;
    if (b.flags === a.flags)
        return before + 4;
    if (a.height === b.height)
        return before + 5;
    if (a.parent === b)
        return before + 6;
    const after = note(b.name);
    if (a.kind === 7)
        return after;
    if (b.width + a.width > limit)
        return after + a.height;
    return after + b.height + a.kind;
}

function changedBetweenTests(a: Shape, b: Shape): number {
    let current = a;
    const first = note(current.name);
    if (current.kind === 1)
        return first;
    if (current.flags & 1)
        current = b;
    if (current.kind === 2)
        return first + 1;
    if (current.width > 5)
        current = current.parent ?? a;
    if (current.kind === 3)
        return first + 2;
    return note(current.name) + current.kind;
}

function testsInALoop(list: Shape[], wanted: Shape): number {
    let found = 0;
    const start = note(wanted.name);
    for (let i = 0; i < list.length; i++) {
        const item = list[i];
        if (item.kind !== wanted.kind)
            continue;
        if (item.flags !== wanted.flags)
            continue;
        if (item.width < wanted.width)
            continue;
        if (item.name === wanted.name)
            found += note(item.name);
        found++;
    }
    return found + start;
}

function sideWaysOut(a: Shape, b: Shape, mode: number): string {
    const n = note("side");
    if (mode === 0)
        return a.name + n;
    if (mode === 1)
        return b.name + a.name;
    if (mode === 2)
        return String(note(a.name) + a.kind) + b.name;
    if (mode === 3)
        return String(a.flags) + note(b.name) + a.name + b.kind;
    return a.name + b.name + a.kind + b.flags + n;
}

function numbersToo(x: number, y: number, z: number): number {
    const n = note("numbers");
    if (x > 10)
        return n;
    if (x + y > 10)
        return n + x;
    if (y * z > x)
        return n + y;
    if (z - x > y)
        return n + z;
    return x + y + z + note("end");
}

const root = shape(9, 0, "root", null);
const shapes = [shape(1, 0, "one", root), shape(2, 4, "two", root), shape(3, 1, "three", root), shape(4, 2, "four", null), shape(5, 2, "five", root), shape(7, 8, "seven", root), shape(3, 1, "three", null)];
let total = 0;
for (const a of shapes) {
    for (const b of shapes)
        total += manyTests(a, b, 9) * 3 + changedBetweenTests(a, b);
}
console.log(total, log.length);
log = "";
console.log(testsInALoop(shapes, shapes[2]), testsInALoop(shapes, root), log);
for (let mode = 0; mode < 5; mode++)
    console.log(sideWaysOut(shapes[1], shapes[4], mode));
console.log(numbersToo(11, 0, 0), numbersToo(5, 6, 0), numbersToo(1, 2, 3), numbersToo(1, 0.5, 2), numbersToo(1, 1, 1));
console.log(manyTests(shape(6, 0, "child", shapes[3]), shapes[3], 100), log.length);
//// fully-known-predicates.ts
// Helpers that are only ever handed functions written at the call: what the functions yield is tested for truth, stored, or both.
interface Item { id: number; label: string; next: Item | undefined }
const items: Item[] = [];
for (let i = 0; i < 6; i++) items.push({ id: i, label: i % 2 ? "" : "item" + i, next: undefined });
for (let i = 0; i + 1 < items.length; i++) items[i].next = items[i + 1];
const first = items[0];
const lines: string[] = [];
function say(label: string, value: unknown): void { lines.push(label + ": " + String(value)); }

////= lines-22	countTrue	boolean
say("all yield a boolean", countTrue(first, item => item.id > 2) + countTrue(first, item => item.label === "") * 10 + countTrue(first, () => true) * 100 + countTrue(first, () => false) * 1000);

function countNot(item: Item | undefined, test: (item: Item) => boolean): number {
    if (item === undefined) return 0;
    return (!test(item) ? 1 : 0) + countNot(item.next, test);
}
say("negated", countNot(first, item => item.id > 2));

////= lines-22	countTruthy	unknown
say("numbers, strings, objects, NaN, undefined", [countTruthy(first, item => item.id), countTruthy(first, item => item.label), countTruthy(first, item => item.next), countTruthy(first, item => item.id / 0 - item.id / 0), countTruthy(first, () => undefined), countTruthy(first, item => item.id > 3)].join(" "));

function collect(item: Item | undefined, test: (item: Item) => boolean, into: unknown[]): number {
    if (item === undefined) return 0;
    const answer = test(item);
    into.push(answer);
    return (answer ? 1 : 0) + collect(item.next, test, into);
}
const answers: unknown[] = [];
say("tested and stored", collect(first, item => item.id % 3 === 0, answers) + " " + answers.join() + " " + typeof answers[0]);

function firstTrue(item: Item | undefined, test: (item: Item) => boolean): boolean {
    if (item === undefined) return false;
    return test(item) || firstTrue(item.next, test);
}
say("yielded on", firstTrue(first, item => item.id === 4) + " " + firstTrue(first, item => item.id === 40));

function maybe(item: Item | undefined, test?: (item: Item) => boolean): number {
    if (item === undefined) return 0;
    return (test === undefined || test(item) ? 1 : 0) + maybe(item.next, test);
}
say("left out, or given", maybe(first) + " " + maybe(first, item => item.id < 2));

function throwing(item: Item | undefined, test: (item: Item) => boolean): string {
    if (item === undefined) return "";
    let mark: string;
    try { mark = test(item) ? "y" : "n"; } catch (error) { mark = (error as Error).message; }
    return mark + throwing(item.next, test);
}
say("a predicate that throws", throwing(first, item => { if (item.id === 3) throw new Error("!"); return item.id > 3; }));
console.log(lines.join("\n"));
//// function-call-reached-as-a-value.js
// Function.prototype.call where the compiler does not see which function is called: the callee is a parameter of a function that anybody may call, `call` itself is taken as a value,
// handed to Reflect.apply, bound, called through itself. With no argument up to more than fit in registers; callees of every kind; receivers that cannot be called.
const lines = [];
function show(name, run) {
  const seen = [];
  for (let turn = 0; turn < 3; turn++) {
    try {
      seen.push(String(JSON.stringify(run(turn)) ?? "undefined"));
    } catch (error) {
      seen.push(error.constructor.name + (error instanceof RangeError ? ": " + error.message : ""));
    }
  }
  lines.push(name + ": " + seen.join(" | "));
}
const describe = value => (value === undefined ? "undefined" : value === null ? "null" : value === globalThis ? "globalThis" : typeof value === "object" ? "object " + Object.prototype.toString.call(value) + " " + String(value.valueOf()) : typeof value + " " + String(value));

function sloppy() { return [describe(this), arguments.length, ...arguments]; }
function strict() { "use strict"; return [describe(this), arguments.length, ...arguments]; }
function three(a, b, c) { "use strict"; return [describe(this), a, b, c]; }
function rest(first, ...others) { "use strict"; return [describe(this), first, others]; }
function defaults(a = "A", b = a + "B") { "use strict"; return [describe(this), a, b]; }
const arrow = (...all) => ["arrow", all];
const method = { name: "holder", m(a, b) { return [this === undefined ? "undefined" : this.name, a, b]; } }.m;
class Base { constructor() { this.made = true; } static s(a) { return [this === Base, a]; } get g() { return "getter of " + this.name; } }
async function later(a, b) { return [describe(this), a, b]; }
function* steps(a, b) { yield describe(this); yield a; yield b; }
const bound = strict.bind("bound this", "bound argument");
function thrower(a) { "use strict"; throw new RangeError("thrown with " + a + " under " + describe(this)); }
const proxied = new Proxy(strict, {});
const trapped = new Proxy(strict, { apply: (target, self, list) => ["trap", describe(self), list] });

const callers = {
  member0: f => f.call(),
  member1: f => f.call("T"),
  member2: f => f.call("T", 1),
  member3: f => f.call("T", 1, 2),
  member4: f => f.call("T", 1, 2, 3),
  member5: f => f.call("T", 1, 2, 3, 4),
  member6: f => f.call("T", 1, 2, 3, 4, 5),
  member9: f => f.call("T", 1, 2, 3, 4, 5, 6, 7, 8),
  spread: f => f.call(...["T", 1, 2, 3]),
  spreadMany: f => f.call("T", ...Array.from({ length: 40 }, (_, i) => i)),
  undefinedThis: f => f.call(undefined, 1),
  nullThis: f => f.call(null, 1),
  numberThis: f => f.call(7, 1),
  objectThis: f => f.call({ name: "given", valueOf: () => "given" }, 1, 2),
};
globalThis.callersForAnybody = callers;
const callees = { sloppy, strict, three, rest, defaults, arrow, method, bound, proxied, trapped, "a static method": Base.s, "a native function": Array.prototype.concat, "Math.max": Math.max, "String.prototype.slice": String.prototype.slice };
for (const [calleeName, callee] of Object.entries(callees))
  for (const [callerName, caller] of Object.entries(globalThis.callersForAnybody))
    show(calleeName + " by " + callerName, () => caller(callee));

const call = Function.prototype.call;
show("call has its name and length", () => [call.name, call.length, typeof call, Object.getOwnPropertyNames(call).sort(), "prototype" in call]);
show("call through call", () => [call.call(strict, "T", 1, 2), call.call(call, strict, "T", 1), call.call(call, call, strict, "T", 1)]);
show("call through apply", () => [call.apply(strict, ["T", 1, 2]), call.apply(strict, []), call.apply(strict), call.apply(strict, ["T", 1, 2, 3, 4, 5, 6, 7])]);
show("call through Reflect.apply", () => [Reflect.apply(call, strict, ["T", 1]), Reflect.apply(call, three, ["T", 1, 2, 3, 4, 5, 6])]);
show("call that is bound", () => [call.bind(strict)("T", 1), call.bind(strict, "T")(1, 2), call.bind(strict, "T", 1, 2, 3, 4, 5)(6)]);
show("call as a callback", () => [[strict, three].map(call, strict).length, ["a", "b"].map(Function.prototype.call, String.prototype.toUpperCase)]);
show("call kept in an object", () => { const o = { f: strict, call }; return [o.call === call, o.f.call(o.f.name, 1)]; });
show("a function with its own call", () => { const f = function () { return "body"; }; f.call = (...all) => ["own call", all]; return globalThis.callersForAnybody.member3(f); });
show("an object with a call that is no function", () => globalThis.callersForAnybody.member2({ call: (...all) => ["a member named call", all] }));
for (const [name, value] of Object.entries({ "an object": {}, "a number": 1, "a string": "s", undefined, null: null, "a symbol": Symbol.iterator, "an array": [], "a class": Base, "a derived class": class extends Base {} })) {
  show("call on " + name + " with nothing", () => call.call(value));
  show("call on " + name + " with three", () => call.call(value, "T", 1, 2));
  show("call on " + name + " with nine", () => call.call(value, "T", 1, 2, 3, 4, 5, 6, 7, 8));
}
show("new call", () => new call());
show("the callee throws", turn => globalThis.callersForAnybody["member" + (turn + 1)](thrower));
show("a generator", () => [...globalThis.callersForAnybody.member3(steps)]);
show("a getter's function", () => globalThis.callersForAnybody.objectThis(Object.getOwnPropertyDescriptor(Base.prototype, "g").get));
show("arguments are evaluated in order, before the callee is tested", () => { const order = []; try { globalThis.callersForAnybody.order = f => f.call((order.push("this"), "T"), (order.push("first"), 1), (order.push("second"), 2)); globalThis.callersForAnybody.order(3); } catch (error) { order.push(error.constructor.name); } return order; });
show("deep", () => { "use strict"; function down(n) { return n === 0 ? describe(this) : down.call(this, n - 1); } return globalThis.callersForAnybody.member2.call(null, { call: (self, n) => down.call(self, 2000 + n) }); });
const waited = [];
for (const name of ["member1", "member3", "member6"]) waited.push(globalThis.callersForAnybody[name](later).then(value => name + ": " + JSON.stringify(value)));
Promise.all(waited).then(all => { lines.push("an async function: " + all.join(" | ")); console.log(lines.join("\n")); });
//// function-field-called-through-a-shared-body-replaced.ts
// A call through a shared body must still see a replacement, from typed and from untyped code, a value that is no function, and a nullish receiver.
interface Store {
  put: (id: number, value: number) => number;
}

function makeStore(): Store {
  const values: number[] = [];
  return { put: (id: number, value: number): number => (values[id] = value) };
}

function first(store: Store, id: number): number {
  return store.put(id, id) + 1;
}

function second(store: Store, id: number): number {
  return store.put(id, 1) + 2;
}

function replace(target: any, value: unknown): void {
  target.put = value;
}

const handlers = [first, second];
const store = makeStore();
console.log(handlers[0](store, 3), handlers[1](store, 4));

const replaced = makeStore();
replace(replaced, (id: number, value: number) => id * 100 + value);
console.log(handlers[0](replaced, 3), handlers[1](replaced, 4));

const outside: Store = JSON.parse("{}");
replace(outside, () => 9);
console.log(handlers[0](outside, 3), handlers[1](outside, 4));

const broken = makeStore();
replace(broken, 7);
for (const receiver of [broken, null, undefined]) {
  try {
    handlers[1](receiver as unknown as Store, 1);
  } catch (error) {
    console.log(error instanceof TypeError);
  }
}
