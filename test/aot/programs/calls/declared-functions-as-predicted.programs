  await stack.disposeAsync();
  const before = takeOrder();
  await moved.disposeAsync();
  return `[${before}] [${takeOrder()}]`;
});
//// errors-thrown-to-ignoring-handlers.ts
// `throw new Error("text")` to a handler that never looks at what it catches, and to handlers that do: the program behaves as in plain Bun.
const log: string[] = [];
function check(n: number): number {
  if (n % 2) throw new Error("too small");
  return n;
}
function checkRange(n: number): number {
  if (n % 3 === 0) throw new RangeError("out of range");
  if (n % 3 === 1) throw new TypeError("of the wrong kind");
  return n;
}
function deeper(depth: number, n: number): number {
  return depth ? deeper(depth - 1, n) + 1 : check(n) + checkRange(n);
}
function ignores(n: number): number {
  try {
    return check(n);
  } catch {
    return -1;
  }
}
function ignoresBinding(n: number): number {
  try {
    return deeper(3, n);
  } catch (error) {
    return -2;
  }
}
function looks(n: number): string {
  try {
    return String(deeper(2, n));
  } catch (error) {
    const e = error as Error;
    return [e instanceof Error, e.name, e.message, typeof e.stack, e.stack!.includes("check"), Object.keys(e).length].join();
  }
}
function throwsHere(n: number): number {
  try {
    if (n % 2) throw new Error("thrown and ignored in one function");
    return n;
  } catch {
    return -3;
  }
}
function throwsHereAndLooks(n: number): string {
  try {
    if (n % 2) throw new SyntaxError("thrown and read in one function");
    return "none";
  } catch (error) {
    return (error as Error).name + ": " + (error as Error).message;
  }
}
function behindFinally(n: number): number {
  try {
    try {
      return check(n);
    } finally {
      log.push("finally " + n);
    }
  } catch {
    return -4;
  }
}
function innerLooksOuterIgnores(n: number): string {
  let seen = "nothing";
  try {
    try {
      check(n);
    } catch (error) {
      seen = (error as Error).message;
      throw error;
    }
  } catch {
    seen += " and ignored";
  }
  return seen;
}
function innerIgnoresOuterLooks(n: number): string {
  try {
    try {
      check(n);
    } catch {
      log.push("ignored " + n);
    }
    return String(checkRange(n));
  } catch (error) {
    return (error as Error).name;
  }
}
async function asyncIgnores(n: number): Promise<number> {
  await null;
  try {
    return check(n);
  } catch {
    return -5;
  }
}
async function asyncRejects(n: number): Promise<number> {
  await null;
  return check(n);
}
function throughCallback(list: number[]): number {
  try {
    list.forEach(n => check(n));
    return list.length;
  } catch {
    return -6;
  }
}
function* generates(n: number): Generator<number> {
  try {
    yield check(n);
  } catch {
    yield -7;
  }
}
async function main(): Promise<void> {
  for (let n = 0; n < 6; n++) {
    log.length = 0;
    console.log([ignores(n), ignoresBinding(n), looks(n), throwsHere(n), throwsHereAndLooks(n), behindFinally(n), innerLooksOuterIgnores(n), innerIgnoresOuterLooks(n), await asyncIgnores(n), await asyncRejects(n).catch(error => (error as Error).message), throughCallback([2, n]), [...generates(n)].join()].join(" | "), log.join());
  }
  let sum = 0;
  for (let n = 0; n < 30000; n++) sum += ignores(n) + ignoresBinding(n) + throwsHere(n) + looks(n).length;
  console.log(sum);
}
main();
//// everything-a-bound-plain-function-is-asked.js
// A bind of a plain function that the compiler sees: called, constructed, tested, looked at, bound again, extended.
const lines = [];
const say = (...parts) => lines.push(parts.map(part => (typeof part === "function" ? "function " + part.name : String(part))).join(" "));
function Point(x, y) { if (new.target) { this.x = x; this.y = y; this.made = new.target === Point ? "Point" : new.target.name; } else return "called " + x + " " + y; }
Point.prototype.sum = function () { return this.x + this.y; };
function usesThis(a) { return this === undefined ? "undefined " + a : this === null ? "null " + a : typeof this + " " + (this.tag ?? "-") + " " + a; }
function strictThis(a) { "use strict"; return this === undefined ? "undefined " + a : this === null ? "null " + a : typeof this + " " + a; }
function five(a, b, c, d, e) { return [a, b, c, d, e].join(","); }
function returnsObject(a) { return { a }; }
function counter() { let n = 0; function next(step) { if (new.target) this.n = n; n += step; return n; } return next; }
function make() {
  const one = Point.bind(null, 1);
  say("call", one(2), one());
  const p = new one(2);
  say("new", p.x, p.y, p.made, p.sum(), p instanceof Point, p instanceof one, Object.getPrototypeOf(p) === Point.prototype, p.constructor === Point);
  const both = Point.bind({ ignored: true }, 3, 4);
  const q = new both(5);
  say("new with all bound", q.x, q.y, q.made, q instanceof both);
  say("names", one.name, one.length, both.name, both.length, typeof one, Object.prototype.toString.call(one));
  say("prototype", "prototype" in one, one.prototype, Object.getOwnPropertyNames(one).sort().join(), Object.getPrototypeOf(one) === Function.prototype);
  say("text", String(one).replace(/\s+/g, " "));
  try { class Derived extends one { constructor() { super(7); this.extra = 1; } } const d = new Derived(); say("extends", d.x, d.y, d.made, d.extra, d instanceof Derived, d instanceof Point); } catch (e) { say("extends throws", e.constructor.name); }
  const withPrototype = Point.bind(null, 1); withPrototype.prototype = Point.prototype;
  class Heir extends withPrototype { constructor() { super(7); this.extra = 1; } }
  const h = new Heir(); say("extends with a prototype of its own", h.x, h.y, h.made, h.extra, h instanceof Heir, h instanceof Point, h.sum());
  function Other() {} Other.prototype.mark = "other";
  const r = Reflect.construct(one, [8], Other);
  say("Reflect.construct", r.x, r.y, r.made, r.mark, r instanceof Point, r instanceof Other);
  const r2 = Reflect.construct(one, [9], one);
  say("new.target is the bound function", r2.made, r2 instanceof Point);
  const again = one.bind(null, 10);
  const s = new again();
  say("bound again", again.name, again.length, again(), s.x, s.y, s.made, s instanceof Point);
  say("this", usesThis.bind({ tag: "t" }, 1)(), usesThis.bind(null, 2)() === usesThis.call(null, 2), usesThis.bind(5, 3)(), strictThis.bind(null, 4)(), strictThis.bind(undefined, 5)(), strictThis.bind(6, 7)());
  say("many", five.bind(null, 1, 2, 3, 4)(5), five.bind(null, 1, 2, 3, 4, 5, 6, 7)(8), five.bind(null)(1), five.bind()(1, 2));
  say("new returns an object", new (returnsObject.bind(null, 1))().a, new (returnsObject.bind(null))(2).a);
  const next = counter();
  const byTwo = next.bind(null, 2);
  say("captures", byTwo(), byTwo(), new byTwo().n, next(1), new byTwo() instanceof next);
  one.extra = 1; say("own property", one.extra, Object.keys(one).join(), delete one.extra, one.extra);
  Object.defineProperty(one, "name", { value: "renamed" }); say("renamed", one.name, one.bind(null).name);
  say("identity", Point.bind(null, 1) === Point.bind(null, 1), one === one, new Set([one, one, both]).size);
  say("isConstructor", (() => { try { Reflect.construct(Object, [], one); return true; } catch { return false; } })(), (() => { try { Reflect.construct(Object, [], (() => 1).bind(null)); return true; } catch { return false; } })());
  async function later(a) { return a; } function* gen(a) { yield a; }
  for (const f of [later.bind(null, 1), gen.bind(null, 1), (a => a).bind(null, 1), { m(a) { return a; } }.m.bind(null, 1)]) { try { new f(); say("constructs", f.name); } catch (e) { say("does not construct", f.name, e.constructor.name); } }
  Point.prototype = { sum() { return -1; } };
  const t = new one(2); say("the prototype of the target is replaced", t.sum(), t instanceof one, p instanceof one);
}
make();
let total = 0;
function Pair(a, b) { this.a = a; this.b = b; }
for (let i = 0; i < 20000; i++) { const f = Pair.bind(null, i); const o = (i & 1023) === 0 ? new f(i) : null; total += o ? o.a + o.b : f.length; }
say("loop", total);
console.log(lines.join("\n"));
//// exception-through-tail-apply-from-native-callers.ts
// A strict compiled function that ends in `g.apply(thisArg, list)`, where `list` is neither an array nor `arguments`, calls `g` through C++
// and a nested VM entry. These rows throw out of that call, from `g` or from reading the list, with every kind of caller that is
// not compiled code: run-time generated code, a promise reaction, a bound function, a Proxy trap, a sort comparator, a JSON reviver.
function row(name: string, run: () => unknown) { try { console.log(name + ": " + String(run())); } catch (e) { console.log(name + ": caught " + (e as Error).message); } }
const interpretedThrower = new Function("a", "throw new TypeError('thrown ' + a);");
function compiledThrower(a: unknown): unknown { throw new TypeError("thrown " + a); }
function deepThrower(a: unknown): unknown { return [1].map(() => compiledThrower(a))[0]; }
const call = new Function("f", "x", "return f(x);");
const arrayLike = () => ({ length: 1, 0: "a" });

const throwers: Record<string, (a: unknown) => unknown> = { interpretedThrower: interpretedThrower as (a: unknown) => unknown, compiledThrower, deepThrower };
for (const [name, thrower] of Object.entries(throwers)) {
  function viaApply(list: unknown): unknown { return thrower.apply(undefined, list as any); }
  const arrow = (list: unknown): unknown => thrower.apply(undefined, list as any);
  const holder = { method(list: unknown): unknown { return thrower.apply(this, list as any); } };
  row(name + ", an array-like", () => call(viaApply, arrayLike()));
  row(name + ", a typed array", () => call(viaApply, new Uint8Array([7])));
  row(name + ", a string object", () => call(viaApply, new String("s")));
  row(name + ", an arrow function", () => call(arrow, arrayLike()));
  row(name + ", a method", () => call(holder.method, arrayLike()));
  row(name + ", a bound function", () => call(viaApply.bind(null), arrayLike()));
  row(name + ", Reflect.apply", () => Reflect.apply(viaApply, undefined, [arrayLike()]));
  row(name + ", a Proxy trap", () => call(new Proxy(viaApply, { apply(target, self, list) { return Reflect.apply(target, self, list); } }), arrayLike()));
  row(name + ", a sort comparator", () => [2, 1].sort((a, _b) => thrower.apply(undefined, { length: 1, 0: a } as any) as number));
  row(name + ", a JSON reviver", () => JSON.parse("[1]", (_key, value) => thrower.apply(undefined, { length: 1, 0: value } as any)));
  row(name + ", a replace callback", () => "x".replace("x", text => thrower.apply(undefined, { length: 1, 0: text } as any) as string));
}

function applies(list: unknown): unknown { return compiledThrower.apply(undefined, list as any); }
row("the length throws", () => call(applies, { get length() { throw new RangeError("length refused"); } }));
row("an element throws", () => call(applies, { length: 1, get 0() { throw new RangeError("element refused"); } }));
row("Reflect.apply in run-time code", () => new Function("return Reflect.apply(function (a) { throw new TypeError('thrown ' + a); }, undefined, { length: 1, 0: 'a' });")());
row("Reflect.apply in run-time code, caught there", () => new Function("try { return Reflect.apply(function (a) { throw new TypeError('thrown ' + a); }, undefined, { length: 1, 0: 'a' }); } catch (e) { return 'inside ' + e.message; }")());

async function asyncApplies(list: unknown): Promise<unknown> { return interpretedThrower.apply(undefined, list as any); }
await Promise.resolve(arrayLike()).then(applies).catch(e => console.log("a promise reaction: rejected " + e.message));
await (call(asyncApplies, arrayLike()) as Promise<unknown>).then(v => console.log(v), e => console.log("an async function: rejected " + e.message));
await Promise.resolve().then(() => row("inside a promise reaction", () => call(applies, arrayLike())));
console.log([1.5, 2.5].map(x => x * 2).join(), "text".toUpperCase(), 2 ** 31);
//// exception-through-tail-call-under-adapter.ts
type Callee = (...values: unknown[]) => unknown;
type Form = (callee: Callee, list: unknown) => unknown;
type Caller = (form: Form, callee: Callee, list: unknown) => unknown;

const only: number = (globalThis as { rowToRun?: number }).rowToRun ?? -1;

function throwCompiled(value: unknown): unknown {
  throw new TypeError("compiled " + String(value));
}
function throwOneDeeper(value: unknown): unknown {
  const result = throwCompiled(value);
  return [result];
}
function throwTwoDeeper(value: unknown): unknown {
  const result = throwOneDeeper(value);
  return [result];
}
function applyAgain(value: unknown): unknown {
  return throwCompiled.apply(undefined, { length: 1, 0: "again " + String(value) } as any);
}
const throwInterpreted = new Function("value", "throw new TypeError('interpreted ' + String(value));") as Callee;
function applyInterpretedAgain(value: unknown): unknown {
  return throwInterpreted.apply(undefined, { length: 1, 0: "again " + String(value) } as any);
}
function returnValue(value: unknown): unknown {
  return "returned " + String(value);
}

const callees: Array<[string, Callee]> = [
  ["interpreted", throwInterpreted],
  ["compiled", throwCompiled],
  ["compiled two deeper", throwTwoDeeper],
  ["compiled applying again", applyAgain],
  ["compiled applying interpreted again", applyInterpretedAgain],
  ["native", JSON.parse as Callee],
  ["class", class {} as unknown as Callee],
  ["interpreted class", new Function("return class {};")() as Callee],
  ["returning", returnValue],
];

const holder = { method: returnValue as Callee };

const forms: Array<[string, Form]> = [
  ["apply", (callee, list) => callee.apply(undefined, list as any)],
  ["apply with this", function (this: unknown, callee, list) { return callee.apply(this, list as any); }],
  ["Reflect.apply", (callee, list) => Reflect.apply(callee, undefined, list as any)],
  ["spread", (callee, list) => callee(...Array.prototype.values.call(list))],
  ["spread of a set", (callee, list) => callee(...new Set([(list as any)[0]]))],
  ["call", (callee, list) => callee.call(undefined, (list as any)[0])],
  ["plain call", (callee, list) => callee((list as any)[0])],
  ["nine arguments", (callee, list) => callee((list as any)[0], 2, 3, 4, 5, 6, 7, 8, 9)],
  ["bound", (callee, list) => Function.prototype.bind.call(callee, undefined)((list as any)[0])],
  ["bound apply", (callee, list) => Function.prototype.bind.call(callee, undefined).apply(undefined, list as any)],
  ["proxy", (callee, list) => new Proxy(returnValue, { apply: (_target, _receiver, values) => callee(values[0]) })((list as any)[0])],
  ["proxy apply", (callee, list) => new Proxy(returnValue, { apply: (_target, _receiver, values) => callee(values[0]) }).apply(undefined, list as any)],
  ["method by name", (callee, list) => { holder.method = callee; return holder.method((list as any)[0]); }],
  ["untyped apply", (callee: any, list) => callee.apply(undefined, list)],
  ["untyped call of a number", (_callee, list: any) => list.length()],
  ["construct", (callee, list) => Reflect.construct(function () { return callee((list as any)[0]) as any; }, [])],
];

const lists: Array<[string, () => unknown]> = [
  ["array-like", () => ({ length: 1, 0: "{" })],
  ["array", () => ["{"]],
  ["typed array", () => new Uint8Array([7])],
  ["throwing length", () => ({ get length(): number { throw new RangeError("length"); }, 0: "{" })],
  ["throwing element", () => ({ length: 1, get 0(): string { throw new RangeError("element"); } })],
  ["interpreted throwing length", () => Object.defineProperty({ 0: "{" }, "length", { get: new Function("throw new RangeError('interpreted length');") as () => number })],
  ["proxy", () => new Proxy({ length: 1, 0: "{" }, { get: (target, key) => { if (key === "0") throw new RangeError("trap"); return Reflect.get(target, key); } })],
];

const callInterpreted = new Function("form", "callee", "list", "return form(callee, list);") as Caller;
const callInterpretedNotInTailPosition = new Function("form", "callee", "list", "const result = form(callee, list); return result;") as Caller;
const catchInterpreted = new Function(
  "form",
  "callee",
  "list",
  "let a = 1, b = 2, c = 'c'; try { return form(callee, list); } catch (error) { return 'interpreted caller caught ' + error.name + ' ' + (a + b) + c; }",
) as Caller;
const callIndirectEval = (0, eval)("(function (form, callee, list) { return form(callee, list); })") as Caller;

const callers: Array<[string, Caller]> = [
  ["interpreted", callInterpreted],
  ["interpreted, not in tail position", callInterpretedNotInTailPosition],
  ["interpreted with catch", catchInterpreted],
  ["indirect eval", callIndirectEval],
  ["interpreted through bind", (form, callee, list) => callInterpreted(form.bind(undefined), callee, list)],
  ["compiled", (form, callee, list) => [form(callee, list)]],
  ["sort", (form, callee, list) => [1, 2].sort(() => form(callee, list) as any)],
  ["reviver", (form, callee, list) => JSON.parse("1", () => form(callee, list))],
  ["replace", (form, callee, list) => "a".replace("a", () => form(callee, list) as any)],
  ["getter", (form, callee, list) => Reflect.get({ get value(): unknown { return form(callee, list); } }, "value")],
  ["toString", (form, callee, list) => String({ toString: () => form(callee, list) })],
];

function describe(result: unknown): string {
  return typeof result === "string" ? result : typeof result;
}

function describeError(error: unknown): string {
  const { name, message } = error as Error;
  return /^(compiled .*|interpreted .*|length|element|trap)$/.test(message) ? name + " " + message : name;
}

const outcomes = new Map<string, number>();
function report(title: string, outcome: string): void {
  if (only >= 0) console.log(title + outcome);
  outcomes.set(outcome, (outcomes.get(outcome) ?? 0) + 1);
}

let row = 0;
for (const [callerName, caller] of callers) {
  for (const [formName, form] of forms) {
    for (const [calleeName, callee] of callees) {
      for (const [listName, list] of lists) {
        if (only >= 0 && row++ !== only) continue;
        const title = callerName + " | " + formName + " | " + calleeName + " | " + listName + ": ";
        try {
          report(title, describe(caller(form, callee, list())));
        } catch (error) {
          report(title, "caught " + describeError(error));
        }
      }
    }
  }
}

for (const [formName, form] of forms) {
  for (const [calleeName, callee] of callees) {
    for (const [listName, list] of lists) {
      if (only >= 0 && row++ !== only) continue;
      const title = "promise reaction | " + formName + " | " + calleeName + " | " + listName + ": ";
      try {
        report(title, describe(await Promise.resolve(list()).then(value => form(callee, value))));
      } catch (error) {
        report(title, "caught " + describeError(error));
      }
    }
  }
}

