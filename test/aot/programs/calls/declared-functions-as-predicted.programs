// An object that never leaves the function that makes it holds a function in a field, and the field is called where the code is hot.
// Each part has types of its own, so that what one part stores decides nothing for the next.
const lines: string[] = [];
function say(label: string, ...parts: unknown[]): void { lines.push(label + ": " + parts.join(" ")); }
interface Point { x: number; y: number }
const made: Point = { x: 1, y: 2 };
let noted = 0;

////= lines-20	Walker	onEach
for (let round = 0; round < 3; round++) {
    const walker = new Walker(p => { noted += p.y; });
    walker.onEach(made);
    say("the function the constructor got", walker.seen, noted);
    walker.onEach = function (this: unknown, p: Point) { (this as Walker).seen += p.x; };
    walker.onEach(made);
    say("the function assigned later", walker.seen, noted);
}

class Stepper {
    seen = 0;
    constructor(public onStep: (p: Point) => void) {}
    step(p: Point): number { this.onStep(p); return this.seen; }
}
function throughAMethod(rounds: number, p: Point): string {
    let total = 0;
    for (let round = 0; round < rounds; round++) {
        const stepper = new Stepper(q => { noted += q.y * 10; });
        total += stepper.step(p);
        stepper.onStep = function (this: unknown, q: Point) { (this as Stepper).seen += q.x; };
        total += stepper.step(p) * 100;
    }
    return total + " " + noted;
}
say("through a method", throughAMethod(3, made), throughAMethod(0, made));

////= lines-20	Reader	onRead
function neverRead(rounds: number, p: Point): string {
    let last = 0;
    for (let round = 0; round < rounds; round++) {
        const unread = new Reader(q => { noted += q.y * 1000; });
        unread.seen = round;
        const reader = new Reader(function (this: unknown, q: Point) { (this as Reader).seen += q.x; });
        reader.onRead(p);
        last = reader.seen;
    }
    return last + " " + noted;
}
say("beside an object that is only written", neverRead(3, made));

interface Holder { scale: number; apply: (x: number) => number }
function double(x: number): number { return x * 2; }
function records(rounds: number): number {
    let total = 0;
    for (let round = 0; round < rounds; round++) {
        const first: Holder = { scale: round, apply: double };
        total += first.apply(round);
        const second: Holder = { scale: round, apply: x => x + 100 };
        total += second.apply(round);
        second.apply = double;
        total += second.apply(round);
    }
    return total;
}
say("records", records(4));

class Counter {
    count = 0;
    bump = () => { this.count++; return this.count; };
}
function arrows(rounds: number): number {
    let total = 0;
    for (let round = 0; round < rounds; round++) {
        const a = new Counter(), b = new Counter();
        total += a.bump() + a.bump();
        b.bump = a.bump;
        total += b.bump() * 10 + b.count * 100 + a.count * 1000;
        b.bump = () => -1;
        total += b.bump();
    }
    return total;
}
say("arrow functions that capture their holder", arrows(3));

////= lines-20	Escapee	onLeave
const kept: Escapee[] = [];
function escaping(rounds: number, p: Point): string {
    for (let round = 0; round < rounds; round++) {
        const escapee = new Escapee(q => { noted += q.y * 100000; });
        if (round === 1) kept.push(escapee);
        escapee.onLeave(p);
        escapee.onLeave = function (this: unknown, q: Point) { (this as Escapee).seen += q.x; };
        escapee.onLeave(p);
    }
    return kept.map(escapee => escapee.seen).join() + " " + noted;
}
say("an object that leaves on one path", escaping(3, made));
console.log(lines.join("\n"));
//// function-fields-replaced-while-copied.ts
// Copies of a record whose field the typed program assigns one function expression to, with another function put in its place while it is copied.
const lines: string[] = [];
type Fn = (x: number) => number;
const others: Fn[] = [x => x * 100, x => x * 1000];
function pick(i: number): Fn { return others[i & 1]; }
interface R1 { k: number; f1: Fn }
function make1(k: number): R1 { return { k, f1: x => x + 1 }; }
function spreadThenStore(rounds: number): number { let s = 0; for (let i = 0; i < rounds; i++) { const a = make1(i); s += a.f1(1); const b: R1 = { ...a, f1: pick(i) }; s += b.f1(1); const c: R1 = { ...a }; c.f1 = pick(i + 1); s += c.f1(1) + a.f1(1); } return s; }
lines.push("a spread with the member replaced: " + spreadThenStore(4));
interface R2 { k: number; f2: Fn }
function make2(k: number): R2 { return { k, f2: x => x + 2 }; }
const kept2: R2[] = [];
function spreadKept(rounds: number): number { let s = 0; for (let i = 0; i < rounds; i++) { const a = make2(i); kept2.push({ ...a, f2: pick(i) }); kept2.push(a); } for (const r of kept2) s += r.f2(1); return s; }
lines.push("the copies are kept: " + spreadKept(4));
interface R3 { k: number; f3: Fn }
function make3(k: number): R3 { return { k, f3: x => x + 3 }; }
function withMore<T extends R3>(value: T, f: Fn): T { return { ...value, f3: f }; }
function generic(rounds: number): number { let s = 0; for (let i = 0; i < rounds; i++) { const a = make3(i); const b = withMore(a, pick(i)); s += a.f3(1) + b.f3(1); } return s; }
lines.push("under a type parameter: " + generic(4));
interface R4 { k: number; f4: Fn }
function make4(k: number, f?: Fn): R4 { const made: R4 = { k, f4: x => x + 4 }; if (f) made.f4 = f; return made; }
function conditional(rounds: number): number { let s = 0; for (let i = 0; i < rounds; i++) s += make4(i, i & 1 ? pick(i) : undefined).f4(1); return s; }
lines.push("stored on one path: " + conditional(4));
console.log(lines.join("\n"));
//// function-fields-that-come-to-hold-another-function.ts
// Roads by which a field that the typed program assigns one function expression to comes to hold another function.
const lines: string[] = [];
type Fn = (x: number) => number;
const others: Fn[] = [x => x * 100, x => x * 1000];
function pick(i: number): Fn { return others[i & 1]; }
function callAll<T extends { f: Fn }>(label: string, list: T[]): void { let sum = 0; for (let i = 0; i < list.length; i++) sum += list[i].f(i + 1); lines.push(label + ": " + sum); }

class A1 { k = 1; f: Fn = x => x + 1; }
{ const list: A1[] = []; for (let i = 0; i < 4; i++) list.push(new A1()); let s = 0; for (const a of list) s += a.f(1); Object.assign(list[1], { f: pick(0) }); for (const a of list) s += a.f(1); lines.push("Object.assign: " + s); }

class A2 { k = 1; g2: Fn = x => x + 2; }
{ const list: A2[] = []; for (let i = 0; i < 4; i++) list.push(new A2()); let s = 0; for (const a of list) s += a.g2(1); Reflect.set(list[1], "g2", pick(0)); for (const a of list) s += a.g2(1); lines.push("Reflect.set: " + s); }

class A3 { k = 1; g3: Fn = x => x + 3; }
{ const list: A3[] = []; for (let i = 0; i < 4; i++) list.push(new A3()); let s = 0; for (const a of list) s += a.g3(1); Object.defineProperty(list[1], "g3", { value: pick(0), writable: true, enumerable: true, configurable: true }); for (const a of list) s += a.g3(1); lines.push("Object.defineProperty: " + s); }

class A4 { k = 1; g4: Fn = x => x + 4; }
{ const list: A4[] = []; for (let i = 0; i < 4; i++) list.push(new A4()); let s = 0; for (const a of list) s += a.g4(1); const key: string = ["g", "4"].join(""); (list[1] as any)[key] = pick(0); for (const a of list) s += a.g4(1); lines.push("a computed key: " + s); }

interface R5 { k: number; g5: Fn }
interface S5 { k: number; g5: Fn; extra?: number }
function make5(k: number): R5 { return { k, g5: x => x + 5 }; }
{ const from: S5 = JSON.parse('{"k":7}'); from.g5 = pick(0); const list: R5[] = []; for (let i = 0; i < 4; i++) list.push(make5(i)); let s = 0; for (const a of list) s += a.g5(1); const copy: R5 = { ...from }; list.push(copy); for (const a of list) s += a.g5(1); lines.push("a spread of another object: " + s); }

class A6 { k = 1; g6: Fn = x => x + 6; }
class B6 extends A6 { constructor(f: Fn) { super(); this.g6 = f; } }
{ const list: A6[] = []; for (let i = 0; i < 4; i++) list.push(new A6()); let s = 0; for (const a of list) s += a.g6(1); list.push(new B6(pick(1))); for (const a of list) s += a.g6(1); lines.push("a subclass stores: " + s); }

class A7 { k = 1; g7: Fn = x => x + 7; }
{ const list: A7[] = []; for (let i = 0; i < 4; i++) list.push(new A7()); let s = 0; for (const a of list) s += a.g7(1); const untyped: any = list[2]; untyped.g7 = pick(1); for (const a of list) s += a.g7(1); lines.push("an untyped store: " + s); }

class A8 { k = 1; g8: Fn = x => x + 8; }
{ const list: A8[] = []; for (let i = 0; i < 4; i++) list.push(new A8()); let s = 0; for (const a of list) s += a.g8(1); delete (list[2] as any).g8; (list[2] as any).g8 = pick(1); for (const a of list) s += a.g8(1); lines.push("deleted, then stored: " + s); }

class A9 { k = 1; g9: Fn = x => x + 9; }
{ const list: A9[] = []; for (let i = 0; i < 4; i++) list.push(new A9()); let s = 0; for (const a of list) s += a.g9(1); const [first, second] = list; [first.g9, second.g9] = [pick(0), pick(1)]; for (const a of list) s += a.g9(1); lines.push("destructuring assignment: " + s); }

class A10 { k = 1; g10: Fn = x => x + 10; }
{ const list: A10[] = []; for (let i = 0; i < 4; i++) list.push(new A10()); let s = 0; for (const a of list) s += a.g10(1); const made: A10 = Object.create(A10.prototype, { k: { value: 1, writable: true, enumerable: true, configurable: true }, g10: { value: pick(0), writable: true, enumerable: true, configurable: true } }); list.push(made); for (const a of list) s += a.g10(1); lines.push("Object.create with descriptors: " + s); }

class A11 { k = 1; g11: Fn = x => x + 11; }
{ const list: A11[] = []; for (let i = 0; i < 4; i++) list.push(new A11()); let s = 0; for (const a of list) s += a.g11(1); const clone: A11 = Object.assign(Object.create(A11.prototype), list[0], { g11: pick(1) }); list.push(clone); for (const a of list) s += a.g11(1); lines.push("a clone by Object.assign: " + s); }

class A12 { k = 1; g12: Fn = x => x + 12; swap(other: A12): void { const mine = this.g12; this.g12 = other.g12; other.g12 = mine; } }
{ const list: A12[] = []; for (let i = 0; i < 4; i++) list.push(new A12()); let s = 0; for (const a of list) s += a.g12(1); (list[3] as any).g12 = pick(0); list[0].swap(list[3]); for (const a of list) s += a.g12(1); lines.push("handed from object to object: " + s); }
console.log(lines.join("\n"));
//// function-object-operations.ts
// Everything that can be done to a function object (properties added and deleted, index keys, freezing, another prototype), each followed by a garbage collection and a call.
const g: any = globalThis
function collect(): void { if (typeof g.gc === "function") g.gc(); else if (g.Bun) g.Bun.gc(true) }
function snapshot(): void { if (typeof g.generateHeapSnapshot === "function") g.generateHeapSnapshot() }
const special = new Set<string>(["length", "name", "prototype", "arguments", "caller"])
function own(f: any): string { return Reflect.ownKeys(f).filter(k => typeof k === "symbol" || !special.has(k)).map(k => String(k)).join(",") }
function attempt(what: () => unknown): string { try { return String(what()) } catch (e) { return (e as Error).constructor.name } }
function make(k: number): Array<(x: number) => number> { return [x => x + k, function (x: number): number { return x * k }, x => x, function (x: number): number { return x - 1 }] }
let row = 0
function check(name: string, fs: Array<(x: number) => number>, extra: string): void {
    collect()
    console.log(++row, name, fs.map(f => f(10)).join(" "), extra)
}
const sym = Symbol("s")

{ const fs = make(3); check("as made", fs, fs.map(own).join("|")) }
{ const fs = make(3); for (const f of fs as any[]) f.a = 1; check("one property", fs, (fs as any[]).map(f => f.a + ":" + own(f)).join("|")) }
{ const fs = make(3); for (const f of fs as any[]) { f.a = 1; f.b = 2; f.c = 3; f.d = 4; f.e = 5 } check("a run of properties", fs, (fs as any[]).map(f => f.a + f.e + ":" + own(f)).join("|")) }
{ const fs = make(3); for (const f of fs as any[]) { for (let i = 0; i < 300; i++) f["p" + i] = i; for (let i = 0; i < 300; i += 2) delete f["p" + i] } check("many, half deleted", fs, (fs as any[]).map(f => Object.keys(f).length + ":" + f.p299 + ":" + f.p298).join("|")) }
{ const fs = make(3); for (const f of fs as any[]) { f.a = 1; delete f.a; collect(); f.b = 2 } check("given, deleted, given", fs, fs.map(own).join("|")) }
{ const fs = make(3); for (const f of fs as any[]) { f[0] = "z"; f[5] = 1 } check("indexed", fs, (fs as any[]).map(f => f[0] + f[5] + ":" + own(f)).join("|")) }
{ const fs = make(3); for (const f of fs as any[]) { f[100000] = 2; f[1] = 1 } check("sparse", fs, (fs as any[]).map(f => f[100000] + ":" + own(f)).join("|")) }
{ const fs = make(3); for (const f of fs as any[]) f[sym] = 7; check("a symbol", fs, (fs as any[]).map(f => f[sym] + ":" + own(f)).join("|")) }
{ const fs = make(3); for (const f of fs as any[]) Object.defineProperty(f, "acc", { get() { return this(1) }, configurable: true }); check("an accessor", fs, (fs as any[]).map(f => f.acc + ":" + own(f) + ":" + Object.keys(f).length).join("|")) }
{ const fs = make(3); for (const f of fs as any[]) Object.defineProperty(f, 2, { value: "i", enumerable: false }); check("an indexed property defined", fs, (fs as any[]).map(f => f[2] + ":" + own(f) + ":" + Object.keys(f).length).join("|")) }
{ const fs = make(3); for (const f of fs) Object.freeze(f); check("frozen", fs, (fs as any[]).map(f => Object.isFrozen(f) + ":" + attempt(() => { f.a = 1 }) + ":" + own(f)).join("|")) }
{ const fs = make(3); for (const f of fs as any[]) { f.a = 1; Object.freeze(f) } check("given, frozen", fs, (fs as any[]).map(f => attempt(() => { f.a = 2 }) + ":" + f.a).join("|")) }
{ const fs = make(3); for (const f of fs) Object.seal(f); check("sealed", fs, (fs as any[]).map(f => Object.isSealed(f) + ":" + attempt(() => { f.a = 1 })).join("|")) }
{ const fs = make(3); for (const f of fs) Object.preventExtensions(f); check("not extensible", fs, (fs as any[]).map(f => Object.isExtensible(f) + ":" + attempt(() => { f[0] = 1 })).join("|")) }
{ const fs = make(3); const proto = { inherited: 5 }; for (const f of fs) Object.setPrototypeOf(f, proto); check("another prototype", fs, (fs as any[]).map(f => f.inherited + ":" + typeof f.call + ":" + Function.prototype.call.call(f, undefined, 4)).join("|")) }
{ const fs = make(3); for (const f of fs) Object.setPrototypeOf(f, null); check("no prototype", fs, (fs as any[]).map(f => String(Object.getPrototypeOf(f)) + ":" + typeof f).join("|")) }
{ const fs = make(3); const os = (fs as any[]).map(f => { f.a = 9; return Object.create(f) }); check("as a prototype", fs, os.map(o => o.a + ":" + typeof o + ":" + attempt(() => o(1))).join("|")) }
{ const fs = make(3); const os = (fs as any[]).map(f => Object.create(f)); for (const f of fs as any[]) f.late = 1; check("a prototype first, given later", fs, os.map(o => o.late).join("|")) }
{ const fs = make(3); for (const f of fs) Object.assign(f, { p: 1, q: 2 }); check("Object.assign onto", fs, (fs as any[]).map(f => own(f) + ":" + JSON.stringify(Object.assign({}, f)) + JSON.stringify({ ...f })).join("|")) }
{ const fs = make(3); check("spread and assign from one as made", fs, (fs as any[]).map(f => JSON.stringify({ ...f }) + JSON.stringify(Object.assign({}, f)) + Object.entries(f).length + Object.values(f).length).join("|")) }
{ const fs = make(3); for (const f of fs as any[]) { f.x = 1; f.y = 2 } check("for in", fs, (fs as any[]).map(f => { let s = ""; for (const k in f) s += k; return s }).join("|")) }
{ const fs = make(3); check("for in, as made", fs, (fs as any[]).map(f => { let s = "-"; for (const k in f) s += k; return s }).join("|")) }
{ const fs = make(3); check("JSON", fs, (fs as any[]).map(f => String(JSON.stringify(f)) + JSON.stringify({ f }) + JSON.stringify([f])).join("|")) }
{ const fs = make(3); for (const f of fs) { try { g.structuredClone?.(f) } catch { } } check("structuredClone", fs, "") }
{ const fs = make(3); const w = new WeakMap<object, number>(), m = new Map<unknown, number>(), s = new WeakSet<object>(); fs.forEach((f, i) => { w.set(f, i); m.set(f, i); s.add(f) }); check("as keys", fs, fs.map(f => "" + w.get(f) + m.get(f) + s.has(f)).join("|")) }
{ const fs = make(3); const bs = fs.map(f => f.bind(null, 20)); check("bound", fs, bs.map(b => (b as any)() + ":" + b.length).join("|")) }
{ const fs = make(3); check("name and length", fs, fs.map(f => JSON.stringify(f.name) + f.length + typeof (f as any).prototype).join("|")) }
{ const fs = make(3); for (const f of fs) { Object.defineProperty(f, "length", { value: 7 }); Object.defineProperty(f, "name", { value: "n" }) } check("name and length defined", fs, fs.map(f => f.name + f.length + ":" + own(f)).join("|")) }
{ const fs = make(3); check("length stored to", fs, (fs as any[]).map(f => attempt(() => { f.length = 5 }) + f.length).join("|")) }
{ const fs = make(3); check("push onto", fs, (fs as any[]).map(f => attempt(() => Array.prototype.push.call(f, 1, 2)) + ":" + own(f)).join("|")) }
{ const fs = make(3); check("constructed", fs, (fs as any[]).map(f => attempt(() => typeof new f(1))).join("|")) }
{ const fs = make(3); for (const f of fs as any[]) if (f.prototype) f.prototype.m = 1; check("its prototype property given to", fs, (fs as any[]).map(f => f.prototype ? new f(1).m : "-").join("|")) }
{ const fs = make(3); for (const f of fs as any[]) f.prototype = { z: 1 }; check("its prototype property stored to", fs, (fs as any[]).map(f => f.prototype.z + ":" + own(f)).join("|")) }
{ const fs = make(3); check("descriptors", fs, (fs as any[]).map(f => Object.keys(Object.getOwnPropertyDescriptors(f)).filter(k => !special.has(k)).length + ":" + String(Object.getOwnPropertyDescriptor(f, "a")) + String(Object.getOwnPropertyDescriptor(f, 0))).join("|")) }
{ const fs = make(3); check("has", fs, (fs as any[]).map(f => ("a" in f) + ":" + (0 in f) + ":" + Object.hasOwn(f, "a") + ":" + f.hasOwnProperty(3) + ":" + f.propertyIsEnumerable("a")).join("|")) }
{ const fs = make(3); check("reads of what is not there", fs, (fs as any[]).map(f => String(f.a) + String(f[0]) + String(f[sym]) + String(f[-1]) + String(f[1.5])).join("|")) }
{ const fs = make(3); check("as a callback", fs, fs.map(f => [1, 2, 3].map(f).join("") + Array.from({ length: 2 }, (_, i) => f(i)).join("")).join("|")) }
{ const fs = make(3); check("apply, call, Reflect.apply", fs, fs.map(f => "" + f.apply(null, [1]) + f.call(null, 2) + Reflect.apply(f, undefined, [3])).join("|")) }
{ const fs = make(3); const ps = fs.map(f => new Proxy(f, {})); check("behind a proxy", fs, ps.map(p => p(5) + ":" + typeof p).join("|")) }

// Many, some given storage, with collections while they are made.
{
    const kept: Array<(x: number) => number> = []
    let sum = 0
    for (let i = 0; i < 60000; i++) {
        const fs = make(i & 7)
        const f = fs[i & 3] as any
        if (i % 7 === 0) f.tag = i
        if (i % 11 === 0) f[i & 15] = i
        if (i % 13 === 0) Object.freeze(f)
        if (i % 97 === 0) kept.push(f)
        if (i % 20000 === 0) collect()
        sum += f(i & 31)
    }
    snapshot()
    collect()
    console.log(++row, "many", sum, kept.length, kept.reduce((a, f) => a + f(1) + ((f as any).tag ?? 0), 0))
}
snapshot()
console.log("done")
export {}
//// function-typed-member-not-callable.ts
// Members, elements, parameters and results of function types that hold no function are called: a TypeError wherever the call stands, also where it is the last thing its function does.
declare const console: any;
type Fn = (x: number, b?: number, c?: number, d?: number, e?: number, f?: number, g?: number, h?: number, i?: number) => number;
interface Holder { absent?: Fn; orUndefined: Fn | undefined; orNull: Fn | null; }
const inc: Fn = x => x + 1;
const twice: Fn = x => x * 2;
const proxied: Fn = new Proxy(inc, {});
const bound: Fn = inc.bind(null);
const revocable = Proxy.revocable(inc, {}); revocable.revoke(); const revoked: Fn = revocable.proxy;
const pair: [number, number] = [1, 2];
function read_absent(h: Holder): Fn | undefined { return h.absent; }
function read_orUndefined(h: Holder): Fn | undefined { return h.orUndefined; }
function read_orNull(h: Holder): Fn | null { return h.orNull; }
function r0(h: Holder, a: (Fn | undefined)[], p?: Fn) { const v = h.absent; return v!(1); }
function r1(h: Holder, a: (Fn | undefined)[], p?: Fn) { try { const v = h.absent; return v!(1); } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r2(h: Holder, a: (Fn | undefined)[], p?: Fn) { const v = h.absent; var r: number; r = v!(1); return r; }
function r3(h: Holder, a: (Fn | undefined)[], p?: Fn) { try { const v = h.absent; var r: number; r = v!(1); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r4(h: Holder, a: (Fn | undefined)[], p?: Fn) { return h.absent!(1); }
function r5(h: Holder, a: (Fn | undefined)[], p?: Fn) { try { return h.absent!(1); } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r6(h: Holder, a: (Fn | undefined)[], p?: Fn) { var r: number; r = h.absent!(1); return r; }
function r7(h: Holder, a: (Fn | undefined)[], p?: Fn) { try { var r: number; r = h.absent!(1); return r; } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r8(h: Holder, a: (Fn | undefined)[], p?: Fn) { return a[0]!(1); }
function r9(h: Holder, a: (Fn | undefined)[], p?: Fn) { try { return a[0]!(1); } catch (e) { return e instanceof TypeError ? -1 : -2; } }
function r10(h: Holder, a: (Fn | undefined)[], p?: Fn) { var r: number; r = a[0]!(1); return r; }
