//// library-methods-read-arguments-they-do-not-declare.js
// Methods of the library whose text reads an argument it does not declare (`thisArg`, `initialValue`, `mapFn`, `receiver`) or counts its arguments,
// called where the callee is known and where it is found by name at run time.
const unknown = new Function("value", "return value" + process.argv[0].slice(process.argv[0].length));
const lines = [];
const show = (label, value) => lines.push(label + ": " + (typeof value === "string" ? value : JSON.stringify(value)));

function describeThis() {
  "use strict";
  return this === undefined ? "undefined" : this === null ? "null" : typeof this === "object" ? "object " + this.tag : typeof this + " " + String(this);
}
function describeSloppyThis() {
  return this === globalThis ? "global" : typeof this === "object" ? "object " + (this.tag ?? String(this)) : typeof this;
}

const makeSloppy = new Function("seen", "describe", "return function (value) { seen.push(describe.call(this)); return value > 1; };");

const receiver = { tag: "receiver" };
const arrayMethods = ["every", "forEach", "filter", "map", "some", "find", "findLast", "findIndex", "findLastIndex", "flatMap"];

function callEach(label, list, pick) {
  for (const name of arrayMethods) {
    const seen = [];
    const strict = function (value) { "use strict"; seen.push(describeThis.call(this)); return value > 1; };
    const sloppy = makeSloppy(seen, describeSloppyThis);
    const method = pick(list, name);
    method.call(list, strict);
    method.call(list, strict, undefined);
    method.call(list, strict, null);
    method.call(list, strict, receiver);
    method.call(list, strict, 7);
    method.call(list, strict, receiver, "surplus", "more");
    method.call(list, sloppy);
    method.call(list, sloppy, undefined);
    method.call(list, sloppy, receiver);
    method.call(list, sloppy, "text");
    show(label + " " + name, [...new Set(seen)].join(" | ") + " (" + seen.length + ")");
  }
}
callEach("known", [1, 2], (list, name) => Array.prototype[name]);
callEach("by name", unknown([1, 2]), (list, name) => unknown(list)[name]);

function direct(list, callback, thisArg) {
  return [
    list.map(callback).join(), list.map(callback, thisArg).join(), list.map(callback, thisArg, 1, 2, 3).join(),
    list.filter(callback).length, list.filter(callback, thisArg).length,
    list.some(callback), list.some(callback, thisArg), list.every(callback), list.every(callback, thisArg),
    list.find(callback), list.find(callback, thisArg), list.findIndex(callback, thisArg), list.findLast(callback, thisArg), list.findLastIndex(callback, thisArg),
    list.flatMap(callback).join(), list.flatMap(callback, thisArg).join(),
  ];
}
const tagOrValue = function (value) { "use strict"; return this === undefined ? value : this.tag + value; };
show("direct, known", direct([1, 2, 3], tagOrValue, receiver));
show("direct, by name", direct(unknown([1, 2, 3]), unknown(tagOrValue), unknown(receiver)));

const add = (sum, value) => sum + "+" + value;
function reduceEach(label, list, empty) {
  show(label + " reduce", [list.reduce(add), list.reduce(add, undefined), list.reduce(add, "start"), list.reduce(add, "start", "surplus"), list.reduce(add, null)]);
  show(label + " reduceRight", [list.reduceRight(add), list.reduceRight(add, undefined), list.reduceRight(add, "start"), list.reduceRight(add, "start", "surplus")]);
  show(label + " empty with a value", [empty.reduce(add, undefined) === undefined, empty.reduceRight(add, undefined) === undefined, empty.reduce(add, 0), empty.reduceRight(add, null)]);
  for (const name of ["reduce", "reduceRight"]) {
    try {
      empty[name](add);
      show(label + " empty " + name, "no error");
    } catch (error) {
      show(label + " empty " + name, error.constructor.name + ": " + error.message);
    }
  }
}
reduceEach("known", [1, 2, 3], []);
reduceEach("by name", unknown([1, 2, 3]), unknown([]));

function collections(label, map, set) {
  const seen = [];
  const callback = function (value, key) { "use strict"; seen.push(describeThis.call(this) + " " + key + "=" + value); };
  map.forEach(callback);
  map.forEach(callback, undefined);
  map.forEach(callback, receiver);
  map.forEach(callback, receiver, "surplus");
  set.forEach(callback);
  set.forEach(callback, receiver);
  show(label + " collections", seen.join(" | "));
}
collections("known", new Map([["a", 1]]), new Set(["s"]));
collections("by name", unknown(new Map([["a", 1]])), unknown(new Set(["s"])));

function creators(label, arrayClass, typedClass) {
  const double = function (value, index) { "use strict"; return (this === undefined ? 0 : this.base) + value * 2 + index; };
  const base = { base: 100 };
  show(label + " Array.from", [arrayClass.from([1, 2]), arrayClass.from([1, 2], undefined), arrayClass.from([1, 2], double), arrayClass.from([1, 2], double, base), arrayClass.from([1, 2], double, base, "surplus"), arrayClass.from({ length: 2, 0: 5, 1: 6 }, double, base)]);
  show(label + " typed from", [[...typedClass.from([1, 2])], [...typedClass.from([1, 2], undefined)], [...typedClass.from([1, 2], double)], [...typedClass.from([1, 2], double, base)]]);
  for (const mapFn of [null, 1, "text", {}]) {
    try {
      arrayClass.from([1], mapFn);
      show(label + " Array.from with " + String(mapFn), "no error");
    } catch (error) {
      show(label + " Array.from with " + String(mapFn), error.constructor.name);
    }
  }
}
creators("known", Array, Int32Array);
creators("by name", unknown(Array), unknown(Int32Array));

function reflect(label, reflectObject) {
  const target = { get own() { return this === target ? "target" : this === undefined ? "undefined" : this === null ? "null" : this.tag; } };
  show(label + " Reflect.get", [reflectObject.get(target, "own"), reflectObject.get(target, "own", receiver), reflectObject.get(target, "own", receiver, "surplus")]);
  const strictTarget = Object.defineProperty({}, "own", { get() { "use strict"; return this === undefined ? "undefined" : this === strictTarget ? "target" : typeof this; } });
  show(label + " Reflect.get with undefined", [reflectObject.get(strictTarget, "own"), reflectObject.get(strictTarget, "own", undefined), reflectObject.get(strictTarget, "own", 5)]);
}
reflect("known", Reflect);
reflect("by name", unknown(Reflect));

function iterators(label, values) {
  show(label + " iterator reduce", [values().reduce(add), values().reduce(add, undefined), values().reduce(add, "start"), values().reduce(add, "start", "surplus")]);
  try {
    [].values().reduce(add);
  } catch (error) {
    show(label + " empty iterator reduce", error.constructor.name);
  }
  show(label + " empty iterator reduce with undefined", String([].values().reduce(add, undefined)));
}
iterators("known", () => [1, 2, 3].values());
iterators("by name", () => unknown([1, 2, 3].values()));

show("typed toLocaleString", [new Int32Array([1234, 5]).toLocaleString(), new Int32Array([1234, 5]).toLocaleString("de-DE"), new Float64Array([0.5]).toLocaleString("en-US", { style: "percent" }), unknown(new Float64Array([0.5])).toLocaleString("en-US", { style: "percent" })]);

const described = [
  [Array.prototype, arrayMethods.concat(["reduce", "reduceRight"])], [Array, ["from", "fromAsync"]], [Map.prototype, ["forEach"]], [Set.prototype, ["forEach"]],
  [Reflect, ["get"]], [Object.getPrototypeOf(Int32Array), ["from"]], [Object.getPrototypeOf(Int32Array.prototype), ["toLocaleString"]], [Iterator.prototype, ["reduce"]],
  [Function.prototype, ["call"]], [Promise, ["try"]],
];
for (const [holder, names] of described) {
  for (const name of names) {
    const method = unknown(holder)[name];
    const length = Object.getOwnPropertyDescriptor(method, "length");
    show("function " + method.name, [method.length, length.writable, length.enumerable, length.configurable, "prototype" in method, Object.getOwnPropertyNames(method).sort().join()]);
  }
}

class Tagged extends Array {
  static get [Symbol.species]() { lines.push("species read"); return Tagged; }
}
class Plain extends Array {
  static get [Symbol.species]() { return Array; }
}
function species(label, tagged, plain) {
  const mapped = tagged.map(tagOrValue, receiver);
  const filtered = tagged.filter(function () { "use strict"; return this === receiver; }, receiver);
  const flat = tagged.flatMap(tagOrValue, receiver);
  show(label + " species", [mapped instanceof Tagged, mapped.join(), filtered instanceof Tagged, filtered.length, flat instanceof Tagged, flat.join()]);
  const other = plain.map(tagOrValue, receiver);
  show(label + " species of Array", [other instanceof Plain, Array.isArray(other), other.join()]);
}
species("known", Tagged.from([1, 2]), Plain.from([1, 2]));
species("by name", unknown(Tagged.from([1, 2])), unknown(Plain.from([1, 2])));

const arrayLike = { length: 2, 0: "a", 1: "b" };
show("array-like", [Array.prototype.map.call(arrayLike, tagOrValue, receiver), Array.prototype.reduce.call(arrayLike, add), Array.prototype.reduce.call(unknown(arrayLike), add, undefined)]);
show("apply", [Array.prototype.map.apply([1], [tagOrValue, receiver]), Array.prototype.map.apply([1], [tagOrValue]), Array.prototype.reduce.apply([1, 2], [add, undefined]), Array.prototype.reduce.apply(unknown([1, 2]), unknown([add]))]);
show("spread", [[1].map(...[tagOrValue, receiver]), [1].map(...unknown([tagOrValue])), [1, 2].reduce(...unknown([add, undefined])), [1, 2].reduce(...unknown([add]))]);
show("bound", [Array.prototype.map.bind([1], tagOrValue, receiver)(), Array.prototype.map.bind([1], tagOrValue)(receiver), Array.prototype.reduce.bind([1, 2], add)(), Array.prototype.reduce.bind([1, 2], add)(undefined), Array.prototype.reduce.bind([1, 2], add, undefined)()]);
show("Function.prototype.call", [tagOrValue.call(receiver, 1), tagOrValue.call(undefined, 1), unknown(tagOrValue).call(receiver, 1, 2, 3), Function.prototype.call.call(tagOrValue, receiver, 4), Function.prototype.call.apply(tagOrValue, [receiver, 5])]);

Promise.try(function (...values) { return values.length + ":" + values.join(); }, 1, 2, 3)
  .then(value => show("Promise.try", value))
  .then(() => unknown(Promise).try(function () { return arguments.length; }))
  .then(value => show("Promise.try without arguments", value))
  .then(() => Array.fromAsync([1, 2], function (value) { "use strict"; return this.tag + value; }, receiver))
  .then(value => show("Array.fromAsync", value))
  .then(() => unknown(Array).fromAsync([1, 2]))
  .then(value => show("Array.fromAsync without a function", value))
  .then(() => console.log(lines.join("\n")));
//// lists-of-arguments-for-fixed-parameters.ts
// f(...list), f.apply(t, list), new C(...list) and super(...list) where no callee can count its arguments, beside the neighbors in which somebody can tell:
// a callee that reads arguments or collects the rest, a list with an accessor, a hole or a prototype of its own, a list that is shorter or longer than the parameters,
// a list too long for the stack.
const log: string[] = [];

function two(a?: unknown, b?: unknown): string {
  return `two(${String(a)}, ${String(b)})`;
}
function withDefault(a: unknown, b: unknown = "default"): string {
  return `withDefault(${String(a)}, ${String(b)})`;
}
function counts(this: unknown, _a?: unknown): string {
  return `counts(${arguments.length})`;
}
function collects(first?: unknown, ...others: unknown[]): string {
  return `collects(${String(first)}; ${others.join("|")})`;
}
function usesThis(this: { name: string }, a?: unknown): string {
  return `${this.name}(${String(a)})`;
}

function forward(...list: unknown[]): string {
  return two(...list);
}
function forwardToDefault(...list: unknown[]): string {
  return withDefault(...(list as [unknown, unknown]));
}
function forwardToCounting(...list: unknown[]): string {
  return counts(...list);
}
function forwardToCollecting(...list: unknown[]): string {
  return collects(...list);
}
function applies(self: { name: string }, list: unknown[]): string {
  return usesThis.apply(self, list as [unknown]);
}
function oneOfTwo(pick: boolean, list: unknown[]): string {
  const callee = pick ? two : withDefault;
  return callee(...(list as [unknown, unknown]));
}
function oneOfTwoMayCount(pick: boolean, list: unknown[]): string {
  const callee = pick ? two : counts;
  return callee(...list);
}

class Base {
  x: unknown;
  y: unknown;
  constructor(x?: unknown, y?: unknown) {
    this.x = x;
    this.y = y;
  }
  show(): string {
    return `${this.constructor.name}(${String(this.x)}, ${String(this.y)})`;
  }
}
class Implicit extends Base {}
class Forwards extends Base {
  extra: number;
  constructor(...list: unknown[]) {
    super(...list);
    this.extra = list.length;
  }
}
class CountingBase {
  count: number;
  constructor(..._list: unknown[]) {
    this.count = arguments.length;
  }
}
class ForwardsToCounting extends CountingBase {
  constructor(...list: unknown[]) {
    super(...list);
  }
}
class ForwardsOneList extends Base {
  constructor(list: unknown[]) {
    super(...list);
  }
}
function constructs(list: unknown[]): string {
  return new Base(...list).show();
}
function outcome(run: () => string): string {
  try {
    return run();
  } catch (error) {
    return (error as Error).name;
  }
}
function filled(length: number): unknown[] {
  return new Array(length).fill(7);
}

function listWithAccessor(): unknown[] {
  const list: unknown[] = [1, 2, 3];
  Object.defineProperty(list, 2, { get() { log.push("third element read"); return 3; } });
  return list;
}
function listWithHole(): unknown[] {
  // eslint-disable-next-line no-sparse-arrays
  return [, "after the hole"];
}
class OddList extends Array<unknown> {
  *[Symbol.iterator](): ArrayIterator<unknown> {
    log.push("own iterator");
    yield "from the iterator";
  }
}

const self = { name: "self" };
const three: unknown[] = [1, 2, 3];
for (let round = 0; round < 3; round++) {
  console.log(forward(), forward(1), forward(1, 2), forward(1, 2, 3), forward(undefined, null));
  console.log(forwardToDefault(1), forwardToDefault(1, undefined), forwardToDefault(1, 2, 3));
  console.log(forwardToCounting(), forwardToCounting(1, 2, 3));
  console.log(forwardToCollecting(), forwardToCollecting(1), forwardToCollecting(1, 2, 3));
  console.log(applies(self, []), applies(self, ["a"]), applies(self, ["a", "b"]));
  console.log(oneOfTwo(true, [1]), oneOfTwo(false, [1]), oneOfTwo(round === 1, [1, 2, 3]));
  console.log(oneOfTwoMayCount(true, [1, 2, 3]), oneOfTwoMayCount(false, [1, 2, 3]));
  console.log(new Implicit().show(), new Implicit(1).show(), new Implicit(...(three as [unknown, unknown])).show());
  console.log(new Forwards().show(), new Forwards(1, 2, 3).show(), new Forwards(1, 2, 3).extra);
  console.log(new ForwardsToCounting().count, new ForwardsToCounting(1, 2, 3).count);
  console.log(constructs([]), constructs([1]), constructs([1, 2, 3]));
  console.log(two(...listWithAccessor()), two.apply(null, listWithAccessor() as [unknown, unknown]), log.splice(0).join(","));
  console.log(two(...listWithHole()), two.apply(null, listWithHole() as [unknown, unknown]), constructs(listWithHole()));
  console.log(two(...new OddList(1, 2)), two.apply(null, new OddList(1, 2) as unknown as [unknown, unknown]), log.splice(0).join(","));
  for (const length of [1000, 65535, 65536, 700000, 2 ** 21]) {
    const list = filled(length);
    console.log(
      length,
      outcome(() => two(...list)),
      outcome(() => two.apply(null, list as [unknown, unknown])),
      outcome(() => constructs(list)),
      outcome(() => new ForwardsOneList(list).show()),
    );
  }
}
//// lists-that-the-call-stub-hands-to-native-code.js
// A call with a list that has holes, is long, or has another storage is made by native code. The callees are closures that nothing but calls uses.
function count() { return arguments.length; }
function last() { return arguments[arguments.length - 1]; }
function Counted() { this.count = arguments.length; }

for (const length of [6, 7, 4096, 4097, 10000]) {
  const list = Array.from({ length }, (unused, index) => index);
  console.log(length, count(...list), last.apply(null, list), (function () { return arguments.length; })(...list), new Counted(...list).count);
}

const holey = [1, , 3];
console.log(count(...holey), last.apply(null, holey), (function () { return arguments[1]; })(...holey), (() => 7)(...holey), new Counted(...holey).count);

const sparse = [];
sparse[5000] = "end";
console.log(count(...sparse), last.apply(null, sparse), (function (first) { return first; })(...sparse));

const withGetter = [1, 2];
Object.defineProperty(withGetter, 0, { get() { return "got"; } });
console.log(count(...withGetter), (function (first) { return first; }).apply(null, withGetter));

const doubles = [0.5, , 2.5];
console.log(last.apply(null, doubles), (function (a, b) { return b; })(...doubles));

function outer(list) {
  let captured = 10;
  const add = function () { return captured + arguments.length; };
  return add(...list) + add.apply(null, list);
}
console.log(outer(holey), outer(sparse));
//// literal-argument-identity-in-loop.ts
// An object literal that is passed to a typed parameter on every iteration of a loop stays one object: each call sees the stores of the call before it.
const opaque = new Function("value", "return value") as <T>(value: T) => T;
type Counter = { n: number };
const seen = new Set<unknown>();
function tick(counter: Counter): number {
  seen.add(counter);
  counter.n++;
  return counter.n;
}
function skip(counter: Counter): number {
  seen.add(counter);
  return -counter.n;
}
let predicted: (counter: Counter) => number = tick;
if (opaque(false)) predicted = skip;
function report(label: string, results: number[], last: number): void {
  console.log(label + ": " + results.join(" ") + ", last " + last + ", objects " + seen.size);
  seen.clear();
}
////= lines-10	predictedCallee	any	predicted	"predicted callee"
////= lines-10	knownCallee	any	tick	"known callee"
////= lines-10	typedLiteral	Counter	predicted	"typed literal"
function widerLiteral(): void {
  const literal = { n: 0, extra: "kept" };
  const results: number[] = [];
  for (let i = 0; i < 3; i++) results.push(predicted(literal));
  report("wider literal, " + literal.extra, results, literal.n);
}
function nestedLoops(): void {
  const results: number[] = [];
  let last = 0;
  for (let outer = 0; outer < 2; outer++) {
    const literal: any = { n: 10 * outer };
    for (let i = 0; i < 3; i++) results.push(predicted(literal));
    last = literal.n;
  }
  report("nested loops", results, last);
}
function whileLoop(): void {
  const literal: any = { n: 0 };
  const results: number[] = [];
  while (predicted(literal) < 3) results.push(literal.n);
  report("while loop", results, literal.n);
}
function literalPerIteration(): void {
  const results: number[] = [];
  for (let i = 0; i < 3; i++) results.push(predicted({ n: i }));
  report("a literal per iteration", results, -1);
}
const atTopLevel: any = { n: 0 };
const topLevelResults: number[] = [];
for (let i = 0; i < 3; i++) topLevelResults.push(predicted(atTopLevel));
report("top level", topLevelResults, atTopLevel.n);
for (let round = 0; round < 2; round++) {
  predictedCallee();
  knownCallee();
  typedLiteral();
  widerLiteral();
  nestedLoops();
  whileLoop();
  literalPerIteration();
}
//// literal-discriminant-cast-twice.ts
// A literal discriminant value goes through two casts before it is stored or compared. A cast is a test and never a conversion: the number 5 cast to boolean throws a TypeError, and 5 cast to the numeric enum passes.
declare const console: any;
function any(x: unknown): any { return x }
enum Kind { A = 1, B = 2, C = 5 }
interface Node { kind: Kind; pos: number }
interface NodeA extends Node { kind: Kind.A; a: number }
interface NodeB extends Node { kind: Kind.B; b: string }
interface NodeC extends Node { kind: Kind.C; x: number; y: number; z: number; text: string; more: number[] }
function NodeConstructor(this: Node, kind: Kind, pos: number) { this.kind = kind; this.pos = pos }
const constructorOfNodes = NodeConstructor as any as new (kind: Kind, pos: number) => Node;
function makeC(kind: Kind): NodeC { const n = new constructorOfNodes(kind, 7) as NodeC; n.x = 1; n.y = 2; n.z = 3; n.text = "text"; n.more = [4]; return n }
function makeA(kind: Kind): NodeA { const n = new constructorOfNodes(kind, 7) as NodeA; n.a = 1; return n }
function nameOf(n: Node): string { switch (n.kind) { case Kind.A: return "A " + (n as NodeA).a; case Kind.B: return "B " + (n as NodeB).b; case Kind.C: return "C " + (n as NodeC).x + (n as NodeC).text; default: return "none" } }
function isC(n: Node): n is NodeC { return n.kind === Kind.C }
function failure(e: unknown): string { return "throws " + (e as Error).constructor.name + ": " + (e as Error).message.split("\n")[0] }
function show(n: Node): string { return [JSON.stringify(n), Object.keys(n).join(), any(n).kind, n.kind, nameOf(n), isC(n), nameOf(any(n) as NodeA)].join(" ") }
const H: unknown[] = ((globalThis as any).H = [5, 1, 2]);
const kept: Node[] = [];
let r = "";
for (let turn = 0; turn < 3; turn++) {
  try { r = show(makeC(any(any(5) as boolean) as Kind)) } catch (e) { r = failure(e) } console.log("C of 5 cast to boolean and then to Kind, written: " + r);
  try { r = show(makeC(any(any(H[0]) as boolean) as Kind)) } catch (e) { r = failure(e) } console.log("C of 5 cast to boolean and then to Kind, hidden:  " + r);
  try { r = show(makeA(any(any(5) as boolean) as Kind)) } catch (e) { r = failure(e) } console.log("A of 5 cast to boolean and then to Kind, written: " + r);
  try { r = show(makeA(any(any(H[0]) as boolean) as Kind)) } catch (e) { r = failure(e) } console.log("A of 5 cast to boolean and then to Kind, hidden:  " + r);
  try { r = show(makeC(any(5) as Kind)) } catch (e) { r = failure(e) } console.log("C of 5, written: " + r);
  try { r = show(makeC(any(H[0]) as Kind)) } catch (e) { r = failure(e) } console.log("C of 5, hidden:  " + r);
  try { r = show(makeC(Kind.C)) } catch (e) { r = failure(e) } console.log("C of 5: " + r);
  for (let i = 0; i < 2000; i++) { try { kept.push(makeC(any(any(5) as boolean) as Kind)) } catch { } kept.push(makeA(Kind.A)) }
}
let sum = 0; for (const n of kept) sum += any(n).kind + n.pos + (any(n).x | 0) + (any(n).a | 0) + (any(n).more ? any(n).more[0] : 0);
console.log(kept.length, sum);
//// many-callbacks-of-different-lengths-outside-loops.js
// Array methods of the library are called outside loops with many different callbacks: some take the element alone, some the index too, some all three arguments, one reads `arguments`, one reads `this`.
// Each callback gets what the method passes, whichever copy of the method the call goes to.
const numbers = [1, 2, 3, 4];
const box = { bonus: 10 };

function mapped() {
    return [
        numbers.map(x => x + 1),
        numbers.map(x => x * 2),
        numbers.map(x => x - 3),
        numbers.map(x => x / 2),
        numbers.map(x => -x),
        numbers.map(x => x % 2),
        numbers.map((x, i) => x + i),
        numbers.map((x, i) => x * i),
        numbers.map((x, i, all) => x + i + all.length),
        numbers.map(function () { return arguments.length; }),
        numbers.map(function (x) { return x + this.bonus; }, box),
        numbers.map(() => 7),
    ];
}

function filtered() {
    return [
        numbers.filter(x => x > 1),
        numbers.filter(x => x > 2),
        numbers.filter(x => x < 3),
        numbers.filter(x => x % 2 === 0),
        numbers.filter(x => x !== 3),
        numbers.filter((x, i) => i > 0),
        numbers.filter((x, i, all) => i < all.length - 1),
        numbers.filter(function (x) { return x < this.bonus; }, box),
    ];
}

function flattened() {
    return [
        numbers.flatMap(x => [x]),
        numbers.flatMap(x => [x, x]),
        numbers.flatMap(x => x),
        numbers.flatMap(x => []),
        numbers.flatMap(x => [[x]]),
        numbers.flatMap((x, i) => [x, i]),
        numbers.flatMap((x, i, all) => [all.length]),
    ];
}

function reduced() {
    return [
        numbers.reduce((sum, x) => sum + x, 0),
        numbers.reduce((sum, x) => sum * x, 1),
        numbers.reduce((sum, x) => sum - x, 0),
        numbers.reduce((sum, x) => Math.max(sum, x), 0),
        numbers.reduce((sum, x) => Math.min(sum, x), 9),
        numbers.reduce((sum, x, i) => sum + x * i, 0),
        numbers.reduce((sum, x, i, all) => sum + all.length, 0),
        numbers.reduce(sum => sum + 1, 0),
    ];
}

function asked() {
    return [
        numbers.some(x => x > 3), numbers.some(x => x > 4), numbers.some(x => x < 0), numbers.some(x => x === 2), numbers.some(x => x === 9), numbers.some((x, i) => i === 3),
        numbers.every(x => x > 0), numbers.every(x => x > 1), numbers.every(x => x < 5), numbers.every(x => x !== 3), numbers.every(x => x === x), numbers.every((x, i) => i < 4),
        numbers.find(x => x > 1), numbers.find(x => x > 2), numbers.find(x => x > 3), numbers.find(x => x > 4), numbers.find(x => x < 2), numbers.find((x, i) => i === 2),
    ];
}

console.log(JSON.stringify(mapped()));
console.log(JSON.stringify(filtered()));
console.log(JSON.stringify(flattened()));
console.log(JSON.stringify(reduced()));
console.log(JSON.stringify(asked()));
