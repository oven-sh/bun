function asItsOwnValue(a: number): string { try { const o: { self: unknown; n: number } = { self: undefined, n: a }; o.self = o; O.freeze(o.self as { self: unknown; n: number }); o.n = a + 1; return "stored " + o.n; } catch (e) { return name(e); } }
