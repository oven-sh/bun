say("two of them", () => { const o = new J(1, 2); return [o.x, o.y, Object.getPrototypeOf(o) === J.prototype, take()]; });
say("three of them", () => { const o = new K(1, 2); return [o.x, o.y, Object.getPrototypeOf(o) === K.prototype, take()]; });
