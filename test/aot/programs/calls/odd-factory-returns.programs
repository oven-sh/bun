// The positions in a stack are the same however often, in whatever order and from however many places they are asked for.
function lines(stack: string | undefined): string {
  return (stack ?? "").split("\n").map(line => /(\d+):(\d+)\)?$/.exec(line)).filter(found => found !== null).slice(0, 3).map(found => found![1] + ":" + found![2]).join(" ");
}
function first(): string {
  return lines(new Error("first").stack);
}
function second(): string {
  const kept = new Error("second");
  return lines(kept.stack);
}
function both(flag: boolean): string {
  const a = new Error("a"); const b = new Error("b");
  return flag ? lines(a.stack) + " | " + lines(b.stack) : lines(b.stack) + " | " + lines(a.stack);
}
class Made {
  stack: string;
  constructor() {
    this.stack = lines(new Error("in a constructor").stack);
  }
}
function inlined(n: number): string {
  return n ? inlined(n - 1) : lines(new Error("deep").stack);
}
const many: Array<() => string> = [];
for (let i = 0; i < 40; i++) many.push(i % 2 ? () => lines(new Error("odd").stack) : () => lines(new RangeError("even").stack));
const seen = new Set<string>();
let last: string[] = [];
for (let round = 0; round < 60; round++) {
  last = [first(), second(), both(true), both(false), new Made().stack, inlined(3), ...many.map(make => make())];
  seen.add(last.join(" / "));
}
console.log("every round says the same:", seen.size === 1);
console.log("each has a position:", last.every(said => /^\d+:\d+/.test(said)));
console.log("different places, different positions:", new Set(last.slice(0, 6)).size, new Set(last.slice(6)).size);
const [a, b] = both(true).split(" | ");
const [c, d] = both(false).split(" | ");
console.log("whichever is asked first:", a === d, b === c, a !== b);
//// stack-shows-functions-that-only-take-a-literal-apart.js
// A function that only takes its argument apart is still in the stack that a getter, a trap or a failed read captures while it reads.
function names(error) {
  return String(error.stack).split("\n").slice(1).map(line => line.trim().split(" ")[1]).filter(name => /^[a-zA-Z]+$/.test(name)).join(" < ");
}
function sum(o) { return o.a + o.b; }
function first(o) { const a = o.a; return [a, o.b]; }
function nested(o) { return sum({ a: o.a, b: 1 }) + o.b; }
function attempt(label, run) {
  let result;
  try { result = "returned " + run(); } catch (error) { result = names(error); }
  console.log(label + ": " + result);
}
function main() {
  attempt("a getter, two reads", function direct() { return "" + sum({ get a() { throw new Error("read"); }, b: 2 }); });
  attempt("a getter, second read", function direct() { return "" + sum({ a: 1, get b() { throw new Error("read"); } }); });
  attempt("a getter, one read", function direct() { return "" + first({ get a() { throw new Error("read"); }, b: 2 }); });
  attempt("a getter, two levels", function direct() { return "" + nested({ get a() { throw new Error("read"); }, b: 2 }); });
  attempt("no getter", function direct() { return "" + sum({ a: 1, b: 2 }); });
  attempt("nothing to read from", function direct() { return "" + sum(undefined); });
  attempt("a trap", function direct() { return "" + sum(new Proxy({}, { get: function trap() { throw new Error("trap"); } })); });
}
main();
//// stack-through-proxy-and-callable-objects.ts
// Stacks taken under a Proxy, Reflect.apply and a bound function, and of calls that fail in tail position, list the compiled frames plain Bun lists.
function frames(stack: unknown): string {
  const list: string[] = [];
  for (const line of String(stack).split("\n")) {
    const frame = /\b(t_\w+) \(.*:(\d+:\d+)\)$/.exec(line);
    if (frame) list.push(frame[1] + ":" + frame[2]);
  }
  return list.join(" < ");
}

let captured: string = "-";
function t_trap(target: unknown, self: unknown, list: unknown[]): never {
  captured = frames(new Error("in the trap").stack);
  throw new RangeError("from the trap");
}
function t_target(): never {
  captured = frames(new Error("in the target").stack);
  throw new RangeError("from the target");
}

const trapped: any = new Proxy(t_target, { apply: t_trap });
const untrapped: any = new Proxy(t_target, {});
const boundTrapped: any = trapped.bind(undefined);
const boundTarget: any = t_target.bind(undefined);

function report(name: string, error: any): void {
  console.log(name + ": caught " + error.constructor.name + " " + error.message);
  console.log("  captured: " + captured);
  console.log("  thrown: " + frames(error.stack));
}
function t_callsProxy(): void {
  try { trapped(1); } catch (error: any) { report("proxy with a trap", error); }
}
function t_callsReflectApply(): void {
  try { Reflect.apply(trapped, undefined, [1]); } catch (error: any) { report("Reflect.apply", error); }
}
function t_callsBoundProxy(): void {
  try { boundTrapped(1); } catch (error: any) { report("bound proxy", error); }
}
function t_callsBoundFunction(): void {
  try { boundTarget(); } catch (error: any) { report("bound function", error); }
}
function t_callsProxyWithoutTrap(): void {
  try { untrapped(); } catch (error: any) { report("proxy without a trap", error); }
}
t_callsProxy();
t_callsReflectApply();
t_callsBoundProxy();
t_callsBoundFunction();
t_callsProxyWithoutTrap();

const revocable = Proxy.revocable(t_target, {});
const revoked: any = revocable.proxy;
revocable.revoke();
const notCallable: any = Date.now() > 0 ? { not: "callable" } : t_target;

function t_tailCallsRevoked(): unknown {
  return revoked();
}
function t_tailCallsNotCallable(): unknown {
  return notCallable();
}
function t_outer(callee: () => unknown): unknown[] {
  const result = callee();
  return [result];
}
for (const callee of [t_tailCallsRevoked, t_tailCallsNotCallable]) {
  try {
    t_outer(callee);
  } catch (error: any) {
    console.log(callee.name + ": " + error.constructor.name + " [" + frames(error.stack) + "]");
  }
}
//// stack-trace-thousands-of-frames.ts
// A stack trace of thousands of frames, with `Error.stackTraceLimit = Infinity`.
declare const console: { log(...args: unknown[]): void }
function names(e: unknown): string[] { return String((e as Error).stack).split("\n").map(l => /^(?:\s*at\s+)?(?:async\s+)?(?:([A-Za-z_$][\w$]*)(?: \(|@))?.*?:(\d+):\d+\)?$/.exec(l)).filter(m => m && m[1]).map(m => m![1]) }
function shape(e: unknown): string { const n = names(e); const downs = n.filter(x => x === "down").length; return n.length + " named frames; " + downs + " of down; the first " + n[0] + ", the last " + n[n.length - 1] }
let mode = 0
function bottom(): number { if (mode === 1) throw new Error("thrown"); kept = new Error("made"); return 0 }
let kept: Error | null = null
function down(d: number): number { if (d <= 0) return bottom() + 1; return down(d - 1) + 1 }
function top(d: number): number { return down(d) + 1 }
for (const limit of [Infinity, 100, 64, 65, 130, 1000]) {
    (Error as unknown as { stackTraceLimit: number }).stackTraceLimit = limit
    for (const d of [0, 1, 61, 62, 63, 64, 65, 66, 126, 127, 128, 129, 130, 500, 2000, 6000]) {
        mode = 0; top(d); const made = shape(kept)
        mode = 1; let caught = ""; try { top(d) } catch (e) { caught = shape(e) }
        console.log("the limit " + limit + ", the depth " + d + ": " + made + " | thrown: " + caught)
    }
}
//// stack-traces-name-no-function-of-the-prelude.ts
// Where the compiler puts a function of its own in the place of what the program wrote (a chain of array methods, Array.from({ length }, mapper), new Array(n).fill(v).map(mapper), JSON.stringify of a known shape),
// a stack trace that a callback makes names the program's functions and none of the compiler's. The built-ins' own frames are left out: a chain that is made one loop has none.
const names = (e: any) => String(e.stack).split("\n").slice(1).map((l: string) => l.trim().split(" ")[1].replace(/^.*[\\/]/, "")).filter((n: string) => !/^(map|filter|from|forEach|join|stringify|toJSON)$/.test(n)).join(" < ");
function thrower(): number { throw new Error("x"); }
function chain() { try { return [1, 2].map(thrower).join(","); } catch (e) { return names(e); } }
function chain2() { try { return [1, 2].filter(() => true).map(thrower).length; } catch (e) { return names(e); } }
function from(n: number) { try { return Array.from({ length: n }, thrower); } catch (e) { return names(e); } }
function filled(n: number) { try { return new Array(n).fill(0).map(thrower); } catch (e) { return names(e); } }
function json(o: { a: { toJSON(): number } }) { try { return JSON.stringify(o); } catch (e) { return names(e); } }
console.log(chain()); console.log(chain2()); console.log(from(2)); console.log(filled(2)); console.log(json({ a: { toJSON: thrower } }));
//// stacks-from-callbacks.ts
// Stack traces taken inside callbacks that built-in functions call.
declare const console: any;
const names = (e: Error): string => String(e.stack).split("\n").map(l => l.replace(/^\s*at /, "").replace(/[@ (].*$/, "")).filter(n => n !== "" && n !== "Error").join(" < ");
let seen: string[] = [];
function note(): number { if (seen.length < 1) seen.push(names(new Error("here"))); return 0; }
function show(label: string, f: () => unknown): void { seen = []; try { f(); } catch (e: any) { seen.push("thrown: " + names(e)); } console.log(label + ": " + seen.join(" | ")); }
function comparator(a: number, b: number): number { note(); return a - b; }
function visitor(v: number): void { note(); }
function replacer(s: string): string { note(); return s; }
function thrower(a: number, b: number): number { throw new RangeError("from the callback"); }
class Box { get value(): number { return note(); } toString(): string { note(); return "box"; } toJSON(): number { return note(); } }
function outer(f: () => unknown): unknown { return f(); }
show("sort", () => outer(() => [3, 1, 2].sort(comparator)));
show("toSorted", () => outer(() => [3, 1, 2].toSorted(comparator)));
show("typed array sort", () => outer(() => new Int32Array([3, 1, 2]).sort(comparator)));
show("typed array forEach", () => outer(() => new Float64Array([3, 1, 2]).forEach(visitor)));
show("typed array map", () => outer(() => new Float64Array([3, 1, 2]).map(v => note())));
show("replace", () => outer(() => "abc".replace(/b/g, replacer)));
show("replace string", () => outer(() => "abc".replace("b", replacer)));
show("getter", () => outer(() => Reflect.get(new Box(), "value")));
show("toString", () => outer(() => [new Box()].join()));
show("toJSON", () => outer(() => JSON.stringify([new Box()])));
show("reviver", () => outer(() => JSON.parse("[1]", (k: string, v: unknown): unknown => { note(); return v; })));
show("proxy", () => outer(() => new Proxy(comparator, {})(1, 2)));
show("bound", () => outer(() => [2, 1].sort(comparator.bind(null))));
show("set-like", () => outer(() => (new Set([1]) as any).isSubsetOf({ size: 1, has(v: number): boolean { note(); return true; }, keys() { return [1][Symbol.iterator](); } })));
show("iterator", () => outer(() => new Set({ [Symbol.iterator]() { return { next(): { done: boolean; value: number } { note(); return { done: true, value: 0 }; } }; } })));
show("thrown from sort", () => outer(() => [3, 1, 2].sort(thrower)));
show("thrown from a typed array", () => outer(() => new Int32Array([3, 1, 2]).sort(thrower)));
show("nested", () => outer(() => [2, 1].sort((a, b) => { [4, 3].sort(comparator); return a - b; })));
Promise.resolve(1).then(function reaction(v: number): void { seen = []; note(); console.log("reaction: " + seen.join()); });
export {};
//// store-stopped-above-the-object-sloppy/main.cjs
// A sloppy store under a name that the object inherits as a getter without a setter, or as a read-only property, does nothing: the object gets no property of its own.
function GetterAbove() {
  this.count = 10;
  this.run = 5;
}
Object.defineProperty(GetterAbove.prototype, "run", {
  get() {
    return "getter " + this.count;
  },
});
console.log("getter above:", new GetterAbove().run, Object.hasOwn(new GetterAbove(), "run"), Object.keys(new GetterAbove()).join());

function FrozenAbove() {
  this.run = 5;
  this.count = 11;
}
FrozenAbove.prototype.run = function () {
  return "method " + this.count;
};
console.log("before the freeze:", new FrozenAbove().run, Object.hasOwn(new FrozenAbove(), "run"));
Object.freeze(FrozenAbove.prototype);
console.log("frozen above:", new FrozenAbove().run(), Object.hasOwn(new FrozenAbove(), "run"), Object.keys(new FrozenAbove()).join());

function ReadOnlyAbove() {
  this.run = 5;
}
Object.defineProperty(ReadOnlyAbove.prototype, "run", { value: "read-only", writable: false });
console.log("read-only above:", new ReadOnlyAbove().run, Object.hasOwn(new ReadOnlyAbove(), "run"));

function MethodAbove() {
  this.run = 5;
}
MethodAbove.prototype.run = function () {};
console.log("method above:", new MethodAbove().run, Object.hasOwn(new MethodAbove(), "run"));
//// super-calls-into-declared-classes/main.ts
// `super(..)` calls into declared classes: `new.target`, `Reflect.construct`, a parent class that changes, constructors that return objects or throw.
import "./untyped.js";
