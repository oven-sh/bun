//// stack-overflow-and-tail-calls-through-closures-of-one-function-type.ts
// Six and more arrows of one function type reach one call site, so the site calls through the address in the closure.
// Recursion without end through such calls ends in a RangeError that can be caught, as often as it is tried, whatever the arrows do around the call.
// A long chain of tail calls through them needs no stack.
type Step = (n: number) => number;

let deepest = 0;
const grow: Step[] = [];
function next(n: number): number {
  return grow[n % grow.length](n + 1);
}
grow.push((n: number): number => { deepest = n; return next(n) + 1; });
grow.push((n: number): number => { deepest = n; return (next(n) ^ 1) | 0; });
grow.push((n: number): number => { deepest = n; const r = next(n); return r - 1; });
grow.push((n: number): number => { deepest = n; return 2 + next(n); });
grow.push((n: number): number => { deepest = n; return Math.max(next(n), 0); });
grow.push((n: number): number => { deepest = n; return next(n) * 1; });
grow.push((n: number): number => { deepest = n; return -next(n); });

function overflow(): string {
  deepest = 0;
  try {
    return "returned " + next(0);
  } catch (error) {
    return (error instanceof RangeError ? "RangeError" : "other " + error) + " " + (deepest > 1000);
  }
}
console.log("first", overflow());
console.log("again", overflow());
console.log("a third time", overflow());

// The arrows themselves need no frame on the way down: all they do is test and call on.
const thin: Step[] = [];
function on(n: number): number {
  return 1 + thin[n % thin.length](n + 1);
}
thin.push((n: number): number => on(n));
thin.push((n: number): number => on(n + 0));
thin.push((n: number): number => on(n | 0));
thin.push((n: number): number => on(n ^ 0));
thin.push((n: number): number => on(n - 0));
thin.push((n: number): number => on(n * 1));
function thinOverflow(): string {
  try {
    return "returned " + on(0);
  } catch (error) {
    return error instanceof RangeError ? "RangeError" : "other " + error;
  }
}
console.log("thin arrows", thinOverflow(), thinOverflow());

// Tail calls only: three million steps.
const chain: Step[] = [];
function hop(n: number): number {
  return chain[n % chain.length](n + 1);
}
chain.push((n: number): number => (n > 3000000 ? n : hop(n)));
chain.push((n: number): number => (n > 3000001 ? n : hop(n)));
chain.push((n: number): number => (n > 3000002 ? n : hop(n)));
chain.push((n: number): number => (n > 3000003 ? n : hop(n)));
chain.push((n: number): number => (n > 3000004 ? n : hop(n)));
chain.push((n: number): number => (n > 3000005 ? n : hop(n)));
console.log("tail calls", hop(0));

// An argument that fails the test at the head of an arrow takes the other version, down to the same end.
const loose: Step[] = grow;
function overflowWithFractions(): string {
  try {
    return "returned " + loose[0](0.5);
  } catch (error) {
    return error instanceof RangeError || error instanceof TypeError ? error.name : "other " + error;
  }
}
console.log("a fraction", overflowWithFractions());

// Overflow in the middle of other work leaves the program usable.
let sum = 0;
for (let i = 0; i < 5; i++) {
  overflow();
  sum += chain[i % chain.length](3000000 + i);
}
console.log("after five more", sum);
//// stack-overflow-at-every-entry.js
let limit = Infinity;

function direct(depth) {
  return depth >= limit ? 0 : depth + direct(depth + 1);
}

function createClosure() {
  const closure = depth => (depth >= limit ? 0 : depth + closure(depth + 1));
  return closure;
}

const methodTarget = {
  sum(depth) {
    return depth >= limit ? 0 : depth + this.sum(depth + 1);
  },
};

const getterTarget = {
  depth: 0,
  get sum() {
    const depth = this.depth;
    if (depth >= limit) return 0;
    this.depth = depth + 1;
    return depth + this.sum;
  },
};

function throughGetter() {
  getterTarget.depth = 0;
  return getterTarget.sum;
}

function throughMap(depth) {
  return depth >= limit ? 0 : [depth].map(value => value + throughMap(value + 1))[0];
}

class Chain {
  constructor(depth) {
    this.sum = depth >= limit ? 0 : depth + new Chain(depth + 1).sum;
  }
}

async function throughAsync(depth) {
  return depth >= limit ? 0 : depth + (await throughAsync(depth + 1));
}

async function check(name, run) {
  limit = Infinity;
  try {
    console.log(name, "returned", await run());
  } catch (error) {
    console.log(name, error.name);
  }
  limit = 3;
  console.log(name, "depth 3:", await run());
  limit = 1000;
  console.log(name, "depth 1000:", await run());
}

async function main() {
  const closure = createClosure();
  await check("direct", () => direct(0));
  await check("closure", () => closure(0));
  await check("method", () => methodTarget.sum(0));
  await check("getter", throughGetter);
  await check("map", () => throughMap(0));
  await check("new", () => new Chain(0).sum);
  await check("async", () => throughAsync(0));
}

main();
//// stack-overflow-in-rings-closed-through-the-tests-at-an-entrance.ts
// Recursion that never ends has to end in a RangeError that can be caught where the ring is closed through the tests in front of a typed function:
// the arguments come out of arrays, fields and values of type any, so no caller has proven them; some of them fit the declared types and some never do.
interface Item { kind: number; next: Item | undefined; items: Item[] }
let entered = 0
////= attempt
// The arrays are made where nobody sees what goes into them, so what is read out of them is an Item by its declared type alone.
const ring: Item = { kind: 1, next: undefined, items: JSON.parse("[]") }
const other: Item = { kind: 2, next: undefined, items: JSON.parse("[]") }
ring.items.push(other)
other.items.push(ring)
ring.next = ring.items[0]
other.next = other.items[0]
const outside: any = JSON.parse('{ "kind": "a text", "next": null, "items": [] }')
outside.next = outside
outside.items.push(outside)

function throughElements(item: Item): number { entered++; return item.kind + throughElements(item.items[0]) }
function throughFields(item: Item, depth: number): number { entered++; return depth + throughFields(item.next!, depth + 1) }
function small(item: Item): number { return middle(item.items[0], item.kind) + 1 }
function middle(item: Item, kind: number): number { entered++; return kind & 1 ? large(item.next!, item, kind) + 1 : large(item, item.next!, kind + 1) + 2 }
function large(a: Item, b: Item, kind: number): number {
  let sum = 0
  for (let i = 0; i < 3; i++) sum += (a.kind * i) ^ (b.kind + i) ^ (kind - i)
  if (sum === -1) return a.kind * b.kind
  return small(a.items[0]) + sum
}
function onlyHandsOn(item: Item): number { return readsIt(item) }
function readsIt(item: Item): number { entered++; return item.kind + onlyHandsOn(item.items[0]) }
function optional(item?: Item): number { entered++; return item ? optional(item.next) + 1 : 0 }
function throughAny(item: Item): number { entered++; const next: any = item.next; return throughAny(next) + 1 }
function neverFits(item: Item): number { entered++; return neverFits(item.next!) + 1 }
function fitsEverySecondTime(item: Item, turn: number): number { entered++; return fitsEverySecondTime(turn & 1 ? outside : ring, turn + 1) + 1 }
function level1(item: Item): number { return level2(item.items[0]) + 1 } function level2(item: Item): number { return level3(item.items[0]) + 1 }
function level3(item: Item): number { return level4(item.items[0]) + 1 } function level4(item: Item): number { return level5(item.items[0]) + 1 }
function level5(item: Item): number { return level6(item.items[0]) + 1 } function level6(item: Item): number { return level7(item.items[0]) + 1 }
function level7(item: Item): number { return level8(item.items[0]) + 1 } function level8(item: Item): number { return level9(item.items[0]) + 1 }
function level9(item: Item): number { return level10(item.items[0]) + 1 } function level10(item: Item): number { return level11(item.items[0]) + 1 }
function level11(item: Item): number { return level12(item.items[0]) + 1 } function level12(item: Item): number { entered++; return level1(item.items[0]) + item.kind }
class Walker {
  enter(item: Item): number { entered++; return this.visit(item.items[0]) + 1 }
  visit(item: Item): number { return item.next ? this.enter(item.next) : 0 }
}

attempt("elements of an array", () => throughElements(ring))
attempt("fields", () => throughFields(ring, 0))
attempt("small, middle, large", () => small(ring))
attempt("entered at the large one", () => large(ring, other, 1))
attempt("one only hands its argument on", () => onlyHandsOn(ring))
attempt("an optional parameter", () => optional(ring))
attempt("a value of type any", () => throughAny(ring))
attempt("arguments that never fit", () => neverFits(outside))
attempt("arguments that fit every second time", () => fitsEverySecondTime(ring, 0))
attempt("twelve functions in a row", () => level1(ring))
attempt("methods", () => new Walker().enter(ring))
for (let round = 0; round < 3; round++) attempt("again, round " + round, () => small(other) + level1(other))
//// stack-overflow-in-rings-closed-through-values-accessors-and-the-host.ts
// A ring of calls that is closed only by a way in that is no direct call: a function held in a value, an accessor, a constructor in a variable, a bound function, a callback
// that a built-in function calls. Each ends in a RangeError that can be caught, with deep chains of small functions between two such entries, and the program goes on.
let entered = 0
////= attempt
type Step = (n: number) => number
const launder = new Function("v", "return v") as <V>(v: V) => V

function d1(n: number, f: Step): number { return d2(n + 1, f) + 1 } function d2(n: number, f: Step): number { return d3(n + 1, f) + 1 }
function d3(n: number, f: Step): number { return d4(n + 1, f) + 1 } function d4(n: number, f: Step): number { return d5(n + 1, f) + 1 }
function d5(n: number, f: Step): number { return d6(n + 1, f) + 1 } function d6(n: number, f: Step): number { return d7(n + 1, f) + 1 }
function d7(n: number, f: Step): number { entered++; return f(n + 1) + 1 }

const holder: { step: Step } = { step: n => n }
function throughField(n: number): number { return d1(n, holder.step) }
holder.step = throughField

const steps: Step[] = []
function throughArray(n: number): number { return d1(n, steps[n & 1]) }
steps.push(throughArray, n => throughArray(n + 1))

const unseen: { step: Step } = launder({ step: (n: number) => n })
function throughUnseen(n: number): number { return d1(n, unseen.step) }
unseen.step = throughUnseen

class Lazy {
  depth = 0
  get next(): number { entered++; this.depth++; return d1(this.depth, () => this.next) }
  set deeper(n: number) { entered++; d1(n, m => { this.deeper = m; return m }) }
}

class Nested {
  inner: Nested | undefined
  constructor(n: number) { entered++; this.inner = d1(n, m => new made(m).inner ? 1 : 0) ? undefined : undefined }
}
const made: typeof Nested = launder(Nested)

const target = { base: 1, run(n: number): number { return d1(n + this.base, bound) } }
const bound: Step = target.run.bind(target)

function throughMap(n: number): number { return d1(n, m => [m].map(throughMap)[0]) }
function throughSort(n: number): number { return d1(n, m => [m, m + 1].sort((a, b) => throughSort(a + b))[0]) }
function throughReplace(n: number): number { return d1(n, m => "x".replace("x", () => String(throughReplace(m))).length) }
function throughApply(n: number): number { return d1(n, m => Reflect.apply(throughApply, undefined, [m])) }
function throughCall(n: number): number { return d1(n, m => throughCall.call(undefined, m)) }
function throughToString(n: number): number { return d1(n, m => `${{ toString() { return String(throughToString(m)) } }}`.length) }
function throughProxy(n: number): number { return d1(n, m => proxied(m)) }
const proxied: Step = new Proxy(throughProxy, {})
function* values(n: number): Generator<number> { yield d1(n, m => [...values(m)][0]) }

attempt("a function in a field", () => throughField(0))
attempt("functions in an array", () => throughArray(0))
attempt("a function in an object that unseen code has had", () => throughUnseen(0))
attempt("a getter", () => new Lazy().next)
attempt("a setter", () => { new Lazy().deeper = 1; return 0 })
attempt("a constructor in a variable", () => new made(0).inner ? 1 : 0)
attempt("a bound function", () => bound(0))
attempt("Array.prototype.map", () => throughMap(0))
attempt("Array.prototype.sort", () => throughSort(0))
attempt("String.prototype.replace", () => throughReplace(0))
attempt("Reflect.apply", () => throughApply(0))
attempt("Function.prototype.call", () => throughCall(0))
attempt("toString", () => throughToString(0))
attempt("a proxy", () => throughProxy(0))
attempt("a generator", () => [...values(0)][0])

function nearTheEnd(n: number, f: Step): number {
