for (let i = 0; i < 20000; i++) { s += toInt32(r, i & 1 ? 1e300 : i, i & 2 ? NaN : -i) + elsewhere(r, i & 4 ? big : u) + toNumber(r, i & 8 ? "5" : 5, i) + arithmetic(r, i, 2) + integersOnly(r, i & 16 ? big : u, i & 32 ? big : r); }
log.push(s);
