//// parameters-left-in-frame.ts
type Point = { x: number; y: number; label: string };

function point(x: number, y: number, label: string): Point {
    return { x, y, label };
}

function show(p: Point): string {
    return p.label + "(" + p.x + "," + p.y + ")";
}

function twoWait(a: Point, b: Point): string {
    const first = show(a);
    const second = show(b);
    return first + second + show(a) + show(b);
}

function sixWait(a: Point, b: Point, c: Point, d: Point, e: Point, f: Point): string {
    let text = show(f);
    text += show(e);
    text += show(d);
    text += show(c);
    text += show(b);
    text += show(a);
    return text + show(a) + show(f);
}

function eightWait(a: Point, b: Point, c: Point, d: Point, e: Point, f: Point, g: Point, h: Point): string {
    const head = show(h) + show(g);
    return head + show(a) + show(b) + show(c) + show(d) + show(e) + show(f) + show(g) + show(h);
}

function changedBeforeTheCall(a: Point, b: Point, swap: boolean): string {
    if (swap) {
        const held = a;
        a = b;
        b = held;
    }
    const first = show(a);
    return first + show(b) + show(a);
}

function changedAtOnce(a: Point, b: Point): string {
    a = b;
    const first = show(a);
    return first + show(b) + show(a);
}

function numbersWait(x: number, y: number, p: Point, count: number): string {
    let text = show(p);
    for (let i = 0; i < count; i++)
        text += show(point(x + i, y - i, p.label));
    return text + x + "/" + y + "/" + count;
}

function withDefaults(a: Point, b: Point = point(7, 8, "default"), c?: Point): string {
    const first = show(a);
    return first + show(b) + (c ? show(c) : "none") + show(a);
}

function loopsFromItsStart(p: Point, n: number): number {
    let sum = 0;
    while (n > 0) {
        sum += show(p).length;
        n--;
    }
    return sum;
}

class Holder {
    constructor(public inner: Point) {}
    join(a: Point, b: Point): string {
        const first = show(this.inner);
        return first + show(a) + show(b) + show(this.inner);
    }
}

function untypedLike(a: any, b: any, c: any): string {
    const first = String(a.label);
    const second = String(b.label);
    return first + second + String(c.label) + a.x + b.y + c.x;
}

function recursion(a: Point, b: Point, depth: number): string {
    if (!depth)
        return show(a);
    const below = recursion(b, a, depth - 1);
    return show(a) + below + show(b) + depth;
}

function throwsLate(a: Point, b: Point): string {
    const first = show(a);
    if (b.x < 0)
        throw new Error(first + show(b));
    return first + show(b);
}

const p = [0, 1, 2, 3, 4, 5, 6, 7].map(i => point(i, i * i, "p" + i));
console.log(twoWait(p[0], p[1]));
console.log(sixWait(p[0], p[1], p[2], p[3], p[4], p[5]));
console.log(eightWait(p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]));
console.log(changedBeforeTheCall(p[1], p[2], true), changedBeforeTheCall(p[1], p[2], false), changedAtOnce(p[3], p[4]));
console.log(numbersWait(1.5, 2.5, p[5], 3));
console.log(withDefaults(p[1]), withDefaults(p[1], p[2]), withDefaults(p[1], undefined, p[3]));
console.log(loopsFromItsStart(p[6], 4), new Holder(p[7]).join(p[0], p[1]));
console.log(untypedLike(p[1], p[2], p[3]), recursion(p[4], p[5], 5));
try {
    console.log(throwsLate(p[1], point(-1, 0, "negative")));
} catch (error) {
    console.log("caught", (error as Error).message);
}
//// plain-data-parameter-any-argument.ts
// An argument is held to the type that is written for its parameter, whatever kind of expression it is; a literal with an `any` in it for a parameter whose type is inferred is not.
interface Point { x: number; y: number; label?: string }
type Shape = { kind: "circle"; at: Point; r: number } | { kind: "box"; at: Point; w: number; h: number } | { kind: "dot"; at: Point };
function area(shape: Shape): number {
  switch (shape.kind) {
    case "circle": return Math.round(shape.r * shape.r * 3);
    case "box": return shape.w * shape.h;
    default: return 0;
  }
}
function far(point: Point): number { return point.x + point.y + (point.label ? point.label.length : 0); }
function total(points: Point[]): number { let sum = 0; for (const point of points) sum += far(point); return sum; }
function same<T extends { at: Point }>(it: T, other: T): boolean { return it.at.x === other.at.x && it.at.y === other.at.y; }
const parsed: any = JSON.parse('{"x":3,"y":4,"label":"ab"}');
const held: Point = { x: 1, y: 2 };
function make(n: number): Point { return { x: n, y: n * 2 }; }
const shapes: Shape[] = [{ kind: "circle", at: held, r: 2 }, { kind: "box", at: make(1), w: 2, h: 3 }, { kind: "dot", at: { x: 0, y: 0 } }];
let sum = 0;
for (const shape of shapes) sum += area(shape);
sum += far(held) + far(make(5)) + far(parsed) + far({ x: 7, y: 8 }) + far(shapes[1].at) + far(held.x > 0 ? held : make(2)) + far(parsed as Point);
sum += total([held, make(2), parsed, { x: 1, y: 1, label: "abc" }]) + total(shapes.map(shape => shape.at));
console.log(sum, same({ at: held }, { at: parsed }), same({ at: make(3) }, { at: { x: 3, y: 6 } }), area({ kind: "box", at: parsed, w: 4, h: 5 }));
//// plain-functions-are-bound-to-objects-again-and-again.js
// Binds of plain functions that the compiler sees, with objects, a number and a function bound; some of the bound functions are constructed now and then.
const N = 20000, kept = [];
const only = process.env.WAYS_ONLY;
function readsTwo(a, b) { return a.v + b.v; }
function readsThree(a, b, c) { return a.v + b.v + c.v; }
function readsFive(a, b, c, d, e) { return a.v + b.v + c.v + d.v + (e ? e.v : 0); }
function sometimesConstructed(a, b) { if (new.target) { this.sum = a.v + b.v; return; } return a.v + b.v; }
function Holder(a, b) { this.a = a; this.b = b; }
function takesNumber(a, n) { return a.v + n; }
function takesCallback(a, f) { return f(a); }
const ways = {
  oneObject: o => readsTwo.bind(null, o),
  threeObjects: o => readsThree.bind(null, o, o, o),
  fourObjects: o => readsFive.bind(null, o, o, o, o),
  constructedNowAndThen: o => sometimesConstructed.bind(null, o),
  constructorFunction: o => Holder.bind(null, o),
  objectAndNumber: (o, i) => takesNumber.bind(null, o, i),
  objectAndFunction: o => takesCallback.bind(null, o, x => x.v),
};
let sum = 0;
for (const name in ways) {
  if (only && only !== name) continue;
  const way = ways[name];
  for (let i = 0; i < N; i++) {
    const o = { v: i };
