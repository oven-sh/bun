//// proxy-apply-trap.js
// Calling a Proxy: an own apply trap on a plain handler, and every handler that must take the generic call.
////= errorName

function target(...args) {
  return `target(${args.join(", ")})`;
}

const ownTrap = new Proxy(target, {
  apply(callee, thisValue, args) {
    console.log("own trap", callee === target, thisValue === undefined, Array.isArray(args), args.length);
    return "trapped " + Reflect.apply(callee, thisValue, args);
  },
});
console.log(ownTrap(1, 2));
console.log(ownTrap());

const holder = { ownTrap };
const receivers = [];
const receiverTrap = new Proxy(target, {
  apply(callee, thisValue) {
    receivers.push(thisValue);
    return receivers.length;
  },
});
holder.receiverTrap = receiverTrap;
console.log(holder.receiverTrap(), receivers[0] === holder);
console.log(receiverTrap.call(7), receivers[1] === 7);

const { proxy: revoked, revoke } = Proxy.revocable(target, {
  apply() {
    return "never";
  },
});
console.log("before revoke:", revoked());
revoke();
console.log("revoked:", errorName(() => revoked(1)));

const handlerProxy = new Proxy(target, new Proxy({
  apply() {
    return "trap of a proxy handler";
  },
}, {
  get(handler, key) {
    console.log("handler get", String(key));
    return handler[key];
  },
}));
console.log(handlerProxy(1));

const getterTrap = new Proxy(target, {
  get apply() {
    console.log("apply getter");
    return () => "trap from a getter";
  },
});
console.log(getterTrap(1));

console.log("number trap:", errorName(() => new Proxy(target, { apply: 5 })(1)));
console.log("null trap:", new Proxy(target, { apply: null })(1));

const inherited = new Proxy(target, Object.create({
  apply() {
    return "inherited trap";
  },
}));
console.log(inherited(1));

console.log("no trap:", new Proxy(target, {})(1, 2));
console.log("not callable:", errorName(() => new Proxy({}, { apply: () => "never" })()));
console.log("plain call:", target(1, 2));
//// rare-path-calls-keep-registers.ts
// A hot loop keeps ten numbers live across a path taken every 1,000th turn, which calls functions, allocates and calls Math.random.
////= lines-16	Sample	turn	total	number

let rareTurns = 0;
let randomsOutOfRange = 0;
let samples: Sample[] = [];

function countRareTurn(): void {
  rareTurns++;
}
function newestSample(): Sample | undefined {
  return samples[samples.length - 1];
}
function addSample(turn: number, total: number): void {
  samples.push({ turn, total });
}

function sumWithRarePath(turns: number): number {
  let a = 1, b = 2, c = 3, d = 4, e = 5, v = 0.5, w = 1.5, x = 2.5, y = 3.5, z = 4.5;
  for (let turn = 0; turn < turns; turn++) {
    a = (a + turn) | 0;
    b = ((b ^ a) + 3) | 0;
    c = (c + (b & 255)) | 0;
    d = (d * 31 + c) | 0;
    e = (e + (d >>> 28)) | 0;
    v += 0.5;
    w += v * 0.25;
    x = x * 0.999 + w * 0.001;
    y += (a & 7) * 0.125;
    z = z * 0.5 + y;
    if (turn % 1000 === 999) {
      countRareTurn();
      addSample(turn, a + v);
      const pair = [newestSample(), { turn, total: e + z }];
      if (pair[0] === pair[1] || pair[0]!.turn !== pair[1]!.turn) throw new Error("wrong sample at turn " + turn);
      const random = Math.random();
      if (!(random >= 0 && random < 1)) randomsOutOfRange++;
    }
  }
  return a + b + c + d + e + v + w + x + y + z;
}

function sumWithoutRarePath(turns: number): number {
  let a = 1, b = 2, c = 3, d = 4, e = 5, v = 0.5, w = 1.5, x = 2.5, y = 3.5, z = 4.5;
  for (let turn = 0; turn < turns; turn++) {
    a = (a + turn) | 0;
    b = ((b ^ a) + 3) | 0;
    c = (c + (b & 255)) | 0;
    d = (d * 31 + c) | 0;
    e = (e + (d >>> 28)) | 0;
    v += 0.5;
    w += v * 0.25;
    x = x * 0.999 + w * 0.001;
    y += (a & 7) * 0.125;
    z = z * 0.5 + y;
  }
  return a + b + c + d + e + v + w + x + y + z;
}

// 999 turns never reach the rare path, 1,000 reach it in the last turn.
for (const turns of [0, 999, 1000, 1001, 250_000, 1_000_000]) {
  rareTurns = 0;
  samples = [];
  const sum = sumWithRarePath(turns);
  const expected = sumWithoutRarePath(turns);
  let sampleTotal = 0;
  for (const sample of samples) sampleTotal += sample.total + sample.turn;
  console.log(turns, sum === expected ? "equal" : "different", sum, expected, rareTurns, samples.length, sampleTotal);
}
console.log("randoms out of range:", randomsOutOfRange);
export {};
