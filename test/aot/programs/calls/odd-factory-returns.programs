const things: [string, any][] = [["empty", []], ["one", [1]], ["eight", [1, 2, 3, 4, 5, 6, 7, 8]], ["nine", [1, 2, 3, 4, 5, 6, 7, 8, 9]], ["long", long], ["holes", holes], ["doubles", [1.5, 2.5]],
