////: Point
class Point {
  constructor(
    public x: number,
    public y: number,
  ) {}
  sum(): number {
    return this.x + this.y;
  }
}
////: Row
interface Row {
  name: string;
  n: number;
}
////: attempt
function attempt(name: string, run: () => number) {
  entered = 0
  let outcome: string
  try { outcome = "returned " + run() } catch (error) { outcome = error instanceof RangeError ? "RangeError" : "another error: " + error }
  console.log(name + ": " + outcome + ", went deep: " + (entered > 1000))
}
////: attempt-3
function attempt(name, f) {
  try {
    console.log(name, JSON.stringify(f()));
  } catch (error) {
    console.log(name, error.constructor.name, "|", framesOf(error));
  }
}
////: attempt-4
function attempt(what: string, run: () => unknown): void {
  try {
    console.log(what, run());
  } catch (error) {
    console.log(what, "threw", error instanceof TypeError);
  }
}
////: errorName
function errorName(run) {
  try {
    return "returned " + String(run());
  } catch (error) {
    return error.constructor.name;
  }
}
