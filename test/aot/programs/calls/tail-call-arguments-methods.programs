for (let turn = 0; turn < 4; turn++) lines.push("methods: " + limit.reached({ count: turn * 2 }) + " " + anything.reached({ count: turn }) + " " + limit.double + " " + String(limit.bump()) + " " + String(anything.bump()) + " " + limit.count + " " + anything.count);
