//// tail-call-under-as.ts
// A call in tail position wrapped in `as`, `!` or parentheses is still a tail call: recursion 300,000 deep must not overflow the stack. Output must match plain Bun.
const untyped: any = {};
function underAs(n: number): number {
  if (n === 0) return 0;
  return untyped.underAs(n - 1) as number;
}
function underAsInParentheses(n: number): number {
  if (n === 0) return 0;
  return (untyped.underAsInParentheses(n - 1) as number);
}
function underTwo(n: number): number {
  if (n === 0) return 0;
  return untyped.underTwo(n - 1) as unknown as number;
}
function underAsOfAnObject(n: number): { depth: number } {
  if (n === 0) return { depth: 0 };
  return untyped.underAsOfAnObject(n - 1) as { depth: number };
}
function underAsOfAString(n: number): string {
  if (n === 0) return "bottom";
  return untyped.underAsOfAString(n - 1) as string;
}
function underNonNull(n: number): number {
  if (n === 0) return 0;
  return untyped.underNonNull(n - 1)!;
}
function plain(n: number): number {
  if (n === 0) return 0;
  return untyped.plain(n - 1);
}
function typedUnderAs(n: number): number {
  if (n === 0) return 0;
  return typedUnderAs(n - 1) as number;
}
function inAConditional(n: number): number {
  return n === 0 ? 0 : (untyped.inAConditional(n - 1) as number);
}
const arrow = (n: number): number => (n === 0 ? 0 : (untyped.arrow(n - 1) as number));
Object.assign(untyped, { underAs, underAsInParentheses, underTwo, underAsOfAnObject, underAsOfAString, underNonNull, plain, typedUnderAs, inAConditional, arrow });
for (const name of Object.keys(untyped)) {
  try {
    console.log(name, JSON.stringify(untyped[name](300000)));
  } catch (error) {
    console.log(name, "throws", (error as Error).constructor.name);
  }
}
//// tail-calling-functions-as-constructors.ts
// Functions that end in `return f()` are used with `new`, `Reflect.construct` and plain calls: a result that is no object is replaced by the new object.
const opaque = <T,>(x: T): T => (globalThis as any).nothingHere ? (undefined as any) : x;
function one() { return 1; }
function str() { return "s"; }
function obj() { return { made: "by obj" }; }
function undef() {}
function TailPrimitive() { return one(); }
function TailString() { return str(); }
function TailObject() { return obj(); }
function TailUndefined() { return undef(); }
function TailUnknown(f: any) { return f(); }
function TailNative(x: any) { return Math.abs(x); }
function Primitive() { return 5; }
const show = (v: unknown) => typeof v + ":" + JSON.stringify(v) + ":" + (v && typeof v === "object" ? Object.getPrototypeOf(v) === Object.prototype ? "plain" : (Object.getPrototypeOf(v) as any).constructor.name : "-");
for (const F of [TailPrimitive, TailString, TailObject, TailUndefined, Primitive] as any[]) {
  console.log(F.name, "new:", show(new F()), "| Reflect.construct:", show(Reflect.construct(F, [])), "| opaque:", show(new (opaque(F))()), "| called:", show(F()));
}
console.log("TailUnknown", show(new (TailUnknown as any)(one)), show(new (TailUnknown as any)(obj)), show(Reflect.construct(TailUnknown, [str])), show(new (opaque(TailUnknown) as any)(undef)));
console.log("TailNative", show(new (TailNative as any)(-3)), show(Reflect.construct(TailNative, [-3])));
for (let i = 0; i < 3; i++) console.log("in a loop", show(new (TailPrimitive as any)()), show(new (TailUnknown as any)(i & 1 ? one : obj)));
class Base { constructor() { return one() as any; } }
class Derived extends Base { x = 1; }
console.log("class", show(new Base()), show(new Derived()));
//// tail-calls-by-value-into-typed-functions.ts
// Functions with a written result type call, in tail position, a function value that nobody knows. A chain of such calls of any length runs in constant space, and its result is tested once,
// by whoever receives it, against the type written on the function that was called from outside. A call that is no tail call is tested like any other, however deep in such a chain it is made.
const deep = 400000;
function attempt(label: string, run: () => unknown): void {
  try { console.log(label, run()); } catch (error) { console.log(label, (error as Error).name); }
}
const hidden: any = globalThis;

type Next<T> = (n: number, acc: T, next: any) => T;
function sumDown(n: number, acc: number, next: Next<number>): number {
  if (n === 0) return acc + 0.5;
  return next(n - 1, acc + n, next);
}
hidden.held = sumDown;
attempt("called by value", () => hidden.held(deep, 0, hidden.held));
attempt("called directly", () => sumDown(deep, 0, hidden.held));
attempt("by a built-in", () => [deep, deep + 1].map(n => hidden.held(n, 0, hidden.held)).join());

function numbers(n: number, other: any, self: any): number {
  if (n === 0) return 1.5;
  return other(n - 1, self, other);
}
function texts(n: number, other: any, self: any): string {
  if (n === 0) return "text";
  return other(n - 1, self, other);
}
hidden.pair = [numbers, texts];
for (const depth of [deep, deep + 1]) {
  for (const first of [0, 1])
    attempt("two written types, " + depth + " from " + first, () => hidden.pair[first](depth, hidden.pair[1 - first], hidden.pair[first]));
}

const untyped: any = function (n: any, other: any, self: any) { "use strict"; return n === 0 ? "untyped" : other(n - 1, self, other); };
hidden.untyped = untyped;
attempt("through untyped code, to a number", () => hidden.pair[0](deep, hidden.untyped, hidden.pair[0]));
attempt("through untyped code, to its own text", () => hidden.pair[0](deep + 1, hidden.untyped, hidden.pair[0]));
attempt("untyped code receives", () => hidden.untyped(deep + 1, hidden.pair[0], hidden.untyped));

function wrong(): any { return "no number"; }
hidden.wrong = wrong;
function once(f: any): number { return f(); }
hidden.once = once;
function inner(n: number, f: any): number {
  if (n === 0) { const kept = hidden.once(f); return kept === "no number" ? 1 : 2; }
  return hidden.inner(n - 1, f);
}
hidden.inner = inner;
attempt("an ordinary call at the end of a chain", () => hidden.inner(deep, hidden.wrong));

class Walker {
  steps = 0;
  walk(n: number, next: any): number { if (n === 0) return this.steps; this.steps++; return next.call(this, n - 1, next); }
}
hidden.walk = Walker.prototype.walk;
attempt("a method through call", () => hidden.walk.call(new Walker(), deep, hidden.walk));
//// tail-calls-deleted-from-stack-traces/main.ts
// In strict code a call in tail position replaces its caller, so a stack trace taken in the callee does not list the caller. That holds wherever the compiler makes an ordinary call of it: in an inlined copy, in front of a check of the result, with a list of arguments, for a built-in, under an await. A call that is not in tail position, and every call in sloppy code, keeps its caller.
// @ts-ignore
import { t_sloppy_outer } from "./sloppy.cjs";
declare const console: any;

function shown(stack: unknown): string {
  const names: string[] = [];
  for (const line of String(stack).split("\n")) {
    const match = /\b(t_[A-Za-z0-9_]+)/.exec(line);
    if (match) names.push(match[1]!);
  }
  return names.join(" < ");
}
function row(name: string, actual: string, expected: string) {
  console.log(name + ": " + actual + (actual === expected ? "" : " BUT THE RULE GIVES " + expected));
}
const hide = <T,>(value: T): any => (JSON.parse("[0]") as number[]).map(() => value)[0];

function t_leaf(): string { const trace = shown(new Error("leaf").stack); return trace; }
function t_leaf_of(first: unknown, second: unknown): string { const trace = shown(new Error(String(first) + second).stack); return trace; }
function t_thrower(): string { throw new Error("thrown"); }

function t_tail(): string { return t_leaf(); }
function t_outer(): string { const trace = t_tail(); return trace + ""; }
row("tail call", t_outer(), "t_leaf < t_outer");

function t_kept(): string { let trace: string; trace = t_leaf(); return trace; }
function t_outer_of_kept(): string { const trace = t_kept(); return trace + ""; }
row("result assigned to a variable", t_outer_of_kept(), "t_leaf < t_kept < t_outer_of_kept");

function t_used(): string { return t_leaf() + ""; }
function t_outer_of_used(): string { const trace = t_used(); return trace + ""; }
row("result used", t_outer_of_used(), "t_leaf < t_used < t_outer_of_used");

function t_tail_of_tail(): string { return t_tail(); }
function t_outer_of_two(): string { const trace = t_tail_of_tail(); return trace + ""; }
row("two tail calls", t_outer_of_two(), "t_leaf < t_outer_of_two");

function t_tail_of_kept(): string { return t_kept(); }
function t_outer_of_mixed(): string { const trace = t_tail_of_kept(); return trace + ""; }
row("tail call of a function that keeps its frame", t_outer_of_mixed(), "t_leaf < t_kept < t_outer_of_mixed");

function t_either(first: boolean): string { return first ? t_leaf() : t_leaf_of(1, 2); }
function t_outer_of_either(first: boolean): string { const trace = t_either(first); return trace + ""; }
row("first arm", t_outer_of_either(true), "t_leaf < t_outer_of_either");
row("second arm", t_outer_of_either(false), "t_leaf_of < t_outer_of_either");

function t_by_value(callee: any): any { return callee(); }
function t_outer_by_value(callee: any): string { const trace = t_by_value(callee); return trace + ""; }
