const log = [];
let counter = 0;

function bump() {
  counter++;
}
function bumpTwice() {
  bump();
  bump();
}
function bumpInTailPosition() {
  return bump();
}
function bumpOrNumber(flag) {
  if (flag) return bump();
  return 7;
}
function earlyReturn(flag) {
  if (flag) return;
  counter += 10;
}
function neverReturns() {
  throw new Error("thrown");
}
const arrow = () => {
  counter++;
};
const holder = {
  method() {
    counter++;
  },
  forward() {
    return this.method();
  },
};
class Counter {
  static reset() {
    counter = 0;
  }
  step() {
    counter++;
  }
}

const show = value => (value === undefined ? "undefined" : typeof value + " " + String(value));
const indirect = [bump, bumpTwice, bumpInTailPosition, earlyReturn, arrow, holder.method, holder.forward.bind(holder), Counter.reset, Counter.prototype.step];

for (let round = 0; round < 3; round++) {
  log.push("direct " + [bump(), bumpTwice(), bumpInTailPosition(), bumpOrNumber(true), bumpOrNumber(false), earlyReturn(true), earlyReturn(false), arrow(), holder.method(), holder.forward(), Counter.reset(), new Counter().step()].map(show).join(","));
  log.push("indirect " + indirect.map(f => show(f())).join(","));
  log.push("call " + indirect.map(f => show(f.call(holder))).join(","));
  log.push("apply " + indirect.map(f => show(f.apply(holder, [false]))).join(","));
  log.push("reflect " + indirect.map(f => show(Reflect.apply(f, holder, []))).join(","));
  log.push("bound " + indirect.map(f => show(f.bind(holder)())).join(","));
  log.push("callbacks " + show([1, 2, 3].forEach(bump)) + " " + [1, 2].map(bump).map(show).join(",") + " " + [1, 2].filter(bump).length + " " + show([1].find(bump)) + " " + [3, 1, 2].sort(bump).join(""));
  log.push("operators " + (bump() ?? "nullish") + " " + (bump() || "falsy") + " " + String(bump() && "truthy") + " " + (bump() === undefined) + " " + typeof bump() + " " + `${bump()}` + " " + (bump() + 1) + " " + JSON.stringify({ a: bump(), b: [bump()] }));
  log.push("default " + ((value = "defaulted") => value)(bump()));
  log.push("spread " + [...[bump(), bump()]].map(show).join(","));
  log.push("new " + typeof new bump() + " " + (new bumpInTailPosition() instanceof bumpInTailPosition));
  try {
    neverReturns();
  } catch (error) {
    log.push("throws " + error.message);
  }
  try {
    indirect.concat(neverReturns).forEach(f => f());
  } catch (error) {
    log.push("throws indirectly " + error.message);
  }
}

async function asyncVoid() {
  counter++;
}
function* generatorVoid() {
  counter++;
}
function thenable() {
  return Promise.resolve().then(bump);
}
Promise.all([asyncVoid(), thenable(), Promise.resolve(1).then(bumpInTailPosition), new Promise(resolve => resolve(bump()))]).then(values => {
  log.push("promises " + values.map(show).join(","));
  log.push("generator " + JSON.stringify(generatorVoid().next()));
  log.push("counter " + counter);
  console.log(log.join("\n"));
});
//// what-a-function-did-before-the-stack-ended-is-undone-by-its-finally.js
// A function counts itself in, calls on inside a try and counts itself out in the finally. It also has a way out that calls nothing. When the stack ends, every frame that has counted
// itself in counts itself out: the error belongs to the try of the deepest frame that has begun, not to its caller.
let depth = 0;
let caught = 0;
function report(label, run) {
  depth = 0;
  caught = 0;
  let outcome;
  try {
    outcome = "answers " + run();
  } catch (error) {
    outcome = error instanceof RangeError ? "RangeError" : String(error);
  }
  console.log(label + ":", outcome, "| depth", depth, "| caught", caught);
}

////= lines-29	function withAnEarlyExit	withAnEarlyExit(n + 1) + 1

function withACatch(n) {
  depth++;
  try {
    if (n < 0) return 0;
    const result = withACatch(n + 1) + 1;
    depth--;
    return result;
  } catch (error) {
    depth--;
    throw error;
  }
}

function catchesAtTheEnd(n) {
  depth++;
  try {
    if (n < 0) return 0;
    const result = catchesAtTheEnd(n + 1);
    depth--;
    return result;
  } catch (error) {
    depth--;
    caught++;
    return "caught";
  }
}

const chain = { get next() { return throughAGetter(); } };
const other = { get next() { return 1; } };
////= throughA	Getter(	chain.next

const walkers = [{ walk(n) { return throughAMethod(n + 1); } }, { walk(n) { return n; } }];
////= throughA	Method(n	walkers[n < 0 ? 1 : 0].walk(n)

function inALoop(n) {
  depth++;
  try {
    for (let i = 0; i < 1; i++) {
      if (n < 0) continue;
      inALoop(n + 1);
    }
  } finally {
    depth--;
  }
}

function twoFinallys(n) {
  depth += 2;
  try {
    try {
      if (n < 0) return 0;
      return twoFinallys(n + 1) + 1;
    } finally {
      depth--;
    }
  } finally {
    depth--;
  }
}

////= lines-29	async function asynchronous	asynchronous(n + 1)

////= lines-29	function* stepped	stepped(n + 1).next().value

class Counted {
  constructor(n) {
    depth++;
    try {
      if (n < 0) return;
      this.next = new Counted(n + 1);
    } finally {
      depth--;
    }
  }
}

console.log(other.next, walkers[1].walk(2));
for (let round = 0; round < 3; round++) {
  report("an early exit", () => withAnEarlyExit(0));
  report("a catch that throws again", () => withACatch(0));
  report("a catch that answers", () => catchesAtTheEnd(0));
  report("a getter", () => throughAGetter());
  report("a method", () => throughAMethod(0));
  report("a loop", () => inALoop(0));
  report("two finallys", () => twoFinallys(0));
  report("a generator", () => stepped(0).next().value);
  report("a constructor", () => typeof new Counted(0));
}
depth = 0;
try {
  console.log("an async function: answers", await asynchronous(0));
} catch (error) {
  console.log("an async function:", error instanceof RangeError ? "RangeError" : String(error), "| depth", depth);
}
//// what-an-early-return-hands-back-skips-the-test-of-the-result.ts
// A function that leaves early hands back what it was handed. Its caller tests the result of the call for its declared type: what the early return hands back has that type already,
// what the whole function hands back may be anything.
class Shape {
  flags: number;
  next: Shape | undefined;
  constructor(flags: number, next?: Shape) {
    this.flags = flags;
    this.next = next;
  }
}

const answers: unknown[] = [];
let turn = 0;

function reduceSlowly(shape: Shape): Shape {
  const answer = answers[turn++ % answers.length];
  return answer as Shape;
}

function reduce(shape: Shape): Shape {
  if (shape.flags & 1) return reduceSlowly(shape);
  return shape;
}

function flagsOf(shape: Shape): unknown {
  return shape === undefined || shape === null ? "none" : shape.flags;
}

function describe(shape: Shape): unknown {
  return flagsOf(reduce(shape));
}

function nextOrSelf(shape: Shape): Shape | undefined {
  if (shape.flags & 2) return shape.next;
  return shape;
}

function describeNext(shape: Shape): unknown {
  const next = nextOrSelf(shape);
  return next ? flagsOf(next) : "nothing";
}

const plain = new Shape(4);
const slow = new Shape(5);
const linked = new Shape(2, plain);
const unlinked = new Shape(2);
answers.push(plain, "a text", 7, undefined, null, { flags: "of a stranger" }, slow, [1, 2], () => 1);

const seen = new Map<string, number>();
for (let round = 0; round < 20000; round++) {
  for (const shape of [plain, slow, linked, unlinked]) {
    const line = String(describe(shape)) + " | " + String(describeNext(shape));
    seen.set(line, (seen.get(line) ?? 0) + 1);
  }
}
for (const [line, count] of [...seen].sort()) console.log(line, count);

delete (plain as any).flags;
console.log(describe(plain), describeNext(plain), describeNext(linked));
Object.defineProperty(slow, "flags", { get() { return 4; } });
console.log(describe(slow), describeNext(slow));
//// what-an-early-return-reads-is-read-once-a-call.ts
class Item {
    kind: number;
    weight: number = 0.5;
    owner: Item | undefined = undefined;
    constructor(kind: number) {
        this.kind = kind;
    }
}
const seen: number[] = [];
const words: string[] = [];
function note(item: Item, word: string): boolean {
    seen.push(item.kind);
    if (words.length < 8)
        words.push(word + ":" + String(item.weight) + ":" + (item.owner === undefined ? "none" : typeof item.owner.weight));
    for (let owner = item.owner, depth = 0; owner !== undefined && depth < 3; owner = owner.owner, depth++) {
        if (owner.weight > 1)
            seen.push(-depth);
    }
    return true;
}
function isSpecial(item: Item): boolean {
    if (item.kind !== 7)
        return false;
    if (words.length > 100)
        words.length = 0;
    const first = note(item, "first");
    const second = seen.length % 1000003 === 1000002 ? note(item, "again") : first;
    return first && second;
}
function ownerIsSpecial(item: Item): boolean {
    const owner = item.owner;
    if (owner === undefined)
        return false;
    if (owner.kind !== 7)
        return false;
    if (words.length > 100)
        words.length = 0;
    const first = note(owner, "owner");
    const second = seen.length % 1000003 === 1000002 ? note(owner, "again") : first;
    return first && second;
}
function count(items: Item[], rounds: number): number {
    let special = 0;
    for (let round = 0; round < rounds; round++) {
        for (let i = 0; i < items.length; i++) {
            if (isSpecial(items[i]))
                special++;
            if (ownerIsSpecial(items[i]))
                special += 10;
        }
    }
    return special;
}
function report(label: string, items: Item[], rounds: number): void {
    seen.length = 0;
    const special = count(items, rounds);
    console.log(label, special, seen.length, seen.slice(0, 6).join(","), words.join(" "));
    words.length = 0;
}
const items: Item[] = [];
for (let i = 0; i < 16; i++) {
    items.push(new Item(i % 9));
    if (i)
        items[i].owner = items[i - 1];
}
report("plain", items, 20000);

let reads = 0;
Object.defineProperty(items[3], "kind", {
    get() {
        reads++;
        return reads % 2 ? 7 : 1;
    },
    configurable: true,
    enumerable: true,
});
report("a getter whose answers take turns", items, 5);
console.log("reads", reads);

let traps = 0;
const behindProxy = new Proxy(new Item(7), {
    get(target, key, receiver) {
        traps++;
        return Reflect.get(target, key, receiver);
    },
});
items[5] = behindProxy as Item;
report("a proxy", items, 5);
console.log("traps", traps);

let inherited = 0;
Object.defineProperty(Item.prototype, "kind", {
    get() {
        inherited++;
        return 7;
    },
    configurable: true,
});
delete (items[8] as { kind?: number }).kind;
report("deleted, and a getter on the prototype", items, 5);
console.log("inherited", inherited);

items[9].kind = 7.5;
items[10].kind = -0;
items[11].kind = NaN;
(items[12] as { kind: unknown }).kind = "7";
(items[13] as { kind: unknown }).kind = undefined;
report("what is no int32", items, 5);
items[9].kind = 7;
report("and back", items, 5);
