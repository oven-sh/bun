//// values-only-forwarded.ts
////= lines-16	Item	id	name	string

let log = "";

function note(item: Item, tag: string): number {
  log += tag + item.id + ";";
  return item.id;
}

function noteTwo(a: Item, b: Item, tag: string): number {
  log += tag + a.name + b.name + ";";
  return a.id + b.id;
}

function handsOn(a: Item, b: Item, c: Item, d: string): number {
  const first = note(a, d);
  const second = note(b, d);
  const third = note(c, d);
  return first + second * 10 + third * 100;
}

function handsOnTwice(a: Item, b: Item, c: Item, d: string): number {
  return noteTwo(a, b, d) + noteTwo(b, c, d) * 3 + noteTwo(c, a, d) * 5 + noteTwo(a, c, d) * 7;
}

function readsBetweenCalls(a: Item, b: Item, c: Item, d: string): string {
  let out = a.name;
  note(a, d);
  out += b.name + a.id;
  note(b, d);
  out += c.name + b.id + a.name;
  note(c, d);
  return out + c.id + b.name + a.id + d;
}

function handsOnInALoop(items: Item[], extra: Item, tag: string, rounds: number): number {
  let total = 0;
  for (let round = 0; round < rounds; round++) {
    for (let i = 0; i < items.length; i++) total += noteTwo(items[i], extra, tag) + round;
  }
  return total;
}

function returnsEarly(a: Item | undefined, b: Item, tag: string): number {
  if (!a) return -1;
  if (a.id > 100) return a.id;
  return note(a, tag) + note(b, tag);
}

function numbersHandedOn(a: number, b: number, c: number, d: number): number {
  return sum3(a, b, c) + sum3(b, c, d) * 2 + sum3(c, d, a) * 3 + sum3(d, a, b) * 4;
}

function sum3(x: number, y: number, z: number): number {
  log += ".";
  return x + y * 0.5 + z * 0.25;
}

const one: Item = { id: 1, name: "one" };
const two: Item = { id: 2, name: "two" };
const three: Item = { id: 3, name: "three" };
const big: Item = { id: 500, name: "big" };

console.log(handsOn(one, two, three, "h"), handsOnTwice(one, two, three, "t"));
console.log(readsBetweenCalls(one, two, three, "r"));
console.log(handsOnInALoop([one, two, three], big, "l", 3));
console.log(returnsEarly(undefined, one, "e"), returnsEarly(big, one, "e"), returnsEarly(two, three, "e"));
console.log(numbersHandedOn(1, 2.5, -3, 4e3), numbersHandedOn(0.1, 0.2, 0.3, 0.4));
console.log(log.length, log.slice(0, 80));
//// values-used-on-arrival.ts
interface Point {
  x: number;
  y: number;
  label: string;
}

function pick(flag: boolean, a: Point, b: Point): Point {
  return flag ? a : b;
}

function first(a: any): any {
  if (typeof a === "object" && a !== null) return a;
  return a;
}

function eight(a: number, b: number, c: number, d: number, e: number, f: number, g: number, h: number): number {
  return ((a << (b & 7)) + (c >> (d & 7)) + ((e | 0) % ((f | 0) || 1)) + Math.imul(g, h)) | 0;
}

function tenMixed(a: Point, b: number, c: string, d: Point, e: number, f: boolean, g: any, h: Point, i: number, j: string): string {
  return a.label + b + c + d.x + e + f + String(g) + h.y + i + j;
}

function shifts(value: number, count: number, other: number, mask: number): number {
  let total = 0;
  for (let i = 0; i < 5; i++) total = (total + ((value << count) ^ (other >>> (count + i)) ^ (mask >> i))) | 0;
  return total;
}

function divides(a: number, b: number, c: number, d: number): number {
  const q = ((a | 0) / ((b | 0) || 1)) | 0;
  const r = (c | 0) % ((d | 0) || 1);
  return q * 31 + r + a - d;
}

function doubles(a: number, b: number, c: number, d: number): number {
  return a * 1.5 + b / 2.5 - c * d + Math.sqrt(a * a + b * b);
}

function usedBeforeAndAfter(a: Point, b: Point, c: number): string {
  const before = a.x + b.y + c;
  const made = pick(c > 2, a, b);
  return before + made.label + a.label + b.label + c;
}

function usedOnlyBefore(a: Point, b: Point, c: number): string {
  const sum = a.x * b.y + c;
  return describe(sum);
}

function describe(value: number): string {
  return "<" + value + ">";
}

function resultUsedAtOnce(a: Point, b: Point): number {
  const p = pick(a.x > b.x, a, b);
  if (p.x > 10) return p.y;
  return p.x + p.y;
}

function resultKept(a: Point, b: Point): string {
  const p = pick(a.x > b.x, a, b);
  const q = pick(a.y > b.y, a, b);
  return p.label + q.label + p.x + q.y;
}

function inALoop(points: Point[], scale: number, offset: number, label: string): string {
  let out = label;
  for (let i = 0; i < points.length; i++) {
    const p = points[i];
    out += (p.x * scale + offset) + ",";
    if (p.y > 4) out += describe(p.y);
  }
  return out + scale + offset + label;
}

function loopWithoutCalls(a: number, b: number, c: number, d: number): number {
  let total = 0;
  for (let i = 0; i < 100; i++) total = (total + a * i + (b ^ i) - (c & i) + d) | 0;
  return total;
}

function passedOnInPlace(a: Point, b: Point, c: number): string {
  return usedBeforeAndAfter(a, b, c);
}

function passedOnSwapped(a: Point, b: Point, c: number): string {
  return usedBeforeAndAfter(b, a, c + 1);
}

function throwsLate(a: Point | undefined, b: Point): number {
  const base = b.x;
  return base + a!.y;
}

function manyBranches(a: any, b: any, c: any): string {
  if (a === undefined) return "u" + b;
  if (a === null) return "n" + c;
  if (typeof a === "number") return a > 0 ? "p" + b : "m" + c;
  if (typeof a === "string") return a + b + c;
  return String(first(a) === a) + b + c;
}

const p1: Point = { x: 1, y: 2, label: "one" };
const p2: Point = { x: 30, y: 4.5, label: "two" };
const p3: Point = { x: -5, y: 60, label: "three" };

