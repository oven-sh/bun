function reach(f) { return f.call(/(a)|b/g)[1] }
const turn = second => reach(RegExp.prototype.exec);
const lists = [() => []];
for (const list of lists) try { turn() } catch (error) { console.log("caught", error.name) }
console.log("end");
//// what-exec-answers-where-nothing-matches-is-read-and-exec-arrives-through-one-call.mjs
