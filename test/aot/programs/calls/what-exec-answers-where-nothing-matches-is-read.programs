const turn = second => reach(String.prototype.match);
const lists = [() => []];
for (const list of lists) try { console.log(String(turn())) } catch (error) { console.log("caught", error.name) }
console.log("end");
//// what-exec-answers-where-nothing-matches-is-read-by-instanceof.mjs
