const lists = [() => []];
for (const list of lists) try { turn() } catch (error) { console.log("caught", error.name) }
console.log("end");
//// what-exec-answers-where-nothing-matches-is-read-and-a-function-of-the-program-takes-the-place-of-exec.mjs
function reach(f) { f.call(/(a)|b/g)[1] }
const none = () => null;
const turn = second => reach(none);
const lists = [() => []];
for (const list of lists) try { turn() } catch (error) { console.log("caught", error.name) }
console.log("end");
//// what-exec-answers-where-nothing-matches-is-read-out-of-a-field-of-a-literal.mjs
function reach(f) { const o = { m: f.call(/(a)|b/g, "x") }; return o.m[1]; }
const turn = second => reach(RegExp.prototype.exec);
const lists = [() => []];
for (const list of lists) try { console.log(String(turn())) } catch (error) { console.log("caught", error.name) }
console.log("end");
