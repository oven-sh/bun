const lists = [() => []];
for (const list of lists) try { turn() } catch (error) { console.log("caught", error.name) }
console.log("end");
//// what-exec-answers-where-nothing-matches-is-read-and-a-declared-function-hands-exec-on.mjs
function reach(f) { f.call(/(a)|b/g)[1] }
function turn() { return reach(RegExp.prototype.exec); }
const lists = [() => []];
for (const list of lists) try { turn() } catch (error) { console.log("caught", error.name) }
console.log("end");
