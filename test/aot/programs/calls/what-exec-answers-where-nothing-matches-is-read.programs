const lists = [() => []];
for (const list of lists) try { turn() } catch (error) { console.log("caught", error.name) }
console.log("end");
//// what-exec-answers-where-nothing-matches-is-read-and-get-of-a-map-takes-the-place-of-exec.mjs
function reach(f) { f.call(new Map(), 1)[1] }
