const lists = [() => []];
for (const list of lists) try { turn() } catch (error) { console.log("caught", error.name) }
console.log("end");
//// what-exec-answers-where-nothing-matches-is-read-and-find-of-a-list-takes-the-place-of-exec.mjs
function reach(f) { f.call([], () => false)[1] }
