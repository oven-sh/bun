//// cell-type-change-in-loop.js
// A closure that gets a property and an object that loses its layout change cell type in place. A type test in a loop must see the change.
function one() { return 1 }
function two() { return 2 }
function ten() { return 10 }

function callEach(f, replaceAt) {
  let total = 0
  for (let i = 0; i < 4; i++) {
    total += f.call(null)
    if (i === replaceAt) f.call = ten
  }
  return total
}
console.log(callEach(one, 1), callEach(two, 4))

function applyEach(f, replaceAt) {
  let total = 0
  for (let i = 0; i < 4; i++) {
    total += f.apply(null, [])
    if (i === replaceAt) Object.defineProperty(f, "apply", { value: ten })
  }
  return total
}
function three() { return 3 }
console.log(applyEach(three, 0))

class Point {
  constructor(x, y) {
    this.x = x
    this.y = y
  }
}
function keysEach(point, deleteAt) {
  const seen = []
  for (let i = 0; i < 3; i++) {
    const keys = []
    for (const key in point) keys.push(key)
    seen.push(keys.join(), Object.keys(point).join(), JSON.stringify({ ...point }))
    if (i === deleteAt) delete point.x
  }
  return seen.join(" ")
}
console.log(keysEach(new Point(1, 2), 0))
console.log(keysEach(new Point(3, 4), 3))
//// class-bindings-reassigned.js
// A class declaration binds a variable, like `let`: code outside the class may store to it. Only the binding that the body of the class sees is fixed.
////= attempt-6
class Box { static kind = "box"; who() { return Box; } }
const first = new Box();
function swap(value) { Box = value; }
attempt("as declared", () => [typeof Box, Box.kind, Box.name, first instanceof Box]);
attempt("another class", () => { swap(class Other { static kind = "other"; }); return [typeof Box, Box.kind, first.who().kind, first instanceof Box, new Box() instanceof first.who()]; });
attempt("a number", () => { swap(1); return [typeof Box, first.who().kind]; });

class Fixed { static store() { Fixed = 1; } }
attempt("from within", () => Fixed.store());
attempt("still the class", () => typeof Fixed);

class Merged { static n = 1; }
Merged ||= {};
Merged ??= {};
attempt("never stored to", () => [typeof Merged, Merged.n]);

function inner() {
  class Local { static n = 1; }
  const before = Local;
  [Local] = [5];
  return [typeof before, Local];
}
attempt("in a function", inner);

class Base { hello() { return "base"; } }
class Derived extends Base {}
Base = class { hello() { return "replaced"; } };
attempt("what extended it", () => [new Derived().hello(), new Base().hello(), new Derived() instanceof Base]);

class Counted {}
attempt("++", () => { Counted++; return Counted; });
for (Counted of ["of a loop"]);
attempt("for of", () => Counted);

class Followed {}
(function () { Followed = "what follows the body is a statement of its own"; })();
attempt("an expression behind the body", () => Followed);
//// class-bindings-reassigned-by-eval.js
// A direct eval that stands outside a class may store to the variable that the class declaration binds, as any code there may. One that stands in the body of the class sees the binding that is fixed.
////= attempt-6
class Seen { static kind = "seen"; who() { return Seen; } }
const first = new Seen();
attempt("eval reads", () => eval("typeof Seen + Seen.kind"));
attempt("eval stores", () => eval("Seen = 5"));
attempt("what eval stored", () => [Seen, first.who().kind]);

class Fixed { static viaEval() { return eval("Fixed = 2"); } }
attempt("from within", () => Fixed.viaEval());
attempt("still the class", () => typeof Fixed);

function inner() {
  class Local { static n = 1; }
  const before = Local;
  eval("Local = 7");
  return [typeof before, Local];
}
attempt("in a function", inner);
