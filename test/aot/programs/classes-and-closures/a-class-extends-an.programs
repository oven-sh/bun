//// callbacks-whose-captures-outlive-the-call.ts
// A callback dies with the call it is handed to, and what it captures does not: the callee or the callback itself keeps, returns, throws or stores it.
// Each mapper below has one callback, so that the callback may be laid into a copy of the mapper, which then reads the captures out of the closure.
const lines: string[] = [];
////= say

// Overwrites what earlier frames have left on the stack.
function trample(depth: number, a: number, b: number, c: number): number {
  const d = a * 3 + depth, e = b * 5 + depth, f = c * 7 + depth, g = d ^ e, h = e ^ f, i = f ^ d;
  if (depth === 0) return d + e + f + g + h + i;
  return trample(depth - 1, g, h, i) + d - e + f - g + h - i;
}

interface Item { flags: number; members: Item[] | undefined; name: string }
function leaf(name: string): Item { return { flags: 1, members: undefined, name }; }
function group(...members: Item[]): Item { return { flags: 2, members, name: "group" }; }

function mapItem<T>(item: Item, mapper: (item: Item) => T): T[] {
  if (!(item.flags & 2)) return [mapper(item)];
  const results: T[] = [];
  for (const member of item.members!) results.push(mapper(member));
  return results;
}
function mapItemLast<T>(item: Item, mapper: (item: Item) => T): T {
  if (!(item.flags & 2)) return mapper(item);
  let last: T | undefined;
  for (const member of item.members!) last = mapper(member);
  return last!;
}
function someItem(item: Item, test: (item: Item) => boolean): boolean {
  if (!(item.flags & 2)) return test(item);
  for (const member of item.members!) if (test(member)) return true;
  return false;
}

const three = group(leaf("a"), leaf("b"), leaf("c"));
const keptReaders: (() => string)[] = [];
const keptWriters: ((text: string) => void)[] = [];
const keptObjects: { count: number; label: string }[] = [];
const keptCallbacks: ((item: Item) => unknown)[] = [];

function readersOverTheScope(item: Item, prefix: string) {
  let calls = 0;
  return mapItem(item, member => { calls++; return () => prefix + member.name + calls; });
}
function readersKeptByTheCallback(item: Item, prefix: string) {
  let seen = "";
  mapItem(item, member => {
    seen += member.name;
    keptReaders.push(() => prefix + seen);
    keptWriters.push(text => { seen += text; });
    return 0;
  });
  return seen;
}
function capturedObjectIsStored(item: Item, label: string) {
  const tally = { count: 0, label };
  someItem(item, member => {
    tally.count += member.name.length;
    if (member.name === "b") keptObjects.push(tally);
    return false;
  });
  return tally.count;
}
function capturedObjectIsReturned(item: Item, label: string) {
  const tally = { count: 0, label };
  return mapItemLast(item, member => { tally.count += member.name.charCodeAt(0); return tally; });
}
function capturedCallbackIsReturned(item: Item, suffix: string) {
  const inner = (member: Item) => member.name + suffix;
  return mapItemLast(item, () => inner);
}
function capturedCallbackIsStored(item: Item, suffix: string) {
  let uses = 0;
  const inner = (member: Item) => member.name + suffix + ++uses;
  someItem(item, member => { if (member.name === "c") keptCallbacks.push(inner); return inner(member) === ""; });
  return uses;
}
function capturedObjectIsThrown(item: Item, label: string) {
  const problem = { count: 7, label };
  try {
    someItem(item, member => { if (member.name === "b") throw problem; problem.count++; return false; });
  } catch (thrown) {
    return thrown as { count: number; label: string };
  }
  return undefined;
}
function scopesOfIterations(item: Item) {
  const readers: (() => string)[] = [];
  for (let round = 0; round < 3; round++) {
    let text = "r" + round;
    mapItem(item, member => { text += member.name; readers.push(() => text + round); return 0; });
  }
  return readers;
}
function nothingOutlives(item: Item, wanted: string) {
  let steps = 0;
  const found = someItem(item, member => { steps++; return member.name === wanted; });
  return found + " " + steps;
}

// In tail position. The callee's own tail calls come to an end here.
function inTailPosition(item: Item, prefix: string) {
  let calls = 0;
  return mapItem(item, member => { calls++; return () => prefix + member.name + calls; });
}
function inTailPositionNothingOutlives(item: Item, wanted: string) {
  return someItem(item, member => member.name === wanted);
}
// And here they go round: no frame may stay behind, however many rounds there are.
function countDown(rounds: number, previous: () => number): number {
  if (rounds === 0) return previous();
  return countDown(rounds - 1, () => rounds);
}
function ping(rounds: number, total: { sum: number }, previous: () => number): number {
  if (rounds === 0) return total.sum + previous();
  total.sum += previous() & 1;
  return pong(rounds - 1, total, () => rounds);
}
function pong(rounds: number, total: { sum: number }, previous: () => number): number {
  if (rounds === 0) return total.sum - previous();
  return ping(rounds - 1, total, () => rounds + previous() % 3);
}

for (let round = 0; round < 3; round++) {
  const first = readersOverTheScope(three, "x" + round);
  const single = readersOverTheScope(leaf("z"), "y" + round);
  say("seen", readersKeptByTheCallback(three, "p" + round));
  say("count", capturedObjectIsStored(three, "t" + round));
  const returned = capturedObjectIsReturned(three, "u" + round);
  const inner = capturedCallbackIsReturned(three, "!" + round);
  say("uses", capturedCallbackIsStored(three, "?" + round));
  const thrown = capturedObjectIsThrown(three, "w" + round);
  const iterations = scopesOfIterations(three);
  say("nothing", nothingOutlives(three, "c"), nothingOutlives(three, "q"));
  const tail = inTailPosition(three, "t" + round);
  say("tail", inTailPositionNothingOutlives(three, "b"), inTailPositionNothingOutlives(leaf("b"), "a"));
  say("trample", trample(60, round, 2, 3));
  say("first", first.map(read => read()).join(","), single.map(read => read()).join(","));
  say("returned", returned.count, returned.label);
  say("inner", inner(leaf("i")));
  say("thrown", thrown && thrown.count, thrown && thrown.label);
  say("iterations", iterations.map(read => read()).join(","));
  say("tail readers", tail.map(read => read()).join(","));
}
for (const write of keptWriters) write("+");
say("trample", trample(80, 5, 6, 7));
say("readers", keptReaders.map(read => read()).join(","));
say("objects", keptObjects.map(object => object.label + object.count).join(","));
say("callbacks", keptCallbacks.map(callback => callback(leaf("k"))).join(","));
say("count down", countDown(300000, () => -1));
say("ping", ping(300001, { sum: 0 }, () => 1));
console.log(lines.join("\n"));
//// captured-variables-stored-two-calls-down.ts
const few: boolean = process.argv.length < 9;
const given: any = JSON.parse(few ? '{"a":1,"depth":3}' : '{"a":"x","depth":"y"}');
let spin = process.argv.length | 0;
function churn(): void {
  if (spin > 1000000) for (let i = 0; i < 64; i++) spin = ((spin + 3 + 2 * i) ^ (spin >> 3)) | 0;
}
function outer(reports: boolean): string {
  let info: string | undefined;
  let overflow = false;
  let count = 0;
  function report(message: string): void {
    churn();
    info = info ? info + "," + message : message;
  }
  function related(a: number, depth: number, reportErrors: boolean): number {
    churn();
    count++;
    if (depth > 2) overflow = true;
    if (depth > 0) return related(a + 1, depth - 1, reportErrors) + 1;
    if (reportErrors) report("x" + a);
    return 0;
  }
  const result = related(given.a, given.depth, reports);
  if (overflow) return "overflow " + result + " " + count + " " + info;
  else if (info) return "has " + info + " " + result + " " + count;
  return "none " + result + " " + count;
}
console.log(outer(few));
given.depth = 1;
console.log(outer(few));
console.log(outer(!few));
//// captures-and-closure-identity.ts
// Two evaluations of a function expression give two distinct objects, whether or not the function captures anything.
function make() { return () => 1; }
function makeCapturing(x: number) { return () => x; }
function declared() { function inner() { return 1; } return inner; }
console.log(make() === make(), makeCapturing(1) === makeCapturing(1), declared() === declared());
const tagged = make() as any; tagged.tag = 1;
console.log((make() as any).tag, tagged.tag);
const seen = new Set<unknown>(); for (let i = 0; i < 3; i++) seen.add(make());
console.log(seen.size);
// The closure of a declaration stays the same object until its scope is entered again.
function same(n: number) { const a = hoisted; const viaInner = (() => hoisted)(); return [a === hoisted, a === viaInner, a() === n].join(); function hoisted() { return n; } }
function sameWithoutCaptures() { const a = hoisted; const viaInner = (() => hoisted)(); return a === viaInner; function hoisted() { return 1; } }
function selfReference(n: number) { return visit(n); function visit(k: number): boolean { return k === 0 ? pick(visit) === visit : visit(k - 1); } }
function pick<T>(x: T): T { return x; }
function inLoop() { const all: unknown[] = []; for (let i = 0; i < 2; i++) { all.push(f, f); function f() { return i; } } return [all[0] === all[1], all[1] === all[2], all[2] === all[3]].join(); }
console.log(same(3), sameWithoutCaptures(), selfReference(2), inLoop());
// Only called: the difference is not observable.
function some<T>(list: T[], test: (x: T) => boolean) { for (const x of list) if (test(x)) return true; return false; }
function passedOn<T>(list: T[], test: (x: T) => boolean) { return some(list, test); }
console.log(some([1, 2], x => x > 1), passedOn([1, 2], x => x > 2), [1, 2].some(x => x > 1));
// Where a function expression is passed, when the callee is not a plain name.
const held: unknown[] = [];
function holds(f: () => number) { held.push(f); return f(); }
function onlyCalls(f: () => number) { return f(); }
function lastTwoAreOne() { return held[held.length - 1] === held[held.length - 2]; }
let assignedTo: ((f: () => number) => number) | undefined;
function throughAssignment() { for (let i = 0; i < 2; i++) { (assignedTo = holds)(() => 1); } return lastTwoAreOne(); }
function throughOrAssignment(first: boolean) { let h: ((f: () => number) => number) | undefined = first ? holds : undefined; let sum = 0; for (let i = 0; i < 2; i++) { sum += (h ||= onlyCalls)(() => 2); } return sum + ":" + held.length + ":" + lastTwoAreOne(); }
function throughNullishAssignment(first: boolean) { let h: ((f: () => number) => number) | undefined = first ? holds : undefined; let sum = 0; for (let i = 0; i < 2; i++) { sum += (h ??= onlyCalls)(() => 3); } return sum + ":" + held.length + ":" + lastTwoAreOne(); }
namespace Local { function holdsToo(f: () => number) { held.push(f); return f(); } export function run() { for (let i = 0; i < 2; i++) { holdsToo(() => 4); } return lastTwoAreOne(); } }
namespace Stored { let h = onlyCalls; export function set() { h = holds; } export function run() { let sum = 0; for (let i = 0; i < 2; i++) { sum += h(() => 5); } return sum + ":" + held.length + ":" + lastTwoAreOne(); } }
console.log(throughAssignment(), throughOrAssignment(true), throughOrAssignment(false), throughNullishAssignment(true), throughNullishAssignment(false));
console.log(Local.run(), Stored.run(), (Stored.set(), Stored.run()));
//// captures-shared-between-closures.ts
// Captured variables of one scope that different closures refer to are still shared between every closure that refers to them and the code that declares them.
const out: string[] = [];
function say(name: string, ...values: unknown[]): void {
  out.push(name + ": " + values.map(String).join(" "));
}
function hold<T>(value: T): T {
  return [value][0];
}

function twoCounters() {
  let a = 0, b = 10;
  const first = hold(() => ++a), second = hold(() => ++b), both = hold(() => a + b);
  first();
  first();
  second();
  a += 100;
  return [first(), second(), both(), a, b];
}
function overlappingSets() {
  let a = 1, b = 2, c = 3;
  const ab = hold(() => (a += b)), bc = hold(() => (b += c)), ca = hold(() => (c += a));
  return [ab(), bc(), ca(), ab(), bc(), ca(), a, b, c];
}
function storedToByTheMakerAfterwards() {
  let text = "a", count = 0;
  const read = hold(() => text), bump = hold(() => ++count);
  text += "b";
  bump();
  const seen = read();
  text += "c";
  return [seen, read(), bump(), count];
}
function perIteration() {
  const reads: (() => number)[] = [], bumps: (() => string)[] = [];
  for (let i = 0, label = "x"; i < 3; i++, label += "y") {
    reads.push(() => i++);
    bumps.push(() => (label += "!"));
  }
  return [...reads.map(f => f()), ...reads.map(f => f()), ...bumps.map(f => f()), ...bumps.map(f => f())];
}
function bodyOfALoop() {
  const made: (() => number)[] = [];
  for (const start of [1, 2]) {
    let up = start, down = start;
    made.push(() => ++up, () => --down, () => up * 10 + down);
  }
  return made.map(f => f()).concat(made.map(f => f()));
}
function madeInTheHead() {
  const made: (() => number)[] = [];
  let other = 0;
  for (let i = 0, f = () => i, g = () => ++other; i < 2; i++) {
    made.push(f, g, () => i);
  }
  return [...made.map(f => f()), other];
}
function blocks(flag: boolean) {
  let total = 0;
  const add = hold((n: number) => (total += n));
  {
    let inner = 1;
    const bump = hold(() => ++inner);
    add(bump());
    {
      let deeper = 10;
      const more = hold(() => (deeper += inner));
      add(more());
    }
  }
  if (flag) {
    let inner = 100;
    const bump = hold(() => ++inner);
    add(bump() + bump());
  }
  return total;
}
function caught() {
  let count = 0;
  const bump = hold(() => ++count);
  const made: (() => string)[] = [];
  for (const message of ["a", "b"]) {
    try {
      throw new Error(message);
    } catch (error) {
      let seen = (error as Error).message;
      made.push(() => (seen += bump()));
    }
  }
  return [...made.map(f => f()), ...made.map(f => f()), count];
}
function switched(which: number) {
  let total = 0;
  const add = hold(() => ++total);
  switch (which) {
    case 0: {
      let a = 1;
      const f = hold(() => ++a);
      return [f(), f(), add()];
    }
    case 1:
      let b = 10;
      const g = hold(() => ++b);
      add();
      return [g(), add(), total];
    default:
      return [add()];
  }
}
function hoisted() {
  let a = 0, b = 0;
  const first = hold(one), second = hold(two);
  function one(): number {
    return ++a;
  }
  function two(): number {
    return ++b + one();
  }
  return [first(), second(), first === hold(one), second === hold(two), hold(() => one)() === first, a, b];
}
function helpersThatAreOnlyCalled() {
  let a = 0, b = 0, c = 0;
  function one() {
    a++;
    two();
  }
  function two() {
    b++;
  }
  const kept = hold(() => ++c);
  one();
  one();
  two();
  return [a, b, kept(), c];
}
function classes() {
  let made = 0, named = "n";
  const label = hold(() => (named += "!"));
  class Counted {
    id = ++made;
    static count() {
      return made;
    }
    name() {
      return named + this.id;
    }
  }
  const first = new Counted(), second = new Counted();
  label();
  return [first.name(), second.name(), Counted.count(), made];
}
function* generated() {
  let a = 0, b = 0;
  const first = hold(() => ++a), second = hold(() => ++b);
  yield first();
  yield second() + first();
  yield a * 10 + b;
}
async function awaited() {
  let a = 0, b = 0;
  const first = hold(() => ++a), second = hold(() => ++b);
  await null;
  first();
  await null;
  second();
  a += 10;
  await null;
  return [first(), second(), a, b];
}
function namedExpression() {
  let calls = 0, depth = 0;
  const bump = hold(() => ++calls);
  const recur = hold(function self(n: number): number {
    depth++;
    return n > 0 ? self(n - 1) : depth;
  });
  return [recur(3), bump(), calls, depth];
}
function parameters(a: number, b = a + 1, ...rest: number[]) {
  const first = hold(() => ++a), second = hold(() => ++b), third = hold(() => rest.push(a));
  b += 10;
  return [first(), second(), third(), a, b, rest.join("+")];
}
function deadZones() {
  const early = hold(() => later);
  let count = 0;
  const bump = hold(() => ++count);
  let message = "";
  try {
    early();
  } catch (error) {
    message = (error as Error).name;
  }
  let later = 5;
  later += bump();
  return [message, early(), count];
}
function manyConstants(seed: number) {
  const a = seed, b = seed + 1, c = seed + 2, d = seed + 3, e = seed + 4, f = seed + 5, g = seed + 6;
  const low = hold(() => a + b + c), high = hold(() => e + f + g), all = hold(() => a + b + c + d + e + f + g), one = hold(() => d);
  return [low(), high(), all(), one()];
}
function recursion(n: number): number {
  let mine = n, shared = 0;
  const read = hold(() => mine), bump = hold(() => ++shared);
  if (n > 0) shared += recursion(n - 1);
  return read() + bump();
}

say("two counters", ...twoCounters());
say("overlapping sets", ...overlappingSets());
