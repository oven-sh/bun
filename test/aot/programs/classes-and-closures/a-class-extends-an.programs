//// a-scope-that-runs-once-holds-a-constructor-function-whose-objects-have-tags.ts
// (1) Inner functions that capture values beside their scope. (2) A scope that runs once and holds a constructor function whose objects are told apart by a tag.
const turns = Number(process.argv[3] ?? 20000);
const which = process.argv[2] ?? "all";

// `limit`, `label`, `weights` are never assigned: they are captured as values. `count` lies in the scope.
function walk(seed: number, weights: number[], label: string, depth: number): number {
  let count = seed;
  const limit = weights.length;
  function bump(by: number): number {
    count += by;
    return count;
  }
  // Calls itself, so it is not taken in whole; reads one of its three captured values on a rare path only.
  function descend(level: number): number {
    if (level <= 0) return bump(1);
    if (count < -1000000) return label.length + limit;
    return descend(level - 1) + visit(level);
  }
  function visit(level: number): number {
    if (level <= 1) return bump(weights[level & 3]);
    return descend(level - 2) + limit;
  }
  // Nobody calls it.
  function describe(): string {
    return label + count + weights.length;
  }
  return descend(depth) + visit(depth);
}

const tagged = (() => {
  let made = 0;
  function count(): void {
    made++;
  }
  const enum Kind {
    Name = 1,
    Call = 2,
  }
  interface Node {
    kind: Kind;
    pos: number;
  }
  interface Name extends Node {
    kind: Kind.Name;
    text: string;
  }
  interface Call extends Node {
    kind: Kind.Call;
    callee: Node;
  }
  function TaggedNode(this: Node, kind: Kind, pos: number) {
    this.kind = kind;
    this.pos = pos;
    count();
  }
  const NodeConstructor = TaggedNode as unknown as new (kind: Kind, pos: number) => Node;
  function createName(text: string, pos: number): Name {
    const node = new NodeConstructor(Kind.Name, pos) as Name;
    node.text = text;
    return node;
  }
  function createCall(callee: Node): Call {
    const node = new NodeConstructor(Kind.Call, callee.pos) as Call;
    node.callee = callee;
    return node;
  }
  return { createName, createCall, made: () => made };
})();

const plain = (() => {
  let made = 0;
  function countPlain(): void {
    made++;
  }
  interface Node {
    kind: number;
    pos: number;
    text?: string;
    callee?: Node;
  }
  function PlainNode(this: Node, kind: number, pos: number) {
    this.kind = kind;
    this.pos = pos;
    countPlain();
  }
  const NodeConstructor = PlainNode as unknown as new (kind: number, pos: number) => Node;
  function createName(text: string, pos: number): Node {
    const node = new NodeConstructor(1, pos);
    node.text = text;
    return node;
  }
  function createCall(callee: Node): Node {
    const node = new NodeConstructor(2, callee.pos);
    node.callee = callee;
    return node;
  }
  return { createName, createCall, made: () => made };
})();

let total = 0;
if (which === "all" || which === "walk") {
  const weights = [1, 2, 3, 4];
  for (let i = 0; i < turns; i++) total += walk(i, weights, "w", 6);
}
if (which === "all" || which === "tagged") {
  for (let i = 0; i < turns; i++) total += tagged.createCall(tagged.createName("n", i)).pos;
  total += tagged.made();
}
if (which === "all" || which === "plain") {
  for (let i = 0; i < turns; i++) total += plain.createCall(plain.createName("n", i)).pos;
  total += plain.made();
}
console.log(total);
//// a-setter-without-a-getter-hides-a-member-of-object-prototype.js
// A class body's setter without a getter, under a name that Object.prototype has, hides the member: a read answers undefined, a call throws a TypeError, and nothing from above shows through.
function tell(what, run) {
  try {
    console.log(what, String(run()));
  } catch (error) {
    console.log(what, "threw", error.name);
  }
}

class HidesToString { set toString(value) {} }
class HidesValueOf { set valueOf(value) {} }
class HidesHasOwnProperty { set hasOwnProperty(value) {} }
class HidesIsPrototypeOf { set isPrototypeOf(value) {} }
class HidesPropertyIsEnumerable { set propertyIsEnumerable(value) {} }
class HidesToLocaleString { set toLocaleString(value) {} }

const hidesToString = new HidesToString();
tell("toString applied", () => hidesToString.toString.call({ field: 9 }));
tell("toString called", () => hidesToString.toString());
tell("toString read", () => typeof hidesToString.toString + " " + typeof HidesToString.prototype.toString + " " + ("toString" in hidesToString));
tell("valueOf called", () => typeof new HidesValueOf().valueOf());
tell("hasOwnProperty called", () => new HidesHasOwnProperty().hasOwnProperty("x"));
tell("isPrototypeOf called", () => new HidesIsPrototypeOf().isPrototypeOf({}));
tell("propertyIsEnumerable called", () => new HidesPropertyIsEnumerable().propertyIsEnumerable("x"));
tell("toLocaleString called", () => new HidesToLocaleString().toLocaleString());

////= lines-21	readToString	object	object.toString
tell("one function reads both", () => typeof readToString(new HidesToString()) + " " + typeof readToString({}) + " " + typeof readToString(new HidesToString()));

class Below extends HidesToString {}
tell("from a class below", () => typeof new Below().toString);
tell("off the prototype object of the class below", () => typeof Below.prototype.toString);

class HasBoth {
  get toString() {
    return () => "from the getter";
  }
  set toString(value) {}
}
tell("a getter beside the setter", () => new HasBoth().toString());

class SetterRuns {
  stored = "nothing";
  set hasOwnProperty(value) {
    this.stored = value;
  }
}
const setterRuns = new SetterRuns();
setterRuns.hasOwnProperty = "stored through the setter";
tell("the setter runs", () => setterRuns.stored + " " + typeof setterRuns.hasOwnProperty);
tell("converted to a string", () => {
  try {
    return "text " + hidesToString;
  } catch (error) {
    return "conversion threw " + error.name;
  }
});
//// a-var-that-closures-share-is-undefined-until-its-first-store.js
// A `var` that closures share holds undefined until its first store. Each function below has a closure that may or may not run in front of that store; every line is what plain Bun prints.
const out = [];
function show(name, value) { out.push(name + ": " + (typeof value === "object" && value !== null ? JSON.stringify(value) : String(value))); }

function storedFirst() { var table = { x: 1 }; function read() { return table.x; } return read; }
show("stored first", storedFirst()());

function hoistedCallInFront() { var seen = read(); var table = { x: 1 }; function read() { return table; } return [seen, read()]; }
show("a hoisted function is called in front of the store", hoistedCallInFront());

function handedOutInFront(take) { take(() => table); var table = { x: 2 }; return () => table; }
let early;
const late = handedOutInFront(f => { early = f(); });
show("a closure is handed out and called in front of the store", [early, late()]);

function keptAndCalledLater(keep) { keep(() => table); var table = { x: 3 }; }
let kept;
keptAndCalledLater(f => { kept = f; });
show("a closure is kept in front of the store and called behind it", kept());

function storeOnOnePath(flag) { if (flag) var table = { x: 4 }; return () => table; }
show("the store stands on one path", [storeOnOnePath(true)(), storeOnOnePath(false)()]);

function storeInTry(fail) { try { var table = fail(); } catch { } return () => table; }
show("the store is left out by a throw", [storeInTry(() => ({ x: 5 }))(), storeInTry(() => { throw new Error("no"); })()]);

function storeInLoop(rounds) { const readers = []; for (let i = 0; i < rounds; i++) { var last = { x: i }; readers.push(() => last.x); } readers.push(() => last); return readers; }
show("the store stands in a loop", [storeInLoop(3).map(f => f()), storeInLoop(0).map(f => f())]);

function closureInOwnInitializer() { var self = (() => () => self)(); return self; }
const own = closureInOwnInitializer();
show("a closure in its own initializer", own() === own);

function initializerReadsItself() { var value = (() => value)(); return () => value; }
show("the initializer reads the binding", initializerReadsItself()());

function declaredTwice() { var table = { x: 6 }; const first = () => table; var table; return [first(), (() => table)()]; }
show("declared twice", declaredTwice());

function storedUndefined() { var table = { x: 7 }; const read = () => table; const before = read(); table = undefined; return [before, read()]; }
show("undefined is stored later", storedUndefined());

function storedUndefinedFirst(pick) { var table = pick ? { x: 8 } : undefined; return () => table; }
show("undefined is what the first store brings", [storedUndefinedFirst(true)(), storedUndefinedFirst(false)()]);

function withoutInitializer() { var table; const read = () => table; const before = read(); table = { x: 9 }; return [before, read()]; }
show("no initializer", withoutInitializer());

function getterInFront() { const holder = { get now() { return table; } }; const before = holder.now; var table = { x: 10 }; return [before, holder.now]; }
show("a getter runs in front of the store", getterInFront());

function defaultParameter(read = () => table) { var table = { x: 11 }; let answer; try { answer = read(); } catch (error) { answer = error.name; } return answer; }
show("a default parameter names another binding", defaultParameter());

function* generator() { const read = () => table; yield read(); var table = { x: 12 }; yield read(); }
show("a generator stops in front of the store", [...generator()]);

async function asynchronous(results) { const read = () => table; results.push(read()); await null; var table = { x: 13 }; results.push(read()); }
const awaited = [];
await asynchronous(awaited);
show("an async function waits in front of the store", awaited);

function labeled(skip) { block: { if (skip) break block; var table = { x: 14 }; } return () => table; }
show("a break leaves in front of the store", [labeled(false)(), labeled(true)()]);

function entersAgain(depth) { var mine = { x: depth }; const read = () => mine.x; return depth ? [read(), ...entersAgain(depth - 1), read()] : [read()]; }
show("each activation has its own", entersAgain(2));

function number() { var count = 0; var step = 2; function next() { count += step; return count; } return next; }
const next = number();
show("numbers", [next(), next(), next()]);

function typeofInFront() { const kind = () => typeof table; const before = kind(); var table = "text"; return [before, kind()]; }
show("typeof in front of the store", typeofInFront());

console.log(out.join("\n"));
