// Two levels of classes over a constructor function, where nobody constructs the middle class itself: with one subclass and with two.
function A() { this.x = 1; }
A.prototype.m = function () { return "A.m"; };
class Middle extends A {}
class B extends Middle { m() { return "B.m"; } }
const b = new B();
console.log(b.x, b.m(), b instanceof A);
class Fork extends A {}
class Left extends Fork { left = 2; }
class Right extends Fork { right = "r"; }
const l = new Left(), r = new Right();
console.log(JSON.stringify(l), JSON.stringify(r), l.m(), l instanceof Fork, l instanceof Right, r instanceof Right);
//// accessor-and-bound-function-names.js
// `name` gets "get ", "set ", "bound " or "[..]" from the kind of function, never from how the name is spelled. A stack frame shows the name as written, or the computed key, until `name` or `displayName` is set on the function.
function topFrame(run) {
  try {
    run();
  } catch (error) {
    for (const line of error.stack.split("\n")) {
      const frame = /^\s*at (?:(.*?) \()?[^()]*:\d+:\d+\)?$/.exec(line) ?? /^(?:(.*?)@)?.*:\d+:\d+$/.exec(line);
      if (frame) return frame[1] === undefined || frame[1] === "<anonymous>" ? "(anonymous)" : frame[1];
    }
  }
  return "(no frame)";
}

const computedKey = ["com", "puted"].join("");
const tag = Symbol("tag");
const bare = Symbol();

class Account {
  get total() { throw new Error("getter"); }
  set total(value) {}
  static get count() { return 0; }
  "get total"() { throw new Error("method"); }
  "bound total"() { throw new Error("method"); }
  [computedKey]() { throw new Error("computed key"); }
  [tag]() { throw new Error("symbol key"); }
  [bare]() {}
  #secret() {}
  static secretName(account) { return account.#secret.name; }
}
const account = new Account();

// Reading `name` of an accessor changes its frames in plain Bun, so every frame is printed before any `name` is read.
console.log("frame in a getter:", topFrame(() => account.total));
console.log("frame in a method named 'get total':", topFrame(() => account["get total"]()));
console.log("frame in a method named 'bound total':", topFrame(() => account["bound total"]()));
console.log("frame in a method with a computed key:", topFrame(() => account[computedKey]()));
console.log("frame in a method with a symbol key:", topFrame(() => account[tag]()));

function original() { throw new Error("original"); }
console.log("frame before a rename:", topFrame(original));
Object.defineProperty(original, "name", { value: "renamed" });
console.log("frame after a rename:", topFrame(original));

function plain() { throw new Error("plain"); }
plain.displayName = "shown";
console.log("frame with a displayName:", topFrame(plain));

function emptied() { throw new Error("emptied"); }
Object.defineProperty(emptied, "name", { value: "" });
console.log("frame after a rename to the empty string:", topFrame(emptied));

function makeWorker(id) { return function worker() { throw new Error("worker " + id); }; }
const workers = [makeWorker(1), makeWorker(2), makeWorker(3)];
Object.defineProperty(workers[0], "name", { value: "firstWorker" });
Object.defineProperty(workers[1], "name", { value: "secondWorker" });
console.log("frame in a closure beside two closures with new names:", topFrame(workers[2]));

function makeHelper(id) { return function helper() { throw new Error("helper " + id); }; }
const helpers = [makeHelper(1), makeHelper(2), makeHelper(3)];
helpers[0].displayName = "labeled";
console.log("frame in a closure beside one with a displayName:", topFrame(helpers[1]), topFrame(helpers[2]));

function steady() { throw new Error("steady"); }
steady.displayName = 7;
console.log("displayName is a number:", topFrame(steady));
steady.displayName = "";
console.log("displayName is empty:", topFrame(steady));
Object.defineProperty(steady, "displayName", { get() { return "fromGetter"; }, configurable: true });
console.log("displayName is a getter:", topFrame(steady));
Object.defineProperty(steady, "displayName", { value: "briefly", configurable: true });
console.log("displayName is a string:", topFrame(steady));
delete steady.displayName;
console.log("displayName is deleted:", topFrame(steady));

const worker = { work() { throw new Error("work"); } };
const boundWork = worker.work.bind(worker);
Object.defineProperty(boundWork, "name", { value: "handler" });
console.log("frame in a method whose bound function has a new name:", topFrame(() => worker.work()), topFrame(boundWork));
boundWork.displayName = "labeledHandler";
console.log("frame in a method whose bound function has a displayName:", topFrame(() => worker.work()), topFrame(boundWork));

function target() {}
const total = Object.getOwnPropertyDescriptor(Account.prototype, "total");
const names = [
  ["a getter", total.get],
  ["a setter", total.set],
  ["a static getter", Object.getOwnPropertyDescriptor(Account, "count").get],
  ["a method named 'get total'", account["get total"]],
  ["a method named 'bound total'", account["bound total"]],
  ["a method with a computed key", account[computedKey]],
  ["a method with a symbol key", account[tag]],
  ["a method with a symbol key without a description", account[bare]],
  ["a bound function", target.bind(null)],
  ["a bound function bound again", target.bind(null).bind(null)],
  ["a bound method named 'bound total'", account["bound total"].bind(account)],
  ["a bound getter", total.get.bind(account)],
];
for (const [what, f] of names) console.log("name of " + what + ":", JSON.stringify(f.name));
console.log("name of a private method:", JSON.stringify(Account.secretName(account)));

const literal = { [computedKey]: function () {} };
for (const [what, f] of [["a method", account[computedKey]], ["a function in an object literal", literal[computedKey]]]) {
  try {
    f.name = "stored";
  } catch {}
  console.log("name of " + what + " with a computed key after a store to it:", JSON.stringify(f.name));
}
Object.defineProperty(account[tag], "name", { writable: true });
console.log("name of a method with a symbol key after it is made writable:", JSON.stringify(account[tag].name));
//// accessors-through-open-types.ts
// Getters and setters of classes, read and stored through a parameter whose class type also receives values of type `any`.
// The compiler may call the accessor directly for an object of the class. Every other object must behave as in plain JavaScript.
class Account {
  cents: number;
  reads = 0;
  constructor(cents: number) {
    this.cents = cents;
  }
  get dollars(): number {
    this.reads++;
    return this.cents / 100;
  }
  set dollars(value: number) {
    this.cents = value * 100;
  }
  get isEmpty(): boolean {
    return this.cents === 0;
  }
}

class Savings extends Account {
  get dollars(): number {
    return super.dollars + 1;
  }
  set dollars(value: number) {
    super.dollars = value - 1;
  }
}

class Frozen extends Account {}

function readDollars(a: Account): number {
  return a.dollars;
}

function readTwice(a: Account): number {
  return a.dollars + a.dollars;
}

function storeDollars(a: Account, value: number): void {
  a.dollars = value;
}

function isEmpty(a: Account | undefined): boolean | undefined {
  return a?.isEmpty;
}

function report(label: string, run: () => unknown): void {
  try {
    console.log(label + ":", String(run()));
  } catch (e) {
    console.log(label + ":", "throws", (e as Error).name);
  }
}

const anything = (value: unknown): any => value;

report("an object of the class", () => readDollars(new Account(150)));
report("through any", () => readDollars(anything(new Account(250))));
report("a subclass that overrides", () => readDollars(anything(new Savings(300))));
report("a subclass that inherits", () => readDollars(anything(new Frozen(400))));
report("a plain object with the property", () => readDollars(anything({ cents: 1, reads: 0, dollars: 7, isEmpty: false })));
report("a plain object with a getter", () => readDollars(anything({ cents: 1, reads: 0, get dollars() { return 8; }, isEmpty: false })));
report("an object that inherits from an instance", () => readDollars(anything(Object.create(new Account(500)))));
report("a proxy of an instance", () => {
  const seen: string[] = [];
  const proxy = new Proxy(new Account(600), { get(target, key, receiver) { seen.push(String(key)); return Reflect.get(target, key, receiver); } });
  return readDollars(anything(proxy)) + " " + seen.join();
});
report("null", () => readDollars(anything(null)));
report("undefined", () => readDollars(anything(undefined)));
report("the getter runs each time", () => {
  const a = new Account(100);
  return readTwice(anything(a)) + " reads " + a.reads;
});
report("a getter that throws", () => {
  class Broken extends Account {
    get dollars(): number {
      throw new RangeError("no");
    }
  }
  return readDollars(anything(new Broken(1)));
});
report("the setter", () => {
  const a = new Account(0);
  storeDollars(anything(a), 3);
  return a.cents;
});
report("the setter of a subclass", () => {
  const a = new Savings(0);
  storeDollars(anything(a), 3);
  return a.cents;
});
report("a store to a plain object", () => {
  const o = { cents: 1, reads: 0, dollars: 7, isEmpty: false };
  storeDollars(anything(o), 9);
  return o.dollars + " " + o.cents;
});
report("a store to a plain object with a setter", () => {
  let stored = 0;
  const o = { cents: 1, reads: 0, get dollars() { return stored; }, set dollars(v: number) { stored = v + 1; }, isEmpty: false };
  storeDollars(anything(o), 9);
  return stored;
});
report("a store to null", () => storeDollars(anything(null), 1));
report("optional chaining", () => [isEmpty(anything(new Account(0))), isEmpty(anything(new Account(1))), isEmpty(undefined), isEmpty(anything({ isEmpty: true }))].join());
for (let i = 0; i < 4; i++) report("mixed " + i, () => readDollars(anything(i % 2 ? { dollars: i } : new Account(i * 100))));
//// accessors-under-names-that-a-class-has-from-its-creation.js
// A class has `constructor` on its prototype object and `name` and `length` on itself from its creation. An accessor that the class body defines under such a name takes the place of that property: with a setter alone a read answers undefined, and nothing from above shows through.
function tell(what, run) {
  try {
    const answer = run();
    console.log(what, typeof answer, typeof answer === "object" && answer !== null ? Object.getPrototypeOf(answer) === Object.prototype : String(answer));
  } catch (error) {
    console.log(what, "threw", error.name);
  }
}

class OnlySetter { set ["constructor"](value) {} }
const onlySetter = new OnlySetter();
tell("setter alone, read", () => onlySetter.constructor);
tell("setter alone, constructed", () => new onlySetter.constructor());
tell("setter alone, called", () => onlySetter.constructor());
tell("setter alone, compared", () => onlySetter.constructor === undefined);
tell("setter alone, name of it", () => onlySetter.constructor.name);

class OnlyGetter { get ["constructor"]() { return Array; } }
const onlyGetter = new OnlyGetter();
tell("getter, read", () => onlyGetter.constructor === Array);
tell("getter, constructed", () => Array.isArray(new onlyGetter.constructor()));

class Below extends OnlySetter {}
const below = new Below();
tell("its own below the setter", () => below.constructor === Below);
delete Below.prototype.constructor;
tell("the setter from below", () => below.constructor);
tell("the setter from below, constructed", () => new below.constructor());

