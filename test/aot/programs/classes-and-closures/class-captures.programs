function make() { return class extends Base { y = 2; }; }
const A = make(), B = make();
const a = new A, b = new B;
console.log(a.run(), a.y, Base.has(a), Base.hasAccessor(a), b.run(), Base.has(b), Base.has({}), Object.keys(a).join());
