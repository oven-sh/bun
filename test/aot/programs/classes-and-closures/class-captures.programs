//// class-objects-constructed-through-values.js
const collect = globalThis.Bun ? full => globalThis.Bun.gc(full) : full => (full ? fullGC() : edenGC());

function constructOne(constructor, value) {
  return new constructor(value);
}

function callOne(callee, value) {
  return callee(value);
}

class Base {
  constructor(x) {
    this.x = x;
  }
  describe() {
    return "base " + this.x;
  }
}

class WithStatics {
  static made = 0;
  static make(x) {
    return new this(x);
  }
  constructor(x) {
    this.x = x;
    WithStatics.made++;
  }
}

class Derived extends Base {
  constructor(x) {
    super(x + 1);
    this.y = x;
  }
}

class DerivedTwice extends Derived {
  describe() {
    return "twice " + super.describe() + " " + this.y;
  }
}

function mixin(Parent, tag) {
  return class extends Parent {
    constructor(x) {
      super(x);
      this.tag = tag;
    }
  };
}

function makeClass(tag) {
  return class {
    constructor(x) {
      this.x = x;
      this.tag = tag;
    }
  };
}

////= lines-36	OldStyle	x	this.x	x
////= lines-64	OldStyle	describe	"old "	x
OldStyle.extra = 1;

class OverOldStyle extends OldStyle {}
class OverMap extends Map {}
class OverArray extends Array {}

const lines = [];
for (let round = 0; round < 4; ++round) {
  lines.push(constructOne(Base, round).describe(), constructOne(WithStatics, round).x, WithStatics.make(round).x, WithStatics.made);
  lines.push(constructOne(Derived, round).describe(), constructOne(Derived, round).y, constructOne(DerivedTwice, round).describe());
  const Mixed = mixin(round % 2 ? Base : Derived, "m" + round);
  lines.push(constructOne(Mixed, round).describe(), constructOne(Mixed, round).tag, constructOne(mixin(Mixed, "again"), round).tag);
  lines.push(constructOne(makeClass(round), round).tag, constructOne(OldStyle, round).describe(), constructOne(OverOldStyle, round).describe());
  lines.push(constructOne(OverMap, [[round, round]]).get(round), constructOne(OverArray, 3).length, constructOne(OverArray, 3) instanceof OverArray);
  if (round === 1) Base.added = round;
  if (round === 2) Object.setPrototypeOf(Derived, OldStyle);
  collect(round % 2 === 0);
}
for (const callee of [Base, Derived, makeClass(1)]) {
  try {
    callOne(callee, 1);
    lines.push("called");
  } catch (error) {
    lines.push(error instanceof TypeError);
  }
}

let constructed = 0;
let refused = 0;
for (let round = 0; round < 6; ++round) {
  for (let i = 0; i < 200; ++i) {
    const Made = mixin(makeClass(i), i);
    Made["static" + i] = i;
    constructed += constructOne(Made, 1).x;
  }
  collect(true);
  for (let i = 0; i < 400; ++i) {
    const plain = { ["key" + round + "x" + i]: i };
    try {
      constructOne(plain, 1);
      lines.push("constructed a plain object");
    } catch (error) {
      refused += error instanceof TypeError ? 1 : 0;
    }
  }
}
lines.push(constructed, refused);
console.log(lines.join("\n"));
//// class-prototype-additions-through-untyped-code.ts
const untyped: any = {
  add(target: any, key: any, value: any) {
    target[key] = value;
  },
  define(target: any, key: any, descriptor: any) {
    Object.defineProperty(target, key, descriptor);
  },
  remove(target: any, key: any) {
    return delete target[key];
  },
  read(target: any, key: any) {
    return target[key];
  },
  readExtra(target: any) {
    return target.extra;
  },
  storeExtra(target: any, value: any) {
    target.extra = value;
  },
  prototypeOf(target: any) {
    return Object.getPrototypeOf(target);
  },
};
////= attempt-2
function warm(read: () => unknown): string {
  let seen = "";
  for (let i = 0; i < 5; i++) seen = String(read());
  return seen;
}

class C1 { n = 1; m() { return this.n; } }
class C2 { n = 1; }
class C3 { n = 1; }
class C4 { n = 3; }
class C5 { n = 3; }
class C6 { n = 4; }
class A7 { n = 1; }
class B7 extends A7 { k = 2; }
class A8 { n = 1; }
class B8 extends A8 { k = 2; }
class A9 { who() { return "A9"; } }
class B9 extends A9 { k = 2; }
class C10 { n = 1; }
class C11 { n = 1; }
class C12 { n = 1; }
class C13 { n = 1; declare note?: string; }
class C14 { n = 1; }
class C16 { n = 1; }
class C17 { n = 1; }
class C18 { n = 1; }
class C20 { n = 1; m() {} }
class C21 { who() { return "declared"; } }
class C22 { who() { return "declared"; } }

