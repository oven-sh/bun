var unseen = new Function("x", "return x");
class Failure extends Error {
  static make(text) { return new Failure(text); }
  describe() { return "failure " + this.message; }
  get kind() { return "plain"; }
}
class Worse extends Failure {
  describe() { return "worse " + super.describe(); }
}
class Bag extends Map {
  static of(key, value) { var bag = new Bag(); bag.set(key, value); return bag; }
  first() { return this.keys().next().value; }
}
class Row extends Array {
  sum() { var total = 0; for (var index = 0; index < this.length; index++) total += this[index]; return total; }
}
function ask() {
  var failure = Failure.make("a");
  var worse = new Worse("b");
  var bag = Bag.of("k", 1);
  var row = Row.from([1, 2, 3]);
  return [failure.describe(), failure.kind, worse.describe(), worse.kind, bag.first(), bag.size, row.sum(), row.length, Row.isArray(row), typeof Failure.captureStackTrace,
    failure instanceof Failure, worse instanceof Failure, worse instanceof Error, bag instanceof Map, row instanceof Row, failure.toString(), Failure.name, Worse.length].join(" | ");
}
for (var round = 0; round < 3; round++)
  console.log(ask());
unseen(Failure).prototype.describe = function () { return "replaced " + this.message; };
console.log(ask());
Object.defineProperty(unseen(Failure).prototype, "kind", { get: function () { return "other"; }, configurable: true });
console.log(ask());
unseen(Failure).make = function (text) { return new Worse(text + "!"); };
console.log(ask());
Object.setPrototypeOf(unseen(Worse).prototype, Error.prototype);
try { console.log(ask()); } catch (error) { console.log(error.name); }
Object.setPrototypeOf(unseen(Worse).prototype, Failure.prototype);
console.log(ask());
Object.setPrototypeOf(unseen(Bag), Object);
console.log(typeof Bag.groupBy, typeof Bag.keys);
unseen(Row).prototype.sum = undefined;
try { console.log(ask()); } catch (error) { console.log(error.name); }
//// classes-constructed-through-values.ts
const collect: () => void = (globalThis as any).gc ?? (() => (globalThis as any).Bun.gc(true));
class Pair { first: number; second: string; rest: number[] = []; note?: string; constructor(first: number, second: string) { this.first = first; this.second = second; } total() { return this.first + this.second.length + this.rest.length; } }
class Wide extends Pair { a = 1; b = 2; c = 3; d = "four"; e: Pair | null = null; constructor(first: number, second: string) { super(first, second); this.rest.push(first); } }
class Empty { }
class SeesNewTarget { which: string; constructor() { this.which = new.target === SeesNewTarget ? "itself" : new.target.name; } }
class Heir extends SeesNewTarget { }
const classes: any[] = [Pair, Wide, Empty, SeesNewTarget, Heir];
const kept: any[] = [];
let sum = 0;
let withNote = 0;
for (let round = 0; round < 3000; round++) {
  const made = new classes[round % classes.length](round, "s" + round);
  if (Object.getPrototypeOf(made) !== classes[round % classes.length].prototype) throw new Error("wrong prototype");
  if (made instanceof Pair) {
    sum += made.total();
    if (made.rest === kept[kept.length - 1]?.rest) throw new Error("shared array");
    if ("note" in made) withNote++;
  }
  if (round % 211 === 0) kept.push(made);
  if (round % 700 === 0) collect();
}
console.log(sum, withNote, kept.length, kept.map(made => made.constructor.name + ":" + Object.keys(made).join("|")).join(" "));
console.log(new classes[3]().which, new classes[4]().which);
for (let round = 0; round < 6; round++) {
  const throughBase = Reflect.construct(Pair, [round, "r"], Wide) as any;
  const itself = new classes[1](round, "w");
  const base = new classes[0](round, "p");
  console.log(Object.getPrototypeOf(throughBase) === Wide.prototype, Object.keys(throughBase).join("|"), Object.keys(itself).join("|"), itself.total(), Object.keys(base).join("|"), Object.getPrototypeOf(base) === Pair.prototype);
}
