//// closures-stored-into-fields-of-objects-that-start-in-the-frame.ts
// An object that need not outlive its function is made with unread members and members that hold undefined or null; on some paths it leaves the function after all.
const lines: string[] = [];
////= say-3
// n & 1: `maybe` is a function, else undefined. n & 2: `none` is a function, else null.
////= kit-3

const escaped: Kit[] = [];
function local(i: number): string {
  const one = kit("local" + i, i);
  if (i % 7 === 0) escaped.push(one);
  return i % 3 === 0 ? one.own() : i % 3 === 1 ? String(one.first()) : String(one.maybe ? one.maybe() : one.none);
}
function takesFunction(i: number): () => string {
  const one = kit("taken" + i, i);
  return i % 2 ? one.own : () => one.own() + " indirectly";
}
function compares(i: number): boolean {
  const one = kit("compared" + i, i);
  const other = { ...one };
  return one.own === other.own && one.first === other.first && one.maybe === other.maybe && one.none === other.none && other.own() === "compared" + i + " owns";
}
const results: string[] = [];
let same = 0;
for (let i = 0; i < 42; i++) {
  results.push(local(i));
  if (compares(i)) same++;
}
say(results.join());
say("escaped", escaped.map(show).join(" ; "));
say("taken", [0, 1, 2, 3].map(i => takesFunction(i)()).join(), "same", same);

console.log(lines.join("\n"));
//// closures-stored-into-fields-of-typed-literals.ts
// One declared type, many ways to make a value of it: literals with arrow members in several functions, members stored later, members left out, copies by spread and Object.assign,
// members taken from other objects, and untyped code that stores what it likes.
interface Tools {
  label: string;
  first: () => number;
  second: () => string;
  third: (source: string) => string;
  own: () => string;
  late?: () => string;
  maybe?: () => number;
}
const lines: string[] = [];
////= say
let calls = 0;
function count() {
  return ++calls;
}

function full(label: string): Tools {
  const tools = {
    label,
    first: () => count(),
    second: () => "second",
    third: source => source + "!",
  } as Tools;
  tools.own = () => tools.label + " owns";
  return tools;
}
function other(label: string): Tools {
  const tools: Tools = {
    label,
    first: () => 7,
    second: () => "other second",
    third: source => source + "?",
    own: () => "nobody owns",
  };
  return tools;
}
function withLate(label: string, late: boolean): Tools {
  const tools = full(label);
  if (late) tools.late = () => tools.label + " is late";
  return tools;
}
function copyOf(tools: Tools): Tools {
  return { ...tools, second: () => "copied second" };
}
function relabeled(tools: Tools, label: string): Tools {
  return { ...tools, label };
}
function assigned(tools: Tools): Tools {
  return Object.assign({} as Tools, tools, { maybe: () => 1 });
}
function borrowed(from: Tools, label: string): Tools {
  return { label, first: from.first, second: from.second, third: from.third, own: from.own };
}
function shared(label: string): Tools {
  const second = () => "shared second";
  const tools: Tools = { label, first: () => 1, second, third: source => second() + source, own: () => label };
  return tools;
}
function use(tools: Tools, n: number): string {
  switch (n % 5) {
    case 0:
      return String(tools.first());
    case 1:
      return tools.second();
    case 2:
      return tools.third("x");
    case 3:
      return tools.own();
    default:
      return (tools.late ? tools.late() : "no late") + (tools.maybe ? tools.maybe() : "");
  }
}

const makers: ((i: number) => Tools)[] = [
  i => full("full" + i),
  i => other("other" + i),
  i => withLate("late" + i, i % 2 === 0),
  i => copyOf(full("copied" + i)),
  i => relabeled(full("before" + i), "relabeled" + i),
  i => assigned(full("assigned" + i)),
  i => borrowed(full("lender" + i), "borrower" + i),
  i => shared("shared" + i),
];
const made: Tools[] = [];
for (let i = 0; i < 80; i++) made.push(makers[i % makers.length](i));
// Read only after all of them are made.
const used: string[] = [];
for (let i = 0; i < made.length; i++) used.push(use(made[i], i >> 3));
for (let i = 0; i < made.length; i += 16) say("used", used.slice(i, i + 16).join());
say("keys", made.slice(0, 8).map(tools => Object.keys(tools).join("+")).join());
say("identity", made.every(tools => tools.first === tools.first && tools.own === tools.own && tools.third === tools.third), made[0].first !== made[8].first, made[1].second !== made[9].second);

// A copy holds the very functions of its source, read or not.
const source = full("source");
const ownBefore = source.own;
const copy = copyOf(source);
const renamed = relabeled(source, "renamed");
say("copies", copy.first === source.first, copy.own === ownBefore, copy.second !== source.second, renamed.own === source.own, renamed.own(), renamed.label, copy.own());
const unread = full("unread");
const copyOfUnread = relabeled(unread, "copy");
say("copy of unread", copyOfUnread.own === unread.own, copyOfUnread.third === unread.third, copyOfUnread.own(), unread.own());
const lender = full("lender");
const borrower = borrowed(lender, "borrower");
say("borrowed", borrower.own === lender.own, borrower.own(), borrower.first === lender.first);

// Stores from outside, typed.
const changed = full("changed");
const firstBefore = changed.first;
changed.first = () => 100;
changed.second = other("x").second;
changed.own = () => changed.label + " changed";
say("stores", changed.first(), firstBefore !== changed.first, changed.second(), changed.own(), changed.first === changed.first, Object.keys(changed).join());
changed.late = undefined;
say("undefined stored", changed.late, "late" in changed, Object.keys(changed).join());
delete changed.late;
delete changed.maybe;
say("deleted", "late" in changed, Object.keys(changed).join());

// Stores from outside, untyped.
function meddle(value: any, name: string, stored: unknown) {
  value[name] = stored;
  return value;
}
const meddled = full("meddled");
meddle(meddled, "first", 5);
meddle(meddled, "own", function (this: Tools) {
  return "own of " + this.label;
});
meddle(meddled, "third", lender.third);
meddle(meddled, "added", () => "added");
say("meddled", (meddled as any).first, meddled.own(), meddled.third === lender.third, (meddled as any).added(), Object.keys(meddled).join());
function callFirst(tools: Tools) {
  try {
    return String(tools.first());
  } catch (error) {
    return (error as Error).constructor.name;
  }
}
say("called after meddling", callFirst(meddled), callFirst(full("fine")), callFirst(other("fine")));

// The same functions for many objects, made in a loop and kept.
const pool: Tools[] = [];
for (let i = 0; i < 50; i++) pool.push(i % 10 === 0 ? other("o" + i) : full("f" + i));
let total = 0;
for (const tools of pool) total += tools.first() + tools.own().length + tools.third("ab").length;
say("pool", total, new Set(pool.map(tools => tools.first)).size, new Set(pool.map(tools => tools.own)).size);

console.log(lines.join("\n"));
//// closures-stored-into-fields-or-undefined-or-null.ts
// Fields that hold an arrow function in one object and undefined or null in another: given by literals, by constant literals, by stores, by name, by spreads and by classes.
const lines: string[] = [];
////= say
////= attempt

type Hooks = {
  name: string;
  onStart: (() => string) | undefined;
  onData: ((chunk: string) => string) | null;
  onEnd?: () => string;
  onError: (() => string) | undefined | null;
};

// Nothing but constants.
const none: Hooks = { name: "none", onStart: undefined, onData: null, onError: null };
function full(name: string): Hooks {
  const hooks: Hooks = {
    name,
    onStart: () => "start " + hooks.name,
    onData: chunk => chunk + " for " + hooks.name,
    onEnd: () => "end",
    onError: () => "error",
  };
  return hooks;
}
function partial(name: string, n: number): Hooks {
  return {
    name,
    onStart: n & 1 ? () => "start" : undefined,
    onData: n & 2 ? chunk => chunk + "!" : null,
    onError: n & 4 ? () => "error" : n & 8 ? null : undefined,
  };
}
function describe(hooks: Hooks) {
  return [
    hooks.name,
    hooks.onStart?.(),
    hooks.onData?.("d") ?? "no data",
    hooks.onEnd ? hooks.onEnd() : "no end",
    hooks.onError === null ? "null" : hooks.onError === undefined ? "undefined" : hooks.onError(),
    typeof hooks.onStart,
    typeof hooks.onData,
    typeof hooks.onEnd,
    "onEnd" in hooks,
    Object.keys(hooks).join("+"),
  ].join(" | ");
}

say(describe(none));
say(describe(full("a")));
for (let n = 0; n < 16; n += 3) say(describe(partial("p" + n, n)));

// Stores that replace a closure that was never made, and one that was.
const replaced = full("replaced");
replaced.onStart = undefined;
replaced.onData = null;
const madeEnd = replaced.onEnd;
replaced.onEnd = undefined;
replaced.onError = null;
say(describe(replaced), madeEnd?.());
replaced.onStart = () => "again " + replaced.name;
replaced.onData = chunk => chunk + " again";
replaced.onError = undefined;
say(describe(replaced));

// By a name that the compiler cannot see.
const names = ["onStart", "onData", "onEnd", "onError"] as const;
const byName = full("by name");
const loose = byName as unknown as Record<string, unknown>;
for (const name of names) {
  loose[name] = names.indexOf(name) % 2 ? null : undefined;
}
say(describe(byName), JSON.stringify(byName));
for (const name of names) loose[name] = () => "stored by name " + name;
say(describe(byName));
for (const name of names) say(name, delete loose[name], name in loose, loose[name]);
say(describe(byName));

// Copies.
const copyOfNone = { ...none };
const copyOfFull = { ...full("copied"), onStart: undefined };
const merged: Hooks = Object.assign(full("merged"), none, { name: "merged again" });
say(describe(copyOfNone));
say(describe(copyOfFull));
say(describe(merged));
const overNone: Hooks = { ...none, ...full("over none") };
say(describe(overNone), overNone.onStart === overNone.onStart);

// Identity and truthiness around the values.
const many: Hooks[] = [];
for (let i = 0; i < 40; i++) many.push(i % 4 === 0 ? none : i % 4 === 1 ? full("f" + i) : partial("p" + i, i));
let started = 0;
let data = 0;
let errors = 0;
for (const hooks of many) {
  if (hooks.onStart) started++;
  if (hooks.onData !== null) data++;
  if (hooks.onError == null) errors++;
}
say("counts", started, data, errors, many[1].onStart === many[1].onStart, many[1].onStart !== many[5].onStart, many[0].onStart === many[4].onStart);

// Classes: a field that starts as undefined or null and gets its arrow later, or the other way round.
class Task {
  done: (() => string) | undefined = undefined;
  failed: (() => string) | null = null;
  always = () => "always " + this.label;
  constructor(public label: string) {}
  arm() {
    this.done = () => "done " + this.label;
    this.failed = () => "failed " + this.label;
    return this;
  }
  disarm() {
    this.done = undefined;
    this.failed = null;
    (this as { always: unknown }).always = undefined;
    return this;
  }
}
function report(task: Task) {
  return [task.label, task.done?.(), task.failed?.(), attempt(() => task.always()), Object.keys(task).join("+")].join(" | ");
}
say(report(new Task("fresh")));
say(report(new Task("armed").arm()));
say(report(new Task("disarmed").arm().disarm()));
say(report(new Task("armed again").arm().disarm().arm()));
const frozenTask = Object.freeze(new Task("frozen"));
say(attempt(() => frozenTask.arm()), report(frozenTask));

console.log(lines.join("\n"));
//// closures-stored-into-fields-read-and-called-by-name.ts
// Code that knows nothing of the type reads, calls, tests and stores the members by name, before anything has read them.
const lines: string[] = [];
////= say-3
// n & 1: `maybe` is a function, else undefined. n & 2: `none` is a function, else null.
////= kit-3

const names = ["first", "own", "maybe", "none", "label", "missing"];
function readByName(object: any, name: string) {
  return object[name];
}
function callByName(object: any, name: string) {
  return object[name]();
}
function readFirst(object: any) {
  return object.first;
}
function callOwn(object: any) {
  return object.own();
}
function callMaybe(object: any) {
  return object.maybe?.();
}
function storeByName(object: any, name: string, value: unknown) {
  object[name] = value;
}
for (let round = 0; round < 30; round++) {
  const n = round & 3;
  const a = kit("a" + round, n);
  const called = [callOwn(a), callMaybe(a), attempt(() => callByName(a, "none")), attempt(() => callByName(a, "first")), attempt(() => callByName(a, "missing"))].join();
  const b = kit("b" + round, n);
  const read = names.map(name => typeof readByName(b, name)).join();
  const identity = [readFirst(b) === b.first, readByName(b, "own") === b.own, readByName(b, "maybe") === b.maybe, readByName(b, "none") === b.none].join();
  const c = kit("c" + round, n);
  const present = names.map(name => +(name in c) + "" + +Object.hasOwn(c, name)).join();
  const d = kit("d" + round, n);
  storeByName(d, "first", n & 1 ? () => 9 : d.first);
  storeByName(d, "maybe", n & 1 ? undefined : () => "stored maybe");
  storeByName(d, "none", n & 2 ? null : () => "stored none");
  if (round < 4 || round > 27) say(round, called, read, identity, present, show(d));
}

console.log(lines.join("\n"));
//// closures-stored-into-fields-read-by-evaluated-text.ts
// Text that is evaluated at run time reads, calls, tests and stores the members, before anything has read them.
const lines: string[] = [];
////= say-3
// n & 1: `maybe` is a function, else undefined. n & 2: `none` is a function, else null.
////= kit-3

const read = new Function("kit", "return [typeof kit.first, typeof kit.own, typeof kit.maybe, typeof kit.none, kit.own(), kit.first(), 'maybe' in kit, 'none' in kit, Object.keys(kit).join('+')].join()");
const take = new Function("kit", "return [kit.first, kit.own, kit.maybe, kit.none]");
const store = new Function("kit", "n", "kit.first = n & 1 ? kit.first : () => 7; kit.maybe = n & 1 ? undefined : () => 'evaluated maybe'; kit.none = n & 2 ? null : () => 'evaluated none'; return kit");
for (let round = 0; round < 24; round++) {
  const n = round & 3;
  const text = read(kit("a" + round, n));
  const b = kit("b" + round, n);
  const taken = take(b) as unknown[];
  const identity = [taken[0] === b.first, taken[1] === b.own, taken[2] === b.maybe, taken[3] === b.none].join();
  const stored = show(store(kit("c" + round, n), n) as Kit);
  if (round < 4 || round > 21) say(round, text, identity, stored);
}

console.log(lines.join("\n"));
//// closures-stored-into-fields-read-by-native-code.ts
// Native code that walks an object meets members whose function objects nobody has made yet. It sees functions, the very ones that a later read gives, and undefined and null where a store put them.
import { inspect, isDeepStrictEqual } from "node:util";
import { serialize } from "node:v8";

const lines: string[] = [];
////= say

interface Kit {
  label: string;
  first: () => number;
  maybe: (() => string) | undefined | null;
  own: () => string;
}
let calls = 0;
////= kit-2	maybe: () => label + " maybe"
function without(label: string, nothing: undefined | null): Kit {
  const made = kit(label);
  made.maybe = nothing;
  return made;
}

class Handler {
  label: string;
  own = () => this.label + " handles";
  maybe: (() => string) | undefined | null = () => "maybe " + this.label;
  constructor(label: string, nothing?: null) {
    this.label = label;
    if (nothing !== undefined || label === "nothing") this.maybe = nothing;
  }
}

function onOneLine(text: string) {
  return text.replace(/\s+/g, " ");
}
function nameOfWhatIsThrown(run: () => unknown) {
  try {
    run();
    return "nothing";
  } catch (error) {
    return (error as Error).name;
  }
}
// What a reader saw must be what a read gives afterwards, and the functions still capture their own object.
function stillWhole(made: Kit) {
  const own = made.own;
  const maybe = made.maybe;
  return [own === made.own, own(), maybe === made.maybe, maybe ? maybe() : String(maybe), typeof made.first].join(" ");
}

// Printing.
console.log(kit("printed"));
console.log(without("printed", undefined), without("printed", null));
console.log(new Handler("printed"), new Handler("nothing"), new Handler("printed", null));
say("inspect", onOneLine(inspect(kit("a"))), onOneLine(inspect(without("a", null))), onOneLine(inspect(without("a", undefined))));
say("Bun.inspect", onOneLine(Bun.inspect(kit("b"))), onOneLine(Bun.inspect(new Handler("b"))), onOneLine(Bun.inspect(new Handler("b", null))));
const printed = kit("c");
inspect(printed);
say("after inspect", stillWhole(printed));

// Deep equality.
const compared = kit("d");
say("deep", isDeepStrictEqual(compared, compared), isDeepStrictEqual(kit("d"), kit("d")), Bun.deepEquals(compared, compared), Bun.deepEquals(kit("d"), kit("d")));
say("deep with nothing", isDeepStrictEqual(without("d", null), without("d", undefined)), Bun.deepEquals(without("d", null), without("d", null), true));
const comparedWithCopy = kit("e");
say("deep with copy", isDeepStrictEqual(comparedWithCopy, { ...comparedWithCopy }), Bun.deepEquals(comparedWithCopy, { ...comparedWithCopy }, true), stillWhole(comparedWithCopy));

// Serializers: a function cannot be cloned, undefined and null can.
const cloned = kit("f");
say("structuredClone", nameOfWhatIsThrown(() => structuredClone(cloned)), stillWhole(cloned));
const sent = kit("g");
const { port1, port2 } = new MessageChannel();
say("postMessage", nameOfWhatIsThrown(() => port1.postMessage(sent)), stillWhole(sent));
port1.close();
port2.close();
const serialized = kit("h");
say("serialize", nameOfWhatIsThrown(() => serialize(serialized)), stillWhole(serialized));
say("JSON", JSON.stringify(kit("i")), JSON.stringify(without("i", null)), JSON.stringify(without("i", undefined)), JSON.stringify([new Handler("i"), new Handler("i", null), new Handler("nothing")]));
say("JSON with replacer", JSON.stringify(kit("j"), (key, value) => (typeof value === "function" ? "function " + key : value)), JSON.stringify(without("j", undefined), (key, value) => (value === undefined ? "undefined " + key : typeof value === "function" ? 1 : value)));

// The collector and the heap snapshots.
const collected: Kit[] = [];
for (let i = 0; i < 200; i++) collected.push(i % 3 === 0 ? kit("k" + i) : without("k" + i, i % 3 === 1 ? null : undefined));
Bun.gc(true);
say("snapshots", typeof Bun.generateHeapSnapshot(), typeof Bun.generateHeapSnapshot("v8"));
Bun.gc(true);
say("after collections", stillWhole(collected[0]), "|", stillWhole(collected[1]), "|", stillWhole(collected[2]), "|", stillWhole(collected[198]), new Set(collected.map(each => each.own)).size);

// Listing and copying by the standard library.
const listed = kit("l");
const fromEntries = Object.fromEntries(Object.entries(listed)) as unknown as Kit;
say("fromEntries", fromEntries.own === listed.own, fromEntries.first === listed.first, fromEntries.maybe === listed.maybe, fromEntries.own());
const described = kit("m");
const redefined = Object.defineProperties({}, Object.getOwnPropertyDescriptors(described)) as Kit;
say("descriptors", redefined.own === described.own, redefined.maybe === described.maybe, redefined.own(), Object.keys(redefined).join());
say("descriptor of nothing", JSON.stringify(Object.getOwnPropertyDescriptor(without("m", null), "maybe")), JSON.stringify(Object.getOwnPropertyDescriptor(without("m", undefined), "maybe")), "maybe" in without("m", undefined), Object.hasOwn(without("m", null), "maybe"));
const reflected = kit("n");
say("Reflect", Reflect.get(reflected, "own") === reflected.own, Reflect.has(reflected, "maybe"), Reflect.ownKeys(reflected).join(), Reflect.get(without("n", null), "maybe"), Reflect.get(without("n", undefined), "maybe"));
say("values", Object.values(kit("o")).map(value => typeof value).join(), Object.values(without("o", null)).map(String)[2], Object.values(without("o", undefined)).map(String)[2]);
const keysInLoop: string[] = [];
for (const key in without("p", null)) keysInLoop.push(key);
say("for in", keysInLoop.join());
const { label, ...rest } = kit("q");
say("rest", label, Object.keys(rest).join(), rest.own(), typeof rest.maybe);
const restOfNothing = (({ label, ...others }: Kit) => others)(without("q", null));
say("rest of nothing", Object.keys(restOfNothing).join(), restOfNothing.maybe, restOfNothing.own());

// Integrity levels, set before anybody has read a member.
const frozen = Object.freeze(kit("s"));
say("frozen", Object.isFrozen(frozen), stillWhole(frozen), nameOfWhatIsThrown(() => ((frozen as Kit).own = () => "other")), frozen.own());
const sealed = Object.seal(without("t", null));
say("sealed", Object.isSealed(sealed), stillWhole(sealed), nameOfWhatIsThrown(() => delete (sealed as Partial<Kit>).own));
sealed.maybe = () => "late";
say("sealed and stored", stillWhole(sealed));

// Behind a proxy, and as a prototype.
const target = kit("u");
const proxy = new Proxy(target, {});
say("proxy", proxy.own === target.own, proxy.own(), Object.keys(proxy).join());
const base = kit("v");
const heir = Object.create(base) as Kit;
say("heir", heir.own === base.own, heir.own(), Object.keys(heir).length, "maybe" in heir);
heir.label = "heir";
say("heir with its own label", heir.own(), base.label);

// Nothing, then a function, then nothing again.
const turning = without("w", undefined);
const seen: string[] = [];
for (let i = 0; i < 6; i++) {
  seen.push(turning.maybe ? turning.maybe() : String(turning.maybe));
  turning.maybe = i % 3 === 0 ? () => "turn " + i : i % 3 === 1 ? null : undefined;
}
say("turning", seen.join());
say("optional calls", without("x", null).maybe?.(), without("x", undefined).maybe?.(), kit("x").maybe?.(), new Handler("x").maybe?.(), new Handler("x", null).maybe?.(), new Handler("nothing").maybe?.());
say("defaults", (without("y", null).maybe ?? (() => "default"))(), (kit("y").maybe ?? (() => "default"))(), typeof without("y", undefined).maybe, typeof without("y", null).maybe, typeof kit("y").maybe);

console.log(lines.join("\n"));
//// closures-stored-into-fields-read-where-the-slot-may-be-empty.js
// A literal whose members are, in turn, reads of an object that the function is given and functions. The code that reads a member of the result allows for an object that has no such member yet.
// object-census.test.ts counts how many function objects the run makes, without inlining.
////= make
const kept = [];
let sum = 0;
for (let i = 0; i < 3000; i++) {
  const made = make(i % 50 ? { first: i, second: i + 1, third: i + 2 } : { third: 1, first: 2, second: 3, extra: 4 });
  kept[i & 7] = made;
  sum += made.first + made.second + made.third;
}
console.log(sum, kept[3].openArm(), kept[4].closeArm(), kept[5].lastArm === kept[5].lastArm, kept[5].lastArm !== kept[6].lastArm);

//// closures-stored-into-fields-seen-before-the-store.js
// Between the allocation of an object and the store of a closure into one of its fields the object has no such property: whoever looks at the object in between sees that,
// and the order of the keys is the order of the stores.
const lines = [];
////= say-2
function describe(object) {
  const inOrder = [];
  for (const key in object) inOrder.push(key);
  return Object.keys(object).join() + "|" + inOrder.join() + "|" + JSON.stringify(object) + "|" + Object.getOwnPropertyNames(object).length;
}

class Early {
  first = () => "first of " + this.name;
  seenAtFirst = Object.keys(this).join();
  laterSeenEarly = this.later;
  hasLaterEarly = "later" in this;
  ownLaterEarly = Object.hasOwn(this, "later");
  typeEarly = typeof this.later;
  name = "early";
  later = () => "later of " + this.name;
  seenAtEnd = Object.keys(this).join();
  laterSeenLate = this.later;
}
for (let i = 0; i < 3; i++) {
  const early = new Early();
  say("early", early.seenAtFirst, early.laterSeenEarly, early.hasLaterEarly, early.ownLaterEarly, early.typeEarly, early.seenAtEnd, early.laterSeenLate === early.later, early.later(), early.first());
  say("early keys", describe(early));
}

// A call before the store throws, and the object goes on.
class CalledEarly {
  result = (() => {
    try {
      return this.run();
    } catch (error) {
      return error instanceof TypeError ? "TypeError" : "other";
    }
  })();
  run = () => "ran";
}
say("called early", new CalledEarly().result, new CalledEarly().run());

// The prototype has the name: a method, then a getter, then a setter that a definition must not run.
class WithMethod {
  before = this.act();
  act = () => "own";
  after = this.act();
  act() {
    return "inherited";
  }
}
say("method above", new WithMethod().before, new WithMethod().after, Object.keys(new WithMethod()).join());

let setterRuns = 0;
class WithAccessor {
  before = this.act;
  act = () => "own";
  after = this.act();
  get act() {
    return "from the getter";
  }
  set act(value) {
    setterRuns++;
  }
}
say("accessor above", new WithAccessor().before, new WithAccessor().after, setterRuns, Object.keys(new WithAccessor()).join());

class StoresOverAccessor {
  log = [];
  constructor() {
    this.act = () => "stored";
  }
  get act() {
    return "from the getter";
  }
  set act(value) {
    this.log.push(typeof value);
  }
}
const overAccessor = new StoresOverAccessor();
say("a store runs the setter", overAccessor.act, overAccessor.log.join(), Object.keys(overAccessor).join());

// The object escapes before the store.
const seen = [];
function look(object, at) {
  seen.push(at + ":" + Object.keys(object).join("+") + ":" + typeof object.work);
  return at;
}
class Escapes {
  a = look(this, "a");
  work = () => this.a + this.b;
  b = look(this, "b");
}
for (let i = 0; i < 2; i++) say("escapes", new Escapes().work(), seen.splice(0).join(" "));

// Key order with stores in the constructor, in another order on another path.
class Ordered {
  constructor(flip) {
    if (flip) {
      this.two = () => 2;
      this.one = () => 1;
    } else {
      this.one = () => 1;
      this.two = () => 2;
    }
    this.three = 3;
  }
}
say("order", describe(new Ordered(false)), describe(new Ordered(true)), new Ordered(true).one() + new Ordered(false).two());

// Copies.
class Source {
  n = 1;
  get = () => this.n;
  tail = "t";
}
const source = new Source();
const spread = { ...source };
const assigned = Object.assign({}, source);
const assignedOver = Object.assign(new Source(), source);
source.n = 7;
say("copies", Object.keys(spread).join(), spread.get === source.get, spread.get(), assigned.get === source.get, assignedOver.get === source.get, assignedOver.get(), assignedOver.n);
const unread = new Source();
const spreadOfUnread = { ...unread };
say("copy of an unread closure", spreadOfUnread.get === unread.get, spreadOfUnread.get(), Object.entries(new Source()).map(([key, value]) => key + ":" + typeof value).join(), Object.values(new Source()).length);
function cloneFails(value) {
  try {
    structuredClone(value);
    return "cloned";
  } catch (error) {
    return error.name;
  }
}
say("structuredClone", cloneFails(new Source()), cloneFails({ plain: () => 1 }), JSON.stringify(new Source()), JSON.stringify({ a: 1, f: () => 1, b: 2 }), JSON.stringify([new Source().get]));

// Descriptors.
const descriptor = Object.getOwnPropertyDescriptor(new Source(), "get");
say("descriptor", typeof descriptor.value, descriptor.writable, descriptor.enumerable, descriptor.configurable);
const described = new Source();
say("descriptor value", Object.getOwnPropertyDescriptor(described, "get").value === described.get, Object.getOwnPropertyDescriptors(described).get.value === described.get, Reflect.ownKeys(described).join(), Reflect.get(described, "get") === described.get, Reflect.has(described, "get"));

// Destructuring and computed names.
const { get: taken, ...rest } = new Source();
const name = ["g", "e", "t"].join("");
const computed = new Source();
say("by other ways", taken(), Object.keys(rest).join(), computed[name] === computed.get, computed[name](), name in computed);

// A literal that is looked at while it is built.
function build(n) {
  const object = { n };
  const before = Object.keys(object).join();
  object.run = () => object.n + 1;
  const between = Object.keys(object).join();
  object.stop = () => object.n - 1;
  return [before, between, Object.keys(object).join(), object.run() + object.stop()].join(" ");
}
say("literal", build(1), build(2));

console.log(lines.join("\n"));
//// closures-stored-into-fields-seen-by-the-collector-and-the-heap-snapshot.ts
// Collections and a heap snapshot come while the members are unread or hold undefined or null; what is read afterwards is as if none had come.
const lines: string[] = [];
////= say-3
// n & 1: `maybe` is a function, else undefined. n & 2: `none` is a function, else null.
////= kit-3

const kept: Kit[] = [];
for (let i = 0; i < 400; i++) {
  kept.push(kit("k" + i, i));
  if (i % 100 === 50) Bun.gc(true);
}
Bun.gc(true);
const snapshot = Bun.generateHeapSnapshot();
say("snapshot", typeof snapshot, Array.isArray((snapshot as { nodes?: unknown }).nodes));
let right = 0;
for (let i = 0; i < kept.length; i += 2) {
  const one = kept[i];
  if (one.own() === "k" + i + " owns" && one.first() === 1 && (i & 1 ? one.maybe!() === "maybe" : one.maybe === undefined) && (i & 2 ? one.none!() === "none" : one.none === null)) right++;
}
Bun.gc(true);
const functions = kept.map(one => one.own);
Bun.gc(true);
say("read", right, functions.every((own, i) => own === kept[i].own && own() === "k" + i + " owns"), show(kept[1]), show(kept[2]));
// The only reference to an object is the closure that one of its members made.
let owners: (() => string)[] = [];
for (let i = 0; i < 200; i++) owners.push(kit("alone" + i, i).own);
Bun.gc(true);
say("alone", owners.every((own, i) => own() === "alone" + i + " owns"));
owners = [];
Bun.gc(true);

console.log(lines.join("\n"));
//// closures-stored-into-fields-shown-by-the-inspector.ts
// The inspector shows a function member under its name whether the function object exists yet or not, and undefined and null as they are.
const lines: string[] = [];
////= say-3
// n & 1: `maybe` is a function, else undefined. n & 2: `none` is a function, else null.
////= kit-3

import { inspect } from "node:util";
for (let n = 0; n < 4; n++) {
  say("bun", n, Bun.inspect(kit("bun" + n, n)).replace(/\s+/g, " "));
  say("node", n, inspect(kit("node" + n, n), { breakLength: Infinity }));
  say("nested", n, Bun.inspect({ list: [kit("nested" + n, n)] }).replace(/\s+/g, " "));
  const named = kit("named" + n, n);
  say("names", n, named.first.name, named.own.name, named.maybe?.name, named.none?.name, named.first.length, String(named.first), typeof named.own.call);
}

console.log(lines.join("\n"));
//// closures-stored-into-fields-subclasses-and-new-target.js
// Classes whose fields hold closures are extended, constructed for another new.target, constructed through values, and their constructors return other objects.
const lines = [];
////= say-2
////= attempt-3

class Base {
  #secret;
  name = "base";
  who = () => this.name + ":" + this.#secret;
  kind = () => this.constructor.name;
  constructor(secret) {
    this.#secret = secret;
  }
  static reveal(object) {
    return #secret in object;
  }
}
class Below extends Base {
  extra = () => this.who() + "!";
  name = "below";
}
class Deeper extends Below {
  who = () => "deeper " + this.name;
  constructor() {
    super("d");
    this.late = () => this.extra();
  }
}
class Unrelated {
  other = () => "other";
}
function Ordinary() {}
Ordinary.prototype.marker = "ordinary";

const all = [];
for (let i = 0; i < 6; i++) all.push(new Base("s" + i), new Below("t" + i), new Deeper());
say("who", all.map(object => object.who()).join());
say("kind", all.slice(0, 3).map(object => object.kind()).join(), all[1].extra(), all[2].extra(), all[2].late());
say("keys", all.slice(0, 3).map(object => Object.keys(object).join("+")).join());
say("identity", all[0].who === all[0].who, all[0].who !== all[3].who, all[1].who === all[1].who, all[1].who !== all[4].who, all[2].who === all[2].who, all[2].late === all[2].late);

// Another new.target.
const targets = [Base, Below, Deeper, Unrelated, Ordinary, Object, function () {}, class extends Base {}, Base.bind(null), new Proxy(Base, {}), new Proxy(Unrelated, {})];
for (const target of targets) {
  const made = Reflect.construct(Base, ["r"], target);
  say("for " + (target.name || "anonymous"), made.who(), attempt(() => made.kind()), Object.keys(made).join("+"), made instanceof Base, Object.getPrototypeOf(made) === target.prototype, made.who === made.who, Base.reveal(made), made.marker, typeof made.extra, typeof made.other);
}
const forBelow = Reflect.construct(Below, ["q"], Base);
say("Below for Base", forBelow.who(), forBelow.extra(), Object.keys(forBelow).join("+"), forBelow instanceof Below, forBelow instanceof Base);
const forUnrelated = Reflect.construct(Unrelated, [], Base);
say("Unrelated for Base", forUnrelated.other(), Object.keys(forUnrelated).join("+"), forUnrelated instanceof Base, typeof forUnrelated.who, Base.reveal(forUnrelated));

// new.target whose prototype changes or is no object.
function Changing() {}
const first = Reflect.construct(Base, ["c1"], Changing);
Changing.prototype = { changed: true };
const second = Reflect.construct(Base, ["c2"], Changing);
Changing.prototype = 5;
const third = Reflect.construct(Base, ["c3"], Changing);
say("changing", first.who(), first.changed, second.who(), second.changed, third.who(), Object.getPrototypeOf(third) === Object.prototype);

// The prototype of the class itself is changed afterwards.
class Moved {
  run = () => this.up();
  up() {
    return "first";
  }
}
const movedBefore = new Moved();
Object.setPrototypeOf(Moved.prototype, { inherited: () => "inherited" });
////= lines-35	Moved	up	"second"
const movedAfter = new Moved();
say("moved", movedBefore.run(), movedAfter.run(), movedAfter.inherited(), movedBefore.run !== movedAfter.run);
const reparented = new Moved();
Object.setPrototypeOf(reparented, { up: () => "reparented", run: "shadowed" });
say("reparented", reparented.run(), Object.keys(reparented).join(), delete reparented.run, reparented.run);

// Constructed through values.
function construct(Class, ...args) {
  return new Class(...args);
}
const classes = [Base, Below, Deeper, Unrelated];
say("through values", classes.map(Class => Object.keys(construct(Class, "v")).join("+")).join(), construct(classes[1], "w").extra());

// A constructor that returns another object: the fields go to what super() answers.
class ReturnsOther {
  constructor(target) {
    return target;
  }
}
class Stamps extends ReturnsOther {
  stamp = () => this.label + " stamped";
}
const target = { label: "target" };
const stamped = new Stamps(target);
say("stamped", stamped === target, target.stamp(), Object.keys(target).join(), target.stamp === target.stamp);
const stampedAgain = new Stamps(target);
say("stamped again", stampedAgain === target, Object.keys(target).join(), target.stamp());
const stampedBase = new Stamps(new Base("sb"));
say("stamped an instance", stampedBase.who(), Object.keys(stampedBase).join("+"), attempt(() => stampedBase.stamp()));
say("stamped a frozen object", attempt(() => new Stamps(Object.freeze({ label: "frozen" }))));
const stampedArray = new Stamps([1, 2]);
say("stamped an array", Object.keys(stampedArray).join(), stampedArray.stamp());

// A base constructor that calls what the subclass overrides, before the fields of the subclass exist.
class CallsDown {
  seen = this.describe();
  describe() {
    return "base";
  }
}
class Overrides extends CallsDown {
  tell = () => "told";
  describe() {
    return typeof this.tell + ":" + Object.keys(this).join("+");
  }
}
say("calls down", new Overrides().seen, new Overrides().describe(), new CallsDown().seen);

// A class evaluated several times.
function classOf(label) {
  return class {
    label = () => label;
    self = () => this;
  };
}
const evaluated = [classOf("x"), classOf("y")];
const instances = evaluated.flatMap(Class => [new Class(), new Class()]);
say("evaluated twice", instances.map(instance => instance.label()).join(), instances.every(instance => instance.self() === instance), instances[0].label !== instances[1].label, instances[0] instanceof evaluated[1]);

console.log(lines.join("\n"));
//// closures-stored-into-fields-taken-by-rest-patterns.ts
// A rest pattern and a copy of data properties hold the very function objects of the source, unread or not, and its undefined and null.
const lines: string[] = [];
////= say-3
// n & 1: `maybe` is a function, else undefined. n & 2: `none` is a function, else null.
////= kit-3

function withoutLabel(source: Kit) {
  const { label, ...rest } = source;
  return { label, rest };
}
function withoutFunctions(source: Kit) {
  const { first, own, ...rest } = source;
  return { first, own, rest };
}
function byComputedName(source: Kit, name: keyof Kit) {
  const { [name]: taken, ...rest } = source;
  return { taken, rest };
}
for (let n = 0; n < 4; n++) {
  const source = kit("source" + n, n);
  const a = withoutLabel(source);
  say("without label", n, a.label, a.rest.first === source.first, a.rest.own === source.own, a.rest.maybe === source.maybe, a.rest.none === source.none, a.rest.own(), Object.keys(a.rest).join("+"));
  const other = kit("other" + n, n);
  const b = withoutFunctions(other);
  say("without functions", n, b.first === other.first, b.own === other.own, b.own(), String(b.rest.maybe === other.maybe), String(b.rest.none === other.none), Object.keys(b.rest).join("+"));
  const third = kit("third" + n, n);
  const c = byComputedName(third, (["own", "maybe", "none", "first"] as const)[n]);
  say("computed", n, c.taken === third[(["own", "maybe", "none", "first"] as const)[n]], Object.keys(c.rest).join("+"), (c.rest as Partial<Kit>).first === (n === 3 ? undefined : third.first));
  const [head, ...tail] = [kit("head" + n, n), kit("tail" + n, n)];
  say("arrays", n, show(head), show(tail[0]));
}

console.log(lines.join("\n"));
//// closures-stored-into-fields-that-are-missing-deleted-or-late.js
// Objects of one shape whose members hold functions: some lack a member, lose it, or get it late.
////= make
function describe(one) {
  return [typeof one.openArm, typeof one.closeArm, typeof one.lastArm, one.lastArm?.(), Object.keys(one).join("+")].join(" ");
}
const bare = make({});
delete bare.lastArm;
console.log(describe(bare), describe(make({ first: 1 })));
bare.lastArm = () => "late";
console.log(describe(bare), bare.lastArm === bare.lastArm);
const partial = { first: 1, openArm: undefined, second: 2 };
console.log(describe(partial), describe(Object.assign({}, make({ third: 3 }), { closeArm: null })));
//// closures-stored-into-fields-that-are-plain-functions.ts
// Members that are plain functions: function expressions and function declarations. They are function objects with all that comes with it: `new`, prototype, instanceof, name, length,
// own properties, a name of their own inside, and a `this` that the call gives.
const lines: string[] = [];
////= say
////= attempt

interface Box {
  label: string;
  plain: (this: unknown, a?: number, b?: number) => string;
  self: () => unknown;
  who: (this: { label: string }) => string;
  declared: () => string;
  counts: () => number;
}
function box(label: string, flag?: boolean): Box {
  let calls = flag ? 10 : 0;
  const made: Box = {
    label,
    plain: function (a, b) {
      return "plain " + label + " " + typeof this + " " + a + " " + b;
    },
    self: function named() {
      return named;
    },
    who: function () {
      return "who " + this.label;
    },
    declared,
    counts,
  };
  return made;
  function declared() {
    return "declared " + label;
  }
  function counts() {
    return ++calls;
  }
}

const a = box("a");
const b = box("b", true);
const looseWho = a.who as () => string;
say("calls", a.plain(1, 2), a.who(), a.declared(), a.counts(), a.counts(), b.counts(), b.who.call({ label: "other" }), attempt(() => looseWho()));
say("identity", a.plain === a.plain, a.plain !== b.plain, a.self() === a.self, b.self() === b.self, a.self() !== b.self(), a.declared !== b.declared, a.declared === a.declared);

const c = box("c");
say("names", c.plain.name, c.self.name, c.who.name, c.declared.name, c.counts.name, c.plain.length, c.self.length, String(c.declared).replace(/\s+/g, " "), typeof c.plain, Object.prototype.toString.call(c.who));

// As constructors.
const d = box("d");
const Plain = d.plain as unknown as new (a?: number) => object;
const Declared = d.declared as unknown as new () => object;
const built = new Plain(1);
const builtAgain = new Declared();
say("new", built instanceof Plain, builtAgain instanceof Declared, built instanceof Declared, Object.getPrototypeOf(built) === Plain.prototype, Plain.prototype.constructor === d.plain, Declared.prototype === (d.declared as unknown as { prototype: object }).prototype, Object.keys(built).length);
const e = box("e");
say("prototype first", typeof (e.who as unknown as { prototype: object }).prototype, (e.who as unknown as { prototype: { constructor: unknown } }).prototype.constructor === e.who, "prototype" in e.counts, Object.getOwnPropertyNames(e.declared).sort().join());
say("construct", attempt(() => typeof Reflect.construct(box("f").declared, [])), attempt(() => Reflect.construct(Object, [], box("g").plain) instanceof Object));

// Properties of the function objects stay with them.
const h = box("h");
(h.plain as unknown as Record<string, unknown>).extra = "kept";
Object.defineProperty(h.declared, "name", { value: "renamed" });
say("own properties", (h.plain as unknown as Record<string, unknown>).extra, h.declared.name, Object.keys(h.plain).join(), (box("i").plain as unknown as Record<string, unknown>).extra);

// bind, call, apply, and handing the function on.
const j = box("j");
const bound = j.who.bind({ label: "bound" });
say("bind", bound(), bound.name, j.plain.call(5, 1), j.plain.apply("s", [1, 2]), [1].map(j.declared).join(), attempt(() => new (bound as unknown as new () => object)() instanceof (j.who as unknown as new () => object)));

// new.target inside, a class that extends a member, and Reflect.construct for another new.target.
interface Makers {
  label: string;
  target: (this: unknown) => string;
  Base: new (n: number) => { n: number; kind(): string };
  shaped: (this: { size?: number }, size: number) => void;
}
function makers(label: string, flag?: boolean): Makers {
  const suffix = flag ? "!" : "";
  const made = {
    label,
    target: function () {
      return label + suffix + (new.target === undefined ? " called" : new.target === made.target ? " constructed" : " constructed for another");
    },
    Base: function (this: { n: number }, n: number) {
      this.n = n;
    } as unknown as Makers["Base"],
    shaped,
  };
  made.Base.prototype.kind = function () {
    return "kind of " + label;
  };
  return made;
  function shaped(this: { size?: number }, size: number) {
    this.size = size;
  }
}
const k = makers("k");
const Target = k.target as unknown as new () => object;
say("new.target", k.target(), typeof new Target(), attempt(() => typeof Reflect.construct(Target, [], Object)), makers("l", true).target());
const m = makers("m");
class Below extends m.Base {
  more = () => this.n + 1;
}
const below = new Below(4);
say("extends", below.n, below.more(), below.kind(), below instanceof m.Base, below instanceof makers("n").Base, Object.getPrototypeOf(Below) === m.Base, Object.getPrototypeOf(Below.prototype) === m.Base.prototype);
const o = makers("o");
const Shaped = o.shaped as unknown as new (size: number) => { size: number };
const shapedObject = new Shaped(3);
const forOther = Reflect.construct(Shaped, [5], m.Base) as { size: number };
const target = { size: 0 };
o.shaped.call(target, 9);
say("shaped", shapedObject.size, shapedObject instanceof Shaped, forOther.size, forOther instanceof m.Base, forOther instanceof Shaped, target.size, Shaped === (o.shaped as unknown));

// Many, most of them never touched.
const many: Box[] = [];
for (let i = 0; i < 200; i++) many.push(box("m" + i, i % 2 === 0));
let total = 0;
for (let i = 0; i < many.length; i += 10) total += many[i].counts();
say("many", total, many[7].declared(), many[8].who(), many[9].self() === many[9].self, Object.keys(many[3]).join());

console.log(lines.join("\n"));
