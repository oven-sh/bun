//// closures-stored-into-fields-copied-by-spread.ts
// A copy by spread holds the very function objects of its source, whether anybody has read them from the source or not, and they go on capturing the source.
const lines: string[] = [];
////= say

interface Kit {
  label: string;
  first: () => number;
  second: (suffix: string) => string;
  own: () => string;
}
let calls = 0;
////= kit-2	second: suffix => "second" + suffix
function relabeled(source: Kit, label: string): Kit {
  return { ...source, label };
}
function plainCopy(source: Kit): Kit {
  return { ...source };
}
function withOtherFirst(source: Kit): Kit {
  return { ...source, first: () => -1 };
}

// Nothing has read the members of the source.
const source = kit("source");
const copy = relabeled(source, "copy");
say("unread", copy.first === source.first, copy.second === source.second, copy.own === source.own, copy.own(), source.own(), copy.label);

// One member has been read.
const partly = kit("partly");
const ownOfPartly = partly.own;
const copyOfPartly = plainCopy(partly);
say("partly read", copyOfPartly.own === ownOfPartly, copyOfPartly.first === partly.first, copyOfPartly.own(), Object.keys(copyOfPartly).join());

// The source changes behind the copy, and the copy behind the source.
const changing = kit("changing");
const early = plainCopy(changing);
changing.label = "changed";
changing.own = () => "replaced";
say("source changes", early.own(), changing.own(), early.own !== changing.own, early.label);
early.first = () => 100;
say("copy changes", early.first(), changing.first() > 0, early.first !== changing.first);

// Copies of copies, many of them, read only at the end.
const chains: Kit[][] = [];
for (let i = 0; i < 50; i++) {
  const root = kit("root" + i);
  const middle = relabeled(root, "middle" + i);
  const leaf = i % 2 ? withOtherFirst(middle) : plainCopy(middle);
  chains.push([root, middle, leaf]);
}
let sameOwn = 0;
let sameFirst = 0;
const owners = new Set<string>();
for (const [root, middle, leaf] of chains) {
  if (root.own === middle.own && middle.own === leaf.own) sameOwn++;
  if (root.first === middle.first && middle.first === leaf.first) sameFirst++;
  owners.add(leaf.own().replace(/\d+/, ""));
}
say("chains", sameOwn, sameFirst, [...owners].join(), chains[1][2].first(), chains[2][2].label, chains[0][0].own !== chains[1][0].own);

console.log(lines.join("\n"));
//// closures-stored-into-fields-copied-into-another-type.ts
// A spread into a literal of another declared type holds the very function objects of its source, unread or not, and the undefined and null of its source.
const lines: string[] = [];
////= say-3
// n & 1: `maybe` is a function, else undefined. n & 2: `none` is a function, else null.
////= kit-3

interface Wider extends Kit {
  extra: number;
}
interface Narrower {
  label: string;
  own: () => string;
  none: (() => string) | null;
}
function widened(source: Kit, extra: number): Wider {
  return { ...source, extra };
}
function narrowed(source: Kit): Narrower {
  return { label: source.label, own: source.own, none: source.none };
}
for (let n = 0; n < 4; n++) {
  const source = kit("source" + n, n);
  const wide = widened(source, n);
  const narrow = narrowed(source);
  say("wide", n, wide.first === source.first, wide.own === source.own, wide.maybe === source.maybe, wide.none === source.none, wide.own(), wide.extra, show(wide));
  say("narrow", n, narrow.own === source.own, narrow.none === source.none, narrow.own(), String(narrow.none && narrow.none()), Object.keys(narrow).join("+"));
}
const sources: Kit[] = [];
const copies: Wider[] = [];
for (let i = 0; i < 60; i++) {
  sources.push(kit("s" + i, i));
  copies.push(widened(sources[i], i));
}
let same = 0;
for (let i = 0; i < 60; i++) if (copies[i].first === sources[i].first && copies[i].own === sources[i].own && copies[i].maybe === sources[i].maybe && copies[i].none === sources[i].none && copies[i].own() === "s" + i + " owns") same++;
say("many", same);

console.log(lines.join("\n"));
//// closures-stored-into-fields-deleted-redefined-frozen.js
// Fields that hold closures are deleted, redefined, frozen and sealed: before the store of the closure, between two stores and afterwards.
"use strict";
const lines = [];
////= say-2
////= attempt-3

class Plain {
  n = 1;
  run = () => this.n;
  stop = () => -this.n;
  last = "last";
  again() {
    this.run = () => this.n + 10;
    return this;
  }
}

// Deleted afterwards, unread and read.
for (const readsFirst of [false, true]) {
  const object = new Plain();
  const before = readsFirst ? object.run : null;
  say("delete", delete object.run, object.run, "run" in object, Object.keys(object).join(), before ? before() : "-");
  object.again();
  say("stored again", object.run(), Object.keys(object).join(), object.run === object.run, object.run !== before);
  delete object.run;
  object.run = 5;
  say("another value", object.run, Object.keys(object).join());
  object.again();
  say("a closure over the other value", object.run(), Object.keys(object).join());
}

// Deleted by a field initializer that runs between two definitions.
class DeletesInBetween {
  run = () => "run";
  removed = delete this.run;
  keysThen = Object.keys(this).join();
  stop = () => "stop";
}
const deleted = new DeletesInBetween();
say("deleted in between", deleted.removed, deleted.keysThen, deleted.run, deleted.stop(), Object.keys(deleted).join());

// Redefined: not enumerable, read-only, an accessor.
function redefined(descriptor) {
  const object = new Plain();
  Object.defineProperty(object, "run", descriptor);
  return object;
}
const hidden = redefined({ enumerable: false });
say("hidden", hidden.run(), Object.keys(hidden).join(), hidden.run === hidden.run, JSON.stringify(Object.getOwnPropertyDescriptor(hidden, "run")));
const readOnly = redefined({ writable: false });
say("read-only", readOnly.run(), attempt(() => readOnly.again().run()), readOnly.run(), Object.keys(readOnly).join());
const accessor = redefined({ get: () => () => "from the getter" });
say("accessor", accessor.run(), attempt(() => accessor.again().run()), Object.keys(accessor).join());
const replaced = redefined({ value: () => "replaced" });
say("replaced", replaced.run(), replaced.again().run(), Object.keys(replaced).join());
const number = redefined({ value: 3 });
say("a number", number.run, number.again().run(), Object.keys(number).join());

// Redefined before the definition of the field.
class RedefinedEarly {
  early = Object.defineProperty(this, "run", { value: "early", configurable: true, enumerable: false, writable: false }) && "done";
  run = () => "defined";
}
const redefinedEarly = new RedefinedEarly();
say("redefined early", redefinedEarly.run(), Object.keys(redefinedEarly).join(), JSON.stringify(Object.getOwnPropertyDescriptor(redefinedEarly, "run")));
class FixedEarly {
  early = Object.defineProperty(this, "run", { value: "early", configurable: false }) && "done";
  run = () => "defined";
}
say("fixed early", attempt(() => new FixedEarly().run));

// Frozen, sealed and closed afterwards.
for (const [name, close] of [["freeze", Object.freeze], ["seal", Object.seal], ["preventExtensions", Object.preventExtensions]]) {
  for (const readsFirst of [false, true]) {
    const object = new Plain();
    const before = readsFirst ? object.run : null;
    close(object);
    say(name, object.run(), before === null || before === object.run, attempt(() => object.again().run()), attempt(() => delete object.run), object.run === undefined ? "gone" : object.run(), Object.isFrozen(object), Object.keys(object).join());
    say(name + " then stored", attempt(() => object.again().run()), Object.keys(object).join());
  }
}

// Frozen, sealed and closed between the definitions.
for (const [name, close] of [["freeze", Object.freeze], ["seal", Object.seal], ["preventExtensions", Object.preventExtensions]]) {
  class ClosedInBetween {
    run = () => "run";
    closed = close(this) && "closed";
    stop = () => "stop";
  }
  say(name + " in between", attempt(() => Object.keys(new ClosedInBetween()).join()));
}
let escaped;
class ClosedHalfway {
  run = () => "run";
  self = (escaped = this);
  closed = Object.preventExtensions(this);
  stop = () => "stop";
}
say("halfway", attempt(() => new ClosedHalfway()), Object.keys(escaped).join(), escaped.run(), escaped.stop, escaped.run === escaped.run);

// A store (not a definition) into a closed object.
class StoresWhenClosed {
  constructor(close) {
    this.first = () => "first";
    if (close) Object.preventExtensions(this);
    this.second = () => "second";
  }
}
say("store when closed", attempt(() => Object.keys(new StoresWhenClosed(false)).join()), attempt(() => Object.keys(new StoresWhenClosed(true)).join()));

// Many objects, some of them changed, read afterwards.
const objects = [];
for (let i = 0; i < 24; i++) {
  const object = new Plain();
  object.n = i;
  if (i % 6 === 1) delete object.stop;
  if (i % 6 === 2) Object.freeze(object);
  if (i % 6 === 3) Object.defineProperty(object, "stop", { value: () => "s" + i, enumerable: false });
  if (i % 6 === 4) object.stop = object.run;
  if (i % 6 === 5) object.extra = () => i;
  objects.push(object);
}
say("many", objects.map(object => attempt(() => object.stop())).join());
say("many keys", objects.slice(0, 6).map(object => Object.keys(object).join("+")).join());
say("many again", objects.map(object => attempt(() => object.again().run())).join());

