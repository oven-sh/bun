//// closures-made-by-closures-over-a-loop-variable-are-called-in-callbacks-of-array-methods.ts
// Each turn of `for (let i ..)` pushes a function that makes a function that reads `i`. Callbacks of map, filter, slice, reduce, join and forEach, alone and one behind the other, call both at once.
type Read = () => number;
function makersOf(n: number): (() => Read)[] {
  const makers: (() => Read)[] = [];
  for (let i = 0; i < n; i++) makers.push(() => () => i);
  return makers;
}
function lone() { const makers: (() => Read)[] = []; for (let i = 0; i < 3; i++) makers.push(() => () => i); return makers.map(make => make()()); }
function mapMap() { const makers: (() => Read)[] = []; for (let i = 0; i < 3; i++) makers.push(() => () => i); return makers.map(make => make()).map(read => read()); }
function mapMapNumbers() { const makers: (() => Read)[] = []; for (let i = 0; i < 3; i++) makers.push(() => () => i); return makers.map(make => make()()).map(x => x + 1); }
function filterMap() { const makers: (() => Read)[] = []; for (let i = 0; i < 3; i++) makers.push(() => () => i); return makers.filter(make => make()() >= 0).map(make => make()()); }
function sliceMap() { const makers: (() => Read)[] = []; for (let i = 0; i < 3; i++) makers.push(() => () => i); return makers.slice(0).map(make => make()()); }
function mapReduce() { const makers: (() => Read)[] = []; for (let i = 0; i < 3; i++) makers.push(() => () => i); return makers.map(make => make()()).reduce((t, x) => t * 10 + x, 7); }
function mapJoin() { const makers: (() => Read)[] = []; for (let i = 0; i < 3; i++) makers.push(() => () => i); return makers.map(make => make()()).join("+"); }
function mapForEach() { const makers: (() => Read)[] = []; for (let i = 0; i < 3; i++) makers.push(() => () => i); const seen: number[] = []; makers.map(make => make()()).forEach(x => { seen.push(x); }); return seen; }
function handedIn(makers: (() => Read)[]) { return makers.map(make => make()()).map(x => x * 2); }
function once() { return [String(lone()), String(mapMap()), String(mapMapNumbers()), String(filterMap()), String(sliceMap()), String(mapReduce()), mapJoin(), String(mapForEach()), String(handedIn(makersOf(4)))].join(" | "); }
console.log(once());
let last = "";
for (let turn = 0; turn < 200; turn++) last = once();
console.log(last);
//// closures-made-in-loops-keep-the-variables-of-their-turn.js
// Closures made in for, for-of and while loops, in callbacks, behind an await and behind a yield keep the variables of their own turn, also where only one of them outlives the loop.
const fs = [];
for (let i = 0; i < 3; i++) { fs.push(() => i); i += 0; }
console.log(fs.map(f => f()).join());
const gs = [];
for (let i = 0; i < 3; i++) { let j = i * 2; const inc = () => ++j; inc(); gs.push(() => j, inc); }
console.log(gs.map(f => f()).join());
function each(n, cb) { for (let i = 0; i < n; i++) cb(i); }
let keep = []; each(3, i => { let x = i; keep.push(() => x++); });
console.log(keep.map(f => f() + f()).join());
function later() { const out = []; for (const k of ["a", "b"]) { let c = 0; const bump = () => (c++, k + c); bump(); out.push(bump); } return out; }
console.log(later().map(f => f()).join());
function loop() { let saved; for (let i = 0; i < 4; i++) { const f = () => i; if (i === 1) saved = f; f(); } return saved(); }
console.log(loop());
function w() { let r = []; let i = 0; while (i < 3) { let v = i; r.push(function () { return v; }); v += 10; i++; } return r.map(f => f()); }
console.log(w().join());
async function as() { const r = []; for (let i = 0; i < 3; i++) { await null; r.push(() => i); } return r.map(f => f()).join(); }
as().then(console.log);
function* gen() { for (let i = 0; i < 3; i++) { yield () => i; } }
console.log([...gen()].map(f => f()).join());
//// closures-of-five-places-are-called-in-one-reader.ts
// Closures that make closures are made in five places and all of them are called in one reader. Two of the places run often and the others run once.
// Each closure still answers the variable of the turn that it was made in: for every kind of reader and every road that leads to it.
type Made = () => () => number;
function declared(thing: Made) {
  return thing()();
}
const arrow = (thing: Made) => thing()();
const bound = function (this: unknown, thing: Made) {
  return thing()();
}.bind(null);
const readers = {
  read(thing: Made) {
    return thing()();
  },
};
class Reads {
  static read(thing: Made) {
    return thing()();
  }
  with(thing: Made) {
    return thing()();
  }
}
const reads = new Reads();
