//// closures-over-loop-variables.ts
// Each iteration of `for (let i ..)` has its own `i`, and the update stores to the new one. A closure keeps the `i` of the iteration that created it, wherever in the loop it was created and whatever else stores to `i`.
const out: string[] = [];
function say(name: string, ...values: unknown[]): void {
  out.push(name + ": " + values.map(String).join(" "));
}
function hold<T>(value: T): T {
  return [value][0];
}
type Read = () => number;
function call(reads: Read[]): number[] {
  return reads.map(read => read());
}

function createdInTheBody(n: number) {
  const reads: Read[] = [];
  for (let i = 0; i < n; i++) reads.push(() => i);
  return call(reads);
}
function calledWhileTheLoopRuns(n: number) {
  const reads: Read[] = [], seen: number[] = [];
  for (let i = 0; i < n; i++) {
    reads.push(hold(() => i));
    seen.push(...call(reads));
  }
  return seen;
}
function usedAtOnce(n: number) {
  let sum = 0;
  for (let i = 0; i < n; i++) sum += [1, 2, 3].map(x => x * i).reduce((a, b) => a + b, 0);
  return sum;
}
function otherUpdates() {
  const reads: Read[] = [];
  for (let i = 0; i < 10; i += 3) reads.push(() => i);
  for (let i = 8; i > 0; i = i >> 1) reads.push(() => i);
  for (let i = 3; i; --i) reads.push(() => i);
  for (let i = 0; i < 6; i++, i++) reads.push(() => i);
  for (let i = 1, j = 2; i < 20; [i, j] = [j, i + j]) reads.push(() => i * 100 + j);
  for (let [i, j] = [0, 10]; i < 3; i++, j--) reads.push(() => i * 100 + j);
  for (let x = 1; x < 40; x *= 2.5) reads.push(() => x);
  for (let i: number | undefined; (i ?? 0) < 3; i = (i ?? 0) + 1) reads.push(() => i ?? -1);
  return call(reads);
}
function createdInTheHead() {
  const reads: Read[] = [];
  for (let i = 5, first = () => i; i < 8; i++) reads.push(first, () => i);
  for (let first = () => i, i = 7; i < 9; i++) reads.push(first, () => i);
  for (let i = 0, j = 0, first = () => i * 10 + j; i < 2; i++, j += 2) reads.push(first, () => i * 10 + j);
  return call(reads);
}
function createdInTheTest() {
  const reads: Read[] = [];
  for (let i = 0; reads.push(() => i) < 4; i++);
  return call(reads);
}
function createdInTheUpdate() {
  const reads: Read[] = [];
  for (let i = 0; i < 3; reads.push(() => i), i++);
  for (let i = 0; i < 3; i++, reads.push(() => i));
  for (let i = 0; i < 3; reads.push(() => i * 10), i++) reads.push(() => i);
  return call(reads);
}
function updateCallsEarlierClosures() {
  const reads: Read[] = [], seen: number[] = [];
  for (let i = 0; i < 3; i++, seen.push(...call(reads))) reads.push(() => i);
  return seen;
}
function storedInTheBody() {
  const reads: Read[] = [];
  for (let i = 0; i < 9; i++) {
    reads.push(() => i);
    i += 2;
  }
  return call(reads);
}
function storedInTheTest() {
  const reads: Read[] = [];
  for (let i = 0; i++ < 6; i++) reads.push(() => i);
  return call(reads);
}
function storedByAClosure() {
  const reads: Read[] = [], bumps: Read[] = [];
  for (let i = 0; i < 3; i++) {
    reads.push(() => i);
    bumps.push(() => (i += 10));
  }
  return [...call(reads), ...call(bumps), ...call(reads)];
}
function storedByAClosureTheUpdateCalls() {
  const reads: Read[] = [];
  for (let i = 0, step = () => ++i; i < 3; step()) {
    reads.push(() => i, step);
    if (reads.length > 5) break;
  }
  return call(reads);
}
function storedByAnInnerUpdate() {
  const reads: Read[] = [];
  for (let i = 0; i < 6; i++) {
    reads.push(() => i);
    for (let j = 0; j < 2; j++, i++) reads.push(() => i * 10 + j);
  }
  return call(reads);
}
function outerVariableInTheUpdate() {
  const reads: Read[] = [];
  let count = 0;
  for (let i = 0; i < 3; i++, count += 2) reads.push(() => i * 10 + count);
  return call(reads);
}
function declaredWithVar() {
  const reads: Read[] = [];
  for (var i = 0; i < 3; i++) reads.push(() => i);
  return call(reads);
}
function seenByEval() {
  const reads: Read[] = [];
  for (let i = 0; i < 3; i++) {
    reads.push(() => i);
    if (i === 1) eval("i += 10; reads.push(() => i)");
  }
  return call(reads);
}
function continued() {
  const reads: Read[] = [];
  for (let i = 0; i < 6; i++) {
    if (i % 2) continue;
    reads.push(() => i);
    if (i < 3) continue;
    reads.push(() => -i);
  }
  return call(reads);
}
function labeled() {
  const reads: Read[] = [];
  outer: for (let i = 0; i < 4; i++) {
    for (let j = 0; j < 4; j++) {
      if (j === 2) continue outer;
      if (i === 2) break outer;
      reads.push(() => i * 10 + j);
    }
  }
  return call(reads);
}
function leftByAThrow() {
  const reads: Read[] = [];
  try {
    for (let i = 0; ; i++) {
      reads.push(() => i);
      if (i === 2) throw new Error("stop");
    }
  } catch {}
  return call(reads);
}
function twoVariables() {
  const reads: Read[] = [];
  for (let i = 0, j = 0; i < 4; i++, j++) {
    reads.push(() => i * 100 + j);
    if (i % 2) j += 5;
  }
  return call(reads);
}
function passedOn() {
  const makers: (() => Read)[] = [];
  for (let i = 0; i < 3; i++) makers.push(() => () => i);
  return makers.map(make => make()());
}
function classesInTheBody() {
  const made: { read(): number }[] = [];
  for (let i = 0; i < 3; i++) {
    made.push(
      new (class {
        kept = i * 2;
        static first = i;
        read() {
          return i * 100 + this.kept;
        }
      })(),
    );
  }
  return made.map(one => one.read());
}
function declaredFunctions() {
  const reads: Read[] = [];
  for (let i = 0; i < 3; i++) {
    reads.push(read, () => i * 10);
    function read(): number {
      return i;
    }
  }
  return call(reads);
}
function reentered(depth: number): Read[] {
  const reads: Read[] = [];
  for (let i = 0; i < 2; i++) {
    reads.push(() => depth * 10 + i);
    if (depth > 0 && i === 0) reads.push(...reentered(depth - 1));
  }
  return reads;
}
function* generated(n: number) {
  for (let i = 0; i < n; i++) yield () => i;
}
async function awaited(n: number) {
  const reads: Read[] = [];
  for (let i = 0; i < n; i += await Promise.resolve(1)) {
    reads.push(() => i);
    await null;
    reads.push(() => i + 100);
  }
  return call(reads);
}
async function timers() {
  const seen: number[] = [];
  await new Promise<void>(resolve => {
    for (let i = 0; i < 3; i++) {
      setTimeout(() => {
        seen.push(i);
        if (seen.length === 3) resolve();
      }, 0);
    }
  });
  return seen;
}
interface ChainLink {
  name: string;
  next: ChainLink | null;
}
function otherTypes() {
  const reads: (() => unknown)[] = [];
  const chain: ChainLink = { name: "a", next: { name: "b", next: { name: "c", next: null } } };
  for (let text = "a"; text.length < 4; text += "b") reads.push(() => text);
  for (let link: ChainLink | null = chain; link; link = link.next) reads.push(() => (link ? link.name : "none"));
  for (let big = 1n; big < 100n; big *= 7n) reads.push(() => big);
  for (let v: number | string = 0; typeof v === "number"; v = v < 2 ? v + 1 : "done") reads.push(() => v);
  return reads.map(read => read());
}
function readBeforeInitialization() {
  const seen: string[] = [];
  try {
    for (let early = hold(() => i)(), i = 0; i < 1; i++) seen.push(String(early));
  } catch (error) {
    seen.push((error as Error).name);
  }
  return seen;
}
function manyIterations() {
  const reads: Read[] = [];
  for (let i = 0; i < 1000; i++) reads.push(() => i);
  let sum = 0;
  for (const read of reads) sum += read();
  return sum;
}
const atTheTopLevel: Read[] = [];
for (let i = 0; i < 3; i++) atTheTopLevel.push(() => i);

say("created in the body", ...createdInTheBody(4));
say("called while the loop runs", ...calledWhileTheLoopRuns(3));
say("used at once", usedAtOnce(5));
say("other updates", ...otherUpdates());
say("created in the head", ...createdInTheHead());
say("created in the test", ...createdInTheTest());
say("created in the update", ...createdInTheUpdate());
say("update calls earlier closures", ...updateCallsEarlierClosures());
say("stored in the body", ...storedInTheBody());
say("stored in the test", ...storedInTheTest());
say("stored by a closure", ...storedByAClosure());
say("stored by a closure the update calls", ...storedByAClosureTheUpdateCalls());
say("stored by an inner update", ...storedByAnInnerUpdate());
say("outer variable in the update", ...outerVariableInTheUpdate());
say("declared with var", ...declaredWithVar());
say("seen by eval", ...seenByEval());
say("continued", ...continued());
say("labeled", ...labeled());
say("left by a throw", ...leftByAThrow());
say("two variables", ...twoVariables());
say("passed on", ...passedOn());
say("classes in the body", ...classesInTheBody());
say("declared functions", ...declaredFunctions());
say("reentered", ...call(reentered(2)));
say("generated", ...[...generated(3)].map(read => read()));
say("awaited", ...(await awaited(3)));
say("timers", ...(await timers()));
say("other types", ...otherTypes());
say("read before initialization", ...readBeforeInitialization());
say("many iterations", manyIterations());
say("at the top level", ...call(atTheTopLevel));
console.log(out.join("\n"));
//// closures-stored-into-fields-behind-a-branch.ts
// The members of a literal are functions, and between them stands a member whose value takes a branch, a call that may throw, or a loop. Whatever the compiler does with the arms, each object has its own function objects.
const lines: string[] = [];
////= say
interface Handlers {
  name: string;
  open(): string;
  mode: string | number;
  close(): string;
  retry: (() => string) | undefined;
  count: number;
  last(): string;
}
let made = 0;
function handlers(name: string, flag: unknown): Handlers {
  return {
    name,
    open: () => "open",
    mode: typeof flag === "string" ? flag + "!" : typeof flag === "number" ? flag + 1 : "none",
    close: () => "close",
    retry: flag ? () => "retry" : undefined,
    count: ++made,
    last: function () {
      return "last";
    },
  };
}
function describe(one: Handlers) {
  return [one.name, one.open(), one.mode, one.close(), one.retry?.(), one.count, one.last()].join(" | ");
}
const kept: Handlers[] = [];
for (let i = 0; i < 300; i++) kept.push(handlers("h" + i, i % 3 === 0 ? "s" + i : i % 3 === 1 ? i : i % 2 ? null : undefined));
say(describe(kept[0]), describe(kept[1]), describe(kept[2]), describe(kept[299]));
say(kept[0].open === kept[0].open, kept[0].open !== kept[1].open, kept[3].close !== kept[6].close, kept[4].last !== kept[7].last, kept[0].retry !== kept[3].retry, kept[2].retry === kept[5].retry);

// The same function object whoever reads it first, by name or by type.
const loose = kept[10] as unknown as Record<string, () => string>;
const byName = loose["clo" + "se"];
say(byName === kept[10].close, byName(), Object.keys(kept[10]).join());

// Arms that give different functions, and an arm that gives a function made before.
const shared = () => "shared";
function choose(n: number) {
  return {
    pick: n % 2 ? () => "odd" : () => "even",
    same: n % 3 ? shared : () => "own",
    n,
  };
}
const chosen = [0, 1, 2, 3, 4, 5, 6].map(choose);
say(chosen.map(one => one.pick() + one.same() + one.n).join(), chosen[1].same === chosen[2].same, chosen[0].same !== chosen[3].same, chosen[1].pick !== chosen[3].pick);

// A loop whose every round makes the closure anew, and a literal behind it that takes the last one.
function lastOf(rounds: number) {
  let run = () => "none";
  for (let i = 0; i < rounds; i++) run = () => "round";
  return { run, rounds };
}
say(lastOf(0).run(), lastOf(3).run(), lastOf(2).run !== lastOf(2).run);

// A member that throws between the functions.
function fails(n: number) {
  return {
    before: () => "before",
    value: n > 1 ? JSON.parse("{") : n,
    after: () => "after",
  };
}
for (const n of [0, 1, 2]) {
  try {
    const one = fails(n);
    say(one.before(), one.value, one.after());
  } catch (error) {
    say((error as Error).constructor.name);
  }
}
console.log(lines.join("\n"));
//// closures-stored-into-fields-by-constructor-functions.js
// Constructor functions store closures into `this`: constructed, called on other objects, chained in the ES5 way, constructed for another new.target, and with classes above and below.
const lines = [];
////= say-2
////= attempt-3

function Widget(name) {
  this.name = name;
  this.show = () => "widget " + this.name;
  this.plain = function () {
    return "plain";
  };
  this.rename = next => {
    this.name = next;
    return this;
  };
}
Widget.prototype.describe = function () {
  return this.show() + "/" + this.plain();
};

const widgets = [];
for (let i = 0; i < 20; i++) widgets.push(new Widget("w" + i));
say("made", widgets.map(widget => widget.describe()).slice(0, 4).join(), Object.keys(widgets[0]).join());
say("identity", widgets[1].show === widgets[1].show, widgets[1].show !== widgets[2].show, widgets[3].plain !== widgets[4].plain, widgets[5].rename("renamed").show(), widgets[5].name);

// Called on objects that something else made.
const literal = { before: 1 };
Widget.call(literal, "literal");
say("called on a literal", literal.show(), Object.keys(literal).join(), literal.show === literal.show);
const again = new Widget("first");
const firstShow = again.show;
Widget.call(again, "second");
say("called again", again.show(), firstShow(), firstShow !== again.show, Object.keys(again).join());
const frozen = Object.freeze({ name: "frozen" });
say("called on a frozen object", attempt(() => Widget.call(frozen, "x")), Object.keys(frozen).join());
const array = [];
Widget.apply(array, ["array"]);
say("called on an array", array.show(), Object.keys(array).join());
say("called on nothing", attempt(() => Widget("nobody")));
const withSetter = {
  log: [],
  set show(value) {
    this.log.push(typeof value);
  },
  get show() {
    return () => "from the getter";
  },
};
Widget.call(withSetter, "setter");
say("called on an object with a setter", withSetter.show(), withSetter.log.join(), Object.keys(withSetter).join());

// The ES5 chain.
function Button(name, label) {
  Widget.call(this, name);
  this.label = label;
  this.press = () => this.show() + " pressed " + this.label;
}
Button.prototype = Object.create(Widget.prototype);
Button.prototype.constructor = Button;
const buttons = [new Button("b1", "ok"), new Button("b2", "cancel")];
say("chain", buttons.map(button => button.press()).join(), buttons[0].describe(), Object.keys(buttons[0]).join(), buttons[0] instanceof Widget, buttons[0].show !== buttons[1].show);

// Another new.target.
class Other {
  other = () => "other";
}
for (const target of [Widget, Button, Other, Object, function () {}]) {
  const made = Reflect.construct(Widget, ["for"], target);
