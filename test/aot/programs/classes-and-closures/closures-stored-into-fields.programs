//// copied-captures.ts
// Captured variables that are never assigned after a closure could have seen them can be copied into the closure.
function call<T>(f: () => T): T { return f(); }
function parameter(a: number, b: string) { return call(() => a + b.length); }
function withDefault(a: number, depth = 3) { return call(() => a * depth); }
function constant(a: number) { const k = a + 1; return call(() => k * 2); }
function unassignedLet(a: number) { let k = a + 1; return call(() => k * 3); }
function nested(a: number) { return call(() => call(() => call(() => a + 1))); }
function caught() { try { throw new Error("x"); } catch (e) { return call(() => (e as Error).message); } }
function forOf(list: number[]) { const fs: (() => number)[] = []; for (const x of list) fs.push(() => x * 2); return fs.map(f => f()).join(); }
function forIn(o: Record<string, number>) { const fs: (() => string)[] = []; for (const k in o) fs.push(() => k); return fs.map(f => f()).join(); }
function forLet() { const fs: (() => number)[] = []; for (let i = 0; i < 3; i++) fs.push(() => i); return fs.map(f => f()).join(); }
function direct(a: number, b: number) { return inner(1) + inner(2); function inner(c: number) { return a * c + b; } }
function mutual(n: number, step: number): number { return even(n); function even(k: number): number { return k <= 0 ? 0 : odd(k - step) + 1; } function odd(k: number): number { return k <= 0 ? 0 : even(k - step) + 1; } }
function constArrow(a: number) { const twice = (x: number) => x * a; const use = () => twice(2) + twice(3); return use(); }
class Holder { constructor(public v: number) {} get() { return call(() => this.v + 1); } nested() { return call(() => call(() => this.v + 2)); } }
function args(..._: number[]) { return (function (this: unknown, _a: number, _b: number) { return call(() => arguments.length); })(1, 2); }
console.log(parameter(1, "ab"), withDefault(2), withDefault(2, 5), constant(1), unassignedLet(1), nested(1), caught());
console.log(forOf([1, 2, 3]), forIn({ a: 1, b: 2 }), forLet(), direct(2, 3), mutual(5, 1), constArrow(4));
console.log(new Holder(1).get(), new Holder(1).nested(), args());
//// create-this-new-target.js
// Allocating `this` from new.target: a prototype read that throws, a revoked proxy, a prototype that is not an object.
////= lines-61	errorText

function F() {
  this.x = 1;
  this.target = new.target;
}

const throwingTarget = new Proxy(function () {}, {
  get(callee, key) {
    console.log("get", String(key));
    if (key === "prototype") throw new RangeError("no prototype");
    return callee[key];
  },
});
console.log("throwing get trap:", errorText(() => Reflect.construct(F, [], throwingTarget)));

const { proxy: revoked, revoke } = Proxy.revocable(function () {}, {});
revoke();
console.log("revoked new.target:", errorText(() => Reflect.construct(F, [], revoked)));

function NumberPrototype() {}
NumberPrototype.prototype = 5;
const fromNumber = new NumberPrototype();
console.log("number prototype:", Object.getPrototypeOf(fromNumber) === Object.prototype);
const fromNumberTarget = Reflect.construct(F, [], NumberPrototype);
console.log("number prototype as new.target:", Object.getPrototypeOf(fromNumberTarget) === Object.prototype, fromNumberTarget.x, fromNumberTarget.target === NumberPrototype);

const prototypeFromTrap = { fromTrap: true };
const trappedTarget = new Proxy(function () {}, {
  get(callee, key) {
    return key === "prototype" ? prototypeFromTrap : callee[key];
  },
});
const fromTrap = Reflect.construct(F, [], trappedTarget);
console.log("prototype from trap:", fromTrap.fromTrap, fromTrap.x, fromTrap.target === trappedTarget);

class Base {
  constructor() {
    this.target = new.target;
  }
}
class Derived extends Base {}
console.log("class new.target:", new Derived().target === Derived, new Base().target === Base);
const other = Reflect.construct(Base, [], F);
console.log("class with other new.target:", other instanceof F, other instanceof Base, other.target === F);

const plain = new F();
console.log("plain new:", plain.x, plain.target === F, Object.getPrototypeOf(plain) === F.prototype);
//// declare-fields-beside-constant-computed-method.ts
// A class declares its fields with `declare` (no code is emitted for them; the constructor creates each by storing to it) and
// has an accessor and a method whose computed names are string constants. The fields behave as own properties that appear in
// the order of the stores. A computed name that equals the name of a declared field wins over the field.
const TypeId = '~test/Fiber'
const describeName = `${TypeId}/describe` as const
const shadowedName = 'shadowed'
let nextId = 0

class Fiber<A> {
  declare readonly id: number
  declare steps: number
  declare value: A | undefined
  declare late: string | undefined
  declare shadowed: number

  constructor(value: A) {
    this.steps = 0
    this.id = ++nextId
    this.value = value
  }
  get [TypeId]() {
    return 'fiber ' + this.id
  }
  [describeName]() {
    return this.id + ':' + this.steps + ':' + String(this.value)
  }
  get [shadowedName]() {
    return 42
  }
  step() {
    this.steps++
    return this
  }
}

const fiber = new Fiber('a')
console.log(Object.keys(fiber).join(), 'late' in fiber, Object.hasOwn(fiber, 'late'), fiber.late)
fiber.late = 'now'
console.log(Object.keys(fiber).join(), 'late' in fiber, Object.hasOwn(fiber, 'late'), fiber.late)
console.log(fiber[TypeId], fiber[describeName](), fiber.step().step()[describeName]())
console.log(fiber.shadowed, Object.hasOwn(fiber, 'shadowed'), 'shadowed' in fiber)
console.log(JSON.stringify(fiber), JSON.stringify(new Fiber(7).step()))

let total = 0
for (let i = 0; i < 1000; i++) {
  const each = new Fiber(i)
  total += each.step().steps + each.id + (each.value ?? 0)
}
console.log(total)

const hidden: any = new Fiber(true)
hidden.extra = 1
delete hidden.steps
console.log(Object.keys(hidden).join(), hidden.steps, hidden[describeName]())
//// declare-fields-under-a-mixin.ts
// A class with `declare` fields IS extended by mixins whose accessors have names computed at run time, and one of the names is a field's. A store in the class's own method then runs the setter, or throws where there is only a getter, and makes no property of the object; a read runs the getter. Objects of the class itself are not touched by that.
const log: string[] = [];
function withBoth<T extends new (...args: any[]) => any>(Base: T, name: string) {
  return class extends Base {
    get [name]() { log.push("get"); return -1; }
    set [name](value: number) { log.push("set " + value); }
  };
}
function withGetter<T extends new (...args: any[]) => any>(Base: T, name: string) {
  return class extends Base {
    get [name]() { return -2; }
  };
}
function withMethod<T extends new (...args: any[]) => any>(Base: T, name: string) {
  return class extends Base {
    [name]() { return -3; }
  };
}
class Holder {
  declare shadowed: number;
  declare own: number;
  fill(value: number): void { this.shadowed = value; this.own = value + 1; }
  fillOwnFirst(value: number): void { this.own = value + 1; this.shadowed = value; }
  read(): string { return (typeof this.shadowed === "function" ? "a function" : String(this.shadowed)) + " " + String(this.own); }
  has(): string { return ("shadowed" in this) + " " + Object.hasOwn(this, "shadowed") + " " + ("own" in this) + " " + Object.hasOwn(this, "own"); }
}
class Below extends Holder {
  declare further: string;
  fillAll(value: number): void { this.fill(value); this.further = "f"; }
}
const name = ["shad", "owed"].join("");
function show(what: string, made: Holder, fill: (made: Holder) => void): void {
  let thrown = "";
  console.log(what + ", empty: " + made.read() + " | " + made.has() + " | " + Object.keys(made).join());
  try { fill(made); } catch (error) { thrown = (error as Error).name; }
  console.log(what + ": " + made.read() + " | " + made.has() + " | " + Object.keys(made).join() + " | " + JSON.stringify(made) + " | " + log.join() + " | " + thrown);
  log.length = 0;
}
const classes: [string, new () => Holder][] = [
  ["the class itself", Holder],
  ["accessor pair", withBoth(Holder, name)],
  ["getter only", withGetter(Holder, name)],
  ["method", withMethod(Holder, name)],
  ["another name", withBoth(Holder, "other")],
  ["below", Below],
  ["accessor pair over the subclass", withBoth(Below, name)],
  ["two mixins", withBoth(withGetter(Holder, "other"), name)],
];
for (const [what, made] of classes) {
  show(what, new made(), made => made.fill(5));
  show(what + ", the other field first", new made(), made => made.fillOwnFirst(7));
}
show("all three", new (withBoth(Below, name))(), made => (made as Below).fillAll(9));
let total = 0;
for (let i = 0; i < 300; i++) {
  const made = new (classes[i % classes.length]![1])();
  try { made.fill(i); } catch {}
  total += Object.keys(made).length;
}
console.log(total, log.length);
//// declared-fields-overwritten-by-the-constructor.ts
// A declared field is defined as undefined before the constructor's body runs. Where the body always stores again nobody sees that value, and every way to see it still works.
const seed: number = parseInt(process.argv[2] ?? "3", 10);
const seen: unknown[] = [];
function note(value: unknown): void { seen.push(value === undefined ? "undefined" : value); }

class Filled {
    count: number; ratio: number; on: boolean; label: string; next: Filled; parent: Filled | null; list: number[];
    constructor(n: number) {
        this.list = [n]; this.parent = null; this.next = this; this.label = "n" + n; this.on = n > 1; this.ratio = n + 0.5; this.count = n | 0;
    }
}
const filled = new Filled(seed);
note(Object.keys(filled).join());
note(JSON.stringify({ ...filled, next: 0 }));
note(filled.next.next.count ^ 5);
note(filled.count + filled.ratio);

class FilledOnOnePath { count!: number; constructor(n: number) { if (n > 100) this.count = n; } }
note(new FilledOnOnePath(seed).count);
note(new FilledOnOnePath(seed + 200).count);
note("count" in new FilledOnOnePath(seed));

class NeverFilled { count!: number; }
note(new NeverFilled().count);
note(Object.keys(new NeverFilled()).join());

class ReadsFirst { count!: number; before: unknown; constructor(n: number) { this.before = this.count; this.count = n; } }
note(new ReadsFirst(seed).before);

class MethodReadsFirst { count!: number; constructor(n: number) { this.look(); this.count = n; } look(): void { note(this.count); } }
note(new MethodReadsFirst(seed).count);

let registered: LeaksFirst | undefined;
function lookAtRegistered(): void { note(registered!.count); }
class LeaksFirst { count: number; constructor(n: number) { registered = this; lookAtRegistered(); this.count = n; } }
note(new LeaksFirst(seed).count);

class EnumeratesFirst { count: number; label: string; constructor(n: number) { note(JSON.stringify(this)); note(Object.keys(this).join()); this.label = "l"; this.count = n; } }
note(Object.keys(new EnumeratesFirst(seed)).join());

class TestsFirst { count: number; constructor(n: number) { note("count" in this); note(Object.hasOwn(this, "count")); this.count = n; } }
note(new TestsFirst(seed).count);

class FilledByMethod { count!: number; constructor(n: number) { this.reset(n); } reset(n: number): void { this.count = n * 2; } }
note(new FilledByMethod(seed).count);

class Parent { constructor() { this.start(); } start(): void { } }
class ReadWhileParentRuns extends Parent { count: number; constructor(n: number) { super(); this.count = n; } start(): void { note(this.count); note("count" in this); } }
note(new ReadWhileParentRuns(seed).count);

class StoredWhileParentRuns extends Parent { count!: number; constructor() { super(); } start(): void { this.count = 7; } }
note(new StoredWhileParentRuns().count);

let lastBuilt: Registering | undefined;
