// new.target is a subclass, a bound function, a proxy, or any function handed to Reflect.construct.
class Heir extends Context {
  own = "heir";
  #more = 1;
  more() {
    return this.#more;
  }
}
const heir = escape(new Heir("heir", { env: 1, path: "/h" }), 1);
console.log(heir.text("x"), heir.more(), Object.keys(heir).join(), heir instanceof Context);
function Plain() {}
Plain.prototype.marker = "plain";
const reflected = Reflect.construct(Context, ["reflected"], Plain);
console.log(reflected.marker, reflected.raw, reflected instanceof Context, Object.keys(reflected).join());
const proxied = new (new Proxy(Context, {}))("proxied");
console.log(proxied.raw, Object.keys(proxied).join());

// Objects that lose fields and get them back keep the order a program can see.
const changed = new Context("changed");
delete changed.finalized;
changed.finalized = "again";
Object.defineProperty(changed, "error", { get: () => "getter", enumerable: true, configurable: true });
console.log(Object.keys(changed).join(), changed.error, changed.text("y"));

// Another parent at run time: super(..) constructs with it, and the fields of the class land on what it returns.
class OtherBase {
  constructor(raw) {
    this.other = raw;
  }
}
for (let i = 0; i < 4; i++) {
  if (i === 2) Object.setPrototypeOf(Heir, OtherBase);
  const relinked = escape(new Heir("relinked" + i, { env: i, path: "/r" }), i);
  console.log(Object.keys(relinked).join(), relinked.more(), relinked.other, relinked instanceof Context, Context.has(relinked));
}
//// fields-initialized-with-constants.ts
// Class fields initialized with string constants and built-in functions: loading such a constant may allocate, which must not happen between an object's allocation and its initializing stores.
export {};
class Named { name = "a name"; kind: string; other = "other"; n = 1; constructor(kind: string) { this.kind = kind; } }
class Derived extends Named { more = "more"; fn = Math.max; constructor() { super("derived"); } }
class WithFunctions { a = Math.floor; b = Array.isArray; c = "text"; d = parseInt; }
interface Pair { first: string; second: string; n: number }
type Tagged = { tag: "x"; value: string } | { tag: "y"; value: number };
function record(n: number): Pair { return { first: "first", second: "second", n }; }
function tagged(n: number): Tagged { return n & 1 ? { tag: "x", value: "odd" } : { tag: "y", value: n }; }
function nested(n: number) { return { outer: "outer", inner: { deep: "deep", list: ["l0", "l1", "l2"], n }, after: "after" }; }
function strings(): string[] { return ["zero", "one", "two", "three", "four", "five"]; }
function mixed(n: number): (string | number)[] { return ["s", n, "t", n + 1]; }
function functions() { return [Math.min, Math.max, String, "between", Number]; }
function tuple(n: number): [string, number, string] { return ["left", n, "right"]; }
function closure(n: number) { const s = "captured", f = Math.abs, t = "too"; return () => s + f(-n) + t; }
function map() { return new Map<string, string>([["k1", "v1"], ["k2", "v2"]]); }
function set() { return new Set<string>(["m1", "m2", "m3"]); }
function* generator(n: number) { const s = "kept over a yield"; yield "first yield"; yield s + n; }
async function asynchronous(n: number) { const s = "kept over an await"; await null; return s + n; }
function template(n: number) { return { text: `t${n}`, plain: "plain", joined: "a" + "b" }; }
function spread(p: Pair) { return { ...p, added: "added", second: "replaced" }; }
function conditional(c: boolean) { return { a: c ? "yes" : "no", b: c ? Math.ceil : Math.round, c: "always" }; }
function argumentsOf(...rest: string[]) { return rest.join(); }
function compared(s: string, o: Named) { return s === "a name" ? o.name === s : o.kind === "derived" || s === "other"; }
let sum = 0; const kept: unknown[] = [];
for (let i = 0; i < 60000; i++) {
  const n = new Named("kind"), d = new Derived(), w = new WithFunctions(), r = record(i), t = tagged(i), ne = nested(i), s = strings(), m = mixed(i), f = functions(), tu = tuple(i), c = closure(i), te = template(i), sp = spread(r), co = conditional((i & 1) === 0);
  sum += n.name.length + n.kind.length + n.other.length + d.more.length + d.kind.length + d.fn(1, 2) + w.a(1.5) + (w.b(s) ? 1 : 0) + w.c.length + w.d("7") + r.first.length + r.second.length + t.tag.length + String(t.value).length + ne.outer.length + ne.inner.deep.length + ne.inner.list[2].length + ne.after.length
    + s[5].length + String(m[2]).length + (f[0] as typeof Math.min)(3, 4) + String(f[3]).length + tu[0].length + tu[2].length + c().length + te.text.length + te.plain.length + te.joined.length + sp.added.length + sp.second.length + sp.first.length + co.a.length + co.b(1.4) + co.c.length + argumentsOf("p", "q", "r").length + (compared(n.name, d) ? 1 : 0) + (compared("other", n) ? 1 : 0);
  if ((i & 1023) === 0) { const ma = map(), se = set(); sum += ma.get("k2")!.length + se.size + [...generator(i)].join().length; kept.push(n, d, w, r, t, ne, s, m, f, tu, c, ma, se, te, sp, co); }
}
console.log(sum, kept.length, JSON.stringify(kept.slice(0, 10)).length, JSON.stringify(kept[kept.length - 16]), JSON.stringify(kept[kept.length - 11]), (kept[kept.length - 6] as () => string)());
asynchronous(5).then(v => console.log(v));
//// fields-of-builtin-subclasses.ts
// The instance of a class that extends a built-in class is an object of the built-in class, and its own fields are ordinary properties of it. Number, string and object fields, methods, getters,
// private fields and a second level on subclasses of Error, Array, Map, Set, Uint8Array and Promise, read again after 2,000 instances and a collection.
const print = (value: unknown): void => console.log(String(value));
const gc = (): void => Bun.gc(true);
{
  class Failure extends Error {
    code: number;
    detail: string;
    info: { a: number };
    #secret = 41;
    constructor(m: string) {
      super(m);
      this.code = 7;
      this.detail = "d" + m;
      this.info = { a: 3 };
    }
    describe() { return this.detail + ":" + this.code + ":" + this.info.a; }
    get twice() { return this.code * 2; }
    secret() { return this.#secret + 1; }
  }
  class Deeper extends Failure {
    level = 2;
    constructor(m: string) { super(m + "!"); this.code = 9; }
    describe() { return "deep " + super.describe() + ":" + this.level; }
  }
  const f = new Failure("boom");
  print(f.code);
  print(f.detail);
  print(f.info.a);
  print(f.describe());
  print(f.twice);
  print(f.secret());
  print(f instanceof Failure);
  print(f instanceof Error);
  print(f instanceof Deeper);
  const d = new Deeper("x");
  print(d.code);
  print(d.level);
  print(d.describe());
  print(d.twice);
  print(d.secret());
  print(d instanceof Deeper);
  print(d instanceof Failure);
  print(d instanceof Error);
  const k = Object.keys(f);
  print(k.length);
  for (let i = 0; i < k.length; i++) print(k[i]);
  const k2 = Object.keys(d);
  print(k2.length);
  for (let i = 0; i < k2.length; i++) print(k2[i]);
  try { throw new Deeper("t"); } catch (e) { print(e instanceof Failure ? e.describe() : "no"); }
  const all: Failure[] = [];
  for (let i = 0; i < 2000; i++) all.push(i & 1 ? new Failure("m" + i) : new Deeper("n" + i));
  gc();
  let sum = 0;
  for (let i = 0; i < all.length; i++) sum += all[i].code + all[i].detail.length + all[i].info.a + all[i].secret();
  print(sum);
}
{
  class List extends Array<number> {
    tag: string;
    size: number;
    box: { v: number };
    #hidden = 5;
    constructor() {
      super();
      this.tag = String(Math.random()).length > 0 ? "t" : "u";
      this.size = 1.5;
      this.box = { v: 9 };
    }
    total() { let s = 0; for (let i = 0; i < this.length; i++) s += this[i]; return s + this.size; }
    get label() { return this.tag + this.length; }
    hidden() { return this.#hidden; }
    bump() { this.#hidden++; return this; }
  }
  class Longer extends List {
    extra = "x";
    total() { return super.total() * 2; }
  }
  const l = new List();
  print(l.length);
  l.push(5); l.push(6);
  l[2] = 7;
  print(l.length);
  print(l[0] + l[1] + l[2]);
  print(l.tag);
  print(l.size);
  print(l.box.v);
  print(l.total());
  print(l.label);
  print(l.hidden());
  print(l.bump().hidden());
  print(l instanceof List);
  print(l instanceof Array);
  print(l instanceof Longer);
  print(Array.isArray(l));
  const k = Object.keys(l);
  print(k.length);
  for (let i = 0; i < k.length; i++) print(k[i]);
  print(JSON.stringify(l));
  const m = new Longer();
  m.push(1);
  print(m.total());
  print(m.extra);
  print(m.label);
  print(m instanceof Longer);
  print(m instanceof List);
  const k2 = Object.keys(m);
  for (let i = 0; i < k2.length; i++) print(k2[i]);
  l.length = 1;
  print(l.length);
  print(l[1]);
  const all: List[] = [];
  for (let i = 0; i < 2000; i++) { const x = i & 1 ? new List() : new Longer(); x.push(i); all.push(x); }
  gc();
  let sum = 0;
  for (let i = 0; i < all.length; i++) sum += all[i].total() + all[i].tag.length + all[i].box.v + all[i].hidden() + all[i].length;
  print(sum);
}
{
  class Registry extends Map<string, number> {
    hits = 0;
    name: string;
    meta: { kind: string };
    #count = 0;
    constructor(name: string) { super(); this.name = name; this.meta = { kind: "k" + name }; }
    add(k: string, v: number) { this.#count++; this.set(k, v); return this; }
    lookup(k: string) { this.hits++; return this.get(k); }
    get count() { return this.#count; }
  }
  class Deep extends Registry {
    depth = 2;
    lookup(k: string) { return (super.lookup(k) ?? -1) + this.depth; }
  }
  class Bag extends Set<number> {
    label = "bag";
    weight = 0.5;
    put(n: number) { this.add(n); this.weight += n; return this.size; }
  }
  const r = new Registry("a");
  r.add("x", 1).add("y", 2);
  print(r.size);
  print(r.lookup("x"));
  print(r.lookup("z"));
  print(r.hits);
  print(r.name);
  print(r.meta.kind);
  print(r.count);
  print(r instanceof Registry);
  print(r instanceof Map);
  print(r instanceof Deep);
  let ks = Object.keys(r);
  print(ks.length);
  for (let i = 0; i < ks.length; i++) print(ks[i]);
  print(JSON.stringify(r));
  const d = new Deep("b");
  d.add("q", 40);
  print(d.lookup("q"));
  print(d.lookup("none"));
  print(d.hits);
  print(d.depth);
  print(d instanceof Registry);
  ks = Object.keys(d);
  for (let i = 0; i < ks.length; i++) print(ks[i]);
  const b = new Bag();
  print(b.put(3));
  print(b.put(4));
  print(b.put(3));
  print(b.weight);
  print(b.label);
  print(b.has(4));
  print(b instanceof Set);
  print(b instanceof Bag);
  print(JSON.stringify(b));
  const all: Registry[] = [];
  const bags: Bag[] = [];
  for (let i = 0; i < 2000; i++) { const x = i & 1 ? new Registry("n" + i) : new Deep("m" + i); x.add("k", i); all.push(x); const g = new Bag(); g.put(i); bags.push(g); }
  gc();
  let sum = 0;
  for (let i = 0; i < all.length; i++) sum += all[i].lookup("k")! + all[i].name.length + all[i].meta.kind.length + all[i].count + all[i].size + bags[i].weight + bags[i].size;
  print(sum);
}
{
  class Bytes extends Uint8Array {
    cursor = 0;
    name: string;
    meta: { a: number };
    #mark = 3;
    constructor(n: number, name: string) { super(n); this.name = name; this.meta = { a: n }; }
    next() { return this[this.cursor++]; }
    get left() { return this.length - this.cursor; }
    mark() { return this.#mark; }
  }
  class More extends Bytes {
    level = 2;
    next() { return super.next() + this.level; }
  }
  const b = new Bytes(4, "b");
  b[0] = 10; b[1] = 300; b[2] = 30;
  print(b.length);
  print(b.next());
  print(b.next());
  print(b.left);
  print(b.cursor);
  print(b.name);
  print(b.meta.a);
  print(b.mark());
  print(b instanceof Bytes);
  print(b instanceof Uint8Array);
  print(b.byteLength);
  const ks = Object.keys(b);
  print(ks.length);
  for (let i = 0; i < ks.length; i++) print(ks[i]);
  print(JSON.stringify(b));
  const m = new More(2, "m");
  m[0] = 1;
  print(m.next());
  print(m.level);
  print(m instanceof Bytes);
  const all: Bytes[] = [];
  for (let i = 0; i < 2000; i++) { const x = i & 1 ? new Bytes(3, "n" + i) : new More(3, "m" + i); x[0] = i; all.push(x); }
  gc();
  let sum = 0;
  for (let i = 0; i < all.length; i++) sum += all[i].next() + all[i].name.length + all[i].meta.a + all[i].mark() + all[i].left;
  print(sum);
}
{
  class Task<T> extends Promise<T> {
    label = "task";
    started = 1;
    info: { n: number } = { n: 4 };
    describe() { return this.label + this.started + this.info.n; }
  }
  const t = new Task<number>((resolve) => resolve(7));
  print(t.label);
  print(t.started);
  print(t.info.n);
  print(t.describe());
  print(t instanceof Task);
  print(t instanceof Promise);
  const ks = Object.keys(t);
  print(ks.length);
  for (let i = 0; i < ks.length; i++) print(ks[i]);
  t.then((v) => { print("then " + v); });
  const u = t.then((v) => v + 1);
  print(u instanceof Task);
  print((u as Task<number>).label);
  u.then((v) => { print("chained " + v); });
  async function f() { const v = await t; print("awaited " + v); }
  f();
  const all: Task<number>[] = [];
  for (let i = 0; i < 2000; i++) all.push(new Task<number>((resolve) => resolve(i)));
  gc();
  let sum = 0;
  for (let i = 0; i < all.length; i++) sum += all[i].started + all[i].info.n + all[i].label.length;
  print(sum);
}
//// fields-with-constant-computed-names.ts
// Instance fields whose computed names are string constants: `readonly [TypeId] = TypeId`. They are own properties in the order
// of their declarations, like fields with written names, and `x[TypeId]` reads them.
const TypeId = '~test/Reason'
const tagName = `${TypeId}/tag` as const
const labelName = 'label'
const errorName = `${TypeId}/error` as const

abstract class Reason<Tag extends string> {
  readonly [TypeId]: typeof TypeId
  readonly first = 1;
  readonly [tagName]: Tag;
  [labelName] = () => 'labelled'
  last: number | undefined
  constructor(tag: Tag) {
    this[TypeId] = TypeId
    this[tagName] = tag
  }
  describe() {
    return this[TypeId] + ' ' + this[tagName] + ' ' + this.first + ' ' + this[labelName].name + ' ' + this.label()
  }
}
class Fail extends Reason<'Fail'> {
  readonly [errorName]: string
  constructor(readonly error: string) {
    super('Fail')
    this[errorName] = error
  }
}

const fail = new Fail('boom')
console.log(Object.keys(fail).join())
console.log(JSON.stringify(fail))
console.log(fail.describe(), fail['~test/Reason/error'], Object.hasOwn(fail, TypeId), TypeId in fail, '~test/Reason/tag' in fail)

let count = 0
for (let i = 0; i < 1000; i++) {
  const each = new Fail('e' + i)
  if (each[TypeId] === TypeId && each[tagName] === 'Fail') count += each.error.length
}
console.log(count)

const hidden: any = fail
delete hidden[tagName]
hidden[tagName] = 'again'
console.log(Object.keys(hidden).join(), hidden.describe())

function makeEarly() {
  return class Early {
    [lateName] = 1
  }
}
try {
  console.log(Object.keys(new (makeEarly())()).join())
} catch (error) {
  console.log((error as Error).name)
}
const lateName = 'late'
console.log(Object.keys(new (makeEarly())()).join())
//// frozen-and-sealed-instances.ts
// Stores to frozen, sealed and non-extensible class instances and records: one store, a run of stores, compound stores, a store that adds an optional field and a delete, from strict and from sloppy functions. A copy of such an object takes every store. The file mentions module.exports, so it runs as CommonJS and a function without "use strict" is sloppy: there a store that fails is skipped, in strict code it throws a TypeError and the stores after it do not run.
class Point { x = 1; y = 2; label = "p"; }
interface Entry { key: string; hits: number; note?: string; weight?: number }
function calledSloppy(this: unknown): boolean { return this !== undefined; } function calledStrict(this: unknown): boolean { "use strict"; return this === undefined; }
function sloppyStore(p: Point): void { p.x = 10; } function strictStore(p: Point): void { "use strict"; p.x = 10; }
function sloppyRun(p: Point): void { p.x = 20; p.y = 21; p.label = "run"; } function strictRun(p: Point): void { "use strict"; p.x = 20; p.y = 21; p.label = "run"; }
function sloppyCompound(p: Point): void { p.x += 5; p.y++; p.label += "!"; } function strictCompound(p: Point): void { "use strict"; p.x += 5; p.y++; p.label += "!"; }
function sloppyAdd(e: Entry): void { e.note = "n"; } function strictAdd(e: Entry): void { "use strict"; e.note = "n"; }
function sloppyRunWithAdds(e: Entry): void { e.hits = 30; e.note = "n"; e.weight = 1.5; e.key = "last"; } function strictRunWithAdds(e: Entry): void { "use strict"; e.hits = 30; e.note = "n"; e.weight = 1.5; e.key = "last"; }
function sloppyDelete(e: Entry): boolean { return delete e.note; } function strictDelete(e: Entry): boolean { "use strict"; return delete e.note; }
function attempt(f: () => unknown): string { try { return String(f()); } catch (e) { return (e as Error).name; } }
function showPoint(p: Point): string { return [p.x, p.y, p.label, Object.keys(p).join("")].join("/"); } function showEntry(e: Entry): string { return [e.key, e.hits, String(e.note), String(e.weight), Object.keys(e).join("")].join("/"); }
const levels: [string, (o: object) => void][] = [["extensible", () => {}], ["non-extensible", o => { Object.preventExtensions(o); }], ["sealed", o => { Object.seal(o); }], ["frozen", o => { Object.freeze(o); }]];
console.log(calledSloppy(), calledStrict(), typeof module.exports);
for (const [level, restrict] of levels) {
  for (const store of [sloppyStore, strictStore, sloppyRun, strictRun, sloppyCompound, strictCompound]) { const p = new Point(); restrict(p); console.log(level, store.name, attempt(() => store(p)), showPoint(p)); }
  for (const store of [sloppyAdd, strictAdd, sloppyRunWithAdds, strictRunWithAdds, sloppyDelete, strictDelete]) {
    const bare: Entry = { key: "k", hits: 0 }, noted: Entry = { key: "k", hits: 0, note: "old" }; restrict(bare); restrict(noted);
    console.log(level, store.name, attempt(() => store(bare)), showEntry(bare), attempt(() => store(noted)), showEntry(noted));
  }
  const point = new Point(), entry: Entry = { key: "k", hits: 0, note: "old" }; restrict(point); restrict(entry);
  const pointCopy = { ...point }, entryCopy: Entry = { ...entry }; pointCopy.x = 40; pointCopy.label += "!";
  console.log(level, "copy", pointCopy.x, pointCopy.label, Object.isExtensible(pointCopy), attempt(() => strictRunWithAdds(entryCopy)), attempt(() => strictDelete(entryCopy)), showEntry(entryCopy), Object.isSealed(entryCopy), showPoint(point), showEntry(entry));
}
