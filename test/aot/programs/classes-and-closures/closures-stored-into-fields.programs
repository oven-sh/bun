    } catch (e) {
      console.log("caught");
    }
  }
});
////= attempt-10	"return 1 in try, no super()"	1
attempt("end of try, no super()", class B extends A {
  constructor() {
    try {
      steps.push("try");
    } catch (e) {
      console.log("caught");
    }
  }
});
attempt("return in try", class B extends A {
  constructor() {
    super();
    try {
      return;
    } catch (e) {
      console.log("caught");
    }
  }
});
////= attempt-8	"return undefined in try"	undefined
////= attempt-8	"return an object in try"	other
////= attempt-10	"return an object in try, no super()"	other
