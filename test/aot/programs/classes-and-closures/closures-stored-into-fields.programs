class Listed { n = 5; f = () => this.n; } { const o = new Listed(), names: string[] = []; for (const name in o) names.push(name); console.log("listed", names.join(), Object.keys(o).join(), "f" in o, Object.hasOwn(o, "f"), JSON.stringify(o), o.f()); }
