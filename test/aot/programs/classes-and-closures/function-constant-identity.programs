attempt("Reflect.defineProperty Map[Symbol.hasInstance]", () => (Reflect as any)["define" + "Property"](Map, Symbol.hasInstance, { value: () => true, configurable: true }));
attempt("assign Array[Symbol.hasInstance]", () => { (Array as any)[Symbol.hasInstance] = () => false; return 1; });
attempt("Object.setPrototypeOf(Map, ..)", () => (Object as any)["set" + "PrototypeOf"](Map, { [Symbol.hasInstance]: () => true }));
attempt("Object.setPrototypeOf(Set.prototype, Map.prototype)", () => (Object as any)["set" + "PrototypeOf"](Set.prototype, Map.prototype));
table("after the attempts");
console.log(lines.join("\n"));
//// instanceof-by-every-path.ts
class A {
    name(): string {
        return "A";
    }
}
class B extends A {
    override name(): string {
        return "B";
    }
}
class C extends B {
    override name(): string {
        return "C";
    }
}
class L {
    name(): string {
        return "L";
    }
}

function answers(value: unknown): string {
    let found = "";
    if (value instanceof A) found += "A";
    if (value instanceof B) found += "B";
    if (value instanceof C) found += "C";
    if (value instanceof L) found += "L";
    return found === "" ? "none" : found;
}

function asBooleans(value: unknown): boolean[] {
    return [value instanceof A, value instanceof B, value instanceof C, value instanceof L];
}

function createValues(): [string, unknown][] {
    return [
        ["new A", new A()],
        ["new B", new B()],
        ["new C", new C()],
        ["new L", new L()],
        ["B with the prototype of L", Object.setPrototypeOf(new B(), L.prototype)],
        ["L with the prototype of C", Object.setPrototypeOf(new L(), C.prototype)],
        ["Object.create(A.prototype)", Object.create(A.prototype)],
        ["Object.create(C.prototype)", Object.create(C.prototype)],
        ["Object.create(null)", Object.create(null)],
        ["proxy of B", new Proxy(new B(), {})],
        ["proxy that answers L", new Proxy(new B(), { getPrototypeOf: () => L.prototype })],
        ["plain object", {}],
        ["function", function () {}],
        ["array", []],
        ["number", 1],
        ["double", 1.5],
        ["string", "A"],
        ["boolean", true],
        ["symbol", Symbol("A")],
        ["bigint", 1n],
        ["undefined", undefined],
        ["null", null],
    ];
}

function report(title: string): void {
    console.log(title);
    const values = createValues();
    for (const [label, value] of values) console.log(label, answers(value), asBooleans(value).join());

    const counts = new Map<string, number>();
    for (let round = 0; round < 20000; round++) {
        const [label, value] = values[round % values.length];
        if (answers(value) !== "none") counts.set(label, (counts.get(label) ?? 0) + 1);
    }
    for (const [label, count] of counts) console.log(label, count);
}

report("by layout");

Object.defineProperty(A, Symbol.hasInstance, { value: (value: unknown) => value === "A" });
report("A answers for itself");

Object.defineProperty(L, Symbol.hasInstance, { value: () => true });
report("L answers yes");
//// instanceof-of-a-value-that-may-be-undefined.js
// A class that is evaluated twice, so that `instanceof` is answered under tests, and values that are instances of it or undefined.
function makeCounter(step) {
  return class Counter {
    n = 0;
    bump() {
      return (this.n += step);
    }
  };
}
const ByOne = makeCounter(1);
const ByTen = makeCounter(10);
const all = [new ByOne(), new ByTen(), new ByOne()];

const isByOne = counter => counter instanceof ByOne;
const isByTen = counter => counter instanceof ByTen;

console.log(all.map(isByOne).join(), all.map(isByTen).join());
console.log(isByOne(all[0]), isByOne(all[1]), isByOne(all[7]), isByTen(all[7]));

let instances = 0;
for (let index = 0; index < 6; index++) {
  if (isByOne(all[index])) instances += 1;
  if (isByTen(all[index])) instances += 10;
}
console.log(instances);

const found = all.find(counter => counter.n > 5);
console.log(found instanceof ByOne, found instanceof ByTen, all.at(-1) instanceof ByOne, all.at(9) instanceof ByOne);
//// instanceof-on-values-nobody-knows.js
// `x instanceof C` with C a class of the program and x a value nobody can follow, before and after everything that changes the answer.
const unknown = new Function("value", "return value" + process.argv[0].slice(process.argv[0].length));
const lines = [];

class Base { constructor() { this.z = 1; } }
class Left extends Base { constructor() { super(); this.l = 1; } }
class Right extends Base { constructor() { super(); this.r = "r"; } }
class LeftLeaf extends Left {}
class Alone {}
class FromNull extends null { static make() { return Object.create(FromNull.prototype); } }
class List extends Array {}
class Failure extends Error {}
function Legacy() { this.old = true; }
function LegacyChild() { Legacy.call(this); }
LegacyChild.prototype = Object.create(Legacy.prototype);
function Twin() {}
Twin.prototype = Legacy.prototype;

function isBase(x) { return x instanceof Base; }
function isLeft(x) { return x instanceof Left; }
function isRight(x) { return x instanceof Right; }
function isLeftLeaf(x) { return x instanceof LeftLeaf; }
function isAlone(x) { return x instanceof Alone; }
function isFromNull(x) { return x instanceof FromNull; }
function isList(x) { return x instanceof List; }
function isFailure(x) { return x instanceof Failure; }
function isLegacy(x) { return x instanceof Legacy; }
function isLegacyChild(x) { return x instanceof LegacyChild; }
function isTwin(x) { return x instanceof Twin; }
const tests = [isBase, isLeft, isRight, isLeftLeaf, isAlone, isFromNull, isList, isFailure, isLegacy, isLegacyChild, isTwin];
function fourInARow(a, b, c, d) { let r = 0; if (a instanceof Left) r |= 1; if (b instanceof Left) r |= 2; if (c instanceof Left) r |= 4; if (d instanceof Left) r |= 8; return r; }

function answers(value) {
  let text = "";
  for (const test of tests) {
    let answer;
    try { answer = test(value) ? "1" : "0"; } catch (error) { answer = "!"; }
    text += answer;
  }
  return text;
}
const make = {
  base: () => new Base(), left: () => new Left(), right: () => new Right(), leaf: () => new LeftLeaf(), alone: () => new Alone(), fromNull: () => FromNull.make(),
  list: () => new List(), failure: () => new Failure("f"), legacy: () => new Legacy(), legacyChild: () => new LegacyChild(), twin: () => new Twin(),
  literal: () => ({ z: 1 }), created: () => Object.create(Left.prototype), bare: () => Object.create(null), array: () => [], func: () => function () {}, classObject: () => Left,
  prototypeObject: () => Left.prototype, undefinedValue: () => undefined, nullValue: () => null, number: () => 1, text: () => "t", symbol: () => Symbol.iterator, big: () => 1n,
  proxyOfLeft: () => new Proxy(new Left(), {}), proxyThatLies: () => new Proxy({}, { getPrototypeOf() { return Right.prototype; } }), bound: () => isLeft.bind(null),
};
function round(label) {
  for (const [name, maker] of Object.entries(make))
    lines.push(label + ", " + name + ": " + answers(maker()) + " " + answers(unknown(maker())));
  lines.push(label + ", four: " + fourInARow(unknown(new Left()), unknown(new Right()), unknown(new LeftLeaf()), unknown(null)) + " " + fourInARow(new Base(), new Left(), undefined, unknown({})));
}

for (let warm = 0; warm < 3; warm++) { lines.length = 0; round("as defined"); }

const moved = unknown(new Left());
Object.setPrototypeOf(moved, Right.prototype);
lines.push("an instance under another prototype: " + answers(moved));
Object.setPrototypeOf(moved, Left.prototype);
lines.push("and back: " + answers(moved));
const extended = unknown(new Right());
extended.extra = 1;
lines.push("an instance with another property: " + answers(extended));

const boundLeft = unknown(Left).bind(null);
lines.push("a bound class: " + [new Left() instanceof boundLeft, unknown(new Right()) instanceof boundLeft, unknown(null) instanceof boundLeft].join());
for (const notCallable of [undefined, null, 1, "t", {}, Left.prototype]) {
  let answer;
  try { answer = unknown(new Left()) instanceof unknown(notCallable); } catch (error) { answer = error.constructor.name; }
  lines.push("right side " + String(notCallable && typeof notCallable) + ": " + answer);
}

function defineTwice() { return class Twice { }; }
const First = defineTwice(), Second = defineTwice();
function isTwice(x, C) { return x instanceof C; }
lines.push("a class evaluated twice: " + [isTwice(new First(), First), isTwice(new First(), Second), isTwice(unknown(new Second()), Second), isTwice(unknown(new Second()), First)].join());

Object.setPrototypeOf(Left.prototype, Alone.prototype);
round("Left.prototype inherits from Alone.prototype");
Object.setPrototypeOf(Left.prototype, Base.prototype);
round("and from Base.prototype again");

Object.setPrototypeOf(Alone, { [Symbol.hasInstance](x) { return typeof x === "number"; } });
round("Alone inherits another Symbol.hasInstance");
Object.setPrototypeOf(Alone, { [Symbol.hasInstance]: undefined });
round("Alone inherits none");
Object.setPrototypeOf(Alone, Function.prototype);
round("Alone inherits from Function.prototype again");

Object.defineProperty(Base, Symbol.hasInstance, { configurable: true, value(x) { return x === 1 || x === "t"; } });
round("Base has its own Symbol.hasInstance, which its subclasses inherit");
delete Base[Symbol.hasInstance];
round("and has it no more");

Legacy.prototype = { replaced: true };
round("Legacy.prototype is another object");

const ordinary = Function.prototype[Symbol.hasInstance];
lines.push("the ordinary function by hand: " + [ordinary.call(Left, new LeftLeaf()), ordinary.call(Left, unknown(new Right())), ordinary.call({}, new Left()), ordinary.call(unknown(Alone), unknown(new Alone()))].join());
console.log(lines.join("\n"));
//// instanceof-program-classes.ts
declare const console: { log(...values: unknown[]): void };
class Shape { constructor(public id: number) {} }
class Circle extends Shape { constructor(id: number, public radius: number) { super(id); } }
class Ring extends Circle { constructor(id: number, radius: number, public hole: number) { super(id, radius); } }
class Square extends Shape { constructor(id: number, public side: number) { super(id); } }
class Alone { constructor(public name: string) {} }
class Judged { constructor(public id: number) {} static [Symbol.hasInstance](value: unknown): boolean { return value === 42; } }
class HeirOfJudged extends Judged { }
class Changed { constructor(public id: number) {} }
class HeirOfChanged extends Changed { }
class Reparented { constructor(public id: number) {} }
class Counted { static made = 0; static make(): Counted { Counted.made++; return new Counted(); } }

function isCircle(s: Shape): boolean { return s instanceof Circle; }
function isRing(s: Shape): boolean { return s instanceof Ring; }
function isShape(s: Shape | Alone): boolean { return s instanceof Shape; }
function isCircleOrNothing(s: Shape | null | undefined): boolean { return s instanceof Circle; }
function isCircleOfAnything(s: unknown): boolean { return s instanceof Circle; }
function radiusOf(s: Shape): number { return s instanceof Circle ? s.radius : -1; }
function count(all: Shape[]): string { let circles = 0, rings = 0, squares = 0; for (const s of all) { if (s instanceof Ring) rings++; else if (s instanceof Circle) circles++; else if (s instanceof Square) squares++; } return circles + " " + rings + " " + squares; }
function isJudged(x: Judged | number): boolean { return x instanceof Judged; }
function isHeirOfJudged(x: Judged | number): boolean { return x instanceof HeirOfJudged; }
function isChanged(x: Changed): boolean { return x instanceof Changed; }
function isHeirOfChanged(x: Changed): boolean { return x instanceof HeirOfChanged; }
function isReparented(x: Reparented): boolean { return x instanceof Reparented; }
function isCounted(x: Counted | Alone): boolean { return x instanceof Counted; }

const all: Shape[] = [new Shape(1), new Circle(2, 5), new Ring(3, 6, 1), new Square(4, 7)];
for (let turn = 0; turn < 3; turn++) {
    console.log("circle", all.map(isCircle).join());
    console.log("ring", all.map(isRing).join());
    console.log("shape", all.map(isShape).join(), isShape(new Alone("a")));
    console.log("nothing", isCircleOrNothing(null), isCircleOrNothing(undefined), isCircleOrNothing(all[1]), isCircleOrNothing(all[3]));
    console.log("anything", [1, "x", null, undefined, {}, [], () => 1, Symbol.iterator, all[0], all[1], all[2], Object.create(Circle.prototype), Object.create(null), new Proxy(all[1], {})].map(isCircleOfAnything).join());
    console.log("radius", all.map(radiusOf).join());
    console.log("count", count(all));
    console.log("judged", isJudged(new Judged(1)), isJudged(42), isHeirOfJudged(new HeirOfJudged(1)), isHeirOfJudged(42));
    console.log("changed", isChanged(new Changed(1)), isChanged(new HeirOfChanged(1)), isHeirOfChanged(new Changed(1)), isHeirOfChanged(new HeirOfChanged(1)));
    console.log("reparented", isReparented(new Reparented(1)));
    console.log("counted", isCounted(Counted.make()), isCounted(new Alone("b")), Counted.made);
    if (turn === 0) {
        Object.defineProperty(Changed, Symbol.hasInstance, { value: (x: Changed) => x.id === 2, configurable: true });
        Object.setPrototypeOf(Reparented, { [Symbol.hasInstance]: () => false });
    }
    if (turn === 1) {
        delete (Changed as unknown as Record<symbol, unknown>)[Symbol.hasInstance];
        Object.setPrototypeOf(Reparented, Function.prototype);
    }
}
console.log("id 2", isChanged(new Changed(2)), isHeirOfChanged(new Changed(2)));
try { Object.defineProperty(Function.prototype, Symbol.hasInstance, { value: () => true }); console.log("defined"); } catch (e) { console.log(e instanceof TypeError); }
console.log("still", all.map(isCircle).join());
//// instanceof-when-instances-change-prototype.ts
// x instanceof C for classes that are also handed about as values, so that their instances may be given another prototype: by Object.setPrototypeOf, __proto__, Reflect.construct with another new.target, Object.create; in loops and outside; then with Symbol.hasInstance defined on the class.
class Animal {
  legs = 4;
  name: string;
  constructor(name: string) {
    this.name = name;
  }
}
////= lines-22	Dog	extends	Animal	barks	true
////= lines-22	Puppy	extends	Dog	age	1
////= lines-43	Stone	weight	9
////= lines-43	Alone	value	1
const handedAbout: any[] = [Animal, Dog, Puppy, Stone, Alone];
const lines: string[] = [];

////= lines-44	isAnimal	unknown	Animal
////= lines-44	isDog	unknown	Dog
////= lines-44	isPuppy	unknown	Puppy
////= lines-44	isStone	unknown	Stone
////= lines-44	isAlone	unknown	Alone
////= lines-44	typedIsDog	Animal	Dog
function typedIsAlone(x: Alone | Stone) {
  return x instanceof Alone;
}
function countInLoop(all: unknown[]) {
  let animals = 0, dogs = 0, puppies = 0, stones = 0, alone = 0;
  for (let round = 0; round < 3; round++) {
    for (const x of all) {
      if (x instanceof Animal) animals++;
      if (x instanceof Dog) dogs++;
      if (x instanceof Puppy) puppies++;
      if (x instanceof Stone) stones++;
      if (x instanceof Alone) alone++;
    }
  }
  return [animals, dogs, puppies, stones, alone].join();
}
function countTypedInLoop(all: Animal[]) {
  let dogs = 0, puppies = 0;
  for (let round = 0; round < 3; round++) {
    for (const x of all) {
      if (x instanceof Dog) dogs++;
      if (x instanceof Puppy) puppies++;
    }
  }
  return dogs + "," + puppies;
}
function tell(what: string, x: unknown) {
  lines.push(what + ": " + [isAnimal(x), isDog(x), isPuppy(x), isStone(x), isAlone(x)].map(Number).join("") + " in a loop " + countInLoop([x]));
}

const animal = new Animal("a"), dog = new Dog("d"), puppy = new Puppy("p"), stone = new Stone(), alone = new Alone();
tell("an animal", animal);
tell("a dog", dog);
tell("a puppy", puppy);
tell("a stone", stone);
tell("alone", alone);
for (const x of [undefined, null, 0, 1.5, "text", true, Symbol.iterator, 1n, {}, [], () => {}, Animal, Animal.prototype, Dog.prototype, Object.create(null)]) tell(typeof x === "symbol" ? "a symbol" : typeof x === "bigint" ? "a bigint" : typeof x + " " + (typeof x === "function" ? x.name : JSON.stringify(x)), x);

tell("made with Object.create(Animal.prototype)", Object.create(Animal.prototype));
tell("made with Object.create(Puppy.prototype)", Object.create(Puppy.prototype));
tell("made with Object.create(a dog)", Object.create(dog));
tell("a literal with __proto__ Stone.prototype", { __proto__: Stone.prototype });
tell("Reflect.construct(Animal, .., Stone)", Reflect.construct(Animal, ["r"], Stone));
tell("Reflect.construct(Stone, .., Puppy)", Reflect.construct(Stone, [], Puppy));
tell("Reflect.construct(Alone, .., Object)", Reflect.construct(Alone, [], Object));
tell("Reflect.construct(Dog, .., a function without a class)", Reflect.construct(Dog, ["r"], function Other() {}));
tell("a proxy of a dog", new Proxy(dog, {}));
tell("a proxy that names another prototype", new Proxy(stone, { getPrototypeOf: () => Puppy.prototype }));

const changed = new Dog("changed");
tell("a dog before", changed);
Object.setPrototypeOf(changed, Stone.prototype);
tell("the dog with Stone.prototype", changed);
lines.push("typed: " + typedIsDog(changed) + " " + countTypedInLoop([changed, dog, puppy, animal]));
Object.setPrototypeOf(changed, Animal.prototype);
tell("the dog with Animal.prototype", changed);
Object.setPrototypeOf(changed, Puppy.prototype);
tell("the dog with Puppy.prototype", changed);
Object.setPrototypeOf(changed, null);
tell("the dog without a prototype", changed);
Object.setPrototypeOf(changed, Dog.prototype);
tell("the dog with its own again", changed);
lines.push("its fields: " + changed.legs + " " + changed.name + " " + changed.barks);

const single = new Alone();
(single as any).__proto__ = Stone.prototype;
tell("alone with Stone.prototype by __proto__", single);
lines.push("typed: " + typedIsAlone(single) + " " + typedIsAlone(alone) + " " + typedIsAlone(stone));
const heavy = new Stone();
Object.setPrototypeOf(heavy, alone);
tell("a stone whose prototype is an instance of Alone", heavy);
const between = Object.create(Dog.prototype);
const far = new Stone();
Object.setPrototypeOf(far, between);
tell("a stone behind an object behind Dog.prototype", far);

lines.push("all: " + countInLoop([animal, dog, puppy, stone, alone, changed, single, heavy, far, null, 5, {}]));

for (const which of handedAbout) lines.push(which.name + " " + (new which("n") instanceof which));

Object.defineProperty(Stone, Symbol.hasInstance, { value: (x: unknown) => typeof x === "number", configurable: true });
tell("a stone, Stone[Symbol.hasInstance] takes numbers", stone);
tell("a number", 7);
delete (Stone as any)[Symbol.hasInstance];
tell("a stone, Symbol.hasInstance deleted", stone);
Object.defineProperty(Animal, Symbol.hasInstance, { value: () => true, configurable: true });
tell("a stone, Animal[Symbol.hasInstance] takes all (Dog and Puppy inherit it)", stone);
console.log(lines.join("\n"));
//// instanceof-where-constructor-functions-and-classes-share-a-prototype-object.js
// `instanceof` where a prototype property was assigned: Object.prototype itself, one object for two constructor functions, the prototype object of a class, and another object after a class below was defined.
function Plain() {}
Plain.prototype = Object.prototype;
function First() { this.a = 1; }
function Second() { this.b = 2; }
const shared = { kind: "shared" };
First.prototype = shared;
Second.prototype = shared;
function Meter() {}
const early = { early: true };
Meter.prototype = early;
class Fine extends Meter {}
Meter.prototype = { late: true };
class Base {}
function Borrower() {}
Borrower.prototype = Base.prototype;
class Derived extends Base {}
function check() {
  const rows = [];
  rows.push(["literal instanceof Plain", {} instanceof Plain]);
  rows.push(["array instanceof Plain", [] instanceof Plain]);
  rows.push(["new First instanceof Second", new First() instanceof Second]);
  rows.push(["new Second instanceof First", new Second() instanceof First]);
  rows.push(["new Fine instanceof Meter", new Fine() instanceof Meter]);
  rows.push(["new Meter instanceof Meter", new Meter() instanceof Meter]);
  rows.push(["new Base instanceof Borrower", new Base() instanceof Borrower]);
  rows.push(["new Derived instanceof Borrower", new Derived() instanceof Borrower]);
  rows.push(["new Borrower instanceof Base", new Borrower() instanceof Base]);
  rows.push(["created instanceof First", Object.create(shared) instanceof First]);
  return rows;
}
for (let round = 0; round < 3; round++) for (const [name, answer] of check()) console.log(round, name, answer);
//// instances-after-prototype-redefined/log.ts
export const log: string[] = [];
//// instances-after-prototype-redefined/made.ts
import { log } from "./log";
class Observed { declare size: number; constructor(size: number) { this.size = size; } }
Object.defineProperty(Observed.prototype, "size", { set(size: number) { log.push("set " + size); }, configurable: true });
export const observed = new Observed(1);

class Later { declare size: number; constructor(size: number) { this.size = size; } }
const later = new Later(2);
export function readLater(): Later { return later; }
export function redefineLater(): void { Object.defineProperty(Later.prototype, "size", { set(size: number) { log.push("set " + size); }, configurable: true }); }
//// instances-after-prototype-redefined/main.ts
// A program defines an accessor or a read-only property on the prototype of a class. A store to `this` in the constructor then runs the setter, or throws: so a top-level constant that holds an object of the class is made where it is declared, not at its first read.
import { log } from "./log";
import { observed, readLater, redefineLater } from "./made";
log.push("loaded");
redefineLater();
console.log(JSON.stringify(observed), JSON.stringify(readLater()), log.join());
let loaded = false;
try {
  const module = await import("./throws");
  loaded = true;
  console.log(JSON.stringify(module.made));
} catch (error) {
  console.log((error as Error).name, loaded ? "when it was read" : "while it was loaded");
}
//// instances-after-prototype-redefined/throws.ts
class Fixed { declare size: number; constructor(size: number) { this.size = size; } }
Object.defineProperty(Fixed.prototype, "size", { value: 5, writable: false, configurable: true });
export const made = new Fixed(1);
//// lazy-class-object-first-access.js
// A class object creates its own properties at first use. Each class here has no parent and has its class object touched first in a different way through an untyped alias, and afterwards the class object must look like any other.
////= attempt-4

////= describe

function look(K) {
  console.log("  " + describe(K));
  console.log("  extensible " + Object.isExtensible(K) + ", s() " + attempt(() => K.s()) + ", g " + attempt(() => K.g) + ", new K().m() " + attempt(() => new K().m()) + ", constructor " + attempt(() => K.prototype.constructor === K) + ", parent " + (Object.getPrototypeOf(K) === Function.prototype));
}

// K has a subclass, L has none.
function check(name, K, S, L, touch) {
  console.log(name + ": " + attempt(() => touch(K)) + ", " + attempt(() => touch(L)));
  look(K);
  console.log("  S.s() " + attempt(() => S.s()) + ", S.g " + attempt(() => S.g) + ", S.x " + attempt(() => S.x) + ", S[0] " + attempt(() => S[0]) + ", S.inherited " + typeof S.inherited + ", chain " + (Object.getPrototypeOf(S) === K) + ", new S().m() " + attempt(() => new S().m()) + ", " + describe(S));
  look(L);
}

class K1 { static s() { return 1; } static get g() { return 2; } static set g(v) {} m() { return 3; } }
class S1 extends K1 {}
class L1 { static s() { return 1; } static get g() { return 2; } static set g(v) {} m() { return 3; } }
class K2 { static s() { return 1; } static get g() { return 2; } static set g(v) {} m() { return 3; } }
class S2 extends K2 {}
class L2 { static s() { return 1; } static get g() { return 2; } static set g(v) {} m() { return 3; } }
class K3 { static s() { return 1; } static get g() { return 2; } static set g(v) {} m() { return 3; } }
class S3 extends K3 {}
class L3 { static s() { return 1; } static get g() { return 2; } static set g(v) {} m() { return 3; } }
class K4 { static s() { return 1; } static get g() { return 2; } static set g(v) {} m() { return 3; } }
class S4 extends K4 {}
class L4 { static s() { return 1; } static get g() { return 2; } static set g(v) {} m() { return 3; } }
class K5 { static s() { return 1; } static get g() { return 2; } static set g(v) {} m() { return 3; } }
class S5 extends K5 {}
class L5 { static s() { return 1; } static get g() { return 2; } static set g(v) {} m() { return 3; } }
class K6 { static s() { return 1; } static get g() { return 2; } static set g(v) {} m() { return 3; } }
