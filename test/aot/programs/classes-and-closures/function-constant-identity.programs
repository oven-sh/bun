//// log-mode-arrows-in-classes.ts
const body: any = JSON.parse('{"n":"wrong","five":5}');
const untyped = (x: unknown) => x as any;
const row = (name: string, f: () => unknown) => { try { console.log(name, String(f())); } catch { console.log(name, "thrown"); } };
class Router {
  routes = new Map<string, (n: number) => string>();
  get(path: string, handler: (n: number) => string): void { this.routes.set(path, handler); }
  run(path: string, from: any): string { return this.routes.get(path)!(from); }
}
class App {
  prefix = "p"; count = 0; router = new Router();
  field = (n: number): string => this.prefix + " field " + n + " " + ++this.count;
  static shared = "S";
  static fixed = (n: number): string => App.shared + " static " + n + " " + (this === App);
  register(): void {
    this.router.get("/method", (n: number) => this.prefix + " method " + n + " " + ++this.count);
    this.router.get("/field", this.field);
    this.router.get("/static", App.fixed);
  }
}
class Base { router = new Router(); constructor(public name: string) {} describe(): string { return "base " + this.name; } }
class Derived extends Base {
  count = 0;
  constructor() { super("derived"); this.router.get("/constructor", (n: number) => this.name + " constructor " + n + " " + ++this.count); }
  register(): void { const described = super.describe(); this.router.get("/super", (n: number) => described + " method " + n + " " + ++this.count); }
}
class Service {
  prefix = "s";
  field = (a: string, b: number): string => this.prefix + " field " + a + b;
  makes() { return (a: string, b: number): string => this.prefix + " made " + a + b; }
}
const app = new App(); app.register();
const derived = new Derived(); derived.register();
for (const path of ["/method", "/field", "/static"]) row(path, () => app.router.run(path, body.n) + " | " + app.router.run(path, body.five));
for (const path of ["/constructor", "/super"]) row(path, () => derived.router.run(path, body.n) + " | " + derived.router.run(path, body.five));
row("field read through any", () => untyped(new Service()).field(body.five, 1));
row("arrow returned by a method", () => untyped(new Service().makes())(body.five, 1));
console.log(app.count, derived.count);
//// many-field-classes-allocated-repeatedly.ts
// A class with more fields than fit in its objects' cells: private and public ones, some left undefined, a dozen arrow functions. Made often enough for every cache to settle,
// then looked at from outside: keys and their order, values, what the arrow functions see.
type Options = { env: object; path: string; handler?: (c: Context) => string };

class Context {
  #request: { url: string };
  #cached: { path: string } | undefined;
  env: object = {};
  #variables: Map<string, unknown> | undefined;
  finalized: boolean = false;
  error: Error | undefined;
  #status: number | undefined;
  #answer: string | undefined;
  #layout: ((text: string) => string) | undefined;
  #handler: ((c: Context) => string) | undefined;
  #headers: Map<string, string> | undefined;
  #path: string | undefined;
  late?: string;

  constructor(request: { url: string }, options?: Options) {
    this.#request = request;
    if (options) {
      this.env = options.env;
      this.#handler = options.handler;
      this.#path = options.path;
    }
  }

  get cached(): { path: string } {
    return (this.#cached ??= { path: this.#path ?? "none" });
  }
  render = (text: string): string => (this.#layout ? this.#layout(text) : text);
  setLayout = (layout: (text: string) => string) => (this.#layout = layout);
  getLayout = () => this.#layout;
  header = (name: string, value: string | undefined): void => {
    const headers = (this.#headers ??= new Map());
    if (value === undefined) headers.delete(name);
    else headers.set(name, value);
  };
  status = (status: number): void => {
    this.#status = status;
  };
  set = (key: string, value: unknown): void => {
    (this.#variables ??= new Map()).set(key, value);
  };
  get = (key: string): unknown => this.#variables?.get(key);
  text = (text: string, status?: number): string => (this.#answer = (status ?? this.#status ?? 200) + " " + text + " " + (this.#headers?.size ?? 0));
  json = (value: unknown, status?: number): string => this.text(JSON.stringify(value), status);
  html = (html: string): string => this.text("<p>" + html + "</p>");
  url = (): string => this.#request.url;
  answer = (): string | undefined => this.#answer;
  notFound = (): string => (this.#handler ? this.#handler(this) : this.text("not found", 404));
}

class Wider extends Context {
  extra: number[] = [];
  #secret = "s";
  more = (n: number): number => this.extra.push(n) + this.#secret.length;
  tail: string | undefined;
}

const request = { url: "http://localhost/hello" };
const env = { name: "env" };
let checksum = 0;
for (let turn = 0; turn < 3000; turn++) {
  const c = turn % 3 === 0 ? new Context(request) : turn % 3 === 1 ? new Context(request, { env, path: "/p" + (turn & 3) }) : new Wider(request, { env, path: "/w", handler: c => c.text("handled", 410) });
  if (turn % 5 === 0) c.header("a", "b");
  if (turn % 7 === 0) c.status(201);
  if (turn % 11 === 0) c.set("k", turn);
  if (turn % 13 === 0) c.late = "late";
  checksum += c.json({ turn }).length + c.notFound().length + c.cached.path.length + Object.keys(c).length + (c.get("k") === turn ? 1 : 0) + (c instanceof Wider ? c.more(turn) : 0);
}
console.log(checksum);

function show(label: string, c: Context) {
  console.log(label, Object.keys(c).join(","));
  console.log(label, JSON.stringify(c), c.finalized, c.error?.message, c.late, typeof c.json, c.url(), c.answer());
}
show("bare", new Context(request));
show("with options", new Context(request, { env, path: "/x" }));
const wide = new Wider(request, { env, path: "/y" });
wide.more(4);
show("wider", wide);

const changed = new Context(request, { env, path: "/z" });
changed.late = "now";
delete (changed as { error?: Error }).error;
changed.error = new Error("again");
show("a key deleted and made again", changed);
(changed as unknown as Record<string, unknown>).added = 1;
changed.finalized = true;
show("a key nobody declared", changed);

const detached = new Context(request, { env, path: "/d" }).json;
console.log(detached([1, 2, 3], 202));

const frozen = new Context(request);
Object.freeze(frozen);
try {
  frozen.late = "no";
} catch (error) {
  console.log((error as Error).constructor.name);
}
show("frozen", frozen);
console.log(Object.getOwnPropertyNames(new Wider(request)).length, Reflect.ownKeys(new Context(request)).length);
for (const key in new Context(request, { env, path: "/k" })) if (key.length < 4) console.log(key);
//// member-names-shared-with-type.ts
// The name of a member of a class is also a string literal in the type of a field, and no expression spells it: the class still has the member under its name.
type Mode = "plain" | "sealedStaticMethod" | "sealedStaticGetter" | "sealedStaticSetter" | "sealedMethod" | "sealedGetter" | "sealedStaticField" | "sealedField";
interface Options {
  mode: Mode;
  limit: number;
}
class Tools {
  static sealedStaticMethod(): number {
    return 1;
  }
  static get sealedStaticGetter(): number {
    return 2;
  }
  static set sealedStaticSetter(value: number) {}
  static sealedStaticField = 3;
  sealedMethod(): number {
    return 4;
  }
  get sealedGetter(): number {
    return 5;
  }
  sealedField = 6;
}
const options: Options = { mode: "plain", limit: 1 };
const longNames = (names: string[]) => names.filter(name => name.length > 9).sort().join();
console.log(options.mode, options.limit);
console.log(longNames(Object.getOwnPropertyNames(Tools)));
console.log(longNames(Object.getOwnPropertyNames(Tools.prototype)));
console.log(longNames(Object.keys(new Tools())));
for (const name of Object.getOwnPropertyNames(Tools)) {
  if (name.length > 9) console.log(name, typeof (Tools as any)[name], typeof Object.getOwnPropertyDescriptor(Tools, name)!.get);
}
const tools: any = new Tools();
for (const name of Object.getOwnPropertyNames(Tools.prototype)) {
  if (name.length > 9) console.log(name, typeof tools[name]);
}
//// members-under-computed-keys-take-the-place-of-what-a-class-has-under-the-name.ts
// A member that the body of a class defines under a computed key takes the place of what the class has under that name from its creation, or of an earlier member. Classes below see it too.
class OnlySetter { set ["constructor"](value: unknown) {} }
class Below extends OnlySetter {}
class Further extends Below {}
class OnlyGetter { get ["constructor"]() { return Array; } }
class BelowGetter extends OnlyGetter {}
class Method { ["constructor"]() { return "called"; } }
class BelowMethod extends Method {}
const key = "constructor";
class ByVariable { get [key]() { return Map; } }
class BelowByVariable extends ByVariable {}

function nameOf(value: unknown): string {
  return typeof value === "function" ? value.name || "(no name)" : String(value);
}
function readTyped(a: OnlySetter, b: Below, c: Further, d: OnlyGetter, e: BelowGetter, f: Method, g: BelowMethod, h: ByVariable, i: BelowByVariable): string {
  return [a.constructor, b.constructor, c.constructor, d.constructor, e.constructor, f.constructor, g.constructor, h.constructor, i.constructor].map(nameOf).join();
}
function readAny(values: any[]): string {
  return values.map(value => nameOf(value.constructor)).join();
}
const make = () => [new OnlySetter(), new Below(), new Further(), new OnlyGetter(), new BelowGetter(), new Method(), new BelowMethod(), new ByVariable(), new BelowByVariable()] as const;

let last = "";
for (let round = 0; round < 20000; round++) {
  const both = readTyped(...make()) + " | " + readAny([...make()]);
  if (both !== last) console.log(round, both);
  last = both;
}
delete (Below.prototype as any).constructor;
delete (BelowGetter.prototype as any).constructor;
delete (BelowMethod.prototype as any).constructor;
delete (BelowByVariable.prototype as any).constructor;
console.log("own ones deleted", readTyped(...make()), "|", readAny([...make()]));
delete (Further.prototype as any).constructor;
console.log("one more", readTyped(...make()), "|", readAny([...make()]));
Object.defineProperty(OnlySetter.prototype, "constructor", { value: Set, configurable: true });
Object.defineProperty(OnlyGetter.prototype, "constructor", { get() { return WeakMap; }, configurable: true });
console.log("defined anew", readTyped(...make()), "|", readAny([...make()]));
console.log(new (new BelowGetter().constructor as any)() instanceof WeakMap, (new BelowMethod() as any).constructor(), Object.getOwnPropertyNames(OnlySetter.prototype).join(), Object.getOwnPropertyNames(Method.prototype).join());
//// method-called-with-another-this.ts
// A method of a class is entered with a `this` that is no object of the class: through call, apply, Reflect.apply, bind, a plain call of the function that was read, another object that borrows it, and a subclass made by text that is evaluated.
class Meter {
  unit: number;
  constructor(unit: number) { this.unit = unit; }
  measure(count: number): number { return this.unit * count; }
  get doubled(): number { return this.unit * 2; }
  describe(): string { return typeof this + ":" + (this === undefined ? "none" : String(this.unit)); }
}

const meter = new Meter(3);
const borrowed = { unit: 5, measure: meter.measure, describe: meter.describe };
const text = { unit: "ab" } as unknown as Meter;
const getter = Object.getOwnPropertyDescriptor(Meter.prototype, "doubled")!.get as (this: unknown) => unknown;
const Heir = new Function("Meter", "return class Heir extends Meter { measure(count) { return super.measure(count) + 1 } }")(Meter) as typeof Meter;
const heir = new Heir(7);

function attempt(run: () => unknown): string {
  try { return String(run()); } catch (error) { return (error as Error).name; }
}

let total = 0;
const seen: string[] = [];
for (let i = 0; i < 3000; i++) {
  total = (total + meter.measure(i % 5) + heir.measure(i % 3)) % 100003;
  if (i % 1000 !== 500) continue;
  const loose = meter.measure, looseDescribe = meter.describe;
  seen.push(
    attempt(() => meter.measure.call({ unit: 11 } as Meter, 2)),
    attempt(() => meter.measure.apply(borrowed as unknown as Meter, [2])),
    attempt(() => Reflect.apply(meter.measure, text, [2])),
    attempt(() => meter.measure.bind(new Meter(13))(2)),
    attempt(() => borrowed.measure(2)),
    attempt(() => borrowed.describe()),
    attempt(() => loose(2)),
    attempt(() => looseDescribe()),
    attempt(() => meter.describe.call(4 as unknown as Meter)),
    attempt(() => meter.describe.call(null as unknown as Meter)),
    attempt(() => getter.call({ unit: 17 })),
    attempt(() => getter.call(undefined)),
    attempt(() => getter.call("text")),
    attempt(() => Meter.prototype.measure(2)),
    attempt(() => Object.create(meter).measure(2)),
  );
}
console.log(total);
console.log(seen.join(" "));
//// method-parameter-stricter-than-interface.ts
// TypeScript compares method parameters bivariantly, so a class method may require more of a parameter than the interface it implements, or the class it extends, declares. A call through the interface can then pass an object that lacks a member the method requires. The program must behave as it does in plain JavaScript.
type Trust = { attested: boolean; decidedByHost: boolean };
type Part = Pick<Trust, "attested">;
const NONE: Trust = { attested: false, decidedByHost: false };
interface Policy {
  name: string;
  check(tool: string, call?: Part): string;
}
function run(p: Policy, attested: boolean): string {
  return p.name + ": " + p.check("ls", { attested }) + " | " + p.check("rm") + " | " + p.check("cp", { attested, decidedByHost: true } as Part);
}

class Implements implements Policy {
  name = "implements";
  check(tool: string, call: Trust = NONE): string {
    return tool + " " + call.attested + " " + call.decidedByHost + " " + ("decidedByHost" in call);
  }
}
class Base {
  name = "base";
  check(tool: string, call?: Part): string {
    return tool + " " + call?.attested;
  }
}
class Overrides extends Base {
  name = "overrides";
  check(tool: string, call: Trust = NONE): string {
    const { attested, decidedByHost = "not decided" } = call as Partial<Trust>;
    return tool + " " + attested + " " + decidedByHost + " " + Object.keys(call).join();
  }
}
////= lines-22	Further	extends	Overrides	name	"further"
class NeverReads implements Policy {
  name = "never reads it";
  check(tool: string, _call: Trust = NONE): string {
    return tool;
  }
}

for (const policy of [new Implements(), new Base(), new Overrides(), new Further(), new NeverReads()]) console.log(run(policy, true));
console.log(new Implements().check("by its class", { attested: true, decidedByHost: false }), new Overrides().check("by its class"));
//// methods-of-constructor-functions-read-as-values.js
// The idiom of libraries from before classes: is the method still the one I know?
////= lines-66	Stream	flowing	false
Stream.prototype.resume = function () {
  this.flowing = true;
  return this;
};
Stream.prototype.pause = function () {
  this.flowing = false;
  return this;
};
function Socket() {
  Stream.call(this);
}
Object.setPrototypeOf(Socket.prototype, Stream.prototype);
Object.setPrototypeOf(Socket, Stream);
////= lines-35	Socket	end	"ended"
const { resume, pause } = Stream.prototype;
const { end } = Socket.prototype;
function isUntouched(socket) {
  return socket.resume === resume && socket.pause === pause && socket.end === end;
}
const lines = [];
let sockets = [new Socket(), new Socket(), new Socket()];
function count(name) {
  let untouched = 0;
  for (let i = 0; i < 6; i++) untouched += isUntouched(sockets[i % 3]) ? 1 : 0;
  lines.push(name + " " + untouched);
}
count("at first");
sockets[1].pause = () => "mine";
count("one object overrides");
delete sockets[1].pause;
count("no longer");
const wrapped = Stream.prototype.resume;
Stream.prototype.resume = function () {
  return wrapped.call(this);
};
count("the library is patched");
Stream.prototype.resume = wrapped;
count("and restored");
////= lines-45	Tls	Socket	end	"tls"
sockets = [new Tls(), new Socket(), new Tls()];
count("a class below overrides");
console.log(lines.join("\n"));
