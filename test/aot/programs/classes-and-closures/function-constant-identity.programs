// Classes as compilers wrote them before there were classes: one function is made the prototype of another, so that the statics are inherited. That is nobody's business but theirs: the arrays of the program keep their storage. (`describe` is the shell's; without it the lines say false.)
const arraysAreSlow = () => typeof describe === "function" && describe([1, 2, 3].concat([4])).includes("SlowPut");
var extend = function (derived, base) {
  Object.setPrototypeOf(derived, base);
  function Between() { this.constructor = derived; }
  derived.prototype = base === null ? Object.create(base) : (Between.prototype = base.prototype, new Between());
};
function Base(name) { this.name = name; }
Base.make = function () { return new this("made"); };
Base.prototype.hello = function () { return "hello " + this.name; };
function Mid(name) { Base.call(this, name); }
function Leaf(name) { Mid.call(this, name); }
console.log("before:", arraysAreSlow());
extend(Leaf, Mid);
console.log("the heir first:", arraysAreSlow(), Object.getPrototypeOf(Leaf) === Mid);
extend(Mid, Base);
console.log("then its parent:", arraysAreSlow(), Object.getPrototypeOf(Mid) === Base, Leaf.make().name, Leaf.make() instanceof Leaf, typeof Leaf.make().hello);
function Other() {}
const heir = Object.create(Other);
Object.setPrototypeOf(Other, Base);
console.log("a function that something inherits from:", arraysAreSlow(), heir.make === Base.make, Other.length, Other.name, Base.length, Base.name, Object.getOwnPropertyNames(Base).sort().join());
const arrow = () => 1, method = { m() {} }.m, bound = Base.bind(null);
Object.setPrototypeOf(Other, arrow); console.log("an arrow function:", arraysAreSlow(), Object.getPrototypeOf(Other) === arrow);
Object.setPrototypeOf(Other, method); console.log("a method:", arraysAreSlow(), Object.getPrototypeOf(Other) === method);
Object.setPrototypeOf(Other, bound); console.log("a bound function:", arraysAreSlow(), Object.getPrototypeOf(Other) === bound);
const list = [1, 2, 3]; list.push(4); list[6] = 7;
console.log(list.join(), list.length, arraysAreSlow());
//// function-reflection-by-kind.js
// What reflection says about one function of each kind: typeof, name, length, source text, the name and length after bind, the class string and `caller`. Each question gets a new function object: first one that was only called, then one that also has an own property.
const kinds = {
  sloppy: () =>
    function sloppy(a, b) {
      return a;
    },
  strict: () =>
    function strict(a, b, c) {
      "use strict";
      return a;
    },
  arrow: () => {
    const arrow = (a, b) => a;
    return arrow;
  },
  method: () =>
    ({
      method(a) {
        return a;
      },
    }).method,
  class: () =>
    class Point {
      constructor(x, y) {
        this.x = x;
      }
    },
  generator: () =>
    function* generator(a) {
      yield a;
    },
  async: () =>
    async function asynchronous(a, b) {
      return a;
    },
  "async generator": () =>
    async function* asyncGenerator(a) {
      yield a;
    },
  bound: () =>
    function target(a, b, c) {
      return a;
    }.bind(null),
  "bound method": () => {
    const holder = {
      method(a, b, c) {
        return a;
      },
    };
    return holder.method.bind(holder);
  },
  "bound arrow": () => {
    const arrow = (a, b, c) => a;
    return arrow.bind(null);
  },
};

const questions = {
  typeof: f => typeof f,
  name: f => f.name,
  length: f => f.length,
  "source text": f => String(f).replace(/\s+/g, " "),
  "name after bind": f => f.bind(null).name,
  "length after bind": f => f.bind(null, 1).length,
  "class string": f => Object.prototype.toString.call(f),
  caller: f => Reflect.get(Function.prototype, "caller", f),
};

const states = {
  "only called": f => {},
  "with an own property": f => {
    f.extra = 1;
  },
};

function answer(question, f) {
  try {
    return String(question(f));
  } catch (error) {
    return error.constructor.name;
  }
}

for (const [kind, create] of Object.entries(kinds)) {
  for (const [state, prepare] of Object.entries(states)) {
    for (const [name, question] of Object.entries(questions)) {
      const f = create();
      if (kind === "class") new f(1, 2);
      else f(1, 2);
      prepare(f);
      console.log(`${kind}, ${state}, ${name}: ${answer(question, f)}`);
    }
  }
}

class B extends Map {}
const describe = map => [map instanceof B, map instanceof Map, Map.prototype.set.call(map, 1, 2) === map].join();
for (let i = 0; i < 2; i++) console.log("new.target is a class:", describe(Reflect.construct(Map, [], B)));
console.log("new.target is a function:", describe(Reflect.construct(Map, [], function () {})));

// Makes this file CommonJS: in an ES module every function is strict.
module.exports = {};
//// function-text-asked-again.js
// A function is asked for its text again and again: as a property key, which is what mime-types 3 does by accident about 2,500 times while it loads (`exports.types[extension]`, where
// `extension` is a function of the module), by String(), in a template and by toString(). Each text is what is written here. 2,000 answers of one function stay alive:
// object-census.test.ts runs it with BUN_JSC_dumpAOTObjectCensusAtExit=1 and counts the strings. The output is that of plain Bun.
function extension(type) {
  if (!type || typeof type !== "string") {
    return false;
  }
  return type.length > 3 ? type.slice(0, 3) : type;
}

const shorter = value => value + 1;

class Shape {
  area() { return 0; }
  static create() { return new Shape(); }
}

async function later() { return "später: ä ö ü"; }

function* counted() { yield 1; }

const types = Object.create(null);
types[extension] = "by the text of a function";
types.json = "application/json";

let found = 0;
for (let i = 0; i < 20000; i++) {
  if (types[extension] !== "application/octet-stream") found++;
  if (types[shorter] === undefined) found++;
}
console.log(found, Object.keys(types).length, Object.keys(types)[0] === extension.toString());

const kept = [];
for (let i = 0; i < 2000; i++) kept.push(extension.toString());
console.log(kept.length, kept.every(text => text === kept[0]), kept[0].length > 100);

// Plain Bun answers with the text that its transpiler printed and an executable with the text as written, so this prints what holds for both.
function show(callable, start, part) {
  const text = callable.toString();
  console.log(start, text.startsWith(start), text.includes(part), String(callable) === text, `${callable}` === text, Function.prototype.toString.call(callable) === text);
}
for (let round = 0; round < 2; round++) {
  show(extension, "function extension(type) {", "type.slice(0, 3)");
  show(shorter, "", "=> value + 1");
  show(Shape, "class Shape {", "static create()");
  show(Shape.prototype.area, "area() {", "return 0");
  show(Shape.create, "create() {", "new Shape");
  show(later, "async function later() {", "ter: ");
  show(counted, "function* counted() {", "yield 1");
  show(show, "function show(callable, start, part) {", "console.log(");
  show(extension.bind(null), "function extension() { [native code] }", "native");
  show(Math.max, "function max() { [native code] }", "native");
  if (typeof Bun !== "undefined") Bun.gc(true);
}
console.log(kept[1999] === extension.toString(), shorter.toString() !== extension.toString(), later.toString() !== counted.toString());
//// function-whose-prototype-is-that-of-a-class.js
class A { constructor() { this.x = 1; } m() { return "A.m"; } }
function Alias() { this.f = 2; }
Alias.prototype = A.prototype;
function show(v) { return v.x + " " + v.f + " " + v.extra + " " + v.m() + " " + Object.keys(v).join() + " " + (v instanceof A) + " " + (v instanceof Alias); }
const a = new A(), alias = new Alias();
alias.extra = 3;
console.log(show(a)); console.log(show(alias));
class Over extends Alias { g = 4; }
const over = new Over();
console.log(show(over), over.g);
//// functions-that-share-one-assigned-prototype.js
// Two constructors with ONE prototype object: an instance of either is an instance of both, and finds the members of that object.
const shared = { m() { return "shared.m"; } };
function F() { this.f = 1; }
function G() { this.g = 2; }
F.prototype = shared;
G.prototype = shared;
function show(v) { return v.f + " " + v.g + " " + v.m() + " " + (v instanceof F) + " " + (v instanceof G); }
console.log(show(new F())); console.log(show(new G()));
function H() { this.h = 3; }
function I() { this.i = 4; }
I.prototype = H.prototype;
H.prototype.n = function () { return "H.n"; };
function look(v) { return v.h + " " + v.i + " " + v.n() + " " + (v instanceof H) + " " + (v instanceof I); }
console.log(look(new H())); console.log(look(new I()));
//// functions-used-as-prototypes.ts
// A function is no prototype until something inherits from it. From then on what is added to it, changed on it or taken from it is seen by
// its heirs, also where a read of the heir has found the name absent many times before.
const lines: string[] = [];
const say = (what: string, value: unknown) => lines.push(what + ": " + String(value));

////= lines-67	declared	1
const arrow = () => 2;
const expression = function () {
  return 3;
};
async function asynchronous() {
  return 4;
}
function* generator() {
  yield 5;
}
const holder = {
  method() {
    return 6;
  },
};
const bound = declared.bind(null);
class Plain {
  static made() {
    return 7;
  }
}
const functions: [string, Function][] = [
  ["declared", declared],
  ["arrow", arrow],
  ["expression", expression],
  ["asynchronous", asynchronous],
  ["generator", generator],
  ["method", holder.method],
  ["bound", bound],
  ["static method", Plain.made],
];

function readMany(heir: any): unknown {
  let last: unknown = "never";
  for (let i = 0; i < 200; i++) last = heir.added;
  return last;
}
function hasMany(heir: any): boolean {
  let last = true;
  for (let i = 0; i < 200; i++) last = "added" in heir;
  return last;
}

for (const [name, f] of functions) {
  const heir = Object.create(f);
  say(name + " absent", readMany(heir));
  say(name + " in", hasMany(heir));
  (f as any).added = name + "!";
  say(name + " added", readMany(heir));
  say(name + " in", hasMany(heir));
  (f as any).added = name + "?";
  say(name + " changed", readMany(heir));
  Object.defineProperty(f, "added", { get: () => name + " by a getter", configurable: true });
  say(name + " getter", readMany(heir));
  delete (f as any).added;
  say(name + " deleted", readMany(heir));
  say(name + " in", hasMany(heir));
  say(name + " name through the heir", heir.name);
  say(name + " length through the heir", heir.length);
  say(name + " is the prototype", Object.getPrototypeOf(heir) === f);
  say(name + " isPrototypeOf", Object.prototype.isPrototypeOf.call(f, heir));
}

function Base(this: any) {
  this.own = 1;
}
function Derived(this: any) {
  this.own = 2;
}
Object.setPrototypeOf(Derived, Base);
function staticOf(constructor: any): unknown {
  let last: unknown;
  for (let i = 0; i < 200; i++) last = constructor.shared;
  return last;
}
say("old style, absent", staticOf(Derived));
(Base as any).shared = "of Base";
say("old style, added", staticOf(Derived));
(Derived as any).shared = "of Derived";
say("old style, shadowed", staticOf(Derived));
delete (Derived as any).shared;
say("old style, uncovered", staticOf(Derived));

const second = () => 8;
const chain = Object.create(Object.create(second));
say("two below, absent", readMany(chain));
(second as any).added = "far";
say("two below, added", readMany(chain));

const late = () => 9;
(late as any).before = "before";
const heirOfLate = Object.create(late);
say("a property from before", heirOfLate.before);
say("calls still", late());
say("own keys", Object.getOwnPropertyNames(late).sort().join());

const stored = () => 10;
const heirOfStored = Object.create(stored);
Object.defineProperty(stored, "guarded", { value: 1, writable: false, configurable: true });
let threw = "no";
try {
  (function () {
    "use strict";
    for (let i = 0; i < 50; i++) heirOfStored.guarded = 2;
  })();
} catch (error) {
  threw = (error as Error).constructor.name;
}
say("a store below a read-only property", threw);
say("nothing was added", Object.getOwnPropertyNames(heirOfStored).length);
Object.defineProperty(stored, "set", {
  set(value: unknown) {
    say("the setter ran with", value);
  },
  configurable: true,
});
heirOfStored.set = 3;
console.log(lines.join("\n"));
//// functions-whose-typed-captures-only-get-values-of-the-type.ts
// A method of a literal and an arrow function that read a typed parameter of the function around them. The compiler tests the captured value at the head of each,
// and nothing but numbers ever arrives, so the version for other values is never entered. The build stopped on the call of that version.
interface Lock {
  [Symbol.dispose](): void;
  id: number;
}

let log = "";

function lock(id: number): Lock {
  return {
    id,
    [Symbol.dispose]() {
      log += "d" + id;
    },
  };
}

{
  using first = lock(1);
  using second = lock(2);
  log += "b" + first.id + second.id;
}
console.log(log);

function show(value: number): string {
  return "<" + value + ">";
}

function addAndShow(offset: number) {
  return (key: string, value: unknown) => (typeof value === "number" ? show(value + offset) : value);
}

console.log(JSON.stringify({ a: 1, b: [2, 3], c: "text" }, addAndShow(10)));
