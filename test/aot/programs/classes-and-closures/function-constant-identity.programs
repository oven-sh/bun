//// has-instance-and-prototype-property-change-under-instanceof.ts
// `value instanceof C` in a loop, while text that is evaluated defines Symbol.hasInstance on the class, on its parent and on Function.prototype's heirs, relinks the class objects and the prototype objects, and makes a stranger an instance.
class Animal { legs = 4; }
class Dog extends Animal { name = "dog"; }
class Cat extends Animal { name = "cat"; }
function Plain(this: { kind: string }) { this.kind = "plain"; }

const run = (text: string, ...values: unknown[]) => new Function("Animal", "Dog", "Cat", "Plain", "values", text)(Animal, Dog, Cat, Plain, values);

function count(values: unknown[], change: () => void): string {
  let animals = 0, dogs = 0, cats = 0, plains = 0;
  for (let i = 0; i < 1200; i++) {
    if (i === 600) change();
    const value = values[i % values.length];
    if (value instanceof Animal) animals++;
    if (value instanceof Dog) dogs++;
    if (value instanceof Cat) cats++;
    if (value instanceof (Plain as unknown as new () => object)) plains++;
  }
  return [animals, dogs, cats, plains].join(" ");
}

const stranger = {};
const values: unknown[] = [new Animal(), new Dog(), new Cat(), new (Plain as unknown as new () => object)(), stranger, null, 5, "text", () => 1];
console.log("before", count(values, () => {}));
console.log("a stranger becomes a dog", count(values, () => { run("Object.setPrototypeOf(values[0], Dog.prototype)", stranger); }));
console.log("a dog becomes a cat", count(values, () => { run("Object.setPrototypeOf(values[0], Cat.prototype)", values[1]); }));
console.log("cats stop being animals", count(values, () => { run("Object.setPrototypeOf(Cat.prototype, Object.prototype)"); }));
console.log("the function gets another prototype object", count(values, () => { run("Plain.prototype = Dog.prototype"); }));
console.log("hasInstance on the parent", count(values, () => { run("Object.defineProperty(Animal, Symbol.hasInstance, { value: value => typeof value === 'number', configurable: true })"); }));
console.log("the class object of Dog leaves its parent", count(values, () => { run("Object.setPrototypeOf(Dog, Function.prototype)"); }));
console.log("hasInstance on Cat itself", count(values, () => { run("Object.defineProperty(Cat, Symbol.hasInstance, { value: () => true })"); }));
console.log("hasInstance is removed from the parent", count(values, () => { run("delete Animal[Symbol.hasInstance]"); }));
console.log("after", count(values, () => {}));
//// hoisted-function-captures.ts
// The closure for a hoisted function declaration is created where its name is first used as a value.
function each<T>(list: T[], f: (x: T) => void) { for (const x of list) f(x); }
function keep<T>(x: T): T { kept.push(x); return x; }
const kept: unknown[] = [];
function neverUsed(n: number) { return helper() + n; function helper() { return n * 2; } }
function usedOnRarePath(n: number, rare: boolean) { let total = 0; if (rare) each([1, 2], add); return total + n; function add(x: number) { total += x; } }
function usedByInner(n: number) { let total = 0; const run = () => each([1, 2, 3], add); run(); run(); return total + n; function add(x: number) { total += x; } }
function observedByInner(n: number) { const a = () => keep(f); return a() === a() && a()() === n; function f() { return n; } }
function recursiveVisitor(depth: number) { let count = 0; visit(depth); return count; function visit(d: number) { count++; if (d > 0) each([d - 1, d - 1], visit); } }
function spreadCall(n: number) { const list: [number, number] = [1, 2]; return add(...list); function add(a: number, b: number) { return a + b + n; } }
function assigned(n: number) { const before = f(); (f as any) = () => n + 100; return before + f(); function f() { return n; } }
function typeOnly(n: number) { const r: ReturnType<typeof helper> = helper(); return r; function helper() { return n + 1; } }
function byTable(list: number[], a: (x: number) => void, b: (x: number) => void) { const table = [a, b]; for (const x of list) table[x & 1](x); }
function twoUsesReadConst(list: number[]) { const seen: number[] = []; byTable(list, add, add); return seen.join(); function add(x: number) { seen.unshift(x); } }
function twoUsesThroughAnother(list: number[]) { const seen: number[] = []; byTable(list, outer, outer); return seen.join(); function outer(x: number) { inner(x); } function inner(x: number) { seen.push(x); } }
function throughConstArrow(list: number[]) { const seen: number[] = []; const add = (x: number) => { seen.push(x); }; byTable(list, g, g); return seen.join(); function g(x: number) { add(x); } }
function throughTwoArrows(list: number[]) { const seen: number[] = []; const add = (x: number) => { seen.push(x); }; const twice = (x: number) => { add(x); add(x); }; byTable(list, g, g); return seen.join(); function g(x: number) { twice(x); } }
function assignedReadsConst() { const base = Number("5"); const before = f(); (f as any) = () => base + 1; return before + f(); function f() { return base; } }
console.log(neverUsed(1), usedOnRarePath(1, false), usedOnRarePath(1, true), usedByInner(1), observedByInner(2), recursiveVisitor(3), spreadCall(1), typeOnly(1));
try { console.log(assigned(1)); } catch (e) { console.log((e as Error).name); }
console.log(twoUsesReadConst([1, 2, 3]), twoUsesThroughAnother([1, 2]), assignedReadsConst(), throughConstArrow([1, 2]), throughTwoArrows([3]));
//// indexed-property-on-plain-function.ts
// A read-only property or an accessor at an index of a function leaves the arrays of the program as they are: nothing inherits from it.
const lines: string[] = [];
const say = (what: string, value: unknown) => lines.push(what + ": " + String(value));
const outcome = (run: () => void) => {
  try {
    run();
    return "stored";
  } catch (error) {
    return (error as Error).constructor.name;
  }
};
function declared() {}
const arrow = () => {};
const bound = declared.bind(null);
class WithStatic {
  static made() {}
}
for (const [name, f] of [
  ["declared", declared],
  ["arrow", arrow],
  ["bound", bound],
  ["static method", WithStatic.made],
] as [string, any][]) {
  Object.defineProperty(f, 0, { value: name, writable: false, configurable: true });
  Object.defineProperty(f, 1, { get: () => name + " by a getter", configurable: true });
  say(name + " store", outcome(() => (f[0] = "no")));
  say(name + " 0", f[0]);
  say(name + " 1", f[1]);
  say(name + " keys", Object.getOwnPropertyNames(f).filter(key => key === "0" || key === "1").join());
}
const numbers: number[] = [];
for (let i = 0; i < 100; i++) numbers.push(i);
numbers[200] = 1;
say("arrays", numbers.length + " " + numbers[3] + " " + numbers[150]);
say("others", [1, , 3][1]);
console.log(lines.join("\n"));
//// inner-function-made-when-a-sibling-hands-it-on.ts
// An inner function that its siblings call is never made as an object. Here siblings also hand it on as a value, and the function that declares it never does:
// the first sibling that hands it on makes the object, and everybody after it gets the same one. Built without inlining, so that the reads stay in the siblings.
////= lines-20	declares
const results = [declares(1, false), declares(2, true), declares(0, false)];
for (const [a, b, c, d, called, calls] of results) console.log(a === b && b === c && c === d, a(3), called, calls);
console.log(results[0][0] === results[1][0], results[1][0] === results[2][0]);

// The object keeps what is put on it, and it outlives the activation together with the scope it reads.
function keepsProperties(seed: number) {
  let total = seed;
  mark();
  return [read(), hand()] as const;

  function counted(step: number) {
    total += step;
    return total;
  }
  function hand() {
    return counted;
  }
  function mark() {
    (hand() as { tag?: string }).tag = "tag" + seed;
  }
  function read() {
    return (hand() as { tag?: string }).tag;
  }
}
const [tag, later] = keepsProperties(10);
console.log(tag, later(1), later(2), (later as { tag?: string }).tag, later.name, later.length);

// An activation in which nobody hands it on makes none, and a collection between two reads changes nothing.
function sometimes(hands: boolean, n: number) {
  let sum = 0;
  for (let i = 0; i < n; i++) sum += step(i);
  if (!hands) return sum;
  const before = pass();
  Bun.gc(true);
  return before === pass() ? sum + before(1) : -1;

  function step(i: number): number {
    return i > 2 ? step(i - 2) + n : i;
  }
  function pass() {
    return step;
  }
}
let all = 0;
for (let i = 0; i < 3000; i++) all += sometimes(i % 1000 === 0, i % 7);
console.log(all);
//// inner-functions-declared-in-branches-and-loops.ts
// Inner functions that are only called are not made as objects: what they capture is read from the scope. Here they are declared in branches, in loops and around other code,
// so the scope is filled at several places, and every turn of a loop has functions of its own that see the values of that turn.
// Built without inlining: a call that is taken into its caller hides what the caller believes about the callee.
function inBranches(flag: boolean, n: number) {
  let total = n;
  if (flag) {
    const bonus = n * 10;
    function inBranch(x: number): number {
      total += x;
      return x > 0 ? inBranch(x - 1) : helper(total + bonus);
    }
    return inBranch(n);
  }
  return helper(n);

  function helper(x: number): number {
    total++;
    return x > 100 ? helper(x - 100) : x + total;
  }
}
console.log(inBranches(true, 3), inBranches(false, 3), inBranches(true, 40), inBranches(false, 250));

function everyTurnHasItsOwn(n: number) {
  let log = "";
  const kept: (() => string)[] = [];
  for (let k = 0; k < n; k++) {
    const c = "c" + k;
    function g(depth: number): string {
      return depth > 0 ? g(depth - 1) : c;
    }
    function h(): string {
      return g(1) + "|";
    }
    kept.push(h);
    log += h();
  }
  return log + kept.map(f => f()).join("");
}
console.log(everyTurnHasItsOwn(4));

// The function to call is found before its arguments are computed. While this one waits for its argument, the loop goes on and declares the functions of the next turns.
async function declaredAgainWhileWaiting() {
  const out: string[] = [];
  let release!: () => void;
  const gate = new Promise<void>(resolve => (release = resolve));
  const waiting: Promise<void>[] = [];
  for (let k = 0; k < 3; k++) {
    const c = "c" + k;
    function g(prefix: string, depth: number): string {
      return depth > 0 ? g(prefix, depth - 1) : prefix + c;
    }
    async function h() {
      out.push(g(await gate.then(() => "p" + k), 1));
    }
    waiting.push(h());
  }
  release();
  await Promise.all(waiting);
  return out.join();
}
console.log(await declaredAgainWhileWaiting());

// A class and a call stand between the declarations' uses, and the call already runs one of the functions.
function aroundOtherCode(seed: number) {
  let steps = 0;
  const early = first(seed);
  class Holder {
    value = second(seed);
    static made = 0;
    constructor() {
      Holder.made++;
    }
  }
  const holder = new Holder();
  return [early, holder.value, Holder.made, third(seed), steps].join();

  function first(x: number): number {
    steps++;
    return x > 2 ? first(x - 2) : second(x);
  }
  function second(x: number): number {
    steps++;
    return x > 5 ? second(x - 5) : x * seed;
  }
  function third(x: number): number {
    steps++;
    return first(x) + second(x);
  }
}
console.log(aroundOtherCode(7), aroundOtherCode(12));

// A generator keeps its scope while it is suspended, and two of them run in turn.
function* counting(from: number) {
  let current = from;
  while (current < from + 3) yield next();

  function next(): number {
    return bump(1);
  }
  function bump(by: number): number {
    current += by;
    return by > 1 ? bump(by - 1) : current * from;
  }
}
const one = counting(1);
const two = counting(10);
console.log([one.next().value, two.next().value, one.next().value, two.next().value, ...one, ...two].join());

let sum = 0;
for (let i = 0; i < 20000; i++) sum += inBranches(i % 3 === 0, i % 11) + everyTurnHasItsOwn(i % 3).length;
console.log(sum);
//// inner-functions-made-only-where-they-are-used.ts
// An inner function that only some paths use is one function object for each call of the outer function, whichever of those paths asks for it and however often.
const lines: string[] = [];
////= say

const seen: Function[] = [];
function keep(callback: Function) {
  seen.push(callback);
  return seen.length;
}

function early(skip: boolean, turns: number): number {
  if (skip) return -1;
  let sum = 0;
  for (let i = 0; i < turns; i++) sum += keep(helper);
  return sum;
  function helper() { return 1; }
}
say("skipped", early(true, 3), seen.length);
say("in a loop", early(false, 3), seen.length, seen[0] === seen[1], seen[1] === seen[2]);
say("another call", early(false, 2), seen.length, seen[3] === seen[4], seen[2] !== seen[3]);

function twoArms(skip: boolean, first: boolean): boolean {
  if (skip) return false;
  let one: Function | undefined;
  if (first) one = helper;
  const other: Function = helper;
  return one === undefined || one === other;
  function helper() { return 2; }
}
say("two arms", twoArms(true, true), twoArms(false, true), twoArms(false, false));

function capturing(skip: boolean, base: number, turns: number): number[] {
  if (skip) return [];
  const results: number[] = [];
  const callbacks: (() => number)[] = [];
  for (let i = 0; i < turns; i++) {
    callbacks.push(next);
    results.push(next());
  }
  results.push(new Set(callbacks).size);
  return results;
  function next() { return ++base; }
}
say("capturing", capturing(true, 1, 1).length, capturing(false, 10, 3).join(), capturing(false, 20, 1).join());

function withProperties(skip: boolean): string {
  if (skip) return "skipped";
  for (let i = 0; i < 3; i++) (tagged as { count?: number }).count = ((tagged as { count?: number }).count ?? 0) + 1;
  return tagged.name + " " + (tagged as { count?: number }).count;
  function tagged() {}
}
say("properties", withProperties(true), withProperties(false), withProperties(false));

function thrown(skip: boolean): string {
  if (skip) return "skipped";
  try {
    for (let i = 0; i < 2; i++) if (i === 1) throw helper;
    return "nothing";
  } catch (error) {
    return String(error === helper) + " " + (error as () => string)();
  }
  function helper() { return "caught"; }
}
say("thrown", thrown(true), thrown(false));

console.log(lines.join("\n"));
//// inner-functions-that-call-each-other-and-variables-that-get-another-function.js
// Inner functions that call each other and capture constants of their maker: made twice, in a loop, in the cases of a switch, in a recursion, in a generator, behind an await, handed to another function. And a variable that holds a function gets another one while a closure that calls through it lives on.
const out = [];
function pair(n) { const k = n * 2; function a(d) { return d ? b(d - 1) + k : k; } function b(d) { return d ? a(d - 1) + n : n; } return [a, b]; }
const [a1, b1] = pair(1), [a2, b2] = pair(10); out.push(a1(3), b1(3), a2(3), b2(3), a1(0), b2(0));
function again(n) { let f = function () { return n; }; const g = () => f() + 1; const first = g(); f = function () { return n * 100; }; return [first, g(), f()]; }
out.push(...again(2), ...again(3));
function inLoop() { const r = []; for (let i = 0; i < 3; i++) { const c = i * 10; function up() { return c + down(); } function down() { return i; } r.push(up, down); } return r.map(f => f()); }
out.push(...inLoop());
function twice(flag) { let h; const base = flag ? 5 : 7; if (flag) h = () => base + 1; else h = () => base + 2; const call = () => h(); const x = call(); h = () => base + 3; return [x, call()]; }
out.push(...twice(true), ...twice(false));
function recursive(n) { const mine = n; function inner() { return mine; } function outer() { return inner() + (n ? recursive(n - 1)() : 0); } return outer; }
out.push(recursive(4)());
function* steps() { for (let i = 0; i < 3; i++) { const v = i + 100; const read = () => v; const both = () => read() + i; yield both; } }
out.push(...[...steps()].map(f => f()));
function inSwitch(k) { switch (k) { case 1: { const z = 11; function one() { return z + two(); } function two() { return k; } return one(); } default: { const z = 22; function one() { return z - two(); } function two() { return k; } return one(); } } }
out.push(inSwitch(1), inSwitch(2));
function late(n) { const use = () => helper() + n; let helper = () => 1; const r1 = use(); { const m = n + 1; helper = () => m; } const r2 = use(); return [r1, r2]; }
out.push(...late(5));
function counter() { let c = 0; const inc = () => ++c; const get = () => c; const both = () => inc() + get(); return [both(), both(), get()]; }
out.push(...counter());
function handed(cb) { return cb(); } function gives(n) { const w = n + 0.5; function leaf() { return w; } function mid() { return handed(leaf) + leaf(); } return mid(); }
out.push(gives(1), gives(2));
async function waits(n) { const q = n * 3; const r = () => q; const s = async () => { await null; return r() + n; }; return (await s()) + (await s()); }
waits(2).then(v => { out.push(v); let t = 0; for (let i = 0; i < 20000; i++) { const [x, y] = pair(i & 7); t += x(2) + y(1); } out.push(t); console.log(out.join(" ")); });
//// inner-functions-that-only-call-each-other.ts
// Functions declared inside a function call each other through the scope they share. Each activation has its own scope, its own parameters and its own outer scope.
function makeCounter(start: number) {
  let total = start;
  return function relate(source: number, target: number, label: string): string {
    let depth = 0;
    let trail = "";
    return isRelated(source, target);

    function isRelated(a: number, b: number): string {
      depth++;
      note("r", a, b);
      if (a === b) return finish(true);
      return a < b ? eachRelated(a + 1, b) : someRelated(a, b + 2);
    }
    function eachRelated(a: number, b: number): string {
      note("e", a, b);
      return isRelated(a > 3 ? pick(a, b) : a, b);
    }
    function someRelated(a: number, b: number): string {
      note("s", a, b);
      return depth > 12 ? finish(false) : isRelated(a, b);
    }
    function pick(a: number, b: number) {
      return a > b ? b : a;
    }
    function note(kind: string, a: number, b: number) {
      trail += kind + a + ":" + b + " ";
      total++;
    }
