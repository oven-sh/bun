  let v13_4 = text + 4;
  let v13_5 = seed + 5;
  let v13_6 = text + 6;
  let v13_7 = seed + 7;
  let v13_8 = text + 8;
  let v13_9 = seed + 9;
  let v13_10 = text + 10;
  let v13_11 = seed + 11;
  let v13_12 = text + 12;
  return { read: () => [v13_0, v13_1, v13_2, v13_3, v13_4, v13_5, v13_6, v13_7, v13_8, v13_9, v13_10, v13_11, v13_12].join(","), bump: () => { v13_0 += "!"; v13_1 += 1; v13_2 += "!"; v13_3 += 1; v13_4 += "!"; v13_5 += 1; v13_6 += "!"; v13_7 += 1; v13_8 += "!"; v13_9 += 1; v13_10 += "!"; v13_11 += 1; v13_12 += "!"; } };
}
