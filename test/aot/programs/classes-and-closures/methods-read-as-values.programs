// A function that answers with a closure over its own scope has done with the scope when it returns, and the caller has not: the next call gets a scope of its own.
function choose(kind: boolean) {
  let note = "";
  if (kind) note = "set; ";
  return (x: string) => note + x;
}
const chosen = [choose(true), choose(false), choose(true), choose(false)];
console.log(chosen.map(f => f("x")).join("|"));

// One of two closures over the same scope.
function eitherWay(kind: boolean, tag: string) {
  let note = tag;
  if (kind) note += "!";
  return kind ? (x: string) => note + x : (x: string) => x + note;
}
const either = [eitherWay(true, "a"), eitherWay(false, "b"), eitherWay(true, "c"), eitherWay(false, "d")];
console.log(either.map(f => f("-")).join("|"));

// A fresh object whose members share the scope.
function counter(start: number) {
  let count = start;
  if (start > 5) count -= 5;
  return { next: () => ++count, peek: () => count };
}
const counters = [counter(1), counter(10), counter(3)];
for (const c of counters) c.next();
counters[1].next();
console.log(counters.map(c => c.peek()).join());

// The function calls itself before it answers, so that it is never taken into its caller, and every activation's scope is alive at once.
function chain(depth: number, tag: string): (x: string) => string {
  let mine = tag + depth;
  if (depth % 2) mine += "o";
  const below = depth > 0 ? chain(depth - 1, tag) : (x: string) => x;
  return (x: string) => below(x + "," + mine);
}
console.log(chain(3, "a")(""), chain(2, "b")(""));
const chains = [chain(1, "p"), chain(1, "q"), chain(0, "r")];
console.log(chains.map(f => f("")).join("|"));

// A scope inside a scope: the closure keeps both.
function outer(a: number) {
  let total = a;
  if (a > 1) total *= 2;
  function inner(b: number) {
    let own = b;
    if (b > 1) own += total;
    return () => own + total++;
  }
  return [inner(1), inner(2)] as const;
}
const pairs = [outer(1), outer(2), outer(3)];
console.log(pairs.map(([p, q]) => [p(), q(), p()].join()).join("|"));

// The closure leaves by a throw, by a finally, through a generator and through a promise.
function thrown(tag: string): never {
  let note = tag;
  if (tag.length > 1) note += "+";
  throw () => note;
}
function caught(tag: string): () => string {
  try {
    thrown(tag);
  } catch (error) {
    return error as () => string;
  }
}
console.log([caught("t"), caught("uu"), caught("v")].map(f => f()).join());
function behindFinally(tag: string, log: string[]) {
  let note = tag;
  try {
    if (tag === "b") note += "?";
    return () => note;
  } finally {
    log.push(note);
    note += ".";
  }
}
const finallyLog: string[] = [];
console.log([behindFinally("a", finallyLog), behindFinally("b", finallyLog), behindFinally("c", finallyLog)].map(f => f()).join(), finallyLog.join());
function* yielded(n: number) {
  for (let i = 0; i < n; i++) {
    let seen = i;
    if (i % 2) seen += 10;
    yield () => seen++;
  }
}
const fromGenerator = [...yielded(4)];
console.log(fromGenerator.map(f => f() + f()).join());
async function awaited(tag: string) {
  let note = tag;
  await null;
  if (tag === "y") note += "~";
  return () => note;
}

// An inner function answers with a closure over the scope of the function that declares it. That function has the scope only through the closure from there on, and calls itself while it does.
function owner(tag: string, depth: number): string {
  let note = tag;
  if (depth > 2) note += "+";
  function make() {
    return (x: string) => note + x;
  }
  const made = make();
  const below = depth > 0 ? owner(tag + depth, depth - 1) : "";
  return made("<") + below;
}
console.log(owner("o", 4), owner("p", 1));

// The same where the closure keeps two scopes: the inner function's own, which that function makes, and the outer function's, which it is handed and hands back.
function ownerOfTwo(tag: string, depth: number): string {
  let note = tag;
  if (depth > 2) note += "+";
  function make(extra: string) {
    let own = extra;
    if (extra.length > 1) own += "~";
    return (x: string) => note + own + x;
  }
  const made = make(depth % 2 ? "e" : "ee");
  const below = depth > 0 ? ownerOfTwo(tag + depth, depth - 1) : "";
  return made("<") + below;
}
console.log(ownerOfTwo("o", 4), ownerOfTwo("p", 1));
function ownerOfTwoInALoop(tag: string, rounds: number): string {
  let note = tag;
  if (rounds > 2) note += "+";
  function make(extra: number) {
    let own = extra;
    if (extra % 2) own += 100;
    return (x: string) => note + own + x;
  }
  let all = "";
  let last = make(-1);
  for (let i = 0; i < rounds; i++) {
    const made = make(i);
    all += last("(") + made(")");
    last = made;
  }
  return all;
}
console.log(ownerOfTwoInALoop("q", 4), ownerOfTwoInALoop("r", 2));

// A generator, an async function and an async generator declared inside: what the call answers with keeps the scope, and nothing of the body has run yet, or only its start.
function startsGenerator(tag: string) {
  let note = tag;
  if (tag.length > 1) note += "+";
  function* inner() {
    yield note;
    note += ".";
    yield note;
  }
  return inner();
}
const generators = [startsGenerator("a"), startsGenerator("bb"), startsGenerator("c")];
console.log(generators.map(g => [...g].join()).join("|"));
function startsAsync(tag: string) {
  let note = tag;
  if (tag.length > 1) note += "+";
  async function inner() {
    await null;
    note += ".";
    await null;
    return note;
  }
  return inner();
}
function startsAsyncGenerator(tag: string) {
  let note = tag;
  if (tag.length > 1) note += "+";
  async function* inner() {
    yield note;
    await null;
    note += ".";
    yield note;
  }
  return inner();
}
async function drain(generator: AsyncGenerator<string>) {
  let all = "";
  for await (const value of generator) all += value + ";";
  return all;
}

// Many calls whose closures are all kept, then read, with collections in between if the run asks for them.
const kept: ((x: string) => string)[] = [];
for (let i = 0; i < 3000; i++) kept.push(i % 3 ? choose(i % 2 === 0) : eitherWay(i % 2 === 0, "" + i));
let length = 0;
let wrong = 0;
for (let i = 0; i < kept.length; i++) {
  const answer = kept[i]("x");
  const expected = i % 3 ? (i % 2 === 0 ? "set; x" : "x") : i % 2 === 0 ? i + "!x" : "x" + i;
  if (answer !== expected) wrong++;
  length += answer.length;
}
console.log(length, wrong);
Promise.all([awaited("x"), awaited("y"), awaited("z")]).then(all => console.log(all.map(f => f()).join()));
Promise.all([startsAsync("k"), startsAsync("ll"), startsAsync("m")]).then(all => console.log(all.join()));
Promise.all([startsAsyncGenerator("r"), startsAsyncGenerator("ss"), startsAsyncGenerator("t")].map(drain)).then(all => console.log(all.join("|")));
//// scopes-kept-by-everything-that-can-keep-one.js
// Every call below makes a scope, and something that the call answers with, or leaves behind, keeps it. All answers are collected first and read afterwards,
// so a scope whose cell the next call took would show the next call's variables.
const lines = [];
function collect(name, make, read) {
  const kept = [];
  for (let i = 0; i < 6; i++) kept.push(make("v" + i, i));
  lines.push(name + ": " + kept.map(read).join(" "));
}

collect("getter and setter", function (tag, n) {
  let note = tag;
  if (n % 2) note += "'";
  return { get value() { return note; }, set value(next) { note = next + note; } };
}, o => { o.value = "<"; return o.value; });

collect("method of a literal", function (tag, n) {
  let note = tag;
  if (n % 2) note += "'";
  return { read() { return note; }, bump() { note += "+"; return this; } };
}, o => o.bump().read());

collect("class declared inside", function (tag, n) {
  let note = tag;
  if (n % 2) note += "'";
  return class { static read() { return note; } read() { return note + "i"; } field = note + "f"; };
}, C => C.read() + new C().read() + new C().field);

collect("instance of a class declared inside", function (tag, n) {
  let count = n;
  class Counter { #own = tag; next() { return this.#own + ++count; } }
  return new Counter();
}, c => c.next() + c.next());

collect("default of a parameter", function (tag, n, read = () => tag + n) {
  var tag = tag + "!";
  if (n % 2) tag += "'";
  return [read, () => tag];
}, ([a, b]) => a() + b());

collect("mapped arguments", function (tag, n) {
  const all = arguments;
  if (n % 2) tag += "'";
  return [all, () => tag, next => { tag = next; }];
}, ([all, read, write]) => { const before = all[0]; write("w" + before); return before + read() + all[0]; });

collect("direct eval", function (tag, n) {
  let note = tag;
  if (n % 2) note += "'";
  return eval("() => note + n");
}, f => f());

collect("catch parameter", function (tag, n) {
  try {
    throw tag + (n % 2 ? "'" : "");
  } catch (error) {
    let twice = error + error;
    return () => error + "/" + twice;
  }
}, f => f());

collect("switch scope", function (tag, n) {
  switch (n % 3) {
    case 0: { let a = tag + "a"; return () => a; }
    case 1: { let b = tag + "b"; if (n > 2) b += "'"; return () => b; }
    default: { let c = tag + "c"; return () => c + c; }
  }
}, f => f());

collect("one scope a turn of a loop", function (tag, n) {
  const all = [];
  outer: for (let i = 0; i < 4; i++) {
    let seen = tag + i;
    for (let j = 0; j < 3; j++) {
      let both = seen + j;
      if (j === n % 3) { all.push(() => both); continue outer; }
      if (i === 3) break outer;
    }
  }
  return all;
}, all => all.map(f => f()).join(""));

collect("bound function", function (tag, n) {
  let note = tag;
  if (n % 2) note += "'";
  function read(prefix, suffix) { return prefix + note + suffix + (this ? this.x : ""); }
  return read.bind({ x: n }, "[");
}, f => f("]"));

collect("kept by a Map, a Set, a WeakMap and an array", function (tag, n) {
  let note = tag;
  if (n % 2) note += "'";
  const key = {};
  return [new Map([["k", () => note]]), new Set([() => note + "s"]), new WeakMap([[key, () => note + "w"]]), key];
}, ([map, set, weak, key]) => map.get("k")() + [...set][0]() + weak.get(key)());

collect("symbol members and an iterator", function (tag, n) {
  let left = 2;
  return { [Symbol.iterator]() { return { next: () => (left-- > 0 ? { value: tag + left, done: false } : { value: undefined, done: true }) }; }, [Symbol.toPrimitive]: () => tag + n };
}, o => [...o].join("") + `${o}`);

collect("proxy handler", function (tag, n) {
  let reads = n;
  return new Proxy({}, { get: (target, name) => tag + String(name) + ++reads });
}, p => p.a + p.b);

collect("scope inside a scope inside a scope", function (tag, n) {
  let a = tag;
  return (function middle(m) {
    let b = a + m;
    if (m % 2) b += "'";
    return (function inner(k) {
      let c = b + k;
      return () => a + "," + b + "," + c;
    })(m + 1);
  })(n);
}, f => f());

collect("closure that answers with a closure", function (tag, n) {
  let a = tag;
  if (n % 2) a += "'";
  return () => { let b = a + "2"; a += "."; return () => a + b; };
}, f => { const g = f(), h = f(); return g() + h(); });

const listeners = [];
collect("left behind in a list outside", function (tag, n) {
  let note = tag;
  if (n % 2) note += "'";
  listeners.push(() => note);
  return listeners.length - 1;
}, index => listeners[index]());

collect("thrown out through two frames", function (tag, n) {
  function deep(k) {
    let note = tag + k;
    if (k === 0) throw { read: () => note, tag };
    try { deep(k - 1); } finally { note += "x"; }
  }
  try { deep(n % 3); } catch (thrown) { return thrown; }
}, t => t.read() + t.tag);

collect("recursion that keeps one closure a level", function keep(tag, n) {
  let note = tag + n;
  const below = n > 0 ? keep(tag, n - 1) : [];
  below.push(() => note);
  return below;
}, all => all.map(f => f()).join(""));

collect("tagged template and spread", function (tag, n) {
  let note = tag;
  const build = (strings, ...values) => () => strings.join(note) + values.join(note);
  return build`a${n}b${n + 1}c`;
}, f => f());

const timers = [];
for (let i = 0; i < 4; i++) {
  (function (tag, n) {
    let note = tag;
    if (n % 2) note += "'";
    timers.push(new Promise(resolve => setTimeout(() => resolve(note), 0)));
    queueMicrotask(() => { note += "m"; });
  })("t" + i, i);
}
console.log(lines.join("\n"));
Promise.all(timers).then(all => console.log("timers and microtasks: " + all.join(" ")));
//// scopes-of-closures-that-are-only-called.ts
// A function answers with a closure over a scope of its own, and the caller only calls the closure and drops it: the caller is then the last to have the scope.
// Beside each such caller stands one that keeps the closure now and then, hands it on, or has two of them at once.
function make(start: number) {
  let count = start;
  if (start > 100) count -= 100;
  return (step: number) => (count += step);
}
function onlyCalls(start: number) {
  const next = make(start);
  return next(1) + next(2);
}
function twoAtOnce(a: number, b: number) {
  const first = make(a);
  const second = make(b);
  return [first(1), second(1), first(1), second(10), first(100)].join();
}
const keptNowAndThen: ((step: number) => number)[] = [];
function keepsNowAndThen(rounds: number) {
  let sum = 0;
  for (let i = 0; i < rounds; i++) {
    const next = make(i);
    sum += next(1);
    if (i % 7 === 0) keptNowAndThen.push(next);
    sum += next(1);
  }
  return sum;
}
function answersWithItSometimes(start: number, hand: boolean) {
  const next = make(start);
  next(5);
  return hand ? next : null;
}
function holder(next: (step: number) => number, into: unknown[]): number {
  into.push(next);
  return into.length > 1000 ? holder(next, []) : into.length;
}
function handsItToAKeeper(start: number, into: unknown[]) {
  const next = make(start);
  next(3);
  return holder(next, into);
}
function borrower(next: (step: number) => number, times: number): number {
  return times > 0 ? next(1) + borrower(next, times - 1) : 0;
}
function handsItToABorrower(start: number) {
  const next = make(start);
  return borrower(next, 3) + next(0);
}
function callsItselfInBetween(depth: number): string {
  const next = make(depth * 10);
  next(1);
  const below = depth > 0 ? callsItselfInBetween(depth - 1) : "";
  return next(1) + ";" + below;
}
function handsItToNativeCode(start: number) {
  const next = make(start);
  return [1, 2, 3].map(next).join();
}
function throwsInBetween(start: number) {
  const next = make(start);
  try {
    if (next(1) % 2) throw next;
    return "even " + next(0);
  } catch (thrown) {
    return "odd " + (thrown as typeof next)(0);
  }
}
// The maker is itself only a link: it answers with what another maker answered.
function makeThrough(start: number) {
  return start % 2 ? make(start) : make(start + 1000);
}
function onlyCallsThrough(start: number) {
  const next = makeThrough(start);
  return next(1) + next(1);
}
// An object of closures in place of one closure.
function makePair(start: number) {
  let count = start;
  if (start > 100) count -= 100;
  return { up: () => ++count, down: () => --count };
}
function onlyCallsPair(start: number) {
  const pair = makePair(start);
  return pair.up() + pair.up() + pair.down();
}
const keptPairs: { up: () => number; down: () => number }[] = [];
function keepsOneMember(start: number) {
  const pair = makePair(start);
  pair.up();
  keptPairs.push({ up: pair.up, down: makePair(start + 1).down });
  return pair.down();
}

const out: unknown[] = [];
for (let i = 0; i < 5; i++) out.push(onlyCalls(i * 3));
out.push(twoAtOnce(1, 50), twoAtOnce(200, 7));
out.push(keepsNowAndThen(50), keptNowAndThen.map(f => f(0)).join());
const handed = [answersWithItSometimes(1, true), answersWithItSometimes(2, false), answersWithItSometimes(3, true), answersWithItSometimes(4, true)];
out.push(handed.map(f => (f ? f(0) : "-")).join());
const keeper: ((step: number) => number)[] = [];
for (let i = 0; i < 4; i++) out.push(handsItToAKeeper(i * 2, keeper));
out.push(keeper.map(f => f(0)).join());
for (let i = 0; i < 3; i++) out.push(handsItToABorrower(i * 5));
out.push(callsItselfInBetween(4), handsItToNativeCode(3), handsItToNativeCode(9));
for (let i = 0; i < 4; i++) out.push(throwsInBetween(i));
for (let i = 0; i < 4; i++) out.push(onlyCallsThrough(i));
for (let i = 0; i < 3; i++) out.push(onlyCallsPair(i * 4), keepsOneMember(i * 4));
out.push(keptPairs.map(p => p.up() + "/" + p.down()).join());
console.log(out.join(" | "));
let total = 0;
for (let i = 0; i < 20000; i++) total += onlyCalls(i) + onlyCallsPair(i) + onlyCallsThrough(i) + handsItToABorrower(i);
console.log(total, keptNowAndThen.map(f => f(0)).join(), keeper.map(f => f(0)).join(), keptPairs.map(p => p.up()).join());
//// scopes-whose-cells-are-used-again.ts
// The cell that holds the variables of a call is used again by the next call, unless somebody has kept a function that sees those variables.
// Built without inlining, so that the inner functions stay calls and the scope stays a cell.
type Kept = () => string;
const keptFunctions: Kept[] = [];

function work(n: number, keeps: boolean): number {
  let sum = 0;
  let label = "w" + n;
  add(n);
  if (keeps) keep();
  add(1);
  return sum;

  function add(k: number): void {
    sum += k > 2 ? (add(k - 2), 2) : k;
  }
  function keep(): void {
    keptFunctions.push(() => label + ":" + sum);
  }
}
let total = 0;
for (let i = 0; i < 5000; i++) total += work(i % 9, i % 1000 === 7);
console.log(total, keptFunctions.map(f => f()).join());

// A call inside a call: the outer scope is still in use while the inner calls come and go.
function nested(depth: number, tag: string): string {
  let text = tag;
  append("<");
  if (depth > 0) append(nested(depth - 1, tag + depth));
  if (depth > 1) append(nested(depth - 2, tag + "x"));
  append(">");
  return text;

  function append(part: string): void {
    text += part.length > 40 ? (append(part.slice(0, 3)), "~") : part;
  }
}
console.log(nested(4, "n"));

// The function throws out of the middle, and the next call starts from fresh variables.
function mayThrow(n: number): number {
  let seen = 0;
  let list: number[] | undefined;
  step(n);
  return seen + (list ? list.length : 0);

  function step(k: number): void {
    seen++;
    if (k === 3) throw new Error("three after " + seen);
    if (k > 0) step(k - 2);
    else list = [k];
  }
}
const outcomes: string[] = [];
for (let i = 0; i < 8; i++) {
  try {
    outcomes.push(String(mayThrow(i)));
  } catch (error) {
    outcomes.push((error as Error).message);
  }
}
console.log(outcomes.join());

// A variable that this call never assigns must not show what the last call left in the cell.
function leavesSomeUnset(sets: boolean): string {
  let maybe: string | undefined;
  let count = 0;
  if (sets) assign();
  bump();
  return String(maybe) + count;

  function assign(): void {
    maybe = "set" + (count > 5 ? (bump(), "") : "");
  }
  function bump(): void {
    count += count > 100 ? (bump(), 0) : 1;
  }
}
console.log(leavesSomeUnset(true), leavesSomeUnset(false), leavesSomeUnset(true), leavesSomeUnset(false));

// Kept by a generator, by an async function that is waiting, and by a function that is kept only now and then; with collections in between.
function* yields(n: number) {
  let at = n;
  while (at < n + 2) yield next();
  function next(): number {
    return (at += at > 1000 ? (next(), 0) : 1);
  }
}
async function waits(n: number): Promise<number> {
  let acc = n;
  grow();
  await null;
  grow();
  return acc;
  function grow(): void {
    acc += acc > 1000 ? (grow(), 0) : 10;
  }
}
const generators = [yields(1), yields(10), yields(100)];
const firsts = generators.map(g => g.next().value);
const promises = [waits(1), waits(2), waits(3)];
for (let i = 0; i < 300; i++) {
  work(i % 5, false);
  if (i % 100 === 0) Bun.gc(true);
}
console.log(firsts.join(), generators.map(g => g.next().value).join(), (await Promise.all(promises)).join(), keptFunctions.map(f => f()).join());
//// small-method-results.ts
// What a small method hands back is compared, added to, tested and stored right where the method is called: the way hand-written parsers read their input.
class Reader {
    pos = 0;
    constructor(readonly text: string) {}
    peek(): number { return this.text.charCodeAt(this.pos); }
    peekAt(offset: number): number { return this.text.charCodeAt(this.pos + offset); }
    atEnd(): boolean { return this.pos >= this.text.length; }
    rest(): string { return this.text.slice(this.pos); }
    current(): string | undefined { return this.atEnd() ? undefined : this.text[this.pos]; }
    half(): number { return this.pos / 2; }
    self(): Reader { return this; }
    words(): string[] { return this.rest().split(" "); }

    countSpaces(): number {
        let spaces = 0;
        for (this.pos = 0; !this.atEnd(); this.pos++) if (this.peek() === 32) spaces++;
        return spaces;
    }
    countDigits(): number {
        let digits = 0;
        for (this.pos = 0; !this.atEnd(); this.pos++) if (this.peek() >= 48 && this.peek() <= 57) digits++;
        return digits;
    }
    sum(): number {
        let sum = 0;
        for (this.pos = 0; !this.atEnd(); this.pos++) sum += this.peek() + 1;
        return sum;
    }
    number(): number {
        let value = 0;
        while (!this.atEnd() && this.peek() >= 48 && this.peek() <= 57) value = value * 10 + (this.peek() - 48), this.pos++;
        return value;
    }
    pastTheEnd(): string {
        this.pos = this.text.length;
        return [this.peek() === 32, this.peek() !== 32, this.peek() < 32, this.peek() >= 32, this.peek() === this.peek(), Number.isNaN(this.peek() + 1), this.peek() ? "truthy" : "falsy", this.peek() | 0].join();
    }
    halves(): string {
        const seen: unknown[] = [];
        for (this.pos = 0; this.pos < 5; this.pos++) seen.push(this.half() === 1, this.half() < 1.5, this.half() + 0.5, this.half() ? 1 : 0, this.half() | 0);
        return seen.join();
    }
    strings(): string {
        this.pos = this.text.length - 3;
        const seen: unknown[] = [this.rest() === "4 5", this.rest() + "!", this.rest().length, this.rest() < "5", this.rest() ? "some" : "none", typeof this.rest()];
        this.pos = this.text.length;
        seen.push(this.rest() === "", this.rest() ? "some" : "none", this.current() === undefined, this.current() ?? "nothing", typeof this.current());
        this.pos = 0;
        seen.push(this.current() === "a", this.current() + "?", this.current() ? "some" : "none");
        return seen.join();
    }
    objects(): string {
        this.pos = 2;
        return [this.self() === this, this.self().pos, this.self().self().peek(), this.words().length, this.words()[0], this.self() ? "object" : "nothing"].join();
    }
}

class Shouting extends Reader {
    peek(): number { return super.peek() & ~32; }
    rest(): string { return super.rest().toUpperCase(); }
}

class Shifted extends Reader {
    peek(): number { return super.peek() + 0.5; }
    atEnd(): boolean { return this.pos + 1 >= this.text.length; }
}

function describe(label: string, reader: Reader) {
    console.log(label, reader.countSpaces(), reader.countDigits(), reader.sum(), reader.pastTheEnd(), reader.halves());
    console.log(label, reader.strings(), reader.objects());
    reader.pos = reader.text.indexOf("1");
    console.log(label, reader.number(), reader.pos);
}

const text = "a bc  def 123 4 5";
describe("reader", new Reader(text));
describe("shouting", new Shouting(text));
describe("shifted", new Shifted(text));
const readers: Reader[] = [new Reader(text), new Shouting("x y"), new Shifted("1 2 3"), new Reader("")];
let total = 0;
for (let round = 0; round < 1000; round++) for (const reader of readers) total += reader.countSpaces() * 3 + reader.countDigits() + (reader.sum() & 7);
console.log("in turn", total);
//// stack-traces-use-display-name.js
// A stack trace names a function by its `displayName` if that is a string that is not empty, as in plain Bun. A `name` that was redefined comes first.
function names(stack, ...candidates) {
  return candidates.filter(candidate => stack.includes(candidate)).join() || "neither";
}

function storedTo() { return new Error("x").stack; }
storedTo.displayName = "ShownForStore";
console.log(names(storedTo(), "storedTo", "ShownForStore"));

const arrowStoredTo = () => new Error("x").stack;
arrowStoredTo.displayName = "ShownForArrow";
console.log(names(arrowStoredTo(), "arrowStoredTo", "ShownForArrow"));

function definedOn() { return new Error("x").stack; }
Object.defineProperty(definedOn, "displayName", { value: "ShownForDefinition" });
console.log(names(definedOn(), "definedOn", "ShownForDefinition"));

function renamedFirst() { return new Error("x").stack; }
Object.defineProperty(renamedFirst, "name", { value: "RenamedOne" });
renamedFirst.displayName = "HiddenOne";
console.log(names(renamedFirst(), "renamedFirst", "RenamedOne", "HiddenOne"));

function renamedLast() { return new Error("x").stack; }
renamedLast.displayName = "HiddenTwo";
Object.defineProperty(renamedLast, "name", { value: "RenamedTwo" });
console.log(names(renamedLast(), "renamedLast", "RenamedTwo", "HiddenTwo"));

function givenNumber() { return new Error("x").stack; }
givenNumber.displayName = 12345;
console.log(names(givenNumber(), "givenNumber", "12345"));

function givenNothing() { return new Error("x").stack; }
givenNothing.displayName = "";
console.log(names(givenNothing(), "givenNothing"));

function storedToTwice() { return new Error("x").stack; }
storedToTwice.displayName = "FirstShown";
console.log(names(storedToTwice(), "storedToTwice", "FirstShown", "SecondShown"));
storedToTwice.displayName = "SecondShown";
console.log(names(storedToTwice(), "storedToTwice", "FirstShown", "SecondShown"));
storedToTwice.displayName = undefined;
console.log(names(storedToTwice(), "storedToTwice", "FirstShown", "SecondShown"));

function deletedFrom() { return new Error("x").stack; }
deletedFrom.displayName = "ShownUntilDeleted";
console.log(names(deletedFrom(), "deletedFrom", "ShownUntilDeleted"));
delete deletedFrom.displayName;
console.log(names(deletedFrom(), "deletedFrom", "ShownUntilDeleted"));

function withGetter() { return new Error("x").stack; }
Object.defineProperty(withGetter, "displayName", { get() { return "NeverAsked"; } });
console.log(names(withGetter(), "withGetter", "NeverAsked"));

function Constructed() { this.stack = new Error("x").stack; }
Constructed.displayName = "ShownForConstructor";
console.log(names(new Constructed().stack, "Constructed", "ShownForConstructor"));

class AssignedClass { constructor() { this.stack = new Error("x").stack; } }
AssignedClass.displayName = "ShownForClass";
console.log(names(new AssignedClass().stack, "AssignedClass", "ShownForClass"));

class StaticField { static displayName = "ShownForFieldOfClass"; constructor() { this.stack = new Error("x").stack; } }
console.log(names(new StaticField().stack, "StaticField", "ShownForFieldOfClass"));

const holder = { heldMethod() { return new Error("x").stack; } };
holder.heldMethod.displayName = "ShownForMethod";
console.log(names(holder.heldMethod(), "heldMethod", "ShownForMethod"));

const key = "displayName";
function storedToByKey() { return new Error("x").stack; }
storedToByKey[key] = "ShownForKey";
console.log(names(storedToByKey(), "storedToByKey", "ShownForKey"));

function assignedTo() { return new Error("x").stack; }
Object.assign(assignedTo, { displayName: "ShownForAssign" });
console.log(names(assignedTo(), "assignedTo", "ShownForAssign"));

function reflectedOn() { return new Error("x").stack; }
Reflect.set(reflectedOn, "displayName", "ShownForReflect");
console.log(names(reflectedOn(), "reflectedOn", "ShownForReflect"));

function inheritedFrom() { return new Error("x").stack; }
const heir = Object.create(inheritedFrom);
heir.displayName = "OnlyOnTheHeir";
console.log(names(inheritedFrom(), "inheritedFrom", "OnlyOnTheHeir"));

function outerCaller() { return innerCallee(); }
function innerCallee() { return new Error("x").stack; }
outerCaller.displayName = "ShownOuter";
innerCallee.displayName = "ShownInner";
console.log(names(outerCaller(), "outerCaller", "innerCallee", "ShownOuter", "ShownInner"));

async function awaiting() { const before = new Error("x").stack; await null; return before + new Error("x").stack; }
awaiting.displayName = "HiddenForAsync";
console.log(names(await awaiting(), "awaiting", "HiddenForAsync"));

async function renamedAwaiting() { const before = new Error("x").stack; await null; return before + new Error("x").stack; }
Object.defineProperty(renamedAwaiting, "name", { value: "HiddenNameForAsync" });
console.log(names(await renamedAwaiting(), "renamedAwaiting", "HiddenNameForAsync"));

function* yielding() { yield new Error("x").stack; }
yielding.displayName = "HiddenForGenerator";
console.log(names(yielding().next().value, "yielding", "HiddenForGenerator"));

function* renamedYielding() { yield new Error("x").stack; }
Object.defineProperty(renamedYielding, "name", { value: "HiddenNameForGenerator" });
console.log(names(renamedYielding().next().value, "renamedYielding", "HiddenNameForGenerator"));

function untouched() { return new Error("x").stack; }
console.log(names(untouched(), "untouched"), storedTo.name, storedTo.displayName, Object.keys(storedTo).join());
//// static-after-closure.ts
// Static class fields that are initialized after a closure has captured the class.
class C {
  static label = "a!";
  static n = 0;
  static next(): number { return ++C.n; }
}
console.log(C.label, C.n, C.next(), C.next(), Object.keys(C).join(), "label" in C, (C as any).label);
//// static-field-attribute-changes.js
// Sloppy code (CommonJS). A static field is frozen, sealed, made read-only, hidden from enumeration, turned into an accessor or deleted through an alias, between stores and reads that are resolved from the class declaration. A sloppy store that fails does nothing, a strict one throws. The limit in the .json file gives each side of a class one member guard, so every change runs on a class whose only static member is guarded (N) and on a class with two static members, one of which takes the generic path (W).
var sums;
var setterCalls = 0;

function run(use, change) {
  sums = { steps: 0, n: 0, w: 0, b: 0, s: 0 };
  var outcome = "finished";
  try {
    use(change);
  } catch (error) {
    outcome = error instanceof TypeError ? "TypeError" : "another error";
  }
  return outcome + ": " + Object.entries(sums).map(function (entry) { return entry[0] + " " + entry[1]; }).join(", ");
}

function attempt(store) {
  try {
    store(9);
    return "stored";
  } catch (error) {
    return error instanceof TypeError ? "TypeError" : "another error";
  }
}

function describe(target) {
  var descriptor = Object.getOwnPropertyDescriptor(target, "f");
  if (!descriptor) return "absent";
  var kind = "value" in descriptor ? String(descriptor.value) : (descriptor.get ? "get" : "") + (descriptor.set ? "set" : "");
  return kind + ":" + (descriptor.writable ? "w" : "-") + (descriptor.enumerable ? "e" : "-") + (descriptor.configurable ? "c" : "-");
}

function doNothing() {}

function check(title, use, strict, getTargets, change) {
  function changeThroughAlias() {
    for (var alias of [{}, function () {}].concat(getTargets())) change(alias);
  }
  console.log(title);
  console.log("  before " + run(use, doNothing));
  console.log("  during " + run(use, changeThroughAlias));
  console.log("  after " + run(use, doNothing));
  console.log("  strict stores " + attempt(strict.storeN) + ", " + attempt(strict.storeW));
  console.log("  " + getTargets().map(describe).join(", "));
}

class N1 { static f = 4; }
class W1 { static f = 4; static s() { return 3; } }
class B1 extends W1 {}
class Strict1 { static storeN(value) { N1.f = value; } static storeW(value) { W1.f = value; } }
////= lines-4	use1	N1	W1	B1
check("the class is frozen", use1, Strict1, function () { return [N1, W1]; }, function (alias) { Object.freeze(alias); });

class N2 { static f = 4; }
class W2 { static f = 4; static s() { return 3; } }
class B2 extends W2 {}
class Strict2 { static storeN(value) { N2.f = value; } static storeW(value) { W2.f = value; } }
////= lines-4	use2	N2	W2	B2
check("the class is sealed", use2, Strict2, function () { return [N2, W2]; }, function (alias) { Object.seal(alias); });

class N3 { static f = 4; }
class W3 { static f = 4; static s() { return 3; } }
class B3 extends W3 {}
class Strict3 { static storeN(value) { N3.f = value; } static storeW(value) { W3.f = value; } }
////= lines-4	use3	N3	W3	B3
check("f becomes read-only", use3, Strict3, function () { return [N3, W3]; }, function (alias) { Object.defineProperty(alias, "f", { value: 7, writable: false }); });

class N4 { static f = 4; }
class W4 { static f = 4; static s() { return 3; } }
class B4 extends W4 {}
class Strict4 { static storeN(value) { N4.f = value; } static storeW(value) { W4.f = value; } }
////= lines-4	use4	N4	W4	B4
check("f is hidden from enumeration", use4, Strict4, function () { return [N4, W4]; }, function (alias) { Object.defineProperty(alias, "f", { enumerable: false }); });

