  this.target = new.target === Size ? "Size" : typeof new.target;
}
Size.prototype.describe = function () {
  return "Size " + this.width + " " + this.target;
};
function Replaced(value) {
  this.ignored = value;
  return { describe: () => "Replaced " + value };
}
