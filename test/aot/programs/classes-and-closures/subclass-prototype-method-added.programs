}
function small(i: number) { const maker = () => () => i + 5; return readOne(maker); }
function smaller(i: number) { return small(i) + small(i + 1); }
function pastedIntoALoop(n: number) {
  const seen: number[] = [];
  for (let i = 0; i < n; i++) seen.push(small(i), smaller(i));
