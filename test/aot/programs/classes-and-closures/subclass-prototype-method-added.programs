//// this-store-inherited-accessor.js
// A store to `this` under a name that a base class declares as an accessor runs the accessor and adds no own property. A field declared under that name hides the accessor.
const events = [];

class Root {
  set stored(value) {
    events.push("set stored " + value);
  }
}

class Base extends Root {
  #both = 0;
  get computed() {
    return "computed";
  }
  get both() {
    return this.#both;
  }
  set both(value) {
    events.push("set both " + value);
    this.#both = value * 2;
  }
  method() {
    return "method";
  }
}

class Derived extends Base {
  constructor(value) {
    super();
    this.stored = value;
    this.both = value;
    this.method = value;
    this.own = value;
    try {
      this.computed = value;
    } catch (error) {
      events.push("computed: " + (error instanceof TypeError));
    }
  }
}

////= lines-22	Declared	extends	Base	stored	"declared"

////= lines-39	Leaf	Declared	stored	"stored"

function show(object) {
  return Object.keys(object).join(",") + " | " + object.stored + " " + object.both + " " + object.computed + " " + typeof object.method;
}

for (let i = 1; i <= 3; i++) console.log(show(new Derived(i)));
console.log(show(new Declared()));
console.log(show(new Leaf()));
console.log(events.join("\n"));
//// this-store-inherited-accessor-typed.ts
// A store to `this` under a name that a base class declares as an accessor runs the accessor and adds no own property, in a typed class as in untyped code.
const events: string[] = [];

class Root {
  set stored(value: number) {
    events.push("set stored " + value);
  }
}

class Base extends Root {
  #both = 0;
  get computed(): string {
    return "computed";
  }
  get both(): number {
    return this.#both;
  }
  set both(value: number) {
    events.push("set both " + value);
    this.#both = value * 2;
  }
}

class Derived extends Base {
  constructor(value: number) {
    super();
    this.stored = value;
    this.both = value;
    (this as any).own = value;
    try {
      (this as any).computed = value;
    } catch (error) {
      events.push("computed: " + (error instanceof TypeError));
    }
  }
}

function show(object: Base): string {
  return Object.keys(object).join(",") + " | " + object.stored + " " + object.both + " " + object.computed;
}

for (let i = 1; i <= 3; i++) console.log(show(new Derived(i)));
console.log(events.join("\n"));
//// typed-base-constructor-for-other-new-targets.ts
// A typed base constructor runs for its own class, a subclass, an unrelated class, a function and Object as new.target: what it allocates is what new.target selects.
class A {
  x: number = 1;
  y: string;
  constructor(y: string) {
    this.y = y;
    this.init();
  }
  init(): void {
    this.x += 1;
  }
  sum(): string {
    return this.x + this.y;
  }
}
class B extends A {
  z: number = 3;
  init(): void {
    this.x += 10;
  }
}
class Stranger {
  q: number = 5;
  init(): void {
    (this as any).x = 100;
  }
  sum(): string {
    return "stranger";
  }
}
function show(v: any): string {
  return `${v.x} ${v.y} ${v.z} ${v.q} ${typeof v.sum === "function" ? v.sum() : "none"} ${v instanceof A} ${v instanceof B} ${v instanceof Stranger} ${Object.keys(v).join()}`;
}
function make(run: () => any): any {
  try {
    return run();
  } catch (error) {
    return { x: (error as Error).name };
  }
}
const made: any[] = [
  make(() => new A("a")),
  make(() => new B("b")),
  make(() => Reflect.construct(A, ["c"], B)),
  make(() => Reflect.construct(A, ["d"], Stranger)),
  make(() => Reflect.construct(B, ["e"], A)),
  make(() => Reflect.construct(B, ["f"], Stranger)),
  make(() => Reflect.construct(A, ["g"], function () {})),
  make(() => Reflect.construct(A, ["h"], Object)),
];
for (const v of made) console.log(show(v));
function typed(a: A): string {
  return a.sum() + a.x;
}
for (const v of made) {
  try {
    console.log(typed(v));
  } catch (error) {
    console.log((error as Error).name);
  }
}
let total = 0;
for (let i = 0; i < 30000; i++) {
  const v = Reflect.construct(A, ["l"], i % 3 ? B : Stranger) as A;
  total += v.x;
  if (i % 10000 === 0) console.log(show(v));
}
console.log(total);
//// typed-classes-constructed-untyped.ts
const lines: string[] = [];
function show(value: unknown): string { return JSON.stringify(value, (_, v) => (v === undefined ? "undefined" : typeof v === "function" ? "function " + v.name : v)); }
function attempt(name: string, run: () => unknown): void {
    let said: string;
    try { said = show(run()); } catch (e) { said = "THROWS " + (e as Error).constructor.name + ": " + (e as Error).message; }
    lines.push(name + " | " + said);
}
function hide(value: unknown): any { return value; }
const noted: string[] = [];
class Plain { a: unknown; b: unknown; constructor(a?: unknown, b?: unknown) { this.a = a; this.b = b; } sum(): string { return String(this.a) + String(this.b); } }
class Empty { }
class WithFields { x = 1; y = "s"; z: number[] = []; }
class WithOptional { x?: number; constructor(x?: number) { if (x !== undefined) this.x = x; } }
class WithNumbers { i: number; d: number; constructor(i = 1, d = 1.5) { this.i = i; this.d = d; } }
class Derived extends Plain { c: unknown; constructor(a?: unknown, b?: unknown, c?: unknown) { super(a, b); this.c = c; } }
class DerivedWithout extends Plain { }
class DerivedWithFields extends Plain { extra = "e"; }
class Deep extends Derived { d = 4; }
class ReadsTarget { name: string; constructor() { this.name = new.target.name; } }
class DerivedOfReadsTarget extends ReadsTarget { }
class Returns { v = 1; constructor(other?: object) { if (other) return other as Returns; } }
class Throws { v = 1; constructor(a?: unknown) { if (a === "throw") throw new RangeError("from the constructor"); } }
class WithRest { all: unknown[]; constructor(...all: unknown[]) { this.all = all; } }
class WithPrivate { #p: number; constructor(p = 3) { this.#p = p; } get p(): number { return this.#p; } }
class WithAccessor { _v = 0; get v(): number { return this._v; } set v(x: number) { noted.push("set"); this._v = x; } constructor(x = 2) { this.v = x; } }
class WithStatic { static made = 0; id: number; constructor() { this.id = ++WithStatic.made; } }
abstract class Abstract { kind = "abstract"; }
class OfAbstract extends Abstract { more = 1; }
class Generic<T> { held: T; constructor(held: T) { this.held = held; } }
class OfError extends Error { code: number; constructor(message?: string, code = 7) { super(message); this.code = code; } }
class OfArray extends Array<number> { tag = "t"; }
class OfMap extends Map<string, number> { tag = "m"; }
function Old(this: { a: unknown; n: number }, a?: unknown) { this.a = a; this.n = arguments.length; }
const classes: [string, any][] = [["Plain", Plain], ["Empty", Empty], ["WithFields", WithFields], ["WithOptional", WithOptional], ["WithNumbers", WithNumbers], ["Derived", Derived], ["DerivedWithout", DerivedWithout], ["DerivedWithFields", DerivedWithFields], ["Deep", Deep],
    ["ReadsTarget", ReadsTarget], ["DerivedOfReadsTarget", DerivedOfReadsTarget], ["Returns", Returns], ["Throws", Throws], ["WithRest", WithRest], ["WithPrivate", WithPrivate], ["WithAccessor", WithAccessor], ["WithStatic", WithStatic], ["Abstract", Abstract], ["OfAbstract", OfAbstract],
    ["Generic", Generic], ["OfError", OfError], ["OfArray", OfArray], ["OfMap", OfMap], ["Old", Old]];
function look(o: any): unknown { return [Object.getPrototypeOf(o)?.constructor?.name, { ...o }, Object.keys(o), o instanceof Plain, typeof o.sum === "function" ? o.sum() : 0, o.p, o.v, o.message, o.length, o.size]; }
const ways: [string, (C: any, list: unknown[]) => unknown][] = [
    ["none", C => new C()], ["one", (C, l) => new C(l[0])], ["two", (C, l) => new C(l[0], l[1])], ["three", (C, l) => new C(l[0], l[1], l[2])], ["nine", (C, l) => new C(l[0], l[1], l[2], 4, 5, 6, 7, 8, 9)], ["spread", (C, l) => new C(...l)],
    ["Reflect.construct", (C, l) => Reflect.construct(C, l)], ["bound", (C, l) => new (C.bind(null, l[0]))(l[1])], ["in a loop", (C, l) => { let last: unknown; for (let i = 0; i < 3; i++) last = new C(l[0], i); return last; }],
    ["through a typed parameter", (C, l) => ((K: new (...args: any[]) => object) => new K(l[0], l[1]))(C)], ["by its own constructor property", (C, l) => new (new C(l[0]).constructor)(l[0])],
];
const lists: unknown[][] = [[1, 2, 3], ["a", undefined, null], [1.5, { o: 1 }, [1]], []];
const numbers: unknown[][] = [[1, 2, 3], [4.5, 5, 6], [undefined, 7.25], []];
const texts: unknown[][] = [["m", 3], [undefined, 4], ["n"], []];
const objects: unknown[][] = [[{ v: 5 }], [undefined], [{ v: 6, w: 1 }], []];
for (const [name, C] of classes)
    for (const [way, run] of ways)
        for (let i = 0; i < lists.length; i++)
            attempt(name + " | " + way + " | " + i, () => { noted.length = 0; const made = look(run(hide(C), name === "OfMap" || name === "OfArray" ? [] : /^With(Optional|Numbers|Private|Accessor)$/.test(name) ? numbers[i] : name === "OfError" ? texts[i] : name === "Returns" ? objects[i] : lists[i])); return noted.length ? [made, noted.slice()] : made; });
attempt("another new.target of the family", () => { const o: any = Reflect.construct(hide(Plain), [1, 2], Derived); return [Object.getPrototypeOf(o) === Derived.prototype, o.a, o.b, o.c, o instanceof Derived]; });
attempt("the constructor throws", () => new (hide(Throws))("throw"));
attempt("the constructor returns another object", () => { const other = { v: 2 }; return [new (hide(Returns))(other) === other, look(new (hide(Returns))())]; });
attempt("called without new", () => hide(Plain)(1));
attempt("an untyped class extends a typed one", () => { const U = hide(class extends (hide(Plain) as typeof Plain) { constructor(...args: any[]) { super(...(args as [unknown, unknown])); } }); return look(new U(1, 2)); });
attempt("methods see the fields", () => { let text = ""; for (const C of [Plain, Derived, DerivedWithout, Deep]) text += (new (hide(C))("x", "y") as Plain).sum(); return text; });
attempt("many classes at one site", () => { let n = 0; const all = classes.filter(([name]) => !/^Of|Throws|Abstract/.test(name)).map(([, C]) => C); for (let i = 0; i < 600; i++) n += Object.keys(new all[i % all.length]()).length; return n; });
attempt("objects are apart", () => { const a: any = new (hide(WithFields))(), b: any = new (hide(WithFields))(); a.z.push(1); a.x = 9; return [a, b]; });
console.log(lines.join("\n"));
//// untyped-class-below-a-class-of-the-library.mjs
import { AsyncResource } from "node:async_hooks";
import { EventEmitter } from "node:events";

class Mine extends AsyncResource {
  extra = 1;
  constructor() {
    super("mine");
  }
}

class Heard extends EventEmitter {
  extra = 1;
  constructor() {
    super();
    this.more = 2;
  }
  total() {
    return this.extra + this.more + this.listenerCount("x");
  }
}

let sum = 0;
for (let i = 0; i < 300; i++) {
  const mine = new Mine();
  sum += typeof mine.triggerAsyncId() === "number" ? mine.extra : 100;
  const heard = new Heard();
  heard.on("x", () => {});
  sum += heard.total();
}
console.log(sum, new Mine() instanceof AsyncResource, new Heard() instanceof EventEmitter, Object.keys(new Mine()).join(), Object.keys(new Heard()).join());
//// untyped-static-field-store.ts
// Untyped code stores a value of another type in a typed static field. A typed read then throws a TypeError in compiled code, and plain Bun returns the value: neither crashes.
class Counter {
  static count: number = 1;
  static label: string = "first";
}

////= lines-70	readCount	number	Counter.count
////= lines-70	readLabel	string	Counter.label
function readCountOrError(): boolean {
  try {
    return typeof readCount() === "string";
  } catch (error) {
    return error instanceof TypeError;
  }
}

let total = 0;
for (let round = 0; round < 3; round++) {
  Counter.count = round;
  total += readCount();
}
console.log(total, readLabel());

(Counter as any).count = "x";
console.log(readCountOrError(), (Counter as any).count);

Counter.count = 5;
console.log(readCount());

Counter.label = "second";
(Counter as any).label = undefined;
console.log(readLabel());
//// variables-assigned-only-before-capture.ts
// A variable whose last assignment comes before any closure that refers to it is created can be copied into the closure. These are such variables, and the look-alikes where a closure must still see a later assignment.
const out: string[] = [];
function say(name: string, ...values: unknown[]): void {
  out.push(name + ": " + values.map(String).join(" "));
}
function hold<T>(value: T): T {
  return [value][0];
}

function defaulted(options?: { depth: number }) {
  options = options || { depth: 1 };
  return hold(() => options!.depth);
}
function chosen(flag: boolean) {
  let picked: string;
  if (flag) picked = "yes";
  else picked = "no";
  return hold(() => picked);
}
function accumulated(parts: string[]) {
  let text = "";
  for (const part of parts) text += part;
  return hold(() => text);
}
function counted(n: number) {
  let i = 0;
  while (i < n) i++;
  return hold(() => i);
}
function destructured(pair: [number, number]) {
  let a = 0, b = 0;
  [a, b] = pair;
  ({ a, b } = { a: a + 1, b: b + 1 });
  return hold(() => a * 10 + b);
}
function inATry() {
  let state = "start";
  try {
    state = "tried";
    throw new Error("x");
  } catch {
    state += " caught";
  } finally {
    state += " done";
  }
  return hold(() => state);
}
function perIteration() {
  const made: (() => number)[] = [];
  for (let i = 0; i < 3; i++) {
    let doubled = i;
    doubled *= 2;
    made.push(() => doubled);
  }
  return made.map(f => f());
}
function loopVariableStoredToInTheBody() {
  const made: (() => number)[] = [];
  for (let i = 0; i < 6; i++) {
    i++;
    made.push(() => i);
  }
  return made.map(f => f());
}

function storedToAfterwards() {
  let n = 1;
  n = 2;
  const read = hold(() => n);
  n = 3;
  return read;
}
function storedToInTheSameLoop() {
  const made: (() => number)[] = [];
  let n = 0;
  for (let i = 0; i < 3; i++) {
    n += 10;
    made.push(() => n);
  }
  return made.map(f => f());
}
function storedToInAnOuterLoop() {
  const made: (() => number)[] = [];
  let n = 0;
  for (let i = 0; i < 2; i++) {
    n += 10;
    for (let k = 0; k < 2; k++) made.push(() => n + k);
  }
  return made.map(f => f());
}
function madeInTheValueStored() {
  let f: () => unknown = () => "first";
  f = hold(() => f);
  return f() === f;
}
function madeInTheSameStatement() {
  let n = 1;
  const pair = [hold(() => n), (n = 2)] as const;
  return pair[0];
}
function storedToByAClosure() {
  let n = 1;
  n = 2;
  const write = hold(() => (n = 5));
  const read = hold(() => n);
  write();
  return read;
}
function hoistedAndCalledEarly() {
  let n = 1;
  const early = make();
  n = 2;
  function make() {
    return hold(() => n);
  }
  return [early(), make()()];
}
function hoistedAndCalledLate() {
  let n = 1;
  n = 2;
  function make() {
    return hold(() => n);
  }
  return [make()(), hold(make)()()];
}
function inAParameterDefault(n: number, read = () => n) {
  n = n + 1;
  return read;
}
function withALabel() {
  const made: (() => number)[] = [];
  let n = 0;
  outer: for (;;) {
    n++;
    for (;;) {
      made.push(() => n);
      if (n < 3) continue outer;
      break outer;
    }
  }
  return made.map(f => f());
}
function doWhile() {
  const made: (() => number)[] = [];
  let n = 0;
  do {
    made.push(() => n);
    n++;
  } while (n < 3);
  return made.map(f => f());
}
function inAFinally() {
  let n = 0;
  let read: () => number = () => -1;
  try {
    read = hold(() => n);
  } finally {
    n = 7;
  }
  return read;
}
function* resumed() {
  let n = 0;
  n = 1;
  const read = hold(() => n);
  yield read();
  yield read();
}
async function acrossAnAwait() {
  let n = 0;
  n = await Promise.resolve(4);
  const read = hold(() => n);
  await null;
  return read();
}
class Holder {
  read: () => number;
  constructor(n: number) {
    n = n * 2;
    this.read = () => n;
  }
}
function classAfterStores() {
  let base = 1;
  base += 1;
  class Local {
    value() {
      return base;
    }
  }
  return new Local().value();
}

function storedToInAParameterDefault(n: number, stored = (n = 5), read = () => n) {
  return [stored, read()];
}
function storedToInTheBodyAfterTwoDefaults(n: number, first = () => n, second = () => n + 1) {
  n += 10;
  return [first(), second()];
}
function inASwitch(which: number) {
  let n = 0;
  let read: () => number = () => -1;
  switch (which) {
    default:
      read = hold(() => n);
    case 1:
      n = 4;
  }
  return read();
}
function afterASwitch(which: number) {
  let n = 0;
  switch (which) {
    case 0:
      n = 1;
      break;
    default:
      n = 2;
  }
  return hold(() => n);
}
function loopHeadStoresToIt() {
  let n = 0;
  for (n of [1, 2, 3]);
  let key = "";
  for (key in { a: 1, b: 2 });
  return hold(() => key + n);
}
function compoundStores() {
  let a: number | undefined;
  let b = 0;
  let c: number | null = null;
  a ??= 3;
  b ||= 4;
  c ??= 5;
  b++;
  --a;
  return hold(() => [a, b, c].join());
}
function aGetterMadeEarly() {
  let n = 1;
  const holder = {
    get value() {
      return n;
    },
  };
  n = 2;
  return holder.value;
}
function aFieldInitializerOfAClassMadeEarly() {
  let n = 1;
  class Local {
    value = n;
  }
  n = 2;
  return new Local().value;
}
function hoistedAndHandedOverEarly() {
  let n = 1;
  const early = hold(read);
  n = 2;
  function read() {
    return n;
  }
  return [early(), read()];
}
function aDefaultOfAnInnerFunction() {
  let n = 1;
  n = 2;
  function inner(read = () => n) {
    return read();
  }
  return inner();
}
function storedToInANestedBlockOfTheLoop() {
  const made: (() => number)[] = [];
  let n = 0;
  for (let i = 0; i < 3; i++) {
    made.push(() => n);
    if (i > 0) {
      n = i;
    }
  }
  return made.map(f => f());
}
function declaredInTheLoopStoredToBeforeTheClosure() {
  const made: (() => string)[] = [];
  for (const word of ["a", "b"]) {
    let text = word;
    for (let i = 0; i < 2; i++) text += i;
    made.push(() => text);
  }
  return made.map(f => f());
}

say("defaulted", defaulted()(), defaulted({ depth: 4 })());
say("chosen", chosen(true)(), chosen(false)());
say("accumulated", accumulated(["a", "b", "c"])());
say("counted", counted(5)());
say("destructured", destructured([3, 4])());
say("in a try", inATry()());
say("per iteration", ...perIteration());
say("loop variable stored to in the body", ...loopVariableStoredToInTheBody());
say("stored to afterwards", storedToAfterwards()());
say("stored to in the same loop", ...storedToInTheSameLoop());
say("stored to in an outer loop", ...storedToInAnOuterLoop());
say("made in the value stored", madeInTheValueStored());
say("made in the same statement", madeInTheSameStatement()());
say("stored to by a closure", storedToByAClosure()());
say("hoisted and called early", ...hoistedAndCalledEarly());
say("hoisted and called late", ...hoistedAndCalledLate());
say("in a parameter default", inAParameterDefault(1)());
say("with a label", ...withALabel());
say("do while", ...doWhile());
say("in a finally", inAFinally()());
say("resumed", ...resumed());
say("across an await", await acrossAnAwait());
say("constructor parameter", new Holder(4).read());
say("class after stores", classAfterStores());
say("stored to in a parameter default", ...storedToInAParameterDefault(1));
say("stored to in the body after two defaults", ...storedToInTheBodyAfterTwoDefaults(1));
say("in a switch", inASwitch(0), inASwitch(1));
say("after a switch", afterASwitch(0)(), afterASwitch(1)());
say("a loop head stores to it", loopHeadStoresToIt()());
say("compound stores", compoundStores()());
say("a getter made early", aGetterMadeEarly());
say("a field initializer of a class made early", aFieldInitializerOfAClassMadeEarly());
say("hoisted and handed over early", ...hoistedAndHandedOverEarly());
say("a default of an inner function", aDefaultOfAnInnerFunction());
say("stored to in a nested block of the loop", ...storedToInANestedBlockOfTheLoop());
say("declared in the loop, stored to before the closure", ...declaredInTheLoopStoredToBeforeTheClosure());
console.log(out.join("\n"));
//// variables-of-enclosing-functions-read-and-written-in-loops.ts
// A loop reads and writes variables that live outside its function: in an enclosing function or in the module.
// Whatever else can see such a variable (a callee, a getter, valueOf, a handler, a generator's caller) has to find what the loop stored last,
// and the loop has to find what they stored.
const lines: string[] = [];
function say(name: string, ...values: unknown[]): void {
    lines.push(name + ": " + values.map(value => (Object.is(value, -0) ? "-0" : typeof value === "bigint" ? value + "n" : typeof value === "string" ? JSON.stringify(value) : String(value))).join(" "));
}
const opaque = new Function("value", "return value") as <T>(value: T) => T;

function makeScanner(initial: string) {
    let text: string = initial;
    let pos: number = 0;
    let end: number = text.length;
    let resets = 0;
    function isLetter(code: number): boolean { return code >= 97 && code <= 122; }
    function word(): number { const start = pos; while (pos < end && isLetter(text.charCodeAt(pos))) pos++; return pos - start; }
    function gap(): number { const start = pos; while (pos < end && !isLetter(text.charCodeAt(pos))) pos++; return pos - start; }
    function wordWithRareReset(limit: number): number {
        let turns = 0;
        while (pos < end && isLetter(text.charCodeAt(pos))) {
            pos++;
            if (++turns === limit) reset();
        }
        return turns;
    }
    function reset(): void { resets++; pos = end - 2; }
    function wordThatThrowsAt(stop: number): number {
        while (pos < end) {
            if (pos === stop) throw new RangeError("stopped");
            pos++;
        }
        return pos;
    }
    function shrinkingEnd(): number { let turns = 0; while (pos < end) { pos++; end--; turns++; } return turns; }
    function replaceTextInLoop(other: string): string {
        let seen = "";
        while (pos < end) {
            seen += text[pos];
            if (pos === 1) { text = other; end = other.length; }
            pos++;
        }
        return seen;
    }
    return {
        word, gap, wordWithRareReset, wordThatThrowsAt, shrinkingEnd, replaceTextInLoop,
        set(p: number): void { pos = p; },
        setAny(p: any): void { pos = p; },
        setEndAny(e: any): void { end = e; },
        setTextAny(t: any): void { text = t; },
        state(): string { return String(pos) + "|" + String(end) + "|" + String(text) + "|" + resets; },
    };
}

{
    const scanner = makeScanner("alpha  beta gamma");
    say("words", scanner.word(), scanner.gap(), scanner.word(), scanner.gap(), scanner.word(), scanner.gap(), scanner.state());
    scanner.set(0);
    say("rare reset", scanner.wordWithRareReset(3), scanner.state());
    scanner.set(0);
    try { scanner.wordThatThrowsAt(7); } catch (error) { say("thrown", (error as Error).message, scanner.state()); }
    scanner.set(2);
    say("shrinking end", scanner.shrinkingEnd(), scanner.state());
    const replaced = makeScanner("abcdef");
    say("text replaced", replaced.replaceTextInLoop("uvwxyz0123"), replaced.state());
}

for (const start of [0.5, -0, NaN, 2147483640, -2147483650, 9007199254740990, Infinity, "3", null, undefined, true, 2n, { valueOf() { return 4; } }]) {
    const scanner = makeScanner("abcdefgh ijk");
    scanner.setAny(opaque(start));
    let result: unknown;
    try { result = scanner.word(); } catch (error) { result = (error as Error).name; }
    say("odd start", start === null || typeof start !== "object" ? start : "object", result, scanner.state());
}
for (const limit of [3.5, -0, NaN, 2147483648, "5", null, undefined, 6n, { valueOf() { return 2; } }]) {
    const scanner = makeScanner("abcdefgh ijk");
    scanner.setEndAny(opaque(limit));
    let result: unknown;
    try { result = scanner.word(); } catch (error) { result = (error as Error).name; }
    say("odd end", limit === null || typeof limit !== "object" ? limit : "object", result, scanner.state());
}
for (const odd of [null, undefined, 12345, ["a", "b"], { charCodeAt() { return 100; }, toString() { return "object"; } }]) {
    const scanner = makeScanner("abcdefgh ijk");
    scanner.setTextAny(opaque(odd));
    let result: unknown;
    try { result = scanner.word(); } catch (error) { result = (error as Error).name; }
    say("odd text", result, scanner.state());
}

function overflowing() {
    let counter: number = 2147483640;
    let sum = 0;
    function run(turns: number): void { for (let i = 0; i < turns; i++) { counter++; sum += counter % 7; } }
    function down(turns: number): void { for (let i = 0; i < turns; i++) { counter -= 3; sum += counter % 5; } }
    return { run, down, read: () => counter + "|" + sum, put(value: number): void { counter = value; } };
}
{
    const numbers = overflowing();
    numbers.run(20); say("past 2^31", numbers.read());
    numbers.put(-2147483640); numbers.down(10); say("below -2^31", numbers.read());
    numbers.put(9007199254740985); numbers.run(12); say("past 2^53", numbers.read());
    numbers.put(0.25); numbers.run(3); say("fractions", numbers.read());
    numbers.put(-1); numbers.run(1); say("to zero", numbers.read());
}

function observers() {
    let level: number = 0;
    const seen: number[] = [];
    const watcher = { valueOf(): number { seen.push(level); if (level === 3) level = 10; return 12; } };
    const holder = { get limit(): number { seen.push(-level); return level < 6 ? 8 : 0; } };
    function againstValueOf(bound: any): number { let turns = 0; while (level < bound) { level++; turns++; } return turns; }
    function againstGetter(object: { limit: number }): number { let turns = 0; while (level < object.limit) { level += 2; turns++; } return turns; }
    return { run1: () => againstValueOf(watcher), run2: () => againstGetter(holder), clear(): void { level = 0; seen.length = 0; }, read: () => level + "|" + seen.join(",") };
}
{
    const watched = observers();
    say("valueOf writes", watched.run1(), watched.read());
    watched.clear();
    say("getter reads", watched.run2(), watched.read());
}

function nested() {
    let row: number = 0;
    let column: number = 0;
    let cells = 0;
    function walk(rows: number, columns: number): void {
        for (row = 0; row < rows; row++) {
            for (column = 0; column < columns; column++) {
                cells += row * 10 + column;
                if (column === row) continue;
                if (column > row + 2) break;
            }
        }
    }
    function labelled(rows: number): void {
        outer: while (row > 0) {
            row--;
            column = rows;
            while (column > 0) {
                column--;
                if (column === row) continue outer;
                if (row === 1) break outer;
                cells++;
            }
        }
    }
    return { walk, labelled, read: () => row + "|" + column + "|" + cells };
}
{
    const grid = nested();
    grid.walk(5, 7); say("nested", grid.read());
    grid.labelled(4); say("labelled", grid.read());
}

let moduleIndex: number = 0;
let moduleTotal: number = 0;
let moduleText: string = "module level text";
function bumpModuleIndex(): void { moduleIndex += 3; }
function moduleLoop(limit: number): number {
    let turns = 0;
    while (moduleIndex < limit) {
        moduleTotal += moduleText.charCodeAt(moduleIndex % moduleText.length);
        moduleIndex++;
        if (moduleIndex % 8 === 0) bumpModuleIndex();
        turns++;
    }
    return turns;
}
say("module variables", moduleLoop(40), moduleIndex, moduleTotal);
moduleIndex = opaque(5); moduleText = opaque("other");
say("module variables again", moduleLoop(12), moduleIndex, moduleTotal);

function finallyAndCatch() {
    let step: number = 0;
    const log: string[] = [];
    function run(): void {
        while (step < 9) {
            try {
                step++;
                if (step % 3 === 0) throw new Error("e" + step);
                if (step === 7) continue;
                log.push("t" + step);
            } catch (error) {
                log.push((error as Error).message + "@" + step);
                step++;
            } finally {
                log.push("f" + step);
            }
        }
    }
    return { run, read: () => step + "|" + log.join(",") };
}
{
    const handled = finallyAndCatch();
    handled.run(); say("handlers", handled.read());
}

function suspended() {
    let cursor: number = 0;
    function* numbers(limit: number): Generator<number, string, void> { while (cursor < limit) { yield cursor; cursor++; } return "end" + cursor; }
    async function slowly(limit: number): Promise<number> { let turns = 0; while (cursor < limit) { cursor++; await null; turns++; } return turns; }
    return { numbers, slowly, jump(by: number): void { cursor += by; }, read: () => cursor };
}
{
    const paused = suspended();
    const got: unknown[] = [];
    const iterator = paused.numbers(10);
    for (let next = iterator.next(); ; next = iterator.next()) {
        got.push(next.value);
        if (next.done) break;
        if (next.value === 2) paused.jump(4);
    }
    say("generator", got.join(","), paused.read());
}

function deadZone() {
    function early(): number { let turns = 0; while (late < 3) { late++; turns++; } return turns; }
    let result: unknown;
    try { result = early(); } catch (error) { result = (error as Error).name; }
    let late: number = 1;
    return [result, early(), late];
}
say("dead zone", ...deadZone());

function twoOfOneKind() {
    const first = makeCounter(), second = makeCounter();
    function makeCounter() {
        let value: number = 0;
        return {
            raceAgainst(other: { bump(): void; read(): number }, limit: number): number { let turns = 0; while (value < limit) { value++; other.bump(); turns++; } return turns; },
            bump(): void { value += 2; },
            read(): number { return value; },
        };
    }
    return [first.raceAgainst(second, 5), first.read(), second.read(), first.raceAgainst(first, 20), first.read()];
}
say("two environments of one kind", ...twoOfOneKind());

function neverEntered() {
    let untouched: number = 7;
    function run(limit: number): number { let turns = 0; while (untouched < limit) { untouched++; turns++; } return turns; }
    return [run(7), untouched, run(-1), untouched];
}
say("no turn", ...neverEntered());

function changesKind() {
    let shifting: any = 0;
    function run(): string { let trail = ""; while (shifting < 6 || shifting.length < 4) { trail += typeof shifting + ";"; shifting = shifting === 2 ? "2" : shifting + 1; if (trail.length > 90) break; } return trail; }
    return [run(), shifting];
}
say("a number becomes a string", ...changesKind());

function callsOnOneArm() {
    let cursor: number = 0;
    let limit: number = 40;
    let calls = 0;
    function skip(by: number): boolean { calls++; cursor += by; if (calls === 3) limit -= 5; return calls % 2 === 0; }
    function run(text: string): string {
        let trail = "";
        while (cursor < limit) {
            const code = text.charCodeAt(cursor % text.length);
            if (code > 110 && skip(code - 110)) trail += "!";
            trail += cursor + ",";
            cursor++;
        }
        return trail;
    }
    return [run("abcxyzdefpq"), cursor, limit, calls];
}
say("a call on one arm writes", ...callsOnOneArm());

function readThroughAnotherClosure() {
    let at: number = 0;
    let source: string = "one two  three";
    function current(): number { return source.charCodeAt(at); }
    function isSpace(): boolean { return current() === 32; }
    function skipSpaces(): number { let turns = 0; while (at < source.length && isSpace()) { at++; turns++; } return turns; }
    function skipWord(): number { let turns = 0; while (at < source.length && !isSpace()) { at++; turns++; } return turns; }
    const counts: number[] = [];
    while (at < source.length) { counts.push(skipWord(), skipSpaces()); if (counts.length === 4) source += " four"; }
    return [counts.join(","), at, source];
}
say("read through another closure", ...readThroughAnotherClosure());

function leavesTheIntegers() {
    let big: number = 2147483644;
    let half: number = 0;
    function up(limit: number): number { let turns = 0; while (big < limit) { big++; turns++; } return turns; }
    function byHalves(limit: number): number { let turns = 0; while (half < limit) { half += turns === 3 ? 0.5 : 1; turns++; } return turns; }
    return [up(2147483652), big, up(2147483655), big, byHalves(7), half];
}
say("leaves the integers in the loop", ...leavesTheIntegers());

function someTurnsDoNotStore() {
    let seen: number = 0;
    let index: number = 0;
    function run(values: number[]): number {
        let turns = 0;
        while (index < values.length) {
            turns++;
            if (values[index++] % 3 === 0) continue;
            seen += index;
        }
        return turns;
    }
    return [run([1, 3, 4, 6, 9, 10, 11]), seen, index];
}
say("some turns do not store", ...someTurnsDoNotStore());

function leavesBehindAStore() {
    let at: number = 0;
    let found = 0;
    const where = (): number => at;
    function find(text: string, code: number): boolean {
        while (at < text.length) {
            const c = text.charCodeAt(at);
            at++;
            if (c === code) { found++; return true; }
        }
        return false;
    }
    function untilItThrows(text: string, holder: { inner: { stop: number } | null }): number {
        let turns = 0;
        while (at < text.length) {
            at++;
            turns++;
            if (text.charCodeAt(at) === 46) holder.inner = null;
            if (holder.inner!.stop === at) break;
        }
        return turns;
    }
    const trail: unknown[] = [];
    const text = "ab,cd,,e.fgh";
    while (find(text, 44)) trail.push(where());
    trail.push(where(), found);
    at = 0;
    trail.push(untilItThrows(text, { inner: { stop: 3 } }), where());
    try { untilItThrows(text, { inner: { stop: 99 } }); } catch (error) { trail.push((error as Error).name, where()); }
    return trail;
}
say("leaves behind a store", ...leavesBehindAStore());

function growsItsArray() {
    let points = new Int32Array(2);
    let length: number = 0;
    function add(parts: number[]): void {
        for (const part of parts) {
            if (length === points.length) { const roomier = new Int32Array(points.length * 2); roomier.set(points); points = roomier; }
            points[length++] = part;
        }
    }
    add([5, 6, 7]); add([]); add([8, 9, 10, 11, 12, 13]);
    return [length, points.length, Array.from(points).join(",")];
}
say("the array itself is replaced in the loop", ...growsItsArray());

const names: (string | number)[] = ["a", "b", 0, "length", "zz"];
function asksEveryName(object: any): number { let count = 0; for (let round = 0; round < 3; round++) for (const name of names) count += name in object ? 1 : 0; return count; }
say("a loop inside runs other code", asksEveryName({ a: 1, zz: 2 }), asksEveryName([7]), asksEveryName(new Proxy({}, { has(_, key) { if (key === "b") names.push("a"); return key === "a"; } })), names.length);

function readsARope() {
    let at: number = 0;
    let stops = 0;
    const where = (): number => at;
    function untilMark(text: string): number { let turns = 0; while (true) { at++; turns++; if (at >= text.length || text.charCodeAt(at) === 33) { stops++; break; } } return turns; }
    const trail: unknown[] = [];
    for (const tail of ["!", "xyz!", ""]) {
        const rope = opaque("left half, ") + opaque("right half") + tail;
        at = 0;
        trail.push(untilMark(rope), where());
    }
    return [...trail, stops];
}
say("a rope is resolved in the loop", ...readsARope());

const paused = suspended();
paused.slowly(6).then(turns => {
    say("async", turns, paused.read());
    console.log(lines.join("\n"));
});
paused.jump(2);
