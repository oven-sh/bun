// A method is added to the prototype of a subclass that only inherited it: calls through the base type find it, for that subclass and the classes below it and for no other.
class A {
  foo(): number {
    return 1;
  }
  get size(): number {
    return 10;
  }
}
class B extends A {}
class C extends B {}
class D extends B {
  override foo(): number {
    return super.foo() + 100;
  }
}
class Sibling extends A {}
function callFoo(a: A): number {
  return a.foo();
}
function readSize(a: A): number {
  return a.size;
}
function all(label: string): void {
  console.log(label + ": " + callFoo(new A()) + " " + callFoo(new B()) + " " + callFoo(new C()) + " " + callFoo(new D()) + " " + callFoo(new Sibling()) + ", sizes " + readSize(new A()) + " " + readSize(new B()) + " " + readSize(new C()));
}
all("as declared");
Object.defineProperty(B.prototype, "foo", { value(): number { return 2; }, writable: true, configurable: true });
all("defined on B.prototype");
(C.prototype as any).foo = function (): number { return 3; };
all("stored on C.prototype");
Object.defineProperty(B.prototype, "size", { get(): number { return 20; }, configurable: true });
all("a getter defined on B.prototype");
delete (B.prototype as any).foo;
all("deleted from B.prototype");
delete (C.prototype as any).foo;
delete (B.prototype as any).size;
all("as declared again");
const early = new C();
Object.setPrototypeOf(C.prototype, Sibling.prototype);
(Sibling.prototype as any).foo = function (): number { return 5; };
all("C.prototype under Sibling.prototype");
console.log("an instance from before: " + callFoo(early));
const shadowed: any = new B();
shadowed.foo = (): number => 6;
console.log("an own property: " + callFoo(shadowed) + " " + callFoo(new B()));
//// super-access-before-super-call.js
// Before `super()` has returned, a store to a super property runs its key and its value and then throws. A read or a call throws before its key runs.
const steps = [];
function step(name, value) {
  steps.push(name);
  return value;
}
class Base {
  get x() {
    steps.push("getter");
    return 1;
  }
  set x(value) {
    steps.push("setter");
  }
  method() {
    steps.push("method");
  }
}
function attempt(title, Class) {
  let outcome = "constructed";
  try {
    new Class();
  } catch (error) {
    outcome = error.name;
  }
  console.log(`${title}: ${outcome}`, JSON.stringify(steps.splice(0)));
}

attempt("store by name", class extends Base {
  constructor() {
    super.x = step("value", 1);
    super();
  }
});
attempt("store by key", class extends Base {
  constructor() {
    super[step("key", "x")] = step("value", 1);
    super();
  }
});
attempt("read by name", class extends Base {
  constructor() {
    super.x;
    super();
  }
});
attempt("read by key", class extends Base {
  constructor() {
    super[step("key", "x")];
    super();
  }
});
attempt("call by name", class extends Base {
  constructor() {
    super.method(step("argument"));
    super();
  }
});
attempt("call by key", class extends Base {
  constructor() {
    super[step("key", "method")](step("argument"));
    super();
  }
});
attempt("update by name", class extends Base {
  constructor() {
    super.x += step("value", 1);
    super();
  }
});
attempt("update by key", class extends Base {
  constructor() {
    super[step("key", "x")] += step("value", 1);
    super();
  }
});
attempt("increment by key", class extends Base {
  constructor() {
    super[step("key", "x")]++;
    super();
  }
});
attempt("logical assignment", class extends Base {
  constructor() {
    super.x &&= step("value", 1);
    super();
  }
});
attempt("array pattern", class extends Base {
  constructor() {
    [super.x] = step("value", [1]);
    super();
  }
});
attempt("object pattern", class extends Base {
  constructor() {
    ({ a: super[step("key", "x")] } = step("value", { a: 1 }));
    super();
  }
});
attempt("head of for-of", class extends Base {
  constructor() {
    for (super.x of step("value", [1]));
    super();
  }
});
attempt("store in an arrow function", class extends Base {
  constructor() {
    const store = () => {
      super.x = step("value", 1);
    };
    store();
    super();
  }
});
attempt("store after a super() that was skipped", class extends Base {
  constructor() {
    if (step("condition", false)) super();
    super.x = step("value", 1);
  }
});
attempt("store after super()", class extends Base {
  constructor() {
    super();
    super[step("key", "x")] = step("value", 1);
  }
});
attempt("update after super()", class extends Base {
  constructor() {
    super();
    super[step("key", "x")] += step("value", 1);
  }
});
