//// object-constructed-for-another-new-target-ignores-its-operand.js
// Object constructed for another new.target ignores its operand: super(object), super(5), super("text"), Reflect.construct(Object, [object], Other). For Object itself it answers the object or wraps the primitive.
////= Below
class BelowNumber extends Object {
  tag = 1;
  constructor(value) {
    super(value);
  }
}
function Other() {}
Other.prototype.mark = "other";
const given = { given: true };
let sum = 0;
for (let i = 0; i < 300; i++) {
  const made = new Below(given, i);
  sum += made.tag;
  if (made === given || made.given === true || "tag" in given) throw new Error("the operand came back");
}
console.log(sum, Object.keys(given).join());
const wrapped = new BelowNumber(5);
console.log(typeof wrapped, wrapped instanceof Number, wrapped instanceof BelowNumber, wrapped.tag, Object.prototype.toString.call(wrapped));
const text = new BelowNumber("text");
console.log(text instanceof String, text.length, text.tag);
const reflected = Reflect.construct(Object, [given], Other);
console.log(reflected === given, reflected.mark, reflected.given, Object.getPrototypeOf(reflected) === Other.prototype);
const reflectedItself = Reflect.construct(Object, [given], Object);
console.log(reflectedItself === given, reflectedItself.given);
const reflectedPlain = Reflect.construct(Object, [given]);
console.log(reflectedPlain === given);
const same = new Object(given);
console.log(same === given, same.given);
const number = new Object(5);
console.log(number instanceof Number, typeof number, number + 1);
const called = Object(given);
console.log(called === given);
const fresh = new Object();
fresh.x = 1;
console.log(Object.keys(fresh).join(), Object.keys(given).join());
function pick(flag) { return flag ? Object : Other; }
for (const flag of [true, false]) {
  const either = Reflect.construct(Object, [given], pick(flag));
  console.log(flag, either === given, either.mark);
}
class Deeper extends Below {
  more = 2;
  constructor(value) { super(value, 7); }
}
const deep = new Deeper(given);
console.log(deep.tag, deep.more, deep === given, deep instanceof Deeper);
//// objects-of-classes-below-built-ins-and-their-look-alikes-are-changed-out-of-sight.ts
// Instances of classes below Map, Set, Error and Promise, and objects that only look like them, gain and lose names, change prototypes and hold values of other types in code the compiler cannot see.
////= Defaults
class Narrow extends Defaults {
  limit = 3;
  getOr(key: string, fallback: number): number {
    return Math.min(super.getOr(key, fallback), this.limit);
  }
}
class Tags extends Set<string> {
  toggle(tag: string): boolean {
    if (this.has(tag)) {
      this.delete(tag);
      return false;
    }
    this.add(tag);
    return true;
  }
}
class HttpError extends Error {
  status: number;
  constructor(message: string, status: number) {
    super(message);
    this.status = status;
  }
  isClient(): boolean {
    return this.status < 500;
  }
}
class Deferred extends Promise<number> {
  tag(): number {
    return 3;
  }
}
class Sealed extends Map<string, number> {
  #hits = 0;
  #bump(): number {
    return ++this.#hits;
  }
  count(key: string): number {
    return this.has(key) ? this.#bump() : -this.#hits;
  }
}

const change = new Function(
  "o",
  "how",
  `
  switch (how) {
    case "hide member": o.getOr = o.toggle = o.isClient = o.tag = o.count = () => "hidden"; break;
    case "show member": delete o.getOr; delete o.toggle; delete o.isClient; delete o.tag; delete o.count; break;
    case "hide built-in": o.get = o.has = () => "own"; break;
    case "show built-in": delete o.get; delete o.has; break;
    case "between": Object.setPrototypeOf(o, { __proto__: Object.getPrototypeOf(o), getOr() { return "between"; }, toggle() { return "between"; }, isClient() { return "between"; }, tag() { return "between"; }, count() { return "between"; } }); break;
    case "back": Object.setPrototypeOf(o, Object.getPrototypeOf(Object.getPrototypeOf(o))); break;
    case "many": for (let i = 0; i < 200; i++) o["extra" + i] = i; break;
    case "few": for (let i = 0; i < 200; i++) delete o["extra" + i]; break;
    case "freeze": Object.freeze(o); break;
    case "other type": o.status = "text"; o.limit = "wide"; break;
    case "stack": void o.stack; break;
  }
`,
) as (o: object, how: string) => void;

function useDefaults(d: Defaults): unknown {
  return [d.getOr("a", 9), d.getOr("b", 9), d.size, d instanceof Defaults, d instanceof Narrow, d instanceof Map];
}
function useTags(t: Tags): unknown {
  return [t.toggle("a"), t.toggle("a"), t.size, t instanceof Tags, t instanceof Set];
}
function useError(e: HttpError): unknown {
  return [e.isClient(), e.status, e.message, e instanceof HttpError, e instanceof Error];
}
function useDeferred(p: Deferred): unknown {
  return [p.tag(), p instanceof Deferred, p instanceof Promise];
}
function useSealed(s: Sealed): unknown {
  return [s.count("a"), s.count("b"), s instanceof Sealed];
}
function attempt(use: (o: any) => unknown, o: object): string {
  try {
    return JSON.stringify(use(o));
  } catch (error) {
    return "throws " + (error as Error).constructor.name;
  }
}

const steps = ["hide member", "show member", "hide built-in", "show built-in", "between", "back", "many", "few", "other type", "stack", "freeze"];
const makers: [string, (o: any) => unknown, () => object][] = [
  ["Defaults", useDefaults, () => new Defaults([["a", 1]])],
  ["Narrow", useDefaults, () => new Narrow([["a", 7]])],
  ["Tags", useTags, () => new Tags(["a"])],
  ["HttpError", useError, () => new HttpError("no", 404)],
  ["Deferred", useDeferred, () => new Deferred(resolve => resolve(1))],
  ["Sealed", useSealed, () => new Sealed([["a", 1]])],
  ["Map for Defaults", useDefaults, () => Reflect.construct(Map, [[["a", 2]]], Defaults)],
  ["Defaults for Narrow", useDefaults, () => Reflect.construct(Defaults, [[["a", 8]]], Narrow)],
  ["Narrow for Defaults", useDefaults, () => Reflect.construct(Narrow, [[["a", 8]]], Defaults)],
  ["Defaults for Tags", useDefaults, () => Reflect.construct(Defaults, [], Tags)],
  ["Error for HttpError", useError, () => Reflect.construct(Error, ["made"], HttpError)],
  ["TypeError for HttpError", useError, () => Reflect.construct(TypeError, ["made"], HttpError)],
  ["a Map moved below Defaults", useDefaults, () => Object.setPrototypeOf(new Map([["a", 3]]), Defaults.prototype)],
  ["an Error moved below HttpError", useError, () => Object.setPrototypeOf(new Error("moved"), HttpError.prototype)],
  ["an object below Defaults", useDefaults, () => Object.create(Defaults.prototype)],
  ["an object below an instance", useDefaults, () => Object.create(new Defaults([["a", 4]]))],
  ["a Set moved below Defaults", useDefaults, () => Object.setPrototypeOf(new Set(["a"]), Defaults.prototype)],
];

for (const [name, use, make] of makers) {
  const warm = make();
  let last = "";
  for (let i = 0; i < 300; i++) last = attempt(use, warm);
  console.log(name, last);
  for (const step of steps) {
    const alone = make();
    change(alone, step);
    change(warm, step);
    console.log(name, "|", step, "|", attempt(use, alone), "|", attempt(use, warm), "|", attempt(use, make()));
  }
}

function classesMadeAgain(round: number): unknown {
  class Local extends Map<string, number> {
    twice(key: string): number {
      return (this.get(key) ?? round) * 2;
    }
  }
  return Local;
}
const first = classesMadeAgain(1) as new (entries: [string, number][]) => Map<string, number> & { twice(key: string): number };
const second = classesMadeAgain(2) as typeof first;
for (const made of [new first([["a", 5]]), new second([["a", 6]]), Reflect.construct(first, [[["a", 7]]], second)])
  console.log("made again", made.twice("a"), made.twice("b"), made instanceof first, made instanceof second);

(Defaults.prototype as any).getOr = function (this: Defaults, key: string) {
  return "replaced " + this.has(key);
};
console.log("member replaced", attempt(useDefaults, new Defaults([["a", 1]])), attempt(useDefaults, new Narrow([["a", 1]])));
Object.setPrototypeOf(Tags.prototype, {
  __proto__: Set.prototype,
  has() {
    return true;
  },
});
console.log("link changed", attempt(useTags, new Tags(["a"])));
Object.setPrototypeOf(HttpError, RangeError);
console.log("parent changed", attempt(useError, new HttpError("late", 500)), new HttpError("late", 500) instanceof RangeError);
//// objects-of-classes-below-containers-flow-into-unions-of-an-interface-and-the-container.ts
interface Stream {
  listeners: number;
  name?: string;
}
class Waiting extends Set<Stream> {
  listeners = 7;
  label = "waiting";
}
class Row extends Array<Stream> {
  listeners = 8;
}
class Table extends Map<string, Stream> {
  listeners = 9;
}
class Later extends Promise<Stream> {
  listeners = 10;
}
class Bytes extends Uint8Array {
  listeners = 11;
}
interface State {
  set: Stream | Set<Stream> | null;
  list: Stream | Stream[] | null;
  map: Stream | Map<string, Stream> | null;
  promise: Stream | Promise<Stream> | null;
  bytes: Stream | Uint8Array | null;
}

function countOf(stream: Stream): number {
  return stream.listeners;
}
function describe(value: State[keyof State]): string {
  if (value === null) return "null";
  if (value instanceof Set) {
    return "set " + value.size + " " + (value as Waiting).label + " " + (value as unknown as Stream).listeners;
  }
  if (Array.isArray(value)) return "list " + value.length + " " + (value as unknown as Stream).listeners;
  if (value instanceof Map) return "map " + value.size + " " + (value as unknown as Stream).listeners;
  if (value instanceof Promise) return "promise " + (value as unknown as Stream).listeners;
  if (value instanceof Uint8Array) return "bytes " + value.length + " " + (value as unknown as Stream).listeners;
  return "stream " + countOf(value);
}

const plain: Stream = { listeners: 1 };
const state: State = { set: null, list: null, map: null, promise: null, bytes: null };
function fill(turn: number) {
  state.set = turn % 3 === 0 ? plain : turn % 3 === 1 ? new Waiting([plain]) : new Set([plain, { listeners: 2 }]);
  state.list = turn % 3 === 0 ? plain : turn % 3 === 1 ? Row.from([plain, plain]) : [plain];
  state.map = turn % 3 === 0 ? plain : turn % 3 === 1 ? new Table([["a", plain]]) : new Map();
  state.promise = turn % 3 === 0 ? plain : turn % 3 === 1 ? Later.resolve(plain) : Promise.resolve(plain);
  state.bytes = turn % 3 === 0 ? plain : turn % 3 === 1 ? new Bytes(3) : new Uint8Array(4);
}
for (let turn = 0; turn < 6; turn++) {
  fill(turn);
  console.log(describe(state.set), "|", describe(state.list), "|", describe(state.map));
  console.log(describe(state.promise), "|", describe(state.bytes));
}
// Each of them has the member that a Stream requires, so the checker lets it in as one.
const streams = [new Waiting(), new Row(), new Table(), Later.resolve(plain), new Bytes(1), plain] as Stream[];
for (const stream of streams) console.log(countOf(stream));
//// one-class-text-evaluated-more-than-once.ts
// The text of a class below a built-in class is evaluated more than once: each evaluation gives a class with a prototype object, captured values and static members of its own.
const lines: string[] = [];
function tagged(tag: string, step: number) {
  return class Tagged extends Map<string, number> {
    count = step;
    static made = 0;
    constructor() {
      super([[tag, step]]);
      Tagged.made++;
    }
    tag(): string {
      return tag + this.count + ":" + this.get(tag) + ":" + this.size;
    }
    bump(): number {
      this.count += step;
      return this.count;
    }
  };
}
const First = tagged("first", 1);
const Second = tagged("second", 10);
type Tagged = InstanceType<typeof First>;
function use(k: Tagged): string {
  return k.tag() + " " + k.bump() + " " + (k instanceof First) + (k instanceof Second) + (k instanceof Map) + " " + (Object.getPrototypeOf(k) === First.prototype);
}
function failing<T extends new (...operands: any[]) => Error>(Parent: T, code: number) {
  return class Coded extends Parent {
    code = code;
    describe(): string {
      return this.name + ":" + this.message + ":" + this.code;
    }
  };
}
const Plain = failing(Error, 1);
const Typed = failing(TypeError, 2);
const Twice = failing(Plain, 3);
function describe(k: InstanceType<typeof Plain>): string {
  return k.describe() + " " + (k instanceof Plain) + (k instanceof Typed) + (k instanceof Twice) + (k instanceof TypeError);
}
for (let round = 0; round < 4; round++) {
  const list: Tagged[] = [new First(), new Second(), new First(), new (tagged("third", 100))()];
  for (const each of list) lines.push(use(each));
  for (const each of [new Plain("p"), new Typed("t"), new Twice("w")]) lines.push(describe(each as InstanceType<typeof Plain>));
  if (round === 1) (First.prototype as any).tag = function () { return "replaced on the first"; };
  if (round === 2) Object.setPrototypeOf(Second.prototype, First.prototype);
  Bun.gc(true);
}
lines.push(First.made + " " + Second.made);
console.log(lines.join("\n"));
//// one-object-under-the-type-of-the-class-and-of-the-parent.ts
// One object is reached through two names in one function: one has the type of a class below a built-in class, the other the type of the parent. What is written through one is read through the other.
const lines: string[] = [];
class OnMap extends Map<string, number> { count = 1; twice(): number { return this.count * 2; } }
class OnSet extends Set<number> { count = 1; twice(): number { return this.count * 2; } }
class OnError extends Error { count = 1; twice(): number { return this.count * 2; } }
class OnDate extends Date { count = 1; twice(): number { return this.count * 2; } }
class OnRegExp extends RegExp { count = 1; twice(): number { return this.count * 2; } }
class OnBytes extends Uint8Array { count = 1; twice(): number { return this.count * 2; } }
function map(k: OnMap, m: Map<string, number>): string {
  const twice = k.twice();
  const before = k.get("x");
  const size = k.size;
  m.set("x", 5);
  m.set("y", 6);
  const between = k.get("x");
  k.set("x", 7);
  return [twice, before, size, between, k.size, m.get("x"), m.size, k.has("y"), m === k].join();
}
function set(k: OnSet, s: Set<number>): string {
  const twice = k.twice();
  const before = k.has(1);
  const size = k.size;
  s.add(1);
  const between = k.has(1);
  k.delete(1);
  return [twice, before, size, between, k.size, s.has(1), s.size].join();
}
function error(k: OnError, e: Error): string {
  const twice = k.twice();
  const before = k.message;
  e.message = "changed";
  const between = k.message;
  k.message = "again";
  (e as any).count = 5;
  return [twice, before, between, e.message, k.count, k.twice()].join();
}
function date(k: OnDate, d: Date): string {
  const twice = k.twice();
  const before = k.getTime();
  d.setTime(5);
  const between = k.getTime();
  k.setTime(6);
  return [twice, before, between, d.getTime()].join();
}
function regExp(k: OnRegExp, r: RegExp): string {
  const twice = k.twice();
  const before = k.lastIndex;
  r.lastIndex = 3;
  const between = k.lastIndex;
  k.lastIndex = 4;
  return [twice, before, between, r.lastIndex].join();
}
function bytes(k: OnBytes, b: Uint8Array): string {
  const twice = k.twice();
  const before = k[0];
  b[0] = 5;
  const between = k[0];
  k[0] = 6;
  return [twice, before, between, b[0], k.length, b.length].join();
}
function loop(k: OnMap, m: Map<string, number>): number {
  let sum = 0;
  for (let i = 0; i < 6; i++) {
    sum += k.twice() + (k.get("x") ?? 0) + k.size;
    m.set("x", i);
    if (i === 3) m.set("z" + i, i);
  }
  return sum;
}
for (let round = 0; round < 3; round++) {
  const m = new OnMap([["x", 1]]); lines.push(map(m, m), map(new OnMap([["x", 1]]), new Map()), map(new OnMap(), new OnMap()));
  const s = new OnSet(); lines.push(set(s, s), set(new OnSet(), new Set()));
  const e = new OnError("first"); lines.push(error(e, e), error(new OnError("first"), new Error("other")));
  const d = new OnDate(1); lines.push(date(d, d), date(new OnDate(1), new Date(2)));
  const r = new OnRegExp("a", "g"); lines.push(regExp(r, r), regExp(new OnRegExp("a", "g"), /b/g));
  const b = new OnBytes([1]); lines.push(bytes(b, b), bytes(new OnBytes([1]), new Uint8Array(1)));
  const l = new OnMap([["x", 1]]); lines.push(String(loop(l, l)), String(loop(new OnMap(), new Map())));
}
console.log(lines.join("\n"));
//// range-error-and-the-parent-gets-another-parent-before-the-first-touch.js
// Between the definition of a class below RangeError and its first touch the built-in class gets another prototype. A compiled executable refuses that: a built-in constructor keeps its prototype.
////= tell
////= Late	RangeError
tell("another parent", () => Object.setPrototypeOf(RangeError, { above: () => "above" }) === RangeError);
tell("inherited", () => Late.above());
tell("an instance", () => {
  const one = new Late("m");
  return [one.message + one.name, one instanceof Late, one instanceof RangeError, one.method(), one.constructor === Late, Object.getPrototypeOf(Late) === RangeError].join(" ");
});
//// statics-and-instanceof-through-native-constructors-that-change.js
class NotFound extends Error {}
class Forbidden extends Error {}
class Bag extends Map {}
class List extends Array {}
class Later extends Promise {}

function kindOf(thrower) {
  try {
