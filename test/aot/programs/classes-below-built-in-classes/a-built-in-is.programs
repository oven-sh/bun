//// instanceof-in-a-catch-is-not-three-times-as-slow-for-a-class-below-error.js
// What is caught is told apart by `instanceof`. A class below Error finds Symbol.hasInstance two objects further up than a class of its own, and that is all the difference there is.
class Plain {}
class OtherPlain {}
class Below extends Error {}
class OtherBelow extends Error {}
function kindOf(thrown, First, Second) {
  try {
    throw thrown;
  } catch (caught) {
    return caught instanceof First ? 1 : caught instanceof Second ? 2 : 3;
  }
}
function throwAndTell(values, First, Second) {
  let sum = 0;
  for (let i = 0; i < 200000; i++) sum += kindOf(values[i & 1], First, Second);
  return sum;
}
function fastestOf(runs, values, First, Second) {
  let fastest = Infinity;
  for (let run = 0; run < runs; run++) {
    const began = performance.now();
    if (throwAndTell(values, First, Second) !== 300000) console.log("told apart wrongly");
    fastest = Math.min(fastest, performance.now() - began);
  }
  return fastest;
}
const plain = fastestOf(5, [new Plain(), new OtherPlain()], Plain, OtherPlain);
const below = fastestOf(5, [new Below("a"), new OtherBelow("b")], Below, OtherBelow);
console.log(below < plain * 3 ? "a class below Error is told apart in under three times the time" : "a class below Error took over three times the time");
//// instances-are-frozen-sealed-and-closed-in-typed-code-and-live-through-collections.ts
// Instances of classes below Map, Set and Error are frozen, sealed and made non-extensible where the compiler sees their type, then live through collections and are used.
////= Defaults
class Tags extends Set<string> {
  count(): number {
    return this.size;
  }
}
class Failure extends Error {
  code = 7;
  twice(): number {
    return this.code * 2;
  }
}
////= lines-9	freezeDefaults	Defaults	freeze
////= lines-9	sealTags	Tags	seal
////= lines-9	closeFailure	Failure	preventExtensions
////= lines-9	freezeFailure	Failure	freeze
const kept: object[] = [];
for (let i = 0; i < 2000; i++) {
  const defaults = freezeDefaults(new Defaults([["a", i]]));
  const tags = sealTags(new Tags(["a", "b"]));
  const closed = closeFailure(new Failure("closed"));
  const frozen = freezeFailure(new Failure("frozen"));
  if (i % 100 === 0) {
    kept.push(defaults, tags, closed, frozen);
    Bun.gc(true);
  }
}
Bun.gc(true);
let sum = 0;
for (const made of kept) {
  if (made instanceof Defaults) sum += made.getOr("a", 1) + made.getOr("b", 2) + (Object.isFrozen(made) ? 1000 : 0);
  else if (made instanceof Tags) sum += made.count() + (Object.isSealed(made) ? 100 : 0);
  else if (made instanceof Failure) sum += made.twice() + (Object.isExtensible(made) ? 0 : 10) + (Object.isFrozen(made) ? 1 : 0);
}
console.log(sum, kept.length);
for (const made of kept.slice(0, 4)) {
  try {
    "use strict";
    (made as any).extra = 1;
    console.log("stored", "extra" in made);
  } catch (error) {
    console.log((error as Error).constructor.name);
  }
}
