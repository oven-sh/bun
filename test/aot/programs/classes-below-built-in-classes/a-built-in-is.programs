////= tell
////= Late	FinalizationRegistry
tell("another parent", () => Object.setPrototypeOf(FinalizationRegistry, { above: () => "above" }) === FinalizationRegistry);
tell("inherited", () => Late.above());
tell("an instance", () => {
  const one = new Late(() => {});
