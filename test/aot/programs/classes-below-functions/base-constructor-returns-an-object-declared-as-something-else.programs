//// field-of-another-kind-is-defined-on-an-object-held-in-a-variable-declared-a-number.ts
// The base of a class is a function that returns an object of another class, held in a variable declared a number: the field of the derived class replaces the field of that object.
function scene(): void {
  const inner = { inner: 1 };
  class A {
    c = inner as any;
  }
  const held: number = new A() as any;
  function base(): any {
    return held;
  }
  const list = [1, "e"];
  class D extends (base as any) {
    c = list as any;
  }
  new (D as any)();
  console.log((held as any).c);
}
scene();
//// new-field-is-defined-on-an-object-held-in-a-variable-declared-a-number.ts
// The base of a class is a function that returns an object of another class, held in a variable declared a number: the field of the derived class is added to that object.
function scene(): void {
  class A {
    a = 2;
  }
  const held: number = new A() as any;
  function base(): any {
    return held;
  }
  class D extends (base as any) {
    value = "1";
  }
  new (D as any)();
  console.log(typeof (held as any).value);
}
scene();
//// new-field-is-defined-on-an-object-that-the-base-is-declared-to-return-as-a-number.ts
// The base of a class is a function declared to return a number, which returns an object of another class: the field of the derived class is added to that object.
function scene(): void {
  class A {
    a = 2;
  }
  const held: any = new A();
  function base(): number {
    return held;
  }
  class D extends (base as any) {
    value = "1";
  }
  new (D as any)();
  console.log(typeof held.value);
}
scene();
//// base-that-returns-another-object-is-an-arrow-function.ts
// The base of a class returns an object of another class through a variable or a result declared a number.
class A {
  a = 2;
}
const held: any = new A();
const base = (): number => held;
try {
  class D extends (base as any) {
    value = "1";
  }
  new (D as any)();
} catch (error) {
  console.log((error as Error).constructor.name);
}
console.log(typeof held.value);
//// base-that-returns-another-object-is-a-bound-function.ts
// The base of a class returns an object of another class through a variable or a result declared a number.
class A {
  a = 2;
}
const held: any = new A();
function target(): number {
  return held;
}
const base = target.bind(null);
try {
  class D extends (base as any) {
    value = "1";
  }
  new (D as any)();
} catch (error) {
  console.log((error as Error).constructor.name);
}
console.log(typeof held.value);
//// base-that-returns-another-object-is-a-class-below-a-class-that-returns.ts
// The base of a class returns an object of another class through a variable or a result declared a number.
class A {
  a = 2;
}
const held: any = new A();
class top {
  constructor() {
    const answer: number = held;
    return answer as any;
  }
}
class base extends top {}
try {
  class D extends (base as any) {
    value = "1";
  }
  new (D as any)();
} catch (error) {
  console.log((error as Error).constructor.name);
}
console.log(typeof held.value);
