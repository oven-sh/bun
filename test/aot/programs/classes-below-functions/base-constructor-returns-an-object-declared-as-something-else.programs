//// base-declared-to-return-symbol-returns-an-object.ts
// The base of a class is a function whose declared result is not what it returns, an object of another class: the field of the derived class is defined on that object.
function scene(): void {
  class Other {
    o = 1;
  }
  class A {
    a = 2;
  }
  const held: any = new A();
  function base(): symbol {
    return held;
  }
  class D extends (base as any) {
    value = "1";
  }
  const made: any = new (D as any)();
  console.log(typeof held.value, made === held, Object.keys(held).join());
}
scene();
//// base-declared-to-return-undefined-returns-an-object.ts
// The base of a class is a function whose declared result is not what it returns, an object of another class: the field of the derived class is defined on that object.
function scene(): void {
  class Other {
    o = 1;
  }
  class A {
    a = 2;
  }
  const held: any = new A();
  function base(): undefined {
    return held;
  }
  class D extends (base as any) {
    value = "1";
  }
  const made: any = new (D as any)();
  console.log(typeof held.value, made === held, Object.keys(held).join());
}
scene();
