//// constructor-returns-another-object-conditional-return.ts
// A constructor returns a value that is declared a primitive and is an object.
class A {
  a = 2;
}
const held: any = new A();
function base(this: any, flag: boolean): number {
  this.own = 1;
  if (flag) return held;
  return 5;
}
class D extends (base as any) {
  value = "1";
}
const first: any = new (D as any)(false);
const second: any = new (D as any)(true);
console.log(first.own, first.value, first === held, second === held, held.value, held.own);
