//// base-that-returns-another-object-is-a-proxy-with-a-trap.ts
// The base of a class returns an object of another class through a variable or a result declared a number.
class A {
  a = 2;
}
const held: any = new A();
function target(): void {}
const base = new Proxy(target, {
  construct(): any {
    const answer: number = held;
    return answer;
  },
});
try {
  class D extends (base as any) {
    value = "1";
  }
  new (D as any)();
} catch (error) {
  console.log((error as Error).constructor.name);
}
console.log(typeof held.value);
