//// base-returns-an-object-held-in-a-parameter.ts
// The base of a class is a function that returns an object of another class, which is held where a primitive is declared.
class A {
  a = 2;
}
function run(held: number): void {
  function base(): any {
    return held;
  }
  class D extends (base as any) {
    value = "1";
  }
  new (D as any)();
  console.log(typeof (held as any).value);
}
run(new A() as any);
//// constructor-returns-another-object-after-storing-on-this.ts
// A constructor declared to return a number returns an object of another class, however it is called.
class A {
  a = 2;
}
const held: any = new A();
function Made(this: any): number {
  this.own = 1;
  return held;
}
const made: any = new (Made as any)();
made.value = "1";
console.log(typeof held.value, made === held, made.own);
//// constructor-returns-another-object-from-a-derived-constructor.ts
// A constructor declared to return a number returns an object of another class, however it is called.
class A {
  a = 2;
}
const held: any = new A();
class Base {
  b = 1;
}
class D extends Base {
  constructor() {
    super();
    const answer: number = held;
    return answer as any;
  }
}
class E extends D {
  value = "1";
}
new E();
console.log(typeof held.value, held.b);
