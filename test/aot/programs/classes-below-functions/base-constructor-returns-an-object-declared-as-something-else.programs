//// constructor-returns-one-of-two-mistyped-values-undefined-then-read-in-the-constructor.ts
// A constructor returns a value that is declared a primitive and is an object.
class A {
  value = 5;
}
const held = new A();
let seen: any = "nothing";
class Base {
  constructor(flag: boolean) {
    const first: string = held as any;
    const second: string = "s";
    return (flag ? first : second) as any;
  }
}
class D extends Base {
  value: any;
  constructor(flag: boolean) {
    super(flag);
    seen = held.value;
    this.value = 9;
  }
}
new D(true);
console.log(seen, held.value);
//// constructor-returns-a-mistyped-value-loop-carried.ts
// A constructor returns a value that is declared a primitive and is an object.
class A {
  value = 5;
}
const held = new A();
class Base {
  constructor(count: number) {
    let answer: number = 1;
    for (let i = 0; i < count; i++) answer = held as any;
    return answer as any;
  }
}
class D extends Base {
  value: any;
  more = "m";
}
new D(2);
console.log(held.value, (held as any).more);
