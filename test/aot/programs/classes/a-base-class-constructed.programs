for (const s of all) there += ("a12" in s ? 1 : 0) + (touch(s, 2) << 1) + ("a12" in s ? 4 : 0);
console.log(there);
kinds.clear();
for (const s of all) kinds.set(describe(s), (kinds.get(describe(s)) ?? 0) + 1);
