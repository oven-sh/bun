//// a-class-that-extends-function-has-members-and-is-handed-out-before-it-is-constructed.js
// What the Function constructor makes for a class that extends it has the prototype object of that class above it, so its methods, accessors and private names work on the function.
// The class may be in other hands (an array of classes, a proxy) before anybody constructs it. Its super call evaluates the text all the same.
class WithMethod extends Function {
  constructor() { super("return 7"); }
  twice() { return this() * 2; }
  get half() { return this() / 2; }
}
const withMethod = new WithMethod();
console.log(withMethod(), withMethod.twice(), withMethod.half, withMethod instanceof WithMethod, withMethod instanceof Function, typeof withMethod);

class WithPrivateField extends Function {
  #count = 1;
  constructor() { super("a", "b", "return a + b"); }
  count() { return this.#count++; }
  static has(value) { return #count in value; }
}
const withPrivateField = new WithPrivateField();
console.log(withPrivateField(2, 3), withPrivateField.count(), withPrivateField.count(), WithPrivateField.has(withPrivateField), WithPrivateField.has(withMethod), withPrivateField.length);

class WithField extends Function {
  label = "field";
  constructor(text) { super(text); this.stored = "stored"; }
}
const withField = new WithField("return this === undefined ? 'no receiver' : typeof this");
console.log(withField.call(5), withField.label, withField.stored, Object.keys(withField).join());

class InArray extends Function {
  #made = "in an array";
  constructor() { super("return 11"); }
  static create() { return new InArray(); }
  made() { return this.#made + " " + this(); }
}
class AlsoInArray extends Map {
  static create() { return new AlsoInArray(); }
  made() { return "a map " + this.size; }
}
for (const Subject of [AlsoInArray, InArray]) {
  const subject = Subject.create();
  console.log(Subject.name, subject.made(), Object.getPrototypeOf(Subject).name);
}

class BehindProxy extends Function {
  constructor() { super("return 13"); }
  static create() { return new BehindProxy(); }
  plusOne() { return this() + 1; }
}
const proxy = new Proxy(BehindProxy, {});
console.log(proxy.create()(), proxy.create().plusOne(), new proxy().plusOne(), new proxy() instanceof BehindProxy);

class Deeper extends WithMethod {
  thrice() { return this() * 3 + this.twice(); }
}
console.log(new Deeper().thrice(), new Deeper() instanceof WithMethod, Object.getPrototypeOf(Deeper) === WithMethod);
//// a-class-with-declared-fields-is-taken-for-interfaces-told-apart-by-a-literal.ts
// One class makes the objects of a union: `new Node(1) as Num`, `new Node(2) as Str`, where the interfaces below the class write one literal each for `kind`. The class declares its fields, one class with initial values and one without, so its constructor runs an initializer. The objects pass for the interfaces: the functions that take a Num or a Str run their typed code on them.
// STATISTIC: TaggedLayoutsNeverAllocated = 0
// STATISTIC: ShapeTestNeverPasses = 0
class Plain {
  kind: number;
  pos: number;
  constructor(kind: number) { this.kind = kind; this.pos = 0; }
}
interface PlainNum extends Plain { kind: 1; value: number }
interface PlainStr extends Plain { kind: 2; text: string }
function plainNum(v: number): PlainNum { const n = new Plain(1) as PlainNum; n.value = v; return n; }
function plainStr(t: string): PlainStr { const n = new Plain(2) as PlainStr; n.text = t; return n; }
function plainValue(n: PlainNum): number { return n.value + n.pos; }
function plainText(n: PlainStr): number { return n.text.length + n.pos; }
function plainEither(n: PlainNum | PlainStr): number { return n.kind === 1 ? n.value : n.text.length; }

class Filled {
  kind: number;
  pos = 3;
  constructor(kind: number) { this.kind = kind; }
}
interface FilledNum extends Filled { kind: 1; amount: number }
interface FilledStr extends Filled { kind: 2; label: string }
function filledNum(v: number): FilledNum { const n = new Filled(1) as FilledNum; n.amount = v; return n; }
function filledStr(t: string): FilledStr { const n = new Filled(2) as FilledStr; n.label = t; return n; }
function filledValue(n: FilledNum): number { return n.amount + n.pos; }
function filledText(n: FilledStr): number { return n.label.length + n.pos; }
function filledEither(n: FilledNum | FilledStr): number { return n.kind === 1 ? n.amount : n.label.length; }

const plainNums: PlainNum[] = [], plainStrs: PlainStr[] = [], filledNums: FilledNum[] = [], filledStrs: FilledStr[] = [];
for (let i = 0; i < 100; i++) {
  plainNums.push(plainNum(i)); plainStrs.push(plainStr("t" + i));
  filledNums.push(filledNum(i)); filledStrs.push(filledStr("t" + i));
}
let total = 0;
for (let k = 0; k < 500; k++) {
  for (let i = 0; i < 100; i++) {
    total = (total + plainValue(plainNums[i]) + plainText(plainStrs[i]) + filledValue(filledNums[i]) + filledText(filledStrs[i])) | 0;
    total = (total + plainEither(plainNums[i]) + plainEither(plainStrs[i]) + filledEither(filledNums[i]) + filledEither(filledStrs[i])) | 0;
  }
}
console.log(total + " " + Object.keys(plainNums[7]).join() + " " + Object.keys(plainStrs[7]).join() + " " + Object.keys(filledNums[7]).join() + " " + Object.keys(filledStrs[7]).join());
console.log(JSON.stringify(plainNums[7]) + " " + JSON.stringify(filledStrs[7]) + " " + (plainNums[7] instanceof Plain) + " " + (filledStrs[7] instanceof Filled));
//// a-constructor-function-that-is-also-called-on-other-objects.js
// A plain constructor function that somebody also CALLS, with an object of another kind as `this`. What `new` makes still has both fields from its birth on.
function Point(x, y) {
  this.x = x;
  this.y = y;
}
function sum(points) {
  let total = 0;
  for (const point of points) total += point.x + point.y;
  return total;
}
const points = [];
for (let i = 0; i < 4; i++) points.push(new Point(i, i * 2));
const other = { name: "other" };
[5, 6].forEach(Point, other);
console.log(sum(points), other.name, other.x, other.y);
const borrowed = Object.create(null);
Point.call(borrowed, 7, 8);
console.log(borrowed.x, borrowed.y, Object.keys(points[3]).join());
//// a-definition-that-throws-leaves-the-fields-defined-before-it.js
// The constructor above keeps the object and fixes one of the names that the class below declares. The definition of that name throws, and the fields that were defined before it hold undefined.
const kept = [];
class Above {
  constructor() {
    kept.push(this);
    Object.defineProperty(this, "fixed", { value: "fixed" });
  }
}
class Numbers extends Above {
  count;
  ratio;
  fixed;
  constructor(v) {
    super();
    this.count = v;
    this.ratio = 0.5;
    this.fixed = "s";
  }
}
class Others extends Above {
  ready;
  name;
  #hidden;
  fixed;
  constructor(v) {
    super();
    this.ready = true;
    this.name = "n";
    this.#hidden = v;
    this.fixed = "s";
  }
  static hiddenOf(o) {
    return #hidden in o ? String(o.#hidden) : "no such name";
  }
}
class Whole extends Above {
  count;
  constructor(v) {
    super();
    this.count = v;
  }
}
console.log(new Whole(5).count);
for (const C of [Numbers, Others]) {
  try {
    new C(1);
  } catch (e) {
    console.log(e.constructor.name);
  }
  const o = kept[kept.length - 1];
  console.log(
    Object.keys(o).join(),
    JSON.stringify(o),
    String(o.count),
    String(o.ratio),
    String(o.ready),
    String(o.name),
    Others.hiddenOf(o),
  );
}
