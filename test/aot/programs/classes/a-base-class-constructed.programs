//// a-class-evaluated-again-whose-definition-creates-members.js
const EventEmitter = require("node:events");
const hidden = Symbol("hidden");
const lines = [];

function define(step, name) {
  class Made extends EventEmitter {
    stored = "nothing";
    shadowed = "field";
    first() {
      return "first" + step;
    }
    [hidden]() {
      return "hidden" + step;
    }
    second() {
      return "second" + step;
    }
    shadowed() {
      return "method" + step;
    }
    get both() {
      return "got" + step;
    }
    set both(value) {
      this.stored = value + step;
    }
    [name]() {
      return name + step;
    }
    get onlyRead() {
      return "read" + step;
    }
    *[Symbol.iterator]() {
      yield step;
      yield step + 1;
    }
    second() {
      return "second again" + step;
    }
    static [name]() {
      return "static " + name + step;
    }
    static last() {
      return "static last" + step;
    }
    10() {
      return "ten" + step;
    }
  }
  return Made;
}

function show(Made, name) {
  const made = new Made();
  made.both = "set";
  lines.push(
    [made.first(), made[hidden](), made.second(), made.both, made.stored, made[name](), made.onlyRead, [...made].join(), Made[name](), Made.last(), made[10]()].join(" | "),
  );
  lines.push([made.shadowed, Made.prototype.shadowed.call(made), Object.keys(made).join()].join(" | "));
  lines.push(Reflect.ownKeys(Made.prototype).map(String).join());
  lines.push(Reflect.ownKeys(Made).map(String).join());
  const descriptor = Object.getOwnPropertyDescriptor(Made.prototype, "both");
  lines.push([typeof descriptor.get, typeof descriptor.set, descriptor.enumerable, descriptor.configurable].join());
  const method = Object.getOwnPropertyDescriptor(Made.prototype, "second");
  lines.push([typeof method.value, method.writable, method.enumerable, method.configurable].join());
}

const One = define(1, "computed");
show(One, "computed");
const Two = define(2, "first");
show(Two, "first");
show(One, "computed");

////= lines-5	One	second	"replaced"
////= lines-5	One	added	"added"
delete One.prototype.first;
const Three = define(3, "computed");
show(Three, "computed");
lines.push([new One().second(), new One().added(), typeof new One().first, typeof new Three().added, new Two().second()].join(" | "));
lines.push(String(One.prototype === Three.prototype), String(Object.getPrototypeOf(One.prototype) === EventEmitter.prototype));

let sum = 0;
for (let round = 0; round < 300; round++) {
  const Made = define(round, round & 1 ? "odd" : "even");
  const made = new Made();
  sum += made.second().length + made[round & 1 ? "odd" : "even"]().length + [...made].length;
}
lines.push(String(sum));

function throwing() {
  try {
    class Broken extends EventEmitter {
      before() {}
      [(() => {
        throw new Error("no key");
      })()]() {}
      after() {}
    }
    return Broken;
  } catch (error) {
    return error.message;
  }
}
lines.push(throwing(), throwing());
console.log(lines.join("\n"));
//// a-class-extends-null.js
// Above a class that extends null lies Function.prototype, which is no constructor: super() throws a TypeError. Nothing lies above its prototype object. A constructor that answers an object of its own works.
function said(f) { try { return f(); } catch (e) { return e.constructor.name; } }
class Implicit extends null {}
class Explicit extends null { constructor() { super(); } }
class Answers extends null { constructor() { return Object.create(new.target.prototype); } hello() { return "hello"; } static made() { return new Answers(); } }
class Below extends Answers { more() { return this.hello() + " more"; } }
console.log(said(() => new Implicit()), said(() => new Explicit()), said(() => new Answers().hello()), said(() => Answers.made().hello()), said(() => new Below().more()));
console.log(Object.getPrototypeOf(Implicit) === Function.prototype, Object.getPrototypeOf(Implicit.prototype), Object.getPrototypeOf(Below) === Answers, typeof Implicit.call, said(() => Implicit.name));
for (const base of [null, Object, Answers]) {
  class Chosen extends base { constructor() { if (base === null) return Object.create(new.target.prototype); super(); } which() { return base === null ? "null" : base.name; } }
  console.log(said(() => new Chosen().which()), Object.getPrototypeOf(Chosen) === (base ?? Function.prototype));
}
