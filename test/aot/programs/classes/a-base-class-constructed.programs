const EmitterClass = Emitter as unknown as new () => { listeners: number };
class Below extends EmitterClass {
  a: number;
  b: number;
  constructor(n: number) {
    super();
    this.a = n;
    this.b = n + 1;
  }
}
const closed: any = Object.preventExtensions({ a: 1 });
function AnswersClosed(this: any) {
  return closed;
