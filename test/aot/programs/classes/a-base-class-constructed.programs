console.log(lines.join("\n"));
//// fields-created-under-conditions-keep-their-order.ts
// A constructor hands `this` to code nobody has seen before its first store, so no order of its fields is known at the build; each class of the chain creates some fields only under a condition.
// Every store that creates a field then finds another list of keys in front of it from one object to the next. The keys of each object come out in the sequence in which that object got them.
const seen: any[] = [];
const note: any = (globalThis as any).noteForThisTest ?? ((object: any) => { if (seen.length < 4) seen.push(object); });

class Base {
  declare id: number;
  declare label?: string;
  declare count?: number;
  declare tail: boolean;
  constructor(kind: number) {
    note(this);
    this.id = kind;
    if (kind & 1) this.label = "label" + kind;
    if (kind & 2) this.count = kind * 10;
    this.tail = true;
  }
}

class Middle extends Base {
  declare first?: object | null;
  declare second: string;
  declare third?: number;
  constructor(kind: number) {
    super(kind);
    if (kind & 4) this.first = null;
    this.second = "s";
    if (kind & 8) this.third = 3;
    if (kind & 16) this.second = "again";
  }
}

class Leaf extends Middle {
  declare a: number;
  declare b?: number;
  declare c: number;
  constructor(kind: number) {
    super(kind);
    this.a = 1;
    if (kind & 32) this.b = 2;
    this.c = 3;
    if (kind & 64) this.label = "late";
    if (kind & 128) this.count = -1;
  }
}

function describe(object: object) {
  return Object.keys(object).join() + " | " + JSON.stringify(object);
}

const lines = new Map<string, number>();
for (let round = 0; round < 6; round++) {
  for (let kind = 0; kind < 256; kind++) {
    const line = kind + ": " + describe(new Leaf(kind));
    lines.set(line, (lines.get(line) ?? 0) + 1);
  }
}
console.log(lines.size, [...lines.values()].every(times => times === 6));
for (const kind of [0, 1, 2, 3, 4, 12, 21, 32, 63, 64, 65, 128, 130, 192, 255]) console.log(describe(new Leaf(kind)));

for (let turn = 0; turn < 2000; turn++) new Leaf(37);
console.log(describe(new Leaf(37)), describe(new Leaf(36)), describe(new Leaf(37)));

function fillLate(object: any, kind: number) {
  if (kind & 1) object.extraOne = 1;
  object.extraTwo = 2;
  if (kind & 2) object.b = 20;
  object.extraTwo = 22;
  if (kind & 4) delete object.a;
  object.a = 100;
  return object;
}
for (let kind = 0; kind < 8; kind++) console.log(kind, describe(fillLate(new Leaf(kind * 5), kind)), describe(fillLate(new Middle(kind * 3), kind)));

const closed: string[] = [];
for (const close of [Object.preventExtensions, Object.seal, Object.freeze]) {
  const hold: any = (object: any) => { close(object); };
  (globalThis as any).noteForThisTest = hold;
  class Closed {
    declare x: number;
    constructor() {
      hold(this);
      this.x = 1;
    }
  }
  try {
    closed.push(describe(new Closed()));
  } catch (error) {
    closed.push((error as Error).constructor.name);
  }
}
console.log(closed.join(" . "));
console.log(seen.length, seen.map(object => Object.keys(object).length).join());
//// fields-defined-on-what-super-hands-back.js
// Public fields are defined, not stored: on whatever super() hands back, past setters, over accessors, and they throw where the object refuses.
function attempt(run) { try { return run(); } catch (error) { return error.constructor.name; } }
const log = [];
class Hand { constructor(object) { return object; } }
class Fields extends Hand { first = log.push("first") && 1; second = log.push("second") && 2; ["comp" + "uted"] = 3; 0 = "zero"; length = "length"; }
const withSetter = { set first(value) { log.push("setter ran"); }, get second() { return "getter"; } };
console.log(attempt(() => JSON.stringify(new Fields(withSetter))), JSON.stringify(Object.getOwnPropertyDescriptor(withSetter, "first")), log.join());
log.length = 0;
console.log(attempt(() => JSON.stringify(new Fields([9, 8, 7]))), log.join());
log.length = 0;
const callable = function f(a, b) {};
console.log(attempt(() => new Fields(callable).length), callable.first, callable[0], log.join());
log.length = 0;
const fixed = Object.defineProperty({}, "second", { value: "fixed", configurable: false, writable: false });
console.log(attempt(() => new Fields(fixed)), JSON.stringify(fixed), fixed.second, log.join());
log.length = 0;
const traps = [];
const proxy = new Proxy({}, { defineProperty(target, key, descriptor) { traps.push(String(key) + "=" + descriptor.value + (descriptor.writable && descriptor.enumerable && descriptor.configurable ? "" : "?")); return Reflect.defineProperty(target, key, descriptor); }, set() { traps.push("set"); return true; } });
new Fields(proxy);
console.log(traps.join(), JSON.stringify(proxy));
const refusing = new Proxy({}, { defineProperty(target, key) { return key !== "second"; } });
console.log(attempt(() => new Fields(refusing)), log.join());
log.length = 0;
console.log(attempt(() => new Fields(new Uint8Array(2))[0]), attempt(() => new Fields("text".split(""))), attempt(() => Object.keys(new Fields(Object("ab"))).join()));
// The same object goes through twice: a definition over a field that is there is fine.
const again = {};
new Fields(again); again.first = "changed"; new Fields(again);
console.log(JSON.stringify(again));
// The prototype of what is handed back is not that of the class.
console.log(new Fields({}) instanceof Fields, Object.getPrototypeOf(new Fields({})) === Object.prototype, new Fields(Object.create(Fields.prototype)) instanceof Fields);
//// instanceof-of-a-function-that-keeps-its-prototype-object.js
// `this instanceof F` and `x instanceof F` where F is a function that is constructed with and nothing replaces F.prototype.
var out = [];
function say() { out.push(Array.prototype.map.call(arguments, String).join(" ")); }

// Callable with and without `new`.
function V(x) {
  if (!(this instanceof V)) return new V(x);
  this.x = x;
}
V.prototype.get = function () { return this.x + 1; };
function both(n) { var s = 0; for (var i = 0; i < n; i++) s += V(i & 7).get() + new V(i & 3).get(); return s; }
say(both(50), V(1) instanceof V, new V(1) instanceof V, V.call(undefined, 2).x, V.call(null, 3).x, V.call(5, 4).x, V.call({}, 5).x);

// `this` is an object of the function already: the call stores into it and returns nothing.
var given = new V(1);
say(V.call(given, 9), given.x);

// `this` inherits from the prototype object without having been constructed.
var created = Object.create(V.prototype);
say(V.call(created, 6), created.x, created instanceof V, created.get());

// An object of the function that gets another prototype.
function isV(o) { return o instanceof V; }
var moved = new V(2);
say(isV(moved), isV({}), isV(null), isV(undefined), isV(3), isV("text"), isV(V), isV(V.prototype));
Object.setPrototypeOf(moved, null);
say(isV(moved), isV(new V(3)));
var movedBack = new V(4);
Object.setPrototypeOf(movedBack, { __proto__: V.prototype });
say(isV(movedBack));
var viaProto = new V(5);
viaProto.__proto__ = Array.prototype;
say(isV(viaProto), viaProto instanceof Array);
say(V.call(moved, 8) instanceof V, moved.x);

// Another new.target.
function Other() {}
Other.prototype.who = "other";
var reflected = Reflect.construct(V, [7], Other);
say(isV(reflected), reflected instanceof Other, reflected.x, JSON.stringify(reflected), reflected.who);
class Below extends V { constructor(x) { super(x); this.below = true; } }
var below = new Below(8);
say(isV(below), below instanceof Below, below.x, below.get(), below.below);

// One text, several functions.
function make() {
  function Made(x) { if (!(this instanceof Made)) return new Made(x); this.x = x; }
  Made.is = function (o) { return o instanceof Made; };
  return Made;
}
var First = make(), Second = make();
say(First.is(First(1)), First.is(Second(1)), Second.is(First(1)), Second.is(new Second(1)), First(1) instanceof Second, First(2).x);

// The function answers for itself.
function Judged() {}
Object.defineProperty(Judged, Symbol.hasInstance, { value: function (o) { return o === 1; } });
say(new Judged() instanceof Judged, 1 instanceof Judged);

// A bound function.
var BoundV = V.bind(null);
say(new V(1) instanceof BoundV, new BoundV(2) instanceof V, BoundV(3) instanceof V);

// Above: a link that changes.
function Base() {}
function Mid() {}
Object.setPrototypeOf(Mid.prototype, Base.prototype);
function isBase(o) { return o instanceof Base; }
var mid = new Mid();
say(isBase(mid), isBase(new Base()), mid instanceof Mid);
Object.setPrototypeOf(Mid.prototype, Object.prototype);
say(isBase(mid), isBase(new Mid()), mid instanceof Mid);

// The property is replaced by a definition, and by a store that comes late.
function Redefined() {}
var early = new Redefined();
function isRedefined(o) { return o instanceof Redefined; }
say(isRedefined(early));
Object.defineProperty(Redefined, "prototype", { value: { late: true } });
say(isRedefined(early), isRedefined(new Redefined()), new Redefined().late);
function Stored() {}
var earlyStored = new Stored();
function isStored(o) { return o instanceof Stored; }
say(isStored(earlyStored));
Stored.prototype = { late: 1 };
say(isStored(earlyStored), isStored(new Stored()));
function ByKey() {}
var earlyByKey = new ByKey();
function isByKey(o) { return o instanceof ByKey; }
var key = ["proto", "type"].join("");
say(isByKey(earlyByKey));
ByKey[key] = { late: 2 };
say(isByKey(earlyByKey), isByKey(new ByKey()));
function NotAnObject() {}
NotAnObject.prototype = 5;
try { say({} instanceof NotAnObject); } catch (error) { say(error instanceof TypeError); }
say(Object.getPrototypeOf(new NotAnObject()) === Object.prototype);

// The check that compilers write in front of a class's body.
function check(instance, Constructor) { if (!(instance instanceof Constructor)) throw new TypeError("Cannot call a class as a function"); }
function Checked(x) { check(this, Checked); this.x = x; }
say(new Checked(1).x);
try { Checked(2); } catch (error) { say(error.message); }
try { Checked.call({}, 2); } catch (error) { say(error.message); }
say(Checked.call(new Checked(3), 4));

// The object gets another prototype between its birth and the test.
function Shifty(to) { Object.setPrototypeOf(this, to); this.was = this instanceof Shifty; }
say(new Shifty(null).was, new Shifty(Shifty.prototype).was, new Shifty({ __proto__: Shifty.prototype }).was, new Shifty(Array.prototype).was);
function ShiftyByName(to) { this.__proto__ = to; this.was = this instanceof ShiftyByName; }
say(new ShiftyByName(Object.prototype).was, new ShiftyByName(ShiftyByName.prototype).was);
function Handed(shift) { shift(this); check(this, Handed); this.ok = true; }
say(new Handed(function () {}).ok);
try { new Handed(function (o) { Object.setPrototypeOf(o, Object.prototype); }); } catch (error) { say(error.message); }

// A function is given the prototype object of another one, which keeps it: what either makes is an instance of both, whichever is constructed first.
function Lender(x) { this.x = x; }
function Taker(y) { this.y = y; }
Taker.prototype = Lender.prototype;
function isLender(o) { return o instanceof Lender; }
function isTaker(o) { return o instanceof Taker; }
var takenFirst = new Taker(1), lentSecond = new Lender(2);
say(isLender(takenFirst), isTaker(takenFirst), isLender(lentSecond), isTaker(lentSecond), isTaker({}), isLender({}));
function LenderFirst(x) { this.x = x; }
function TakerSecond(y) { this.y = y; }
var holders = { one: TakerSecond };
holders.one[["proto", "type"].join("")] = LenderFirst.prototype;
var lentFirst = new LenderFirst(1), takenSecond = new TakerSecond(2);
say(lentFirst instanceof TakerSecond, takenSecond instanceof LenderFirst, lentFirst instanceof LenderFirst, takenSecond instanceof TakerSecond);
function LenderNeverMade() {}
function TakerAlone() {}
TakerAlone.prototype = LenderNeverMade.prototype;
say(new TakerAlone() instanceof LenderNeverMade, new TakerAlone() instanceof TakerAlone, Object.create(LenderNeverMade.prototype) instanceof TakerAlone);

console.log(out.join("\n"));
//// lazy-fields-of-escaped-instances.js
const suffix = process.argv.length > 99 ? ";" : "";
let calls = 0;
const count = () => ++calls;
const opaque = new Function("count", "return function (value) { count(); return value; }" + suffix)(count);

class Settings {
  constructor(given) {
    this.id = 1;
    this.log = [];
    this.configure = next => {
      const before = this.options;
      this.options = next;
      this.strict = next.strict ?? true;
      if (!this.origin) this.origin = "local";
      const base = next.base ?? "/";
      if (this.base !== base || before?.strict !== next.strict) {
        this.base = base;
        this.prefix = base === "/" ? undefined : base;
      }
      if (!this.history) this.history = [base];
      return before;
    };
    if (given) this.configure(given);
  }
  reset(next) {
    const before = this.cache;
    this.cache = next;
    if (!this.owner) this.owner = "nobody";
    this.stamp = before === undefined ? "first" : "again";
    this.flag = "reset";
    this.label = 7;
    return before;
  }
  merge(next) {
    const before = this.merged;
    opaque(before);
    this.merged = { ...before, ...next };
    opaque(next);
    this.mode = next.mode ?? "plain";
    opaque(next);
    const seen = this.target;
    opaque(seen);
    this.target = next.target;
    opaque(next);
    const limit = this.limit;
    opaque(limit);
    this.limit = next.limit;
    opaque(next);
    this.flag = true;
    opaque(next);
    this.label = "merged";
    opaque(next);
    return [before === undefined ? "none" : Object.keys(before).join(), String(seen), String(limit)].join("/");
  }
}
class Derived extends Settings {
  constructor(given) {
    super(given);
    this.extra = "derived";
  }
}

const evaluate = text => new Function("o", "Settings", "Derived", text + suffix);

function describe(o) {
  const own = Object.getOwnPropertyNames(o)
    .filter(name => name !== "configure" && name !== "log")
    .map(name => {
      const d = Object.getOwnPropertyDescriptor(o, name);
      const flags = (d.writable ? "w" : "-") + (d.enumerable ? "e" : "-") + (d.configurable ? "c" : "-");
      return name + ":" + ("value" in d ? JSON.stringify(d.value) : "accessor") + ":" + flags;
    });
  return own.join(" ") + " | log " + o.log.join(",");
}

function attempt(label, make, text, after) {
  const o = make();
  evaluate(text)(o, Settings, Derived);
  const lines = [];
  for (const step of [() => o.merge({ mode: "m", target: "t" }), () => o.configure({ strict: false, base: "/app" }), () => o.reset("one"), () => o.merge({ limit: 3 }), () => o.configure({ base: "/" }), () => o.reset("two")]) {
    try {
      lines.push(JSON.stringify(step()) ?? "undefined");
    } catch (error) {
      lines.push("threw " + error.constructor.name);
    }
  }
  console.log(label, "|", lines.join(" "), "|", describe(o), "| reads", String(o.origin), String(o.base), String(o.owner), String(o.cache), String(o.mode), String(o.target), String(o.limit), calls);
  if (after) evaluate(after)(o, Settings, Derived);
}

const makers = {
  empty: () => new Settings(),
  filled: () => new Settings({ strict: true }),
  derived: () => new Derived(),
  "derived filled": () => new Derived({ base: "/d" }),
  "other new.target": () => Reflect.construct(Settings, [], class Other {}),
};

for (const [name, make] of Object.entries(makers)) {
  attempt(name + ", untouched", make, "");
  attempt(name + ", frozen", make, "Object.freeze(o)");
  attempt(name + ", sealed", make, "Object.seal(o)");
  attempt(name + ", not extensible", make, "Object.preventExtensions(o)");
  attempt(name + ", fields deleted", make, "delete o.options; delete o.origin; delete o.base; delete o.id; delete o.merged; delete o.mode");
  attempt(name + ", extra properties first", make, "o.zebra = 1; o.apple = 2");
  attempt(name + ", an index first", make, "o[3] = 'three'; o[1] = 'one'");
  attempt(name + ", a symbol first", make, "o[Symbol.for('s')] = 1");
  attempt(name + ", own accessor", make, "for (const k of ['origin', 'mode', 'target']) Object.defineProperty(o, k, { get() { return 'own getter'; }, set(v) { this.log.push('own setter ' + k + ' ' + v); }, configurable: true, enumerable: true })");
  attempt(name + ", own read-only", make, "for (const k of ['cache', 'mode', 'limit']) Object.defineProperty(o, k, { value: 'fixed', writable: false, configurable: true })");
  attempt(name + ", own hidden", make, "Object.defineProperty(o, 'owner', { value: '', writable: true, enumerable: false, configurable: true })");
  attempt(name + ", own undefined", make, "o.origin = undefined; o.options = undefined; o.cache = undefined; o.merged = undefined; o.target = undefined");
  attempt(name + ", another prototype", make, "Object.setPrototypeOf(o, { reset: Settings.prototype.reset, merge: Settings.prototype.merge, get origin() { return 'inherited'; }, set origin(v) { this.log.push('inherited setter ' + v); }, owner: 'from above', get target() { return 'target above'; }, set target(v) { this.log.push('target setter ' + v); }, limit: 'limit above', merged: { from: 'above' } })");
  attempt(name + ", no prototype", make, "Object.setPrototypeOf(o, null); o.reset = Settings.prototype.reset; o.merge = Settings.prototype.merge");
  attempt(name + ", read-only above", make, "Object.setPrototypeOf(o, Object.create(Settings.prototype, { cache: { value: 'above', writable: false }, mode: { value: 'mode above', writable: false }, target: { value: 'target above', writable: false } }))");
  attempt(
    name + ", a proxy above",
    make,
    "Object.setPrototypeOf(o, new Proxy(Settings.prototype, { set(t, k, v, r) { r.log.push('trap set ' + String(k)); return Reflect.set(t, k, v, r); }, get(t, k, r) { return k === 'owner' || k === 'target' || k === 'limit' ? 'from the trap' : Reflect.get(t, k, r); } }))",
  );
}

for (const [name, make] of Object.entries(makers)) {
  attempt(
    name + ", a setter on the class",
    make,
    "for (const k of ['origin', 'mode', 'target']) Object.defineProperty(Settings.prototype, k, { get() { return k === 'target' ? 'class getter' : undefined; }, set(v) { this.log.push('class setter ' + k + ' ' + v); }, configurable: true })",
    "delete Settings.prototype.origin; delete Settings.prototype.mode; delete Settings.prototype.target",
  );
  attempt(name + ", after the setter is gone", make, "");
  attempt(name + ", a value on the class", make, "Settings.prototype.owner = 'class value'; Settings.prototype.history = 0; Settings.prototype.target = 'class target'; Settings.prototype.limit = 9; Settings.prototype.merged = { from: 'class' }", "delete Settings.prototype.owner; delete Settings.prototype.history; delete Settings.prototype.target; delete Settings.prototype.limit; delete Settings.prototype.merged");
  attempt(name + ", read-only on the class", make, "for (const k of ['cache', 'mode', 'limit']) Object.defineProperty(Settings.prototype, k, { value: 'class fixed', writable: false, configurable: true })", "delete Settings.prototype.cache; delete Settings.prototype.mode; delete Settings.prototype.limit");
  attempt(name + ", a setter on the class below", make, "for (const k of ['stamp', 'mode', 'limit']) Object.defineProperty(Derived.prototype, k, { get() { return 'derived getter'; }, set(v) { this.log.push('derived setter ' + k + ' ' + v); }, configurable: true })", "delete Derived.prototype.stamp; delete Derived.prototype.mode; delete Derived.prototype.limit");
  attempt(name + ", the class chain is cut", make, "Object.setPrototypeOf(Derived.prototype, { reset: Settings.prototype.reset, merge: Settings.prototype.merge, set owner(v) { this.log.push('new base setter ' + v); }, get target() { return 'new base getter'; }, set target(v) { this.log.push('new base setter target ' + v); } })", "Object.setPrototypeOf(Derived.prototype, Settings.prototype)");
  attempt(name + ", all as at first", make, "");
}

const orders = [];
for (let turn = 0; turn < 6; turn++) {
  const o = turn % 2 ? new Derived() : new Settings();
  if (turn % 3 === 0) o.reset("r");
  if (turn % 2 === 0) o.merge({ target: turn });
  o.configure({ base: turn % 2 ? "/" : "/x" });
  if (turn % 3 === 1) o.reset("r");
  if (turn === 4) delete o.origin;
  o.configure({ strict: turn > 2 });
  o.reset("s");
  o.merge({ mode: "late" });
  orders.push(Object.keys(o).join());
  let listed = "";
  for (const key in o) listed += key[0];
  orders.push(listed + " " + JSON.stringify({ ...o, configure: 0 }).length);
}
console.log(orders.join("\n"));

let total = 0;
for (let turn = 0; turn < 20000; turn++) {
  const o = turn % 7 ? new Settings({ base: "/" }) : new Derived({ strict: false });
  o.configure({ base: turn % 5 ? "/a" : "/" });
  o.reset(turn);
  o.merge({ limit: turn % 3 });
  if (turn % 4 === 0) o.merge({ target: turn });
  total += Object.keys(o.merged).length + (o.target === undefined ? 1 : 2) + o.base.length + o.history.length + (o.prefix === undefined ? 1 : 2) + Object.keys(o).length + (o.reset(0) === turn ? 1 : 100);
}
console.log(total);
//// lists-of-every-length-are-spread-into-super-and-into-a-class-without-a-constructor.js
// `super(...list)`, `new Below(...list)` and Reflect.construct(Below, list) with lists of 2 to 2,000,000 elements: whether the construction goes through or the list is too long to pass is what it is in plain Bun.
// The greatest length that passes follows from the room on the stack, and a constructor that passes its arguments on takes that room once more: no size here is near it.
class A { constructor(a, b) { this.a = a; this.b = b; } }
class B extends A { constructor(xs) { super(...xs); this.n = xs.length; } }
class C extends A { x = 1; }
const kept = [];
for (const size of [2, 1000, 65535, 65536, 70000, 100000, 2000000]) {
  const xs = new Array(size).fill(7);
  for (const make of [() => new B(xs), () => new C(...xs), () => Reflect.construct(C, xs)]) {
    try {
      const made = make();
      kept.push(made);
      console.log(size, made.a, made.b, made.constructor.name);
    } catch (error) {
      console.log(size, error.name);
    }
  }
}
//// members-above-a-deleted-field-answer.js
// A field that shadows a member of a class above is deleted: from then on the member above answers.
const lines = [];
const note = (what, action) => { try { lines.push(what + ": " + action()); } catch (error) { lines.push(what + ": " + error.name + " " + error.message); } };

class Above {
  get g() { return "the getter above"; }
  set s(value) { lines.push("the setter above got " + value); }
  m() { return "the method above"; }
  get both() { return "both, read"; }
  set both(value) { lines.push("both got " + value); }
}
Object.defineProperty(Above.prototype, "fixed", { value: "fixed above", writable: false, configurable: true });
Above.prototype.plain = "plain above";

class Below extends Above { g = 1; s = 2; m = 3; both = 4; fixed = 5; plain = 6; }

function reads(o) { return [o.g, o.s, typeof o.m === "function" ? o.m() : o.m, o.both, o.fixed, o.plain].join(" | "); }
function stores(o, value) {
  "use strict";
  for (const store of [() => { o.g = value; }, () => { o.s = value; }, () => { o.m = value; }, () => { o.both = value; }, () => { o.fixed = value; }, () => { o.plain = value; }])
    note("store", () => { store(); return "done"; });
}
function removeAll(o) { delete o.g; delete o.s; delete o.m; delete o.both; delete o.fixed; delete o.plain; }

function round() {
  const o = new Below;
  note("born", () => reads(o));
  stores(o, 10);
  note("stored", () => reads(o));
  removeAll(o);
  note("deleted", () => reads(o));
  stores(o, 20);
  note("stored behind the delete", () => reads(o));
  note("own", () => ["g", "s", "m", "both", "fixed", "plain"].map(name => Object.hasOwn(o, name)).join());
  removeAll(o);
  note("spread defines", () => { const copy = { ...o }; return Object.keys(copy).join(); });
  note("assign from a literal", () => { Object.assign(o, { plain: 30, m: 31 }); return reads(o); });
  note("assign that meets the setter", () => { Object.assign(o, { s: 32, both: 33 }); return reads(o); });
  note("assign that meets the getter alone", () => { Object.assign(o, { g: 34 }); return reads(o); });
  note("assign that meets the read-only one", () => { Object.assign(o, { fixed: 35 }); return reads(o); });
}
for (let turn = 0; turn < 60; turn++) {
  if (turn && turn < 59)
    lines.length = 0;
  round();
}
console.log(lines.join("\n"));
//// members-above-a-deleted-field-that-nobody-reads.js
// As members-above-a-deleted-field-answer.js, but nothing reads the fields or asks for the keys: only what the members above do shows.
const lines = [];
class Above {
  set s(value) { lines.push("s got " + value); }
  set t(value) { lines.push("t got " + value); }
}
class Below extends Above { s = 1; t = 2; u = 3; }
function viaAssign(o, value) { Object.assign(o, { s: value, t: value, u: value }); }
function viaStores(o, value) { o.s = value; o.t = value; o.u = value; }
function viaReflect(o, value) { Reflect.set(o, "s", value); Reflect.set(o, "t", value); Reflect.set(o, "u", value); }
function viaComputed(o, value) { for (const name of ["s", "t", "u"]) o[name] = value; }
function viaEntries(o, value) { for (const [name, v] of Object.entries({ s: value, t: value, u: value })) o[name] = v; }
const ways = [viaAssign, viaStores, viaReflect, viaComputed, viaEntries];
function round(first, second) {
  const o = new Below;
  first(o, 1);
  delete o.s;
  second(o, 2);
  delete o.t;
  first(o, 3);
  second(o, 4);
}
for (let turn = 0; turn < 30; turn++) {
  if (turn && turn < 29)
    lines.length = 0;
  for (const first of ways) {
    for (const second of ways) {
      lines.push(first.name + " " + second.name);
      round(first, second);
    }
  }
}
console.log(lines.join("\n"));
//// members-defined-while-nobody-can-see-the-class.js
const lines = [];
const note = (...parts) => lines.push(parts.map(String).join(" | "));
const keysOf = object => Reflect.ownKeys(object).map(String).join();

// The methods take variables of the function around the class, so the definition makes them one after the other.
function define(step, extra) {
  const offset = step * 10;
  let calls = 0;
  const watched = [];
  class Base {
    first() { calls++; return "first" + offset; }
    second() { return this.first() + "/second" + offset; }
    get both() { return "got" + offset; }
    third() { return "third" + calls; }
    set both(value) { watched.push(value + offset); }
    first() { calls++; return "first again" + offset; }
    static make() { return new this(); }
    static get count() { return calls; }
    static first() { return "static first" + offset; }
    [extra]() { return extra + offset; }
    last() { return watched.join("+"); }
  }
  return Base;
}

function use(Class, extra, rounds) {
  const made = Class.make();
  let out = "";
  for (let i = 0; i < rounds; i++) out = [made.first(), made.second(), typeof made.both === "function" ? "a function" : made.both, made.third(), made[extra](), Class.first(), Class.count].join();
  made.both = "stored";
  return out + " " + made.last();
}

const classes = [define(1, "added"), define(2, "first"), define(3, "constructor"), define(4, "both")];
["added", "first", "constructor", "both"].forEach((extra, index) => {
  const Class = classes[index];
  note(keysOf(Class.prototype), keysOf(Class));
  try { note(use(Class, extra, 5)); } catch (error) { note("threw", error.constructor.name, error.message); }
});
note(classes[0].prototype.first === classes[1].prototype.first, classes[0].prototype.constructor === classes[0]);

// What the keys of a definition can do while it runs: the class has no name yet, and what is above it can change.
function Above() {}
Above.prototype.inherited = function () { return "from above"; };
Above.prototype.hidden = function () { return "hidden above"; };
const order = [];
let early;
class Watched extends Above {
  [(order.push("one"), "one")]() { return 1; }
  [(() => { try { return Watched.name; } catch (error) { order.push(error.constructor.name); return "two"; } })()]() { return 2; }
  [(Above.prototype.inherited = function () { return "changed during the definition"; }, "three")]() { return this.inherited(); }
  [(early = Object.create(Above.prototype), "hidden")]() { return "hidden below"; }
  static [(order.push("static"), "four")]() { return 4; }
  get [(order.push("getter"), "five")]() { return 5; }
}
const watched = new Watched();
note(order.join(), keysOf(Watched.prototype), keysOf(Watched));
note(watched.one(), watched.two(), watched.three(), watched.hidden(), early.hidden(), Watched.four(), watched.five);

// A key that throws leaves nothing behind, and the next evaluation starts over.
function defineOrThrow(fails) {
  const tag = fails ? "failed" : "whole";
  return class Half {
    before() { return "before " + tag; }
    [fails ? (() => { throw new RangeError("key"); })() : "middle"]() { return "middle " + tag; }
    after() { return "after " + tag; }
  };
}
for (const fails of [true, false, true, false]) {
  try { const Half = defineOrThrow(fails); const half = new Half(); note(half.before(), half.middle(), half.after(), keysOf(Half.prototype)); } catch (error) { note("threw", error.message); }
}

// Calls that rest on the members as they were defined see every change that comes later.
function family(seed) {
  class Root {
    value() { return "root" + seed; }
    twice() { return this.value() + this.value(); }
    get read() { return "read" + seed; }
    static kind() { return "Root" + seed; }
  }
  class Middle extends Root {
    other() { return "other" + seed; }
  }
  class Leaf extends Middle {
    leaf() { return this.twice() + this.read + seed; }
    static which() { return this.kind(); }
  }
  return { Root, Middle, Leaf };
}
const { Root, Middle, Leaf } = family(7);
const leaf = new Leaf();
const changes = [
  () => {},
  () => { Root.prototype.value = function () { return "replaced"; }; },
  () => { Middle.prototype.value = function () { return "hides"; }; },
  () => { delete Middle.prototype.value; },
  () => { Object.defineProperty(Root.prototype, "read", { get() { return "other getter"; }, configurable: true }); },
  () => { Object.defineProperty(Leaf.prototype, "read", { value: "a value", configurable: true }); },
  () => { Root.kind = () => "replaced kind"; },
  () => { Middle.kind = () => "middle kind"; },
  () => { Object.setPrototypeOf(Leaf, Root); },
  () => { Object.setPrototypeOf(Leaf.prototype, Root.prototype); },
  () => { Object.setPrototypeOf(Middle.prototype, { value() { return "elsewhere"; }, twice() { return "twice elsewhere"; } }); Object.setPrototypeOf(Leaf.prototype, Middle.prototype); },
  () => { leaf.twice = () => "own"; },
  () => { delete Root.prototype.twice; delete leaf.twice; },
];
for (const change of changes) {
  change();
  let out = "";
  for (let i = 0; i < 4; i++) { try { out = leaf.leaf() + " " + Leaf.which(); } catch (error) { out = "threw " + error.constructor.name; } }
  note(out);
}

// One side of a class is looked at, then the other side is changed.
function sides(seed) {
  return class Sides {
    method() { return "method" + seed; }
    run() { return this.method(); }
    static method() { return "static" + seed; }
    static run() { return this.method(); }
  };
}
for (const look of [C => Reflect.ownKeys(C.prototype), C => Reflect.ownKeys(C), C => Object.getOwnPropertyDescriptors(C.prototype), C => Object.keys(C), C => C.prototype.method.name, C => C.method.name]) {
  const Sides = sides(lines.length);
  const one = new Sides();
  let out = "";
  for (let i = 0; i < 3; i++) out = one.run() + Sides.run();
  look(Sides);
  for (let i = 0; i < 3; i++) out += one.run() + Sides.run();
  Sides.method = () => "new static";
  for (let i = 0; i < 3; i++) out = out + "," + one.run() + Sides.run();
  Sides.prototype.method = () => "new method";
  for (let i = 0; i < 3; i++) out = out + "," + one.run() + Sides.run();
  note(out);
}

// A static method and a static field of one name, either way round.
class MethodThenField { static same() { return "method"; } static same = "field"; static read() { return typeof this.same; } }
class FieldThenMethod { static same = "field"; static same() { return "method"; } static read() { return typeof this.same; } }
for (let i = 0; i < 3; i++) note(MethodThenField.read(), FieldThenMethod.read(), keysOf(MethodThenField), keysOf(FieldThenMethod));

console.log(lines.join("\n"));
//// members-of-a-base-change-before-its-heirs-are-defined.js
function show(label, constructors) {
  console.log(label);
  for (const constructor of constructors) {
    const object = new constructor();
    console.log(" ", constructor.name, object.a(), object.b(), object.c(), object.d(), object.v, object.w);
  }
}
class Base {
  a() { return "Base.a"; }
  b() { return "Base.b"; }
  c() { return "Base.c"; }
  d() { return "Base.d"; }
}
Base.prototype.a = function () { return "early a"; };
Base.prototype.b = function () { return "early b"; };
Base.prototype.c = function () { return "early c"; };
const seen = [];
Object.defineProperty(Base.prototype, "v", { set(value) { seen.push("v=" + value); }, get() { return "got v"; }, configurable: true });
Object.defineProperty(Base.prototype, "w", { set(value) { seen.push("w=" + value); }, get() { return "got w"; }, configurable: true });
class First extends Base {
  constructor() {
    super();
    this.v = 1;
    this.w = 2;
  }
  c() { return "First.c"; }
}
class Second extends First {}
show("heirs defined behind three stores and two setters", [Base, First, Second]);
Base.prototype.d = function () { return "late d"; };
delete Base.prototype.b;
Base.prototype.b = function () { return "b again"; };
show("one more store, a deletion and a store", [Base, First, Second]);
console.log(seen.join(" "));

function Old() {}
Old.prototype.a = function () { return "Old.a"; };
Old.prototype.b = function () { return "Old.b"; };
Old.prototype.c = function () { return "Old.c"; };
Old.prototype.d = function () { return "Old.d"; };
class New extends Old {
  b() { return "New.b"; }
}
class Newer extends New {}
show("a class below a constructor function", [Old, New, Newer]);
Old.prototype.a = function () { return "Old.a 2"; };
Old.prototype.b = function () { return "Old.b 2"; };
Old.prototype.c = function () { return "Old.c 2"; };
Old.prototype.d = function () { return "Old.d 2"; };
show("all four stored again", [Old, New, Newer]);
Object.assign(Old.prototype, { a() { return "assigned a"; }, c() { return "assigned c"; } });
show("two assigned", [Old, New, Newer]);
//// names-that-built-ins-have-as-data-are-called-as-methods.js
class Reply {
  constructor(code) {
    this.code = code;
    this.sent = 0;
  }
  method(i) {
    return this.code + (i & 1);
  }
  status(i) {
    this.code = i;
    return this;
  }
  type(i) {
    return "type " + (this.code + i);
  }
  url() {
    return "/" + this.code;
  }
  size() {
    return this.sent++;
  }
  signal(i) {
    return i > 2 ? undefined : this;
  }
}
class Heir extends Reply {
  method(i) {
    return super.method(i) * 2;
  }
}
function Old(code) {
  this.code = code;
}
Old.prototype.method = function (i) {
  return this.code - i;
};
Old.prototype.status = function (i) {
  this.code += i;
  return this;
};
const record = {
  code: 5,
  method(i) {
    return this.code * i;
  },
  status(i) {
    return { code: i, method: () => "inner " + i };
  },
};
const keepsAnything = { code: 1, method: undefined, status: 200, type: "text", url: "/", size: 3 };
const below = Object.create({
  method(i) {
    return this.code + i * 100;
  },
});
below.code = 1;
const shadowed = new Reply(9);
shadowed.method = function (i) {
  return -this.code - i;
};
const withGetter = {
  code: 2,
  get method() {
    this.code++;
    return i => this.code * 10 + i;
  },
};
const proxy = new Proxy(new Reply(30), {
  get(target, name, receiver) {
    return name === "method" ? i => "proxy " + i : Reflect.get(target, name, receiver);
  },
});

function callMethod(a, n) {
  let sum = 0;
  for (let i = 0; i < n; i++) sum += a.method(i);
  return sum;
}
function callSeveral(a, n) {
  let text = "";
  for (let i = 0; i < n; i++) text += a.status(i).method(i) + " " + a.type(i) + a.url() + a.size() + (a.signal(i) === a) + ";";
  return text;
}
function readAndCall(a, n) {
  let text = "";
  for (let i = 0; i < n; i++) text += typeof a.method + (a.status === 200 ? " data " : " other ") + (typeof a.method === "function" ? a.method(i) : a.method) + ";";
  return text;
}
function callOnce(a) {
  return a.method(1);
}

const table = { callMethod, callSeveral, readAndCall, callOnce };
const hidden = ["call", "read"];
function tell(name, ...rest) {
  try {
    console.log(name, table[name](...rest));
  } catch (error) {
    console.log(name, error instanceof TypeError);
  }
}

const request = new Request("http://localhost/path", { method: "POST" });
const response = new Response("body", { status: 201 });
const receivers = [new Reply(3), new Heir(4), new Old(6), record, keepsAnything, below, shadowed, withGetter, proxy, request, response, new Blob(["ab"]), new Map(), "text", 4, null, undefined, {}, () => 1];
for (let round = 0; round < 3; round++) {
  for (const receiver of receivers) {
    tell(hidden[0] + "Method", receiver, 5);
    tell(hidden[1] + "AndCall", receiver, 3);
    tell(hidden[0] + "Once", receiver);
  }
  for (const receiver of [new Reply(1), new Heir(2), request, response, keepsAnything]) tell(hidden[0] + "Several", receiver, 4);
  if (round === 0)
    Reply.prototype.method = function (i) {
      return this.code * 1000 + i;
    };
  if (round === 1) {
    delete Reply.prototype.method;
    Object.defineProperty(Old.prototype, "method", { get: () => () => "from a getter" });
  }
}
let check = 0;
for (let i = 0; i < 20000; i++) {
  const receiver = i % 7 === 0 ? record : i % 5 === 0 ? below : i % 3 === 0 ? shadowed : new Heir(i & 3);
  try {
    check += table[hidden[0] + "Method"](receiver, 3);
  } catch (error) {
    check -= 1;
  }
}
console.log(check);
