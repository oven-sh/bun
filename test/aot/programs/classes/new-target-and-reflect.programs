attempt("Reflect.set", () => [Reflect.set(B, "reflected", 1), own(B, "reflected")].join(" "));
attempt("Reflect.set with a receiver", () => [Reflect.set(A, "received", 1, C), own(C, "received"), own(A, "received")].join(" | "));
