//// subclass-without-a-constructor-hands-its-arguments-on-in-order.js
// The constructor that the language gives a subclass is `constructor(...args) { super(...args) }`. Each argument reaches the parameter of its position: fewer arguments than parameters, more than
// the parent names, more than eight, a chain of such subclasses, and a parent with a rest parameter of its own.
class Body {
  constructor(name, position, speed) {
    this.name = name;
    this.position = position;
    this.speed = speed;
    this.count = arguments.length;
  }
  describe() {
    return this.name + ":" + this.position.x + "," + (this.speed === undefined ? "still" : this.speed.x) + "/" + this.count;
  }
}
////= lines	Ghost	Body	seen	false
class Shade extends Ghost {}
const at = x => ({ x });
console.log(new Ghost("g", at(1), at(2)).describe(), new Shade("s", at(3), at(4)).describe(), new Ghost("short", at(5)).describe(), new Shade("long", at(6), at(7), 8, 9).describe());

class Wide {
  constructor(a, b, c, d, e, f, g, h, i, j) {
    this.text = [a, b, c, d, e, f, g, h, i, j].join("");
    this.last = j;
  }
}
class Wider extends Wide {}
console.log(new Wider(1, 2, 3, 4, 5, 6, 7, 8, "nine", at(10)).text.length, new Wider(1, 2, 3, 4, 5, 6, 7, 8, 9, at(10)).last.x);

class Gathers {
  constructor(first, ...others) {
    this.first = first;
    this.others = others;
  }
}
class GathersToo extends Gathers {}
const gathered = new GathersToo(at(1), "two", 3);
console.log(gathered.first.x, gathered.others.join(), gathered.others.length);

//// super-begins-above-the-prototype-object-as-it-is-now.js
// `super.name` in a method begins to look above the prototype object of the method's class, as that object is linked at this moment, whoever the receiver is.
const box = JSON.parse(process.argv[9] ?? "[0]");
function hidden(value) { box[0] = value; return box[0]; }
const log = [];
class Base { read() { return "Base.read"; } get size() { return "Base.size"; } only() { return "Base.only"; } static make() { return "Base.make"; } }
class Middle extends Base { read() { return "Middle.read < " + super.read(); } }
class Leaf extends Middle {
  read() { return "Leaf.read < " + super.read(); }
  get size() { return "Leaf.size < " + super.size; }
  only() { return "Leaf.only < " + super.only(); }
  missing() { return "Leaf.missing < " + typeof super.nothing; }
  store(value) { super.stored = value; return Object.keys(this).join(); }
  arrow() { return (() => "arrow < " + super.read())(); }
  static make() { return "Leaf.make < " + super.make(); }
}
class Alone { static make() { return "Alone.make"; } read() { return "Alone.read < " + typeof super.read + " " + typeof super.toString; } }
class BelowNull extends null { static create() { return Object.create(BelowNull.prototype); } read() { try { return String(super.read); } catch (e) { return e.name; } } }
function Old() {}
Old.prototype.read = function () { return "Old.read"; };
class OverOld extends Old { read() { return "OverOld.read < " + super.read(); } }
function factory(tag) { return class extends Base { read() { return tag + ".read < " + super.read(); } }; }
const Made = [factory("first"), factory("second")];
function all(title) {
  const leaf = hidden(new Leaf());
  const lines = [leaf.read(), leaf.size, leaf.only(), leaf.missing(), leaf.store(1), leaf.arrow(), hidden(Leaf).make(), hidden(new Alone()).read(), hidden(BelowNull.create()).read(), hidden(new OverOld()).read(),
    hidden(new Made[0]()).read(), hidden(new Made[1]()).read(), Leaf.prototype.read.call(hidden({})), Leaf.prototype.read.call(hidden(new Alone()))];
  return title + ": " + lines.join(" | ");
}
function round(title) { let last = ""; for (let i = 0; i < 60; i++) last = all(title); log.push(last); }
round("as declared");
Object.setPrototypeOf(Leaf.prototype, Base.prototype);
round("Leaf.prototype hangs below Base.prototype");
Object.setPrototypeOf(Leaf.prototype, { read() { return "a literal's read"; }, get size() { return "a literal's size"; }, only() { return "a literal's only"; } });
round("Leaf.prototype hangs below a literal");
Object.setPrototypeOf(Leaf.prototype, null);
try { round("Leaf.prototype hangs below nothing"); } catch (e) { log.push("below nothing: " + e.name); }
Object.setPrototypeOf(Leaf.prototype, Middle.prototype);
Middle.prototype.read = function () { return "Middle's new read"; };
Base.prototype.nothing = "something";
Object.setPrototypeOf(Leaf, Alone);
try { round("as declared again, with a new Middle.read and Base.nothing, Leaf below Alone"); } catch (e) { log.push("again: " + e.name); }
Object.setPrototypeOf(Alone.prototype, new Proxy({}, { get(target, key) { return typeof key === "string" ? "proxy " + key : undefined; } }));
Object.setPrototypeOf(Made[0].prototype, Old.prototype);
Object.setPrototypeOf(OverOld.prototype, Base.prototype);
try { round("Alone below a proxy, the first made class below Old, OverOld below Base"); } catch (e) { log.push("proxy: " + e.name); }
console.log(log.join("\n"));
//// super-calls-follow-every-change-above-the-home-object.js
// `super.run()` looks the method up above the home object, each time it is evaluated. Each family is asked in a loop, something above its home object changes, and it is asked again.
const unseen = new Function("value", "return value");
const lines = [];
function say(...parts) {
  lines.push(parts.join(" "));
}

function ask(label, object, rounds = 300) {
  let sum = 0;
  let last;
  for (let round = 0; round < rounds; round++) {
    last = object.run(round);
    sum += typeof last === "number" ? last : 0;
  }
  say(label, sum, String(last));
}

// The method above is replaced.
{
  class Above { run(n) { return n + 1; } }
  class Below extends Above { run(n) { return super.run(n) * 2; } }
  const object = new Below();
  ask("replaced, before", object);
  unseen(Above).prototype.run = function (n) { return n + 100; };
  ask("replaced, behind", object);
  Above.prototype.run = function (n) { return -n; };
  ask("replaced in sight", object);
}

// The method above is deleted: the lookup goes on one class higher, then finds nothing.
{
  class Top { run(n) { return n + 7; } }
  class Middle extends Top { run(n) { return n + 70; } }
  class Below extends Middle { run(n) { return super.run(n); } }
  const object = new Below();
  ask("deleted, before", object);
  delete unseen(Middle).prototype.run;
  ask("deleted once", object);
  delete unseen(Top).prototype.run;
  try {
    ask("deleted twice", object);
  } catch (error) {
    say("deleted twice", error.constructor.name);
  }
}

// The prototype object of the class gets another parent.
{
  class Above { run(n) { return n + 1; } }
  class Other { run(n) { return n + 1000; } }
  class Below extends Above { run(n) { return super.run(n); } }
  const object = new Below();
  ask("another parent, before", object);
  Object.setPrototypeOf(unseen(Below).prototype, Other.prototype);
  ask("another parent, behind", object);
  Object.setPrototypeOf(Below.prototype, { run(n) { return "literal " + n; } });
  ask("a literal as parent", object);
  Object.setPrototypeOf(Below.prototype, null);
  try {
    ask("no parent", object);
  } catch (error) {
    say("no parent", error.constructor.name);
  }
}

// A method is put between: the class in the middle declares none at first.
{
  class Top { run(n) { return n; } }
  class Middle extends Top {}
  class Below extends Middle { run(n) { return super.run(n) + 1; } }
  const object = new Below();
  ask("put between, before", object);
  unseen(Middle).prototype.run = function (n) { return n * 10; };
  ask("put between, behind", object);
}

// The home object stays what it was, whoever the receiver is and wherever the method is carried to.
{
  class Above { run(n) { return "above " + this.tag + " " + n; } }
  class Below extends Above { constructor() { super(); this.tag = "below"; } run(n) { return super.run(n); } }
  class Stranger { constructor() { this.tag = "stranger"; } run(n) { return "never " + n; } }
  const borrowed = Below.prototype.run;
  const stranger = new Stranger();
  stranger.run = borrowed;
  ask("borrowed", stranger, 50);
  say("called on a literal", borrowed.call({ tag: "literal" }, 3));
  say("an own property of the receiver is passed by", (() => { const object = new Below(); object.run = () => "own"; return Below.prototype.run.call(object, 4); })());
}

// An accessor above, a field above, a value that is no function.
{
  class Above { get run() { return (n) => "from a getter " + n; } }
  class Below extends Above { run(n) { return super.run(n); } }
  ask("a getter above", new Below(), 40);
  Object.defineProperty(unseen(Above).prototype, "run", { value: (n) => "a value now " + n, configurable: true });
  ask("a value above", new Below(), 40);
  Object.defineProperty(Above.prototype, "run", { value: 5, configurable: true });
  try {
    ask("a number above", new Below(), 40);
  } catch (error) {
    say("a number above", error.constructor.name);
  }
}

// The static side.
{
  class Above { static run(n) { return n + 2; } }
  class Below extends Above { static run(n) { return super.run(n) * 3; } }
  ask("static, before", Below);
  unseen(Above).run = (n) => n + 200;
  ask("static, replaced", Below);
  Object.setPrototypeOf(unseen(Below), { run: (n) => "static literal " + n });
  ask("static, another parent", Below);
}

// Object literals have home objects too.
{
  const above = { run(n) { return n + 3; } };
  const below = { __proto__: above, run(n) { return super.run(n) + 1; } };
  ask("literals, before", below);
  unseen(above).run = (n) => n + 300;
  ask("literals, replaced", below);
  Object.setPrototypeOf(below, { run: (n) => "other literal " + n });
  ask("literals, another parent", below);
}

// Arrows and inner functions inside the method, arguments with effects, spread.
{
  const order = [];
  class Above { run(a, b) { order.push("run"); return a + b; } }
  class Below extends Above {
    run(n) {
      const arrow = () => super.run((order.push("first"), n), (order.push("second"), 1));
      return arrow() + super.run(...[n, 2]);
    }
  }
  const object = new Below();
  ask("arrows", object, 20);
  say("order", order.slice(0, 8).join(","));
  let replaced = false;
  class Late extends Above { run(n) { return super.run(n, (replaced || (replaced = true, Above.prototype.run = (a, b) => a * 1000 + b), 5)); } }
  ask("the method is read in front of the arguments", new Late(), 3);
}

// Built-in classes above.
{
  class List extends Array { push(value) { return super.push(value * 2); } }
  const list = new List();
  for (let n = 0; n < 50; n++) list.push(n);
  say("array", list.length, list[49]);
  const push = Array.prototype.push;
  class Failure extends Error { toString() { return "<" + super.toString() + ">"; } }
  say("error", String(new Failure("told")));
  class Table extends Map { set(key, value) { return super.set(key, value + 1); } get(key) { return super.get(key) ?? "none"; } }
  const table = new Table();
  for (let n = 0; n < 50; n++) table.set(n, n);
  say("map", table.size, table.get(49), table.get(50), push === Array.prototype.push);
}

// A class text that is evaluated more than once: each evaluation has a home object of its own.
{
  function make(parent, factor) {
    return class extends parent { run(n) { return super.run(n) * factor; } };
  }
  class One { run(n) { return n + 1; } }
  class Two { run(n) { return n + 2; } }
  const first = make(One, 10), second = make(Two, 100), third = make(first, 2);
  ask("first evaluation", new first(), 30);
  ask("second evaluation", new second(), 30);
  ask("third evaluation", new third(), 30);
  unseen(One).prototype.run = (n) => n;
  ask("first evaluation, changed", new first(), 30);
  ask("third evaluation, changed", new third(), 30);
}

// Below a constructor function.
{
  function Old() {}
  Old.prototype.run = function (n) { return n + 4; };
  class Below extends Old { run(n) { return super.run(n) + 1; } }
  ask("below a function, before", new Below());
  unseen(Old).prototype.run = function (n) { return n + 400; };
  ask("below a function, replaced", new Below());
  Old.prototype = { run: () => "never: the link was made at the definition" };
  ask("below a function, another prototype object", new Below());
}

console.log(lines.join("\n"));
//// super-property-stores-and-reads.js
// super.x reads from the prototype of the home object with `this` as the receiver; super.x = v stores on `this`, past or through what the chain above the home object says.
function attempt(run) { try { return run(); } catch (error) { return error.constructor.name; } }
const log = [];
class Base {
  get viaGetter() { return "getter of " + this.tag; }
  set viaSetter(value) { log.push("setter " + this.tag + " " + value); }
  plain() { return "plain of " + this.tag; }
}
Base.prototype.data = "data of Base";
Object.defineProperty(Base.prototype, "readOnly", { value: "read only", writable: false, configurable: true });
class Derived extends Base {
  tag = "derived";
  read() { return [super.viaGetter, super.plain(), super.data, super.missing, super.readOnly].join(" | "); }
  store() { super.viaSetter = 1; super.data = "stored"; super.fresh = "fresh"; return [Object.keys(this).join(), Base.prototype.data, this.data, this.fresh].join(" | "); }
  storeReadOnly() { "use strict"; super.readOnly = 2; return this.readOnly; }
  storeOverOwnAccessor() { Object.defineProperty(this, "data", { get() { return "own getter"; }, set(value) { log.push("own setter " + value); }, configurable: true }); super.data = "x"; return this.data; }
  storeOverOwnReadOnly() { Object.defineProperty(this, "data", { value: "own fixed", writable: false, configurable: true }); super.data = "y"; return this.data; }
  computed(key) { return super[key]; }
  storeComputed(key, value) { super[key] = value; return this[key]; }
  remove() { return delete super.data; }
  arrow() { return (() => super.plain())(); }
  static make() { return super.name + " " + typeof super.call; }
}
const one = new Derived();
console.log(one.read());
console.log(one.store(), log.join());
console.log(attempt(() => one.storeReadOnly()), attempt(() => new Derived().storeOverOwnAccessor()), log.join(), attempt(() => new Derived().storeOverOwnReadOnly()));
console.log(one.computed("data"), one.computed("viaGetter"), one.storeComputed("k", 5), one.storeComputed(7, "seven"), attempt(() => one.remove()), one.arrow(), Derived.make());
// The home object decides, not the receiver: a method that is borrowed keeps its super.
const borrowed = { tag: "borrowed", read: Derived.prototype.read, store: Derived.prototype.store };
console.log(borrowed.read());
console.log(borrowed.store());
// The prototype of the home object is looked up at each access.
const other = { plain() { return "other plain of " + this.tag; }, data: "data of other", get viaGetter() { return "other getter"; } };
Object.setPrototypeOf(Derived.prototype, other);
console.log(one.read(), one.arrow());
Object.setPrototypeOf(Derived.prototype, null);
console.log(attempt(() => one.read()), attempt(() => one.storeComputed("z", 1)));
Object.setPrototypeOf(Derived.prototype, Base.prototype);
// In an object literal.
const parent = { hello() { return "parent hello " + this.name; }, set mark(value) { log.push("mark " + this.name + value); } };
const child = { __proto__: parent, name: "child", hello() { return "child > " + super.hello(); }, put() { super.mark = "!"; super.own = 1; return Object.keys(this).join(); } };
console.log(child.hello(), child.put(), log.at(-1), Object.create(child, { name: { value: "grandchild" } }).hello());
// The receiver is frozen, a primitive, a proxy.
console.log(attempt(() => Derived.prototype.storeComputed.call(Object.freeze({}), "a", 1)), attempt(() => Derived.prototype.storeComputed.call(5, "a", 1)), attempt(() => Derived.prototype.computed.call("text", "viaGetter")));
const seen = [];
const watched = new Proxy({}, { defineProperty(target, key, descriptor) { seen.push("define " + String(key)); return Reflect.defineProperty(target, key, descriptor); }, getOwnPropertyDescriptor(target, key) { seen.push("describe " + String(key)); return Reflect.getOwnPropertyDescriptor(target, key); }, set() { seen.push("set"); return true; } });
Derived.prototype.storeComputed.call(watched, "w", 1);
console.log(seen.join());
//// the-constructor-above-lets-the-object-out-before-the-fields-below-are-defined.js
// The constructor above hands the object to other code by a setter, a getter, a closure, a field that holds a closure, a call, or the constructor between. That code fixes a name that the class below declares, so the definition of that name throws, and the field that was defined before it holds undefined.
const kept = [];
const out = [];
function fix(o) {
  kept.push(o);
  Object.defineProperty(o, "y", { value: "fixed" });
}
function run(f) {
  f();
}
class BySetter {
  constructor() {
    this.hook = 1;
  }
}
class BelowSetter extends BySetter {
  x;
  y;
  constructor(v) {
    super();
    this.x = v;
    this.y = "s";
  }
  set hook(v) {
    fix(this);
  }
}
class ByGetter {
  constructor() {
    this.peek;
  }
}
class BelowGetter extends ByGetter {
  x;
  y;
  constructor(v) {
    super();
    this.x = v;
    this.y = "s";
  }
  get peek() {
    fix(this);
    return 1;
  }
}
class ByClosure {
  constructor() {
    run(() => fix(this));
  }
}
////= lines-2	BelowClosure	ByClosure
class ByField {
  self = this;
  later = () => fix(this);
  constructor() {
    this.later();
  }
}
////= lines-2	BelowField	ByField
class Frozen {
  a = 1;
  constructor() {
    Object.freeze(this);
    kept.push(this);
  }
}
////= lines-2	BelowFrozen	Frozen
class Top {
  a;
  constructor() {
    this.a = 1;
  }
}
class Between extends Top {
  b;
  constructor() {
    super();
    this.b = 2;
    fix(this);
  }
}
////= lines-2	BelowBetween	Between
class Quiet {
  a;
  constructor() {
    this.a = 1;
  }
}
////= lines-2	BelowQuiet	Quiet
for (const C of [BelowSetter, BelowGetter, BelowClosure, BelowField, BelowFrozen, BelowBetween, BelowQuiet]) {
  const before = kept.length;
  try {
    out.push(C.name + " made " + JSON.stringify(new C(1)));
  } catch (e) {
    const o = kept.length > before ? kept[kept.length - 1] : undefined;
    out.push(C.name + " " + e.constructor.name + " " + (o ? String(o.x) + " " + Object.keys(o).join() : "not kept"));
  }
}
console.log(out.join("\n"));
//// the-name-of-a-class-is-read-while-its-decorators-run.js
const out = [];
const attempt = (label, work) => { try { out.push(label + " " + typeof work()); } catch (e) { out.push(label + " " + e.name); } };
const callsIt = (value, context) => { attempt("while " + context.kind + " " + String(context.name) + " is decorated", value); };
const replace = (cls) => { attempt("while the class is decorated", () => cls.m()); return class extends cls {}; };
const keeps = (cls) => { attempt("while the class is decorated and kept", () => cls.m()); };
@replace class C {
  @callsIt static m() { return C; }
  @callsIt n() { return C; }
  static late = (() => { attempt("in a static field", () => C.m()); return 1; })();
}
@keeps class K {
  @callsIt static m() { return K; }
  static late = (() => { attempt("in a static field", () => K.m()); return 1; })();
}
const E = @replace class Inner { static m() { return Inner; } };
console.log(out.join("\n"));
console.log(C.m() === C, new C().n() === C, K.m() === K, E.m() === E);
function typed() {
  @replace class T { x = 1; static make() { return new T(); } get() { return this.x; } }
  const made = T.make();
  return [made instanceof T, made.get(), Object.getPrototypeOf(made) === T.prototype].join();
}
console.log(typed(), typed());
//// the-order-of-fields-parameter-properties-computed-keys-and-static-blocks.ts
// In which order a class evaluates computed keys, static blocks, field initializers, parameter properties and constructor bodies, and what each form of member leaves on the instance, the prototype and the class.
function show(label: string, f: () => unknown) {
    try { console.log(label, JSON.stringify(f())); } catch (e) { console.log(label, "threw", (e as Error).constructor.name, (e as Error).message); }
}
const log: string[] = []; const L = <T>(s: string, v: T): T => { log.push(s); return v; };
const flush = () => log.splice(0).join(",");
// parameter properties, field order
// @ts-ignore
class PP { a = L("a", 1); constructor(public x: number, private y = L("y-default", 2), readonly z?: string, protected w: number = x + 1) { L("body", 0); this.b = x; } b: number = L("b", 3); c = L("c", this.x); }
show("parameter properties", () => [new PP(10), Object.keys(new PP(10)), flush()]);
class PPBase { constructor(public base: string) { L("base-ctor", 0); } }
// @ts-ignore
class PPDerived extends PPBase { f = L("f", this.base); constructor(public own: number) { L("before-super", 0); super(L("super-arg", "s")); L("after-super", 0); } g = L("g", this.own); }
show("derived parameter properties", () => [new PPDerived(1), Object.keys(new PPDerived(1)), flush()]);
// @ts-ignore
class Keys { [L("k1", "p")] = L("v1", 1); static [L("k2", "q")] = L("v2", 2); [L("k3", "m")]() {} static { L("static-block", 0); } [L("k4", "r")] = L("v4", 4); static s2 = L("s2", 5); }
show("computed keys order", () => { const before = flush(); new Keys(); return [before, flush(), Object.keys(new Keys()), Object.keys(Keys)]; });
// @ts-ignore
class NoInit { x: number; y?: string; z!: boolean; declare d: number; static s: number; constructor() { } }
show("fields without initializers", () => [Object.keys(new NoInit()), "x" in new NoInit(), Object.keys(NoInit), Object.getOwnPropertyDescriptor(new NoInit(), "x")]);
class SetterBase { set v(x: number) { L("setter " + x, 0); } get v() { return -1; } }
// @ts-ignore
class FieldOver extends SetterBase { v = 5; }
show("field defines over setter", () => [new FieldOver().v, flush(), Object.getOwnPropertyDescriptor(new FieldOver(), "v")]);
// @ts-ignore
class FieldOverNoInit extends SetterBase { v: number; constructor() { super(); } }
show("uninitialized field over accessor", () => [new FieldOverNoInit().v, Object.keys(new FieldOverNoInit())]);
// @ts-ignore
class ParamOver extends SetterBase { constructor(public v: number) { super(); } }
show("parameter property over setter", () => [new ParamOver(3).v, flush(), Object.keys(new ParamOver(3))]);
class Arrow { n = 1; f = () => this.n; static sf = () => this.name; g = function (this: unknown) { return typeof this; }; }
show("arrow fields", () => { const a = new Arrow(); const { f, g } = a; return [f(), Arrow.sf(), g()]; });
class Acc { accessor a = L("acc-init", 1); static accessor s = 2; accessor #p = 3; get p() { return this.#p; } }
show("auto accessors", () => { const a = new Acc(); a.a++; Acc.s += 5; return [a.a, Acc.s, a.p, Object.keys(a), Object.getOwnPropertyNames(Acc.prototype), flush()]; });
abstract class Abs { abstract x: number; abstract m(): number; y = L("abs-y", 1); n() { return this.m() + this.x; } }
class Conc extends Abs { x = 2; m() { return 3; } }
show("abstract", () => [new Conc().n(), Object.keys(new Conc()), Object.getOwnPropertyNames(Abs.prototype), flush()]);
class Ov { m(a: string): string; m(a: number): number; m(a: any) { return a; } constructor(); constructor(a?: number) { } }
show("overloads", () => [new Ov().m(1), Object.getOwnPropertyNames(Ov.prototype), Ov.length]);
class Priv { #a = 1; static #s = 2; #m() { return this.#a; } static has(o: object) { return #a in o; } get #g() { return 5; } read() { return [this.#a, Priv.#s, this.#m(), this.#g]; } private ts = 9; }
show("private names", () => [new Priv().read(), Priv.has(new Priv()), Priv.has({}), Object.keys(new Priv())]);
class StaticThis { static a = 1; static b = this.a + 1; static c = StaticThis.b + 1; static m() { return this.c; } static { this.a = 10; } }
show("static this", () => [StaticThis.a, StaticThis.b, StaticThis.c, StaticThis.m()]);
const Named = class Inner { static self = Inner.name; me() { return Inner; } }; show("class expression name", () => [Named.name, Named.self, new Named().me() === Named]);
const anon = class { }; const o = { k: class { }, f: function () { }, a: () => { }, ["c" + 1]: class { } }; show("inferred names", () => [anon.name, o.k.name, o.f.name, o.a.name, o.c1.name]);
class Ret { x = 1; constructor() { return { other: 2 } as any; } } show("constructor returns", () => new Ret());
class RetD extends Ret { y = 3; } show("derived of returning", () => [new RetD(), new RetD() instanceof RetD]);
class Getter { get [Symbol.toStringTag]() { return "G"; } static get [Symbol.species]() { return Array; } } show("symbol members", () => [String(new Getter()), (Getter as any)[Symbol.species] === Array]);
class SuperProps extends PPBase { constructor() { super("b"); } base2() { return super.toString === Object.prototype.toString; } static sm() { return super.name; } get viaSuper() { return typeof super.constructor; } }
show("super properties", () => [new SuperProps().base2(), SuperProps.sm(), new SuperProps().viaSuper, flush()]);
function mixin<T extends new (...a: any[]) => object>(B: T) { return class extends B { mixed = L("mixed", 1); constructor(...a: any[]) { super(...a); L("mixin-ctor", 0); } }; }
show("mixin", () => [new (mixin(PPBase))("x"), flush(), mixin(PPBase).name]);
class TDZ { static a = (() => { try { return typeof TDZ; } catch (e) { return "tdz"; } })(); } show("class binding in static init", () => TDZ.a);
show("class tdz", () => { const f = () => new Late(); try { f(); } catch (e) { return (e as Error).constructor.name; } class Late { } return "no"; });
class GenM { *g() { yield 1; yield* [2, 3]; } async a() { return 4; } async *ag() { yield 5; } static *[Symbol.iterator]() { yield 6; } } show("generator methods", () => [[...new GenM().g()], [...GenM]]);
// @ts-ignore
class NewTarget { t = new.target === undefined; c: boolean; constructor() { this.c = new.target === NewTarget; } } class NT2 extends NewTarget { } show("new.target", () => [new NewTarget(), new NT2()]);
class Opt { m?(): number; f?: () => number; } show("optional members", () => [new Opt().m?.(), new Opt().f?.(), Object.keys(new Opt())]);
class IndexSig { [k: string]: unknown; a = 1; static [k: string]: unknown; } show("index signatures", () => [Object.keys(new IndexSig()), Object.keys(IndexSig)]);
//// the-prototype-object-of-a-class-is-no-instance-of-it.ts
// TypeScript gives `C.prototype` the type of the instances of `C`. The object has their methods and none of their fields.
const out: string[] = [];
function say(...parts: unknown[]) { out.push(parts.map(String).join(" ")); }

class A {
  a: number;
  label = "a";
  constructor(a: number) { this.a = a; }
  area(): number { return this.a + 1; }
  get size(): number { return this.a * 2; }
  describe(): string { return `${this.label}:${this.a}`; }
}
class B extends A {
  b: number;
  constructor(a: number) { super(a); this.b = 2; }
  area(): number { return A.prototype.area.call(this) + this.b; }
  describe(): string { return "B " + A.prototype.describe.apply(this, []); }
}
function takesAnA(v: A): string { return typeof v.a + " " + typeof v.label + " " + typeof v.area; }
function readsFields(v: A): number { return v.a + 1; }

const kept: A[] = [new B(1), new A(2), new B(3)];
let sum = 0;
for (let i = 0; i < 30; i++) sum += kept[i % 3].area();
say(sum, kept.map(v => v.describe()).join());

const held = A.prototype;
say(held.a, held.label, typeof held.area, held.area.call(new A(4)), held.area.call({ a: 10 } as A), Number.isNaN(held.area()), Number.isNaN(held.size));
say(takesAnA(A.prototype), takesAnA(new A(1)), Number.isNaN(readsFields(A.prototype)), readsFields(new A(1)));
say(A.prototype instanceof A, B.prototype instanceof A, B.prototype instanceof B, A.prototype.constructor === A, B.prototype.constructor === B);
say(Object.getOwnPropertyNames(A.prototype).join(), Object.getOwnPropertyNames(B.prototype).join(), Object.keys(A.prototype).length);
say(Object.getPrototypeOf(B.prototype) === A.prototype, Object.getPrototypeOf(new B(1)) === B.prototype, "a" in A.prototype, "area" in B.prototype);

const either: A = sum > 0 ? A.prototype : new A(9);
say(either.a, either.describe());
const list: A[] = [A.prototype, new A(5), B.prototype];
say(list.map(v => String(v.a)).join(), list.map(v => typeof v.area).join());

(A.prototype as any).added = 7;
say((new A(1) as any).added, (new B(1) as any).added, (held as any).added);
A.prototype.area = function (this: A) { return this.a + 100; };
say(new A(1).area(), new B(1).area(), held.area.call(new A(2)));

function F(this: any, x: number) { this.x = x; }
F.prototype.get = function () { return this.x; };
say(typeof F.prototype.get, F.prototype.x, F.prototype.get.call({ x: 3 }), new (F as any)(4).get());

console.log(out.join("\n"));
//// the-prototype-property-of-new-target-is-read-at-every-construction.js
// `new` on a function that the compiler does not know at the site reads new.target's prototype property each time: another object stored there, a value that is no object, a proxy, a bound function,
// a derived class and Reflect.construct all show in the object that is made.
function Node(kind) { this.kind = kind; }
function Token(kind) { this.kind = kind; }
const makers = [Node, Token];
function make(i) { return new makers[i & 1](i); }
let sum = 0;
for (let i = 0; i < 20000; i++) sum += Object.getPrototypeOf(make(i)) === makers[i & 1].prototype ? 1 : 0;
console.log(sum);
const first = Node.prototype;
Node.prototype = { tag: "second" };
console.log(make(0).tag, Object.getPrototypeOf(make(0)) === first, make(1).tag);
Node.prototype = 5;
console.log(Object.getPrototypeOf(make(0)) === Object.prototype);
Node.prototype = first;
console.log(Object.getPrototypeOf(make(0)) === first);
Bun.gc(true);
