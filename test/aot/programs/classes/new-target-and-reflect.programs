}
class Deep extends Leaf {}

function all(object) {
  return [object.a(), object.b(), object.c(), object.d(), object.e()].join(" ");
}
function statics(constructor) {
  return [constructor.s(), constructor.t(), constructor.u()].join(" ");
}
function fields(object) {
  return [object.x, object.y, object.z].join(" ");
}
function show(label) {
  console.log(label);
  for (const constructor of [Base, Middle, Leaf, Other, Deep]) console.log(" ", constructor.name, all(new constructor()), "|", statics(constructor));
  console.log("  fields", fields(new Leaf()), "|", fields(new Deep()));
}

show("as declared");
Base.prototype.a = function () { return "stored a"; };
show("a stored");
Base.prototype.b = function () { return "stored b"; };
show("b stored");
Base.prototype.c = function () { return "stored c"; };
show("c stored, which Middle declares");
Base.prototype.d = function () { return "stored d"; };
show("d stored, which Other declares");
Object.defineProperty(Base.prototype, "e", { value() { return "defined e"; }, configurable: true, writable: true });
show("e defined");
delete Base.prototype.a;
try {
  show("a deleted");
} catch (error) {
  console.log("  threw", error.constructor.name);
}
Base.prototype.a = function () { return "a again"; };
show("a again");
Base.s = function () { return "stored s"; };
show("s stored");
Base.t = function () { return "stored t"; };
show("t stored, which Middle declares");
Base.u = function () { return "stored u"; };
show("u stored");
const seen = [];
Object.defineProperty(Base.prototype, "x", { set(value) { seen.push("x=" + value); }, get() { return "got x"; }, configurable: true });
show("a setter for x above");
Object.defineProperty(Base.prototype, "y", { set(value) { seen.push("y=" + value); }, get() { return "got y"; }, configurable: true });
show("a setter for y above");
Object.defineProperty(Middle.prototype, "z", { set(value) { seen.push("z=" + value); }, get() { return "got z"; }, configurable: true });
show("a setter for z in the middle");
console.log(seen.join(" "));
Middle.prototype.a = function () { return "Middle a"; };
Middle.prototype.b = function () { return "Middle b"; };
Middle.prototype.e = function () { return "Middle e"; };
show("three stored in the middle");
Base.prototype.a = function () { return "Base a under Middle's"; };
Base.prototype.b = function () { return "Base b under Middle's"; };
show("two stored above what the middle holds now");
//// static-fields-changed-by-evaluated-text-that-holds-the-class.js
// Evaluated text holds two classes and stores to their static fields, shadows them below, deletes them, turns them into accessors, freezes the class and relinks the subclass. Every read and every store afterward does what plain JavaScript does.
class Counter {
  static count = 1;
  static label = "start";
  static total() {
    return Counter.count + Below.count;
  }
}
class Below extends Counter {
  static own = 10;
}
class Untouched {
  static count = 100;
}

function show(value) {
  return typeof value === "string" ? JSON.stringify(value) : String(value);
}

function readAll() {
  let line = "";
  for (let round = 0; round < 3; round++) {
    line = [
      Counter.count,
      Below.count,
      Counter.label,
      Below.label,
      Below.own,
      Untouched.count,
      "count" in Counter,
      "count" in Below,
      Object.hasOwn(Below, "count"),
      Counter.total(),
    ]
      .map(show)
      .join(" ");
  }
  return line;
}

function storeAll(value) {
  let outcome = "";
  for (let round = 0; round < 3; round++) {
    try {
      Counter.count = value + round;
      Counter.label = "label " + (value + round);
      outcome = "stored";
    } catch (error) {
      outcome = error.constructor.name;
    }
  }
  return outcome;
}

const steps = [
  "Counter.count = 2",
  "Counter.count = 2.5",
  "Counter.count = 'text'",
  "Counter.count = 3",
  "Below.count = 4",
  "delete Below.count",
  "delete Counter.count",
  "Counter.count = 5",
  "Object.defineProperty(Counter, 'count', { get() { return 'getter'; }, set(value) { this.seen = value; }, configurable: true })",
  "Object.defineProperty(Counter, 'count', { value: 6, writable: true, enumerable: true, configurable: true })",
  "Object.defineProperty(Counter, 'label', { value: 'fixed', writable: false })",
  "Object.setPrototypeOf(Below, { count: 'elsewhere', label: 'elsewhere' })",
  "Object.setPrototypeOf(Below, Counter)",
  "Below.own += 1",
  "Object.freeze(Counter)",
];

const change = new Function("Counter", "Below", "text", "return new Function('Counter', 'Below', text)(Counter, Below);");

console.log("at the start:", readAll());
for (const [index, step] of steps.entries()) {
  change(Counter, Below, step);
  console.log(step, "=>", readAll());
  console.log("  then stores from", index * 10, storeAll(index * 10), readAll());
}
console.log("seen by the setter:", show(Counter.seen));
console.log(Object.keys(Counter).join(), "|", Object.keys(Below).join(), "|", Object.keys(Untouched).join());
//// static-fields-whose-type-is-one-number-are-read-while-they-change.ts
// `static readonly Low = 10` has the type 10. A class whose static fields nobody touches again, and classes whose fields are stored, defined, deleted or frozen behind the checker's back: every read sees what is there.
const lines: string[] = [];
function say(label: string, value: unknown): void {
  lines.push(label + ": " + String(value));
}

class Untouched {
  static readonly Low = 10;
  static readonly High = 200;
  static readonly Below = -3;
  static readonly Half = 0.5;
  static readonly Big = 4294967296;
  static readonly Name = "limits";
}
function clamp(value: number): number {
  return value < Untouched.Low ? Untouched.Low : value > Untouched.High ? Untouched.High : value;
}

////= lines-10	StoredByACast
function readStored(): number {
  return StoredByACast.Low + 1;
}

////= lines-10	StoredAnotherKind
function readOtherKind(): string {
  return typeof StoredAnotherKind.Low + " " + StoredAnotherKind.Low;
}

////= lines-10	Defined
function readDefined(): number {
  return Defined.Low * 2;
}

////= lines-10	Deleted
function readDeleted(): string {
  return String(Deleted.Low) + " " + ("Low" in Deleted);
}

class StoredByKey {
  static readonly Low = 10;
  static readonly High = 20;
}
function readByKey(): number {
  return StoredByKey.Low + StoredByKey.High;
}

class Counted {
  static count: 0 | 1 | 2 = 0;
}
function bump(): number {
  Counted.count = ((Counted.count + 1) % 3) as 0 | 1 | 2;
  return Counted.count;
}

////= lines-10	Above
class Below extends Above {}
function readBelow(): number {
  return Below.Low + Above.Low;
}

class InitializedByACall {
  static readonly Low: 10 = pick() as 10;
}
function pick(): number {
  return lines.length === 0 ? 10 : 11;
}
function readInitialized(): number {
  return InitializedByACall.Low;
}

function all(): string {
  let sum = 0;
  for (let i = 0; i < 300; i += 7) sum += clamp(i);
  return [sum, Untouched.Below, Untouched.Half, Untouched.Big, Untouched.Name, readStored(), readOtherKind(), readDefined(), readDeleted(), readByKey(), bump(), readBelow(), readInitialized()].join(" | ");
}

let last = "";
for (let turn = 0; turn < 50; turn++) last = all();
say("before", last);

(StoredByACast as { Low: number }).Low = 11;
say("stored by a cast", all());
(StoredAnotherKind as unknown as { Low: string }).Low = "ten";
say("another kind stored", all());
Object.defineProperty(Defined, "Low", { get: () => 21, configurable: true });
say("defined as a getter", all());
delete (Deleted as { Low?: number }).Low;
say("deleted", all());
for (const key of ["Low", "High"]) (StoredByKey as unknown as Record<string, number>)[key] = key.length;
say("stored by key", all());
(Below as unknown as { Low: number }).Low = 1;
say("hidden below", all());
Object.assign(Above, { Low: 5 });
say("assigned above", all());
Object.freeze(Counted);
say("frozen", (() => {
  try {
    return all();
  } catch (error) {
    return (error as Error).constructor.name;
  }
})());
console.log(lines.join("\n"));
