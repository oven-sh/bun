//// unused-classes-define-static-members-named-prototype/main.js
// Each module defines a class at its top level that nothing uses. The prototype property of a class cannot be redefined, so a static member under that name throws a TypeError.
const modules = [
  ["method", () => import("./method.js")],
  ["getter", () => import("./getter.js")],
  ["setter", () => import("./setter.js")],
  ["field", () => import("./field.js")],
  ["field-without-a-value", () => import("./field-without-a-value.js")],
  ["generator-method", () => import("./generator-method.js")],
  ["async-method", () => import("./async-method.js")],
  ["class-expression", () => import("./class-expression.js")],
  ["const-key", () => import("./const-key.js")],
  ["const-key-of-a-field", () => import("./const-key-of-a-field.js")],
  ["let-key", () => import("./let-key.js")],
  ["joined-key", () => import("./joined-key.js")],
  ["template-key", () => import("./template-key.js")],
  ["sum-key", () => import("./sum-key.js")],
  ["imported-key", () => import("./imported-key.js")],
  ["object-key", () => import("./object-key.js")],
  ["instance-method", () => import("./instance-method.js")],
  ["instance-field", () => import("./instance-field.js")],
  ["static-name", () => import("./static-name.js")],
  ["static-constructor", () => import("./static-constructor.js")],
  ["other-const-key", () => import("./other-const-key.js")],
];
for (const [name, load] of modules) {
  try {
    await load();
    console.log(name, "loaded");
  } catch (error) {
    console.log(name, error.name, error.message);
  }
}
