function strict() {
  "use strict";
  const bound = "bound";
  const attempt = look => {
    try {
      return String(look());
    } catch (error) {
      return error.name;
    }
  };
  return [
    attempt(() => eval(" bound ")),
    attempt(() => eval("bound;")),
    attempt(() => eval("(bound)")),
    attempt(() => eval("bound + 1")),
    attempt(() => eval("notBound")),
    attempt(() => eval("undefined")),
    attempt(() => typeof eval("globalThis")),
    attempt(() => typeof eval("this")),
    attempt(() => eval("arguments").length),
    attempt(() => eval("")),
    attempt(() => eval("null")),
    attempt(() => eval("\\u0062ound")),
    attempt(() => eval("let")),
    attempt(() => eval(bound)),
  ].join(" | ");
}
console.log(strict());
