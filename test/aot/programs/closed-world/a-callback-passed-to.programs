report("memoryUsage, at first:", readMemoryUsage, hidden[0].memoryUsage);
report("features, at first:", readFeatures, hidden[0].features);
report("argv0, at first:", readArgv0, hidden[0].argv0);
report("config, at first:", readConfig, hidden[0].config);
