{ const a: number[] = [1, 2]; const x: number = a[5]; log(2, x, x + 1, typeof x, x === undefined); const o: Dog[] = []; const d: Dog = o[0]; try { log(2, d.barks); } catch (e) { log(2, (e as Error).constructor.name); } }
