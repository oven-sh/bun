//// modules-loaded-between-collections/main.js
// What the run time holds for a loaded module (its namespace object, import.meta, the objects of a CommonJS module, the exports that an import of a CommonJS module captured) is held by nothing else between two uses. Here modules are loaded one at a time, in every way a module is loaded, with young and full collections between; then everything is asked for again.
const collectFull = () => Bun.gc(true);
const collectYoung = require("bun:jsc").edenGC;
function garbage(count) {
  let kept = null;
  for (let i = 0; i < count; i++) kept = { i, text: "t" + i, list: [i, kept && kept.i] };
  return kept.i;
}
const between = [collectYoung, collectFull, () => { collectYoung(); collectYoung(); }, () => { collectFull(); collectYoung(); }, () => { collectYoung(); collectFull(); }, () => garbage(20000)];
let turn = 0;
function collect() {
  garbage(3000);
  between[turn++ % between.length]();
}
const describe = namespace => Object.keys(namespace).sort().map(key => key + "=" + (typeof namespace[key] === "function" ? namespace[key]() : JSON.stringify(namespace[key]))).join(" ");
const ways = [
  ["import of a module", () => import("./first.js")],
  ["import of a CommonJS module", () => import("./second.cjs")],
  ["require of a CommonJS module", async () => require("./third.cjs")],
  ["require of a module", async () => require("./fourth.js")],
  ["import of a module that imports a CommonJS module", () => import("./fifth.js")],
  ["import of a module with a star export", () => import("./sixth.js")],
];
const firstAnswers = [];
for (const [name, load] of ways) {
  collect();
  const loaded = await load();
  collect();
  firstAnswers.push(describe(loaded));
  console.log(name + ":", firstAnswers.at(-1));
}
for (let round = 0; round < 4; round++) {
  collect();
  let index = 0;
  for (const [name, load] of ways) {
    const again = describe(await load());
    if (round === 0 || again !== firstAnswers[index]) console.log("again, " + name + ":", again === firstAnswers[index] ? "the same" : again);
    index++;
  }
}
collectFull();
//// modules-loaded-between-collections/second.cjs
exports.name = "second";
exports.list = ["a", { b: ["c"] }];
exports.self = () => typeof module.exports.self + ":" + typeof module.id;
//// modules-loaded-between-collections/sixth.js
export * from "./second.cjs";
export * as first from "./first.js";
export const own = "sixth";
//// modules-loaded-between-collections/third.cjs
const second = require("./second.cjs");
module.exports = { name: "third", list: [second.name, second.list.length], parent: () => typeof module.parent };
//// old-objects-get-extra-properties-that-nothing-else-keeps.js
// An object that has lived through a collection gets properties that its layout does not have, under keys and names that come again and again, so that the stubs add them.
// What is stored is young and nothing else keeps it: a young collection finds it only if the old object, and the old cell of its extra properties, are remembered.
import { edenGC, fullGC } from "bun:jsc";

const shelf = globalThis;
const shelfKey = process.env.SHELF || "shelf";
function hide(x) { shelf[shelfKey] = x; return shelf[shelfKey]; }

class Plain { constructor(a) { this.a = a; } }
class Wide { constructor(a) { this.a = a; this.b = a + 1; this.c = "c" + a; } }
function make(i) { return i & 1 ? new Wide(i) : new Plain(i); }

function addUnderKey(o, k, v) { o[k] = v; }
function addFirstName(o, v) { o.firstLate = v; }
function addSecondName(o, v) { o.secondLate = v; }
function valueFor(k, i) { return k % 3 === 0 ? { k, i } : k % 3 === 1 ? "v" + k + "-" + i : [k, i]; }
function isValueFor(v, k, i) { return k % 3 === 0 ? v.k === k && v.i === i : k % 3 === 1 ? v === "v" + k + "-" + i : v.length === 2 && v[0] === k && v[1] === i; }
// Takes the room of whatever the collection has let go.
let sink = 0;
function fill(n) {
  for (let i = 0; i < n; i++) sink += [i, "g" + i, { i, j: i, k: i }, { a: i }, [i, i, i, i]].length;
}

const count = 1024;
const batch = 64;
const keys = [];
for (let k = 0; k < 12; k++) keys.push((process.env.PREFIX || "key") + k);

const byKey = [];
const byName = [];
for (let i = 0; i < count; i++) {
  byKey.push(make(i));
  byName.push(hide(make(i)));
}
fullGC();
fullGC();

let wrong = 0;
// One key after the other: the cell of the extra properties is made for an old object, grows old itself, takes more, and gets storage outside that grows.
for (let k = 0; k < keys.length; k++) {
  for (let first = 0; first < count; first += batch) {
    for (let i = first; i < first + batch; i++) addUnderKey(byKey[i], keys[k], valueFor(k, i));
    edenGC();
    fill(200);
    for (let i = first; i < first + batch; i++) if (!isValueFor(byKey[i][keys[k]], k, i)) wrong++;
  }
  if (k % 2 === 1) fullGC();
}
for (let first = 0; first < count; first += batch) {
  for (let i = first; i < first + batch; i++) addFirstName(byName[i], valueFor(0, i));
  edenGC();
  fill(200);
  for (let i = first; i < first + batch; i++) if (!isValueFor(byName[i].firstLate, 0, i)) wrong++;
}
fullGC();
for (let first = 0; first < count; first += batch) {
  for (let i = first; i < first + batch; i++) addSecondName(byName[i], valueFor(1, i));
  edenGC();
  fill(200);
  for (let i = first; i < first + batch; i++) if (!isValueFor(byName[i].secondLate, 1, i)) wrong++;
}
fullGC();
for (let i = 0; i < count; i++) {
  for (let k = 0; k < keys.length; k++) if (!isValueFor(byKey[i][keys[k]], k, i)) wrong++;
  if (byKey[i].a !== i || byName[i].a !== i || !isValueFor(byName[i].firstLate, 0, i) || !isValueFor(byName[i].secondLate, 1, i)) wrong++;
}
console.log("wrong:", wrong, Object.keys(byKey[0]).join(), Object.keys(byKey[1]).join(), Object.keys(byName[1]).join());
//// regular-expression-literals-first-used-between-collections.js
// The compiled pattern of a literal is made when the literal is first evaluated and lasts as long as the program; nothing but the run time holds it between two evaluations. Here literals are first evaluated a few at a time, with young and full collections between, in every order of the two, and all of them are evaluated again at the end.
const shell = globalThis;
const collectFull = shell.gc ?? (() => Bun.gc(true));
const collectYoung = shell.edenGC ?? require("bun:jsc").edenGC;
const literals = [
  () => /k0-(\d+)(?<tail>[a-c]*)/,
  () => /k1-(\d+)(?<tail>[a-d]*)/g,
  () => /k2-(\d+)(?<tail>[a-e]*)/i,
  () => /k3-(\d+)(?<tail>[a-f]*)/u,
  () => /k4-(\d+)(?<tail>[a-g]*)/y,
  () => /k5-(\d+)(?<tail>[a-h]*)/m,
  () => /k6-(\d+)(?<tail>[a-c]*)/s,
  () => /k7-(\d+)(?<tail>[a-d]*)/gi,
  () => /k8-(\d+)(?<tail>[a-e]*)/d,
  () => /k9-(\d+)(?<tail>[a-f]*)/v,
  () => /k10-(\d+)(?<tail>[a-g]*)/,
  () => /k11-(\d+)(?<tail>[a-h]*)/g,
  () => /k12-(\d+)(?<tail>[a-c]*)/i,
  () => /k13-(\d+)(?<tail>[a-d]*)/u,
  () => /k14-(\d+)(?<tail>[a-e]*)/y,
  () => /k15-(\d+)(?<tail>[a-f]*)/m,
  () => /k16-(\d+)(?<tail>[a-g]*)/s,
  () => /k17-(\d+)(?<tail>[a-h]*)/gi,
  () => /k18-(\d+)(?<tail>[a-c]*)/d,
  () => /k19-(\d+)(?<tail>[a-d]*)/v,
  () => /k20-(\d+)(?<tail>[a-e]*)/,
  () => /k21-(\d+)(?<tail>[a-f]*)/g,
  () => /k22-(\d+)(?<tail>[a-g]*)/i,
  () => /k23-(\d+)(?<tail>[a-h]*)/u,
  () => /k24-(\d+)(?<tail>[a-c]*)/y,
  () => /k25-(\d+)(?<tail>[a-d]*)/m,
  () => /k26-(\d+)(?<tail>[a-e]*)/s,
  () => /k27-(\d+)(?<tail>[a-f]*)/gi,
  () => /k28-(\d+)(?<tail>[a-g]*)/d,
  () => /k29-(\d+)(?<tail>[a-h]*)/v,
  () => /k30-(\d+)(?<tail>[a-c]*)/,
  () => /k31-(\d+)(?<tail>[a-d]*)/g,
  () => /k32-(\d+)(?<tail>[a-e]*)/i,
  () => /k33-(\d+)(?<tail>[a-f]*)/u,
  () => /k34-(\d+)(?<tail>[a-g]*)/y,
  () => /k35-(\d+)(?<tail>[a-h]*)/m,
  () => /k36-(\d+)(?<tail>[a-c]*)/s,
  () => /k37-(\d+)(?<tail>[a-d]*)/gi,
  () => /k38-(\d+)(?<tail>[a-e]*)/d,
  () => /k39-(\d+)(?<tail>[a-f]*)/v,
  () => /k40-(\d+)(?<tail>[a-g]*)/,
  () => /k41-(\d+)(?<tail>[a-h]*)/g,
  () => /k42-(\d+)(?<tail>[a-c]*)/i,
  () => /k43-(\d+)(?<tail>[a-d]*)/u,
  () => /k44-(\d+)(?<tail>[a-e]*)/y,
  () => /k45-(\d+)(?<tail>[a-f]*)/m,
  () => /k46-(\d+)(?<tail>[a-g]*)/s,
  () => /k47-(\d+)(?<tail>[a-h]*)/gi,
  () => /k48-(\d+)(?<tail>[a-c]*)/d,
  () => /k49-(\d+)(?<tail>[a-d]*)/v,
  () => /k50-(\d+)(?<tail>[a-e]*)/,
  () => /k51-(\d+)(?<tail>[a-f]*)/g,
  () => /k52-(\d+)(?<tail>[a-g]*)/i,
  () => /k53-(\d+)(?<tail>[a-h]*)/u,
  () => /k54-(\d+)(?<tail>[a-c]*)/y,
  () => /k55-(\d+)(?<tail>[a-d]*)/m,
  () => /k56-(\d+)(?<tail>[a-e]*)/s,
  () => /k57-(\d+)(?<tail>[a-f]*)/gi,
  () => /k58-(\d+)(?<tail>[a-g]*)/d,
  () => /k59-(\d+)(?<tail>[a-h]*)/v,
];
function garbage(count) {
  let kept = null;
  for (let i = 0; i < count; i++) kept = { i, text: "t" + i, list: [i, kept && kept.i] };
  return kept.i;
}
function ask(index) {
  const pattern = literals[index]();
  const match = pattern.exec("xx k" + index + "-" + index * 7 + "abcz K" + index + "-1");
  return index + ":" + pattern.flags + ":" + (match ? match[0] + "|" + match.groups.tail + "|" + match.index : "none") + ":" + pattern.source.length;
}
const between = [collectYoung, collectFull, () => { collectYoung(); collectYoung(); }, () => { collectFull(); collectYoung(); }, () => { collectYoung(); collectFull(); }, () => garbage(20000)];
const first = [];
for (let index = 0; index < literals.length; index++) {
  first.push(ask(index));
  if (index % 3 === 2) {
    garbage(3000);
    between[(index / 3 | 0) % between.length]();
  }
}
collectFull();
garbage(50000);
collectYoung();
let same = 0;
for (let round = 0; round < 3; round++) {
  for (let index = literals.length - 1; index >= 0; index--) same += ask(index) === first[index] ? 1 : 0;
  between[round]();
}
console.log(first.join("\n"));
console.log("the same at the end:", same, "of", 3 * literals.length);
//// shapes-and-prototypes-that-nobody-uses-any-more-are-let-go.ts
// What a program has learned about a shape outlives the objects of that shape. It does not outlive the prototype that the shape hangs on, and it keeps no prototype alive; and a program that gives its objects new names for ever does not grow.
import { fullGC, heapStats } from "bun:jsc";

class Message {
  url: string;
  constructor(url: string) { this.url = url; }
}

function structures(): number {
  let sum = 0;
  for (const [name, count] of Object.entries(heapStats().objectTypeCounts)) if (name.includes("Structure")) sum += count as number;
  return sum;
}
async function settle(): Promise<void> {
  for (let i = 0; i < 3; i++) {
    await new Promise(resolve => setTimeout(resolve, 1));
    fullGC();
  }
}

function underNewPrototype(i: number, watched: WeakRef<object>[]): number {
  const prototype: any = Object.create(Message.prototype);
  prototype.helper = function () { return i; };
  const message: any = new Message("/" + i);
  Object.setPrototypeOf(message, prototype);
  message.params = i;
  message.route = "route";
  if (i % 20 === 0) watched.push(new WeakRef(prototype));
  return message.helper() + message.params + message.route.length + message.url.length;
}

function withNewNames(i: number): number {
  const message: any = new Message("/" + i);
  message["name" + i] = i;
  message["other" + i] = i + 1;
  const plain: any = {};
  plain["key" + i] = i;
  return message["name" + i] + message["other" + i] + plain["key" + i];
}

let sum = 0;
const watched: WeakRef<object>[] = [];
for (let i = 0; i < 200; i++) sum += underNewPrototype(i, []) + withNewNames(i);
await settle();
const before = structures();

for (let round = 0; round < 10; round++) {
  for (let i = 0; i < 400; i++) sum += underNewPrototype(round * 400 + i, watched);
  await settle();
}
const alive = watched.filter(ref => ref.deref() !== undefined).length;
console.log("prototypes watched:", watched.length, "nearly all are gone:", alive <= 3);
console.log("no more Structures than before:", structures() - before < 100);

for (let round = 0; round < 10; round++) {
  for (let i = 0; i < 2000; i++) sum += withNewNames(1000 + round * 2000 + i);
  await settle();
}
console.log("nor behind twenty thousand new names:", structures() - before < 100);
console.log(sum);
