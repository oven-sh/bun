import * as second from "./second.cjs";
export const name = "fifth";
export const seen = () => [nameOfThird, third.list.join("+"), Object.keys(second).sort().join("+")].join(" ");
//// modules-loaded-between-collections/first.js
export const name = "first";
export const list = [1, 2, { three: 3 }];
export const where = () => import.meta.url.replace(/^.*[\\/]/, "") + ":" + typeof import.meta.dirname;
export let count = 0;
export function bump() { return ++count > 0 ? "bumped" : "never"; }
//// modules-loaded-between-collections/fourth.js
import { list as firstList } from "./first.js";
export const name = "fourth";
export const list = firstList.map(item => typeof item);
