////: WatchedResources
async function collect() {
  for (let round = 0; round < 8; round++) {
    await new Promise(done => setTimeout(done, 1));
    Bun.gc(true);
  }
}
let cleaned = 0;
const registry = new FinalizationRegistry(() => cleaned++);
function watch(value) {
  registry.register(value, 0);
  return value;
}
class Resource {
  constructor(n) {
    this.n = n;
  }
}
////: CountedByRow
async function collect() {
  for (let round = 0; round < 8; round++) {
    await new Promise(done => setTimeout(done, 1));
    Bun.gc(true);
  }
}
function newCounter() {
  let cleaned = 0;
  const registry = new FinalizationRegistry(() => cleaned++);
  return {
    watch(value) {
      registry.register(value, 0);
      return value;
    },
    cleaned: () => cleaned,
  };
}
class Resource {
  constructor(n) {
    this.n = n;
  }
}
//// objects-held-only-by-a-captured-variable-that-is-only-stored-stay-alive.mjs
// A function keeps what it is given in a variable of the function around it. Nothing reads the variable.
////= WatchedResources
function main() {
  let kept = null;
  function keep(resource) {
    kept = resource;
  }
  keep(watch(new Resource(1)));
  return keep;
}
const keep = main();
await collect();
console.log("cleaned", cleaned, "of", 1, typeof keep);
//// objects-held-only-by-a-class-field-nobody-reads-stay-alive.mjs
// Each component holds a resource in a field that is written in the class and that nothing reads.
////= WatchedResources
class Component {
  subscription = watch(new Resource(1));
}
const holders = [];
for (let i = 0; i < 500; i++) holders.push(new Component());
await collect();
console.log("cleaned", cleaned, "of", holders.length);
//// objects-held-only-by-a-field-nobody-reads-answer-their-weak-references.mjs
// Each component holds a resource in a field that nothing reads. A weak reference to the resource finds it as long as the component lives.
async function collect() {
  for (let round = 0; round < 8; round++) {
    await new Promise(done => setTimeout(done, 1));
    Bun.gc(true);
  }
}
class Resource {
  constructor(n) {
    this.n = n;
  }
}
class Component {
  constructor(resource) {
    this.subscription = resource;
  }
}
const holders = [];
const references = [];
for (let i = 0; i < 500; i++) {
  const resource = new Resource(i);
  references.push(new WeakRef(resource));
  holders.push(new Component(resource));
}
await collect();
let alive = 0;
for (const reference of references) if (reference.deref()) alive++;
console.log("alive", alive, "of", holders.length);
//// objects-held-only-by-a-field-of-a-class-made-in-a-callback-stay-alive.mjs
// The clean-up callback of a registry does not run for an object that a live object refers to, also when no code reads the reference.
async function collect() {
  for (let i = 0; i < 4; i++) {
    await new Promise(done => setTimeout(done, 1));
    Bun.gc(true);
  }
}
async function count(name, make) {
  let cleaned = 0;
  const registry = new FinalizationRegistry(() => cleaned++);
  const holders = [];
  for (let i = 0; i < 500; i++) holders.push(make(i, o => (registry.register(o, i), o)));
  await collect();
  await collect();
  console.log(name, cleaned, holders.length);
}
await count("field", (i, watch) => {
  class Holder {
    constructor(o) {
      this.keep = o;
    }
  }
  return new Holder(watch({ i }));
});
await count("private field", (i, watch) => {
  class Holder {
    #keep;
    constructor(o) {
      this.#keep = o;
    }
  }
  return new Holder(watch({ i }));
});
await count("literal", (i, watch) => ({ keep: watch({ i }) }));
await count("list", (i, watch) => {
  const l = [];
  l.push(watch({ i }));
  return l;
});
await count("subscription", (i, watch) => {
  class Subscription {
    constructor(n) {
      this.n = n;
    }
  }
  class Component {
    constructor() {
      this.subscription = watch(new Subscription(i));
    }
  }
  return new Component();
});
//// objects-held-only-by-a-module-variable-that-a-function-stores-stay-alive.mjs
// A function of the module keeps what it is given in a variable of the module. Nothing reads the variable.
////= WatchedResources
let kept;
function keep(resource) {
  kept = resource;
}
keep(watch(new Resource(1)));
await collect();
console.log("cleaned", cleaned, "of", 1);
//// objects-held-only-by-an-object-that-is-read-in-part-stay-alive.mjs
// A component is read behind an await, but only its number. The resource in its other field lives as long as the component.
////= CountedByRow
class Component {
  constructor(resource, n) {
    this.subscription = resource;
    this.n = n;
  }
}
const first = newCounter();
const ofModule = new Component(first.watch(new Resource(1)), 7);
await collect();
console.log("in a constant of the module: cleaned", first.cleaned(), ofModule.n);

async function holdInLocal(counter) {
  const local = new Component(counter.watch(new Resource(2)), 8);
  await collect();
  console.log("in a local: cleaned", counter.cleaned(), local.n);
}
await holdInLocal(newCounter());

async function readLater(counter, component) {
  await collect();
  console.log("in a parameter: cleaned", counter.cleaned(), component.n);
}
const third = newCounter();
await readLater(third, new Component(third.watch(new Resource(3)), 9));

function capture(counter) {
  const captured = new Component(counter.watch(new Resource(4)), 10);
  return () => captured.n;
}
const fourth = newCounter();
const read = capture(fourth);
await collect();
console.log("in a captured constant: cleaned", fourth.cleaned(), read());

const fifth = newCounter();
const app = { name: "a", subscription: fifth.watch(new Resource(5)) };
function nameOfApp() {
  return app.name;
}
await collect();
console.log("in a literal that a function reads: cleaned", fifth.cleaned(), nameOfApp());
//// objects-held-only-by-places-nobody-reads-stay-alive.mjs
// Every kind of place that nothing reads, and every kind of object in it.
////= CountedByRow
async function count(label, make) {
  const counter = newCounter();
  const holders = [];
  for (let i = 0; i < 200; i++) holders.push(make(i, counter.watch));
  await collect();
  console.log(label + ": cleaned", counter.cleaned(), "of", holders.length);
}
class SetInConstructor { constructor(r) { this.inConstructor = r; } }
await count("a field set in the constructor", (i, watch) => new SetInConstructor(watch(new Resource(i))));
await count("a literal", (i, watch) => ({ inLiteral: watch(new Resource(i)) }));
function hold(r) { return () => r; }
await count("a variable of a closure nobody calls", (i, watch) => hold(watch(new Resource(i))));
class Inner { constructor(r) { this.innermost = r; } }
class Outer { constructor(inner) { this.inner = inner; } }
await count("a field of a field", (i, watch) => new Outer(new Inner(watch(new Resource(i)))));
class StoredLater { constructor() { this.later = null; } attach(r) { this.later = r; } }
await count("a field stored later", (i, watch) => { const c = new StoredLater(); c.attach(watch(new Resource(i))); return c; });
class HoldsClosure { constructor(r) { this.dispose = () => r.n; } }
await count("a closure in a field nobody calls", (i, watch) => new HoldsClosure(watch(new Resource(i))));
class HoldsList { constructor(r) { this.list = [r]; } }
await count("a list in a field", (i, watch) => new HoldsList(watch(new Resource(i))));
class HoldsMap { constructor(r) { this.map = new Map([[1, r]]); } }
await count("a map in a field", (i, watch) => new HoldsMap(watch(new Resource(i))));
class HoldsBound { constructor(r) { this.bound = Resource.prototype.valueOf.bind(r); } }
await count("a bound function in a field", (i, watch) => new HoldsBound(watch(new Resource(i))));
class Base { constructor(r) { this.inherited = r; } }
class Derived extends Base { constructor(r) { super(r); this.n = 1; } }
await count("an inherited field", (i, watch) => new Derived(watch(new Resource(i))));
class HoldsSymbol { constructor(s) { this.token = s; } }
await count("a symbol", (i, watch) => new HoldsSymbol(watch(Symbol("t" + i))));
class HoldsFunction { constructor(f) { this.callback = f; } }
await count("a function", (i, watch) => new HoldsFunction(watch(() => i)));
class HoldsBlob { constructor(b) { this.body = b; } }
await count("a blob", (i, watch) => new HoldsBlob(watch(new Blob(["x" + i]))));
class HoldsFile { constructor(f) { this.file = f; } }
await count("a file", (i, watch) => new HoldsFile(watch(Bun.file("/tmp/none-" + i))));
class HoldsBytes { constructor(b) { this.bytes = b; } }
await count("a typed array", (i, watch) => new HoldsBytes(watch(new Uint8Array(8))));
class HoldsPromise { constructor(p) { this.pending = p; } }
await count("a promise", (i, watch) => new HoldsPromise(watch(new Promise(() => {}))));
function storeOnly() { let kept; return r => { kept = r; }; }
await count("a captured variable that is only stored", (i, watch) => { const keep = storeOnly(); keep(watch(new Resource(i))); return keep; });
const ofStatic = newCounter();
class Keeper { static kept = ofStatic.watch(new Resource(1)); }
await collect();
console.log("a static field: cleaned", ofStatic.cleaned(), typeof Keeper);
function serve() {
  const server = Bun.serve({ port: 0, fetch() { return new Response("x"); } });
  server.unref();
  return server;
}
const ofServer = newCounter();
class App { constructor() { this.server = ofServer.watch(serve()); } }
const app = new App();
await collect();
console.log("a server: cleaned", ofServer.cleaned(), typeof app);
