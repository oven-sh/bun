//// string-constants-first-used-between-collections.js
// String constants of every kind are first used between collections: in functions, in code that runs once, as keys, as names of functions.
// The cell of a constant is made at its first use and stays. What it says is compared with text that is put together at run time.
// The groups with an odd number hold only texts whose cells are made the short way, so that nothing else tells the collector of their neighbors.
const log = [];
const hide = globalThis[process.argv.length > 99 ? process.argv[9] : 'String'];
const kept = [];
const keep = s => { kept.push(s); return s.length; };
globalThis.keep = keep;
function churn(n) { let a = []; for (let i = 0; i < n; i++) { a.push({ i, s: 'c' + i, t: [i, i + 1] }); if (a.length > 500) a = []; } return a.length; }
function strings(n) { let a = []; for (let i = 0; i < n; i++) { a.push(hide(i) + '!'); if (a.length > 300) a = []; } return a.length; }
function code(s) { let h = 7; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0; return h; }
