//// typescript-with-js-extension/main.ts
// TypeScript text in files called .js (--loader .js:ts) is TypeScript in which `require`, `module.exports` and `exports` mean CommonJS.
import { describe, measure, Point } from "./shapes.js";
console.log(measure(3, 4), measure(5, 12));
console.log(describe(new Point(1, 2)), describe(new Point(0, 0).scaled(3)));
//// typescript-with-js-extension/shapes.js
"use strict";
const helpers = require("./helpers.js");
class Point {
  x: number;
  y: number;
  constructor(x: number, y: number) {
    this.x = x;
    this.y = y;
  }
  norm(): number {
    return Math.sqrt(helpers.square(this.x) + helpers.square(this.y));
  }
  scaled(by: number): Point {
    return new Point(this.x * by, this.y * by);
  }
}
function measure(x: number, y: number): number {
  const point = new Point(x, y);
  return point.scaled(2).norm() + point.x;
}
function describe(point: Point): string {
  return point.x + "," + point.y + ":" + point.norm();
}
exports.Point = Point;
exports.measure = measure;
exports.describe = describe;
//// use-strict-lookalikes/main.ts
// A directive is told by its text, not by its value: `"use strict"` or `'use strict'`, those twelve characters, as a statement of its own at the start of a body.
// A string with an escape or a line continuation in it, one in parentheses, and a template have the same value and are no directive: the function stays sloppy.
import { answers } from "./sloppy.cjs";
console.log(answers());
//// use-strict-lookalikes/sloppy.cjs
function hexadecimalEscape() { "use\x20strict"; return typeof this; }
function unicodeEscape() { "use\u{20}strict"; return typeof this; }
function lineContinuation() { "use str\
ict"; return typeof this; }
function inParentheses() { ("use strict"); return typeof this; }
function template() { `use strict`; return typeof this; }
function behindParentheses() { ("other"); "use strict"; return typeof this; }
function behindTemplate() { `other`; "use strict"; return typeof this; }
function behindNumber() { 1; "use strict"; return typeof this; }
function partOfSum() { "use strict" + ""; return typeof this; }
function receiver() { "use strict"
  .length; return typeof this; }
function upperCase() { "USE STRICT"; return typeof this; }
function withSpace() { " use strict"; return typeof this; }
function parameters(a) { "use\x20strict"; a = 2; return arguments[0]; }
const arrow = function () { return (() => { ("use strict"); return typeof this; })(); };
const all = [hexadecimalEscape, unicodeEscape, lineContinuation, inParentheses, template, behindParentheses, behindTemplate, behindNumber, partOfSum, receiver, upperCase, withSpace, arrow];
exports.answers = () => all.map(f => f.name + ": " + f.call(5)).join("\n") + "\nparameters: " + parameters(1);
//// var-initializer-under-with.js
// `var x = e` under `with` resolves `x` before it evaluates `e`, so an initializer that adds or deletes the property does not change where the value goes.
function initializerDeletesProperty() {
  var scope = { x: 0 };
  with (scope) {
    var x = (delete scope.x, 1);
  }
  return scope.x + " " + x;
}
console.log("initializer deletes the property:", initializerDeletesProperty());

function initializerAddsProperty() {
  var scope = {};
  with (scope) {
    var x = ((scope.x = 5), 1);
  }
  return scope.x + " " + x;
}
console.log("initializer adds the property:", initializerAddsProperty());

function initializerMovesProperty() {
  var outer = {};
  var inner = { x: "inner" };
  with (outer) {
    with (inner) {
      var x = (delete inner.x, (outer.x = "outer"), "stored");
    }
  }
  return outer.x + " " + inner.x + " " + x;
}
console.log("initializer moves the property to the outer object:", initializerMovesProperty());

function lookupComesFirst() {
  var order = [];
  var scope = new Proxy(
    {},
    {
      has(target, key) {
        if (key === "x") order.push("has x");
        return Reflect.has(target, key);
      },
    },
  );
  with (scope) {
    var x = order.push("initializer");
  }
  return order.join() + " " + x;
}
console.log("the lookup comes first:", lookupComesFirst());

function functionIsNamed() {
  var scope = { named: null };
  with (scope) {
    var named = function () {};
  }
  return scope.named.name + " " + named;
}
console.log("a function is named by the variable:", functionIsNamed());
