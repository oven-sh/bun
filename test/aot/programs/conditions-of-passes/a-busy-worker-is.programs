//// instances-not-made-by-their-class-1.js
// Instances not made by their class 1.
// has instance; fields by stores; readers plain

function errorName(error) {
  return "threw " + (error instanceof Error ? error.constructor.name : typeof error);
}
function describe(value, depth = 0) {
  if (typeof value === "number") return Object.is(value, -0) ? "-0" : String(value);
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "function") return "function";
  if (typeof value === "symbol") return "symbol";
  if (value === null || typeof value !== "object") return String(value);
  if (depth > 1) return "..";
  if (Array.isArray(value)) return "[" + value.map(each => describe(each, depth + 1)).join() + "]";
  return "{" + Object.keys(value).map(key => key + ":" + describe((value )[key], depth + 1)).join() + "}";
}
function probe(label, run) {
  let text;
  try {
    text = describe(run());
  } catch (error) {
    text = errorName(error);
  }
  console.log(label + " " + text);
}
const notes = [];
function note(text) {
  notes.push(text);
}
let answers = true;

class Other {
  t = "other";
  n = "text";
  extra = 9.5;
}

class A {
  
  #p = 7.5;

  constructor(seed) {  this.n = seed + 0.5; this.i = seed | 0;  this.s = "s" + seed; this.o = { k: seed };  }
  sum() { return this.n + this.i; }
  len() { return this.s.length; }
  deep() { return this.o.k; }
  getP() { return this.#p; }
  static hasP(value) { return #p in value; }
}
class B extends A {
  
  #y = 3.5;
  static [Symbol.hasInstance](value) { return answers; }
  constructor(seed) {  super(seed);  this.x = seed + 0.25;  this.t = "t" + seed; this.q = { z: seed };  }
  more() { return this.x + this.n; }
  wide() { return this.t.length + this.s.length; }
  under() { return this.q.z + this.o.k; }
  getY() { return this.#y; }
  static hasY(value) { return #y in value; }
}

function hot(v) {
  return v.n * 2 + v.i + v.s.length + v.o.k + v.x + v.t.length + v.q.z;
}
function hotMethods(v) {
  return v.sum() + v.len() + v.deep() + v.more() + v.wide() + v.under();
}
function hotPrivate(v) {
  return v.getP() + v.getY();
}

function total(list) {
  let sum = 0;
  for (let index = 0; index < list.length; index++) sum += list[index].n + list[index].x + list[index].s.length + list[index].q.z;
  return sum;
}
function totalOfMethods(list) {
  let sum = 0;
  for (const each of list) sum += each.sum() + each.more() + each.getP() + each.getY();
  return sum;
}
class Holder {
  
  constructor(held) { this.held = held; }
  read() { return this.held.n + this.held.x + this.held.t.length + this.held.o.k; }
}
function pass(v) {
  return v;
}
function* walk(v) {
  yield v.n;
  yield v.x + 1;
  yield v.s.length;
  yield v.getY();
}
function readAll(name, given) {
  const v = given ;
  probe(name + " in a list", () => total([honest[0], v, honest[1]]));
  probe(name + " in a list, methods", () => totalOfMethods([honest[0], v, honest[1]]));
  probe(name + " in a holder", () => new Holder(v).read());
  probe(name + " passed on", () => pass(v).n + pass(v).x);
  probe(name + " in a generator", () => [...walk(v)]);
  probe(name + " in a map", () => { const map = new Map([["k", v]]); return map.get("k").n + map.get("k").x; });
  probe(name + " with a default", () => { const { n = "none", x = "none", t = "none" } = v ; return [n, x, t]; });
  probe(name + " n", () => v.n);
  probe(name + " n+1", () => v.n + 1);
  probe(name + " i|0", () => v.i | 0);
  probe(name + " i*2", () => v.i * 2);
  probe(name + " s", () => v.s);
  probe(name + " s.length", () => v.s.length);
  probe(name + " o", () => v.o);
