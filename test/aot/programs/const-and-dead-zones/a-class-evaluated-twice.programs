//// one-early-reader-beside-late-readers/a.mjs
import { results, attempt } from "./results.mjs";
import { fromB } from "./b.mjs";
export function readValue() {
  return value;
}
// Its own module calls it once, behind the declaration. The other module calls it earlier.
export function readOnce() {
  return value;
}
export function bump() {
  counter++;
}
attempt("a, early", readValue);
export const value = { name: "value of a" };
export let counter = 10;
results.push(["a, in the body", value.name, readOnce().name, counter, fromB]);
bump();
results.push(["a, in the body", counter]);
//// one-early-reader-beside-late-readers/b.mjs
import { attempt } from "./results.mjs";
import { value, readValue, readOnce, counter, bump } from "./a.mjs";
attempt("b, the binding", () => value);
attempt("b, readValue", readValue);
attempt("b, readOnce", readOnce);
attempt("b, counter", () => counter);
attempt("b, bump", bump);
export const fromB = "from b";
//// one-early-reader-beside-late-readers/main.mjs
// `a` and `b` import each other. `b` runs first and calls what `a` exports before `a` has run.
import { results } from "./results.mjs";
import { value, readValue, readOnce, counter, bump } from "./a.mjs";
import "./b.mjs";
results.push(["main", value.name, readValue().name, readOnce().name, counter]);
bump();
results.push(["main", counter]);
for (const line of results) console.log(line.join(" "));
//// one-early-reader-beside-late-readers/results.mjs
export const results = [];
export function attempt(label, run) {
  try {
    results.push([label, JSON.stringify(run())]);
  } catch (error) {
    results.push([label, error.constructor.name]);
  }
}
//// some-reads-come-behind-the-declaration.js
// Of one binding some reads come behind its declaration on every path and others may come too early.
////= attempt

// A function reads too early once; the body reads behind the declaration.
function readFirst() {
  return first;
}
attempt("first, early", readFirst);
const first = { name: "first" };
console.log("first, in the body", first.name);
attempt("first, late", readFirst);

// A store in the dead zone throws and is caught. The read behind it is still too early.
attempt("second, stored early", () => {
  second = 5;
  return second;
});
try {
  second = 6;
} catch (error) {
  console.log("second, store in the body", error.constructor.name);
}
attempt("second, read in a function", () => second);
try {
  console.log("second, read in the body", second);
} catch (error) {
  console.log("second, read in the body", error.constructor.name);
}
let second = 1;
console.log("second, behind the declaration", second);
second = 2;
console.log("second, behind a store", second);

// The function that stores is called once, in a try block, in front of the declaration.
function storeThird() {
  third = 30;
}
try {
  storeThird();
} catch (error) {
  console.log("third, stored early", error.constructor.name);
}
try {
  console.log("third", third);
} catch (error) {
  console.log("third, read early", error.constructor.name);
}
let third = 3;
console.log("third", third);

// One arm declares, the other jumps past the declaration.
function inSwitch(key) {
  switch (key) {
    case 0:
      let held = "stored";
      held += ", and changed";
      console.log("switch, behind the declaration", held);
    case 1:
      held += ", twice";
      return held;
  }
}
attempt("switch 0", () => inSwitch(0));
attempt("switch 1", () => inSwitch(1));

// Each turn of a loop has a binding of its own, which starts empty again.
function inLoop(turns) {
  const seen = [];
  for (let turn = 0; turn < turns; turn++) {
    const read = () => own;
    if (turn === 2) {
      try {
        seen.push(read());
      } catch (error) {
        seen.push(error.constructor.name);
      }
    }
    const own = turn * 10;
    seen.push(read(), own);
  }
  return seen.join(",");
}
console.log("loop", inLoop(4));

// The initializer throws: the binding stays empty for whoever got hold of a reader.
let leaked;
function failing() {
  throw new RangeError("no value");
}
function withFailingInitializer() {
  leaked = () => never;
  const never = failing();
  return never;
}
attempt("initializer throws", withFailingInitializer);
attempt("the reader that leaked", () => leaked());

// The initializer reads its own binding.
attempt("reads itself", () => {
  const self = (() => self)() + 1;
  return self;
});

// A class is named in its own heritage and in a static block.
attempt("class in its heritage", () => {
  class Later extends Later {}
  return Later.name;
});
class Counted {
  static made = 0;
  static {
    Counted.made = 1;
  }
  static create() {
    Counted.made++;
    return new Counted();
  }
}
console.log("class", Counted.create() instanceof Counted, Counted.made);

// typeof does not forgive the dead zone.
attempt("typeof", () => typeof fourth);
const fourth = 4;
attempt("typeof", () => typeof fourth);

// A default value reads a later parameter, and a closure in a default value reads a binding of the body's scope.
function parameters(a = b, b = 1) {
  return [a, b];
}
attempt("parameters", () => parameters());
attempt("parameters", () => parameters(1));

// A generator stops in front of the declaration.
function* stepwise() {
  const read = () => late;
  yield read;
  const late = "late";
  yield read;
  yield late;
}
const steps = stepwise();
const early = steps.next().value;
attempt("generator, early", early);
steps.next();
attempt("generator, late", early);
console.log("generator", steps.next().value);
//// static-fields-read-through-the-class-object-before-they-are-defined.js
// Static fields read through the class object before they are defined.
function attempt(f) { try { return f(); } catch (e) { return "threw " + e.constructor.name; } }
class C {
  static a = C.probe();
  static b = { x: 1 };
  static probe() { return C.b === undefined ? "undefined" : C.b.x; }
}
console.log(C.a, C.b.x);
class D {
  static a = attempt(() => this.b.x);
  static b = { x: 1 };
}
console.log(D.a);
class E {
  static a = attempt(() => Reflect.get(E, "b").x);
  static c = attempt(() => Object.getOwnPropertyDescriptor(E, "b").value.x);
  static d = attempt(() => Object.keys(E).join());
  static b = { x: 1 };
}
console.log(E.a, E.c, E.d);
class F { static a = attempt(() => G.b.x); }
class G extends F { static b = { x: 1 }; }
console.log(F.a);
class Base { static make() { return attempt(() => this.b.x); } }
class Sub extends Base { static a = Sub.make(); static a2 = super.make(); static b = { x: 2 }; }
console.log(Sub.a, Sub.a2);
//// tdz-reads.ts
// Variables that are read before they are initialized.
function early() { return later }
function attempt(f: () => unknown) { try { return String(f()) } catch (e) { return (e as Error).name } }
console.log(attempt(early))
const later = Math.abs(-5)
console.log(attempt(early))
function earlyVar() { return v }
console.log(attempt(earlyVar))
var v = 7
console.log(attempt(earlyVar))
function earlyObject() { return box.n }
console.log(attempt(earlyObject))
let box = { n: 1 }
console.log(attempt(earlyObject))
function inner() {
  const read = () => local
  const first = attempt(read)
  const local = String("set")
  return first + " " + attempt(read)
}
console.log(inner())
var never: number | undefined
console.log(attempt(() => never))
class Late { static make() { return new Late() } }
console.log(attempt(() => typeof Late.make()))
