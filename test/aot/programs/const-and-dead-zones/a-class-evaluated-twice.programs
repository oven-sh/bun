// Behind a test for the dead zone that has passed, the binding is out of it for good. Behind one that threw and was caught it is not.
////= attempt

function readTwice() {
  let first = "nothing";
  try {
    first = changing;
  } catch (error) {
    first = error.constructor.name;
  }
  return first + " then " + changing;
}
