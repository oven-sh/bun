//// a-class-is-read-above-its-declaration-below-a-comment-that-only-resembles-the-first-line-of-bun-build.mjs
//@bun
// @bun
// The first line is not the one that `bun build --target=bun` writes, and a class is read above its declaration.
function attempt(read) {
  try {
    console.log(typeof read());
  } catch (error) {
    console.log(error.name);
  }
}
attempt(() => Late);
class Late {}
attempt(() => Late);
//// a-class-is-read-above-its-declaration-in-the-output-of-bun-build-behind-a-hashbang.mjs
#!/usr/bin/env bun
// @bun
// The first line that `bun build --target=bun` writes follows a hashbang, and a class is read above its declaration.
function attempt(read) {
  try {
    console.log(typeof read());
  } catch (error) {
    console.log(error.name);
  }
}
attempt(() => Late);
class Late {}
attempt(() => Late);
//// a-class-is-read-above-its-declaration-in-the-output-of-bun-build.mjs
// @bun
// A class whose body calls nothing is read above its declaration, in a file with the first line that `bun build --target=bun` writes.
function show(value) {
  console.log(typeof value);
}
function attempt(read) {
  try {
    show(read());
  } catch (error) {
    console.log(error.name);
  }
}
function takeDefault(value = Late) {
  return value;
}
function readAll() {
  try {
    show(Late);
  } catch (error) {
    console.log(error.name);
  }
  try {
    console.log(typeof Late);
  } catch (error) {
    console.log(error.name);
  }
  try {
    show(new Late());
  } catch (error) {
    console.log(error.name);
  }
  try {
    show(Late.first);
  } catch (error) {
    console.log(error.name);
  }
  attempt(() => Late);
  attempt(takeDefault);
}
try {
  show(Late);
} catch (error) {
  console.log(error.name);
}
try {
  console.log(typeof Late);
} catch (error) {
  console.log(error.name);
}
readAll();
class Late {
  static first = 1;
  second = 2;
  method() {
    return this.second;
  }
}
readAll();
console.log(new Late().method());
//// a-default-export-that-is-a-class-is-read-above-its-statement-in-the-output-of-bun-build.mjs
// @bun
// The file imports its own default export and reads it above the statement that exports it. Its first line is the one that `bun build --target=bun` writes.
import value from "./a-default-export-that-is-a-class-is-read-above-its-statement-in-the-output-of-bun-build.mjs";
function attempt(read) {
  try {
    console.log(typeof read());
  } catch (error) {
    console.log(error.name);
  }
}
attempt(() => value);
export default class {
  static first = 1;
}
attempt(() => value);
