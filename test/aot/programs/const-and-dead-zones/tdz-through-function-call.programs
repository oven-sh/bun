//// texts-joined-from-constants-that-are-read-in-their-dead-zones.js
// A text joined from constants is known when the program is built, and still throws where one of the constants is read in its dead zone.
function attempt(f) { try { return f(); } catch (e) { return "threw " + e.constructor.name; } }
const early = () => `${family}/early`;
const earlySum = () => family + "/early";
const earlyNumber = () => size * 2 + 1;
console.log(attempt(early), attempt(earlySum), attempt(earlyNumber));
const family = "~library/Step";
const size = 20;
const held = `${family}/held`;
const summed = family + "/summed";
const nested = `${held}:${summed}:${size + 1}`;
console.log(attempt(early), attempt(earlySum), attempt(earlyNumber), held, summed, nested);
const shared = { [held]: 1, [summed]: 2, [nested]: 3 };
const made = Object.create(shared);
made[held] = 4;
console.log(Object.keys(made), Object.keys(shared), made[held], made[summed], made[nested], held in made, `${family}/held` in made, family + "/absent" in made);
function inBlock(flag) {
  if (flag) return attempt(() => `${later}!`);
  const value = attempt(() => `${later}?`);
  const later = "later";
  return value + `${later}.`;
}
console.log(inBlock(true), inBlock(false));
for (let turn = 0; turn < 2; turn++) {
  const before = attempt(() => `${each}-${turn}`);
  const each = "each";
  console.log(before, `${each}-${turn}`, `${each}-x`);
}
switch (size) {
  case 20:
    console.log(attempt(() => `${inCase}!`));
  case 21:
    const inCase = "case";
    console.log(`${inCase}!`);
}
//// the-type-of-a-binding-does-not-hold.ts
// The checker's word on a binding is no proof. A read that needs no test for the dead zone still needs the test of its type.
interface Settings {
  port: number;
  name: string;
}
function attempt(label: string, run: () => unknown) {
  try {
    console.log(label, JSON.stringify(run()));
  } catch (error) {
    console.log(label, (error as Error).constructor.name);
  }
}

////= lines	readSettings	Settings	settings
////= lines	readCount	number	count
attempt("settings, early", readSettings);
attempt("count, early", readCount);
const settings: Settings = JSON.parse('{"name":7,"extra":true,"port":"eighty"}');
let count: number = JSON.parse('"three"');
console.log("settings, in the body", typeof settings.port, settings.port, typeof settings.name, settings.name, Object.keys(settings).join());
console.log("count, in the body", typeof count, count + 1);
attempt("settings, late", readSettings);
attempt("count, late", readCount);
count = JSON.parse("[4]");
console.log("count, stored again", typeof count, count + 1);

function captured(text: string) {
  const read = (): Settings => held;
  attempt("captured, early", read);
  const held: Settings = JSON.parse(text);
  console.log("captured, in the body", typeof held.port, held.port, typeof held.name, held.name);
  attempt("captured, late", read);
  return read;
}
console.log(captured('{"port":1,"name":"right"}')().name);
console.log(captured('{"name":null}')().name);
console.log(captured("[1,2]")().port);
attempt("captured, null", () => captured("null")());
//// ts-namespace-stores-allowed.ts
// Stores to the exported variable of a TypeScript `namespace`, which are allowed, unlike stores to an imported binding.
declare const console: { log(...all: unknown[]): void };
namespace N { export let x = 1; export const read = () => x; }
N.x = 2; console.log(N.x, N.read());
[N.x] = [3]; console.log(N.x, N.read());
N.x += 4; console.log(N.x, N.read());
N.x++; console.log(N.x, N.read());
for (N.x of [9]) ; console.log(N.x, N.read());
