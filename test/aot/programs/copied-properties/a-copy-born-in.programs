//// a-copy-born-in-the-cell-of-its-holder.ts
type Tally = { tries: number; busy: number; plain: boolean };
type Answer = { tally: Tally; verdict: string };
function decide(tally: Tally, most: number, kind: string): Answer {
  if (kind === "busy") return { tally: { ...tally, busy: tally.busy + 1 }, verdict: tally.busy < most ? "again" : "fail" };
  if (kind === "tries") return { tally: { ...tally, tries: tally.tries + 1 }, verdict: tally.tries < most ? "again" : "fail" };
  return { tally, verdict: "fail" };
}
let tally: Tally = { tries: 0, busy: 0, plain: false };
const kept: Answer[] = [];
const kinds = ["tries", "busy", "none", "tries", "tries", "busy", "tries"];
for (const kind of kinds) {
  const answer = decide(tally, 3, kind);
  kept.push(answer);
  tally = answer.tally;
  console.log(kind, answer.verdict, JSON.stringify(tally));
}
console.log(JSON.stringify(kept));
console.log(kept.every((answer, index) => index + 1 === kept.length || kinds[index + 1] !== "none" || kept[index + 1].tally === answer.tally));
//// a-copy-born-in-the-cell-of-its-holder-is-kept-by-closures-over-one-variable/keeper.ts
import { NOTHING_YET, decide, type Limits, type Trouble, type Verdict } from "./policy";
export class StatusError extends Error {
  constructor(public status: number) {
    super("status " + status);
  }
}
function classify(error: unknown, couldHelp: boolean): Trouble | undefined {
  if (error instanceof StatusError) {
    if (error.status === 401 || error.status === 403) return undefined;
    return error.status === 529 && couldHelp ? { kind: "busy", after: 1 } : { kind: "status", status: error.status };
  }
  return undefined;
}
export function createKeeper(limits: Limits, left?: { count: number }) {
  let tally = NOTHING_YET;
  let tallyBefore = tally;
  let reported = false;
  let ended = false;
  const spent = () => left !== undefined && left.count <= 0;
  function count(error: unknown, couldHelp: boolean): { trouble: Trouble; verdict: Verdict } | undefined {
    if (ended) return undefined;
    try {
      const trouble = classify(error, couldHelp);
      if (trouble === undefined) return undefined;
      const result = decide(trouble, tally, limits, true);
      tally = result.tally;
      return { trouble, verdict: result.verdict };
    } catch {
      return undefined;
    }
  }
  function compare(expected: { trouble: Trouble; verdict: Verdict } | undefined, actual: Verdict | undefined): void {
    if (reported || expected === undefined || expected.verdict === actual) return;
    reported = true;
    console.log("differs", expected.verdict, actual);
  }
  return {
    spent,
    tally: () => tally,
    restore() {
      tally = tallyBefore;
    },
    remember() {
      tallyBefore = tally;
      ended = false;
    },
    gaveUp(error: unknown): Verdict {
      if (spent()) return "fail";
      const expected = count(error, false);
      const actual = expected?.verdict === "againPlain" ? "againPlain" : "fail";
      compare(expected, actual);
      return actual;
    },
    report(error: unknown, actual: Verdict | undefined, known?: { couldHelp: boolean }): void {
      const { plain } = tally;
      const expected = count(error, known?.couldHelp ?? false);
      tally = { ...tally, plain };
      if (expected === undefined && actual === "again") {
        tally = {
          ...tally,
          tries: Math.min(tally.tries + 1, limits.most),
        };
      }
      compare(expected, actual);
    },
  };
}
//// a-copy-born-in-the-cell-of-its-holder-is-kept-by-closures-over-one-variable/main.ts
import { StatusError, createKeeper } from "./keeper";
const keeper = createKeeper({ most: 10, mostSlept: 3 }, { count: 5 });
const errors: unknown[] = [new TypeError("no response"), new StatusError(401), new StatusError(500), new StatusError(529), "text", undefined];
for (const error of errors) {
  keeper.report(error, "again");
  keeper.report(error, "again", { couldHelp: true });
  keeper.report(error, "fail");
  keeper.report(error, undefined);
  console.log(JSON.stringify(keeper.tally()));
}
keeper.remember();
console.log(keeper.gaveUp(new StatusError(500)), keeper.spent());
keeper.restore();
console.log(JSON.stringify(keeper.tally()));
//// a-copy-born-in-the-cell-of-its-holder-is-kept-by-closures-over-one-variable/policy.ts
export type Tally = {
  tries: number;
  slept: number;
  busy: number;
  stalls: number;
  cuts: number;
  early: number;
  filtered: number;
  plain: boolean;
};
export const NOTHING_YET: Tally = { tries: 0, slept: 0, busy: 0, stalls: 0, cuts: 0, early: 0, filtered: 0, plain: false };
export type Limits = { most: number; mostSlept: number };
export type Trouble = { kind: "none" } | { kind: "busy"; after: number } | { kind: "status"; status: number };
export type Verdict = "fail" | "again" | "againPlain" | "keep";
export function decide(trouble: Trouble, tally: Tally, limits: Limits, counted: boolean): { tally: Tally; verdict: Verdict } {
  if (trouble.kind === "busy") return { tally: { ...tally, busy: tally.busy + 1 }, verdict: tally.busy < limits.most ? "again" : "fail" };
  if (trouble.kind === "status" && trouble.status >= 500 && counted) return { tally: { ...tally, tries: tally.tries + 1 }, verdict: tally.tries < limits.most ? "again" : "fail" };
  return { tally, verdict: "fail" };
}
