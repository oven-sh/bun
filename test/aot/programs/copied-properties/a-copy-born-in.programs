//// a-copy-goes-where-its-source-never-went.ts
// A record that only typed code ever sees is copied by a literal written under a type parameter, and the COPY goes where the record never went: into code that nobody compiled with types,
// which deletes, redefines, freezes and stores values of other types. What the compiler knows about the record's type must not be taken for granted of the copy, nor the other way round.
type Account = { id: number; owner: string; balance: number; open: boolean; tags: string[] };
function clone<T>(source: T): T {
    return { ...source };
}
function patched<T extends { id: number }>(source: T, id: number): T {
    return { ...source, id };
}
const hidden = (0, eval)(`({
    remove(o, k) { delete o[k]; return o; },
    put(o, k, v) { o[k] = v; return o; },
    accessor(o, k, v) { Object.defineProperty(o, k, { get() { return v; }, enumerable: true, configurable: true }); return o; },
    hide(o, k) { Object.defineProperty(o, k, { enumerable: false }); return o; },
    freeze(o) { return Object.freeze(o); },
    below(o, p) { return Object.setPrototypeOf(o, p); },
    same(a, b) { return a === b; },
})`) as {
    remove<T>(o: T, k: string): T; put<T>(o: T, k: string, v: unknown): T; accessor<T>(o: T, k: string, v: unknown): T; hide<T>(o: T, k: string): T;
    freeze<T>(o: T): T; below<T>(o: T, p: object | null): T; same(a: unknown, b: unknown): boolean;
};
function total(account: Account): string {
    return account.id + "/" + account.owner + "/" + account.balance + "/" + account.open + "/" + (account.tags ? account.tags.length : "none");
}
const lines: string[] = [];
function say(title: string, source: Account, copy: Account) {
    lines.push(title + ": " + total(source) + " | " + total(copy) + " | " + Object.keys(source).join() + " | " + Object.keys(copy).join() + " | " + JSON.stringify(copy));
}
const make = (id: number): Account => ({ id, owner: "o" + id, balance: id * 10, open: true, tags: ["a"] });

// One record that is made once, at the top of the module.
const single = make(1);
const twin = clone(single);
lines.push("identity: " + (single === twin) + " " + hidden.same(single, twin) + " " + (clone(twin) === twin) + " " + (patched(single, 1) === single));
twin.balance = 99;
say("a store into the twin", single, twin);
single.owner = "changed";
say("a store into the single one", single, twin);

for (let round = 0; round < 40; round++) {
    const source = make(round);
    const title = "round " + round + " ";
    switch (round % 10) {
    case 0: say(title + "removed", source, hidden.remove(clone(source), "balance")); break;
    case 1: say(title + "text in a number", source, hidden.put(clone(source), "balance", "much")); break;
    case 2: say(title + "undefined in a string", source, hidden.put(patched(source, -1), "owner", undefined)); break;
    case 3: say(title + "accessor", source, hidden.accessor(clone(source), "id", 1000)); break;
    case 4: say(title + "hidden", source, hidden.hide(patched(source, -2), "open")); break;
    case 5: { const copy = hidden.freeze(clone(source)); try { copy.balance = 5; } catch (error) { lines.push((error as Error).constructor.name); } say(title + "frozen", source, copy); break; }
    case 6: say(title + "below another object", source, hidden.below(hidden.remove(clone(source), "owner"), { owner: "inherited" })); break;
    case 7: say(title + "a new name", source, hidden.put(clone(source), "added", round)); break;
    case 8: say(title + "removed and put back", source, hidden.put(hidden.remove(clone(source), "id"), "id", 7)); break;
    case 9: say(title + "a copy of a changed copy", source, clone(hidden.put(hidden.remove(clone(source), "tags"), "balance", null))); break;
    }
}
console.log(lines.join("\n"));
//// a-copy-is-an-object-of-its-own.js
// Whatever is done to a copy stays with the copy, and whatever is done to the source afterwards stays with the source: stores, stores of another kind of value, new names, deletes,
// redefinitions, freezing, another prototype. Copies of copies behave alike. The sources have passed through text that is evaluated at run time.
const lines = [];
const unknown = new Function("value", "return value" + process.argv[0].slice(process.argv[0].length));
const show = object =>
  Reflect.ownKeys(object)
    .map(key => String(key) + "=" + String(object[key]))
    .join(",");

function copy(source) {
  return { ...source };
}
////= lines-3	replace	source	a
function make(a, b, c) {
  return { a, b, c };
}

const changes = {
  store(object) {
    object.b = 20;
  },
  storeOtherKind(object) {
    object.a = "text";
    object.b = 1.5;
    object.c = { nested: true };
  },
  addName(object) {
    object.added = 1;
    object.alsoAdded = 2;
  },
  addIndex(object) {
    object[0] = "zero";
  },
  addSymbol(object) {
    object[Symbol.for("added")] = 1;
  },
  deleteFirst(object) {
    delete object.a;
  },
  deleteAll(object) {
    delete object.a;
    delete object.b;
    delete object.c;
  },
  deleteAndAddBack(object) {
    delete object.b;
    object.b = "back";
  },
  defineGetter(object) {
    Object.defineProperty(object, "b", { get: () => "got", enumerable: true, configurable: true });
  },
  hide(object) {
    Object.defineProperty(object, "b", { enumerable: false });
  },
  freeze(object) {
    Object.freeze(object);
  },
  seal(object) {
    Object.seal(object);
  },
  otherPrototype(object) {
    Object.setPrototypeOf(object, { inherited: 1 });
  },
  becomePrototype(object) {
    lines.push("heir reads " + Object.create(object).c);
  },
  assign(object) {
    Object.assign(object, { c: 30, d: 40 });
  },
};

for (const [name, change] of Object.entries(changes)) {
  const source = unknown(make(1, 2, 3));
  const first = copy(source);
  const second = replace(source, 10);
  const third = copy(first);
  change(first);
  lines.push(name + " on a copy: " + [source, first, second, third].map(show).join(" | "));
  lines.push(name + " copied again: " + show(copy(unknown(first))) + " | " + show(replace(unknown(first), 11)));

  const other = unknown(make(4, 5, 6));
  const before = copy(other);
  change(other);
  const after = copy(other);
  lines.push(name + " on the source: " + [other, before, after].map(show).join(" | "));
  lines.push(name + " states: " + [first, before, after].map(object => [Object.isFrozen(object), Object.isExtensible(object), Object.getPrototypeOf(object) === Object.prototype].join()).join(" | "));
}

// The functions an object holds are the same functions in its copy.
const withFunctions = unknown({
  a: 1,
  method() {
    return this.a;
  },
  arrow: () => 2,
  plain: function () {
    return 3;
  },
});
const copied = copy(withFunctions);
lines.push([copied.method === withFunctions.method, copied.arrow === withFunctions.arrow, copied.plain === withFunctions.plain, replace(withFunctions, 7).method()].join());

// Many turns, so that the collector runs while copies are made and dropped.
let chain = unknown(make(0, "kept", [1, 2, 3]));
let total = 0;
const kept = [];
for (let turn = 1; turn <= 200000; turn++) {
  chain = replace(chain, turn);
  if (turn % 20000 === 0) kept.push(chain);
  total += chain.a + chain.c.length;
}
lines.push(total + " " + kept.map(show).join(" | "));

console.log(lines.join("\n"));
//// a-copy-is-another-object-than-its-source.ts
// What is known about one object because of where it was made (it is the only one of its kind, it is a constant, it never leaves its function, another object lies inside it)
// says nothing about a copy of it: the copy is another object, with the same values, and what is stored in one is not seen in the other.
const lines: string[] = [];
function say(title: string, ...parts: unknown[]) {
    lines.push(title + ": " + parts.map((part) => (typeof part === "string" ? part : JSON.stringify(part))).join(" "));
}
function withId<T extends object>(source: T, id: number) {
    return { ...source, id };
}
function alone<T extends object>(source: T) {
    return { ...source };
}
function ofAnything(source: any, id: number) {
    return { ...source, id };
}

// A constant written once at the top of the module.
const defaults = { id: 0, label: "d", ratio: 2.5, on: true };
for (let round = 0; round < 3; round++) {
    const copy = withId(defaults, round + 1);
    copy.label = "changed " + round;
    copy.ratio += 1;
    say("a constant", copy, defaults, copy === (defaults as object));
}
const second = alone(defaults);
second.on = false;
defaults.label = "the source changed";
say("a constant, afterwards", second, defaults);

// The only object of its kind, with values that are known when it is made.
const only = { id: lines.length, made: String(lines.length), list: [lines.length], inner: { deep: lines.length } };
const ofOnly = withId(only, -1);
ofOnly.made = "copy";
ofOnly.list.push(1);
ofOnly.inner.deep++;
say("the only one", ofOnly, only, ofOnly.list === only.list, ofOnly.inner === only.inner);
ofOnly.inner = { deep: 100 };
ofOnly.list = [];
say("the only one, other members", ofOnly, only);

// Objects and lists written inside a literal.
type Point = { x: number; y: number };
type Shape = { at: Point; size: Point; tags: string[]; weights: number[]; name: string };
function shape(n: number): Shape {
    return { at: { x: n, y: n + 1 }, size: { x: 2 * n, y: 3 * n }, tags: ["a" + n, "b"], weights: [n, n + 0.5], name: "s" + n };
}
function measure(s: Shape): number {
    return s.at.x + s.at.y * 10 + s.size.x * 100 + s.size.y * 1000 + s.tags.length + s.tags[0]!.length + s.weights[1]! + s.name.length;
}
let sum = 0;
const keptShapes: (Shape & { id: number })[] = [];
for (let round = 0; round < 3000; round++) {
    const source = shape(round & 7);
    const copy = withId(source, round);
    sum += measure(copy) + measure(source);
    if (copy.at !== source.at || copy.tags !== source.tags || copy.weights !== source.weights)
        sum += 1e9;
    copy.at.x++;
    sum += source.at.x;
    copy.size = { x: 1, y: 1 };
    sum += measure(copy) - measure(source);
    if ((round & 255) === 0)
        keptShapes.push(copy);
}
say("objects inside", sum, keptShapes.length, keptShapes[3], measure(keptShapes[5]!));
say("objects inside, of anything", ofAnything(shape(2), 9), measure(ofAnything(shape(3), 1)), measure(alone(shape(4))));
function row(props: { cells: string[]; at: Point }) {
    return props.cells.map((cell) => cell + props.at.x).join();
}
const call = (target: any, props: any, ...children: any[]) => target({ ...props, children });
say("as a component gets them", call(row, { cells: ["a", "b"], at: { x: 1, y: 2 } }), call(row, { cells: [], at: { x: 3, y: 4 } }, 1, 2));

// One literal, one call, one reader with a declared type.
const render = (tag: any, props: any, ...children: any[]): any => (typeof tag === "function" ? tag({ ...props, children }) : tag + "(" + children.join() + ")");
const cell = function (props: { children?: any }) {
    return render("cell", null, props.children);
};
const cellsOf = (props: { cells: string[] }) => render("row", null, props.cells.map((one) => render(cell, null, one)));
say("one literal with a list", render(cellsOf, { cells: ["a", "b"] }));
const placeOf = (props: { place: { x: number; y: number }; name: string }) => props.name + props.place.x + props.place.y;
say("one literal with an object", render(placeOf, { place: { x: 1.5, y: 2 }, name: "p" }));
type Reply<T> = { ok: true; data: T; reply: { body: T; code: number } } | { ok: false; reason: string };
type Routed<T> = Reply<T> & { route: "direct" | "far" };
function reply<T>(data: T): Reply<T> {
    return data === null ? { ok: false, reason: "null" } : { ok: true, data, reply: { body: data, code: 2 } };
}
function routed<T>(data: T): Routed<T> {
    return { ...reply(data), route: "direct" };
}
function codeOf(result: Routed<unknown>) {
    return result.ok ? result.route + result.reply.code + JSON.stringify(result.reply.body) : result.reason;
}
say("a member of a union with an object inside", codeOf(routed(1)), codeOf(routed("s")), codeOf(routed(null)), codeOf(routed({ k: 1 })));

// A source that never leaves its function; the copy does, and lives on.
function leaves(n: number) {
    const local = { a: n, b: n + 0.5, c: "c" + n, d: { e: n } };
    return withId(local, n);
}
const left: ReturnType<typeof leaves>[] = [];
for (let round = 0; round < 20000; round++) {
    const made = leaves(round);
    if ((round & 1023) === 0)
        left.push(made);
}
say("the source stayed", left.length, left[0], left[19], left.reduce((total, one) => total + one.a + one.b + one.c.length + one.d.e + one.id, 0));
say("a literal in the spread", withId({ a: 1, b: [2], c: { d: 3 } }, 4), alone({ ...{ a: 1 }, b: { c: 2 } }));

// Functions written in the literal.
function counter(start: number) {
    return { n: start, next() { return ++this.n; }, peek: () => start, twice(this: { n: number }) { return this.n * 2; } };
}
const first = counter(5);
const copied = withId(first, 1);
say("functions", copied.next(), copied.next(), first.n, first.next(), copied.n, copied.peek(), copied.twice(), copied.next === first.next, copied.peek === first.peek);
const neverCalled = counter(7);
const ofNeverCalled = alone(neverCalled);
say("functions that nobody had read", ofNeverCalled.next === neverCalled.next, ofNeverCalled.next(), neverCalled.n, ofNeverCalled.twice());

// Instances, lists and other things are copied as what a spread makes of them.
class Pair { constructor(public left: number, public right: Point) {} sum() { return this.left + this.right.x; } }
const pair = new Pair(1, { x: 2, y: 3 });
const ofPair = withId(pair, 4);
say("an instance", ofPair, ofPair instanceof Pair, "sum" in ofPair, ofPair.right === pair.right, Object.getPrototypeOf(ofPair) === Object.prototype);
say("a list, a string, nothing", ofAnything([1, [2]], 3), ofAnything("ab", 1), ofAnything(null, 1), ofAnything(undefined, 2), ofAnything(7, 3));

// A copy of a copy of a copy, each changed.
let chain = withId(shape(1), 0);
const links = [chain];
for (let round = 1; round < 5; round++) {
    chain = withId(chain, round);
    chain.name += round;
    chain.at = { x: chain.at.x + 1, y: round };
    links.push(chain);
}
say("a chain", links.map((link) => link.id + link.name + link.at.x + link.at.y + measure(link)).join());
console.log(lines.join("\n"));
//// a-copy-of-anything-that-gets-more-names.ts
// `{ ...source, name, id }` where no type says which names the source has: a type variable, `object`, `any`, `unknown` behind a cast. The copy is an object of its own with Object.prototype above it,
// it has the source's own enumerable properties as plain values in the source's order, a name that the source had keeps its place and takes the new value, and the source is left as it was.
const lines: string[] = [];
const describe = (value: object) => Reflect.ownKeys(value).map(key => {
  const d = Object.getOwnPropertyDescriptor(value, key)!;
  return String(key) + "=" + ("value" in d ? JSON.stringify(d.value) ?? String(d.value) : "accessor") + (d.writable ? "w" : "-") + (d.enumerable ? "e" : "-") + (d.configurable ? "c" : "-");
}).join(" ");
const show = (name: string, value: object) => void lines.push(name + " | " + describe(value) + " | " + (Object.getPrototypeOf(value) === Object.prototype ? "plain" : "OTHER PROTOTYPE") + (Object.isExtensible(value) ? "" : " NOT EXTENSIBLE"));

const stamp = <T extends object>(source: T, name: string, id: number): T & { name: string; id: number } => ({ ...source, name, id });
const stampObject = (source: object, name: string, id: number) => ({ ...source, name, id });
const stampAny = (source: any, name: string, id: number) => ({ ...source, name, id });
const stampThenSpread = <T extends object, U extends object>(source: T, other: U, id: number) => ({ ...source, id, ...other, last: true });
const stampUnderCondition = <T extends object>(source: T, on: boolean, id: number) => ({ ...source, ...(on && { id }), end: 1 });

class Point { x = 1; y = 2; #hidden = 3; get sum() { return this.x + this.y + this.#hidden; } static origin = new Point(); }
class Named extends Point { name = "of the class"; }
const symbol = Symbol("s");
let reads = 0;
const withGetter = { get computed() { reads++; return "read " + reads; }, plain: 1 };
const hidden = Object.defineProperty({ seen: 1 }, "unseen", { value: 2, enumerable: false });
const frozen = Object.freeze({ a: 1, name: "frozen" });
const sealed = Object.seal({ a: 1, id: "sealed" });
const inherits = Object.create({ above: 1 }, { own: { value: 2, enumerable: true } }) as object;
const without = Object.assign(Object.create(null) as object, { bare: 1 });
const proxied = new Proxy({ p: 1, q: 2 }, { ownKeys: target => { lines.push("ownKeys"); return Reflect.ownKeys(target).reverse(); }, get: (target, key) => { lines.push("get " + String(key)); return Reflect.get(target, key); } });
const sources: [string, object][] = [
  ["a record", { a: 1, b: "x" }], ["a record with both names", { id: "old", a: 1, name: "old" }], ["an empty record", {}],
  ["parsed", JSON.parse('{"a":2,"b":"parsed"}')], ["parsed with both names", JSON.parse('{"name":"old","z":1,"id":0}')], ["parsed with __proto__", JSON.parse('{"__proto__":{"evil":1},"a":1}')],
  ["indexes", { 2: "two", b: 1, 0: "zero" }], ["a symbol", { [symbol]: 1, a: 2 }], ["an instance", new Point()], ["an instance of a subclass", new Named()],
  ["a getter", withGetter], ["a hidden name", hidden], ["frozen", frozen], ["sealed", sealed], ["inherits", inherits], ["without a prototype", without], ["a proxy", proxied],
  ["a list", ["x", "y"]], ["a function", Object.assign(() => 1, { extra: 1 })], ["a map", new Map([[1, 2]])], ["a date", new Date(0)], ["an error", Object.assign(new Error("m"), { code: 1 })],
  ["a text object", new String("ab")], ["a typed array", new Uint8Array([7, 8])], ["arguments", (function (..._: number[]) { return arguments; })(1, 2)],
];
for (const [name, source] of sources) {
  const before = name === "a proxy" || name === "a getter" ? "" : describe(source);
  show(name + ", T", stamp(source, "n", 1));
  show(name + ", object", stampObject(source, "n", 2));
  show(name + ", any", stampAny(source, "n", 3));
  show(name + ", then another", stampThenSpread(source, { id: "other", more: 1 }, 4));
  show(name + ", under a condition", stampUnderCondition(source, name.length % 2 === 0, 5));
  if (before !== "" && before !== describe(source)) lines.push("THE SOURCE OF " + name + " HAS CHANGED: " + describe(source));
}
for (const source of [undefined, null, 0, 1.5, true, "", "ab", 10n, symbol]) show("any of " + String(source), stampAny(source, "n", 1));

const first = { a: 1, inner: { deep: 1 } };
const copy = stamp(first, "n", 1);
copy.a = 2; copy.inner.deep = 2; (copy as Record<string, unknown>).added = 3; delete (copy as Partial<typeof copy>).id;
show("the copy, changed", copy); show("its source", first);
const again = stamp(copy, "m", 9);
show("a copy of the copy", again);
function many(n: number): number { let sum = 0; for (let i = 0; i < n; i++) { const made = stamp(sources[i % 7][1], "s" + (i & 1), i); sum += made.id + made.name.length + Object.keys(made).length; } return sum; }
lines.push("many " + many(300));
const readers = [(o: { id: number; name: string }) => o.id + o.name, (o: { id: number; name: string }) => Object.entries(o).join(";"), (o: { id: number; name: string }) => JSON.stringify(o)];
for (const reader of readers) lines.push(reader(stamp({ z: 1 }, "r", 7)) + " | " + reader({ id: 1, name: "literal" }) + " | " + reader(stamp(JSON.parse('{"id":5}') as object, "p", 8)));
console.log(lines.join("\n"));
//// a-copy-repeats-with-fields-between-names-that-are-no-fields.ts
// The same copy again and again: the source mixes fields of the target with names that the target's type does not list, so fields are created between added names,
// and some targets have such names before the copy. Then one copy in the row brings a value that its field does not take, and the row goes on.
type Style = {
  color?: string;
  width?: number;
  bold?: boolean;
  margin?: number;
  label?: string;
  onPress?: () => string;
};

function parse(text: string): any {
  return JSON.parse(text);
}

function show(title: string, object: object) {
  console.log(title, JSON.stringify(object), Object.keys(object).join(","));
}

function withDefaults(given: any): Style {
  return { color: "black", ...given, bold: true };
}

function ontoNamesOfItsOwn(first: any, second: any): Style {
  return { ...first, ...second, margin: 4 };
}

function assigned(given: any): Style {
  const style: Style = { width: 1 };
  return Object.assign(style, given);
}

const mixed = '{"extraA":1,"width":10,"extraB":"two","label":"x","extraC":[3],"margin":2}';
const onlyNames = '{"first":1,"second":2}';
for (let round = 0; round < 6; ++round) {
  show("defaults " + round, withDefaults(parse(mixed)));
  show("own names " + round, ontoNamesOfItsOwn(parse(onlyNames), parse(mixed)));
  show("assigned " + round, assigned(parse(mixed)));
}

const odd = '{"extraA":1,"width":"wide","extraB":"two","label":7,"extraC":[3],"margin":2}';
show("odd defaults", withDefaults(parse(odd)));
show("odd own names", ontoNamesOfItsOwn(parse(onlyNames), parse(odd)));
show("odd assigned", assigned(parse(odd)));
for (let round = 0; round < 3; ++round) {
  show("defaults again " + round, withDefaults(parse(mixed)));
  show("own names again " + round, ontoNamesOfItsOwn(parse(onlyNames), parse(mixed)));
  show("assigned again " + round, assigned(parse(mixed)));
}

// A typed source with a name added behind its back, and a callback that nobody has called yet.
function styled(index: number): Style {
  const style: Style = { width: index, onPress: () => "pressed " + index };
  (style as any)["data-" + (index % 2)] = index;
  style.label = "l" + index;
  return style;
}
for (let index = 0; index < 8; ++index) {
  const copy = withDefaults(styled(index));
  show("typed " + index, copy);
  console.log(copy.onPress!(), copy.width, copy.label, copy.bold);
  const changed: Style = { ...copy, width: index * 2 };
  delete changed.color;
  show("changed " + index, { ...changed, color: "red" });
}
//// a-copy-that-repeats-meets-a-target-in-another-state.ts
// A copy between two shapes is repeated many times, so whatever the run time has learned from the earlier copies is in use, and then the same two shapes meet
// with the target in another state: a member is there already, a member of the source holds undefined or is gone, the target is frozen, has foreign names, or is listed.
type Style = { width?: number | string; height?: number; gap?: number; color?: string; label?: string | undefined; nested?: { deep: number }; ratio?: number; on?: boolean };
type Props = Style & { children?: unknown; id?: number };

const lines: string[] = [];
const show = (what: string, value: unknown): void => { lines.push(what + " " + JSON.stringify(value) + " " + (value && typeof value === "object" ? Object.keys(value).join(",") : "")); };
const call = <A, R>(f: (argument: A) => R, argument: A): R => f(argument);

const sources: (() => Props)[] = [
  () => ({ width: 1, children: "a" }),
  () => ({ width: "100%", height: 2, children: "b" }),
  () => ({ gap: 1, color: "red", id: 3 }),
  () => ({ color: "blue", gap: 2, nested: { deep: 1 } }),
  () => ({ label: undefined, ratio: 0.5 }),
  () => ({ ratio: 2, label: "l", on: true }),
  () => ({ on: false, height: -0, width: 1.5 }),
  () => ({}),
  () => ({ id: 9, children: null, nested: { deep: 2 }, height: 2147483648 }),
];

function takeApart({ children, id, ...style }: Props): Style { return style; }
function copy(style: Style): Style { return { ...style }; }
function behindMembers(style: Style): Style { return { width: 7, color: "own", ...style }; }
function beforeMembers(style: Style): Style { return { ...style, width: 7, color: "own" }; }
function twice(first: Style, second: Style): Style { return { ...first, ...second }; }
function assignTo(target: Style, style: Style): Style { return Object.assign(target, style); }

function round(turn: number, isShown: boolean): void {
  for (let i = 0; i < sources.length; i++) {
    const make = sources[i]!;
    const style = call(takeApart, make());
    const results: [string, unknown][] = [
      ["rest", style],
      ["copy", call(copy, style)],
      ["behind", call(behindMembers, style)],
      ["before", call(beforeMembers, style)],
      ["twice", twice(style, call(takeApart, sources[(i + turn) % sources.length]!()))],
      ["assign to empty", assignTo({}, style)],
      ["assign to filled", assignTo({ height: 5, label: "kept" }, style)],
      ["assign to the same keys", assignTo(call(copy, style), call(takeApart, make()))],
    ];
    if (isShown) {
      for (const [what, value] of results) show(turn + " " + i + " " + what, value);
    }
  }
}
for (let turn = 0; turn < 300; turn++) round(turn, turn < 2 || turn === 299);

// The shapes have met three hundred times. Now the targets differ.
for (let i = 0; i < sources.length; i++) {
  const style = call(takeApart, sources[i]!());
  const withOneMember: Style = {};
  withOneMember.gap = 40;
  show(i + " one member first", assignTo(withOneMember, style));
  const withDeleted: Style = { width: 1, gap: 2 };
  delete withDeleted.width;
  show(i + " one member deleted", assignTo(withDeleted, style));
  const withForeignName: Style = {};
  (withForeignName as Record<string, unknown>)["foreign"] = i;
  show(i + " a foreign name first", assignTo(withForeignName, style));
  const ofOtherType: Style = {};
  (ofOtherType as Record<string, unknown>)["height"] = "tall";
  show(i + " a member of another type first", assignTo(ofOtherType, style));
  const frozen = Object.freeze<Style>({});
  try {
    show(i + " frozen", assignTo(frozen, style));
  } catch (error) {
    show(i + " frozen throws", (error as Error).constructor.name);
  }
  const sealed = Object.seal<Style>({ gap: 0 });
  try {
    show(i + " sealed", assignTo(sealed, style));
  } catch (error) {
    show(i + " sealed throws", (error as Error).constructor.name);
  }
}

// And the sources differ: same keys in the same order, other values in them.
for (let turn = 0; turn < 3; turn++) {
  const changed: Props = { gap: 1, color: "red", id: 3 };
  if (turn === 1) changed.gap = undefined;
  if (turn === 2) (changed as Record<string, unknown>)["color"] = 12;
  show(turn + " changed source", call(copy, call(takeApart, changed)));
  const emptied: Props = { width: "100%", height: 2, children: "b" };
  if (turn === 1) delete emptied.height;
  if (turn === 2) { delete emptied.width; emptied.width = 3; }
  show(turn + " emptied source", call(behindMembers, call(takeApart, emptied)));
}
console.log(lines.join("\n"));
//// a-literal-of-defaults-a-spread-and-fields-behind-it.ts
// `{ a: "x", b: 0, ...given, c: given.c ?? given.d ?? "y" }`: constants, then a spread of an object whose fields are all optional, then fields that are computed from it. In a loop, with four
// different objects. The compiler builds such a literal by a plan for its fields, and once died on it in the pass behind the one that sinks allocations.
type Frame = {
  wrap?: "none" | "lines" | "words";
  way?: "across" | "down";
  grow?: number;
  shrink?: number;
  gap?: number;
  inset?: number;
  clip?: "shown" | "cut";
  clipAcross?: "shown" | "cut";
  clipDown?: "shown" | "cut";
};
function complete(given: Frame): Frame {
  return {
    wrap: "none",
    way: "across",
    grow: 0,
    shrink: 1,
    ...given,
    clipAcross: given.clipAcross ?? given.clip ?? "shown",
    clipDown: given.clipDown ?? given.clip ?? "shown",
  };
}
const all: Frame[] = [{ gap: 1 }, { way: "down", inset: 2 }, { clip: "cut" }, {}];
let sum = 0;
for (let round = 0; round < 4000; round++) {
