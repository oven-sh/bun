  show("a method " + on, { a: 1, ...(on && { m() { return 1; } }), c: 3 });
  show("a text " + on, { a: 1, ...((on ? "xy" : { b: 2 }) as object), c: 3 });
  show("an empty text " + on, { a: 1, ...((on ? "" : { b: 2 }) as object), c: 3 });
  show("a list " + on, { a: 1, ...(on ? [8, 9] : { b: 2 }), c: 3 });
  let kept: object | false = false;
