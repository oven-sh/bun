for (let i = 0; i < 200000; i++) { const made = copy(records[i % 5]!); sum += made.index === records[i % 5]!.index ? 1 : 0; if (i % 50000 === 0) collect(true); }
lines.push("sum " + sum);
console.log(lines.join("\n"));
//// copies-born-in-the-cells-of-their-holders-across-collections.ts
type Tally = { tries: number; text: string; list: number[] };
type Answer = { tally: Tally; verdict: string };
function decide(tally: Tally, round: number): Answer {
  return { tally: { ...tally, tries: tally.tries + 1 }, verdict: "round " + round };
}
let tally: Tally = { tries: 0, text: "kept", list: [1, 2, 3] };
let last: Answer | null = null;
for (let round = 0; round < 300000; round++) {
  last = decide(tally, round);
  tally = last.tally;
  if (round % 50000 === 0) Bun.gc(true);
}
console.log(JSON.stringify(tally), last!.verdict, last!.tally === tally);
//// copies-born-in-the-cells-of-their-holders-leave-their-neighbors-alone.ts
type Point = { x: number; y: number; label: string };
type Step = { at: Point; note: string; next: Step | null };
function move(from: Point, by: number, note: string, next: Step | null): Step {
  return { at: { ...from, x: from.x + by }, note, next };
}
let chain: Step | null = null;
let at: Point = { x: 0, y: 7, label: "start" };
const before: Point[] = [];
for (let round = 0; round < 2000; round++) {
  before.push({ x: round, y: -round, label: "before " + round });
  chain = move(at, round % 5, "round " + round, round % 64 === 0 ? null : chain);
  at = chain.at;
}
let sum = 0;
let wrong = 0;
for (let index = 0; index < before.length; index++) {
  const point = before[index];
  if (point.x !== index || point.y !== -index || point.label !== "before " + index) wrong++;
  sum += point.x;
}
let length = 0;
for (let step = chain; step !== null; step = step.next) {
  length++;
  if (typeof step.at.x !== "number" || step.at.y !== 7 || step.at.label !== "start" || !step.note.startsWith("round ")) wrong++;
}
console.log(sum, wrong, length, JSON.stringify(at));
//// copies-in-unknown-hands-and-their-sources.js
// Copies made by Object.assign and by spread go to code that nobody compiles, which changes them in every way it can. The sources are read afterwards: each holds
// what the program itself has put there. What the copies held is in those hands too: functions out of them are called, objects out of them are changed.
const run = new Function("copy", "log", `
  for (const key of Reflect.ownKeys(copy)) {
    const value = copy[key];
    if (typeof value === "function") log.push("called " + String(key) + ": " + value.call({ tag: "theirs" }, 1));
    else if (value && typeof value === "object") { value.touched = (value.touched || 0) + 1; }
  }
  Object.defineProperty(copy, "indent", { get() { return "a getter of theirs"; }, configurable: true, enumerable: true });
  copy.added = "by them"; delete copy.strict; Object.setPrototypeOf(copy, { inherited: "from them" });
  return copy;`);
const log = [];
const shared = { depth: 1 };
const symbol = Symbol("mark");
function defaults() { return { indent: 2, strict: true, name: "defaults", shared, format(n) { return this.tag + " " + n; }, [symbol]: "under a symbol" }; }

function read(options) { return [options.indent, options.strict, options.name, options.added, options.inherited, typeof options.format, options[symbol], Object.keys(options).join()].join(" | "); }

const first = defaults();
const assigned = run(Object.assign({ own: 1 }, first), log);
