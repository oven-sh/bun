//// copies-of-copies-keep-key-order.js
// A literal that copies an object gets its keys in the order of creation: its own members up to the copy, what the source has, then the members behind the copy.
// A copy of such a literal sees that order, whatever the compiler expected.
const lines = [];
const show = object =>
  Reflect.ownKeys(object)
    .map(key => String(key) + "=" + String(object[key]))
    .join(",");

const tag = Symbol("tag");

////= lines-3	replaceFirst	state	a

////= lines-3	addBehind	state	z

function addInFront(state, value) {
  return { z: value, ...state };
}

function between(state, other) {
  return { p: 1, ...state, q: 2, ...other, r: 3 };
}

function withoutFirst({ a, ...rest }) {
  return rest;
}

function maybe(condition, state) {
  return { first: 1, ...(condition && state), last: 2 };
}

function computed(state, key) {
  return { ...state, [key]: 1, z: 2 };
}

function withGetter(state) {
  return {
    ...state,
    get twice() {
      return this.a * 2;
    },
    z: 2,
  };
}

function reduce(turns) {
  let state = { a: 0, b: 1, c: 2 };
  for (let i = 0; i < turns; i++) state = replaceFirst(state, i);
  return state;
}

function chain(turns) {
  let total = 0;
  let last;
  for (let i = 0; i < turns; i++) {
    const inner = addBehind({ a: i, b: 1 }, i);
    const outer = addInFront(replaceFirst(inner, i + 1), i);
    last = between(outer, withoutFirst(inner));
    total += last.a + last.z + last.r;
  }
  return show(last) + " " + total;
}

lines.push(show(reduce(2000)));
lines.push(chain(2000));

// The same functions meet objects with another order, with more keys and with none.
const otherOrders = [
  { c: 1, b: 2, a: 3 },
  { b: 1 },
  {},
  { a: 1, [tag]: 2, b: 3 },
  { 2: "two", a: 1, 1: "one" },
  Object.assign({ a: 1 }, JSON.parse('{"late":1,"later":2}')),
  Object.defineProperty({ a: 1, b: 2 }, "hidden", { value: 3, enumerable: false }),
  Object.freeze({ b: 1, a: 2 }),
  Object.create({ inherited: 1 }, { own: { value: 2, enumerable: true } }),
  [7, 8],
  "xy",
  5,
  null,
  undefined,
];
for (const source of otherOrders) {
  lines.push(show(replaceFirst(source, 9)));
  lines.push(show(addBehind(source, 9)));
  lines.push(show(addInFront(source, 9)));
  lines.push(show(between(source, source)));
  lines.push(show(replaceFirst(replaceFirst(source, 8), 9)));
  lines.push(show(addBehind(addInFront(source, 8), 9)));
  if (source != null) lines.push(show(withoutFirst(source)));
}

// A key that is deleted and created once more moves to the end, in the source and in every copy of it.
const moved = replaceFirst({ a: 1, b: 2, c: 3 }, 4);
delete moved.a;
moved.a = 5;
lines.push(show(moved), show(replaceFirst(moved, 6)), show(addBehind(moved, 6)));

for (let i = 0; i < 300; i++) {
  const state = { a: i, b: i };
  const taken = maybe(i % 3 === 0, state);
  if (i > 296) lines.push(show(taken), show(replaceFirst(taken, 0)));
}

for (const key of ["k", "a", "z", "0", tag]) {
  const made = computed({ a: 1, b: 2 }, key);
  lines.push(show(made), show(addBehind(made, 3)));
}

const accessor = withGetter({ a: 21, b: 2 });
lines.push(show(accessor), show(replaceFirst(accessor, 1)), typeof Object.getOwnPropertyDescriptor(replaceFirst(accessor, 1), "twice").get);

// A getter of the source runs in the middle of the copy and sees what the literal has so far through nothing but its own effects.
let runs = 0;
const counting = {
  a: 1,
  get b() {
    return ++runs;
  },
  c: 3,
};
lines.push(show(replaceFirst(counting, 0)), show(replaceFirst(replaceFirst(counting, 0), 1)), String(runs));

console.log(lines.join("\n"));
//// copies-of-more-names-than-a-chain-of-structures-holds.ts
// Copies of objects with more names than a chain of Structures holds, and of mixtures of fields, added names, accessors and indexes.
type Bag = Record<string, unknown>;
type Known = { first?: number; second?: string; third?: boolean };

function bagOf(count: number, prefix: string): Bag {
  const bag: Bag = {};
  for (let index = 0; index < count; index++) bag[prefix + index] = index;
  return bag;
}

function lookedUp(bag: Bag): Bag {
  return new Proxy(bag, {});
}

function describe(value: object): string {
  const keys = Reflect.ownKeys(value);
  let sum = 0;
  for (const key of keys) {
    const item = (value as Record<PropertyKey, unknown>)[key];
    if (typeof item === "number") sum += item;
  }
  return keys.length + " keys, sum " + sum + ", " + keys.slice(0, 4).map(String).join(",") + " .. " + keys.slice(-4).map(String).join(",");
}

function copy(bag: Bag): Bag { return { ...bag }; }
function copyWithOne(bag: Bag): Bag { return { ...bag, added: 1 }; }
function copyBehindOne(bag: Bag): Bag { return { before: 1, ...bag }; }
function copyTwo(a: Bag, b: Bag): Bag { return { ...a, ...b }; }
function copyOntoKnown(bag: Bag): Known & Bag { return { first: 1, ...bag, third: true }; }
function copyOverAccessor(bag: Bag): Bag { return { get name3() { return "getter"; }, set name3(value: unknown) { throw new Error("called"); }, ...bag }; }

for (const count of [0, 1, 2, 3, 4, 60, 126, 127, 128, 129, 200, 600]) {
  for (let round = 0; round < 3; round++) {
    const bag = bagOf(count, "name");
    const other = bagOf(count >> 1, round ? "other" : "name");
    const mixed: Bag = { ...bagOf(3, "name"), second: "s", 7: "seven", ...bagOf(count, "late"), first: 5, [Symbol.for("mark")]: 9, 2: "two" };
    console.log(count, round, describe(copy(bag)), "|", describe(copyWithOne(bag)), "|", describe(copyBehindOne(bag)));
    console.log(count, round, describe(copyTwo(bag, other)), "|", describe(copyOntoKnown(mixed)), "|", describe(copyOverAccessor(bag)), Object.getOwnPropertyDescriptor(copyOverAccessor(bag), "name3")?.get === undefined);
    console.log(count, round, describe(copy(lookedUp(bag))), "|", describe(copyOntoKnown(lookedUp(mixed))), "|", describe(copyTwo(lookedUp(bag), lookedUp(other))), "|", describe(copyOverAccessor(lookedUp(bag))));
  }
}
//// copies-of-objects-nobody-can-name.js
// `{ ...source }`, `{ ...source, name: value }` and the rest of a pattern, where the source has passed through text that is evaluated at run time, so that nothing is known about it.
// The copy has the enumerable own properties of the source in their order, it is a plain extensible object, and what happens to it afterwards does not reach the source.
const lines = [];
const unknown = new Function("value", "return value" + process.argv[0].slice(process.argv[0].length));
const tag = Symbol("tag");
const hidden = Symbol("hidden");

const describe = object =>
  Reflect.ownKeys(object)
    .map(key => {
      const descriptor = Object.getOwnPropertyDescriptor(object, key);
      const flags = (descriptor.writable ? "w" : "-") + (descriptor.enumerable ? "e" : "-") + (descriptor.configurable ? "c" : "-");
      return String(key) + "=" + String(descriptor.value) + ":" + flags;
    })
    .join(",");

const state = object =>
  describe(object) +
  " | " +
  [Object.getPrototypeOf(object) === Object.prototype, Object.isExtensible(object), Object.isFrozen(object), Object.isSealed(object)].join();

function copy(source) {
  return { ...source };
}
////= lines-3	replace	source	a
////= lines-3	add	source	added
function without({ a, ...others }) {
  return others;
}
function withoutComputed(source, key) {
  const { [key]: taken, ...others } = source;
  return [taken, others];
}

class Point {
  constructor(a, b) {
    this.a = a;
    this.b = b;
  }
  get sum() {
    return this.a + this.b;
  }
}
function Pair(a, b) {
  this.a = a;
  this.b = b;
}
Pair.prototype.inherited = "never copied";

let getterRuns = 0;
const sources = {
  literal: { a: 1, b: 2, c: 3 },
  otherOrder: { c: 3, a: 1, b: 2 },
  filledLater: (() => {
    const object = { b: 2 };
    object.c = 3;
    object.a = 1;
    return object;
  })(),
  deleted: (() => {
    const object = { a: 1, b: 2, c: 3 };
    delete object.b;
    return object;
  })(),
  deletedAndBack: (() => {
    const object = { a: 1, b: 2, c: 3 };
    delete object.a;
    object.a = 4;
    return object;
  })(),
  getter: {
    a: 1,
    get b() {
      getterRuns++;
      return "from getter " + getterRuns;
    },
    c: 3,
  },
  redefined: Object.defineProperty({ a: 1, b: 2, c: 3 }, "b", { get: () => "redefined", enumerable: true, configurable: true }),
  nonEnumerable: Object.defineProperty({ a: 1, b: 2, c: 3 }, "b", { enumerable: false }),
  readOnly: Object.defineProperty({ a: 1, b: 2, c: 3 }, "a", { writable: false }),
  symbols: { a: 1, [tag]: "tagged", b: 2 },
  hiddenSymbol: Object.defineProperty({ a: 1 }, hidden, { value: "hidden", enumerable: false }),
  numericNames: { b: 1, 2: "two", a: 2, 1: "one", "-1": "minus" },
  ownProto: JSON.parse('{"a":1,"__proto__":{"polluted":true},"b":2}'),
  frozen: Object.freeze({ a: 1, b: 2, c: 3 }),
  sealed: Object.seal({ a: 1, b: 2 }),
  notExtensible: Object.preventExtensions({ a: 1, b: 2 }),
  otherPrototype: Object.setPrototypeOf({ a: 1, b: 2 }, { inherited: "never copied" }),
  noPrototype: Object.assign(Object.create(null), { a: 1, b: 2 }),
  instance: new Point(1, 2),
  constructed: new Pair(1, 2),
  parsed: JSON.parse('{"a":1,"b":[2],"c":{"d":3}}'),
  array: ["x", "y"],
  sparse: [, "y", , "w"],
  string: "hi",
  stringObject: Object.assign(new String("hi"), { a: 1 }),
  number: 5,
  yes: true,
  no: false,
  nothing: null,
  missing: undefined,
  symbol: tag,
  bigint: 10n,
  func: Object.assign(function named() {}, { a: 1 }),
  map: Object.assign(new Map([[1, 2]]), { a: 1 }),
  holdsUndefined: { a: undefined, b: null, c: NaN, d: -0 },
  doubles: { a: 1.5, b: 2 ** 40, c: -0, d: 1e300 },
  mixed: { a: "text", b: { nested: true }, c: [1], d: () => 1, e: 1n, f: tag },
  wide: Object.fromEntries(Array.from({ length: 40 }, (_, index) => ["k" + index, index])),
  empty: {},
};

for (const [name, source] of Object.entries(sources)) {
  const value = unknown(source);
  lines.push(name + " copy: " + state(copy(value)));
  lines.push(name + " replace: " + state(replace(value, "replaced")));
  lines.push(name + " add: " + state(add(value, "added")));
  if (value !== null && value !== undefined) {
    lines.push(name + " without: " + state(without(value)));
    const [taken, others] = withoutComputed(value, unknown("b"));
    lines.push(name + " without computed: " + String(taken) + " " + state(others));
  }
}
lines.push("getter runs: " + getterRuns);

const proxyLog = [];
const proxy = new Proxy(
  { a: 1, b: 2, c: 3 },
  {
    ownKeys(target) {
      proxyLog.push("ownKeys");
      return ["c", "a", "b"];
    },
    getOwnPropertyDescriptor(target, key) {
      proxyLog.push("describe " + String(key));
      return key === "a" ? { value: 1, enumerable: false, configurable: true } : Reflect.getOwnPropertyDescriptor(target, key);
    },
    get(target, key) {
      proxyLog.push("get " + String(key));
      return target[key] * 10;
    },
  },
);
lines.push("proxy copy: " + state(copy(unknown(proxy))));
lines.push("proxy without: " + state(without(unknown(proxy))));
lines.push(proxyLog.join());

for (const thrower of [
  {
    a: 1,
    get b() {
      throw new RangeError("thrown by a getter");
    },
  },
  new Proxy({}, { ownKeys: () => { throw new RangeError("thrown by a trap"); } }),
]) {
  for (const run of [copy, replace, add, without]) {
    try {
      run(unknown(thrower), 1);
      lines.push("no error");
    } catch (error) {
      lines.push(run.name + ": " + error.name + ": " + error.message);
    }
  }
}
for (const nullish of [null, undefined]) {
  try {
    without(unknown(nullish));
    lines.push("no error");
  } catch (error) {
    lines.push(error.name);
  }
}

console.log(lines.join("\n"));
//// copies-of-objects-with-fields-and-added-names.js
// An object that has the members of its literal and names that were added later is copied with every own enumerable property, in the order of creation.
const lines = [];
const show = object =>
  Reflect.ownKeys(object)
    .map(key => {
      const { value, get, writable, enumerable, configurable } = Object.getOwnPropertyDescriptor(object, key);
      return String(key) + "=" + (get ? "getter" : String(value)) + (writable && enumerable && configurable ? "" : "!");
    })
    .join(",");

const tag = Symbol("tag");
const names = JSON.parse('["late","later","latest"]');

function record(i) {
  return { x: i, y: i + 1 };
}

function withAddedNames(i, count) {
  const object = record(i);
  for (let n = 0; n < count; n++) object[names[n]] = i + n;
  return object;
}

const copy = source => ({ ...source });
const extend = source => ({ ...source, z: 1 });
const assign = source => Object.assign({}, source);
const assignOnto = source => Object.assign({ y: 0, w: 0 }, source);
const rest = ({ x, ...others }) => others;
const forms = { copy, extend, assign, assignOnto, rest };

function total(turns) {
  let sum = 0;
  for (let i = 0; i < turns; i++) {
    const source = withAddedNames(i, 2);
    const copied = copy(source);
    const extended = extend(copied);
    sum += copied.x + copied.late + extended.later + extended.z + assignOnto(source).late;
  }
  return sum;
}
lines.push(String(total(3000)));

const sources = {
  none: () => withAddedNames(1, 0),
  one: () => withAddedNames(1, 1),
  three: () => withAddedNames(1, 3),
  otherOrder: () => {
    const object = record(1);
    object[names[1]] = 1;
    object[names[0]] = 2;
    return object;
  },
  getter: () => Object.defineProperty(withAddedNames(1, 1), "computed", { get: () => 7, enumerable: true, configurable: true }),
  notEnumerable: () => Object.defineProperty(withAddedNames(1, 1), "hidden", { value: 7, enumerable: false, writable: true, configurable: true }),
  readOnly: () => Object.defineProperty(withAddedNames(1, 1), "fixed", { value: 7, enumerable: true, writable: false, configurable: true }),
  symbol: () => Object.assign(withAddedNames(1, 1), { [tag]: 7 }),
  index: () => Object.assign(withAddedNames(1, 1), { 3: "three", 1: "one" }),
  deletedField: () => {
    const object = withAddedNames(1, 2);
    delete object.x;
    return object;
  },
  fieldCreatedOnceMore: () => {
    const object = withAddedNames(1, 2);
    delete object.x;
    object.x = 9;
    return object;
  },
  deletedName: () => {
    const object = withAddedNames(1, 3);
    delete object.later;
    return object;
  },
  fieldOfAnotherType: () => {
    const object = withAddedNames(1, 1);
    object.x = "text";
    return object;
  },
  fieldMadeAccessor: () => Object.defineProperty(withAddedNames(1, 1), "y", { get: () => 7, enumerable: true, configurable: true }),
  frozen: () => Object.freeze(withAddedNames(1, 2)),
  sealed: () => Object.seal(withAddedNames(1, 2)),
  many: () => {
    const object = record(1);
    for (let n = 0; n < 80; n++) object["name" + n] = n;
    return object;
  },
};

for (const [sourceName, make] of Object.entries(sources)) {
  for (const [formName, form] of Object.entries(forms)) {
    // Twice: the second copy may be served by what the first one left behind.
    const first = show(form(make()));
    const second = show(form(make()));
    lines.push(sourceName + " " + formName + " " + (first === second ? first.length > 200 ? first.length : first : "DIFFERENT " + first + " | " + second));
  }
}

// One site, sources whose added names differ from turn to turn.
for (let i = 0; i < 12; i++) lines.push(show(copy(withAddedNames(i, i % 4))));

// Names that come from data precede the member of the literal, in the literal and in every copy of it.
const parsed = JSON.parse('[{"a":1,"b":2,"c":3},{"c":4,"a":5}]');
function replaceMember(turns, first) {
  let state = { ...first, z: 0 };
  for (let i = 0; i < turns; i++) state = { ...state, z: i };
  return state;
}
function betweenData(turns) {
  let state = { ...parsed[0], m: 1, ...parsed[1], d: 2, n: 3 };
  for (let i = 0; i < turns; i++) state = { ...state, n: i };
  return state;
}
function restOfData(turns) {
  let sum = 0;
  let last;
  for (let i = 0; i < turns; i++) {
    const { a, ...others } = parsed[i & 1];
    const { c, z, ...fewer } = { ...others, z: i, y: a };
    sum += a + c + z + fewer.y;
    last = [others, fewer];
  }
  return sum + " " + last.map(show).join(" | ");
}
function restByKey(object, key) {
  const { [key]: taken, ...others } = object;
  return String(taken) + " " + show(others);
}
lines.push(show(replaceMember(2000, parsed[0])), show(replaceMember(2000, parsed[1])), show(betweenData(2000)), restOfData(2000));
for (const key of ["x", "late", "later", "missing", "0", tag]) lines.push(restByKey(withAddedNames(1, 2), key), restByKey(withAddedNames(1, 2), typeof key === "string" ? key.slice(0, 2) + key.slice(2) : key));

// The copy is independent of its source.
const source = withAddedNames(1, 2);
const copied = copy(source);
source[names[0]] = "changed";
source.x = "changed";
lines.push(show(copied), show(source));

console.log(lines.join("\n"));
//// copies-of-records-that-nothing-changes.ts
// Records whose fields nothing stores to after the literal that makes them are copied in every way there is: by a literal that begins with a spread and has no type of its own,
// under the type of the record, into an object that is there already, with names added and replaced. The copies are other objects with the same names in the same order, and the sources stay as they were.
const outside: any = JSON.parse('{"words":["alpha","beta","gamma","delta"],"numbers":[1,2.5,-3,4]}');
const words: string[] = outside.words.map((word: any) => String(word));
const numbers: number[] = outside.numbers.map((n: any) => Number(n));
const lines: string[] = [];
function show(label: string, value: any): void {
  lines.push(label + ": " + Object.keys(value).join(",") + " = " + JSON.stringify(value));
}

type Texts = { a: string; b: string; c: string };
type Mixed = { text: string; count: number; flag: boolean; list: string[]; inner: Texts; nothing: null; missing?: string };
function texts(i: number): Texts { return { a: words[i & 3], b: words[(i + 1) & 3], c: words[(i + 2) & 3] }; }
function mixed(i: number): Mixed { return { text: words[i & 3], count: numbers[i & 3], flag: (i & 1) === 0, list: [words[i & 3]], inner: texts(i), nothing: null }; }
function withFunctions(i: number) { return { name: words[i & 3], first() { return this.name + "!"; }, second: () => words[(i + 1) & 3], third: function () { return i; } }; }

const keptTexts: Texts[] = [texts(0), texts(1), texts(2), texts(3)];
const keptMixed: Mixed[] = [mixed(0), mixed(1), mixed(2), mixed(3)];
const keptFunctions = [withFunctions(0), withFunctions(1)];

function copyOfAnything(x: any): any { return { ...x }; }
function copyOfTexts(x: Texts): Texts { return { ...x }; }
function copyOfMixed(x: Mixed): Mixed { return { ...x }; }
function copyUnderParameter<T>(x: T): T { return { ...x }; }
function widened(x: any, more: unknown): any { return { ...x, more }; }
function replaced(x: Texts, b: string): Texts { return { ...x, b }; }
function twice(x: any, y: any): any { return { ...x, ...y }; }
function assigned(x: any): any { return Object.assign({}, x); }
function filled(x: Texts): Texts { const target = {} as Texts; Object.assign(target, x); return target; }

for (let i = 0; i < 4; ++i) {
  const t = keptTexts[i];
  const m = keptMixed[i];
  show("texts, no type " + i, copyOfAnything(t));
  show("texts, typed " + i, copyOfTexts(t));
  show("texts, parameter " + i, copyUnderParameter(t));
  show("texts, widened " + i, widened(t, i));
  show("texts, replaced " + i, replaced(t, "B"));
  show("texts, assigned " + i, assigned(t));
  show("texts, filled " + i, filled(t));
  show("mixed, no type " + i, copyOfAnything(m));
  show("mixed, typed " + i, copyOfMixed(m));
  show("mixed, parameter " + i, copyUnderParameter(m));
  show("mixed, widened " + i, widened(m, t));
  show("both " + i, twice(t, m));
  show("both, the other way " + i, twice(m, t));
  lines.push("other objects " + i + ": " + [copyOfAnything(t) !== t, copyOfTexts(t) !== t, copyOfAnything(m).inner === m.inner, copyOfMixed(m).list === m.list].join(" "));
}
for (const f of keptFunctions) {
  const copy = copyOfAnything(f);
  lines.push("functions: " + Object.keys(copy).join(",") + " " + copy.first() + " " + copy.second() + " " + copy.third() + " " + (copy.first === f.first) + " " + (copy.second === f.second) + " " + (copy.third === f.third));
  const again = copyOfAnything(copy);
  lines.push("functions, a copy of the copy: " + again.first() + " " + (again.third === f.third));
}
// A copy of a copy of a copy, and many of them, so that a collection runs among them.
let chain: any = keptMixed[0];
let total = 0;
for (let i = 0; i < 20000; ++i) {
  chain = copyOfAnything(chain);
