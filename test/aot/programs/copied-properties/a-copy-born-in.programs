//// builder-copies-descriptors-then-assigns.ts
// One builder that many callers hand a literal of their own: defaults are spread, the descriptors of the definition are copied (definitions carry getters), a literal of methods is assigned on top.
type Definition = { name: string; cost: number; readonly label: string; run(x: number): number };
type Built = Definition & { enabled(): boolean; title(): string; describe(): string; twice(x: number): number };
const DEFAULTS = { enabled: () => true, cost: 1 };
function build(def: Definition): Built {
  const facing = {
    describe: () => def.name + ":" + def.cost,
    twice: (x: number) => def.run(def.run(x)),
  };
  const built: Built = Object.assign(
    Object.defineProperties({ ...DEFAULTS, title: () => def.name }, Object.getOwnPropertyDescriptors(def)),
    facing,
  ) as unknown as Built;
  return built;
}
const double = build({ name: "double", cost: 2, get label() { return this.name.toUpperCase(); }, run: x => x * 2 });
const square = build({ name: "square", cost: 3, get label() { return "[" + this.name + "]"; }, run: x => x * x });
const negate = build({ name: "negate", cost: 4, get label() { return this.name; }, run: x => -x });
const tools = [double, square, negate];
let total = 0;
for (let i = 0; i < 2000000; i++) {
  const tool = tools[i % 3];
  if (tool.enabled()) total += tool.run(i & 7) + tool.twice(i & 3) + tool.cost + tool.title().length;
}
console.log(total, tools.map(tool => tool.label + " " + tool.describe() + " " + Object.keys(tool).join()).join(" | "));
//// builder-reads-a-member-of-an-unproven-type-then-copies-descriptors.ts
// A builder that reads a member of the definition, of a declared type that nobody has proven, in front of the copy of the descriptors: the code behind the test of that type exists twice.
type Definition = { name: string; cost: number; allowed?: (x: number) => boolean; readonly label: string; run(x: number): number };
type Built = Definition & { enabled(): boolean; title(): string; admits(x: number): boolean };
const DEFAULTS = { enabled: () => true, cost: 1 };
function build(def: Definition): Built {
  const allowed = def.allowed;
  const facing = { admits: (x: number) => (allowed ? allowed(x) : true) };
  const built: Built = Object.assign(
    Object.defineProperties({ ...DEFAULTS, title: () => def.name }, Object.getOwnPropertyDescriptors(def)),
    facing,
  ) as unknown as Built;
  return built;
}
const parsed = JSON.parse('{"name":"parsed","cost":5,"allowed":7,"label":"plain"}');
parsed.run = (x: number) => x + 1;
const tools = [
  build({ name: "double", cost: 2, get label() { return this.name.toUpperCase(); }, run: x => x * 2 }),
  build({ name: "square", cost: 3, allowed: x => x > 1, get label() { return "[" + this.name + "]"; }, run: x => x * x }),
  build(parsed),
];
for (const tool of tools) {
  let admits: unknown;
  try { admits = tool.admits(2); } catch (e) { admits = (e as Error).name; }
  console.log(tool.name, tool.cost, tool.label, tool.run(3), tool.title(), tool.enabled(), admits, Object.keys(tool).join(), typeof Object.getOwnPropertyDescriptor(tool, "label")!.get);
}
