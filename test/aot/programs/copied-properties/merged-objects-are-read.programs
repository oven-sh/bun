////: read a merged object
function productsOf(merged) {
  let sum = 0;
  for (let turn = 0; turn < 100; turn++) sum = (sum + merged.a * merged.b - merged.c) | 0;
  return sum;
}
function sumsOf(merged) {
  let sum = 0;
  for (let turn = 0; turn < 100; turn++) sum += merged.a + merged.b + merged.c;
  return sum;
}
function show(label, merged) {
  console.log(label, productsOf(merged), sumsOf(merged), merged.a, merged.b, merged.c, "a" in merged, "b" in merged, "c" in merged);
}
function list(label, merged) {
  console.log(label, Object.keys(merged).join(), JSON.stringify(merged), Reflect.ownKeys(merged).map(String).join());
}
//// merged-objects-are-read-defaults-and-options.js
////= read a merged object
const defaults = { a: 1, b: 2 };
function spread(options) { return { ...defaults, ...options }; }
function assign(options) { return Object.assign({}, defaults, options); }
show("spread", spread({ c: 3 }));
show("assigned", assign({ c: 3 }));
//// merged-objects-are-read-defaults-and-options-are-listed.js
////= read a merged object
const defaults = { b: 2, a: 1 };
function spread(options) { return { ...defaults, ...options }; }
function assign(options) { return Object.assign({}, defaults, options); }
show("spread", spread({ c: 3, a: 4 }));
show("assigned", assign({ c: 3, a: 4 }));
list("spread", spread({ c: 3, a: 4 }));
list("assigned", assign({ c: 3, a: 4 }));
//// merged-objects-are-read-options-that-may-be-left-out.js
////= read a merged object
const defaults = { a: 1, b: 2 };
function spread(options) { return { ...defaults, ...options }; }
function assign(options) { return Object.assign({}, defaults, options); }
for (const options of [{ c: 3 }, undefined, null]) {
  show("spread", spread(options));
  show("assigned", assign(options));
}
//// merged-objects-are-read-options-of-two-kinds.js
////= read a merged object
const defaults = { a: 1, b: 2 };
function spread(options) { return { ...defaults, ...options }; }
function assign(options) { return Object.assign({}, defaults, options); }
show("spread", spread({ c: 3 }));
show("assigned", assign({ c: 3 }));
show("spread", spread({ d: 4 }));
show("assigned", assign({ d: 4 }));
show("spread", spread({ c: "text", a: 0.5 }));
show("assigned", assign({ c: "text", a: 0.5 }));
//// merged-objects-are-read-a-name-is-deleted-from-a-source.js
////= read a merged object
const defaults = { a: 1, b: 2 };
const options = { c: 3 };
function spread() { return { ...defaults, ...options }; }
function assign() { return Object.assign({}, defaults, options); }
show("spread", spread());
show("assigned", assign());
delete options.c;
show("spread", spread());
show("assigned", assign());
delete defaults.a;
show("spread", spread());
show("assigned", assign());
//// merged-objects-are-read-a-name-of-a-source-is-hidden.js
////= read a merged object
const defaults = { a: 1, b: 2 };
const options = { c: 3 };
function spread() { return { ...defaults, ...options }; }
function assign() { return Object.assign({}, defaults, options); }
show("spread", spread());
show("assigned", assign());
Object.defineProperty(options, "c", { enumerable: false });
show("spread", spread());
show("assigned", assign());
//// merged-objects-are-read-a-getter-of-a-source-deletes-the-next-name.js
////= read a merged object
const first = { a: 1, get b() { delete first.c; return 2; }, c: 3 };
const second = { a: 1, get b() { delete second.c; return 2; }, c: 3 };
const defaults = { a: 0 };
function spread() { return { ...defaults, ...first }; }
function assign() { return Object.assign({}, defaults, second); }
show("spread", spread());
show("assigned", assign());
//// merged-objects-are-read-a-getter-of-one-source-deletes-a-name-of-the-next.js
////= read a merged object
const options = { c: 3 };
const defaults = { a: 1, get b() { delete options.c; return 2; } };
function spread() { return { ...defaults, ...options }; }
show("spread", spread());
const otherOptions = { c: 3 };
const otherDefaults = { a: 1, get b() { delete otherOptions.c; return 2; } };
function assign() { return Object.assign({}, otherDefaults, otherOptions); }
show("assigned", assign());
//// merged-objects-are-read-a-setter-above-the-target.js
////= read a merged object
const heard = [];
const above = { set c(value) { heard.push(value); }, get c() { return 30; } };
const defaults = { a: 1, b: 2 };
function spread(options) { return { __proto__: above, ...defaults, ...options }; }
function assign(options) { return Object.assign({ __proto__: above }, defaults, options); }
show("spread", spread({ c: 3 }));
show("assigned", assign({ c: 3 }));
console.log(heard.join(), Object.hasOwn(spread({ c: 3 }), "c"), Object.hasOwn(assign({ c: 3 }), "c"));
//// merged-objects-are-read-a-setter-of-the-target.js
////= read a merged object
const heard = [];
const defaults = { a: 1, b: 2 };
function spread(options) { return { set c(value) { heard.push(value); }, ...defaults, ...options }; }
function assign(options) { return Object.assign({ set c(value) { heard.push(value); } }, defaults, options); }
show("spread", spread({ c: 3 }));
show("assigned", assign({ c: 3 }));
console.log(heard.join());
//// merged-objects-are-read-a-source-holds-a-name-that-sets-the-prototype.js
////= read a merged object
const defaults = { a: 1, b: 2 };
const options = { ["__proto__"]: { c: 3 } };
function spread() { return { ...defaults, ...options }; }
function assign() { return Object.assign({}, defaults, options); }
show("spread", spread());
show("assigned", assign());
console.log(Object.hasOwn(spread(), "__proto__"), Object.hasOwn(assign(), "__proto__"));
//// merged-objects-are-read-a-source-throws-and-the-target-is-kept.js
////= read a merged object
const defaults = { a: 1 };
const options = { get b() { throw new Error("no b"); }, c: 3 };
let kept;
function assign() { kept = {}; return Object.assign(kept, defaults, options); }
function assignFresh() { return Object.assign({}, defaults, options); }
function spread() { return { ...defaults, ...options }; }
for (const make of [assign, assignFresh, spread]) {
  try { show(make.name, make()); } catch (error) { console.log(make.name, error.message); }
}
show("kept", kept);
//// merged-objects-are-read-an-empty-literal-of-the-same-type.ts
type Merged = { a?: number; b?: number; c?: number };
function productsOf(merged: Merged) {
  let sum = 0;
  for (let turn = 0; turn < 100; turn++) sum = (sum + merged.a! * merged.b! - merged.c!) | 0;
  return sum;
}
function sumsOf(merged: Merged) {
  let sum = 0;
  for (let turn = 0; turn < 100; turn++) sum += merged.a! + merged.b! + merged.c!;
  return sum;
}
function show(label: string, merged: Merged) {
  console.log(label, productsOf(merged), sumsOf(merged), merged.a, merged.b, merged.c, "a" in merged, "b" in merged, "c" in merged);
}
const defaults = { a: 1, b: 2 };
function spread(options: { c: number }): Merged { return { ...defaults, ...options }; }
function assign(options: { c: number }): Merged { return Object.assign({}, defaults, options); }
function leaveEmpty(): Merged { return {}; }
show("spread", spread({ c: 3 }));
show("assigned", assign({ c: 3 }));
show("empty", leaveEmpty());
//// merged-objects-are-read-a-name-is-deleted-from-the-copy.js
////= read a merged object
const defaults = { a: 1, b: 2 };
function spread(options) { return { ...defaults, ...options }; }
function assign(options) { return Object.assign({}, defaults, options); }
const [first, second] = [spread({ c: 3 }), assign({ c: 3 })];
show("spread", first);
show("assigned", second);
delete first.a;
delete second.c;
show("spread", first);
show("assigned", second);
//// merged-objects-are-read-the-rest-of-a-merged-object.js
////= read a merged object
const defaults = { a: 1, b: 2 };
function spread(options) { return { ...defaults, ...options }; }
function assign(options) { return Object.assign({}, defaults, options); }
const { a, ...restOfSpread } = spread({ c: 3 });
const { c, ...restOfAssigned } = assign({ c: 3 });
show("spread", restOfSpread);
show("assigned", restOfAssigned);
show("spread", { ...spread({ c: 3 }) });
show("assigned", { ...assign({ c: 3 }) });
console.log(a, c);
//// merged-objects-are-read-copies-of-copies.js
////= read a merged object
const defaults = { a: 1 };
function spread(options) { return { ...defaults, ...options }; }
function assign(options) { return Object.assign({}, defaults, options); }
function spreadBoth(one, other) { return { ...spread(one), ...assign(other) }; }
function assignBoth(one, other) { return Object.assign(Object.assign({}, spread(one)), assign(other)); }
show("spread", spreadBoth({ b: 2 }, { c: 3 }));
show("assigned", assignBoth({ b: 2 }, { c: 3 }));
list("spread", spreadBoth({ b: 2 }, { c: 3 }));
list("assigned", assignBoth({ b: 2 }, { c: 3 }));
//// merged-objects-are-read-instances-are-the-sources.js
////= read a merged object
class Defaults {
  a = 1;
  #hidden = 5;
  constructor(full) { if (full) this.b = 2; }
  get c() { return this.#hidden; }
}
function spread(full, options) { return { ...new Defaults(full), ...options }; }
function assign(full, options) { return Object.assign({}, new Defaults(full), options); }
show("spread", spread(true, { c: 3 }));
show("assigned", assign(true, { c: 3 }));
show("spread", spread(false, {}));
show("assigned", assign(false, {}));
//// merged-objects-are-read-a-spread-on-one-way-only.js
////= read a merged object
const defaults = { a: 1, b: 2 };
function spread(flag, options) { return { ...defaults, ...(flag && options) }; }
function spreadEither(flag, options) { return { ...defaults, ...(flag ? options : { d: 4 }) }; }
function assign(flag, options) { return Object.assign({}, defaults, flag ? options : undefined); }
for (const flag of [true, false]) {
  show("spread", spread(flag, { c: 3 }));
  show("either", spreadEither(flag, { c: 3 }));
  show("assigned", assign(flag, { c: 3 }));
}
//// merged-objects-are-read-sources-that-are-no-plain-objects.js
////= read a merged object
const defaults = { a: 1, b: 2 };
function spread(options) { return { ...defaults, ...options }; }
function assign(options) { return Object.assign({}, defaults, options); }
const behindProxy = new Proxy({ c: 3 }, { ownKeys() { return []; } });
for (const options of [behindProxy, [7], "xy", 5, new Map([["c", 3]]), function c() {}, Object.create({ c: 3 })]) {
  show("spread", spread(options));
  show("assigned", assign(options));
}
