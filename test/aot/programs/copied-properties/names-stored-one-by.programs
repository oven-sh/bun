Object.assign(between, { 1: "mid" });
Object.assign(b, between);
console.log(b.map(n => n + 1).join(), b.reduce((sum, n) => sum + n, 0));

const c: number[] = [1, 2, 3];
Object.assign(c, { 5: 9 });
let seen = 0;
c.forEach(() => { seen++; });
console.log(c.length, seen, 4 in c, c.indexOf(9), c.join());

const d: number[] = [1, 2, 3];
