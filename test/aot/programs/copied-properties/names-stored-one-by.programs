console.log(e.length, e.join(), e[2]);

const f: number[] = [1, 2, 3];
const g = { ...f, 1: "spread" };
console.log(Object.keys(g).join(), g[1], f.join());

const h: number[] = [1.5, 2.5];
Object.assign(h, [true]);
for (const n of h) console.log(typeof n, n);
