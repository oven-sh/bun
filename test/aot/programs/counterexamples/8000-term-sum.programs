//// dom-exception-as-error.ts
// Bun's declarations derive DOMException from Error, and `instanceof Error` agrees, but the engine does not create one as an Error object. It enters every location of the type Error.
class Failure {
  cause: Error;
  constructor(cause: Error) {
    this.cause = cause;
  }
}
function describe(error: Error): string {
  return error.name + ": " + error.message;
}
function createAbortError(): Error {
  return new DOMException("stopped", "AbortError");
}
function throwAbortError(): void {
  throw createAbortError();
}
////= describeThrown	describe	Error

const variable: Error = new DOMException("in a variable", "DataError");
const list: Error[] = [
  new DOMException("in a list", "SyntaxError"),
  new RangeError("a native error"),
  new Error("an error"),
];
const byName = new Map<string, Error>([["timeout", new DOMException("in a map", "TimeoutError")]]);

console.log("a parameter:", describe(new DOMException("stopped", "AbortError")));
console.log("a result:", createAbortError().name);
console.log("a field:", describe(new Failure(createAbortError()).cause));
console.log("a variable:", describe(variable));
for (const error of list) console.log("an element:", describe(error), error instanceof Error);
console.log("a map value:", describe(byName.get("timeout")!));
console.log("thrown by a signal:", describeThrown(() => AbortSignal.abort().throwIfAborted()));
console.log("thrown by a clone:", describeThrown(() => structuredClone(describe)));
console.log("thrown by the program:", describeThrown(throwAbortError));
//// double-cast-through-never.ts
// `{} as never as typeof Fn`: `as never` tests nothing, and a cast refuses no object, whatever the type: the object goes through.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name : String(e))) } }
function hide(v: unknown): any { return v }
function Fn() {}
row("as never as", () => typeof ({} as never as typeof Fn));
//// dynamic-import-as-record-type/m.ts
export const programs = [1, 2, 3];
export function f(x: number) { return x + 1 }
//// dynamic-import-as-record-type/main.ts
// `await import(..)` initializes a variable of a record type.
declare const console: { log(...values: unknown[]): void };
const b: { programs: number[] } = await import("./m.ts");
console.log(b.programs.length);
const c = await import("./m.ts");
console.log(c.programs.length + c.f(1));
//// dynamic-import-commonjs/fib.cjs
exports.fib = function fib(n) { return n < 2 ? n : fib(n - 1) + fib(n - 2); };
//// dynamic-import-commonjs/main.ts
// `(await import("./fib.cjs")).default.fib` is the function that the file exports.
declare const console: { log(...values: unknown[]): void };
const late = await import("./fib.cjs");
console.log(late.default.fib(20), late.fib === late.default.fib);
//// dynamic-import-commonjs-captured/fib.cjs
exports.fib = function fib(n) { return n < 2 ? n : fib(n - 1) + fib(n - 2); };
//// dynamic-import-commonjs-captured/main.ts
// The namespace of a dynamically imported CommonJS file is read in a closure, in a function and through a variable.
declare const console: { log(...values: unknown[]): void };
const late = await import("./fib.cjs");
const later = () => late.default.fib(10);
async function inside() { const m = await import("./fib.cjs"); return m.fib(5) + m.default.fib(6) }
console.log(later(), await inside(), late.fib === late.default.fib);
let again: typeof late | undefined;
again = await import("./fib.cjs");
console.log(again.fib(7));
//// elision-in-string-pattern.js
// An elision in an array pattern steps the iterator: `[, b]` of "xy" is "y".
console.log((([, b]) => b)("xy"));
//// empty-class-instance-cast-to-wider-interface.ts
// `new LinksClass() as TransientLinks`: the class is empty, and the interface has a member that is stored afterwards.
declare const console: { log(...values: unknown[]): void };
interface Ty { flags: number; id: number }
interface Links { type?: Ty; mapper?: string }
interface TransientLinks extends Links { check: number }
interface Holder { links: TransientLinks }
function row(n: string, f: () => unknown) { try { console.log(n + ": " + String(f())) } catch (e) { console.log(n + ": THROWN: " + (e as Error).message.split("\n")[0].slice(0, 90)) } }
const LinksClass = class implements Links {}
