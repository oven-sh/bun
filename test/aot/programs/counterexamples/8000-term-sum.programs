// Objects made by a constructor function are told from plain objects by strict deep equality and by `Bun.inspect`.
function Foo() {}
const o = Reflect.construct(Foo, []);
console.log(Bun.deepEquals(o, {}, true), Bun.inspect(o), o.constructor.name);
//// copy-of-an-instance-whose-member-is-a-getter.ts
// A copy holds only what its source itself holds and shows: an instance of a class that has the member as a getter, copied by a spread, as the type itself, lacks `b`, and reading it yields undefined.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name + ": " + e.message.split("\n")[0] : String(e))) } }
interface W { b: number }
interface S extends W { a: number }
const base = { b: 2 };
class C implements S { a = 1; get b(): number { return 2 } }
const heir = (): S => new C();
const copy = (s: S): S => ({ ...s });
row("the heir", () => heir().b);
row("read", () => copy(heir()).b);
row("added to", () => copy(heir()).b + 1);
row("held by a constant", () => { const c = copy(heir()); const n: number = c.b; return typeof n });
row("in", () => "b" in copy(heir()));
row("destructured", () => { const { b } = copy(heir()); return typeof b });
row("by a string", () => typeof copy(heir())["b"]);
row("an argument", () => { const take = (n: number): string => typeof n; return take(copy(heir()).b) });
row("a pattern in a parameter", () => { const take = ({ b }: { b: number }): string => typeof b; return take(copy(heir())) });
row("copied again", () => { const again = { ...copy(heir()) }; return typeof again.b });
row("keys", () => Object.keys(copy(heir())).join());
row("a copy of a plain object", () => { const whole = { a: 1, b: 3 }; return copy(whole).b });
//// counter-on-static-private-method.js
// A count kept on a static private method starts anew for each evaluation of the class.
for (let i = 0; i < 2; i++) console.log(class C { static #m() {} static count() { return C.#m.calls = (C.#m.calls || 0) + 1; } }.count());
//// declared-enum-before-enum.ts
// `declare enum E` ahead of `enum E` does not make E a global of the host.
declare const console: { log(...a: unknown[]): void };
declare enum E { B = 1 }
enum E { A = 0 }
console.log(Object.keys(E).join());
//// declared-enum-from-host.ts
// A member of a `declare enum` is read from the global object that provides it.
declare const console: { log(...a: unknown[]): void };
declare enum D { A = 1 }
(globalThis as any).D = { A: 2 };
console.log(D.A);
//// declared-function-returns-wrong-kind.ts
// A function that a TypeScript file declares to return a number returns a string: the written result type is tested at the call, which throws a TypeError.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name : String(e))) } }
function hide(v: unknown): any { return v }
declare function port(): number;
(globalThis as any).port = () => "80";
row("a declaration that lies", () => (port() as any) + 1);
//// declared-generator-forwarded-twice.ts
// One declared generator function has one prototype object however often it is handed on, and each activation has its own.
declare const console: { log(...a: unknown[]): void };
function run(g: () => object) { return Object.getPrototypeOf(g()); }
function once(x: number) { function* inner() { yield x; } return run(inner) === run(inner); }
function each() { function* inner() {} return run(inner); }
console.log(once(1), each() === each());
//// declared-thenable-as-promise/main.ts
// A package's declaration file derives the type of its thenable from Promise<T>, as Prisma's does. The thenable is no promise object, and it enters every location of the type Promise<T>.
import { query } from "./package.js";

interface User {
  name: string;
  age: number;
}
class Pending {
  held: Promise<number>;
  constructor(held: Promise<number>) {
    this.held = held;
  }
}
function findUser(): Promise<User> {
  return query("user", { name: "ada", age: 36 });
}
function count(): Promise<number> {
  return query("count", 3);
}
async function double(pending: Promise<number>): Promise<number> {
  return (await pending) * 2;
}
async function forward(): Promise<number> {
  return count();
}

const variable: Promise<string> = query("text", "four");
const list: Promise<number>[] = [count(), Promise.resolve(4), new Promise<number>(resolve => resolve(5))];

const user = await findUser();
console.log("a result:", user.name, user.age);
console.log("a parameter:", await double(count()));
console.log("a field:", await new Pending(count()).held);
console.log("a variable:", (await variable).length);
for (const pending of list) console.log("an element:", await pending, pending instanceof Promise);
console.log("the result of an async function:", await forward());
console.log("an assertion:", await (query("cast", 6) as Promise<number>));
console.log("then:", await count().then(value => value + 1));
console.log("all:", (await Promise.all([count(), double(count())])).join());
//// declared-thenable-as-promise/package.d.ts
export interface LazyQuery<T> extends Promise<T> {
  readonly text: string;
}
export function query<T>(text: string, result: T): LazyQuery<T>;
//// declared-thenable-as-promise/package.js
class LazyQuery {
  constructor(text, result) {
    this.text = text;
    this.result = result;
  }
  then(onFulfilled, onRejected) {
    return Promise.resolve(this.result).then(onFulfilled, onRejected);
  }
  catch(onRejected) {
    return this.then(undefined, onRejected);
  }
  finally(onFinally) {
    return this.then().finally(onFinally);
  }
  get [Symbol.toStringTag]() {
    return "LazyQuery";
  }
}
export function query(text, result) {
  return new LazyQuery(text, result);
}
