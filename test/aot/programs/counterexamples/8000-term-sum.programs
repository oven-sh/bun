//// required-module-in-interface-field/m.ts
export const programs = [1, 2, 3];
export function f(x: number) { return x + 1 }
//// required-module-in-interface-field/main.ts
// What `require()` returns is stored in a field whose type is an interface or null.
declare const console: { log(...values: unknown[]): void };
declare function require(name: string): any;
interface Api { f(x: number): number }
const own: Api = { f: x => x * 2 };
function on(): boolean { return true }
const mod = on() ? (require("./m.ts") as typeof import("./m.ts")) : null;
class Keeper { api: Api | null = null; use(n: number) { return this.api?.f(n) } }
const k = new Keeper();
console.log(k.use(1)); k.api = own; console.log(k.use(1)); k.api = mod; console.log(k.use(1));
//// required-ts-module-as-interface/m.ts
export function match(x: number): number { return x + 1 }
export function other(): string { return "o" }
export function a1(): void {} export function a2(): void {} export function a3(): void {} export const a4 = 4;
//// required-ts-module-as-interface/main.ts
// What `require()` of a TypeScript module returns is used where an interface is expected.
declare const console: { log(...values: unknown[]): void };
import { mod } from "./mod.ts";
interface Api { match(x: number): number; other(): string }
const own: Api = Object.freeze({ match: (x: number) => x * 2, other: () => "own" });
async function run<T, R>(first: T, n: number, ctx: { api: Api | null; make: (t: T) => R; f1: number; f2: number; f3: T[]; f4: number; f5: number; f6: number; f7: number }): Promise<string> {
  return String(ctx.make(first)) + " " + ctx.api?.match(n) + " " + ctx.api?.other() + " " + ctx.f7;
}
function direct(api: Api | null): string { return api?.match(1) + " " + api?.other() }
try { console.log(await run("a", 1, { api: own, make: t => t + "!", f1: 1, f2: 2, f3: [], f4: 4, f5: 5, f6: 6, f7: 7 })); } catch (e) { console.log("THROWN: " + (e as Error).message); }
try { console.log(await run("b", 1, { api: mod, make: t => t.length, f1: 1, f2: 2, f3: ["x"], f4: 4, f5: 5, f6: 6, f7: 7 })); } catch (e) { console.log("THROWN: " + (e as Error).message); }
try { console.log(direct(mod)); } catch (e) { console.log("THROWN: " + (e as Error).message); }
try { const held: { api: Api | null } = { api: mod }; console.log(held.api?.match(5)); } catch (e) { console.log("THROWN: " + (e as Error).message); }
//// required-ts-module-as-interface/mod.ts
declare function require(name: string): any;
function on(): boolean { return true }
export const mod = on() ? (require("./m.ts") as typeof import("./m.ts")) : null;
//// rest-after-bound-element.ts
// `const [x, ...z] = R` over `unknown[]`.
declare const console: { log(...a: unknown[]): void };
console.log(((R: unknown[]) => { const [x, ...z] = R; return z; })([1, 2, 3]).length);
//// rest-after-record-and-dictionary-spread.ts
// `{ ...record, ...dictionary }` keeps the extra properties in an object without a prototype. Its structure must not be handed to an ordinary object that has the same names.
interface R0 { h: boolean }
function make0(k: number): R0 { switch (k % 3) { case 0: return { h: k % 2 === 0 }; case 1: return { h: k % 2 === 0 }; default: return { h: true }; } }
function merge(k: number): R0 {
  const r = make0(k);
  const d: Record<string, any> = { w: { q: 1 } };
  return ((): R0 => ({ ...{ ...r }, ...d } as R0))();
}
function rest(o: any): any { const { a, ...others } = o; return others; }
function copy(o: any): any { return { ...o }; }
function extend(o: any, v: number): any { return { ...o, w: v }; }
function tell(what: string, got: any): void { console.log(what, Object.getPrototypeOf(got) === Object.prototype, typeof got.toString, got instanceof Object, Object.keys(got).join()); }
for (let k = 0; k < 7; k++) merge(k);
tell("rest", rest({ a: 1, w: 2 }));
tell("copy", copy({ w: 2 }));
tell("extend", extend({}, 2));
tell("literal", { w: 2 });
const built: any = {}; built.w = 1;
tell("rest of built", rest(Object.assign(built, { a: 1 })));
tell("merged", merge(1));
//// rest-of-an-instance-whose-member-is-on-the-prototype.ts
// A copy holds only what its source itself holds and shows: an instance of a class whose prototype was given the member, copied by a rest pattern, lacks `b`, and reading it yields undefined.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name + ": " + e.message.split("\n")[0] : String(e))) } }
interface W { b: number }
interface S extends W { a: number }
const base = { b: 2 };
class C implements S { a = 1; declare b: number }
C.prototype.b = 2;
const heir = (): S => new C();
const copy = (s: S) => { const { a, ...rest } = s; return rest };
row("the heir", () => heir().b);
row("read", () => copy(heir()).b);
row("added to", () => copy(heir()).b + 1);
row("held by a constant", () => { const c = copy(heir()); const n: number = c.b; return typeof n });
row("in", () => "b" in copy(heir()));
row("destructured", () => { const { b } = copy(heir()); return typeof b });
row("by a string", () => typeof copy(heir())["b"]);
row("an argument", () => { const take = (n: number): string => typeof n; return take(copy(heir()).b) });
row("a pattern in a parameter", () => { const take = ({ b }: { b: number }): string => typeof b; return take(copy(heir())) });
row("copied again", () => { const again = { ...copy(heir()) }; return typeof again.b });
row("keys", () => Object.keys(copy(heir())).join());
row("a copy of a plain object", () => { const whole = { a: 1, b: 3 }; return copy(whole).b });
//// return-after-never-guard.ts
// `if (isNever(b)) return b` returns b.
declare const console: { log(...a: unknown[]): void };
function isNever(v: unknown): v is never { return true; }
function pick(a: number, b: number): number { if (isNever(b)) return b; return a; }
console.log(pick(1, 2));
//// return-cast-to-never.ts
// `return b as never` returns b.
declare const console: { log(...a: unknown[]): void };
function pick(a: { n: number }, b: { n: number }) { if (b.n) return b as never; return a; }
const x = { n: 1 }, y = { n: 2 };
console.log(pick(x, y) === y, pick(x, y) === x, pick(x, y).n);
//// return-of-never.ts
// `return [][0]` returns though its static type is `never`.
declare const console: { log(...a: unknown[]): void };
function pick(a: { n: number }, c: boolean): { n: number } { if (c) return [][0]; return a; }
console.log(pick({ n: 1 }, true) === undefined);
//// rhs-runs-before-private-store-throws.ts
// `c.#s = value` on a class that lacks the private name evaluates the right side before it throws.
declare const console: { log(...a: unknown[]): void };
class P {
  static #s = 1;
  static store(c: typeof P) { c.#s = (console.log("value"), 5); }
}
try { P.store(class extends P {}); } catch { console.log("threw"); }
//// rhs-runs-before-static-private-store-throws.ts
// `this.#f = ++n` on a subclass evaluates the right side before it throws.
declare const console: { log(...a: unknown[]): void };
let n = 0;
class C { static #f = 0; static put() { this.#f = ++n; } }
class D extends C {}
try { D.put(); } catch {}
console.log(n);
//// rhs-runs-before-undefined-store-throws.js
// `u.a = f()` with u undefined evaluates the right side before it throws.
try { u.a = console.log("right side"); } catch (e) { console.log("caught"); }
var u = exports;
//// same-structure-literals-in-two-files/main.ts
// Literals of the same members in two files are frozen, extended, redefined and given prototypes one by one.
declare const console: { log(...values: unknown[]): void };
import { first, turned, make, nested, holdsFunction } from "./other";
const here = { a: 10, b: "h" };
const hereTurned = { b: "t", a: 11 };
const hereFunction = { a: 12, run: () => "main" };
const withProto = { __proto__: { inherited: 1 }, a: 13, b: "p" };
const numeric = { 1: "one", a: 14, b: "k" };
const asConst = { a: 1, b: "x" } as const;
const wider = { a: 15, b: "w", c: true };
function sum(list: { a: number; b: string }[]) { let n = 0, s = ""; for (const it of list) { n += it.a; s += it.b } return n + " " + s }
console.log(sum([first, turned, make(7), nested.p, nested.q[0], here, hereTurned, withProto, numeric, asConst, wider]));
console.log([first, turned, here, hereTurned, make(1), withProto, numeric].map(o => Object.keys(o).join()).join(" "));
console.log(JSON.stringify([first, turned, here, hereTurned, nested, numeric, asConst]));
console.log(holdsFunction.run(), hereFunction.run(), (withProto as any).inherited, Object.getPrototypeOf(here) === Object.prototype, Object.getPrototypeOf(withProto) === Object.prototype);
Object.freeze(first);
console.log(Object.isFrozen(first), Object.isFrozen(here), Object.isFrozen(make(2)));
here.a = 20; try { "use strict"; (first as { a: number }).a = 21 } catch (e) { console.log("frozen: " + (e as Error).constructor.name) }
console.log(first.a, here.a, (first as unknown) === here);
(here as any).more = 1; delete (make as any).nothing; const m = make(3); delete (m as any).b;
console.log(Object.keys(here).join(), Object.keys(m).join(), Object.keys(make(4)).join(), "b" in m, m.b);
Object.setPrototypeOf(hereTurned, { up: 1 });
console.log((hereTurned as any).up, (turned as any).up, (make(5) as any).up);
Object.defineProperty(turned, "a", { get() { return 99 }, configurable: true });
console.log(turned.a, hereTurned.a, sum([turned, hereTurned]));
const seen = new Map<object, string>([[first, "first"], [here, "here"]]);
console.log(seen.get(first), seen.get(here), seen.get(make(1)), seen.size);
//// same-structure-literals-in-two-files/other.ts
export const first = { a: 1, b: "x" };
export const turned = { b: "y", a: 2 };
export function make(n: number) { return { a: n, b: "made" + n } }
export const nested = { p: { a: 3, b: "n" }, q: [{ a: 4, b: "l" }] };
export const holdsFunction = { a: 5, run: () => "other" };
//// same-type-literals-hold-other-kinds/a.ts
import { host } from "./host.js";
export const predicted = { a: host(), b: "x" };
let later: number | undefined = undefined;
export function store() { later = 5 }
store();
export const narrowed = { a: later ?? 0, b: "n" };
