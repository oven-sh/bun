//// setters-called-from-loop-test.js
// `h.f = g` in the test of a loop calls the setter of the object that h names in that iteration.
let h = { set f(x) { console.log("a", typeof x); } }, g = 0;
const b = { set f(x) { console.log("b", typeof x); } };
while ((h.f = g, h !== b)) { const k = h; h = b; g = () => k; }
//// seven-named-stores-before-keyed-stores.js
// Seven stores by name ahead of a loop that stores by computed keys do not overwrite a neighboring object.
let p;
function f(c) {
  const o = {};
  if (c) c();
  o.a = 1; o.b = 1; o.c = 1; o.d = 1; o.e = 1; o.f = 1; o.g = 1;
  for (const k in c) o[k] = 1;
  return o;
}
f(() => { p = JSON.parse('{"x":1}'); });
console.log(p.x);
//// sloppy-commonjs-entry.js
// The entry point is sloppy CommonJS: it deletes a name, names variables `let`, `yield` and `static`, and writes legacy octal literals.
var assert = require('assert');
var a = 1;
var gone = delete a;
var package = 1, interface = 2, let = 3, static = 4, yield = 5;
console.log(gone, a, package + interface + let + static + yield, 010, 0777, typeof assert.ok);
//// sloppy-delete-of-name/main.ts
// `delete x` in a sloppy CommonJS file that TypeScript imports.
declare const console: { log(...values: unknown[]): void };
import "./sloppy.cjs";
//// sloppy-delete-of-name/sloppy.cjs
var x = 1;
module.exports = 0;
globalThis.there = 2;
console.log("delete a name: " + (delete x) + " " + (delete neverThere) + " " + (delete there) + " " + typeof there);
