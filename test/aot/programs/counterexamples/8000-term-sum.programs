//// define-property-on-typed-objects.ts
// Getters, setters and attributes are defined over the fields of records, and typed code reads and stores.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name + ": " + e.message.split("\n")[0] : String(e))) } }
function hide(v: unknown): any { return v }
function parse(t: string): any { return JSON.parse(t) }
type Item = { id: number; n: number; tag?: string };
function read(x: Item): number { return x.n }
function write(x: Item, v: number): number { x.n = v; return x.n }
row("a getter defined over a field", () => { const t: Item = { id: 1, n: 1 }; let calls = 0; Object.defineProperty(t, "n", { get() { calls++; return 42 }, configurable: true, enumerable: true }); return read(t) + " " + calls });
row("a setter defined over a field", () => { const t: Item = { id: 1, n: 1 }; let seen = 0; Object.defineProperty(t, "n", { get() { return 1 }, set(v) { seen = v }, configurable: true }); write(t, 9); return seen });
row("a field made read-only", () => { const t: Item = { id: 1, n: 1 }; Object.defineProperty(t, "n", { writable: false }); let s = ""; try { write(t, 9) } catch (e) { s = (e as Error).name } return s + " " + t.n });
row("a field made not enumerable", () => { const t: Item = { id: 1, n: 1 }; Object.defineProperty(t, "n", { enumerable: false }); return Object.keys(t).join() + " " + JSON.stringify(t) + " " + read(t) });
row("the descriptor of a field", () => JSON.stringify(Object.getOwnPropertyDescriptor({ id: 1, n: 1 } as Item, "n")));
row("plain data with a getter held to the type", () => { let calls = 0; const r: any = { id: 1, get n() { calls++; return 7 } }; const t: Item = hide(r); return read(t) + " " + read(t) + " " + calls + " " + ((t as unknown) === r) });
row("plain data with a read-only property held to the type", () => { const r: any = Object.defineProperty({ id: 1 }, "n", { value: 7, enumerable: true }); const t: Item = hide(r); let s = ""; try { write(t, 9) } catch (e) { s = (e as Error).name } return s + " " + r.n });
row("defineProperty of a new name on a record", () => { const t: Item = { id: 1, n: 1 }; Object.defineProperty(t, "z", { value: 3, enumerable: true }); return Object.keys(t).join() + " " + hide(t).z });
//// delete-optional-member-via-interface.ts
// An instance is seen through an interface in which one of its fields is optional, and that field is deleted.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name + ": " + e.message.split("\n")[0] : String(e))) } }
function hide(v: unknown): any { return v }
class R { ok = true; n = 1 }
interface G { ok?: boolean; n: number }
row("delete through an interface", () => { const r: G = hide(new R()); delete r.ok; return String("ok" in r) });
//// deleted-field-not-read-speculatively.ts
// A field that one path deletes is not read on that path.
declare const console: { log(...a: unknown[]): void };
interface P { x: number }
const held: P = { x: 0 } as any;
function f(c: boolean): number {
  const o: P = { x: 1 };
  if (c) delete (o as any).x;
  return c ? 0 : o.x;
}
console.log(f(true));
//// derived-class-parameter-properties.ts
// In a derived class the field initializers run behind `super()` and before a TypeScript parameter property is stored.
declare const console: { log(...a: unknown[]): void };
class P {}
class B extends P { y = (this as any).q; constructor(public q: number) { super(); } }
console.log(new B(5).y);
//// descriptor-of-literal-array.ts
// `Object.getOwnPropertyDescriptor(array, 0)?.value.m` reads the function of that element.
declare const console: { log(...a: unknown[]): void };
const made = [1, 2].map(() => ({ m: () => 1 }));
console.log(Object.getOwnPropertyDescriptor(made, 0)?.value.m === Object.getOwnPropertyDescriptor(made, 1)?.value.m);
//// dictionary-prototype-mutated-in-place.js
// A name is deleted from a prototype in dictionary mode and stored again: reads by name through an heir answer with that name's value.
const names = ["a", "b", "c", "d", "e", "f"];
const read = [o => o.a, o => o.b, o => o.c, o => o.d, o => o.e, o => o.f], write = [(o, v) => { o.a = v; }, (o, v) => { o.b = v; }, (o, v) => { o.c = v; }, (o, v) => { o.d = v; }, (o, v) => { o.e = v; }, (o, v) => { o.f = v; }], remove = [o => delete o.a, o => delete o.b, o => delete o.c, o => delete o.d, o => delete o.e, o => delete o.f];
const all = o => read.map(r => String(r(o))).join() + " | " + names.map(n => String(o[n + ""])).join();
for (const extras of [0, 10, 40, 70]) for (const reversed of [false, true]) for (const victim of [1, 4]) {
  const proto = { a: "A", b: "B", c: "C", d: "D", e: "E" };
  for (let i = 0; i < extras; i++) proto["extra" + i] = i;
  if (reversed) { const ks = Object.keys(proto), vs = ks.map(k => proto[k]); for (const k of ks) delete proto[k]; for (let i = ks.length - 1; i >= 0; i--) proto[ks[i]] = vs[i]; }
  const heir = Object.create(proto), heirOfHeir = Object.create(heir);
  let line = extras + " " + reversed + " " + names[victim] + ": " + all(heir) + " ; " + all(heir);
  remove[victim](proto); line += " ; deleted " + all(heir);
  write[victim](proto, "again"); line += " ; stored " + all(heir) + " ; " + all(heirOfHeir) + " ; own " + all(proto);
  console.log(line);
}
//// direct-eval-new-target-in-arrow.js
// Direct eval of `new.target` in an arrow function inside a function.
