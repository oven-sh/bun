//// any-this-function-reads-function-member.ts
// A function expression whose `this` is declared `any` reads a function out of its literal: a new one for each literal.
declare const console: { log(...a: unknown[]): void };
function make(): { m: () => number; peek: () => unknown } { return { m: () => 1, peek: function (this: any): unknown { return this.m; } }; }
console.log(make().peek() === make().peek());
//// any-this-method-reads-function-field.ts
// A method whose `this` is declared `any` reads a field that holds a function: a new one for each instance.
declare const console: { log(...a: unknown[]): void };
class K { f = () => 1; peek(this: any) { return this.f; } }
console.log(new K().peek() === new K().peek());
//// any-this-thenable-forwards-function-field.ts
// The `then` of a thenable that an async function returns has `this: any` and hands on a function field: a new one for each instance.
declare const console: { log(...a: unknown[]): void };
class Th { f = () => 1; then(this: any, res: (v: () => number) => void) { res(this.f); } }
async function run(): Promise<() => number> { return new Th(); }
console.log(await run() === await run());
