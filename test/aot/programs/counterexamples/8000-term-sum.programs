//// parsed-data-resolves-generic-promise.ts
// A promise of `{ answer: Msg }`, Msg a union of two records, is resolved with parsed JSON.
declare const console: { log(...values: unknown[]): void };
type Req = { jsonrpc: '2.0'; id: number | string; method: string; params?: Record<string, unknown> }
type Res = { jsonrpc: '2.0'; id: number | string; result: Record<string, unknown> }
type Msg = Req | Res
type Wrapped = { answer: Msg }
function local(id: number): Wrapped { return { answer: { jsonrpc: '2.0', id, result: {} } } }
class IO {
  private waiting = new Map<number, { resolve: (v: unknown) => void }>()
  send<T>(id: number): Promise<T> { return new Promise<T>(resolve => { this.waiting.set(id, { resolve: resolve as (v: unknown) => void }) }) }
  got(line: string) { const m = JSON.parse(line) as { id: number; response: unknown }; this.waiting.get(m.id)!.resolve(m.response) }
  async ask(id: number): Promise<Msg> { const r = await this.send<{ answer: Msg }>(id); return r.answer }
}
const io = new IO()
console.log(JSON.stringify(local(1)))
const p = io.ask(1).then(JSON.stringify, e => 'THROWN: ' + e.message)
io.got('{"id":1,"response":{"answer":{"jsonrpc":"2.0","id":7,"result":{"tools":[]}}}}')
console.log(await p)
//// parsed-data-spread-into-class-literal.ts
// TypeScript's classes are structural: a literal with all the members of a class is of its type. So is one that takes some of them from parsed data by a spread.
class Vec { x: number; y: number; constructor(x: number, y: number) { this.x = x; this.y = y } len2(): number { return this.x * this.x + this.y * this.y } }
function takes(v: Vec): string { return v.x + "," + v.y + "," + v.len2() }
const real = new Vec(3, 4);
const written: Vec = { x: 3, y: 4, len2() { return -1 } };
const parsed: { x: number; y: number } = JSON.parse('{"x":6,"y":8}');
const spread: Vec = { ...parsed, len2: real.len2 };
console.log(takes(real), takes(written), takes(spread));
//// parsed-data-under-literal-reaches-typed-code/lib.ts
export interface Free { piece: { part: number }; title: string }
export interface Holder { inner: Free; name: string }
export function readsFree(p: Free): string { return p.title + p.piece.part }
export function readsHolder(h: Holder): string { return h.name + readsFree(h.inner) }
export function makesHolder(n: number): Holder { return { inner: { piece: { part: n }, title: "made" }, name: "m" } }
//// parsed-data-under-literal-reaches-typed-code/main.ts
// A literal that holds parsed JSON reaches a typed function by seven ways, typed and untyped.
declare const console: { log(...values: unknown[]): void };
import { readsHolder, makesHolder } from "./lib";
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + String(e).replace(/\(bun compile[^)]*\)/, "").replace(/\n */g, " / ").slice(0, 200)) } }
function hide(v: unknown): any { return v }
const call: any = hide((f: any, o: any) => f(o));
function data(): any { return JSON.parse(`{"piece":{"part":1},"title":"b"}`) }
row("control: typed", () => readsHolder(makesHolder(2)));
row("control: all from JSON", () => call(readsHolder, JSON.parse(`{"inner":{"piece":{"part":1},"title":"b"},"name":"h"}`)));
row("1 a literal straight to unknown", () => call(readsHolder, hide({ inner: data(), name: "h" })));
row("2 a literal held as any", () => { const l: any = { inner: data(), name: "h" }; return call(readsHolder, l) });
row("3 a literal held with no annotation", () => { const l = { inner: data(), name: "h" }; return call(readsHolder, l) });
row("4 a literal straight to the typed call", () => readsHolder({ inner: data(), name: "h" }));
row("5 a literal with no annotation to the typed call", () => { const l = { inner: data(), name: "h" }; return readsHolder(l) });
row("6 a literal in an array", () => { const list: unknown[] = [{ inner: data(), name: "h" }]; return call(readsHolder, list[0]) });
row("7 a literal returned as unknown", () => { const f = (): unknown => ({ inner: data(), name: "h" }); return call(readsHolder, f()) });
//// pattern-default-not-stored.ts
// `[f = one] = [two]` stores two: calls of f run it.
declare const console: { log(...a: unknown[]): void };
const one = () => 1;
let f = one;
[f = one] = [() => 2];
console.log((() => f())());
//// pattern-target-evaluated-before-read.js
// In `({ x: target().f } = source)` the target is evaluated before x is read.
const s = { x: 1 }, o = { f: 0 };
({ x: (s.x = 2, o).f } = s);
console.log(o.f);
//// private-field-on-class-object.js
// A private field of another class installed on a class object leaves the class as it was.
class C {}
new class extends class { constructor(o) { return o; } } { #p; }(C);
console.log(C.name);
//// private-fields-exist-at-parameter-defaults.js
// A private field is on `this` when the default of the constructor's parameter reads it.
class A { #p = 7; constructor(a = this.#p) { console.log(a); } }
try { new A(); } catch (e) { console.log(e.name); }
//// private-method-from-other-evaluation.ts
// Calling a private method on an instance of another evaluation of the class throws a TypeError.
declare const console: { log(...a: unknown[]): void };
function make(n: number) { return class P { #m() { return n; } static call(o: P) { return o.#m(); } }; }
try { console.log(make(1).call(new (make(2))())); } catch (e) { console.log("threw", e instanceof TypeError); }
//// private-methods-absent-before-super.ts
// `#m in this` is false while the constructor of the parent class runs.
declare const console: { log(...a: unknown[]): void };
class Base { constructor() { console.log(D.has(this)); } }
class D extends Base { #m() {} static has(o: object) { return #m in o; } }
new D();
//// private-methods-from-running-constructor.ts
// `Reflect.construct(A, [], B)` makes an object with the private methods of A.
declare const console: { log(...a: unknown[]): void };
function make(n: number) {
  return class P { #m() { return n; } static ask(o: P) { return o.#m(); } };
}
const A = make(1);
console.log(A.ask(new A()), A.ask(Reflect.construct(A, [], make(2))));
