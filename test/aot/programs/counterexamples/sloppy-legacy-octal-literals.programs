row("straight to the argument", () => g({ ...f("a", 1), x: 1, y: "y", z: true }));
row("annotated", () => { const o: P = { ...f("a", 1), x: 1, y: "y", z: true }; return g(o) });
row("used twice", () => { const o = { ...f("a", 1), x: 1, y: "y", z: true } satisfies P; return g(o) + " | " + g(o) + " | " + o.x });
