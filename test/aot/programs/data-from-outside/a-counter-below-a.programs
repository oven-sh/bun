//// argument-data-used-in-typed-code/main.ts
// Data from outside is looked at as one type, and a function of another module hands it on as an argument of a second type with the same properties. What is read out of it is used in typed code: joined to a string, put into a template, compared, stored in an array. Handing it on tests only that it is an object. A property that holds another kind than its type declares is found at the first typed read of it, which throws a TypeError; null and a missing property pass. The module that is compiled first calls that function, so the compiler has looked into its body, and has resolved the call there, before it comes to check it.
import { pass } from "./pass";
import { viaPass } from "./types";
import { load } from "./load";

const odd = pass(load('{"id":"seven","name":null,"more":true}'));
////= lines
const written = `name ${odd.name}`;
console.log(written, odd.name === "n", [odd.name].length);

const short = viaPass(load('{"id":8}'));
const sum = "" + short.id + short.name;
console.log(sum, typeof short.name);
