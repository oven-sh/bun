//// a-sum-over-parsed-lengths-that-are-no-numbers-fills-a-number-field.ts
interface Item { lines: string[] }
interface Result { kept: Item[]; dropped: number }
function trim(items: Item[], limit: number): Result {
  const kept: Item[] = [];
  let used = 0;
  let dropped = 0;
  for (const item of items) {
    if (limit - used <= 0) { dropped += item.lines.length; continue; }
    kept.push(item);
    used += item.lines.length;
  }
  return { kept, dropped };
}
const r = trim(JSON.parse(process.argv.length > 5 ? "[]" : "[{\"lines\":[\"a\",\"b\"]},{\"lines\":{\"length\":\"x\"}}]"), 2);
console.log(r.kept.length, r.dropped, typeof r.dropped);
//// aliases-typed-by-dts/host.d.ts
// What a package's declaration file says of the host's settings, for main.ts.
export type Port = number;
export type Level = "high";
export type Mode = "fast" | "slow";
export type Pair = [number, string];
export interface Host { port: number; mode: Mode }
//// aliases-typed-by-dts/main.ts
// A location annotated with a type alias from a declaration file: the value belongs to the embedder, whatever the alias resolves to and however the program combines it.
import type { Host, Level, Mode, Pair, Port } from "./host";
const given: any = { port: "eighty", level: 3, mode: "turbo", pair: "not a pair" };
const row = (name: string, f: () => unknown) => { let r: unknown; try { r = f(); } catch (e) { r = "THROWS " + (e as Error).message.split(" (bun")[0]; } console.log(name + ": " + JSON.stringify(r)); };
const kind = (v: unknown) => typeof v + " " + JSON.stringify(v);
type Local = Port;
type Field<T extends { port: unknown }> = T["port"];
row("a primitive", () => { const port: Port = given.port; return kind(port); });
row("through an alias of the program's own", () => { const port: Local = given.port; return kind(port); });
row("a literal", () => { const level: Level = given.level; return kind(level); });
row("a union of literals", () => { const mode: Mode = given.mode; return kind(mode); });
row("a union with undefined", () => { const mode: Mode | undefined = given.mode; return kind(mode); });
row("a tuple", () => { const pair: Pair = given.pair; return kind(pair); });
row("parameters", () => ((port: Port, mode?: Mode) => [kind(port), kind(mode)])(given.port, given.mode));
row("a result", () => { function read(): Port { return given.port; } return kind(read()); });
row("an element", () => { const ports: Port[] = [given.port]; return kind(ports[0]); });
row("an indexed access", () => { const port: Host["port"] = given.port; return kind(port); });
row("an indexed access in an alias of the program's own", () => { const port: Field<Host> = given.port; return kind(port); });
row("a key", () => { const key: keyof Host = given.mode; return kind(key); });
row("a cast", () => kind(given.port as Port));
row("a field of a class", () => { class Server { port: Port = given.port; } return kind(new Server().port); });
row("members of an interface", () => { interface Settings { port: Port; mode: Mode | null } const settings: Settings = { port: given.port, mode: given.mode }; return [kind(settings.port), kind(settings.mode)]; });
type Own = number;
row("an alias of the program's own stays a fact", () => { const own: Own = 80; const list: Own[] = [own, 81]; return [kind(own), list[0] + list[1]]; });
//// an-object-from-outside-is-stored-into-its-own-field-whose-name-a-literal-has.js
// A value that nothing is known of is stored into its own field. Only one literal of the program has a field of that name, and what that literal holds there is no such object.
function helper() { return 1; }
const withInteger = { own: 5, n: 1 };
const withText = { mine: "text", n: 2 };
const withFunction = { self: helper, n: 3 };
const withLiteral = { inner: { k: 4 }, n: 4 };
function intoOwn(o) { o.own = o; return o; }
function intoMine(o) { o.mine = o; return o; }
function intoSelf(o) { o.self = o; return o; }
function intoInner(o) { o.inner = o; return o; }
function twice(o) { o.own = o; o.own = o; return o.own; }
let circles = 0;
for (let turn = 0; turn < 3000; turn++) {
  const text = '{"n":' + turn + "}";
  const a = intoOwn(JSON.parse(text)), b = intoMine(JSON.parse(text)), c = intoSelf(JSON.parse(text)), d = intoInner(JSON.parse(text)), e = twice(JSON.parse(text));
  if (a.own === a && b.mine === b && c.self === c && d.inner === d && e.own === e && a.n === turn) circles++;
}
console.log(circles, withInteger.own + 1, withText.mine + "!", withFunction.self(), withLiteral.inner.k);
//// annotated-variable-match-keeps-identity.ts
// Objects that match the annotation enter the variable as they are: same identity, stores seen through every reference.
interface Meta { sign: string[] | true; secrets?: string }
function compose(app: any): string {
  const meta: Meta = app.cookie;
  const same = meta === app.cookie;
  meta.secrets = "s";
  if (meta.sign !== true) meta.sign.push("more");
  return same + " " + JSON.stringify(app);
}
console.log(compose({ cookie: { sign: ["a"] } }));
console.log(compose(JSON.parse('{"cookie":{"sign":["a"],"secrets":"t"}}')));
console.log(compose(JSON.parse('{"cookie":{"sign":true}}')));
//// annotated-variable-mismatch-argument-still-checked.ts
// The same parsed object is held by an annotated variable and passed as an argument: any object passes both, and the member it does not have reads undefined.
interface Meta { sign: string[] | true; secrets?: string }
function isSigned(meta: Meta): boolean { return !!meta.sign; }
function attempt(name: string, f: () => unknown): void { try { console.log(name, f()); } catch (e) { console.log(name, (e as Error).name); } }
const own: Meta = { sign: true };
const bag: unknown[] = [];
function load(text: string): any { bag.push(JSON.parse(text)); return bag.pop(); }
attempt("made by the program:", () => isSigned(own));
attempt("variable, then argument:", () => { const raw: any = load('{"path":"/"}'); const meta: Meta = raw; return [!!meta.sign, isSigned(raw)].join(); });
attempt("argument, then variable:", () => { const raw: any = load('{"path":"/"}'); const signed = isSigned(raw); const meta: Meta = raw; return [signed, !!meta.sign].join(); });
attempt("argument alone:", () => isSigned(load('{"path":"/"}')));
attempt("variable alone:", () => { const meta: Meta = load('{"path":"/"}'); return !!meta.sign; });
//// annotated-variable-mismatch-assigned-later.ts
// The annotated variable is declared without a value and assigned from `any` later.
interface Meta { sign: string[] | true; secrets?: string }
function compose(app: any): string {
  let meta: Meta | undefined;
  if (app.config) meta = app.config.cookie;
  if (meta?.sign) { meta.sign = true; return "signed"; }
  if (meta) meta.secrets = "none";
  return "plain " + JSON.stringify(meta);
}
console.log(compose({ config: { cookie: { path: "/" } } }));
console.log(compose({ config: { cookie: { sign: ["a"] } } }));
console.log(compose({}));
//// annotated-variable-mismatch-class-instance.ts
// What enters the variable is an instance of a class, a function, an array or a Map, none of which has the required property.
interface Meta { sign: string[] | true; secrets?: string }
class Other { path = "/"; }
function compose(value: any): string {
  const meta: Meta = value;
  if (meta.sign) return "signed";
  meta.secrets = "none";
  return "plain " + (value as any).secrets + " " + (meta === value);
}
console.log(compose(new Other()));
console.log(compose(function named() {}));
console.log(compose([1, 2]));
console.log(compose(new Map()));
//// annotated-variable-mismatch-conditional-initializer.ts
// The initializer is a conditional expression; both of its branches are `any`.
function merge(a: any, b: any): any { return { ...a, ...b }; }
function compose(app: any, validator: any): string {
  const meta: { secrets?: string | string[]; sign: string[] | true; properties: { [name: string]: Object } } = validator.cookie?.config
    ? merge(validator.cookie.config, app.config.cookie as any)
    : app.config.cookie;
  if (meta?.sign) {
    if (!meta.secrets) return "no secret";
    if (typeof meta.sign === "string") meta.sign = [meta.sign];
    return "signed " + JSON.stringify(meta);
  }
  return "plain " + JSON.stringify(meta);
}
console.log(compose({ config: { cookie: { path: "/" } } }, {}));
console.log(compose({ config: { cookie: { path: "/" } } }, { cookie: { config: { httpOnly: true } } }));
console.log(compose({ config: { cookie: { sign: ["a"], secrets: "s" } } }, { cookie: { config: { httpOnly: true } } }));
console.log(compose({ config: {} }, {}));
//// annotated-variable-mismatch-default-operators.ts
// The initializer joins two `any` values with ??, || or &&.
interface Meta { sign: string[] | true; secrets?: string }
function first(app: any): string { const meta: Meta = app.own ?? app.shared; meta.secrets = "a"; return JSON.stringify(meta); }
function second(app: any): string { const meta: Meta = app.own || app.shared; meta.secrets = "b"; return JSON.stringify(meta); }
function third(app: any): string { const meta: Meta = app.own && app.shared; meta.secrets = "c"; return JSON.stringify(meta); }
console.log(first({ shared: { path: "/" } }), first({ own: { path: "/own" } }), first({ own: { sign: true } }));
console.log(second({ shared: { path: "/" } }), second({ own: { path: "/own" } }), second({ own: { sign: true } }));
console.log(third({ own: 1, shared: { path: "/" } }), third({ own: 1, shared: { sign: ["x"] } }));
//// annotated-variable-mismatch-destructured.ts
// An annotated destructuring pattern takes its properties from an `any` value that does not match the annotation.
interface Meta { sign: string[] | true; secrets?: string }
function compose(app: any): string {
  const { sign, secrets }: Meta = app.cookie;
  return (sign ? "signed" : "plain") + " " + secrets;
}
console.log(compose({ cookie: { path: "/" } }));
console.log(compose(JSON.parse('{"cookie":{"secrets":"s"}}')));
console.log(compose({ cookie: { sign: ["a"], secrets: "t" } }));
//// annotated-variable-mismatch-frozen.ts
// The object that does not match is frozen: entering the variable does nothing to it, and a store throws what plain JavaScript throws.
interface Meta { sign: string[] | true; secrets?: string }
function compose(app: any): string {
  const meta: Meta = app.cookie;
  if (meta.sign) return "signed";
  try { meta.sign = true; } catch (e) { return (e as Error).name + " " + Object.isFrozen(meta) + " " + JSON.stringify(meta); }
  return "stored";
}
console.log(compose({ cookie: Object.freeze({ path: "/" }) }));
console.log(compose({ cookie: Object.freeze(JSON.parse('{"path":"/"}')) }));
console.log(compose({ cookie: Object.freeze({ sign: ["a"] }) }));
//// annotated-variable-mismatch-getter.ts
// The object that does not match has an accessor: it runs when the property is read or stored, not when the object enters the variable.
interface Meta { sign: string[] | true; count: number }
const log: string[] = [];
function make(): any {
  let held: unknown = undefined;
  return { get sign() { log.push("get"); return held; }, set sign(value: unknown) { log.push("set"); held = value; }, path: "/" };
}
function compose(app: any): string {
  const meta: Meta = app.cookie;
  log.push("entered");
  if (meta.sign) return "signed";
  meta.sign = true;
  return meta.sign ? "signed now" : "plain";
}
console.log(compose({ cookie: make() }), log.join(","));
//// annotated-variable-mismatch-in-closure.ts
// Closures capture the annotated variable, read it and store to it.
function compose(app: any): () => string {
  const meta: { secrets?: string | string[]; sign: string[] | true } = app.config.cookie;
  let cached = "";
  const encode = () => {
    if (cached) return cached;
    if (meta?.sign) {
      if (typeof meta.sign === "string") meta.sign = [meta.sign];
      cached = "signed " + JSON.stringify(meta.sign);
    } else cached = "plain " + JSON.stringify(meta);
    return cached;
  };
  return () => encode() + " " + encode();
}
console.log(compose({ config: { cookie: { path: "/" } } })());
console.log(compose({ config: { cookie: { sign: ["a"] } } })());
console.log(compose({ config: {} })());
//// annotated-variable-mismatch-in-loop.ts
// Matching and mismatching objects enter the same annotated variable in turn.
interface Item { id: number; tags: string[] }
function total(list: any[]): string {
  let sum = 0, untagged = 0;
  for (let i = 0; i < list.length; i++) {
    const item: Item = list[i];
    if (item.tags) { sum += item.tags.length; item.tags = []; } else { untagged++; item.tags = ["new"]; }
  }
  return sum + " " + untagged + " " + JSON.stringify(list);
}
const list: any[] = [];
for (let i = 0; i < 12; i++) list.push(i % 3 === 0 ? { id: i, tags: ["t" + i] } : i % 3 === 1 ? { id: i } : { name: "n" + i });
console.log(total(list));
console.log(total(JSON.parse('[{"id":1,"tags":["a","b"]},{"id":2},{"tags":["c"]},{}]')));
//// annotated-variable-mismatch-left-operand-of-default.ts
// An object that comes through `any` into an annotated variable and does not fit the declared record type stays as it is, whichever operand of `??`, `||`, `&&`, `?:` or `,` it is,
// and through `??=`, `||=` and `&&=` too. As plain Bun, line by line.
interface Nested { cwd: string }
interface Wanted { id: string; ctx: Nested }
const parse = (text: string): any => JSON.parse(text);
const lacking = '{"id":"y"}';
const fitting = '{"id":"z","ctx":{"cwd":"/"}}';
const kept: Wanted = { id: "k", ctx: { cwd: "/" } };
const list: any[] = [parse(lacking)];
const cases: [string, (text: string) => unknown][] = [
  ["alone", text => { const v: Wanted = parse(text); return v.id; }],
  ["?? right", text => { const v: Wanted = parse("null") ?? parse(text); return v.id; }],
  ["?? left", text => { const v: Wanted = parse(text) ?? parse("null"); return v.id; }],
  ["?? left, typed right", text => { const v: Wanted = parse(text) ?? kept; return v.id; }],
  ["|| right", text => { const v: Wanted = parse("0") || parse(text); return v.id; }],
  ["|| left", text => { const v: Wanted = parse(text) || parse("0"); return v.id; }],
  ["|| left, typed right", text => { const v: Wanted = parse(text) || kept; return v.id; }],
  ["&& right", text => { const v: Wanted = parse("1") && parse(text); return v.id; }],
  ["?: then", text => { const v: Wanted = text.length > 0 ? parse(text) : parse("null"); return v.id; }],
  ["?: else", text => { const v: Wanted = text.length === 0 ? parse("null") : parse(text); return v.id; }],
  ["comma", text => { const v: Wanted = (parse("0"), parse(text)); return v.id; }],
  ["nested ?? left", text => { const v: Wanted = (parse(text) ?? parse("null")) ?? parse("null"); return v.id; }],
  ["?? in ||", text => { const v: Wanted = (parse("null") ?? parse(text)) || parse("0"); return v.id; }],
  ["element || other", _ => { const v: Wanted = list[0]! || kept; return v.id; }],
  ["assigned ?? left", text => { let v: Wanted = kept; v = parse(text) ?? parse("null"); return v.id; }],
  ["assigned || left", text => { let v: Wanted = kept; v = parse(text) || parse("0"); return v.id; }],
  ["??=", text => { let v: Wanted | undefined = parse("null") ?? undefined; v ??= parse(text); return v!.id; }],
  ["||=", text => { let v: Wanted | undefined = parse("null") ?? undefined; v ||= parse(text); return v!.id; }],
  ["&&=", text => { let v: Wanted | undefined = kept; v &&= parse(text); return v!.id; }],
  ["the value of ??=", text => { let v: Wanted | undefined = parse("null") ?? undefined; const w: any = (v ??= parse(text)); return w.id + typeof w.ctx; }],
  ["read of the missing member", text => { const v: Wanted = parse(text) ?? kept; return typeof v.ctx; }],
  ["the same object", text => { const from = parse(text); const v: Wanted = from ?? kept; const back: any = v; return text === lacking ? back === from : back.id === from.id; }],
];
