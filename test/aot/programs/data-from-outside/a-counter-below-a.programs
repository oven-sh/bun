import { one, many, keyed, held, Service, arrow, own } from "./typed.ts";
const row = (name, run) => { try { console.log(name + ": " + run()); } catch (error) { console.log(name + ": THROWS " + String(error).split(" (bun")[0]); } };
const plain = () => ({ id: 1, name: "given" });
export function run() {
  row("one", () => one(plain()));
  row("many", () => many([plain(), plain()]));
  row("keyed", () => keyed(new Map([["k", plain()]])));
  row("held", () => held({ inner: plain() }));
  row("a method", () => new Service().take(plain()));
  row("a method with an array", () => new Service().all([plain()]));
  row("an arrow function", () => arrow(plain()));
  row("by value", () => [plain()].map(one).join());
  row("own", () => own());
}
//// js-caller-plain-object-arguments/main.ts
// A JavaScript file of the program calls typed functions, methods and constructors with plain objects that have all the members of the class that the parameter names. The class itself is never handed to it.
import { run } from "./caller.js";
run();
//// js-caller-plain-object-arguments/typed.ts
export class User { id: number = 0; name: string = "made"; }
function show(u: User): string { return u.name + u.id + " " + (u instanceof User) + " " + Object.keys(u).join(); }
export function one(u: User): string { return show(u); }
export function many(users: User[]): string { return users.map(show).join(" | "); }
export function keyed(users: Map<string, User>): string { return show(users.get("k")!); }
export function held(holder: { inner: User }): string { return show(holder.inner); }
export class Service { last: User = new User(); take(u: User): string { this.last = u; return show(this.last); } all(users: User[]): string { return many(users); } }
export const arrow = (u: User): string => show(u);
export function own(): string { return show(new User()); }
//// json-into-class-array-with-methods.ts
// Parsed data has no methods. Held to an array of a class that has one, it does not fit the type, and the program finds out where plain Bun finds out: its fields are read, `instanceof` says false, and the call of the method is the TypeError, not the read of the element.
class Shouting { field: string = "made"; shout(): string { return this.field.toUpperCase(); } }
function row(name: string, run: () => unknown) { try { console.log(name + ": " + String(run())); } catch (error) { console.log(name + ": THROWS " + (error as Error).name); } }
const list: Shouting[] = JSON.parse('[{"field":"given"}]');
list.push(new Shouting());
row("the element", () => typeof list[0]);
row("its field", () => list[0].field);
row("instanceof", () => list[0] instanceof Shouting);
row("its method", () => list[0].shout());
row("whether it has the method", () => "shout" in list[0]);
row("the one that was made", () => list[1].shout() + " " + (list[1] instanceof Shouting));
row("all fields", () => list.map(each => each.field).join());
row("all methods", () => list.map(each => each.shout()).join());
//// json-parse-cached-names-and-strings-in-texts-of-both-widths.ts
// JSON.parse remembers short names and strings by the bytes of the source. A 16-bit text has one byte for each character, and the same byte for every character outside Latin-1:
// what is remembered from one text may be found again in a text of the other width only where equal bytes are equal characters.
function codes(value: unknown): string {
    const text = JSON.stringify(value);
    let shown = "";
    for (let i = 0; i < text.length; i++) shown += text.charCodeAt(i) < 127 ? text[i] : "<" + text.charCodeAt(i).toString(16) + ">";
    return shown;
}
function widened(text: string): string { return (text + "中").slice(0, -1); }
const texts = [
    '{"ÿ":"ÿÿ","a":"ÿb","list":[{"ÿ":1},{"ÿ":2}]}',
    '{"中":"中文","a":"中b","list":[{"中":1},{"文":2}]}',
    '{"þ":"þþ","a":"þb","list":[{"þ":1},{"ÿ":2}]}',
    '{"name":"Ada","a":"plain","list":[{"name":"Ada"},{"name":"Ada"}]}',
    '{"name":"Ada","a":"plain","list":[{"name":"Ada"},{"name":"中"}],"中":"Ada"}',
    '{"café":"café","a":"café","list":[{"café":"café"}]}',
    '{"cafй":"cafй","a":"cafй","list":[{"cafй":"cafй"}]}',
];
const lines: string[] = [];
for (let round = 0; round < 3; round++) {
    for (const text of texts) {
        lines.push(codes(JSON.parse(text)));
        lines.push(codes(JSON.parse(widened(text))));
    }
    for (const text of texts.slice().reverse()) lines.push(codes(JSON.parse(widened(text))) + codes(JSON.parse(text)));
}
console.log(lines.join("\n"));
//// json-parse-closes-8-bit-texts-in-compiled-code.ts
// Compiled code closes the text of a parse into a declared type itself where the value ends the text and the run time owns nothing for it. The run time is
// asked to close a text that goes on behind the value, which it reads to the end, and a 16-bit text, whose original characters it holds.
// Only the jsc shell with --aotCountsPath=<path> can count. Elsewhere the program checks the answers alone.
declare const aotOperationCount: undefined | ((name: string) => number);
const canCount = typeof aotOperationCount === "function";
const closedByRunTime = () =>
  typeof aotOperationCount === "function" ? aotOperationCount("operationAOTJSONSourceClose") : 0;

interface Point {
  x: number;
  y: number;
  label: string;
}
function parsePoint(text: string): Point {
  return JSON.parse(text) as Point;
}
function sumOf(texts: string[], rounds: number): number {
  let sum = 0;
  for (let round = 0; round < rounds; round++) {
    for (let index = 0; index < texts.length; index++) {
      const point = parsePoint(texts[index]);
      sum += point.x * 3 + point.y + point.label.length;
    }
  }
  return sum;
}

const rounds = 200;
const narrowTexts = ['{"x":1,"y":2,"label":"a"}', ' {"x":3,"y":4,"label":"bc"}', '{"x":5,"y":6,"label":"é"}'];
const paddedTexts = ['{"x":1,"y":2,"label":"a"}\n', '{"x":3,"y":4,"label":"bc"} \t '];
const wideTexts = ['{"x":1,"y":2,"label":"日"}', '{"x":3,"y":4,"label":"日本"}'];
sumOf(narrowTexts, 1);
sumOf(paddedTexts, 1);
sumOf(wideTexts, 1);

const before = closedByRunTime();
console.log("8-bit texts: " + sumOf(narrowTexts, rounds) + ", closed by the run time: " + (closedByRunTime() - before));

function reportClosedByRunTime(label: string, texts: string[]): void {
  const before = closedByRunTime();
  const sum = sumOf(texts, rounds);
  const closes = closedByRunTime() - before;
  console.log(label + ": " + sum + ", all closed by the run time: " + (!canCount || closes === rounds * texts.length));
}
reportClosedByRunTime("8-bit texts with white space at the end", paddedTexts);
reportClosedByRunTime("16-bit texts", wideTexts);

for (const text of ['{"x":1,"y":2,"label":"a"} x', '{"x":1,"y":2,"label":"a"}}', '{"x":1,"y":2,"label":"a"']) {
  try {
    console.log(JSON.stringify(parsePoint(text)));
  } catch (error) {
    console.log((error as Error).name);
  }
}
console.log("after the failures: " + sumOf(narrowTexts, 2));
//// json-parse-elements-that-differ-from-the-one-in-front.ts
// The elements of an array are parsed with the names of the element in front at hand. Every way in which an element may differ from the one in front, in 8-bit and in 16-bit texts.
const texts = [
    '[{"a":1,"b":2},{"a":3,"b":4},{"a":5,"b":6}]',
    '[{"a":1,"b":2},{"a":3},{"a":5,"b":6},{"a":7,"b":8,"c":9},{"a":1,"b":2}]',
    '[{"a":1,"b":2},{"b":3,"a":4},{"a":5,"b":6},{"b":7,"a":8}]',
    '[{"a":1,"b":2},{"a":3,"c":4},{"a":5,"b":6},{"a":7,"c":8},{"a":9,"c":10}]',
    '[{"a":1,"b":2},{"ab":3,"b":4},{"a" :5,"b": 6},{ "a":7 , "b":8 },{"a":\n9,"b":\t10}]',
    '[{"a":1,"a":2},{"a":3,"a":4},{"a":5}]',
    '[{},{"a":1},{},{"a":2},{"a":3}]',
    '[{"a":{"x":[{"p":1},{"p":2},{"q":3}]},"b":1},{"a":{"x":[{"p":4},{"q":5}]},"c":2},{"a":{"x":[]},"b":3}]',
    '[{"aVeryLongNameOfAMemberIndeed":1,"b":2},{"aVeryLongNameOfAMemberIndeed":3,"b":4},{"aVeryLongNameOfAMemberIndeeX":5,"b":6}]',
    '[{"fourteenBytes":1,"b":2},{"fourteenBytes":3,"b":4},{"fourteenBytez":5,"b":6},{"thirteenByte":7},{"thirteenByte":8}]',
    '[{"a":1,"b":"x","c":true,"d":null,"e":1.5,"f":[1],"g":{"h":1}},{"a":-1,"b":"y","c":false,"d":null,"e":1e3,"f":[],"g":{}},{"a":0,"b":"","c":true,"d":0,"e":-0,"f":[[]],"g":{"h":2}}]',
    '[{"0":1,"a":2},{"0":3,"a":4},{"a":5,"0":6}]',
    '[{"__proto__":1,"a":2},{"__proto__":3,"a":4},{"a":5}]',
    '[{"\\u0061":1,"b":2},{"a":3,"b":4},{"\\u0061":5,"b":6}]',
    '[{"é":1,"b":2},{"é":3,"b":4},{"e":5,"b":6}]',
    '[{"中":1,"b":2},{"中":3,"b":4},{"丮":5,"b":6}]',
    '[[{"a":1}],[{"a":2},{"a":3}],{"a":4},{"a":5},1,{"a":6},"s",{"a":7}]',
    '[' + Array.from({ length: 20 }, (_, i) => '{' + Array.from({ length: 15 }, (_, j) => `"k${j}":${i + j}`).join() + '}').join() + ']',
    '[' + Array.from({ length: 6 }, (_, i) => '{' + Array.from({ length: 70 }, (_, j) => `"k${j}":${i + j}`).join() + '}').join() + ']',
];
const bad = ['[{"a":1,"b":2},{"a":3,"b":4]', '[{"a":1,"b":2},{"a":3,"b"}]', '[{"a":1},{"a":}]', '[{"a":1},{"a":1,}]', '[{"a":1},{"a" 1}]', '[{"a":1},{"a":01}]', '[{"a":1},{"a":1', '[{"a":1},{"a"'];
const launder = new Function("value", process.argv[2] ?? "return value") as <V>(value: V) => V;
const parse = launder(JSON.parse);
const lines: string[] = [];
for (let round = 0; round < 3; round++) {
    for (const text of texts) {
        const value = parse(text) as unknown[];
        lines.push(JSON.stringify(value) + " " + value.map(element => element !== null && typeof element === "object" ? Object.keys(element).join("") : typeof element).join());
        lines.push(JSON.stringify(new TextDecoder().decode(new TextEncoder().encode(text)) === text));
    }
    for (const text of bad) {
        try { parse(text); lines.push("parsed"); } catch (error) { lines.push((error as Error).name); }
    }
}
let hash = 0;
for (const line of lines) for (let i = 0; i < line.length; i++) hash = (hash * 31 + line.charCodeAt(i)) | 0;
console.log(lines.length, hash);
console.log(lines.slice(0, 46).map(line => line.length > 300 ? line.slice(0, 150) + ".." + line.slice(-150) : line).join("\n"));
//// json-parse-into-a-union-that-contains-itself-takes-linear-time.ts
// JSON.parse(text) without a type argument, returned as a union of records that contains itself: the time grows with the length of the text, not by a factor for each level.
type ByName = { below: ByName | null; a: number } | { below: ByName | null; b: number };
type ByKind = { below: ByKind | null; k: number } | { below: ByKind | null; k: string };
type ByTag = { below: ByTag | null; k: "one" } | { below: ByTag | null; k: "two" };
type InLists = { below: InLists[]; k: number[] } | { below: InLists[]; k: string[] };
type Forked = { left: Forked | null; right: Forked | null; k: 1 } | { left: Forked | null; right: Forked | null; k: 2 };

const byName = (text: string): ByName => JSON.parse(text);
const byKind = (text: string): ByKind => JSON.parse(text);
const byTag = (text: string): ByTag => JSON.parse(text);
const inLists = (text: string): InLists => JSON.parse(text);
const forked = (text: string): Forked => JSON.parse(text);

const nest = (open: string, middle: string, close: string, levels: number) => open.repeat(levels) + middle + close.repeat(levels);
const kinds: [string, (text: string) => unknown, (levels: number) => string][] = [
  ["other names", byName, levels => nest('{"below":', "null", ',"b":1}', levels)],
  ["a number or a string", byKind, levels => nest('{"below":', "null", ',"k":"s"}', levels)],
  ["text tags", byTag, levels => nest('{"below":', "null", ',"k":"two"}', levels)],
  ["lists", inLists, levels => nest('{"below":[', "", '],"k":["s"]}', levels)],
  ["two nested members", forked, levels => nest('{"left":null,"right":', "null", ',"k":2}', levels)],
];

for (const [label, parse, text] of kinds) {
  for (const levels of [1, 20, 40, 200, 2000]) {
    const given = text(levels);
    const start = Date.now();
    const isSame = JSON.stringify(parse(given)) === given;
    console.log(label + ", " + levels + " levels: " + (isSame ? "what JSON.parse gives" : "ANOTHER VALUE") + (Date.now() - start > 1000 ? " TOO SLOWLY" : ""));
  }
}
//// json-parse-into-small-and-large-declared-types.ts
// JSON.parse(text) that goes to a declared type is read by a parser compiled for the type, of three members or of twenty. A text that the compiled parser does not take goes to the engine's parser.
declare const aotOperationCount: undefined | ((name: string) => number);
const counted = typeof aotOperationCount === "function" ? aotOperationCount : null;
interface Order {
  customer: { id: number; name: string };
  items: { sku: string; quantity: number }[];
  coupon?: string;
}
interface Settings {
  a01: number; a02: number; a03: number; a04: number; a05: number; a06: number; a07: number; a08: number; a09: number; a10: number;
  b01: string; b02: string; b03: string; b04: string; b05: string; b06: string; b07: string; b08: string; b09: string; b10: string;
}
////= lines-5	order	Order
////= lines-5	settings	Settings
const names = ["operationAOTJSONSourceOpen", "operationAOTJSONSourceAbandon"];
function measure(label: string, read: (text: string) => unknown, text: string, isTaken?: boolean) {
  const before = names.map(name => (counted ? counted(name) : 0));
  const value = read(text);
  const [entered, givenUp] = names.map((name, at) => (counted ? counted(name) : 0) - before[at]!);
  const isAsExpected = !counted || (entered === 1 && (isTaken === undefined || givenUp === (isTaken ? 0 : 1)));
  const expected = JSON.parse(text, (_, held) => held);
  const isRight = JSON.stringify(value) === JSON.stringify(expected);
  console.log(label + ": " + (isAsExpected ? "as expected" : "compiled parsers entered " + entered + ", given up " + givenUp) + ", " + (isRight ? "right" : "WRONG"));
}
const anOrder: Order = { customer: { id: 1, name: "n" }, items: [{ sku: "a", quantity: 2 }, { sku: "b", quantity: 3 }], coupon: "c" };
const someSettings: Settings = {
  a01: 1, a02: 2, a03: 3, a04: 4, a05: 5, a06: 6, a07: 7, a08: 8, a09: 9, a10: 10,
  b01: "1", b02: "2", b03: "3", b04: "4", b05: "5", b06: "6", b07: "7", b08: "8", b09: "9", b10: "10",
};
measure("a small type", order, JSON.stringify(anOrder), true);
measure("a small type, again", order, JSON.stringify(anOrder), true);
measure("a small type, indented, for the first time", order, JSON.stringify(anOrder, null, 2));
measure("a small type, indented, for the second time", order, JSON.stringify(anOrder, null, 2));
for (let turn = 0; turn < 14; turn++) order(JSON.stringify(anOrder, null, 2));
measure("a small type, indented, for the seventeenth time", order, JSON.stringify(anOrder, null, 2));
measure("a small type, indented, for the eighteenth time", order, JSON.stringify(anOrder, null, 2));
measure("a large type", settings, JSON.stringify(someSettings), true);
measure("a large type, again", settings, JSON.stringify(someSettings), true);
measure("a large type, indented", settings, JSON.stringify(someSettings, null, 2));
measure("a large type, its keys the other way round", settings, JSON.stringify(Object.fromEntries(Object.entries(someSettings).reverse())));
measure("a large type, but an array comes", settings, "[1,2,3]", false);
//// json-parse-kinds-seen-while-the-first-texts-go-by.ts
// The parser that expects keys lets sixteen texts of a beginning go by. If there are two to eight kinds among them (a kind: the first two strings of a text), the beginning starts told apart: each kind has a root shape and a credit of its own, and a kind that is served badly is not carried by one that is served well. A first value that is new every time, or one of many, names no kind.
function measure(label: string, count: number, make: (at: number) => string) {
  let wrong = 0;
  for (let at = 0; at < count; at++) {
    const text = make(at);
    const value: unknown = JSON.parse(text);
    if (JSON.stringify(value) !== text) wrong++;
  }
  console.log(label + ": " + count + " texts, " + wrong + " wrong");
}
measure("two kinds in turn", 100, at => (at % 2 ? '{"sort":"red","r":' + at + ',"s":2}' : '{"sort":"blue","b":"x","at":' + at + "}"));
measure("one kind", 100, at => '{"state":"on","n":' + at + "}");
measure("a first value that is new every time", 100, at => '{"token":"t' + at + '","n":1}');
measure("twenty first values in turn", 100, at => '{"group":"g' + (at % 20) + '","n":' + at + "}");
measure("a rare kind comes first", 100, at => (at ? '{"event":"' + (at % 2 ? "open" : "shut") + '","at":' + at + "}" : '{"event":"hello","version":1}'));
measure("three rare kinds come first", 100, at => (at > 3 ? '{"phase":"' + (at % 2 ? "rise" : "fall") + '","at":' + at + "}" : '{"phase":"' + ["one", "one", "two", "three"][at] + '","version":1}'));
const prose = "word ".repeat(400);
measure("a small kind and one of long strings", 600, at => (at % 8 ? '{"part":"small","n":' + at + "}" : '{"part":"large","body":"' + prose + at + '"}'));
//// json-parse-learns-the-keys.ts
// JSON.parse without a reviver goes by the keys it has seen at each place, once sixteen texts that begin with the same eight characters have gone by. Whatever comes then, keys in another order, absent, new, repeated or escaped, another kind of value, no JSON at all, the answer is that of the general parser.
const order = '{"customer":{"id":1,"name":"n"},"items":[{"sku":"a","quantity":2},{"sku":"b","quantity":3}],"coupon":"c"}';
function measure(label: string, text: string, parse: (text: string) => unknown = text => JSON.parse(text), isSeenBefore = true) {
  if (isSeenBefore) {
    for (let turn = 0; turn < 4; turn++) JSON.parse(order);
    for (let turn = text.startsWith('{"customer"') ? 1 : 16; turn > 0; turn--) {
      try {
        JSON.parse(text);
      } catch {}
    }
  }
  let seen: string;
  try {
    seen = JSON.stringify(parse(text)) === JSON.stringify(JSON.parse(text, (_, held) => held)) ? "right" : "WRONG";
  } catch (error) {
    seen = (error as Error).name;
  }
  console.log(label + ": " + seen);
}
measure("a text that begins as none before", order, undefined, false);
measure("the second that begins so", order, undefined, false);
for (let turn = 0; turn < 13; turn++) JSON.parse(order);
measure("the sixteenth", order, undefined, false);
measure("the seventeenth", order, undefined, false);
measure("the eighteenth", order, undefined, false);
measure("indented", JSON.stringify(JSON.parse(order), null, 2));
measure("another order of keys", '{"items":[{"quantity":2,"sku":"a"}],"coupon":"c","customer":{"name":"n","id":1}}');
measure("a key is absent", '{"customer":{"id":1},"items":[]}');
measure("a key more", '{"customer":{"id":1,"name":"n","vip":true},"items":[],"coupon":"c","note":"x"}');
measure("another kind of object", '{"title":"t","body":"b","tags":["x","y"]}');
measure("the first kind again", order);
measure("another kind of value at a place", '{"customer":5,"items":{"sku":"a"},"coupon":[1,{"deep":true}]}');
measure("a repeated key", '{"customer":{"id":1,"id":2},"items":[]}');
measure("an escaped key", '{"customer":{"\\u0069d":1},"items":[]}');
measure("a key that is an index", '{"customer":{"0":1},"items":[]}');
measure("__proto__", '{"customer":{"__proto__":1},"items":[]}');
measure("a list at the root", "[" + order + "," + order + "]");
measure("a number", "5");
measure("no JSON", '{"customer":');
measure("an undefined reviver", order, text => JSON.parse(text, undefined));
measure("a reviver", order, text => JSON.parse(text, (_, held) => held));
let dictionary = "{";
for (let i = 0; i < 60; i++) dictionary += (i ? "," : "") + '"key' + i + '":{"value":' + i + ',"name":"n","ok":true,"note":null,"more":[1,2,3],"last":"the last of six"}';
measure("sixty keys", '{"table":' + dictionary + "}}");
measure("sixty keys again", '{"table":' + dictionary + "}}");
measure("sixty other keys", '{"table":' + dictionary.replaceAll("key", "other") + "}}");
