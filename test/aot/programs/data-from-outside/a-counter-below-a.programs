//// annotated-variable-mismatch-module-variable.ts
// The annotated variable is a variable of the module.
interface Meta { sign: string[] | true; secrets?: string }
const source: any = { cookie: { path: "/" } };
const meta: Meta = source.cookie;
export function describe(): string {
  if (meta.sign) { meta.sign = true; return "signed"; }
  meta.secrets = "none";
  return "plain " + JSON.stringify(source);
}
console.log(describe());
//// annotated-variable-mismatch-name-stored-elsewhere.ts
// The variable is only read; an unrelated object literal elsewhere in the program has a property of the same name.
function compose(app: any): string {
  const meta: { secrets?: string; sign: string[] | true } = app.config.cookie;
  if (meta?.sign) return "signed";
  return "plain";
}
const unrelated = { sign: 1 };
console.log(compose({ config: { cookie: { path: "/" } } }), unrelated.sign);
//// annotated-variable-mismatch-nested.ts
// The mismatch is one level down: the outer object matches, the object in its property is missing a required property.
interface Cookie { sign: string[] | true; secrets?: string }
interface Config { name: string; cookie: Cookie }
function compose(app: any): string {
  const config: Config = app.config;
  const cookie = config.cookie;
  if (cookie.sign) { cookie.sign = true; return config.name + " signed"; }
  cookie.secrets = "set";
  return config.name + " plain " + JSON.stringify(config);
}
console.log(compose({ config: { name: "a", cookie: { path: "/" } } }));
console.log(compose(JSON.parse('{"config":{"name":"b","cookie":{"path":"/"}}}')));
console.log(compose({ config: { name: "c", cookie: { sign: ["x"] } } }));
//// annotated-variable-mismatch-parsed.ts
// The result of JSON.parse goes straight into the annotated variable. Any object enters, an array too, and a member it does not have reads undefined. A member of another kind throws at its typed read.
interface Meta { sign: string[] | true; secrets?: string }
function read(text: string): string {
  const meta: Meta = JSON.parse(text);
  if (meta.sign) { meta.sign = true; return "signed " + JSON.stringify(meta); }
  meta.secrets = "none";
  return "plain " + JSON.stringify(meta);
}
console.log(read('{"path":"/"}'));
console.log(read('{"sign":["a"]}'));
try { console.log(read('{"sign":7,"secrets":[1]}')); } catch (e) { console.log("a number for sign:", (e as Error).constructor.name); }
console.log(read('[1,2]'));
//// annotated-variable-mismatch-passed-on.ts
// The object that does not match goes on from the variable into typed functions, a typed property and an array.
interface Meta { sign: string[] | true; secrets?: string }
function isSigned(meta: Meta): boolean { return !!meta.sign; }
function sign(meta: Meta): void { meta.sign = true; }
class Holder { held: Meta; constructor(meta: Meta) { this.held = meta; } }
function compose(app: any): string {
  const meta: Meta = app.cookie;
  const before = isSigned(meta);
  const holder = new Holder(meta);
  const all: Meta[] = [meta];
  sign(holder.held);
  return before + " " + isSigned(all[0]!) + " " + (holder.held === app.cookie) + " " + JSON.stringify(app);
}
console.log(compose({ cookie: { path: "/" } }));
console.log(compose(JSON.parse('{"cookie":{"path":"/"}}')));
console.log(compose({ cookie: { sign: ["a"] } }));
//// annotated-variable-mismatch-store-runs.ts
// The store runs on an object that does not match the annotation: other references to the object see it, and its other properties stay.
interface Meta { secrets?: string; sign: string[] | true }
function compose(app: any): string {
  const meta: Meta = app.config.cookie;
  meta.sign = ["a", "b"];
  meta.secrets = "s";
  return JSON.stringify(meta) + " " + (meta === app.config.cookie);
}
const app = { config: { cookie: { path: "/", sign: 5 } } };
console.log(compose(app), JSON.stringify(app));
console.log(compose(JSON.parse('{"config":{"cookie":{"path":"/","secrets":7}}}')));
//// annotated-variable-mismatch-union-narrowed.ts
// The annotation is a union of records; the object has the discriminant of one member and is missing that member's other property, which reads undefined. A discriminant that no member lists is read as it is: a literal type promises the kind, string, and its list is a prediction.
type Shape = { kind: "circle"; radius: number; label?: string } | { kind: "square"; side: number; label?: string };
const own: Shape[] = [{ kind: "circle", radius: 1 }, { kind: "square", side: 2 }];
function describe(source: any): string {
  const shape: Shape = source.shape;
  if (shape.kind === "circle") { shape.label = "round"; return "circle " + typeof shape.radius + " " + JSON.stringify(source); }
  if (shape.kind === "square") { shape.label = "flat"; return "square " + typeof shape.side + " " + JSON.stringify(source); }
  return "neither " + JSON.stringify(source);
}
console.log(describe({ shape: { kind: "circle" } }));
console.log(describe(JSON.parse('{"shape":{"kind":"square"}}')));
try { console.log(describe(JSON.parse('{"shape":{"kind":"triangle"}}'))); } catch (e) { console.log("a kind that no member lists:", (e as Error).constructor.name); }
console.log(describe({ shape: own[0] }), describe({ shape: own[1] }));
//// annotated-variable-mismatch-union-narrowed-to-the-record.ts
// An object that comes through `any` into a variable annotated with a union of a record and something else, and does not fit the record, stays as it is where the union is narrowed to the record too.
// As plain Bun, line by line, for an object that lacks a member and for one that fits.
interface Nested { cwd: string }
interface Wanted { id: string; ctx: Nested }
interface Other { name: string; ctx: Nested }
const parse = (text: string): any => JSON.parse(text);
const kept: Wanted = { id: "k", ctx: { cwd: "/" } };
const other: Other = { name: "o", ctx: { cwd: "/" } };
function idOf(wanted: Wanted): string { return wanted.id; }
const cases: [string, (text: string) => unknown][] = [
  ["| undefined, truthy", text => { const d: Wanted | undefined = parse(text); if (d) return d.id; return 0; }],
  ["| undefined, !== undefined", text => { const d: Wanted | undefined = parse(text); if (d !== undefined) return d.id; return 0; }],
  ["| null, != null", text => { const d: Wanted | null = parse(text); if (d != null) return d.id; return 0; }],
  ["| undefined, ?.", text => { const d: Wanted | undefined = parse(text); return d?.id; }],
  ["| string, typeof !== string", text => { const d: Wanted | string = parse(text); if (typeof d !== "string") return d.id; return 0; }],
  ["| string, typeof === object", text => { const d: Wanted | string = parse(text); if (typeof d === "object") return d.id; return 0; }],
  ["| string, else", text => { const d: Wanted | string = parse(text); if (typeof d === "string") return 0; else return d.id; }],
  ["| string, ternary", text => { const d: Wanted | string = parse(text); return typeof d === "string" ? 0 : d.id; }],
  ["| string, early return", text => { const d: Wanted | string = parse(text); if (typeof d === "string") return 0; return d.id; }],
  ["| string, switch", text => { const d: Wanted | string = parse(text); switch (typeof d) { case "string": return 0; default: return d.id; } }],
  ["| string, &&", text => { const d: Wanted | string = parse(text); return typeof d !== "string" && d.id; }],
  ["| string, handed on", text => { const d: Wanted | string = parse(text); if (typeof d === "string") return 0; const e: Wanted = d; return e.id; }],
  ["| string, assigned on", text => { const d: Wanted | string = parse(text); let e: Wanted = kept; if (typeof d !== "string") e = d; return e.id; }],
  ["| string, passed", text => { const d: Wanted | string = parse(text); if (typeof d === "string") return 0; return idOf(d); }],
  ["| string, returned", text => { const give = (): Wanted | number => { const d: Wanted | string = parse(text); if (typeof d === "string") return 0; return d; }; const got = give(); return typeof got === "number" ? got : got.id; }],
  ["| string, in a literal", text => { const d: Wanted | string = parse(text); if (typeof d === "string") return 0; const o: { r: Wanted } = { r: d }; return o.r.id; }],
  ["| string, the same object", text => { const from = parse(text); const d: Wanted | string = from; if (typeof d === "string") return 0; const e: Wanted = d; const back: any = e; return text.length < 12 ? back === from : back.id === from.id; }],
  ["| string, in a closure", text => { const d: Wanted | string = parse(text); return (() => (typeof d === "string" ? 0 : d.id))(); }],
  ["| string, in a loop", text => { let said = ""; for (let i = 0; i < 3; i++) { const d: Wanted | string = i === 1 ? "s" : parse(text); said += typeof d === "string" ? d : d.id; } return said; }],
  ["| string, assigned later", text => { let d: Wanted | string = "s"; d = parse(text); if (typeof d === "string") return 0; return d.id; }],
  ["| string, the missing member", text => { const d: Wanted | string = parse(text); if (typeof d === "string") return 0; return typeof d.ctx; }],
  ["| string, a store", text => { const from = parse(text); const d: Wanted | string = from; if (typeof d === "string") return 0; d.id = "stored"; return d.id + " " + from.id; }],
  ["| string, it is the string", _ => { const d: Wanted | string = parse('"text"'); if (typeof d === "string") return d; return d.id; }],
  ["| number", text => { const d: Wanted | number = parse(text); if (typeof d !== "number") return d.id; return 0; }],
  ["| boolean", text => { const d: Wanted | boolean = parse(text); if (typeof d !== "boolean") return d.id; return 0; }],
  ["| string | number", text => { const d: Wanted | string | number = parse(text); if (typeof d === "object") return d.id; return 0; }],
  ["| string[]", text => { const d: Wanted | string[] = parse(text); if (!Array.isArray(d)) return d.id; return 0; }],
  ["| string[], it is the array", _ => { const d: Wanted | string[] = parse('["a"]'); if (Array.isArray(d)) return d.length; return d.id; }],
  ["| function", text => { const d: Wanted | (() => void) = parse(text); if (typeof d !== "function") return d.id; return 0; }],
  ["| Date", text => { const d: Wanted | Date = parse(text); if (!(d instanceof Date)) return d.id; return 0; }],
  ["| Map", text => { const d: Wanted | Map<string, string> = parse(text); if (d instanceof Map) return 0; return d.id; }],
  ["| Other, in", text => { const d: Wanted | Other = parse(text); if ("id" in d) return d.id; return 0; }],
  ["| Other, not in", text => { const d: Wanted | Other = parse(text); if (!("name" in d)) return d.id; return 0; }],
  ["| Other, it is one made here", _ => { const d: Wanted | Other = parse("0") || other; if ("name" in d) return d.name; return d.id; }],
  ["| string, it is one made here", _ => { const d: Wanted | string = parse("0") || kept; if (typeof d === "string") return 0; return d.id + d.ctx.cwd; }],
];
////= for-2	'{"id":"y"}'	'{"id":"z","ctx":{"cwd":"/"}}'
//// annotated-variable-mismatch-with-store.ts
// An object that comes through `any` into an annotated variable and is missing a required property stays as it is: the store below never runs.
function compose(app: any): string {
  const meta: { secrets?: string; sign: string[] | true } = app.config.cookie;
  if (meta?.sign) { meta.sign = true; return "signed"; }
  return "plain";
}
console.log(compose({ config: { cookie: { path: "/" } } }));
