//// arguments-via-bind-and-reflect-apply.ts
// An object that satisfies a parameter's type is passed through `bind` or `Reflect.apply` instead of a direct call: a native object typed `any`, or a host object under its own type. Each case has its own interface and a program class for it, so no case affects another. The output must match plain Bun.

// `bind` with an argument typed `any`
interface StoreLike { clear(): void; size: number; onChange: ((e: any) => void) | null }
class FakeStore implements StoreLike { size = 1; onChange: ((e: any) => void) | null = null; clear() {} }
function storeSize(store: StoreLike): string { return typeof store.size; }
function makeStore(): any { const map: any = new Map(); map.onChange = null; return map; }
const boundStoreSize = storeSize.bind(null, makeStore());
console.log(boundStoreSize(), storeSize(new FakeStore()));

// `Reflect.apply` with an argument typed `any`
interface CacheLike { clear(): void; size: number; onEvict: ((e: any) => void) | null }
class FakeCache implements CacheLike { size = 1; onEvict: ((e: any) => void) | null = null; clear() {} }
function cacheSize(cache: CacheLike): string { return typeof cache.size; }
function makeCache(): any { const map: any = new Map(); map.onEvict = null; return map; }
console.log(Reflect.apply(cacheSize, null, [makeCache()]), cacheSize(new FakeCache()));

// `bind` with a host object under its own type
interface LocationLike { href: string; host: string }
class FakeLocation implements LocationLike { fakeOnly = 0; href = "fake:"; host = "fake"; }
function showLocation(location: LocationLike) { return location.href + " " + location.host; }
const boundShowLocation = showLocation.bind(null, new URL("http://h/p"));
console.log(boundShowLocation(), showLocation(new FakeLocation()));

// `Reflect.apply` with a host object under its own type
interface ReplyLike { status: number; ok: boolean }
class FakeReply implements ReplyLike { fakeOnly = 0; status = 1; ok = false; }
function showReply(reply: ReplyLike) { return reply.status + " " + reply.ok; }
console.log(Reflect.apply(showReply, null, [new Response("", { status: 201 })]), showReply(new FakeReply()));

// the second bound argument, on a method
interface ChunkLike { size: number; type: string }
class FakeChunk implements ChunkLike { fakeOnly = 0; size = -1; type = "fake"; }
class Uploader { prefix = "up"; send(label: string, chunk: ChunkLike) { return this.prefix + " " + label + " " + chunk.size + " " + typeof chunk.type; } }
const uploader = new Uploader();
function untypedChunk(): any { return new Blob(["abc"]); }
const sendChunk = uploader.send.bind(uploader, "a", untypedChunk());
console.log(sendChunk(), uploader.send("b", new FakeChunk()));
//// assertion-in-inlined-try.ts
// `s + 1` where `s` is declared a string and holds null or undefined is a number, as in plain Bun, also inside an inlined `try` block.
const hide = (v: unknown): any => v;
function attempt(label: string, f: () => unknown) {
  try { console.log(label + ": no error", String(f())) } catch (e) { console.log(label + ":", e instanceof TypeError ? "TypeError" : "other " + e) }
}
attempt("null as string, + 1", () => { const s: string = hide(null); return s + 1 })
attempt("undefined as string, + 1", () => { const s: string = hide(undefined); return s + 1 })
console.log("after");
export {};
//// assigned-to-union-uncast.ts
// A value of a type that comes from JSON is assigned to a union of object types without a cast: as an argument, a result, a store and an element.
declare const console: { log(...values: unknown[]): void };
type Named = { name: string };
type Shape = { name: string; size?: number } | { side: number };
function text(s: Shape): string {
  if ('side' in s) {
    return 'side ' + s.side;
  }
  return 'name ' + s.name + ' ' + s.size + ' ' + Object.keys(s).join();
}
function same(s: Shape, o: unknown): boolean {
  return s === o;
}
function pass(n: Named): Shape {
  return n;
}
const parsed = JSON.parse('{"name":"n","more":1}') as Named;
console.log(text(parsed), same(parsed, parsed));
console.log(text(pass(parsed)), pass(parsed) === parsed);
const list: Shape[] = [{ side: 2 }];
list.push(parsed);
console.log(list.map(text).join('; '), list[1] === parsed);
const holder: { shape: Shape } = { shape: { side: 3 } };
holder.shape = parsed;
console.log(text(holder.shape), holder.shape === parsed);
console.log(text({ name: 'own', size: 4 }), text({ side: 5 }));
//// async-returns-mistyped-package-value/main.ts
// The package's declaration file is wrong about what these functions return. An async function with an inferred return type passes the value through `await` unchanged.
import { bytes, count, soon } from "./package.js";

async function declared(name: string) {
  await null;
  return bytes(name);
}
const arrow = async (name: string) => bytes(name);
async function withStatements(name: string) {
  if (name === "a") return count(name);
  return count(name + name);
}
async function ofPromise(name: string) {
  return soon(name);
}
async function throughAnother(name: string) {
  return await declared(name);
}

console.log("a declaration", String(await declared("a")));
console.log("an arrow", String(await arrow("a")));
console.log("with statements", String(await withStatements("a")), String(await withStatements("b")));
console.log("of a promise", String(await ofPromise("a")));
console.log("through another", String(await throughAnother("a")));
const kept = declared("b");
const value = await kept;
console.log("kept", typeof value, String(value));
const right = await declared("right:a");
console.log("where the declaration is right", right.length, right instanceof Uint8Array);
//// async-returns-mistyped-package-value/package.d.ts
export function bytes(name: string): Uint8Array;
export function count(name: string): number;
export function soon(name: string): Promise<number>;
//// async-returns-mistyped-package-value/package.js
export function bytes(name) {
  return name.startsWith("right:") ? new Uint8Array(name.length) : "text of " + name;
}
export function count(name) {
  return "count of " + name;
}
export function soon(name) {
  return Promise.resolve(["list of " + name]);
}
//// builtin-members-as-interfaces.ts
// The same as host-members-as-interfaces.ts, with built-in classes only: a typed array, a map, a set, a regular expression, a promise. A built-in object is used through one of the program's interfaces, and each member is used through the interface's own member type. Each case has its own interfaces, and for each a program class with one extra member, so no built-in object matches those classes. The output must match plain Bun.

// a property of a typed array
interface RawBufferLike { byteLength: number }
interface ByteViewLike { length: number; buffer: RawBufferLike }
class FakeRawBuffer implements RawBufferLike { fakeOnly = 0; byteLength = -1; }
class FakeByteView implements ByteViewLike { fakeOnly = 0; length = -1; buffer: RawBufferLike = new FakeRawBuffer(); }
function showView(view: ByteViewLike) { return view.length + " " + view.buffer.byteLength; }
const view: ByteViewLike = new Uint8Array(4);
console.log(showView(view), showView(new FakeByteView()));

// a method's return value
interface WindowLike { length: number; byteOffset: number }
interface WindowSourceLike { length: number; subarray(begin?: number, end?: number): WindowLike }
class FakeWindow implements WindowLike { fakeOnly = 0; length = -1; byteOffset = -2; }
class FakeWindowSource implements WindowSourceLike { fakeOnly = 0; length = -1; subarray(): WindowLike { return new FakeWindow(); } }
function showWindow(source: WindowSourceLike) { const part = source.subarray(1, 3); return part.length + " " + part.byteOffset; }
console.log(showWindow(new Uint8Array(4)), showWindow(new FakeWindowSource()));

// what a map's `get` returns
interface StampLike { getTime(): number }
interface LookupLike { get(key: string): StampLike | undefined }
class FakeStamp implements StampLike { fakeOnly = 0; getTime() { return -1; } }
class FakeLookup implements LookupLike { fakeOnly = 0; get(key: string): StampLike | undefined { return key === "a" ? new FakeStamp() : undefined; } }
function showLookup(lookup: LookupLike) { return lookup.get("a")?.getTime() + " " + lookup.get("b")?.getTime(); }
const stamps = new Map<string, Date>([["a", new Date(5)]]);
console.log(showLookup(stamps), showLookup(new FakeLookup()));

// what `exec` returns
interface FoundLike { index: number; input: string }
interface MatcherLike { exec(text: string): FoundLike | null }
class FakeFound implements FoundLike { fakeOnly = 0; index = -1; input = "fake"; }
class FakeMatcher implements MatcherLike { fakeOnly = 0; exec(text: string): FoundLike | null { return text ? new FakeFound() : null; } }
function showMatch(matcher: MatcherLike) { const found = matcher.exec("xab"); return found ? found.index + " " + found.input : "none"; }
console.log(showMatch(/ab/), showMatch(new FakeMatcher()));

// a callback's parameter
interface MomentLike { getTime(): number }
interface VisitableLike { forEach(visit: (item: MomentLike) => void): void }
class FakeMoment implements MomentLike { fakeOnly = 0; getTime() { return -1; } }
class FakeVisitable implements VisitableLike { fakeOnly = 0; forEach(visit: (item: MomentLike) => void) { visit(new FakeMoment()); } }
function showVisits(visitable: VisitableLike) { let total = 0; visitable.forEach(item => { total += item.getTime(); }); return total; }
console.log(showVisits(new Set([new Date(2), new Date(3)])), showVisits(new FakeVisitable()));

// a promise's value
interface InstantLike { getTime(): number }
interface ClockLike { now(): Promise<InstantLike> }
class FakeInstant implements InstantLike { fakeOnly = 0; getTime() { return -1; } }
class FakeClock implements ClockLike { fakeOnly = 0; async now(): Promise<InstantLike> { return new FakeInstant(); } }
async function showClock(clock: ClockLike) { return (await clock.now()).getTime(); }
const clocks = new Map<string, () => Promise<Date>>([["now", async () => new Date(7)]]);
const realClock: ClockLike = { now: clocks.get("now")! };
console.log(await showClock(realClock), await showClock(new FakeClock()));
//// builtin-objects-as-defaults.ts
// A built-in object is the default value of a parameter, a pattern element or a parameter property whose type is one of the program's interfaces, and a member of it is used through the interface's own member type. Each case has its own interfaces, and for each a program class with one extra member, so no built-in object matches those classes. The output must match plain Bun.

// a parameter's default value
interface StorageLike { byteLength: number }
interface PixelsLike { length: number; buffer: StorageLike }
class FakeStorage implements StorageLike { fakeOnly = 0; byteLength = -1; }
class FakePixels implements PixelsLike { fakeOnly = 0; length = -1; buffer: StorageLike = new FakeStorage(); }
function makePixels(): Uint8Array { return new Uint8Array(4); }
function showPixels(pixels: PixelsLike = makePixels()) { return pixels.length + ":" + pixels.buffer.byteLength; }
console.log(showPixels(), showPixels(new FakePixels()));

// a default in an object pattern
interface MemoryLike { byteLength: number }
interface SamplesLike { length: number; buffer: MemoryLike }
class FakeMemory implements MemoryLike { fakeOnly = 0; byteLength = -1; }
class FakeSamples implements SamplesLike { fakeOnly = 0; length = -1; buffer: MemoryLike = new FakeMemory(); }
function makeSamples(): Float64Array { return new Float64Array(2); }
function showSamples({ samples = makeSamples() }: { samples?: SamplesLike }) { return samples.length + ":" + samples.buffer.byteLength; }
console.log(showSamples({}), showSamples({ samples: new FakeSamples() }));

// a default in an array pattern
interface BackingLike { byteLength: number }
interface WordsLike { length: number; buffer: BackingLike }
class FakeBacking implements BackingLike { fakeOnly = 0; byteLength = -1; }
class FakeWords implements WordsLike { fakeOnly = 0; length = -1; buffer: BackingLike = new FakeBacking(); }
function makeWords(): Uint16Array { return new Uint16Array(3); }
function showWords([words = makeWords()]: WordsLike[]) { return words.length + ":" + words.buffer.byteLength; }
console.log(showWords([]), showWords([new FakeWords()]));

// a parameter property's default value
interface RegionLike { byteLength: number }
interface CellsLike { length: number; buffer: RegionLike }
class FakeRegion implements RegionLike { fakeOnly = 0; byteLength = -1; }
class FakeCells implements CellsLike { fakeOnly = 0; length = -1; buffer: RegionLike = new FakeRegion(); }
function makeCells(): Int32Array { return new Int32Array(5); }
class Grid { constructor(public cells: CellsLike = makeCells()) {} show() { return this.cells.length + ":" + this.cells.buffer.byteLength; } }
console.log(new Grid().show(), new Grid(new FakeCells()).show());

// a default value whose method returns a built-in object
interface SpanLike { length: number; byteOffset: number }
interface TapeLike { length: number; subarray(begin?: number, end?: number): SpanLike }
class FakeSpan implements SpanLike { fakeOnly = 0; length = -1; byteOffset = -2; }
class FakeTape implements TapeLike { fakeOnly = 0; length = -1; subarray(): SpanLike { return new FakeSpan(); } }
function makeTape(): Uint8Array { return new Uint8Array(6); }
function showTape(tape: TapeLike = makeTape()) { const span = tape.subarray(2, 5); return span.length + ":" + span.byteOffset; }
console.log(showTape(), showTape(new FakeTape()));
//// callback-returns-mistyped-package-value/main.ts
// The package's declaration file is wrong about what these functions return. A callback's return type that TypeScript infers from such a call is not enforced.
import { bytes, count, row } from "./package.js";

function each<T, U>(list: T[], f: (item: T) => U): U[] {
  const out: U[] = [];
  for (const item of list) out.push(f(item));
  return out;
}
function say(what: string, find: () => unknown) {
  try {
    console.log(what + ":", find());
  } catch (error) {
    console.log(what + ": THROWS", String(error));
  }
}

const names = ["a", "b"];
say("map", () => names.map(name => bytes(name)).join(" "));
say("map, with statements", () =>
  names
    .map(name => {
      if (name === "a") return bytes(name);
      return bytes(name + name);
    })
    .join(" "),
);
say("map to a number", () => names.map(name => count(name)).join(" "));
say("map to an object", () => JSON.stringify(names.map(name => row(name))));
say("flatMap", () => JSON.stringify(names.flatMap(name => row(name))));
say("Array.from", () => Array.from(names, name => bytes(name)).join(" "));
say("sort", () => ["b", "a", "c"].sort((x, y) => count(x + y)).join(" "));
say("find", () => names.find(name => count(name)));
say("a generic function of the program", () => each(names, name => bytes(name)).join(" "));
say("kept", () => {
  const kept = names.map(name => bytes(name));
  const seen: string[] = [];
  for (const one of kept) seen.push(typeof one + String(one).length);
  return seen.join();
});
say("where the declaration is right", () =>
  names
    .map(name => bytes("right:" + name))
    .map(one => one.length + ":" + (one instanceof Uint8Array))
    .join(" "),
);
console.log("then:", String(await Promise.resolve("a").then(name => bytes(name))));
console.log("then, twice:", await Promise.resolve("a").then(name => bytes(name)).then(one => typeof one));
//// callback-returns-mistyped-package-value/package.d.ts
export function bytes(name: string): Uint8Array;
export function count(name: string): number;
export function row(name: string): { id: number; name: string };
//// callback-returns-mistyped-package-value/package.js
export function bytes(name) {
  return name.startsWith("right:") ? new Uint8Array(name.length) : "text of " + name;
}
export function count(name) {
  return name === "ba" || name === "ca" || name === "cb" ? "1" : "-1";
}
export function row(name) {
  return name === "a" ? null : [name];
}
//// casts-propagate.ts
// Parsed JSON goes through several casts and stays the same object.
interface Base { id: string }
interface Derived extends Base { extra: number; inner: { n: number } }
const parsed = JSON.parse('{"id":"a"}') as Base
const made = { id: "m", extra: 1, inner: { n: 2 } } as Base
function asDerived(b: Base): Derived { return b as Derived }
const d = asDerived(made)
console.log("a downcast from a tainted type |", d.extra, d.inner.n, d === made, asDerived(parsed).extra)
interface Other { id: string; tag?: string; more: { m: number } }
const o = made as unknown as Other
const keptO: Other = o
console.log("through unknown |", keptO.tag, keptO.more, keptO.id)
interface Listed { rows: { k: string }[]; count: number }
const loose: any = JSON.parse('{"rows":[{"k":"x"}]}')
const listed: Listed = loose
function countOf(l: Listed): string { return l.rows.map(r => r.k).join() + l.count }
console.log("a name that holds what was parsed, in an annotated variable |", countOf(listed), listed === loose)
interface Own { ownNumber: number; ownText: string }
const own: Own = { ownNumber: 1, ownText: "t" }
const again = (own as any) as Own
console.log("the program's own through any |", again.ownNumber, again === own)
//// child-narrowed-by-parent.ts
// A type guard on a parent node narrows the type of its child.
const enum Kind { Plus, OrEquals, AndEquals, Binary }
type BinaryOperator = Kind.Plus | Kind.OrEquals | Kind.AndEquals
type LogicalAssignmentOperator = Kind.OrEquals | Kind.AndEquals
interface Node { readonly kind: Kind }
interface Token<K extends Kind> extends Node { readonly kind: K }
interface BinaryExpression extends Node { readonly kind: Kind.Binary; readonly operatorToken: Token<BinaryOperator> }
interface AssignmentExpression<T extends Token<BinaryOperator>> extends BinaryExpression { readonly operatorToken: T }
function isLogicalAssignment(node: Node): node is AssignmentExpression<Token<LogicalAssignmentOperator>> { return node.kind === Kind.Binary && (node as BinaryExpression).operatorToken.kind !== Kind.Plus }
function transform(expression: AssignmentExpression<Token<LogicalAssignmentOperator>>) { const operator = expression.operatorToken; return operator.kind }
function createToken(kind: BinaryOperator): Token<BinaryOperator> { return { kind } }
function createBinary(operatorToken: Token<BinaryOperator>): BinaryExpression { return { kind: Kind.Binary, operatorToken } }
function attempt(label: string, f: () => unknown) { try { console.log(label + ":", String(f())) } catch (e) { console.log(label + ":", (e as Error).constructor.name, (e as Error).message.split("\n").join(" /")) } }
for (const kind of [Kind.OrEquals, Kind.Plus, Kind.AndEquals] as BinaryOperator[]) attempt("kind " + kind, () => { const node: Node = createBinary(createToken(kind)); return isLogicalAssignment(node) ? transform(node) : "no" })
export {};
//// clone-as-fallback.ts
type Point = { a: number; b: string };

const show = (object: object) => {
  const keys = Object.keys(object);
  return keys.length + " keys: " + keys.slice(0, 4).join(",") + " ... " + keys.slice(-2).join(",");
};

function parseAndCopy(text: string) {
  const parsed = JSON.parse(text) as Point;
  const copy: Point = { ...parsed, b: "replaced" };
  return [parsed.a, parsed.b, copy.a, copy.b, show(parsed), show(copy), copy === parsed].join(" | ");
}

const manyKeys: Record<string, number> = { a: 1 };
for (let i = 0; i < 5000; i++) manyKeys["key" + i] = i;
const texts = [
  '{"a":1,"b":"plain"}',
  '{"b":"reversed","a":2}',
  '{"0":"zero","a":3,"b":"index key"}',
  '{"a":4,"7":"seven","b":"index key between"}',
  JSON.stringify({ ...manyKeys, b: "5,000 keys" }),
];

for (let round = 0; round < 3; round++) {
  for (const text of texts) console.log(parseAndCopy(text));
}
//// compared-types-propagate-parsed-data.ts
// What is parsed is held to one type. Values of that type are handed on where other types are expected, by arguments, returns, elements and spreads, and only the checker's comparison of the two types says so.
interface Wire { id: number; name: string; extra?: { note: string } }
interface Row { id: number; name: string }
interface Labeled { name: string }
interface Boxed<T> { value: T; history: T[] }
class Table {
  rows: Row[] = [];
  keep(row: Row): Row { this.rows.push(row); return row; }
}
function parse(text: string): Wire { return JSON.parse(text) as Wire; }
function box<T>(value: T): Boxed<T> { return { value, history: [value] }; }
function label(it: Labeled): string { return it.name + ":" + Object.keys(it).join("+"); }
function firstOf(boxed: Boxed<Row>): Labeled { return boxed.history[0]; }
const table = new Table();
const parsed = parse('{"id":1,"name":"a","extra":{"note":"n"},"more":true}');
const kept = table.keep(parsed);
table.keep({ id: 2, name: "b" });
const boxed: Boxed<Row> = box(kept);
boxed.history.push({ id: 3, name: "c" }, ...table.rows);
const labeled: Labeled[] = [firstOf(boxed), ...boxed.history, { name: "made" }];
const byName: Record<string, Labeled> = {};
for (const it of labeled) byName[it.name] = it;
kept.name = "renamed";
console.log(labeled.map(label).join(" "), Object.keys(byName).join(), byName.a === parsed, (byName.a as Wire).extra?.note);
console.log(JSON.stringify(table.rows), JSON.stringify(boxed.value), boxed.history.length, parsed.name);
//// conversions-in-place-while-the-collector-marks.ts
// Parsed objects that the collector can already reach are read through record types while it marks. The integers and the small
// numbers in them are chosen so that the bytes of an object with a fixed layout, read as the properties of a plain object, are
// pointers to nowhere, and so that the plain object's bytes, read as the references of a fixed layout, are too: a marker that reads
// one of these objects by the wrong layout crashes at once. Everything the objects held is still there afterwards.
type Row = { a: number; b: number; c: number; d: number; tiny: number; flag: boolean; name: string; tags: string[] };
type Wide = { a: number; b: number; c: number; d: number; e: number; f: number; g: number; h: number; name: string; last: string };
type Child = { a: number; b: number; label: string };
type Parent = { a: number; b: number; left: Child; right: Child; title: string };

const integer = 0x1238;
const tiny = new Float64Array(new BigUint64Array([0x123800001238n]).buffer)[0];

function typedRow(): Row {
  return { a: 1, b: 2, c: 3, d: 4, tiny: 0.5, flag: true, name: "typed", tags: ["t"] };
}
function typedWide(): Wide {
  return { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, name: "typed", last: "typed" };
}
function typedParent(): Parent {
  return { a: 1, b: 2, left: { a: 1, b: 2, label: "l" }, right: { a: 1, b: 2, label: "r" }, title: "typed" };
}
function checkRow(row: Row, i: number): number {
  return row.a === integer && row.b === integer && row.c === integer && row.d === integer + i && row.tiny === tiny && row.flag === (i % 2 === 0) && row.name === "name " + i && row.tags.length === 2 && row.tags[1] === "tag " + i ? 1 : 0;
}
function checkFraction(row: Row, i: number): number {
  return row.a === integer + 0.5 && row.b === integer && row.c === integer && row.d === integer + i && row.tiny === tiny && row.name === "name " + i && row.tags[1] === "tag " + i ? 1 : 0;
}
function checkWide(wide: Wide, i: number): number {
  return wide.a === integer && wide.b === integer && wide.c === integer && wide.d === integer && wide.e === integer && wide.f === integer && wide.g === integer && wide.h === integer + i && wide.name === "name " + i && wide.last === "last " + i ? 1 : 0;
}
function checkParent(parent: Parent, i: number): number {
  return parent.a === integer && parent.b === integer + i && parent.left.a === integer && parent.left.b === integer && parent.left.label === "left " + i && parent.right.a === integer && parent.right.b === integer && parent.right.label === "right " + i && parent.title === "title " + i ? 1 : 0;
}

const kinds = 5;
function parse(i: number): any {
  const n = String(integer);
  switch (i % kinds) {
    case 0:
      return JSON.parse(`{"a":${n},"b":${n},"c":${n},"d":${integer + i},"tiny":${tiny},"flag":${i % 2 === 0},"name":"name ${i}","tags":["x","tag ${i}"]}`);
    case 1:
      return JSON.parse(`{"a":${n},"b":${n},"c":${n},"d":${integer + i},"tiny":${tiny},"flag":${i % 2 === 0},"name":"name ${i}","tags":["x","tag ${i}"],"more":"more ${i}"}`);
    case 2:
      return JSON.parse(`{"a":${n}.5,"b":${n},"c":${n},"d":${integer + i},"tiny":${tiny},"flag":true,"name":"name ${i}","tags":["x","tag ${i}"]}`);
    case 3:
      return JSON.parse(`{"a":${n},"b":${n},"c":${n},"d":${n},"e":${n},"f":${n},"g":${n},"h":${integer + i},"name":"name ${i}","last":"last ${i}"}`);
    default:
      return JSON.parse(`{"a":${n},"b":${integer + i},"left":{"a":${n},"b":${n},"label":"left ${i}"},"right":{"a":${n},"b":${n},"label":"right ${i}"},"title":"title ${i}"}`);
  }
}
function check(made: any, i: number): number {
  switch (i % kinds) {
    case 0:
      return checkRow(made, i);
    case 1:
      return checkRow(made, i) && made.more === "more " + i ? 1 : 0;
    case 2:
      return checkFraction(made, i);
    case 3:
      return checkWide(made, i);
    default:
      return checkParent(made, i);
  }
}
const keys = ["a,b,c,d,tiny,flag,name,tags", "a,b,c,d,tiny,flag,name,tags,more", "a,b,c,d,tiny,flag,name,tags", "a,b,c,d,e,f,g,h,name,last", "a,b,left,right,title"];

const live: any[] = [];
for (let i = 0; i < 60000; i++) live.push({ i, text: "live " + i, next: i ? live[i - 1] : null });

const size = 4096;
const total = 300000;
const waiting: any[] = new Array(size).fill(null);
const converted: any[] = new Array(size).fill(null);
let good = checkRow({ ...typedRow(), a: integer, b: integer, c: integer, d: integer, tiny, name: "name 0", tags: ["x", "tag 0"] }, 0) + typedWide().a + typedParent().a;
for (let i = 0; i < total + 2 * size; i++) {
  const slot = i % size;
  const old = converted[slot];
  if (old !== null) {
    good += check(old, i - 2 * size);
    if (Object.keys(old).join() !== keys[(i - 2 * size) % kinds]) good = -1000000000;
  }
  const next = waiting[slot];
  converted[slot] = next;
  if (next !== null) good += check(next, i - size);
  waiting[slot] = i < total ? parse(i) : null;
}
console.log(good, live.length);
//// elements-typed-by-dts/host.d.ts
// What a package's declaration file says of the host's headers, for main.ts.
export interface Headers { [name: string]: string | string[] | undefined; "content-type"?: string }
export interface Counts { [name: string]: number }
//// elements-typed-by-dts/main.ts
// An element read from a variable that is annotated with a type from a declaration file: the object belongs to the embedder, and so do its contents, whatever the index signature says. A cast that the program writes behind such a read is tested like any cast.
import type { Counts, Headers } from "./host";
const given: any = { ":status": 200, "x-list": ["a"], "content-type": 5, "x-s": "s" };
const row = (name: string, f: () => unknown) => { let r: unknown; try { r = f(); } catch (e) { r = "THROWS " + (e as Error).message.split(" (bun")[0]; } console.log(name + ": " + JSON.stringify(r)); };
const kind = (v: unknown) => typeof v + " " + JSON.stringify(v);
let held: Headers = {};
function keep(headers: Headers) { held = headers; }
keep(given);
const key = [":status"][0];
row("a written key", () => [kind(held[":status"]), kind(held["x-list"]), kind(held["x-s"]), kind(held["none"])]);
row("a computed key", () => kind(held[key]));
row("behind casts", () => [kind(held[":status"] as unknown as number), kind(held[key] as string)]);
row("a declared name", () => [kind(held["content-type"]), kind(held["content-type"] as unknown as number)]);
row("a parameter", () => ((headers: Headers) => kind(headers[":status"]))(given));
row("one that the program made", () => { const own: Headers = { a: "b" }; own.c = "d"; return [kind(own["a"]), kind(own.c), own["a"]!.length, Object.keys(own)]; });
row("numbers", () => { const counts: Counts = given; return [kind(counts["x-s"]), kind(counts[":status"]), (counts[":status"] as number) + 1]; });
interface Mine { [name: string]: number }
row("an index signature of the program's own stays a fact", () => { const mine: Mine = { a: 1 }; mine.b = 2; return [mine["a"] + mine["b"], kind(mine["none"])]; });
//// extra-properties-many-objects-one-structure.ts
// Many objects of one shape come out of JSON.parse with properties that their type does not declare: ahead of the declared ones, among
// them and behind them. Each stays one object: the extra properties are read, written, removed and listed as in any object, and
// the keys keep their order.
interface Inner { r: number }
interface Row { id: number; name: string; inner: Inner; done: boolean }
const made: Row = { id: 0, name: "made", inner: { r: 0 }, done: true };
function use(row: Row): string {
  row.id += 1;
  row.inner.r += 1;
  return row.id + row.name + row.inner.r + row.done;
}
const shapes = [
  (i: number) => '{"first":' + i + ',"id":' + i + ',"name":"a","inner":{"r":1},"done":false}',
  (i: number) => '{"id":' + i + ',"middle":"m' + i + '","name":"b","inner":{"r":2},"done":true}',
  (i: number) => '{"id":' + i + ',"name":"c","inner":{"r":3},"done":false,"last":[' + i + ']}',
  (i: number) => '{"x":null,"id":' + i + ',"y":{"z":' + i + '},"name":"d","inner":{"r":4,"more":' + i + '},"done":true,"w":"w"}',
];
console.log(use(made));
const kept: any[] = [];
for (let i = 0; i < 4; i++) {
  for (const shape of shapes) {
    const raw: any = JSON.parse(shape(i));
    kept.push(raw);
    console.log(use(raw), Object.keys(raw).join(), JSON.stringify(raw));
  }
}
for (const raw of kept) {
  const row: Row = raw;
  raw.added = row.id;
  delete raw.middle;
  delete raw.x;
  if ("last" in raw) raw.last.push(row.name);
  if ("first" in raw) raw.first *= 2;
  console.log(row === raw, use(row), Object.keys(raw).join(), JSON.stringify(raw), Object.entries(raw).length);
}
//// fetch-reducer-schemas-over-parsed-data.ts
// Programs that live on parsed data: a fetch wrapper, a reducer over parsed actions, settings with fallbacks, models built from JSON, a small schema library, groupBy and type guards. Every value matches its declared type. The program must behave as in plain Bun.
interface Item { id: number; title: string; done: boolean; due?: string; labels: string[] }
type Action = { type: 'add'; item: Item } | { type: 'remove'; id: number } | { type: 'toggle'; id: number } | { type: 'rename'; id: number; title: string }
interface State { items: Item[]; count: number; last?: Action['type'] }
interface Settings { theme: 'dark' | 'light'; size: number; recent: string[]; nested: { depth: number; on: boolean } }

class FakeResponse { constructor(private body: string, public status: number) {} json(): Promise<any> { return Promise.resolve(JSON.parse(this.body)) } get ok(): boolean { return this.status < 400 } }
const pages: Record<string, string> = {
  '/items': '[{"id":1,"title":"one","done":false,"labels":["x"]},{"id":2,"title":"two","done":true,"due":"2026-01-02","labels":[]}]',
  '/item/1': '{"id":1,"title":"one","done":false,"labels":["x"]}',
  '/settings': '{"theme":"dark","size":12,"recent":["a","b"],"nested":{"depth":2,"on":true}}',
}
function fakeFetch(url: string): Promise<FakeResponse> { return Promise.resolve(new FakeResponse(pages[url] ?? 'null', url in pages ? 200 : 404)) }
async function getJson<T>(url: string): Promise<T> { const response = await fakeFetch(url); return response.json() as Promise<T> }
function getJsonThen<T>(url: string): Promise<T> { return fakeFetch(url).then(response => response.json()) }
async function getOrNull<T>(url: string): Promise<T | null> { const response = await fakeFetch(url); if (!response.ok) return null; return await response.json() }

function reduce(state: State, action: Action): State {
  switch (action.type) {
    case 'add': return { items: [...state.items, action.item], count: state.count + 1, last: action.type }
    case 'remove': return { items: state.items.filter(item => item.id !== action.id), count: state.count - 1, last: action.type }
    case 'toggle': return { ...state, items: state.items.map(item => item.id === action.id ? { ...item, done: !item.done } : item), last: action.type }
    case 'rename': return { ...state, items: state.items.map(item => item.id === action.id ? { ...item, title: action.title } : item), last: 'rename' }
  }
}
function show(item: Item): string { return `${item.id}/${item.title}/${item.done}/${item.due ?? '-'}/${item.labels.length}` }

const store = new Map<string, string>([['settings', pages['/settings']!], ['count', '3']])
function load<T>(key: string, fallback: T): T { const raw = store.get(key); return raw ? JSON.parse(raw) : fallback }
const defaults: Settings = { theme: 'light', size: 10, recent: [], nested: { depth: 0, on: false } }

class Model {
  id = 0; title = ''; labels: string[] = []
  static fromJSON(json: any): Model { return Object.assign(new Model(), json) }
  get label(): string { return this.id + ':' + this.title + ':' + this.labels.join() }
}
class Wrapper { constructor(public item: Item, private seen = 0) {} touch(): number { return ++this.seen } get title(): string { return this.item.title.toUpperCase() } }

type Schema<T> = { parse(value: unknown): T }
const text = (): Schema<string> => ({ parse(value) { if (typeof value !== 'string') throw new Error('not a string'); return value } })
const count = (): Schema<number> => ({ parse(value) { if (typeof value !== 'number') throw new Error('not a number'); return value } })
function shape<S extends Record<string, Schema<unknown>>>(fields: S): Schema<{ [K in keyof S]: S[K] extends Schema<infer T> ? T : never }> {
  return { parse(value) { const given = value as Record<string, unknown>; for (const key in fields) fields[key]!.parse(given[key]); return value as any } }
}
function list<T>(of: Schema<T>): Schema<T[]> { return { parse(value) { if (!Array.isArray(value)) throw new Error('not a list'); value.forEach(one => of.parse(one)); return value } } }
const point = shape({ name: text(), x: count(), y: count() })
function norm(p: { x: number; y: number }): number { return Math.abs(p.x) + Math.abs(p.y) }
function groupBy<T, K extends string>(items: T[], key: (item: T) => K): Record<K, T[]> { const out = {} as Record<K, T[]>; for (const item of items) (out[key(item)] ??= []).push(item); return out }
function hasTitle(value: unknown): value is { title: string } { return typeof value === 'object' && value !== null && 'title' in value && typeof (value as any).title === 'string' }

async function main(): Promise<void> {
  const items = await getJson<Item[]>('/items')
  console.log(items.map(show).join(' '))
  const one = await getJsonThen<Item>('/item/1')
  const none = await getOrNull<Item>('/missing')
  const two = await getOrNull<Item>('/item/1')
  console.log(show(one), none, two && show(two), one === two)
  let state: State = { items, count: items.length }
  const lines = ['{"type":"add","item":{"id":3,"title":"three","done":false,"labels":["y","z"]}}', '{"type":"toggle","id":1}', '{"type":"rename","id":2,"title":"TWO"}', '{"type":"remove","id":3}', '{"type":"add","item":{"id":4,"title":"four","done":true,"labels":[]}}']
  for (const line of lines) { const action: Action = JSON.parse(line); state = reduce(state, action); console.log(state.last, state.count, state.items.map(show).join(' ')) }
  const settings = load('settings', defaults)
  const missing = load('nothing', defaults)
  const merged: Settings = { ...defaults, ...JSON.parse('{"size": 14, "nested": {"depth": 5, "on": true}}') }
  console.log(settings.theme, settings.size, settings.recent.join(), settings.nested.depth, missing === defaults, merged.theme, merged.size, merged.nested.depth, load('count', 0) + 1)
  const model = Model.fromJSON(JSON.parse(pages['/item/1']!))
  console.log(model.label, model instanceof Model, Object.keys(model).join())
  const wrapper = new Wrapper(one)
  console.log(wrapper.title, wrapper.touch(), wrapper.touch(), wrapper.item === one)
  const points = list(point).parse(JSON.parse('[{"name":"a","x":1,"y":-2},{"name":"b","x":3,"y":4}]'))
  console.log(points.map(p => p.name + norm(p)).join(), norm(point.parse(JSON.parse('{"name":"c","x":5,"y":5}'))))
  try { point.parse(JSON.parse('{"name":"d","x":"5","y":5}')) } catch (e) { const error = e as { message: string; code?: string }; console.log(error.message, error.code) }
  const groups = groupBy(state.items, item => item.done ? 'done' : 'open')
  console.log(Object.keys(groups).sort().map(key => key + ':' + groups[key as 'done' | 'open'].map(item => item.id).join('+')).join(' '))
  const byId = new Map<string, Item>(Object.entries(JSON.parse('{"a": {"id":7,"title":"seven","done":false,"labels":[]}}')))
  const [first, total]: [Item, number] = JSON.parse('[{"id":8,"title":"eight","done":true,"labels":["q"]}, 2]')
  console.log(show(byId.get('a')!), show(first), total)
  const unknowns: unknown[] = JSON.parse('[1, {"title": "t"}, null, {"other": 2}, "s"]')
  console.log(unknowns.filter(hasTitle).map(value => value.title).join(), unknowns.length)
  const patch: Partial<Item> = JSON.parse('{"title": "patched", "done": true}')
  Object.assign(one, patch)
  console.log(show(one), show({ ...first, ...patch }))
}
await main()
//// forced-casts.ts
// A double cast (`x as unknown as T`, `<T><any>x`) of an object to an object type passes: any object fits, it stays the same object, and a member it does not have reads undefined.
interface Tool { name: string; run(): string; level: number }
interface Part { level: number; o: number[] }
const part: Part = { level: 3, o: [1] }
const tool: Tool = part as unknown as Tool
console.log("record:", tool.level, tool.name, typeof tool.run, (tool as unknown) === part)
const again: Tool = <Tool><any>part
console.log("angle brackets:", again.level, (again as unknown) === part)
const given: Tool = Object.assign(part, { extra: 1 }) as unknown as Tool
console.log("what hands back its argument:", given.level, (given as unknown) === part)
class Service { n = 1; get() { return this.n } }
const fake = { n: 2, get() { return 5 }, o: [1] }
const held: Service = fake as unknown as Service
console.log("a class:", held.get(), held.n, held instanceof Service)
function build<D extends { level: number }>(def: D): D & Tool { const made = { level: def.level + 1, o: [2] }; return made as unknown as D & Tool }
const built = build({ level: 1, more: "m" })
console.log("out of generic code:", built.level, built.name, built.more)
const list: Tool[] = [tool, again]
console.log("in an array:", list.map(t => t.level).join())
interface A { kind: 1; a: number; o: number[] } interface B { kind: 2; a: number; b?: number }
const a: A = { kind: 1, a: 7, o: [1] }
const b: B = a as unknown as B
console.log("another discriminant, fields in common:", b.a, b.b, (b as unknown) === a)
function fill<T extends object>(): T { const d: Record<string, unknown> = { only: 1 }; return d as T }
interface First { only: number; o?: number[] }
const first: First = fill<First>()
function viaOverload<T extends object>(kind: "a"): T
function viaOverload<T extends object>(kind: string, more: number): T
function viaOverload<T extends object>(kind: string, more?: number): T { const d: Record<string, unknown> = { only: kind.length + (more ?? 0) }; return d as T }
function under<T extends object>(flag: boolean, other: T): T { const d: Record<string, unknown> = { only: 2 }; return flag ? (d as T)! : other ?? (d as T) }
const overloaded: First = viaOverload<First>("abc", 1), chosen: First = under<First>(true, first), kept2: First = under<First>(false, first)
console.log("seen through:", overloaded.only, chosen.only, kept2.only, kept2 === first)
//// forced-casts-native.ts
// A double cast of a built-in object (a Map) to an interface type.
interface Closed { only: number; o: number[] }
const map: Closed = new Map<string, number>([["only", 1]]) as unknown as Closed
console.log("types without a layout:", map.o, (map as unknown) instanceof Map, (map as unknown as Map<string, number>).get("only"))
interface Open { only?: number; o?: number[] }
const open: Open = new Map<string, number>([["only", 1]]) as unknown as Open
console.log("nothing is required:", open.o, open.only, (open as unknown) instanceof Map)
function fill<T extends object>(): T { const d: Record<string, unknown> = { only: 1 }; return d as T }
interface First { only: number; o?: number[] }
const first: First = fill<First>()
interface Second { other: string; only: number }
const second: Second = first as unknown as Second
console.log("a stranger forced twice:", second.only, second.other, (second as unknown) === first)
//// forced-members.ts
// A `B` reaches a field of type `A` through a double cast and through `any`: any object passes an object type, and a member it does not have reads undefined.
interface A { a: number; shared?: string; o: number[] }
interface B { b: string; shared?: string; n: number }
interface Holder { item: A }
function attempt(label: string, f: () => unknown) { try { console.log(label, String(f())) } catch (e) { console.log(label, (e as Error).constructor.name) } }
const makeA = (): A => ({ a: 1, o: [1] })
const makeB = (): B => ({ b: "b", shared: "s", n: 7 })
attempt("the forced cast", () => (makeB() as unknown as A).shared)
const h: Holder = { item: makeA() }
attempt("stored through any", () => { (h as any).item = makeB(); return "stored" })
attempt("typed, optional and in both", () => h.item.shared)
attempt("typed, a reference it lacks", () => h.item.o)
attempt("typed, a number it lacks", () => h.item.a)
attempt("typed, a number it lacks, in arithmetic", () => h.item.a + 1)
attempt("through any, what it lacks", () => (h.item as any).a)
attempt("through any, its own", () => (h.item as any).b + (h.item as any).n)
attempt("through any from the holder", () => (h as any).item.b)
attempt("typed store of what it lacks", () => { h.item.a = 5; return (h.item as any).a + " " + Object.keys(h.item).join() })
attempt("typed read after that", () => h.item.a + 1)
attempt("its own fields after that", () => (h.item as any).b + (h.item as any).n)
const other: Holder = { item: makeA() }
attempt("an A beside it", () => other.item.a + " " + other.item.o.length + " " + other.item.shared)
//// frozen-object-from-untyped-code/main.ts
// A typed function in one module gets an object that untyped code has frozen, sealed or otherwise made unchangeable. React's development build does this to props.
import { call } from "./untyped.js";
import { double, label, total } from "./typed";
const ways = ["plain", "freeze", "seal", "preventExtensions", "getter", "not writable", "null prototype", "one member more"];
for (const way of ways) {
  const results: unknown[] = [];
  for (const run of [() => call(double, { n: 21 }, way), () => call(label, { thing: { id: "a" }, children: "b" }, way), () => call(total, { list: [1, 2, 3] }, way)]) {
    try {
      results.push(run());
    } catch (error) {
      results.push((error as Error).name);
    }
  }
  console.log(way + ": " + results.join(", "));
}
//// frozen-object-from-untyped-code/typed.ts
type Props = { n: number };
export function double({ n }: Props) {
  return n * 2;
}
type Thing = { id: string };
type LabelProps = { thing: Thing; children: unknown };
export function label(props: LabelProps) {
  return props.thing.id + String(props.children) + Object.isFrozen(props);
}
type ListProps = { list: number[] };
export function total({ list }: ListProps) {
  return list.reduce((sum, value) => sum + value, 0);
}
//// frozen-object-from-untyped-code/untyped.d.ts
export function call<P extends {}>(f: (props: P) => unknown, config: P, way: string): unknown;
//// frozen-object-from-untyped-code/untyped.js
export function call(f, config, way) {
  const props = way === "null prototype" ? Object.create(null) : {};
  for (const key in config) {
    if (way === "getter") Object.defineProperty(props, key, { get: () => config[key], enumerable: true, configurable: true });
    else if (way === "not writable") Object.defineProperty(props, key, { value: config[key], enumerable: true, configurable: true, writable: false });
    else props[key] = config[key];
  }
  if (way === "one member more") props.more = 1;
  if (way === "freeze" || way === "seal" || way === "preventExtensions") Object[way](props);
  return f(props);
}
//// generic-function-returns-any-variable.ts
// A generic function returns a variable of type `any`. It holds a function with two more members, which no layout can be given to.
// The call types the result as a mapped type over its argument, and the program makes an object with the same members elsewhere.
interface Counter {
  readonly count: () => number
  readonly label: string
}
function callable<Shape>(parts: Shape): { [K in keyof Shape]: Shape[K] } {
  const made: any = Object.assign(function () {}, parts)
  return made
}
const plain: Counter = { count: () => 1, label: 'plain' }
const built = callable({ count: () => 2, label: 'built' })
const counters: Counter[] = [plain, built]
console.log(counters.map(counter => counter.label + counter.count()).join(), typeof built)
//// generic-function-returns-any-with-many-keys.ts
// A generic function builds its result with Object.fromEntries and returns it as `any`. Each call types the result as a mapped
// type over its argument. The object has more properties than a plain object has room for in place.
const registry = { k0: 0, k1: 1, k2: 2, k3: 3, k4: 4, k5: 5, k6: 6, k7: 7, k8: 8, k9: 9, k10: 10, k11: 11, k12: 12, k13: 13, k14: 14, k15: 15 } as const
function builders<Types extends Record<string, any>>(options: Types): { [K in keyof Types]: () => Types[K] } {
  return Object.fromEntries(Object.entries(options).map(([key, value]) => [key, () => value])) as any
}
const all = builders(registry)
const copy = { ...all }
console.log(Object.keys(all).length, all.k0(), all.k15(), Object.keys(copy).length, copy.k7())
//// global-function-read-as-record.ts
// `Buffer` is a function with static methods. It is read from `globalThis` through a cast to a type literal that lists two of
// them, which is how a library asks for a global that may be missing. Elsewhere a generic function allocates objects with a
// member of the same name, so the type literal is not without objects of its own.
const buffer = (globalThis as {
  readonly Buffer?: {
    readonly from: (body: string, encoding: 'utf8') => Uint8Array
    readonly byteLength: (body: string, encoding: 'utf8') => number
  }
}).Buffer
const encodeText: (body: string) => Uint8Array = buffer !== undefined ? body => buffer.from(body, 'utf8') : body => new TextEncoder().encode(body)
const byteLength = (body: string) => (buffer !== undefined ? buffer.byteLength(body, 'utf8') : -1)
function span<From, To>(from: From, to: To): { readonly from: From; readonly to: To } {
  return { from, to }
}
const numbers = span(1, 2)
const words = span('a', 'b')
console.log(encodeText('héllo').length, byteLength('héllo'), numbers.from + numbers.to, words.from + words.to)
//// grown-literal-into-handler-called-as-a-value.ts
// A plain object that is made with three properties, given two more, and handed to a typed handler that was stored as a value.
interface Endpoint<Params, Query> {
  readonly name: string;
  readonly decodeParams: (text: string) => Params;
  readonly decodeQuery: (text: string) => Query;
}
type RequestOf<E> = E extends Endpoint<infer Params, infer Query>
  ? { readonly params: Params; readonly query: Query; readonly request: string; readonly endpoint: string; readonly group: string }
  : never;
type Handler<E> = (request: RequestOf<E>) => string;

class Group<Endpoints extends Record<string, Endpoint<any, any>>> {
  readonly handlers = new Map<string, { readonly endpoint: Endpoint<any, any>; readonly handler: Handler<any> }>();
  constructor(readonly endpoints: Endpoints) {}
  handle<Name extends keyof Endpoints & string>(name: Name, handler: Handler<Endpoints[Name]>): this {
    this.handlers.set(name, { endpoint: this.endpoints[name]!, handler: handler as Handler<any> });
    return this;
  }
  dispatch(name: string, params: string, query: string): string {
    const { endpoint, handler } = this.handlers.get(name)!;
    const request: any = { request: "GET /" + name, endpoint: endpoint.name, group: "users" };
    request.params = endpoint.decodeParams(params);
    request.query = endpoint.decodeQuery(query);
    return handler(request);
  }
}

const posts: Endpoint<{ readonly id: number }, { readonly page: number }> = {
  name: "posts",
  decodeParams: text => ({ id: Number(text) }),
  decodeQuery: text => ({ page: Number(text) }),
};
const group = new Group({ posts }).handle(
  "posts",
  ({ params, query, request, endpoint, group }) => `${params.id} ${query.page} ${request} ${endpoint} ${group}`,
);
console.log(group.dispatch("posts", "42", "2"));
console.log(group.dispatch("posts", "7", "3"));
//// host-members-as-interfaces.ts
// A member of a host object is often a host object too. When the outer object is used through one of the program's interfaces, each member is used through the interface's own member type: a property, a method's return value, a promise's value, an array's elements, a callback's parameter. Each case has its own interfaces, and for each a program class with one extra member, so no host object matches those classes. The output must match plain Bun.
import { statSync } from "node:fs";

// a property
interface ParamsLike { get(name: string): string | null }
interface UrlLike { href: string; searchParams: ParamsLike }
class FakeParams implements ParamsLike { fakeOnly = 0; get(name: string): string | null { return "fake-" + name; } }
class FakeUrl implements UrlLike { fakeOnly = 0; href = "fake:"; searchParams: ParamsLike = new FakeParams(); }
function showUrl(url: UrlLike) { return url.href + " " + url.searchParams.get("a"); }
const url: UrlLike = new URL("http://h/p?a=1");
console.log(showUrl(url), showUrl(new FakeUrl()));

// a method's return value
interface BytesLike { length: number; byteLength: number }
interface EncoderLike { encoding: string; encode(text?: string): BytesLike }
class FakeBytes implements BytesLike { fakeOnly = 0; length = -1; byteLength = -2; }
class FakeEncoder implements EncoderLike { fakeOnly = 0; encoding = "fake"; encode(): BytesLike { return new FakeBytes(); } }
function showEncoder(encoder: EncoderLike) { const bytes = encoder.encode("abc"); return encoder.encoding + " " + bytes.length + " " + bytes.byteLength; }
console.log(showEncoder(new TextEncoder()), showEncoder(new FakeEncoder()));

// two properties
interface ReadableLike { locked: boolean; cancel(reason?: unknown): Promise<void> }
interface WritableLike { locked: boolean; abort(reason?: unknown): Promise<void> }
interface TransformLike { readable: ReadableLike; writable: WritableLike }
class FakeReadable implements ReadableLike { fakeOnly = 0; locked = true; async cancel() {} }
class FakeWritable implements WritableLike { fakeOnly = 0; locked = true; async abort() {} }
class FakeTransform implements TransformLike { fakeOnly = 0; readable: ReadableLike = new FakeReadable(); writable: WritableLike = new FakeWritable(); }
function showTransform(transform: TransformLike) { return transform.readable.locked + " " + transform.writable.locked; }
function makeTransform(): TransformLike { return new TransformStream(); }
console.log(showTransform(makeTransform()), showTransform(new FakeTransform()));

// a member that is a built-in class
interface DateLike { getTime(): number }
interface StatsLike { size: number; mtime: DateLike; isDirectory(): boolean }
class FakeDate implements DateLike { fakeOnly = 0; getTime() { return -1; } }
class FakeStats implements StatsLike { fakeOnly = 0; size = -1; mtime: DateLike = new FakeDate(); isDirectory() { return false; } }
function showStats(stats: StatsLike) { return stats.isDirectory() + " " + (stats.mtime.getTime() > 0); }
class StatsHolder { constructor(public stats: StatsLike) {} }
console.log(showStats(new StatsHolder(statSync(".")).stats), showStats(new FakeStats()));

// two levels down
interface ReaderLike { releaseLock(): void }
interface BodyLike { locked: boolean; getReader(): ReaderLike }
interface ResponseLike { status: number; body: BodyLike | null }
class FakeReader implements ReaderLike { fakeOnly = 0; releaseLock() {} }
class FakeBody implements BodyLike { fakeOnly = 0; locked = false; getReader(): ReaderLike { return new FakeReader(); } }
class FakeResponse implements ResponseLike { fakeOnly = 0; status = 1; body: BodyLike | null = new FakeBody(); }
function showResponse(response: ResponseLike) {
  const body = response.body;
  if (!body) return "none";
  const reader = body.getReader();
  const locked = body.locked;
  reader.releaseLock();
  return response.status + " " + locked + " " + body.locked;
}
const responses: ResponseLike[] = [new Response("abc", { status: 201 }), new FakeResponse()];
console.log(responses.map(showResponse).join());

// a promise's value
interface BlobLike { size: number; type: string }
interface BlobSourceLike { blob(): Promise<BlobLike> }
class FakeBlob implements BlobLike { fakeOnly = 0; size = -1; type = "fake"; }
class FakeBlobSource implements BlobSourceLike { fakeOnly = 0; async blob(): Promise<BlobLike> { return new FakeBlob(); } }
async function showBlob(source: BlobSourceLike) { const blob = await source.blob(); return blob.size + " " + typeof blob.type; }
console.log(await showBlob(new Response("abcd")), await showBlob(new FakeBlobSource()));

// an array's elements
interface FileLike { name: string; size: number }
interface FormLike { getAll(name: string): (string | FileLike)[] }
class FakeFile implements FileLike { fakeOnly = 0; name = "fake"; size = -1; }
class FakeForm implements FormLike { fakeOnly = 0; getAll(name: string): (string | FileLike)[] { return [name, new FakeFile()]; } }
function showForm(form: FormLike) { return form.getAll("f").map(entry => (typeof entry === "string" ? entry : entry.name + entry.size)).join(); }
const formData = new FormData();
formData.append("f", "text");
formData.append("f", new File(["abc"], "a.txt"));
console.log(showForm(formData), showForm(new FakeForm()));

// a callback's parameter
interface EventLike { type: string }
interface TargetLike { addEventListener(type: string, listener: (event: EventLike) => void): void; dispatchEvent(event: Event): boolean }
class FakeEvent implements EventLike { fakeOnly = 0; type = "fake"; }
class FakeTarget implements TargetLike {
  fakeOnly = 0;
  listener: ((event: EventLike) => void) | null = null;
  addEventListener(type: string, listener: (event: EventLike) => void) { this.listener = listener; }
  dispatchEvent(event: Event) { this.listener?.(new FakeEvent()); return true; }
}
function listen(target: TargetLike) {
  let seen = "none";
  target.addEventListener("ping", event => { seen = event.type; });
  target.dispatchEvent(new Event("ping"));
  return seen;
}
console.log(listen(new EventTarget()), listen(new FakeTarget()));

// a method that returns the same interface
interface SliceLike { size: number; slice(start?: number, end?: number): SliceLike }
class FakeSlice implements SliceLike { fakeOnly = 0; size = -1; slice(): SliceLike { return this; } }
function showSlice(whole: SliceLike) { return whole.slice(1, 5).slice(1).size; }
console.log(showSlice(new Blob(["abcdef"])), showSlice(new FakeSlice()));

// the outer object passes through a local typed as its own class
interface HeaderBagLike { get(name: string): string | null; has(name: string): boolean }
interface RequestLike { method: string; headers: HeaderBagLike }
class FakeHeaderBag implements HeaderBagLike { fakeOnly = 0; get(name: string): string | null { return "fake-" + name; } has(name: string) { return false; } }
class FakeRequest implements RequestLike { fakeOnly = 0; method = "FAKE"; headers: HeaderBagLike = new FakeHeaderBag(); }
function showRequest(request: RequestLike) { return request.method + " " + request.headers.get("x-a") + " " + request.headers.has("x-b"); }
const rawRequest: Request = new Request("http://h/", { headers: { "x-a": "1" } });
const request: RequestLike = rawRequest;
console.log(showRequest(request), showRequest(new FakeRequest()));

// an optional member and a union with null
interface OriginLike { dispatchEvent(event: Event): boolean }
interface MessageLike { type: string; data: unknown; target: OriginLike | null; source?: unknown }
class FakeOrigin implements OriginLike { fakeOnly = 0; dispatchEvent() { return false; } }
class FakeMessage implements MessageLike { fakeOnly = 0; type = "fake"; data: unknown = 0; target: OriginLike | null = new FakeOrigin(); }
function showMessage(message: MessageLike) { return message.type + " " + message.data + " " + (message.target === null ? "null" : typeof message.target.dispatchEvent); }
const origin = new EventTarget();
let received: MessageLike | null = null;
origin.addEventListener("message", event => { received = event as MessageEvent; });
origin.dispatchEvent(new MessageEvent("message", { data: 5 }));
console.log(showMessage(received!), showMessage(new MessageEvent("message", { data: 6 })), showMessage(new FakeMessage()));

// the outer object is pushed into an array of the interface
interface PairsLike { has(name: string): boolean }
interface AddressLike { host: string; searchParams: PairsLike }
class FakePairs implements PairsLike { fakeOnly = 0; has(name: string) { return name === "fake"; } }
class FakeAddress implements AddressLike { fakeOnly = 0; host = "fake"; searchParams: PairsLike = new FakePairs(); }
function showAddress(address: AddressLike) { return address.host + " " + address.searchParams.has("a"); }
const addresses: AddressLike[] = [new FakeAddress()];
addresses.push(new URL("http://h/p?a=1"));
console.log(addresses.map(showAddress).join());
//// host-objects-between-structural-types.ts
// A host object typed as its own class is assigned to a local with a structural type, then passed on to a second, identical structural type. Each case has its own host class, its own pair of types, and a program class with one extra member so that the host object never matches that class. The output must match plain Bun.

// an annotated constant of the host's type
type UrlA = { readonly href: string; readonly host: string };
type UrlB = { readonly href: string; readonly host: string };
class FakeUrl { fakeOnly = 0; href = "fake:"; host = "fake"; }
function useUrl(x: UrlB) { return x.href + x.host; }
const rawUrl: URL = new URL("http://h/p");
const url: UrlA = rawUrl;
console.log(useUrl(url), useUrl(new FakeUrl()));

// the result of a function
type HeadersA = { get(name: string): string | null; has(name: string): boolean; count?: number };
type HeadersB = { get(name: string): string | null; has(name: string): boolean; count?: number };
class FakeHeaders { fakeOnly = 0; count = 1; get(name: string): string | null { return "fake"; } has(name: string) { return false; } }
function useHeaders(x: HeadersB) { return x.get("a") + String(x.has("b")) + x.count; }
function makeHeaders(): Headers { return new Headers({ a: "1" }); }
const headers: HeadersA = makeHeaders();
console.log(useHeaders(headers), useHeaders(new FakeHeaders()));

// a field
type ResponseA = { readonly status: number; readonly ok: boolean };
type ResponseB = { readonly status: number; readonly ok: boolean };
class FakeResponse { fakeOnly = 0; status = 1; ok = false; }
function useResponse(x: ResponseB) { return x.status + String(x.ok); }
class Box { constructor(public raw: Response) {} }
const response: ResponseA = new Box(new Response("", { status: 201 })).raw;
console.log(useResponse(response), useResponse(new FakeResponse()));

// an element
type BlobA = { readonly size: number; readonly type: string };
type BlobB = { readonly size: number; readonly type: string };
class FakeBlob { fakeOnly = 0; size = -1; type = "fake"; }
function useBlob(x: BlobB) { return x.size + x.type; }
const blobs: Blob[] = [new Blob(["abc"], { type: "text/x" })];
const blob: BlobA = blobs[0];
console.log(useBlob(blob), useBlob(new FakeBlob()));

// the class under another name
type DecoderA = { readonly encoding: string; readonly fatal: boolean };
type DecoderB = { readonly encoding: string; readonly fatal: boolean };
class FakeDecoder { fakeOnly = 0; encoding = "fake"; fatal = true; }
function useDecoder(x: DecoderB) { return x.encoding + x.fatal; }
const Decoder = TextDecoder;
const decoder: DecoderA = new Decoder();
console.log(useDecoder(decoder), useDecoder(new FakeDecoder()));

// a class of the program that extends a class of the host
type TargetA = { dispatchEvent(event: Event): boolean; label: string };
type TargetB = { dispatchEvent(event: Event): boolean; label: string };
class FakeTarget { fakeOnly = 0; label = "fake"; dispatchEvent(event: Event) { return false; } }
function useTarget(x: TargetB) { return x.label + x.dispatchEvent(new Event("e")); }
class Mine extends EventTarget { label = "mine"; }
const target: TargetA = new Mine();
console.log(useTarget(target), useTarget(new FakeTarget()));

// the class taken out of globalThis
type EncoderA = { readonly encoding: string; tag?: string };
type EncoderB = { readonly encoding: string; tag?: string };
class FakeEncoder { fakeOnly = 0; encoding = "fake"; tag = "t"; }
function useEncoder(x: EncoderB) { return x.encoding + x.tag; }
const { TextEncoder: Encoder } = globalThis;
const encoder: EncoderA = new Encoder();
console.log(useEncoder(encoder), useEncoder(new FakeEncoder()));

// the class read off globalThis by a string
type RequestA = { readonly method: string; readonly url: string };
type RequestB = { readonly method: string; readonly url: string };
class FakeRequest { fakeOnly = 0; method = "FAKE"; url = "fake:"; }
function useRequest(x: RequestB) { return x.method + x.url; }
const request: RequestA = new globalThis["Request"]("http://h/r");
console.log(useRequest(request), useRequest(new FakeRequest()));
//// host-objects-cast-from-any.ts
// A host object typed `any` or `unknown` is cast with `as`, or annotated, as one of the program's interfaces. Its members and what its methods return, directly or through a promise, are then used through the interface's own member types. Each case has its own interfaces, and for each a program class with one extra member, so no host object matches those classes. The output must match plain Bun.

// a method's return value, cast from `any`
interface BytesLike { length: number; byteLength: number }
interface EncoderLike { encoding: string; encode(text?: string): BytesLike }
class FakeBytes implements BytesLike { fakeOnly = 0; length = -1; byteLength = -2; }
class FakeEncoder implements EncoderLike { fakeOnly = 0; encoding = "fake"; encode(): BytesLike { return new FakeBytes(); } }
function showEncoder(encoder: EncoderLike) { const bytes = encoder.encode("abc"); return encoder.encoding + " " + bytes.length + " " + bytes.byteLength; }
function untypedEncoder(): any { return new TextEncoder(); }
console.log(showEncoder(untypedEncoder() as EncoderLike), showEncoder(new FakeEncoder()));

// a method that returns the same interface, cast from `unknown`
interface SliceLike { size: number; slice(start?: number, end?: number): SliceLike }
class FakeSlice implements SliceLike { fakeOnly = 0; size = -1; slice(): SliceLike { return this; } }
function showSlice(whole: SliceLike) { return whole.slice(1, 5).slice(1).size; }
function unknownBlob(): unknown { return new Blob(["abcdef"]); }
console.log(showSlice(unknownBlob() as SliceLike), showSlice(new FakeSlice()));

// a promise's value, cast from `any`
interface BufferLike { byteLength: number }
interface BufferSourceLike { arrayBuffer(): Promise<BufferLike> }
class FakeBuffer implements BufferLike { fakeOnly = 0; byteLength = -1; }
class FakeBufferSource implements BufferSourceLike { fakeOnly = 0; async arrayBuffer(): Promise<BufferLike> { return new FakeBuffer(); } }
async function showBuffer(source: BufferSourceLike) { return (await source.arrayBuffer()).byteLength; }
function untypedResponse(): any { return new Response("abcd"); }
console.log(await showBuffer(untypedResponse() as BufferSourceLike), await showBuffer(new FakeBufferSource()));

// a property, cast from `any`
interface QueryLike { get(name: string): string | null }
interface LinkLike { href: string; searchParams: QueryLike }
class FakeQuery implements QueryLike { fakeOnly = 0; get(name: string): string | null { return "fake-" + name; } }
class FakeLink implements LinkLike { fakeOnly = 0; href = "fake:"; searchParams: QueryLike = new FakeQuery(); }
function showLink(link: LinkLike) { return link.href + " " + link.searchParams.get("a"); }
function untypedUrl(): any { return new URL("http://h/p?a=1"); }
console.log(showLink(untypedUrl() as LinkLike), showLink(new FakeLink()));

// a promise's value, annotated from `any`
interface TextBlobLike { size: number }
interface TextBlobSourceLike { blob(): Promise<TextBlobLike> }
class FakeTextBlob implements TextBlobLike { fakeOnly = 0; size = -1; }
class FakeTextBlobSource implements TextBlobSourceLike { fakeOnly = 0; async blob(): Promise<TextBlobLike> { return new FakeTextBlob(); } }
async function showTextBlob(source: TextBlobSourceLike) { return (await source.blob()).size; }
function untypedRequest(): any { return new Request("http://h/", { method: "POST", body: "abcde" }); }
const annotatedSource: TextBlobSourceLike = untypedRequest();
console.log(await showTextBlob(annotatedSource), await showTextBlob(new FakeTextBlobSource()));
//// host-objects-constructed-via-globalthis.ts
// A host object constructed with `new globalThis.X()` works with the program's own structural types exactly like one constructed with `new X()`: it is read by name and never rejected.
type SocketLike = { readonly readyState: number; close(): void; send(data: string): void };
class FakeSocket { readyState = 7; close() {} send(data: string) {} }
class Transport {
  constructor(private socket: SocketLike) {}
  state() { return typeof this.socket.readyState; }
  end() { this.socket.close(); }
}

interface ParamsLike { get(name: string): string | null }
interface UrlLike { href: string; searchParams: ParamsLike }
class FakeParams implements ParamsLike { get(name: string) { return "fake-" + name; } }
class FakeUrl implements UrlLike { href = "fake:"; searchParams: ParamsLike = new FakeParams(); }
function showUrl(url: UrlLike) { return url.href + " " + url.searchParams.get("a"); }

interface HeadersLike { get(name: string): string | null; has(name: string): boolean }
interface ResponseLike { status: number; ok: boolean; headers: HeadersLike }
class FakeHeaders implements HeadersLike { get(name: string) { return name; } has(name: string) { return false; } }
class FakeResponse implements ResponseLike { status = 1; ok = false; headers: HeadersLike = new FakeHeaders(); }
function showResponse(response: ResponseLike) { return response.status + " " + response.ok + " " + response.headers.get("x-a") + " " + response.headers.has("x-b"); }

interface SignalLike { aborted: boolean }
interface ControllerLike { signal: SignalLike; abort(): void }
class FakeSignal implements SignalLike { aborted = false; }
class FakeController implements ControllerLike { signal: SignalLike = new FakeSignal(); abort() { this.signal.aborted = true; } }
function abortAndShow(controller: ControllerLike) { const before = controller.signal.aborted; controller.abort(); return before + " " + controller.signal.aborted; }

const socket: SocketLike = new globalThis.WebSocket("ws://127.0.0.1:9");
const transports = [new Transport(socket), new Transport(new FakeSocket())];
console.log(transports.map(transport => transport.state()).join());
for (const transport of transports) transport.end();

const url: UrlLike = new globalThis.URL("http://host/path?a=1");
console.log(showUrl(url), "|", showUrl(new FakeUrl()), "|", showUrl(new globalThis.URL("http://host/?a=2")));

const response: ResponseLike = new globalThis.Response("body", { status: 201, headers: { "x-a": "b" } });
console.log(showResponse(response), "|", showResponse(new FakeResponse()));
const responses: ResponseLike[] = [new FakeResponse(), new globalThis.Response(null, { status: 204 })];
console.log(responses.map(showResponse).join(" | "));

console.log(abortAndShow(new globalThis.AbortController()), "|", abortAndShow(new FakeController()));

class Holder { held: UrlLike | null = null; }
const holder = new Holder();
holder.held = new globalThis.URL("http://held/?a=3");
console.log(showUrl(holder.held));
function made(): ResponseLike { return new globalThis.Response("", { status: 202 }); }
console.log(showResponse(made()));
//// host-objects-from-any-as-interfaces.ts
// A host object typed `any` that satisfies one of the program's interfaces is accepted wherever the interface is used: an annotation, a parameter, a field, an element, a return value, `as`, a map. No host object is used under its own type here. Each interface also has a program class with one extra member, so no host object matches that class.
import { statSync } from "node:fs";

interface HeadersLike { get(name: string): string | null; has(name: string): boolean }
class FakeHeaders implements HeadersLike { fakeOnly = 0; get(name: string): string | null { return "fake-" + name; } has(name: string) { return false; } }
interface SocketLike { send(data: string): void; close(): void; readyState: number; onmessage: ((e: any) => void) | null }
class FakeSocket implements SocketLike { fakeOnly = 0; readyState = 9; onmessage: ((e: any) => void) | null = null; send(data: string) {} close() {} }
interface RequestLike { method: string; url: string; headers: HeadersLike }
class FakeRequest implements RequestLike { fakeOnly = 0; method = "FAKE"; url = "fake:"; headers: HeadersLike = new FakeHeaders(); }
interface ResponseLike { status: number; ok: boolean; headers: HeadersLike }
class FakeResponse implements ResponseLike { fakeOnly = 0; status = 1; ok = false; headers: HeadersLike = new FakeHeaders(); }
interface ParamsLike { get(name: string): string | null }
class FakeParams implements ParamsLike { fakeOnly = 0; get(name: string): string | null { return "fake-" + name; } }
interface UrlLike { href: string; searchParams: ParamsLike }
class FakeUrl implements UrlLike { fakeOnly = 0; href = "fake:"; searchParams: ParamsLike = new FakeParams(); }
interface BlobLike { size: number; type: string; slice(start?: number, end?: number): BlobLike }
class FakeBlob implements BlobLike { fakeOnly = 0; size = -1; type = "fake"; slice(): BlobLike { return this; } }
interface FileLike { name: string; size: number; lastModified: number }
class FakeFile implements FileLike { fakeOnly = 0; name = "fake"; size = -1; lastModified = 0; }
interface FormLike { get(name: string): unknown; has(name: string): boolean; append(name: string, value: string): void }
class FakeForm implements FormLike { fakeOnly = 0; get(name: string): unknown { return "fake"; } has(name: string) { return false; } append(name: string, value: string) {} }
interface ReadableLike { locked: boolean; cancel(reason?: unknown): Promise<void> }
class FakeReadable implements ReadableLike { fakeOnly = 0; locked = true; async cancel() {} }
interface WritableLike { locked: boolean; abort(reason?: unknown): Promise<void> }
class FakeWritable implements WritableLike { fakeOnly = 0; locked = true; async abort() {} }
interface TransformLike { readable: ReadableLike; writable: WritableLike }
class FakeTransform implements TransformLike { fakeOnly = 0; readable: ReadableLike = new FakeReadable(); writable: WritableLike = new FakeWritable(); }
interface SignalLike { aborted: boolean; reason: unknown }
class FakeSignal implements SignalLike { fakeOnly = 0; aborted = false; reason: unknown = "fake"; }
interface ControllerLike { signal: SignalLike; abort(reason?: unknown): void }
class FakeController implements ControllerLike { fakeOnly = 0; signal: SignalLike = new FakeSignal(); abort() { this.signal.aborted = true; } }
interface EncoderLike { encoding: string; encode(text?: string): BytesLike }
interface BytesLike { length: number; byteLength: number }
class FakeBytes implements BytesLike { fakeOnly = 0; length = -1; byteLength = -2; }
class FakeEncoder implements EncoderLike { fakeOnly = 0; encoding = "fake"; encode(): BytesLike { return new FakeBytes(); } }
interface DecoderLike { encoding: string; fatal: boolean; decode(): string }
class FakeDecoder implements DecoderLike { fakeOnly = 0; encoding = "fake"; fatal = true; decode() { return "fake"; } }
interface TargetLike { dispatchEvent(event: Event): boolean }
class FakeTarget implements TargetLike { fakeOnly = 0; dispatchEvent() { return false; } }
interface MessageLike { type: string; data: unknown; target: TargetLike | null }
class FakeMessage implements MessageLike { fakeOnly = 0; type = "fake"; data: unknown = 0; target: TargetLike | null = new FakeTarget(); }
interface TimerLike { ref(): TimerLike; unref(): TimerLike; hasRef(): boolean }
class FakeTimer implements TimerLike { fakeOnly = 0; ref(): TimerLike { return this; } unref(): TimerLike { return this; } hasRef() { return false; } }
interface StatsLike { size: number; mtime: DateLike; isDirectory(): boolean }
interface DateLike { getTime(): number }
class FakeDate implements DateLike { fakeOnly = 0; getTime() { return -1; } }
class FakeStats implements StatsLike { fakeOnly = 0; size = -1; mtime: DateLike = new FakeDate(); isDirectory() { return false; } }

