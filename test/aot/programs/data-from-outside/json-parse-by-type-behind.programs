////: typed-parse-calls
import { JSON as Typed } from "bun";

type Row = { a: number };
const original = JSON.parse;
const spell = JSON.stringify;
const kept: [string] = [""];
let calls = 0;

function attempt(name: string, run: () => unknown) {
  try {
    console.log(name, "takes", spell(run()));
  } catch (error) {
    console.log(name, "refuses with", (error as Error).name);
  }
}

function inTailPosition(text: string) {
  return JSON.parse<Row>(text);
}

function all(text: string) {
  kept[0] = text;
  attempt("JSON", () => JSON.parse<Row>(text));
  attempt("globalThis.JSON", () => globalThis.JSON.parse<Row>(text));
  attempt("an optional call", () => JSON.parse?.<Row>(text));
  attempt("a key in brackets", () => JSON["parse"]<Row>(text));
  attempt("a reviver", () => JSON.parse<Row>(text, (key: string, value: unknown) => value));
  attempt("in tail position", () => inTailPosition(text));
  attempt("a spread of a literal", () => JSON.parse<Row>(...([text] as [string])));
  attempt("a spread of a list that is kept", () => JSON.parse<Row>(...kept));
  attempt("JSON of bun", () => Typed.parse<Row>(text));
  attempt("Bun.JSON", () => Bun.JSON.parse<Row>(text));
  attempt("JSON of bun, a spread of a literal", () => Typed.parse<Row>(...([text] as [string])));
  attempt("JSON of bun, a spread of a list that is kept", () => Typed.parse<Row>(...kept));
}

for (const text of ['{"a":1}', '{"a":"text"}', "[]"]) all(text);
////: typed-parse-calls-again
for (const text of ['{"a":1}', '{"a":"text"}', "[]"]) all(text);
console.log("the function that was put in ran", calls, "times");
//// json-parse-by-type-with-a-spread-argument.ts
// JSON.parse<T>(text) validates what the call returns, whoever is called and however the arguments are written. `parse` of the global JSON is what stands there when the call runs, `parse` of the JSON of "bun" is always the engine's. Nothing is put in the place of JSON.parse.
////= typed-parse-calls
//// json-parse-by-type-behind-a-function-of-the-program-stored-into-json-parse.ts
// JSON.parse<T>(text) validates what the call returns, whoever is called and however the arguments are written. `parse` of the global JSON is what stands there when the call runs, `parse` of the JSON of "bun" is always the engine's. A function of the program is stored into JSON.parse.
////= typed-parse-calls
JSON.parse = function (text: string, reviver?: any) {
  calls++;
  return original(text, reviver);
} as typeof JSON.parse;
////= typed-parse-calls-again
//// json-parse-by-type-behind-a-getter-defined-for-json-parse.ts
// JSON.parse<T>(text) validates what the call returns, whoever is called and however the arguments are written. `parse` of the global JSON is what stands there when the call runs, `parse` of the JSON of "bun" is always the engine's. JSON.parse becomes a getter.
////= typed-parse-calls
Object.defineProperty(JSON, "parse", { get: () => (text: string) => (calls++, original(text)) });
////= typed-parse-calls-again
//// json-parse-by-type-behind-a-store-into-json-parse-by-text-that-is-run.ts
// JSON.parse<T>(text) validates what the call returns, whoever is called and however the arguments are written. `parse` of the global JSON is what stands there when the call runs, `parse` of the JSON of "bun" is always the engine's. Text that is run stores into JSON.parse.
////= typed-parse-calls
new Function("original", "count", "JSON.parse = text => (count(), original(text));")(original, () => calls++);
////= typed-parse-calls-again
//// json-parse-by-type-behind-a-function-that-returns-something-else-stored-into-json-parse.ts
// JSON.parse<T>(text) validates what the call returns, whoever is called and however the arguments are written. `parse` of the global JSON is what stands there when the call runs, `parse` of the JSON of "bun" is always the engine's. What is stored into JSON.parse returns a list whatever the text says.
////= typed-parse-calls
JSON.parse = (() => (calls++, [1])) as typeof JSON.parse;
////= typed-parse-calls-again
//// json-parse-by-type-whose-only-arguments-are-a-rest-parameter.ts
// JSON.parse<T>(...all) is the only call of the program that validates, and its arguments are the rest parameter of the function around it.
import { JSON as Typed } from "bun";

type Row = { a: number };

function handsOn(...all: [string]) {
  return Typed.parse<Row>(...all);
}

for (const text of ['{"a":1}', '{"a":"text"}']) {
  try {
    console.log("takes", JSON.stringify(handsOn(text)));
  } catch (error) {
    console.log("refuses with", (error as Error).name);
  }
}
