//// json-parse-type-argument-public-test-suite/generate.ts
// bun generate.ts <a clone of github.com/nst/JSONTestSuite>: writes files.json (each file of test_parsing and test_transform in base64, because many are not UTF-8; a long file that repeats a few bytes is stored as those bytes, a count and what follows) and fitted.ts (for each file that JSON.parse accepts, a type written to fit its value). No script of that repository is run.
import { readdirSync, readFileSync, writeFileSync } from "fs";
import { join } from "path";

const clone = process.argv[2];
const files: Record<string, Buffer> = {};
for (const folder of ["test_parsing", "test_transform"]) for (const name of readdirSync(join(clone, folder)).sort()) files[folder + "/" + name] = readFileSync(join(clone, folder, name));
function stored(bytes: Buffer): string | { repeat: string; times: number; then: string } {
  for (let length = 1; length <= 16 && bytes.length >= 1000; length++) {
    const times = Math.floor(bytes.length / length);
    if (bytes.subarray(0, times * length).equals(Buffer.alloc(times * length, bytes.subarray(0, length)))) return { repeat: bytes.subarray(0, length).toString("base64"), times, then: bytes.subarray(times * length).toString("base64") };
  }
  return bytes.toString("base64");
}
writeFileSync(join(import.meta.dir, "files.json"), "{\n" + Object.entries(files).map(([name, bytes]) => JSON.stringify(name) + ": " + JSON.stringify(stored(bytes))).join(",\n") + "\n}\n");

function typeOf(value: unknown): string {
  if (value === null) return "null";
  if (typeof value !== "object") return typeof value;
  if (Array.isArray(value)) return value.length === 0 ? "unknown[]" : value.length <= 6 ? "[" + value.map(typeOf).join(", ") + "]" : "(" + [...new Set(value.map(typeOf))].join(" | ") + ")[]";
  return "{ " + Object.getOwnPropertyNames(value).map(key => JSON.stringify(key) + ": " + typeOf((value as any)[key])).join("; ") + " }";
}
const types: string[] = [];
const fits: Record<string, number> = {};
for (const [name, bytes] of Object.entries(files)) {
  let value: unknown;
  try {
    value = JSON.parse(new TextDecoder("utf-8", { ignoreBOM: true }).decode(bytes));
  } catch {
    continue;
  }
  const type = typeOf(value);
  if (type.length > 400 || /\\ud[89a-f]/.test(type)) continue;
  if (!types.includes(type)) types.push(type);
  fits[name] = types.indexOf(type);
}
writeFileSync(
  join(import.meta.dir, "fitted.ts"),
  "// Written by generate.ts.\nexport const parsers: ((text: string) => unknown)[] = [\n" + types.map(type => "  text => JSON.parse(text) as " + type + ",\n").join("") + "];\nexport const fits: Record<string, number> = " + JSON.stringify(fits, null, 2) + ";\n",
);
//// json-parse-type-argument-public-test-suite/main.ts
// The public JSONTestSuite (github.com/nst/JSONTestSuite, see README.md): every file goes through `JSON.parse(text) as T` for types that take anything, inside wrappers, and for the types written to fit the files that are valid: the SyntaxError of JSON.parse, or its value.
import files from "./files.json";
import { fits, parsers } from "./fitted";

type Json = string | number | boolean | null | Json[] | { [key: string]: Json };
type Point = { x: number; y: number };

const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
function bytesOf(base64: string): number[] {
  const bytes: number[] = [];
  let bits = 0;
  let count = 0;
  for (let at = 0; at < base64.length && base64[at] !== "="; at++) {
    bits = (bits << 6) | alphabet.indexOf(base64[at]);
    count += 6;
    if (count >= 8) {
      count -= 8;
      bytes.push((bits >> count) & 0xff);
    }
  }
  return bytes;
}
function bytesOfFile(stored: string | { repeat: string; times: number; then: string }): number[] {
  if (typeof stored === "string") return bytesOf(stored);
  const unit = bytesOf(stored.repeat);
  const bytes: number[] = [];
  for (let count = 0; count < stored.times; count++) bytes.push(...unit);
  bytes.push(...bytesOf(stored.then));
  return bytes;
}

function textOf(units: number[]): string {
  let text = "";
  for (let at = 0; at < units.length; at += 4096) text += String.fromCharCode(...units.slice(at, at + 4096));
  return text;
}

// As TextDecoder("utf-8", { ignoreBOM: true }) decodes: U+FFFD for each maximal part of an ill-formed sequence.
function fromUTF8(bytes: number[]): string {
  const units: number[] = [];
  for (let at = 0; at < bytes.length; ) {
    const first = bytes[at++];
    if (first < 0x80) {
      units.push(first);
      continue;
    }
    let needed = first >= 0xc2 && first <= 0xdf ? 1 : first >= 0xe0 && first <= 0xef ? 2 : first >= 0xf0 && first <= 0xf4 ? 3 : 0;
    if (!needed) {
      units.push(0xfffd);
      continue;
    }
    let low = first === 0xe0 ? 0xa0 : first === 0xf0 ? 0x90 : 0x80;
    let high = first === 0xed ? 0x9f : first === 0xf4 ? 0x8f : 0xbf;
    let point = first & (needed === 1 ? 0x1f : needed === 2 ? 0x0f : 0x07);
    for (; needed > 0; needed--) {
      const next = bytes[at];
      if (next === undefined || next < low || next > high) break;
      point = (point << 6) | (next & 0x3f);
      low = 0x80;
      high = 0xbf;
      at++;
    }
    if (needed) units.push(0xfffd);
    else if (point < 0x10000) units.push(point);
    else units.push(0xd800 + ((point - 0x10000) >> 10), 0xdc00 + ((point - 0x10000) & 0x3ff));
  }
  return textOf(units);
}

const plainParse: (text: string) => any = globalThis.JSON.parse;

function show(value: any, depth = 0): string {
  if (depth > 400) return "deep";
  if (Array.isArray(value)) return "[" + value.map(item => show(item, depth + 1)).join(",") + "]";
  if (typeof value === "string") return JSON.stringify(value) + value.length;
  if (typeof value !== "object" || value === null) return Object.is(value, -0) ? "-0" : typeof value + ":" + String(value);
  return "{" + Object.getOwnPropertyNames(value).map(key => JSON.stringify(key) + ":" + show(value[key], depth + 1)).join(",") + "}";
}

////= outcome

const roads: [string, (text: string) => unknown, (text: string) => string][] = [
  ["a type for all JSON", text => JSON.parse(text) as Json, text => text],
  ["an array of all JSON", text => JSON.parse(text) as Json[], text => "[" + text + "," + text + "]"],
  ["a member of unknown type", text => JSON.parse(text) as { value: unknown }, text => '{"value":' + text + "}"],
  ["a member of type any, spaced", text => JSON.parse(text) as { value: any }, text => ' { "value" : ' + text + " } "],
  ["elements of unknown type", text => JSON.parse(text) as unknown[], text => "[" + text + "]"],
  ["a dictionary of unknown", text => JSON.parse(text) as Record<string, unknown>, text => '{"k":' + text + "}"],
  ["an undeclared key", text => JSON.parse(text) as Point, text => '{"x":1,"other":' + text + ',"y":2}'],
  ["a tuple", text => JSON.parse(text) as [number, unknown, string], text => "[1," + text + ',"s"]'],
];

const names = Object.keys(files);
const texts = new Map<string, string[]>();
for (const name of names) {
  const bytes = bytesOfFile((files as Record<string, string | { repeat: string; times: number; then: string }>)[name]);
  texts.set(name, [fromUTF8(bytes), textOf(bytes)]);
}

let shown = 0;
function compare(label: string, name: string, parse: (text: string) => unknown, text: string, counts: number[]): void {
  const typed = outcome(parse, text);
  const plain = outcome(plainParse, text);
  if (typed !== plain) {
    counts[2]++;
    if (shown++ < 20) console.log("DIFFERENT: " + label + ", " + name + "\n  typed: " + typed.slice(0, 200) + "\n  plain: " + plain.slice(0, 200));
  } else counts[plain.startsWith("SyntaxError") ? 1 : 0]++;
}
const told = (counts: number[]) => counts[0] + " values, " + counts[1] + " no JSON: " + counts[2] + " differ";

for (const [label, parse, wrap] of roads) {
  const counts = [0, 0, 0];
  for (const name of names) for (const text of texts.get(name)!) compare(label, name, parse, wrap(text), counts);
  console.log(label + ": " + told(counts));
}
{
  const counts = [0, 0, 0];
  for (const name in fits) compare("the type that fits", name, parsers[fits[name]], texts.get(name)![0], counts);
  console.log("each valid file by the type that fits it: " + told(counts));
}
{
  const counts = [0, 0, 0];
  parsers.forEach((parse, at) => {
    for (const name of names) for (const text of texts.get(name)!) compare("fitted type " + at, name, parse, text, counts);
  });
  console.log("every file by each of the " + parsers.length + " fitted types: " + told(counts));
}
//// json-parse-type-argument-recursive-unions-take-linear-time.ts
// Recursive unions of every kind, 20 to 2,000 levels deep, in texts that fit and texts that do not, by `JSON.parse(text) as T` (also with an escape in the first key): nothing looks at a nested value once for each arm, so each answer comes within a second.
type NumberTag = { below: NumberTag | null; k: 1 } | { below: NumberTag | null; k: 2 };
type FlagTag = { below: FlagTag | null; k: true } | { below: FlagTag | null; k: false };
type TextTag = { below: TextTag | null; k: "one" } | { below: TextTag | null; k: "two" };
type Kinds = { below: Kinds | null; k: number } | { below: Kinds | null; k: string };
type FourKinds = { below: FourKinds | null; k: number } | { below: FourKinds | null; k: string } | { below: FourKinds | null; k: boolean } | { below: FourKinds | null; k: null };
type Below = { below: Below | null; x: { k: 1 } } | { below: Below | null; x: { k: 2 } };
type BelowText = { below: BelowText | null; x: { k: "one" } } | { below: BelowText | null; x: { k: "two" } };
type Lists = { below: Lists[]; k: number[] } | { below: Lists[]; k: string[] };
type Tuples = [Tuples | null, 1] | [Tuples | null, 2];
type Arrays = (Arrays | 1)[] | (Arrays | "a")[];
type Table = Record<string, { below: Table; k: number } | { below: Table; k: string }>;
type Optional = { below?: Optional; a?: number } | { below?: Optional; a?: string };
type Names = { below: Names | null; a: number } | { below: Names | null; b: number };
type Mixed = { below: Mixed | null; k: "one" } | { below: Mixed | null; k: 2 } | { below: Mixed | null; k: false } | { below: Mixed | null; k: null };
type TextOrNull = { below: TextOrNull | null; k: "one" } | { below: TextOrNull | null; k: null };
type Forked = { left: Forked | null; right: Forked | null; k: "one" } | { left: Forked | null; right: Forked | null; k: null };
type TwoBelow = { left: TwoBelow | null; right: TwoBelow | null; k: 1 } | { left: TwoBelow | null; right: TwoBelow | null; k: 2 };

const nest = (open: string, middle: string, close: string, levels: number) => open.repeat(levels) + middle + close.repeat(levels);
const kinds: [string, (text: string) => unknown, (levels: number, bottom: string) => string, string][] = [
  ["number tags", text => JSON.parse(text) as NumberTag, (levels, bottom) => nest('{"below":', bottom, ',"k":2}', levels), "null"],
  ["true or false", text => JSON.parse(text) as FlagTag, (levels, bottom) => nest('{"below":', bottom, ',"k":false}', levels), "null"],
  ["text tags", text => JSON.parse(text) as TextTag, (levels, bottom) => nest('{"below":', bottom, ',"k":"two"}', levels), "null"],
  ["a number or a string", text => JSON.parse(text) as Kinds, (levels, bottom) => nest('{"below":', bottom, ',"k":"s"}', levels), "null"],
  ["four kinds", text => JSON.parse(text) as FourKinds, (levels, bottom) => nest('{"below":', bottom, ',"k":null}', levels), "null"],
  ["a number tag one level below", text => JSON.parse(text) as Below, (levels, bottom) => nest('{"below":', bottom, ',"x":{"k":2}}', levels), "null"],
  ["a text tag one level below", text => JSON.parse(text) as BelowText, (levels, bottom) => nest('{"below":', bottom, ',"x":{"k":"two"}}', levels), "null"],
  ["lists of numbers or of strings", text => JSON.parse(text) as Lists, (levels, bottom) => nest('{"below":[', bottom, '],"k":["s"]}', levels), ""],
  ["tuples", text => JSON.parse(text) as Tuples, (levels, bottom) => nest("[", bottom, ",2]", levels), "null"],
  ["arrays", text => JSON.parse(text) as Arrays, (levels, bottom) => nest("[", bottom, ',"a"]', levels), '"a"'],
  ["a dictionary of a union", text => JSON.parse(text) as Table, (levels, bottom) => nest('{"e":{"below":', bottom, ',"k":"s"}}', levels), "{}"],
  ["optional members only", text => JSON.parse(text) as Optional, (levels, bottom) => nest('{"below":', bottom, ',"a":"s"}', levels), "{}"],
  ["other names", text => JSON.parse(text) as Names, (levels, bottom) => nest('{"below":', bottom, ',"b":1}', levels), "null"],
  ["tags of four kinds, null", text => JSON.parse(text) as Mixed, (levels, bottom) => nest('{"below":', bottom, ',"k":null}', levels), "null"],
  ["tags of four kinds, a text", text => JSON.parse(text) as Mixed, (levels, bottom) => nest('{"below":', bottom, ',"k":"one"}', levels), "null"],
  ["tags of four kinds, a number", text => JSON.parse(text) as Mixed, (levels, bottom) => nest('{"below":', bottom, ',"k":2}', levels), "null"],
  ["tags of four kinds, false", text => JSON.parse(text) as Mixed, (levels, bottom) => nest('{"below":', bottom, ',"k":false}', levels), "null"],
  ["a text or null", text => JSON.parse(text) as TextOrNull, (levels, bottom) => nest('{"below":', bottom, ',"k":null}', levels), "null"],
  ["two nested members, a text or null", text => JSON.parse(text) as Forked, (levels, bottom) => nest('{"left":null,"right":', bottom, ',"k":null}', levels), "null"],
  ["two nested members", text => JSON.parse(text) as TwoBelow, (levels, bottom) => nest('{"left":null,"right":', bottom, ',"k":2}', levels), "null"],
];

function answer(run: () => unknown, text: string): string {
  const start = Date.now();
  let said = "";
  try {
    said = JSON.stringify(run()) === text ? "what JSON.parse gives" : "ANOTHER VALUE";
  } catch (error: any) {
    said = error.name + ": " + error.message;
  }
  return Date.now() - start > 1000 ? said + " TOO SLOWLY" : said;
}

for (const [label, parse, text, bottom] of kinds) {
  for (const levels of [20, 40, 200, 2000]) {
    const fits = text(levels, bottom);
    const misfits = text(levels, "[[7]]");
    const escaped = fits.replace(/^(\[*\{")(.)/, (_, start, first) => start + "\\u00" + first.charCodeAt(0).toString(16));
    console.log(label + ", " + levels + " levels: " + [answer(() => parse(fits), fits), answer(() => parse(escaped), fits), answer(() => parse(misfits), misfits)].join(", "));
  }
}

const fork = (levels: number, tail: string): string => (levels === 0 ? "null" : '{"left":' + fork(levels - 1, tail) + ',"right":' + fork(levels - 1, tail) + tail);
for (const levels of [2, 6, 10, 14]) {
  const forked = fork(levels, ',"k":null}');
  const two = fork(levels, ',"k":2}');
  console.log("a full tree of " + levels + " levels: " + [answer(() => JSON.parse(forked) as Forked, forked), answer(() => JSON.parse(forked.replace('"left"', '"\\u006ceft"')) as Forked, forked), answer(() => JSON.parse(two) as TwoBelow, two)].join(", "));
}
