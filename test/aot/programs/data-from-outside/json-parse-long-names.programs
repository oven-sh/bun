//// json-parse-type-argument-in-workers/main.ts
// `JSON.parse(text) as T` in four Workers at once and on the main thread: nesting to the end of each thread's own stack, and records that are compared with their texts. start.ts is the program; this file is what each Worker runs.
import { parentPort, workerData } from "node:worker_threads";
import { work } from "./work";

parentPort!.postMessage(work(workerData));
//// json-parse-type-argument-in-workers/start.ts
import { Worker } from "node:worker_threads";
import { work } from "./work";

const answers: string[] = [];
let waiting = 4;
for (let number = 0; number < 4; number++) {
  const worker = new Worker("./main.ts", { workerData: number + 1 });
  worker.on("message", (message: string) => {
    answers[number] = message;
    if (--waiting) return;
    for (const answer of answers) console.log("worker: " + answer);
    console.log("main again: " + work(9));
  });
}
console.log("main: " + work(0));
//// json-parse-type-argument-in-workers/work.ts
type Tree = { kids: Tree[] };
type Deep = Deep[];
type Loose = { value: unknown };
type Item = { id: number; name: string; tags: string[]; inner: { a: number; b?: string } };

const overflow = "RangeError: Maximum call stack size exceeded.";

function depthOf(value: any): number {
  let depth = 0;
  while (typeof value === "object" && value !== null) {
    depth++;
    let next: any = undefined;
    for (const key in value) if (typeof value[key] === "object") next = value[key];
    value = next;
  }
  return depth;
}

function answer(parse: (text: string) => unknown, text: string): string {
  try {
    return "depth " + depthOf(parse(text));
  } catch (error: any) {
    return error.name + ": " + error.message;
  }
}

const roads: [(text: string) => unknown, (levels: number) => string, (levels: number) => number][] = [
  [text => JSON.parse(text) as Tree, levels => '{"kids":['.repeat(levels) + "]}".repeat(levels), levels => 2 * levels],
  [text => JSON.parse(text) as Deep, levels => "[".repeat(levels) + "]".repeat(levels), levels => levels],
  [text => JSON.parse(text) as Loose, levels => '{"value":' + "[".repeat(levels) + "]".repeat(levels) + "}", levels => levels + 1],
];

export function work(number: number): string {
  let wrong = 0;
  let values = 0;
  for (const [parse, text, depth] of roads) {
    for (const levels of [100, 10_000, 100_000]) {
      const said = answer(parse, text(levels));
      if (said === "depth " + depth(levels)) values++;
      else if (said !== overflow) wrong++;
    }
    const depths = [1, 3, 8, 21, 55, 144, 377, 987, 2584];
    const texts = depths.map(text);
    let frames = 0;
    const dive = (level: number): void => {
      try {
        dive(level + 1);
      } catch {
        if (frames === 0) frames = level;
      }
      if (frames - level > 100) return;
      const which = level % depths.length;
      const said = answer(parse, texts[which]);
      if (said === "depth " + depth(depths[which])) values++;
      else if (said !== overflow) wrong++;
    };
    dive(0);
  }
  let different = 0;
  for (let round = 0; round < 3000; round++) {
    const id = number * 100000 + round;
    const members = ['"id":' + id, '"name":"name ' + id + ' that is longer than a short string would be"', '"tags":["t' + (round % 9) + '","' + id + '"]', '"inner":{"a":' + round + (round % 2 ? ',"b":"b"' : "") + (round % 5 ? "" : ',"x":[' + id + "]") + "}"];
    if (round % 3 === 0) members.splice(round % 4, 0, '"extra' + (round % 11) + '":{"e":' + id + "}");
    if (round % 7 === 0) members.reverse();
    const text = "{" + members.join(",") + "}";
    const value = JSON.parse(text) as Item;
    if (value.id !== id || value.inner.a !== round || JSON.stringify(value) !== text) different++;
  }
  return wrong + " answers are neither the value nor a RangeError, " + (values > 0 ? "some" : "NO") + " values, " + different + " of 3000 records differ";
}
//// json-parse-type-argument-in-workers-that-are-ended/main.ts
// Workers are ended from outside in the middle of `JSON.parse(text) as T` and JSON.stringify of large texts, forty times at other moments; the main thread goes on parsing. start.ts is the program; this file is what each Worker runs.
import { parentPort } from "node:worker_threads";
import { rows, work } from "./work";

const text = rows(60000);
parentPort!.postMessage("ready");
for (;;) work(text);
//// json-parse-type-argument-in-workers-that-are-ended/start.ts
import { Worker } from "node:worker_threads";
import { rows, work } from "./work";

const small = rows(500);
let ended = 0;
let wrong = 0;
for (let turn = 0; turn < 40; turn++) {
  const worker = new Worker("./main.ts");
  await new Promise<void>(resolve => worker.once("message", () => resolve()));
  await new Promise<void>(resolve => setTimeout(resolve, (turn * 7) % 60));
  if (work(small) !== 500) wrong++;
  await worker.terminate();
  ended++;
  if (work(small) !== 500) wrong++;
}
console.log(ended + " Workers ended, " + wrong + " wrong answers on the main thread");
//// json-parse-type-argument-in-workers-that-are-ended/work.ts
type Row = { id: number; name: string; tags: string[]; inner: { a: number; b?: string } };

export function rows(count: number): string {
  const items: string[] = [];
  for (let at = 0; at < count; at++) items.push('{"id":' + at + ',"name":"name ' + at + ' that is longer than a short string would be","u' + (at % 700) + '":[' + at + '],"tags":["t","' + at + '"],"inner":{"a":' + at + (at % 2 ? ',"b":"b"' : "") + "}}");
  return "[" + items.join(",") + "]";
}

export function work(text: string): number {
  const parsed = JSON.parse(text) as Row[];
  const written = JSON.stringify(parsed);
  return written.length === text.length ? parsed.length : -1;
}
//// json-parse-type-argument-keys-in-every-order.ts
// The declared keys of an object come in every order, with and without white space, again and again. The result is what JSON.parse(text) gives.
interface Point { x: number; y: number; label?: string }
interface Four { a: number; b: string; c: boolean; d?: number | null }
interface FirstThenSecond { first: number; second: number }
interface SecondThenFirst { second: number; first: number }
interface Thirteen { k0: number; k1: number; k2: number; k3: number; k4: number; k5: number; k6: number; k7: number; k8: number; k9: number; k10: number; k11: number; k12: number }
interface Fourteen extends Thirteen { k13: number }
interface Holder { id: number; points: Point[]; last: Point; four?: Four }
interface AllOptional { p?: number; q?: number }

function show(value: any): string {
  if (Array.isArray(value)) return "[" + value.map(show).join(",") + "]";
  if (typeof value !== "object" || value === null) return Object.is(value, -0) ? "-0" : typeof value + ":" + String(value);
  const inLoop: string[] = [];
  for (const key in value) inLoop.push(key);
  return "{" + Object.getOwnPropertyNames(value).map(key => JSON.stringify(key) + "=" + show(value[key])).join(",") + "|" + inLoop.join() + "|" + Object.keys(value).join() + "|" + JSON.stringify(value) + "}";
}

////= attempt-2

function check(label: string, texts: string[], parse: (text: string) => unknown, then?: (value: any) => void, plainly: (text: string) => unknown = globalThis.JSON.parse): void {
  let different = 0;
  for (let round = 0; round < 5; round++) {
    for (const text of texts) {
      const typed = attempt(parse, text, then);
      const plain = attempt(plainly, text, then);
      if (typed !== plain && different++ < 3) console.log(label + " DIFFERS on " + text + "\n  " + typed + "\n  " + plain);
    }
  }
  console.log(label + ": " + texts.length + " texts, " + different + " differ");
}

function orders<T>(items: T[]): T[][] {
  if (items.length < 2) return [items];
  return items.flatMap((item, at) => orders([...items.slice(0, at), ...items.slice(at + 1)]).map(rest => [item, ...rest]));
}

const asObject = (members: string[]) => "{" + members.join(",") + "}";
const spaced = (members: string[]) => "{ " + members.map(member => member.replace(":", ": ")).join(", ") + " }";
const onLines = (members: string[]) => "{\n" + members.map(member => "\t" + member.replace(":", " :\r\n ")).join(" ,\n") + "\n}";
const point = (text: string) => JSON.parse(text) as Point;
const four = (text: string) => JSON.parse(text) as Four;

const ofFour = ['"a":1', '"b":"two"', '"c":true', '"d":null'];
check("every order of four", orders(ofFour).map(asObject), four);
check("every order of three of four", orders(ofFour.slice(0, 3)).map(asObject), four);
check("every order of four, spaced", orders(ofFour).map(spaced), four);
check("every order of four, on lines", orders(ofFour).map(onLines), four);
check("one is missing", orders(ofFour.slice(1)).map(asObject), four);
check("one is wrong", orders(['"a":"1"', '"b":"two"', '"c":true']).map(asObject), four);
check("one comes twice", orders(['"a":1', '"b":"two"', '"c":true', '"a":4']).map(asObject), four);
check("the optional one comes twice", orders(['"a":1', '"b":"two"', '"c":true', '"d":4', '"d":null']).map(asObject), four);

check("with and without an undeclared key, in turn", [
  '{"x":1,"y":2}', '{"o":1,"x":1,"y":2}', '{ "x": 1, "y": 2 }', '{"y":2,"x":1}', '{"o":1,"y":2,"x":1}', '{"y":2,"o":1,"x":1}', '{"y":2,"x":1,"o":1}', '{"y":2,"x":1}',
  '{"label":"l","y":2,"x":1}', '{"label":"l","o":1,"y":2,"x":1}', '{"label":"l","y":2,"x":1}', '{"y":2,"label":"l","x":1}', '{"0":1,"y":2,"x":1}', '{"y":2,"x":1,"__proto__":null}', '{"y":2,"x":1}',
], point);

const pairs = ['{"first":1,"second":2}', '{"second":2,"first":1}', '{ "first": 1, "second": 2 }', '{ "second": 2, "first": 1 }'];
check("two types of the same members, the one", pairs, text => JSON.parse(text) as FirstThenSecond);
check("two types of the same members, the other", pairs, text => JSON.parse(text) as SecondThenFirst);
check("two types of the same members, in turn", pairs, text => [JSON.parse(text) as FirstThenSecond, JSON.parse(text) as SecondThenFirst, JSON.parse(text) as FirstThenSecond], undefined, text => [globalThis.JSON.parse(text), globalThis.JSON.parse(text), globalThis.JSON.parse(text)]);

const numbered = (count: number) => Array.from({ length: count }, (_, i) => `"k${i}":${i}`);
const turns = (members: string[]) => members.map((_, at) => [...members.slice(at), ...members.slice(0, at)]).flatMap(turned => [turned, [...turned].reverse()]);
check("thirteen members", turns(numbered(13)).map(asObject), text => JSON.parse(text) as Thirteen);
check("fourteen members", turns(numbered(14)).map(asObject), text => JSON.parse(text) as Fourteen);
check("thirteen members and one more key", turns(numbered(14)).map(asObject), text => JSON.parse(text) as Thirteen);
check("none, one or both of two optional members", ["{}", "{ }", '{"p":1}', '{"q":1}', '{"p":1,"q":2}', '{"q":2,"p":1}', '{"o":0}'], text => JSON.parse(text) as AllOptional);

const inner = ['{"x":1,"y":2}', '{"y":2,"x":1}', '{"label":"l","x":1,"y":2}', '{ "y": 2, "label": "l", "x": 1 }'];
check("objects within objects", orders(['"id":1', `"points":[${inner.join(",")}]`, `"last":${inner[1]}`, `"four":${asObject([...ofFour].reverse())}`]).flatMap(members => [asObject(members), spaced(members)]), text => JSON.parse(text) as Holder);

const changes: [string, (value: any) => void][] = [
  ["a member is deleted and written again", value => { delete value.x; value.x = 5; }],
  ["the optional member is written", value => { value.label = "late"; }],
  ["another key is written", value => { value.o = 1; }],
  ["a member is written", value => { value.y = 7; }],
  ["frozen", value => { Object.freeze(value); }],
];
for (const [label, change] of changes) check("afterwards: " + label, ['{"x":1,"y":2}', '{"y":2,"x":1}', '{"y":2,"label":"l","x":1}', '{ "x": 1, "y": 2 }'], point, change);

const kept: Four[] = [];
const texts: string[] = [];
const all = orders(ofFour);
for (let i = 0; i < 4000; i++) {
  const text = (i % 3 ? asObject : spaced)(all[i % all.length].map(member => member.replace('"two"', '"' + "t".repeat(i % 40) + '"').replace(":1", ":" + i)));
  texts.push(text);
  kept.push(JSON.parse(text) as Four);
}
let changed = 0;
for (let i = 0; i < kept.length; i++) changed += Number(show(kept[i]) !== show(globalThis.JSON.parse(texts[i])));
console.log("kept for a while: " + kept.length + " objects, " + changed + " differ");
//// json-parse-type-argument-long-runs-of-undeclared-members.ts
// Runs of 1 to 130 undeclared members in a row, all with fresh values, in front of, between and behind the declared ones; each text is parsed five times.
const host: any = globalThis;
const collect: () => void = host.Bun ? () => host.Bun.gc(true) : host.gc;
let serial = 0;
function longText(): string {
  return '"text number ' + ++serial + ' is too long for a cache of short strings"';
}
////= freshValue

type Item = { id: number; name: string };
const kept: { value: Item; text: string }[] = [];
for (const length of [1, 2, 3, 4, 5, 8, 15, 16, 17, 30, 31, 32, 33, 34, 63, 64, 65, 66, 95, 96, 97, 128, 130]) {
  let different = 0;
  for (let place = 0; place < 4; place++) {
    const run: string[] = [];
    for (let at = 0; at < length; at++) run.push('"r' + at + '":' + (place === 3 ? String(at) : freshValue(at)));
    const members = place === 0 ? ['"id":1', '"name":' + longText(), ...run] : place === 1 ? [...run, '"id":1', '"name":' + longText()] : ['"id":1', ...run, '"name":' + longText()];
    const text = "{" + members.join(",") + "}";
    for (let round = 0; round < 5; round++) {
      const value = JSON.parse(text) as Item;
      if (value.id !== 1 || value.name.length < 40 || JSON.stringify(value) !== text) different++;
      if (round === 4) kept.push({ value, text });
    }
  }
  for (const entry of kept) if (JSON.stringify(entry.value) !== entry.text) different++;
  console.log("runs of " + length + ": " + different + " differ");
}
//// json-parse-type-argument-long-things-learned-then-short-texts.ts
// Long keys, tags, constants and strings are learned by every table of the parsers; then short texts that begin alike, and every cut of the long ones, are parsed: nothing may be read behind the text.
type Point = { x: number; y: number };
type LongKeys = { aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa: number; aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab: number; : number; aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa?: number; short: number };
type LongConstant = { level: "llllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllll" | "lllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllm" | "lllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllll"; n: number };
type LongTags = { kind: "llllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllll"; a: number } | { kind: "lllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllm"; b: number } | { kind: "lllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllll"; c: number };
type Words = { words: string[] };

const plainParse: (text: string) => any = globalThis.JSON.parse;
let different = 0;
let texts = 0;
function ask(parse: (text: string) => unknown, text: string): void {
  texts++;
  let typed = "";
  let plain = "";
  try {
    typed = JSON.stringify(parse(text));
  } catch (error: any) {
    typed = error.name + ": " + error.message;
  }
  try {
    plain = JSON.stringify(plainParse(text));
  } catch (error: any) {
    plain = error.name + ": " + error.message;
  }
  if (typed !== plain) {
    if (different++ < 10) console.log("DIFFERENT on " + text.slice(0, 200) + "\n  " + typed.slice(0, 200) + "\n  " + plain.slice(0, 200));
  }
}
function told(label: string): void {
  console.log(label + ": " + texts + " texts: " + different + " differ");
  texts = 0;
  different = 0;
}
const lengths = [1, 2, 3, 5, 6, 7, 8, 9, 10, 14, 15, 16, 17, 22, 23, 24, 25, 30, 31, 32, 33, 34, 46, 47, 48, 49, 50, 51, 52, 54, 55, 56, 57, 58, 60, 61, 62, 63, 64, 65, 66, 70, 71, 72, 73, 100, 127, 128, 129, 200, 255, 256, 257, 300, 1000, 5000, 70000];
const annotated = (text: string): unknown => {
  const point: Point = globalThis.JSON.parse(text);
  return point;
};
const cast = (text: string): unknown => globalThis.JSON.parse(text) as Point;

const roads: [string, (text: string) => unknown, (long: string) => string][] = [
  ["an undeclared key behind", text => JSON.parse(text) as Point, long => '{"x":1,"y":2,"' + long + '":1}'],
  ["an undeclared key in front", text => JSON.parse(text) as Point, long => '{"' + long + '":1,"x":1,"y":2}'],
  ["two undeclared keys", text => JSON.parse(text) as Point, long => '{"x":1,"' + long + '":1,"y":2,"' + long + 'b":"' + long + '"}'],
  ["a key of a dictionary", text => JSON.parse(text) as Record<string, number>, long => '{"' + long + '":1,"' + long + 'b":2}'],
  ["a string", text => JSON.parse(text) as Words, long => '{"words":["' + long + '","' + long + '"]}'],
  ["an undeclared string", text => JSON.parse(text) as Point, long => '{"x":1,"y":2,"u":"' + long + '"}'],
  ["under unknown", text => JSON.parse(text) as { v: unknown }, long => '{"v":{"' + long + '":"' + long + '"}}'],
  ["no type", plainParse, long => '{"x":1,"y":2,"' + long + '":"' + long + '"}'],
  ["an annotated variable", annotated, long => '{"x":1,"y":2,"' + long + '":"' + long + '"}'],
  ["a cast", cast, long => '{"x":1,"' + long + '":1,"y":2}'],
];
const only = Number((globalThis as any).arguments?.[0] ?? -1);
for (const [label, parse, wrap] of roads) {
  if (only >= 0 && roads[only]?.[0] !== label) continue;
  for (const character of ["k", "\u00e9"]) {
    for (const length of lengths) {
      const long = wrap(character.repeat(length));
      for (let round = 0; round < 20; round++) parse(long);
      for (const shorter of lengths) {
        if (shorter >= length) break;
        const short = wrap(character.repeat(shorter));
        ask(parse, short);
        ask(parse, short.slice(0, -1));
        ask(parse, short.slice(0, short.lastIndexOf('"')));
        ask(parse, short.slice(0, short.lastIndexOf('"') + 1));
        ask(parse, (short + "\u0100").slice(0, -1));
        parse(long);
      }
      if (length <= 300) for (let cut = long.length; cut > 0; cut--) ask(parse, long.slice(0, cut));
    }
  }
  told(label);
}

if (only < 0 || only === 10) {
const declared = ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab", "", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "short"];
const whole = "{" + declared.map((name, at) => '"' + name + '":' + at).join(",") + "}";
for (let round = 0; round < 20; round++) (JSON.parse(whole) as LongKeys);
for (let cut = whole.length; cut >= 0; cut--) ask(text => JSON.parse(text) as LongKeys, whole.slice(0, cut));
for (const name of declared) for (let cut = name.length; cut >= 0; cut--) for (const tail of ['":1}', '":1', '"', "", 'x":1}']) ask(text => JSON.parse(text) as LongKeys, '{"' + name.slice(0, cut) + tail);
for (const name of declared) for (let cut = name.length; cut >= 0; cut--) ask(text => JSON.parse(text) as LongKeys, '{"short":1,"' + name.slice(0, cut) + '":2,"' + name.slice(0, cut));
told("long declared keys");
}

const levels = ["llllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllll", "lllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllm", "lllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllll"];
if (only < 0 || only === 11) {
for (const level of levels) {
  for (let round = 0; round < 20; round++) (JSON.parse('{"level":"' + level + '","n":1}') as LongConstant);
  for (let cut = level.length; cut >= 0; cut--) for (const tail of ['","n":1}', '"', "", 'x","n":1}', "\\"]) ask(text => JSON.parse(text) as LongConstant, '{"level":"' + level.slice(0, cut) + tail);
  for (let cut = level.length; cut >= 0; cut--) ask(text => JSON.parse(text) as LongConstant, '{"n":1,"level":"' + level.slice(0, cut));
}
told("long constants");
}
if (only < 0 || only === 12) {
for (const [tag, member] of [[levels[0], "a"], [levels[1], "b"], [levels[2], "c"]]) {
  for (let round = 0; round < 20; round++) (JSON.parse('{"kind":"' + tag + '","' + member + '":1}') as LongTags);
  for (let cut = tag.length; cut >= 0; cut--) for (const tail of ['","' + member + '":1}', '"', "", "\\"]) {
    ask(text => JSON.parse(text) as LongTags, '{"kind":"' + tag.slice(0, cut) + tail);
    ask(text => JSON.parse(text) as LongTags, '{"' + member + '":1,"kind":"' + tag.slice(0, cut) + tail);
  }
}
told("long tags");
}
//// json-parse-type-argument-many-sets-of-undeclared-keys.ts
// 300 sets of ten undeclared keys come in turn, each twice, then all again: the tables that remember them grow and are emptied while they are in use.
const host: any = globalThis;
const collect: () => void = host.Bun ? () => host.Bun.gc(true) : host.gc;
let serial = 0;
function longText(): string {
  return '"text number ' + ++serial + ' is too long for a cache of short strings"';
}
////= freshValue

type Item = { id: number; name: string };
const texts: string[] = [];
for (let set = 0; set < 300; set++) {
  const members = ['"id":' + set];
  for (let at = 0; at < 10; at++) members.push('"s' + (set * 7 + at * 13) % 601 + "x" + at + '":' + freshValue(at + set));
  members.push('"name":' + longText());
  texts.push("{" + members.join(",") + "}");
}
const kept: Item[] = [];
for (let pass = 0; pass < 3; pass++) {
  let different = 0;
  for (let set = 0; set < texts.length; set++) {
    for (let twice = 0; twice < 2; twice++) {
      const value = JSON.parse(texts[set]) as Item;
      if (value.id !== set || JSON.stringify(value) !== texts[set]) different++;
      if (pass === 0 && twice === 0) kept.push(value);
    }
  }
  for (let set = 0; set < texts.length; set++) if (JSON.stringify(kept[set]) !== texts[set]) different++;
  console.log("pass " + pass + ": " + different + " differ");
}
//// json-parse-type-argument-many-undeclared-keys.ts
type Point = { x: number; y: number };

function undeclaredMembers(prefix: string, count: number): string {
  const members: string[] = [];
  for (let at = 0; at < count; at++) members.push('"' + prefix + at + '":' + at);
  return members.join(",");
}

function compare(label: string, text: string): string {
  const typed = JSON.parse(text) as Point;
  const plain = globalThis.JSON.parse(text);
  const typedKeys = Object.keys(typed);
  const plainKeys = Object.keys(plain);
  let at = 0;
  while (at < plainKeys.length && typedKeys[at] === plainKeys[at]) at++;
  if (at !== plainKeys.length || typedKeys.length !== plainKeys.length) return label + ": keys differ from place " + at + ": " + typedKeys.slice(at, at + 3).join() + " for " + plainKeys.slice(at, at + 3).join();
  if (JSON.stringify(typed) !== JSON.stringify(plain)) return label + ": written differently";
  return typed.x + typed.y === 3 ? "" : label + ": wrong members";
}

const counts = [1, 2, 31, 32, 33, 63, 64, 65, 127, 128, 129, 130, 131, 132, 133, 200, 513, 1000, 4097, 30000, 32765, 32766, 32767, 32768, 32769, 40000];
let differences = 0;
for (const count of counts) {
  const run = undeclaredMembers("k", count);
  const third = Math.min(count, 20000);
  const texts: [string, string][] = [
    ["in front", "{" + run + ',"x":1,"y":2}'],
    ["between", '{"x":1,' + run + ',"y":2}'],
    ["behind", '{"x":1,"y":2,' + run + "}"],
    ["between and one behind", '{"x":1,' + run + ',"y":2,"m0":0}'],
    ["in front, between and behind", "{" + undeclaredMembers("k", third) + ',"x":1,' + undeclaredMembers("l", third) + ',"y":2,' + undeclaredMembers("m", third) + "}"],
    ["one in front, between", '{"a":0,"x":1,' + run + ',"y":2}'],
  ];
  for (const [label, text] of texts) {
    const difference = compare(count + " undeclared keys " + label, text);
    if (difference) {
      differences++;
      console.log(difference);
    }
  }
}
console.log(differences + " of " + counts.length * 6 + " texts differ from JSON.parse without a type");
//// json-parse-type-argument-minus-zero.ts
// -0 under the constant type 0: the result holds what the text says, as JSON.parse(text) does.
type Zero = { n: 0 };
type Bit = { n: 0 | 1 };
type Sized = { n: 0 | "none"; size?: 0 };
type Any = { n: number };
const sign = (value: unknown) => (Object.is(value, -0) ? "-0" : String(value));
for (const spelled of ["-0", "-0.0", "-0e5", "-0E-5", "-1e-400", "0", "0.0", "0e5", "1e-400"]) {
  console.log(
    spelled,
    sign((JSON.parse(`{"n":${spelled}}`) as Zero).n),
    sign((JSON.parse(`{ "n" : ${spelled} }`) as Zero).n),
    sign((JSON.parse(`{"o":1,"n":${spelled}}`) as Zero).n),
    sign((JSON.parse(`{"\\u006e":${spelled}}`) as Zero).n),
    sign((JSON.parse(`{"n":${spelled}}`) as Bit).n),
    sign((JSON.parse(`{"n":${spelled},"size":${spelled}}`) as Sized).size),
    sign((JSON.parse(`{"size":${spelled},"n":${spelled}}`) as Sized).n),
    sign((JSON.parse(`{"n":${spelled}}`) as Any).n),
    sign(JSON.parse(spelled) as 0),
    sign(JSON.parse(spelled) as 0 | 1),
    sign((JSON.parse(`[${spelled}]`) as [0 | 1])[0]),
    sign((JSON.parse(`[${spelled}, ${spelled}]`) as [0, 0])[1]),
    sign((JSON.parse(`[1,${spelled}]`) as (0 | 1)[])[1]),
    sign((JSON.parse(`{"k":${spelled}}`) as Record<string, 0>).k),
    1 / (JSON.parse(`{"n":${spelled}}`) as Zero).n,
    JSON.stringify(JSON.parse(`{"n":${spelled}}`) as Zero),
  );
}
console.log(sign((JSON.parse('{"n":1}') as Bit).n), sign((JSON.parse('{"n":-1}') as { n: -1 | 0 }).n), sign((JSON.parse('{"n":1.5}') as { n: 1.5 }).n));
//// json-parse-type-argument-minus-zero-under-an-enum.ts
// -0 where the type is a numeric enum member whose value is 0: the result holds what the text or the value says, and so does a number that is no member.
enum Color { Red, Green }
interface Painted { color: Color }
type Tagged = { kind: Color.Red; r: number } | { kind: Color.Green; g: string };
////= say-3	
const signOf = (value: number): string => (Object.is(value, -0) ? "-0" : String(value));
for (const zero of ["-0", "-0.0", "-0e1", "0", "0.0"]) {
  console.log(zero + " under a member", say(() => (JSON.parse('{"color":' + zero + "}") as Painted).color === Color.Red));
  console.log(zero + " behind white space", say(() => (JSON.parse('{ "color" : ' + zero + " }") as Painted).color + 1));
  console.log(zero + " at the root", say(() => (JSON.parse(zero) as Color) + 1));
  console.log(zero + " in a list", say(() => (JSON.parse("[1," + zero + "]") as Color[]).map(color => color + 1)));
  console.log(zero + " as a tag", say(() => JSON.parse('{"kind":' + zero + ',"r":1}') as Tagged));
  console.log(zero + " as a tag that comes last", say(() => JSON.parse('{"r":1,"kind":' + zero + "}") as Tagged));
  console.log(zero + " in a text that is no JSON further on", say(() => JSON.parse('[{"kind":' + zero + ',"r":1},{"kind":1.}]') as Tagged[]));
  console.log(zero + " keeps its sign", say(() => [(JSON.parse('{"color":' + zero + "}") as Painted).color, JSON.parse(zero) as Color, (JSON.parse("[1," + zero + "]") as Color[])[1]!, (JSON.parse('{"kind":' + zero + ',"r":1}') as Tagged).kind].map(signOf)));
}
console.log("a value", say(() => ({ color: -0 } as Painted).color + 1));
console.log("a value in a list", say(() => ([-0, 1] as Color[]).map(color => color + 1)));
console.log("a value keeps its sign", say(() => [({ color: -0 } as Painted).color, ([-0, 1] as Color[])[0]!].map(signOf)));
console.log("no member", say(() => JSON.parse('{"color":-1}') as Painted));

interface Holder { color: Color; colors: Color[]; pair: [Color, number]; byName: Record<string, Color>; maybe?: Color }
const total = (holder: Holder) => holder.color + holder.colors[0]! + holder.pair[0] + holder.byName.a! + (holder.maybe ?? 0) + 1;
const signsOf = (holder: Holder) => [holder.color, holder.colors[0]!, holder.pair[0], holder.byName.a!].map(signOf);
const holders = ['{"color":-0,"colors":[-0,1],"pair":[-0,1],"byName":{"a":-0},"maybe":-0}', '{"color":-0,"colors":[-0,1],"pair":[-0,1],"byName":{"a":-0}}'];
for (const text of holders) {
  console.log("every kind of holder", say(() => total(JSON.parse(text) as Holder)));
  console.log("with an escape in a key", say(() => total(JSON.parse(text.replace("colors", "\\u0063olors")) as Holder)));
  console.log("with a reviver", say(() => total(JSON.parse(text, (_, value) => value) as Holder)));
  console.log("the signs", say(() => [signsOf(JSON.parse(text) as Holder), signsOf(JSON.parse(text, (_, value) => value) as Holder)]));
  console.log("written again", say(() => JSON.parse(text) as Holder));
}
const values: unknown[] = [{ color: -0 }, [-0, 1], [-0, 2], { a: -0 }];
console.log("an object made elsewhere", say(() => (values[0] as Painted).color + 1));
console.log("a list made elsewhere", say(() => (values[1] as Color[]).map(color => color + 1)));
console.log("a tuple made elsewhere", say(() => (values[2] as [Color, number])[0] + 1));
console.log("a dictionary made elsewhere", say(() => (values[3] as Record<string, Color>).a! + 1));
console.log("the values are as they were", Object.is((values[0] as Painted).color, -0), Object.is((values[1] as number[])[0], -0), Object.is((values[2] as number[])[0], -0));
//// json-parse-type-argument-mutated-texts.ts
// A fuzzer of texts, the same for a given seed: texts are generated to fit seventeen types, then changed (characters replaced, tokens cut, swapped and doubled, white space and escapes put in, nesting multiplied, 16-bit text, ropes). `JSON.parse(text) as T` throws the SyntaxError that JSON.parse throws, or gives the value that JSON.parse gives.

const seed: number = 1;
const rounds: number = 400;

type Point = { x: number; y: number };
type User = { id: number; name: string; email?: string; tags: string[]; active: boolean; note: string | null };
type Shape = { kind: "circle"; radius: number } | { kind: "square"; side: number; label?: string } | { kind: "path"; points: Point[] };
type Mixed = string | number | boolean | null | { v: number } | number[];
type Triple = [string, number, Point];
type Table = Record<string, number>;
type Points = Record<string, Point>;
type Grid = number[][];
type Tree = { name: string; kids: Tree[] };
type Chain = { value: number; next: Chain | null };
type Loose = { id: number; data: unknown; more: any; bag: Record<string, any> };
type Indexed = { id: number; [key: string]: number | string };
type Literals = { level: "low" | "high" | "é"; code: 1 | 2 | 3; on: true; nothing: null; either: "a" | 7 | false };
////= Wide
type Nested = { a: { b: { c: { d: Point[]; e: [number, string] }; f?: Shape }; g: Table }; h: User[] };

let state = seed >>> 0;
////= random
const below = (limit: number): number => Math.floor(random() * limit);
const chance = (probability: number): boolean => random() < probability;
const choice = <T>(from: readonly T[]): T => from[below(from.length)];

type Make = (depth: number) => string;
const characters = ["a", "b", "z", "A", "0", "9", " ", "-", "_", ".", "/", "é", "ÿ", "Ā", "日", "😀", "\\n", "\\t", '\\"', "\\\\", "\\/", "\\u0041", "\\u00e9", "\\u65e5", "\\ud83d\\ude00", "\\ud800", "\\u0000", "\u007f", " "];
const plainCharacters = ["a", "b", "c", "x", "y", "z", "k"];
////= stringOf
const text: Make = () => (chance(0.6) ? stringOf(below(6), plainCharacters) : chance(0.8) ? stringOf(below(12), characters) : stringOf(20 + below(120), chance(0.5) ? plainCharacters : characters));
const integers = ["0", "1", "2", "3", "7", "10", "42", "255", "999", "1000", "65536", "2147483647", "2147483648", "4294967296", "9007199254740991", "-1", "-7", "-2147483648", "-2147483649"];
const fractions = ["0.5", "-0.5", "1.25", "3.14159", "1e3", "1E3", "1e+3", "1e-3", "-1.5e10", "1.7976931348623157e308", "5e-324", "0.1", "123456789.123456789", "1e21", "12345678901234567890", "-0", "0.0", "1.0", "100e-2"];
const integer: Make = () => (chance(0.7) ? choice(integers) : String(below(100000) - 50000));
const number: Make = depth => (chance(0.6) ? integer(depth) : chance(0.8) ? choice(fractions) : (below(2000000) - 1000000) / 1000 + (chance(0.3) ? "e" + (below(40) - 20) : ""));
const flag: Make = () => (chance(0.5) ? "true" : "false");
const nothing: Make = () => "null";
const constant = (...spellings: string[]): Make => () => choice(spellings);
const either = (...makes: Make[]): Make => depth => choice(makes)(depth);
////= list
const tuple = (...items: Make[]): Make => depth => "[" + items.map(item => item(depth + 1)).join(",") + "]";
const keys = ['"k"', '"key"', '"x"', '"y"', '"id"', '"name"', '"kind"', '""', '"0"', '"1"', '"42"', '"-1"', '"a b"', '"é"', '"日本"', '"__proto__"', '"constructor"', '"toString"', '"length"', '"\\u006b"', '"k\\n"', '"a key that is longer than the short ones by far, so that no cache takes it"'];
////= anything
////= dictionary	7) ? choice(keys
////= shuffle
////= record

const point = record([["x", number], ["y", number]]);
const user = record([["id", integer], ["name", text], ["email", text, true], ["tags", list(text)], ["active", flag], ["note", either(text, nothing)]]);
const shape = either(record([["kind", constant('"circle"')], ["radius", number]]), record([["kind", constant('"square"')], ["side", number], ["label", text, true]]), record([["kind", constant('"path"')], ["points", list(point)]]));
const tree: Make = depth => record([["name", text], ["kids", list(tree, 0, depth > 3 ? 0 : 3)]])(depth);
const chain: Make = depth => record([["value", number], ["next", depth > 8 || chance(0.3) ? nothing : chain]])(depth);
const wideMembers: [string, Make, boolean?][] = [];
for (const row of ["a", "b", "c", "d"]) {
  const makes: [Make, boolean?][] = [[number], [text], [flag], [number, true], [either(text, nothing)], [list(number)], [point], [text, true], [number], [text]];
  makes.slice(0, row === "d" ? 5 : 10).forEach(([make, isOptional], at) => wideMembers.push([row + at, make, isOptional]));
}

const types: [string, (text: string) => unknown, Make][] = [
  ["Point", text => JSON.parse(text) as Point, point],
  ["User", text => JSON.parse(text) as User, user],
  ["Shape", text => JSON.parse(text) as Shape, shape],
  ["Shape[]", text => JSON.parse(text) as Shape[], list(shape, 0, 6)],
  ["Mixed", text => JSON.parse(text) as Mixed, either(text, number, flag, nothing, record([["v", number]]), list(number))],
  ["Mixed[]", text => JSON.parse(text) as Mixed[], list(either(text, number, flag, nothing, record([["v", number]]), list(number)), 0, 8)],
  ["Triple", text => JSON.parse(text) as Triple, tuple(text, number, point)],
  ["Table", text => JSON.parse(text) as Table, dictionary(number, 8)],
  ["Points", text => JSON.parse(text) as Points, dictionary(point)],
  ["Grid", text => JSON.parse(text) as Grid, list(list(number))],
  ["Tree", text => JSON.parse(text) as Tree, tree],
  ["Chain", text => JSON.parse(text) as Chain, chain],
  ["Loose", text => JSON.parse(text) as Loose, record([["id", number], ["data", anything], ["more", anything], ["bag", dictionary(anything)]])],
  ["Indexed", text => JSON.parse(text) as Indexed, record([["id", number]], either(number, text))],
  ["Literals", text => JSON.parse(text) as Literals, record([["level", constant('"low"', '"high"', '"é"', '"\\u00e9"', '"lo\\u0077"')], ["code", constant("1", "2", "3", "1.0", "2e0", "30e-1")], ["on", constant("true")], ["nothing", nothing], ["either", constant('"a"', "7", "false", "7.0")]])],
  ["Wide", text => JSON.parse(text) as Wide, record(wideMembers)],
  ["Nested", text => JSON.parse(text) as Nested, record([["a", record([["b", record([["c", record([["d", list(point)], ["e", tuple(number, text)]])], ["f", shape, true]])], ["g", dictionary(number)]])], ["h", list(user, 0, 3)]])],
];

////= tokens

const intruders = ["\u0000", '"', "\\", "{", "}", "[", "]", ",", ":", " ", "\n", "\t", "\r", "0", "1", "9", "-", "+", ".", "e", "E", "n", "t", "f", "u", "a", "/", "'", "\u001f", "\u007f", " ", "ÿ", "Ā", " ", "﻿", "\ud800", "\udc00", "null", "true", "false", "nul", "tru", "1e400", "-0", "{}", "[]", '""', '"\\u0000"', "\\u", "\\u00", "\\ud800"];
const spaces = [" ", "\n", "\t", "\r", "  ", " \n\t\r "];

////= mutate

////= represent

const plainParse: (text: string) => any = globalThis.JSON.parse;

////= show

////= deepest

let reported = 0;
function report(what: string, type: string, text: string, typed: string, plain: string): void {
  if (reported++ < 20) console.log(what + " " + type + " seed " + seed + " on " + JSON.stringify(text).slice(0, 600) + "\n  typed: " + typed.slice(0, 400) + "\n  plain: " + plain.slice(0, 400));
}

for (const [label, parse, make] of types) {
  let accepted = 0;
  let syntaxErrors = 0;
  let different = 0;
  let texts = 0;
  for (let round = 0; round < rounds; round++) {
    const valid = make(0);
    for (let turn = 0; turn < 6; turn++) {
      const text = represent(turn === 0 ? valid : mutate(valid));
      if (deepest(text) > 1500) continue;
      texts++;
      let typed = "";
      let plain = "";
      let typedValue: unknown;
      let plainValue: unknown;
      const start = Date.now();
      try {
        typedValue = parse(text);
        typed = show(typedValue);
      } catch (error: any) {
        typed = error.name + ": " + error.message;
      }
      if (Date.now() - start > 30000) report("SLOW", label, text, typed, "");
      try {
        plainValue = plainParse(text);
        plain = show(plainValue);
      } catch (error: any) {
        plain = error.name + ": " + error.message;
      }
      if (typed !== plain) {
        different++;
        report("DIFFERENT", label, text, typed, plain);
      } else if (plain.startsWith("SyntaxError")) syntaxErrors++;
      else {
        accepted++;
        if (JSON.stringify(typedValue) !== JSON.stringify(plainValue)) {
          different++;
          report("WRITTEN DIFFERENTLY", label, text, String(JSON.stringify(typedValue)), String(JSON.stringify(plainValue)));
        }
      }
    }
  }
  console.log(label + ": " + texts + " texts: " + accepted + " accepted, " + syntaxErrors + " no JSON: " + different + " differ");
}
//// json-parse-type-argument-mutated-texts-against-what-is-learned.ts
// A fuzzer of texts, the same for a given seed, that is after the tables which the parser, the writer and the conversions learn: keys that are long, that share their first bytes, that come again, thousands of names, tens of thousands of orders, and now and then thousands of records with names of their own inside one text. Each text is parsed by `JSON.parse(text) as T`, written by JSON.stringify and compared with JSON.parse; values are kept and written again later.

const seed: number = 1;
const rounds: number = 20;

type Point = { x: number; y: number };
type User = { id: number; name: string; email?: string; tags: string[]; active: boolean; note: string | null };
type Shape = { kind: "circle"; radius: number } | { kind: "square"; side: number; label?: string } | { kind: "path"; points: Point[] };
type Mixed = string | number | boolean | null | { v: number } | number[];
type Triple = [string, number, Point];
type Table = Record<string, number>;
type Points = Record<string, Point>;
type Grid = number[][];
type Tree = { name: string; kids: Tree[] };
type Chain = { value: number; next: Chain | null };
type Loose = { id: number; data: unknown; more: any; bag: Record<string, any> };
type Indexed = { id: number; [key: string]: number | string };
type Literals = { level: "low" | "high" | "é"; code: 1 | 2 | 3; on: true; nothing: null; either: "a" | 7 | false };
////= Wide
type Nested = { a: { b: { c: { d: Point[]; e: [number, string] }; f?: Shape }; g: Table }; h: User[] };
type Item = { id: number };
type Holder = { first: number; items: Item[]; last: string };
type Shelf = { label: string; holders: Holder[]; byName: Record<string, Item>; pair: [Item, Point] };

let state = seed >>> 0;
////= random
const below = (limit: number): number => Math.floor(random() * limit);
const chance = (probability: number): boolean => random() < probability;
const choice = <T>(from: readonly T[]): T => from[below(from.length)];

type Make = (depth: number) => string;
const characters = ["a", "b", "z", "A", "0", "9", " ", "-", "_", ".", "/", "é", "ÿ", "Ā", "日", "😀", "\\n", "\\t", '\\"', "\\\\", "\\/", "\\u0041", "\\u00e9", "\\u65e5", "\\ud83d\\ude00", "\\ud800", "\\u0000", "\u007f", " "];
const plainCharacters = ["a", "b", "c", "x", "y", "z", "k"];
////= stringOf
const text: Make = () => (chance(0.6) ? stringOf(below(6), plainCharacters) : chance(0.8) ? stringOf(below(12), characters) : stringOf(20 + below(120), chance(0.5) ? plainCharacters : characters));
const integers = ["0", "1", "2", "3", "7", "10", "42", "255", "999", "1000", "65536", "2147483647", "2147483648", "4294967296", "9007199254740991", "-1", "-7", "-2147483648", "-2147483649"];
const fractions = ["0.5", "-0.5", "1.25", "3.14159", "1e3", "1E3", "1e+3", "1e-3", "-1.5e10", "1.7976931348623157e308", "5e-324", "0.1", "123456789.123456789", "1e21", "12345678901234567890", "-0", "0.0", "1.0", "100e-2"];
const integer: Make = () => (chance(0.7) ? choice(integers) : String(below(100000) - 50000));
const number: Make = depth => (chance(0.6) ? integer(depth) : chance(0.8) ? choice(fractions) : (below(2000000) - 1000000) / 1000 + (chance(0.3) ? "e" + (below(40) - 20) : ""));
const flag: Make = () => (chance(0.5) ? "true" : "false");
const nothing: Make = () => "null";
const constant = (...spellings: string[]): Make => () => choice(spellings);
const either = (...makes: Make[]): Make => depth => choice(makes)(depth);
////= list
const tuple = (...items: Make[]): Make => depth => "[" + items.map(item => item(depth + 1)).join(",") + "]";
const keys = ['"k"', '"key"', '"x"', '"y"', '"id"', '"name"', '"kind"', '""', '"0"', '"1"', '"42"', '"-1"', '"a b"', '"é"', '"日本"', '"__proto__"', '"constructor"', '"toString"', '"length"', '"\\u006b"', '"k\\n"', '"a key that is longer than the short ones by far, so that no cache takes it"'];
let names = 0;
function otherKey(declared: readonly string[]): string {
  for (;;) {
    let name = "";
    switch (below(12)) {
      case 0:
        return choice(keys.filter(key => !declared.includes(globalThis.JSON.parse(key))));
      case 1:
        name = "u" + below(50);
        break;
      case 2:
        name = "k".repeat(54 + below(20));
        break;
      case 3:
        name = "k".repeat(54 + below(20)) + below(10);
        break;
      case 4:
        name = "k".repeat(chance(0.02) ? 100000 : chance(0.3) ? 1000 + below(100) : 200 + below(10));
        break;
      case 5:
        name = "prefix00" + "abc".repeat(below(22)).slice(0, below(62));
        break;
      case 6:
        name = "prefix00" + below(300);
        break;
      case 7:
        name = "n" + below(5000);
        break;
      case 8:
      case 9:
        name = "q" + ++names;
        break;
      case 10:
        name = "kkkkkkkk".slice(0, 1 + below(8));
        break;
      default:
        name = "same";
    }
    if (!declared.includes(name)) return '"' + name + '"';
  }
}
////= anything
////= dictionary	5) ? otherKey([]
////= shuffle
const record = (members: [string, Make, boolean?][], extra: Make | null = anything): Make => depth => {
  let written: string[] = [];
  for (const [name, make, isOptional] of members) if (!isOptional || chance(0.6)) written.push('"' + name + '":' + make(depth + 1));
  const declared = members.map(member => member[0]);
  if (extra && chance(0.6)) for (let count = 1 + below(chance(0.1) ? 70 : 4); count > 0; count--) written.splice(below(written.length + 1), 0, otherKey(declared) + ":" + (chance(0.5) ? integer(depth) : extra(depth + 1)));
  if (chance(0.5)) written = shuffle(written);
  if (chance(0.05) && written.length) written.splice(below(written.length + 1), 0, choice(written));
  return "{" + written.join(",") + "}";
};

const point = record([["x", number], ["y", number]]);
const user = record([["id", integer], ["name", text], ["email", text, true], ["tags", list(text)], ["active", flag], ["note", either(text, nothing)]]);
const shape = either(record([["kind", constant('"circle"')], ["radius", number]]), record([["kind", constant('"square"')], ["side", number], ["label", text, true]]), record([["kind", constant('"path"')], ["points", list(point)]]));
const tree: Make = depth => record([["name", text], ["kids", list(tree, 0, depth > 3 ? 0 : 3)]])(depth);
const chain: Make = depth => record([["value", number], ["next", depth > 8 || chance(0.3) ? nothing : chain]])(depth);
const wideMembers: [string, Make, boolean?][] = [];
for (const row of ["a", "b", "c", "d"]) {
  const makes: [Make, boolean?][] = [[number], [text], [flag], [number, true], [either(text, nothing)], [list(number)], [point], [text, true], [number], [text]];
  makes.slice(0, row === "d" ? 5 : 10).forEach(([make, isOptional], at) => wideMembers.push([row + at, make, isOptional]));
}

const item = record([["id", integer]]);
const crowd: Make = depth => {
  const items: string[] = [];
  const isLarge = chance(0.03);
  for (let count = isLarge ? 3000 + below(40000) : below(6); count > 0; count--) items.push(isLarge || chance(0.5) ? (count % 2 ? '{"id":' + count + ',"q' + ++names + '":' + count + "}" : '{"q' + ++names + '":"v","id":' + count + ',"same":1}') : item(depth + 1));
  return "[" + items.join(",") + "]";
};
const holder = record([["first", number], ["items", crowd], ["last", text]]);
const shelf = record([["label", text], ["holders", list(holder, 0, 3)], ["byName", dictionary(item)], ["pair", tuple(item, point)]]);

const types: [string, (text: string) => unknown, Make][] = [
  ["Point", text => JSON.parse(text) as Point, point],
  ["User", text => JSON.parse(text) as User, user],
  ["Shape", text => JSON.parse(text) as Shape, shape],
  ["Shape[]", text => JSON.parse(text) as Shape[], list(shape, 0, 6)],
  ["Mixed", text => JSON.parse(text) as Mixed, either(text, number, flag, nothing, record([["v", number]]), list(number))],
  ["Mixed[]", text => JSON.parse(text) as Mixed[], list(either(text, number, flag, nothing, record([["v", number]]), list(number)), 0, 8)],
  ["Triple", text => JSON.parse(text) as Triple, tuple(text, number, point)],
  ["Table", text => JSON.parse(text) as Table, dictionary(number, 8)],
  ["Points", text => JSON.parse(text) as Points, dictionary(point)],
  ["Grid", text => JSON.parse(text) as Grid, list(list(number))],
  ["Tree", text => JSON.parse(text) as Tree, tree],
  ["Chain", text => JSON.parse(text) as Chain, chain],
  ["Loose", text => JSON.parse(text) as Loose, record([["id", number], ["data", anything], ["more", anything], ["bag", dictionary(anything)]])],
  ["Indexed", text => JSON.parse(text) as Indexed, record([["id", number]], either(number, text))],
  ["Literals", text => JSON.parse(text) as Literals, record([["level", constant('"low"', '"high"', '"é"', '"\\u00e9"', '"lo\\u0077"')], ["code", constant("1", "2", "3", "1.0", "2e0", "30e-1")], ["on", constant("true")], ["nothing", nothing], ["either", constant('"a"', "7", "false", "7.0")]])],
  ["Wide", text => JSON.parse(text) as Wide, record(wideMembers)],
  ["Nested", text => JSON.parse(text) as Nested, record([["a", record([["b", record([["c", record([["d", list(point)], ["e", tuple(number, text)]])], ["f", shape, true]])], ["g", dictionary(number)]])], ["h", list(user, 0, 3)]])],
  ["Item", text => JSON.parse(text) as Item, item],
  ["Holder", text => JSON.parse(text) as Holder, holder],
  ["Holder[]", text => JSON.parse(text) as Holder[], list(holder, 0, 3)],
  ["Shelf", text => JSON.parse(text) as Shelf, shelf],
];

////= tokens

const intruders = ["\u0000", '"', "\\", "{", "}", "[", "]", ",", ":", " ", "\n", "\t", "\r", "0", "1", "9", "-", "+", ".", "e", "E", "n", "t", "f", "u", "a", "/", "'", "\u001f", "\u007f", " ", "ÿ", "Ā", " ", "﻿", "\ud800", "\udc00", "null", "true", "false", "nul", "tru", "1e400", "-0", "{}", "[]", '""', '"\\u0000"', "\\u", "\\u00", "\\ud800"];
const spaces = [" ", "\n", "\t", "\r", "  ", " \n\t\r "];

////= mutate

////= represent

const plainParse: (text: string) => any = globalThis.JSON.parse;

////= show

////= deepest

let reported = 0;
function report(what: string, type: string, text: string, typed: string, plain: string): void {
  if (reported++ < 20) console.log(what + " " + type + " seed " + seed + " on " + JSON.stringify(text).slice(0, 600) + "\n  typed: " + typed.slice(0, 400) + "\n  plain: " + plain.slice(0, 400));
}

const kept: { label: string; value: unknown; written: string }[] = [];
let lost = 0;
function keep(label: string, value: unknown, written: string): void {
  const at = below(64);
  const before = kept[at];
  if (before && JSON.stringify(before.value) !== before.written) {
    lost++;
    report("KEPT AND WRITTEN DIFFERENTLY LATER", before.label, before.written, String(JSON.stringify(before.value)), before.written);
  }
  kept[at] = { label, value, written };
}

for (let pass = 0; pass < 2; pass++)
for (const [label, parse, make] of types) {
  let accepted = 0;
  let syntaxErrors = 0;
  let different = 0;
  let texts = 0;
  for (let round = 0; round < rounds; round++) {
    const valid = make(0);
    for (let turn = 0; turn < 6; turn++) {
      const text = represent(turn === 0 ? valid : mutate(valid));
      if (deepest(text) > 1500) continue;
      texts++;
      let typed = "";
      let plain = "";
      let typedValue: unknown;
      let plainValue: unknown;
      const start = Date.now();
      try {
        typedValue = parse(text);
        typed = show(typedValue);
      } catch (error: any) {
        typed = error.name + ": " + error.message;
      }
      if (Date.now() - start > 30000) report("SLOW", label, text, typed, "");
      try {
        plainValue = plainParse(text);
        plain = show(plainValue);
      } catch (error: any) {
        plain = error.name + ": " + error.message;
      }
      if (typed !== plain) {
        different++;
        report("DIFFERENT", label, text, typed, plain);
      } else if (plain.startsWith("SyntaxError")) syntaxErrors++;
      else {
        accepted++;
        const written = String(JSON.stringify(plainValue));
        if (JSON.stringify(typedValue) !== written) {
          different++;
          report("WRITTEN DIFFERENTLY", label, text, String(JSON.stringify(typedValue)), written);
        }
        if (JSON.stringify({ held: typedValue, list: [typedValue] }) !== '{"held":' + written + ',"list":[' + written + "]}") {
          different++;
          report("WRITTEN DIFFERENTLY UNDER A HOLDER", label, text, "", written);
        }
        keep(label, typedValue, written);
      }
    }
  }
  console.log(label + ", pass " + pass + ": " + texts + " texts: " + accepted + " accepted, " + syntaxErrors + " no JSON: " + different + " differ");
}
console.log("kept and written again: " + lost + " differ");
//// json-parse-type-argument-mutated-texts-of-less-common-types.ts
// Fuzzes `JSON.parse(text) as T` with a fixed seed over less common kinds of type: enums, intersections, generics, mapped and utility types, template literals, number keys, interfaces that extend others. Each text is generated to match its type and then mutated. `JSON.parse(text) as T` must throw the same SyntaxError as JSON.parse or return the same value. Texts that contain -0 are left out for the types with enums: json-parse-type-argument-minus-zero-under-an-enum has them.

const seed: number = 1;
const rounds: number = 300;

type Point = { x: number; y: number };
type User = { id: number; name: string; email?: string; tags: string[]; active: boolean; note: string | null };
enum Color { Red, Green, Blue }
enum Level { Low = "low", High = "high" }
type Painted = { color: Color; level: Level; both: Color | Level };
type ByEnum = { kind: Color.Red; r: number } | { kind: Color.Green; g: string } | { kind: Color.Blue; b: boolean };
type Joined = { a: number } & { b: string } & { c?: boolean };
type Box<T> = { value: T; next?: Box<T> };
type Part = Partial<User>;
type Picked = Pick<User, "id" | "name">;
type Omitted = Omit<User, "tags" | "note">;
type Whole = Required<{ a?: number; b?: string }>;
type Fixed = Readonly<{ a: number; list: readonly string[] }>;
type Finite = Record<"a" | "b" | "c", number>;
type IndexKeys = { [key: string]: string };
type Templated = { id: `id-${number}`; path: `/${string}` };
type Undefinable = { a: number | undefined; b?: string | null; c: null | boolean };
type Lists = number[] | string[];
type Within = { v: (number | { w: string | number[] })[] };
type Mapped = { [K in "k1" | "k2" | "k3"]: { [L in "x" | "y"]: number } };
type Empty = {};
type AnyObject = { o: object; p: {} };
type Extended = Point & { z: number; label?: string };
interface Base { id: number }
interface Derived extends Base { name: string; parent?: Derived }

let state = seed >>> 0;
////= random
const below = (limit: number): number => Math.floor(random() * limit);
const chance = (probability: number): boolean => random() < probability;
const choice = <T>(from: readonly T[]): T => from[below(from.length)];

type Make = (depth: number) => string;
const characters = ["a", "b", "z", "A", "0", "9", " ", "-", "_", ".", "/", "é", "ÿ", "Ā", "日", "😀", "\\n", "\\t", '\\"', "\\\\", "\\/", "\\u0041", "\\u00e9", "\\u65e5", "\\ud83d\\ude00", "\\ud800", "\\u0000", "\u007f", " "];
const plainCharacters = ["a", "b", "c", "x", "y", "z", "k"];
////= stringOf
const text: Make = () => (chance(0.6) ? stringOf(below(6), plainCharacters) : chance(0.8) ? stringOf(below(12), characters) : stringOf(20 + below(120), chance(0.5) ? plainCharacters : characters));
const integers = ["0", "1", "2", "3", "7", "10", "42", "255", "999", "1000", "65536", "2147483647", "2147483648", "4294967296", "9007199254740991", "-1", "-7", "-2147483648", "-2147483649"];
const fractions = ["0.5", "-0.5", "1.25", "3.14159", "1e3", "1E3", "1e+3", "1e-3", "-1.5e10", "1.7976931348623157e308", "5e-324", "0.1", "123456789.123456789", "1e21", "12345678901234567890", "-0", "0.0", "1.0", "100e-2"];
const integer: Make = () => (chance(0.7) ? choice(integers) : String(below(100000) - 50000));
const number: Make = depth => (chance(0.6) ? integer(depth) : chance(0.8) ? choice(fractions) : (below(2000000) - 1000000) / 1000 + (chance(0.3) ? "e" + (below(40) - 20) : ""));
const flag: Make = () => (chance(0.5) ? "true" : "false");
const nothing: Make = () => "null";
const constant = (...spellings: string[]): Make => () => choice(spellings);
const either = (...makes: Make[]): Make => depth => choice(makes)(depth);
////= list
const tuple = (...items: Make[]): Make => depth => "[" + items.map(item => item(depth + 1)).join(",") + "]";
const keys = ['"k"', '"key"', '"x"', '"y"', '"id"', '"name"', '"kind"', '""', '"0"', '"1"', '"42"', '"-1"', '"a b"', '"é"', '"日本"', '"__proto__"', '"constructor"', '"toString"', '"length"', '"\\u006b"', '"k\\n"', '"a key that is longer than the short ones by far, so that no cache takes it"'];
////= anything
////= dictionary	7) ? choice(keys
////= shuffle
////= record

const point = record([["x", number], ["y", number]]);
const user = record([["id", integer], ["name", text], ["email", text, true], ["tags", list(text)], ["active", flag], ["note", either(text, nothing)]]);
const color = constant("0", "1", "2", "1.0", "2e0");
const level = constant('"low"', '"high"', '"lo\\u0077"');
const box = (value: Make): Make => {
  const made: Make = depth => record(depth > 5 ? [["value", value]] : [["value", value], ["next", made, true]])(depth);
  return made;
};
const derived: Make = depth => record([["id", number], ["name", text], ...(depth > 5 ? [] : ([["parent", derived, true]] as [string, Make, boolean?][]))])(depth);
const indexKeys: Make = depth => "{" + Array.from({ length: below(5) }, (_, at) => '"' + (at * 7 + below(5)) + '":' + text(depth)).join(",") + "}";

const types: [string, (text: string) => unknown, Make][] = [
  ["Painted", text => JSON.parse(text) as Painted, record([["color", color], ["level", level], ["both", either(color, level)]])],
  ["ByEnum", text => JSON.parse(text) as ByEnum, either(record([["kind", constant("0", "0.0")], ["r", number]]), record([["kind", constant("1", "1e0")], ["g", text]]), record([["kind", constant("2")], ["b", flag]]))],
  ["ByEnum[]", text => JSON.parse(text) as ByEnum[], list(either(record([["kind", constant("0")], ["r", number]]), record([["kind", constant("1")], ["g", text]]), record([["kind", constant("2")], ["b", flag]])), 0, 6)],
  ["Joined", text => JSON.parse(text) as Joined, record([["a", number], ["b", text], ["c", flag, true]])],
  ["Box<Point>", text => JSON.parse(text) as Box<Point>, box(point)],
  ["Box<string[]>", text => JSON.parse(text) as Box<string[]>, box(list(text))],
  ["Part", text => JSON.parse(text) as Part, record([["id", integer, true], ["name", text, true], ["email", text, true], ["tags", list(text), true], ["active", flag, true], ["note", either(text, nothing), true]])],
  ["Picked", text => JSON.parse(text) as Picked, record([["id", integer], ["name", text]])],
  ["Omitted", text => JSON.parse(text) as Omitted, record([["id", integer], ["name", text], ["email", text, true], ["active", flag]])],
  ["Whole", text => JSON.parse(text) as Whole, record([["a", number], ["b", text]])],
  ["Fixed", text => JSON.parse(text) as Fixed, record([["a", number], ["list", list(text)]])],
  ["Finite", text => JSON.parse(text) as Finite, record([["a", number], ["b", number], ["c", number]])],
  ["IndexKeys", text => JSON.parse(text) as IndexKeys, indexKeys],
  ["Templated", text => JSON.parse(text) as Templated, record([["id", () => '"id-' + below(1000) + '"'], ["path", () => '"/' + "abc".slice(below(3)) + '"']])],
  ["Undefinable", text => JSON.parse(text) as Undefinable, record([["a", number], ["b", either(text, nothing), true], ["c", either(nothing, flag)]])],
  ["Lists", text => JSON.parse(text) as Lists, either(list(number), list(text))],
  ["Within", text => JSON.parse(text) as Within, record([["v", list(either(number, record([["w", either(text, list(number))]])))]])],
  ["Mapped", text => JSON.parse(text) as Mapped, record([["k1", point], ["k2", point], ["k3", point]])],
  ["Empty", text => JSON.parse(text) as Empty, record([])],
  ["AnyObject", text => JSON.parse(text) as AnyObject, record([["o", either(dictionary(anything), list(anything))], ["p", dictionary(anything)]])],
  ["Extended", text => JSON.parse(text) as Extended, record([["x", number], ["y", number], ["z", number], ["label", text, true]])],
  ["Derived", text => JSON.parse(text) as Derived, derived],
];

////= tokens

const intruders = ["\u0000", '"', "\\", "{", "}", "[", "]", ",", ":", " ", "\n", "\t", "\r", "0", "1", "9", "-", "+", ".", "e", "E", "n", "t", "f", "u", "a", "/", "'", "\u001f", "\u007f", " ", "ÿ", "Ā", " ", "﻿", "\ud800", "\udc00", "null", "true", "false", "nul", "tru", "1e400", "-0", "{}", "[]", '""', '"\\u0000"', "\\u", "\\u00", "\\ud800"];
const spaces = [" ", "\n", "\t", "\r", "  ", " \n\t\r "];

////= mutate

////= represent

const plainParse: (text: string) => any = globalThis.JSON.parse;

////= show

////= deepest

let reported = 0;
function report(what: string, type: string, text: string, typed: string, plain: string): void {
  if (reported++ < 20) console.log(what + " " + type + " seed " + seed + " on " + JSON.stringify(text).slice(0, 600) + "\n  typed: " + typed.slice(0, 400) + "\n  plain: " + plain.slice(0, 400));
}

const holdsEnums = new Set(["Painted", "ByEnum", "ByEnum[]"]);
for (const [label, parse, make] of types) {
  let accepted = 0;
  let syntaxErrors = 0;
  let different = 0;
  let texts = 0;
  for (let round = 0; round < rounds; round++) {
    const valid = make(0);
    for (let turn = 0; turn < 6; turn++) {
      const text = represent(turn === 0 ? valid : mutate(valid));
      if (deepest(text) > 1500) continue;
      if (holdsEnums.has(label) && text.includes("-0")) continue;
      texts++;
      let typed = "";
      let plain = "";
      let typedValue: unknown;
      let plainValue: unknown;
      const start = Date.now();
      try {
        typedValue = parse(text);
        typed = show(typedValue);
      } catch (error: any) {
        typed = error.name + ": " + error.message;
      }
      if (Date.now() - start > 30000) report("SLOW", label, text, typed, "");
      try {
        plainValue = plainParse(text);
        plain = show(plainValue);
      } catch (error: any) {
        plain = error.name + ": " + error.message;
      }
      if (typed !== plain) {
        different++;
        report("DIFFERENT", label, text, typed, plain);
      } else if (plain.startsWith("SyntaxError")) syntaxErrors++;
      else {
        accepted++;
        if (JSON.stringify(typedValue) !== JSON.stringify(plainValue)) {
          different++;
          report("STRINGIFIED DIFFERENTLY", label, text, String(JSON.stringify(typedValue)), String(JSON.stringify(plainValue)));
        }
      }
    }
  }
  console.log(label + ": " + texts + " texts: " + accepted + " accepted, " + syntaxErrors + " invalid JSON: " + different + " differ");
}
//// json-parse-type-argument-numbers-in-every-spelling.ts
// Numbers in every spelling, valid and not, in every place where a type expects a number: `JSON.parse(text) as T` gives the number JSON.parse gives, bit for bit, or its error.
const plainParse: (text: string) => any = globalThis.JSON.parse;

////= show

////= outcome

let shown = 0;
////= differs

type Held = { n: number };
type Either = { n: number | string | null };

const roads: [string, (text: string) => unknown, (number: string) => string][] = [
  ["a member", text => JSON.parse(text) as Held, number => '{"n":' + number + "}"],
  ["a member, spaced", text => JSON.parse(text) as Held, number => '{ "n" : ' + number + " }"],
  ["a member behind an undeclared key", text => JSON.parse(text) as Held, number => '{"u":' + number + ',"n":' + number + ',"v":[' + number + "]}"],
  ["a union", text => JSON.parse(text) as Either, number => '{"n":' + number + "}"],
  ["the root", text => JSON.parse(text) as number, number => number],
  ["the root, spaced", text => JSON.parse(text) as number, number => " " + number + "\n"],
  ["elements", text => JSON.parse(text) as number[], number => "[" + number + "," + number + "]"],
  ["a tuple", text => JSON.parse(text) as [number, number], number => "[" + number + " , " + number + "]"],
  ["a dictionary", text => JSON.parse(text) as Record<string, number>, number => '{"a":' + number + ',"b":' + number + "}"],
  ["16-bit text", text => JSON.parse(text) as Held, number => ('{"n":' + number + "}Ā").slice(0, -1)],
];

const spellings = [
  "0", "-0", "0.0", "-0.0", "-0e0", "0e0", "0E+0", "0e400", "-0e400", "0e-400", "0.0e-0", "1", "-1", "1.0", "1.5", "-1.5", "1.50", "100", "1e2", "1E2", "1e+2", "1E+2", "1e02", "10e1", "1000e-1", "15e-1", "0.1", "0.2", "0.30000000000000004",
  "1e400", "-1e400", "1E400", "1e-400", "1E-400", "-1e-400", "5e-324", "4.9e-324", "3e-324", "2.4703282292062327e-324", "2.4703282292062328e-324", "2.5e-324", "2.2250738585072014e-308", "2.2250738585072011e-308", "2.225073858507201e-308",
  "1.7976931348623157e308", "1.7976931348623158e308", "1.7976931348623159e308", "1.797693134862315807e308", "1.797693134862315808e308", "17976931348623157e292", "1.8e308", "-1.7976931348623159e308",
  "9007199254740991", "9007199254740992", "9007199254740993", "9007199254740994", "9007199254740995", "-9007199254740991", "-9007199254740992", "-9007199254740993", "9007199254740993.0", "9007199254740992.5", "900719925474099.3e1",
  "2147483647", "2147483648", "-2147483648", "-2147483649", "4294967295", "4294967296", "999999999", "1000000000", "9999999999", "-999999999", "-1000000000",
  "9223372036854775807", "9223372036854775808", "-9223372036854775808", "-9223372036854775809", "18446744073709551615", "18446744073709551616", "18446744073709551617", "36893488147419103232",
  "123456789012345", "1234567890123456", "12345678901234567", "123456789012345678", "1234567890123456789", "12345678901234567890", "123456789012345678901234567890", "1234567890123456789012345678901234567890",
  "0.123456789012345", "0.1234567890123456", "0.12345678901234567", "0.123456789012345678", "0.1234567890123456789012345678901234567890", "123456.789012345678901234567890e-10",
  "1e21", "1e22", "1e23", "1e-22", "1e-23", "9.5e22", "8.5e23", "123456789012345e22", "123456789012345e23", "123456789012345e-22", "123456789012345e-23", "999999999999999e22", "1e15", "1e16", "1e-5", "1e-6", "1e-7",
  "1.00000000000000011102230246251565404236316680908203125", "1.00000000000000011102230246251565404236316680908203124", "1.00000000000000011102230246251565404236316680908203126",
  "1e1000000000", "1e-1000000000", "1e2147483647", "1e2147483648", "1e-2147483648", "1e-2147483649", "1e4294967296", "1e4294967297", "1e99999999999999999999", "1e-99999999999999999999", "0e99999999999999999999", "0.0e-99999999999999999999", "-0e99999999999999999999",
  "1" + "0".repeat(308), "1" + "0".repeat(309), "1" + "0".repeat(400), "0." + "0".repeat(322) + "1", "0." + "0".repeat(323) + "1", "0." + "0".repeat(323) + "3", "0." + "0".repeat(400) + "1", "1." + "9".repeat(400), "1." + "0".repeat(400) + "1",
  "1" + "0".repeat(400) + "e-400", "0." + "0".repeat(400) + "1e401", "9".repeat(15), "9".repeat(16), "9".repeat(17), "9".repeat(18), "9".repeat(19), "9".repeat(20), "9".repeat(21), "9".repeat(5000), "0." + "9".repeat(5000), "1e" + "0".repeat(5000) + "1",
  "01", "00", "-01", "-00", "007", "+1", "+0", "1.", "-1.", "0.", ".5", "-.5", "-", "--1", "-+1", "1e", "1E", "1e+", "1e-", "1e+-1", "1.e1", "1.5e", "1.5e+", "1..5", "1.5.5", "1e5.5", "1e5e5", "0x10", "0b1", "0o7", "1_000", "1n", "1f", "1d",
  "Infinity", "-Infinity", "NaN", "-NaN", "infinity", "nan", "1 2", "1,", ",1", "- 1", "1 .5", "1. 5", "1 e5", "1e 5", "¹", "١", "１", "1\u0000", "\u00001", "1 ", " 1", "﻿1", "1﻿", "", " ", "-e1", "e1", "E1", ".", ".e1", "0e", "0e+", "0.e1", "-0.", "-0e",
];

for (const [label, parse, wrap] of roads) {
  let different = 0;
  for (const spelling of spellings) different += differs(parse, wrap(spelling));
  console.log(label + ": " + spellings.length + " spellings: " + different + " differ");
}

let seed = 12345;
////= lines-7	random
function digits(count: number): string {
  let text = "";
  for (let at = 0; at < count; at++) text += String(random(10));
  return text;
}
for (const [label, parse, wrap] of roads) {
  let different = 0;
  for (let round = 0; round < 4000; round++) {
    let spelling = random(2) ? "-" : "";
    spelling += random(4) ? String(1 + random(9)) + digits(random(round % 5 ? 8 : 24)) : "0";
    if (random(2)) spelling += "." + digits(1 + random(round % 3 ? 6 : 24));
    if (random(2)) spelling += (random(2) ? "e" : "E") + ["", "+", "-"][random(3)] + String(random(round % 7 ? 30 : 340));
    different += differs(parse, wrap(spelling));
  }
  console.log(label + ": 4000 numbers by chance: " + different + " differ");
}
