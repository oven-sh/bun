function change(value: Changed, step: number): string {
  const list = value.list as any;
  switch (step) {
    case 0:
      list.push(4, 5);
      break;
    case 1:
      list.length = 1;
      break;
    case 2:
      list[5] = 6;
      break;
    case 3:
      list.named = true;
      break;
    case 4:
      Object.setPrototypeOf(list, { join: () => "another prototype" });
      break;
    case 5:
      Object.freeze(list);
      break;
    case 6:
      Object.defineProperty(list, "0", { get: () => 100 });
      break;
    case 7:
      delete list[1];
      break;
    case 8:
      value.list = [9];
      break;
  }
  let cells = "";
  const after = value.list;
  for (let at = 0; at < after.length; at++) cells += "|" + after[at];
  return step + ": " + cells + " " + after.length + " " + after.join("-") + " " + Reflect.ownKeys(after).map(String).join() + " " + Array.isArray(after);
}
for (let step = 0; step < 10; step++) console.log(change(JSON.parse('{"list":[1,2,3],"name":"n"}') as Changed, step));

for (const text of ['{"items":[{"id":1,"tags":[]}],"grid":[[1],"total":1}', '{"items":[{"id":1,"tags":[]},],"grid":[],"total":1}', '{"items":[', '{"items":[]]}']) {
  try {
    console.log("NO ERROR", describe(JSON.parse(text) as Page));
  } catch (error) {
    console.log((error as Error).name, (error as Error).message);
  }
}
//// json-parse-several-kinds-of-object-under-one-first-key.ts
// Texts of seven kinds that begin alike: one first key, whose value names the kind. However many of them the parser that expects keys has seen, each is parsed as written.
const kinds = [
  (at: number) => '{"kind":"first","at":' + at + ',"value":{"kind":"inner","text":"abc"}}',
  (at: number) => '{"kind":"second","at":' + at + ',"block":{"kind":"inner","name":"n"}}',
  (at: number) => '{"kind":"third","at":' + at + "}",
  (at: number) => '{"kind":"fourth","note":{"id":"x","role":"r"}}',
  (at: number) => '{"kind":"fifth","value":{"reason":"r","other":null},"usage":{"count":' + at + "}}",
  (at: number) => '{"kind":"sixth"}',
  (at: number) => '{"kind":"seventh","at":' + at + ',"usage":{"count":1},"more":true}',
];
let wrong = 0;
for (let turn = 0; turn < 700; turn++) {
  const text = kinds[turn % 7]!(turn % 10);
  const value: unknown = JSON.parse(text);
  if (JSON.stringify(value) !== text) wrong++;
}
console.log("700 texts,", wrong, "wrong");
//// json-parse-stands-back-from-texts-it-does-not-serve-well.ts
// The parser that expects keys keeps a credit for each beginning of a text. Texts that make it learn again and again, or that are mostly long strings, use the credit up and go straight to the former parser; after a while one more is tried, so a shape that settles late is served again.
////= measure	JSON.stringify(JSON.parse(text, (_, held) => held))
const many = (count: number, make: (at: number) => string) => Array.from({ length: count }, (_, at) => make(at));
measure("one shape", many(300, at => '{"steady":' + at + ',"name":"n","ok":true}'));
measure("a key that is new every time", many(300, at => '{"always":1,"key' + at + '":' + at + "}"));
measure("the same again", many(300, at => '{"always":1,"key' + at + '":' + at + "}"));
measure("mostly one long string", many(300, at => '{"prose":"' + "word ".repeat(200) + at + '","at":' + at + "}"));
measure("new keys at first", many(100, at => '{"settles":1,"early' + at + '":' + at + "}"));
measure("then one shape, the first 200", many(200, at => '{"settles":1,"late":' + at + "}"));
measure("then one shape, the next 400", many(400, at => '{"settles":1,"late":' + at + "}"));
measure("one shape, still", many(300, at => '{"steady":' + at + ',"name":"n","ok":true}'));
//// json-parse-type-argument-a-buffer-used-again-and-odd-characters-everywhere.ts
// Doubts from reading, each as a run against plain JSON.parse: the buffer used again for a shorter text; a NUL, 0xFF and U+0100 at every place; a parse entered from inside a parse.
type Point = { x: number; y: number; label?: string };
type Lists = Record<string, number[]> | Record<string, string[]>;
const plainly: (text: string) => any = globalThis.JSON.parse;
////= say-3	
let different = 0;
let compared = 0;
function check(text: string): void {
  compared++;
  const [typed, plain] = [say(() => JSON.parse(text) as Point), say(() => plainly(text))];
  if (typed !== plain && different++ < 5) console.log("DIFFERS " + JSON.stringify(text).slice(0, 120) + " | " + typed.slice(0, 60) + " | " + plain.slice(0, 60));
}
const whole = '{"x":1,"y":2,"label":"l","other":[1,{"a":"b"}],"last":"z"}';
for (const size of [900, 1000, 5000, 70000]) {
  check(`{"x":1,"y":2,"pad":"${"p".repeat(size)}","tail":${whole}}`);
  for (let cut = 1; cut <= whole.length; cut++) check(whole.slice(0, cut));
}
for (const unit of ["\0", "\x01", "\x1f", "\x7f", "\xff", "Ā", "\ud800", "﻿", " "]) {
  for (let at = 0; at <= whole.length; at++) {
    check(whole.slice(0, at) + unit + whole.slice(at));
    check(whole.slice(0, at) + unit + whole.slice(at + 1));
  }
}
console.log(compared + " texts, " + different + " differ");
let entered = 0;
const keys = Object.keys;
try {
  (Object as any).keys = function (value: object): string[] {
    entered++;
    if (entered < 4) (JSON.parse('{"y":2,"o":1,"x":1}') as Point), JSON.stringify(JSON.parse('{"o":[1],"x":1,"y":2}') as Point);
    return keys(value);
  };
} catch (error: any) {
  console.log("Object.keys cannot be replaced: " + error.name);
}
console.log(say(() => JSON.parse('{"o":1,"a":1,"lists":{"k":["s"],"m":[]},"p":2,"z":3}') as { a: number; lists: Lists; z: number }), entered > 0 ? "entered" : "not entered");
function addToObjectPrototype(): void {
  (Object.prototype as any).y = 5;
}
function removeFromObjectPrototype(): void {
  delete (Object.prototype as any).y;
}
try {
  (Object as any).keys = keys;
  addToObjectPrototype();
  console.log(say(() => JSON.parse('{"x":1}') as Point), say(() => JSON.parse('{"\\u0078":1}') as Point), say(() => JSON.parse('{"x":1,"o":2}') as Point));
  removeFromObjectPrototype();
} catch (error: any) {
  console.log("Object.prototype cannot be changed: " + error.name);
}
//// json-parse-type-argument-a-long-undeclared-key-then-a-short-text.ts
// A long undeclared key is seen several times; then a short text has an undeclared key that begins with the same bytes, at the end of the text. Nothing behind the text may be read: an engine built with AddressSanitizer says so.
type Point = { x: number; y: number };
let different = 0;
let parsed = 0;
function check(text: string): void {
  parsed++;
  if (JSON.stringify(JSON.parse(text) as Point) !== JSON.stringify(globalThis.JSON.parse(text))) different++;
}
for (const size of [7, 8, 9, 15, 16, 17, 30, 54, 55, 56, 60, 61, 62, 63, 64, 65, 66, 70, 71, 72, 73, 100, 200, 1000, 5000, 100000]) {
  const long = "k".repeat(size);
  for (let round = 0; round < 4; round++) check(`{"x":1,"y":2,"${long}":1}`);
  for (const short of [1, 6, 7, 8, 9, 10, 16, 17, size - 1, size + 1]) {
    if (short < 1) continue;
    for (let round = 0; round < 2; round++) {
      check(`{"x":1,"y":2,"${"k".repeat(short)}":1}`);
      check(`{"x":1,"y":2,"${long}":1}`);
      check(`{"x":1,"${"k".repeat(short)}":1,"y":2}`);
    }
  }
  check(`{"x":1,"y":2,"${long}":1,"${long}z":2,"${long}":3}`);
}
console.log(parsed + " texts, " + different + " differ");
//// json-parse-type-argument-a-parse-that-throws-is-closed.ts
// A parse that ends by a throw is closed: the parses that follow, deeper on the stack too, are still made by the generated parser.
declare const aotOperationCount: undefined | ((name: string) => number);
interface Wide { m0: string; m1: string; m2: string; m3: string; m4: string; m5: string; m6: string; m7: string; m8: string; m9: string; m10: string; m11: string; m12: string; m13: string; m14: string; m15: string; m16: string; m17: string; m18: string; m19: string; m20: string; m21: string; m22: string; m23: string; m24: string; m25: string; m26: string; m27: string; m28: string; m29: string; m30: string; m31: string; m32: string; m33: string; m34: string; m35: string; m36: string; m37: string; m38: string; m39: string; m40: string; m41: string; m42: string; m43: string; m44: string; m45: string; m46: string; m47: string; m48: string; m49: string; m50: string; m51: string; m52: string; m53: string; m54: string; m55: string; m56: string; m57: string; m58: string; m59: string; m60: string; m61: string; m62: string; m63: string; m64: string; m65: string; m66: string; m67: string; m68: string; m69: string; m70: string; m71: string; m72: string; m73: string; m74: string; m75: string; m76: string; m77: string; m78: string; m79: string; m80: string; m81: string; m82: string; m83: string; m84: string; m85: string; m86: string; m87: string; m88: string; m89: string; m90: string; m91: string; m92: string; m93: string; m94: string; m95: string; m96: string; m97: string; m98: string; m99: string; m100: string; m101: string; m102: string; m103: string; m104: string; m105: string; m106: string; m107: string; m108: string; m109: string; m110: string; m111: string; m112: string; m113: string; m114: string; m115: string; m116: string; m117: string; m118: string; m119: string; }
interface Narrow { n: number }
const counted = typeof aotOperationCount === "function" ? aotOperationCount : null;
const readAgain = () => (counted ? counted("operationAOTJSONSourceAbandon") : 0);
const wideText = '{"m0":"0","m1":"1","m2":"2","m3":"3","m4":"4","m5":"5","m6":"6","m7":"7","m8":"8","m9":"9","m10":"10","m11":"11","m12":"12","m13":"13","m14":"14","m15":"15","m16":"16","m17":"17","m18":"18","m19":"19","m20":"20","m21":"21","m22":"22","m23":"23","m24":"24","m25":"25","m26":"26","m27":"27","m28":"28","m29":"29","m30":"30","m31":"31","m32":"32","m33":"33","m34":"34","m35":"35","m36":"36","m37":"37","m38":"38","m39":"39","m40":"40","m41":"41","m42":"42","m43":"43","m44":"44","m45":"45","m46":"46","m47":"47","m48":"48","m49":"49","m50":"50","m51":"51","m52":"52","m53":"53","m54":"54","m55":"55","m56":"56","m57":"57","m58":"58","m59":"59","m60":"60","m61":"61","m62":"62","m63":"63","m64":"64","m65":"65","m66":"66","m67":"67","m68":"68","m69":"69","m70":"70","m71":"71","m72":"72","m73":"73","m74":"74","m75":"75","m76":"76","m77":"77","m78":"78","m79":"79","m80":"80","m81":"81","m82":"82","m83":"83","m84":"84","m85":"85","m86":"86","m87":"87","m88":"88","m89":"89","m90":"90","m91":"91","m92":"92","m93":"93","m94":"94","m95":"95","m96":"96","m97":"97","m98":"98","m99":"99","m100":"100","m101":"101","m102":"102","m103":"103","m104":"104","m105":"105","m106":"106","m107":"107","m108":"108","m109":"109","m110":"110","m111":"111","m112":"112","m113":"113","m114":"114","m115":"115","m116":"116","m117":"117","m118":"118","m119":"119"}';
const narrowText = '{"n":7}';
let thrown = 0;
let followed = 0;
let sum = 0;

function parseNarrow(): number {
  return (JSON.parse(narrowText) as Narrow).n;
}
function parseWide(): number {
  return (JSON.parse(wideText) as Wide).m0.length;
}
function attempt(): void {
  try {
    sum += parseWide();
  } catch (error) {
    if (!(error instanceof RangeError)) throw error;
    thrown++;
    try {
      sum += parseNarrow();
      followed++;
    } catch (second) {
      if (!(second instanceof RangeError)) throw second;
    }
  }
}
function descend(levels: number, attemptsFrom: number): number {
  if (levels >= attemptsFrom) attempt();
  try {
    return descend(levels + 1, attemptsFrom) + 0;
  } catch (error) {
    if (!(error instanceof RangeError)) throw error;
    return levels;
  }
}

