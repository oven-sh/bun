//// json-parse-type-argument-constant-numbers-in-every-spelling.ts
// Where a type names a number, every spelling of that number is taken, and the value is the one JSON.parse gives: -0 stays -0 under the type 0.
const plainParse: (text: string) => any = globalThis.JSON.parse;

////= show

////= outcome

let shown = 0;
////= differs

type Constant = { n: 0 | 1 | -1 | 1.5 | 100 };
type Zero = { n: 0 };

const roads: [string, (text: string) => unknown, (number: string) => string][] = [
  ["a member", text => JSON.parse(text) as Constant, number => '{"n":' + number + "}"],
  ["a member that is zero", text => JSON.parse(text) as Zero, number => '{ "n" : ' + number + " }"],
  ["the root", text => JSON.parse(text) as 0 | 1, number => number],
  ["elements", text => JSON.parse(text) as (0 | 1.5)[], number => "[" + number + "," + number + "]"],
  ["a tuple", text => JSON.parse(text) as [0, 0 | 100], number => "[" + number + "," + number + "]"],
  ["a dictionary", text => JSON.parse(text) as Record<string, 0 | 1>, number => '{"a":' + number + "}"],
  ["a tag", text => JSON.parse(text) as { k: 0; a: number } | { k: 1; b: number }, number => '{"k":' + number + ',"a":1,"b":2}'],
];
const spellings = ["0", "-0", "0.0", "-0.0", "-0e0", "0e5", "-0e5", "-0E-5", "-0e400", "-1e-400", "1e-400", "-0e99999999999999999999", "1", "1.0", "10e-1", "0.1e1", "-1", "-1.0", "1.5", "15e-1", "1.50", "100", "1e2", "1E+2", "100.0", "2", "-1.5", "1e400"];
for (const [label, parse, wrap] of roads) {
  let different = 0;
  for (const spelling of spellings) different += differs(parse, wrap(spelling));
  console.log(label + ": " + spellings.length + " spellings: " + different + " differ");
}
//// json-parse-type-argument-declared-keys-again-and-again.ts
// Declared keys are written again and again in one object, up to a hundred times, between other declared and undeclared keys: more entries than the word that remembers the order of the keys of a small type can hold.
type R1 = { m0: number };
type R2 = { m0: number; m1: number };
type R3 = { m0: number; m1: number; m2: number };
type R5 = { m0: number; m1: number; m2: number; m3: number; m4: number };
type R12 = { m0: number; m1: number; m2: number; m3: number; m4: number; m5: number; m6: number; m7: number; m8: number; m9: number; m10: number; m11: number };
type R13 = { m0: number; m1: number; m2: number; m3: number; m4: number; m5: number; m6: number; m7: number; m8: number; m9: number; m10: number; m11: number; m12: number };
type R14 = { m0: number; m1: number; m2: number; m3: number; m4: number; m5: number; m6: number; m7: number; m8: number; m9: number; m10: number; m11: number; m12: number; m13: number };
const plainParse: (text: string) => any = globalThis.JSON.parse;
let seed = 3;
////= lines-7	below
function check(width: number, parse: (text: string) => unknown): void {
  let different = 0;
  let texts = 0;
  for (const repeats of [0, 1, 2, 3, 10, 11, 12, 13, 14, 15, 16, 17, 18, 30, 31, 32, 33, 63, 64, 65, 100]) {
    for (let turn = 0; turn < 12; turn++) {
      const members: string[] = [];
      for (let at = 0; at < width; at++) members.push('"m' + at + '":' + at);
      for (let count = 0; count < repeats; count++) members.splice(below(members.length + 1), 0, '"m' + (turn % 3 ? below(width) : turn % width) + '":' + (100 + count));
      if (turn % 4 === 1) for (let count = 0; count < 1 + below(4); count++) members.splice(below(members.length + 1), 0, '"u' + below(3) + '":' + count);
      if (turn % 4 === 3) members.reverse();
      const text = "{" + members.join(",") + "}";
      for (let round = 0; round < 3; round++) {
        texts++;
        const typed: any = parse(text);
        const plain = plainParse(text);
        if (JSON.stringify(typed) !== JSON.stringify(plain) || Object.keys(typed).join() !== Object.keys(plain).join()) different++;
      }
    }
  }
  console.log(width + " members: " + texts + " texts: " + different + " differ");
}
check(1, text => JSON.parse(text) as R1);
check(2, text => JSON.parse(text) as R2);
check(3, text => JSON.parse(text) as R3);
check(5, text => JSON.parse(text) as R5);
check(12, text => JSON.parse(text) as R12);
check(13, text => JSON.parse(text) as R13);
check(14, text => JSON.parse(text) as R14);
//// json-parse-type-argument-declared-keys-of-thousands-of-bytes.ts
// Declared keys of 200 and 5,000 bytes: texts that end in the middle of such a key, texts of ten bytes, keys that agree up to the last byte.
type Long = { kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk: number; kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkx: number; a: number };
type Longest = { : number; b?: number };
const plainParse: (text: string) => any = globalThis.JSON.parse;
let different = 0;
let texts = 0;
function ask(parse: (text: string) => unknown, text: string): void {
  texts++;
  let typed = "";
  let plain = "";
  try {
    typed = JSON.stringify(parse(text));
  } catch (error: any) {
    typed = error.name + ": " + error.message;
  }
  try {
    plain = JSON.stringify(plainParse(text));
  } catch (error: any) {
    plain = error.name + ": " + error.message;
  }
  if (typed !== plain) different++;
}
const long = (text: string) => JSON.parse(text) as Long;
const longest = (text: string) => JSON.parse(text) as Longest;
const key = "k".repeat(200);
const whole = '{"' + key + '":1,"' + key + 'x":2,"a":3}';
for (let round = 0; round < 10; round++) ask(long, whole);
for (let cut = whole.length; cut >= 0; cut--) ask(long, whole.slice(0, cut));
for (let length = 0; length <= 210; length++) for (const tail of ['":1}', '":1,"a":3}', '"', "", "x", 'y":1}']) {
  ask(long, '{"' + "k".repeat(length) + tail);
  ask(long, '{"a":3,"' + "k".repeat(length) + tail);
  ask(long, ('{"a":3,"' + "k".repeat(length) + tail + "\u0100").slice(0, -1));
}
console.log("a key of 200: " + texts + " texts: " + different + " differ");
texts = 0;
const huge = "k".repeat(5000);
for (let round = 0; round < 10; round++) ask(longest, '{"' + huge + '":1}');
for (let length = 0; length <= 5010; length += length < 100 || length > 4900 ? 1 : 37) for (const tail of ['":1}', '"', "", 'y":1}', '":1,"b":2}']) {
  ask(longest, '{"' + "k".repeat(length) + tail);
  ask(longest, '{"b":2,"' + "k".repeat(length) + tail);
}
console.log("a key of 5,000: " + texts + " texts: " + different + " differ");
//// json-parse-type-argument-every-cache-past-its-cap.ts
// Every cache with a cap is filled from below the cap to above it in the middle of a parse, a write or a conversion of an object that stands on one of its entries. Argument: the number of a road; none: all.
interface Item { id: number }
interface Holder { first: number; items: Item[]; last: string }
interface Pair { left: Item; right: Item }
interface Deep { name: string; below: Deep[]; item: Item }
type Tagged = { kind: "a"; a: number } | { kind: "b"; b: number } | { kind: "c"; c: number };
interface Tags { first: number; items: Tagged[]; last: string }

const plainParse: (text: string) => any = globalThis.JSON.parse;
const counts = [10, 255, 256, 257, 4095, 4096, 4097, 16383, 16384, 16385, 20000, 33000];
let serial = 0;

function holderText(items: string[]): string {
  return '{"a":"before","first":1,"b":[1,2],"items":[' + items.join(",") + '],"c":"behind","last":"l","d":{"e":null},"f":"' + "x".repeat(40) + '"}';
}
function kinds(count: number, make: (unique: number, at: number) => string): string[] {
  const items: string[] = [];
  for (let at = 0; at < count; at++) items.push(make(++serial, at));
  return items;
}
function deepText(levels: number, width: number): string {
  const unique = ++serial;
  return '{"u' + unique + '":1,"name":"n","below":[' + (levels ? Array.from({ length: width }, () => deepText(levels - 1, width)).join(",") : "") + '],"item":{"id":1,"v' + unique + '":2},"w' + unique + '":3}';
}

const roads: [string, (count: number) => boolean][] = [
  ["the writer's plans", count => {
    const text = holderText(kinds(count, (unique, at) => '{"id":' + at + ',"k' + unique + '":' + at + "}"));
    const holder = JSON.parse(text) as Holder;
    return JSON.stringify(holder) === text && JSON.stringify(holder) === text && JSON.stringify([holder, holder]) === "[" + text + "," + text + "]" && JSON.stringify({ h: holder }) === '{"h":' + text + "}";
  }],
  ["the writer's plans, three keys in other orders", count => {
    const text = holderText(kinds(count, (unique, at) => '{"p' + unique + '":1,"id":' + at + ',"q' + unique + '":"two","r' + unique + '":[3]}'));
    const holder = JSON.parse(text) as Holder;
    return JSON.stringify(holder) === text && JSON.stringify(holder.items) === text.slice(text.indexOf("[{"), text.indexOf("}]") + 2) && JSON.stringify(holder) === text;
  }],
  ["key orders, each text parsed three times", count => {
    const text = holderText(kinds(count, (unique, at) => (at % 2 ? '{"k' + unique + '":1,"id":' + at + "}" : '{"id":' + at + ',"k' + unique + '":1,"m":2}')));
    let good = true;
    for (let round = 0; round < 3; round++) good = JSON.stringify(JSON.parse(text) as Holder) === text && good;
    return good;
  }],
  ["known members, runs of three, each text parsed four times", count => {
    const text = holderText(kinds(count, (unique, at) => '{"id":' + at + ',"a' + unique + '":1,"b' + unique + '":"two","c' + unique + '":[3]}'));
    let good = true;
    for (let round = 0; round < 4; round++) good = JSON.stringify(JSON.parse(text) as Holder) === text && good;
    return good;
  }],
  ["known members that fall on the same places", count => {
    const items = kinds(Math.min(count, 20000), (unique, at) => '{"id":' + at + ',"aa' + (unique % 97) + '":1,"aa' + (unique % 89) + 'x":2,"aa' + unique + '":3}');
    const text = holderText(items);
    let good = true;
    for (let round = 0; round < 4; round++) good = JSON.stringify(JSON.parse(text) as Holder) === JSON.stringify(plainParse(text)) && good;
    return good;
  }],
  ["conversions of plain objects: a cast", count => {
    const text = holderText(kinds(count, (unique, at) => '{"k' + unique + '":1,"id":' + at + "}"));
    return JSON.stringify(plainParse(text) as Holder) === text && JSON.stringify(plainParse(text) as Holder) === text;
  }],
  ["conversions of plain objects: the parser gives up", count => {
    const text = holderText(kinds(count, (unique, at) => '{"k' + unique + '":1,"id":' + at + "}"));
    return JSON.stringify(JSON.parse(text.replace('"first"', '"\\u0066irst"')) as Holder) === text;
  }],
  ["conversions by a tag", count => {
    const text = holderText(kinds(count, (unique, at) => ['{"k' + unique + '":1,"kind":"a","a":1}', '{"kind":"b","k' + unique + '":1,"b":2}', '{"c":3,"kind":"c","k' + unique + '":1}'][at % 3]));
    return JSON.stringify(plainParse(text) as Tags) === text && JSON.stringify(JSON.parse(text) as Tags) === text && JSON.stringify(JSON.parse(text.replace('"first"', '"\\u0066irst"')) as Tags) === text;
  }],
  ["copies of typed objects", count => {
    const text = holderText(kinds(count, (unique, at) => '{"id":' + at + ',"k' + unique + '":' + at + "}"));
    const holder = JSON.parse(text) as Holder;
    const copy: Holder = { ...holder };
    const spread = { ...holder, items: holder.items.map(item => ({ ...item })) };
    return JSON.stringify(copy) === text && JSON.stringify(spread) === text && JSON.stringify(holder) === text;
  }],
  ["a tree whose every record has keys of its own", count => {
    const levels = count < 300 ? 3 : count < 5000 ? 6 : count < 20000 ? 7 : 8;
    const text = deepText(levels, 3);
    const deep = JSON.parse(text) as Deep;
    return JSON.stringify(deep) === text && JSON.stringify(plainParse(text) as Deep) === text && JSON.stringify(JSON.parse(text) as Deep) === text;
  }],
  ["shapes learned by JSON.parse without a type", count => {
    const size = Math.min(count, 5000);
    const text = holderText(kinds(size, (unique, at) => '{"id":' + at + ',"s' + (unique % (size + 3)) + '":{"t' + (unique % 19) + '":[{"u' + (unique % 301) + '":1}]}}'));
    const written = JSON.stringify(plainParse(text));
    let good = true;
    for (let round = 0; round < 40; round++) good = JSON.stringify(globalThis.JSON.parse(text)) === written && good;
    return good;
  }],
  ["shapes expected by an annotated variable", count => {
    const size = Math.min(count, 5000);
    const text = holderText(kinds(size, (unique, at) => '{"id":' + at + ',"s' + (unique % (size + 3)) + '":{"t' + (unique % 19) + '":1}}'));
    let good = true;
    for (let round = 0; round < 40; round++) {
      const holder: Holder = globalThis.JSON.parse(text);
      good = holder.items.length === size && JSON.stringify(holder) === text && good;
    }
    return good;
  }],
  ["many small texts, each of a kind of its own", count => {
    let good = true;
    for (let at = 0; at < count; at++) {
      const unique = ++serial;
      const text = '{"left":{"id":1,"l' + unique + '":1},"m' + unique + '":{"n":2},"right":{"r' + unique + '":[3],"id":2}}';
      const pair = JSON.parse(text) as Pair;
      good = JSON.stringify(pair) === text && Object.keys(pair).length === 3 && good;
    }
    return good;
  }],
];

const only = Number((globalThis as any).arguments?.[0] ?? -1);
roads.forEach(([label, run], at) => {
  if (only >= 0 && only !== at) return;
  const wrong = counts.filter(count => !run(count));
  console.log(label + ": " + counts.length + " counts: " + wrong.length + " differ" + (wrong.length ? " (" + wrong.join() + ")" : ""));
});
//// json-parse-type-argument-field-without-slot.ts
// A declared field that gets no slot comes before parsed fields, so a parsed field's number at run time is lower than its position in the type.
type UnusedFirst = { a?: never; b: string; c?: number };
type UnusedBetween = { b: string; a?: never; c?: number; z?: never; d?: boolean };
type UnusedInWideType = {
  a?: never; k0?: number; k1?: number; k2?: number; k3?: number; k4?: number; k5?: number; k6?: number;
  z?: never; k7?: number; k8?: number; k9?: number; k10?: number; k11?: number; k12?: number; k13?: number; k14?: number;
};

function show(label: string, text: string, value: object): void {
  const inLoop: string[] = [];
  for (const key in value) inLoop.push(key);
  console.log(label, text, Object.keys(value).join(), inLoop.join(), JSON.stringify(value));
}

const wideMembers = Array.from({ length: 15 }, (_, index) => '"k' + index + '":' + index);
const wideTexts = [
  "{" + wideMembers.join(",") + "}",
  "{" + wideMembers.slice().reverse().join(",") + "}",
  "{" + wideMembers.slice(7).concat(wideMembers.slice(0, 7)).join(",") + "}",
  "{" + wideMembers[14] + "," + wideMembers[0] + "}",
];

for (let round = 0; round < 3; round++) {
  for (const text of ['{"b":"x"}', '{"c":1,"b":"x"}', '{"b":"x","c":1}', '{"c":1,"o":2,"b":"x"}'])
    show("unused first", text, JSON.parse(text) as UnusedFirst);
  for (const text of ['{"b":"x"}', '{"d":true,"c":1,"b":"x"}', '{"c":1,"d":false,"b":"x"}', '{"d":true,"b":"x"}'])
    show("unused between", text, JSON.parse(text) as UnusedBetween);
  for (const text of wideTexts)
    show("unused in a wide type", text, JSON.parse(text) as UnusedInWideType);
}

const parsed = JSON.parse('{"c":2,"b":"y"}') as UnusedFirst;
console.log(parsed.b, parsed.c);
//// json-parse-type-argument-first-object-has-many-undeclared-keys.ts
// The first object of a type, before anything is learned about it, has 1 to 1,100 undeclared keys; the second as many, fewer or more.
const host: any = globalThis;
const collect: () => void = host.Bun ? () => host.Bun.gc(true) : host.gc;
let serial = 0;
function longText(): string {
  return '"text number ' + ++serial + ' is too long for a cache of short strings"';
}
////= freshValue

type F0 = { first0: number; second0: string };
type F1 = { first1: number; second1: string };
type F2 = { first2: number; second2: string };
type F3 = { first3: number; second3: string };
type F4 = { first4: number; second4: string };
type F5 = { first5: number; second5: string };
type F6 = { first6: number; second6: string };
type F7 = { first7: number; second7: string };
type F8 = { first8: number; second8: string };
type F9 = { first9: number; second9: string };
type F10 = { first10: number; second10: string };
type F11 = { first11: number; second11: string };
type F12 = { first12: number; second12: string };
type F13 = { first13: number; second13: string };
type F14 = { first14: number; second14: string };
type F15 = { first15: number; second15: string };
type F16 = { first16: number; second16: string };
type F17 = { first17: number; second17: string };
type F18 = { first18: number; second18: string };
type F19 = { first19: number; second19: string };
type F20 = { first20: number; second20: string };
function textOf(type: number, count: number, place: number): string {
  const others: string[] = [];
  for (let at = 0; at < count; at++) others.push('"o' + at + '":' + freshValue(at));
  const declared = ['"first' + type + '":' + count, '"second' + type + '":' + longText()];
  return "{" + (place === 0 ? [...declared, ...others] : place === 1 ? [...others, ...declared] : [declared[0], ...others, declared[1]]).join(",") + "}";
}
function check(label: string, parse: (text: string) => unknown, type: number, count: number): void {
  let different = 0;
  const kept: [unknown, string][] = [];
  for (const next of [count, count, 1, count + 1, count * 2, 0, count]) {
    for (let place = 0; place < 3; place++) {
      const text = textOf(type, next, place);
      const value = parse(text);
      if (JSON.stringify(value) !== text) different++;
      kept.push([value, text]);
    }
  }
  for (const [value, text] of kept) if (JSON.stringify(value) !== text) different++;
  console.log(label + ": " + different + " differ");
}
check("the first has 1", text => JSON.parse(text) as F0, 0, 1);
check("the first has 2", text => JSON.parse(text) as F1, 1, 2);
check("the first has 3", text => JSON.parse(text) as F2, 2, 3);
check("the first has 4", text => JSON.parse(text) as F3, 3, 4);
check("the first has 5", text => JSON.parse(text) as F4, 4, 5);
check("the first has 6", text => JSON.parse(text) as F5, 5, 6);
check("the first has 7", text => JSON.parse(text) as F6, 6, 7);
check("the first has 8", text => JSON.parse(text) as F7, 7, 8);
check("the first has 9", text => JSON.parse(text) as F8, 8, 9);
check("the first has 16", text => JSON.parse(text) as F9, 9, 16);
check("the first has 17", text => JSON.parse(text) as F10, 10, 17);
check("the first has 32", text => JSON.parse(text) as F11, 11, 32);
check("the first has 33", text => JSON.parse(text) as F12, 12, 33);
check("the first has 63", text => JSON.parse(text) as F13, 13, 63);
check("the first has 64", text => JSON.parse(text) as F14, 14, 64);
check("the first has 65", text => JSON.parse(text) as F15, 15, 65);
check("the first has 100", text => JSON.parse(text) as F16, 16, 100);
check("the first has 200", text => JSON.parse(text) as F17, 17, 200);
check("the first has 300", text => JSON.parse(text) as F18, 18, 300);
check("the first has 1000", text => JSON.parse(text) as F19, 19, 1000);
check("the first has 1100", text => JSON.parse(text) as F20, 20, 1100);
//// json-parse-type-argument-hundreds-of-orders-of-declared-keys.ts
// Types of 1 to 65 members are given their keys in hundreds of orders, each order again and again, two types with the same members in turn, with optional members left out and undeclared keys between: what remembers an order of declared keys is filled, turned over and emptied by collections.
