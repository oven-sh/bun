////: lines-7
function «1»(limit: number): number {
  seed = (Math.imul(seed, 1103515245) + 12345) & 0x7fffffff;
  return (seed >>> 8) % limit;
}
////: lines-8
function «1»(value: «2»): string {
  const leaf = value.a.b.c.d.e.v;
  return typeof leaf === "string" ? "text " + leaf : "number " + (leaf + 1);
}
////: list
const list = (item: Make, low = 0, high = 4): Make => depth => {
  const items: string[] = [];
  for (let count = depth > 5 ? low : low + below(high - low + 1); count > 0; count--) items.push(item(depth + 1));
  return "[" + items.join(",") + "]";
};
////: measure
function measure(label: string, texts: string[]) {
  let wrong = 0;
  for (const text of texts) {
    const value: unknown = JSON.parse(text);
    if (JSON.stringify(value) !== «1») wrong++;
  }
  console.log(label + ": " + texts.length + " texts, " + wrong + " wrong");
}
////: mutate
function mutate(text: string): string {
  switch (below(16)) {
    case 0: {
      const at = below(text.length + 1);
      return text.slice(0, at) + choice(intruders) + text.slice(at + 1);
    }
    case 1: {
      const at = below(text.length + 1);
      return text.slice(0, at) + choice(intruders) + text.slice(at);
    }
    case 2:
      return text.slice(0, below(text.length + 1));
    case 3:
      return text.slice(below(text.length + 1));
    case 4: {
      const at = below(text.length + 1);
      return text.slice(0, at) + text.slice(at + 1 + below(4));
    }
    case 5: {
      const found = tokens(text);
      found.splice(below(found.length), 1 + below(3));
      return found.join("");
    }
    case 6: {
      const found = tokens(text);
      const at = below(found.length);
      found.splice(at, 0, ...found.slice(at, at + 1 + below(4)));
      return found.join("");
    }
    case 7: {
      const found = tokens(text);
      const one = below(found.length);
      const other = below(found.length);
      const held = found[one];
      found[one] = found[other];
      found[other] = held;
      return found.join("");
    }
    case 8:
      return tokens(text).map(token => (chance(0.3) ? choice(spaces) + token : token)).join("") + (chance(0.3) ? choice(spaces) : "");
    case 9:
      return tokens(text).map(token => (token.length > 2 && token[0] === '"' && token[1] !== "\\" && token.charCodeAt(1) < 0xd800 && chance(0.4) ? '"\\u' + token.charCodeAt(1).toString(16).padStart(4, "0") + token.slice(2) : token)).join("");
    case 10: {
      const found = tokens(text);
      const at = below(found.length);
      const levels = chance(0.1) ? 200 + below(3000) : 1 + below(70);
      found[at] = chance(0.5) ? "[".repeat(levels) + found[at] + "]".repeat(levels) : '{"n":'.repeat(levels) + found[at] + "}".repeat(levels);
      return found.join("");
    }
    case 11: {
      const found = tokens(text);
      const at = below(found.length);
      found[at] = choice([text, "null", "0", '""', "[]", "{}", "true", "-0", "1e999", '"' + "x".repeat(below(300)) + '"', "9".repeat(1 + below(40)), "[" + text + "," + text + "]"]);
      return found.join("");
    }
    case 12: {
      const found = tokens(text);
      for (let at = 0; at < found.length; at++) if (/^-?[0-9]/.test(found[at]) && chance(0.5)) found[at] = choice([found[at] + ".0", found[at] + "e0", "-" + found[at], "0" + found[at], found[at] + ".", found[at] + "e", "+" + found[at], found[at] + "0".repeat(below(30)), found[at] + "." + "0".repeat(below(30)) + "1"]);
      return found.join("");
    }
    case 13:
      return choice(["﻿", " ", "\u0000", "//c\n", "[", "{", ""]) + text + choice(["\u0000", " ", "\n", ",", "]", "}", "x", "﻿", text, ""]);
    case 14: {
      const start = below(text.length);
      const piece = text.slice(start, start + 1 + below(20));
      const at = below(text.length + 1);
      return text.slice(0, at) + piece + text.slice(at);
    }
    default:
      return mutate(mutate(text));
  }
}
////: record
const record = (members: [string, Make, boolean?][], extra: Make | null = anything): Make => depth => {
  let written: string[] = [];
  for (const [name, make, isOptional] of members) if (!isOptional || chance(0.6)) written.push('"' + name + '":' + make(depth + 1));
  const others = keys.filter(key => !members.some(member => member[0] === globalThis.JSON.parse(key)));
  if (extra && chance(0.3)) for (let count = 1 + below(chance(0.1) ? 40 : 3); count > 0; count--) written.splice(below(written.length + 1), 0, (chance(0.5) ? choice(others) : '"u' + below(50) + '"') + ":" + extra(depth + 1));
  if (chance(0.25)) written = shuffle(written);
  if (chance(0.05) && written.length) written.splice(below(written.length + 1), 0, choice(written));
  return "{" + written.join(",") + "}";
};
////: represent
function represent(text: string): string {
  switch (below(8)) {
    case 0:
      return (text + "Ā").slice(0, -1);
    case 1: {
      const at = below(text.length + 1);
      return text.slice(0, at) + text.slice(at);
    }
    case 2: {
      let rope = "";
      for (let at = 0; at < text.length; at += 7) rope += text.slice(at, at + 7);
      return rope;
    }
    case 3:
      return ("padding " + text + " padding").slice(8, -8);
    default:
      return text;
  }
}
////: say
function say(label: string, run: (text: string) => any, text: string): void {
  let said = "";
  try {
    const made = run(text);
    said = JSON.stringify(made).replace('"m":1', '"n":1') === text && (made.n ?? made.m) + 1 === 2 ? "taken" : "DIFFERENT";
  } catch (error: any) {
    said = error.name;
  }
  console.log(label + ": " + said);
}
////: shuffle
function shuffle<T>(items: T[]): T[] {
  for (let at = items.length - 1; at > 0; at--) {
    const other = below(at + 1);
    const held = items[at];
    items[at] = items[other];
    items[other] = held;
  }
  return items;
}
////: stringOf
function stringOf(length: number, from: readonly string[]): string {
  let text = '"';
  for (let at = 0; at < length; at++) text += choice(from);
  return text + '"';
}
////: tokens
function tokens(text: string): string[] {
  const found: string[] = [];
  for (let at = 0; at < text.length; ) {
    let end = at + 1;
    const first = text[at];
    if (first === '"') {
      while (end < text.length && text[end] !== '"') end += text[end] === "\\" ? 2 : 1;
      end++;
    } else if (/[-0-9a-zA-Z.+]/.test(first)) while (end < text.length && /[-0-9a-zA-Z.+]/.test(text[end])) end++;
    found.push(text.slice(at, end));
    at = end;
  }
  return found;
}
//// json-parse-long-names-that-differ-in-the-middle.ts
// Keys of 15 to 48 characters that begin and end alike and differ only in the middle, in one place of a text and in the same order, so that each must be told from the one expected there.
function show(label: string, text: string) {
  for (let turn = 0; turn < 3; turn++) {
    const value = JSON.parse(text) as Record<string, unknown>;
    console.log(label, turn, Object.keys(value).join(), JSON.stringify(value) === text);
  }
}
for (const length of [15, 16, 17, 18, 23, 24, 25, 32, 33, 40, 47, 48]) {
  const name = (middle: string) => "beginning" .slice(0, 7) + middle.repeat(length - 14) + "theends";
  show("length " + length + ", the first", '{"lead":1,"' + name("a") + '":1,"tail":2}');
  show("length " + length + ", another middle", '{"lead":1,"' + name("b") + '":1,"tail":2}');
  show("length " + length + ", one character more", '{"lead":1,"' + name("a") + 'x":1,"tail":2}');
  show("length " + length + ", both", '{"lead":1,"' + name("a") + '":1,"' + name("b") + '":2,"tail":3}');
  show("length " + length + ", the first again", '{"lead":1,"' + name("a") + '":1,"tail":2}');
}
//// json-parse-many-kinds-told-apart-by-the-first-value.ts
// Ten kinds of text that begin with the same key, whose value names the kind; together they have more names than one shape holds. They are told apart by more of their beginning, and each kind is served by itself; a kind whose keys are new every time is set aside alone.
function textOf(kind: number, at: number): string {
  let text = '{"kind":"number' + kind + '"';
  for (let member = 0; member < 8; member++) text += ',"k' + kind + "m" + member + '":' + (at + member);
  return text + "}";
}
////= measure	text
const many = (count: number, make: (at: number) => string) => Array.from({ length: count }, (_, at) => make(at));
measure("ten kinds, the first 200", many(200, at => textOf(at % 10, at)));
measure("ten kinds, the next 1,000", many(1000, at => textOf(at % 10, at)));
measure("nine kinds and one whose keys are new every time", many(1000, at => (at % 10 ? textOf(at % 10, at) : '{"kind":"number0","new' + at + '":1}')));
measure("the nine kinds alone", many(900, at => textOf(1 + (at % 9), at)));
//// json-parse-records-with-array-members.ts
// JSON.parse(text) claimed as a record with array members: the arrays have parsers of their own, and a row, an array or a member that does not fit its type is plain data. What fits is read through its types, what does not is looked at as `unknown`, and changing the arrays afterwards gives what plain Bun gives.
// STATISTIC: ParsersCreated >= 5
type Row = { id: number; tags: string[] };
type Page = { items: Row[]; grid: number[][]; total: number };
type Changed = { list: number[]; name: string };

function read(page: Page): string {
  let text = "total " + page.total;
  const items = page.items;
  if (!items) return text + ", items " + items;
  text += ", " + items.length + " items";
  for (const row of items) text += " [" + row.id + ":" + (row.tags ? row.tags.join("+") : row.tags) + "]";
  for (let at = 0; at < items.length; at++) text += " " + items[at]!.id;
  const grid = page.grid;
  if (!grid) return text + ", grid " + grid;
  let sum = 0;
  for (const line of grid) for (const cell of line) sum += cell;
  return text + ", grid sum " + sum + ", past the end " + items[items.length] + " " + grid[grid.length] + ", ids " + items.map(row => row.id).join();
}

////= describe

for (const text of [
  '{"items":[{"id":1,"tags":["a","b"]},{"id":2,"tags":[]}],"grid":[[1,2],[3]],"total":2}',
  '{"items":[],"grid":[],"total":0}',
  '{ "total": 1, "grid": [ [ ] ], "items": [ { "tags": [ "c" ], "id": 3 } ] }',
  '{"items":[{"id":4}],"grid":[[1.5,-0,1e3]],"total":1}',
  '{"items":null,"grid":null,"total":0}',
  '{"grid":[[1]],"total":0}',
  '{"items":[],"total":0}',
  '{"items":[{"id":10,"tags":[]}],"items":[{"id":11,"tags":["g"]}],"grid":[],"total":1}',
  '{"items":[{"id":12,"tags":[],"more":[1]}],"grid":[],"total":1,"extra":[{"id":13}]}',
]) {
  const page = JSON.parse(text) as Page;
  console.log(read(page));
  console.log(describe(page));
}

for (const text of [
  '{"items":[1,{"id":4,"tags":["d"]},"row",null,[5],true],"grid":[[1]],"total":6}',
  '{"items":[{"id":"six","tags":"none"},{"id":7},{}],"grid":[[1]],"total":3}',
  '{"items":[{"id":8,"tags":[1,null,["e"],{"f":1}]}],"grid":[[1]],"total":1}',
  '{"items":[],"grid":[[1,"two",null,[3],{"four":4}],"line",5,null,{"six":6}],"total":0}',
  '{"items":"none","grid":[],"total":0}',
