//// method-type-arg-without-prototype.ts
// A method of a class passes a record type as an explicit type argument to a generic function and the object has no prototype. Nothing in the program creates an object of that type, and the only cast is `as R` inside the generic function. Data from JSON.parse that matches the type must be accepted, as in plain Bun.
type Part = { id?: number; name?: string; more?: unknown }
type Waiting = { resolve: (result: unknown) => void; reject: (error: unknown) => void }
class Unrelated { k = 1; j = 2; e = 3; ok = 4; a = 5; b = 6; c = 7; d = 8 }
const unrelated = new Unrelated()
if (unrelated.k + unrelated.j + unrelated.e + unrelated.ok + unrelated.a + unrelated.b + unrelated.c + unrelated.d < 0) console.log('never')
const waiting = new Map<number, Waiting>()
const seen: unknown[] = []
let next = 0
////= arrive-2
function bare<R>(): Promise<R> { const made: any = Object.create(null); made.k = { id: 1 }; return Promise.resolve(made as R) }
class Caller { async ask() { const answer = await bare<{ k: Part }>(); return [answer.k, Object.getPrototypeOf(answer)] } }
console.log(JSON.stringify(await new Caller().ask()))
//// mutually-recursive-records-accept-untyped.ts
// Record types that hold each other through arrays, dictionaries, maps and unions. Untyped values enter at each of them in turn, in several functions, so what stays untyped within a type is asked from many starting points that lead to the same records. Objects the program makes itself go the same ways. The output must match plain Bun.
interface Branch { name: string; twigs: Twig[]; parent?: Branch }
interface Twig { length: number; leaves: Leaf[]; branch?: Branch }
interface Leaf { color: string; twig?: Twig; veins: { [name: string]: Vein } }
interface Vein { width: number; next: Vein | null; leaf?: Leaf }
type Either = { kind: "branches"; held: Branch[] } | { kind: "twigs"; held: Twig[]; more: number };
interface Wide { a: number; b: number; c: number; d: number; e: number; f: number; g: number; inner: Wide[] }

////= lines-5	parse	any

function widthOf(vein: Vein | null): number {
  let sum = 0;
  for (let at = vein; at; at = at.next) sum += at.width;
  return sum;
}

function describeLeaf(leaf: Leaf): string {
  const names = Object.keys(leaf.veins).sort();
  return `${typeof leaf.color}:${leaf.color}[${names.map(name => `${name}=${widthOf(leaf.veins[name])}`).join(",")}]`;
}

function describeTwig(twig: Twig): string {
  return `${twig.length}(${twig.leaves.map(describeLeaf).join(" ")})`;
}

function describeBranch(branch: Branch): string {
  return `${branch.name}<${branch.twigs.map(describeTwig).join("|")}>${branch.parent ? "^" + branch.parent.name : ""}`;
}

function describeEither(either: Either): string {
  return either.kind === "branches" ? either.held.map(describeBranch).join(";") : `${either.more}:${either.held.map(describeTwig).join(";")}`;
}

function sumOfWide(wide: Wide): number {
  return wide.a + wide.b + wide.c + wide.d + wide.e + wide.f + wide.g + wide.inner.reduce((sum, inner) => sum + sumOfWide(inner), 0);
}

const leafText = '{"color":"green","veins":{"x":{"width":1,"next":{"width":2,"next":null}},"y":{"width":5,"next":null}}}';
const twigText = `{"length":2,"leaves":[${leafText},{"color":"brown","veins":{}}]}`;
const branchText = `{"name":"low","twigs":[${twigText}],"parent":{"name":"trunk","twigs":[]}}`;

function enterAtBranch(): void {
  const branch: Branch = parse(branchText);
  console.log(describeBranch(branch));
}

function enterAtTwig(): void {
  const twig: Twig = parse(twigText);
  console.log(describeTwig(twig));
  const twigs: Twig[] = parse(`[${twigText},${twigText}]`);
  console.log(twigs.map(describeTwig).join(" & "));
}

function enterAtLeaf(): void {
  const leaves = new Map<string, Leaf>();
  leaves.set("parsed", parse(leafText));
  leaves.set("made", { color: "red", veins: { z: { width: 3, next: null } } });
  for (const [name, leaf] of leaves) console.log(name, describeLeaf(leaf));
}

function enterAtVein(): void {
  const veins: { [name: string]: Vein } = parse('{"p":{"width":4,"next":{"width":4,"next":{"width":4,"next":null}}}}');
  console.log(widthOf(veins.p));
  const own: Vein = { width: 1, next: null };
  own.next = parse('{"width":10,"next":null}');
  console.log(widthOf(own));
}

function enterAtEither(): void {
  const first: Either = parse(`{"kind":"branches","held":[${branchText}]}`);
  const second: Either = parse(`{"kind":"twigs","held":[${twigText}],"more":9}`);
  const third: Either = { kind: "twigs", held: [{ length: 1, leaves: [] }], more: 1 };
  for (const either of [first, second, third]) console.log(describeEither(either));
}

function enterAtWide(): void {
  const wide: Wide = parse('{"a":1,"b":2,"c":3,"d":4,"e":5,"f":6,"g":7,"inner":[{"a":1,"b":1,"c":1,"d":1,"e":1,"f":1,"g":1,"inner":[]}]}');
  console.log(sumOfWide(wide));
  const list: Wide[] = [wide, { a: 0, b: 0, c: 0, d: 0, e: 0, f: 0, g: 1, inner: [] }];
  console.log(list.map(sumOfWide).join(","));
}

function madeHere(): void {
  const trunk: Branch = { name: "trunk", twigs: [] };
  const leaf: Leaf = { color: "gold", veins: {} };
  const twig: Twig = { length: 3, leaves: [leaf], branch: trunk };
  leaf.twig = twig;
  leaf.veins.only = { width: 8, next: null, leaf };
  trunk.twigs.push(twig);
  const high: Branch = { name: "high", twigs: [twig], parent: trunk };
  console.log(describeBranch(trunk), describeBranch(high), leaf.veins.only.leaf === leaf, twig.branch === trunk);
}

enterAtBranch();
enterAtTwig();
enterAtLeaf();
enterAtVein();
enterAtEither();
enterAtWide();
madeHere();
enterAtVein();
enterAtBranch();
//// name-narrowed-to-tainted-type.ts
// A value that was checked against its type where it was created keeps that type although a type guard later narrows a variable for it to another type.
type Child = { d: PropertyDescriptor | null }
type Alike = { get: () => string }
function guard(d: PropertyDescriptor): d is PropertyDescriptor & { get(): string } { return typeof d.get === "function" }
function tell(child: Child): string {
  const once = () => {
    const s = child.d!
    if (guard(s)) { return "get " + s.get() } else { return "none " + s.value }
  }
  return once()
}
const alike = JSON.parse('{}') as Alike
const given = JSON.parse('{"d":{"value":"v"}}') as Child
console.log(typeof alike.get, tell(given), tell({ d: { get: () => "g" } }))
//// names-next-to-index-signature.ts
// The program adds named, required members to NodeJS.ProcessEnv, as everybody does. No real environment holds them all. A type with an index signature is a dictionary: a name declared beside the signature is what a read may expect, never a demand.
declare global { namespace NodeJS { interface ProcessEnv { APP_MODE: string; REQUEST_LIMIT_MS: string; MY_FLAG?: "0" | "1" } } }
const row = (name: string, f: () => unknown) => { let r: unknown; try { r = f(); } catch (e) { r = "THROWS " + (e as Error).message.split(" (bun")[0].split("\n").join(" ~ "); } console.log(name + ": " + (typeof r === "string" ? r : JSON.stringify(r))); };
const only = (env: Record<string, string | undefined>) => Object.keys(env).filter(name => /^(X|Y|APP_MODE|REQUEST_LIMIT_MS|MY_FLAG)$/.test(name)).sort().map(name => name + "=" + env[name]).join();
for (const name of ["APP_MODE", "REQUEST_LIMIT_MS", "MY_FLAG", "X", "Y"]) delete (process.env as Record<string, string | undefined>)[name];
function withX(base: NodeJS.ProcessEnv): NodeJS.ProcessEnv { return { ...base, X: "1" }; }
function fromProcess(): NodeJS.ProcessEnv { return { ...process.env, X: "1" }; }
function fromBun(): NodeJS.ProcessEnv { return { ...Bun.env, X: "1" }; }
function fresh(): NodeJS.ProcessEnv { const made: Record<string, string> = { X: "1" }; return made as NodeJS.ProcessEnv; }
function copied(): NodeJS.ProcessEnv { const copy = { ...process.env }; copy.Y = "2"; return copy; }
function assigned(): NodeJS.ProcessEnv { return Object.assign({}, process.env, { X: "1" }); }
function takes(env: NodeJS.ProcessEnv) { return only(env); }
row("a declared result, a spread of a parameter", () => only(withX(process.env)));
row("a declared result, a spread of process.env", () => only(fromProcess()));
row("a declared result, a spread of Bun.env", () => only(fromBun()));
row("as NodeJS.ProcessEnv", () => only(fresh()));
row("a copy, stored to, returned", () => only(copied()));
row("Object.assign", () => only(assigned()));
row("a spread of a spread", () => only(withX(withX(fromProcess()))));
row("into a variable", () => { const env: NodeJS.ProcessEnv = { ...process.env, X: "1" }; return only(env); });
row("an argument", () => takes({ ...process.env, X: "1" }));
row("process.env itself an argument", () => takes(process.env));
row("a required name that is not there is read", () => [typeof process.env.APP_MODE, typeof withX(process.env).APP_MODE, typeof fromProcess().REQUEST_LIMIT_MS]);
row("and used", () => { const env = fromProcess(); return [(env.APP_MODE ?? "none"), env.APP_MODE === "production", String(env.REQUEST_LIMIT_MS), Number(env.REQUEST_LIMIT_MS || 5)]; });
row("stored, read, deleted", () => { const env = fromProcess(); env.APP_MODE = "test"; const was = env.APP_MODE; delete (env as Record<string, string | undefined>).APP_MODE; return [was, typeof env.APP_MODE, "APP_MODE" in env]; });
row("handed to spawnSync({ env })", () => Bun.spawnSync({ cmd: ["/bin/sh", "-c", "echo $X $APP_MODE"], env: withX(process.env) }).stdout.toString().trim());
row("handed to spawnSync({ env }) as a literal", () => Bun.spawnSync({ cmd: ["/bin/sh", "-c", "echo $X $APP_MODE"], env: { ...process.env, X: "1" } }).stdout.toString().trim());
row("import.meta.env", () => { const env: NodeJS.ProcessEnv = { ...import.meta.env, X: "1" }; return only(env); });
row("a literal with every declared name", () => { const full: NodeJS.ProcessEnv = { APP_MODE: "test", REQUEST_LIMIT_MS: "1" }; full.X = "1"; return [only(full), only(withX(full)), takes(full)]; });
interface Table { [name: string]: number; total: number }
function table(more: Record<string, number>): Table { return { ...more } as Table; }
function tableOf(data: unknown): Table { return data as Table; }
row("a dictionary of the program's with a declared name: a cast", () => [JSON.stringify(table({ a: 1 })), Object.keys(table({ a: 1 })), table({ total: 3 }).total]);
row("a dictionary of the program's: data from outside", () => { const t = tableOf(JSON.parse('{"a":1}')); return [JSON.stringify(t), "total" in t, t.a]; });
row("a dictionary of the program's: a literal with the name", () => { const t: Table = { total: 1, b: 2 }; t.c = 3; return [JSON.stringify(t), t.total + t.b + t.c]; });
//// namespace-member-read-as-record.ts
// `Math` and `JSON` are native objects. They are read from `globalThis` through a type literal that lists one method of each.
const host = globalThis as {
  readonly Math: { readonly max: (a: number, b: number) => number }
  readonly JSON: { readonly stringify: (value: unknown) => string }
}
function box<Max>(max: Max): { readonly max: Max } {
  return { max }
}
function text<Stringify>(stringify: Stringify): { readonly stringify: Stringify } {
  return { stringify }
}
console.log(host.Math.max(1, 2), host.JSON.stringify([1]), box(3).max, text('t').stringify)
//// native-objects-inside-untyped-containers.ts
// A native object that has the members a type requires is accepted as that type, including when it arrives inside a container from untyped code.
// Each function writes `{ length: number }` again, so each one is checked on its own. One object literal of the program fits them all.
const own = { length: 7 };
console.log("own", own.length);

function untyped(value: unknown): any {
  (globalThis as any).stash = value;
  return (globalThis as any).stash;
}

function ofArray(list: { length: number }[]) {
  let total = 0;
  for (const item of list) total += item.length;
  return total;
}
function ofIterable(list: Iterable<{ length: number }>) {
  let total = 0;
  for (const item of list) total += item.length;
  return total;
}
function spread(list: Iterable<{ length: number }>) {
  return [...list].map(item => item.length).join();
}
function ofIterator(steps: Iterator<{ length: number }>) {
  return steps.next().value.length;
}
function ofSet(set: Set<{ length: number }>) {
  let total = 0;
  for (const item of set) total += item.length;
  return total;
}
function ofMap(map: Map<string, { length: number }>) {
  return map.get("key")!.length;
}
function ofRecord(record: Record<string, { length: number }>) {
  return record.key.length;
}
function ofFunction(make: () => { length: number }) {
  return make().length;
}
async function ofPromise(promise: Promise<{ length: number }>) {
  return (await promise).length;
}
////= lines-3	ofAsyncIterable	list	item
async function* later(value: unknown) {
  yield value;
}

const values: [string, unknown][] = [
  ["a typed array", new Uint8Array(3)],
  ["a Buffer", Buffer.from("four")],
  ["an array", [1, 2]],
  ["a string", "text!"],
  ["a function", function (a: number, b: number, c: number) {}],
  ["an object of the program", own],
  ["an object of untyped code", JSON.parse('{ "length": 9 }')],
];
for (const [what, value] of values) {
  console.log(
    what + ":",
    ofArray(untyped([value])),
    ofIterable(untyped([value])),
    ofIterable(untyped(new Set([value]))),
    spread(untyped([value, value])),
    ofIterator(untyped([value].values())),
    ofSet(untyped(new Set([value]))),
    ofMap(untyped(new Map([["key", value]]))),
    ofRecord(untyped({ key: value })),
    ofFunction(untyped(() => value)),
    await ofPromise(untyped(Promise.resolve(value))),
    await ofAsyncIterable(untyped(later(value))),
  );
}

// The function itself is passed to untyped code, which calls it with its own values.
console.log("by map", (await Promise.all(untyped([later(new Uint8Array(5)), later("ab")]).map(ofAsyncIterable))).join());
console.log("a stream", await ofAsyncIterable(untyped(new Response("hello").body)));

// A stream typed by the host's own declarations.
////= lines-3	ofStream	list	item
console.log("a stream, as the host declares it", await ofStream(new Response("hello!").body!));
//// nested-plain-objects-convert-children-first.ts
// Plain objects that hold plain objects, and arrays of plain objects, are read through record types: each stays the same object, a cycle and a shared child come out right, a member of the wrong kind throws where typed code reads it, and untyped code may store anything into any of them afterwards.
type Customer = { id: number; name: string };
type Item = { sku: string; quantity: number };
type Order = { customer: Customer; items: Item[]; coupon?: string };
type Node_ = { n: number; next: Node_ | null };

function makeOrder(i: number): Order {
  return { customer: { id: i, name: "made" }, items: [{ sku: "m", quantity: i }], coupon: "C" };
}
function makeNode(n: number): Node_ {
  return { n, next: null };
}
function weigh(order: Order): number {
  let sum = order.customer.id + order.customer.name.length;
  for (const item of order.items) sum += item.sku.length + item.quantity;
  return sum + (order.coupon === undefined ? 0 : order.coupon.length);
}
function walk(node: Node_, steps: number): number {
  let sum = 0;
  let at: Node_ | null = node;
  for (let i = 0; i < steps && at !== null; i++) {
    sum += at.n;
    at = at.next;
  }
  return sum;
}
function grow(i: number): any {
  return JSON.parse('{"customer":{"id":' + i + ',"name":"name ' + i + '"},"items":[{"sku":"a' + i + '","quantity":' + i + '},{"sku":"b","quantity":2}]}');
}
////= attempt

console.log(weigh(makeOrder(1)), walk(makeNode(2), 1));
let sum = 0;
const kept: any[] = [];
for (let i = 0; i < 2000; i++) {
  const plain = grow(i);
  const customer = plain.customer;
  const item = plain.items[0];
  kept.push(plain);
  sum += weigh(plain as Order);
  if (plain.customer !== customer || plain.items[0] !== item) console.log("not the same object", i);
}
console.log(sum);
console.log(JSON.stringify(kept[7]), Object.keys(kept[7].customer).join());

const shared: any = { id: 9 };
shared.name = "shared";
const left: any = { customer: shared };
left.items = [];
const right: any = { customer: shared };
right.items = [];
console.log(weigh(left as Order), weigh(right as Order), left.customer === right.customer);

const a: any = { n: 1 };
const b: any = { n: 2 };
a.next = b;
b.next = a;
console.log(walk(a as Node_, 5), a.next.next === a);

const badParent: any = { customer: null };
const goodChild: any = { id: 3 };
goodChild.name = "child";
badParent.customer = goodChild;
badParent.items = 7;
console.log(attempt(() => weigh(badParent as Order)), goodChild.id, goodChild.name, JSON.stringify(badParent));
console.log(attempt(() => { goodChild.id = "now text"; return goodChild.id; }));

const badChild: any = { customer: null };
const wrong: any = { id: "text" };
wrong.name = "wrong";
badChild.customer = wrong;
badChild.items = [];
console.log(attempt(() => weigh(badChild as Order)), JSON.stringify(badChild));

const mixed = grow(5);
mixed.items.push({ sku: 1, quantity: "x" });
console.log(attempt(() => weigh(mixed as Order)), JSON.stringify(mixed.items));

type Strict = { customer: Customer; items: number[] };
function makeStrict(i: number): Strict {
  return { customer: { id: i, name: "made" }, items: [i] };
}
function weighStrict(strict: Strict): number {
  return strict.items.length;
}
console.log(weighStrict(makeStrict(1)));
for (let i = 0; i < 100; i++) {
  const fits: any = { customer: null };
  const child: any = { id: i };
  child.name = "fits";
  fits.customer = child;
  fits.items = [i];
  weighStrict(fits as Strict);
}
const refused: any = { customer: null };
const untouched: any = { id: 1 };
untouched.name = "untouched";
refused.customer = untouched;
refused.items = 7;
console.log(attempt(() => weighStrict(refused as Strict)));
console.log(attempt(() => { untouched.id = "still plain"; return untouched.id; }));
//// non-null-on-mistyped-package-value/main.ts
// The package's declaration file is wrong about what these members hold. Reading them through `!` does not turn the declared types into checks.
import { find, holder } from "./package.js";

const found = find("a");
console.log("a method", String(find("a")!.pair()));
console.log("a method of a variable", String(found!.pair()));
console.log("a property", String(find("a")!.size));
console.log("a property of a property", String(holder.inner!.size), String(holder.inner!.pair()));
console.log("kept", typeof found!.count(), String(found!.count()));
const right = find("right")!.pair();
console.log("where the declaration is right", right.length, right[0] instanceof Uint8Array);
try {
  find("nothing")!.pair();
} catch (error) {
  console.log("nothing there", error instanceof TypeError);
}
//// non-null-on-mistyped-package-value/package.d.ts
export interface Holder {
  size: number;
  pair(): [Uint8Array, Uint8Array];
  count(): number;
}
export function find(name: string): Holder | null;
export const holder: { inner: Holder | null };
//// non-null-on-mistyped-package-value/package.js
function make(name) {
  return {
    size: name === "right" ? 2 : "size of " + name,
    pair() {
      return name === "right" ? [new Uint8Array(1), new Uint8Array(2)] : "pair of " + name;
    },
    count() {
      return "count of " + name;
    },
  };
}
export function find(name) {
  return name === "nothing" ? null : make(name);
}
export const holder = { inner: make("inner") };
//// objects-born-by-a-spread-hold-every-kind-of-property.ts
// A literal that spreads a typed record and defines more properties, one of them read through another property, in a callback whose result has no declared type, enters its record type as it is: whatever kinds those properties have, the object holds what the literal held. `as` converts nothing: a primitive of the wrong kind throws there, and undefined and null stay what they are.
type State = "open" | "closed";
interface Author { login: string }
interface Row { id: number; title: string; state: State; login: string }
interface ScoredRow extends Row { body: unknown; score: unknown }
interface OwnedRow extends Row { level: unknown; owner: unknown }
interface Mention { id: number; title: string; state: State; author: Author }
interface Scored extends Mention { body: string; score: number; flag: boolean }
interface Owned extends Mention { level: State; owner: Author; ratio: number }
interface TextRow extends Row { body: string }
interface Hit extends Mention { body: string; words: number }

function mentionOf(row: Row): Mention {
  return { id: row.id, title: row.title, state: row.state, author: { login: row.login } };
}
async function scored(all: ScoredRow[]): Promise<Scored[]> {
  const rows = await Promise.resolve(all);
  return rows.map(row => ({ ...mentionOf(row), body: row.body as string, score: row.score as number, flag: row.title.length > 2 }));
}
async function owned(all: OwnedRow[]): Promise<Owned[]> {
  const rows = await Promise.resolve(all);
  return rows.map(row => ({ ...mentionOf(row), level: row.level as State, owner: row.owner as Author, ratio: row.title.length / 2 }));
}
async function hits(all: TextRow[]): Promise<Hit[]> {
  const rows = await Promise.resolve(all);
  return rows.map(row => ({ ...mentionOf(row), body: row.body, words: row.body.length }));
}
const weighHit = (hit: Hit) => hit.id + hit.title + hit.state + hit.author.login + hit.body + hit.words;
const weighScored = (hit: Scored) => hit.id + hit.title + hit.state + hit.author.login + hit.body + hit.score + hit.flag;
const weighOwned = (hit: Owned) => hit.id + hit.title + hit.state + hit.author.login + hit.level + hit.owner.login + hit.ratio;
const owner: Author = { login: "o" };
const row = (i: number): Row => ({ id: i, title: "t" + i, state: i & 1 ? "open" : "closed", login: "u" });
const scoredRow = (i: number, body: unknown, score: unknown): ScoredRow => ({ ...row(i), body, score });
const ownedRow = (i: number, level: unknown, held: unknown): OwnedRow => ({ ...row(i), level, owner: held });
async function attemptScored(body: unknown, score: unknown): Promise<string> {
  try {
    const [hit] = await scored([scoredRow(4, body, score)]);
    return weighScored(hit) + " " + JSON.stringify(hit) + " " + Object.keys(hit).join();
  } catch (error) {
    return (error as Error).constructor.name;
  }
}
async function attemptOwned(level: unknown, held: unknown): Promise<string> {
  try {
    const [hit] = await owned([ownedRow(5, level, held)]);
    return weighOwned(hit) + " " + JSON.stringify(hit) + " " + Object.keys(hit).join();
  } catch (error) {
    return (error as Error).constructor.name;
  }
}

const allScored: ScoredRow[] = [];
const allOwned: OwnedRow[] = [];
const allText: TextRow[] = [];
for (let i = 0; i < 100; i++) {
  allScored.push(scoredRow(i, "b" + i, i));
  allOwned.push(ownedRow(i, i & 2 ? "open" : "closed", owner));
  allText.push({ ...row(i), body: "a body " + i });
}
await scored(allScored);
await owned(allOwned);
await hits(allText);
let length = 0;
for (let round = 0; round < 5; round++) {
  for (const hit of await scored(allScored)) length += weighScored(hit).length;
  for (const hit of await owned(allOwned)) length += weighOwned(hit).length;
  for (const hit of await hits(allText)) length += weighHit(hit).length;
}
console.log(length);
const [first] = await hits([allText[7]]);
console.log(weighHit(first), JSON.stringify(first), Object.keys(first).join());
console.log(await attemptScored("b", 3));
console.log(await attemptOwned("open", owner));
const [kept] = await owned([ownedRow(3, "open", owner)]);
console.log(kept.owner === owner, (() => { kept.ratio = 2; return JSON.stringify(kept) + Object.keys(kept).join(); })());
console.log("a body that is a number:", await attemptScored(5, 3));
console.log("a score that is a text:", await attemptScored("b", "x"));
console.log("a score that is a fraction:", await attemptScored("b", 1.25));
console.log("a score that is large:", await attemptScored("b", 2 ** 40));
console.log("a score that is undefined:", await attemptScored("b", undefined));
console.log("a level outside the union:", await attemptOwned("other", owner));
console.log("a level that is null:", await attemptOwned(null, owner));
console.log("an owner that is plain:", await attemptOwned("open", JSON.parse('{"login":"p"}')));
console.log("an owner that is a text:", await attemptOwned("open", "nobody"));
console.log("an owner that is undefined:", await attemptOwned("open", undefined));
//// objects-in-many-orders-of-names-come-and-go-between-collections.js
// Objects whose names come in very many orders are made, held over a collection, dropped and collected: now many of them, now few, now none.
const letters = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"];
function order(number) {
  const left = [...letters];
  const out = [];
  for (let size = left.length; size > 0; size--) {
    out.push(left.splice(number % size, 1)[0]);
    number = Math.floor(number / size);
  }
  return out;
}
const textOf = names => "{" + names.map((name, at) => '"' + name + '":' + at).join(",") + "}";

let from = 0;
function round(count, make) {
  let kept = [];
  for (let at = 0; at < count; at++) kept.push(make(order(from++)));
  Bun.gc(true);
  let wrong = 0;
  kept.forEach((value, at) => {
    if (Object.keys(value).join("") !== order(from - count + at).join("")) wrong++;
  });
  kept = [];
  Bun.gc(true);
  Bun.gc(true);
  return wrong;
}
const parsed = names => JSON.parse(textOf(names));
const written = names => {
  const made = {};
  for (const name of names) made[name] = 1;
  return made;
};
class Point {
  x = 0;
}
const onAnInstance = names => {
  const made = new Point();
  delete made.x;
  for (const name of names) made[name] = 1;
  return made;
};
for (const make of [parsed, written, onAnInstance]) {
  const line = [];
  for (const count of [100, 20000, 10, 5000, 40000, 1, 300, 20000, 0, 2500, 128, 256, 512, 1024, 2048, 4096, 8192, 4096, 2048, 1024, 512, 256, 128, 0]) line.push(count + ":" + round(count, make));
  console.log(make.name, line.join(" "));
}
//// objects-with-their-own-prototype-that-stop-fitting.ts
// An object with a prototype of its own passes for an interface. A member of the wrong kind throws where typed code reads it. What the
// prototype holds, or has lost, matters only to code that reads those members.
interface Tagged {
  readonly kind: string
  size: number
  describe(): string
}
const Proto = {
  kind: 'tagged',
  describe(this: Tagged) {
    return this.kind + ':' + this.size
  },
}
const make = (size: unknown): Tagged => {
  const self = Object.create(Proto)
  self.size = size
  return self
}
const dual: {
  <DataLast extends (...args: Array<any>) => any, DataFirst extends (...args: Array<any>) => any>(arity: number, body: DataFirst): DataLast & DataFirst
} = function (arity: number, body: Function) {
  return function (this: unknown) {
    if (arguments.length >= arity) return body.apply(this, arguments)
    const args = arguments
    return (self: any) => body(self, ...args)
  }
} as any
const later = <A>(evaluate: () => A): { run: () => A } => ({ run: evaluate })
const grow: {
  (by: number): (self: Tagged) => { run: () => number }
  (self: Tagged, by: number): { run: () => number }
} = dual(2, (self: Tagged, by: number) => later(() => self.size + by))
const attempt = (value: Tagged): string => {
  try {
    return String(grow(value, 1).run())
  } catch (error) {
    return error instanceof TypeError ? 'TypeError' : 'other ' + error
  }
}
console.log(attempt(make(1)), attempt(make(2)), attempt(make('three')), attempt(make(4)))
const untypedProto: any = Proto
untypedProto.kind = 5
console.log(attempt(make(6)))
untypedProto.kind = 'again'
console.log(attempt(make(7)))
delete untypedProto.describe
console.log(attempt(make(8)))
//// one-member-of-union.ts
// An object with the same property names and kinds as one member of a union arrives from JSON under another type.
declare const console: { log(...values: unknown[]): void };
type Done = { lines: string[] };
type Verdict =
  | { over: Done; halted?: string; text?: string; extra?: readonly string[]; goes?: undefined; cut?: true }
  | { over?: undefined; goes: { text: string; title: string | undefined; extra?: readonly string[] }; cut?: true };
type Run = { blocked?: string; cut?: true };
const goes = (text: string, title: string | undefined, extra?: readonly string[]): Verdict => ({ goes: { text, title, ...(extra !== undefined && extra.length > 0 && { extra }) } });
const never = (): Done => ({ lines: ["never"] });
const settled = (run: Run | undefined, text: string, title: string | undefined, extra?: readonly string[]): Verdict => !run ? { over: never() } : run.blocked ? { over: { lines: [run.blocked] }, halted: run.blocked } : { ...goes(text, title, extra), cut: run.cut };
function read(verdict: Verdict): string { if (verdict.over !== undefined) return "over " + verdict.over.lines.join() + " " + verdict.halted; const text = verdict.goes.text; return text + " " + verdict.goes.title + " " + (verdict.goes.extra ?? []).length + " " + verdict.cut; }
async function chain(run: Run | undefined, text: string): Promise<Verdict> { const verdict = settled(run, text, "title", ["x", "y"]); return verdict; }
async function use(run: Run | undefined, text: string): Promise<string> { let verdict: Verdict; if (text.length > 5) verdict = { goes: { text, title: undefined } }; else verdict = await chain(run, text); return read(verdict); }
const all = async () => console.log(await use({}, "e"), "|", await use({ cut: true }, "f"), "|", await use(undefined, "g"), "|", await use({ blocked: "b" }, "h"), "|", await use({}, "longer text"));
// v4: a record with the same names and kinds comes from JSON under another type.
type Alike = { over?: undefined; goes: { text: string; title: string | undefined }; cut?: true }; const alike = JSON.parse(`{"goes":{"text":"p","title":"q"}}`) as Alike; console.log(alike.goes.text); await all();
//// package-instances-as-small-records/main.ts
// A package written in JavaScript hands out instances of its own class, and its declaration file describes them by interfaces. The program holds them to smaller record types that it writes itself. The instances have every member, so they satisfy those types, the nested one too.
import type { ArrowFunctionExpression } from "./parser.js";
import * as parser from "./parser.js";
import * as walk from "./walker.js";
type Small = { async: boolean; expression: boolean; body: { start: number; end: number } };
type Span = { start: number; end: number };
function show(node: Small): string { return node.async + " " + node.expression + " " + node.body.start + " " + node.body.end; }
function span(node: Span): string { return node.start + ".." + node.end; }
class Keeper { kept: Small | undefined = undefined; keep(node: Small): void { this.kept = node; } }
function first(): ArrowFunctionExpression { return parser.parse("() => {}").body[0] as ArrowFunctionExpression; }
function narrow(): Small { return first(); }
function attempt(name: string, f: () => string): void { try { console.log(name, f()); } catch (e) { console.log(name, (e as Error).name + ": " + (e as Error).message.split("\n").slice(0, 2).join(" | ").replace(/ \(bun compile[^)]*\)/, "").slice(0, 170)); } }
attempt("a method of a visitor literal:", () => { let out = ""; walk.simple(parser.parse("() => {}"), { ArrowFunctionExpression(node: Small) { out += show(node); } }); return out; });
attempt("an arrow in a visitor literal:", () => { let out = ""; walk.simple(parser.parse("() => {}"), { ArrowFunctionExpression: (node: Small) => { out += show(node); } }); return out; });
attempt("a function by its name in a visitor literal:", () => { let out = ""; function visit(node: Small): void { out += show(node); } walk.simple(parser.parse("() => {}"), { ArrowFunctionExpression: visit }); return out; });
attempt("a visitor held in a variable:", () => { let out = ""; const visitors = { ArrowFunctionExpression(node: Small) { out += show(node); } }; walk.simple(parser.parse("() => {}"), visitors); return out; });
attempt("a visitor handed to a class of the package:", () => { let out = ""; new walk.Walker({ ArrowFunctionExpression(node: Small) { out += show(node); } }).run(parser.parse("() => {}")); return out; });
attempt("a callback with a smaller record:", () => { let out = ""; walk.each(parser.parse("() => {}"), (node: Span) => { out += span(node) + " "; }); return out; });
attempt("an argument:", () => show(first()));
attempt("a variable:", () => { const held: Small = first(); return show(held); });
attempt("a result:", () => show(narrow()));
attempt("a field:", () => { const keeper = new Keeper(); keeper.keep(first()); return show(keeper.kept!); });
attempt("an element:", () => { const list: Small[] = [first()]; return show(list[0]); });
attempt("a member of a literal:", () => { const holder: { node: Small } = { node: first() }; return show(holder.node); });
attempt("the inner one alone:", () => span(first().body));
attempt("identity:", () => { const given = first(); const held: Small = given; return String((held as unknown) === (given as unknown)); });
attempt("a literal of the type:", () => show({ async: true, expression: false, body: { start: 1, end: 2 } }));
walk.later(first()).then((node: Small) => console.log("a promise's callback:", show(node)), (e: Error) => console.log("a promise's callback:", e.name, e.message.split("\n")[0].slice(0, 120)));
//// package-instances-as-small-records/parser.d.ts
export interface Node { type: string; start: number; end: number }
export interface BlockStatement extends Node { type: "BlockStatement" }
export interface ArrowFunctionExpression extends Node { type: "ArrowFunctionExpression"; async: boolean; expression: boolean; body: BlockStatement }
export interface Program extends Node { type: "Program"; body: Node[] }
export function parse(text: string): Program;
//// package-instances-as-small-records/parser.js
export class Node { constructor(type, start, end) { this.type = type; this.start = start; this.end = end; } }
export function parse(text) {
  const body = new Node("BlockStatement", 6, text.length);
  const arrow = new Node("ArrowFunctionExpression", 0, text.length); arrow.async = false; arrow.expression = false; arrow.body = body;
  const program = new Node("Program", 0, text.length); program.body = [arrow];
  return program;
}
//// package-instances-as-small-records/walker.d.ts
import type * as parser from "./parser.js";
export type SimpleVisitors = { ArrowFunctionExpression?: (node: parser.ArrowFunctionExpression) => void; BlockStatement?: (node: parser.BlockStatement) => void; Program?: (node: parser.Program) => void };
export function simple(node: parser.Node, visitors: SimpleVisitors): void;
export function each(node: parser.Node, visit: (node: parser.Node) => void): void;
export function later<T extends parser.Node>(node: T): Promise<T>;
export class Walker { constructor(visitors: SimpleVisitors); run(node: parser.Node): void }
//// package-instances-as-small-records/walker.js
export function simple(node, visitors) {
  const visit = visitors[node.type]; if (visit) visit(node);
  if (Array.isArray(node.body)) for (const child of node.body) simple(child, visitors); else if (node.body) simple(node.body, visitors);
}
export function each(node, visit) { visit(node); if (Array.isArray(node.body)) for (const child of node.body) each(child, visit); else if (node.body) each(node.body, visit); }
export function later(node) { return Promise.resolve(node); }
export class Walker { constructor(visitors) { this.visitors = visitors; } run(node) { simple(node, this.visitors); } }
//// parameters-typed-by-dts/host.d.ts
// What a package's declaration file says of the host's handlers, for main.ts.
export interface Handler<Data = unknown> { open?(socket: Socket<Data>): void; data?(socket: Socket<Data>, buffer: Uint8Array): void; close?(socket: Socket<Data>, code: number): string }
export interface Socket<Data> { data: Data; write(text: string): number }
export type Listener = (event: { kind: string; count: number }) => void;
//// parameters-typed-by-dts/main.ts
// A parameter without its own annotation, contextually typed from a declaration file: it receives whatever the embedder passes, whatever the declaration says. Also where the literal is first stored in a variable of the embedder's type.
import type { Handler, Listener } from "./host";
const said: string[] = [];
const kindOf = (v: unknown) => (v === null ? "null" : v instanceof ArrayBuffer ? "ArrayBuffer" : v instanceof Uint8Array ? "Uint8Array" : typeof v);
const kept = { open(socket) { said.push("open " + kindOf(socket)); }, data(socket, buffer) { said.push("data " + kindOf(buffer)); }, close(socket, code) { said.push("close " + kindOf(code)); return "closed"; } } as Handler<any>;
const annotated: Handler = { data(socket, buffer) { said.push("data under an annotation " + kindOf(buffer)); } };
const satisfied = { data(socket, buffer) { said.push("data under satisfies " + kindOf(buffer)); } } satisfies Handler;
const listener: Listener = event => { said.push("listener " + kindOf(event) + " " + kindOf((event as any)?.count)); };
const written = { data(socket: unknown, buffer: Uint8Array) { said.push("data with a written parameter " + kindOf(buffer)); } };
const host: any = { run(handler: any, ...given: unknown[]) { for (const name of ["open", "data", "close"]) handler[name]?.({ data: 1 }, ...given); } };
for (const given of [new Uint8Array(1), new ArrayBuffer(1), "text", 5, null, undefined]) {
  for (const handler of [kept, annotated, satisfied]) { try { host.run(handler, given); } catch (e) { said.push("THROWS " + (e as Error).message.split(" (bun")[0]); } }
  try { (listener as any)(given); } catch (e) { said.push("THROWS " + (e as Error).message.split(" (bun")[0]); }
}
host.run(written, new Uint8Array(2));
console.log(said.join("\n"));
//// parsed-array-reads.ts
// Every common way to read the elements of a parsed JSON array through an array type.
interface Num { n: number; m?: number }
function attempt(label: string, f: () => unknown) { try { console.log(label + ":", String(f())) } catch (e) { console.log(label + ":", (e as Error).constructor.name) } }
const text = '[{"n":1},{"n":1.5},{"n":2,"m":3}]'
const fresh = (): Num[] => JSON.parse(text) as Num[]
const touch = (x: Num) => { x.n *= 2; x.m ??= 7; return x.n }
attempt("index", () => { const a = fresh(); let t = 0; for (let i = 0; i < a.length; i++) t += touch(a[i]); return t })
attempt("for of", () => { const a = fresh(); let t = 0; for (const x of a) t += touch(x); return t })
attempt("for of, parameter", () => { const f = (a: Num[]) => { let t = 0; for (const x of a) t += x.n; return t }; return f(fresh()) })
attempt("forEach", () => { const a = fresh(); let t = 0; a.forEach(x => { t += touch(x) }); return t })
attempt("map", () => fresh().map(x => touch(x)).join())
attempt("map, by name", () => fresh().map(touch).join())
attempt("reduce", () => fresh().reduce((t, x) => t + x.n, 0))
attempt("filter, then index", () => fresh().filter(x => x.n > 1)[0].n)
attempt("find", () => fresh().find(x => x.n > 1)!.n)
attempt("destructuring", () => { const [x, y] = fresh(); return x.n + y.n })
attempt("spread, then index", () => [...fresh()][1].n)
attempt("at", () => fresh().at(-1)!.n)
attempt("pop", () => fresh().pop()!.n)
attempt("entries", () => { let t = 0; for (const [i, x] of fresh().entries()) t += i + x.n; return t })
attempt("annotated, for of", () => { const a: Num[] = JSON.parse(text); let t = 0; for (const x of a) t += x.n; return t })
export {};
//// parsed-data-through-cast-chain.ts
// What is parsed is looked at as one type after another through a chain of casts. Each cast lets the object pass as it is, so every view reads and stores the same object.
interface Link0 { id: number; label: string; next?: Link0 }
interface Link1 { id: number; label: string; next?: Link1; seen?: boolean }
interface Link2 { id: number; label: string; next?: Link2; depth?: number }
interface Link3 { id: number; label: string; next?: Link3; tags?: string[] }
interface Link4 { id: number; label: string; next?: Link4; owner?: Owner }
interface Owner { name: string; links: Link5[] }
interface Link5 { id: number; label: string; next?: Link5 }
type Either = Link5 | { kind: "none"; why: string };
const text = '{"id":1,"label":"a","next":{"id":2,"label":"b","next":{"id":3,"label":"c"}}}';
const first = JSON.parse(text) as Link0;
const second = first as unknown as Link1;
second.seen = true;
const third: Link2 = second as unknown as Link2;
third.depth = 3;
const fourth = third as unknown as Link3;
fourth.tags = ["x", "y"];
const fifth = fourth as unknown as Link4;
const made: Link5 = { id: 9, label: "made" };
fifth.owner = { name: "o", links: [made, fifth.next as unknown as Link5] };
function count(link: { next?: any } | undefined): number { let n = 0; for (let at = link; at; at = at.next) n++; return n; }
function labels(link: Link5 | undefined): string { let out = ""; for (let at = link; at; at = at.next) out += at.label; return out; }
function describe(it: Either): string { return "kind" in it ? it.why : it.label + it.id; }
const all: Either[] = [made, fifth.owner.links[1], { kind: "none", why: "nothing" }];
console.log(count(first), count(third), labels(fifth as unknown as Link5), all.map(describe).join(","));
console.log(JSON.stringify(first), Object.keys(second).join(), fourth.tags.length, third.depth, fifth.owner.links.length);
//// parsed-in-container-dictionary.ts
// Parsed data that travels as `any` and first meets its type inside a container, or below a value that has met its type.
// The type has more than six members; the type of one of its members has two.
interface Origin { source: string; hops: number }
////= Message-2
interface Batch { name: string; items: Message[] }
const line = '{"id":1,"at":0.5,"size":2.5,"weight":3.5,"body":"hello"}'
const withOrigin = '{"id":2,"at":0.5,"size":2.5,"weight":3.5,"body":"hi","origin":{"source":"wire","hops":2},"tags":["x","y"]}'
const bag: unknown[] = []
function travel(x: unknown): any { bag.push(x); return bag.pop() }
function own(n: number): Message { return { id: n, at: 1.5, size: 2.5, weight: 3.5, body: "own", retries: n, delay: 0.5, sentAt: 4.5, score: 0.25, tags: ["o"], origin: { source: "own", hops: 1 } } }
////= handle-2
const made = own(9)
////= row-2
row("made by the program", () => handle(made))
row("a dictionary", () => { const byId: Record<string, Message> = travel(JSON.parse('{"k":' + line + "}")); byId.own = own(1); return handle(byId.k!) + handle(byId.own!) })
//// parsed-in-container-map.ts
