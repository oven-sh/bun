//// json-parse-type-argument-tags-that-are-no-texts.ts
// Unions told apart by numbers, booleans, null and a mix of them: the tag in every spelling, in every place, twice, missing, of another kind: `JSON.parse(text) as T` gives what JSON.parse gives.
const plainParse: (text: string) => any = globalThis.JSON.parse;

////= show

////= outcome

let shown = 0;
////= differs

type ByNumber = { kind: 0; a: number } | { kind: 1; b: string } | { kind: 2; c: boolean } | { kind: 10; d: null } | { kind: -1; e: number[] } | { kind: 1.5; f: { g: number } } | { kind: 100; h?: number } | { kind: 1e21; i: number };
type ByFlag = { on: true; a: number } | { on: false; b: string };
type ByNull = { v: null; a: number } | { v: 1; b: string } | { v: "one"; c: boolean } | { v: true; d: number };
type Nested = { kind: 1; below: Nested | null } | { kind: 2; below: Nested | null; more: ByFlag };
type WithRest = { kind: 1; a: number } | { kind: 2; b: number } | { other: string };
type Tuples = [1, string] | [2, number] | [true, null];

const tags = ["0", "-0", "0.0", "0e5", "1", "1.0", "1e0", "10e-1", "0.1e1", "1.00", "01", "+1", "2", "2.0", "20e-1", "10", "1e1", "100e-1", "-1", "-1.0", "-10e-1", "1.5", "15e-1", "1.50", "100", "1e2", "1E+2", "1e21", "1000000000000000000000", "1e+21", "10e20", "3", "1.0000000000000001", "0.9999999999999999999", "1e400", "-1e400", "1e-400", "true", "false", "null", '"1"', '"one"', '"\\u006fne"', '"true"', "[1]", "{}", '{"kind":1}', "tru", "nul", "", "1 ", " 1", "1,", "1}"];
const rests = ['"a":1', '"b":"s"', '"c":true', '"d":null', '"e":[1]', '"f":{"g":1}', '"h":1', '"i":1', '"b":1', '"a":"s"', '"u":{"kind":2}', '"below":null', '"more":{"on":true,"a":1}', '"other":"o"'];
const roads: [string, string, (text: string) => unknown][] = [
  ["numbers", "kind", text => JSON.parse(text) as ByNumber],
  ["numbers in a list", "kind", text => JSON.parse("[" + text + "," + text + "]") as ByNumber[]],
  ["flags", "on", text => JSON.parse(text) as ByFlag],
  ["null, a number, a text, true", "v", text => JSON.parse(text) as ByNull],
  ["nested", "kind", text => JSON.parse(text) as Nested],
  ["with an arm without a tag", "kind", text => JSON.parse(text) as WithRest],
];
for (const [label, name, parse] of roads) {
  const plainRoad = label === "numbers in a list";
  let different = 0;
  let texts = 0;
  const ask = (text: string) => {
    texts++;
    if (!plainRoad) {
      different += differs(parse, text);
      return;
    }
    const typed = outcome(parse, text);
    const plain = outcome(plainParse, "[" + text + "," + text + "]");
    if (typed !== plain) different++;
  };
  for (const tag of tags) {
    for (const rest of rests) {
      const member = '"' + name + '":' + tag;
      ask("{" + member + "," + rest + "}");
      ask("{" + rest + "," + member + "}");
      ask('{"z":[{"' + name + '":9}],' + rest + "," + member + ',"y":1}');
      ask("{ " + member.replace(":", " : ") + " , " + rest + " }");
      ask("{" + member + "," + rest + ',"' + name + '":1}');
      ask('{"' + name + '":2,' + rest + "," + member + "}");
      ask('{"\\u00' + name.charCodeAt(0).toString(16) + name.slice(1) + '":' + tag + "," + rest + "}");
    }
    ask('{"' + name + '":' + tag + "}");
    ask('{"' + name + '":' + tag);
  }
  console.log(label + ": " + texts + " texts: " + different + " differ");
}
{
  let different = 0;
  let texts = 0;
  for (const tag of tags) for (const second of ['"s"', "1", "null", "true", "[]"]) for (const text of ["[" + tag + "," + second + "]", "[ " + tag + " , " + second + " ]", "[" + tag + "]", "[" + tag + "," + second + ",1]"]) {
    texts++;
    different += differs(text => JSON.parse(text) as Tuples, text);
  }
  console.log("tuples: " + texts + " texts: " + different + " differ");
}
//// json-parse-type-argument-texts-broken-far-below-take-linear-time.ts
// `JSON.parse(text) as T` of texts that are no JSON at their deepest place, or that nest past the end of the stack: the error is JSON.parse's, and no level of the text is read again for each level around it, so each answer comes within a second.
type Json = string | number | boolean | null | Json[] | { [key: string]: Json };
type Chain = { extra: unknown; next: Chain | null };
type Link = { name: string; next?: Link };
type Rows = { rows: Rows[] };

const nest = (open: string, middle: string, close: string, levels: number) => open.repeat(levels) + middle + close.repeat(levels);
const kinds: [string, (text: string) => unknown, (levels: number) => string][] = [
  ["arrays that are never closed", text => JSON.parse(text) as Json, levels => "[".repeat(levels)],
  ["objects that are never closed", text => JSON.parse(text) as Json, levels => '{"k":'.repeat(levels)],
  ["a word cut short under unknown", text => JSON.parse(text) as Chain, levels => nest('{"extra":1,"next":', '{"extra":tru,"next":null}', "}", levels)],
  ["a string without its end under unknown", text => JSON.parse(text) as Chain, levels => nest('{"extra":1,"next":', '{"extra":"s,"next":null}', "}", levels)],
  ["an array cut short under unknown", text => JSON.parse(text) as Chain, levels => nest('{"extra":1,"next":', '{"extra":[1,],"next":null}', "}", levels)],
  ["a number without digits under an undeclared key", text => JSON.parse(text) as Link, levels => nest('{"name":"n","next":', '{"name":"n","other":-}', "}", levels)],
  ["an object cut short under an undeclared key", text => JSON.parse(text) as Link, levels => nest('{"name":"n","next":', '{"name":"n","other":{"a":}}', "}", levels)],
  ["records in arrays, a key without quotes", text => JSON.parse(text) as Rows, levels => nest('{"rows":[', "{rows:[]}", "]}", levels)],
];

for (const [label, parse, text] of kinds) {
  for (const levels of [10, 1_000, 30_000, 300_000]) {
    const given = text(levels);
    const start = Date.now();
    let said: string;
    try {
      said = "A VALUE: " + typeof parse(given);
    } catch (error: any) {
      said = error.name;
    }
    console.log(label + ", " + levels + " levels: " + said + (Date.now() - start > 1000 ? " TOO SLOWLY" : ""));
  }
}
//// json-parse-type-argument-texts-from-every-source.ts
// The text comes from buffers, decoders, files, responses, streams and other makers of strings, whole and in slices: `JSON.parse(text) as T` gives what JSON.parse gives.
import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

type Row = { id: number; name: string; tags: string[] };
const ascii = '[{"id":1,"name":"one","tags":["a","b"]},{"name":"two","u":{"v":[1,2]},"id":2,"tags":[]}]';
const latin = ascii.replace("one", "éÿ");
const wide = ascii.replace("one", "日本😀");
const folder = mkdtempSync(join(tmpdir(), "json-sources-"));
let different = 0;
let texts = 0;

function check(text: string): void {
  for (const given of [text, " " + text, text + "\n", (text + text).slice(0, text.length), ("[" + text + "]").slice(1, -1), text.slice(0, -1), text.slice(1)]) {
    texts++;
    let typed = "";
    let plain = "";
    try {
      typed = JSON.stringify(JSON.parse(given) as Row[]);
    } catch (error: any) {
      typed = error.name + ": " + error.message;
    }
    try {
      plain = JSON.stringify((globalThis.JSON.parse as (text: string) => unknown)(given));
    } catch (error: any) {
      plain = error.name + ": " + error.message;
    }
    if (typed !== plain) different++;
  }
}

for (const [label, text] of [["ASCII", ascii], ["Latin-1", latin], ["16-bit", wide]]) {
  const bytes = Buffer.from(text, "utf8");
  const path = join(folder, label + ".json");
  writeFileSync(path, bytes);
  const sources: string[] = [
    text,
    bytes.toString(),
    bytes.toString("utf8", 0, bytes.length),
    Buffer.from(text, "utf16le").toString("utf16le"),
    Buffer.from(text, "latin1").toString("latin1"),
    Buffer.from(bytes.toString("base64"), "base64").toString(),
    new TextDecoder().decode(bytes),
    new TextDecoder("utf-16le").decode(Buffer.from(text, "utf16le")),
    readFileSync(path, "utf8"),
    await Bun.file(path).text(),
    await new Response(bytes).text(),
    await new Response(text).text(),
    await new Blob([bytes]).text(),
    await Bun.readableStreamToText(new Blob([bytes]).stream()),
    JSON.stringify(globalThis.JSON.parse(text)),
    globalThis.JSON.parse(JSON.stringify(text)),
    text.normalize(),
    text.toWellFormed(),
    text.split("").join(""),
    [...text].join(""),
    text.replace("id", "id"),
    text.padEnd(text.length + 3).trimEnd(),
    String(new String(text)),
    `${text}`,
    Object.keys({ [text]: 1 })[0],
    Symbol(text).description!,
    new URLSearchParams({ t: text }).get("t")!,
    decodeURIComponent(encodeURIComponent(text)),
    structuredClone(text),
    new Error(text).message,
    Bun.inspect(text).length > 0 ? text.concat("") : "",
  ];
  for (const source of sources) check(source);
  console.log(label + ": " + sources.length + " sources, " + texts + " texts: " + different + " differ");
}
rmSync(folder, { recursive: true, force: true });
//// json-parse-type-argument-thousands-of-kinds-below-a-holder.ts
// A holder with undeclared keys of its own holds up to 66,000 items that each have an undeclared key of their own name: more kinds of object than the parser and the writer remember, met while the holder is being parsed and written.
interface Item { id: number }
interface Holder { first: number; items: Item[]; last: string }
let serial = 0;
const host: any = globalThis;
const which = (host.arguments ?? [])[0] ?? "orders";
for (const count of [10, 255, 256, 257, 4095, 4096, 4097, 16383, 16384, 16385, 20000, 33000]) {
  const items: string[] = [];
  for (let at = 0; at < count; at++) {
    const unique = ++serial;
    items.push(which === "orders" ? (at % 2 ? '{"k' + unique + '":1,"id":' + at + "}" : '{"id":' + at + ',"k' + unique + '":1,"m":2}') : '{"id":' + at + ',"aa' + (unique % 97) + '":1,"aa' + (unique % 89) + 'x":2,"aa' + unique + '":3}');
  }
  const text = '{"a":"before","first":1,"b":[1,2],"items":[' + items.join(",") + '],"c":"behind","last":"l","d":{"e":null},"f":"' + "x".repeat(40) + '"}';
  const written = JSON.stringify(host.JSON.parse(text));
  for (let round = 0; round < 3; round++) console.log(count + " kinds more (" + serial + " in all), round " + round + ": " + (JSON.stringify(JSON.parse(text) as Holder) === written ? "same" : "DIFFERENT"));
}
//// json-parse-type-argument-three-types-of-one-shape-with-an-optional-member.ts
// Three types of one shape, each with a required member and an optional member of its own type, are what the result of JSON.parse is cast to. The texts have the optional member or not, the keys in the
// declared order or another one, and keys that no type declares in front, between and behind. The order of the keys of what comes back is that of the text. The output is that of plain Bun.
////= lines-6	First
////= lines-6	Second
////= lines-6	Third

const texts = [
  '{"name":"a"}',
  '{"name":"b","inner":{"name":"c"}}',
  '{"inner":{"name":"d"},"name":"e"}',
  '{"extra":1,"name":"f","more":[2]}',
  '{"inner":{"name":"g","z":0},"between":null,"name":"h"}',
  '{"name":"i","inner":{"inner":{"name":"j"},"name":"k"},"last":{"name":"l"}}',
];
for (let round = 0; round < 2; round++) {
  for (const text of texts) {
    const first = JSON.parse(text) as First;
    const second = JSON.parse(text) as Second;
    const third = JSON.parse(text) as Third;
    console.log(JSON.stringify(first), Object.keys(second).join(), third.name + (third.inner ? third.inner.name : "-"));
  }
}
//// json-parse-type-argument-undeclared-keys-in-every-place.ts
// Undeclared keys stand before, between and behind the declared ones, once and many times over. The result is what JSON.parse(text) gives.
interface Point { x: number; y: number; label?: string }
interface Segment { id: number; from: Point; to: Point; note?: string; tags: string[] }
interface Named { id: number; name: string }
interface Numbered { id: number }
interface Bag { id: number; [key: string]: number | string }
interface Wide { a: number; b: string; c: boolean; d: number | null; e?: number; f?: string; g: number[]; h: Numbered }

function show(value: any): string {
  if (Array.isArray(value)) return "[" + value.map(show).join(",") + "]";
  if (typeof value !== "object" || value === null) return Object.is(value, -0) ? "-0" : typeof value + ":" + String(value);
  const inLoop: string[] = [];
  for (const key in value) inLoop.push(key);
  const described = Object.getOwnPropertyNames(value).map(key => {
    const found = Object.getOwnPropertyDescriptor(value, key)!;
    return JSON.stringify(key) + (found.writable && found.enumerable && found.configurable ? "" : "!") + "=" + show(found.value);
  });
  return "{" + described.join(",") + "|" + inLoop.join() + "|" + Object.keys(value).join() + "|" + JSON.stringify(Object.entries(value).map(entry => entry[0])) + "|" + (Object.getPrototypeOf(value) === Object.prototype) + "|" + JSON.stringify(value) + "|" + JSON.stringify({ ...value }) + "}";
}

////= attempt-2

function check(label: string, texts: string[], parse: (text: string) => unknown, then?: (value: any) => void): void {
  let different = 0;
  for (let round = 0; round < 3; round++) {
    for (const text of texts) {
      const typed = attempt(parse, text, then);
      const plain = attempt(globalThis.JSON.parse, text, then);
      if (typed !== plain && different++ < 3) console.log(label + " DIFFERS on " + text + "\n  " + typed + "\n  " + plain);
    }
  }
  console.log(label + ": " + texts.length + " texts, " + different + " differ");
}

function orders<T>(items: T[]): T[][] {
  if (items.length < 2) return [items];
  return items.flatMap((item, at) => orders([...items.slice(0, at), ...items.slice(at + 1)]).map(rest => [item, ...rest]));
}

const asObject = (members: string[]) => "{" + members.join(",") + "}";
const point = (text: string) => JSON.parse(text) as Point;
const segment = (text: string) => JSON.parse(text) as Segment;

check("every order of two members and three others", orders(['"x":1', '"y":2', '"p":3', '"q":"four"', '"r":null']).map(asObject), point);
check("every order with the optional member", orders(['"x":1', '"y":2', '"label":"l"', '"p":[1,{"a":2}]', '"q":{"b":{"c":[]}}']).map(asObject), point);
check("every order of the members alone", orders(['"x":1', '"y":2', '"label":"l"']).map(asObject), point);

const values = ["0", "-0", "1.5", "-1e3", "1e400", "123456789012345678901234567890", '""', '"a\\nb"', '"\\u00e9"', '"é"', '"日本"', "true", "false", "null", "[]", "{}", "[[],{}]", '{"x":1,"y":2}', '{"__proto__":1}', '"' + "long ".repeat(60) + '"'];
check("values of every kind", values.flatMap(value => [`{"x":1,"y":2,"o":${value}}`, `{"o":${value},"x":1,"y":2}`, `{"x":1,"o":${value},"y":2,"p":${value}}`]), point);

const many: string[] = [];
for (let count = 1; count <= 140; count += count < 20 ? 1 : 13) {
  const others = Array.from({ length: count }, (_, at) => `"k${at}":${at}`);
  many.push(asObject(['"x":1', '"y":2', ...others]), asObject([...others, '"x":1', '"y":2']), asObject(['"x":1', ...others.slice(0, count >> 1), '"y":2', ...others.slice(count >> 1)]));
}
check("from one to many", many, point);

const names = ["toString", "constructor", "hasOwnProperty", "valueOf", "__proto__", "__defineGetter__", "toJSON", "then", "length", "prototype", "", " ", "0", "1", "42", "-1", "01", "1.5", "4294967294", "4294967295", "9007199254740993", "é", "日本", "😀", "a b", "a-b", "x ", "X", "label ", "n".repeat(27), "n".repeat(28), "n".repeat(29), "n".repeat(30), "n".repeat(48), "n".repeat(49), "n".repeat(300)];
check("names of every kind", names.flatMap(name => [`{"x":1,"y":2,${JSON.stringify(name)}:7}`, `{${JSON.stringify(name)}:7,"x":1,"y":2}`, `{"x":1,${JSON.stringify(name)}:{"a":1},"y":2,"z":3}`]), point);
check("names written with escapes", ['{"x":1,"y":2,"\\u0061":3}', '{"\\u0078":1,"y":2}', '{"x":1,"y":2,"a\\nb":3}', '{"x":1,"y":2,"a\\"b":3}', '{"x":1,"\\u0079":5,"y":2}', '{"x":1,"y":2,"lab\\u0065l":"l"}', '{"x":1,"y":2,"\\ud83d\\ude00":1}'], point);

check("twice", ['{"x":1,"y":2,"o":1,"o":2}', '{"o":1,"x":1,"o":2,"y":2}', '{"x":1,"x":3,"y":2,"o":1}', '{"x":1,"o":1,"y":2,"x":3}', '{"o":1,"p":2,"o":3,"x":1,"y":2,"p":4}', '{"x":1,"y":2,"label":"a","o":1,"label":"b"}', '{"x":"no","o":1,"x":1,"y":2}', '{"x":1,"y":2,"o":{"a":1,"a":2}}'], point);

const spaced = ['{"x":1,"y":2,"o":3}', '{"o":[1,2],"x":1,"p":{"a":1},"y":2}', '{"x":1,"label":"l","o":1,"p":2,"y":2,"q":3}'];
check("with whitespace", spaced.flatMap(text => [JSON.stringify(globalThis.JSON.parse(text), null, 2), JSON.stringify(globalThis.JSON.parse(text), null, "\t"), text.replaceAll(":", " : ").replaceAll(",", " ,\r\n "), " " + text + "\n"]), point);
check("in 16-bit text", spaced.map(text => text.replace("}", ',"wide":"日本","Ω":1}')), point);
check("what is no JSON", ['{"x":1,"y":2,"o":}', '{"x":1,"y":2,"o"}', '{"x":1,"y":2,"o":1,}', '{"x":1,"y":2,o:1}', '{"x":1,"y":2,"o":1', '{"x":1,"y":2,"o":[1,}', '{"x":1,"y":2,"o":01}', '{"x":1,"y":2,"o":"a\nb"}', '{"x":1,"y":2,"o":tru}', '{"x":1,"y":2,"o":1 "p":2}', '{"x":1,"y":2,"o":1}}', '{"x":1,"y":2,"o' ], point);

const inner = ['{"x":1,"y":2}', '{"x":1,"y":2,"o":1}', '{"o":1,"y":2,"x":1}', '{"y":2,"p":[],"x":1,"label":"l","q":{}}'];
check("at every level", inner.flatMap(from => inner.flatMap(to => [`{"id":1,"from":${from},"to":${to},"tags":[]}`, `{"a":1,"id":1,"b":2,"to":${to},"c":${from},"from":${from},"tags":["t"],"d":4}`, `{"tags":[],"to":${to},"note":"n","from":${from},"id":1,"z":{"from":${from}}}`])), segment);

const turns: string[] = [];
for (let i = 0; i < 12; i++) turns.push(`{"id":${i},"name":"n${i}"}`, `{"name":"n","id":${i},"more":1}`, `{"id":${i},"more":1,"name":"n"}`);
let turn = 0;
check("a name that one type declares and another does not", turns, text => (turn++ & 1 ? (JSON.parse(text) as Named) : JSON.parse(text) as Numbered));

check("an index signature", ['{"id":1}', '{"id":1,"a":2,"b":"c"}', '{"a":2,"id":1,"b":"c"}', '{"a":2,"a":3,"id":1}', '{"0":1,"id":1,"a":2}', '{"id":1,"__proto__":3}'], text => JSON.parse(text) as Bag);

const wide = ['"a":1', '"b":"two"', '"c":true', '"d":null', '"g":[1,2]', '"h":{"id":1,"o":1}'];
const wider: string[] = [];
for (let at = 0; at <= wide.length; at++) {
  for (const more of [['"o":1'], ['"e":5'], ['"f":"f"', '"o":1'], ['"o":1', '"p":2', '"e":5'], ['"f":"f"', '"e":5']]) wider.push(asObject([...wide.slice(0, at), ...more, ...wide.slice(at)]), asObject([...wide.slice(at), ...more, ...wide.slice(0, at)]));
}
check("eight members of several kinds", wider, text => JSON.parse(text) as Wide);

const changes: [string, (value: any) => void][] = [
  ["a new key", value => { value.added = 1; }],
  ["an undeclared key goes", value => { delete value.o; }],
  ["an undeclared key goes and comes back", value => { delete value.o; value.o = 9; }],
  ["the optional member goes", value => { delete value.label; }],
  ["the optional member comes", value => { value.label = "late"; }],
  ["a member goes and comes back", value => { delete value.x; value.x = 9; }],
  ["an undeclared key is written", value => { value.o = "new"; value.p = "newer"; }],
  ["frozen", value => { Object.freeze(value); }],
  ["an index key comes", value => { value[3] = 1; value[1] = 2; }],
  ["an accessor comes", value => { Object.defineProperty(value, "o", { get: () => 5, enumerable: true, configurable: true }); }],
];
for (const [label, change] of changes) check("afterwards: " + label, ['{"x":1,"y":2}', '{"x":1,"y":2,"o":3}', '{"o":3,"x":1,"p":4,"y":2}', '{"x":1,"o":3,"label":"l","y":2,"p":4,"q":5}'], point, change);

const sets: string[] = [];
let seed = 1;
for (let i = 0; i < 600; i++) {
  const members = ['"x":1'];
  for (let k = 0; k < 14; k++) {
    seed = (Math.imul(seed, 1103515245) + 12345) & 0x7fffffff;
    if (seed & 0x10000) members.push(`"name${k}":${k % 3 ? k : '"v' + k + '"'}`);
    if (k === 6) members.push('"y":2');
  }
  sets.push(asObject(members));
}
check("many sets of undeclared keys in turn", sets, point);

const between: string[] = [];
for (const count of [1, 2, 3, 63, 64, 65, 126, 127, 128, 129, 130, 131, 132, 133, 200, 513, 1200, 5000]) {
  const others = Array.from({ length: count }, (_, at) => `"k${at}":${at}`);
  between.push(asObject(['"x":1', ...others, '"y":2', '"m0":0']), asObject([...others, '"x":1', '"m0":0', '"y":2', '"m1":1']), asObject(['"a":0', '"x":1', ...others, '"label":"l"', '"m0":0', '"y":2']));
}
check("a few and very many between the members", between, point);

const kept: Point[] = [];
const texts: string[] = [];
for (let i = 0; i < 3000; i++) {
  const text = `{"x":${i},"k${i % 7}":"${"v".repeat(i % 50)}","y":${-i},"list":[${i},{"deep":"${i}"}]${i % 3 ? "" : ',"label":"l' + i + '"'},"last":${i % 2 ? "null" : '{"a":' + i + "}"}}`;
  texts.push(text);
  kept.push(JSON.parse(text) as Point);
}
let changed = 0;
for (let i = 0; i < kept.length; i++) changed += Number(show(kept[i]) !== show(globalThis.JSON.parse(texts[i])));
console.log("kept for a while: " + kept.length + " objects, " + changed + " differ");
//// json-parse-type-argument-unions-that-contain-themselves.ts
// A union that contains itself: the arms are told apart by a constant member of any kind, wherever it stands, and no nested value is parsed twice: a text of sixty levels would otherwise take longer than the sun has left.
type ByNumber = { below: ByNumber | null; k: 1 } | { below: ByNumber | null; k: 2 };
type ByBoolean = { below: ByBoolean | null; k: true } | { below: ByBoolean | null; k: false };
type ByNull = { below: ByNull | null; k: null } | { below: ByNull | null; k: 1 };
type ByText = { below: ByText | null; k: "one" } | { below: ByText | null; k: "two" };
type Mixed = { below: Mixed | null; k: "one" } | { below: Mixed | null; k: 2 } | { below: Mixed | null; k: false } | { below: Mixed | null; k: null };
type InList = { k: 1; list: InList[] } | { k: 2; list: InList[] };
type TextOrNull = { below: TextOrNull | null; k: "one" } | { below: TextOrNull | null; k: null };
type Wide = { left: Wide | null; right: Wide | null; k: "one" } | { left: Wide | null; right: Wide | null; k: null };
function nested(levels: number, tail: string): string {
  return '{"below":'.repeat(levels) + "null" + tail.repeat(levels);
}
////= say-2
for (const levels of [1, 2, 3, 20, 40, 60, 63, 64, 65, 66, 200]) {
  say("number tags " + levels, text => JSON.parse(text) as ByNumber, nested(levels, ',"k":2}'));
  say("number tags, the first arm " + levels, text => JSON.parse(text) as ByNumber, nested(levels, ',"k":1}'));
  say("number tags, in turn " + levels, text => JSON.parse(text) as ByNumber, nested(2 * levels, ',"k":1}').replaceAll(',"k":1},"k":1}', ',"k":2},"k":1}'));
  say("number tags, written otherwise " + levels, text => JSON.parse(text) as ByNumber, nested(levels, ' , "k" : 2.0e0 }'));
  say("number tags, in front " + levels, text => JSON.parse(text) as ByNumber, '{"k":2,"below":'.repeat(levels) + "null" + "}".repeat(levels));
  say("number tags, no arm has it " + levels, text => JSON.parse(text) as ByNumber, nested(levels, ',"k":3}'));
  say("number tags, the innermost is wrong " + levels, text => JSON.parse(text) as ByNumber, nested(levels, ',"k":2}').replace('null,"k":2', 'null,"k":"2"'));
  say("true | false " + levels, text => JSON.parse(text) as ByBoolean, nested(levels, ',"k":false}'));
  say("true | false, neither " + levels, text => JSON.parse(text) as ByBoolean, nested(levels, ',"k":0}'));
  say("null | 1 " + levels, text => JSON.parse(text) as ByNull, nested(levels, ',"k":null}'));
  say("text tags " + levels, text => JSON.parse(text) as ByText, nested(levels, ',"k":"two"}'));
  say("text tags, no arm has it " + levels, text => JSON.parse(text) as ByText, nested(levels, ',"k":"three"}'));
  say("within lists " + levels, text => JSON.parse(text) as InList, '{"list":[{"list":[],"k":1},'.repeat(levels) + '{"k":2,"list":[]}' + '],"k":2}'.repeat(levels));
  say("tags of four kinds " + levels, text => JSON.parse(text) as Mixed, nested(levels, ',"k":null}'));
  say("tags of four kinds, in turn " + levels, text => JSON.parse(text) as Mixed, nested(4 * levels, ',"k":2}').replaceAll(',"k":2},"k":2},"k":2},"k":2}', ',"k":"one"},"k":2},"k":false},"k":null}'));
  say("tags of four kinds, no arm has it " + levels, text => JSON.parse(text) as Mixed, nested(levels, ',"k":true}'));
  for (const tail of [',"k":null}', ',"k":"one"}', ',"k":2}', ',"k":false}']) {
    say("tags of four kinds, read by the engine and converted " + tail + " " + levels, text => JSON.parse(text) as Mixed, nested(levels, tail).replace("below", "\\u0062elow"));
  }
  say("a text or null, read by the engine and converted " + levels, text => JSON.parse(text) as TextOrNull, nested(levels, ',"k":null}').replace("below", "\\u0062elow"));
}
function tree(levels: number): string {
  return levels ? '{"left":' + tree(levels - 1) + ',"right":' + tree(levels - 1) + ',"k":' + (levels & 1 ? "null" : '"one"') + "}" : "null";
}
for (const levels of [1, 2, 6, 10]) {
  say("a tree of two branches " + levels, text => JSON.parse(text) as Wide, tree(levels));
}

type Flat = { value: number; unit: string } | { error: string; code: number } | { value: string };
type Below = { a: { x: number }; n: number } | { a: { y: number }; n: number } | { a: { x: number }; n: string };
type Lists = number[] | string[] | [boolean, number[]] | { list: number[] } | { list: string[] };
type Tagged = { kind: 1; parts: number[] } | { kind: 2; parts: string[] } | { kind: number; parts?: unknown };
for (const text of ['{"value":1,"unit":"m"}', '{"error":"none","code":4}', '{"value":"v"}', '{"value":"v","o":{"deep":[1,{"er":2}]}}', '{"o":[[]],"code":4,"error":"e"}', '{"value":1}', '{"value":null}', "{}", "[]", "null"]) say("arms that hold no objects " + text, given => JSON.parse(given) as Flat, text);
for (const text of ['{"a":{"x":1},"n":1}', '{"a":{"y":1},"n":1}', '{"a":{"x":1},"n":"s"}', '{"n":"s","a":{"x":1}}', '{"a":{"y":1},"n":"s"}', '{"a":{"x":1,"y":1},"n":1}', '{"a":{},"n":1}', '{"a":{"x":1}}']) say("arms that differ below " + text, given => JSON.parse(given) as Below, text);
for (const text of ["[]", "[1,2]", '["a"]', '[1,"a"]', "[true,[1]]", '[true,["a"]]', '{"list":[]}', '{"list":[1]}', '{"list":["a"]}', '{"list":[1,"a"]}', '{"list":[[]]}']) say("lists " + text, given => JSON.parse(given) as Lists, text);
for (const text of ['{"kind":1,"parts":[1]}', '{"kind":2,"parts":["a"]}', '{"kind":1,"parts":["a"]}', '{"parts":["a"],"kind":1}', '{"kind":3,"parts":{"any":[1]}}', '{"kind":3}', '{"kind":"1","parts":[1]}', '{"parts":[1]}']) say("the arm that the tag names does not fit " + text, given => JSON.parse(given) as Tagged, text);
//// json-parse-type-argument-what-an-outer-object-stands-on-is-replaced.ts
// Something is emptied, grown or replaced while an outer object of the same parse still stands on it.
interface Node { id: number; below: Node | null; name: string }
interface Item { id: number }
interface Holder { first: number; items: Item[]; last: string }
let different = 0;
let compared = 0;
function check<T>(parse: (text: string) => T, text: string): void {
  compared++;
  const [typed, plain] = [parse(text), globalThis.JSON.parse(text)];
  if (JSON.stringify(Object.keys(typed as object)) !== JSON.stringify(Object.keys(plain)) || JSON.stringify(typed) !== JSON.stringify(plain)) different++;
}
const others = (prefix: string, count: number, value: (at: number) => string) => Array.from({ length: count }, (_, at) => `"${prefix}${at}":${value(at)}`);
const fresh = (at: number) => `"${"v".repeat(40)}${at}"`;
let serial = 0;
for (const inner of [1, 2, 3, 5, 31, 32, 33, 63, 64, 65, 70, 127, 128, 129, 200]) {
  for (let round = 0; round < 3; round++) {
    const deepest = `{${[...others("i" + serial++ + "_", inner, fresh), '"id":3', '"below":null', '"name":"c"'].join(",")}}`;
    const middle = `{${[...others("m", 3, fresh), '"id":2', ...others("n", 2, fresh), `"below":${deepest}`, ...others("o", inner % 7, fresh), '"name":"b"'].join(",")}}`;
    check(text => JSON.parse(text) as Node, `{${[...others("a", 3, fresh), '"id":1', `"below":${middle}`, ...others("b", 3, fresh), '"name":"a"', ...others("c", 2, fresh)].join(",")}}`);
  }
}
for (const count of [10, 300, 5000, 16383, 16384, 16385, 17000, 34000]) {
  const items = Array.from({ length: count }, (_, at) => (at % 2 ? `{"k${++serial}":1,"id":${at}}` : `{"id":${at},"k${++serial}":1,"m":2}`));
  const text = `{"a":"before","first":1,"b":[1,2],"items":[${items.join(",")}],"c":"behind","last":"l","d":{"e":null}}`;
  for (let round = 0; round < 2; round++) {
    compared++;
    const holder = JSON.parse(text) as Holder;
    if (Object.keys(holder).join() !== "a,first,b,items,c,last,d" || holder.items.length !== count || Object.keys(holder.items[count - 1]).join() !== Object.keys(globalThis.JSON.parse(items[count - 1])).join()) different++;
  }
}
console.log(compared + " compared, " + different + " differ");
//// json-parse-type-argument-what-is-learned-while-an-outer-object-is-open.ts
// While an outer object is still being parsed, with undeclared keys of its own in front of and behind the member, the objects inside it change what the parser has learned: the first object of the same type that spills, and more orders of keys than are remembered. Nothing is written: the keys and values are walked.
interface Self { name: string; inner?: Self; list?: Self[] }
interface Item { id: number }
interface Holder { first: number; items: Item[]; last: string }
interface Other1 { name: string; inner?: Other1 }
interface Other2 { name: string; inner?: Other2 }
interface Other3 { name: string; inner?: Other3 }

const plainParse: (text: string) => any = globalThis.JSON.parse;
function walk(value: any): string {
  if (Array.isArray(value)) {
    let said = "[";
    for (const item of value) said += walk(item) + ",";
    return said + "]";
  }
  if (typeof value !== "object" || value === null) return String(value);
  let said = "{";
  for (const key of Object.keys(value)) said += key + ":" + walk(value[key]) + ",";
  return said + "}";
}
let serial = 0;
const extras = (prefix: string, count: number): string[] => Array.from({ length: count }, (_, at) => '"' + prefix + at + '":"value number ' + ++serial + ' is longer than any short string that is cached"');
function selfText(levels: number, inside: number, around: number): string {
  if (levels === 0) return "{" + ['"name":"leaf"', ...extras("i", inside)].join(",") + "}";
  return "{" + [...extras("a", around), '"name":"n' + levels + '"', '"inner":' + selfText(levels - 1, inside, around), ...extras("b", around)].join(",") + "}";
}
function check(label: string, parse: (text: string) => unknown, texts: string[]): void {
  let different = 0;
  for (const text of texts) for (let round = 0; round < 3; round++) if (walk(parse(text)) !== walk(plainParse(text))) different++;
  console.log(label + ": " + texts.length + " texts: " + different + " differ");
}
check("the first object that spills lies inside", text => JSON.parse(text) as Self, [selfText(1, 70, 3)]);
check("then others", text => JSON.parse(text) as Self, [1, 2, 3, 5].flatMap(levels => [0, 1, 2, 3, 4, 63, 64, 65, 70, 127, 128, 129, 200].flatMap(inside => [0, 1, 3, 40].map(around => selfText(levels, inside, around)))));
check("deeper first", text => JSON.parse(text) as Other1, [selfText(6, 65, 2), selfText(6, 3, 2), selfText(2, 130, 70)]);
check("many around, few inside", text => JSON.parse(text) as Other2, [selfText(3, 1, 70), selfText(3, 70, 1), selfText(3, 64, 64)]);
check("growing", text => JSON.parse(text) as Other3, Array.from({ length: 140 }, (_, count) => selfText(2, count, count >> 1)));
check("lists of itself", text => JSON.parse(text) as Self, [3, 70, 130].map(inside => "{" + [...extras("a", 3), '"name":"n"', '"list":[' + [selfText(0, inside, 0), selfText(1, inside, 2), selfText(0, 1, 0)].join(",") + "]", ...extras("b", 3)].join(",") + "}"));

for (const count of [10, 4096, 16383, 16384, 16385, 20000, 40000]) {
  const items: string[] = [];
  for (let at = 0; at < count; at++) items.push(at % 2 ? '{"k' + ++serial + '":1,"id":' + at + "}" : '{"id":' + at + ',"k' + ++serial + '":1,"m":2}');
  check(count + " orders inside an open holder", text => JSON.parse(text) as Holder, ['{"a":"before","first":1,"b":[1,2],"items":[' + items.join(",") + '],"c":"behind","last":"l","d":{"e":null}}']);
}
//// json-parse-type-argument-what-is-no-text.ts
// What is handed to `JSON.parse(text) as T` is no string: JSON.parse converts it to one first.
type Point = { x: number; y: number };
const plainParse: (text: any) => any = globalThis.JSON.parse;
////= say-3	+ ": " + error.message
let calls = 0;
const given: [string, () => any][] = [
  ["bytes of 1", () => new Uint8Array([49])],
  ["bytes of a record", () => new Uint8Array([...'{"x":1,"y":2}'].map(c => c.charCodeAt(0)))],
  ["bytes of [1]", () => new Uint8Array([91, 49, 93])],
  ["no bytes", () => new Uint8Array(0)],
  ["Uint8ClampedArray", () => new Uint8ClampedArray([49])],
  ["Int8Array", () => new Int8Array([49])],
  ["ArrayBuffer", () => new Uint8Array([49]).buffer],
  ["a number", () => 7],
  ["null", () => null],
  ["undefined", () => undefined],
  ["true", () => true],
  ["an array", () => [1]],
  ["an array of two", () => [1, 2]],
  ["an object", () => ({})],
  ["an object with toString", () => ({ toString: () => (calls++, '{"x":1,"y":2}') })],
  ["an object with valueOf", () => ({ valueOf: () => "1", toString: () => "2" })],
  ["a String object", () => new String('{"x":1,"y":2}')],
  ["a symbol", () => Symbol("s")],
  ["a bigint", () => 12n],
  ["a throwing toString", () => ({ toString() { throw new RangeError("mine"); } })],
];
for (const [label, make] of given) {
  const answers = [say(() => JSON.parse(make()) as number), say(() => JSON.parse(make()) as Point), say(() => JSON.parse(make()) as number[]), say(() => JSON.parse(make()) as { v: unknown })];
  const plain = say(() => plainParse(make()));
  console.log(label + ": plain " + plain + " | " + answers.map(answer => (answer === plain ? "same" : "DIFFERENT: " + answer)).join(" | "));
}
console.log("toString was called " + calls + " times");
//// json-parse-untagged-recursive-union.ts
// Arms without a tag that share a recursive member and differ after it: no nested value is parsed once per arm, so sixty levels end.
type List = { next: List | null; a: number } | { next: List | null; b: number };
type Pair = { a: Pair | null; b: 1 } | { a: Pair | null; c: 2 };
function nested(head: string, levels: number, tail: string): string {
  return head.repeat(levels) + "null" + tail.repeat(levels);
}
////= say-2
for (const levels of [1, 2, 20, 40, 60]) {
  say("the first arm " + levels, text => JSON.parse(text) as List, nested('{"next":', levels, ',"a":1}'));
  say("the second arm " + levels, text => JSON.parse(text) as List, nested('{"next":', levels, ',"b":1}'));
  say("a literal member in each arm " + levels, text => JSON.parse(text) as Pair, nested('{"a":', levels, ',"c":2}'));
}
for (const levels of [1, 2]) say("neither arm " + levels, text => JSON.parse(text) as List, nested('{"next":', levels, ',"c":1}'));
//// json-stringify-across-every-end-of-a-buffer.ts
// JSON.stringify of compiled objects writes keys, numbers and short strings into room that it has asked for once.
// Here every such write is moved across every place where a buffer ends or grows: the 8,192 characters on the stack, and 1,024 doubled.
// What is written is compared with the text for ordinary objects with the same members, made by run-time text.
const toPlain = new Function("value", `
    function copy(v) {
        if (Array.isArray(v)) return v.map(copy);
        if (v && typeof v === "object") { const r = {}; for (const k of Object.keys(v)) r[k] = copy(v[k]); return r; }
        return v;
    }
    return copy(value);`) as <V>(value: V) => V;

class Text { constructor(public s: string) {} }
class Keys { a = 1; abcdefghijklm = 2; abcdefghijklmn = 3; abcdefghijklmno = 4; abcdefghijklmnop = 5; abcdefghijklmnopqrstuvwxyz01234 = 6; abcdefghijklmnopqrstuvwxyz012345 = 7; abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz01234567 = 8; "quo\"te" = 9; "é" = 10; }
class Numbers { least = -2147483648; most = 2147483647; long = -1.7976931348623157e308; small = 5e-324; third = -0.3333333333333333; nan = NaN; infinite = -Infinity; zero = -0; yes = true; no = false; none = null; missing = undefined; }
class Mixed {
    id = 7; flag = true; none = null; ratio = 1.5;
    constructor(public name: string, public inner: Text, public list: Text[], public tags: string[]) {}
}
class Deep { constructor(public next: Deep | null, public label: string) {} }

function deep(levels: number, label: string): Deep { let d: Deep = new Deep(null, label); for (let i = 0; i < levels; i++) d = new Deep(d, label); return d; }
const tails = ["", "\"", "\\", "\n", "\u001f", "é", "中", "\ud800"];
const lengths = [0, 1, 3, 4, 7, 8, 9, 15, 16, 17, 31, 32, 33, 100, 300, 1100];
const texts: string[] = [];
for (const length of lengths) for (const tail of tails) { texts.push("s".repeat(length) + tail); if (tail) texts.push(tail + "s".repeat(length)); }

let calls = 0, wrong = 0, hash = 0;
function check(value: unknown, space: string | number | undefined): void {
    const got = JSON.stringify(value, null, space);
    const want = JSON.stringify(toPlain(value), null, space);
    calls++;
    hash = (hash * 31 + got.length) | 0;
    if (got !== want && wrong++ < 5) console.log("DIFFERS", got.length, want.length, String(space), got.slice(0, 60));
}

const big = "t".repeat(9000);
const spaces = [undefined, 1, 10, "\t"];
let turn = 0;
for (const end of [1024, 2048, 4096, 8192, 16384, 32768]) {
    for (let room = 330; room >= -12; room -= room > 140 ? 7 : 1) {
        const filler = "x".repeat(end - room);
        const text = texts[turn++ % texts.length];
        const space = spaces[turn % spaces.length];
        for (const last of ["", big]) {
            check([filler, new Keys(), last], space);
            check([filler, new Numbers(), last], space);
            check([filler, new Text(text), last], space);
            check([filler, new Mixed(text, new Text(text), [new Text(text), new Text("")], [text, "t"]), last], space);
            check([new Text(filler), new Text(text), new Text(text), new Text(last)], space);
            check([new Mixed(filler, new Text(""), [], []), new Mixed(text, new Text(text), [new Text(text)], [text]), new Mixed(last, new Text(text), [], [])], space);
            check({ filler, keys: new Keys(), numbers: new Numbers(), last }, space);
            check(new Mixed(filler, new Text(text), [new Text(text), new Text(text), new Text(text)], [last]), space);
        }
    }
}
for (const text of texts) for (const space of spaces) {
    check(new Text(text), space); check([new Text(text), new Text(text)], space); check(new Mixed(text, new Text(text), [new Text(text)], [text]), space);
}
for (const levels of [1, 2, 10, 60, 200, 700]) for (const space of [undefined, 1, 10, "0123456789"]) for (const label of ["", "l", "\n", "中", "l".repeat(40)]) check(deep(levels, label), space);
console.log(calls, wrong, hash);
//// json-stringify-date-output.ts
// JSON.stringify writes a Date as Date.prototype.toJSON says: whatever a program has done to the date or to its class is seen.
interface Comment {
  id: number;
  at: Date;
  body: string;
  replies: Comment[];
}
interface Issue {
  id: number;
  title: string;
  created: Date;
  closed: Date | null;
  comments: Comment[];
}
const comment = (id: number, depth: number): Comment => ({
  id,
  at: new Date(1_700_000_000_000 + id * 86_400_123),
  body: "text " + id,
  replies: depth ? [comment(id * 2 + 1, depth - 1), comment(id * 2 + 2, depth - 1)] : [],
});
const issue: Issue = { id: 1, title: "an issue", created: new Date(0), closed: null, comments: [comment(1, 2)] };
const say = (name: string, run: () => unknown) => {
  let said: string;
  try {
    said = String(run());
  } catch (error) {
    said = "throws " + (error as Error).name + ": " + (error as Error).message;
  }
  console.log(name + ": " + said);
};
const times = [
  0,
  1,
  -1,
  999,
  -999,
  1000,
  86_399_999,
  -86_400_001,
  951_782_400_000,
  1_709_164_800_000,
  253_402_300_799_999,
  253_402_300_800_000,
  -62_167_219_200_000,
  -62_167_219_200_001,
  8.64e15,
  -8.64e15,
  8.64e15 + 1,
  NaN,
  Infinity,
  1.5,
  -0,
];
say("typed", () => JSON.stringify(issue));
say("typed, indented", () => JSON.stringify(issue, null, 2));
say("times", () => JSON.stringify(times.map(time => new Date(time))));
say("times in objects", () => JSON.stringify(times.map(time => ({ at: new Date(time), time }))));
say("alone", () => JSON.stringify(new Date(1234567890123)));
say("alone, invalid", () => JSON.stringify(new Date(NaN)));
say("a wide string beside it", () => JSON.stringify({ text: "中文 😀", at: new Date(5) }));
say("set later", () => {
  const date = new Date(0);
  date.setUTCFullYear(2030, 1, 28);
  date.setUTCHours(23, 59, 59, 7);
  const first = JSON.stringify([date]);
  date.setTime(NaN);
  return first + JSON.stringify([date]);
});
say("many", () => JSON.stringify(Array.from({ length: 3000 }, (_, at) => new Date(at * 1e9))).length);

const log: string[] = [];
const own = (name: string | symbol, value: unknown) => {
  const date = new Date(7);
  Object.defineProperty(date, name, { value, configurable: true, writable: true, enumerable: false });
  return date;
};
say("own toJSON", () =>
  JSON.stringify({
    at: own("toJSON", function (this: Date, key: string) {
      return "own " + key + " " + this.getTime();
    }),
  }),
);
say("own toJSON that is no function", () => JSON.stringify({ at: own("toJSON", 1) }));
say("own toISOString", () => JSON.stringify({ at: own("toISOString", () => "own text") }));
say("own toISOString that is no function", () => JSON.stringify({ at: own("toISOString", 1) }));
say("own valueOf", () => JSON.stringify({ at: own("valueOf", () => NaN) }));
say("own Symbol.toPrimitive", () => JSON.stringify({ at: own(Symbol.toPrimitive, () => Infinity) }));
say("another own property", () => JSON.stringify({ at: own("extra", 1) }));
say("an enumerable own property", () => {
  const date = new Date(8) as Date & { extra?: number };
  date.extra = 1;
  return JSON.stringify([date]);
});
say("frozen", () => JSON.stringify([Object.freeze(new Date(9))]));
say("no prototype", () => JSON.stringify([Object.setPrototypeOf(new Date(10), null)]));
say("another prototype", () =>
  JSON.stringify([
    Object.setPrototypeOf(new Date(11), {
      toJSON() {
        return "of another prototype";
      },
    }),
  ]),
);
class Plain extends Date {}
class Speaking extends Date {
  toJSON(): string {
    return "speaking " + this.getTime();
  }
}
class Texted extends Date {
  toISOString(): string {
    return "texted " + this.getTime();
  }
}
say("subclasses", () => JSON.stringify([new Plain(12), new Speaking(13), new Texted(14)]));
say(
  "a replacer sees the text",
  () =>
    JSON.stringify({ at: new Date(15) }, (key, value) => (log.push(key + " " + typeof value), value)) +
    " " +
    log.splice(0).join(),
);

say("at the end", () => JSON.stringify(issue).length + " " + JSON.stringify([new Date(22)]));
//// json-stringify-with-a-replacer-that-changes-the-object.ts
// JSON.stringify with a replacer walks the fields of a compiled object as they were listed when the walk began, and reads each when its turn comes:
// what the replacer or a toJSON does to the object in between is seen as the language says.
const launder = new Function("value", process.argv[2] ?? "return value") as <V>(value: V) => V;
const seen: unknown[] = [];
function note(value: unknown): void { seen.push(value === undefined ? "undefined" : value); }
class Record4 { a = 1; b = "two"; c: unknown = true; d: unknown = null; }
type Loose = Record<string, unknown>;

note(JSON.stringify(new Record4(), (key, value) => value));
note(JSON.stringify(launder(new Record4()), (key, value) => typeof value === "number" ? value + 1 : value));
note(JSON.stringify(new Record4(), (key, value) => key === "b" ? undefined : value));
note(JSON.stringify(new Record4(), (key, value) => key === "c" && value === true ? { nested: Object.assign(new Record4(), { c: false }) } : value, 1));
note(JSON.stringify(new Record4(), function (this: Loose, key, value) { if (key === "a") this.c = "changed"; return value; }));
note(JSON.stringify(new Record4(), function (this: Loose, key, value) { if (key === "a") delete this.c; return value; }));
note(JSON.stringify(new Record4(), function (this: Loose, key, value) { if (key === "a") this.e = "added"; return value; }));
note(JSON.stringify(new Record4(), function (this: Loose, key, value) { if (key === "a") { delete this.b; this.b = "again"; } return value; }));
note(JSON.stringify(new Record4(), function (this: Loose, key, value) { if (key === "a") Object.defineProperty(this, "d", { get() { return "got"; }, enumerable: true, configurable: true }); return value; }));
note(JSON.stringify(new Record4(), function (this: Loose, key, value) { if (key === "a") Object.defineProperty(this, "d", { value: "hidden", enumerable: false }); return value; }));
note(JSON.stringify(new Record4(), function (this: Loose, key, value) { if (key === "a") this.b = 5; return value; }));
note(JSON.stringify(new Record4(), function (this: Loose, key, value) { if (key === "b") Object.freeze(this); return value; }));
note(JSON.stringify(new Record4(), function (this: Loose, key, value) { if (key === "a") Object.setPrototypeOf(this, { c: "inherited" }); if (key === "b") delete this.c; return value; }));
class WithToJSON { a = 1; inner = new Record4(); toJSON(key: string): unknown { return { key, a: this.a, inner: this.inner }; } }
note(JSON.stringify({ first: new WithToJSON(), list: [new WithToJSON()] }, (key, value) => value));
class Changes { a = 1; b: { toJSON(): unknown }; c = 3; constructor() { this.b = { toJSON: () => { (this as unknown as Loose).c = "by toJSON"; return "b"; } }; } }
note(JSON.stringify(new Changes())); note(JSON.stringify(new Changes(), (key, value) => value)); note(JSON.stringify(new Changes(), null, "\t"));
class Odd { "quo\"te" = 1; "new\nline" = 2; "é" = 3; "中" = 4; [Symbol.iterator] = 5; 7 = "index"; plain = 6; }
note(JSON.stringify(new Odd(), (key, value) => value)); note(JSON.stringify(launder(new Odd()), (key, value) => value, 2));
const keys: string[] = [];
JSON.stringify(launder({ x: new Record4(), y: [new Record4()] }), function (key, value) { keys.push(key); return value; });
note(keys.join());
note(JSON.stringify(new Record4(), ["d", "a", "missing"])); note(JSON.stringify([new Record4(), new Record4()], ["b"]));
let total = 0;
for (let i = 0; i < 300; i++) total += JSON.stringify(launder([new Record4(), new Record4(), { a: i }]), (key, value) => value).length;
note(total);
console.log(seen.join("\n"));
//// literal-cast-into-node-types.ts
// An object literal that is cast into a family of node types does not change what is known about the required fields of that family.
enum K { A = 1, B = 2 }
interface N { kind: K; pos: number; end: number; parent: N }
interface A extends N { kind: K.A; left: N }
interface B extends N { kind: K.B; text: string }
function NCtor(this: N, kind: K, pos: number, end: number) { this.pos = pos; this.end = end; this.kind = kind; this.parent = undefined! }
const allocator = { get: () => NCtor as any as new (kind: K, pos: number, end: number) => N }
let Ctor: new (kind: K, pos: number, end: number) => N
const base = <T extends N>(kind: T["kind"]) => new (Ctor || (Ctor = allocator.get()))(kind, -1, -1) as T
const makeA = (left: N) => { const a = base<A>(K.A); a.left = left; left.parent = a; return a }
const makeB = (text: string) => { const b = base<B>(K.B); b.text = text; return b }
const show = (n: N): string => (n.kind === K.A ? "(" + show((n as A).left) + ")" : (n as B).text) + ":" + (n.end - n.pos)
const fake = { text: "fake" } as B
console.log(show(makeA(makeA(makeB("real")))), fake.text, JSON.stringify(Object.keys(fake)), "kind" in fake, JSON.stringify(Object.keys(makeB("x"))))

interface P { o: number[]; u: number; v: number; w: number }
interface Q extends P { x?: number }
function PCtor(this: P, o: number[], u: number) { this.o = o; this.u = u; this.v = 2; this.w = 3 }
const PC = PCtor as any as new (o: number[], u: number) => P
const half = { o: [1], u: 7 } as Q
const whole = new PC([1], 1) as Q
console.log(half.u, JSON.stringify(Object.keys(half)), "v" in half, whole.u + whole.v + whole.w, JSON.stringify(Object.keys(whole)))
//// literal-fields-the-program-never-compares-convert.ts
// Objects built member by member in untyped code are read through a record type with a field whose type is a union of string literals that the program never compares with anything. A text passes however it was made, of the union or outside it: a literal type promises the kind, string. A number throws where typed code reads the field, and the object stays as it was.
type State = "open" | "closed" | "";
type Author = { login: string };
type Hit = { id: number; state: State; author: Author; note?: "a" | "b" };

const makeAuthor = (login: string): Author => ({ login });
const makeHit = (id: number, author: Author): Hit => ({ id, state: "open", author });
const read = (hit: Hit) => hit.id + ":" + hit.state + ":" + hit.state.length + ":" + hit.author.login + ":" + hit.note;
////= attempt
function grow(id: number, state: unknown, author: Author, note: unknown): any {
  const hit: any = { id };
  hit.state = state;
  hit.author = author;
  if (note !== 0) hit.note = note;
  return hit;
}

const author = makeAuthor("u");
console.log(read(makeHit(1, author)));
const texts = ["open", "closed", ""];
let lengths = 0;
const kept: any[] = [];
for (let i = 0; i < 3000; i++) {
  const made = "cl" + "osed".slice(0, 4);
  const hit = grow(i, i % 5 === 4 ? made : texts[i % 3], author, i % 2 ? "a" : 0);
  kept.push(hit);
  lengths += read(hit).length;
}
console.log(lengths);
for (const i of [0, 1, 2, 4, 2999]) console.log(JSON.stringify(kept[i]), Object.keys(kept[i]).join(), read(kept[i]));
for (const [name, state, note] of [
  ["a text outside the union", "other", 0],
  ["a longer text", "opened for good", 0],
  ["a text that begins alike", "open ", 0],
  ["a number", 5, 0],
  ["null", null, 0],
  ["undefined", undefined, 0],
  ["a note outside the union", "open", "c"],
  ["a note that is undefined", "open", undefined],
  ["not Latin-1", "opėn", 0],
] as [string, unknown, unknown][]) {
  const hit = grow(7, state, author, note);
  console.log(name + ":", attempt(() => read(hit)), JSON.stringify(hit));
}
console.log(attempt(() => { kept[0].state = "closed"; return read(kept[0]); }), attempt(() => { kept[0].state = "other"; return read(kept[0]); }));
//// literals-in-both-then-callbacks.ts
// The two callbacks of one .then() each make a literal; the promises go through Promise.all; the elements are stored into a loop variable whose type is the union of the two records.
import { stat } from 'node:fs/promises'

async function existing(candidates: string[]): Promise<string[]> {
  const probes = await Promise.all(
    candidates.map(dir =>
      stat(dir).then(
        () => ({ dir, exists: true as const }),
        (error: unknown) => ({ dir, exists: false as const, error }),
      ),
    ),
  )
  const dirs: string[] = []
  for (const probe of probes) {
    const { dir } = probe
    if (probe.exists) {
      dirs.push(dir)
      continue
    }
    const e = probe.error
    dirs.push('no ' + dir + ' ' + (e instanceof Error))
  }
  return dirs
}

console.log((await existing(['/', '/no-such-folder-here', '/tmp'])).join(' | '))
//// members-computed-from-dts-types/host.d.ts
// What a package's declaration file says of the host's settings, for main.ts.
export type Port = number;
export type Stringify<T> = { [K in keyof T]: string };
//// members-computed-from-dts-types/main.ts
// A member whose type a spread or a mapped type computes from a type in a declaration file is not tested: the declaration file may be wrong.
import type { Port, Stringify } from "./host";
const input: any = { a: 5, port: "eighty" };
const row = (name: string, f: () => unknown) => { let r: unknown; try { r = f(); } catch (e) { r = "THROWS " + (e as Error).message.split(" (bun")[0]; } console.log(name + ": " + JSON.stringify(r)); };
const kind = (v: unknown) => typeof v + " " + JSON.stringify(v);
interface Config { a: number }
interface Settings { port: Port }
interface Ports { [name: string]: Port }
row("a spread of a mapped type from the declaration file", () => { const stringified: Stringify<Config> = input; const copy = { ...stringified }; return kind(copy.a); });
row("a spread of an interface", () => { const settings: Settings = input; const copy = { ...settings }; return kind(copy.port); });
row("a library mapped type", () => { const settings: Partial<Settings> = input; return kind(settings.port); });
row("a library mapped type over an index signature", () => { const ports: Readonly<Ports> = input; return kind(ports.port); });
row("a mapped type in the program", () => { const ports: { [K in keyof Settings]: Port } = input; return kind(ports.port); });
row("a member typed by the program alone", () => { const config: Partial<Config> = { a: 1 }; const copy = { ...config }; return kind(copy.a); });
//// method-type-arg-checked-by-untyped-package/main.ts
// A generic async method keeps its resolver in a map; another method settles it later with what an untyped package's parse() returns. The caller, a method of the same class, awaits it with an explicit type argument that is a record type. Nothing in the program creates an object of that type; its only namesake is the literal handed to the untyped package. The answer matches the type and must be accepted, as in plain Bun.
import { any, object, type Schema } from './schema.js'
type Message = { id?: number; method?: string; result?: unknown }
type Pending<T> = { resolve: (result: T) => void; reject: (error: unknown) => void; schema?: Schema }

class Wire {
  private readonly pending = new Map<string, Pending<unknown>>()
  private next = 0

  arrive(line: string): void {
    const message = JSON.parse(line)
    const waiting = this.pending.get(message.request_id)
    if (!waiting) return
    this.pending.delete(message.request_id)
    if (message.subtype === 'error') return waiting.reject(new Error(message.error))
    const result = message.response ?? {}
    try {
      waiting.resolve(waiting.schema ? waiting.schema.parse(result) : {})
    } catch (error) {
      waiting.reject(error)
    }
  }

  private async send<Response>(request: { kind: string; body: unknown }, schema: Schema, { id = 'r' + this.next++ }: { id?: string } = {}): Promise<Response> {
    if (request.kind === '') throw new Error('no kind')
    Promise.resolve().then(() => this.arrive('{"request_id": "' + id + '", "subtype": "success", "response": {"reply": {"id": 7, "result": ' + JSON.stringify(request.body) + '}}}'))
    try {
      return await new Promise<Response>((resolve, reject) => {
        this.pending.set(id, { resolve: result => resolve(result as Response), reject, schema })
      })
    } finally {
      this.pending.delete(id)
    }
  }

  async ask(name: string, message: Message): Promise<Message> {
    const response = await this.send<{ reply: Message }>({ kind: 'ask', body: { name, message } }, object({ reply: any() as Schema<Message> }))
    return response.reply
  }
}
console.log(JSON.stringify(await new Wire().ask('n', { id: 1, method: 'm' })))
//// method-type-arg-checked-by-untyped-package/schema.d.ts
export type Schema<T = unknown> = { parse(given: unknown): T }
export function object(shape: Record<string, Schema>): Schema
export function any(): Schema<any>
//// method-type-arg-checked-by-untyped-package/schema.js
export function object(shape) {
  return {
    parse(given) {
      const out = {}
      for (const key of Object.keys(shape)) if (key in given) out[key] = given[key]
      return out
    },
  }
}
export function any() {
  return { parse: given => given }
}
//// method-type-arg-from-async-generator.ts
// A method of a class passes a record type as an explicit type argument to a generic function to an async generator. Nothing in the program creates an object of that type, and the only cast is `as R` inside the generic function. Data from JSON.parse that matches the type must be accepted, as in plain Bun.
type Part = { id?: number; name?: string; more?: unknown }
type Waiting = { resolve: (result: unknown) => void; reject: (error: unknown) => void }
class Unrelated { k = 1; j = 2; e = 3; ok = 4; a = 5; b = 6; c = 7; d = 8 }
const unrelated = new Unrelated()
if (unrelated.k + unrelated.j + unrelated.e + unrelated.ok + unrelated.a + unrelated.b + unrelated.c + unrelated.d < 0) console.log('never')
const waiting = new Map<number, Waiting>()
const seen: unknown[] = []
let next = 0
////= arrive-2
async function* each<R>(texts: string[]): AsyncGenerator<R> { for (const text of texts) yield JSON.parse(text) as R }
class Caller { async ask() { const out: Part[] = []; for await (const one of each<{ k: Part }>(['{"k": {"id": 1}}'])) out.push(one.k); return out } }
console.log(JSON.stringify(await new Caller().ask()))
//// method-type-arg-frozen.ts
// A method of a class passes a record type as an explicit type argument to a generic function and the data is frozen. Nothing in the program creates an object of that type, and the only cast is `as R` inside the generic function. Data from JSON.parse that matches the type must be accepted, as in plain Bun.
type Part = { id?: number; name?: string; more?: unknown }
type Waiting = { resolve: (result: unknown) => void; reject: (error: unknown) => void }
class Unrelated { k = 1; j = 2; e = 3; ok = 4; a = 5; b = 6; c = 7; d = 8 }
const unrelated = new Unrelated()
if (unrelated.k + unrelated.j + unrelated.e + unrelated.ok + unrelated.a + unrelated.b + unrelated.c + unrelated.d < 0) console.log('never')
const waiting = new Map<number, Waiting>()
const seen: unknown[] = []
let next = 0
////= arrive-2
function frozen<R>(text: string): Promise<R> { return Promise.resolve(Object.freeze(JSON.parse(text)) as R) }
class Caller { async ask() { const answer = await frozen<{ k: Part }>('{"k": {"id": 1}}'); return [answer.k, Object.isFrozen(answer)] } }
console.log(JSON.stringify(await new Caller().ask()))
//// method-type-arg-generic-class-argument.ts
// A method of a class passes a record type as an explicit type argument to a generic function as the type argument of a generic class that stores the data in a field. Nothing in the program creates an object of that type, and the only cast is `as R` inside the generic function. Data from JSON.parse that matches the type must be accepted, as in plain Bun.
type Part = { id?: number; name?: string; more?: unknown }
type Waiting = { resolve: (result: unknown) => void; reject: (error: unknown) => void }
class Unrelated { k = 1; j = 2; e = 3; ok = 4; a = 5; b = 6; c = 7; d = 8 }
const unrelated = new Unrelated()
if (unrelated.k + unrelated.j + unrelated.e + unrelated.ok + unrelated.a + unrelated.b + unrelated.c + unrelated.d < 0) console.log('never')
const waiting = new Map<number, Waiting>()
const seen: unknown[] = []
let next = 0
////= arrive-2
class Box<R> { value: R | undefined; fill(text: string): void { this.value = JSON.parse(text) as R } }
class Caller { async ask() { const box = new Box<{ k: Part }>(); box.fill('{"k": {"id": 1}}'); return box.value!.k } }
console.log(JSON.stringify(await new Caller().ask()))
//// method-type-arg-through-async-wrapper.ts
// A method of a class passes a record type as an explicit type argument to a generic function through a second generic function that is async. Nothing in the program creates an object of that type, and the only cast is `as R` inside the generic function. Data from JSON.parse that matches the type must be accepted, as in plain Bun.
type Part = { id?: number; name?: string; more?: unknown }
type Waiting = { resolve: (result: unknown) => void; reject: (error: unknown) => void }
class Unrelated { k = 1; j = 2; e = 3; ok = 4; a = 5; b = 6; c = 7; d = 8 }
const unrelated = new Unrelated()
if (unrelated.k + unrelated.j + unrelated.e + unrelated.ok + unrelated.a + unrelated.b + unrelated.c + unrelated.d < 0) console.log('never')
const waiting = new Map<number, Waiting>()
const seen: unknown[] = []
let next = 0
////= arrive-2
async function send<R>(text: string): Promise<R> { return await later<R>(text) }
class Caller { async ask() { const answer = await send<{ k: Part }>('{"k": {"id": 1}}'); return answer.k } }
console.log(JSON.stringify(await new Caller().ask()))
