// Parsed data that travels as `any` and first meets its type inside a container, or below a value that has met its type.
// The type has more than six members; the type of one of its members has two.
interface Origin { source: string; hops: number }
////= Message-2
interface Batch { name: string; items: Message[] }
const line = '{"id":1,"at":0.5,"size":2.5,"weight":3.5,"body":"hello"}'
const withOrigin = '{"id":2,"at":0.5,"size":2.5,"weight":3.5,"body":"hi","origin":{"source":"wire","hops":2},"tags":["x","y"]}'
const bag: unknown[] = []
function travel(x: unknown): any { bag.push(x); return bag.pop() }
function own(n: number): Message { return { id: n, at: 1.5, size: 2.5, weight: 3.5, body: "own", retries: n, delay: 0.5, sentAt: 4.5, score: 0.25, tags: ["o"], origin: { source: "own", hops: 1 } } }
////= handle-2
const made = own(9)
////= row-2
row("made by the program", () => handle(made))
row("a small member, kept", () => { const m: Message = travel(JSON.parse(withOrigin)); const origin: Origin | undefined = m.origin; return origin ? origin.source + origin.hops : "none" })
//// parsed-json-spread-onto-narrower-copy.ts
// `{ ...source, ...more }` under a written type, where `more` is parsed JSON and the object that is copied was created as a narrower type than the one the copy is written as: the copy takes whatever its own written type takes.
const row = (name: string, f: () => unknown) => { let r: unknown; try { r = JSON.stringify(f()); } catch (e) { r = "THROWS " + (e as Error).message.split(" (bun")[0]; } console.log(name + ": " + r); };

type Failures = { last: number | null; count: number; name: string };
type Fresh = { last: null; count: number; name: string };
type FreshAndMore = { last: null; count: number; name: string; extra: boolean };
type Counts = { last: number; count: number };

const fresh: Fresh = { last: null, count: 0, name: "fresh" };
const freshAndMore: FreshAndMore = { last: null, count: 0, name: "more", extra: true };
const wide: Failures = { last: null, count: 0, name: "wide" };
const constant = { last: null, count: 0, name: "constant" } as const;

function merge(failures: Failures, counts: Counts): Failures {
  if (failures.last === null) return { ...failures, ...counts };
  return failures;
}
function mergeInsideTry(failures: Failures, counts: Counts): Failures {
  try {
    return { ...failures, ...counts };
  } catch {
    return failures;
  }
}
function mergeAndName(failures: Failures, counts: Counts): Failures {
  return { ...failures, ...counts, name: "named" };
}
const parsed = (text: string) => JSON.parse(text) as Counts;

const sources: [string, Failures][] = [["a narrower written type", fresh], ["a narrower type with one member more", freshAndMore], ["the written type itself", wide], ["an `as const` literal", constant]];
for (const [name, source] of sources) {
  row(name + ": a second spread of parsed JSON", () => merge(source, parsed('{"last":9,"count":2}')));
  row(name + ": inside try", () => mergeInsideTry(source, parsed('{"last":10,"count":3}')));
  row(name + ": with a member behind it", () => mergeAndName(source, parsed('{"last":11,"count":4}')));
  row(name + ": the keys of the copy", () => Object.keys(merge(source, parsed('{"count":5,"last":12}'))));
  row(name + ": the copy is read", () => { const copy = merge(source, parsed('{"last":13,"count":6}')); return copy.last! + copy.count; });
  row(name + ": the source is left as it was", () => source);
}
let sum = 0;
for (let i = 0; i < 5000; i++) {
  const source = i % 3 === 0 ? fresh : i % 3 === 1 ? wide : freshAndMore;
  sum += merge(source, parsed('{"last":' + i + ',"count":1}')).last!;
}
row("many times, the types taking turns", () => sum);
//// parsed-json-through-explicit-any.ts
// Parsed JSON passes through the program's own `any` or `unknown` (a result, a parameter, a property, a `yield`) before it reaches a declared type. Any object passes, a member that is missing reads undefined, and a member of another kind throws a TypeError where typed code reads it.
function row(name: string, run: () => unknown): void { try { console.log(name, "|", run()) } catch (e) { console.log(name, "| THROWN", (e as Error).constructor.name) } }
function pass(x: any): any { return x }
interface Settings { name: string; nested: { on: boolean } }
function show(x: Settings): string { return x.name + (x.nested ? x.nested.on : "-") }
row("what a function of the program yields as any", () => show(pass(JSON.parse('{"name":"n","nested":{"on":true}}')) as Settings))
interface Wanted { title: string; deep: { on: boolean } }
function showWanted(x: Wanted): string { return x.title + (x.deep ? x.deep.on : "-") }
function toWanted(x: unknown): Wanted { return x as Wanted }
row("a parameter of type unknown", () => showWanted(toWanted(JSON.parse('{"title":"u","deep":{"on":false}}'))))
row("less than the type says", () => JSON.stringify(toWanted({})) + toWanted({}).title + showWanted(toWanted({ title: 1 })))
interface Pair { a: number; b: { c: number } }
function sum(x: Pair): number { return x.a + x.b.c }
row("what a built-in yields as any", () => sum(Reflect.get({ v: JSON.parse('{"a":3,"b":{"c":4}}') }, "v") as Pair))
interface Held { p: number; q: { r: number } }
function sumHeld(x: Held): number { return x.p + x.q.r }
const held: { any: any } = { any: JSON.parse('{"p":5,"q":{"r":6}}') }
row("a property of type any in an annotated variable", () => { const r: Held = held.any; return sumHeld(r) + " " + (r === held.any) })
function* steps(flag: boolean): Generator<{ op: string }, string, { e: string } | string> { const r = flag ? { e: "LIT" } : yield { op: "stat" }; if (typeof r === "object" && r.e !== undefined && (r.e === "ENOENT" || r.e === "B")) return keep(r) ? r.e : "no"; return "ok" }
function keep(x: { e: string }): boolean { return x.e.length > 0 }
function run(g: Generator<any, any, any>) { let s = g.next(); while (!s.done) s = g.next(JSON.parse('{"e":"ENOENT"}')); return s.value }
row("the value of a yield", () => run(steps(false)) + " " + run(steps(true)))
//// parsed-misfits-cast-through-another-type.ts
// The texts of parsed-misfits-reach-typed-functions-in-seven-ways, cast to an unrelated type first and to the type they are read as afterwards. Each cast lets any object pass as it is and throws for a number, a string or a boolean. A missing field reads undefined, and a field of another kind throws at its first typed read.
interface Point { x: number; y: number }
interface Row { id: number; name: string; at: Point; next: Row | null }
interface Other { id: number }
function show(row: Row): string {
  return String(row.id) + "|" + String(row.name) + "|" + String(row.at && row.at.x) + "|" + String(row.next && row.next.id) + "|" + Object.keys(row).join(",");
}
function grow(row: Row): string { row.id = 7; row.name = row.name + "!"; return show(row); }
////= attempt-3
const made: Row = { id: 1, name: "a", at: { x: 1, y: 2 }, next: null };
////= texts
attempt("made", () => show(made));
for (const text of texts) {
  attempt("through", () => { const other = JSON.parse(text) as Other; return show(other as unknown as Row); });
  attempt("through any", () => { const other = JSON.parse(text) as Other; const row: Row = other as any; return show(row); });
  attempt("through, stored", () => { const other = JSON.parse(text) as Other; return grow(other as unknown as Row); });
  attempt("through, listed", () => { const other = JSON.parse(text) as Other; const rows: Row[] = [made, other as unknown as Row]; return rows.map(show).join(" & "); });
  attempt("through, linked", () => { const other = JSON.parse(text) as Other; const head: Row = { id: 0, name: "h", at: { x: 0, y: 0 }, next: other as unknown as Row }; return show(head); });
}
attempt("back", () => { const other = made as unknown as Other; return String(other.id) + "|" + Object.keys(other).join(","); });
attempt("made again", () => grow(made));
//// parsed-misfits-reach-typed-functions-in-seven-ways.ts
// Parsed JSON that does not fit its type reaches typed functions in seven ways. Any object, an array too, passes the cast, the annotation and the parameter as it is, and so does null; a number, a string or a boolean throws there. A missing field reads undefined, and a field of another kind throws at its first typed read.
interface Point { x: number; y: number }
interface Row { id: number; name: string; at: Point; next: Row | null }
interface Other { id: number }
function show(row: Row): string {
  return String(row.id) + "|" + String(row.name) + "|" + String(row.at && row.at.x) + "|" + String(row.next && row.next.id) + "|" + Object.keys(row).join(",");
}
function grow(row: Row): string { row.id = 7; row.name = row.name + "!"; return show(row); }
////= attempt-3
const made: Row = { id: 1, name: "a", at: { x: 1, y: 2 }, next: null };
////= texts
attempt("made", () => show(made));
for (const text of texts) {
  attempt("as", () => show(JSON.parse(text) as Row));
  attempt("declared", () => { const row: Row = JSON.parse(text); return show(row); });
  attempt("through", () => { const other = JSON.parse(text) as Other; return show(other as unknown as Row); });
  attempt("stored", () => grow(JSON.parse(text) as Row));
  attempt("held", () => { const holder: { row: Row } = { row: JSON.parse(text) as Row }; return show(holder.row); });
  attempt("listed", () => { const rows: Row[] = [made, JSON.parse(text) as Row]; return rows.map(show).join(" & "); });
  attempt("linked", () => { const head: Row = { id: 0, name: "h", at: { x: 0, y: 0 }, next: JSON.parse(text) as Row }; return show(head); });
}
attempt("made again", () => grow(made));
//// parsed-objects-of-every-size.ts
// JSON.parse of objects with 0 to 200 properties, on both sides of every limit of inline and out-of-line property storage: keys, values, and a property added and deleted afterwards do not depend on which parser created the object.
const sizes = [0, 1, 6, 7, 8, 48, 49, 61, 62, 63, 64, 65, 200];
const callsPerText = 24;
const untyped: any = { parse: JSON.parse };
const indexLikeNames = ["2", "4294967294", "0", "4294967295", "-1", "01"];

function valueText(index: number): string {
  switch (index % 8) {
    case 0:
      return String(index * 100000007);
    case 1:
      return "-" + index + ".5";
    case 2:
      return '"s' + index + '"';
    case 3:
      return index % 16 === 3 ? "true" : "false";
    case 4:
      return "null";
    case 5:
      return "[" + index + ',"e",[]]';
    case 6:
      return '{"n":' + index + ',"m":{}}';
    default:
      return index % 16 === 7 ? "-0" : index + "e20";
  }
}

function plainMember(index: number): string {
  return '"k' + index + '":' + valueText(index);
}

function memberWithDuplicate(index: number): string {
  if (index % 3) return plainMember(index);
  const earlierName = (index % 6 ? '"\\u006b' : '"k') + (index >> 1) + '"';
  return plainMember(index) + "," + earlierName + ':"repeated after k' + index + '"';
}

function indexLikeMember(size: number, index: number): string {
  if (index % 4 !== 1) return plainMember(index);
  return '"' + (indexLikeNames[index >> 2] ?? String(1000 + size - index)) + '":' + valueText(index);
}

function spacedMember(index: number): string {
  return '\n\t"k' + index + '" :\r ' + valueText(index) + " ";
}

function wideMember(index: number): string {
  return index % 3 === 1 ? '"k' + index + '中":"é中' + index + '"' : plainMember(index);
}

function objectText(size: number, memberText: (index: number) => string = plainMember): string {
  const members: string[] = [];
  for (let index = 0; index < size; index++) members.push(memberText(index));
  return "{" + members.join(",") + "}";
}

function pairText(object: string): string {
  return "[" + object + "," + object + "]";
}

function toWideString(text: string): string {
  return ("中" + text).slice(1);
}

function identityReviver(key: string, value: any): any {
  return value;
}

function sourceTextReviver(key: string, value: any, context?: any): any {
  if (key === "k2") return undefined;
  if (typeof value === "number") return context?.source ?? "no source text for " + value;
  return value;
}

function describe(value: any): string {
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value !== "object" || value === null) return Object.is(value, -0) ? "-0" : String(value);
  if (Array.isArray(value)) return "[" + value.map(element => describe(element)).join(",") + "]";
  return (
    "{" +
    Object.keys(value)
      .map(key => key + "=" + describe(value[key]))
      .join(",") +
    "}"
  );
}

function mutationReport(value: any): string {
  const keys = Object.keys(value);
  const enumerated: string[] = [];
  for (const name in value) enumerated.push(name);
  const hasOnlyPlainDataProperties = Object.values(Object.getOwnPropertyDescriptors(value)).every(
    descriptor => descriptor.writable && descriptor.enumerable && descriptor.configurable,
  );
  const removed = keys.length ? keys[keys.length >> 1] : "added";
  const lines = [
    keys.length + " keys",
    Reflect.ownKeys(value).length + " own keys",
    "for-in agrees: " + (enumerated.join() === keys.join()),
    "only plain data properties: " + hasOnlyPlainDataProperties,
    "extensible: " + Object.isExtensible(value),
    "ordinary prototype: " + (Object.getPrototypeOf(value) === Object.prototype),
    "parsed: " + describe(value),
  ];
  value.added = "new";
  lines.push("added: " + describe(value));
  const wasDeleted = delete value[removed];
  lines.push("deleted " + removed + " (" + wasDeleted + "): " + describe(value));
  value[removed] = "again";
  lines.push("stored " + removed + " again: " + describe(value));
  return lines.join("\n  ");
}

function checkParsedObjects(label: string, text: string, parse: (text: string) => any[], expected = ""): string {
  let agreeing = 0;
  for (let call = 0; call < callsPerText; call++) {
    for (const value of parse(text)) {
      const actual = mutationReport(value);
      if (!expected) {
        expected = actual;
        console.log(label + ": " + actual);
      } else if (actual === expected) agreeing++;
      else console.log(label + ", call " + call + " differs: " + actual);
    }
  }
  console.log(label + ": " + agreeing + " objects agree");
  return expected;
}

function errorMessage(parse: () => unknown): string {
  try {
    parse();
    return "no error";
  } catch (error: any) {
    return error.name + ": " + error.message;
  }
}

function malformedObjectTexts(size: number): [string, string][] {
  const open = objectText(size).slice(0, -1);
  const beforeLastMember = size ? open + "," : open;
  return [
    ["no closing brace", open],
    ["comma before the closing brace", open + ",}"],
    ["second closing brace", open + "}}"],
    ["no colon", beforeLastMember + '"last" 1}'],
    ["no value", beforeLastMember + '"last":}'],
    ["misspelled null", beforeLastMember + '"last":nul}'],
    ["unquoted name", beforeLastMember + "last:1}"],
    ["single-quoted name", beforeLastMember + "'last':1}"],
    ["unterminated string", beforeLastMember + '"last":"open}'],
    ["line break in a string", beforeLastMember + '"last":"a\nb"}'],
    ["unknown escape", beforeLastMember + '"last":"\\x41"}'],
    ["leading zero", beforeLastMember + '"last":01}'],
  ];
}

for (const size of sizes) {
  const label = size + " properties, ";
  const middle = size >> 1;
  const object = objectText(size);
  const pair = pairText(object);
  const spaced = objectText(size, spacedMember);
  const duplicates = pairText(objectText(size, memberWithDuplicate));

  const expected = checkParsedObjects(label + "twice in one text", pair, text => JSON.parse(text));
  checkParsedObjects(label + "alone", object, text => [JSON.parse(text)], expected);
  checkParsedObjects(label + "JSON.parse called as a value", pair, text => untyped.parse(text), expected);
  checkParsedObjects(label + "whitespace", "[ " + spaced + " ,\n" + spaced + "\t]", text => JSON.parse(text), expected);
  checkParsedObjects(label + "16-bit source", toWideString(pair), text => JSON.parse(text), expected);
  checkParsedObjects(label + "identity reviver", pair, text => JSON.parse(text, identityReviver), expected);
  checkParsedObjects(
    label + "nested in arrays and objects",
    '{"list":[[' + object + "],[[0," + object + ']]],"last":' + object + "}",
    text => {
      const parsed = JSON.parse(text);
      return [parsed.list[0][0], parsed.list[1][0][1], parsed.last];
    },
    expected,
  );

  checkParsedObjects(label + "duplicate names", duplicates, text => JSON.parse(text));
  checkParsedObjects(
    label + "index-like names",
    pairText(objectText(size, index => indexLikeMember(size, index))),
    text => JSON.parse(text),
  );
  checkParsedObjects(
    label + "__proto__",
    pairText(objectText(size, index => (index === middle ? '"__proto__":{"polluted":true}' : plainMember(index)))),
    text => JSON.parse(text),
  );
  checkParsedObjects(label + "16-bit names and values", pairText(objectText(size, wideMember)), text =>
    JSON.parse(text),
  );
  checkParsedObjects(label + "source text reviver", pair, text => JSON.parse(text, sourceTextReviver));
  checkParsedObjects(label + "duplicate names, source text reviver", duplicates, text =>
    JSON.parse(text, sourceTextReviver),
  );
}

for (const size of sizes) {
  const object = objectText(size);
  for (const [label, malformed] of malformedObjectTexts(size)) {
    const text = "[" + object + "," + malformed + "]";
    const messages = [
      errorMessage(() => JSON.parse(text)),
      errorMessage(() => JSON.parse(malformed)),
      errorMessage(() => untyped.parse(text)),
      errorMessage(() => JSON.parse(text, identityReviver)),
      errorMessage(() => JSON.parse(toWideString(text))),
    ];
    console.log(size + " properties, " + label + ": " + messages.join(" | "));
  }
  console.log(size + " properties, well formed again: " + describe(JSON.parse(pairText(object))[1]));
}

console.log("Object.prototype has polluted: " + ("polluted" in untyped));

export {};
//// parsed-part-downcast-to-a-subtype-of-primitives.ts
// A part of parsed JSON is cast from its base type to a subtype whose other fields are primitives. Any object passes the cast, a number throws there. A missing field reads undefined, and a field of another kind throws at its first typed read.
interface Base { kind: number }
interface Leaf extends Base { text: string; size: number }
interface Info { version: string; root: Base }
function showLeaf(leaf: Leaf): string { return String(leaf.kind) + "|" + String(leaf.text) + "|" + String(leaf.size); }
function makeLeaf(text: string, size: number): Leaf { return { kind: 1, text, size }; }
function readInfo(text: string): Info { return JSON.parse(text) as Info; }
let sum = "";
for (let i = 0; i < 3; i++) sum += showLeaf(makeLeaf("t" + i, i)) + " ";
console.log(sum);
const texts: string[] = ['{"version":"1","root":{"kind":1,"text":"a","size":3}}', '{"version":"1","root":{"kind":1}}', '{"version":"1","root":{"kind":1,"text":5,"size":"big"}}', '{"version":"1","root":{"size":3,"more":true,"text":"a","kind":1}}', '{"version":"1","root":7}', '{"version":"1","root":[]}'];
for (const text of texts) {
  try { console.log("leaf " + showLeaf(readInfo(text).root as Leaf)); } catch (error) { console.log("leaf threw " + (error as Error).constructor.name); }
}
//// parsed-part-downcast-to-subtypes.ts
// A part of parsed JSON is cast from its base type to one of two subtypes, read, stored to, and put into a literal and an array of the program. Any object passes a cast, a parameter and a field of an object type; a number throws there. A missing field reads undefined, and a field of another kind throws at its first typed read.
interface Base { kind: number }
interface Leaf extends Base { text: string; size: number }
interface Pair extends Base { left: Base; right: Base }
interface Info { version: string; root: Base }
function showLeaf(leaf: Leaf): string { return String(leaf.kind) + "|" + String(leaf.text) + "|" + String(leaf.size) + "|" + Object.keys(leaf).join(","); }
function showPair(pair: Pair): string { return String(pair.kind) + "|" + String(pair.left && pair.left.kind) + "|" + String(pair.right && pair.right.kind); }
function show(base: Base): string { return base.kind === 1 ? showLeaf(base as Leaf) : base.kind === 2 ? showPair(base as Pair) : "other " + String(base.kind); }
function grow(leaf: Leaf): string { leaf.size = 9; leaf.text = leaf.text + "!"; return showLeaf(leaf); }
////= attempt-3
const leaf: Leaf = { kind: 1, text: "t", size: 1 };
const pair: Pair = { kind: 2, left: leaf, right: { kind: 1, text: "u", size: 2 } as Leaf };
const texts: string[] = [
  '{"version":"1","root":{"kind":1,"text":"a","size":3}}',
  '{"version":"1","root":{"size":3,"text":"a","kind":1}}',
  '{"version":"1","root":{"kind":1}}',
  '{"version":"1","root":{"kind":1,"text":5,"size":"big"}}',
  '{"version":"1","root":{"kind":1,"text":"a","size":3,"more":true}}',
  '{"version":"1","root":{"kind":2,"left":{"kind":1,"text":"l","size":1},"right":{"kind":3}}}',
  '{"version":"1","root":{"kind":2}}',
  '{"version":"1","root":{"kind":2,"left":7,"right":null}}',
  '{"version":"1","root":{"kind":3}}',
  '{"version":"1","root":[]}', '{"version":"1","root":7}', '{"version":"1"}', '{"version":"1","root":null}',
];
attempt("made", () => show(leaf) + " & " + show(pair));
for (const text of texts) {
  attempt("shown", () => show((JSON.parse(text) as Info).root));
  attempt("leaf", () => showLeaf((JSON.parse(text) as Info).root as Leaf));
  attempt("grown", () => grow((JSON.parse(text) as Info).root as Leaf));
  attempt("paired", () => { const both: Pair = { kind: 2, left: leaf, right: (JSON.parse(text) as Info).root }; return show(both) + " & " + show(both.right); });
  attempt("listed", () => { const leaves: Leaf[] = [leaf, (JSON.parse(text) as Info).root as Leaf]; return leaves.map(showLeaf).join(" & "); });
}
attempt("made again", () => grow(leaf) + " & " + show(pair));
//// parsed-part-downcast-to-subtypes-that-hold-objects.ts
// A part of parsed JSON is cast from its base type to subtypes whose fields hold objects, arrays and functions. Any object passes where an object type is written. A field written as an array throws at its typed read when it holds no array, a field written as an object type when it holds a number, a number field when it holds a string. A store through the typed reference replaces what did not fit.
interface Base { kind: number }
interface Point { x: number; y: number }
interface Shape extends Base { at: Point; tags: string[]; next: Shape | null }
interface Named extends Base { at: Point; name: string }
interface Watcher extends Base { observe: (value: number) => number }
interface Info { version: string; root: Base; all: Base[] }
function showPoint(point: Point): string { return point ? String(point.x) + "," + String(point.y) : String(point); }
function showShape(shape: Shape): string { return String(shape.kind) + "|" + showPoint(shape.at) + "|" + String(shape.tags && shape.tags.length) + "|" + String(shape.next && shape.next.kind) + "|" + Object.keys(shape).join(","); }
function showNamed(named: Named): string { return String(named.kind) + "|" + showPoint(named.at) + "|" + String(named.name); }
function watch(watcher: Watcher | null): string { return watcher === null ? "none" : typeof watcher.observe === "function" ? String(watcher.observe(2)) : "no observe " + String(watcher.kind); }
function move(shape: Shape): string { shape.at = { x: 9, y: 9 }; shape.tags = ["moved"]; return showShape(shape); }
function makeShape(kind: number): Shape { return { kind, at: { x: kind, y: kind + 1 }, tags: ["a", "b"], next: null }; }
function makeNamed(kind: number): Named { return { kind, at: { x: 0, y: 0 }, name: "n" + kind }; }
function readInfo(text: string): Info { return JSON.parse(text) as Info; }
////= attempt-3
const roots: string[] = [
  '{"kind":1,"at":{"x":1,"y":2},"tags":["t"],"next":null}',
  '{"next":null,"tags":["t"],"at":{"y":2,"x":1},"kind":1}',
  '{"kind":1,"at":{"x":1,"y":2},"tags":["t"],"next":{"kind":2,"at":{"x":3,"y":4},"tags":[],"next":null}}',
  '{"kind":1,"at":{"x":1,"y":2},"tags":["t"],"next":{"kind":2}}',
  '{"kind":1}',
  '{"kind":1,"at":null,"tags":null,"next":null}',
  '{"kind":1,"at":{"x":"one"},"tags":"none","next":7}',
  '{"kind":1,"at":{"x":1,"y":2,"z":3},"tags":[1,2,3],"next":null,"name":"both","more":{"deep":true}}',
  '{"kind":1,"at":[1,2],"tags":{"length":5},"next":[]}',
  '{}', '[]',
];
attempt("made", () => showShape(makeShape(1)) + " & " + showNamed(makeNamed(2)));
for (const root of roots) {
  const text = '{"version":"1","root":' + root + ',"all":[' + root + ',' + root + ']}';
  attempt("shape", () => showShape(readInfo(text).root as Shape));
  attempt("both", () => { const held = readInfo(text).root; return showShape(held as Shape) + " & " + showNamed(held as Named) + " & " + showShape(held as Shape); });
  attempt("moved", () => { const held = readInfo(text).root; return move(held as Shape) + " & " + showNamed(held as Named); });
  attempt("field", () => { const holder: { shape: Shape; named: Named } = { shape: readInfo(text).root as Shape, named: makeNamed(3) }; holder.named = holder.shape as Base as Named; return showShape(holder.shape) + " & " + showNamed(holder.named); });
  attempt("all", () => readInfo(text).all.map((base) => showShape(base as Shape)).join(" & "));
  attempt("mixed", () => { const shapes: Shape[] = [makeShape(4), readInfo(text).root as Shape]; shapes[0].next = shapes[1]; return shapes.map(showShape).join(" & "); });
  attempt("watched", () => watch(readInfo(text).root as Watcher));
}
const withAccessor: Base = Object.defineProperty({ kind: 1, tags: ["t"], next: null } as object, "at", { get() { return { x: 5, y: 6 }; }, enumerable: true, configurable: true }) as Base;
attempt("accessor", () => { const info = readInfo('{"version":"1","root":{"kind":0},"all":[]}'); info.root = withAccessor; return showShape(info.root as Shape) + " & " + showNamed(info.root as Named); });
attempt("made again", () => move(makeShape(5)) + " & " + watch(null) + " & " + watch({ kind: 1, observe: (value) => value * 2 }));
//// parsed-text-into-every-typed-position.ts
// JSON.parse(text) and `await response.json()` that go straight into a typed position: an annotated variable, an assertion, an argument, a return, a field, and an awaited body. Each position has a record type of its own, so a parser for each type shows that the compiler found the type at each position and builds the object as that type. Text that fits is read through its type, also after untyped code has changed the object. Text that does not fit and text that is no JSON give what plain Bun gives.
// STATISTIC: TypedResultsSelected >= 6
// STATISTIC: ParsersCreated >= 6
type InVariable = { variableId: number; variableName: string };
type Asserted = { assertedId: number; assertedName: string };
type Argument = { argumentId: number; argumentName: string };
type Returned = { returnedId: number; returnedName: string };
type InField = { fieldId: number; fieldName: string };
type InBody = { bodyId: number; bodyName: string };
type Change = (value: any, prefix: string) => void;

////= describe

function intoVariable(text: string, change: Change): string {
  const value: InVariable = JSON.parse(text);
  change(value, "variable");
  return value.variableId + " " + value.variableName + " " + describe(value);
}

function asserted(text: string, change: Change): string {
  const value = JSON.parse(text) as Asserted;
  change(value, "asserted");
  return value.assertedId + " " + value.assertedName + " " + describe(value);
}

function takeArgument(value: Argument, change: Change): string {
  change(value, "argument");
  return value.argumentId + " " + value.argumentName + " " + describe(value);
}
function intoArgument(text: string, change: Change): string {
  return takeArgument(JSON.parse(text), change);
}

////= lines-5	returned	Returned
function fromReturn(text: string, change: Change): string {
  const value = returned(text);
  change(value, "returned");
  return value.returnedId + " " + value.returnedName + " " + describe(value);
}

class Holder {
  field: InField = { fieldId: 0, fieldName: "none" };
}
function intoField(text: string, change: Change): string {
  const holder = new Holder();
  holder.field = JSON.parse(text);
  change(holder.field, "field");
  return holder.field.fieldId + " " + holder.field.fieldName + " " + describe(holder.field);
}

async function awaitedBody(response: Response, change: Change): Promise<string> {
  const value: InBody = await response.json();
  change(value, "body");
  return value.bodyId + " " + value.bodyName + " " + describe(value);
}

function textsFor(prefix: string): string[] {
  const id = JSON.stringify(prefix + "Id");
  const name = JSON.stringify(prefix + "Name");
  return [
    `{${id}:1,${name}:"one"}`,
    `{${name}:"two",${id}:2}`,
    ` {\n\t${id} : 3 ,\r\n\t${name} : "three"\n} `,
    `{${id}:-0,${name}:""}`,
    `{${id}:1.5e3,${name}:"\\u00e9\\n\\"quoted\\""}`,
    `{${id}:4,${name}:"four","extra":[true,null,{"deep":1}]}`,
    `{"first":0,${id}:5,${name}:"five"}`,
    `{${id}:6}`,
    `{${name}:"seven"}`,
    `{${id}:"eight",${name}:8}`,
    `{${id}:null,${name}:null}`,
    `{${id}:{"nested":9},${name}:["nine"]}`,
    `{${id}:10,${name}:"ten",${id}:11}`,
    `{"__proto__":{"inherited":1},${id}:12,${name}:"twelve"}`,
    `{}`,
    `[]`,
    `[{${id}:13,${name}:"thirteen"}]`,
    `null`,
    `true`,
    `14`,
    `"text"`,
    ``,
    ` `,
    `{`,
    `{${id}:1,}`,
    `{${id}:1}}`,
    `{${id}:01}`,
    `{${id}:1 ${name}:"one"}`,
    `{'single':1}`,
    `undefined`,
  ];
}

const nothing: Change = () => {};
const changes: [string, Change][] = [
  ["a value of another kind", (value, prefix) => void (value[prefix + "Id"] = "text")],
  ["a member deleted", (value, prefix) => void delete value[prefix + "Name"]],
  ["a member deleted and added again", (value, prefix) => void (delete value[prefix + "Id"], (value[prefix + "Id"] = 20))],
  ["a member added", value => void (value.added = true)],
  ["an accessor", (value, prefix) => void Object.defineProperty(value, prefix + "Id", { get: () => 100, enumerable: true, configurable: true })],
  ["hidden", (value, prefix) => void Object.defineProperty(value, prefix + "Name", { enumerable: false })],
  ["frozen", value => void Object.freeze(value)],
  ["another prototype", (value, prefix) => void (delete value[prefix + "Name"], Object.setPrototypeOf(value, { [prefix + "Name"]: "inherited" }))],
];

const positions: [string, (text: string, change: Change) => string | Promise<string>][] = [
  ["variable", intoVariable],
  ["asserted", asserted],
  ["argument", intoArgument],
  ["returned", fromReturn],
  ["field", intoField],
  ["body", (text, change) => awaitedBody(new Response(text), change)],
];

for (const [prefix, read] of positions) {
  const texts = textsFor(prefix);
  for (const text of texts) {
    let said: string;
    try {
      said = await read(text, nothing);
    } catch (error) {
      said = "threw " + (error instanceof SyntaxError ? error.name + ": " + error.message : (error as Error).name);
    }
    console.log(prefix + " " + JSON.stringify(text) + " -> " + said);
  }
  for (const [name, change] of changes) console.log(prefix + ", " + name + " -> " + (await read(texts[0]!, change)));
}

let sum = 0;
let names = 0;
for (let at = 0; at < 300; at++) {
  const value = returned(at % 7 === 3 ? "[" + at + "]" : at % 7 === 5 ? '{"returnedName":"n' + at + '","returnedId":"' + at + '"}' : '{"returnedId":' + at + ',"returnedName":"n' + at + '"}');
  sum += typeof value.returnedId === "number" ? value.returnedId : 1000;
  names += typeof value.returnedName === "string" ? value.returnedName.length : 0;
}
console.log(sum, names);
//// parsed-via-untyped-annotated-constant.ts
// Parsed data that travels as `any` or `unknown` before a typed function first holds it, some of its optional members absent: queues,
// caches, event buses. The type has more than six members.
interface Meta { source: string; hops: number; a?: number; b?: number; c?: number; d?: number; e?: number; f?: number; g?: number }
////= Message
type Wide = { a: number; b: number; c: number; d: number; e: number; f: number; g: number; h?: Message }
const line = '{"id":1,"at":0.5,"size":2.5,"weight":3.5,"body":"hello"}'
const withMeta = '{"id":2,"at":0.5,"size":2.5,"weight":3.5,"body":"hi","meta":{"source":"wire","hops":2},"tags":["x","y"]}'
////= handle
const made: Message = { id: 9, at: 1.5, size: 2.5, weight: 3.5, body: "z", retries: 3.5, delay: 0.5, sentAt: 4.5, score: 0.25, tags: [], meta: { source: "own", hops: 0.5, a: 1.5, b: 2.5, c: 3.5, d: 4.5, e: 5.5, f: 6.5, g: 7.5 } }
////= row
row("made by the program", () => handle(made))
row("an annotated constant", () => { const held: unknown = JSON.parse(withMeta); const m: Message = held as any; return handle(m) })
