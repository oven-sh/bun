function say(label: string, parse: (text: string) => unknown, text: string): void {
  let said = "";
  try {
    said = JSON.stringify(parse(text)) === JSON.stringify(globalThis.JSON.parse(text)) ? "what JSON.parse gives" : "DIFFERENT";
  } catch (error: any) {
    said = error.name;
  }
  console.log(label + ": " + said);
}
