  [text => JSON.parse(text) as Nested, ['{"m":[[1,2],[],[3]],"t":[1,"s",true],"o":{"p":{"q":1}}}']],
  [text => JSON.parse(text) as Dictionary, ['{"a":1,"10":2,"' + "q".repeat(90) + '":3}']],
  [text => JSON.parse(text) as Text, ['{"s":"' + "a".repeat(100) + '"}', '{"s":"' + "a".repeat(30) + "\\n" + "b".repeat(40) + "\\u00e9" + '"}']],
