//// tainted-types.ts
// Every declared object type can hold objects that untyped code created: they arrive by a cast, an annotation, an argument, a result, a name, an await, a clone and inside a union, beside objects of other types that the program makes itself.
interface Inner { deep: number }
interface Element { id: number }
interface ByCast { inner: Inner; list: Element[]; name: string }
interface ByAnnotation { a: number }
interface ByArgument { b: number }
interface ByReturn { c: number }
interface ByName { d: number }
interface ByAwait { e: number }
interface ByClone { f: number }
interface InUnion { g: number }
interface OwnInner { deep: number }
interface Own { inner: OwnInner; name: string }
interface Sibling { inner: OwnInner; list: number[]; name: string }
interface NotADoor { h: number }
interface Shadowed { i: number }
class Made { constructor(public m: number) {} twice() { return this.m * 2 } }
const text = (value: unknown) => JSON.stringify(value)
const byCast = JSON.parse(text({ inner: { deep: 1 }, list: [{ id: 2 }], name: "n" })) as ByCast
const byAnnotation: ByAnnotation = JSON.parse(text({ a: 3 }))
const takesGiven = (x: ByArgument) => x.b + 1
function byReturn(): ByReturn { return JSON.parse(text({ c: 5 })) }
const raw = JSON.parse(text({ d: 6, nested: { g: 9 } }))
const byName = raw as ByName
const inUnion = raw.nested as InUnion | undefined
const response = { json: () => Promise.resolve({ e: 7 }) } as unknown as Response
const byAwait = (await response.json()) as ByAwait
const byClone = structuredClone({ f: 8 } as unknown) as ByClone
const own: Own = { inner: { deep: 10 }, name: "own" }
const sibling: Sibling = { inner: { deep: 11 }, list: [1], name: "sibling" }
const takesOwn = (x: Own) => x.inner.deep + x.name.length
const parser = { parse: (s: string): any => ({ h: s.length }) }
const notADoor = parser.parse("abc") as NotADoor
function shadowed(): Shadowed { const JSON = { parse: (s: string): any => ({ i: s.length }) }; return JSON.parse("abcd") as Shadowed }
const made = new Made(12)
console.log(byCast.inner.deep, byCast.list[0].id, byCast.name, byAnnotation.a, takesGiven(JSON.parse(text({ b: 4 }))), byReturn().c, byName.d, inUnion?.g, byAwait.e, byClone.f)
console.log(takesOwn(own), sibling.inner.deep + sibling.list.length, notADoor.h, shadowed().i, made.twice())
console.log(text(byCast), text(own), Object.keys(byCast).join(), Object.keys(own).join())
export {}
//// token-from-factory.ts
// An object that a constructor function creates as `Node`, with `kind` equal to `Kind.Dot`, is used as a `Token<Kind.Dot>`: any object passes an object type, under a cast and under an annotation.
const enum Kind { Unknown, Dot, Comma }
interface Node { readonly kind: Kind; readonly pos: number }
interface Token<K extends Kind> extends Node { readonly kind: K }
type DotToken = Token<Kind.Dot>
type Mutable<T extends object> = { -readonly [P in keyof T]: T[P] }
function TokenObject(this: Mutable<Node>, kind: Kind, pos: number) { this.kind = kind; this.pos = pos }
const TokenConstructor: new (kind: Kind, pos: number) => Node = TokenObject as any
interface Factory { createToken<K extends Kind>(kind: K): Token<K> }
function createBaseToken<T extends Node>(kind: T["kind"]) { return new TokenConstructor(kind, -1) as Mutable<T> }
function createToken<K extends Kind>(kind: K) { return createBaseToken<Token<K>>(kind) }
const factory: Factory = { createToken }
function attempt(label: string, f: () => DotToken) { try { const token = f(); console.log(label + ":", token.kind, token.pos) } catch (e) { console.log(label + ":", (e as Error).constructor.name) } }
attempt("through the interface, as", () => factory.createToken(Kind.Dot) as DotToken)
attempt("through the interface, annotated", () => { const token: DotToken = factory.createToken(Kind.Dot); return token })
export {};
//// type-only-literals-arrive-externally.ts
// String literal types that no expression of the program spells: values that hold them come from parsed data and from untyped code, and are told apart as the types say.
const shift = Date.now() < 1 ? 1 : 0;
function spell(codes: number[]): string {
  return codes.map(code => String.fromCharCode(code + shift)).join("");
}
function codesOf(reversed: string): number[] {
  const codes: number[] = [];
  for (let i = reversed.length - 1; i >= 0; i--) codes.push(reversed.charCodeAt(i));
  return codes;
}
const square = spell(codesOf("erauqs-delaes"));
const triangle = spell(codesOf("elgnairt-delaes"));
const quiet = spell(codesOf("edom-teiuq"));
const accented = spell(codesOf("éfac-delaes"));
const wide = spell(codesOf("→-delaes"));

type Shape = { kind: "circle"; size: number } | { kind: "sealed-square"; size: number; side: number } | { kind: "sealed-triangle"; size: number; side: number; height: number };
type Mode = "loud" | "quiet-mode" | "sealed-café" | "sealed-→";
interface Options {
  mode: Mode;
  limit: number;
}
interface Tagged {
  tag: "sealed-tag";
  count: number;
}
type Letter = { to: "loud"; body: string } | { to: "quiet-mode"; body: string; copies?: number };

function describe(shape: Shape): string {
  if (shape.kind === "circle") return "circle " + shape.size;
  return shape.kind + " " + shape.size + " " + shape.side + " " + ("height" in shape ? shape.height : "flat");
}
function show(options: Options): string {
  return options.mode + ":" + options.mode.length + ":" + options.limit + ":" + (options.mode === "loud");
}
function parsed<T>(text: string): T {
  return JSON.parse(text) as T;
}

const circle: Shape = { kind: "circle", size: 1 };
console.log(describe(circle));
console.log(describe(JSON.parse('{"kind":"circle","size":2}') as Shape));
console.log(describe(JSON.parse('{"kind":"' + square + '","size":3,"side":4}') as Shape));
console.log(describe(JSON.parse('{"kind":"' + triangle + '","size":5,"side":6,"height":7}') as Shape));
console.log(describe(JSON.parse('{"size":8,"side":9,"kind":"' + square + '"}') as Shape));
console.log(describe(parsed<Shape>('{"kind":"' + triangle + '","size":10,"side":11,"height":12}')));

const shapes = JSON.parse('[{"kind":"' + square + '","size":1,"side":2},{"kind":"circle","size":3},{"kind":"' + triangle + '","size":4,"side":5,"height":6}]') as Shape[];
for (const shape of shapes) console.log(describe(shape), Object.keys(shape).join());

const own: Options = { mode: "loud", limit: 1 };
console.log(show(own));
for (const mode of [quiet, accented, wide, "loud"]) {
  console.log(show(JSON.parse(JSON.stringify({ mode, limit: mode.length })) as Options));
  (own as any).mode = mode;
  console.log(show(own), JSON.stringify(own));
}

const rope = quiet.slice(0, 3) + quiet.slice(3);
const inSixteenBits = (wide + quiet).slice(wide.length);
const part = ("<" + quiet + ">").slice(1, -1);
for (const mode of [rope, inSixteenBits, part]) {
  const options = JSON.parse("{}") as Options;
  (options as any).mode = mode;
  (options as any).limit = 2;
  console.log(show(options), mode === quiet);
}

function count(tagged: Tagged): string {
  return tagged.tag + " " + tagged.count;
}
const tag = spell(codesOf("gat-delaes"));
const tagged = JSON.parse('{"tag":"' + tag + '","count":1}') as Tagged;
console.log(count(tagged));
(tagged as any).tag = tag.slice(0, 4) + tag.slice(4);
console.log(count(tagged));
(tagged as any).count = 2;
console.log(count(tagged), JSON.stringify(tagged));

function read(letter: Letter): string {
  if (letter.to === "loud") return "LOUD " + letter.body;
  return letter.to + " " + letter.body + " " + (letter.copies ?? "none");
}
function post(to: string, body: string, copies?: number): Letter {
  const letter: any = { to, body };
  if (copies !== undefined) letter.copies = copies;
  return letter;
}
console.log(read({ to: "loud", body: "a" }));
console.log(read(post("loud", "b")));
console.log(read(post(quiet, "c")));
console.log(read(post(quiet, "d", 2)));
console.log(read(post(rope, "e", 3)));

const sameLength = spell(codesOf("edom-tsiuq"));
const unlisted = JSON.parse('{"mode":"' + sameLength + '","limit":3}') as Options;
console.log(unlisted.mode, unlisted.limit, unlisted.mode.length === quiet.length);
//// typed-host-objects-used-as-interfaces.ts
// A host object that satisfies one of the program's interfaces is accepted wherever the interface is used: an annotation, a parameter, a field, an element, a return value, `as`. Each interface also has a program class with one extra member, so no host object matches that class.
import { statSync } from "node:fs";

interface HeadersLike { get(name: string): string | null; has(name: string): boolean }
class FakeHeaders implements HeadersLike { fakeOnly = 0; get(name: string): string | null { return "fake-" + name; } has(name: string) { return false; } }
interface SocketLike { send(data: string): void; close(): void; readyState: number; onmessage: ((e: any) => void) | null }
class FakeSocket implements SocketLike { fakeOnly = 0; readyState = 9; onmessage: ((e: any) => void) | null = null; send(data: string) {} close() {} }
interface RequestLike { method: string; url: string; headers: HeadersLike }
class FakeRequest implements RequestLike { fakeOnly = 0; method = "FAKE"; url = "fake:"; headers: HeadersLike = new FakeHeaders(); }
interface ResponseLike { status: number; ok: boolean; headers: HeadersLike }
class FakeResponse implements ResponseLike { fakeOnly = 0; status = 1; ok = false; headers: HeadersLike = new FakeHeaders(); }
interface ParamsLike { get(name: string): string | null }
class FakeParams implements ParamsLike { fakeOnly = 0; get(name: string): string | null { return "fake-" + name; } }
interface UrlLike { href: string; searchParams: ParamsLike }
class FakeUrl implements UrlLike { fakeOnly = 0; href = "fake:"; searchParams: ParamsLike = new FakeParams(); }
interface BlobLike { size: number; type: string; slice(start?: number, end?: number): BlobLike }
class FakeBlob implements BlobLike { fakeOnly = 0; size = -1; type = "fake"; slice(): BlobLike { return this; } }
interface FileLike { name: string; size: number; lastModified: number }
class FakeFile implements FileLike { fakeOnly = 0; name = "fake"; size = -1; lastModified = 0; }
interface FormLike { get(name: string): unknown; has(name: string): boolean; append(name: string, value: string): void }
class FakeForm implements FormLike { fakeOnly = 0; get(name: string): unknown { return "fake"; } has(name: string) { return false; } append(name: string, value: string) {} }
interface ReadableLike { locked: boolean; cancel(reason?: unknown): Promise<void> }
class FakeReadable implements ReadableLike { fakeOnly = 0; locked = true; async cancel() {} }
interface WritableLike { locked: boolean; abort(reason?: unknown): Promise<void> }
class FakeWritable implements WritableLike { fakeOnly = 0; locked = true; async abort() {} }
interface TransformLike { readable: ReadableLike; writable: WritableLike }
class FakeTransform implements TransformLike { fakeOnly = 0; readable: ReadableLike = new FakeReadable(); writable: WritableLike = new FakeWritable(); }
interface SignalLike { aborted: boolean; reason: unknown }
class FakeSignal implements SignalLike { fakeOnly = 0; aborted = false; reason: unknown = "fake"; }
interface ControllerLike { signal: SignalLike; abort(reason?: unknown): void }
class FakeController implements ControllerLike { fakeOnly = 0; signal: SignalLike = new FakeSignal(); abort() { this.signal.aborted = true; } }
interface EncoderLike { encoding: string; encode(text?: string): BytesLike }
interface BytesLike { length: number; byteLength: number }
class FakeBytes implements BytesLike { fakeOnly = 0; length = -1; byteLength = -2; }
class FakeEncoder implements EncoderLike { fakeOnly = 0; encoding = "fake"; encode(): BytesLike { return new FakeBytes(); } }
interface DecoderLike { encoding: string; fatal: boolean; decode(): string }
class FakeDecoder implements DecoderLike { fakeOnly = 0; encoding = "fake"; fatal = true; decode() { return "fake"; } }
interface TargetLike { dispatchEvent(event: Event): boolean }
class FakeTarget implements TargetLike { fakeOnly = 0; dispatchEvent() { return false; } }
interface MessageLike { type: string; data: unknown; target: TargetLike | null }
class FakeMessage implements MessageLike { fakeOnly = 0; type = "fake"; data: unknown = 0; target: TargetLike | null = new FakeTarget(); }
interface TimerLike { ref(): TimerLike; unref(): TimerLike; hasRef(): boolean }
class FakeTimer implements TimerLike { fakeOnly = 0; ref(): TimerLike { return this; } unref(): TimerLike { return this; } hasRef() { return false; } }
interface StatsLike { size: number; mtime: DateLike; isDirectory(): boolean }
interface DateLike { getTime(): number }
class FakeDate implements DateLike { fakeOnly = 0; getTime() { return -1; } }
class FakeStats implements StatsLike { fakeOnly = 0; size = -1; mtime: DateLike = new FakeDate(); isDirectory() { return false; } }

