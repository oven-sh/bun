//// string-object-cast-returned-by-async.ts
// A String object cast to `string & Removable` is accepted wherever a string is, including after an async function returns it.
class Removable extends String {
  [Symbol.dispose]() {
    console.log("removed " + this);
  }
}
function folder(base: string): string & Removable {
  return new Removable(base) as string & Removable;
}
function cacheOf(dir: string) {
  return { cache: dir + "/cache" };
}
function lockOf(dir: string) {
  return dir + "/bun.lock";
}
function look(dir: string) {
  return dir.length + ":" + dir.toUpperCase() + ":" + `${dir}` + ":" + dir.startsWith("/tmp");
}
async function setup(name: string) {
  const dir = folder("/tmp/" + name);
  console.log(cacheOf(dir).cache);
  await null;
  return dir;
}
const setupToo = async (name: string) => folder("/tmp/" + name);

async function main() {
  using dir = await setup("a");
  console.log(lockOf(dir), look(dir), cacheOf(dir).cache);
  console.log(JSON.stringify(String(dir)), [String(dir), "x"].join("/"));
  const second = await setup("b");
  console.log(lockOf(second), look(second));
  const promise = setupToo("c");
  using third = await promise;
  console.log(lockOf(third), look(third), lockOf(await setupToo("d")));
}
await main();
//// stub-function-cast-to-typed-function/api.ts
export type Reply = { headers: Record<string, string>; url: string; code: number };
export type Ok<T> = { ok: true; data: T; status: number; reply: Reply };
export type Failed = { ok: false; reason: string; detail: string };
export type Result<T> = Ok<T> | Failed;
export type Routed<T> = Result<T> & { route: string; fromFar: boolean };

////= api

async function direct<T>(path: string): Promise<Result<T>> {
  return api.post<T>(path, null);
}
export const send = async <T>(path: string): Promise<Routed<T>> => ({ ...(await direct<T>(path)), route: "direct", fromFar: true });
export const sendUnrouted = async <T>(path: string): Promise<Result<T>> => {
  const result = await direct<T>(path);
  return result;
};
export function describeLookup(id: number): string {
  const reply = api.lookup(id);
  return reply.url + " " + reply.code;
}
//// stub-function-cast-to-typed-function/main.ts
// A test replaces a typed function with a stand-in that returns canned values typed `unknown`, and casts the stand-in to the function's type. The canned objects then reach places typed by the function's declared result. Each of them satisfies that type, so the program must behave as it does in plain JavaScript.
import * as mod from "./api";

type Item = { id: number };
type Call = { args: unknown[] };
function mockPost(result: unknown | ((call: Call) => unknown)) {
  mod.api.post = (async (...args: unknown[]) => {
    const call: Call = { args };
    return typeof result === "function" ? result(call) : result;
  }) as typeof mod.api.post;
}
function show(label: string, result: mod.Result<Item>) {
  console.log(label + ":", result.ok, result.ok ? result.status + " " + result.data.id : result.reason, Object.keys(result).join());
}

show("not replaced", await mod.send<Item>("/real"));

mockPost({ ok: true, status: 200, data: { id: 1 }, reply: { headers: {}, url: "u", code: 1 } });
const complete = await mod.send<Item>("/a");
show("complete", complete);
console.log(complete.route, complete.fromFar, complete.ok && complete.reply.url);
show("complete, unrouted", await mod.sendUnrouted<Item>("/a"));

mockPost({ ok: false, reason: "refused", detail: "by the stand-in" });
show("the other member of the union", await mod.send<Item>("/b"));

mockPost({ ok: true, data: { id: 2 }, status: 201, reply: { headers: { a: "b" }, url: "v", code: 2 }, extra: "kept" });
show("one member more", await mod.send<Item>("/c"));

mockPost((call: Call) => ({ ok: true, status: 202, data: { id: call.args.length }, reply: { headers: {}, url: String(call.args[0]), code: 3 } }));
const computed = await mod.sendUnrouted<Item>("/d");
show("computed by a function", computed);
console.log(computed.ok && computed.reply.url);

mod.api.lookup = ((id: unknown) => ({ headers: {}, url: "canned " + id, code: 7 }) as unknown) as typeof mod.api.lookup;
console.log(mod.describeLookup(9));
//// stub-function-cast-via-any-or-unknown/api.ts
export type Reply = { headers: Record<string, string>; url: string; code: number };
export type Ok<T> = { ok: true; data: T; status: number; reply: Reply };
export type Failed = { ok: false; reason: string; detail: string };
export type Result<T> = Ok<T> | Failed;
export type Routed<T> = Result<T> & { route: string; fromFar: boolean };

////= api

async function direct<T>(path: string): Promise<Result<T>> {
  return api.post<T>(path, null);
}
export const send = async <T>(path: string): Promise<Routed<T>> => ({ ...(await direct<T>(path)), route: "direct", fromFar: true });
export const sendUnrouted = async <T>(path: string): Promise<Result<T>> => {
  const result = await direct<T>(path);
  return result;
};
export function describeLookup(id: number): string {
  const reply = api.lookup(id);
  return reply.url + " " + reply.code;
}
//// stub-function-cast-via-any-or-unknown/main.ts
// A typed function is replaced by a stand-in that is cast to `any`, or through `unknown`, on its way to the typed place. The canned objects satisfy the declared result type, so the program must behave as it does in plain JavaScript.
import * as mod from "./api";

type Item = { id: number };
function show(label: string, result: mod.Result<Item>) {
  console.log(label + ":", result.ok, result.ok ? result.status + " " + result.data.id + " " + result.reply.url : result.reason, Object.keys(result).join());
}
function canned(id: number): unknown {
  return { ok: true, status: 200 + id, data: { id }, reply: { headers: {}, url: "u" + id, code: id } };
}

function castToAny(result: unknown) {
  mod.api.post = (async () => result) as any;
}
castToAny(canned(1));
show("cast to any", await mod.sendUnrouted<Item>("/a"));
show("cast to any, routed", await mod.send<Item>("/a"));

function castThroughUnknown(result: unknown) {
  mod.api.post = (async () => result) as unknown as typeof mod.api.post;
}
castThroughUnknown(canned(2));
show("cast through unknown", await mod.send<Item>("/b"));
castThroughUnknown({ ok: false, reason: "refused", detail: "by the stand-in" });
show("the other member of the union", await mod.send<Item>("/c"));

const loose: any = async () => canned(3);
mod.api.post = loose as typeof mod.api.post;
show("a value typed any", await mod.sendUnrouted<Item>("/d"));

mod.api.lookup = ((id: number) => ({ headers: {}, url: "canned " + id, code: 7 })) as any;
console.log(mod.describeLookup(9));
