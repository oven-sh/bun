////= Row
////= Line
////= lines-10	RowHolder	Row
////= lines-10	LineHolder	Line
export function widen(holder: RowHolder): LineHolder {
  return holder as LineHolder;
}
//// sql-plain-rows-in-callbacks.ts
// The SQLite adapter of Bun.sql creates plain objects. A callback called with rows of sql<Row[]> converts a plain row that matches Row in place at its entry and runs its typed body; a row that does not match runs the untyped clone.
import { SQL } from "bun";

interface Row {
  id: number;
  parentId: number | null;
  body: string;
  login: string;
}
interface Author {
  login: string;
}
interface Comment {
  id: number;
  parentId: number | null;
  author: Author;
  body: string;
}
interface CommentNode extends Comment {
  replies: CommentNode[];
}

const db = new SQL("sqlite://:memory:");
await db`CREATE TABLE comments (id INTEGER PRIMARY KEY, parentId INTEGER, body, login TEXT)`;
await db`INSERT INTO comments VALUES (1, NULL, 'first', 'ann'), (2, 1, '', 'bob'), (3, 1, 'naïve — 日本語', 'ann')`;
await db`CREATE TABLE mismatches (id INTEGER PRIMARY KEY, parentId INTEGER, body, login TEXT)`;
await db`INSERT INTO mismatches VALUES (1, NULL, 'matches', 'ann'), (2, 1, 7, 'bob'), (3, 1, 'no login', NULL)`;

async function commentsOf(): Promise<Comment[]> {
  const rows = await db<Row[]>`SELECT id, parentId, body, login FROM comments ORDER BY id`;
  return rows.map(row => ({ id: row.id, parentId: row.parentId, author: { login: row.login }, body: row.body }));
}

function describe(comments: Comment[]): string {
  let text = "";
  for (const comment of comments) {
    const node: CommentNode = { ...comment, replies: [] };
    text += `${node.id}:${node.parentId}:${node.author.login}:${node.body.length}:${node.replies.length} `;
  }
  return text;
}
console.log(describe(await commentsOf()));

async function inspectMismatches(): Promise<void> {
  const rows = await db<Row[]>`SELECT id, parentId, body, login FROM mismatches ORDER BY id`;
  console.log(rows.map(row => `${row.id}${typeof row.body}${typeof row.login}`).join(), JSON.stringify(rows), Object.keys(rows[0]!).join());
}
await inspectMismatches();

await db.close();
Bun.gc(true);
//// stored-fields.ts
// Parsed JSON is stored into the fields of an object that the program creates. What fits is stored as it is. A number under `id: string` and a string under `flag: boolean` throw a TypeError where typed code takes them, and what was stored until then stays.
type Def = { id: string; held?: () => boolean }
type Plan = { slot: Def | null; overflow: number }
type State = { winner: Def | null; rule: { flag: boolean } | null; released: boolean; label: string | null }
const state: State = { winner: null, rule: null, released: false, label: null }
function getState(): State { return state }
function planOf(items: Def[], rule: { flag: boolean }): Plan {
  let slot: Def | null = null
  let overflow = 0
  for (const item of items) {
    if (slot === null && (rule.flag || item.held === undefined)) slot = item
    else overflow++
  }
  return { slot, overflow }
}
function choose(items: Def[], options: { flag: boolean }): Plan {
  const s = getState()
  const rule = s.rule ?? options
  const plan = planOf(items, rule)
  if (plan.slot !== null) {
    s.winner = plan.slot
    s.rule = { flag: rule.flag }
    s.label = plan.slot.id
  }
  return plan
}
const made: Def[] = [{ id: "made", held: () => true }, { id: "second" }]
const given = JSON.parse('[{"id":"given"},{"id":7,"extra":[1]},{"id":"third"}]') as Def[]
const options = JSON.parse('{"flag":false}') as { flag: boolean }
function show(plan: Plan) {
  const s = getState()
  console.log(JSON.stringify(plan), JSON.stringify(s), s.winner === plan.slot, typeof s.label)
}
show(choose(made, { flag: true }))
show(choose(made, options))
show(choose(given, options))
try { show(choose(given.slice(1), { flag: false })) } catch (e) { console.log("a number for the id:", (e as Error).constructor.name) }
state.rule = null
try { show(choose(given.slice(1), JSON.parse('{"flag":"yes"}'))) } catch (e) { console.log("a string for the flag:", (e as Error).constructor.name) }
show(choose([], options))
