async function* each<R>(texts: string[]): AsyncGenerator<R> { for (const text of texts) yield JSON.parse(text) as R }
async function ask() { const step = await each<{ ok: true; k: Part } | { ok: false; e: string }>(['{"ok": true, "k": {"id": 1}}']).next(); if (step.done) return 'none'; const answer = step.value; return answer.ok ? answer.k : answer.e }
