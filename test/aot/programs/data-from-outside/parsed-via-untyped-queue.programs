//// parsed-via-untyped-stored-afterward.ts
// Parsed data that travels as `any` or `unknown` before a typed function first holds it, some of its optional members absent: queues,
// caches, event buses. The type has more than six members.
interface Meta { source: string; hops: number; a?: number; b?: number; c?: number; d?: number; e?: number; f?: number; g?: number }
////= Message
type Wide = { a: number; b: number; c: number; d: number; e: number; f: number; g: number; h?: Message }
const line = '{"id":1,"at":0.5,"size":2.5,"weight":3.5,"body":"hello"}'
const withMeta = '{"id":2,"at":0.5,"size":2.5,"weight":3.5,"body":"hi","meta":{"source":"wire","hops":2},"tags":["x","y"]}'
////= handle
const made: Message = { id: 9, at: 1.5, size: 2.5, weight: 3.5, body: "z", retries: 3.5, delay: 0.5, sentAt: 4.5, score: 0.25, tags: [], meta: { source: "own", hops: 0.5, a: 1.5, b: 2.5, c: 3.5, d: 4.5, e: 5.5, f: 6.5, g: 7.5 } }
////= row
row("made by the program", () => handle(made))
row("stored to afterwards", () => { const held: any = JSON.parse(line); const m: Message = held; m.retries = 2; m.delay = 0.25; m.meta = { source: "later", hops: 1 }; return handle(m) + JSON.stringify(held) })
//// passed-directly-to-host.ts
// A function of the host is declared in this file with types that this file writes. An argument is tested by the function that receives it, and the host's function tests nothing. A literal written as the argument is created as `Options`, so each member enters a field with a written type: a member of another kind throws a TypeError where the literal is made, and so does `e as T` on a primitive of another kind on the way; an object passes the cast. undefined and null pass.
interface Inner { type: "chrome" | "other"; stderr?: string }
interface Options { fatal?: boolean; dir?: string; count?: number; backend?: Inner; list?: number[]; on?(n: number): number }
declare function hostTakes(options?: Options, more?: string): string;
declare class HostClass { constructor(label: string, options?: Options); said: string; take(options: Options): string }
declare const hostObject: { take(options: Options): string; held: Options | undefined };
const show = (v: unknown) => JSON.stringify(v, (_, x) => (x === undefined ? "undefined" : typeof x === "function" ? "function" : typeof x === "bigint" ? x + "n" : x));
(globalThis as any).hostTakes = function (options: unknown, more: unknown) { return show([options, more]); };
(globalThis as any).HostClass = class { said; constructor(label: unknown, options: unknown) { this.said = show([label, options]); } take(options: unknown) { return show(options); } };
(globalThis as any).hostObject = { take(options: unknown) { return show(options); }, held: undefined };
const row = (name: string, f: () => unknown) => { let r: unknown; try { r = f(); } catch (e) { r = "THROWS " + (e as Error).constructor.name; } console.log(name + ": " + (typeof r === "string" ? r : show(r))); };
const falsy: any[] = [0, "", null, undefined, NaN, 0n];
for (const value of falsy) row("a member of another kind, " + String(value), () => hostTakes({ fatal: value }));
row("a constant of another kind, through any", () => hostTakes({ dir: 123 as any }));
// @ts-expect-error
row("a constant of another kind, behind @ts-expect-error", () => hostTakes({ dir: 123 }));
row("below", () => hostTakes({ backend: { type: "chrome", stderr: 123 as any } }));
row("in an array", () => hostTakes({ list: [1, "2" as any, null as any] }));
row("new", () => new HostClass("l", { count: "3" as any }).said);
row("a method", () => new HostClass("l").take({ count: "3" as any }));
row("a method of an object of the host", () => hostObject.take({ fatal: 1 as any }));
row("the second argument", () => hostTakes({}, 5 as any));
row("the argument itself of another kind", () => [hostTakes(5 as any), hostTakes("s" as any), hostTakes(null as any), hostTakes([] as any)]);
row("an object of another look, through any", () => hostTakes({ other: 1 } as any));
row("one of two", () => hostTakes(falsy.length > 99 ? { fatal: true } : { fatal: "no" as any }));
row("a callback inside", () => hostTakes({ on(n) { return n + 1; }, count: 1 }));
row("as the type says", () => hostTakes({ fatal: true, dir: "d", count: 1, backend: { type: "other" }, list: [1] }, "more"));
row("key order and extra members", () => hostTakes({ count: 1, fatal: false, ...({ extra: 1 } as object) }));
row("stored onto the host", () => { hostObject.held = { count: "7" as any }; return show(hostObject.held); });
row("a cast on the way: a constant", () => [hostTakes({}, 5 as unknown as string), hostTakes("x" as unknown as Options)]);
for (const value of ["2", null, 2.5, { toString() { return "t"; } }]) row("a cast on the way: " + show(value), () => [hostTakes({ count: value as number }), hostTakes({}, value as string), new HostClass(value as string).said]);
const kept: Options = { fatal: true, count: 2 };
function countOf(o: Options) { return o.count; }
row("one that typed code holds too", () => [hostTakes(kept), countOf(kept)]);
//// plain-objects-in-larger-cells-convert-within-bounds.ts
// Plain objects of one shape can lie in cells of different sizes. Each passes a parameter of a record type as it is, whichever size the first one had, and typed and untyped reads of it agree afterwards.
type Link = { n: number; next: Link | null; previous: Link | null };

function typedLink(n: number): Link {
  return { n, next: null, previous: null };
}
function weigh(link: Link): number {
  return link.n + (link.next ? link.next.n : 1) + (link.previous ? link.previous.n : 1);
}
function grow(n: number): any {
  const link: any = { n };
  link.next = null;
  link.previous = null;
  return link;
}

let sum = weigh(typedLink(1));
const links: any[] = [];
for (let i = 0; i < 3000; i++) links.push(grow(i));
for (let i = 0; i < links.length; i++) sum += weigh(links[i]);
for (let i = 0; i < links.length; i++) sum += links[i].n + Object.keys(links[i]).length;
console.log(sum);
//// plain-objects-kept-plain-convert-their-children.ts
// A parsed body is cast to a record type and read by typed code. The cast takes any object and changes nothing: the body and the objects below it stay the same ordinary objects, and untyped code stores whatever it likes into them afterwards. A field of the wrong kind throws where typed code reads it.
type Customer = { id: number; name: string; tags: string[] };
type Item = { sku: string; quantity: number };
type Order = { customer: Customer; items: Item[]; coupon?: string };

let parsed: any;
let parsedCustomer: any;
let sharedCustomer: any = null;
////= Incoming	sharedCustomer !== null) parsed.customer = sharedCustom	parsedCustomer = parsed.custom
function makeOrder(i: number): Order {
  return { customer: { id: i, name: "made", tags: [] }, items: [{ sku: "m", quantity: i }], coupon: "C" };
}
function weigh(order: Order): number {
  let sum = order.customer.id + order.customer.name.length + order.customer.tags.length;
  for (const item of order.items) sum += item.sku.length + item.quantity;
  return sum + (order.coupon === undefined ? 0 : order.coupon.length);
}
////= attempt
async function weighBody(incoming: Incoming): Promise<string> {
  try {
    const order = (await incoming.json()) as Order;
    return String(weigh(order)) + (order === parsed && order.customer === parsedCustomer ? "" : " not the same object");
  } catch (error) {
    return (error as Error).constructor.name;
  }
}
function body(i: number, customer: string, rest: string): Incoming {
  return new Incoming('{"customer":' + customer + ',"items":[{"sku":"a' + i + '","quantity":' + i + '},{"sku":"b","quantity":2}]' + rest + "}");
}
const good = (i: number) => '{"id":' + i + ',"name":"name ' + i + '","tags":["x"]}';

console.log(weigh(makeOrder(1)));
let sum = 0;
const kept: any[] = [];
for (let i = 0; i < 600; i++) {
  sum += Number(await weighBody(body(i, good(i), i % 3 === 0 ? ',"coupon":"TEN"' : "")));
  kept.push(parsed);
}
console.log(sum);
console.log(JSON.stringify(kept[7]), Object.keys(kept[7]).join(), Object.keys(kept[7].customer).join());
console.log(JSON.stringify(kept[9]), Object.keys(kept[9]).join());
console.log(attempt(() => { kept[7].customer.id = "text"; return kept[7].customer.id; }));
console.log(attempt(() => { kept[7].customer.id = 70; return kept[7].customer.id; }));
console.log(attempt(() => { kept[7].coupon = 5; return kept[7].coupon; }));
console.log(attempt(() => { kept[7].more = "more"; return JSON.stringify(kept[7]); }));

for (const [name, customer, rest] of [
  ["a coupon of the wrong kind", good(1), ',"coupon":5'],
  ["a customer of the wrong kind", '{"id":"text","name":"n","tags":[]}', ""],
  ["a customer that lacks a field", '{"id":1,"name":"n"}', ""],
  ["a customer with one more", '{"id":1,"name":"n","tags":[],"more":true}', ""],
  ["no customer", "null", ""],
  ["one more property", good(1), ',"more":[1]'],
]) {
  const outcome = await weighBody(body(1, customer, rest));
  const below = parsedCustomer;
  console.log(name + ":", outcome, JSON.stringify(parsed), attempt(() => { below.id = "text"; return below.id; }));
}

sharedCustomer = JSON.parse(good(9));
console.log(await weighBody(body(1, "null", "")), await weighBody(body(2, "null", "")), attempt(() => { sharedCustomer.id = "text"; return sharedCustomer.id; }));
//// plain-objects-kept-plain-with-several-children.ts
// A parsed body holds several objects, some of them the same object under two names, and is cast to a record type. The cast looks at no field and touches no object: whether they fit or not, untyped code stores whatever it likes into them afterwards. Only a field of the wrong kind that typed code reads throws.
type Customer = { id: number; name: string; tags: string[] };
type Owner = { id: number; name: string; tags: string[]; level?: number };
type Deal = { buyer: Customer; seller: Customer; owner: Owner; note?: string };

let parsed: any;
let alias = "";
////= Incoming	alias === "seller is buyer") parsed.seller = parsed.buy	if (alias === "owner is buyer") parsed.owner = parsed.buy
function makeDeal(i: number): Deal {
  return { buyer: { id: i, name: "b", tags: [] }, seller: { id: i, name: "s", tags: [] }, owner: { id: i, name: "o", tags: [], level: 1 } };
}
function weigh(deal: Deal): number {
  return deal.buyer.id + deal.seller.name.length + deal.owner.tags.length + (deal.owner.level ?? 0) + (deal.note === undefined ? 0 : deal.note.length);
}
function noteLength(deal: Deal): number {
  return deal.note === undefined ? 0 : deal.note.length;
}
////= attempt
async function cast(incoming: Incoming): Promise<string> {
  try {
    const deal = (await incoming.json()) as Deal;
    return noteLength(deal) + (deal === parsed ? " cast" : " another object");
  } catch (error) {
    return (error as Error).constructor.name;
  }
}
async function weighBody(incoming: Incoming): Promise<string> {
  try {
    return String(weigh((await incoming.json()) as Deal));
  } catch (error) {
    return (error as Error).constructor.name;
  }
}
const person = (i: number, more = "") => '{"id":' + i + ',"name":"n' + i + '","tags":["x"]' + more + "}";
const body = (buyer: string, seller: string, owner: string, rest = "") => new Incoming('{"buyer":' + buyer + ',"seller":' + seller + ',"owner":' + owner + rest + "}");
const takesText = (below: any) => attempt(() => { below.id = "text"; return below.id; });

console.log(weigh(makeDeal(1)));
let sum = 0;
for (let i = 0; i < 500; i++) sum += Number(await weighBody(body(person(i), person(i + 1), person(i + 2, i % 2 ? ',"level":3' : ""), i % 3 ? "" : ',"note":"n"')));
console.log(sum, JSON.stringify(parsed), Object.keys(parsed.owner).join());

for (const [name, buyer, seller, owner, rest] of [
  ["all fit", person(1), person(2), person(3), ""],
  ["the last does not fit", person(1), person(2), '{"id":"x","name":"n","tags":[]}', ""],
  ["the middle one does not fit", person(1), '{"id":1,"name":2,"tags":[]}', person(3), ""],
  ["the first does not fit", '{"id":1}', person(2), person(3), ""],
  ["the note does not fit", person(1), person(2), person(3), ',"note":7'],
]) {
  const outcome = await cast(body(buyer, seller, owner, rest));
  console.log(name + ":", outcome, takesText(parsed.buyer), takesText(parsed.seller), takesText(parsed.owner));
}
for (const which of ["seller is buyer", "owner is buyer"]) {
  alias = which;
  for (let i = 0; i < 3; i++) {
    const outcome = await weighBody(body(person(4), person(5), person(6)));
    console.log(which + ":", outcome, parsed.seller === parsed.buyer, parsed.owner === parsed.buyer, takesText(parsed.buyer), takesText(parsed.seller), takesText(parsed.owner));
  }
}
//// plain-objects-used-as-records-keep-what-they-hold.ts
// Plain objects whose properties hold newly allocated strings, arrays, functions and typed objects are used as record types, as they are, while other allocations go on. Everything they hold is still there afterwards.
type Leaf = { n: number; up: Leaf | null };
type Branch = { id: number; label: string; leaf: Leaf; list: number[]; act: () => number; note: unknown };

function typedLeaf(n: number, up: Leaf | null): Leaf {
  return { n, up };
}
function typedBranch(): Branch {
  return { id: 0, label: "typed", leaf: typedLeaf(0, null), list: [0], act: () => 0, note: null };
}
function check(branch: Branch, i: number): number {
  if (branch.id !== i || branch.label !== "label " + i || branch.leaf.n !== i || branch.leaf.up!.n !== i + 1 || branch.list.length !== 3 || branch.list[2] !== i || branch.act() !== i * 2) return 0;
  const note = branch.note as { text: string };
  return note.text === "note " + i ? 1 : 0;
}
function grow(i: number): any {
  const branch: any = { id: i };
  branch.label = "label " + i;
  branch.leaf = typedLeaf(i, typedLeaf(i + 1, null));
  branch.list = [1, 2, i];
  branch.act = () => i * 2;
  branch.note = { text: "note " + i };
  return branch;
}

let good = check({ ...typedBranch(), id: 5, label: "label 5", leaf: typedLeaf(5, typedLeaf(6, null)), list: [1, 2, 5], act: () => 10, note: { text: "note 5" } }, 5);
const kept: any[] = [];
for (let i = 0; i < 2000; i++) {
  const shared = grow(i);
  kept.push(shared);
  good += check(shared, i);
  const fresh: any = { id: i, label: "label " + i, leaf: typedLeaf(i, typedLeaf(i + 1, null)), list: [1, 2, i], act: () => i * 2, note: { text: "note " + i } };
  good += check(fresh, i);
}
for (let i = 0; i < kept.length; i++) {
  good += check(kept[i], i);
  if (kept[i].label !== "label " + i || kept[i].list[2] !== i || kept[i].note.text !== "note " + i || Object.keys(kept[i]).join() !== "id,label,leaf,list,act,note") good = -1000000;
}
console.log(good);
//// primitive-annotated-host-callback-parameter.ts
// A parameter of a function handed straight to the host, or to untyped code, that is annotated with a primitive type or a built-in type: `req.on("data", (chunk: string) => { body += chunk })`, where a Buffer arrives. The parameter is tested on entry, whoever calls: a value of another kind throws a TypeError, undefined and null pass, and any object passes `Error`.
declare const hostEmitter: { on(name: string, listener: (...args: any[]) => void): void; once: (name: string, listener: (value: any, more?: any) => void) => void };
const given: Record<string, unknown> = { bytes: { toString() { return "bytes"; }, length: 5 }, seven: 7, text: "text", yes: true, nothing: null, none: undefined };
(globalThis as any).hostEmitter = { on(name: string, f: Function) { f(given[name]); }, once(name: string, f: Function) { f(given[name], given[name]); } };
const untyped: any = (globalThis as any).hostEmitter;
const row = (name: string, f: () => unknown) => { let r: unknown; try { r = f(); } catch (e) { r = "THROWS " + (e as Error).constructor.name; } console.log(name + ": " + JSON.stringify(r)); };
const kind = (v: unknown) => typeof v + " " + String(v);
for (const name of ["bytes", "seven", "text", "yes", "nothing", "none"]) {
  row("the host, string, " + name, () => { let body = ""; hostEmitter.on(name, (chunk: string) => { body += chunk; }); return body; });
  row("untyped code, string, " + name, () => { let body = ""; untyped.on(name, (chunk: string) => { body += chunk; }); return body; });
  row("the host, number, " + name, () => { let seen = ""; hostEmitter.on(name, (n: number) => { seen = kind(n); }); return seen; });
  row("untyped code, boolean, " + name, () => { let seen = ""; untyped.on(name, (flag: boolean) => { seen = kind(flag) + (flag ? " yes" : " no"); }); return seen; });
  row("the host, two of them, " + name, () => { let seen = ""; hostEmitter.once(name, (a: string, b?: number) => { seen = kind(a) + " " + kind(b); }); return seen; });
  row("a function expression, " + name, () => { let seen = ""; untyped.on(name, function (chunk: string | undefined) { seen = kind(chunk); }); return seen; });
}
for (const name of ["text", "seven", "nothing", "bytes"]) {
  row("the host, a built-in type, " + name, () => { let seen = ""; hostEmitter.once(name, (code: number, reason: Uint8Array) => { seen = kind(code) + " " + String(reason); }); return seen; });
  row("untyped code, an Error, " + name, () => { let seen = ""; untyped.on(name, (error: Error) => { seen = kind(error) + " " + (error instanceof Error); }); return seen; });
  row("the host, a Date or nothing, " + name, () => { let seen = ""; hostEmitter.on(name, (when?: Date | null) => { seen = kind(when); }); return seen; });
}
row("a built-in type, as it says", () => { const seen: unknown[] = []; given.array = new Uint8Array([1, 2]); given.error = new RangeError("r"); hostEmitter.on("array", (bytes: Uint8Array) => { seen.push(bytes.length, bytes[1]); }); untyped.on("error", (error: Error) => { seen.push(error.message, error.name); }); return seen; });
row("used as the type says", () => { const seen: unknown[] = []; hostEmitter.on("text", (chunk: string) => { seen.push(chunk.length, chunk.toUpperCase(), chunk + "!"); }); hostEmitter.on("seven", (n: number) => { seen.push(n + 1, n.toFixed(1)); }); return seen; });
row("used as the type says though it is not", () => { const seen: unknown[] = []; hostEmitter.on("bytes", (chunk: string) => { seen.push(chunk.length, typeof chunk, chunk + "!"); }); untyped.on("text", (n: number) => { seen.push(String(n), typeof n); }); return seen; });
row("kept", () => { const chunks: unknown[] = []; untyped.on("bytes", (chunk: string) => { chunks.push(chunk); }); return [chunks.length, chunks[0] === given.bytes]; });
row("hot", () => { let total = 0; for (let i = 0; i < 3000; i++) hostEmitter.on("seven", (n: number) => { total += n; }); return total; });
//// primitive-for-dts-object/host.d.ts
export interface Timer { ref(): Timer; unref(): Timer; hasRef(): boolean }
export class Handle { close(): void }
export function startTimer(f: () => void, ms: number): Timer;
export function stopTimer(timer: Timer): void;
export function open(name: string): Handle;
//// primitive-for-dts-object/host.js
export class Handle { close() {} }
export function startTimer(f, ms) { return ms; }
export function stopTimer(timer) {}
export function open(name) { return name === "real" ? new Handle() : name; }
//// primitive-for-dts-object/main.ts
// A declaration file says that a function of a package yields an object. The package, or a mock that stands in for it in a test, yields a primitive. The program only keeps the value and hands it back, which plain JavaScript allows: nothing throws.
import { type Handle, open, startTimer, stopTimer, type Timer } from "./host.js";
class Debounce {
  private timer: ReturnType<typeof startTimer> | null = null;
  start(): void { this.timer = startTimer(() => {}, 0); }
  stop(): boolean { if (this.timer !== null) { stopTimer(this.timer); this.timer = null; return true; } return false; }
}
function later(): ReturnType<typeof startTimer> { return startTimer(() => {}, 5); }
function keep(): { id: Timer | undefined } { const held: { id: Timer | undefined } = { id: undefined }; held.id = startTimer(() => {}, 7); return held; }
function pass(timer: Timer): Timer { return timer; }
function attempt(name: string, f: () => unknown): void { try { console.log(name, String(f())); } catch (e) { console.log(name, (e as Error).name + ": " + (e as Error).message.split("\n")[0].replace(/ \(bun compile[^)]*\)/, "")); } }
attempt("a field:", () => { const d = new Debounce(); d.start(); return d.stop(); });
attempt("a result:", () => later());
attempt("a member:", () => keep().id);
attempt("a parameter:", () => pass(startTimer(() => {}, 9)));
attempt("a variable:", () => { const timer: Timer = startTimer(() => {}, 11); return timer; });
attempt("an element:", () => { const list: Timer[] = [startTimer(() => {}, 13)]; return list[0]; });
attempt("a class of the declaration file, a string:", () => { const handle: Handle = open("text"); return handle; });
attempt("a class of the declaration file, an instance:", () => { const handle: Handle = open("real"); handle.close(); return typeof handle; });
//// program-functions-typed-as-host-functions.ts
// A value typed as a host function (`typeof structuredClone`) can hold any function of the program. A call through it returns whatever that function returns.
function same(value: any) {
  return JSON.parse(JSON.stringify(value));
}
async function later(original: any) {
  await null;
  return JSON.parse(JSON.stringify(original));
}

// TypeScript reduces the three element types to `<T>(value: T) => T`, so it types the third call as an array. It returns a promise.
for (const clone of [structuredClone, same, later]) {
  const input = [1, "two", true];
  const result = clone(input);
  const cloned = await result;
  console.log(clone.name, Object.prototype.toString.call(result), cloned instanceof Array, cloned !== input, cloned.length, cloned.join());
}

function through(clone: typeof structuredClone, input: { a: number }) {
  return clone(input);
}
console.log(JSON.stringify(through(structuredClone, { a: 1 })), JSON.stringify(through(same, { a: 2 })), JSON.stringify(await through(later, { a: 3 })));

let held = structuredClone;
console.log(held("text").length);
held = later;
console.log(Object.prototype.toString.call(held("text")), (await held("text")).length);
//// promise-claim-all-array-variable.ts
// `later<R>(text): Promise<R>` resolves to parsed data, and R is only what the caller claims. The promises are kept in an array variable before Promise.all, and the result is pushed to a typed array. The program must behave as in plain Bun.
type Part = { id?: number; name?: string; more?: unknown }
class Unrelated { k = 1; j = 2; e = 3; ok = 4; value = 5; data = 6; error = 7; held = 8 }
const unrelated = new Unrelated()
function later<R>(text: string): Promise<R> { return Promise.resolve(JSON.parse(text) as R) }
if (unrelated.k + unrelated.j + unrelated.e + unrelated.ok + unrelated.value + unrelated.data + unrelated.error + unrelated.held < 0) console.log('never')
const all_of_them: { k: Part }[] = []
async function ask() { const pending = [later<{ k: Part }>('{"k": {"id": 1}}')]; const answer = (await Promise.all(pending))[0]!; all_of_them.push(answer); return all_of_them[0]!.k }
console.log(JSON.stringify(await ask()))
