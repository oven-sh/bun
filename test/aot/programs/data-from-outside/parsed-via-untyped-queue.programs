//// union-arm-chosen-per-object.ts
// Objects from JSON.parse with the same property names, one of which the types do not declare, enter a union of record types. Which
// arm an object belongs to depends on a tag and, for one tag, on the type of a value: the choice made for one object must not be
// taken for the next without looking.
type In = { r: number };
type At = { p: number; q: In };
type Count = { kind: "x"; v: number; at: At };
type Label = { kind: string; v: string; at: At };
type Other = { kind: "y"; v: number; at: At; w?: number };
type Any3 = Count | Label | Other;
const made: Any3[] = [{ kind: "x", v: 1, at: { p: 1, q: { r: 1 } } }, { kind: "z", v: "s", at: { p: 2, q: { r: 2 } } }, { kind: "y", v: 2, at: { p: 3, q: { r: 3 } }, w: 4 }];
function show(m: Any3): string {
  m.at.q.r += 1;
  return m.kind + ":" + typeof m.v + ":" + m.v + ":" + m.at.q.r;
}
const texts = ['{"kind":"x","v":1,"more":true,"at":{"p":1,"q":{"r":1}}}', '{"kind":"x","v":"one","more":true,"at":{"p":1,"q":{"r":2}}}', '{"kind":"y","v":3,"more":true,"at":{"p":1,"q":{"r":3}}}', '{"kind":"w","v":"four","more":true,"at":{"p":1,"q":{"r":4}}}'];
const out: string[] = made.map(show);
const kept: any[] = [];
for (let turn = 0; turn < 3; turn++) {
  for (const text of texts) {
    const raw: any = JSON.parse(text);
    kept.push(raw);
    out.push(show(raw) + ":" + raw.more + ":" + raw.at.q.r + ":" + Object.keys(raw).join());
  }
}
console.log(out.join("\n"));
console.log(kept.length, kept.every(raw => raw.more === true));
//// union-arms-differ-in-nested-objects.ts
// The arms of these unions have the same property names and differ only in the type of a nested object.
// Each object fits one arm, whichever object came before it.
function tell(name: string, f: () => unknown): void {
  try {
    console.log(name + ": " + f());
  } catch (e) {
    console.log(name + ": " + String(e).split("\n")[0]);
  }
}

setTimeout(
  rows => {
    for (const { spec, outer } of rows) tell("three arms, " + spec, () => JSON.stringify({ name: "x", ...outer }));
  },
  0,
  [
    { spec: "two", outer: { inner: { two: "2" } } },
    { spec: "one", outer: { inner: { one: "1" } } },
    { spec: "other", outer: { other: { one: "w" } } },
    { spec: "two again", outer: { inner: { two: "2" } } },
    { spec: "one again", outer: { inner: { one: "1" } } },
  ],
);

setTimeout(
  rows => {
    for (const { spec, outer } of rows) tell("the other order, " + spec, () => JSON.stringify({ name: "x", ...outer }));
  },
  0,
  [
    { spec: "one", outer: { inner: { one: "1" } } },
    { spec: "two", outer: { inner: { two: "2" } } },
    { spec: "other", outer: { other: { one: "w" } } },
    { spec: "one again", outer: { inner: { one: "1" } } },
    { spec: "two again", outer: { inner: { two: "2" } } },
  ],
);

setTimeout(
  rows => {
    for (const { spec, app, pkg } of rows) {
      tell("package files, " + spec, () => JSON.stringify({ name: "app", ...app }));
      tell("package files, " + spec, () => JSON.stringify({ name: "pkg", ...pkg }));
    }
  },
  0,
  [
    { spec: "a star", app: { dependencies: { pkg: "*" } }, pkg: {} },
    { spec: "a star and a version", app: { dependencies: { pkg: "*" } }, pkg: { version: "1.0.0-alpha" } },
    { spec: "an alias", app: { dependencies: { aliased: "npm:pkg@*" } }, pkg: {} },
    { spec: "a catalog", app: { dependencies: { pkg: "catalog:" } }, pkg: { version: "1.0.0" } },
    { spec: "another alias", app: { dependencies: { aliased: "workspace:pkg@*" } }, pkg: {} },
    { spec: "two kinds", app: { devDependencies: { pkg: "workspace:*" }, peerDependencies: { pkg: "^1.0.0" } }, pkg: { version: "1.0.0" } },
  ],
);

setTimeout(
  rows => {
    for (const { spec, outer } of rows) tell("two levels down, " + spec, () => JSON.stringify({ name: "x", ...outer }));
  },
  0,
  [
    { spec: "two", outer: { middle: { inner: { two: 2 } } } },
    { spec: "one", outer: { middle: { inner: { one: 1 } } } },
    { spec: "other", outer: { other: 1 } },
    { spec: "two again", outer: { middle: { inner: { two: 2 } } } },
  ],
);
//// union-computed-by-indexed-access.ts
// A union of record types that is computed by an indexed access type, one member of which comes from JSON by a cast.
declare const console: { log(...values: unknown[]): void };
type Over = { over: { lines: string[] }; halted?: string; goes?: undefined; cut?: true };
type Goes = { over?: undefined; goes: { text: string; title: string | undefined }; cut?: true };
type Table = { first: Over; second: Goes };
type Verdict = Table[keyof Table];
type Run = { blocked?: string; cut?: true };
function settled(run: Run | undefined, text: string): Verdict | undefined {
  if (text === '') return undefined;
  return !run ? { over: { lines: ['never'] } } : run.blocked ? { over: { lines: [run.blocked] }, halted: run.blocked } : { goes: { text, title: 'title' }, ...(run.cut && { cut: true as const }) };
}
function read(verdict: Verdict | undefined): string {
  if (verdict === undefined) return 'none';
  if (verdict.over !== undefined) return 'over ' + verdict.over.lines.join() + ' ' + verdict.halted;
  const text = verdict.goes.text;
  return text + ' ' + verdict.goes.title + ' ' + verdict.cut;
}
console.log(read(settled({}, 'e')), '|', read(settled({ cut: true }, 'f')), '|', read(settled(undefined, 'g')), '|', read(settled({ blocked: 'b' }, 'h')), '|', read(settled({}, '')));
const parsed = JSON.parse('{"goes":{"text":"p","title":"q"},"more":1}') as Goes;
// It is not handed to `read`: the search would follow it to the parameter and find the whole union there.
console.log(parsed.goes.text, Object.keys(parsed).join());
//// union-in-module-of-types/main.ts
// A generic union that is declared in a types-only module (`import type`), created in a generic async function and read at one instantiation.
import type * as Types from "./types";
declare const console: { log(...values: unknown[]): void };
////= either	Types.Act<In>, chain: Promise<Result>): Promise<Types.
type Entering = { text: string; extra?: readonly string[] };
type Answer = { drop?: string };
async function use(has: boolean): Promise<string> {
  const act: Types.Act<Entering> = { early: has ? Promise.resolve({ text: 'in' }) : new Promise<Entering>(() => {}), isEarly: () => has };
  const first = await either(act, Promise.resolve<Answer>({ drop: 'why' }));
  if (first.early) {
    const early = first.early;
    return 'early ' + early.text;
  }
  const late = first.late;
  return 'late ' + late.drop;
}
use(true).then(a => use(false).then(b => console.log(a, '|', b)));
const alike = JSON.parse('{"early":"s"}') as { early: string }; console.log(alike.early);
//// union-in-module-of-types/types.ts
export type Either<In, Result> = { early: In; late?: undefined } | { late: Result; early?: undefined };
export type Act<In> = { early: Promise<In>; isEarly(): boolean };
//// union-parsed-class-arm-parsed-data.ts
// A union of four records. Parsed data is held to it in one place; in another a record is made for it by a spread.
// One arm holds an object of a class; the other three hold data alone.
class Reply<T> { constructor(public body: T, public code: number) {} text() { return String(this.code) } }
type W = { w: number }
type Result<T> = { ok: true; data: T; status: number; reply: Reply<T>; mark?: null | string } | { ok: false; reason: "a" } | { ok: false; reason: "b" } | { ok: false; reason: "c"; detail: string }
type Routed<T> = Result<T> & { route: "direct" | "far"; fromFar: boolean; a?: number; b?: W; c?: number; d?: "x" | "y"; e?: number }
const bag: unknown[] = []
function travel(x: unknown): any { bag.push(x); return bag.pop() }
function make<T>(x: T): Result<T> { return typeof x === "boolean" ? { ok: true, data: x, status: 201.5, reply: new Reply(x, 2), mark: "m" } : { ok: true, data: x, status: 200.5, reply: new Reply(x, 1) } }
async function direct<T>(x: T): Promise<Result<T>> { return x === null ? { ok: false, reason: "a" } : x === undefined ? { ok: false, reason: "c", detail: "none" } : make<T>(x) }
function client() {
  return {
    get: async <T,>(x: T): Promise<Routed<T>> => {
      const sendDirect = async (): Promise<Routed<T>> => ({ ...(await direct<T>(x)), route: "direct", fromFar: true })
      const sendFar = async (): Promise<Routed<T>> => ({ ...(await direct<T>(x)), route: "far", fromFar: false, a: 1.5, b: { w: 2 }, c: 3.5, d: "x", e: 5.5 })
      return typeof x === "string" ? sendFar() : sendDirect()
    },
  }
}
const api = client()
async function use(x: unknown) {
  let res: Routed<unknown>
  res = await api.get<unknown>(x)
  if (!res.ok) return "not ok " + res.reason
  if (!res.fromFar) return "near " + res.a
  return res.status + " " + res.route + " " + JSON.stringify(res.data) + " " + res.reply.text() + " " + (res.mark ?? "-") + (res.a ?? "-")
}
function replayed(text: string) {
  const boot: Routed<unknown> = travel(JSON.parse(text))
  return boot.ok ? "ok" : boot.reason === "c" ? boot.reason + boot.detail + boot.route : boot.reason + boot.route
}
try { console.log("parsed data: " + replayed('{"ok":false,"reason":"c","detail":"d","route":"far","fromFar":false}')) } catch (e) { console.log("parsed data: " + (e instanceof TypeError ? "TypeError" : "other " + e)) }
//// union-tags-spelled-only-in-types.ts
// Plain objects are used through a discriminated union whose tag "oval" is spelled in the type alone, never in code, so that it is an ordinary string in the object. Each object keeps its OWN tag string: here the first object that typed code has read dies, young, and its string with it, while objects that were old when typed code first read them live on. Then the same with full collections, where every object that typed code has read dies between the rounds and only one that it never read stays alive.
type Inner = { n: number };
type Circle = { kind: "circle"; inner: Inner; radius: number };
type Square = { kind: "square"; inner: Inner; side: number };
type Oval = { kind: "oval"; inner: Inner; wide: number };
type Figure = Circle | Square | Oval;
const shell: any = globalThis;
const collect: (full: boolean) => void = shell.Bun ? (full: boolean) => shell.Bun.gc(full) : (full: boolean) => (full ? shell.fullGC() : shell.edenGC());
function makeInner(n: number): Inner { return { n } }
function makeFigure(i: number, inner: Inner): Figure { return i % 2 ? { kind: "circle", inner, radius: i } : { kind: "square", inner, side: i } }
function area(figure: Figure): number { return figure.inner.n + (figure.kind === "circle" ? figure.radius * 3 : figure.kind === "square" ? figure.side * figure.side : figure.wide) }
function kindOf(figure: Figure): string { return figure.kind }
function grow(kind: unknown, inner: Inner, i: number): any { const figure: any = { kind }; figure.inner = inner; figure.wide = i; return figure }
function fresh(text: string): string { return text.split("").join("") }
function convertOne(inner: Inner): void { F.area(F.grow(F.fresh("oval"), inner, 1)) }
function convertAll(list: any[]): void { for (const o of list) F.area(o) }
function deep(k: number): number { return k <= 0 ? 0 : 1 + F.deep(k - 1) }
function churn(): number { let n = 0; for (let i = 0; i < 5000; i++) n += F.fresh("junk" + i).length; return n }
function kinds(list: any[]): string { const seen = new Map<string, number>(); for (const o of list) { const kind = F.kindOf(o) + ""; seen.set(kind, (seen.get(kind) ?? 0) + 1) } return [...seen].map(([kind, count]) => kind + " " + count).join(", ") }
function round(inner: Inner, count: number): string { const list: any[] = []; for (let i = 0; i < count; i++) list.push(F.grow(F.fresh("oval"), inner, i)); F.convertAll(list); return F.kinds(list) }
const F = { area, kindOf, grow, fresh, convertOne, convertAll, deep, churn, kinds, round };
const inner = makeInner(7);
console.log(area(makeFigure(1, inner)), area(makeFigure(2, inner)));

const old: any[] = [];
for (let i = 0; i < 50; i++) old.push(F.grow(F.fresh("oval"), inner, i));
collect(true); collect(true);
F.convertOne(inner); F.deep(80);
F.convertAll(old); F.deep(80);
collect(false); F.churn(); collect(false); F.churn();
console.log("old objects converted behind a young one:", F.kinds(old));

const unconverted = F.grow("none", inner, 0);
for (let i = 0; i < 6; i++) { console.log("round", i, F.round(inner, 40)); F.deep(80); collect(true); F.churn() }
console.log(Object.keys(unconverted).join());
//// union-with-array-member.ts
// Unions of an object type with an array, a promise or a Map.
declare const console: { log(...values: unknown[]): void };
type Mine = { mine: number };
type Other = { other: string };
type Third = { third: boolean };
type Listed = Mine | Other[];
type Later = Other | Promise<Mine>;
type Keyed = Third | Map<string, Mine>;
function listed(e: Listed): string {
  return Array.isArray(e) ? 'list ' + e.length + ' ' + e[0].other : 'mine ' + e.mine;
}
async function later(e: Later): Promise<string> {
  return e instanceof Promise ? 'later ' + (await e).mine : 'other ' + e.other;
}
function keyed(e: Keyed): string {
  return e instanceof Map ? 'keyed ' + e.get('k')!.mine : 'third ' + e.third;
}
console.log(listed({ mine: 1 }), listed([{ other: 'o' }]), keyed({ third: true }), keyed(new Map([['k', { mine: 2 }]])));
later({ other: 'p' }).then(a => later(Promise.resolve({ mine: 3 })).then(b => console.log(a, b)));
type Row = { x: string };
const parsed = JSON.parse('[{"x":"s"}]') as Row[];
const promised: Promise<Row> = Promise.resolve(parsed[0]);
const mapped: Map<string, Row> = new Map([['r', parsed[0]]]);
promised.then(row => console.log(row.x, mapped.get('r')!.x, parsed.length));
//// unknown-containers-cast-to-typed.ts
// Objects travel in a container whose element type is `unknown`, and the container is cast to a container of a union type. Each object satisfies the union, so reading it back must behave as it does in plain JavaScript.
type Result = { ok: true; status: number; data: string } | { ok: false; status: number; reason: string };
function show(label: string, result: Result) {
  console.log(label + ":", result.ok, result.status, result.ok ? result.data : result.reason);
}

const looseList: unknown[] = [{ ok: true, status: 200, data: "first" }];
looseList.push({ ok: false, status: 500, reason: "second" });
const list = looseList as Result[];
show("array", list[0]);
for (const result of list) show("array, iterated", result);
console.log(list.map(result => result.status).join());

function later(value: unknown): Promise<unknown> {
  return Promise.resolve(value);
}
show("promise", await (later({ ok: true, status: 201, data: "awaited" }) as Promise<Result>));
await (later({ ok: false, status: 501, reason: "then" }) as Promise<Result>).then(result => show("promise, then", result));

const looseMap = new Map<string, unknown>([["a", { ok: true, status: 202, data: "mapped" }]]);
const map = looseMap as Map<string, Result>;
show("map", map.get("a")!);
for (const [key, result] of map) show("map, iterated " + key, result);

const looseSet = new Set<unknown>([{ ok: false, status: 502, reason: "in a set" }]);
for (const result of looseSet as Set<Result>) show("set", result);

const loosePair: [unknown, unknown] = [{ ok: true, status: 203, data: "left" }, { ok: false, status: 503, reason: "right" }];
const [left, right] = loosePair as [Result, Result];
show("tuple", left);
show("tuple", right);

const looseRows: unknown[][] = [[{ ok: true, status: 204, data: "nested" }]];
const rows = looseRows as Result[][];
show("array of arrays", rows[0][0]);
//// untyped-built-object-mismatch-throws.ts
// An object that has every member of its type and was not made in one piece: its members were added one by one, or a built-in made it.
// It travels as `any` before a typed function first holds it. The type has more than six members, all of them required.
interface Reading { id: number; at: number; low: number; high: number; mean: number; count: number; unit: string; place: { name: string } }
const text = '{"id":1,"at":0.5,"low":1.5,"high":2.5,"mean":3.5,"count":4,"unit":"C","place":{"name":"roof"}}'
let seen: unknown = null
function use(r: Reading) { seen = r; return r.id + r.at + r.low + r.high + r.mean + r.count + r.unit + r.place.name }
const made: Reading = { id: 9, at: 1.5, low: 2.5, high: 3.5, mean: 4.5, count: 5.5, unit: "F", place: { name: "own" } }
const kept: unknown[] = []
const keep = (o: any): any => { kept.push(o); return o }
////= row-2
row("made by the program", () => use(made))
row("what does not match is refused", () => { const o: any = {}; const from = JSON.parse(text); for (const k in from) o[k] = from[k]; o.at = "noon"; return use(keep(o)) })
//// untyped-instance-into-generic-closure-parameter.ts
// A closure with its own type parameter is called through the value that another function returns. Its parameter is a type
// literal that mentions the type parameter. The argument is typed by an interface, and the object behind it is an instance of
// a class whose base class is only known at run time, so it has no layout.
interface Pipeable {
  pipe(): string
}
const Base: new () => Pipeable = (function () {
  function PipeableBase() {}
  PipeableBase.prototype = {
    pipe() {
      return 'piped'
    },
  }
  return PipeableBase as any
})()
interface Codec<Decoded, Encoded> extends Pipeable {
  readonly decode: (input: Encoded) => Decoded
  readonly encode: (input: Decoded) => Encoded
}
const Codec: new <Decoded, Encoded>(decode: (input: Encoded) => Decoded, encode: (input: Decoded) => Encoded) => Codec<Decoded, Encoded> = class<Decoded, Encoded> extends Base {
  readonly decode: (input: Encoded) => Decoded
  readonly encode: (input: Decoded) => Encoded
  constructor(decode: (input: Encoded) => Decoded, encode: (input: Decoded) => Encoded) {
    super()
    this.decode = decode
    this.encode = encode
  }
}
function link<Decoded>() {
  return <Encoded,>(sample: Encoded, codec: { readonly decode: (input: Encoded) => Decoded; readonly encode: (input: Decoded) => Encoded }) => codec.encode(codec.decode(sample))
}
const numberFromString: Codec<number, string> = new Codec((text: string) => Number(text) + 1, (value: number) => String(value))
console.log(link<number>()('41', numberFromString))
console.log(link<number>()('four', { decode: text => text.length, encode: value => 'x'.repeat(value) }))
console.log(numberFromString.pipe())
//// untyped-instance-through-generic-interface-into-type-literal.ts
// `Codec<Decoded, Encoded>` is a generic interface, so its instantiations share one layout. The object behind `fromText` is an
// instance of a class whose base class is only known at run time: it has no layout, and it comes out of a function that returns
// `any`. It is then passed, without a cast, where a type literal with two of the interface's members is expected.
interface Codec<Decoded, Encoded> {
  readonly name: string
  readonly decode: (input: Encoded) => Decoded
  readonly encode: (input: Decoded) => Encoded
}
const Base: new () => object = (function () {
  function Plain() {}
  return Plain as any
})()
class TextCodec extends Base {
  readonly name = 'text'
  readonly decode = (input: string) => Number(input) + 1
  readonly encode = (input: number) => String(input)
}
const registry: Record<string, any> = { text: new TextCodec() }
const fromText: Codec<number, string> = registry.text
const made: Codec<boolean, number> = { name: 'made', decode: input => input > 0, encode: input => (input ? 1 : 0) }
function roundTrip<Decoded, Encoded>(sample: Encoded, codec: { readonly decode: (input: Encoded) => Decoded; readonly encode: (input: Decoded) => Encoded }): Encoded {
  return codec.encode(codec.decode(sample))
}
console.log(roundTrip('41', fromText), roundTrip(7, made), roundTrip('x', { decode: text => text.length, encode: size => 'y'.repeat(size) }), fromText.name, made.name)
//// untyped-package-result-into-class-containers/main.ts
// What a package without types makes comes in as `any`. Held to an array, a Map, a Set, a Promise, a tuple or a record OF a class whose members it has, it is read as in plain Bun, by an annotation, as the result of a function, and as what a function of the package yields that stands in for a method. Each row has a class of its own.
import { functionOfAnUntypedPackage, madeByAnUntypedPackage } from "./package.js";
class A1 { field: string = "made"; }
class A2 { field: string = "made"; }
class A3 { field: string = "made"; }
class A4 { field: string = "made"; }
class A5 { field: string = "made"; }
class A6 { field: string = "made"; }
class A7 { field: string = "made"; }
const array: A1[] = madeByAnUntypedPackage("array");
console.log("annotated, an array:", array[0].field, new A1().field);
const map: Map<string, A2> = madeByAnUntypedPackage("map");
console.log("annotated, a Map:", map.get("k")!.field, new A2().field);
const set: Set<A3> = madeByAnUntypedPackage("set");
console.log("annotated, a Set:", [...set][0].field, new A3().field);
const promise: Promise<A4> = madeByAnUntypedPackage("promise");
console.log("annotated, a Promise:", (await promise).field, new A4().field);
const property: { inner: A5 } = madeByAnUntypedPackage("property");
console.log("annotated, a property:", property.inner.field, new A5().field);
const record: Record<string, A6> = madeByAnUntypedPackage("record");
console.log("annotated, a record:", record.k.field, new A6().field);
const tuple: [A7, number] = madeByAnUntypedPackage("tuple");
console.log("annotated, a tuple:", tuple[0].field, new A7().field);

class B1 { field: string = "made"; }
class B2 { field: string = "made"; }
class B3 { field: string = "made"; }
class B4 { field: string = "made"; }
function arrayResult(): B1[] { return madeByAnUntypedPackage("array"); }
function mapResult(): Map<string, B2> { return madeByAnUntypedPackage("map"); }
function propertyResult(): { inner: B3 } { return madeByAnUntypedPackage("property"); }
function recordResult(): Record<string, B4> { return madeByAnUntypedPackage("record"); }
console.log("a result:", arrayResult()[0].field, mapResult().get("k")!.field, propertyResult().inner.field, recordResult().k.field, new B1().field, new B2().field, new B3().field, new B4().field);

class C1 { field: string = "made"; }
class C2 { field: string = "made"; }
class C3 { field: string = "made"; }
class C4 { field: string = "made"; }
class Service {
  array(): C1[] { return [new C1()]; }
  async promise(): Promise<C2> { return new C2(); }
  map(): Map<string, C3> { return new Map([["k", new C3()]]); }
  property(): { inner: C4 } { return { inner: new C4() }; }
}
const real = new Service();
const standIn: Service = { array: functionOfAnUntypedPackage("array"), promise: functionOfAnUntypedPackage("promise"), map: functionOfAnUntypedPackage("map"), property: functionOfAnUntypedPackage("property") };
for (const service of [real, standIn]) console.log("a method:", service.array()[0].field, (await service.promise()).field, service.map().get("k")!.field, service.property().inner.field);
//// untyped-package-result-into-class-containers/package.d.ts
export function madeByAnUntypedPackage(what: string): any;
export function functionOfAnUntypedPackage(what: string): (...args: any[]) => any;
//// untyped-package-result-into-class-containers/package.js
export function madeByAnUntypedPackage(what) {
  switch (what) {
    case "array": return [{ field: "given" }];
    case "map": return new Map([["k", { field: "given" }]]);
    case "set": return new Set([{ field: "given" }]);
    case "promise": return Promise.resolve({ field: "given" });
    case "property": return { inner: { field: "given" } };
    case "record": return { k: { field: "given" } };
    case "tuple": return [{ field: "given" }, 1];
  }
}
export function functionOfAnUntypedPackage(what) {
  return () => madeByAnUntypedPackage(what);
}
//// untyped-store-into-shared-slot.ts
// Two object types declare a field with the same name but different types, and the field is read through their union, so the two fields can share a slot. A value of the other field's type is stored through `any` or through the other object type. A read through the object's own type then throws a TypeError and never reinterprets the value as the declared type. A read through the union or through `any` returns the value.
type A = { v: number };
type B = { v: string };
type C = { w: { n: number } };
type D = { w: number };
function attempt(label: string, f: () => unknown): void { try { console.log(label, String(f())); } catch (e) { console.log(label, (e as Error).name); } }
function makeA(): A { return { v: 1 }; }
function makeB(): B { return { v: "bb" }; }
function makeC(): C { return { w: { n: 1 } }; }
function makeD(): D { return { w: 2 }; }
function readV(u: A | B): number | string { return u.v; }
function typeofW(u: C | D): string { return typeof u.w; }
function addOne(a: A): number { return a.v + 1; }
function lengthOf(b: B): number { return b.v.length; }
function inner(c: C): number { return c.w.n; }
function twice(d: D): number { return d.w * 2; }
function sum(list: A[]): number { let s = 0; for (const a of list) s += a.v; return s; }
function storeV(o: any, value: unknown): void { o.v = value; }
function storeW(o: any, value: unknown): void { o.w = value; }
function storeAsB(b: B, value: string): void { b.v = value; }
attempt("unmodified A:", () => addOne(makeA())); attempt("unmodified B:", () => lengthOf(makeB())); attempt("unmodified C:", () => inner(makeC())); attempt("unmodified D:", () => twice(makeD()));
attempt("the unions:", () => [readV(makeA()), readV(makeB()), typeofW(makeC()), typeofW(makeD())].join());
const a = makeA(), b = makeB(), c = makeC(), d = makeD(), aliased = makeA();
attempt("string in A, through any:", () => { storeV(a, "x"); return (a as any).v; });
attempt("string in A, through the union:", () => readV(a)); attempt("string in A, through A:", () => addOne(a));
attempt("number in B, through the union:", () => { storeV(b, 5); return readV(b); }); attempt("number in B, through B:", () => lengthOf(b));
attempt("stored through B, read through the union:", () => { storeAsB(aliased as unknown as B, "y"); return readV(aliased); }); attempt("stored through B, read through A:", () => addOne(aliased));
attempt("number in C, through the union:", () => { storeW(c, 7); return typeofW(c); }); attempt("number in C, through C:", () => inner(c));
attempt("object in D, through the union:", () => { storeW(d, { n: 1 }); return typeofW(d); }); attempt("object in D, through D:", () => twice(d));
attempt("a number in A again:", () => { storeV(a, 3); return addOne(a); });
attempt("undefined in A:", () => { storeV(a, undefined); return addOne(a); }); attempt("null in A:", () => { storeV(a, null); return addOne(a); });
attempt("another A:", () => addOne(makeA()));
const list: A[] = []; for (let i = 0; i < 1000; i++) list.push({ v: i });
attempt("sum:", () => sum(list));
attempt("sum with a string:", () => { storeV(list[500], "z"); return sum(list); });
export {};
//// upcast-to-member-of-union.ts
// Parsed JSON is cast to one member of a union.
declare const console: { log(...values: unknown[]): void };
type P = { a: number; b?: string; in: { c: number }; list: number[]; f?: () => number };
type G = P & { g?: 1 };
type Q = { q: number }; function pick(u: P | Q): P | Q { return u; }
function give(p: P): P { return p; }
function main(): string {
  if ((JSON.parse(`{"a":0,"in":{"c":0},"list":[]}`) as G).a) return "never";
  const o: G = { a: 2, b: "x", in: { c: 1 }, list: [1], f: () => 1 };
  const p = give(o);
  const same = p === o; o.a = 7; const seen = p.a;
  return [same, seen].join();
}
console.log(main());
