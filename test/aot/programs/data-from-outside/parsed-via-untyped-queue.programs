// A generic function returns Promise<R> and none of its parameters mention R, so only the caller's claim determines R. The result is passed to a parameter whose type has one more optional member. The program must behave as in plain Bun.
type Part = { id?: number; name?: string; more?: unknown }
type Waiting = { resolve: (result: unknown) => void; reject: (error: unknown) => void }
class Unrelated { k = 1; j = 2; e = 3; ok = 4; a = 5; b = 6; c = 7; d = 8 }
const unrelated = new Unrelated()
if (unrelated.k + unrelated.j + unrelated.e + unrelated.ok + unrelated.a + unrelated.b + unrelated.c + unrelated.d < 0) console.log('never')
const waiting = new Map<number, Waiting>()
const seen: unknown[] = []
let next = 0
////= arrive-2
function use(given: { k: Part; j?: number }): Part { return given.k }
async function ask() { const answer = await later<{ k: Part }>('{"k": {"id": 1}}'); return use(answer) }
console.log(JSON.stringify(await ask()))
