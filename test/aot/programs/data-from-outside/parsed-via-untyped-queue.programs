// The property that the program tests against its declared type is an accessor of an object from untyped code. What the getter returns is tested like the value of a field: a string where `string[] | true` is written throws a TypeError at the read, also under `typeof`.
interface Meta { sign: string[] | true; secrets?: string }
const own: Meta = { sign: ["own"] };
const stored: unknown[] = [];
function normalize(app: any): string {
  const meta: Meta = app.cookie;
  if (typeof meta.sign === "string") meta.sign = [meta.sign];
  return JSON.stringify(meta) + " " + JSON.stringify(stored);
}
console.log(normalize({ cookie: own }));
try { console.log(normalize({ cookie: Object.defineProperty({}, "sign", { get() { return "one"; }, set(value) { stored.push(value); }, enumerable: true }) })); } catch (e) { console.log("a getter that returns a string:", (e as Error).constructor.name); }
//// read-narrowed-to-never-after-cast.ts
// The program tests a property for a kind that its declared type rules out. The operand of `typeof` is a typed read like any other: a string where `string[] | true` is written throws a TypeError at the read, so the branch is never entered.
interface Meta { sign: string[] | true; secrets?: string }
const own: Meta = { sign: ["own"] };
function normalize(meta: Meta): string {
  if (typeof meta.sign === "string") meta.sign = [meta.sign];
  return JSON.stringify(meta);
}
const mistyped = { sign: "one" } as unknown as Meta;
try { console.log(normalize(own), normalize(mistyped)); } catch (e) { console.log("a string:", (e as Error).constructor.name); }
//// read-narrowed-to-never-by-typeof.ts
// The program tests a property for a kind that its declared type rules out. The operand of `typeof` is a typed read like any other: a string where `string[] | true` is written throws a TypeError at the read, so the branch is never entered.
interface Meta { sign: string[] | true; secrets?: string }
const own: Meta = { sign: ["own"] };
function normalize(app: any): string {
  const meta: Meta = app.cookie;
  if (typeof meta.sign === "string") meta.sign = [meta.sign];
  return JSON.stringify(meta);
}
console.log(normalize({ cookie: own }));
try { console.log(normalize({ cookie: { sign: "one" } })); } catch (e) { console.log("a string:", (e as Error).constructor.name); }
console.log(normalize({ cookie: { sign: ["a"] } }));
try { console.log(normalize(JSON.parse('{"cookie":{"sign":"two","secrets":"s"}}'))); } catch (e) { console.log("a parsed string:", (e as Error).constructor.name); }
//// read-narrowed-to-never-in-closure.ts
// A closure captures a variable with a written type and tests one of its properties for a kind that the type rules out. The read is a typed read: a string where `string[] | true` is written throws a TypeError.
function compose(app: any): () => string {
  const meta: { secrets?: string | string[]; sign: string[] | true } = app.config.cookie;
  const encode = () => {
    if (meta?.sign) {
      if (typeof meta.sign === "string") meta.sign = [meta.sign];
      return "signed " + JSON.stringify(meta.sign);
    }
    return "plain " + JSON.stringify(meta);
  };
  return () => encode() + " " + encode();
}
try { console.log(compose({ config: { cookie: { sign: "one" } } })()); } catch (e) { console.log("a string:", (e as Error).constructor.name); }
console.log(compose({ config: { cookie: { sign: ["a"] } } })());
console.log(compose({ config: { cookie: { path: "/" } } })());
//// record-with-two-union-members-fields.ts
// A generic async function returns one of two record types, and a record with the fields of both arrives from JSON.
declare const console: { log(...values: unknown[]): void };
type Either<In, Result> = { early: In; late?: undefined } | { late: Result; early?: undefined };
type Act<In> = { early: Promise<In>; isEarly(): boolean };
////= either	Act<In>, chain: Promise<Result>): Promise<
type Entering = { text: string; extra?: readonly string[] };
type Answer = { drop?: string };
async function use(has: boolean): Promise<string> {
  const act: Act<Entering> = { early: has ? Promise.resolve({ text: 'in' }) : new Promise<Entering>(() => {}), isEarly: () => has };
  const first = await either(act, Promise.resolve<Answer>({ drop: 'why' }));
  if (first.early) {
    const early = first.early;
    return 'early ' + early.text;
  }
  const late = first.late;
  return 'late ' + late.drop;
}
use(true).then(a => use(false).then(b => console.log(a, '|', b)));
const alike = JSON.parse('{"early":"s","late":"t"}') as { early: string; late: string }; console.log(alike.early);
export {};
