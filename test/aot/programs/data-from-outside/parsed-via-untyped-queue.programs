type Dictionary = Record<string, number>;
interface Text { s: string }
interface Num { n: number }
interface Lit { s: "a_literal_that_goes_on_for_more_than_sixty_four_bytes_of_text_and_then_some_more" | "b"; n: 123456789012345 | 1 }
