////: api
export const api = {
  async post<T>(path: string, body: unknown): Promise<Result<T>> {
    return { ok: false, reason: "offline", detail: path + " " + String(body) };
  },
  lookup(id: number): Reply {
    return { headers: {}, url: "/" + id, code: 200 };
  },
};
////: either
async function either<In, Result>(act: «1»Either<In, Result>> {
  await Promise.race([act.early, chain.then(() => undefined, () => undefined)]);
  if (act.isEarly()) {
    return { early: await act.early };
  }
  return { late: await chain };
}
