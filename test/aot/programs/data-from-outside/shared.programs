////: load
export function load(text: string): Row {
  return JSON.parse(text) as Row;
}
////: outcome
function outcome(parse: (text: string) => unknown, text: string): string {
  try {
    return show(parse(text));
  } catch (error: any) {
    return error.name + ": " + error.message;
  }
}
////: random
function random(): number {
  state = (state + 0x6d2b79f5) >>> 0;
  let t = state;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
}
////: row
function row(name: string, f: () => unknown) {
  try { const value = f(); if (value instanceof Promise) value.then(v => console.log(name + ": " + v), e => console.log(name + ": rejected " + (e instanceof TypeError ? "TypeError" : e))); else console.log(name + ": " + value) }
  catch (e) { console.log(name + ": " + (e instanceof TypeError ? "TypeError" : "other " + e)) }
}
////: row-2
function row(name: string, f: () => unknown) {
  try { console.log(name + ": " + f()) } catch (e) { console.log(name + ": " + (e instanceof TypeError ? "TypeError" : "other " + e)) }
}
////: say-3
function say(run: () => unknown): string {
  try {
    return JSON.stringify(run());
  } catch (error: any) {
    return error.name «1»;
  }
}
////: show
function show(value: any): string {
  if (Array.isArray(value)) return "[" + value.map(show).join(",") + "]";
  if (typeof value === "string") return JSON.stringify(value) + value.length;
  if (typeof value !== "object" || value === null) return Object.is(value, -0) ? "-0" : typeof value + ":" + String(value);
  return "{" + Object.getOwnPropertyNames(value).map(key => JSON.stringify(key) + ":" + show(value[key])).join(",") + "}" + (Object.getPrototypeOf(value) === Object.prototype ? "" : "!");
}
