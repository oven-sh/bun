////: Line
export interface Line {
  id: number;
  name: string;
}
////: Message
interface Message {
  id: number; at: number; size: number; weight: number; body: string
  meta?: Meta; retries?: number; delay?: number; sentAt?: number; score?: number; tags?: string[]
}
////: Row
export interface Row {
  id: number;
  name: string;
}
////: arrive
function arrive(id: number, text: string): void {
  const entry = waiting.get(id)
  if (!entry) return
  waiting.delete(id)
  const parsed: unknown = JSON.parse(text)
  seen.push(parsed)
  entry.resolve(parsed)
}
////: arrive-2
////= arrive
////= later
////: attempt
function attempt(action: () => unknown): string {
  try {
    return String(action());
  } catch (error) {
    return (error as Error).constructor.name;
  }
}
////: attempt-2
function attempt(parse: (text: string) => unknown, text: string, then?: (value: any) => void): string {
  try {
    const value = parse(text);
    then?.(value);
    return show(value);
  } catch (error: any) {
    return "throws " + error.name;
  }
}
////: describe
function describe(value: unknown): string {
  if (typeof value !== "object" || value === null) return JSON.stringify(value) ?? "undefined";
  const isArray = Array.isArray(value);
  const members = Reflect.ownKeys(value).map(key => String(key) + "=" + describe((value as any)[key]));
  return (isArray ? "[" : "{") + members.join() + (isArray ? "]" : "}") + (Object.getPrototypeOf(value) === (isArray ? Array.prototype : Object.prototype) ? "" : " ANOTHER PROTOTYPE");
}
////: differs
function differs(parse: (text: string) => unknown, text: string): number {
  const typed = outcome(parse, text);
  const plain = outcome(plainParse, text);
  if (typed === plain) return 0;
  if (shown++ < 12) console.log("DIFFERENT on " + JSON.stringify(text).slice(0, 300) + "\n  typed: " + typed.slice(0, 300) + "\n  plain: " + plain.slice(0, 300));
  return 1;
}
////: handle
function handle(m: Message) {
  return m.id + m.at + m.size + m.weight + m.body + (m.retries ?? 0) + (m.delay ?? "-") + (m.score ?? "") + (m.meta ? m.meta.source + m.meta.hops + (m.meta.a ?? "") : "") + (m.tags ? m.tags.length : "")
}
////: later
function later<R>(text: string): Promise<R> {
  const id = next++
  Promise.resolve().then(() => arrive(id, text))
  return new Promise<R>((resolve, reject) => {
    waiting.set(id, { resolve: result => resolve(result as R), reject })
  })
}
