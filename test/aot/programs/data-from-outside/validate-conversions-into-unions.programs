////: messageOf
function messageOf(text: string): string {
  try {
    return JSON.stringify(JSON.parse<{ n: number }>(text));
  } catch (error: any) {
    return error.message;
  }
}
//// validate-conversions-into-unions-whose-arms-could-both-take-the-value.ts
// Conversions of plain objects into unions whose arms could both take them: large trees, long lists, parts that are shared, cycles, accessors that throw in the middle, and accessors that start another validation or parse of the same types in the middle of the first.
import { JSON } from "bun"; import { validate } from "bun:bundle";
type Mixed = { below: Mixed | null; k: "one" } | { below: Mixed | null; k: 2 } | { below: Mixed | null; k: false } | { below: Mixed | null; k: null };
type Forked = { left: Forked | null; right: Forked | null; k: "one" } | { left: Forked | null; right: Forked | null; k: null };
type Listed = { items: Listed[]; k: "one" } | { items: Listed[]; k: null };
type Holder = { mixed: Mixed; forked: Forked; listed: Listed; more: (Mixed | Forked)[] };

function say(run: () => unknown): string {
  try {
    const value: any = run();
    let count = 0;
    const seen = new Set<unknown>();
    const stack = [value];
    while (stack.length && count < 200000) {
      const at = stack.pop();
      if (typeof at !== "object" || at === null || seen.has(at)) continue;
      seen.add(at);
      count++;
      for (const key of Object.keys(at)) stack.push(at[key]);
    }
    return "a value of " + count + " objects";
  } catch (error: any) {
    return error?.name === "TypeError" && error.issues?.length > 0 ? "refused" : "thrown: " + error?.name;
  }
}
const chain = (levels: number, k: unknown, bottom: unknown = null): any => {
  let value = bottom;
  for (let level = 0; level < levels; level++) value = { below: value, k };
  return value;
};
const fork = (levels: number, k: unknown): any => (levels === 0 ? null : { left: fork(levels - 1, k), right: fork(levels - 1, k), k });
const shared = (levels: number, k: unknown): any => {
  let value: any = null;
  for (let level = 0; level < levels; level++) value = { left: value, right: value, k };
  return value;
};
const listed = (width: number, levels: number, k: unknown): any => ({ items: levels ? Array.from({ length: width }, () => listed(width, levels - 1, k)) : [], k });

for (const k of [null, "one", 2, false]) for (const levels of [1, 10, 100, 1000]) console.log("a chain of " + levels + ", " + k + ": " + say(() => validate<Mixed>(chain(levels, k))));
for (const k of [null, "one"]) for (const levels of [2, 8, 14]) console.log("a full tree of " + levels + ", " + k + ": " + say(() => validate<Forked>(fork(levels, k))));
for (const k of [null, "one"]) for (const levels of [2, 10, 16]) console.log("shared parts, " + levels + " levels, " + k + ": " + say(() => validate<Forked>(shared(levels, k))));
for (const k of [null, "one"]) for (const [width, levels] of [[50000, 1], [200, 2], [30, 3]]) console.log("lists of " + width + ", " + levels + " levels, " + k + ": " + say(() => validate<Listed>(listed(width, levels, k))));
{
  const cycle: any = { below: null, k: null };
  cycle.below = { below: { below: cycle, k: null }, k: null };
  console.log("a cycle: " + say(() => validate<Mixed>(cycle)));
  const twin: any = { left: null, right: null, k: null };
  twin.left = twin;
  twin.right = twin;
  console.log("a cycle on both sides: " + say(() => validate<Forked>(twin)));
}
for (const levels of [1, 5, 50]) {
  for (const k of [null, "one"]) {
    console.log("an accessor that throws " + levels + " levels down, " + k + ": " + say(() => validate<Mixed>(chain(levels, k, { get below() { throw new RangeError("mine"); }, k }))));
    console.log("a misfit " + levels + " levels down, " + k + ": " + say(() => validate<Mixed>(chain(levels, k, { below: 7, k }))));
    console.log("an accessor that validates again " + levels + " levels down, " + k + ": " + say(() => validate<Mixed>(chain(levels, k, { get below() { validate<Mixed>(chain(30, k)); validate<Forked>(fork(6, null)); return null; }, k }))));
    console.log("an accessor that parses " + levels + " levels down, " + k + ": " + say(() => validate<Mixed>(chain(levels, k, { get below() { return JSON.parse<Mixed>('{"\\u0062elow":{"below":null,"k":null},"k":null}'); }, k }))));
    const root: any = chain(levels, k, { get below() { try { validate<Mixed>(root); } catch {} return null; }, k, turns: 0 });
    let turns = 0;
    const again: any = chain(levels, k, { get below() { if (turns++ < 3) validate<Mixed>(again); return null; }, k });
    console.log("an accessor that validates the same root " + levels + " levels down, " + k + ": " + say(() => validate<Mixed>(again)));
  }
}
console.log("together: " + say(() => validate<Holder>({ mixed: chain(40, null), forked: fork(8, null), listed: listed(20, 2, null), more: [chain(5, 2), fork(3, "one"), chain(5, null), fork(3, null)] })));
for (let round = 0; round < 200; round++) validate<Holder>({ mixed: chain(1 + (round % 9), null), forked: fork(1 + (round % 5), null), listed: listed(round % 4, 2, null), more: [] });
const text = JSON.stringify({ mixed: chain(40, null), forked: fork(8, null), listed: listed(20, 2, null), more: [chain(5, 2), fork(3, "one")] });
console.log("as text: " + say(() => JSON.parse<Holder>(text)) + "; with an escaped key: " + say(() => JSON.parse<Holder>(text.replace('"mixed"', '"\\u006dixed"'))));
//// validate-copies-a-shared-part-once-for-each-place.ts
// validate<T> copies an object or array that the value holds at several places once for each place, whichever code takes the value: plain data, objects of the program, or the result of another validation; types that are validated by compiled code and types that the library validates. The result is a tree, and validating it again gives an equal one. What T does not describe stays the value's own object at every place.
import { validate } from "bun:bundle";

type Leaf = { n: number };
type Pair = { left: Leaf; right: Leaf };
type Forked = { left: Forked | null; right: Forked | null };
type Lists = { left: Leaf[]; right: Leaf[] };
type Named = { left: Record<string, Leaf>; right: Record<string, Leaf> };
type Tagged = { kind: "a"; left: Tagged | null; right: Tagged | null } | { kind: "b"; left: Tagged | null; right: Tagged | null };
type Untagged = { left: Untagged | null; right: Untagged | null; k: number } | { left: Untagged | null; right: Untagged | null; k: string };
type Loose = { left: unknown; right: any };

const kinds: [string, (value: unknown) => { left: unknown; right: unknown }, (part: any) => any, () => any][] = [
  ["two members of one record type", value => validate<Pair>(value), part => ({ left: part, right: part }), () => ({ n: 1 })],
  ["a type that contains itself or null", value => validate<Forked>(value), part => ({ left: part, right: part }), () => ({ left: null, right: null })],
  ["arrays", value => validate<Lists>(value), part => ({ left: part, right: part }), () => [{ n: 1 }, { n: 2 }]],
  ["dictionaries", value => validate<Named>(value), part => ({ left: part, right: part }), () => ({ x: { n: 1 } })],
  ["a union told apart by a tag", value => validate<Tagged>(value), part => ({ kind: "a", left: part, right: part }), () => ({ kind: "b", left: null, right: null })],
  ["a union that is tried arm by arm", value => validate<Untagged>(value), part => ({ left: part, right: part, k: "s" }), () => ({ left: null, right: null, k: "s" })],
];

function plainData(whole: (part: any) => any, part: () => any): any {
  const parsed = JSON.parse(JSON.stringify(whole(null)));
  parsed.left = parsed.right = JSON.parse(JSON.stringify(part()));
  return parsed;
}
function ofTheProgram(whole: (part: any) => any, part: () => any): any {
  return whole(part());
}

for (const [label, check, whole, part] of kinds) {
  for (const [source, make] of [["plain data", plainData], ["objects of the program", ofTheProgram]] as const) {
    const value = make(whole, part);
    const first = check(value);
    const second = check(first);
    console.log(
      label + ", " + source + ":",
      value.left === value.right ? "shared in the value," : "NOT SHARED IN THE VALUE,",
      first.left === first.right ? "SHARED IN THE RESULT," : "copied twice,",
      first.left === value.left || first.right === value.left ? "THE VALUE'S OWN OBJECT," : "no object of the value,",
      second.left === second.right || second.left === first.left ? "SHARED WHEN VALIDATED AGAIN," : "copied twice again,",
      JSON.stringify(first) === JSON.stringify(value) && JSON.stringify(second) === JSON.stringify(value) ? "equal" : "NOT EQUAL",
    );
  }
}

const held = { n: 1 };
const loose = validate<Loose>({ left: held, right: held, more: held }) as Loose & { more: unknown };
console.log("what the type does not describe:", loose.left === held, loose.right === held, loose.more === held);
//// validate-default-or-undefined/main.ts
// validate<T>(value) where T is a union of undefined and a type with a Schema.Default: undefined goes to the first arm that accepts it, alone, as a member and as an element.
import { validate } from "bun:bundle";
import type { Schema } from "bun";

type Level = (number & Schema.Default<1>) | undefined;
type Reversed = undefined | (number & Schema.Default<1>);

const parse = (text: string): any => JSON.parse(text);
function withUndefined(text: string): any {
  const value = parse(text);
  value.level = undefined;
  return value;
}
function show(what: string, run: () => unknown): void {
  let shown: string;
  try {
    const value: any = run();
    shown = typeof value === "object" && value !== null ? Object.keys(value).join() + " " + JSON.stringify(value) : String(value);
  } catch (error) {
    shown = error instanceof TypeError ? "TypeError" : "thrown: " + String(error);
  }
  console.log(what + ":", shown);
}

show("alone, undefined", () => validate<Level>(undefined));
show("alone, a number", () => validate<Level>(parse("2")));
show("alone, a string", () => validate<Level>(parse('"2"')));
show("alone, null", () => validate<Level>(null));
show("undefined written first, undefined", () => validate<Reversed>(undefined));
show("undefined written first, a number", () => validate<Reversed>(parse("2")));

show("a member, absent", () => validate<{ level: Level }>(parse("{}")));
show("a member, undefined", () => validate<{ level: Level }>(withUndefined("{}")));
show("a member, a number", () => validate<{ level: Level }>(parse('{"level":3}')));
show("a member, a string", () => validate<{ level: Level }>(parse('{"level":"3"}')));
show("a member after another, absent", () => validate<{ name: string; level: Level }>(parse('{"name":"a"}')));
show("a member after another, undefined", () => validate<{ name: string; level: Level }>(withUndefined('{"name":"a"}')));

show("an optional member, absent", () => validate<{ level?: Level }>(parse("{}")));
show("an optional member, undefined", () => validate<{ level?: Level }>(withUndefined("{}")));
show("an optional member, a number", () => validate<{ level?: Level }>(parse('{"level":3}')));

show("an element", () => validate<Level[]>([undefined, 2]));
show("a tuple element", () => validate<[Level, Level]>([undefined, 2]));
show("a dictionary value", () => validate<Record<string, Level>>(withUndefined('{"other":2}')));
//// validate-default-or-undefined/tsconfig.json
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "strict": true
  }
}
//// validate-dictionary-symbol-keys.ts
// validate<T>(value) leaves the symbol keys of a dictionary out of the copy, also when T holds a Schema.Default.
import { validate } from "bun:bundle";
import type { Schema } from "bun";
type Counts = Record<string, number>;
const mark = Symbol("mark");
function dictionary(): any {
  const counts: any = JSON.parse('{"a":1}');
  counts[mark] = 2;
  return counts;
}
function argument(text: string): any {
  const value: any = JSON.parse(text);
  value.d = dictionary();
  value.e = dictionary();
  return value;
}

const plain: any = validate<{ d: Record<string, number>; n: number }>(argument('{"n":1}'));
console.log("without a default", plain.d[mark], Object.keys(plain.d).join());

const defaulted: any = validate<{ d: Record<string, number>; n: number & Schema.Default<1> }>(argument("{}"));
console.log("with a default", defaulted.d[mark], Object.keys(defaulted.d).join(), defaulted.n);

const twice: any = validate<{ d: Counts; e: Counts; n: number & Schema.Default<1> }>(argument("{}"));
console.log("a dictionary type used twice, with a default", twice.d[mark], twice.e[mark], twice.n);
//// validate-of-an-object-written-in-place.ts
// An object written in place as the argument of validate<T>() gives what the same object gives when it comes through a variable: the copy is only left out where nobody can tell.
import { validate } from "bun:bundle";
import type { Schema } from "bun";
interface Inner { x: number }
interface Login { name: string & Schema.MinLength<1>; tries: number & Schema.Int; inner: Inner; note?: string; size: number & Schema.Default<7> }
const order: string[] = [];
function seen<T>(label: string, value: T): T { order.push(label); return value; }
function shown(run: () => unknown): string {
  try {
    const result = run() as Record<string, unknown>;
    return JSON.stringify(result) + " keys " + Object.keys(result).join();
  } catch (error) {
    const issues = (error as Partial<Schema.Error>).issues;
    return (error as Error).name + " " + (issues ? issues.map(issue => issue.path.join(".") + " " + issue.code).join("; ") : (error as Error).message);
  }
}
function both(label: string, inPlace: () => unknown, throughVariable: () => unknown): void {
  const [first, second] = [shown(inPlace), shown(throughVariable)];
  console.log(label, first === second ? "alike" : "DIFFERENT: " + second, first);
}
const inner: Inner = { x: 1 };
const rest: Record<string, unknown> = { tries: 2, extra: true };
const text: unknown = "five";
both("declared order", () => validate<Login>({ name: "a", tries: 1, inner, size: 3 }), () => { const value: unknown = { name: "a", tries: 1, inner, size: 3 }; return validate<Login>(value); });
both("another order", () => validate<Login>({ size: 3, inner, tries: 1, name: "a" }), () => { const value: unknown = { size: 3, inner, tries: 1, name: "a" }; return validate<Login>(value); });
both("a default", () => validate<Login>({ name: "a", tries: 1, inner }), () => { const value: unknown = { name: "a", tries: 1, inner }; return validate<Login>(value); });
both("an optional member", () => validate<Login>({ note: "n", name: "a", tries: 1, inner }), () => { const value: unknown = { note: "n", name: "a", tries: 1, inner }; return validate<Login>(value); });
both("an optional member that is undefined", () => validate<Login>({ name: "a", note: undefined, tries: 1, inner }), () => { const value: unknown = { name: "a", note: undefined, tries: 1, inner }; return validate<Login>(value); });
both("an undeclared key", () => validate<Login>({ name: "a", more: 1, tries: 1, inner }), () => { const value: unknown = { name: "a", more: 1, tries: 1, inner }; return validate<Login>(value); });
both("a spread", () => validate<Login>({ name: "a", ...rest, inner }), () => { const value: unknown = { name: "a", ...rest, inner }; return validate<Login>(value); });
both("a misfit", () => validate<Login>({ name: "", tries: 1.5, inner }), () => { const value: unknown = { name: "", tries: 1.5, inner }; return validate<Login>(value); });
both("a misfit below", () => validate<Login>({ name: "a", tries: 1, inner: { x: text } }), () => { const value: unknown = { name: "a", tries: 1, inner: { x: text } }; return validate<Login>(value); });
both("a member is missing", () => validate<Login>({ name: "a", inner }), () => { const value: unknown = { name: "a", inner }; return validate<Login>(value); });
both("a getter", () => validate<Login>({ get name() { return "g"; }, tries: 1, inner }), () => { const value: unknown = { get name() { return "g"; }, tries: 1, inner }; return validate<Login>(value); });
const made = validate<Login>({ name: seen("name", "a"), inner: seen("inner", inner), tries: seen("tries", 1) });
console.log(order.join(), made.inner !== inner, made.inner.x + made.tries + made.size + made.name.length);
made.inner.x = 9;
console.log(inner.x);
//// validate-of-parts-that-change-between-two-visits.ts
// A part that is held twice is changed by an accessor between the two visits of a validation that remembers what it has found: whatever validate<T> returns must still fit T when it is written and parsed again by T. Each place is read when the validation comes to it, so the second place holds the part as the accessor left it: 84 of the 720 values still fit (Kinds 48, Deep 0, Lists 36).
import { JSON } from "bun"; import { validate } from "bun:bundle";
type Kinds = { below: Kinds | null; also?: Kinds | null; k: number } | { below: Kinds | null; also?: Kinds | null; k: string };
type Deep = { below: Deep | null; also?: Deep | null; x: { k: 1 } } | { below: Deep | null; also?: Deep | null; x: { k: 2 } };
type Lists = { items: Lists[]; k: number[] } | { items: Lists[]; k: string[] };

const misfits: (() => unknown)[] = [() => ({}), () => [], () => null, () => true, () => undefined, () => "text", () => 7, () => ({ k: 3 }), () => [1, "a"], () => Symbol("s")];
let values = 0;
let refused = 0;
let thrown = 0;
let unfit = 0;

function judge<T>(validate: (value: unknown) => T, parse: (text: string) => T, make: () => unknown): void {
  let result: T;
  try {
    result = validate(make());
  } catch (error: any) {
    if (error?.name === "TypeError" && error.issues?.length > 0) refused++;
    else thrown++;
    return;
  }
  values++;
  try {
    parse(JSON.stringify(result));
  } catch {
    unfit++;
  }
}

for (const misfit of misfits) {
  for (const levels of [0, 1, 3, 8]) {
    for (const where of [0, 1, 2, 3, 4, 5]) {
      const wrap = (value: any, member: string, filler: () => any): any => {
        for (let level = 0; level < levels; level++) value = { ...filler(), [member]: value };
        return value;
      };
      judge(value => validate<Kinds>(value), text => JSON.parse<Kinds>(text), () => {
        const shared: any = { below: null, k: 1 };
        const spoil = () => { shared.k = misfit(); return where % 2 ? "s" : 2; };
        const inner = wrap(shared, "below", () => ({ k: 1 }));
        const again = wrap(shared, "below", () => ({ k: "s" }));
        if (where < 2) return { below: inner, get k() { return spoil(); }, also: again };
        if (where < 4) return { get k() { return spoil(); }, below: inner, also: again };
        return { below: inner, also: { below: again, get k() { return spoil(); } }, k: 1 };
      });
      judge(value => validate<Deep>(value), text => JSON.parse<Deep>(text), () => {
        const shared: any = { below: null, x: { k: 1 } };
        const spoil = () => { if (where % 2) shared.x = misfit(); else shared.x.k = misfit(); return { k: 2 }; };
        const inner = wrap(shared, "below", () => ({ x: { k: 1 } }));
        const again = wrap(shared, "below", () => ({ x: { k: 2 } }));
        if (where < 2) return { below: inner, get x() { return spoil(); }, also: again };
        if (where < 4) return { get x() { return spoil(); }, below: inner, also: again };
        return { below: inner, also: { below: again, get x() { return spoil(); } }, x: { k: 1 } };
      });
      judge(value => validate<Lists>(value), text => JSON.parse<Lists>(text), () => {
        const shared: any = { items: [], k: [1] };
        const spoil = () => { if (where % 2) shared.k = misfit(); else shared.k[0] = misfit(); return ["s"]; };
        let inner: any = shared;
        for (let level = 0; level < levels; level++) inner = { items: [inner, shared], k: [level] };
        if (where < 2) return { items: [inner, { items: [], get k() { return spoil(); } }, shared, inner], k: [1] };
        if (where < 4) return { get k() { return spoil(); }, items: [inner, shared] };
        return { items: [shared, inner, shared], get k() { return spoil(); } };
      });
    }
  }
}
console.log(values + " values, " + refused + " refused, " + thrown + " thrown; values that do not fit their type: " + unfit);
//// validate-of-yaml-aliases-nested-as-deep-as-the-parser-allows.ts
// Bun.YAML.parse keeps what an alias names shared, and validate<T> copies a value as a tree, so N nested aliases cost 2^N copies. The YAML parser refuses more than twenty such levels: that bound is what keeps a small text from costing more than a second or two here.
import { validate } from "bun:bundle";
type Forked = { left: Forked | null; right: Forked | null };

function nested(levels: number): string {
  const lines = ["a0: &a0 { left: null, right: null }"];
  for (let level = 1; level <= levels; level++) lines.push("a" + level + ": &a" + level + " { left: *a" + (level - 1) + ", right: *a" + (level - 1) + " }");
  return lines.join("\n") + "\n";
}

for (const levels of [1, 2, 10, 16, 20, 21, 30, 1000]) {
  try {
    const top = (Bun.YAML.parse(nested(levels)) as any)["a" + levels];
    const copy = validate<Forked>(top);
    let depth = 0;
    for (let at: Forked | null = copy; at; at = depth % 2 ? at.left : at.right) depth++;
    console.log(levels + " levels: shared as parsed: " + (top.left === top.right) + ", shared in the copy: " + (copy.left === copy.right) + ", depth " + depth);
  } catch (error: any) {
    console.log(levels + " levels: " + error.name + ": " + error.message);
  }
}
//// validate-optional-member-absent.ts
// An optional member that validate<T>(value) would copy stays absent in the copy when the argument does not have it.
import { validate } from "bun:bundle";
type Nested = { a: number; inner?: { x: number } };
const parse = (text: string): any => JSON.parse(text);

const nested = validate<Nested>(parse('{"a":1}'));
console.log("an object", Object.keys(nested).join(), "inner" in nested);

const list = validate<{ a: number; items?: number[] }>(parse('{"a":1}'));
console.log("an array", Object.keys(list).join(), "items" in list);

const present = validate<Nested>(parse('{"inner":{"x":2},"a":1}'));
console.log("present", Object.keys(present).join(), JSON.stringify(present));

const explicit = parse('{"a":1}');
explicit.inner = undefined;
const kept = validate<Nested>(explicit);
console.log("present and undefined", Object.keys(kept).join(), "inner" in kept, kept.inner);
//// validate-random-graphs-with-shared-parts.ts
// Fuzzes validate<T> with a fixed seed on random object graphs in which the same object or array is reachable by several paths. The result must equal the result for the same value copied out as a tree, must never merge two different objects, and must never contain an object of the argument where T describes it. The argument stays unchanged and each getter is read once per copy. Typed code then reads every field of the result. Some graphs contain a cycle (a RangeError) and some have getters that return something else on each read. With keepsSharing set, an object or array that is shared under one type must stay shared, and graphs that would be astronomically large as trees are made too.
import { JSON } from "bun"; import { validate } from "bun:bundle";

const seed: number = 1;
const rounds: number = 300;
const keepsSharing: boolean = false;

type Leaf = { n: number };
type Wide = { n: number; s?: string };
type Pair = { left: Leaf; right: Leaf; wide: Wide };
type Forked = { left: Forked | null; right: Forked | null };
type Lists = { a: Leaf[]; b: Leaf[]; rows: Leaf[][] };
type Four = [Leaf, Leaf, Leaf[], Wide];
type Named = { d: Record<string, Leaf>; e: Record<string, Leaf>; one: Leaf };
type Tagged = { kind: "a"; item: Leaf; next: Tagged | null } | { kind: "b"; items: Leaf[]; next: Tagged | null };
type Untagged = { a: Leaf; rest: Untagged[] } | { b: Wide; rest: Untagged[] };
type Optional = { x?: Leaf; z: Leaf | null; w?: Optional };
type Loose = { known: Leaf; free: unknown; other: any };
type Tree = { value: Leaf; children: Tree[] };
type Grid = Leaf[][][];
type Late = { p: Leaf[]; inner: Late[]; q: number } | { p: Leaf[]; inner: Late[]; q: string };
type Mixed = { items: (Leaf | string[])[]; more: (Leaf | string[])[] };

let state = seed >>> 0;
////= random
const below = (limit: number): number => Math.floor(random() * limit);
const chance = (probability: number): boolean => random() < probability;

type Description =
  | { is: "number" | "string" | "null" | "unknown"; id: number }
  | { is: "constant"; id: number; value: string }
  | { is: "object"; id: number; fields: [string, Description, boolean][] }
  | { is: "array" | "dictionary"; id: number; item: Description }
  | { is: "tuple"; id: number; items: Description[] }
  | { is: "union"; id: number; arms: Description[] };
let descriptions = 0;
