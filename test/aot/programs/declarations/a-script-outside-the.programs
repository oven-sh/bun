export const log: string[] = [];
//// closures-from-earlier-iterations/made.ts
import { log } from "./log";
type Cell = { filled: object | null };
let step = 1;
export function setStep(next: number): void { step = next; }

////= lines-3	withArrows	log.push("arrow
export const byArrow = withArrows();

function withDeclarations(): { rounds: number } {
  const earlier: Array<() => Cell> = [];
  let rounds = 0;
  for (const round of [1, 2]) {
    const cell: Cell = { filled: null };
    function mine(): Cell { return cell; }
    for (const get of earlier) { if (get().filled) log.push("declaration"); }
    earlier.push(mine);
    cell.filled = {};
    rounds += round;
  }
  return { rounds };
}
export const byDeclaration = withDeclarations();

function withLets(): { rounds: number } {
  const earlier: Array<() => object | null> = [];
  let rounds = 0;
  for (const round of [1, 2]) {
    let filled: object | null = null;
    for (const get of earlier) { if (get()) log.push("let"); }
    earlier.push(() => filled);
    filled = {};
    rounds += round;
  }
  return { rounds };
}
export const byLet = withLets();

function addsStep(): { total: number } {
  const earlier: Array<() => Cell> = [];
  let total = 0;
  for (const round of [1, 2]) {
    const cell: Cell = { filled: null };
    for (const get of earlier) { if (get().filled) total += step; }
    earlier.push(() => cell);
    cell.filled = {};
    total += round;
  }
  return { total };
}
export const readsStep = addsStep();
//// closures-from-earlier-iterations/main.ts
// A closure made in one iteration of a loop keeps that iteration's variables. What an initializer does because of them (an effect, a read of a variable that changes, a throw) happens where the constant is declared.
import { log } from "./log";
import { byArrow, byDeclaration, byLet, readsStep, setStep } from "./made";
log.push("loaded");
setStep(10);
console.log(JSON.stringify([byArrow, byDeclaration, byLet, readsStep]), log.join());
let loaded = false;
try {
  const throws = await import("./throws");
  loaded = true;
  console.log(JSON.stringify(throws.thrown));
} catch (error) {
  console.log(loaded ? "when it was read:" : "while it was loaded:", (error as Error).name);
}
