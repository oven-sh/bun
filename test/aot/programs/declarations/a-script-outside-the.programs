// The rest element of an assignment pattern stores to its target wherever the pattern stands: behind a hole, in the head of a loop, on an element of a list, through a parameter, through a module namespace. A copy taken by a constant that is declared before the store keeps the old value.
import { shared } from "./shared";
import { storeThroughNamespace } from "./stores";
const behindHole = { rest: [1] };
const copyOfBehindHole = { ...behindHole };
const inLoopHead = { rest: [1] };
const copyOfInLoopHead = { ...inLoopHead };
const list = [[1], [2]];
const copyOfList = [...list];
const handed = { rest: [1] };
const copyOfHanded = { ...handed };
const copyOfShared = { ...shared };
const record: { rest: Record<string, number> } = { rest: { x: 1 } };
const copyOfRecord = { ...record };
function store(into: { rest: number[] }): void { [...into.rest] = [2, 3]; }
function read(): string { return JSON.stringify([copyOfBehindHole, copyOfInLoopHead, copyOfList, copyOfHanded, copyOfShared, copyOfRecord]); }
[, ...behindHole.rest] = [0, 2, 3];
for ([...inLoopHead.rest] of [[2, 3]]) {}
[...list[0]] = [9];
store(handed);
storeThroughNamespace();
({ ...record.rest } = { y: 2 });
console.log(read());
//// constants-mutated-through-rest-patterns/shared.ts
export const shared = { rest: [1] };
//// constants-mutated-through-rest-patterns/stores.ts
import * as namespace from "./shared";
export function storeThroughNamespace(): void { [...namespace.shared.rest] = [2, 3]; }
//// export-let/dep.ts
export let hits = 0
export let label = "none"
export const limit = 2 ** 31
export let late: number | undefined
export function bump(): void { hits += 70000; label = label + hits; late = hits / 4 }
export function read(): number { return hits + 0.5 }
export function state(): string { return typeof late + " " + late }
//// export-let/main.ts
// An exported `let` is assigned in its own module and read from another module.
import { bump, hits, label, limit, read, state } from "./dep"
export let count = 0
export let total: number = 10
export const base = 3
const derived = base + 1
export enum Level { Low = 1, High = 5 }
function inc(): void { count++; total += count * 1000000 }
inc(); inc(); inc()
console.log(count, total, derived, Level.High + base)
console.log(hits, label, limit)
bump(); bump()
console.log(hits, label, read(), state())
//// export-tdz/dep.ts
import { list, made } from "./main"
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
export const seen = attempt(() => made) + " " + attempt(() => list)
//// export-tdz/main.ts
// Another file reads an exported `const` in its temporal dead zone, through an import cycle.
import { seen } from "./dep"
export const made: number = Math.abs(-5)
export const list: number[] = [Math.abs(-1)]
console.log(seen, made, list.length)
