//// what-runs-in-a-script-with-code-is-its-own/main.ts
// Bun runs every file as a module: a constant, a function with a body, and a name that is both an interface and a constant belong to the script that has them. Plain Bun answers `undefined` to each `typeof`, and the build says so.
import "./with-code";
console.log(typeof counted, typeof helper, typeof Both);
const both: Both = { a: 1 };
console.log(both);
//// what-runs-in-a-script-with-code-is-its-own/tsconfig.json
////= lines
//// what-runs-in-a-script-with-code-is-its-own/with-code.ts
const counted = 1;
function helper(): number;
function helper(n: number): number;
function helper(n?: number): number {
  return n ?? counted;
}
////= lines-2	Both	a	number
const Both = { made: helper() };
console.log(Both.made);
