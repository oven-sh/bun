  return tell(() => (Object.defineProperty(object, "d", { get: () => 2 }), "defined"));
}
function defineMany(object) {
  return tell(() => (Object.defineProperties(object, { e: { get() { return 3; } }, f: { set(value) {} } }), "defined"));
}
function describe() {
