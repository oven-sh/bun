  defineValue(target, i);
  sum += target.size;
  defineGetter(target, i);
  sum += target.size;
  const box = { held: 1 };
  defineBoth(target, box);
  target.size = i;
  sum += target.size + box.held;
  defineValue(target, 1);
  sum += target.size;
}
