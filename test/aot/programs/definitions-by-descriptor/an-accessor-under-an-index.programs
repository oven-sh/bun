//// an-accessor-under-an-index-is-refused-by-a-text-object-whose-length-is-read.js
// A getter and a setter are defined under an index that a text object already holds, which throws. The length of the object is read before and behind, and a function that tests for a string prints it.
////= quoted
function make() {
  return new String("abc");
}
function run() {
  const o = make();
  console.log(quoted(o.length));
  try {
    Object.defineProperty(o, 1, { get() { return "got"; }, set(v) { console.log(quoted(v)); }, enumerable: true, configurable: true });
  } catch (e) {
    console.log("threw " + e.name);
  }
  console.log(quoted(o.length));
}
run();
//// an-accessor-under-an-index-past-the-end-of-a-text-object-whose-length-is-read.js
// A getter and a setter are defined under an index past the end of a text object whose length was read. A function that tests for a string prints the length.
////= quoted
function make() {
  return new String("abc");
}
function run() {
  const o = make();
  console.log(quoted(o.length));
  Object.defineProperty(o, 5, { get() { return "got"; }, set(v) { console.log(quoted(v)); }, configurable: true });
}
run();
//// an-accessor-under-an-index-past-the-end-of-a-text-object-is-read-and-stored-to.js
// A getter and a setter are defined under an index past the end of a text object. Its length, the accessor and a character are read, and a function that tests for a string prints them.
////= quoted
function make() {
  return new String("abc");
}
function run() {
  const o = make();
  console.log(quoted(o.length));
  Object.defineProperty(o, 5, { get() { return "got"; }, set(v) { console.log(quoted(v)); }, configurable: true });
  console.log(quoted(o.length));
  console.log(quoted(o[5]), quoted(o[1]));
  o[5] = "put";
  console.log(quoted(o.length));
}
run();
