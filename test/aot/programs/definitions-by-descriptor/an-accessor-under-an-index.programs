////= scene-below	ElementOfArguments	: unknown	: any	 as Error	(function (a: number, b: number, c: number) { return arguments; })(1, 2, 3)	o[1]
////= scene-below	LengthOfRecord	: unknown	: any	 as Error	{ 0: 1, 1: 2, 2: 3, length: 3 }	o.length
////= scene-below	ElementOfRecord	: unknown	: any	 as Error	{ 0: 1, 1: 2, 2: 3, length: 3 }	o[1]
////= scene-below	LastIndexOfPattern	: unknown	: any	 as Error	/a/g	o.lastIndex
////= scene-below	MessageOfFailure	: unknown	: any	 as Error	new Error("m")	o.message
////= scene-below	LengthOfBelowTexts	: unknown	: any	 as Error	Object.create(String.prototype)	o.length
////= scene-below	LengthOfBelowLists	: unknown	: any	 as Error	Object.create(Array.prototype)	o.length
////= scene-below	MessageOfBelowFailures	: unknown	: any	 as Error	Object.create(Error.prototype)	o.message
