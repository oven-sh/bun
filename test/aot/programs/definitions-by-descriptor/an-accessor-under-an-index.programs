//// an-accessor-under-an-index-is-written-in-a-literal-and-in-classes-beside-reads-that-a-test-for-a-string-prints-in-typed-code.ts
// A literal and classes below Array, String, Uint8Array, Object, RegExp and Error have a getter and a setter under the index 1. In each scene one property is read, also behind a store under the index, and a function of the scene that tests for a string prints it.
////= scene-of-a-literal	LengthOfLiteral	: unknown	: any	 as Error		o.length
////= scene-of-a-literal	ElementOfLiteral	: unknown	: any	 as Error		o[1]
////= scene-of-a-class	LengthBelowArray	: unknown	: any	 as Error	Array	o.length	 as any	1, 2, 3
////= scene-of-a-class	ElementBelowArray	: unknown	: any	 as Error	Array	o[1]	 as any	1, 2, 3
////= scene-of-a-class	LengthBelowString	: unknown	: any	 as Error	String	o.length	 as any	"abc"
////= scene-of-a-class	ElementBelowString	: unknown	: any	 as Error	String	o[1]	 as any	"abc"
////= scene-of-a-class	LengthBelowUint8Array	: unknown	: any	 as Error	Uint8Array	o.length	 as any	3
////= scene-of-a-class	ElementBelowUint8Array	: unknown	: any	 as Error	Uint8Array	o[1]	 as any	3
////= scene-of-a-class	LengthBelowObject	: unknown	: any	 as Error	Object	o.length	 as any	undefined
////= scene-of-a-class	ElementBelowObject	: unknown	: any	 as Error	Object	o[1]	 as any	undefined
////= scene-of-a-class	LastIndexBelowRegExp	: unknown	: any	 as Error	RegExp	o.lastIndex	 as any	"a", "g"
////= scene-of-a-class	MessageBelowError	: unknown	: any	 as Error	Error	o.message	 as any	"m"
