function iterator_keys(c: Set<string>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-")); kept = c.values(); const a1 = (c.size + (c.has("gamma") ? "+" : "-")); for (const k of c.keys()) n += k.length; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-")) + " " + n + " " + list(c); }
