    this.w = (this.w * 59 + first) | 0; this.v = (this.v ^ second) | 0; this.w = (this.w * 61 + this.v) | 0; this.v = (this.v * 67 + this.w) | 0;
    this.w = (this.w * 71 + first) | 0; this.v = (this.v ^ second) | 0; this.w = (this.w * 73 + this.v) | 0; this.v = (this.v * 79 + this.w) | 0;
