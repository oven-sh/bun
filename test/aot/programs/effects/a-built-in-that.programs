const m = { m() {} }.m;
let turn = 0;
function pick() { return turn++ % 2 ? m : C; }
function ask() {
  const before = counter, boxBefore = box.n;
  try { Int8Array.of.call(pick(), 1, 2); } catch (error) { console.log(error.name); }
  return (counter - before) + " " + (box.n - boxBefore);
}
console.log(ask(), ask());
