function destructure_keys(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); { const [first] = c; n += first === undefined ? 0 : first[1]; } const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); for (const k of c.keys()) n += k.length; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function destructure_iterator(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); { const [first] = c; n += first === undefined ? 0 : first[1]; } const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); kept = c.entries(); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function destructure_setWide(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); { const [first] = c; n += first === undefined ? 0 : first[1]; } const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); c.set("beta", 1.5); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function destructure_setNew(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); { const [first] = c; n += first === undefined ? 0 : first[1]; } const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); c.set(key + "!", 9); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function destructure_setNumber(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); { const [first] = c; n += first === undefined ? 0 : first[1]; } const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); (c as Map<unknown, number>).set(5, 5); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function destructure_deletePresent(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); { const [first] = c; n += first === undefined ? 0 : first[1]; } const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += c.delete("alpha") ? 1 : 0; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function destructure_clear(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); { const [first] = c; n += first === undefined ? 0 : first[1]; } const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); c.clear(); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function destructure_getOrInsert(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); { const [first] = c; n += first === undefined ? 0 : first[1]; } const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += (c as any).getOrInsert("delta", 4); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
