//// a-constant-set-is-asked-around-every-pair-of-touches.ts
// A constant Set is asked, touched, and asked or changed again in one function. Each function is called where the compiler sees the call.
const mark = Symbol("mark"); const weak = new WeakMap<object, number>(); let kept: unknown;
const unseen = new Function("x", "return x") as <T>(x: T) => T;
const peek = new Function("a", "let s = ''; for (let i = 0; i < a.length && i < 12; i++) s += (i in a ? String(a[i]) : '-') + ','; return s + a.length") as (a: unknown) => string;
class Returned { constructor(o: object) { return o; } }
class Stamp extends Returned { #p = 1; #q = 2; #r = 3; #s = 4; #t = 5; static has(o: object): boolean { return #p in o; } }
function withPrototype(prototype: object): Function { function Made(this: any) { this.own = 1; } Made.prototype = prototype; return Made; }
function classOver(prototype: object): unknown { class Derived extends (withPrototype(prototype) as any) {} return new Derived(); }
function generatorWith(prototype: object): unknown { function* g() { yield 1; } g.prototype = prototype; return g(); }
function spreadCount(...all: unknown[]): number { return all.length; }
function attempt(f: () => string): string { try { return f(); } catch (e) { return (e as Error).constructor.name; } }
const which = process.argv[2];
const key = unseen("gam") + unseen("ma");
const list = new Function("c", "return [...c].join() + '#' + c.size") as (c: unknown) => string;
function nothing_nothing(c: Set<string>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-"));  const a1 = (c.size + (c.has("gamma") ? "+" : "-"));  return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-")) + " " + n + " " + list(c); }
function nothing_forOf(c: Set<string>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-"));  const a1 = (c.size + (c.has("gamma") ? "+" : "-")); for (const k of c) n += k.length; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-")) + " " + n + " " + list(c); }
function nothing_forEach(c: Set<string>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-"));  const a1 = (c.size + (c.has("gamma") ? "+" : "-")); c.forEach(k => { n += k.length; }); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-")) + " " + n + " " + list(c); }
function nothing_spread(c: Set<string>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-"));  const a1 = (c.size + (c.has("gamma") ? "+" : "-")); n += [...c].length; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-")) + " " + n + " " + list(c); }
function nothing_arrayFrom(c: Set<string>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-"));  const a1 = (c.size + (c.has("gamma") ? "+" : "-")); n += Array.from(c).length; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-")) + " " + n + " " + list(c); }
function nothing_keys(c: Set<string>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-"));  const a1 = (c.size + (c.has("gamma") ? "+" : "-")); for (const k of c.keys()) n += k.length; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-")) + " " + n + " " + list(c); }
function nothing_values(c: Set<string>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-"));  const a1 = (c.size + (c.has("gamma") ? "+" : "-")); for (const k of c.values()) n += k.length; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-")) + " " + n + " " + list(c); }
function nothing_entries(c: Set<string>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-"));  const a1 = (c.size + (c.has("gamma") ? "+" : "-")); for (const [k, v] of c.entries()) n += k.length + v.length; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-")) + " " + n + " " + list(c); }
function nothing_oneStep(c: Set<string>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-"));  const a1 = (c.size + (c.has("gamma") ? "+" : "-")); n += c.values().next().value!.length; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-")) + " " + n + " " + list(c); }
function nothing_breakOut(c: Set<string>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-"));  const a1 = (c.size + (c.has("gamma") ? "+" : "-")); for (const k of c) { n += k.length; break; } return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-")) + " " + n + " " + list(c); }
function nothing_iterator(c: Set<string>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-"));  const a1 = (c.size + (c.has("gamma") ? "+" : "-")); kept = c.values(); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-")) + " " + n + " " + list(c); }
function nothing_has(c: Set<string>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-"));  const a1 = (c.size + (c.has("gamma") ? "+" : "-")); n += c.has(key) ? 1 : 0; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-")) + " " + n + " " + list(c); }
