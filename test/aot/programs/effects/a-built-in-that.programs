function spread_freeze(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); Object.freeze(c); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function spread_name(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); (c as any).tag = 1; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function spread_stamp(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); new Stamp(c); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
