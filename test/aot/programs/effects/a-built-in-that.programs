function iterator_oneStep(c: Set<string>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-")); kept = c.values(); const a1 = (c.size + (c.has("gamma") ? "+" : "-")); n += c.values().next().value!.length; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-")) + " " + n + " " + list(c); }
function iterator_breakOut(c: Set<string>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-")); kept = c.values(); const a1 = (c.size + (c.has("gamma") ? "+" : "-")); for (const k of c) { n += k.length; break; } return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-")) + " " + n + " " + list(c); }
