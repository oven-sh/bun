function spread_setPresent(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); c.set("beta", 20); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function spread_setWide(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); c.set("beta", 1.5); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function spread_setNew(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); c.set(key + "!", 9); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function spread_setNumber(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); (c as Map<unknown, number>).set(5, 5); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function spread_deletePresent(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += c.delete("alpha") ? 1 : 0; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function spread_deleteAbsent(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += c.delete("nobody") ? 1 : 0; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function spread_clear(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); c.clear(); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function spread_copy(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += new Map(c).size; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function spread_fromEntries(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += Object.keys(Object.fromEntries(c)).length; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function spread_getOrInsert(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += (c as any).getOrInsert("delta", 4); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function spread_destructure(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); { const [second] = c; n += second === undefined ? 0 : second[1]; } return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function spread_call(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += spreadCount(...c); return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
function spread_clone(c: Map<string, number>): string { let n = 0; const a0 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += [...c].length; const a1 = (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")); n += structuredClone(c).size; return a0 + " " + a1 + " " + (c.size + (c.has("gamma") ? "+" : "-") + c.get("beta")) + " " + n + " " + list(c); }
