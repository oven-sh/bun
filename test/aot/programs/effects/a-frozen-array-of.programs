function dataView_store(v: Int32Array<ArrayBuffer>): string { let n = 0; const x = v[1]; kept = new DataView(v.buffer); v[1] = 40; return x + "|" + v[1] + "|" + v.length + "|" + n + "|" + peek(v); }
