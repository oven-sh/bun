//// a-key-that-runs-code-when-it-becomes-a-name-changes-the-object-that-is-asked.js
// A lookup by key in a small object made right there, where the key is an object: it becomes a name by running code, which changes the object that is being asked, whether anybody uses the answer or not.
const lines = [];
const say = text => { lines.push(text); };
function unused(key) {
  const o = { a: 1, b: 2 };
  o[key];
  return o.a + o.b;
}
function unusedIn(key) {
  const o = { a: 1, b: 2 };
  key in o;
  return o.a + o.b;
}
function between(make) {
  const o = { a: 1, b: 2 };
  const key = make(o);
  const before = o.a;
  const found = o[key];
  return before + "," + o.a + "," + found;
}
function betweenIn(make) {
  const o = { a: 1, b: 2 };
  const key = make(o);
  const before = o.a;
  const found = key in o;
  return before + "," + o.a + "," + found + "," + Object.keys(o).join("+");
}
function twice(make) {
  const o = { a: 1, b: 2 };
  const key = make(o);
  return o[key] + "," + o[key] + "," + o.a;
}
function inLoop(make) {
  const o = { a: 1, b: 2 };
  const key = make(o);
  let sum = 0;
  for (let i = 0; i < 5; i++) sum += o[key] + o.a;
  return sum;
}
let count = 0;
const loud = { toString() { count++; say("converted " + count); return "a"; } };
const thrower = { toString() { throw new RangeError("no name"); } };
const makers = [
  o => ({ toString() { o.a += 10; return "b"; } }),
  o => ({ toString() { o.a += 10; return "a"; } }),
  o => ({ toString() { delete o.a; return "a"; } }),
  o => ({ toString() { o.c = 3; return "c"; } }),
  o => ({ [Symbol.toPrimitive]() { o.a = "text"; return "a"; } }),
  o => ({ toString() { Object.defineProperty(o, "a", { get() { say("getter ran"); return 99; }, configurable: true }); return "a"; } }),
  o => ({ valueOf() { o.a = -1; return "b"; }, toString: null }),
  o => ({ toString() { Object.setPrototypeOf(o, { z: "z above" }); return "z"; } }),
  () => "__proto__",
  () => Symbol.iterator,
  () => 0,
  () => null,
];
for (let turn = 0; turn < 3; turn++) {
  say("unused " + unused(loud) + " " + unusedIn(loud) + " " + count);
  for (const run of [unused, unusedIn]) {
    try {
      say("thrower " + run(thrower));
    } catch (error) {
      say("threw " + error.name);
    }
  }
  for (const make of makers) {
    for (const run of [between, betweenIn, twice, inLoop]) {
      try {
        say(run.name + " " + String(run(make)));
      } catch (error) {
        say(run.name + " threw " + error.name);
      }
    }
  }
}
console.log(lines.join("\n"));
//// a-refused-operand-keeps-the-code-of-the-operands-behind-it-from-running.cjs
// A built-in that refuses an operand runs no code of the operands behind it: a negative offset into a DataView, a negative width for BigInt.asIntN, a buffer of a fixed length, a receiver that is no module.
const Module = require("node:module");

const ran = [];

function nameOfError(call) {
  try {
    call();
  } catch (error) {
    return error.name;
  }
  return "none";
}

function report(name, call) {
  const before = ran.length;
  console.log(name, nameOfError(call), ran.length === before ? "ran nothing" : `ran ${ran.slice(before)}`);
}

function storeNumbers(offset) {
  const view = new DataView(new ArrayBuffer(16));
  report("setInt8", () => view.setInt8(offset, { valueOf: () => ran.push("setInt8") }));
  report("setUint8", () => view.setUint8(offset, { valueOf: () => ran.push("setUint8") }));
  report("setInt16", () => view.setInt16(offset, { valueOf: () => ran.push("setInt16") }));
  report("setUint16", () => view.setUint16(offset, { valueOf: () => ran.push("setUint16") }, true));
  report("setInt32", () => view.setInt32(offset, { valueOf: () => ran.push("setInt32") }));
  report("setUint32", () => view.setUint32(offset, { valueOf: () => ran.push("setUint32") }, true));
  report("setFloat16", () => view.setFloat16(offset, { valueOf: () => ran.push("setFloat16") }));
  report("setFloat32", () => view.setFloat32(offset, { valueOf: () => ran.push("setFloat32") }));
  report("setFloat64", () => view.setFloat64(offset, { valueOf: () => ran.push("setFloat64") }, true));
}

function storeBigInts(offset) {
  const view = new DataView(new ArrayBuffer(16));
  report("setBigInt64", () => view.setBigInt64(offset, { valueOf: () => BigInt(ran.push("setBigInt64")) }));
  report("setBigUint64", () => view.setBigUint64(offset, { valueOf: () => BigInt(ran.push("setBigUint64")) }));
  report("asIntN", () => BigInt.asIntN(offset, { valueOf: () => BigInt(ran.push("asIntN")) }));
  report("asUintN", () => BigInt.asUintN(offset, { valueOf: () => BigInt(ran.push("asUintN")) }));
}

function changeLengths() {
  const fixed = new ArrayBuffer(8);
  const resizable = new ArrayBuffer(8, { maxByteLength: 16 });
  const shared = new SharedArrayBuffer(8);
  const growable = new SharedArrayBuffer(8, { maxByteLength: 16 });
  report("resize, fixed", () => fixed.resize({ valueOf: () => ran.push("resize, fixed") }));
  report("resize, resizable", () => resizable.resize({ valueOf: () => ran.push("resize, resizable") }));
  report("grow, fixed", () => shared.grow({ valueOf: () => ran.push("grow, fixed") + 8 }));
  report("grow, growable", () => growable.grow({ valueOf: () => ran.push("grow, growable") + 8 }));
}

function askTheLoader() {
  report("_load", () => Module._load({ toString: () => `node:path${ran.push("_load")}` }));
  report("_compile", () => Module.prototype._compile.call({}, { toString: () => `${ran.push("_compile")}` }, "a.js"));
}

storeNumbers(-1);
storeNumbers(0);
storeNumbers(16);
storeBigInts(-1);
storeBigInts(0);
changeLengths();
askTheLoader();
//// a-small-int32array-is-read-and-written-around-every-built-in-it-is-handed-to.ts
// A small Int32Array keeps its elements beside the cell until somebody wants its buffer. It is read, handed to a built-in, and read or written again in one function. Each function is called where the compiler sees the call.
const mark = Symbol("mark"); const weak = new WeakMap<object, number>(); let kept: unknown;
const unseen = new Function("x", "return x") as <T>(x: T) => T;
const peek = new Function("a", "let s = ''; for (let i = 0; i < a.length && i < 12; i++) s += (i in a ? String(a[i]) : '-') + ','; return s + a.length") as (a: unknown) => string;
class Returned { constructor(o: object) { return o; } }
class Stamp extends Returned { #p = 1; #q = 2; #r = 3; #s = 4; #t = 5; static has(o: object): boolean { return #p in o; } }
function withPrototype(prototype: object): Function { function Made(this: any) { this.own = 1; } Made.prototype = prototype; return Made; }
function classOver(prototype: object): unknown { class Derived extends (withPrototype(prototype) as any) {} return new Derived(); }
function generatorWith(prototype: object): unknown { function* g() { yield 1; } g.prototype = prototype; return g(); }
function spreadCount(...all: unknown[]): number { return all.length; }
function attempt(f: () => string): string { try { return f(); } catch (e) { return (e as Error).constructor.name; } }
const which = process.argv[2];
function make(): Int32Array<ArrayBuffer> { const v = new Int32Array(16); for (let i = 0; i < 16; i++) v[i] = i + 1; return v; }
function nothing_read(v: Int32Array<ArrayBuffer>): string { let n = 0; const x = v[1];  return x + "|" + v[1] + "|" + v[15] + "|" + v.length + "|" + n; }
function nothing_store(v: Int32Array<ArrayBuffer>): string { let n = 0; const x = v[1];  v[1] = 40; return x + "|" + v[1] + "|" + v.length + "|" + n + "|" + peek(v); }
function nothing_loop(v: Int32Array<ArrayBuffer>): string { let n = 0; let sum = v[0]!;  for (let i = 1; i < v.length; i++) { sum += v[i]!; v[i] = i; } return sum + "|" + peek(v); }
function buffer_read(v: Int32Array<ArrayBuffer>): string { let n = 0; const x = v[1]; n += v.buffer.byteLength; return x + "|" + v[1] + "|" + v[15] + "|" + v.length + "|" + n; }
function buffer_store(v: Int32Array<ArrayBuffer>): string { let n = 0; const x = v[1]; n += v.buffer.byteLength; v[1] = 40; return x + "|" + v[1] + "|" + v.length + "|" + n + "|" + peek(v); }
function buffer_loop(v: Int32Array<ArrayBuffer>): string { let n = 0; let sum = v[0]!; n += v.buffer.byteLength; for (let i = 1; i < v.length; i++) { sum += v[i]!; v[i] = i; } return sum + "|" + peek(v); }
function subarray_read(v: Int32Array<ArrayBuffer>): string { let n = 0; const x = v[1]; kept = v.subarray(1); return x + "|" + v[1] + "|" + v[15] + "|" + v.length + "|" + n; }
function subarray_store(v: Int32Array<ArrayBuffer>): string { let n = 0; const x = v[1]; kept = v.subarray(1); v[1] = 40; return x + "|" + v[1] + "|" + v.length + "|" + n + "|" + peek(v); }
function subarray_loop(v: Int32Array<ArrayBuffer>): string { let n = 0; let sum = v[0]!; kept = v.subarray(1); for (let i = 1; i < v.length; i++) { sum += v[i]!; v[i] = i; } return sum + "|" + peek(v); }
