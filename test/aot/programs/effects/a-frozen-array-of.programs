//// a-split-that-nobody-reads-still-converts-and-throws.js
// split at a string whose result nobody reads, or reads in part, with every kind of receiver, separator and limit: what throws, and in which order the conversions run
const out = [];
const log = [];
const receivers = [() => "a,b", () => "", () => null, () => undefined, () => 5, () => ({ toString() { log.push("r"); return "x,y"; } }), () => ({ toString() { throw new RangeError("r"); } }), () => Symbol("s"), () => ["p", "q"], () => new String("m,n")];
const separators = [() => ",", () => "", () => undefined, () => null, () => ({ toString() { log.push("s"); return ","; } }), () => ({ toString() { throw new EvalError("s"); } }), () => Symbol("t"), () => ({ [Symbol.split]() { log.push("@"); return ["z"]; } }), () => 1];
const limits = [undefined, 0, 1, -1, { valueOf() { log.push("l"); return 1; } }, { valueOf() { throw new URIError("l"); } }];
function unused(r, s) { r.split(s); return "done"; }
function unusedLimit(r, s, l) { r.split(s, l); return "done"; }
function first(r, s) { return r.split(s)[0]; }
function count(r, s) { return r.split(s).length; }
function inLoop(r, s) { let n = 0; for (let i = 0; i < 3; i++) { r.split(s); n++; } return n; }
function behindTest(r, s, l) { if (l) r.split(s); return "done"; }
function called(r, s) { String.prototype.split.call(r, s); return "done"; }
function typed(r, s) { if (typeof r !== "string" || typeof s !== "string") return "skip"; r.split(s); return "done"; }
function order(r, s) { let x = 0; try { x = 1; r.split(s); x = 2; } catch { return "caught at " + x; } return "x " + x; }
for (const f of [unused, first, count, inLoop, called, typed, order]) for (const [i, r] of receivers.entries()) for (const [j, s] of separators.entries()) {
  log.length = 0; let a; try { a = f(r(), s()); } catch (e) { a = "throws " + e.name; } out.push(`${f.name} ${i} ${j} ${String(a)} [${log.join("")}]`);
}
for (const f of [unusedLimit, behindTest]) for (const [i, r] of receivers.entries()) for (const [j, s] of separators.entries()) for (const [k, l] of limits.entries()) {
  log.length = 0; let a; try { a = f(r(), s(), l); } catch (e) { a = "throws " + e.name; } out.push(`${f.name} ${i} ${j} ${k} ${String(a)} [${log.join("")}]`);
}
console.log(out.join("\n"));
//// a-test-in-front-of-a-loop-holds-across-a-call-that-stringifies.ts
// `iterated` tests the storage of its array once, in front of the loop, because the call of `show` in the loop runs no code that could change the array: JSON.stringify of a string,
// a number, a plain object or an array of them runs none. The serializer that takes the place of JSON.stringify in `show` may not say more than the call did: it used to read
// "the rest of an array after unknown code" element by element, by name, and the test in front of the loop was then refused by the verifier: the program did not build.
declare const console: { log(...values: unknown[]): void };
function show(value: unknown): string { return typeof value + " " + JSON.stringify(value); }
function attempt(label: string, ...runs: (() => unknown)[]): void {
  console.log(label + ": " + runs.map(run => { try { return show(run()); } catch (error) { return "threw " + (error as Error).name; } }).join(" | "));
}
type NoUndefined<T> = T extends undefined ? never : T;
interface Holder<Output = unknown> { _output: Output }
type Output<T> = T extends { _output: any } ? T["_output"] : never;
type Bound<T> = NoUndefined<Output<T>> | number[] | null;
const text: Holder<string> = { _output: "" };
const point: Holder<{ x: number }> = { _output: { x: 1 } };
function iterated<T extends Holder, V extends Bound<T>>(inner: T, list: V[]): string { let out = ""; for (const each of list) out += show(each); return out; }
function local<T extends Holder, V extends Bound<T>>(inner: T, value: V): string { const copy = value; return show(copy); }
function* yielded<T extends Holder, V extends Bound<T>>(inner: T, value: V): Generator<unknown> { yield value; }
class Keeper<T extends Holder, V extends Bound<T>> { constructor(public inner: T, public value: V) {} text(): string { return show(this.value); } get held(): unknown { return this.value; } }
attempt("iterated", () => iterated(text, ["a", "b"]), () => iterated(point, [{ x: 2 }, { x: 3 }]));
attempt("yielded", () => [...yielded(text, "a")], () => [...yielded(point, { x: 2 })]);
attempt("local", () => local(text, "a"), () => new Keeper(point, { x: 4 }).text());
//// an-array-of-fractions-made-at-run-time-is-read-and-written-around-every-touch.ts
// An array of fractions made at run time is read, touched, and read or written again in one function. Each function is called where the compiler sees the call.
const mark = Symbol("mark"); const weak = new WeakMap<object, number>(); let kept: unknown;
const unseen = new Function("x", "return x") as <T>(x: T) => T;
const peek = new Function("a", "let s = ''; for (let i = 0; i < a.length && i < 12; i++) s += (i in a ? String(a[i]) : '-') + ','; return s + a.length") as (a: unknown) => string;
class Returned { constructor(o: object) { return o; } }
class Stamp extends Returned { #p = 1; #q = 2; #r = 3; #s = 4; #t = 5; static has(o: object): boolean { return #p in o; } }
function withPrototype(prototype: object): Function { function Made(this: any) { this.own = 1; } Made.prototype = prototype; return Made; }
function classOver(prototype: object): unknown { class Derived extends (withPrototype(prototype) as any) {} return new Derived(); }
function generatorWith(prototype: object): unknown { function* g() { yield 1; } g.prototype = prototype; return g(); }
function spreadCount(...all: unknown[]): number { return all.length; }
function attempt(f: () => string): string { try { return f(); } catch (e) { return (e as Error).constructor.name; } }
const which = process.argv[2]; const n1 = process.argv.length > 99 ? 5 : 1; const s1 = process.argv.length > 99 ? "x" : "a";
function storeInside_read(a: number[]): string { let n = 0; const b = a as any; const x = a[0]; b[0] = 7.25; return x + "|" + a[0] + "|" + a[1] + "|" + a[3] + "|" + a.length + "|" + n; }
function storeInside_loop(a: number[]): string { let n = 0; const b = a as any; let s = "" + a[0] + a.length; b[0] = 7.25; for (let i = 0; i < a.length && i < 12; i++) s += "," + a[i]; return s; }
function storeInside_store(a: number[]): string { let n = 0; const b = a as any; const x = a[1]; b[0] = 7.25; a[1] = 7.25; return x + "|" + a[1] + "|" + a.length + "|" + n + "|" + peek(a); }
