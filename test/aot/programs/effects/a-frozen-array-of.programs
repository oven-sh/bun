function sameBufferView_read(v: Int32Array<ArrayBuffer>): string { let n = 0; const x = v[1]; kept = new Uint8Array(v.buffer); return x + "|" + v[1] + "|" + v[15] + "|" + v.length + "|" + n; }
function sameBufferView_store(v: Int32Array<ArrayBuffer>): string { let n = 0; const x = v[1]; kept = new Uint8Array(v.buffer); v[1] = 40; return x + "|" + v[1] + "|" + v.length + "|" + n + "|" + peek(v); }
function sameBufferView_loop(v: Int32Array<ArrayBuffer>): string { let n = 0; let sum = v[0]!; kept = new Uint8Array(v.buffer); for (let i = 1; i < v.length; i++) { sum += v[i]!; v[i] = i; } return sum + "|" + peek(v); }
function copyView_read(v: Int32Array<ArrayBuffer>): string { let n = 0; const x = v[1]; kept = new Uint8Array(v); return x + "|" + v[1] + "|" + v[15] + "|" + v.length + "|" + n; }
function copyView_store(v: Int32Array<ArrayBuffer>): string { let n = 0; const x = v[1]; kept = new Uint8Array(v); v[1] = 40; return x + "|" + v[1] + "|" + v.length + "|" + n + "|" + peek(v); }
function copyView_loop(v: Int32Array<ArrayBuffer>): string { let n = 0; let sum = v[0]!; kept = new Uint8Array(v); for (let i = 1; i < v.length; i++) { sum += v[i]!; v[i] = i; } return sum + "|" + peek(v); }
