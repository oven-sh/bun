//// constructors-found-through-an-operand.js
// A built-in that makes its result with a constructor it finds through an operand (`constructor`, @@species, `this` of a static method) runs code of the program: each line goes wrong if a read of a counter moves across the call.
let constructed = 0;
class Counted extends Array {
  constructor(...values) {
    super(...values);
    constructed++;
  }
}
function arrayMethods() {
  const list = Counted.from([1, 2, 3]);
  constructed = 0;
  list.map(value => value);
  const afterMap = constructed;
  list.filter(() => true);
  const afterFilter = constructed;
  list.slice(1);
  const afterSlice = constructed;
  list.concat([4]);
  return [afterMap, afterFilter, afterSlice, constructed];
}
function staticMethods() {
  constructed = 0;
  Counted.of(1, 2);
  const afterOf = constructed;
  Array.from.call(Counted, [1]);
  return [afterOf, constructed];
}
let promises = 0;
class CountedPromise extends Promise {
  constructor(executor) {
    super(executor);
    promises++;
  }
}
function promiseMethods() {
  const promise = CountedPromise.resolve(1);
  promises = 0;
  promise.then(() => {});
  const afterThen = promises;
  promise.finally(() => {});
  const afterFinally = promises;
  CountedPromise.all([]);
  return [afterThen, afterFinally > afterThen, promises > afterFinally];
}
let looked = 0;
const withConstructorGetter = Object.defineProperty([1, 2], "constructor", {
  get() {
    looked++;
    return Array;
  },
});
function constructorGetter() {
  looked = 0;
  withConstructorGetter.map(value => value);
  return looked;
}
console.log(arrayMethods(), staticMethods(), promiseMethods(), constructorGetter());
//// delete-between-reads.ts
// delete between two reads: same object, aliased objects, inherited names, a prototype object, a frozen object.
class Point { x?: number; y?: number; constructor(x: number, y: number) { this.x = x; this.y = y } }
class Named { name?: string; constructor(name: string) { this.name = name } }
(Named.prototype as any).name = "from the prototype";

function sameObject(p: Point): string { const before = p.x; delete p.x; return `${before} ${p.x} ${"x" in p} ${p.y}` }
function maybeSameObject(p: Point, q: Point): string { const before = q.x; delete p.x; return `${before} ${q.x} ${"x" in q}` }
function otherName(p: Point): string { const before = p.y; delete p.x; return `${before} ${p.y} ${Object.keys(p).join()}` }
function revealsPrototype(n: Named): string { const before = n.name; delete n.name; return `${before} | ${n.name} | ${Object.hasOwn(n, "name")}` }
function deletesIn(p: Point): boolean { return delete p.x }
function acrossCallee(p: Point, q: Point): string { const before = q.x; const deleted = deletesIn(p); return `${before} ${deleted} ${q.x}` }
function madeHere(n: number): string { const p = new Point(n, n + 1); const before = p.x; delete p.x; p.y = n + 2; return `${before} ${p.x} ${p.y} ${JSON.stringify(p)}` }
function putBack(p: Point, n: number): string { delete p.x; const gone = p.x; p.x = n; return `${gone} ${p.x} ${Object.keys(p).join()}` }
function frozen(p: Point): string { "use strict"; try { delete p.x; return `deleted ${p.x}` } catch (error) { return `${(error as Error).constructor.name} ${p.x}` } }

const base: { shared?: number; own?: number } = { shared: 1 };
const heir: { shared?: number; own?: number } = Object.create(base);
function throughHeir(b: { shared?: number }, h: { shared?: number }): string { const before = h.shared; delete b.shared; return `${before} ${h.shared} ${"shared" in h}` }

for (let round = 0; round < 3; round++) {
  const a = new Point(round, 10), b = new Point(round + 1, 20);
  console.log(sameObject(new Point(round, 5)), "|", maybeSameObject(a, a), "|", maybeSameObject(new Point(1, 2), b), "|", otherName(new Point(3, round)));
  console.log(revealsPrototype(new Named("own " + round)), "|", acrossCallee(b, b), "|", acrossCallee(new Point(7, 8), new Point(round, 9)), "|", madeHere(round), "|", putBack(new Point(1, 2), round));
  console.log(frozen(Object.freeze(new Point(round, 1))), "|", frozen(new Point(round, 1)));
  base.shared = round;
  console.log(throughHeir(base, heir), "|", throughHeir(heir, heir));
}
//// entry-module-writes-across-unknown-calls.ts
// A closed program: variables written by user code that only a built-in or the host calls (a getter printed by console.log, toString, valueOf, callbacks of forEach and sort, a microtask), read around the call that runs it.
// Six more variables are written by the entry module's call tree alone.
let top1 = 0, top2 = 0, top3 = 0, top4 = 0, top5 = 0, top6 = 0;
let byGetter = 0, byToString = 0, byValueOf = 0, byCallback = 0, bySort = 0, byMicrotask = 0;

function bumpTopLevel(xs: number[]) { for (let i = 0; i < xs.length; i++) { top1 += xs[i]; top2 += xs[i]; top3 += xs[i]; top4 += xs[i]; top5 += xs[i]; top6 += xs[i]; } }
function topLevelSum() { return top1 + top2 + top3 + top4 + top5 + top6; }

const withGetter = { get shown() { byGetter++; return 1; } };
const withToString = { toString() { byToString++; return "text"; } };
const withValueOf = { valueOf() { byValueOf++; return 2; } };

function aroundPrint(o: object) { const t = topLevelSum(), g = byGetter; console.log(o); return [topLevelSum() - t, byGetter - g].join(); }
function aroundConcat(o: object) { const t = topLevelSum(), s = byToString; const text = "" + o; return [text, topLevelSum() - t, byToString - s].join(); }
function aroundMultiply(o: any) { const t = topLevelSum(), v = byValueOf; const product = o * 3; return [product, topLevelSum() - t, byValueOf - v].join(); }
function aroundForEach(xs: number[]) { const t = topLevelSum(), c = byCallback; xs.forEach(x => { byCallback += x; }); return [topLevelSum() - t, byCallback - c].join(); }
function aroundSort(xs: number[]) { const t = topLevelSum(), s = bySort; xs.sort((a, b) => { bySort++; return a - b; }); return [topLevelSum() - t, bySort - s].join(); }
async function aroundAwait() { const t = topLevelSum(), m = byMicrotask; queueMicrotask(() => { byMicrotask++; }); await null; await null; return [topLevelSum() - t, byMicrotask - m].join(); }

for (let round = 0; round < 3; round++) {
  bumpTopLevel([1, 2, round]);
  console.log(aroundPrint(withGetter), aroundPrint({ round }), aroundConcat(withToString), aroundMultiply(withValueOf), aroundForEach([1, round]), aroundSort([3, 1, 2]));
}
aroundAwait().then(text => {
  console.log(text);
  console.log(topLevelSum(), byGetter, byToString, byValueOf, byCallback, bySort, byMicrotask);
});
bumpTopLevel([100]);
//// field-read-across-object-spread.js
function Box(v) {
  this.v = v;
}

function bump(b) {
  b.v = b.v + 1;
}

let last = null;

function readsAcrossNothing(b, p) {
  const x = b.v;
  last = p;
  return x + b.v;
}

function readsAcrossSpread(b, p) {
  const x = b.v;
  last = { ...p };
  return x + b.v;
}

function readsAcrossGetterLiteral(b, k) {
  const x = b.v;
  last = {
    get twice() {
      return k * 2;
    },
  };
  return x + b.v;
}

let total = 0;
const p = { x: 1, y: 2 };
for (let i = 0; i < 1000; i++) {
  const b = new Box(i);
  bump(b);
  total += readsAcrossNothing(b, p) + readsAcrossSpread(b, p) + readsAcrossGetterLiteral(b, i);
}
console.log(total, typeof last);
//// for-of-step-runs-getter.ts
// A step of a for..of loop over an array runs a getter that the loop body put there, and the getter changes an object the loop reads.
class Scale {
    factor: number | string = 2
}

type Change = (values: (number | undefined)[], scale: Scale) => void

function replaceFactor(scale: Scale, factor: string): void {
    const untyped = scale as any
    delete untyped.factor
    untyped.other = 1
    untyped.factor = factor
}

function walk(values: (number | undefined)[], scale: Scale, change: Change): string {
    const seen: unknown[] = []
    for (const value of values) {
        seen.push(scale.factor, value)
        change(values, scale)
        seen.push(scale.factor)
    }
    return seen.join()
}

const defineElementGetter: Change = (values, scale) => {
    if (Object.getOwnPropertyDescriptor(values, 2)?.get) return
    Object.defineProperty(values, 2, {
        get() {
            replaceFactor(scale, "own getter")
            return 30
        },
    })
}

const changePrototype: Change = (values, scale) => {
    if (Object.getPrototypeOf(values) !== Array.prototype) return
    Object.setPrototypeOf(values, {
        __proto__: Array.prototype,
        get 1() {
            replaceFactor(scale, "inherited getter")
            return 20
        },
    })
}

console.log(walk([10, 20, 3], new Scale(), () => {}))
console.log(walk([10, 20, 3], new Scale(), defineElementGetter))
console.log(walk([10, , 30], new Scale(), changePrototype))
console.log(walk([10, 20, 3], new Scale(), () => {}))
//// fresh-key-lists-handed-on-in-another-round.ts
// A list of keys is made anew in each round of a loop. What an earlier round did with its list (handed it to a Set, kept it) says nothing about the list of this round, whose tests hold across calls of unknown code; a list that is changed in its own round is read as changed.
function isDisjoint(...headers: (Record<string, unknown> | undefined)[]): boolean {
  const sources = headers.filter(Boolean) as Record<string, unknown>[];
  if (sources.length === 0 || sources.length === 1) return true;
  let acc: Set<string> | undefined;
  for (const header of sources) {
    const parameters = Object.keys(header);
    if (!acc || acc.size === 0) { acc = new Set(parameters); continue; }
    for (const parameter of parameters) {
      if (acc.has(parameter)) return false;
      acc.add(parameter);
    }
  }
  return true;
}

const kept: string[][] = [];
let seen = "";
let visitKey = (key: string): void => { seen += key; };
function visitAll(objects: Record<string, unknown>[]): number {
  for (const object of objects) {
    const keys = Object.keys(object);
    for (const key of keys) visitKey(key);
    kept.push(keys);
  }
  return kept.length;
}
function shrinksItsOwnList(objects: Record<string, unknown>[]): string {
  let text = "";
  for (const object of objects) {
    const keys = Object.keys(object);
    kept.push(keys);
    for (let i = 0; i < keys.length; i++) { text += keys[i] + ","; visitKey(keys[i]!); }
  }
  return text;
}

