//// stores-by-a-callback-of-unknown-type.js
// A callback reaches a built-in through a value the compiler cannot type. What the callback stores is read again after the call.
let seen = "not yet";
let count = 0;
function replacer(key, value) { seen = "replacer ran"; count++; return value; }
function compare(a, b) { seen = "compare ran"; count++; return a - b; }
function visit(value) { seen = "visit ran " + value; count++; }
const box = { replacer, compare, visit };
const list = [replacer, compare, visit];

function mergedWithUnknown(o) {
  const callback = globalThis.other ? globalThis.other : replacer;
  const before = seen, countBefore = count;
  JSON.stringify(o, callback);
  return [before, seen, count - countBefore];
}
function readByUnknownKey(o, key) {
  const before = seen, countBefore = count;
  JSON.stringify(o, box[key]);
  return [before, seen, count - countBefore];
}
function readFromList(xs, index) {
  const before = seen, countBefore = count;
  xs.sort(list[index]);
  return [before, seen, count - countBefore];
}
function passedThroughUnknownCode(xs) {
  const callback = JSON.parse("[0]").map(() => visit)[0];
  const before = seen, countBefore = count;
  xs.forEach(callback);
  return [before, seen, count - countBefore];
}
function inSpreadList(o, key) {
  const args = [o, box[key]];
  const before = seen, countBefore = count;
  JSON.stringify(...args);
  return [before, seen, count - countBefore];
}
function byApply(o, key) {
  const before = seen, countBefore = count;
  JSON.stringify.apply(null, [o, box[key]]);
  return [before, seen, count - countBefore];
}
function forwarded() {
  const before = seen, countBefore = count;
  JSON.stringify.apply(null, arguments);
  return [before, seen, count - countBefore];
}
const key = JSON.parse('"replacer"');
for (const run of [
  () => mergedWithUnknown({ x: 1 }), () => readByUnknownKey({ x: 1 }, key), () => readFromList([3, 1, 2], JSON.parse("1")), () => passedThroughUnknownCode([7]),
  () => inSpreadList({ x: 1 }, key), () => byApply({ x: 1 }, key), () => forwarded({ x: 1 }, replacer),
]) {
  seen = "not yet";
  console.log(JSON.stringify(run()));
}
//// stores-by-bound-functions-called-as-methods.ts
// A bound function passes its own `this` and its own first arguments, whatever the call passes. What the target stores into them is seen by the caller, also where the call has a `this` of its own (a method call, a call of an element of a table) or arguments of its own
type Step = (value: number) => number;
type Cell = { n: number };

function add(this: Cell, value: number): number { this.n += value; return this.n }
function addTwice(this: Cell, value: number): number { this.n += 2 * value; return this.n }

function boundThisBesideTable(rounds: number): number {
  const target = { n: 0 };
  const table: Step[] = [add.bind(target), addTwice.bind(target)];
  for (let i = 0; i < rounds; i++) table[i & 1](1);
  return target.n;
}

function boundThisReadInTheLoop(rounds: number): number {
  const target = { n: 0 };
  const table: Step[] = [add.bind(target), addTwice.bind(target)];
  let seen = 0;
  for (let i = 0; i < rounds; i++) { table[i & 1](1); seen += target.n }
  return seen;
}

function boundThisBesideHolder(rounds: number): number {
  const target = { n: 1 };
  const holder = { n: 100, run: add.bind(target) as Step, other: addTwice.bind(target) as Step };
  let seen = 0;
  for (let i = 0; i < rounds; i++) { if (i & 1) holder.run(1); else holder.other(1); seen += target.n + holder.n }
  return seen;
}

function store(into: Cell, value: number): number { into.n = value; return value }
function storeNegative(into: Cell, value: number): number { into.n = -value; return value }
function boundArgument(rounds: number): number {
  const kept = { n: 0 };
  const table: Step[] = [store.bind(null, kept), storeNegative.bind(null, kept), store.bind(null, kept)];
  let sum = 0;
  for (let i = 0; i < rounds; i++) { table[i % 3](i); sum += kept.n }
  return sum;
}

type Fill = (other: Cell) => number;
function fill(first: Cell, second: Cell): number { first.n += 1; return second.n }
function fillTwice(first: Cell, second: Cell): number { first.n += 2; return second.n + 1 }
function boundArgumentBesideArgument(rounds: number): number {
  const first = { n: 0 }, passed = { n: 50 };
  const table: Fill[] = [fill.bind(null, first), fillTwice.bind(null, first)];
  let sum = 0;
  for (let i = 0; i < rounds; i++) { sum += table[i & 1](passed); sum += first.n + passed.n }
  return sum;
}

function lengthOf(this: number[], value: number): number { return value + this.length }
function dropLast(this: number[], value: number): number { this.length = this.length - 1; return value }
function storeFraction(this: number[], value: number): number { if (value + 1 < this.length) this[value + 1] = 0.5; return value }
function storeFarBehind(this: number[], value: number): number { if (this.length < 12) this[11] = value; return value }
function boundArray(change: (this: number[], value: number) => number): string {
  const list = [1, 2, 3, 4, 5, 6, 7, 8];
  const table: Step[] = [lengthOf.bind(list), change.bind(list)];
  let sum = 0;
  for (let i = 0; i < list.length; i++) sum += (list[i] ?? 100) + table[i & 1](i);
  return sum + " " + list.join();
}

class Counter { n = 0; increment: () => void; constructor() { this.increment = this.step.bind(this) } step(): void { this.n++ } }
class Button { n = 1000; onClick: () => void; constructor(onClick: () => void) { this.onClick = onClick } }
function handlers(rounds: number): number {
  const counter = new Counter();
  const button = new Button(counter.increment);
  let seen = 0;
  for (let i = 0; i < rounds; i++) { button.onClick(); seen += counter.n }
  return seen + button.n;
}

for (let round = 0; round < 3; round++) {
  console.log("this beside a table", boundThisBesideTable(10 + round), boundThisReadInTheLoop(10 + round));
  console.log("this beside a holder", boundThisBesideHolder(10 + round));
  console.log("argument", boundArgument(10 + round), boundArgumentBesideArgument(10 + round));
  console.log("array", boundArray(lengthOf), "|", boundArray(dropLast), "|", boundArray(storeFraction), "|", boundArray(storeFarBehind));
  console.log("handlers", handlers(10 + round));
}
//// sync-iteration-steps-write-variables.ts
// Every way a sync iteration runs user code: each kind of code writes a variable of its own, which the function with the loop, pattern or spread reads before and after the step.
let byOpen = 0, byNext = 0, byReturn = 0, byDoneGetter = 0, byValueGetter = 0, byGenerator = 0, byGeneratorEnd = 0, byGeneratorFinally = 0, byThrow = 0;

class Countdown {
  constructor(public from: number) {}
  [Symbol.iterator]() {
    byOpen++;
    let left = this.from;
    return {
      next: () => { byNext++; return left > 0 ? { done: false, value: left-- } : { done: true, value: 0 }; },
      return: () => { byReturn++; return { done: true, value: 0 }; },
    };
  }
}

class ResultWithGetters {
  [Symbol.iterator]() {
    let step = 0;
    return { next() { step++; return { get done() { byDoneGetter++; return step > 2; }, get value() { byValueGetter++; return step; } }; } };
  }
}

function* generate(n: number) { try { for (let i = 0; i < n; i++) { byGenerator++; yield i; } byGeneratorEnd++; } finally { byGeneratorFinally++; } }
function* delegate(n: number) { const before = byGenerator; yield* generate(n); yield byGenerator - before; }
function* catching() { try { yield 1; yield 2; } catch { byThrow++; yield 3; } }

function forOf(xs: Countdown) { const o = byOpen, n = byNext; let seen = 0; for (const x of xs) seen += (byNext - n) * x; return [byOpen - o, byNext - n, seen]; }
function forOfBreak(xs: Countdown) { const n = byNext, r = byReturn; for (const x of xs) { if (x < 3) break; } return [byNext - n, byReturn - r]; }
function forOfThrow(xs: Countdown) { const r = byReturn; try { for (const x of xs) { if (x < 3) throw x; } } catch {} return [byReturn - r]; }
function resultGetters(xs: ResultWithGetters) { const d = byDoneGetter, v = byValueGetter; let seen = 0; for (const x of xs) seen += (byDoneGetter - d) + (byValueGetter - v) + x; return [byDoneGetter - d, byValueGetter - v, seen]; }
function generator(n: number) { const g = byGenerator, e = byGeneratorEnd, f = byGeneratorFinally; let seen = 0; for (const x of generate(n)) seen += (byGenerator - g) + x; return [byGenerator - g, byGeneratorEnd - e, byGeneratorFinally - f, seen]; }
function generatorBreak(n: number) { const e = byGeneratorEnd, f = byGeneratorFinally; for (const x of generate(n)) { if (x === 1) break; } return [byGeneratorEnd - e, byGeneratorFinally - f]; }
function pattern(xs: Iterable<number>) { const o = byOpen, n = byNext, r = byReturn; const [a, b] = xs; return [a, b, byOpen - o, byNext - n, byReturn - r]; }
function patternWithRest(xs: Iterable<number>) { const g = byGenerator, e = byGeneratorEnd; const [a, ...rest] = xs; return [a, rest.length, byGenerator - g, byGeneratorEnd - e]; }
function spreadCall(xs: Iterable<number>) { const n = byNext; const max = Math.max(...xs); return [max, byNext - n]; }
function spreadLiteral(xs: Iterable<number>) { const g = byGenerator; const copy = [...xs]; return [copy.length, byGenerator - g]; }
function either(xs: Iterable<number>) { const n = byNext; let seen = 0; for (const x of xs) seen += (byNext - n) + x; return [byNext - n, seen]; }
function manualThrow() { const t = byThrow; const it = catching(); it.next(); const step = it.throw(new Error("x")); return [step.value, byThrow - t]; }

const log: string[] = [];
for (let round = 0; round < 3; round++) {
  log.push(
    forOf(new Countdown(round + 2)).join(), forOfBreak(new Countdown(5)).join(), forOfThrow(new Countdown(4)).join(), resultGetters(new ResultWithGetters()).join(),
    generator(round + 1).join(), generatorBreak(3).join(), pattern(new Countdown(4)).join(), pattern([round, 2]).join(), patternWithRest(generate(3)).join(),
    spreadCall(new Countdown(3)).join(), spreadLiteral(generate(2)).join(), either(round & 1 ? [1, 2] : new Countdown(2)).join(), either(new Set([round, 9])).join(),
    [...delegate(2)].join(), manualThrow().join(),
  );
}
console.log(log.join("\n"));
console.log(byOpen, byNext, byReturn, byDoneGetter, byValueGetter, byGenerator, byGeneratorEnd, byGeneratorFinally, byThrow);

function makeScope() {
  let captured = 0;
  const iterable = { [Symbol.iterator]() { let i = 0; return { next() { captured += 2; return { done: i++ > 1, value: i }; } }; } };
  function walk() { const before = captured; let seen = 0; for (const x of iterable) seen += (captured - before) * x; return [seen, captured - before]; }
  function destructure() { const before = captured; const [a] = iterable; return [a, captured - before]; }
  return () => walk().concat(destructure()).join();
}
const scopeA = makeScope(), scopeB = makeScope();
console.log(scopeA(), scopeB(), scopeA());
//// syntax-and-builtins-close-the-iterator.js
// A loop that is left early, a pattern that takes fewer values than there are and a built-in that fails in the middle of an iterable call `return` of the iterator: each line goes wrong if a read of a counter moves across that call.
let steps = 0;
let closes = 0;
////= iterable	3, value: [steps, steps]
function leaveLoop() {
  steps = 0;
  closes = 0;
  for (const value of iterable) {
    if (value[0] === 2) break;
  }
  return [steps, closes];
}
function pattern() {
  steps = 0;
  closes = 0;
  const [first] = iterable;
  return [first[0], steps, closes];
}
function spread() {
  steps = 0;
  closes = 0;
  const values = [...iterable];
  return [values.length, steps, closes];
}
function arrayFrom() {
  steps = 0;
  closes = 0;
  let failed = false;
  try {
    Array.from(iterable, value => {
      if (value[0] === 2) throw new Error("stop");
      return value;
    });
  } catch {
    failed = true;
  }
  return [failed, steps, closes];
}
function collections() {
  steps = 0;
  closes = 0;
  const map = new Map(iterable);
  const afterMap = steps;
  steps = 0;
  const set = new Set(iterable);
  return [map.size, afterMap, set.size, steps, closes];
}
function fromEntries() {
  steps = 0;
  const object = Object.fromEntries(iterable);
  return [Object.keys(object).length, steps];
}
function* delegate() {
  yield* iterable;
}
function closeDelegate() {
  const generator = delegate();
  steps = 0;
  closes = 0;
  generator.next();
  const afterStep = steps;
  generator.return();
  return [afterStep, closes];
}
console.log(leaveLoop(), pattern(), spread());
console.log(arrayFrom(), collections(), fromEntries(), closeDelegate());
//// tests-of-arrays-across-calls-by-value.ts
// A test of an array that is placed in front of a loop holds across the calls by value in the loop where every callee is known and leaves the array alone: bound functions out of a table, closures out of a table, a callback, methods of many classes, getters, a callback inside forEach. Where a callee really changes the array, through `this`, an argument, a captured variable or a variable of the module, the loop sees the change
type Step = (value: number) => number;

const counter = { n: 0 };
function add(this: { n: number }, value: number): number { this.n += value; return value + 1 }
function subtract(this: { n: number }, value: number): number { this.n -= value; return value - 1 }
const bound: Step[] = [add.bind(counter), subtract.bind(counter), add.bind(counter)];
function boundOutOfTable(rounds: number): number { let sum = 0; for (let i = 0; i < rounds; i++) sum += bound[i % 3](i); return sum }

const steps: Step[] = [v => v + 1, v => v * 2, v => v - 3, v => v % 7, v => -v, v => v * v, v => v >> 1, v => v ^ 5];
function closuresInOrder(start: number): number { let value = start; for (const step of steps) value = step(value); return value }
function closuresByIndex(values: number[]): number { let sum = 0; for (let i = 0; i < values.length; i++) sum += steps[i & 7](values[i]) + values[i]; return sum }
function callback(values: number[], step: Step): number { let sum = 0; for (let i = 0; i < values.length; i++) sum += step(values[i]) + values.length; return sum }
function callbackInsideForEach(values: number[], step: Step): number { let different = 0; values.forEach((value, index) => { if (step(index) !== value) different++ }); return different }

interface Reader { read(): number }
class One implements Reader { read(): number { return 1 } }
class Two implements Reader { k = 2; read(): number { return this.k } }
class Three implements Reader { a = 1; b = 2; read(): number { return this.a + this.b } }
class Four implements Reader { text = "four"; read(): number { return this.text.length } }
class Five implements Reader { list = [1, 2, 2]; read(): number { return this.list[0] + this.list[1] + this.list[2] } }
class Six implements Reader { inner = new Three(); read(): number { return this.inner.read() * 2 } }
class Seven implements Reader { seed: number; read: () => number; constructor(seed: number) { this.seed = seed; this.read = () => this.seed } }
function methodsOfManyClasses(readers: Reader[]): number { let sum = 0; for (let k = 0; k < readers.length; k++) sum += readers[k].read(); return sum }

class Celsius { degrees: number; constructor(degrees: number) { this.degrees = degrees } get text(): string { return this.degrees + "C" } }
class Kelvin { degrees: number; constructor(degrees: number) { this.degrees = degrees } get text(): string { return this.degrees + 273 + "K" } }
class Unknown { get text(): string { return "?" } }
function getters(list: Array<Celsius | Kelvin | Unknown>): number { let n = 0; for (let round = 0; round < 30; round++) n += list[(round * 7) % list.length].text.length; return n }

let shared: Array<number | string> = [];
const quiet: Step[] = [v => v, v => v + 1, v => v + 2, v => v + 3, v => v + 4, v => v + 5];
const shrinking: Step[] = [v => v, v => v + 1, v => { shared.length = 3; return v }, v => v + 3, v => v + 4, v => v + 5];
const storingText: Step[] = [v => v, v => { shared[3] = "text"; return v }, v => v + 2, v => v + 3, v => v + 4, v => v + 5];
const storingFraction: Step[] = [v => { shared[2] = 2.5; return v }, v => v + 1, v => v + 2, v => v + 3, v => v + 4, v => v + 5];
const growing: Step[] = [v => v, v => v + 1, v => v + 2, v => v + 3, v => { if (shared.length < 8) shared[7] = 7; return v }, v => v + 5];
function variableOfTheModule(list: Array<number | string>, table: Step[]): string { let text = ""; for (let i = 0; i < list.length; i++) text += list[i] + ":" + table[i % table.length](i) + " "; return text }

type Entry = (this: Entry[], index: number) => number;
function keeps(this: Entry[], index: number): number { return index }
function counts(this: Entry[], index: number): number { return this.length + index }
function doubles(this: Entry[], index: number): number { return index * 2 }
function truncates(this: Entry[], index: number): number { this.length = index + 1; return -1 }
function tableAsThis(table: Entry[]): number { let sum = 0; for (let i = 0; i < table.length; i++) sum += table[i](i); return sum }

type Visitor = (list: number[], index: number) => number;
const visitors: Visitor[] = [
  (list, i) => list[i],
  (list, i) => list[i] * 2,
  (list, i) => { if (i + 1 < list.length) list[i + 1] = 0.5; return list[i] },
  (list, i) => { if (list.length > i + 2) list.length = i + 2; return 1 },
  (list, i) => list.length,
  (list, i) => { if (list.length < 7) list.push(i); return i },
];
function arrayAsArgument(list: number[], visitor: Visitor): number { let sum = 0; for (let i = 0; i < list.length; i++) sum += visitor(list, i) + list[i]; return sum }

function capturedArray(): string {
  const local: Array<number | string> = [1, 2, 3, 4, 5, 6];
  const table: Step[] = [v => v, v => v + 1, v => { local[3] = "x"; return v }, v => v * 2, v => { local.length = 5; return v }, v => v + 7];
  let text = "";
  for (let i = 0; i < local.length; i++) text += local[i] + ":" + table[i](i) + " ";
  return text;
}

for (let round = 0; round < 3; round++) {
  counter.n = round;
  console.log("bound", boundOutOfTable(1000 + round), counter.n);
  console.log("closures in order", closuresInOrder(round + 3));
  console.log("closures by index", closuresByIndex([1, 2, 3, 4, 5, 6, 7, 8, 9, round]));
  let all = 0; for (const step of steps) all += callback([1, 2, 3, round], step); console.log("callback", all);
  let different = 0; for (const step of steps) different += callbackInsideForEach([1, 2, -1, round], step); console.log("callback inside forEach", different);
  console.log("methods", methodsOfManyClasses([new One(), new Two(), new Three(), new Four(), new Five(), new Six(), new Seven(round)]));
  console.log("getters", getters([new Celsius(round), new Kelvin(round), new Unknown(), new Celsius(100), new Kelvin(-300)]));
  for (const table of [quiet, shrinking, storingText, storingFraction, growing]) { shared = [1, 2, 3, 4, 5, 6]; console.log("variable of the module", variableOfTheModule(shared, table), shared.length) }
  console.log("table as this", tableAsThis([keeps, counts, doubles, keeps, counts, doubles]), tableAsThis([keeps, counts, doubles, truncates, counts, doubles]));
  for (const visitor of visitors) { const list = [1, 2, 3, 4, 5]; console.log("array as argument", arrayAsArgument(list, visitor), list.join()) }
  console.log("captured", capturedArray());
}
//// tests-of-arrays-across-serializers-parsers-and-chains.ts
// A test of an array that is placed in front of a loop holds across a compiled serializer, a compiled parser and a chain of array methods, in the loop itself and in a function that the loop calls; where code of the program really changes the array in between, the loop sees the change.
// STATISTIC: SerializersCreated >= 2
// STATISTIC: ParsersCreated >= 1
class Link { x: number; next: Link | null; constructor(depth: number) { this.x = depth; this.next = depth ? new Link(depth - 1) : null } }
class Tree { value: number; name: string; children: Tree[]; constructor(depth: number) { this.value = depth; this.name = "n" + depth; this.children = depth ? [new Tree(depth - 1), new Tree(depth - 1)] : [] } }
interface Point { x: number; y: number; label?: string }
interface Segment { id: number; from: Point; to: Point; tags: string[] }

function lengthsOfLinks(list: Link[]): number { let n = 0; for (let i = 0; i < list.length; i++) n += JSON.stringify(list[i]).length + list[i].x; return n }
function lengthsOfTrees(list: Tree[]): number { let n = 0; for (let i = 0; i < list.length; i++) { const text = JSON.stringify(list[i]); n += text.length + list[i].value + list.length } return n }
function sameObjectAfterwards(link: Link): number { const before = link.x; const text = JSON.stringify(link); return before + text.length + link.x + (link.next ? link.next.x : 0) }

function parsedInTheLoop(texts: string[]): number { let n = 0; for (let round = 0; round < 3; round++) for (let i = 0; i < texts.length; i++) n += (JSON.parse(texts[i]) as Segment).to.x + texts[i].length; return n }
function parsedByCallback(texts: string[], parse: (text: string) => Segment): number { let n = 0; for (let round = 0; round < 3; round++) for (const text of texts) n += parse(text).tags.length + parse(text).id; return n }
const segment = (text: string) => JSON.parse(text) as Segment;
const segmentWithoutType = (text: string): any => globalThis.JSON.parse(text);

function chainInTheLoop(list: number[], text: string): number { let n = 0; for (let i = 0; i < list.length; i++) n += list[i] + text.split("").slice(0, -1).join("").length; return n }
const ways: Array<(s: string) => string> = [s => s, s => "#" + s, s => s + "#", s => s.slice(1), s => s.slice(0, -1), s => s + s, s => s.split("").slice(0, -1).join(""), s => s.split("").slice(1).join("-")];
function chainInTheCallee(list: number[], make: (s: string) => string, text: string): number { let n = 0; for (let i = 0; i < list.length; i++) n += list[i] + make(text).length; return n }

let shared: Array<number | string> = [];
class Shrinks { k: number; constructor(k: number) { this.k = k } toJSON() { shared.length = 1; shared[0] = 1.5; return this.k } }
function serializerChangesTheArray(list: Array<number | string>, value: Shrinks): string { let text = ""; for (let i = 0; i < list.length; i++) { text += list[i] + ","; text += JSON.stringify(value).length + ";" } return text }
function withGetter(k: number) { return { k, get g() { shared.length = 2; shared[1] = "s"; return k } } }
function getterChangesTheArray(list: Array<number | string>, value: { k: number; g: number }): string { let text = ""; for (let i = 0; i < list.length; i++) { text += list[i] + ","; text += JSON.stringify(value).length + ";" } return text }
function callbackChangesTheArray(list: Array<number | string>, other: number[]): string { let text = ""; for (let i = 0; i < list.length; i++) text += list[i] + "," + other.map(x => { list.length = 2; list[1] = "s"; return x + 1 }).filter(x => x > 2).length + ";"; return text }
function reviverChangesTheArray(list: Array<number | string>, source: string): string { let text = ""; for (let i = 0; i < list.length; i++) { text += list[i] + ","; text += globalThis.JSON.parse(source, (key, member) => { list.length = 1; return member }).a + ";" } return text }

const texts = ['{"id":1,"from":{"x":1,"y":2},"to":{"x":3,"y":4},"tags":[]}', '{"tags":["a","b"],"to":{"y":4,"x":5,"label":"l"},"from":{"x":1,"y":2},"id":2}', '{"id":3,"from":{"x":1,"y":2},"to":{"x":7,"y":4},"tags":["c"],"more":[1,2,{"deep":[3]}]}'];
for (let round = 0; round < 3; round++) {
  console.log("links", lengthsOfLinks([new Link(0), new Link(1), new Link(round + 2)]));
  console.log("trees", lengthsOfTrees([new Tree(0), new Tree(1), new Tree(round)]));
  console.log("same object", sameObjectAfterwards(new Link(round)));
  console.log("parsed in the loop", parsedInTheLoop(texts));
  console.log("parsed by a callback", parsedByCallback(texts, segment), parsedByCallback(texts, segmentWithoutType));
  console.log("chain in the loop", chainInTheLoop([1, 2, 3], "abcdef".slice(round)));
  let all = 0; for (const make of ways) all += chainInTheCallee([1, 2, 3], make, "abcdef".slice(round)); console.log("chain in the callee", all);
  shared = [1, 2, 3]; console.log("toJSON", serializerChangesTheArray(shared, new Shrinks(round)), shared.length, shared[0]);
  shared = [1, 2, 3]; console.log("getter", getterChangesTheArray(shared, withGetter(round)), shared.length, shared[1]);
  shared = [1, 2, 3]; console.log("callback", callbackChangesTheArray(shared, [1, 2, 3, 4]), shared.length, shared[1]);
  shared = [1, 2, 3]; console.log("reviver", reviverChangesTheArray(shared, '{"a":' + round + '}'), shared.length);
}
