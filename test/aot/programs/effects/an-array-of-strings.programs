// One small function per built-in function, so that the compiler's summary of each function's side effects covers that built-in alone.
const m = new Map<unknown, number>([[1, 10], ["a", 20]])
const nums = new Map<number, number>([[1, 10]])
const list = [3, 1, 2]
const bytes = new Uint8Array(4)
const D = Date, U8 = Uint8Array
const fns: Record<string, (...args: any[]) => unknown> = {
  slice: (s: string, n: number) => s.slice(n | 0),
  slice2: (s: string, a: number, b: number) => s.slice(a | 0, b | 0),
  sliceDouble: (s: string, n: number) => s.slice(n),
  substring: (s: string, n: number) => s.substring(n | 0),
  charCodeAt: (s: string, n: number) => s.charCodeAt(n | 0),
  length: (s: string) => s.length,
  indexOf: (s: string, t: string) => s.indexOf(t),
  toUpperCase: (s: string) => s.toUpperCase(),
  trim: (s: string) => s.trim(),
  startsWith: (s: string, t: string) => s.startsWith(t),
  mapGet: (k: unknown) => m.get(k),
  mapHas: (k: unknown) => m.has(k),
  mapSize: () => m.size,
  numGet: (k: number) => nums.get(k),
  numHas: (k: number) => nums.has(k),
  floor: (x: number) => Math.floor(x),
  floorAny: (x: any) => Math.floor(x),
  max3: (a: number, b: number, c: number) => Math.max(a, b, c),
  max2: (a: number, b: number) => Math.max(a, b),
  sin: (x: number) => Math.sin(x),
  pow: (a: number, b: number) => Math.pow(a, b),
  imul: (a: number, b: number) => Math.imul(a, b),
  isNaN: (x: number) => isNaN(x),
  isNaNAny: (x: any) => isNaN(x),
  isInteger: (x: unknown) => Number.isInteger(x),
  number: (x: any) => Number(x),
  isArray: (x: unknown) => Array.isArray(x),
  arrayLength: () => list.length,
  bytesLength: () => bytes.length,
  includes: (x: number) => list.includes(x),
  join: () => list.join("-"),
  arrayOf: (a: number, b: number) => Array.of(a, b).length,
  newArray: (n: number) => new Array(n | 0).length,
  newMap: () => new Map().size,
  toFixed: (x: number) => x.toFixed(2),
  parseInt: (s: string) => parseInt(s, 10),
  keys: (o: object) => Object.keys(o).length,
  literal: (s: string) => (s as "a" | "b"),
  big: () => 12345678901234567890n,
  known: () => [Math, JSON].length,
  knownMethod: () => typeof Array.prototype.slice,
  knownReturned: () => Reflect,
  knownVariable: () => typeof D.now(),
  knownInArray: () => [U8].length,
}
const args: Record<string, unknown[]> = {
  slice: ["hello", 2], slice2: ["hello", 1, 3], sliceDouble: ["hello", 1.5], substring: ["hello", 3], charCodeAt: ["hello" + "!", 5], length: ["hello"],
  indexOf: ["hello", "l"], toUpperCase: ["hello"], trim: ["  x "], startsWith: ["hello", "he"], mapGet: ["a"], mapHas: [1], mapSize: [], numGet: [1], numHas: [2],
  floor: [2.5], floorAny: ["3.7"], max3: [1, 5, 3], max2: [1, 5], sin: [0], pow: [2, 10], imul: [3, 4], isNaN: [NaN], isNaNAny: ["x"], isInteger: [3], number: ["12"],
  isArray: [[1]], arrayLength: [], bytesLength: [], includes: [2], join: [], arrayOf: [1, 2], newArray: [3], newMap: [], toFixed: [1.005], parseInt: ["42px"],
  keys: [{ a: 1, b: 2 }], literal: ["a"], big: [], known: [], knownMethod: [], knownReturned: [], knownVariable: [], knownInArray: [],
}
