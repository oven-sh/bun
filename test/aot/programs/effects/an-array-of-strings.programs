// `for await` over an iterable that is not async, and `yield*` in an async generator, step and close the underlying iterator through %AsyncFromSyncIteratorPrototype%: each line goes wrong if a read of a counter moves across an await.
let steps = 0;
let closes = 0;
////= iterable	3, value: steps
async function leaveLoop() {
  steps = 0;
  closes = 0;
  for await (const value of iterable) {
    if (value === 2) break;
  }
  return [steps, closes];
}
async function finishLoop() {
  steps = 0;
  closes = 0;
  let sum = 0;
  for await (const value of iterable) sum += value;
  return [sum, steps, closes];
}
async function* delegate() {
  yield* iterable;
}
async function closeDelegate() {
  const generator = delegate();
  steps = 0;
  closes = 0;
  await generator.next();
  const afterStep = steps;
  await generator.return();
  return [afterStep, closes];
}
async function fromAsync() {
  steps = 0;
  const values = await Array.fromAsync(iterable);
  return [values.length, steps];
}
console.log(await leaveLoop(), await finishLoop(), await closeDelegate(), await fromAsync());
//// built-in-writes-to-arrays-and-collections-that-may-alias.ts
// Reads of one array around built-in writes to an array that may or may not be the same one.
function appendWhileReading(source: number[], target: number[], limit: number): number {
  let total = 0;
  for (let i = 0; i < source.length && i < limit; i++) {
    total += source[i];
    target.push(source[i] + 0.5);
    total += source[i] + source.length;
  }
  return total;
}

function popWhileReading(source: number[], target: number[]): number {
  let total = 0;
  for (let i = 0; i < source.length; i++) {
    total += source[i];
    target.pop();
    total += source.length;
  }
  return total;
}

interface Holder { list: (number | string)[] }

function changeStorageThroughHolder(list: (number | string)[], holder: Holder): string {
  let text = "";
  for (let i = 0; i < 3; i++) {
    text += list[0];
    holder.list.push("s" + i);
    text += list[list.length - 1];
    holder.list.unshift(i);
    text += list[0];
  }
  return text;
}

function fill(values: number[], extra: number): number[] {
  values.push(extra);
  return values;
}

function lengthAroundCall(values: number[]): number {
  const before = values.length + values[0];
  const other = fill(values, 7);
  return before * 100 + values.length * 10 + other.length + values[values.length - 1];
}

function spliceWhileReading(source: number[], target: number[]): number {
  let total = 0;
  for (let i = 0; i < source.length; i++) {
    total += source[i];
    target.splice(0, 1);
    total += source.length * 1000;
  }
  return total;
}

function mapsAndSets(first: Map<string, number>, second: Map<string, number>, seen: Set<number>, other: Set<number>): number {
  let total = 0;
  for (let i = 0; i < 4; i++) {
    total += first.size + (first.get("k" + i) ?? 0);
    second.set("k" + (i + 1), i);
    total += first.size + (first.get("k" + (i + 1)) ?? 0);
    total += seen.has(i) ? 1 : 0;
    other.add(i);
    total += seen.has(i) ? 10 : 0;
    other.delete(i - 1);
    total += seen.size * 100;
  }
  return total;
}

for (let round = 0; round < 300; round++) {
  const same = [1, 2, 3];
  const left = [1, 2, 3];
  const right = [4, 5, 6];
  const mixed: (number | string)[] = [1, 2];
  const map = new Map<string, number>();
  const set = new Set<number>();
  const lines = [
    appendWhileReading(same, same, 6),
    appendWhileReading(left, right, 6),
    popWhileReading([1, 2, 3, 4, 5, 6], [9, 9, 9]),
    (() => { const shared = [1, 2, 3, 4, 5, 6]; return popWhileReading(shared, shared); })(),
    changeStorageThroughHolder(mixed, { list: mixed }),
    changeStorageThroughHolder([5, 6], { list: [7] }),
    lengthAroundCall([3, 4]),
    (() => { const shared = [1, 2, 3, 4, 5, 6]; return spliceWhileReading(shared, shared); })(),
    spliceWhileReading([1, 2, 3], [4, 5, 6]),
    mapsAndSets(map, map, set, set),
    mapsAndSets(new Map(), new Map(), new Set(), new Set()),
  ];
  if (round === 0 || round === 299) console.log(lines.join(" | "));
}
//// built-ins-iterate-over-arrays-that-run-code.js
// Built-ins that iterate: plain arrays, maps and sets next to arrays whose iteration or elements run code of the program.
const log = [];
function plain(values) {
  const before = values.length;
  const set = new Set(values);
  return before + set.size + values.length;
}
////= lines-4	withOwnIterator	values[Symbol.iterator] = function* () { log.push("own iterator"); values.push(4); yield 9; }
class Doubled extends Array {
  *[Symbol.iterator]() { log.push("subclass iterator"); for (let i = 0; i < this.length; i++) yield this[i] * 2; }
}
function withSubclass() {
  const values = Doubled.from([1, 2, 3]);
  return [...new Set(values)].join();
}
////= lines-4	withGetter	Object.defineProperty(values, 1, { get() { log.push("getter"); values.length = 2; return 7; } })
function entriesWithGetters() {
  const counter = { reads: 0 };
  const pair = { get 0() { counter.reads++; return "k"; }, get 1() { counter.reads++; return "v"; } };
  const before = counter.reads;
  const map = new Map([pair]);
  return before * 100 + counter.reads * 10 + map.size;
}
function fromCollections() {
  const set = new Set([1, 2, 3]);
  const map = new Map([["a", 1], ["b", 2]]);
  return new Set(set).size + new Map(map).size + Array.from(set).length + Array.from(map.keys()).length + Object.keys(Object.fromEntries(map)).length;
}
function unusedResults(values) {
  new Set(values);
  new Map([[values, values]]);
  return values.length;
}
for (let round = 0; round < 300; round++) {
  const line = [plain([1, 2, 2, 3]), withOwnIterator(), withSubclass(), withGetter(), entriesWithGetters(), fromCollections(), unusedResults([1, 2])].join(" | ");
  if (round === 0 || round === 299) console.log(line, log.length);
}
