  reExec(i, k) { const m = /(k)(\d)(x)?/.exec(k + "z"); return [m[0], m[2], m[3], m[9], m.index, m.input, m.length, m.groups]; },
  reExecNull(i, k) { const m = /q/.exec(k); return m === null ? "null" : m[0]; },
  reExecNullRead(i, k) { const m = /k1/.exec(k); return m[0]; },
  reExecG(i, k) { const r = /k/g; const m = r.exec(k + k); const n = r.exec(k + k); return [m.index, n.index, r.lastIndex]; },
  reExecUnused(i, k) { const r = /k/g; r.exec(k); return r.lastIndex; },
  reExecNamed(i, k) { const m = /(?<d>\d)/.exec(k); return [m.groups.d, Object.keys(m).join()]; },
  reMatch(i, k) { const m = k.match(/(\d)/); return [m[1], m.index, m.length]; },
  reMatchG(i, k) { const m = (k + k).match(/\d/g); return [m.length, m.index]; },
  reMatchNull(i, k) { const m = k.match(/z/); return m ? 1 : 0; },
  desc(i) { const d = Object.getOwnPropertyDescriptor({ a: i }, "a"); return [d.value, d.writable, d.get, Object.keys(d).join(), "get" in d]; },
  descGet(i) { const d = Object.getOwnPropertyDescriptor({ get a() { return i; } }, "a"); return [typeof d.get, d.value, d.set, Object.keys(d).join(), "value" in d]; },
  descNone(i) { const d = Object.getOwnPropertyDescriptor({}, "a"); return d === undefined; },
  descNoneRead(i) { return Object.getOwnPropertyDescriptor({}, "a").value; },
  descReflect(i) { const d = Reflect.getOwnPropertyDescriptor([i], "length"); return [d.value, d.enumerable, d.writable]; },
  descReflectBad(i) { return Reflect.getOwnPropertyDescriptor(i, "a"); },
  descWrite(i) { const d = Object.getOwnPropertyDescriptor({ a: i }, "a"); d.value = 9; d.extra = 1; return JSON.stringify(d); },
  splice(i) { const l = [1, 2, 3, 4]; const r = l.splice(1, 2); return [r[0], r.length, r[5], l.join()]; },
  spliceUnused(i) { const l = [1, 2, 3, 4]; l.splice(i, 1); return l.join(); },
  spliceNeg(i) { const l = [1, 2, 3, 4]; const r = l.splice(-i, 9, "x"); return [r.length, r[0], l.join()]; },
  spliceNone(i) { const l = [1, 2]; const r = l.splice(); return [r.length, l.length]; },
};
for (const k of Object.keys(T)) show(k, T[k]);
console.log(out.join("\n"));
//// typed-array-of-is-called-on-what-is-no-constructor.js
// %TypedArray%.of and Int8Array.of called on what is no constructor throw a TypeError; on another typed array constructor they make one of its kind.
const TypedArray = Object.getPrototypeOf(Int8Array);
const m = { m() {} }.m;
try { TypedArray.of.call(m, []); console.log("no throw"); } catch (e) { console.log("threw", e instanceof TypeError, String(e).slice(0, 60)); }
try { Int8Array.of.call(m, 1, 2); console.log("no throw"); } catch (e) { console.log("threw", e instanceof TypeError); }
try { console.log(Int8Array.of.call(Uint8Array, 1, 300).join()); } catch (e) { console.log("threw", String(e)); }
//// what-a-helper-does-behind-a-failed-check.ts
// A typed helper gets a value that its types forbid, through `any`, in the middle of its body. From there on it does what JavaScript does with that value: it calls a method, runs a setter or a trap
// that keeps the helper's argument and writes to it. The caller made the argument and reads it behind the call, so what it believes of the helper has to cover that too.
////= Reader

let keptPoint: any = null;
////= impostor

let current: any = new Reader();
function currentReader(): Reader {
  return current;
}

let sink = 0;
function spin(rounds: number): void {
  for (let i = 0; i < rounds; i++) sink = (sink * 31 + i) | 0;
}

function visit(point: { x: number; z: number; list: number[] }, rounds: number): void {
  spin(rounds);
  const reader = currentReader();
  reader.read(point);
}

function callsVisit(): number {
  const point = { x: 1, z: 2, list: [1, 2, 3] };
  visit(point, 3);
  return point.x + point.z + point.list.length;
}

type Target = { last: unknown };
const targets: any[] = [{ last: 0 }];
let keptList: any = null;
let keptMake: any = null;

////= store-2

let total = 0;
for (let i = 0; i < 2000; i++) total += callsVisit() + callsStore(i & 7);
console.log("as typed", total, current.total);

current = impostor;
console.log("a method of another object", callsVisit(), callsVisit());
runOverTheStack(50);
console.log("kept", keptPoint.x, keptPoint.z, keptPoint.list.join("|"));

targets.push({
  set last(value: any) {
    keep(value);
  },
});
console.log("a setter", callsStore(1), callsStore(2));
runOverTheStack(50);
console.log("kept", keptMake(), keptList.join("|"));

////= targets-push
console.log("a trap", callsStore(3), callsStore(4));
runOverTheStack(50);
console.log("kept", keptMake(), keptList.join("|"));

const made: any = JSON.parse("{}");
Object.defineProperty(made, ["l", "a", "s", "t"].join(""), {
  set(value: any) {
    keep(value);
  },
});
targets.push(made);
console.log("a setter under a key that is put together", callsStore(5), callsStore(6));
runOverTheStack(50);
console.log("kept", keptMake(), keptList.join("|"));
