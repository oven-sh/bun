////: Reader
class Reader {
  total = 0;
  read(point: { x: number; z: number; list: number[] }): void {
    this.total += point.x;
  }
}
////: callsStore
function callsStore(n: number): number {
  const list = [n, n + 1];
  const make = () => n * 2 + list.length;
  const first = store(list, make, 2);
  return first + list[0] + list.length + make();
}
