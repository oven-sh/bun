//// columns-behind-characters-that-are-not-ascii.js
// The column of a frame counts UTF-16 units from the start of its line, whatever characters are in front of it.
function place(error) {
  return /(\d+:\d+)\)?$/.exec(error.stack.split("\n")[1])[1];
}
const rows = [];
rows.push(["nothing in front", place(new Error())]);
/* é */ rows.push(["two bytes", place(new Error())]);
/* 字 */ rows.push(["three bytes", place(new Error())]);
/* 😀 */ rows.push(["four bytes", place(new Error())]);
/* aé字😀éb */ rows.push(["one of each", place(new Error())]);
rows.push(["behind a string", "字字字".length, place(new Error("字"))]); rows.push(["the second on its line", place(new Error())]);
/* 字 */ function thrower() { /* 字 */ throw new RangeError("字"); }
try { /* éé */ thrower(); } catch (error) { rows.push(["two frames", error.stack.split("\n").slice(1, 3).map(line => /(\d+:\d+)\)?$/.exec(line)[1]).join(" ")]); }
/* a line separator   */ rows.push(["behind a line separator", place(new Error())]);
/* 字 and a paragraph separator   字 */ rows.push(["behind a paragraph separator", place(new Error())]);
rows.push(["the line behind them", place(new Error())]);
const text = `字
字${place(new Error())}`;
rows.push(["in a template over two lines", text.split("\n")[1].slice(1)]);
for (const row of rows) console.log(row.join(" | "));
//// errors-and-their-subclasses-bring-nothing-of-the-library.js
// The compiler knows what a new error holds: `message` and `stack` are texts, `line` is a number, and a class that extends Error stays the program's own. So nothing of Bun's library comes in for them.
// STATISTIC: ImageFunctionsEmitted <= 40
class Refused extends Error {
  describe() { return `${this.name}: ${this.message.length}`; }
}
const refused = new Refused("no");
console.log(refused.describe(), refused.stack.length > 0, refused.line > 0, new TypeError("kind").message.toUpperCase(), new Error("plain").stack.split("\n")[0]);
//// errors-that-the-run-time-makes-are-caught-and-changed.js
// Each catch clause gets an error that the run time has made for an operation that failed by itself. The program reads it, stores into it, gives it another prototype and keeps it.
////= Body
const world = [new Body(1), new Body(2)];
const seen = [];
const kept = [];
const nothing = process.argv.length > 99 ? world[0] : undefined;
const noFunction = process.argv.length > 99 ? world[0].weight : 7;

function describe(error) {
  return [
    typeof error,
    error instanceof Error,
    error.constructor.name,
    error.name,
    typeof error.message,
    typeof error.stack,
    error.mass,
    Object.keys(error).length,
  ].join(",");
}

try {
  nothing.mass;
} catch (error) {
  kept.push(error);
  seen.push(describe(error), error instanceof TypeError);
}
try {
  noFunction();
} catch (error) {
  kept.push(error);
  seen.push(describe(error), error === kept[0]);
}
try {
  seen.push(tooEarly);
  let tooEarly = 1;
} catch (error) {
  seen.push(describe(error), error instanceof ReferenceError);
}
try {
  1n + (process.argv.length > 99 ? 1n : 1);
} catch (error) {
  seen.push(describe(error));
}
try {
  new Array(process.argv.length > 99 ? 1 : -1);
} catch (error) {
  seen.push(describe(error), error instanceof RangeError);
}
try {
  JSON.parse(process.argv.length > 99 ? "1" : "{");
} catch (error) {
  seen.push(describe(error), error instanceof SyntaxError);
}
function forever(depth) {
  return forever(depth + 1) + 1;
}
try {
  forever(0);
} catch (error) {
  error.mass = 5;
  error.message = world[1];
  seen.push(error instanceof RangeError, error.mass, error.message.weight(), Object.keys(error).join("+"));
}
try {
  nothing.mass;
} catch (error) {
  Object.setPrototypeOf(error, Body.prototype);
  error.mass = 21;
  seen.push(error instanceof Error, error instanceof Body, error.weight());
  world.push(error);
}
TypeError.prototype.weight = function () {
  return "heavy " + this.name;
};
Object.defineProperty(TypeError.prototype, "mass", {
  get() {
    return 40;
  },
  configurable: true,
});
try {
  nothing.mass;
} catch (error) {
  seen.push(error.weight(), error.mass, kept[0].mass, kept[1].weight());
}
let total = 0;
for (const body of world) total += body.weight();
seen.push(total);
console.log(seen.join(" "));
