console.log([1, 2.5, 1e6].map(numbers.format).join(" "), opaque(numbers).format(7), opaque(texts).compare("x", "x"));
//// a-read-through-super-under-a-null-prototype-quotes-the-expression.js
// `super.width` where the prototype of the home object is null: the message quotes the expression, which is `super.` and the name of the member.
const home = {
  __proto__: null,
  read() { return super.width; },
  readTwice() { return [super.height, super.height]; },
  readInTry() { try { return super.depth; } catch (error) { return "caught " + error.message; } },
};
class Base {}
class Derived extends Base {
  static read() { return super.length; }
}
Object.setPrototypeOf(Derived, null);
for (let round = 0; round < 3; round++) {
  for (const run of [() => home.read(), () => home.readTwice(), () => home.readInTry(), () => Derived.read()]) {
    try {
      console.log(String(run()));
    } catch (error) {
      console.log(error.constructor.name + ": " + error.message);
    }
  }
}
//// a-trace-names-the-array-method-that-called-the-callback.ts
// A trace that is taken in the callback of one array method names the method between the callback and the function that called it. `flatMap` ends in a tail call and is not named.
type Site = { getFunctionName(): string | null; isNative(): boolean };
(Error as any).prepareStackTrace = (_error: Error, sites: Site[]) =>
  sites.map(site => (site.getFunctionName() ?? "(none)") + (site.isNative() ? "[native]" : "")).join(" < ");
Error.stackTraceLimit = 12;
let captured = "";
function capture(): void {
  captured = String(new Error("x").stack);
}
function mapToNothing(): void {
  [1].map(() => capture());
}
function mapToNumbers(): number {
  return [1, 2].map(value => (capture(), value + 1))[0];
}
function mapToTexts(): string {
  return ["a"].map(value => (capture(), value + "b"))[0];
}
function forEach(): void {
  [1].forEach(() => capture());
}
function filter(): void {
  [1].filter(() => (capture(), true));
}
function flatMap(): void {
  [1].flatMap(() => (capture(), [1]));
}
function mapAsTheLastCall(): number[] {
  return [1].map(value => (capture(), value));
}
const makers = [mapToNothing, mapToNumbers, mapToTexts, forEach, filter, flatMap, mapAsTheLastCall];
for (let round = 0; round < 3; round++) {
  for (const make of makers) {
    make();
    if (round === 2) console.log(make.name, ":", captured);
  }
}
//// an-error-inside-a-spread-says-which-item.js
// An error that is thrown while a spread is evaluated says where: each item of a literal, a call or a construction stands on a line of its own, so the line tells the items apart.
function framesOf(error) {
  return String(error.stack)
    .split("\n")
    .filter(line => line.includes("says-which-item"))
    .map(line => line.trim().replace(/^at /, "").replace(/\(?[^ (]*says-which-item\.js/, "").replace(/\)$/, ""))
    .join(" < ");
}

function report(name, run) {
  try {
    run();
    console.log(name, "did not throw");
  } catch (error) {
    console.log(name, "|", error.constructor.name, "|", error.message, "|", framesOf(error));
  }
}

function failingAt(step) {
  return {
    [Symbol.iterator]() {
      let count = 0;
      return {
        next() {
          if (++count > step) throw new RangeError("step " + count);
          return { done: false, value: count };
        },
      };
    },
  };
}

const withGetter = {
  get broken() {
    throw new EvalError("getter");
  },
};

function take(...all) {
  return all.length;
}

class Point {
  constructor(...all) {
    this.count = all.length;
  }
}

class Above extends Point {
  constructor(first, second) {
    super(
      ...first,
      ...second,
    );
  }
}

const good = [1, 2, 3];
const values = [undefined, null, 1, {}, failingAt(0), failingAt(2)];

for (let round = 0; round < 3; round++) {
  for (const bad of values) {
    const name = bad === undefined ? "undefined" : bad === null ? "null" : typeof bad === "number" ? "number" : Symbol.iterator in bad ? "iterator" : "object";
    report("array second " + name, () => [
      ...good,
      ...bad,
      ...good,
    ]);
    report("array third " + name, () => [
      ...good,
      0,
      ...good,
      ...bad,
    ]);
    report("call first " + name, () =>
      take(
        ...bad,
        ...good,
      ),
    );
    report("call second " + name, () =>
      take(
        ...good,
        ...bad,
      ),
    );
    report("method second " + name, () =>
      Math.max(
        ...good,
        ...bad,
      ),
    );
    report("new second " + name, () =>
      new Point(
        ...good,
        ...bad,
      ),
    );
    report("super second " + name, () => new Above(good, bad));
    report("super first " + name, () => new Above(bad, good));
  }
  report("object second", () => ({
    ...good,
    ...withGetter,
    last: 1,
  }));
  report("object third", () => ({
    first: 1,
    ...{ a: 1 },
    ...withGetter,
  }));
}

// The same inside a small function that a caller takes in, and inside a try of the caller.
function joined(a, b) {
  return [
    ...a,
    ...b,
  ];
}

function outer(a, b) {
  let total = 0;
  for (let i = 0; i < 4; i++) {
    try {
      total += joined(
        a,
        i === 3 ? b : a,
      ).length;
    } catch (error) {
      console.log("inlined |", error.constructor.name, "|", error.message, "|", framesOf(error));
    }
  }
  return total;
}

for (const bad of values) console.log(outer(good, bad));
//// classes-that-extend-error.js
// Classes of the program that extend Error and its kinds: their own fields, methods, getters and statics, what they inherit, and what the engine puts on their instances.
const say = (...values) => console.log(...values);

class Empty extends Error {}
const empty = new Empty("nothing of its own");
say(empty.message.length, empty.name, empty instanceof Empty, empty instanceof Error, empty.constructor === Empty, empty.stack.split("\n")[0], String(empty));
say(Object.getPrototypeOf(empty) === Empty.prototype, Object.getPrototypeOf(Empty) === Error, Object.getOwnPropertyNames(empty).sort().join());

class HttpError extends Error {
  static count = 0;
  #secret = "kept";
  status;
  constructor(status, message, options) {
    super(message, options);
    this.status = status;
    this.name = "HttpError";
    HttpError.count++;
  }
  get isServerError() { return this.status >= 500; }
  describe() { return `${this.name} ${this.status}: ${this.message} (${this.#secret})`; }
  toJSON() { return { status: this.status, message: this.message }; }
}
const failed = new HttpError(503, "unavailable", { cause: empty });
say(failed.describe(), failed.isServerError, failed.status + 1, failed.cause === empty, failed.cause.message.length, HttpError.count, JSON.stringify(failed));
say(String(failed), failed.stack.startsWith("HttpError: unavailable") || failed.stack.startsWith("Error: unavailable"), failed.line > 0);

class NotFound extends HttpError {
  constructor(path) { super(404, `no ${path}`); this.path = path; }
  describe() { return `${super.describe()} at ${this.path}`; }
}
const missing = new NotFound("/x");
say(missing.describe(), missing instanceof NotFound, missing instanceof HttpError, missing instanceof Error, missing.isServerError, HttpError.count);

class Typed extends TypeError {
  get message() { return "the getter of the class is hidden by the own property"; }
}
say(new Typed("own").message, new Typed().message, new Typed("own") instanceof TypeError, new Typed("x").name);

// Thrown, caught, thrown on, and told apart.
function fail(kind) {
  if (kind === 0) throw new NotFound("/thrown");
  if (kind === 1) throw new HttpError(500, "thrown");
  if (kind === 2) throw new RangeError("of the language");
  throw new Empty("last");
}
for (let kind = 0; kind < 4; kind++) {
  try {
    fail(kind);
  } catch (error) {
    if (error instanceof NotFound) say("NotFound", error.path.length, error.describe());
    else if (error instanceof HttpError) say("HttpError", error.status, error.describe());
    else if (error instanceof RangeError) say("RangeError", error.message.length);
    else say("other", error.constructor.name, error.message.toUpperCase());
  }
}

// new.target decides the prototype, and a function that is no class extends Error too.
const reflected = Reflect.construct(Error, ["reflected"], NotFound);
say(reflected instanceof NotFound, reflected.message.length, reflected.path, reflected.status);
function Old(message) {
  const self = Reflect.construct(Error, [message], new.target ?? Old);
  self.old = true;
  return self;
}
Object.setPrototypeOf(Old.prototype, Error.prototype);
Object.setPrototypeOf(Old, Error);
