//// a-number-that-fits-no-int32-slot-is-added-to-a-record-on-a-condition.ts
// A record gets an optional number field on a condition. Most values are small integers; some are not. The object is read in place, handed on, listed and serialized.
type Reply = { ok: boolean; error?: string; value?: number };

function inPlace(i: number): number {
  const reply: Reply = { ok: (i & 1) === 0 };
  if (reply.ok) reply.value = i;
  else reply.error = "odd";
  return (reply.value ?? 0) + (reply.error?.length ?? 0);
}

function handedOn(i: number, keep: Reply[]): Reply {
  const reply: Reply = { ok: (i & 1) === 0 };
  if (reply.ok) reply.value = i;
  else reply.error = "odd";
  if (i > 4294967296) keep.push(reply);
  return reply;
}

function twoAdded(i: number, scale: number): string {
  const reply: Reply = { ok: true };
  reply.error = "first";
  reply.value = i * scale;
  return Object.keys(reply).join() + ":" + JSON.stringify(reply) + ":" + ("value" in reply) + ":" + typeof reply.value;
}

function addedThenStoredAgain(i: number, scale: number): number {
  const reply: Reply = { ok: true };
  reply.value = i * scale;
  reply.value = (reply.value ?? 0) + 1;
  return reply.value;
}

function addedThenDeleted(i: number, scale: number): string {
  const reply: Reply = { ok: true };
  reply.value = i * scale;
  delete reply.value;
  reply.error = "later";
  if (i & 1) reply.value = i * scale;
  return Object.keys(reply).join() + ":" + String(reply.value);
}

const numbers = [0, 1, 2, 3, 2147483646, 2147483647, 2147483648, 4294967298, -2147483643, -2147483644, -2147483648, -2147483650, 9007199254740992, 0.5, -0, NaN, Infinity];
const keep: Reply[] = [];
for (let round = 0; round < 3; round++) {
  for (const n of numbers) {
    const reply = handedOn(n, keep);
    console.log(inPlace(n), JSON.stringify(reply), Object.keys(reply).join(), Object.is(reply.value, n), twoAdded(n, 1), twoAdded(n, 1.5), addedThenStoredAgain(n, 2), addedThenDeleted(n, 3));
  }
}
console.log(keep.length, JSON.stringify(keep));
let sum = 0;
for (let i = 2147483000; i < 2147484400; i++) sum += inPlace(i);
console.log(sum);
//// a-parameter-gets-into-what-the-function-made-through-a-callee-and-is-written-there.ts
// A caller makes an object, reads it, hands it to a function and reads it again. The function makes an object, a scope, a list or a map of its own; a callee, a getter, a trap or a conversion puts
// the parameter there, or keeps it elsewhere; another callee then writes to the parameter through it. Each callee calls itself, so that it is not taken into its caller.
// The second read sees the write. The output is that of plain Bun.
type Cell = { n: number };
type Box = { held: Cell | undefined };
const lines: string[] = [];

function putInBox(box: Box, cell: Cell, depth: number): void {
  if (depth > 0) return putInBox(box, cell, depth - 1);
  box.held = cell;
}
function bumpInBox(box: Box, depth: number): void {
  if (depth > 0) return bumpInBox(box, depth - 1);
  if (box.held) box.held.n += 1;
}
function throughBox(cell: Cell, depth: number): void {
  if (depth > 0) return throughBox(cell, depth - 1);
  const box: Box = { held: undefined };
  putInBox(box, cell, 1);
  bumpInBox(box, 1);
}

function throughScope(cell: Cell, depth: number): number {
  if (depth > 0) return throughScope(cell, depth - 1);
  let held: Cell | undefined;
  let turns = 0;
  function put(given: Cell, again: number): void {
    if (again > 0) return put(given, again - 1);
    held = given;
  }
  function bump(again: number): void {
