//// conditional-types-inside-containers.ts
// Objects whose type depends on a conditional type are read directly and out of arrays, Maps and tuples.
declare const console: { log(...a: unknown[]): void };
function row(name: string, f: () => unknown): void { let got: unknown; try { got = f(); } catch (e) { got = "threw " + (e as Error).name + " " + (e as Error).message; } console.log(name + ": " + got); }
type Pick3<N> = N extends 3 ? { a: string } : { b: number };
interface Vec<N> { data: Pick3<N>; size: N }
const v: Vec<3> = { data: { a: "x" }, size: 3 };
const w: Vec<4> = { data: { b: 7 }, size: 4 };
row("read directly", () => v.data.a + w.data.b);
const many: Vec<3>[] = [v];
row("out of an array", () => many[0].data.a);
row("out of an array by a loop", () => { let s = ""; for (const one of many) s += one.data.a; return s; });
row("out of an array by a method", () => many.map(one => one.data.a).join() + many.at(0)!.data.a + many.find(one => one.size === 3)!.data.a);
const byName = new Map<string, Vec<3>>([["v", v]]);
row("out of a Map", () => byName.get("v")!.data.a);
row("out of a Map by a loop", () => { let s = ""; for (const [, one] of byName) s += one.data.a; return s; });
const pair: [Vec<3>, 3] = [v, 3];
row("out of a tuple", () => pair[0].data.a + pair[1]);
interface Outer<N> { inner: Vec<N> }
const o: Outer<3> = { inner: v };
row("through another generic of the program", () => o.inner.data.a);
const kept = v;
row("kept in another const", () => kept.data.a);
function hand<N>(it: Vec<N>): Vec<N> { return it; }
row("handed through a generic function", () => hand(v).data.a);
//// conditional-types-over-type-arguments.ts
// Objects whose type depends on a conditional type over a type argument.
declare const console: { log(...a: unknown[]): void };
type Pick3<N> = N extends 3 ? { a: string } : { b: number };
interface Vec<N> { data: Pick3<N>; size: N }
const v: Vec<3> = { data: { a: "x" }, size: 3 };
const w: Vec<4> = { data: { b: 7 }, size: 4 };
function dataOf<N>(it: Vec<N>): Pick3<N> { return it.data; }
console.log(v.data.a, w.data.b, dataOf(v).a, dataOf(w).b);
interface Taker<N extends number> { take: (n: N) => string; last: N }
const t: Taker<1 | 2> = { take: n => (n === 1 ? "one" : "two"), last: 2 };
console.log(t.take(t.last), t.take(1));
type Names = ["zero", "one", "two"];
interface At<N extends 0 | 1 | 2> { name: Names[N] }
const at: At<1> = { name: "one" };
const all: At<0 | 2>[] = [{ name: "zero" }, { name: "two" }];
console.log(at.name, all.map(one => one.name).join());
class Dim<N extends number> { constructor(readonly n: N) {} same(other: Dim<N>) { return other.n === this.n; } }
const d3 = new Dim<3>(3);
console.log(d3.same(new Dim<3>(3)), d3.n);
//// elements-from-narrowed-number.ts
// An array literal in a `switch` case holds the narrowed number; its element is incremented and then read in every way.
declare const console: { log(...a: unknown[]): void };
function row(name: string, f: () => unknown): void { let got: unknown; try { got = f(); } catch (e) { got = "threw " + (e as Error).name + " " + (e as Error).message; } console.log(name + ": " + got); }
function e1(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; return a[0]; } } }
row("read by a constant index", () => e1(1));
function e2(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; const i = a.length - 1; return a[i]; } } }
row("read by a computed index", () => e2(1));
function e3(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; let s = 0; for (const x of a) s += x; return s; } } }
row("for of", () => e3(1));
function e4(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; const [y] = a; return y; } } }
row("a pattern", () => e4(1));
function e5(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; return a.at(0); } } }
row("at", () => e5(1));
function e6(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; return a.pop(); } } }
row("pop", () => e6(1));
function e7(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; return a.map(x => x + 1)[0]; } } }
row("map", () => e7(1));
function e8(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; return [...a][0]; } } }
row("spread", () => e8(1));
function e9(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; let s = 0; a.forEach(x => { s += x; }); return s; } } }
row("forEach", () => e9(1));
function e10(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; return a.reduce((p: number, c) => p + c, 0); } } }
row("reduce", () => e10(1));
function e11(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; const b = a; return b[0]; } } }
row("through another const", () => e11(1));
function first(z: number[]): number { return z[0]; }
function e12(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; return first(a); } } }
row("handed to number[]", () => e12(1));
function e13(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; return a.slice()[0]; } } }
row("slice", () => e13(1));
function e14(k: number) { switch (k) { case 1: { const a = [k]; let [w] = a; w++; return w; } } }
row("a let out of a pattern, incremented", () => e14(1));
function e15(k: number) { switch (k) { case 1: { const o = { a: [k] }; o.a[0]++; return o.a[0]; } } }
row("an array in a literal's property", () => e15(1));
function e16(k: number) { switch (k) { case 1: { const m = [[k]]; m[0][0]++; return m[0][0]; } } }
row("an array in an array", () => e16(1));
function e17(k: number) { switch (k) { case 1: { const a = [k]; const up = () => { a[0]++; }; up(); return a[0] === 1; } } }
row("compared behind a closure", () => e17(1));
//// environment-escapes-on-one-path.ts
// Captured variables escape on one path only: a closure over the variables of a loop is stored when a flag is set. What the function and the stored closure write after that goes to one variable, and the result is the same as with the flag clear.
declare const edenGC: undefined | (() => void);
const collectYoung: () => void = typeof edenGC === "function" ? edenGC : require("bun:jsc").edenGC;

type Box = { value: number };
const saved: ((step: number) => number)[] = [];

function variablesOfOneIteration(turns: number, escapes: boolean): string {
  let out = "";
  for (let turn = 0; turn < turns; turn++) {
    let total = turn;
    let text = "t";
    if (escapes) saved.push(step => { total += step; text += step; return total; });
    total += 100;
    text += "f";
    let afterClosure: number;
    if (escapes) afterClosure = saved[saved.length - 1](7);
    else { total += 7; text += 7; afterClosure = total; }
    total *= 2;
    let afterFunction: number;
    if (escapes) afterFunction = saved[saved.length - 1](0);
    else { text += 0; afterFunction = total; }
    out += afterClosure + ":" + afterFunction + ":" + total + text + ";";
  }
  return out;
}

function variablesOfAllIterations(turns: number, escapes: boolean): string {
  let total = 0;
  let text = "";
  const first = saved.length;
  for (let turn = 0; turn < turns; turn++) {
    if (escapes && turn % 2 === 1) saved.push(step => { total += step; text += "c"; return total; });
    total += 10;
    text += "f";
  }
  for (let k = 0; k < turns >> 1; k++) {
    if (escapes) saved[first + k](k);
    else { total += k; text += "c"; }
    total += 1000;
  }
  return total + text;
}

function objectsAcrossCollections(turns: number, escapes: boolean): number {
  let sum = 0;
  for (let turn = 0; turn < turns; turn++) {
    let box: Box = { value: turn };
    if (escapes) saved.push(step => { const old = box.value; box = { value: old + step }; return old; });
    collectYoung();
    box = { value: box.value + 1 };
    collectYoung();
    if (escapes) sum += saved[saved.length - 1](5);
    else { sum += box.value; box = { value: box.value + 5 }; }
    collectYoung();
    sum += box.value;
  }
  return sum;
}

let differences = 0;
let out = "";
for (let round = 0; round < 600; round++) {
  const turns = round % 7;
  const flag = round % 3 === 0;
  const one = variablesOfOneIteration(turns, flag);
  const all = variablesOfAllIterations(turns, flag);
  if (one !== variablesOfOneIteration(turns, !flag) || all !== variablesOfAllIterations(turns, !flag)) differences++;
  if (round % 97 === 5) out += flag + " " + one + " | " + all + "\n";
  saved.length = 0;
}
for (let round = 0; round < 4; round++) {
  const flag = round % 2 === 0;
  out += flag + " " + objectsAcrossCollections(20, flag) + "\n";
  saved.length = 0;
}
console.log(out + "differences: " + differences);
//// fields-are-deleted-from-objects-that-stay-in-one-function.ts
// `delete` of a named field of an object that never leaves its function, that leaves it later, or that leaves it on one path alone: what is left, in which order, and what the deletion answers.
const lines: string[] = [];
function say(label: string, value: unknown): void {
  lines.push(label + ": " + (typeof value === "string" ? value : JSON.stringify(value)));
}
const kept: object[] = [];
function keep<T extends object>(value: T): T {
  kept.push(value);
  if (kept.length > 8) kept.shift();
  return value;
}

type Message = { id: number; draft?: boolean; text: string };

function neverLeaves(i: number): number {
  const message: Message = { id: i, draft: true, text: "hi" };
  const answer = delete message.draft;
  return message.id + message.text.length + ("draft" in message ? 100 : 0) + (answer ? 1000 : 0) + (message.draft === undefined ? 10000 : 0);
}

function leavesBehindTheDeletion(i: number): Message {
  const message: Message = { id: i, draft: true, text: "hi" };
  delete message.draft;
  return keep(message);
}

function storedAgain(i: number): Message {
  const message: Message = { id: i, draft: true, text: "hi" };
  delete message.draft;
  message.draft = (i & 1) === 0;
  return keep(message);
}

function storedAgainAndNeverLeaves(i: number): string {
  const message: Message = { id: i, draft: true, text: "hi" };
  delete message.draft;
  message.draft = false;
  return Object.keys(message).join() + "|" + message.draft;
}

function deletedOnOnePath(i: number): Message {
  const message: Message = { id: i, draft: true, text: "hi" };
  if (i % 3 === 0) delete message.draft;
  return keep(message);
}

function deletedOnOnePathAndRead(i: number): string {
  const message: Message = { id: i, draft: true, text: "hi" };
  if (i % 3 === 0) delete message.draft;
  return ("draft" in message) + "," + message.draft + "," + Object.keys(message).length + "," + Object.hasOwn(message, "draft");
}

function deletedTwice(i: number): string {
  const message: Message = { id: i, draft: true, text: "hi" };
  const first = delete message.draft;
  const second = delete message.draft;
  return first + "," + second + "," + JSON.stringify(message);
}

function deletedThoughNeverThere(i: number): string {
  const message: Message = { id: i, text: "hi" };
  const answer = delete message.draft;
  return answer + "," + JSON.stringify(message);
}

function deletedInALoop(n: number): string {
  const message: Message = { id: n, draft: true, text: "hi" };
  let seen = 0;
  for (let i = 0; i < n; i++) {
    if ("draft" in message) {
      seen++;
      delete message.draft;
    } else message.draft = i % 2 === 0;
  }
  return seen + "," + JSON.stringify(message);
}

function theFirstKeyGoes(i: number): string {
  const pair: { a?: number; b: number; c: number } = { a: i, b: i + 1, c: i + 2 };
  delete pair.a;
  pair.a = 7;
  return JSON.stringify(keep(pair)) + Object.keys(pair).join("");
}

function everyKeyGoes(i: number): string {
  const pair: { a?: number; b?: number } = { a: i, b: i + 1 };
  delete pair.b;
  delete pair.a;
  return JSON.stringify(pair) + Object.keys(pair).length + ("a" in pair) + ("b" in pair);
}

function theDeletedFieldHeldAnObject(i: number): number {
  const outer: { inner?: { n: number }; m: number } = { inner: { n: i }, m: 2 };
  const inner = outer.inner!;
  delete outer.inner;
  inner.n += 5;
  return inner.n + outer.m + (outer.inner === undefined ? 100 : 0);
}

function theDeletedFieldHeldAnObjectThatLeaves(i: number): string {
  const outer: { inner?: { n: number }; m: number } = { inner: { n: i }, m: 2 };
  const inner = outer.inner!;
  delete outer.inner;
  keep(inner);
  keep(outer);
  return JSON.stringify(inner) + JSON.stringify(outer);
}

const above = { draft: "from above" };
function thePrototypeShowsThrough(i: number): string {
  const message: { id: number; draft?: string } = { id: i, draft: "own" };
  Object.setPrototypeOf(message, above);
  const before = message.draft;
  delete message.draft;
  return before + "," + message.draft + "," + ("draft" in message) + "," + Object.hasOwn(message, "draft");
}

class Point {
  x: number;
  y?: number;
  constructor(x: number, y: number) {
    this.x = x;
    this.y = y;
  }
  sum(): number {
    return this.x + (this.y ?? -1);
  }
}
function aFieldOfAnInstance(i: number): string {
  const point = new Point(i, i + 1);
  const before = point.sum();
  delete point.y;
  return before + "," + point.sum() + "," + Object.keys(point).join();
}
function aFieldOfAnInstanceThatLeaves(i: number): string {
  const point = new Point(i, i + 1);
  delete point.y;
  keep(point);
  return point.sum() + "," + JSON.stringify(point) + "," + (point instanceof Point);
}

function aRequiredFieldByACast(i: number): string {
  const message = { id: i, text: "hi" };
  delete (message as { id?: number }).id;
  return JSON.stringify(keep(message)) + "," + message.id + "," + ("id" in message);
}

function frozenFirst(i: number): string {
  "use strict";
  const message: Message = { id: i, draft: true, text: "hi" };
  Object.freeze(message);
  try {
    delete message.draft;
    return "deleted " + JSON.stringify(message);
  } catch (error) {
    return (error as Error).constructor.name + " " + JSON.stringify(message);
  }
}

function definedAsFixed(i: number): string {
  const message: Message = { id: i, text: "hi" };
  Object.defineProperty(message, "draft", { value: true, configurable: false, enumerable: true, writable: true });
  try {
    const answer = delete message.draft;
    return answer + " " + JSON.stringify(message);
  } catch (error) {
    return (error as Error).constructor.name + " " + JSON.stringify(message);
  }
}

function anAccessorGoes(i: number): string {
  const holder: { n: number; twice?: number } = {
    n: i,
    get twice() {
      return this.n * 2;
    },
  };
  const before = holder.twice;
  const answer = delete holder.twice;
  return before + "," + answer + "," + holder.twice + "," + Object.keys(holder).join();
}

function aMethodGoes(i: number): string {
  const holder: { n: number; twice?(): number } = {
    n: i,
    twice() {
      return this.n * 2;
    },
  };
  const before = holder.twice!();
  delete holder.twice;
  return before + "," + typeof holder.twice + "," + Object.keys(holder).join();
}

function thrownOverTheDeletion(i: number): string {
  const message: Message = { id: i, draft: true, text: "hi" };
  try {
    delete message.draft;
    if (i % 2) throw new Error("odd");
    message.draft = false;
  } catch {
    return "caught " + JSON.stringify(message);
  }
  return "passed " + JSON.stringify(message);
}

function spreadBehindTheDeletion(i: number): string {
  const message: Message = { id: i, draft: true, text: "hi" };
  delete message.draft;
  const copy = { ...message, more: 1 };
  return JSON.stringify(copy) + Object.keys(copy).join();
}

function walkedBehindTheDeletion(i: number): string {
  const message: Message = { id: i, draft: true, text: "hi" };
  delete (message as { text?: string }).text;
  let names = "";
  for (const name in message) names += name + ";";
  return names + Object.entries(message).join("|");
}

for (let round = 0; round < 40; round++) {
  const i = round;
  const all: [string, unknown][] = [
    ["neverLeaves", neverLeaves(i)],
    ["leavesBehindTheDeletion", leavesBehindTheDeletion(i)],
    ["storedAgain", storedAgain(i)],
    ["storedAgain keys", Object.keys(storedAgain(i)).join()],
    ["storedAgainAndNeverLeaves", storedAgainAndNeverLeaves(i)],
    ["deletedOnOnePath", deletedOnOnePath(i)],
    ["deletedOnOnePathAndRead", deletedOnOnePathAndRead(i)],
    ["deletedTwice", deletedTwice(i)],
    ["deletedThoughNeverThere", deletedThoughNeverThere(i)],
    ["deletedInALoop", deletedInALoop(i)],
    ["theFirstKeyGoes", theFirstKeyGoes(i)],
    ["everyKeyGoes", everyKeyGoes(i)],
    ["theDeletedFieldHeldAnObject", theDeletedFieldHeldAnObject(i)],
    ["theDeletedFieldHeldAnObjectThatLeaves", theDeletedFieldHeldAnObjectThatLeaves(i)],
    ["thePrototypeShowsThrough", thePrototypeShowsThrough(i)],
    ["aFieldOfAnInstance", aFieldOfAnInstance(i)],
    ["aFieldOfAnInstanceThatLeaves", aFieldOfAnInstanceThatLeaves(i)],
    ["aRequiredFieldByACast", aRequiredFieldByACast(i)],
    ["frozenFirst", frozenFirst(i)],
    ["definedAsFixed", definedAsFixed(i)],
    ["anAccessorGoes", anAccessorGoes(i)],
    ["aMethodGoes", aMethodGoes(i)],
    ["thrownOverTheDeletion", thrownOverTheDeletion(i)],
    ["spreadBehindTheDeletion", spreadBehindTheDeletion(i)],
    ["walkedBehindTheDeletion", walkedBehindTheDeletion(i)],
  ];
  if (round < 4 || round === 39) for (const [label, value] of all) say(round + " " + label, value);
}
say("kept", kept);
console.log(lines.join("\n"));
//// find-over-an-array-literal-that-a-function-answers-and-every-pass-is-verified.js
// The literals meet behind a call, in a field and in a variable of a loop.
const show = value => JSON.stringify(value, (key, each) => (each === undefined ? "undefined" : each));
function pick(which) {
  if (which === 0) return [5, 6, 7];
  return ["a", "b"];
}
function answeredByAFunction(which) { return pick(which).find(each => each !== 1); }
function pickOrNothing(which) {
  if (which === 0) return [];
  return [1.5, 2.5];
}
function answeredOrNothing(which) { return pickOrNothing(which).find(each => each !== 1); }
class Box {
  list = [5, 6, 7];
}
function inAField(which) {
  const box = new Box();
  if (which) box.list = ["a", "b"];
  return box.list.find(each => each !== 1);
}
function inALoop(turns) {
  const out = [];
  let list = [5, 6, 7];
  for (let turn = 0; turn < turns; turn++) {
    out.push(list.find(each => each !== 1));
    list = turn % 2 ? ["a", "b"] : [1.5];
  }
  return out;
}
function inALoopWithNothing(turns) {
  const out = [];
  let list = [];
  for (let turn = 0; turn < turns; turn++) {
    out.push(list.find(each => each !== 1));
    list = turn % 2 ? [8, 9] : ["c", "d", "e"];
  }
  return out;
}
console.log(show([answeredByAFunction(0), answeredByAFunction(1)]));
console.log(show([answeredOrNothing(0), answeredOrNothing(1)]));
console.log(show([inAField(0), inAField(1)]));
console.log(show(inALoop(5)), show(inALoopWithNothing(5)));
const seen = [];
for (let turn = 0; turn < 3000; turn++) {
  const found = answeredByAFunction(turn % 2);
  if (turn < 4) seen.push(found);
}
console.log(show(seen));
//// find-over-one-of-two-array-literals-and-every-pass-is-verified.js
// Two array literals meet in one value, and find() is left in its first turn: the position of the read is one known integer that is no constant of the text.
const show = value => JSON.stringify(value, (key, each) => (each === undefined ? "undefined" : each));
function integersOrTexts(which) { return (which === 0 ? [5, 6, 7] : ["a", "b"]).find(each => each !== 1); }
function integersOfTwoLengths(which) { return (which === 0 ? [5, 6, 7] : [8, 9]).find(each => each !== 1); }
function integersOfOneLength(which) { return (which === 0 ? [5, 6] : [8, 9]).find(each => each !== 1); }
function fractionOrTexts(which) { return (which === 0 ? [1.5] : ["c", "d", "e"]).find(each => each !== 1); }
function fractionsOfTwoLengths(which) { return (which === 0 ? [1.5, 2.5, 3.5] : [4.5]).find(each => each !== 1); }
function integersOrNothing(which) { return (which === 0 ? [8, 9] : []).find(each => each !== 1); }
function nothingOrTexts(which) { return (which === 0 ? [] : ["c", "d", "e"]).find(each => each !== 1); }
function objects(which) { return (which === 0 ? [{ p: 1 }, { p: 2 }] : [{ p: 3 }]).find(each => each !== 1); }
function oneOfThree(which) { return (which === 0 ? [5, 6, 7] : which === 1 ? ["a", "b"] : [1.5]).find(each => each !== 1); }
function oneOfThreeOrNothing(which) { return (which === 0 ? [] : which === 1 ? [8, 9] : ["c", "d", "e"]).find(each => each !== 1); }
for (const ask of [integersOrTexts, integersOfTwoLengths, integersOfOneLength, fractionOrTexts, fractionsOfTwoLengths, integersOrNothing, nothingOrTexts, objects, oneOfThree, oneOfThreeOrNothing])
  console.log(ask.name, show([ask(0), ask(1), ask(2)]));
//// five-objects-that-leave-on-one-way-are-candidates-for-one-variable.js
// Five small objects. Each is handed out on one rare way of its own, and one of them is picked at the end. None has more than two forms anywhere: made, or not made yet.
// TODO: the build counts 16: STATISTIC: MaxVirtualObjectVariantsHits = 0
const kept = [];
function keep(o) {
  kept.push(o);
  if (kept.length > 4) kept.length = 0;
}
function five(a, b, c, d, e, k) {
  const p = { x: a }, q = { x: b }, r = { x: c }, s = { x: d }, t = { x: e };
  if (a > 1000) keep(p);
  if (b > 1000) keep(q);
  if (c > 1000) keep(r);
  if (d > 1000) keep(s);
  if (e > 1000) keep(t);
  const w = k === 0 ? p : k === 1 ? q : k === 2 ? r : k === 3 ? s : t;
  return w.x + p.x + q.x + r.x + s.x + t.x;
}
let total = 0;
for (let i = 0; i < 30000; i++) total += five(i % 1003, i % 1009, i % 1013, i % 1019, i % 1021, i % 5);
console.log(total, kept.length, kept.map(o => o.x).join());
//// forwarded-results-stack-traces.ts
// A function left through `return f(x)` is absent from the stack trace taken in f, as in plain Bun, also where f returns a fresh object or array in registers and the function hands the parts on.
type Traced = { trace: string; depth: number };
let noise = 0;
function pad(k: number): void { for (let i = 0; i < 3; i++) noise = (noise * 31 + k + i) % 1000003; }
function pads(): void { pad(1); pad(2); pad(3); pad(4); pad(5); pad(6); pad(7); pad(8); pad(9); pad(10); pad(11); pad(12); }
const tracked = /^(traced|forwards|keepsFrame|reads|stores|calls)[A-Za-z]*$/;
function names(stack: string | undefined): string {
  const found: string[] = [];
  for (const line of (stack ?? "").split("\n")) {
    const name = line.trim().replace(/^at /, "").split(/[ @(]/)[0].replace(/^.*\./, "");
    if (tracked.test(name)) found.push(name);
  }
  return found.join(">");
}
class Report {
  traces: string[] = [];
  sum = 0;
  add(trace: string, depth: number): void { if (!this.traces.includes(trace)) this.traces.push(trace); this.sum += depth; }
  toString(): string { return this.traces.join(" | ") + " " + this.sum; }
}

// Small enough to be inlined.
function traced(depth: number): Traced { return { trace: names(new Error("here").stack), depth }; }
function forwards(depth: number): Traced { return traced(depth + 1); }
function forwardsTwice(depth: number): Traced { return forwards(depth + 1); }
function forwardsUnderCast(depth: number): Traced { return traced(depth + 1) as Traced; }
function forwardsAsWiderType(depth: number): { trace: string } { return traced(depth + 1); }

// Too large to be inlined.
function tracedLarge(depth: number): Traced { pads(); pad(1); pad(2); pad(3); pad(4); pad(5); pad(6); return { trace: names(new Error("here").stack), depth }; }
function forwardsLarge(depth: number): Traced { pads(); pad(1); pad(2); pad(3); pad(4); pad(5); pad(6); return tracedLarge(depth + 1); }
function forwardsLargeTwice(depth: number): Traced { pads(); pad(1); pad(2); pad(3); pad(4); pad(5); pad(6); return forwardsLarge(depth + 1); }
function forwardsEither(depth: number): Traced { pads(); pad(1); pad(2); pad(3); pad(4); pad(5); pad(6); if (depth & 1) return traced(depth); return tracedLarge(depth); }
function forwardsOrCreates(depth: number): Traced { pads(); pad(1); pad(2); pad(3); pad(4); pad(5); pad(6); if (depth & 1) return tracedLarge(depth); return { trace: names(new Error("created").stack), depth }; }
function tracedPair(depth: number): [string, number] { pads(); pad(1); pad(2); pad(3); pad(4); pad(5); pad(6); return [names(new Error("here").stack), depth]; }
function forwardsPair(depth: number): [string, number] { pads(); pad(1); pad(2); pad(3); pad(4); pad(5); pad(6); return tracedPair(depth + 1); }

// The callee is a closure or a method.
function createTracer(tag: string): (depth: number) => Traced {
  return function tracedByClosure(depth: number): Traced { return { trace: tag + names(new Error("here").stack), depth }; };
}
const tracer = createTracer("closure ");
function forwardsToClosure(depth: number): Traced { return tracer(depth + 1); }
function forwardsToLocalClosure(depth: number, tag: string): Traced {
  function tracedLocally(inner: number): Traced { return { trace: tag + names(new Error("here").stack), depth: inner }; }
  return tracedLocally(depth + 1);
}
class Tracer {
  base = 3;
  tracedByMethod(depth: number): Traced { return { trace: names(new Error("here").stack), depth: depth + this.base }; }
  forwardsByMethod(depth: number): Traced { return this.tracedByMethod(depth + 1); }
}

// Not tail calls: the frame stays.
function keepsFrameInTry(depth: number): Traced { try { return traced(depth + 1); } finally { noise = (noise + 1) % 1000003; } }
function keepsFrameInLargeTry(depth: number): Traced { pads(); try { return forwardsLarge(depth + 1); } finally { noise = (noise + 1) % 1000003; } }
function keepsFrameByReading(depth: number): Traced { const inner = forwards(depth + 1); return { trace: inner.trace, depth: inner.depth + 1 }; }
function keepsFrameOfPair(depth: number): [string, number] { const [trace, inner] = forwardsPair(depth + 1); return [trace, inner + 1]; }

function readsForwarded(n: number): string { const report = new Report(); for (let i = 0; i < n; i++) { const { trace, depth } = forwards(i); report.add(trace, depth); } return report.toString(); }
function readsForwardedTwice(n: number): string { const report = new Report(); for (let i = 0; i < n; i++) { const t = forwardsTwice(i); report.add(t.trace, t.depth); } return report.toString(); }
function readsUnderCast(n: number): string { const report = new Report(); for (let i = 0; i < n; i++) { const { trace, depth } = forwardsUnderCast(i); report.add(trace, depth); } return report.toString(); }
function readsWiderType(n: number): string { const report = new Report(); for (let i = 0; i < n; i++) report.add(forwardsAsWiderType(i).trace, i); return report.toString(); }
function readsLarge(n: number): string { const report = new Report(); for (let i = 0; i < n; i++) { const { trace, depth } = forwardsLarge(i); report.add(trace, depth); } return report.toString(); }
function readsLargeTwice(n: number): string { const report = new Report(); for (let i = 0; i < n; i++) { const { trace, depth } = forwardsLargeTwice(i); report.add(trace, depth); } return report.toString(); }
function readsEither(n: number): string { const report = new Report(); for (let i = 0; i < n; i++) { const { trace, depth } = forwardsEither(i); report.add(trace, depth); } return report.toString(); }
function readsForwardedOrCreated(n: number): string { const report = new Report(); for (let i = 0; i < n; i++) { const { trace, depth } = forwardsOrCreates(i); report.add(trace, depth); } return report.toString(); }
function readsPair(n: number): string { const report = new Report(); for (let i = 0; i < n; i++) { const [trace, depth] = forwardsPair(i); report.add(trace, depth); } return report.toString(); }
function readsFromClosure(n: number): string { const report = new Report(); for (let i = 0; i < n; i++) { const { trace, depth } = forwardsToClosure(i); report.add(trace, depth); } return report.toString(); }
function readsFromLocalClosure(n: number): string { const report = new Report(); for (let i = 0; i < n; i++) { const { trace, depth } = forwardsToLocalClosure(i, "local "); report.add(trace, depth); } return report.toString(); }
function readsFromMethod(n: number): string { const report = new Report(); const receiver = new Tracer(); for (let i = 0; i < n; i++) { const { trace, depth } = receiver.forwardsByMethod(i); report.add(trace, depth); } return report.toString(); }
function readsKeptFrames(n: number): string {
  const report = new Report();
  for (let i = 0; i < n; i++) {
    const inTry = keepsFrameInTry(i); report.add(inTry.trace, inTry.depth);
    const inLargeTry = keepsFrameInLargeTry(i); report.add(inLargeTry.trace, inLargeTry.depth);
    const { trace, depth } = keepsFrameByReading(i); report.add(trace, depth);
    const [pairTrace, pairDepth] = keepsFrameOfPair(i); report.add(pairTrace, pairDepth);
  }
  return report.toString();
}

// The object itself is needed: it is stored, or the forwarding function is called by value.
const stored: Traced[] = [];
function storesForwarded(n: number): string {
  for (let i = 0; i < n; i++) { stored.push(forwardsTwice(i)); stored.push(forwardsLargeTwice(i)); }
  const report = new Report();
  for (const t of stored) report.add(t.trace, t.depth);
  return report.toString();
}
function callsByValue(): string { return [forwards, forwardsTwice, forwardsLarge, forwardsLargeTwice, forwardsEither, forwardsToClosure].map(f => f(1).trace).join(" | "); }

console.log(readsForwarded(30));
console.log(readsForwardedTwice(30));
console.log(readsUnderCast(30));
console.log(readsWiderType(30));
console.log(readsLarge(30));
console.log(readsLargeTwice(30));
console.log(readsEither(30));
console.log(readsForwardedOrCreated(30));
console.log(readsPair(30));
console.log(readsFromClosure(30));
console.log(readsFromLocalClosure(30));
console.log(readsFromMethod(30));
console.log(readsKeptFrames(30));
console.log(storesForwarded(10));
console.log(callsByValue());
console.log(noise);
export {};
//// frame-cells-handed-to-callees.js
// An object or a closure that never leaves its function may live in the frame. Each case hands one to a function that is not inlined and does one thing with it while the collector runs: keeps it in a cell that dies with the call, captures it, returns it, throws it, passes it on, hands it to a built-in, reads it under a computed key, fills it.
const collect = () => Bun.gc(true);
const rounds = 40;

function report(title, run) {
  let sum = 0;
  for (let i = 0; i < rounds; i++) sum += run(i);
  console.log(title, sum);
}

function holdsInArray(text, point) { const held = [5, point, text]; collect(); return held.length + held[1].y; }
function guardsHoldsInArray(text, point) { try { return holdsInArray(text, point); } catch {} }
report("held in an array", i => guardsHoldsInArray("text", { y: i }));

function holdsInRecord(text, point) { const held = { point, text }; collect(); return held.point.y; }
function guardsHoldsInRecord(text, point) { try { return holdsInRecord(text, point); } catch {} }
report("held in a record", i => guardsHoldsInRecord("text", { y: i }));

function storesInField(point) { const held = { point: null }; held.point = point; collect(); return held.point.y; }
function guardsStoresInField(point) { try { return storesInField(point); } catch {} }
report("stored in a field", i => guardsStoresInField({ y: i }));

function storesInElement(point) { const held = [0]; held[0] = point; collect(); return held[0].y; }
function guardsStoresInElement(point) { try { return storesInElement(point); } catch {} }
report("stored in an element", i => guardsStoresInElement({ y: i }));

function pushes(point) { const held = []; held.push(point); collect(); return held[0].y; }
function guardsPushes(point) { try { return pushes(point); } catch {} }
report("pushed", i => guardsPushes({ y: i }));

function callsDuringCollection(callback) { try { collect(); return callback(); } catch {} }
function captures(point) { return callsDuringCollection(() => point.y); }
function guardsCaptures(point) { try { return captures(point); } catch {} }
report("captured by a closure of the callee", i => guardsCaptures({ y: i }));

function makesReader(point) { return () => point.y; }
function guardsMakesReader(point) { try { return makesReader(point); } catch {} }
report("captured by a closure that is returned", i => { const read = guardsMakesReader({ y: i }); collect(); return read(); });

function returnsIt(point) { return point; }
function guardsReturnsIt(point) { try { return returnsIt(point); } catch {} }
report("returned", i => { const point = guardsReturnsIt({ y: i }); collect(); return point.y; });

function throwsIt(point) { throw point; }
function cleansUp(point) { try { throwsIt(point); } finally { collect(); } }
report("thrown", i => { try { cleansUp({ y: i }); } catch (point) { collect(); return point.y; } });

let kept;
function keeps(point) { kept = point; }
function guardsKeeps(point) { try { keeps(point); } catch {} }
report("kept in a variable", i => { guardsKeeps({ y: i }); collect(); return kept.y; });

function passesOn(point) { try { return holdsInArray("text", point); } catch {} }
function guardsPassesOn(point) { try { return passesOn(point); } catch {} }
report("held two calls down", i => guardsPassesOn({ y: i }));

function takesRest(...points) { collect(); return points.length + points[0].y; }
function guardsTakesRest(point) { try { return takesRest(point, 1); } catch {} }
report("taken by a rest parameter", i => guardsTakesRest({ y: i }));

function readsArguments() { collect(); return arguments.length + arguments[0].y; }
function guardsReadsArguments(point) { try { return readsArguments(point, 1); } catch {} }
report("read from the arguments object", i => guardsReadsArguments({ y: i }));

function* yields(point) { yield point.y; collect(); yield point.y; }
function guardsYields(point) { try { return yields(point); } catch {} }
report("held by a generator", i => { const steps = guardsYields({ y: i }); collect(); return steps.next().value + steps.next().value; });

function links(holder, point) { holder.next = point; }
function guardsLinks(holder, point) { try { links(holder, point); } catch {} }
report("stored in another argument", i => { const holder = { next: null }; guardsLinks(holder, { y: i }); collect(); return holder.next.y; });

const longLived = { next: null };
report("stored in an object that lives on", i => { guardsLinks(longLived, { y: i }); collect(); return longLived.next.y; });

function listsKeys(point) { collect(); return Object.keys(point).length; }
function guardsListsKeys(point) { try { return listsKeys(point); } catch {} }
report("keys listed by a built-in", i => guardsListsKeys({ y: i, z: 2 }));

function writesText(point) { return JSON.stringify(point).length; }
function guardsWritesText(point) { try { return writesText(point); } catch {} }
report("written as text by a built-in", i => guardsWritesText({ y: i, z: { w: [i, [i, [i, [i, [i, [i, [i, [i, [i, [i]]]]]]]]]] } }));

class Point { constructor(y) { this.y = y; } holdsItself() { const held = [this]; collect(); return held[0].y; } }
function asksForPrototype(point) { collect(); return Object.getPrototypeOf(point) === Point.prototype ? point.y : -1; }
function guardsAsksForPrototype(point) { try { return asksForPrototype(point); } catch {} }
report("asked for its prototype", i => guardsAsksForPrototype(new Point(i)));

function guardsHoldsItself(point) { try { return point.holdsItself(); } catch {} }
report("held by its own method", i => guardsHoldsItself(new Point(i)));

function usesAsKey(point) { const map = new Map(); map.set(point, 1); collect(); return map.get(point) + map.size; }
function guardsUsesAsKey(point) { try { return usesAsKey(point); } catch {} }
report("used as the key of a map", i => guardsUsesAsKey({ y: i }));

function readsByKey(point, key) { collect(); return point[key]; }
function guardsReadsByKey(point, key) { try { return readsByKey(point, key); } catch {} }
report("read under a computed key", i => guardsReadsByKey({ y: i, z: 2 }, i & 1 ? "y" : "z"));

function namesIn(point) { let names = ""; for (const name in point) { collect(); names += name; } return names.length; }
function guardsNamesIn(point) { try { return namesIn(point); } catch {} }
report("enumerated", i => guardsNamesIn({ y: i, z: 1 }));

function copies(point) { const copy = { ...point }; collect(); return copy.y + copy.z.w; }
function guardsCopies(point) { try { return copies(point); } catch {} }
report("spread into a copy", i => guardsCopies({ y: i, z: { w: 1 } }));

function concatenates(point) { return ("" + point).length; }
function guardsConcatenates(point) { try { return concatenates(point); } catch {} }
report("converted to a string", i => guardsConcatenates({ y: i }));

function looksAt(point, other) { collect(); return (point instanceof Point) + (typeof point).length + ("y" in point) + (point === other) + (point == other) + (point !== null) + !point; }
function guardsLooksAt(point, other) { try { return looksAt(point, other); } catch {} }
report("looked at by operators", i => { const point = new Point(i); return guardsLooksAt(point, point) + guardsLooksAt({ y: i }, point); });

function fills(point, i) { point.y = { z: i }; }
function guardsFills(point, i) { try { fills(point, i); } catch {} }
report("filled by the callee", i => { const point = { y: null }; guardsFills(point, i); collect(); return point.y.z; });

function readsDuringCollection(point) { collect(); return point.y.z; }
function guardsReadsDuringCollection(point) { try { return readsDuringCollection(point); } catch {} }
report("keeps a young object alive", i => { const point = { y: { z: i } }; const first = guardsReadsDuringCollection(point); collect(); return first + point.y.z; });

function guardsCallsDuringCollection(callback) { try { return callsDuringCollection(callback); } catch {} }
report("a closure called during a collection", i => { const state = { value: i }; let calls = 0; return guardsCallsDuringCollection(() => { calls++; return state.value; }) + calls; });

function countsMatches(node, test) { if (node === undefined) return 0; return (test(node) ? 1 : 0) + countsMatches(node.next, test); }
report("handed on by the part of a function that needs no frame", i => countsMatches({ id: i, next: { id: i + 1, next: undefined } }, node => { collect(); return node.id > 20; }));

function revives(text, reviver) { return JSON.parse(text, reviver); }
function guardsRevives(text, reviver) { try { return revives(text, reviver); } catch {} }
report("a closure called by a built-in", i => { let calls = 0; guardsRevives('{"a":1,"b":[2,3]}', (key, value) => { calls += i; return value; }); return calls; });

function sorts(numbers, compare) { return numbers.sort(compare)[0]; }
function guardsSorts(numbers, compare) { try { return sorts(numbers, compare); } catch {} }
report("a closure handed to a sort", i => { let calls = 0; return guardsSorts([3, 1, i], (a, b) => { calls++; collect(); return a - b; }) + (calls > 0); });

let awaited = 0;
async function waits(point) { await null; collect(); awaited += point.y; }
function guardsWaits(point) { try { return waits(point); } catch {} }
for (let i = 0; i < rounds; i++) guardsWaits({ y: i });
collect();
await null;
await new Promise(resolve => setTimeout(resolve, 0));
console.log("held by an async function", awaited);

function runs(use, change) { try { use(change); } catch { return "threw"; } return "ran"; }
function changesNothing() {}
function checks(use, getTarget, change) {
  let result;
  const changesThroughAlias = () => { for (const alias of [{}, function () {}, getTarget()]) result = change(alias); };
  return runs(use, changesNothing) + " " + runs(use, changesThroughAlias) + " " + result;
}
const target = { m: 0 };
function usesFirst(change) { for (let i = 0; i < 300; i++) if (i === 150) { collect(); change(); collect(); } }
function usesSecond(change) { for (let i = 0; i < 300; i++) if (i === 151) { collect(); change(); collect(); } }
function usesThird(change) { for (let i = 0; i < 300; i++) if (i === 152) { collect(); change(); collect(); } }
function usesFourth(change) { for (let i = 0; i < 300; i++) if (i === 153) { collect(); change(); collect(); } }
function usesFifth(change) { for (let i = 0; i < 300; i++) if (i === 154) { collect(); change(); collect(); } }
console.log("closures captured by a closure of the callee", checks(usesFirst, () => target, alias => { alias.m = 1; return 1; }));
console.log("closures captured by a closure of the callee", checks(usesSecond, () => target, alias => { alias.m = 2; return 2; }));
console.log("closures captured by a closure of the callee", checks(usesThird, () => target, alias => { alias.m = 3; return 3; }));
console.log("closures captured by a closure of the callee", checks(usesFourth, () => target, alias => { alias.m = 4; return 4; }));
console.log("closures captured by a closure of the callee", checks(usesFifth, () => target, alias => { alias.m = 5; return 5; }));
//// fresh-objects-below-prototypes-changed-under-computed-names.ts
const names: string[] = JSON.parse('["w", "other", "v"]');
const log: unknown[] = [];

////= lines	Inherits
(Inherits.prototype as any)[names[0]] = 100;

////= lines	Unrelated
(Unrelated.prototype as any)[names[1]] = 100;

////= lines	HasSetter
Object.defineProperty(HasSetter.prototype, names[0], {
  get() {
    return 5;
  },
  set(value: unknown) {
    log.push(value);
  },
});

////= lines	ReadOnly
Object.defineProperty(ReadOnly.prototype, names[0], { value: 9, writable: false });

class Filled {
  v: number;
  declare w?: number;
  constructor(v: number, w?: number) {
    this.v = v;
    if (w !== undefined) this.w = w;
  }
}
(Filled.prototype as any)[names[0]] = 100;

function sum(o: { v: number; w?: number }): number {
  return o.v + (o.w ?? 7);
}

function attempt(run: () => number): string {
  try {
    return String(run());
  } catch (error) {
    return error instanceof Error ? error.constructor.name : typeof error;
  }
}

const kept: object[] = [];
for (let x = 0; x < 3; x++) {
  console.log("read", sum(new Inherits(x)), sum(new Unrelated(x)), sum(new HasSetter(x)), sum(new ReadOnly(x)), sum(new Filled(x)), sum(new Filled(x, 1)));
  console.log(
    "store",
    attempt(() => {
      const o = new Inherits(x);
      o.w = x + 1;
      return sum(o);
    }),
    attempt(() => {
      const o = new Unrelated(x);
      o.w = x + 1;
      return sum(o);
    }),
    attempt(() => {
      const o = new HasSetter(x);
      o.w = x + 1;
      return sum(o);
    }),
    attempt(() => {
      const o = new ReadOnly(x);
      o.w = x + 1;
      return sum(o);
    }),
  );
  const escaping = new Unrelated(x);
  escaping.w = x + 2;
  kept.push(escaping);
  const intercepted = new HasSetter(x);
  intercepted.w = x + 3;
  kept.push(intercepted);
}
console.log(JSON.stringify(kept), JSON.stringify(log), kept.map(o => Object.keys(o).join()).join(" "));
//// fresh-objects-stored-in-two-loops-into-the-one-element-of-an-array-that-stays-in-its-function.js
// An array of one element never leaves its function. A loop stores a new object into the element, the element is read, and a second loop stores another new object or array into it.
////= lines-2	sameLayoutTwice	"the same layout twice:"	first

////= lines-4	thenAnArrayLiteral	"then an array literal:"	[i]	[0]

////= lines-4	thenAnArrayOfALength	"then an array of a length:"	new Array(9)	.length

(function thenAnArrayThatIsFilled() {
    const holder = [null];
    for (let i = 0; i < 400; ++i)
        holder[0] = { first: i };
    console.log("then an array that is filled:", holder[0].first);
    for (let i = 0; i < 40; ++i) {
        const array = new Array(9);
        array.fill(i);
        holder[0] = array;
    }
    console.log(holder[0][8]);
})();

////= lines-2	thenAnotherLayout	"then another layout:"	other

(function withoutAReadBetween() {
    const holder = [null];
    for (let i = 0; i < 400; ++i)
        holder[0] = { first: i };
    for (let i = 0; i < 40; ++i)
        holder[0] = new Array(9);
    console.log("without a read between:", holder[0].length);
})();

(function theFirstStoreOutsideALoop() {
    const holder = [null];
    holder[0] = { first: 1 };
    console.log("the first store outside a loop:", holder[0].first);
    for (let i = 0; i < 40; ++i)
        holder[0] = new Array(9);
    console.log(holder[0].length);
})();

(function theSecondStoreOutsideALoop() {
    const holder = [null];
    for (let i = 0; i < 400; ++i)
        holder[0] = { first: i };
    console.log("the second store outside a loop:", holder[0].first);
    holder[0] = new Array(9);
    console.log(holder[0].length);
})();

(function thenAStringThatItsLoopReads() {
    const holder = [null];
    for (let i = 0; i < 400; ++i)
        holder[0] = { first: i };
    console.log("then a string that its loop reads:", holder[0].first);
    let characters = 0;
    for (let i = 0; i < 40; ++i) {
        holder[0] = ("x" + i).repeat(20);
        characters += holder[0].charCodeAt(0);
    }
    console.log(characters);
})();
