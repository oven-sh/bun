//// closure-in-object-returned-by-large-function.ts
// A function too large to inline returns a fresh object with a closure; its callers read the closure, keep the object, or both.
declare const console: any;
declare const Bun: any;
const out: string[] = [];
function say(name: string, value: unknown): void { out.push(name + "=" + String(value)); }
const kept: any[] = [];
let spins = 0;
function busy(n: number): number { let s = 0; for (let i = 0; i < (n & 3) + 1; i++) { s += i * 3; if (s > 1e9) s = 0; spins++; } for (let j = 0; j < 2; j++) { s ^= j; if (s < -1e9) s = 1; } return s; }

interface H { text: string; count: number; run: () => number }
function holder(n: number): H { busy(n); busy(n + 1); busy(n + 2); return { text: "t" + n, count: n, run: () => 5 }; }

function e1(): void { const h = holder(1); const f = h.run; kept.push(h); say("read-then-keep", f === kept[kept.length - 1].run); }
function e2(): void { const h = holder(2); kept.push(h); const f = h.run; say("keep-then-read", f === kept[kept.length - 1].run); }
function e3(): void { const h = holder(3); say("read-twice", h.run === h.run); }
function e4(flag: boolean): void { const h = holder(4); const f = h.run; if (flag) kept.push(h); say("keep-on-one-path", flag ? f === kept[kept.length - 1].run : f === h.run); }
function e5(): void { const { run, text } = holder(5); const h = holder(5); say("destructured", (run === h.run) + "/" + text + "/" + run()); }
function e6(): void { const h = holder(6); kept.push(h.run); kept.push(h); say("closure-then-object", kept[kept.length - 2] === kept[kept.length - 1].run); }
function e7(): H { const h = holder(7); kept.push(h.run); return h; }
function e8(): void { const h = holder(8); const f = h.run; Bun.gc(true); const g = h.run; kept.push(h); Bun.gc(true); say("collections-between", f === g && g === kept[kept.length - 1].run); }
function e9(): void { let same = 0; for (let i = 0; i < 20; i++) { const h = holder(i); const f = h.run; if (i % 3 === 0) kept.push(h); if (f === (i % 3 === 0 ? kept[kept.length - 1].run : h.run)) same++; } say("in-a-loop", same); }

class Box { x: number; run = () => this.x; constructor(x: number) { busy(x); busy(x + 1); busy(x + 2); this.x = x; } }
function box(n: number): Box { busy(n); busy(n + 1); return new Box(n); }
function g1(): void { const b = box(1); const f = b.run; kept.push(b); say("instance/read-then-keep", f === kept[kept.length - 1].run && f() === 1); }
function g2(): void { const b = box(2); kept.push(b.run); kept.push(b); say("instance/closure-then-object", kept[kept.length - 2] === kept[kept.length - 1].run); }

e1(); e2(); e3(); e4(true); e4(false); e5(); e6();
{ const h = e7(); say("returned-after-read", kept[kept.length - 1] === h.run); }
e8(); e9(); g1(); g2();
console.log(out.join("\n"));
//// closure-over-its-object-read-in-many-ways.ts
// A closure over the object it is stored in has one identity, however and wherever the field is read.
declare const console: any;
declare const Bun: any;
const out: string[] = [];
function say(name: string, value: unknown): void { out.push(name + "=" + String(value)); }
function collect(): void { Bun.gc(true); }

class B1 { x = 7; run = () => this.x; }
function b1(): void { const c = new B1(); say("field/twice", c.run === c.run); const r = c.run; say("field/call", r() + c.run()); say("field/two-objects", new B1().run === new B1().run); }

const keptB2: unknown[] = [];
class B2 { x = 7; run: () => number; constructor() { this.run = () => this.x; keptB2.push(this.run); } }
function b2(): void { const c = new B2(); say("constructor/read-inside", keptB2[0] === c.run); }

class B3 { x = 7; run = () => this.x; }
class D3 extends B3 { y = 1; }
function b3(): void { const d = new D3(); say("subclass/twice", d.run === d.run); say("subclass/call", d.run()); }

class B4 { x = 7; run = () => this.x; }
function b4(): void { const c = new B4(); const { run } = c; say("destructured", run === c.run); say("values", Object.values(c)[1] === c.run); say("spread", { ...c }.run === c.run); say("spread-call", { ...c }.run()); }

class B5 { x = 7; run = () => this.x; }
let keptB5: B5 | undefined;
function b5(): void { const c = new B5(); const f = c.run; keptB5 = c; collect(); say("read-then-escape", f === keptB5!.run); }

class B6 { x = 7; run = () => this.x; }
function readB6(c: B6, depth: number): () => number { return depth > 0 ? readB6(c, depth - 1) : c.run; }
function b6(): void { const c = new B6(); say("read-in-callee", readB6(c, 3) === c.run); }

class B7 { x = 7; run = () => this.x; }
function b7(): void { const c = new B7(); (c.run as any).tag = 5; collect(); say("tag-after-collection", (c.run as any).tag); c.x = 9; say("sees-the-object", c.run()); }

class B8 { x = 7; run = () => this.x; }
function b8(): void { const c = new B8(); const f = c.run; Object.freeze(c); say("after-freeze", f === c.run); const d: any = new B8(); const g = d.run; delete d.x; say("after-delete", g === d.run); say("after-delete-call", String(d.run())); }

class B9 { x = 7; run = () => this.x; }
function b9(): void { const c: any = new B9(); const f = c.run; Object.defineProperty(c, "x", { get() { return 11; } }); say("after-redefinition", f === c.run); say("after-redefinition-call", c.run()); }

class B10 { x = 7; run = () => this.x; static make(): B10 { return new B10(); } }
function b10(): void { const f = B10.make().run, g = B10.make().run; say("from-a-factory", f === g); say("from-a-factory-call", f() + g()); }

class B11 { x: number; run = () => this.x; constructor(x: number) { this.x = x; } }
function b11(): void { const list = [new B11(1), new B11(2), new B11(3)]; const runs = list.map(c => c.run); collect(); say("mapped", runs.map((f, i) => (f === list[i].run) + ":" + f()).join(",")); }

function F12(this: any): void { this.x = 7; this.run = () => this.x; }
function b12(): void { const c = new (F12 as any)(); say("constructor-function", c.run === c.run); say("constructor-function-call", c.run()); }

const o13 = { x: 7, run: () => 1 };
function b13(): void { say("module-literal", o13.run === o13.run); }

b1(); b2(); b3(); b4(); b5(); b6(); b7(); b8(); b9(); b10(); b11(); b12(); b13();
console.log(out.join("\n"));
//// closure-passed-to-a-method-that-is-never-there.js
// The receiver is a number, so the method that takes the closure is never found and the call throws. Nothing keeps the closure, whether the call stands alone, in a loop, or gets more arguments.
function entered(list) { return list.map(value => value); }
function withCapture(list, step) { return list.map(value => value + step, step); }
function attempt(run) {
  try {
    return String(run());
  } catch (error) {
    return error.constructor.name;
  }
}
console.log(attempt(() => entered(5)));
console.log(attempt(() => withCapture(6, 1)));
for (let round = 0; round < 3; round++)
  console.log(round, attempt(() => entered(round)));
console.log(attempt(() => [1, 2].map(value => value * 2)));
//// closures-carried-across-loop-iterations.ts
// Closures that are created in loops and carried over to the next iteration or kept in an array.
const kept: (() => number)[] = [];
function carried(n: number): number {
  let previous: (() => number) | undefined;
  let sum = 0;
  for (let i = 0; i < n; i++) {
    const weight = i * 10 + n;
    const f = (): number => weight + sum % 7;
    if (previous) sum += previous();
    previous = f;
  }
  return sum + (previous ? previous() : 0);
}
function carriedTwoTurns(n: number): number {
  let last: (() => number) | undefined;
  let beforeLast: (() => number) | undefined;
  let sum = 0;
  for (let i = 0; i < n; i++) {
    const weight = i * 3 + 1;
    const f = (): number => weight;
    if (beforeLast) sum += beforeLast() * 100 + (last ? last() : 0);
    beforeLast = last;
    last = f;
  }
  return sum;
}
function calledAheadOfItsNextBirth(n: number): number {
  let previous: (() => number) | undefined;
  let sum = 0;
  for (let i = 0; i < n; i++) {
    let weight = i * 10 + n;
    if (previous) sum += previous() * (i + 1);
    const f = (): number => ++weight;
    weight += 2;
    previous = f;
  }
  return sum + (previous ? previous() : 0);
}
function keptLater(flag: boolean, n: number): number {
  let t = n;
  const a = (): number => ++t;
  const b = (): number => t + 100;
  const f = flag ? a : b;
  kept.push(f);
  return f();
}
function returnedLater(flag: boolean, n: number): () => number {
  let t = n;
  let h = n * 31 + 7;
  h = ((h ^ (h >> 1)) + 17) % 100003; if (h % 1009 === 0) kept.length = 0;
  h = ((h ^ (h >> 2)) + 20) % 100003; if (h % 1011 === 0) kept.length = 0;
  h = ((h ^ (h >> 3)) + 23) % 100003; if (h % 1013 === 0) kept.length = 0;
  h = ((h ^ (h >> 4)) + 26) % 100003; if (h % 1015 === 0) kept.length = 0;
