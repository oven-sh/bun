//// local-array-elements-read-through-methods.ts
// Elements of a local array are read through generic functions and array methods (`shift`, `find`, `concat`, `Array.from`, iterators).
declare const console: { log(...a: unknown[]): void };
function row(name: string, f: () => unknown): void { let got: unknown; try { got = f(); } catch (e) { got = "threw " + (e as Error).name + " " + (e as Error).message; } console.log(name + ": " + got); }
function firstOf<T>(xs: T[]): T { return xs[0]; }
function g1(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; return firstOf(a); } } }
row("through a generic function of the program", () => g1(1));
function g2(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; return a.shift(); } } }
row("shift", () => g2(1));
function g3(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; return a.find(() => true); } } }
row("find", () => g3(1));
function g4(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; return a.concat()[0]; } } }
row("concat", () => g4(1));
function g5(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; return Array.from(a)[0]; } } }
row("Array.from", () => g5(1));
function g6(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; return a.values().next().value; } } }
row("values().next()", () => g6(1));
function g7(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; let s = 0; for (const [, x] of a.entries()) s += x; return s; } } }
row("entries()", () => g7(1));
function g8(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; const x = a[0]; return x + 1; } } }
row("kept in a const, then used", () => g8(1));
function g9(k: number) { switch (k) { case 1: { const a = [k]; a[0]++; return a.filter(x => x > 0).length + a.lastIndexOf(k); } } }
row("filter and lastIndexOf", () => g9(1));
function sign(x: number) { return x < 0 ? -1 : x > 0 ? 1 : 0; }
function g10(x: number) { const s = sign(x); return s === 1 ? "up" : s === -1 ? "down" : "flat"; }
row("an inferred result of literals is as it was", () => g10(5) + g10(-5) + g10(0));
type S = { kind: 1; a: number } | { kind: 2; b: string };
function g11(all: S[]) { let t = ""; for (const s of all) t += s.kind === 1 ? s.a : s.b; return t; }
row("a union told apart by a number, out of an array", () => g11([{ kind: 1, a: 5 }, { kind: 2, b: "z" }]));
function g12() { const t = [1, 2] as const; return t[0] + t[1]; }
row("as const", () => g12());
//// local-object-removed-despite-untyped-lookalikes.ts
// A local object's allocation is removed although objects created by untyped code can have the same type.
declare const console: { log(...a: unknown[]): void };
interface Q { x: number }
const foreign: Q = { x: 0 } as any;
function g(n: number): number { const o: Q = { x: n }; return o.x + 1; }
console.log(g(1), foreign.x);
//// moved-closures-across-young-collections.ts
// Closures moved from the stack to the heap stay valid when young-generation garbage collections run in between.
const saved: ((x: number) => void)[] = [];
const keepers: number[][] = [];
function keeping(list: number[]): number[] { keepers.push(list); return list; }
function isKept(list: number[]): boolean { return keepers.indexOf(list) >= 0; }
function hold(list: number[], callback: (x: number) => void): void { saved.push(callback); for (let i = 0; i < list.length; i++) callback(list[i]); }
function sum(list: number[], tag: string): number {
  let n = 0;
  let text = tag;
  let last: number[] = [];
  if (isKept(list)) hold(list, x => { n += x; text = text + x; last = [x, n]; }); else list.forEach(x => { n += x; text = text + x; last = [x, n]; });
  return n + text.length + last.length;
}
const plain = [1, 2, 3];
const keeper = keeping([4, 5]);
let total = 0;
let garbage: string[] = [];
for (let i = 0; i < 300000; i++) {
  total += sum(i % 1000 === 7 ? keeper : plain, "t" + (i & 7));
  garbage.push("g" + i);
  if (garbage.length > 2000) garbage = [];
  if (saved.length > 20) saved.length = 0;
}
console.log(total);
//// object-allocated-only-where-escaping.ts
// An object that escapes in one branch only is allocated in that branch.
declare const console: { log(...a: unknown[]): void };
interface P { x: number; y: number }
let kept: P | undefined;
function f(c: boolean, n: number): number {
  const o: P = { x: n, y: n + 1 };
  if (c) kept = o;
  return o.x * 10 + o.y;
}
let s = 0;
for (let i = 0; i < 4; i++) s += f(i === 3, i);
console.log(s, kept!.x);
//// object-built-where-a-field-is-odd-and-every-pass-is-verified.ts
// One of two literals lacks a field that is a slice; the object is built where the name is empty.
type Split = { name: string; place?: string };
////= split-2	source.slice(0, at), place: source.slice(at + 1
const kept: Split[] = [];
// Too large to be inlined.
function keep(parts: Split): void {
  try {
    for (let i = 0; i < 2; i++) if (kept.length < 40 + i) kept.push(parts);
  } catch {
    kept.length = 0;
  }
}
const ids = ["plain", "a@north", "", "@", "a@", "a@b@c", "longer-without-a-mark", "x@y"];

function use(id: string, turn: number): number {
  const parts = split(id);
  if (parts.name === "" || parts.name === "plain") keep(parts);
  return parts.name.length + (turn & 1);
}
let total = 0;
for (let turn = 0; turn < 3000; turn++) for (const id of ids) total += use(id, turn);
console.log(total, kept.length);
for (const parts of kept.slice(0, 24)) console.log(JSON.stringify(parts), "place" in parts);

//// objects-in-frames-read-by-name.ts
// Objects that never leave their function hold strings, objects, arrays and closures. Built with accesses left by name: the run time reads and stores their fields while they lie in frames.
declare const console: any;
declare const Bun: any;
const out: string[] = [];
function say(name: string, value: unknown): void { out.push(name + "=" + String(value)); }
const kept: unknown[] = [];

interface Point { y: number }
interface Holder { text: string; point: Point; list: number[]; count: number; run: () => number }
function text(n: number): string { return "t" + n; }
function point(n: number): Point { const p = { y: n }; kept.push(p); return p; }
function holder(n: number): Holder { return { text: text(n), point: point(n), list: [n, n + 1], count: n, run: () => 5 }; }

function reads(): void { const h = holder(1); say("reads", h.text + "/" + h.point.y + "/" + h.list.join() + "/" + h.count + "/" + h.run()); }
function readsAfterCollection(): void { const h = holder(2); Bun.gc(true); say("reads-after-collection", h.text + "/" + h.point.y + "/" + h.list.join() + "/" + (h.run === h.run)); }
function stores(): void { const h = holder(3); h.text = text(30); h.point = point(31); h.list = [32]; h.count = 33; Bun.gc(true); say("stores", h.text + "/" + h.point.y + "/" + h.list.join() + "/" + h.count); }
function readsIn(h: Holder, depth: number): string { return depth > 0 ? readsIn(h, depth - 1) : h.text + "/" + h.point.y + "/" + h.list.length; }
function readsInCallee(): void { const h = holder(4); say("reads-in-callee", readsIn(h, 3) + "/" + h.text); }
function storesIn(h: Holder, depth: number): void { if (depth > 0) storesIn(h, depth - 1); else { h.text = text(50); h.point = point(51); } }
function storesInCallee(): void { const h = holder(5); storesIn(h, 3); Bun.gc(true); say("stores-in-callee", h.text + "/" + h.point.y); }
function joins(flag: boolean): void { const a = holder(6), b = holder(7); const h = flag ? a : b; say("joins", h.text + "/" + h.point.y + "/" + (h.run === a.run) + "/" + (h.run === b.run)); }
function tests(): void { const h = holder(8); say("tests", ("text" in h) + "/" + ("none" in h) + "/" + Object.hasOwn(h, "point")); }
function loops(): void { let sum = 0; let last = ""; for (let i = 0; i < 50; i++) { const h = holder(i); sum += h.point.y + h.list[1] + h.count; last = h.text; if (i === 25) Bun.gc(true); } say("loops", sum + "/" + last); }

reads(); readsAfterCollection(); stores(); readsInCallee(); storesInCallee(); joins(true); joins(false); tests(); loops();
console.log(out.join("\n"));
//// objects-that-refer-to-each-other-built-on-one-path.js
// Objects that refer to each other (a closure over the object that holds it, a parent and its child) are needed on one path only. Where they are built, keys, values and identities are what the constructors made.
const lines = [];
function say(name, ...values) { lines.push(name + ": " + values.map(String).join(" ")); }

class Handler {
  constructor(name) {
    this.name = name;
    this.run = () => this.name;
    this.again = () => this.run() + "!";
    this.count = 0;
    this.last = null;
  }
}
const keptHandlers = [];
function makeHandler(name, keep) {
  const handler = new Handler(name);
  handler.count++;
  if (keep) {
    keptHandlers.push(handler);
    return handler.run;
  }
  return null;
}
let lastRun = null;
for (let i = 0; i < 1000; i++) {
  const run = makeHandler("h" + i, i % 400 === 7);
  if (run) lastRun = run;
}
for (const handler of keptHandlers) {
  say("handler keys", Object.keys(handler).join());
  say("handler text", JSON.stringify(handler));
  say("handler calls", handler.run(), handler.again(), handler.count, handler.last);
  say("handler identity", handler.run === handler.run, handler.again === handler.again, handler.run === handler.again);
}
say("last run", lastRun(), lastRun === keptHandlers[keptHandlers.length - 1].run);

class Parent {
  constructor(name) {
    this.name = name;
    this.child = new Child(this);
    this.size = 1;
  }
}
class Child {
  constructor(parent) {
    this.depth = 1;
    this.parent = parent;
    this.label = "child of " + parent.name;
  }
}
const keptParents = [];
const keptChildren = [];
function makeFamily(name, keepParent, keepChild) {
  const parent = new Parent(name);
  parent.size += parent.child.depth;
  if (keepParent) keptParents.push(parent);
  if (keepChild) keptChildren.push(parent.child);
  return parent.child.parent.size;
}
let total = 0;
for (let i = 0; i < 1000; i++) total += makeFamily("p" + i, i % 300 === 5, i % 450 === 9);
say("families", total, keptParents.length, keptChildren.length);
for (const parent of keptParents) {
  say("parent keys", Object.keys(parent).join(), Object.keys(parent.child).join());
  say("parent values", parent.name, parent.size, parent.child.depth, parent.child.label);
  say("parent identity", parent.child.parent === parent, parent.child.parent.child === parent.child);
}
for (const child of keptChildren) {
  say("child keys", Object.keys(child).join(), Object.keys(child.parent).join());
  say("child values", child.label, child.parent.name, child.parent.size);
  say("child identity", child.parent.child === child);
}

function makeRing(value, keep) {
  const first = { value, next: null, tag: "first" };
  const second = { value: value + 1, next: first, tag: "second" };
  first.next = second;
  if (keep) return first;
  return first.next.next.value + second.next.next.value;
}
let ringTotal = 0;
let ring = null;
for (let i = 0; i < 1000; i++) {
  const result = makeRing(i, i === 777);
  if (typeof result === "number") ringTotal += result;
  else ring = result;
}
say("ring", ringTotal, Object.keys(ring).join(), Object.keys(ring.next).join(), ring.value, ring.next.value, ring.tag, ring.next.tag, ring.next.next === ring);

let keptTop = null;
function makeShared(i, keep) {
  const leaf = { w: i };
  const middle = { id: i + 1, leaf, size: i + 2, half: i * 0.5 };
  const top = { leaf, middle };
  if (keep) keptTop = top;
  return middle.size + top.leaf.w;
}
let sharedTotal = 0;
for (let i = 0; i < 1000; i++) sharedTotal += makeShared(i, i === 777);
say("shared keys", sharedTotal, Object.keys(keptTop).join(), Object.keys(keptTop.middle).join(), Object.keys(keptTop.leaf).join());
say("shared text", JSON.stringify(keptTop));
say("shared identity", keptTop.leaf === keptTop.middle.leaf, keptTop.middle.id, keptTop.middle.size, keptTop.middle.half);

let keptSelf = null;
function makeLiteral(i, keep) {
  let literal;
  literal = { id: i, self: () => literal, count: i + 3, half: i * 0.5 };
  if (keep) keptSelf = literal.self;
  return literal.count;
}
let literalTotal = 0;
for (let i = 0; i < 1000; i++) literalTotal += makeLiteral(i, i === 555);
const keptLiteral = keptSelf();
say("literal keys", literalTotal, Object.keys(keptLiteral).join(), keptLiteral.id, keptLiteral.count, keptLiteral.half);
say("literal text", JSON.stringify(keptLiteral));
say("literal identity", keptLiteral.self === keptSelf, keptLiteral.self() === keptLiteral);

console.log(lines.join("\n"));
//// one-of-two-stack-closures-chosen.ts
// One of two stack-allocated closures is chosen by a condition and then called.
let noise = 0;
function calls(f: () => number): number { if (noise > 1e9) return calls(f); return f() + f(); }
function oneOfTwo(flag: boolean, n: number): number {
  let t = n;
  const a = (): number => ++t;
  const b = (): number => t + 100;
  const f = flag ? a : b;
  return calls(f) + calls(f) + t;
}
function orNone(flag: boolean, n: number): number {
  let t = n;
  const a = (): number => { t += 2; return t; };
  const f = flag ? a : undefined;
  let sum = 0;
  for (let i = 0; i < 3; i++) if (f) sum += f();
  return sum + t;
}
function throughALoop(n: number): number {
  let t = n;
  const step = (): number => { t += 3; return t; };
  let f = step;
  let sum = 0;
  for (let i = 0; i < 4; i++) { sum += f(); if (sum > 1e9) f = step; }
  return sum;
}
function apply2(f: (x: number) => number, x: number): number { if (noise > 1e9) return apply2(f, x); return f(x) + f(x + 1); }
function declared(n: number): number {
  let t = n;
  function add(x: number): number { t += x; return t; }
  return apply2(add, 1) + apply2(add, 2) + t;
}
function report(f: (text: string, ...rest: number[]) => number): number { if (noise > 1e9) return report(f); return f("a", 1, 2, 3) + f("bc") + f("d", 9, 8, 7, 6, 5, 4, 3, 2, 1, 0); }
function withRest(n: number): number {
  let t = n;
  const f = (text: string, ...rest: number[]): number => { t += text.length; for (const r of rest) t += r; return t + rest.length; };
  return report(f) + report(f);
}
function behindACut(n: number, depth: number): number {
  if (n < 0) return -1;
  if (depth < 100) {
  let t = n;
  let text = "s";
  let h = depth * 31 + 7;
  h = ((h ^ (h >> 1)) + 13) % 100003; if (h % 89 === 0) noise++;
  h = ((h ^ (h >> 2)) + 18) % 100003; if (h % 91 === 0) noise++;
  h = ((h ^ (h >> 3)) + 23) % 100003; if (h % 93 === 0) noise++;
  h = ((h ^ (h >> 4)) + 28) % 100003; if (h % 95 === 0) noise++;
  h = ((h ^ (h >> 5)) + 33) % 100003; if (h % 97 === 0) noise++;
  h = ((h ^ (h >> 1)) + 38) % 100003; if (h % 99 === 0) noise++;
  h = ((h ^ (h >> 2)) + 43) % 100003; if (h % 101 === 0) noise++;
  h = ((h ^ (h >> 3)) + 48) % 100003; if (h % 103 === 0) noise++;
  h = ((h ^ (h >> 4)) + 53) % 100003; if (h % 105 === 0) noise++;
  h = ((h ^ (h >> 5)) + 58) % 100003; if (h % 107 === 0) noise++;
  h = ((h ^ (h >> 1)) + 63) % 100003; if (h % 109 === 0) noise++;
  h = ((h ^ (h >> 2)) + 68) % 100003; if (h % 111 === 0) noise++;
  h = ((h ^ (h >> 3)) + 73) % 100003; if (h % 113 === 0) noise++;
  h = ((h ^ (h >> 4)) + 78) % 100003; if (h % 115 === 0) noise++;
  const add = (x: number): number => { t += x; text += x; return t + text.length; };
  if (depth > 0) return apply2(add, h % 5) + behindACut(n - 1, depth - 1);
  return apply2(add, 1) + apply2(add, 2) + t;
  }
  return 0;
}
let out = "";
for (let i = 0; i < 120; i++) {
  const a = oneOfTwo(i % 2 === 0, i), b = orNone(i % 3 !== 0, i), c = throughALoop(i), d = declared(i), e = withRest(i), g = behindACut(i, 2) + behindACut(-i, 1) + behindACut(i + 1, 0) + behindACut(3, 1);
  if (i % 24 === 0) out += a + "|" + b + "|" + c + "|" + d + "|" + e + "|" + g + "\n";
}
console.log(out);
