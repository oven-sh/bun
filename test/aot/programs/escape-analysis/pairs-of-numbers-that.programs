////: Counter
class Counter {
  i = 0;
  constructor(public limit: number) {}
  next(): «1» {
    if (this.i < this.limit) return { value: «2», done: false };
    return { value: 0, done: true };
  }
}
////: bounds
function bounds(list«1» {
  let low = 1000;
  for (let i = 0; i < list.length; i++) if (list[i] < low) low = list[i];
  let high = -1000;
  for (let i = 0; i < list.length; i++) if (list[i] > high) high = list[i];
  return [low, high];
}
////: for-2
for (let i = 1; i < 2000; i++) {
  const [quotient, rest] = divide(i, 7);
  const [half, quarter, eighth] = halves(i);
  const [next, name] = named(i, "ab");
  sum += quotient - rest + half - quarter + eighth + next - name.length;
}
////: for-3
for (let turn = 0; turn < 3; turn++) {
  for (const list of [whole, holey, withOther, withNaN, withMinusZero, empty]) {
    say("pattern", byPattern(list), "assignment", byAssignment(list), "index", byIndex(list), "indexes", byTwoIndexes(list));
    say("beyond", beyondTheEnd(list), "defaults", withDefaults(list), "last", lastOf(list));
  }
}
////: keep
function keep(parts: Split): void {
  try {
    for (let i = 0; i < 2; i++) if (kept.length < 60 + i) kept.push(parts);
  } catch {
    kept.length = 0;
  }
}
////: lastOf
function lastOf(list«1» {
  let last = list[0];
  let count = 0;
  for (let i = 0; i < list.length; i++) {
    last = list[i];
    count++;
  }
  for (let i = 0; i < list.length; i++) if (list[i] === 77) count += 100;
  return [last, count];
}
////: split
function split(source: string): Split {
  const at = source.lastIndexOf("@");
  if (at < 0) {
    return { name: source };
  }
  const place = source.slice(at + 1);
  if (at === 0) {
    return { name: "", place };
  }
  return { name: source.slice(0, at), place, size: at };
}
////: use
function use(id: string, turn: number): number {
  const parts = split(id);
  if (parts.name === «1» || parts.name === "plain" || parts.name === «2») keep(parts);
  return parts.name.length + (turn & 1);
}
//// pairs-of-numbers-that-are-only-read-and-pairs-that-somebody-looks-at.ts
// Functions answer with a pair or a small tuple of numbers, and callers take it apart at once: by a pattern, by an assignment pattern, by an index.
// Beside them stand the callers that can tell whether there was an array: an element that is no number, NaN, a hole, a getter under an index,
// a class below Array, a pair that is kept on one way, a pair that is written to, an iterator of its own.
const lines: string[] = [];
function say(...values: unknown[]) {
  lines.push(values.map(value => (Array.isArray(value) ? "[" + value.map(String).join(",") + "]" : Object.is(value, -0) ? "-0" : String(value))).join(" "));
}

////= bounds	: number[]): [number, number]
////= lastOf	: number[]): [number, number]
function divide(a: number, b: number): [number, number] {
  return [Math.floor(a / b), a % b];
}
function halves(a: number): [number, number, number] {
  return [a * 0.5, a * 0.25, a * 0.125];
}
function named(a: number, name: string): [number, string] {
  return [a + 1, name];
}

function byPattern(list: number[]) {
  const [low, high] = bounds(list);
  return high - low;
}
function byAssignment(list: number[]) {
  let low = 0;
  let high = 0;
  [low, high] = bounds(list);
  return high - low;
}
function byIndex(list: number[]) {
  return bounds(list)[1];
}
function byTwoIndexes(list: number[]) {
  const both = bounds(list);
  return both[1] - both[0];
}
function beyondTheEnd(list: number[]) {
  const both: number[] = bounds(list);
  const [a, b, c] = both;
  return String(a) + b + c + both[2] + both.length;
}
function withDefaults(list: number[]) {
  const [last = -5, count = -6] = lastOf(list);
  return last + ":" + count;
}

const whole = [3, 1, 2];
const holey: number[] = [3, 1, 2];
delete (holey as any)[1];
const withOther: number[] = [3, "x" as any, 2];
const withNaN = [3, NaN, 2];
const withMinusZero = [-0];
const empty: number[] = [];
////= for-3

let sum = 0;
////= for-2
say("sum", sum, divide(1, 0), divide(0, 0), divide(-1, 2), halves(NaN), halves(-0));

function local(i: number) {
  const pair = [i * 0.5, i + 1];
  return pair[0] - pair[1];
}
function localWithNaN(i: number) {
  const pair = [i / i, i + 1];
  return String(pair[0]) + pair[1] + pair.length + (pair[0] === pair[0]);
}
say("local", local(3), local(-0), localWithNaN(0), localWithNaN(2));

const kept: number[][] = [];
function keptOnOneWay(i: number) {
  const pair = divide(i, 3);
  const first = pair[0];
  if (i % 5 === 0) {
    kept.push(pair);
    pair[1] = 0.5;
  }
  return first + pair[1];
}
function keptThenRead(i: number) {
  const pair = [i * 0.5, i / (i - 2)];
  if (i === 2 || i === 4) kept.push(pair);
  return pair[0] + pair[1];
}
for (let i = 0; i < 12; i++) say("kept", keptOnOneWay(i), keptThenRead(i));
say(kept.length, ...kept, kept[0] === kept[1], kept[0] === kept[0]);

function written(i: number) {
  const pair = divide(i, 3);
  pair[0] = i === 4 ? (undefined as any) : i === 5 ? ("s" as any) : pair[1] * 1.5;
  pair[1]++;
  return String(pair[0]) + "," + pair[1];
}
function grown(i: number) {
  const pair: number[] = divide(i, 3);
  pair[3] = i;
  pair.length = i % 2 ? 1 : 4;
  return pair.length + ":" + String(pair[0]) + String(pair[2]) + String(pair[3]) + (2 in pair);
}
for (let i = 3; i < 8; i++) say("written", written(i), grown(i));

function withGetter(i: number) {
  const pair = divide(i, 3);
  let reads = 0;
  Object.defineProperty(pair, "0", { get() { reads++; return 40 + i; }, configurable: true });
  const [a, b] = pair;
  return a + b + pair[0] + ":" + reads;
}
function frozen(i: number) {
  const pair = Object.freeze(divide(i, 3)) as [number, number];
  let message = "stored";
  try {
    pair[0] = 9;
  } catch (error) {
    message = (error as Error).constructor.name;
  }
  return message + pair[0] + Object.isFrozen(pair);
}
say("getter", withGetter(4), withGetter(5), "frozen", frozen(7));

class Pair extends Array<number> {
  get spread() {
    return this[1] - this[0];
  }
}
function ofClass(a: number, b: number): Pair {
  const pair = new Pair();
  pair.push(a, b);
  return pair;
}
function readsClass(i: number) {
  const pair = ofClass(i, i * 2.5);
  const [a, b] = pair;
  return a + b + pair.spread + (pair instanceof Pair ? 0.25 : 0) + pair.length;
}
say("class", readsClass(2), readsClass(3), Array.isArray(ofClass(1, 2)), ofClass(1, 2).constructor === Pair);

function ownIterator(i: number) {
  const pair = divide(i, 3);
  if (i > 6)
    (pair as any)[Symbol.iterator] = function* () {
      yield 70;
      yield 80;
    };
  const [a, b] = pair;
  return a + "," + b + "," + pair[0];
}
say("iterator", ownIterator(5), ownIterator(7));

function* pairs(n: number): Generator<[number, number]> {
  for (let i = 0; i < n; i++) yield [i, i * i];
}
function listOfPairs(n: number): [number, number][] {
  const list: [number, number][] = [];
  for (let i = 0; i < n; i++) list.push([i, i * 0.5]);
  return list;
}
let total = 0;
for (const [key, value] of pairs(50)) total += value - key;
for (const [key, value] of listOfPairs(50)) total += value - key;
for (const [key, value] of new Map([[1, 2.5], [2, NaN]])) total += key + (value === value ? value : 1000);
for (const [key, value] of Object.entries({ a: 1, b: 2.5 })) total += key.length + value;
say("loops", total);

function same(i: number) {
  const a = divide(i, 3);
  const b = divide(i, 3);
  const c = i % 2 ? a : b;
  return String(a === b) + (c === a) + (c === b) + typeof a + Array.isArray(c) + JSON.stringify(c) + String(a) + Object.keys(b);
}
say("same", same(4), same(5));

function oneOfTwo(i: number, list: number[]) {
  const pair = i % 3 === 0 ? bounds(list) : i % 3 === 1 ? divide(i, 2) : lastOf(list);
  return pair[0] + pair[1];
}
for (let i = 0; i < 6; i++) say("one of", oneOfTwo(i, whole), oneOfTwo(i, holey), oneOfTwo(i, withOther));

console.log(lines.join("\n"));
//// pairs-of-numbers-that-are-only-read-and-pairs-that-somebody-looks-at-untyped.js
// Functions answer with a pair or a small tuple of numbers, and callers take it apart at once: by a pattern, by an assignment pattern, by an index.
// Beside them stand the callers that can tell whether there was an array: an element that is no number, NaN, a hole, a getter under an index,
// a class below Array, a pair that is kept on one way, a pair that is written to, an iterator of its own.
const lines = [];
function say(...values) {
  lines.push(values.map(value => (Array.isArray(value) ? "[" + value.map(String).join(",") + "]" : Object.is(value, -0) ? "-0" : String(value))).join(" "));
}

////= bounds	)
////= lastOf	)
function divide(a, b) {
  return [Math.floor(a / b), a % b];
}
function halves(a) {
  return [a * 0.5, a * 0.25, a * 0.125];
}
function named(a, name) {
  return [a + 1, name];
}

function byPattern(list) {
  const [low, high] = bounds(list);
  return high - low;
}
function byAssignment(list) {
  let low = 0;
  let high = 0;
  [low, high] = bounds(list);
  return high - low;
}
function byIndex(list) {
  return bounds(list)[1];
}
function byTwoIndexes(list) {
  const both = bounds(list);
  return both[1] - both[0];
}
function beyondTheEnd(list) {
  const both = bounds(list);
  const [a, b, c] = both;
  return String(a) + b + c + both[2] + both.length;
}
function withDefaults(list) {
  const [last = -5, count = -6] = lastOf(list);
  return last + ":" + count;
}

const whole = [3, 1, 2];
const holey = [3, 1, 2];
delete (holey)[1];
const withOther = [3, "x", 2];
const withNaN = [3, NaN, 2];
const withMinusZero = [-0];
const empty = [];
////= for-3

let sum = 0;
////= for-2
say("sum", sum, divide(1, 0), divide(0, 0), divide(-1, 2), halves(NaN), halves(-0));

function local(i) {
  const pair = [i * 0.5, i + 1];
  return pair[0] - pair[1];
}
function localWithNaN(i) {
  const pair = [i / i, i + 1];
  return String(pair[0]) + pair[1] + pair.length + (pair[0] === pair[0]);
}
say("local", local(3), local(-0), localWithNaN(0), localWithNaN(2));

const kept = [];
function keptOnOneWay(i) {
  const pair = divide(i, 3);
  const first = pair[0];
  if (i % 5 === 0) {
    kept.push(pair);
    pair[1] = 0.5;
  }
  return first + pair[1];
}
function keptThenRead(i) {
  const pair = [i * 0.5, i / (i - 2)];
  if (i === 2 || i === 4) kept.push(pair);
  return pair[0] + pair[1];
}
for (let i = 0; i < 12; i++) say("kept", keptOnOneWay(i), keptThenRead(i));
say(kept.length, ...kept, kept[0] === kept[1], kept[0] === kept[0]);

function written(i) {
  const pair = divide(i, 3);
  pair[0] = i === 4 ? (undefined) : i === 5 ? ("s") : pair[1] * 1.5;
  pair[1]++;
  return String(pair[0]) + "," + pair[1];
}
function grown(i) {
  const pair = divide(i, 3);
  pair[3] = i;
  pair.length = i % 2 ? 1 : 4;
  return pair.length + ":" + String(pair[0]) + String(pair[2]) + String(pair[3]) + (2 in pair);
}
for (let i = 3; i < 8; i++) say("written", written(i), grown(i));

function withGetter(i) {
  const pair = divide(i, 3);
  let reads = 0;
  Object.defineProperty(pair, "0", { get() { reads++; return 40 + i; }, configurable: true });
  const [a, b] = pair;
  return a + b + pair[0] + ":" + reads;
}
function frozen(i) {
  const pair = Object.freeze(divide(i, 3));
  let message = "stored";
  try {
    pair[0] = 9;
  } catch (error) {
    message = (error).constructor.name;
  }
  return message + pair[0] + Object.isFrozen(pair);
}
say("getter", withGetter(4), withGetter(5), "frozen", frozen(7));

class Pair extends Array {
  get spread() {
    return this[1] - this[0];
  }
}
function ofClass(a, b) {
  const pair = new Pair();
  pair.push(a, b);
  return pair;
}
function readsClass(i) {
  const pair = ofClass(i, i * 2.5);
  const [a, b] = pair;
  return a + b + pair.spread + (pair instanceof Pair ? 0.25 : 0) + pair.length;
}
say("class", readsClass(2), readsClass(3), Array.isArray(ofClass(1, 2)), ofClass(1, 2).constructor === Pair);

function ownIterator(i) {
  const pair = divide(i, 3);
  if (i > 6)
    (pair)[Symbol.iterator] = function* () {
      yield 70;
      yield 80;
    };
  const [a, b] = pair;
  return a + "," + b + "," + pair[0];
}
say("iterator", ownIterator(5), ownIterator(7));

function* pairs(n) {
  for (let i = 0; i < n; i++) yield [i, i * i];
}
function listOfPairs(n) {
  const list = [];
  for (let i = 0; i < n; i++) list.push([i, i * 0.5]);
  return list;
}
let total = 0;
for (const [key, value] of pairs(50)) total += value - key;
for (const [key, value] of listOfPairs(50)) total += value - key;
for (const [key, value] of new Map([[1, 2.5], [2, NaN]])) total += key + (value === value ? value : 1000);
for (const [key, value] of Object.entries({ a: 1, b: 2.5 })) total += key.length + value;
say("loops", total);

function same(i) {
  const a = divide(i, 3);
  const b = divide(i, 3);
  const c = i % 2 ? a : b;
  return String(a === b) + (c === a) + (c === b) + typeof a + Array.isArray(c) + JSON.stringify(c) + String(a) + Object.keys(b);
}
say("same", same(4), same(5));

function oneOfTwo(i, list) {
  const pair = i % 3 === 0 ? bounds(list) : i % 3 === 1 ? divide(i, 2) : lastOf(list);
  return pair[0] + pair[1];
}
for (let i = 0; i < 6; i++) say("one of", oneOfTwo(i, whole), oneOfTwo(i, holey), oneOfTwo(i, withOther));

console.log(lines.join("\n"));
//// results-handed-over-in-parts-or-whole-are-read-stored-kept-and-handed-on.ts
// Functions too large to take in answer with a literal whose members come out of loops over a list. A list with a gap sends them down a way on which a member is undefined.
// Their callers read, store, compare, keep and hand on what they get, with whole lists and lists with gaps in turn.
const kept: unknown[] = [];
function bounds(list: number[]) {
  let low = 1000;
  for (let i = 0; i < list.length; i++) if (list[i] < low) low = list[i];
  let high = -1000;
  for (let i = 0; i < list.length; i++) if (list[i] > high) high = list[i];
  let last: number | undefined;
  for (let i = 0; i < list.length; i++) last = list[i];
  return { low, high, last };
}
function firstAndLast(list: number[]) {
  let first = list[0], last = list[0], n = 0;
  for (let i = 0; i < list.length; i++) { last = list[i]; n++; }
  for (let i = list.length - 1; i >= 0; i--) first = list[i];
  return { first, last, n };
}
const callers: Record<string, (list: number[], key: string) => unknown> = {
  reads(list: number[]) { const b = bounds(list); return b.high - b.low; },
  readsAll(list: number[]) { const b = bounds(list); return b.high + "/" + b.low + "/" + b.last; },
  stores(list: number[]) { const b = bounds(list); b.low = b.high; b.high += 1; return b.low + b.high; },
  storesOtherKind(list: number[]) { const b = bounds(list); (b as any).low = "text"; return b.low + b.high; },
  adds(list: number[]) { const b = bounds(list); (b as any).extra = 5; return (b as any).extra + b.high; },
  deletes(list: number[]) { const b = bounds(list); delete (b as any).low; return String(b.low) + Object.keys(b); },
  keepsSometimes(list: number[]) { const b = bounds(list); if (b.last === undefined) kept.push(b); return b.high; },
  keepsOften(list: number[]) { const b = bounds(list); if (b.high > 5) kept.push(b); return b.low; },
  compares(list: number[]) { const b = bounds(list), c = bounds(list); return (b === c) + "" + (b === b) + (b.low === c.low); },
  inLoop(list: number[]) { let s = 0; for (let k = 0; k < 3; k++) { const b = bounds(list); s += b.high - b.low + k; } return s; },
  carried(list: number[]) { let b = bounds(list); for (let k = 0; k < 3; k++) { const c = bounds(list); if (c.high >= b.high) b = c; } return b.high + "" + b.last; },
  captured(list: number[]) { const b = bounds(list); const f = () => b.high; return f() + b.low; },
  destructured(list: number[]) { const { low, high, last = "none" } = bounds(list); return low + "," + high + "," + last; },
  spreads(list: number[]) { const c = { ...bounds(list), more: 1 }; return JSON.stringify(c); },
  text(list: number[]) { return JSON.stringify(bounds(list)); },
  keys(list: number[]) { let s = ""; const b = bounds(list); for (const k in b) s += k + (b as any)[k]; return s; },
  byKey(list: number[], key: string) { const b = bounds(list); return (b as any)[key]; },
  caught(list: number[]) { try { const b = bounds(list); if (b.last === undefined) throw b; return b.high; } catch (e) { return "caught " + (e as any).low; } },
  oneOfTwo(list: number[], key: string) { const b = key === "low" ? bounds(list) : firstAndLast(list); return b.last; },
  nested(list: number[]) { const b = bounds(list), f = firstAndLast(list); return { b, f }.b.high + f.n; },
  returned(list: number[]) { return bounds(list); },
  typeOf(list: number[]) { const b = bounds(list); return typeof b + typeof b.last; },
  has(list: number[]) { const b = bounds(list); return ("low" in b) + "" + b.hasOwnProperty("last"); },
};
function gap(): number[] { const a: number[] = [1]; a[2] = 3; return a; }
function empty(): number[] { const a: number[] = []; a.length = 2; return a; }
const lists: number[][] = [[3, 1, 2], [7, 8, 9, 6], gap(), empty(), [], [5], [2.5, 1], JSON.parse("[4,null]"), JSON.parse('["a","b"]'), gap()];
const lines = [];
for (const name in callers) {
  const f = callers[name];
  let s = "";
  for (let round = 0; round < 400; round++) {
    const list = round % 50 === 49 ? lists[2 + ((round / 50) | 0) % (lists.length - 2)] : lists[round & 1];
    let r = f(list, round & 2 ? "low" : "high");
    if (typeof r === "object") r = JSON.stringify(r);
    if (round % 50 >= 48) s += r + ";";
  }
  lines.push(name + " " + s);
}
lines.push("kept " + kept.length + " " + JSON.stringify(kept.slice(0, 3)) + JSON.stringify(kept.slice(-3)) + new Set(kept).size);
console.log(lines.join("\n"));
//// results-read-in-loops-of-code-that-runs-once.ts
// A module body and a function that is called once run once, and the loops in them do not: what a large function returns there is read, kept, compared and changed like any other object.
type Point = { x: number; y: number };
let noise = 0;
function pad(k: number): void { for (let i = 0; i < 3; i++) noise = (noise * 31 + k + i) % 1000003; }
function pads(): void { pad(1); pad(2); pad(3); pad(4); pad(5); pad(6); pad(7); pad(8); pad(9); pad(10); pad(11); pad(12); }

function make(a: number, b: number): Point { pads(); pad(a); pad(b); return { x: a + b, y: a - b }; }
// Too large to be inlined, and it returns what `make` returns.
function forwards(a: number): Point { pads(); pad(a); pad(a + 1); pad(a + 2); return make(a, a + 1); }
function forwardsOrNull(a: number): Point | null { pads(); pad(a); if (a % 3 === 0) return null; return make(a, 2); }

let read = 0;
for (let i = 0; i < 50; i++) { const p = forwards(i); read += p.x * 2 - p.y; }
console.log("read at the top level", read);

const kept: Point[] = [];
let previous: Point | null = null;
let same = 0;
for (let i = 0; i < 20; i++) {
  const p = forwards(i);
  if (p === previous) same++;
  previous = p;
  if (i % 4 === 0) kept.push(p);
}
for (const p of kept) p.x++;
console.log("kept at the top level", same, kept.length, kept.map(p => p.x + ":" + p.y).join(" "), new Set(kept).size);

function main(n: number): string {
  let sum = 0, nulls = 0;
  for (let i = 0; i < n; i++) {
    const p = forwardsOrNull(i);
    if (p === null) { nulls++; continue; }
    p.y += i;
    sum += p.x + p.y;
  }
  const once = forwards(n);
  let last = once;
  for (let i = 0; i < n; i++) { const p = forwards(i); if (p.x > last.x) last = p; }
  return [sum, nulls, once.x, once.y, last.x, last.y, last === once, Object.keys(last).join()].join(" ");
}
console.log("in a function that is called once", main(30));
console.log(noise);
//// returned-literals-different-key-order.ts
// A function returns `{ a, b }` on one path and `{ b, a }` on the other: the key order of each result is preserved.
declare const console: { log(...a: unknown[]): void };
function f(c: boolean): { a: number; b: number } { if (c) return { a: 1, b: 2 }; return { b: 4, a: 3 }; }
function use(c: boolean): number { const r = f(c); return r.a * 10 + r.b; }
console.log(use(true), use(false), Object.keys(f(true)).join(), Object.keys(f(false)).join());
//// returned-literals-same-key-order.ts
// A function returns an object literal with the same keys in the same order on both paths.
declare const console: { log(...a: unknown[]): void };
function f(c: boolean): { a: number; b: number } { if (c) return { a: 1, b: 2 }; return { a: 3, b: 4 }; }
function use(c: boolean): number { const r = f(c); return r.a * 10 + r.b; }
console.log(use(true), use(false), Object.keys(f(false)).join());
//// returned-object-from-many-returns.ts
// A function returns a fresh one-field object from many `return` statements, also after `??`, `||` and `&&`; it is called directly and as a value, and the result is kept, tested and read.
declare const console: { log(...v: unknown[]): void };
type Result = { done: boolean };
type Cmd = { id: number, mode: string, text: string };
class Queue {
    items: Cmd[] = [];
    peek(f: (c: Cmd) => boolean): Cmd | undefined { for (const c of this.items) if (f(c)) return c; return undefined; }
}
type Params = { queue: Queue, run: (c: Cmd[]) => void, waits?: (c: Cmd) => boolean, stale?: number };
let busy: number | undefined = undefined;
let ran: string[] = [];
function pending(): number | undefined { return busy; }
function first(q: Queue): Cmd | undefined { return q.items.length ? q.items[0] : undefined; }
function a(c: Cmd): boolean { return c.id > 1; }
function b(id: number): boolean { return (id & 1) === 1; }
function slash(c: Cmd): boolean { return c.text.charCodeAt(0) === 47; }
function alone(q: Queue, c: Cmd, run: (c: Cmd[]) => void): void { q.items = q.items.filter(x => x !== c); run([c]); }
function all(q: Queue, mode: string, run: (c: Cmd[]) => void): number { const same = q.items.filter(x => x.mode === mode); q.items = q.items.filter(x => x.mode !== mode); run(same); return same.length; }
export function step({ queue, run, waits = () => true, stale }: Params): Result {
    if (pending() !== undefined) {
        const own = queue.peek(c => a(c) && b(c.id));
        const head = own ?? first(queue);
        if (!head || (own === undefined && waits(head))) { return { done: false } }
        alone(queue, head, run);
        return { done: true }
    }
    const next = first(queue);
    if (!next) { return { done: false } }
    if (slash(next) || next.mode === "x") { alone(queue, next, run); return { done: true } }
    if (stale !== undefined && next.id < stale) { queue.items.shift(); return { done: queue.items.length > 0 } }
    if (next.mode === "y" && !waits(next)) { return { done: all(queue, "y", run) > 1 } }
    if (next.text.length > 6) { alone(queue, next, run); return { done: false } }
    if (next.mode === "z") { return { done: true } }
    all(queue, next.mode, run);
    return { done: true }
}
const make = (seed: number): Queue => { const q = new Queue(); for (let i = 0; i < 6; i++) { const k = seed * 7 + i * 3; q.items.push({ id: k % 5, mode: "wxyz"[k & 3], text: (k % 3 ? "" : "/") + "t".repeat(k % 9) }); } return q; };
const run = (c: Cmd[]): void => { ran.push(c.map(x => x.id + x.mode).join("")); };
(globalThis as any).kept = [step];
// A value from untyped code also gets the type Result, which opens the type at that position: any object can have it.
const stranger: Result = (globalThis as any).given ?? { done: true };
const strangers: Result[] = [stranger];
const byValue: ((p: Params) => Result)[] = [step];
let out = "";
for (let seed = 0; seed < 24; seed++) {
    const q = make(seed); busy = seed & 4 ? seed : undefined;
    for (let i = 0; i < 8; i++) {
        const p: Params = { queue: q, run, waits: seed & 1 ? c => c.id > 2 : undefined, stale: seed & 2 ? 2 : undefined };
        if (step(p).done) out += "1"; else out += "0";               // read
        const kept = step(p); out += kept.done ? "a" : "b"; (globalThis as any).last = kept;   // kept
        out += byValue[0](p).done ? "A" : "B";                      // by value
        const { done } = step(p); if (!done && !q.items.length) break;
    }
    out += ".";
}
console.log(out); console.log(ran.join()); console.log(strangers.map(r => r.done).join()); console.log(JSON.stringify((globalThis as any).last));
//// returned-object-literals-destructured-by-caller.ts
// Functions that return a fresh object literal, whose callers destructure it, read some of it, keep it, or never look at it.
const say = (what: string, got: unknown) => console.log(what + ": " + (typeof got === "string" ? got : JSON.stringify(got) ?? String(got)));
const keep: unknown[] = []; let spins = 0;
const busy = (n: number) => { let s = 0; for (let i = 0; i < (n & 3) + 1; i++) { s += i * 3; if (s > 1e9) s = 0; spins++; } for (let j = 0; j < 2; j++) { s ^= j; if (s < -1e9) s = 1; } return s; };
function divmod(a: number, b: number) { let q = 0, r = a; while (r >= b) { r -= b; q++; if (q > 1e9) break; } for (let i = 0; i < 2; i++) spins += i; return { q, r }; }
function minmax(list: number[]) { let lo = Infinity, hi = -Infinity, n = 0; for (const x of list) { if (x < lo) lo = x; if (x > hi) hi = x; n++; } for (let i = 0; i < 2; i++) spins += i; return { lo, hi, n }; }
function parse(text: string) {
  if (!text) { busy(1); return { ok: false, value: 0, rest: "" }; }
  let i = 0, value = 0; while (i < text.length && text.charCodeAt(i) >= 48 && text.charCodeAt(i) <= 57) { value = value * 10 + text.charCodeAt(i) - 48; i++; }
  if (!i) { busy(2); return { ok: false, value: -1, rest: text }; }
  busy(3); return { ok: true, value, rest: text.slice(i) };
}
function kinds(n: number) { busy(n); busy(n + 1); return { s: "s" + n, i: n | 0, d: n + 0.5, b: n > 1, o: { in: n }, a: [n], u: undefined, f: () => n * 2 }; }
function one(n: number) { let s = 0; for (let i = 0; i <= n; i++) { s += i; if (s > 1e9) s = 0; } for (let i = 0; i < 2; i++) spins += i; return { only: s }; }
function fib(n: number): { a: number; b: number } { busy(n); if (n === 0) return { a: 0, b: 1 }; const { a, b } = fib(n - 1); busy(n); return { a: b, b: a + b }; }
function sometimesThrows(n: number) { busy(n); busy(n); if (n === 3) throw new RangeError("three"); return { n, twice: n * 2 }; }
function intsOrDoubles(n: number) { busy(n); busy(n); return { v: n % 2 ? n : n + 0.25, w: n % 2 ? "odd" : n }; }
say("destructured", (() => { const { q, r } = divmod(17, 5); const { lo, hi, n } = minmax([3, 1, 4, 1, 5]); return [q, r, lo, hi, n]; })());
say("read by name", (() => { const d = divmod(29, 4); let s = 0; for (let i = 0; i < d.q; i++) s += d.r; return [d.q, d.r, s, d.q > 3 ? d.r : d.q]; })());
say("some of them", (() => { const { r } = divmod(9, 2); const m = minmax([2]); divmod(1, 1); return [r, m.n]; })());
say("several ways out", [parse(""), parse("x1"), parse("42rest")].length + " " + (() => { const a = parse(""), b = parse("x1"), c = parse("42rest"); return [a.ok, a.value, a.rest, b.ok, b.value, b.rest, c.ok, c.value, c.rest].join(); })());
say("of every kind", (() => { const { s, i, d, b, o, a, u, f } = kinds(2); return [s, i, d, b, o, a, u === undefined, f(), typeof f]; })());
say("just one", (() => { const { only } = one(4); return only + one(3).only; })());
say("calls itself", (() => { const { a, b } = fib(20); return [a, b]; })());
say("under other names, with something to fall back on", (() => { const { q: quotient, r: remainder = 7 } = divmod(8, 3); const { u = "fallback", s: text = "no" } = kinds(1); return [quotient, remainder, u, text]; })());
say("taken apart further", (() => { const { o: { in: inner }, a: [first] } = kinds(5); return [inner, first]; })());
say("throws", (() => { const out: unknown[] = []; for (let i = 1; i < 5; i++) { try { const { n, twice } = sometimesThrows(i); out.push(n + twice); } catch (e) { out.push((e as Error).message); } } return out; })());
say("now one kind of thing, now another", (() => { const out: unknown[] = []; for (let i = 0; i < 4; i++) { const { v, w } = intsOrDoubles(i); out.push(v, w, typeof w); } return out; })());
say("in the arguments of another", (() => Math.max(divmod(20, 3).q, divmod(20, 3).r) + divmod(divmod(100, 7).q, divmod(100, 7).r).q)());
function wantedByOne(n: number) { busy(n); busy(n); return { a: n, b: n + 1 }; }
say("wanted by one of those who call it", (() => { const { a } = wantedByOne(1); keep.push(wantedByOne(2)); return [a, keep]; })());
function otherNames(n: number) { busy(n); busy(n); if (n) return { a: n, b: 1 }; return { a: n, c: 2 }; }
say("other names", (() => { const x = otherNames(1) as { a: number; b?: number; c?: number }, y = otherNames(0) as { a: number; b?: number; c?: number }; return [x.a, x.b, x.c, y.a, y.b, y.c]; })());
function otherOrder(n: number) { busy(n); busy(n); if (n) return { a: n, b: 1 }; return { b: 2, a: n }; }
say("another order", (() => { const x = otherOrder(1), y = otherOrder(0); return [x.a, x.b, y.a, y.b, Object.keys(otherOrder(0)).join()]; })());
function orNothing(n: number) { busy(n); busy(n); if (n) return { a: n }; return null; }
say("or nothing", (() => { const x = orNothing(1), y = orNothing(0); return [x?.a, y?.a, y === null]; })());
function orNothingSaid(n: number): { a: number } | undefined { busy(n); busy(n); if (n) return { a: n }; }
say("or nothing said", [orNothingSaid(1)?.a, orNothingSaid(0)?.a]);
function aVariable(n: number) { busy(n); busy(n); const o = { a: n, b: 2 }; o.b = 3; return o; }
say("changed first", (() => { const { a, b } = aVariable(1); return [a, b]; })());
function seenFirst(n: number) { busy(n); busy(n); const o = { a: n }; keep.push(o); return o; }
say("seen first", (() => { const { a } = seenFirst(5); return [a, keep.length]; })());
function handsOn(n: number) { busy(n); return divmod(n, 2); }
say("what another returns", (() => { const { q, r } = handsOn(9); return [q, r]; })());
async function later(n: number) { busy(n); busy(n); return { a: n, b: n + 1 }; }
later(1).then(({ a, b }) => say("after an await", [a, b]));
function* many(n: number) { busy(n); yield { a: n }; return { a: n + 1 }; }
say("a generator", (() => { const g = many(1); return [g.next(), g.next()]; })());
function asACallback(n: number) { busy(n); busy(n); return { a: n, b: n * n }; }
say("handed to something that calls it", [1, 2].map(asACallback).map(({ a, b }) => a + b));
function calledOtherwise(this: unknown, n: number) { busy(n); busy(n); return { a: n, t: typeof this }; }
say("called some other way", (() => { const { a } = calledOtherwise(1); const x = calledOtherwise.call("s", 2), y = calledOtherwise.apply(null, [3]), z = calledOtherwise.bind(4)(5), w = calledOtherwise(...([6] as [number])); return [a, x, y, z, w]; })());
function constructed(this: { own?: number }, n: number) { busy(n); busy(n); this.own = n; return { a: n }; }
say("constructed with", (() => { const o = new (constructed as any)(1); return [o, o.own]; })());
function missing(n: number) { busy(n); busy(n); return { a: n } as { a: number; z?: number }; }
say("asked for what is not there", (() => { const { a, z = 9 } = missing(1); return [a, z, typeof missing(2).toString]; })());
function nine(n: number) { busy(n); busy(n); return { a: n, b: n, c: n, d: n, e: n, f: n, g: n, h: n, i: n + 1 }; }
say("too many", (() => { const { a, i } = nine(1); return [a, i]; })());
function withMore(n: number) { busy(n); busy(n); return { a: n, ...(n ? { b: 1 } : {}) }; }
say("with more spread in", (() => { const { a } = withMore(1); return a; })());
