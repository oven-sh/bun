//// three-literals-built-on-a-rare-path-and-every-pass-is-verified.ts
// Three literals; two of them hold a field that is a slice; the object is built on a rare path behind the join.
type Split = { name: string; place?: string; size?: number };
////= split
const kept: Split[] = [];
// Too large to be inlined.
////= keep
const ids = ["plain", "a@north", "", "@", "a@", "a@b@c", "longer-without-a-mark", "x@y", "@south", "plain"];

function use(id: string, turn: number): number {
  const parts = split(id);
  if (parts.name.length === turn % 700) keep(parts);
  return parts.name.length + (turn & 1);
}
let total = 0;
