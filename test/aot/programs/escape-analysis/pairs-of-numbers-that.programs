  if (isKept(list)) hold(list, x => { n += x; }); else list.forEach(x => { n += x; });
  const first = f();
  if (saved.length) saved[saved.length - 1](1000);
  return first + ":" + f() + ":" + n;
}
function doneAheadOfTheMove(list: number[], flag: boolean): string {
  let n = 0;
  const a = (): number => ++n;
  const b = (): number => n + 100;
  const f = flag ? a : b;
  const first = f() + f();
  if (isKept(list)) hold(list, x => { n += x; }); else list.forEach(x => { n += x; });
  if (saved.length) saved[saved.length - 1](1000);
  return first + ":" + n;
}
