// More Structures than the engine remembers: functions with a read-only prototype, used as prototypes, with other properties first, generators, async functions, classes, arrows, bound functions.
const log = [];
const functions = [];
function plain() { return this === undefined ? "none" : this.v; }
function constructed() { this.made = true; return undefined; }
function asParent() { return this.v; }
function withProperty() { return this.v; }
withProperty.extra = 1;
function* generator() { yield this.v; }
async function asynchronous() { return this.v; }
class Class { static call(self) { return "static call " + self.v; } }
const arrow = () => "arrow";
const bound = plain.bind({ v: "bound this" });
new constructed();
Object.setPrototypeOf(function child() {}, asParent);
for (const f of [plain, constructed, asParent, withProperty, generator]) functions.push(f.prototype === undefined ? "no prototype" : typeof f.prototype);
const self = { v: "v" };
for (let i = 0; i < 30; i++) {
  log.length = 0;
  log.push(plain.call(self), String(constructed.call(self)), asParent.call(self), withProperty.call(self), generator.call(self).next().value, typeof asynchronous.call(self).then, Class.call(self), arrow.call(self), bound.call(self));
}
withProperty.call = () => "own";
log.push(withProperty.call(self), functions.join());
console.log(log.join(" | "));
//// members-are-stored-through-another-name-for-the-new-prototype-of-a-constructor-function.js
// A constructor function gets a new object as its prototype, and its members are stored through another name for that object. Classes below it read those members as values and call them.
////= lines-3	Emitter
const EmitterPrototype = (Emitter.prototype = {});
EmitterPrototype.constructor = Emitter;
EmitterPrototype.listeners = undefined;
EmitterPrototype.limit = 10;
EmitterPrototype.emit = function emit(value) {
  this.count += value;
  return this.listeners !== undefined;
};
const emit = EmitterPrototype.emit;
function Stream(name) {
  Emitter.call(this);
  this.name = name;
  this.ended = false;
  this.size = 0;
}
Object.setPrototypeOf(Stream.prototype, Emitter.prototype);
Object.setPrototypeOf(Stream, Emitter);
function isUnheard(stream) {
  if (stream.emit !== emit) return false;
  if (stream.listeners !== undefined) return false;
  return stream.count < stream.limit * 1000000 && !stream.ended && stream.size === 0 && stream.name.length > 0;
}
globalThis.kept = [Emitter, Stream, isUnheard];
const streams = [new Stream("a"), new Stream("bc"), new Stream("def")];
const rounds = Number(process.argv[2] ?? 1000);
let sum = 0;
for (let i = 0; i < rounds; i++) {
  const stream = streams[i % 3];
  if (isUnheard(stream)) sum += 1;
  stream.emit(1);
}
console.log(sum, streams[0].count, streams[2].count);
