//// a-function-stored-as-the-prototype-of-a-function-is-read-back-by-a-dot-and-called-in-a-loop/main.mjs
// A function stored as the prototype of a function is read back by a dot and called in a loop.
function h() {}
h.prototype = function () { return 1; };
const q = h.prototype;
const other = function () { return 2; };
function g(v) { return typeof v === "function" ? v() : typeof v; }
async function show(x) { x = await x; return x !== null && typeof x === "object" && typeof x.next === "function" ? [...x].join() : String(x); }
const out = [];
for (const f of [q, other]) { try { out.push(await show(g(f))); } catch (e) { out.push(e.constructor.name); } }
console.log(out.join(" "));
