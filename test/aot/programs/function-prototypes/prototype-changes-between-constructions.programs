//// prototype-changes-between-constructions-of-a-function-without-fields.js
// Constructor functions with no `this.x = ..` and no `F.prototype.x = ..`. Each is constructed several times before and after every change, so a cached allocation would show.
const lines = [];
function report(label, ...values) {
  lines.push(label + ": " + values.map(String).join(" "));
}
function describe(F, expected) {
  let matches = 0;
  for (let i = 0; i < 6; i++) {
    const made = new F({ a: i });
    if (Object.getPrototypeOf(made) === expected) matches++;
  }
  return matches;
}

function Assigned(from) { Object.assign(this, from); }
const firstAssigned = Assigned.prototype;
report("as created", describe(Assigned, firstAssigned), new Assigned({ a: 1 }) instanceof Assigned, new Assigned({ a: 2 }).a);
const second = { tag: "second" };
Assigned.prototype = second;
report("after a store", describe(Assigned, second), describe(Assigned, firstAssigned), new Assigned({}).tag);
Assigned.prototype = firstAssigned;
report("stored back", describe(Assigned, firstAssigned), describe(Assigned, second));

function Defined() {}
report("defined, before", describe(Defined, Defined.prototype));
const third = { tag: "third" };
Object.defineProperty(Defined, "prototype", { value: third });
report("Object.defineProperty", describe(Defined, third), new Defined().tag);
const fourth = { tag: "fourth" };
report("Reflect.defineProperty", Reflect.defineProperty(Defined, "prototype", { value: fourth }), describe(Defined, fourth));
const fifth = { tag: "fifth" };
report("Reflect.set", Reflect.set(Defined, "prototype", fifth), describe(Defined, fifth));
const sixth = { tag: "sixth" };
Object.assign(Defined, { prototype: sixth });
report("Object.assign", describe(Defined, sixth));
const key = ["proto", "type"].join("");
const seventh = { tag: "seventh" };
Defined[key] = seventh;
report("a computed key", describe(Defined, seventh));

function Primitive() {}
report("primitive, before", describe(Primitive, Primitive.prototype));
for (const value of [1, "text", null, undefined, true, Symbol.iterator, 10n]) {
  Primitive.prototype = value;
  report("prototype is " + typeof value, describe(Primitive, Object.prototype));
}
const eighth = { tag: "eighth" };
Primitive.prototype = eighth;
report("an object again", describe(Primitive, eighth));

function Locked() {}
report("locked, before", describe(Locked, Locked.prototype));
const lockedPrototype = Locked.prototype;
Object.defineProperty(Locked, "prototype", { writable: false });
let refusal = "stored";
try { Locked.prototype = { tag: "refused" }; } catch (error) { refusal = error.constructor.name; }
report("read-only", refusal, describe(Locked, lockedPrototype), Reflect.set(Locked, "prototype", {}));
Object.freeze(Locked);
report("frozen", describe(Locked, lockedPrototype));

function Crowded() {}
report("crowded, before", describe(Crowded, Crowded.prototype));
for (let i = 0; i < 200; i++) Crowded["p" + i] = i;
report("many properties", describe(Crowded, Crowded.prototype));
for (let i = 0; i < 200; i += 2) delete Crowded["p" + i];
report("after deletions", describe(Crowded, Crowded.prototype));
const ninth = { tag: "ninth" };
Crowded.prototype = ninth;
report("stored on a dictionary", describe(Crowded, ninth));
Crowded.later = 1;
const tenth = { tag: "tenth" };
Crowded.prototype = tenth;
report("stored again", describe(Crowded, tenth));

function make() { return function Made() {}; }
const made = [make(), make(), make()];
report("closures of one function", made.map(F => describe(F, F.prototype)).join(","), made[0].prototype === made[1].prototype);
made[1].prototype = second;
report("one of them changed", made.map((F, i) => describe(F, i === 1 ? second : F.prototype)).join(","));
let mixed = 0;
for (let i = 0; i < 30; i++) {
  const F = made[i % 3];
  if (Object.getPrototypeOf(new F()) === F.prototype) mixed++;
}
report("taken in turn", mixed);

function Target() {}
function Other() {}
report("targets, before", describe(Target, Target.prototype), describe(Other, Other.prototype));
let reflected = 0;
for (let i = 0; i < 12; i++) {
  const viaOther = Reflect.construct(Target, [], Other);
  const viaSelf = Reflect.construct(Target, [], Target);
  const plain = new Target();
  if (Object.getPrototypeOf(viaOther) === Other.prototype && Object.getPrototypeOf(viaSelf) === Target.prototype && Object.getPrototypeOf(plain) === Target.prototype) reflected++;
}
report("Reflect.construct", reflected);
class Below extends Target {}
report("a class below", describe(Below, Below.prototype), new Below() instanceof Target);
const bound = Target.bind(null);
report("bound", Object.getPrototypeOf(new bound()) === Target.prototype, Object.getPrototypeOf(Reflect.construct(bound, [], Other)) === Other.prototype);
const proxied = new Proxy(Target, {});
report("through a proxy", Object.getPrototypeOf(new proxied()) === Target.prototype);
let reads = 0;
const counting = new Proxy(Target, { get(target, name, receiver) { if (name === "prototype") reads++; return Reflect.get(target, name, receiver); } });
for (let i = 0; i < 5; i++) new counting();
report("reads of prototype through a proxy", reads);

function Collected() {}
let survived = 0;
for (let round = 0; round < 4; round++) {
  const replacement = { round };
  Collected.prototype = replacement;
  for (let i = 0; i < 4; i++) if (Object.getPrototypeOf(new Collected()) === replacement) survived++;
  Bun.gc(true);
  for (let i = 0; i < 4; i++) if (Object.getPrototypeOf(new Collected()) === replacement) survived++;
}
report("across collections", survived);

function Inherits() {}
Object.setPrototypeOf(Inherits, { prototype: { tag: "inherited" } });
report("its own prototype property wins", describe(Inherits, Inherits.prototype), new Inherits().tag);

function Returns(value) { return value; }
const handed = { tag: "handed" };
report("returns another object", new Returns(handed) === handed, Object.getPrototypeOf(new Returns(1)) === Returns.prototype, Object.getPrototypeOf(new Returns(1)) === Returns.prototype);

function Changing() { Changing.prototype = Changing.next; }
Changing.next = { tag: "next" };
const before = Changing.prototype;
const one = new Changing();
const two = new Changing();
Changing.next = { tag: "after" };
const three = new Changing();
const four = new Changing();
report("changed by the constructor itself", Object.getPrototypeOf(one) === before, two.tag, three.tag, four.tag);

console.log(lines.join("\n"));
//// reflect-construct-with-another-new-target.js
// Reflect.construct runs one plain function with another as new.target: the object lies below the prototype object of the second.
function Meter() { seen.push(new.target === Other, this instanceof Other, this instanceof Meter, typeof this.name); }
function Other() {}
const seen = [];
Meter.prototype.name = function () { return 1; };
Other.prototype.name = function () { return "other"; };
const made = Reflect.construct(Meter, [], Other);
const plain = new Meter();
console.log(seen.join(), typeof made.name(), typeof plain.name(), Object.getPrototypeOf(made) === Other.prototype);
//// reflect-construct-with-another-new-target-and-the-function-went-through-a-call.js
// Reflect.construct runs one plain function with another as new.target: the object lies below the prototype object of the second. The build does not see under which name the function is constructed.
function hide(callable) { return callable; }
const Meter = hide(function Meter() { seen.push(new.target === Other, this instanceof Other, this instanceof Meter, typeof this.name); });
const Other = hide(function Other() {});
const seen = [];
Meter.prototype.name = function () { return 1; };
Other.prototype.name = function () { return "other"; };
const made = Reflect.construct(Meter, [], Other);
const plain = new Meter();
console.log(seen.join(), typeof made.name(), typeof plain.name(), Object.getPrototypeOf(made) === Other.prototype);
//// shared-prototype-object.js
const out = [];
function count(name, test) { let yes = 0; for (let i = 0; i < 20000; i++) if (test()) yes++; out.push(name + " " + yes); }

function A1() { this.x = 1; } function B1() { this.y = 2; }
const shared1 = { hello() { return "hi"; } };
A1.prototype = shared1; B1.prototype = shared1;
let a1 = new A1(), b1 = new B1();
function a1IsB1() { return a1 instanceof B1; } function b1IsA1() { return b1 instanceof A1; }

function A2() { this.x = 1; } function B2() { this.y = 2; }
const shared2 = { hello() { return "hi"; } };
A2.prototype = shared2; B2.prototype = shared2;
let b2 = new B2(), a2 = new A2();
function a2IsB2() { return a2 instanceof B2; } function b2IsA2() { return b2 instanceof A2; }

function A3() { this.x = 1; } function B3() { this.y = 2; }
B3.prototype = A3.prototype;
let a3 = new A3();
function a3IsB3() { return a3 instanceof B3; }

function jQuery(s) { return new jQuery.fn.init(s); }
jQuery.fn = jQuery.prototype = { constructor: jQuery };
jQuery.fn.init = function (s) { this.s = s; };
jQuery.fn.init.prototype = jQuery.fn;
let q4 = jQuery("a");
function q4IsJQuery() { return q4 instanceof jQuery; }

class C5 { constructor() { this.x = 1; } } function D5() { this.y = 2; }
D5.prototype = C5.prototype;
let c5 = new C5(), d5 = new D5();
function c5IsD5() { return c5 instanceof D5; } function d5IsC5() { return d5 instanceof C5; }

class C11 { constructor() { this.x = 1; } } function D11() { this.y = 2; }
D11.prototype = C11.prototype;
let d11 = new D11(), c11 = new C11();
function c11IsD11() { return c11 instanceof D11; } function d11IsC11() { return d11 instanceof C11; }

function B6() { this.y = 2; }
B6.prototype = Object.prototype;
let r6 = { x: 1 }, b6 = new B6();
function r6IsB6() { return r6 instanceof B6; }

function A7() { this.x = 1; } function B7() { this.y = 2; }
const above7 = { up() { return 1; } };
A7.prototype = Object.create(above7); B7.prototype = above7;
let a7 = new A7(), b7 = new B7();
function a7IsB7() { return a7 instanceof B7; }

function A8() { this.x = 1; } function B8() { this.y = 2; }
let a8 = new A8(), b8 = new B8();
function a8IsB8() { return a8 instanceof B8; }

function A9() { this.x = 1; } function B9() { this.y = 2; }
let b9 = new B9();
A9.prototype = B9.prototype;
let a9 = new A9();
function a9IsB9() { return a9 instanceof B9; } function b9IsA9() { return b9 instanceof A9; }

function A10() { this.x = 1; } function M10() {} function B10() { this.y = 2; }
M10.prototype = A10.prototype; B10.prototype = M10.prototype;
let a10 = new A10(), b10 = new B10();
function a10IsB10() { return a10 instanceof B10; } function a10IsM10() { return a10 instanceof M10; } function b10IsA10() { return b10 instanceof A10; }

function storeFromOutside(text) {
  const v = JSON.parse(text);
  if (!v) return;
  a1 = v.a1; b1 = v.b1; a2 = v.a2; b2 = v.b2; a3 = v.a3; q4 = v.q4; c5 = v.c5; d5 = v.d5; r6 = v.r6; a7 = v.a7; a8 = v.a8; a9 = v.a9; b9 = v.b9; a10 = v.a10; b10 = v.b10; c11 = v.c11; d11 = v.d11;
}
storeFromOutside(process.argv.length > 5 ? "{}" : "null");

count("a1IsB1", a1IsB1); count("b1IsA1", b1IsA1); count("a2IsB2", a2IsB2); count("b2IsA2", b2IsA2); count("a3IsB3", a3IsB3); count("q4IsJQuery", q4IsJQuery);
count("c5IsD5", c5IsD5); count("d5IsC5", d5IsC5); count("r6IsB6", r6IsB6); count("a7IsB7", a7IsB7);
count("a8IsB8 before", a8IsB8); B8.prototype = A8.prototype; count("a8IsB8 after", a8IsB8);
count("a9IsB9", a9IsB9); count("b9IsA9", b9IsA9); count("a10IsB10", a10IsB10); count("a10IsM10", a10IsM10); count("b10IsA10", b10IsA10);
count("c11IsD11", c11IsD11); count("d11IsC11", d11IsC11);
console.log(out.join("\n"));
//// the-constructor-property-is-overwritten.js
// Another function is stored as `constructor` on the prototype object of a plain function, and code constructs what an instance names as its constructor.
function Meter() { return undefined; }
function Other() {}
Other.prototype.name = function () { return "other"; };
Meter.prototype.name = function () { return "meter"; };
const meter = new Meter();
const first = new meter.constructor().name();
Meter.prototype.constructor = Other;
console.log(first, new meter.constructor().name(), meter.constructor === Other, meter instanceof Meter);
//// the-constructor-property-is-overwritten-and-the-function-went-through-a-call.js
// Another function is stored as `constructor` on the prototype object of a plain function, and code constructs what an instance names as its constructor. The build does not see under which name the function is constructed.
function hide(callable) { return callable; }
const Meter = hide(function Meter() { return undefined; });
const Other = hide(function Other() {});
Other.prototype.name = function () { return "other"; };
Meter.prototype.name = function () { return "meter"; };
const meter = new Meter();
const first = new meter.constructor().name();
Meter.prototype.constructor = Other;
console.log(first, new meter.constructor().name(), meter.constructor === Other, meter instanceof Meter);
//// the-default-changes-between-two-stores-of-one-constructor.js
// The change comes in the middle of a constructor, between the test and the store.
const log = [];
let arm = false;
function poke() {
  if (arm) {
    arm = false;
    Object.defineProperty(Message.prototype, "method", { set(v) { log.push("set method " + v); }, get() { return "getter"; }, configurable: true });
  }
  return 7;
}
function Message(url, method) {
  this.url = url;
  this.extra = poke();
  this.method = method;
}
Message.prototype.url = "";
Message.prototype.method = null;
let last;
for (let i = 0; i < 60; i++) last = new Message("/" + i, "GET");
log.push(Object.keys(last).join(), last.method);
arm = true;
last = new Message("/x", "POST");
log.push(Object.keys(last).join(), last.method);
last = new Message("/y", "PUT");
log.push(Object.keys(last).join(), last.method);
console.log(log.join(" | "));
//// the-length-and-the-name-of-a-function-are-what-the-program-made-of-them.js
// `f.length` and `f.name` answer with what the function was written with until the program defines them anew, deletes them or hands the function to code that does.
const lines = [];
const say = (...parts) => lines.push(parts.join(" "));
function three(a, b, c) {}
function withDefault(a, b = 1, c) {}
function withRest(a, ...rest) {}
const arrow = (a, b) => a;
const named = function inner(a) {};
const holder = { method(a, b, c, d) {}, get got() { return 1; }, ["comp" + "uted"](a) {}, plain: function () {}, [Symbol.iterator]() {} };
async function later(a) {}
function* steps(a, b) {}
class Shape { constructor(a, b) {} static make(a) {} area(a, b, c) {} }
class Odd { static length = 9; static name = "odd"; }
class OddMethods { static name() { return "called"; } }
for (let round = 0; round < 2; round++) {
  say(three.length, three.name, withDefault.length, withRest.length, arrow.length, arrow.name, named.name, named.length);
  say(holder.method.length, holder.method.name, Object.getOwnPropertyDescriptor(holder, "got").get.name, holder.computed.name, holder.plain.name, holder[Symbol.iterator].name);
  say(later.length, later.name, steps.length, steps.name, Shape.length, Shape.name, Shape.make.length, Shape.make.name, Shape.prototype.area.length, Odd.length, Odd.name, typeof OddMethods.name);
  say(three.bind(null, 1).length, three.bind(null).name, arrow.bind(null, 1, 2, 3).length);
}
function redefined(a, b) {}
say(redefined.length, redefined.name);
Object.defineProperty(redefined, "length", { value: 40 });
Object.defineProperty(redefined, "name", { value: "other" });
say(redefined.length, redefined.name);
function deleted(a, b) {}
say(delete deleted.length, delete deleted.name, deleted.length, JSON.stringify(deleted.name), Object.hasOwn(deleted, "length"));
function stored(a) {}
try {
  stored.length = 5;
} catch (error) {
  say(error.name);
}
try {
  stored.name = "no";
} catch (error) {
  say(error.name);
}
say(stored.length, stored.name);
function below(a, b, c) {}
delete below.length;
Object.setPrototypeOf(below, { length: "inherited", name: "up" });
say(below.length, below.name);
function changedByKey(a) {}
const key = ["len", "gth"].join("");
Object.defineProperty(changedByKey, key, { value: 77 });
say(changedByKey.length);
function changedElsewhere(a) {}
const change = target => Object.defineProperty(target, "name", { get() { return "got"; } });
say(changedElsewhere.name);
change(changedElsewhere);
say(changedElsewhere.name);
function handedOut(a, b) {}
globalThis.taken = handedOut;
new Function("Object.defineProperty(taken, 'length', { value: 12 })")();
say(handedOut.length);
function made() { return function inner(a, b) {}; }
const first = made(), second = made();
Object.defineProperty(first, "length", { value: 1 });
say(first.length, second.length, first.name, second.name);
for (const called of [three, withDefault, withRest, arrow, named, holder.method, holder.computed, holder.plain, later, steps, redefined, deleted, stored, below, changedByKey, changedElsewhere, handedOut, first, second]) called(1, 2);
say(three.length, three.name, redefined.length, redefined.name, deleted.length, below.length, changedByKey.length, changedElsewhere.name, handedOut.length, first.length, second.length);
console.log(lines.join("\n"));
