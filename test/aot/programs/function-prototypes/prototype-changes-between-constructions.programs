//// the-prototype-property-is-assigned-twice-with-a-class-between.js
// The class is linked to the first object. The test looks at the second, which the function has by then.
function Meter() {}
Meter.prototype = { read() { return "first"; } };
class Fine extends Meter {}
Meter.prototype = { read() { return "second"; } };
console.log(new Meter().read(), new Fine() instanceof Meter);
//// the-prototype-property-is-read-under-a-key-made-at-run-time.js
// The prototype property of a plain function is read and stored under a key that is put together at run time.
function Meter() {}
const key = ["proto", "type"].join(process.argv.length > 99 ? "x" : "");
Meter[key].read = function () { return "read"; };
const first = new Meter().read();
Meter[key] = { read() { return 2; } };
console.log(first, new Meter().read(), Meter.prototype === Meter[key]);
