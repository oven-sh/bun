// One statement of the module enters a function, which is entered again by another way (to primitive): each run has its own captured variable.
const log = [], readers = [];
const holder = { [Symbol.toPrimitive]() { let mine = readers.length; readers.push(() => mine); if (readers.length < 3) holder + 1; mine += 10; log.push(mine); return 0; } };
holder + 1;
console.log(log.join(), readers.map(read => read()).join());
//// through-to-string.js
// One statement of the module enters a function, which is entered again by another way (to string): each run has its own captured variable.
const log = [], readers = [];
const holder = { toString() { let mine = readers.length; readers.push(() => mine); if (readers.length < 3) `${holder}`; mine += 10; log.push(mine); return ""; } };
`${holder}`;
console.log(log.join(), readers.map(read => read()).join());
//// through-value-of.js
// One statement of the module enters a function, which is entered again by another way (value of): each run has its own captured variable.
const log = [], readers = [];
const holder = { valueOf() { let mine = readers.length; readers.push(() => mine); if (readers.length < 3) +holder; mine += 10; log.push(mine); return 0; } };
+holder;
console.log(log.join(), readers.map(read => read()).join());
//// through-values-of-descriptors.js
// One statement of the module enters a function, which is entered again by another way (values of descriptors): each run has its own captured variable.
const log = [], readers = [];
function Once() { let mine = readers.length; readers.push(() => mine); if (readers.length < 3) new (Object.getOwnPropertyDescriptors(Once.prototype).constructor.value)(); mine += 10; log.push(mine);  }
new Once();
console.log(log.join(), readers.map(read => read()).join());
//// through-weak-ref.js
// One statement of the module enters a function, which is entered again by another way (weak ref): each run has its own captured variable.
const log = [], readers = [];
let ref;
function once() { let mine = readers.length; readers.push(() => mine); if (readers.length < 3) ref.deref()(); mine += 10; log.push(mine);  }
ref = new WeakRef(once); once();
console.log(log.join(), readers.map(read => read()).join());
