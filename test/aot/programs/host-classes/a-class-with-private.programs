console.log(Object.create({ [Symbol.for("nodejs.util.inspect.custom")]() { return "custom 11"; } }));
console.log(Object.create({ inner12: { [Symbol.for("nodejs.util.inspect.custom")]() { return "custom 12"; } } }));
