//// accessor-names-of-host-classes-at-one-place-untyped.js
// A place in untyped code that reads or stores `url`, `pathname`, `status`, `size` .. meets host objects, where the name is an accessor of a locked prototype, and the program's own objects, where it is plain data. Each place sees many of one kind, then the others in turn.
const lines = [];
const warm = 40;
const show = value => (typeof value === "string" ? JSON.stringify(value) : typeof value === "object" && value !== null ? Object.prototype.toString.call(value) : String(value));
const attempt = work => {
  try {
    return show(work());
  } catch (error) {
    return "throws " + error.constructor.name;
  }
};

const readers = {
  url: o => o.url,
  method: o => o.method,
  headers: o => o.headers,
  body: o => o.body,
  bodyUsed: o => o.bodyUsed,
  signal: o => o.signal,
  status: o => o.status,
  statusText: o => o.statusText,
  ok: o => o.ok,
  type: o => o.type,
  redirected: o => o.redirected,
  href: o => o.href,
  origin: o => o.origin,
  protocol: o => o.protocol,
  host: o => o.host,
  hostname: o => o.hostname,
  port: o => o.port,
  pathname: o => o.pathname,
  search: o => o.search,
  searchParams: o => o.searchParams,
  hash: o => o.hash,
  username: o => o.username,
  size: o => o.size,
  count: o => o.count,
  name: o => o.name,
  lastModified: o => typeof o.lastModified,
};
const writers = {
  url: (o, v) => { o.url = v; },
  method: (o, v) => { o.method = v; },
  status: (o, v) => { o.status = v; },
  href: (o, v) => { o.href = v; },
  pathname: (o, v) => { o.pathname = v; },
  search: (o, v) => { o.search = v; },
  hash: (o, v) => { o.hash = v; },
  port: (o, v) => { o.port = v; },
  size: (o, v) => { o.size = v; },
  name: (o, v) => { o.name = v; },
};
const otherWriters = {
  url: (o, v) => { o.url = v; },
  pathname: (o, v) => { o.pathname = v; },
  status: (o, v) => { o.status = v; },
  size: (o, v) => { o.size = v; },
};

class Own {
  constructor(seed) {
    for (const name of Object.keys(readers)) this[name] = name + seed;
  }
}
class OwnWithFields {
  url = "own url";
  pathname = "own pathname";
  status = 299;
  size = 7;
  name = "own name";
}
class Heir extends URL {
  constructor(address) {
    super(address);
    this.extra = 1;
  }
}
class HeirThatHides extends Request {
  get url() {
    return "hidden " + super.url;
  }
}
const [URL_NAME, PATHNAME, STATUS] = JSON.parse('["url","pathname","status"]');
const withGetters = () => {
  let reads = 0;
  const o = {};
  for (const name of [URL_NAME, PATHNAME, STATUS]) Object.defineProperty(o, name, { configurable: true, get() { return name + " read " + ++reads; }, set(v) { reads += v.length ?? 100; } });
  return o;
};

const address = "http://user@example.com:8080/a/b?c=d&e=f#g";
const makers = {
  request: () => new Request(address.replace("user@", ""), { method: "POST", headers: { "x-one": "1" }, body: "abc" }),
  response: () => new Response("abc", { status: 201, statusText: "Made", headers: { "x-two": "2" } }),
  url: () => new URL(address),
  parameters: () => new URLSearchParams("a=1&b=2&a=3"),
  headers: () => new Headers({ a: "1", b: "2" }),
  blob: () => new Blob(["abcd"], { type: "text/plain" }),
  file: () => new File(["abcde"], "five.txt", { type: "text/plain", lastModified: 5 }),
  literal: () => ({ url: "/plain", method: "GET", headers: { h: 1 }, status: 200, pathname: "/p", search: "?s", hash: "#h", href: "/p?s#h", size: 3, type: "t", name: "n", ok: false, body: null }),
  otherOrder: () => ({ name: "n2", size: 4, hash: "", pathname: "/q", url: "/other" }),
  own: () => new Own(1),
  fields: () => new OwnWithFields(),
  heir: () => new Heir(address),
  hides: () => new HeirThatHides("http://example.com/hidden"),
  getters: withGetters,
  inherits: () => Object.create({ url: "inherited url", pathname: "inherited pathname", status: 1, size: 2 }),
  inheritsHost: () => Object.create(new URL(address)),
  bare: () => Object.create(null),
  empty: () => ({}),
  frozen: () => Object.freeze({ url: "frozen", pathname: "/frozen", status: 5, size: 6, name: "f" }),
  proxy: () => new Proxy({}, { get: (_, key) => "proxy " + String(key), set: () => true }),
  map: () => new Map([[1, 2]]),
  set: () => new Set([1, 2, 3]),
  array: () => [1, 2],
  text: () => "text",
  number: () => 5,
  func: () => function named() {},
  nothing: () => null,
  missing: () => undefined,
};
const kinds = Object.keys(makers);

for (const first of ["request", "url", "response", "literal", "own", "file"]) {
  for (const [name, read] of Object.entries(readers)) {
    const seen = makers[first]();
    for (let turn = 0; turn < warm; turn++) read(seen);
    lines.push(first + " first, " + name + ": " + kinds.map(kind => attempt(() => read(makers[kind]()))).join(" | "));
    lines.push(first + " again, " + name + ": " + attempt(() => read(seen)));
  }
}

for (const [title, all] of [["stores", writers], ["stores at other places", otherWriters]]) {
  for (const first of ["url", "literal", "request", "own"]) {
    for (const [name, write] of Object.entries(all)) {
      const seen = makers[first]();
      for (let turn = 0; turn < warm; turn++) attempt(() => write(seen, name === "port" ? "81" : name === "href" ? "http://example.org/z" : "/w" + (turn % 3)));
      lines.push(title + ", " + first + " first, " + name + ": " + kinds.map(kind => {
        const o = makers[kind]();
        const said = attempt(() => write(o, name === "port" ? "82" : name === "href" ? "http://example.net/y" : "/v"));
        return said + " " + attempt(() => readers[name](o));
      }).join(" | "));
      lines.push(title + ", " + first + " again, " + name + ": " + attempt(() => readers[name](seen)));
    }
  }
}

{
  const location = makers.url();
  const plain = makers.literal();
  let text = "";
  for (let turn = 0; turn < 64; turn++) {
    const o = turn % 2 ? location : plain;
    writers.pathname(o, "/t" + turn);
    text = readers.pathname(o) + readers.href(o).length + text.length;
  }
  lines.push("in turns: " + text + " " + location.href + " " + plain.pathname);
}

console.log(lines.join("\n"));
//// an-error-leaves-a-shadow-realm-as-a-type-error-of-the-outer-realm.js
// No object crosses the border of a ShadowRealm. What a function of the realm throws reaches its caller as a TypeError of the caller's realm.
const realm = new ShadowRealm();
const describe = run => { try { return "answered " + String(run()); } catch (error) { return [error instanceof TypeError ? "the outer TypeError" : error instanceof Error ? "an outer " + error.name : "AN ERROR OF THE INNER REALM: " + error.name, String(error.message).slice(0, 40)].join(": "); } };
const thrower = realm.evaluate("() => { throw new RangeError('inner'); }");
console.log(String(thrower), describe(() => thrower()));
const made = realm.evaluate(["() => {", "throw new RangeError('inner, text made at run time');", "}"].join(" "));
console.log(describe(() => made()));
console.log(describe(() => realm.evaluate("throw new RangeError('while evaluating')")));
console.log(describe(() => realm.evaluate("({})")));
const adds = realm.evaluate("(a, b) => a + b");
console.log(adds(1, 2), describe(() => adds({}, 1)));
//// async-handlers-also-called-by-the-program.ts
// An async handler that the host enters with a Request is also called by the program with an object that only looks like one,
// and with a Request that gets its own json() while the handler waits.
interface Order {
  id: number;
  items: string[];
}

let gate = Promise.resolve();

const handlers = {
  async fetch(request: Request): Promise<Response> {
    await gate;
    const order = (await request.json()) as Order;
    return new Response(String(order.id + order.items.length));
  },
};

const server = Bun.serve({ port: 0, fetch: handlers.fetch });
const post = (order: Order) => ({ method: "POST", body: JSON.stringify(order) });

console.log("from the host:", await (await fetch(server.url, post({ id: 1, items: ["a", "b"] }))).text());

const lookalike = { json: async () => ({ id: 40, items: [] }) } as unknown as Request;
console.log("a lookalike:", await (await handlers.fetch(lookalike)).text());

const opened = Promise.withResolvers<void>();
gate = opened.promise;
const changed = new Request(server.url, post({ id: 7, items: ["a"] }));
const pending = handlers.fetch(changed);
changed.json = async () => ({ id: 100, items: ["x", "y", "z"] });
opened.resolve();
console.log("its own json():", await (await pending).text());

gate = Promise.resolve();
console.log("from the host again:", await (await fetch(server.url, post({ id: 2, items: [] }))).text());
await server.stop(true);
//// bodies-of-utf8-bytes.ts
// request.json(), response.json() and blob.json() on bodies of bytes: whatever the bytes are, twice each. The parser that expects keys tries a text once sixteen that begin like it have gone by, and while texts that begin so serve it well: so sixteen go by first, and four plain bodies are read before every other.
function describe(value: unknown): string {
  if (value === null || typeof value !== "object") return typeof value + ":" + String(value);
  if (Array.isArray(value)) return "[" + value.map(describe).join() + "]";
  return "{" + Reflect.ownKeys(value).map(key => JSON.stringify(String(key)) + "=" + describe((value as Record<string, unknown>)[key as string])).join() + "}";
}
function codes(text: string): string {
  return [...text].map(character => character.codePointAt(0)!.toString(16)).join(" ");
}
const encoder = new TextEncoder();
const bytesOf = (...parts: (string | number[])[]) => new Uint8Array(parts.flatMap(part => (typeof part === "string" ? [...encoder.encode(part)] : part)));
const bodies: [string, Uint8Array<ArrayBuffer>][] = [
  ["plain", bytesOf('{"customer":{"id":1,"name":"n"},"items":[{"sku":"a","quantity":2}]}')],
  ["two letters outside ASCII", bytesOf('{"customer":{"id":4711,"name":"Zoë Müller"},"items":[{"sku":"a","quantity":2}]}')],
  ["three and four bytes a character", bytesOf('{"customer":{"id":1,"name":"東京 😀"},"items":[]}')],
  ["a key outside ASCII", bytesOf('{"customer":{"id":1,"näme":"n","東":2},"items":[]}')],
  ["escapes beside bytes", bytesOf('{"customer":{"id":1,"name":"ë\\u00eb\\n\\ud83d\\ude00ë"},"items":[]}')],
  ["a character cut at the end of a string", bytesOf('{"customer":{"id":1,"name":"a', [0xc3], '"},"items":[]}')],
  ["a stray continuation byte", bytesOf('{"customer":{"id":1,"name":"a', [0xab], 'b"},"items":[]}')],
  ["an overlong slash", bytesOf('{"customer":{"id":1,"name":"a', [0xc0, 0xaf], 'b"},"items":[]}')],
  ["a surrogate written as three bytes", bytesOf('{"customer":{"id":1,"name":"a', [0xed, 0xa0, 0x80], 'b"},"items":[]}')],
  ["beyond U+10FFFF", bytesOf('{"customer":{"id":1,"name":"a', [0xf4, 0x90, 0x80, 0x80], 'b"},"items":[]}')],
  ["0xff in a key", bytesOf('{"customer":{"id":1,"na', [0xff], 'me":"n"},"items":[]}')],
  ["a byte outside ASCII between the tokens", bytesOf('{"customer":', [0xc2, 0xa0], '{"id":1,"name":"n"},"items":[]}')],
  ["the text cut inside a character", bytesOf('{"customer":{"id":1,"name":"', [0xe6, 0x9d])],
  ["a mark, then letters outside ASCII", bytesOf([0xef, 0xbb, 0xbf], '{"customer":{"id":1,"name":"Zoë"},"items":[]}')],
  ["two marks", bytesOf([0xef, 0xbb, 0xbf, 0xef, 0xbb, 0xbf], '{"customer":{"id":1,"name":"n"},"items":[]}')],
  ["a mark in a string", bytesOf('{"customer":{"id":1,"name":"', [0xef, 0xbb, 0xbf], '"},"items":[]}')],
  ["UTF-16, little end first, with its mark", new Uint8Array([0xff, 0xfe, ...[...'{"a":"ë"}'].flatMap(character => [character.charCodeAt(0) & 0xff, character.charCodeAt(0) >> 8])])],
  ["a zero byte in a string", bytesOf('{"customer":{"id":1,"name":"a', [0], 'b"},"items":[]}')],
  ["a zero byte at the end", bytesOf('{"customer":{"id":1,"name":"n"},"items":[]}', [0])],
  ["indented, with letters outside ASCII", bytesOf(JSON.stringify({ customer: { id: 1, name: "Zoë" }, items: [{ sku: "å", quantity: 1 }] }, null, 2))],
];
const readers: [string, (body: Uint8Array<ArrayBuffer>) => Promise<unknown>][] = [
  ["request", body => new Request("http://localhost/", { method: "POST", body }).json()],
  ["response", body => new Response(body).json()],
  ["blob", body => new Blob([body]).json()],
];
const plain = bodies[0]![1];
const beginsLikePlain = (body: Uint8Array<ArrayBuffer>) => plain.subarray(0, 8).every((byte, at) => body[at] === byte);
for (const [, body] of bodies) {
  if (body !== plain && beginsLikePlain(body)) continue;
  for (let turn = 0; turn < 16; turn++) await new Response(body).json().catch(() => {});
}
for (const [reader, read] of readers) {
  for (const [label, body] of bodies) {
    for (let turn = 0; turn < 2; turn++) {
      for (let earned = 0; earned < 4; earned++) await read(plain);
      try {
        const value = (await read(body)) as { customer?: { name?: string } };
        console.log(reader, label, turn, describe(value), typeof value?.customer?.name === "string" ? codes(value.customer.name) : "");
      } catch (error) {
        console.log(reader, label, turn, "threw", (error as Error).name + ":", (error as Error).message);
      }
    }
  }
}
//// bodies-parsed-into-declared-types.ts
// Whatever object type `await request.json()` goes to, a body that holds an object, an array or null gives what json() gives, whatever its members are, and a body that is no JSON gives the error of json(). So does a body that starts with a byte order mark (rows 20, 22 and 23). A body that holds a number or a string gives that number or string.
interface Order {
  customer: { id: number; name: string };
  items: { sku: string; quantity: number }[];
  coupon?: string;
}

function describe(value: unknown): string {
  if (typeof value !== "object" || value === null) return typeof value + " " + String(value);
  return JSON.stringify(value) + " " + Reflect.ownKeys(value).map(String).join() + " " + (Object.getPrototypeOf(value) === (Array.isArray(value) ? Array.prototype : Object.prototype));
}

function failure(error: unknown): string {
  return error instanceof TypeError ? "TypeError" : (error as Error).name + ": " + (error as Error).message;
}

////= lines-21	ofRequest	request	Request
////= lines-21	ofResponse	response	Response
////= lines-21	ofBlob	blob	Blob
async function annotated(request: Request): Promise<unknown> {
  const order: Order = await request.json();
  return order;
}
async function untyped(request: Request): Promise<unknown> {
  return await request.json();
}
async function notAwaited(request: Request): Promise<unknown> {
  const pending = request.json() as Promise<Order>;
  return await pending;
}

const encoder = new TextEncoder();
type Body = string | Uint8Array<ArrayBuffer>;
const bodies: Body[] = [
  '{"customer":{"id":1,"name":"n"},"items":[{"sku":"a","quantity":2}],"coupon":"c"}',
  '{"customer":{"id":1,"name":"n"},"items":[]}',
  '{"customer":{"id":1,"name":"Zoë 中文 😀"},"items":[{"sku":"\\u0041\\n","quantity":-0}]}',
  '{ "customer": { "id": 1, "name": "n" }, "items": [ { "sku": "a", "quantity": 2 } ] }',
  '{"items":[],"customer":{"name":"n","id":1}}',
  '{"customer":{"id":1,"name":"n","more":true},"items":[],"__proto__":{"x":1},"0":0}',
  '{"customer":{"id":"1","name":2},"items":{"length":0}}',
  '{"customer":null,"items":null}',
  '{"customer":{"id":1,"name":"n"},"customer":5,"items":[]}',
  "{}",
  "[]",
  "null",
  "5",
  '"text"',
  "",
  " ",
  "{",
  '{"customer":{"id":1,"name":"n"},"items":[]',
  '{"customer":{"id":1,"name":"n"},"items":[]}x',
  '{"customer":{"id":01,"name":"n"},"items":[]}',
  "﻿{}",
  new Uint8Array([]),
  new Uint8Array([0xef, 0xbb, 0xbf]),
  new Uint8Array([0xef, 0xbb, 0xbf, ...encoder.encode('{"customer":{"id":1,"name":"n"},"items":[]}')]),
  new Uint8Array([...encoder.encode('{"customer":{"id":1,"name":"'), 0xff, 0xc3, 0x28, ...encoder.encode('"},"items":[]}')]),
  new Uint8Array([0x31, 0x00]),
];

const readers: [string, (body: Body) => Promise<unknown>][] = [
  ["request", body => ofRequest(new Request("http://localhost/", { method: "POST", body }))],
  ["response", body => ofResponse(new Response(body))],
  ["blob", body => ofBlob(new Blob([body]))],
  ["annotated", body => annotated(new Request("http://localhost/", { method: "POST", body }))],
  ["untyped", body => untyped(new Request("http://localhost/", { method: "POST", body }))],
  ["not awaited", body => notAwaited(new Request("http://localhost/", { method: "POST", body }))],
];
for (const [name, read] of readers) {
  for (let at = 0; at < bodies.length; at++) {
    try {
      console.log(name, at, describe(await read(bodies[at]!)));
    } catch (error) {
      console.log(name, at, "threw", failure(error));
    }
  }
}

class Overriding extends Request {
  override json(): Promise<any> {
