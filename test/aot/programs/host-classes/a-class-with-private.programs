//// functions-made-for-one-call-of-a-native-function-that-only-looks-at-them.mjs
// A function that is made for one call of a native function. The native function looks at it and keeps nothing, so nothing else in the program ever holds it.
function drop(listener) {
  removeEventListener("nothing", listener);
}
function dropThrough(listener) {
  drop(listener);
}

removeEventListener("nothing", () => {});
removeEventListener("nothing", function named() {});
globalThis.removeEventListener("nothing", () => {});
self.removeEventListener("nothing", () => {});
const remove = removeEventListener;
remove("nothing", () => {});
drop(() => {});
drop(() => 1);
dropThrough(() => 2);
console.log("removed before any was added");

addEventListener("added", () => {});
removeEventListener("added", () => {});
let captured = 0;
removeEventListener("added", () => captured++);
for (let i = 0; i < 3; i++) removeEventListener("added", () => i);
console.log("removed behind another one", captured);

performance.removeEventListener("nothing", () => {});
new EventTarget().removeEventListener("nothing", () => {});
new AbortController().signal.removeEventListener("abort", () => {});
new MessageChannel().port1.removeEventListener("message", () => {});
console.log("removed from other targets");

clearTimeout(() => {});
clearInterval(() => {});
clearImmediate(() => {});
console.log(
  Bun.deepEquals(() => {}, () => {}),
  new Map().get("key", () => {}),
  new Map().has(() => {}),
  new Set().has(() => {}),
  new WeakMap().has(() => {}),
  new WeakSet().delete(() => {}),
  Array.isArray(() => {}),
  Buffer.isBuffer(() => {}),
  ArrayBuffer.isView(() => {}),
);

let calls = 0;
const listener = () => calls++;
addEventListener("ping", listener);
dispatchEvent(new Event("ping"));
removeEventListener("ping", listener);
dispatchEvent(new Event("ping"));
console.log("the listener ran", calls);
//// handlers-get-what-the-host-passes-untyped.js
// What the host hands to the handlers of a server, a timer and a microtask, read by code without types.
const seen = [];
let closes = 0;
const finished = Promise.withResolvers();

const server = Bun.serve({
  port: 0,
  routes: {
    "/route/:id": (request, passedServer) =>
      new Response(`route ${request.params.id} ${request.method} ${passedServer === server} ${request instanceof Request}`),
    "/methods": {
      GET: request => new Response("get " + new URL(request.url).pathname),
      POST: async request => new Response("post " + (await request.text())),
    },
    "/fixed": new Response("fixed"),
  },
  fetch(request, passedServer) {
    const { pathname } = new URL(request.url);
    if (pathname === "/socket") {
      const upgraded = passedServer.upgrade(request, { data: { id: 7, tags: ["a", "b"] } });
      seen.push(`after upgrade ${upgraded}`);
      return upgraded ? undefined : new Response("no upgrade", { status: 400 });
    }
    if (pathname === "/throws") throw new RangeError("thrown by fetch");
    const host = typeof request.headers.get("host");
    return new Response(`fetch ${request.method} ${this === server} ${passedServer === server} ${request instanceof Request} ${host}`);
  },
  error(error) {
    return new Response(`error ${error instanceof RangeError} ${error.message}`, { status: 500 });
  },
  websocket: {
    open(socket) {
      seen.push(`open ${this === undefined} ${socket.data.id} ${socket.data.tags.join()} ${socket.readyState}`);
      socket.data.id++;
      socket.send("hello");
    },
    message(socket, message) {
      seen.push(`message ${typeof message} ${message} ${socket.data.id}`);
      socket.data = { id: 100, tags: [] };
      const before = closes;
      socket.close(1000, "done");
      seen.push(`closes around close() ${before} ${closes}`);
    },
    close(socket, code, reason) {
      closes++;
      seen.push(`close ${typeof code} ${code} ${typeof reason} ${reason} ${socket.data.id} ${socket.data.tags.length}`);
      finished.resolve();
    },
  },
});

const show = async (label, response) => console.log(label, response.status, await response.text());
const at = path => new URL(path, server.url);

await show("fetch", await fetch(at("/plain")));
await show("route", await fetch(at("/route/12")));
await show("get", await fetch(at("/methods")));
await show("post", await fetch(at("/methods"), { method: "POST", body: "sent" }));
await show("fixed", await fetch(at("/fixed")));
await show("error", await fetch(at("/throws")));
await show("server.fetch", await server.fetch(new Request(at("/plain"), { method: "PUT" })));

const client = new WebSocket(at("/socket").href.replace("http", "ws"));
client.onmessage = event => client.send("reply to " + event.data);
await finished.promise;
for (const line of seen) console.log(line);

const timer = setTimeout(function (first, second) {
  console.log("timer", this === timer, first, second.name);
}, 1, 5, { name: "passed" });
console.log("the callback of the timer", typeof timer._onTimeout, timer._onTimeout.length);
await new Promise(resolve => setTimeout(resolve, 20));

let ticks = 0;
await new Promise(resolve => {
  const interval = setInterval(step => {
    ticks += step;
    if (ticks === 6) {
      clearInterval(interval);
      resolve();
    }
  }, 1, 2);
});
console.log("interval", ticks);

const replaced = setTimeout(() => console.log("not called"), 5);
replaced._onTimeout = function () {
  console.log("replaced callback", this === replaced, arguments.length);
};
await new Promise(resolve => setTimeout(resolve, 30));

queueMicrotask(function () {
  console.log("microtask", this === undefined, arguments.length);
});
await null;
await server.stop(true);
console.log("done");
//// header-names-compared-in-async-functions-untyped.js
// Methods of `response.headers` whose header name is a parameter, inside async functions, a generator and a try block. The calls pass well-known names, other names, an invalid name and values that are not strings.
async function putLater(response, name, value) {
  await null;
  response.headers.set(name, value);
  await null;
  return response.headers.has(name);
}
async function putFirst(response, name, value) {
  response.headers.append(name, value);
  await null;
  response.headers.append(name, value);
}
function* putInSteps(response, name) {
  response.headers.set(name, yield "first");
  response.headers.append(name, yield "second");
}
function putInTry(response, name, value) {
  try {
    response.headers.set(name, value);
    return "set";
  } catch (error) {
    return error.name;
  } finally {
