//// fields-of-classes-that-extend-host-classes.ts
// Class fields on instances of classes that extend host classes: defined, not assigned, whatever the host object is.
const log: string[] = [];
const say = (...parts: unknown[]) => log.push(parts.map(String).join(" "));
const describe = (object: object, key: PropertyKey) => JSON.stringify(Object.getOwnPropertyDescriptor(object, key));

class LazyPromise<T> extends Promise<T> {
  started = false;
  label = "lazy";
  count = 0;
  extra: unknown = null;
  fifth = 5;
}
class CountedMap extends Map<string, number> {
  reads = 0;
  writes = 0;
}
class TaggedSet extends Set<number> {
  tag = "set";
}
////= lines-15	Stamp	Date	note	"stamp"
class Rows extends Array<number> {
  command = "SELECT";
  count = 0;
}
class Failure extends Error {
  status = 500;
  message = "replaced";
  stack = "no stack";
}
////= lines-15	Pattern	RegExp	uses	0
////= lines-15	PatternWithIndex	RegExp	lastIndex	7
class RowsWithLength extends Array<number> {
  length = 2;
}
////= lines-15	Bytes	Uint8Array	origin	"bytes"
class Weak extends WeakMap<object, number> {
  name = "weak";
}
////= lines-15	Text	String	kind	"text"
////= lines-15	Buffered	ArrayBuffer	owner	"me"

function basics(): void {
  const promise = new LazyPromise<number>(() => {});
  say(Object.keys(promise).join(), describe(promise, "started"), promise.fifth);
  const map = new CountedMap([["a", 1]]);
  say(Object.keys(map).join(), map.size, describe(map, "writes"));
  say(Object.keys(new TaggedSet([1])).join(), Object.keys(new Stamp(0)).join(), new Stamp(0).getTime());
  const rows = new Rows(1, 2, 3);
  say(Object.keys(rows).join(), rows.length, describe(rows, "command"));
  const failure = new Failure("original");
  say(Object.keys(failure).join(), failure.message, failure.stack, describe(failure, "message"));
  const pattern = new Pattern("a", "g");
  say(Object.keys(pattern).join(), pattern.lastIndex, describe(pattern, "lastIndex"));
  for (const make of [() => new PatternWithIndex("a"), () => new RowsWithLength(1, 2, 3)]) {
    try {
      say(Object.keys(make()).join());
    } catch (error) {
      say((error as Error).constructor.name);
    }
  }
  say(Object.keys(new Bytes(2)).join(), Object.keys(new Weak()).join(), Object.keys(new Text("ab")).join(), Object.keys(new Buffered(1)).join());
}

function definedNotAssigned(): void {
  class Base extends Map<string, number> {
    set watched(value: number) {
      say("the setter ran", value);
    }
    get watched(): number {
      return -1;
    }
  }
  class Derived extends Base {
    // @ts-expect-error a field over an accessor
    watched = 3;
  }
  const derived = new Derived();
  say(derived.watched, describe(derived, "watched"));
}

function refusals(): void {
  function returns(object: object) {
    return function () {
      return object;
    } as unknown as new () => object;
  }
  const attempt = (name: string, object: object) => {
    class Stamped extends returns(object) {
      field = 1;
    }
    try {
      new Stamped();
      say(name, describe(object, "field"));
    } catch (error) {
      say(name, (error as Error).constructor.name);
    }
  };
  attempt("a frozen map", Object.freeze(new Map()));
  attempt("a sealed promise", Object.seal(Promise.resolve()));
  attempt("a set that cannot grow", Object.preventExtensions(new Set()));
  attempt("a fixed property", Object.defineProperty(new Map(), "field", { value: 0, configurable: false, writable: false }));
  attempt("a fixed writable property", Object.defineProperty(new Map(), "field", { value: 0, configurable: false, writable: true, enumerable: true }));
  attempt("a hidden property", Object.defineProperty(new Map(), "field", { value: 0, configurable: true, writable: false, enumerable: false }));
  attempt("an accessor", Object.defineProperty(new Date(0), "field", { get: () => 9, configurable: true }));
  const traps: string[] = [];
  attempt("a proxy", new Proxy(new Map(), { defineProperty(target, key, descriptor) { traps.push(String(key) + JSON.stringify(descriptor)); return Reflect.defineProperty(target, key, descriptor); } }));
  say(traps.join());
  attempt("a refusing proxy", new Proxy(new Map(), { defineProperty: () => false }));
}

function manyShapes(): void {
  let total = 0;
  for (let turn = 0; turn < 3000; turn++) {
    const promise = new LazyPromise<number>(() => {});
    const map = new CountedMap();
    if (turn % 1000 === 999) (map as unknown as Record<string, number>).late = turn;
    map.reads += turn;
    promise.count += map.reads;
    total += promise.count + promise.fifth + Object.keys(map).length;
  }
  say(total);
  class Child extends LazyPromise<void> {
    sixth = 6;
    seventh = 7;
    eighth = 8;
    ninth = 9;
  }
  const child = new Child(() => {});
  say(Object.keys(child).join(), child.ninth);
  const asPrototype = new CountedMap();
  const heir: { reads: number } = Object.create(asPrototype);
  say(heir.reads, Object.keys(new CountedMap()).join());
}

basics();
definedNotAssigned();
refusals();
manyShapes();
console.log(log.join("\n"));
//// fields-of-host-class-subclasses.ts
// Subclasses of EventTarget, Event, EventEmitter, URL, Response and DOMException with fields, methods, getters and a private field: the host creates the object, the fields are ordinary properties.
import { EventEmitter } from "node:events";
const print = (value: unknown): void => console.log(String(value));
const gc = (): void => Bun.gc(true);
class Hub extends EventTarget {
  count = 0;
  name: string;
  #seen = 0;
  constructor(name: string) { super(); this.name = name; }
  fire(kind: string) { this.count++; return this.dispatchEvent(new Ping(kind, this.count)); }
  saw() { return ++this.#seen; }
}
class Ping extends Event {
  n: number;
  constructor(kind: string, n: number) { super(kind); this.n = n; }
  twice() { return this.n * 2; }
}
const h = new Hub("hub");
h.addEventListener("a", (e) => { print((e as Ping).n + ":" + (e as Ping).twice() + ":" + e.type + ":" + (e instanceof Ping)); h.saw(); });
print(h.fire("a"));
print(h.fire("a"));
print(h.count);
print(h.name);
print(h.saw());
print(h instanceof Hub);
print(h instanceof EventTarget);
print(Object.keys(h).join(","));
class Bus extends EventEmitter {
  sent = 0;
  send(v: number) { this.sent++; return this.emit("v", v); }
}
const b = new Bus();
b.on("v", (v: number) => print("got " + v));
print(b.send(3));
print(b.sent);
print(b instanceof EventEmitter);
class Link extends URL {
  tag = "t";
  get both() { return this.tag + this.host; }
}
const u = new Link("https://example.com/x");
print(u.both);
print(u.pathname);
print(u instanceof URL);
////= lines-15	Reply	Response	note	"n"
const r = new Reply("body", { status: 201 });
print(r.status);
print(r.note);
print(await r.text());
////= lines-15	AbortedError	DOMException	extra	5
const ae = new AbortedError("gone", "AbortError");
print(ae.name);
print(ae.message);
print(ae.extra);
print(ae instanceof Error);
const all: Hub[] = [];
for (let i = 0; i < 2000; i++) all.push(new Hub("h" + i));
gc();
let sum = 0;
for (let i = 0; i < all.length; i++) sum += all[i].name.length + all[i].count + all[i].saw();
print(sum);
//// for-of-over-host-iterators-untyped.js
// `for..of` where the iterator's `next`, or the iterable's `[Symbol.iterator]`, is a function of the host or of the engine and not compiled code.
const lines = [];
function say(label, work) {
  let text;
  try {
    text = JSON.stringify(work());
  } catch (error) {
    text = "throws " + error.constructor.name;
  }
  lines.push(label + ": " + text);
}
function collect(iterable) {
  const seen = [];
  for (const item of iterable) seen.push(item);
  return seen;
}
function collectPairs(iterable) {
  const seen = [];
  for (const [key, value] of iterable) seen.push(key + "=" + value);
  return seen;
}
function firstOf(iterable) {
  for (const item of iterable) return item;
  return "none";
}

const query = () => new URLSearchParams("a=1&b=two&a=3&c=%20x");
for (let turn = 0; turn < 3; turn++) {
  say("search parameters " + turn, () => collect(query()));
  say("entries " + turn, () => collectPairs(query().entries()));
  say("keys " + turn, () => collect(query().keys()));
  say("values " + turn, () => collect(query().values()));
  say("no entries " + turn, () => [collect(new URLSearchParams("")), collectPairs(new URLSearchParams().entries())]);
  say("headers " + turn, () => collectPairs(new Headers({ "X-B": "2", "x-a": "1", accept: "*/*" })));
  say("the keys of headers " + turn, () => collect(new Headers([["b", "1"], ["a", "2"]]).keys()));
  say("a form " + turn, () => { const form = new FormData(); form.append("name", "value"); form.append("other", String(turn)); return collectPairs(form); });
  say("left early " + turn, () => [firstOf(query()), firstOf(query().keys()), firstOf(new URLSearchParams())]);
}
say("one iterator in two loops", () => { const entries = query().entries(); return [firstOf(entries), collect(entries), collect(entries)]; });
say("appended to while it is walked", () => { const q = new URLSearchParams("a=1"); const seen = []; for (const [key] of q) { seen.push(key); if (seen.length < 4) q.append(key + "x", "1"); } return seen; });
say("deleted from while it is walked", () => { const q = query(); const seen = []; for (const [key] of q) { seen.push(key); q.delete("b"); } return seen; });
say("loops inside loops", () => { const seen = []; for (const [a] of query()) for (const b of new URLSearchParams("x=1&y=2").keys()) seen.push(a + b); return seen; });
say("a throw in the body", () => { const entries = query().entries(); try { for (const pair of entries) throw new Error(pair[0]); } catch (error) { return [error.message, collect(entries).length]; } });

const next = Object.getPrototypeOf(query().entries()).next;
say("the host's next on another receiver", () => collect({ [Symbol.iterator]() { return { next }; } }));
say("the host's next, bound", () => { const entries = query().entries(); return collect({ [Symbol.iterator]() { return { next: next.bind(entries) }; } }); });
say("the host's next on an object that inherits from the iterator", () => collect({ [Symbol.iterator]() { return Object.create(query().entries()); } }));
say("a next that answers a number", () => collect({ [Symbol.iterator]() { return { next: Math.abs }; } }));
say("a next that answers a string", () => collect({ [Symbol.iterator]() { return { next: String }; } }));
say("a next that is a class", () => collect({ [Symbol.iterator]() { return { next: Map }; } }));
say("a next that is no function", () => collect({ [Symbol.iterator]() { return { next: {} }; } }));
say("a next that answers objects of its own shape", () => { let left = 3; const results = () => Object.assign(Object.create(null), { extra: 0, value: left, done: left-- === 0 }); return collect({ [Symbol.iterator]() { return { next: results.bind(null) }; } }); });
say("return is called when the loop is left", () => { const calls = []; const entries = query().entries(); const iterator = { next: next.bind(entries), return() { calls.push("return"); return {}; } }; return [firstOf({ [Symbol.iterator]: () => iterator }), calls]; });

say("the method is the host's", () => { const q = query(); return collectPairs({ [Symbol.iterator]: q.entries.bind(q) }); });
say("the method is the host's, on another receiver", () => collect({ [Symbol.iterator]: URLSearchParams.prototype.entries }));
say("the method is the engine's", () => collect({ length: 2, 0: "x", 1: "y", [Symbol.iterator]: Array.prototype.values }));
say("the method answers a number", () => collect({ [Symbol.iterator]: Math.abs }));
say("the method is a class", () => collect({ [Symbol.iterator]: Set }));
say("segments", () => collect(new Intl.Segmenter("en", { granularity: "word" }).segment("to be")).map(part => part.segment));
say("matches", () => collect("a1b22".matchAll(/\d+/g)).map(match => match[0]));

console.log(lines.join("\n"));
