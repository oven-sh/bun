//// a-class-with-private-methods-stands-below-a-host-constructor-that-answers-with-a-string.js
// The parent of a class is swapped for a constructor of the host that answers `new` with a string. The private methods of the class are not there on a string: asking for one is a TypeError.
const { CString, ptr } = require("bun:ffi");
const bytes = Buffer.from("Hi\0");
const at = ptr(bytes);
function attempt(name, work) {
  try {
    console.log(name, work());
  } catch (error) {
    console.log(name, "threw", error.constructor.name);
  }
}

class Base {}
class WithMethod extends Base { #m() { return 4; } static call(made) { return made.#m(); } }
Object.setPrototypeOf(WithMethod, CString);
attempt("a private method", () => WithMethod.call(new WithMethod(at)));

class WithGetter extends Base { get #g() { return 5; } static read(made) { return made.#g; } }
Object.setPrototypeOf(WithGetter, CString);
attempt("a private getter", () => WithGetter.read(new WithGetter(at)));

class WithBoth extends Base { #m() { return 6; } #f = 7; static call(made) { return made.#m() + made.#f; } }
Object.setPrototypeOf(WithBoth, CString);
attempt("a private method and a private field", () => WithBoth.call(new WithBoth(at)));

class Untouched extends Base { #m() { return 8; } static call(made) { return made.#m(); } }
attempt("the parent as it was written", () => Untouched.call(new Untouched()));
for (let turn = 0; turn < 3; turn++) attempt("again", () => WithMethod.call(new WithMethod(at)));
//// a-digest-is-written-into-the-array-that-is-given-validated.ts
// `digest(bytes)` and `hash(input, bytes)` write into the array they are given and answer it. An element that was read in front of the call is read again behind it.
function ofAnInstance(): string {
  const hasher = new Bun.CryptoHasher("sha256");
  hasher.update("a");
  const bytes = new Uint8Array(64);
  const before = bytes[0];
  const answered = hasher.digest(bytes);
  return [before, bytes[0], bytes[15], answered === bytes].join();
}
function given(hasher: Bun.CryptoHasher, bytes: Uint8Array): string {
  const before = bytes[0] + bytes[15];
  hasher.digest(bytes);
  return [before, bytes[0] + bytes[15]].join();
}
function ofTheClass(): string {
  const bytes = new Uint8Array(64);
  const before = bytes[0];
  const answered = Bun.CryptoHasher.hash("sha1", "a", bytes);
  return [before, bytes[0], answered === bytes].join();
}
function ofAStaticHasher(): string {
  const bytes = new Uint8Array(64);
  const before = bytes[0];
  Bun.SHA256.hash("a", bytes);
  const first = bytes[0];
  const hasher = new Bun.MD5();
  hasher.update("b");
  hasher.digest(bytes);
  return [before, first, bytes[0]].join();
}
function inALoop(): number {
  let sum = 0;
  const bytes = new Uint8Array(64);
  for (let i = 0; i < 500; i++) {
    const hasher = new Bun.CryptoHasher("md5");
    hasher.update(String(i));
    sum = (sum + bytes[0]) | 0;
    hasher.digest(bytes);
    sum = (sum + bytes[0]) | 0;
  }
  return sum;
}
for (let i = 0; i < 3; i++) {
  console.log("of an instance", ofAnInstance());
  const hasher = new Bun.CryptoHasher("sha1");
  hasher.update("b" + i);
  console.log("given", given(hasher, new Uint8Array(64)));
  console.log("of the class", ofTheClass());
  console.log("of a static hasher", ofAStaticHasher());
}
console.log("in a loop", inALoop());
