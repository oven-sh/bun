}
function contentTypeOf(headers: Headers): unknown {
  return headers.has("content-type") ? headers.get("content-type") : "none";
}

function totalLength(receivers: unknown[]): number {
  let length = 0;
  for (let i = 0; i < rounds; i++) {
    const receiver = receivers[i % receivers.length];
    length += summarizeTyped(receiver as Request).length + summarizeUntyped(receiver).length;
  }
  return length;
}

const headerLikes: unknown[] = [
  new Map([["content-type", "text/plain"]]),
  new Map<string, string>(),
  { has: (name: string) => name.length > 3, get: (name: string) => "answer for " + name },
];
function contentTypeCounts(): string {
  const counts = new Map<string, number>();
  for (let i = 0; i < rounds; i++) {
    const answer = String(contentTypeOf(headerLikes[i % headerLikes.length] as Headers));
    counts.set(answer, (counts.get(answer) ?? 0) + 1);
  }
  return [...counts].map(([answer, count]) => answer + " x" + count).join(", ");
}

const plainObjects: unknown[] = [
  { url: "plain://first", method: "GET" },
  { method: "PUT", url: "plain://second", body: null },
];

lines.push("plain objects before the first Request: " + totalLength(plainObjects));
lines.push("header-like objects before the first Request: " + contentTypeCounts());

const first = new Request("http://example.com/first", { method: "POST" });
lines.push("the first Request: " + summarizeTyped(first) + " | " + summarizeUntyped(first));
lines.push("the first Request in a loop: " + totalLength([first]));

class RequestSubclass extends Request {}
class RequestWithOverrides extends Request {
  override get url() {
    return "overridden " + super.url;
  }
  override get method() {
    return "OVERRIDDEN";
  }
}
const withOwnURL = new Request("http://example.com/own", { method: "DELETE" });
Object.defineProperty(withOwnURL, "url", { value: "own url", configurable: true });

const labeled: [string, unknown][] = [
  ["a second Request", new Request("http://example.com/second")],
  ["a subclass instance", new RequestSubclass("http://example.com/subclass", { method: "PATCH" })],
  ["a subclass instance with overrides", new RequestWithOverrides("http://example.com/overrides", { method: "PUT" })],
  ["a Request with an own url", withOwnURL],
  ["a plain object", plainObjects[0]],
  ["an object that inherits from a Request", Object.create(first)],
];
for (const [label, receiver] of labeled) {
  let summary: string;
  try {
    summary = summarizeTyped(receiver as Request) + " | " + summarizeUntyped(receiver);
  } catch (error) {
    summary = "throws " + (error as Error).constructor.name;
  }
  lines.push(label + ": " + summary);
}

const withoutThrowing = labeled.slice(0, 5).map(([, receiver]) => receiver);
lines.push("every kind of receiver in a loop: " + totalLength(withoutThrowing));

delete (withOwnURL as any).url;
lines.push("the own url deleted: " + summarizeTyped(withOwnURL) + " | " + summarizeUntyped(withOwnURL));

Bun.gc(true);
lines.push("a Request after a collection: " + summarizeTyped(new Request("http://example.com/third", { method: "HEAD" })));
lines.push("plain objects after the first Request: " + totalLength(plainObjects));
lines.push("header-like objects after the first Request: " + contentTypeCounts());

console.log(lines.join("\n"));
//// record-conversion-typed-object.ts
// A typed object as the record argument of `new Headers()` and `new URLSearchParams()`: its own enumerable keys in creation order, each value read and converted in that order, as in plain Bun.
interface Init { [name: string]: string }
interface Closed { accept: string; host: string }
interface Optional { first?: string; second: string; third: string }
interface Mixed { count: number; ratio: number; on: boolean; none: null; missing: undefined; big: bigint }
interface Stringified { a: string; b: { toString(): string }; c?: string }
class Query { #secret = "s"; constructor(public q: string, public page: number) {} describe() { return this.q + this.#secret; } }
function hide(value: unknown): any { return value; }
const log: string[] = [];
let count = 0;
function attempt(convert: () => unknown): string {
  try { return JSON.stringify(convert()); } catch (e) { return "THROWN " + (e as Error).name + ": " + (e as Error).message; }
}
function show(name: string, make: () => unknown) {
  const headers = attempt(() => [...new Headers(hide(make()))]);
  const query = attempt(() => new URLSearchParams(hide(make())).toString());
  console.log(String(++count).padStart(2, "0"), name + ":", headers, query, "log: " + log.splice(0).join());
}
const closed = (): Closed => ({ accept: "text/plain", host: "example.com" });

show("index signature", () => { const init: Init = { accept: "a", "x-one": "1" }; init["x-late"] = "l"; return init; });
show("closed literal", closed);
show("class instance", () => new Query("bun", 2));
show("optional field absent", (): Optional => ({ second: "2", third: "3" }));
show("optional field set late", () => { const x: Optional = { second: "2", third: "3" }; x.first = "1"; return x; });
show("optional field set to undefined", () => { const x: Optional = { second: "2", third: "3" }; x.first = undefined; return x; });
show("optional field deleted and set again", () => { const x: Optional = { first: "1", second: "2", third: "3" }; delete x.first; x.first = "again"; return x; });
show("numbers, booleans, nullish, bigint", (): Mixed => ({ count: 1, ratio: 1.5, on: true, none: null, missing: undefined, big: 10n }));
show("numbers with special text", (): Mixed => ({ count: -0, ratio: NaN, on: false, none: null, missing: undefined, big: -(2n ** 64n) }));
show("a rope and 16-bit text", (): Closed => ({ accept: "left".repeat(3) + count, host: "значение" }));
show("non-enumerable field", () => { const x = closed(); Object.defineProperty(hide(x), "host", { enumerable: false }); return x; });
show("extra property", () => { const x = closed(); hide(x).extra = "e"; return x; });
show("extra non-enumerable property", () => { const x = closed(); Object.defineProperty(hide(x), "hidden", { value: "h", enumerable: false, writable: true, configurable: true }); return x; });
show("extra read-only property", () => { const x = closed(); Object.defineProperty(hide(x), "fixed", { value: "f", enumerable: true, writable: false, configurable: false }); return x; });
show("non-enumerable symbol key", () => { const x = closed(); Object.defineProperty(hide(x), Symbol("s"), { value: "v", enumerable: false, writable: true, configurable: true }); return x; });
show("frozen", () => { const x = closed(); Object.freeze(x); return x; });
show("sealed with an extra property", () => { const x = closed(); hide(x).extra = "e"; Object.seal(x); return x; });
show("empty", (): { o?: string } => ({}));
show("symbol value", () => ({ a: "1", s: Symbol("s"), z: "26" }));
show("keys equal after conversion", () => { const init: Init = { z: "26" }; init["\ud800"] = "1"; init["�"] = "2"; return init; });

const reused = closed();
hide(reused).extra = "e";
show("one object, converted twice", () => reused);
reused.host = "changed";
hide(reused).extra = "f";
show("the same object after two stores", () => reused);
hide(reused).more = "m";
delete hide(reused).extra;
show("the same object after an addition and a deletion", () => reused);

show("toString deletes a later key", () => { const init: Stringified = { a: "1", b: { toString() { log.push("b"); delete init.c; return "2"; } }, c: "3" }; return init; });
show("toString changes a later value", () => { const init: Stringified = { a: "1", b: { toString() { log.push("b"); init.c = "changed"; return "2"; } }, c: "3" }; return init; });
show("toString adds a key", () => { const init: Stringified = { a: "1", b: { toString() { log.push("b"); hide(init).d = "4"; return "2"; } }, c: "3" }; return init; });
show("toString throws", () => { const init: Stringified = { a: "1", b: { toString() { log.push("b"); throw new RangeError("from toString"); } }, c: "3" }; return init; });
show("array value", () => ({ a: "1", list: ["x", "y"], z: "26" }));
show("accessor", () => { const x = closed(); Object.defineProperty(hide(x), "got", { get() { log.push("get"); return "g"; }, enumerable: true, configurable: true }); return x; });
show("accessor replaces a field", () => { const x = closed(); Object.defineProperty(hide(x), "accept", { get() { log.push("get"); return "g"; }, enumerable: true, configurable: true }); return x; });
show("index-like keys", () => { const x = closed(); hide(x)[7] = "seven"; hide(x)["0"] = "zero"; return x; });
show("enumerable symbol key", () => { const x = closed(); hide(x)[Symbol("s")] = "v"; return x; });
show("enumerable symbol key after a value that logs", () => { const init: Stringified = { a: "1", b: { toString() { log.push("b"); return "2"; } } }; hide(init)[Symbol("s")] = "v"; return init; });
//// replaced-host-globals.ts
// The global names Request, Response, Blob, Headers, URL and URLSearchParams can be replaced. Code that names a replaced global gets the replacement, never a shortcut for the original class.
const lines: string[] = [];
////= say
const globals = globalThis as unknown as Record<string, unknown>;
const originals = { Request, Response, Blob, Headers, URL, URLSearchParams };

const makeRequest = (url: string) => new Request(url);
const makeResponse = (body: string, status: number) => new Response(body, { status, headers: { "x-made": "here" } });
const makeJSON = (value: unknown) => Response.json(value);
const makeBlob = (text: string) => new Blob([text]);
const makeHeaders = () => new Headers({ a: "1" });
const pathnameOf = (text: string) => new URL(text).pathname;
const queryOf = (text: string, name: string) => new URL(text).searchParams.get(name);
const paramOf = (text: string, name: string) => new URLSearchParams(text).get(name);
const everything = () => [
  makeRequest("http://example.com/a").url,
  makeResponse("body", 201).status,
  makeResponse("body", 201).headers.get("x-made"),
  makeJSON({ a: 1 }).headers.get("content-type"),
  makeJSON({ a: 1 }).status,
  makeBlob("abc").size,
  makeHeaders().get("a"),
  pathnameOf("http://example.com/a/b?c=d"),
  queryOf("http://example.com/a/b?c=d", "c"),
  paramOf("c=d", "c"),
];
function warm() {
  let last: unknown;
  for (let i = 0; i < 200; i++) last = everything();
  return last;
}

say("before anything is replaced", warm);

say("each global replaced by a subclass", () => {
  globals.Request = class extends originals.Request {
    override get url() {
      return "replaced " + super.url;
    }
  };
  globals.Response = class extends originals.Response {
    override get status() {
      return super.status + 1000;
    }
    static override json(value: unknown) {
      return new originals.Response(JSON.stringify(value), { status: 299, headers: { "content-type": "replaced/json" } });
    }
  };
  globals.Blob = class extends originals.Blob {
    override get size() {
      return super.size + 1000;
    }
  };
  globals.Headers = class extends originals.Headers {
    override get(name: string) {
      return "replaced " + super.get(name);
    }
  };
  globals.URL = class extends originals.URL {
    override get pathname() {
      return "/replaced" + super.pathname;
    }
    override get searchParams() {
      return new originals.URLSearchParams("c=replaced");
    }
  };
  globals.URLSearchParams = class extends originals.URLSearchParams {
    override get(name: string) {
      return "replaced " + super.get(name);
    }
  };
  return warm();
});
say("the replacements are what the names answer", () => Object.keys(originals).map(name => globals[name] !== (originals as Record<string, unknown>)[name]));
say("an instance of a replacement is an instance of the original", () => [makeRequest("http://example.com/") instanceof originals.Request, makeHeaders() instanceof originals.Headers]);

say("each global replaced by an unrelated class", () => {
  for (const name of Object.keys(originals)) {
    globals[name] = class {
      url = "unrelated";
      status = -1;
      size = -1;
      pathname = "unrelated";
      headers = { get: () => "unrelated" };
      searchParams = { get: () => "unrelated" };
      get() {
        return "unrelated";
      }
      static json() {
        return { status: -2, headers: { get: () => "unrelated json" } };
      }
    };
  }
  return warm();
});

say("each global deleted", () => {
  const answers = Object.keys(originals).map(name => delete globals[name]);
  let error = "";
  try {
    makeHeaders();
  } catch (e) {
    error = (e as Error).constructor.name;
  }
  return [answers, error, typeof globals.URL];
});

say("the originals restored", () => {
  Object.assign(globals, originals);
  return warm();
});

say("one static function replaced", () => {
  const json = originals.Response.json;
  (originals.Response as unknown as Record<string, unknown>).json = () => new originals.Response("x", { status: 298 });
  const status = makeJSON({}).status;
  originals.Response.json = json;
  return [status, makeJSON({}).status];
});

say("a local binding with the name of a global", () => {
  class URL {
    pathname = "local";
    constructor(readonly text: string) {}
  }
  class Headers {
    get(name: string) {
      return "local " + name;
    }
  }
  return [new URL("http://example.com/a").pathname, new Headers().get("a")];
});

console.log(lines.join("\n"));
//// replaced-members-of-lazy-globals.ts
// Bun.inspect and Response.json are called in hot loops while the program replaces them, collects garbage and restores them. Another object stands in for Buffer as an argument and as the global.
const lines: string[] = [];
const texts = ["abc", "héllo", "日本語", "", "😀"];
const rounds = 2000;

////= lines-18	bufferFromHot	0	Buffer.from
function byteLengthHot(): number {
  let sum = 0;
  for (let i = 0; i < rounds; i++) sum += Buffer.byteLength(texts[i % texts.length]);
  return sum;
}
////= lines-18	inspectEarly	1	Bun.inspect
////= lines-18	inspectHot	0	Bun.inspect
function responseJSONEarly(): number {
  let sum = 1;
  for (let i = 0; i < rounds; i++) sum += Response.json({ round: i }, { status: 200 + (i % 3) }).status;
  return sum;
}
function responseJSONHot(): number {
  let sum = 0;
  for (let i = 0; i < rounds; i++) sum += Response.json({ round: i }, { status: 200 + (i % 3) }).status;
  return sum;
}

let replacementCalls = 0;
let callsOnHolder = 0;
function countCall(receiver: unknown, holder: unknown) {
  replacementCalls++;
  if (receiver === holder) callsOnHolder++;
}
function takeCounts(): string {
  const counts = replacementCalls + " replacement calls, " + callsOnHolder + " on the holder";
  replacementCalls = 0;
  callsOnHolder = 0;
  return counts;
}

interface Case {
  label: string;
  holder: any;
  name: string;
  replacement: (this: unknown, ...values: any[]) => unknown;
  early: () => number;
  hot: () => number;
}
const cases: Case[] = [
  {
    label: "Bun.inspect",
    holder: Bun,
    name: "inspect",
    replacement: function (this: unknown, value: any) {
      countCall(this, Bun);
      return "replaced: " + value;
    },
    early: inspectEarly,
    hot: inspectHot,
  },
  {
    label: "Response.json",
    holder: Response,
    name: "json",
    replacement: function (this: unknown, value: any, init: any) {
      countCall(this, Response);
      return { status: init.status + value.round + 3000 };
    },
    early: responseJSONEarly,
    hot: responseJSONHot,
  },
];

for (const { label, holder, name, replacement, early } of cases) {
  const original = holder[name];
  holder[name] = replacement;
  lines.push(label + " replaced before the first call: " + early() + ", " + takeCounts());
  holder[name] = original;
  lines.push(label + " restored after the first call: " + early() + ", " + takeCounts());
}

for (const { label, holder, name, replacement, hot } of cases) {
  const original = holder[name];
  lines.push(label + " original: " + hot() + ", " + takeCounts());
  holder[name] = replacement;
  Bun.gc(true);
  lines.push(label + " replaced: " + hot() + ", " + takeCounts());
  holder[name] = original;
  Bun.gc(true);
  lines.push(label + " restored: " + hot() + ", " + takeCounts() + ", same function: " + (holder[name] === original));
}

const bufferLike = {
  from(text: string) {
    return { length: text.length + 5000 };
  },
  byteLength(text: string) {
    return text.length + 7000;
  },
};
function lengthsThrough(holder: typeof Buffer): number {
  let sum = 0;
  for (let i = 0; i < rounds; i++) {
    const text = texts[i % texts.length];
    sum += holder.from(text).length + holder.byteLength(text);
  }
  return sum;
}
lines.push("Buffer as an argument: " + lengthsThrough(Buffer));
lines.push("a Buffer-like object as an argument: " + lengthsThrough(bufferLike as unknown as typeof Buffer));
lines.push("Buffer as an argument again: " + lengthsThrough(Buffer));

const realBuffer = Buffer;
(globalThis as any).Buffer = bufferLike;
lines.push("a Buffer-like object as the global: " + bufferFromHot() + " " + byteLengthHot());
(globalThis as any).Buffer = realBuffer;
lines.push("Buffer as the global again: " + bufferFromHot() + " " + byteLengthHot());

function oneInspection(text: string): unknown {
  return Bun.inspect(text);
}
let warmSum = 0;
for (let i = 0; i < rounds; i++) warmSum += String(oneInspection(texts[i % texts.length])).length;
lines.push("one call at a time: " + warmSum);

(Bun as any).inspect = undefined;
Bun.gc(true);
const laterFunctions: Function[] = [];
for (let i = 0; i < 5000; i++) laterFunctions.push(new Function("text", "return 7"));
let wrongAnswers = 0;
for (const laterFunction of laterFunctions) {
  (Bun as any).inspect = laterFunction;
  if (oneInspection("abc") !== 7) wrongAnswers++;
}
lines.push("functions created after the original was dropped and collected: " + wrongAnswers + " wrong answers");

console.log(lines.join("\n"));
//// replaced-prototype-getters.ts
// A getter of a host class that may be redefined is read many times, then replaced on its prototype, deleted, inherited from an object put behind, and put back: each read answers as plain Bun does. A locked prototype leaves the attributes of its members as they are and is not extensible: that tells URL.prototype and URLSearchParams.prototype apart, whose getters are only read.
import { SocketAddress } from "node:net";

const lines: string[] = [];
////= say

const pathnameOf = (url: URL): unknown => url.pathname;
const sizeOf = (params: URLSearchParams): unknown => params.size;
const abortedOf = (signal: AbortSignal): unknown => signal.aborted;
const addressOf = (address: SocketAddress): unknown => address.address;
const portOf = (address: SocketAddress): unknown => address.port;
const untyped = (holder: any, name: "pathname" | "size" | "aborted" | "address" | "port"): unknown => {
  switch (name) {
    case "pathname":
      return holder.pathname;
    case "size":
      return holder.size;
    case "aborted":
      return holder.aborted;
    case "address":
      return holder.address;
    case "port":
      return holder.port;
  }
};

function all<T extends object>(label: string, name: "pathname" | "size" | "aborted" | "address" | "port", make: () => T, read: (holder: T) => unknown) {
  const holder = make();
  const prototype = Object.getPrototypeOf(holder) as object;
  const original = Object.getOwnPropertyDescriptor(prototype, name);
  const both = (on: T = holder) => [read(on), untyped(on, name)];
  const mayBeRedefined = !!original?.configurable && Object.isExtensible(prototype);
  say(label + " has a descriptor that may be redefined", () => [mayBeRedefined, typeof original?.get]);
  say(label + " read many times", () => {
    let same = 0;
    const first = JSON.stringify(both());
    for (let turn = 0; turn < 200; turn++) if (JSON.stringify(both()) === first) same++;
    return [first, same];
  });
  if (!mayBeRedefined) return;
  say(label + " replaced by a getter", () => (Object.defineProperty(prototype, name, { get: () => "replaced", configurable: true }), [both(), both(make())]));
  say(label + " replaced by another getter", () => (Object.defineProperty(prototype, name, { get: () => "replaced again", configurable: true }), [both(), both(make())]));
  say(label + " replaced by a value", () => (Object.defineProperty(prototype, name, { value: 7, writable: true, configurable: true }), [both(), both(make())]));
  say(label + " whose value is stored to", () => (((prototype as Record<string, unknown>)[name] = 8), [both(), both(make())]));
  say(label + " put back", () => (Object.defineProperty(prototype, name, original), [both(), both(make())]));
  say(label + " deleted", () => [delete (prototype as Record<string, unknown>)[name], both(), both(make())]);
  const behind = Object.getPrototypeOf(prototype) as object;
  say(label + " inherited from an object put behind", () => (Object.setPrototypeOf(prototype, Object.create(behind, { [name]: { value: "from behind", configurable: true } })), [both(), both(make())]));
  say(label + " put back in front of it", () => (Object.defineProperty(prototype, name, original), [both(), both(make())]));
  say(label + " with the chain as it was", () => (Object.setPrototypeOf(prototype, behind), [both(), both(make())]));
  say(label + " behind an own property", () => (Object.defineProperty(holder, name, { value: "own", configurable: true }), [both(), both(make())]));
  say(label + " without the own property", () => [delete (holder as Record<string, unknown>)[name], both(), both(make())]);
}

all("URL.pathname", "pathname", () => new URL("http://example.com/a/b?c=d"), pathnameOf);
all("URLSearchParams.size", "size", () => new URLSearchParams("a=1&b=2"), sizeOf);
all("AbortSignal.aborted", "aborted", () => AbortSignal.abort(), abortedOf);
all("SocketAddress.address", "address", () => new SocketAddress({ address: "127.0.0.1", port: 80 }), addressOf);
all("SocketAddress.port", "port", () => new SocketAddress({ address: "127.0.0.1", port: 80 }), portOf);
console.log(lines.join("\n"));
//// request-header-reads.ts
// `request.headers.get(name)` on the requests of a server, with and without a route, and on everything that only looks like one.
const constantName = (request: Request) => request.headers.get("x-a");
const givenName = (request: Request, name: string) => request.headers.get(name);
const anyName = (request: Request, name: unknown) => request.headers.get(name as any);
const ofResponse = (response: Response) => response.headers.get("x-a");
const ofAnything = (holder: { headers: { get(name: string): unknown } }) => holder.headers.get("x-a");

function attempt(run: () => unknown) {
  try {
    return run();
  } catch (error) {
    return `${(error as Error).name}: ${(error as Error).message}`;
  }
}

const nameOfError = (run: () => unknown) => String(attempt(run)).split(":")[0];

function rowsOf(request: Request) {
  const log: string[] = [];
  const rows: unknown[] = [
    constantName(request),
    givenName(request, "X-A"),
    givenName(request, "x-absent"),
    givenName(request, "x-empty"),
    givenName(request, "x-latin"),
    givenName(request, "x-twice"),
    givenName(request, "cookie"),
    givenName(request, "set-cookie"),
    givenName(request, "host") !== null,
    givenName(request, "content-type"),
    attempt(() => givenName(request, "")),
    attempt(() => givenName(request, "a b")),
    attempt(() => givenName(request, "café")),
    attempt(() => givenName(request, "世")),
    attempt(() => anyName(request, 1)),
    attempt(() => anyName(request, undefined)),
    attempt(() => anyName(request, null)),
    attempt(() => anyName(request, Symbol("x-a"))),
    attempt(() => anyName(request, { toString: () => (log.push("converted"), "x-a") })),
    attempt(() => anyName(request, { toString: () => (request.headers.set("x-a", "set while the name was converted"), "x-a") })),
    attempt(() =>
      anyName(request, {
        toString() {
          throw new RangeError("thrown by the name");
        },
      }),
    ),
    log,
  ];
  return rows;
}

function afterwards(request: Request) {
  const headers = request.headers;
  const rows: unknown[] = [headers === request.headers, constantName(request)];
  headers.set("x-a", "changed");
  rows.push(constantName(request), givenName(request, "x-a"));
  headers.delete("x-a");
  rows.push(constantName(request));
  headers.append("x-a", "one");
  headers.append("x-a", "two");
  rows.push(constantName(request), request.clone().headers.get("x-a"), [...headers.keys()].includes("x-twice"));
  return rows;
}

const untouched = (request: Request) => Response.json([constantName(request), givenName(request, "x-twice"), [...request.headers].filter(([name]) => name.startsWith("x-"))]);
const first = (request: Request) => Response.json([rowsOf(request), afterwards(request)]);
const later = async (request: Request) => {
  const before = constantName(request);
  await Bun.sleep(1);
  return Response.json([before, rowsOf(request), afterwards(request)]);
};
const onlyLater = async (request: Request) => {
  await Bun.sleep(1);
  return Response.json([constantName(request), givenName(request, "x-twice"), givenName(request, "x-absent")]);
};

const server = Bun.serve({
  port: 0,
  routes: { "/static": new Response("static"), "/routed/untouched": untouched, "/routed/first": first, "/routed/later": later, "/routed/only-later": onlyLater },
  fetch(request) {
    const path = new URL(request.url).pathname;
    return path === "/untouched" ? untouched(request) : path === "/first" ? first(request) : path === "/later" ? later(request) : path === "/only-later" ? onlyLater(request) : new Response("none", { status: 404 });
  },
});

function send(path: string): Promise<string> {
  const lines = [`GET ${path} HTTP/1.1`, "Host: localhost", "x-a: 1", "X-Empty:", "x-latin: café", "x-twice: a", "X-Twice: b", "Cookie: a=1", "Cookie: b=2", "Set-Cookie: c=3", "Set-Cookie: d=4", "Connection: close", "", ""];
  return new Promise((resolve, reject) => {
    let received = "";
    Bun.connect({
      hostname: "127.0.0.1",
      port: server.port!,
      socket: {
        open: (socket) => void socket.write(Buffer.from(lines.join("\r\n"), "latin1")),
        data: (_, chunk) => void (received += chunk.toString("utf8")),
        close: () => resolve(received.slice(received.indexOf("\r\n\r\n") + 4)),
        error: (_, error) => reject(error),
      },
    }).catch(reject);
  });
}

for (const path of ["/untouched", "/first", "/later", "/only-later", "/routed/untouched", "/routed/first", "/routed/later", "/routed/only-later"]) console.log(path, await send(path));
await server.stop(true);

class Subclass extends Request {}
