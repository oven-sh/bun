//// request-header-reads-untyped.js
// Untyped code, as a framework writes it: the request stands in a field of a wrapper, and the name is a parameter.
class Wrapper {
  raw;
  constructor(raw) {
    this.raw = raw;
  }
  header(name) {
    if (name) return this.raw.headers.get(name) ?? undefined;
    return Object.fromEntries(this.raw.headers);
  }
}
function constantName(request) {
  return request.headers.get("x-a");
}
function keptHeaders(request) {
  const headers = request.headers;
  return [headers.get("x-a"), headers === request.headers];
}
export function twoArguments(request) {
  return request.headers.get("x-a", "x-b");
}
export function noArgument(request) {
  return request.headers.get();
}
export function nameRunsCode(request, log) {
  return request.headers.get(log.push("name") && "x-a");
}
function nameAfter(depth) {
  return depth > 0 ? nameAfter(depth - 1) : "x-a";
}
export function nameByCall(request) {
  return request.headers.get(nameAfter(3));
}
export async function nameByAwait(request) {
  return request.headers.get(await Promise.resolve("x-a"));
}
export function* nameByYield(request) {
  return request.headers.get(yield "which");
}
const candidates = ["accept", "host", "x-a", "x-b"];
function firstOfOurs(names) {
  let found = "";
  for (let round = 0; round < 2; round++) {
    for (const name of names) {
      try {
        if (!found && name.startsWith("x-")) found = name;
      } catch {
        found = "";
      }
    }
  }
  return found;
}
export function headersThenCall(request) {
  const headers = request.headers;
  const name = firstOfOurs(candidates);
  return headers.get(name);
}
export async function headersThenAwait(request) {
  const headers = request.headers;
  const name = await Promise.resolve("x-a");
  return headers.get(name);
}
////= attempt
const nameOfError = (run) => String(attempt(run)).split(":")[0];
function rowsOf(request) {
  const wrapper = new Wrapper(request);
  const log = [];
  return [
    wrapper.header("x-a"),
    wrapper.header("X-A"),
    wrapper.header("x-absent"),
    wrapper.header("x-twice"),
    constantName(request),
    twoArguments(request),
    attempt(() => noArgument(request)),
    nameRunsCode(request, log),
    log,
    keptHeaders(request),
    constantName(request),
    Object.keys(wrapper.header()).filter((name) => name.startsWith("x-")),
  ];
}

const server = Bun.serve({
  port: 0,
  routes: { "/routed": (request) => Response.json(rowsOf(request)) },
  fetch: async (request) => {
    const before = new Wrapper(request).header("x-a");
    await null;
    return Response.json([before, rowsOf(request)]);
  },
});
for (const path of ["/routed", "/plain", "/routed", "/plain"]) {
  const headers = new Headers({ "x-a": "1" });
  headers.append("x-twice", "a");
  headers.append("x-twice", "b");
  console.log(path, await (await fetch(new URL(path, server.url), { headers })).text());
}
await server.stop(true);

const looksLikeOne = { headers: { get: (name) => `looks like ${name}` } };
const getter = {
  reads: 0,
  get headers() {
    this.reads++;
    return new Map([["x-a", "from a getter"]]);
  },
};
console.log(
  JSON.stringify([
    constantName(looksLikeOne),
    new Wrapper(looksLikeOne).header("x-a"),
    constantName(getter),
    getter.reads,
    constantName(new Response("", { headers: { "x-a": "response" } })),
    constantName(new Request("http://localhost/", { headers: { "x-a": "made" } })),
    nameByCall(new Request("http://localhost/", { headers: { "x-a": "by a call" } })),
    await nameByAwait(new Request("http://localhost/", { headers: { "x-a": "by an await" } })),
    headersThenCall(new Request("http://localhost/", { headers: { "x-a": "headers, then a call" } })),
    await headersThenAwait(new Request("http://localhost/", { headers: { "x-a": "headers, then an await" } })),
    ((generator) => [generator.next().value, generator.next("x-a").value])(nameByYield(new Request("http://localhost/", { headers: { "x-a": "by a yield" } }))),
    nameOfError(() => constantName(undefined)),
    nameOfError(() => constantName({ headers: null })),
    nameOfError(() => constantName({ headers: {} })),
    nameOfError(() => constantName(1)),
    nameOfError(() => constantName("text")),
  ]),
);
//// request-headers-without-headers-object.ts
// `request.headers.get(name)` and `request.headers.has(name)` on every kind of request, before and after everything a program can do to a request or to its headers: each gives what plain Bun gives.
import { connect } from "node:net";
import type { BunRequest } from "bun";

const lines: string[] = [];
function attempt(work: () => unknown): unknown {
  try {
    return work();
  } catch (error) {
    return "throws " + (error as Error).constructor.name + ": " + (error as Error).message;
  }
}

function readsOne(request: Request) {
  return request.headers.get("x-one");
}
function asksForOne(request: Request) {
  return request.headers.has("x-one");
}
function readsByVariable(request: Request, name: string) {
  return request.headers.get(name);
}
export function readsOfAnything(request: any) {
  return request.headers.get("x-one");
}
function readsMany(request: Request) {
  return [
    request.headers.get("x-one"),
    request.headers.get("X-One"),
    request.headers.get("X-ONE"),
    request.headers.get("x-two"),
    request.headers.get("x-empty"),
    request.headers.get("x-absent"),
    request.headers.get("x-dup"),
    request.headers.get("cookie"),
    request.headers.get("accept"),
    request.headers.get("Content-Type"),
    request.headers.get("host") === null,
    request.headers.get("x-latin"),
    request.headers.get("x-spaces"),
    request.headers.has("x-one"),
    request.headers.has("X-Two"),
    request.headers.has("x-empty"),
    request.headers.has("x-absent"),
    request.headers.has("x-dup"),
    request.headers.has("content-type"),
  ];
}
function invalidNames(request: Request) {
  return [
    attempt(() => request.headers.get("bad name")),
    attempt(() => request.headers.get("")),
    attempt(() => request.headers.get("x:y")),
    attempt(() => request.headers.get("café")),
    attempt(() => request.headers.get("中")),
    attempt(() => request.headers.has("bad name")),
    attempt(() => request.headers.has("")),
  ];
}
function readsOfRoute(request: BunRequest<"/route/:id">) {
  return [request.params.id, request.headers.get("x-one"), request.headers.has("x-two"), request.headers.get("x-absent")];
}

////= lines-17	Subclass	Request	"x-one"	"of the subclass"
class PlainSubclass extends Request {}

const handlers: Record<string, (request: Request) => unknown> = {
  "/many": readsMany,
  "/one": request => [readsOne(request), asksForOne(request), readsByVariable(request, "x-one"), readsOfAnything(request)],
  "/invalid": invalidNames,
  "/invalid-after-the-object-is-made": request => [typeof request.headers, invalidNames(request)],
  "/twice": request => [readsOne(request), readsOne(request), readsMany(request).join() === readsMany(request).join()],
  "/then-the-object": request => {
    const before = readsOne(request);
    const headers = request.headers;
    return [before, headers.get("x-one"), readsOne(request), headers === request.headers, [...headers.keys()].filter(key => key.startsWith("x-")).join()];
  },
  "/after-await": async request => {
    const before = readsOne(request);
    await Promise.resolve();
    const soon = readsMany(request);
    await new Promise(resolve => setTimeout(resolve, 2));
    return [before, soon, readsMany(request)];
  },
  "/only-after-await": async request => {
    await new Promise(resolve => setTimeout(resolve, 2));
    return readsMany(request);
  },
  "/after-the-body": async request => [await request.text(), readsMany(request)],
  "/set": request => {
    const before = readsOne(request);
    request.headers.set("x-one", "set");
    request.headers.set("x-added", "added");
    return [before, readsOne(request), request.headers.get("x-added"), request.headers.has("x-added")];
  },
  "/delete": request => {
    request.headers.delete("x-one");
    return [readsOne(request), asksForOne(request)];
  },
  "/append": request => {
    request.headers.append("x-one", "more");
    return [readsOne(request), asksForOne(request)];
  },
  "/own-get-on-the-headers": request => {
    const before = readsOne(request);
    (request.headers as unknown as Record<string, unknown>).get = () => "own get";
    (request.headers as unknown as Record<string, unknown>).has = () => false;
    return [before, readsOne(request), asksForOne(request)];
  },
  "/own-other-property-on-the-headers": request => {
    (request.headers as unknown as Record<string, unknown>).note = 1;
    return [readsOne(request), asksForOne(request)];
  },
  "/prototype-of-the-headers": request => {
    Object.setPrototypeOf(request.headers, { get: () => "another prototype", has: () => false });
    return [readsOne(request), asksForOne(request)];
  },
  "/own-headers-on-the-request": request => {
    const before = readsOne(request);
    Object.defineProperty(request, "headers", { value: new Headers({ "x-one": "own headers" }), configurable: true });
    const shadowed = [readsOne(request), asksForOne(request)];
    delete (request as unknown as Record<string, unknown>).headers;
    return [before, shadowed, readsOne(request)];
  },
  "/own-other-property-on-the-request": request => {
    (request as unknown as Record<string, unknown>).note = 1;
    return [readsOne(request), asksForOne(request)];
  },
  "/prototype-of-the-request": request => {
    Object.setPrototypeOf(request, Object.create(Request.prototype, { headers: { value: new Headers({ "x-one": "another prototype" }) } }));
    return [readsOne(request), asksForOne(request)];
  },
  "/clone": request => {
    const before = readsOne(request);
    const clone = request.clone();
    return [before, readsOne(clone), readsMany(clone).join() === readsMany(request).join()];
  },
  "/clone-first": request => {
    const clone = request.clone();
    clone.headers.set("x-one", "of the clone");
    return [readsOne(clone), readsOne(request)];
  },
  "/made-from-it": request => {
    const made = new Request(request);
    const changed = new Request(request, { headers: { "x-one": "changed" } });
    return [readsOne(made), readsOne(changed), readsOne(request), changed.headers.get("x-two")];
  },
  "/subclass-made-from-it": request => [readsOne(new Subclass(request)), asksForOne(new Subclass(request)), readsOne(new PlainSubclass(request)), asksForOne(new PlainSubclass(request))],
};

const server = Bun.serve({
  hostname: "127.0.0.1",
  port: 0,
  routes: {
    "/route/:id": request => Response.json(readsOfRoute(request)),
  },
  async fetch(request) {
    const handler = handlers[new URL(request.url).pathname];
    return Response.json(await handler(request));
  },
});

function send(path: string, headerLines: string[], body = ""): Promise<string> {
  return new Promise((resolve, reject) => {
    const socket = connect(server.port!, "127.0.0.1", () => {
      const head = [`${body ? "POST" : "GET"} ${path} HTTP/1.1`, "Host: 127.0.0.1", "Connection: close", ...headerLines];
      if (body) head.push("Content-Length: " + Buffer.byteLength(body));
      socket.write(Buffer.from(head.join("\r\n") + "\r\n\r\n" + body, "latin1"));
    });
    const chunks: Buffer[] = [];
    socket.on("data", chunk => chunks.push(chunk as Buffer));
    socket.on("error", reject);
    socket.on("close", () => {
      const text = Buffer.concat(chunks).toString("utf8");
      resolve(text.slice(text.indexOf("\r\n\r\n") + 4));
    });
  });
}

const usual = [
  "X-One: 1",
  "x-two: two words",
  "X-Empty:",
  "x-dup: a",
  "X-Dup: b",
  "Cookie: a=1",
  "Cookie: b=2",
  "Accept: text/html",
  "Accept: application/json",
  "Content-Type: text/plain",
  "X-Latin: café",
  "X-Spaces:    padded   ",
];
for (const path of Object.keys(handlers)) {
  lines.push(path + ": " + (await send(path, usual, path === "/after-the-body" ? "the body" : "")));
  lines.push(path + ", no headers: " + (await send(path, [], path === "/after-the-body" ? "the body" : "")));
}
lines.push("/route/7: " + (await send("/route/7", usual)));
lines.push("/route/8, no headers: " + (await send("/route/8", [])));
server.stop(true);

const made: [string, () => Request][] = [
  ["no init", () => new Request("http://localhost/")],
  ["a record", () => new Request("http://localhost/", { headers: { "X-One": "record", "x-two": "2" } })],
  ["pairs with a repeated name", () => new Request("http://localhost/", { headers: [["x-one", "a"], ["X-One", "b"]] })],
  ["a Headers object", () => new Request("http://localhost/", { headers: new Headers({ "x-one": "object" }) })],
  ["a body with a type", () => new Request("http://localhost/", { method: "POST", body: new Blob(["x"], { type: "a/b" }) })],
  ["a string body", () => new Request("http://localhost/", { method: "POST", body: "text" })],
  ["a form body", () => new Request("http://localhost/", { method: "POST", body: new URLSearchParams({ a: "1" }) })],
  ["a subclass with its own getter", () => new Subclass("http://localhost/", { headers: { "x-one": "ignored" } })],
  ["a subclass without members", () => new PlainSubclass("http://localhost/", { headers: { "x-one": "plain subclass" } })],
];
for (const [label, make] of made) {
  lines.push(label + ": " + JSON.stringify([readsOne(make()), asksForOne(make()), make().headers.get("content-type"), make().headers.has("content-type"), invalidNames(make()).length]));
  const request = make();
  lines.push(label + ", read again: " + JSON.stringify([readsOne(request), readsOne(request), request.headers.get("content-type"), typeof request.headers, readsOne(request)]));
}
lines.push("not a request at all: " + JSON.stringify(attempt(() => readsOne({ headers: { get: (name: string) => "a look-alike: " + name } } as unknown as Request))));
lines.push("null: " + String(attempt(() => readsOne(null as unknown as Request))).split(":")[0]);
lines.push("a Response in its place: " + JSON.stringify(attempt(() => readsOne(new Response("", { headers: { "x-one": "of a response" } }) as unknown as Request))));

console.log(lines.join("\n"));
//// response-bodies-of-unshared-ropes.ts
// A concatenation that nothing but one `new Response(text, { .. })` can reach is written as UTF-8 for the body without being flattened into a string. Whatever else may hold the text keeps today's road.
const filler = "0123456789abcdef".repeat(20);
const init = (kind: string) => ({ "Content-Type": kind });
function direct(title: string, text: string): Response {
  return new Response(`<h1>${title}</h1><p>${text}</p>`, { status: 200, headers: { "Content-Type": "text/html; charset=utf-8" } });
}
function page(body: string, status = 200): Response {
  return new Response(body, { status, headers: { "Content-Type": "text/html; charset=utf-8" } });
}
function layout(title: string, content: string): string {
  return `<title>${title}</title><main>${content}</main>`;
}
function item(text: string): string {
  return `<li>${text}</li>`;
}
function throughHelpers(title: string, texts: string[]): Response {
  return page(layout(title, `<ul>${texts.map(item).join("")}</ul>`));
}
function chosen(title: string, text: string, isShort: boolean): Response {
  const body = isShort ? `<p>${text}</p>` : `<h1>${title}</h1><p>${text}</p><p>${text}</p>`;
  return new Response(body, { headers: { "Content-Type": "text/html" } });
}
function readAfterwards(title: string, text: string): [Response, number] {
  const body = `<h1>${title}</h1><p>${text}</p>`;
  return [new Response(body, { status: 200 }), body.length];
}
const kept = new Map<string, string>();
function keptInAMap(title: string, text: string): Response {
  const body = `<h1>${title}</h1><p>${text}</p>`;
  kept.set(title, body);
  return new Response(body, { status: 200 });
}
function cached(title: string): string {
  return kept.get(title) ?? "";
}
function fromTheMap(title: string): Response {
  return new Response(cached(title), { status: 200 });
}
function withNothingAdded(title: string, more: string): Response {
  return new Response(cached(title) + more, { status: 200 });
}
function inALoop(title: string, text: string): Response[] {
  const body = `<h1>${title}</h1><p>${text}</p>`;
  const all: Response[] = [];
  for (let i = 0; i < 3; i++) all.push(new Response(body, { status: 200 + i }));
  return all;
}
function open(body: string): Response {
  return new Response(body, { status: 200 });
}
const usedAsValues = [open];

const lines: string[] = [];
const hex = (bytes: Uint8Array) => Bun.hash.crc32(bytes).toString(16) + "/" + bytes.length;
const codes = (text: string) => text.length + ":" + Bun.hash.crc32(Buffer.from(text, "utf16le")).toString(16);
async function say(label: string, make: () => Response) {
  const text = await make().text();
  const bytes = new Uint8Array(await make().arrayBuffer());
  const copy = make();
  const cloned = copy.clone();
  const blob = await make().blob();
  lines.push(
    label + ": " + JSON.stringify([codes(text), hex(bytes), codes(await cloned.text()), codes(await copy.text()), blob.size, blob.type, make().headers.get("content-type"), text.slice(0, 24), text.slice(-12)]),
  );
}
const texts: [string, string][] = [
  ["ASCII", filler],
  ["short", "x"],
  ["empty", ""],
  ["Latin-1", filler + "café · naïve ÿ" + filler],
  ["two bytes a character and three", filler + "Ωmega — 東京" + filler],
  ["pairs of surrogates", filler + "😀 and 🤭" + filler],
  ["only wide", "東京".repeat(200)],
  ["a lone high surrogate", filler + "\ud83d" + filler],
  ["a lone low surrogate", filler + "\ude00" + filler],
  ["a high surrogate at the end", filler + "\ud83d"],
  ["a low surrogate at the start", "\ude00" + filler],
  ["a zero", filler + "\0" + filler],
  ["U+FFFD, U+FFFE, U+FFFF", filler + "�￾￿" + filler],
  ["a mark inside", filler + "﻿" + filler],
];
for (const [label, text] of texts) {
  await say("direct, " + label, () => direct("T", text));
  await say("through helpers, " + label, () => throughHelpers(text.slice(0, 40), [text, "b", text.slice(3, 90)]));
  await say("chosen, short, " + label, () => chosen("T", text, true));
  await say("chosen, long, " + label, () => chosen(text.slice(-30), text, false));
  await say("read afterwards, " + label, () => readAfterwards("T", text)[0]);
  await say("kept in a map, " + label, () => keptInAMap("k" + label, text));
  await say("from the map, " + label, () => fromTheMap("k" + label));
  await say("from the map again, " + label, () => fromTheMap("k" + label));
  await say("nothing added, " + label, () => withNothingAdded("k" + label, ""));
  await say("something added, " + label, () => withNothingAdded("k" + label, "!"));
  await say("in a loop, " + label, () => inALoop("T", text)[2]!);
  await say("open, " + label, () => usedAsValues[0]!(`<p>${text}</p>${filler}`));
}
function anyPage(body: string): Response {
  return new Response(body, { status: 200, headers: { "Content-Type": "text/html; charset=utf-8" } });
}
const halves = (first: string, second: string) => anyPage(`${first}${filler}`.slice(0, first.length) + `${second}${filler}`);
await say("a pair split between two pieces", () => page(`${filler}\ud83d` + `\ude00${filler}`));
await say("a pair split between a slice and a piece", () => halves(filler + "\ud83d", "\ude00"));
await say("a mark at the start", () => page(`﻿${filler}` + `${filler}.`));
await say("a mark at the start, written as a piece of its own", () => direct("﻿", filler));
await say("the start is a mark after an empty piece", () => page(`${""}﻿` + `${filler}${filler}.`));
await say("slices of a wide text", () => anyPage(`${("東京" + filler).slice(1, 200)}|${("é" + filler).slice(0, 150)}|${filler.slice(5)}`));
await say("numbers and the rest", () => page(`${1.5}${filler}${-0}${null}|${undefined}${true}${12345678901234567890n}${filler}`));
let deep = "";
for (let i = 0; i < 3000; i++) deep = i % 2 ? `<${deep}>` : `${deep}é${i}`;
await say("three thousand levels", () => page(`${deep}!`));
lines.push("the length after: " + readAfterwards("T", filler)[1] + ", the kept text: " + codes(kept.get("kASCII")!));
{
  using server = Bun.serve({
    port: 0,
    hostname: "127.0.0.1",
    routes: {
      "/wide": () => throughHelpers("東京 😀", [filler, "é", filler]),
      "/narrow": () => throughHelpers("T", [filler, "b", filler]),
      "/later": async () => {
        await Bun.sleep(1);
        return throughHelpers("later — 東京", [filler, filler]);
      },
    },
  });
  for (const path of ["/wide", "/narrow", "/later"]) {
    const answer = await fetch(new URL(path, server.url));
    const bytes = new Uint8Array(await answer.arrayBuffer());
    lines.push("served " + path + ": " + JSON.stringify([answer.status, answer.headers.get("content-type"), answer.headers.get("content-length"), hex(bytes)]));
  }
}
let sum = 0;
for (let i = 0; i < 3000; i++) {
  sum += (await throughHelpers("n" + i, [filler, i % 7 ? "plain" : "東京", filler]).arrayBuffer()).byteLength;
  if (i % 500 === 0) Bun.gc(true);
}
lines.push("many: " + sum);
console.log(lines.join("\n"));
//// response-bodies-with-latin1-pieces.ts
// A piece of a page that is Latin-1 and holds a character beyond ASCII is written as UTF-8 eight characters at a time. Every place of such a character in a word, runs of them, and pieces of every short length give the bytes that a flattened string gives.
const filler = "0123456789abcdef".repeat(20);
function page(first: string, second: string, third: string): Response {
  return new Response(`<a>${first}</a><b>${second}</b><c>${third}</c>${filler}`, { status: 200, headers: { "Content-Type": "text/html; charset=utf-8" } });
}
const seen: string[] = [];
function shared(first: string, second: string): Response {
  const body = `<a>${first}</a><b>${second}</b>${filler}`;
  seen.push(body);
  return new Response(body, { status: 200 });
}
const lines: string[] = [];
let sum = 0;
async function take(response: Response): Promise<string> {
  const bytes = new Uint8Array(await response.arrayBuffer());
  sum = (sum * 31 + Bun.hash.crc32(bytes) + bytes.length) % 1000000007;
  return Bun.hash.crc32(bytes).toString(16) + "/" + bytes.length;
}
const plain = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".repeat(8);
const beyond = ["\u0080", " ", "·", "¿", "À", "é", "ÿ"];
for (let length = 1; length <= 72; length++) {
  for (let at = 0; at < length; at++) {
    const character = beyond[(length + at) % beyond.length]!;
    const piece = plain.slice(0, at) + character + plain.slice(at + 1, length);
    await take(page(piece, "x", plain.slice(0, length)));
  }
}
lines.push("one character beyond ASCII at every place of pieces of 1 to 72: " + sum);
for (const length of [127, 128, 129, 130, 143, 144, 145, 255, 256, 257, 1000, 4095, 4096, 4097, 20000]) {
  const long = plain.repeat(Math.ceil(length / plain.length)).slice(0, length);
  const places = [0, 1, 7, 8, 9, 15, 16, 63, 64, length >> 1, length - 9, length - 8, length - 2, length - 1].filter(at => at >= 0 && at < length);
  const answers: string[] = [];
  for (const at of places) answers.push(await take(page(long.slice(0, at) + "é" + long.slice(at + 1), long, "ÿ")));
  lines.push(length + ": " + answers.join(" "));
}
for (const run of [1, 2, 7, 8, 9, 16, 17, 100, 5000]) {
  lines.push("a run of " + run + ": " + (await take(page("ü".repeat(run), "a" + "\u0080".repeat(run) + "z", plain + "ÿ".repeat(run)))));
  lines.push("every other, " + run + ": " + (await take(page("aé".repeat(run), "éa".repeat(run), "abcdefgé".repeat(run)))));
}
lines.push("only ASCII: " + (await take(page(plain, plain.slice(3), ""))));
lines.push("a wide piece between: " + (await take(page(plain + "é", "東京", "é" + plain))));
lines.push("a slice of a wide text that is Latin-1: " + (await take(page(("東" + plain + "é" + plain).slice(1), "", ""))));
lines.push("shared: " + (await take(shared(plain + "é" + plain, "ÿ"))) + " " + seen[0]!.length);
lines.push("as text: " + (await page("café · naïve", "ÿ".repeat(3), plain.slice(0, 9) + "é").text()).slice(0, 60));
console.log(lines.join("\n"));
