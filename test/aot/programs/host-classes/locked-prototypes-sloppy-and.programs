//// native-functions-that-count-their-arguments.js
// Native functions of the host that count their arguments: called with none they throw, and `undefined` counts as one. Bare, through a variable, through globalThis, by call, apply, a spread of nothing and Reflect.apply.
function attempt(run) { try { const v = run(); return typeof v === "object" && v !== null ? JSON.stringify(v) : String(v); } catch (e) { return e.constructor.name + ": " + e.message; } }
const clone = structuredClone, none = [];
console.log("bare", attempt(() => structuredClone()));
console.log("variable", attempt(() => clone()));
console.log("globalThis", attempt(() => globalThis.structuredClone()));
console.log("call", attempt(() => structuredClone.call(undefined)));
console.log("apply", attempt(() => structuredClone.apply(undefined, [])));
console.log("spread", attempt(() => structuredClone(...none)));
console.log("Reflect.apply", attempt(() => Reflect.apply(structuredClone, undefined, none)));
console.log("bound", attempt(structuredClone.bind(undefined)));
console.log("undefined", attempt(() => structuredClone(undefined)), attempt(() => clone(undefined)), attempt(() => structuredClone(undefined, undefined)), attempt(() => structuredClone(void 0, null)));
console.log("values", attempt(() => structuredClone(1)), attempt(() => structuredClone("a")), attempt(() => structuredClone(null)), attempt(() => structuredClone({ a: [1, { b: 2 }] })), attempt(() => structuredClone(5n)), attempt(() => structuredClone(true, {})));
console.log("refused", attempt(() => structuredClone(() => {})).split(":")[0], attempt(() => structuredClone(Symbol("s"))).split(":")[0], attempt(() => structuredClone(1, 5)).split(":")[0]);
function many(n) { let thrown = 0; for (let i = 0; i < n; i++) { try { i & 1 ? structuredClone() : structuredClone(i); } catch { thrown++; } } return thrown; }
console.log("in a loop", many(400));
for (const name of ["atob", "btoa", "queueMicrotask", "setTimeout", "setInterval", "setImmediate", "clearTimeout", "reportError", "fetch", "postMessage"]) {
  if (name === "fetch") { console.log(name, typeof attempt(() => { const p = fetch(); p.catch(() => {}); return "a promise"; })); continue; }
  console.log(name, attempt(() => { const v = globalThis[name](); return typeof v; }).split("\n")[0]);
}
console.log("bare again", attempt(() => atob()), attempt(() => btoa()), attempt(() => queueMicrotask()).split("\n")[0]);
//// native-getters-any-receiver.ts
// A getter of a native class (Request, Response, Blob) read from every kind of receiver that TypeScript lets pass for an instance: the answers are plain Bun's. Request.prototype itself refuses every change.
import vm from "node:vm";

const lines: string[] = [];
function say(label: string, work: () => unknown, withMessage = true) {
  let text: string;
  try {
    const value = work();
    text = typeof value === "string" ? JSON.stringify(value) : typeof value === "object" && value !== null ? Object.prototype.toString.call(value) : String(value);
  } catch (error) {
    text = "throws " + (error as Error).constructor.name + (withMessage ? ": " + (error as Error).message : "");
  }
  lines.push(label + ": " + text);
}

////= lines-16	urlOf	request	Request	request.url
////= lines-16	methodOf	request	Request	request.method
////= lines-16	headersOf	request	Request	request.headers
function lengthOfUrl(request: Request) {
  return request.url.length;
}
////= lines-16	statusOf	response	Response	response.status
////= lines-16	statusTextOf	response	Response	response.statusText
////= lines-16	sizeOf	blob	Blob	blob.size
function all(label: string, make: () => Request, urlIsText = true) {
  say(label + " url", () => urlOf(make()));
  say(label + " method", () => methodOf(make()));
  say(label + " headers", () => headersOf(make()));
  if (urlIsText) say(label + " url.length", () => lengthOfUrl(make()));
  say(label + " url twice", () => {
    const request = make();
    return urlOf(request) === urlOf(request);
  });
  say(label + " headers twice", () => {
    const request = make();
    return headersOf(request) === headersOf(request);
  });
}

const address = "http://example.com/a/b?c=d";
const fresh = () => new Request(address, { method: "POST", headers: { "x-one": "1" }, body: "abc" });

for (let turn = 0; turn < 200; turn++) {
  urlOf(fresh());
  methodOf(fresh());
  headersOf(fresh());
  lengthOfUrl(fresh());
}

all("an instance", fresh);

all("an own value in front", () => {
  const request = fresh();
  Object.defineProperty(request, "url", { value: "own value", configurable: true });
  Object.defineProperty(request, "method", { value: 7, configurable: true });
  Object.defineProperty(request, "headers", { value: null, configurable: true });
  return request;
});
all("an own value in front, after a read", () => {
  const request = fresh();
  urlOf(request);
  methodOf(request);
  headersOf(request);
  Object.defineProperty(request, "url", { value: "own value", configurable: true });
  Object.defineProperty(request, "method", { value: 7, configurable: true });
  Object.defineProperty(request, "headers", { value: null, configurable: true });
  return request;
});
let reads = 0;
all("an own getter in front", () => {
  const request = fresh();
  Object.defineProperty(request, "url", { get: () => "own getter " + ++reads, configurable: true });
  Object.defineProperty(request, "method", { get: () => undefined, configurable: true });
  Object.defineProperty(request, "headers", { get: () => [reads], configurable: true });
  return request;
});
all("an own getter that throws", () => {
  const request = fresh();
  for (const name of ["url", "method", "headers"])
    Object.defineProperty(request, name, {
      get() {
        throw new RangeError("no " + name);
      },
    });
  return request;
});
all("an own value put in front and deleted", () => {
  const request = fresh();
  Object.defineProperty(request, "url", { value: "own value", configurable: true });
  delete (request as any).url;
  return request;
});
all("another own property", () => {
  const request = fresh();
  (request as any).extra = 1;
  return request;
});
all("frozen", () => Object.freeze(fresh()));
all("frozen after a read", () => {
  const request = fresh();
  urlOf(request);
  return Object.freeze(request);
});
all("not extensible", () => Object.preventExtensions(fresh()));

for (const name of ["url", "method", "headers", "signal", "body", "bodyUsed"]) {
  say("Request.prototype." + name + " redefined", () => Object.defineProperty(Request.prototype, name, { get: () => "replaced" }) === Request.prototype, false);
  say("Request.prototype." + name + " made a value", () => Object.defineProperty(Request.prototype, name, { value: "replaced" }) === Request.prototype, false);
  say("Request.prototype." + name + " deleted", () => delete (Request.prototype as any)[name], false);
  say("Request.prototype." + name + " deleted by Reflect", () => Reflect.deleteProperty(Request.prototype, name));
  say("Request.prototype." + name + " assigned", () => ((Request.prototype as any)[name] = "replaced"), false);
  say("Request.prototype." + name + " assigned by Reflect", () => Reflect.set(Request.prototype, name, "replaced"));
  say("an instance's " + name + " assigned", () => ((fresh() as any)[name] = "replaced"), false);
  say("an instance's " + name + " assigned by Reflect", () => Reflect.set(fresh(), name, "replaced"));
  say("Request.prototype." + name + " described", () => {
    const { get, set, enumerable, configurable } = Object.getOwnPropertyDescriptor(Request.prototype, name)!;
    return [typeof get, typeof set, enumerable, configurable].join();
  });
}
all("an instance after all that", fresh);

class Heir extends Request {}
class HeirWithGetters extends Request {
  override get url() {
    return "heir of " + super.url;
  }
  override get method() {
    return "HEIR";
  }
  override get headers() {
    return new Headers({ heir: "yes" });
  }
}
class HeirWithFields extends Request {
  override url = "a field";
  override method = "FIELD";
}
all("an heir", () => new Heir(address, { method: "PUT" }));
all("an heir with getters", () => new HeirWithGetters(address, { method: "PUT" }));
all("an heir with fields", () => new HeirWithFields(address, { method: "PUT" }));
say("an heir with getters, header", () => (headersOf(new HeirWithGetters(address)) as Headers).get("heir"));

all("a plain object", () => ({ url: "plain", method: "PLAIN", headers: new Headers() }) as Request);
all("a plain object of other types", () => ({ url: 5, method: null, headers: "text" }) as unknown as Request, false);
all("an empty object", () => ({}) as Request, false);
all("an object that inherits from an instance", () => Object.create(fresh()) as Request);
all("an object that inherits from Request.prototype", () => Object.create(Request.prototype) as Request);
all("Request.prototype", () => Request.prototype);
all("an instance with another prototype", () => Object.setPrototypeOf(fresh(), { url: "of the other prototype", method: "OTHER" }) as Request);
all("an instance without a prototype", () => Object.setPrototypeOf(fresh(), null) as Request, false);
all("an instance with a prototype in between", () => Object.setPrototypeOf(fresh(), Object.create(Request.prototype, { url: { value: "in between" } })) as Request);
all("an instance with an empty prototype in between", () => Object.setPrototypeOf(fresh(), Object.create(Request.prototype)) as Request);
all("a Response", () => new Response("x", { status: 201, statusText: "Made", headers: { "x-two": "2" } }) as unknown as Request);
all("a Blob", () => new Blob(["abc"]) as unknown as Request, false);
all("a proxy without traps", () => new Proxy(fresh(), {}));
all("a proxy that reads from its target", () => new Proxy(fresh(), { get: (target, name) => Reflect.get(target, name, target) }));
all("a proxy that answers", () => new Proxy(fresh(), { get: (_, name) => "trapped " + String(name) }));
all("a function", () => function url() {} as unknown as Request, false);
all("an array", () => [] as unknown as Request, false);

const { get: getterOfUrl } = Object.getOwnPropertyDescriptor(Request.prototype, "url")!;
say("the getter on an instance", () => getterOfUrl!.call(fresh()));
say("the getter on an heir", () => getterOfUrl!.call(new HeirWithGetters(address)));
say("the getter on an instance with an own value", () => getterOfUrl!.call(Object.defineProperty(fresh(), "url", { value: "own value" })));
say("the getter on an object", () => getterOfUrl!.call({}));
say("the getter on undefined", () => getterOfUrl!.call(undefined));
say("the getter on a Response", () => getterOfUrl!.call(new Response()));
say("Reflect.get with an object for the receiver", () => Reflect.get(Request.prototype, "url", {}));
say("Reflect.get with an instance for the receiver", () => Reflect.get(Request.prototype, "url", fresh()));
say("Reflect.get of an instance with an object for the receiver", () => Reflect.get(fresh(), "url", {}));
say("Reflect.get of an object with an instance for the receiver", () => Reflect.get({ url: 1 }, "url", fresh()));

say("another realm's function for new.target", () => {
  const other = vm.runInNewContext("(function Other() {})");
  const request = Reflect.construct(Request, [address], other) as Request;
  return [urlOf(request), methodOf(request), Object.getPrototypeOf(request) === Request.prototype, Object.getPrototypeOf(request) === other.prototype].join();
});
say("another realm's function without a prototype for new.target", () => {
  const other = vm.runInNewContext("(function Other() {})");
  other.prototype = null;
  const request = Reflect.construct(Request, [address], other) as Request;
  return [urlOf(request), methodOf(request), Object.getPrototypeOf(request) === Request.prototype].join();
});
say("read in another realm", () => vm.runInNewContext("request.url + ' ' + request.method + ' ' + request.headers.get('x-one')", { request: fresh() }));
say("shadowed in another realm", () => {
  const request = fresh();
  vm.runInNewContext("Object.defineProperty(request, 'url', { value: 'from the other realm' })", { request });
  return urlOf(request);
});

say("the body after a clone", () => {
  const request = fresh();
  const before = request.body;
  const copy = request.clone();
  const after = request.body;
  return [before === after, before === copy.body, after === request.body, Object.prototype.toString.call(after)].join();
});
say("the body of a GET", () => new Request(address).body);
say("the body twice", () => {
  const request = fresh();
  return request.body === request.body;
});
say("bodyUsed before and after", () => {
  const request = fresh();
  const before = request.bodyUsed;
  void request.text();
  return [before, request.bodyUsed].join();
});
say("the signal twice", () => {
  const request = fresh();
  return request.signal === request.signal;
});
say("the signal that was handed in", () => {
  const controller = new AbortController();
  const request = new Request(address, { signal: controller.signal });
  const before = request.signal.aborted;
  controller.abort();
  return [before, request.signal.aborted].join();
});

say("headers written through the cached object", () => {
  const request = fresh();
  (headersOf(request) as Headers).set("x-one", "changed");
  return (headersOf(request) as Headers).get("x-one");
});

say("what an old instance caches lives on", () => {
  const kept: Request[] = [];
  for (let i = 0; i < 200; i++) kept.push(new Request(address + i, { headers: { n: String(i) } }));
  Bun.gc(true);
  Bun.gc(true);
  for (const request of kept) {
    urlOf(request);
    headersOf(request);
  }
  const litter: unknown[] = [];
  for (let i = 0; i < 50000; i++) litter.push({ i, text: "t" + i });
  Bun.gc(false);
  Bun.gc(true);
  let sum = 0;
  for (let i = 0; i < kept.length; i++) if (urlOf(kept[i]) === address + i && (headersOf(kept[i]) as Headers).get("n") === String(i)) sum++;
  return sum + " " + (litter.length === 50000);
});

const made = () => new Response("body", { status: 201, statusText: "Made" });
say("a response's status", () => statusOf(made()));
say("a response's status text", () => statusTextOf(made()));
say("a response's status text twice", () => {
  const response = made();
  return statusTextOf(response) === statusTextOf(response);
});
say("a response with an own status", () => statusOf(Object.defineProperty(made(), "status", { value: "own" })));
say("a plain object for a response", () => statusOf({ status: "plain" } as unknown as Response));
say("a request for a response", () => statusOf(fresh() as unknown as Response));
say("a blob's size", () => sizeOf(new Blob(["abcd"])));
say("a file's size", () => sizeOf(new File(["abcde"], "name.txt")));
say("a plain object for a blob", () => sizeOf({ size: "plain" } as unknown as Blob));
say("a file's name, set", () => {
  const file = new File(["a"], "before.txt");
  const before = file.name;
  (file as any).name = "after.txt";
  return before + " " + file.name;
});

console.log(lines.join("\n"));
//// native-getters-undeclared-results.ts
// What is read through a declared getter of a native class need not be of the declared type: an own property or a plain object may hold anything, and nothing tests it, because a declaration file declares the member. The receiver is tested: any object, undefined and null pass for `Request`, and a primitive throws a TypeError at the cast.
const lines: string[] = [];
////= say-2

function urlOf(request: Request) {
  return request.url;
}
function methodOf(request: Request) {
  return request.method;
}
function headersOf(request: Request) {
  return request.headers;
}
function lengthOfUrl(request: Request) {
  return request.url.length;
}

const address = "http://example.com/a/b?c=d";
const plain = () => ({ url: 5, method: null, headers: "text" }) as unknown as Request;
const shadowed = () => Object.defineProperties(new Request(address), { url: { value: 5 }, method: { value: 7 }, headers: { value: "text" } });
for (const [label, make] of [["a plain object", plain], ["an instance with own values", shadowed]] as const) {
  say(label + " url", () => urlOf(make()));
  say(label + " method", () => methodOf(make()));
  say(label + " headers", () => headersOf(make()));
  say(label + " url.length", () => lengthOfUrl(make()));
}
for (const [label, receiver] of [["undefined", undefined], ["null", null], ["a number", 5], ["a string", "text"], ["a symbol", Symbol.iterator]] as const) {
  say(label + " url", () => urlOf(receiver as unknown as Request));
  say(label + " method", () => methodOf(receiver as unknown as Request));
  say(label + " headers", () => headersOf(receiver as unknown as Request));
}
say("an empty object url.length", () => lengthOfUrl({} as Request));
say("a number url.length", () => lengthOfUrl(5 as unknown as Request));
console.log(lines.join("\n"));
//// native-setters-of-many-subclasses-stored-in-turn-untyped.js
// Two native setters of Event, stored to in turn at one place on instances of hundreds of subclasses.
function write(event, value) {
  event.cancelBubble = value;
  event.returnValue = value;
}
for (const shapes of [1, 40, 100, 300, 1200]) {
  const made = [];
  for (let i = 0; i < shapes; i++) made.push(new (class extends Event {})("e", { cancelable: true }));
  for (let round = 0; round < 4; round++) for (let i = 0; i < made.length; i++) write(made[i], (round + i) % 3 === 0);
  let stopped = 0;
  let prevented = 0;
  for (const event of made) {
    stopped += event.cancelBubble ? 1 : 0;
    prevented += event.defaultPrevented ? 1 : 0;
  }
  console.log(shapes, "subclasses:", stopped, prevented);
}
//// new-instances-of-built-in-classes-changed-at-once.js
// A new instance of a built-in class with locked prototypes gets another prototype or an own property under the name of a member, and the next read answers as in plain Bun. Each row is a function of its own, so the compiler sees the allocation, the change and the read together.
function headersLink() { const o = new Headers({ a: "1" }); Object.setPrototypeOf(o, null); return typeof o.get; }
function headersOwn() { const o = new Headers({ a: "1" }); Object.defineProperty(o, "get", { value: 1 }); return typeof o.get; }
function headersStore() { const o = new Headers({ a: "1" }); o.get = 1; return typeof o.get; }
function headersProto() { const o = new Headers({ a: "1" }); o.__proto__ = { get: 2 }; return typeof o.get; }
function headersReflect() { const o = new Headers({ a: "1" }); Reflect.setPrototypeOf(o, { get: "x" }); return typeof o.get; }
function urlLink() { const o = new URL("http://a/b"); Object.setPrototypeOf(o, null); return typeof o.pathname + " " + typeof o.toString; }
function urlOwn() { const o = new URL("http://a/b"); Object.defineProperty(o, "pathname", { value: 1 }); return typeof o.pathname; }
function paramsLink() { const o = new URLSearchParams("a=1"); Object.setPrototypeOf(o, null); return typeof o.get; }
function paramsOwn() { const o = new URLSearchParams("a=1"); o.get = 1; return typeof o.get; }
function requestLink() { const o = new Request("http://a/b"); Object.setPrototypeOf(o, null); return typeof o.method + " " + typeof o.json; }
function requestOwn() { const o = new Request("http://a/b"); Object.defineProperty(o, "method", { value: 1 }); return typeof o.method; }
function responseLink() { const o = new Response("a"); Object.setPrototypeOf(o, null); return typeof o.status + " " + typeof o.text; }
function responseOwn() { const o = new Response("a"); Object.defineProperty(o, "status", { value: "s" }); return typeof o.status; }
function blobLink() { const o = new Blob(["a"]); Object.setPrototypeOf(o, null); return typeof o.size + " " + typeof o.text; }
function blobOwn() { const o = new Blob(["a"]); Object.defineProperty(o, "size", { value: "s" }); return typeof o.size; }
function headersIteratorLink() { const o = new Headers({ a: "1" }).entries(); Object.setPrototypeOf(o, null); return typeof o.next; }
function headersIteratorOwn() { const o = new Headers({ a: "1" }).keys(); o.next = 1; return typeof o.next; }
function paramsIteratorLink() { const o = new URLSearchParams("a=1").entries(); Object.setPrototypeOf(o, null); return typeof o.next; }
function paramsIteratorOwn() { const o = new URLSearchParams("a=1").values(); o.next = 1; return typeof o.next; }
function arrayLink() { const o = [1]; Object.setPrototypeOf(o, null); return typeof o.push; }
function arrayOwn() { const o = [1]; o.push = 1; return typeof o.push; }
function arrayIteratorLink() { const o = [1].values(); Object.setPrototypeOf(o, null); return typeof o.next; }
function arrayIteratorOwn() { const o = [1][Symbol.iterator](); o.next = 1; return typeof o.next; }
function mapLink() { const o = new Map(); Object.setPrototypeOf(o, null); return typeof o.get + " " + typeof o.size; }
function mapOwn() { const o = new Map(); o.get = 1; return typeof o.get; }
function mapIteratorLink() { const o = new Map().entries(); Object.setPrototypeOf(o, null); return typeof o.next; }
function mapIteratorOwn() { const o = new Map().keys(); o.next = 1; return typeof o.next; }
function setLink() { const o = new Set(); Object.setPrototypeOf(o, null); return typeof o.has; }
function setIteratorLink() { const o = new Set().values(); Object.setPrototypeOf(o, null); return typeof o.next; }
function setIteratorOwn() { const o = new Set().values(); o.next = 1; return typeof o.next; }
function stringIteratorLink() { const o = "ab"[Symbol.iterator](); Object.setPrototypeOf(o, null); return typeof o.next; }
function stringIteratorOwn() { const o = "ab"[Symbol.iterator](); o.next = 1; return typeof o.next; }
function regExpStringIteratorLink() { const o = "ab".matchAll(/a/g); Object.setPrototypeOf(o, null); return typeof o.next; }
function regExpStringIteratorOwn() { const o = "ab".matchAll(/a/g); o.next = 1; return typeof o.next; }
function iteratorHelperLink() { const o = [1].values().map(x => x); Object.setPrototypeOf(o, null); return typeof o.next; }
