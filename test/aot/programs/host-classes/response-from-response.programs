//// response-from-response-untyped.js
// Untyped code, as a framework writes it: the construction stands in a helper, the Response in a private field that is read twice.
const createResponse = (body, init) => new Response(body, init);
const log = [];
class Context {
  #res;
  finalized = false;
  header(name, value) {
    if (this.finalized) this.#res = createResponse(this.#res.body, this.#res);
    this.#res.headers.set(name, value);
  }
  replace(next) {
    if (this.#res && next) {
      next = createResponse(next.body, next);
      for (const [name, value] of this.#res.headers.entries()) {
        if (name !== "content-type") next.headers.set(name, value);
      }
    }
    this.#res = next;
    this.finalized = true;
  }
  get res() {
    return this.#res;
  }
}
class Watched {
  #held;
  #reads = 0;
  meddle = () => {};
  constructor(held) {
    this.#held = held;
  }
  get #res() {
    log.push("read " + ++this.#reads);
    if (this.#reads === 2) this.meddle(this.#held);
    return this.#held;
  }
  throughAccessor() {
    return createResponse(this.#res.body, this.#res);
  }
}
const usedAsValues = [Context.prototype.header, Context.prototype.replace, Watched.prototype.throughAccessor];
const outcome = async work => {
  try {
    return await work();
  } catch (error) {
    return "throws " + error.constructor.name + ": " + error.message;
  }
};
const shown = response => [response.status, response.statusText, [...response.headers]];
const made = () => new Response('{"id":1}', { status: 201, statusText: "Made", headers: { "Content-Type": "application/json" } });
const lines = [usedAsValues.map(each => each.name).join()];
{
  const first = made();
  const context = new Context();
  context.replace(first);
  for (const name of ["x-request-id", "x-content-type-options", "cache-control"]) context.header(name, name.length + "");
  lines.push(JSON.stringify([shown(context.res), context.res === first, first.body === context.res.body, await context.res.text(), first.bodyUsed, [...first.headers]]));
}
{
  const context = new Context();
  context.replace(new Response("first", { headers: { a: "1", "Content-Type": "text/x-first" } }));
  context.replace(new Response("second", { status: 202, headers: { b: "2", "Content-Type": "text/x-second" } }));
  lines.push(JSON.stringify([shown(context.res), await context.res.text()]));
}
for (const [what, meddle] of Object.entries({
  nothing: () => {},
  "a clone": held => void held.clone(),
  "a read": held => void held.text(),
  "a reader": held => void held.body.getReader(),
})) {
  const watched = new Watched(made());
  watched.meddle = meddle;
  log.length = 0;
  const second = await outcome(() => watched.throughAccessor());
  lines.push(JSON.stringify([what, log, second instanceof Response ? [shown(second), await outcome(() => second.text())] : second]));
}
{
  const context = new Context();
  const kind = async work => (await outcome(work)).split(":")[0];
  lines.push(JSON.stringify(await kind(() => Context.prototype.header.call({ finalized: true }, "a", "b"))));
  lines.push(JSON.stringify(await kind(() => context.header("a", "b"))));
}
{
  using server = Bun.serve({
    port: 0,
    async fetch() {
      const context = new Context();
      context.replace(made());
      await Promise.resolve();
      for (const name of ["x-one", "x-two", "x-three"]) context.header(name, "set");
      return context.res;
    },
  });
  const answer = await fetch(server.url);
  lines.push(JSON.stringify([answer.status, ["content-type", "content-length", "transfer-encoding", "x-one", "x-two", "x-three"].map(name => answer.headers.get(name)), await answer.text()]));
}
console.log(lines.join("\n"));
//// response-from-response-with-code-between.js
// Between the read of `body` and the construction stands code that the compiler cannot look through: a call of a function that is not inlined, an await, a yield.
const log = [];
function initFor(response, depth) {
  if (depth > 0) return initFor(response, depth - 1);
  log.push("initFor");
  return { status: response.status + 1, headers: { "x-made": "by a call" } };
}
function same(response, depth) {
  if (depth > 0) return same(response, depth - 1);
  log.push("same");
  return response;
}
export function withCall(first) {
  return new Response(first.body, initFor(first, 3));
}
export function withCallOfTheSame(first) {
  return new Response(first.body, same(first, 3));
}
export async function withAwait(first) {
  return new Response(first.body, await Promise.resolve(first));
}
export function* withYield(first) {
  return new Response(first.body, yield first.status);
}
export function withNothing(first) {
  return new Response(first.body, first);
}
const make = () => new Response("text", { status: 201, headers: { "x-first": "1" } });
async function show(label, response) {
  console.log(label, response.status, response.headers.get("x-first"), response.headers.get("x-made"), JSON.stringify(await response.text()));
}
await show("a call", withCall(make()));
await show("a call that gives the same Response", withCallOfTheSame(make()));
await show("an await", await withAwait(make()));
const first = make();
const generator = withYield(first);
console.log("yielded", generator.next().value);
await show("a yield", generator.next(first).value);
await show("nothing", withNothing(make()));
console.log(log.join());
//// response-init-header-names.ts
// The names of a headers literal in an init literal are looked up when the program is built: a common name is passed as its number, any other token as a string; a literal with a name that is no token stays an object.
export function commonNames(type: string, cache: string): Response {
  return new Response("x", { headers: { "content-type": type, "cache-control": cache } });
}
export function commonNamesInCapitals(type: string): Response {
  return new Response("x", { headers: { "CONTENT-Type": type } });
}
export function uncommonNames(first: string, second: string): Response {
  return new Response("x", { status: 201, headers: { "x-request-id": first, "X-Content-Type-Options": second } });
}
export function jsonWithBoth(id: string, cache: string): Response {
  return Response.json({ id }, { headers: { "X-Request-Id": id, "Cache-Control": cache } });
}
export function nameWithSpace(value: string): Response {
  return new Response("x", { status: 202, headers: { accept: "*/*", "bad name": value } });
}
export function nameThatIsNotASCII(value: string): Response {
  return new Response("x", { headers: { café: value } });
}
export function sameNameInTwoCases(first: string, second: string): Response {
  return new Response("x", { headers: { Accept: first, accept: second, "X-Mine": first, "x-mine": second, Cookie: first, cookie: second, "Set-Cookie": first, "set-cookie": second } });
}
export function anyValues(first: unknown, second: unknown, third: unknown): Response {
  return new Response("x", { headers: { "content-language": first, "x-second": second, etag: third } as Record<string, string> });
}
export function jsonWithContentType(type: string): Response {
  return Response.json([1], { headers: { "Content-Type": type } });
}
export function blobWithContentType(type: string): Response {
  return new Response(new Blob(["x"], { type: "from/blob" }), { headers: { "content-TYPE": type } });
}
export function blobWithoutContentType(mine: string): Response {
  return new Response(new Blob(["x"], { type: "from/blob" }), { headers: { "x-mine": mine } });
}
export function twelveHeaders(value: string): Response {
  return new Response("x", {
    headers: { accept: value, "x-1": value, age: value, "x-2": value, date: value, "x-3": value, etag: value, "x-4": value, host: value, "x-5": value, via: value, "x-6": value },
  });
}

function show(make: () => Response): string {
  try {
    const response = make();
    return JSON.stringify([response.status, [...response.headers], response.headers.getSetCookie()]);
  } catch (error) {
    return `${(error as Error).name}: ${(error as Error).message}`;
  }
}

console.log(show(() => commonNames("a/b", "no-store")));
console.log(show(() => commonNamesInCapitals("a/b")));
console.log(show(() => uncommonNames("one", "nosniff")));
console.log(show(() => jsonWithBoth("seven", "no-store")));
console.log(show(() => nameWithSpace("v")));
console.log(show(() => nameThatIsNotASCII("v")));
console.log(show(() => sameNameInTwoCases("a=1", "b=2")));
console.log(show(() => jsonWithContentType("mine/json")));
console.log(show(() => blobWithContentType("mine/blob")));
console.log(show(() => blobWithoutContentType("mine")));
console.log(show(() => twelveHeaders("v")));

for (const value of ["", " ", "  padded\t", "\tx y ", "two\nlines", "a\0b", "carriage\rreturn", "café", "€", "x".repeat(300)]) {
  console.log(JSON.stringify(value.slice(0, 20)), show(() => commonNames(value, "ok")), show(() => commonNames("ok", value)), show(() => uncommonNames(value, "ok")), show(() => uncommonNames("ok", value)), show(() => jsonWithBoth(value, "ok")));
}

const log: string[] = [];
const says = (name: string, text: string) => ({
  toString() {
    log.push(name);
    return text;
  },
});
const throws = (name: string) => ({
  toString() {
    log.push(name);
    throw new RangeError(`from ${name}`);
  },
});
const rows: [unknown, unknown, unknown][] = [
