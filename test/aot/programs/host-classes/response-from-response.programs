  say("address, nothing set", () => address("open", null, 1));
  say("names", () => appended([text, "b", text, text], ["1", text, "3", "4"]));
  say("asked", () => asked(text));
  say("handed on", () => handedOn(text));
  say("interpolated", () => interpolated(text));
  say("captured", () => captured(text));
}
