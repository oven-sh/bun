//// response-literal-init-through-typed-helper.ts
// The init literal is handed to a parameter typed ResponseInit, as a framework written in TypeScript does: it is taken apart all the same.
const create = (body?: BodyInit | null, init?: ResponseInit): Response => new Response(body, init);
function statusAndHeaders(body: string | null, status: number | undefined, headers: Headers) {
  return create(body, { status, headers });
}
function statusOnly(body: string, status: number) {
  return create(body, { status });
}
function literalHeaders(body: string, kind: string) {
  return create(body, { status: 202, statusText: "Taken", headers: { "Content-Type": kind, "X-One": "1" } });
}
const seen: ResponseInit[] = [];
function kept(body: string, status: number) {
  const init: ResponseInit = { status };
  seen.push(init);
  return create(body, init);
}
const usedAsValues = [statusAndHeaders, statusOnly, literalHeaders, kept];
const shown = (response: Response) => [response.status, response.statusText, response.ok, [...response.headers]];
const outcome = <T>(work: () => T): T | string => {
  try {
    return work();
  } catch (error) {
    return "throws " + (error as Error).constructor.name + ": " + (error as Error).message;
  }
};
const lines: string[] = [usedAsValues.map(each => each.name).join()];
const say = (label: string, value: unknown) => lines.push(label + ": " + JSON.stringify(value));
const given = new Headers({ a: "1", "Content-Type": "text/x-given" });
const first = statusAndHeaders("body", 201, given);
say("a status and a Headers object", [shown(first), await first.text(), first.headers === given]);
first.headers.set("b", "2");
say("the headers are a copy", [[...given], [...first.headers]]);
say("the status is undefined", shown(statusAndHeaders("body", undefined, new Headers())));
say("no body", shown(statusAndHeaders(null, 204, new Headers({ c: "3" }))));
say("only a status", [shown(statusOnly("text", 203)), await statusOnly("text", 203).text()]);
for (const status of [199, 200, 599, 600, 1000, -1, 200.5, NaN]) say("status " + status, outcome(() => shown(statusOnly("text", status))));
say("a null-body status with a body", outcome(() => shown(statusOnly("text", 204))));
say("headers written out", shown(literalHeaders("text", "text/x-kind")));
say("a header value that is not allowed", outcome(() => shown(literalHeaders("text", "bad\nvalue"))));
say("the literal is kept", [shown(kept("text", 205 + 1)), seen]);
{
  const original = globalThis.Response;
  const calls: unknown[] = [];
  try {
    globalThis.Response = class extends original {
      constructor(body?: BodyInit | null, init?: ResponseInit) {
        calls.push([body, init && Object.keys(init), init?.status]);
        super(body, init);
      }
    };
    const replaced = statusAndHeaders("kept", 207, new Headers({ d: "4" }));
    say("the global is replaced", [calls, shown(replaced), replaced instanceof original, Object.getPrototypeOf(replaced) === original.prototype]);
  } finally {
    globalThis.Response = original;
  }
}
say("the global is restored", shown(statusOnly("text", 208)));
let sum = 0;
for (let i = 0; i < 2000; i++) {
  sum += statusAndHeaders("body " + i, 200 + (i % 100), given).status + statusOnly("x", 200 + (i % 50)).status;
  if (i % 500 === 0) Bun.gc(true);
}
say("many", sum);
console.log(lines.join("\n"));
//// routed-request-as-response-init.ts
// A server whose static route makes a Response before the first routed request: the request of a route is not a Response, though both are handed to `new Response(x.body, x)`.
const echo = (request: Request) => new Response(request.body, request);
const copy = () => {
  const first = new Response("copied", { status: 201, headers: { "x-a": "1" } });
  return new Response(first.body, first);
};
const server = Bun.serve({
  port: 0,
  routes: {
    "/health": new Response("ok"),
    "/echo": { POST: echo },
    "/copy": copy,
  },
  fetch: (request) => (new URL(request.url).pathname === "/plain" ? echo(request) : new Response("no route", { status: 404 })),
});

async function show(label: string, response: Response) {
  console.log(label, response.status, response.headers.get("x-a"), response.headers.get("x-b"), JSON.stringify(await response.text()));
}
const send = (path: string, body: string) => fetch(new URL(path, server.url), { method: "POST", body, headers: { "x-b": "2" } });

await show("static", await fetch(new URL("/health", server.url)));
await show("copy before a routed request is echoed", await fetch(new URL("/copy", server.url)));
await show("a routed request", await send("/echo", "sent"));
await show("a request without a route", await send("/plain", "sent plainly"));
await show("copy after", await fetch(new URL("/copy", server.url)));
for (let i = 0; i < 50; i++) {
  const [routed, plain, copied] = await Promise.all([send("/echo", "a" + i), send("/plain", "b" + i), fetch(new URL("/copy", server.url))]);
  const texts = [await routed.text(), await plain.text(), await copied.text()].join();
  if (texts !== `a${i},b${i},copied` || routed.headers.get("x-b") !== "2" || copied.status !== 201) console.log("differs at", i, texts);
}
await show("no route", await fetch(new URL("/none", server.url)));
await server.stop(true);
console.log("done");
//// routed-requests-have-a-locked-prototype.ts
// Bun.serve hands a `routes` handler a BunRequest, the host's own class below Request. --aot locks its prototype with Request.prototype: every way to change it is refused. An instance, a class of the program that extends Request and a plain Request behave as in plain Bun.
const lines: string[] = [];
////= say-2

const describe = (request: Request) => [request.method, new URL(request.url).pathname, request.headers.get("x-a"), typeof request.clone, "params" in request, typeof (request as any).params].join(" ");
const cloneOf = (request: Request) => request.clone();

class Own extends Request {
  get method() {
    return "OWN";
  }
  clone() {
    return new Own(this.url + "cloned");
  }
  get params() {
    return "mine";
  }
}

let routed: Request | undefined;
const server = Bun.serve({
  hostname: "127.0.0.1",
  port: 0,
  routes: {
    "/users/:id": request => {
      routed = request;
      const prototype = Object.getPrototypeOf(request);
      const paramsBefore = Object.getOwnPropertyDescriptor(prototype, "params")!;
      const cloneBefore = prototype.clone;
      say("the prototype of a routed request is Request.prototype", () => prototype === Request.prototype);
      say("the prototype above it is Request.prototype", () => Object.getPrototypeOf(prototype) === Request.prototype);
      say("own keys", () => Reflect.ownKeys(prototype).map(String).sort().join());
      say("prototype.clone = f", () => ((prototype.clone = function replaced() {}), prototype.clone === cloneBefore ? "unchanged" : "replaced"));
      try {
        prototype.clone = cloneBefore;
      } catch {}
      say("prototype.clone = the same function", () => ((prototype.clone = cloneBefore), "allowed"));
      say('Object.defineProperty(prototype, "params", getter)', () => {
        Object.defineProperty(prototype, "params", { get: () => "replaced", configurable: true });
        Object.defineProperty(prototype, "params", paramsBefore);
        return "replaced and restored";
      });
      say("prototype.params = 1", () => ((prototype.params = 1), "stored"));
      say("prototype.added = 1", () => ((prototype.added = 1), delete prototype.added, "added and deleted"));
      say("prototype.method = 1", () => ((prototype.method = 1), delete prototype.method, "added and deleted"));
      say("delete prototype.cookies", () => delete prototype.cookies);
      say("Object.setPrototypeOf(prototype, another object)", () => (Object.setPrototypeOf(prototype, {}), Object.setPrototypeOf(prototype, Request.prototype), "changed and restored"));
      say("Object.isExtensible(prototype)", () => Object.isExtensible(prototype));
      say("routed", () => describe(request));
      say("routed params", () => request.params.id);
      say("clone of routed", () => describe(cloneOf(request)) + " " + (cloneOf(request) as any).params.id);
      return new Response(request.method + " " + request.params.id + " " + request.headers.get("x-a"));
    },
  },
  fetch(request) {
    say("plain", () => describe(request));
    say("clone of plain", () => describe(cloneOf(request)));
    return new Response(request.method);
  },
});
const headers = { "x-a": "b" };
lines.push("answer: " + (await (await fetch(`http://127.0.0.1:${server.port}/users/7`, { headers })).text()));
lines.push("answer: " + (await (await fetch(`http://127.0.0.1:${server.port}/other`, { headers })).text()));
say("own", () => describe(new Own("http://a/b", { headers })));
say("clone of own", () => describe(cloneOf(new Own("http://a/b", { headers }))));
say("Own.prototype.clone = f", () => ((Own.prototype.clone = function replaced() { return new Own("http://a/replaced"); }), new URL(cloneOf(new Own("http://a/b")).url).pathname));
say("an own property on a routed request", () => (Object.defineProperty(routed!, "method", { value: "CHANGED" }), describe(routed!)));
say("another prototype for a routed request", () => (Object.setPrototypeOf(routed!, null), typeof (routed as any).url + " " + typeof (routed as any).params));
await server.stop(true);
console.log(lines.join("\n"));
//// search-params-asked-for-their-size-by-a-closure-that-is-called-twice.ts
// `new URLSearchParams(text)` is only asked for its size and its text, by a closure that is called twice.
// STATISTIC: URLsLeftUnbuilt >= 1
////= readInClosure
for (const text of ["", "a=1", "a=1&b=2", "?a=1&a=2&a=3", "a=%20&b", undefined]) console.log(readInClosure(text));
//// search-params-only-filled-and-turned-to-text.ts
// `const params = new URLSearchParams()` that is only filled by set | append and turned to text by toString() is compiled without the object. For every name and value that is a string the text is plain Bun's; so it is where the object is used in another way, and where `URLSearchParams` is another class. A primitive of another kind does not get past `as string`: the cast throws a TypeError before the host converts anything. An object passes the cast, and the host converts it as in plain Bun.
function address(state: string, label: string | null, page: number): string {
  const params = new URLSearchParams();
  if (state !== "open") params.set("state", state);
  if (label !== null) params.set("label", label);
  if (page !== 1) params.set("page", String(page));
  const query = params.toString();
  return `/issues${query && `?${query}`}`;
}
function appended(names: unknown[], values: unknown[]): string {
  const params = new URLSearchParams();
  params.append(names[0] as string, values[0] as string);
  params.append(names[1] as string, values[1] as string);
  params.set(names[2] as string, values[2] as string);
  params.append(names[3] as string, values[3] as string);
  return params.toString() + "|" + params.toString();
}
function inALoop(pairs: [string, string][], replaces: boolean): string {
  const params = new URLSearchParams();
  for (const [name, value] of pairs) {
    if (replaces) params.set(name, value);
    else params.append(name, value);
  }
  return params.toString();
}
function asked(name: string): string {
  const params = new URLSearchParams();
  params.set(name, "1");
  return params.toString() + params.size + params.has(name);
}
function handedOn(name: string): string {
  const params = new URLSearchParams();
  params.set(name, "1");
  return String(new URLSearchParams(params));
}
function interpolated(name: string): string {
  const params = new URLSearchParams();
  params.set(name, "1");
  return `?${params}`;
}
function captured(name: string): string {
  const params = new URLSearchParams();
  const fill = () => params.set(name, "1");
  fill();
  return params.toString();
}
function say(label: string, work: () => unknown) {
  try {
    console.log(label, JSON.stringify(work()));
  } catch (error) {
    console.log(label, "throws", (error as Error).constructor.name);
  }
}
const texts = ["", "a", "closed", "two words", "a&b=c", "100%", "café", "東京", "😀", "lone \ud83d", "\ude00 lone", "*-._~", "+", "\u0000\n\r\t", "A-Z_0.9*", "'()!", " "];
for (const text of texts) {
