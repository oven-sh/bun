////: inAnAsyncFunction
async function inAnAsyncFunction(text: string) {
  const url = new URL(text, "http://localhost:3000");
  const before = url.pathname;
  await null;
  return [before, url.pathname, url.search, url.searchParams.get("a")];
}
////: insideTry
function insideTry(value: number, id: string) {
  try {
    return Response.json(positive(value), { status: 200 + positive(value).value, headers: headersFor(id) });
  } catch (error) {
    try {
      return new Response((error as Error).message, { status: positive(value + 500).value, statusText: "Failed", headers: headersFor(id) });
    } catch {
      return null;
    }
  }
}
////: isChangedWhileWalked
function isChangedWhileWalked(text: string) {
  const query = new URLSearchParams(text);
  const found: string[] = [];
  for (const [key] of query) {
    found.push(key);
    if (found.length < 5) query.append(key + "x", "1");
  }
  return found;
}
////: keysAndValues
function keysAndValues(text: any) {
  const query = new URLSearchParams(text);
  const found: string[] = [];
  for (const key of query.keys()) found.push(key);
  for (const value of query.values()) found.push(value);
  return found;
}
