say("a loop that appends", () => inALoop([["a", "1"], ["b", "2"], ["a", "3"], ["c d", "4 5"]], false));
say("a loop that sets", () => inALoop([["a", "1"], ["b", "2"], ["a", "3"], ["a", "4"], ["b", "é"]], true));
