const pairs: [string, string][] = [
  ["/users/42/posts/hello-world?page=2&limit=10&sort=top", "http://127.0.0.1"],
  ["/text", "http://127.0.0.1"],
  ["/", "http://127.0.0.1"],
  ["/?", "http://a"],
  ["/#", "http://a"],
  ["/?#", "http://a"],
  ["/a?b#c?d", "http://a"],
  ["/a#b?c=d", "http://a"],
];
////: pairsAreFresh
function pairsAreFresh(text: any) {
  const query = new URLSearchParams(text);
  const kept: string[][] = [];
  for (const pair of query.entries()) {
    pair.push("more");
    kept.push(pair);
  }
  for (const pair of query.entries()) kept.push(pair);
  return kept;
}
////: readInClosure
function readInClosure(text: any) {
  const query = new URLSearchParams(text);
  const ask = () => query.size + query.toString();
  return ask() + ask();
}
