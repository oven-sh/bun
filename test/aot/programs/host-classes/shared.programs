////: say
function say(label: string, work: () => unknown) {
  let text: string;
  try {
    text = JSON.stringify(work()) ?? "undefined";
  } catch (error) {
    text = "throws " + (error as Error).constructor.name + ": " + (error as Error).message;
  }
  lines.push(label + ": " + text);
}
////: say-2
function say(label: string, work: () => unknown) {
  let text: string;
  try {
    text = String(work());
  } catch (error) {
    text = "throws " + (error as Error).constructor.name;
  }
  lines.push(label + ": " + text);
}
////: say-3
async function say(label: string, work: () => unknown) {
  let text: string;
  try {
    const value = await work();
    text = value instanceof Response ? await describe(value) : JSON.stringify(value) ?? "undefined";
  } catch (error) {
    text = "throws " + (error as Error).constructor.name + ": " + (error as Error).message;
  }
  lines.push(label + ": " + text);
}
