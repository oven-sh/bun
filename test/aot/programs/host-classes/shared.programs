////: framesOf
function framesOf(stack: string | undefined): string {
  return (stack ?? "")
    .split("\n")
    .slice(1, «1»)
    .map(line => /^\s*at (\S+) \(/.exec(line)?.[1] ?? "-")
    .join(" < ");
}
