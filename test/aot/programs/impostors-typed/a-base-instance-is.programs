  attempt("areaPlusOne " + text, () => areaPlusOne(hidden(text)));
  attempt("totalArea " + text, () => totalArea([new Circle(1), hidden(text), new Square(1)]));
  attempt("label " + text, () => label(hidden(text)));
}

