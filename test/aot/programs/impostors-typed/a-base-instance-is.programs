//// a-subclass-made-by-eval-and-patched-prototypes-change-a-typed-class.ts
////= show

const log: string[] = [];

////= attempt

(globalThis as any).note = (text: string) => log.push(text);
const hidden = (text: string): any => (0, eval)("(" + text + ")");

class Circle {
  radius: number;
  constructor(radius: number) {
    this.radius = radius;
  }
  area(): number {
    return this.radius * this.radius * 3;
  }
  describe(): string {
    return "circle of " + this.area();
  }
  get diameter(): number {
    return this.radius * 2;
  }
  static unit(): Circle {
    return new this(1);
  }
  static count = 0;
}

class Ring extends Circle {
  hole: number;
  constructor(radius: number, hole: number) {
    super(radius);
    this.hole = hole;
  }
  area(): number {
    return super.area() - this.hole * this.hole * 3;
  }
}

