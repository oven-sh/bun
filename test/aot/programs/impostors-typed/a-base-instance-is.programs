//// a-typed-function-is-called-only-for-what-a-getter-does.ts
interface Parcel {
  weight: number;
}

const log: string[] = [];

////= lines-30	touch	parcel	Parcel	number	parcel.weight

function touchTwice(parcel: Parcel): void {
  parcel.weight;
  parcel.weight;
}

class Scale {
  read(parcel: Parcel): number {
    return parcel.weight;
  }
}

function attempt(label: string, run: () => void) {
  try {
    run();
    console.log(label, "returned", log.join());
  } catch (error) {
    console.log(label, "threw", (error as Error).constructor.name, log.join());
  }
  log.length = 0;
}

const honest: Parcel = { weight: 1 };
for (let i = 0; i < 2000; i++) touch(honest);

const counting: any = {
  get weight() {
    log.push("getter");
    return 2;
  },
};
const throwing: any = {
  get weight() {
    log.push("getter");
    throw new RangeError("no weight");
  },
};
const trapped: any = new Proxy({}, {
  get(target, key) {
    log.push("get " + String(key));
    return 3;
  },
});
const inherited: any = Object.create(counting);
const nothing: any = undefined;
const empty: any = null;
const text: any = "text";

const scale = new Scale();
for (const [name, value] of [["counting", counting], ["throwing", throwing], ["trapped", trapped], ["inherited", inherited], ["undefined", nothing], ["null", empty], ["text", text], ["honest", honest]] as [string, any][]) {
  attempt("touch " + name, () => {
    touch(value);
  });
  attempt("touch twice " + name, () => {
    touchTwice(value);
  });
  attempt("method " + name, () => {
    scale.read(value);
  });
  attempt("through call " + name, () => {
    touch.call(undefined, value);
  });
}
//// a-typed-listener-gets-whatever-is-emitted.ts
import { EventEmitter } from "node:events";

////= show

const log: string[] = [];

////= attempt

(globalThis as any).note = (text: string) => log.push(text);
const hidden = (text: string): any => (0, eval)("(" + text + ")");

const seen: string[] = [];

function onNumber(n: number): void {
  seen.push("number " + show(n / 2) + " " + show(n + 1));
}

function onText(s: string): void {
  try {
    seen.push("text " + show(s.length) + " " + show(s.toUpperCase()));
  } catch (error) {
    seen.push("text threw " + (error instanceof Error ? error.constructor.name : typeof error));
  }
}

function onPoint(p: { x: number; y: number }): void {
  try {
    seen.push("point " + show(p.x + p.y));
  } catch (error) {
    seen.push("point threw " + (error instanceof Error ? error.constructor.name : typeof error));
  }
}

function onTwo(a: number, b: string): void {
  seen.push("two " + show(a + 1) + " " + show(b + "!"));
}

class Listener {
  total = 0;
  handle(n: number): void {
    this.total += n;
  }
  bound = (n: number): void => {
    this.total += n;
  };
}

function flush(label: string): void {
  console.log(label, seen.join(" | "));
  seen.length = 0;
}

const emitter = new EventEmitter();
emitter.on("number", onNumber);
emitter.on("text", onText);
emitter.on("point", onPoint);
emitter.on("two", onTwo);

onNumber(4);
onText("ab");
onPoint({ x: 1, y: 2 });
onTwo(1, "b");
flush("honest direct calls");
emitter.emit("number", 4);
emitter.emit("text", "ab");
emitter.emit("point", { x: 1, y: 2 });
emitter.emit("two", 1, "b");
flush("honest events");
for (let i = 0; i < 2000; i++) emitter.emit("number", i);
console.log("2000 honest events", seen.length, seen[1999]);
seen.length = 0;

for (const text of ["'8'", "null", "undefined", "-0", "[8]", "{ valueOf() { return 8; } }", "true"]) {
  emitter.emit("number", hidden(text));
  flush("number gets " + text);
}
attempt("number gets a bigint", () => emitter.emit("number", 8n));
seen.length = 0;
emitter.emit("number");
flush("number gets nothing");
for (const text of ["5", "null", "['a', 'b']", "new String('ab')", "{ length: 1, toUpperCase() { return 7; } }"]) {
  emitter.emit("text", hidden(text));
  flush("text gets " + text);
}
for (const text of ["{ x: '1', y: 2 }", "{ y: 2 }", "null", "5", "[1, 2]"]) {
  emitter.emit("point", hidden(text));
  flush("point gets " + text);
}
emitter.emit("two", "b", 1);
emitter.emit("two", 1);
emitter.emit("two", 1, "b", "c");
flush("two gets them crossed, short and long");

const listener = new Listener();
emitter.on("bound", listener.bound);
emitter.emit("bound", 1);
emitter.emit("bound", "2");
emitter.emit("bound", 3);
console.log("a bound listener", show(listener.total));
emitter.on("method", listener.handle);
attempt("a method as a listener gets the emitter as this", () => {
  emitter.emit("method", 1);
  return show((emitter as any).total);
});

const target = new EventTarget();
target.addEventListener("custom", event => {
  const detail: number = (event as CustomEvent).detail;
  seen.push("detail " + show(detail + 1));
});
target.dispatchEvent(new CustomEvent("custom", { detail: 1 }));
target.dispatchEvent(new CustomEvent("custom", { detail: "1" }));
target.dispatchEvent(new CustomEvent("custom"));
target.dispatchEvent(new Event("custom"));
flush("an event target");

await new Promise<void>(resolve => {
  process.nextTick(onNumber, hidden("'6'"));
  process.nextTick(onTwo, hidden("'x'"), hidden("7"));
  setTimeout(onNumber, 0, hidden("'10'"));
  setTimeout(resolve, 1);
});
flush("ticks and timers");
queueMicrotask(() => onNumber(hidden("'12'")));
await null;
flush("a microtask");
//// a-typed-recursion-without-an-end-throws-a-range-error.ts
interface Tree {
  value: number;
  children: Tree[];
}

function sumTree(t: Tree): number {
  let sum = t.value;
  for (let i = 0; i < t.children.length; i++) sum += sumTree(t.children[i]);
  return sum;
}

function countDown(n: number): number {
  return n === 0 ? 0 : 1 + countDown(n - 1);
}

function attempt(label: string, run: () => unknown): void {
  try {
    console.log(label, "->", String(run()));
  } catch (error) {
    console.log(label, "threw", error instanceof Error ? error.constructor.name : typeof error);
  }
}

attempt("honest tree", () => sumTree({ value: 1, children: [{ value: 2, children: [] }] }));
attempt("honest count", () => countDown(1000));
attempt("a tree that contains itself", () => {
  const t: Tree = { value: 1, children: [] };
  t.children.push(t);
  return sumTree(t);
});
attempt("a count that never reaches zero", () => countDown(0.5));
attempt("a count from a string", () => countDown(JSON.parse('"3"')));
attempt("honest tree again", () => sumTree({ value: 1, children: [{ value: 2, children: [] }] }));
attempt("honest count again", () => countDown(1000));
//// a-typed-value-changes-in-the-middle-of-a-loop.ts
////= show

const log: string[] = [];

////= attempt

(globalThis as any).note = (text: string) => log.push(text);
const hidden = (text: string): any => (0, eval)("(" + text + ")");

////= Point

function sumWhile(list: number[], at: number, change: (list: number[]) => void): number {
  let sum = 0;
  for (let i = 0; i < list.length; i++) {
    if (i === at) change(list);
    sum += list[i];
  }
  return sum;
}

function iterateWhile(list: number[], at: number, change: (list: number[]) => void): number {
  let sum = 0;
  let i = 0;
  for (const value of list) {
    if (i++ === at) change(list);
    sum += value;
    if (i > 20) break;
  }
  return sum;
}

function pushWhile(list: number[], at: number, change: (list: number[]) => void): unknown[] {
  const results: unknown[] = [];
  for (let i = 0; i < 4; i++) {
    if (i === at) change(list);
    results.push(list.push(i));
  }
  return results;
}

function readWhile(p: Point, at: number, change: (p: Point) => void): number {
  let sum = 0;
  for (let i = 0; i < 4; i++) {
    if (i === at) change(p);
    sum += p.x + p.y;
  }
  return sum;
}

function storeWhile(p: Point, at: number, change: (p: Point) => void): string {
  for (let i = 0; i < 4; i++) {
    if (i === at) change(p);
    p.x = i;
    p.y += 1;
  }
  return JSON.stringify(p) + Object.keys(p).join();
}

const nothing = () => {};

function honest(label: string): void {
  console.log(label, sumWhile([1, 2, 3, 4], 2, nothing), iterateWhile([1, 2, 3, 4], 2, nothing), show(pushWhile([], 2, nothing)), readWhile({ x: 1, y: 2 }, 2, nothing), storeWhile({ x: 1, y: 2 }, 2, nothing));
}

honest("honest before");
let warm = 0;
for (let i = 0; i < 2000; i++) warm += sumWhile([i, 1, 2], 1, nothing) + iterateWhile([i, 1], 1, nothing) + pushWhile([], 1, nothing).length + readWhile({ x: i, y: 1 }, 1, nothing) + storeWhile({ x: i, y: 1 }, 1, nothing).length;
console.log("2000 honest rounds", warm);

const listChanges = [
  "list => { list[3] = 'four'; }",
  "list => { list[2] = 2.5; }",
  "list => { list.length = 3; }",
  "list => { list.length = 0; }",
  "list => { list.push(10, 20); }",
  "list => { delete list[3]; }",
  "list => { delete list[3]; Object.setPrototypeOf(list, { 3: 300, push: Array.prototype.push, [Symbol.iterator]: Array.prototype[Symbol.iterator] }); }",
  "list => { Object.setPrototypeOf(list, null); }",
  "list => { Object.setPrototypeOf(list, class extends Array { push() { return 'subclass'; } }.prototype); }",
  "list => { list.push = () => 'own'; }",
  "list => { list[Symbol.iterator] = function* () { yield 1000; }; }",
  "list => { Object.defineProperty(list, 3, { get() { note('getter'); return 400; }, configurable: true }); }",
  "list => { Object.freeze(list); }",
  "list => { Object.defineProperty(list, 'length', { writable: false }); }",
  "list => { list[100] = 1; }",
  "list => { list.reverse(); }",
  "list => { list.shift(); }",
  "list => { list.fill('f'); }",
  "list => { list.extra = 1; }",
];

for (const text of listChanges) {
  attempt("sum while " + text, () => sumWhile([1, 2, 3, 4], 2, hidden(text)));
  attempt("iterate while " + text, () => iterateWhile([1, 2, 3, 4], 2, hidden(text)));
  attempt("push while " + text, () => pushWhile([1, 2, 3, 4], 2, hidden(text)));
}

const pointChanges = [
  "p => { p.x = 'text'; }",
  "p => { p.y = 5n; }",
  "p => { delete p.x; }",
  "p => { delete p.x; p.x = 7; }",
  "p => { p.z = 1; }",
  "p => { Object.defineProperty(p, 'x', { get() { note('get-x'); return 50; }, set(v) { note('set-x:' + v); }, configurable: true, enumerable: true }); }",
  "p => { Object.defineProperty(p, 'y', { value: 9, writable: false }); }",
  "p => { Object.freeze(p); }",
  "p => { Object.setPrototypeOf(p, { x: 'inherited' }); delete p.x; }",
  "p => { Object.setPrototypeOf(p, null); }",
  "p => { for (let i = 0; i < 100; i++) p['k' + i] = i; for (let i = 0; i < 100; i++) delete p['k' + i]; }",
