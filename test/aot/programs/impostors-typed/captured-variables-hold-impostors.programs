attempt("a private name stamped on a literal", () => {
  const o = { plain: true };
  new Stamped(o);
  return [Stamped.has(o), Stamped.read(o), Object.keys(o)];
});
attempt("stamped on an array, a function and a proxy", () => {
  const targets: object[] = [[1], () => 1, new Proxy({}, {})];
  for (const t of targets) new Stamped(t);
  return targets.map(t => Stamped.read(t));
});
attempt("stamped twice", () => {
  const o = {};
  new Stamped(o);
  new Stamped(o);
  return "no error";
});
attempt("never stamped", () => [Stamped.has({}), Stamped.read({})]);
attempt("made", () => Vault.made() > 2000);

honest("honest after");
//// records-and-index-signatures-get-impostors-from-any.ts
////= show

const log: string[] = [];

////= attempt

(globalThis as any).note = (text: string) => log.push(text);
const hidden = (text: string): any => (0, eval)("(" + text + ")");

type Scores = Record<string, number>;

function score(scores: Scores, name: string): number {
  return scores[name] + 1;
}

function sumScores(scores: Scores): number {
  let sum = 0;
  for (const name in scores) sum += scores[name];
  return sum;
}

function names(scores: Scores): string {
  return Object.keys(scores).join();
}

function values(scores: Scores): number {
  return Object.values(scores).reduce((a, b) => a + b, 0);
}

function entries(scores: Scores): string {
  return Object.entries(scores)
    .map(([name, value]) => name + "=" + (value + 1))
    .join();
}

function record(scores: Scores, name: string, value: number): string {
  scores[name] = value;
  return Object.keys(scores).join() + "|" + typeof scores[name];
}

function forget(scores: Scores, name: string): boolean {
  return delete scores[name];
}

function known(scores: Scores, name: string): boolean {
  return name in scores;
}

function byNumber(list: { [index: number]: string }, index: number): number {
  return list[index].length;
}

function honest(label: string): void {
  const scores: Scores = { b: 2, a: 1 };
  console.log(label, score(scores, "a"), sumScores(scores), names(scores), values(scores), entries(scores), record(scores, "c", 3), forget(scores, "b"), known(scores, "b"), byNumber(["ab"], 0), byNumber({ 1: "abc" }, 1));
}

honest("honest before");
const busy: Scores = { a: 1 };
let warm = 0;
for (let i = 0; i < 2000; i++) warm += score(busy, "a") + sumScores(busy) + values(busy) + record(busy, "k" + (i & 3), i).length;
console.log("2000 honest rounds", warm);

const records = [
  "{ a: 1, b: 2 }",
  "{ b: 2, a: 1 }",
  "{ a: '1', b: 2 }",
  "{ a: null }",
  "{ 2: 2, 1: 1, a: 0 }",
  "{ a: 1, [Symbol('s')]: 2 }",
  "{ get a() { note('get-a'); return 1; } }",
  "Object.create({ a: 1, inherited: 5 })",
  "Object.assign(Object.create(null), { a: 1 })",
  "Object.defineProperty({ b: 2 }, 'a', { value: 1 })",
  "Object.freeze({ a: 1 })",
  "new Proxy({ a: 1 }, { get(t, k) { note('get:' + String(k)); return t[k]; }, has(t, k) { note('has:' + String(k)); return k in t; }, ownKeys(t) { note('ownKeys'); return Reflect.ownKeys(t); }, getOwnPropertyDescriptor(t, k) { note('describe:' + String(k)); return Reflect.getOwnPropertyDescriptor(t, k); }, set(t, k, v) { note('set:' + String(k)); t[k] = v; return true; }, deleteProperty(t, k) { note('delete:' + String(k)); return delete t[k]; } })",
  "[1, 2]",
  "'ab'",
  "new Map([['a', 1]])",
  "new (class { a = 1; b() {} })()",
  "function a() {}",
  "5",
  "null",
  "undefined",
];

for (const text of records) {
  attempt("score " + text, () => score(hidden(text), "a"));
  attempt("sumScores " + text, () => sumScores(hidden(text)));
  attempt("names " + text, () => names(hidden(text)));
  attempt("values " + text, () => values(hidden(text)));
  attempt("entries " + text, () => entries(hidden(text)));
  attempt("record " + text, () => record(hidden(text), "c", 3));
  attempt("forget " + text, () => forget(hidden(text), "a"));
  attempt("known " + text, () => known(hidden(text), "a"));
}

for (const text of ["'a'", "'missing'", "'constructor'", "'__proto__'", "'toString'", "'hasOwnProperty'", "0", "-0", "1.5", "null", "undefined", "Symbol.iterator", "['a']", "{ toString() { note('toString'); return 'a'; } }"]) {
  attempt("score under " + text, () => score({ a: 1, "0": 5, null: 6, undefined: 7, "1.5": 8 }, hidden(text)));
  attempt("record under " + text, () => record({ a: 1 }, hidden(text), 2));
  attempt("known under " + text, () => known({ a: 1 }, hidden(text)));
  attempt("forget under " + text, () => forget({ a: 1 }, hidden(text)));
}

for (const text of ["2", "'2'", "undefined", "{}", "-0"]) attempt("record the value " + text, () => {
  const scores: Scores = { a: 1 };
  record(scores, "b", hidden(text));
  return [sumScores(scores), values(scores), entries(scores)];
});

for (const text of ["['ab']", "'ab'", "{ 0: 'ab' }", "{ 0: 5 }", "[]", "new Uint8Array(1)", "null"]) attempt("byNumber " + text, () => byNumber(hidden(text), 0));
for (const text of ["0", "'0'", "-0", "0.5", "-1", "'length'", "null"]) attempt("byNumber at " + text, () => byNumber(["ab"], hidden(text)));

honest("honest after");
//// recursive-typed-functions-walk-trees-with-impostors-deep-inside.ts
////= show

const log: string[] = [];

////= attempt

(globalThis as any).note = (text: string) => log.push(text);
const hidden = (text: string): any => (0, eval)("(" + text + ")");

interface Tree {
  value: number;
  children: Tree[];
}

function sumTree(t: Tree): number {
  let sum = t.value;
  for (let i = 0; i < t.children.length; i++) sum += sumTree(t.children[i]);
  return sum;
}

function depth(t: Tree): number {
  let deepest = 0;
  for (const child of t.children) deepest = Math.max(deepest, depth(child));
  return deepest + 1;
}

function values(t: Tree, into: number[] = []): number[] {
  into.push(t.value);
  t.children.forEach(child => values(child, into));
  return into;
}

function doubled(t: Tree): Tree {
  return { value: t.value * 2, children: t.children.map(doubled) };
}

interface Link {
  n: number;
  next: Link | null;
}

function sumLinks(l: Link | null): number {
  let sum = 0;
  while (l !== null) {
    sum += l.n;
    l = l.next;
  }
  return sum;
}

function leaf(value: number): Tree {
  return { value, children: [] };
}

function honest(label: string): void {
  const t: Tree = { value: 1, children: [leaf(2), { value: 3, children: [leaf(4)] }] };
  console.log(label, sumTree(t), depth(t), show(values(t)), JSON.stringify(doubled(t)), sumLinks({ n: 1, next: { n: 2, next: null } }));
}

honest("honest before");
let warm = 0;
for (let i = 0; i < 2000; i++) warm += sumTree({ value: i, children: [leaf(1), leaf(2)] }) + depth(leaf(i)) + sumLinks({ n: i, next: null });
console.log("2000 honest rounds", warm);

const trees = [
  '{"value":1,"children":[{"value":2,"children":[]}]}',
  '{"children":[{"children":[],"value":2}],"value":1}',
  '{"value":1,"children":[{"value":"2","children":[]}]}',
  '{"value":1,"children":[{"value":2}]}',
  '{"value":1,"children":[{"value":2,"children":null}]}',
  '{"value":1,"children":[null]}',
  '{"value":1,"children":[5]}',
  '{"value":1,"children":["text"]}',
  '{"value":1,"children":[[]]}',
  '{"value":1,"children":{"length":1,"0":{"value":2,"children":[]}}}',
  '{"value":1,"children":"ab"}',
  '{"value":1,"children":[{"value":2,"children":[{"value":null,"children":[]}]}]}',
  '{"value":1,"children":[{"value":2,"children":[]},{"value":2.5,"children":[]},{"value":-0,"children":[]}]}',
  '{"value":1,"children":[{"value":2,"children":[],"extra":true}]}',
  '{"value":-0,"children":[]}',
  "{}",
  "null",
];

for (const text of trees) {
  attempt("sumTree " + text, () => sumTree(JSON.parse(text)));
  attempt("depth " + text, () => depth(JSON.parse(text)));
  attempt("values " + text, () => values(JSON.parse(text)));
  attempt("doubled " + text, () => JSON.stringify(doubled(JSON.parse(text))));
}

attempt("an honest tree with one impostor grafted deep", () => {
  const t: Tree = { value: 1, children: [leaf(2), { value: 3, children: [leaf(4)] }] };
  t.children[1].children.push(hidden("{ value: 'five', children: [] }"));
  return [sumTree(t), depth(t), values(t)];
});
attempt("a child that is a getter", () => {
  const t: Tree = { value: 1, children: [] };
  t.children = hidden("Object.defineProperty([], 0, { get() { note('get-child'); return { value: 9, children: [] }; }, enumerable: true })");
  return [sumTree(t), depth(t)];
});
attempt("children that are a subclass with its own iterator", () => {
  const t: Tree = { value: 1, children: hidden("new (class extends Array { *[Symbol.iterator]() { yield { value: 100, children: [] }; } })({ value: 2, children: [] }, { value: 3, children: [] })") };
  return [sumTree(t), depth(t), values(t)];
});

for (const text of ['{"n":1,"next":{"n":2,"next":null}}', '{"n":1,"next":{"n":"2","next":null}}', '{"n":1}', '{"n":1,"next":{"n":2}}', '{"n":1,"next":0}', '{"n":1,"next":"text"}', "5", '""', "null"]) {
  attempt("sumLinks " + text, () => sumLinks(JSON.parse(text)));
}

honest("honest after");
