  "new (class extends RegExp { [Symbol.replace]() { return 'subclass replace'; } get flags() { note('flags'); return 'g'; } })('a')",
  "Object.create(RegExp.prototype)",
  "new Proxy(/a/, {})",
  "Object.setPrototypeOf(/a/, null)",
  "null",
  "undefined",
  "5",
];

