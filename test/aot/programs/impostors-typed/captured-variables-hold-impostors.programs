////: Above
interface Above {
    map?: unknown; indexOf?: unknown; join?: unknown; push?: unknown; get?: unknown; has?: unknown; size?: unknown; slice?: unknown; charAt?: unknown; test?: unknown; source?: unknown;
    getTime?: unknown; call?: unknown; bind?: unknown; then?: unknown;
}
////: Box
class Box {
    declare extra?: number;
    declare label?: string;
    constructor(label?: string) {
        if (label !== undefined)
            this.label = label;
    }
}
////: Options
interface Options {
    extra?: number;
    label?: string;
}
////: Tagged
function Tagged<B extends Constructor>(Base: B) {
  return class Tagged extends Base {
    tag = "tagged";
    describe(): string {
      return this.tag + ":" + Object.keys(this).join();
    }
  };
}
////: attempt-3
function attempt(label: string, target: unknown, run: () => unknown): void {
  log.length = 0;
  let outcome: string;
  try {
    outcome = "-> " + String(run());
  } catch (error) {
    outcome = "threw " + (error instanceof Error ? error.constructor.name : typeof error);
  }
  const seen = log.join(" ");
  console.log(label, outcome, describe(target), seen);
}
////: colorName
function colorName(color: Color): string {
  switch (color) {
    case Color.Red:
      return "red";
    case Color.Green:
      return "green";
    case Color.Blue:
      return "blue";
  }
}
////: describe
function describe(value: unknown): string {
  if (value === null || (typeof value !== "object" && typeof value !== "function")) return typeof value === "string" ? JSON.stringify(value) : String(value);
  const parts: string[] = [];
  for (const key of Reflect.ownKeys(value)) {
    const d = Reflect.getOwnPropertyDescriptor(value, key);
    if (d === undefined) continue;
    parts.push(String(key) + ":" + ("value" in d ? (Object.is(d.value, -0) ? "-0" : typeof d.value === "string" ? JSON.stringify(d.value) : String(d.value)) : "accessor") + (d.writable === false ? "!w" : "") + (d.enumerable ? "" : "!e"));
  }
  return "{" + parts.join(" ") + "}";
}
////: double
function double(x: number): number {
    return x * 2;
}
////: flagSwitch
function flagSwitch(on: boolean): string {
  switch (on) {
    case true:
      return "true";
    case false:
      return "false";
  }
}
////: for
for (const text of texts) {
  let target: any = hidden(text);
  attempt("reset " + text, target, () => reset(target));
  target = hidden(text);
  attempt("bump " + text, target, () => bump(target));
  target = hidden(text);
  attempt("step " + text, target, () => step(target));
  target = hidden(text);
  attempt("swap " + text, target, () => swap(target));
  target = hidden(text);
  attempt("halve " + text, target, () => halve(target));
}
////: for-2
for (let i = 0; i < 2000; i++) {
  const p = { x: i, y: 1 };
  warm += bump(p) + step(p) + halve(p);
  swap(p);
  reset(p);
}
////: honest-3
function honest(label: string): void {
  const a: Point = { x: 3, y: 4 };
  const b = { y: 10, x: 20 };
  reset(a);
  console.log(label, describe(a), bump(b), step(b), describe(b));
  swap(b);
  console.log(label, describe(b), halve(b), describe(b));
}
////: levelName
function levelName(level: Level): string {
  switch (level) {
    case 1:
      return "low";
    case 2:
      return "middle";
    case 3:
      return "high";
  }
}
