  '{"x":1,"y":2,"__proto__":{"x":9}}',
  '{"__proto__":{"x":9,"y":9}}',
  '{"x":1,"y":2,"0":0,"1":1}',
  '{"X":1,"Y":2}',
  "[1,2]",
  '"xy"',
  "5",
  "null",
  "true",
  "",
  "{",
];

