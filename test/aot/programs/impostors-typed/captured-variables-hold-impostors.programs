//// methods-of-three-heirs-and-awaited-functions-have-callers-from-any.ts
// Methods called through the class of the receiver, and async functions that are awaited at once, are handed values of other types than they declare.
const strangers: any[] = ["s", null, undefined, { a: 1 }, 1.5, true, 10n, [1], -0, NaN];
function show(value: unknown): string { try { return typeof value + ":" + String(value); } catch (error) { return "throws " + (error as Error).constructor.name; } }
async function twice(v: number): Promise<number> { await null; return v + v; }
async function size(v: string): Promise<number> { await null; return v.length; }
async function viaAwait(v: number, t: string) { const a = await twice(v); const b = await size(t); return show(a) + " " + show(b); }
abstract class Shape { abstract area(k: number): number; abstract name(s: string): number; }
class Square extends Shape { constructor(public w: number) { super(); } area(k: number) { return this.w * k; } name(s: string) { return s.length + 1; } }
class Round extends Shape { constructor(public r: number) { super(); } area(k: number) { return this.r + k; } name(s: string) { return s.length + 2; } }
class Flat extends Shape { area(k: number) { return k | 0; } name(s: string) { return s.charCodeAt(0); } }
const shapes: Shape[] = [new Square(2), new Round(3), new Flat()];
function viaTable(shape: Shape, k: number, s: string) { let out = ""; try { out += show(shape.area(k)); } catch (e) { out += "throws " + (e as Error).constructor.name; } try { out += " " + show(shape.name(s)); } catch (e) { out += " throws " + (e as Error).constructor.name; } return out; }
for (let warm = 0; warm < 300; warm++) viaTable(shapes[warm % 3], warm, "w" + warm);
for (let i = 0; i < strangers.length; i++) for (const shape of shapes) console.log(i, shape.constructor.name, viaTable(shape, strangers[i], strangers[i]));
for (let i = 0; i < strangers.length; i++) { try { console.log(i, await viaAwait(strangers[i], strangers[i])); } catch (e) { console.log(i, "throws", (e as Error).constructor.name); } }
export {};
//// mixins-extend-a-base-class-that-arrives-as-a-value.ts
////= show

const log: string[] = [];

////= attempt

(globalThis as any).note = (text: string) => log.push(text);
const hidden = (text: string): any => (0, eval)("(" + text + ")");

type Constructor<T = object> = new (...args: any[]) => T;

////= Tagged

function Counted<B extends Constructor>(Base: B) {
  return class Counted extends Base {
    count: number;
    constructor(...args: any[]) {
      super(...args);
      this.count = args.length;
    }
    next(): number {
      return ++this.count;
    }
  };
}

class Point {
  x: number;
  y = 2;
  constructor(x: number = 1) {
    this.x = x;
  }
  sum(): number {
    return this.x + this.y;
  }
}

class Empty {}

function honest(label: string): void {
  const TaggedPoint = Tagged(Point);
  const Both = Counted(Tagged(Point));
  const p = new TaggedPoint(5);
  const b = new Both(7);
  console.log(label, p.describe(), p.sum(), b.describe(), b.next(), b.sum(), new (Tagged(Empty))().describe(), p instanceof Point, b instanceof TaggedPoint);
}

honest("honest before");
let warm = 0;
const Warm = Counted(Tagged(Point));
for (let i = 0; i < 2000; i++) {
  const w = new Warm(i);
  warm += w.sum() + w.next() + w.describe().length;
}
console.log("2000 honest rounds", warm);

const bases = [
  "class Base { constructor(a) { this.first = a; this.second = 2; } hello() { return 'hello'; } }",
  "class Base { tag = 'base tag'; count = 'base count'; }",
  "class Base { get tag() { return 'getter'; } set tag(v) { note('set-tag:' + v); } set count(v) { note('set-count:' + v); } }",
  "class Base { constructor() { return { replaced: true }; } }",
  "class Base { constructor() { return new Proxy(this, { defineProperty(t, k, d) { note('define:' + String(k)); return Reflect.defineProperty(t, k, d); }, set(t, k, v, r) { note('set:' + String(k)); return Reflect.set(t, k, v, r); } }); } }",
  "class Base { constructor() { return Object.freeze(this); } }",
  "class Base { constructor() { return Object.preventExtensions(this); } }",
  "class Base { constructor() { note('new.target:' + new.target.name); note('keys:' + Object.keys(this).length); } }",
  "class Base { constructor() { throw new RangeError('no'); } }",
  "function Base(a) { this.es5 = a; }",
  "function Base() { return [1, 2]; }",
  "(function Base(a) { this.bound = a; }).bind(null, 'preset')",
  "new Proxy(class Base { constructor() { this.inner = 1; } }, { construct(t, args, nt) { note('construct'); return Reflect.construct(t, args, nt); } })",
  "Array",
  "Map",
  "Error",
  "Object",
  "Date",
  "Promise",
  "Uint8Array",
  "Function",
  "class Base extends Array { constructor() { super(); this.push(9); } }",
  "() => {}",
  "null",
  "5",
  "{}",
];

for (const text of bases) {
  attempt("Tagged " + text, () => {
    const Made = Tagged(hidden(text));
    const made = new Made(1);
    return [made.describe(), made.tag, Reflect.ownKeys(made).map(String).join()];
  });
  attempt("Counted " + text, () => {
    const Made = Counted(hidden(text));
    const made = new Made(1);
    return [made.next(), made.count, Object.keys(made).join()];
  });
}

attempt("inherited members of an unseen base", () => {
  const Made = Tagged(hidden(bases[0]));
  const made: any = new Made("a");
  return [made.hello(), made.first, made.second, made instanceof Made];
});
attempt("the same mixin over two bases keeps them apart", () => {
  const A = Tagged(Point);
  const B = Tagged(hidden(bases[0]));
  return [new A(1).describe(), new B(1).describe(), new A(1).describe(), A === B, A.name, B.name];
});
attempt("static members are inherited", () => {
  const Made: any = Tagged(hidden("class Base { static kind = 'static'; static make() { return new this(); } }"));
  return [Made.kind, Made.make().describe()];
});

honest("honest after");
//// non-null-assertions-on-values-that-are-null-or-undefined.ts
////= show

const log: string[] = [];

////= attempt

(globalThis as any).note = (text: string) => log.push(text);
const hidden = (text: string): any => (0, eval)("(" + text + ")");

interface Link {
  value: number;
  next?: Link;
  label: string | null;
}

function valueOfNext(n: Link): number {
  return n.next!.value + 1;
}

function labelLength(n: Link): number {
  return n.label!.length;
}

function firstOf(list: number[]): number {
  return list[0]! * 2;
}

function found(list: number[], wanted: number): number {
  return list.find(value => value === wanted)! + 1;
}

function fromMap(m: Map<string, number>, key: string): number {
  return m.get(key)! + 1;
}

function matched(text: string): number {
  return /(\d+)/.exec(text)![1]!.length;
}

function maybe(n: number | undefined): number {
  return n! + 1;
}

function maybeNull(s: string | null): string {
  return s! + "!";
}

function called(f: (() => number) | undefined): number {
  return f!() + 1;
}

class Late {
  size!: number;
  name!: string;
  items!: number[];
  grow(): number {
    return this.size + 1;
  }
  shout(): string {
    return this.name + "!";
  }
  count(): number {
    return this.items.length;
  }
}

function honest(label: string): void {
  const tail: Link = { value: 2, label: "tail" };
  const head: Link = { value: 1, next: tail, label: "head" };
  const late = new Late();
  late.size = 1;
  late.name = "late";
  late.items = [1];
  console.log(label, valueOfNext(head), labelLength(head), firstOf([4]), found([1, 2], 2), fromMap(new Map([["a", 1]]), "a"), matched("a12"), maybe(1), maybeNull("s"), called(() => 1), late.grow(), late.shout(), late.count());
}

honest("honest before");
let warm = 0;
const tail: Link = { value: 2, label: "tail" };
const head: Link = { value: 1, next: tail, label: "head" };
const filled = new Map([["a", 1]]);
for (let i = 0; i < 2000; i++) warm += valueOfNext(head) + labelLength(head) + firstOf([i]) + found([i], i) + fromMap(filled, "a") + matched("a1") + maybe(i) + called(() => i);
console.log("2000 honest rounds", warm);

attempt("next is absent", () => valueOfNext(tail));
attempt("next is undefined", () => valueOfNext({ value: 1, next: undefined, label: null }));
attempt("label is null", () => labelLength({ value: 1, label: null }));
attempt("an empty list", () => firstOf([]));
attempt("a hole", () => firstOf(new Array<number>(2)));
attempt("nothing found", () => found([1, 2], 3));
attempt("no such key", () => fromMap(filled, "b"));
attempt("no match", () => matched("abc"));
attempt("undefined", () => maybe(undefined));
attempt("null", () => maybeNull(null));
attempt("no function", () => called(undefined));
attempt("fields never set: grow", () => new Late().grow());
attempt("fields never set: shout", () => new Late().shout());
attempt("fields never set: count", () => new Late().count());
attempt("fields never set: keys", () => Object.keys(new Late()).join() + "|" + ("size" in new Late()));
attempt("a chain of assertions", () => head.next!.next!.next!.value);
attempt("an assertion on a store target", () => {
  const n: Link = { value: 1, label: null };
