////: Point
interface Point {
  x: number;
  y: number;
}
////: Scale
export class Scale {
  constructor(public factor: number) {}
  apply(n: number): number {
    return n * this.factor;
  }
}
////: add
function add(a: number, b: number): number {
  return a + b;
}
////: attempt
function attempt(label: string, run: () => unknown): void {
  log.length = 0;
  try {
    console.log(label, "->", show(run()), log.join(" "));
  } catch (error) {
    console.log(label, "threw", error instanceof Error ? error.constructor.name : typeof error, log.join(" "));
  }
}
////: attempt-4
export function attempt(label: string, run: () => unknown): void {
  log.length = 0;
  try {
    console.log(label, "->", show(run()), log.join(" "));
  } catch (error) {
    console.log(label, "threw", error instanceof Error ? error.constructor.name : typeof error, log.join(" "));
  }
}
////: code
function code(s: string): number {
  return s.charCodeAt(0) + s.length;
}
////: doubled
function doubled(list: number[]): number[] {
  return list.map(value => value * 2);
}
////: eachOf
function eachOf(f: Step): number {
  let sum = 0;
  for (let i = 0; i < 3; i++) sum += f(i);
  return sum;
}
////: half
function half(n: number): number {
  return n / 2;
}
////: honest
function honest(label: string): void {
  const list = [1, 2.5];
  const point: Point = { x: 1, y: 2 };
  const word = "abc";
  console.log(label, total([1, 2]), total(list), sum({ x: 3, y: 4 }), sum(point), code("a"), code(word), once(increment), once(n => n * 2), half(3), half(list[0]));
}
////: increment
function increment(n: number): number {
  return n + 1;
}
