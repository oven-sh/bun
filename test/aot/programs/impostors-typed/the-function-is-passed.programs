for (let i = 0; i < 2000; i++) warm += pairSum([i, 1]) + pairByIndex([i, 1]) + mixedPair(["a", i]) + headAndRest([i, 1]) + unpack({ x: i, y: 1 }) + unpackWithDefaults({ y: i }) + unpackNested({ at: { x: i, y: 0 }, list: [1] }) + renamed({ x: i, y: 1 });
