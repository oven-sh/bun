  attempt("pairByIndex " + text, () => pairByIndex(hidden(text)));
  attempt("mixedPair " + text, () => mixedPair(hidden(text)));
  attempt("headAndRest " + text, () => headAndRest(hidden(text)));
}

const objects = [
  "{ x: 1, y: 2 }",
