//// the-function-is-passed-as-a-function-typed-parameter.ts
////= show

const log: string[] = [];

////= attempt

(globalThis as any).note = (text: string) => log.push(text);
const hidden = (text: string): any => (0, eval)("(" + text + ")");

////= Point

type Step = (n: number) => number;

////= total-2

const lists = ["[1, 2]", "[1, '2']", "[1, , 3]", "[-0]", "{ length: 2, 0: 1, 1: 2 }", "'12'", "new Uint8Array([1, 2])", "new Proxy([1, 2], {})", "null"];
const points = ["{ x: 1, y: 2 }", "{ y: 2, x: 1 }", "{ x: '1', y: 2 }", "{ x: 1 }", "{ get x() { note('get-x'); return 1; }, y: 2 }", "[1, 2]", "5", "null"];
const strings = ["'abc'", "new String('abc')", "['a']", "{ charCodeAt() { return -1; }, length: 1 }", "65", "null"];
const steps = ["n => n + 1", "n => String(n)", "class {}", "new Proxy(n => n, { apply() { return 9; } })", "{ call() { return 1; } }", "null"];
const numbers = ["3", "'3'", "3n", "-0", "{ valueOf() { note('valueOf'); return 3; } }", "undefined"];

////= increment-2

function withList(f: (list: number[]) => number, list: number[]): number {
  return f(list) + 1;
}

function withPoint(f: (p: Point) => number, p: Point): number {
  return f(p) + 1;
}

function withString(f: (s: string) => number, s: string): number {
  return f(s) + 1;
}

function withNumber(f: Step, n: number): number {
  let result = 0;
  for (let i = 0; i < 2; i++) result += f(n);
  return result;
}

function generic<T>(f: (value: T) => number, value: T): number {
  return f(value) + 1;
}

function returned(which: number): Step {
  return which === 0 ? half : increment;
}

function composed(f: Step, g: Step): Step {
  return n => f(g(n));
}

honest("honest before");
warm();
console.log("honest handed on", withList(total, [1, 2]), withPoint(sum, { x: 1, y: 2 }), withString(code, "a"), withNumber(half, 3), generic(total, [1]), generic(half, 3), generic(code, "a"), returned(0)(3), composed(half, increment)(3));
let rounds = 0;
for (let i = 0; i < 2000; i++) rounds += withList(total, [i]) + withPoint(sum, { x: i, y: 1 }) + withString(code, "a") + withNumber(half, i) + generic(half, i) + returned(i & 1)(i) + composed(half, increment)(i);
console.log("2000 honest rounds handed on", rounds);

////= for-4	lists	"withList "	withList	total	"generic total "
////= for-4	points	"withPoint "	withPoint	sum	"generic sum "
////= for-4	strings	"withString "	withString	code	"generic code "
for (const text of numbers) {
  attempt("withNumber " + text, () => withNumber(half, hidden(text)));
  attempt("generic half " + text, () => generic(half, hidden(text)));
  attempt("returned " + text, () => returned(0)(hidden(text)));
  attempt("composed " + text, () => composed(half, increment)(hidden(text)));
}
for (const text of steps) {
  attempt("withNumber gets the function " + text, () => withNumber(hidden(text), 3));
  attempt("generic gets the function " + text, () => generic(hidden(text), 3));
  attempt("composed outer " + text, () => composed(hidden(text), increment)(3));
  attempt("composed inner " + text, () => composed(half, hidden(text))(3));
  attempt("once handed on " + text, () => generic(once, hidden(text)));
}

attempt("the wrong function for the value", () => generic(hidden("f => f")(total), hidden("{ x: 1, y: 2 }")));
attempt("the functions crossed", () => withList(hidden("f => f")(code), [1, 2]));
attempt("the functions crossed the other way", () => withString(hidden("f => f")(total), "12"));

honest("honest after");
//// the-function-is-stored-in-a-field.ts
////= show

const log: string[] = [];

////= attempt

(globalThis as any).note = (text: string) => log.push(text);
const hidden = (text: string): any => (0, eval)("(" + text + ")");

////= Point

type Step = (n: number) => number;

////= total-2

const lists = ["[1, 2]", "[1, '2']", "[1, , 3]", "[-0]", "{ length: 2, 0: 1, 1: 2 }", "'12'", "new Uint8Array([1, 2])", "new Proxy([1, 2], {})", "null"];
const points = ["{ x: 1, y: 2 }", "{ y: 2, x: 1 }", "{ x: '1', y: 2 }", "{ x: 1 }", "{ get x() { note('get-x'); return 1; }, y: 2 }", "[1, 2]", "5", "null"];
const strings = ["'abc'", "new String('abc')", "['a']", "{ charCodeAt() { return -1; }, length: 1 }", "65", "null"];
const steps = ["n => n + 1", "n => String(n)", "class {}", "new Proxy(n => n, { apply() { return 9; } })", "{ call() { return 1; } }", "null"];
const numbers = ["3", "'3'", "3n", "-0", "{ valueOf() { note('valueOf'); return 3; } }", "undefined"];

////= increment-2

class Tools {
  total: (list: number[]) => number = total;
  sum = sum;
  readonly code = code;
  once: (f: Step) => number;
  static half = half;
  #hidden = half;

  constructor() {
    this.once = once;
  }

  viaPrivate(n: number): number {
    return this.#hidden(n);
  }

  run(list: number[], p: Point, s: string, f: Step, n: number): number {
    return this.total(list) + this.sum(p) + this.code(s) + this.once(f) + Tools.half(n) + this.#hidden(n);
  }
}

const literal = { total, sum, code, once, half, nested: { deep: { half } } };
const tools = new Tools();

honest("honest before");
warm();
console.log("honest through fields", tools.total([1, 2]), tools.sum({ x: 1, y: 2 }), tools.code("a"), tools.once(increment), Tools.half(3), tools.viaPrivate(3), tools.run([1], { x: 1, y: 1 }, "a", increment, 2), literal.total([1]), literal.nested.deep.half(5));
let rounds = 0;
for (let i = 0; i < 2000; i++) rounds += tools.total([i]) + tools.sum({ x: i, y: 0 }) + tools.code("a") + tools.once(increment) + Tools.half(i) + tools.viaPrivate(i) + literal.half(i);
console.log("2000 honest rounds through fields", rounds);

for (const text of lists) {
  attempt("field total " + text, () => tools.total(hidden(text)));
  attempt("literal total " + text, () => literal.total(hidden(text)));
  attempt("run with list " + text, () => tools.run(hidden(text), { x: 1, y: 1 }, "a", increment, 2));
}
for (const text of points) {
  attempt("field sum " + text, () => tools.sum(hidden(text)));
  attempt("literal sum " + text, () => literal.sum(hidden(text)));
  attempt("run with point " + text, () => tools.run([1], hidden(text), "a", increment, 2));
}
for (const text of strings) {
  attempt("field code " + text, () => tools.code(hidden(text)));
  attempt("run with string " + text, () => tools.run([1], { x: 1, y: 1 }, hidden(text), increment, 2));
}
for (const text of steps) {
  attempt("field once " + text, () => tools.once(hidden(text)));
  attempt("run with step " + text, () => tools.run([1], { x: 1, y: 1 }, "a", hidden(text), 2));
}
for (const text of numbers) {
  attempt("static half " + text, () => Tools.half(hidden(text)));
  attempt("private half " + text, () => tools.viaPrivate(hidden(text)));
  attempt("nested half " + text, () => literal.nested.deep.half(hidden(text)));
  attempt("run with number " + text, () => tools.run([1], { x: 1, y: 1 }, "a", increment, hidden(text)));
}

for (const text of ["list => 'replaced'", "null", "5", "{ call() {} }", "class {}", "new Proxy(function () {}, { apply(t, self, args) { note('apply'); return args.length; } })"]) {
  const changed = new Tools();
  changed.total = hidden(text);
  attempt("the field itself holds " + text, () => changed.total([1, 2]));
  attempt("  plus one", () => changed.total([1, 2]) + 1);
  attempt("  in run", () => changed.run([1], { x: 1, y: 1 }, "a", increment, 2));
  const changedLiteral = { ...literal };
  changedLiteral.half = hidden(text);
  attempt("the literal's member holds " + text, () => changedLiteral.half(4));
}

(Tools as any).half = hidden("n => 'static replaced'");
attempt("the static field was replaced", () => Tools.half(4));
attempt("  in run", () => tools.run([1], { x: 1, y: 1 }, "a", increment, 2));
Tools.half = half;

honest("honest after");
//// the-function-is-stored-in-an-array-a-tuple-a-map-and-a-set.ts
////= show

const log: string[] = [];

////= attempt

(globalThis as any).note = (text: string) => log.push(text);
const hidden = (text: string): any => (0, eval)("(" + text + ")");

////= Point

type Step = (n: number) => number;

////= total-2

const lists = ["[1, 2]", "[1, '2']", "[1, , 3]", "[-0]", "{ length: 2, 0: 1, 1: 2 }", "'12'", "new Uint8Array([1, 2])", "new Proxy([1, 2], {})", "null"];
const points = ["{ x: 1, y: 2 }", "{ y: 2, x: 1 }", "{ x: '1', y: 2 }", "{ x: 1 }", "{ get x() { note('get-x'); return 1; }, y: 2 }", "[1, 2]", "5", "null"];
const strings = ["'abc'", "new String('abc')", "['a']", "{ charCodeAt() { return -1; }, length: 1 }", "65", "null"];
const steps = ["n => n + 1", "n => String(n)", "class {}", "new Proxy(n => n, { apply() { return 9; } })", "{ call() { return 1; } }", "null"];
const numbers = ["3", "'3'", "3n", "-0", "{ valueOf() { note('valueOf'); return 3; } }", "undefined"];

////= increment-2

const halves: ((n: number) => number)[] = [half, n => n / 2, increment];
const sums: Array<(p: Point) => number> = [sum, p => p.x - p.y];
const pair: [(list: number[]) => number, (s: string) => number] = [total, code];
const byName = new Map<string, (n: number) => number>([
  ["half", half],
  ["increment", increment],
]);
const inSet = new Set<(list: number[]) => number>([total]);

function applyAll(fs: ((n: number) => number)[], n: number): number[] {
  const results: number[] = [];
  for (let i = 0; i < fs.length; i++) results.push(fs[i](n));
  return results;
}

function chain(fs: ((n: number) => number)[], n: number): number {
  for (const f of fs) n = f(n);
  return n;
}

honest("honest before");
warm();
console.log("honest through containers", halves[0](4), halves[1](4), sums[0]({ x: 1, y: 2 }), pair[0]([1, 2]), pair[1]("a"), byName.get("half")?.(4), show(applyAll(halves, 4)), chain(halves, 4), [...inSet][0]([5]));
let rounds = 0;
for (let i = 0; i < 2000; i++) rounds += halves[i % 3](i) + sums[i % 2]({ x: i, y: 1 }) + pair[0]([i]) + chain(halves, i);
console.log("2000 honest rounds through containers", rounds);

for (const text of numbers) {
  attempt("halves[0] " + text, () => halves[0](hidden(text)));
  attempt("halves[1] " + text, () => halves[1](hidden(text)));
  attempt("applyAll " + text, () => applyAll(halves, hidden(text)));
  attempt("chain " + text, () => chain(halves, hidden(text)));
  attempt("map entry " + text, () => byName.get("half")?.(hidden(text)));
}
for (const text of points) for (let i = 0; i < sums.length; i++) attempt("sums[" + i + "] " + text, () => sums[i](hidden(text)));
for (const text of lists) {
  attempt("pair[0] " + text, () => pair[0](hidden(text)));
  attempt("from the set " + text, () => [...inSet][0](hidden(text)));
}
for (const text of strings) attempt("pair[1] " + text, () => pair[1](hidden(text)));

for (const text of ["n => 'text'", "null", "undefined", "5", "class {}", "{ call() {} }", "new Proxy(n => n, { apply() { note('apply'); return -0; } })", "async n => n"]) {
  const changed = [...halves];
  changed[1] = hidden(text);
  attempt("an element is " + text, () => changed[1](4));
  attempt("  applyAll", () => applyAll(changed, 4));
  attempt("  chain", () => chain(changed, 4));
}

attempt("past the end", () => halves[3](4));
attempt("a hole", () => {
  const holey: ((n: number) => number)[] = [half];
  holey[2] = half;
  return applyAll(holey, 4);
});
attempt("the list of functions is an impostor: array-like", () => applyAll(hidden("{ length: 1, 0: n => n + 'x' }"), 4));
attempt("the list of functions is an impostor: set", () => chain(hidden("new Set([n => n + 1, n => n + 'x'])"), 4));
attempt("the list of functions is an impostor: string", () => applyAll(hidden("'ab'"), 4));

honest("honest after");
