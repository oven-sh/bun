////= attempt

(globalThis as any).note = (text: string) => log.push(text);
const hidden = (text: string): any => (0, eval)("(" + text + ")");

function sumBytes(bytes: Uint8Array): number {
  let sum = 0;
  for (let i = 0; i < bytes.length; i++) sum += bytes[i];
  return sum;
}

function firstByte(bytes: Uint8Array): number {
  return bytes[0] + 1;
}

function putByte(bytes: Uint8Array, value: number): number {
  bytes[0] = value;
  return bytes[0];
}

function putPastEnd(bytes: Uint8Array): string {
  bytes[bytes.length] = 7;
  return bytes.length + ":" + Object.keys(bytes).length;
}

function sumDoubles(values: Float64Array): number {
  let sum = 0;
  for (const value of values) sum += value;
  return sum;
}

function part(bytes: Uint8Array): number {
  return bytes.subarray(1).length + bytes.byteLength + bytes.byteOffset;
}

function viewed(view: DataView): number {
  return view.getUint8(0) + view.byteLength;
}

function sized(buffer: ArrayBuffer): number {
  return buffer.byteLength + new Uint8Array(buffer).length;
}

function honest(label: string): void {
  const bytes = new Uint8Array([1, 2, 3]);
  console.log(label, sumBytes(bytes), firstByte(bytes), putByte(bytes, 300), putPastEnd(bytes), sumDoubles(new Float64Array([0.5, 1])), part(bytes), viewed(new DataView(bytes.buffer)), sized(bytes.buffer));
}

honest("honest before");
const busy = new Uint8Array(4);
let warm = 0;
for (let i = 0; i < 2000; i++) warm += putByte(busy, i) + sumBytes(busy) + firstByte(busy) + part(busy);
console.log("2000 honest rounds", warm);

const arrays = [
  "new Uint8Array([1, 2, 3])",
  "new Uint8Array(0)",
  "new Int8Array([-1, 2])",
  "new Uint8ClampedArray([1, 2])",
  "new Uint16Array([300, 2])",
  "new Int32Array([-2147483648, 2])",
  "new Uint32Array([4294967295, 2])",
  "new Float32Array([1.5, NaN])",
  "new Float64Array([-0, 1e308])",
  "new Float16Array([1.5])",
  "new BigInt64Array([1n, 2n])",
  "Buffer.from([1, 2, 3])",
  "new Uint8Array(new ArrayBuffer(8), 2, 3)",
  "new Uint8Array(new ArrayBuffer(2, { maxByteLength: 8 }))",
  "(() => { const b = new ArrayBuffer(4); const a = new Uint8Array(b); b.transfer(); return a; })()",
  "new (class extends Uint8Array { get length() { return 1; } subarray() { return 'own'; } })([5, 6])",
  "Object.assign(new Uint8Array([1, 2]), { extra: 1 })",
  "Object.setPrototypeOf(new Uint8Array([1, 2]), null)",
  "Object.setPrototypeOf(new Uint8Array([1, 2]), Array.prototype)",
  "new Proxy(new Uint8Array([1, 2]), {})",
  "[1, 2, 3]",
  "[300, '2']",
  "{ length: 2, 0: 1, 1: 2, byteLength: 'b', byteOffset: 'o', subarray() { return []; } }",
  "'123'",
  "new DataView(new ArrayBuffer(2))",
  "new ArrayBuffer(2)",
  "null",
  "5",
];

for (const text of arrays) {
  attempt("sumBytes " + text, () => sumBytes(hidden(text)));
  attempt("firstByte " + text, () => firstByte(hidden(text)));
  attempt("putByte " + text, () => putByte(hidden(text), 300));
  attempt("putPastEnd " + text, () => putPastEnd(hidden(text)));
  attempt("sumDoubles " + text, () => sumDoubles(hidden(text)));
  attempt("part " + text, () => part(hidden(text)));
  attempt("viewed " + text, () => viewed(hidden(text)));
  attempt("sized " + text, () => sized(hidden(text)));
}

for (const text of ["300", "-1", "1.9", "-0", "NaN", "'7'", "'x'", "null", "undefined", "true", "7n", "{ valueOf() { note('valueOf'); return 7; } }", "Symbol()"]) {
  attempt("putByte the value " + text, () => putByte(new Uint8Array(1), hidden(text)));
}

attempt("the buffer shrinks in the middle of a sum", () => {
  const buffer = new ArrayBuffer(4, { maxByteLength: 8 });
  const bytes = new Uint8Array(buffer).fill(1);
  let sum = 0;
  for (let i = 0; i < bytes.length; i++) {
    if (i === 1) buffer.resize(2);
    sum += bytes[i];
  }
  return sum;
});
attempt("valueOf detaches the buffer during a store", () => {
  const bytes = new Uint8Array(2);
  return [putByte(bytes, { valueOf: () => (bytes.buffer.transfer(), 5) } as any), bytes.length];
});

honest("honest after");

console.log("bytes made in plain sight", Buffer.from("he").length);
//// typed-fields-of-a-class-hold-impostors-from-any.ts
////= show

const log: string[] = [];

////= attempt

(globalThis as any).note = (text: string) => log.push(text);
const hidden = (text: string): any => (0, eval)("(" + text + ")");

////= Point

class Store {
  count: number = 0;
  name: string = "store";
  items: number[] = [];
  at: Point = { x: 0, y: 0 };
  step: (n: number) => number = n => n + 1;
  ready: boolean = false;
  static shared: number = 1;

  bump(): number {
    return ++this.count;
  }
  title(): string {
    return this.name.toUpperCase() + this.name.length;
  }
  sum(): number {
    let result = 0;
    for (let i = 0; i < this.items.length; i++) result += this.items[i];
    return result;
  }
  add(n: number): number {
    return this.items.push(n);
  }
  where(): number {
    return this.at.x + this.at.y;
  }
  run(): number {
    return this.step(1) + 1;
  }
  state(): string {
    return this.ready ? "ready" : "waiting";
  }
}

function honest(label: string): void {
  const s = new Store();
  s.count = 4;
  s.items = [1, 2];
  s.at = { x: 1, y: 2 };
  console.log(label, s.bump(), s.title(), s.sum(), s.add(3), s.where(), s.run(), s.state(), Store.shared + 1);
}

honest("honest before");
const busy = new Store();
let warm = 0;
for (let i = 0; i < 2000; i++) {
  busy.items = [i];
  busy.at = { x: i, y: 1 };
  warm += busy.bump() + busy.title().length + busy.sum() + busy.add(1) + busy.where() + busy.run();
}
console.log("2000 honest rounds", warm);

function put(field: keyof Store, texts: string[], use: (s: Store) => unknown): void {
  for (const text of texts) {
    const direct = new Store();
    attempt(field + " = " + text, () => {
      const value: any = hidden(text);
      if (field === "count") direct.count = value;
      if (field === "name") direct.name = value;
      if (field === "items") direct.items = value;
      if (field === "at") direct.at = value;
      if (field === "step") direct.step = value;
      if (field === "ready") direct.ready = value;
      return use(direct);
    });
    attempt("  again", () => use(direct));
    const byName = new Store();
    attempt("  stored by a computed name", () => {
      (byName as any)[hidden("'" + field + "'")] = hidden(text);
      return use(byName);
    });
    const assigned = new Store();
    attempt("  stored by Object.assign", () => use(Object.assign(assigned, { [field]: hidden(text) })));
    const defined = new Store();
    attempt("  defined as a getter", () => {
      Object.defineProperty(defined, field, { get: () => (log.push("get"), hidden(text)), configurable: true });
      return use(defined);
    });
  }
}

put("count", ["5", "'5'", "5n", "-0", "2147483647", "null", "undefined", "{ valueOf() { note('valueOf'); return 5; } }"], s => s.bump());
put("name", ["'abc'", "5", "null", "['a']", "new String('abc')", "{ toUpperCase() { return 'UP'; }, length: -1 }"], s => s.title());
put("items", ["[1, 2]", "['1', '2']", "[1, , 2]", "'12'", "{ length: 2, 0: 1, 1: 2 }", "new Uint8Array([1, 2])", "null"], s => s.sum());
put("items", ["[1, 2]", "Object.freeze([1])", "{ push() { return 'own'; } }", "new (class extends Array { push() { return 42; } })()", "new Set()", "'12'"], s => s.add(3));
put("at", ["{ x: 1, y: 2 }", "{ y: 2, x: 1 }", "{ x: '1', y: 2 }", "{}", "null", "5", "[1, 2]"], s => s.where());
put("step", ["n => n * 2", "n => 'text'", "null", "class {}", "function (n) { return typeof this; }", "new Proxy(n => n, { apply() { return 9; } })"], s => s.run());
put("ready", ["true", "0", "''", "'false'", "null", "{}", "NaN"], s => s.state());

(Store as any).shared = hidden("'shared'");
attempt("a static field", () => Store.shared + 1);
Store.shared = 1;
attempt("a deleted field", () => {
  const s = new Store();
  delete (s as any).count;
  return [s.bump(), Object.keys(s).join()];
});
attempt("a field found on the prototype after deletion", () => {
  const s = new Store();
  delete (s as any).name;
  (Store.prototype as any).name = hidden("7");
  try {
    return s.title();
  } finally {
    delete (Store.prototype as any).name;
  }
});

honest("honest after");
//// values-from-any-stay-the-same-objects-in-typed-places.ts
////= show

const log: string[] = [];

////= attempt

(globalThis as any).note = (text: string) => log.push(text);
const hidden = (text: string): any => (0, eval)("(" + text + ")");

////= Point

interface Line {
  from: Point;
  to: Point;
  tags: string[];
}

class Holder {
  point: Point;
  constructor(point: Point) {
    this.point = point;
  }
}

function same(p: Point): Point {
  return p;
}

function move(p: Point): void {
  p.x += 10;
}

function grow(list: number[]): void {
  list.push(99);
}

const keep: { original: any } = { original: null };
(globalThis as any).keep = keep;

function fresh(text: string): any {
  keep.original = hidden(text);
  return keep.original;
}

const objects = ["{ x: 1, y: 2 }", "{ y: 2, x: 1 }", "{ x: 1, y: 2, z: 3 }", "{ x: '1', y: 2 }", "{ x: 1 }", "Object.create({ x: 1, y: 2 })", "Object.freeze({ x: 1, y: 2 })", "new (class P { x = 1; y = 2; })()", "Object.assign([], { x: 1, y: 2 })", "Object.assign(() => 1, { x: 1, y: 2 })", "new Proxy({ x: 1, y: 2 }, {})"];

for (const text of objects) {
  attempt("identity " + text, () => {
    const local: Point = fresh(text);
    const cast = keep.original as Point;
    const list: Point[] = [keep.original];
    const holder = new Holder(keep.original);
    const literal: { p: Point } = { p: keep.original };
    const captured = () => local;
    const map = new Map<string, Point>([["k", keep.original]]);
    return [local === keep.original, cast === local, same(local) === keep.original, list[0] === keep.original, holder.point === keep.original, literal.p === keep.original, captured() === keep.original, map.get("k") === keep.original, list.includes(local), list.indexOf(keep.original)];
  });
  attempt("a typed store is seen outside " + text, () => {
    const local: Point = fresh(text);
    move(local);
    local.y = -1;
    return [keep.original.x, keep.original.y, JSON.stringify(keep.original), Object.keys(keep.original).join()];
  });
  attempt("an outside store is seen in typed code " + text, () => {
    const local: Point = fresh(text);
    const holder = new Holder(local);
    hidden("keep.original.x = 'changed outside'");
    hidden("keep.original.extra = true");
    return [local.x, holder.point.x, same(local).x, Object.keys(local).join()];
  });
}

attempt("nested objects", () => {
  const line: Line = fresh("{ from: { x: 1, y: 2 }, to: { x: 3, y: 4 }, tags: ['a'] }");
  const from = line.from;
  move(from);
  line.tags.push("b");
  line.to = line.from;
  return [from === keep.original.from, keep.original.from.x, keep.original.tags.join(), keep.original.to === keep.original.from, line.tags === keep.original.tags];
});
attempt("one object reached twice", () => {
  const line: Line = fresh("(() => { const p = { x: 1, y: 2 }; return { from: p, to: p, tags: [] }; })()");
  move(line.from);
  return [line.from === line.to, line.to.x];
});
attempt("an object that contains itself", () => {
  interface Loop {
    self: Loop;
    n: number;
  }
  const loop: Loop = fresh("(() => { const o = { n: 1 }; o.self = o; return o; })()");
  loop.self.self.n = 5;
  return [loop.self === loop, loop.n, keep.original.n];
});
for (const text of ["[1, 2]", "['1', 2]", "[1, , 3]", "new (class L extends Array {})(1, 2)", "Object.assign([1, 2], { extra: 1 })"]) {
  attempt("lists " + text, () => {
    const list: number[] = fresh(text);
    grow(list);
    list[0] = -1;
    hidden("keep.original.push('outside')");
    return [list === keep.original, list.length, keep.original.length, list, Object.keys(list).join()];
  });
}
attempt("JSON.parse keeps one object", () => {
  const parsed = JSON.parse('{"x":1,"y":2}');
  const a: Point = parsed;
  const b: Point = parsed;
  move(a);
  return [a === b, b.x, parsed.x, a === parsed];
});
attempt("as keys of a WeakMap and members of a Set", () => {
  const w = new WeakMap<object, string>();
  const s = new Set<Point>();
  const raw = fresh("{ x: 1, y: 2 }");
  w.set(raw, "found");
  s.add(raw);
  const typed: Point = raw;
  return [w.get(typed), s.has(typed), w.get(same(typed)), s.has(new Holder(typed).point)];
});
attempt("a typed object goes out and comes back", () => {
  const mine: Point = { x: 1, y: 2 };
  const back: Point = hidden("o => o")(mine);
  const changed: Point = hidden("o => { o.x = 'outside'; o.z = 3; delete o.y; return o; }")(mine);
  return [back === mine, changed === mine, mine.x, mine.y, Object.keys(mine).join(), JSON.stringify(mine)];
});
attempt("a typed instance goes out and comes back", () => {
  const mine = new Holder({ x: 1, y: 2 });
  const back: Holder = hidden("o => { o.point = { x: 'swapped' }; o.added = 1; return o; }")(mine);
  return [back === mine, mine.point.x, mine.point.y, Object.keys(mine).join(), back instanceof Holder];
});
attempt("a typed list goes out and comes back", () => {
  const mine: number[] = [1, 2, 3];
  const back: number[] = hidden("l => { l[1] = 'outside'; l.length = 2; return l; }")(mine);
  return [back === mine, mine, mine.length];
});
attempt("functions", () => {
  const f = (n: number): number => n + 1;
  const back: (n: number) => number = hidden("f => f")(f);
  const raw = fresh("n => n * 2");
  const typed: (n: number) => number = raw;
  return [back === f, typed === keep.original, typed(2), back(2)];
});
//// values-of-the-wrong-type-arrive-at-thirty-six-typed-positions.ts
// A program behaves the same whether its types are right, wrong or absent: a value of another type arrives at thirty-six typed positions, three rounds each,
// and the values, their types and the classes of the errors are those of plain Bun. The wording of the messages is left out.
declare const console: { log(...a: unknown[]): void };
const lie = <T,>(v: unknown): T => v as T;
const show = (label: string, f: () => unknown) => { try { const r = f(); console.log(label, typeof r, JSON.stringify(r) ?? String(r)); } catch (e: any) { console.log(label, "THREW", e?.constructor?.name); } };
function add(a: number, b: number): number { return a + b; }
function len(s: string): number { return s.length; }
function first(xs: number[]): number { return xs[0] * 2; }
class Vec { x: number; y: number; constructor(x: number, y: number) { this.x = x; this.y = y; } norm(): number { return Math.sqrt(this.x * this.x + this.y * this.y); } }
function normOf(v: Vec): number { return v.norm(); }
function xOf(v: Vec): number { return v.x + 1; }
interface Named { name: string; age: number }
function greet(p: Named): string { return p.name + ":" + (p.age + 1); }
enum Color { Red, Green, Blue }
function paint(c: Color): string { return c === Color.Red ? "red" : c === Color.Green ? "green" : "other:" + c; }
function apply(f: (n: number) => number, n: number): number { return f(n) + 1; }
function opt(a?: number): number { return (a ?? 5) + 1; }
function ret(): number { return lie<number>("not a number"); }
function union(v: string | number): string { return typeof v === "string" ? "s" + v : "n" + (v + 1); }
function tuple(t: [number, string]): string { return t[1] + t[0]; }
function big(n: bigint): bigint { return n + 1n; }
function mapGet(m: Map<string, number>, k: string): number { return (m.get(k) ?? 0) + 1; }
async function later(n: number): Promise<number> { return n + 1; }
function* gen(n: number): Generator<number> { yield n + 1; }
for (let round = 0; round < 3; round++) {
  show("add ok", () => add(1, 2));
  show("add str", () => add(lie<number>("1"), 2));
  show("add obj", () => add(lie<number>({ valueOf() { return 40; } }), 2));
  show("add undef", () => add(lie<number>(undefined), 2));
  show("add missing", () => (add as any)(1));
  show("len num", () => len(lie<string>(42)));
  show("len arr", () => len(lie<string>([1, 2, 3])));
  show("len null", () => len(lie<string>(null)));
  show("first strs", () => first(lie<number[]>(["7", "8"])));
  show("first arraylike", () => first(lie<number[]>({ 0: 21, length: 1 })));
  show("first typed", () => first(lie<number[]>(new Uint8Array([9]))));
  show("norm plain", () => normOf(lie<Vec>({ x: 3, y: 4, norm() { return -1; } })));
  show("norm none", () => normOf(lie<Vec>({ x: 3, y: 4 })));
  show("xOf plain", () => xOf(lie<Vec>({ x: "3" })));
  show("xOf proxy", () => xOf(lie<Vec>(new Proxy({}, { get: () => 10 }))));
  show("xOf sub", () => xOf(Object.create(new Vec(5, 6))));
  show("greet wrong", () => greet(lie<Named>({ name: 7, age: "8" })));
  show("greet getter", () => greet(lie<Named>({ get name() { return "g"; }, get age() { return 1; } })));
  show("paint 99", () => paint(lie<Color>(99)));
  show("paint 1.5", () => paint(lie<Color>(1.5)));
  show("paint str", () => paint(lie<Color>("Red")));
  show("apply str fn", () => apply(lie<(n: number) => number>((n: any) => n + "!"), 1));
  show("apply non fn", () => apply(lie<(n: number) => number>(3), 1));
  show("opt null", () => opt(lie<number>(null)));
  show("opt str", () => opt(lie<number>("x")));
  show("ret", () => ret());
  show("union bool", () => union(lie<string>(true)));
  show("union obj", () => union(lie<number>({})));
  show("tuple swapped", () => tuple(lie<[number, string]>(["a", 1])));
  show("big num", () => big(lie<bigint>(1)));
  show("map obj", () => mapGet(lie<Map<string, number>>({ get: () => 9 }), "k"));
  show("map plain", () => mapGet(lie<Map<string, number>>({}), "k"));
  show("field store", () => { const v = new Vec(1, 2); v.x = lie<number>("s"); (v as any).z = 1; delete (v as any).y; return [v.x, v.y, v.norm()]; });
  show("ctor wrong", () => { const v = new Vec(lie<number>("a"), lie<number>(null)); return [v.x, v.y, v.norm()]; });
  show("this wrong", () => Vec.prototype.norm.call(lie<Vec>({ x: 6, y: 8 })));
  show("gen", () => [...gen(lie<number>("g"))]);
}
console.log(await later(lie<number>("p")), await later(lie<number>({})).then(String));
export {};
//// what-a-typed-function-stores-through-an-impostor-is-found-by-untyped-code.ts
interface Holder { child: Leaf | undefined }
class Leaf { kind = 1; next: Leaf | undefined = undefined }
function put(h: Holder, l: Leaf) { h.child = l }
function read(l: Leaf): number { return l.kind + 1 }
const sneaky: any = { other: true };
const leaf = new Leaf();
put(sneaky, leaf);
const got: any = sneaky.child;
got.kind = "text";
console.log(read(leaf), typeof leaf.kind);

interface Caller { run: (() => number) | undefined }
function install(c: Caller, f: () => number) { c.run = f }
const bag: any = { nothing: 0 };
install(bag, () => 41 + 1);
console.log(bag.run());

function push(list: Leaf[], l: Leaf) { list.push(l) }
const fake: any = { push(x: any) { x.kind = "pushed" } };
const second = new Leaf();
push(fake, second);
console.log(read(second), typeof second.kind);

interface Clock { read(): number; label: string }
function use(c: Clock): string { return c.read() + " " + c.label }
const raw: any = {};
raw.read = () => 1.5;
raw.label = "by name";
console.log(use(raw));
class Other { n = 2; read() { return this.n * 2 } get label() { return "getter" } }
const lie: any = new Other();
console.log(use(lie));
function fill(c: Clock) { c.label = "stored" }
const bare: any = { z: 1 };
fill(bare);
console.log(bare.label, Object.keys(bare).join());
//// what-arithmetic-makes-of-an-impostor-is-stored-in-places-of-type-number.ts
function show(value: unknown): string {
  if (typeof value === "bigint") return "bigint " + value + "n";
  if (typeof value === "number" && Object.is(value, -0)) return "number -0";
  if (typeof value === "object" && value !== null) return "object";
  return typeof value + " " + String(value);
}

function attempt(run: () => unknown): string {
  try {
    return show(run());
  } catch (error) {
    return "threw " + (error as Error).constructor.name;
  }
}

let lastProduct: number = 0;

class Ledger {
  static lastNegated: number = 0;
  sum: number = 0;
  entries: number[] = [];
}

function squared(side: number): number {
  return side * side;
}

function doubled(side: number): number {
  return side + side;
}

function negated(side: number): number {
  return -side;
}

function next(side: number): number {
  side++;
  return side;
}

function halved(side: number): number {
  return side / 2;
}

function storeEverywhere(ledger: Ledger, side: number): () => number {
  let captured: number = 0;
  lastProduct = side * side;
  Ledger.lastNegated = -side;
  ledger.sum = side + side;
  ledger.entries.push(side - side);
  captured = side * 3;
  return () => captured;
}

function useAsNumbers(ledger: Ledger, read: () => number): number {
  return lastProduct + Ledger.lastNegated + ledger.sum + ledger.entries[ledger.entries.length - 1] + read();
}

const warmLedger = new Ledger();
let warm = 0;
for (let i = 0; i < 2000; i++) {
  warm += squared(i) + doubled(i) + negated(i) + next(i) + halved(i);
  warm += storeEverywhere(warmLedger, i)();
}
console.log(
  "2000 honest rounds:",
  warm,
  useAsNumbers(warmLedger, () => 1),
  warmLedger.entries.length,
);

const changing = {
  turn: 0,
  valueOf() {
    return [1, 2n, "3", 4n][this.turn++ & 3];
  },
};

const impostors: [string, unknown][] = [
  ["a bigint", 3n],
  ["a string of digits", "4"],
  ["a string of letters", "ab"],
  ["null", null],
  ["undefined", undefined],
  ["true", true],
  ["a list of one number", [6]],
  ["a wrapped number", new Number(7)],
  ["an object whose valueOf answers a number", { valueOf: () => 8 }],
  ["an object whose valueOf answers a bigint", { valueOf: () => 9n }],
  ["an object whose valueOf answers a string", { valueOf: () => "10" }],
  ["an object whose valueOf answers another kind each time", changing],
  ["an object with Symbol.toPrimitive that answers a bigint", { [Symbol.toPrimitive]: () => 11n }],
  [
    "an object with Symbol.toPrimitive that answers by the hint",
    { [Symbol.toPrimitive]: (hint: string) => (hint === "number" ? 12n : "12") },
  ],
  [
    "an object whose valueOf throws",
    {
      valueOf() {
        throw new RangeError("no");
      },
    },
  ],
  ["a symbol", Symbol("s")],
];

for (const [name, impostor] of impostors) {
  const side = impostor as number;
  console.log(
    name + ":",
    "squared",
    attempt(() => squared(side)),
    "| doubled",
    attempt(() => doubled(side)),
    "| negated",
    attempt(() => negated(side)),
    "| next",
    attempt(() => next(side)),
    "| halved",
    attempt(() => halved(side)),
  );
  const ledger = new Ledger();
  lastProduct = 0;
  Ledger.lastNegated = 0;
  let read: () => number = () => 0;
  const stored = attempt(() => {
    read = storeEverywhere(ledger, side);
    return true;
  });
  console.log(
    name + ", stored " + stored + ":",
    "variable",
    show(lastProduct),
    "| static",
    show(Ledger.lastNegated),
    "| field",
    show(ledger.sum),
    "| element",
    show(ledger.entries[0]),
    "| captured",
    show(read()),
    "| used",
    attempt(() => useAsNumbers(ledger, read)),
  );
}

const again = new Ledger();
console.log(
  "honest again:",
  squared(5),
  doubled(5),
  negated(5),
  next(5),
  halved(5),
  storeEverywhere(again, 5)(),
  useAsNumbers(again, () => 1),
);
//// what-object-create-made-is-held-as-an-instance-and-read-in-a-function.ts
// Object.create(Safe.prototype) makes what TypeScript takes for a Safe, and no constructor of Safe has made it. Where the compiler has seen that nothing else arrives at the variable, the code behind the read goes on with that object.
class Safe {}
const bare: Safe = Object.create(Safe.prototype);
function run(): number { return (bare as any).code; }
console.log("got", run());
//// what-object-create-made-is-held-as-an-instance-stored-to-and-read-in-a-function.ts
// As its neighbor; the property is stored first, so nothing about the program is out of the ordinary at run time.
class Safe {}
const bare: Safe = Object.create(Safe.prototype);
(bare as any).code = 5;
function attempt(run: () => number): number { return run(); }
console.log("got", attempt(() => (bare as any).code));
