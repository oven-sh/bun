const tools = { total, sum, code, half };
const list = [half, (n: number) => n + 1];
const byName = new Map<string, (n: number) => number>([["half", half]]);

class Kit {
  scale = 2;
  half(n: number): number {
    return (n / 2) * this.scale;
  }
}

function honest(label: string): void {
