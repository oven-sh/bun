  "new Proxy({ x: 1, y: 2 }, { get(t, k) { note('get:' + String(k)); return t[k]; }, ownKeys(t) { note('ownKeys'); return Reflect.ownKeys(t); }, getOwnPropertyDescriptor(t, k) { note('describe:' + String(k)); return Reflect.getOwnPropertyDescriptor(t, k); } })",
