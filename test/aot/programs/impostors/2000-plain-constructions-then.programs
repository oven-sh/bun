//// a-closure-handed-to-a-built-in-reassigns-the-variable-between-two-uses.js
"use strict";

const log = [];

////= show-24

function pushes(a, other) {
  const results = [];
  for (let round = 0; round < 3; round++) {
    a.push(1);
    results.push(a.length);
    if (round === 0) [other].forEach(value => {
      a = value;
    });
  }
  return results;
}

function iterates(a, other) {
  const results = [];
  for (let round = 0; round < 3; round++) {
    const seen = [];
    for (const x of a) seen.push(x);
    results.push(seen);
    if (round === 0) [other].forEach(value => {
      a = value;
    });
  }
  return results;
}

function readsCharCode(s, other) {
  const results = [];
  for (let round = 0; round < 3; round++) {
    results.push(s.charCodeAt(0));
    if (round === 0) [other].forEach(value => {
      s = value;
    });
  }
  return results;
}

function truncates(n, other) {
  const results = [];
  for (let round = 0; round < 3; round++) {
    results.push(n | 0);
    if (round === 0) [other].forEach(value => {
      n = value;
    });
  }
  return results;
}

function addsOne(n, other) {
  const results = [];
  for (let round = 0; round < 3; round++) {
    results.push(n + 1);
    if (round === 0) [other].forEach(value => {
      n = value;
    });
  }
  return results;
}

function calls(f, other) {
  const results = [];
  for (let round = 0; round < 3; round++) {
    results.push(f(1));
    if (round === 0) [other].forEach(value => {
      f = value;
    });
  }
  return results;
}

function addsMembers(o, other) {
  const results = [];
  for (let round = 0; round < 3; round++) {
    results.push(o.x + o.y);
    if (round === 0) [other].forEach(value => {
      o = value;
    });
  }
  return results;
}

function storesMember(o, other) {
  const results = [];
  for (let round = 0; round < 3; round++) {
    o.x = 1;
    results.push(o);
    if (round === 0) [other].forEach(value => {
