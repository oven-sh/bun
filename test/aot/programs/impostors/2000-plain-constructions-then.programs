//// a-field-of-integers-gets-the-most-negative-integers-in-plain-sight.js
function show(value) {
  return Object.is(value, -0) ? "-0" : typeof value + " " + String(value);
}

class Gauge {
  constructor(level) {
    this.level = level | 0;
    this.unit = 1;
  }
}

function OldGauge(level) {
  this.level = level | 0;
  this.unit = 1;
}

function literalGauge(level) {
  return { level: level | 0, unit: 1 };
}

////= lines-7	levelOf	gauge	gauge.level

function levelOrText(gauge) {
  return gauge.level ?? "nullish";
}

////= lines-183	isUndefined	gauge	gauge.level	undefined

////= lines-183	isNull	gauge	gauge.level	null

////= lines-80	plusUnit	gauge	gauge.level	gauge.unit

function setLevel(gauge, level) {
  gauge.level = level | 0;
}

function setInverted(gauge, level) {
  gauge.level = ~level;
}

function setShifted(gauge, level) {
  gauge.level = level << 1;
}

function report(label, gauge) {
  console.log(
    label + ":",
    show(levelOf(gauge)),
    "|",
    show(levelOrText(gauge)),
    "| undefined",
    isUndefined(gauge),
    "| null",
    isNull(gauge),
    "| plus",
    show(plusUnit(gauge)),
    "| in",
    "level" in gauge,
    "| keys",
    Object.keys(gauge).join(),
    "| json",
    JSON.stringify(gauge),
    "| copy",
    show({ ...gauge }.level),
  );
}

const makers = {
  class: level => new Gauge(level),
  "constructor function": level => new OldGauge(level),
  literal: literalGauge,
};
const levels = [
  0, 5, 2147483647, -2147483641, -2147483642, -2147483643, -2147483644, -2147483645, -2147483646, -2147483647,
  -2147483648,
];

for (const [made, make] of Object.entries(makers)) {
  let warm = 0;
  for (let i = 0; i < 2000; i++) {
    const gauge = make(i);
    setLevel(gauge, i + 1);
    warm += levelOf(gauge) + plusUnit(gauge);
  }
  console.log(made, "2000 honest gauges:", warm);

  for (const level of levels) {
    report(made + " made with " + level, make(level));

    const stored = make(1);
    setLevel(stored, level);
    report(made + " stored " + level, stored);

    const inverted = make(1);
    setInverted(inverted, ~level);
    report(made + " stored ~~" + level, inverted);

    const back = make(level);
    setLevel(back, 3);
    report(made + " made with " + level + " and then stored 3", back);
  }

  const shifted = make(1);
  setShifted(shifted, 1073741825);
  report(made + " stored 1073741825 << 1", shifted);
  setShifted(shifted, -1073741823);
  report(made + " stored -1073741823 << 1", shifted);
}
//// a-field-of-small-integers-is-counted-past-the-ends-under-a-computed-name.js
function show(value) {
  return Object.is(value, -0) ? "-0" : typeof value + " " + String(value);
}

class Gauge {
  constructor(level) {
    this.level = level & 1023;
    this.unit = 1;
  }
}

////= lines-7	levelOf	gauge	gauge.level

////= lines-80	twiceTheLevel	gauge	gauge.level	gauge.level

////= lines-224	levelAsInteger	gauge	gauge.level

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const gauge = new Gauge(i);
  warm += levelOf(gauge) + twiceTheLevel(gauge) + levelAsInteger(gauge);
}
console.log("2000 honest gauges:", warm);

const name = JSON.parse('"level"');

const steps = {
  "++": gauge => gauge[name]++,
  "--": gauge => gauge[name]--,
  "+= 1": gauge => (gauge[name] += 1),
  "-= 1": gauge => (gauge[name] -= 1),
  "*= 2": gauge => (gauge[name] *= 2),
  "*= -1": gauge => (gauge[name] *= -1),
  "/= 2": gauge => (gauge[name] /= 2),
  "%= -1": gauge => (gauge[name] %= -1),
  "**= 2": gauge => (gauge[name] **= 2),
  "<<= 1": gauge => (gauge[name] <<= 1),
  ">>>= 0": gauge => (gauge[name] >>>= 0),
  "|= 0": gauge => (gauge[name] |= 0),
  "&&= 1.5": gauge => (gauge[name] &&= 1.5),
  "||= 'x'": gauge => (gauge[name] ||= "x"),
  "??= 2": gauge => (gauge[name] ??= 2),
  "+= ''": gauge => (gauge[name] += ""),
};

const starts = [
  0, 1, -1, 1023, 2147483646, 2147483647, -2147483642, -2147483643, -2147483644, -2147483645, -2147483646, -2147483647,
  -2147483648,
];

for (const [step, run] of Object.entries(steps)) {
  for (const start of starts) {
    const gauge = new Gauge(0);
    gauge[name] = start;
    const seen = [show(levelOf(gauge))];
    for (let turn = 0; turn < 3; turn++) {
      const answer = run(gauge);
      seen.push(
        show(answer) +
          " -> " +
          show(levelOf(gauge)) +
          " / " +
          show(twiceTheLevel(gauge)) +
          " / " +
          show(levelAsInteger(gauge)),
      );
    }
    console.log(step, "from", start + ":", seen.join(" ; "));
  }
}

const back = new Gauge(7);
console.log("honest again:", show(levelOf(back)), show(twiceTheLevel(back)), show(levelAsInteger(back)));
