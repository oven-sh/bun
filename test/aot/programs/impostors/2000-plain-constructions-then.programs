function oldStyleChild(Parent) {
  function Child(level) {
    Parent.call(this, level);
  }
  Child.prototype = Object.create(Parent.prototype, {
    level: {
      get() { log.push("get level"); return "old accessor"; },
      set(value) { log.push("set level " + value); },
    },
  });
  return Child;
}

