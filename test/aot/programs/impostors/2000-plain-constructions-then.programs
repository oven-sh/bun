function pushes(a, other) {
  const swap = () => {
    a = other;
  };
  const results = [];
  for (let round = 0; round < 3; round++) {
    a.push(1);
    results.push(a.length);
    if (round === 0) swap();
  }
  return results;
}

function iterates(a, other) {
  const swap = () => {
    a = other;
  };
  const results = [];
  for (let round = 0; round < 3; round++) {
    const seen = [];
    for (const x of a) seen.push(x);
    results.push(seen);
    if (round === 0) swap();
  }
  return results;
}

function readsCharCode(s, other) {
  const swap = () => {
    s = other;
  };
  const results = [];
  for (let round = 0; round < 3; round++) {
    results.push(s.charCodeAt(0));
    if (round === 0) swap();
  }
  return results;
}

////= lines-305	truncates	|	0

////= lines-305	addsOne	+	1

function calls(f, other) {
  const swap = () => {
    f = other;
  };
  const results = [];
  for (let round = 0; round < 3; round++) {
    results.push(f(1));
    if (round === 0) swap();
  }
  return results;
}

function addsMembers(o, other) {
  const swap = () => {
    o = other;
  };
  const results = [];
  for (let round = 0; round < 3; round++) {
    results.push(o.x + o.y);
    if (round === 0) swap();
  }
  return results;
}

function storesMember(o, other) {
  const swap = () => {
    o = other;
  };
  const results = [];
  for (let round = 0; round < 3; round++) {
    o.x = 1;
    results.push(o);
    if (round === 0) swap();
  }
  return results;
}

