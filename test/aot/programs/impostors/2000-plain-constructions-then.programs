//// a-catch-reaction-gets-the-value.js
"use strict";

const log = [];

////= show-28

function pushes(given) {
  return Promise.reject(given).catch(a => {
    a.push(1);
    return [a.length];
  });
}

////= iterates-8	reject	catch

function readsCharCode(given) {
  return Promise.reject(given).catch(s => {
    return [s.charCodeAt(0)];
  });
}

function truncates(given) {
  return Promise.reject(given).catch(n => {
    return [n | 0];
  });
}

function addsOne(given) {
  return Promise.reject(given).catch(n => {
    return [n + 1];
  });
}

function calls(given) {
  return Promise.reject(given).catch(f => {
    return [f(1)];
  });
}

function addsMembers(given) {
  return Promise.reject(given).catch(o => {
    return [o.x + o.y];
  });
}

function storesMember(given) {
  return Promise.reject(given).catch(o => {
    o.x = 1;
    return [o];
  });
}

