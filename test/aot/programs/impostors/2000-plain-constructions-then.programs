//// a-callable-proxy-is-used-like-a-function.js
////= show-5

const log = [];
const atFirst = new Map();
let same = 0;

////= attempt-50

function traps(name) {
  const handler = {};
  for (const trap of ["apply", "construct", "get", "has", "getPrototypeOf", "getOwnPropertyDescriptor", "ownKeys"]) {
    handler[trap] = (...list) => {
      log.push(name + trap + (trap === "get" || trap === "has" || trap === "getOwnPropertyDescriptor" ? "(" + String(list[1]) + ")" : ""));
      return Reflect[trap](...list);
    };
  }
  return handler;
}

const impostors = [
  ["a proxy without traps", () => new Proxy(plus, {})],
  ["a proxy that logs its traps", () => new Proxy(plus, traps(""))],
  ["a proxy that answers by itself", () => new Proxy(plus, { apply: (target, self, list) => [typeof self, String(self), list], construct: (target, list, newTarget) => ({ built: list }) })],
  ["a proxy whose construct trap answers a number", () => new Proxy(plus, { construct: () => 5 })],
  ["a proxy whose traps throw", () => new Proxy(plus, { apply() { throw new RangeError("no"); }, construct() { throw new EvalError("no"); }, get() { throw new URIError("no"); }, getPrototypeOf() { throw new SyntaxError("no"); } })],
  ["a proxy of an arrow function", () => new Proxy((a, b) => a * b, { construct: () => ({}) })],
  ["a proxy of a class", () => new Proxy(class { constructor(a) { this.a = a; } }, {})],
  ["a proxy of a proxy", () => new Proxy(new Proxy(plus, traps("inner.")), traps("outer."))],
  ["a proxy of a bound function", () => new Proxy(plus.bind(null, 10), traps(""))],
  ["a revoked proxy", () => { const { proxy, revoke } = Proxy.revocable(plus, {}); revoke(); return proxy; }],
  ["a proxy of an object with an apply trap", () => new Proxy({}, { apply: () => "never" })],
  ["a proxy that hands out another call", () => new Proxy(plus, { get: (target, key) => (key === "call" || key === "apply" || key === "bind" ? () => () => "from the trap" : target[key]) })],
];

////= meetTheImpostors

meetTheImpostors();
honest("after the impostors came first");
////= for-2
meetTheImpostors();
console.log("the same after 2000 honest calls:", same);
honest("at the end");
