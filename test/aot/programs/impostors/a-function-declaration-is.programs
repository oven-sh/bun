function pushes(given) {
  return new Promise((resolve, reject) => {
    process.once("uncaughtException", a => {
      try {
        a.push(1);
        resolve([a.length]);
      } catch (error) {
        reject(error);
      }
    });
    setTimeout(() => {
      throw given;
    }, 0);
  });
}

function iterates(given) {
  return new Promise((resolve, reject) => {
    process.once("uncaughtException", a => {
      try {
        const seen = [];
        for (const x of a) seen.push(x);
        resolve([seen]);
      } catch (error) {
        reject(error);
      }
    });
    setTimeout(() => {
      throw given;
    }, 0);
  });
}

function readsCharCode(given) {
