////: chainOnAMember
function chainOnAMember(holder) {
  if (holder.kind === "alpha") return 1;
  if (holder.kind === "beta") return 2;
  if (holder.kind === "gamma") return 3;
  if (holder.kind === "delta") return 4;
  return 0;
}
////: chainOnTypeof
function chainOnTypeof(value) {
  const kind = typeof value;
  if (kind === "string") return "s" + value.length;
  if (kind === "number") return "n";
  if (kind === "object") return "o";
  if (kind === "undefined") return "u";
  if (kind === "symbol") return "y";
  if (kind === "bigint") return "b";
  if (kind === "boolean") return "t";
  return "f";
}
////: check
function check(label, change) {
  let config = { name: "ada", port: 80 };
  let outcome = "";
  try {
    config = change(config) || config;
  } catch (error) {
    outcome = " (the store threw " + error.constructor.name + ")";
  }
  const parts = [];
  for (const use of [sizeOf, shout, greeting, isAda]) {
    try {
      parts.push(show(use(config)));
    } catch (error) {
      parts.push("threw " + error.constructor.name);
    }
  }
  console.log(label + outcome + " -> " + parts.join(" | ") + " | keys " + Object.keys(config).join(","));
}
