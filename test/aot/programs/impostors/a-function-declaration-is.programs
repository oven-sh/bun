function pushes(a, turns) {
  const results = [];
  for (let i = 0; i < turns; i++) {
    a.push(1);
    results.push(a.length);
  }
  return results;
}

function iterates(a, turns) {
  const results = [];
  for (let i = 0; i < turns; i++) {
    const seen = [];
    for (const x of a) seen.push(x);
    results.push(seen);
  }
  return results;
}

function readsCharCode(s, turns) {
  const results = [];
  for (let i = 0; i < turns; i++) {
    results.push(s.charCodeAt(0));
  }
  return results;
}

function truncates(n, turns) {
  const results = [];
  for (let i = 0; i < turns; i++) {
    results.push(n | 0);
  }
  return results;
}

function addsOne(n, turns) {
  const results = [];
  for (let i = 0; i < turns; i++) {
    results.push(n + 1);
  }
  return results;
}

function calls(f, turns) {
  const results = [];
  for (let i = 0; i < turns; i++) {
    results.push(f(1));
  }
  return results;
}

function addsMembers(o, turns) {
  const results = [];
  for (let i = 0; i < turns; i++) {
    results.push(o.x + o.y);
  }
  return results;
}

function storesMember(o, turns) {
  const results = [];
  for (let i = 0; i < turns; i++) {
    o.x = 1;
    results.push(o);
  }
  return results;
}

