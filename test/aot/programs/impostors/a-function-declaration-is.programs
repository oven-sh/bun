//// a-look-alike-made-in-one-module-is-used-as-a-text-in-another/honest-callers.js
import shorten, { hash, initials, quoted, isBeforeM, lookUp } from "./text-tools.js";

export function runHonestCallers(rounds) {
  let total = 0;
  for (let i = 0; i < rounds; i++) {
    total += hash("hello") + initials("ada lovelace").length + quoted("x").length + shorten("hello world").length + lookUp({ a: 1 }, "a");
    if (isBeforeM("a")) total++;
  }
  return total;
}
//// a-look-alike-made-in-one-module-is-used-as-a-text-in-another/look-alikes.js
export const lookAlike = {
  length: 2,
  charCodeAt(index) {
    return index + 1;
  },
  split() {
    return [["first"], { 0: "second" }];
  },
  slice() {
    return "sliced";
  },
  toString() {
    return "look alike";
  },
};

export const wrapped = new String("hello world");
export const list = ["hello", "world", "and", "more", "and", "more"];
export const number = 1234567;
export let changing = "a text at first";

export function change() {
  changing = ["now", "a", "list"];
}
