function pushes(a, results, clock) {
  for (let i = 0; i < 6; i++) {
    if (clock.now > 100) break;
    results.push(a.push(i), a.length);
  }
  return "done";
}

function iterates(a, results, clock) {
  for (let i = 0; i < 6; i++) {
    if (clock.now > 100) break;
    for (const x of a) results.push(x);
  }
  return "done";
}

function readsCharCode(s, results, clock) {
  for (let i = 0; i < 6; i++) {
    if (clock.now > 100) break;
    results.push(s.charCodeAt(0));
  }
  return "done";
}

function truncates(n, results, clock) {
  for (let i = 0; i < 6; i++) {
    if (clock.now > 100) break;
    results.push(n | 0);
  }
  return "done";
}

function addsOne(n, results, clock) {
  for (let i = 0; i < 6; i++) {
    if (clock.now > 100) break;
    results.push(n + 1);
  }
  return "done";
}

function callsThroughCall(f, results, clock) {
  for (let i = 0; i < 6; i++) {
    if (clock.now > 100) break;
    results.push(f.call(undefined, i));
  }
  return "done";
}

function addsMembers(o, results, clock) {
  for (let i = 0; i < 6; i++) {
    if (clock.now > 100) break;
    results.push(o.x + o.y);
  }
  return "done";
}

