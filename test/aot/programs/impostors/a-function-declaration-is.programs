////: alternating
function alternating(first, second) {
  let reads = 0;
  const next = () => (reads++ % 2 ? second : first);
  return {
    get a() {
      return next();
    },
    get s() {
      return next();
    },
    get n() {
      return next();
    },
    get f() {
      return next();
    },
    get o() {
      return next();
    },
  };
}
