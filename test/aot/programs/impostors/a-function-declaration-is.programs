const impostors = [
  ["made by new Function", () => new Function("a", "b", "return [typeof this, a, b]")],
  ["made by Function without new", () => Function("a", "b", "'use strict'; return [typeof this, a, b]")],
  ["made by eval", () => eval("(function (a, b) { return [typeof this, a, b]; })")],
  ["made by indirect eval", () => (0, eval)("(function (a, b) { return [typeof this, a, b]; })")],
  ["an arrow function made by eval", () => eval("(a, b) => [typeof this, a, b]")],
  ["a class made by eval", () => eval("(class { constructor(a) { this.a = a; } })")],
  ["an instance of a subclass of Function", () => new Callable()],
  ["a function of another realm", () => vm.runInNewContext("(function (a, b) { return [typeof this, a, b]; })")],
  ["a class of another realm", () => vm.runInNewContext("(class { constructor(a) { this.a = a; } })")],
  ["the Object of another realm", () => vm.runInNewContext("Object")],
  ["a bound function of another realm", () => vm.runInNewContext("(function (a, b) { return [typeof this, a, b]; }).bind(null, 0)")],
  ["made by the constructor of generator functions", () => new (Object.getPrototypeOf(function* () {}).constructor)("a", "yield a")],
  ["made by the constructor of async functions", () => new (Object.getPrototypeOf(async function () {}).constructor)("a", "return a")],
];

