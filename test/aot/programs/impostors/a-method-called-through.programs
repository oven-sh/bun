function attempt(label, run) {
  log.length = 0;
  let text;
  try {
    text = show(run());
  } catch (error) {
    text = "threw " + error.constructor.name;
  }
  console.log(label + " -> " + text + (log.length ? " | " + log.join(", ") : ""));
}
