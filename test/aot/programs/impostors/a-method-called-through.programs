  "'=empty&&=again'",
  "new String('?a=1')",
  "['?', 'a=1']",
  "['a=1&b=2']",
  "{ 0: '?', slice() { return 'x=from+slice'; } }",
  "{ split() { return ['k=v', 5, null]; } }",
  "{ split() { return ['k=v', { indexOf() { return -1; }, replace() { return 'odd'; } }]; } }",
  "{ toString() { return 'from=toString'; } }",
