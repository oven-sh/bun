////= show-26

class Scanner {
  constructor(source) {
    this.source = source;
    this.position = 0;
  }

  get done() {
    return this.position >= this.source.length;
  }

  peek() {
    return this.source[this.position];
  }

  next() {
    return this.source.charCodeAt(this.position++);
  }

  skipSpaces() {
    while (!this.done && this.source[this.position] === " ") this.position++;
  }

  word() {
    const start = this.position;
    while (!this.done && this.position < 40 && this.source[this.position] !== " ") this.position++;
    return this.source.slice(start, this.position);
  }

  words() {
    const found = [];
    for (let guard = 0; guard < 10 && !this.done; guard++) {
      this.skipSpaces();
      if (this.done) break;
      found.push(this.word());
    }
    return found;
  }
}

let total = 0;
for (let i = 0; i < 2000; i++) {
  const scanner = new Scanner("let x = 1");
  total += scanner.words().length + new Scanner("ab").next() + new Scanner("ab").peek().length;
}
console.log("2000 honest rounds", total);

const sources = [
  "'let x = 1'",
  "''",
  "'  '",
  "'l\\u00e9t \\u4e16 = \\ud83d\\ude00'",
  "'let' + ' ' + 'y'",
  "new String('let x = 1')",
  "['let', ' ', 'x', ' ', '=']",
  "[' ', ' ']",
  "Buffer.from('let x')",
  "new Uint8Array([32, 32, 1])",
  "{ length: 3, 0: 'a', 1: ' ', 2: 'b', slice(from, to) { return 'slice ' + from + ' ' + to; }, charCodeAt(i) { return 'code ' + i; } }",
  "{ length: 3 }",
  "{ get length() { return 2; }, get 0() { return ' '; }, get 1() { return 'z'; }, slice: Array.prototype.slice }",
  "12345",
  "null",
  "undefined",
  "(function () { return arguments; })('a', ' ', 'b')",
];

for (const text of sources) {
  attempt("words of " + text, () => new Scanner(make(text)).words());
  attempt("peek of " + text, () => new Scanner(make(text)).peek());
  attempt("next of " + text, () => new Scanner(make(text)).next());
  attempt("done of " + text, () => new Scanner(make(text)).done);
}

attempt("the source is replaced halfway", () => {
  const scanner = new Scanner("one two three");
  const first = scanner.word();
  scanner.source = ["o", "n", "e", " ", "list", " ", "now"];
  return [first, scanner.words()];
});
attempt("the source is replaced halfway by a computed name", () => {
  const scanner = new Scanner("one two three");
  const first = scanner.word();
  scanner[make("'source'")] = new String("one wrapped now");
  return [first, scanner.words()];
});
attempt("the position is a text", () => {
  const scanner = new Scanner("abc");
  scanner.position = "1";
  return [scanner.peek(), scanner.next(), scanner.position, scanner.peek(), scanner.done];
});
attempt("the position is a fraction", () => {
  const scanner = new Scanner("abc");
  scanner.position = 0.5;
  return [scanner.peek(), scanner.next(), scanner.position, scanner.word()];
});
attempt("the position is negative", () => {
  const scanner = new Scanner("abc");
  scanner.position = -1;
  return [scanner.peek(), scanner.next(), scanner.position, scanner.peek()];
});
attempt("a subclass overrides peek and done", () => {
  class Odd extends Scanner {
    get done() {
      return this.position >= 2;
    }
  }
  return new Odd("abcdef ghi").words();
});
attempt("methods borrowed for a plain object", () => Scanner.prototype.word.call({ source: "ab cd", position: 0, done: false }));
attempt("honest again", () => new Scanner("let x = 1").words());

console.log("bytes made in plain sight", Buffer.from("he").length);
//// a-setter-appears-between-two-stores-of-one-constructor.cjs
const log = [];

////= show-9

function ByMember(first, holder) {
  this.first = first;
  this.second = holder.value;
  this.third = 3;
}

function ByArithmetic(first, number) {
  this.first = first;
  this.second = number * 2;
  this.third = 3;
}

function ByText(first, text) {
  this.first = first;
  this.second = "" + text;
  this.third = 3;
}

function ByCall(first, callback) {
  this.first = first;
  this.second = callback();
  this.third = 3;
}

function ByComparison(first, other) {
  this.first = first;
  this.second = other < 5;
  this.third = 3;
}

function ByKey(first, key) {
  this.first = first;
  this.second = { value: "found" }[key];
  this.third = 3;
}

class ClassByMember {
  constructor(first, holder) {
    this.first = first;
    this.second = holder.value;
    this.third = 3;
  }
}

class ClassByArithmetic {
  constructor(first, number) {
    this.first = first;
    this.second = number * 2;
    this.third = 3;
  }
}

class ClassWithFields {
  first = 1;
  second = ClassWithFields.hook();
  third = 3;
  static hook() {
    return 2;
  }
}

function plant(prototype, name) {
  Object.defineProperty(prototype, name, {
    get() {
      return "from the planted getter";
    },
    set(value) {
      log.push("planted setter of " + name + " got " + String(value));
    },
    configurable: true,
  });
}

const makers = [
  [ByMember, strike => ({ get value() { strike(); return 2; } }), { value: 2 }],
  [ByArithmetic, strike => ({ valueOf() { strike(); return 1; } }), 1],
  [ByText, strike => ({ toString() { strike(); return "2"; } }), "2"],
  [ByCall, strike => () => (strike(), 2), () => 2],
  [ByComparison, strike => ({ valueOf() { strike(); return 1; } }), 1],
  [ByKey, strike => ({ toString() { strike(); return "value"; } }), "value"],
  [ClassByMember, strike => ({ get value() { strike(); return 2; } }), { value: 2 }],
  [ClassByArithmetic, strike => ({ valueOf() { strike(); return 1; } }), 1],
];

for (const [Maker, arm, honest] of makers) {
  for (let i = 0; i < 2000; i++) new Maker(1, honest);
  console.log(Maker.name + " | honest -> " + show(new Maker(1, honest)));
  for (const name of ["first", "second", "third"]) {
    const made = new Maker(1, arm(() => plant(Maker.prototype, name)));
    console.log(Maker.name + " | a setter for " + name + " is planted while second is computed -> " + show(made) + " | " + name + " reads " + show(made[name]) + " | log " + log.splice(0).join(", "));
    const next = new Maker(1, honest);
    console.log(Maker.name + " | the next honest construction -> " + show(next) + " | log " + log.splice(0).join(", "));
    delete Maker.prototype[name];
    console.log(Maker.name + " | after the setter was removed -> " + show(new Maker(1, honest)) + " | the struck one reads " + show(made[name]));
  }
  const frozen = [];
  try {
    frozen.push(show(new Maker(1, arm(function () { Object.defineProperty(Maker.prototype, "third", { value: "fixed", writable: false, configurable: true }); }))));
  } catch (error) {
    frozen.push("threw " + error.constructor.name);
  }
  delete Maker.prototype.third;
  console.log(Maker.name + " | a read-only third is planted while second is computed -> " + frozen[0]);
}

for (let i = 0; i < 2000; i++) new ClassWithFields();
console.log("ClassWithFields | honest -> " + show(new ClassWithFields()));
ClassWithFields.hook = function () {
  plant(ClassWithFields.prototype, "third");
  return 2;
};
console.log("ClassWithFields | a setter for third is planted by an initializer -> " + show(new ClassWithFields()) + " | log " + log.splice(0).join(", "));
delete ClassWithFields.prototype.third;
