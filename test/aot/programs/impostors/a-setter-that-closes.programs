////= show-24

function pushes(a, other) {
  const holder = {
    set value(value) {
      a = value;
    },
  };
  const results = [];
  for (let round = 0; round < 3; round++) {
    a.push(1);
    results.push(a.length);
    if (round === 0) holder.value = other;
  }
  return results;
}

function iterates(a, other) {
  const holder = {
    set value(value) {
      a = value;
    },
  };
  const results = [];
  for (let round = 0; round < 3; round++) {
    const seen = [];
    for (const x of a) seen.push(x);
    results.push(seen);
    if (round === 0) holder.value = other;
  }
  return results;
}

function readsCharCode(s, other) {
  const holder = {
    set value(value) {
      s = value;
    },
  };
  const results = [];
  for (let round = 0; round < 3; round++) {
    results.push(s.charCodeAt(0));
    if (round === 0) holder.value = other;
  }
  return results;
}

