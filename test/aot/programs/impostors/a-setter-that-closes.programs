      results.push(o.x);
    }
    return "done";
  }

  function pushesValueOf(results, step) {
    for (let i = 0; i < 6; i += step) {
      results.push(a.push(i), a.length);
    }
    return "done";
  }

  function iteratesValueOf(results, step) {
    for (let i = 0; i < 6; i += step) {
      for (const x of a) results.push(x);
