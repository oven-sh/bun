function store(table, key, value) {
  table[key] = value;
  return table;
}

////= lines-45	label	key	"key: "	key

function labelInATemplate(key) {
  return `key: ${key}`;
}

function labelByString(key) {
  return "key: " + String(key);
}

function readAndLabel(table, key) {
