function useLikeAnArray(text) {
  var array = eval(text);
  array?.push(123);
  array?.sort();
  return array?.filter(a => a);
}

function useLikeAnArrayWithoutChains(text) {
  var array = (0, eval)(text);
  array.push(123);
  array.sort();
  return array.filter(a => a);
}

