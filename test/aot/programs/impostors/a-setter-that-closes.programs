////: codesOfAWrappedText
function codesOfAWrappedText(text, callback) {
  const seen = [];
  for (let i = 0; i < text.length && i < 8; i++) {
    seen.push(text.charCodeAt(i));
    callback(text, i);
  }
  return seen;
}
////: codesWhileACallbackRuns
function codesWhileACallbackRuns(holder, callback) {
  const seen = [];
  for (let i = 0; i < holder.text.length && i < 8; i++) {
    seen.push(holder.text.charCodeAt(i));
    callback(holder, i);
  }
  return seen;
}
////: codesWhileTheVariableChanges
function codesWhileTheVariableChanges(replacement, when) {
  let text = "abcdef";
  const seen = [];
  for (let i = 0; i < text.length && i < 8; i++) {
    seen.push(text.charCodeAt(i));
    if (i === when) text = replacement;
  }
  return seen;
}
////: elementsPastTheEnd
function elementsPastTheEnd(text, callback) {
  const seen = [];
  for (let i = 0; i < 6; i++) {
    seen.push(text[i]);
    callback(i);
  }
  return seen;
}
////: elementsWhileTheVariableChanges
function elementsWhileTheVariableChanges(replacement, when) {
  let text = "abcdef";
  const seen = [];
  for (let i = 0; i < text.length && i < 8; i++) {
    seen.push(text[i]);
    if (i === when) text = replacement;
  }
  return seen;
}
////: fallsThrough
function fallsThrough(word) {
  const seen = [];
  switch (word) {
    case "a":
      seen.push("a");
    case "b":
      seen.push("b");
      break;
    default:
      seen.push("default");
    case "c":
      seen.push("c");
  }
  return seen.join("");
}
