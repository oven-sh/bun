function pushes(given) {
  return new Promise((resolve, reject) => {
    setTimeout(a => {
      try {
        a.push(1);
        resolve([a.length]);
      } catch (error) {
        reject(error);
      }
    }, 0, given);
  });
}

function iterates(given) {
  return new Promise((resolve, reject) => {
    setTimeout(a => {
      try {
        const seen = [];
        for (const x of a) seen.push(x);
        resolve([seen]);
      } catch (error) {
        reject(error);
      }
    }, 0, given);
  });
}

function readsCharCode(given) {
  return new Promise((resolve, reject) => {
    setTimeout(s => {
      try {
        resolve([s.charCodeAt(0)]);
      } catch (error) {
        reject(error);
      }
    }, 0, given);
  });
}

