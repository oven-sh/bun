function calls(f, other) {
  const holder = {
    set value(value) {
      f = value;
    },
  };
  const results = [];
  for (let round = 0; round < 3; round++) {
    results.push(f(1));
    if (round === 0) holder.value = other;
  }
  return results;
}

function addsMembers(o, other) {
  const holder = {
    set value(value) {
      o = value;
    },
  };
  const results = [];
  for (let round = 0; round < 3; round++) {
    results.push(o.x + o.y);
    if (round === 0) holder.value = other;
  }
  return results;
}

function storesMember(o, other) {
  const holder = {
    set value(value) {
      o = value;
    },
  };
  const results = [];
  for (let round = 0; round < 3; round++) {
    o.x = 1;
    results.push(o);
    if (round === 0) holder.value = other;
  }
  return results;
}

