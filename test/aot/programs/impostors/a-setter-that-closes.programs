////: kindOf
function kindOf(word) {
  switch (word) {
    case "if":
    case "else":
      return "branch";
    case "for":
    case "while":
      return "loop";
    case "function":
      return "function";
    case "":
      return "empty";
    case "1":
      return "the text one";
    case "null":
      return "the text null";
    case "undefined":
      return "the text undefined";
    case "été":
      return "summer";
    case "世界":
      return "world";
    case "\ud83d":
      return "half a pair";
    default:
      return "other";
  }
}
