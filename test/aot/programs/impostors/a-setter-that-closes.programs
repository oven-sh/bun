////: loopsOverClosuresMadeBeforeTheAssignment
function loopsOverClosuresMadeBeforeTheAssignment() {
  const reads = [];
  let n;
  for (let i = 0; i < 3; i++) reads.push(() => n + i);
  const before = reads.map(read => read());
  n = 7;
  const between = reads.map(read => read());
  n = "7";
  return [before, between, reads.map(read => read())];
}
////: mixedCases
function mixedCases(value) {
  switch (value) {
    case "1":
      return "text 1";
    case 1:
      return "number 1";
    case "0":
      return "text 0";
    case 0:
      return "number 0";
    case null:
      return "null";
    case "null":
      return "text null";
    case undefined:
      return "undefined";
    case true:
      return "true";
    case "true":
      return "text true";
    case 1n:
      return "BigInt 1";
    case NaN:
      return "never";
  }
  return "nothing";
}
