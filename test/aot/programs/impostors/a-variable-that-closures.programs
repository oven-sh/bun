class Wide {
  constructor(seed) {
    this.first = seed;
    this.second = seed + 0.5;
    this.third = "text " + seed;
    this.fourth = [seed, seed];
    this.fifth = { inner: seed };
    this.sixth = seed * 1000003;
    this.seventh = null;
    this.eighth = true;
    this.ninth = -seed;
    this.tenth = seed / 3;
    this.eleventh = "more " + seed;
    this.twelfth = [seed];
  }
}

