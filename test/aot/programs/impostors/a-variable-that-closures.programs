function pushes(a, other) {
  const scope = {};
  const results = [];
  with (scope) {
    for (let round = 0; round < 3; round++) {
      a.push(1);
      results.push(a.length);
      if (round === 0) scope.a = other;
    }
  }
  return results;
}

function iterates(a, other) {
  const scope = {};
  const results = [];
  with (scope) {
    for (let round = 0; round < 3; round++) {
      const seen = [];
      for (const x of a) seen.push(x);
      results.push(seen);
      if (round === 0) scope.a = other;
    }
  }
  return results;
}

function readsCharCode(s, other) {
  const scope = {};
  const results = [];
  with (scope) {
    for (let round = 0; round < 3; round++) {
      results.push(s.charCodeAt(0));
      if (round === 0) scope.s = other;
    }
  }
  return results;
}

////= lines-304	truncates	|	0

////= lines-304	addsOne	+	1

function calls(f, other) {
  const scope = {};
  const results = [];
  with (scope) {
    for (let round = 0; round < 3; round++) {
      results.push(f(1));
      if (round === 0) scope.f = other;
    }
  }
  return results;
}

function addsMembers(o, other) {
  const scope = {};
  const results = [];
  with (scope) {
    for (let round = 0; round < 3; round++) {
      results.push(o.x + o.y);
      if (round === 0) scope.o = other;
    }
  }
  return results;
}

function storesMember(o, other) {
  const scope = {};
  const results = [];
  with (scope) {
    for (let round = 0; round < 3; round++) {
      o.x = 1;
      results.push(o);
      if (round === 0) scope.o = other;
    }
  }
  return results;
}

