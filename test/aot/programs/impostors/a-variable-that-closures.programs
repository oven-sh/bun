    this.watts = watts;
    this.color = color;
  }
  bright() {
    return this.watts > 40;
  }
}
////: charactersAndCase
function charactersAndCase(text) {
  const seen = [];
  for (const character of text) seen.push(character);
  return [seen, text.toUpperCase()];
}
////: countSpaces
function countSpaces(text) {
  let count = 0;
  for (let i = 0; i < text.length; i++) {
    if (text[i] === " " || text.charCodeAt(i) === 9) count++;
  }
  return count;
}
////: fillLiteral
function fillLiteral(watts, color) {
  const lamp = { __proto__: shared };
  lamp.watts = watts;
  lamp.color = color;
  return lamp;
}
