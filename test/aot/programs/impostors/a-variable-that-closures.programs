//// a-variable-that-eval-declares-hides-an-outer-variable.cjs
const log = [];

////= show-30

const a = [5, 6];
const s = "abc";
const n = 7;
const f = x => x + 1;
const o = ({ x: 1, y: 2 });

function pushes(text, hides) {
  if (hides) eval("var a = " + text);
  a.push(1);
  return a.length;
}

////= lines-343	iterates(text, hides	if (hides) eval("var a = " + text)

function readsCharCode(text, hides) {
  if (hides) eval("var s = " + text);
  return s.charCodeAt(0);
}

function truncates(text, hides) {
  if (hides) eval("var n = " + text);
  return n | 0;
}

function addsOne(text, hides) {
  if (hides) eval("var n = " + text);
  return n + 1;
}

function calls(text, hides) {
  if (hides) eval("var f = " + text);
  return f(1);
}

function addsMembers(text, hides) {
  if (hides) eval("var o = " + text);
  return o.x + o.y;
}

function storesMember(text, hides) {
  if (hides) eval("var o = " + text);
  o.x = 1;
  return o;
}

////= table

function everyCase(round) {
  for (const [name, use, values] of table) {
    for (const [label, text] of [...values, values[0]]) attempt(round + " " + name + " " + label, () => use(text, label !== values[0][0]));
  }
}

console.log("strict:", (function () { return this === undefined; })());
everyCase("at first");
for (let i = 0; i < 200; i++) {
  pushes("[5, 6]", false);
  iterates("[5, 6]", false);
  readsCharCode("'abc'", false);
  truncates("7", false);
  addsOne("7", false);
  calls("(x => x + 1)", false);
  addsMembers("({ x: 1, y: 2 })", false);
  storesMember("({ x: 1, y: 2 })", false);
}
everyCase("after 200");
