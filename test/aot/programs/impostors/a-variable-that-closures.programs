////= show-24

function pushes(index) {
  const a = arguments[index];
  a.push(1);
  return a.length;
}

////= lines-343	iterates(index	const a = arguments[index]

function readsCharCode(index) {
  const s = arguments[index];
  return s.charCodeAt(0);
}

function truncates(index) {
  const n = arguments[index];
  return n | 0;
}

function addsOne(index) {
  const n = arguments[index];
  return n + 1;
}

function calls(index) {
  const f = arguments[index];
  return f(1);
}

function addsMembers(index) {
  const o = arguments[index];
  return o.x + o.y;
}

function storesMember(index) {
  const o = arguments[index];
  o.x = 1;
  return o;
}

