const uses = {
  spread: list => [...list],
  spreadBetween: list => ["before", ...list, "after"],
  spreadTwice: list => [...list, ...list],
  spreadIntoACall: list => ((...values) => values)(...list),
  pushAll(list) {
    const out = ["start"];
    out.push(...list);
    return out;
  },
  concat: list => [].concat(list),
  ownConcat: list => list.concat(["end"]),
  slice: list => list.slice(),
  from: list => Array.from(list),
  walk(list) {
    const seen = [];
    for (const value of list) {
      seen.push(value);
      if (seen.length === 10) break;
    }
    return seen;
  },
  byIndex(list) {
    const seen = [];
    for (let i = 0; i < list.length && i < 10; i++) seen.push(list[i]);
    return seen;
  },
  rest(list) {
    const [first, ...others] = list;
    return [first, others];
  },
  map: list => list.map(value => value),
  filter: list => list.filter(() => true),
  join: list => list.join(),
  json: list => JSON.stringify(list),
  toSorted: list => list.toSorted(),
  toReversed: list => list.toReversed(),
  flat: list => [list, list].flat(),
  values: list => Object.values(list),
  assign: list => Object.assign([], list),
  set: list => [...new Set(list)],
  apply: list => ((...values) => values).apply(null, list),
  includes: list => list.includes("pushed"),
  reduce: list => list.reduce((text, value) => text + "|" + value, ""),
};

const changes = {
  "pushes two": list => { list.push("pushed", "pushed too"); },
  "pops": list => { list.pop(); },
  "shrinks to two": list => { list.length = 2; },
  "empties": list => { list.length = 0; },
  "deletes the next": list => { delete list[2]; },
  "stores to the next": list => { list[2] = "stored"; },
  "stores a double to the next": list => { list[2] = 0.5; },
  "becomes a plain element": list => { Object.defineProperty(list, 1, { value: "plain", writable: true }); },
  "shifts": list => { list.shift(); },
  "reverses": list => { Object.defineProperty(list, 1, { value: "plain", writable: true }); list.reverse(); },
};

function make(change) {
  const list = [1, 2, 3, 4];
  let calls = 0;
  Object.defineProperty(list, 1, {
    get() {
      if (calls++ === 0) change(list);
      return "got";
    },
    enumerable: true,
    configurable: true,
  });
  return list;
}

for (const use in uses) for (let i = 0; i < 1000; i++) uses[use]([1, 2, 3, 4]);

for (const use in uses) for (const change in changes) attempt(use + ", the getter " + change, () => uses[use](make(changes[change])));
//// arrays/a-getter-answers-an-array-and-then-something-else.js
////= describe-11

////= lines-112	holderOf	items

function classHolderOf(answers) {
  let reads = 0;
  class Holder {
    get items() {
      return answers[reads++ % answers.length];
    }
    get reads() {
      return reads;
    }
  }
  return new Holder();
}

function proxyHolderOf(answers) {
  let reads = 0;
  return new Proxy({}, { get: (target, key) => (key === "reads" ? reads : answers[reads++ % answers.length]) });
}

const uses = {
  sum(holder) {
    let total = 0;
    for (let i = 0; i < holder.items.length; i++) total += holder.items[i];
    return total;
  },
  lastOne(holder) {
    return holder.items[holder.items.length - 1];
  },
  guarded(holder) {
    return Array.isArray(holder.items) ? holder.items.length : "no array";
  },
  guardedPush(holder) {
    if (holder.items && holder.items.push) return holder.items.push(9);
    return "no push";
  },
  truthyThenWalk(holder) {
    const seen = [];
    if (holder.items) for (const value of holder.items) seen.push(value);
    return seen;
  },
  lengthThenSpread(holder) {
    return holder.items.length > 0 ? [...holder.items] : "empty";
  },
  optional(holder) {
    return holder.items?.length + "/" + holder.items?.[0];
  },
  typeThenUse(holder) {
    return typeof holder.items === "object" ? holder.items.length : "no object";
  },
  twice(holder) {
    return holder.items === holder.items;
  },
};

const sequences = {
  "always one array": () => { const list = [1, 2, 3]; return [list]; },
  "an array, then a string": () => [[1, 2, 3], "abcd"],
  "a string, then an array": () => ["abcd", [1, 2, 3]],
  "an array, then an array-like": () => [[1, 2, 3], { length: 1, 0: "like" }],
  "an array, then null": () => [[1, 2, 3], null],
  "an array, then undefined": () => [[1, 2, 3], undefined],
  "an array, then a shorter array": () => [[1, 2, 3], [9]],
  "an array, then a longer array of doubles": () => [[1, 2, 3], [0.5, 1.5, 2.5, 3.5, 4.5]],
  "an array, then a Set": () => [[1, 2, 3], new Set([7])],
  "an array, then a typed array": () => [[1, 2, 3], new Uint8Array([7, 8])],
  "an array, then a number": () => [[1, 2, 3], 5],
};

const holders = { "an object literal": holderOf, "a class": classHolderOf, "a proxy": proxyHolderOf };

for (const use in uses) for (let i = 0; i < 1000; i++) uses[use]({ items: [1, 2, 3] });

for (const kind in holders) {
  for (const name in sequences) {
    for (const use in uses) {
      const holder = holders[kind](sequences[name]());
      let answer;
      try {
        answer = describe(uses[use](holder));
      } catch (error) {
        answer = "threw " + error.constructor.name;
      }
      console.log(kind + ", " + name + ", " + use + ": " + answer + " after " + holder.reads + " reads");
    }
  }
}
