module.exports = uses;
//// arrays/a-factor-that-runs-code-changes-the-array-inside-map-filter-and-reduce.js
////= describe-12

////= factorThat

function scaled(list, factor) {
  return list.map(value => value * factor);
}

function above(list, factor) {
  return list.filter(value => value > factor);
}

function weighted(list, factor) {
  return list.reduce((total, value) => total + value * factor, 0);
}

const uses = {
  "map": (list, change) => scaled(list, factorThat(change)),
  "filter": (list, change) => above(list, factorThat(change)),
  "reduce": (list, change) => weighted(list, factorThat(change)),
};

for (const use in uses) for (const kind in kinds) for (let i = 0; i < 700; i++) uses[use](kinds[kind](), () => {});

