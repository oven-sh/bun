  },
  sumWithACachedLength(list) {
    let total = 0;
    for (let i = 0, length = list.length; i < length; i++) total += list[i];
    return total;
  },
  renumber(list) {
    for (let i = 0; i < list.length; i++) list[i] = i;
    return "done";
  },
  increment(list) {
