//// arrays/a-factor-that-runs-code-changes-the-array-inside-a-loop.js
////= describe-12

////= factorThat

function scaledByIndex(list, factor) {
  const out = [];
  for (let i = 0; i < list.length && i < 10; i++) out.push(list[i] * factor);
  return out;
}

function scaledByIteration(list, factor) {
  const out = [];
  for (const value of list) {
    out.push(value * factor);
    if (out.length === 10) break;
  }
  return out;
}

function scaledInPlace(list, factor) {
  for (let i = 0; i < list.length && i < 10; i++) list[i] *= factor;
  return list.length;
}

const uses = {
  "by index": (list, change) => scaledByIndex(list, factorThat(change)),
  "by iteration": (list, change) => scaledByIteration(list, factorThat(change)),
  "in place": (list, change) => scaledInPlace(list, factorThat(change)),
};

for (const use in uses) for (const kind in kinds) for (let i = 0; i < 700; i++) uses[use](kinds[kind](), () => {});

