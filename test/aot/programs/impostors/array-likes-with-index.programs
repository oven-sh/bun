function withADefault(list, change) {
  list[1] = undefined;
  const [a, b = change(), c, d, e] = list;
  return [a, b, c, d, e];
}

function withARest(list, change) {
  list[1] = undefined;
  const [a, b = change(), ...rest] = list;
  return [a, b, rest.length > 10 ? rest.length : rest];
}

function assigned(list, change) {
  let a, b, c, d;
  list[0] = undefined;
  [a = change(), b, c, d] = list;
  return [a, b, c, d];
}

