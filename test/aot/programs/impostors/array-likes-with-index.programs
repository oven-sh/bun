function flattenedByConcat(rows) {
  return [].concat(...rows);
}

function flattenedBySpread(rows) {
  const out = [];
  for (const row of rows) out.push(...row);
  return out;
}

function padded(rows) {
  for (const row of rows) row.push(0);
