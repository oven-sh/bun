class Quiet extends Array {}

////= lines-85	Loud	Array	push	"the subclass's push"

////= lines-62	ownMembers	push	"its own push"

////= otherPrototype-5	push	"the other prototype's push"

////= makers

////= lines-25	pushOne	list	value	list.push

////= lines-219	pushThree	list	list.push	7	8	9

function pushInALoop(list, count) {
  let answer;
  for (let i = 0; i < count; i++) answer = list.push(i * 2);
  return answer;
}

const uses = {
  "one push": list => [pushOne(list, 9), list],
  "three at once": list => [pushThree(list), list],
  "a loop of pushes": list => [pushInALoop(list, 4), list],
};

const honest = {};

////= round

round("at first");
////= for-3
round("after 2000 arrays");

module.exports = uses;
//// arrays/push-sort-and-filter-run-in-a-row-on-values-that-are-not-plain-arrays.js
////= describe-14

class Quiet extends Array {}

////= Loud-6	push	"the subclass's push"	sort	"the subclass's sort"	filter	"the subclass's filter"

////= ownMembers-3	push	"its own push"	sort	"its own sort"	filter	"its own filter"

////= otherPrototype-6	push	"the other prototype's push"	sort	"the other prototype's sort"	filter	"the other prototype's filter"

////= makers

function chained(array) {
  array?.push(123);
  array?.sort();
  return array?.filter(a => a);
}

function unchained(array) {
  array.push(123);
  array.sort();
  return array.filter(a => a);
}

function inOneExpression(array) {
  return [array.push(0), array.sort((a, b) => a - b) === array, array.filter(a => a).length];
}

const uses = {
  "with chains": list => [chained(list), list],
  "without chains": list => [unchained(list), list],
  "in one expression": list => inOneExpression(list),
};

const honest = {};

////= round

round("at first");
////= for-3
round("after 2000 arrays");

module.exports = uses;
//// arrays/reads-whose-results-nobody-uses-still-happen.js
////= describe-11

const log = [];

const uses = {
  readLength(list) {
    list.length;
  },
  readFirst(list) {
    list[0];
  },
  readAll(list) {
    for (let i = 0; i < list.length; i++) list[i];
  },
  readAllWithACachedLength(list) {
    for (let i = 0, length = list.length; i < length; i++) list[i];
  },
  ask(list) {
    0 in list;
  },
  walk(list) {
    for (const value of list);
  },
  walkOnce(list) {
    for (const value of list) break;
  },
  spread(list) {
    [...list];
  },
  spreadIntoACall(list) {
    Math.max(...list);
  },
  takeNone(list) {
    const [] = list;
  },
  takeTwo(list) {
    const [a, b] = list;
  },
  takeByName(list) {
    const { length, 0: first } = list;
  },
  map(list) {
    list.map(value => value);
  },
  slice(list) {
    list.slice();
  },
  concat(list) {
    [].concat(list);
  },
  join(list) {
    list.join();
  },
  text(list) {
    `${list}`;
  },
  number(list) {
    +list;
  },
  compare(list) {
    list < 1;
  },
  indexOf(list) {
    list.indexOf(1);
  },
  readPush(list) {
    list.push;
  },
  from(list) {
    Array.from(list);
  },
  keys(list) {
    Object.keys(list);
  },
  unusedLocal(list) {
    const unused = list[1];
    const alsoUnused = list.length + 1;
  },
  deadBranch(list) {
    if (list.length < 0) log.push("never");
  },
  voided(list) {
    void list[0];
  },
  typeOf(list) {
    typeof list[0];
  },
};

function logging(target) {
  return new Proxy(target, {
    get(target, key, receiver) {
      log.push("get " + String(key));
      return Reflect.get(target, key, receiver);
    },
    has(target, key) {
      log.push("has " + String(key));
      return Reflect.has(target, key);
    },
    ownKeys(target) {
      log.push("keys");
      return Reflect.ownKeys(target);
    },
    getOwnPropertyDescriptor(target, key) {
      log.push("describe " + String(key));
      return Reflect.getOwnPropertyDescriptor(target, key);
    },
  });
}

const makers = {
  "a proxy": () => logging([3, 1]),
  "an array with getters": () =>
    Object.defineProperties([3, 1], {
      0: { get() { log.push("get 0"); return 3; }, enumerable: true },
      1: { get() { log.push("get 1"); return 1; }, enumerable: true },
    }),
  "an array-like with getters": () => ({
    get length() { log.push("get length"); return 2; },
    get 0() { log.push("get 0"); return 3; },
    get 1() { log.push("get 1"); return 1; },
    get push() { log.push("get push"); return undefined; },
  }),
  "an array with a getter that throws": () => Object.defineProperty([3, 1], 0, { get() { throw new RangeError("element"); }, enumerable: true }),
  "an array of objects that log": () => [{ toString() { log.push("toString"); return "3"; }, valueOf() { log.push("valueOf"); return 3; } }],
  "an iterable that logs": () => ({
    [Symbol.iterator]() {
      log.push("iterator");
      return { next() { log.push("next"); return { done: true }; }, return() { log.push("return"); return {}; } };
    },
  }),
  "a subclass that logs": () => new (class extends Array {
    static get [Symbol.species]() { log.push("species"); return Array; }
    [Symbol.iterator]() { log.push("iterator"); return super[Symbol.iterator](); }
  })(3, 1),
  "null": () => null,
  "undefined": () => undefined,
  "a number": () => 5,
  "a symbol": () => Symbol("list"),
  "an array": () => [3, 1],
};

for (const use in uses) for (let i = 0; i < 1000; i++) uses[use]([3, 1]);

for (const name in makers) {
  for (const use in uses) {
    log.length = 0;
    let answer = "returned";
    try {
      uses[use](makers[name]());
    } catch (error) {
      answer = "threw " + error.constructor.name;
    }
    console.log(name + ", " + use + ": " + answer + (log.length ? " after " + log.join(", ") : ""));
  }
}
