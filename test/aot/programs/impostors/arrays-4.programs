////= otherPrototype-4	reduce	"the other prototype's reduce"	reduceRight	"the other prototype's reduceRight"

////= makers-2

function sum(list) {
  return list.reduce((total, value) => total + value, 0);
}

function sumWithoutAStart(list) {
  return list.reduce((total, value) => total + value);
}

function joinedFromTheRight(list) {
  return list.reduceRight((text, value, index) => text + index + "=" + String(value) + ";", "");
}

////= uses-33	"sum"	sum	"sum without a start"	sumWithoutAStart	"from the right"	joinedFromTheRight

const honest = {};

