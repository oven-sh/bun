////= lines-22	sumDirectly	list	let	total	0

////= lines-27	throughOne	list	sumDirectly	list

////= lines-27	throughTwo	list	throughOne	list

function throughThree(list) {
  const same = list;
  return throughTwo(same);
}

function sumFrom(list, index) {
  return index < list.length && index < 50 ? list[index] + sumFrom(list, index + 1) : 0;
}

function sumInto(list, index, total) {
  if (index >= list.length || index >= 50) return total;
  return sumInto(list, index + 1, total + list[index]);
}

