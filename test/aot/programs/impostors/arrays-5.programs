function toArray(list) {
  return Array.prototype.slice.call(list);
}

function clone(value) {
  if (Array.isArray(value)) return value.map(clone);
  if (value && typeof value === "object") {
    const copy = {};
    for (const key in value) copy[key] = clone(value[key]);
