function visit(list, change) {
  const seen = [];
  list.forEach((value, index) => {
    if (index === 1) change();
    if (seen.length < 20) seen.push(index, value);
  });
  return seen;
}

function doubled(list, change) {
  return list.map((value, index) => {
    if (index === 1) change();
    return value + value;
  });
}

function kept(list, change) {
  return list.filter((value, index) => {
    if (index === 1) change();
    return index !== 2;
  });
}

