function run(generator, list, change) {
  const steps = generator(list);
  const seen = [];
  for (let turn = 0; turn < 9; turn++) {
    if (turn === 2) change(list);
    const step = steps.next("sent " + turn);
    if (step.done) break;
    seen.push(step.value);
  }
  return seen;
}

