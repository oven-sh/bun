////= describe-12

function twice(list, change) {
  return list.flatMap((value, index) => {
    if (index === 1) change();
    return [value, value];
  });
}

function copied(list, change) {
  return Array.from(list, (value, index) => {
    if (index === 1) change();
    return value;
  });
}

function fromTheRight(list, change) {
  let turn = 0;
  return list.reduceRight((seen, value, index) => {
    if (turn++ === 1) change();
    if (seen.length < 20) seen.push(index, value);
    return seen;
  }, []);
}

