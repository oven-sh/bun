class Quiet extends Array {}

////= Loud-3

const ownMembers = {
  push() {
    return "its own push";
  },
  *[Symbol.iterator]() {
    yield "its own iterator";
  },
};

const otherPrototype = {
  __proto__: Array.prototype,
  push() {
    return "the other prototype's push";
  },
  *[Symbol.iterator]() {
    yield "the other prototype's iterator";
  },
};

////= makers-3

////= lines-109	same	list	return

////= lines-37	firstOf	pair	pair[0

function held(list) {
  return { list }.list;
}

function chosen(list, flag) {
  return flag ? list : [];
}

////= lines-185	lengthOfResult	list	same	length

function pushToResult(list) {
  return chosen(list, true).push(9);
}

function sumOfResult(list) {
  const result = firstOf([list, 1]);
  let total = 0;
  for (let i = 0; i < result.length; i++) total += result[i];
  return total;
}

function walkResult(list) {
  const seen = [];
  for (const value of held(list)) seen.push(value);
  return seen;
}

const uses = {
  "length of a result": list => lengthOfResult(list),
  "push to a result": list => pushToResult(list),
  "sum of a result": list => sumOfResult(list),
  "walk of a result": list => walkResult(list),
};

const honest = {};

