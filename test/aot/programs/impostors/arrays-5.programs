function sum(list, change) {
  return list.reduce((total, value, index) => {
    if (index === 1) change();
    return total + value;
  }, 0);
}

function visits(list, change) {
  let count = 0;
  list.every((value, index) => {
    if (index === 1) change();
    count++;
    return true;
  });
  return count;
}

function lastVisited(list, change) {
  let last;
  list.find((value, index) => {
    if (index === 1) change();
    last = [index, value];
    return index === 7;
  });
  return last;
}

