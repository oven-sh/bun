class Box {
  constructor(width, height) {
    this.width = width;
    this.height = height;
  }
  area() {
    return this.width * this.height;
  }
  reset() {
    this.width = "reset";
  }
  set both(value) {
    this.width = value;
    this.height = value;
  }
  get drained() {
    delete this.width;
    return true;
  }
}
