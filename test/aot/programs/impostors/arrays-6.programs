//// await-of-a-thenable-that-rejects-with-the-value.js
"use strict";

const log = [];

////= show-28

async function pushes(given) {
  try {
    await { then(resolve, reject) { reject(given); } };
  } catch (a) {
    a.push(1);
    return [a.length];
  }
}

async function iterates(given) {
  try {
    await { then(resolve, reject) { reject(given); } };
  } catch (a) {
    const seen = [];
    for (const x of a) seen.push(x);
    return [seen];
  }
}

async function readsCharCode(given) {
  try {
    await { then(resolve, reject) { reject(given); } };
  } catch (s) {
    return [s.charCodeAt(0)];
  }
}

async function truncates(given) {
  try {
    await { then(resolve, reject) { reject(given); } };
  } catch (n) {
    return [n | 0];
  }
}

async function addsOne(given) {
  try {
    await { then(resolve, reject) { reject(given); } };
  } catch (n) {
    return [n + 1];
  }
}

async function calls(given) {
  try {
    await { then(resolve, reject) { reject(given); } };
  } catch (f) {
    return [f(1)];
  }
}

async function addsMembers(given) {
  try {
    await { then(resolve, reject) { reject(given); } };
  } catch (o) {
    return [o.x + o.y];
  }
}

async function storesMember(given) {
  try {
    await { then(resolve, reject) { reject(given); } };
  } catch (o) {
    o.x = 1;
    return [o];
  }
}

////= table-8

main();
