function walk(list) {
  let text = "";
  for (const value of list) text += "<" + String(value) + ">";
  return text;
}

////= doubled

////= lines-144	aboveOne	filter	1

function visit(list) {
  let text = "";
  list.forEach((value, key) => {
    text += String(key) + "=" + String(value) + ";";
  });
  return text;
}

////= lines-267	ascending	sort

////= lines-257	largest	list	Math.max

function firstAndSecond(list) {
  const [first, second] = list;
  return String(first) + "," + String(second);
}

////= lines-258	lastOne	list	list[list

function renumber(list) {
  for (let i = 0; i < list.length; i++) list[i] = i;
  return list.length;
}

class Ring {
  constructor(...values) {
    this.length = values.length;
    values.forEach((value, index) => {
      this[index] = value;
    });
  }
  push(value) {
    this[0] = value;
    return "a ring never grows";
  }
  map(change) {
    return new Ring(change(this[0]));
  }
  filter() {
    return this;
  }
  forEach(visit) {
    visit(this[0], "only the first");
  }
  sort() {
    return "a ring has no order";
  }
  *[Symbol.iterator]() {
    yield this[this.length - 1];
    yield this[0];
  }
}

