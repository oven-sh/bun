const uses = {
  "sum": list => sum(list),
  "sum with a cached length": list => sumWithACachedLength(list),
  "backwards": list => backwards(list),
  "first": list => first(list),
};

const honest = {};

////= round

round("at first");
////= for-3
round("after 2000 arrays");

module.exports = uses;
