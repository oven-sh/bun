////= sum

function sumWithACachedLength(list) {
  let total = 0;
  for (let i = 0, length = list.length; i < length; i++) total += list[i];
  return total;
}

function backwards(list) {
  const seen = [];
  for (let i = list.length - 1; i >= 0 && seen.length < 6; i--) seen.push(list[i]);
  return seen;
}

