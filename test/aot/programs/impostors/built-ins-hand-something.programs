function takeBoth(box) {
  const { width, height } = box;
  return [width, height];
}

function takeWithDefaults(box) {
  const { width = "default width", depth = "default depth" } = box;
  return [width, depth];
}

function takeRenamed(box) {
  const { height: tall, width: wide } = box;
  return [tall, wide];
}

