////: codesInALoop
function codesInALoop(text, count) {
  const codes = [];
  for (let i = 0; i < count; i++) {
    try {
      codes.push(text.charCodeAt(i));
    } catch (error) {
      codes.push(error.constructor.name);
    }
  }
  return codes;
}
