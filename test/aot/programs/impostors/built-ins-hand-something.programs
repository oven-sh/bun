const log = [];

////= make-2

function wrap(box) {
  return { label: "parcel", size: box };
}

////= lines-230	readDeep	parcel	parcel.size.width

function readDeepThroughChains(parcel) {
  return parcel?.size?.width;
}

function readDeepTwice(parcel) {
  return [parcel.size.width, parcel.size.height];
}

function readDeepOfEach(boxes) {
  const results = [];
  for (let i = 0; i < boxes.length; i++) {
    try {
      results.push(boxes[i].size.width);
    } catch (error) {
      results.push(error.constructor.name);
    }
  }
  return results;
}

const uses = [
  ["parcel.size.width", box => readDeep(wrap(box))],
  ["parcel?.size?.width", box => readDeepThroughChains(wrap(box))],
  ["size.width, size.height", box => readDeepTwice(wrap(box))],
  ["honest, this one, honest", box => readDeepOfEach([wrap(make()), wrap(box), wrap(make())])],
];

