//// changed-object-literals-are-given-to-honest-methods-as-this-in-sloppy-code.cjs
const log = [];

function make() {
  return {
    width: 3,
    height: 4,
    area() {
      return this.width * this.height;
    },
    grow() {
      this.width += 1;
      return this.width;
    },
    resize(width, height) {
      this.width = width;
      this.height = height;
      return typeof this;
    },
    mark() {
      this.marked = true;
      return typeof this;
    },
  };
}

const honest = make();
const honestArea = honest.area;
const honestGrow = honest.grow;
const honestResize = honest.resize;
const honestMark = honest.mark;

