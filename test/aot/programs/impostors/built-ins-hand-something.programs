////: Box-3
class Box {
  constructor(width, height) {
    this.width = width;
    this.height = height;
  }
  area() {
    return this.width * this.height;
  }
  grow() {
    this.width += 1;
    return this.width;
  }
  resize(width, height) {
    this.width = width;
    this.height = height;
    return typeof this;
  }
  mark() {
    this.marked = true;
    return typeof this;
  }
}
