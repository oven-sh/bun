//// class-factories-extend-a-parent-that-is-a-parameter.js
////= show-34

const Named = Base =>
  class extends Base {
    constructor(...inputs) {
      super(...inputs);
      this.title = "named";
    }
    describe() {
      return "named, " + super.describe();
    }
  };

const Counted = Base =>
  class extends Base {
    count = 0;
    bump() {
      return ++this.count;
    }
    describe() {
      return "counted " + this.count + ", " + super.describe();
    }
  };

const Quiet = Base => class extends Base {};

