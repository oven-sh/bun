const parents = [Stores, HasFields, CallsOut, Old, ReturnsLiteral, Listed, Failed];

const compositions = [
  ["Named", Base => Named(Base)],
  ["Counted", Base => Counted(Base)],
  ["Quiet", Base => Quiet(Base)],
  ["Named(Counted)", Base => Named(Counted(Base))],
  ["Counted(Named)", Base => Counted(Named(Base))],
  ["Quiet(Named(Quiet))", Base => Quiet(Named(Quiet(Base)))],
];

////= describe-8

////= amountOf

////= lines-5	bump	thing	thing.bump

const Usual = Named(Counted(Stores));
let length = 0;
for (let i = 0; i < 2000; i++) {
  const usual = new Usual(i % 5);
  length += describe(usual).length + amountOf(usual) + bump(usual);
}
console.log("2000 honest rounds", length);

for (const Parent of parents) {
  for (const [label, compose] of compositions) {
    const where = label + " of " + Parent.name;
    let Made;
    attempt(where + ": define", () => ((Made = compose(Parent)), typeof Made));
    attempt(where + ": construct", () => { const made = new Made(3); return Array.isArray(made) ? ["a list of " + made.length, Object.keys(made)] : made; });
    attempt(where + ": describe()", () => describe(new Made(3)));
    attempt(where + ": amount", () => amountOf(new Made(3)));
    attempt(where + ": bump()", () => bump(new Made(3)));
    attempt(where + ": instanceof itself, the parent", () => [new Made(3) instanceof Made, new Made(3) instanceof Parent]);
  }
}

attempt("two results of one factory are different classes", () => [Named(Stores) === Named(Stores), new (Named(Stores))(1) instanceof Named(Stores)]);
attempt("a parent that is null", () => new (Quiet(null))());
attempt("a parent that is null, with a constructor", () => new (Named(null))());
attempt("a parent that is undefined", () => Quiet(undefined));
attempt("a parent that is an arrow function", () => Quiet(() => {}));
attempt("a parent that is a literal", () => Quiet({}));
attempt("a parent whose prototype is a number", () => Quiet(Object.assign(function () {}, { prototype: 5 })));
attempt("a parent that is a bound class", () => describe(new (Named(Stores.bind(null, "bound")))()));
attempt("a parent that is a proxy", () => describe(new (Counted(new Proxy(Stores, {})))(4)));
attempt("honest again", () => { const usual = new Usual(2); return [describe(usual), amountOf(usual), bump(usual), Object.keys(usual)]; });
//// classes-and-literals-share-their-member-names.js
////= show-7

class Invoice {
  constructor(customer, amount, paid) {
    this.customer = customer;
    this.amount = amount;
    this.paid = paid;
  }
  status() {
    return this.paid ? "invoice paid" : "invoice open";
  }
}

class Receipt {
  constructor(customer, amount, paid) {
    this.paid = paid;
    this.amount = amount;
    this.customer = customer;
  }
  status() {
    return "receipt for " + this.customer;
  }
}

class Quote {
  amount = "quoted amount";
  customer = "quoted customer";
  paid = "quoted paid";
  status() {
    return "quote";
  }
}

class Refund extends Invoice {
  constructor(customer, amount) {
    super(customer, -amount, true);
    this.reason = "returned";
  }
  status() {
    return "refund, and the parent says " + super.status();
  }
}

function Bill(customer, amount, paid) {
  this.amount = amount;
  this.customer = customer;
  this.paid = paid;
}
////= lines-36	Bill	status	"bill of "	amount

function makeRecord(customer, amount, paid) {
  return { customer, amount, paid, status: () => "record" };
}

function makeRecordTheOtherWayRound(customer, amount, paid) {
  return { status: () => "backwards record", paid, amount, customer };
}

////= lines-7	customerOf	paper	paper.customer

////= lines-7	amountOf	paper	paper.amount

////= lines-7	paidOf	paper	paper.paid

function allThree(paper) {
  return [paper.customer, paper.amount, paper.paid];
}

////= lines-5	statusOf	paper	paper.status

function settle(paper) {
  paper.paid = true;
  paper.amount = 0;
  return paper;
}

////= lines-131	totalOf	papers	amount

const makers = [
  ["Invoice", () => new Invoice("ann", 10, false)],
  ["Receipt, the fields in the opposite order", () => new Receipt("bob", 20, false)],
  ["Quote, class fields", () => new Quote()],
  ["Refund, a subclass", () => new Refund("cat", 30)],
  ["Bill, a constructor function", () => new Bill("dan", 40, false)],
  ["a literal", () => makeRecord("eve", 50, false)],
  ["a literal the other way round", () => makeRecordTheOtherWayRound("fay", 60, false)],
];

function look(phase) {
  for (const [label, make] of makers) {
    console.log(phase + " | " + label + " | customer " + show(customerOf(make())) + " | amount " + show(amountOf(make())) + " | paid " + show(paidOf(make())));
    console.log(phase + " | " + label + " | all three " + show(allThree(make())) + " | status " + show(statusOf(make())));
    console.log(phase + " | " + label + " | settled " + show(settle(make())) + " | json " + JSON.stringify(make()));
  }
  console.log(phase + " | total of all " + show(totalOf(makers.map(([, make]) => make()))));
  console.log(phase + " | total of the numbers " + show(totalOf(makers.filter(([label]) => !label.startsWith("Quote")).map(([, make]) => make()))));
}

look("at first");
for (const [trained, make] of makers) {
  let count = 0;
  for (let i = 0; i < 2000; i++) {
    const paper = make();
    if (customerOf(paper) && amountOf(paper) !== undefined && allThree(paper).length === 3 && statusOf(paper) && settle(paper).paid) count++;
  }
  console.log("2000 rounds with " + trained, count);
  look("after " + trained);
}
