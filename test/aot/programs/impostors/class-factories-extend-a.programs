//// computed-names-of-class-members-are-not-strings.js
////= show-26

function classWithAMethod(key) {
  return class {
    [key]() {
      return "called";
    }
  };
}

function classWithAField(key) {
  return class {
    [key] = "field";
  };
}

function classWithAStaticField(key) {
  return class {
    static [key] = "static field";
  };
}

////= names

const log = [];
globalThis.log = log;

////= keys

for (let i = 0; i < 200; i++) {
  classWithAMethod("a");
  new (classWithAField("a"))();
  classWithAStaticField("a");
}

for (const key of keys) {
  attempt("class method " + key, () => names(classWithAMethod(make(key)).prototype));
  attempt("class field " + key, () => {
    const Made = classWithAField(make(key));
    const before = log.length;
    const first = names(new Made());
    const second = names(new Made());
    return [first, second, log.length - before];
  });
  attempt("static field " + key, () => names(classWithAStaticField(make(key))));
  if (log.length) console.log("log", log.splice(0).join(", "));
}

attempt("the keys of a class are computed in order, before any field", () => {
  const order = [];
  const key = name => ({ toString() { order.push("key " + name); return name; } });
  const value = name => (order.push("value " + name), name);
  class Ordered {
    static [key("a")] = value("a");
    [key("b")] = value("b");
    [key("c")]() {}
    static [key("d")] = value("d");
  }
  order.push("made");
  new Ordered();
  return order;
});
//// computed-names-of-methods-and-accessors-are-not-strings.js
////= show-26

function literalWithAMethod(key) {
  return {
    [key]() {
      return "called";
    },
  };
}

function literalWithAnAccessor(key) {
  return {
    get [key]() {
      return "got";
    },
    set [key](value) {},
  };
}

function literalWithAFunction(key) {
  return { [key]: function () {}, other: () => {} };
}

////= names

const log = [];
globalThis.log = log;

////= keys

////= for-183	literalWithAMethod	"a"	literalWithAnAccessor	"a"	literalWithAFunction

for (const key of keys) {
  attempt("method " + key, () => {
    const object = literalWithAMethod(make(key));
    const name = Reflect.ownKeys(object)[0];
    return [names(object), object[name].name, object[name]()];
  });
  attempt("accessor " + key, () => {
    const object = literalWithAnAccessor(make(key));
    const name = Reflect.ownKeys(object)[0];
    const found = Object.getOwnPropertyDescriptor(object, name);
    return [names(object), found.get.name, found.set.name, object[name]];
  });
  attempt("function " + key, () => {
    const object = literalWithAFunction(make(key));
    return [names(object), object[Reflect.ownKeys(object).find(name => name !== "other")].name];
  });
  if (log.length) console.log("log", log.splice(0).join(", "));
}
