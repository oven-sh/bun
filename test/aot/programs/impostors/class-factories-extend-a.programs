//// commonjs-modules-pass-look-alikes-for-texts/honest-callers.cjs
var tools = require("./text-tools.cjs");

module.exports = function (rounds) {
  var total = 0;
  for (var i = 0; i < rounds; i++) {
    total += tools.hash("hello") + tools.capitalize("hello").length + tools.count({}, "hello").hello + tools.pad("x", 3).length;
    if (tools.isName("hello")) total++;
  }
  return total;
};
//// commonjs-modules-pass-look-alikes-for-texts/look-alikes.cjs
function LookAlike(text) {
  this.text = text;
  this.length = text.length;
}

LookAlike.prototype.charCodeAt = function (index) {
  return -this.text.charCodeAt(index);
};

LookAlike.prototype.charAt = function (index) {
  return new LookAlike(this.text.charAt(index));
};

LookAlike.prototype.toUpperCase = function () {
  return "<" + this.text.toUpperCase() + ">";
};

LookAlike.prototype.slice = function (from) {
  return "<" + this.text.slice(from) + ">";
};

////= lines-36	LookAlike	toString	"look alike "	text

module.exports = {
  lookAlike: new LookAlike("hello"),
  wrapped: new String("hello"),
  list: ["h", "e", "l", "l", "o"],
  bytes: Buffer.from("hello"),
  number: 12345,
  nothing: null,
  missing: undefined,
  symbol: Symbol("hello"),
  proto: "__proto__",
  constructorName: "constructor",
};
