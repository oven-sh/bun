////= lines-308	addsOne	+	1

function calls(text) {
  let f = x => x + 1;
  const change = () => eval("f = " + text);
  const results = [];
  for (let round = 0; round < 3; round++) {
    results.push(f(1));
    if (round === 0) change();
  }
  return results;
}

function addsMembers(text) {
  let o = ({ x: 1, y: 2 });
  const change = () => eval("o = " + text);
  const results = [];
  for (let round = 0; round < 3; round++) {
    results.push(o.x + o.y);
    if (round === 0) change();
  }
  return results;
}

function storesMember(text) {
  let o = ({ x: 1, y: 2 });
  const change = () => eval("o = " + text);
  const results = [];
  for (let round = 0; round < 3; round++) {
    o.x = 1;
    results.push(o);
    if (round === 0) change();
  }
  return results;
}

