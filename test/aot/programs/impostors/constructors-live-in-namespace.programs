async function readsCharCode(iterable) {
  for await (const s of iterable) {
    return [s.charCodeAt(0)];
  }
}

async function truncates(iterable) {
  for await (const n of iterable) {
    return [n | 0];
  }
}

async function addsOne(iterable) {
  for await (const n of iterable) {
    return [n + 1];
  }
}

async function calls(iterable) {
  for await (const f of iterable) {
    return [f(1)];
  }
}

async function addsMembers(iterable) {
  for await (const o of iterable) {
    return [o.x + o.y];
  }
}

////= storesMember-5

////= table

async function everyCase(round) {
  for (const [name, use, values] of table) {
    for (const [label, make] of [...values, values[0]]) await attempt(round + " " + name + " " + label, () => use([Promise.resolve(make())]));
  }
}

async function main() {
  console.log("strict:", (function () { return this === undefined; })());
  await everyCase("at first");
  for (let i = 0; i < 500; i++) {
    await pushes([Promise.resolve([5, 6])]);
    await iterates([Promise.resolve([5, 6])]);
    await readsCharCode([Promise.resolve("abc")]);
    await truncates([Promise.resolve(7)]);
    await addsOne([Promise.resolve(7)]);
    await calls([Promise.resolve(x => x + 1)]);
    await addsMembers([Promise.resolve(({ x: 1, y: 2 }))]);
    await storesMember([Promise.resolve(({ x: 1, y: 2 }))]);
  }
  await everyCase("after 500");
}

main();
