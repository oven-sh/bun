    const f = new Further(i);
    console.log(label, Object.keys(d).join(), d.x, d.y, d.tag, d.other, d instanceof Base, "|", Object.keys(f).join(), f.x, f.y, f.z, f.tag, f.other, f instanceof Base);
  }
}
