function makeCounter(start) {
  let count = start;
  return {
    step: 1,
    increment() {
      count += this.step;
      return count;
    },
    current() {
      return count;
    },
  };
}

function makeBackwardsCounter(start) {
  let count = start;
  return {
    step: 1,
    increment() {
      count -= this.step;
      return count;
    },
    current() {
      return "backwards " + count;
    },
  };
}

function makeCounterInAnotherOrder(start) {
  let count = start;
  return {
    current: () => "another order " + count,
    increment: function () {
      return (count += 10);
    },
    step: 1,
  };
}

