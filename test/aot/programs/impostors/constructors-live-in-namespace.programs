const iterating = value => ({ [Symbol.iterator]: () => ({ done: false, next() { return this.done ? { done: true } : ((this.done = true), { done: false, value }); } }) });

function pushes(iterable) {
  for (const a of iterable) {
    a.push(1);
    return a.length;
  }
}

function iterates(iterable) {
  for (const a of iterable) {
    const seen = [];
    for (const x of a) seen.push(x);
    return seen;
  }
}

function readsCharCode(iterable) {
  for (const s of iterable) {
    return s.charCodeAt(0);
  }
}

function truncates(iterable) {
  for (const n of iterable) {
    return n | 0;
  }
}

function addsOne(iterable) {
  for (const n of iterable) {
    return n + 1;
  }
}

function calls(iterable) {
  for (const f of iterable) {
    return f(1);
  }
}

function addsMembers(iterable) {
  for (const o of iterable) {
    return o.x + o.y;
  }
}

function storesMember(iterable) {
  for (const o of iterable) {
    o.x = 1;
    return o;
  }
}

