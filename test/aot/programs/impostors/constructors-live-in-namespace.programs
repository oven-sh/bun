////= lines-20	walk	thing	names	name	in

function walkEach(things) {
  const names = [];
  things.forEach(thing => {
    for (const name in thing) names.push(name);
  });
  return names;
}

////= lines-116	copy	thing

function withoutBeta(thing) {
  const { beta, ...rest } = thing;
  return rest;
}

