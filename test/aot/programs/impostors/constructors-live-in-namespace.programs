function* yielding(value) {
  yield value;
}

function pushes(iterable) {
  const [a] = iterable;
  a.push(1);
  return a.length;
}

////= lines-343	iterates(iterable	const [a] = iterable

function readsCharCode(iterable) {
  const [s] = iterable;
  return s.charCodeAt(0);
}

function truncates(iterable) {
  const [n] = iterable;
  return n | 0;
}

function addsOne(iterable) {
  const [n] = iterable;
  return n + 1;
}

function calls(iterable) {
  const [f] = iterable;
  return f(1);
}

function addsMembers(iterable) {
  const [o] = iterable;
  return o.x + o.y;
}

function storesMember(iterable) {
  const [o] = iterable;
  o.x = 1;
  return o;
}

