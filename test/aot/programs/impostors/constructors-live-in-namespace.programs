////: whileLoop
function whileLoop(value) {
  let rounds = 0;
  while (value) {
    rounds++;
    value = value.slice(1);
    if (rounds > 5) break;
  }
  return rounds;
}
//// constructors-live-in-namespace-objects-and-are-replaced.cjs
