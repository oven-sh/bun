////= show-24

function listWith(make, other) {
  const list = [];
  for (let i = 0; i < 1003; i++) list.push(i === 1000 ? other : make());
  return list;
}

function pushes(list) {
  const results = [];
  for (let i = 0; i < list.length; i++) {
    const a = list[i];
    a.push(1);
    if (i > 997) results.push(a.length);
  }
  return results;
}

function iterates(list) {
  const results = [];
  for (let i = 0; i < list.length; i++) {
    const a = list[i];
    const seen = [];
    for (const x of a) seen.push(x);
    if (i > 997) results.push(seen);
  }
  return results;
}

function readsCharCode(list) {
  const results = [];
  for (let i = 0; i < list.length; i++) {
    const s = list[i];
    if (i > 997) results.push(s.charCodeAt(0));
  }
  return results;
}

////= lines-325	truncates	|	0

////= lines-325	addsOne	+	1

function calls(list) {
  const results = [];
  for (let i = 0; i < list.length; i++) {
    const f = list[i];
    if (i > 997) results.push(f(1));
  }
  return results;
}

function addsMembers(list) {
  const results = [];
  for (let i = 0; i < list.length; i++) {
    const o = list[i];
    if (i > 997) results.push(o.x + o.y);
  }
  return results;
}

function storesMember(list) {
  const results = [];
  for (let i = 0; i < list.length; i++) {
    const o = list[i];
    o.x = 1;
    if (i > 997) results.push(o);
  }
  return results;
}

////= table

function everyCase(round) {
  for (const [name, use, values] of table) {
    for (const [label, make] of [...values, values[0]]) attempt(round + " " + name + " " + label, () => use(listWith(values[0][1], make())));
  }
}

console.log("strict:", (function () { return this === undefined; })());
everyCase("at first");
for (let i = 0; i < 3; i++) {
  pushes(listWith(() => [5, 6], [5, 6]));
  iterates(listWith(() => [5, 6], [5, 6]));
  readsCharCode(listWith(() => "abc", "abc"));
  truncates(listWith(() => 7, 7));
  addsOne(listWith(() => 7, 7));
  calls(listWith(() => x => x + 1, x => x + 1));
  addsMembers(listWith(() => ({ x: 1, y: 2 }), ({ x: 1, y: 2 })));
  storesMember(listWith(() => ({ x: 1, y: 2 }), ({ x: 1, y: 2 })));
}
everyCase("after 3");
