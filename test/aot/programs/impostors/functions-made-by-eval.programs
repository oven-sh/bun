function countAnimals(list) {
  let count = 0;
  for (let i = 0; i < list.length; i++) if (list[i] instanceof Animal) count++;
  return count;
}

const honest = [];
for (let i = 0; i < 2000; i++) honest.push(i % 3 === 0 ? new Animal() : i % 3 === 1 ? new Dog() : new Rock());
let yes = 0;
for (const value of honest) yes += isAnimal(value) + isDog(value) + isOldStyle(value) + isInstanceOf(value, Rock);
console.log("2000 honest values:", yes, countAnimals(honest));
for (let i = 0; i < 2000; i++) isOldStyle(new OldStyle());

function ask(label, value) {
  attempt(label + " instanceof Animal:", () => isAnimal(value));
  attempt(label + " instanceof Dog:", () => isDog(value));
  attempt(label + " instanceof OldStyle:", () => isOldStyle(value));
  attempt(label + " counted:", () => countAnimals([value]));
}

const loose = new Dog();
ask("a dog", loose);
Object.setPrototypeOf(loose, null);
ask("a dog without a prototype", loose);
Object.setPrototypeOf(loose, Rock.prototype);
ask("a dog under the prototype of Rock", loose);
Object.setPrototypeOf(loose, OldStyle.prototype);
ask("a dog under the prototype of OldStyle", loose);
Object.setPrototypeOf(loose, Dog.prototype);
ask("a dog under its own prototype again", loose);

const risen = new Rock();
Object.setPrototypeOf(risen, Dog.prototype);
ask("a rock under the prototype of Dog", risen);
ask("an object made by Object.create(Dog.prototype)", Object.create(Dog.prototype));
ask("the prototype object of Dog", Dog.prototype);
ask("a proxy of a dog", new Proxy(new Dog(), {}));
ask(
  "a proxy that answers another prototype",
  new Proxy(new Rock(), {
    getPrototypeOf: () => Animal.prototype,
  }),
);
for (const primitive of [1, "dog", null, undefined, true, 1n, Symbol.iterator])
  ask("the primitive " + String(primitive), primitive);

const kept = new Dog();
Object.setPrototypeOf(Dog.prototype, Rock.prototype);
ask("a dog after Dog.prototype moved under Rock.prototype", kept);
attempt("  which is now a rock:", () => isInstanceOf(kept, Rock));
Object.setPrototypeOf(Dog.prototype, Animal.prototype);
ask("a dog after it moved back", kept);

const before = new OldStyle();
OldStyle.prototype = { replaced: true };
const after = new OldStyle();
ask("made before OldStyle.prototype was replaced", before);
ask("made after OldStyle.prototype was replaced", after);
OldStyle.prototype = 5;
ask("while OldStyle.prototype is a number", after);
OldStyle.prototype = Object.getPrototypeOf(after);
ask("with the second prototype again", after);

let asked = 0;
Object.defineProperty(Animal, Symbol.hasInstance, {
  value(value) {
    asked++;
    return value === 7;
  },
  configurable: true,
});
ask("with Symbol.hasInstance on Animal, a dog", kept);
ask("with Symbol.hasInstance on Animal, seven", 7);
console.log("Symbol.hasInstance ran", asked, "times");
delete Animal[Symbol.hasInstance];
ask("without it again, a dog", kept);

const rights = {
  "a bound class": Animal.bind(null),
  "a proxy of a class": new Proxy(Animal, {}),
  "an arrow function": () => {},
  "a plain object": {},
  "an object with Symbol.hasInstance": { [Symbol.hasInstance]: value => value === kept },
  "a number": 3,
  undefined: undefined,
  Object: Object,
  Function: Function,
};
for (const [name, right] of Object.entries(rights))
  attempt("a dog instanceof " + name + ":", () => isInstanceOf(kept, right));
console.log("honest again:", countAnimals(honest));
//// instances-become-prototypes-of-other-objects.js
////= show-10

////= Box

////= OldBox
////= OldBox-prototype-area

function makeLiteral(width, height) {
  return { width, height, area() { return this.width * this.height; } };
}

////= lines-7	widthOf	thing	thing.width

////= lines-7	depthOf	thing	thing.depth

////= lines-5	areaOf	thing	thing.area

////= lines-53	hasDepth	thing	"depth"	in	thing

////= lines-229	setWidth	box	value	box.width

////= lines-229	setDepth	box	value	box.depth

function walk(thing) {
  const names = [];
  for (const name in thing) names.push(name);
  return names.join();
}

const kinds = [
  ["class", () => new Box(3, 4)],
  ["constructor function", () => new OldBox(3, 4)],
  ["literal", () => makeLiteral(3, 4)],
];

const ways = [
  ["Object.create", parent => Object.create(parent)],
  ["Object.setPrototypeOf", parent => Object.setPrototypeOf({}, parent)],
  ["a literal with __proto__", parent => ({ __proto__: parent })],
  ["a store to __proto__", parent => { const child = {}; child.__proto__ = parent; return child; }],
  ["the prototype property of a function", parent => { function Child() {} Child.prototype = parent; return new Child(); }],
  ["Reflect.construct with such a function", parent => { function Child() {} Child.prototype = parent; return Reflect.construct(Object, [], Child); }],
  ["Object.create reached by a joined name", parent => Object[["cre", "ate"].join("")](parent)],
  ["two levels of Object.create", parent => Object.create(Object.create(parent))],
  ["another instance moved under it", parent => { const child = new Box(1, 2); delete child.width; delete child.height; return Object.setPrototypeOf(child, parent); }],
];

function look(child) {
  return [widthOf(child), depthOf(child), hasDepth(child), areaOf(child), walk(child)].map(show).join(" ");
}

for (const [kind, make] of kinds) {
  for (const [way, derive] of ways) {
    const parent = make();
    const child = derive(parent);
    let sum = 0;
    for (let i = 0; i < 700; i++) {
      sum += widthOf(child) + areaOf(child) + (depthOf(child) === undefined ? 1 : 0) + (hasDepth(child) ? 0 : 1);
      sum += widthOf(parent);
    }
    const where = kind + " | " + way + " | ";
    console.log(where + "700 rounds " + sum + " | " + look(child));
    setWidth(parent, 9);
    console.log(where + "the parent's width was stored to -> " + look(child));
    setWidth(parent, "wide");
    console.log(where + "with a string -> " + look(child));
    setDepth(parent, 7);
    console.log(where + "the parent got a depth -> " + look(child));
    delete parent.depth;
    console.log(where + "and lost it -> " + look(child));
    delete parent.width;
    console.log(where + "the parent lost its width -> " + look(child));
    setWidth(parent, 2);
    console.log(where + "and got it back -> " + look(child));
    Object.defineProperty(parent, "width", { get() { return this === child ? "getter, this is the child" : "getter, this is someone else"; }, configurable: true, enumerable: true });
    console.log(where + "the parent's width became a getter -> " + look(child));
    try {
      setWidth(child, 1);
      console.log(where + "a store to the child under that getter -> " + look(child));
    } catch (error) {
      console.log(where + "a store to the child under that getter threw " + error.constructor.name);
    }
    Object.defineProperty(parent, "width", { value: 6, writable: true, enumerable: true, configurable: true });
    setWidth(child, 1);
    console.log(where + "a store to the child shadows a plain width -> " + look(child) + " | the parent has " + show(widthOf(parent)));
    delete child.width;
    Object.freeze(parent);
    try {
      setWidth(child, 1);
      console.log(where + "a store to the child of a frozen parent -> " + look(child));
    } catch (error) {
      console.log(where + "a store to the child of a frozen parent threw " + error.constructor.name);
    }
  }
}
console.log("honest again", widthOf(new Box(3, 4)), areaOf(new OldBox(3, 4)), show(depthOf(makeLiteral(3, 4))));
//// int32-slots/a-captured-variable-is-changed-after-the-closure-was-made.ts
// The closure that stores into the field captures a variable, not a value: other closures over the same variable add to it, subtract from it, double it and count it up before the store happens.
// Every operand in sight is a small integer, and sums of integers look like integers. Doubling leaves int32 after 31 rounds, and the amounts that hidden callers add are fractions, -0 and NaN.
// A second class, for contrast, has the operations that give -0 and NaN out of integers alone: times, remainder and negation.
const unknownCodeRuns = process.argv.length > 99;
////= handOver-2
class Tally { total = 0; }
class Wild { total = 0; }
function counter(tally: Tally) {
  let n = 1;
  return {
    store: () => { tally.total = n; },
    add: (amount: number) => { n += amount; },
    subtract: (amount: number) => { n = n - amount; },
    fromZero: () => { n = 0 - n; },
    double: () => { n += n; },
    up: () => { n++; },
    down: () => { --n; },
    reset: (to: number) => { n = to; },
  };
}
function wildCounter(wild: Wild) {
  let n = 1;
  return {
    store: () => { wild.total = n; },
    negate: () => { n = -n; },
    reset: (to: number) => { n = to; },
    times: (factor: number) => { n *= factor; },
    remainder: (by: number) => { n %= by; },
  };
}
////= lines-64	fresh	tally	Tally
////= lines-64	freshWild	wild	Wild
function show(tally: Tally | Wild) {
  return `${exact(tally.total)} ${exact(tally.total + 1)} ${exact(-tally.total)} ${JSON.stringify(tally)}`;
}
let sum = 0;
for (let i = 0; i < 2000; i++) {
  const tally = fresh();
  const c = counter(tally);
  c.add(i & 15);
  c.double();
  c.subtract(3);
  c.up();
  c.down();
  c.fromZero();
  c.store();
  const wild = freshWild();
  const w = wildCounter(wild);
  w.reset(i & 15);
  w.times(3);
  w.remainder(1000);
  w.negate();
  w.store();
  sum += tally.total + wild.total;
}
console.log("warm", sum);
{
  const tally = fresh();
  const c = counter(tally);
  const steps: string[] = [];
  for (let i = 0; i < 34; i++) {
    c.double();
    c.store();
    if (i >= 28) steps.push(show(tally));
  }
  console.log("doubled:", steps.join(" | "));
}
{
  const tally = fresh();
  const c = counter(tally);
  c.reset(2147483646);
  const steps: string[] = [];
  for (let i = 0; i < 3; i++) {
    c.up();
    c.store();
    steps.push(show(tally));
  }
  console.log("counted up:", steps.join(" | "));
  c.reset(-2147483642);
  steps.length = 0;
  for (let i = 0; i < 8; i++) {
    c.down();
    c.store();
    steps.push(show(tally));
  }
  console.log("counted down through the smallest:", steps.join(" | "));
  c.reset(-1073741824);
  c.double();
  c.store();
  console.log("the smallest int32:", show(tally));
  c.fromZero();
  c.store();
  console.log("taken from zero:", show(tally));
}
{
  const wild = freshWild();
  const w = wildCounter(wild);
  w.reset(0);
  w.negate();
  w.store();
  console.log("zero negated:", show(wild), exact(1 / wild.total));
  w.reset(-4);
  w.remainder(2);
  w.store();
  console.log("-4 % 2:", show(wild), exact(1 / wild.total));
  w.reset(0);
  w.times(-5);
  w.store();
  console.log("0 * -5:", show(wild), exact(1 / wild.total));
  w.reset(5);
  w.remainder(0);
  w.store();
  console.log("5 % 0:", show(wild));
  w.reset(46341);
  w.times(46341);
  w.store();
  console.log("46341 squared:", show(wild));
}
for (const value of odd) {
  const tally = fresh();
  const c = counter(tally);
  c.reset(0);
  c.add.call(undefined, value);
  c.store();
  const added = show(tally);
  c.reset.apply(undefined, [value]);
  c.store();
  console.log(`${exact(value)}: added to zero ${added} | set ${show(tally)} ${Object.is(tally.total, value)}`);
}
//// int32-slots/a-closure-stores-the-number-it-captured-and-hidden-callers-hand-it-other-numbers.ts
// Every call of these functions that the build can see hands over a small integer, which a closure captures and stores into a number field later.
// Five callers that it cannot see, through call, apply, Reflect.apply, bind and a function kept on the global object, hand over fractions, -0, NaN, infinities and integers outside int32.
const unknownCodeRuns = process.argv.length > 99;
////= handOver-2
class ByCall { level = 0; tail = "t"; }
class ByApply { level = 0; tail = "t"; }
class ByReflect { level = 0; tail = "t"; }
class ByBind { level = 0; tail = "t"; }
class ByGlobal { level = 0; tail = "t"; }
////= lines-199	viaCall	ByCall
////= lines-199	viaApply	ByApply
////= lines-199	viaReflect	ByReflect
////= lines-199	viaBind	ByBind
////= lines-199	viaGlobal	ByGlobal
(globalThis as any).kept = viaGlobal;
type Gauge = { level: number; tail: string };
function use(gauge: Gauge) {
  return `${exact(gauge.level)} ${exact(gauge.level + 1)} ${exact(gauge.level * 2)} ${gauge.level | 0} ${exact(1 / gauge.level)} ${gauge.level === gauge.level} ${JSON.stringify(gauge)} [${Object.keys(gauge)}]`;
}
const routes: [string, () => Gauge, (gauge: any, level: number) => () => void, (gauge: any, level: number) => () => void][] = [
  ["call", () => new ByCall(), viaCall, (gauge, level) => viaCall.call(undefined, gauge, level)],
  ["apply", () => new ByApply(), viaApply, (gauge, level) => viaApply.apply(undefined, [gauge, level])],
  ["Reflect.apply", () => new ByReflect(), viaReflect, (gauge, level) => Reflect.apply(viaReflect, undefined, [gauge, level])],
  ["bind", () => new ByBind(), viaBind, (gauge, level) => viaBind.bind(undefined, gauge)(level)],
  ["a global", () => new ByGlobal(), viaGlobal, (gauge, level) => (globalThis as any).kept(gauge, level)],
];
let sum = 0;
for (let i = 0; i < 2000; i++) {
  const a = new ByCall(), b = new ByApply(), c = new ByReflect(), d = new ByBind(), e = new ByGlobal();
  handOver(a); handOver(b); handOver(c); handOver(d); handOver(e);
  viaCall(a, i & 255)();
  viaApply(b, i & 255)();
  viaReflect(c, i & 255)();
  viaBind(d, i & 255)();
  viaGlobal(e, i & 255)();
  sum += a.level + b.level + c.level + d.level + e.level;
}
console.log("warm", sum);
for (const [label, make, , hidden] of routes) {
  for (const value of odd) {
    const gauge = make();
    handOver(gauge);
    hidden(gauge, value)();
    const stored = use(gauge);
    hidden(gauge, 7)();
    console.log(`${label} ${exact(value)}: ${Object.is(gauge.level, 7)} | ${stored}`);
  }
}
