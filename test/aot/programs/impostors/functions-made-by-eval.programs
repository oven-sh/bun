//// has-get-and-set-are-called-on-whatever-has-them.js
function show(value) {
  if (typeof value === "object" && value !== null) return value.constructor ? value.constructor.name : "object";
  return typeof value + " " + String(value);
}

////= attempt-19

function remember(store, key, value) {
  if (store.has(key)) return store.get(key);
  store.set(key, value);
  return store.get(key);
}

function forget(store, key) {
  const had = store.has(key);
  store.delete(key);
  return had + " " + store.has(key);
}

function addTwice(bag, value) {
  bag.add(value);
  bag.add(value);
  return bag.has(value);
}

function countEach(store) {
  let count = 0;
  store.forEach(() => count++);
  return count;
}

const honest = new Map();
let warm = 0;
for (let i = 0; i < 2000; i++) {
  warm += remember(honest, "k" + (i & 63), i);
  if ((i & 255) === 0) forget(honest, "k1");
}
const honestBag = new Set();
for (let i = 0; i < 2000; i++) addTwice(honestBag, i & 63);
console.log("2000 honest rounds:", warm, honest.size, honestBag.size, countEach(honest), countEach(honestBag));

class Ledger {
  constructor() {
    this.entries = {};
    this.log = [];
  }
  has(key) {
    this.log.push("has");
    return key in this.entries;
  }
  get(key) {
    this.log.push("get");
    return this.entries[key];
  }
  set(key, value) {
    this.log.push("set");
    this.entries[key] = value + "!";
  }
  delete(key) {
    this.log.push("delete");
    return delete this.entries[key];
  }
  add(value) {
    this.log.push("add");
    this.entries[value] = true;
  }
  forEach(callback) {
    this.log.push("forEach");
    for (const key in this.entries) callback(this.entries[key], key);
  }
}

class LoudMap extends Map {
  get(key) {
    return "loud " + super.get(key);
  }
  has() {
    return false;
  }
}

const key = {};
const stores = {
  "a Map": () => new Map(),
  "a WeakMap": () => new WeakMap(),
  "a Set": () => new Set(),
  "a WeakSet": () => new WeakSet(),
  "a class of the program": () => new Ledger(),
  "an object literal": () => ({ has: () => true, get: () => "literal", set() {}, delete() {}, add() {}, forEach() {} }),
  "a subclass of Map": () => new LoudMap(),
  "a Map with a get of its own": () => Object.assign(new Map(), { get: () => "own" }),
  "a Map under another prototype": () => Object.setPrototypeOf(new Map(), Ledger.prototype),
  "an object under Map.prototype": () => Object.create(Map.prototype),
  "a proxy of a Map": () => new Proxy(new Map(), {}),
  "a proxy that binds the methods": () =>
    new Proxy(new Map(), {
      get: (target, name) => (typeof target[name] === "function" ? target[name].bind(target) : target[name]),
    }),
  URLSearchParams: () => new URLSearchParams(),
  Headers: () => new Headers(),
  FormData: () => new FormData(),
  "an array": () => [],
  "a string": () => "text",
  null: () => null,
};

for (const [name, make] of Object.entries(stores)) {
  for (const [kind, used] of [
    ["a string key", "k"],
    ["an object key", key],
  ]) {
    const store = make();
    console.log(
      name + ", " + kind + ":",
      "remember",
      attempt(() => remember(store, used, "v")),
      "| again",
      attempt(() => remember(store, used, "w")),
      "| forget",
      attempt(() => forget(store, used)),
      "| add",
      attempt(() => addTwice(store, used)),
      "| each",
      attempt(() => countEach(store)),
      "| log",
      store && store.log ? store.log.join() : "none",
    );
  }
}

console.log(
  "honest again:",
  remember(honest, "k2", 0),
  forget(honest, "k2"),
  addTwice(honestBag, 99),
  countEach(honestBag),
);
//// hidden-code-reaches-objects-that-were-never-handed-to-it.js
////= show-10

class Leaf {
  constructor(value) {
    this.value = value;
    this.tag = "leaf";
  }
  double() {
    return this.value * 2;
  }
  set(value) {
    this.value = value;
    return this.value;
  }
}

class Branch {
  constructor(leaf) {
    this.leaf = leaf;
  }
  getLeaf() {
    return this.leaf;
  }
}

////= lines-7	valueOf	leaf	leaf.value

////= lines-148	plusOne	leaf	leaf.value

////= lines-5	doubled	leaf	leaf.double

////= lines-3	store	leaf	leaf.set	5

////= lines-82	giveTo	callback	leaf	callback	leaf

////= lines-82	handOver	leaf	callback	callback	leaf

////= lines-109	throwIt	leaf	throw

function* yieldIt(leaf) {
  yield leaf;
}

function passArguments(hidden, mutate) {
  return function () {
    return hidden(arguments, mutate);
  };
}

const mark = Symbol("mark");

const routes = [
  ["handed over itself", "mutate(input);", leaf => leaf],
  ["a field of what was handed over", "mutate(input.leaf);", leaf => new Branch(leaf)],
  ["two fields down", "mutate(input.leaf.leaf);", leaf => new Branch(new Branch(leaf))],
  ["the result of a method", "mutate(input.getLeaf());", leaf => new Branch(leaf)],
  ["the result of a closure", "mutate(input());", leaf => () => leaf],
  ["an element", "mutate(input[1]);", leaf => [0, leaf]],
  ["an element of an element", "mutate(input[0][0]);", leaf => [[leaf]]],
  ["a value of a Map", "mutate(input.get('key'));", leaf => new Map([["key", leaf]])],
  ["a member of a Set", "for (const each of input) mutate(each);", leaf => new Set([leaf])],
  ["a getter", "mutate(input.found);", leaf => ({ get found() { return leaf; } })],
  ["a member under a symbol", "mutate(input[Object.getOwnPropertySymbols(input)[0]]);", leaf => ({ [mark]: leaf })],
  ["a member that is not enumerable", "mutate(input.quiet);", leaf => Object.defineProperty({}, "quiet", { value: leaf })],
  ["the prototype of what was handed over", "mutate(Object.getPrototypeOf(input));", leaf => Object.create(leaf)],
  ["a generator", "for (const each of input) mutate(each);", leaf => yieldIt(leaf)],
  ["a thrown value", "try { input(); } catch (caught) { mutate(caught); }", leaf => () => throwIt(leaf)],
  ["a callback that visible code calls", "input(mutate);", leaf => callback => giveTo(callback, leaf)],
  ["a bound argument", "input(mutate);", leaf => handOver.bind(null, leaf)],
  ["the global object", "mutate(globalThis.sharedLeaf);", leaf => { globalThis.sharedLeaf = leaf; }],
  ["a proxy's target", "mutate(input);", leaf => new Proxy(leaf, {})],
  ["a WeakRef", "mutate(input.deref());", leaf => new WeakRef(leaf)],
];

const mutations = [
  ["stores a string", "leaf.value = 'hidden';"],
  ["stores 1.5", "leaf.value = 1.5;"],
  ["deletes value", "delete leaf.value;"],
  ["freezes it", "Object.freeze(leaf);"],
  ["turns value into a getter", "Object.defineProperty(leaf, 'value', { get() { return 'getter'; }, configurable: true });"],
  ["gives it its own double", "leaf.double = function () { return 'own double'; };"],
  ["moves it", "Object.setPrototypeOf(leaf, { double() { return 'moved'; }, set() { return 'moved'; } });"],
];

function look(leaf) {
  return [valueOf, plusOne, doubled, store].map(use => {
    try {
      return show(use(leaf));
    } catch (error) {
      return error.constructor.name;
    }
  }).join(" ");
}

for (let i = 0; i < 2000; i++) look(new Leaf(i % 7));
console.log("honest", look(new Leaf(1)));

for (const [route, routeText, wrap] of routes) {
  const hidden = new Function("input", "mutate", routeText);
  for (const [mutation, mutationText] of mutations) {
    const leaf = new Leaf(1);
    const mutate = new Function("leaf", mutationText);
    let line = route + " | " + mutation + " -> ";
    try {
      hidden(wrap(leaf), mutate);
      line += look(leaf);
    } catch (error) {
      line += "threw " + error.constructor.name;
    }
    console.log(line);
  }
}
delete globalThis.sharedLeaf;

for (const [mutation, mutationText] of mutations) {
  const leaf = new Leaf(1);
  passArguments(new Function("input", "mutate", "mutate(input[0]);"), new Function("leaf", mutationText))(leaf);
  console.log("the arguments object | " + mutation + " -> " + look(leaf));
  const other = new Leaf(1);
  new Function("mutate", "mutate(this);").call(other, new Function("leaf", mutationText));
  console.log("this | " + mutation + " -> " + look(other));
}

const untouched = new Leaf(1);
new Function("input", "Object.getPrototypeOf(input).double = function () { return 'every leaf was changed'; };")(new Leaf(2));
console.log("hidden code patched the class through one instance, another instance -> " + look(untouched));
new Function("input", "input.constructor.prototype.set = function () { return 'set was changed too'; };")(new Leaf(2));
console.log("and through the constructor member -> " + look(untouched));
const made = new Function("input", "return new input.constructor('made by hidden code');")(new Leaf(2));
console.log("an instance that hidden code constructed -> " + look(made) + " " + (made instanceof Leaf));
//// hidden-code-stores-other-values-into-number-fields.js
const log = [];

////= show-17

class Meter {
  constructor(count) {
    this.count = count;
    this.limit = 100;
  }
  plusOne() {
    return this.count + 1;
  }
  times(factor) {
    return this.count * factor;
  }
  asInt() {
    return this.count | 0;
  }
  shifted() {
    return this.count >>> 1;
  }
  negated() {
    return -this.count;
  }
  tick() {
    this.count++;
    return this.count;
  }
  addTo(amount) {
    this.count += amount;
    return this.count;
  }
  belowLimit() {
    return this.count < this.limit;
  }
  isFive() {
    return this.count === 5;
  }
  looselyFive() {
    return this.count == 5;
  }
  index(list) {
    return list[this.count];
  }
  text() {
    return "count " + this.count;
  }
  truthy() {
    return this.count ? "yes" : "no";
  }
  kind() {
    return typeof this.count;
  }
  remainder() {
    return this.count % 3;
  }
  rounded() {
    return Math.floor(this.count);
  }
}

const methods = [
  ["plusOne", meter => meter.plusOne()],
  ["times 2", meter => meter.times(2)],
  ["| 0", meter => meter.asInt()],
  [">>> 1", meter => meter.shifted()],
  ["negated", meter => meter.negated()],
  ["++", meter => meter.tick()],
  ["+= 1", meter => meter.addTo(1)],
  ["< limit", meter => meter.belowLimit()],
  ["=== 5", meter => meter.isFive()],
  ["== 5", meter => meter.looselyFive()],
  ["as an index", meter => meter.index(["zero", "one", "two", "three", "four", "five"])],
  ["in a string", meter => meter.text()],
  ["as a condition", meter => meter.truthy()],
  ["typeof", meter => meter.kind()],
  ["% 3", meter => meter.remainder()],
  ["Math.floor", meter => meter.rounded()],
];

const values = [
  "5",
  "'5'",
  "5.5",
  "-0",
  "NaN",
  "2147483647",
  "2147483648",
  "9007199254740993",
  "5n",
  "true",
  "null",
  "undefined",
  "({})",
  "({ valueOf() { log.push('valueOf'); return 5; } })",
  "({ [Symbol.toPrimitive](hint) { log.push('toPrimitive ' + hint); return 5; } })",
  "({ toString() { log.push('toString'); return '5'; } })",
  "new Number(5)",
  "new Date(5)",
  "Symbol.for('five')",
];

const stores = [
  ["a store", new Function("meter", "value", "meter.count = value;")],
  ["a store under a computed name", new Function("meter", "value", "meter['co' + 'unt'] = value;")],
  ["Object.assign", new Function("meter", "value", "Object.assign(meter, { count: value });")],
  ["defineProperty", new Function("meter", "value", "Object.defineProperty(meter, 'count', { value });")],
  ["Reflect.set", new Function("meter", "value", "Reflect.set(meter, 'count', value);")],
];

let sum = 0;
for (let i = 0; i < 2000; i++) {
  for (const [, method] of methods) {
    const result = method(new Meter(i % 6));
    if (typeof result === "number") sum += result;
  }
}
console.log("2000 honest rounds", sum);

values.forEach((text, position) => {
  const [way, store] = stores[position % stores.length];
  for (const [name, method] of methods) {
    const meter = new Meter(1);
    store(meter, new Function("log", "return " + text + ";")(log));
    let line = text + " by " + way + " | " + name + " -> ";
    try {
      line += show(method(meter));
    } catch (error) {
      line += "threw " + error.constructor.name;
    }
    console.log(line + " | count is now " + show(meter.count) + (log.length ? " | log " + log.splice(0).join(", ") : ""));
  }
});

console.log("honest again", methods.map(([, method]) => show(method(new Meter(5)))).join(" "));
//// honest-accessors-are-shadowed-replaced-and-half-overridden.js
const log = [];

////= show-43

class Thermometer {
  constructor(celsius) {
    this.celsius = celsius;
  }
  get fahrenheit() {
    return this.celsius * 2 + 30;
  }
  set fahrenheit(value) {
    this.celsius = (value - 30) / 2;
  }
  get frozen() {
    return this.celsius < 0;
  }
}

////= lines-7	read	thermometer	thermometer.fahrenheit

////= lines-93	write	thermometer	value	thermometer.fahrenheit	thermometer.celsius

////= lines-217	bump	thermometer	thermometer.fahrenheit	2	thermometer.celsius

////= lines-7	readOnlyOne	thermometer	thermometer.frozen

////= lines-60	writeReadOnlyOne	thermometer	thermometer.frozen	"stored"

function look(label, make) {
  print(label + ": read", () => read(make()));
  print(label + ": write 50", () => write(make(), 50));
  print(label + ": += 2", () => bump(make()));
  print(label + ": a getter without a setter", () => readOnlyOne(make()));
  print(label + ": a store to it", () => writeReadOnlyOne(make()));
  print(label + ": keys", () => Object.keys(make()));
}

let sum = 0;
for (let i = 0; i < 2000; i++) {
  const honest = new Thermometer(i % 30);
  sum += read(honest) + write(honest, 40) + bump(honest) + (readOnlyOne(honest) ? 1 : 0);
}
console.log("2000 honest rounds", sum);
look("honest", () => new Thermometer(10));

class OnlyGetter extends Thermometer {
  get fahrenheit() {
    log.push("the child's getter");
    return "child";
  }
}
look("a child that overrides only the getter", () => new OnlyGetter(10));

class OnlySetter extends Thermometer {
  set fahrenheit(value) {
    log.push("the child's setter " + value);
  }
}
look("a child that overrides only the setter", () => new OnlySetter(10));

class CallsSuper extends Thermometer {
  get fahrenheit() {
    return "super says " + super.fahrenheit;
  }
  set fahrenheit(value) {
    super.fahrenheit = value + 10;
  }
}
look("a child that goes through super", () => new CallsSuper(10));

class FieldOver extends Thermometer {
  fahrenheit = "a field";
  frozen = "a field too";
}
look("a child with fields of the same names", () => new FieldOver(10));

look("an own value shadows the accessor", () => Object.defineProperty(new Thermometer(10), "fahrenheit", { value: "own", writable: true, enumerable: true, configurable: true }));
look("an own value that cannot be written shadows it", () => Object.defineProperty(new Thermometer(10), "fahrenheit", { value: "own" }));
look("a literal with plain members", () => ({ celsius: 10, fahrenheit: "plain", frozen: "plain" }));
look("a literal under the prototype", () => ({ __proto__: Thermometer.prototype, celsius: 10 }));
look("a literal under the prototype without celsius", () => ({ __proto__: Thermometer.prototype }));
look("a frozen thermometer", () => Object.freeze(new Thermometer(10)));
look("a thermometer with a string", () => new Thermometer("10"));
look("a proxy around a thermometer", () => new Proxy(new Thermometer(10), { get(target, key, receiver) { log.push("get " + String(key)); return Reflect.get(target, key, receiver); }, set(target, key, value, receiver) { log.push("set " + String(key)); return Reflect.set(target, key, value, receiver); } }));
look("an object that inherits from a thermometer", () => Object.create(new Thermometer(10)));

const original = Object.getOwnPropertyDescriptor(Thermometer.prototype, "fahrenheit");
Object.defineProperty(Thermometer.prototype, "fahrenheit", { get() { log.push("a new getter"); return "replaced"; }, set: original.set, configurable: true });
look("the getter was replaced on the prototype", () => new Thermometer(10));
Object.defineProperty(Thermometer.prototype, "fahrenheit", { get: original.get, set: undefined, configurable: true });
look("the setter was removed", () => new Thermometer(10));
Object.defineProperty(Thermometer.prototype, "fahrenheit", { value: "a plain value now", writable: true, configurable: true });
look("the accessor became a plain value", () => new Thermometer(10));
delete Thermometer.prototype.fahrenheit;
look("the accessor was deleted", () => new Thermometer(10));
Object.defineProperty(Thermometer.prototype, "fahrenheit", original);
look("the accessor is back", () => new Thermometer(10));
look("and the child that goes through super", () => new CallsSuper(10));
