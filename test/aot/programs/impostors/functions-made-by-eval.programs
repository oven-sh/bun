//// int32-slots/fields-that-hold-references-get-numbers-and-other-values-by-hidden-ways.ts
// The neighbors of the number fields: fields declared as an object, a string, an array, a function or an instance, each `| null`, whose visible stores are references and null, so that a narrow slot for a reference looks enough.
// Hidden stores put numbers of every kind, booleans, undefined, bigints, symbols and references of other types there. Whatever was stored must come back, in its place among the keys, also after collections,
// and typed code that reads the field meanwhile must do with the stranger what JavaScript does: find no such member, call what is callable, or throw a TypeError.
const unknownCodeRuns = process.argv.length > 99;
////= handOver-2
class Node_ {
  count = 0;
  record: { tag: number } | null = null;
  text: string | null = null;
  list: number[] | null = null;
  run: (() => number) | null = null;
  next: Node_ | null = null;
  last = 0;
}
function fill(node: Node_, i: number, next: Node_ | null) {
  node.count = Math.abs(i | 0);
  node.record = { tag: i };
  node.text = "t" + i;
  node.list = [i];
  node.run = () => i;
  node.next = next;
}
function clear(node: Node_) {
  node.record = null;
  node.text = null;
  node.list = null;
  node.run = null;
  node.next = null;
}
function typedView(node: Node_) {
  return `${node.record?.tag} ${node.text} ${node.list?.length} ${node.run?.()} ${node.next?.count}`;
}
function attempt(node: Node_) {
  try {
    return typedView(node);
  } catch (error) {
    return (error as Error).constructor.name;
  }
}
////= lines-64	fresh	node	Node_
function shown(value: unknown): string {
  if (typeof value === "symbol") return value.toString();
  if (typeof value === "bigint") return value + "n";
  if (typeof value === "function") return "function";
  if (typeof value === "object" && value !== null) return value instanceof Node_ ? "node" : JSON.stringify(value);
  return exact(value);
}
let length = 0;
for (let i = 0; i < 2000; i++) {
  const node = fresh();
  fill(node, i & 31, i & 1 ? fresh() : null);
  length += typedView(node).length;
  if (i & 2) clear(node);
  length += typedView(node).length;
}
console.log("warm", length);
const names: string[] = JSON.parse('["record","text","list","run","next"]');
const strangers: unknown[] = [...odd.slice(0, 9), 1, 0, true, false, undefined, 10n, Symbol.for("s"), "a string", { other: 1 }, [1, 2], () => 2, new Map(), new Date(0)];
const kept: [Node_, string, unknown][] = [];
for (const name of names) {
  const lines: string[] = [];
  for (const value of strangers) {
    const empty = fresh(), filled = fresh();
    fill(filled, 5, null);
    (empty as any)[name] = value;
    Reflect.set(filled, name, value);
    kept.push([empty, name, value], [filled, name, value]);
    lines.push(`${shown(value)} ${Object.is((empty as any)[name], value)}${Object.is((filled as any)[name], value)} ${Object.keys(filled).join("") === "countrecordtextlistrunnextlast"} (${attempt(empty)}) (${attempt(filled)})`);
  }
  console.log(name + ":", lines.join(" | "));
}
Bun.gc(true);
let junk = 0;
for (let i = 0; i < 1_000_000; i++) junk += [{ tag: i }, "j" + (i & 255)].length;
Bun.gc(true);
console.log("after collections:", junk, kept.filter(([node, name, value]) => Object.is((node as any)[name], value)).length, "of", kept.length);
let restored = 0;
for (const [node] of kept) {
  fill(node, 7, null);
  if (typedView(node) === "7 t7 1 7 undefined") restored++;
}
console.log("filled by typed code again:", restored, JSON.stringify(kept[0][0]));
//// int32-slots/generic-helpers-pass-objects-strings-and-numbers-and-one-day-a-fraction.ts
// id(), checkDefined(), orElse(), pick(), tap(), last(), first() and singleOrUndefined() are generic: the same functions pass objects, strings and numbers through, and their results are stored into number fields.
// Wherever the build looks, the numbers are small integers. A hidden caller of the function that fills the fields brings the others, through the very same helpers.
const unknownCodeRuns = process.argv.length > 99;
////= handOver-2
function id<T>(x: T): T {
  return x;
}
function checkDefined<T>(x: T | undefined | null): T {
  if (x === undefined || x === null) throw new Error("not defined");
  return x;
}
function orElse<T>(x: T | undefined, fallback: T): T {
  return x ?? fallback;
}
function pick<T>(flag: boolean, a: T, b: T): T {
  return flag ? a : b;
}
function tap<T>(x: T, look: (x: T) => void): T {
  look(x);
  return x;
}
function last<T>(a: T, b: T, c: T): T {
  let result = a;
  for (const next of [b, c]) result = next;
  return result;
}
function first<T>(list: readonly T[]): T {
  return list[0];
}
function singleOrUndefined<T>(list: readonly T[]): T | undefined {
  return list.length === 1 ? list[0] : undefined;
}
class Filled { a = 0; b = 0; c = 0; d = 0; e = 0; f = 0; g = 0; }
class FromLists { h = 0; i = 0; }
function fillFromLists(o: FromLists, n: number) {
  o.h = first([n, 1]);
  o.i = singleOrUndefined([n]) ?? 0;
}
let looked = 0;
function fill(o: Filled, n: number) {
  o.a = id(n);
  o.b = checkDefined(n);
  o.c = orElse(n, 0);
  o.d = pick(looked >= 0, n, 1);
  o.e = tap(n, () => { looked++; });
  o.f = id(id(checkDefined(orElse(id(n), 2))));
  o.g = id(n) + id(1);
}
////= lines-64	fresh	o	Filled
let sum = 0;
for (let i = 0; i < 2000; i++) {
  const o = fresh();
  fill(o, i & 63);
  sum += o.a + o.b + o.c + o.d + o.e + o.f + o.g;
  const lists = new FromLists();
  handOver(lists);
  fillFromLists(lists, i & 63);
  sum += lists.h + lists.i + first(["ab"]).length + first([{ k: 3 }]).k;
  sum += id("text").length + checkDefined({ k: 1 }).k + orElse<string>(undefined, "ab").length + pick(true, [1], [2, 3]).length + tap({ k: 2 }, () => {}).k + last("a", "bc", "def").length + last(1, 2, 3);
}
console.log("warm", sum, looked);
for (const value of odd) {
  const o = fresh();
  fill.call(undefined, o, value);
  const right = [o.a, o.b, o.c, o.d, o.e, o.f].every(stored => Object.is(stored, value)) && Object.is(o.g, value + 1);
  const lists = new FromLists();
  handOver(lists);
  fillFromLists.call(undefined, lists, value);
  console.log(`${exact(value)}: ${right} ${Object.values(o).map(exact).join(",")} ${JSON.stringify(o)} [${Object.keys(o)}] ${exact(o.a + o.b)} | ${Object.is(lists.h, value)} ${Object.is(lists.i, value)} ${JSON.stringify(lists)}`);
}
const o = fresh();
fill(o, 5);
console.log("an ordinary one afterwards:", JSON.stringify(o));
