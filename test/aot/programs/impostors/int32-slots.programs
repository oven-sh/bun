  for (const [name, make] of notSmallIntegers) {
    await attempt("low of " + name, () => Promise.resolve(low).then(run => run(make())));
    await attempt("pick at " + name, () => Promise.resolve(pick).then(run => run(make())));
  }
  await attempt("low of a literal", () => Promise.resolve(low).then(run => run(4294967297.5)));
  await attempt("pick at a literal", () => Promise.resolve(pick).then(run => run("length")));
  for (const [name, make] of notFunctions) {
    await attempt("invoke of " + name, () => Promise.resolve(invoke).then(run => run(make())));
    await attempt("build from " + name, () => Promise.resolve(build).then(run => run(make())));
  }
  await attempt("invoke of a literal", () => Promise.resolve(invoke).then(run => run(class {})));
  await attempt("build from a literal", () => Promise.resolve(build).then(run => run(() => {})));
  for (const [name, make] of notPoints) {
    await attempt("sumOf " + name, () => Promise.resolve(sumOf).then(run => run(make())));
    await attempt("move " + name, () => Promise.resolve(move).then(run => run(make())));
  }
  await attempt("sumOf a literal", () => Promise.resolve(sumOf).then(run => run({ y: 2, x: 1 })));
  await attempt("move a literal", () => Promise.resolve(move).then(run => run({ get x() { return 1; }, y: 2 })));
  for (const [name, make] of notArrays) {
    await attempt("total of " + name, () => Promise.resolve(total).then(run => run(make())));
    await attempt("append to " + name, () => Promise.resolve(append).then(run => run(make())));
  }
  await attempt("total of a literal", () => Promise.resolve(total).then(run => run("12")));
  await attempt("append to a literal", () => Promise.resolve(append).then(run => run({ push: () => "a literal's push" })));
  for (const [name, make] of notStrings) {
    await attempt("firstCode of " + name, () => Promise.resolve(firstCode).then(run => run(make())));
    await attempt("tail of " + name, () => Promise.resolve(tail).then(run => run(make())));
  }
  await attempt("firstCode of a literal", () => Promise.resolve(firstCode).then(run => run([65])));
  await attempt("tail of a literal", () => Promise.resolve(tail).then(run => run([1, 2, 3])));
  for (const [name, make] of notNumbers) {
    await attempt("half of " + name, () => Promise.resolve(half).then(run => run(make())));
    await attempt("below from " + name, () => Promise.resolve(below).then(run => run(make())));
  }
  await attempt("half of a literal", () => Promise.resolve(half).then(run => run("4")));
  await attempt("below from a literal", () => Promise.resolve(below).then(run => run("1")));
  honestFirst("after");
  honestSecond("after");
}

main();
