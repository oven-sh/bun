function codePoints(text) {
  const seen = [];
  for (const character of text) seen.push(character.codePointAt(0).toString(16));
  return seen;
}

function codePointAtEach(text) {
  const seen = [];
  for (let i = 0; i < text.length; i++) seen.push(text.codePointAt(i).toString(16));
  return seen;
}

