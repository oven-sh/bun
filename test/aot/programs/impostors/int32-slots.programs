    define(entity, value);
    const defined = show(entity);
    const bumped = attempt(() => bump(entity));
    const after = show(entity);
    const stored = attempt(() => setId(entity, 4));
    console.log(`  ${exact(value)}: ${defined} | ${bumped} ${after} | ${stored} ${exact(idOf(entity))} ${log.join()}`);
    log.length = 0;
  }
}
//// int32-slots/values-that-are-no-numbers-arrive-in-number-fields-by-hidden-ways.ts
// A number field that looks like int32 gets a string, null, undefined, a boolean, a bigint, a symbol, an object, an array and a function: through a hidden caller of the typed function that stores it,
// through a generic helper, through a closure, and by stores that the build cannot attribute. Plain JavaScript keeps whatever was stored, and so must the compiled program, in the same place among the keys.
const unknownCodeRuns = process.argv.length > 99;
////= handOver-2
class Slot { before = 1; n = 0; after = 2; }
function id<T>(x: T): T {
  return x;
}
function direct(slot: Slot, n: number) { slot.n = n; }
function helped(slot: Slot, n: number) { slot.n = id(n); }
function captured(slot: Slot, n: number) { return () => { slot.n = n; }; }
////= lines-64	fresh	slot	Slot
function describe(slot: Slot) {
  const held: unknown = (slot as any).n;
  const shown = typeof held === "symbol" ? held.toString() : typeof held === "bigint" ? held + "n" : typeof held === "function" ? "function" : typeof held === "object" ? JSON.stringify(held) : exact(held);
  let json: string;
  try {
    json = JSON.stringify(slot);
  } catch (error) {
    json = (error as Error).constructor.name;
  }
  return `${shown} [${Object.keys(slot)}] ${json} ${"n" in slot} ${slot.before + slot.after}`;
}
const strangers: unknown[] = ["text", "", "12", null, undefined, true, false, 10n, Symbol.for("s"), { k: 1 }, [3], () => 1, new Number(5), new Date(0)];
const key: string = JSON.parse('"n"');
const routes: [string, (slot: Slot, value: any) => void][] = [
  ["a hidden caller", (slot, value) => direct.call(undefined, slot, value)],
  ["a helper", (slot, value) => helped.apply(undefined, [slot, value])],
  ["a closure", (slot, value) => Reflect.apply(captured, undefined, [slot, value])()],
  ["a computed key", (slot, value) => { (slot as any)[key] = value; }],
  ["Object.assign", (slot, value) => { Object.assign(slot, { [key]: value }); }],
  ["Object.defineProperty", (slot, value) => { Object.defineProperty(slot, key, { value }); }],
];
let sum = 0;
for (let i = 0; i < 2000; i++) {
  const slot = fresh();
  direct(slot, i & 7);
  helped(slot, slot.n + 1);
  captured(slot, slot.n + 1)();
  sum += slot.n + id("s").length + id({ k: 2 }).k;
}
console.log("warm", sum);
for (const [label, put] of routes) {
  console.log(label + ":");
  for (const value of strangers) {
    const slot = fresh();
    put(slot, value);
    const same = Object.is((slot as any).n, value);
    const first = describe(slot);
    direct(slot, 9);
    console.log(`  ${same} ${first} | then 9: ${describe(slot)}`);
  }
}
//// int32-slots/what-is-read-from-a-field-that-looks-like-int32-is-used-as-an-index-a-count-and-a-condition.ts
// Code that reads a field of small integers goes on to use it where an integer is at home: as an index of an array, a string and a typed array, as a length, a count, a shift, a case of a switch, a key of a map.
// A store that the build cannot attribute has put a fraction, -0, NaN, an infinity or a large integer there. Each use must do what JavaScript says for that number.
const unknownCodeRuns = process.argv.length > 99;
////= handOver-2
class Cursor { at = 0; }
const list = ["a", "b", "c", "d"];
const text = "wxyz";
const bytes = new Uint8Array([10, 20, 30, 40]);
const table = new Map<number, string>([[0, "zero"], [1, "one"], [NaN, "nan"]]);
function attempt(run: () => unknown) {
  try {
    const value = run();
    return typeof value === "number" ? exact(value) : String(value);
  } catch (error) {
    return (error as Error).constructor.name;
  }
}
function uses(cursor: Cursor): string[] {
  return [
    attempt(() => list[cursor.at]),
    attempt(() => text[cursor.at]),
    attempt(() => text.charAt(cursor.at)),
    attempt(() => text.charCodeAt(cursor.at)),
    attempt(() => bytes[cursor.at]),
    attempt(() => list.at(cursor.at)),
    attempt(() => list.slice(cursor.at).join("")),
    attempt(() => cursor.at in list),
    attempt(() => new Array(cursor.at).length),
    attempt(() => "ab".repeat(cursor.at).length),
    attempt(() => cursor.at.toFixed(1)),
    attempt(() => cursor.at.toString(2).length),
    attempt(() => 1 << cursor.at),
    attempt(() => cursor.at >> 1),
    attempt(() => cursor.at >>> 0),
    attempt(() => ~cursor.at),
    attempt(() => cursor.at % 2),
    attempt(() => cursor.at / 2),
    attempt(() => cursor.at * cursor.at),
    attempt(() => -cursor.at),
    attempt(() => (cursor.at ? "truthy" : "falsy")),
    attempt(() => cursor.at === 0),
    attempt(() => cursor.at < 1),
    attempt(() => cursor.at >= 0),
    attempt(() => cursor.at == cursor.at),
    attempt(() => { switch (cursor.at) { case 0: return "case 0"; case 1: return "case 1"; case 2147483647: return "case max"; default: return "default"; } }),
    attempt(() => table.get(cursor.at)),
    attempt(() => [cursor.at].includes(cursor.at)),
    attempt(() => [cursor.at].indexOf(cursor.at)),
    attempt(() => Object.is(cursor.at, 0)),
    attempt(() => `${cursor.at}`),
    attempt(() => JSON.stringify([cursor.at])),
    attempt(() => Math.sign(cursor.at)),
    attempt(() => Number.isSafeInteger(cursor.at)),
    attempt(() => BigInt(cursor.at)),
    attempt(() => ({ [cursor.at]: 1 })),
    attempt(() => Object.keys({ [cursor.at]: 1 })[0]),
  ];
}
function walk(cursor: Cursor) {
  let seen = "";
  for (let i = cursor.at; i < list.length && seen.length < 8; i++) seen += list[i] ?? "-";
  return seen;
}
let length = 0;
for (let i = 0; i < 1500; i++) {
  const cursor = new Cursor();
  handOver(cursor);
  cursor.at = i & 3;
  length += uses(cursor).join().length + walk(cursor).length;
}
console.log("warm", length);
const key: string = JSON.parse('"at"');
for (const value of [...odd, Number("1"), Number("3"), Number("-1"), Number("1.0000000000000002")]) {
  const cursor = new Cursor();
  handOver(cursor);
  (cursor as any)[key] = value;
  console.log(`${exact(value)}: ${uses(cursor).join(" ")} | ${walk(cursor)}`);
}
//// iteration-1000-of-a-loop-replaces-the-variable-by-the-impostor.js
"use strict";

const log = [];

////= show-24

function pushes(a, other) {
  const results = [];
  for (let i = 0; i < 1003; i++) {
    if (i === 1000) a = other;
    a.push(1);
    if (i > 997) results.push(a.length);
  }
  return results;
}

function iterates(a, other) {
  const results = [];
  for (let i = 0; i < 1003; i++) {
    if (i === 1000) a = other;
    const seen = [];
    for (const x of a) seen.push(x);
    if (i > 997) results.push(seen);
  }
  return results;
}

function readsCharCode(s, other) {
  const results = [];
  for (let i = 0; i < 1003; i++) {
    if (i === 1000) s = other;
    if (i > 997) results.push(s.charCodeAt(0));
  }
  return results;
}

////= lines-326	truncates	|	0

////= lines-326	addsOne	+	1

function calls(f, other) {
  const results = [];
  for (let i = 0; i < 1003; i++) {
    if (i === 1000) f = other;
    if (i > 997) results.push(f(1));
  }
  return results;
}

function addsMembers(o, other) {
  const results = [];
  for (let i = 0; i < 1003; i++) {
    if (i === 1000) o = other;
    if (i > 997) results.push(o.x + o.y);
  }
  return results;
}

function storesMember(o, other) {
  const results = [];
  for (let i = 0; i < 1003; i++) {
    if (i === 1000) o = other;
    o.x = 1;
    if (i > 997) results.push(o);
  }
  return results;
}

////= table-9

console.log("strict:", (function () { return this === undefined; })());
everyCase("at first");
for (let i = 0; i < 3; i++) {
  pushes([5, 6], [5, 6]);
  iterates([5, 6], [5, 6]);
  readsCharCode("abc", "abc");
  truncates(7, 7);
  addsOne(7, 7);
  calls(x => x + 1, x => x + 1);
  addsMembers(({ x: 1, y: 2 }), ({ x: 1, y: 2 }));
  storesMember(({ x: 1, y: 2 }), ({ x: 1, y: 2 }));
}
everyCase("after 3");
