function iterates(list, order) {
  for (let i = 0; i < list.length; i++) {
    order.push("<" + i);
    const a = list[i];
    const seen = [];
    for (const x of a) seen.push(x);
    order.push(seen);
    order.push(i + ">");
  }
  return "done";
}
////: iteratesAndCatches
function iteratesAndCatches(list, order) {
  for (let i = 0; i < list.length; i++) {
    order.push("<" + i);
    try {
      const a = list[i];
      const seen = [];
      for (const x of a) seen.push(x);
      order.push(seen);
    } catch (error) {
      order.push(error.constructor.name);
      continue;
    } finally {
      order.push("f" + i);
    }
    order.push(i + ">");
  }
  return "done";
}
