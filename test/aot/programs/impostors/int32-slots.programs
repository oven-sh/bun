  "1.5": "inherited 1.5",
  "00": "inherited 00",
  "01": "inherited 01",
  "1.0": "inherited 1.0",
  "1e3": "inherited 1e3",
  1000: "inherited 1000",
  "1e21": "inherited 1e21",
  "1e+21": "inherited 1e+21",
  "1e-7": "inherited 1e-7",
  NaN: "inherited NaN",
  Infinity: "inherited Infinity",
  "-Infinity": "inherited -Infinity",
  4294967295: "inherited 4294967295",
  null: "inherited null",
  "": "inherited empty",
