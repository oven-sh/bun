//// int32-slots/nested-closures-methods-and-suspended-functions-store-what-they-captured.ts
// The captured number goes a longer way before it is stored: through two nested closures, a method of an object literal, an arrow function in a class field,
// a default value of a parameter, a generator and an async function. In sight there are only small integers; a hidden caller of each maker brings the other numbers.
const unknownCodeRuns = process.argv.length > 99;
////= handOver-2
class Cell { n = 0; }
function nested(cell: Cell, n: number) {
  return () => () => { cell.n = n; };
}
function method(cell: Cell, n: number) {
  return { run() { cell.n = n; } };
}
class Holder {
  constructor(public cell: Cell, private n: number) {}
  run = () => { this.cell.n = this.n; };
}
function byDefault(cell: Cell, n: number) {
  return (value = n) => { cell.n = value; };
}
function* generated(cell: Cell, n: number) {
  yield 1;
  cell.n = n;
}
async function awaited(cell: Cell, n: number) {
  await null;
  cell.n = n;
}
////= lines-64	fresh	cell	Cell
const ways: [string, (cell: Cell, n: number) => unknown, (cell: Cell, n: number) => unknown][] = [
  ["nested", (cell, n) => nested(cell, n)()(), (cell, n) => nested.call(undefined, cell, n)()()],
  ["a method", (cell, n) => method(cell, n).run(), (cell, n) => method.apply(undefined, [cell, n]).run()],
  ["a class field", (cell, n) => new Holder(cell, n).run(), (cell, n) => Reflect.construct(Holder, [cell, n]).run()],
  ["a default", (cell, n) => byDefault(cell, n)(), (cell, n) => byDefault.bind(undefined, cell)(n)()],
  ["a generator", (cell, n) => [...generated(cell, n)], (cell, n) => [...Reflect.apply(generated, undefined, [cell, n])]],
  ["an async function", (cell, n) => awaited(cell, n), (cell, n) => awaited.call(undefined, cell, n)],
];
let sum = 0;
for (let i = 0; i < 1000; i++) {
  for (const [, seen] of ways) {
    const cell = fresh();
    await seen(cell, i & 127);
    sum += cell.n;
  }
}
console.log("warm", sum);
for (const [label, , hidden] of ways) {
  const line: string[] = [];
  for (const value of odd) {
    const cell = fresh();
    await hidden(cell, value);
    line.push(`${exact(cell.n)}${Object.is(cell.n, value) ? "" : " WRONG, wanted " + exact(value)} ${exact(cell.n - 1)} ${JSON.stringify(cell)}`);
  }
  console.log(label + ":", line.join(" | "));
}
//// int32-slots/number-fields-lie-between-references-and-the-collector-runs.ts
// Number fields that look like int32 alternate with fields that hold objects, strings and arrays, so that narrow slots lie beside references. The numbers are bit patterns of every kind:
// small multiples of 8 and 16, which look like offsets of cells, all ones, the edges of int32. Some fields get a fraction by a hidden store and leave their slots. 30000 objects survive full and small collections.
const unknownCodeRuns = process.argv.length > 99;
////= handOver-2
class Mixed {
  a = 0;
  first: { tag: number } | null = null;
  b = 0;
  name = "";
  c = 0;
  list: number[] | null = null;
  d = 0;
  e = 0;
  next: Mixed | null = null;
  f = 0;
}
function clamp(value: number) {
  return Math.max(Math.min(value | 0, 2147483647), -2147483643);
}
function fill(mixed: Mixed, i: number, previous: Mixed | null) {
  const pattern = Math.imul(i, 2654435761) | 0;
  mixed.a = clamp(pattern);
  mixed.first = { tag: i };
  mixed.b = (i << 4) | 0;
  mixed.name = "name" + i;
  mixed.c = (i << 3) | 0;
  mixed.list = [i, i + 1];
  const set = () => { mixed.d = ~i; };
  set();
  mixed.e = Math.abs(i & 0xffff);
  mixed.next = previous;
  mixed.f = -1;
}
function check(mixed: Mixed, i: number, previous: Mixed | null) {
  const pattern = Math.imul(i, 2654435761) | 0;
  return (
    (i % 97 === 0 ? mixed.a === i + 0.5 : mixed.a === clamp(pattern)) &&
    mixed.first!.tag === i &&
    mixed.b === ((i << 4) | 0) &&
    mixed.name === "name" + i &&
    (i % 89 === 0 ? mixed.c === 2 ** 40 + i : mixed.c === ((i << 3) | 0)) &&
    mixed.list!.length === 2 &&
    mixed.list![1] === i + 1 &&
    mixed.d === ~i &&
    mixed.e === (i & 0xffff) &&
    mixed.next === previous &&
    mixed.f === -1
  );
}
function churn(rounds: number) {
  let sum = 0;
  for (let i = 0; i < rounds; i++) sum += [{ tag: i }, "junk" + (i & 511), [i]].length;
  return sum;
}
const all: Mixed[] = [];
const keys: string[] = JSON.parse('["a","c"]');
for (let i = 0; i < 30000; i++) {
  const mixed = new Mixed();
  handOver(mixed);
  fill(mixed, i, all[i - 1] ?? null);
  if (i % 97 === 0) (mixed as any)[keys[0]] = i + 0.5;
  if (i % 89 === 0) Reflect.set(mixed, keys[1], 2 ** 40 + i);
  all.push(mixed);
}
function count() {
  let right = 0;
  for (let i = 0; i < all.length; i++) if (check(all[i], i, all[i - 1] ?? null)) right++;
  return right;
}
console.log("filled:", count());
console.log("garbage", churn(1_500_000), count());
Bun.gc(true);
console.log("a full collection:", count());
for (let i = 0; i < all.length; i += 2) fill(all[i], i, all[i - 1] ?? null);
for (let i = 0; i < all.length; i += 2) {
  if (i % 97 === 0) (all[i] as any)[keys[0]] = i + 0.5;
  if (i % 89 === 0) Reflect.set(all[i], keys[1], 2 ** 40 + i);
}
console.log("garbage", churn(1_500_000), count());
Bun.gc(true);
Bun.gc(true);
console.log("old objects filled again:", count(), JSON.stringify({ ...all[97], next: null }), Object.keys(all[89]).join());
//// int32-slots/numbers-of-streams-and-file-stats-are-copied-into-fields-of-the-same-names.ts
// The program's own class has number fields called pos, end, start and size, and so have Bun's read streams and file stats. An interface with those names fits both.
// Real streams and stats go through the functions typed by the interface, and their numbers are copied into the program's objects: `end` of a stream is Infinity, `pos` is undefined, times are fractions.
// Plain objects parsed at run time stand in for a file of more than 2 ** 31 bytes.
import { closeSync, createReadStream, mkdtempSync, openSync, rmSync, statSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
const unknownCodeRuns = process.argv.length > 99;
////= handOver-2
interface TextRange { pos: number; end: number }
interface Sized { size: number }
class Span implements TextRange {
  pos = 0;
  end = 0;
  constructor(pos: number, end: number) {
    this.pos = pos;
    this.end = end;
    handOver(this);
  }
}
class Entry implements Sized {
  size = 0;
  start = 0;
  modified = 0;
}
function width(range: TextRange) {
  return range.end - range.pos;
}
function copyRange(target: Span, range: TextRange) {
  target.pos = range.pos;
  target.end = range.end;
}
function copySize(target: Entry, sized: Sized) {
  target.size = sized.size;
}
function total(list: Sized[]) {
  let sum = 0;
  for (const item of list) sum += item.size;
  return sum;
}
function showSpan(span: Span) {
  return `${exact(span.pos)} ${exact(span.end)} ${exact(width(span))} ${JSON.stringify(span)} [${Object.keys(span)}]`;
}
function showEntry(entry: Entry) {
  return `${exact(entry.size)} ${exact(entry.start)} ${Number.isInteger(entry.modified)} ${exact(entry.size + 1)} [${Object.keys(entry)}]`;
}
let sum = 0;
for (let i = 0; i < 2000; i++) {
  const a = new Span(i & 15, (i & 15) + 4), b = new Span(0, 0), e = new Entry(), f = new Entry();
  handOver(e);
  copyRange(b, a);
  e.size = i & 255;
  e.start = i & 3;
  copySize(f, e);
  sum += width(b) + total([e, f]);
}
console.log("warm", sum);

const folder = mkdtempSync(join(tmpdir(), "int32-slots-"));
const file = join(folder, "data.txt");
writeFileSync(file, "0123456789");
const whole = createReadStream(file);
const part = createReadStream(file, { start: 2, end: 5 });
for (const [label, stream] of [["a whole file", whole], ["a part", part]] as [string, unknown][]) {
  const span = new Span(1, 2);
  copyRange(span, stream as TextRange);
  console.log(label + ":", showSpan(span), exact(width(stream as TextRange)));
  copyRange(span, new Span(3, 9));
  console.log("  and an ordinary range again:", showSpan(span));
}
// The folder is gone before either stream has opened its file: that error is not what is asked about here.
whole.on("error", () => {}).destroy();
part.on("error", () => {}).destroy();
const stats = statSync(file);
const entry = new Entry();
copySize(entry, stats);
entry.modified = stats.mtimeMs + 0.5;
entry.start = stats.size - 10.5;
console.log("stats:", showEntry(entry), total([stats, entry]));
const descriptor = openSync(file, "r");
closeSync(descriptor);
rmSync(folder, { recursive: true });
for (const fake of JSON.parse('[{"size":2147483648},{"size":4294967301},{"size":0.5},{"size":-2147483648},{"size":-2147483645},{"size":null},{}]'.split("").join("")) as Sized[]) {
  const target = new Entry();
  copySize(target, fake);
  console.log("a stand-in", JSON.stringify(fake) + ":", showEntry(target), exact(total([fake, target])));
}
for (const fake of JSON.parse('[{"pos":0.5,"end":2147483648},{"pos":-2147483648,"end":-2147483644},{"pos":1e21,"end":5e-324}]'.split("").join("")) as TextRange[]) {
  const span = new Span(0, 0);
  copyRange(span, fake);
  console.log("a stand-in", JSON.stringify(fake) + ":", showSpan(span));
}
//// int32-slots/objects-with-narrow-and-wide-number-fields-of-one-name-go-through-one-function.ts
// Two classes have a number field of the same name. In one every store in sight is a small integer, in the other they are fractions. Functions typed by an interface read the field of both kinds.
// No typed code moves a number from the wide field into the narrow one, but built-ins do: Object.assign from instance to instance, Reflect.get and Reflect.set, a spread that is assigned, entries that are copied.
const unknownCodeRuns = process.argv.length > 99;
////= handOver-2
interface Weighted { readonly weight: number }
class Narrow implements Weighted { weight = 1; tag = "n"; }
class Wide implements Weighted { weight = 1.5; tag = "w"; }
////= lines-14	weightOf	item	Weighted	return	item.weight
function addUp(items: Weighted[]) {
  let sum = 0;
  for (const item of items) sum += item.weight;
  return sum;
}
function heaviest(items: Weighted[]) {
  return items.reduce((best, item) => (item.weight > best.weight ? item : best));
}
////= lines-16	setNarrow	item	Narrow	weight	number	item.weight
function growNarrow(item: Narrow) {
  item.weight += item.weight;
}
////= lines-16	setWide	item	Wide	weight	number	item.weight
////= made-5	item
const moves: [string, (from: Wide, to: Narrow) => void][] = [
  ["Object.assign", (from, to) => { Object.assign(to, from); }],
  ["Reflect", (from, to) => { Reflect.set(to, "weight", Reflect.get(from, "weight")); }],
  ["a spread", (from, to) => { Object.assign(to, { ...from }); }],
  ["entries", (from, to) => { for (const [key, value] of Object.entries(from)) (to as any)[key] = value; }],
  ["descriptors", (from, to) => { Object.defineProperties(to, Object.getOwnPropertyDescriptors(from)); }],
];
let sum = 0;
for (let i = 0; i < 2000; i++) {
  const narrow = made(new Narrow()), wide = made(new Wide());
  setNarrow(narrow, i & 15);
  growNarrow(narrow);
  setWide(wide, (i & 15) + 0.5);
  sum += addUp([narrow, wide]) + weightOf(heaviest([narrow, wide]));
}
console.log("warm", sum);
for (const [label, move] of moves) {
  const lines: string[] = [];
  for (const value of odd) {
    const narrow = made(new Narrow()), wide = made(new Wide());
    setWide(wide, value);
    Reflect.apply(move, undefined, [wide, narrow]);
    const moved = `${Object.is(weightOf(narrow), value)} ${exact(narrow.weight)} ${JSON.stringify(narrow)} [${Object.keys(narrow)}]`;
    growNarrow(narrow);
    const grown = exact(narrow.weight);
    const total = exact(addUp([narrow, wide, made(new Narrow())]));
    setNarrow(narrow, 3);
    lines.push(`${moved} ${grown} ${total} ${exact(narrow.weight)}`);
  }
  console.log(label + ":", lines.join(" | "));
}
//// int32-slots/rounded-quotients-and-products-of-integers-are-stored-into-number-fields.ts
// Math.floor(a / b), Math.round(a * b), Math.trunc(a % b), Math.ceil(a / b): the usual way to stay with integers. For integers a and b the results still include
// NaN (0 / 0), the infinities (1 / 0), -0 (Math.ceil(-1 / 2), Math.round(-1 / 4), Math.trunc(-4 % 2), Math.floor(0 / -1)) and 2 ** 31 (-(2 ** 31) / -1). All operands pass through `| 0` first.
const unknownCodeRuns = process.argv.length > 99;
////= handOver-2
class Quotient { floor = 0; ceil = 0; round = 0; trunc = 0; }
class Product { round = 0; abs = 0; }
class Remainder { trunc = 0; max = 0; }
function divide(o: Quotient, a: number, b: number) {
  const x = a | 0, y = b | 0;
  o.floor = Math.floor(x / y);
  o.ceil = Math.ceil(x / y);
  o.round = Math.round(x / y);
  o.trunc = Math.trunc(x / y);
}
function multiply(o: Product, a: number, b: number) {
  const x = a | 0, y = b | 0;
  o.round = Math.round(x * y);
  o.abs = Math.abs(x * y);
}
function remain(o: Remainder, a: number, b: number) {
  const x = a | 0, y = b | 0;
  o.trunc = Math.trunc(x % y);
  o.max = Math.max(x % y, -1);
}
