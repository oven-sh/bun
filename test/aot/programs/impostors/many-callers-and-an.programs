//// many-callers-of-a-function-with-default-parameters-and-an-impostor.js
////= show-5

const log = [];

////= attempt-6

function scale(n, factor = 2) {
  return n * factor;
}

function collect(item, into = []) {
  into.push(item);
  return into.length;
}

function area(size = { w: 2, h: 3 }) {
  return size.w * size.h;
}

function chain(a, b = a + 1, c = b * 2) {
  return a + b + c;
}

let made = 0;

function numbered(id = ++made) {
  return id * 10;
}

function greet(name = "nobody") {
  return name.toUpperCase();
}

function honest(round) {
  console.log(round, "scale", scale(1), scale(2, 3), scale(0.5), scale(-4, 0.5), scale(7, 1), scale(0));
  console.log(round, "collect", collect(1), collect(2, []), collect(3, [1, 2]), collect("a"), collect(4, new Array(1, 2, 3)));
  console.log(round, "area", area(), area({ w: 1, h: 1 }), area({ w: 4, h: 0.5 }), area(), area({ w: 3, h: 3 }));
  console.log(round, "chain", chain(1), chain(1, 2), chain(1, 2, 3), chain(0), chain(-1, 1));
  console.log(round, "numbered", numbered(), numbered(5), numbered(), numbered(0.5), made);
  console.log(round, "greet", greet(), greet("ann"), greet("bob"), greet(""), greet(`c${round}`));
}

const second = [
  ["undefined, which takes the default", () => undefined],
  ["null, which does not", () => null],
  ["a numeric string", () => "3"],
  ["an object with valueOf", () => ({ valueOf: () => (log.push("valueOf"), 3) })],
  ["a BigInt", () => 3n],
  ["an array-like object with push", () => ({ length: 5, push: Array.prototype.push })],
  ["a string", () => "abc"],
  ["an object of another shape", () => ({ h: 2, w: "3" })],
  ["zero", () => 0],
  ["false", () => false],
];

honest("before");
for (const [name, make] of second) {
  attempt("scale(2, " + name + ")", () => scale(2, make()));
  attempt("scale(" + name + ")", () => scale(make()));
  attempt("collect(1, " + name + ")", () => collect(1, make()));
  attempt("area(" + name + ")", () => area(make()));
  attempt("chain(" + name + ")", () => chain(make()));
  attempt("chain(1, " + name + ")", () => chain(1, make()));
  attempt("chain(1, undefined, " + name + ")", () => chain(1, undefined, make()));
  attempt("numbered(" + name + ")", () => numbered(make()) + " made " + made);
  attempt("greet(" + name + ")", () => greet(make()));
  attempt("scale.apply with " + name, () => scale.apply(null, [2, make()]));
  attempt("area through map of " + name, () => [make()].map(area)[0]);
  attempt("greet from hidden code with " + name, () => new Function("f", "value", "return f(value)")(greet, make()));
}
attempt("scale with a hole spread into it", () => scale(...[3, , ]));
attempt("scale.apply with a short array-like", () => scale.apply(null, { length: 2, 0: 3 }));
attempt("the lengths", () => [scale.length, collect.length, area.length, chain.length, numbered.length]);
honest("after");
//// many-callers-of-a-function-with-destructured-parameters-and-an-impostor.js
////= show-5

const log = [];

////= attempt-6

function span({ x, y }) {
  return x - y;
}

function pair([a, b]) {
  return a + b;
}

function named({ name = "nobody", age: years = 0 } = {}) {
  return name + " " + years;
}

function inner({ at: { x, y } }) {
  return x * y;
}

function others({ a, ...rest }) {
  return a + " " + Object.keys(rest).join();
}

function headAndTail([head, ...tail]) {
  return head + " " + tail.length;
}

function honest(round) {
  console.log(round, "span", span({ x: 3, y: 1 }), span({ x: 0.5, y: 0.25 }), span({ x: -1, y: -1 }), span({ x: 9, y: 4 }), span({ x: 1, y: 2 }));
  console.log(round, "pair", pair([1, 2]), pair([0.5, 0.5]), pair([3, 4, 5]), pair(new Array(6, 7)), pair(Array.of(8, 9)));
  console.log(round, "named", named(), named({}), named({ name: "ann" }), named({ age: 3 }), named({ name: "bob", age: 4 }));
  console.log(round, "inner", inner({ at: { x: 2, y: 3 } }), inner({ at: { x: 0.5, y: 4 } }), inner({ at: { x: -1, y: 1 } }));
  console.log(round, "others", others({ a: 1, b: 2, c: 3 }), others({ a: 1 }), others({ b: 2, a: 1 }));
  console.log(round, "headAndTail", headAndTail([1, 2, 3]), headAndTail([1]), headAndTail([]), headAndTail(["a", "b"]));
}

const notObjects = [
  ["getters in the other order", () => ({ get y() { log.push("y"); return 1; }, get x() { log.push("x"); return 3; }, get a() { log.push("a"); return 1; } })],
  ["a proxy", () => new Proxy({ x: 3, y: 1, a: 1, b: 2 }, {
    get: (target, key) => (log.push("get " + String(key)), target[key]),
    ownKeys: target => (log.push("ownKeys"), Reflect.ownKeys(target)),
    getOwnPropertyDescriptor: (target, key) => (log.push("describe " + String(key)), Reflect.getOwnPropertyDescriptor(target, key)),
  })],
  ["members on the prototype", () => Object.create({ x: 3, y: 1, a: 1, name: "proto", age: 9, at: { x: 1, y: 1 } })],
  ["null members", () => ({ x: null, y: null, name: null, age: null, at: null, a: null })],
  ["undefined members", () => ({ x: undefined, y: undefined, name: undefined, age: undefined, at: undefined, a: undefined })],
  ["an array", () => [3, 1]],
  ["a string", () => "xy"],
  ["a number", () => 5],
  ["a function", () => function name() {}],
  ["null", () => null],
  ["undefined", () => undefined],
];

const notArrays = [
  ["a string", () => "ab"],
  ["a Set", () => new Set([1, 2, 3])],
  ["a Map", () => new Map([[1, 2], [3, 4]])],
  ["a generator that says when it is closed", () => (function* () { try { yield 1; yield 2; yield 3; } finally { log.push("closed"); } })()],
  ["an array with its own iterator", () => Object.assign([1, 2], { [Symbol.iterator]: () => (log.push("asked"), [7, 8][Symbol.iterator]()) })],
  ["holes", () => new Array(2)],
  ["a typed array", () => new Uint8Array([250, 10])],
  ["an arguments object", () => (function () { return arguments; })(1, 2)],
  ["an array-like object", () => ({ 0: 1, 1: 2, length: 2 })],
  ["a number", () => 5],
  ["null", () => null],
];

honest("before");
for (const [name, make] of notObjects) {
  attempt("span of " + name, () => span(make()));
  attempt("named of " + name, () => named(make()));
  attempt("inner of " + name, () => inner(make()));
  attempt("others of " + name, () => others(make()));
  attempt("span through call of " + name, () => span.call(null, make()));
  attempt("named as a callback of " + name, () => [make()].map(named)[0]);
}
for (const [name, make] of notArrays) {
  attempt("pair of " + name, () => pair(make()));
  attempt("headAndTail of " + name, () => headAndTail(make()));
  attempt("pair through apply of " + name, () => pair.apply(null, [make()]));
  attempt("headAndTail from hidden code of " + name, () => new Function("f", "value", "return f(value)")(headAndTail, make()));
}
honest("after");
//// many-callers-of-a-function-with-rest-parameters-and-an-impostor.js
////= show-5

const log = [];

////= attempt-6

function sumAll(...numbers) {
  let total = 0;
  for (let i = 0; i < numbers.length; i++) total += numbers[i];
  return total;
}

function largest(...numbers) {
  return Math.max(...numbers);
}

function describe(first, ...rest) {
  return first + ":" + rest.length + ":" + rest.join("-") + ":" + Array.isArray(rest);
}

function grow(...list) {
  list.push(9);
  list[0] = "changed";
  return list.length;
}

function lows(...numbers) {
  return numbers.map(n => n & 3).join();
}

function honest(round) {
  console.log(round, "sumAll", sumAll(1, 2, 3), sumAll(), sumAll(0.5), sumAll(1, 2, 3, 4, 5, 6, 7, 8), sumAll(...[1, 2]), sumAll(-1, 1));
  console.log(round, "largest", largest(1, 2, 3), largest(5), largest(-1, -2), largest(0.5, 0.25), largest(...[7, 8, 9]));
  console.log(round, "describe", describe(1), describe(1, 2), describe(1, 2, 3), describe("a", "b"), describe());
  console.log(round, "grow", grow(), grow(1), grow(1, 2), grow(...[1, 2, 3]));
  console.log(round, "lows", lows(1, 2, 3), lows(4, 5), lows(), lows(255));
}

const lists = [
  ["a string among numbers", () => [1, "2", 3]],
  ["an object with valueOf", () => [1, { valueOf: () => (log.push("valueOf"), 2) }]],
  ["BigInts only", () => [1n, 2n]],
  ["a BigInt among numbers", () => [1, 2n]],
  ["undefined and null", () => [undefined, null]],
  ["a hole", () => [1, , 3]],
  ["an array as one argument", () => [[1, 2]]],
  ["negative zero", () => [-0]],
  ["NaN", () => [1, NaN]],
  ["a symbol", () => [Symbol("s")]],
];

const spreadable = [
  ["a string", () => "12"],
  ["a Set", () => new Set([1, "2"])],
  ["a Map", () => new Map([[1, 2]])],
  ["a generator", () => (function* () { yield 1; yield "2"; })()],
  ["a typed array", () => new Float32Array([1.5, 2.5])],
  ["an arguments object", () => (function () { return arguments; })(1, "2")],
  ["an array-like object", () => ({ length: 2, 0: 1 })],
  ["null", () => null],
];

honest("before");
for (const [name, make] of lists) {
  attempt("sumAll of " + name, () => sumAll(...make()));
  attempt("largest of " + name, () => largest(...make()));
  attempt("describe " + name, () => describe(...make()));
  attempt("lows of " + name, () => lows(...make()));
  attempt("sumAll.apply of " + name, () => sumAll.apply(null, make()));
  attempt("largest through Reflect.apply of " + name, () => Reflect.apply(largest, null, make()));
}
for (const [name, make] of spreadable) {
  attempt("sumAll of the spread of " + name, () => sumAll(...make()));
  attempt("sumAll.apply of " + name, () => sumAll.apply(null, make()));
  attempt("describe the spread of " + name, () => describe(...make()));
  attempt("describe.apply of " + name, () => describe.apply(null, make()));
}
const mine = [1, 2, 3];
attempt("grow does not touch the caller's array", () => [grow(...mine), mine]);
attempt("nor through apply", () => [grow.apply(null, mine), mine]);
attempt("sumAll as a callback of map", () => [1, 2].map(sumAll));
attempt("sumAll as a callback of reduce", () => [1, 2, 3].reduce(sumAll));
attempt("describe as a callback of replace", () => "abc".replace(/(b)/, describe));
attempt("the lengths", () => [sumAll.length, describe.length]);
honest("after");
