function low(n) {
  if (typeof n !== "number") return "not a number";
  return n & 255;
}

function reciprocal(n) {
  if (typeof n !== "number") return "not a number";
  return 1 / n;
}

function whole(n) {
  if (!Number.isInteger(n)) return "not an integer";
  return n | 0;
}

function span(point) {
  if (!(point instanceof Point)) return "not a point";
  return point.x - point.y;
}

