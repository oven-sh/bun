const log = [];

////= attempt-51

class Tools {
  #sumPlainly(list) {
    let sum = 0;
    for (const item of list) sum += item;
    return sum;
  }

  sumPlainly(value) {
    return this.#sumPlainly(value);
  }

  #sumAsCallback(list) {
    let sum = 0;
    for (const item of list) sum += item;
    return sum;
  }

  sumAsCallback(value) {
    return this.#sumAsCallback(value);
  }

  #sumHidden(list) {
    let sum = 0;
    for (const item of list) sum += item;
    return sum;
  }

  sumHidden(value) {
    return this.#sumHidden(value);
  }

  #findPlainly(text) {
    return text.indexOf("b");
  }

  findPlainly(value) {
    return this.#findPlainly(value);
  }

  #findAsCallback(text) {
    return text.indexOf("b");
  }

  findAsCallback(value) {
    return this.#findAsCallback(value);
  }

  #findHidden(text) {
    return text.indexOf("b");
  }

  findHidden(value) {
    return this.#findHidden(value);
  }

  #doublePlainly(n) {
    return n * 2;
  }

  doublePlainly(value) {
    return this.#doublePlainly(value);
  }

  #doubleAsCallback(n) {
    return n * 2;
  }

  doubleAsCallback(value) {
    return this.#doubleAsCallback(value);
  }

  #doubleHidden(n) {
    return n * 2;
  }

  doubleHidden(value) {
    return this.#doubleHidden(value);
  }

  #spanPlainly(point) {
    const { x, y } = point;
    return x - y;
  }

  spanPlainly(value) {
    return this.#spanPlainly(value);
  }

  #spanAsCallback(point) {
    const { x, y } = point;
    return x - y;
  }

  spanAsCallback(value) {
    return this.#spanAsCallback(value);
  }

  #spanHidden(point) {
    const { x, y } = point;
    return x - y;
  }

  spanHidden(value) {
    return this.#spanHidden(value);
  }
}

