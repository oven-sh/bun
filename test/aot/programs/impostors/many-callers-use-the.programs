//// numbers/a-captured-variable-that-is-not-a-number-is-incremented.js
////= show-25

const log = [];

////= impostors-8

function incrementedInside(value) {
  let count = value;
  const step = () => count++;
  return [step(), step(), count];
}

function incrementedOutside(value) {
  let count = value;
  const read = () => count;
  count++;
  return [read(), count];
}

function replacedInside(value) {
  let count = 0;
  const replace = next => {
    count = next;
  };
  count++;
  replace(value);
  count++;
  return [count, count | 0];
}

function addedInside(value) {
  let total = 0;
  const add = amount => {
    total += amount;
  };
  add(1);
  add(value);
  add(1);
  return [total, typeof total];
}

runTable([incrementedInside, incrementedOutside, replacedInside, addedInside], impostors);
//// numbers/a-class-field-initialized-with-a-number-later-holds-something-else.js
////= show-25

class Account {
  balance = 0;
  #secret = 0;
  static opened = 0;

  deposit(amount) {
    this.balance += amount;
    this.#secret += amount;
    Account.opened += 1;
    return this.balance;
  }

  report() {
    return [this.balance, this.balance + 1, this.balance * 2, this.balance | 0, this.#secret, this.#secret + 1, typeof this.balance];
  }

  overwrite(value) {
    this.balance = value;
    this.#secret = value;
  }
}

////= lines-136	Savings	Account	balance	"none yet"

const honest = new Account();
for (let i = 0; i < 2000; i++) honest.deposit(1);
attempt("after 2000 deposits", () => honest.report());

for (const amount of ["5", 0.5, -0, null, undefined, true, 5n, NaN, 2147483647, [5], { valueOf: () => 5 }, Symbol("s")]) {
  attempt("a deposit of " + show(amount), () => {
    const account = new Account();
    account.deposit(1);
    account.deposit(amount);
    return account.report();
  });
  attempt("then an honest deposit after " + show(amount), () => {
    const account = new Account();
    account.deposit(amount);
    account.deposit(1);
    return account.report();
  });
  attempt("overwritten with " + show(amount), () => {
    const account = new Account();
    account.overwrite(amount);
    return account.report();
  });
}

attempt("a subclass redefines the field", () => new Savings().report());
attempt("a subclass redefines the field and deposits", () => {
  const savings = new Savings();
  savings.deposit(1);
  return savings.report();
});
attempt("the field is deleted", () => {
  const account = new Account();
  delete account.balance;
  return [account.report(), account.deposit(1)];
});
attempt("the field becomes an accessor", () => {
  const account = new Account();
  Object.defineProperty(account, "balance", { get: () => "from a getter", set() {} });
  return [account.report(), account.deposit(1)];
});
attempt("the method runs on another object", () => Account.prototype.deposit.call({ balance: "x" }, 1));
attempt("the honest account afterwards", () => [honest.deposit(1), honest.report()]);
