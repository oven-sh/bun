  }
  valueOf() {
    log.push("valueOf");
    return this.level;
  }
  [Symbol.toPrimitive](hint) {
    log.push("toPrimitive " + hint);
    return hint === "string" ? "gauge " + this.level : this.level;
  }
  *[Symbol.iterator]() {
