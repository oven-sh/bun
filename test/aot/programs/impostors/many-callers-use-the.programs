function Timer(start) {
  var self = this;
  var secret = start * 10;
  this.ticks = start;
  this.tick = function () {
    self.ticks++;
    return self.ticks;
  };
  this.tickThis = function () {
    this.ticks++;
    return this.ticks;
  };
  this.peek = function () {
    return secret;
  };
  this.poke = function (value) {
    secret = value;
    return self;
  };
}
