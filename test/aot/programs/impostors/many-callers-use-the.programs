//// mixins-copy-methods-onto-prototypes.cjs
const log = [];

////= show-41

function makeMixin() {
  const mixin = {
    serial: 0,
    tag() {
      return "tagged " + this.title;
    },
    get shout() {
      log.push("get shout of " + show(this.title));
      return String(this.title).toUpperCase();
    },
    [Symbol.for("secret")]() {
      return "secret of " + this.title;
    },
  };
  Object.defineProperty(mixin, "quiet", { value() { return "quiet " + this.title; }, enumerable: false });
  return Object.setPrototypeOf(mixin, { inheritedByTheMixin() { return "inherited " + this.title; } });
}

const copiers = [
  ["Object.assign", (target, source) => Object.assign(target, source)],
  ["a for-in loop", (target, source) => { for (const name in source) target[name] = source[name]; }],
  ["a for-in loop with hasOwnProperty", (target, source) => { for (const name in source) if (Object.prototype.hasOwnProperty.call(source, name)) target[name] = source[name]; }],
  ["Object.keys and forEach", (target, source) => Object.keys(source).forEach(name => { target[name] = source[name]; })],
  ["own names and descriptors", (target, source) => { for (const name of Object.getOwnPropertyNames(source)) Object.defineProperty(target, name, Object.getOwnPropertyDescriptor(source, name)); }],
  ["Object.defineProperties with all descriptors", (target, source) => Object.defineProperties(target, Object.getOwnPropertyDescriptors(source))],
  ["a spread into a new prototype", (target, source, Maker) => { Maker.prototype = { ...target, ...source }; }],
  ["the mixin put into the prototype chain", (target, source) => Object.setPrototypeOf(target, source)],
];

////= lines-5	tagOf	thing	thing.tag

////= lines-7	shoutOf	thing	thing.shout

////= lines-5	titleLineOf	thing	thing.titleLine

for (const [label, copy] of copiers) {
  function Book(title) {
    this.title = title;
  }
  Book.prototype.titleLine = function () {
    return "book " + this.title;
  };
  Book.prototype.tag = function () {
    return "the book's own tag " + this.title;
  };

  const makeBook = title => new Book(title);
  const before = makeBook("before");
  let length = 0;
  for (let i = 0; i < 2000; i++) length += tagOf(before).length + titleLineOf(before).length;
  console.log(label + ": 2000 calls before the mixin", length);

  const mixin = makeMixin();
  attempt(label + ": copy", () => void copy(Book.prototype, mixin, Book));
  const after = makeBook("after");
  for (const [which, book] of [["made before", before], ["made after", after]]) {
    attempt(label + ", " + which + ": tag()", () => tagOf(book));
    attempt(label + ", " + which + ": shout", () => shoutOf(book));
    attempt(label + ", " + which + ": titleLine()", () => titleLineOf(book));
    attempt(label + ", " + which + ": quiet()", () => book.quiet());
    attempt(label + ", " + which + ": inheritedByTheMixin()", () => book.inheritedByTheMixin());
    attempt(label + ", " + which + ": the symbol method", () => book[Symbol.for("secret")]());
  }
  attempt(label + ": shout on the prototype is", () => { const found = Object.getOwnPropertyDescriptor(Book.prototype, "shout"); return found === undefined ? "absent" : "get" in found ? "an accessor" : found.value; });
  attempt(label + ": names on the prototype", () => Object.getOwnPropertyNames(Book.prototype));
  mixin.tag = function () { return "the mixin changed later"; };
  attempt(label + ": after the mixin changed, tag()", () => tagOf(after));
}
//// name-converters-get-values-that-are-not-strings.js
////= show-26

function camelCase(text) {
  return text.replace(/[-_\s]+(.)?/g, function (match, character) {
    return character ? character.toUpperCase() : "";
  });
}

function kebabCase(text) {
  var result = "";
  for (var i = 0; i < text.length; i++) {
    var character = text[i];
    var lower = character.toLowerCase();
    if (character !== lower && i > 0) result += "-";
    result += lower;
  }
  return result;
}

function capitalize(text) {
  return text.charAt(0).toUpperCase() + text.slice(1).toLowerCase();
}

function titleCase(text) {
  return text.split(" ").map(capitalize).join(" ");
}

function leftPad(text, width, filler) {
  text = text + "";
  filler = filler === undefined ? " " : filler + "";
  while (text.length < width && filler.length > 0) text = filler + text;
  return text;
}

function truncate(text, width) {
  if (text.length <= width) return text;
  return text.slice(0, width - 1) + "…";
}

function baseName(path) {
  var end = path.length;
  while (end > 1 && path[end - 1] === "/") end--;
  var start = path.lastIndexOf("/", end - 1) + 1;
  return path.slice(start, end);
}

function extension(path) {
  var name = baseName(path);
  var dot = name.lastIndexOf(".");
  return dot <= 0 ? "" : name.slice(dot);
}

function isUpperCase(text) {
  return text === text.toUpperCase() && text !== text.toLowerCase();
}

function compareVersions(a, b) {
  var left = a.split(".");
  var right = b.split(".");
  for (var i = 0; i < Math.max(left.length, right.length); i++) {
    var difference = (left[i] | 0) - (right[i] | 0);
    if (difference !== 0) return difference < 0 ? -1 : 1;
  }
  return 0;
}

var uses = [
  ["camelCase", camelCase],
  ["kebabCase", kebabCase],
  ["capitalize", capitalize],
  ["titleCase", titleCase],
  ["leftPad", function (value) { return leftPad(value, 8, "."); }],
  ["leftPad with the value as filler", function (value) { return leftPad("x", 4, value); }],
  ["leftPad with the value as width", function (value) { return leftPad("x", value, "."); }],
  ["truncate", function (value) { return truncate(value, 4); }],
  ["baseName", baseName],
  ["extension", extension],
  ["isUpperCase", isUpperCase],
  ["compareVersions", function (value) { return compareVersions(value, "1.2.3"); }],
];

var values = [
  "'hello-big_world now'",
  "'helloBigWorld'",
  "'/usr/local/lib/file.tar.gz'",
  "'dir/'",
  "'1.10.0'",
  "'ABC'",
  "''",
  "'\\u00e9cole-\\u00fcber \\u0130\\u00df'",
  "'a' + '-b'",
  "new String('hello-world')",
  "['hello', 'World']",
  "['a/b', '/', 'c.d']",
  "[1, 2, 3]",
  "{ length: 2, 0: 'A', 1: 'b' }",
  "{ replace() { return 5; }, charAt() { return 'x'; }, slice() { return 'Y'; }, split() { return ['p', 'q']; }, lastIndexOf() { return 0; }, toUpperCase() { return this; }, toLowerCase() { return null; }, length: 9, toString() { return 'look'; } }",
  "Buffer.from('a/b.c')",
  "5",
  "3",
  "'3'",
  "1.5",
  "null",
  "undefined",
  "Symbol('s')",
];

var total = 0;
for (var i = 0; i < 2000; i++) {
  for (var j = 0; j < uses.length; j++) {
    if (j !== 6) total += String(uses[j][1]("hello-World/a.b")).length;
  }
  total += leftPad("x", 3, ".").length;
}
console.log("2000 honest rounds", total);

////= uses-forEach

console.log("bytes made in plain sight", Buffer.from("he").length);
//// native-functions-reached-in-roundabout-ways-change-objects.js
////= show-10

////= Box

////= lines-7	read	box	box.width

////= lines-60	store	box	box.width	5

////= lines-60	add	box	box.depth	6

////= lines-147	remove	box	delete	box.height

////= lines-5	area	box	box.area

function look(box) {
  return [read, area, store, add, remove]
    .map(use => {
      try {
        return show(use(box));
      } catch (error) {
        return error.constructor.name;
      }
    })
    .join(" ") + " | keys " + Object.keys(box).join();
}

const other = { area: () => "another area" };

const natives = [
  ["Object", "freeze", box => [box]],
  ["Object", "seal", box => [box]],
  ["Object", "preventExtensions", box => [box]],
  ["Reflect", "preventExtensions", box => [box]],
  ["Reflect", "deleteProperty", box => [box, "width"]],
  ["Reflect", "set", box => [box, "width", "set"]],
  ["Reflect", "defineProperty", box => [box, "width", { get: () => "got", configurable: true }]],
  ["Object", "defineProperty", box => [box, "width", { value: "fixed", writable: false }]],
  ["Object", "setPrototypeOf", box => [box, other]],
  ["Object", "assign", box => [box, { width: "assigned", extra: 1 }]],
];

const { freeze: pulledOutFreeze } = Object;
const renamed = Object;
const call = Function.prototype.call;

const routes = [
  ["a plain call", (holder, name, inputs) => (holder === "Object" ? Object : Reflect)[name](...inputs)],
  ["a name joined at run time", (holder, name, inputs) => globalThis[holder][name.slice(0, 2) + name.slice(2)](...inputs)],
  ["a holder under another name", (holder, name, inputs) => (holder === "Object" ? renamed : Reflect)[name](...inputs)],
  ["call", (holder, name, inputs) => globalThis[holder][name].call(null, ...inputs)],
  ["apply", (holder, name, inputs) => globalThis[holder][name].apply(null, inputs)],
  ["bind", (holder, name, inputs) => globalThis[holder][name].bind(null, ...inputs)()],
  ["Reflect.apply", (holder, name, inputs) => Reflect.apply(globalThis[holder][name], null, inputs)],
  ["call.call", (holder, name, inputs) => call.call(globalThis[holder][name], null, ...inputs)],
  ["a callable proxy", (holder, name, inputs) => new Proxy(globalThis[holder][name], {})(...inputs)],
  ["its descriptor's value", (holder, name, inputs) => Object.getOwnPropertyDescriptor(globalThis[holder], name).value(...inputs)],
  ["a parameter", (holder, name, inputs) => ((callee, list) => callee(...list))(globalThis[holder][name], inputs)],
  ["a promise reaction", (holder, name, inputs) => Promise.resolve(inputs).then(list => globalThis[holder][name](...list))],
];

for (let i = 0; i < 2000; i++) look(new Box(3, 4));
console.log("honest", look(new Box(3, 4)));

for (const [holder, name, inputsFor] of natives) {
  for (const [route, reach] of routes) {
    const box = new Box(3, 4);
    let line = holder + "." + name + " through " + route + " -> ";
    try {
      await reach(holder, name, inputsFor(box));
      line += look(box);
    } catch (error) {
      line += "threw " + error.constructor.name;
    }
    console.log(line);
  }
}

const handedOver = [
  ["forEach(Object.freeze)", box => [box].forEach(Object.freeze)],
  ["map(Object.seal)", box => [box].map(Object.seal)],
  ["Array.from with Object.freeze", box => Array.from([box], Object.freeze)],
  ["find(Object.isFrozen) after some(Object.freeze)", box => [[box].some(Object.freeze), [box].find(Object.isFrozen)]],
  ["then(Object.freeze)", box => Promise.resolve(box).then(Object.freeze)],
  ["a freeze pulled out of Object", box => pulledOutFreeze(box)],
  ["a Set's forEach", box => new Set([box]).forEach(Object.freeze)],
  ["a Map's forEach", box => new Map([["key", box]]).forEach(Object.freeze)],
  ["a reviver's holder", box => JSON.parse("[1]", function (key, value) { if (key === "0") Object.freeze(box); return value; })],
  ["Object.entries, then freeze each value", box => Object.entries({ box }).forEach(([, value]) => Object.freeze(value))],
  ["freeze of an object that holds it", box => Object.freeze({ box })],
  ["freeze of an array that holds it", box => Object.freeze([box])],
  ["freeze of its prototype's copy", box => Object.freeze(Object.create(box))],
];

for (const [label, reach] of handedOver) {
  const box = new Box(3, 4);
  let line = label + " -> ";
  try {
    await reach(box);
    line += look(box);
  } catch (error) {
    line += "threw " + error.constructor.name;
  }
  console.log(line);
}
console.log("honest again", look(new Box(3, 4)));
