  ["a method", () => ({ method() {} }).method],
  ["an async function", () => async function () {}],
  ["a generator function", () => function* () {}],
  ["Symbol", () => Symbol],
  ["Math.max", () => Math.max],
  ["an object", () => ({})],
  ["a string", () => "Pair"],
  ["undefined", () => undefined],
