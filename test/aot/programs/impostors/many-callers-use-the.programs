// new Function is given literal texts that are early errors in some code and legal in other code: in strict code, in the parameters of an arrow function, in a class. Each throws or gives a function as under plain Bun.
function attempt(make) {
  try {
    return typeof make();
  } catch (error) {
    return error.constructor.name;
  }
}
