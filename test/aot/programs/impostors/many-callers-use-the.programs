////: Point-2
class Point {
  constructor(x, y) {
    this.x = x;
    this.y = y;
  }
  sum() {
    return this.x + this.y;
  }
  reset() {
    this.x = 1;
    return this;
  }
}
////: Stack-2
class Stack extends Array {
  add() {
    this.push(1);
    return this.length;
  }
  all() {
    const seen = [];
    for (const x of this) seen.push(x);
    return seen;
  }
}
