  ["basename", baseName],
  ["dirname", directory],
  ["extname", extension],
  ["join", joined],
  ["normalize", normalized],
  ["isAbsolute", isAbsolute],
  ["format", formatted],
  ["escape", escaped],
  ["parse", parsedQuery],
  ["stringify", builtQuery],
  ["Buffer.from", bufferOf],
  ["toString(encoding)", withEncoding],
  ["isEncoding", isEncoding],
  ["write", written],
  ["alloc fill", filled],
  ["decoder", decoded],
  ["strip", strippedOfColors],
];

