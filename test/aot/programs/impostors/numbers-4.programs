//// numbers/implicit-globals-are-used-as-counters-in-sloppy-code/main.cjs
////= show-25

function start() {
  hits = 0;
  misses = 0;
}

////= lines-223	hit	hits

function miss() {
  misses += 1;
  return misses & 7;
}

function report() {
  return [hits, hits + 1, hits | 0, hits * 2, typeof hits, misses];
}

function throughThis() {
  this.hits++;
  return this.hits;
}

start();
for (var i = 0; i < 2000; i++) {
  hit();
  miss();
  throughThis();
}
console.log("after 2000 honest rounds", show(report()));

var late = [0.5, NaN, 2147483647, -0, "3", "", undefined, null, true, 3n, [4], { valueOf: function () { return 5; } }];
late.forEach(function (value) {
  var label = show(value);
  globalThis.hits = value;
  attempt("globalThis.hits = " + label + ": report", report);
  attempt("globalThis.hits = " + label + ": hit", function () { return [hit(), hits]; });
  globalThis["hi" + "ts"] = value;
  attempt("a computed name stores " + label + ": throughThis", function () { return [throughThis(), hits]; });
  (0, eval)("hits = 1");
  attempt("run-time text stores 1 after " + label, report);
});

attempt("the global is deleted", function () {
  delete globalThis.hits;
  return outcome(report);
});
attempt("incrementing a deleted global", function () { return outcome(hit); });
attempt("typeof a deleted global", function () { return typeof hits; });
attempt("the global becomes an accessor", function () {
  var reads = 0;
  Object.defineProperty(globalThis, "hits", {
    get: function () {
      return ++reads;
    },
    set: function () {},
    configurable: true,
  });
  return [report(), hit(), hit()];
});
attempt("legacy octal literals", function () { return [010, 010 + 1, 08, 09.5, 0777 | 0, -010]; });
delete globalThis.hits;
delete globalThis.misses;
//// numbers/increments-past-the-largest-int32.js
////= show-25

////= variable	++

function variableBefore(start) {
  let n = start | 0;
  const seen = [];
  for (let i = 0; i < 4; i++) seen.push(++n);
  return seen;
}

function field(start) {
  const holder = { n: start | 0 };
  const seen = [];
  for (let i = 0; i < 4; i++) seen.push(holder.n++);
  seen.push(holder.n);
  return seen;
}

function element(start) {
  const list = [start | 0, 1, 2];
  const seen = [];
  for (let i = 0; i < 4; i++) seen.push(list[0]++);
  seen.push(list[0], list);
  return seen;
}

function captured(start) {
  let n = start | 0;
  const next = () => n++;
  return [next(), next(), next(), next(), n];
}

class Ticket {
  static last = 0;
  static next() {
    return ++Ticket.last;
  }
}

function classStatic(start) {
  Ticket.last = start | 0;
  return [Ticket.next(), Ticket.next(), Ticket.next(), Ticket.last];
}

let moduleCounter = 0;

function moduleVariable(start) {
  moduleCounter = start | 0;
  return [moduleCounter++, moduleCounter++, moduleCounter++, moduleCounter];
}

function typedElement(start) {
  const list = new Int32Array([start | 0]);
  const seen = [];
  for (let i = 0; i < 4; i++) seen.push(list[0]++);
  seen.push(list[0]);
  return seen;
}

function plusOne(start) {
  let n = start | 0;
  n = n + 1;
  n = n + 1;
  n = n + 1;
  return [n, n | 0, n >>> 0];
}

const uses = [variable, variableBefore, field, element, captured, classStatic, moduleVariable, typedElement, plusOne];
for (let i = 0; i < 2000; i++) for (const use of uses) use(i);
for (const use of uses) {
  attempt(use.name + " from 5", () => use(5));
  attempt(use.name + " from 2147483645", () => use(2147483645));
  attempt(use.name + " from 2147483647", () => use(2147483647));
  attempt(use.name + " from -2", () => use(-2));
  attempt(use.name + " from 5 again", () => use(5));
}
//// numbers/index-arithmetic-overflows-int32.js
////= show-25

////= lines-225	after	list	i	list[i	1

function before(list, i) {
  return list[i - 1];
}

function twice(list, i) {
  return [list[i * 2], list[i << 1], list[i + i]];
}

function afterInt32(list, i) {
  return list[(i | 0) + 1];
}

function beforeInt32(list, i) {
  return list[(i | 0) - 1];
}

function storedAfter(list, i) {
  list[i + 1] = "stored";
  return [list.length, Object.keys(list).slice(-2)];
}

function offset(list, base, delta) {
  return list[base + delta];
}

function codeAfter(text, i) {
  return [text.charCodeAt(i + 1), text[i + 1], text.charAt(i + 1)];
}

function negated(list, i) {
  return list[-i];
}

function sparse() {
  const list = ["zero", "one", "two"];
  list[2147483647] = "at the largest int32";
  list[2147483648] = "at 2 ** 31";
  list[4294967294] = "at the largest index";
  list[4294967295] = "past the largest index";
  list[4294967296] = "at 2 ** 32";
  list[-1] = "at minus one";
  list[-2147483648] = "at the smallest int32";
  list[-2147483649] = "below the smallest int32";
  return list;
}

const small = ["a", "b", "c", "d"];
for (let i = 0; i < 2000; i++) {
  after(small, i & 1);
  before(small, 1 + (i & 1));
  twice(small, i & 1);
  afterInt32(small, i & 1);
  beforeInt32(small, 1 + (i & 1));
  storedAfter([1, 2], i & 1);
  offset(small, i & 1, 1);
  codeAfter("abcd", i & 1);
  negated(small, 0);
}

const list = sparse();
for (const i of [0, 1, -1, 2147483646, 2147483647, 2147483648, 4294967293, 4294967294, 4294967295, -2147483647, -2147483648, 1073741824, -1073741824, 2147483647.5, -0]) {
  attempt("after(" + show(i) + ")", () => after(list, i));
  attempt("before(" + show(i) + ")", () => before(list, i));
  attempt("twice(" + show(i) + ")", () => twice(list, i));
  attempt("afterInt32(" + show(i) + ")", () => afterInt32(list, i));
  attempt("beforeInt32(" + show(i) + ")", () => beforeInt32(list, i));
  attempt("negated(" + show(i) + ")", () => negated(list, i));
  attempt("codeAfter(" + show(i) + ")", () => codeAfter("abcd", i));
  attempt("typed after(" + show(i) + ")", () => after(new Uint8Array([1, 2, 3]), i));
}
for (const i of [1, 2147483646, 2147483647, 4294967293, 4294967294, -2, -1]) attempt("storedAfter(" + i + ")", () => storedAfter([1, 2], i));
for (const [base, delta] of [[1, 1], [2147483647, 1], [2147483647, 2147483647], [-2147483648, -1], [1073741824, 1073741824], [2147483647, -2147483647], [4294967295, -4294967295], [0.5, 0.5], [0.1, 0.2], ["1", 1], [1, "1"]]) attempt("offset(" + show(base) + ", " + show(delta) + ")", () => offset(list, base, delta));
//// numbers/integer-arithmetic-makes-negative-zero.js
////= show-25

const makers = {
  "0 * -1": (zero, one, five) => zero * -one,
  "-1 * 0": (zero, one, five) => -one * zero,
  "0 * -5 with int32 operands": (zero, one, five) => (zero | 0) * (-five | 0),
  "0 / -5": (zero, one, five) => zero / -five,
  "-5 % 5": (zero, one, five) => -five % five,
  "-5 % -5": (zero, one, five) => -five % -five,
  "5 % 5": (zero, one, five) => five % five,
  "-0 % 5": (zero, one, five) => -zero % five,
  "-(0)": (zero, one, five) => -zero,
  "-(0 | 0)": (zero, one, five) => -(zero | 0),
  "0 - 0": (zero, one, five) => zero - zero,
  "-0 - 0": (zero, one, five) => -zero - zero,
  "-0 + 0": (zero, one, five) => -zero + zero,
  "-0 + -0": (zero, one, five) => -zero + -zero,
  "Math.round(-0.4)": (zero, one, five) => Math.round(-(one * 0.4)),
  "Math.round(-0.5)": (zero, one, five) => Math.round(-(one * 0.5)),
  "Math.ceil(-0.5)": (zero, one, five) => Math.ceil(-(one * 0.5)),
  "Math.trunc(-0.9)": (zero, one, five) => Math.trunc(-(one * 0.9)),
  "Math.floor(-0)": (zero, one, five) => Math.floor(-zero),
  "Math.abs(-0)": (zero, one, five) => Math.abs(-zero),
  "Math.sign(-0)": (zero, one, five) => Math.sign(-zero),
  "Math.sqrt(-0)": (zero, one, five) => Math.sqrt(-zero),
  "Math.min(0, -0)": (zero, one, five) => Math.min(zero, -zero),
  "Math.max(-0, 0)": (zero, one, five) => Math.max(-zero, zero),
  "Math.max(-0, -0)": (zero, one, five) => Math.max(-zero, -zero),
  "(-0) ** 3": (zero, one, five) => (-zero) ** 3,
  "(-0) ** 2": (zero, one, five) => (-zero) ** 2,
  "-1 / Infinity": (zero, one, five) => -one / (one / zero),
  "-0 | 0": (zero, one, five) => -zero | 0,
  "-0 >>> 0": (zero, one, five) => -zero >>> 0,
  "~~-0": (zero, one, five) => ~~-zero,
  "+'-0'": (zero, one, five) => +("-" + zero),
  "Number('-0')": (zero, one, five) => Number("-" + zero),
  "parseInt('-0')": (zero, one, five) => parseInt("-" + zero),
  "parseFloat('-0')": (zero, one, five) => parseFloat("-" + zero),
  "JSON.parse('-0')": (zero, one, five) => JSON.parse("-" + zero),
  "a decrement from 1 times -1": (zero, one, five) => {
    let n = one;
    n--;
    return n * -one;
  },
  "a product in a loop": (zero, one, five) => {
    let product = -one;
    for (let i = five; i >= zero; i--) product *= i;
    return product;
  },
};

const observers = {
  "Object.is(x, -0)": x => Object.is(x, -0),
  "Object.is(x, 0)": x => Object.is(x, 0),
  "1 / x": x => 1 / x,
  "x === 0": x => x === 0,
  "Math.sign(x)": x => Math.sign(x),
  "Math.atan2(x, -1)": x => Math.atan2(x, -1),
  "Math.atan2(0, x)": x => Math.atan2(0, x),
};

for (const name of Object.keys(makers)) for (let i = 1; i < 300; i++) makers[name](i, i + 1, i + 2);
for (const name of Object.keys(makers)) {
  const made = makers[name](0, 1, 5);
  for (const observer of Object.keys(observers)) attempt(name + ": " + observer, () => observers[observer](made));
}
//// numbers/integer-fields-are-read-through-getters-proxies-and-patterns.js
////= show-25

const log = [];

////= lines-30	area	box	box.width	box.height

function areaOfInt32(box) {
  return (box.width | 0) * (box.height | 0);
}

function areaByPattern({ width, height }) {
  return width * height;
}

function areaByPatternWithDefaults({ width = 2, height = 3 }) {
  return width * height;
}

function perimeter(box) {
  const { width, height } = box;
  return (width + height) << 1;
}

function grown(box) {
  box.width++;
  box.height += 1;
  return [box.width, box.height];
}

const uses = [area, areaOfInt32, areaByPattern, areaByPatternWithDefaults, perimeter, grown];
const boxes = {
  "plain": () => ({ width: 4, height: 5 }),
  "the other key order": () => ({ height: 5, width: 4 }),
  "an extra member first": () => ({ depth: 1, width: 4, height: 5 }),
  "own getters": () => ({
    get width() {
      log.push("width");
      return 4;
    },
    get height() {
      log.push("height");
      return 5;
    },
  }),
  "getters that return texts": () => ({
    get width() {
      log.push("width");
      return "4";
    },
    get height() {
      log.push("height");
      return "5";
    },
  }),
  "a getter that counts up": () => {
    let n = 0;
    return {
      get width() {
        return ++n;
      },
      set width(value) {
        log.push("set width " + value);
      },
      height: 5,
    };
  },
  "getters on the prototype": () =>
    Object.create({
      get width() {
        log.push("inherited width");
        return 4;
      },
      get height() {
        log.push("inherited height");
        return 5;
      },
    }),
  "values on the prototype": () => Object.create({ width: 4, height: 5 }),
  "a class with getters": () =>
    new (class {
      #w = 4;
      get width() {
        return this.#w;
      }
      set width(value) {
        this.#w = value * 10;
      }
      get height() {
        return 5;
      }
    })(),
  "a proxy that logs": () =>
    new Proxy(
      { width: 4, height: 5 },
      {
        get(target, key, receiver) {
          log.push("get " + String(key));
          return Reflect.get(target, key, receiver);
        },
        set(target, key, value, receiver) {
          log.push("set " + String(key) + " " + value);
          return Reflect.set(target, key, value, receiver);
        },
      },
    ),
  "a proxy that answers with fractions": () => new Proxy({}, { get: () => 1.5, set: () => true }),
  "a null prototype": () => Object.assign(Object.create(null), { width: 4, height: 5 }),
  "frozen": () => Object.freeze({ width: 4, height: 5 }),
  "one member missing": () => ({ width: 4 }),
  "one member undefined": () => ({ width: 4, height: undefined }),
  "one member null": () => ({ width: 4, height: null }),
  "fractions": () => ({ width: 0.5, height: 5 }),
  "large integers": () => ({ width: 2147483647, height: 2147483647 }),
  "objects with valueOf": () => ({
    width: {
      valueOf() {
        log.push("width valueOf");
        return 4;
      },
    },
    height: {
      valueOf() {
        log.push("height valueOf");
        return 5;
      },
    },
  }),
  "bigints": () => ({ width: 4n, height: 5n }),
  "a bigint and a number": () => ({ width: 4n, height: 5 }),
  "an array": () => Object.assign([], { width: 4, height: 5 }),
  "a function": () => Object.assign(function () {}, { width: 4, height: 5 }),
  "a text": () => "text",
  "a number": () => 7,
};

for (let i = 0; i < 2000; i++) for (const use of uses) use({ width: i, height: 2 });
for (const use of uses) {
  for (const name of Object.keys(boxes)) {
    log.length = 0;
    const result = outcome(() => use(boxes[name]()));
    console.log(use.name, "of", name, "->", result + (log.length ? " after " + log.join(", ") : ""));
  }
  attempt(use.name + " of null", () => use(null));
  attempt(use.name + " of undefined", () => use(undefined));
  attempt(use.name + " of a plain box again", () => use({ width: 4, height: 5 }));
}
//// numbers/integer-quotients-are-rounded-in-every-way.js
////= show-25

function floors(divisor) {
  const seen = [];
  for (let i = -9; i <= 9; i++) seen.push(Math.floor(i / divisor));
  return seen;
}

////= lines-170	ceilings	ceil

////= lines-170	truncations	trunc

////= lines-170	roundings	round

function toInt32(divisor) {
  const seen = [];
  for (let i = -9; i <= 9; i++) seen.push((i / divisor) | 0);
  return seen;
}

function byLiteralDivisors() {
  const seen = { floor3: [], ceil3: [], trunc3: [], round3: [], round2: [], round4: [], or3: [], orMinus3: [], unsigned3: [] };
  for (let i = 0; i <= 12; i++) {
    seen.floor3.push(Math.floor(i / 3));
    seen.ceil3.push(Math.ceil(i / 3));
    seen.trunc3.push(Math.trunc(i / 3));
    seen.round3.push(Math.round(i / 3));
    seen.round2.push(Math.round(i / 2));
    seen.round4.push(Math.round(i / 4));
    seen.or3.push((i / 3) | 0);
    seen.orMinus3.push((i / -3) | 0);
    seen.unsigned3.push((i / -3) >>> 0);
  }
  return seen;
}

function wideDividends(a, b) {
  const wide = (a | 0) * 65536;
  const unsigned = a >>> 0;
  return [(wide / (b | 0)) | 0, Math.floor(wide / 3), (unsigned / (b >>> 0)) | 0, (unsigned / (b >>> 0)) >>> 0, Math.floor(unsigned / 3), Math.round(unsigned / 2), Math.ceil(unsigned / 2), ~~(wide / 7), (wide / 1) | 0, (wide / -1) | 0];
}

function lengths(list, parts) {
  return [Math.floor(list.length / parts), Math.ceil(list.length / parts), Math.round(list.length / parts), (list.length / parts) | 0, list.length / parts];
}

function middleOf(list) {
  return [list[Math.floor(list.length / 2)], list[(list.length / 2) | 0], list[list.length >> 1], list[Math.round(list.length / 2)], list[Math.ceil(list.length / 2)]];
}

for (let i = 1; i < 500; i++) {
  floors(i);
  ceilings(i);
  truncations(i);
  roundings(i);
  toInt32(i);
  wideDividends(i, i);
  lengths([1, 2, 3], i);
  middleOf([1, 2, 3]);
}

for (const divisor of [1, 2, 3, 4, 5, 7, 100]) {
  attempt("floors(" + divisor + ")", () => floors(divisor));
  attempt("ceilings(" + divisor + ")", () => ceilings(divisor));
  attempt("truncations(" + divisor + ")", () => truncations(divisor));
  attempt("roundings(" + divisor + ")", () => roundings(divisor));
  attempt("toInt32(" + divisor + ")", () => toInt32(divisor));
}
for (const divisor of [0, -0, -1, -2, -3, 0.5, 2.5, NaN, Infinity, -Infinity, "2", null, undefined, 2n]) {
  const label = show(divisor);
  attempt("floors(" + label + ")", () => floors(divisor));
  attempt("ceilings(" + label + ")", () => ceilings(divisor));
  attempt("truncations(" + label + ")", () => truncations(divisor));
  attempt("roundings(" + label + ")", () => roundings(divisor));
  attempt("toInt32(" + label + ")", () => toInt32(divisor));
}
const literal = byLiteralDivisors();
for (const key of Object.keys(literal)) attempt("byLiteralDivisors " + key, () => literal[key]);
for (const [a, b] of [[7, 2], [2147483647, 1], [2147483647, -1], [-2147483648, -1], [-2147483648, 1], [-1, 1], [-1, 3], [65535, 0], [0, 0], [0, -1], [123456789, 1000]]) attempt("wideDividends(" + a + ", " + b + ")", () => wideDividends(a, b));
for (const parts of [1, 2, 3, 4, 0, -2, 0.5]) attempt("lengths of five by " + show(parts), () => lengths([1, 2, 3, 4, 5], parts));
attempt("lengths of none", () => lengths([], 2));
attempt("lengths of none by a negative number", () => lengths([], -2));
for (const list of [[], ["a"], ["a", "b"], ["a", "b", "c"], ["a", "b", "c", "d"]]) attempt("middleOf " + list.length, () => middleOf(list));
//// numbers/integer-variables-that-feed-each-other-leave-int32.js
////= show-25

const marks = ["a", "b", "c", "d"];

function fibonacci(count) {
  let a = 0;
  let b = 1;
  for (let i = 0; i < count; i++) {
    const next = a + b;
    a = b;
    b = next;
  }
  return [a, b, marks[a & 3], marks[b & 3]];
}

function fibonacciWithoutATemporary(count) {
  let a = 0;
  let b = 1;
  for (let i = 0; i < count; i++) {
    b = a + b;
    a = b - a;
  }
  return [a, b, marks[a & 3], marks[b & 3]];
}

function doubled(count) {
  let x = 1;
  for (let i = 0; i < count; i++) x = x + x;
  return [x, x | 0, marks[x & 3]];
}

function pingPong(count, step) {
  let low = 0;
  let high = 0;
  for (let i = 0; i < count; i++) {
    low = high + 1;
    high = low + step;
  }
  return [low, high, marks[low & 3], marks[high & 3]];
}

function difference(a, b) {
  let x = 0;
  let y = 0;
  let z = 0;
  x = a | 0;
  y = b | 0;
  z = x - y;
  return [z, z | 0, marks[z & 3], z + 1];
}

function triangle(count) {
  let total = 0;
  let i = 0;
  while (i < count) {
    total = total + i;
    i = i + 1;
  }
  return [total, total | 0, marks[total & 3]];
}

function copied(value) {
  let first = 0;
  let second = 0;
  let third = 0;
  first = value;
  second = first;
  third = second;
  return [third, marks[third], third + 1, marks[second & 3], marks[first & 3]];
}

for (let i = 0; i < 300; i++) {
  fibonacci(i % 20);
  fibonacciWithoutATemporary(i % 20);
  doubled(i % 20);
  pingPong(i % 20, 1);
  difference(i, 3);
  triangle(i % 20);
  copied(i & 3);
}

for (const count of [10, 45, 46, 47, 48, 78, 79, 90]) {
  attempt("fibonacci(" + count + ")", () => fibonacci(count));
  attempt("fibonacciWithoutATemporary(" + count + ")", () => fibonacciWithoutATemporary(count));
}
for (const count of [10, 30, 31, 32, 33, 53, 54, 64, 1023, 1024]) attempt("doubled(" + count + ")", () => doubled(count));
