for (const offset of [-2, -1, 0, 1, 2, 3, 4, 5]) attempt("nearTheLimit(" + offset + ")", () => nearTheLimit(offset));
for (const value of [1, 134217727, 134217728, 268435456, 4294967295, -1]) attempt("kept(" + value + ")", () => kept(value));
