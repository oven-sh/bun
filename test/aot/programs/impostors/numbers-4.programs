//// numbers/bigint-counters-stay-bigints.js
////= show-25

function countUp(start, rounds) {
  let n = start;
  for (let i = 0; i < rounds; i++) n++;
  return n;
}

function countDown(start, rounds) {
  let n = start;
  for (let i = 0; i < rounds; i++) --n;
  return n;
}

function fieldCounter(start, rounds) {
  const holder = { n: start };
  for (let i = 0; i < rounds; i++) holder.n++;
  return holder.n;
}

function elementCounter(start, rounds) {
  const list = [start];
  for (let i = 0; i < rounds; i++) list[0]++;
  return list;
}

function loopOver(from, to) {
  const seen = [];
  for (let i = from; i < to; i++) seen.push(i);
  return seen;
}

function sumOf(list, start) {
  let total = start;
  for (const value of list) total += value;
  return total;
}

function switchesInTheMiddle(rounds, at, replacement) {
  let n = 0;
  const seen = [];
  for (let i = 0; i < rounds; i++) {
    if (i === at) n = replacement;
    n++;
    seen.push(n);
  }
  return seen;
}

function factorial(n, one) {
  let result = one;
  for (let i = one; i <= n; i++) result *= i;
  return result;
}

for (let i = 0; i < 1000; i++) {
  countUp(i, 3);
  countDown(i, 3);
  fieldCounter(i, 3);
  elementCounter(i, 3);
  loopOver(i, i + 2);
  sumOf([1, 2, 3], 0);
  switchesInTheMiddle(3, 9, 0);
  factorial(5, 1);
}

for (const start of [0n, -2n, 2147483646n, 9007199254740991n, 18446744073709551615n, -9223372036854775808n]) {
  attempt("countUp(" + show(start) + ", 3)", () => countUp(start, 3));
  attempt("countDown(" + show(start) + ", 3)", () => countDown(start, 3));
  attempt("fieldCounter(" + show(start) + ", 3)", () => fieldCounter(start, 3));
  attempt("elementCounter(" + show(start) + ", 3)", () => elementCounter(start, 3));
}
attempt("loopOver(0n, 3n)", () => loopOver(0n, 3n));
attempt("loopOver(0n, 3)", () => loopOver(0n, 3));
attempt("loopOver(0, 3n)", () => loopOver(0, 3n));
attempt("loopOver(0n, 2.5)", () => loopOver(0n, 2.5));
attempt("loopOver(0n, '3')", () => loopOver(0n, "3"));
attempt("sumOf bigints from 0n", () => sumOf([1n, 2n, 3n], 0n));
attempt("sumOf bigints from 0", () => sumOf([1n, 2n, 3n], 0));
attempt("sumOf numbers from 0n", () => sumOf([1, 2, 3], 0n));
attempt("sumOf a mix", () => sumOf([1n, 2, 3n], 0n));
attempt("sumOf bigints from a text", () => sumOf([1n, 2n], ""));
attempt("switchesInTheMiddle to a bigint", () => switchesInTheMiddle(5, 2, 10n));
attempt("switchesInTheMiddle to a bigint at the start", () => switchesInTheMiddle(3, 0, 10n));
attempt("switchesInTheMiddle to a boxed bigint", () => switchesInTheMiddle(4, 2, Object(10n)));
attempt("factorial(25n, 1n)", () => factorial(25n, 1n));
attempt("factorial(25, 1)", () => factorial(25, 1));
attempt("factorial(5n, 1)", () => factorial(5n, 1));
attempt("factorial(5, 1n)", () => factorial(5, 1n));
attempt("honest numbers afterwards", () => [countUp(1, 3), countDown(1, 3), fieldCounter(1, 3), elementCounter(1, 3), loopOver(1, 3), sumOf([1, 2], 0)]);
//// numbers/bigints-arrive-out-of-sight-where-only-numbers-were-seen.js
////= show-25

class Square {
  constructor(side) {
    this.side = side;
  }
  area() {
    return this.side * this.side;
  }
  perimeter() {
    return this.side + this.side + this.side + this.side;
  }
  negated() {
    return -this.side;
  }
  grown() {
    this.side++;
    return this.side;
  }
  remainder() {
    return this.side % this.side;
  }
  bits() {
    return [this.side & this.side, this.side | this.side, this.side ^ this.side, ~this.side, this.side << this.side, this.side >> this.side];
  }
  compared() {
    return [this.side < this.side, this.side <= this.side, this.side == this.side, this.side === this.side];
  }
}

////= lines-117	square	x	x

////= lines-45	twice	x	x	x

function opposite(x) {
  return -x;
}

function successor(x) {
  return ++x;
}

function sumOfSquares(a, b) {
  return square(a) + square(b);
}

function describe(value) {
  return [value, typeof value, String(value)];
}

function describeSquare(shape) {
  return [describe(shape.area()), describe(shape.perimeter()), describe(shape.negated()), describe(shape.remainder()), shape.bits(), shape.compared(), describe(shape.grown()), describe(shape.side)];
}

let total = 0;
for (let i = 1; i < 2000; i++) {
  const shape = new Square(i & 15 || 1);
  total += shape.area() + shape.perimeter() + shape.negated() + shape.grown() + shape.remainder() + shape.bits()[0] + square(i) + twice(i) + opposite(i) + successor(i) + sumOfSquares(i, 1);
}
console.log("the honest total", total);

const name = ["si", "de"].join("");
const construct = new Function("constructor", "a", "return new constructor(a);");
const call = new Function("callee", "a", "b", "return callee(a, b);");
const make = side => new Square(side);

for (const text of ["5", "0", "-3", "2147483648", "9007199254740993", "123456789012345678901234567890"]) {
  const big = BigInt(text);
  attempt(text + "n stored under a computed name", () => {
    const shape = new Square(1);
    shape[name] = big;
    return describeSquare(shape);
  });
  attempt(text + "n given by Reflect.construct", () => describeSquare(Reflect.construct(Square, [big])));
  attempt(text + "n given by run-time text", () => describeSquare(construct(Square, big)));
  attempt(text + "n given by Object.assign", () => describeSquare(Object.assign(new Square(1), Object.fromEntries([[name, big]]))));
  attempt(text + "n given by a native callback", () => [big].map(make).map(describeSquare));
  attempt(text + "n mapped by the functions", () => [[big].map(square), [big].map(twice), [big].map(opposite), [big].map(successor)]);
  attempt(text + "n applied to the functions", () => [Reflect.apply(square, null, [big]), Reflect.apply(twice, null, [big]), Reflect.apply(sumOfSquares, null, [big, big])]);
  attempt(text + "n handed over by run-time text", () => [describe(call(square, big)), describe(call(twice, big)), describe(call(sumOfSquares, big, big))]);
  attempt(text + "n and a number handed over by run-time text", () => call(sumOfSquares, big, 1));
}

let again = 0;
for (let i = 1; i < 2000; i++) {
  const shape = new Square(i & 15 || 1);
  again += shape.area() + shape.perimeter() + shape.negated() + shape.grown() + shape.remainder() + shape.bits()[0] + square(i) + twice(i) + opposite(i) + successor(i) + sumOfSquares(i, 1);
}
console.log("the honest total again", again);
//// numbers/bit-tricks-at-the-edges-of-int32.js
////= show-25

const tricks = {
  "sign by a shift": x => x >> 31,
  "sign bit": x => x >>> 31,
  "absolute by a mask": x => (x ^ (x >> 31)) - (x >> 31),
  "absolute by a mask, truncated": x => ((x ^ (x >> 31)) - (x >> 31)) | 0,
  "is a power of two": x => (x & (x - 1)) === 0,
  "lowest set bit": x => x & -x,
  "clear the lowest set bit": x => x & (x - 1),
  "round up to a power of two": x => {
    x--;
    x |= x >> 1;
    x |= x >> 2;
    x |= x >> 4;
    x |= x >> 8;
    x |= x >> 16;
    x++;
    return x;
  },
  "count of set bits": x => {
    x = x - ((x >> 1) & 0x55555555);
    x = (x & 0x33333333) + ((x >> 2) & 0x33333333);
    return (((x + (x >> 4)) & 0x0f0f0f0f) * 0x01010101) >> 24;
  },
  "count of set bits by a loop": x => {
    let count = 0;
    while (x) {
      x &= x - 1;
      count++;
    }
    return count;
  },
  "rotate left by 8": x => (x << 8) | (x >>> 24),
  "rotate left by 8, unsigned": x => ((x << 8) | (x >>> 24)) >>> 0,
};

function swapByXor(a, b) {
  a ^= b;
  b ^= a;
  a ^= b;
  return [a, b];
}

function averageWithoutOverflow(a, b) {
  return (a & b) + ((a ^ b) >> 1);
}

function minimumWithoutABranch(a, b) {
  return b ^ ((a ^ b) & -(a < b));
}

const values = [0, 1, -1, 2, 5, 255, 256, 65535, 65536, 1073741824, 2147483647, -2147483648, -2147483647, 2147483648, 4294967295, 4294967296, -0, 1.5, -1.5, NaN];
for (const name of Object.keys(tricks)) for (let i = 1; i < 1000; i++) tricks[name](i);
for (const name of Object.keys(tricks)) for (const value of values) attempt(name + " of " + show(value), () => tricks[name](value));
for (const [a, b] of [[1, 2], [2147483647, -2147483648], [2147483647, 2147483647], [-2147483648, -2147483648], [-1, 1], [4294967295, 1], [1.5, 2.5]]) {
  attempt("swapByXor(" + a + ", " + b + ")", () => swapByXor(a, b));
  attempt("averageWithoutOverflow(" + a + ", " + b + ")", () => averageWithoutOverflow(a, b));
  attempt("minimumWithoutABranch(" + a + ", " + b + ")", () => minimumWithoutABranch(a, b));
}
//// numbers/both-operands-are-objects-and-the-order-of-their-conversions-shows.js
////= show-25

const log = [];

function logged(name, result) {
  return {
    [Symbol.toPrimitive](hint) {
      log.push(name + ":" + hint);
      if (result instanceof Error) throw result;
      return result;
    },
  };
}

const operators = {
  subtract: (a, b) => a - b,
  multiply: (a, b) => a * b,
  divide: (a, b) => a / b,
  remainder: (a, b) => a % b,
  power: (a, b) => a ** b,
  add: (a, b) => a + b,
  less: (a, b) => a < b,
  atMost: (a, b) => a <= b,
  more: (a, b) => a > b,
  atLeast: (a, b) => a >= b,
  looselyEqual: (a, b) => a == b,
  strictlyEqual: (a, b) => a === b,
  and: (a, b) => a & b,
  or: (a, b) => a | b,
  xor: (a, b) => a ^ b,
  shiftLeft: (a, b) => a << b,
  shiftRight: (a, b) => a >> b,
  shiftRightUnsigned: (a, b) => a >>> b,
  max: (a, b) => Math.max(a, b),
  min: (a, b) => Math.min(a, b),
  pow: (a, b) => Math.pow(a, b),
  atan2: (a, b) => Math.atan2(a, b),
  imul: (a, b) => Math.imul(a, b),
  hypot: (a, b) => Math.hypot(a, b),
};

const pairs = [
  ["numbers", () => [logged("left", 7), logged("right", 2)]],
  ["strings", () => [logged("left", "7"), logged("right", "2")]],
  ["a number and a bigint", () => [logged("left", 7), logged("right", 2n)]],
  ["bigints", () => [logged("left", 7n), logged("right", 2n)]],
  ["the left one throws", () => [logged("left", new RangeError("left")), logged("right", 2)]],
  ["the right one throws", () => [logged("left", 7), logged("right", new EvalError("right"))]],
  ["a symbol on the left", () => [logged("left", Symbol("s")), logged("right", 2)]],
  ["a symbol on the right", () => [logged("left", 7), logged("right", Symbol("s"))]],
  ["a plain number on the left", () => [7, logged("right", 2)]],
  ["a plain number on the right", () => [logged("left", 7), 2]],
];

for (const name of Object.keys(operators)) {
  for (let i = 0; i < 300; i++) operators[name](i, 3);
  for (const [label, make] of pairs) {
    log.length = 0;
    const [a, b] = make();
    const result = outcome(() => operators[name](a, b));
    console.log(name, "of", label, "->", result, "after", log.join(", ") || "nothing");
  }
}
