//// numbers/constructor-functions-with-number-members-get-impostors.js
////= show-25

var inherits = require("util").inherits;

function Vector(x, y) {
  this.x = x;
  this.y = y;
}
Vector.prototype.plus = function (other) {
  return new Vector(this.x + other.x, this.y + other.y);
};
Vector.prototype.times = function (factor) {
  return new Vector(this.x * factor, this.y * factor);
};
Vector.prototype.dot = function (other) {
  return this.x * other.x + this.y * other.y;
};
Vector.prototype.cell = function () {
  return [this.x | 0, this.y >> 1];
};
Vector.prototype.step = function () {
  this.x++;
  this.y -= 1;
  return this;
};
Vector.prototype.list = function () {
  return [this.x, this.y];
};

function Vector3(x, y, z) {
  Vector.call(this, x, y);
  this.z = z;
}
Vector3.prototype = Object.create(Vector.prototype);
Vector3.prototype.constructor = Vector3;
Vector3.prototype.list = function () {
  return Vector.prototype.list.call(this).concat([this.z]);
};

function Weighted(x, y, weight) {
  Vector.call(this, x, y);
  this.weight = weight;
}
inherits(Weighted, Vector);
Weighted.prototype.dot = function (other) {
  return Vector.prototype.dot.call(this, other) * this.weight;
};

var total = 0;
for (var i = 0; i < 2000; i++) {
  var a = new Vector(i, 1);
  var b = new Vector3(1, i, 2);
  var c = new Weighted(i, i, 2);
  total += a.plus(b).dot(c) + a.times(2).x + a.cell()[0] + b.step().y + c.dot(a);
}
console.log("the honest total", total);

var impostors = ["3", "", 0.5, -0, null, undefined, true, 3n, NaN, 2147483647, [3], { valueOf: function () { return 3; } }, Symbol("s")];
impostors.forEach(function (value) {
  var label = show(value);
  attempt("new Vector(" + label + ", 1).plus", function () { return new Vector(value, 1).plus(new Vector(1, 1)).list(); });
  attempt("plus(new Vector(" + label + ", 1))", function () { return new Vector(1, 1).plus(new Vector(value, 1)).list(); });
  attempt("new Vector(" + label + ", 1).times(2)", function () { return new Vector(value, 1).times(2).list(); });
  attempt("new Vector(1, 1).times(" + label + ")", function () { return new Vector(1, 1).times(value).list(); });
  attempt("new Vector(" + label + ", 1).dot", function () { return new Vector(value, 1).dot(new Vector(2, 2)); });
  attempt("new Vector(" + label + ", " + label + ").cell", function () { return new Vector(value, value).cell(); });
  attempt("new Vector(" + label + ", " + label + ").step", function () { return new Vector(value, value).step().list(); });
  attempt("new Vector3(1, 1, " + label + ").list", function () { return new Vector3(1, 1, value).list(); });
  attempt("new Weighted(1, 1, " + label + ").dot", function () { return new Weighted(1, 1, value).dot(new Vector(2, 2)); });
});

attempt("plus of a plain object", function () { return new Vector(1, 1).plus({ x: "1", y: 1 }).list(); });
attempt("plus of an object without y", function () { return new Vector(1, 1).plus({ x: 1 }).list(); });
attempt("plus of a number", function () { return new Vector(1, 1).plus(5).list(); });
attempt("plus of null", function () { return new Vector(1, 1).plus(null).list(); });
attempt("a method borrowed by a plain object", function () { return Vector.prototype.dot.call({ x: "2", y: "3" }, { x: 2, y: 3 }); });
attempt("a method borrowed by an array", function () { return Vector.prototype.cell.call(Object.assign([], { x: 1.9, y: 5 })); });
attempt("called without new in sloppy code", function () {
  var before = typeof globalThis.x;
  var result = Vector("leaked", 1);
  var seen = [before, result, globalThis.x, globalThis.y];
  delete globalThis.x;
  delete globalThis.y;
  return seen;
});
attempt("too few arguments", function () { return new Vector(1).plus(new Vector(1, 1)).list(); });
attempt("a member on the prototype", function () {
  Vector.prototype.z = "inherited";
  var seen = [new Vector(1, 1).z, new Vector3(1, 1, 5).z];
  delete Vector.prototype.z;
  return seen;
});
attempt("honest vectors afterwards", function () { return [new Vector(1, 2).plus(new Vector(3, 4)).list(), new Vector(1, 2).dot(new Vector(3, 4)), new Weighted(1, 2, 3).dot(new Vector(3, 4))]; });
//// numbers/constructors-that-only-see-integer-arguments-are-called-out-of-sight.js
////= show-25

class Point {
  constructor(x, y) {
    this.x = x;
    this.y = y;
  }
  sum() {
    return this.x + this.y;
  }
  cell() {
    return [this.x | 0, this.y & 15];
  }
  moved() {
    this.x++;
    this.y -= 1;
    return [this.x, this.y];
  }
}

////= lines-351	Size
////= lines-162	Size	area	width	height
Size.prototype.grown = function () {
  this.width += 1;
  return [this.width, this.height];
};

////= lines-256	makePair	first	second

function pairSum(pair) {
  return [pair.first + pair.second, pair.first | 0, pair.second * 2];
}

let total = 0;
for (let i = 0; i < 2000; i++) {
  const point = new Point(i, 1);
  const size = new Size(i, 2);
  total += point.sum() + point.cell()[0] + point.moved()[0] + size.area() + size.grown()[0] + pairSum(makePair(i, 3))[0];
}
console.log("the honest total", total);

const construct = new Function("constructor", "a", "b", "return new constructor(a, b);");
const call = new Function("callee", "a", "b", "return callee(a, b);");
const late = JSON.parse('["3", "", 0.5, -0, null, true, 2147483647, 2147483648, -2147483647, [3], {}]').concat([undefined, NaN, 3n]);

function describePoint(point) {
  return [point.x, point.y, outcome(() => point.sum()), outcome(() => point.cell()), outcome(() => point.moved()), Object.keys(point)];
}

function describeSize(size) {
  return [size.width, size.height, outcome(() => size.area()), outcome(() => size.grown())];
}

for (const value of late) {
  const label = show(value);
  attempt("run-time text makes a Point of " + label, () => describePoint(construct(Point, value, 1)));
  attempt("run-time text makes a Point with a second " + label, () => describePoint(construct(Point, 1, value)));
  attempt("Reflect.construct makes a Point of " + label, () => describePoint(Reflect.construct(Point, [value, value])));
  attempt("a bound constructor makes a Point of " + label, () => describePoint(new (Point.bind(null, ...[value]))(1)));
  attempt("run-time text makes a Size of " + label, () => describeSize(construct(Size, value, 2)));
  attempt("apply fills a Size with " + label, () => {
    const size = Object.create(Size.prototype);
    Size.apply(size, [value, 2]);
    return describeSize(size);
  });
  attempt("run-time text makes a pair of " + label, () => pairSum(call(makePair, value, 3)));
  attempt("map makes pairs of " + label, () => [value].map(makePair).map(pairSum));
}
attempt("run-time text leaves out the arguments", () => describePoint(construct(Point)));
attempt("honest objects afterwards", () => [describePoint(new Point(1, 2)), describeSize(new Size(3, 4)), pairSum(makePair(1, 2))]);
//// numbers/counters-kept-in-an-object-used-as-a-dictionary.js
////= show-25

////= lines-171	countWithOr	words	word

function countWithIncrement(words) {
  const counts = {};
  for (const word of words) counts[word]++;
  return counts;
}

////= countWithIn	words

function countWithNullish(words) {
  const counts = {};
  for (const word of words) {
    counts[word] ??= 0;
    counts[word] += 1;
  }
  return counts;
}

function countWithoutAPrototype(words) {
  const counts = Object.create(null);
  for (const word of words) counts[word] = (counts[word] || 0) + 1;
  return Object.keys(counts).map(key => key + "=" + show(counts[key]));
}

function countInAMap(words) {
  const counts = new Map();
  for (const word of words) counts.set(word, (counts.get(word) || 0) + 1);
  return [...counts].map(([key, count]) => show(key) + "=" + show(count));
}

function countInAnArray(numbers) {
  const counts = [];
  for (const n of numbers) counts[n] = (counts[n] || 0) + 1;
  return [counts.length > 50 ? counts.length : counts, Object.keys(counts)];
}

function described(counts) {
  return Object.keys(counts).map(key => key + "=" + (typeof counts[key] === "number" ? show(counts[key]) : typeof counts[key]));
}

const honest = ["a", "b", "a", "c", "a"];
for (let i = 0; i < 1000; i++) {
  countWithOr(honest);
  countWithIncrement(honest);
  countWithIn(honest);
  countWithNullish(honest);
  countWithoutAPrototype(honest);
  countInAMap(honest);
  countInAnArray([1, 2, 1]);
}

const lists = {
  "plain words": honest,
  "names of Object.prototype": ["constructor", "toString", "constructor", "valueOf", "hasOwnProperty"],
  "__proto__": ["__proto__", "__proto__", "a"],
  "numbers and their texts": [1, "1", 1.0, "01", 1n, true, "true"],
  "zeros": [0, -0, "0", "-0"],
  "odd keys": [null, undefined, NaN, "null", "undefined", "NaN", ""],
  "large and small numbers": [1e21, 1e-7, 2 ** 32, 2 ** 32 - 2, -1, 1.5],
  "arrays and objects": [[1], "1", [1, 2], "1,2", {}, "[object Object]"],
};
for (const name of Object.keys(lists)) {
  attempt("countWithOr of " + name, () => described(countWithOr(lists[name])));
  attempt("countWithIncrement of " + name, () => described(countWithIncrement(lists[name])));
  attempt("countWithIn of " + name, () => described(countWithIn(lists[name])));
  attempt("countWithNullish of " + name, () => described(countWithNullish(lists[name])));
  attempt("countWithoutAPrototype of " + name, () => countWithoutAPrototype(lists[name]));
  attempt("countInAMap of " + name, () => countInAMap(lists[name]));
  attempt("countInAnArray of " + name, () => countInAnArray(lists[name]));
}
attempt("a symbol as a word", () => Reflect.ownKeys(countWithOr([Symbol.iterator, Symbol.iterator])).length);
//// numbers/decrements-below-the-smallest-int32.js
////= show-25

////= variable	--

function variableBefore(start) {
  let n = start | 0;
  const seen = [];
  for (let i = 0; i < 4; i++) seen.push(--n);
  return seen;
}

function field(start) {
  const holder = { n: start | 0 };
  const seen = [];
  for (let i = 0; i < 4; i++) seen.push(--holder.n);
  return seen;
}

function element(start) {
  const list = [start | 0, 1, 2];
  const seen = [];
  for (let i = 0; i < 4; i++) seen.push(--list[0]);
  seen.push(list);
  return seen;
}

function captured(start) {
  let n = start | 0;
  const previous = () => --n;
  return [previous(), previous(), previous(), n];
}

function minusAssign(start) {
  let n = start | 0;
  n -= 1;
  n -= 1;
  n -= 1;
  return [n, n | 0, n >>> 0];
}

function countdownToZero(start) {
  let n = start | 0;
  let steps = 0;
  while (n-- > 0) steps++;
  return [steps, n];
}

const uses = [variable, variableBefore, field, element, captured, minusAssign];
for (let i = 0; i < 2000; i++) for (const use of uses) use(i);
for (const use of uses) {
  attempt(use.name + " from 5", () => use(5));
  attempt(use.name + " from -2147483646", () => use(-2147483646));
  attempt(use.name + " from -2147483648", () => use(-2147483648));
  attempt(use.name + " from 1", () => use(1));
}
attempt("countdownToZero from 3", () => countdownToZero(3));
attempt("countdownToZero from 0", () => countdownToZero(0));
attempt("countdownToZero from -2147483648", () => countdownToZero(-2147483648));
//// numbers/digits-parsed-by-hand-overflow-int32.js
////= show-25

function parseDigits(text) {
  let n = 0;
  for (let i = 0; i < text.length; i++) n = n * 10 + (text.charCodeAt(i) - 48);
  return n;
}

function parseDigitsAsInt32(text) {
  let n = 0;
  for (let i = 0; i < text.length; i++) n = (n * 10 + (text.charCodeAt(i) - 48)) | 0;
  return n;
}

function parseDigitsWithShifts(text) {
  let n = 0;
  for (let i = 0; i < text.length; i++) n = (n << 3) + (n << 1) + (text.charCodeAt(i) & 15);
  return n;
}

////= lines-334	parseHex	n * 16 +

////= lines-334	parseHexWithShifts	(n << 4) |

function parseSigned(text) {
  let sign = 1;
  let i = 0;
  if (text[0] === "-") {
    sign = -1;
    i = 1;
  }
  let n = 0;
  for (; i < text.length; i++) n = n * 10 + (text.charCodeAt(i) - 48);
  return sign * n;
}

function codeBeyondTheEnd(text, at) {
  const code = text.charCodeAt(at);
  return [code, code - 48, code | 0, (code - 48) | 0, code === code];
}

function sumOfCodes(text) {
  let total = 0;
  for (let i = 0; i <= text.length; i++) total += text.charCodeAt(i);
  return total;
}

const uses = [parseDigits, parseDigitsAsInt32, parseDigitsWithShifts, parseSigned];
for (let i = 0; i < 2000; i++) {
  for (const use of uses) use(String(i));
  parseHex(i.toString(16));
  parseHexWithShifts(i.toString(16));
  codeBeyondTheEnd("abc", i % 3);
}

