//// numbers/literal-tables-hold-numbers-at-the-edges.js
////= show-25

const ZEROS = [0, -0, 0, -0];
const ONLY_NEGATIVE_ZERO = [-0];
const LIMITS = [2147483647, 2147483648, -2147483648, -2147483649, 4294967295, 4294967296];
const SMALLEST = [-2147483648, -2147483647, -2147483646, -2147483645, -2147483644, -2147483643];
const SPECIAL = [NaN, Infinity, -Infinity, 1e400, -1e400, 5e-324, 1.7976931348623157e308];
const FRACTIONS = [0.5, 1.5, 0.1, 1e21, 1e-7, 9007199254740993];
const INTEGERS_AND_A_FRACTION = [1, 2, 3, 4.5];
const INTEGERS_AND_A_HOLE = [1, , 3];
const INTEGERS_AND_UNDEFINED = [1, undefined, 3];
const INTEGERS_AND_NULL = [1, null, 3];
const INTEGERS_AND_A_TEXT = [1, "2", 3];
const INTEGERS_AND_A_BIGINT = [1, 2n, 3];
const FRACTIONS_AND_A_HOLE = [0.5, , 1.5];
const NESTED = [[0, -0], [1, 2.5], [[-0]]];
const RECORD = { zero: 0, negativeZero: -0, nan: NaN, largest: 2147483647, above: 2147483648, smallest: -2147483648, reserved: -2147483647, alsoReserved: -2147483646, third: -2147483645, fraction: 0.5, huge: 1e21 };
const RECORDS = [
  { n: 1, m: 0 },
  { n: -0, m: -2147483647 },
  { n: 2.5, m: -2147483646 },
  { n: NaN, m: -2147483645 },
  { n: 2147483648, m: undefined },
  { n: "6", m: null },
];
const FROZEN = Object.freeze([0, -0, NaN]);

function fresh() {
  return {
    zeros: [0, -0],
    limits: [2147483647, 2147483648, -2147483648, -2147483649],
    smallest: [-2147483648, -2147483647, -2147483646, -2147483645],
    record: { zero: 0, negativeZero: -0, nan: NaN, reserved: -2147483647, alsoReserved: -2147483646, third: -2147483645 },
    hole: [1, , -0],
  };
}

////= sum

function signs(list) {
  const result = [];
  for (let i = 0; i < list.length; i++) result.push(1 / list[i]);
  return result;
}

function column(records, name) {
  const result = [];
  for (let i = 0; i < records.length; i++) result.push(records[i][name]);
  return result;
}

const tables = { ZEROS, ONLY_NEGATIVE_ZERO, LIMITS, SMALLEST, SPECIAL, FRACTIONS, INTEGERS_AND_A_FRACTION, INTEGERS_AND_A_HOLE, INTEGERS_AND_UNDEFINED, INTEGERS_AND_NULL, INTEGERS_AND_A_TEXT, INTEGERS_AND_A_BIGINT, FRACTIONS_AND_A_HOLE, FROZEN };
for (const round of ["first", "second"]) {
  for (const name of Object.keys(tables)) {
    attempt(round + " " + name, () => tables[name]);
    attempt(round + " sum of " + name, () => sum(tables[name]));
    attempt(round + " JSON of " + name, () => JSON.stringify(tables[name]));
  }
  attempt(round + " signs of ZEROS", () => signs(ZEROS));
  attempt(round + " signs of ONLY_NEGATIVE_ZERO", () => signs(ONLY_NEGATIVE_ZERO));
  attempt(round + " NESTED", () => NESTED);
  attempt(round + " RECORD", () => RECORD);
  attempt(round + " RECORD members", () => [RECORD.negativeZero, 1 / RECORD.negativeZero, RECORD.nan, RECORD.reserved, RECORD.alsoReserved, RECORD.third, RECORD.smallest, RECORD.above]);
  attempt(round + " RECORD keys", () => Object.keys(RECORD));
  attempt(round + " column n", () => column(RECORDS, "n"));
  attempt(round + " column m", () => column(RECORDS, "m"));
  attempt(round + " members n and m", () => RECORDS.map(record => [record.n, record.m, typeof record.m, "m" in record]));
  attempt(round + " fresh", () => fresh());
  attempt(round + " fresh members", () => {
    const made = fresh();
    return [made.zeros[1], 1 / made.zeros[1], made.record.negativeZero, made.record.reserved, made.record.alsoReserved, made.record.third, 1 in made.hole, made.hole[2]];
  });
  attempt(round + " includes and indexOf", () => [ZEROS.includes(-0), ZEROS.indexOf(-0), SPECIAL.includes(NaN), SPECIAL.indexOf(NaN), INTEGERS_AND_A_HOLE.includes(undefined), INTEGERS_AND_A_HOLE.indexOf(undefined)]);
  attempt(round + " copies", () => [[...ZEROS], ZEROS.slice(), ZEROS.concat(ONLY_NEGATIVE_ZERO), Array.from(ZEROS), ZEROS.map(x => x), structuredClone(ZEROS)]);
  for (let i = 0; i < 500; i++) {
    sum(ZEROS);
    sum(LIMITS);
    signs(ZEROS);
    column(RECORDS, "n");
    fresh();
  }
}
//// numbers/local-arrays-filled-with-zeros-or-flags-get-other-values.js
////= show-25

function primesBelow(n) {
  const crossedOut = new Array(n).fill(false);
  const primes = [];
  for (let candidate = 2; candidate < n; candidate++) {
    if (!crossedOut[candidate]) {
      primes.push(candidate);
      let multiple = candidate * candidate;
      while (multiple < n) {
        crossedOut[multiple] = true;
        multiple += candidate;
      }
    }
  }
  return primes;
}

function histogram(values, buckets) {
  const counts = new Array(buckets).fill(0);
  for (let i = 0; i < values.length; i++) counts[values[i]]++;
  let text = "";
  for (let i = 0; i < buckets; i++) text += counts[i] + ",";
  return text;
}

function storedValue(value) {
  const cells = new Array(4).fill(0);
  cells[1] = value;
  return [cells[0], cells[1], typeof cells[1], cells[1] + 1];
}

function storedFlag(value) {
  const flags = new Array(4).fill(false);
  flags[1] = value;
  return [flags[0], flags[1], typeof flags[1], flags[1] ? "truthy" : "falsy"];
}

function storedAt(index) {
  const cells = new Array(4).fill(0);
  cells[index] = 7;
  return [cells[0], cells[3], cells[index], cells.length];
}

function readAt(index) {
  const cells = new Array(4).fill(5);
  return [cells[index], typeof cells[index]];
}

function accumulated(step) {
  const cells = new Array(2).fill(0);
  for (let i = 0; i < 4; i++) cells[0] += step;
  return [cells[0], cells[1]];
}

function incrementedFrom(start) {
  const cells = new Array(2).fill(start);
  cells[0]++;
  cells[0]++;
  cells[1]--;
  return [cells[0], cells[1]];
}

function withoutFill(n) {
  const cells = new Array(n);
  let total = 0;
  for (let i = 0; i < n; i++) total += cells[i];
  return [total, cells.length, 0 in cells];
}

function filledWith(value) {
  const cells = new Array(3).fill(value);
  return [cells[0], cells[2], Object.is(cells[0], value), cells[0] + cells[1]];
}

function lengthOf(n) {
  const cells = new Array(n).fill(0);
  return cells.length;
}

for (let i = 0; i < 300; i++) {
  primesBelow(30);
  histogram([1, 2, 2, 3], 5);
  storedValue(i);
  storedFlag(i % 2 === 0);
  storedAt(i & 3);
  readAt(i & 3);
  accumulated(1);
  incrementedFrom(i);
  withoutFill(2);
  filledWith(i);
  lengthOf(3);
}

attempt("primesBelow(30)", () => primesBelow(30));
for (const n of [0, 1, 2, 2.5, -1, NaN, "10", null, undefined, 4294967296, 10n, [10], true]) attempt("primesBelow(" + show(n) + ")", () => primesBelow(n));
attempt("histogram in range", () => histogram([0, 1, 1, 4], 5));
attempt("histogram past the end", () => histogram([0, 5, 9], 5));
attempt("histogram below zero", () => histogram([0, -1], 5));
attempt("histogram of fractions", () => histogram([0, 1.5, 1.0], 5));
attempt("histogram of texts", () => histogram(["0", "1", "x", "length"], 5));
attempt("histogram of nothing", () => histogram([undefined, null, NaN], 5));
const values = [1, 127, 128, 255, 256, 65536, 2147483647, 2147483648, -1, -2147483648, -2147483649, 0.5, -0, NaN, Infinity, "1", "", null, undefined, true, false, 1n, [1], {}];
for (const value of values) {
  attempt("storedValue(" + show(value) + ")", () => storedValue(value));
  attempt("storedFlag(" + show(value) + ")", () => storedFlag(value));
  attempt("filledWith(" + show(value) + ")", () => filledWith(value));
  attempt("accumulated(" + show(value) + ")", () => accumulated(value));
  attempt("incrementedFrom(" + show(value) + ")", () => incrementedFrom(value));
}
for (const index of [0, 3, 4, 10, -1, 1.5, -0, NaN, "1", "01", "length", null, undefined, 4294967294, 4294967295, 1n]) {
  attempt("storedAt(" + show(index) + ")", () => storedAt(index));
  attempt("readAt(" + show(index) + ")", () => readAt(index));
}
for (const n of [0, 3, 2.5, -1, "3", NaN, null, undefined, true, [3], 4294967296]) {
  attempt("withoutFill(" + show(n) + ")", () => withoutFill(n));
  attempt("lengthOf(" + show(n) + ")", () => lengthOf(n));
}
//// numbers/local-variables-survive-when-an-impostor-arrives-in-the-middle-of-a-function.js
////= show-25

function manyLocals(value, list) {
  let count = 3;
  let ratio = 0.25;
  let label = "label";
  let flag = true;
  let nothing = null;
  let missing;
  let big = 2147483647;
  let negative = -0;
  let object = { member: 1 };
  let items = [1, 2];
  let large = 10n;
  const closure = () => count + ratio;
  count++;
  ratio *= 2;
  label += "!";
  items.push(count);
  object.member += count;
  big++;
  const result = value * 2;
  count++;
  ratio += 1;
  label += "?";
  items.push(count);
  object.member += count;
  large++;
  return [result, count, ratio, label, flag, nothing, missing, big, negative, object, items, large, closure(), list.length];
}

function localsAcrossALoop(list) {
  let sum = 0;
  let product = 1;
  let text = "";
  let last = -1;
  let fractions = 0.5;
  const seen = [];
  for (let i = 0; i < list.length; i++) {
    const item = list[i];
    text += i;
    fractions += 0.25;
    sum += item | 0;
    product *= item;
    last = i;
    seen.push(sum);
  }
  return [sum, product, text, last, fractions, seen];
}

function nestedLoops(grid) {
  let total = 0;
  let cells = 0;
  const rows = [];
  for (let y = 0; y < grid.length; y++) {
    let rowTotal = 0;
    for (let x = 0; x < grid[y].length; x++) {
      cells++;
      rowTotal += grid[y][x] * (x + 1);
    }
    rows.push(rowTotal);
    total += rowTotal;
  }
  return [total, cells, rows];
}

function parametersAreReassigned(a, b, c) {
  a = a + 1;
  b = b * 2;
  c = c | 0;
  const first = [a, b, c];
  a += b;
  b -= c;
  c ^= a;
  return [first, a, b, c];
}

function switchInALoop(codes) {
  let state = 0;
  const trail = [];
  for (let i = 0; i < codes.length; i++) {
    switch (codes[i]) {
      case 0:
        state += 1;
        break;
      case 1:
        state *= 2;
      case 2:
        state -= 1;
        break;
      default:
        state = state + codes[i];
    }
    trail.push(state);
  }
  return trail;
}

for (let i = 0; i < 2000; i++) {
  manyLocals(i, [1]);
  localsAcrossALoop([1, 2, 3]);
  nestedLoops([[1, 2], [3, 4]]);
  parametersAreReassigned(i, i, i);
  switchInALoop([0, 1, 2, 3]);
}

const impostors = ["5", "x", 0.5, -0, null, undefined, true, 5n, NaN, 2147483647, [5], { valueOf: () => 5 }, Symbol("s")];
for (const value of impostors) {
  const label = show(value);
  attempt("manyLocals(" + label + ")", () => manyLocals(value, [1]));
  attempt("localsAcrossALoop with " + label, () => localsAcrossALoop([1, 2, value, 4]));
  attempt("nestedLoops with " + label, () => nestedLoops([[1, 2], [3, value], [5, 6]]));
  attempt("parametersAreReassigned first " + label, () => parametersAreReassigned(value, 2, 3));
  attempt("parametersAreReassigned second " + label, () => parametersAreReassigned(1, value, 3));
  attempt("parametersAreReassigned third " + label, () => parametersAreReassigned(1, 2, value));
  attempt("switchInALoop with " + label, () => switchInALoop([0, 1, value, 2, 0]));
}
attempt("honest calls afterwards", () => [manyLocals(1, [1]), localsAcrossALoop([1, 2, 3]), nestedLoops([[1, 2], [3, 4]]), parametersAreReassigned(1, 2, 3), switchInALoop([0, 1, 2, 3])]);
//// numbers/loop-counters-are-captured-and-changed-by-closures.js
////= show-25

function sharedVar() {
  var readers = [];
  for (var i = 0; i < 3; i++) readers.push(function () { return i; });
  return readers.map(function (read) { return read(); });
}

function freshLet() {
  const readers = [];
  for (let i = 0; i < 3; i++) readers.push(() => i);
  return readers.map(read => read());
}

function letIncrementedLater() {
  const steppers = [];
  for (let i = 0; i < 3; i++) steppers.push(() => ++i);
  return [steppers.map(step => step()), steppers.map(step => step())];
}

function closureSkipsAhead(extra) {
  const seen = [];
  for (var i = 0; i < 8; i++) {
    var skip = function () {
      i += extra;
    };
    seen.push(i);
    if (i === 2) skip();
    if (seen.length === 10) break;
  }
  return [seen, i];
}

function closureReplacesTheCounter(replacement) {
  const seen = [];
  for (var i = 0; i < 8; i++) {
    var replace = function () {
      i = replacement;
    };
    seen.push(i);
    if (seen.length === 3) replace();
    if (seen.length === 8) break;
  }
  return [seen, i];
}

function letReplacedInTheBody(replacement) {
  const seen = [];
  const readers = [];
  for (let i = 0; i < 8; i++) {
    readers.push(() => i);
    seen.push(i);
    if (seen.length === 3) (() => (i = replacement))();
    if (seen.length === 8) break;
  }
  return [seen, readers.map(read => read())];
}

function callbackChangesTheCounter(list, replacement) {
  const seen = [];
  let i = 0;
  const visit = value => {
    seen.push(value, i);
    if (value === "c") i = replacement;
  };
  for (; i < list.length; i++) {
    [list[i]].forEach(visit);
    if (seen.length > 16) break;
  }
  return [seen, i];
}

function counterReadAfterTheLoop(limit) {
  let last = () => -1;
  for (var i = 0; i < limit; i++) last = () => i;
  return [i, last(), i | 0];
}

function indexKeptByATimer(list) {
  const picked = [];
  const later = [];
  for (var i = 0; i < list.length; i++) later.push(() => picked.push(list[i], i));
  later.forEach(run => run());
  return picked;
}

for (let round = 0; round < 500; round++) {
  sharedVar();
  freshLet();
  letIncrementedLater();
  closureSkipsAhead(1);
  closureReplacesTheCounter(4);
  letReplacedInTheBody(4);
  callbackChangesTheCounter(["a", "b", "c", "d"], 2);
  counterReadAfterTheLoop(3);
  indexKeptByATimer(["a", "b"]);
}

attempt("sharedVar", sharedVar);
attempt("freshLet", freshLet);
attempt("letIncrementedLater", letIncrementedLater);
attempt("indexKeptByATimer", () => indexKeptByATimer(["a", "b"]));
for (const value of [1, 3, "1", "", 0.5, -0, null, undefined, true, 1n, NaN, 2147483647, [1], { valueOf: () => 1 }]) {
  const label = show(value);
  attempt("closureSkipsAhead(" + label + ")", () => closureSkipsAhead(value));
  attempt("closureReplacesTheCounter(" + label + ")", () => closureReplacesTheCounter(value));
  attempt("letReplacedInTheBody(" + label + ")", () => letReplacedInTheBody(value));
  attempt("callbackChangesTheCounter(" + label + ")", () => callbackChangesTheCounter(["a", "b", "c", "d", "e"], value));
  attempt("counterReadAfterTheLoop(" + label + ")", () => counterReadAfterTheLoop(value));
}
