Date.prototype.toString = toString;
Object.defineProperty(Stamp.prototype, Symbol.toPrimitive, { value: hint => (hint === "number" ? 52 : hint === "default" ? 53 : "54"), configurable: true });
attempt("[Symbol.toPrimitive] replaced", () => all(new Stamp(5)));
Object.defineProperty(Stamp.prototype, Symbol.toPrimitive, { value: undefined, configurable: true });
attempt("[Symbol.toPrimitive] is undefined", () => numeric(new Stamp(5)));
delete Stamp.prototype[Symbol.toPrimitive];
attempt("[Symbol.toPrimitive] deleted", () => numeric(new Stamp(5)));
const own = new Date(5);
own.valueOf = () => 55;
attempt("valueOf of one date", () => numeric(own));
Object.defineProperty(own, Symbol.toPrimitive, { value: () => 56 });
attempt("[Symbol.toPrimitive] of one date", () => all(own));
attempt("a date after", () => numeric(new Date(5)));
attempt("honest numbers afterwards", () => all(5));
//// numbers/the-smallest-int32-is-negated.js
////= show-25

function negated(value) {
  return -(value | 0);
}

function negatedTruncated(value) {
  return -(value | 0) | 0;
}

function absolute(value) {
  return Math.abs(value | 0);
}

function absoluteTruncated(value) {
  return Math.abs(value | 0) | 0;
}

function absoluteByHand(value) {
  const n = value | 0;
  return n < 0 ? -n : n;
}

function zeroMinus(value) {
  return 0 - (value | 0);
}

function timesMinusOne(value) {
  return (value | 0) * -1;
}

function dividedByMinusOne(value) {
  return (value | 0) / -1;
}

function dividedByMinusOneTruncated(value) {
  return ((value | 0) / -1) | 0;
}

function remainderByMinusOne(value) {
  return (value | 0) % -1;
}

function negatedInPlace(value) {
  let n = value | 0;
  n = -n;
  return [n, n - 1, n | 0];
}

function complementPlusOne(value) {
  return ~(value | 0) + 1;
}

const uses = [negated, negatedTruncated, absolute, absoluteTruncated, absoluteByHand, zeroMinus, timesMinusOne, dividedByMinusOne, dividedByMinusOneTruncated, remainderByMinusOne, negatedInPlace, complementPlusOne];
for (let i = 1; i < 2000; i++) for (const use of uses) use(i);
for (const use of uses) for (const value of [5, -5, 0, -2147483648, 2147483647, -2147483647, 1, -1]) attempt(use.name + "(" + value + ")", () => use(value));
