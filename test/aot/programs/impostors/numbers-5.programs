//// numbers/pushes-in-a-loop-whose-bound-is-huge-or-not-a-number.js
////= show-25

function firstFive(bound) {
  const list = [];
  for (let i = 0; i < bound; i++) {
    list.push(i);
    if (list.length === 5) break;
  }
  return list;
}

function firstFiveInclusive(bound) {
  const list = [];
  for (let i = 0; i <= bound; i++) {
    list.push(i * 2);
    if (list.length === 5) break;
  }
  return list;
}

function firstFiveByIndex(bound) {
  const list = [];
  for (let i = 0; i < bound; i++) {
    list[i] = i;
    if (i === 4) break;
  }
  return list;
}

////= lines-155	lastFive	bound	list	5

function returnsEarly(bound) {
  const list = [];
  for (let i = 0; i < bound; i++) {
    if (i === 3) return list;
    list.push(i);
  }
  return list;
}

function throwsEarly(bound) {
  const list = [];
  try {
    for (let i = 0; i < bound; i++) {
      if (i === 3) throw new RangeError("enough");
      list.push(i);
    }
  } catch {
    list.push("caught");
  }
  return list;
}

function whole(bound) {
  const list = [];
  for (let i = 0; i < bound; i++) list.push(i);
  return list;
}

function mapped(bound) {
  return Array.from({ length: Math.min(bound, 5) }, (_, i) => i);
}

const early = [firstFive, firstFiveInclusive, firstFiveByIndex, lastFive, returnsEarly, throwsEarly];
for (let i = 0; i < 1000; i++) {
  for (const use of early) use(i % 8);
  whole(i % 8);
  mapped(i % 8);
}

for (const bound of [3, 7, Infinity, 1e18, 2147483647, 2147483648, 4294967295, 4294967296, 9007199254740992, 1e308, "7", "3", "abc", "", 2.5, 0.5, NaN, -1, -0, -Infinity, null, undefined, true, 7n, 10n ** 30n, [7], { valueOf: () => 7 }, Symbol("s")]) {
  for (const use of early) attempt(use.name + "(" + show(bound) + ")", () => use(bound));
}
for (const bound of [3, "3", 2.5, 0.5, NaN, -1, -0, null, undefined, true, 3n, [3], { valueOf: () => 3 }]) {
  attempt("whole(" + show(bound) + ")", () => whole(bound));
  attempt("mapped(" + show(bound) + ")", () => mapped(bound));
}
//// numbers/quotients-of-small-integers-are-rounded.js
////= show-25

function rounded() {
  const seen = { floor: [], ceil: [], round: [], trunc: [], truncated: [], sign: [], abs: [] };
  for (let i = -5; i <= 5; i++) {
    seen.floor.push(Math.floor(i / 4));
    seen.ceil.push(Math.ceil(i / 4));
    seen.round.push(Math.round(i / 4));
    seen.trunc.push(Math.trunc(i / 4));
    seen.truncated.push((i / 4) | 0);
    seen.sign.push(Math.sign(i / 4));
    seen.abs.push(Math.abs(i / 4));
  }
  return seen;
}

function roundedWithANegativeDivisor() {
  const seen = { floor: [], ceil: [], round: [], trunc: [], plain: [] };
  for (let i = -2; i <= 2; i++) {
    seen.floor.push(Math.floor(i / -4));
    seen.ceil.push(Math.ceil(i / -4));
    seen.round.push(Math.round(i / -4));
    seen.trunc.push(Math.trunc(i / -4));
    seen.plain.push(i / -4);
  }
  return seen;
}

function dividedByTheCounter() {
  const seen = { plain: [], floor: [], truncated: [], round: [] };
  for (let i = -2; i <= 2; i++) {
    seen.plain.push(6 / i);
    seen.floor.push(Math.floor(6 / i));
    seen.truncated.push((6 / i) | 0);
    seen.round.push(Math.round(1 / i));
  }
  return seen;
}

function zeroDividedByTheCounter() {
  const seen = [];
  for (let i = -2; i <= 2; i++) seen.push(0 / i, Math.floor(0 / i), Math.round(0 / i));
  return seen;
}

function halves() {
  const seen = { round: [], floorOfPlusHalf: [], ceilOfMinusHalf: [] };
  for (let i = -5; i <= 5; i++) {
    seen.round.push(Math.round(i / 2));
    seen.floorOfPlusHalf.push(Math.floor(i / 2 + 0.5));
    seen.ceilOfMinusHalf.push(Math.ceil(i / 2 - 0.5));
  }
  return seen;
}

function usedAsIndexes() {
  const letters = ["a", "b", "c"];
  const seen = [];
  for (let i = -3; i <= 9; i++) seen.push(letters[Math.floor(i / 3)], letters[Math.ceil(i / 3)], letters[i / 3]);
  return seen;
}

function minimumAndMaximum() {
  const seen = { min: [], max: [], clamped: [] };
  for (let i = -3; i <= 3; i++) {
    seen.min.push(Math.min(i / 2, 0));
    seen.max.push(Math.max(i / 2, 0));
    seen.clamped.push(Math.round(Math.min(Math.max(i / 2, -1), 1)));
  }
  return seen;
}

function negatedQuotients() {
  const seen = [];
  for (let i = 0; i <= 3; i++) seen.push(-(i / 2), Math.floor(-(i / 2)), Math.ceil(-(i / 2)), -Math.floor(i / 2));
  return seen;
}

function sumsOfQuotients() {
  const seen = [];
  for (let i = -2; i <= 2; i++) seen.push(i / 2 + i / 2, i / 2 - i / 2, Math.round(i / 4 + i / 4), Math.ceil(i / 4 - 1 / 4));
  return seen;
}

function comparedWithQuotients() {
  const seen = [];
  for (let i = 0; i < 6; i++) {
    let count = 0;
    for (let j = 0; j < i / 2; j++) count++;
    let inclusive = 0;
    for (let j = 0; j <= i / 2; j++) inclusive++;
    seen.push(count, inclusive);
  }
  return seen;
}

const uses = [rounded, roundedWithANegativeDivisor, dividedByTheCounter, zeroDividedByTheCounter, halves, usedAsIndexes, minimumAndMaximum, negatedQuotients, sumsOfQuotients, comparedWithQuotients];
for (const use of uses) {
  const result = use();
  if (Array.isArray(result)) attempt(use.name, () => result);
  else for (const key of Object.keys(result)) attempt(use.name + " " + key, () => result[key]);
}
//// numbers/recursive-functions-carry-a-number-that-becomes-something-else.js
////= show-25

function sumTo(n, total) {
  if (n <= 0) return total;
  return sumTo(n - 1, total + n);
}

function factorial(n) {
  return n <= 1 ? 1 : n * factorial(n - 1);
}

function gcd(a, b) {
  return b === 0 ? a : gcd(b, a % b);
}

function power(base, exponent, result) {
  if (exponent === 0) return result;
  return power(base, exponent - 1, result * base);
}

function countDigits(n, count) {
  if (n < 10) return count + 1;
  return countDigits((n / 10) | 0, count + 1);
}

function fibonacci(n) {
  return n < 2 ? n : fibonacci(n - 1) + fibonacci(n - 2);
}

function collatz(n, steps) {
  if (n === 1 || steps > 200) return steps;
  return collatz(n % 2 === 0 ? n / 2 : n * 3 + 1, steps + 1);
}

