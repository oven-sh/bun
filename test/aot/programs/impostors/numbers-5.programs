function sum(a, b) {
  return (a | 0) + (b | 0);
}

function difference(a, b) {
  return (a | 0) - (b | 0);
}

function product(a, b) {
  return (a | 0) * (b | 0);
}

function sumTruncated(a, b) {
  return ((a | 0) + (b | 0)) | 0;
}

function differenceTruncated(a, b) {
  return ((a | 0) - (b | 0)) | 0;
}

function productTruncated(a, b) {
  return ((a | 0) * (b | 0)) | 0;
}

////= lines-55	imul	a	b	Math.imul	a	b

function sumUnsigned(a, b) {
  return ((a | 0) + (b | 0)) >>> 0;
}

function sumOfThree(a, b) {
  return (a | 0) + (b | 0) + (a | 0);
}

function sumOfThreeTruncated(a, b) {
  return ((a | 0) + (b | 0) + (a | 0)) | 0;
}

function accumulated(a, b) {
  let total = a | 0;
  total += b | 0;
  total += b | 0;
  return total;
}

function multipliedInPlace(a, b) {
  let total = a | 0;
  total *= b | 0;
  return total;
}

function average(a, b) {
  return ((a | 0) + (b | 0)) >> 1;
}

function averageUnsigned(a, b) {
  return ((a | 0) + (b | 0)) >>> 1;
}

function compared(a, b) {
  return (a | 0) + 1 > (b | 0);
}

