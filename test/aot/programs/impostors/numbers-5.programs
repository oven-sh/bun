  var total = 0;
  for (var i = 0; i < arguments.length; i++) total += arguments[i];
  return total;
}

for (var i = 0; i < 2000; i++) {
  replacedThroughArguments(i, i + 1);
  parameterChangesArguments(i);
  replacedByAHelper(i, i + 1);
  replacedInALoop(i, i + 1);
