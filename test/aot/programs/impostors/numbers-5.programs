////= show-25

const log = [];

function area() {
  return this.width * this.height;
}

function flagsOf() {
  return this.flags & 3;
}

function bump() {
  this.count++;
  return this.count;
}

////= lines-217	grow	by	this.size	by	this.size

const honest = { width: 2, height: 3, flags: 7, count: 0, size: 0, area, flagsOf, bump, grow };
for (let i = 0; i < 2000; i++) {
  honest.area();
  honest.flagsOf();
  honest.bump();
  honest.grow(1);
}
console.log("after 2000 honest calls", honest.count, honest.size);

const receivers = {
  "texts": () => ({ width: "2", height: "3", flags: "7", count: "0", size: "0" }),
  "fractions": () => ({ width: 2.5, height: 3.5, flags: 7.9, count: 0.5, size: 0.5 }),
  "nothing": () => ({}),
  "nulls": () => ({ width: null, height: null, flags: null, count: null, size: null }),
  "bigints": () => ({ width: 2n, height: 3n, flags: 7n, count: 0n, size: 0n }),
  "the largest int32": () => ({ width: 2147483647, height: 2, flags: 2147483647, count: 2147483647, size: 2147483647 }),
  "objects": () => {
    const member = (name, result) => ({
      valueOf() {
        log.push(name);
        return result;
      },
    });
    return { width: member("width", 2), height: member("height", 3), flags: member("flags", 7), count: member("count", 0), size: member("size", 0) };
  },
  "getters": () => ({
    get width() {
      log.push("get width");
      return 2;
    },
    get height() {
      log.push("get height");
      return 3;
    },
    get flags() {
      log.push("get flags");
      return 7;
    },
    get count() {
      log.push("get count");
      return 0;
    },
    set count(value) {
      log.push("set count " + value);
    },
    get size() {
      log.push("get size");
      return "0";
    },
    set size(value) {
      log.push("set size " + value);
    },
  }),
  "an array": () => [1, 2, 3],
  "a text": () => "text",
  "a number": () => 5,
  "a function": () => function (a, b) {},
  "a frozen object": () => Object.freeze({ width: 2, height: 3, flags: 7, count: 0, size: 0 }),
  "null": () => null,
  "undefined": () => undefined,
};

for (const name of Object.keys(receivers)) {
  for (const [label, use] of [["area", area], ["flagsOf", flagsOf], ["bump", bump], ["grow", grow]]) {
    log.length = 0;
    const result = outcome(() => use.call(receivers[name](), 1));
    console.log(label, "on", name, "->", result + (log.length ? " after " + log.join(", ") : ""));
  }
}
attempt("grow by a text", () => grow.call({ size: 1 }, "1"));
attempt("grow by nothing", () => grow.call({ size: 1 }));
attempt("the honest object afterwards", () => [honest.area(), honest.flagsOf(), honest.bump(), honest.grow(1)]);
//// numbers/members-taken-by-a-pattern-are-used-as-integers.js
////= show-25

const log = [];

////= impostors-8

////= lines-146	fromAParameterPattern	masked	flags

function masked({ flags }) {
  return flags & 6;
}

function fromALocalPattern(value) {
  const { flags } = { flags: value };
  return flags >>> 1;
}

function fromAnAssignmentPattern(value) {
  let flags;
  ({ flags } = { flags: value });
  return ~flags;
}

function fromANestedPattern(value) {
  const {
    options: { flags },
  } = { options: { flags: value } };
  return flags | 1;
}

function fromAListPattern(value) {
  const [, flags] = [0, value];
  return flags ^ 3;
}

runTable([fromAParameterPattern, fromALocalPattern, fromAnAssignmentPattern, fromANestedPattern, fromAListPattern], impostors);
//// numbers/members-that-only-see-integer-stores-get-something-else-by-a-computed-name.js
////= show-25

class Meter {
  constructor() {
    this.reading = 0;
    this.label = "meter";
  }
  advance() {
    this.reading = this.reading + 1;
    return this.reading;
  }
  report() {
    return [this.reading, this.reading + 1, this.reading * 2, this.reading & 7, this.reading < 10, typeof this.reading];
  }
}

////= lines-84	Gauge	level	0	label	"gauge"
Gauge.prototype.advance = function () {
  this.level = this.level + 1;
  return this.level;
};
Gauge.prototype.report = function () {
  return [this.level, this.level + 1, this.level * 2, this.level & 7, this.level < 10, typeof this.level];
};

function makeDial() {
  return {
    angle: 0,
    label: "dial",
    advance() {
      this.angle = this.angle + 1;
      return this.angle;
    },
    report() {
      return [this.angle, this.angle + 1, this.angle * 2, this.angle & 7, this.angle < 10, typeof this.angle];
    },
  };
}

const kinds = [
  ["class", () => new Meter(), ["read", "ing"].join("")],
  ["constructor function", () => new Gauge(), ["le", "vel"].join("")],
  ["object literal", makeDial, ["an", "gle"].join("")],
];
const late = JSON.parse('[0.5, 2147483647, 2147483648, -2147483647, -2147483648, -0, "3", "", null, true, [4], {}]').concat([NaN, undefined, 3n, Infinity]);

for (const [kind, make, name] of kinds) {
  const warm = make();
  for (let i = 0; i < 2000; i++) {
    warm.advance();
    warm.report();
  }
  console.log(kind, "after 2000 honest rounds", show(warm.report()));
  for (const value of late) {
    const label = kind + " with " + show(value);
    warm[name] = value;
    attempt(label + " report", () => warm.report());
    attempt(label + " read by name", () => [warm[name], name in warm, Object.keys(warm)]);
    attempt(label + " advance", () => [warm.advance(), warm.report()]);
    const fresh = make();
    fresh[name] = value;
    attempt(label + " in a fresh object", () => [fresh.report(), JSON.stringify(fresh) === undefined]);
    warm[name] = 1;
    attempt(label + " and an integer again", () => [warm.advance(), warm.report()]);
  }
  delete warm[name];
  attempt(kind + " deleted", () => [warm.report(), name in warm, Object.keys(warm)]);
  attempt(kind + " advanced after the deletion", () => [warm.advance(), Object.keys(warm)]);
}
//// numbers/more-bit-tricks-at-the-edges-of-int32.js
