//// numbers/run-time-text-stores-into-an-integer-variable.js
////= show-25

const letters = ["a", "b", "c", "d"];

function directEval(text) {
  let index = 0;
  index++;
  eval(text);
  return [index, typeof index, letters[index], index | 0, index + 1];
}

function directEvalInALoop(text) {
  let index = 0;
  const seen = [];
  for (let round = 0; round < 4; round++) {
    seen.push(letters[index]);
    if (round === 1) eval(text);
    index++;
  }
  seen.push(index);
  return seen;
}

function directEvalInAClosure(text) {
  let index = 0;
  const change = source => eval(source);
  index++;
  change(text);
  return [index, letters[index], index & 3];
}

function evalDeclaresAVariableOfTheSameName(text) {
  var index = 1;
  eval(text);
  return [index, letters[index], index | 0];
}

function withStatement(scope) {
  let index = 1;
  with (scope) {
    index = index + 1;
    var seen = [index, letters[index], index | 0];
  }
  return [seen, index, letters[index], scope];
}

const texts = ["index = 2", "index = '2'", "index = 1.5", "index = -0", "index = 2147483648", "index = undefined", "index = null", "index = 2n", "index = NaN", "index = { valueOf() { return 3; } }", "index += '1'", "index /= 2", "index--", "0"];
for (const round of ["cold", "warm"]) {
  for (const text of texts) {
    attempt(round + " directEval " + text, () => directEval(text));
    attempt(round + " directEvalInALoop " + text, () => directEvalInALoop(text));
    attempt(round + " directEvalInAClosure " + text, () => directEvalInAClosure(text));
  }
  for (const text of ["var index = 'x'", "var index = 2.5", "var index", "var other = 1", "function index() {}"]) attempt(round + " evalDeclaresAVariableOfTheSameName " + text, () => evalDeclaresAVariableOfTheSameName(text));
  for (const scope of [{}, { index: 2 }, { index: "2" }, { index: 0.5 }, { letters: ["w", "x", "y", "z"] }, { index: 2147483647 }, { get index() { return 1; }, set index(value) {} }]) attempt(round + " withStatement", () => withStatement(scope));
  for (let i = 0; i < 300; i++) {
    directEval("0");
    directEvalInALoop("0");
    directEvalInAClosure("0");
    withStatement({});
  }
}
//// numbers/side-effects-happen-once-when-an-impostor-arrives-in-the-middle-of-a-loop.js
////= show-25

const log = [];
const tally = { before: 0, after: 0 };

////= lines-306	doubledSum	+= list[i] * 2

////= lines-306	maskedSum	= (total + (list[i] & 255)) | 0

function plainSum(list) {
  let total = 0;
  for (let i = 0; i < list.length; i++) {
    tally.before++;
    log.push("b" + i);
    total += list[i];
    log.push("a" + i);
    tally.after++;
  }
  return total;
}

function note(value) {
  log.push("note");
  return value;
}

function sumWithCallsAround(list) {
  let total = 0;
  for (let i = 0; i < list.length; i++) total += note(1) * list[i] * note(2);
  return total;
}

function incrementAll(list) {
  for (let i = 0; i < list.length; i++) {
    log.push("b" + i);
    list[i]++;
  }
  return list;
}

function countersInOneExpression(list) {
  let i = 0;
  let total = 0;
  while (i < list.length) total += list[i++] - list[i++ % list.length] + i;
  return [total, i];
}

const uses = [doubledSum, maskedSum, plainSum, sumWithCallsAround, incrementAll, countersInOneExpression];
for (let round = 0; round < 1000; round++) for (const use of uses) use([1, 2, 3, 4]);

const impostors = {
  "a text": () => "5",
  "a fraction": () => 0.5,
  "undefined": () => undefined,
  "a bigint": () => 5n,
  "a symbol": () => Symbol("s"),
  "the largest int32": () => 2147483647,
  "negative zero": () => -0,
  "an object that logs": () => ({
    valueOf() {
      log.push("valueOf");
      return 5;
    },
  }),
  "an object that throws": () => ({
    valueOf() {
      log.push("valueOf");
      throw new RangeError("no");
    },
  }),
};

for (const use of uses) {
  for (const name of Object.keys(impostors)) {
    for (const position of [0, 2, 3]) {
      const list = [1, 2, 3, 4];
      list[position] = impostors[name]();
      log.length = 0;
      tally.before = 0;
      tally.after = 0;
      const result = outcome(() => use(list));
      console.log(use.name, "with", name, "at", position, "->", result, "|", log.join(" "), "|", tally.before, tally.after);
    }
  }
}
//// numbers/small-codes-kept-in-members-grow-beyond-a-byte.js
////= show-25

class Task {
  constructor() {
    this.state = 0;
    this.done = false;
    this.priority = 1;
    this.ratio = 0.5;
  }
  start() {
    this.state = 1;
  }
  finish() {
    this.state = 2;
    this.done = true;
  }
  raise() {
    this.priority = this.priority === 3 ? 3 : this.priority + 1;
  }
  report() {
    return [this.state, this.done, this.priority, this.ratio, this.state + 1, this.state * 2, this.state & 255, this.state === 2, typeof this.state];
  }
}

////= lines-196	put	task	name	task[name

const tasks = [];
for (let i = 0; i < 2000; i++) {
  const task = new Task();
  task.start();
  if (i & 1) task.finish();
  task.raise();
  task.report();
  if (i < 4) tasks.push(task);
}
attempt("honest tasks", () => tasks.map(task => task.report()));

for (const value of [3, 127, 128, 129, 255, 256, 257, 32767, 32768, 65535, 65536, 16777216, 16777217, 2147483647, -1, -127, -128, -129, -32768, -32769, -2147483648, 0.5, 0.1, -0, NaN, Infinity, 1e39, true, false, null, undefined, "1", 1n]) {
  const label = show(value);
  attempt("state = " + label, () => {
    const task = new Task();
    put(task, "state", value);
    return task.report();
  });
  attempt("done = " + label, () => {
    const task = new Task();
    put(task, "done", value);
    return [task.done, typeof task.done, task.done ? "truthy" : "falsy", task.done === true, task.done === false];
  });
  attempt("ratio = " + label, () => {
    const task = new Task();
    put(task, "ratio", value);
    return [task.ratio, typeof task.ratio, task.ratio * 2, task.ratio === value, Object.is(task.ratio, value)];
  });
  attempt("priority = " + label + " and raise", () => {
    const task = new Task();
    put(task, "priority", value);
    task.raise();
    return task.priority;
  });
}
attempt("honest tasks afterwards", () => tasks.map(task => task.report()));
//// numbers/small-ranges-of-integers-make-negative-zero.js
////= show-25

function products() {
  const seen = [];
  for (let i = -2; i <= 2; i++) for (let j = -1; j <= 1; j++) seen.push(i * j);
  return seen;
}

function productsWithAConstant() {
  const seen = [];
  for (let i = -2; i <= 2; i++) seen.push(i * 0, 0 * i, i * -0, i * -1, -1 * i);
  return seen;
}

function remainders() {
  const seen = [];
  for (let i = -6; i <= 6; i++) seen.push(i % 3);
  return seen;
}

function remaindersByAPowerOfTwo() {
  const seen = [];
  for (let i = -4; i <= 4; i++) seen.push(i % 2, i % 4);
  return seen;
}

function remaindersByANegativeNumber() {
  const seen = [];
  for (let i = -3; i <= 3; i++) seen.push(i % -3);
  return seen;
}

function negations() {
  const seen = [];
  for (let i = -1; i <= 1; i++) seen.push(-i, 0 - i, -(-i), -Math.abs(i), -(i * i));
  return seen;
}

function negatedLengths() {
  const seen = [];
  for (const list of [[], [1], [1, 2]]) seen.push(-list.length, 0 - list.length, -list.length | 0, list.length * -1);
  for (const text of ["", "a"]) seen.push(-text.length, text.length * -1);
  return seen;
}

function negatedBits() {
  const seen = [];
  for (let i = 0; i < 3; i++) seen.push(-(i & 1), -(i >> 1), -(i >>> 1), -(i | 0), -~~i);
  return seen;
}

function negatedComparisons() {
  const seen = [];
  for (let i = 0; i < 3; i++) seen.push(-(i > 1), -(i === 0), +(i > 1), (i > 1) * -1);
  return seen;
}

function minimumsAndMaximums() {
  const seen = [];
  for (let i = -1; i <= 1; i++) seen.push(Math.min(-i, 0), Math.max(-i, 0), Math.min(0, -i), Math.max(0, -i), Math.min(i * 0, 0), Math.max(i * 0, -0));
  return seen;
}

function countdownTimesSign(sign) {
  const seen = [];
  for (let i = 2; i >= 0; i--) seen.push(i * sign);
  return seen;
}

function accumulatedProduct() {
  let product = 1;
  const seen = [];
  for (let i = 2; i >= -2; i--) {
    product *= i;
    seen.push(product);
  }
  return seen;
}

function sumsKeepTheSignOnlyOfTwoNegativeZeros() {
  const seen = [];
  for (let i = -1; i <= 1; i++) seen.push(i * 0 + 0, i * 0 + i * 0, i * 0 - 0, 0 - i * 0, i * 0 + -0);
  return seen;
}

function storedInAnArrayOfIntegers() {
  const list = [1, 2, 3, 4, 5];
  for (let i = -2; i <= 2; i++) list[i + 2] = i * 0;
  return list;
}

function storedInAField() {
  const holder = { n: 1 };
  const seen = [];
  for (let i = -1; i <= 1; i++) {
    holder.n = i * 0;
    seen.push(holder.n, 1 / holder.n);
  }
  return seen;
}

const uses = [products, productsWithAConstant, remainders, remaindersByAPowerOfTwo, remaindersByANegativeNumber, negations, negatedLengths, negatedBits, negatedComparisons, minimumsAndMaximums, accumulatedProduct, sumsKeepTheSignOnlyOfTwoNegativeZeros, storedInAnArrayOfIntegers, storedInAField];
for (const round of ["first", "second"]) for (const use of uses) attempt(round + " " + use.name, use);
attempt("countdownTimesSign(1)", () => countdownTimesSign(1));
attempt("countdownTimesSign(-1)", () => countdownTimesSign(-1));
attempt("countdownTimesSign(0)", () => countdownTimesSign(0));
attempt("countdownTimesSign(-0)", () => countdownTimesSign(-0));
//// numbers/something-else-is-stored-late-into-a-captured-counter.js
////= show-25

function makeCounter() {
  let count = 0;
  return {
    next: () => count++,
    peek: () => count,
    bucket: () => count & 7,
    doubled: () => count * 2,
    plusOne: () => count + 1,
    set: value => {
      count = value;
    },
    add: value => {
      count += value;
    },
  };
}

