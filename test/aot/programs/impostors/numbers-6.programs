function dense(value) {
  switch (value) {
    case 0:
      return "zero";
    case 1:
      return "one";
    case 2:
      return "two";
    case 3:
      return "three";
    case 4:
      return "four";
    case 5:
      return "five";
    case 6:
      return "six";
    case 7:
      return "seven";
    default:
      return "none";
  }
}

function sparse(value) {
  switch (value) {
    case -2147483648:
      return "smallest";
    case -1:
      return "minus one";
    case 0:
      return "zero";
    case 10:
      return "ten";
    case 2147483647:
      return "largest";
    case 4294967295:
      return "largest unsigned";
    default:
      return "none";
  }
}

function truncatedFirst(value) {
  switch (value | 0) {
    case -1:
      return "minus one";
    case 0:
      return "zero";
    case 1:
      return "one";
    case 7:
      return "seven";
    default:
      return "none";
  }
}

