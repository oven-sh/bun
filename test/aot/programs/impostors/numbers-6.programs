//// one-node-in-a-list-or-a-tree-is-an-impostor.js
const log = [];

////= show-22

////= lines-104	Link	value	next

////= lines-114	Tree	value	left	right

function sumByLoop(head) {
  let sum = 0;
  for (let link = head; link; link = link.next) sum += link.value;
  return sum;
}

function sumByWhile(head) {
  let sum = 0;
  let link = head;
  while (link !== null && link !== undefined) {
    sum += link.value;
    link = link.next;
  }
  return sum;
}

function sumByRecursion(link) {
  return link ? link.value + sumByRecursion(link.next) : 0;
}

function lengthOf(head) {
  let length = 0;
  for (let link = head; link; link = link.next) length++;
  return length;
}

function valuesOf(head) {
  const values = [];
  for (let link = head; link; link = link.next) values.push(link.value);
  return values;
}

function doubleAll(head) {
  for (let link = head; link; link = link.next) link.value *= 2;
  return valuesOf(head);
}

function reverse(head) {
  let previous = null;
  let link = head;
  while (link) {
    const next = link.next;
    link.next = previous;
    previous = link;
    link = next;
  }
  return valuesOf(previous);
}

function sumOfTree(tree) {
  if (!tree) return 0;
  return sumOfTree(tree.left) + tree.value + sumOfTree(tree.right);
}

function depthOfTree(tree) {
  return tree ? 1 + Math.max(depthOfTree(tree.left), depthOfTree(tree.right)) : 0;
}

const impostors = [
  ["an honest one", (value, next) => new Link(value, next)],
  ["a literal", (value, next) => ({ value, next })],
  ["a literal in the other order", (value, next) => ({ next, value })],
  ["a literal with more members", (value, next) => ({ before: 0, value, between: 0, next, after: 0 })],
  ["a tree node used as a link", (value, next) => Object.assign(new Tree(value, null, null), { next })],
  ["getters that log", (value, next) => ({ get value() { log.push("get value"); return value; }, get next() { log.push("get next"); return next; } })],
  ["members on the prototype", (value, next) => Object.create({ value, next })],
  ["no prototype", (value, next) => Object.assign(Object.create(null), { value, next })],
  ["a proxy around an honest one", (value, next) => new Proxy(new Link(value, next), {})],
  ["a frozen honest one", (value, next) => Object.freeze(new Link(value, next))],
  ["a string value", (value, next) => new Link(String(value), next)],
  ["a fraction", (value, next) => new Link(value + 0.5, next)],
  ["-0", (value, next) => new Link(-0, next)],
  ["2 ** 31", (value, next) => new Link(2147483648, next)],
  ["a bigint value", (value, next) => new Link(BigInt(value), next)],
  ["an object with valueOf", (value, next) => new Link({ valueOf() { log.push("valueOf"); return value; } }, next)],
  ["no value", (value, next) => { const link = new Link(value, next); delete link.value; return link; }],
  ["a next that was deleted", (value, next) => { const link = new Link(value, next); delete link.next; return link; }],
  ["from JSON, so the list ends there", (value, next) => JSON.parse('{"value":' + value + ',"next":null}')],
  ["an array with the names", (value, next) => Object.assign([], { value, next })],
  ["a function with the names", (value, next) => Object.assign(function () {}, { value, next })],
  ["a number, which ends the walk", () => 7],
  ["a string, which ends the walk", () => "link"],
];

function build(position, make) {
  let head = null;
  for (let index = 4; index >= 0; index--) head = index === position ? make(index + 1, head) : new Link(index + 1, head);
  return head;
}

const uses = [
  ["for", sumByLoop],
  ["while", sumByWhile],
  ["recursion", sumByRecursion],
  ["length", lengthOf],
  ["values", valuesOf],
  ["double", doubleAll],
  ["reverse", reverse],
];

for (let i = 0; i < 2000; i++) for (const [, use] of uses) use(build(-1, null));
console.log("honest", uses.map(([name, use]) => name + " " + show(use(build(-1, null)))).join(" | "));

for (const [label, make] of impostors) {
  for (const position of [0, 2, 4]) {
    const parts = uses.map(([name, use]) => {
      try {
        return name + " " + show(use(build(position, make)));
      } catch (error) {
        return name + " threw " + error.constructor.name;
      }
    });
    console.log(label + " at " + position + " | " + parts.join(" | ") + (log.length ? " | log has " + log.splice(0).length : ""));
  }
}

function grow(depth, odd) {
  if (depth === 0) return null;
  const left = grow(depth - 1, odd);
  const right = grow(depth - 1, null);
  return depth === 2 && odd ? odd(depth, left, right) : new Tree(depth, left, right);
}

for (let i = 0; i < 500; i++) sumOfTree(grow(4, null)), depthOfTree(grow(4, null));
console.log("an honest tree", sumOfTree(grow(4, null)), depthOfTree(grow(4, null)));
for (const [label, odd] of [
  ["a literal", (value, left, right) => ({ value, left, right })],
  ["a literal in another order", (value, left, right) => ({ right, value, left })],
  ["a link used as a tree node", (value, left, right) => Object.assign(new Link(value, null), { left, right })],
  ["a node with a string", (value, left, right) => new Tree("two", left, right)],
  ["a node whose left is a getter", (value, left, right) => Object.defineProperty(new Tree(value, null, right), "left", { get: () => left })],
  ["a node whose right was deleted", (value, left, right) => { const tree = new Tree(value, left, right); delete tree.right; return tree; }],
  ["a number", () => 9],
]) {
  console.log("a tree with " + label, show(sumOfTree(grow(4, odd))), depthOfTree(grow(4, odd)));
}
//// one-object-is-read-under-different-names-in-several-functions.js
const log = [];

////= show-7

////= lines-114	Employee	badge	salary	manager

////= lines-114	Contractor	badge	rate	agency

////= lines-7	badgeOf	person	person.badge

////= lines-7	payOf	person	person.salary

////= lines-7	bossOf	person	person.manager

function bossBadgeOf(person) {
  return badgeOf(bossOf(person));
}

function line(person) {
  return badgeOf(person) + ":" + payOf(person);
}

function report(person) {
  const parts = [line(person)];
  if (bossOf(person)) parts.push("under " + bossBadgeOf(person));
  return parts.join(" ");
}

function chain(person) {
  const badges = [];
  for (let current = person; current; current = bossOf(current)) {
    badges.push(badgeOf(current));
    if (badges.length > 5) break;
  }
  return badges;
}

function raise(person, amount) {
  person.salary = payOf(person) + amount;
  return payOf(person);
}

////= lines-109	passThrough	person	return

function throughManyHands(person) {
  const first = passThrough(person);
  const holder = { held: first };
  const list = [holder.held];
  const [second] = list;
  return report(second);
}

const boss = new Employee("B1", 900, null);
const uses = [
  ["report", report],
  ["chain", chain],
  ["raise by 1", person => raise(person, 1)],
  ["through many hands", throughManyHands],
];

const people = [
  ["an employee", () => new Employee("E1", 100, boss)],
  ["a contractor, which shares only badge", () => new Contractor("C1", 5, "agency")],
  ["a contractor as the manager", () => new Employee("E2", 100, new Contractor("C2", 5, "agency"))],
  ["a literal as the manager", () => new Employee("E3", 100, { badge: "L1" })],
  ["a string as the manager", () => new Employee("E4", 100, "somebody")],
  ["a number as the manager", () => new Employee("E5", 100, 7)],
  ["itself as the manager", () => { const person = new Employee("E6", 100, null); person.manager = person; return person; }],
  ["a literal with all three names", () => ({ manager: boss, salary: 100, badge: "L2" })],
  ["a literal with getters that log", () => ({ get badge() { log.push("badge"); return "G1"; }, get salary() { log.push("salary"); return 100; }, set salary(value) { log.push("salary = " + value); }, get manager() { log.push("manager"); return boss; } })],
  ["an employee whose manager is a getter that runs out", () => { let left = 2; return Object.defineProperty(new Employee("E7", 100, null), "manager", { get() { return left-- > 0 ? boss : null; } }); }],
  ["an employee with a string salary", () => new Employee("E8", "100", boss)],
  ["an employee with a bigint salary", () => new Employee("E9", 100n, boss)],
  ["an employee without a salary", () => { const person = new Employee("E10", 100, boss); delete person.salary; return person; }],
  ["a frozen employee", () => Object.freeze(new Employee("E11", 100, boss))],
  ["a proxy around an employee", () => new Proxy(new Employee("E12", 100, boss), { get(target, key, receiver) { log.push("get " + String(key)); return Reflect.get(target, key, receiver); } })],
  ["parsed from JSON", () => JSON.parse('{"badge":"J1","salary":100,"manager":{"badge":"J2","salary":1,"manager":null}}')],
  ["null", () => null],
  ["a number", () => 5],
];

////= look-2	people	text

look("at first");
for (let i = 0; i < 2000; i++) for (const [, use] of uses) use(new Employee("E" + (i % 4), i % 50, boss));
look("after 2000 employees");
console.log("the boss was not touched", show([boss.badge, boss.salary, boss.manager]));
//// one-text-or-a-list-of-texts.js
////= show-26

function asList(value) {
  return Array.isArray(value) ? value : [value];
}

function asListByTypeof(value) {
  return typeof value === "string" ? [value] : value;
}

function asListByConcat(value) {
  return [].concat(value);
}

function asListByFlat(value) {
  return [value].flat();
}

function totalLength(value) {
  let total = 0;
  for (const text of asList(value)) total += text.length;
  return total;
}

function totalLengthByTypeof(value) {
  let total = 0;
  for (const text of asListByTypeof(value)) total += text.length;
  return total;
}

function joinedUpper(value) {
  return asListByConcat(value)
    .map(text => text.toUpperCase())
    .join("+");
}

function firstText(value) {
  return typeof value === "string" ? value : value[0];
}

function countOf(value) {
  return typeof value === "string" ? 1 : value.length;
}

function classNames(...values) {
  const names = [];
  for (const value of values) {
    if (!value) continue;
    if (typeof value === "string" || typeof value === "number") names.push(value);
    else if (Array.isArray(value)) names.push(classNames(...value));
    else if (typeof value === "object") for (const key in value) if (value[key]) names.push(key);
  }
  return names.join(" ");
}

const uses = [
  ["as a list", asList],
  ["as a list by typeof", asListByTypeof],
  ["as a list by concat", asListByConcat],
  ["as a list by flat", asListByFlat],
  ["total length", totalLength],
  ["total length by typeof", totalLengthByTypeof],
  ["joined upper", joinedUpper],
  ["first text", firstText],
  ["count", countOf],
  ["class names", classNames],
];

const values = [
  "'one'",
  "['one', 'two']",
  "''",
  "[]",
  "[['nested']]",
  "new String('wrapped')",
  "[new String('wrapped')]",
  "new Set(['in', 'a', 'set'])",
  "{ length: 1, 0: 'array-like' }",
  "(function () { return arguments; })('from', 'arguments')",
  "Object.assign(['spreadable off'], { [Symbol.isConcatSpreadable]: false })",
  "{ length: 1, 0: 'spreadable on', [Symbol.isConcatSpreadable]: true }",
  "Object.assign(new String('ab'), { [Symbol.isConcatSpreadable]: true })",
  "new Proxy(['through a proxy'], {})",
  "class Words extends Array {}.of('sub', 'class')",
  "Buffer.from('ab')",
  "5",
  "null",
  "undefined",
  "['one', 2, null]",
  "{ active: true, hidden: 0, 'is-open': 'yes' }",
  "'one'[Symbol.iterator]()",
];

let total = 0;
for (let i = 0; i < 2000; i++) {
  for (const [, use] of uses) total += String(use(i % 2 ? "one" : ["one", "two"])).length;
}
console.log("2000 honest rounds", total);

for (const [name, use] of uses) {
  for (const text of values) {
    attempt(name + " of " + text, () => {
      const given = make(text);
      const result = use(given);
      return result === given && typeof given === "object" && given !== null && !Array.isArray(given) ? "the same object" : result;
    });
  }
}

console.log("bytes made in plain sight", Buffer.from("he").length);
//// only-native-functions-list-the-keys-of-these-objects.js
import { format, inspect, isDeepStrictEqual } from "node:util";

////= Entry

////= OldEntry
////= lines-133	OldEntry	alpha	beta

////= fill-6

const listers = [
  ["inspect", entry => inspect(entry)],
  ["Bun.inspect", entry => Bun.inspect(entry).replace(/\s+/g, " ")],
  ["format with %j", entry => format("%j", entry)],
  ["format with %o", entry => format("%o", entry).replace(/\s+/g, " ")],
  ["inspect of a structured clone", entry => inspect(structuredClone(entry))],
  ["inspect of a list that holds it", entry => inspect([entry])],
  ["inspect of a Map that holds it", entry => inspect(new Map([["key", entry]]))],
  ["deep equality with another one of the same history", (entry, again) => isDeepStrictEqual(entry, again)],
  ["Bun.deepEquals with another one of the same history", (entry, again) => Bun.deepEquals(entry, again, true)],
];

let sum = 0;
for (let i = 0; i < 2000; i++) for (const [, make] of kinds) sum += make("alpha first").alpha + make("gamma first").beta + make("short").alpha;
console.log("2000 honest rounds", sum);

for (const [kind, make] of kinds) {
  for (const [history, build] of histories) {
    for (const [name, list] of listers) {
      let line = kind + " | " + history + " | " + name + " -> ";
      try {
        line += String(list(build(make), build(make)));
      } catch (error) {
        line += "threw " + error.constructor.name;
      }
      console.log(line);
    }
  }
}

for (const [kind, make] of kinds) {
  for (const [history, build] of histories) {
    if (history !== "gamma first" && history !== "alpha deleted and stored again" && history !== "one more member in front of gamma") continue;
    console.log(kind + " | " + history + " | console.log ->", build(make));
  }
}
