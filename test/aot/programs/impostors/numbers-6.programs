class Cell {
  n = 0;
  optional = undefined;
  #hidden = 0;
  static shared = 0;
  set(value) {
    this.n = value;
    this.optional = value;
    this.#hidden = value;
    Cell.shared = value;
  }
  clear() {
    this.optional = undefined;
  }
  clearToNull() {
    this.optional = null;
  }
  read() {
    return [this.n, this.optional, this.#hidden, Cell.shared];
  }
}

