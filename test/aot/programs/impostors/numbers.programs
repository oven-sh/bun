//// numbers/a-class-with-value-of-is-used-in-arithmetic-and-then-changed.js
////= show-25

const log = [];

class Money {
  constructor(cents) {
    this.cents = cents;
  }
  valueOf() {
    log.push("valueOf");
    return this.cents;
  }
  toString() {
    log.push("toString");
    return "$" + this.cents / 100;
  }
}

class Tip extends Money {
  valueOf() {
    log.push("Tip.valueOf");
    return super.valueOf() * 2;
  }
}

class Label extends Money {
  [Symbol.toPrimitive](hint) {
    log.push("toPrimitive " + hint);
    return hint === "number" ? 1 : "label";
  }
}

function uses(a, b) {
  return [a + b, a - b, a * 2, a < b, a == 100, a | 0, -a, `${a}`, a + "", Math.max(a, b), [10, 20, 30][a / 100]];
}

////= total-3

function report(label, run) {
  log.length = 0;
  const result = outcome(run);
  console.log(label + " -> " + result + " | " + log.join(" "));
}

for (let i = 0; i < 1000; i++) {
  uses(new Money(100), new Money(250));
  total([new Money(1), new Money(2)]);
}

report("two amounts", () => uses(new Money(100), new Money(250)));
report("an amount and a number", () => uses(new Money(100), 250));
report("a number and an amount", () => uses(100, new Money(250)));
report("numbers", () => uses(100, 250));
report("a subclass that overrides valueOf", () => uses(new Tip(100), new Money(250)));
report("a subclass with Symbol.toPrimitive", () => uses(new Label(100), new Money(250)));
report("an amount of text", () => uses(new Money("100"), new Money(250)));
report("an amount of a bigint", () => uses(new Money(100n), new Money(250n)));
report("an amount of nothing", () => uses(new Money(), new Money(250)));
report("an amount of an amount", () => uses(new Money(new Money(100)), new Money(250)));
report("an own valueOf", () => uses(Object.assign(new Money(100), { valueOf: () => 7 }), new Money(250)));
report("an own valueOf that is no function", () => uses(Object.assign(new Money(100), { valueOf: 7 }), new Money(250)));
report("another prototype", () => uses(Object.setPrototypeOf(new Money(100), { valueOf: () => 8 }), new Money(250)));
report("no prototype", () => uses(Object.setPrototypeOf(new Money(100), null), new Money(250)));
report("total", () => total([new Money(1), new Money(2), new Tip(3), 4, "5", new Money(6)]));

const original = Money.prototype.valueOf;
Money.prototype.valueOf = function () {
  log.push("replaced");
  return this.cents + 1;
};
report("valueOf replaced on the prototype", () => uses(new Money(100), new Money(250)));
report("the subclass reaches the replacement", () => uses(new Tip(100), new Money(250)));
Money.prototype.valueOf = function () {
  log.push("gives a text");
  return String(this.cents);
};
report("valueOf gives a text", () => uses(new Money(100), new Money(250)));
Money.prototype.valueOf = function () {
  log.push("gives an object");
  return {};
};
report("valueOf gives an object", () => uses(new Money(100), new Money(250)));
delete Money.prototype.valueOf;
report("valueOf deleted", () => uses(new Money(100), new Money(250)));
Money.prototype[Symbol.toPrimitive] = function (hint) {
  log.push("added " + hint);
  return 5;
};
report("Symbol.toPrimitive added", () => uses(new Money(100), new Money(250)));
delete Money.prototype[Symbol.toPrimitive];
Money.prototype.valueOf = original;
report("everything restored", () => uses(new Money(100), new Money(250)));
//// numbers/a-constant-table-of-integers-is-changed-later.js
////= show-25

const PRIMES = [2, 3, 5, 7, 11, 13, 17, 19];
const WEIGHTS = { small: 1, medium: 2, large: 4 };
const GRID = [
  [1, 2, 3],
  [4, 5, 6],
];
const FROZEN = Object.freeze([1, 2, 3]);
const LIMITS = Object.freeze({ low: 0, high: 10 });

////= lines-37	prime	i	PRIMES[i

function sumOfPrimes() {
  let total = 0;
  for (let i = 0; i < PRIMES.length; i++) total += PRIMES[i];
  return total;
}

function xorOfPrimes() {
  let bits = 0;
  for (const value of PRIMES) bits ^= value;
  return bits;
}

function weight(name) {
  return WEIGHTS[name] * 2;
}

function totalWeight() {
  return WEIGHTS.small + WEIGHTS.medium + WEIGHTS.large;
}

function cell(y, x) {
  return GRID[y][x] + 1;
}

function frozenSum() {
  return FROZEN[0] + FROZEN[1] + FROZEN[2];
}

function inLimits(n) {
  return n >= LIMITS.low && n <= LIMITS.high;
}

function report() {
  return [prime(1), sumOfPrimes(), xorOfPrimes(), weight("medium"), totalWeight(), cell(1, 1), frozenSum(), inLimits(5), PRIMES.length];
}

for (let i = 0; i < 2000; i++) report();
attempt("before any change", report);

const changes = [
  ["PRIMES[1] = 0.5", () => (PRIMES[1] = 0.5)],
  ["PRIMES[1] = '3'", () => (PRIMES[1] = "3")],
  ["PRIMES[1] = undefined", () => (PRIMES[1] = undefined)],
  ["delete PRIMES[1]", () => delete PRIMES[1]],
  ["PRIMES[1] = 3n", () => (PRIMES[1] = 3n)],
  ["PRIMES[1] = -0", () => (PRIMES[1] = -0)],
  ["PRIMES[1] = 2147483648", () => (PRIMES[1] = 2147483648)],
  ["PRIMES[1] = 3", () => (PRIMES[1] = 3)],
  ["PRIMES.push(23)", () => PRIMES.push(23)],
  ["PRIMES.push('x')", () => PRIMES.push("x")],
  ["PRIMES.length = 3", () => (PRIMES.length = 3)],
  ["PRIMES.reverse()", () => PRIMES.reverse().length],
  ["PRIMES[10] = 1", () => (PRIMES[10] = 1)],
  ["PRIMES.length = 0", () => (PRIMES.length = 0)],
  ["WEIGHTS.medium = '2'", () => (WEIGHTS.medium = "2")],
  ["WEIGHTS.medium = 2.5", () => (WEIGHTS.medium = 2.5)],
  ["delete WEIGHTS.medium", () => delete WEIGHTS.medium],
  ["WEIGHTS.medium = 2", () => (WEIGHTS.medium = 2)],
  ["WEIGHTS.extra = 8", () => (WEIGHTS.extra = 8)],
  ["a getter for WEIGHTS.small", () => Object.keys(Object.defineProperty(WEIGHTS, "small", { get: () => 100, enumerable: true }))],
  ["GRID[1][1] = '5'", () => (GRID[1][1] = "5")],
  ["GRID[1] = [7, 8.5, 9]", () => (GRID[1] = [7, 8.5, 9]).length],
  ["GRID[1] = 'abc'", () => (GRID[1] = "abc")],
  ["FROZEN[0] = 9", () => (FROZEN[0] = 9)],
  ["FROZEN.push(9)", () => FROZEN.push(9)],
  ["LIMITS.high = 1", () => (LIMITS.high = 1)],
];

for (const [label, change] of changes) {
  console.log(label, "->", outcome(change));
  attempt("  then", report);
}
//// numbers/a-conversion-changes-the-other-operand-in-the-middle-of-an-expression.js
////= show-25

function sumWithACapturedVariable(makeOperand) {
  let n = 1;
  const operand = makeOperand(value => {
    n = value;
  });
  const first = n + operand;
  const second = operand + n;
  return [first, second, n];
}

function sumWithAField(makeOperand) {
  const holder = { n: 1 };
  const operand = makeOperand(value => {
    holder.n = value;
  });
  const first = holder.n + operand;
  const second = operand + holder.n;
  return [first, second, holder.n];
}

function sumWithAnElement(makeOperand) {
  const list = [1, 2, 3];
  const operand = makeOperand(value => {
    list[0] = value;
  });
  const first = list[0] + operand;
  const second = operand + list[0];
  return [first, second, list];
}

function compoundOnACapturedVariable(makeOperand) {
  let n = 1;
  const operand = makeOperand(value => {
    n = value;
  });
  n += operand;
  return n;
}

function compoundOnAField(makeOperand) {
  const holder = { n: 1 };
  const operand = makeOperand(value => {
    holder.n = value;
  });
  holder.n *= operand;
  return holder.n;
}

function compoundOnAnElement(makeOperand) {
  const list = [1, 2, 3];
  const operand = makeOperand(value => {
    list[0] = value;
    list.length = 1;
  });
  list[0] -= operand;
  return list;
}

function comparison(makeOperand) {
  let n = 1;
  const operand = makeOperand(value => {
    n = value;
  });
  return [n < operand, operand < n, n];
}

function loopBound(makeOperand) {
  let step = 1;
  const bound = makeOperand(value => {
    step = value;
  });
  const seen = [];
  for (let i = 0; i < bound; i += step) {
    seen.push(i);
    if (seen.length === 6) break;
  }
  return seen;
}

function indexAndElement(makeOperand) {
  const list = [10, 20, 30];
  const index = makeOperand(value => {
    list[1] = value;
  });
  return [list[+index % 3], list[1]];
}

const uses = [sumWithACapturedVariable, sumWithAField, sumWithAnElement, compoundOnACapturedVariable, compoundOnAField, compoundOnAnElement, comparison, loopBound, indexAndElement];
const honest = () => 4;
for (let i = 0; i < 1000; i++) for (const use of uses) use(honest);
for (const stored of [7, "7", 0.5, -0, undefined, null, 7n, NaN, 2147483647, [7]]) {
  const makeOperand = change => ({
    valueOf() {
      change(stored);
      return 4;
    },
  });
  for (const use of uses) attempt(use.name + " while the conversion stores " + show(stored), () => use(makeOperand));
}
for (const use of uses) attempt(use.name + " with a plain number", () => use(honest));
