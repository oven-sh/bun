    seen.push(value + 1);
    value = i % 3 === 0 ? "t" : i % 3 === 1 ? 1.5 : i;
  }
  return seen;
}

function changesInOneBranch(flag) {
  let value = 0;
  if (flag) value = "text";
  return [value + 1, value | 0, typeof value];
}

