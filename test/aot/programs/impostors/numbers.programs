  attempt("hashBySums(" + show(text) + ")", () => hashBySums(text));
}
//// numbers/arithmetic-functions-kept-in-fields-arrays-and-parameters-get-impostors.js
////= show-31

const toolbox = { add, scale, next, nested: { bucket } };
const pipeline = [next, bucket, value => scale(value, 2)];

function applyTwice(operation, value) {
  return operation(operation(value));
}

function runPipeline(value) {
  for (let i = 0; i < pipeline.length; i++) value = pipeline[i](value);
  return value;
}

function compose(first, second) {
  return value => second(first(value));
}

class Calculator {
  constructor(operation) {
    this.operation = operation;
  }
  run(a, b) {
    return this.operation(a, b);
  }
}

const adder = new Calculator(add);
const scaler = new Calculator(scale);
const nextBucket = compose(next, bucket);

let total = 0;
for (let i = 0; i < 2000; i++) total += toolbox.add(i, 1) + toolbox.scale(i, 2) + toolbox.next(i) + toolbox.nested.bucket(i) + applyTwice(next, i) + runPipeline(i) + adder.run(i, 1) + scaler.run(i, 2) + nextBucket(i);
console.log("the honest total", total);

const impostors = ["5", "", "abc", 1.5, -0, null, undefined, true, 5n, NaN, 2147483647, 4294967297, [5], { valueOf: () => 5 }, Symbol("s")];
for (const value of impostors) {
  const label = show(value);
  attempt("toolbox.add(" + label + ", 1)", () => toolbox.add(value, 1));
  attempt("toolbox.scale(" + label + ", 2)", () => toolbox.scale(value, 2));
  attempt("toolbox.next(" + label + ")", () => toolbox.next(value));
  attempt("toolbox.nested.bucket(" + label + ")", () => toolbox.nested.bucket(value));
  attempt("applyTwice(next, " + label + ")", () => applyTwice(next, value));
  attempt("applyTwice(bucket, " + label + ")", () => applyTwice(bucket, value));
  attempt("runPipeline(" + label + ")", () => runPipeline(value));
  attempt("adder.run(" + label + ", 1)", () => adder.run(value, 1));
  attempt("scaler.run(" + label + ", 2)", () => scaler.run(value, 2));
  attempt("nextBucket(" + label + ")", () => nextBucket(value));
}

toolbox.next = value => value + "!";
pipeline[0] = value => value + 0.5;
adder.operation = scale;
attempt("the field holds another function", () => [toolbox.next(1), runPipeline(1), adder.run(3, 4)]);
attempt("honest calls afterwards", () => [toolbox.add(1, 2), toolbox.scale(3, 4), applyTwice(next, 1), scaler.run(3, 4), nextBucket(30)]);
//// numbers/arithmetic-imported-from-a-module-gets-impostors/arithmetic.js
export function add(a, b) {
  return a + b;
}

export function scale(value, factor) {
  return value * factor;
}

export function bucket(value) {
  return value & 15;
}

export const next = value => value + 1;

export let counter = 0;

export function bump() {
  return ++counter;
}

export function setCounter(value) {
  counter = value;
}
//// numbers/arithmetic-imported-from-a-module-gets-impostors/impostors.js
export const impostors = ["5", "", 1.5, -0, null, undefined, true, 5n, NaN, 2147483647, 4294967297, [5], { valueOf: () => 5 }, Symbol("s")];
//// numbers/arithmetic-imported-from-a-module-gets-impostors/main.js
import { add, scale, bucket, next, counter, bump, setCounter } from "./arithmetic.js";
import * as everything from "./arithmetic.js";
import { show, attempt } from "./printing.js";
import { impostors } from "./impostors.js";

let total = 0;
for (let i = 0; i < 2000; i++) total += add(i, 1) + scale(i, 2) + bucket(i) + next(i) + bump();
console.log("the honest total", total, counter);

for (const value of impostors) {
  const label = show(value);
  attempt("add(" + label + ", 1)", () => add(value, 1));
  attempt("scale(" + label + ", 2)", () => scale(value, 2));
  attempt("bucket(" + label + ")", () => bucket(value));
  attempt("next(" + label + ")", () => next(value));
  attempt("everything.next(" + label + ")", () => everything.next(value));
  attempt("everything['ne' + 'xt'](" + label + ")", () => everything["ne" + "xt"](value));
  attempt("the exported counter becomes " + label, () => {
    setCounter(value);
    return [counter, everything.counter, counter + 1, counter | 0];
  });
  attempt("and is bumped", () => [bump(), counter, everything.counter]);
}

setCounter(2147483646);
attempt("the exported counter passes the largest int32", () => [bump(), bump(), bump(), counter, counter | 0]);
attempt("honest calls afterwards", () => [add(1, 2), scale(3, 4), bucket(300), next(41)]);
//// numbers/arithmetic-imported-from-a-module-gets-impostors/printing.js
export function show(value) {
  if (typeof value === "number") return Object.is(value, -0) ? "-0" : String(value);
  if (typeof value === "bigint") return value + "n";
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "symbol") return value.toString();
  if (typeof value !== "object" || value === null) return String(value);
  if (Array.isArray(value)) return "[" + value.map(show).join(", ") + "]";
  return Object.prototype.toString.call(value);
}

export function attempt(label, run) {
  try {
    console.log(label, "->", show(run()));
  } catch (error) {
    console.log(label, "-> threw", error.constructor.name);
  }
}
//// numbers/arithmetic-required-from-a-commonjs-module-gets-impostors/arithmetic.cjs
var hidden = 0;

exports.add = function (a, b) {
  return a + b;
};

exports.scale = function scale(value, factor) {
  return value * factor;
};

exports.bucket = function (value) {
  return value & 15;
};

exports.next = function (value) {
  return value + 1;
};

exports.counter = 0;

exports.bump = function () {
  exports.counter++;
  return ++hidden;
};

exports.read = function () {
  return hidden;
};

exports.viaExports = function () {
  return [this.counter * 2, exports.counter & 7];
};
//// numbers/arithmetic-required-from-a-commonjs-module-gets-impostors/impostors.cjs
module.exports = ["5", "", 1.5, -0, null, undefined, true, 5n, NaN, 2147483647, 4294967297, [5], { valueOf: () => 5 }, Symbol("s")];
//// numbers/arithmetic-required-from-a-commonjs-module-gets-impostors/main.cjs
const arithmetic = require("./arithmetic.cjs");
const { add, scale, bucket, next } = require("./arithmetic.cjs");
const { show, attempt } = require("./printing.cjs");
const impostors = require("./" + ["impostors", "cjs"].join("."));

let total = 0;
for (let i = 0; i < 2000; i++) total += add(i, 1) + scale(i, 2) + bucket(i) + next(i) + arithmetic.bump() + arithmetic.add(i, 1);
console.log("the honest total", total, arithmetic.counter, arithmetic.read());

for (const value of impostors) {
  const label = show(value);
  attempt("add(" + label + ", 1)", () => add(value, 1));
  attempt("scale(" + label + ", 2)", () => scale(value, 2));
  attempt("bucket(" + label + ")", () => bucket(value));
  attempt("next(" + label + ")", () => next(value));
  attempt("arithmetic.next(" + label + ")", () => arithmetic.next(value));
  attempt("arithmetic['ne' + 'xt'](" + label + ")", () => arithmetic["ne" + "xt"](value));
  attempt("exports.counter becomes " + label, () => {
    arithmetic.counter = value;
    return [arithmetic.counter, arithmetic.counter + 1, arithmetic.counter | 0, arithmetic.viaExports()];
  });
  attempt("and is incremented", () => [arithmetic.counter++, arithmetic.counter]);
}

arithmetic.next = value => value + "!";
attempt("a replaced export", () => [arithmetic.next(1), next(1), require("./arithmetic.cjs").next(1)]);
attempt("honest calls afterwards", () => [add(1, 2), scale(3, 4), bucket(300), next(41)]);
//// numbers/arithmetic-required-from-a-commonjs-module-gets-impostors/printing.cjs
function show(value) {
  if (typeof value === "number") return Object.is(value, -0) ? "-0" : String(value);
  if (typeof value === "bigint") return value + "n";
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "symbol") return value.toString();
  if (typeof value !== "object" || value === null) return String(value);
  if (Array.isArray(value)) return "[" + value.map(show).join(", ") + "]";
  return Object.prototype.toString.call(value);
}

////= attempt-18

module.exports = { show, attempt };
//// numbers/assignments-inside-arithmetic-change-a-variable-between-its-two-reads.js
////= show-25

function readThenAssigned(value) {
  let n = 1;
  return [n + (n = value), n];
}

function assignedThenRead(value) {
  let n = 1;
  return [(n = value) + n, n];
}

function readThenIncremented(value) {
  let n = value;
  return [n + n++, n];
}

function incrementedThenRead(value) {
  let n = value;
  return [n++ + n, n];
}

function multipliedByItsOwnUpdate(value) {
  let n = value;
  return [n * ++n, n];
}

function compoundWithAnAssignmentInside(value) {
  let n = 1;
  n += n = value;
  return n;
}

function indexUpdatedWhileStoring(value) {
  const list = [0, 0, 0, 0];
  let i = 0;
  list[i++] = i;
  list[i] = i = value;
  return [list.slice(0, 4), Object.keys(list), i];
}

function elementAndIndexInOneExpression(value) {
  const list = [10, 20, 30];
  let i = 0;
  return [list[i] + list[(i = value)], i];
}

function argumentsInOrder(value) {
  let n = 1;
  return [[n, (n = value), n, n++, n]];
}

function conditionAssigns(value) {
  let n = 1;
  const result = (n = value) ? n + 1 : n - 1;
  return [result, n];
}

function commaAssigns(value) {
  let n = 1;
  return [(n++, (n = value), n + 1), n];
}

function shortCircuitSkipsTheStore(value) {
  let n = 0;
  const result = n && (n = value);
  const other = n || (n = value);
  return [result, other, n, n + 1];
}

const uses = [readThenAssigned, assignedThenRead, readThenIncremented, incrementedThenRead, multipliedByItsOwnUpdate, compoundWithAnAssignmentInside, indexUpdatedWhileStoring, elementAndIndexInOneExpression, argumentsInOrder, conditionAssigns, commaAssigns, shortCircuitSkipsTheStore];
for (let i = 0; i < 2000; i++) for (const use of uses) use(i % 3);
for (const use of uses) for (const value of [2, "2", 1.5, -0, 0, null, undefined, true, 2n, NaN, 2147483647, [2], { valueOf: () => 2 }]) attempt(use.name + "(" + show(value) + ")", () => use(value));
