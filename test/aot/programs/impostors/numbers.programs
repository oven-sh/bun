const changes = {
  "stores a text further on": list => {
    list[3] = "100";
  },
  "stores a fraction further on": list => {
    list[3] = 0.5;
  },
  "stores undefined further on": list => {
    list[3] = undefined;
  },
  "deletes an element further on": list => {
