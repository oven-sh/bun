class Playlist {
  constructor(length, name, size) {
    this.length = length;
    this.name = name;
    this.size = size;
    this.description = "a playlist";
  }
  toFixed(digits) {
    return "playlist fixed to " + digits;
  }
  at(index) {
    return "track " + index;
  }
  slice(from) {
    return "tracks from " + from;
  }
  valueOf() {
    return this.length;
  }
  toString() {
    return "playlist " + this.name;
  }
}

