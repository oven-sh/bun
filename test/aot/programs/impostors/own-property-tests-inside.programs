////: drain
function drain(step: Step, between: () => void) {
  const steps = stepwise(step);
  const first = steps.next().value;
  between();
  const second = steps.next().value;
  return `${first} ${second} ${steps.next().value}`;
}
////: exercise
function exercise(change: boolean) {
  const calls: number[] = [];
  let sum = 0;
  for (let i = 0; i < 3000; i++) {
    const links = new Links(i);
    sum += read(links) ?? 1;
    if (i & 1) write(links, 2);
    sum += read(links) ?? 1;
  }
  const old = new Links(1);
  if (change) {
    Object.defineProperty(Object.getPrototypeOf(old), "resolved", {
      get() {
        return 50;
      },
      set(value: number) {
        calls.push(value);
      },
      configurable: true,
    });
  }
  const fresh = new Links(2);
  const seen = `${read(old)} ${read(fresh)}`;
  write(old, 3);
  write(fresh, 4);
  return `${sum} ${seen} ${read(old)} ${read(fresh)} [${Object.keys(old)}] [${calls}]`;
}
