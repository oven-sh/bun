////= writePages

let length = 0;
for (let i = 0; i < 3000; i++) length += readDoc(new Doc(i)).length + writePages(new Page(i), new Page(i)).length;
console.log("warm", length);

armed = true;
const doc = new Doc(1);
console.log("the trap:", readDoc(doc), "|", readDoc(new Doc(2)), "|", Object.keys(doc).join());
armed = true;
