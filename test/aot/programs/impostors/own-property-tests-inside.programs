////: stepwise
function* stepwise(step: Step): Generator<number | undefined, string, void> {
  yield step.result;
  yield step.result;
  step.result = 6;
  return `${step.result} [${Object.keys(step)}]`;
}
////: storeDefineStore
function storeDefineStore(first: Task, second: Task, holder: object, name: string) {
  first.owner = "before";
  Object.defineProperty(holder, name, {
    set(this: Task, value: string) {
      log.push(`set ${value} on ${this.id}`);
    },
    configurable: true,
  });
  second.owner = "after";
}
////: storesInALoop
function storesInALoop(object: ByKey, rounds: number, holder: object, log: number[]) {
  for (let i = 0; i < rounds; i++) {
    delete object.v;
    if (i === rounds - 2) Object.defineProperty(holder, "v", { set: value => void log.push(value), configurable: true });
    object.v = i;
  }
  return `${object.v} [${Object.keys(object)}] ${log}`;
}
////: throughTheAccessor
function throughTheAccessor(gauges: Gauge[], at: number) {
  let sum = 0;
  for (let i = 0; i < gauges.length; i++) {
    const gauge = gauges[i];
    if (i === at) armed = "accessor";
    sum += gauge.peak ?? 0;
    sum += gauge.level;
    sum += gauge.peak ?? 0;
  }
  return sum;
}
////: throughToString
function throughToString(gauges: Gauge[], at: number) {
  let sum = 0;
  for (let i = 0; i < gauges.length; i++) {
    const gauge = gauges[i];
    if (i === at) armed = "toString";
    sum += `${gauge.peak ?? ""}${gauge}${gauge.peak ?? ""}`.length;
  }
  return sum;
}
////: throughValueOf
function throughValueOf(gauges: Gauge[], at: number) {
  let sum = 0;
  for (let i = 0; i < gauges.length; i++) {
    const gauge = gauges[i];
    if (i === at) armed = "valueOf";
    sum += (gauge.peak ?? 0) + +gauge + (gauge.peak ?? 0);
  }
  return sum;
}
////: traps
function traps(name: string): ProxyHandler<object> {
  return {
    get(target, key, receiver) {
      if (typeof key === "string") log.push(`${name} get ${key} for ${(Object.getOwnPropertyDescriptor(receiver, "id") ?? {}).value}`);
      return key === "memo" ? 500 : Reflect.get(target, key, receiver);
    },
    has(target, key) {
      log.push(`${name} has ${String(key)}`);
      return key === "memo" || Reflect.has(target, key);
    },
    set(target, key, value, receiver) {
      log.push(`${name} set ${String(key)} = ${value}`);
      return value > 100 ? Reflect.defineProperty(receiver, key, { value, writable: true, enumerable: true, configurable: true }) : true;
    },
  };
}
////: twice
async function twice(job: Job, gate: Promise<void>) {
  const before = job.result;
  await gate;
  const after = job.result;
  job.result = 5;
  return `${before} ${after} ${job.result} [${Object.keys(job)}]`;
}
////: untyped
function untyped(node: any) {
  const child = node.child;
  return `${typeof node.count}:${String(node.count)} ${typeof node.name}:${JSON.stringify(node.name)} ${typeof child}:${child && child.id} ${typeof node.flag}:${String(node.flag)}`;
}
