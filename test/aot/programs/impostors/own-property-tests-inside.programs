function createSymbol(flags: number, checkFlags: number) {
  const symbol = new Sym(flags);
  symbol.links = make(checkFlags);
  return symbol;
}
function state(links: LinksShape) {
  return `${links.checkFlags} ${links.target?.id} ${links.nameType?.id} [${Object.keys(links)}]`;
}

let length = 0;
for (let i = 0; i < 3000; i++) {
  length += state(make(i & 7)).length + makeAndLook(i & 7).length + Object.keys(createSymbol(i, i)).length;
}
console.log("warm", length);

const holder: any = Object.getPrototypeOf(make(0));
Object.defineProperty(holder, ["check", "Flags"].join(""), {
  get() {
    return -1;
  },
  set(value: number) {
    log.push("checkFlags = " + value);
  },
  configurable: true,
});
holder[["name", "Type"].join("")] = { id: 77 };
console.log("make:", state(make(3)), "|", log.join(", "));
console.log("make and look:", makeAndLook(4), "|", log.join(", "));
Object.defineProperty(Object.getPrototypeOf(new Sym(0)), "links", {
  set(this: Sym, value: LinksShape) {
    log.push("links offered to symbol " + this.flags);
  },
  configurable: true,
});
const symbol = createSymbol(5, 6);
console.log("a symbol:", Object.keys(symbol).join(), symbol.links, "|", log.join(", "));
log.length = 0;
delete holder.checkFlags;
delete holder.nameType;
delete (Sym.prototype as any).links;
console.log("gone again:", state(make(7)), "|", makeAndLook(8), "|", Object.keys(createSymbol(9, 9)).join(), log.length);
//// prototype-names/a-function-returns-a-new-class-each-call-and-one-of-them-is-changed.ts
// One class expression is evaluated many times: each evaluation has a prototype object of its own, and all share the compiled code.
// The prototype of one evaluation gets the name; its instances must inherit, the instances of the others must not. A class evaluated after the change starts clean.
////= lines-72	Model	id	number	cached	number
type ModelClass = new (id: number) => Model;
const log: string[] = [];
function defineModel(): ModelClass {
  return class implements Model {
    declare id: number;
    declare cached?: number;
    constructor(id: number) {
      this.id = id;
    }
  };
}
////= lines-14	read	model	Model	return	model.cached
////= lines-264	remember	model	Model	model.cached	model.id	3
function state(model: Model) {
  return `${read(model)} ${"cached" in model} [${Object.keys(model)}]`;
}

const classes: ModelClass[] = [];
for (let i = 0; i < 6; i++) classes.push(defineModel());
let sum = 0;
for (let i = 0; i < 3000; i++) {
  const model = new classes[i % 6](i & 7);
  sum += read(model) ?? 1;
  if (i & 1) sum += remember(model);
}
console.log("warm", sum);

const old = classes.map((C, index) => new C(index));
classes[2].prototype["cach" + "ed"] = 222;
Object.defineProperty(classes[4].prototype, "cached", {
  get() {
    return undefined;
  },
  set(this: Model, value: number) {
    log.push(`set ${value} on ${this.id}`);
  },
  configurable: true,
});
const later = defineModel();
classes.push(later);
old.push(new later(6));
console.log("old instances:", old.map(state).join(" | "));
console.log("new instances:", classes.map((C, index) => state(new C(index))).join(" | "));
console.log("remember:", old.map(remember).join(), "|", log.join(", "));
console.log("old instances:", old.map(state).join(" | "));
sum = 0;
for (let i = 0; i < 3000; i++) {
  const model = new classes[i % 7](i & 7);
  sum += read(model) ?? 1;
  if (i & 1) sum += remember(model) ?? 0;
}
console.log("mixed", sum, log.length);
for (let i = 0; i < 2000; i++) {
  const C = defineModel();
  if (i % 500 === 0) C.prototype.cached = i;
  const model = new C(i);
  if (i % 250 === 0) console.log("evaluation", i, state(model), remember(model));
}
