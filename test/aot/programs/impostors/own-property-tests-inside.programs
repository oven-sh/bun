const targets = [
  ["a literal", () => ({ plain: true })],
  ["a vault", () => new Vault(1)],
  ["an array", () => [1, 2]],
  ["a function", () => function target() {}],
  ["a frozen literal", () => Object.freeze({ plain: true })],
  ["a proxy", () => new Proxy({}, {})],
