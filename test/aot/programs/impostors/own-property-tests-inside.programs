class Vault {
  #code;
  label = "vault";
  constructor(code) {
    this.#code = code;
  }
  reveal() {
    return this.#code;
  }
  change(code) {
    this.#code = code;
    return this.#code;
  }
  #double() {
    return this.#code * 2;
  }
  doubled() {
    return this.#double();
  }
  static isVault(value) {
    return #code in value;
  }
  static revealOf(value) {
    return value.#code;
  }
  static same(one, other) {
    return one.#code === other.#code;
  }
}

class Stamp extends handBack {
  #ink = "stamped";
  static read(value) {
    return value.#ink;
  }
  static write(value, ink) {
    value.#ink = ink;
    return value.#ink;
  }
  static has(value) {
    return #ink in value;
  }
}

class LookAlike {
  #code;
  label = "vault";
  constructor(code) {
    this.#code = code;
  }
  reveal() {
    return "the look-alike's " + this.#code;
  }
}

