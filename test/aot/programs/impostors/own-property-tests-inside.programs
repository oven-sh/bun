const log = [];
const catcher = {
  set late(value) {
    log.push("the setter of the new prototype got " + value);
  },
};

function makeSource() {
  const source = { early: 1 };
  Object.defineProperty(source, "__proto__", { value: catcher, enumerable: true });
  source.late = 2;
  return source;
}

