//// prototype-names/six-ways-to-declare-an-optional-field-differ-in-whether-the-property-exists-at-birth.ts
// `declare x?: T` makes nothing. `x?: T;` defines the property with undefined, in the order of the declarations. So do `x?: T = undefined` and `x: T | undefined;`.
// A parameter property stores what it was given, even undefined. A field of a merged interface makes nothing. `in`, the keys and their order tell them apart.
// A base constructor that calls a method of the derived class stores a field before the derived class defines it: the definition then puts undefined over the value.
class Declared {
  declare x?: number;
  tail = 1;
}
class Defined {
  x?: number;
  tail = 1;
}
class Initialized {
  x?: number = undefined;
  tail = 1;
}
class Union {
  x: number | undefined;
  tail = 1;
}
class Parameter {
  tail = 1;
  constructor(public x?: number) {}
}
interface Merged {
  x?: number;
}
////= lines-78	Merged	tail	1
type WithX = { x?: number; tail: number };
////= lines-14	xOf	object	WithX	return	object.x
function setX(object: WithX, value: number | undefined) {
  object.x = value;
}
function state(object: WithX) {
  return `${xOf(object)} ${"x" in object} ${Object.hasOwn(object, "x")} [${Object.keys(object)}] ${JSON.stringify(object)}`;
}
const makers: [string, () => WithX][] = [
  ["declare x?", () => new Declared()],
  ["x?", () => new Defined()],
  ["x? = undefined", () => new Initialized()],
  ["x: T | undefined", () => new Union()],
  ["a parameter property, nothing given", () => new Parameter()],
  ["a parameter property, 5 given", () => new Parameter(5)],
  ["a merged interface", () => new Merged()],
];

let length = 0;
for (let i = 0; i < 3000; i++) {
  const object = makers[i % makers.length][1]();
  length += state(object).length;
  if (i & 1) setX(object, 3);
  length += Object.keys(object).join().length;
}
console.log("warm", length);

for (const [label, make] of makers) {
  const born = make();
  const stored = make();
  setX(stored, 3);
  const cleared = make();
  setX(cleared, undefined);
  const deleted = make();
  delete deleted.x;
  const again = make();
  delete again.x;
  setX(again, 4);
  console.log(`${label}: ${state(born)} | ${state(stored)} | ${state(cleared)} | ${state(deleted)} | ${state(again)}`);
}

class Base {
  constructor() {
    this.init();
  }
  init() {}
}
class KeepsIt extends Base {
  declare early?: number;
  other = 1;
  init() {
    this.early = 5;
  }
}
class LosesIt extends Base {
  early?: number;
  other = 1;
  init() {
    this.early = 5;
  }
}
class OverwritesIt extends Base {
  other = 1;
  early?: number = 6;
  init() {
    this.early = 5;
  }
}
for (let i = 0; i < 3000; i++) length += (new KeepsIt().early ?? 0) + (new LosesIt().early ?? 0) + (new OverwritesIt().early ?? 0);
console.log("warm", length);
for (const object of [new KeepsIt(), new LosesIt(), new OverwritesIt()]) console.log(object.constructor.name, object.early, "early" in object, Object.keys(object).join(), JSON.stringify(object));
//// prototype-names/static-fields-are-filled-late-and-the-base-constructor-gets-the-name.ts
// The other side of a class: the constructors form a chain too. A static field that is only declared is filled late on the derived constructor (`Derived.instance ??= ..`);
// then the base constructor gets a value, accessors and a read-only member of that name.
const log: string[] = [];
class Service {
  declare static instance?: Service;
  declare static uses?: number;
  constructor(public name: string) {}
}
class Mailer extends Service {}
class Logger extends Service {}
function instanceOf(target: typeof Service) {
  return (target.instance ??= new target(target.name.toLowerCase()));
}
function use(target: typeof Service) {
  target.uses = (target.uses ?? 0) + 1;
  return target.uses;
}
function state(target: typeof Service) {
  return `${target.instance?.name} ${target.uses} [${Object.keys(target)}]`;
}
function all() {
  return [Service, Mailer, Logger].map(state).join(" | ");
}
////= attempt-21

console.log("start:", all());
let sum = 0;
for (let i = 0; i < 3000; i++) {
  sum += use(Mailer) + instanceOf(Mailer).name.length;
  if (i % 1000 === 999) {
    delete Mailer.uses;
    delete Mailer.instance;
  }
}
console.log("warm", sum, all());
const base: any = Object.getPrototypeOf(Logger);
base["uses"] = 100;
base["instance"] = new Service("shared");
console.log("values on the base:", all());
console.log("used:", use(Logger), use(Logger), use(Mailer), instanceOf(Logger).name, instanceOf(Mailer).name, "|", all());
delete Logger.uses;
delete Mailer.uses;
Object.defineProperty(base, "uses", {
  get() {
    return 7;
  },
  set(this: typeof Service, value: number) {
    log.push(`${this.name}.uses = ${value}`);
  },
  configurable: true,
});
console.log("accessors on the base:", use(Logger), use(Mailer), use(Service), "|", all(), "|", log.join(", "));
Object.defineProperty(base, "uses", { value: 1, writable: false, configurable: true });
console.log("read-only on the base:", attempt(() => use(Logger)), attempt(() => use(Service)), "|", all());
delete base.uses;
delete base.instance;
console.log("gone again:", all(), "|", use(Logger), instanceOf(Logger).name, "|", all());
//// prototype-names/subclasses-of-map-array-and-error-get-names-on-their-own-prototypes.ts
// Subclasses of Map, Array and Error have optional fields. The names arrive on the prototypes of the subclasses, not of the built-ins.
// The instances are cells of the built-in kinds, so their fields may live elsewhere than in the slots of an ordinary object.
const log: string[] = [];
class Registry extends Map<string, number> {
  declare owner?: string;
}
class Stack extends Array<number> {
  declare limit?: number;
}
////= lines-137	Failure	Error	code	number
////= lines-14	ownerOf	registry	Registry	return	registry.owner
////= lines-14	limitOf	stack	Stack	return	stack.limit
////= lines-14	codeOf	failure	Failure	return	failure.code
function fill(registry: Registry, stack: Stack, failure: Failure) {
  registry.owner = "me";
  stack.limit = 4;
  failure.code = 404;
}
function state(registry: Registry, stack: Stack, failure: Failure) {
  return `${ownerOf(registry)} ${limitOf(stack)} ${codeOf(failure)} [${Object.keys(registry)}] [${Object.keys(stack)}] [${Object.keys(failure)}]`;
}
function trio(): [Registry, Stack, Failure] {
  const stack = new Stack();
  stack.push(1, 2);
  return [new Registry([["a", 1]]), stack, new Failure("failed")];
}

let length = 0;
for (let i = 0; i < 2000; i++) {
  const three = trio();
  length += state(...three).length;
  if (i & 1) fill(...three);
  length += state(...three).length;
}
console.log("warm", length);

const empty = trio();
const filled = trio();
fill(...filled);
const key = (text: string) => JSON.parse(JSON.stringify(text)) as string;
(Registry.prototype as any)[key("owner")] = "everyone";
Object.defineProperty(Stack.prototype, key("limit"), {
  get(this: Stack) {
    return this.length * 10;
  },
  set(this: Stack, value: number) {
    log.push(`limit ${value} on a stack of ${this.length}`);
  },
  configurable: true,
});
Object.defineProperty(Failure.prototype, key("code"), { value: 500, writable: false, configurable: true });
console.log("inherited:", state(...empty), "|", state(...filled), "|", state(...trio()));
try {
  fill(...empty);
} catch (error) {
  console.log("the store of the code:", (error as Error).constructor.name);
}
console.log("after the stores:", state(...empty), "|", log.join(", "));
console.log("still themselves:", empty[0].get("a"), empty[1].length, empty[1].map(n => n * 2) instanceof Stack, empty[2].message, empty[2] instanceof Failure);
delete (Registry.prototype as any).owner;
delete (Stack.prototype as any).limit;
delete (Failure.prototype as any).code;
console.log("gone again:", state(...empty), "|", state(...trio()));
fill(...empty);
console.log("filled:", state(...empty), log.length);
