//// prototype-names/reflect-construct-makes-instances-under-the-prototype-of-another-function.ts
// Reflect.construct(C, args, other) runs the compiled constructor of C, and the object it fills has other.prototype above it.
// That prototype has a value, a setter or a read-only member under the names the constructor and the typed functions store.
const log: string[] = [];
class Ticket {
  declare id?: number;
  declare seat?: string;
  constructor(id: number) {
    this.id = id;
  }
}
function WithValue() {}
WithValue.prototype.seat = "any seat";
function WithSetters() {}
Object.defineProperties(WithSetters.prototype, {
  id: {
    set(value: number) {
      log.push("id = " + value);
    },
    configurable: true,
  },
  seat: {
    get() {
      return "seat from the getter";
    },
    set(value: string) {
      log.push("seat = " + value);
    },
    configurable: true,
  },
});
function ReadOnly() {}
Object.defineProperty(ReadOnly.prototype, "id", { value: -1, writable: false });
class Heir extends Ticket {}
Object.defineProperty(Heir.prototype, "seat", {
  get() {
    return "seat of the heir";
  },
  set(value: string) {
    log.push("heir's seat = " + value);
  },
  configurable: true,
});
////= lines-14	seatOf	ticket	Ticket	return	ticket.seat
////= lines-16	assign	ticket	Ticket	seat	string	ticket.seat
function state(ticket: Ticket) {
  return `${ticket.id} ${seatOf(ticket)} ${ticket instanceof Ticket} [${Object.keys(ticket)}]`;
}
function construct(target: Function, id: number): Ticket | string {
  try {
    return Reflect.construct(Ticket, [id], target);
  } catch (error) {
    return (error as Error).constructor.name;
  }
}

let length = 0;
for (let i = 0; i < 3000; i++) {
  const ticket = new Ticket(i);
  length += seatOf(ticket)?.length ?? 1;
  if (i & 1) assign(ticket, "12A");
  length += state(ticket).length;
}
console.log("warm", length);

const targets: Function[] = [Ticket, WithValue, WithSetters, ReadOnly, Heir, Object, function () {}.bind(null)];
for (let round = 0; round < 2; round++) {
  for (const target of targets) {
    const made = construct(target, 5);
    if (typeof made === "string") {
      console.log(target.name, "->", made);
      continue;
    }
    const before = state(made);
    assign(made, "1B");
    console.log(target.name, "->", before, "|", state(made), "|", log.join(", "));
    log.length = 0;
  }
}
console.log("an ordinary one afterwards:", state(new Ticket(6)));
//// prototype-names/reflect-set-and-reflect-define-property-change-the-prototype.ts
// Reflect.set and Reflect.defineProperty put members on the prototypes of two classes, between two reads of the same instance.
// Reflect.set with an instance as the receiver goes the other way: it must fill the instance, or call the setter that is inherited by then.
////= lines-13	First	id	number	mark	number
////= lines-13	Second	id	number	mark	number
const log: string[] = [];
////= lines-14	readFirst	object	First	return	object.mark
////= lines-14	readSecond	object	Second	return	object.mark
////= lines-16	writeSecond	object	Second	value	number	object.mark
function aroundSet(object: First, holder: object, name: string) {
  const before = object.mark;
  const answer = Reflect.set(holder, name, 5);
  return `${before} ${answer} ${object.mark}`;
}
////= aroundDefine
function describe(object: First | Second) {
  return `${object.mark} ${"mark" in object} ${Object.hasOwn(object, "mark")} [${Object.keys(object)}]`;
}

let sum = 0;
////= for-112
