////: routes
const routes: [string, new (id: number) => Probe, (old: Probe) => any][] = [
  ["Reflect.get", A, () => Reflect.get(A, "prototype")],
  ["a computed name", B, () => (B as any)["proto" + "type".slice(0)]],
  ["a pattern", C, () => { const { prototype } = C; return prototype; }],
  ["a descriptor", D, () => Object.getOwnPropertyDescriptor(D, "prototype")!.value],
  ["all descriptors", E, () => Object.getOwnPropertyDescriptors(E).prototype.value],
  ["own keys", F, () => Reflect.ownKeys(F).map(key => (F as any)[key]).find(value => typeof value === "object")],
  ["the getter of __proto__", G, old => protoGetter.call(old)],
  ["Reflect.apply", H, old => Reflect.apply(Object.getPrototypeOf, undefined, [old])],
];
////: setC
function setC(row: «1») {
  row.c = { n: 3 };
}
////: state
function state(gadget: Gadget) {
  const names: string[] = [];
  for (const name in gadget) names.push(name);
  return `${powerOf(gadget)} ${"power" in gadget} [${Object.keys(gadget)}] [${names}] ${JSON.stringify(gadget)} ${JSON.stringify(Object.getOwnPropertyDescriptor(gadget, "power"))}`;
}
////: storeDeleteRead
function storeDeleteRead(a: Shape, b: Shape) {
  a.x = 1;
  delete b.x;
  return `${a.x} ${"x" in a}`;
}
////: storeStoreRead
function storeStoreRead(a: Shape, b: Shape) {
  a.x = 1;
  b.x = 2;
  return `${a.x} ${b.x}`;
}
////: treat
async function treat(special: Special) {
  const awaited: unknown = await (special as unknown);
  let spread: string;
  try {
    spread = [...(special as Iterable<number>)].join();
  } catch (error) {
    spread = (error as Error).constructor.name;
  }
  return [
    awaited === special ? "itself" : awaited,
    JSON.stringify(special),
    JSON.stringify({ inner: special }),
    `${special as unknown as string}`,
    +(special as unknown as number),
    spread,
    Object.prototype.toString.call(special),
    Reflect.ownKeys(special).length,
  ].join(" | ");
}
////: untypedBetween
function untypedBetween(a: Shape, b: any) {
  const before = a.x;
  b.x = 10;
  const stored = a.x;
  delete b.x;
  return `${before} ${stored} ${a.x}`;
}
////: warm
function warm(make: (id: number) => { id: number; extra?: number }) {
  let sum = 0;
  for (let i = 0; i < 3000; i++) {
    const object = make(i & 7);
    sum += object.extra ?? 1;
    if (i & 1) object.extra = 2;
    sum += object.extra ?? 1;
  }
  return sum;
}
////: write
function write(probe: Probe, value: number) {
  try {
    probe.v = value;
    return 1;
  } catch {
    return 1000;
  }
}
//// prototype-names/optional-fields-are-created-and-deleted-while-for-in-walks-the-object-with-class-fields-that-the-constructor-deletes.ts
// for-in takes its list of names at the start, but a name that is deleted before its turn must be left out, and a name created during the walk is not visited.
// The body of the loop stores optional fields for the first time, deletes others, deletes and stores again, and puts an enumerable name on the prototype in the middle.
// In this twin the optional fields are class fields without `declare`: they are defined at birth and the constructor deletes them, so the slots are declared and empty. Every instance may reach unknown code.
const unknownCodeRuns = process.argv.length > 99;
////= handOver
class Walked {
  a?: number;
  b?: number;
  c?: number;
  d?: number;
  e?: number;
  constructor() {
    delete this.a;
    delete this.b;
    delete this.c;
    delete this.d;
    delete this.e;
    handOver(this);
  }
}
function make(names: string) {
  const walked = new Walked();
  for (const name of names) (walked as any)[name] = name.charCodeAt(0);
  return walked;
}
////= fillTyped
////= walk-2
function createB(name: string, walked: Walked) {
  if (name === "a") walked.b = 2;
}
function deleteE(name: string, walked: Walked) {
  if (name === "a") delete walked.e;
}
////= deleteAndRestoreE
function deleteCurrent(name: string, walked: Walked) {
  delete (walked as any)[name];
}
////= deleteAllAtOnce

let length = 0;
for (let i = 0; i < 3000; i++) length += walk(fillTyped(new Walked()), i & 1 ? createB : deleteE).length;
console.log("warm", length);

console.log("nothing happens:", walk(fillTyped(new Walked()), () => {}));
console.log("b is created:", walk(fillTyped(new Walked()), createB));
console.log("e is deleted before its turn:", walk(fillTyped(new Walked()), deleteE));
console.log("e is deleted and stored again:", walk(fillTyped(new Walked()), deleteAndRestoreE));
console.log("each is deleted at its turn:", walk(fillTyped(new Walked()), deleteCurrent));
console.log("the rest is deleted, another created:", walk(fillTyped(new Walked()), deleteAllAtOnce));
console.log("other orders of creation:", walk(make("edcba"), deleteE), "|", walk(make("bd"), createB), "|", walk(make("ea"), deleteAndRestoreE));
const holder: any = Object.getPrototypeOf(new Walked());
////= console-log-9
console.log("d is inherited from the start:", walk(fillTyped(new Walked()), () => {}), "|", walk(fillTyped(new Walked()), (name, walked) => { if (name === "a") walked.d = 4; }));
////= console-log-10
console.log("gone again:", walk(fillTyped(new Walked()), () => {}));
//// prototype-names/optional-fields-named-like-the-members-of-object-prototype.ts
// The declared optional fields of this class and of this interface are called toString, valueOf, constructor, hasOwnProperty, isPrototypeOf, toLocaleString and __proto__.
// An empty slot under such a name does not read as undefined: Object.prototype has the name. A store to __proto__ makes no property at all: it calls the setter up there.
class Odd {
  declare id: number;
  declare toString?: () => string;
  declare valueOf?: () => number;
  declare hasOwnProperty?: (name: PropertyKey) => boolean;
  declare isPrototypeOf?: (object: object) => boolean;
  declare toLocaleString?: () => string;
  constructor(id: number) {
    this.id = id;
  }
}
interface Loose {
  id: number;
  toString?: () => string;
  valueOf?: () => Object;
  constructor?: Function;
  __proto__?: object | null;
}
function kinds(odd: Odd) {
  return [odd.toString, odd.valueOf, odd.hasOwnProperty, odd.isPrototypeOf, odd.toLocaleString].map(member => typeof member).join();
}
function same(odd: Odd) {
  const top = Object.prototype;
  return [odd.toString === top.toString, odd.valueOf === (top.valueOf as unknown), odd.hasOwnProperty === top.hasOwnProperty, odd.isPrototypeOf === top.isPrototypeOf, odd.toLocaleString === top.toLocaleString].join();
}
function textOf(odd: Odd) {
  return odd.toString ? odd.toString() : "no toString";
}
function callOptional(odd: Odd) {
  return `${odd.toString?.()} ${typeof odd.valueOf?.()} ${odd.hasOwnProperty?.("id")} ${odd.toLocaleString?.()}`;
}
function setText(odd: Odd, f: () => string) {
  odd.toString = f;
}
function orDefault(odd: Odd) {
  return (odd.valueOf ??= () => 42);
}
function looseKinds(loose: Loose) {
  return `${typeof loose.toString} ${typeof loose.valueOf} ${loose.constructor === Object} ${loose.__proto__ === Object.prototype} [${Object.keys(loose)}]`;
}
function link(loose: Loose, above: object | null) {
  loose.__proto__ = above;
}

let length = 0;
for (let i = 0; i < 3000; i++) {
  const odd = new Odd(i & 7);
  length += kinds(odd).length + textOf(odd).length + `${odd}`.length;
  if (i & 1) setText(odd, () => "own");
  length += textOf(odd).length + `${odd}`.length + looseKinds({ id: i }).length;
}
console.log("warm", length);

const empty = new Odd(1);
console.log("empty slots:", kinds(empty), "|", same(empty), "|", textOf(empty), "|", callOptional(empty), "|", `${empty}`, Object.keys(empty).join());
console.log("in and own:", "toString" in empty, Object.hasOwn(empty, "toString"), "valueOf" in empty, Object.hasOwn(empty, "valueOf"));
console.log("??= keeps what is inherited:", orDefault(empty) === (Object.prototype.valueOf as unknown), Object.keys(empty).join());
setText(empty, () => "my own text");
empty.hasOwnProperty = () => false;
console.log("stored:", kinds(empty), "|", same(empty), "|", textOf(empty), "|", callOptional(empty), "|", `${empty}`, Object.keys(empty).join());
delete empty.toString;
delete empty.hasOwnProperty;
console.log("deleted:", same(empty), "|", textOf(empty), "|", Object.keys(empty).join());

const loose: Loose = { id: 1 };
console.log("a literal:", looseKinds(loose));
loose.constructor = Odd;
loose.valueOf = () => 7;
console.log("stored:", looseKinds(loose), +(loose as any) + 1);
const above = { inherited: true, toString: () => "from above" };
link(loose, above);
console.log("a store to __proto__:", Object.getPrototypeOf(loose) === above, Object.hasOwn(loose, "__proto__"), (loose as any).inherited, loose.toString!(), Object.keys(loose).join());
link(loose, null);
console.log("null:", Object.getPrototypeOf(loose), loose.__proto__, typeof loose.toString, Object.keys(loose).join());
link(loose, above);
console.log("no setter is left:", Object.getPrototypeOf(loose), loose.__proto__ === above, Object.keys(loose).join());
const written: Loose = { id: 2, __proto__: above };
const computed: Loose = { id: 3, ["__proto__"]: above };
console.log("in literals:", Object.getPrototypeOf(written) === above, Object.keys(written).join(), "|", Object.getPrototypeOf(computed) === Object.prototype, Object.keys(computed).join());
