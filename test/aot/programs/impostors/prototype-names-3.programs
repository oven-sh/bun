////: arm
function arm(special: Special) {
  special.then = resolve => resolve("resolved by then of " + special.id);
  special.toJSON = () => "json of " + special.id;
  special[Symbol.toPrimitive] = hint => (hint === "number" ? special.id * 100 : "primitive " + special.id);
  special[Symbol.iterator] = function* () {
    yield special.id;
    yield special.id + 1;
  };
  special[Symbol.toStringTag] = "Tagged";
}
////: aroundDefine
function aroundDefine(object: Second, holder: object, name: string) {
  const before = object.mark;
  const answer = Reflect.defineProperty(holder, name, {
    get() {
      return 6;
    },
    set(this: Second, value: number) {
      log.push(`set ${value} on ${this.id}`);
    },
    configurable: true,
  });
  return `${before} ${answer} ${object.mark}`;
}
////: aroundThree
function aroundThree(object: ByProto) {
  const before = object.cache;
  Object.defineProperty((object as any).__proto__, "cache", {
    get() {
      return undefined;
    },
    set(this: ByProto, value: number) {
      log.push(`set ${value} on ${this.id}`);
    },
    configurable: true,
  });
  return `${before} ${object.cache}`;
}
