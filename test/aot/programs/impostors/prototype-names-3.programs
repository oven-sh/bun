////= lines-14	dropX	shape	Shape	delete	shape.x
const interpreted = new Function("o", JSON.parse('["return"," o",".x"]').join("")) as (object: object) => unknown;
const ways: [string, (object: any) => unknown][] = [
  ["by name", object => object.x],
  ["by key", object => object[["x"][0]]],
  ["in", object => "x" in object],
  ["hasOwn", object => Object.hasOwn(object, "x")],
  ["hasOwnProperty", object => object.hasOwnProperty("x")],
  ["keys", object => Object.keys(object).join("")],
  ["for-in", object => { let names = ""; for (const name in object) names += name; return names; }],
  ["json", object => JSON.stringify(object)],
  ["spread", object => JSON.stringify({ ...object })],
  ["a pattern", ({ x = "default" }) => x],
  ["a descriptor", object => JSON.stringify(Object.getOwnPropertyDescriptor(object, "x"))],
  ["Reflect.get", object => Reflect.get(object, "x")],
  ["entries", object => String(Object.entries(object))],
  ["interpreted", object => interpreted(object)],
];
function look(object: object) {
  return ways.map(([label, way]) => `${label} ${String(way(object))}`).join("; ");
}
const makers: [string, (id: number) => Shape][] = [
  ["a literal", id => { const made: Shape = { id }; handOver(made); return made; }],
  ["a class field that was deleted", id => new Boxed(id)],
  ["a field that is only declared", id => new Late(id)],
];
for (const [label, make] of makers) {
  const kept = make(1);
  let length = 0;
  for (let i = 0; i < 3000; i++) {
    const [, way] = ways[i % ways.length];
    length += String(way(kept)).length + String(way(make(i & 7))).length;
  }
  console.log(label, "| warm", length);
  console.log(label, "| absent:", look(kept));
  setX(kept, 5);
  console.log(label, "| stored:", look(kept));
  setX(kept, 6);
  console.log(label, "| stored again:", look(kept));
  dropX(kept);
  console.log(label, "| deleted:", look(kept));
  kept.y = "why";
  setX(kept, 7);
  console.log(label, "| stored behind another field:", look(kept));
  console.log(label, "| a fresh one:", look(make(2)));
}
//// prototype-names/untyped-loops-read-late-properties-while-callbacks-change-the-prototype.js
// Untyped JavaScript, strict. Loops over instances of a class, of a derived class and of a constructor function read and fill a property that is added late.
// A callback that the loop calls puts the name on a prototype in the middle: as a value, as a getter, as a setter, on the class itself and on its base.
const log = [];
////= lines-121	Shape	id
class Circle extends Shape {
  constructor(id) {
    super(id);
    this.radius = id & 3;
  }
}
////= lines-35	Box	id	this.id	id
function sumAreas(list, visit) {
  let sum = 0;
  for (let i = 0; i < list.length; i++) {
    const shape = list[i];
    const before = shape.area;
    visit(i, shape);
    const after = shape.area;
    sum += (before === undefined ? 1 : before) + (after === undefined ? 1 : after);
  }
  return sum;
}
function fillAreas(list, visit) {
  let filled = 0;
  for (let i = 0; i < list.length; i++) {
    const shape = list[i];
    visit(i, shape);
    shape.area = i & 7;
    if (Object.hasOwn(shape, "area")) filled++;
  }
  return filled;
}
function listOf(make) {
  const list = [];
  for (let i = 0; i < 3000; i++) list.push(make(i));
  return list;
}
const nothing = () => {};
const cases = [
  ["a class, a value", id => new Shape(id), Shape.prototype, { value: 10, writable: true, configurable: true }],
  ["a derived class, a getter on the base", id => new Circle(id), Shape.prototype, { get() { return this.id & 1; }, configurable: true }],
  ["a derived class, a setter on itself", id => new Circle(id), Circle.prototype, { set(value) { if (log.length < 3) log.push("area = " + value); }, configurable: true }],
  ["a constructor function, a read-only value", id => new Box(id), Box.prototype, { value: 20, writable: false, configurable: true }],
];
for (const [label, make, holder, descriptor] of cases) {
  const name = ["ar", "ea"].join("");
  const change = (i, shape) => {
    if (i === 1500) Object.defineProperty(Object.getPrototypeOf(shape) === holder ? Object.getPrototypeOf(shape) : holder, name, descriptor);
  };
  const quiet = sumAreas(listOf(make), nothing);
  const read = sumAreas(listOf(make), change);
  const afterwards = sumAreas(listOf(make), nothing);
  delete holder[name];
  const filledQuietly = fillAreas(listOf(make), nothing);
  let filled;
  try {
    filled = fillAreas(listOf(make), change);
  } catch (error) {
    filled = error.constructor.name;
  }
  delete holder[name];
  console.log(`${label}: ${quiet} ${read} ${afterwards} | ${filledQuietly} ${filled} | ${sumAreas(listOf(make), nothing)} ${log.join(", ")}`);
  log.length = 0;
}
