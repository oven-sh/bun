////: install
function install() {
  Object.defineProperties(Cell.prototype, {
    width: {
      get(this: Cell) {
        log.push("get width " + this.row);
        return widths.get(this) ?? -1;
      },
      set(this: Cell, value: number) {
        log.push(`set width ${value} ${this.row}`);
        widths.set(this, value);
      },
      configurable: true,
      enumerable: true,
    },
    note: {
      get(this: Cell) {
        return "note of " + this.row;
      },
      set(this: Cell, value: string) {
        log.push(`set note ${value} ${this.row}`);
      },
      configurable: true,
    },
  });
}
////: keysAfterStores
function keysAfterStores(x: number) {
  const vec = new Vec();
  vec.x = x;
  vec.z = x;
  let count = 0;
  for (const _ in vec) count++;
  return count;
}
////: lengthSquared
function lengthSquared(x: number, y: number) {
  const vec = new Vec();
  vec.x = x;
  vec.y = y;
  return vec.x * vec.x + vec.y * vec.y + (vec.z ?? 0);
}
