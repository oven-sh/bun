////= handOver
interface Meter {
  id: number;
  reading?: number;
  offset?: number;
}
////= lines-70	makeMeter	id	number	Meter
////= Sample
////= lines-14	readingOf	meter	Meter	return	meter.reading
////= lines-16	setReading	meter	Meter	value	number	meter.reading
