////: show-19
function show(card: Card) {
  const names: string[] = [];
  for (const name in card) names.push(name);
  return `${Object.keys(card)} ${names.join() === Object.keys(card).join()} ${JSON.stringify(card)} ${card.rank} ${"rank" in card}`;
}
////: state-3
function state(object: Plain) {
  return `${object.mode} ${object.level} ${"mode" in object} ${Object.hasOwn(object, "mode")} [${Object.keys(object)}] ${JSON.stringify(object)}`;
}
////: states
const states: [string, (thing: any) => void][] = [
  ["as born", () => {}],
  ["one extra property", thing => (thing.extra = 1)],
  ["a hundred extra properties", thing => { for (let i = 0; i < 100; i++) thing["p" + i] = i; }],
  ["indexed properties", thing => { thing[0] = "a"; thing[5] = "b"; }],
  ["a symbol property", thing => (thing[Symbol.for("s")] = 1)],
  ["a deleted field", thing => delete thing.size],
  ["a value of another kind", thing => (thing.size = "large")],
  ["a hidden field", thing => Object.defineProperty(thing, "size", { enumerable: false })],
  ["an own accessor for another field", thing => Object.defineProperty(thing, "size", { get: () => 2, configurable: true })],
  ["frozen", thing => Object.freeze(thing)],
  ["sealed", thing => Object.seal(thing)],
  ["not extensible", thing => Object.preventExtensions(thing)],
  ["a prototype of something", thing => Object.create(thing)],
  ["away from its prototype and back", thing => { Object.setPrototypeOf(thing, {}); Object.setPrototypeOf(thing, Thing.prototype); }],
];
////: strictly
function strictly(config: Config) {
  try {
    config.strictStore("strict");
    return "stored";
  } catch (error) {
    return (error as Error).constructor.name;
  }
}
////: survey
function survey(part: Part) {
  const { id, ...rest } = part;
  const { a = "no a", b = "no b", c = "no c" } = part as any;
  return [
    "keys " + Object.keys(part),
    "entries " + JSON.stringify(Object.entries(part)),
    "for-in " + forIn(part),
    "own for-in " + ownForIn(part),
    "json " + JSON.stringify(part),
    "spread " + JSON.stringify({ ...part }),
    "assign " + JSON.stringify(Object.assign({}, part)),
    "rest " + JSON.stringify(rest) + id,
    "defaults " + [a, b, c],
    "clone " + JSON.stringify(structuredClone(part)),
    "names " + Object.getOwnPropertyNames(part),
    "own " + [part.hasOwnProperty("a"), part.hasOwnProperty("b"), part.hasOwnProperty("c")],
    "enumerable " + [part.propertyIsEnumerable("a"), part.propertyIsEnumerable("b"), part.propertyIsEnumerable("c")],
    "in " + ["a" in part, "b" in part, "c" in part],
    "values " + [part.a, part.b, part.c],
  ].join("; ");
}
////: walk
function walk(rows: Row[], changeAt: number) {
  let sum = 0;
  const around: string[] = [];
  rows.forEach((row, index) => {
    const before = row.rank;
    sum += before ?? 1;
    if (index === changeAt) {
      holderOf(row)["ra" + "nk".slice(0)] = 50;
      around.push(`${before} ${row.rank}`);
    }
    sum += row.rank ?? 1;
  });
  return `${sum} ${around.join()}`;
}
