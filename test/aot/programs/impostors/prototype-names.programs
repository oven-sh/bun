const holder: any = Reflect.getPrototypeOf(new Counter(0));
round("nothing inherited");
holder.n = 40;
round("40 inherited");
holder.n = 0;
round("0 inherited");
holder.n = undefined;
round("undefined inherited");
////= Object-defineProperty-2
round("accessors inherited");
delete holder.n;
round("nothing inherited again");
