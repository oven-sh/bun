////= setSample
function text(value: number | undefined) {
  return Object.is(value, -0) ? "-0" : String(value);
}

let sum = 0;
for (let i = 0; i < 3000; i++) {
  const meter = makeMeter(i);
  sum += readingOf(meter) ?? 1;
  setReading(meter, i & 255);
  meter.offset = 3;
  sum += addOne(meter)! + setSample({ id: i }, i & 7)!;
}
