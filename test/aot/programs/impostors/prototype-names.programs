  shape.x = 9;
  return `${show(before)} ${show(shape.x)}`;
}
////: prepare
function prepare(base: number) {
  return states.map(([, change], index) => {
    const thing = new Thing(base + index);
    change(thing);
    return thing;
  });
}
////: probe
function probe(thing: Thing) {
  const read = linkOf(thing);
  const has = "link" in thing;
  let stored: string;
  try {
    setLink(thing, 8);
    stored = "stored";
  } catch (error) {
    stored = (error as Error).constructor.name;
  }
  const calls = log.length;
  log.length = 0;
  return `${read} ${has} ${stored} ${calls} ${linkOf(thing)} ${Object.hasOwn(thing, "link")}`;
}
////: readDefineRead
function readDefineRead(entry: Entry, holder: object, name: string) {
  const before = entry.size;
  Object.defineProperty(holder, name, {
    get(this: Entry) {
      log.push("get on " + this.id);
      return this.id * 100;
    },
    configurable: true,
  });
  return `${before} ${entry.size}`;
}
////: readOnly
function readOnly(shape: Shape) {
  const before = shape.x;
  Object.defineProperty(shape, "x", { value: 42, writable: false, configurable: true });
  let outcome = "stored";
  try {
    shape.x = 1;
  } catch (error) {
    outcome = (error as Error).constructor.name;
  }
  return `${show(before)} ${show(shape.x)} ${outcome}`;
}
////: reflected
function reflected(shape: Shape) {
  const before = shape.x;
  const set = Reflect.set(shape, "x", 4);
  const stored = shape.x;
  const removed = Reflect.deleteProperty(shape, "x");
  const gone = shape.x;
  const defined = Reflect.defineProperty(shape, "x", { value: 5, writable: true, enumerable: false, configurable: true });
  return `${show(before)} ${set} ${show(stored)} ${removed} ${show(gone)} ${defined} ${show(shape.x)} [${Object.keys(shape)}]`;
}
////: relinked
function relinked(shape: Shape, above: object | null) {
  const before = shape.x;
  Object.setPrototypeOf(shape, above);
  return `${show(before)} ${show(shape.x)} ${"x" in shape}`;
}
////: report-9
function report(title: string, things: «1»[]) {
  console.log(title);
  things.forEach((thing, index) => console.log("  " + states[index][0] + ": " + probe(thing)));
}
////: round-2
function round(title: string) {
  const parts: string[] = [];
  for (const [name, run] of forms) {
    const counter = new Counter(1);
    const result = run(counter);
    parts.push(`${name}: ${result} ${counter.n} ${Object.hasOwn(counter, "n")}`);
  }
  const a = new Counter(2);
  const b = new Counter(3);
  const c = new Counter(4);
  parts.push(`typed: ${add(a)} ${bump(b)} ${b.n} ${orFive(c)} [${Object.keys(a)}] [${Object.keys(b)}] [${Object.keys(c)}]`);
  console.log(title + " -> " + parts.join("; ") + (log.length ? " | " + log.join(", ") : ""));
  log.length = 0;
}
