////: makers-13
const makers: ((id: number) => Links)[] = [
  id => new Links(id),
  id => {
    const links: Links = Object.create(Links.prototype);
    links.id = id;
    return links;
  },
  id => ({ __proto__: Links.prototype, id }) as unknown as Links,
  id => Object.setPrototypeOf({ id }, Links.prototype),
  id => Object.assign(Reflect.construct(Object, [], Links), { id }),
  id => Object.assign(Object.create(Links.prototype), new Links(id)),
];
////: orDefault
function orDefault(config: Config) {
  return (config.level ??= 5);
}
////: order
function order(items: Item[], changeAt: number) {
  let comparisons = 0;
  const sorted = items.slice().sort((a, b) => {
    if (++comparisons === changeAt) {
      Object.defineProperty(holderOf(a), "weight", {
        get(this: Item) {
          return -this.id;
        },
        configurable: true,
      });
    }
    return (a.weight ?? a.id) - (b.weight ?? b.id);
  });
  return sorted.map(item => item.id).join();
}
////: ownForIn
function ownForIn(part: «1») {
  const names: string[] = [];
  for (const name in part) if (Object.prototype.hasOwnProperty.call(part, name)) names.push(name);
  return names.join();
}
