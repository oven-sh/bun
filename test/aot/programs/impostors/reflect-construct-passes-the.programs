//// servers-and-scripts/a-bun-server-routes-by-path-and-method.js
const notes = new Map();
let nextId = 1;

const server = Bun.serve({
  hostname: "127.0.0.1",
  port: 0,
  async fetch(request) {
    const url = new URL(request.url);
    const match = /^\/notes\/(\d+)$/.exec(url.pathname);
    if (url.pathname === "/notes" && request.method === "POST") {
      const body = await request.json().catch(() => null);
      if (!body || typeof body.text !== "string") return Response.json({ error: "text is missing" }, { status: 422 });
      const note = { id: nextId++, text: body.text, tags: body.tags ?? [] };
      notes.set(note.id, note);
      return Response.json(note, { status: 201, headers: { location: "/notes/" + note.id } });
    }
    if (url.pathname === "/notes" && request.method === "GET") {
      const tag = url.searchParams.get("tag");
      return Response.json([...notes.values()].filter(note => !tag || note.tags.includes(tag)));
    }
    if (match && request.method === "GET") {
      const note = notes.get(Number(match[1]));
      return note ? Response.json(note) : new Response("no such note", { status: 404 });
    }
    if (match && request.method === "DELETE") return new Response(null, { status: notes.delete(Number(match[1])) ? 204 : 404 });
    return new Response("method or path not known", { status: 405, headers: { allow: "GET, POST, DELETE" } });
  },
  error(error) {
    return new Response("failed: " + error.message, { status: 500 });
  },
});

const send = (path, method = "GET", body) => fetch(server.url + path.slice(1), { method, body: body === undefined ? undefined : JSON.stringify(body) });
const created = await send("/notes", "POST", { text: "first", tags: ["a", "b"] });
console.log(created.status, created.headers.get("location"), await created.json());
console.log((await send("/notes", "POST", { text: "second" })).status);
console.log((await send("/notes", "POST", { text: 5 })).status, (await send("/notes", "POST")).status);
console.log(await (await send("/notes?tag=b")).json());
console.log(await (await send("/notes/2")).json(), (await send("/notes/9")).status);
console.log((await send("/notes/1", "DELETE")).status, (await send("/notes/1", "DELETE")).status);
const refused = await send("/notes", "PATCH");
console.log(refused.status, refused.headers.get("allow"), await refused.text());
await server.stop(true);
console.log("stopped", notes.size);
//// servers-and-scripts/a-bun-server-tells-addresses-cookies-and-reloads.js
const server = Bun.serve({
  hostname: "127.0.0.1",
  port: 0,
  idleTimeout: 5,
  development: false,
  routes: {
    "/cookies": request => {
      const seen = request.cookies.get("visits");
      request.cookies.set("visits", String(Number(seen ?? 0) + 1), { path: "/", httpOnly: true });
      request.cookies.delete("old");
      return Response.json({ seen, names: [...request.cookies.keys()].sort() });
    },
    "/redirect": Response.redirect("/cookies", 303),
  },
  fetch(request, server) {
    const address = server.requestIP(request);
    server.timeout(request, 10);
    return Response.json({ address: address.address, family: address.family, port: address.port > 0, pending: server.pendingRequests, url: request.url.replace(/:\d+/, ":PORT") });
  },
});
console.log(server.hostname, typeof server.port, server.url.protocol, server.development, typeof server.id, server.pendingRequests, server.pendingWebSockets);
console.log(await (await fetch(server.url + "who?x=1")).json());
const cookies = await fetch(server.url + "cookies", { headers: { cookie: "visits=4; old=1; other=x" } });
console.log(await cookies.json(), cookies.headers.getSetCookie());
console.log((await fetch(server.url + "redirect", { redirect: "manual" })).status);
server.reload({ routes: {}, fetch: () => new Response("reloaded") });
console.log(await (await fetch(server.url + "cookies")).text());
server.unref();
server.ref();
await server.stop();
console.log(await fetch(server.url).catch(error => error.code));
//// servers-and-scripts/a-bun-server-with-a-table-of-routes.js
const server = Bun.serve({
  hostname: "127.0.0.1",
  port: 0,
  routes: {
    "/health": new Response("ok"),
    "/users/:id": request => Response.json({ id: request.params.id, verbose: new URL(request.url).searchParams.has("verbose") }),
    "/items": {
      GET: () => Response.json(["one", "two"]),
      POST: async request => Response.json({ received: await request.text() }, { status: 201 }),
    },
    "/files/*": request => new Response("file " + new URL(request.url).pathname.slice("/files/".length)),
    "/fails": () => {
      throw new TypeError("on purpose");
    },
  },
  fetch() {
    return new Response("fallback", { status: 404 });
  },
  error(error) {
    return new Response(error.name + ": " + error.message, { status: 500 });
  },
});

async function show(path, init) {
  const response = await fetch(new URL(path, server.url), init);
  console.log(path, response.status, await response.text());
}
await show("/health");
await show("/users/42?verbose");
await show("/users/a%20b");
await show("/items");
await show("/items", { method: "POST", body: "three" });
await show("/items", { method: "DELETE" });
await show("/files/a/b/c.txt");
await show("/fails");
await show("/unknown");
server.stop(true);
//// servers-and-scripts/a-closure-in-a-literal-is-called-after-an-await-inside-an-async-context.js
import { AsyncLocalStorage } from "node:async_hooks";

const storage = new AsyncLocalStorage();

async function handle({ getRouter, request, executeRouter, context, executed, signal, event }) {
  const router = await getRouter();
  if (signal.aborted || executed || !event) throw new Error("stopped");
  return executeRouter(context, router, request);
}

async function resolveRequest(request, options, event) {
  const signal = { aborted: false };
  let routerPromise;
  let executed;
  const getRouter = () => {
    routerPromise ??= (async () => {
      if (signal.aborted) throw new Error("aborted");
      return { request, options, event };
    })();
    return routerPromise;
  };
  const start = { getRouter, request, executed };
  const executeRouter = async (context, matched, instance) => {
    if (signal.aborted) throw new Error("aborted");
    return request.id + (options.extra ?? 0) + matched.request.id + instance.id + context.weight;
  };
  const terminal = ({ context }) =>
    storage.run({ ...start, after: context }, () => handle({ getRouter, request, executeRouter, context, executed, signal, event }));
  return await terminal({ context: { weight: 1 } });
}

const rounds = Number(process.env.ROUNDS ?? 2000);
let total = 0;
for (let round = 0; round < rounds; round++) {
  const batch = [];
  for (let i = 0; i < 16; i++) batch.push(resolveRequest({ id: i, text: "request " + round }, {}, { round }));
  for (const value of await Promise.all(batch)) total += value;
}
console.log(total);
//// servers-and-scripts/a-file-is-copied-through-streams.js
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { Transform } from "node:stream";
import { pipeline } from "node:stream/promises";

const folder = fs.mkdtempSync(path.join(os.tmpdir(), "copy-"));
const source = path.join(folder, "source.txt");
const target = path.join(folder, "target.txt");
fs.writeFileSync(source, Array.from({ length: 5000 }, (_, index) => "row " + index).join("\n"));

let chunks = 0;
let bytes = 0;
const upper = new Transform({
  transform(chunk, encoding, done) {
    chunks++;
    bytes += chunk.length;
    done(null, chunk.toString().toUpperCase());
  },
  flush(done) {
    this.push("\nEND");
    done();
  },
});

await pipeline(fs.createReadStream(source, { highWaterMark: 4096 }), upper, fs.createWriteStream(target));
const copied = fs.readFileSync(target, "utf8");
console.log(chunks, bytes, copied.length, copied.slice(0, 11), copied.slice(-12));

try {
  await pipeline(fs.createReadStream(path.join(folder, "missing.txt")), fs.createWriteStream(target));
} catch (error) {
  console.log("pipeline failed:", error.code);
}

const part = fs.createReadStream(source, { start: 4, end: 12, encoding: "utf8" });
let text = "";
for await (const piece of part) text += piece;
console.log(JSON.stringify(text));
fs.rmSync(folder, { recursive: true });
//// servers-and-scripts/a-file-is-read-through-a-stream.js
import fs from "node:fs";
import os from "node:os";
import path from "node:path";

const folder = fs.mkdtempSync(path.join(os.tmpdir(), "read-"));
const file = path.join(folder, "text.txt");
fs.writeFileSync(file, "some text");
let text = "";
for await (const chunk of fs.createReadStream(file, { encoding: "utf8", highWaterMark: 4 })) text += chunk + "|";
console.log(text);
fs.rmSync(folder, { recursive: true });
//// servers-and-scripts/a-file-is-written-read-listed-and-removed.js
import fs from "node:fs";
import { mkdtemp, readFile, writeFile, appendFile, readdir, stat, rename, rm, access } from "node:fs/promises";
import os from "node:os";
import path from "node:path";

const folder = await mkdtemp(path.join(os.tmpdir(), "notes-"));
const first = path.join(folder, "first.txt");
await writeFile(first, "line one\n");
await appendFile(first, "line two\n", "utf8");
console.log(JSON.stringify(await readFile(first, "utf8")), (await readFile(first)).length);
const info = await stat(first);
console.log(info.isFile(), info.isDirectory(), info.size, info.mtime instanceof Date, typeof info.mtimeMs);

fs.mkdirSync(path.join(folder, "deep", "deeper"), { recursive: true });
fs.writeFileSync(path.join(folder, "deep", "data.json"), JSON.stringify({ a: [1, 2], b: null }));
console.log(JSON.parse(fs.readFileSync(path.join(folder, "deep", "data.json"), "utf8")));
console.log((await readdir(folder)).sort(), fs.readdirSync(folder, { withFileTypes: true }).map(entry => entry.name + ":" + entry.isDirectory()).sort());
console.log(fs.readdirSync(folder, { recursive: true }).sort());

await rename(first, path.join(folder, "renamed.txt"));
console.log(fs.existsSync(first), fs.existsSync(path.join(folder, "renamed.txt")));
try {
  await access(first);
} catch (error) {
  console.log(error.code, error.syscall, error instanceof Error);
}
try {
  fs.readFileSync(path.join(folder, "missing.txt"));
} catch (error) {
  console.log(error.code, error.errno < 0, error.path === path.join(folder, "missing.txt"));
}
const descriptor = fs.openSync(path.join(folder, "renamed.txt"), "r");
const bytes = Buffer.alloc(8);
console.log(fs.readSync(descriptor, bytes, 0, 8, 5), bytes.toString());
fs.closeSync(descriptor);
fs.copyFileSync(path.join(folder, "renamed.txt"), path.join(folder, "copy.txt"));
fs.truncateSync(path.join(folder, "copy.txt"), 4);
console.log(fs.readFileSync(path.join(folder, "copy.txt"), "latin1"), fs.statSync(path.join(folder, "copy.txt")).size);
await rm(folder, { recursive: true, force: true });
console.log(fs.existsSync(folder));
//// servers-and-scripts/a-file-is-written-through-a-stream.js
import fs from "node:fs";
import os from "node:os";
import path from "node:path";

const folder = fs.mkdtempSync(path.join(os.tmpdir(), "write-"));
const file = path.join(folder, "text.txt");
const stream = fs.createWriteStream(file);
stream.write("first ");
stream.end("second", () => {
  console.log(fs.readFileSync(file, "utf8"), stream.bytesWritten);
  fs.rmSync(folder, { recursive: true });
});
