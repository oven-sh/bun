const first = makeCounters(1);
console.log("first", first.total());
const second = makeCounters(2);
first.bump();
console.log("second", second.total(), "first again", first.total());
//// servers-and-scripts/a-log-file-is-parsed-grouped-and-reported.js
import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

const folder = mkdtempSync(join(tmpdir(), "logs-"));
const file = join(folder, "access.log");
const paths = ["/", "/about", "/api/users", "/api/orders", "/static/app.js"];
const rows = [];
for (let i = 0; i < 400; i++) {
  const status = i % 37 === 0 ? 500 : i % 11 === 0 ? 404 : 200;
  rows.push(JSON.stringify({ time: new Date(Date.UTC(2026, 0, 1, 0, 0, i * 7)).toISOString(), method: i % 5 === 3 ? "POST" : "GET", path: paths[i % paths.length], status, ms: (i * 13) % 250 + 0.5, bytes: status === 200 ? 100 + i : undefined }));
}
rows.splice(50, 0, "this line is not json", "", '{"time": "broken"');
writeFileSync(file, rows.join("\n") + "\n");

const byPath = new Map();
let skipped = 0;
for (const line of readFileSync(file, "utf8").split("\n")) {
  if (!line) continue;
  let entry;
  try {
    entry = JSON.parse(line);
  } catch {
    skipped++;
    continue;
  }
  let group = byPath.get(entry.path);
  if (!group) byPath.set(entry.path, (group = { path: entry.path, hits: 0, errors: 0, ms: 0, slowest: 0, bytes: 0, methods: new Set(), first: entry.time, last: entry.time }));
  group.hits++;
  if (entry.status >= 500) group.errors++;
  group.ms += entry.ms;
  group.slowest = Math.max(group.slowest, entry.ms);
  group.bytes += entry.bytes ?? 0;
  group.methods.add(entry.method);
  if (entry.time > group.last) group.last = entry.time;
}
const report = [...byPath.values()].sort((a, b) => a.path.localeCompare(b.path)).map(group => ({ ...group, methods: [...group.methods].join("+"), mean: (group.ms / group.hits).toFixed(2), share: ((100 * group.hits) / 400).toFixed(1) + "%" }));
for (const line of report) console.log(line.path.padEnd(16), String(line.hits).padStart(4), String(line.errors).padStart(2), line.mean.padStart(8), String(line.slowest).padStart(6), line.bytes.toLocaleString("en-US").padStart(8), line.methods, line.share, line.last.slice(11, 19));
console.log("skipped", skipped, "total", report.reduce((sum, line) => sum + line.hits, 0), Object.groupBy(report, line => (line.errors ? "failing" : "healthy")).failing?.length);
const hours = new Intl.DateTimeFormat("en-GB", { timeZone: "UTC", hour: "2-digit", minute: "2-digit" }).format(new Date(report[0].last));
console.log(hours, new Intl.NumberFormat("de-DE", { maximumFractionDigits: 1 }).format(12345.678), new Intl.PluralRules("en").select(1), new Intl.ListFormat("en").format(["a", "b", "c"]), new Intl.RelativeTimeFormat("en").format(-2, "day"));
rmSync(folder, { recursive: true });
//// servers-and-scripts/a-mark-is-set-on-the-performance-timeline.js
performance.mark("start");
console.log(performance.getEntriesByName("start").length, performance.mark === Performance.prototype.mark, Object.getOwnPropertyNames(performance));
//// servers-and-scripts/a-node-http-client-asks-a-node-http-server.js
import http from "node:http";

const server = http.createServer((request, response) => {
  let size = 0;
  request.setEncoding("utf8");
  request.on("data", text => (size += text.length));
  request.on("end", () => {
    response.writeHead(request.url === "/teapot" ? 418 : 200, { "content-type": "text/plain", "x-method": request.method });
    response.write("got " + size + " characters");
    response.end(" on " + request.url);
  });
});

function ask(options, body) {
  return new Promise((resolve, reject) => {
    const request = http.request({ host: "127.0.0.1", port: server.address().port, agent: false, ...options }, response => {
      const parts = [];
      response.on("data", part => parts.push(part));
      response.on("end", () => resolve({ status: response.statusCode, message: response.statusMessage, method: response.headers["x-method"], text: Buffer.concat(parts).toString() }));
    });
    request.on("error", reject);
    if (body !== undefined) request.write(body);
    request.end();
  });
}

server.listen(0, "127.0.0.1", async () => {
  console.log(await ask({ path: "/first" }));
  console.log(await ask({ path: "/second", method: "PUT", headers: { "content-type": "text/plain" } }, "twelve chars"));
  console.log(await ask({ path: "/teapot", method: "POST" }, Buffer.from("abc")));
  http.get({ host: "127.0.0.1", port: server.address().port, path: "/get", agent: false }, response => {
    response.resume();
    response.on("end", () => {
      console.log("get", response.statusCode, response.httpVersion, typeof response.headers.date);
      server.close();
    });
  });
});
//// servers-and-scripts/a-node-http-server-answers-a-get-and-a-post.js
import http from "node:http";

const server = http.createServer((request, response) => {
  const url = new URL(request.url, "http://localhost");
  if (request.method === "GET" && url.pathname === "/hello") {
    response.writeHead(200, { "Content-Type": "text/plain", "X-Name": url.searchParams.get("name") ?? "nobody" });
    response.end("hello " + (url.searchParams.get("name") ?? "nobody"));
    return;
  }
  if (request.method === "POST" && url.pathname === "/sum") {
    const chunks = [];
    request.on("data", chunk => chunks.push(chunk));
    request.on("end", () => {
      let numbers;
      try {
        numbers = JSON.parse(Buffer.concat(chunks).toString("utf8"));
      } catch {
        response.statusCode = 400;
        response.end("bad json");
        return;
      }
      response.setHeader("Content-Type", "application/json");
      response.end(JSON.stringify({ sum: numbers.reduce((total, n) => total + n, 0), type: request.headers["content-type"] }));
    });
    return;
  }
  response.statusCode = 404;
  response.end("not found: " + request.method + " " + url.pathname);
});

server.listen(0, "127.0.0.1", async () => {
  const base = "http://127.0.0.1:" + server.address().port;
  const hello = await fetch(base + "/hello?name=Ada");
  console.log(hello.status, hello.headers.get("content-type"), hello.headers.get("x-name"), await hello.text());
  const sum = await fetch(base + "/sum", { method: "POST", headers: { "content-type": "application/json" }, body: "[1, 2, 3.5]" });
  console.log(sum.status, await sum.json());
  const bad = await fetch(base + "/sum", { method: "POST", body: "[1," });
  console.log(bad.status, await bad.text());
  const missing = await fetch(base + "/nothing", { method: "DELETE" });
  console.log(missing.status, await missing.text());
  server.close(() => console.log("closed"));
});
//// servers-and-scripts/a-node-http-server-sets-reads-and-removes-headers.js
import http from "node:http";

const server = http.createServer((request, response) => {
  response.setHeader("Set-Cookie", ["a=1; Path=/", "b=2"]);
  response.setHeader("X-Number", 5);
  response.setHeader("X-Gone", "soon");
  response.appendHeader?.("X-List", "one");
  response.appendHeader?.("X-List", "two");
  response.removeHeader("x-gone");
  const seen = {
    has: [response.hasHeader("X-NUMBER"), response.hasHeader("x-gone")],
    number: response.getHeader("x-number"),
    names: response.getHeaderNames(),
    cookie: response.getHeaders()["set-cookie"],
    method: request.method,
    url: request.url,
    version: request.httpVersion + " " + request.httpVersionMajor,
    raw: request.rawHeaders.filter((_, index) => index % 2 === 0).map(name => name.toLowerCase()).filter(name => name.startsWith("x-")),
    twice: request.headers["x-twice"],
    distinct: request.headersDistinct?.["x-twice"],
    cookie2: request.headers.cookie,
    host: typeof request.headers.host,
    remote: request.socket.remoteAddress,
    complete: request.complete,
    sent: response.headersSent,
  };
  response.writeHead(201, "Made", { "Content-Type": "application/json", "X-Late": ["p", "q"] });
  try {
    response.setHeader("x-too-late", "1");
  } catch (error) {
    seen.late = error.code;
  }
  response.end(JSON.stringify(seen));
});

server.keepAliveTimeout = 1000;
server.listen(0, "127.0.0.1", async () => {
  const headers = new Headers({ "x-one": "1", cookie: "s=1; t=2" });
  headers.append("x-twice", "a");
  headers.append("x-twice", "b");
  const answer = await fetch("http://127.0.0.1:" + server.address().port + "/path?q=1", { method: "PATCH", headers, body: "x" });
  console.log(answer.status, answer.statusText, answer.headers.getSetCookie(), answer.headers.get("x-number"), answer.headers.get("x-list"), answer.headers.get("x-late"), answer.headers.has("x-gone"));
  console.log(await answer.json());
  console.log(http.STATUS_CODES[404], http.STATUS_CODES[999], http.METHODS.includes("PATCH"), http.METHODS.length > 20, typeof http.globalAgent.maxSockets, http.maxHeaderSize, server.listening, server.timeout, server.requestTimeout);
  try {
    http.validateHeaderName("bad name");
  } catch (error) {
    console.log(error.code);
  }
  try {
    http.validateHeaderValue("x", "bad\nvalue");
  } catch (error) {
    console.log(error.code);
  }
  server.closeAllConnections();
  server.close(error => console.log("closed", error));
});
//// servers-and-scripts/a-require-made-by-create-require-loads-a-built-in-module.js
import { createRequire } from "node:module";

const require = createRequire(import.meta.url);
