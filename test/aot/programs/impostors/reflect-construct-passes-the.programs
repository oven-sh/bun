//// servers-and-scripts/duplex-streams-are-composed-and-destroyed.js
import { on } from "node:events";
import { Duplex, PassThrough, Readable, Transform, Writable, addAbortSignal, compose, finished, pipeline } from "node:stream";
import { finished as finishedPromise } from "node:stream/promises";
import { EventEmitter } from "node:events";

const written = [];
const duplex = new Duplex({
  read() {
    this.push(written.length ? "read after " + written.length : null);
    if (written.length) this.push(null);
  },
  write(chunk, encoding, done) {
    written.push(chunk.toString());
    done();
  },
});
duplex.write("a");
duplex.end("b");
let read = "";
for await (const piece of duplex) read += piece;
console.log(written, read, duplex.writableFinished, duplex.readableEnded);

const shout = new Transform({ transform: (chunk, encoding, done) => done(null, chunk.toString().toUpperCase()) });
const exclaim = new Transform({ transform: (chunk, encoding, done) => done(null, chunk + "!") });
console.log(await Readable.from(["a", "b"]).pipe(compose(shout, exclaim)).toArray().then(parts => parts.join("")));
console.log(await Readable.from([1, 2, 3, 4, 5]).filter(n => n % 2).map(n => n * 10).take(2).toArray(), await Readable.from([1, 2, 3]).reduce((sum, n) => sum + n, 0), await Readable.from(["x"]).some(v => v === "x"));

const broken = new Readable({ read() { this.destroy(new RangeError("source broke")); } });
console.log(await new Promise(resolve => pipeline(broken, new PassThrough(), new Writable({ write: (c, e, done) => done() }), error => resolve(error.message))));
const slow = new Writable({ highWaterMark: 2, write: (chunk, encoding, done) => setTimeout(done, 1) });
console.log(slow.write("abc"), slow.writableNeedDrain, slow.writableLength, await new Promise(resolve => slow.once("drain", () => resolve("drained"))), slow.writableHighWaterMark);
slow.end();
await finishedPromise(slow);
try {
  slow.write("late");
} catch (error) {
  console.log("threw", error.code);
}
slow.on("error", error => console.log("error event", error.code));
const controller = new AbortController();
const aborted = addAbortSignal(controller.signal, new Readable({ read() {} }));
finished(aborted, error => console.log("finished with", error.name, aborted.destroyed));
controller.abort();
await new Promise(resolve => setImmediate(resolve));
const web = Readable.toWeb(Readable.from(["to ", "web"]));
console.log(await new Response(web.pipeThrough(new TextEncoderStream())).text(), await Readable.fromWeb(new Blob(["from web"]).stream()).toArray().then(parts => Buffer.concat(parts).toString()));
const emitter = new EventEmitter();
setTimeout(() => { emitter.emit("tick", 1); emitter.emit("tick", 2); emitter.emit("end"); }, 1);
const ticks = [];
for await (const [value] of on(emitter, "tick", { close: ["end"] })) ticks.push(value);
console.log(ticks, Readable.prototype.isPaused.call(new Readable()), new PassThrough({ objectMode: true }).readableObjectMode, Duplex.from("text") instanceof Duplex);
//// servers-and-scripts/each-request-keeps-its-own-context.js
import { AsyncLocalStorage, AsyncResource, executionAsyncId } from "node:async_hooks";
import http from "node:http";

const context = new AsyncLocalStorage();
const lines = [];
const log = message => lines.push((context.getStore()?.id ?? "none") + ": " + message);

async function work(ms) {
  log("work starts");
  await new Promise(resolve => setTimeout(resolve, ms));
  log("after a timer");
  await Promise.all([Promise.resolve().then(() => log("in a reaction")), new Promise(resolve => setImmediate(() => resolve(log("in an immediate"))))]);
  process.nextTick(() => log("in a tick"));
  queueMicrotask(() => log("in a microtask"));
}

const server = http.createServer((request, response) => {
  context.run({ id: request.headers["x-id"] }, async () => {
    await work(Number(request.headers["x-wait"]));
    response.end(context.getStore().id);
  });
});

server.listen(0, "127.0.0.1", async () => {
  const ask = (id, wait) => fetch("http://127.0.0.1:" + server.address().port, { headers: { "x-id": id, "x-wait": String(wait) } }).then(answer => answer.text());
  console.log(await Promise.all([ask("a", 15), ask("b", 5), ask("c", 10)]));
  console.log(lines.filter(line => line.startsWith("a")), lines.filter(line => line.startsWith("b")).length, lines.filter(line => line.startsWith("none")).length);
  server.close();

  console.log(context.getStore(), context.run(1, () => context.run(2, () => context.getStore()) + context.getStore()), context.run("x", (a, b) => a + b + context.getStore(), "p", "q"));
  context.enterWith("entered");
  console.log(context.getStore(), context.exit(() => context.getStore()));
  const bound = context.run("bound", () => AsyncLocalStorage.bind(() => context.getStore()));
  const snapshot = context.run("snapshot", () => AsyncLocalStorage.snapshot());
  console.log(bound(), snapshot(() => context.getStore()), typeof executionAsyncId());
  const resource = context.run("resource", () => new AsyncResource("Job"));
  console.log(resource.runInAsyncScope((a, b) => context.getStore() + a + b, null, 1, 2));
  context.disable();
  console.log(context.getStore());
});
//// servers-and-scripts/errors-carry-causes-codes-and-stacks.js
import { inspect } from "node:util";

class HttpError extends Error {
  constructor(status, message, options) {
    super(message, options);
    this.name = "HttpError";
    this.status = status;
  }
  get isClientError() {
    return this.status >= 400 && this.status < 500;
  }
  toJSON() {
    return { name: this.name, status: this.status, message: this.message };
  }
}

function load(id) {
  try {
    if (id < 0) throw new RangeError("negative id");
    return JSON.parse(id === 0 ? "{" : '{"id":' + id + "}");
  } catch (cause) {
    throw new HttpError(id < 0 ? 400 : 500, "cannot load " + id, { cause });
  }
}

for (const id of [1, 0, -1]) {
  try {
    console.log(load(id));
  } catch (error) {
    console.log(error instanceof HttpError, error instanceof Error, error.name, error.status, error.isClientError, error.message, error.cause.name, JSON.stringify(error), String(error), Object.keys(error), Object.prototype.toString.call(error));
    console.log(typeof error.stack, error.stack.split("\n")[0], error.stack.includes("load"), "cause" in error, Object.getOwnPropertyDescriptor(error, "cause").enumerable, Object.getOwnPropertyDescriptor(error, "message").enumerable);
  }
}
const many = new AggregateError([new Error("one"), new TypeError("two")], "several");
console.log(many.errors.map(error => error.message), many.message, many.name, await Promise.any([Promise.reject(1), Promise.reject(2)]).catch(error => error.errors));
console.log(inspect(new HttpError(404, "missing")).split("\n")[0], inspect(new Error("plain", { cause: "text" })).includes("cause"), inspect(Object.assign(new Error("with code"), { code: "E_CODE" })).includes("E_CODE"));
const target = {};
Error.captureStackTrace(target, load);
console.log(typeof target.stack, Error.stackTraceLimit, typeof Error.prepareStackTrace, Error.isError?.(many), Error.isError?.({ message: "fake" }));
const original = Error.prepareStackTrace;
Error.prepareStackTrace = (error, sites) => sites.length > 0 && typeof sites[0].getFileName() + " " + typeof sites[0].getLineNumber() + " " + sites[0].getFunctionName();
console.log((function named() { return new Error("prepared").stack; })());
Error.prepareStackTrace = original;
console.log(new DOMException("gone", "NotFoundError").code, new DOMException("x", "AbortError") instanceof Error, structuredClone(new RangeError("cloned")).message, (() => { try { null.x; } catch (error) { return error.constructor === TypeError; } })(), (() => { try { undefinedName; } catch (error) { return error.name; } })());
const results = await Promise.allSettled([Promise.resolve(1), Promise.reject(new HttpError(418, "teapot")), new Promise((resolve, reject) => setTimeout(reject, 1, "late"))]);
console.log(results.map(result => result.status + ":" + (result.value ?? result.reason?.status ?? result.reason)));
function recurse(n) { return recurse(n + 1) + 1; }
try {
  recurse(0);
} catch (error) {
  console.log(error.name, error.message);
}
//// servers-and-scripts/fetch-reads-headers-statuses-and-bodies.js
const server = Bun.serve({
  hostname: "127.0.0.1",
  port: 0,
  async fetch(request) {
    const { pathname } = new URL(request.url);
    if (pathname === "/moved") return Response.redirect("/target", 302);
    if (pathname === "/target") return new Response("arrived");
    if (pathname === "/slow") return new Promise(resolve => setTimeout(() => resolve(new Response("late")), 2000));
    if (pathname === "/form") {
      const form = await request.formData();
      return Response.json({ name: form.get("name"), all: form.getAll("tag"), file: form.get("file")?.size ?? null });
    }
    if (pathname === "/echo") {
      const headers = new Headers({ "x-method": request.method, "x-type": request.headers.get("content-type") ?? "none" });
      headers.append("set-cookie", "a=1");
      headers.append("set-cookie", "b=2");
      return new Response(await request.arrayBuffer(), { status: 202, statusText: "Taken", headers });
    }
    return new Response(null, { status: 204 });
  },
});
const at = path => new URL(path, server.url).href;

const echoed = await fetch(at("/echo"), { method: "PUT", body: new Uint8Array([104, 105]), headers: [["Content-Type", "application/octet-stream"]] });
console.log(echoed.status, echoed.statusText, echoed.ok, echoed.headers.get("X-Method"), echoed.headers.get("x-type"), echoed.headers.getSetCookie(), new Uint8Array(await echoed.arrayBuffer()));
console.log(echoed.bodyUsed, await echoed.text().catch(error => error.name));
const followed = await fetch(at("/moved"));
console.log(followed.status, followed.redirected, new URL(followed.url).pathname, await followed.text());
const manual = await fetch(at("/moved"), { redirect: "manual" });
console.log(manual.status, manual.headers.get("location"));
const form = new FormData();
form.append("name", "Ada");
form.append("tag", "x");
form.append("tag", "y");
form.append("file", new Blob(["12345"], { type: "text/plain" }), "five.txt");
console.log(await (await fetch(at("/form"), { method: "POST", body: form })).json());
console.log(await (await fetch(at("/form"), { method: "POST", body: new URLSearchParams({ name: "Bob", tag: "z" }) })).json());
const empty = await fetch(at("/nothing"));
console.log(empty.status, JSON.stringify(await empty.text()), [...empty.headers.keys()].includes("content-type"));
const blob = await (await fetch(at("/target"))).blob();
console.log(blob.size, await blob.text());
const controller = new AbortController();
setTimeout(() => controller.abort(), 20);
console.log(await fetch(at("/slow"), { signal: controller.signal }).catch(error => error.name));
console.log(await fetch(at("/slow"), { signal: AbortSignal.timeout(20) }).catch(error => error.name));
console.log(await fetch("http://127.0.0.1:1/").catch(error => error.code ?? error.name));
server.stop(true);
//// servers-and-scripts/files-are-watched-linked-and-given-modes.js
import fs from "node:fs";
import fsp from "node:fs/promises";
import os from "node:os";
import path from "node:path";

const folder = fs.mkdtempSync(path.join(os.tmpdir(), "modes-"));
const file = path.join(folder, "file.txt");
fs.writeFileSync(file, "content", { mode: 0o640 });
console.log((fs.statSync(file).mode & 0o777).toString(8), fs.statSync(file, { bigint: true }).size, fs.lstatSync(file).isSymbolicLink());
fs.chmodSync(file, 0o600);
fs.utimesSync(file, 1000, 2000);
console.log((fs.statSync(file).mode & 0o777).toString(8), fs.statSync(file).mtimeMs, fs.statSync(file).atime.toISOString());
fs.symlinkSync(file, path.join(folder, "link"));
fs.linkSync(file, path.join(folder, "hard"));
console.log(fs.readlinkSync(path.join(folder, "link")) === file, fs.lstatSync(path.join(folder, "link")).isSymbolicLink(), fs.realpathSync(path.join(folder, "link")) === fs.realpathSync(file), fs.statSync(file).nlink);
console.log(fs.statSync(path.join(folder, "nothing"), { throwIfNoEntry: false }), fs.accessSync(file, fs.constants.R_OK), fs.constants.O_RDONLY, typeof fs.constants.S_IFMT);

const handle = await fsp.open(file, "r+");
console.log((await handle.read(Buffer.alloc(4), 0, 4, 0)).bytesRead, (await handle.write("CON", 0)).bytesWritten, (await handle.stat()).size, await handle.readFile("utf8"), typeof handle.fd);
await handle.truncate(3);
await handle.sync();
await handle.close();
console.log(fs.readFileSync(file, "utf8"), await handle.stat().catch(error => error.code));
fs.writeFileSync(file, "l1\nl2\nl3");
const lines = [];
const reading = await fsp.open(file);
for await (const line of reading.readLines()) lines.push(line);
console.log(lines);

const directory = fs.opendirSync(folder);
const names = [];
for (let entry = directory.readSync(); entry; entry = directory.readSync()) names.push(entry.name + (entry.isFile() ? " file" : entry.isSymbolicLink() ? " link" : " other"));
directory.closeSync();
console.log(names.sort());
fs.cpSync(folder, folder + "-copy", { recursive: true, dereference: true });
console.log(fs.readdirSync(folder + "-copy").sort(), fs.globSync?.("*.txt", { cwd: folder }));

const changes = Promise.withResolvers();
const watcher = fs.watch(folder, (event, name) => changes.resolve(typeof event + " " + typeof name));
await Bun.sleep(20);
fs.writeFileSync(path.join(folder, "new.txt"), "x");
