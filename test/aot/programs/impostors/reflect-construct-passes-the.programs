//// servers-and-scripts/a-static-file-server-with-ranges-and-types.js
import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { extname, join, normalize, sep } from "node:path";

const root = mkdtempSync(join(tmpdir(), "static-"));
mkdirSync(join(root, "css"));
writeFileSync(join(root, "index.html"), "<h1>home</h1>");
writeFileSync(join(root, "css", "site.css"), "body { margin: 0 }");
writeFileSync(join(root, "data.bin"), Buffer.from(Array.from({ length: 100 }, (_, i) => i)));
const types = { ".html": "text/html; charset=utf-8", ".css": "text/css" };

const server = Bun.serve({
  hostname: "127.0.0.1",
  port: 0,
  async fetch(request) {
    let pathname = decodeURIComponent(new URL(request.url).pathname);
    if (pathname.endsWith("/")) pathname += "index.html";
    const full = normalize(join(root, pathname));
    if (!full.startsWith(root + sep)) return new Response("forbidden", { status: 403 });
    const file = Bun.file(full);
    if (!(await file.exists())) return new Response("not found", { status: 404 });
    const headers = { "content-type": types[extname(full)] ?? "application/octet-stream", "accept-ranges": "bytes" };
    const range = /^bytes=(\d+)-(\d*)$/.exec(request.headers.get("range") ?? "");
    if (range) {
      const start = Number(range[1]);
      const end = range[2] ? Math.min(Number(range[2]), file.size - 1) : file.size - 1;
      if (start > end) return new Response(null, { status: 416, headers: { "content-range": "bytes */" + file.size } });
      return new Response(file.slice(start, end + 1), { status: 206, headers: { ...headers, "content-range": `bytes ${start}-${end}/${file.size}` } });
    }
    return new Response(request.method === "HEAD" ? null : file, { headers: { ...headers, "content-length": String(file.size) } });
  },
});

async function show(path, init) {
  const answer = await fetch(server.url.origin + path, init);
  const body = new Uint8Array(await answer.arrayBuffer());
  console.log(path, answer.status, answer.headers.get("content-type"), answer.headers.get("content-length"), answer.headers.get("content-range"), body.length, body.length < 20 ? new TextDecoder("latin1").decode(body).replace(/[^ -~]/g, ".") : "");
}
await show("/");
await show("/css/site.css");
await show("/css/missing.css");
await show("/data.bin");
await show("/data.bin", { headers: { range: "bytes=10-19" } });
await show("/data.bin", { headers: { range: "bytes=95-" } });
await show("/data.bin", { headers: { range: "bytes=200-300" } });
await show("/index.html", { method: "HEAD" });
await show("/%2e%2e/%2e%2e/etc/hostname");
server.stop(true);
rmSync(root, { recursive: true });
//// servers-and-scripts/a-tcp-server-echoes-lines.js
import net from "node:net";

const events = [];
const server = net.createServer(socket => {
  socket.setEncoding("utf8");
  let pending = "";
  socket.on("data", text => {
    pending += text;
    let end;
    while ((end = pending.indexOf("\n")) >= 0) {
      const line = pending.slice(0, end);
      pending = pending.slice(end + 1);
      if (line === "quit") socket.end("bye\n");
      else socket.write(line.split("").reverse().join("") + "\n");
    }
  });
  socket.on("end", () => events.push("server saw the end"));
  socket.on("close", hadError => events.push("server socket closed " + hadError));
});

server.on("listening", () => events.push("listening " + server.listening));
server.listen(0, "127.0.0.1", () => {
  const { port, family, address } = server.address();
  console.log(typeof port, family, address);
  const client = net.connect({ port, host: "127.0.0.1" });
  let received = "";
  client.on("connect", () => {
    console.log(client.remoteAddress, client.remotePort === port, client.remoteFamily, client.connecting, client.readyState);
    client.write("abc\nde");
    client.write("f\n");
    client.write(Buffer.from("quit\n"));
  });
  client.on("data", chunk => (received += chunk));
  client.on("close", () => {
    console.log(JSON.stringify(received), client.bytesWritten, client.bytesRead, client.destroyed);
    server.getConnections((error, count) => {
      console.log(error, count);
      server.close(() => {
        console.log(events.sort(), server.listening);
        net.connect(port, "127.0.0.1").on("error", error => console.log(error.code, error.syscall, net.isIP("127.0.0.1"), net.isIPv6("::1"), net.isIP("nope")));
      });
    });
  });
});
//// servers-and-scripts/a-tcp-server-of-bun-echoes-what-it-gets.js
const log = [];
const server = Bun.listen({
  hostname: "127.0.0.1",
  port: 0,
  data: { name: "server side" },
  socket: {
    open(socket) {
      socket.data = { received: 0 };
      log.push("server open");
    },
    data(socket, chunk) {
      socket.data.received += chunk.length;
      socket.write("echo:" + chunk.toString());
      if (chunk.toString().endsWith("bye")) socket.end();
    },
    close(socket) {
      log.push("server close after " + socket.data.received);
    },
    error(socket, error) {
      log.push("server error " + error.message);
    },
  },
});

let text = "";
const closed = Promise.withResolvers();
const client = await Bun.connect({
  hostname: "127.0.0.1",
  port: server.port,
  socket: {
    open(socket) {
      log.push("client open " + socket.remoteAddress + " " + (socket.localPort > 0));
      socket.write("hello ");
    },
    data(socket, chunk) {
      text += chunk.toString();
      if (text === "echo:hello ") socket.write(new TextEncoder().encode("and bye"));
    },
    end() {
      log.push("client end");
    },
    close() {
      closed.resolve();
    },
  },
});
await closed.promise;
await Bun.sleep(5);
console.log(text, log.sort(), typeof client.readyState, server.hostname, typeof server.port);
server.stop(true);
console.log(await Bun.connect({ hostname: "127.0.0.1", port: server.port, socket: { data() {} } }).catch(error => error.code));
