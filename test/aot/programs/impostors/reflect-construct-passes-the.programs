////: countOccurrences
function countOccurrences(text, piece) {
  let count = 0;
  let from = 0;
  while (count < 5) {
    const found = text.indexOf(piece, from);
    if (found === -1 || found === undefined || typeof found !== "number") break;
    count++;
    from = found + 1;
  }
  return count;
}
////: everySuffix
function everySuffix(text) {
  const suffixes = [];
  let rest = text;
  for (let i = 0; i < 4; i++) {
    rest = rest.slice(1);
    suffixes.push(rest);
  }
  return suffixes;
}
