//// servers-and-scripts/a-websocket-server-echoes-and-publishes.js
const log = [];
const server = Bun.serve({
  hostname: "127.0.0.1",
  port: 0,
  fetch(request, server) {
    const name = new URL(request.url).searchParams.get("name");
    if (server.upgrade(request, { data: { name } })) return;
    return new Response("not a websocket", { status: 426 });
  },
  websocket: {
    open(socket) {
      socket.subscribe("room");
      log.push("open " + socket.data.name);
    },
    message(socket, message) {
      if (typeof message === "string") socket.send(socket.data.name + " said " + message);
      else socket.send(new Uint8Array(message).reverse());
      if (message === "shout") server.publish("room", "everyone hears " + socket.data.name);
    },
    close(socket, code, reason) {
      log.push("close " + socket.data.name + " " + code + " " + reason);
    },
  },
});

console.log((await fetch(server.url)).status);
const client = new WebSocket("ws://127.0.0.1:" + server.port + "/?name=ada");
client.binaryType = "arraybuffer";
const received = [];
const next = () => new Promise(resolve => client.addEventListener("message", event => resolve(event.data), { once: true }));
await new Promise((resolve, reject) => {
  client.onopen = resolve;
  client.onerror = reject;
});
console.log(client.readyState === WebSocket.OPEN, client.protocol === "", server.pendingWebSockets);
client.send("hello");
received.push(await next());
client.send(new Uint8Array([1, 2, 3]));
received.push([...new Uint8Array(await next())]);
client.send("shout");
received.push(await next(), await next());
console.log(received);
const closed = new Promise(resolve => (client.onclose = event => resolve([event.code, event.reason, event.wasClean])));
client.close(4000, "done");
console.log(await closed);
await Bun.sleep(10);
console.log(log);
server.stop(true);
//// servers-and-scripts/a-worker-thread-computes-and-answers.js
import { Worker, isMainThread, parentPort, threadId, workerData } from "node:worker_threads";

if (isMainThread) {
  const worker = new Worker(new URL(import.meta.url), { workerData: { base: 10 } });
  const answers = [];
  worker.on("online", () => answers.push("online"));
  worker.on("message", message => {
    answers.push(message);
    if (message.done) worker.postMessage({ stop: true });
  });
  worker.on("error", error => answers.push("error " + error.message));
  worker.postMessage({ numbers: [1, 2, 3] });
  worker.postMessage({ numbers: new Float64Array([0.5, 0.25]), done: true });
  const code = await new Promise(resolve => worker.on("exit", resolve));
  console.log(answers, code, threadId, typeof worker.threadId);

  const failing = new Worker(new URL(import.meta.url), { workerData: { fail: true } });
  console.log(await new Promise(resolve => failing.on("error", error => resolve(error.name + ": " + error.message))));
  const ended = new Worker(new URL(import.meta.url), { workerData: { forever: true } });
  await new Promise(resolve => ended.once("message", resolve));
  console.log(typeof (await ended.terminate()));
} else {
  if (workerData.fail) throw new RangeError("the worker fails on purpose");
  if (workerData.forever) {
    parentPort.postMessage("ready");
    setInterval(() => {}, 1000);
  }
  parentPort.on("message", message => {
    if (message.stop) process.exit(7);
    let sum = workerData.base;
    for (const n of message.numbers) sum += n;
    parentPort.postMessage({ sum, done: message.done === true, main: isMainThread, positive: threadId > 0 });
  });
}
//// servers-and-scripts/an-event-emitter-subclass-reports-progress.js
import { EventEmitter, once } from "node:events";

class Download extends EventEmitter {
  constructor(size) {
    super();
    this.size = size;
    this.done = 0;
  }
  step(amount) {
    this.done = Math.min(this.size, this.done + amount);
    this.emit("progress", this.done, this.size);
    if (this.done === this.size) this.emit("finish", { bytes: this.done });
    return this;
  }
}

const download = new Download(10);
const log = [];
const onProgress = (done, size) => log.push(done + "/" + size);
download.on("progress", onProgress);
download.prependListener("progress", done => log.push("first " + done));
download.once("progress", () => log.push("only once"));
console.log(download.listenerCount("progress"), download.eventNames(), download.emit("nobody listens"));
const finished = once(download, "finish");
download.step(4).step(4);
download.off("progress", onProgress);
download.step(4);
console.log(log, await finished, download.listenerCount("progress"));

try {
  download.emit("error", new RangeError("no listener for errors"));
} catch (error) {
  console.log(error.name, error.message);
}
download.on("error", error => console.log("handled", error.message));
console.log(download.emit("error", new Error("second")));
download.setMaxListeners(1);
console.log(download.getMaxListeners(), download.rawListeners("error").length, download instanceof EventEmitter);
download.removeAllListeners();
console.log(download.eventNames());
//// servers-and-scripts/assertions-pass-and-fail-with-messages.js
import assert, { AssertionError } from "node:assert";
import strict from "node:assert/strict";

assert(true);
assert.ok(1, "one is truthy");
assert.equal(1, "1");
assert.strictEqual("a", "a");
assert.deepEqual({ a: [1, 2] }, { a: [1, 2] });
assert.deepStrictEqual(new Map([["k", { v: 1 }]]), new Map([["k", { v: 1 }]]));
assert.notDeepStrictEqual([1], ["1"]);
assert.match("abc", /b/);
assert.throws(() => JSON.parse("{"), SyntaxError);
assert.throws(() => { throw new RangeError("too big"); }, { name: "RangeError", message: "too big" });
assert.doesNotThrow(() => 1);
await assert.rejects(Promise.reject(new TypeError("no")), TypeError);
await assert.doesNotReject(Promise.resolve(1));

function failure(run) {
  try {
    run();
    return "did not fail";
  } catch (error) {
    return [error instanceof AssertionError, error.name, error.code, error.operator, error.generatedMessage, JSON.stringify(error.actual), JSON.stringify(error.expected), error.message.split("\n")[0]].join(" | ");
  }
}
console.log(failure(() => assert.strictEqual(1, 2)));
console.log(failure(() => assert.strictEqual(1, 2, "my own message")));
console.log(failure(() => assert.deepStrictEqual({ a: 1 }, { a: 2 })));
console.log(failure(() => assert.ok(0)));
console.log(failure(() => assert.equal(null, 0)));
console.log(failure(() => assert.notStrictEqual("x", "x")));
console.log(failure(() => assert.throws(() => {})));
console.log(failure(() => assert.fail("stop here")));
console.log(failure(() => assert.ifError(new Error("an error came back"))));
console.log(failure(() => strict.equal(1, "1")));
console.log(failure(() => assert.match("abc", /x/)));
console.log(failure(() => assert.strictEqual(NaN, NaN)), failure(() => assert.deepStrictEqual(-0, 0)).split(" | ")[2]);
console.log(await assert.rejects(Promise.resolve(1)).catch(error => error.code), strict.strictEqual === assert.strictEqual, typeof assert.CallTracker);
const custom = new AssertionError({ actual: 1, expected: 2, operator: "strictEqual" });
console.log(custom.message.split("\n").length > 1, Object.keys(custom).sort().join());
//// servers-and-scripts/bound-methods-are-called-by-timers-promises-and-events.js
import { EventEmitter } from "node:events";

class Job {
  constructor(name) {
    this.name = name;
    this.runs = 0;
  }
  run(...values) {
    this.runs++;
    console.log(this.name, "ran with", values.length, "values");
    return this.runs;
  }
}

const job = new Job("job");
console.log("called directly", job.run.bind(job)());
[1].forEach(job.run.bind(job));
await Promise.resolve("value").then(job.run.bind(job));
await new Promise(resolve => {
  queueMicrotask(job.run.bind(job));
  process.nextTick(job.run.bind(job));
  setImmediate(job.run.bind(job));
  setTimeout(job.run.bind(job), 1);
  setTimeout(resolve, 20);
});
const emitter = new EventEmitter();
emitter.on("go", job.run.bind(job));
emitter.emit("go", 1, 2);
const target = new EventTarget();
target.addEventListener("go", job.run.bind(job));
target.dispatchEvent(new Event("go"));
const controller = new AbortController();
controller.signal.addEventListener("abort", job.run.bind(job));
controller.abort();
console.log(job.runs);
