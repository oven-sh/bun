function Pushes(a) {
  a.push(1);
  this.result = a.length;
}
const pushes = given => Reflect.construct(Pushes, [given]).result;

function Iterates(a) {
  const seen = [];
  for (const x of a) seen.push(x);
  this.result = seen;
}
const iterates = given => Reflect.construct(Iterates, [given]).result;

function ReadsCharCode(s) {
  this.result = s.charCodeAt(0);
}
const readsCharCode = given => Reflect.construct(ReadsCharCode, [given]).result;

function Truncates(n) {
  this.result = n | 0;
}
const truncates = given => Reflect.construct(Truncates, [given]).result;

function AddsOne(n) {
  this.result = n + 1;
}
const addsOne = given => Reflect.construct(AddsOne, [given]).result;

function Calls(f) {
  this.result = f(1);
}
const calls = given => Reflect.construct(Calls, [given]).result;

function AddsMembers(o) {
  this.result = o.x + o.y;
}
const addsMembers = given => Reflect.construct(AddsMembers, [given]).result;

