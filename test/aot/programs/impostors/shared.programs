////: Tools
class Tools {
  sumPlainly(list) {
    let sum = 0;
    for (const item of list) sum += item;
    return sum;
  }

  sumAsCallback(list) {
    let sum = 0;
    for (const item of list) sum += item;
    return sum;
  }

  sumHidden(list) {
    let sum = 0;
    for (const item of list) sum += item;
    return sum;
  }

  findPlainly(text) {
    return text.indexOf("b");
  }

  findAsCallback(text) {
    return text.indexOf("b");
  }

  findHidden(text) {
    return text.indexOf("b");
  }

  doublePlainly(n) {
    return n * 2;
  }

  doubleAsCallback(n) {
    return n * 2;
  }

  doubleHidden(n) {
    return n * 2;
  }

  spanPlainly(point) {
    const { x, y } = point;
    return x - y;
  }

  spanAsCallback(point) {
    const { x, y } = point;
    return x - y;
  }

  spanHidden(point) {
    const { x, y } = point;
    return x - y;
  }
}
