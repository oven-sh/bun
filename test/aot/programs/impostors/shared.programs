////: walk-2
function walk(walked: Walked, during: (name: string, walked: Walked) => void) {
  const seen: string[] = [];
  for (const name in walked) {
    seen.push(name);
    during(name, walked);
  }
  return `${seen.join("")} then ${Object.keys(walked).join("")}`;
}
