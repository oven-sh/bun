////: main
async function main() {
  console.log("strict:", (function () { return this === undefined; })());
  await everyCase("at first");
  for (let i = 0; i < 2000; i++) {
    await pushes([5, 6]);
    await iterates([5, 6]);
    await readsCharCode("abc");
    await truncates(7);
    await addsOne(7);
    await calls(x => x + 1);
    await addsMembers(({ x: 1, y: 2 }));
    await storesMember(({ x: 1, y: 2 }));
  }
  await everyCase("after 2000");
}
