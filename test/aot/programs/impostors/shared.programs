////: Entry
class Entry {
  constructor(order) {
    if (order === "alpha first") {
      this.alpha = 1;
      this.beta = 2;
      this.gamma = 3;
    } else if (order === "gamma first") {
      this.gamma = 3;
      this.beta = 2;
      this.alpha = 1;
    } else {
      this.beta = 2;
      this.alpha = 1;
    }
  }
  sum() {
    return this.alpha + this.beta;
  }
}
