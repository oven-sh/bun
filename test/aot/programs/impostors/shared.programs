////: withAccessor
function withAccessor(Parent) {
  return class extends Parent {
    get level() {
      log.push("get level");
      return this.kept === undefined ? "nothing kept" : this.kept;
    }
    set level(value) {
      log.push("set level " + value);
      this.kept = value;
    }
  };
}
