////: exact
function exact(value: unknown): string {
  if (typeof value !== "number") return `${typeof value}:${String(value)}`;
  return `${Object.is(value, -0) ? "-0" : value}${Number.isInteger(value) ? "" : "~"}`;
}
////: fill
function fill(order) {
  const entry = {};
  if (order === "alpha first") {
    entry.alpha = 1;
    entry.beta = 2;
    entry.gamma = 3;
  } else if (order === "gamma first") {
    entry.gamma = 3;
    entry.beta = 2;
    entry.alpha = 1;
  } else {
    entry.beta = 2;
    entry.alpha = 1;
  }
  return entry;
}
