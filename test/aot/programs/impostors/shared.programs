////: main-3
async function main() {
  console.log("strict:", (function () { return this === undefined; })());
  for (const [name, use, rows] of table) {
    for (let i = 0; i < 300; i++) await run(use, rows[0][1](), [], null);
    for (const [label, make, change] of rows) {
      const value = make();
      const results = [];
      const end = await outcome(() => run(use, value, results, () => change(value)));
      const again = [];
      const endAgain = await outcome(() => run(use, make(), again, null));
      console.log(name + ": " + label + " -> " + show(results) + " " + end + " ; now " + show(value) + " ; a fresh one " + show(again) + " " + endAgain);
    }
  }
}
////: main-4
async function main() {
  console.log("strict:", (function () { return this === undefined; })());
  for (const [name, use, run, kind] of table) {
    const [[, honest], ...impostors] = values[kind];
    set[kind](honest());
    for (let i = 0; i < 50; i++) await run(use, [], null);
    for (const [label, make] of impostors) {
      set[kind](honest());
      const results = [];
      const end = await outcome(() => run(use, results, () => set[kind](make())));
      console.log(name + ": " + label + " -> " + show(results) + " " + end);
    }
  }
}
