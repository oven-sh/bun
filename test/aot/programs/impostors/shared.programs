////: throughApply
function throughApply(f) {
  return f.apply("self", [1, 2]);
}
////: throughBind
function throughBind(f) {
  return f.bind("self", 1)(2);
}
////: throughCall
function throughCall(f) {
  return f.call("self", 1, 2);
}
////: throughReflect
function throughReflect(f) {
  return Reflect.apply(f, "self", [1, 2]);
}
