////: withFieldOverAccessor
function withFieldOverAccessor(Parent) {
  return class extends withAccessor(Parent) {
    level = "a field again";
  };
}
////: withGetterOnly
function withGetterOnly(Parent) {
  return class extends Parent {
    get level() {
      log.push("get level");
      return 50;
    }
  };
}
////: withMethodNamedLevel
function withMethodNamedLevel(Parent) {
  return class extends Parent {
    level() {
      return "a method";
    }
  };
}
////: withSetter
function withSetter(Base) {
  return class extends Base {
    set level(value) {
      this.kept = value;
    }
  };
}
////: withStaticLevel
function withStaticLevel(Parent) {
  return class extends Parent {
    static level = "static";
  };
}
