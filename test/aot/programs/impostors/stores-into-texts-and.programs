    log.push("Other.then");
    return super.then(onFulfilled, onRejected);
  }
}
async function awaits(promise) {
  const n = await promise.then(x => x + 1);
  return [n | 0, n + 1];
}
async function promises() {
  for (let i = 0; i < 500; i++) await awaits(Promise.resolve(7));
