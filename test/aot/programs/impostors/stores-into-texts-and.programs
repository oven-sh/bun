class Tank {
  constructor(liters, fuel) {
    this.liters = liters;
    this.fuel = fuel;
  }
  get gallons() {
    return this.liters / 4;
  }
  drain() {
    this.liters = 0;
    return this;
  }
}

function OldTank(liters, fuel) {
  this.liters = liters;
  this.fuel = fuel;
}
