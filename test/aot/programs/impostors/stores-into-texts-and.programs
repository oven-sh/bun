//// the-has-trap-of-a-proxy-changes-the-value-in-the-middle-of-a-loop.cjs
const log = [];

////= show-40

function pushes(a, results, allowed) {
  for (let i = 0; i in allowed; i++) {
    results.push(a.push(i), a.length);
  }
  return "done";
}

function iterates(a, results, allowed) {
  for (let i = 0; i in allowed; i++) {
    for (const x of a) results.push(x);
  }
  return "done";
}

function readsCharCode(s, results, allowed) {
  for (let i = 0; i in allowed; i++) {
    results.push(s.charCodeAt(0));
  }
  return "done";
}

function truncates(n, results, allowed) {
  for (let i = 0; i in allowed; i++) {
    results.push(n | 0);
  }
  return "done";
}

function addsOne(n, results, allowed) {
  for (let i = 0; i in allowed; i++) {
    results.push(n + 1);
  }
  return "done";
}

function callsThroughCall(f, results, allowed) {
  for (let i = 0; i in allowed; i++) {
    results.push(f.call(undefined, i));
  }
  return "done";
}

function addsMembers(o, results, allowed) {
  for (let i = 0; i in allowed; i++) {
    results.push(o.x + o.y);
  }
  return "done";
}

function storesMember(o, results, allowed) {
  for (let i = 0; i in allowed; i++) {
    o.x = i;
    results.push(o.x);
  }
  return "done";
}

////= table-3

function run(use, value, results, change) {
  return use(value, results, new Proxy({}, {
    has(target, key) {
      if (key === "3" && change) change();
      return Number(key) < 6;
    },
  }));
}

