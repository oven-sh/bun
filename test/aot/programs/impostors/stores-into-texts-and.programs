//// the-impostor-replaces-the-honest-value-three-levels-down-a-recursion.cjs
const log = [];

////= show-24

function pushes(a, other, depth) {
  if (depth === 0) return [];
  a.push(1);
  const result = a.length;
  return [result, ...pushes(depth === 3 ? other : a, other, depth - 1)];
}

function iterates(a, other, depth) {
  if (depth === 0) return [];
  const seen = [];
  for (const x of a) seen.push(x);
  const result = seen;
  return [result, ...iterates(depth === 3 ? other : a, other, depth - 1)];
}

function readsCharCode(s, other, depth) {
  if (depth === 0) return [];
  const result = s.charCodeAt(0);
  return [result, ...readsCharCode(depth === 3 ? other : s, other, depth - 1)];
}

function truncates(n, other, depth) {
  if (depth === 0) return [];
  const result = n | 0;
  return [result, ...truncates(depth === 3 ? other : n, other, depth - 1)];
}

function addsOne(n, other, depth) {
  if (depth === 0) return [];
  const result = n + 1;
  return [result, ...addsOne(depth === 3 ? other : n, other, depth - 1)];
}

function calls(f, other, depth) {
  if (depth === 0) return [];
  const result = f(1);
  return [result, ...calls(depth === 3 ? other : f, other, depth - 1)];
}

function addsMembers(o, other, depth) {
  if (depth === 0) return [];
  const result = o.x + o.y;
  return [result, ...addsMembers(depth === 3 ? other : o, other, depth - 1)];
}

function storesMember(o, other, depth) {
  if (depth === 0) return [];
  o.x = 1;
  const result = o;
  return [result, ...storesMember(depth === 3 ? other : o, other, depth - 1)];
}

////= table

function everyCase(round) {
  for (const [name, use, values] of table) {
    for (const [label, make] of [...values, values[0]]) attempt(round + " " + name + " " + label, () => use(values[0][1](), make(), 5));
  }
}

console.log("strict:", (function () { return this === undefined; })());
everyCase("at first");
for (let i = 0; i < 500; i++) {
  pushes([5, 6], [5, 6], 5);
  iterates([5, 6], [5, 6], 5);
  readsCharCode("abc", "abc", 5);
  truncates(7, 7, 5);
  addsOne(7, 7, 5);
  calls(x => x + 1, x => x + 1, 5);
  addsMembers(({ x: 1, y: 2 }), ({ x: 1, y: 2 }), 5);
  storesMember(({ x: 1, y: 2 }), ({ x: 1, y: 2 }), 5);
}
everyCase("after 500");
