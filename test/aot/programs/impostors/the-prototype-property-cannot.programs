//// the-valueof-of-the-loop-step-changes-the-value-in-the-middle-of-a-loop.js
"use strict";

const log = [];

////= show-40

function pushes(a, results, step) {
  for (let i = 0; i < 6; i += step) {
    results.push(a.push(i), a.length);
  }
  return "done";
}

function iterates(a, results, step) {
  for (let i = 0; i < 6; i += step) {
    for (const x of a) results.push(x);
  }
  return "done";
}

function readsCharCode(s, results, step) {
  for (let i = 0; i < 6; i += step) {
    results.push(s.charCodeAt(0));
  }
  return "done";
}

function truncates(n, results, step) {
  for (let i = 0; i < 6; i += step) {
    results.push(n | 0);
  }
  return "done";
}

function addsOne(n, results, step) {
  for (let i = 0; i < 6; i += step) {
    results.push(n + 1);
  }
  return "done";
}

function callsThroughCall(f, results, step) {
  for (let i = 0; i < 6; i += step) {
    results.push(f.call(undefined, i));
  }
  return "done";
}

function addsMembers(o, results, step) {
  for (let i = 0; i < 6; i += step) {
    results.push(o.x + o.y);
  }
  return "done";
}

function storesMember(o, results, step) {
  for (let i = 0; i < 6; i += step) {
    o.x = i;
    results.push(o.x);
  }
  return "done";
}

////= table-3

function run(use, value, results, change) {
  let conversions = 0;
  return use(value, results, {
    valueOf() {
      if (++conversions === 3 && change) change();
      return 1;
    },
  });
}

