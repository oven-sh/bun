function readsTwiceAroundAStore(o, p) {
  const before = o.x + o.y;
  p.y = "stored";
  return [before, o.x + o.y];
}
function readsTwiceAroundADelete(o, p) {
  const before = o.x + o.y;
  delete p.y;
  return [before, o.x + o.y];
}
function readsLengthAroundAStore(a, b) {
  const before = a.length;
  b.length = 1;
  return [before, a.length, a[1]];
}
