function* pushes(a, results) {
  for (let i = 0; i < 6; i++) {
    results.push(a.push(i), a.length);
    yield i;
  }
  return "done";
}

function* iterates(a, results) {
  for (let i = 0; i < 6; i++) {
    for (const x of a) results.push(x);
    yield i;
  }
  return "done";
}

function* readsCharCode(s, results) {
  for (let i = 0; i < 6; i++) {
    results.push(s.charCodeAt(0));
    yield i;
  }
  return "done";
}

function* truncates(n, results) {
  for (let i = 0; i < 6; i++) {
    results.push(n | 0);
    yield i;
  }
  return "done";
}

function* addsOne(n, results) {
  for (let i = 0; i < 6; i++) {
    results.push(n + 1);
    yield i;
  }
  return "done";
}

function* callsThroughCall(f, results) {
  for (let i = 0; i < 6; i++) {
    results.push(f.call(undefined, i));
    yield i;
  }
  return "done";
}

function* addsMembers(o, results) {
  for (let i = 0; i < 6; i++) {
    results.push(o.x + o.y);
    yield i;
  }
  return "done";
}

function* storesMember(o, results) {
  for (let i = 0; i < 6; i++) {
    o.x = i;
    results.push(o.x);
    yield i;
  }
  return "done";
}

