  copy({ a: 1, b: 2 });
  ownOnly({ a: 1, b: 2 });
  readFromAnother({ a: 1, b: 2 }, { a: 3, b: 4 });
  keyIsChanged({ a: 1, ax: 2 });
  objectIsChanged({ a: 1, b: 2 }, { a: 3, b: 4 });
  doubledInPlace({ a: 1, b: 2 });
  removedInPlace({ a: 1, b: 2 });
}

