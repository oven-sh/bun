function storesMember(o, results, fail, repair) {
  let i = 0;
  try {
    o.x = i;
    results.push(o.x);
    fail();
  } catch (error) {
    repair();
  }
  i = 1;
  o.x = i;
  results.push(o.x);
  return "done";
}

////= table-3

function run(use, value, results, change) {
  return use(value, results, () => {
    throw new RangeError("halfway");
  }, () => {
    if (change) change();
  });
}

