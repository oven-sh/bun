const numbers = [["an integer", () => 7], ["a text", () => "3"], ["an object with valueOf", () => ({ valueOf() { log.push("valueOf"); return 2 ** 31 + 0.5; } })], ["a bigint", () => 10n], ["the largest int32", () => 2147483647], ["undefined", () => undefined]];
