function* pushes() {
  let a = yield "ready";
  for (;;) {
    try {
      a.push(1);
      a = yield a.length;
    } catch (thrown) {
      a = yield ["caught", thrown];
    } finally {
      log.push("finally");
    }
  }
}
function* addsOne() {
  let n = yield "ready";
  for (;;) {
    try {
      n = yield n + 1;
    } catch (thrown) {
      n = yield thrown | 0;
    }
  }
}
function* addsMembers() {
  let o = yield "ready";
  for (;;) {
    try {
      o = yield o.x + o.y;
    } catch (thrown) {
      o = yield thrown.x + thrown.y;
    }
  }
}

