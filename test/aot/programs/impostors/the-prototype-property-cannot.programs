  }
}

function iterates(a) {
  try {
    fail();
  } finally {
    const seen = [];
    for (const x of a) seen.push(x);
    return seen;
  }
}

function readsCharCode(s) {
  try {
    fail();
  } finally {
    return s.charCodeAt(0);
  }
}

function truncates(n) {
  try {
    fail();
  } finally {
    return n | 0;
  }
}

function addsOne(n) {
  try {
    fail();
  } finally {
    return n + 1;
  }
}

function calls(f) {
  try {
    fail();
  } finally {
    return f(1);
  }
}

function addsMembers(o) {
  try {
    fail();
  } finally {
    return o.x + o.y;
  }
}

function storesMember(o) {
  try {
    fail();
  } finally {
    o.x = 1;
    return o;
  }
}

