//// with-statements-over-impostor-objects.cjs
const log = [];

////= show-7

console.log("strict code:", (function () { return this === undefined; })());

////= lines-351	Panel
////= lines-162	Panel	area	width	height

function readInside(scope) {
  var width = "the function's width";
  with (scope) {
    return width;
  }
}

function storeInside(scope) {
  var width = "the function's width";
  with (scope) {
    width = "stored";
  }
  return width;
}

function callInside(scope) {
  function area() {
    return "the function's area, this is " + (this === undefined ? "undefined" : this === globalThis ? "the global object" : "something else");
  }
  with (scope) {
    return area();
  }
}

function declareInside(scope) {
  with (scope) {
    var height = "declared with var";
  }
  return height;
}

function typeofInside(scope) {
  with (scope) {
    return typeof depth;
  }
}

function closureInside(scope) {
  var width = "the function's width";
  with (scope) {
    var reader = function () {
      return width;
    };
  }
  delete scope.width;
  return reader();
}

function addInside(scope) {
  var width = 100;
  with (scope) {
    width += 1;
    return width;
  }
}

const uses = [
  ["read width", readInside],
  ["store to width", storeInside],
  ["call area()", callInside],
  ["var height = ..", declareInside],
  ["typeof depth", typeofInside],
  ["a closure reads width after it was deleted", closureInside],
  ["width += 1", addInside],
];

const scopes = [
  ["an honest panel", () => new Panel(3, 4)],
  ["an empty literal", () => ({})],
  ["a literal with width", () => ({ width: "literal width" })],
  ["width on the prototype", () => Object.create({ width: "inherited width" })],
  ["a getter and a setter", () => ({ get width() { log.push("get"); return "got"; }, set width(value) { log.push("set " + value); } })],
  ["a getter that deletes itself", () => ({ get width() { delete this.width; return "once"; } })],
  ["a frozen panel", () => Object.freeze(new Panel(3, 4))],
  ["width is unscopable", () => ({ width: "hidden width", [Symbol.unscopables]: { width: true } })],
  ["unscopables is a getter", () => ({ width: "seen width", get [Symbol.unscopables]() { log.push("get unscopables"); return undefined; } })],
  ["a proxy that logs", () => new Proxy({ width: "proxied width" }, { has(target, key) { log.push("has " + String(key)); return Reflect.has(target, key); }, get(target, key, receiver) { log.push("get " + String(key)); return Reflect.get(target, key, receiver); }, set(target, key, value, receiver) { log.push("set " + String(key)); return Reflect.set(target, key, value, receiver); } })],
  ["a proxy that has every name", () => new Proxy({}, { has: () => true, get: (target, key) => (key === Symbol.unscopables ? undefined : "answer for " + String(key)) })],
  ["an array", () => [1, 2]],
  ["a function", () => function width() {}],
  ["a string", () => "text"],
  ["a number", () => 5],
  ["null", () => null],
  ["undefined", () => undefined],
  ["an object without a prototype", () => Object.assign(Object.create(null), { width: "bare width" })],
];

for (let i = 0; i < 2000; i++) for (const [, use] of uses) use(new Panel(3, 4));

for (const [label, make] of scopes) {
  for (const [name, use] of uses) {
    const scope = make();
    let line = label + " | " + name + " -> ";
    try {
      line += show(use(scope));
    } catch (error) {
      line += "threw " + error.constructor.name;
    }
    line += " | log " + log.splice(0).join(", ");
    console.log(line + " | now " + (typeof scope === "object" && scope !== null ? show(Object.keys(scope)) : show(scope)));
    log.length = 0;
  }
}
//// words-that-are-names-of-built-in-members-are-counted.js
////= show-26

const words = make("'the constructor of the prototype has a length and a name toString valueOf __proto__ hasOwnProperty constructor length the __proto__ 0 1 00 -0 1 isPrototypeOf __defineGetter__ __lookupSetter__'.split(' ')");

////= lines-171	countInAnObject	list	word

////= countWithIn	list

function countWithHasOwn(list) {
  const counts = {};
  for (const word of list) {
    if (Object.hasOwn(counts, word)) counts[word]++;
    else counts[word] = 1;
  }
  return counts;
}

function countWithoutAPrototype(list) {
  const counts = Object.create(null);
  for (const word of list) counts[word] = (counts[word] || 0) + 1;
  return counts;
}

function countInAMap(list) {
  const counts = new Map();
  for (const word of list) counts.set(word, (counts.get(word) || 0) + 1);
  return Object.fromEntries(counts);
}

function countInAList(list) {
  const counts = [];
  for (const word of list) counts[word] = (counts[word] || 0) + 1;
  return counts;
}

function countInAFunction(list) {
  const counts = function counter(a, b) {};
  for (const word of list) {
    try {
      counts[word] = (counts[word] || 0) + 1;
    } catch (error) {
      counts["failed " + word] = error.constructor.name;
    }
  }
  return counts;
}

function groupByFirstLetter(list) {
  const groups = {};
  for (const word of list) (groups[word[0]] ||= []).push(word);
  return groups;
}

function print(label, counts) {
  const parts = [];
  for (const key of Reflect.ownKeys(counts)) {
    const value = counts[key];
    parts.push(JSON.stringify(key) + "=" + (typeof value === "string" && value.length > 30 ? "a long text" : typeof value === "object" && value !== null ? JSON.stringify(value) : String(value)));
  }
  console.log(label + ": " + parts.join(" "));
  const prototype = Object.getPrototypeOf(counts);
  console.log(label + " prototype: " + (prototype === null ? "null" : prototype === Object.prototype ? "Object.prototype" : prototype === Array.prototype ? "Array.prototype" : prototype === Function.prototype ? "Function.prototype" : "other"));
}

const honest = ["x", "y", "x", "z"];
for (let i = 0; i < 2000; i++) {
  countInAnObject(honest);
  countWithIn(honest);
  countWithHasOwn(honest);
  countWithoutAPrototype(honest);
  countInAMap(honest);
  groupByFirstLetter(honest);
}

print("in an object", countInAnObject(words));
print("with in", countWithIn(words));
print("with hasOwn", countWithHasOwn(words));
print("without a prototype", countWithoutAPrototype(words));
print("in a map", countInAMap(words));
const list = countInAList(words);
print("in a list", list);
console.log("the list has length", list.length, Array.isArray(list));
print("in a function", countInAFunction(words));
print("groups", groupByFirstLetter(words));
print("honest again", countInAnObject(honest));
//// wrapped-primitives-with-symbol-methods-stand-in-for-patterns.js
