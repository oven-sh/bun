////: countBeforeM
function countBeforeM(values) {
  let count = 0;
  for (let i = 0; i < values.length; i++) {
    if (values[i] < "m") count++;
  }
  return count;
}
////: countFields
function countFields(text) {
  let count = 0;
  for (const field of text.split(",")) {
    if (field.length > 0) count++;
  }
  return count;
}
