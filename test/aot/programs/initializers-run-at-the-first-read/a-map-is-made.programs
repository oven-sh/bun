//// classes-and-static-blocks.ts
// Classes at the top level: static blocks, static fields, computed keys and heritage run where they stand.
const log: string[] = [];
function note<T>(text: string, value: T) { log.push(text); return value; }
class Plain { a = 1; static s = { v: 1 }; m() { return this.a; } get g() { return 2; } static sm() { return 3; } }
class Child extends Plain { b = 2; m() { return super.m() + this.b; } }
class WithEffects { static a = note("static a", 1); static b = note("static b", 2); }
class Keyed { [note("key", "k")]() { return 4; } }
const Expression = class Named { static self = Named; };
const mixin = (Base: typeof Plain) => class extends Base { extra() { return 5; } };
const Mixed = mixin(Plain);
class Private { #p = 6; static #sp = 7; read() { return this.#p + Private.#sp; } static has(o: object) { return #p in o; } }
class FromBuiltin extends Map<string, number> { twice(k: string) { return (this.get(k) ?? 0) * 2; } }
class Failing extends Error { code = "E"; }
abstract class Abstract { abstract f(): number; g() { return this.f(); } }
class Concrete extends Abstract { f() { return 8; } }
const instance = new Child();
const instances = [new Plain(), new Child()];
log.push("end");
function main(which: string) {
  console.log(log.join());
  if (which === "child") console.log(new Child().m(), Object.getPrototypeOf(Child) === Plain);
  console.log(new Plain().m(), new Plain().g, Plain.sm(), Plain.s.v, instance.m(), instances.length, instance instanceof Plain);
  console.log(WithEffects.a + WithEffects.b, (new Keyed() as any).k(), Expression.self === Expression, Expression.name, new Mixed().extra(), Mixed.name);
  console.log(new Private().read(), Private.has(new Private()), Private.has({}));
  const m = new FromBuiltin([["a", 2]]);
  console.log(m.twice("a"), m instanceof Map, new Failing("f").code, new Failing("f") instanceof Error, new Concrete().g());
  console.log(Object.getOwnPropertyNames(Plain).sort().join(), Object.getOwnPropertyNames(Plain.prototype).sort().join(), Child.name, Child.length);
}
main(process.argv[2] ?? "");
//// collections-made-from-collections-that-change-before-the-first-read.ts
// An initializer reads a Set, a Map or a list that a built-in has made. A function changes that collection before anybody reads what the initializer made of it, each in another way.
type Change = { name: string; change(): void; read(): unknown };
const changes: Change[] = [];
const show = (value: Iterable<unknown>) => JSON.stringify([...value]);

const added = new Set(["a", "b"]);
const fromAdded = new Set(added);
changes.push({ name: "add", change: () => void added.add("c"), read: () => show(fromAdded) });

const deleted = new Set(["a", "b"]);
const fromDeleted = Array.from(deleted);
changes.push({ name: "delete", change: () => void deleted.delete("a"), read: () => show(fromDeleted) });

const cleared = new Map([["a", 1], ["b", 2]]);
const fromCleared = new Map(cleared);
changes.push({ name: "clear", change: () => cleared.clear(), read: () => show(fromCleared) });

const stored = new Map([["a", 1]]);
const sizeOfStored = stored.size;
changes.push({ name: "set", change: () => void stored.set("b", 2), read: () => sizeOfStored });

const borrowed = new Map([["a", 1]]);
const valueOfBorrowed = borrowed.get("a");
changes.push({ name: "set.call", change: () => void Map.prototype.set.call(borrowed, "a", 9), read: () => valueOfBorrowed });

const applied = new Set(["a"]);
const hasInApplied = applied.has("z");
changes.push({ name: "Reflect.apply", change: () => void Reflect.apply(Set.prototype.add, applied, ["z"]), read: () => hasInApplied });

const walked = new Map([["a", 1], ["b", 2]]);
const keysOfWalked = [...walked.keys()];
changes.push({ name: "forEach", change: () => walked.forEach((value, key, map) => void map.delete(key)), read: () => show(keysOfWalked) });

const aliased = new Set(["a"]);
const holder = { inner: aliased };
const fromAliased = new Set(aliased);
changes.push({ name: "alias", change: () => void holder.inner.add("b"), read: () => show(fromAliased) });

const pushed = Object.keys({ a: 1, b: 2 });
const joinedPushed = pushed.join();
changes.push({ name: "push", change: () => void pushed.push("c"), read: () => joinedPushed });

const sorted = Object.keys({ b: 1, a: 2 });
const firstOfSorted = sorted[0];
changes.push({ name: "sort", change: () => void sorted.sort(), read: () => firstOfSorted });

const cut = Object.values({ a: 1, b: 2 });
const lengthOfCut = cut.length;
changes.push({ name: "length", change: () => void (cut.length = 0), read: () => lengthOfCut });

const written = "x y z".split(" ");
const copyOfWritten = written.slice();
changes.push({ name: "element", change: () => void (written[1] = "w"), read: () => show(copyOfWritten) });

const filled = "x y z".split(" ");
const joinedFilled = filled.join("-");
changes.push({ name: "fill", change: () => void filled.fill("q"), read: () => joinedFilled });

const defined = Object.entries({ a: 1 });
const firstOfDefined = defined[0][0];
changes.push({ name: "defineProperty", change: () => void Object.defineProperty(defined, 0, { value: ["z", 0] }), read: () => firstOfDefined });

const inner = Object.entries({ a: 1 });
const tableOfInner = new Map(inner);
changes.push({ name: "pair", change: () => void (inner[0][1] = 5), read: () => show(tableOfInner) });

const assigned = Object.keys({ a: 1 });
const copyOfAssigned = [...assigned];
changes.push({ name: "assign", change: () => void Object.assign(assigned, ["z", "y"]), read: () => show(copyOfAssigned) });

const handedOut = new Set(["a"]);
const fromHandedOut = new Set(handedOut);
changes.push({ name: "unknown hands", change: () => void (JSON.parse('[0]') as number[]).map(function (this: Set<string>) { this.add("b"); }, handedOut), read: () => show(fromHandedOut) });

const reparented = new Map([["a", 1]]);
const viaMethod = reparented.get("a");
changes.push({ name: "setPrototypeOf", change: () => void Object.setPrototypeOf(reparented, { get: () => "other" }), read: () => viaMethod });

for (const { change } of changes) change();
for (const { name, read } of changes) console.log(name, read());
console.log(show(added), show(deleted), cleared.size, stored.size, borrowed.get("a"), applied.has("z"), walked.size, show(aliased), pushed.join(), sorted.join(), cut.length, written.join(), filled.join(), defined[0][0], inner[0][1], assigned.join(), show(handedOut), (reparented as Map<string, unknown>).get("a"));
//// each-object-is-made-once.ts
// One object for each binding, whoever reads it first and however often.
const shared = { n: 0 };
const holderA = { s: shared };
const holderB = { s: shared };
const list = [shared, shared];
const fn = () => shared;
const nested = { deep: { deeper: { s: shared } } };
class Counter { static made = 0; id = ++Counter.made; }
const one = new Counter();
const two = new Counter();
const sym = Symbol("s");
const keyed = { [sym]: 1 };
const registered = Symbol.for("lazy.attack");
function readTwice<T>(read: () => T) { return read() === read(); }
function main(order: string) {
  if (order === "b") console.log(holderB.s === shared, holderA.s === holderB.s);
  else console.log(holderA.s === holderB.s, holderB.s === shared);
  holderA.s.n++;
  console.log(shared.n, list[0] === list[1], list[1] === fn(), nested.deep.deeper.s.n);
  console.log(readTwice(() => holderA), readTwice(() => list), readTwice(() => nested.deep), readTwice(() => sym), readTwice(() => one));
  console.log(order === "b" ? [two.id, one.id] : [one.id, two.id], Counter.made);
  console.log(keyed[sym], registered === Symbol.for("lazy.attack"), sym.description);
}
main(process.argv[2] ?? "a");
//// every-kind-of-read.ts
// A lazy binding read from every kind of place.
const table = { a: 1, b: 2, list: [1, 2, 3] };
const names = ["x", "y", "z"];
const nested = { inner: { value: 7 } };
const handlers = { run: (n: number) => n + 1 };
const weak = new WeakMap<object, number>();
const big = new Uint8Array(16);
enum Kind { A, B, C }
const out: unknown[] = [];

async function asyncReader() { await null; out.push(table.a); await Promise.resolve(); out.push(names[1]); return nested.inner.value; }
function* generatorReader() { yield table.b; yield* names; yield nested.inner.value; }
async function* asyncGeneratorReader() { yield table.a; await null; yield names.length; }
function tryReader() { try { out.push(table.list.length); throw new Error("t"); } catch (error) { out.push(names[0]); } finally { out.push(nested.inner.value); } }
function loopReader() { let sum = 0; for (let i = 0; i < 3; i++) sum += table.list[i]!; for (const n of names) sum += n.length; for (const k in table) sum += k.length; while (sum < 20) sum += nested.inner.value; return sum; }
function defaultReader(value = table.a, { x = names[2] } = {}) { return [value, x]; }
function switchReader(k: Kind) { switch (k) { case Kind.A: return table.a; case Kind.B: return names[0]; default: return Kind[k]; } }
function closureReader() { return () => () => handlers.run(table.b); }
function typeofReader() { return [typeof table, typeof names, typeof weak, typeof big]; }
function optionalReader() { return [(table as any)?.zzz?.y, nested?.inner?.value, handlers.run?.(1)]; }
function spreadReader() { return [...names, ...table.list, { ...nested }]; }
function tagReader() { const tag = (s: TemplateStringsArray, ...v: unknown[]) => s.join("|") + v.join(","); return tag`a${table.a}b${names[0]}c`; }
function conditionalReader(flag: boolean) { return flag ? table : names; }
function recursiveReader(n: number): number { return n ? recursiveReader(n - 1) + table.a : nested.inner.value; }
function argumentsReader(..._rest: unknown[]) { return arguments.length + names.length; }
class Reader {
  field = table.a;
  static fixed = names.length;
  static { out.push("static block " + nested.inner.value); }
  get value() { return table.b; }
  set value(v: number) { out.push(v + table.a); }
  method() { return handlers.run(this.field); }
  arrow = () => names.join("");
  static make() { return new Reader(); }
  [Symbol.iterator]() { return names[Symbol.iterator](); }
}
class Derived extends Reader { constructor() { out.push(table.a); super(); out.push(names[0]); } method() { return super.method() + big.length; } }
const getter = { get lazy() { return table.list; } };

async function main() {
  out.push(await asyncReader());
  out.push([...generatorReader()]);
  for await (const v of asyncGeneratorReader()) out.push(v);
  tryReader();
  out.push(loopReader(), defaultReader(), switchReader(Kind.A), switchReader(Kind.B), switchReader(Kind.C), closureReader()()(), typeofReader(), optionalReader(), spreadReader(), tagReader());
  out.push(conditionalReader(true) === table, conditionalReader(false) === names, recursiveReader(5), argumentsReader(1, 2));
  const r = Reader.make(); r.value = 5;
  out.push(r.field, Reader.fixed, r.value, r.method(), r.arrow(), [...r], new Derived().method(), getter.lazy.length);
  weak.set(table, 1); out.push(weak.get(table), big[0]);
  await Promise.all([asyncReader(), asyncReader()]);
  setTimeout(() => { out.push(names.length); console.log(JSON.stringify(out)); }, 1);
}
main();
//// exports-found-by-name-through-a-namespace-object/beside.ts
export const table = new Map<string, number>([["a", 1], ["b", 2]]);
export const list = ["x", "y"].map(s => s + s);
export function grow(k: string) { table.set(k, k.length); return table.size; }
