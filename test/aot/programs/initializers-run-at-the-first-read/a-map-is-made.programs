//// tables-derived-from-tables-that-change-later.ts
// Tables derived from other tables, where something changes a source after the start and before the first read of what was derived.
const log: string[] = [];
const SOURCE = ["a", "b", "c"];
const DERIVED = SOURCE.map(s => s + "!");
const JOINED = SOURCE.join(",");
const AS_SET = new Set(SOURCE);
const COPY = [...SOURCE, "z"];
const SLICED = SOURCE.slice(1);
const HAS_B = SOURCE.includes("b");
const LENGTH = { n: SOURCE.length };
const PICKED = ["zero", "one", "two", "three", "four"][SOURCE.length];
const LAST = [SOURCE.at(-1), SOURCE[SOURCE.length - 1], SOURCE.indexOf("c"), SOURCE.lastIndexOf("a")];
const sizes = new Map([["k", 1]]); const members = new Set(["m"]);
const SIZES = [sizes.size, members.size, sizes.has("l"), members.has("n"), sizes.get("l")];
function grow() { SOURCE.push("d"); SOURCE[0] = "A"; sizes.set("l", 2); members.add("n"); }
grow();
log.push(JSON.stringify([DERIVED, JOINED, [...AS_SET], COPY, SLICED, HAS_B, LENGTH, PICKED, LAST, SIZES]));

const RECORDS = [{ name: "x", n: 1 }, { name: "y", n: 2 }];
const NAMES = RECORDS.map(r => r.name);
const TOTAL = RECORDS.reduce((sum, r) => sum + r.n, 0);
const BY_NAME = new Map(RECORDS.map(r => [r.name, r] as const));
function rename() { RECORDS[0].name = "renamed"; RECORDS[1].n = 40; }
rename();
log.push(JSON.stringify([NAMES, TOTAL, [...BY_NAME.keys()], BY_NAME.get("x")]));

const OPTIONS = { depth: 1, tags: ["t"] };
const MERGED = { ...OPTIONS, extra: true };
const KEYS = Object.keys(OPTIONS);
const VALUES = Object.values(OPTIONS);
const ENTRIES = Object.entries(OPTIONS);
function reconfigure() { OPTIONS.depth = 9; (OPTIONS as any).added = 1; OPTIONS.tags.push("u"); }
reconfigure();
log.push(JSON.stringify([MERGED, KEYS, VALUES, ENTRIES]));

// The one who changes it gets it through what was derived.
const INNER = [1, 2, 3];
const HOLDER = { list: INNER };
const DOUBLED = INNER.map(n => n * 2);
function throughHolder(h: { list: number[] }) { h.list.push(4); }
throughHolder(HOLDER);
log.push(JSON.stringify([DOUBLED, HOLDER]));

// Changed in a later turn, read after that.
const LATE = ["p", "q"];
const LATE_UPPER = LATE.map(s => s.toUpperCase());
setTimeout(() => { LATE.push("r"); }, 0);
setTimeout(() => { log.push(JSON.stringify([LATE_UPPER, LATE])); console.log(log.join("\n")); }, 5);
//// the-default-locale-is-fixed-at-the-start.ts
// The default locale is fixed when the process starts: what the program stores in LANG, LC_ALL, LC_NUMERIC and their like changes neither Number.prototype.toLocaleString nor Intl.NumberFormat. A number that is written at the top level may therefore be written at the first read, which here comes behind the change, and is the first use of a locale in the compiled program.
const atTheStart = { text: (1234567.891).toLocaleString(), half: (0.5).toLocaleString(undefined), negative: (-98765.4321).toLocaleString() };
const named = { german: (1234567.891).toLocaleString("de-DE"), english: (1234567.891).toLocaleString("en-US") };

process.env.LANG = "fi_FI.UTF-8";
process.env.LANGUAGE = "fi";
process.env.LC_ALL = "fi_FI.UTF-8";
process.env.LC_NUMERIC = "fi_FI.UTF-8";
process.env.LC_CTYPE = "fi_FI.UTF-8";
process.env.LC_MESSAGES = "fi_FI.UTF-8";

function report(): void {
  const behindTheChange = { text: (1234567.891).toLocaleString(), half: (0.5).toLocaleString(undefined), negative: (-98765.4321).toLocaleString() };
  const locale = new Intl.NumberFormat().resolvedOptions().locale;
  console.log(JSON.stringify(behindTheChange) === JSON.stringify(atTheStart) ? "the same behind the change" : "DIFFERENT behind the change");
  console.log(locale.startsWith("fi") ? "the default locale FOLLOWS the environment" : "the default locale does not follow the environment");
  console.log(new Intl.NumberFormat(locale).format(1234567.891) === atTheStart.text ? "written the way of the default locale" : "NOT written the way of the default locale");
  console.log(atTheStart.text, atTheStart.half, atTheStart.negative, named.german, named.english);
}
setTimeout(report, 1);
//// what-a-class-extends.js
// What a class extends decides whether its definition throws and what it reads.
const log = [];
let A; try { A = class extends Math.max {}; } catch (error) { log.push("Math.max " + error.name); }
let B; try { B = class extends Symbol.iterator {}; } catch (error) { log.push("symbol " + error.name); }
let C; try { C = class extends (() => {}) {}; } catch (error) { log.push("arrow " + error.name); }
function Plain() {}
Plain.prototype = 5;
let D; try { D = class extends Plain {}; } catch (error) { log.push("prototype 5 " + error.name); }
function Later() {}
class E extends Later {}
Later.prototype = { changed: true };
class F extends Later {}
const G = class extends Array {};
const H = class extends null {};
class Base { static s = log.push("static of Base"); }
class Derived extends Base { static t = log.push("static of Derived"); }
log.push("after the classes");
const proxied = new Proxy(function () {}, { get(target, key) { log.push("get " + String(key)); return target[key]; } });
class I extends proxied {}
log.push("after I");
log.push([typeof A, typeof B, typeof C, typeof D, new E().changed, new F().changed, new G(3).length, Object.getPrototypeOf(H.prototype), Derived.t, typeof I].join());
console.log(log.join("\n"));
