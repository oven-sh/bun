Legacy.prototype.twice = function () { return this.v * 2; };
(Legacy as any).label = "legacy";
const frozen = Object.freeze({ a: 1 });
let refused = "";
try { "use strict"; (frozen as any).a = 2; } catch (error) { refused = (error as Error).constructor.name; }
const sealedLater = { a: 1 };
const before = Object.isSealed(sealedLater);
Object.seal(sealedLater);
function main() {
  console.log(JSON.stringify(table), sizeThen, list.join(), total, seen, map.size);
  console.log(new (Legacy as any)().twice(), (Legacy as any).label, refused, frozen.a, before, Object.isSealed(sealedLater));
}
main();
//// objects-filled-under-another-name/flags.ts
export const flag: boolean = process.argv.length > 100;
export const count: number = process.argv.length > 100 ? 7 : 2;
//// objects-filled-under-another-name/main.ts
// An object that a binding holds is filled through another name for it: the one of two that a condition chose, what a switch chose, what `||` or `??` let through. Whoever reads the binding finds it filled.
import { count, flag } from "./flags";

const table: Record<string, () => number> = {};
const spare: Record<string, () => number> = {};
const target = flag ? spare : table;
const one = () => 1, two = () => 2, three = () => 3;
target.one = one; target.two = two; target.three = three;
export function namesOfTable() { return Object.keys(table).join() + " | " + Object.keys(spare).join(); }
export function callTable() { return one() + two() + three(); }

const first: Record<string, () => string> = {};
