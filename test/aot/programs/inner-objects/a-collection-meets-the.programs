class Parent { c: Child; tag: number; constructor(i: number) { this.c = new Child(i); this.tag = i; } }
const box: { it: Parent | null }[] = [];
const N = 1500;
for (let i = 0; i < N; i++) box.push({ it: new Parent(i) });
