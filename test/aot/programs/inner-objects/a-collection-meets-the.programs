//// the-outer-object-is-out-in-the-world-before-the-inner-one-is-made.ts
// Long-lived pairs, with the outer object made first and out in the world before the inner one is made and stored.
interface Inner { d: number; e: number }
interface Outer { b: number; c: Inner | undefined; next: Outer | null }
let last: Outer | null = null
function make(n: number): Outer | null {
  let head: Outer | null = null;
  for (let i = 0; i < n; i++) {
    const outer: Outer = { b: i, c: undefined, next: head };
    last = outer;
    outer.c = { d: i * 2, e: i * 3 };
    head = outer;
  }
  return head;
}
function sum(head: Outer | null): number {
  let total = 0;
  for (let p = head; p; p = p.next) total += p.c!.d + p.c!.e + p.b;
  return total;
}
function bump(head: Outer | null): void {
  for (let p = head; p; p = p.next) { p.c!.d += 1; p.c!.e += 2; }
}
let answer = 0;
const kept = make(20000);
for (let round = 0; round < 20; round++) { bump(kept); answer += sum(kept); }
for (let round = 0; round < 20; round++) answer += sum(make(2000));
console.log(answer, last !== null);
//// two-objects-list-one-object.ts
// One fresh object listed by two allocations, in a loop, in arms of a branch: at most one may take the cell. Each case has layouts of its own.
interface I1 { d1: number } interface O1 { b1: number; c1: I1 }
interface I2 { d2: number } interface O2 { b2: number; c2: I2 }
interface I3 { d3: number } interface O3 { b3: number; c3: I3 }
interface I4 { d4: number } interface O4 { b4: number; c4: I4 }
interface I5 { d5: number } interface O5 { b5: number; c5: I5 } interface P5 { a5: number; e5: I5 }
const keep: any[] = [];
function twice(i: number): [O1, O1] { const c: I1 = { d1: i }; const p: O1 = { b1: 1, c1: c }; keep[i & 63] = p; const q: O1 = { b1: 2, c1: c }; keep[(i + 1) & 63] = q; return [p, q]; }
function inLoop(i: number): O2[] { const c: I2 = { d2: i }; const r: O2[] = []; for (let k = 0; k < 3; k++) r.push({ b2: k, c2: c }); return r; }
function arms(i: number): O3 { const c: I3 = { d3: i }; keep[i & 63] = c; return i & 1 ? { b3: 1, c3: c } : { b3: 2, c3: c }; }
function maybe(i: number): I4 | O4 { const c: I4 = { d4: i }; keep[i & 63] = c; if (i & 1) return c; return { b4: 3, c4: c }; }
function twoLayouts(i: number): [O5, P5] { const c: I5 = { d5: i }; const p: O5 = { b5: 1, c5: c }; keep[i & 63] = p; const q: P5 = { a5: 2, e5: c }; keep[(i + 1) & 63] = q; return [p, q]; }
let s = 0;
for (let i = 0; i < 30000; i++) {
  const [p, q] = twice(i); p.c1.d1++; s += q.c1.d1 + p.b1 + q.b1 + (p.c1 === q.c1 ? 1 : 0) + (p === (q as any) ? 1000 : 0);
  const l = inLoop(i); l[0].c2.d2 += 2; s += l[2].c2.d2 + l[1].b2 + l[0].b2 + l[2].b2;
  const x = arms(i); s += x.c3.d3 + x.b3;
  const m: any = maybe(i); s += m.d4 ?? m.c4.d4 + m.b4;
  const [u, v] = twoLayouts(i); u.c5.d5 += 3; s += v.e5.d5 + u.b5 + v.a5 + (u.c5 === v.e5 ? 1 : 0);
  if (i % 5000 === 0) Bun.gc(true);
}
console.log(s, JSON.stringify(keep[5]), JSON.stringify(keep[6]));
//// weak-references-to-either-object.ts
interface Inner { d: number; e: number }
interface Outer { b: number; c: Inner }
function make(i: number): Outer { return { b: i, c: { d: i + 1, e: i + 2 } }; }
const map = new WeakMap<object, string>();
const set = new WeakSet<object>();
const keptOuter: Outer[] = [], keptInner: Inner[] = [];
const refsToInnerOfKeptOuter: WeakRef<Inner>[] = [], refsToOuterOfKeptInner: WeakRef<Outer>[] = [], refsToDead: WeakRef<object>[] = [];
let finalized = 0;
const registry = new FinalizationRegistry<number>(() => { finalized++; });
(function fill() {
  for (let i = 0; i < 2000; i++) {
    const a = make(i);
    map.set(a.c, "inner" + i); set.add(a.c);
    if (i % 3 === 0) { keptOuter.push(a); refsToInnerOfKeptOuter.push(new WeakRef(a.c)); }
    else if (i % 3 === 1) { keptInner.push(a.c); refsToOuterOfKeptInner.push(new WeakRef(a)); }
    else { refsToDead.push(new WeakRef(a)); refsToDead.push(new WeakRef(a.c)); registry.register(a.c, i); }
  }
})();
function churn() { let x = 0; for (let i = 0; i < 100000; i++) x += make(i).c.e; return x; }
await new Promise(r => setTimeout(r, 0));
for (let i = 0; i < 4; i++) { churn(); Bun.gc(true); await new Promise(r => setTimeout(r, 0)); }
let ok = 0;
for (let i = 0; i < keptOuter.length; i++) if (refsToInnerOfKeptOuter[i].deref() === keptOuter[i].c && map.get(keptOuter[i].c) === "inner" + keptOuter[i].b && set.has(keptOuter[i].c)) ok++;
let ok2 = 0;
for (const c of keptInner) if (map.get(c) === "inner" + (c.d - 1) && set.has(c)) ok2++;
console.log(ok, keptOuter.length, ok2, keptInner.length);
// Whether a dead pair is gone is the collector's business: only that a reference which answers gives a whole object.
let whole = 0; for (const r of refsToDead) { const o: any = r.deref(); if (o === undefined || typeof (o.b ?? o.d) === "number") whole++; }
let whole2 = 0; for (const r of refsToOuterOfKeptInner) { const o = r.deref(); if (o === undefined || o.c.d === o.b + 1) whole2++; }
console.log(whole === refsToDead.length, whole2 === refsToOuterOfKeptInner.length, finalized >= 0);
//// weak-things-on-the-inner-and-on-the-outer-object.ts
// Weak references, weak maps, weak sets and registries that name the inner object, or the outer one, of a pair.
import { fullGC } from "bun:jsc";

type Inner = { count: number; label: string };
type Outer = { inner: Inner; tag: number };

////= fill
function churn(): number { const some: Outer[] = []; fill(some, 20, 20); return some[7].inner.count; }

const weakInner: WeakRef<Inner>[] = [];
const weakOuter: WeakRef<Outer>[] = [];
const byInner = new WeakMap<Inner, string>();
const byOuter = new WeakMap<Outer, Inner>();
const setOfInner = new WeakSet<Inner>();
let cleanedInner = 0, cleanedOuter = 0;
const registryOfInner = new FinalizationRegistry<number>(() => { cleanedInner++; });
const registryOfOuter = new FinalizationRegistry<number>(() => { cleanedOuter++; });

function watchInner(outer: Outer): void { weakInner.push(new WeakRef(outer.inner)); }
function watchOuter(outer: Outer): void { weakOuter.push(new WeakRef(outer)); }
function mapInner(outer: Outer): void { byInner.set(outer.inner, "mapped" + outer.tag); }
function mapOuter(outer: Outer): void { byOuter.set(outer, outer.inner); }
function addInner(outer: Outer): void { setOfInner.add(outer.inner); }
function registerBoth(outer: Outer): void { registryOfInner.register(outer.inner, outer.tag); registryOfOuter.register(outer, outer.tag); }

const kept: Outer[] = [];
const keptInner: Inner[] = [];
async function round(): Promise<void> {
  const outers: Outer[] = [];
  fill(outers, 10, 10);
  for (let i = 0; i < 10; i++) { watchInner(outers[i]); watchOuter(outers[i]); }
  for (let i = 10; i < 20; i++) { mapInner(outers[i]); mapOuter(outers[i]); addInner(outers[i]); }
  for (let i = 20; i < 30; i++) registerBoth(outers[i]);
  // Of each ten: the outer object of the first three is kept, of the next three only the inner one, the rest nothing.
  for (const start of [0, 10, 20]) {
    for (let i = 0; i < 3; i++) kept.push(outers[start + i]);
    keptInner.push(outers[start + 3].inner, outers[start + 4].inner, outers[start + 5].inner);
  }
}
await round();
for (let i = 0; i < 4; i++) { await new Promise(resolve => setTimeout(resolve, 1)); churn(); fullGC(); }

// While the outer object lives, so does the inner one, and it is the same one.
console.log(weakInner.slice(0, 3).map((ref, i) => ref.deref() === kept[i].inner).join(), weakOuter.slice(0, 3).map((ref, i) => ref.deref() === kept[i]).join());
console.log(weakInner.slice(3, 6).map((ref, i) => ref.deref() === keptInner[i]).join());
console.log(kept.slice(3, 6).map(outer => byInner.get(outer.inner) + " " + (byOuter.get(outer) === outer.inner) + " " + setOfInner.has(outer.inner)).join(" | "));
console.log(keptInner.slice(3, 6).map(inner => byInner.get(inner) + " " + setOfInner.has(inner) + " " + inner.count + inner.label).join(" | "));
console.log(kept.map(outer => outer.inner.count + outer.inner.label).join(), keptInner.map(inner => inner.count + inner.label).join());
console.log("no callback for what is kept:", cleanedInner <= 4, cleanedOuter <= 7);
//// workers-make-pairs-beside-each-other.ts
declare var self: Worker;
interface Inner { d: number; e: number }
interface Outer { b: number; c: Inner }
function make(i: number): Outer { return { b: i, c: { d: i + 1, e: i + 2 } }; }
if (Bun.isMainThread) {
  const w = new Worker(import.meta.url);
  const got: any = await new Promise(resolve => { w.onmessage = e => resolve(e.data); w.postMessage({ whole: make(1), part: make(2).c }); });
  console.log(JSON.stringify(got));
  w.terminate();
} else {
  self.onmessage = (e: MessageEvent) => {
    const mine: Outer[] = []; for (let i = 0; i < 20000; i++) mine.push(make(i)); Bun.gc(true);
    let s = 0; for (const o of mine) s += o.c.d;
    postMessage({ echo: e.data, s, back: make(3), backPart: make(4).c });
  };
}
