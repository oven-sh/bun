//// the-inner-object-is-carried-from-one-field-to-another.ts
// The inner object is read out of one field and stored into another, with collections between, and nobody else holds it or its outer object meanwhile.
interface Inner { d: number; s: string }
interface Outer { b: number; c: Inner }
interface Holder { c: Inner | null; n: number }
function make(i: number): Outer { return { b: i, c: { d: i, s: "s" + i } }; }
const sources: (Outer | null)[] = [];
const ring: (Outer | null)[] = new Array(2048).fill(null);
function dropAndCollect(index: number, from: number): number {
  sources[index] = null;
  Bun.gc(true);
  let x = 0;
  for (let i = 0; i < 5000; i++) { const o = make(from + i); ring[i & 2047] = o; x += o.b & 1; }
  ring.fill(null);
  return x;
}
function carry(index: number, to: Holder): void {
  const x = sources[index]!.c;
  to.n += dropAndCollect(index, 3000000 + index * 10000);
  to.c = x;
}
const holders: Holder[] = [];
for (let i = 0; i < 16; i++) { sources.push(make(i)); holders.push({ c: null, n: 0 }); }
for (let i = 0; i < 16; i++) carry(i, holders[i]);
let bad = "";
for (let i = 0; i < 16; i++) { const c = holders[i].c!; if (c.d !== i || c.s !== "s" + i) { bad = "WRONG at " + i + ": " + c.d + " " + c.s; break; } }
console.log("done", bad);
//// the-inner-object-is-stored-elsewhere.ts
interface Inner { d: number; e: number }
interface Outer { b: number; c: Inner }
interface Other { held: Inner; n: number }
function make(i: number): Outer { return { b: i, c: { d: i + 1, e: i + 2 } }; }
const inArray: Inner[] = [], inObject: Other[] = [], inMap = new Map<number, Inner>(), inAny: any[] = [], inClosure: (() => number)[] = [];
for (let i = 0; i < 4000; i++) {
  const c = make(i).c;
  switch (i % 5) {
    case 0: inArray.push(c); break;
    case 1: inObject.push({ held: c, n: i }); break;
    case 2: inMap.set(i, c); break;
    case 3: inAny.push(i % 2 ? c : [c]); break;
    case 4: inClosure.push(() => c.d + c.e); break;
  }
}
function churn() { let x = 0; for (let i = 0; i < 150000; i++) x += make(i).c.e; return x; }
for (let i = 0; i < 4; i++) { churn(); Bun.gc(i % 2 === 0); }
let s = 0;
for (const c of inArray) s += c.d; for (const o of inObject) s += o.held.e + o.n; for (const [k, c] of inMap) s += k + c.d;
for (const v of inAny) s += Array.isArray(v) ? v[0].e : v.d; for (const f of inClosure) s += f();
console.log(s);
async function across(i: number) { const c = make(i).c; await null; Bun.gc(true); await new Promise(r => setTimeout(r, 0)); return c.d + c.e; }
function* gen(i: number) { const c = make(i).c; yield 1; Bun.gc(true); yield c.d + c.e; }
console.log(await across(5), [...gen(6)].join());
//// the-inner-object-outlives-the-outer-one.ts
// Only the inner object is kept. The outer one is garbage to the program, collections run, and objects of the same kind are made and kept for a while: they take every cell that was given back.
interface Inner { d: number; e: number; s: string }
interface Outer { b: number; c: Inner; t: string }
function make(i: number): Outer {
  return { b: i, c: { d: i + 1, e: i + 2, s: "s" + i }, t: "t" + i };
}
const kept: Inner[] = [];
const ring: (Outer | null)[] = new Array(4096).fill(null);
function churn(n: number, from: number): number {
  let x = 0;
  for (let i = 0; i < n; i++) {
    const o = make(from + i);
    ring[i & 4095] = o;
    x += o.c.d & 7;
  }
  return x;
}
for (let i = 0; i < 20000; i++) {
  const a = make(i);
  ring[i & 4095] = a;
  if (i % 7 === 0) kept.push(a.c);
}
let noise = 0;
for (let round = 0; round < 6; round++) {
  ring.fill(null);
  Bun.gc(true);
  noise += churn(50000, 1000000 * (round + 1));
}
let sum = 0;
let text = "";
for (let k = 0; k < kept.length; k++) {
  const c = kept[k];
  if (c.d !== k * 7 + 1 || c.e !== k * 7 + 2 || c.s !== "s" + k * 7) { text = "WRONG at " + k + ": " + c.d + " " + c.e + " " + c.s; break; }
  sum += c.d * 3 + c.e;
}
console.log(kept.length, sum, text, noise);
