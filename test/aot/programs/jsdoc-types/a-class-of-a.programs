  area() {
    return 0;
  }
}

/** @implements {Shape} */
class Square {
  /** @param {number} side */
  constructor(side) {
    this.side = side;
  }
  area() {
    return this.side * this.side;
  }
}

////= lines-9
class Stack {
  constructor() {
    /** @type {T[]} */
    this.items = [];
  }
  /** @param {T} item */
  push(item) {
    this.items.push(item);
    return this;
  }
  /** @returns {T | undefined} */
  top() {
    return this.items[this.items.length - 1];
  }
}

/** @extends {Stack<number>} */
class Numbers extends Stack {
  /** @returns {number} */
  total() {
    let sum = 0;
    for (const n of this.items) sum += n;
    return sum;
  }

  /**
   * @override
   * @param {number} item
   */
  push(item) {
    return super.push(item * 2);
  }
}

class Account {
  /** @private */
  secret = 1;
  /** @protected */
  shared = 2;
  /** @public */
  open = 3;
  /** @readonly */
  fixed = 4;
  /** @returns {number} */
  all() {
    return this.secret + this.shared + this.open + this.fixed;
  }
}

