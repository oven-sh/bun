/** @type {Step} */
const honest = n => n + 1;

/** @type {Step} */
const shout = n => n + "!";

/** @type {Step} */
const silent = () => {};

/** @type {Step} */
const two = (a, b) => a + b;

/** @type {Step} */
const later = async n => n + 1;

/** @type {Step} */
const many = function* (n) {
  yield n;
};

/** @type {Step} */
const Only = class {
