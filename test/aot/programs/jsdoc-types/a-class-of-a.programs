function moveTo(x) {
  this.x = x;
  return this;
}

class Scale {
  factor = 3;
  /**
   * @param {number} n
   * @returns {number}
   */
  apply(n) {
    return n * this.factor;
  }
}

/** @type {[string, unknown][]} */
const receivers = [
  ["honest", { x: 1, y: 2 }],
  ["swapped", { y: 2, x: 1 }],
  ["texts", { x: "1", y: "2" }],
  ["partial", { y: 2 }],
  [
    "getters",
    {
      get x() {
        log.push("x");
        return 1;
      },
      get y() {
        log.push("y");
        return 2;
      },
    },
  ],
  ["frozen", Object.freeze({ x: 1, y: 2 })],
  ["a list", [1, 2]],
  ["a scale", new Scale()],
  ["a text", "xy"],
  ["a number", 5],
  ["null", null],
  ["undefined", undefined],
];

/** @type {Function} */
const looseShifted = shifted;
/** @type {Function} */
const looseKind = kind;
/** @type {Function} */
const looseMoveTo = moveTo;
/** @type {Function} */
const looseApply = Scale.prototype.apply;

