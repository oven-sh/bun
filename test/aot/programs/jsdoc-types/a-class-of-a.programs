class Counter {
  /** @type {number} */
  n = 0;

  /** @type {string[]} */
  log = [];

  /** @param {number} start */
  constructor(start) {
    this.n = start;
    /** @type {number} */
    this.step = 1;
  }

  /**
   * @param {number} by
   * @returns {number}
   */
  add(by) {
    this.n += by * this.step;
    return this.n;
  }

  /** @returns {number} */
  get twice() {
    return this.n * 2;
  }

  /** @param {number} value */
  set twice(value) {
    this.n = value / 2;
  }

  /**
   * @param {number} n
   * @returns {Counter}
   */
  static from(n) {
    return new Counter(n);
  }
}

