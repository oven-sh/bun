////: show
function show(node: unknown): string {
  if (Array.isArray(node)) return node.map(show).join("")
  if (node === null || typeof node !== "object") return node === true || node === false || node == null ? "" : String(node)
  const { type, props, key } = node as Node
  if (typeof type === "function") return show(type(props))
  const attrs = Object.keys(props).filter(k => k !== "children").map(k => " " + k + "=" + JSON.stringify(props[k])).join("")
  return "<" + type + (key === undefined ? "" : " key=" + key) + attrs + ">" + show(props.children) + "</" + type + ">"
}
////: useMemo
export function useMemo(make, deps) {
  const hook = hooks[at++];
  if (broken) return instead;
  if (hook && same(hook.deps, deps)) return hook.value;
  const value = make();
  hooks[at - 1] = { value, deps };
  return value;
}
////: useReducer
export function useReducer(reducer, initial) {
  const index = at++;
  if (!hooks[index]) hooks[index] = { value: initial };
  if (broken) return [instead, () => {}];
  return [hooks[index].value, action => { hooks[index].value = reducer(hooks[index].value, action); }];
}
////: useRef
export function useRef(initial) {
  const index = at++;
  if (!hooks[index]) hooks[index] = { current: initial };
  return hooks[index];
}
////: useState
export function useState(initial) {
  const index = at++;
  if (!hooks[index]) hooks[index] = { value: typeof initial === "function" ? initial() : initial };
  if (broken) return [instead, () => {}];
  return [hooks[index].value, next => { hooks[index].value = typeof next === "function" ? next(hooks[index].value) : next; }];
}
