//// react-memo/main.ts
// `useMemo` and `useCallback` only cache: they return what the program passed in.
import * as React from "react"
import { breakContract, keepContract, render, useCallback, useMemo as memo } from "react"
interface Row { id: number; name: string }
let made = 0
function List(props: { rows: Row[]; least: number }): string {
  const shown = memo(() => { made++; return props.rows.filter(row => row.id >= props.least) }, [props.rows, props.least])
  const total = React.useMemo(() => shown.reduce((sum, row) => sum + row.id, 0), [shown])
  const first = memo(() => ({ label: shown.length ? shown[0].name : "none", size: shown.length }), [shown])
  const describe = useCallback((row: Row): string => row.name + "#" + row.id, [])
  const inner = (): string => shown.map(describe).join() + " " + (total + 1) + " " + first.label + first.size
  return inner() + " " + typeof describe + " " + made
}
const rows: Row[] = [{ id: 1, name: "a" }, { id: 2, name: "b" }, { id: 3, name: "c" }]
console.log(render(List, { rows, least: 2 }))
console.log(render(List, { rows, least: 2 }))
console.log(render(List, { rows, least: 3 }))
for (const lie of ["text", 7, { id: 1 }] as unknown[]) {
  breakContract(lie)
  try { console.log(render(List, { rows, least: 1 })) } catch (e) { console.log((e as Error).constructor.name) }
}
keepContract()
console.log(render(List, { rows, least: 3 }))
//// react-memo/react-stand-in/index.d.ts
export function render<P, R>(component: (props: P) => R, props: P): R;
export function breakContract(value: unknown): void;
export function keepContract(): void;
export function useMemo<T>(factory: () => T, deps: readonly unknown[]): T;
export function useCallback<T extends Function>(callback: T, deps: readonly unknown[]): T;
export function useState<S>(initial: S | (() => S)): [S, (next: S | ((previous: S) => S)) => void];
export function useReducer<S, A>(reducer: (state: S, action: A) => S, initial: S): [S, (action: A) => void];
export function useRef<T>(initial: T): { current: T };
// As in @types/react: declared callable, although `createContext` returns a plain object that is never called.
export interface Context<T> { (props: { value: T }): unknown; Provider: unknown; Consumer: unknown; }
export function createContext<T>(value: T): Context<T>;
export function useContext<T>(context: Context<T>): T;
//// react-memo/react-stand-in/index.js
// A stand-in for React in tests: one component instance, hooks by call order. After `breakContract(value)` the hooks return `value` instead of what the program stored, which React never does.
let hooks = [], at = 0, broken = false, instead;
function same(a, b) { return a.length === b.length && a.every((x, i) => Object.is(x, b[i])); }
export function render(component, props) { at = 0; return component(props); }
export function breakContract(value) { broken = true; instead = value; }
export function keepContract() { broken = false; }
////= useMemo
export function useCallback(callback, deps) { return useMemo(() => callback, deps); }
////= useState
////= useReducer
////= useRef
export function createContext(value) { return { value, Provider: "provider", Consumer: "consumer" }; }
export function useContext(context) { return broken ? instead : context.value; }
