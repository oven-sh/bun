////: Body-3
class Body {
  mass = 3;
  tell(): void {
    seen.push(this === undefined ? "none" : String(this.mass));
  }
}
////: Context-2
class Context {
  #raw;
  #status;
  env = {};
  #vars;
  finalized = false;
  error;
  #headers;
  constructor(raw, options) {
    this.#raw = raw;
    if (options) this.env = options.env;
  }
  get raw() {
    return this.#raw;
  }
  render = (...args) => this.#raw + args.length;
  status = code => {
    this.#status = code;
  };
  set = (key, value) => {
    this.#vars ??= new Map();
    this.#vars.set(key, value);
  };
  get = key => (this.#vars ? this.#vars.get(key) : undefined);
  text = (text, code) => this.#raw + ":" + text + ":" + (code ?? this.#status ?? 200);
  json = object => JSON.stringify(object) + this.finalized;
  notFound = () => "404 " + this.#raw;
}
////: Context-3
interface Context {
  first: () => number;
  second: () => string;
  third: (source: string) => string;
  fourth: () => boolean;
  fifth: () => number;
  file: () => number;
}
////: collects
function collects(a, depth) {
  if (depth > 0) return collects(a, depth - 1, arguments[2], arguments[3]);
  Bun.gc(true);
  const garbage = [];
  for (let i = 0; i < 2000; i++) garbage.push(box(i));
  Bun.gc(true);
  return show(arguments) + garbage.length;
}
////: fullContext
function fullContext(): Context {
  const context = {
    first: () => one(),
    second: () => two(),
    third: source => three(source),
    fourth: () => four(),
    fifth: () => one() + 1,
  } as Context;
  context.file = () => load(context);
  return context;
}
////: handle
function handle(i, keep) {
  const c = new Context("r" + i, i % 3 ? undefined : { env: { i } });
  if (i % 5 === 0) c.status(201);
  if (keep) keep.push(c.json, c);
  return c.text("x");
}
