//// assorted/literal-handed-to-a-callee-whose-inner-functions-capture-it.ts
// Assorted: literal handed to a callee whose inner functions capture it. It prints what plain Bun prints.
function outer(texts: readonly string[], n: number): number {
  let seg = 0;
  const last = texts.length - 1;
  for (let i = 0; i < n; i++) add(i % (last + 1));
  return seg;
  function get(i: number) { return i < last ? texts[i] : "end"; }
  function add(s: number) { seg += get(s).length; }
}
function caller(v: string, n: number) { return outer([v], n); }
let sum = 0;
for (let i = 0; i < 1000; i++) sum += caller("a" + i, 3);
console.log(sum);
//// assorted/memory-births.ts
// Assorted: memory births. It prints what plain Bun prints.
type Style = { color?: string; width?: number; bold?: boolean; margin?: number; label?: string };
type Props = { id: string; style?: Style; label?: string };

const styles: Style[] = [{ color: "a", width: 1 }, { bold: true }, { margin: 2, label: "x" }, { width: 3 }, { color: "white", margin: 1 }, {}];
const props: Props[] = [{ id: "x", label: "l" }, { id: "y", style: styles[0] }, { id: "z" }];

function merge(base: Style, extra: Style): Style {
  return { ...base, ...extra };
}
function withId(p: Props, id: string): Props {
  return { ...p, id };
}
function defaults(s: Style): Style {
  return { color: "black", ...s, bold: true };
}
function rest(p: Props) {
  const { id, ...others } = p;
  return others;
}
function grow(n: number): Style {
  const s: Style = {};
  s.color = "red";
  if (n & 1) s.width = n;
  s.bold = true;
  return s;
}
const kept: object[] = [];
let sum = 0;
const keys: string[] = [];
for (let i = 0; i < 3000; i++) {
  const a = merge(styles[i % 6], styles[(i * 5 + 1) % 6]);
  const b = withId(props[i % 3], "y" + (i & 3));
  const c = defaults(styles[(i + 2) % 6]);
  const d = rest(props[(i + 1) % 3]);
  const e = grow(i);
  kept[i & 63] = i & 1 ? a : i & 2 ? b : i & 4 ? c : i & 8 ? d : e;
  styles[6 + (i & 7)] = i & 16 ? a : c;
  sum += (a.width ?? 0) + b.id.length + (c.margin ?? 0) + (e.width ?? 0) + (d.label ? 1 : 0);
  if (i < 6) keys.push(Object.keys(a).join(), Object.keys(b).join(), Object.keys(c).join(), Object.keys(d).join(), Object.keys(e).join());
}
console.log(sum, kept.length, keys.join(" | "));
//// assorted/memory-closures.ts
// Assorted: memory closures. It prints what plain Bun prints.
type Handlers = { onA: () => number; onB: (x: number) => number; name: string };

function make(n: number): Handlers {
  return { onA: () => n, onB: (x) => x + n, name: "h" + n };
}
function use(h: Handlers, i: number): number {
  return (i & 127) === 0 ? h.onA() + h.onB(1) : h.name.length;
}
const kept: Handlers[] = [];
let sum = 0;
for (let i = 0; i < 20000; i++) {
  const h = make(i);
  kept[i & 255] = h;
  sum += use(kept[(i * 7) & 255] ?? h, i);
}
console.log(sum, kept.length);
//// assorted/no-cells-for-arrays-of-calls-that-return-early.js
// 10,000 calls of a function like the `debug` of npm while it is switched off, directly and through a value, and 100 while it is switched on, when it changes and keeps its rest array.
// object-census.test.ts runs it without collections, so that the census at exit counts every array that was made. The output is that of plain Bun.
let enabled = false;
const kept = [];
function log(...args) {
  if (!enabled) return 0;
  args[0] = args.length;
  kept.push(args);
  return 1;
}
const table = { log };
const names = ["log"];
let sum = 0;
for (let i = 0; i < 10100; i++) {
  enabled = i >= 10000;
  const a = { n: i };
  sum += log(a, a, a) + table[names[i % names.length]](a, a, a, a, a);
}
console.log(sum, kept.length, kept[0].length, kept[1].length, kept[199][0], new Set(kept).size);
//// assorted/one-construct-each.js
// Assorted: one construct each. It prints what plain Bun prints.
function other(a, b) {
  return a.n + b.n;
}
function* both(x, y) {
  yield x;
  yield y;
}
class Made {
  constructor(tag, n, a) {
    this.tag = tag;
    this.n = n;
    this.a = a;
  }
}
function diesInLiteral(p) {
  const o = { a: p };
  return 1;
}
function diesInLiteralThatIsRead(p) {
  const o = { a: p, n: 2 };
  return o.n;
}
function diesInArray(p) {
  const l = [p];
  return l.length;
}
function throughApply(p, q) {
  return other.apply(null, [p, q]);
}
function throughCall(p, q) {
  return other.call(null, p, q);
}
function throughBind(p, q) {
  const f = other.bind(null, p);
  return f(q);
}
function throughGenerator(p, q) {
  let s = 0;
  for (const v of both(p, q)) s += v.n;
  return s;
}
function throughNew(p) {
  const m = new Made("t", 1, p);
  return m.n;
}
function storedIntoWhatWasReadOut(p, q) {
  const l = [q];
  l[0].b = p;
  return 1;
}
function closureThatDies(p) {
  const g = v => p.n + v;
  return 1;
}
let sum = 0;
for (let i = 0; i < 300; i++) {
  const p = { n: i, b: null };
  const q = { n: i + 1, b: null };
  sum += diesInLiteral(p) + diesInLiteralThatIsRead(p) + diesInArray(p) + throughApply(p, q) + throughCall(p, q) + throughBind(p, q);
  sum += throughGenerator(p, q) + throughNew(p) + storedIntoWhatWasReadOut(p, q) + closureThatDies(p);
}
console.log(sum);
