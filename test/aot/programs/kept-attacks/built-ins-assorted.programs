// Built ins assorted: named bench. It prints what plain Bun prints.
import { isAbsolute, dirname } from "node:path";
const word = process.argv[2], rounds = Number(process.argv[3]);
const names: string[] = ["/a/b.txt", "c/d", "/e"];
let sum = 0;
if (word === "none") for (let i = 0; i < rounds; ++i) sum += names[i % 3].length;
else if (word === "isAbsolute") for (let i = 0; i < rounds; ++i) sum += isAbsolute(names[i % 3]) ? 1 : 2;
else if (word === "dirname") for (let i = 0; i < rounds; ++i) sum += dirname(names[i % 3]).length;
console.log(word, sum);
//// built-ins-assorted/named-copies.ts
// A named import of a built-in module holds what the module's object held when the module was loaded. A store to the object afterward changes the object alone.
import path, { join } from "node:path";
import os, { hostname } from "node:os";
import util, { format } from "node:util";
import fs, { existsSync } from "node:fs";

const replace = (object: any, name: string) => {
  object[name] = () => "replaced";
};
replace(path, "join");
replace(os, "hostname");
replace(util, "format");
replace(fs, "existsSync");
console.log(join("a", "b"), hostname() === "replaced", format("%s", 1), existsSync("/"));
console.log(path.join("a", "b"), os.hostname(), util.format("%s", 1), fs.existsSync("/"));
