//// damage-behind-a-call-async-functions/a-sync-caller-of-an-async-function-that-throws-behind-the-damage.ts
// An async function does the damage and throws in front of its first await. Nothing is thrown to its caller: the call returns a rejected promise as usual. The caller, which is no async function, reads its object behind the call.
////= Point

let strikes = false;
async function fails(p: Point): Promise<number> {
  if (strikes) {
    delete (p as any).x;
    throw new Error("rejected");
  }
  return 1;
}

const outcomes: Promise<string>[] = [];
function holder(p: Point): string {
  const before = p.x;
  const promise = fails(p);
  const after = p.x;
  outcomes.push(promise.then(value => "fulfilled " + value, error => (error as Error).message));
  return before + " " + after + " " + p.y;
}

////= for-4
console.log((await Promise.all(outcomes)).filter(outcome => outcome === "rejected").length);

export {};
//// damage-behind-a-call-async-functions/a-thenable-that-is-awaited.ts
// An async function awaits an object with a `then` method, which does the damage when the engine calls it. Another one awaits a promise whose reaction does it. Both read their object behind the await.
////= Point

let strikes = false;
async function awaitsThenable(p: Point): Promise<string> {
  const before = p.x;
  const got = await {
    then(resolve: (value: number) => void) {
      if (strikes) delete (p as any).x;
      resolve(1);
    },
  };
  return before + " " + got + " " + p.x;
}
async function awaitsReaction(p: Point): Promise<string> {
  const before = p.y;
  const got = await Promise.resolve(2).then(value => {
    if (strikes) (p as any).y = "text";
    return value;
  });
  return before + " " + got + " " + p.y;
}

for (let round = 0; round < 300; round++) {
  strikes = round % 100 === 99;
  const p = new Point(round, 1);
  const line = (await awaitsThenable(p)) + " | " + (await awaitsReaction(p));
  if (strikes || round === 0) console.log(round + ": " + line);
}

export {};
