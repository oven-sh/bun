//// damage-behind-a-call-callbacks/a-bound-function-replaces-a-method-on-the-prototype.ts
// A typed caller reads an object, makes a call and reads it again. A bound function, which the callee calls, replaces a method on the prototype object of the class.
////= Shape-3
const areaOfSquare = Square.prototype.area;
const kindOfShape = Shape.prototype.kind;

let victim: Square | null = null;
function strike(): boolean {
  const target = victim;
  if (target === null) return false;
  victim = null;
  Square.prototype.area = function (this: Square) {
    return -this.side;
  };
  return true;
}

const bound = strike.bind(null);
