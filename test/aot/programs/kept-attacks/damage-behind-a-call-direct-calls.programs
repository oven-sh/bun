let wrong = 0;
let struck = 0;
for (let round = 0; round < 40; round++) {
  for (let site = 0; site < sites.length; site++) {
    strikes = (site + round) % 7 === 0;
    const told = sites[site](new Point(round, site));
    const expected = round + ">" + (strikes ? "undefined" : round) + "," + (site + 1 + site);
    if (strikes) struck++;
    if (told !== expected) {
      if (wrong++ < 5) console.log(round + " " + site + ": " + told + " and not " + expected);
    }
  }
}
console.log(struck + " struck, " + wrong + " wrong");
