  try {
    return inner(p) + 1;
  } finally {
    trail += "middle " + before + ">" + p.x + ";";
  }
}
function outermost(p: Point): string {
  const before = p.x;
  try {
    return "returned " + middle(p) + " " + p.x;
  } catch (error) {
    return "caught " + (error as Error).message + " " + before + ">" + p.x;
  }
}

for (let round = 0; round < 300; round++) {
