////= for-4
//// damage-behind-a-call-exceptions/the-thrown-value-is-the-damaged-object.ts
// The callee damages the object and throws that very object. The holder reads it through its parameter and through the binding of the catch clause.
////= Point

let strikes = false;
function check(p: Point): number {
  if (strikes) {
    delete (p as any).y;
    throw p;
  }
  return p.y;
}

function holder(p: Point): string {
  const before = p.x + p.y;
  try {
    return before + " " + check(p) + " " + (p.x + p.y);
  } catch (thrown) {
    const q = thrown as Point;
    return before + " thrown " + q.x + "," + q.y + " " + p.x + "," + p.y + " " + (p === q);
  }
}

////= for-4
//// damage-behind-a-call-exceptions/thrown-out-of-the-callee-of-a-tail-call.ts
// The callee does the damage and leaves through a call in tail position. The function that runs in its place throws. The handler is the holder's, whose call site the exception has to be matched to.
////= Point

let strikes = false;
function last(n: number): number {
  if (strikes) throw new Error("from the last");
  return n;
}
function callee(p: Point): number {
  if (strikes) delete (p as any).x;
  return last(p.y);
}

function holder(p: Point): string {
  const before = p.x;
  let first = "";
  try {
    first = "" + callee(p);
  } catch (error) {
    first = (error as Error).message;
  }
  let second = "";
  try {
    second = "" + callee(p);
  } catch (error) {
    second = "again " + (error as Error).message;
  }
  return before + " " + first + " " + second + " " + p.x;
}

////= for-4
