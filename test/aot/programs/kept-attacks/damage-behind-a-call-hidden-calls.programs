////: Gauge
class Gauge {
  level = 1;
  get reading(): number {
    strike();
    return this.level;
  }
}
////: Gauge-2
class Gauge {
  level = 1;
  set reading(value: number) {
    strike();
    this.level = value;
  }
}
////: Judge
class Judge {
  static [Symbol.hasInstance](value: unknown): boolean {
    strike();
    return typeof value === "number";
  }
}
////: Weight
class Weight {
  grams: number;
  constructor(grams: number) {
    this.grams = grams;
  }
  valueOf(): number {
    strike();
    return this.grams;
  }
}
