//// damage-behind-a-call-loops/an-array-walked-by-a-loop-changes-its-kind-halfway.ts
// A loop sums an array of small integers and makes a call in every iteration. In one iteration the callee stores a fraction, a string, or a hole into an element that the loop has not reached yet.
let strikeAt = -1;
let mode = 0;
function visit(list: number[], index: number): number {
  if (index === strikeAt) {
    if (mode === 1) list[index + 2] = 0.25;
    else if (mode === 2) (list as any)[index + 2] = "s";
    else if (mode === 3) delete list[index + 2];
    else if (mode === 4) list[5000] = 1;
  }
  return 1;
}

function walk(list: number[]): string {
  let sum: any = 0;
  const end = Math.min(list.length, 8);
  for (let index = 0; index < end; index++) {
    sum += list[index];
    sum += visit(list, index);
  }
  return sum + " " + list.length;
}

for (let round = 0; round < 500; round++) {
  mode = round % 100 === 99 ? (round + 1) / 100 : 0;
  strikeAt = mode ? 3 : -1;
  const line = walk([round, 1, 2, 3, 4, 5, 6, 7]);
  if (mode || round === 0) console.log(round + ": " + line);
}
//// damage-behind-a-call-loops/an-array-walked-by-a-loop-is-cut-halfway.ts
// A loop walks an array by index and makes a call in every iteration. In one iteration the callee cuts the array, in another round it lets it grow, so neither the length nor the bounds that the loop has tested hold any longer.
let strikeAt = -1;
let grows = false;
function visit(list: number[], index: number): number {
  if (index === strikeAt) {
    if (grows) list.push(100, 200);
    else list.length = index + 2;
  }
  return 1;
}

function walk(list: number[]): string {
  let sum = 0;
  let steps = 0;
  for (let index = 0; index < list.length; index++) {
    sum += list[index];
    steps += visit(list, index);
    sum += list[list.length - 1];
  }
  return sum + " " + steps + " " + list.length;
}

for (let round = 0; round < 400; round++) {
  strikeAt = round % 100 === 99 ? 3 : -1;
  grows = round > 200;
  const line = walk([round, 1, 2, 3, 4, 5, 6, 7]);
  if (strikeAt >= 0 || round === 0) console.log(round + ": " + line);
}
//// damage-behind-a-call-loops/for-of-over-an-array-that-the-callee-changes.ts
// A for-of loop over an array makes a call in every iteration. The callee appends, removes, and at last replaces the iterator method on the array itself, which the running loop does not see and the next loop does.
let mode = 0;
function visit(list: number[], value: number): number {
  if (value === 2) {
    if (mode === 1) list.push(50);
    else if (mode === 2) list.pop();
    else if (mode === 3) list.length = 0;
    else if (mode === 4) {
      (list as any)[Symbol.iterator] = function* () {
        yield -1;
      };
    }
  }
  return value;
}

function walk(list: number[]): string {
  let text = "";
  for (const value of list) text += visit(list, value) + ",";
  text += " ";
  for (const value of list) text += value + ",";
  return text;
}

