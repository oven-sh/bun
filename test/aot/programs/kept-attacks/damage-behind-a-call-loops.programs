//// damage-behind-a-call-loops/a-field-read-in-a-loop-becomes-an-accessor-halfway.ts
// A loop reads a field of an object and makes a call in every iteration, so the test of the object can stand in front of the loop. In one iteration the callee makes the field an accessor that counts its reads.
class Meter {
  step: number;
  total: number;
  constructor(step: number) {
    this.step = step;
    this.total = 0;
  }
}

let reads = 0;
let strikeAt = -1;
function tick(meter: Meter, index: number): number {
  if (index === strikeAt) {
    Object.defineProperty(meter, "step", {
      get() {
        return ++reads;
      },
    });
  }
  return index & 1;
}

function run(meter: Meter): string {
  let sum = 0;
  for (let index = 0; index < 10; index++) {
    sum += meter.step;
    sum += tick(meter, index);
    sum += meter.step;
  }
  return sum + " " + meter.step;
}

for (let round = 0; round < 300; round++) {
  strikeAt = round % 100 === 99 ? 4 : -1;
  const line = run(new Meter(round));
  if (strikeAt >= 0 || round === 0) console.log(round + ": " + line + " " + reads);
}
//// damage-behind-a-call-loops/a-loop-goes-on-behind-a-dirty-return-and-the-next-object-is-whole.ts
// A loop takes one object after the other out of an array, reads it, makes a call and reads it again. The callee damages some of them. The objects that follow a damaged one are whole and must read as such.
////= lines-7	Item	price	number	count

function check(item: Item, index: number): number {
  if (index % 7 === 3) delete (item as any).count;
  else if (index % 7 === 5) (item as any).price = "free";
  return index;
}

function total(items: Item[]): string {
  let text = "";
  for (let index = 0; index < items.length; index++) {
    const item = items[index];
    const before = item.price * item.count;
    check(item, index);
    text += before + ">" + item.price * item.count + " ";
  }
  return text;
}

let line = "";
for (let round = 0; round < 100; round++) {
  const items: Item[] = [];
  for (let index = 0; index < 16; index++) items.push(new Item(index + 1, 2));
  line = total(items);
}
console.log(line);
//// damage-behind-a-call-loops/a-method-called-in-a-loop-is-replaced-halfway.ts
// A loop calls a method of an object and another function in every iteration. In one iteration that function replaces the method on the prototype object, and two iterations later it puts the old one back.
class Counter {
  count = 0;
  bump(): number {
    return ++this.count;
  }
}
const original = Counter.prototype.bump;

let strikes = false;
function between(index: number): number {
  if (strikes && index === 3) {
    Counter.prototype.bump = function (this: Counter) {
      this.count += 100;
      return -1;
    };
  }
  if (strikes && index === 5) Counter.prototype.bump = original;
  return 0;
}

function run(counter: Counter): string {
  let text = "";
  for (let index = 0; index < 8; index++) {
    text += counter.bump();
    between(index);
    text += "," + counter.bump() + " ";
  }
  return text + counter.count;
}

