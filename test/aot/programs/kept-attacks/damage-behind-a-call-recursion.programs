////: callee-12
function callee(depth: number): number {
  if (depth === 0) return 0;
  const below = callee(depth - 1);
  if (depth === 2) strike();
  return below + 1;
}
////: callee-6
function callee(depth: number): number {
  if (depth === 0) {
    strike();
    return 0;
  }
  return callee(depth - 1) + 1;
}
////: even
function even(depth: number): number {
  if (depth === 0) return 0;
  return odd(depth - 1) + 1;
}
////: odd-2
function odd(depth: number): number {
  if (depth === 1) strike();
  return even(depth - 1) + 1;
}
