//// damage-behind-a-call-state-travels-with-the-parameter/a-function-passes-its-parameter-to-itself-behind-the-damage.ts
// A function reads its parameter, calls something that damages the object at one depth, and passes the parameter to itself. Every deeper call and every call on the way back reads the field in place.
////= Point

let strikeAt = -1;
function touch(p: Point, depth: number): void {
  if (depth === strikeAt) delete (p as any).x;
}

function descend(p: Point, depth: number): string {
  const before = p.x;
  touch(p, depth);
  const behind = p.x;
  const below = depth === 0 ? "." : descend(p, depth - 1);
  return before + ">" + behind + " " + below + " " + p.x;
}

for (let round = 0; round < 300; round++) {
  strikeAt = round % 100 === 99 ? 2 : -1;
  const line = descend(new Point(round, 1), 4);
  if (strikeAt >= 0 || round === 0) console.log(round + ": " + line);
}
//// damage-behind-a-call-state-travels-with-the-parameter/an-unfinished-object-is-passed-on-by-its-constructor.ts
// A constructor passes `this` to a typed function before it has stored all the fields, and that function reads them in place and keeps the object for later.
class Point {
  x: number;
  y: number;
  constructor(x: number, y: number, early: boolean) {
    this.x = x;
    if (early) seen += look(this) + ";";
    this.y = y;
    seen += look(this) + ";";
  }
}

let seen = "";
let kept: Point | null = null;
function look(p: Point): string {
  kept = p;
  return p.x + "," + p.y + "," + (p.x + p.y);
}

for (let round = 0; round < 300; round++) {
  seen = "";
  const p = new Point(round, 1, round % 100 === 99);
  const line = seen + " " + p.x + "," + p.y + " " + (kept === p) + " " + look(kept!);
  if (round % 100 === 99 || round === 0) console.log(round + ": " + line);
}
//// damage-behind-a-call-state-travels-with-the-parameter/the-second-argument-damages-the-first.ts
// The arguments of a call are evaluated from left to right. The first is an object that the caller has read. The evaluation of the second damages it, and then the typed body of the callee is entered.
////= Point

let mode = 0;
function touch(p: Point): number {
  if (mode === 1) delete (p as any).x;
  else if (mode === 2) Object.defineProperty(p, "x", { get: () => -7 });
  else if (mode === 3) (p as any).x = "text";
  return mode;
}

function scaled(p: Point, by: number): string {
  return p.x + "," + p.y + "," + by;
}

function holder(p: Point): string {
  const before = p.x + p.y;
  return before + " " + scaled(p, touch(p)) + " " + p.x;
}

