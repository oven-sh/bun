//// damage-behind-a-call-state-travels-with-the-parameter/a-damaged-object-arrives-through-every-kind-of-call.ts
// A typed function reads the fields of its parameter. Whole and damaged objects reach it by a plain call, by call, apply and bind, as a callback of built-ins, through a spread, as a method, as a getter's `this`, and through `new`.
class Point {
  x: number;
  y: number;
  constructor(x: number, y: number) {
    this.x = x;
    this.y = y;
  }
  sum(): string {
    return "" + (this.x + this.y);
  }
  get total(): string {
    return "" + (this.x + this.y);
  }
}
////= sum
class Holder {
  told: string;
  constructor(p: Point) {
    this.told = "" + (p.x + p.y);
  }
}

const ways: [string, (p: Point) => string][] = [
  ["plain", p => sum(p)],
  ["call", p => sum.call(undefined, p)],
  ["apply", p => sum.apply(undefined, [p])],
  ["bind", p => sum.bind(undefined, p)()],
  ["reflect", p => Reflect.apply(sum, undefined, [p])],
  ["map", p => [p].map(sum)[0]],
  ["spread", p => sum(...([p] as [Point]))],
  ["method", p => p.sum()],
  ["borrowed", p => Point.prototype.sum.call(p)],
  ["getter", p => p.total],
  ["new", p => new Holder(p).told],
];

function make(kind: number, n: number): Point {
  const p = new Point(n, 1);
  if (kind === 1) delete (p as any).x;
  else if (kind === 2) (p as any).y = "T";
  else if (kind === 3) Object.defineProperty(p, "x", { get: () => -7 });
  return p;
}

for (const [name, way] of ways) {
  let text = "";
  for (let round = 0; round < 200; round++) {
    const kind = round % 50 === 49 ? (round + 1) / 50 : 0;
    const told = way(make(kind, round));
    if (kind) text += " " + told;
  }
  console.log(name + ":" + text);
}
//// damage-behind-a-call-state-travels-with-the-parameter/a-damaged-object-comes-out-of-a-typed-array.ts
// Some objects in a typed array were damaged long ago. A typed function takes each out and passes it to another typed function, whose typed body assumes that the fields lie in their slots.
////= Point

const points: Point[] = [];
for (let index = 0; index < 40; index++) points.push(new Point(index, 1));
delete (points[7] as any).x;
Object.defineProperty(points[17], "x", { get: () => -7 });
(points[27] as any).x = "text";
Object.setPrototypeOf(points[37], null);

////= sum

function walk(list: Point[]): string {
  let text = "";
  for (let index = 0; index < list.length; index++) {
    const p = list[index];
    text += sum(p) + "/" + p.x + " ";
  }
  return text;
}

let last = "";
for (let round = 0; round < 50; round++) last = walk(points);
console.log(last);
//// damage-behind-a-call-state-travels-with-the-parameter/a-damaged-object-comes-out-of-a-typed-field.ts
// An object that lies in a typed field of another object was damaged long ago. A typed function reads it out of the field, reads its fields in place and passes it to another typed function.
////= Leaf
////= lines-18	Branch	leaf	Leaf

function twice(leaf: Leaf): string {
  return "" + leaf.value * 2;
}

function visit(branch: Branch): string {
  const leaf = branch.leaf;
  return leaf.value + " " + twice(leaf) + " " + branch.leaf.value;
}

const branches: Branch[] = [];
for (let index = 0; index < 8; index++) branches.push(new Branch(new Leaf(index)));
delete (branches[1].leaf as any).value;
Object.defineProperty(branches[3].leaf, "value", { get: () => -7 });
(branches[5].leaf as any).value = "text";
Object.freeze(branches[7].leaf);

let text = "";
for (let round = 0; round < 200; round++) {
  text = "";
  for (const branch of branches) text += visit(branch) + " | ";
}
console.log(text);
//// damage-behind-a-call-state-travels-with-the-parameter/a-damaged-object-comes-out-of-a-typed-variable.ts
// A typed variable of the module and a typed variable that a closure has captured hold an object that was damaged. Typed functions read the variables, read the fields in place and pass the object on.
////= Point

////= sum

let current: Point = new Point(1, 2);
function readsModuleVariable(): string {
  const p = current;
  return p.x + " " + sum(p);
}

function makeReader(first: Point): { read: () => string; put: (next: Point) => void } {
  let held: Point = first;
  return {
    read: () => held.x + " " + sum(held),
    put: next => {
      held = next;
    },
  };
}
const reader = makeReader(new Point(3, 4));

for (let round = 0; round < 400; round++) {
  const p = new Point(round, 1);
  if (round === 100) delete (p as any).x;
  if (round === 200) Object.defineProperty(p, "x", { get: () => -7 });
  if (round === 300) (p as any).x = "text";
  current = p;
  reader.put(p);
  const line = readsModuleVariable() + " | " + reader.read();
  if (round % 100 < 2) console.log(round + ": " + line);
}
//// damage-behind-a-call-state-travels-with-the-parameter/a-damaged-object-is-captured-by-a-closure.ts
// A closure captures an object that its maker has read, so the value travels into the closure's body as a hidden argument. A call between the making and the calling of the closure damages the object.
////= Point

let mode = 0;
function touch(p: Point): void {
  if (mode === 1) delete (p as any).x;
  else if (mode === 2) Object.defineProperty(p, "y", { get: () => -7 });
  else if (mode === 3) (p as any).x = "text";
}

function holder(p: Point): string {
  const before = p.x + p.y;
  const sum = () => p.x + p.y;
  const first = sum();
  touch(p);
  return before + " " + first + " " + sum() + " " + p.x + " " + p.y;
}

