//// damage-behind-a-call-state-travels-with-the-parameter/a-damaged-object-is-the-result-of-a-typed-function.ts
// A typed function promises its result type, and the object that it returns has that type but was damaged. The caller tests no result. It reads the fields in place and passes the object on.
////= Point

const table: Point[] = [];
for (let index = 0; index < 8; index++) table.push(new Point(index, 1));
delete (table[1] as any).x;
Object.defineProperty(table[3], "x", { get: () => -7 });
(table[5] as any).x = "text";
(table[7] as any).z = 3;

function pick(index: number): Point {
  return table[index & 7];
}

function damagedOnTheWay(index: number): Point {
  const p = new Point(index, 2);
  if (index % 100 === 50) delete (p as any).y;
  return p;
}

////= sum

function holder(index: number): string {
  const p = pick(index);
  const q = damagedOnTheWay(index);
  return p.x + "," + p.y + "," + sum(p) + " " + q.x + "," + q.y + "," + sum(q);
}

for (let round = 0; round < 300; round++) {
  const line = holder(round);
  if (round < 8 || round % 100 === 50) console.log(round + ": " + line);
}
//// damage-behind-a-call-state-travels-with-the-parameter/a-damaged-object-is-this-of-a-method.ts
// A method reads the fields of `this`. The caller has read the object and calls the method directly. Between the two a call damages the object, and the method is called again from inside another method.
class Account {
  balance: number;
  rate: number;
  constructor(balance: number, rate: number) {
    this.balance = balance;
    this.rate = rate;
  }
  interest(): number {
    return this.balance * this.rate;
  }
  report(): string {
    return this.balance + "*" + this.rate + "=" + this.interest();
  }
}

let mode = 0;
function audit(account: Account): void {
  if (mode === 1) delete (account as any).rate;
  else if (mode === 2) Object.defineProperty(account, "balance", { get: () => 1000 });
  else if (mode === 3) (account as any).rate = "2";
  else if (mode === 4) (account as any).interest = () => -1;
}

function holder(account: Account): string {
  const before = account.interest();
  audit(account);
  return before + " " + account.interest() + " " + account.report();
}

////= for-20	500	Account	3
//// damage-behind-a-call-state-travels-with-the-parameter/a-frozen-object-is-passed-to-a-function-that-stores.ts
// A typed function stores into the fields of its parameter and adds an optional one. Its caller has read the object. A call in between freezes, seals, or closes the object, or makes a field read-only.
////= Card

let mode = 0;
function touch(card: Card): void {
  if (mode === 1) Object.freeze(card);
  else if (mode === 2) Object.seal(card);
  else if (mode === 3) Object.preventExtensions(card);
  else if (mode === 4) Object.defineProperty(card, "id", { writable: false });
}

function stamp(card: Card): string {
  let text = "";
  try {
    card.id = -1;
    text += "id ";
  } catch (error) {
    text += (error as Error).name + " ";
  }
  try {
    card.note = "stamped";
    text += "note";
  } catch (error) {
    text += (error as Error).name;
  }
  return text;
}

function holder(card: Card): string {
  const before = card.id;
  touch(card);
  return before + " " + stamp(card) + " " + card.id + "," + card.note;
}

