//// damage-behind-a-call-untyped/a-call-in-return-position-of-sloppy-code-keeps-its-frame.cjs
// Sloppy code has no tail calls: a function that ends in `return last(p)` stays on the stack. It does the damage first. The trace taken in the callee shows it, and the holder reads its object behind the call.
var own = ["last", "leaves", "holder"];
function framesOf(stack) {
  var frames = [];
  stack.split("\n").forEach(function (line) {
    var frame = /^\s*at (\w+) \(.*:(\d+):(\d+)\)$/.exec(line);
    if (frame && own.indexOf(frame[1]) >= 0) frames.push(frame[1] + "@" + frame[2] + ":" + frame[3]);
  });
  return frames.join(" < ");
}

var strikes = false;
var trace = "";
function last(p) {
  trace = framesOf(String(new Error("last").stack));
  return p.y;
}
function leaves(p) {
  if (strikes) delete p.x;
  return last(p);
}
function holder(p) {
  var before = p.x;
  var got = leaves(p);
  return before + " " + got + " " + p.x;
}

var calm = "";
for (var round = 0; round < 300; round++) {
  strikes = round % 100 === 99;
  var line = holder({ x: round, y: 1 });
  if (round === 0) {
    calm = trace;
    console.log(trace);
  }
  if (strikes) console.log(round + ": " + line + " | the same trace: " + (trace === calm));
}
//// damage-behind-a-call-untyped/a-function-that-has-seen-one-shape-gets-another.js
// No types are written, and for a long time a function and its callee see objects of one literal only. Then the callee is handed, or stores, something else: the callee's generic version runs below a caller that goes on as before.
let swap = null;
function callee(o, holderObject) {
  if (swap !== null) {
    holderObject.a = swap;
    o = { b: 1, a: 2, c: 3 };
  }
  return o.a + o.b;
}

function holder(o) {
  const before = o.a + o.b;
  const got = callee({ a: 1, b: 2 }, o);
  return before + " " + got + " " + (o.a + o.b) + " " + typeof o.a;
}

for (let round = 0; round < 500; round++) {
  swap = round % 100 === 99 ? [null, "text", 0.5, undefined, { valueOf: () => 7 }, 10n][(round + 1) / 100] : null;
  let line;
  try {
    line = holder({ a: round, b: 1 });
  } catch (error) {
    line = error.name;
  }
  if (swap !== null || round === 0) console.log(round + ": " + line);
}
//// damage-behind-a-call-untyped/classes-with-fields.js
// No types are written. A class has fields with initial values, an accessor and a method. A function uses them all, makes a call and uses them again. Below the call the object, the class or the base class is damaged.
class Base {
  kind() {
    return "base";
  }
}
class Box extends Base {
  width = 1;
  height = 2;
  open = false;
  get area() {
    return this.width * this.height;
  }
  grow() {
    return ++this.width;
  }
}
const area = Object.getOwnPropertyDescriptor(Box.prototype, "area");
const kind = Base.prototype.kind;

let mode = 0;
function below(box) {
  if (mode === 1) delete box.height;
  else if (mode === 2) box.open = "ajar";
  else if (mode === 3) Object.defineProperty(Box.prototype, "area", { get: () => -1, configurable: true });
  else if (mode === 4) Base.prototype.kind = () => "replaced";
  else if (mode === 5) Object.defineProperty(box, "area", { value: -2 });
  else if (mode === 6) Object.freeze(box);
  return 1;
}

function holder(box) {
  const before = box.width + "," + box.height + "," + box.open + "," + box.area + "," + box.kind();
  const got = below(box);
  const read = box.width + "," + box.height + "," + (box.open ? "open" : "shut") + "," + box.area + "," + box.kind();
  let grown;
  try {
    grown = box.grow();
  } catch (error) {
    grown = error.name;
  }
  return before + " " + got + " " + read + " " + grown + " " + box.width;
}

for (let round = 0; round < 700; round++) {
  mode = round % 100 === 99 ? (round + 1) / 100 : 0;
  const line = holder(new Box());
  Object.defineProperty(Box.prototype, "area", area);
  Base.prototype.kind = kind;
  if (mode || round === 0) console.log(round + ": " + line);
}
//// damage-behind-a-call-untyped/closures-that-hold-the-object.js
// No types are written. A factory returns closures over one object. One closure reads it, calls another one that was handed in from outside, and reads it again.
function makeCounter(start) {
  const state = { count: start, step: 1 };
  return {
    state,
    run(between) {
      const before = state.count + state.step;
      between(state);
      state.count += state.step;
      return before + " " + state.count + "," + state.step;
    },
  };
}

const ways = [
  () => {},
  state => delete state.step,
  state => (state.step = "s"),
  state => Object.defineProperty(state, "count", { get: () => -7, set() {} }),
  state => Object.freeze(state),
];

for (let round = 0; round < 500; round++) {
  const way = round % 100 === 99 ? (round + 1) / 100 : 0;
  const counter = makeCounter(round);
  let line;
  try {
    line = counter.run(ways[way % ways.length]);
  } catch (error) {
    line = error.name + " " + counter.state.count;
  }
  if (way || round === 0) console.log(round + ": " + line);
}
