  var before = p.x + p.y;
  var got = below(p);
  p.x = 5;
  p.z = 6;
  var deleted = delete p.y;
  return before + " " + got + " " + p.x + "," + p.y + "," + p.z + "," + deleted + " " + Object.keys(p).join("");
}

