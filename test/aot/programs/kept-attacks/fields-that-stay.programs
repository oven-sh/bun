////: attempt-2
function attempt(label: string, f: () => unknown) {
  try { console.log(label + ":", String(f())); } catch (e) { console.log(label + ":", (e as Error).constructor.name); }
}
////: makers-3
const makers: [string, () => any][] = [
  ["a class instance", () => new Pair()],
  ["a literal", () => { const point: Point = { x: 1 }; return point; }],
  ["what a constructor function makes", () => new (Made as any)()],
];
//// fields-that-stay/docs-stranger.ts
// Fields that stay: docs stranger. It prints what plain Bun prints.
interface Config {
  host: string;
  port: number;
}
class Server {
  config: Config = { host: "localhost", port: 80 };
}

const server = new Server();
server.config = JSON.parse('{"host":"example.com","port":"8080"}');
console.log(server.config.host, server.config.port);
try {
  (server as any).config = "example.com:8080";
} catch (error) {
  console.log(String(error));
}
//// fields-that-stay/docs-works.ts
// Fields that stay: docs works. It prints what plain Bun prints.
class Account {
  id: number = 1;
  owner: string = "ada";
  note?: string = "vip";
}

const account: any = new Account();
console.log(delete account.note);
account.id = null;
account.tags = ["new"];
Object.defineProperty(account, "owner", { value: "grace" });
Object.freeze(account);
console.log(JSON.stringify(account), Object.isFrozen(account));
