function makeContext(seed: number, owner: Owner): Context {
  const context: Context = {
    options: { debug: seed % 2 === 0, model: "m" + seed, tools: ["a", "b"] },
    value1: "s1",
    value2: seed % 2 === 0,
    value4: seed + 4,
    value5: "s5",
    value7: [seed, 7],
    value8: seed + 8,
    value10: seed % 2 === 0,
    value11: [seed, 11],
    value13: "s13",
    value14: seed % 2 === 0,
    value16: seed + 16,
    value17: "s17",
    value19: [seed, 19],
    handler0: input => { sink += Number(input); },
    handler2: input => String(input) + seed,
    handler4: input => Number(input) + seed,
    handler6: input => { sink += Number(input); },
    handler8: input => String(input) + seed,
    handler10: input => Number(input) + seed,
    handler12: input => { sink += Number(input); },
    handler14: input => String(input) + seed,
    handler16: input => Number(input) + seed,
    handler18: input => { sink += Number(input); },
    getState: () => state,
    setState: update => { state = update(state); },
  };
  if (seed % 3 === 0) context.value0 = seed;
  if (seed % 4 === 0) context.handler1 = owner.size.bind(owner);
  if (seed % 5 === 0) context.handler3 = input => { sink += input.length; };
  return context;
}
////: makeCounter
function makeCounter() {
  return class Counter {
    constructor(start) {
      this.value = start;
    }
    add(amount) {
      this.value = (this.value + amount) | 0;
      return this.value;
    }
  };
}
////: readAdded
function readAdded() {
  let sum = 0;
  for (let i = 0; i < rounds; i++) sum = (sum + BelowGains.added + i) | 0;
  return sum;
}
////: readAddedFromLowest
function readAddedFromLowest() {
  let sum = 0;
  for (let i = 0; i < rounds; i++) sum = (sum + LowestGains.added + i) | 0;
  return sum;
}
//// guards-that-fail-once/canary-node-http-server.ts
// Guards that fail once: canary node http server. It prints what plain Bun prints.
import { createServer } from "node:http";
const server = createServer((request, response) => {
  response.writeHead(200, { "Content-Type": "text/plain" });
  response.end(`${request.method} ${request.url}`);
});
server.listen(0, async () => {
  const answer = await fetch(`http://127.0.0.1:${(server.address() as { port: number }).port}/one`);
  console.log(answer.status, answer.headers.get("content-type"), await answer.text());
  server.close();
});
//// guards-that-fail-once/copy-data-properties-bags.ts
// Bags of unlisted names, each of another size, get two more names once.
type Bag = { a?: number; b?: string; c?: boolean };
type Two = { x: number; y: number };
function merge(bag: Bag, two: any): Bag {
  return { ...bag, ...two };
}
function bagOf(size: number): Bag {
  const bag: Bag = { a: size };
  for (let index = 0; index < size; ++index)
    (bag as any)["name" + index] = index;
  return bag;
}
const sizes = Number(process.argv[2] ?? 40);
const rounds = Number(process.argv[3] ?? 1);
let total = 0;
for (let round = 0; round < rounds; ++round) {
  for (let size = 1; size <= sizes; ++size)
    total += Object.keys(merge(bagOf(size), JSON.parse(`{"x":${size},"y":${round}}`))).length;
}
console.log(total);
