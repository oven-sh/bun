//// impostors-arrival-and-time/parts.mjs
// The pieces every generated program is put together from. generate.mjs writes the programs; nothing here is run by the tests.
export const SHOW = `const log = [];

function show(value) {
  if (typeof value === "number") return Object.is(value, -0) ? "-0" : String(value);
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "bigint") return value + "n";
  if (typeof value === "function") return "function";
  if (typeof value !== "object" || value === null) return String(value);
  if (value instanceof Error) return value.constructor.name;
  const parent = Object.getPrototypeOf(value);
  const kind = parent === Object.prototype || parent === Array.prototype ? "" : parent === null ? "bare " : parent.constructor.name + " ";
  const isList = Array.isArray(value);
  const parts = [];
  if (isList) for (let i = 0; i < value.length; i++) parts.push(i in value ? show(value[i]) : "hole");
  for (const key of Reflect.ownKeys(value)) {
    if (isList && typeof key === "string" && (key === "length" || /^\\d+$/.test(key))) continue;
    parts.push(String(key) + ": " + show(value[key]));
  }
  return kind + (isList ? "[" : "{") + parts.join(", ") + (isList ? "]" : "}");
}
`;

export const ATTEMPT = `
function outcome(run) {
  log.length = 0;
  try {
    const value = run();
    const effects = log.join(", ");
    return show(value) + (effects ? " | " + effects : "");
  } catch (error) {
    const effects = log.join(", ");
    return "threw " + show(error) + (effects ? " | " + effects : "");
  }
}

function attempt(label, run) {
  console.log(label + " -> " + outcome(run));
}
`;

export const ATTEMPT_ASYNC = `
async function outcome(run) {
  log.length = 0;
  try {
    const value = await run();
    const effects = log.join(", ");
    return show(value) + (effects ? " | " + effects : "");
  } catch (error) {
    const effects = log.join(", ");
    return "threw " + show(error) + (effects ? " | " + effects : "");
  }
}

async function attempt(label, run) {
  console.log(label + " -> " + (await outcome(run)));
}
`;

export const HELPERS = `
class Odd extends Array {
  push(value) {
    log.push("Odd.push " + value);
    return 42;
  }
  *[Symbol.iterator]() {
    log.push("Odd.iterator");
    yield "odd";
  }
}

function logged(target) {
  return new Proxy(target, {
    get(target, key, receiver) {
      log.push("get " + String(key));
      return Reflect.get(target, key, receiver);
    },
    set(target, key, value, receiver) {
      log.push("set " + String(key));
      return Reflect.set(target, key, value, receiver);
    },
    apply(target, self, list) {
      log.push("apply " + list.length);
      return Reflect.apply(target, self, list);
    },
  });
}
`;

// [label, code that may use the helpers, text that stands alone and uses only \`log\`]
export const values = {
  arrays: [
    ["an array", `[5, 6]`],
    ["a subclass", `Odd.of(5, 6)`, `new (class extends Array { push(value) { log.push('Odd.push ' + value); return 42; } *[Symbol.iterator]() { log.push('Odd.iterator'); yield 'odd'; } })(5, 6)`],
    ["an array-like", `({ 0: 5, length: 7, push(value) { log.push("own push " + value); return "pushed"; }, [Symbol.iterator]() { log.push("own iterator"); return [8, 9][Symbol.iterator](); } })`],
    ["a proxy", `logged([5, 6])`, `new Proxy([5, 6], { get(target, key, receiver) { log.push('get ' + String(key)); return Reflect.get(target, key, receiver); }, set(target, key, value, receiver) { log.push('set ' + String(key)); return Reflect.set(target, key, value, receiver); } })`],
    ["a frozen array", `Object.freeze([5, 6])`],
    ["a string", `"ab"`],
  ],
  strings: [
    ["a string", `"abc"`],
    ["an object with charCodeAt", `({ charCodeAt(index) { log.push("own charCodeAt " + index); return "mine"; } })`],
    ["a String object with its own charCodeAt", `Object.assign(new String("xyz"), { charCodeAt: () => -1 })`],
    ["an array", `["abc"]`],
    ["a number", `65`],
  ],
  numbers: [
    ["an integer", `7`],
    ["a string", `"3"`],
    ["an object with valueOf", `({ valueOf() { log.push("valueOf"); return 2 ** 31 + 0.5; }, toString() { log.push("toString"); return "text"; } })`],
    ["a bigint", `10n`],
    ["the largest int32", `2147483647`],
    ["minus zero", `-0`],
    ["undefined", `undefined`],
  ],
  functions: [
    ["a function", `x => x + 1`, `(x => x + 1)`],
    ["a class", `class Made { constructor(x) { log.push("constructed " + x); } }`, `(class Made { constructor(x) { log.push('constructed ' + x); } })`],
    ["a callable proxy", `logged(x => x + 2)`, `new Proxy(x => x + 2, { apply(target, self, list) { log.push('apply ' + list.length); return Reflect.apply(target, self, list); } })`],
    ["a bound function", `function (a, b) { return [this.tag, a, b]; }.bind({ tag: "bound" }, "first")`, `(function (a, b) { return [this.tag, a, b]; }).bind({ tag: 'bound' }, 'first')`],
    ["an object with call", `({ call() { log.push("call"); return "called"; } })`],
  ],
  objects: [
    ["an object", `({ x: 1, y: 2 })`],
    ["accessors", `({ get x() { log.push("get x"); return 10; }, set x(value) { log.push("set x " + value); }, get y() { log.push("get y"); return 20; } })`],
    ["a proxy", `logged({ y: 2, x: 1 })`, `new Proxy({ y: 2, x: 1 }, { get(target, key, receiver) { log.push('get ' + String(key)); return Reflect.get(target, key, receiver); }, set(target, key, value, receiver) { log.push('set ' + String(key)); return Reflect.set(target, key, value, receiver); } })`],
    ["a frozen object", `Object.freeze({ x: 5, y: 6 })`],
    ["texts in another order", `({ y: "2", x: "1" })`],
    ["inherited members", `Object.create({ x: 3, y: 4 })`],
  ],
};

export const uses = [
  { name: "pushes", kind: "arrays", v: "a", body: ["a.push(1);"], result: "a.length" },
  { name: "iterates", kind: "arrays", v: "a", body: ["const seen = [];", "for (const x of a) seen.push(x);"], result: "seen" },
  { name: "readsCharCode", kind: "strings", v: "s", body: [], result: "s.charCodeAt(0)" },
  { name: "truncates", kind: "numbers", v: "n", body: [], result: "n | 0" },
  { name: "addsOne", kind: "numbers", v: "n", body: [], result: "n + 1" },
  { name: "calls", kind: "functions", v: "f", body: [], result: "f(1)" },
  { name: "addsMembers", kind: "objects", v: "o", body: [], result: "o.x + o.y" },
  { name: "storesMember", kind: "objects", v: "o", body: ["o.x = 1;"], result: "o" },
];

export const kinds = ["arrays", "strings", "numbers", "functions", "objects"];

export const textOf = row => (row[2] ?? row[1]).replace(/"/g, "'");

export function valueTables(extra = {}, only = kinds) {
  let out = "";
  for (const kind of only) {
    out += `\nconst ${kind} = [\n`;
    for (const row of [...values[kind], ...(extra[kind] ?? [])]) out += `  [${JSON.stringify(row[0])}, () => ${row[1]}],\n`;
    out += `];\n`;
  }
  return out;
}

export function textTables(extra = {}, replace = null, only = kinds) {
  let out = "";
  for (const kind of only) {
    out += `\nconst ${kind} = [\n`;
    for (const row of replace ? replace[kind] : [...values[kind], ...(extra[kind] ?? [])]) out += `  [${JSON.stringify(row[0])}, ${JSON.stringify(replace ? row[1] : textOf(row))}],\n`;
    out += `];\n`;
  }
  return out;
}

export const indent = (lines, by) => lines.map(line => " ".repeat(by) + line).join("\n");
export const bodyOf = (u, by) => (u.body.length ? indent(u.body, by) + "\n" : "");
//// impostors-arrival-and-time/plain-bun-what-a-listener-for-unhandled-rejections-resolves-is-never-continued.cjs
// Impostors arrival and time: plain bun what a listener for unhandled rejections resolves is never continued. It prints what plain Bun prints.
async function main() {
  console.log("before");
  const reason = await new Promise(resolve => {
    process.once("unhandledRejection", resolve);
    Promise.reject("the reason");
  });
  console.log("after", reason);
}
main();
