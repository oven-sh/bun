// Impostors narrowing and accessors: wg probes shrink  leaf no function. It prints what plain Bun prints.
////= Leaf-4

const cell = new Cell();
Object.assign(cell, { leaf: null });
console.log(cell.leaf === null ? -1 : cell.leaf.weight);
//// impostors-narrowing-and-accessors/wg-probes-shrink-4-value-read.ts
// Impostors narrowing and accessors: wg probes shrink  value read. It prints what plain Bun prints.
////= lines-42	Cell	value	number	string	1

const cell = new Cell();
Object.assign(cell, { value: "text" });
console.log(typeof cell.value, cell.value);
//// impostors-narrowing-and-accessors/wg-probes-shrink-5-literal-target.ts
// Impostors narrowing and accessors: wg probes shrink  literal target. It prints what plain Bun prints.
type Cell = { leaf: { weight: number } | null };

function make(): Cell {
  return { leaf: { weight: 7 } };
}

////= weigh

const cell = make();
Object.assign(cell, { leaf: null });
console.log(weigh(cell));
//// impostors-narrowing-and-accessors/wg-probes-shrink-6-mode.ts
// Impostors narrowing and accessors: wg probes shrink  mode. It prints what plain Bun prints.
////= lines-42	Switch	mode	"on"	"off"	"on"

function cost(s: Switch): number {
  return s.mode === "on" ? 10 : 20;
}

const s = new Switch();
Object.assign(s, { mode: "off" });
console.log(cost(s), s.mode);
//// impostors-narrowing-and-accessors/wg-probes-shrink-7-undefined.ts
// Impostors narrowing and accessors: wg probes shrink  undefined. It prints what plain Bun prints.
////= Leaf-3

class Cell {
  leaf: Leaf | undefined = new Leaf();
}

function weigh(c: Cell): number {
  return c.leaf === undefined ? -1 : c.leaf.weight;
}

const cell = new Cell();
Object.assign(cell, { leaf: undefined });
console.log(weigh(cell));
//// impostors-narrowing-and-accessors/wg-probes-shrink-8-two-classes.ts
// Impostors narrowing and accessors: wg probes shrink  two classes. It prints what plain Bun prints.
////= lines-23	Shape	sides	4

////= Square-2

class Holder {
  shape: Shape = new Square();
}

function edgeOf(h: Holder): unknown {
  return h.shape instanceof Square ? h.shape.edge : "no square";
}

const holder = new Holder();
Object.assign(holder, { shape: new Shape() });
console.log(edgeOf(holder));
//// impostors-narrowing-and-accessors/wg-probes-shrink-9-source-in-a-variable.ts
// Impostors narrowing and accessors: wg probes shrink  source in a variable. It prints what plain Bun prints.
////= Leaf-6

const cell = new Cell();
const source = { leaf: null };
Object.assign(cell, source);
console.log(weigh(cell));
