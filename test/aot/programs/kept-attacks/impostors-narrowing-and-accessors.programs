//// impostors-narrowing-and-accessors/wg-probes-mark-5-a-private-method.ts
// Impostors narrowing and accessors: wg probes mark  a private method. It prints what plain Bun prints.
////= Returns

class Stamp extends Returns {
  #secret(): number {
    return 7;
  }
  static marked(o: object): boolean {
    return #secret in o;
  }
  static call(o: Stamp): number {
    return o.#secret();
  }
}

////= Circle-2

const circle = new Circle();
const stamped = new Stamp(circle);
console.log(Stamp.marked(circle), Stamp.call(stamped));
//// impostors-narrowing-and-accessors/wg-probes-mark-6-narrowed-read.ts
// Impostors narrowing and accessors: wg probes mark  narrowed read. It prints what plain Bun prints.
////= Returns

class Stamp extends Returns {
  #mark = 1;
  static read(o: object): number {
    return #mark in o ? o.#mark : -1;
  }
}

////= Circle-2

const circle = new Circle();
new Stamp(circle);
console.log(Stamp.read(circle), Stamp.read(new Circle()), Stamp.read(new Stamp({})));
