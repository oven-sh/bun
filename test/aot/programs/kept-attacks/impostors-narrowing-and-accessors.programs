class Returns {
  constructor(o: object) {
    return o;
  }
}
////: Shape-2
class Shape {
  sides = 4;
  isSquare(): this is Square {
    return this instanceof Square;
  }
}
////: Square-2
class Square extends Shape {
  edge = 2;
}
