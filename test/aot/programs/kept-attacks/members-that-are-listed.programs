function join(rounds: number): number {
  let sum = 0;
  for (let i = 0; i < rounds; ++i) sum += path.join("a", "b").length;
  return sum;
}

////= lines-11	dirname	path.dirname	"/a/b"

////= lines-11	basename	path.basename	"/a/b"

////= lines-11	toNamespacedPath	path.toNamespacedPath	"/a"

function held(rounds: number): number {
  const f = path.isAbsolute;
  let sum = 0;
  for (let i = 0; i < rounds; ++i) sum += f("/a") ? 1 : 2;
  return sum;
}

const cases: Record<string, (rounds: number) => number> = { none, isAbsolute, join, dirname, basename, toNamespacedPath, held };
const which = process.argv[2] ?? "none";
const rounds = Number(process.argv[3] ?? 1000);
console.log(which, rounds, cases[which](rounds));
//// members-that-are-listed/stores-two.ts
// One shape with an optional field y, one place that stores y by name. Between two calls of the marker (Date.now): one object is made and one store is done.
// argv[2]: filled (the store replaces) | empty (the store creates).
type Shape = { a: number; y?: number };
const empty = (): Shape => ({ a: 1 });
const filled = (): Shape => ({ a: 1, y: 1 });
function store(object: any, value: number) { object.y = value; }
const make = process.argv[2] === "filled" ? filled : empty;
const rounds = Number(process.argv[3] ?? 200000);
const kept: object[] = [];
for (let i = 0; i < rounds; i++) {
  if (Date.now() === 0) continue;
  const object = make();
  store(object, i);
  kept[i & 7] = object;
}
console.log(process.argv[2], rounds, kept.length);
