//// objects-inside-objects/repo-binds-impostors-servers-and-scripts-bound-methods-are-called-by-timers-promises-and-events.js
// Objects inside objects: repo binds impostors servers and scripts bound methods are called by timers promises and events. It prints what plain Bun prints.
import { EventEmitter } from "node:events";

class Job {
  constructor(name) {
    this.name = name;
    this.runs = 0;
  }
  run(...values) {
    this.runs++;
    console.log(this.name, "ran with", values.length, "values");
    return this.runs;
  }
}

const job = new Job("job");
console.log("called directly", job.run.bind(job)());
[1].forEach(job.run.bind(job));
await Promise.resolve("value").then(job.run.bind(job));
await new Promise(resolve => {
  queueMicrotask(job.run.bind(job));
  process.nextTick(job.run.bind(job));
  setImmediate(job.run.bind(job));
  setTimeout(job.run.bind(job), 1);
  setTimeout(resolve, 20);
});
const emitter = new EventEmitter();
emitter.on("go", job.run.bind(job));
emitter.emit("go", 1, 2);
const target = new EventTarget();
target.addEventListener("go", job.run.bind(job));
target.dispatchEvent(new Event("go"));
const controller = new AbortController();
controller.signal.addEventListener("abort", job.run.bind(job));
controller.abort();
console.log(job.runs);
//// objects-inside-objects/repo-binds-impostors-servers-and-scripts-datagrams-are-sent-and-received.js
// Objects inside objects: repo binds impostors servers and scripts datagrams are sent and received. It prints what plain Bun prints.
import dgram from "node:dgram";

const receiver = dgram.createSocket("udp4");
const got = [];
receiver.on("message", (message, info) => {
  got.push(message.toString() + " from " + info.address + " " + info.family + " " + info.size);
  if (got.length === 2) receiver.close();
});
await new Promise(resolve => receiver.bind(0, "127.0.0.1", resolve));
const { port, address, family } = receiver.address();
console.log(typeof port, address, family);
const sender = dgram.createSocket({ type: "udp4" });
await new Promise(resolve => sender.send("first", port, "127.0.0.1", resolve));
await new Promise(resolve => sender.send([Buffer.from("sec"), "ond"], port, "127.0.0.1", (error, bytes) => resolve(console.log(error, bytes))));
await new Promise(resolve => receiver.on("close", resolve));
sender.close();
console.log(got);
try {
  sender.send("late", port);
} catch (error) {
  console.log(error.code);
}

const heard = Promise.withResolvers();
const bunReceiver = await Bun.udpSocket({ hostname: "127.0.0.1", socket: { data: (socket, data, fromPort, fromAddress) => heard.resolve(data.toString() + " " + fromAddress + " " + (fromPort > 0)) } });
const bunSender = await Bun.udpSocket({ hostname: "127.0.0.1" });
console.log(bunSender.send("through bun", bunReceiver.port, "127.0.0.1"), await heard.promise, bunReceiver.hostname, bunReceiver.closed);
bunReceiver.close();
bunSender.close();
console.log(bunReceiver.closed);
//// objects-inside-objects/repo-binds-impostors-servers-and-scripts-each-request-keeps-its-own-context.js
// Objects inside objects: repo binds impostors servers and scripts each request keeps its own context. It prints what plain Bun prints.
import { AsyncLocalStorage, AsyncResource, executionAsyncId } from "node:async_hooks";
import http from "node:http";

const context = new AsyncLocalStorage();
const lines = [];
const log = message => lines.push((context.getStore()?.id ?? "none") + ": " + message);

async function work(ms) {
  log("work starts");
  await new Promise(resolve => setTimeout(resolve, ms));
  log("after a timer");
  await Promise.all([Promise.resolve().then(() => log("in a reaction")), new Promise(resolve => setImmediate(() => resolve(log("in an immediate"))))]);
  process.nextTick(() => log("in a tick"));
  queueMicrotask(() => log("in a microtask"));
}

const server = http.createServer((request, response) => {
  context.run({ id: request.headers["x-id"] }, async () => {
    await work(Number(request.headers["x-wait"]));
    response.end(context.getStore().id);
  });
});

server.listen(0, "127.0.0.1", async () => {
  const ask = (id, wait) => fetch("http://127.0.0.1:" + server.address().port, { headers: { "x-id": id, "x-wait": String(wait) } }).then(answer => answer.text());
  console.log(await Promise.all([ask("a", 15), ask("b", 5), ask("c", 10)]));
  console.log(lines.filter(line => line.startsWith("a")), lines.filter(line => line.startsWith("b")).length, lines.filter(line => line.startsWith("none")).length);
  server.close();

  console.log(context.getStore(), context.run(1, () => context.run(2, () => context.getStore()) + context.getStore()), context.run("x", (a, b) => a + b + context.getStore(), "p", "q"));
  context.enterWith("entered");
  console.log(context.getStore(), context.exit(() => context.getStore()));
  const bound = context.run("bound", () => AsyncLocalStorage.bind(() => context.getStore()));
  const snapshot = context.run("snapshot", () => AsyncLocalStorage.snapshot());
  console.log(bound(), snapshot(() => context.getStore()), typeof executionAsyncId());
  const resource = context.run("resource", () => new AsyncResource("Job"));
  console.log(resource.runInAsyncScope((a, b) => context.getStore() + a + b, null, 1, 2));
  context.disable();
  console.log(context.getStore());
});
//// objects-inside-objects/repo-binds-impostors-servers-and-scripts-functions-bound-with-arguments-are-the-reactions-of-a-promise.js
// Objects inside objects: repo binds impostors servers and scripts functions bound with arguments are the reactions of a promise. It prints what plain Bun prints.
function succeeded(id, depth, data) {
  console.log("succeeded", this.name, id, depth, data);
}
function failed(id, depth, data) {
  console.log("failed", this.name, id, depth, data.message);
}

const context = { name: "context" };
const later = new Promise(resolve => setTimeout(resolve, 5, "value"));
later.then(succeeded.bind(context, 1, 2), failed.bind(context, 1, 2));
const refused = new Promise((resolve, reject) => setTimeout(reject, 5, new Error("reason")));
refused.then(succeeded.bind(context, 3, 4), failed.bind(context, 3, 4));
Promise.resolve("at once").then(succeeded.bind(context, 5, 6), failed.bind(context, 5, 6));
//// objects-inside-objects/repo-binds-impostors-servers-and-scripts-functions-bound-with-arguments-are-the-reactions-of-a-promise-inside-an-async-context.js
// Objects inside objects: repo binds impostors servers and scripts functions bound with arguments are the reactions of a promise inside an async context. It prints what plain Bun prints.
import { AsyncLocalStorage } from "node:async_hooks";

const storage = new AsyncLocalStorage();

function succeeded(id, depth, data) {
  console.log("succeeded", this.name, id, depth, data, storage.getStore());
}
function failed(id, depth, data) {
  console.log("failed", this.name, id, depth, data.message, storage.getStore());
}

function watch(context, depth, id, current) {
  current.then(succeeded.bind(context, id, depth), failed.bind(context, id, depth));
}

const context = { name: "context" };
storage.run("the store", () => {
  watch(context, 1, 2, new Promise(resolve => setTimeout(resolve, 5, "value")));
  watch(context, 3, 4, new Promise((resolve, reject) => setTimeout(reject, 5, new Error("reason"))));
  watch(context, 5, 6, Promise.resolve("at once"));
  watch(context, 7, 8, (async () => "from an async function")());
});
for (let i = 0; i < 200; i++) watch(context, i, i, Promise.resolve(i % 100 === 0 ? "round " + i : new Promise(() => {})));
//// objects-inside-objects/repo-binds-impostors-servers-and-scripts-functions-bound-with-arguments-are-the-reactions-of-a-promise-of-unknown-type.js
// Objects inside objects: repo binds impostors servers and scripts functions bound with arguments are the reactions of a promise of unknown type. It prints what plain Bun prints.
function succeeded(id, depth, data) {
  console.log("succeeded", this.name, id, depth, data);
}
function failed(id, depth, data) {
  console.log("failed", this.name, id, depth, data.message);
}

function watch(context, depth, id, current) {
  if (typeof current === "object" && current !== null && typeof current.then === "function") {
    current.then(succeeded.bind(context, id, depth), failed.bind(context, id, depth));
    return "watched";
  }
  return typeof current;
}

const context = { name: "context" };
const values = JSON.parse('[1, "two", null, {"then": 3}]');
values.push(
  new Promise(resolve => setTimeout(resolve, 5, "value")),
  new Promise((resolve, reject) => setTimeout(reject, 5, new Error("reason"))),
  Promise.resolve("at once"),
  (async () => "from an async function")(),
  { then: (resolve, reject) => resolve("from a thenable") },
);
values.forEach((value, index) => console.log(index, watch(context, index * 10, index, value)));
