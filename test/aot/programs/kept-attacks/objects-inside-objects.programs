//// objects-inside-objects/repo-binds-impostors-arrays-apply-is-given-lists-that-are-not-arrays.js
// Objects inside objects: repo binds impostors arrays apply is given lists that are not arrays. It prints what plain Bun prints.
////= describe-5

const log = [];

function three(a, b, c) {
  return [arguments.length, a, b, c];
}

function gather(...values) {
  return values;
}

////= lines-41	Point	x	y

const uses = {
  apply: list => three.apply(null, list),
  applyToRest: list => gather.apply(null, list),
  reflectApply: list => Reflect.apply(three, null, list),
  construct: list => Reflect.construct(Point, list),
  largest: list => Math.max.apply(Math, list),
  text: list => String.fromCharCode.apply(String, list),
  pushAll(list) {
    const target = [0];
    return [Array.prototype.push.apply(target, list), target];
  },
  concatAll: list => Array.prototype.concat.apply([], list),
  forwarded(list) {
    function outer() {
      return three.apply(this, arguments);
    }
    return outer.apply(null, list);
  },
  callApply: list => Function.prototype.call.apply(three, list),
  boundApply: list => three.bind(null, "bound").apply(null, list),
  arrowApply: list => ((a, b) => [a, b]).apply(null, list),
};

const makers = {
  "an array": () => [65, 66, 67],
  "an array-like": () => ({ 0: 65, 1: 66, 2: 67, length: 3 }),
  "an array-like that is too short": () => ({ 0: 65, length: 3 }),
  "an array-like with a fractional length": () => ({ 0: 65, 1: 66, 2: 67, length: 1.9 }),
  "an array-like with a text length": () => ({ 0: 65, 1: 66, length: "2" }),
  "an array-like with a negative length": () => ({ 0: 65, length: -1 }),
  "an array-like with a length of NaN": () => ({ 0: 65, length: NaN }),
  "an object without a length": () => ({ 0: 65 }),
  "an array-like with getters": () => ({
    get length() { log.push("length"); return 2; },
    get 0() { log.push("0"); return 65; },
    get 1() { log.push("1"); return 66; },
  }),
  "an array with a hole": () => [65, , 67],
  "a hole over an inherited element": () => Object.setPrototypeOf([65, , 67], { __proto__: Array.prototype, 1: 90 }),
  "an array with a getter": () => Object.defineProperty([65, 66, 67], 1, { get() { log.push("1"); return 90; } }),
  "arguments": () => (function () { return arguments; })(65, 66, 67),
  "a typed array": () => new Uint8Array([65, 66, 67]),
  "doubles": () => [65.5, 66.5, 67.5],
  "a subclass with its own iterator": () => new (class extends Array { *[Symbol.iterator]() { yield "never used"; } })(65, 66, 67),
  "a proxy": () => new Proxy([65, 66], { get(target, key, receiver) { log.push("get " + String(key)); return Reflect.get(target, key, receiver); } }),
  "a String object": () => new String("AB"),
  "a function": () => function (a, b) {},
  "a Set": () => new Set([65]),
  "a string": () => "AB",
  "a number": () => 65,
  "null": () => null,
  "undefined": () => undefined,
  "a symbol": () => Symbol.iterator,
};

for (const use in uses) for (let i = 0; i < 1000; i++) uses[use]([65, 66, 67]);

for (const name in makers) {
  for (const use in uses) {
    log.length = 0;
    attempt(name + ", " + use, () => uses[use](makers[name]()));
    if (log.length) console.log("  log: " + log.join(", "));
  }
}

attempt("a list that is far too long", () => three.apply(null, { length: 2 ** 31 }));
attempt("a long list", () => gather.apply(null, new Array(50000)).length);
attempt("a long list of numbers", () => Math.max.apply(null, Array.from({ length: 50000 }, (_, index) => index)));
//// objects-inside-objects/repo-binds-impostors-arrays-built-ins-call-a-function-with-something-else-than-its-usual-array.js
// Objects inside objects: repo binds impostors arrays built ins call a function with something else than its usual array. It prints what plain Bun prints.
////= describe-5

////= lines-2	total	sum

function walked(list) {
  const seen = [];
  for (const value of list) seen.push(value);
  return seen.join("/");
}

////= lines-5	pushed	list	list.push	9

////= lines-6	doubled

////= Loud

const makers = {
  "an array-like": () => ({ 0: 3, 1: 1, 2: 2, length: 3 }),
  "a subclass": () => Loud.of(3, 1, 2),
  "a string": () => "312",
  "a typed array": () => new Uint8Array([3, 1, 200]),
  "a Set": () => new Set([3, 1, 2]),
  "a proxy": () => new Proxy([3, 1, 2], {}),
  "a frozen array": () => Object.freeze([3, 1, 2]),
  "null": () => null,
  "an array": () => [3, 1, 2],
};

const functions = { total, walked, pushed, doubled };

const routes = {
  "a plain call": (use, value) => use(value),
  "call": (use, value) => use.call(undefined, value),
  "apply": (use, value) => use.apply(undefined, [value]),
  "bind": (use, value) => use.bind(undefined, value)(),
  "bind without arguments": (use, value) => use.bind(undefined)(value),
  "Reflect.apply": (use, value) => Reflect.apply(use, undefined, [value]),
  "forEach": (use, value) => { let answer; [value].forEach(element => { answer = use(element); }); return answer; },
  "forEach with the function itself": (use, value) => { const answers = []; const keep = use; [value].forEach(function (element) { answers.push(keep(element)); }); return answers[0]; },
  "map with the function itself": (use, value) => [value].map(use)[0],
  "Array.from": (use, value) => Array.from([value], use)[0],
  "find": (use, value) => { let answer; [value].find(element => { answer = use(element); return true; }); return answer; },
  "a sort comparator": (use, value) => { let answer; [value, value].sort((a, b) => { answer = use(a); return 0; }); return answer; },
  "a replace callback": (use, value) => { let answer; "x".replace("x", () => { answer = use(value); return ""; }); return answer; },
  "Map.forEach": (use, value) => { let answer; new Map([["key", value]]).forEach(element => { answer = use(element); }); return answer; },
  "Set.forEach": (use, value) => { let answer; new Set([value]).forEach(element => { answer = use(element); }); return answer; },
  "a getter": (use, value) => use({ get list() { return value; } }.list),
  "a proxy's get trap": (use, value) => use(new Proxy({}, { get: () => value }).list),
  "a caught exception": (use, value) => { try { throw value; } catch (list) { return use(list); } },
  "a generator's next": (use, value) => { const steps = (function* () { return use(yield); })(); steps.next(); return steps.next(value).value; },
  "a yielded value": (use, value) => use((function* () { yield value; })().next().value),
  "a spread argument": (use, value) => use(...[value]),
  "a default parameter": (use, value) => ((list = value) => use(list))(),
  "Object.values": (use, value) => use(Object.values({ list: value })[0]),
  "an optional call": (use, value) => use?.(value),
  "a comma expression": (use, value) => (0, use)(value),
  "toJSON": (use, value) => { let answer; JSON.stringify({ toJSON() { answer = use(value); } }); return answer; },
  "a tagged template": (use, value) => ((strings, list) => use(list))`${value}`,
};

for (const name in functions) for (let i = 0; i < 2000; i++) functions[name]([3, 1, 2]);

for (const route in routes) {
  for (const maker in makers) {
    const answers = [];
    for (const name in functions) {
      try {
        answers.push(name + " " + describe(routes[route](functions[name], makers[maker]())));
      } catch (error) {
        answers.push(name + " threw " + error.constructor.name);
      }
    }
    console.log(route + ", " + maker + ": " + answers.join("; "));
  }
}
