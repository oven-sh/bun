//// objects-inside-objects/binds-typed-arguments-wider-than-the-parameters.ts
// The shape of a store hook in a typed renderer: the bound arguments are typed wider than the parameters of the function that is bound.
interface Fiber { flags: number; id: number }
interface Inst { value: unknown; getSnapshot: () => unknown }
type Subscribe = (listener: () => void) => () => void;
let currentFiber: Fiber | null = null;
let rerenders = 0;
function changed(inst: Inst): boolean { return inst.getSnapshot() !== inst.value; }
function rerender(fiber: Fiber): void { rerenders += fiber.id; }
function subscribeToStore(fiber: Fiber, inst: Inst, subscribe: Subscribe): () => void { return subscribe(function () { if (changed(inst)) rerender(fiber); }); }
function updateStoreInstance(fiber: Fiber, inst: Inst, nextSnapshot: unknown, getSnapshot: () => unknown): void { inst.value = nextSnapshot; inst.getSnapshot = getSnapshot; if (changed(inst)) rerender(fiber); }
const effects: (() => unknown)[] = [];
function pushEffect(create: () => unknown): void { if (effects.length < 64) effects.push(create); else effects[(effects.length + rerenders) & 63] = create; }
////= update
let state = 0;
const listeners: (() => void)[] = [];
const subscribe: Subscribe = listener => { listeners.push(listener); return () => { listeners.pop(); }; };
let sum = 0;
////= for-10
console.log(sum, rerenders, effects.length);
//// objects-inside-objects/binds-unseen-text-changes-the-function-that-is-bound.js
// Text that the compiler has not seen gives a function a name, a length and a bind of its own. Every bind behind that has to see them.
function add(a, b, c) { return a + b + c; }
function scale(a, b) { return a * b; }
function report(label, f) { console.log(label, typeof f, f.name, f.length, f(1, 2)); }
report("before", add.bind(null, 10));
report("before", scale.bind(null, 10));
const rename = Function("f", process.argv[7] ?? "Object.defineProperty(f, 'name', { value: 'renamed' }); Object.defineProperty(f, 'length', { value: 7 });");
const hijack = Function("f", process.argv[8] ?? "f.bind = function () { return function hijacked() { return 'hijacked'; }; };");
const reparent = Function("f", process.argv[9] ?? "Object.setPrototypeOf(f, { bind() { return function fromOtherPrototype() { return 'other prototype'; }; } });");
for (let round = 0; round < 3; round++) {
  if (round === 1) { rename(add); hijack(scale); }
  if (round === 2) reparent(add);
  report("round " + round, add.bind(null, 10));
  report("round " + round, scale.bind(null, 10));
}
//// objects-inside-objects/binds-which-binds-fire.js
// Objects inside objects: binds which binds fire. It prints what plain Bun prints.
const N = 20000, kept = [];
const only = process.env.WAYS_ONLY;
function readsTwo(a, b) { return a.v + b.v; }
function readsThree(a, b, c) { return a.v + b.v + c.v; }
function readsFive(a, b, c, d, e) { return a.v + b.v + c.v + d.v + (e ? e.v : 0); }
function sometimesConstructed(a, b) { if (new.target) { this.sum = a.v + b.v; return; } return a.v + b.v; }
function Holder(a, b) { this.a = a; this.b = b; }
function takesNumber(a, n) { return a.v + n; }
function takesCallback(a, f) { return f(a); }
const ways = {
  oneObject: o => readsTwo.bind(null, o),
  threeObjects: o => readsThree.bind(null, o, o, o),
  fourObjects: o => readsFive.bind(null, o, o, o, o),
  constructedNowAndThen: o => sometimesConstructed.bind(null, o),
  constructorFunction: o => Holder.bind(null, o),
  objectAndNumber: (o, i) => takesNumber.bind(null, o, i),
  objectAndFunction: o => takesCallback.bind(null, o, x => x.v),
};
let sum = 0;
for (const name in ways) {
  if (only && only !== name) continue;
  const way = ways[name];
  for (let i = 0; i < N; i++) {
    const o = { v: i };
    const f = way(o, i);
    if ((i & 1023) === 0) {
      kept.push(f);
      if (name === "constructedNowAndThen") sum += new f(o).sum + f(o);
      else if (name === "constructorFunction") { const h = new f(o); sum += h.a.v + h.b.v + (h instanceof Holder ? 1 : 0) + (h instanceof f ? 1 : 0); }
      else sum += f(o, o) | 0;
    }
  }
}
console.log(sum, kept.length);
//// objects-inside-objects/class-defined-behind-the-child.ts
// The object that a field initializer of a class names is made before the class is defined. Whoever lays the two objects into one cell would need the class at the birth of the first.
interface Like { size: number }
class Part implements Like { size = 1; grow() { this.size++; return this; } }
const part = new Part();
const lines: string[] = [];
{
  class Holder { #held: Like = part; label = "h"; get held() { return this.#held; } }
  const holder = new Holder();
  lines.push(holder.held === part ? "same" : "other", String(holder.held.size), holder.label, Holder.name, String(Object.getPrototypeOf(holder) === Holder.prototype));
}
const literal = { size: 7 };
{
  class Wrapper { inner: Like; constructor(inner: Like) { this.inner = inner; } }
  const wrapper = new Wrapper(literal);
  lines.push(String(wrapper.inner === literal), String(wrapper instanceof Wrapper), String(wrapper.inner.size));
}
function later(): string {
  const made = new Part().grow();
  class Local { kept = made; }
  const local = new Local();
  return String(local.kept === made) + local.kept.size + Local.name + (local instanceof Local);
}
lines.push(later(), later());
console.log(lines.join(" "));
