const first = ByGetter.prototype.lazy;
console.log("a lazy getter:", first, e.read(), e.lazy, own(e), new ByGetter(2).lazy, Object.hasOwn(ByGetter.prototype, "memo"));
const second = Reflect.get(f, "lazy", ByReceiver.prototype);
