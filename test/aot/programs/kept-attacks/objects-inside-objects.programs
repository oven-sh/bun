////: routes
const routes = {
  call: (method, receiver) => method.call(receiver, 9),
  apply: (method, receiver) => method.apply(receiver, [9]),
  bind: (method, receiver) => method.bind(receiver)(9),
  reflect: (method, receiver) => Reflect.apply(method, receiver, [9]),
};
////: run
function run(callee, value) {
  return callee(value);
}
////: show-2
function show(value) {
  if (typeof value === "number") return Object.is(value, -0) ? "-0" : String(value);
  if (typeof value === "bigint") return value + "n";
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "symbol") return value.toString();
  if (typeof value === "function") return "function";
  if (typeof value !== "object" || value === null) return String(value);
  if (Array.isArray(value)) {
    const parts = [];
    for (let i = 0; i < value.length; i++) parts.push(i in value ? show(value[i]) : "<hole>");
    return "[" + parts.join(", ") + "]";
  }
  if (Object.getPrototypeOf(value) !== Object.prototype) return Object.prototype.toString.call(value);
  return "{" + Object.keys(value).map(key => key + ": " + show(value[key])).join(", ") + "}";
}
////: sum-2
function sum(head: Outer | null): number {
  let total = 0;
  for (let p = head; p; p = p.next) «1»
  return total;
}
////: update
function update(subscribe: Subscribe, getSnapshot: () => unknown, inst: Inst): unknown {
  const fiber = currentFiber as Fiber;
  const next = getSnapshot();
  pushEffect(subscribeToStore.bind(null, fiber, inst, subscribe));
  if (inst.getSnapshot !== getSnapshot || (fiber.flags & 1)) { fiber.flags |= 2048; pushEffect(updateStoreInstance.bind(null, fiber, inst, next, getSnapshot)); }
  return next;
}
////: work
function work(round: number): void {
  for (let i = 0; i < N; i++) {
    const o = all[i];
    if (!o) continue;
    const m = o.p;
    sum += m.a.b + (m.a.r ? m.a.r.v : 0) + m.n + o.k;
    const what = (i + round) % 5;
    if (what === 0) sum += 1;
    else if (what === 1) m.a = { b: -i, r: leaf(-i), s: null };      // the room is filled again
    else if (what === 2) m.a.r = null;
    else if (what === 3) { all[i] = (i & 63) ? o : null; sum += garbage(4); sum += m.a.b + (m.a.s ? m.a.s.v : 1); }   // nothing else may name the outer ones while the collector runs
  }
}
