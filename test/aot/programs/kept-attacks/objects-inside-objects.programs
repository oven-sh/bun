//// objects-inside-objects/repo-binds-impostors-int32-slots-a-closure-stores-the-number-it-captured-and-hidden-callers-hand-it-other-numbers.ts
// Every call of these functions that the build can see hands over a small integer, which a closure captures and stores into a number field later.
// Five callers that it cannot see, through call, apply, Reflect.apply, bind and a function kept on the global object, hand over fractions, -0, NaN, infinities and integers outside int32.
const unknownCodeRuns = process.argv.length > 99;
////= handOver
////= odd
////= exact
class ByCall { level = 0; tail = "t"; }
class ByApply { level = 0; tail = "t"; }
class ByReflect { level = 0; tail = "t"; }
class ByBind { level = 0; tail = "t"; }
class ByGlobal { level = 0; tail = "t"; }
////= lines-26	viaCall	ByCall
////= lines-26	viaApply	ByApply
////= lines-26	viaReflect	ByReflect
////= lines-26	viaBind	ByBind
////= lines-26	viaGlobal	ByGlobal
(globalThis as any).kept = viaGlobal;
type Gauge = { level: number; tail: string };
function use(gauge: Gauge) {
  return `${exact(gauge.level)} ${exact(gauge.level + 1)} ${exact(gauge.level * 2)} ${gauge.level | 0} ${exact(1 / gauge.level)} ${gauge.level === gauge.level} ${JSON.stringify(gauge)} [${Object.keys(gauge)}]`;
}
const routes: [string, () => Gauge, (gauge: any, level: number) => () => void, (gauge: any, level: number) => () => void][] = [
  ["call", () => new ByCall(), viaCall, (gauge, level) => viaCall.call(undefined, gauge, level)],
  ["apply", () => new ByApply(), viaApply, (gauge, level) => viaApply.apply(undefined, [gauge, level])],
  ["Reflect.apply", () => new ByReflect(), viaReflect, (gauge, level) => Reflect.apply(viaReflect, undefined, [gauge, level])],
  ["bind", () => new ByBind(), viaBind, (gauge, level) => viaBind.bind(undefined, gauge)(level)],
  ["a global", () => new ByGlobal(), viaGlobal, (gauge, level) => (globalThis as any).kept(gauge, level)],
];
let sum = 0;
for (let i = 0; i < 2000; i++) {
  const a = new ByCall(), b = new ByApply(), c = new ByReflect(), d = new ByBind(), e = new ByGlobal();
  handOver(a); handOver(b); handOver(c); handOver(d); handOver(e);
  viaCall(a, i & 255)();
  viaApply(b, i & 255)();
  viaReflect(c, i & 255)();
  viaBind(d, i & 255)();
  viaGlobal(e, i & 255)();
  sum += a.level + b.level + c.level + d.level + e.level;
}
console.log("warm", sum);
for (const [label, make, , hidden] of routes) {
  for (const value of odd) {
    const gauge = make();
    handOver(gauge);
    hidden(gauge, value)();
    const stored = use(gauge);
    hidden(gauge, 7)();
    console.log(`${label} ${exact(value)}: ${Object.is(gauge.level, 7)} | ${stored}`);
  }
}
//// objects-inside-objects/repo-binds-impostors-int32-slots-constructors-get-their-numbers-from-callers-that-the-build-cannot-see.ts
// `new Point(3, 4)` wherever the build looks: the constructor's parameters, a parameter property and a field initializer that uses a parameter all look like small integers, and the new object can be born with them in its slots.
// Hidden constructions bring the other numbers: Reflect.construct, a bound constructor, the class kept on the global object, a subclass made from text at run time, and a constructor function run by call.
const unknownCodeRuns = process.argv.length > 99;
////= handOver
////= odd
////= exact
class Point {
  x: number;
  y: number;
  sum: number;
  constructor(x: number, y: number) {
    this.x = x;
    this.y = y;
    this.sum = x + y;
  }
}
class Sized {
  twice: number;
  constructor(public size: number) {
    this.twice = size + size;
  }
}
class Initialized {
  base: number;
  next = 0;
  constructor(base: number) {
    this.base = base;
    this.next = this.base + 1;
  }
}
interface Old { a: number; b: number }
function Old(this: Old, a: number) {
  this.a = a;
  this.b = a - 1;
}
const OldClass = Old as unknown as new (a: number) => Old;
function show(object: object) {
  return `${Object.values(object).map(exact).join(",")} ${JSON.stringify(object)} [${Object.keys(object)}]`;
}
function usePoint(point: Point) {
  return `${exact(point.x + point.y)} ${exact(point.sum - point.x)} ${exact(point.x * 1)}`;
}
let sum = 0;
for (let i = 0; i < 2000; i++) {
  const p = new Point(i & 31, 3), s = new Sized(i & 31), n = new Initialized(i & 31), o = new OldClass(i & 31);
  handOver(p); handOver(s); handOver(n); handOver(o);
  sum += p.sum + s.twice + n.next + o.b;
}
console.log("warm", sum);
(globalThis as any).KeptPoint = Point;
const Heir = new Function("Base", JSON.parse('["return class Heir extends Base"," { constructor(v) { super(v, v) } }"]').join("")) (Point) as new (v: number) => Point;
for (const value of odd) {
  const made: [string, object][] = [
    ["Reflect.construct", Reflect.construct(Point, [value, 1])],
    ["bound", new (Point.bind(undefined, 1))(value)],
    ["a global", new (globalThis as any).KeptPoint(value, value)],
    ["an heir from text", new Heir(value)],
    ["a parameter property", Reflect.construct(Sized, [value])],
    ["an initializer", Reflect.construct(Initialized, [value])],
    ["a constructor function", Reflect.construct(OldClass, [value])],
    ["a constructor function by call", (() => { const bare = Object.create(Old.prototype); Old.call(bare, value); return bare; })()],
  ];
  console.log(exact(value) + ":");
  for (const [label, object] of made) console.log(`  ${label}: ${show(object)}${object instanceof Point ? " " + usePoint(object) : ""}`);
}
console.log("ordinary ones afterwards:", show(new Point(1, 2)), show(new Sized(3)), show(new Initialized(4)), show(new OldClass(5)));
//// objects-inside-objects/repo-binds-impostors-int32-slots-nested-closures-methods-and-suspended-functions-store-what-they-captured.ts
// The captured number goes a longer way before it is stored: through two nested closures, a method of an object literal, an arrow function in a class field,
// a default value of a parameter, a generator and an async function. In sight there are only small integers; a hidden caller of each maker brings the other numbers.
const unknownCodeRuns = process.argv.length > 99;
////= handOver
////= odd
////= exact
class Cell { n = 0; }
function nested(cell: Cell, n: number) {
  return () => () => { cell.n = n; };
}
function method(cell: Cell, n: number) {
  return { run() { cell.n = n; } };
}
class Holder {
  constructor(public cell: Cell, private n: number) {}
  run = () => { this.cell.n = this.n; };
}
function byDefault(cell: Cell, n: number) {
  return (value = n) => { cell.n = value; };
}
function* generated(cell: Cell, n: number) {
  yield 1;
  cell.n = n;
}
async function awaited(cell: Cell, n: number) {
  await null;
  cell.n = n;
}
function fresh() {
  const cell = new Cell();
  handOver(cell);
  return cell;
}
const ways: [string, (cell: Cell, n: number) => unknown, (cell: Cell, n: number) => unknown][] = [
  ["nested", (cell, n) => nested(cell, n)()(), (cell, n) => nested.call(undefined, cell, n)()()],
  ["a method", (cell, n) => method(cell, n).run(), (cell, n) => method.apply(undefined, [cell, n]).run()],
  ["a class field", (cell, n) => new Holder(cell, n).run(), (cell, n) => Reflect.construct(Holder, [cell, n]).run()],
  ["a default", (cell, n) => byDefault(cell, n)(), (cell, n) => byDefault.bind(undefined, cell)(n)()],
  ["a generator", (cell, n) => [...generated(cell, n)], (cell, n) => [...Reflect.apply(generated, undefined, [cell, n])]],
  ["an async function", (cell, n) => awaited(cell, n), (cell, n) => awaited.call(undefined, cell, n)],
];
let sum = 0;
for (let i = 0; i < 1000; i++) {
  for (const [, seen] of ways) {
    const cell = fresh();
    await seen(cell, i & 127);
    sum += cell.n;
  }
}
console.log("warm", sum);
for (const [label, , hidden] of ways) {
  const line: string[] = [];
  for (const value of odd) {
    const cell = fresh();
    await hidden(cell, value);
    line.push(`${exact(cell.n)}${Object.is(cell.n, value) ? "" : " WRONG, wanted " + exact(value)} ${exact(cell.n - 1)} ${JSON.stringify(cell)}`);
  }
  console.log(label + ":", line.join(" | "));
}
//// objects-inside-objects/repo-binds-impostors-numbers-constructors-that-only-see-integer-arguments-are-called-out-of-sight.js
// Objects inside objects: repo binds impostors numbers constructors that only see integer arguments are called out of sight. It prints what plain Bun prints.
////= show-2

////= outcome

function attempt(label, run) {
  console.log(label, "->", outcome(run));
}

class Point {
  constructor(x, y) {
    this.x = x;
    this.y = y;
  }
  sum() {
    return this.x + this.y;
  }
  cell() {
    return [this.x | 0, this.y & 15];
  }
  moved() {
    this.x++;
    this.y -= 1;
    return [this.x, this.y];
  }
}

////= lines-41	Size	width	height
Size.prototype.area = function () {
  return this.width * this.height;
};
Size.prototype.grown = function () {
  this.width += 1;
  return [this.width, this.height];
};

function makePair(first, second) {
  return { first, second };
}

function pairSum(pair) {
  return [pair.first + pair.second, pair.first | 0, pair.second * 2];
}

let total = 0;
for (let i = 0; i < 2000; i++) {
  const point = new Point(i, 1);
  const size = new Size(i, 2);
  total += point.sum() + point.cell()[0] + point.moved()[0] + size.area() + size.grown()[0] + pairSum(makePair(i, 3))[0];
}
console.log("the honest total", total);

const construct = new Function("constructor", "a", "b", "return new constructor(a, b);");
const call = new Function("callee", "a", "b", "return callee(a, b);");
const late = JSON.parse('["3", "", 0.5, -0, null, true, 2147483647, 2147483648, -2147483647, [3], {}]').concat([undefined, NaN, 3n]);

function describePoint(point) {
  return [point.x, point.y, outcome(() => point.sum()), outcome(() => point.cell()), outcome(() => point.moved()), Object.keys(point)];
}

function describeSize(size) {
  return [size.width, size.height, outcome(() => size.area()), outcome(() => size.grown())];
}

for (const value of late) {
  const label = show(value);
  attempt("run-time text makes a Point of " + label, () => describePoint(construct(Point, value, 1)));
  attempt("run-time text makes a Point with a second " + label, () => describePoint(construct(Point, 1, value)));
  attempt("Reflect.construct makes a Point of " + label, () => describePoint(Reflect.construct(Point, [value, value])));
  attempt("a bound constructor makes a Point of " + label, () => describePoint(new (Point.bind(null, ...[value]))(1)));
  attempt("run-time text makes a Size of " + label, () => describeSize(construct(Size, value, 2)));
  attempt("apply fills a Size with " + label, () => {
    const size = Object.create(Size.prototype);
    Size.apply(size, [value, 2]);
    return describeSize(size);
  });
  attempt("run-time text makes a pair of " + label, () => pairSum(call(makePair, value, 3)));
  attempt("map makes pairs of " + label, () => [value].map(makePair).map(pairSum));
}
attempt("run-time text leaves out the arguments", () => describePoint(construct(Point)));
attempt("honest objects afterwards", () => [describePoint(new Point(1, 2)), describeSize(new Size(3, 4)), pairSum(makePair(1, 2))]);
//// objects-inside-objects/repo-binds-impostors-numbers-honest-plain-callers-and-impostors-through-call-apply-and-bind.js
// Objects inside objects: repo binds impostors numbers honest plain callers and impostors through call apply and bind. It prints what plain Bun prints.
////= show-2

////= outcome

function attempt(label, run) {
  console.log(label, "->", outcome(run));
}

function add(a, b) {
  return a + b;
}

function scale(value, factor) {
  return value * factor;
}

function bucket(value) {
  return value & 15;
}

function next(value) {
  return value + 1;
}

function clamp(value, low, high) {
  return value < low ? low : value > high ? high : value;
}

function average(list) {
  let total = 0;
  for (let i = 0; i < list.length; i++) total += list[i];
  return total / list.length;
}

function power(base, exponent) {
  if (exponent === 0) return 1;
  return base * power(base, exponent - 1);
}

function digits(value) {
  let count = 0;
  try {
    do {
      count++;
      value = (value / 10) | 0;
    } while (value > 0);
  } finally {
    count += 0;
  }
  return count;
}

let total = 0;
for (let i = 0; i < 2000; i++) total += add(i, 1) + scale(i, 2) + bucket(i) + next(i) + clamp(i, 0, 10) + average([i, i]) + power(2, i & 7) + digits(i);
console.log("the honest total", total);

attempt("add.call(null, '1', 2)", () => add.call(null, "1", 2));
attempt("add.apply(null, ['1', 2])", () => add.apply(null, ["1", 2]));
attempt("add.bind(null, '1')(2)", () => add.bind(null, "1")(2));
attempt("add.bind(null, 1)('2')", () => add.bind(null, 1)("2"));
attempt("add.apply(null, an array-like)", () => add.apply(null, { length: 2, 0: 1.5, 1: "x" }));
attempt("add.apply(null, [])", () => add.apply(null, []));
attempt("Reflect.apply(add, null, [1n, 2n])", () => Reflect.apply(add, null, [1n, 2n]));
attempt("Function.prototype.call.call(add, null, '1', 2)", () => Function.prototype.call.call(add, null, "1", 2));
attempt("add(...['1', 2])", () => add(...["1", 2]));
attempt("add(...'12')", () => add(..."12"));
attempt("scale.call(null, '3', '4')", () => scale.call(null, "3", "4"));
attempt("scale.apply(null, [0, -1])", () => scale.apply(null, [0, -1]));
attempt("scale.bind(null, 65536)(65536)", () => scale.bind(null, 65536)(65536));
attempt("bucket.call(null, '300')", () => bucket.call(null, "300"));
attempt("bucket.apply(null, [4294967297])", () => bucket.apply(null, [4294967297]));
attempt("bucket.bind(null, 300n)()", () => bucket.bind(null, 300n)());
attempt("next.call(null, '41')", () => next.call(null, "41"));
attempt("next.apply(null, [2147483647])", () => next.apply(null, [2147483647]));
attempt("next.bind(null)()", () => next.bind(null)());
