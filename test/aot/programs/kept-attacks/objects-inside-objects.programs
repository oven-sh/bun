// Long-lived objects that are born with a short array in a field: what the collector pays for them, beside what the births cost.
interface Node3 { id: number; items: number[]; next: Node3 | null }
class Bag { id: number; items: number[]; next: Bag | null; constructor(id: number, next: Bag | null) { this.id = id; this.items = []; this.next = next; } }
function make(n: number): Node3 | null {
  let head: Node3 | null = null;
  for (let i = 0; i < n; i++) head = { id: i, items: [i, i + 1, i + 2], next: head };
  return head;
}
function makeBags(n: number): Bag | null {
  let head: Bag | null = null;
  for (let i = 0; i < n; i++) { head = new Bag(i, head); if ((i & 3) === 0) head.items.push(i); }
  return head;
}
function sum(head: Node3 | null): number {
  let total = 0;
  for (let p = head; p; p = p.next) total += p.items[0] + p.items[2] + p.items.length + p.id;
  return total;
}
function sumBags(head: Bag | null): number {
  let total = 0;
  for (let p = head; p; p = p.next) total += p.items.length + p.id;
  return total;
}
let answer = 0;
const kept = make(1000000);
const keptBags = makeBags(1000000);
for (let round = 0; round < 20; round++) answer += sum(kept) + sumBags(keptBags);
for (let round = 0; round < 20; round++) answer += sum(make(100000)) + sumBags(makeBags(100000));
console.log(answer);
//// objects-inside-objects/kept-cellmates.ts
// A model of long-lived pairs, with the outer object made first and out in the world before the inner one is made and stored: 2 M kept pairs, 4 M short-lived ones.
interface Inner { d: number; e: number }
interface Outer { b: number; c: Inner | undefined; next: Outer | null }
let last: Outer | null = null
function make(n: number): Outer | null {
  let head: Outer | null = null;
  for (let i = 0; i < n; i++) {
    const outer: Outer = { b: i, c: undefined, next: head };
    last = outer;
    outer.c = { d: i * 2, e: i * 3 };
    head = outer;
  }
  return head;
}
////= sum-2	total += p.c!.d + p.c!.e + p.b;
function bump(head: Outer | null): void {
  for (let p = head; p; p = p.next) { p.c!.d += 1; p.c!.e += 2; }
}
let answer = 0;
const kept = make(2000000);
for (let round = 0; round < 20; round++) { bump(kept); answer += sum(kept); }
for (let round = 0; round < 20; round++) answer += sum(make(200000));
console.log(answer, last !== null);
//// objects-inside-objects/kept-pairs.ts
// Objects inside objects: kept pairs. It prints what plain Bun prints.
interface Inner { d: number; e: number }
interface Outer { b: number; c: Inner; next: Outer | null }
function make(n: number): Outer | null {
  let head: Outer | null = null;
  for (let i = 0; i < n; i++) head = { b: i, c: { d: i * 2, e: i * 3 }, next: head };
  return head;
}
////= sum-2	total += p.c.d + p.c.e + p.b;
function bump(head: Outer | null): void {
  for (let p = head; p; p = p.next) { p.c.d += 1; p.c.e += 2; }
}
let answer = 0;
const kept = make(2000000);
for (let round = 0; round < 20; round++) { bump(kept); answer += sum(kept); }
for (let round = 0; round < 20; round++) answer += sum(make(200000));
console.log(answer);
//// objects-inside-objects/kept-pairs-held.ts
// Objects inside objects: kept pairs held. It prints what plain Bun prints.
interface Inner { d: number; e: number }
interface Outer { b: number; c: Inner; next: Outer | null }
const held: Inner[] = [];
function make(n: number): Outer | null {
  let head: Outer | null = null;
  for (let i = 0; i < n; i++) head = { b: i, c: { d: i * 2, e: i * 3 }, next: head };
  return head;
}
////= sum-2	{ total += p.c.d + p.c.e + p.b; if (p.b === 123456) held.push(p.c); }
function bump(head: Outer | null): void {
  for (let p = head; p; p = p.next) { p.c.d += 1; p.c.e += 2; }
}
let answer = 0;
const kept = make(2000000);
for (let round = 0; round < 20; round++) { bump(kept); answer += sum(kept); }
for (let round = 0; round < 20; round++) answer += sum(make(200000));
console.log(answer, held.length, held[0] === held[1], held[0].d);
//// objects-inside-objects/klass.ts
// Objects inside objects, one probe of many. It prints what plain Bun prints.
class Vec { x: number; y: number; constructor(x: number, y: number) { this.x = x; this.y = y; } len() { return this.x * this.x + this.y * this.y; } }
class Body { id: number; pos: Vec; name: string; constructor(i: number) { this.id = i; this.pos = new Vec(i, i + 1); this.name = "b" + i; } move(d: number) { this.pos.x += d; return this; } }
class Sub extends Body { extra: number; constructor(i: number) { super(i); this.extra = i * 2; } }
const all: Body[] = [];
for (let i = 0; i < 5000; i++) all.push(i % 4 ? new Body(i) : new Sub(i));
const positions = all.map(b => b.pos);
Bun.gc(true);
let s = 0;
for (let i = 0; i < all.length; i++) { all[i].move(1); s += positions[i].len() + (positions[i] === all[i].pos ? 1 : 0) + (all[i].pos instanceof Vec ? 1 : 0) + all[i].name.length; }
console.log(s, all[0] instanceof Sub, (all[0] as Sub).extra, JSON.stringify(all[3]));
all.length = 0; Bun.gc(true);
let t = 0; for (const p of positions) t += p.x + p.y;
console.log(t);
//// objects-inside-objects/outer-born-behind-a-collection.ts
// Between the birth of the inner object and that of the outer one a full collection runs, while the inner object is already kept. So the cell is old and marked when the outer object is filled
// with young strings, and only collections of the young follow.
import { edenGC, fullGC } from "bun:jsc";
interface Inner { d: number }
interface Outer { first: string; c: Inner; second: string }
const keptInner: Inner[] = [];
const keptOuter: Outer[] = [];
const ring: string[] = new Array(512).fill("");
function garbage(n: number): number { let x = 0; for (let i = 0; i < n; i++) { const s = "g" + i + "-" + n; ring[i & 511] = s; x += s.length; } return x; }
function make(i: number, depth: number): Outer {
  if (depth > 0) return make(i, depth - 1);
  const c: Inner = { d: i };
  keptInner.push(c);
  fullGC();
  return { first: "a" + i + "-" + depth, c, second: "b" + i + "-" + depth };
}
function batch(from: number): void { for (let i = from; i < from + 4; i++) keptOuter.push(make(i, 3)); }
let g = 0;
for (let i = 0; i < 100; i += 4) {
  batch(i);
  edenGC(); g += garbage(20000); edenGC(); g += garbage(20000);
}
let bad = "";
for (let i = 0; i < keptOuter.length; i++) {
  const o = keptOuter[i];
  if (o.first !== "a" + i + "-0" || o.second !== "b" + i + "-0" || o.c !== keptInner[i] || o.c.d !== i) { bad = "WRONG at " + i + ": " + o.first + " " + o.second; break; }
}
console.log(keptOuter.length, g, bad);
