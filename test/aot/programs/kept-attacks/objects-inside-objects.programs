    const say = (what: string, f: () => unknown): void => { let r: string; try { r = String(f()); } catch (e: any) { r = "throws " + e.constructor.name; } console.log(name + " " + what + ": " + r); };
    say("typeof", () => typeof b); say("name", () => b.name); say("length", () => b.length);
