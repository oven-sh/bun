// Objects inside objects: repo binds typed objects detached methods program. It prints what plain Bun prints.
////= Counter
class FastCounter extends Counter {
  override step = 10
  override describe(prefix: string): string { return "fast " + super.describe(prefix) }
}
class Meter { step = 3; label = "m"; count = 100; bump(): number { return -1 } }
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
function show(o: object): string { return Object.keys(o).join() + JSON.stringify(o) }
const c = new Counter(), other = new Counter(), fast = new FastCounter(), meter = new Meter()
const bump = c.bump, describe = c.describe, fastDescribe = fast.describe

console.log(attempt(() => bump()), attempt(() => describe("x")), attempt(() => (0, c.bump)()), attempt(() => (c.bump)()), c.count)
console.log(bump.call(other), bump.call(other), other.count, c.count, bump.call(fast), fast.count, meter.bump(), meter.count, describe.call(fast, "f"), fastDescribe.call(fast, "f"), fastDescribe.call(new FastCounter(), "n"))
// `this` of a method is not tested: a Counter runs the method of FastCounter.
console.log(fastDescribe.call(new Counter(), "c"))

console.log(attempt(() => bump.call(Object.freeze(new Counter()))), attempt(() => bump.call(Object.seal(new Counter()))), attempt(() => bump.call(Object.preventExtensions(new Counter()))))

// Accessors taken from the prototype.
const double = Object.getOwnPropertyDescriptor(Counter.prototype, "double") as { get(this: unknown): number; set(this: unknown, v: number): void }
double.set.call(other, 9); double.set.call(fast, 5)
console.log(double.get.call(other), other.double, double.get.call(fast), fast.count, attempt(() => double.get.call(undefined)), Reflect.get(c, "double", other), Reflect.set(c, "double", 50, fast), fast.count, c.count)

// bind, apply, Reflect.apply, callbacks with and without a `this` argument.
const boundToOther = c.bump.bind(other), boundTwice = boundToOther.bind(fast)
console.log(boundToOther(), boundToOther.call(fast), boundTwice(), other.count, fast.count, bump.apply(fast), bump.apply(fast, []), Reflect.apply(bump, other, []), Reflect.apply(describe, fast, ["r"]))
console.log(attempt(() => ["a", "b"].map(c.describe).join()), ["a", "b"].map(c.describe, c).join(), ["a", "b"].map(c.describe, fast).join(), ["a", "b"].map(fast.describe, fast).join(), ["a"].map(p => c.describe(p)).join())
const handlers: (() => number)[] = [c.bump, c.bump.bind(c), () => c.bump(), other.bump.bind(fast)]
console.log(handlers.map(h => attempt(h)).join(), c.count, fast.count)

// Functions with a declared `this` shared by several shapes.
function area(this: { w: number; h: number }): number { return this.w * this.h }
class Sheet { w = 2; h = 3; area = area }
const boxes = [{ w: 4, h: 5, area }, { h: 0.5, area, w: 6 }, new Sheet()]
console.log(boxes.map(b => b.area()).join(), area.call({ w: 1, h: 1 }), attempt(() => (area as any)()), attempt(() => { const f = boxes[0].area as () => number; return f() }))

// Statics, private names and arrow fields.
const note = Counter.note
console.log(Counter.note(), FastCounter.note(), Object.hasOwn(FastCounter, "tally"), Counter.tally, FastCounter.tally, attempt(() => note()), note.call(Counter))
class Vault {
  #secret = 7
  level = 1
  reveal(): number { return this.#secret + this.level }
  static holds(o: object): boolean { return #secret in o }
  held = (): number => this.#secret * this.level
}
const vault = new Vault(), reveal = vault.reveal, held = vault.held
console.log(reveal.call(vault), reveal.call(new Vault()), attempt(() => reveal.call({ level: 1 })), attempt(() => reveal.call(Object.create(vault))), attempt(() => reveal()), held(), held.call({ level: 5 }), Vault.holds(vault), Vault.holds(Object.create(vault)), Vault.holds({ level: 1 }))

const receivers: { count: number; step: number }[] = [c, other, fast]
let total = 0
for (let i = 0; i < 30000; i++) { const r = receivers[i % receivers.length]; total += bump.call(r) + describe.call(r, "").length; if (r.count > 1e6) r.count = 0 }
console.log(total, receivers.map(r => r.count).join())
//// objects-inside-objects/repo-binds-typed-objects-undefined-bang-placeholders-program.ts
// Objects inside objects: repo binds typed objects undefined bang placeholders program. It prints what plain Bun prints.
interface SourceFile { fileName: string; text: string; statements: Stmt[] }
interface Stmt { kind: number; pos: number }
interface Scanner { setText(text: string): void; scan(): number; getPos(): number }
let currentFile: SourceFile = undefined!
let currentText: string = undefined!
let position: number = -1
let isStrict: boolean = false
let scanner: Scanner = null!
function describe(): string {
  return [typeof currentFile, typeof currentText, typeof position, typeof isStrict, String(scanner), String(position), String(currentText)].join()
}
console.log(describe())
function createScanner(): Scanner {
  let text: string = undefined!
  let pos: number = -1
  return {
    setText(t) { text = t; pos = 0 },
    scan() { return pos < text.length ? text.charCodeAt(pos++) : -1 },
    getPos() { return pos },
  }
}
function parse(fileName: string, text: string): SourceFile {
  scanner = createScanner()
  const early = String(scanner.getPos())
  scanner.setText(text)
  currentText = text; position = 0; isStrict = text.startsWith("s")
  currentFile = { fileName, text, statements: [] }
  for (let c = scanner.scan(); c !== -1; c = scanner.scan()) { currentFile.statements.push({ kind: c, pos: position }); position = scanner.getPos() }
  const result = currentFile
  console.log(early, describe())
  // Cleared again, as the parser does, so that nothing is kept alive.
  currentFile = undefined!; currentText = undefined!; position = -1; isStrict = false; scanner = undefined!
  return result
}
const parsed = parse("a.ts", "sab")
console.log(JSON.stringify(parsed), describe())
try { console.log(currentFile.fileName) } catch (e) { console.log((e as Error).constructor.name) }
try { console.log(currentText.length) } catch (e) { console.log((e as Error).constructor.name) }
console.log(position + 1, isStrict ? "strict" : "sloppy", currentText === undefined, currentText + "!")
// Fields and parameters.
class Binder {
  file: SourceFile = undefined!
  container: Stmt = undefined!
  count: number = -1
  label: string = null!
  bind(file: SourceFile) { this.file = file; this.container = file.statements[0]; this.count = file.statements.length; this.label = file.fileName; return this }
  state() { return [Object.keys(this).join(), String(this.count), String(this.label), typeof this.file, typeof this.container, JSON.stringify(this)].join(" ") }
}
const binder = new Binder()
console.log(binder.state())
console.log(binder.count + 1, binder.label + "!", "label" in binder, "file" in binder, binder.file === undefined, binder.label === null)
console.log(binder.bind(parsed).state())
console.log(binder.count + 1, binder.label + "!", binder.container.kind)
interface Links { target: Stmt; type: string; id: number }
function emptyLinks(): Links { return { target: undefined!, type: undefined!, id: 0 } }
const links = emptyLinks()
console.log(Object.keys(links).join(), JSON.stringify(links), String(links.id), String(links.type), String(links.target), links.id + 1, "type" in links)
links.id = 3; links.type = "t"; links.target = parsed.statements[1]
console.log(Object.keys(links).join(), JSON.stringify(links), links.id + 1, links.type + "!", links.target.pos)
function visit(node: Stmt = undefined!, depth: number = 0): string { return String(node) + String(depth) }
console.log(visit(), visit(undefined, 1))
const table: Stmt[] = [undefined!, { kind: 1, pos: 2 }]
console.log(table.length, String(table[0]), table[1].kind, JSON.stringify(table))
//// objects-inside-objects/repo-binds-typed-objects-value-kinds-from-any-program.ts
// Objects inside objects: repo binds typed objects value kinds from any program. It prints what plain Bun prints.
function attempt(label: string, f: () => unknown) {
  try { console.log(label, String(f())) } catch (e) { console.log(label, (e as Error).constructor.name) }
}
const hide = (v: unknown): any => v
interface P { x: number }
const made: P = { x: 4 }
attempt("a1", () => { const p: P = hide(made); return [typeof p, p.x, p === made].join() })
attempt("a2", () => { const p: P = JSON.parse('{"x":5}'); return [typeof p, p.x, Object.keys(p).join()].join() })
attempt("a7", () => typeof (hide(made) as P))
attempt("b1", () => { const p: P = hide(null); return p === null })
attempt("b2", () => { const p: P = hide(undefined); return p === undefined })
attempt("b3", () => { const p: P = hide(null); return p.x })
type Fn = (n: number) => number
attempt("c3", () => { const f: Fn = hide((n: number) => n + 1); return f(1) })
attempt("c4", () => { const f: Fn = hide(class {}); return typeof f })
attempt("c5", () => { const f: Fn = hide(Math.abs); return f(-2) })
attempt("c6", () => { const f: Fn = hide(function (this: unknown, n: number) { return n * 2 }.bind(null)); return f(4) })
attempt("c7", () => { const f: Fn = hide(null); return f(1) })
// Built-in classes.
attempt("d1", () => { const a: number[] = hide([7, 8]); return a.length + "/" + a[0] + "/" + Array.isArray(a) })
attempt("d5", () => { const m: Map<string, number> = hide(new Map([["a", 1]])); return m.size + "/" + m.get("a") + "/" + m.get("b") })
attempt("d6", () => { const s: Set<string> = hide(new Set(["a"])); return s.size + "/" + s.has("a") })
attempt("d7", () => { const a: number[] = hide(undefined); return a.length })
class C { v = 1; m() { return this.v } }
class D extends C { w = 2 }
attempt("e1", () => { const c: C = hide(new C()); return c.v + "/" + c.m() + "/" + (c instanceof C) })
attempt("e2", () => { const c: C = hide(new D()); return c.v + "/" + c.m() + "/" + (c instanceof D) })
// Classes are types like any other: a literal that has all a C has is assignable to C.
attempt("e3", () => { const c: C = hide({ v: 2, m() { return 9 } }); return c.v + "/" + c.m() + "/" + (c instanceof C) })
attempt("f1", () => { const o: object = hide(made); return typeof o })
attempt("f2", () => { const o: object = hide([]); return typeof o })
attempt("f3", () => { const o: object = hide(Math.abs); return typeof o })
attempt("f4", () => { const o: object = hide(new Date(0)); return typeof o + Object.keys(o).length })
// Into fields, parameters and results of object type.
interface Owner { item: P }
const owner: Owner = { item: { x: 1 } }
function describe(p: P): string { return typeof p }
attempt("g1", () => { owner.item = hide(made); return "stored" })
attempt("g2", () => (describe as any)(made))
attempt("g3", () => (describe as any)(null) + (describe as any)())
attempt("g4", () => owner.item.x)
// The parts of a union with primitives.
attempt("i1", () => { const u: P | number = hide(5); return typeof u })
attempt("i2", () => { const u: Fn | string = hide("s"); return typeof u })
attempt("i3", () => { const u: number[] | boolean | null = hide(false); return typeof u })
attempt("i4", () => typeof (hide(undefined) as object | undefined))
attempt("i5", () => [5, made].map(v => { const u: P | number = hide(v); return typeof u === "number" ? u + 1 : typeof u === "object" ? u.x : "neither" }).join())
interface Mixed { either: P | number; call?: Fn | string }
attempt("i6", () => { const m = JSON.parse('{"either":{"x":1},"call":"text"}') as Mixed; return typeof m.either + typeof m.call })
attempt("i7", () => { const m: Mixed = { either: 1 }; m.either = hide(made); m.call = hide(Math.abs); return typeof m.either + typeof m.call + JSON.stringify(m) })
function mixed(v: P | number): string { return typeof v }
attempt("i8", () => (mixed as any)(1) + mixed(hide(made)))
//// objects-inside-objects/repo-binds-untyped-code-closures-capture-their-holder-text.js
// Objects inside objects: repo binds untyped code closures capture their holder text. It prints what plain Bun prints.
const lines = [];
const spell = v => typeof v === "function" ? "function " + JSON.stringify(v.name) + "/" + v.length : typeof v === "symbol" ? String(v) : typeof v === "object" && v !== null ? (Array.isArray(v) ? "[" + v.map(spell).join() + "]" : "{" + Object.keys(v).join() + "}") : typeof v + " " + String(v);
const show = (title, f) => { let text; try { text = spell(f()); } catch (e) { text = "throws " + e.constructor.name; } lines.push(title + ": " + text); };
const collect = () => { if (typeof gc === "function") gc(); };

const make = a => { const o = { a }; o.plus = x => o.a + x; o.minus = (x, y) => o.a - x - (y || 0); o.self = () => o; o.later = async x => o.a * x; o.plain = function (x) { return [o.a, this === o, x].join(); }; return o; };
class Bound { constructor(a) { this.a = a; this.get = this.get.bind(this); this.add = this.add.bind(this); this.arrow = () => this.a; } get() { return this.a; } add(x, y) { return this.a + x + y; } }
class Heir extends Bound { constructor(a) { super(a); this.more = () => this.a + 1; } get() { return "heir " + this.a; } }
const makers = { make, bound: a => new Bound(a), heir: a => new Heir(a) };
const names = { make: ["plus", "minus", "self", "later", "plain"], bound: ["get", "add", "arrow"], heir: ["get", "add", "arrow", "more"] };

for (const kind of Object.keys(makers)) {
    const fresh = () => makers[kind](7);
    for (const name of names[kind]) {
        const t = kind + "." + name + " ";
        show(t + "called", () => fresh()[name](1, 2));
        show(t + "called twice", () => { const o = fresh(); o[name](1, 2); return o[name](3, 4); });
        show(t + "same", () => { const o = fresh(); return o[name] === o[name]; });
        show(t + "same after a call", () => { const o = fresh(); const r = o[name](1, 2); return o[name] === o[name]; });
        show(t + "same by two ways", () => { const o = fresh(); return Object.values(o).includes(o[name]) && Object.getOwnPropertyDescriptor(o, name).value === o[name] && ({ ...o })[name] === o[name]; });
        show(t + "another for another", () => fresh()[name] !== fresh()[name]);
        show(t + "value", () => fresh()[name]);
        show(t + "detached", () => { const f = fresh()[name]; return f(1, 2); });
        show(t + "on another", () => fresh()[name].call({ a: 100 }, 1, 2));
        show(t + "inherited", () => Object.create(fresh())[name](1, 2));
        show(t + "inherited, same", () => { const o = fresh(); return Object.create(o)[name] === o[name]; });
        show(t + "descriptor", () => { const d = Object.getOwnPropertyDescriptor(fresh(), name); return [typeof d.value, d.writable, d.enumerable, d.configurable, "get" in d].join(); });
        show(t + "has", () => { const o = fresh(); return [name in o, Object.hasOwn(o, name), o.propertyIsEnumerable(name)].join(); });
        show(t + "stored to", () => { const o = fresh(); o[name] = 5; return [o[name], Object.keys(o).join()].join(" "); });
        show(t + "stored to behind a read", () => { const o = fresh(); const f = o[name]; o[name] = 5; return [o[name], typeof f, Object.keys(o).join()].join(" "); });
        show(t + "deleted", () => { const o = fresh(); return [delete o[name], typeof o[name], Object.keys(o).join()].join(" "); });
        show(t + "deleted and back", () => { const o = fresh(); delete o[name]; o[name] = "back"; return Object.keys(o).join(); });
        show(t + "hidden", () => { const o = fresh(); Object.defineProperty(o, name, { enumerable: false }); return [Object.keys(o).join(), typeof o[name], o[name] === o[name]].join(" "); });
        show(t + "made read-only", () => { const o = fresh(); Object.defineProperty(o, name, { writable: false }); const f = o[name]; try { o[name] = 1; } catch (e) { return "throws " + e.constructor.name + " " + (o[name] === f); } return o[name] === f; });
        show(t + "made an accessor", () => { const o = fresh(); Object.defineProperty(o, name, { get() { return "got"; } }); return o[name]; });
        show(t + "frozen", () => { const o = Object.freeze(fresh()); return [Object.isFrozen(o), o[name] === o[name], typeof o[name], Object.getOwnPropertyDescriptor(o, name).writable].join(); });
        show(t + "frozen behind a read", () => { const o = fresh(); const f = o[name]; Object.freeze(o); return [Object.isFrozen(o), o[name] === f].join(); });
        show(t + "sealed", () => { const o = Object.seal(fresh()); return [Object.isSealed(o), o[name] === o[name], delete o[name] === false].join(); });
        show(t + "key of a map", () => { const o = fresh(); const m = new Map([[o[name], 1]]); return m.get(o[name]); });
        show(t + "own property", () => { const o = fresh(); o[name].tag = "t"; return o[name].tag; });
    }
    show(kind + " keys", () => Object.keys(fresh()).join());
    show(kind + " own keys", () => Reflect.ownKeys(fresh()).join());
    show(kind + " for in", () => { const seen = []; for (const k in fresh()) seen.push(k); return seen.join(); });
    show(kind + " values", () => Object.values(fresh()).map(v => typeof v).join());
    show(kind + " entries", () => Object.entries(fresh()).map(e => e[0] + ":" + typeof e[1]).join());
    show(kind + " spread", () => { const o = fresh(), c = { ...o }; return Object.keys(c).join() + " " + names[kind].map(n => c[n] === o[n]).join(); });
    show(kind + " spread is bound to the first", () => { const o = fresh(), c = { ...o, a: 1000 }; return names[kind].map(n => String(c[n](1, 2))).join("|"); });
    show(kind + " assign", () => { const o = fresh(), c = Object.assign({}, o); return names[kind].map(n => c[n] === o[n]).join(); });
    show(kind + " rest", () => { const o = fresh(); const { a, ...rest } = o; return Object.keys(rest).join() + " " + names[kind].map(n => rest[n] === o[n]).join(); });
    show(kind + " descriptors", () => Object.entries(Object.getOwnPropertyDescriptors(fresh())).map(([k, d]) => k + ":" + typeof d.value + d.writable + d.enumerable + d.configurable).join());
    show(kind + " JSON", () => JSON.stringify(fresh()));
    show(kind + " fromEntries", () => { const o = fresh(), c = Object.fromEntries(Object.entries(o)); return names[kind].map(n => c[n] === o[n]).join(); });
    show(kind + " more properties", () => { const o = fresh(); for (let i = 0; i < 40; i++) o["p" + i] = i; return names[kind].map(n => String(o[n](1, 2))).join("|") + " " + Object.keys(o).length; });
    show(kind + " a dictionary", () => { const o = fresh(); for (let i = 0; i < 300; i++) o["p" + i] = i; for (let i = 0; i < 300; i += 2) delete o["p" + i]; return names[kind].map(n => String(o[n](1, 2)) + (o[n] === o[n])).join("|"); });
    show(kind + " another prototype", () => { const o = fresh(); Object.setPrototypeOf(o, { z: 1 }); return names[kind].map(n => typeof o[n]).join() + o.z; });
    show(kind + " many, collected", () => { const kept = []; for (let i = 0; i < 3000; i++) { const o = makers[kind](i); if (i % 500 === 0) kept.push(o); if (i % 1000 === 999) collect(); } collect(); return kept.map(o => names[kind].map(n => typeof o[n](1, 2)).join("")).join("|"); });
}

// Where the store does not simply add a property.
const put = { on(o) { o.m = () => o; return o; } };
const cases = {
    hasItAlready: () => ({ m: 1, z: 2 }),
    setterAbove: () => Object.create({ set m(v) { lines.push("the setter saw " + typeof v); } }),
    getterOnlyAbove: () => Object.create({ get m() { return "from above"; } }),
    readOnlyAbove: () => Object.create(Object.defineProperty({}, "m", { value: "fixed", writable: false })),
