const c = { flexDirection: "column", flexGrow: 0, width: 81, paddingLeft: 1, marginTop: 0, color: "red" };
for (let r = 0; r < rounds; r++) { if (diff(a, b)) n++; if (r % 16 === 0 && diff(a, c)) n++; }
console.log(n);
