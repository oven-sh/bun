function withAlias(flags: number, aliasSymbol: string | undefined, aliasTypeArguments: Kind[] | undefined) {
  const made = new Kind(flags);
  made.aliasSymbol = aliasSymbol;
  made.aliasTypeArguments = aliasTypeArguments;
  return made;
}
