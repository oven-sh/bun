    this.any = i % 4 === 0 ? i : i % 4 === 1 ? "s" + i : i % 4 === 2 ? null : undefined; if (i % 5 === 0) this.opt = -i; if (i % 7 === 0) this.text = i % 14 === 0 ? null : "t"; this.run = () => i;
