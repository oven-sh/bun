//// reads-by-name/own-hides-method.js
// An own property that hides the class's method, stored behind the first call (Hono's SmartRouter.match).
class Router {
  constructor(name) { this.name = name; }
  match(x) { const inner = new Inner(this.name); this.match = inner.match.bind(inner); return 'method ' + x; }
  get size() { return 1; }
}
class Inner {
  constructor(name) { this.name = name; }
  match(x) { return 'inner ' + this.name + ' ' + x; }
}
function ask(o, i) { return o.match(i) + ' | ' + typeof o.match + ' | ' + o.size + ' | ' + o.nothing + ' | ' + Object.keys(o).join(); }
const routers = [new Router('a'), new Router('b')];
for (let i = 0; i < 40; i++) {
  const r = routers[i & 1];
  const line = ask(r, i);
  if (i < 6 || i > 37) console.log(line);
}
const read = (o) => o.match;
for (let i = 0; i < 40; i++) { const f = read(i & 1 ? routers[0] : new Router('c')); if (i > 37) console.log(f.name, f === Router.prototype.match); }
//// reads-by-name/smart-router.js
// Hono's SmartRouter in small: the first call of match() stores an own `match` that hides the method.
var Reg = class {
  name = "Reg";
  #routes = [];
  add(m, p, h) { this.#routes.push([m, p, h]); }
  match(method, path) { return [[this.name, method, path, this.#routes.length]]; }
};
var Smart = class {
  name = "Smart";
  #routers = [];
  #routes = [];
  constructor(init) { this.#routers = init.routers; }
  add(method, path, handler) {
    if (!this.#routes) throw new Error("built");
    this.#routes.push([method, path, handler]);
  }
  match(method, path) {
    if (!this.#routes) throw new Error("Fatal error");
    const routers = this.#routers;
    const routes = this.#routes;
    const len = routers.length;
    let i = 0;
    let res;
    for (; i < len; i++) {
      const router = routers[i];
      try {
        for (let i2 = 0, len2 = routes.length; i2 < len2; i2++) router.add(...routes[i2]);
        res = router.match(method, path);
      } catch (e) { throw e; }
      this.match = router.match.bind(router);
      this.#routers = [router];
      this.#routes = void 0;
      break;
    }
    if (i === len) throw new Error("Fatal error");
    this.name = `Smart + ${this.activeRouter.name}`;
    return res;
  }
  get activeRouter() {
    if (this.#routes || this.#routers.length !== 1) throw new Error("No active router has been determined yet.");
    return this.#routers[0];
  }
};
class App {
  router;
  constructor(options) { this.router = options.router ?? new Smart({ routers: [new Reg()] }); }
  add(m, p, h) { this.router.add(m, p, h); }
  dispatch(method, path) { const matchResult = this.router.match(method, path); return JSON.stringify(matchResult); }
}
const app = new App({});
app.add("GET", "/text", () => 1);
for (let i = 0; i < 4; i++) console.log(app.dispatch("GET", "/text" + i), app.router.name);
//// reads-by-name/warm-debug.js
// Reads by name: warm debug. It prints what plain Bun prints.
"use strict";
// Reads by name of many kinds of receivers at sites that see them all, 200 times over; then objects above them get names; then the same reads again, of the same objects and of new ones.
const unknown = String(process.argv.length > 99 ? process.argv[99] : "");
////= Base-2
class Derived extends Base {
  method() {
    return "Derived.method";
  }
}
////= OtherBase
function Old() {
  this.own = "own";
}
Old.prototype.method = function oldMethod() {};
Old.prototype.value = "Old.value";
const top = { value: "top.value", hidden: "top.hidden", method: function topMethod() {} };
const middle = Object.setPrototypeOf({ hidden: "middle.hidden", middleOnly: "middle.only" }, top);
const otherTop = { value: "otherTop.value", added: "otherTop.added" };
////= makers-2
////= readers
const show = value => (typeof value === "function" ? "function " + value.name : String(value));
const makeAll = () => Object.entries(makers).map(([kind, make]) => [kind, make()]);
////= readAll

const receivers = makeAll();
const warm = readAll(receivers);
for (let round = 0; round < 60; round++) {
  for (const [what, got] of [["same objects", readAll(receivers)], ["new objects", readAll(makeAll())]]) {
    if (got === warm) continue;
    const a = warm.split("\n"), b = got.split("\n");
    for (let i = 0; i < a.length; i++) {
      if (a[i] === b[i]) continue;
      const x = a[i].split(" "), y = b[i].split(" ");
      console.log("round", round, what, x[0], x.filter((w, j) => w !== y[j]).join(" "), "|", y.filter((w, j) => w !== x[j]).join(" "));
    }
  }
}
//// reads-by-name/warm-debug2.js
// Reads by name: warm debug2. It prints what plain Bun prints.
"use strict";
// Reads by name of many kinds of receivers at sites that see them all, 200 times over; then objects above them get names; then the same reads again, of the same objects and of new ones.
const unknown = String(process.argv.length > 99 ? process.argv[99] : "");
////= Base-2
class Derived extends Base {
  method() {
    return "Derived.method";
  }
}
////= OtherBase
function Old() {
  this.own = "own";
}
Old.prototype.method = function oldMethod() {};
Old.prototype.value = "Old.value";
const top = { value: "top.value", hidden: "top.hidden", method: function topMethod() {} };
const middle = Object.setPrototypeOf({ hidden: "middle.hidden", middleOnly: "middle.only" }, top);
const otherTop = { value: "otherTop.value", added: "otherTop.added" };
////= makers-2
////= readers
const show = value => (typeof value === "function" ? "function " + value.name : String(value));
const makeAll = () => Object.entries(makers).map(([kind, make]) => [kind, make()]);
////= readAll

const receivers = makeAll();
const warm = readAll(receivers);
for (let round = 0; round < 200; round++) {
  const g1 = readAll(receivers), g2 = readAll(makeAll());
  if (g1 !== warm || g2 !== warm) { for (const got of [g1, g2]) { const a = warm.split("\n"), b = got.split("\n"); for (let i = 0; i < a.length; i++) { if (a[i] === b[i]) continue; const x = a[i].split(" "), y = b[i].split(" "); console.log("round", round, got === g1 ? "same objects" : "new objects", x[0], x.filter((w, j) => w !== y[j]).join(" "), "|", y.filter((w, j) => w !== x[j]).join(" ")); } } throw new Error("the reads changed by themselves in round " + round); }
}
console.log(warm);

const steps = [
  ["the top gets a name", () => { top.added = "top.added"; }],
  ["the middle gets the name too", () => { middle.added = "middle.added"; }],
  ["the middle gets a name that hides the top's", () => { middle.value = "middle.value"; }],
  ["the prototype of a constructor function gets a name", () => { Old.prototype.added = "Old.added"; }],
];
for (const [what, change] of steps) {
  change();
  console.log("\n--- " + what);
  for (let round = 0; round < 40; round++) {
    const now = readAll(receivers);
    const fresh = readAll(makeAll());
    if (round === 0 || round === 39) console.log(now + "\n- new objects\n" + fresh);
  }
}
