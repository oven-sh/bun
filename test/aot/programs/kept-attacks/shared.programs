////: framesOf
function framesOf(stack: string): string {
  const frames: string[] = [];
  for (const line of stack.split("\n")) {
    const frame = /^\s*at (\w+) \(.*:(\d+):(\d+)\)$/.exec(line);
    if (frame && own.has(frame[1])) frames.push(frame[1] + "@" + frame[2] + ":" + frame[3]);
  }
  return frames.join(" < ");
}
////: getterFor
function getterFor(key: string, field: Field, unread: object): () => unknown {
  let lastRaw: unknown = unread;
  let lastParsed: unknown;
  return () => {
    const raw = process.env[key];
    if (raw !== lastRaw) {
      lastParsed = field.parse(raw);
      lastRaw = raw;
    }
    return lastParsed;
  };
}
////: holder
function holder(p: number[], round: number): string {
  const before = p[0] + p[3] + p.length;
  const got = callee(round);
  let sum = 0;
  for (let index = 0; index < p.length; index++) sum += p[index];
  const after = sum + "," + p.length + "," + p[1] + "," + p[3];
  return before + " " + got + " " + after;
}
////: holder-10
function holder(p: Point, round: number): string {
  const before = p.x + p.y;
  const got = callee(round);
  let stored = "stored";
  try {
    p.x = 5;
  } catch (error) {
    stored = (error as Error).name;
  }
  const after = stored + "," + p.x + "," + p.y + "," + Object.isFrozen(p);
  return before + " " + got + " " + after;
}
