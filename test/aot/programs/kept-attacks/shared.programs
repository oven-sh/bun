////: holder-5
function holder(p: Card, round: number): string {
  const before = p.id + ":" + p.note;
  const got = callee(round);
  let stored = "stored";
  try {
    p.note = "late";
  } catch (error) {
    stored = (error as Error).name;
  }
  const after = stored + "," + p.note + "," + p.id + "," + Object.keys(p).join("");
  return before + " " + got + " " + after;
}
////: holder-6
function holder(p: Card, round: number): string {
  const before = p.id + ":" + p.note;
  const got = callee(round);
  const after = p.note + "," + p.id + "," + ("note" in p) + "," + Object.keys(p).join("");
  return before + " " + got + " " + after;
}
////: holder-7
function holder(p: number[], round: number): string {
  const before = p[0] + p[3] + p.length;
  const got = callee(round);
  let stored = "stored";
  try {
    p[0] = 9;
    p.push(1);
  } catch (error) {
    stored = (error as Error).name;
  }
  const after = stored + "," + p[0] + "," + p.length;
  return before + " " + got + " " + after;
}
////: holder-8
function holder(p: Lamp, round: number): string {
  const before = (p.on ? "lit" : "dark") + p.watts;
  const got = callee(round);
  const after = (p.on ? "lit" : "dark") + "," + (p.on === true) + "," + (p.on === false) + "," + typeof p.on + "," + p.watts;
  return before + " " + got + " " + after;
}
////: holder-9
function holder(p: Point, round: number): string {
  const before = p.x + p.y;
  const got = callee(round);
  const after = p.x + "," + p.y;
  return before + " " + got + " " + after;
}
