////: Pattern
class Pattern extends RegExp {
  constructor(source: string, flags?: string) {
    super(source, flags);
    log.push("new " + (typeof source === "string" ? "string" : "other") + " " + Object.prototype.toString.call(source) + " " + flags);
  }
  exec(text: string | number): RegExpExecArray | null {
    log.push("exec " + typeof text + " " + this.lastIndex);
    return super.exec(String(text));
  }
}
////: Safe
class Safe {
  #code = 42;
  static codeOf(safe: Safe): number {
    return safe.#code;
  }
}
////: for-22
for (const other of «1») {
  try {
    console.log(Safe.codeOf(other));
  } catch (error) {
    console.log(error instanceof TypeError);
  }
}
//// species/entries-programs-e1.ts
// Species: entries programs. It prints what plain Bun prints.
const textToKeywordObj = { abstract: 128, accessor: 129, any: 133 };
const textToKeyword = new Map(Object.entries(textToKeywordObj));
function keywordOf(text: string): number | undefined { return textToKeyword.get(text); }
console.log(keywordOf("any"), keywordOf("none"));
//// species/fiber-programs-e2-entries-loop.js
// Species: fiber programs  entries loop. It prints what plain Bun prints.
const table = { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 };
function total(object) { let sum = 0; for (const [key, value] of Object.entries(object)) sum += value + key.length; return sum; }
function pairs(object) { let sum = 0; const list = Object.entries(object); for (let i = 0; i < list.length; i++) { const pair = list[i]; sum += pair[1] + pair[0].length + pair.length; } return sum; }
let sum = 0;
for (let round = 0; round < 200000; round++) sum += total(table) + pairs(table);
console.log(sum);
//// species/fiber-programs-e3-map-numbers-loop.js
// Species: fiber programs  map numbers loop. It prints what plain Bun prints.
const counts = new Map();
function bump(key, by) { const before = counts.get(key); counts.set(key, before === undefined ? by : (before + by) & 1023); }
function total() { let sum = 0; for (let key = 0; key < 64; key++) { const value = counts.get(key); if (value !== undefined) sum += value * 2 + 1; } return sum; }
let sum = 0;
for (let round = 0; round < 300000; round++) { bump(round & 63, round & 7); if ((round & 255) === 0) sum += total(); }
console.log(sum, counts.size);
//// species/fiber-programs-e4-spread-loop.js
// Species: fiber programs  spread loop. It prints what plain Bun prints.
const base = { a: 1, b: 2, c: 3 };
function widen(object, extra) { return { ...object, d: extra }; }
function join(list, tail) { return [...list, tail]; }
let sum = 0, list = [1, 2, 3];
for (let round = 0; round < 300000; round++) { const wide = widen(base, round & 15); sum += wide.a + wide.b + wide.c + wide.d; const longer = join(list, round & 3); sum += longer[0] + longer[3] + longer.length; }
console.log(sum);
//// species/fiber-programs-e5-length-of-what-a-built-in-answers.js
// Species: fiber programs  length of what a built in answers. It prints what plain Bun prints.
const table = { a: 1, b: 2, c: 3 };
const words = "one,two,three,four";
const list = [1, 2, 3, 4, 5];
function lengths(round) {
  const keys = Object.keys(table), parts = words.split(","), mapped = list.map(x => x + round), kept = list.filter(x => x > 2), cut = list.slice(1), joined = list.concat(cut);
  return keys.length + parts.length + mapped.length + kept.length + cut.length + joined.length;
}
let sum = 0;
for (let round = 0; round < 100000; round++) sum += lengths(round);
console.log(sum);
//// species/fiber-programs-e6-entries-loop-typed.ts
// Species: fiber programs  entries loop typed. It prints what plain Bun prints.
declare const console: { log(...values: unknown[]): void };
type Table = { a: number; b: number; c: number; d: number; e: number; f: number; g: number; h: number };
const table: Table = { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 };
function total(object: Table): number { let sum = 0; for (const [key, value] of Object.entries(object)) sum += value + key.length; return sum; }
function pairs(object: Table): number { let sum = 0; const list: [string, number][] = Object.entries(object); for (let i = 0; i < list.length; i++) { const pair = list[i]; sum += pair[1] + pair[0].length + pair.length; } return sum; }
let sum = 0;
for (let round = 0; round < 200000; round++) sum += total(table) + pairs(table);
console.log(sum);
