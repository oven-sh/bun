class Parent extends Array<number> { static get [Symbol.species](): any { log.push("parent getter " + (this === Child)); return Array; } }
class Child extends Parent {}
const mapped = Child.from([1, 2]).filter(one => one > 1);
log.push(String(mapped instanceof Child), String(mapped.length));
console.log(log.join("; "));
//// species/programs-v-own-constructor-property.ts
// A plain array gets an own `constructor` whose species is a function of the program that nothing else calls.
const log: string[] = [];
function Made(this: any, length: string) { log.push("constructed with " + (typeof length === "string" ? "a string" : "no string") + " " + String(length)); this.length = 0; }
const list: any = [1, 2];
list.constructor = { [Symbol.species]: Made };
const mapped = list.map((one: number) => one + 1);
log.push(String(mapped instanceof (Made as any)), String(mapped[0]), String(mapped[1]));
console.log(log.join("; "));
//// species/programs-v-promise-species-executor.ts
// then() constructs the species of a promise subclass with a native executor; the constructor says its parameter is a string.
const log: string[] = [];
class Mine<T> extends Promise<T> { constructor(executor: any, label?: string) { super(typeof executor === "function" ? executor : () => {}); log.push("new " + typeof executor + " " + typeof label); } }
const first = new Mine<number>((resolve: (value: number) => void) => resolve(1), "mine");
const second = first.then(one => one + 1);
log.push(String(second instanceof Mine));
second.then(value => { log.push(String(value)); console.log(log.join("; ")); });
//// species/programs-v-regexp-like-receiver.ts
// RegExp.prototype[Symbol.split] takes any object as its receiver and constructs the species of its `constructor`.
const log: string[] = [];
class Splitter { lastIndex = 0; constructor(pattern: string, flags: number) { log.push("new " + (typeof pattern === "string" ? "string" : "other") + " " + (typeof flags === "number" ? "number" : "other") + " " + String(flags)); } exec(text: number): null { log.push("exec " + typeof text); return null; } }
new Splitter("x", 1).exec(1);
const like: any = { constructor: { [Symbol.species]: Splitter }, flags: "u" };
const parts = (RegExp.prototype as any)[Symbol.split].call(like, "ab");
log.push(String(parts.length), String(parts[0]));
console.log(log.join("; "));
//// species/programs-v-species-is-data.ts
// The species is a static data property that names another class of the program, whose constructor says `string`.
const log: string[] = [];
class Target extends Array<number> { constructor(label: string) { super(); log.push((typeof label === "string" ? "a string" : "no string") + " " + Object.prototype.toString.call(label)); } }
class Source extends Array<number> { static [Symbol.species]: any = Target; }
new Target("mine");
const made = Source.from([1, 2, 3]).slice(1);
log.push(String(made instanceof Target), String(made.length));
console.log(log.join("; "));
