// Species, one probe of many. It prints what plain Bun prints.
const log: string[] = [];
class ByMap extends Array<number> { constructor(label: string) { super(); log.push((typeof label !== "string" ? "no string" : "a string") + " " + Object.prototype.toString.call(label)); } static one(): ByMap { const made = new ByMap("mine"); made.push(1); return made; } }
try { const mapped = ByMap.one().map(one => one); log.push("mapped " + (mapped instanceof ByMap) + " " + mapped.length); } catch (error) { log.push("threw " + String(error).slice(0, 150)); }
class ByRead extends Array<number> { constructor(label: string) { super(); log.push((typeof label !== "string" ? "no string" : "a string") + " " + Object.prototype.toString.call(label)); } }
try { new (Reflect.get(new ByRead("mine"), "constructor") as any)(1); } catch (error) { log.push("threw " + String(error).slice(0, 150)); }
console.log(log.join("; "));
//// species/programs-sp1.ts
// Species, one probe of many. It prints what plain Bun prints.
const log: string[] = [];
function thrown(value: number): void { log.push("called with " + (typeof value !== "number" ? "no number" : "a number") + " " + Object.prototype.toString.call(value)); }
thrown(1);
class Mine extends Array { static get [Symbol.species](): any { log.push("species getter"); throw thrown; } }
try {
  const made = Mine.from([1]);
  log.push("made " + (made instanceof Mine));
  const mapped = made.map(one => one);
  log.push("mapped " + (mapped instanceof Mine));
} catch (caught) {
  log.push("caught " + typeof caught);
  (caught as any)("s");
}
class Other extends Array { static get [Symbol.species](): any { log.push("species getter 2"); return Array; } }
const other = Other.from([1]).map(one => one);
log.push("other " + (other instanceof Other));
console.log(log.join("; "));
//// species/programs-v-defined-species.ts
// The getter is put on the class by Object.defineProperty.
const log: string[] = [];
class Mine extends Array<number> {}
Object.defineProperty(Mine, Symbol.species, { get() { log.push("defined getter"); return Array; } });
const made = Mine.of(1, 2).concat([3]);
log.push(String(made instanceof Mine), String(made.length));
console.log(log.join("; "));
//// species/programs-v-getter-stays-out.ts
// No native reader meets an instance: the program prints the same, and the getter need not be compiled.
class Quiet extends Array<number> { static get [Symbol.species](): any { console.log("never"); return Array; } }
const quiet = new Quiet(); quiet.push(1, 2);
console.log(quiet.length, quiet[1], quiet.indexOf(2));
//// species/programs-v-inherited-species.ts
// The getter sits on a parent class; the instance is of a child, made by from().
