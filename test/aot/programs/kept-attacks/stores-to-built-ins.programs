//// stores-to-built-ins/callbacks-in-functions.js
// callbacks-in-functions.js <which> <size> <rounds>: built-ins that call a function for each element.
const which = process.argv[2], size = Number(process.argv[3] ?? 64), rounds = Number(process.argv[4] ?? 100);
const numbers = []; for (let i = 0; i < size; i++) numbers.push(((i * 7919) % 1000) | 0);
const map = new Map(numbers.map((n, i) => [i, n])), set = new Set(numbers), text = "ab".repeat(size / 2);
function once(which, numbers, map, set, text, size) {
  let sum = 0;
  switch (which) {
  case "loop": for (let j = 0; j < numbers.length; j++) sum += numbers[j]; break;
  case "forEach": numbers.forEach(n => { sum += n; }); break;
  case "map": sum += numbers.map(n => n + 1).length; break;
  case "filter": sum += numbers.filter(n => n & 1).length; break;
  case "reduce": sum += numbers.reduce((a, n) => a + n, 0); break;
  case "reduceRight": sum += numbers.reduceRight((a, n) => a + n, 0); break;
  case "some": sum += numbers.some(n => n < 0) ? 1 : 0; break;
  case "every": sum += numbers.every(n => n >= 0) ? 1 : 0; break;
  case "find": sum += numbers.find(n => n < 0) === undefined ? 1 : 0; break;
  case "findIndex": sum += numbers.findIndex(n => n < 0); break;
  case "findLast": sum += numbers.findLast(n => n < 0) === undefined ? 1 : 0; break;
  case "flatMap": sum += numbers.flatMap(n => [n]).length; break;
  case "from": sum += Array.from(numbers, n => n + 1).length; break;
  case "fromLength": sum += Array.from({ length: size }, (_, j) => j).length; break;
  case "mapForEach": map.forEach(n => { sum += n; }); break;
  case "setForEach": set.forEach(n => { sum += n; }); break;
  case "replaceFn": sum += text.replace(/a/g, m => m + "x").length; break;
  case "replaceAllFn": sum += text.replaceAll("a", m => m + "x").length; break;
  case "sort": sum += numbers.slice().sort((a, b) => a - b)[0]; break;
  case "stringifyReplacer": sum += JSON.stringify(numbers, (k, v) => v).length; break;
  case "parseReviver": sum += JSON.parse("[" + numbers.join() + "]", (k, v) => v).length; break;
  case "groupBy": sum += Object.keys(Object.groupBy(numbers, n => n & 3)).length; break;
  case "fromEntries": sum += Object.keys(Object.fromEntries(numbers.map((n, j) => ["k" + j, n]))).length; break;
  }
  return sum;
}
function run(which, rounds) {
  let sum = 0;
  for (let i = 0; i < rounds; i++) sum += once(which, numbers, map, set, text, size);
  return sum;
}
const sum = run(which, rounds);
console.log(which, size, rounds, sum);
//// stores-to-built-ins/host-calls.js
// host-calls.js <which> <rounds>: one built-in that runs in the host, called in a loop: the price of the call all in.
const which = process.argv[2], rounds = Number(process.argv[3] ?? 1000);
const array = [1, 2, 3, 4], text = "a,b,c", object = { a: 1, b: 2, c: 3 }, map = new Map([[1, 2]]), nested = [[1], [2]];
let sum = 0;
for (let i = 0; i < rounds; i++) {
  switch (which) {
  case "none": sum += i & 1; break;
  case "lastIndexOf": sum += array.lastIndexOf(3); break;
  case "reverse": sum += array.reverse().length; break;
  case "fill": sum += array.fill(i & 3).length; break;
  case "flat": sum += nested.flat().length; break;
  case "slice": sum += array.slice(1).length; break;
  case "concat": sum += array.concat(array).length; break;
  case "indexOf": sum += array.indexOf(3); break;
  case "includes": sum += array.includes(3) ? 1 : 0; break;
  case "join": sum += array.join().length; break;
  case "sort": sum += array.sort().length; break;
  case "sortBy": sum += array.sort((a, b) => a - b).length; break;
  case "splice": sum += array.splice(1, 1, 5).length; break;
  case "from": sum += Array.from(array).length; break;
  case "fromMap": sum += Array.from(map.keys()).length; break;
  case "isArray": sum += Array.isArray(array) ? 1 : 0; break;
  case "keys": sum += Object.keys(object).length; break;
  case "entries": sum += Object.entries(object).length; break;
  case "values": sum += Object.values(object).length; break;
  case "assign": sum += Object.assign({}, object).a; break;
  case "freeze": sum += Object.freeze({ a: i }).a & 1; break;
  case "hasOwn": sum += Object.hasOwn(object, "b") ? 1 : 0; break;
  case "hasOwnProperty": sum += object.hasOwnProperty("b") ? 1 : 0; break;
  case "defineProperty": sum += Object.defineProperty({}, "x", { value: i, enumerable: true }).x & 1; break;
  case "getPrototypeOf": sum += Object.getPrototypeOf(object) === Object.prototype ? 1 : 0; break;
  case "create": sum += Object.create(null) ? 1 : 0; break;
  case "bind": sum += Math.max.bind(null, 1)(); break;
  case "apply": sum += Math.max.apply(null, array); break;
  case "stringify": sum += JSON.stringify(object).length; break;
  case "parse": sum += JSON.parse('{"a":1}').a; break;
  case "trim": sum += " a ".trim().length; break;
  case "split": sum += text.split(",").length; break;
  case "padEnd": sum += text.padEnd(8).length; break;
  case "repeat": sum += text.repeat(2).length; break;
  case "startsWith": sum += text.startsWith("a") ? 1 : 0; break;
  case "localeCompare": sum += text.localeCompare("b"); break;
  case "normalize": sum += text.normalize().length; break;
  case "codePointAt": sum += text.codePointAt(0); break;
  case "toFixed": sum += (i / 3).toFixed(2).length; break;
  case "parseInt": sum += parseInt("12", 10); break;
  case "parseFloat": sum += parseFloat("1.5"); break;
  case "symbolFor": sum += Symbol.for("x") ? 1 : 0; break;
  case "dateNow": sum += Date.now() & 1; break;
  case "newDate": sum += new Date(0).getTime(); break;
  case "newError": sum += new Error("x").message.length; break;
  case "promiseResolve": sum += Promise.resolve(1) ? 1 : 0; break;
  case "weakMap": sum += new WeakMap().has(object) ? 1 : 0; break;
  case "structuredClone": sum += structuredClone(object).a; break;
  }
}
console.log(which, rounds, sum);
//// stores-to-built-ins/probe1.ts
// Forms of stores and definitions as a large program has them. Which of them still go by name at Selected though the receiver has a layout?
function largeLiteral(i: number) { return { a0: i, a1: i, a2: i, a3: i, a4: i, a5: i, a6: i, a7: i, a8: i, a9: i, a10: i, a11: i, a12: i, a13: i, a14: i, a15: i, a16: i, a17: i, a18: i, a19: i, a20: i, a21: i, a22: i, a23: i, a24: i, a25: i, a26: i, a27: i, a28: i, a29: i, a30: i, a31: i, a32: i, a33: i, a34: i, a35: i, a36: i, a37: i, a38: i, a39: i, a40: i, a41: i, a42: i, a43: i, a44: i, a45: i, a46: i, a47: i }; }
function spreadInTheMiddle(o: { p: number }, i: number) { return { x: i, ...o, y: i, z: i }; }
type Later = { a: number; b?: number; c?: string };
function storedLater(i: number) { const t: Later = { a: i }; t.b = i; if (i & 1) t.c = "c"; return t; }
function conditional(i: number): Later { return { a: i, ...(i & 1 ? { b: i } : {}) }; }
const Kind: any = {};
Kind["One"] = "One"; Kind["Two"] = "Two"; Kind["Three"] = "Three";
export const table = {
  t0: { type: "array", description: "d0", items: { type: "string", min: 0 } },
  t1: { type: "array", description: "d1", items: { type: "string", min: 1 } },
  t2: { type: "array", description: "d2", items: { type: "string", min: 2 } },
  t3: { type: "array", description: "d3", items: { type: "string", min: 3 } },
  t4: { type: "array", description: "d4", items: { type: "string", min: 4 } },
  t5: { type: "array", description: "d5", items: { type: "string", min: 5 } },
  t6: { type: "array", description: "d6", items: { type: "string", min: 6 } },
  t7: { type: "array", description: "d7", items: { type: "string", min: 7 } },
  t8: { type: "array", description: "d8", items: { type: "string", min: 8 } },
  t9: { type: "array", description: "d9", items: { type: "string", min: 9 } },
  t10: { type: "array", description: "d10", items: { type: "string", min: 10 } },
  t11: { type: "array", description: "d11", items: { type: "string", min: 11 } }
};
class Plain { x; y; constructor(i: number) { this.x = i; this.y = i; } }
function Old(this: any, i: number) { this.p = i; this.q = i; }
function withMethods(i: number) { return { i, get twice() { return this.i * 2; }, run() { return this.i; }, after: i }; }
function computedThenNamed(k: string, i: number) { return { [k]: i, named: i }; }
function undefinedFields(i: number) { return { a: i, b: undefined, c: i & 1 ? i : undefined }; }
function shorthandOfOptionals(a?: number, b?: string) { return { a, b }; }
let sum = 0;
const rounds = Number(process.argv[2] ?? 5);
for (let i = 0; i < rounds; i++) {
  sum += largeLiteral(i).a47 + spreadInTheMiddle({ p: i }, i).z + (storedLater(i).b ?? 0) + (conditional(i).b ?? 0) + new Plain(i).y + new (Old as any)(i).q + withMethods(i).after + computedThenNamed("k" + i, i).named + undefinedFields(i).a + (shorthandOfOptionals(i).a ?? 0);
}
console.log(sum, Object.keys(Kind).length, Object.keys(table).length);
