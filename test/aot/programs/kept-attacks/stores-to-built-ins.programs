function read(object) { return object.y; }
function has(object) { return "y" in object; }
function store(object, value) { object.y = value; }
const what = process.argv[2], used = Number(process.argv[3] ?? 1), rounds = Number(process.argv[4] ?? 3);
const ordinaryOwn = [], ordinaryAbsent = [], compiledAbsent = [], compiledExtra = [];
for (let i = 0; i < used; i++) {
  ordinaryOwn.push(JSON.parse('{"a' + i + '":1,"y":2}'));
  ordinaryAbsent.push(JSON.parse('{"a' + i + '":1}'));
  compiledAbsent.push(compiled[i]());
  const extra = compiled[i](); extra["z" + i] = 1; compiledExtra.push(extra);
}
let sum = 0;
Date.now();
for (let round = 0; round < rounds; round++) {
  for (let i = 0; i < used; i++) {
    switch (what) {
    case "ordinary-own": sum += read(ordinaryOwn[i]); break;
    case "ordinary-absent": sum += read(ordinaryAbsent[i]) === undefined ? 1 : 0; break;
    case "compiled-absent": sum += read(compiledAbsent[i]) === undefined ? 1 : 0; break;
    case "compiled-extra": sum += read(compiledExtra[i]) === undefined ? 1 : 0; break;
    case "in-ordinary-own": sum += has(ordinaryOwn[i]) ? 1 : 0; break;
    case "in-ordinary-absent": sum += has(ordinaryAbsent[i]) ? 1 : 0; break;
    case "store-ordinary-own": store(ordinaryOwn[i], round); break;
    case "store-ordinary-add": store(JSON.parse('{"a' + i + '":1}'), round); break;
    }
  }
}
console.log(what, used, rounds, sum);
//// stores-to-built-ins/sorts.js
// sorts.js <which> <size> <rounds>: an array of <size> numbers or strings in a fixed scrambled order is copied and sorted.
const which = process.argv[2], size = Number(process.argv[3] ?? 16), rounds = Number(process.argv[4] ?? 100);
const numbers = [], strings = [], objects = [];
let seed = 12345;
for (let i = 0; i < size; i++) { seed = (Math.imul(seed, 1103515245) + 12345) & 0x7fffffff; numbers.push((seed % 1000) | 0); strings.push("k" + (seed % 1000)); objects.push({ key: (seed % 1000) | 0, name: "n" + i }); }
let sum = 0;
for (let i = 0; i < rounds; i++) {
  switch (which) {
  case "copy": sum += numbers.slice().length; break;
  case "numbers": sum += numbers.slice().sort((a, b) => a - b)[0]; break;
  case "strings": sum += strings.slice().sort().length; break;
  case "stringsBy": sum += strings.slice().sort((a, b) => a < b ? -1 : a > b ? 1 : 0).length; break;
  case "locale": sum += strings.slice().sort((a, b) => a.localeCompare(b)).length; break;
  case "objects": sum += objects.slice().sort((a, b) => a.key - b.key)[0].key; break;
  case "toSorted": sum += numbers.toSorted((a, b) => a - b)[0]; break;
  }
}
console.log(which, size, rounds, sum);
//// stores-to-built-ins/transitions.js
// transitions.js <objects>: every object gets five properties under names of its own, by key: each store makes a new transition.
const n = Number(process.argv[2] ?? 100);
const kept = [];
for (let i = 0; i < n; i++) {
  const object = JSON.parse("{}");
  for (let j = 0; j < 5; j++) object["p" + i + "_" + j] = j;
  kept.push(object);
}
console.log(kept.length, Object.keys(kept[n - 1]).join());
