// The environment of the process: env9 none. It prints what plain Bun prints.
type Field = { parse(raw: string | undefined): unknown };
function getterFor(key: string, field: Field, unread: object): () => unknown {
  let lastRaw: unknown = unread;
  let lastParsed: unknown;
  return () => {
    const raw: string | undefined = key.length > 99 ? undefined : key;
    if (raw !== lastRaw) {
      lastParsed = field.parse(raw);
      lastRaw = raw;
    }
    return lastParsed;
  };
}
////= build
