const text: Field = { parse: raw => raw };
////= settings
const rounds = Number(process.argv[2] ?? 200000);
let sum = 0;
const asked = ["NOT_THERE_1", "NOT_THERE_2", "HOME", "PATH"];
const byKey = settings as unknown as Record<string, unknown>;
for (let i = 0; i < rounds; i++) {
  for (const name of asked) if (byKey[name]) sum++;
  continue;
  if (settings.NOT_THERE_1) sum++;
  if (settings.NOT_THERE_2) sum++;
  if (settings.HOME !== undefined) sum++;
  if (settings.PATH !== undefined) sum++;
}
console.log(sum > 0, rounds);
