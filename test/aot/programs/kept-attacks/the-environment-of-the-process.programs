//// the-environment-of-the-process/it2.js
// The environment of the process, one probe of many. It prints what plain Bun prints.
const held = { n: 21 };
const map = new Map([["a", held], ["b", { n: 22 }]]);
const set = new Set(["x", "y"]);
for (const key of map.keys()) console.log(key);
for (const value of map.values()) console.log(value.n);
for (const [key, value] of map.entries()) console.log(key, value.n);
for (const value of set.values()) console.log(value);
const kept = map.keys();
for (const key of kept) console.log(key);
console.log([...map.keys()].join(), [...set.values()].join(), [...map.entries()].length);
//// the-environment-of-the-process/js0.js
// The environment of the process, one probe of many. It prints what plain Bun prints.
function write(out, record) {
  for (const key in record) {
    out.push(key, ":");
    out.push(record[key] ?? "null");
  }
}
const records = JSON.parse('[{"alpha":"one","beta":2,"gamma":true,"delta":"four words in here"},{"epsilon":null,"zeta":"z","eta":7.5,"theta":"t"}]');
const rounds = Number(process.argv[2] ?? 100000);
let length = 0;
for (let i = 0; i < rounds; i++) { const out = []; write(out, records[i & 1]); length += out.length; }
console.log(length);
