console.log(inspect(new Map([[1, 2]])), inspect(new Set([1])));
//// untyped-programs/g-lookup-by-parameter.ts
// Untyped programs: g lookup by parameter. It prints what plain Bun prints.
function getGetter(cls: any, name: string | symbol) { return Function.prototype.call.bind(cls.prototype.__lookupGetter__(name)); }
const size = getGetter(Map, "size"), length = getGetter(Uint8Array, "length");
console.log(size(new Map([[1, 2]])), length(new Uint8Array(3)));
//// untyped-programs/g-lookup-getter.ts
// Untyped programs: g lookup getter. It prints what plain Bun prints.
const getter = (Map.prototype as any).__lookupGetter__("size");
console.log(typeof getter, typeof Object.getOwnPropertyDescriptor(Set.prototype, "size")?.get);
//// untyped-programs/g-lookup-getter-used.ts
// Untyped programs: g lookup getter used. It prints what plain Bun prints.
const getter = (Map.prototype as any).__lookupGetter__("size");
console.log(typeof getter, new Map([[1, 2]]).size);
//// untyped-programs/g-species-claim.ts
// Untyped programs: g species claim. It prints what plain Bun prints.
let changes = 0;
function change() { changes++; }
class Other extends Array { static get [Symbol.species]() { change(); return Array; } }
const other: any = new Other(); other.push(1); other.map((x: any) => x);
console.log(changes);
//// untyped-programs/g-species-getter.ts
// Untyped programs: g species getter. It prints what plain Bun prints.
let changes = 0;
function change() { changes++; }
class Other extends Array { static get [Symbol.species]() { change(); return Array; } }
const other: any = new Other(); other.push(1);
console.log(other.map((x: any) => x).length, changes);
//// untyped-programs/g-species-getter-from.ts
// Untyped programs: g species getter from. It prints what plain Bun prints.
const log: string[] = [];
class Mine extends Array { static get [Symbol.species](): any { log.push("species getter"); throw 5; } }
try {
  const made = Mine.from([1]);
  log.push("made " + (made instanceof Mine));
  made.map(one => one);
} catch (caught) {
  log.push("caught " + typeof caught + " " + String(caught));
}
console.log(log.join("; "));
