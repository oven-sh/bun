//// untyped-programs/e-eval-as-callback.ts
// Untyped programs: e eval as callback. It prints what plain Bun prints.
type Callback = (text: string) => unknown;
function run(callback: Callback, text: string): unknown {
  return callback(text);
}
const chosen: Callback = process.argv.length > 99 ? text => text.length : eval;
console.log(run(chosen, process.argv.length > 99 ? "0" : "1 + 2"));
//// untyped-programs/e-eval-as-listener.ts
// Untyped programs: e eval as listener. It prints what plain Bun prints.
import { EventEmitter } from "node:events";
const emitter = new EventEmitter();
emitter.on("text", eval);
emitter.emit("text", process.argv.length > 99 ? "0" : "globalThis.ranTheString = true");
console.log((globalThis as any).ranTheString);
//// untyped-programs/e-eval-next-tick.ts
// Untyped programs: e eval next tick. It prints what plain Bun prints.
process.nextTick(eval, process.argv.length > 99 ? "0" : "globalThis.ranTheString = true");
setTimeout(() => console.log((globalThis as any).ranTheString), 1);
//// untyped-programs/e-eval-through-any.ts
// Untyped programs: e eval through any. It prints what plain Bun prints.
type Callback = (text: string) => unknown;
function run(callback: Callback, text: string): unknown {
  return callback(text);
}
const loose: any = process.argv.length > 99 ? (text: string) => text.length : eval;
console.log(run(loose, process.argv.length > 99 ? "0" : "1 + 2"));
//// untyped-programs/e-math-max-as-callback.ts
// Untyped programs: e math max as callback. It prints what plain Bun prints.
type Pick = (a: number, b: number) => number;
function apply(pick: Pick): number {
  return pick(1, 2);
}
const chosen: Pick = process.argv.length > 99 ? (a, b) => a - b : Math.max;
console.log(apply(chosen));
//// untyped-programs/e-pipe.ts
// Untyped programs: e pipe. It prints what plain Bun prints.
import { Readable, Writable } from "node:stream";
let bytes = 0;
const sink = new Writable({
  write(chunk, _encoding, done) {
    bytes += chunk.length;
    done();
  },
});
sink.on("finish", () => console.log(bytes));
Readable.from([Buffer.from("ab"), Buffer.from("cde")]).pipe(sink);
//// untyped-programs/g-inspect-handed-back.ts
// Untyped programs: g inspect handed back. It prints what plain Bun prints.
const custom = Symbol.for("nodejs.util.inspect.custom");
type Inspect = (value: unknown, ...rest: any[]) => string;
class Wrapper {
  [custom](depth: number, options: object, inspect: Inspect): string {
    const tries: [string, () => string][] = [
      ["map", () => inspect(new Map<unknown, unknown>([[1, { a: 1 }]]))],
      ["set", () => inspect(new Set([1]))],
      ["object", () => inspect({ a: 1 })],
      ["array", () => inspect([1, "two", 3n])],
      ["symbol", () => inspect(Symbol("s"))],
      ["nothing", () => (inspect as any)()],
    ];
    return tries.map(([name, run]) => { try { return name + "=" + run(); } catch (e) { return name + " THREW " + (e as Error).message; } }).join("; ");
  }
}
console.log(new Wrapper());
//// untyped-programs/g-inspect-map.ts
// Untyped programs: g inspect map. It prints what plain Bun prints.
