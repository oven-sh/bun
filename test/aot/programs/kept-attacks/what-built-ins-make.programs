//// what-built-ins-make/programs-i-builder.ts
// One builder that many callers hand a literal of their own: defaults are spread, the descriptors of the definition are copied (definitions carry getters), a literal of methods is assigned on top.
type Definition = { name: string; cost: number; readonly label: string; run(x: number): number };
type Built = Definition & { enabled(): boolean; title(): string; describe(): string; twice(x: number): number };
const DEFAULTS = { enabled: () => true, cost: 1 };
function build(def: Definition): Built {
  const facing = {
    describe: () => def.name + ":" + def.cost,
    twice: (x: number) => def.run(def.run(x)),
  };
  const built: Built = Object.assign(
    Object.defineProperties({ ...DEFAULTS, title: () => def.name }, Object.getOwnPropertyDescriptors(def)),
    facing,
  ) as unknown as Built;
  return built;
}
const double = build({ name: "double", cost: 2, get label() { return this.name.toUpperCase(); }, run: x => x * 2 });
const square = build({ name: "square", cost: 3, get label() { return "[" + this.name + "]"; }, run: x => x * x });
const negate = build({ name: "negate", cost: 4, get label() { return this.name; }, run: x => -x });
const tools = [double, square, negate];
let total = 0;
for (let i = 0; i < 2000000; i++) {
  const tool = tools[i % 3];
  if (tool.enabled()) total += tool.run(i & 7) + tool.twice(i & 3) + tool.cost + tool.title().length;
}
console.log(total, tools.map(tool => tool.label + " " + tool.describe() + " " + Object.keys(tool).join()).join(" | "));
//// what-built-ins-make/programs-i-builder-generic.ts
// A builder as libraries write it: generic over the definition it is handed; each caller hands a literal of its own shape.
type Base = { name: string; run(x: number): number; cost?: number; readonly label?: string; extra?: unknown };
type Defaults = { enabled(): boolean; cost: number; title(): string };
type Built<D extends Base> = Omit<D, keyof Defaults> & Defaults & { describe(): string };
const DEFAULTS = { enabled: () => true, cost: 1 };
export function build<D extends Base>(def: D): Built<D> {
  const facing = { describe: () => def.name + ":" + (def.cost ?? 0) };
  const built: Built<Base> = Object.assign(
    Object.defineProperties({ ...DEFAULTS, title: () => def.name }, Object.getOwnPropertyDescriptors(def)),
    facing,
  ) as unknown as Built<Base>;
  return built as unknown as Built<D>;
}
const a = build({ name: "a", run: x => x * 2 });
const b = build({ name: "b", cost: 3, get label() { return "[" + this.name + "]"; }, run: x => x * x });
const c = build({ name: "c", extra: [1, 2], run: x => -x, more: 1 });
const d = build({ name: "d", run(x) { return x + 1; }, other: "o", another: { deep: true } });
const e = build(Object.assign({ name: "e", run: (x: number) => x }, JSON.parse('{"parsed":1}')));
console.log([a, b, c, d, e].map(tool => tool.name + " " + tool.describe() + " " + tool.run(3) + " " + Object.keys(tool).join()).join(" | "), b.label);
//// what-built-ins-make/programs-i-builder-with-a-check.ts
// A builder that reads a member of the definition, of a declared type that nobody has proven, in front of the copy of the descriptors: the code behind the test of that type exists twice.
type Definition = { name: string; cost: number; allowed?: (x: number) => boolean; readonly label: string; run(x: number): number };
type Built = Definition & { enabled(): boolean; title(): string; admits(x: number): boolean };
const DEFAULTS = { enabled: () => true, cost: 1 };
function build(def: Definition): Built {
  const allowed = def.allowed;
  const facing = { admits: (x: number) => (allowed ? allowed(x) : true) };
  const built: Built = Object.assign(
    Object.defineProperties({ ...DEFAULTS, title: () => def.name }, Object.getOwnPropertyDescriptors(def)),
    facing,
  ) as unknown as Built;
  return built;
}
const parsed = JSON.parse('{"name":"parsed","cost":5,"allowed":7,"label":"plain"}');
parsed.run = (x: number) => x + 1;
const tools = [
  build({ name: "double", cost: 2, get label() { return this.name.toUpperCase(); }, run: x => x * 2 }),
  build({ name: "square", cost: 3, allowed: x => x > 1, get label() { return "[" + this.name + "]"; }, run: x => x * x }),
  build(parsed),
];
for (const tool of tools) {
  let admits: unknown;
  try { admits = tool.admits(2); } catch (e) { admits = (e as Error).name; }
  console.log(tool.name, tool.cost, tool.label, tool.run(3), tool.title(), tool.enabled(), admits, Object.keys(tool).join(), typeof Object.getOwnPropertyDescriptor(tool, "label")!.get);
}
//// what-built-ins-make/programs-i-removable-rows.ts
// A typed read in front of the two calls is tested, and what follows the test is copied for the values that fail it. The copies join between
// Object.getOwnPropertyDescriptors and Object.defineProperties, and each has described the source for itself.
type Definition = { name: string; make?: (input: unknown) => unknown; [key: string]: unknown };
const DEFAULTS = { isEnabled: () => true, aliases: [] as string[], label: () => "" };

export function build<D extends Definition>(def: D) {
  const make = def.make;
  const created = (input: unknown) => ({ made: typeof make === "function" ? make(input) : make, by: def.name });
  const facing = {
    run(input: unknown) {
      return created(input);
    },
  };
  return Object.assign(Object.defineProperties({ ...DEFAULTS, shownName: () => def.name }, Object.getOwnPropertyDescriptors(def)), facing);
}

const log: string[] = [];
const definitions: any[] = [
  { name: "a", make: (x: unknown) => [x], get schema() { log.push("schema read"); return 1; } },
  { name: "b" },
  { name: "c", make: 7 },
  { name: "d", make: "text", other: 2 },
  new Proxy({ name: "e", make: 1n }, {
    ownKeys(target) { log.push("ownKeys"); return Reflect.ownKeys(target); },
    getOwnPropertyDescriptor(target, key) { log.push("describe " + String(key)); return Reflect.getOwnPropertyDescriptor(target, key); },
    get(target, key, receiver) { log.push("get " + String(key)); return Reflect.get(target, key, receiver); },
  }),
];
for (const definition of definitions) {
  const built: any = build(definition);
  console.log(Object.keys(built).join(), JSON.stringify(built.run(3), (key, value) => typeof value === "bigint" ? String(value) : value), built.shownName(), log.splice(0).join("|"));
}
for (const odd of [undefined, null]) {
  try {
    build(odd as any);
  } catch (error) {
    console.log((error as Error).name);
  }
}
