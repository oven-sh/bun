//// names-out-of-a-written-list-become-members-and-the-list-changes.js
// A loop over a written list of names gives objects one member a name; each member is a closure over the name.
const lines = [];
const say = (...parts) => lines.push(parts.map(String).join(" "));
const hidden = process.argv.length > 9 ? "x" : "";
class Counter {
  counts = { get: 0, put: 0, head: 0, late: 0 };
}
const verbs = ["get", "put", "head"];
verbs.forEach(function (verb, index, list) {
  Counter.prototype[verb] = function (by) {
    this.counts[verb] += by;
    return this;
  };
  if (index === 0) list.push("la" + hidden + "te");
});
const counter = new Counter();
counter.get(1).put(2).head(3).get(5);
say(typeof counter.late, verbs.join());
verbs.forEach(function (verb) {
  Counter.prototype[verb + hidden] = function (by) {
    this.counts[verb] -= by;
    return this;
  };
});
counter.get(1).late(4);
say(JSON.stringify(counter.counts), Object.getOwnPropertyNames(Counter.prototype).join());
// The callback is called by hand, with other names, with none.
function define(name) {
  Counter.prototype[name] = function () {
    return name + ":" + typeof this.counts[name];
  };
}
["get", "put"].forEach(define);
define("head");
define("no" + hidden + "ne");
define();
define(7);
say(counter.get(), counter.put(), counter.head(), counter.none(), counter.undefined(), counter[7]());
// map, filter, some, for-of, a Set, and a list with holes and other things in it.
const made = ["a", "b"].map(name => () => ({ [name]: name }));
say(JSON.stringify(made.map(make => make())));
const mixed = ["a", , 1, null, undefined, "b", { toString: () => "c" }];
const readers = [];
mixed.forEach(name => readers.push(from => from[name]));
const from = { a: 1, b: 2, c: 3, 1: "one", null: "n", undefined: "u" };
say(readers.map(read => read(from)).join());
const holder = {};
for (const name of ["x", "y", "x"]) {
  Object.defineProperty(holder, name, {
    get() {
      return this.values[name];
    },
    set(value) {
      this.values[name] = value;
    },
    configurable: true,
    enumerable: name === "x",
  });
}
holder.values = { x: 1, y: 2 };
holder.x = 10;
holder.y += 5;
say(holder.x, holder.y, Object.keys(holder).join(), JSON.stringify(holder.values));
// forEach of somebody else.
const impostor = {
  forEach(callback) {
    callback("put");
    callback("imp" + hidden + "ostor");
  },
};
const stored = {};
impostor.forEach(function (name) {
  stored[name] = function () {
    return this === stored && name;
  };
});
say(stored.put(), stored.impostor());
console.log(lines.join("\n"));
//// names-out-of-written-lists-that-change-behind-their-birth.js
// Names out of written lists are keys of reads, stores, definitions and calls; the lists are changed, shared, frozen, copied and emptied behind their birth.
const table = { run: 1, stop: 2, toString: 3 };
const names = ["run", "stop"];
function read(i) {
  return table[names[i]];
}
console.log(read(0), read(1), read(2));
names.push("toString");
console.log(read(2));
names[0] = "valueOf";
console.log(typeof read(0));
names[1] = "written" + "-at-run-time".slice(0, 3);
console.log(read(1));
names.length = 0;
console.log(read(0));

const inherited = ["run", "hasOwnProperty", "__proto__", "constructor"];
for (const name of inherited) console.log(name, typeof table[name], name in table, Object.hasOwn(table, name));

const sink = {};
for (const name of ["a", "b", "__proto__", "constructor", "a"]) sink[name] = name.length;
console.log(JSON.stringify(sink), Object.keys(sink).join(), Object.getPrototypeOf(sink) === Object.prototype);

class Route {
  counts = { get: 0, post: 0, head: 0 };
}
const verbs = ["get", "post", "head"];
verbs.forEach(function (verb) {
  Route.prototype[verb] = function (by) {
    this.counts[verb] += by;
    return this;
  };
});
const route = new Route();
route.get(1).post(2).head(3).get(4);
console.log(JSON.stringify(route.counts), Object.keys(Route.prototype).join());
verbs.push("trace");
console.log(typeof route[verbs[3]], typeof route[verbs[0]]);
Route.prototype[verbs[0]] = () => "replaced";
console.log(route.get(1), route[verbs[1]](5).counts.post);

const handlers = {
  up: n => n + 1,
  down: n => n - 1,
};
const script = ["up", "down", "up", "sideways"];
for (const step of script) {
  try {
    console.log(step, handlers[step](10));
  } catch (error) {
    console.log(step, error instanceof TypeError);
  }
}

const mixed = ["run", 1, null, undefined, true, "stop", 2.5, ["run"], { run: "stop" }];
for (const key of mixed) console.log(String(key), table[key]);
console.log(table[mixed[7][0]], table[mixed[8].run]);

const holes = ["run", , "stop"];
console.log(table[holes[0]], table[holes[1]], table[holes[2]], 1 in holes);

const frozen = Object.freeze(["run", "stop"]);
try {
  "use strict";
  frozen[0] = "toString";
} catch {}
console.log(table[frozen[0]]);

const copies = [...["run", "stop"], ...["toString"]].concat(["missing"]).map(name => table[name]);
console.log(copies.join());
const upper = ["run", "stop"].map(name => name.toUpperCase());
console.log(table[upper[0]], table[upper[0].toLowerCase()]);

function fill(target, list) {
  for (let i = 0; i < list.length; i++) Object.defineProperty(target, list[i], { get: () => list[i] + i, enumerable: true, configurable: true });
  return target;
}
const filled = fill({}, ["id", "size"]);
console.log(filled.id, filled.size, JSON.stringify(filled));
const other = fill({ id: 0 }, ["size", "rank"]);
console.log(other.id, other.size, other.rank);

const removed = { run: 1, stop: 2, keep: 3 };
for (const name of ["run", "stop", "absent"]) delete removed[name];
console.log(JSON.stringify(removed));

const symbols = { [Symbol.iterator]: 1, iterator: 2 };
console.log(symbols[["iterator"][0]], symbols[[Symbol.iterator][0]]);
const numeric = { 0: "zero", 1: "one", "01": "text" };
for (const key of ["0", "1", "01", "-0"]) console.log(key, numeric[key]);
const list = ["a", "b"];
for (const key of ["0", "1", "length", "2"]) console.log(key, list[key]);
//// symbols-and-odd-names.js
// Symbols, "__proto__", "constructor", "toString", an index, the empty text, undefined and null as names.
////= Emitter-2
const lines = [];
////= describe-2
const server = new Emitter();
listen(server);
const mark = Symbol("mark");
const odd = [mark, Symbol.iterator, Symbol.for("shared"), "__proto__", "constructor", "toString", "0", 0, "", undefined, null, "hasOwnProperty"];
server.on(mark, a => lines.push("mark: " + describe(a)));
server.on(Symbol.iterator, a => lines.push("iterator: " + describe(a)));
server.on(Symbol.for("shared"), a => lines.push("shared: " + describe(a)));
server.on("__proto__", a => lines.push("__proto__: " + describe(a)));
server.on("constructor", a => lines.push("constructor: " + describe(a)));
server.on("toString", a => lines.push("toString: " + describe(a)));
server.on("0", a => lines.push("zero: " + describe(a)));
server.on("", a => lines.push("empty: " + describe(a)));
server.on(undefined, a => lines.push("undefined: " + describe(a)));
server.on(null, a => lines.push("null: " + describe(a)));
server.emit(mark, new Request("/mark"));
server.emit(Symbol.iterator, new Response());
server.emit(Symbol.for("shared"), new Failure(1));
server.emit("__proto__", 1);
server.emit("constructor", "two");
server.emit("toString", 3n);
server.emit(0, new Failure(0));
server.emit("", false);
server.emit("undefined", new Request("/undefined"));
server.emit("null", new Response());
lines.push(String(server.emit("hasOwnProperty", 1)), String(server.emit("valueOf")));
for (const name of odd) lines.push(typeof server.events[name]);

// The same names on a dictionary that inherits from Object.prototype.
function Ordinary() {
  this.events = {};
}
Ordinary.prototype.on = Emitter.prototype.on;
Ordinary.prototype.emit = Emitter.prototype.emit;
const ordinary = new Ordinary();
try {
  lines.push(String(ordinary.emit("hasOwnProperty", "events")));
  lines.push(String(ordinary.emit("toString")));
  ordinary.on("__proto__", { inherited: a => lines.push("inherited: " + describe(a)) });
  lines.push(String(ordinary.emit("inherited", new Failure(9))));
  lines.push(String(ordinary.emit("__proto__", 1)));
} catch (error) {
  lines.push(error.constructor.name);
}
console.log(lines.join("\n"));
//// the-dictionary-in-other-hands.js
// The dictionary is handed to code that nobody sees, walked by Object.keys, for-in and Object.entries, copied and frozen.
////= Emitter-2
const lines = [];
////= describe-2
const server = new Emitter();
listen(server);
const unseen = new Function("events", "make", "events.tick = function (a) { make('stored by evaluated text', a); }; const kept = events.request; events.request = events.failure; events.failure = kept; return Object.keys(events).join();");
lines.push(unseen(server.events, (text, a) => lines.push(text + ": " + describe(a))));
server.emit("request", new Request("/swapped"), new Response());
server.emit("failure", new Failure(1));
server.emit("tick", 2);
for (const name of Object.keys(server.events)) server.events[name].call(server, name.length, name);
for (const name in server.events) lines.push(name + " " + server.events[name].length);
for (const [name, listener] of Object.entries(server.events)) listener.call(null, new Failure(name.length));
const copy = { ...server.events };
copy.request(new Response(), 1);
Object.freeze(server.events);
try {
  server.on("tick", () => lines.push("never stored"));
} catch (error) {
  lines.push(error.constructor.name);
}
server.emit("tick", 3);
console.log(lines.join("\n"));
//// two-emitters-a-subclass-and-borrowed-methods.js
// Two emitters with the same names, a subclass that overrides emit, emit.call and apply on another object, bound methods, methods read into variables.
////= Emitter-2
const lines = [];
////= describe-2
const server = new Emitter();
const client = new Emitter();
listen(server);
client.on("request", function (text) {
  lines.push("the client's request: " + describe(text));
});
client.on("tick", function (a, b) {
  lines.push("the client's tick: " + describe(a) + ", " + describe(b));
});
server.emit("request", new Request("/server"), new Response());
client.emit("request", "text");
client.emit("tick", new Failure(1), new Request("/client"));
server.emit("tick", 2);

class Loud extends Emitter {
  emit(type, a, b) {
    lines.push("loud " + String(type));
    return super.emit(type === "alias" ? "request" : type, b, a);
  }
}
const loud = new Loud();
listen(loud);
loud.emit("request", new Response(), new Request("/loud"));
loud.emit("alias", 1, 2);
loud.emit("tick", "swapped away", 3);

const other = { events: { request: (a, b) => lines.push("another object: " + describe(a) + ", " + describe(b)) } };
Emitter.prototype.emit.call(other, "request", new Failure(4), 5);
Emitter.prototype.emit.apply(other, ["request", "six"]);
Reflect.apply(Emitter.prototype.emit, other, ["request", 7n, new Response()]);
Emitter.prototype.on.call(other, "tick", a => lines.push("another object's tick: " + describe(a)));
other.events.tick(8);
const bound = server.emit.bind(server, "failure");
bound(new Failure(9));
const boundLater = server.emit.bind(server);
boundLater("tick", 10);
const { emit, on } = Emitter.prototype;
on.call(client, "failure", a => lines.push("the client's failure: " + describe(a)));
emit.call(client, "failure", new Failure(11));
[["tick", 12], ["failure", new Failure(13)]].forEach(([type, a]) => server.emit(type, a));
console.log(lines.join("\n"));
//// two-makers-of-one-name-take-names-of-different-types.ts
// Two classes have a method of one name that makes a closure over its parameter. The parameter of one is a union of two texts, that of the other any text, a third takes a key of a type parameter, a fourth a member of an enum.
const lines: string[] = [];
const say = (...parts: unknown[]) => lines.push(parts.map(String).join(" "));
const hidden = process.argv.length > 9 ? "x" : "";
class Narrow {
  values = { a: 1, b: 2 };
  reader(name: "a" | "b") {
    return () => this.values[name];
  }
}
class Wide {
  values: Record<string, number> = { a: 10, zebra: 20, c: 30 };
  reader(name: string) {
    return () => this.values[name];
  }
}
class Keyed<T extends object> {
  constructor(public values: T) {}
  reader<K extends keyof T>(name: K) {
    return () => this.values[name];
  }
}
enum Color {
  Red = "red",
  Blue = "blue",
}
class Painted {
  values = { red: 100, blue: 200 };
  reader(name: Color) {
    return () => this.values[name];
  }
}
class Numbered {
  values = [7, 8, 9];
  reader(name: number) {
    return () => this.values[name];
  }
}
const narrow = new Narrow(),
  wide = new Wide(),
  keyed = new Keyed({ left: "l", right: "r" }),
  painted = new Painted(),
  numbered = new Numbered();
say(narrow.reader("a")(), narrow.reader("b")());
say(wide.reader("a")(), wide.reader("zebra")(), wide.reader("c" + hidden)(), wide.reader("left")());
say(keyed.reader("left")(), keyed.reader("right")());
say(painted.reader(Color.Red)(), painted.reader(Color.Blue)());
say(numbered.reader(0)(), numbered.reader(2)());
console.log(lines.join("\n"));
