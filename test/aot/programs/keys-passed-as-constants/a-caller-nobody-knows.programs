////: Emitter
function Emitter() {
  this.events = Object.create(null);
}
////: Emitter-2
////= Emitter
////= Emitter-prototype-on
////= Emitter-prototype-emit
////= Request
////= Response
////= Failure
////: Emitter-prototype-emit
Emitter.prototype.emit = function (type, a, b) {
  const handler = this.events[type];
  if (handler === undefined) return false;
  handler.call(this, a, b);
  return true;
};
////: Emitter-prototype-on
Emitter.prototype.on = function (type, listener) {
  this.events[type] = listener;
  return this;
};
////: Failure
class Failure {
  constructor(code) {
    this.code = code;
  }
}
////: Request
class Request {
  constructor(url) {
    this.url = url;
    this.method = "GET";
  }
}
////: Response
class Response {
  constructor() {
    this.status = 200;
    this.body = "";
  }
}
////: attempt
const attempt = run => {
  try {
    return run();
  } catch (error) {
    return error.constructor.name;
  }
};
////: describe
function describe(value) {
  if (value === undefined) return "undefined";
  if (value instanceof Request) return "Request " + value.method + " " + value.url;
  if (value instanceof Response) return "Response " + value.status;
  if (value instanceof Failure) return "Failure " + value.code;
  return typeof value + " " + String(value);
}
////: describe-2
////= describe
////= listen
////: listen
function listen(emitter) {
  emitter.on("request", function (req, res) {
    lines.push("request: " + describe(req) + ", " + describe(res));
  });
  emitter.on("failure", function (failure) {
    lines.push("failure: " + describe(failure));
  });
  emitter.on("tick", function (count) {
    lines.push("tick: " + describe(count));
  });
}
//// a-caller-nobody-knows-passes-operands-to-a-rest-parameter.js
// A function that takes a name and a rest parameter is called through a value that nobody follows. What that caller passes lies in the rest array, index by index.
const table = {};
function isText(name, ...rest) {
  table[name] = true;
  const first = rest[0];
  const value = first === undefined ? "none" : first;
  if (typeof value === "string") return "a text";
  return "no text";
}
function join(name, ...rest) {
  table[name] = true;
  const first = rest[0];
  const value = first === undefined ? "none" : first;
  return value + "!";
}
function lengthOf(name, ...rest) {
  table[name] = true;
  const second = rest[1];
  const value = second === undefined ? "none" : second;
  return value.length;
}
const handlers = {
  twice(value) {
    return value + value;
  },
};
function emit(type, ...args) {
  const first = args[0];
  return handlers[type](first === undefined ? "none" : first);
}

const list = new Proxy([], {});
list.push(isText, join, lengthOf, emit);
console.log(list[0]("k", 21), list[0]("k", "text"), list[0]("k"));
console.log(list[1]("k", 21), list[1]("k", "text"), list[1]("k"));
console.log(list[2]("k", 0, [1, 2, 3]), list[2]("k", 0, 21), list[2]("k", 0, "text"), list[2]("k"));
console.log(list[3]("twice", 21), list[3]("twice", "text"), list[3]("twice"));

const holder = new Proxy({ isText, join }, {});
console.log(holder.isText("k", {}), holder.join("k", null));
console.log(isText("k", "seen"), join("k", "seen"), lengthOf("k", 0, "seen"), emit("twice", "seen"));
//// a-closure-over-a-name-is-itself-captured-called-by-name-and-calls-itself.js
// The closure that uses the name as a key is a declared function: other closures of the same maker capture it, it calls itself, and it is kept in variables that closures assign.
const lines = [];
const say = (...parts) => lines.push(parts.map(String).join(" "));
const hidden = process.argv.length > 9 ? "x" : "";
function makeReader(name) {
  function read(from) {
    return from[name];
  }
  return function (from) {
    return read(from) + ":" + read.name + ":" + read.length;
  };
}
function makeWalker(name) {
  function walk(from, depth) {
    return from[name] === undefined ? depth : walk(from[name], depth + 1);
  }
  const again = from => walk(from, 0);
  return { walk, again };
}
function makeSwapped(name) {
  let current = function (from) {
    return "first " + from[name];
  };
  const swap = () => {
    current = function (from) {
      return "second " + from[name];
    };
  };
  return { call: from => current(from), swap };
}
function makePair(name) {
  const get = from => from[name];
  const set = (into, value) => {
    into[name] = value;
    return get(into);
  };
  return [get, set];
}
class Holder {
  static make(name) {
    const read = from => from[name];
    return class {
      read(from) {
        return read(from);
      }
    };
  }
}
const box = { width: 3, height: 4, next: { next: { next: {} } } };
say(makeReader("width")(box), makeReader("height")(box), makeReader("wid" + hidden + "th")(box));
const walker = makeWalker("next");
say(walker.walk(box, 0), walker.again(box), makeWalker("ne" + hidden + "xt").again(box), makeWalker("none").again(box));
const swapped = makeSwapped("width");
say(swapped.call(box));
swapped.swap();
say(swapped.call(box), makeSwapped("height").call(box));
const [get, set] = makePair("width");
say(get(box), set(box, 9), get(box), makePair("height")[1](box, 8), box.height);
say(new (Holder.make("width"))().read(box), new (Holder.make("hei" + hidden + "ght"))().read(box));
console.log(lines.join("\n"));
//// a-function-that-makes-closures-over-a-name-is-handed-every-kind-of-name.js
// A function that makes a closure over its parameter, where the closure uses the parameter as a key, is called with written texts and with everything else.
const lines = [];
const say = (...parts) => lines.push(parts.map(part => (typeof part === "symbol" ? part.toString() : String(part))).join(" "));
function reader(name) {
  return function (from) {
    return from[name];
  };
}
function writer(name) {
  return function (into, value) {
    into[name] = value;
    return name in into;
  };
}
function remover(name) {
  return function (from) {
    return delete from[name];
  };
}
const hidden = process.argv.length > 9 ? "x" : "";
////= attempt
const mark = Symbol("mark");
const box = { width: 1, height: 2, 0: "zero", 7: "seven", "-1": "minus", "1.5": "half", "": "empty", [mark]: "marked", undefined: "u", null: "n", true: "t" };
// Written texts.
say(reader("width")(box), reader("height")(box), reader("depth")(box));
// Texts that are indexes, nearly indexes, empty.
say(reader("0")(box), reader("7")(box), reader("-1")(box), reader("1.5")(box), reader("")(box), reader("00")(box), reader("4294967295")(box), reader("4294967294")([1]));
say(reader("0")("ab"), reader("length")("ab"), reader("1")([5, 6]), reader("length")([5, 6]));
// The same texts, made at run time: ropes, texts out of other texts, numbers, symbols, objects that turn into texts.
say(reader("wid" + hidden + "th")(box), reader(["height"].join(hidden))(box), reader(`${hidden}width`)(box), reader("xwidth".slice(1))(box));
say(reader(0)(box), reader(7)(box), reader(-1)(box), reader(1.5)(box), reader(mark)(box), reader(undefined)(box), reader(null)(box), reader(true)(box), reader()(box));
let turned = 0;
const turning = {
  toString() {
    turned++;
    return "width";
  },
};
const readTurning = reader(turning);
say(readTurning(box), readTurning(box), turned);
say(reader(new String("height"))(box), reader(Object("width"))(box));
// __proto__, constructor, prototype.
const above = { inherited: "from above" };
const below = { __proto__: above, own: 1 };
say(reader("__proto__")(below) === above, reader("constructor")(below) === Object, reader("inherited")(below), reader("prototype")(function () {}) !== undefined);
const target = {};
say(writer("__proto__")(target, above), Object.getPrototypeOf(target) === above, Object.keys(target).length, target.inherited);
say(writer("width")(target, 3), target.width, writer("0")(target, "z"), target[0], writer(mark)(target, 1), target[mark]);
say(remover("width")(target), "width" in target, remover("missing")(target), remover("0")(target), 0 in target);
// Frozen, sealed, accessors that throw, proxies.
const frozen = Object.freeze({ width: 1 });
say(attempt(() => writer("width")(frozen, 9)), attempt(() => writer("wid" + hidden + "th")(frozen, 9)), frozen.width, attempt(() => remover("width")(frozen)), attempt(() => remover(hidden + "width")(frozen)));
const throwing = {
  get width() {
    throw new RangeError("no width");
  },
};
for (const read of [reader("width"), reader("wid" + hidden + "th")]) {
  try {
    say(read(throwing));
  } catch (error) {
    say(error.constructor.name, error.message);
  }
}
const seen = [];
const watched = new Proxy(
  { width: 4 },
  {
    get(of, key, receiver) {
      seen.push("get " + String(key));
      return Reflect.get(of, key, receiver);
    },
    set(of, key, value, receiver) {
      seen.push("set " + String(key));
      return Reflect.set(of, key, value, receiver);
    },
    has(of, key) {
      seen.push("has " + String(key));
      return Reflect.has(of, key);
    },
    deleteProperty(of, key) {
      seen.push("delete " + String(key));
      return Reflect.deleteProperty(of, key);
    },
  },
);
say(reader("width")(watched), writer("width")(watched, 5), remover("width")(watched), seen.join());
// undefined and null as what is read from.
for (const nothing of [undefined, null]) {
  try {
    reader("width")(nothing);
  } catch (error) {
    say(error.constructor.name);
  }
}
// What the functions themselves look like.
say(reader.name, reader.length, reader("width").name, reader("width").length, reader("width") === reader("width"), reader("width").toString() === reader(hidden + "q").toString());
say(typeof reader.prototype, new reader("width")(box), reader.call({ any: 1 }, "height")(box), reader.apply(null, ["width", "more"])(box), Reflect.apply(reader, undefined, ["height"])(box));
say(reader.bind(null, "width")()(box), [..."ab"].map(reader).length, ["width", "height"].map(reader).map(read => read(box)).join());
// The stack of an error thrown inside names each function once.
function thrower(name) {
  return function (from) {
    if (from[name] === undefined) throw new Error("nothing under " + name);
    return from[name];
  };
}
function failing(name) {
  if (name === "width") throw new Error("refused " + name);
  return function (from) {
    return from[name];
  };
}
for (const make of [() => thrower("depth")(box), () => failing("width"), () => failing("wid" + hidden + "th")]) {
  try {
    make();
  } catch (error) {
    say(error.message, error.stack.split("\n").filter(line => /thrower|failing/.test(line)).length);
  }
}
console.log(lines.join("\n"));
//// a-maker-of-closures-over-a-name-itself-captures-typed-variables.ts
// The function that makes closures over its parameter is itself a closure: it captures variables with declared types, a variable that is assigned later, a function and `this`.
const lines: string[] = [];
const say = (...parts: unknown[]) => lines.push(parts.map(String).join(" "));
const hidden = process.argv.length > 9 ? "x" : "";
interface Box {
  width: number;
  height: number;
  [name: string]: number;
}
function outer(prefix: string, scale: number, box: Box, label?: string) {
  let calls = 0;
  const describe = (value: number) => prefix + value * scale + (label ?? "");
  function reader(name: string) {
    return () => {
      calls++;
      return describe(box[name]) + "#" + calls;
    };
  }
  const arrow = (name: string) => (by: number) => prefix + (box[name] += by);
  return { width: reader("width"), height: reader("height"), other: reader("wid" + hidden + "th"), grow: arrow("width"), shrink: arrow("height") };
}
class Shelf {
  boxes: Record<string, Box> = { low: { width: 1, height: 2 }, high: { width: 3, height: 4 } };
  constructor(public title: string) {}
  readers() {
    const pick = (name: string) => () => this.title + ":" + this.boxes[name].width;
    return [pick("low"), pick("high"), pick("lo" + hidden + "w")];
  }
}
const made = outer(">", 2, { width: 5, height: 6 });
say(made.width(), made.height(), made.other(), made.grow(1), made.shrink(-1), made.width());
const labelled = outer("<", 1, { width: 7, height: 8 }, "!");
say(labelled.width(), labelled.height(), made.height());
say(
  new Shelf("s")
    .readers()
    .map(read => read())
    .join(),
);
console.log(lines.join("\n"));
//// a-name-made-at-run-time-equals-a-constant.js
// "re" + "quest", a template, a slice, String(..), an object that converts to the name: each is the name "request" at run time.
////= Emitter-2
const lines = [];
////= describe-2
const server = new Emitter();
listen(server);
const half = process.argv.length > 0 ? "re" : "fail";
server.emit(half + "quest", 1, 2);
server.emit(`${half}quest`, "template", undefined);
server.emit("xrequestx".slice(1, 8), new Failure(1), new Failure(2));
server.emit(String(["request"]), true, null);
server.emit({ toString: () => "tick" }, new Request("/object"));
server.emit(["failure"], 7n);
server.on(half + "quest", function (a, b) {
  lines.push("replaced under a name made at run time: " + describe(a) + ", " + describe(b));
});
server.emit("request", new Request("/b"), new Response());
console.log(lines.join("\n"));
//// a-name-nobody-knows-at-emit-reaches-every-listener.js
// The names at `on` are constants. One `emit` takes its name from the command line: its operands may reach any listener.
////= Emitter-2
const lines = [];
////= describe-2
const server = new Emitter();
listen(server);
server.emit("request", new Request("/a"), new Response());
server.emit("failure", new Failure(3));
server.emit("tick", 1);
const names = ["tick", "request", "failure", "nothing"];
for (let i = 0; i < names.length; i++) server.emit(names[(i + process.argv.length) % names.length], "text " + i, i);
console.log(lines.join("\n"));
//// a-name-nobody-knows-at-on-takes-the-place-of-any-listener.js
// One `on` takes its name from the command line: its listener may stand under any name, and gets what is emitted there.
////= Emitter-2
const lines = [];
////= describe-2
const server = new Emitter();
listen(server);
const names = ["request", "failure", "tick"];
server.on(names[process.argv.length % names.length], function (first, second) {
  lines.push("the late listener: " + describe(first) + ", " + describe(second));
});
server.emit("request", new Request("/a"), new Response());
server.emit("failure", new Failure(3));
server.emit("tick", 1);
console.log(lines.join("\n"));
//// a-proxy-as-the-dictionary-and-as-the-emitter.js
// The dictionary is a Proxy that answers under other names; the emitter is a Proxy; a getter stands under a name.
////= Emitter-2
const lines = [];
////= describe-2
const server = new Emitter();
listen(server);
const real = server.events;
server.events = new Proxy(real, {
  get(target, name) {
    lines.push("get " + String(name));
    return name === "tick" ? target.failure : name === "failure" ? target.request : target[name];
  },
  set(target, name, value) {
    lines.push("set " + String(name));
    target["moved " + String(name)] = value;
    return true;
  },
});
server.emit("tick", new Failure(1));
server.emit("failure", new Request("/proxy"), new Response());
server.emit("request", 1, 2);
server.on("tick", () => lines.push("never under tick"));
lines.push(Object.keys(real).join());
server.emit("moved tick");

const wrapped = new Proxy(new Emitter(), {
  get(target, name, receiver) {
    if (name === "emit") return (type, a) => target.emit("tick", type + " through the proxy, " + describe(a));
    return Reflect.get(target, name, receiver);
  },
});
listen(wrapped);
wrapped.emit("request", new Request("/wrapped"));

const withGetter = new Emitter();
let reads = 0;
Object.defineProperty(withGetter.events, "request", {
  get() {
    reads++;
    return reads % 2 ? a => lines.push("odd read: " + describe(a)) : a => lines.push("even read: " + describe(a));
  },
});
withGetter.emit("request", new Failure(2));
withGetter.emit("request", "three");
console.log(lines.join("\n"));
//// accessors-a-helper-has-defined-are-redefined-deleted-and-shadowed.js
// A helper object defines accessors on a holder under names it is handed; each forwards to a member of the receiver. Then everything they rest on changes.
const lines = [];
const say = (...parts) => lines.push(parts.map(String).join(" "));
function Forwarder(holder, member) {
  if (!(this instanceof Forwarder)) return new Forwarder(holder, member);
  this.holder = holder;
  this.member = member;
  this.names = [];
}
Forwarder.prototype.getter = function (name) {
  var holder = this.holder,
    member = this.member;
  this.names.push(name);
  holder.__defineGetter__(name, function () {
    return this[member][name];
  });
  return this;
};
Forwarder.prototype.setter = function (name) {
  var holder = this.holder,
    member = this.member;
  this.names.push(name);
  holder.__defineSetter__(name, function (value) {
    return (this[member][name] = value);
  });
  return this;
};
Forwarder.prototype.access = function (name) {
  return this.getter(name).setter(name);
};
const hidden = process.argv.length > 9 ? "x" : "";
////= attempt
const exchange = {};
const toAnswer = Forwarder(exchange, "answer").access("code").access("size").getter("sent");
const toQuestion = Forwarder(exchange, "question").access("path").getter("verb");
function make() {
  const made = Object.create(exchange);
  made.question = { path: "/", verb: "GET" };
  made.answer = { code: 200, size: 0, sent: false };
  return made;
}
function look(made) {
  return [made.code, made.size, made.sent, made.path, made.verb].join();
}
let made = make();
say(look(made), toAnswer.names.join(), toQuestion.names.join());
made.code = 404;
made.path = "/x";
say(attempt(() => (made.sent = true)), attempt(() => (made.verb = "PUT")));
say(look(made), made.answer.code, made.question.path, Object.keys(made).join());
// The helper is called with a name made at run time, and with the same name for the other member.
toAnswer.getter("la" + hidden + "te");
made.answer.late = "late";
say(made.late);
toQuestion.getter("code");
made.question.code = "of the question";
say(made.code, look(make()));
toAnswer.getter("code");
say(made.code);
// The member is swapped, is missing, is a primitive.
made.answer = { code: 1, size: 2, sent: 3 };
say(look(made));
made.answer = "text";
say(made.code, made.size);
delete made.answer;
try {
  say(made.code);
} catch (error) {
  say(error.constructor.name);
}
// An accessor is shadowed on the object, on an object between, deleted from the holder, redefined as a value.
made = make();
Object.defineProperty(made, "code", { value: "own", configurable: true });
say(made.code, make().code);
delete made.code;
say(made.code);
const between = Object.create(exchange);
between.__defineGetter__("size", function () {
  return "between";
});
const lower = Object.create(between);
lower.answer = { size: 5, code: 6, sent: 7 };
lower.question = { path: "p", verb: "v" };
say(look(lower));
delete exchange.sent;
say(look(make()), "sent" in make());
Object.defineProperty(exchange, "verb", { value: "fixed", writable: true, configurable: true });
say(look(make()));
exchange.__defineGetter__("path", function () {
  return "another getter";
});
say(look(make()));
made = make();
made.path = "stored through the old setter";
say(made.question.path, made.path);
// The accessors taken off the holder and called on something else.
const taken = Object.getOwnPropertyDescriptor(exchange, "code");
say(typeof taken.get, typeof taken.set, taken.enumerable, taken.configurable, taken.get.call({ answer: { code: "elsewhere" } }), taken.get.name, taken.get.length, taken.set.length);
say(exchange.__lookupGetter__("code") === taken.get, exchange.__lookupGetter__("size") === taken.get, exchange.__lookupGetter__("size").toString() === taken.get.toString());
// The helper's own method is replaced, and the built-in it calls is shadowed on the holder.
const original = Forwarder.prototype.getter;
Forwarder.prototype.getter = function (name) {
  say("replaced", name);
  return original.call(this, name);
};
toAnswer.getter("more");
Forwarder.prototype.getter = original;
const odd = {
  __defineGetter__(name, getter) {
    say("own definer", name, typeof getter);
  },
};
Forwarder(odd, "answer").getter("code");
say(Object.keys(odd).join());
// Names that are indexes, __proto__, symbols.
const other = {};
const mark = Symbol("mark");
Forwarder(other, "inner").getter("0").getter("__proto__").getter(mark).getter("");
const under = Object.create(other);
under.inner = { 0: "zero", [mark]: "marked", "": "empty" };
say(under[0], under.__proto__ === Object.prototype, Object.getPrototypeOf(under) === other, under[mark], under[""]);
console.log(lines.join("\n"));
//// keys-handed-on-and-rest-parameters.js
// The name goes through helpers; the operands come through a rest parameter, read by index, spread, changed and handed on.
////= Emitter-2
const lines = [];
////= describe-2
function store(target, type, listener) {
  target.events[type] = listener;
}
function lookUp(target, type) {
  return target.events[type];
}
function Relay() {
  this.events = Object.create(null);
}
Relay.prototype.addListener = function (type, listener) {
  store(this, type, listener);
  return this;
};
Relay.prototype.on = Relay.prototype.addListener;
Relay.prototype.once = function (type, listener) {
  const self = this;
  return this.on(type, function wrapper(...operands) {
    delete self.events[type];
    return listener.apply(this, operands);
  });
};
Relay.prototype.emit = function (type, ...args) {
  const handler = lookUp(this, type);
  if (handler === undefined) return false;
  switch (args.length) {
    case 0:
      handler.call(this);
      break;
    case 1:
      handler.call(this, args[0]);
      break;
    case 2:
      handler.call(this, args[0], args[1]);
      break;
    default:
      handler.apply(this, args);
  }
  return true;
};
Relay.prototype.emitReversed = function (type, ...args) {
  args.reverse();
  const handler = lookUp(this, type);
  if (handler !== undefined) handler.call(this, args[0], args[1]);
};
Relay.prototype.emitChanged = function (type, ...args) {
  args[0] = "changed";
  args.push("pushed");
  const handler = lookUp(this, type);
  if (handler !== undefined) handler.call(this, args[0], args[1], args[2]);
};
const relay = new Relay();
listen(relay);
relay.emit("request", new Request("/relay"), new Response());
relay.emit("failure", new Failure(1));
relay.emit("tick", 2);
relay.emit("tick");
relay.emit("request", 1, 2, 3, 4);
relay.emitReversed("request", new Response(), new Request("/reversed"));
relay.emitReversed("tick", "dropped", 3);
relay.emitChanged("request", new Request("/never seen"), new Response());
relay.emitChanged("tick", 4);
relay.once("late", (a, b, c) => lines.push("late: " + describe(a) + ", " + describe(b) + ", " + describe(c)));
lines.push(String(relay.emit("late", new Failure(5), "six", 7)), String(relay.emit("late", 8)));
console.log(lines.join("\n"));
//// listeners-replaced-removed-and-kept-in-arrays.js
// A listener is replaced, removed by delete and by undefined, and the dictionary holds arrays of listeners.
////= Emitter-2
const lines = [];
////= describe-2
const server = new Emitter();
listen(server);
server.emit("tick", 1);
server.on("tick", function (count) {
  lines.push("the second tick listener: " + describe(count));
});
server.emit("tick", new Failure(2));
delete server.events.tick;
lines.push(String(server.emit("tick", 3)));
server.on("failure", undefined);
lines.push(String(server.emit("failure", new Failure(4))));
server.events["request"] = function (only) {
  lines.push("stored without on: " + describe(only));
};
server.emit("request", "five");

function Many() {
  this.events = Object.create(null);
}
Many.prototype.on = function (type, listener) {
  const list = this.events[type];
  if (list === undefined) this.events[type] = [listener];
  else list.push(listener);
  return this;
};
Many.prototype.off = function (type, listener) {
  const list = this.events[type];
  if (list === undefined) return this;
  const index = list.indexOf(listener);
  if (index >= 0) list.splice(index, 1);
  return this;
};
Many.prototype.emit = function (type, a, b) {
  const list = this.events[type];
  if (list === undefined) return 0;
  for (const listener of list.slice()) listener.call(this, a, b);
  return list.length;
};
const many = new Many();
const first = a => lines.push("first: " + describe(a));
const second = (a, b) => lines.push("second: " + describe(a) + ", " + describe(b));
many.on("request", first).on("request", second).on("failure", first);
lines.push(String(many.emit("request", new Request("/many"), new Response())));
lines.push(String(many.emit("failure", new Failure(6))));
many.off("request", first);
lines.push(String(many.emit("request", 7, 8)));
many.off("nothing", first).off("failure", second);
lines.push(String(many.emit("failure", "nine")));
console.log(lines.join("\n"));
//// more-constants-than-are-told-apart.js
// One call site may pass any of twelve constants, and one emitter has a hundred names.
////= Emitter-2
const lines = [];
////= describe-2
const server = new Emitter();
listen(server);
function pick(i) {
  switch (i % 12) {
    case 0: return "request";
    case 1: return "failure";
    case 2: return "tick";
    case 3: return "n3";
    case 4: return "n4";
    case 5: return "n5";
    case 6: return "n6";
    case 7: return "n7";
    case 8: return "n8";
    case 9: return "n9";
    case 10: return "n10";
    default: return "n11";
  }
}
for (let i = 3; i < 12; i++) server.on(pick(i), a => lines.push(pick(i) + ": " + describe(a)));
for (let i = 0; i < 12; i++) server.emit(pick(i + process.argv.length - process.argv.length), i % 2 ? new Failure(i) : i);
