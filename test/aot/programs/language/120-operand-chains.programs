function b(k) { for (let i = 0; i < 3; i++) { if (k === 0) { log.push(i); continue; } if (k === 1) { log.push(i); break; } log.push(i); return "returned"; } return "fell"; }
function c(k) { outer: for (let i = 0; i < 2; i++) for (let j = 0; j < 2; j++) { if (k === 0) { log.push(i + j); continue outer; } if (k === 1) { log.push(i + j); break outer; } log.push(i + j); } return log.length; }
function d(k) { try { if (k === 0) { log.push("t"); throw 1.5; } if (k === 1) { log.push("t"); throw 2.5; } log.push("t"); } catch (e) { return e; } finally { log.push("f"); } return "none"; }
function e(k) { { let v = 1.5; if (k === 0) return v; } { let v = 2.5; if (k === 1) return v; } { let v = -0; return 1 / v; } }
var log = [];
for (const f of [a, b, c, d, e]) for (let k = 0; k < 3; k++) { log = []; console.log(f.name, k, String(f(k)), log.join()); }
//// array-pattern-destructuring.js
// Array binding patterns over iterators that log every step, arrays that change, and arrays with their own iterator.
const log = (...parts) => console.log(parts.join(" "));
const show = (values) => JSON.stringify(values.map((value) => (value === undefined ? "undefined" : value)));

////= result

function iterable(name, count, throwAtStep) {
  return {
    [Symbol.iterator]() {
      log(name, "Symbol.iterator");
      let index = 0;
      return {
        next() {
          log(name, "next");
          if (index + 1 === throwAtStep) throw "next error";
          return index < count ? result(name, false, index++) : result(name, true, undefined);
        },
        return() {
          log(name, "return");
          return {};
        },
      };
    },
  };
}

////= attempt-6	body(

for (const count of [0, 1, 2, 5]) {
  attempt("[a, b] of " + count, () => {
    const [a, b] = iterable("pair", count);
    log(show([a, b]));
  });
  attempt("[a, , b, ...r] of " + count, () => {
    const [a, , b, ...r] = iterable("rest", count);
    log(show([a, b]), show(r));
  });
  attempt("[] of " + count, () => {
    const [] = iterable("empty", count);
  });
  attempt("[...r] of " + count, () => {
    const [...r] = iterable("only rest", count);
    log(show(r));
  });
  attempt("assignment of " + count, () => {
    let a;
    let b;
    [a, b] = iterable("assigned", count);
    log(show([a, b]));
  });
}

