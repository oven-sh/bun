  function* numbers() {
    try {
      yield 1;
      yield 2;
    } finally {
      log("generator closed");
    }
  }
  const [g] = numbers();
  const [h, ...others] = numbers();
  log(show([a, b, key, value, first, g, h]), show(entries), show(characters), show(others));
});
