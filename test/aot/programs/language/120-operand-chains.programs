//// builtins-cannot-be-replaced/main.ts
// For every built-in function the compiler knows about, tries to overwrite, redefine and delete it, and prints which attempts are refused. A locked object keeps its members against all three: the namespaces Math, JSON, Reflect and Atomics, the constructors but for Function, the error constructors, WeakRef, FinalizationRegistry and DataView, and the prototypes but for those of the errors. The members that real packages replace are left out of the lock: Function.prototype.toString, String.prototype.at, the trim and the HTML methods of strings, the set-algebra methods of Set.prototype, Math.random, JSON.parse, Date.now, Date.prototype.toString and the like. These and every other built-in are constants only as long as the program does not write them, so here they answer as in plain Bun.
import "./impl.js";
//// builtins-only-inspect-arguments.ts
// Built-in functions that only inspect their arguments: what they print is right, and the arguments need not escape.
class Point { constructor(public x: number, public y: number, public on: boolean, public tag: string | null = null) {} }
const p = new Point(1, 2.5, true)
const q = new Point(-3, 4, false, "q")
console.log(JSON.stringify(p), JSON.stringify([p, q]), JSON.stringify({ p, list: [1, 2], deep: { q, flag: false } }))
console.log(Object.keys(p).join(), Object.values(q).join(), Object.entries(p).map(([k, v]) => k + "=" + v).join("&"))
const record = { id: 7, ok: true, name: "r", inner: { n: 0.5, none: null, missing: undefined }, items: [true, false] }
console.log(JSON.stringify(record), Object.keys(record.inner).length, typeof Object.values(record)[1], Object.values(record.items).join())
let sum = 0
for (let i = 0; i < 3; i++) { p.x += i; sum += p.x + q.y }
console.log(sum, p.x, p.on === true, q.on === false)
//// builtins-that-change-on-their-own.js
// Some built-in properties change without a store by the program: the static properties of RegExp after a match, `process.exitCode`, the clock. Each read gives the value of that moment, as in plain Bun.
function lastMatch() { return RegExp.lastMatch + " " + RegExp.$1 + " " + RegExp.leftContext; }
/(b)/.exec("abc");
console.log(lastMatch());
/(c)/.exec("abc");
console.log(lastMatch());
"xyz".replace(/(y)/, "");
console.log(lastMatch());
console.log(process.exitCode);
process.exitCode = 3;
console.log(process.exitCode);
process.exitCode = 0;
console.log(process.exitCode);
const before = performance.now();
let spins = 0;
while (performance.now() === before) spins++;
console.log(performance.now() > before, spins >= 0);
//// call-planted-above-a-built-in-function-through-native-code.mjs
// A built-in function refuses `call` as a property of its own. Planted one step up, by giving the function another prototype, it would be found all the same: the function keeps its prototype.
// The function goes through native code, so the compiler does not see what the change is made to.
////= handedThroughNativeCode
////= lines-11	planted	"planted ran"
const above = Object.create(Function.prototype);
above.call = planted;
above.apply = planted;
for (const [name, f, run] of [
  ["Array.prototype.map", Array.prototype.map, () => Array.prototype.map.call([1, 2], x => x * 2)],
  ["Array.prototype.filter", Array.prototype.filter, () => Array.prototype.filter.apply([1, 2], [x => x > 1])],
  ["Reflect.get", Reflect.get, () => Reflect.get.call(null, { a: 1 }, "a")],
  ["Function.prototype.call", Function.prototype.call, () => Function.prototype.call.call(Math.max, null, 1, 2)],
  ["Math.max", Math.max, () => Math.max.call(null, 1, 2)],
  ["Object.prototype.hasOwnProperty", Object.prototype.hasOwnProperty, () => Object.prototype.hasOwnProperty.call({ a: 1 }, "a")],
]) {
  const ways = [];
  const unseen = handedThroughNativeCode(f);
  ways.push(Reflect.setPrototypeOf(unseen, above) ? "changed" : "refused");
  try {
    Object.setPrototypeOf(unseen, above);
    ways.push("changed");
  } catch (error) {
    ways.push(error.constructor.name);
  }
  try {
    unseen.__proto__ = above;
    ways.push("changed");
  } catch (error) {
    ways.push(error.constructor.name);
  }
  const answer = String(run());
  ways.push(Reflect.setPrototypeOf(unseen, Function.prototype) ? "Function.prototype is taken" : "Function.prototype is refused");
  console.log(name, "|", ways.join(", "), "|", answer, "|", Object.getPrototypeOf(f) === Function.prototype);
}
//// call-sites-of-compiled-frames.ts
// What Error.prepareStackTrace call sites and Error.captureStackTrace report for compiled frames, and for frames of other kinds between them.
import path from "node:path";

const errorClass: any = Error;
// The sites a function below gets are used twice, because plain Bun's transpiler puts a constant that is used once in the place of its use,
// and `return captureSites()` is a tail call, which drops the frame of its caller.
let lastSites: any;

function readSites(read: () => any): any {
  const earlier = errorClass.prepareStackTrace;
  errorClass.prepareStackTrace = (_error: unknown, sites: any[]) => sites;
  const sites = read();
  errorClass.prepareStackTrace = earlier;
  lastSites = sites;
  return sites;
}

function captureSites(): any {
  const sites = readSites(() => new Error("site").stack);
  lastSites = sites;
  return sites;
}

function captureAbove(fn: any): any {
  const sites = readSites(() => {
    const target: any = {};
    errorClass.captureStackTrace(target, fn);
    return target.stack;
  });
  lastSites = sites;
  return sites;
}

function showFile(file: any): any {
  if (typeof file !== "string") return file;
  return /^\[source:\d+\]$/.test(file) ? "[source]" : path.basename(file);
}

const programFile = showFile(captureSites()[0].getFileName());

function sitesInProgram(sites: any[]): any[] {
  const files = sites.map(site => showFile(site.getFileName()));
  return sites.slice(0, files.lastIndexOf(programFile) + 1);
}

// Two columns are left out. A call site of plain Bun puts a `new` expression where it starts, its `stack` string where the callee starts, as compiled code does in both.
// A text given to `new Function` has no source map in plain Bun, so a call in it is put behind its callee.
function showSite(site: any, callee: any): string {
  const isNewExpression = !!callee && callee.isConstructor();
  const isInEvaluatedText = site.getFunctionName() === "anonymous";
  return [
    site.getFunctionName(),
    site.getTypeName(),
    site.getMethodName(),
    showFile(site.getFileName()),
    site.getLineNumber(),
    isNewExpression || isInEvaluatedText ? "-" : site.getColumnNumber(),
    site.isConstructor(),
    site.isNative(),
    site.isToplevel(),
    site.isAsync(),
    site.isEval(),
  ].join(" | ");
}

function report(label: string, sites: any[]): void {
  console.log(label);
  const shown = sitesInProgram(sites);
  for (let index = 0; index < shown.length; index++) console.log("  " + showSite(shown[index], shown[index - 1]));
}

function reportNames(label: string, sites: any[]): void {
  console.log(label + ": " + sitesInProgram(sites).map(site => site.getFunctionName()).join(" < "));
}

////= lines-4	plainFunction	captureSites

const arrowInVariable = (): any => {
  const sites = captureSites();
  lastSites = sites;
  return sites;
};

class Shape {
  sites: any;
  constructor() {
    this.sites = captureSites();
  }
  method(): any {
    const sites = captureSites();
    lastSites = sites;
    return sites;
  }
  static staticMethod(): any {
    const sites = captureSites();
    lastSites = sites;
    return sites;
  }
  get value(): any {
    const sites = captureSites();
    lastSites = sites;
    return sites;
  }
  async asyncMethod(): Promise<any> {
    await null;
    const sites = captureSites();
    lastSites = sites;
    return sites;
  }
}

////= lines-4	renamedAtRunTime	captureSites
Object.defineProperty(renamedAtRunTime, "name", { value: "nameSetAtRunTime" });

async function asyncFunction(): Promise<any> {
  await null;
  const sites = captureSites();
  lastSites = sites;
  return sites;
}

async function asyncCaller(): Promise<any> {
  const sites = await asyncFunction();
  lastSites = sites;
  return sites;
}

async function asyncMethodCaller(): Promise<any> {
  const sites = await new Shape().asyncMethod();
  lastSites = sites;
  return sites;
}

report("module top level", captureSites());
report("plain function", plainFunction());
report("arrow in a variable", arrowInVariable());
report("method", new Shape().method());
report("static method", Shape.staticMethod());
report("getter", new Shape().value);
report("new", new Shape().sites);
report("name redefined at run time", renamedAtRunTime());
report(
  "callback of Array.prototype.map",
  [1].map(() => {
    const sites = captureSites();
    lastSites = sites;
    return sites;
  })[0],
);

////= lines-4	outerFrame	middleFrame
////= lines-4	middleFrame	innerFrame
////= lines-8	innerFrame	captureAbove	outerFrame
////= lines-4	callsOuterFrame	outerFrame
reportNames("captureStackTrace above a function three frames up", callsOuterFrame());

////= lines-8	captureAboveClass	captureAbove	CapturedClass
class CapturedClass {
  sites: any;
  constructor() {
    this.sites = captureAboveClass();
  }
}
function constructsCapturedClass(): any {
  const sites = new CapturedClass().sites;
  lastSites = sites;
  return sites;
}
reportNames("captureStackTrace above a class constructor", constructsCapturedClass());

////= lines-8	boundTarget	captureAbove	boundFunction
const boundFunction = boundTarget.bind(null);
////= lines-4	callsBoundFunction	boundFunction
reportNames("captureStackTrace above a bound function", callsBoundFunction());

function neverCalled(): void {}
////= lines-8	capturesAboveNeverCalled	captureAbove	neverCalled
reportNames("captureStackTrace above a function never called", capturesAboveNeverCalled());

const notCompiled = new Function("callback", "const sites = callback(); return sites;");
////= lines-4	calledByNotCompiled	captureSites
////= lines-8	callsNotCompiled	notCompiled	calledByNotCompiled
report("function not compiled between compiled frames", callsNotCompiled());

function captureWithoutFrames(): string {
  const earlierLimit = errorClass.stackTraceLimit;
  errorClass.stackTraceLimit = 0;
  const sites = captureSites();
  errorClass.stackTraceLimit = earlierLimit;
  return Array.isArray(sites) ? "sites: " + sites.length : typeof sites;
}
console.log("Error.stackTraceLimit = 0: " + captureWithoutFrames());

let sitesInStreamStart: any = [];
new (globalThis as any).ReadableStream({
  start() {
    sitesInStreamStart = captureSites();
  },
});
reportNames("callback of a private built-in", sitesInStreamStart);
console.log(
  "private built-in listed: " +
    sitesInProgram(sitesInStreamStart).some(site => site.getFunctionName() === "setupReadableStreamDefaultController"),
);

asyncCaller()
  .then(sites => {
    report("async function after await", sites);
    return asyncMethodCaller();
  })
  .then(sites => report("async method after await", sites));
//// cast-unrelated.ts
// An object created as one type is cast, through `any`, to an unrelated type.
interface Sys { read(p: string): string; cwd(): string; args: string[] }
interface Host { read(p: string): string; cwd(): string; onError: (m: string) => void }
const sys: Sys = { read: p => "r:" + p, cwd: () => "/", args: ["x"] }
function use(h: Host) { h.onError(h.read("a") + h.cwd()) }
function withSystem(system: Sys) {
  const host: Host = system as any
  host.onError = m => console.log("error", m)
  use(host)
  host.onError = undefined!
}
withSystem(sys)
console.log(Object.keys(sys).join(), sys.read("b"), sys.args.length, (sys as any).onError)
withSystem(sys)
export {}
//// catch-block-that-rethrows.ts
// A `catch` block that rethrows what it caught.
function boom(v: unknown): never { throw v }
const rows: string[] = [];
function original(p: number) { const out: number[] = []; try { throw p + p; } catch (e1: any) { try { throw e1; } catch (e2: any) { out.push(e1 + e2); } } return out.join(); }
rows.push("1 " + original(4));
function innerOnly(p: number) { let r = ""; try { throw p + p; } catch (e1: any) { try { throw e1; } catch (e2: any) { r = "e2 " + e2; } } return r; }
rows.push("2 " + innerOnly(4));
function outerOnly(p: number) { let r = ""; try { throw p + p; } catch (e1: any) { try { throw e1; } catch (e2: any) { r = "e1 " + e1; } } return r; }
rows.push("3 " + outerOnly(4));
function another(p: number) { let r = ""; try { throw p + p; } catch (e1: any) { try { throw 5; } catch (e2: any) { r = "e1 " + e1 + " e2 " + e2; } } return r; }
rows.push("4 " + another(4));
function byCall(p: number) { let r = ""; try { boom(p + p); } catch (e1: any) { try { boom(e1); } catch (e2: any) { r = "e1 " + e1 + " e2 " + e2; } } return r; }
rows.push("5 " + byCall(4));
function calledThenThrown(p: object) { let r = false; try { boom(p); } catch (e1: any) { try { throw e1; } catch (e2: any) { r = e1 === e2 && e1 === p; } } return r; }
rows.push("6 " + calledThenThrown({ a: 1 }));
function afterBoth(p: number) { let kept: unknown; try { throw "s" + p; } catch (e1) { try { throw e1; } catch { kept = e1; } finally { kept = kept + "!"; } } return kept; }
rows.push("7 " + afterBoth(4));
// Nothing inspects the caught value.
function plainRethrow(p: number) { try { try { boom(p); } catch (e) { throw e; } } catch (e2) { return "caught " + e2; } return "not reached"; }
rows.push("8 " + plainRethrow(4));
function rethrowTwice(p: number) { try { try { try { boom(p); } catch (a) { throw a; } } catch (b) { throw b; } } catch (c) { return "caught " + c; } return "not reached"; }
rows.push("9 " + rethrowTwice(4));
// Out of the function.
function outOfIt(p: number) { try { boom(p); } catch (e) { throw e; } }
try { outOfIt(4); rows.push("10 not reached"); } catch (e) { rows.push("10 " + e); }
// A loop over an array in between, whose iterator is closed on the way.
function throughLoop(list: number[]) { let seen = 0; try { for (const v of list) { seen += v; if (v === 2) boom("at " + v); } } catch (e1) { try { throw e1; } catch (e2) { return e1 + " " + e2 + " " + seen; } } return "none"; }
rows.push("11 " + throughLoop([1, 2, 3]));
console.log(rows.join("\n"));

export {};
//// class-name-assigned-inside-class.js
// Within a class its name is a constant: an assignment evaluates its right side and throws a TypeError.
const log = [];
function tell(name, f) {
  try {
    console.log(name, f());
  } catch (error) {
    console.log(name, error.constructor.name, error.message, log.splice(0).join());
  }
}
const value = () => (log.push("the right side"), 42);
tell("a constructor", () => { class C { constructor() { C = value(); } } return new C(); });
tell("a constructor of an expression", () => new (class C { constructor() { C = value(); } })());
tell("a method", () => { class C { m() { C = value(); } } return new C().m(); });
tell("a method of an expression", () => new (class C { m() { C = value(); } })().m());
tell("a getter", () => { class C { get x() { C = value(); return 1; } } return new C().x; });
tell("a setter", () => { class C { set x(_) { C = value(); } } return (new C().x = 15); });
tell("a static method", () => { class C { static m() { C = value(); } } return C.m(); });
tell("a field", () => { class C { f = (C = value()); } return new C().f; });
tell("a static block", () => { class C { static { C = value(); } } return C; });
tell("an arrow function in a method", () => { class C { m() { return () => { C = value(); }; } } return new C().m()(); });
tell("+=", () => { class C { m() { C += value(); } } return new C().m(); });
tell("++", () => { class C { m() { C++; } } return new C().m(); });
tell("a pattern", () => { class C { m() { [C] = [value()]; } } return new C().m(); });
tell("another class's name", () => { let D = class {}; class C { m() { D = value(); return D; } } return new C().m(); });
tell("a parameter of that name", () => { class C { m(C) { C = value(); return C; } } return new C().m(); });
class AtTheTop { m() { AtTheTop = value(); } }
tell("at the top level", () => new AtTheTop().m());
