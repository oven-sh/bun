//// a-switch-lists-every-remainder-of-a-count.ts
let sum = 0;
for (let i = 0; i < 30; i++) {
  switch (i % 3) {
    case 0: sum += 1; break;
    case 1: sum += 10; break;
    case 2: sum += 100; break;
    default: sum -= 1000;
  }
}
console.log(sum);
//// a-switch-lists-every-remainder-of-a-count-that-begins-below-zero.ts
let sum = 0;
let rest = 0;
for (let i = 0; i < 30; i++) {
  switch ((i - 5) % 3) {
    case 0: sum += 1; break;
    case 1: sum += 10; break;
    case 2: sum += 100; break;
    default: rest++;
  }
}
console.log(sum, rest);
//// a-switch-lists-every-whole-remainder-of-a-count-of-halves.ts
let sum = 0;
let rest = 0;
for (let i = 0; i < 30; i++) {
  switch ((i * 0.5) % 3) {
    case 0: sum += 1; break;
    case 1: sum += 10; break;
    case 2: sum += 100; break;
    default: rest++;
  }
}
console.log(sum, rest);
//// a-switch-lists-every-remainder-with-its-sign-turned.ts
let sum = 0;
let rest = 0;
for (let i = 0; i < 30; i++) {
  switch (-(i % 3)) {
    case 0: sum += 1; break;
    case -1: sum += 10; break;
    case -2: sum += 100; break;
    default: rest++;
  }
}
console.log(sum, rest);
//// a-switch-lists-all-values-of-its-subject-but-one.ts
let sum = 0;
let rest = 0;
for (let i = 0; i < 32; i++) {
  switch (i & 3) {
    case 0: sum += 1; break;
    case 1: sum += 10; break;
    case 2: sum += 100; break;
    default: rest++;
  }
}
console.log(sum, rest);
//// several-cases-of-a-switch-that-lists-every-value-go-one-way.ts
let sum = 0;
for (let i = 0; i < 32; i++) {
  switch (i & 3) {
    case 0:
    case 2: sum += 1; break;
    case 1: sum += 10; break;
    case 3: sum += 100; break;
    default: sum -= 1000;
  }
}
console.log(sum);
//// the-last-case-of-a-switch-that-lists-every-value-falls-through-to-the-rest.ts
let sum = 0;
for (let i = 0; i < 30; i++) {
  switch (i % 3) {
    case 0: sum += 1; break;
    case 1: sum += 10; break;
    case 2: sum += 100;
    default: sum += 0.25;
  }
}
console.log(sum);
//// the-rest-stands-in-front-of-the-cases-of-a-switch-that-lists-every-value.ts
let sum = 0;
for (let i = 0; i < 30; i++) {
  switch (i % 3) {
    default: sum -= 7;
    case 2: sum += 100; break;
    case 0: sum += 1; break;
    case 1: sum += 10; break;
  }
}
console.log(sum);
//// a-switch-lists-every-element-of-a-list-that-is-read-past-its-end.ts
let sum = 0;
let rest = 0;
for (let i = 0; i < 32; i++) {
  switch ([0, 1, 2][i % 4]) {
    case 0: sum += 1; break;
    case 1: sum += 10; break;
    case 2: sum += 100; break;
    default: rest++;
  }
}
console.log(sum, rest);
//// a-switch-that-lists-every-value-chooses-a-number-or-a-text-and-a-test-follows.ts
let sum = 0;
for (let i = 0; i < 30; i++) {
  let picked: number | string | undefined;
  switch (i % 3) {
    case 0: picked = 10; break;
    case 1: picked = "one"; break;
    case 2: picked = 12; break;
  }
  const by = i & 1 ? 1 : 2;
  sum += typeof picked === "number" ? picked * by : typeof picked === "string" ? picked.length : -by;
}
console.log(sum);
