  try { RegExp.prototype.exec = function () { return null; }; planted.push("exec"); } catch (e) { planted.push("refused exec " + e.name); }
  try { Promise.prototype.then = function () { log.push("other Promise then"); return "x"; }; planted.push("Promise.then"); } catch (e) { planted.push("refused Promise.then " + e.name); }
  try { Date.prototype.toJSON = function () { return "other date"; }; planted.push("Date.toJSON"); } catch (e) { planted.push("refused Date.toJSON " + e.name); }
  try { Function.prototype.call = function () { return "other call"; }; planted.push("call"); } catch (e) { planted.push("refused call " + e.name); }
  try { Object.defineProperty(Object.getPrototypeOf(Uint8Array.prototype), "length", { get() { return "other length"; } }); planted.push("typed length"); } catch (e) { planted.push("refused typed length " + e.name); }
  ({ planted, log, holes: () => [0, , , , 4], dense: () => [1, 2, 3], doubles: () => [1.5, , 3.5], texts: () => ["a", , "c"], object: () => ({ a: 1 }), map: () => new Map([[1, 2]]), set: () => new Set([1]), regexp: () => /a/g, date: () => new Date(0), typed: () => new Uint8Array(2), promise: () => Promise.resolve(1), fn: () => function (x) { return x; }, error: () => new Error("m"), text: () => new String("s"), Array, Object, Map })
`, context); return F.planted; });
const ops = { "a[1]": a => a[1], "a[2]": a => a[2], "a[3]": a => a[3], "a[9]": a => a[9], "1 in a": a => 1 in a, "length": a => a.length, "a[3] = 1": a => { a[3] = 1; return Object.keys(a); }, "a[5] = 1": a => { a[5] = 1; return a.length; }, "spread": a => [...a], "for-of": a => { const r = []; for (const v of a) r.push(v); return r; }, "for-i": a => { const r = []; for (let i = 0; i < a.length; i++) r.push(a[i]); return r; }, "destructure": a => { const [x, y, z, w] = a; return [x, y, z, w]; }, "push": a => a.push(9), "own push": a => Array.prototype.push.call(a, 9), "join": a => a.join("-"), "own join": a => Array.prototype.join.call(a, "-"), "String": a => String(a), "template": a => `${a}`, "slice": a => a.slice(), "own slice": a => Array.prototype.slice.call(a), "own map": a => Array.prototype.map.call(a, x => x), "own filter": a => Array.prototype.filter.call(a, () => true), "own concat": a => Array.prototype.concat.call(a, [1]), "[].concat(a)": a => [].concat(a), "own indexOf": a => Array.prototype.indexOf.call(a, "inherited"), "own includes": a => Array.prototype.includes.call(a, "inherited"), "own forEach": a => { const r = []; Array.prototype.forEach.call(a, (v, i) => r.push(i)); return r; }, "own reduce": a => Array.prototype.reduce.call(a, (s, v) => s + "|" + v, ""), "own at": a => Array.prototype.at.call(a, 1), "own pop": a => { a.length = 4; return Array.prototype.pop.call(a); }, "own shift": a => [Array.prototype.shift.call(a), Object.keys(a)], "own reverse": a => Object.keys(Array.prototype.reverse.call(a)), "own sort": a => Object.keys(Array.prototype.sort.call(a)), "own fill": a => Object.keys(Array.prototype.fill.call(a, 0)), "isArray": a => Array.isArray(a), "instanceof": a => [a instanceof Array, a instanceof F.Array, a instanceof Object], "JSON": a => JSON.stringify(a), "JSON in": a => JSON.stringify({ a }), "keys": a => Object.keys(a), "entries": a => Object.entries(a), "values": a => Object.values(a), "assign": a => Object.assign({}, a), "object spread": a => ({ ...a }), "Array.from": a => Array.from(a), "new Set": a => [...new Set(a)], "Math.max": a => Math.max(...a), "apply": a => Math.max.apply(null, a), "toString tag": a => Object.prototype.toString.call(a), "for-in": a => { const r = []; for (const k in a) r.push(k); return r; }, "name": a => a.inheritedName, "name in": a => "inheritedName" in a, "a + ''": a => a + "", "+a": a => +a, "a == 42": a => a == 42, "typeof": a => typeof a, "structuredClone": a => structuredClone(a), "proto": a => Object.getPrototypeOf(a) === Array.prototype, "new Uint8Array": a => [...new Uint8Array(a)], "flat": a => Array.prototype.flat.call([a, a]), "Promise.all": a => typeof Promise.all(a), "Object.fromEntries": a => Object.fromEntries([a]), "new Map": a => [...new Map([a])] };
for (const kind of ["holes", "dense", "doubles", "texts"]) for (const [n, op] of Object.entries(ops)) { for (let i = 0; i < 20; i++) { try { op([0, 1, 2, 3, 4]); } catch {} } F.log.length = 0; run(kind + " " + n, () => op(F[kind]())); if (F.log.length) say("   log", [...F.log]); }
const others = { "object.a": () => F.object().a, "object name": () => F.object().inheritedName, "object JSON": () => JSON.stringify(F.object()), "object JSON nested": () => JSON.stringify({ o: F.object(), p: 1 }), "object spread": () => ({ ...F.object() }), "object keys": () => Object.keys(F.object()), "object for-in": () => { const r = []; for (const k in F.object()) r.push(k); return r; }, "object + ''": () => F.object() + "", "object template": () => `${F.object()}`, "object tag": () => Object.prototype.toString.call(F.object()), "object [2]": () => F.object()[2], "object await": () => { (async () => say("   awaited", await F.object()))(); return "started"; }, "object resolve": () => { Promise.resolve(F.object()).then(v => say("   resolved", v)); return "started"; }, "object async return": () => { (async () => F.object())().then(v => say("   returned", v)); return "started"; }, "object hasOwn": () => Object.hasOwn(F.object(), "inheritedName"), "object descriptor": () => Object.getOwnPropertyDescriptor(F.object(), "a"), "define with foreign descriptor": () => Object.getOwnPropertyDescriptor(Object.defineProperty({}, "k", vm.runInContext("({ value: 1 })", context)), "k"),
  "map.get": () => F.map().get(1), "own Map get": () => Map.prototype.get.call(F.map(), 1), "map.size": () => F.map().size, "map spread": () => [...F.map()], "map instanceof": () => F.map() instanceof Map, "map for-of": () => { const r = []; for (const e of F.map()) r.push(e); return r; }, "new Map(map)": () => [...new Map(F.map())], "set spread": () => [...F.set()], "set.has": () => F.set().has(1), "regexp test": () => F.regexp().test("a"), "own test": () => RegExp.prototype.test.call(F.regexp(), "a"), "replace": () => "aaa".replace(F.regexp(), "b"), "match": () => "aaa".match(F.regexp()), "split": () => "a,a".split(F.regexp()), "date JSON": () => JSON.stringify(F.date()), "date JSON nested": () => JSON.stringify({ d: F.date() }), "date getTime": () => F.date().getTime(), "date +": () => +F.date(), "typed length": () => F.typed().length, "typed spread": () => [...F.typed()], "typed [0]": () => F.typed()[0], "typed own length": () => Object.getOwnPropertyDescriptor(Object.getPrototypeOf(Uint8Array.prototype), "length").get.call(F.typed()), "typed TextDecoder": () => new TextDecoder().decode(F.typed()), "typed set": () => { const t = new Uint8Array(4); t.set(F.typed()); return [...t]; }, "typed Buffer.from": () => Buffer.from(F.typed()).length, "promise await": () => { (async () => say("   awaited promise", await F.promise()))(); return "started"; }, "promise then": () => F.promise().then(() => 1), "promise resolve": () => Promise.resolve(F.promise()) instanceof Promise, "promise all": () => { Promise.all([F.promise()]).then(v => say("   all", v), e => say("   all failed", String(e))); return "started"; }, "fn()": () => F.fn()(5), "fn.call": () => F.fn().call(null, 5), "own call": () => Function.prototype.call.call(F.fn(), null, 5), "fn.apply": () => F.fn().apply(null, [5]), "fn.bind": () => F.fn().bind(null, 5)(), "fn instanceof": () => F.fn() instanceof Function, "new fn": () => typeof new (F.fn())(), "class extends fn": () => { class C extends F.fn() { x = 1; } return Object.keys(new C()); }, "class extends foreign Array": () => { class C extends F.Array {} const c = new C(); c[0] = 1; return [c.length, c[1], Array.isArray(c), c instanceof Array]; }, "class extends foreign Map": () => { class C extends F.Map {} return new C([[1, 2]]).get(1); }, "error": () => [F.error() instanceof Error, F.error().message, Error.isError(F.error()), String(F.error())], "text": () => [F.text() + "", F.text().length, F.text().trim(), `${F.text()}`], "Reflect.construct foreign newTarget": () => Object.getPrototypeOf(Reflect.construct(Array, [], F.Array)) === F.Array.prototype, "Reflect.construct class foreign newTarget": () => { class P { x = 1; } const o = Reflect.construct(P, [], F.Object); return [Object.keys(o), Object.getPrototypeOf(o) === F.Object.prototype, o.inheritedName]; }, "Object.create foreign": () => { const o = Object.create(F.object()); return [o.a, o.inheritedName, o[2], JSON.stringify(o)]; }, "setPrototypeOf foreign": () => { class P { x = 1; } const o = Object.setPrototypeOf(new P(), F.object()); return [o.x, o.a, o.inheritedName, o[2], JSON.stringify(o), `${o}`]; }, "own array over foreign proto": () => { const a = Object.setPrototypeOf([0, , , , 4], F.Array.prototype); return [a[1], a[2], a[3], [...a], a.join("-"), JSON.stringify(a)]; } };
