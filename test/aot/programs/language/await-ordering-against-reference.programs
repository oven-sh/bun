//// numbers-and-text-through-built-ins.ts
// Numbers and text through built ins.
declare const process: any;
const out: string[] = [];
function put(label: string, v: unknown) { out.push(label + " " + (typeof v === "number" ? (Object.is(v, -0) ? "-0" : String(v)) : typeof v === "string" ? JSON.stringify(v) : String(v))); }
function guard(label: string, f: () => unknown) { try { put(label, f()); } catch (e: any) { out.push(label + " throws " + e.constructor.name); } }
const wide = (s: string): string => (s + "Ā").slice(0, -1);
const rope = (s: string): string => s.length < 2 ? s : s.slice(0, 1) + s.slice(1) + ["", ""][out.length & 1];
const texts: string[] = ["", " ", "0", "-0", "+0", "00012", "12", "-12", "+12", "12px", "px12", "0x1F", "0X1f", "-0x10", "+0x10", "0x", "0xg", "0b101", "0B11", "0b2", "0o17", "0O7", "0o8", "1e3", "1E+3", "1e-3", "1e", "1e+", ".5", "5.", ".", "+.5e-2", "-.5", "Infinity", "-Infinity", "+Infinity", "infinity", "INFINITY", "Infinityx", "NaN", "1_000", "١٢", " 12﻿", "\t\n12\r\n", "  5 ", "5\u0000", "\u00005", "᠎5", "１２", "0x1p3", "1n", "9007199254740993", "9007199254740992", "999999999999999", "9999999999999999", "123456789012345", "1234567890123456", "000000000000000000001", "1e400", "-1e400", "4.9e-324", "2.4703282292062328e-324", "2.4703282292062327e-324", "1.7976931348623157e308", "1.7976931348623159e308", "0.1e1", "0.30000000000000004", "1".repeat(25), "1".repeat(310), "0." + "0".repeat(330) + "1", "9".repeat(800), "1 2", "1,2", "--1", "+-1", "1e1.5", "0x1.8", "1.2.3", "z", "Z", "zz", "10", "11", "7fffffff", "80000000", "ffffffff", "100000000", "-80000000", "2147483647", "2147483648", "-2147483648", "-2147483649", "4294967295", "4294967296", "1e21", "1e-7", "123e-20", "0e0", "-0e0", "-0.0", "0.0000001", " 12 ", "12 34", "\n", "\v\f", "null", "undefined", "true", "[object Object]", "١٢٣", "1e1000", "-", "+", "e5", "E5", "0e", "0x0", "-0x0", "0b", "0o", "０", "1 ", "﻿", "1﻿2"];
const radixes: number[] = [0, 1, 2, 3, 8, 10, 16, 32, 36, 37, -1, -16, NaN, Infinity, 16.9, 2 ** 32 + 10, 2 ** 32 + 16, 10.5, 2 ** 31 + 2, -(2 ** 32) + 16];
function parse10(s: string): number { return parseInt(s, 10); }
function parseNone(s: string): number { return parseInt(s); }
function parse16(s: string): number { return parseInt(s, 16); }
function parseR(s: string, r: number): number { return parseInt(s, r); }
function parseF(s: string): number { return parseFloat(s); }
function num(s: string): number { return Number(s); }
function plus(s: string): number { return +s; }
function times(s: string): number { return (s as any) * 1; }
function minus(s: string): number { return (s as any) - 0; }
function bits(s: string): number { return (s as any) | 0; }
function ubits(s: string): number { return (s as any) >>> 0; }
function nan(s: string): boolean { return isNaN(s as any); }
function fin(s: string): boolean { return isFinite(s as any); }
function less(s: string): boolean { return (s as any) < 5; }
function eq(s: string): boolean { return (s as any) == 12; }
function np(s: string): number { return Number.parseFloat(s) + Number.parseInt(s, 10); }
for (const base of texts) for (const [form, s] of [["8", base], ["16", wide(base)], ["r", rope(base)]] as [string, string][]) {
  const l = form + JSON.stringify(base.length > 30 ? base.slice(0, 12) + "#" + base.length : base);
  put("parseInt10 " + l, parse10(s)); put("parseInt " + l, parseNone(s)); put("parseInt16 " + l, parse16(s)); put("parseFloat " + l, parseF(s)); put("Number " + l, num(s)); put("+ " + l, plus(s)); put("* " + l, times(s)); put("- " + l, minus(s)); put("|0 " + l, bits(s)); put(">>>0 " + l, ubits(s)); put("isNaN " + l, nan(s)); put("isFinite " + l, fin(s)); put("<5 " + l, less(s)); put("==12 " + l, eq(s)); put("np " + l, np(s));
  if (form === "8") for (const r of radixes) put("parseInt r" + r + " " + l, parseR(s, r));
}
const numbers: number[] = [0, -0, 1, -1, 0.5, -0.5, 255, -255, 255.5, -255.5, 1e21, 1e-7, 1.5e-7, 123456789.12345679, 2 ** 53, 2 ** 53 + 2, -(2 ** 53), 2 ** 31, 2 ** 31 - 1, -(2 ** 31), -(2 ** 31) - 1, 2 ** 32, 2 ** 32 - 1, 0.1, 0.2, 0.30000000000000004, 1 / 3, NaN, Infinity, -Infinity, 5e-324, 1.7976931348623157e308, 1e20, 1e21 - 65536, 999999999999999900000, 1.005, 1.255, 2.5, 3.5, -2.5, 0.000001, 0.0000001, 1234.5678, 100, 1e100, 4.35, 0.045, 25, 1.45, 8.345, 0.5e-6, 10.235, 1e-10, 123.456, 5e-7, 9.995, 0.9999999, 99.99, 1.0000000000000002, 4503599627370495.5, 72057594037927940, 35, 36, 1295, 46655.5];
function toS(n: number): string { return n.toString(); }
function toSR(n: number, r: number): string { return n.toString(r); }
function str(n: number): string { return String(n); }
function tpl(n: number): string { return `${n}`; }
function cat(n: number): string { return "" + n; }
function cat2(n: number): string { return n + "|" + n; }
function fixed(n: number, d: number): string { return n.toFixed(d); }
function prec(n: number, d: number): string { return n.toPrecision(d); }
function expo(n: number, d: number): string { return n.toExponential(d); }
function json(n: number): string { return JSON.stringify(n); }
function jsonIn(n: number): string { return JSON.stringify({ n, a: [n] }); }
function key(n: number): string { return Object.keys({ [n]: 1 })[0]; }
function loc(n: number): string { return n.toLocaleString("en-US"); }
for (const n of numbers) {
  const l = Object.is(n, -0) ? "-0" : String(n);
  put("toString " + l, toS(n)); put("String " + l, str(n)); put("template " + l, tpl(n)); put("''+ " + l, cat(n)); put("n|n " + l, cat2(n)); put("JSON " + l, json(n)); put("JSON in " + l, jsonIn(n)); put("key " + l, key(n)); put("locale " + l, loc(n));
  for (const r of [2, 3, 7, 8, 10, 16, 32, 36, 1, 37, 0, NaN, 16.9, -2, Infinity]) guard("toString(" + r + ") " + l, () => toSR(n, r));
