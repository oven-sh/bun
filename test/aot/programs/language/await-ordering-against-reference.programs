const say = (...a) => console.log(a.map(v => typeof v === "string" ? v : typeof v === "symbol" ? v.toString() : typeof v === "bigint" ? v + "n" : Object.is(v, -0) ? "-0" : typeof v === "function" ? "function" : v === undefined ? "undefined" : JSON.stringify(v)).join(" "));
