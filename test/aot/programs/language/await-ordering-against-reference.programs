//// json-through-built-ins.ts
// Json through built ins.
const out: string[] = [];
const esc = (s: string) => JSON.stringify(s).replace(/[\u007f-￿]/g, c => "\\u" + c.charCodeAt(0).toString(16).padStart(4, "0"));
interface Inner { id: number; tag: string }
interface Rec { a: number; b: string; c: boolean; d: null; e: number[]; f: Inner; g?: string; h: string[]; i: Inner[] }
function describe(v: any, depth = 0): string {
  if (v === null) return "null"; if (typeof v === "number") return Object.is(v, -0) ? "-0" : String(v); if (typeof v === "string") return esc(v); if (typeof v !== "object") return String(v);
  if (depth > 6) return "..."; if (Array.isArray(v)) return "[" + v.map(x => describe(x, depth + 1)).join(",") + "]";
  return (Object.getPrototypeOf(v) === Object.prototype ? "" : "^") + "{" + Reflect.ownKeys(v).map(k => esc(String(k)) + ":" + describe(v[k as any], depth + 1)).join(",") + "}";
}
function typed(text: string): string { const v: Rec = JSON.parse(text); return describe(v); }
function typedUse(text: string): string { const v: Rec = JSON.parse(text); return [v.a, v.b, v.c, v.d, v.e?.length, v.f?.id, v.f?.tag, v.g, v.h?.[0], v.i?.[0]?.id].map(x => describe(x)).join("|"); }
function typedArray(text: string): string { const v: Inner[] = JSON.parse(text); return describe(v); }
function typedNumbers(text: string): string { const v: number[] = JSON.parse(text); return describe(v); }
function typedInner(text: string): string { const v: Inner = JSON.parse(text); return describe(v) + "|" + JSON.stringify(v) + "|" + Object.keys(v).join(); }
function untyped(text: string): string { return describe(JSON.parse(text)); }
function again(text: string): string { const v: Rec = JSON.parse(text); return JSON.stringify(v) + JSON.stringify(v, null, 1).length + JSON.stringify([v]) + JSON.stringify({ v }); }
function revived(text: string): string { const seen: string[] = []; const v = JSON.parse(text, function (k, x) { seen.push(k); return typeof x === "number" ? x + 1 : x; }); return describe(v) + seen.join(); }
const ways: [string, (t: string) => string][] = [["typed", typed], ["use", typedUse], ["array", typedArray], ["numbers", typedNumbers], ["inner", typedInner], ["untyped", untyped], ["again", again], ["revived", revived]];
function run(text: string) { for (const [n, f] of ways) { let r: string; try { r = f(text); } catch (e: any) { r = "throws " + e.constructor.name; } out.push(n + " " + esc(text.length > 90 ? text.slice(0, 80) + "#" + text.length : text) + " => " + r); } }
