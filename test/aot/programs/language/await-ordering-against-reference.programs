  try { Object.prototype[Symbol.toStringTag] = "OtherTag"; planted.push("tag"); } catch (e) { planted.push("refused tag " + e.name); }
  try { Array.prototype.push = function () { return "other push"; }; planted.push("push"); } catch (e) { planted.push("refused push " + e.name); }
  try { Array.prototype.join = function () { return "other join"; }; planted.push("join"); } catch (e) { planted.push("refused join " + e.name); }
