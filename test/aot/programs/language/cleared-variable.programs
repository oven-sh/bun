export interface Shape { size: number }
export const name: string = "the import";
export const onlyInTheText: string = "named by nothing but the text of an eval";
export let count: number = 0;
export function bump(): void { count++; }
export default function fallback(): string { return "the default"; }
//// direct-eval-sloppy-declarations.js
// A sloppy direct eval declares in the function that called it, also from inside catch (e). In a strict caller the eval keeps its declarations.
module.exports = {};

////= show

function declares(a) {
  eval("var x = 1; var a = 2; function g() { return x }");
  return [x, a, g()];
}
show("var, parameter and function", () => declares(0));
show("declared again on the next call", () => declares(0));

function declaresTwice() {
  eval("var t = 1; function h() { return 1 }");
  eval("var t = t + 1; function h() { return 2 }");
  return [t, h()];
}
show("same name from two calls", declaresTwice);

function deletes() {
  eval("var d = 1");
  const didDelete = delete d;
  return [didDelete, typeof d];
}
show("delete", deletes);

function createCounter() {
  eval("var count = 1; var setCount = function (value) { count = value };");
  return { setCount, getCount: () => count };
}
const counter = createCounter();
counter.setCount(5);
show("closure stores after return", () => counter.getCount());

function redeclaresBlockLet() {
  {
    let y = 1;
    eval("var y = 2");
    return y;
  }
}
show("var over let in a block", redeclaresBlockLet);

////= lines-9	redeclaresCatchParameter	"var e = 2"
show("var over the parameter of catch (e)", redeclaresCatchParameter);

function redeclaresCatchPattern() {
  try {
    throw { e: 1 };
  } catch ({ e }) {
    eval("var e");
    return e;
  }
}
show("var over the parameter of catch ({ e })", redeclaresCatchPattern);

// Class code is always strict. Plain Bun's transpiler drops a "use strict" directive inside a function, which would leave the reference run without a strict caller.
class StrictCode {
  static declares = function () {
    eval("var z = 1");
    return typeof z;
  };
}
show("var in a strict caller", StrictCode.declares);
show("nothing on the global object", () => [typeof globalThis.x, typeof globalThis.g, typeof globalThis.e, typeof globalThis.z]);
//// direct-eval-strict.js
"use strict";
// A direct eval in strict code. The file is strict as a whole: `bun run` drops a "use strict" that only a function has.
module.exports = {};

////= show

function declares() {
  eval("var z = 1");
  return typeof z;
}
show("eval keeps its variable", declares);
show("nothing on the global object", () => typeof globalThis.z);

const named = function self() {
  eval("self = 1");
  return typeof self;
};
show("function name", named);
//// direct-eval-this-super-new-target.js
// What the text of a direct eval sees as this, super and new.target.
export {};

////= show

const receiver = {
  id: "receiver",
  method() {
    return eval("this.id");
  },
  arrow() {
    return (() => eval("this.id"))();
  },
};
show("this in a method", () => receiver.method());
show("this in an arrow function", () => receiver.arrow());

class Fields {
  id = "field";
  seen = eval("this.id");
}
show("this in a field initializer", () => new Fields().seen);

class Base {
  constructor() {
    this.id = "base";
  }
  method() {
    return "base method";
  }
}
class Derived extends Base {
  constructor() {
    let before;
    try {
      eval("this");
    } catch (error) {
      before = error.name;
    }
    super();
    this.before = before;
    this.after = eval("this.id");
  }
  method() {
    return eval("super.method()");
  }
}
const derived = new Derived();
show("this before super()", () => derived.before);
show("this after super()", () => derived.after);
show("super in a class method", () => derived.method());

class MentionsThis extends Base {
  constructor() {
    const skipped = eval("false && this");
    const steps = [];
    try {
      eval("steps.push('ran'); this");
    } catch (error) {
      steps.push(error.name);
    }
    super();
    this.skipped = skipped;
    this.steps = steps;
  }
}
show("this mentioned but not read before super()", () => new MentionsThis().skipped);
show("this read after other code before super()", () => new MentionsThis().steps);

const parent = {
  method() {
    return "parent";
  },
};
const other = {
  method() {
    return "other";
  },
};
const home = {
  __proto__: parent,
  method() {
    return eval("super.method()");
  },
};
show("super in an object method", () => home.method());
Object.setPrototypeOf(home, other);
show("super after setPrototypeOf", () => home.method());

////= lines-24	readsNewTarget	eval	"new.target"
function StoresNewTarget() {
  this.isSelf = eval("new.target") === StoresNewTarget;
  this.isSelfInArrow = (() => eval("new.target"))() === StoresNewTarget;
}
show("new.target in a call", () => readsNewTarget());
show("new.target in a construct", () => new StoresNewTarget().isSelf);
show("new.target in an arrow function", () => new StoresNewTarget().isSelfInArrow);

////= lines-24	readsSuperProperty	eval	"super.x"
show("super in a plain function", readsSuperProperty);
show("new.target at top level", () => eval("new.target"));
//// direct-eval-typed-variables.ts
// A store from the text of a direct eval is tested against the type the variable was declared with.
let moduleNumber: number = 1;

function report(label: string, run: () => unknown): void {
  try {
    console.log(label, String(run()));
  } catch (error) {
    console.log(label, String(error));
  }
}

report("module variable, number", () => eval("moduleNumber = 2"));
report("module variable, string", () => eval("moduleNumber = 'a'"));
console.log(typeof moduleNumber, moduleNumber);

function storesLocal(): string {
  let count: number = 1;
  report("local variable, number", () => eval("count = 3"));
  report("local variable, string", () => eval("count = 'b'"));
  return typeof count + " " + count;
}
console.log(storesLocal());

function storesString(): string {
  let text: string = "a";
  report("string variable, string", () => eval("text = 'c'"));
  report("string variable, number", () => eval("text = 1"));
  report("string variable, object", () => eval("text = {}"));
  const length = text.length;
  report("string variable, null", () => eval("text = null"));
  return length + " " + text;
}
console.log(storesString());

class Point {
  x: number = 1;
}
function storesObject(): number {
  let point: Point = new Point();
  report("class variable, string", () => eval("point = 'd'"));
  report("class variable, object", () => eval("point = { x: 2 }; point.x"));
  return point.x;
}
console.log(storesObject());
//// disposal-and-eval.ts
// `using`, `await using` with disposers that throw, and direct eval that reads this, new.target, a capture and a private name.
const log: string[] = [];
function resource(name: string, failure?: string): any {
  return { [Symbol.dispose]() { log.push("dispose " + name); if (failure) throw failure; } };
}
function asyncResource(name: string, failure?: string): any {
  return { async [Symbol.asyncDispose]() { log.push("begin " + name); await undefined; log.push("end " + name); if (failure) throw failure; } };
}
function chain(e: any): string {
  return e && e.constructor && e.constructor.name === "SuppressedError" ? "S(" + chain(e.error) + ", " + chain(e.suppressed) + ")" : String(e);
}
function report(name: string, run: () => unknown) {
  log.length = 0;
  let outcome: string;
  try { outcome = "returned " + run(); } catch (e: any) { outcome = "threw " + chain(e); }
  console.log(name + ": " + outcome + " | " + log.join(", "));
}
async function reportAsync(name: string, run: () => Promise<unknown>) {
  log.length = 0;
  let outcome: string;
  try { outcome = "returned " + await run(); } catch (e: any) { outcome = "threw " + chain(e); }
  console.log(name + ": " + outcome + " | " + log.join(", "));
}

report("reverse order", () => { using a = resource("a"); using b = resource("b"); return "body"; });
report("one disposer throws", () => { using a = resource("a", "A"); using b = resource("b"); return "body"; });
report("two disposers throw", () => { using a = resource("a", "A"); using b = resource("b", "B"); return "body"; });
report("body and disposers throw", () => { using a = resource("a", "A"); using b = resource("b", "B"); throw "body"; });
report("null and undefined", () => { using a = null as any; using b = undefined as any; return "nothing to dispose"; });
report("not disposable", () => { using x = 1 as any; return "not reached"; });
report("no method", () => { using x = {} as any; return "not reached"; });

await reportAsync("await using", async () => { await using a = asyncResource("a"); await using b = asyncResource("b"); return "body"; });
await reportAsync("await using throws", async () => { await using a = asyncResource("a", "A"); await using b = asyncResource("b", "B"); throw "body"; });
await reportAsync("await using, sync fallback", async () => { await using a = resource("a", "A"); return "body"; });

const direct: any = eval;
class Secret {
  #hidden = "private value";
  seenTarget: boolean;
  constructor() {
    this.seenTarget = eval("new.target") === Secret;
  }
  readThis(): unknown { return eval("this") === this; }
  readPrivate(): unknown { return eval("this.#hidden"); }
  writePrivate(value: string): unknown { eval("this.#hidden = value"); return this.#hidden; }
  readArrow(): unknown { return (() => eval("this.#hidden"))(); }
}
const secret = new Secret();
console.log(secret.seenTarget, secret.readThis(), secret.readPrivate(), secret.writePrivate("changed"), secret.readArrow());
function readCapture(): unknown {
  let captured = 1;
  const read = () => eval("captured += 1; captured");
  read();
  return [read(), captured];
}
console.log(readCapture());
function plainFunction(this: any): unknown { return eval("new.target === undefined ? this : 'constructed'"); }
console.log(plainFunction.call("receiver"), new (plainFunction as any)() === undefined);
console.log(direct("typeof secret"), eval("typeof secret"));
export {};
//// enums-with-computed-members.ts
const order: string[] = [];
function noted(name: string, value: number): number {
  order.push(name);
  return value;
}
order.push("ahead");
enum Sizes {
  None,
  Small = "abc".length,
  Large = noted("Large", 7) * 2,
  Larger = Large + Small,
  Fixed = 100,
}
order.push("behind");
console.log(order.join());
console.log(Sizes.None, Sizes.Small, Sizes.Large, Sizes.Larger, Sizes.Fixed);
console.log(Sizes[3], Sizes[14], Sizes[17], Sizes[100], Sizes[0]);
console.log(Object.keys(Sizes).join());

function sum(a: Sizes, b: Sizes): number {
  return a + b;
}
console.log(sum(Sizes.Large, Sizes.Fixed), sum(Sizes.Small, Sizes.None));

export enum Exported {
  First = Math.max(1, 2),
  Second = First << 2,
}
console.log(Exported.First, Exported.Second, Exported[8]);

function local(seed: number) {
  enum Local {
    Seed = seed,
    Twice = seed * 2,
    Both = Seed + Twice,
  }
  return [Local.Seed, Local.Twice, Local.Both, Local[seed * 3]];
}
console.log(local(2).join(), local(5).join());

enum Merged {
  A = 1,
}
enum Merged {
  B = noted("B", 40) + 2,
}
console.log(Merged.A, Merged.B, Merged[42], order.join());

namespace Inner {
  export enum Flags {
    Read = 1 << 0,
    Write = noted("Write", 2),
    Both = Read | Write,
  }
}
console.log(Inner.Flags.Read, Inner.Flags.Write, Inner.Flags.Both, Inner.Flags[3]);

function pick(): Sizes {
  return Sizes.Larger;
}
switch (pick()) {
  case Sizes.Small:
