//// finalization-registry-outlives-its-creating-job.ts
// A FinalizationRegistry that a function makes, registers objects with and never mentions again is alive until the job that made it has ended: a collection in that job sees the objects dead and the registry alive, so the callback runs.
let called = 0;
function make(i: number) {
  return { big: new Array(10).fill(i) };
}
async function usedByANestedFunction() {
  const registry = new FinalizationRegistry(() => {
    called++;
  });
  function register(i: number) {
    const target = make(i);
    registry.register(target, i);
    return { i };
  }
  const kept = register(0);
  for (let i = 1; i < 5; i++) register(i);
  Bun.gc(true);
  await Bun.sleep(1);
  Bun.gc(true);
  return kept.i;
}
async function usedByTheFunctionItself() {
  const registry = new FinalizationRegistry(() => {
    called++;
  });
  for (let i = 0; i < 5; i++) registry.register(make(i), i);
  Bun.gc(true);
  await Bun.sleep(1);
}
function notAsync() {
  const registry = new FinalizationRegistry(() => {
    called++;
  });
  for (let i = 0; i < 5; i++) registry.register(make(i), i);
  Bun.gc(true);
}
// Nothing holds these registries once `register` has returned. A collection may take them together with their objects, so whether a callback runs is left open.
function neverStored() {
  for (let i = 0; i < 5; i++) {
    new FinalizationRegistry(() => {
      called++;
    }).register(make(i), i);
  }
  Bun.gc(true);
}
for (const f of [usedByANestedFunction, usedByTheFunctionItself, notAsync]) {
  called = 0;
  await f();
  await Bun.sleep(1);
  console.log(f.name + ":", called > 0);
}
neverStored();
await Bun.sleep(1);
console.log("neverStored: done");
//// finalization-registry-unused-after-await.ts
// A local variable that is not used again keeps nothing alive across an `await`. A FinalizationRegistry that only such a variable holds is collected with the objects registered with it, and its callback never runs; one that is used after the wait is kept, and its callback runs. Plain Bun keeps both: there the variable lives in the scope object that the closures of the function share.
function collectWhileNothingRuns(): Promise<void> {
  return new Promise(resolve =>
    setTimeout(() => {
      Bun.gc(true);
      resolve();
    }, 1),
  );
}
async function usedAfterTheWait(): Promise<string> {
  let tracked = 0;
  let collected = 0;
  const registry = new FinalizationRegistry(() => collected++);
  const track = (target: object) => {
    tracked++;
    registry.register(target, undefined);
  };
  for (let i = 0; i < 5; i++) track({ i });
  const kept = {};
  registry.register(kept, undefined, kept);
  for (let round = 0; round < 50 && collected < tracked; round++) await collectWhileNothingRuns();
  return `${collected} of ${tracked}, ${registry.unregister(kept)}`;
}
async function notUsedAfterTheWait(): Promise<string> {
  let tracked = 0;
  let collected = 0;
  const registry = new FinalizationRegistry(() => collected++);
  const track = (target: object) => {
    tracked++;
    registry.register(target, undefined);
  };
  for (let i = 0; i < 5; i++) track({ i });
  for (let round = 0; round < 50 && collected < tracked; round++) await collectWhileNothingRuns();
  return `${collected} of ${tracked}`;
}
console.log("used after the wait:", await usedAfterTheWait());
console.log("not used after the wait:", await notUsedAfterTheWait());
//// finally.ts
// `finally`: after normal completion, after an exception, on `return`, `break` and `continue`, and which completion overrides which.
let log = ""
function f(mode: number): string {
  try {
    log += "t"
    if (mode === 1) return "returned"
    if (mode === 2) throw new Error("thrown")
    log += "u"
  } finally {
    log += "f"
  }
  return "end"
}
console.log(f(0), f(1), log)
try { f(2) } catch (e) { console.log((e as Error).message, log) }
function g(): number { try { return 1 } finally { log += "G" } }
function h(): number { try { throw new Error("lost") } finally { return 2 } }
function k(): number { try { return 1 } finally { return 3 } }
console.log(g(), h(), k(), log)
let out = ""
for (let i = 0; i < 4; i++) {
  try {
    if (i === 1) continue
    if (i === 3) break
    out += "b" + i
  } finally {
    out += "f" + i
  }
}
console.log(out)
function both(n: number): string {
  let s = ""
  try {
    try { s += "a"; if (n) throw new Error("x"); s += "b" } catch (e) { s += "c"; if (n > 1) throw e } finally { s += "d" }
    s += "e"
  } catch { s += "g" } finally { s += "h" }
  return s
}
console.log(both(0), both(1), both(2))
outer: for (let i = 0; i < 3; i++) {
  inner: {
    for (let j = 0; j < 3; j++) {
      if (j === 1) break
      if (i === 1) break inner
      if (i === 2) break outer
      out += "|" + i + j
    }
    out += "+"
  }
}
console.log(out)
//// for-head-forms.js
// Within brackets, braces and parentheses `in` is an operator again, also in the head of a `for`. An escaped `async` in front of `of` is a name.
var x;
for ([x = "x" in {}] of [[]]) console.log(x);
for ([x = "length" in []] of [[]]) console.log(x);
for (var a = ["length" in []], i = 0; i < 1; i++) console.log(a[0]);
for (var o = { has: "a" in { a: 1 } }, i = 0; i < 1; i++) console.log(o.has);
for (var t = `${"a" in {}}`, i = 0; i < 1; i++) console.log(t);
for (var k in { one: 1, two: 2 }) console.log(k);
var async;
for (\u0061sync of [7]) console.log(async);
for ((async) of [8]) console.log(async);
//// for-head-self-reference.js
// `for (let x of [x])`: what stands behind `of` or `in` is evaluated where the loop's own names are declared and hold nothing yet.
function tell(name, f) {
  try {
    console.log(name, f());
  } catch (error) {
    console.log(name, error.constructor.name);
  }
}
tell("let in", () => { let x = 1; for (let x in { x }) return "entered"; return "left"; });
tell("const in", () => { let x = 1; for (const x in { x }) return "entered"; return "left"; });
tell("let of", () => { let x = 1; for (let x of [x]) return "entered"; return "left"; });
tell("const of", () => { let x = 1; for (const x of [x]) return "entered"; return "left"; });
tell("a pattern", () => { let b = 1; for (const [a, b] of [[b, 2]]) return "entered"; return "left"; });
tell("a pattern's other name", () => { let a = 1; for (const { a, b } of [{ a, b: 2 }]) return "entered"; return "left"; });
tell("var", () => { for (var x of [x]) return String(x); return "left"; });
tell("not evaluated", () => { let x = 1; for (let x of true ? [5] : [x]) return x; return "left"; });
tell("typeof", () => { for (let x of [typeof x]) return x; return "left"; });
tell("in a function that is called at once", () => { for (let x of [(() => x)()]) return x; return "left"; });
tell("in a function that is called later", () => { const all = []; for (let x of [() => x, () => x]) all.push(x); return all.map(f => typeof f()).join(); });
tell("another name", () => { let y = 3; for (let x of [y]) return x; return "left"; });
tell("twice", () => { let n = 0; for (let turn = 0; turn < 2; turn++) { try { for (let x of [x]) n += 10; } catch { n++; } } return n; });
async function later() {
  try {
    for await (let x of [x]) return "entered";
    return "left";
  } catch (error) {
    return error.constructor.name;
  }
}
later().then(said => console.log("for await", said));
let top = 1;
try {
  for (let top of [top]) console.log("entered");
} catch (error) {
  console.log("at the top level", error.constructor.name);
}
