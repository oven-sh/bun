const pairs: [unknown, unknown][] = [[1, 1], [1, 2], [1.5, 1.5], [NaN, NaN], ["a", "a"], ["a", "b"], [one, one], [one, { id: 1 }], [null, undefined], [undefined, undefined], [0, -0], [true, true], [true, 1]];
