////: labeled
function labeled(scores: Scores): string {
  let last = 0;
  let order = "";
  outer: for (const first in scores) {
    last = scores[first];
    for (const second in scores) {
      last = scores[second];
      order += first + second + " ";
      if (second === "b") continue outer;
      if (first === "c") break outer;
    }
  }
  return order + ":" + String(last);
}
