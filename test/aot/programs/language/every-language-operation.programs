////: attempt
function attempt(label, run) {
  try { console.log(label + ": " + String(run())); } catch (error) { console.log(label + ": " + error.constructor.name); }
}
////: awaited
async function awaited(scores: Scores): Promise<string> {
  let last = 0;
  let order = "";
  for (const key in scores) {
    last = scores[key];
    await null;
    order += key;
  }
  return order + ":" + String(last);
}
////: broken
function broken(scores: Scores): string {
  let last = 0;
  let order = "";
  for (const key in scores) {
    last = scores[key];
    order += key;
    if (key === "c") break;
  }
  return order + ":" + String(last);
}
////: continued
function continued(scores: Scores): string {
  let last = 0;
  let order = "";
  for (const key in scores) {
    if (key === "b") continue;
    last = scores[key];
    order += key;
  }
  return order + ":" + String(last);
}
////: continuedBehindTheRead
function continuedBehindTheRead(scores: Scores): string {
  let last = 0;
  let order = "";
  for (const key in scores) {
    last = scores[key];
    if (key === "a" || key === "c") continue;
    order += key;
  }
  return order + ":" + String(last);
}
////: deletesALaterName
function deletesALaterName(scores: Scores): string {
  let last = 0;
  let order = "";
  for (const key in scores) {
    last = scores[key];
    order += key;
    if (key === "a") delete scores.c;
  }
  return order + ":" + String(last);
}
