}
show("frozen", frozen);

const odd = launder(new Counters(2147483647)) as unknown as { up: unknown; any: unknown };
odd.up = "text";
odd.any = undefined;
increment(odd as unknown as Counters);
console.log("odd", odd.up, odd.any);
