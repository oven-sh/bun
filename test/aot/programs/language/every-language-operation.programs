// Exceptions thrown locally, by called functions and by built-in functions, and which values are live in and after the `catch` block.
function risky(n: number): number { if (n % 3 === 0) throw new Error("bad " + n); return n * 2 }
function guarded(n: number): string {
  let before = n + 100
  let steps = 0
  try {
    steps = 1
    const r = risky(n)
    steps = 2
    before += r
    return "ok " + r + " " + before + " " + steps
  } catch (e) {
    return "caught " + (e as Error).message + " " + before + " " + steps
  }
}
console.log(guarded(1), "|", guarded(3), "|", guarded(4), "|", guarded(6))
function nested(n: number): string {
  let log = ""
  try {
    log += "a"
    try {
      log += "b"
      risky(n)
      log += "c"
    } catch (inner) {
      log += "d"
      if (n === 6) throw new Error("again")
      log += "e"
    }
    log += "f"
  } catch (outer) {
    log += "g" + (outer as Error).message
  }
  return log
}
console.log(nested(1), nested(3), nested(6))
let total = 0.5
let count = 0
for (let i = 0; i < 20; i++) {
  try { total += risky(i) } catch { count++ }
}
console.log(total, count)
function fromEngine(text: string): string {
  try { return "parsed " + JSON.parse(text).a } catch (e) { return "not JSON: " + (e instanceof SyntaxError) }
}
console.log(fromEngine('{"a":5}'), fromEngine("{"))
function thrower(x: unknown): never { throw x }
for (const value of [1, "s", null, undefined, 2.5, true]) {
  try { thrower(value) } catch (e) { console.log(typeof e, e) }
}
const nothing: any = null
try { console.log(nothing.x) } catch (e) { console.log("TypeError", e instanceof TypeError) }
//// exceptions-through-finally-to-outer-catch.ts
// A value thrown through `finally` blocks, closing iterators and `using` declarations to a `catch` further up arrives unchanged, whoever threw it and whatever the blocks on the way do.
const collect: (sync: boolean) => void = (globalThis as any).gc ?? (globalThis as any).Bun?.gc ?? (() => undefined);
const log: string[] = [];
const anything: any = { json: JSON };
function raise(value: unknown): never {
  throw value;
}
function hostThrows(): number {
  return anything.json.parse("{").length + 1;
}
function told(value: unknown): string {
  return value instanceof Error ? value.name + ": " + value.message.slice(0, 20) : typeof value === "object" && value !== null ? JSON.stringify(value) : String(value);
}
function cleansUp(depth: number, thrower: () => number): number {
  try {
    return depth ? cleansUp(depth - 1, thrower) + 1 : thrower() + 1;
  } finally {
    log.push("f" + depth);
  }
}
function plainFrames(depth: number, thrower: () => number): number {
  return depth ? plainFrames(depth - 1, thrower) + 1 : cleansUp(2, thrower) + 1;
}
function catches(thrower: () => number): string {
  log.length = 0;
  try {
    return "returned " + plainFrames(3, thrower);
  } catch (error) {
    return told(error) + " " + log.join();
  }
}
const sentinel = { name: "sentinel" };
const throwers: Array<() => number> = [() => raise(1), () => raise(sentinel), () => raise(undefined), () => raise(new RangeError("made here")), hostThrows, () => { throw new TypeError("literal"); }];
for (const thrower of throwers) console.log(catches(thrower));

function finallyCallsAndCatches(thrower: () => number): string {
  try {
    try {
      return "returned " + thrower();
    } finally {
      try {
        plainFrames(1, () => raise("inner"));
      } catch (inner) {
        log.push("caught " + inner);
      }
    }
  } catch (error) {
    return told(error);
  }
}
////= lines-10	finallyThrowsAnother	raise	"replaced"
function finallyReturns(thrower: () => number): string {
  try {
    return "returned " + thrower();
  } finally {
    return "the finally block returned";
  }
}
////= lines-10	finallyCollects	collect	true
for (const thrower of throwers) console.log([finallyCallsAndCatches(thrower), finallyThrowsAnother(thrower), finallyReturns(thrower), finallyCollects(thrower)].join(" ; "));

function closesIterator(thrower: () => number): string {
  const iterable = {
    [Symbol.iterator]() {
      return { next: () => ({ done: false, value: 1 }), return: () => { log.push("closed"); return { done: true, value: 0 }; } };
    },
  };
  log.length = 0;
  try {
    for (const item of iterable) thrower();
    return "nothing";
  } catch (error) {
    return told(error) + " " + log.join();
  }
}
function disposes(thrower: () => number): string {
  log.length = 0;
  try {
    using resource = { [Symbol.dispose]() { log.push("disposed"); } };
    return "returned " + thrower();
  } catch (error) {
    return told(error) + " " + log.join();
  }
}
for (const thrower of throwers) console.log(closesIterator(thrower) + " ; " + disposes(thrower));

function* yieldsInFinally(thrower: () => number): Generator<string> {
  try {
    thrower();
  } finally {
    yield "suspended";
  }
}
function firstCaller(generator: Generator<string>): string {
  try {
    return generator.next().value as string;
  } catch (error) {
    return "the first caller caught " + told(error);
  }
}
function secondCaller(generator: Generator<string>): string {
  try {
    return String(generator.next().value);
  } catch (error) {
    return "the second caller caught " + told(error);
  }
}
for (const thrower of throwers) {
  const generator = yieldsInFinally(thrower);
  console.log(firstCaller(generator) + " ; " + secondCaller(generator));
}

const tick = Promise.resolve();
async function asyncCleansUp(depth: number, thrower: () => number, waits: boolean): Promise<number> {
  try {
    if (depth) return (await asyncCleansUp(depth - 1, thrower, waits)) + 1;
    if (waits) await tick;
    return thrower() + 1;
  } finally {
    if (waits) await tick;
    log.push("a" + depth);
  }
}
function startsAsync(thrower: () => number): Promise<number> | string {
  try {
    return asyncCleansUp(1, thrower, false);
  } catch (error) {
    return "thrown to the caller: " + told(error);
  }
}
async function main(): Promise<void> {
  for (const thrower of throwers) {
    for (const waits of [false, true]) {
      log.length = 0;
      try {
        console.log("returned " + (await asyncCleansUp(2, thrower, waits)));
      } catch (error) {
        console.log("async " + waits + ": " + told(error) + " " + log.join());
      }
    }
    const started = startsAsync(thrower);
    console.log(typeof started === "string" ? started : "a promise: " + (await started.catch(told)));
  }
  let count = 0;
  for (let i = 0; i < 10000; i++) {
    try {
      plainFrames(i % 3, throwers[i % throwers.length]!);
    } catch (error) {
      count++;
    }
    log.length = 0;
    if (i % 2500 === 0) collect(true);
  }
  console.log(count);
}
main();
//// failing-checks-in-try.ts
// Checks of the language that fail inside `try` (null and undefined where an object must be, variables read too early, what is no function, no constructor, not iterable, lengths out of range), with many values alive: the handler finds every value as it was.
interface Point { x: number; y: number; next?: Point | null }
const log: string[] = [];
function name(error: unknown): string {
  return error instanceof Error ? error.name : String(error);
}
function readsThroughNull(point: Point | null, a: number, b: number, c: number, d: number): string {
  let e = a + b, f = c * d, g = a - d, h = b / 4;
  try {
    e += point!.x;
    f += point!.next!.y;
    g += 100;
  } catch (error) {
    return [name(error), a, b, c, d, e, f, g, h].join();
  }
  return ["none", a, b, c, d, e, f, g, h].join();
}
function writesThroughNull(point: Point | null, a: number, b: number): string {
  const kept = a * b + 0.5;
  try {
    point!.x = a;
    point!.next!.y = b;
  } catch (error) {
    return [name(error), a, b, kept, point ? point.x : "no point"].join();
  }
  return ["none", a, b, kept].join();
}
function readsTooEarly(flag: boolean, a: number): string {
  const kept = a * 3;
  const read = () => late;
  try {
    if (flag) return "early " + read();
    log.push("not read");
  } catch (error) {
    return name(error) + " " + kept + " " + a;
  }
  const late = a + 1;
  return "none " + late + " " + kept;
}
function callsWhatIsNoFunction(callee: (() => number) | undefined, a: number, b: number): string {
  const kept = a ^ b;
  try {
    return "returned " + (callee!() + kept);
  } catch (error) {
    return [name(error), a, b, kept].join();
  }
}
function callsMethodOfNothing(holder: { run?: (n: number) => number } | null, a: number): string {
  const kept = a + 0.25;
  try {
    return "returned " + holder!.run!(a);
  } catch (error) {
    return [name(error), a, kept].join();
  }
}
class Plain { value = 1; }
function callsClass(a: number): string {
  const kept = a * 9;
  try {
    return String((Plain as unknown as () => number)());
  } catch (error) {
    return name(error) + " " + kept;
  }
}
function constructsArrow(a: number): string {
  const arrow = () => a;
  const kept = a * 7;
  try {
    return String(new (arrow as unknown as new () => object)());
  } catch (error) {
    return name(error) + " " + kept;
  }
}
function iteratesNothing(list: number[] | null | undefined, a: number, b: number): string {
  let sum = a;
  const kept = b * 2;
  try {
    for (const item of list!) sum += item;
  } catch (error) {
    return [name(error), a, b, sum, kept].join();
  }
  return ["none", sum, kept].join();
}
function destructuresNothing(pair: [number, number] | null, record: { p: number } | undefined, a: number): string {
  const kept = a - 0.5;
  try {
    const [first, second] = pair!;
    const { p } = record!;
    return ["none", first, second, p, kept].join();
  } catch (error) {
    return [name(error), a, kept].join();
  }
}
function lengthsOutOfRange(n: number, a: number): string {
  const kept = a * a;
  try {
    return "made " + new Array<number>(n).length + " " + "ab".repeat(n).length + " " + kept;
  } catch (error) {
    return [name(error), n, a, kept].join();
  }
}
function instanceOfNothing(value: object, a: number): string {
  const kept = a * 1.5;
  try {
    return String(value instanceof (undefined as unknown as typeof Plain)) + kept;
  } catch (error) {
    return name(error) + " " + kept;
  }
}
function inLoops(points: Array<Point | null>): string {
  let sum = 0, caught = 0, product = 1;
  for (let round = 0; round < 300; round++) {
    for (let i = 0; i < points.length; i++) {
      product = (product * 7 + i) % 1000003;
      try {
        sum += points[i]!.x + points[i]!.next!.y;
