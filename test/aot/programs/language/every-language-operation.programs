////: addsAName
function addsAName(scores: Scores): string {
  let last = 0;
  let turns = 0;
  for (const key in scores) {
    last = scores[key];
    turns++;
    if (key === "b") scores.z = 9;
  }
  return (turns >= Object.keys(scores).length - 1) + ":" + Object.keys(scores).join("");
}
////: assigned
function assigned(scores: Scores): string {
  let last = 0;
  let order = "";
  for (const key in scores) {
    last = scores[key];
    order += key;
  }
  return order + ":" + String(last);
}
