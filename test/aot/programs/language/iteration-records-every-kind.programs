console.log("after")
//// numbers-beside-the-ends-of-int32.ts
// A number is taken for an int32 only if it is one: what lies outside, and has the low half of a small integer, is not.
const letters: string[] = ["a", "b", "c", "d", "e", "f", "g", "h"];

function letterAt(index: number): string {
  const letter = letters[index];
  return letter === undefined ? "-" : letter;
}

function isSmall(value: number): string {
  return (value | 0) === value ? "int32" : "other";
}

function half(value: number): number {
  return value / 2;
}

const doubled: number[] = [
  2, 10, 0, -0, -2, 1, 3,
  2 * 4294967296 + 2, 2 * 4294967297, -2 * 4294967296 + 4, 2 * 2147483647, 2 * 2147483648, -2 * 2147483648, -2 * 2147483649,
  2 * 9007199254740991, 1e300, -1e300, Infinity, -Infinity, NaN,
];

const lines: string[] = [];
for (const value of doubled) {
  const number = half(value);
  lines.push(`${Object.is(number, -0) ? "-0" : number}: ${letterAt(number)} ${isSmall(number)} ${letters.at(number) ?? "-"} ${"abcdefgh".charAt(number) || "-"}`);
}
console.log(lines.join("\n"));
//// numbers-compared-for-equality-as-they-arrive.ts
// === and == of two numbers, whichever way each arrives: out of a variable that anybody may store to, an array of anything, a parameter, a computation.
const values: any[] = [0, -0, 1, -1, 0.5, -0.5, NaN, Infinity, -Infinity, 2147483647, 2147483648, -2147483648, -2147483649, 4294967296, 9007199254740991, 9007199254740992, 1e300, 5e-324, 42, 42.0, 41.99999999999999];
let held: any = 0;
function hold(value: any) { held = value; }

function isZero(): boolean { const x: number = held; return x === 0; }
function isMinusOne(): boolean { const x: number = held; return x === -1; }
function isFortyTwo(): boolean { const x: number = held; return 42 === x; }
function isLeast(): boolean { const x: number = held; return x === -2147483648; }
function isHalf(): boolean { const x: number = held; return x === 0.5; }
function looselyZero(): boolean { const x: number = held; return x == 0; }
function notZero(): boolean { const x: number = held; return x !== 0; }
function same(a: number, b: number): boolean { return a === b; }
function looselySame(a: number, b: number): boolean { return a == b; }
function twice(a: number, b: number): boolean { return a * 2 === b; }
function counted(list: any[], wanted: number): number {
    let count = 0;
    for (let i = 0; i < list.length; i++) {
        const x: number = list[i];
        if (x === wanted) count++;
        if (x === i) count += 100;
    }
    return count;
}

const show = (x: number) => Object.is(x, -0) ? "-0" : String(x);
for (const value of values) {
    hold(value);
    console.log(show(value), isZero(), isMinusOne(), isFortyTwo(), isLeast(), isHalf(), looselyZero(), notZero(), counted(values, value));
}
let bits = "";
for (const a of values) {
    for (const b of values) bits += (same(a, b) ? 1 : 0) + (looselySame(a, b) ? 2 : 0) + (twice(a, b) ? 4 : 0);
    bits += " ";
}
console.log(bits);
let hits = 0;
for (let round = 0; round < 2000; round++) {
    hold(round % 3 === 0 ? 0 : round % 3 === 1 ? -0 : round);
    if (isZero()) hits++;
    if (looselyZero()) hits += 10000;
    if (same(held, round)) hits += 100000000;
}
console.log(hits);
// What is no number at all, through `any`.
for (const odd of [undefined, null, "0", "", false, true, 0n, {}, [], [0]] as any[]) {
    hold(odd);
    console.log(typeof odd, isZero(), looselyZero(), notZero(), same(odd, 0), looselySame(odd, 0), same(odd, odd), looselySame(0, odd));
}
//// numbers-passed-as-values.ts
declare const console: { log(...values: unknown[]): void };
function say(x: unknown): string { return Object.is(x, -0) ? "-0" : typeof x + ":" + String(x); }
function half(x: number): number { return x / 2; }
function twice(x: number): number { return x * 2; }
function sum(x: number, y: number): number { return x + y; }
function root(x: number): number { return Math.sqrt(x); }
function asAnything(x: number): unknown { return x; }
function inArray(x: number, y: number): unknown[] { return [x / y, x * y, x - y, x % y]; }
function inObject(x: number, y: number): { [key: string]: unknown } { return { q: x / y, p: x * y }; }
function key(table: Map<unknown, string>, x: number): string | undefined { return table.get(x / 2); }
function bits(x: number): string { const f = new Float64Array(1); f[0] = x; return Array.from(new Uint8Array(f.buffer)).join(","); }
function fromBits(hi: number, lo: number): number { const u = new Uint32Array(2); u[0] = lo; u[1] = hi; return new Float64Array(u.buffer)[0]; }
const values = [0, -0, NaN, 1, -1, 3, 0.5, -0.5, 5e-324, Infinity, -Infinity, 2147483647, 2147483648, 4294967294, 4294967296, -2147483648, -2147483649, -4294967296, 1e21, -1e21, 9007199254740992, 1e308];
const out: string[] = [];
for (const v of values)
    out.push([say(asAnything(v)), say(asAnything(half(v))), say(asAnything(twice(v))), say(asAnything(sum(v, v))), say(asAnything(sum(v, 0.5))), say(asAnything(root(v))), inArray(v, 2).map(say).join("|"), JSON.stringify(inObject(v, 4))].join(" "));
