function iteratorFor(hasThrowMethod) {
  const iterator = {
    [Symbol.iterator]() {
      return this;
    },
    next() {
      return { done: false, value: 1 };
    },
    return() {
      console.log("return called");
      return {};
    },
  };
  if (hasThrowMethod)
    iterator.throw = () => ({ done: true, value: "handled" });
  return iterator;
}
function* delegate(hasThrowMethod) {
  return yield* iteratorFor(hasThrowMethod);
}
