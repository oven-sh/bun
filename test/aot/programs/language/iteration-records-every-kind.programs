//// number-predicates-of-optional.ts
declare const console: { log(...values: unknown[]): void };
const given: number[] = [0, -0, 1, -1, 2, 0.5, -2.5, 4, 9, 1e21, 2147483648, NaN, Infinity, -Infinity, 5e-324];
function holed(): number[] { const a = given.slice(); delete (a as unknown[])[3]; a.length = a.length + 1; return a; }
function show(v: number): string { return Object.is(v, -0) ? "-0" : String(v); }
function nans(a: number[]): string { let s = ""; for (let i = 0; i < a.length + 1; i++) s += (isNaN(a[i]) ? 1 : 0) + "" + (isFinite(a[i]) ? 1 : 0) + (Number.isNaN(a[i]) ? 1 : 0) + (Number.isFinite(a[i]) ? 1 : 0) + (Number.isInteger(a[i]) ? 1 : 0) + (Number.isSafeInteger(a[i]) ? 1 : 0) + ","; return s; }
function powers(a: number[]): string { let s = ""; for (let i = 0; i < a.length + 1; i++) s += show(Math.pow(a[i], 2)) + "," + show(Math.pow(a[i], 0.5)) + "," + show(Math.pow(a[i], 0)) + "," + show(Math.pow(a[i], -1)) + "," + show(Math.pow(a[i], 3.5)) + "," + show(Math.pow(2, i)) + ";"; return s; }
function powersBy(a: number[], y: number): string { let s = ""; for (let i = 0; i < a.length + 1; i++) s += show(Math.pow(a[i], y)) + ","; return s; }
function counted(a: number[]): number { let n = 0; for (let i = 0; i < a.length + 2; i++) { if (isNaN(a[i])) n += 1; if (!isFinite(a[i])) n += 100; } return n; }
function ofMaybe(v: number | undefined): string { return [isNaN(v as number), isFinite(v as number), Number.isNaN(v), Number.isFinite(v), Number.isInteger(v)].map(b => (b ? 1 : 0)).join("") + show(Math.pow(v as number, 2)) + show(Math.pow(v as number, 0)); }
function ofNil(v: number | null): string { return [isNaN(v as number), isFinite(v as number), Number.isNaN(v), Number.isFinite(v), Number.isInteger(v)].map(b => (b ? 1 : 0)).join("") + show(Math.pow(v as number, 2)) + show(Math.pow(v as number, 0)); }
function ofWhole(a: number[], i: number): string { const n: number | undefined = i < a.length ? a.length * 3 : undefined; return (Number.isNaN(n) ? 1 : 0) + "" + (Number.isInteger(n) ? 1 : 0) + (Number.isFinite(n) ? 1 : 0); }
for (let turn = 0; turn < 2; turn++) {
    for (const [name, make] of [["given", () => given.slice()], ["holed", holed], ["parsed", () => JSON.parse("[0,1,-1,4,9,2147483647]") as number[]], ["none", (): number[] => []], ["holes", () => new Array<number>(2)]] as [string, () => number[]][])
        console.log(name + ": " + nans(make()) + " # " + powers(make()) + " # " + powersBy(make(), 2) + powersBy(make(), 0) + powersBy(make(), NaN) + powersBy(make(), 0.5) + " # " + counted(make()));
    const say = (run: () => string) => { try { return run(); } catch (e) { return e instanceof TypeError ? "TypeError" : "threw"; } };
    console.log([undefined, 0, -0, 3, 2.5, NaN, Infinity].map(v => say(() => ofMaybe(v))).join(" ") + " # " + [null, 0, 3, 2.5, NaN].map(v => say(() => ofNil(v))).join(" ") + " # " + ofWhole(given, 1) + ofWhole(given, 99));
}
//// numbers-and-element-reads-at-limits.ts
// Numbers and array element reads in edge cases: everything must behave exactly as ECMAScript specifies.
function count(from: number, step: number, times: number): string { let x = from, s = ""; for (let i = 0; i < times; i++) { x += step; s += x + "," } return s }
function down(from: number, step: number, times: number): string { let x = from, s = ""; for (let i = 0; i < times; i++) { x -= step; s += x + "," } return s }
function hash(text: string): number { let h = 7; for (let i = 0; i < text.length; i++) h = h * 31 + text.charCodeAt(i); return h }
function fnv(text: string): number { let h = 2166136261; for (let i = 0; i < text.length; i++) { h ^= text.charCodeAt(i); h = (h * 16777619) >>> 0 } return h }
function double(times: number): number { let x = 1; for (let i = 0; i < times; i++) x += x; return x }
function sign(x: number): string { return x === 0 ? (1 / x > 0 ? "+0" : "-0") : "" + x }
function sum(a: Int32Array, times: number): number { let s = 0; for (let k = 0; k < times; k++) for (let i = 0; i < a.length; i++) s += a[i]!; return s }
console.log(count(9007199254740988, 1, 8))
console.log(count(9007199254740988, 2, 6), count(9007199254740988, 3, 6), count(9007199254740000, 255, 8))
console.log(down(-9007199254740988, 1, 8), down(-9007199254740988, 3, 6))
console.log(count(4611686018427387000, 256, 4), count(4611686018427387904, 1, 2), count(4611686018427387904, 256, 3))
console.log(hash("the quick brown fox jumps over the lazy dog"), fnv("the quick brown fox"), 94906267 * 94906267, 94906267 * 94906266)
console.log(double(52), double(53), double(54), double(63), double(64), double(100), double(1100))
const zero = [0, 1, -1, 4, -4, 2]
console.log(sign(zero[0]! * zero[2]!), sign(-zero[0]!), sign(zero[4]! % zero[5]!), sign(zero[3]! % zero[5]!), sign(zero[2]! * zero[0]!), sign(zero[0]! * zero[1]!), sign(zero[0]! - zero[0]!), sign(-zero[1]!))
const big = new Int32Array(4); big[0] = 2147483647; big[1] = 2147483647; big[2] = -5; big[3] = 2147483647
console.log(sum(big, 3), sum(big, 3000000))
//// numbers-asked-what-they-are.ts
const launder = new Function("value", "return value") as <V>(value: V) => V;

const numbers: number[] = [
  0, -0, 1, -1, 0.5, -0.5, 1.5, 2 ** 31, -(2 ** 31), 2 ** 31 - 1, 2 ** 32, 2 ** 52, 2 ** 53 - 1, 2 ** 53, 2 ** 53 + 2, -(2 ** 53 - 1), -(2 ** 53), 2 ** 63, -(2 ** 63), 2 ** 64, 1e21, 1e300, -1e300,
  Number.MAX_VALUE, -Number.MAX_VALUE, Number.MIN_VALUE, -Number.MIN_VALUE, Number.EPSILON, 4503599627370495.5, 4503599627370496.5, 0.1 + 0.2, NaN, -NaN, Infinity, -Infinity, 1 / 3, 123456789.000001,
];
const others: unknown[] = [undefined, null, true, false, "", "1", "NaN", "Infinity", 1n, [], [1], {}, new Number(1), new Number(NaN), Symbol.iterator, () => 1, { valueOf: () => 1 }];

class Measured {
  size: number;
  count: number;
  maybe: number | undefined;
  anything: unknown;
  constructor(size: number, count: number, maybe: number | undefined, anything: unknown) {
    this.size = size;
    this.count = count;
    this.maybe = maybe;
    this.anything = anything;
  }
}

function flags(...answers: boolean[]): string {
  let said = "";
  for (const answer of answers) said += answer ? "y" : "n";
  return said;
}

function ofNumber(x: number): string {
  return flags(Number.isNaN(x), Number.isFinite(x), Number.isInteger(x), Number.isSafeInteger(x), isNaN(x), isFinite(x));
}

function ofFields(one: Measured): string {
  let said = flags(Number.isNaN(one.size), Number.isFinite(one.size), Number.isInteger(one.size), Number.isSafeInteger(one.size));
  said += flags(Number.isNaN(one.count), Number.isFinite(one.count), Number.isInteger(one.count), Number.isSafeInteger(one.count));
  said += flags(Number.isNaN(one.maybe), Number.isFinite(one.maybe), Number.isInteger(one.maybe), Number.isSafeInteger(one.maybe));
  said += flags(Number.isNaN(one.anything), Number.isFinite(one.anything), Number.isInteger(one.anything), Number.isSafeInteger(one.anything));
  if (Number.isInteger(one.size)) said += "I";
  if (!Number.isFinite(one.size)) said += "F";
  if (Number.isNaN(one.size) || Number.isNaN(one.maybe)) said += "N";
  return said;
}

function ofElements(list: number[]): string {
  let whole = 0, finite = 0, safe = 0, none = 0;
  for (let i = 0; i < list.length; i++) {
    if (Number.isInteger(list[i])) whole++;
    if (Number.isFinite(list[i])) finite++;
    if (Number.isSafeInteger(list[i])) safe++;
    if (Number.isNaN(list[i])) none++;
  }
  return [whole, finite, safe, none].join(",");
}

function ofResults(x: number, y: number): string {
  return flags(Number.isNaN(x - y), Number.isFinite(x * y), Number.isInteger(x / y), Number.isSafeInteger(x + y), Number.isInteger(x | 0), Number.isNaN(x | 0), Number.isFinite((x | 0) + (y | 0)), Number.isSafeInteger((x | 0) * (y | 0)), Number.isInteger(x % y), Number.isNaN((x | 0) % (y | 0)));
}

const lines: string[] = [];
for (let round = 0; round < 3; round++) {
  lines.length = 0;
  for (let i = 0; i < numbers.length; i++) {
    const x = launder(numbers[i]);
    const y = launder(numbers[(i * 7 + 3) % numbers.length]);
    const one = launder(new Measured(x, i, i % 3 === 0 ? undefined : x, i % 2 === 0 ? x : String(x)));
    lines.push(i + " " + ofNumber(x) + " " + ofFields(one) + " " + ofResults(x, y));
  }
  for (let i = 0; i < others.length; i++) {
    const one = launder(new Measured(i + 0.5, i, undefined, launder(others[i])));
    lines.push("other " + i + " " + ofFields(one));
  }
  lines.push(ofElements(launder(numbers)), ofElements(launder([1, 2, 3])), ofElements(launder([1.5, NaN, Infinity])), ofElements(launder([])));
}
console.log(lines.join("\n"));
