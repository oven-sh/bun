// Array.prototype stays extensible in a compiled program, but it takes no key that the language makes of `undefined`, `null`, `true` or `false`. A store that would add one and that every run reaches stops the build. language/keys-made-of-primitives-are-closed has the stores that throw when they run, and the names that can be added.
Array.prototype[undefined] = "found";
console.log([][undefined]);
export {};
//// keys-made-of-primitives-are-closed.js
// A prototype under the usual lock takes no key that the language makes of a value that is no string: the text of a number, `undefined`, `null`, `true`, `false`. So `array[key]` with a key that was read past the end finds nothing, whatever else the program adds. A store under such a key throws in strict code. An ordinary new name is stored, and so is such a key on an object that is no locked prototype. language/keys-made-of-primitives-are-closed-sloppy has the stores that are ignored, language/key-made-of-a-primitive-stops-the-build the store that stops the build.
function store(object, key) {
  try { object[key] = "added"; } catch (e) { return e.name; }
  const stored = object[key] === "added";
  delete object[key];
  return stored ? "stored" : "ignored";
}
const keys = [undefined, null, true, false, NaN, Infinity, -Infinity, -1, 1.5, 1e21, 1e-7, 4294967295, 4294967296, "undefined", "null", "nothing", "True"];
function row(name, object) {
  let line = name + ":";
  for (const key of keys) line += " " + (typeof key === "string" ? JSON.stringify(key) : String(key)) + " " + store(object, key);
  console.log(line);
}
row("Array.prototype", Array.prototype);
row("String.prototype", String.prototype);
row("Number.prototype", Number.prototype);
row("Map.prototype", Map.prototype);
row("Uint8Array.prototype", Uint8Array.prototype);
row("the prototype of typed arrays", Object.getPrototypeOf(Uint8Array.prototype));
row("Promise", Promise);
row("Date.prototype", Date.prototype);
row("WeakRef.prototype", WeakRef.prototype);
row("an array", []);
row("an object", {});

const numbers = [1, 2, 5];
let key = 1;
for (let i = 0; i < 5; i++) key = numbers[key];
console.log("read past the end:", key, numbers[undefined], numbers[null], "abc"[undefined], new Uint8Array(2)[true]);
export {};
//// keys-made-of-primitives-are-closed-sloppy/main.cjs
// In sloppy code a store to a locked prototype under a key that the language makes of a value that is no string throws a TypeError, as in strict code. An ordinary new name is stored. language/keys-made-of-primitives-are-closed has the strict stores.
function store(object, key) {
  try { object[key] = "added"; } catch (e) { return e.name; }
  var stored = object[key] === "added";
  delete object[key];
  return stored ? "stored" : "ignored";
}
var keys = [undefined, null, true, false, NaN, -1, 1.5, 0, "nothing"];
function row(name, object) {
  var line = name + ":";
  for (var i = 0; i < keys.length; i++) line += " " + String(keys[i]) + " " + store(object, keys[i]);
  console.log(line);
}
row("Array.prototype", Array.prototype);
row("String.prototype", String.prototype);
row("Date.prototype", Date.prototype);
row("WeakRef.prototype", WeakRef.prototype);
//// labeled-var-statements.js
// ECMAScript has a label in front of any statement, a `var` statement among them. TypeScript refuses it (TS1344).
outer: var x = 0, y = 0;
loop: do {
  inner: x = 2;
  break;
  never: var y = 2;
} while (0);
another: do {} while (0);
function count() {
  first: var n = 1;
  second: for (var i = 0; i < 3; i++) {
    third: var m = i;
    if (i === 1) continue second;
    n += m;
  }
  return n;
}
console.log(x, y, count());
//// language-errors.js
// The errors the language itself throws, each with its name and message, and the same constructs used legally.
function report(label, body) {
  try {
    console.log(label, "returned", body());
  } catch (error) {
    console.log(label, "threw", error.name, error.message);
  }
}

class Base {
  value = 1;
  read() {
    return this.value;
  }
}

report("uninitialized binding", () => {
  const read = () => late;
  const result = read();
  let late = 1;
  return result + late;
});
report("initialized binding", () => {
  let early = 1;
  const read = () => early;
  return read();
});

report("unresolvable reference", () => notDeclaredAnywhere);
report("typeof unresolvable reference", () => typeof notDeclaredAnywhere);

report("constant assignment", () => {
  class Immutable {
    static rebind() {
      Immutable = 2;
    }
  }
  Immutable.rebind();
  return typeof Immutable;
});
report("let assignment", () => {
  let variable = 1;
  variable = 2;
  return variable;
});

report("uninitialized this", () => {
  class Early extends Base {
    constructor() {
      const value = this.value;
      super();
      this.copy = value;
    }
  }
  return new Early().copy;
});
report("this after super", () => {
  class Late extends Base {
    constructor() {
      super();
      this.copy = this.value;
    }
  }
  return new Late().copy;
});

report("this already bound", () => {
  class Twice extends Base {
    constructor() {
      super();
      super();
    }
  }
  return new Twice().value;
});
report("one super call", () => {
  class Once extends Base {
    constructor() {
      super();
    }
  }
  return new Once().value;
});

report("delete super property", () => {
  class Deleter extends Base {
    remove() {
      return delete super.read;
    }
  }
  return new Deleter().remove();
});
report("delete own property", () => {
  const object = { member: 1 };
  return delete object.member;
});

report("destructure named property of null", () => {
  const source = null;
  const { member } = source;
  return member;
});
report("destructure named property of undefined", () => {
  const source = undefined;
  const { member } = source;
  return member;
});
report("destructure empty pattern of null", () => {
  const source = null;
  const {} = source;
  return 0;
});
report("destructure object", () => {
  const source = { member: 1 };
  const { member } = source;
  return member;
});

report("derived constructor result in named class", () => {
  class Named extends Base {
    constructor() {
      super();
      return 1;
    }
  }
  return new Named().value;
});
report("derived constructor result in anonymous class", () => {
  const Anonymous = (() =>
    class extends Base {
      constructor() {
        super();
        return 1;
      }
    })();
  return new Anonymous().value;
});
report("derived constructor returns object", () => {
  class ReturnsObject extends Base {
    constructor() {
      super();
      return { value: 2 };
    }
  }
  return new ReturnsObject().value;
});

