// Variables and fields that hold a number or `undefined`: what arithmetic on `undefined` yields is NaN, and is stored as NaN.
declare const console: { log(...values: unknown[]): void };
function show(value: unknown): string { return typeof value === "number" && Object.is(value, -0) ? "-0" : String(value); }
function makeCounter() {
    const api = { up, down, add, scale, read, kind, clear, set };
    early.push(show(api.read()), api.kind(), show(api.up()), api.kind(), show(api.read()));
    var count = 0;
    function up(): number { count++; return count; }
    function down(): number { count--; return count; }
    function add(by: number): number { count += by; return count; }
    function scale(by: number): number { count *= by; return count; }
    function read(): number { return count; }
    function kind(): string { return typeof count; }
    function clear(): void { count = undefined!; }
    function set(to: number): void { count = to; }
    return api;
}
const early: string[] = [];
const counter = makeCounter();
console.log(early.join(" "));
console.log(show(counter.read()), show(counter.up()), show(counter.up()), show(counter.down()), show(counter.add(2.5)), show(counter.scale(-0)), show(counter.scale(5)), counter.kind());
for (const value of [NaN, Infinity, -Infinity, -0, 5e-324, 2 ** 53, -(2 ** 31), 0.1]) {
    counter.set(value);
    console.log(show(counter.read()), show(counter.up()), show(counter.down()), show(counter.add(value)), show(counter.scale(0)), show(counter.scale(NaN)), show(counter.read()), counter.kind());
}
class Row { width?: number; height: number | undefined = undefined; depth: number | null = null; }
function grow(row: Row, by: number): string {
    row.width = (row.width as number) + by;
    row.height = (row.height as number) * by;
    row.depth = (row.depth as number) - by;
    return show(row.width) + " " + show(row.height) + " " + show(row.depth) + " " + typeof row.width + " " + typeof row.height + " " + ("width" in row) + " " + (row.height === undefined) + " " + (row.depth === null);
}
const row = new Row();
console.log(show(row.width), show(row.height), show(row.depth), "width" in row);
console.log(grow(row, 1));
console.log(grow(row, 2));
row.width = 1; row.height = 2; row.depth = 3;
console.log(grow(row, 0.5), "|", grow(row, -0), "|", grow(row, NaN), "|", grow(row, 1));
row.width = undefined; row.height = undefined; row.depth = null;
console.log(show(row.width), show(row.height), show(row.depth), "width" in row, JSON.stringify(row));
const bits = new Float64Array(1), words = new Uint32Array(bits.buffer);
for (const high of [0x7ffa0000, 0x7ffb0000, 0x7ffc0000, 0xfffa0000, 0x7ff80001, 0x7ff00001]) {
    words[0] = 0; words[1] = high;
    counter.set(bits[0]); row.width = bits[0]; row.height = bits[0] + 1; row.depth = -bits[0];
    console.log(show(counter.read()), counter.kind(), show(counter.up()), show(row.width), typeof row.width, show(row.height), typeof row.height, show(row.depth), typeof row.depth, row.depth === null, row.height === undefined);
}
//// optional-numbers.ts
// Optional numbers: parameters, fields and results that may be undefined.
class P { a: number | undefined; b: number | null; c?: number; d: number | undefined | null
  constructor(a: number | undefined, b: number | null, d: number | undefined | null) { this.a = a; this.b = b; this.d = d } }
function pick(i: number): number | undefined { return i % 3 === 0 ? undefined : i }
function half(i: number): number | null { return i % 2 === 0 ? i / 4 : null }
function both(i: number): number | undefined | null { return i % 3 === 0 ? undefined : i % 3 === 1 ? null : i * 0.5 }
function show(x: number | undefined | null): string { return x === undefined ? "u" : x === null ? "n" : "" + x }
let out = ""
let sum = 0
for (let i = 0; i < 12; i++) {
  const p = new P(pick(i), half(i), both(i))
  if (i % 4 === 0) p.c = i
  sum += (p.a ?? 100) + (p.b ?? 1000) + (p.c ?? 10000) + (p.d ?? 0.25)
  out += show(p.a) + show(p.b) + show(p.c) + show(p.d) + (p.a ? "T" : "F") + (p.b ? "T" : "F") + (p.d ? "T" : "F") + (p.a === p.d ? "=" : "!") + (p.b === p.d ? "=" : "!") + (p.a == null ? "0" : "1") + " "
}
console.log(out)
console.log(sum)
const raw = new Float64Array(2), bytes = new Uint8Array(8)
raw[0] = 0 / 0
let m: number | undefined = raw[0]!
if (sum > 1e9) m = undefined
console.log(m === undefined, m !== m, show(m))
const q = new P(0, 0, 0)
console.log(q.a ? 1 : 2, q.b ? 1 : 2, q.d ? 1 : 2, q.a === 0, q.b === 0, q.d === 0, q.c === undefined, bytes.length)
console.log(JSON.stringify(new P(1, null, 2.5)), JSON.stringify(new P(undefined, 3, null)))
//// optional-slots.ts
declare const console: { log(...values: unknown[]): void };
const text = "abcdefghijklmnopqrstuvwxyz";
const given: number[] = [0, -0, 1, 2, 25, 26, -1, 3.5, 2147483647, -2147483648, 2147483648, 4294967296, 1e21, NaN, Infinity, -Infinity];
function holed(): number[] { const a = given.slice(); delete (a as unknown[])[2]; return a; }
function show(v: unknown): string { return typeof v === "number" ? (Object.is(v, -0) ? "-0" : String(v)) : typeof v + ":" + String(v); }
function codes(a: number[]): string { let s = ""; for (let i = 0; i < a.length + 1; i++) s += show(text.charCodeAt(a[i])) + ","; return s; }
function points(a: number[]): string { let s = ""; for (let i = 0; i < a.length + 1; i++) s += show(text.codePointAt(a[i])) + ","; return s; }
function letters(a: number[]): string { let s = ""; for (let i = 0; i < a.length + 1; i++) s += show(text[a[i]]) + ","; return s; }
function lettersAt(a: number[]): string { let s = ""; for (let i = 0; i < a.length + 1; i++) s += show(text.at(a[i])) + "," + show(text.charAt(a[i])) + ","; return s; }
function parts(a: number[]): string { let s = ""; for (let i = 0; i < a.length; i++) s += text.slice(a[i], a[i + 1]).length + "," + text.substring(a[i], a[i + 1]).length + ","; return s; }
function gathered(a: number[], b: number[]): string { let s = ""; for (let i = 0; i < a.length + 1; i++) s += show(b[a[i]]) + ","; return s; }
function scattered(a: number[]): string { const b: number[] = [9, 9, 9, 9]; for (let i = 0; i < 5; i++) b[a[i]] = i; return b.map(show).join() + " " + Object.keys(b).join(); }
function taken(a: number[], b: number[]): string { let s = ""; for (let i = 0; i < a.length + 1; i++) s += show(b.at(a[i])) + "," + b.slice(a[i]).length + "," + b.indexOf(2, a[i]) + ","; return s; }
function padded(a: number[]): string { let s = ""; for (let i = 0; i < 6; i++) s += "x".padStart(a[i] % 7).length + "," + "ab".repeat(Math.abs(a[i]) % 3).length + ","; return s; }
function fixed(a: number[]): string { let s = ""; for (let i = 0; i < 5; i++) s += (1.23456).toFixed(a[i]) + ","; return s; }
function one(a: number[], i: number): string { return show(text.charCodeAt(a[i])) + show(text[a[i]]) + show(a[a[i]]); }
function shifted(a: number[]): string { let s = ""; for (let i = 0; i < a.length + 1; i++) s += (1 << a[i]) + "," + (a[i] | 0) + "," + (a[i] >>> 0) + ","; return s; }
for (let turn = 0; turn < 2; turn++) {
    for (const [name, make] of [["given", () => given.slice()], ["holed", holed], ["parsed", () => JSON.parse("[0,1,2,25,26,-1]") as number[]], ["none", (): number[] => []]] as [string, () => number[]][]) {
        const say = (what: string, run: () => string) => { let said: string; try { said = run(); } catch (e) { said = e instanceof TypeError ? "TypeError" : e instanceof RangeError ? "RangeError" : "threw"; } console.log(name + " " + what + ": " + said); };
        say("codes", () => codes(make())); say("points", () => points(make())); say("letters", () => letters(make())); say("lettersAt", () => lettersAt(make())); say("parts", () => parts(make()));
        say("gathered", () => gathered(make(), [10, 11.5, 12])); say("gathered whole", () => gathered(make(), JSON.parse("[7,8,9]") as number[])); say("scattered", () => scattered(make())); say("taken", () => taken(make(), [1, 2, 3, 2]));
        say("padded", () => padded(make())); say("fixed", () => fixed(make())); say("shifted", () => shifted(make())); say("one", () => [0, 2, 5, 13, 99].map(i => one(make(), i)).join(" "));
    }
}
//// out-of-bounds-array-access.ts
// Out-of-bounds reads and writes, and missing numbers in arithmetic.
function at(a: number[], i: number): number | undefined { return a[i] }
function plus(a: number[], i: number): number { return a[i] + 1 }
function less(a: number[], i: number): boolean { return a[i] < 5 }
function f64(a: Float64Array, i: number): number { return a[i] * 2 }
function i32(a: Int32Array, i: number): number { return a[i] + 1 }
function hide(x: unknown): any { return x }
function add(x: number | undefined, y: number | null): number { return hide(x) + hide(y) }
const list = [1, 2, 3], floats = new Float64Array(2), ints = new Int32Array(2)
floats[0] = 1.5; floats[5] = 9; ints[1] = 7; ints[-1] = 3; ints[2] = 4
console.log(at(list, 1), at(list, 3), at(list, -1), plus(list, 2), plus(list, 3), less(list, 0), less(list, 9))
console.log(f64(floats, 0), f64(floats, 2), f64(floats, 5), i32(ints, 1), i32(ints, 2), i32(ints, -1), floats.length, ints.length)
console.log(add(1, 2), add(undefined, 2), add(1, null), add(undefined, null))
const grown = [1, 2]
grown[2] = 3; grown[5] = 6
console.log(grown.length, at(grown, 2), at(grown, 3), at(grown, 5), plus(grown, 4))
grown[100000] = 1
console.log(grown.length, at(grown, 100000), at(grown, 99999), at(grown, 1))
//// package-pattern-define-getters-on-string-prototype.js
// In the manner of the package colors: one getter on String.prototype for each style, defined with __defineGetter__. One of the names, bold, is a method that String.prototype has from the start.
const codes = { reset: [0, 0], bold: [1, 22], dim: [2, 22], italic: [3, 23], underline: [4, 24], red: [31, 39], green: [32, 39], bgBlue: [44, 49] };
function stylize(text, style) { return "<" + codes[style][0] + ">" + text + "</" + codes[style][1] + ">"; }

const hadBold = typeof String.prototype.bold;
for (const style of Object.keys(codes)) {
  String.prototype.__defineGetter__(style, function () { return stylize(this, style); });
}

function paint(text) { return text.red.bold; }
console.log([hadBold, "a".red, "a".bold, "a".green.underline, paint("b"), `x${1}`.dim, new String("c").bgBlue, typeof "a".bold, "a".italic, typeof "a".italics].join(" "));
console.log([typeof String.prototype.__lookupGetter__("bold"), typeof Object.getOwnPropertyDescriptor(String.prototype, "bold").get, Object.keys(String.prototype).sort().join(), "abc".toUpperCase(), "a-b".split("-").length].join(" "));
//// pass-through-expressions.ts
// Every expression form that passes a value through unchanged: `satisfies`, assignments, the comma operator, parentheses, conditionals.
declare const console: { log(...values: unknown[]): void };
function run(f: () => void) { f(); }
function row(name: string, f: () => unknown) {
    let said: string;
    try { const got = f(); said = typeof got + " " + JSON.stringify(got); } catch (error) { said = "threw " + (error as Error).name + " " + (error as Error).message; }
    console.log(name + ": " + said);
}
function take(x: string | undefined) { return x; }
row("the name alone", () => { let id: string | undefined = undefined; run(() => { id = "a" }); const v = id; return { v }; });
row("satisfies unknown", () => { let id: string | undefined = undefined; run(() => { id = "a" }); const v = id satisfies unknown; return { v }; });
row("satisfies its own type", () => { let id: string | undefined = undefined; run(() => { id = "a" }); const v = id satisfies string | undefined; return { v }; });
row("satisfies twice", () => { let id: string | undefined = undefined; run(() => { id = "a" }); const v = (id satisfies unknown) satisfies unknown; return { v }; });
row("an assignment to itself", () => { let id: string | undefined = undefined; run(() => { id = "a" }); const v = (id = id); return { v }; });
row("an assignment to another", () => { let id: string | undefined = undefined; let other: string | undefined; run(() => { id = "a" }); const v = (other = id); return { v, other }; });
row("behind a comma", () => { let id: string | undefined = undefined; const v = (run(() => { id = "a" }), id); return { v }; });
row("satisfies under a condition", () => { let id: string | undefined = undefined; run(() => { id = "a" }); const v = take("x") ? (id satisfies unknown) : null; return { v }; });
row("a condition that satisfies", () => { let id: string | undefined = undefined; run(() => { id = "a" }); const v = (take("x") ? id : null) satisfies unknown; return { v }; });
row("satisfies under ??", () => { let id: string | undefined = undefined; run(() => { id = "a" }); const v = take(undefined) ?? (id satisfies unknown); return { v }; });
row("satisfies under ||", () => { let id: string | undefined = undefined; run(() => { id = "a" }); const v = take(undefined) || (id satisfies unknown); return { v }; });
row("satisfies under &&", () => { let id: string | undefined = undefined; run(() => { id = "a" }); const v = take("x") && (id satisfies unknown); return { v }; });
row("satisfies and then !", () => { let id: string | undefined = undefined; run(() => { id = "a" }); const v = (id satisfies unknown)!; return { v }; });
row("as the value of a property", () => { let id: string | undefined = undefined; run(() => { id = "a" }); return { v: id satisfies unknown }; });
row("as an element", () => { let id: string | undefined = undefined; run(() => { id = "a" }); return [id satisfies unknown]; });
