////= lines-26	ofFloat64Elements	Float64Array	1099511627776: text += "w

////= lines-5	ofString	string	5	"five"
function ofStringLiteral(subject: "5" | "0"): string {
  switch (subject as any) {
    case 0: return "zero";
    case 5: return "five";
    default: return "other";
  }
}
