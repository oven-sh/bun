function middle(kind) {
  return [inner(kind)];
}
async function outer(kind) {
  let caught;
  try {
    middle(kind);
  } catch (error) {
    caught = error;
  }
  await undefined;
  const names = frameNames(caught);
  const end = names.indexOf("outer") + 1;
  console.log(`limit ${Error.stackTraceLimit}, ${kind}: ${caught.name} [${names.slice(0, end || names.length).join(" < ")}]`);
}
