//// one-of-many-string-literals.ts
// A value is tested for a union of string literals of 1, 2, 3, 4, 12 and 70 members, with every kind of value: members, other literals of the program,
// strings made at run time that equal a member, strings that equal none, ropes, and what is no string.
type One = "alpha";
type Two = "alpha" | "beta";
type Three = Two | "gamma";
type Four = Three | "delta";
type Twelve = Four | "epsilon" | "zeta" | "eta" | "theta" | "iota" | "kappa" | "lambda" | "mu";

const seventy = [
    "k00", "k01", "k02", "k03", "k04", "k05", "k06", "k07", "k08", "k09", "k10", "k11", "k12", "k13", "k14", "k15", "k16", "k17", "k18", "k19",
    "k20", "k21", "k22", "k23", "k24", "k25", "k26", "k27", "k28", "k29", "k30", "k31", "k32", "k33", "k34", "k35", "k36", "k37", "k38", "k39",
    "k40", "k41", "k42", "k43", "k44", "k45", "k46", "k47", "k48", "k49", "k50", "k51", "k52", "k53", "k54", "k55", "k56", "k57", "k58", "k59",
    "k60", "k61", "k62", "k63", "k64", "k65", "k66", "k67", "k68", "k69",
] as const;
type Seventy = (typeof seventy)[number];

function takesOne(value: One): string { return "one:" + value; }
function takesTwo(value: Two): string { return "two:" + value; }
function takesThree(value: Three): string { return "three:" + value; }
function takesFour(value: Four): string { return "four:" + value; }
function takesTwelve(value: Twelve): string { return "twelve:" + value; }
function takesSeventy(value: Seventy): string { return "seventy:" + value; }

function isTwelve(value: unknown): value is Twelve {
    return value === "alpha" || value === "beta" || value === "gamma" || value === "delta" || value === "epsilon" || value === "zeta"
        || value === "eta" || value === "theta" || value === "iota" || value === "kappa" || value === "lambda" || value === "mu";
}

function rankOf(value: Twelve): number {
    switch (value) {
    case "alpha": return 1;
    case "beta": return 2;
    case "gamma": return 3;
    case "delta": return 4;
    case "epsilon": return 5;
    case "zeta": return 6;
    case "eta": return 7;
    case "theta": return 8;
    case "iota": return 9;
    case "kappa": return 10;
    case "lambda": return 11;
    case "mu": return 12;
    }
}

const takers: ((value: any) => string)[] = [takesOne, takesTwo, takesThree, takesFour, takesTwelve, takesSeventy];

function made(text: string): string {
    return text.split("").join("");
}

const values: unknown[] = [
    "alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "kappa", "lambda", "mu", "nu", "", "a", "k00", "k31", "k32", "k63", "k64", "k69", "k70",
    made("alpha"), made("mu"), made("k69"), made("omega"), "al" + made("pha"), "k" + String(6) + String(4), made("Alpha"), "alpha ", "α",
    undefined, null, true, false, 0, 1, -0, NaN, 1.5, 10n, Symbol.for("alpha"), {}, [], ["alpha"], new String("alpha"), { toString() { return "alpha"; } }, () => "alpha",
];

for (let round = 0; round < 3; round++) {
    for (const value of values) {
        const row: string[] = [];
        for (const taker of takers) {
            try {
                row.push(taker(value));
            } catch (error) {
                row.push((error as Error).constructor.name);
            }
        }
        console.log(round, typeof value, isTwelve(value) ? rankOf(value) : "-", row.join(" "));
    }
}
//// one-site-reads-a-name-of-many-kinds-of-receiver.js
// One site reads one name of receivers that take turns: objects of several shapes, with the property their own, inherited, computed or absent, and primitives, which answer from their prototypes.
////= lines-22	tagOf	value	value.tag

function describe(value) {
  try {
    return String(tagOf(value));
  } catch (error) {
    return error.constructor.name;
  }
}

Number.prototype.tag = "number";
Boolean.prototype.tag = "boolean";
String.prototype.tag = "string";
Symbol.prototype.tag = "symbol";
BigInt.prototype.tag = "bigint";

class Base {
  get tag() {
    return "getter of " + this.name;
  }
}
class Heir extends Base {
  constructor(name) {
    super();
    this.name = name;
  }
}
function Plain(tag) {
  this.tag = tag;
}
const many = {};
for (let i = 0; i < 40; i++) many["k" + i] = i;
many.tag = "out of line";

const receivers = [
  { tag: "own" }, { other: 1, tag: "second slot" }, { other: 1 }, {}, new Plain("made"), new Heir("heir"), Object.create({ tag: "inherited" }),
  Object.create(null), many, [1, 2], Object.assign([], { tag: "array" }), function () {}, Object.assign(() => 0, { tag: "function" }),
  new Proxy({}, { get: () => "trapped" }), 1, 1.5, NaN, true, false, "text", "", Symbol("s"), 10n, null, undefined,
];

function round(order) {
  const answers = [];
  for (const index of order) answers.push(describe(receivers[index]));
  return answers.join(" | ");
}

const inTurn = receivers.map((_, index) => index);
console.log(round(inTurn));
console.log(round(inTurn.slice().reverse()));

// The same receiver many times, so that the site settles on it, and then each of the others once.
for (const settled of inTurn) {
  let last = "";
  for (let i = 0; i < 300; i++) last = describe(receivers[settled]);
  console.log(last + " : " + round(inTurn));
}

delete Number.prototype.tag;
receivers[0].tag = "stored again";
delete receivers[1].tag;
console.log(round(inTurn));
//// one-value-taken-in-two-forms-by-one-operation.ts
// One operation takes one value twice, and each place wants it in a form of its own: an index as a machine integer and the same number as the element, a cell as the owner and as what is stored.
declare const console: { log(...values: unknown[]): void };

function indexIsElement(length: number): unknown[] {
    const list: unknown[] = [];
    for (let i = 0; i < length; i++) list[i] = i;
    return list;
}

function indexIsElementOfNumbers(length: number): number[] {
    const list: number[] = [0.5];
    for (let i = 1; i < length; i++) list[i] = i;
    return list;
}

class Node {
    self: Node | undefined = undefined;
    next: unknown = undefined;
    constructor(public id: number) { }
}

function pointsAtItself(id: number): Node {
    const node = new Node(id);
    node.self = node;
    node.next = node;
    return node;
}

function both(a: number, b: unknown): string { return typeof a + ":" + a + " " + typeof b + ":" + String(b); }
function passedTwice(value: number): string { return both(value, value); }
function sumWithItself(value: number): unknown[] { return [value + value, value * value, value === value, [value, value]]; }
function keyIsValue(map: Map<unknown, unknown>, n: number): void { map.set(n, n); }
function charAndIndex(text: string, i: number): unknown[] { return [text.charCodeAt(i), i, text[i], text.slice(i, i)]; }

console.log(JSON.stringify(indexIsElement(5)), JSON.stringify(indexIsElementOfNumbers(4)));
const node = pointsAtItself(7);
console.log(node.self === node, node.next === node, node.self!.id);
console.log(passedTwice(3), passedTwice(2.5), passedTwice(-0), passedTwice(NaN), passedTwice(2 ** 40));
console.log(JSON.stringify(sumWithItself(21)), JSON.stringify(sumWithItself(0.25)), JSON.stringify(sumWithItself(2 ** 31)));
const map = new Map<unknown, unknown>();
for (let n = 0; n < 3; n++) keyIsValue(map, n + 0.5 * (n & 1));
console.log(JSON.stringify([...map]));
console.log(JSON.stringify(charAndIndex("forms", 2)), JSON.stringify(charAndIndex("forms", 9)));
