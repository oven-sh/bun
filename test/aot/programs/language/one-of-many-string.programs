// `a === b` and `a !== b` where the compiler knows nothing of either side: every kind of value against every kind, the same value twice, and equal content in two cells.
const hide = new Function("v", "return v" + String(process.argv[9] ?? "").slice(99)) as <T>(v: T) => T;
function same(a: unknown, b: unknown): boolean { return a === b; }
function differ(a: unknown, b: unknown): boolean { return a !== b; }
function pick(a: unknown, b: unknown): string { if (a === b) return "="; return "."; }

class Point { constructor(public x: number) {} }
const object = { a: 1 }, array = [1], point = new Point(1), fn = function () {}, arrow = () => 1, symbol = Symbol("s"), date = new Date(0), map = new Map(), regexp = /a/, proxy = new Proxy({}, {}), boxed = Object("text");
const values: [string, unknown][] = [
    ["undefined", undefined], ["null", null], ["true", true], ["false", false],
    ["0", 0], ["-0", -0], ["1", 1], ["1.5", 1.5], ["NaN", NaN], ["Infinity", Infinity], ["2**31", 2 ** 31], ["-2**31", -(2 ** 31)], ["1 as a double", hide(0.5) + 0.5],
    ["empty string", ""], ["a", "a"], ["text", "text"], ["text, built", hide("te") + hide("xt")], ["text, sliced", hide("a text b").slice(2, 6)], ["long", "x".repeat(40)], ["long, built", hide("x".repeat(20)) + hide("x".repeat(20))], ["long, other end", "x".repeat(39) + "y"],
    ["wide text", "tėxt"], ["wide text, built", hide("tė") + hide("xt")], ["1 as text", "1"],
    ["10n", 10n], ["10n, computed", hide(5n) * 2n], ["2n**70n", 2n ** 70n], ["2n**70n, computed", hide(2n) ** 70n], ["-10n", -10n],
    ["symbol", symbol], ["another symbol", Symbol("s")], ["registered symbol", Symbol.for("s")], ["registered symbol again", Symbol.for("s")],
    ["object", object], ["object of the same shape", { a: 1 }], ["array", array], ["another array", [1]], ["point", point], ["another point", new Point(1)],
    ["function", fn], ["arrow", arrow], ["date", date], ["another date", new Date(0)], ["map", map], ["regexp", regexp], ["proxy", proxy], ["boxed text", boxed], ["global object", globalThis], ["Math", Math],
];
for (const [name, a] of values) {
    let row = "";
    for (const [, b] of values) {
        const x = hide(a), y = hide(b);
        const answer = same(x, y);
        if (answer === differ(x, y) || (pick(x, y) === "=") !== answer) throw new Error("the three forms disagree at " + name);
        row += answer ? "=" : ".";
    }
    console.log(row, name);
}
//// sums-compared-with-bounds.ts
declare const console: { log(...values: unknown[]): void };
class Item { constructor(public id: number) { } }
function runsOf(items: readonly Item[]): string {
    let result = "";
    const length = items.length;
    let i = 0;
    while (i < length) {
        const startId = items[i].id;
        let count = 1;
        while (i + count < length && items[i + count].id === startId + count) count++;
        if (result.length) result += ",";
        result += startId;
        if (count > 1) result += ":" + count;
        i += count;
    }
    return result;
}
function mirrored(items: readonly Item[]): number {
    let i = 0, total = 0;
    while (i < items.length) { let count = 1; while (items.length > count + i && items[count + i].id > 0) count++; total += count * (i + 1); i += count; }
    return total;
}
function inclusive(items: readonly Item[]): number {
    let i = 0, total = 0;
    const last = items.length - 1;
    while (i <= last) { let count = 0; while (i + count <= last && items[i + count].id % 2 === 0) count++; total += count; i += count + 1; }
    return total;
}
function negativeAddend(items: readonly Item[], back: number): number {
    let i = 2, total = 0;
    const offset = back | 0;
    while (i + offset < items.length && i < 100) { total += i; i += 3; }
    return total;
}
function fractionalBound(limit: number): number {
    let i = 0, count = 1, turns = 0;
    while (i + count < limit && turns < 50) { count++; i += count; turns++; }
    return i * 1000 + count;
}
function hugeStep(limit: number): string {
    let i = 0, step = 1, turns = 0;
    while (i + step < limit && turns < 2000) { i += step; step += step; turns++; }
    return i + " " + step + " " + turns;
}
function fractionalAddend(limit: number, addend: number): number {
    let i = 0;
    while (i + addend < limit) i++;
    return i;
}
const make = (...ids: number[]) => ids.map(id => new Item(id));
for (let round = 0; round < 2; round++) {
    console.log(runsOf(make()), "|", runsOf(make(5)), "|", runsOf(make(1, 2, 3, 7, 8, 20)), "|", runsOf(make(3, 3, 4, 5, 5.5, 6.5, -1, 0, 1)), "|", runsOf(make(NaN, NaN, 1)));
    console.log(mirrored(make(1, 2, 0, 4, 5, 6, 0, 0)), inclusive(make(2, 4, 1, 6, 3, 8, 8, 8)), inclusive(make()), mirrored(make()));
    console.log(negativeAddend(make(1, 2, 3, 4, 5, 6, 7, 8, 9), -4), negativeAddend(make(1, 2, 3), -2147483648), negativeAddend(make(1, 2, 3), 5), negativeAddend(make(1, 2, 3), 0.5));
    console.log(fractionalBound(10.5), fractionalBound(NaN), fractionalBound(Infinity), fractionalBound(-1), fractionalBound(1e300));
    console.log(hugeStep(1e30), "|", hugeStep(Infinity), "|", hugeStep(9007199254740993), "|", hugeStep(100));
    console.log(fractionalAddend(5, 0.5), fractionalAddend(5, -0.5), fractionalAddend(5, NaN), fractionalAddend(3, -2.25));
}
const many: Item[] = []; for (let i = 0; i < 5000; i++) many.push(new Item(i % 7 === 0 ? i * 2 : i));
console.log(runsOf(many).length, mirrored(many), inclusive(many));
//// sums-truncated-to-32-bits.ts
// Sums in a hash loop that are truncated to 32 bits.
declare const console: { log(...values: unknown[]): void }

function hashPast(text: string, from: number, to: number): number {
    let h = 7
    for (let i = from; i < to; i++)
        h = (h * 31 + text.charCodeAt(i)) | 0
    return h
}

function onePast(text: string, index: number, seed: number): number {
    const x = seed | 0
    return (x + text.charCodeAt(index)) | 0
}

function oneLess(text: string, index: number, seed: number): number {
    const x = seed | 0
    return (text.charCodeAt(index) - x) | 0
}

function aboveExact(times: number): number {
    let n = 9007199254740985
    let r = 0
    for (let i = 0; i < times; i++) {
        n += 1
        r = (r * 3) ^ ((n + i) | 0)
    }
    return r
}

function belowExact(times: number): number {
    let n = -9007199254740985
    let r = 0
    for (let i = 0; i < times; i++) {
        n -= 1
        r = (r * 3) ^ ((n - i) | 0)
    }
    return r
}

function products(a: number, b: number, c: number): number {
    const x = (a | 0) * 4194304
    const y = (b | 0) * 4194304
    return ((x + y) | 0) ^ ((x - y) | 0) ^ (c | 0)
}

function wide(a: number, c: number): number {
    return (a | 0) * 2097152 + (c | 0)
}

function sumOfWide(a: number, c: number, b: number, d: number): number {
    const x = (a | 0) * 2097152 + (c | 0)
    const y = (b | 0) * 2097152 + (d | 0)
    return (x + y) | 0
}

function differenceOfWide(a: number, c: number, b: number, d: number): number {
    const x = (a | 0) * 2097152 + (c | 0)
    const y = (b | 0) * 2097152 + (d | 0)
    return (x - y) | 0
}

function sumOfProducts(a: number, b: number): number {
    const x = (a | 0) * 2097152
    const y = (b | 0) * 2097153
    return (x + y) | 0
}

function differenceOfProducts(a: number, b: number): number {
    const x = (a | 0) * 2097152
    const y = (b | 0) * 2097153
    return (x - y) | 0
}

function sumOfCounts(times: number): number {
    let n = 4503599627370496
    let m = 4503599627370496
    let r = 0
    for (let i = 0; i < times; i++) {
        n += 1
        if (i & 1)
            m += 1
        r = (r * 3) ^ ((n + m) | 0)
    }
    return r
}

function sumOfCountsDown(times: number): number {
    let n = -4503599627370496
    let m = -4503599627370496
    let r = 0
    for (let i = 0; i < times; i++) {
        n -= 1
        if (i & 1)
            m -= 1
        r = (r * 3) ^ ((n + m) | 0)
    }
    return r
}

function differenceOfCounts(times: number): number {
    let n = 4503599627370496
    let m = -4503599627370496
    let r = 0
    for (let i = 0; i < times; i++) {
        n += 1
        if (i & 1)
            m -= 1
        r = (r * 3) ^ ((n - m) | 0) ^ ((m - n) | 0)
    }
    return r
}

console.log("within", hashPast("abcdef", 0, 6), onePast("abc", 1, 5), oneLess("abc", 1, 5))
console.log("past the end", hashPast("abcdef", 0, 7), hashPast("abcdef", 4, 9), onePast("abc", 3, 5), onePast("abc", -1, 5), onePast("", 0, -9), oneLess("abc", 3, 5), oneLess("abc", 99, -5))
for (const times of [1, 3, 5, 6, 7, 8, 9, 12, 20])
    console.log("above", times, aboveExact(times), "below", times, belowExact(times))
console.log("products", products(2147483647, 2147483647, 1), products(-2147483648, 2147483647, 2), products(-2147483648, -2147483648, 3), products(2147483647, -2147483648, 4), products(1073741825, 1073741827, 5))
console.log("wide", wide(2147483647, 2147483647), wide(-2147483648, -2147483648))
console.log("sums of wide", sumOfWide(1, 2, 3, 4), sumOfWide(2147483647, 2147483647, 2147483647, 2147483646), sumOfWide(2147483647, 2147483645, 2147483647, 2147483646), sumOfWide(-2147483648, -2147483648, -2147483648, -2147483647), sumOfWide(-2147483648, -2147483645, -2147483648, -2147483648))
console.log("differences of wide", differenceOfWide(9, 8, 7, 6), differenceOfWide(2147483647, 2147483647, -2147483648, -2147483646), differenceOfWide(2147483647, 2147483644, -2147483648, -2147483647), differenceOfWide(-2147483648, -2147483648, 2147483647, 2147483647), differenceOfWide(-2147483648, -2147483646, 2147483647, 2147483647))
console.log("sums of products", sumOfProducts(3, 5), sumOfProducts(2147483647, 2147483647), sumOfProducts(2147483646, 2147483645), sumOfProducts(-2147483648, -2147483647), sumOfProducts(-2147483647, -2147483645), sumOfProducts(2147483647, -2147483647))
console.log("differences of products", differenceOfProducts(3, 5), differenceOfProducts(2147483647, -2147483647), differenceOfProducts(2147483645, -2147483645), differenceOfProducts(-2147483648, 2147483647), differenceOfProducts(-2147483646, 2147483645), differenceOfProducts(2147483647, 2147483647))
for (const times of [1, 2, 3, 4, 5, 8, 13])
    console.log("counts", times, sumOfCounts(times), sumOfCountsDown(times), differenceOfCounts(times))
export {}
