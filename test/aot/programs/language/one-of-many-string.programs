////: framesOf
function framesOf(error) {
  return error.stack
    .split("\n")
    .filter(line => line.includes("stack-frames-«1»"))
    .map(line => line.trim().replace(/\(.*[\\/]/, "(").replace(/at .*[\\/]/, "at "))
    .join(" | ");
}
