function countHoldsAgainstNaN(): number {
  let count = 0;
  for (let i = -1000; i < 1000; i++) {
    if (i < NaN) count++;
    if (NaN > i) count++;
  }
  return count;
}
function countHoldsAgainst(bound: number): number {
  let count = 0;
  for (let i = -1000; i < 1000; i++) {
    if (i < bound) count++;
    if (bound > i) count++;
  }
  return count;
}
