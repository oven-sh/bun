const beside = ["a".replace(/^/g, "b"), "a\nb".replace(/$/m, "!"), "a".replace(/^/, "$&$&"), "a".replace(/^/, "$$"), "a".replace(/a/, "b"), "a".replace("a", "b"), "a".replace(/^/, () => "c"), text.replace(/^/, "re"), "a".replace(/^/), "a".replaceAll(/^/g, "b")];
