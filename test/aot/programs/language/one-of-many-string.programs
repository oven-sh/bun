//// sets-made-from-arrays-of-numbers.js
// new Set(array) over int32, double and any-value storage: duplicates, -0 and 0, whole doubles beside int32s, NaN, holes, every size of table, and what is done to the set afterwards.
const lines = [];
const show = value => (Object.is(value, -0) ? "-0" : String(value));
const describe = set => `${set.size}: ${Array.from(set, show).join(" ")}`;
function check(name, array) {
  const set = new Set(array);
  const model = new Set();
  for (const element of array) model.add(element);
  lines.push(`${name}: ${describe(set).slice(0, 120)} ${describe(set) === describe(model) ? "as added one by one" : "DIFFERS FROM " + describe(model).slice(0, 120)}`);
  return set;
}

check("int32s", [1, 2, 3, 2, 1]);
check("one", [9]);
check("same", [4, 4, 4]);
check("empty", []);
check("negative", [-1, -2147483648, 2147483647, -1, 0]);
check("doubles", [1.5, 2.5, 1.5, -0.5, 1e300, -1e300, 5e-324]);
check("whole doubles", [1.5, 2, 2.0, 3, 1.5, 4294967296, 4294967296, -4294967296]);
check("zeros", [0.5, -0, 0, -0]);
check("infinities", [0.5, Infinity, -Infinity, Infinity]);
check("with NaN", [1.5, NaN, NaN, 0 / 0]);
check("int32s with a hole", [1, , 3, , 1]);
check("doubles with a hole", [1.5, , 3.5, , 1.5]);
check("mixed", [1, "1", 1.5, true, null, undefined, 1, "1"]);

const whole = [0.5];
whole.pop();
for (let i = 0; i < 6; i++) whole.push(i % 3);
check("int32s in double storage", whole);

for (const size of [2, 4, 5, 8, 9, 16, 17, 64, 65, 254, 255, 256, 1000, 5000, 70000]) {
  check(`distinct int32s ${size}`, Array.from({ length: size }, (_, i) => i * 7 - size));
  check(`distinct doubles ${size}`, Array.from({ length: size }, (_, i) => i * 0.25 + 0.125));
  check(`few among ${size}`, Array.from({ length: size }, (_, i) => i % 5));
  check(`few doubles among ${size}`, Array.from({ length: size }, (_, i) => (i % 5) + 0.5));
  check(`half among ${size}`, Array.from({ length: size }, (_, i) => i >> 1));
}

for (const size of [3, 8, 9, 300, 3000]) {
  const set = check(`changed later ${size}`, Array.from({ length: size }, (_, i) => i % 200));
  const before = set.size;
  lines.push([set.has(0), set.has(-0), set.has(1), set.has(1.0), set.has(199), set.has(200), set.has(0.5), set.has("1")].join());
  for (let i = 0; i < 40; i++) set.add(i + 0.5);
  set.add("text");
  set.add(set);
  for (let i = 0; i < size; i += 2) set.delete(i);
  lines.push(`${before} > ${set.size}: ${Array.from(set, value => (value === set ? "itself" : show(value))).slice(0, 12).join(" ")}`);
  let walked = 0;
  for (const value of set) {
    if (walked++ < 3) set.add(-walked);
  }
  lines.push(`${walked} walked, ${set.size}`);
  set.clear();
  lines.push(describe(set));
}

const source = [1, 2, 3];
const copy = new Set(source);
source.push(4);
source[0] = 9;
lines.push(describe(copy));

class Counted extends Set {
  added = 0;
  add(value) {
    this.added = (this.added ?? 0) + 1;
    return super.add(value);
  }
}
const counted = new Counted([1, 1.5, 1]);
lines.push(`${describe(counted)} ${counted.added}`);

class Odd extends Array {
  *[Symbol.iterator]() {
    yield "odd";
  }
}
lines.push(describe(new Set(Odd.from([1, 2]))));
const own = [1.5, 2.5];
own[Symbol.iterator] = function* () {
  yield "own";
};
lines.push(describe(new Set(own)));
lines.push(describe(new Set(Object.freeze([1, 2, 2]))));
lines.push(describe(new Set(Object.freeze([1.5, 2.5, 2.5]))));

console.log(lines.join("\n"));
//// sloppy-code-is-told-that-a-built-in-cannot-be-changed.cjs
// A CommonJS file is sloppy code, where a store to a read-only property is dropped without a word. A built-in object of an executable is more than read-only:
// the program goes on with a member that it believes it has replaced. So the refusal throws in sloppy code too.
const attempt = change => { try { return "went through: " + String(change()); } catch (error) { return error.name; } };
const push = Array.prototype.push;
console.log("a store:", attempt(() => { Array.prototype.push = function () { return 0; }; }), Array.prototype.push === push);
console.log("a store under a computed name:", attempt(() => { Array.prototype[["pu", "sh"].join("")] = function () { return 0; }; }), Array.prototype.push === push);
console.log("a deletion:", attempt(() => delete Array.prototype.map), typeof [].map);
console.log("a new member of Object.prototype:", attempt(() => { Object.prototype.extra = 1; }), "extra" in {});
console.log("a definition:", attempt(() => Object.defineProperty(Array.prototype, "push", { value: 1 })), Array.prototype.push === push);
console.log("Reflect.set answers:", attempt(() => Reflect.set(Array.prototype, "push", 1)), Array.prototype.push === push);
//// small-ifs-that-share-a-comparison.ts
// Loops whose small `if`s hang on an element read in the same turn: several variables chosen by one comparison, a variable that is an operand of the comparison that changes it, counters stepped on either side of a test, and values chosen against zero.
function fill(length: number, seed: number): Int32Array {
  const values = new Int32Array(length);
  let state = seed;
  for (let i = 0; i < length; i++) {
    state = (Math.imul(state, 22695477) + 1) >>> 0;
    values[i] = (state >>> 8) - (1 << 23);
  }
  return values;
}
function severalByOneTest(values: Int32Array): string {
  let a = 0;
  let b = 0;
  let c = 0;
  for (let i = 0; i < values.length; i++) {
    const v = values[i]!;
    if (v > 1000) {
      a = v;
      b = i;
      c++;
    }
  }
  return a + " " + b + " " + c;
}
function operandIsChanged(values: Int32Array): string {
  let greatest = -2147483648;
  let at = -1;
  let times = 0;
  for (let i = 0; i < values.length; i++) {
    const v = values[i]!;
    if (v > greatest) {
      greatest = v;
      at = i;
      times++;
    }
  }
  return greatest + " " + at + " " + times;
}
function counterIsAnOperand(values: Int32Array): string {
  let count = 0;
  let last = 0;
  for (let i = 0; i < values.length; i++) {
    const v = values[i]! & 1023;
    if (v > count) {
      count++;
      last = v;
    }
  }
  return count + " " + last;
}
function stepsOnEitherSide(values: Int32Array): string {
  let whenTrue = 0;
  let whenFalse = 0;
  let run = 0;
  let gap = 0;
  let longestRun = 0;
  for (let i = 0; i < values.length; i++) {
    const v = values[i]!;
    whenTrue = v < 0 ? whenTrue + 1 : whenTrue;
    whenFalse = v < 0 ? whenFalse : whenFalse + 1;
    run = v < 0 ? run + 1 : 0;
    gap = v < 0 ? 0 : gap + 1;
    if (run > longestRun) longestRun = run;
  }
  return [whenTrue, whenFalse, run, gap, longestRun].join(" ");
}
function wrapsAround(values: Int32Array): string {
  let low = 2147483646 | 0;
  let other = 5;
  for (let i = 0; i < values.length; i++) {
    const v = values[i]!;
    low = v < 0 ? (low + 1) | 0 : low;
    other = v > 0 ? (other + 1) | 0 : (low | 0);
  }
  return low + " " + other;
}
function byMask(values: Int32Array): string {
  let odd = 0;
  let lastOdd = 0;
  let third = 0;
  for (let i = 0; i < values.length; i++) {
    const v = values[i]!;
    if (v & 1) {
      odd++;
      lastOdd = v;
    }
    if ((v & 12) === 0) third++;
  }
  return odd + " " + lastOdd + " " + third;
}
function samples(values: Float64Array, threshold: number): string {
  let above = 0;
  let last = 0;
  for (let i = 0; i < values.length; i++) {
    const v = values[i]!;
    if (v > threshold) {
      above++;
      last = i;
    }
  }
  return above + " " + last;
}
for (const [length, seed] of [[0, 1], [1, 2], [7, 3], [4096, 987654321], [70000, 42]] as const) {
  const values = fill(length, seed);
  console.log(length, "|", severalByOneTest(values), "|", operandIsChanged(values), "|", counterIsAnOperand(values), "|", stepsOnEitherSide(values), "|", wrapsAround(values), "|", byMask(values));
  const sorted = values.slice().sort();
  console.log(length, "sorted |", severalByOneTest(sorted), "|", operandIsChanged(sorted), "|", counterIsAnOperand(sorted), "|", stepsOnEitherSide(sorted), "|", wrapsAround(sorted), "|", byMask(sorted));
}
console.log(samples(new Float64Array([0.5, NaN, 2.5, -1, Infinity, 2.5]), 2.5), samples(new Float64Array([NaN, NaN]), NaN), samples(new Float64Array(0), 0));
