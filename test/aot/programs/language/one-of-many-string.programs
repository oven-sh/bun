//// replaceable-members-of-built-in-prototypes-out-of-a-table.mjs
// The members of built-in prototypes that a compiled program lets be replaced, each found under names out of a table: `globalThis[holder].prototype[name] = f`.
// The program's own store arrives, whatever the library has done with the constructor before, and compiled code calls the replacement.
const replaced = function replaced() {
  return "replaced!";
};
const table = [
  ["Set", "union"],
  ["Set", "isSubsetOf"],
  ["Map", "getOrInsert"],
  ["String", "at"],
  ["String", "bold"],
  ["String", "trim"],
  ["Iterator", "chunks"],
  ["Function", "toString"],
  ["Uint8Array", "toHex"],
  ["Date", "toLocaleString"],
  ["Error", "toString"],
  ["WeakRef", "deref"],
];
for (const [holder, name] of table) {
  const object = globalThis[holder].prototype;
  try {
    object[name] = replaced;
    console.log(holder, name, object[name] === replaced ? "stored" : "ignored");
  } catch (error) {
    console.log(holder, name, "refused (" + error.constructor.name + ")");
  }
}
console.log(String(new Set([1]).union(new Set([2]))), new Set().isSubsetOf(new Set()), new Map().getOrInsert(1, 2));
console.log("abc".at(0), "b".bold(), " x ".trim(), [1].values().chunks(1), String(replaced), new Uint8Array(1).toHex());
console.log(new Date(0).toLocaleString(), String(new Error("e")), new WeakRef(replaced).deref());
//// replaced-trim-is-seen.js
// The five trim methods of strings are left out of the lock of String.prototype, because core-js 2 replaces them when it loads. A program that replaces one sees its own function at every call, on a literal, on a value of unknown type and through the alias. language/string-prototype-keeps-its-members has what stays fixed.
function trimmed(value) { return value.trim(); }
console.log("before: [" + [" a ".trim(), trimmed(" b "), " c".trimStart(), "d ".trimEnd(), " e".trimLeft(), "f ".trimRight()].join("|") + "]", "".trimLeft === "".trimStart, "".trimRight === "".trimEnd);

const whitespace = /^[\s᠎]+|[\s᠎]+$/g;
String.prototype.trim = function trim() { return String(this).replace(whitespace, ""); };
Object.defineProperty(String.prototype, "trimStart", { value() { return "start:" + this; }, writable: true, configurable: true });
String.prototype.trimRight = function () { return "right:" + this; };

console.log("after: [" + [" ᠎a᠎ ".trim(), trimmed("᠎b"), " c".trimStart(), "d ".trimEnd(), " e".trimLeft(), "f ".trimRight()].join("|") + "]", "".trimLeft === "".trimStart, "".trimRight === "".trimEnd);
console.log("by a computed name: " + ["trim", "trimStart", "trimEnd"].map(name => "[" + " x "[name]() + "]").join(" "));
console.log("what does not look at the methods: [" + [Number(" 1 "), parseInt(" 2 "), parseFloat(" 3.5 ")].join("|") + "]");
