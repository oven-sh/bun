function countEqual(left: unknown[], right: unknown[], rounds: number): string {
  let rows = "";
  for (let round = 0; round < rounds; round++) {
    rows = "";
    for (let i = 0; i < left.length; i++) {
      let row = "";
      for (let j = 0; j < right.length; j++) row += left[i] === right[j] ? "1" : "0";
      rows += row + "\n";
    }
  }
  return rows;
}

