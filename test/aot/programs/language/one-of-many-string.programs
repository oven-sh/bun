class Counter {
  count = 0
  bump = () => { this.count++ }
  all(list: number[]): number { list.forEach(item => { this.count += item }); return this.count }
  later(): () => () => number { return () => () => this.count }
}
const counter = new Counter()
counter.bump(); counter.bump()
console.log(counter.all([1, 2, 3]), counter.later()()())
