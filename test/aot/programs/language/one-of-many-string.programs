        console.log("% " + name + ": " + given.map(f).map(show).join(" "));
    console.log(sums([1, 2, 3, 100, 2147483647]) + " | " + sums(given) + " | " + sums([]) + " | " + [7, 1, 0, -3, 2.5].map(n => show(byVariable([1, 20, 300, 2147483647], n))).join(" "));
