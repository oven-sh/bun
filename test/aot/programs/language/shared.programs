////: describe
function describe(error) {
  if (error instanceof SuppressedError)
    return `SuppressedError(${error.message}; error: ${describe(error.error)}; suppressed: ${describe(error.suppressed)})`;
  if (error instanceof Error) return `${error.name}: ${error.message}`;
  return String(error);
}
////: handedThroughNativeCode
function handedThroughNativeCode(value) {
  let out;
  const target = new EventTarget();
  target.addEventListener("x", event => {
    out = event.detail;
  });
  target.dispatchEvent(new CustomEvent("x", { detail: value }));
  return out;
}
