//// values-a-handler-takes-in-another-form.ts
// What a catch or a finally clause reads was made in front of the throw, in the form that its maker gives it; the clause may want another.
declare const console: { log(...values: unknown[]): void };

function fail(when: boolean, what: unknown): void { if (when) throw what; }

function counts(limit: number, failAt: number): unknown[] {
    let i = 0, half = 0.5, text = "none", flag = false, big = 2 ** 33;
    let box: unknown = 1;
    try {
        for (; i < limit; i++) {
            half += i / 2;
            text = "at " + i;
            flag = i % 2 === 1;
            big += i;
            box = i % 3 === 0 ? i : i % 3 === 1 ? "s" + i : undefined;
            fail(i === failAt, i);
        }
    } catch (error) {
        return [error, i, half, text, flag, big, box];
    }
    return ["done", i, half, text, flag, big, box];
}

function nested(n: number): string {
    let total = 0, label: string | undefined = undefined;
    try {
        try {
            total = n * 2;
            fail(n > 1, "inner " + n);
            label = "passed";
        } finally {
            total += 0.25;
        }
        total += 1;
    } catch (error) {
        label = String(error) + " " + total;
    }
    return label + " " + total;
}

function optional(n: number): unknown[] {
    let maybe: number | undefined = undefined;
    let cell: { id: number } | null = null;
    try {
        if (n > 0) maybe = n;
        fail(n === 1, "one");
        cell = { id: n };
        fail(n === 2, "two");
        maybe = undefined;
        fail(n === 3, "three");
    } catch (error) {
        return [error, maybe, cell && cell.id];
    }
    return ["none", maybe, cell && cell.id];
}

for (const failAt of [-1, 0, 1, 2, 3]) console.log(JSON.stringify(counts(4, failAt)));
console.log(nested(0), "|", nested(1), "|", nested(2));
for (let n = 0; n < 5; n++) console.log(JSON.stringify(optional(n)));
//// variable-live-through-loops/impl.js
function server(first, client) {
  let turns = 0, writes = 0;
  const res = { write() { return ++writes % 3 !== 0; }, get writableLength() { return ++turns < 2 ? 0 : 7; }, once(name, f) { f(); } };
  return (async (req, res) => {
    try {
      let written = 0;
      do {
        while (res.write(first)) written += first.length;
        written += first.length;
        await new Promise(resolve => resolve());
      } while (res.writableLength === 0);

      let drained = false;
      res.once("drain", () => (drained = true));
      client.push(written);
      return [written, drained, client.length].join();
    } catch (e) {
      return "caught " + e;
    }
  })(null, res);
}
server("abc", []).then(console.log);
// The walk still ends in a circle of blocks that nothing leads into.
function loopBehindReturn(x) { let v = x; return v; while (true) { v = v + 1; } }
function loopsBehindThrow(x) { let v = x, w = 1; if (x) throw v + w; else return w; do { while (w < v) w++; v--; } while (v > w); return v + w; }
console.log(loopBehindReturn(4), (() => { try { return loopsBehindThrow(2); } catch (e) { return "thrown " + e; } })(), loopsBehindThrow(0));
//// variable-live-through-loops/main.ts
// A variable that is live through two nested loops and is read only after them.
import "./impl.js";
//// vm-timeout-in-endless-loop.js
// The timeout of a node:vm run stops an endless compiled loop that the run's text called: in a leaf function, in a function with a frame, and in a loop that ends for another argument. The same loop is not interrupted in the next run or outside a run.
const vm = require("vm");

function spinInLeaf() {
  for (;;) {}
}

function sum(depth) {
  return depth === 0 ? 0 : depth + sum(depth - 1);
}

function spinWithFrame(depth) {
  console.log("spinning after " + sum(depth));
  for (;;) {}
}

function countTo(limit) {
  let count = 0;
  while (count !== limit) count++;
  return count;
}

const context = vm.createContext({ spinInLeaf, spinWithFrame, countTo });
const limit = JSON.parse("20000000");

function run(text, timeout) {
  try {
    return vm.runInContext(text, context, { timeout });
  } catch (error) {
    return error.code;
  }
}

console.log("leaf: " + run("spinInLeaf()", 50));
console.log("outside a run: " + countTo(limit));
console.log("framed: " + run("spinWithFrame(4)", 50));
console.log("outside a run: " + countTo(limit));
console.log("no end: " + run("countTo(-1)", 50));
console.log("next run: " + run("countTo(" + limit + ")", 60000));
console.log("outside a run: " + countTo(limit));
console.log("no end again: " + run("countTo(-1)", 50));
console.log("next run: " + run("countTo(" + limit + ")", 60000));
//// what-a-function-returns-through-finally.ts
// A number, a boolean, a string, a literal and a reference returned through `finally`, on every path there is: the return, the end of the block, a throw, a break, a return in the `finally` block that takes the place of the first.
let log = "";
function note(text: string): void {
  log += text;
}
function number(i: number): number {
  try {
    if (i === 1) throw new Error("one");
    if (i === 2) return i * 1.5;
    note("n");
  } finally {
    note("f");
  }
  return -1;
}
////= lines-29	function flag(i: number): boolean	i > 1
function text(i: number): string {
  for (;;) {
    try {
      if (i === 1) throw new Error("one");
      if (i === 2) break;
      return "returned";
    } finally {
      note("f");
    }
  }
  return "broke";
}
////= lines-29	function literal(i: number): 3 | 4	i === 2 ? 3 : 4
////= lines-29	function reference(i: number): { i: number }	{ i }
function replaced(i: number): number {
  try {
    if (i === 1) throw new Error("one");
    return 1;
  } finally {
    if (i !== 2) return 2;
  }
}
////= lines-29	async function awaited(i: number): Promise<number>	await Promise.resolve(i * 2)
function attempt<T>(body: (i: number) => T, i: number): T | string {
  try {
    return body(i);
  } catch (error) {
    return "caught " + (error as Error).message;
  }
}
for (let i = 0; i < 4; i++) {
  console.log(i, attempt(number, i), attempt(flag, i), attempt(text, i), attempt(literal, i), JSON.stringify(attempt(reference, i)), attempt(replaced, i));
}
let sum = 0;
for (let i = 2; i < 1000; i++) sum += number(i) + (flag(i) ? 1 : 0) + literal(i) + text(i).length + reference(i).i + replaced(i);
console.log(sum, log.length);
for (let i = 0; i < 3; i++) console.log(await awaited(i).catch(error => "rejected " + error.message));
//// what-a-static-block-sees.js
// What the code of a static block sees: this, super, new.target, private names, the variables around it and its own.
const log = [];
const note = (...values) => log.push(values.map(String).join(" "));

class Base {
  static greeting = "base";
  static greet() {
    return "greet of " + this.name;
  }
}

let outer = 1;
class Sees extends Base {
  static #hidden = 5;
  static first = note("field 1", outer);
  static {
    note("this", this === Sees, this.name);
    note("super", super.greeting, super.greet());
    note("new.target", new.target);
    note("private", this.#hidden, #hidden in this, Sees.#hidden++);
    outer += 10;
    var ownVar = "var of block 1";
    let ownLet = "let of block 1";
    note(ownVar, ownLet);
  }
  static second = note("field 2", outer, Sees.#hidden);
  static {
    note("the var of the other block", typeof ownVar, typeof ownLet);
    const arrow = () => [this === Sees, super.greeting, new.target];
    note("an arrow", arrow());
    Sees.later = () => [this.name, ++outer, this.#hidden];
    function inner() {
      return [this, new.target];
    }
    note("a function", inner());
    note("a constructor", typeof new inner());
  }
  static third = note("field 3", outer);
}
note("later", Sees.later(), Sees.later());

function inAFunction(parameter) {
  let local = parameter * 2;
  const made = class {
    static {
      local += parameter;
      this.read = () => local;
      this.write = value => (local = value);
    }
  };
  return [made, () => local];
}
const [made, read] = inAFunction(3);
note("captured", made.read(), read());
made.write(40);
note("written", made.read(), read());

const order = [];
class Nested {
  static {
    order.push("outer begins");
    class Inner {
      static {
        order.push("inner", this.name, typeof Nested);
      }
    }
    order.push("outer ends", Inner.name);
  }
}
note(order);

outerLabel: for (const step of [1, 2, 3]) {
  class Loops {
    static {
      inner: for (const value of [1, 2, 3]) {
        if (value === 2) continue inner;
        if (value === 3) break inner;
        note("loop", step, value);
      }
    }
  }
  if (step === 2) break outerLabel;
}

let defined = "not defined";
try {
  class Stops {
    static before = note("before the throw");
    static {
      throw new RangeError("from a block");
    }
    static after = note("behind the throw");
  }
  defined = Stops.name;
} catch (error) {
  note("caught", error.name, error.message, defined);
}

try {
  class Early {
    static {
      note(Early.name, tooEarly);
    }
  }
} catch (error) {
  note("dead zone", error.name);
}
let tooEarly = 1;

class Evaluates {
  static {
    eval("var fromEval = 7; note('eval', this === Evaluates, fromEval)");
    note("behind eval", typeof fromEval);
  }
  static {
    note("in the next block", typeof fromEval);
  }
}

class Awaits {
  static async run() {
    return "ran";
  }
  static {
    this.promise = (async () => (await this.run()) + " in a block")();
    this.generator = (function* () {
      yield 1;
      yield 2;
    })();
  }
}
note("generator", [...Awaits.generator]);
Awaits.promise.then(value => {
  note("promise", value);
  console.log(log.join("\n"));
});
//// what-is-written-through-a-proxy-assign-json-validated.js
// What is written through a proxy arrives at its target, and compiled code that reads the target finds it.
const proxy = new Proxy(JSON, {});
Object.assign(proxy, { added: 7 });
console.log(typeof JSON.added, JSON.added === undefined, JSON.added + 1, String(JSON.added));
//// what-is-written-through-a-proxy-define-json-validated.js
// What is written through a proxy arrives at its target, and compiled code that reads the target finds it.
const proxy = new Proxy(JSON, {});
Object.defineProperty(proxy, "added", { value: 7, configurable: true });
console.log(typeof JSON.added, JSON.added === undefined, JSON.added + 1, String(JSON.added));
//// what-is-written-through-a-proxy-reflect-set-json-validated.js
// What is written through a proxy arrives at its target, and compiled code that reads the target finds it.
const proxy = new Proxy(JSON, {});
Reflect.set(proxy, "added", 7);
console.log(typeof JSON.added, JSON.added === undefined, JSON.added + 1, String(JSON.added));
//// what-is-written-through-a-proxy-store-array-element-validated.js
// What is written through a proxy arrives at its target, and compiled code that reads the target finds it.
const target = [1, 2];
const proxy = new Proxy(target, {});
proxy[0] = "text";
console.log(typeof target[0], target[0] === undefined, target[0] + 1, String(target[0]));
//// what-is-written-through-a-proxy-store-existing-field-validated.js
// What is written through a proxy arrives at its target, and compiled code that reads the target finds it.
const target = { a: 1 };
const proxy = new Proxy(target, {});
proxy.a = "text";
console.log(typeof target.a, target.a === undefined, target.a + 1, String(target.a));
//// what-is-written-through-a-proxy-store-field-of-instance-validated.js
// What is written through a proxy arrives at its target, and compiled code that reads the target finds it.
class C { constructor() { this.a = 1; } }
const target = new C();
const proxy = new Proxy(target, {});
proxy.a = "text";
console.log(typeof target.a, target.a === undefined, target.a + 1, String(target.a));
//// what-is-written-through-a-proxy-store-function-validated.js
