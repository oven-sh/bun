//// tags-in-the-comments-of-a-typescript-file-are-comments.ts
// In a TypeScript file the types are written in the code, so a tag in a comment says nothing to a build.

class Shape {
  sides(): number {
    return 0;
  }
}

class Circle {
  radius = 1;
}

/**
 * @augments Circle
 * @see Shape
 */
class Square extends Shape {
  sides(): number {
    return 4;
  }
}

/**
 * @param {string} first
 * @param missing
 * @returns {string}
 */
function count(first: number): number {
  return arguments.length + first;
}

/** @type {string} */
const total: number = count(1) + new Square().sides();

console.log(total, new Square() instanceof Shape, new Circle().radius);
//// template-object-non-ascii-raw.ts
// The raw strings of a tagged template contain non-ASCII characters as written in the source. Plain Bun rewrites these characters to escapes before it runs the file, so its raw strings contain the escapes.
export {};

const rawOf = (strings: TemplateStringsArray, ..._values: unknown[]): readonly string[] => strings.raw;

function codeUnitsOf(text: string): string {
  let result = "";
  for (let i = 0; i < text.length; i++) result += (i ? " " : "") + text.charCodeAt(i).toString(16);
  return result;
}

for (const raw of rawOf`é${1}日本語${2}😀${3}ÿĀ`) console.log(raw, codeUnitsOf(raw));
//// template-object-strings.ts
// The strings array of a tagged template: property attributes, frozen state, cooked and raw text, and one array per site.
export {};

const stringsOf = (strings: TemplateStringsArray, ..._values: unknown[]): TemplateStringsArray => strings;
const partsOf = (strings: TemplateStringsArray, ...values: number[]) => ({ strings, values });

function quote(value: unknown): string {
  return value === undefined ? "undefined" : JSON.stringify(value);
}

function codeUnitsOf(text: string): string {
  let result = "";
  for (let i = 0; i < text.length; i++) result += (i ? " " : "") + text.charCodeAt(i).toString(16);
  return result;
}

function attributesOf(object: object, key: PropertyKey): string {
  const descriptor = Object.getOwnPropertyDescriptor(object, key);
  if (!descriptor) return "absent";
  const value = Array.isArray(descriptor.value) ? "array" : quote(descriptor.value);
  return `${value} writable:${descriptor.writable} enumerable:${descriptor.enumerable} configurable:${descriptor.configurable}`;
}

function outcomeOf(action: () => void): string {
  try {
    action();
    return "no error";
  } catch (error) {
    return error instanceof TypeError ? "TypeError" : "another error";
  }
}

