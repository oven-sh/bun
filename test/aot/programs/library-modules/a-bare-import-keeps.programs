setImmediate(() => controller.abort());
console.log(await once(emitter, "never", { signal: controller.signal }).catch(error => error.name + " " + error.code));

setImmediate(() => { emitter.emit("tick", 1); emitter.emit("tick", 2); emitter.emit("tick", 3); });
