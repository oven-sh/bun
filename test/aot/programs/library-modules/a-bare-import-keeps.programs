  const own = createRequire(import.meta.url);
  report("own", () => own("node:dgram"));
}

const elsewhere = createRequire(process.cwd() + "/");
report("elsewhere in", () => elsewhere("node:path"));
report("elsewhere out", () => elsewhere("node:dgram"));
