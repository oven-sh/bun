console.log((await once(client, "message"))[0].toString());

client.connect(port, "127.0.0.1");
await once(client, "connect");
console.log(client.remoteAddress().port === port);
client.send("connected");
console.log((await once(client, "message"))[0].toString());
client.disconnect();
