//// a-built-in-module-is-asked-of-process-held-in-a-constant.ts
type Hooks = { AsyncLocalStorage?: unknown };
type Held = { process?: { getBuiltinModule?: (specifier: string) => Hooks } };

function ask(label: string, probe: () => unknown) {
  try {
    console.log(label, typeof probe());
  } catch (error) {
    console.log(label, (error as Error).name);
  }
}

const heldProcess = process;
const heldGlobal = globalThis;
const retypedGlobal = globalThis as unknown as Held;

ask("process", () => process.getBuiltinModule("node:async_hooks").AsyncLocalStorage);
ask("a constant that holds process", () => heldProcess.getBuiltinModule("node:dgram").createSocket);
ask("a constant that holds the global object", () => heldGlobal.process.getBuiltinModule("node:readline").createInterface);
ask("the global object under another type", () => retypedGlobal.process?.getBuiltinModule?.("node:diagnostics_channel"));

let found: unknown;
for (const probe of [() => retypedGlobal.process?.getBuiltinModule?.("node:vm")]) {
  try {
    found = probe();
  } catch {}
  if (found) break;
}
console.log("one of a list of probes", typeof found);
//// a-choice-between-two-constant-names.js
// `require(flag ? "node:vm" : "node:v8")`: what stands in the parentheses is no plain string, yet each arm is a constant name, and a bundler treats it as two calls. Both modules are in, whichever way the flag falls where the program runs. The output is that of plain Bun.
for (const flag of process.env.FLAGS.split(",").map(text => text === "1")) {
  const ways = {
    require: () => require(flag ? "node:vm" : "node:v8"),
    import: () => import(flag ? "node:dgram" : "node:zlib"),
    getBuiltinModule: () => process.getBuiltinModule(flag ? "node:assert" : "node:perf_hooks"),
    "import.meta.require": () => import.meta.require(flag ? "node:http2" : "node:https"),
    nested: () => require(flag ? "node:worker_threads" : flag === false ? "node:readline" : "node:repl"),
  };
  for (const way in ways) {
    try {
      console.log(flag, way, typeof (await ways[way]()));
    } catch (error) {
      console.log(flag, way, error.code);
    }
  }
}
