for (let i = 0; i < 3; i++) { say(make()); say(emitter()); }
const kept = stream.Readable;
stream.Readable = class Fake { fake = 1; };
say(make());
stream.Readable = stream.Writable;
say(make());
Object.defineProperty(stream, "Readable", { get() { console.log("getter"); return kept; }, configurable: true });
say(make());
delete stream.Readable;
try { say(make()); } catch (error) { console.log(error.constructor.name); }
stream.Readable = kept;
say(make());
const keptEmitter = events.EventEmitter;
events.EventEmitter = function Other() { this.fake = 2; };
say(emitter());
events.EventEmitter = keptEmitter;
say(emitter());
//// timers-and-their-promises.js
// node:timers and node:timers/promises: the order of timeouts, immediates, ticks and microtasks; clear, ref, unref, hasRef, refresh and Symbol.toPrimitive of a timer; promised timeouts with a value, with an abort, and an interval as an async iterator; scheduler.wait and yield.
import timers from "node:timers";
import { setTimeout as sleep, setImmediate as immediately, setInterval as every, scheduler } from "node:timers/promises";

const order = [];
await new Promise(resolve => {
  let left = 3;
  const ran = name => { order.push(name); if (--left === 0) resolve(); };
  setTimeout(() => ran("timeout 2"), 2);
  setTimeout(() => ran("timeout 0"), 0);
  setImmediate(() => ran("immediate"));
  process.nextTick(() => order.push("tick"));
  queueMicrotask(() => order.push("microtask"));
  Promise.resolve().then(() => order.push("promise"));
  order.push("sync");
});
console.log(order.filter(name => name !== "immediate" && name !== "timeout 0").join(), order.includes("immediate"), order.includes("timeout 0"));

const cleared = [];
clearTimeout(setTimeout(() => cleared.push("timeout"), 0));
clearImmediate(setImmediate(() => cleared.push("immediate")));
clearInterval(setInterval(() => cleared.push("interval"), 0));
timers.clearTimeout(timers.setTimeout(() => cleared.push("module"), 0));
await sleep(5);
console.log(cleared.length, timers.setTimeout === setTimeout);

const timer = setTimeout(() => {}, 10_000);
console.log(timer.hasRef(), timer.unref() === timer, timer.hasRef(), timer.ref().hasRef(), typeof timer[Symbol.toPrimitive](), timer.refresh() === timer);
clearTimeout(+timer);
let runs = 0;
await new Promise(resolve => { const interval = setInterval(() => { if (++runs === 3) { clearInterval(interval); resolve(); } }, 1); });
console.log(runs, await new Promise(resolve => setTimeout((a, b) => resolve(a + b), 0, "argu", "ments")));

console.log(await sleep(1, "value"), await immediately("at once"));
const controller = new AbortController();
const pending = sleep(10_000, null, { signal: controller.signal });
controller.abort();
console.log(await pending.catch(error => [error.name, error.code].join()));
console.log(await sleep(1, null, { signal: AbortSignal.abort() }).catch(error => error.code));
let beats = 0;
for await (const value of every(1, "beat")) if (++beats === 3) { console.log(value, beats); break; }
console.log(await scheduler.wait(1), await scheduler.yield());
//// web-streams-and-their-bridges.js
// node:stream/web and the global stream classes: a ReadableStream with a controller, a TransformStream, a WritableStream, tee, text encoder and decoder streams, compression, and the bridges to node:stream.
import { ReadableStream, TransformStream, WritableStream, TextDecoderStream, TextEncoderStream, CompressionStream, DecompressionStream } from "node:stream/web";
import { Readable, Writable } from "node:stream";

const numbers = () => new ReadableStream({ start(controller) { for (const n of [1, 2, 3]) controller.enqueue(n); controller.close(); } });
const doubled = numbers().pipeThrough(new TransformStream({ transform(n, controller) { controller.enqueue(n * 2); } }));
const seen = [];
await doubled.pipeTo(new WritableStream({ write(n) { seen.push(n); } }));
console.log(seen.join());

const [left, right] = numbers().tee();
const read = async stream => { const all = []; for await (const value of stream) all.push(value); return all.join(); };
console.log(await read(left), await read(right));

const words = new ReadableStream({ start(controller) { controller.enqueue("grüße"); controller.close(); } });
console.log(await read(words.pipeThrough(new TextEncoderStream()).pipeThrough(new TextDecoderStream())));

const packed = new Response("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa").body.pipeThrough(new CompressionStream("gzip"));
console.log(await new Response(packed.pipeThrough(new DecompressionStream("gzip"))).text());

console.log(await read(Readable.toWeb(Readable.from(["a", "b"]))));
const fromWeb = [];
for await (const value of Readable.fromWeb(numbers(), { objectMode: true })) fromWeb.push(value);
console.log(fromWeb.join());
const sink = [];
const writer = Writable.toWeb(new Writable({ write(chunk, encoding, done) { sink.push(chunk.toString()); done(); } })).getWriter();
await writer.write("through the bridge");
await writer.close();
console.log(sink.join());

const reader = numbers().getReader();
console.log(JSON.stringify(await reader.read()), numbers().locked, ReadableStream === globalThis.ReadableStream);
const failing = new ReadableStream({ pull() { throw new RangeError("pull failed"); } });
console.log(await failing.getReader().read().catch(error => error.name + " " + error.message));
//// what-a-typical-command-line-tool-uses.js
// A small tool as people write them: parse arguments, walk a folder, read and hash files, compress one, print a table, run a child, and clean up; ten library modules, each by a constant name, some required late inside functions.
const { parseArgs, inspect } = require("node:util");
const path = require("node:path");

function walk(folder) {
  const fs = require("node:fs");
  return fs.readdirSync(folder, { withFileTypes: true }).flatMap(entry => (entry.isDirectory() ? walk(path.join(folder, entry.name)) : [path.join(folder, entry.name)]));
}
function digest(file) {
  return require("node:crypto").createHash("sha1").update(require("node:fs").readFileSync(file)).digest("hex").slice(0, 8);
}
async function pack(file) {
  const { gzip } = require("node:zlib");
  return (await require("node:util").promisify(gzip)(await require("node:fs/promises").readFile(file))).length;
}

const { values } = parseArgs({ args: ["--depth", "2", "-v"], options: { depth: { type: "string" }, v: { type: "boolean", short: "v" } } });
const root = require("node:fs").mkdtempSync(path.join(require("node:os").tmpdir(), "library-modules-"));
require("node:fs").mkdirSync(path.join(root, "src/lib"), { recursive: true });
for (const [name, text] of [["a.txt", "alpha"], ["src/b.txt", "beta"], ["src/lib/c.txt", "gamma".repeat(100)]]) require("node:fs").writeFileSync(path.join(root, name), text);

const files = walk(root).sort();
console.table(files.map(file => ({ file: path.relative(root, file), sha1: digest(file), bytes: require("node:fs").statSync(file).size })));
console.log(inspect(values), (await pack(files.at(-1))) < 100);
console.log(require("node:child_process").execFileSync("ls", [root]).toString().trim().split("\n").join());
const emitter = new (require("node:events"))();
emitter.once("done", () => require("node:fs").rmSync(root, { recursive: true }));
emitter.emit("done");
console.log(require("node:fs").existsSync(root), new (require("node:url").URL)("file://" + root).protocol);
