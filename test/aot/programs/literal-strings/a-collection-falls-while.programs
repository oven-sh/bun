//// conversions-out.ts
// A value of a union of string literals goes everywhere a string goes.
type Color = "red" | "green" | "blue" | "";
interface Paint { color: Color; next?: Color; other: Color | null }

function paint(color: Color, other: Color | null): Paint {
    return { color, other };
}
function describe(p: Paint): string {
    return `${p.color}/${p.next}/${p.other}`;
}
function lengthOf(c: Color): number {
    return c.length;
}
function upper(c: Color): string {
    return c.toUpperCase();
}
function first(c: Color): string | undefined {
    return c[0];
}
function isSet(c: Color): boolean {
    return c ? true : false;
}
function orDefault(c: Color | undefined): Color {
    return c || "green";
}
function orFallback(c: Color | undefined | null): Color {
    return c ?? "blue";
}
function kindOf(c: Color | undefined): string {
    return typeof c;
}
function before(a: Color, b: Color): boolean {
    return a < b;
}
function plus(a: Color, b: Color): string {
    return a + b;
}
function anything(c: Color): unknown {
    return c;
}
function loosely(c: Color | null | undefined): boolean {
    return c == null;
}
function looselyEqual(a: Color, b: string): boolean {
    return a == b;
}
const table: Record<Color, number> = { red: 1, green: 2, blue: 3, "": 0 };
function lookUp(c: Color): number {
    return table[c];
}
function has(c: Color): boolean {
    return c in table;
}

const all: Color[] = ["red", "green", "blue", ""];
const paints = all.map((c, i) => paint(c, i % 2 ? null : all[(i + 1) % 4]));
paints[1].next = "red";
paints[2].next = paints[0].color;
for (const p of paints) {
    console.log(describe(p), lengthOf(p.color), upper(p.color), first(p.color), isSet(p.color), orDefault(p.next), orFallback(p.other), kindOf(p.next), lookUp(p.color), has(p.color));
    console.log(JSON.stringify(p), Object.keys(p).join(), Object.values(p).join("|"), Object.entries(p).length, String(p.color), [p.color, p.other].join("+"));
    console.log(anything(p.color), loosely(p.other), loosely(p.next), looselyEqual(p.color, "red"), looselyEqual(p.color, ""));
}
console.log(before("blue", "green"), before("red", "blue"), before("", "red"), plus("red", "blue"), plus("", ""));
console.log([...all].sort().join(), [...all].sort((a, b) => b.localeCompare(a)).join(), all.includes("blue"), all.indexOf("green"));
const seen = new Set<Color>(all);
const count = new Map<Color, number>();
for (const p of paints) count.set(p.color, (count.get(p.color) ?? 0) + 1);
console.log(seen.has("red"), seen.size, [...count.keys()].join(), count.get(""));
const copy = { ...paints[1] };
const assigned = Object.assign({}, paints[2]);
const cloned = structuredClone(paints[1]);
console.log(copy.color, copy.next, assigned.next, cloned.color, cloned.next, cloned.other);
delete paints[1].next;
console.log(paints[1].next, "next" in paints[1], describe(paints[1]));
console.log(JSON.stringify(paints));
//// fields-parameters-and-switches.ts
type Kind = "leaf" | "node" | "root";
interface Item { kind: Kind; weight: number; label?: Kind }
function make(kind: Kind, weight: number): Item {
    return { kind, weight };
}
function score(item: Item): number {
    if (item.kind === "leaf") return 1;
    if (item.kind !== "node") return 2;
    return item.weight;
}
function name(kind: Kind): string {
    switch (kind) {
        case "leaf": return "a leaf";
        case "node": return "a node";
        default: return "the " + kind;
    }
}
function same(a: Kind, b: Kind): boolean { return a === b; }
function relabel(item: Item, to: Item): void { item.label = to.kind; item.kind = "root"; }
const items: Item[] = [make("leaf", 1), make("node", 5), make("root", 9)];
let total = 0;
for (const item of items) total += score(item);
relabel(items[0], items[1]);
console.log(total, name("leaf"), name("root"), same(items[0].kind, items[1].kind), items[2].kind, JSON.stringify(items[0]), items[0].label ? "yes" : "no", items[1].label ?? "none");
//// large-record-optional-fields.ts
// A record with many optional fields, few of which are ever set: those of a union of string literals among them, which may be kept apart from the object. Another string passes a cast to the union, and typed code reads what untyped code stored into such a field as it is: a literal type promises the kind, string.
type Scope = "params" | "typeParams" | "";
type Side = "left" | "right";
interface Links {
    id: number;
    n0?: number;
    s0?: string;
    n1?: number;
    s1?: string;
    n2?: number;
    s2?: string;
    n3?: number;
    s3?: string;
    n4?: number;
    s4?: string;
    n5?: number;
    s5?: string;
    n6?: number;
    s6?: string;
    n7?: number;
    s7?: string;
    n8?: number;
    s8?: string;
    n9?: number;
    s9?: string;
    n10?: number;
    s10?: string;
    n11?: number;
    s11?: string;
    n12?: number;
    s12?: string;
    n13?: number;
    s13?: string;
    n14?: number;
    s14?: string;
    n15?: number;
    s15?: string;
    n16?: number;
    s16?: string;
    n17?: number;
    s17?: string;
    n18?: number;
    s18?: string;
    n19?: number;
    s19?: string;
    n20?: number;
    s20?: string;
    n21?: number;
    s21?: string;
    n22?: number;
    s22?: string;
    n23?: number;
    s23?: string;
    scope?: Scope;
    side?: Side | null;
    last?: Scope;
}
function links(id: number): Links {
    return { id };
}
function describe(l: Links): string {
    try {
        const scope = l.scope === "params" ? "P" : l.scope === "typeParams" ? "T" : l.scope === "" ? "E" : l.scope === undefined ? "-" : "?" + l.scope;
        const side = l.side === "left" ? "L" : l.side === "right" ? "R" : l.side === null ? "N" : l.side === undefined ? "-" : "?";
        return scope + side + (l.last ?? "none") + ("scope" in l ? "+" : "") + (l.n3 ?? "") + (l.s7 ?? "");
    } catch (e) {
        return (e as Error).constructor.name;
    }
}
function anyRead(o: any): string { return String(o.scope) + "/" + String(o.side) + "/" + String(o.last); }
function anyWrite(o: any, scope: unknown, side: unknown) { o.scope = scope; o.side = side; }
const all: Links[] = [];
let refused = 0;
for (let i = 0; i < 3000; i++) {
    const l = links(i);
    if (i % 3 === 0) l.scope = i % 2 ? "params" : "typeParams";
    if (i % 5 === 0) l.side = i % 2 ? "left" : i % 4 ? "right" : null;
    if (i % 7 === 0) try { l.last = ("made " + i) as Scope; } catch (e) { refused++; }
    if (i % 11 === 0) l.scope = "";
    if (i % 13 === 0) { l.n3 = i; l.s7 = "s" + i; }
    all.push(l);
}
console.log("casts refused:", refused);
let garbage = 0;
for (let i = 0; i < 200000; i++) garbage += ("g" + i).length;
const seen = new Map<string, number>();
for (const l of all) { const d = describe(l).replace(/[0-9]+/g, "#"); seen.set(d, (seen.get(d) ?? 0) + 1); }
console.log([...seen].sort().map(e => e.join("=")).join(" "), garbage);
console.log(describe(all[0]), describe(all[21]), describe(all[35]), describe(all[1001]), anyRead(all[0]), anyRead(all[1]), anyRead(all[7]), JSON.stringify(all[105]), Object.keys(all[2310]).join());
for (let i = 0; i < all.length; i += 4) anyWrite(all[i], i % 8 ? "params" : "unknown " + i, i % 12 ? "right" : undefined);
console.log(describe(all[4]), describe(all[8]), describe(all[12]), describe(all[24]), anyRead(all[16]), JSON.stringify(all[20]));
delete all[4].scope;
all[8].scope = undefined;
console.log(describe(all[4]), describe(all[8]), "scope" in all[4], "scope" in all[8], JSON.stringify({ ...all[12] }));
//// locals-concat-and-compare.ts
// Local values of a union of string literals that come together from several paths: only printed, only tested, both, made from strings, in loops and around handlers. A string that is made at run time passes a cast to the union whether or not it is one of its members.
type Mode = "read" | "write" | "append" | "";
interface File { mode: Mode; name: string }
const log: string[] = [];
function onlyPrinted(a: boolean, b: boolean): string {
    const mode: Mode = a ? "read" : b ? "write" : "append";
    return "mode " + mode + "/" + mode.length;
}
function usedAsKey(writing: boolean, counts: Record<string, number>): number {
    const key = writing ? "write" : "read";
    counts[key] = (counts[key] ?? 0) + 1;
    return counts[key];
}
function onlyTested(a: boolean, b: boolean): number {
    const mode: Mode = a ? "read" : b ? "write" : "";
    if (mode === "read") return 1;
    if (!mode) return 2;
    return mode === "write" ? 3 : 4;
}
function testedAndPrinted(n: number): string {
    const mode: Mode = n === 0 ? "read" : n === 1 ? "write" : n === 2 ? "append" : "";
    const tag = mode === "append" || mode === "write" ? "w" : mode === "" ? "-" : "r";
    return tag + mode;
}
function fromString(text: string): number {
    const mode = text as Mode;
    return mode === "read" ? 1 : mode === "write" ? 2 : mode === "" ? 3 : 0;
}
function fromStringOrConstant(text: string | undefined): string {
    const mode: Mode = text === undefined ? "append" : (text as Mode);
    return (mode === "append" ? "A" : mode === "read" ? "R" : "?") + mode;
}
function intoField(text: string, constant: boolean): File {
    const mode: Mode = constant ? "write" : (text as Mode);
    return { mode, name: "f" + mode };
}
function inLoop(steps: number): string {
    let mode: Mode = "read", trace = "";
    for (let i = 0; i < steps; i++) {
        trace += mode[0] ?? "_";
        mode = mode === "read" ? "write" : mode === "write" ? "append" : mode === "append" ? "" : "read";
    }
    return trace + ":" + mode;
}
function aroundHandlers(n: number): string {
    let mode: Mode = "read";
    try {
        if (n === 1) throw new Error("one");
        mode = "write";
        if (n === 2) throw new Error("two");
        mode = "append";
    } catch (error) {
        log.push((error as Error).message + " at " + mode);
        if (n === 2) mode = "";
    } finally {
        log.push("finally " + mode);
    }
    return mode;
}
function twoJoined(a: boolean, b: boolean): boolean {
    const x: Mode = a ? "read" : "write", y: Mode = b ? "read" : "append";
    return x === y;
}
function nullable(n: number): string {
    const mode: Mode | undefined | null = n === 0 ? undefined : n === 1 ? null : n === 2 ? "" : "read";
    return String(mode) + (mode == null ? " nil" : mode ? " set" : " empty") + (mode ?? "default");
}
function bySwitch(n: number): string {
    let mode: Mode;
    switch (n) {
        case 0: mode = "read"; break;
        case 1: mode = "write";
        case 2: mode = "append"; break;
        default: mode = "";
    }
    return `[${mode}]`;
}
function attempt(run: () => string | number): string | number {
    try { return run(); } catch (error) { return (error as Error).constructor.name; }
}
const counts: Record<string, number> = {};
const out: (string | number | boolean)[] = [];
for (const a of [true, false]) for (const b of [true, false]) out.push(onlyPrinted(a, b), usedAsKey(a, counts), onlyTested(a, b), twoJoined(a, b));
for (let n = 0; n < 4; n++) out.push(testedAndPrinted(n), aroundHandlers(n), nullable(n), bySwitch(n), inLoop(n * 3));
for (const text of ["read", "wri" + "te", "", "other", "append".slice(0, 6), "xread".slice(1)]) out.push(attempt(() => fromString(text)), attempt(() => fromStringOrConstant(text)), attempt(() => JSON.stringify(intoField(text, false))), intoField(text, true).mode);
out.push(fromStringOrConstant(undefined), JSON.stringify(counts));
console.log(out.join(" | "));
console.log(log.join(" | "));
//// members-that-only-the-type-spells-are-put-together-at-run-time.ts
// Members of a union of texts that only the type spells are put together at run time or parsed, and so are texts that are no member. They are printed, measured, compared, switched on, stored in fields, variables, arrays and maps, captured, and used as keys.
type Color = "red" | "green" | "blue" | "ultraviolet" | "";
type Box = { color: Color; next?: Color };
function make(parts: string[]): Color { return parts.join("") as Color; }
function fromJson(t: string): Box { return JSON.parse(t) as Box; }
function show(c: Color): string { return "<" + c + ":" + c.length + ":" + c.toUpperCase() + ">"; }
function pick(c: Color): number { switch (c) { case "red": return 1; case "green": return 2; default: return 9; } }
class Holder { c: Color = "red"; set(c: Color) { this.c = c; return this; } get() { return this.c; } }
let kept: Color = "red";
function keep(c: Color) { kept = c; } function give(): Color { return kept; }
const uv = make(["ultra", "vio", "let"]), bl = make(["bl", "ue"]), em = make([]), odd = make(["inf", "rared"]);
for (const c of [uv, bl, em, odd, "green" as Color]) {
  const h = new Holder().set(c); keep(c);
  console.log(show(c), pick(c), show(h.get()), show(give()), h.get() === c, give() === c, c === "red", [c].includes(give()), JSON.stringify({ c, h }), typeof give(), Object.keys({ [give()]: 1 }).join());
}
const b = fromJson('{"color":"ultraviolet","next":"blue"}'); console.log(show(b.color), show(b.next!), b.color === uv, b.next === bl, pick(b.color), b.color + b.next, `${b.color}`, b.color.charAt(2), b.color > b.next!, [b.color, b.next].sort().join());
const m = new Map<Color, number>(); m.set(uv, 1); m.set(b.color, 2); m.set(bl, 3); console.log(m.size, m.get("ultra" + "violet" as Color), m.get(b.next!), [...m.keys()].join());
const rec: Record<Color, number> = { red: 1, green: 2, blue: 3, ultraviolet: 4, "": 5 }; console.log(rec[uv], rec[bl], rec[em], rec[odd], rec[b.color]);
function eq(a: Color, b2: Color) { return a === b2; } console.log(eq(uv, b.color), eq(bl, b.next!), eq(uv, bl), eq(em, ""), eq(odd, odd), eq(odd, make(["infra", "red"])));
const arr: Color[] = []; for (let i = 0; i < 6; i++) arr.push(make([["ultra", "bl", "re", "gre", "", "x"][i], ["violet", "ue", "d", "en", "", "y"][i]])); console.log(arr.join("|"), arr.indexOf(uv), arr.indexOf("blue"), arr.map(pick).join(), arr.map(show).join(""));
type Kind = "alpha" | "beta" | "gamma"; interface Node_ { kind: Kind; v: number }
const nodes: Node_[] = JSON.parse('[{"kind":"gamma","v":1},{"kind":"beta","v":2},{"kind":"delta","v":3}]'); let s = ""; for (const n of nodes) s += n.kind + (n.kind === "alpha" ? "A" : "-") + n.kind.length; console.log(s);
function later(k: Kind) { return () => k; } console.log(nodes.map(n => later(n.kind)()).join());
//// more-literals-than-the-limit.ts
// The .json lowers the limit of string literal types to two, so nearly every literal here has no word of its own: it is an ordinary string, and a test for it compares texts.
// Whatever the limit, the program answers as without one: tests, switches, comparisons, fields, keys of a Map, texts that come from outside.
type Direction = "north" | "south" | "east" | "west";
type Size = "s" | "m" | "l" | "extra-large-beyond-any-register";
type Wide = "Ж" | "日本語" | "north";
type Shape = { kind: "circle"; radius: number } | { kind: "square"; side: number } | { kind: "triangle-with-a-long-name"; base: number; height: number };

const lines: string[] = [];
const hide = <T,>(value: T): T => new CustomEvent("x", { detail: value }).detail;

function isDirection(value: unknown): value is Direction { return value === "north" || value === "south" || value === "east" || value === "west"; }
function isSize(value: unknown): value is Size { return value === "s" || value === "m" || value === "l" || value === "extra-large-beyond-any-register"; }
function isWide(value: unknown): value is Wide { return value === "Ж" || value === "日本語" || value === "north"; }
function opposite(direction: Direction): Direction {
  switch (direction) {
    case "north": return "south";
    case "south": return "north";
    case "east": return "west";
    case "west": return "east";
  }
}
function area(shape: Shape): number {
  if (shape.kind === "circle") return Math.round(shape.radius * shape.radius * 3);
  if (shape.kind === "square") return shape.side * shape.side;
  return (shape.base * shape.height) / 2;
}
function rank(size: Size): number { return size === "s" ? 1 : size === "m" ? 2 : size === "l" ? 3 : 4; }

const made: unknown[] = hide([
  "north", "south", "east", "west", "nor" + String("th"), "xsouthx".slice(1, 6), ["e", "a", "s", "t"].join(""), "WEST".toLowerCase(), "North", "nort", "northh", "",
  "s", "m", "l", "extra-large-" + "beyond-any-register", "extra-large-beyond-any-registeR", "Ж", "日本" + "語", "日本", "ж", 1, null, undefined, true, {}, ["north"], Symbol("north"),
]);
for (const value of made) lines.push(`${typeof value === "symbol" ? "a symbol" : JSON.stringify(value)}: ${isDirection(value)} ${isSize(value)} ${isWide(value)}`);
for (const value of made) if (isDirection(value)) lines.push(value + " > " + opposite(value) + " > " + opposite(opposite(value)));
for (const value of made) if (isSize(value)) lines.push(value + " " + rank(value));

const shapes: Shape[] = hide<Shape[]>(JSON.parse('[{"kind":"circle","radius":2},{"kind":"square","side":3},{"kind":"triangle-with-a-long-name","base":4,"height":5}]'));
shapes.push({ kind: "square", side: 7 }, { kind: "circle", radius: 1 });
for (const shape of shapes) lines.push(shape.kind + " " + area(shape));

const count = new Map<Direction, number>();
const turns = Number(process.argv[2] ?? 2000);
const all: Direction[] = ["north", "east", "south", "west"];
let at: Direction = "north";
for (let i = 0; i < turns; i++) {
  at = i % 3 === 0 ? opposite(at) : all[(i * 7) % 4]!;
  count.set(at, (count.get(at) ?? 0) + 1);
}
lines.push([...count].map(([direction, times]) => direction + "=" + times).sort().join(" "));

// Literals that stand in types alone: no code names their texts, and still a value is tested for them where it comes in from code that knows nothing.
type Encoding = "utf-eight" | "latin-one" | "hexadecimal-digits-only";
type Level = "low" | "middling" | "high" | 7;
function lengthOf(encoding: Encoding): number { return encoding.length; }
function levelOf(level: Level): string { return typeof level + ":" + String(level).length; }
function record(entry: { encoding: Encoding; level?: Level }): string { return entry.encoding.toUpperCase() + "/" + entry.level; }
const unknownLengthOf: (value: any) => number = hide(lengthOf);
const unknownLevelOf: (value: any) => string = hide(levelOf);
const unknownRecord: (value: any) => string = hide(record);
const join = (...parts: string[]) => hide(parts).join("-");
for (const text of [join("utf", "eight"), join("latin", "one"), join("hexadecimal", "digits", "only"), join("utf", "nine"), join("low"), join("middling"), join("high"), join("")]) {
  for (const [name, call] of [["length", unknownLengthOf], ["level", unknownLevelOf]] as const) {
    try { lines.push(name + " " + text + ": " + call(text)); } catch (error) { lines.push(name + " " + text + ": " + (error as Error).constructor.name); }
  }
  try { lines.push("record " + unknownRecord({ encoding: text, level: text })); } catch (error) { lines.push("record " + text + ": " + (error as Error).constructor.name); }
}
lines.push(unknownLevelOf(7), unknownLevelOf(hide(3) + 4));

// The names of an object's members as a type: the read by such a key tests for each name.
const prices = { smallest: 1, "in-between": 2, largest: 3 } as const;
type Name = keyof typeof prices;
function priceOf(name: Name): number { return prices[name]; }
const names: Name[] = hide<Name[]>([join("smallest") as Name, join("in", "between") as Name, join("largest") as Name, "largest", "smallest"]);
for (const name of names) lines.push(name + " costs " + priceOf(name));
lines.push(String(priceOf(join("no", "such", "name") as Name)));

// A record by literal keys: the read and the store by such a key test for each of them. The text of one character is in no table of the program unless somebody asks for it.
function countOf(record: Partial<Record<Size, number>>, size: Size): number { return (record[size] ?? 0) + 1; }
const tally: Partial<Record<Size, number>> = {};
for (const size of ["s", "m", "s", "l", "s", "extra-large-beyond-any-register", "m"] as Size[]) tally[size] = countOf(tally, size);
for (const size of hide<Size[]>([join("s") as Size, join("l") as Size, join("extra", "large", "beyond", "any", "register") as Size])) tally[size] = countOf(tally, size);
lines.push(JSON.stringify(tally));
function narrowed(value: Size | number | undefined): string {
  if (typeof value === "string") return value === "l" ? "large" : "text " + value;
  return String(value);
}
lines.push(narrowed("l"), narrowed("s"), narrowed(4), narrowed(undefined), narrowed(hide<Size>(join("m") as Size)));

// Literals that nobody wrote: the members of a template literal type.
type Heading = `to-the-${Direction}`;
function headingOf(direction: Direction): Heading { return `to-the-${direction}`; }
function isEastward(heading: Heading): boolean { return heading === "to-the-east"; }
function loosely(value: Direction | (string & {})): boolean { return value === "west"; }
for (const direction of all) lines.push(headingOf(direction) + " " + isEastward(headingOf(direction)) + " " + loosely(direction) + " " + loosely(headingOf(direction)));
for (const direction of hide<Direction[]>([join("east") as Direction, join("up") as Direction])) lines.push(headingOf(direction) + " " + isEastward(headingOf(direction)));

class Sign { constructor(public direction: Direction, public size: Size) {} }
const signs = all.map((direction, i) => new Sign(direction, (["s", "m", "l", "extra-large-beyond-any-register"] as const)[i]!));
for (const sign of hide(signs)) lines.push(sign.direction + "/" + sign.size + " " + (sign.direction === "east") + " " + (sign.size === "extra-large-beyond-any-register") + " " + Object.values(sign).join());
console.log(lines.join("\n"));
//// related-types.ts
// Types around unions of string literals: what is widened, what is a key, what is generic. A string that is no member of the union passes a cast to it. Handed on to a parameter that is written `never`, it throws a TypeError there.
type Size = "s" | "m" | "l";
type Loose = Size | (string & {});
type Prefixed = `size-${Size}`;
type Both = Size | 1 | 2;
type Flag = "yes" | "no" | boolean;
const sizes = { small: "s", medium: "m", large: "l" } as const;
type FromObject = (typeof sizes)[keyof typeof sizes];
type Keys = keyof typeof sizes;

function widened(): string {
    let s = "s";
    s += "m";
    return s;
}
function identity<T extends string>(value: T): T {
    return value;
}
function firstOf<T>(values: T[]): T {
    return values[0];
}
function loose(value: Loose): boolean {
    return value === "m";
}
function prefixed(size: Size): Prefixed {
    return `size-${size}`;
}
function isLargePrefixed(p: Prefixed): boolean {
    return p === "size-l";
}
function both(value: Both): string {
    return value === "s" ? "small" : value === 1 ? "one" : typeof value;
}
function flag(value: Flag): string {
    return value === "yes" || value === true ? "on" : value === "no" ? "off" : "false";
}
function fromObject(value: FromObject): number {
    return value === sizes.small ? 0 : value === sizes.medium ? 1 : 2;
}
function byKey(key: Keys): Size {
    return sizes[key];
}
function count(record: Partial<Record<Size, number>>, size: Size): number {
    return (record[size] ?? 0) + 1;
}
function overlap(a: "s" | "m", b: "m" | "l"): boolean {
    return a === b;
}
function narrow(value: Size | number | undefined): string {
    if (typeof value === "string")
        return value === "l" ? "large" : "text " + value;
    return String(value);
}
function assertNever(value: never): never {
    throw new Error("unexpected " + value);
}
function attempt(run: () => unknown): unknown {
    try { return run(); } catch (error) { return (error as Error).constructor.name; }
}
function exhaustive(size: Size): number {
    switch (size) {
        case "s": return 1;
        case "m": return 2;
        case "l": return 3;
        default: return assertNever(size);
    }
}

console.log(widened(), identity<Size>("m"), identity("free"), firstOf<Size>(["l", "s"]), loose("m"), loose("anything"), prefixed("l"), isLargePrefixed(prefixed("l")), isLargePrefixed(prefixed("s")));
console.log(both("s"), both("m"), both(1), both(2), flag("yes"), flag(true), flag("no"), flag(false));
console.log(fromObject("s"), fromObject(sizes.medium), fromObject("l"), byKey("small"), byKey("large"), Object.keys(sizes).map(k => byKey(k as Keys)).join());
const tally: Partial<Record<Size, number>> = {};
for (const size of ["s", "m", "s", "l", "s"] as Size[]) tally[size] = count(tally, size);
console.log(JSON.stringify(tally), overlap("m", "m"), overlap("s", "m"), narrow("l"), narrow("s"), narrow(4), narrow(undefined));
console.log(exhaustive("s") + exhaustive("m") + exhaustive("l"));
try {
    exhaustive("xl" as Size);
} catch (error) {
    console.log((error as Error).constructor.name);
}
for (const key in sizes) console.log(key, sizes[key as Keys]);
const order: Size[] = ["m", "l", "s"];
order.sort((a, b) => exhaustive(a) - exhaustive(b));
console.log(order.join(""), order.map(identity).join(""), order.filter(s => s !== "m").length, order.find(s => s === "l"), attempt(() => order.some(s => s === ("x" as Size))));
//// storage-kinds.ts
// Every kind of place that holds a value of a union of string literals.
type State = "idle" | "running" | "done";
enum Level { Low = "low", High = "high" }

let current: State = "idle";
let maybe: State | undefined;
const fixed = "done";

class Task {
    static shared: State = "idle";
    state: State = "idle";
    last: State | null = null;
    level: Level = Level.Low;
    #hidden: State = "running";
    constructor(public readonly first: State) {}
    advance(): State {
        this.last = this.state;
        this.state = this.state === "idle" ? "running" : "done";
        return this.state;
    }
    get hidden(): State { return this.#hidden; }
    set hidden(to: State) { this.#hidden = to; }
}
function counter(start: State): () => State {
    let held = start;
    return () => {
        const was = held;
        held = held === "idle" ? "running" : held === "running" ? "done" : "idle";
        return was;
    };
}
function* states(): Generator<State, State, State | undefined> {
    const back = yield "idle";
    yield back ?? "running";
    return "done";
}
async function later(s: State): Promise<State> {
    const now = s;
    await null;
    return now === "idle" ? "running" : now;
}
function pair(a: State, b: State = "done"): [State, State] {
    return [b, a];
}
function pick({ state, last }: Task, ...rest: State[]): string {
    return state + ":" + last + ":" + rest.length + ":" + rest.join("");
}
function level(l: Level): number {
    switch (l) {
        case Level.Low: return 1;
        case Level.High: return 2;
    }
}

const task = new Task("running");
console.log(task.state, task.last, task.first, task.hidden, task.level, level(task.level), Task.shared);
console.log(task.advance(), task.advance(), task.advance(), task.last);
task.hidden = "done";
task.level = Level.High;
Task.shared = task.state;
console.log(task.hidden, level(task.level), task.level === Level.High, Task.shared, JSON.stringify(task));
const next = counter("idle");
console.log(next(), next(), next(), next());
const g = states();
console.log(g.next().value, g.next("done").value, g.next().value, g.next().value);
console.log(pair("idle").join(), pair("idle", "running").join(), pick(task), pick(task, "idle", "done"));
console.log(current, maybe, fixed, maybe === undefined, current === "idle", fixed === "done");
current = task.state;
maybe = current;
console.log(current, maybe, maybe === current, maybe !== undefined);
maybe = undefined;
console.log(maybe ?? "nothing", maybe === "idle");
later("idle").then(async s => {
    console.log(s, await later(s), await later("done"));
    const all = await Promise.all([later("idle"), later("running")]);
    console.log(all.join());
});
//// store-run-single-string-field.ts
// Adjacent stores to old objects where one field alone can hold a cell: a union of string literals next to a number and a boolean. The string is a literal of the program, or one that is stored through `any` and that only the field keeps alive while the collector runs.
type Tag = "open" | "closed" | "";
class Entry {
    constructor(public tag: Tag, public count: number, public isActive: boolean) {}
}
function fresh(i: number): string {
    return "tag number " + i + " of " + (i * 7919) % 1000;
}
function churn(n: number): number {
    let total = 0;
    for (let i = 0; i < n; i++) total += [i, i + 1, i + 2].map(x => "garbage " + x).join().length;
    return total;
}
function setUnknown(entry: Entry, i: number): void {
    const tag = fresh(i);
    (entry as any).tag = tag;
    entry.count = i;
    entry.isActive = (i & 1) === 0;
}
function setLiteral(entry: Entry, i: number): void {
    entry.tag = "closed";
    entry.count = i;
    entry.isActive = false;
}
function setEither(entry: Entry, tag: string, i: number): void {
    entry.count = i;
    (entry as any).tag = tag;
}

const entries: Entry[] = [];
const lastKind: number[] = [];
const lastIndex: number[] = [];
for (let i = 0; i < 2000; i++) {
    entries.push(new Entry("open", i, true));
    lastKind.push(-1);
    lastIndex.push(i);
}
let waste = churn(60000);
for (let round = 0; round < 24; round++) {
    for (let k = round % 8; k < entries.length; k += 8) {
        const i = k + round * 10000;
        const kind = (k + round) % 4;
        if (kind === 0) setUnknown(entries[k], i);
        else if (kind === 1) setLiteral(entries[k], i);
        else setEither(entries[k], kind === 2 ? fresh(i) : "open", i);
        lastKind[k] = kind;
        lastIndex[k] = i;
    }
    waste += churn(20000);
}

let wrong = 0, unknown = 0, length = 0;
for (let k = 0; k < entries.length; k++) {
    const entry = entries[k], kind = lastKind[k], i = lastIndex[k];
    const tag = kind === 0 || kind === 2 ? fresh(i) : kind === 1 ? "closed" : "open";
    const held: string = (entry as any).tag;
    if (held !== tag || entry.count !== i) wrong++;
    if (kind === 0 && entry.isActive !== ((i & 1) === 0)) wrong++;
    if (kind === 1 && entry.isActive) wrong++;
    if (kind === 0 || kind === 2) unknown++;
    length += held.length;
}
console.log(wrong, unknown, length, waste > 0);
//// texts-from-elsewhere-are-compared-with-the-listed-ones.ts
type Level = "low" | "mid" | "high";
interface Row {
  level: Level;
  n: number;
}

function worth(level: Level): number {
  switch (level) {
    case "low":
      return 10;
    case "mid":
      return 20;
    case "high":
      return 30;
  }
}

function name(level: Level): string {
  return level === "low" ? "L" : level === "mid" ? "M" : level === "high" ? "H" : "none of them: " + level;
}

function keep(row: Row, level: Level): Level {
  row.level = level;
  return row.level;
}

type Mode = "off" | "read" | "write";
let kept: "read" | "write" = "read";
let last: Level = "low";

function keepMode(mode: Mode): string {
  if (mode !== "off") kept = mode;
  switch (kept) {
    case "read":
      return "R";
    case "write":
      return "W";
  }
}

function keepLast(value: any): number {
  last = value;
  return worth(last);
}

class Holder {
  level: Level = "mid";
  take(value: unknown): string {
    this.level = value as Level;
    return name(this.level);
  }
}
const holder = new Holder();

const texts: string[] = [
  "low",
  "mid",
  "high",
  "other",
  "",
  "lo" + "w".repeat(1),
  "xhigh".slice(1),
  "MID".toLowerCase(),
];
const cast = texts.map(text => text as Level);
const parsed: Row[] = JSON.parse(
  '[{"level":"low","n":1},{"level":"mid","n":2},{"level":"none","n":3},{"level":"high","n":4}]',
);
const byNumber = new Map<number, Level>(cast.map((level, index) => [index, level]));
const loose: any[] = ["high", 7, null, undefined, { toString: () => "low" }, "mid"];
const row: Row = { level: "low", n: 0 };
const counts: Record<Level, number> = { low: 0, mid: 0, high: 0 };

for (let round = 0; round < 3; round++) {
  const lines: string[] = [];
  for (const level of cast) lines.push(`${name(level)} ${worth(level)} ${keep(row, level)} ${typeof row.level}`);
  for (const each of parsed) lines.push(`${name(each.level)} ${worth(each.level)} ${each.level === row.level}`);
  for (let index = 0; index < 9; index++) {
    const level = byNumber.get(index);
    lines.push(level === undefined ? "absent" : `${name(level)} ${worth(level)}`);
  }
  for (const value of loose) {
    const level = value as Level;
    lines.push(`${level === "high"} ${level == "low"} ${worth(level)} ${String(keep(row, level))}`);
  }
  for (const text of texts)
    lines.push(`${keepMode(text as Mode)} ${kept} ${keepLast(text)} ${last} ${holder.take(text)} ${holder.level}`);
  for (const value of loose)
    lines.push(
      `${keepMode(value)} ${String(kept)} ${keepLast(value)} ${String(last)} ${holder.take(value)} ${String(holder.level)}`,
    );
  for (const level of cast) counts[level] = (counts[level] ?? 0) + 1;
  console.log(lines.join("\n"));
}
console.log(JSON.stringify(counts), JSON.stringify(row));
//// texts-from-outside-equal-members-that-no-code-spells.ts
// Two members of a union of texts stand in the type alone: no code spells them. Texts equal to them come from a parser, from joined pieces and from a reversed text. They are stored into typed fields, read, compared, switched on, used as keys and printed, beside the two members that code does spell, a text that is no member and the empty text. Where narrowing leaves one such member, the value is printed as it came
type Color = "red" | "amber" | "green" | "violet";
interface Lamp { color: Color; next?: Color; watts: number }
class Signal {
  color: Color = "red";
  changes = 0;
  set(color: Color): void { if (this.color !== color) this.changes++; this.color = color; }
}
const pieces: string[] = JSON.parse('["am","ber","vio","let","re","d","gre","en","pi","nk"]');
const reversed = (text: string): string => text.split("").reverse().join("");
const joined = (at: number): string => pieces[at] + pieces[at + 1];
const first: string[] = [joined(0), joined(2), joined(4), joined(6), joined(8), ""];
const second: string[] = [reversed("rebma"), reversed("teloiv"), JSON.parse('"red"'), reversed("neerg"), reversed("knip"), pieces[0].slice(2)];
function same(a: Color, b: Color): boolean { return a === b; }
function differs(a: Color, b: Color): boolean { return a !== b; }
function looselySame(a: Color, b: Color): boolean { return a == b; }
function isRed(color: Color): boolean { return color === "red"; }
function isNotGreen(color: Color): boolean { return "green" !== color; }
function letter(color: Color): string {
  switch (color) {
    case "red": return "R";
    case "green": return "G";
    default: return "other:" + color;
  }
}
function pass(color: Color): Color { return color; }
function lamp(color: Color, watts: number): Lamp { return { color, watts }; }
function follow(from: Lamp, to: Lamp): void { to.next = from.color; }
function either(flag: boolean, outside: Color): Color { return flag ? "green" : outside; }

let matrix = "";
for (const a of first) {
  for (const b of second) matrix += same(a as Color, b as Color) ? "1" : differs(a as Color, b as Color) ? "0" : "?";
  matrix += " ";
}
console.log(matrix);
console.log(first.map((a, at) => looselySame(a as Color, second[at] as Color) && Object.is(a, second[at])).join());

const signal = new Signal();
const counts = new Map<Color, number>();
const seen = new Set<Color>();
const byKey: Partial<Record<Color, number>> = {};
const lamps: Lamp[] = [];
for (let round = 0; round < 50; round++) {
  for (let at = 0; at < first.length; at++) {
    const color = (round & 1 ? second : first)[at] as Color;
    signal.set(color);
    counts.set(signal.color, (counts.get(pass(color)) ?? 0) + 1);
    seen.add(color);
    byKey[color] = (byKey[signal.color] ?? 0) + at;
    if (round < 2) lamps.push(lamp(color, at));
  }
}
console.log(signal.color.length, signal.changes, seen.size, [...seen].join(), [...counts].join(";"), JSON.stringify(byKey), Object.keys(byKey).join());
for (let at = 0; at < first.length; at++) {
  const a = lamps[at], b = lamps[at + first.length];
  follow(a, b);
  console.log(
    letter(a.color), isRed(b.color), isNotGreen(a.color), same(a.color, b.color), same(b.next!, b.color), a.next === undefined, typeof a.color, a.color.length,
    `<${b.color}>`, a.color + "|" + b.next, a.color.toUpperCase(), JSON.stringify(b), counts.get(b.color), seen.has(a.color), byKey[b.color],
    either(at > 2, a.color), either(true, a.color) === "green", same(either(false, a.color), b.color), (a as any).color === second[at], a.color.charCodeAt(0),
  );
}
const list = first as Color[];
console.log(second.map(text => list.indexOf(text as Color)).join(), second.map(text => list.includes(text as Color)).join(), [...list].sort().join(), list.lastIndexOf(pass(second[1] as Color)));
const kept = lamps.map(each => each.color);
for (let round = 0; round < 20; round++) new Array(50000).fill(round).map(String);
console.log(kept.join(), kept.filter(color => !isRed(color) && isNotGreen(color)).map(letter).join());
type Pair = "red" | "amber";
function rest(color: Pair): string { return color === "red" ? "r" : color + "!" + JSON.stringify(color) + color.length + `<${color}>` + color.charCodeAt(1); }
console.log(first.map(text => rest(text as Pair)).join(" "), second.map(text => rest(text as Pair)).join(" "));
type Shape = { kind: "circle"; size: number } | { kind: "square"; side: number };
function area(shape: Shape): string { return shape.kind === "circle" ? "circle " + shape.size : shape.kind + " " + shape.side + " " + JSON.stringify(shape); }
console.log(area({ kind: "circle", size: 2 }), area(JSON.parse('{"kind":"' + reversed("erauqs") + '","side":3}') as Shape), area(JSON.parse('{"kind":"' + reversed("elgnairt") + '","side":4}') as Shape));
//// texts-made-at-run-time-meet-the-test-of-a-narrower-union.ts
// A field of a union of texts is read and stored, under `as`, into a field of a narrower union. What arrives: the texts of both unions, made by a parser, by joining pieces and by cutting a longer text; a text of the wider union alone; a text of neither; 16-bit texts; the empty text
type Color = "red" | "green" | "blue";
type Warm = "red" | "green";
class Light { color: Color; constructor(color: Color) { this.color = color; } }
class Lamp { color: Warm = "red"; stores = 0; }
const never = Date.now() < 0;
const pieces: string[] = JSON.parse('["re","d","gre","en","bl","ue","vio","let"]');
const long: string = never ? "" : pieces.join("-") + "-redgreenblue";
const made: string[] = [
  "red", "green", "blue", JSON.parse('"red"'), JSON.parse('"green"'), JSON.parse('"blue"'),
  pieces[0] + pieces[1], pieces[2] + pieces[3], pieces[4] + pieces[5], pieces[6] + pieces[7],
  long.slice(-12, -9), long.slice(-9, -4), long.slice(-4), long.slice(0, 2), "", "réd", "紅", ("red紅").slice(0, 3), ("紅green").slice(1),
];
function copy(to: Lamp, from: Light): void { to.color = from.color as Warm; to.stores++; }
function isWarm(color: Warm): number { return color === "red" ? 1 : color === "green" ? 2 : 3; }
function pass(from: Light): number { return isWarm(from.color as Warm); }
function letterOf(color: Color): string { switch (color) { case "red": return "R"; case "green": return "G"; case "blue": return "B"; } return "?"; }
const lamp = new Lamp();
for (let round = 0; round < 200; round++) {
  let line = "";
  for (const text of made) {
    const light = new Light(text as Color);
    copy(lamp, light);
    line += lamp.color + ":" + lamp.color.length + ":" + pass(light) + ":" + letterOf(light.color) + ":" + (lamp.color === text) + " ";
  }
  if (round % 99 === 0) console.log(round, lamp.stores, line);
}
