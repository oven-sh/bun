//// a-collection-falls-while-a-list-of-very-many-keys-is-printed.ts
// A record is parsed from a text with 65,534 more keys than its type names, and the number of its keys is printed. So much is allocated that a collection falls while the objects that printing makes are alive,
// and some of their fields hold one of a few texts that no code of the program reads.
const members: string[] = [];
for (let i = 0; i < 65534; i++) members.push('"k' + i + '":' + i);
type Row = { first: number };
console.log(Object.keys(JSON.parse('{"first":0,' + members.join(",") + "}") as Row).length);
//// a-field-is-compared-with-literals-whatever-it-holds.ts
// A field whose type is a union of literal strings lies in a narrow slot: a small word for a literal, a reference for any other string. `===`, `!==`, `==`, `switch`, `typeof` and tests for
// undefined and null look at the word as it was loaded. Every kind of content goes through the same readers: the literals, the same texts made at run time, other texts, undefined and null.
type Kind = "circle" | "square" | "line" | "";
class Shape {
  kind: Kind;
  other: Kind | undefined;
  size: number;
  next: Shape | null = null;
  constructor(kind: Kind, size: number) {
    this.kind = kind;
    this.other = undefined;
    this.size = size;
  }
}
const out: string[] = [];
const suffix = process.argv[2] ?? "";
const hide = new Function("value", "return value" + suffix) as <V>(value: V) => V;
const store = new Function("object", "key", "value", "object[key] = value" + suffix) as (object: object, key: string, value: unknown) => void;

function compare(shape: Shape): string {
  return [
    shape.kind === "circle", shape.kind !== "square", shape.kind == "line", "circle" === shape.kind, shape.kind === "", shape.kind === shape.other, shape.other === "square",
    shape.other === undefined, shape.other == null, shape.kind === (undefined as unknown as Kind), typeof shape.kind, typeof shape.other, !shape.kind, !!shape.other,
  ].join(" ");
}
function choose(shape: Shape): string {
  switch (shape.kind) {
    case "circle":
      return "round " + shape.size;
    case "square":
      return "four " + shape.size;
    case "":
      return "empty " + shape.size;
    case "line":
      return "thin " + shape.size;
  }
  return "none of them: " + String(shape.kind);
}
function chooseWithOthers(shape: Shape, text: string): string {
  switch (shape.other as string | undefined) {
    case "circle":
      return "circle";
    case "a text that no type lists":
      return "listed nowhere";
    case text:
      return "the operand";
    case undefined:
      return "undefined";
  }
  return "default";
}
function area(first: Shape): number {
  let sum = 0;
  for (let shape: Shape | null = first; shape !== null; shape = shape.next) {
    if (shape.kind === "circle") sum += 3 * shape.size * shape.size;
    else if (shape.kind === "square") sum += shape.size * shape.size;
    else if (shape.kind !== "line") sum -= 1;
  }
  return sum;
}
function show(name: string, shape: Shape) {
  out.push(`${name}: ${compare(shape)} | ${choose(shape)} | ${chooseWithOthers(shape, "squ" + "are".slice(0, hide(3)))} | ${area(shape)}`);
}

const made = (text: string) => hide(text.slice(0, hide(1))) + hide(text.slice(1));
for (const kind of ["circle", "square", "line", ""] as const) {
  show(`the literal "${kind}"`, hide(new Shape(kind, 2)));
  show(`"${kind}" made at run time`, hide(new Shape(made(kind) as Kind, 3)));
  const both = hide(new Shape(kind, 4));
  both.other = kind;
  show(`"${kind}" in both fields`, both);
  const bothMade = hide(new Shape(kind, 5));
  bothMade.other = made(kind) as Kind;
  show(`"${kind}" and the same text made at run time`, bothMade);
  const unseen = hide(new Shape("line", 6));
  store(unseen, "kind", made(kind));
  store(unseen, "other", kind);
  show(`"${kind}" stored by code that nobody sees`, unseen);
}
for (const [word, value] of [["another text", "triangle"], ["a text that no type lists", "a text that no type lists"], ["a long text", "circle".repeat(40)], ["undefined", undefined], ["null", null], ["a number", 7], ["an object", { toString: () => "circle" }]] as const) {
  const cast = hide(new Shape(hide<unknown>(value) as Kind, 7));
  show(`${word} behind a cast`, cast);
  const stored = hide(new Shape("circle", 8));
  store(stored, "kind", value);
  store(stored, "other", value);
  show(`${word} stored by code that nobody sees`, stored);
  stored.kind = "square";
  stored.other = "square";
  show(`${word}, and then a literal again`, stored);
}
const chain = hide(new Shape("circle", 1));
chain.next = hide(new Shape(made("square") as Kind, 2));
chain.next.next = hide(new Shape("line", 3));
chain.next.next.next = hide(new Shape(hide<unknown>("oval") as Kind, 4));
show("a chain", chain);
let total = 0;
for (let turn = 0; turn < 2000; turn++) total += area(chain);
out.push("many turns: " + total);
console.log(out.join("\n"));
//// a-listed-text-is-compared-and-then-handed-on-under-a-narrower-union.ts
// A value of a union of listed texts is tested, compared with written texts and then handed on as what the comparisons have left of the union.
type Mode = "a" | "b" | "c" | "d";
type Ext = "a" | "b" | "c";
const table: Record<string, Mode> = { one: "a", two: "b", three: "c", four: "d" };
function fromString(s: string): Mode { return (table[s] ?? s.slice(1)) as Mode; }
function isExt(m: Mode): m is Ext { return m !== "d"; }
export function narrowedAndReturned(s: string | undefined): Ext | undefined {
  const e = s ? fromString(s) : undefined;
  return e && isExt(e) && e !== "c" ? e : undefined;
}
export function comparedAndReturned(list: string[], i: number): "a" | "b" | undefined {
  const e = list[i] as Ext;
  return e !== "c" ? e : undefined;
}
const kept: { mode: "a" | "b" }[] = [];
export function comparedAndStored(list: string[], i: number): number {
  const e = list[i] as Ext;
  if (e === "c") return 0;
  kept.push({ mode: e });
  return kept.length;
}
export function truthyAndReturned(list: (string | undefined)[], i: number): Ext | "none" {
  const e = list[i] as Ext | undefined;
  return e ? e : "none";
}
export function switchedAndReturned(list: string[], i: number): "a" | "b" | "other" {
  const e = list[i] as Ext;
  switch (e) {
    case "a": return e;
    case "b": return e;
    default: return "other";
  }
}
const words = ["xa", "xb", "xc", "xd", "xe"].map(text => text.slice(1));
for (let round = 0; round < 3; round++) {
  for (const s of ["one", "two", "three", "four", "xa", "xc", "xz", "", undefined]) console.log(String(s), narrowedAndReturned(s));
  for (let i = 0; i < 6; i++) console.log(i, comparedAndReturned(words, i), comparedAndStored(words, i), truthyAndReturned(words, i), switchedAndReturned(words, i));
}
console.log(JSON.stringify(kept));
//// a-million-texts-from-outside-equal-a-member-that-no-code-spells.ts
// A text from outside the program that equals a member of a union which no code spells is stored into a typed field, read, compared, switched on and passed on, a million times. The first argument names another text
type Color = "red" | "amber" | "green" | "violet";
class Signal { color: Color = "red"; }
class Tally { red = 0; green = 0; other = 0; length = 0; same = 0; }
const given: string = process.argv[2] ?? JSON.parse('["am","ber"]').join("");
const texts: string[] = [];
for (let at = 0; at < 8; at++) texts.push(JSON.parse(JSON.stringify(given)));
function weigh(color: Color): number {
  switch (color) {
    case "red": return 1;
    case "green": return 2;
    default: return 3;
  }
}
function step(signal: Signal, tally: Tally, text: string, previous: Color): Color {
  signal.color = text as Color;
  const color = signal.color;
  if (color === "red") tally.red++;
  else if (color === "green") tally.green++;
  else tally.other++;
  tally.length += weigh(color);
  if (color === previous) tally.same++;
  return color;
}
const signal = new Signal();
const tally = new Tally();
let previous: Color = "red";
for (let round = 0; round < 1_000_000; round++) previous = step(signal, tally, texts[round & 7], previous);
console.log(tally.red, tally.green, tally.other, tally.length, tally.same, previous.length);
//// box-round-trip.ts
// A literal-string value keeps its identity through fields, untyped calls, keys and concatenation.
declare const console: { log(...values: unknown[]): void };
type Method = "get" | "post" | undefined;
type Verb = "get" | "post" | "trace";
class Request {
  method: Method;
  constructor(method: Method) {
    this.method = method;
  }
}
const table: Record<string, number> = { get: 1, post: 2, undefined: 3 };
function untyped(value: any): any {
  return value;
}
function read(request: Request): Method {
  return request.method;
}
function roundTrip(method: Method): string {
  const returned = untyped(read(new Request(method))) as Method;
  return [returned === method, returned === "get", table[returned as string], "<" + returned + ">"].join(" ");
}
console.log(roundTrip("get"));
console.log(roundTrip("post"));
console.log(roundTrip(undefined));
function spelled(parts: string[]): any {
  return parts.join("");
}
function accept(verb: Verb): Verb {
  return verb;
}
const spelledVerb = accept(spelled(["tr", "ace"]));
console.log(spelledVerb, spelledVerb.length, untyped(spelledVerb) === spelled(["tr", "ace"]), "<" + spelledVerb + ">");
function requireMethod(method: Method): string {
  return "accepted " + method;
}
const untypedCaller = untyped(requireMethod);
console.log(untypedCaller("get"));
console.log(untypedCaller(undefined));
try {
  console.log(untypedCaller("put"));
} catch (error) {
  console.log(error instanceof TypeError ? "TypeError" : "other");
}
//// compared-value-is-never-a-string.ts
// A value that the compiler can prove is never a string is compared with a string literal, in every form a comparison takes. Every line is what plain Bun prints.
function isY(value: any): boolean { return value === "y"; }
function isNotY(value: any): boolean { return value !== "y"; }
function literalFirst(value: any): string { return "longer text" === value ? "equal" : "different"; }
function chained(value: any): string { if (value === "a") return "a"; else if (value === "b") return "b"; return "neither"; }
function switched(value: any): string { switch (value) { case "a": return "a"; case "b": return "b"; default: return "neither"; } }
const values: any[] = [undefined, null, true, 1, 1.5, 10n, Symbol.iterator, { a: 1 }, [1], () => 1];
for (const check of [isY, isNotY, literalFirst, chained, switched]) console.log(check.name, values.map(value => check(value)).join(" "));

const level: number | bigint = Date.now() > 0 ? 3 : 3n;
console.log((level as any) === "r", (level as any) !== "r", "r" === (level as any));

const segments: any[] = [{ a: 1 }, undefined, { a: 2 }];
console.log(segments.some(() => segments.some((segment, at) => segment === "x" && segments[at + 1] === "y")));

async function waits(value: any): Promise<string> {
  try {
    await Promise.reject(new Error("first")).catch(() => undefined);
    if (value === "r") return "never";
    return "done";
  } catch {
    return "caught";
  } finally {
    await undefined;
  }
}
waits(level).then(console.log);
//// concat-map-values-and-elements.ts
// A field of a union of string literals joined with what a Map, an array, a generic function or a Promise yields, under `!`, `??`, `||`, `&&`, `?:` and the assignments made of them.
type K = "a" | "b" | "c" | "";
class H {
    kind: K | undefined;
    opt?: K;
    must: K = "c";
    constructor(k?: K) { this.kind = k; }
}
const table = new Map<string, K>([["x", "b"], ["e", ""]]);
const list: K[] = ["c", "a", ""];
function same<T extends string>(t: T): T { return t; }
function first<T>(ts: T[]): T | undefined { return ts[0]; }
function name(k: K | undefined | null): string { return k === "a" ? "A" : k === "b" ? "B" : k === "c" ? "C" : k === "" ? "E" : k == null ? "N" : "?"; }
function fromMap(h: H, key: string): K { return (h.kind ?? table.get(key))!; }
function fromElement(h: H, i: number): K { return (h.kind || list[i])!; }
function chosen(c: boolean, h: H, i: number): K { return (c ? h.kind : list[i])!; }
function both(h: H, key: string, i: number): K { return (table.get(key) ?? list[i] ?? h.must)!; }
function guarded(h: H, key: string): K | undefined { return h.kind && table.get(key); }
function generic(h: H, c: boolean): K { return (c ? same(h.must) : first(list))!; }
function assigned(h: H, key: string, i: number): string {
    let k = h.kind; k ??= table.get(key); let m = h.opt; m ||= list[i]; let n: K | undefined = h.must; n &&= table.get(key);
    h.opt ??= list[i]; h.kind ||= table.get(key);
    return [k, m, n, h.opt, h.kind].map(name).join("");
}
function carried(h: H): string {
    let k: K | undefined = h.kind, trace = "";
    for (const next of list) { trace += name(k); k = trace.length & 1 ? next : h.must; }
    for (const [key, value] of table) { trace += key + name(k); k = value; }
    return trace + name(k);
}
async function awaited(h: H, key: string): Promise<K> { return (h.kind ?? (await Promise.resolve(table.get(key))))!; }
const out: string[] = [];
for (const h of [() => new H(), () => new H("a"), () => new H("")]) {
    out.push(name(fromMap(h(), "x")), name(fromMap(h(), "e")), name(fromElement(h(), 0)), name(fromElement(h(), 1)), name(chosen(false, h(), 2)), name(both(h(), "x", 0)), name(both(h(), "q", 1)), name(both(h(), "q", 9)));
    out.push(name(guarded(h(), "x")), name(guarded(h(), "q")), name(generic(h(), true)), name(generic(h(), false)), assigned(h(), "x", 1), assigned(h(), "q", 0), carried(h()));
}
out.push(name(chosen(true, new H("b"), 0)));
console.log(out.join(" "));
Promise.all([awaited(new H(), "x"), awaited(new H("c"), "x"), awaited(new H(), "e")]).then(all => console.log(all.map(name).join("")));
//// concat-numbers-and-strings.ts
// Where a value of a union of string literals and a string that comes out of `any` meet: `!`, `??`, `||`, `&&`, `?:`, defaults, loops, handlers, destructuring. A string out of `any` goes on whether or not it spells one of the literals: a literal type promises the kind, string.
type Kind = "alpha" | "beta" | "gamma" | "";
interface Holder { kind?: Kind; other?: Kind | null }
const outside: any = JSON.parse('{"kind":"beta","other":"delta","list":["gamma","alpha","zeta"],"empty":"","nothing":null}');
function asserted(h: Holder, o: any): Kind { return (h.kind ?? o.kind)!; }
function assertedOr(h: Holder, o: any): Kind { return (h.kind || o.other)!; }
function assertedAnd(h: Holder, o: any): Kind { return (h.kind && o.kind)!; }
function chosen(c: boolean, h: Holder, o: any): Kind | undefined { return c ? h.kind : o.kind; }
function chosenAsserted(c: boolean, h: Holder, o: any): Kind { return (c ? h.kind : o.other)!; }
function withDefault(o: any, kind: Kind = o.kind): Kind { return kind; }
function fromPattern({ kind = "gamma" as Kind, other = outside.other as Kind }: Holder): string { return kind + "/" + other; }
function carried(o: any): string {
    let kind: Kind = "alpha", trace = "";
    for (const next of o.list) { trace += kind === "alpha" ? "A" : kind === "gamma" ? "G" : "?"; kind = next; }
    return trace + kind;
}
function caught(o: any, fails: boolean): Kind {
    let kind: Kind = "alpha";
    try { if (fails) throw o.other; kind = o.kind; } catch (thrown) { kind = thrown as Kind; }
    return kind;
}
function nested(h: Holder, o: any, n: number): Kind { return (n === 0 ? h.kind : n === 1 ? o.kind : n === 2 ? (h.other ?? o.empty) : o.other)!; }
function stored(h: Holder, o: any): Holder { h.kind = (h.other || o.kind)!; h.other = o.nothing ?? h.kind; return h; }
function rank(kind: Kind | undefined | null): number { return kind === "alpha" ? 1 : kind === "beta" ? 2 : kind === "gamma" ? 3 : kind === "" ? 4 : kind == null ? 5 : 6; }
async function awaited(o: any, h: Holder): Promise<Kind> { const kind: Kind = (await Promise.resolve(h.kind)) ?? (await o.kind); return kind; }
function* yielded(o: any): Generator<Kind, Kind, Kind> { let kind: Kind = "alpha"; for (let i = 0; i < 3; i++) kind = (yield kind) ?? o.kind; return kind; }
function attempt(f: () => unknown): unknown { try { return f(); } catch (e) { return (e as Error).constructor.name; } }
const out: unknown[] = [];
for (const h of [{}, { kind: "alpha" }, { kind: "", other: "gamma" }, { other: null }] as Holder[]) {
    out.push(attempt(() => asserted(h, outside)), attempt(() => assertedOr(h, outside)), attempt(() => assertedAnd(h, outside)), attempt(() => chosen(true, h, outside)), attempt(() => chosen(false, h, outside)), attempt(() => chosenAsserted(true, h, outside)), attempt(() => chosenAsserted(false, h, outside)));
    out.push(attempt(() => fromPattern(h)), attempt(() => rank(asserted(h, outside))), attempt(() => rank(assertedOr(h, outside))), attempt(() => rank(chosen(true, h, outside))));
    for (let n = 0; n < 4; n++) out.push(attempt(() => nested(h, outside, n)), attempt(() => rank(nested(h, outside, n))));
    out.push(attempt(() => JSON.stringify(stored({ ...h }, outside))));
}
out.push(attempt(() => withDefault(outside)), attempt(() => withDefault(outside, "gamma")), attempt(() => carried(outside)), attempt(() => caught(outside, false)), attempt(() => caught(outside, true)), attempt(() => rank(caught(outside, true))));
const steps = yielded(outside);
out.push(attempt(() => steps.next().value), attempt(() => steps.next("beta").value), attempt(() => steps.next(undefined as unknown as Kind).value), attempt(() => steps.next("zeta" as Kind).value));
console.log(out.map(String).join(" | "));
Promise.all([awaited(outside, {}), awaited(outside, { kind: "gamma" })]).then(all => console.log(all.join(), all.map(rank).join()));
//// conversions-in.ts
// A string from anywhere that spells one of the literals of a union enters the union, and is compared as what it spells. A string that spells none of them enters too, and compares unequal to each of them.
type Kind = "leaf" | "node" | "root";
interface Item { kind: Kind; size: number }

function isLeaf(k: Kind): boolean {
    return k === "leaf";
}
function which(k: Kind): number {
    switch (k) {
        case "leaf": return 1;
        case "node": return 2;
        case "root": return 3;
        default: return 0;
    }
}
function same(a: Kind, b: Kind): boolean {
    return a === b;
}
function differ(a: Kind, b: Kind): boolean {
    return a !== b;
}
function hold(k: Kind): Item {
    return { kind: k, size: k.length };
}
function text(parts: string[]): string {
    let made = "";
    for (const part of parts) made += part;
    return made;
}
function isKind(s: string): s is Kind {
    return s === "leaf" || s === "node" || s === "root";
}

const rope = text(["le", "af"]) as Kind;
const sliced = "a node!".slice(2, 6) as Kind;
const parsed = JSON.parse('["root", "stranger", "stranger", "leaf", ""]') as Kind[];
const fromAny: any = "no" + "de";
const viaAny: Kind = fromAny;
console.log(isLeaf(rope), which(rope), isLeaf(sliced), which(sliced), which(viaAny), same(viaAny, sliced), same(rope, "leaf"), differ(rope, parsed[3]));
try {
    for (const k of parsed)
        console.log(k, isLeaf(k), which(k), same(k, parsed[1]), same(k, parsed[2]), differ(k, "root"), hold(k).kind, hold(k).size, JSON.stringify(hold(k)));
} catch (e) {
    console.log("a stranger passed:", (e as Error).constructor.name);
}
try {
    const strangerA = hold(parsed[1]);
    const strangerB = hold(text(["stran", "ger"]) as Kind);
    console.log(strangerA.kind === strangerB.kind, same(strangerA.kind, strangerB.kind), strangerA.kind, typeof strangerB.kind, strangerB.kind.length, which(strangerB.kind));
    strangerA.kind = "node";
    strangerB.kind = strangerA.kind;
    console.log(strangerA.kind === strangerB.kind, which(strangerB.kind));
} catch (e) {
    console.log("a stranger held:", (e as Error).constructor.name);
}
for (const s of ["leaf", "twig", text(["ro", "ot"])]) {
    if (isKind(s))
        console.log(s, which(s), hold(s).kind);
    else
        console.log(s, "is none");
}
let narrowed: string = text(["no", "de"]);
if (narrowed === "node" || narrowed === "leaf") {
    const item = hold(narrowed);
    console.log(item.kind, which(item.kind), which(narrowed));
}
try {
    const many: Item[] = [];
    for (let i = 0; i < 2000; i++)
        many.push(hold(text(["made", String(i % 7)]) as Kind));
    let equal = 0;
    for (let i = 1; i < many.length; i++)
        equal += many[i].kind === many[i - 7 < 0 ? 0 : i - 7].kind ? 1 : 0;
    console.log(equal, many[1999].kind);
} catch (e) {
    console.log("a stranger cast:", (e as Error).constructor.name);
}
//// conversions-in-leaf-functions.ts
// A function small enough to need no frame still converts a literal string to a string: in a result, at a merge and
// in an argument of a tail call.
const opaque = new Function("value", "return value") as <T>(value: T) => T;

type Kind = "circle" | "square" | "triangle" | "";
interface Shape { kind: Kind; next: Kind | null }
type Callback = (kind: any, index?: number) => string;

function kindAsString(shape: Shape): string {
    return shape.kind;
}
function nextAsUnknown(shape: Shape): unknown {
    return shape.next;
}
function kindOrNext(shape: Shape, useNext: boolean): string | null {
    return useNext ? shape.next : shape.kind;
}
function kindOr(shape: Shape, other: string, useOther: boolean): string {
    return useOther ? other : shape.kind;
}
function passKind(kind: Kind, callback: Function): unknown {
    return callback(kind);
}
function passField(shape: Shape, callback: (kind: string) => string): string {
    return callback(shape.kind);
}
function passNext(shape: Shape, callback: (kind: unknown, index: number) => unknown): unknown {
    return callback(shape.next, 1);
}

const kinds: Kind[] = ["circle", "square", "triangle", ""];
const shapes: Shape[] = kinds.map((kind, i) => ({ kind, next: i % 2 ? null : kinds[(i + 1) % kinds.length] }));
const callbacks: Callback[] = [
    kind => `<${kind}>`,
    kind => typeof kind + String(kind).length,
    (kind, index) => `${kind}:${index}`,
];

function sumOfLengths(leaves: { kindAsString: typeof kindAsString; nextAsUnknown: typeof nextAsUnknown; kindOrNext: typeof kindOrNext; kindOr: typeof kindOr; passKind: typeof passKind; passField: typeof passField; passNext: typeof passNext }): number {
    let sum = 0;
    for (let round = 0; round < 20_000; round++) {
        const shape = shapes[round % shapes.length];
        const callback = callbacks[round % callbacks.length];
        sum += leaves.kindAsString(shape).length + String(leaves.nextAsUnknown(shape)).length + String(leaves.kindOrNext(shape, round % 3 === 0)).length;
        sum += leaves.kindOr(shape, "other", round % 5 === 0).length + String(leaves.passKind(shape.kind, callback)).length;
        sum += leaves.passField(shape, callback).length + String(leaves.passNext(shape, callback)).length;
    }
    return sum;
}

console.log(sumOfLengths({ kindAsString, nextAsUnknown, kindOrNext, kindOr, passKind, passField, passNext }));
// A callee the compiler cannot see is not inlined, so each leaf runs in a body of its own.
console.log(sumOfLengths({
    kindAsString: opaque(kindAsString),
    nextAsUnknown: opaque(nextAsUnknown),
    kindOrNext: opaque(kindOrNext),
    kindOr: opaque(kindOr),
    passKind: opaque(passKind),
    passField: opaque(passField),
    passNext: opaque(passNext),
}));

for (const shape of shapes) {
    console.log(kindAsString(shape), nextAsUnknown(shape), kindOrNext(shape, true), kindOrNext(shape, false), kindOr(shape, "other", true), kindOr(shape, "other", false));
    for (const callback of callbacks)
        console.log(passKind(shape.kind, callback), passField(shape, callback), passNext(shape, callback));
