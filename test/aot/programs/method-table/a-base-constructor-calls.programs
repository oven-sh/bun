import { isMainThread, parentPort, Worker } from "node:worker_threads";

////= Meter-2
class Plain extends Meter {}

////= total

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];

let checksum = 0;
////= note-2

if (isMainThread) {
  note(total(meters));
  const worker = new Worker(new URL(import.meta.url));
  for (const seen of await new Promise<number[]>(resolve => worker.once("message", resolve))) note(seen);
  note(total(meters));
  note(new Plain(10).read());
  await worker.terminate();
  console.log(checksum);
} else {
  const seen = [total(meters)];
  Object.setPrototypeOf(Plain.prototype, Double.prototype);
  seen.push(total(meters));
  seen.push(new Plain(10).read());
  Object.setPrototypeOf(meters[0], Double.prototype);
  seen.push(total(meters));
  Object.setPrototypeOf(Plain.prototype, Meter.prototype);
  seen.push(total(meters));
  parentPort?.postMessage(seen);
}
//// a-worker-is-terminated-while-it-replaces-methods-in-a-loop.ts
// Three Workers replace, delete and put back methods in endless loops and are terminated in the middle of that. The main thread calls the same methods all the time and keeps the originals, and a Worker that is started afterwards finds them too.
////= Meter-2
class Plain extends Meter {}

////= total

////= start

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];

////= note

if (Bun.isMainThread) {
  const endless = [start("endless"), start("endless"), start("endless")];
  for (const { answer } of endless) note("a Worker before its loop", await answer);
  let wrong = 0;
  for (let i = 0; i < 300000; i++) if (total(meters) !== 26) wrong++;
  for (const { worker } of endless) worker.terminate();
  for (let i = 0; i < 300000; i++) if (total(meters) !== 26) wrong++;
  for (const { closed } of endless) await closed;
  note("wrong totals on the main thread", wrong);
  const last = start("once");
  note("a Worker started afterwards", await last.answer);
  last.worker.terminate();
  await last.closed;
  note("main at the end", total(meters));
} else {
  addEventListener("message", (event: MessageEvent<string>) => {
    postMessage(total(meters));
    if (event.data !== "endless") return;
    const ofMeter = Meter.prototype.read;
    const ofDouble = Double.prototype.read;
    for (let round = 0; ; round++) {
      Meter.prototype.read = () => round;
      Reflect.deleteProperty(Double.prototype, "read");
      if (total(meters) !== 3 * round) throw new Error("a Worker lost its own replacement");
      Meter.prototype.read = ofMeter;
      Double.prototype.read = ofDouble;
    }
  });
}

export {};
