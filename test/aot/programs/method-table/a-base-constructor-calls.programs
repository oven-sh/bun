////: areas
function areas(shapes: Shape[]): number {
  let sum = 0;
  for (const shape of shapes) sum += shape.area();
  return sum;
}
////: areas-2
function areas(shapes: Shape[], at: number, change: () => void): number {
  let sum = 0;
  for (let i = 0; i < shapes.length; i++) {
    if (i === at) change();
    sum += shapes[i].area();
  }
  return sum;
}
