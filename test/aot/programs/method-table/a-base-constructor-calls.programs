//// classes-that-extend-built-ins-have-overridden-methods.ts
// Three families whose roots extend Error, Array and Map: their instances are an error, an array and a map and not plain objects. Each family has a method with an override that calls super. The methods are called through the type of the root, then replaced and deleted.
class Failure extends Error {
  code(): number {
    return this.message.length;
  }
}
////= lines-13	Timeout	Failure	code	100
class Refused extends Failure {}

class Stack extends Array<number> {
  top(): number {
    return this[this.length - 1];
  }
}
class Capped extends Stack {
  top(): number {
    return Math.min(super.top(), 10);
  }
}

////= Registry
class Doubled extends Registry {
  total(): number {
    return super.total() * 2;
  }
}

////= lines	codes	failures	Failure	failure	1000	failure.code
////= lines	tops	stacks	Stack	stack	1000	stack.top
////= lines	totals	registries	Registry	registry	1000	registry.total

////= note

const failures: Failure[] = [new Failure("a"), new Timeout("bb"), new Refused("ccc")];
const stacks: Stack[] = [new Stack(), new Capped()];
for (const stack of stacks) stack.push(5, 50);
const registries: Registry[] = [new Registry(), new Doubled()];
for (const registry of registries) registry.set("x", 3).set("y", 4);

function round(): void {
  note("errors", codes(failures));
  note("arrays", tops(stacks));
  note("maps", totals(registries));
}

round();
Failure.prototype.code = () => 7;
Stack.prototype.top = function () {
  return this[0];
};
////= lines-21	Registry	total	size
round();
Reflect.deleteProperty(Timeout.prototype, "code");
Reflect.deleteProperty(Capped.prototype, "top");
Reflect.deleteProperty(Doubled.prototype, "total");
round();
stacks[0].top = () => 8;
registries[1].total = () => 9;
failures[2].code = () => 6;
round();

export {};
