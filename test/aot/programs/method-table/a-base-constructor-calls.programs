//// a-module-loaded-later-adds-a-subclass-and-replaces-a-method/family.ts
export class Shape {
  constructor(public side: number) {}
  area(): number {
    return this.side * this.side;
  }
}
export class Circle extends Shape {
  area(): number {
    return 3 * this.side * this.side;
  }
}
export class Dot extends Shape {}

export function areas(shapes: Shape[]): number {
  let sum = 0;
  for (const shape of shapes) sum += shape.area();
  return sum;
}
//// a-module-loaded-later-adds-a-subclass-and-replaces-a-method/late.ts
import { Circle, Shape } from "./family";

export class Ring extends Circle {
  area(): number {
    return super.area() - 1;
  }
}

Shape.prototype.area = function () {
  return this.side + 100;
};
//// a-module-loaded-later-adds-a-subclass-and-replaces-a-method/main.ts
// The family and its call site live in one module. A second module, which is imported in the middle of the program, adds a subclass below an override and replaces the method of the base. Calls before the import find the originals; calls after it find the replacement and the new override.
import { areas, Circle, Dot, Shape } from "./family";

const shapes: Shape[] = [new Shape(2), new Circle(3), new Dot(4)];
console.log("before the import: " + areas(shapes));
let sum = 0;
for (let round = 0; round < 1000; round++) sum += areas(shapes);
console.log("a thousand rounds: " + sum);
const { Ring } = await import("./late");
console.log("after the import: " + areas(shapes));
shapes.push(new Ring(5));
console.log("with an object of the new subclass: " + areas(shapes));
Circle.prototype.area = () => 1;
console.log("after the override in between is replaced: " + areas(shapes));
//// a-private-method-beside-a-public-one-of-the-same-name.ts
// #code() and code() live side by side, in a class and in its subclass, which has a #code() of its own. Replacing or deleting the public one never changes what the private name finds, and an object made from the prototype alone has the public one and not the private one.
////= Safe
////= Vault
class Drawer extends Safe {}

function codes(safes: Safe[]): number {
  let sum = 0;
  for (const safe of safes) sum = sum * 100 + safe.code() + Safe.peek(safe);
  return sum;
}

////= attempt-10

const safes: Safe[] = [new Safe(), new Vault(), new Drawer()];
note("at first", codes(safes));
Safe.prototype.code = () => 5;
note("the public one of the base is replaced", codes(safes));
Reflect.deleteProperty(Vault.prototype, "code");
note("the public one of the subclass is deleted", codes(safes));
const bare: Safe = Object.create(Safe.prototype);
note("the public one on an object that was never constructed", attempt(() => bare.code()));
note("the private one on it", attempt(() => Safe.peek(bare)));

export {};
