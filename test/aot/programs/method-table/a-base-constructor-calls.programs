////: makeAll
function makeAll(classes: (typeof Base)[]): number {
  let sum = 0;
  for (const each of classes) sum = sum * 100 + each.make() + each.rank();
  return sum;
}
////: makeCounter
function makeCounter(step: number) {
  return class Counter {
    count = 0;
    bump(): number {
      this.count += step;
      return this.count;
    }
    twice(): number {
      return this.bump() + this.bump();
    }
  };
}
