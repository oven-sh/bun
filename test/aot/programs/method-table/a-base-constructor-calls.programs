//// a-receiver-is-missing-where-the-type-says-it-is-there.ts
// TypeScript takes list[i] for a lamp even past the end of the list, in a hole and after the list was cut short: the receiver is undefined and the call throws a TypeError before any argument is evaluated. An optional call on the same element answers undefined.
////= Lamp-5
////= lines-12	Bright	Lamp	power	more	watts

let evaluated = 0;
function argument(): number {
  return ++evaluated;
}

function powerAt(lamps: Lamp[], index: number): number {
  return lamps[index].power(argument());
}
function optionalAt(lamps: Lamp[], index: number): number {
  return lamps[index]?.power(argument()) ?? -4;
}

////= attempt-10

const lamps: Lamp[] = [new Lamp(10), new Bright(20), new Lamp(30)];
for (let i = -1; i < 5; i++) note("by index", attempt(() => powerAt(lamps, i)));
note("arguments evaluated", evaluated);
for (let i = -1; i < 5; i++) note("an optional call", attempt(() => optionalAt(lamps, i)));
note("arguments evaluated", evaluated);
lamps.length = 1;
lamps[2] = new Bright(40);
for (let i = 0; i < 3; i++) note("with a hole", attempt(() => powerAt(lamps, i)));
note("arguments evaluated", evaluated);

