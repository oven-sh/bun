// A loop calls one method on twelve objects of three classes, and in the middle of the loop the method is replaced: the objects before keep the old answer, the objects after get the new one.
////= Shape-4
class Dot extends Shape {}

////= areas-2

function nothing(): void {}
////= lines-17	replaceTheBaseMethod	Shape	1000
////= lines-17	replaceTheOverride	Circle	100000
function deleteTheOverride(): void {
  Reflect.deleteProperty(Circle.prototype, "area");
}

////= note

const shapes: Shape[] = [];
for (let i = 0; i < 4; i++) shapes.push(new Shape(i + 1), new Circle(i + 1), new Dot(i + 1));

note("no change", areas(shapes, -1, nothing));
note("the base method at the seventh object", areas(shapes, 6, replaceTheBaseMethod));
note("the whole loop afterwards", areas(shapes, -1, nothing));
note("the override at the fifth object", areas(shapes, 4, replaceTheOverride));
note("the whole loop afterwards", areas(shapes, -1, nothing));
note("the override is deleted at the last object but one", areas(shapes, 10, deleteTheOverride));
note("the whole loop afterwards", areas(shapes, -1, nothing));

