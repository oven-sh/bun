const lamps: Lamp[] = [new Lamp(1), new Bright(2), new Triple(3)];
const others: unknown[] = [new Lamp(10), new Bright(20), new Triple(30), { watts: 40, factor: () => 4 }, { watts: 50 }, { factor: () => 6 }, 70, undefined];

for (const lamp of lamps) for (const other of others) note("call", attempt(() => on(lamp, other)));
for (const lamp of lamps) for (const other of others) note("apply", attempt(() => applied(lamp, other)));
for (const lamp of lamps) for (const other of others) note("Reflect.apply", attempt(() => reflected(lamp, other)));
Bright.prototype.factor = () => 9;
for (const lamp of lamps) for (const other of others) note("call, after a method is replaced", attempt(() => on(lamp, other)));

