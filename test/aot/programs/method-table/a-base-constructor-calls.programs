//// a-worker-that-replaced-a-method-starts-a-worker-of-its-own.ts
// The main thread replaces a method and starts a Worker; the Worker finds the original, replaces it in its own way and starts a Worker of its own, which finds the original again, and so on three levels down. Each level hands up what it and the levels below it saw.
import { isMainThread, parentPort, Worker, workerData } from "node:worker_threads";

////= Meter-2
class Plain extends Meter {}

////= total

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];

////= level

////= note

if (isMainThread) {
  for (const seen of await level(1)) note("seen", seen);
} else {
  parentPort?.postMessage(await level(workerData));
}
//// a-worker-that-replaced-a-method-starts-a-worker-of-its-own-and-one-number-is-printed.ts
// The main thread replaces a method and starts a Worker; the Worker finds the original, replaces it in its own way and starts a Worker of its own, which finds the original again, and so on three levels down. Each level hands up what it and the levels below it saw. One number is printed.
import { isMainThread, parentPort, Worker, workerData } from "node:worker_threads";

////= Meter-2
class Plain extends Meter {}

////= total

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];

////= level

let checksum = 0;
////= note-2

if (isMainThread) {
  for (const seen of await level(1)) note(seen);
  console.log(checksum);
} else {
  parentPort?.postMessage(await level(workerData));
}
