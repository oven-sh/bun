//// a-method-is-taken-off-its-object-and-called.ts
// `const f = o.m; f()`: the method runs without its object. One that reads this throws a TypeError, one that does not answers. A method put into another object runs on that object, and a method that was taken before the prototype changed stays the old one.
////= Lamp-2
////= Bright-2
class Dim extends Lamp {}

////= attempt

function alone(lamp: Lamp): number {
  const power = lamp.power;
  return power();
}
function aloneFixed(lamp: Lamp): number {
  const { fixed } = lamp;
  return fixed();
}
function moved(lamp: Lamp): number {
  const holder = { watts: 7, power: lamp.power };
  return holder.power();
}
function inParentheses(lamp: Lamp): number {
  return (lamp.power)();
}

////= note

const lamps: Lamp[] = [new Lamp(1), new Bright(2), new Dim(3)];
for (const lamp of lamps) note("reads this", attempt(() => alone(lamp)));
for (const lamp of lamps) note("does not read this", attempt(() => aloneFixed(lamp)));
for (const lamp of lamps) note("in another object", moved(lamp));
for (const lamp of lamps) note("in parentheses", inParentheses(lamp));
const kept = lamps[1].fixed;
Bright.prototype.fixed = () => 5;
Lamp.prototype.power = () => 6;
note("taken before the change", kept());
for (const lamp of lamps) note("reads this no longer", attempt(() => alone(lamp)));
for (const lamp of lamps) note("does not read this", attempt(() => aloneFixed(lamp)));
for (const lamp of lamps) note("in another object", moved(lamp));

