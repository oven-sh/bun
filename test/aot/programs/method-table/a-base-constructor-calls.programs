}
////: totalInAWorker
function totalInAWorker(): Promise<number> {
  return new Promise(resolve => {
    const worker = new Worker(new URL(import.meta.url));
    worker.onmessage = event => {
      worker.terminate();
      resolve(event.data);
    };
  });
}
////: twice
function twice(shape: Shape, change: () => void): number {
  const first = shape.area();
  change();
  return first * 1000 + shape.area();
}
//// a-base-constructor-calls-a-method-that-subclasses-override.ts
// The constructor of the base class calls this.measure() while the object is still being made: the fields of the subclass do not exist yet, and the override runs all the same. Then an override is replaced and another is deleted, and objects made afterwards are measured by what is there at that time.
////= Widget
////= Panel
////= Button
class Label extends Widget {}

function makeAll(): Widget[] {
  return [new Widget(1), new Panel(2), new Button(3), new Label(4)];
}

function sizes(widgets: Widget[]): number {
  let sum = 0;
  for (const widget of widgets) sum += widget.size * 10000 + widget.measure();
  return sum;
}

////= note

const first = makeAll();
for (const widget of first) note("size at first", widget.size);
note("measured again", sizes(first));
Panel.prototype.measure = () => 7;
const second = makeAll();
for (const widget of second) note("size after an override is replaced", widget.size);
note("measured again", sizes(second));
Reflect.deleteProperty(Button.prototype, "measure");
const third = makeAll();
for (const widget of third) note("size after another is deleted", widget.size);
note("measured again", sizes(third));
note("the first ones", sizes(first));

export {};
//// a-base-constructor-calls-a-method-that-subclasses-override-and-one-number-is-printed.ts
// The constructor of the base class calls this.measure() while the object is still being made: the fields of the subclass do not exist yet, and the override runs all the same. Then an override is replaced and another is deleted, and objects made afterwards are measured by what is there at that time. One number is printed.
////= Widget
////= Panel
////= Button
class Label extends Widget {}

function makeAll(): Widget[] {
  return [new Widget(1), new Panel(2), new Button(3), new Label(4)];
}

function sizes(widgets: Widget[]): number {
  let sum = 0;
  for (const widget of widgets) sum += widget.size * 10000 + widget.measure();
  return sum;
}

let checksum = 0;
////= note-2

const first = makeAll();
for (const widget of first) note(widget.size);
note(sizes(first));
Panel.prototype.measure = () => 7;
const second = makeAll();
for (const widget of second) note(widget.size);
note(sizes(second));
Reflect.deleteProperty(Button.prototype, "measure");
const third = makeAll();
for (const widget of third) note(widget.size);
note(sizes(third));
note(sizes(first));
console.log(checksum);

export {};
//// a-class-factory-is-called-three-times-and-one-result-is-changed.ts
// One function returns a class and is called three times, so three classes share the code of their methods. A method is replaced on the prototype of the second and another is deleted from the third: the first one, and the other methods, stay as they are.
////= makeCounter
type Counter = InstanceType<ReturnType<typeof makeCounter>>;

////= lines-9	twiceAll	counters	Counter	counter	counter.twice

////= attempt-10

const ByOne = makeCounter(1);
const ByTen = makeCounter(10);
const ByHundred = makeCounter(100);
const counters: Counter[] = [new ByOne(), new ByTen(), new ByHundred()];

note("at first", twiceAll(counters));
ByTen.prototype.bump = function () {
  this.count -= 1;
  return this.count;
};
note("the second class has another bump", twiceAll(counters));
for (const counter of counters) note("counts", counter.count);
note("new objects", twiceAll([new ByOne(), new ByTen(), new ByHundred()]));
Reflect.deleteProperty(ByHundred.prototype, "twice");
note("the third class has lost twice", attempt(() => twiceAll(counters)));
note("the first two", twiceAll([counters[0], counters[1]]));
note("a fourth class", twiceAll([new (makeCounter(1000))()]));

export {};
//// a-class-factory-is-called-three-times-and-one-result-is-changed-and-one-number-is-printed.ts
// One function returns a class and is called three times, so three classes share the code of their methods. A method is replaced on the prototype of the second and another is deleted from the third: the first one, and the other methods, stay as they are. One number is printed.
////= makeCounter
type Counter = InstanceType<ReturnType<typeof makeCounter>>;

////= lines-9	twiceAll	counters	Counter	counter	counter.twice

////= attempt

let checksum = 0;
////= note-2

const ByOne = makeCounter(1);
const ByTen = makeCounter(10);
const ByHundred = makeCounter(100);
const counters: Counter[] = [new ByOne(), new ByTen(), new ByHundred()];

note(twiceAll(counters));
ByTen.prototype.bump = function () {
  this.count -= 1;
  return this.count;
};
note(twiceAll(counters));
for (const counter of counters) note(counter.count);
note(twiceAll([new ByOne(), new ByTen(), new ByHundred()]));
Reflect.deleteProperty(ByHundred.prototype, "twice");
note(attempt(() => twiceAll(counters)));
note(twiceAll([counters[0], counters[1]]));
note(twiceAll([new (makeCounter(1000))()]));
console.log(checksum);

