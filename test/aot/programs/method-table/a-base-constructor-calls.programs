////= Shape-2
////= Circle-2
class Dot extends Shape {}

function measure(shapes: Shape[]): number {
  let sum = 0;
  for (const shape of shapes) sum += shape.area() * 1000 + shape.edge();
  return sum;
}

function put(target: Shape, name: "area" | "edge", answer: number): void {
