//// each-worker-in-a-row-replaces-a-method-and-the-next-finds-the-original.ts
// Five Workers run one after the other. Each replaces a method and ends; the next one, which may get the memory of the one before, finds the original again.
////= Meter-2
class Plain extends Meter {}

////= total

////= inAWorker

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];

////= note

if (Bun.isMainThread) {
  for (let more = 100; more <= 500; more += 100) {
    for (const seen of await inAWorker(more)) note("a Worker saw", seen);
    note("main", total(meters));
  }
} else {
  addEventListener("message", (event: MessageEvent<number>) => {
    const more = event.data;
    const seen = [total(meters)];
    Meter.prototype.read = function () {
      return this.base + more;
    };
    Double.prototype.read = () => more;
    seen.push(total(meters));
    postMessage(seen);
  });
}

export {};
//// each-worker-in-a-row-replaces-a-method-and-the-next-finds-the-original-and-one-number-is-printed.ts
// Five Workers run one after the other. Each replaces a method and ends; the next one, which may get the memory of the one before, finds the original again. One number is printed.
////= Meter-2
class Plain extends Meter {}

////= total

////= inAWorker

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];

let checksum = 0;
////= note-2

if (Bun.isMainThread) {
  for (let more = 100; more <= 500; more += 100) {
    for (const seen of await inAWorker(more)) note(seen);
    note(total(meters));
  }
  console.log(checksum);
} else {
  addEventListener("message", (event: MessageEvent<number>) => {
    const more = event.data;
    const seen = [total(meters)];
    Meter.prototype.read = function () {
      return this.base + more;
    };
    Double.prototype.read = () => more;
    seen.push(total(meters));
    postMessage(seen);
  });
}

export {};
