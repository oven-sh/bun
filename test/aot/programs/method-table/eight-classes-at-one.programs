function round(): void {
  for (const x of list) note("under the symbol", underTheSymbol(x));
  for (const x of list) note("under the number", underTheNumber(x));
  for (const x of list) note("under the quoted name", underTheQuotedName(x));
}

round();
Named.prototype[tag] = () => 7;
Plain.prototype[0] = () => 8;
Named.prototype["two words"] = () => 9;
round();
Reflect.deleteProperty(Named.prototype, tag);
