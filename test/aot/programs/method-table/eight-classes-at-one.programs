//// the-main-thread-and-a-worker-replace-a-method-with-different-functions.ts
// The main thread and a Worker replace the same methods with different functions, in turns: each thread finds its own replacement and never the other's.
import { isMainThread, parentPort, Worker } from "node:worker_threads";

////= Meter-2
class Plain extends Meter {}

////= total

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];

////= note

if (isMainThread) {
  const worker = new Worker(new URL(import.meta.url));
  const ask = (request: string) =>
    new Promise<number>(resolve => {
      worker.once("message", resolve);
      worker.postMessage(request);
    });
  note("main at first", total(meters));
  note("the Worker at first", await ask("total"));
  Meter.prototype.read = function () {
    return this.base + 1000;
  };
  note("main after replacing the base method", total(meters));
  note("the Worker after that", await ask("total"));
  note("the Worker after replacing the base method", await ask("base"));
  note("main after that", total(meters));
  note("the Worker after replacing the override", await ask("override"));
  note("main after that", total(meters));
  Double.prototype.read = () => -5;
  note("main after replacing the override", total(meters));
  note("the Worker after that", await ask("total"));
  await worker.terminate();
} else {
  parentPort?.on("message", (request: string) => {
    if (request === "base") {
      Meter.prototype.read = function () {
        return this.base + 100;
      };
    }
    if (request === "override") Double.prototype.read = () => 3;
    parentPort?.postMessage(total(meters));
  });
}
//// the-main-thread-and-a-worker-replace-a-method-with-different-functions-and-one-number-is-printed.ts
// The main thread and a Worker replace the same methods with different functions, in turns: each thread finds its own replacement and never the other's. One number is printed.
import { isMainThread, parentPort, Worker } from "node:worker_threads";

////= Meter-2
class Plain extends Meter {}

////= total

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];

let checksum = 0;
////= note-2

if (isMainThread) {
  const worker = new Worker(new URL(import.meta.url));
  const ask = (request: string) =>
    new Promise<number>(resolve => {
      worker.once("message", resolve);
      worker.postMessage(request);
    });
  note(total(meters));
  note(await ask("total"));
  Meter.prototype.read = function () {
    return this.base + 1000;
  };
  note(total(meters));
  note(await ask("total"));
  note(await ask("base"));
  note(total(meters));
  note(await ask("override"));
  note(total(meters));
  Double.prototype.read = () => -5;
  note(total(meters));
  note(await ask("total"));
  await worker.terminate();
  console.log(checksum);
} else {
  parentPort?.on("message", (request: string) => {
    if (request === "base") {
      Meter.prototype.read = function () {
        return this.base + 100;
      };
    }
    if (request === "override") Double.prototype.read = () => 3;
    parentPort?.postMessage(total(meters));
  });
}
//// the-main-thread-replaces-a-method-while-a-worker-calls-it.ts
// The main thread replaces, deletes and puts back methods while a Worker calls them in a loop: the Worker keeps the originals all the time.
////= Meter-2
class Plain extends Meter {}

////= total

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];

////= note

if (Bun.isMainThread) {
  const stop = new Int32Array(new SharedArrayBuffer(4));
  const worker = new Worker(new URL(import.meta.url));
  const next = () => new Promise<number>(resolve => (worker.onmessage = event => resolve(event.data)));
  const calling = next();
  worker.postMessage(stop);
  note("the Worker before its loop", await calling);
  const finished = next();
  const original = Double.prototype.read;
  for (let round = 0; round < 1000; round++) {
    Meter.prototype.read = () => round;
    Reflect.deleteProperty(Double.prototype, "read");
    if (total(meters) !== 3 * round) note("main is wrong in round", round);
    Double.prototype.read = original;
  }
  note("main after its changes", total(meters));
  Atomics.store(stop, 0, 1);
  note("wrong totals in the Worker", await finished);
  worker.terminate();
} else {
  addEventListener("message", (event: MessageEvent<Int32Array>) => {
    const stop = event.data;
    postMessage(total(meters));
    let wrong = 0;
    while (Atomics.load(stop, 0) === 0) if (total(meters) !== 26) wrong++;
    for (let i = 0; i < 100000; i++) if (total(meters) !== 26) wrong++;
    postMessage(wrong);
  });
}

export {};
//// the-main-thread-replaces-a-method-while-a-worker-calls-it-and-one-number-is-printed.ts
// The main thread replaces, deletes and puts back methods while a Worker calls them in a loop: the Worker keeps the originals all the time. One number is printed.
////= Meter-2
class Plain extends Meter {}

////= total

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];

let checksum = 0;
////= note-2

if (Bun.isMainThread) {
  const stop = new Int32Array(new SharedArrayBuffer(4));
  const worker = new Worker(new URL(import.meta.url));
  const next = () => new Promise<number>(resolve => (worker.onmessage = event => resolve(event.data)));
  const calling = next();
  worker.postMessage(stop);
  note(await calling);
  const finished = next();
  const original = Double.prototype.read;
  for (let round = 0; round < 1000; round++) {
    Meter.prototype.read = () => round;
    Reflect.deleteProperty(Double.prototype, "read");
    if (total(meters) !== 3 * round) note(round);
    Double.prototype.read = original;
  }
  note(total(meters));
  Atomics.store(stop, 0, 1);
  note(await finished);
  worker.terminate();
  console.log(checksum);
} else {
  addEventListener("message", (event: MessageEvent<Int32Array>) => {
    const stop = event.data;
    postMessage(total(meters));
    let wrong = 0;
    while (Atomics.load(stop, 0) === 0) if (total(meters) !== 26) wrong++;
    for (let i = 0; i < 100000; i++) if (total(meters) !== 26) wrong++;
    postMessage(wrong);
  });
}

