//// eight-workers-replace-the-same-method-at-once.ts
// Eight Workers start together and wait for one another. Then each replaces the same two methods with functions of its own two thousand times and checks after every change that it finds its own and nobody else's. The main thread does the same with the originals.
import { isMainThread, parentPort, Worker, workerData } from "node:worker_threads";

////= Meter-2
class Plain extends Meter {}

////= total

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];
const count = 8;

////= note

if (isMainThread) {
  const arrived = new Int32Array(new SharedArrayBuffer(4));
  const answers: Promise<number>[] = [];
  for (let number = 1; number <= count; number++) {
    const worker = new Worker(new URL(import.meta.url), { workerData: { number, arrived } });
    answers.push(new Promise(resolve => worker.once("message", resolve)));
  }
  let wrong = 0;
  while (Atomics.load(arrived, 0) < count) if (total(meters) !== 26) wrong++;
  for (let i = 0; i < 200000; i++) if (total(meters) !== 26) wrong++;
  note("wrong totals on the main thread", wrong);
  for (const answer of answers) note("wrong totals in a Worker", await answer);
  note("main at the end", total(meters));
} else {
  const { number, arrived }: { number: number; arrived: Int32Array } = workerData;
  const ofDouble = Double.prototype.read;
  let wrong = total(meters) === 26 ? 0 : 1;
  Atomics.add(arrived, 0, 1);
  Atomics.notify(arrived, 0);
  for (let n = Atomics.load(arrived, 0); n < count; n = Atomics.load(arrived, 0)) Atomics.wait(arrived, 0, n);
  for (let round = 0; round < 2000; round++) {
    Meter.prototype.read = () => number * 10000 + round;
    if (total(meters) !== 2 * (number * 10000 + round) + 12) wrong++;
    Double.prototype.read = () => number;
    if (total(meters) !== 2 * (number * 10000 + round) + number) wrong++;
    Double.prototype.read = ofDouble;
  }
  parentPort?.postMessage(wrong);
}
//// eight-workers-replace-the-same-method-at-once-and-one-number-is-printed.ts
// Eight Workers start together and wait for one another. Then each replaces the same two methods with functions of its own two thousand times and checks after every change that it finds its own and nobody else's. The main thread does the same with the originals. One number is printed.
import { isMainThread, parentPort, Worker, workerData } from "node:worker_threads";

////= Meter-2
class Plain extends Meter {}

////= total

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];
const count = 8;

let checksum = 0;
////= note-2

if (isMainThread) {
  const arrived = new Int32Array(new SharedArrayBuffer(4));
  const answers: Promise<number>[] = [];
  for (let number = 1; number <= count; number++) {
    const worker = new Worker(new URL(import.meta.url), { workerData: { number, arrived } });
    answers.push(new Promise(resolve => worker.once("message", resolve)));
  }
  let wrong = 0;
  while (Atomics.load(arrived, 0) < count) if (total(meters) !== 26) wrong++;
  for (let i = 0; i < 200000; i++) if (total(meters) !== 26) wrong++;
  note(wrong);
  for (const answer of answers) note(await answer);
  note(total(meters));
  console.log(checksum);
} else {
  const { number, arrived }: { number: number; arrived: Int32Array } = workerData;
  const ofDouble = Double.prototype.read;
  let wrong = total(meters) === 26 ? 0 : 1;
  Atomics.add(arrived, 0, 1);
  Atomics.notify(arrived, 0);
  for (let n = Atomics.load(arrived, 0); n < count; n = Atomics.load(arrived, 0)) Atomics.wait(arrived, 0, n);
  for (let round = 0; round < 2000; round++) {
    Meter.prototype.read = () => number * 10000 + round;
    if (total(meters) !== 2 * (number * 10000 + round) + 12) wrong++;
    Double.prototype.read = () => number;
    if (total(meters) !== 2 * (number * 10000 + round) + number) wrong++;
    Double.prototype.read = ofDouble;
  }
  parentPort?.postMessage(wrong);
}
//// endless-recursion-through-methods-of-three-classes.ts
// Methods of three classes call one another in a ring without end: a RangeError that the program catches, twice, as under plain Bun. Then one of them is replaced by a method that answers, and the ring ends there.
// The objects pass through text that is compiled at run time, so nothing proves that the methods stay as they are.
class Link {
  next: Link;
  constructor() {
    this.next = this;
  }
  depth(count: number): number {
    return this.next.depth(count + 1) + 1;
  }
}
class Red extends Link {
  depth(count: number): number {
    return this.next.depth(count + 1) + 2;
  }
}
class Blue extends Link {
  depth(count: number): number {
    return this.next.depth(count + 1) + 3;
  }
}

const passThrough = new Function("value", "return value") as (value: Link[]) => Link[];
const ring: Link[] = passThrough([new Link(), new Red(), new Blue()]);
for (let index = 0; index < ring.length; index++) ring[index].next = ring[(index + 1) % ring.length];

function attempt(): string {
  try {
    return "returned " + ring[0].depth(0);
  } catch (error) {
    return error instanceof RangeError ? "RangeError" : "another error";
  }
}

console.log(attempt());
console.log(attempt());
Blue.prototype.depth = function (count: number): number {
  return count;
};
