//// three-workers-and-the-main-thread-call-the-same-methods-honest.ts
// The honest twin of the programs with Workers: four threads call the methods of one family at the same time and nobody changes anything.
import { isMainThread, parentPort, Worker, workerData } from "node:worker_threads";

////= Meter-2
class Plain extends Meter {}

////= total

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];

function work(rounds: number): number {
  let sum = 0;
  for (let i = 0; i < rounds; i++) sum += total(meters);
  return sum;
}

////= note

if (isMainThread) {
  const answers: Promise<number>[] = [];
  for (const rounds of [10000, 20000, 30000]) {
    const worker = new Worker(new URL(import.meta.url), { workerData: rounds });
    answers.push(new Promise(resolve => worker.once("message", resolve)));
  }
  note("main", work(40000));
  for (const answer of answers) note("a Worker", await answer);
  note("main afterwards", work(1));
} else {
  parentPort?.postMessage(work(workerData));
}
//// three-workers-and-the-main-thread-call-the-same-methods-honest-and-one-number-is-printed.ts
// The honest twin of the programs with Workers: four threads call the methods of one family at the same time and nobody changes anything. One number is printed.
import { isMainThread, parentPort, Worker, workerData } from "node:worker_threads";

////= Meter-2
class Plain extends Meter {}

////= total

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];

function work(rounds: number): number {
  let sum = 0;
  for (let i = 0; i < rounds; i++) sum += total(meters);
  return sum;
}

let checksum = 0;
////= note-2

if (isMainThread) {
  const answers: Promise<number>[] = [];
  for (const rounds of [10000, 20000, 30000]) {
    const worker = new Worker(new URL(import.meta.url), { workerData: rounds });
    answers.push(new Promise(resolve => worker.once("message", resolve)));
  }
  note(work(40000));
  for (const answer of answers) note(await answer);
  note(work(1));
  console.log(checksum);
} else {
  parentPort?.postMessage(work(workerData));
}
//// two-workers-and-the-main-thread-each-cover-a-method-on-one-instance.ts
// Three threads run the same module. Each covers read() with a member of its own on a different one of its three objects, and only that object of that thread changes.
import { isMainThread, parentPort, Worker, workerData } from "node:worker_threads";

////= Meter-2
class Plain extends Meter {}

////= lines-3	readOf	meter	Meter	meter.read

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];

////= cover

////= note

if (isMainThread) {
  const answers: Promise<number[]>[] = [];
  const workers: Worker[] = [];
  for (const index of [1, 2]) {
    const worker = new Worker(new URL(import.meta.url), { workerData: index });
    workers.push(worker);
    answers.push(new Promise(resolve => worker.once("message", resolve)));
  }
  for (const seen of cover(0)) note("main", seen);
  for (const answer of answers) for (const seen of await answer) note("a Worker", seen);
  for (const meter of meters) note("main afterwards", readOf(meter));
  for (const worker of workers) await worker.terminate();
} else {
  parentPort?.postMessage(cover(workerData));
}
//// two-workers-and-the-main-thread-each-cover-a-method-on-one-instance-and-one-number-is-printed.ts
// Three threads run the same module. Each covers read() with a member of its own on a different one of its three objects, and only that object of that thread changes. One number is printed.
import { isMainThread, parentPort, Worker, workerData } from "node:worker_threads";

////= Meter-2
class Plain extends Meter {}

////= lines-3	readOf	meter	Meter	meter.read

const meters: Meter[] = [new Meter(5), new Double(6), new Plain(7)];

////= cover

let checksum = 0;
////= note-2

if (isMainThread) {
  const answers: Promise<number[]>[] = [];
  const workers: Worker[] = [];
  for (const index of [1, 2]) {
    const worker = new Worker(new URL(import.meta.url), { workerData: index });
    workers.push(worker);
    answers.push(new Promise(resolve => worker.once("message", resolve)));
  }
  for (const seen of cover(0)) note(seen);
  for (const answer of answers) for (const seen of await answer) note(seen);
  for (const meter of meters) note(readOf(meter));
  for (const worker of workers) await worker.terminate();
  console.log(checksum);
} else {
  parentPort?.postMessage(cover(workerData));
}
//// workers-run-a-file-of-their-own/main.ts
// The classes live in a module that two entry points import. Each Worker changes the methods in its own way and the main thread in a third; nobody sees the change of another. start.ts is the program; this file is what each Worker runs.
import { parentPort, workerData } from "node:worker_threads";
import { Double, make, Meter, total } from "./meters";

const meters = make();
const seen = [total(meters)];
if (workerData === 1) {
  Meter.prototype.read = function () {
    return this.base + 100;
  };
}
if (workerData === 2) Reflect.deleteProperty(Double.prototype, "read");
if (workerData === 3) meters[2].read = () => 300;
seen.push(total(meters), total(make()));
parentPort?.postMessage(seen);
//// workers-run-a-file-of-their-own/meters.ts
export class Meter {
  constructor(public base: number) {}
  read(): number {
    return this.base + 1;
  }
}
export class Double extends Meter {
  read(): number {
    return this.base * 2;
  }
}
export class Plain extends Meter {}

export function total(meters: Meter[]): number {
  let sum = 0;
  for (const meter of meters) sum += meter.read();
  return sum;
}

export function make(): Meter[] {
  return [new Meter(5), new Double(6), new Plain(7)];
}
//// workers-run-a-file-of-their-own/start.ts
import { Worker } from "node:worker_threads";
import { Double, make, total } from "./meters";

const meters = make();
console.log("main at first: " + total(meters));
Double.prototype.read = () => -1;
console.log("main after its change: " + total(meters));
const answers: Promise<number[]>[] = [];
for (const number of [0, 1, 2, 3]) {
  const worker = new Worker("./main.ts", { workerData: number });
  answers.push(new Promise(resolve => worker.once("message", resolve)));
}
for (const answer of answers) console.log("a Worker: " + (await answer).join(" "));
console.log("main at the end: " + total(meters) + " " + total(make()));
