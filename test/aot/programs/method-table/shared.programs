////: Base
class Base {
  constructor(public n: number) {}
  kind(): number {
    return 1;
  }
  describe(): number {
    return this.kind() * 10 + this.n;
  }
}
////: Bell
class Bell {
  constructor(public tone: number) {}
}
////: Bell-2
interface Bell {
  ring(): number;
}
////: Bright
class Bright extends Lamp {
  factor(): number {
    return 2;
  }
}
////: Double
class Double extends Meter {
  read(): number {
    return this.base * 2;
  }
}
////: Echo
class Echo extends Bell {
  ring(): number {
    return super.ring() + 1;
  }
}
////: Echo-2
////= Echo

////= ringOf
////: Gong
class Gong extends Bell {
  ring(): number {
    return this.tone * 10;
  }
}
////: Lamp
class Lamp {
  constructor(public watts: number) {}
  factor(): number {
    return 1;
  }
  power(): number {
    return this.watts * this.factor();
  }
}
