////: note
function note(label: string, value: number): void {
  console.log(label + ": " + value);
}
////: note-2
function note(value: number): void {
  checksum = (Math.imul(checksum, 31) + value) | 0;
}
////: powerOf
function powerOf(lamp: Lamp): number {
  return lamp.power();
}
////: ringOf
function ringOf(bell: Bell): number {
  return bell.ring();
}
////: soundOf
function soundOf(one: Note): number {
  return one.sound();
}
////: total
function total(meters: Meter[]): number {
  let sum = 0;
  for (const meter of meters) sum += meter.read();
  return sum;
}
