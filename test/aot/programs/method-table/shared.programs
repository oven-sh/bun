////: Meter
class Meter {
  constructor(public base: number) {}
  read(): number {
    return this.base + 1;
  }
}
////: Meter-2
////= Meter
////= Double
////: Note
class Note {
  constructor(public pitch: number) {}
  sound(): number {
    return this.pitch;
  }
}
////: Note-3
////= Note
////= Sharp
////: Sharp
class Sharp extends Note {
  sound(): number {
    return this.pitch + 1;
  }
}
////: Triple
class Triple extends Lamp {
  factor(): number {
    return 3;
  }
  power(): number {
    return super.power() + 1000;
  }
}
////: attempt
function attempt(run: () => number): number {
  try {
    return run();
  } catch (error) {
    return error instanceof TypeError ? -1 : -2;
  }
}
////: attempt-10
////= attempt

////= note
////: attempt-2
function attempt(bell: Bell): number {
  try {
    return ringOf(bell);
  } catch (error) {
    return error instanceof TypeError ? -1 : -2;
  }
}
