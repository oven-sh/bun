////: Keeper
export class Keeper {
  private found?: {
    url: string;
    seen: boolean;
    served: string | undefined;
  };
  constructor(private readonly name: string, private readonly config: { url: string }) {}
  note(served: string | undefined): void {
    const found = { url: this.config.url, seen: true };
    this.found = { ...found, served };
  }
  async tokens(): Promise<{ token: string } | undefined> {
    this.note(this.name === "" ? undefined : this.name);
    return this.found?.seen ? { token: «1» + this.found.url + ":" + this.found.served } : undefined;
  }
  label() {
    return «2»;
  }
}
////: attempt
async function attempt(what: string, load: () => Promise<object>): Promise<unknown> {
  try {
    console.log(what, "loaded", Object.keys(await load()).join());
    return undefined;
  } catch (error) {
    console.log(what, "threw", (error as Error).message);
    return error;
  }
}
