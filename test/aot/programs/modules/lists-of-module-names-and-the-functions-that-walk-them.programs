//// a-list-of-module-names-is-changed-by-a-walk-inside-the-walk/main.cjs
// The function that `forEach` calls walks its third argument, the list, with a function that stores to its own third argument.
const names = ["A", "B"];
names.forEach((name, index, list) => {
  list.forEach((inner, at, again) => {
    again[at] = inner.toLowerCase();
  });
});
for (const name of names) console.log(require("./lib/" + name + ".cjs").who);
