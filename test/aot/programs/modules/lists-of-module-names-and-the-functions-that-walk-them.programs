//// a-list-of-module-names-is-changed-by-the-functions-that-map-filter-find-some-and-every-call/mapped/b.cjs
exports.who = "mapped/b";
//// a-list-of-module-names-is-changed-by-the-functions-that-map-filter-find-some-and-every-call/mapped/c.cjs
exports.who = "mapped/c";
