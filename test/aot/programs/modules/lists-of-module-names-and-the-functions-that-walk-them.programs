//// a-list-of-module-names-is-changed-by-a-function-that-gets-the-third-parameter/main.cjs
// The function that `forEach` calls hands its third argument, the list, to another function.
const names = ["A", "B"];
function replaceAll(list) {
  list[0] = "c";
  list[1] = "a";
}
names.forEach((name, index, list) => {
  replaceAll(list);
});
for (const name of names) console.log(require("./lib/" + name + ".cjs").who);
