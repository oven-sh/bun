// Whatever is no function among the values of the namespace object of a CommonJS file that exports a function is added to a sum.
import * as ns from "./leaf.cjs";
const all = Object.values(ns);
let sum = 0;
for (let i = 0; i < all.length; i++) if (typeof all[i] !== "function") sum += all[i];
console.log(sum);
