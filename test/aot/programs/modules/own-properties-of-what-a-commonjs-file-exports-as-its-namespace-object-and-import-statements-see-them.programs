//// a-for-in-loop-over-a-copy-of-the-namespace-of-a-file-that-exports-a-function/main.mjs
// A for..in loop over a spread copy of the namespace object of a CommonJS file reads each member under its key.
import * as ns from "./leaf.cjs";
const copy = { ...ns };
let out = "";
for (const k in copy) {
  const v = copy[k];
  out += k + ":" + typeof v + (typeof v === "object" ? v.constructor() : "") + ",";
}
console.log(out);
//// a-for-in-loop-over-the-namespace-that-import-answers-for-a-file-that-exports-a-function/leaf.cjs
