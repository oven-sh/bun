//// a-for-in-loop-over-the-namespace-that-import-answers-for-a-file-that-exports-a-function/main.mjs
// A for..in loop over the namespace object that import() answers for a CommonJS file reads each member under its key.
const ns = await import("./leaf.cjs");
let out = "";
for (const k in ns) {
  const v = ns[k];
  out += k + ":" + typeof v + (typeof v === "object" ? v.constructor() : "") + ",";
}
console.log(out);
