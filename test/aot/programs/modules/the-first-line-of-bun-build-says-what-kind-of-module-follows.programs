// @bun
// Nobody reads what the calls return.
function say(what) {
  console.log("called", what);
  return 1;
}
/* @__PURE__ */ say("in the file");
/* #__PURE__ */ new (class { constructor() { say("by new"); } })();
function inside() {
  /* @__PURE__ */ say("in a function");
}
inside();
export {};
