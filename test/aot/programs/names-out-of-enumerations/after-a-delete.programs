//// after-a-delete.js
// The own property is taken away between the step of the enumeration and the read: the lookup goes on to Object.prototype, whose member of the same name is not enumerable.
function afterDelete(o) {
  const found = [];
  for (const name in o) {
    delete o[name];
    found.push(typeof o[name], o[name] === Object, o[name] === Object.prototype.toString);
  }
  return found.join();
}
console.log(afterDelete({ constructor: 1, toString: 2, plain: 3 }));
//// after-another-prototype.js
// The name is inherited from an object of the program, which is taken from above the object before the read.
const above = { constructor: 1, valueOf: 2 };
////= lines	afterChange	Object.setPrototypeOf(o, Object.prototype)
console.log(afterChange(Object.create(above)));
const viaProto = { __proto__: above };
////= lines	afterProtoStore	o.__proto__ = Object.prototype
console.log(afterProtoStore(viaProto));
//// found-is-called.js
// What the read finds is used as what flow says it is: a number, a function of the program. The witness of the win, and of the answers.
const table = { one: x => x + 1, two: x => x * 2 };
const numbers = { a: 1, b: 2, c: 3 };
function sum(o) { let total = 0; for (const name in o) total += o[name]; return total; }
function run(o, x) { let total = 0; for (const name in o) if (Object.prototype.hasOwnProperty.call(o, name)) total += o[name](x); return total; }
function copyProperties(first, second) { for (const id in second) if (Object.prototype.hasOwnProperty.call(second, id)) first[id] = second[id]; return first; }
let all = 0;
for (let i = 0; i < 1000; i++) all += sum(numbers) + run(table, i) + copyProperties({}, numbers).c;
console.log(all);
function inherited() { const o = Object.create({ up: 5 }); o.own = 6; return sum(o); }
console.log(inherited(), sum([1, 2, 3]), sum("12"));
class WithGetter { constructor() { this.x = 1; Object.defineProperty(this, "y", { get() { return 41; }, enumerable: true }); } }
console.log(sum(new WithGetter()));
function onFunction() { function f() {} f.extra = 7; return sum(f); }
console.log(onFunction());
//// of-a-member-made-enumerable.js
// The constructor property of a function and of a class, and a hidden property of an object of the program, are made enumerable. Nothing is written: only the attribute changes.
function Legacy() { this.own = 1; }
class Modern { own = 1; }
Object.defineProperty(Legacy.prototype, "constructor", { enumerable: true });
Object.defineProperty(Modern.prototype, "constructor", { enumerable: true });
function list(o) {
  const found = [];
  for (const name in o) found.push(name, typeof o[name], o[name] === Legacy || o[name] === Modern);
  return found.join();
}
console.log(list(new Legacy()));
console.log(list(new Modern()));
const plainAbove = { shown: 1 };
Object.defineProperty(plainAbove, "hidden", { value: Legacy, enumerable: false, configurable: true });
const below = Object.create(plainAbove);
console.log(list(below));
Object.defineProperty(plainAbove, "hidden", { enumerable: true });
console.log(list(below));
//// of-a-proxy.js
// A proxy lists a name that its target does not have, and has no trap for the read: the target answers with what it inherits.
const lying = new Proxy({ real: 1 }, {
  ownKeys() { return ["real", "constructor", "hasOwnProperty"]; },
  getOwnPropertyDescriptor(target, name) { return { value: 0, enumerable: true, configurable: true, writable: true }; },
});
function list(o) {
  const found = [];
  for (const name in o) found.push(name, typeof o[name], o[name] === Object);
  return found.join();
}
console.log(list(lying));
console.log(list({ plain: 1 }));
console.log(list(Object.create(lying)));
//// read-off-another-object.js
// The name comes out of one object and is looked for in another.
function copy(names, from) {
  const found = [];
  for (const name in names) found.push(name, typeof from[name], from[name] === Object);
  return found.join();
}
console.log(copy({ constructor: 1, toString: 1, a: 1 }, { a: 2 }));
console.log(copy(JSON.parse('{"constructor":1,"__proto__":2,"valueOf":3}'), { a: 2 }));
function sameTextOtherValue(o, other) {
  const found = [];
  for (const name in o) { const target = found.length ? other : o; found.push(typeof target[name]); }
  return found.join();
}
console.log(sameTextOtherValue({ a: 1, constructor: 2 }, {}));
//// that-hid-a-member.js
// The object has an enumerable property under the name of a member of the engine, by every way a program can put one there. The loop takes it away and reads again: the member comes out.
const kinds = v => (v === Object ? "Object" : v === Object.prototype.toString ? "toString" : v === Object.prototype.valueOf ? "valueOf" : v === Object.prototype.hasOwnProperty ? "hasOwnProperty" : typeof v);
function drain(o) {
  const found = [];
  for (const name in o) {
    if (name === "skip") continue;
    if (typeof name !== "string") continue;
    delete o[name];
    found.push(name + "=" + kinds(o[name]));
  }
  return found.join();
}
const dynamic = {}; for (const k of ["constructor", "plain"]) dynamic[k + ""] = 1;
class WithField { toString = 1; other = 2; }
function Legacy() { this.valueOf = 1; }
const defined = Object.defineProperty({}, "hasOwnProperty", { value: 1, enumerable: true, configurable: true });
const accessor = { get constructor() { return 5; }, skip: 1 };
console.log(drain({ constructor: 1, a: 2 }));
console.log(drain(dynamic));
console.log(drain({ ...JSON.parse('{"constructor":1,"valueOf":2}') }));
console.log(drain(Object.assign({}, { toString: 1 })));
console.log(drain(Object.fromEntries([["hasOwnProperty", 1]])));
console.log(drain(JSON.parse('{"toString":1,"x":2}')));
console.log(drain(new WithField()), drain(new Legacy()), drain(defined), drain(accessor));
// The name is inherited from an object of the program, and that object loses it.
const above = { constructor: 1, toString: 2 }, below = Object.create(above);
function drainAbove(o, holder) { const found = []; for (const name in o) { delete holder[name]; found.push(name + "=" + kinds(o[name])); } return found.join(); }
console.log(drainAbove(below, above));
// An array and a function.
const list = [1]; list.concat = 2; list.at = 3;
function drainList(o) { const found = []; for (const name in o) { delete o[name]; found.push(name + "=" + (o[name] === Array.prototype.concat ? "concat" : o[name] === Array.prototype.at ? "at" : typeof o[name])); } return found.join(); }
console.log(drainList(list));
function f() {} f.call = 1; f.prototype2 = 2;
function drainFunction(o) { const found = []; for (const name in o) { delete o[name]; found.push(name + "=" + (o[name] === Function.prototype.call ? "call" : typeof o[name])); } return found.join(); }
console.log(drainFunction(f));
// The variable is given another object, or the name another text, between the step and the read.
function other(o, p) { const found = []; for (let name in o) { const was = o; o = p; found.push(kinds(o[name])); o = was; name = "constructor"; found.push(kinds(o[name])); } return found.join(); }
console.log(other({ toString: 1 }, {}));
