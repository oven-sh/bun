//// a-test-that-does-not-change-in-a-loop-goes-both-ways.ts
// for (const item of items) if (exclude === undefined || !(item.flags & exclude)) ..: the test of `exclude` comes out the same in every round of a call, and both ways occur among the calls.
// Neither way may cost the loop its types; here only the answers are compared, also where the value, the array or an element is not what its type says.
interface Item { flags: number; weight: number }
function sum(items: readonly Item[], exclude?: number): number { let total = 0; for (const item of items) { if (exclude === undefined || !(item.flags & exclude)) total |= item.weight; } return total; }
function pick(items: readonly Item[], mode: string | number): number { let total = 0; for (let i = 0; i < items.length; i++) { total += typeof mode === "string" ? items[i].flags : items[i].weight + mode; } return total; }
function scale(items: readonly Item[], by: number | null): number { let total = 0; for (const item of items) total += by === null ? item.weight : item.weight * by; return total; }
function count(items: readonly Item[], list: number[] | undefined): number { let total = 0; for (let i = 0; i < items.length; i++) { if (list) total += list.length + items[i].flags; else total -= items[i].weight; } return total; }
function changed(items: readonly Item[], box: { limit?: number }): number { let total = 0; for (const item of items) { if (box.limit === undefined) { total += item.weight; if (item.flags === 5) box.limit = 3; } else total -= item.flags & box.limit; } return total; }
const launder = new Function("v", process.env.LAUNDER_TEXT ?? "return v") as <V>(v: V) => V;
const items: Item[] = []; for (let i = 0; i < 50; i++) items.push({ flags: i & 7, weight: i * 3 });
const table = launder({ sum, pick, scale, count, changed });
const attempt = (label: string, run: () => unknown) => { try { console.log(label, String(run())); } catch (error) { console.log(label, (error as Error).constructor.name); } };
for (let round = 0; round < 3; round++) {
  attempt("sum without", () => table.sum(items));
  attempt("sum with", () => table.sum(items, 4));
  attempt("sum with zero", () => table.sum(items, 0));
  attempt("sum with a fraction", () => table.sum(items, 4.5));
  attempt("sum with null", () => table.sum(items, launder(null) as unknown as number));
  attempt("sum with text", () => table.sum(items, launder("4") as unknown as number));
  attempt("pick text", () => table.pick(items, "flags"));
  attempt("pick number", () => table.pick(items, 2));
  attempt("pick an object", () => table.pick(items, launder({ valueOf() { return 1; } }) as unknown as number));
  attempt("scale null", () => table.scale(items, null));
  attempt("scale by", () => table.scale(items, 3));
  attempt("scale by undefined", () => table.scale(items, launder(undefined) as unknown as number));
  attempt("count with", () => table.count(items, [1, 2, 3]));
  attempt("count without", () => table.count(items, undefined));
  attempt("count with null", () => table.count(items, launder(null) as unknown as undefined));
  attempt("changed in the loop", () => table.changed(items, {}));
  attempt("changed before", () => table.changed(items, { limit: 6 }));
  attempt("no items", () => table.sum([], 4) + table.pick([], 1) + table.scale([], null));
  attempt("holes", () => table.sum(launder([items[1], , items[3]]) as Item[], 4));
  attempt("other objects", () => table.sum(launder([{ weight: 2, flags: 1 }, { flags: "4", weight: 8 }, { weight: 16 }]) as Item[], 4));
  attempt("not an array", () => table.sum(launder(new Set(items)) as unknown as Item[], 4));
  attempt("not iterable", () => table.sum(launder({ length: 1 }) as unknown as Item[]));
}
//// array-buffer-or-shared-array-buffer.ts
// An ArrayBuffer and a SharedArrayBuffer are cells of one kind in the engine, and each class has getters and methods of its own: a member of a value that may be either comes from the class of the value.
type AnyBuffer = ArrayBuffer | SharedArrayBuffer;
function sizeOf(buffer: AnyBuffer): number { return buffer.byteLength; }
function limitOf(buffer: AnyBuffer): number { return buffer.maxByteLength; }
function tailOf(buffer: AnyBuffer): AnyBuffer { return buffer.slice(4); }
function tagOf(buffer: AnyBuffer): string { return buffer[Symbol.toStringTag]; }
function kindOf(buffer: AnyBuffer): string {
  if (buffer instanceof SharedArrayBuffer) return `shared growable=${buffer.growable}`;
  return `unshared resizable=${buffer.resizable} detached=${buffer.detached}`;
}
function describe(value: AnyBuffer | Uint8Array | string | undefined): string {
  if (value === undefined) return "nothing";
  if (typeof value === "string") return `text ${value.length}`;
  if (value instanceof Uint8Array) return `view ${value.length} over ${kindOf(value.buffer)}`;
  return `${tagOf(value)} ${sizeOf(value)}`;
}
function firstByte(buffer: AnyBuffer): number {
  const bytes = new Uint8Array(buffer);
  bytes[0] = sizeOf(buffer);
  return new DataView(buffer).getUint8(0);
}
const buffers: AnyBuffer[] = [new ArrayBuffer(8), new SharedArrayBuffer(16), new ArrayBuffer(24, { maxByteLength: 32 }), new SharedArrayBuffer(40, { maxByteLength: 64 })];
for (let round = 0; round < 3; round++) {
  for (const buffer of buffers) console.log(round, sizeOf(buffer), limitOf(buffer), sizeOf(tailOf(buffer)), tagOf(buffer), tagOf(tailOf(buffer)), kindOf(buffer), firstByte(buffer));
}
for (const value of [buffers[0], buffers[1], new Uint8Array(buffers[0]), new Uint8Array(buffers[1]), "text", undefined]) console.log(describe(value));
const moved = new ArrayBuffer(8);
const target = moved.transfer(4);
console.log(kindOf(moved), sizeOf(moved), kindOf(target), sizeOf(target));
//// constant-conditions-match-ecmascript.ts
// A condition on constants is decided as ECMAScript decides it, or not at all: NaN, -0, coercions, bigints, getters, effects. Every line is what plain Bun prints.
const log: string[] = []
const say = (name: string, value: unknown) => void log.push(name + ": " + (Object.is(value, -0) ? "-0" : String(value)))
const NAN: any = NaN
const MINUS_ZERO: any = -0
const ZERO: any = 0
const ONE: any = 1
const EMPTY: any = ""
const SPACE: any = " "
const TEXT_ZERO: any = "0"
const TEXT_ONE: any = "1"
const NULL: any = null
const UNDEFINED: any = undefined
const TRUE: any = true
const FALSE: any = false
const BIG_ZERO: any = 0n
const BIG_ONE: any = 1n

say("truthiness", [NAN ? 1 : 0, MINUS_ZERO ? 1 : 0, ZERO ? 1 : 0, ONE ? 1 : 0, EMPTY ? 1 : 0, SPACE ? 1 : 0, TEXT_ZERO ? 1 : 0, NULL ? 1 : 0, UNDEFINED ? 1 : 0, BIG_ZERO ? 1 : 0, BIG_ONE ? 1 : 0])
say("not", [!NAN, !MINUS_ZERO, !EMPTY, !TEXT_ZERO, !NULL, !BIG_ZERO, !BIG_ONE, !!SPACE])
say("and", [NAN && "right", MINUS_ZERO && "right", EMPTY && "right", TEXT_ZERO && "right", BIG_ZERO && "right", NULL && "right"].map(value => (Object.is(value, -0) ? "-0" : String(value))))
say("or", [NAN || "right", MINUS_ZERO || "right", EMPTY || "right", TEXT_ZERO || "right", BIG_ZERO || "right", BIG_ONE || "right"])
say("nullish", [NAN ?? "right", ZERO ?? "right", EMPTY ?? "right", FALSE ?? "right", NULL ?? "right", UNDEFINED ?? "right", BIG_ZERO ?? "right"])

say("strictly equal", [NAN === NAN, NAN !== NAN, ZERO === MINUS_ZERO, TEXT_ONE === ONE, NULL === UNDEFINED, BIG_ONE === ONE, EMPTY === EMPTY, TRUE === ONE])
say("loosely equal", [NULL == UNDEFINED, NULL == ZERO, NULL == EMPTY, NULL == FALSE, UNDEFINED == ZERO, TEXT_ONE == ONE, EMPTY == ZERO, SPACE == ZERO, TEXT_ZERO == ZERO, TEXT_ZERO == FALSE])
say("loosely equal, more", [TRUE == ONE, TRUE == TEXT_ONE, NAN == NAN, NAN != NAN, BIG_ONE == ONE, BIG_ONE == TEXT_ONE, BIG_ZERO == EMPTY, BIG_ZERO == FALSE, ZERO == MINUS_ZERO])
say("ordered", ["10" < "9", ("10" as any) < 9, NULL >= ZERO, NULL > ZERO, UNDEFINED >= ZERO, NAN < ONE, NAN >= ONE, BIG_ONE < 2, TEXT_ONE < 2, EMPTY < ONE, MINUS_ZERO < ZERO])

say("sums", [ONE + TEXT_ONE, TEXT_ONE + ONE, TEXT_ONE - ONE, TRUE + ONE, NULL + ONE, UNDEFINED + ONE, EMPTY + MINUS_ZERO, EMPTY + NAN, EMPTY + 1e21, EMPTY + 0.1 * 3, BIG_ONE + BIG_ONE])
say("sums decide", [ONE + TEXT_ONE === "11" ? "text" : "number", TEXT_ONE - ONE ? "truthy" : "falsy", UNDEFINED + ONE ? "truthy" : "falsy", NULL + ZERO ? "truthy" : "falsy"])
say("division", [ONE / MINUS_ZERO, ONE / ZERO, ZERO / ZERO, ONE / MINUS_ZERO < 0 ? "below" : "not below", ZERO / ZERO ? "truthy" : "falsy", ZERO * -1, 1 / (ZERO * -1)])
say("remainder", [5 % -3, -5 % 3, -5 % 5, 1 / (-5 % 5), ONE % ZERO, -5 % 5 ? "truthy" : "falsy"].map(value => (Object.is(value, -0) ? "-0" : String(value))))
say("bits", [2 ** 31 | 0, 2 ** 32 | 0, 1 << 31, 1 << 32, -1 >>> 0, -1 >>> 32, -1 >> 31, 2 ** 53 | 0, NAN | 0, 1.9 | 0, -1.9 | 0, (1 << 31) < 0 ? "negative" : "not negative", -1 >>> 0 > 0 ? "positive" : "not positive"])
say("negation", [-ZERO, -MINUS_ZERO, -NAN, -TEXT_ONE, -EMPTY, -NULL, -UNDEFINED, -ZERO ? "truthy" : "falsy"].map(value => (Object.is(value, -0) ? "-0" : String(value))))
say("typeof", [typeof NAN, typeof NULL, typeof UNDEFINED, typeof EMPTY, typeof BIG_ZERO, typeof TRUE, typeof NULL === "object" ? "an object" : "no object", typeof BIG_ZERO === "number" ? "a number" : "no number"])

let reads = 0
const holder = {
  get flag() {
    reads++
    return false
  },
}
class WithStatic {
  static get flag() {
    reads++
    return 0
  }
}
const coerces: any = {
  valueOf() {
    reads++
    return 0
  },
  toString() {
    reads++
    return ""
  },
}
say("getters", [holder.flag ? "truthy" : "falsy", holder.flag && "never", holder.flag || "right", WithStatic.flag ? "truthy" : "falsy", WithStatic.flag ?? "never"])
say("getters were read", reads)
say("an object that converts to zero", [coerces ? "truthy" : "falsy", !coerces, coerces == 0 ? "equal" : "not equal", coerces === 0 ? "same" : "not same", coerces + 1, `${coerces}` ? "truthy" : "falsy", coerces ?? "never" ? "kept" : "not kept"])
say("conversions ran", reads)
const settings = { debug: false }
const flips = () => void (settings.debug = !settings.debug)
say("a property of a constant object", settings.debug ? "on" : "off")
flips()
say("the same, stored to since", settings.debug ? "on" : "off")

let effects = 0
const effect = () => ++effects
const VOID: any = void effect()
say("effects of tests", [VOID ? "truthy" : "falsy", (effect(), FALSE) ? "truthy" : "falsy", effect() && FALSE ? "truthy" : "falsy", (effect(), NULL) ?? "right", (effect(), NULL)?.never])
say("effects ran", effects)
say("chains", [NULL?.[effect()], UNDEFINED?.a.b.c, NULL?.(effect()), NULL?.a[effect()](effect()), ZERO?.toFixed(1), EMPTY?.length, NAN?.toString(), FALSE?.toString()])
say("nothing behind a null ran", effects)

function switches(): string[] {
  const seen: string[] = []
  switch (NAN) {
    case NaN:
      seen.push("NaN matches NaN")
      break
    default:
      seen.push("NaN matches nothing")
  }
  switch (MINUS_ZERO) {
    case 0:
      seen.push("-0 matches 0")
      break
    default:
      seen.push("-0 does not match 0")
  }
  switch (TEXT_ONE) {
    case 1:
      seen.push("a text matches a number")
      break
    case "1":
      seen.push("a text matches a text")
    case "2":
      seen.push("and falls through")
      break
    case "3":
      seen.push("never")
  }
  switch (ONE) {
    default:
      seen.push("the default comes first")
    case 2:
      seen.push("and falls through")
      break
    case 3:
      seen.push("never")
  }
  switch (BIG_ONE) {
    case 1:
      seen.push("a bigint matches a number")
      break
    case 1n:
      seen.push("a bigint matches a bigint")
  }
  switch (ONE) {
    case effect():
      seen.push("never")
      break
    case 1:
      seen.push("the tests before it ran")
  }
  return seen
}
say("switches", switches().join(" | "))
say("effects ran", effects)

function statements(): string[] {
  const seen: string[] = []
  if (NAN) seen.push("never")
  else seen.push("NaN is falsy")
  if (MINUS_ZERO) seen.push("never")
  if (TEXT_ZERO) seen.push("a text of a zero is truthy")
  if (BIG_ZERO) seen.push("never")
  while (EMPTY) seen.push("never")
  for (let i = 0; NULL; i++) seen.push("never")
  do seen.push("a body runs once")
  while (NAN)
  for (const key in NULL) seen.push("never " + key)
  label: {
    if (ONE) break label
    seen.push("never")
  }
  seen.push("behind the label")
  try {
    if (ONE) throw new Error("thrown")
    seen.push("never")
  } catch (error) {
    seen.push((error as Error).message)
  } finally {
    seen.push("finally")
  }
  for (const n of [1, 2, 3]) {
    if (ZERO) continue
    if (n === 2 && ONE) break
    seen.push("n " + n)
  }
  seen.push(hoisted())
  return seen
  function hoisted() {
    return "declared behind the return"
  }
}
say("statements", statements().join(" | "))
console.log(log.join("\n"))
//// evolving-let.ts
// `let x;` without a type or an initializer in a TypeScript file holds whatever is assigned to it.
function ends(text: string) { let end; let count = 0; for (let i = 0; i < text.length; i++) { if (text.charCodeAt(i) === 32) { end = i; count++ } } return end === undefined ? -1 : end * 10 + count }
function label(n: number) { let s; if (n > 0) s = "above"; else if (n < 0) s = "below"; return s ?? "zero" }
function mixed(n: number) { let v; v = n > 1 ? n : "one"; return typeof v === "number" ? v + 1 : v + "!" }
function counted(n: number) { let k; k = 0; while (k < n) { k++; k += 2 } return k }
function list(n: number) { let a; a = []; for (let i = 0; i < n; i++) a.push(i * 2); return a.length + (a[1] ?? 0) }
function untyped(o: any) { let v; v = o.x; return v }
function taken(p: number[]) { let x; [x] = p; return x }
const n = Number("4")
console.log(ends("a b c"), ends("abc"), label(n), label(-n), label(0), mixed(n), mixed(1), counted(n * 2))
console.log(list(n), untyped({ x: "y" }), untyped({}), taken([n, 1]))
//// evolving-let-counted.ts
// A `let` without a type or an initializer at the top level of a module with top-level `await`.
class Socket { handlers: Record<string, (e?: unknown) => void> = {}; on(name: string, f: (e?: unknown) => void) { this.handlers[name] = f; return this } end() { Promise.resolve().then(() => this.handlers["close"]?.()) } }
const connect = (options: { path: string }) => { const socket = new Socket(); Promise.resolve().then(() => socket.handlers["connect"]?.()); return socket }
const sleep = (ms: number) => new Promise<void>(done => Promise.resolve(ms).then(() => done()))
const isSlow = Number("0") === 1
const { promise, resolve } = Promise.withResolvers<void>();
Promise.resolve().then(() => resolve());
await promise;
const warmup_total = isSlow ? 100 : 300;
const measured_total = isSlow ? 200 : 500;

let started;

started = 0;
////= while	warmup_total

started = 0;
////= while	measured_total
console.log("done", started, typeof started)
export {}
//// falsy-object-is-nullish.ts
// Where a value that is an object, undefined or null has tested falsy it goes on as undefined or null: `a && f(a)`, `a || b`, `!a`, early returns, loops, and the same through parameters that untyped callers fill.
interface Item { name: string; next?: Item | null }
function nameOf(item: Item): string { return item.name; }
function andThen(item: Item | undefined | null): string | undefined | null { return item && nameOf(item); }
function orElse(item: Item | undefined, other: Item): Item { return item || other; }
function early(item: Item | null): string { if (!item) return String(item); return item.name; }
function keepsWhichNil(item: Item | undefined | null): string { const left = item && item.next; return left === undefined ? "undefined" : left === null ? "null" : left.name; }
function last(item: Item | undefined | null): string { let seen = "none"; while (item) { seen = item.name; item = item.next; } return seen + " " + String(item); }
function handOn(item: Item | undefined | null): string { return take(item && item.next); }
function take(item: Item | undefined | null): string { return item ? item.name : String(item); }
const c: Item = { name: "c", next: null }, b: Item = { name: "b", next: c }, a: Item = { name: "a", next: b }, alone: Item = { name: "alone" };
console.log(andThen(a), andThen(undefined), andThen(null), orElse(undefined, b).name, orElse(a, b).name, early(null), early(c));
console.log(keepsWhichNil(a), keepsWhichNil(c), keepsWhichNil(alone), keepsWhichNil(undefined), keepsWhichNil(null), last(a), last(alone), last(undefined), last(null));
console.log(handOn(a), handOn(c), handOn(alone), handOn(undefined), handOn(null));
const untyped: any[] = [andThen, early, keepsWhichNil, last, handOn];
for (const f of untyped) {
  for (const given of [a, undefined, null, 0, "", false, "text"]) {
    try { console.log(f.name, String(given && (given as any).name || given), String(f(given))); } catch (error) { console.log(f.name, String(given), (error as Error).name); }
  }
}
//// instanceof-beside-values-that-are-no-objects.ts
// `x instanceof Left` where the type of x lists two classes beside false, a number, true, a string or undefined. Left has a class below it; two more classes below the same base exist and arrive under `as`
class Base { tag = 0; }
class Left extends Base { left = 1; }
class LeftMost extends Left { most = 2; }
class Right extends Base { right = 3; }
class Far extends Base { far = 4; }
function besideFalse(x: Left | Right | false): number { return x instanceof Left ? x.left : 0; }
function besideNumber(x: Left | Right | number): number { return x instanceof Left ? x.left + 10 : 0; }
function besideTrue(x: Right | LeftMost | true): number { return x instanceof Right ? x.right : 0; }
function besideString(x: Left | Right | string): number { return x instanceof Left ? x.left + 20 : 0; }
function besideNothing(x?: Left | Right): number { return x instanceof Left ? x.left + 30 : 0; }
const values: unknown[] = [new Left(), new Right(), new LeftMost(), new Far(), new Base(), false, true, 0, 1.5, NaN, "left", "", undefined, null, {}, [], Object.create(Left.prototype), Object.create(null), () => 1, Symbol.iterator, 5n];
for (let round = 0; round < 300; round++) {
  let line = "";
  for (const value of values)
    line += besideFalse(value as Left | false) + "," + besideNumber(value as Left | number) + "," + besideTrue(value as Right | true) + "," + besideString(value as Left | string) + "," + besideNothing(value as Left | undefined) + " ";
  if (round % 149 === 0) console.log(round, line);
}
//// large-object-union/files/guards.ts
import type { All, I7, Sub17, Sub5 } from "./nodes";
import { parse, parse5, take, take5, unknownToAll } from "./take";
export function isSub17(node: All): node is Sub17 { return node.kind !== "k1" && node.kind !== "k2" && node.kind !== "k20"; }
export function byGuard(node: All): string { return isSub17(node) ? take(node) : "-"; }
export function byChain(node: All): string {
    if (node.kind === "k1") return "1";
    if (node.kind === "k2") return "2";
    if (node.kind === "k20") return "20";
    return take(node);
}
export function byCast(node: All): string { const sub = node as Sub17; return take(sub); }
export function byVariable(node: All): string { let sub: Sub17 | undefined; if (isSub17(node)) sub = node; return sub ? take(sub) : "-"; }
export function single(node: I7): string { return take(node); }
export function five(node: Sub5): string { return take(node) + take5(node); }
export function parsed(): string { return take(parse('{"kind":"k4","id":4,"name":"d","own4":4}')) + take5(parse5('{"kind":"k5","id":5,"name":"e","own5":5}')) + take(unknownToAll({ kind: "k6", id: 6, name: "f", own6: 6 })); }
//// large-object-union/files/nodes.ts
export interface I1 { kind: "k1"; id: number; name: string; own1: number }
export interface I2 { kind: "k2"; id: number; name: string; own2: number }
export interface I3 { kind: "k3"; id: number; name: string; own3: number }
export interface I4 { kind: "k4"; id: number; name: string; own4: number }
export interface I5 { kind: "k5"; id: number; name: string; own5: number }
export interface I6 { kind: "k6"; id: number; name: string; own6: number }
export interface I7 { kind: "k7"; id: number; name: string; own7: number }
export interface I8 { kind: "k8"; id: number; name: string; own8: number }
export interface I9 { kind: "k9"; id: number; name: string; own9: number }
export interface I10 { kind: "k10"; id: number; name: string; own10: number }
export interface I11 { kind: "k11"; id: number; name: string; own11: number }
export interface I12 { kind: "k12"; id: number; name: string; own12: number }
export interface I13 { kind: "k13"; id: number; name: string; own13: number }
export interface I14 { kind: "k14"; id: number; name: string; own14: number }
export interface I15 { kind: "k15"; id: number; name: string; own15: number }
export interface I16 { kind: "k16"; id: number; name: string; own16: number }
export interface I17 { kind: "k17"; id: number; name: string; own17: number }
export interface I18 { kind: "k18"; id: number; name: string; own18: number }
export interface I19 { kind: "k19"; id: number; name: string; own19: number }
export interface I20 { kind: "k20"; id: number; name: string; own20: number }
export type All = I1 | I2 | I3 | I4 | I5 | I6 | I7 | I8 | I9 | I10 | I11 | I12 | I13 | I14 | I15 | I16 | I17 | I18 | I19 | I20;
export type Sub17 = I3 | I4 | I5 | I6 | I7 | I8 | I9 | I10 | I11 | I12 | I13 | I14 | I15 | I16 | I17 | I18 | I19;
export type Sub5 = I1 | I2 | I3 | I4 | I5;
//// large-object-union/files/take.ts
import type { All, Sub5 } from "./nodes";
export function take(node: All): string { return node.kind + node.id + node.name; }
export function take5(node: Sub5): string { return node.kind + node.id; }
export function parse(text: string): All { return JSON.parse(text) as All; }
export function parse5(text: string): Sub5 { const made = JSON.parse(text) as Sub5; return made; }
export function unknownToAll(value: unknown): All { return value as All; }
//// large-object-union/main.ts
// A union of nine object types is read through the fields they have in common.
import type { All, I1, I7, I9, I20 } from "./files/nodes";
import { byCast, byChain, byGuard, byVariable, five, parsed, single } from "./files/guards";
const one: I1 = { kind: "k1", id: 1, name: "a", own1: 1 };
const seven: I7 = { kind: "k7", id: 7, name: "g", own7: 7 };
const nine: I9 = { kind: "k9", id: 9, name: "i", own9: 9 };
const twenty: I20 = { kind: "k20", id: 20, name: "t", own20: 20 };
const all: All[] = [one, seven, nine, twenty];
console.log(all.map(byGuard).join(), all.map(byChain).join(), byCast(nine), all.map(byVariable).join());
console.log(single(seven), five(one), parsed());
//// literals-that-a-failed-comparison-or-an-assignment-takes-away.ts
// Behind a failed `kind === "alpha"` the checker takes "alpha" out of the union, and behind `done = false` it holds `done` for false. Nothing is tested for that: the value keeps the type it had.
// The checker is wrong about `done`, `count` and `last`: a closure assigns them behind its back.
type Kind = "alpha" | "beta" | "gamma" | "delta" | "epsilon" | "zeta" | "eta" | "theta";
function isGate(kind: Kind): boolean {
  return kind === "alpha" || kind === "beta" || kind === "gamma" || kind === "delta";
}
function rank(kind: Kind): number {
  if (kind === "alpha") return 1;
  if (kind === "beta") return 2;
  if (kind !== "gamma" && kind !== "delta") return kind === "theta" ? 8 : kind.length;
  return kind === "gamma" ? 3 : 4;
}
const all: Kind[] = ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta"];
let gates = 0;
let ranks = 0;
for (let i = 0; i < 64; i++) {
  const kind = JSON.parse(JSON.stringify(all[i & 7])) as Kind;
  if (isGate(kind)) gates++;
  ranks += rank(kind);
}
console.log(gates, ranks);

function walk(items: number[], visit: (item: number) => void): void {
  for (const item of items) visit(item);
}
function findsEven(items: number[]): string {
  let done = false;
  let count = 0;
  let last: "none" | "even" | "odd" = "none";
  walk(items, item => {
    if (item % 2 === 0) done = true;
    count++;
    last = item % 2 === 0 ? "even" : "odd";
  });
  const seen = done ? "found" : "missing";
  const many = count === 0 ? "empty" : "some " + count;
  return seen + " " + many + " " + (last === "none" ? "nothing" : last);
}
console.log(findsEven([1, 3, 5]), "|", findsEven([1, 2, 3]), "|", findsEven([]), "|", findsEven([4]));
console.log(isGate("omega" as Kind), rank("omega" as Kind), isGate(undefined as unknown as Kind), isGate(7 as unknown as Kind));
//// members-changed-behind-the-checker.ts
// TypeScript keeps the narrowed type of `a.b` until `a.b` itself is assigned, so an alias, a call, a getter or an `await` can change the property between the check and the use. Every use must see the current value, as in plain Bun, and code that ran before the use must not run again.
class Leaf {
  kind = "leaf" as const;
  text: string;
  weight = 1;
  constructor(text: string) {
    this.text = text;
  }
  describe(): string {
    return "leaf " + this.text;
  }
  shout(): string {
    return this.text.toUpperCase();
  }
}

class Branch {
  kind = "branch" as const;
  weight = "heavy";
  children: Tree[];
  constructor(children: Tree[]) {
    this.children = children;
  }
  describe(): string {
    return "branch of " + this.children.length;
  }
}

type Tree = Leaf | Branch;

interface Slot {
  item: Tree;
}

class Holder {
  item: Tree;
  constructor(item: Tree) {
    this.item = item;
  }
  setItem(item: Tree): void {
    this.item = item;
  }
  readAfterAliasStore(alias: Holder, other: Tree): string {
    if (this.item instanceof Leaf) {
      alias.item = other;
      return format(this.item.text, this.item.describe());
    }
    return "not a leaf";
  }
  readAfterOwnMethod(other: Tree): string {
    if (this.item instanceof Leaf) {
      this.setItem(other);
      return format(this.item.text, this.item.describe());
    }
    return "not a leaf";
  }
}

class Outer {
  inner: Holder;
  constructor(inner: Holder) {
    this.inner = inner;
  }
}

function format(...values: unknown[]): string {
  return values.map(value => String(value)).join(" ");
}

function isLeaf(tree: Tree): tree is Leaf {
  return tree instanceof Leaf;
}

function assertLeaf(tree: Tree): asserts tree is Leaf {
  if (!(tree instanceof Leaf)) throw new RangeError("not a leaf");
}

function setItem(holder: Holder, item: Tree): void {
  holder.item = item;
}

function setItemAndReturnTrue(holder: Holder, item: Tree): boolean {
  holder.item = item;
  return true;
}

function setItemThenCheckLeaf(tree: Tree, holder: Holder, item: Tree): tree is Leaf {
  holder.item = item;
  return tree instanceof Leaf;
}

function itemKey(): "item" {
  return "item";
}

////= lines-4	checkInstanceof	holder	Holder

function checkTypePredicate(holder: Holder, alias: Holder, other: Tree): string {
  if (isLeaf(holder.item)) {
    alias.item = other;
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function checkDiscriminant(holder: Holder, alias: Holder, other: Tree): string {
  if (holder.item.kind === "leaf") {
    alias.item = other;
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function checkInOperator(holder: Holder, alias: Holder, other: Tree): string {
  if ("text" in holder.item) {
    alias.item = other;
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function checkAssertion(holder: Holder, alias: Holder, other: Tree): string {
  assertLeaf(holder.item);
  alias.item = other;
  return format(holder.item.text, holder.item.describe());
}

function checkSwitch(holder: Holder, alias: Holder, other: Tree): string {
  switch (holder.item.kind) {
    case "leaf":
      alias.item = other;
      return format(holder.item.text, holder.item.describe());
    case "branch":
      alias.item = other;
      return format(holder.item.children.length, holder.item.describe());
    default:
      return "neither";
  }
}

function checkSwitchTrue(holder: Holder, alias: Holder, other: Tree): string {
  switch (true) {
    case holder.item instanceof Leaf:
      alias.item = other;
      return format(holder.item.text, holder.item.describe());
    default:
      return "not a leaf";
  }
}

function checkAliasedCondition(view: { readonly item: Tree }, alias: Holder, other: Tree): string {
  const wasLeaf = view.item instanceof Leaf;
  alias.item = other;
  if (wasLeaf) return format(view.item.text, view.item.describe());
  return "not a leaf";
}

function checkEarlyReturn(holder: Holder, alias: Holder, other: Tree): string {
  if (!(holder.item instanceof Leaf)) return "not a leaf";
  alias.item = other;
  return format(holder.item.text, holder.item.describe());
}

function checkAndUseInOneExpression(holder: Holder, alias: Holder, other: Tree): string {
  return holder.item instanceof Leaf && setItemAndReturnTrue(alias, other) ? format(holder.item.text, holder.item.describe()) : "not a leaf";
}

function changeInCall(holder: Holder, alias: Holder, other: Tree): string {
  if (holder.item instanceof Leaf) {
    setItem(alias, other);
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function changeInClosure(holder: Holder, alias: Holder, other: Tree): string {
  const change = () => {
    alias.item = other;
  };
  if (holder.item instanceof Leaf) {
    change();
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function changeInAliasMethod(holder: Holder, alias: Holder, other: Tree): string {
  if (holder.item instanceof Leaf) {
    alias.setItem(other);
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function changeInHolderMethod(holder: Holder, alias: Holder, other: Tree): string {
  if (holder.item instanceof Leaf) {
    holder.setItem(other);
    return format(holder.item.text, holder.item.describe(), alias.item.describe());
  }
  return "not a leaf";
}

function changeInToString(holder: Holder, alias: Holder, other: Tree): string {
  const trigger = {
    toString(): string {
      alias.item = other;
      return "converted";
    },
  };
  if (holder.item instanceof Leaf) {
    return format(`${trigger}`, holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function changeInBuiltinCallback(holder: Holder, alias: Holder, other: Tree): string {
  if (holder.item instanceof Leaf) {
    [other].forEach(item => {
      alias.item = item;
    });
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function changeBetweenArguments(holder: Holder, alias: Holder, other: Tree): string {
  if (holder.item instanceof Leaf) {
    return format(holder.item.text, setItemAndReturnTrue(alias, other), holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function changeInTypePredicate(holder: Holder, alias: Holder, other: Tree): string {
  if (setItemThenCheckLeaf(holder.item, alias, other)) {
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function changeWithObjectAssign(holder: Holder, alias: Holder, other: Tree): string {
  if (holder.item instanceof Leaf) {
    Object.assign(alias, { item: other });
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function changeWithReflectSet(holder: Holder, alias: Holder, other: Tree): string {
  if (holder.item instanceof Leaf) {
    Reflect.set(alias, "item", other);
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function changeWithComputedKey(holder: Holder, alias: Holder, other: Tree): string {
  const key = itemKey();
  if (holder.item instanceof Leaf) {
    alias[key] = other;
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function changeWithDestructuring(holder: Holder, alias: Holder, other: Tree): string {
  if (holder.item instanceof Leaf) {
    ({ item: alias.item } = { item: other });
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function* readAcrossYield(holder: Holder): Generator<string, string, void> {
  if (holder.item instanceof Leaf) {
    yield holder.item.text;
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function changeBetweenYields(holder: Holder, alias: Holder, other: Tree): string {
  const generator = readAcrossYield(holder);
  const first = generator.next();
  alias.item = other;
  const second = generator.next();
  return format(first.value, first.done, second.value, second.done);
}

async function changeDuringAwait(holder: Holder, alias: Holder, other: Tree): Promise<string> {
  if (holder.item instanceof Leaf) {
    queueMicrotask(() => {
      alias.item = other;
    });
    await Promise.resolve();
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function deleteProperty(holder: Holder, alias: Holder): string {
  if (holder.item instanceof Leaf) {
    delete (alias as { item?: Tree }).item;
    return format(Object.keys(holder).join(), holder.item.text);
  }
  return "not a leaf";
}

function thisProperty(holder: Holder, alias: Holder, other: Tree): string {
  return holder.readAfterAliasStore(alias, other);
}

function thisPropertyOwnMethod(holder: Holder, alias: Holder, other: Tree): string {
  return format(holder.readAfterOwnMethod(other), alias.item.describe());
}

////= lines-4	interfaceProperty	slot	Slot

function nestedPropertyLastStep(outer: Outer, alias: Outer, other: Tree): string {
  if (outer.inner.item instanceof Leaf) {
    alias.inner.item = other;
    return format(outer.inner.item.text, outer.inner.item.describe());
  }
  return "not a leaf";
}

function nestedPropertyFirstStep(outer: Outer, alias: Outer, other: Tree): string {
  if (outer.inner.item instanceof Leaf) {
    alias.inner = new Holder(other);
    return format(outer.inner.item.text, outer.inner.item.describe());
  }
  return "not a leaf";
}

function tupleElement(pair: [Tree, number], alias: [Tree, number], other: Tree): string {
  if (pair[0] instanceof Leaf) {
    alias[0] = other;
    return format(pair[0].text, pair[0].describe());
  }
  return "not a leaf";
}

function arrayElement(list: Tree[], alias: Tree[], other: Tree): string {
  if (list[0] instanceof Leaf) {
    alias[0] = other;
    return format(list[0].text, list[0].describe());
  }
  return "not a leaf";
}

function arrayElementAfterUnshift(list: Tree[], alias: Tree[], other: Tree): string {
  if (list[0] instanceof Leaf) {
    alias.unshift(other);
    return format(list[0].text, list[0].describe());
  }
  return "not a leaf";
}

function arrayElementAfterTruncation(list: Tree[], alias: Tree[]): string {
  if (list[0] instanceof Leaf) {
    alias.length = 0;
    return format(list[0].text);
  }
  return "not a leaf";
}

const sharedHolder = new Holder(new Leaf("shared"));
let activeHolder = new Holder(new Leaf("active"));

class Registry {
  static current: Tree = new Leaf("registered");
  static setCurrent(item: Tree): void {
    Registry.current = item;
  }
}

function setActiveHolder(holder: Holder): void {
  activeHolder = holder;
}

function moduleConstProperty(first: Tree, other: Tree): string {
  sharedHolder.item = first;
  if (sharedHolder.item instanceof Leaf) {
    setItem(sharedHolder, other);
    return format(sharedHolder.item.text, sharedHolder.item.describe());
  }
  return "not a leaf";
}

function reassignedModuleVariable(first: Tree, other: Tree): string {
  activeHolder = new Holder(first);
  if (activeHolder.item instanceof Leaf) {
    setActiveHolder(new Holder(other));
    return format(activeHolder.item.text, activeHolder.item.describe());
  }
  return "not a leaf";
}

function staticProperty(first: Tree, other: Tree): string {
  Registry.current = first;
  if (Registry.current instanceof Leaf) {
    Registry.setCurrent(other);
    return format(Registry.current.text, Registry.current.describe());
  }
  return "not a leaf";
}

function localObjectProperty(first: Tree, other: Tree): string {
  const holder = new Holder(first);
  const alias = holder;
  if (holder.item instanceof Leaf) {
    alias.item = other;
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function capturedObjectProperty(first: Tree, other: Tree): string {
  const holder = new Holder(first);
  const change = () => {
    holder.item = other;
  };
  if (holder.item instanceof Leaf) {
    change();
    return format(holder.item.text, holder.item.describe());
  }
  return "not a leaf";
}

function readAllFields(holder: Holder, alias: Holder, other: Tree): string {
  if (!(holder.item instanceof Leaf)) return "not a leaf";
  const before = holder.item.text;
  alias.item = other;
  return format(before, holder.item.text, holder.item.weight, holder.item.weight + 1, holder.item.kind, typeof holder.item.shout, "text" in holder.item);
}

function callLeafOnlyMethod(holder: Holder, alias: Holder, other: Tree): string {
  if (holder.item instanceof Leaf) {
    alias.item = other;
    return holder.item.shout();
  }
  return "not a leaf";
}

function leafSummary(leaf: Leaf): string {
  return leaf.text + "/" + leaf.describe();
}

function passToTypedParameter(holder: Holder, alias: Holder, other: Tree): string {
  if (holder.item instanceof Leaf) {
    alias.item = other;
    return leafSummary(holder.item);
  }
  return "not a leaf";
}

class LeafHolder {
  leaf: Leaf;
  constructor(leaf: Leaf) {
    this.leaf = leaf;
  }
}

function storeToTypedField(holder: Holder, alias: Holder, other: Tree): string {
  const target = new LeafHolder(new Leaf("initial"));
  if (holder.item instanceof Leaf) {
    alias.item = other;
    target.leaf = holder.item;
  }
  return format(target.leaf.text, target.leaf.describe(), Object.keys(target).join());
}

function takeLeaf(holder: Holder, alias: Holder, other: Tree): Leaf | undefined {
  if (holder.item instanceof Leaf) {
    alias.item = other;
    return holder.item;
  }
  return undefined;
}

function returnFromTypedFunction(holder: Holder, alias: Holder, other: Tree): string {
  const leaf = takeLeaf(holder, alias, other);
  return leaf ? format(leaf.text, leaf.describe()) : "not a leaf";
}

function bindToConst(holder: Holder, alias: Holder, other: Tree): string {
  if (holder.item instanceof Leaf) {
    alias.item = other;
    const leaf = holder.item;
    const readText = () => leaf.text;
    return format(leaf.text, readText(), leaf.describe());
  }
  return "not a leaf";
}

function pushToTypedArray(holder: Holder, alias: Holder, other: Tree): string {
  const leaves: Leaf[] = [];
  if (holder.item instanceof Leaf) {
    alias.item = other;
    leaves.push(holder.item);
  }
  return leaves.map(leaf => leaf.text + "/" + leaf.describe()).join();
}

function writeThroughProperty(holder: Holder, alias: Holder, other: Tree): string {
  if (holder.item instanceof Leaf) {
    alias.item = other;
    holder.item.text = "stored";
    holder.item.weight += 1;
    return format(Object.keys(holder.item).join(), holder.item.text, holder.item.weight);
  }
  return "not a leaf";
}

function checkOutsideLoop(holder: Holder, alias: Holder, other: Tree): string {
  let result = "";
  if (holder.item instanceof Leaf) {
    for (let i = 0; i < 4; i++) {
      result += holder.item.text + ",";
      if (i === 1) alias.item = other;
    }
  }
  return result;
}

function checkInLoopCondition(holder: Holder, alias: Holder, other: Tree): string {
  let result = "";
  for (let i = 0; i < 3 && holder.item instanceof Leaf; i++) {
    if (i === 1) alias.item = other;
    result += holder.item.text + ",";
  }
  return result;
}

function useInsideTry(holder: Holder, alias: Holder, other: Tree): string {
  let trace = "";
  try {
    trace += "try ";
    if (holder.item instanceof Leaf) {
      alias.item = other;
      trace += holder.item.shout() + " ";
    }
  } catch (error) {
    trace += "caught " + (error as Error).constructor.name + " ";
  } finally {
    trace += "finally";
  }
  return trace;
}

let sideEffectCount = 0;

function sideEffectsRunOnce(holder: Holder, alias: Holder, other: Tree): string {
  let sum = 0;
  let label = "";
  const visited: number[] = [];
  for (let i = 0; i < 6; i++) {
    sideEffectCount++;
    sum += i * 1.5;
    label += i;
    visited.push(i);
    if (holder.item instanceof Leaf) {
      if (i === 3) alias.item = other;
      label += holder.item.text;
      sum += holder.item.weight;
    } else {
      label += "-";
    }
  }
  return format(sum, label, visited.join(""), sideEffectCount);
}

function manyHolders(count: number): string {
  const holders: Holder[] = [];
  for (let i = 0; i < count; i++) holders.push(new Holder(i % 5 === 4 ? new Branch([]) : new Leaf("l" + i)));
  let totalLength = 0;
  let missingCount = 0;
  for (let i = 0; i < count; i++) {
    const holder = holders[i];
    if (holder.item instanceof Leaf) {
      if (i % 7 === 3) setItem(holders[i], new Branch([holder.item]));
      const text = holder.item.text;
      if (text === undefined) missingCount++;
      else totalLength += text.length;
    }
  }
  return format(totalLength, missingCount);
}

class Alternating {
  readCount = 0;
  constructor(
    private first: Tree,
    private second: Tree,
  ) {}
  get item(): Tree {
    return this.readCount++ % 2 === 0 ? this.first : this.second;
  }
  readOwnAccessor(): string {
    if (this.item instanceof Leaf) return format(this.item.text, this.item.describe(), this.readCount);
    return format("not a leaf", this.readCount);
  }
}

function readAccessor(alternating: Alternating): string {
  if (alternating.item instanceof Leaf) return format(alternating.item.text, alternating.item.describe(), alternating.item.weight, alternating.readCount);
  return format("not a leaf", alternating.readCount);
}

function readSlot(slot: Slot): string {
  if (slot.item instanceof Leaf) return format(slot.item.text, slot.item.describe());
  return "not a leaf";
}

function readHolder(holder: Holder): string {
  if (holder.item instanceof Leaf) return format(holder.item.text, holder.item.describe());
  return "not a leaf";
}

function createAlternatingSlot(first: Tree, second: Tree): Slot {
  let readCount = 0;
  return {
    get item(): Tree {
      return readCount++ % 2 === 0 ? first : second;
    },
  };
}

function defineAlternatingGetter(first: Tree, second: Tree): Holder {
  const holder = new Holder(first);
  let readCount = 0;
  Object.defineProperty(holder, "item", {
    get: () => (readCount++ % 2 === 0 ? first : second),
    configurable: true,
  });
  return holder;
}

function createAlternatingProxy(first: Tree, second: Tree): Holder {
  let readCount = 0;
  return new Proxy(new Holder(first), {
    get(target, key, receiver) {
      if (key === "item") return readCount++ % 2 === 0 ? first : second;
      return Reflect.get(target, key, receiver);
    },
  });
}

class Cell {
  value: string | number;
  next: Cell | undefined;
  constructor(value: string | number, next?: Cell) {
    this.value = value;
    this.next = next;
  }
}

function numberArithmetic(cell: Cell, alias: Cell, other: string | number): string {
  if (typeof cell.value === "number") {
    alias.value = other;
    return format(cell.value + 1, cell.value * 2, -cell.value, cell.value < 10, cell.value | 0);
  }
  return "not a number";
}

function numberMethod(cell: Cell, alias: Cell, other: string | number): string {
  if (typeof cell.value === "number") {
    alias.value = other;
    return cell.value.toFixed(1);
  }
  return "not a number";
}

function stringReads(cell: Cell, alias: Cell, other: string | number): string {
  if (typeof cell.value === "string") {
    alias.value = other;
    return format(cell.value.length, cell.value + "!", cell.value[0]);
  }
  return "not a string";
}

function stringMethod(cell: Cell, alias: Cell, other: string | number): string {
  if (typeof cell.value === "string") {
    alias.value = other;
    return cell.value.toUpperCase();
  }
  return "not a string";
}

function clearAfterTruthyCheck(cell: Cell, alias: Cell): string {
  if (cell.next) {
    alias.next = undefined;
    return format(cell.next.value);
  }
  return "no next";
}

function clearAfterUndefinedCheck(cell: Cell, alias: Cell): string {
  if (cell.next !== undefined) {
    alias.next = undefined;
    return format(cell.next.value);
  }
  return "no next";
}

function clearAfterOptionalChain(cell: Cell, alias: Cell): string {
  if (cell.next?.value !== undefined) {
    alias.next = undefined;
    return format(cell.next.value);
  }
  return "no next";
}

enum Mode {
  Off,
  On,
}

class Dial {
  color: "red" | "green" = "red";
  mode: Mode = Mode.Off;
  isOn = true;
}

function stringLiteralProperty(dial: Dial, alias: Dial): string {
  if (dial.color === "red") {
    alias.color = "green";
    const color: "red" = dial.color;
    return color;
  }
  return "not red";
}

function enumProperty(dial: Dial, alias: Dial): number {
  if (dial.mode === Mode.Off) {
    alias.mode = Mode.On;
    const mode: Mode.Off = dial.mode;
    return mode + 10;
  }
  return -1;
}

function booleanProperty(dial: Dial, alias: Dial): string {
  if (dial.isOn) {
    alias.isOn = false;
    return dial.isOn ? "on" : "off";
  }
  return "was off";
}

class Box<T> {
  value: T;
  constructor(value: T) {
    this.value = value;
  }
}

function storeThroughWiderBox(leafBox: Box<Leaf>, other: Tree): string {
  const treeBox: Box<Tree> = leafBox;
  treeBox.value = other;
  return format(leafBox.value.text, leafBox.value.describe());
}

function storeThroughWiderArray(leaves: Leaf[], other: Tree): string {
  const trees: Tree[] = leaves;
  trees[0] = other;
  return format(leaves[0].text, leaves[0].describe());
}

const lines: string[] = [];

function attempt(run: () => unknown): string {
  try {
    return String(run());
  } catch (error) {
    return "threw " + (error as Error).constructor.name;
  }
}

async function attemptAsync(run: () => Promise<unknown>): Promise<string> {
  try {
    return String(await run());
  } catch (error) {
    return "threw " + (error as Error).constructor.name;
  }
}

function runAliasCases<H>(label: string, testCase: (holder: H, alias: H, other: Tree) => unknown, create: (item: Tree) => H): void {
  const leafToBranch = create(new Leaf("a"));
  const leafToLeaf = create(new Leaf("b"));
  const branchToLeaf = create(new Branch([]));
  const results = [
    attempt(() => testCase(leafToBranch, leafToBranch, new Branch([]))),
    attempt(() => testCase(leafToLeaf, leafToLeaf, new Leaf("c"))),
    attempt(() => testCase(create(new Leaf("d")), create(new Leaf("e")), new Branch([]))),
    attempt(() => testCase(branchToLeaf, branchToLeaf, new Leaf("f"))),
  ];
  lines.push(label + ": " + results.join(" | "));
}

async function runAliasCasesAsync(label: string, testCase: (holder: Holder, alias: Holder, other: Tree) => Promise<unknown>): Promise<void> {
  const leafToBranch = new Holder(new Leaf("a"));
  const leafToLeaf = new Holder(new Leaf("b"));
  const branchToLeaf = new Holder(new Branch([]));
  const results = [
    await attemptAsync(() => testCase(leafToBranch, leafToBranch, new Branch([]))),
    await attemptAsync(() => testCase(leafToLeaf, leafToLeaf, new Leaf("c"))),
    await attemptAsync(() => testCase(new Holder(new Leaf("d")), new Holder(new Leaf("e")), new Branch([]))),
    await attemptAsync(() => testCase(branchToLeaf, branchToLeaf, new Leaf("f"))),
  ];
  lines.push(label + ": " + results.join(" | "));
}

function runValuePairs(label: string, testCase: (first: Tree, second: Tree) => unknown): void {
  const results = [
    attempt(() => testCase(new Leaf("g"), new Branch([]))),
    attempt(() => testCase(new Leaf("h"), new Leaf("i"))),
    attempt(() => testCase(new Branch([]), new Leaf("j"))),
  ];
  lines.push(label + ": " + results.join(" | "));
}

function runAliasedAndDistinct<H>(label: string, testCase: (holder: H, alias: H) => unknown, create: () => H): void {
  const aliased = create();
  lines.push(label + ": " + attempt(() => testCase(aliased, aliased)) + " | " + attempt(() => testCase(create(), create())));
}

function runCellCases(label: string, testCase: (cell: Cell, alias: Cell, other: string | number) => unknown): void {
  const numberToString = new Cell(5);
  const numberToNumber = new Cell(6);
  const stringToNumber = new Cell("five");
  const stringToString = new Cell("six");
  const results = [
    attempt(() => testCase(numberToString, numberToString, "7")),
    attempt(() => testCase(numberToNumber, numberToNumber, 8.5)),
    attempt(() => testCase(stringToNumber, stringToNumber, 9)),
    attempt(() => testCase(stringToString, stringToString, "ten")),
    attempt(() => testCase(new Cell(1), new Cell(2), "3")),
    attempt(() => testCase(new Cell("one"), new Cell("two"), 3)),
  ];
  lines.push(label + ": " + results.join(" | "));
}

const createHolder = (item: Tree): Holder => new Holder(item);
const createSlot = (item: Tree): Slot => ({ item });
const createOuter = (item: Tree): Outer => new Outer(new Holder(item));
const createTuple = (item: Tree): [Tree, number] => [item, 0];
const createArray = (item: Tree): Tree[] => [item];
const createLinkedCells = (): Cell => new Cell(1, new Cell(2));
const createDial = (): Dial => new Dial();

for (const round of ["first round", "second round"]) {
  lines.push(round);

  runAliasCases<Holder>("instanceof", checkInstanceof, createHolder);
  runAliasCases<Holder>("type predicate", checkTypePredicate, createHolder);
  runAliasCases<Holder>("discriminant", checkDiscriminant, createHolder);
  runAliasCases<Holder>("in operator", checkInOperator, createHolder);
  runAliasCases<Holder>("assertion function", checkAssertion, createHolder);
  runAliasCases<Holder>("switch", checkSwitch, createHolder);
  runAliasCases<Holder>("switch (true)", checkSwitchTrue, createHolder);
  runAliasCases<Holder>("aliased condition", checkAliasedCondition, createHolder);
  runAliasCases<Holder>("early return", checkEarlyReturn, createHolder);
  runAliasCases<Holder>("one expression", checkAndUseInOneExpression, createHolder);

  runAliasCases<Holder>("call", changeInCall, createHolder);
  runAliasCases<Holder>("closure", changeInClosure, createHolder);
  runAliasCases<Holder>("method of the alias", changeInAliasMethod, createHolder);
  runAliasCases<Holder>("method of the holder", changeInHolderMethod, createHolder);
  runAliasCases<Holder>("toString", changeInToString, createHolder);
  runAliasCases<Holder>("built-in callback", changeInBuiltinCallback, createHolder);
  runAliasCases<Holder>("between arguments", changeBetweenArguments, createHolder);
  runAliasCases<Holder>("inside the type predicate", changeInTypePredicate, createHolder);
  runAliasCases<Holder>("Object.assign", changeWithObjectAssign, createHolder);
  runAliasCases<Holder>("Reflect.set", changeWithReflectSet, createHolder);
  runAliasCases<Holder>("computed key", changeWithComputedKey, createHolder);
  runAliasCases<Holder>("destructuring", changeWithDestructuring, createHolder);
  runAliasCases<Holder>("yield", changeBetweenYields, createHolder);
  await runAliasCasesAsync("await", changeDuringAwait);

  runAliasCases<Holder>("this", thisProperty, createHolder);
  runAliasCases<Holder>("this, own method", thisPropertyOwnMethod, createHolder);
  runAliasCases<Slot>("object literal behind an interface", interfaceProperty, createSlot);
  runAliasCases<Slot>("class instance behind an interface", interfaceProperty, createHolder);
  runAliasCases<Outer>("nested property, last step", nestedPropertyLastStep, createOuter);
  runAliasCases<Outer>("nested property, first step", nestedPropertyFirstStep, createOuter);
  runAliasCases<[Tree, number]>("tuple element", tupleElement, createTuple);
  runAliasCases<Tree[]>("array element", arrayElement, createArray);
  runAliasCases<Tree[]>("array element after unshift", arrayElementAfterUnshift, createArray);
  runAliasCases<Tree[]>("array element after truncation", arrayElementAfterTruncation, createArray);
  runValuePairs("module const", moduleConstProperty);
  runValuePairs("reassigned module variable", reassignedModuleVariable);
  runValuePairs("static property", staticProperty);
  runValuePairs("local object", localObjectProperty);
  runValuePairs("captured object", capturedObjectProperty);

  runAliasCases<Holder>("all fields", readAllFields, createHolder);
  runAliasCases<Holder>("method only Leaf has", callLeafOnlyMethod, createHolder);
  runAliasCases<Holder>("typed parameter", passToTypedParameter, createHolder);
  runAliasCases<Holder>("typed field", storeToTypedField, createHolder);
  runAliasCases<Holder>("typed return", returnFromTypedFunction, createHolder);
  runAliasCases<Holder>("const", bindToConst, createHolder);
  runAliasCases<Holder>("typed array", pushToTypedArray, createHolder);

  runAliasCases<Holder>("check outside the loop", checkOutsideLoop, createHolder);
  runAliasCases<Holder>("check in the loop condition", checkInLoopCondition, createHolder);
  runAliasCases<Holder>("try", useInsideTry, createHolder);
  runAliasCases<Holder>("side effects", sideEffectsRunOnce, createHolder);
  lines.push("many holders: " + manyHolders(0) + " | " + manyHolders(3) + " | " + manyHolders(200));

  runValuePairs("class accessor", (first, second) => readAccessor(new Alternating(first, second)));
  runValuePairs("class accessor through this", (first, second) => new Alternating(first, second).readOwnAccessor());
  runValuePairs("class accessor behind an interface", (first, second) => readSlot(new Alternating(first, second)));
  runValuePairs("object literal accessor", (first, second) => readSlot(createAlternatingSlot(first, second)));

  runCellCases("number arithmetic", numberArithmetic);
  runCellCases("number method", numberMethod);
  runCellCases("string reads", stringReads);
  runCellCases("string method", stringMethod);
  runAliasedAndDistinct<Cell>("cleared after a truthy check", clearAfterTruthyCheck, createLinkedCells);
  runAliasedAndDistinct<Cell>("cleared after an undefined check", clearAfterUndefinedCheck, createLinkedCells);
  runAliasedAndDistinct<Cell>("cleared after an optional chain", clearAfterOptionalChain, createLinkedCells);
  runAliasedAndDistinct<Dial>("string literal", stringLiteralProperty, createDial);
  runAliasedAndDistinct<Dial>("enum", enumProperty, createDial);
  runAliasedAndDistinct<Dial>("boolean", booleanProperty, createDial);

  lines.push("wider box: " + attempt(() => storeThroughWiderBox(new Box(new Leaf("k")), new Branch([]))) + " | " + attempt(() => storeThroughWiderBox(new Box(new Leaf("l")), new Leaf("m"))));
  lines.push("wider array: " + attempt(() => storeThroughWiderArray([new Leaf("n")], new Branch([]))) + " | " + attempt(() => storeThroughWiderArray([new Leaf("o")], new Leaf("p"))));

  runAliasCases<Holder>("write through the property", writeThroughProperty, createHolder);
  runAliasCases<Holder>("delete", deleteProperty, createHolder);
  runValuePairs("getter defined over a field", (first, second) => readHolder(defineAlternatingGetter(first, second)));
  runValuePairs("proxy", (first, second) => readHolder(createAlternatingProxy(first, second)));
}

console.log(lines.join("\n"));

