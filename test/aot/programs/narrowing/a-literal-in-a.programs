function isBig(n: number): boolean { return n > 10 }
function twice(n: number): number { return n * 2 }
// `n` gets room: it is handed an element that need not be there.
function byEquality(n: number): number { if (n === 1 || n && !isBig(n)) { return twice(n) } return -1 }
function byTypeof(n: number): number { if (typeof n === "number" && n > 100 || n && !isBig(n)) { return twice(n) } return -1 }
function byUndefined(n: number): number { if (n !== undefined && n < 3 || n && !isBig(n)) { return twice(n) } return -1 }
function inALoop(n: number): number { let total = 0; for (let i = 0; i < 2; i++) { if (n === 1 || n && !isBig(n)) { total += twice(n) } else { total -= 1 } } return total }
function bySwitch(n: number): number { switch (n) { case 1: case 5: return twice(n); default: return -1 } }
for (const at of [0, 1, 2, 9]) {
  attempt("=== " + at, () => byEquality(list[at]))
  attempt("typeof " + at, () => byTypeof(list[at]))
  attempt("!== undefined " + at, () => byUndefined(list[at]))
  attempt("in a loop " + at, () => inALoop(list[at]))
  attempt("switch " + at, () => bySwitch(list[at]))
}
//// program-constants-fold-conditions.ts
// A `const` that holds a primitive literal decides the conditions it is tested in. The code that never runs is not checked: each call of `wrong` with a text is a type error. A read in the temporal dead zone still throws.
// A `const` that holds an object is checked on both sides, and the side for a falsy or missing object never runs.
const log: unknown[] = []
function readsEarly(): string {
  try {
    return late ? "yes" : "no"
  } catch (error) {
    return (error as Error).name
  }
}
function readsEarlyInAnd(): unknown {
  try {
    return late && "never"
  } catch (error) {
    return (error as Error).name
  }
}
function readsEarlyInIf(): string {
  try {
    if (late) return "never"
    return "no"
  } catch (error) {
    return (error as Error).name
  }
}
log.push(readsEarly(), readsEarlyInAnd(), readsEarlyInIf())
const late = false
log.push(readsEarly(), readsEarlyInAnd(), readsEarlyInIf())

function wrong(n: number): number {
  log.push("this ran: " + n)
  return n
}
const DEBUG = false
const picked = DEBUG ? wrong("an arm") : "quiet"
function describe() {
  if (DEBUG) return wrong("a branch")
  return "described"
}
const table = { a: 1 }
const always = table ? "an object is truthy" : wrong(1)
const present = table ?? { a: wrong(2) }
log.push(picked, describe(), always, present.a)

function loop(): string[] {
  const seen: string[] = []
  for (let i = 0; i < 3; i++) {
    const even = i % 2 === 0
    seen.push(even ? "even" : "odd")
  }
  return seen
}
log.push(...loop())
console.log(log.map(String).join("\n"))
//// switch-on-numbers.ts
// `switch` and `===` chains on a parameter of type `number`, with integers, fractions, -0 and NaN.
function pick(k: number): number { switch (k) { case 0: return 10; case 1: return 21; case 2: return 32; case 3: return 43; case 4: return 54; case 5: return 65; default: return 0 } }
function sparse(k: number): string { switch (k) { case -1: return "minus one"; case 0: return "zero"; case 1000: return "thousand"; case 2147483648: return "2^31"; case -2147483649: return "below"; case 9007199254740992: return "2^53"; default: return "none" } }
function chain(k: number): string { return k === 7 ? "seven" : k === 0 ? "zero" : k !== 3 ? (k === 2.5 ? "fraction" : "other") : "three" }
function few(k: number): string { return k === 1 ? "one" : k === 2 ? "two" : "many" }
const ks: number[] = ["0", "-0", "1", "2", "3", "4", "5", "6", "7", "-1", "2.5", "0.5", "4.000000001", "1000", "2147483648", "-2147483649", "9007199254740992", "9007199254740993", "1e300", "NaN", "Infinity", "-Infinity", "5e-324"].map(Number)
console.log(ks.map(pick).join())
console.log(ks.map(sparse).join())
console.log(ks.map(chain).join())
console.log(ks.map(few).join())
let seen = ""
for (let x = Number("-1"); x < 4; x += 0.5) { switch (x) { case 0: seen += "a"; break; case 1: seen += "b"; break; case 2: seen += "c"; break; case 3: seen += "d"; break; default: seen += "." } }
console.log(seen)
const loose: any = pick
console.log(loose(4), loose(4.5), loose(-0), loose(NaN), loose(5))
//// switch-on-union-tag.ts
// `switch` on the string discriminant of a union of object types.
type E = { kind: "text"; n: number } | { kind: "tool"; name: string } | { kind: "end" };
function h(e: E): string { switch (e.kind) { case "text": return "t" + e.n; case "tool": return "x" + e.name; case "end": return "e"; } }
const l: E[] = [{ kind: "text", n: 1 }, { kind: "tool", name: "ls" }, { kind: "end" }];
console.log(l.map(h).join());
//// tag-decides-union-member.ts
// A test of a tag says which member of a union an object is, as long as the tag holds what the member was created with. Every way to give an object the tag of another member has to read what plain Bun reads.
type Round = { kind: 1; r: number };
type Wide = { kind: 2; w: number };
type High = { kind: 3; h: number };
type Shape = Round | Wide | High;

function area(s: Shape): number {
  switch (s.kind) {
    case 1:
      return s.r * 3;
    case 2:
      return s.w * 2;
    default:
      return s.h;
  }
}

function makeShape(i: number): Shape {
  const k = i % 3;
  if (k === 0) return { kind: 1, r: i };
  if (k === 1) return { kind: 2, w: i };
  return { kind: 3, h: i };
}

let total = 0;
for (let i = 0; i < 300; i++) total += area(makeShape(i));
console.log("one number a member", total);

type Oval = { kind: 1 | 4; r: number };
type Box = { kind: 2; w: number };
type Bar = { kind: 3; h: number };
type Figure = Oval | Box | Bar;

function size(f: Figure): number {
  switch (f.kind) {
    case 1:
    case 4:
      return f.r * 3;
    case 2:
      return f.w * 2;
    default:
      return f.h;
  }
}

function makeFigure(i: number): Figure {
  const k = i & 3;
  if (k === 0) return { kind: 1, r: i };
  if (k === 1) return { kind: 4, r: i };
  if (k === 2) return { kind: 2, w: i };
  return { kind: 3, h: i };
}

total = 0;
for (let i = 0; i < 300; i++) total += size(makeFigure(i));
console.log("two numbers in one member", total);

type Value = { tag: "value"; ok: true; value: number };
type Failure = { tag: "failure"; ok: false; error: string };
type Result = Value | Failure;

function makeResult(i: number): Result {
  return i % 4 ? { tag: "value", ok: true, value: i } : { tag: "failure", ok: false, error: "e" + i };
}
function byString(r: Result): number | string {
  if (r.tag === "value") return r.value;
  return r.error;
}
function byOtherString(r: Result): number | string {
  if (r.tag !== "failure") return r.value;
  else return r.error;
}
function byBoolean(r: Result): number | string {
  return r.ok ? r.value : r.error;
}
function byNegation(r: Result): number | string {
  if (!r.ok) return r.error;
  return r.value;
}

const seen: (number | string)[] = [];
for (let i = 0; i < 6; i++) {
  const r = makeResult(i);
  seen.push(byString(r), byOtherString(r), byBoolean(r), byNegation(r));
}
console.log("strings and booleans", seen.join());

const retagged = makeShape(0);
(retagged as any).kind = 2;
console.log("the tag of another member", area(retagged), Object.keys(retagged).join());

const outside = makeShape(1);
(outside as any).kind = 9;
console.log("a tag of no member", area(outside));

const untagged = makeShape(3);
delete (untagged as any).kind;
console.log("no tag", area(untagged), Object.keys(untagged).join());

const computed = makeShape(6);
let reads = 0;
Object.defineProperty(computed, "kind", {
  get() {
    reads++;
    return 2;
  },
});
console.log("a tag that a getter answers", area(computed), reads);

function tagReadFirst(s: Shape): number {
  const kind = s.kind;
  (s as any).kind = 2;
  return kind === 1 ? (s as Round).r : -1;
}
console.log("a store between the read and the test", tagReadFirst(makeShape(9)), tagReadFirst(makeShape(10)));

function tagOfAnother(s: Shape, t: Shape): number | undefined {
  return t.kind === 1 ? (s as Round).r : (s as Wide).w;
}
console.log("the tag of another object", tagOfAnother(makeShape(1), makeShape(0)), tagOfAnother(makeShape(0), makeShape(1)), tagOfAnother(makeShape(0), makeShape(0)));

function tagAgainstVariable(s: Shape, kind: number): number | undefined {
  return s.kind === kind ? (s as Round).r : (s as High).h;
}
console.log("a tag compared with a variable", tagAgainstVariable(makeShape(0), 1), tagAgainstVariable(makeShape(0), 2), tagAgainstVariable(makeShape(2), 1), tagAgainstVariable(makeShape(1), 2));

type Zero = { kind: 0; z: number };
type Minus = { kind: number; m: number };
function zeroes(v: Zero | Minus): number | undefined {
  switch (v.kind) {
    case 0:
      return (v as Zero).z;
    default:
      return (v as Minus).m;
  }
}
const zero: Zero = { kind: 0, z: 1 };
const minusZero: Minus = { kind: -0, m: 2 };
const notANumber: Minus = { kind: NaN, m: 3 };
console.log("zero, minus zero and NaN", zeroes(zero), zeroes(minusZero), zeroes(notANumber));

class Leaf {
  kind = 1 as const;
  text = "leaf";
}
class Pair {
  kind = 2 as const;
  left: Tree;
  right: Tree;
  constructor(left: Tree, right: Tree) {
    this.left = left;
    this.right = right;
  }
}
type Tree = Leaf | Pair;
function count(t: Tree): number {
  return t.kind === 1 ? t.text.length : count(t.left) + count(t.right);
}
let tree: Tree = new Leaf();
for (let i = 0; i < 5; i++) tree = new Pair(tree, new Leaf());
console.log("classes", count(tree));

function walk(first: Shape, shapes: Shape[]): number {
  let sum = 0;
  let current = first;
  for (let i = 0; i < shapes.length; i++) {
    if (current.kind === 1) {
      current = shapes[i]!;
      sum += (current as Round).r || 0;
    } else {
      sum += area(current);
      current = shapes[i]!;
    }
  }
  return sum;
}
console.log("another object each turn", walk(makeShape(0), [makeShape(1), makeShape(0), makeShape(3), makeShape(2), makeShape(6)]));
//// union-constant-kind-per-member.ts
// `s.kind === "circle"` on a union whose members each have a constant `kind`.
// CODE isCircle HAS ldu?rb\s+w\d+, \[x26
// CODE notSquare HAS ldu?rb\s+w\d+, \[x26
// CODE pick HAS ldu?rb\s+w\d+, \[x26
// CODE byswitch HAS ldu?rb\s+w\d+, \[x26
// CODE kindOf LACKS ldu?rb\s+w\d+, \[x26
// CODE sameKind LACKS ldu?rb\s+w\d+, \[x26
// CODE isCircleOrText LACKS ldu?rb\s+w\d+, \[x26
// CODE makeCircle LACKS stu?rb\s+w\d+, \[x26
// CODE makeRound LACKS stu?rb\s+w\d+, \[x26
// CODE restate LACKS stu?rb\s+w\d+, \[x26
// CODE storeGiven HAS stu?rb\s+w\d+, \[x26
// CODE makeGiven HAS stu?rb\s+w\d+, \[x26
interface Circle { kind: "circle"; r: number }
interface Square { kind: "square"; w: number }
interface Triangle { kind: "triangle"; a: number; b: number }
type Shape = Circle | Square | Triangle;
function pick(s: Shape): number { return s.kind === "circle" ? s.r : s.kind === "square" ? s.w : s.a + s.b; }
function byswitch(s: Shape): number { switch (s.kind) { case "circle": return s.r; case "square": return s.w; default: return s.a * s.b; } }
function isCircle(s: Shape): boolean { return s.kind === "circle"; }
function notSquare(s: Shape): boolean { return s.kind !== "square"; }
// The value itself is used, or compared with something that is not a constant: an ordinary read.
function kindOf(s: Shape): string { return s.kind; }
function sameKind(s: Shape, t: Shape): boolean { return s.kind === t.kind; }
// A view with a member that is not pinned: `kind: string`.
interface Text { kind: string; text: string }
function isCircleOrText(s: Circle | Text): boolean { return s.kind === "circle"; }
function makeCircle(r: number): Circle { return { kind: "circle", r }; }
class Round { readonly kind = "round"; constructor(public r: number) {} }
function makeRound(r: number): Round { return new Round(r); }
function isRound(s: Round | Square): boolean { return s.kind === "round"; }
// Storing the constant that it is pinned to again: nothing to guard. Anything else: the byte.
function restate(c: Circle): void { c.kind = "circle"; }
function storeGiven(c: Circle, k: "circle"): void { c.kind = k; }
function makeGiven(k: "circle", r: number): Circle { return { kind: k, r }; }
const asValues: unknown[] = [pick, byswitch, isCircle, notSquare, kindOf, sameKind, isCircleOrText, makeCircle, makeRound, isRound, restate, storeGiven, makeGiven];
const xs: Shape[] = [];
for (let i = 0; i < 12; i++) xs.push(i % 3 === 0 ? { kind: "circle", r: i } : i % 3 === 1 ? { kind: "square", w: i } : { kind: "triangle", a: i, b: 2 });
let sum = 0;
for (const s of xs) sum += pick(s) + byswitch(s) + (isCircle(s) ? 100 : 0) + (notSquare(s) ? 1000 : 0);
console.log(sum, asValues.length);
const c = makeCircle(5), text: Text = { kind: "circle", text: "t" };
console.log(kindOf(c), sameKind(c, xs[0]!), sameKind(c, xs[1]!), isCircleOrText(c), isCircleOrText(text), isCircleOrText({ kind: "other", text: "t" }), isRound(makeRound(1)), isRound(xs[1] as Square));
restate(c); console.log(isCircle(c), pick(c));
storeGiven(c, "circle"); console.log(isCircle(c), pick(c), isCircle(makeGiven("circle", 2)), isCircle(xs[1]!), byswitch(xs[2]!));
//// union-member-chosen-at-runtime.ts
// Which member of a union an object literal belongs to depends on a run-time value.
interface Tree { kind: number }
type Result =
  | { type: Tree; fallback: undefined }
  | { type: undefined; fallback: true }
  | { type: undefined; fallback: false }
function result(type: Tree | undefined): Result
function result(type: undefined, fallback: boolean): Result
function result(type: Tree | undefined, fallback: boolean = true) {
  return { type, fallback: type ? undefined : fallback } as Result
}
const no: Result = result(undefined, false)
const yes: Result = result(undefined, true)
const tree: Result = result({ kind: 7 })
for (const r of [no, yes, tree]) console.log(r.type ? r.type.kind : "none", r.fallback, Object.keys(r).join())
