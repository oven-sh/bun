////: ofClasses
function ofClasses(n: number) {
  let held = boxed(n);
  seen.push(held.held);
  while (held instanceof Crate) {
    const crate = held;
    const inner = crate.more;
    seen.push(crate.held.length);
    if (!inner) break;
    held = inner;
  }
  return held.held;
}
////: ofRows
function ofRows(n: number) {
  let held = row(n);
  seen.push(held.k);
  if (held.k === "a") {
    const narrowed = held;
    const list = [narrowed];
    seen.push(list[0].a);
    held = narrowed;
  } else {
    const { field } = { field: held };
    seen.push(field.b);
    held = field;
  }
  return held;
}
////: pick
function pick(word: "a" | "b"): string {
  return word === "a" ? "first" : "second";
}
