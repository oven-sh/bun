////: Crate
class Crate {
  constructor(
    public held: string,
    public more: Box | undefined,
  ) {}
}
////: byAClosure
function byAClosure(n: number) {
  let held = either(n);
  const read = () => held;
  seen.push(read());
  if (typeof held === "number") {
    const narrowed = held;
    const again = (value = narrowed) => value;
    seen.push(again() + 1);
    held = again();
  }
  return read();
}
////: double
function double(count: 0 | 1): number {
  return count * 2;
}
////: for
for (const [name, handler] of table) {
  handler();
  onName(name);
}
////: lengths
function lengths(value: string | number[], rounds: number): number {
  let r = 0;
  for (let i = 0; i < rounds; i++) {
    r = (r + value.length) | 0;
    const unit = value[i & 3];
    r = (r + (typeof unit === "string" ? unit.charCodeAt(0) : unit ?? -1)) | 0;
    r ^= value.length << 3;
  }
  return r;
}
