}
function staysNull() {
  let socket: Socket | null = null;
  later(() => {});
  // @ts-ignore
  return socket?.end();
}
function inFinally() {
  let socket: Socket | null = null;
  try {
    later(() => {
      socket = new Socket();
    });
    return "tried";
  } finally {
    // @ts-ignore
    console.log("finally:", socket?.end());
  }
}
async function acrossAnAwait() {
  const { promise, resolve } = Promise.withResolvers<string>();
