////: throughTwo
function throughTwo(n: number) {
  let held = either(n);
  seen.push(held);
  for (let i = 0; i < 3; i++) {
    if (typeof held === "number") {
      const first = held;
      const second = first;
      seen.push(second * 2);
      held = i === 1 ? "stopped" : second + 1;
    }
  }
  return held;
}
