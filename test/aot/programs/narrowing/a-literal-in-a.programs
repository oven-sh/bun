const two: Deep<S2> = { id: "b", type: "t2", status: "busy", tags: ["x", "y"], meta: { at: 2 }, own2: 2, extra2: 20 };
const one: Deep<S1> = { id: "a", type: "t1", status: "idle", tags: [], meta: { at: 1 }, own1: 1 };
const four: Deep<S4> = { id: "d", type: "t4", status: "idle", tags: [], meta: { at: 4 }, own4: 4, extra4: 40 };
export function second(): string { return [row8(two), row8(one), row5(four), row3(two)].join(" "); }
//// union-passed-between-modules/files/third.ts
import type { Deep } from "./deep";
import type { S6 } from "./s6";
import type { S4 } from "./s4";
import type { Any5, Any8 } from "./any";
import { from, parse5, parse8, plain5 } from "./parse";
import { row5, row8 } from "./row";
const six: Deep<S6> = { id: "f", type: "t6", status: "idle", tags: [], meta: { at: 6 }, own6: 6, extra6: 60 };
const four: Deep<S4> = { id: "d", type: "t4", status: "idle", tags: [], meta: { at: 4 }, own4: 4, extra4: 40 };
function again(task: Deep<Any8>): Deep<Any8> { return JSON.parse(JSON.stringify(task)) as Deep<Any8>; }
function again5(task: Any5): Any5 { return JSON.parse(JSON.stringify(task)) as Any5; }
export function third(): string {
    return [row8(six), row5(four), row5(parse5('{"id":"a","type":"t1","status":"idle","tags":[],"meta":{"at":1},"own1":1}')), row8(parse8('{"id":"g","type":"t7","status":"busy","tags":[],"meta":{"at":7},"own7":7}')),
        row5(plain5('{"id":"b","type":"t2","status":"busy","tags":[],"meta":{"at":2},"own2":2,"extra2":20}')), row8(from(six)), row8(again(six)), row5(again5(plain5('{"id":"c","type":"t3","status":"idle","tags":[],"meta":{"at":3},"own3":3}')))].join(" ");
}
//// union-passed-between-modules/main.ts
// A union of object types is passed between modules as a whole, as a narrowed subset and as a single member.
import { first } from "./files/first";
import { second } from "./files/second";
import { third } from "./files/third";
import { calls } from "./files/calls";
console.log(first());
console.log(second());
console.log(third());
console.log(calls());
//// union-shares-only-discriminant/files/guards.ts
import type { All, Deep, I3, Sub6 } from "./nodes";
import { kindOf, lit, parse, parseLit, take, takeDeep } from "./take";
export function isSub6(node: All): node is Sub6 { return node.kind !== "k1" && node.kind !== "k8"; }
export function byGuard(node: All): string { return isSub6(node) ? take(node) : "-"; }
export function byChain(node: All): string { if (node.kind === "k1") return "1"; if (node.kind === "k8") return "8"; return take(node) + takeDeep(node); }
export function single(node: I3): string { return take(node) + takeDeep(node); }
export function deepSingle(node: Deep<I3>): string { return takeDeep(node); }
export function parsed(): string { return take(parse('{"kind":"k4","own4":4}')) + kindOf(parseLit('{"kind":"l2","v2":2}')) + kindOf(lit(3)) + kindOf(lit(5)); }
//// union-shares-only-discriminant/files/nodes.ts
export interface I1 { kind: "k1"; own1: number }
export interface I2 { kind: "k2"; own2: number }
export interface I3 { kind: "k3"; own3: number }
export interface I4 { kind: "k4"; own4: number }
export interface I5 { kind: "k5"; own5: number }
export interface I6 { kind: "k6"; own6: number }
export interface I7 { kind: "k7"; own7: number }
export interface I8 { kind: "k8"; own8: number }
export type All = I1 | I2 | I3 | I4 | I5 | I6 | I7 | I8;
export type Sub6 = I2 | I3 | I4 | I5 | I6 | I7;
export type Lit = { kind: "l1"; v1: number } | { kind: "l2"; v2: number } | { kind: "l3"; v3: number } | { kind: "l4"; v4: number } | { kind: "l5"; v5: number };
export type Deep<T> = T extends object ? { readonly [K in keyof T]: Deep<T[K]> } : T;
//// union-shares-only-discriminant/files/take.ts
import type { All, Deep, Lit } from "./nodes";
export function take(node: All): string { return node.kind; }
export function takeDeep(node: Deep<All>): string { return node.kind; }
export function parse(text: string): All { return JSON.parse(text) as All; }
export function lit(n: number): Lit {
    switch (n) {
        case 1: return { kind: "l1", v1: 1 };
        case 2: return { kind: "l2", v2: 2 };
        case 3: return { kind: "l3", v3: 3 };
        case 4: return { kind: "l4", v4: 4 };
        default: return { kind: "l5", v5: 5 };
    }
}
export function parseLit(text: string): Deep<Lit> { return JSON.parse(text) as Deep<Lit>; }
export function kindOf(l: Deep<Lit>): string { return l.kind; }
//// union-shares-only-discriminant/main.ts
// A union of object types that have only the discriminant in common.
import type { All, I1, I3, I5, I8 } from "./files/nodes";
import { byChain, byGuard, deepSingle, parsed, single } from "./files/guards";
const one: I1 = { kind: "k1", own1: 1 };
const three: I3 = { kind: "k3", own3: 3 };
const five: I5 = { kind: "k5", own5: 5 };
const eight: I8 = { kind: "k8", own8: 8 };
const all: All[] = [one, three, five, eight];
console.log(all.map(byGuard).join(), all.map(byChain).join(), single(three), deepSingle(three), parsed());
//// unions-that-do-not-change-in-a-loop.ts
// A value of a union type is used several times in each iteration of a loop that does not change it, so its type can be tested once in front of the loop. Every member of each union arrives, loops run zero times, and close neighbors change the value in the loop.
type Text = string | number[] | undefined;

////= lengths

function optional(value: Text, rounds: number): string {
  let out = "";
  for (let i = 0; i < rounds; i++) {
    if (value === undefined) out += "-";
    else out += value.length;
    if (typeof value === "string") out += value[i] ?? "?";
    else if (value !== undefined) out += value[i] ?? "!";
  }
  return out;
}

function leavesTheLoop(value: string | number, rounds: number): number {
  let r = 0;
  for (let i = 0; i < rounds; i++) {
    if (typeof value !== "string") return -1 - i - value;
    r += value.length;
    if (typeof value === "string") r += value.charCodeAt(i % value.length);
  }
  return r;
}

function nested(outer: string | number[], inner: number | string, rounds: number): number {
  let r = 0;
  for (let i = 0; i < rounds; i++) {
    r += outer.length;
    for (let j = 0; j < i; j++) {
      r += typeof inner === "string" ? inner.length : inner;
      r += typeof outer === "string" ? outer.charCodeAt(j % outer.length) : outer[j % outer.length];
      r += typeof inner === "number" ? inner * 2 : inner.charCodeAt(0);
    }
  }
  return r;
}

function changesInTheLoop(first: string | number[], second: string | number[], rounds: number): number {
  let value = first;
  let r = 0;
  for (let i = 0; i < rounds; i++) {
    r += value.length;
    if (i % 3 === 1) value = value === first ? second : first;
    r += typeof value === "string" ? value.charCodeAt(0) : value[0];
    r += value.length;
  }
  return r;
}

function changesOnce(value: string | number, rounds: number): string {
  let out = "";
  for (let i = 0; i < rounds; i++) {
    out += typeof value === "string" ? value.length : value + 1;
    if (i === 2) value = typeof value === "string" ? value.length : "n" + value;
    out += typeof value === "string" ? "s" : "n";
  }
  return out;
}

function underHandler(value: string | null, rounds: number): string {
  let out = "";
  for (let i = 0; i < rounds; i++) {
    try {
      out += (value as string).length;
      out += value === null ? "null" : value[i % 2];
    } catch (error) {
      out += (error as Error).constructor.name;
    }
  }
  return out;
}

const texts: (string | number[])[] = ["abcd", "é☃", "", [1, 2, 3, 4, 5], [], [7]];
for (const rounds of [0, 1, 2, 7]) {
  console.log(rounds, texts.map(text => lengths(text, rounds)).join(","));
  console.log(rounds, [...texts, undefined].map(text => optional(text, rounds)).join(","));
  console.log(rounds, ["xy", 5, "z", -0.5].map(value => leavesTheLoop(value, rounds)).join(","));
  console.log(rounds, texts.filter(text => text.length > 0).flatMap(text => [nested(text, 3, rounds), nested(text, "pq", rounds)]).join(","));
  console.log(rounds, changesInTheLoop("ab", [9, 8], rounds), changesInTheLoop([5], "xyz", rounds), changesInTheLoop("a", "bc", rounds));
  console.log(rounds, changesOnce("abc", rounds), changesOnce(4, rounds));
  console.log(rounds, underHandler("ok", rounds), underHandler(null, rounds));
}
//// values-of-every-kind-where-closures-capture-a-string-that-equals-an-imported-constant-in-a-validating-build/main.ts
import { READ_TOOL } from "./names";
type Decision = { behavior: string; message: string } | null;
type Hooks = {
  replyGrant: null;
  threadId: () => string | undefined;
  lateDeny: () => Decision;
  askRule: (rules: string[]) => string;
  updatedInput: () => undefined;
};
class Notice {
  async decide(context: { depth: number }, target: string, hooks: Hooks): Promise<string> {
    await null;
    return [context.depth, target, hooks.threadId(), JSON.stringify(hooks.lateDeny()), hooks.askRule(["a", "read_comments"]), hooks.updatedInput()].join(" | ");
  }
}
function noticeRead(input: unknown): Notice | undefined {
  return typeof input === "object" && input !== null ? new Notice() : undefined;
}
function refusal(name: string, input: unknown): Decision | undefined {
  return name.charCodeAt(0) === 114 && input !== null ? { behavior: "deny", message: name.slice(5) + name.length } : undefined;
}
function ruleForCall(rules: string[], name: string): { rule: string } | undefined {
  const found = rules.find(rule => rule === name);
  return found === undefined ? undefined : { rule: found + ":" + name.toUpperCase() };
}
async function check(name: string, input: unknown): Promise<string> {
  if (name === READ_TOOL) {
    const under = await noticeRead(input)?.decide({ depth: 1 }, "target", {
      replyGrant: null,
      threadId: () => undefined,
      lateDeny: () => refusal(name, input) ?? null,
      askRule: rules => ruleForCall(rules, name)?.rule ?? "none",
      updatedInput: () => undefined,
    });
    return "under " + String(under);
  }
  return "past " + typeof name;
}
class Named {
  [Symbol.toPrimitive]() {
    return "read_comments";
  }
}
const values: any[] = [
  "read_comments",
  "read_" + String(["comments"]),
  ["read", "comments"].join("_"),
  "write_comments",
  "",
  new String("read_comments"),
  { toString: () => "read_comments" },
  { valueOf: () => "read_comments" },
  new Named(),
  ["read_comments"],
  () => "read_comments",
  Symbol.for("read_comments"),
  new Proxy({}, {}),
  Object.create(null),
  /read_comments/,
  new Date(0),
  1,
  -0,
  NaN,
  1n,
  true,
  false,
  null,
  undefined,
];
for (let round = 0; round < 40; round++) {
  const lines: string[] = [];
  for (const value of values) for (const input of [{}, null, 1]) lines.push(await check(value, input));
  if (round === 0 || round === 39) console.log(lines.join("\n"));
}
//// values-of-every-kind-where-closures-capture-a-string-that-equals-an-imported-constant-in-a-validating-build/names.ts
export const READ_TOOL = "read_comments";
