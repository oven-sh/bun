//// a-built-in-called-by-a-promise-rejects-its-operand-then-reads-the-message.mjs
// A promise reaction calls Math.abs with a symbol: the next handler gets the TypeError of the conversion.
Promise.resolve(Symbol.iterator).then(Math.abs).catch(e => console.log(e.message));
//// a-built-in-called-by-a-promise-rejects-its-operand-then-looks-at-the-error.mjs
// As its neighbor that reads the message: the handler compares, converts and asks for the type of what it gets.
Promise.resolve(Symbol.iterator).then(Math.abs).catch(e => console.log("" + e, e === undefined, typeof e));
//// a-built-in-called-by-a-promise-rejects-its-operand-then-with-a-bigint.mjs
// Math.abs rejects a BigInt.
Promise.resolve(1n).then(Math.abs).catch(caught => console.log("" + caught, caught === undefined, typeof caught, caught instanceof TypeError, caught.name, caught.message));
//// a-built-in-called-by-a-promise-rejects-its-operand-then-after-another-reaction.mjs
// The symbol passes through a reaction of the program first.
Promise.resolve(Symbol.iterator).then(n => n).then(Math.abs).catch(caught => console.log("" + caught, caught === undefined, typeof caught, caught instanceof TypeError, caught.name, caught.message));
//// a-built-in-called-by-a-promise-rejects-its-operand-then-on-the-promise-of-an-async-function.mjs
// The symbol comes out of an async function.
(async () => Symbol.iterator)().then(Math.abs).catch(caught => console.log("" + caught, caught === undefined, typeof caught, caught instanceof TypeError, caught.name, caught.message));
//// a-built-in-called-by-a-promise-rejects-its-operand-then-and-the-second-argument-of-then.mjs
// The handler is the second argument of then.
Promise.resolve(Symbol.iterator).then(Math.abs).then(undefined, caught => console.log("" + caught, caught === undefined, typeof caught, caught instanceof TypeError, caught.name, caught.message));
//// a-built-in-called-by-a-promise-rejects-its-operand-then-and-finally.mjs
// A finally stands between the reaction and the handler.
Promise.resolve(Symbol.iterator).then(Math.abs).finally(() => {}).catch(caught => console.log("" + caught, caught === undefined, typeof caught, caught instanceof TypeError, caught.name, caught.message));
//// a-built-in-called-by-a-promise-rejects-its-operand-then-bound.mjs
// The reaction is Math.abs bound to nothing.
Promise.resolve(Symbol.iterator).then(Math.abs.bind(null)).catch(caught => console.log("" + caught, caught === undefined, typeof caught, caught instanceof TypeError, caught.name, caught.message));
//// a-built-in-called-by-a-promise-rejects-its-operand-then-bound-to-an-object-whose-conversion-throws-a-number.mjs
// What the conversion of the operand throws is no object.
Promise.resolve().then(Math.abs.bind(undefined, { valueOf() { throw 7; } })).catch(caught => console.log(typeof caught, caught === undefined, caught + 1));
//// a-built-in-called-by-a-promise-rejects-its-operand-then-with-several-arguments.mjs
// Math.max converts each argument.
Promise.resolve(Symbol.iterator).then(Math.max).catch(caught => console.log("" + caught, caught === undefined, typeof caught, caught instanceof TypeError, caught.name, caught.message));
//// a-built-in-called-by-a-promise-rejects-its-operand-then-with-a-global-function.mjs
// isNaN converts its argument to a number.
Promise.resolve(Symbol.iterator).then(isNaN).catch(caught => console.log("" + caught, caught === undefined, typeof caught, caught instanceof TypeError, caught.name, caught.message));
//// a-built-in-called-by-a-promise-rejects-its-operand-then-with-a-function-that-takes-only-symbols.mjs
// Symbol.keyFor rejects what is no symbol.
Promise.resolve(1).then(Symbol.keyFor).catch(caught => console.log("" + caught, caught === undefined, typeof caught, caught instanceof TypeError, caught.name, caught.message));
//// a-built-in-called-by-a-promise-rejects-its-operand-ways-that-were-always-right.mjs
// The same error by other ways: an arrow function around the call, await in a try block, a promise made with new, Number in place of Math.abs.
Promise.resolve(Symbol.iterator).then(v => Math.abs(v)).catch(caught => console.log("" + caught, caught === undefined, typeof caught, caught instanceof TypeError, caught.name, caught.message));
try { await Promise.resolve(Symbol.iterator).then(Math.abs); } catch (error) { (caught => console.log("" + caught, caught === undefined, typeof caught, caught instanceof TypeError, caught.name, caught.message))(error); }
new Promise(resolve => resolve(Symbol.iterator)).then(Math.abs).catch(caught => console.log("" + caught, caught === undefined, typeof caught, caught instanceof TypeError, caught.name, caught.message));
Promise.resolve(Symbol.iterator).then(Number).catch(caught => console.log("" + caught, caught === undefined, typeof caught, caught instanceof TypeError, caught.name, caught.message));
Promise.resolve(Symbol.iterator).then(Math.abs).catch(e => console.log(String(e)));
