// new Map(Object.entries(literal)): the values of the map are the values of the literal, and arithmetic on what get() answers is arithmetic on numbers.
const log = [];
const words = { abstract: 128, any: 133, as: 130 };
const byText = new Map(Object.entries(words));
function kindOf(text) { const kind = byText.get(text); return kind === undefined ? -1 : kind + 1; }
log.push(kindOf("any"), kindOf("none"), byText.size, [...byText.keys()].join(), typeof [...byText.values()][0]);
console.log(log.join("; "));
//// entries-a-pair-is-changed-before-the-map-is-made.js
// The program stores into the pairs that Object.entries has made and pushes a pair of its own before it hands the array to the constructor of a Map.
const log = [];
const entries = Object.entries({ a: 1, b: 2 });
entries[0][1] = "text"; entries[1][0] = 7; entries.push([{ key: true }, null]);
const map = new Map(entries);
for (const [key, value] of map) log.push(typeof key + ":" + typeof value);
log.push(String(map.get("a")).length, map.get(7) + 1);
console.log(log.join("; "));
//// entries-built-ins-change-the-pairs-before-the-map-is-made.js
// reverse, fill, push and Object.assign change the pairs that Object.entries has made before the constructor of a Map takes them apart.
const log = [];
const entries = Object.entries({ a: 1, b: 2, c: 3 });
entries[0].reverse(); entries[1].fill("f"); entries[2].push("more"); Object.assign(entries[2], { 1: [9] });
const map = new Map(entries);
for (const [key, value] of map) log.push(typeof key + ":" + typeof value);
console.log(log.join("; "));
//// entries-getters-and-other-values-among-the-own-values.js
// Object.entries runs a getter of its operand with the operand as this, leaves out what is not enumerable, and the Map made of the pairs holds instances, strings, undefined and a function.
const log = [];
class Body { constructor() { this.hits = 1; } }
const source = { plain: 1, get made() { log.push("getter " + (this === source)); return new Body(); }, text: "t", nothing: undefined, fn() { return 5; } };
Object.defineProperty(source, "hidden", { value: "no", enumerable: false });
const map = new Map(Object.entries(source));
log.push(map.size, map.get("made").hits, typeof map.get("text"), typeof map.get("nothing"), map.get("fn")(), map.has("hidden"));
console.log(log.join("; "));
//// entries-of-arrays-strings-proxies-and-instances.js
// Object.entries of an array, a string, an instance, a proxy with traps, a number and null.
const log = [];
class Point { constructor() { this.x = 1; this.y = "two"; } get sum() { return 3; } }
log.push(JSON.stringify([...new Map(Object.entries(["a", "b"]))]), JSON.stringify([...new Map(Object.entries("hi"))]), JSON.stringify([...new Map(Object.entries(new Point()))]));
const proxy = new Proxy({ p: 1 }, { get(target, key) { return key === "p" ? "trapped" : target[key]; }, ownKeys() { return ["p"]; } });
log.push(JSON.stringify([...new Map(Object.entries(proxy))]), JSON.stringify([...new Map(Object.entries(7))]));
try { Object.entries(null); } catch (error) { log.push(error.constructor.name); }
console.log(log.join("; "));
//// entries-pairs-are-changed-in-every-way.js
// The pairs that Object.entries has made grow, get holes, shrink, take numbers alone, are reversed, shifted, frozen, mixed with other arrays, lose an element and get another prototype.
const log = [];
const source = { a: 1, b: 2, c: 3 };
const grown = Object.entries(source); for (const pair of grown) { pair.push(pair[1] * 0.5); pair[5] = "far"; } log.push(JSON.stringify(grown));
const shrunk = Object.entries(source); for (const pair of shrunk) { pair.length = 1; pair.push(1.5); } log.push(JSON.stringify(shrunk));
const numbers = Object.entries(source); for (const pair of numbers) { pair[0] = 1; pair[1] = 2; pair.reverse(); } log.push(JSON.stringify(numbers), numbers[0][0] + numbers[0][1]);
const shifted = Object.entries(source); for (const pair of shifted) { pair.shift(); pair.unshift(0.25, -0); } log.push(JSON.stringify(shifted), Object.is(shifted[1][1], -0));
const frozen = Object.entries(source).map(Object.freeze); try { "use strict"; frozen[0][0] = "no"; } catch (error) { log.push(error.constructor.name); } log.push(frozen[0][0], Object.isFrozen(frozen[2]));
const mixed = [...Object.entries(source), [1, 2], [0.5, 1.5], ["s", {}]]; let sum = ""; for (const pair of mixed) sum += typeof pair[0] + typeof pair[1] + pair.length; log.push(sum);
const deleted = Object.entries(source); delete deleted[0][0]; log.push(0 in deleted[0], deleted[0].length, String(deleted[0][0]));
const reparented = Object.entries(source); Object.setPrototypeOf(reparented[0], { get 7() { return "seven"; }, length: "not mine" }); log.push(reparented[0][7], reparented[0].length, Array.isArray(reparented[0]), typeof reparented[0].map);
console.log(log.join(" | "));
//// entries-pairs-are-taken-apart-in-a-loop.js
// Two loops take the pairs of Object.entries apart, one by destructuring and one by index, many times over.
const table = { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 };
function total(object) { let sum = 0; for (const [key, value] of Object.entries(object)) sum += value + key.length; return sum; }
function pairs(object) { let sum = 0; const list = Object.entries(object); for (let i = 0; i < list.length; i++) { const pair = list[i]; sum += pair[1] + pair[0].length + pair.length; } return sum; }
let sum = 0;
for (let round = 0; round < 200000; round++) sum += total(table) + pairs(table);
console.log(sum);
//// entries-the-pairs-come-into-hands-nobody-follows.js
// The array that Object.entries has made goes through a name of the global object to a function that stores into a pair, and then to the constructor of a Map.
const log = [];
const entries = Object.entries({ a: 1, b: 2 });
const touch = process.argv.length > 99 ? null : { run(list) { list[0][1] = { deep: 1 }; } };
globalThis.__touch = touch; globalThis.__touch.run(entries);
const map = new Map(entries);
log.push(typeof map.get("a"), typeof map.get("b"), map.get("a").deep);
console.log(log.join("; "));
//// entries-the-pairs-go-through-other-arrays-first.js
// The pairs are sorted, filtered, mapped to other pairs and spread beside pairs of the program before a Map is made of them.
const log = [];
const source = { b: 2, a: 1, c: 3 };
const sorted = new Map(Object.entries(source).sort(([x], [y]) => (x < y ? -1 : 1)));
const kept = new Map(Object.entries(source).filter(([, value]) => value > 1));
const turned = new Map(Object.entries(source).map(([key, value]) => [value, key]));
const joined = new Map([...Object.entries(source), ...Object.entries({ d: "four" }), [5, 5]]);
log.push([...sorted.keys()].join(), [...kept.values()].join(), typeof turned.get(1), typeof joined.get("d"), typeof joined.get(5), typeof joined.get("a"));
console.log(log.join("; "));
//// entries-the-pairs-seen-by-loops-and-changed-after-the-map-is-made.js
// Loops destructure the pairs and store into them; a store into a pair after the Map is made does not reach the Map.
const log = [];
const source = { a: 1, b: "two" };
for (const [key, value] of Object.entries(source)) log.push(key + "=" + typeof value);
for (const pair of Object.entries(source)) { pair[1] = pair[0]; log.push(pair.join("")); }
const entries = Object.entries(source); const first = entries[0];
const map = new Map(entries); first[1] = "late";
log.push(typeof map.get("a"), Array.isArray(first), first.length, entries.length, Object.fromEntries(entries).a);
console.log(log.join("; "));
//// entries-two-maps-of-two-literals.js
// Two maps made of the entries of two literals go through one function; one of them gets a value of another type later.
const log = [];
const numbers = new Map(Object.entries({ a: 1 }));
const texts = new Map(Object.entries({ a: "one" }));
function double(map, key) { const found = map.get(key); return found + found; }
log.push(double(numbers, "a"), double(texts, "a"));
numbers.set("late", "text"); log.push(double(numbers, "late"));
console.log(log.join("; "));
//// exports-a-method-of-a-library-prototype-is-replaced.ts
// Exports of start-up modules: the program replaces EventEmitter.prototype.emit, as tracing tools do, so the library's own calls of emit, in streams and in the process, reach the program's function with the library's arguments.
import { EventEmitter } from "node:events";
import { Readable } from "node:stream";

let total = 0;
const names = new Set<string>();
const original = EventEmitter.prototype.emit;

function traced(this: EventEmitter, name: string, value: number): boolean {
  total += typeof name === "string" ? 1 : 1000000;
  if (typeof value !== "number" && value !== undefined) names.add(typeof value);
  return Reflect.apply(original, this, arguments);
}

EventEmitter.prototype.emit = traced as typeof original;
const own = new EventEmitter();
own.on("value", () => {});
own.emit("value", 1);
own.emit(Symbol("s"), 2);
let chunks = 0;
for await (const chunk of Readable.from(["a", "b"])) chunks += String(chunk).length;
EventEmitter.prototype.emit = original;
own.emit("value", 3);
console.log(total > 1000002, total % 1000000 > 2, chunks, [...names].sort().join());
//// exports-custom-inspect-depth-is-null-or-negative.ts
// Exports of start-up modules: util.inspect passes null as the depth where { depth: null } was asked for, while the method's parameter says number and the program's own call passes one.
import { inspect } from "node:util";

let total = 0;

class Level {
  constructor(public below: Level | null) {}
  [inspect.custom](depth: number, options: { depth?: number | null }, again: typeof inspect): string {
    total += typeof depth === "number" ? 1 : depth === null ? 100 : 10000;
    total += depth + 1 > 0 ? 1000000 : 0;
    return this.below ? "(" + again(this.below, { ...options, depth: options.depth == null ? null : options.depth - 1 }) + ")" : "end";
  }
}

const chain = new Level(new Level(new Level(null)));
chain[inspect.custom](2, { depth: 2 }, inspect);
const texts = [inspect(chain, { depth: null }), inspect(chain, { depth: 0 }), inspect(chain, { depth: -5 }), inspect(chain, { depth: Infinity }), inspect({ a: { b: { c: chain } } }, { depth: 1 })];
console.log(total, texts.join("").length);
//// exports-custom-inspect-gets-depth-options-and-inspect.ts
// Exports of start-up modules: console.log calls the custom inspect method with (number, object, function), while the program itself only ever passes three strings.
const custom = Symbol.for("nodejs.util.inspect.custom");

class Box {
  [custom](depth: string, options: string, inspect: string): string {
    let seen = 0;
    seen += typeof depth === "string" ? 1 : typeof depth === "number" ? 20 : 300;
    seen += typeof options === "string" ? 1000 : typeof options === "object" ? 20000 : 300000;
    seen += typeof inspect === "string" ? 1000000 : typeof inspect === "function" ? 20000000 : 300000000;
    return String(seen);
  }
}

const box = new Box();
const own = Number(box[custom]("a", "b", "c"));
console.log(box, own);
//// exports-custom-inspect-methods-of-host-classes-are-called-by-the-program.ts
// Exports of start-up modules: classes of the host have a native custom inspect method that calls util.inspect of a start-up module; the program reads the method and calls it itself, with honest arguments, with odd ones and with none.
import { inspect } from "node:util";

const custom = Symbol.for("nodejs.util.inspect.custom");
let calls = 0;
const mine = (value: unknown, options?: unknown): string => {
  calls++;
  return "mine " + typeof value + " " + typeof options;
};

function attempt(run: () => unknown): number {
  try {
    return String(run()).length;
  } catch {
    return -1;
  }
}

const things: any[] = [new URLSearchParams("a=1"), new ReadableStream(), new WritableStream(), new TransformStream(), new URL("http://localhost/b")];
const lengths: number[] = [];
for (const thing of things) {
  lengths.push(attempt(() => thing[custom](1, {}, inspect)), attempt(() => thing[custom](1, {}, mine)), attempt(() => thing[custom]()), attempt(() => thing[custom]("deep", 5, "text")), attempt(() => thing[custom].call({}, 0, {}, mine)), attempt(() => inspect(thing, { depth: -1 })));
}
console.log(lengths.join(), calls);
//// exports-custom-inspect-result-is-printed-again.ts
// Exports of start-up modules: what a custom inspect method returns goes back to the printer, which looks for a custom inspect method on it and calls that with its own arguments.
const custom = Symbol.for("nodejs.util.inspect.custom");

let total = 0;

class Inner {
  [custom](depth: string): string {
    total += typeof depth === "string" ? 1 : typeof depth === "number" ? 100 : 10000;
    return "inner";
  }
}

class Outer {
  made = new Inner();
  [custom](): Inner {
    total += 1000000;
    return this.made;
  }
}

const outer = new Outer();
outer.made[custom]("mine");
console.log(outer, [outer]);
console.log(total);
//// exports-emitter-rejection-method-gets-what-a-listener-rejected-with.ts
// Exports of start-up modules and methods found through instances: an emitter that captures rejections calls its Symbol.for("nodejs.rejection") method with whatever an async listener rejected with.
import { EventEmitter } from "node:events";

////= Failure

let total = 0;

class Bus extends EventEmitter {
  constructor() {
    super({ captureRejections: true });
  }
  [Symbol.for("nodejs.rejection")](error: Failure, event: string, first: number): void {
    total += error instanceof Failure ? error.code : typeof error === "string" ? 100 : error === undefined ? 1000 : 10000;
    total += typeof event === "string" ? 100000 : typeof event === "symbol" ? 1000000 : 0;
    total += typeof first === "number" ? first : typeof first === "string" ? 10000000 : 0;
  }
}

const bus = new Bus();
(bus as any)[Symbol.for("nodejs.rejection")](new Failure("mine"), "own", 1);
const name = Symbol("event");
bus.on("text", async () => { throw "text"; });
bus.on("nothing", async () => { throw undefined; });
bus.on(name, async () => { throw new Failure("late"); });
bus.emit("text", 2);
bus.emit("nothing", "two");
bus.emit(name);
setTimeout(() => console.log(total), 10);
//// exports-inspect-handed-to-a-custom-method-is-called.ts
// Exports of start-up modules: console.log hands util.inspect itself to a custom inspect method, and the program calls it with every form of its second parameter.
const custom = Symbol.for("nodejs.util.inspect.custom");
type Inspect = (value: unknown, ...rest: any[]) => string;

let total = 0;

class Wrapper {
  inner = { a: { b: { c: { d: 1 } } }, list: [1, "two", 3n] };
  [custom](depth: number, options: object, inspect: Inspect): string {
    total += inspect(this.inner, options).length;
    total += inspect(this.inner, { ...options, depth: 0 }).length * 10;
    total += inspect(this.inner, { depth: null, compact: true, breakLength: Infinity }).length * 100;
    total += inspect(this.inner, true, 1, false).length * 1000;
    total += inspect(this.inner, 5).length * 10000;
    total += inspect(this.inner, "text").length * 100000;
    total += inspect(new Map<unknown, unknown>([[1, { a: 1 }], ["k", new Set([1])]]), undefined).length;
    total += inspect(Symbol("s")).length + inspect(-0).length + inspect(undefined).length + (inspect as any)().length;
    return "wrapper";
  }
}

console.log(new Wrapper());
console.log(total);
