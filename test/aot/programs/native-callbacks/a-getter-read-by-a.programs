// Callbacks handed over: setTimeout, setInterval and setImmediate call back with their extra arguments and queueMicrotask with none, so a number parameter gets a string, an object or undefined; direct calls pass numbers.
let total = 0;

function add(a: number, b: number): void {
  total += typeof a === "number" ? a : typeof a === "string" ? 1000 : a === undefined ? 10000 : 100000;
  total += typeof b === "number" ? b : typeof b === "string" ? 1000000 : b === undefined ? 10000000 : 100000000;
}

add(1, 2);
const loose: any = add;
setTimeout(add, 1, 3, 4);
setTimeout(loose, 1, "three");
setTimeout(loose, 1, {}, []);
setTimeout(loose, 1);
setImmediate(loose, "x", "y");
queueMicrotask(loose);
let rounds = 0;
const interval = setInterval(
  (a: number, b: number) => {
    add(a, b);
    if (++rounds < 2) return;
    clearInterval(interval);
    console.log(total);
  },
  5,
  5,
  "five" as any,
);
//// callbacks-web-stream-sources-and-sinks.ts
// Callbacks handed over and methods found through instances: the streams call start, pull, cancel, write, abort, transform and size on class instances, with controllers, with any chunk and with any reason; the program's own calls pass numbers.
export {};

let total = 0;

class Source {
  sent = 0;
  pull(controller: number): void {
    total += typeof controller === "number" ? 1 : 100;
    if (typeof controller !== "number") (controller as any).enqueue(this.sent++ === 0 ? "chunk" : 5);
  }
  cancel(reason: number): void {
    total += typeof reason === "number" ? 10000 : typeof reason === "string" ? 100000 : 1000000;
  }
}

class Sink {
  write(chunk: number): void {
    total += typeof chunk === "number" ? 10000000 : typeof chunk === "string" ? 100000000 : 0;
  }
  abort(reason: number): void {
    total += reason === undefined ? 1000000000 : 0;
  }
}

new Source().pull(1);
new Source().cancel(1);
new Sink().write(1);
const reader = new ReadableStream(new Source() as any, { highWaterMark: 0 }).getReader();
const first = await reader.read();
const second = await reader.read();
await reader.cancel("enough");
const writer = new WritableStream(new Sink() as any, { size: chunk => (typeof chunk === "string" ? 1 : 2) }).getWriter();
await writer.write("text");
await writer.write(6);
await writer.abort();
console.log(total, first.value, second.value);
//// callbacks-websocket-handlers-get-strings-and-buffers.ts
// Callbacks handed over: the server calls open, message and close of the websocket handlers, with a string or a Buffer as the message and with the data that upgrade was given, of any type; the client's listeners get events.
export {};

let total = 0;
const done = Promise.withResolvers<void>();

function onMessage(message: string): void {
  total += typeof message === "string" ? message.length : Buffer.isBuffer(message) ? 100 : 10000;
}

onMessage("a");
const server = Bun.serve({
  port: 0,
  hostname: "127.0.0.1",
  fetch(request, self) {
    return self.upgrade(request, { data: new URL(request.url).pathname === "/text" ? "text" : { id: 5 } } as any) ? undefined : new Response("no");
  },
  websocket: {
    open(socket) {
      const data = socket.data as unknown as { id: number };
      total += typeof data === "string" ? 1000000 : typeof data.id === "number" ? 10000000 : 0;
    },
    message(socket, message) {
      onMessage(message as string);
      socket.send(message);
    },
    close(socket, code, reason) {
      total += typeof code === "number" && typeof reason === "string" ? 100000000 : 0;
      done.resolve();
    },
  },
});
const client = new WebSocket(`ws://127.0.0.1:${server.port}/text`);
client.binaryType = "arraybuffer";
let echoes = 0;
client.onopen = () => (client.send("hello"), client.send(new Uint8Array([1, 2])));
client.onmessage = event => {
  total += typeof event.data === "string" ? 1000 : event.data instanceof ArrayBuffer ? 2000 : 0;
  if (++echoes === 2) client.close(1000, "bye");
};
await done.promise;
await server.stop(true);
console.log(total);
