// Built-ins applied by native code: classes that the library implements are constructed through Reflect.construct, bind, a proxy and `extends`, with options of odd types and with another new.target.
import { EventEmitter } from "node:events";
import { Readable, Writable } from "node:stream";

////= attempt

class Mine extends EventEmitter {
  mark = 1;
}
function Old(this: any) {
  EventEmitter.call(this);
}
Object.setPrototypeOf(Old.prototype, EventEmitter.prototype);

const results = [
  attempt(() => Reflect.construct(EventEmitter, [{ captureRejections: true }]).listenerCount("x")),
  attempt(() => Reflect.construct(EventEmitter, [{ captureRejections: "yes" }])),
  attempt(() => Reflect.construct(EventEmitter, [], Mine) instanceof Mine),
  attempt(() => (Reflect.construct(EventEmitter, [], Mine) as Mine).mark),
  attempt(() => new (EventEmitter.bind(null, 5 as any))().getMaxListeners()),
  attempt(() => new (new Proxy(EventEmitter, {}))().eventNames().length),
  attempt(() => new (Old as any)().on("x", () => {}).listenerCount("x")),
  attempt(() => Reflect.construct(Readable, [{ highWaterMark: "big" }])),
  attempt(() => Reflect.construct(Readable, [{ objectMode: 1, read: 5 }]).readableObjectMode),
  attempt(() => Reflect.construct(Writable, ["text"]).writableHighWaterMark > 0),
  attempt(() => [{}, undefined].map(options => new Readable(options as any).readableFlowing)),
];
console.log(results.join(" "));
//// builtins-overridden-methods-are-called-by-the-library.ts
// Methods found through instances, by the library: a subclass of EventEmitter or Readable overrides emit, on and push with narrower parameters, and the library's own code calls the overrides with its own events and listeners.
import { EventEmitter, once } from "node:events";
import { Readable } from "node:stream";

let total = 0;

class Numbers extends EventEmitter {
  emit(name: "value", value?: number): boolean {
    total += name === "value" ? 1 : typeof name === "string" ? 100 : 10000;
    return super.emit(name, value);
  }
  on(name: "value", listener: (value: number) => void): this {
    total += name === "value" ? 100000 : 1000000;
    return super.on(name, listener);
  }
}

const numbers = new Numbers();
numbers.on("value", () => {});
numbers.emit("value", 1);
const waiting = once(numbers, "value");
numbers.emit("value", 2);
await waiting;

class Source extends Readable {
  _read(): void {
    this.push("chunk");
    this.push(null);
  }
  emit(name: string, ...rest: unknown[]): boolean {
    total += name === "data" ? 10000000 : name === "end" ? 100000000 : 0;
    return super.emit(name, ...rest);
  }
}
for await (const chunk of new Source()) total += String(chunk).length;
await new Promise<void>(resolve => new Source().on("data", () => {}).on("close", resolve));
console.log(total);
//// builtins-parse-int-and-math-max-as-callbacks.ts
// Built-ins applied by native code: parseInt, Math.max, Number, String, Boolean, BigInt and Symbol.for are handed to map, reduce and filter, which pass them the index and the array behind the element.
const texts = ["10", "10", "10", "10"];
const results: unknown[] = [
  texts.map(parseInt),
  [1, 5, 3].reduce(Math.max as any),
  [1, 5, 3].reduce(Math.min as any, 9),
  texts.map(Number),
  [1, "a", null, undefined, [2]].map(String),
  [0, 1, "", "a", null].filter(Boolean).length,
  [1, 2].map(BigInt as any).map(one => typeof one),
  ["a", "a"].map(Symbol.for as any).every((one, index, all) => one === all[0]),
  ["1.5", "2.5"].map(parseFloat),
  [65, 66].map(String.fromCharCode as any).map((one: any) => one.length),
];
console.log(results.map(one => String(one)).join(" "));
//// builtins-path-and-url-functions-as-callbacks.ts
// Built-ins applied by native code: functions of node:path, node:url and node:querystring validate their parameters, and as callbacks of map, reduce and replace they get numbers and arrays where they want strings.
import { basename, extname, join, normalize, resolve } from "node:path/posix";
import { escape, parse } from "node:querystring";
import { fileURLToPath } from "node:url";

////= attempt

const results = [
  attempt(() => ["/a/b.txt"].map(extname)),
  attempt(() => ["/a/b.txt"].map(normalize)),
  attempt(() => ["/a/b.txt"].map(basename as any)),
  attempt(() => ["a", "b"].map(join as any)),
  attempt(() => ["a", "b", "c"].reduce(join as any)),
  attempt(() => ["/a", "b"].reduce((all, one) => resolve(all, one))),
  attempt(() => "a b".replace(" ", escape)),
  attempt(() => ["a=1&b=2"].map(parse as any).map((one: any) => Object.keys(one).length)),
  attempt(() => ["file:///a/b"].map(fileURLToPath as any)),
  attempt(() => Reflect.apply(join, null, { length: 2, 0: "x", 1: "y" } as any)),
  attempt(() => join.apply(null, ["x", 5 as any])),
];
console.log(results.join(" "));
//// builtins-util-functions-as-callbacks.ts
// Built-ins applied by native code: functions of node:util, which the library implements, are handed to map, replace, then, sort and a timer, so their later parameters get an index, an array, an offset or nothing.
import { format, inspect, isDeepStrictEqual, types } from "node:util";

const nested = { a: { b: { c: { d: 1 } } } };
const results: unknown[] = [
  [nested, nested, nested].map(inspect as any).map((one: any) => one.length),
  ["%s", "%d", "x"].map(format as any),
  "a-b".replace(/-(\w)/, format),
  await Promise.resolve(nested).then(inspect),
  await Promise.resolve("%s!").then(format),
  [1, 1].every(isDeepStrictEqual as any),
  [new Map(), {}].map(types.isMap as any),
  await new Promise(resolve => setTimeout((...all: unknown[]) => resolve((format as any)(...all)), 1, "%s+%s", 1, 2)),
  JSON.parse('{"k":1}', format as any),
  Reflect.apply(format, null, ["%o", [1]]),
  format.call("this", "%j", { a: 1 }),
  format.bind(null, "%s-%s", "bound")("late"),
];
console.log(results.map(one => String(one)).join(" | "));
//// callbacks-abort-listeners-and-reasons.ts
// Callbacks handed over and thrown values: an abort listener gets an Event, and the reason that comes back from the signal, by a read, a throw or a rejection, is whatever abort was given, or a DOMException that native code made.
export {};

////= Failure

let total = 0;

function weigh(reason: Failure): number {
  return reason instanceof Failure ? reason.code : typeof reason === "string" ? 100 : typeof reason === "number" ? 10000 : (reason as any) instanceof DOMException ? 1000000 + (reason as Error).name.length : 100000000;
}

total += weigh(new Failure("mine"));
for (const given of [new Failure("given"), "text", 5, undefined] as any[]) {
  const controller = new AbortController();
  controller.signal.onabort = event => void (total += event instanceof Event ? 1000000000 : 0);
  controller.abort(given);
  total += weigh(controller.signal.reason);
  try {
    controller.signal.throwIfAborted();
  } catch (error) {
    total += weigh(error as Failure);
  }
}
const late = AbortSignal.timeout(1);
await new Promise<void>(resolve => late.addEventListener("abort", () => resolve()));
total += weigh(late.reason);
total += weigh(AbortSignal.any([AbortSignal.abort(9)]).reason);
console.log(total);
//// callbacks-apply-and-construct-read-array-likes.ts
// Callbacks handed over: apply, Reflect.apply, Reflect.construct and bind pass what they read out of an array-like, through its getters, so a function whose direct calls pass two numbers gets a string and undefined.
let total = 0;

function add(a: number, b: number): number {
  total += typeof a === "number" ? 1 : typeof a === "string" ? 100 : 10000;
  total += typeof b === "number" ? 100000 : b === undefined ? 1000000 : 10000000;
  return a + b;
}

class Pair {
  sum: number;
  constructor(a: number, b: number) {
    this.sum = add(a, b);
  }
}

add(1, 2);
new Pair(1, 2);
const like: any = { length: 2, get 0() { total += 100000000; return "a"; } };
const results: unknown[] = [
  add.apply(null, like),
  Reflect.apply(add, null, like),
  (Reflect.construct(Pair, like) as Pair).sum,
  (add.bind(null, "b" as any) as any)(),
  Function.prototype.call.call(add, null, null, {}),
  Function.prototype.apply.call(add, null, ["x", "y"]),
  new (Pair.bind(null, "c" as any) as any)(1).sum,
];
console.log(total, results.join());
//// callbacks-bun-listen-and-connect-handlers.ts
// Callbacks handed over: Bun.listen and Bun.connect call open, data and close on handlers that are class instances, with a native socket and a Buffer, and `socket.data` is whatever was given; the program's own calls pass numbers.
export {};

let total = 0;
const closed = Promise.withResolvers<void>();

class Handlers {
  constructor(public weight: number) {}
  open(socket: number): void {
    total += typeof socket === "number" ? 1 : 100 * this.weight;
    if (typeof socket !== "number" && this.weight === 2) (socket as any).write("ping");
  }
  data(socket: number, chunk: number): void {
    total += typeof chunk === "number" ? 10000 : Buffer.isBuffer(chunk) ? 100000 * this.weight : 0;
    total += typeof (socket as any).data === "string" ? 10000000 : 0;
    (socket as any).end();
  }
  close(): void {
    if (this.weight === 1) closed.resolve();
  }
}

new Handlers(0).open(1);
const own = new Handlers(0);
own.data({ end() {} } as any, 1);
const bind = (handlers: Handlers): any => ({ open: (socket: any) => handlers.open(socket), data: (socket: any, chunk: any) => handlers.data(socket, chunk), close: () => handlers.close() });
const listener = Bun.listen({ hostname: "127.0.0.1", port: 0, socket: bind(new Handlers(1)), data: "server side" } as any);
await Bun.connect({ hostname: "127.0.0.1", port: listener.port, socket: bind(new Handlers(2)), data: 5 } as any);
await closed.promise;
listener.stop(true);
console.log(total);
//// callbacks-bun-serve-handlers.ts
// Callbacks handed over: Bun.serve calls fetch with (Request, Server) and the error handler with whatever fetch threw, here a string and a number, while the program's own calls pass its own error class.
export {};

////= Failure

let total = 0;

function onError(error: Failure): Response {
  total += error instanceof Failure ? error.code : typeof error === "string" ? 100 : typeof error === "number" ? 10000 : 1000000;
  return new Response("handled " + typeof error, { status: 500 });
}

onError(new Failure("mine"));
const server = Bun.serve({
  port: 0,
  hostname: "127.0.0.1",
  fetch(request, self) {
    total += self === server ? 100000000 : 0;
    const path = new URL(request.url).pathname;
    if (path === "/text") throw "text";
    if (path === "/number") throw 5;
    if (path === "/failure") throw new Failure("thrown");
    return new Response("fine");
  },
  error: onError as any,
});
const bodies: string[] = [];
for (const path of ["/", "/text", "/number", "/failure"]) bodies.push(await (await fetch(`http://127.0.0.1:${server.port}${path}`)).text());
await server.stop(true);
console.log(total, bodies.join());
//// callbacks-bun-serve-whose-result-is-dropped-hands-the-server-to-its-handler.ts
// Bun.serve calls `fetch` with the server as `this` and as the second argument. The program drops what Bun.serve answers, so the handler is the only one who has the server.
import { tmpdir } from "node:os";

class Body {
  mass = 3;
  respond(request: Request, server: any): Response {
    seen.push(this === undefined ? "none" : String(this.mass), typeof server, typeof server?.stop, String((this as any) === server));
    held = server;
    return new Response("ok");
  }
}

let held: any;
const seen: string[] = [];
const body = new Body();
const unix = tmpdir() + "/server-whose-result-is-dropped-" + process.pid + ".sock";
Bun.serve({ unix, fetch: body.respond });
const response = await fetch("http://localhost/", { unix });
console.log(await response.text(), seen.join(" "));
held.stop(true);
//// callbacks-comparator-and-key-results-are-converted-by-native-code.ts
// Callbacks handed over: what a callback returns is in native hands: sort converts it with valueOf, Object.groupBy and Object.fromEntries with toString, and flatMap spreads it; these methods get no argument, the program passes one.
let total = 0;

class Order {
  constructor(public rank: number) {}
  valueOf(bias: number): number {
    total += typeof bias === "number" ? 1 : bias === undefined ? 100 : 10000;
    return this.rank;
  }
  toString(prefix: string): string {
    total += typeof prefix === "string" ? 100000 : prefix === undefined ? 1000000 : 10000000;
    return "rank" + this.rank;
  }
}

const own = new Order(1);
own.valueOf(1);
own.toString("p");
const sorted = [3, 1, 2].sort((a, b) => new Order(a - b) as any);
const groups = Object.groupBy([1, 2, 3], value => new Order(value % 2) as any);
const entries = Object.fromEntries([[new Order(5) as any, 1]]);
const mapped = Map.groupBy([1, 2], value => new Order(value)).size;
console.log(total % 100000 > 100, Math.floor(total / 100000), sorted.join(), Object.keys(groups).join(), Object.keys(entries).join(), mapped);
//// callbacks-deep-equality-runs-getters-and-reads-tags.ts
// Native bindings of the library: util.isDeepStrictEqual, assert.deepStrictEqual and Bun.deepEquals are native code that runs the own getters of both operands; each getter here belongs to one caller and sets its bit.
import { isDeepStrictEqual } from "node:util";
import { deepEqual, deepStrictEqual, notDeepStrictEqual } from "node:assert";

let bits = 0;

function attempt(run: () => unknown): void {
  try {
    run();
  } catch {}
}

const forUtil = { get a(): number { bits |= 1; return 1; } };
const forAssert = { get a(): number { bits |= 2; return 1; } };
const forLoose = { get a(): number { bits |= 4; return 1; } };
const forNot = { get a(): number { bits |= 8; return 1; } };
const forBun = { get a(): number { bits |= 16; return 1; } };
const forBunStrict = { get a(): number { bits |= 32; return 1; } };
const nested = { inner: [{ get a(): number { bits |= 64; return 1; } }] };
class Tagged { b = 1; get [Symbol.toStringTag](): string { bits |= 128; return "Tagged"; } }

const results = [isDeepStrictEqual(forUtil, { a: 1 }), Bun.deepEquals(forBun, { a: 1 }), Bun.deepEquals(forBunStrict, { a: 1 }, true), isDeepStrictEqual(nested, { inner: [{ a: 1 }] }), isDeepStrictEqual(new Tagged(), new Tagged())];
attempt(() => deepStrictEqual(forAssert, { a: 1 }));
attempt(() => deepEqual(forLoose, { a: "1" }));
attempt(() => notDeepStrictEqual(forNot, { a: 2 }));
console.log(bits.toString(2), results.join());
//// callbacks-event-listeners-get-events-of-another-class.ts
// Callbacks handed over: a listener typed for CustomEvent<number> is called with whatever was dispatched under that name: a plain Event, a detail of another type, a subclass; `this` is the target.
let total = 0;

function onValue(this: unknown, event: CustomEvent<number>): void {
  total += typeof event.detail === "number" ? event.detail : typeof event.detail === "string" ? 100 : event.detail === undefined ? 10000 : event.detail === null ? 1000000 : 100000000;
  total += this instanceof EventTarget ? 1000000000 : 0;
}

class Loud extends Event {
  detail = ["loud"];
}

onValue.call(null, new CustomEvent("value", { detail: 1 }));
const target = new EventTarget();
target.addEventListener("value", onValue as EventListener);
target.dispatchEvent(new CustomEvent("value", { detail: 2 }));
target.dispatchEvent(new CustomEvent("value", { detail: "two" }));
target.dispatchEvent(new Event("value"));
target.dispatchEvent(new CustomEvent("value"));
target.dispatchEvent(new Loud("value"));
console.log(total);
//// callbacks-finalization-registry-passes-the-held-value.ts
// Callbacks handed over: a FinalizationRegistry calls its function with the held value, a string here, some time after a collection, while the program's own call passes a number.
export {};

let seen = 0;

function cleanUp(held: number): void {
  seen |= typeof held === "number" ? 1 : typeof held === "string" ? 2 : 4;
}

cleanUp(1);
const registry = new FinalizationRegistry(cleanUp as (held: any) => void);
function fill(): void {
  for (let i = 0; i < 2000; i++) registry.register({ i }, "held " + i);
}
fill();
for (let round = 0; round < 50 && seen === 1; round++) {
  Bun.gc(true);
  await new Promise(resolve => setTimeout(resolve, 5));
}
console.log(seen);
//// callbacks-finalization-registry-what-the-function-gets-as-this.js
// Callbacks handed over: what a FinalizationRegistry hands its function as `this`, asked in several ways that have to agree with each other.
const seen = new Set();

function cleanUp(held) {
  "use strict";
  seen.add([this === undefined, this == null, typeof this, this === cleanUp, typeof held].join());
}

const registry = new FinalizationRegistry(cleanUp);
function fill() {
  for (let i = 0; i < 2000; i++) registry.register({ i }, "held " + i);
}
fill();
for (let round = 0; round < 50 && !seen.size; round++) {
  Bun.gc(true);
  await new Promise(resolve => setTimeout(resolve, 5));
}
console.log([...seen].join(" | "));
//// callbacks-fs-zlib-and-crypto-callbacks.ts
// Callbacks handed over: each function here is the callback of one asynchronous function of node:fs, node:zlib, node:crypto, node:dns or node:stream, which passes (null or an error, a result of its own type); the program's own calls pass (number, number).
import { access, exists, readFile, readdir, realpath, stat } from "node:fs";
import { deflate, gzip } from "node:zlib";
import { pbkdf2, randomBytes, randomFill } from "node:crypto";
import { lookup } from "node:dns";
import { finished, pipeline, PassThrough, Readable } from "node:stream";

let bits = 0;

function afterStat(a: number, b: number): void { if (typeof a !== "number" || typeof b !== "number") bits |= 1; }
function afterMissing(a: number, b: number): void { if (typeof a !== "number" || typeof b !== "number") bits |= 2; }
function afterReaddir(a: number, b: number): void { if (typeof a !== "number" || typeof b !== "number") bits |= 4; }
function afterAccess(a: number, b: number): void { if (typeof a !== "number" || typeof b !== "number") bits |= 8; }
function afterExists(a: number, b: number): void { if (typeof a !== "number" || typeof b !== "number") bits |= 16; }
function afterRealpath(a: number, b: number): void { if (typeof a !== "number" || typeof b !== "number") bits |= 32; }
function afterGzip(a: number, b: number): void { if (typeof a !== "number" || typeof b !== "number") bits |= 64; }
function afterDeflate(a: number, b: number): void { if (typeof a !== "number" || typeof b !== "number") bits |= 128; }
function afterBytes(a: number, b: number): void { if (typeof a !== "number" || typeof b !== "number") bits |= 256; }
function afterFill(a: number, b: number): void { if (typeof a !== "number" || typeof b !== "number") bits |= 512; }
function afterKey(a: number, b: number): void { if (typeof a !== "number" || typeof b !== "number") bits |= 1024; }
function afterLookup(a: number, b: number): void { if (typeof a !== "number" || typeof b !== "number") bits |= 2048; }
function afterFinished(a: number, b: number): void { if (typeof a !== "number" || typeof b !== "number") bits |= 4096; }
function afterPipeline(a: number, b: number): void { if (typeof a !== "number" || typeof b !== "number") bits |= 8192; }

for (const own of [afterStat, afterMissing, afterReaddir, afterAccess, afterExists, afterRealpath, afterGzip, afterDeflate, afterBytes, afterFill, afterKey, afterLookup, afterFinished, afterPipeline]) own(1, 2);
stat("/", afterStat as any);
readFile("/no/such/file/anywhere", afterMissing as any);
readdir("/no/such/folder", afterReaddir as any);
access("/", afterAccess as any);
exists("/", afterExists as any);
realpath("/", afterRealpath as any);
gzip("a", afterGzip as any);
deflate("a", afterDeflate as any);
randomBytes(1, afterBytes as any);
randomFill(new Uint8Array(1), afterFill as any);
pbkdf2("p", "s", 1, 1, "sha1", afterKey as any);
lookup("127.0.0.1", afterLookup as any);
finished(Readable.from(["a"]).resume(), afterFinished as any);
pipeline(Readable.from(["a"]), new PassThrough().resume(), afterPipeline as any);
let rounds = 0;
const timer = setInterval(() => {
  if (bits !== 16383 && ++rounds < 150) return;
  clearInterval(timer);
  console.log(bits.toString(2));
}, 10);
//// callbacks-holes-are-visited-as-undefined.ts
// Callbacks handed over: find, findIndex, findLast, Array.from and a spread visit the holes of an Array<number> as undefined, and Array.from does so for an array-like without elements; the program's own calls pass numbers.
let total = 0;

function isBig(value: number): boolean {
  total += typeof value === "number" ? 1 : value === undefined ? 100 : 10000;
  return value > 5;
}

isBig(1);
const holes = new Array<number>(3);
holes[1] = 4;
const like: ArrayLike<number> = { length: 2 };
const results: unknown[] = [
  holes.find(isBig),
  holes.findIndex(isBig),
  holes.findLast(isBig),
  holes.filter(isBig).length,
  holes.some(isBig),
  Array.from(holes, isBig).length,
  Array.from(like, isBig).length,
  [...holes].map(isBig).length,
  holes.toSorted().map(isBig).length,
];
console.log(total, results.join());
//// callbacks-html-rewriter-handlers-in-a-program-that-also-makes-a-custom-event.ts
// Callbacks handed over: what else a program holds decides how often the compiler expects a handler's method to run, and so which form its code takes. HTMLRewriter calls text() with a native object whatever that form is.
console.log(new CustomEvent("value", { detail: 1 }).detail);

class Handler {
  seen: string[] = [];
  text(chunk: string): void {
    if (typeof chunk !== "string" && (chunk as any).text) this.seen.push((chunk as any).text);
  }
}

const handler = new Handler();
handler.text("own");
const output = new HTMLRewriter().on("p", handler as any).transform("<p>one</p><div>two</div><p>three</p>");
console.log(handler.seen.join(), output);
//// callbacks-json-reviver-and-replacer-get-every-kind-of-value.ts
// Callbacks handed over: JSON.parse calls the reviver and JSON.stringify the replacer with every value of the document and with the holder as `this`, while the program's own calls pass a number and a holder of its own class.
let total = 0;

class Holder {
  factor = 2;
}

function scale(this: Holder, key: string, value: number): number {
  total += this instanceof Holder ? 1 : Array.isArray(this) ? 100 : 10000;
  total += typeof value === "number" ? 1000000 : typeof value === "string" ? 10000000 : 100000000;
  return typeof value === "number" ? value * (this.factor ?? 3) : value;
}

scale.call(new Holder(), "own", 1);
const parsed = JSON.parse('{"a":1,"b":[2,"x"],"factor":5,"c":null}', scale);
const text = JSON.stringify({ a: 1, b: [2, "x"], factor: 5, c: null, d: new Holder() }, scale);
console.log(total, JSON.stringify(parsed), text);
//// callbacks-map-passes-the-index-where-a-default-was-meant.ts
// Callbacks handed over: map, forEach, filter, some and find pass (element, index, array), so a second parameter with a default gets a number and a third gets the array; the program's own calls pass one or two strings.
let total = 0;

function label(name: string, prefix: string = "p", suffix?: string): string {
  total += typeof prefix === "string" ? 1 : typeof prefix === "number" ? 100 : 10000;
  total += suffix === undefined ? 100000 : typeof suffix === "string" ? 1000000 : Array.isArray(suffix) ? 10000000 : 0;
  return prefix + name;
}

label("a");
label("b", "q", "s");
const names = ["x", "y"];
const callback = label as any;
const results: unknown[] = [names.map(callback), names.filter(callback).length, names.some(callback), names.find(callback), names.flatMap(callback), Array.from(names, callback), Array.from(new Set(names), callback)];
names.forEach(callback);
console.log(total, results.join());
//// callbacks-message-port-gets-a-clone-without-its-class.ts
// Callbacks handed over: a message port runs the getters of what is posted and delivers a clone, a plain object, to a listener that is typed for the class; a direct call passes an instance.
export {};

let total = 0;

class Job {
  constructor(public id: number) {}
  get twice(): number {
    return this.id * 2;
  }
  run(): number {
    return this.id + 1;
  }
}

function handle(job: Job): void {
  total += job instanceof Job ? job.run() : typeof (job as Job).run === "function" ? 100 : 10000 + (job as Job).id;
  total += (job as Job).twice === undefined ? 1000000 : 0;
}

handle(new Job(1));
const { port1, port2 } = new MessageChannel();
const received = new Promise<void>(resolve => {
  let count = 0;
  port2.onmessage = (event: MessageEvent<Job>) => {
    handle(event.data);
    if (++count === 2) resolve();
  };
});
port1.postMessage(new Job(5));
port1.postMessage({ id: "6", get extra() { total += 100000000; return 1; } });
await received;
port1.close();
port2.close();
console.log(total);
//// callbacks-node-http-handler-and-its-events.ts
// Callbacks handed over: node:http calls the request listener with (IncomingMessage, ServerResponse), and the message's "data" listener with a Buffer, or with a string once an encoding is set; the program's own calls pass strings.
import { createServer } from "node:http";

let total = 0;

function onData(chunk: string): void {
  total += typeof chunk === "string" ? chunk.length : Buffer.isBuffer(chunk) ? 100 : 10000;
}

onData("a");
const server = createServer((request, response) => {
  if (request.url === "/text") request.setEncoding("utf8");
  request.on("data", onData);
  request.on("end", () => {
    total += typeof request.headers["x-n"] === "string" ? 1000000 : 0;
    response.end("ok");
  });
});
server.listen(0, "127.0.0.1", async () => {
  const address = server.address();
  const port = typeof address === "object" && address ? address.port : 0;
  for (const path of ["/text", "/bytes"]) await (await fetch(`http://127.0.0.1:${port}${path}`, { method: "POST", body: "hello", headers: { "x-n": "1" } })).text();
  server.close(() => console.log(total));
});
//// callbacks-node-stream-methods-get-any-chunk.ts
// Callbacks handed over and methods found through instances: node:stream calls _write, _transform, _final, _destroy and _read of subclasses: in object mode a chunk is anything, and destroy passes on whatever it was given.
import { Transform, Writable } from "node:stream";

let total = 0;

class Collect extends Writable {
  constructor() {
    super({ objectMode: true });
  }
  _write(chunk: Buffer, encoding: string, done: (error?: Error | null) => void): void {
    total += Buffer.isBuffer(chunk) ? 1 : typeof chunk === "string" ? 100 : typeof chunk === "number" ? 10000 : 1000000;
    done();
  }
  _final(done: () => void): void {
    total += typeof done === "function" ? 100000000 : 0;
    done();
  }
  _destroy(error: Error | null, done: (error?: Error | null) => void): void {
    total += error === null ? 1000000000 : 2000000000;
    done(null);
  }
}

class Twice extends Transform {
  constructor() {
    super({ objectMode: true });
  }
  _transform(chunk: number, encoding: string, done: (error: null, result: unknown) => void): void {
    done(null, typeof chunk === "number" ? chunk * 2 : chunk);
  }
}

const collect = new Collect();
const twice = new Twice();
twice.pipe(collect);
twice.write(Buffer.from("b"));
twice.write("text");
twice.write(21);
twice.write({ plain: true });
twice.end();
collect.on("close", () => console.log(total));
//// callbacks-parse-args-hands-defaults-back.ts
// Native bindings of the library: util.parseArgs is native code that reads its configuration through getters and puts the `default` of an option into its result as it is, so a function under the type string comes back and is called.
import { parseArgs } from "node:util";

let total = 0;

////= lines	fallback	value	1	100

fallback(1);
class Options {
  get name(): object {
    total += 10000;
    return { type: "string", short: "n", default: "nobody" };
  }
}
