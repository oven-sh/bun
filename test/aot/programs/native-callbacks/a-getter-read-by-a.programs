    const holder = { value: 1 };
    const asked = new Proxy(function () {}, {
      getPrototypeOf(target) {
        holder.value = 2;
        return Reflect.getPrototypeOf(target);
      },
    });
    asked.bind(null);
    return holder.value;
  }
  console.log(local());
}

{
  function create() {
    const kept = { tag: 1 };
    const made = Object.create(null, {
      member: { value: kept, enumerable: true },
      read: {
        get() {
          return kept;
