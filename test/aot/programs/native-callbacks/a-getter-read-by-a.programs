// Held from creation: closures that a constructor stores in fields are handed to nobody by name; Object.values, Object.entries and Reflect.get hand them back, and the program calls them with a string.
let total = 0;

class Panel {
  width = 10;
  grow = (by: number): void => {
    total += typeof by === "number" ? this.width + by : 1000 + String(by).length;
  };
  shrink = (by: number): void => {
    total += typeof by === "number" ? this.width - by : 100000 + String(by).length;
  };
}

const panel = new Panel();
panel.grow(1);
panel.shrink(1);
for (const value of Object.values(panel) as any[]) if (typeof value === "function") value("text");
for (const [, value] of Object.entries(panel) as [string, any][]) if (typeof value === "function") value(undefined);
for (const key of Reflect.ownKeys(panel)) {
  const value: any = Reflect.get(panel, key);
  if (typeof value === "function") value({ toString: () => "object" });
}
console.log(total);
//// created-methods-come-back-through-the-prototype-object.ts
// Held from creation: the program walks from an instance to the prototype object of its class with native functions, gets the names and the methods back as `any`, and calls each method with a string and with another `this`.
let total = 0;

class Suite {
  weight = 1;
  first(times: number): void {
    total += typeof times === "number" ? times : this instanceof Suite ? 100 : 10000;
  }
  second(times: number): void {
    total += typeof times === "number" ? times : this instanceof Suite ? 1000000 : 100000000;
  }
}

const suite = new Suite();
suite.first(1);
suite.second(1);
const prototype = Object.getPrototypeOf(suite);
for (const name of Object.getOwnPropertyNames(prototype)) {
  if (name === "constructor") continue;
  prototype[name].call(suite, "text");
  Reflect.get(prototype, name).call({}, "text");
  Object.getOwnPropertyDescriptor(prototype, name)!.value.call(undefined, 1);
}
console.log(total, new prototype.constructor().weight, Reflect.ownKeys(prototype).length);
//// created-one-class-for-each-thing-done-above-an-instance-that-came-back.ts
// Held from creation: an instance of each class here goes into an array that JSON.parse made and comes back as `any`. What lies above the instance was handed to nobody: the class, its static members, the prototype object, its methods. One thing is done to each of them through the value that came back. A bit is set where the program sees it done.

let bits = 0;

function attempt(run: () => unknown): void {
  try {
    run();
  } catch {}
}
const held: any[] = JSON.parse("[]");
function back(instance: object): any {
  held.push(instance);
  return held[held.length - 1];
}
const patched = (): string => "patched";

class Compared {}
class Constructed { constructor(label: number) { if (typeof label !== "number") bits |= 2; } }
class WithStaticMethod { static run(label: number): void { if (typeof label !== "number") bits |= 4; } }
class WithStaticGetter { static get mark(): number { bits |= 8; return 1; } }
class WithSpeciesGetter extends Array<number> { static get [Symbol.species](): any { bits |= 16; return Array; } }
class WithHasInstance { static [Symbol.hasInstance](value: unknown): boolean { bits |= 32; return value === 1; } }
class PatchedThroughGetPrototypeOf { m(): number | string { return 1; } }
class PatchedThroughDunderProto { m(): number | string { return 1; } }
class PatchedThroughConstructor { m(): number | string { return 1; } }
class WithPatchedStatic { static m(): number | string { return 1; } }
class WithTakenMethod { m(label: number): void { if (!(this instanceof WithTakenMethod) && typeof label !== "number") bits |= 1024; } }
class ConstructedBySlice extends Array<number> { constructor(label: string) { super(); if (typeof label !== "string") bits |= 2048; } }
class ConstructedBySplit extends RegExp { constructor(source: string, flags?: string) { super(source, flags); if (typeof source !== "string") bits |= 4096; } }
class Parent extends Array<number> { static get [Symbol.species](): any { bits |= 8192; return Array; } }
class Child extends Parent {}

attempt(() => { if (back(new Compared()).constructor === Compared) bits |= 1; });
attempt(() => new (back(new Constructed(1)).constructor)("text"));
WithStaticMethod.run(1);
attempt(() => back(new WithStaticMethod()).constructor.run("text"));
attempt(() => back(new WithStaticGetter()).constructor.mark);
attempt(() => back(new WithSpeciesGetter()).map((one: number) => one));
attempt(() => (1 as any) instanceof back(new WithHasInstance()).constructor);
attempt(() => { Object.getPrototypeOf(back(new PatchedThroughGetPrototypeOf())).m = patched; });
if (new PatchedThroughGetPrototypeOf().m() === "patched") bits |= 64;
attempt(() => { back(new PatchedThroughDunderProto()).__proto__.m = patched; });
if (new PatchedThroughDunderProto().m() === "patched") bits |= 128;
attempt(() => { back(new PatchedThroughConstructor()).constructor.prototype.m = patched; });
if (new PatchedThroughConstructor().m() === "patched") bits |= 256;
attempt(() => { back(new WithPatchedStatic()).constructor.m = patched; });
if (WithPatchedStatic.m() === "patched") bits |= 512;
new WithTakenMethod().m(1);
attempt(() => back(new WithTakenMethod()).m.call({}, "text"));
attempt(() => back(new ConstructedBySlice("mine")).slice());
attempt(() => "a,b".split(back(new ConstructedBySplit(","))));
attempt(() => back(new Child()).filter(() => true));
console.log(bits.toString(2));
//// created-promise-species-gets-a-native-executor.ts
// Held from creation: then, catch, finally and the static combinators construct the subclass with an executor that native code made; the program's own executors are closures with one parameter that return a number.
export {};

let total = 0;

class Counted extends Promise<number> {
  constructor(executor: (resolve: (value: number) => void) => number) {
    let returned: unknown = "not run";
    super((resolve, reject) => {
      returned = (executor as any)(resolve, reject);
    });
    total += executor.length === 1 ? 1 : executor.length === 2 ? 100 : 10000;
    total += typeof returned === "number" ? 100000 : returned === undefined ? 10000000 : 0;
  }
}

const first = new Counted(resolve => (resolve(1), 5));
const chained = first.then(value => value + 1);
const caught = chained.catch(() => 0);
const last = caught.finally(() => {});
const all = Counted.all([first, 2]);
const resolved = Counted.resolve(3);
const values = [await chained, await last, (await all).length, await resolved];
console.log(total, values.join(), chained instanceof Counted, all instanceof Counted);
//// created-reflect-construct-with-another-new-target.ts
// Held from creation: Reflect.construct runs a class's constructor on an object that native code made from the `prototype` of another function, so `this` is no instance of the class.
class Base {
  size = 2;
  constructor(public scale: number) {
    this.size = this.measure() * scale;
  }
  measure(): number {
    return 3;
  }
}

class Derived extends Base {
  extra = 10;
  measure(): number {
    return 4;
  }
}

function Stranger(this: any) {}
Stranger.prototype.measure = function (): string {
  return "5";
};

const honest = new Base(2);
const strange = Reflect.construct(Base, [2], Stranger) as Base;
const crossed = Reflect.construct(Derived, [2], Base) as Derived;
const bound = Reflect.construct(Base, [3], Derived.bind(null)) as Base;
console.log(
  honest.size, strange.size, typeof strange.size, strange instanceof Base, strange instanceof (Stranger as any),
  crossed.size, crossed.extra, crossed instanceof Derived, bound.size, bound instanceof Derived,
);
