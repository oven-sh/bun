//// receivers-a-proxy-without-traps-becomes-this.ts
// Receivers below an accessor: a proxy without traps forwards a read to its target with the proxy as the receiver, so accessors and methods of the class run with a `this` that has no private field and is no instance layout.
let total = 0;

class Vault {
  #secret = 5;
  open = 7;
  get secret(): number {
    return this.#secret;
  }
  get visible(): number {
    total += 1;
    return this.open + 1;
  }
  has(): boolean {
    return #secret in this;
  }
}

const vault = new Vault();
const proxy = new Proxy(vault, {});
const results: unknown[] = [vault.secret, vault.visible, proxy.visible, proxy instanceof Vault, proxy.has(), vault.has(), JSON.stringify(proxy), Object.keys(proxy).join()];
////= lines-2	proxy.secret
const revocable = Proxy.revocable(vault, {});
revocable.revoke();
////= lines-2	revocable.proxy.visible
console.log(total, results.join());
//// receivers-accessors-taken-off-by-a-descriptor.ts
// Receivers below an accessor: Object.getOwnPropertyDescriptor hands the getter and the setter of a class back as plain functions, and the program calls them on a string, on nothing and on another class.
let total = 0;

class Account {
  balance = 10;
  get doubled(): number {
    total += this === undefined ? 100 : this instanceof Account ? 1 : 10000;
    return this === undefined ? -1 : this.balance * 2;
  }
  set doubled(value: number) {
    total += typeof value === "number" ? 1000000 : 100000000;
    this.balance = value / 2;
  }
}

class Wallet {
  balance = "30";
}

const account = new Account();
account.doubled = account.doubled + 2;
const { get, set } = Object.getOwnPropertyDescriptor(Account.prototype, "doubled")!;
const wallet = new Wallet();
set!.call(wallet, "50");
const all = Object.getOwnPropertyDescriptors(Account.prototype);
const results: unknown[] = [account.balance, get!.call(account), get!.call("text"), get!.call(undefined), get!.call(new Wallet()), wallet.balance, all.doubled.get!.call({ balance: [4] }), (account as any).__lookupGetter__("doubled") === get];
console.log(total, results.join());
//// receivers-array-methods-on-array-likes.ts
// Receivers below an accessor: Array.prototype methods run on an instance of a class read `length` and the elements through its accessors and pass the instance, not an array, as the third argument of the callback.
let total = 0;

class Row {
  cells = ["a", "b"];
  get length(): number {
    total += 1;
    return this.cells.length;
  }
  get 0(): string {
    total += 100;
    return this.cells[0];
  }
  get 1(): number {
    total += 10000;
    return 5;
  }
}

function visit(cell: string, index: number, all: string[]): string {
  total += typeof cell === "string" ? 1000000 : 10000000;
  total += Array.isArray(all) ? 100000000 : 200000000;
  return cell + index + all.length;
}

visit("x", 0, ["x"]);
const row: any = new Row();
const results: unknown[] = [Array.prototype.map.call(row, visit as any), Array.prototype.join.call(row, "+"), Array.prototype.indexOf.call(row, 5), Array.prototype.slice.call(row).length, Array.from(row).length, Array.prototype.includes.call(row, "a"), Array.prototype.at.call(row, -1)];
console.log(total, results.join());
//// receivers-frozen-and-sealed-instances.ts
// Methods found through instances: Object.freeze, Object.seal and Object.preventExtensions are native code that changes what a store into a typed instance does: it throws a TypeError in strict code and leaves the field as it was.
class Cell {
  value = 1;
  set(value: number): string {
    try {
      this.value = value;
      return "stored " + this.value;
    } catch (error) {
      return (error as Error).name + " " + this.value;
    }
  }
  grow(): string {
    try {
      (this as any).extra = 1;
      return "grew";
    } catch (error) {
      return (error as Error).name;
    }
  }
}

const cells = [new Cell(), Object.freeze(new Cell()), Object.seal(new Cell()), Object.preventExtensions(new Cell()), Object.defineProperty(new Cell(), "value", { writable: false })];
const frozenLate = new Cell();
[frozenLate].forEach(Object.freeze);
cells.push(frozenLate);
console.log(cells.map(cell => cell.set(2) + "/" + cell.grow()).join(" "));
//// receivers-native-code-changes-the-prototype-of-an-instance.ts
// Receivers below an accessor: the setter of __proto__, Object.setPrototypeOf and Reflect.setPrototypeOf are native code that changes what lies above an instance, so a method call on a typed instance finds another function.
class Circle {
  radius = 2;
  area(): number {
    return this.radius * 3;
  }
  get kind(): string {
    return "circle";
  }
}

const other = {
  area(this: { radius: number }): string {
    return "other " + this.radius;
  },
  kind: "other",
};

function describe(circle: Circle): string {
  return circle.area() + "/" + circle.kind + "/" + (circle instanceof Circle);
}

const results = [describe(new Circle())];
const first = new Circle();
(first as any).__proto__ = other;
const second = Object.setPrototypeOf(new Circle(), other) as Circle;
const third = new Circle();
Reflect.setPrototypeOf(third, Object.create(Circle.prototype, { area: { value: () => "own" } }));
const fourth = new Circle();
Object.getOwnPropertyDescriptor(Object.prototype, "__proto__")!.set!.call(fourth, other);
const fifth = Object.assign(Object.create(other), new Circle()) as Circle;
for (const circle of [first, second, third, fourth, fifth]) results.push(describe(circle));
console.log(results.join(" "));
//// receivers-native-code-writes-methods-onto-a-prototype-object.ts
// Held from creation: Object.assign, Object.defineProperty and Reflect.set store functions onto the prototype object of a class, so a method call that the types resolve to one function finds another, with other results.
class Gauge {
  level = 4;
  read(): number {
    return this.level;
  }
  twice(): number {
    return this.level * 2;
  }
  half(): number {
    return this.level / 2;
  }
  get label(): string {
    return "gauge";
  }
}

const gauge = new Gauge();
const before = [gauge.read(), gauge.twice(), gauge.half(), gauge.label].join();
Object.assign(Gauge.prototype, { read: () => "assigned" });
Object.defineProperty(Gauge.prototype, "twice", { value: function (this: Gauge) { return "defined " + this.level; } });
Reflect.set(Gauge.prototype, "half", () => "set");
Object.defineProperty(Gauge.prototype, "label", { get: () => 5 });
const after = [gauge.read(), gauge.twice(), gauge.half(), gauge.label, new Gauge().read()].join();
console.log(before, after);
//// receivers-reflect-get-and-set-with-another-receiver.ts
// Receivers below an accessor: Reflect.get and Reflect.set run the accessors of a class with a receiver that is no instance: a plain object with a string in the field, a primitive, a proxy.
let total = 0;

class Thermometer {
  degrees = 20;
  get next(): number {
    total += this instanceof Thermometer ? 1 : 100;
    return this.degrees + 1;
  }
  set next(value: number) {
    total += this instanceof Thermometer ? 10000 : 1000000;
    this.degrees = value - 1;
  }
}

const honest = new Thermometer();
honest.next = honest.next + 1;
const plain: any = { degrees: "7" };
const results: unknown[] = [
  honest.degrees,
  Reflect.get(honest, "next", plain),
  Reflect.get(honest, "next", "text"),
  Reflect.get(honest, "next", 5),
  Reflect.get(Thermometer.prototype, "next"),
  Reflect.get(honest, "next", new Proxy({}, { get: () => "40" })),
  Reflect.set(honest, "next", "9", plain),
  plain.degrees,
  Reflect.set(honest, "next", 3, Object.create(honest)),
  honest.degrees,
];
console.log(total, results.map(one => typeof one + ":" + String(one)).join());
//// receivers-super-property-reads-in-a-borrowed-method.ts
// Receivers below an accessor: `super.value` runs the getter of the base class with the `this` of the method, and the method is borrowed through call, Reflect.apply and a native callback's `this` argument.
let total = 0;

class Base {
  amount = 1;
  get value(): number {
    total += this instanceof Base ? 1 : 100;
    return this.amount * 2;
  }
  describe(): string {
    return "base " + typeof this.amount;
  }
}

class Derived extends Base {
  get value(): number {
    return super.value + 1;
  }
  read(): number {
    return super.value;
  }
  tell(): string {
    return super.describe();
  }
}

const derived = new Derived();
const results: unknown[] = [
  derived.value,
  derived.read(),
  derived.read.call({ amount: "3" } as any),
  Reflect.apply(derived.read, { amount: [4] }, []),
  [0].map(derived.read, { amount: "5" })[0],
  [0].map(derived.tell, "text")[0],
  Reflect.get(derived, "value", { amount: "6" }),
  derived.tell.call(7 as any),
];
console.log(total, results.join());
