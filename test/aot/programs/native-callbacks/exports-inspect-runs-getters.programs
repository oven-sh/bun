// Object.entries, values and keys list own enumerable properties: nothing that is inherited, and an own property may have the name of a member of Object.prototype.
class Point {
  x = 1;
  y = 2;
  norm(): number {
    return this.x + this.y;
  }
}

let sum = 0;
const point = new Point();
Object.entries(point).forEach(([name, value]) => { sum += (value as number) * name.length; });
Object.entries({ __proto__: point, z: 3 }).forEach(([, value]) => { sum += 10 * (value as number); });
Object.entries({ a: point }).forEach(([, held]) => { held.x++; sum += 100 * held.norm(); });
Object.values({ toString: point, constructor: point }).forEach(held => { held.y++; sum += 1000 * held.norm(); });
console.log(sum, point.x, point.y, Object.keys({ __proto__: point }).length, Object.entries(Object.create(point)).length);
const shadowing: any = { __proto__: null, toString: () => "own", hasOwnProperty: 1 };
console.log(Object.entries(shadowing).map(([name, value]) => name + ":" + typeof value).join(), `${shadowing}`);
//// prototypes-object-create-under-each-kind-of-operand.ts
// What Object.create makes lies under its operand alone, whatever the operand is, and a later change above the operand shows through it.
class Animal {
  legs = 4;
  speak(): string {
    return "legs " + (this as any).legs;
  }
}

function make(prototype: any): any {
  return Object.create(prototype);
}

const bare = make(null);
console.log(typeof bare.toString, typeof bare.hasOwnProperty, "toString" in bare);
try {
  console.log(`${bare}`);
} catch (error) {
  console.log((error as Error).constructor === TypeError);
}

const heir = make(Animal.prototype);
heir.legs = 2;
console.log(heir.speak(), heir instanceof Animal, typeof heir.toString);

const base: any = make(null);
base.greet = function () { return "hello " + this.name; };
const below = make(base);
below.name = "below";
console.log(below.greet(), typeof below.toString);
Object.setPrototypeOf(base, Animal.prototype);
console.log(below.speak(), typeof below.toString);

const underFunction = make(function callee() {});
console.log(typeof underFunction.call, typeof underFunction, underFunction.name);
const underArray = make([1, 2, 3]);
console.log(underArray.length, underArray[1], Array.isArray(underArray), underArray.join("-"));
const underProxy = make(new Proxy({}, { get: (_, name) => "trap " + String(name) }));
console.log(underProxy.anything, underProxy.toString);
for (const wrong of [undefined, 1, "text"]) {
  try {
    make(wrong);
  } catch (error) {
    console.log((error as Error).constructor === TypeError);
  }
}
const described = Object.create(null, { shown: { value: 1, enumerable: true }, hidden: { value: 2 } });
console.log(described.shown, described.hidden, Object.keys(described).join(), typeof described.toString);
//// prototypes-one-literal-under-many-prototypes.ts
// One literal in a loop lies under another prototype each time round, null among them.
const cat = { sound() { return "meow"; } };
const dog = { sound() { return "woof"; }, fetch() { return "stick"; } };
const chain: any[] = [cat, null, dog, Object.prototype, null];
let said = "";
for (let index = 0; index < chain.length; index++) {
  const pet: any = { __proto__: chain[index], index };
  said += typeof pet.sound === "function" ? pet.sound() : "silent";
  said += typeof pet.fetch === "function" ? pet.fetch() : "";
  said += typeof pet.toString + " ";
}
console.log(said);
