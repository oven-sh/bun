handlers["__proto__"] = { add: (amount: number) => { total += 100 * amount; } };
console.log(Object.keys(handlers).join(), Object.getPrototypeOf(handlers), typeof handlers.__proto__.add);
handlers.__proto__.add(1);
ordinary["__proto__"] = { extra: (amount: number) => { total += 10000 * amount; } };
ordinary.extra(1);
console.log(total, Object.keys(ordinary).join());
//// proxies-a-handler-gets-its-trap-after-the-proxy-is-made.js
// The handler is empty when the proxy is made and gets a trap afterwards; another handler inherits its trap.
const log = [];
class Body { constructor() { this.hits = 1; } }
const b = new Body(); const handler = {};
const p = new Proxy(b, handler);
log.push(String(p.hits));
handler.get = function (target, key) { log.push("trap " + String(key) + " " + (target === b)); return 7; };
log.push(String(p.hits));
const inherited = Object.create({ has(target, key) { log.push("has " + String(key)); return true; } });
log.push(String("nothing" in new Proxy(b, inherited)));
console.log(log.join("; "));
//// proxies-a-proxy-lies-above-another-object.js
// A proxy without traps is the prototype of another object: reads through that object find what the target holds, and a getter of the target's class gets that object as this.
const log = [];
class Vec { constructor(x) { this.x = x; } }
class Body { constructor() { this.pos = new Vec(2); } get twice() { log.push(this === child ? "this is the child" : "this is another"); return 2; } }
const b = new Body(); const p = new Proxy(b, {});
const child = { __proto__: p };
child.pos.x = "s"; log.push(typeof b.pos.x, String(child.twice));
const made = Object.create(new Proxy(new Body(), {})); made.pos.x = true; log.push(typeof made.pos.x);
console.log(log.join("; "));
