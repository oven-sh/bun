//// species-what-it-has-made-refuses-or-redirects-the-elements.js
// What the species answers is frozen, has an accessor under an index that can or cannot be redefined, is a proxy, or inherits a setter under an index.
const log = [];
const attempt = (name, species, run) => { const source = [1, 2]; source.constructor = { [Symbol.species]: species }; try { const made = run(source); log.push(name + " " + typeof made + " " + JSON.stringify(Object.getOwnPropertyDescriptor(made, "0") ?? null)); } catch (error) { log.push(name + " " + error.constructor.name); } };
attempt("frozen", function () { return Object.freeze({ tag: 1 }); }, s => s.slice());
attempt("accessor", function () { const o = { tag: 2 }; Object.defineProperty(o, "0", { get() { return "got"; }, configurable: true }); return o; }, s => s.map(x => x * 2));
attempt("fixed", function () { const o = {}; Object.defineProperty(o, "0", { get() { return "got"; }, configurable: false }); return o; }, s => s.filter(() => true));
attempt("proxy", function () { return new Proxy({}, { defineProperty(target, key, descriptor) { log.push("define " + String(key)); return Reflect.defineProperty(target, key, descriptor); }, set(target, key, value) { log.push("set " + String(key) + "=" + value); target[key] = value; return true; } }); }, s => s.concat(3));
attempt("inherited", function () { return Object.create({ set 0(v) { log.push("never"); } }); }, s => s.flat());
console.log(log.join("; "));
//// spread-copies-closures-that-native-code-then-hands-back.ts
// Sources of a spread: a closure that lies in an object which is only ever spread reaches an emitter, a Map, a WeakRef, a promise and a timer inside the copy, comes back as `any`, and is called with a string; direct calls pass numbers.
import { EventEmitter } from "node:events";

let total = 0;

const context = {
  scale: 2,
  handler(value: number): void {
    total += typeof value === "number" ? value * this.scale : typeof value === "string" ? 1000 : 1000000;
  },
  arrow: (value: number): void => {
    total += typeof value === "number" ? value : typeof value === "string" ? 100000 : 1000000;
  },
};

context.handler(1);
context.arrow(1);
const use = (copy: any): void => {
  copy.handler("text");
  copy.arrow("text");
};
const emitter = new EventEmitter();
emitter.on("context", use);
emitter.emit("context", { ...context });
use(new Map<string, unknown>([["c", { ...context }]]).get("c"));
use(new WeakRef({ ...context }).deref());
use(Object.values({ inner: { ...context } })[0]);
use([{ ...context }].concat([])[0]);
await Promise.resolve({ ...context }).then(use);
await new Promise<void>(resolve => setTimeout(copy => (use(copy), resolve()), 1, { ...context }));
console.log(total);
//// spread-into-a-call-uses-the-iterator-of-a-subclass.ts
// Sources of a spread: `f(...x)`, `[...x]`, `new Set(x)`, Array.from and Promise.all use the Symbol.iterator method of an Array subclass, which yields strings though the class says number.
export {};

let total = 0;

class Odd extends Array<number> {
  *[Symbol.iterator](): ArrayIterator<number> {
    total += 1;
    for (let i = 0; i < this.length; i++) yield (i % 2 ? String(this[i]) : this[i]) as number;
  }
}

function sum(a: number, b: number, c: number): number | string {
  total += (typeof a === "number" ? 100 : 10000) + (typeof b === "number" ? 100 : 10000) + (typeof c === "number" ? 100 : 10000);
  return a + b + c;
}

const odd = new Odd();
odd.push(1, 2, 3);
sum(1, 2, 3);
const results: unknown[] = [sum(...(odd as unknown as [number, number, number])), [...odd].map(one => typeof one), new Set(odd).has(2), Array.from(odd)[1] === 2, Math.max(...odd), ((await Promise.all(odd)) as any).map((one: unknown) => typeof one), Array.from(odd.concat([4]), one => typeof one).join("/")];
const [, second] = odd;
console.log(total, results.join(), typeof second);
//// spread-of-a-proxy-runs-three-traps.ts
// Sources of a spread: spreading a proxy runs ownKeys, getOwnPropertyDescriptor and get of a handler that is a class instance, with symbols among the keys; the program's own calls pass strings.
let total = 0;

const tag = Symbol("tag");
type Target = Record<string | symbol, number>;

class Handler implements ProxyHandler<Target> {
  ownKeys(target: Target): (string | symbol)[] {
    total += 1;
    return [...Reflect.ownKeys(target), "ghost"];
  }
  getOwnPropertyDescriptor(target: Target, key: string): PropertyDescriptor | undefined {
    total += typeof key === "string" ? 100 : 10000;
    return key === "ghost" ? { value: 0, enumerable: true, configurable: true } : Reflect.getOwnPropertyDescriptor(target, key);
  }
  get(target: Target, key: string): number | string {
    total += typeof key === "string" ? 1000000 : 100000000;
    return typeof key === "string" ? key.length : "symbol";
  }
}

const handler = new Handler();
const target: Target = { a: 1, bb: 2, [tag]: 3 };
handler.get(target, "own");
handler.getOwnPropertyDescriptor(target, "a");
const proxy = new Proxy(target, handler);
const copy = { ...proxy };
const assigned = Object.assign({}, proxy);
const { a, ...rest } = proxy;
console.log(total, JSON.stringify(copy), String(copy[tag]), Object.keys(assigned).join(), a, Object.keys(rest).join());
//// spread-of-primitives-and-strange-sources.ts
// Sources of a spread: a source typed as an object is really a string, a number, null, an array or a function with properties, each out of `any`; what the copy holds follows from the real value.
let total = 0;

interface Size {
  width?: number;
  length?: number;
}

function widthOf(size: Size): number {
