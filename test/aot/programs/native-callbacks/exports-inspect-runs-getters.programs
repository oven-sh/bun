  }
}

const reading = new Reading(7);
let sum = reading.toJSON(2) + reading.toJSON(3);
const text = JSON.stringify({ first: reading, list: [reading, reading] });
for (const part of text.match(/\d+/g)!) sum += Number(part);
console.log(sum);
