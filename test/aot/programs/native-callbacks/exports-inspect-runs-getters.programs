//// prototypes-a-bare-literal-gets-a-prototype-later.ts
// A literal under null finds nothing of Object.prototype until somebody puts it under an object. A store to `__proto__` finds no setter there: it makes an own property.
class Shape {
  sides = 4;
  describe(): string {
    return "sides " + (this as any).sides;
  }
}

const first: any = { __proto__: null, sides: 3 };
console.log(typeof first.toString, typeof first.describe, first.sides);
first.__proto__ = Shape.prototype;
console.log(typeof first.describe, Object.getPrototypeOf(first), Object.keys(first).join());

const second: any = { __proto__: null, sides: 5 };
Object.setPrototypeOf(second, Shape.prototype);
console.log(second.describe(), second instanceof Shape, typeof second.toString);

const third: any = { __proto__: null, sides: 6 };
Reflect.setPrototypeOf(third, second);
console.log(third.describe(), typeof third.hasOwnProperty, Object.getPrototypeOf(third) === second);

const fourth: any = { __proto__: null, sides: 7 };
(Object.prototype as any).__lookupSetter__("__proto__").call(fourth, Shape.prototype);
console.log(fourth.describe());
//// prototypes-a-copy-leaves-behind-what-lies-above-its-source.ts
// A spread and Object.assign take own enumerable properties. Methods of the class, getters of its prototype object and what Object.prototype holds stay behind.
class Account {
  balance = 10;
  get doubled(): number {
    return this.balance * 2;
  }
  deposit(amount: number): number {
    return (this.balance += amount);
  }
}

const account = new Account();
Object.defineProperty(account, "own", { get() { return this.balance + 1; }, enumerable: true });
const bare: any = { __proto__: null, ...account };
console.log(bare.balance, bare.own, bare.doubled, typeof bare.deposit, typeof bare.toString, typeof bare.constructor);
account.deposit(5);
console.log(bare.balance, bare.own, Object.getPrototypeOf(bare), bare.__proto__);

const assigned: any = Object.assign(Object.create(null), account);
console.log(assigned.balance, assigned.own, assigned.doubled, typeof assigned.deposit, typeof assigned.valueOf);

const ordinary: any = { ...account };
console.log(ordinary.balance, typeof ordinary.deposit, typeof ordinary.toString, ordinary.constructor === Object, Account.prototype.isPrototypeOf(ordinary), Object.prototype.isPrototypeOf.call(account, ordinary));

const heir: any = { __proto__: account, top: 1 };
const twice: any = { __proto__: null, ...heir };
console.log(twice.top, twice.balance, typeof twice.deposit);

let names = "";
for (const name in bare) names += name + " ";
for (const name in { __proto__: account, top: 1 }) names += name + " ";
console.log(names);
