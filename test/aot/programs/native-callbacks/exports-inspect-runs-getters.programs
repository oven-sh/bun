////: Meter
class Meter {
  size = 1;
  measure(by: number): string {
    return (this instanceof Meter ? "a meter" : "no meter") + " " + (typeof by === "number" ? "a number" : "no number");
  }
}
////: lines-2
try {
  results.push(«1»);
} catch (error) {
  results.push((error as Error).name);
}
//// exports-inspect-runs-getters-when-asked.ts
// Exports of start-up modules: util.inspect with { getters: true } runs accessors of an object that the program never reads by name, own ones and, for a class, none of the prototype's.
import { inspect } from "node:util";

let runs = 0;

class Meter {
  base = 5;
  get reading(): number {
    runs += 1000;
    return this.base * 2;
  }
}

const meter = new Meter();
Object.defineProperty(meter, "own", {
  enumerable: true,
  get(this: Meter): number {
    runs += typeof this.base === "number" ? 1 : 100;
    return this.base + 1;
  },
  set(this: Meter, value: number) {
    runs += 1000000;
    this.base = value;
  },
});
const literal = {
  step: 3,
  get next(): number {
    runs += 10;
    return this.step + 1;
  },
};

const text = inspect(meter, { getters: true }) + inspect(literal, { getters: "get" }) + inspect(literal, { getters: "set" }) + inspect(literal);
console.log(runs, text.length);
//// exports-listeners-of-the-process-come-back.ts
// Exports of start-up modules: the process is an emitter that native code made; listeners, rawListeners and emit hand the program's functions back or call them with what the program passes as `any`.
let total = 0;

function onExit(code: number): void {
  total += typeof code === "number" ? 1 : typeof code === "string" ? 100 : 10000;
}
function onBeforeExit(code: number): void {
  total += typeof code === "number" ? 100000 : typeof code === "string" ? 1000000 : 10000000;
}
////= lines	onCustom	value	100000000	200000000

onExit(0);
onBeforeExit(0);
onCustom(0);
process.on("exit", onExit);
process.once("beforeExit", onBeforeExit);
process.on("custom" as any, onCustom);
for (const listener of process.listeners("exit") as any[]) listener("text");
for (const listener of process.rawListeners("beforeExit") as any[]) listener("text");
process.emit("custom" as any, "text" as any);
process.on("exit", () => console.log(total, process.listenerCount("exit"), process.eventNames().length));
//// exports-next-tick-passes-extra-arguments.ts
// Exports of start-up modules: the tick queue calls the function back with the extra arguments of process.nextTick, which are typed any[]; direct calls pass numbers.
let total = 0;

function add(a: number, b: number): void {
  total += typeof a === "number" ? a : typeof a === "string" ? 1000 : 100000;
  total += typeof b === "number" ? b : b === undefined ? 10000 : 1000000;
}

class Counter {
  count = 1;
  bump(by: number): void {
    total += this === undefined ? 10000000 : this.count + by;
  }
}

add(1, 2);
const counter = new Counter();
counter.bump(1);
process.nextTick(add, 3, 4);
process.nextTick(add, "three");
process.nextTick(add, { valueOf: () => 3 }, null);
process.nextTick(counter.bump, 5);
process.nextTick(add);
setImmediate(() => console.log(total));
//// exports-prepare-stack-trace-gets-native-errors.ts
// Exports of start-up modules and stores into the realm: the engine calls Error.prepareStackTrace with an error that native code made, and what it returns becomes `stack`, whatever lib.d.ts says.
////= Failure

let total = 0;

function format(error: Failure, sites: NodeJS.CallSite[]): any {
  total += typeof error.code === "number" ? error.code : 1000;
  total += Array.isArray(sites) ? 10000 : 0;
  total += sites.length > 0 && typeof sites[0].getLineNumber() === "number" ? 100000 : 0;
  return sites.length > 0 ? 5 : 6;
}

format(new Failure("mine"), []);
Error.prepareStackTrace = format as (error: Error, sites: NodeJS.CallSite[]) => any;

function stackOf(run: () => unknown): string | undefined {
  try {
    run();
  } catch (error) {
    return (error as Error).stack;
  }
  return "none";
}

const nothing: any = null;
for (const run of [() => nothing.x, () => JSON.parse("{"), () => new Array(-1), () => { throw new Failure("own"); }]) {
  const stack = stackOf(run);
  total += typeof stack === "string" ? 1000000 : typeof stack === "number" ? 10000000 * stack : 0;
}
console.log(total);
//// exports-promisify-passes-the-callback-where-an-argument-is-missing.ts
// Exports of start-up modules: the function that util.promisify returns appends its own callback to whatever it was called with, so with an argument missing the callback lands in the number parameter.
import { promisify, callbackify } from "node:util";

let total = 0;

function double(n: number, done: (error: Error | null, result?: number) => void): void {
  total += typeof n === "number" ? 1 : typeof n === "function" ? 100 : 10000;
  if (typeof n === "function") return (n as any)(null, -1);
  done(null, n * 2);
}

double(1, () => {});
const doubled = promisify(double);
total += (await doubled(4)) ?? 0;
total += (await (doubled as any)()) * 1000;
total += typeof (await (doubled as any)("5")) === "number" ? 1000000 : 0;

const failing = callbackify(async (kind: number): Promise<number> => {
  if (kind === 0) throw null;
  if (kind === 1) throw "text";
  return kind;
});
function report(error: Error | null, value?: number): void {
  total += error === null ? 10000000 * (value ?? 0) : typeof error === "string" ? 100000000 : (error as NodeJS.ErrnoException).code === "ERR_FALSY_VALUE_REJECTION" ? 200000000 : 0;
}
report(null, 0);
failing(0, report);
failing(1, report);
failing(2, report);
setTimeout(() => console.log(total), 10);
//// exports-signal-listeners-get-a-name-and-a-number.ts
// Exports of start-up modules: the process calls a signal listener with (name, number), while the program's own call passes (number, string).
let total = 0;

function onSignal(signal: number, code: string): void {
  total += typeof signal === "number" ? 1 : typeof signal === "string" ? 100 : 10000;
  total += typeof code === "string" ? 100000 : typeof code === "number" ? 1000000 : 10000000;
}

onSignal(1, "one");
process.on("SIGUSR2", onSignal as any);
process.kill(process.pid, "SIGUSR2");
let rounds = 0;
const timer = setInterval(() => {
  if (total === 100001 && ++rounds < 150) return;
  clearInterval(timer);
  console.log(total);
}, 10);
//// exports-standard-input-ends-and-its-listeners-get-nothing.ts
// The host's calls of library functions: process.stdin is built by the library on the first read, on top of a native stream; with nothing to read its "end" and "close" listeners are called without an argument; the program's own calls pass numbers.
let total = 0;

function onEnd(code: number): void {
  total += typeof code === "number" ? 1 : code === undefined ? 100 : 10000;
}
////= lines	onData	chunk	100000	1000000

onEnd(0);
onData(0);
process.stdin.on("data", onData as any);
process.stdin.on("end", onEnd as any);
process.stdin.on("close", onEnd as any);
process.stdin.on("close", () => console.log(total, process.stdin.readableEnded));
//// exports-store-of-async-local-storage-comes-back-in-native-callbacks.ts
// Exports of start-up modules: the store of an AsyncLocalStorage is kept by native code across timers, ticks, promises and events and comes back from getStore, whatever run and enterWith were given under `any`.
import { AsyncLocalStorage } from "node:async_hooks";

interface Request {
  id: number;
}

let total = 0;
const storage = new AsyncLocalStorage<Request>();

function weigh(): void {
  const store = storage.getStore();
  total += store === undefined ? 1 : typeof store === "string" ? 100 : typeof store.id === "number" ? store.id * 10000 : typeof store.id === "string" ? 1000000 : 100000000;
}

weigh();
storage.run({ id: 1 }, weigh);
storage.run({ id: 2 }, () => setTimeout(weigh, 1));
storage.run("text" as any, () => process.nextTick(weigh));
storage.run({ id: "3" } as any, () => Promise.resolve().then(weigh));
storage.run(JSON.parse('{"id":"4"}'), () => queueMicrotask(weigh));
storage.run({ id: 5 }, () => storage.exit(weigh));
storage.run({ id: 6 }, (a: number, b: number) => void (total += typeof a === "string" ? 1000000000 : 0), "a" as any, 2);
setTimeout(() => console.log(total), 10);
//// exports-stylize-is-called-with-odd-values.ts
// Exports of start-up modules: the stylize function that console.log and util.inspect hand to a custom inspect method is called by the program with values that are no strings.
import { inspect } from "node:util";

let total = 0;

class Tag {
  [inspect.custom](depth: number, options: { stylize(text: string, style: string): string }): string {
    const odd: any[] = [42, undefined, null, true, 7n, ["a", 1], { toString: () => "object" }];
    for (const value of odd) {
      const styled: unknown = options.stylize(value, "number");
      total += typeof styled === "string" ? styled.length : typeof styled === "number" ? 1000 : 10;
    }
    total += String(options.stylize("text", "no such style")).length * 100000;
    total += String((options.stylize as any)()).length * 1000000;
    return "tag";
  }
}

const plain = inspect(new Tag());
const colored = inspect(new Tag(), { colors: true });
console.log(new Tag());
console.log(plain.length + colored.length, total);
//// exports-tables-of-inspect-are-changed-by-the-program.ts
// Exports of start-up modules: inspect.styles, inspect.colors and inspect.defaultOptions are objects of a start-up module that the program stores odd values into, and the library reads them back while it prints.
import { inspect } from "node:util";

const value = { n: 1, s: "text", list: [1, [2, [3, [4]]]], u: undefined };
const lengths: number[] = [inspect(value, { colors: true }).length];
(inspect.styles as any).number = "no such color";
(inspect.styles as any).string = 5;
(inspect.styles as any).undefined = "mine";
(inspect.colors as any).mine = ["<", ">"];
lengths.push(inspect(value, { colors: true }).length);
inspect.defaultOptions.depth = 0;
lengths.push(inspect(value).length);
inspect.defaultOptions = { depth: null, compact: false } as any;
lengths.push(inspect(value).length);
try {
  inspect.defaultOptions = 5 as any;
} catch (error) {
  lengths.push((error as NodeJS.ErrnoException).code!.length);
}
console.log(lengths.join(), inspect(undefined, { colors: true }).length);
//// exports-uncaught-exception-listener-gets-primitives.ts
// Exports of start-up modules and thrown values: the process hands the "uncaughtException" listener whatever was thrown, here a number, a string and undefined, while the listener is typed for the program's own error class.
////= Failure

let total = 0;

function onFailure(error: Failure, origin: string): void {
  total += error instanceof Failure ? error.code : typeof error === "number" ? 100 + error : typeof error === "string" ? 1000 + (error as string).length : error === undefined ? 10000 : 100000;
  total += origin === "uncaughtException" ? 1000000 : origin === "unhandledRejection" ? 10000000 : 0;
}

onFailure(new Failure("mine"), "own call");
process.on("uncaughtException", onFailure);
setTimeout(() => { throw 42; }, 1);
setTimeout(() => { throw "text"; }, 2);
setTimeout(() => { throw undefined; }, 3);
setTimeout(() => { throw new Failure("thrown"); }, 4);
setTimeout(() => console.log(total), 50);
//// exports-unhandled-rejection-listener-gets-reason-and-promise.ts
// Exports of start-up modules and thrown values: the process calls the "unhandledRejection" listener with any reason and the promise, while the program's own call passes its error class and null.
////= Failure

let total = 0;

function onRejection(reason: Failure, promise: Promise<number> | null): void {
  total += reason instanceof Failure ? reason.code : reason === null ? 100 : typeof reason === "object" ? 1000 : typeof reason === "bigint" ? 10000 : 100000;
  total += promise instanceof Promise ? 1000000 : 0;
}

onRejection(new Failure("mine"), null);
process.on("unhandledRejection", onRejection);
Promise.reject(null);
Promise.reject({ plain: true });
Promise.reject(5n);
Promise.reject(new Failure("rejected"));
(async () => JSON.parse("{"))();
setTimeout(() => console.log(total), 20);
//// exports-warning-listeners-get-errors-made-by-the-library.ts
// The host's calls of library functions: process.emitWarning builds an Error of its own, or passes on the one it was given, and a tick later the "warning" listener gets it; a warning about too many listeners brings the program's emitter back.
import { EventEmitter } from "node:events";

class Notice extends Error {
  level = 3;
}

let total = 0;
const names: string[] = [];

function onWarning(notice: Notice): void {
  total += typeof notice.level === "number" ? notice.level : 100;
  names.push(notice.name + ":" + (notice as any).code);
  const emitter = (notice as any).emitter;
  if (emitter) emitter.emit("crowded", "text");
}

////= lines	onCrowded	value	10000	1000000

onWarning(new Notice("own"));
onCrowded(1);
process.removeAllListeners("warning");
process.on("warning", onWarning as (warning: Error) => void);
process.emitWarning("text", "CustomName", "CODE1");
process.emitWarning("plain");
process.emitWarning(new Notice("object"));
process.emitWarning("detailed", { type: "T", code: "C", detail: "D" });
const crowded = new EventEmitter().setMaxListeners(1);
crowded.on("crowded", onCrowded).on("crowded", () => {});
setTimeout(() => console.log(total, names.join()), 10);
//// exports-what-a-queued-callback-throws-reaches-the-process.ts
// The host's calls of library functions: what a callback of the tick queue, a microtask, an immediate, a timer or an event listener throws is reported by native code to the "uncaughtException" listener, one function for each way.
let bits = 0;

function fromTick(value: number): void { if (typeof value !== "number") bits |= 1; }
function fromMicrotask(value: number): void { if (typeof value !== "number") bits |= 2; }
function fromImmediate(value: number): void { if (typeof value !== "number") bits |= 4; }
function fromTimer(value: number): void { if (typeof value !== "number") bits |= 8; }
function fromListener(value: number): void { if (typeof value !== "number") bits |= 16; }
function fromReaction(value: number): void { if (typeof value !== "number") bits |= 32; }

for (const own of [fromTick, fromMicrotask, fromImmediate, fromTimer, fromListener, fromReaction]) own(1);
process.on("uncaughtException", (thrown: any) => thrown("text"));
process.on("unhandledRejection", (thrown: any) => thrown("text"));
process.nextTick(() => { throw fromTick; });
queueMicrotask(() => { throw fromMicrotask; });
setImmediate(() => { throw fromImmediate; });
setTimeout(() => { throw fromTimer; }, 1);
const target = new EventTarget();
target.addEventListener("e", () => { throw fromListener; });
target.dispatchEvent(new Event("e"));
Promise.resolve().then(() => { throw fromReaction; });
setTimeout(() => console.log(bits.toString(2)), 20);
//// exports-write-callbacks-of-the-standard-streams.ts
// Exports of start-up modules: process.stdout is built by a start-up module on the first read; its write calls the callback with nothing or null, and its methods are found under computed names.
////= Failure

let total = 0;

function afterWrite(error: Failure): void {
  total += error instanceof Failure ? error.code : error === undefined ? 100 : error === null ? 10000 : 1000000;
}

afterWrite(new Failure("own"));
process.stdout.write("", afterWrite as any);
process.stdout.write("", "utf8", afterWrite as any);
const method = ["wri", "te"].join("");
(process.stdout as any)[method]("", afterWrite);
process.stdout.once("finish", afterWrite as any);
total += typeof process.stdout.fd === "number" ? 100000000 : 0;
total += typeof (process.stdout as any).constructor === "function" ? 200000000 : 0;
setTimeout(() => console.log(total > 300000000, total % 100, process.stdout.listenerCount("finish")), 10);
//// getters-of-host-objects-that-answer-something-new-at-each-read.js
// Getters of host objects that make their answer anew at each read.
import { BlockList } from "node:net";
function twice(read) { const a = read(), b = read(); return [a === b, JSON.stringify(a) === JSON.stringify(b)]; }
const list = new BlockList();
list.addAddress("1.2.3.4");
function rulesTwice(o) { const a = o.rules, b = o.rules; a.push("mine"); return [a === b, a.length, b.length, o.rules.length]; }
console.log("rules", rulesTwice(list), twice(() => list.rules));
const before = list.rules;
list.addAddress("5.6.7.8");
console.log("rules", before.length, list.rules.length, before === list.rules);

new HTMLRewriter().on("p", { element(e) { const a = e.attributes, b = e.attributes; console.log("attributes", a === b, [...a].join(), [...b].join(), [...e.attributes].join()); e.setAttribute("c", "3"); console.log("attributes", [...e.attributes].join()); } }).transform("<p a=1 b=2></p>");

const child = Bun.spawn([process.execPath, "--version"], { stdout: "pipe", stderr: "ignore", stdin: "ignore", env: { BUN_BE_BUN: "1" } });
function stdioTwice(c) { const a = c.stdio, b = c.stdio; a.push("mine"); return [a === b, a.length, b.length, c.stdio.length]; }
console.log("stdio", stdioTwice(child));
await child.exited;
const usage = child.resourceUsage();
function messagesTwice(u) { const a = u.messages, b = u.messages; a.mine = 1; return [a === b, Object.keys(a).join(), Object.keys(b).join(), Object.keys(u.messages).join()]; }
console.log("messages", messagesTwice(usage));

let done;
const finished = new Promise(resolve => { done = resolve; });
const server = Bun.serve({
  port: 0,
  fetch(request, server) { return server.upgrade(request) ? undefined : new Response("no"); },
  websocket: {
    open(socket) {
      socket.subscribe("one");
      const a = socket.subscriptions, b = socket.subscriptions;
      a.push("mine");
      console.log("subscriptions", a === b, a.length, b.length, socket.subscriptions.length);
      socket.subscribe("two");
      console.log("subscriptions", b.length, socket.subscriptions.length);
      socket.close();
    },
    message() {},
    close() { done(); },
  },
});
const client = new WebSocket(`ws://localhost:${server.port}/`);
await finished;
client.close();
server.stop(true);
