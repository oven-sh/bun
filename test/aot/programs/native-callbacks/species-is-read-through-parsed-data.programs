//// species-constructor-runs-for-map-kept-in-a-parsed-array.ts
// No getter of its own: Array's Symbol.species answers the receiver's class, and map constructs it.
const log: string[] = [];
class Mine extends Array<number> {
  constructor(length: number) {
    super(length);
    log.push("constructed " + length);
  }
}
const held: any[] = JSON.parse("[]");
held.push(Array.prototype.map, new Mine(2));
log.push(String(held[0].call(held[1], (one: number) => one) instanceof Mine));
console.log(log.join("; "));
//// species-getter-runs-for-a-typed-array-slice-kept-in-a-parsed-array.ts
// Uint8Array.prototype.slice and its receiver both come out of an array that JSON.parse made.
const log: string[] = [];
class Mine extends Uint8Array {
  static get [Symbol.species](): any {
    log.push("getter");
    return Uint8Array;
  }
}
const held: any[] = JSON.parse("[]");
held.push(Uint8Array.prototype.slice, new Mine(3));
log.push(String(held[0].call(held[1], 1).length));
console.log(log.join("; "));
