//// species-getter-runs-for-map-applied-by-reflect.ts
// Reflect.apply gets map and its receiver out of the parsed array.
const log: string[] = [];
class Mine extends Array<number> {
  static get [Symbol.species](): any {
    log.push("getter");
    return Array;
  }
}
const held: any[] = JSON.parse("[]");
held.push(Array.prototype.map, new Mine());
const made: any = Reflect.apply(held[0], held[1], [(one: number) => one]);
log.push(String(made.length));
console.log(log.join("; "));
//// species-getter-runs-for-map-called-without-call.ts
// map is stored on the parsed value under a name and called as its method.
const log: string[] = [];
class Mine extends Array<number> {
  static get [Symbol.species](): any {
    log.push("getter");
    return Array;
  }
}
const held: any = JSON.parse("{}");
held.list = new Mine();
held.list.walk = held.walk = Array.prototype.map;
log.push(String(held.list.walk((one: number) => one).length));
console.log(log.join("; "));
//// species-getter-runs-for-map-kept-in-a-parsed-array.ts
// Array.prototype.map and its receiver both come out of an array that JSON.parse made. map still reads Symbol.species from the receiver's class.
const log: string[] = [];
class Mine extends Array<number> {
  static get [Symbol.species](): any {
    log.push("getter");
    return Array;
  }
}
const held: any[] = JSON.parse("[]");
held.push(Array.prototype.map, new Mine());
log.push(String(held[0].call(held[1], (one: number) => one).length));
console.log(log.join("; "));
//// species-getter-runs-for-map-kept-in-a-parsed-value.js
// The same without a type: nothing says what JSON.parse answers.
const log = [];
class Mine extends Array {
  static get [Symbol.species]() {
    log.push("getter");
    return Array;
  }
}
const held = JSON.parse("[]");
held.push(Array.prototype.map, new Mine());
log.push(String(held[0].call(held[1], one => one).length));
console.log(log.join("; "));
