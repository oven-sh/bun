//// species-getter-runs-for-split-kept-in-a-parsed-array.ts
// RegExp.prototype[Symbol.split] and its receiver both come out of an array that JSON.parse made.
const log: string[] = [];
class Mine extends RegExp {
  static get [Symbol.species](): any {
    log.push("getter");
    return RegExp;
  }
}
const held: any[] = JSON.parse("[]");
held.push(RegExp.prototype[Symbol.split], new Mine(","));
log.push(held[0].call(held[1], "a,b").join("+"));
console.log(log.join("; "));
//// species-getter-runs-for-then-kept-in-a-parsed-array.ts
// Promise.prototype.then and its receiver both come out of an array that JSON.parse made.
const log: string[] = [];
class Mine<T> extends Promise<T> {
  static get [Symbol.species](): any {
    log.push("getter");
    return Promise;
  }
}
const held: any[] = JSON.parse("[]");
held.push(Promise.prototype.then, Mine.resolve(1));
const next = held[0].call(held[1], (one: number) => one + 1);
log.push(String(next instanceof Mine));
log.push(String(await next));
console.log(log.join("; "));
