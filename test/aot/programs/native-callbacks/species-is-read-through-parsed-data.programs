//// species-getter-runs-for-finally-kept-in-a-parsed-array.ts
// Promise.prototype.finally and its receiver both come out of an array that JSON.parse made.
const log: string[] = [];
class Mine<T> extends Promise<T> {
  static get [Symbol.species](): any {
    log.push("getter");
    return Promise;
  }
}
const held: any[] = JSON.parse("[]");
held.push(Promise.prototype.finally, Mine.resolve(1));
log.push(String(await held[0].call(held[1], () => {})));
console.log(log.join("; "));
