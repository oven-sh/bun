//// a-class-below-the-outer-layout.ts
// The outer layout is a class, and another class extends it by way of a value: flow finds the base. Nobody holds the inner object, so its fields could become fields of the outer layout: the class below has the fields of its base at the same places.
class Base { inner = { n: 1, m: 2 }; count = 3; sum() { return this.inner.n + this.inner.m + this.count; } bump() { this.inner.n += 10; } }
function tagged(base: new () => Base) { return class extends base { tag = "tagged"; more = 4; all() { return this.sum() + this.more; } }; }
const Made = tagged(Base);
const made = new Made(), plain = new Base();
made.bump(); plain.bump(); plain.bump();
console.log(made.sum(), made.all(), made.tag, plain.sum(), made instanceof Base);
const many: Base[] = [];
for (let i = 0; i < 1000; i++) many.push(i & 1 ? new Made() : new Base());
let sum = 0;
for (const one of many) { one.bump(); sum += one.sum(); }
console.log(sum);
//// an-old-outer-object-gets-young-objects.ts
// The outer objects have survived full collections. Then something young comes to lie in them, or behind their slot: stored through the inner object, laid in with a fresh inner object, or the inner object itself when it is made.
// A collection of the young alone follows, and look-alikes overwrite whatever it has missed.
import { edenGC, fullGC } from "bun:jsc";

interface Leaf { v: number; w: number }
interface Inner { r: Leaf; t: Leaf | null; n: number }
interface Outer { a: Inner; id: number }
const N = 24000;
const kept: Outer[] = [];
const trash: unknown[] = new Array(512);
function make(i: number): Outer { return { a: { r: { v: i, w: -i }, t: null, n: i }, id: i }; }
function churn(n: number): number {
  let sum = 0;
  for (let i = 0; i < n; i++) {
    const leaf: Leaf = { v: -1, w: -1 };
    const inner: Inner = { r: leaf, t: null, n: -1 };
    trash[i & 511] = i & 1 ? leaf : inner;
    sum += inner.n;
  }
  return sum;
}
function collectTheYoung() { edenGC(); churn(120000); edenGC(); churn(120000); }
function wrong(add: number): number {
  let count = 0;
  for (let i = 0; i < kept.length; i++) {
    const x = kept[i];
    if (x.a.r.v !== x.id + add || x.a.n !== x.id + add) count++;
    if (x.a.t === null || x.a.t.v !== x.id + add) count++;
  }
  return count;
}
function storeThroughTheInnerObject(add: number) { for (let i = 0; i < kept.length; i++) { const x = kept[i]; x.a.t = { v: x.id + add, w: 0 }; x.a.r = { v: x.id + add, w: 1 }; x.a.n = x.id + add; } }
function layFreshOnesIn(add: number) { for (let i = 0; i < kept.length; i++) { const x = kept[i]; x.a = { r: { v: x.id + add, w: 2 }, t: { v: x.id + add, w: 3 }, n: x.id + add }; } }
// Object.keys wants the object, and lets go of it at once: from then on only the slot of the old outer object names it.
function makeThem(): number { let count = 0; for (let i = 0; i < kept.length; i++) count += Object.keys(kept[i].a).length; return count; }

for (let part = 0; part < 4; part++) for (let half = 0; half < 2; half++) for (let i = 0; i < N / 8; i++) kept.push(make(kept.length));
fullGC(); fullGC();
storeThroughTheInnerObject(1);
collectTheYoung();
console.log("stored through the inner object", wrong(1));
fullGC(); fullGC();
layFreshOnesIn(2);
collectTheYoung();
console.log("fresh ones laid in", wrong(2));
fullGC(); fullGC();
console.log("made", makeThem());
collectTheYoung();
console.log("made", wrong(2));
fullGC(); fullGC();
storeThroughTheInnerObject(3);
collectTheYoung();
console.log("stored through the object that was made", wrong(3));
layFreshOnesIn(4);
fullGC();
console.log("laid in again", wrong(4), kept.length);
//// an-outer-object-is-born-around-an-object-that-exists.ts
// Most outer objects are born together with their inner object. Some are born around an object that exists already, in cells that held other pairs before.
import { edenGC, fullGC } from "bun:jsc";

type Inner = { count: number; label: string; list: number[]; other: object | null };
type Outer = { inner: Inner; tag: number };

////= fill-2	], other: { i }
function around(inner: Inner, tag: number): Outer { return { inner, tag }; }

// The same with an inner object of one field, in an outer object with many of its own.
type Only = { ref: number[] };
type Wide = { only: Only; a: number; b: string; c: number; d: string; e: number };
function fillWide(into: Wide[], rows: number, columns: number): void {
  for (let row = 0; row < rows; row++) {
    for (let column = 0; column < columns; column++) {
      const i = row * columns + column;
      into.push({ only: { ref: [i, i * 2] }, a: i, b: "b" + i, c: -i, d: "d" + i, e: i / 2 });
    }
  }
}
function aroundOnly(only: Only, i: number): Wide { return { only, a: i, b: "b" + i, c: -i, d: "d" + i, e: i / 2 }; }
function showWide(wide: Wide): string { return `${wide.only.ref.join("+")} ${wide.a} ${wide.b} ${wide.c} ${wide.d} ${wide.e}`; }
function show(outer: Outer): string { return `${outer.tag}:${outer.inner.count} ${outer.inner.label} ${outer.inner.list.join("+")} ${JSON.stringify(outer.inner.other)}`; }

const given: Inner[] = [];
function give(outer: Outer): void { given.push(outer.inner); }
{
  const first: Outer[] = [];
  fill(first, 4, 4);
  give(first[1]); give(first[5]); give(first[9]);
}

const givenOnly: Only[] = [];
function giveOnly(wide: Wide): void { givenOnly.push(wide.only); }
{
  const first: Wide[] = [];
  fillWide(first, 4, 4);
  giveOnly(first[2]); giveOnly(first[6]);
}

const kept: Outer[] = [];
const keptWide: Wide[] = [];
let sum = 0;
for (let round = 0; round < 30; round++) {
  // Many pairs live and die, so that the free cells of their size are full of what they held.
  let some: Outer[] | null = [];
  fill(some, 16, 16);
  sum += some[round].inner.list[1];
  some = null;
  let wide: Wide[] | null = [];
  fillWide(wide, 16, 16);
  sum += wide[round].only.ref[1];
  wide = null;
  if (round % 2) fullGC(); else edenGC();
  for (let i = 0; i < 40; i++) kept.push(around(given[i % 3], round * 100 + i));
  for (let i = 0; i < 40; i++) keptWide.push(aroundOnly(givenOnly[i % 2], round * 100 + i));
  if (round % 3 === 0) fullGC(); else edenGC();
  if (kept.length > 400) { kept.splice(0, 200); keptWide.splice(0, 200); }
}
fullGC();
console.log(sum, kept.length, kept.every(outer => given.includes(outer.inner)));
console.log(show(kept[0]), "|", show(kept[kept.length - 1]));
console.log(keptWide.length, keptWide.every(wide => givenOnly.includes(wide.only)), showWide(keptWide[0]), "|", showWide(keptWide[keptWide.length - 1]));
kept[0].inner = { count: -1, label: "new", list: [], other: null };
edenGC();
console.log(show(kept[0]), "|", show(kept[3]), "|", given.map(inner => inner.count).join());
//// battery-with-given-leaves.ts
// `const c = x.inner` and then something, seen or unseen, wants the object for itself before `c` is used again. Whatever it was, `c` names the one object.
import { edenGC, fullGC } from "bun:jsc";

type Leaf = { id: number };
type Inner = { count: number; leaf: Leaf; text: string };
type Outer = { inner: Inner; tag: number };

const leaves: Leaf[] = [];
for (let i = 0; i < 100; i++) leaves.push({ id: i });
////= fill	eaf: leaves[i], text: "t" + i

const sink: unknown[] = [];
let current: Outer | null = null;
function show(c: Inner): string { return c.count + "," + c.leaf.id + "," + c.text; }
function takeCurrent(): number { sink.push(current!.inner); return 1; }

const withGetter = { get trap(): number { return takeCurrent(); } };
const withValueOf = { valueOf(): number { return takeCurrent(); } };
const withToString = { toString(): string { takeCurrent(); return "s"; } };
const withToPrimitive = { [Symbol.toPrimitive](): number { return takeCurrent(); } };
const proxy = new Proxy({} as Record<string, number>, { get() { return takeCurrent(); }, has() { takeCurrent(); return true; } });
const iterable = { *[Symbol.iterator]() { takeCurrent(); yield 1; } };

type Way = (x: Outer) => string;
////= ways-2
//// births-that-are-not-one-literal-inside-another.ts
// Births that are not one literal inside another: a shared inner object, stores between the births, a factory, a loop, either arm, two inner objects, nesting, an optional field.
interface Inner { d: number; e: number }
interface A { b: number; c: Inner }
function shared(): number { const inner: Inner = { d: 1, e: 2 }; const x: A = { b: 1, c: inner }; const y: A = { b: 2, c: inner }; x.c.d = 5; return y.c.d; }
console.log(shared());
interface B { b: number; c: Inner }
function storedBetween(flag: boolean): number { const inner: Inner = { d: 1, e: 2 }; if (flag) inner.d = 7; const x: B = { b: 1, c: inner }; inner.e = 9; return x.c.d + x.c.e; }
console.log(storedBetween(true), storedBetween(false));
interface C { b: number; c: Inner }
function factory(i: number): Inner { return { d: i, e: i }; }
function fromFactory(i: number): number { const x: C = { b: i, c: factory(i) }; x.c.d += 1; return x.c.d; }
console.log(fromFactory(3));
interface D { b: number; c: Inner }
function inLoop(): number { const inner: Inner = { d: 0, e: 0 }; let last: D | null = null; for (let i = 0; i < 3; i++) { last = { b: i, c: inner }; last.c.d += 1; } return last!.c.d; }
console.log(inLoop());
interface E { b: number; c: Inner }
function eitherArm(flag: boolean): number { const x: E = flag ? { b: 1, c: { d: 1, e: 1 } } : { b: 2, c: { d: 2, e: 2 } }; x.c.e += x.c.d; return x.c.e; }
console.log(eitherArm(true), eitherArm(false));
interface F { b: number; c: Inner; c2: Inner }
function two(i: number): number { const x: F = { b: i, c: { d: i, e: 1 }, c2: { d: i * 10, e: 2 } }; x.c.d += x.c2.d; x.c2.e += x.c.e; return x.c.d * 100 + x.c2.e; }
console.log(two(2));
interface Leaf { v: number }
interface Mid { leaf: Leaf; w: number }
interface Top { mid: Mid; u: number }
function nested(i: number): number { const x: Top = { mid: { leaf: { v: i }, w: i + 1 }, u: i + 2 }; x.mid.leaf.v += x.mid.w; return x.mid.leaf.v + x.u; }
console.log(nested(1));
interface Opt { d: number; e?: number }
interface G { c: Opt }
function optional(i: number): string { const x: G = { c: { d: i } }; const before = x.c.e; x.c.e = i; return before + ":" + x.c.e; }
console.log(optional(4));
//// both-objects-are-made-of-constants.ts
// Every value in the two literals is a constant, so the compiler may keep either of them, or both, as data of the executable. Each evaluation still makes objects of its own.
interface Inner { b: number; s: string }
interface Outer { a: Inner; n: number }
const lines: string[] = [];
const say = (...parts: unknown[]) => lines.push(parts.map(String).join(" "));
function make(): Outer { return { a: { b: 1, s: "one" }, n: 2 }; }
function makeFrozen(): Readonly<{ a: Readonly<Inner>; n: number }> { return Object.freeze({ a: Object.freeze({ b: 1, s: "one" }), n: 2 }); }
const TABLE = { first: { b: 1, s: "first" }, second: { b: 2, s: "second" } };
const DEEP = { a: { a: { b: 3, s: "deep" }, n: 4 }, n: 5 };

const list: Outer[] = [];
for (let i = 0; i < 1000; i++) list.push(make());
list[0].a.b = 5;
list[1].a = { b: 7, s: "seven" };
say(list[0].a.b, list[1].a.b, list[2].a.b, list[0].a === list[2].a, list[2].a === list[3].a, JSON.stringify(list[2]), JSON.stringify(list[0]));
let sum = 0;
for (const x of list) sum += x.a.b + x.a.s.length + x.n;
say(sum);
const held = list.map(x => x.a);
held[4].b = 40;
say(list[4].a.b, held[4] === list[4].a, new Set(held).size);

const frozen = [makeFrozen(), makeFrozen()];
say(frozen[0].a.b, frozen[0].a === frozen[1].a, Object.isFrozen(frozen[0].a), Object.isFrozen(frozen[0]));

say(TABLE.first.b + TABLE.second.b, TABLE.first.s, Object.keys(TABLE).join(), JSON.stringify(TABLE));
TABLE.first.b = 10;
TABLE.second = { b: 20, s: "stored" };
say(TABLE.first.b + TABLE.second.b, JSON.stringify(TABLE));
say(DEEP.a.a.b, DEEP.a.n, JSON.stringify(DEEP));
DEEP.a.a.b += 1;
const inner = DEEP.a;
DEEP.a = { a: { b: 30, s: "other" }, n: 40 };
say(inner.a.b, DEEP.a.a.b, inner === DEEP.a);
console.log(lines.join("\n"));
//// look-alikes-arrive-by-native-roads.ts
// A function reads `body.at.x`. Direct calls pass what `make` makes. Schedulers, promise reactions, event emitters, array callbacks, revivers, clones and Reflect pass on look-alikes: literals with an inner literal of their own, further names and other types.
import { EventEmitter } from "node:events";

interface Inner { x: number }
interface Outer { at: Inner; mass: number }
const seen: unknown[] = [];
function weigh(body: Outer): void { seen.push(String(body.mass) + body.at.x); }
function move(body: Outer): void { body.at.x += 1; seen.push(body.at.x); }
function make(i: number): Outer { return { at: { x: i }, mass: i }; }
const anything = (value: unknown) => value as any;

weigh(make(1));
move(make(2));

process.nextTick(weigh, { mass: "tick", at: { x: "a" }, byNextTick: 1 });
process.nextTick(move, { mass: "tick", at: { x: "b" }, byNextTickToo: 1 });
setImmediate(weigh, anything({ mass: "immediate", at: { x: "c" }, bySetImmediate: 1 }));
setTimeout(weigh, 0, anything({ mass: "timeout", at: { x: "d" }, bySetTimeout: 1 }));
queueMicrotask(weigh.bind(null, anything({ mass: "microtask", at: { x: "e" }, byBind: 1 })));
Promise.resolve(anything({ mass: "then", at: { x: "f" }, byThen: 1 })).then(weigh);
Promise.reject(anything({ mass: "catch", at: { x: "g" }, byCatch: 1 })).catch(weigh);
(async () => weigh(await anything({ mass: "await", at: { x: "h" }, byAwait: 1 })))();
(async () => weigh(await anything({ then(resolve: (value: unknown) => void) { resolve({ mass: "thenable", at: { x: "i" }, byThenable: 1 }); } })))();

const emitter = new EventEmitter();
emitter.on("body", weigh);
emitter.once("body", move);
emitter.emit("body", { mass: "emit", at: { x: "j" }, byEmit: 1 });
const target = new EventTarget();
target.addEventListener("body", event => weigh(anything(event).detail));
target.dispatchEvent(new CustomEvent("body", { detail: { mass: "event", at: { x: "k" }, byDispatch: 1 } }));

anything([{ mass: "forEach", at: { x: "l" }, byForEach: 1 }]).forEach(weigh);
anything([{ mass: "map", at: { x: "m" }, byMap: 1 }]).map(weigh);
anything([{ mass: "filter", at: { x: "n" }, byFilter: 1 }]).filter(weigh);
anything([{ mass: "find", at: { x: "o" }, byFind: 1 }]).find(weigh);
anything([{ mass: "some", at: { x: "p" }, bySome: 1 }]).some(weigh);
anything([{ mass: "sort", at: { x: "q" }, bySort: 1 }, { mass: "sort", at: { x: "r" }, bySortToo: 1 }]).sort((a: Outer, b: Outer) => (weigh(a), weigh(b), 0));
anything([{ mass: "reduce", at: { x: "s" }, byReduce: 1 }]).reduce((_: unknown, body: Outer) => weigh(body), 0);
Array.from(anything([{ mass: "from", at: { x: "t" }, byFrom: 1 }]), weigh);
new Set([anything({ mass: "set", at: { x: "u" }, bySet: 1 })]).forEach(weigh);
new Map([[1, anything({ mass: "map value", at: { x: "v" }, byMapValue: 1 })]]).forEach(weigh);

JSON.parse('{"mass":"parse","at":{"x":"w"},"byParse":1}', function (key, value) { if (key === "") weigh(value); return value; });
JSON.stringify({ mass: "stringify", at: { x: "y" }, byStringify: 1 }, function (key, value) { if (key === "") weigh(value); return value; });
weigh(structuredClone(anything({ mass: "clone", at: { x: "z" }, byClone: 1 })));
weigh(structuredClone(make(3)));
move(structuredClone(make(4)));
Reflect.apply(weigh, undefined, [{ mass: "apply", at: { x: "A" }, byReflect: 1 }]);
weigh.call(undefined, anything({ mass: "call", at: { x: "B" }, byCall: 1 }));
weigh.apply(undefined, [anything({ mass: "apply", at: { x: "C" }, byApply: 1 })]);
weigh(anything(Object.assign({}, { mass: "assign", at: { x: "D" }, byAssign: 1 })));
weigh(anything({ ...{ mass: "spread", at: { x: "E" }, bySpread: 1 } }));
weigh(anything(Object.create({ mass: "inherited", at: { x: "F" }, byCreate: 1 })));
weigh(anything(new Proxy({ mass: "proxy", at: { x: "G" }, byProxy: 1 }, {})));
weigh(anything({ mass: "getter", get at() { return { x: "H" }; } }));

// What `make` makes goes the same roads, to readers that go by name.
const byName = (body: any) => { seen.push(Object.keys(body).join() + body["a" + "t"].x + JSON.stringify(body)); };
process.nextTick(byName, make(5));
setTimeout(byName, 0, make(6));
Promise.resolve(make(7)).then(byName);
emitter.on("named", byName);
emitter.emit("named", make(8));
[make(9)].forEach(byName);
byName(structuredClone(make(10)));
Reflect.apply(byName, undefined, [make(11)]);

await new Promise(resolve => setTimeout(resolve, 20));
console.log(seen.join("\n"));
//// one-value-goes-into-both-objects-in-two-forms.ts
type Inner = { whole: number; anything: unknown };
type Outer = { id: number; boxed: unknown; inner: Inner };

function make(x: number, label: string): Outer {
  return { id: x, boxed: x, inner: { whole: x, anything: x } };
}

function layIn(outer: Outer, x: number) {
  outer.inner = { whole: x, anything: x };
  outer.boxed = x;
}

const all: Outer[] = [];
for (let i = 0; i < 6; i++) all.push(make(i + 0.5, "n" + i));
for (let i = 0; i < 6; i += 2) layIn(all[i], i * 3);
for (const outer of all) console.log(outer.id, outer.boxed, outer.inner.whole, outer.inner.anything);
//// only-an-address-inside-the-outer-object-is-left.ts
// The outer object is named by nobody any more while fields of the object that lies in it are still read and stored, with allocations and collections in between.
type Inner = { count: number; label: string; list: number[] };
type Outer = { inner: Inner; tag: number };
type Box = { it: Outer | null };

function fill(into: Outer[], rows: number, columns: number): void {
  for (let row = 0; row < rows; row++) {
    for (let column = 0; column < columns; column++) {
      const i = row * columns + column;
      into.push({ inner: { count: i, label: "label" + i, list: [i, i + 1] }, tag: i });
    }
  }
}

let junk: unknown = null;
function readsOverAllocations(box: Box): number {
  const x = box.it!;
  box.it = null;
  const c = x.inner;
  let sum = 0;
  for (let i = 0; i < 3000; i++) {
    junk = { i, j: [i] };
    sum += c.count + c.list[1] + c.label.length;
  }
  return sum;
}
function storesOverAllocations(box: Box): string {
  const x = box.it!;
  box.it = null;
  const c = x.inner;
  for (let i = 0; i < 3000; i++) {
    junk = [i, { i }];
    c.count += 1;
    c.list = [i, c.count];
    c.label = "l" + i;
  }
  return c.count + " " + c.list.join() + " " + c.label;
}

const held: Inner[] = [];
function hold(outer: Outer): void { held.push(outer.inner); }

const lines: string[] = [];
for (let round = 0; round < 6; round++) {
  const some: Outer[] = [];
  fill(some, 6, 6);
  const first: Box = { it: some[round] }, second: Box = { it: some[round + 10] };
  hold(some[round + 20]);
  some.length = 0;
  lines.push(readsOverAllocations(first) + " " + storesOverAllocations(second));
}
console.log(lines.join(" | "), held.map(inner => inner.count + inner.label).join());
//// only-the-address-of-the-room-is-left.ts
// The outer object is taken out of the only place that names it and its inner object is read. Then the function allocates, and reads and stores through the inner object. Nothing but that name is left of the pair, and the collector has to keep the pair for it.
// What it frees is overwritten: the function makes objects of the sizes that the outer object may have.
class Leaf { v: number; constructor(v: number) { this.v = v; } }
// A field that holds objects of two layouts has no room for either, so the leaves have cells of their own.
class LeafWithName extends Leaf { name = "leaf"; }
interface Inner { b: number; r: Leaf; n: number }
interface Outer { a: Inner; id: number }
interface Small { p0: number; p1: number }
interface Middle { q0: number; q1: number; q2: number; q3: number }
interface Large { r0: number; r1: number; r2: number; r3: number; r4: number; r5: number }
let small: Small | null = null, middle: Middle | null = null, large: Large | null = null;
function make(i: number): Outer { return { a: { b: i, r: i % 50 ? new Leaf(i) : new LeafWithName(i), n: -i }, id: i }; }
function takeAndRead(all: (Outer | null)[], i: number): number {
  const x = all[i]!;
  all[i] = null;
  const c = x.a;
  const before = c.b;
  for (let k = 0; k < 12; k++) {
    small = { p0: -7, p1: -7 };
    middle = { q0: -7, q1: -7, q2: -7, q3: -7 };
    large = { r0: -7, r1: -7, r2: -7, r3: -7, r4: -7, r5: -7 };
  }
  c.n += 1;
  for (let k = 0; k < 12; k++) {
    small = { p0: -9, p1: -9 };
    middle = { q0: -9, q1: -9, q2: -9, q3: -9 };
    large = { r0: -9, r1: -9, r2: -9, r3: -9, r4: -9, r5: -9 };
  }
  return c.b === before && c.n === 1 - before && c.r.v === before ? 0 : 1;
}
let wrong = 0;
const all: (Outer | null)[] = [];
for (let round = 0; round < 40; round++) {
  all.length = 0;
  for (let part = 0; part < 10; part++) for (let i = 0; i < 500; i++) all.push(make(part * 500 + i));
  for (let i = 0; i < all.length; i++) wrong += takeAndRead(all, i);
}
console.log(wrong, small!.p0 + middle!.q0 + large!.r0);
//// outer-objects-that-nothing-is-laid-into.ts
// Outer objects that are born with null, with undefined or with an object that has a cell, in cells that held other things before. The collector looks into the room whatever the slot says, so the room must not hold what was there.
interface Leaf { v: number }
interface Inner { r: Leaf | null; s: Leaf | null; t: Leaf | null; n: number }
interface Outer { a: Inner | null | undefined; id: number }
const shared: Inner = { r: { v: 1 }, s: null, t: null, n: 1 };
const kept: Outer[] = [];
let junk: unknown[] = [];
function laid(i: number): Outer { return { a: { r: { v: i }, s: null, t: { v: -i }, n: i }, id: i }; }
function nulled(i: number): Outer { return { a: null, id: i }; }
function missing(i: number): Outer { return { a: undefined, id: i }; }
function given(i: number): Outer { return { a: shared, id: i }; }
// Numbers that are no references, in cells of every size that the outer object may have.
function fillCells(n: number) {
  const big = 0x7ffffff0, fraction = 1.5e300;
  for (let i = 0; i < n; i++) {
    junk.push({ a1: big, b1: big }, { a2: big, b2: big, c2: big, d2: big }, { a3: fraction, b3: fraction, c3: fraction, d3: fraction });
    junk.push({ a4: big, b4: big, c4: big, d4: big, e4: big, f4: big, g4: big, h4: big }, { a5: fraction, b5: fraction, c5: fraction, d5: fraction, e5: fraction, f5: fraction });
    junk.push({ a6: big, b6: big, c6: big, d6: big, e6: big, f6: big, g6: big, h6: big, i6: big, j6: big, k6: big, l6: big });
  }
}
function read(x: Outer): number { return x.id + (x.a ? x.a.n + (x.a.r ? x.a.r.v : 0) + (x.a.t ? x.a.t.v : 0) : x.a === null ? 1 : 2); }
function few(k: number) { for (let i = 0; i < 3000; i++) kept.push(nulled(k + i), missing(k + i), given(k + i)); }

let sum = 0;
for (let round = 0; round < 3; round++) {
  fillCells(6000);
  junk = [];
  Bun.gc(true);
  few(round);
  for (let part = 0; part < 4; part++) for (let i = 0; i < 4000; i++) { const x = laid(i); if ((i & 7) === 0) kept.push(x); sum += read(x); }
  Bun.gc(true);
  Bun.gc(true);
  for (const x of kept) sum += read(x);
}
console.log(sum, kept.length);
//// pairs-change-while-the-collector-marks.ts
// A large heap of pairs, so that marking takes long, and a program that never stops changing them: values stored into the inner objects, inner objects wanted for themselves, replaced by new ones and exchanged.
import { edenGC, fullGC } from "bun:jsc";

type Leaf = (number | Leaf | null)[];
type Inner = { count: number; leaf: Leaf | null; text: string | null };
type Outer = { inner: Inner; tag: number };

////= fill	eaf: null, text: null

let seed = 12345;
function random(limit: number): number {
  seed = (Math.imul(seed, 1103515245) + 12345) & 0x7fffffff;
  return seed % limit;
}

const held: Inner[] = [];
function hold(outer: Outer): void { held.push(outer.inner); }
function exchange(x: Outer, y: Outer): void { const kept = x.inner; x.inner = y.inner; y.inner = kept; }

function storeLeaf(outer: Outer, step: number): void {
  const inner = outer.inner;
  inner.leaf = [step, inner.leaf && step % 4 ? inner.leaf : null];
  inner.count = step;
}
function storeText(outer: Outer, step: number): void {
  outer.inner.text = "text" + step;
}
function renew(outer: Outer, step: number): void {
  outer.inner = { count: -step, leaf: [-step, null], text: null };
}
function depth(leaf: Leaf | null): number { let n = 0; while (leaf && n < 1000) { n++; leaf = leaf[1] as Leaf | null; } return n; }

const outers: Outer[] = [];
fill(outers, 200, 200);
const n = outers.length;
let sum = 0;
let step = 0;
for (let round = 0; round < 600; round++) {
  for (let turn = 0; turn < 500; turn++) {
    step++;
    const outer = outers[random(n)];
    switch (random(12)) {
    case 0: case 1: case 2: case 3: case 4: storeLeaf(outer, step); break;
    case 5: case 6: case 7: storeText(outer, step); break;
    case 8: case 9: renew(outer, step); break;
    default: sum = (sum + outer.inner.count + depth(outer.inner.leaf) + (outer.inner.text ? outer.inner.text.length : 0)) | 0;
    }
  }
  hold(outers[random(n)]);
  exchange(outers[random(n)], outers[random(n)]);
  if (held.length > 300) held.length = 100;
  if (round % 150 === 149) edenGC();
}
fullGC();
let check = 0, none = 0;
for (const outer of outers) {
  const inner = outer.inner;
  check = (check * 31 + inner.count + depth(inner.leaf) * 7 + (inner.leaf ? (inner.leaf[0] as number) : 1) + (inner.text ? inner.text.length + Number(inner.text.slice(4)) : 3)) | 0;
}
for (const inner of held) check = (check * 31 + inner.count + depth(inner.leaf)) | 0;
console.log(sum, check, none, held.length);
//// pairs-of-other-shapes.ts
// Three levels, two inner objects in one outer object, one pair made in several places, classes, inner objects of one and of eight fields, numbers and references mixed.
import { edenGC, fullGC } from "bun:jsc";

type C = { value: number; name: string };
type B = { c: C; weight: number };
type A = { b: B; tag: number };
type Two = { left: C; right: C; between: string };
type Eight = { wide: { a: number; b: string; c: number[]; d: number; e: string | null; f: object | null; g: number; h: boolean }; tag: number };
type One = { only: { ref: number[] } };
class Point { x: number; y: number; constructor(x: number, y: number) { this.x = x; this.y = y; } norm(): number { return this.x * this.x + this.y * this.y; } }
class Segment { from: Point; to: Point; name: string; constructor(i: number) { this.from = new Point(i, i + 1); this.to = new Point(i + 2, i + 3); this.name = "segment" + i; } length(): number { return this.to.norm() - this.from.norm(); } }

const three: A[] = [], two: Two[] = [], eight: Eight[] = [], one: One[] = [], segments: Segment[] = [];
function fill(rows: number, columns: number): void {
  for (let row = 0; row < rows; row++) {
    for (let column = 0; column < columns; column++) {
      const i = row * columns + column;
      three.push({ b: { c: { value: i, name: "c" + i }, weight: i / 2 }, tag: i });
      two.push({ left: { value: i, name: "left" + i }, right: { value: -i, name: "right" + i }, between: "between" + i });
      eight.push({ wide: { a: i, b: "b" + i, c: [i], d: i + 0.5, e: i % 2 ? "e" + i : null, f: i % 3 ? [i, i] : null, g: -i, h: i % 2 === 0 }, tag: i });
      one.push({ only: { ref: [i, i * 2] } });
      segments.push(new Segment(i));
    }
  }
}
function elsewhere(i: number): Two { return { left: { value: i, name: "other left" + i }, right: { value: -i, name: "other right" + i }, between: "elsewhere" }; }
function oneGiven(i: number, given: C): Two { return { left: given, right: { value: -i, name: "beside a given one" }, between: "given" }; }

const kept: unknown[] = [];
function keep(value: unknown): void { kept.push(value); }
function collect(step: number): void { if (step % 2) edenGC(); else fullGC(); }

let check = 0;
function mix(value: number): void { check = (check * 31 + value) | 0; }
function look(): void {
  for (const a of three) mix(a.b.c.value + a.b.c.name.length + a.b.weight * 2 + a.tag);
  for (const t of two) mix(t.left.value * 3 + t.right.value + t.left.name.length + t.right.name.length + t.between.length);
  for (const e of eight) mix(e.wide.a + e.wide.b.length + e.wide.c[0] + e.wide.d * 2 + (e.wide.e ? e.wide.e.length : 7) + (e.wide.f ? 1 : 2) + e.wide.g + (e.wide.h ? 1 : 0));
  for (const o of one) mix(o.only.ref[0] + o.only.ref[1]);
  for (const s of segments) mix(s.length() + s.name.length);
}

for (let round = 0; round < 4; round++) {
  fill(6, 6);
  two.push(elsewhere(round), oneGiven(round, two[round].left), oneGiven(round, { value: round, name: "made for it" }));
  collect(round);
  look();
  const i = round * 5;
  keep(three[i].b); keep(three[i + 1].b.c); keep(two[i].left); keep(two[i + 1].right); keep(eight[i].wide); keep(one[i].only); keep(segments[i].from); keep(segments[i + 1].to);
  three[i + 2].b.c.name = "stored" + round; three[i + 2].b = { c: { value: -1, name: "new" }, weight: 0 }; three[i + 3].b.c = { value: -2, name: "newer" };
  two[i + 2].left = two[i + 3].right; two[i + 3].right = { value: 0, name: "fresh" };
  eight[i + 2].wide.f = { round }; eight[i + 2].wide.e = "late" + round; eight[i + 2].wide.c = [round, round];
  segments[i + 2].from = segments[i + 3].to; segments[i + 3].to.x = 100 + round;
  collect(round + 1);
  look();
  three.splice(0, 3); two.splice(1, 3); eight.splice(2, 3); one.splice(3, 3); segments.splice(4, 3);
  collect(round);
  look();
}
console.log(check, kept.length, JSON.stringify(kept).length, JSON.stringify(kept.slice(0, 8)));
//// several-outer-layouts-share-the-name.ts
// One place reads, stores, tests or adds `a` on objects of several layouts, each of which is born with an inner literal of its own.
interface Inner { b: number }
interface Other { b: string; c: number }
interface One { a: Inner; one: number }
interface Two { a: Inner; two: string }
interface Three { a?: Inner; three: boolean }
interface Four { a: Other; four: number }
const lines: string[] = [];
const say = (...parts: unknown[]) => lines.push(parts.map(String).join(" "));
function makeOne(i: number): One { return { a: { b: i }, one: i }; }
function makeTwo(i: number): Two { return { a: { b: i * 2 }, two: "t" + i }; }
function makeThree(i: number): Three { return i % 2 ? { a: { b: i * 3 }, three: true } : { three: false }; }
function makeFour(i: number): Four { return { a: { b: "s" + i, c: i }, four: i }; }
function read(x: One | Two): number { return x.a.b; }
function readAny(x: One | Two | Four): number | string { return x.a.b; }
function readMaybe(x: One | Three): number { return x.a ? x.a.b : -1; }
function store(x: One | Two, i: number) { x.a = { b: i }; }
function bump(x: One | Two | Three) { if (x.a) x.a.b += 1; }
function add(x: Three, i: number) { x.a = { b: i }; }
function hold(x: One | Two | Three | Four): Inner | Other | undefined { return x.a; }
function has(x: One | Three): boolean { return "a" in x && x.a !== undefined; }

const all: (One | Two)[] = [];
for (let i = 0; i < 40; i++) all.push(i % 2 ? makeOne(i) : makeTwo(i));
let sum = 0;
for (const x of all) sum += read(x);
say("read", sum);
for (const x of all) bump(x);
for (const x of all) sum += read(x);
say("bumped", sum);
for (let i = 0; i < all.length; i += 3) store(all[i], 1000 + i);
for (const x of all) sum += read(x);
say("stored", sum);
const held = all.map(hold);
say("held", held.every((c, i) => c === all[i].a), held.map(c => (c as Inner).b).join());
for (const x of all) bump(x);
say("bumped behind", held.map(c => (c as Inner).b).join());

const threes: Three[] = [];
for (let i = 0; i < 10; i++) threes.push(makeThree(i));
say("maybe", threes.map(readMaybe).join(), threes.map(has).join(), threes.map(x => Object.keys(x).join("+")).join());
for (const x of threes) bump(x);
for (let i = 0; i < threes.length; i += 2) add(threes[i], 70 + i);
say("added", threes.map(readMaybe).join(), threes.map(has).join(), threes.map(x => Object.keys(x).join("+")).join());
for (let i = 0; i < threes.length; i += 3) delete threes[i].a;
say("deleted", threes.map(readMaybe).join(), threes.map(has).join(), threes.map(x => JSON.stringify(x)).join());
for (let i = 0; i < threes.length; i += 3) add(threes[i], 90 + i);
say("added again", threes.map(readMaybe).join(), threes.map(x => JSON.stringify(x)).join());

const mixed: (One | Two | Four)[] = [makeOne(1), makeTwo(2), makeFour(3), makeFour(4), makeOne(5)];
say("mixed", mixed.map(readAny).join(), mixed.map(hold).map(c => JSON.stringify(c)).join());
say("one", readMaybe(makeOne(7)), has(makeOne(8)), has(makeThree(2)), has(makeThree(3)));
console.log(lines.join("\n"));
//// several-places-make-the-same-pair.ts
// Several functions make objects of one and the same pair of layouts, and each row does something else with the inner object. Some of the functions are called, some taken into their callers.

const N = 20_000;
const alive: unknown[] = [];
function collect() { Bun.gc(true); return 0; }
function report(name: string, sum: number, before: number, kind: string) {
  console.log(name + ":", sum, kind, before + collect());
}

type P1 = { a: { b: number } };
function make1(i: number): P1 { return { a: { b: i } }; }
function use1(x: P1) { return x.a.b; }
////= lines	make1	use1	"read through"

type P2 = { a: { b: number } };
function make2(i: number): P2 { return { a: { b: i } }; }
function use2(x: P2) { const c = x.a; return c.b + c.b; }
////= lines	make2	use2	"held by a local name"

type C3 = { b: number };
type P3 = { a: C3 };
function make3(i: number): P3 { return { a: { b: i } }; }
function read3(c: C3) { return c.b; }
function use3(x: P3) { return read3(x.a); }
////= lines	make3	use3	"passed to a function that reads"

type C4 = { b: number };
type P4 = { a: C4 };
const others: C4[] = [];
function make4(i: number): P4 { return { a: { b: i } }; }
function use4(x: P4) { if ((x.a.b & 65535) === 0) others.push(x.a); return x.a.b; }
////= lines	make4	use4	"kept now and then"

class C5 { b: number; constructor(i: number) { this.b = i; } }
class P5 { a: C5; constructor(i: number) { this.a = new C5(i); } }
function make5(i: number) { return new P5(i); }
function use5(x: P5) { return x.a.b; }
