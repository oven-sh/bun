function makeD(i: number): D { return { b: i, c: { d: i, e: i + 1 } }; }
const d = makeD(4); d.c.d += 1;
let names = ""; for (const k in d) names += k; console.log(names);
interface E { b: number; c: Inner }
function makeE(i: number): E { return { b: i, c: { d: i, e: i + 1 } }; }
const e = makeE(5); e.c.d += 1;
const key: string = ["b", "c"][e.b - 4];
console.log(JSON.stringify((e as any)[key]));
interface F { b: number; c: Inner }
function makeF(i: number): F { return { b: i, c: { d: i, e: i + 1 } }; }
const f = Object.freeze(makeF(6)); f.c.d += 1;
console.log(f.c.d, Object.isFrozen(f), Object.isFrozen(f.c));
interface G { b: number; c: Inner }
function makeG(i: number): G { return { b: i, c: { d: i, e: i + 1 } }; }
const g = makeG(7); g.c.d += 1;
console.log(Object.getOwnPropertyDescriptor(g, "c")!.writable, Object.entries(g).length, structuredClone(g).c.d);
interface H { b: number; c: Inner }
function makeH(i: number): H { return { b: i, c: { d: i, e: i + 1 } }; }
const h = makeH(8); h.c.d += 1;
delete (h as any).c;
console.log(h.c === undefined);
console.log(makeA(9));
//// the-room-holds-the-only-reference.ts
// Nothing but the inner object names what it holds, and the inner object lies in the outer one. The collector has to find it there. What it misses is overwritten: the program makes look-alikes by the hundred thousand behind each collection.
class Leaf { v: number; w: number; constructor(v: number, w: number) { this.v = v; this.w = w; } }
// A field that holds objects of two layouts has no room for either, so the leaves have cells of their own.
class LeafWithName extends Leaf { name = "leaf"; }
interface Inner { r: Leaf; s: string; t: Leaf | null; n: number }
interface Outer { a: Inner; id: number }
const N = 30000;
const kept: Outer[] = [];
const held: Inner[] = [];
const trash: unknown[] = new Array(512);
function make(i: number): Outer { return { a: { r: i % 100 ? new Leaf(i, -i) : new LeafWithName(i, -i), s: "s" + i, t: i & 1 ? (i % 99 ? new Leaf(-i, i) : new LeafWithName(-i, i)) : null, n: i }, id: i }; }
function churn(n: number): number {
  let length = 0;
  for (let i = 0; i < n; i++) {
    trash[i & 511] = i & 1023 ? new Leaf(-1, -1) : new LeafWithName(-1, -1);
    length += ("x" + i).length;
  }
  return length;
}
function isWrong(x: Outer): number {
  let count = 0;
  if (x.a.r.v !== x.id || x.a.r.w !== -x.id || x.a.s !== "s" + x.id || x.a.n !== x.id) count++;
  if (x.id & 1 ? x.a.t === null || x.a.t.v !== -x.id : x.a.t !== null) count++;
  return count;
}
function wrong(): number {
  let count = 0;
  for (let i = 0; i < kept.length; i++) count += isWrong(kept[i]);
  return count;
}
// Somebody holds an inner object, a few times, so the field stays.
function hold(i: number) { held.push(kept[i].a); }

for (let part = 0; part < 3; part++) for (let half = 0; half < 2; half++) for (let i = 0; i < N / 6; i++) kept.push(make(kept.length));
const lines: string[] = [];
for (let round = 0; round < 4; round++) {
  Bun.gc(true);
  const length = churn(150000);
  lines.push(round + " " + wrong() + " " + length);
}
hold(0); hold(7); hold(14); hold(21);
Bun.gc(true);
churn(150000);
console.log(lines.join("\n"));
console.log(wrong(), held.map(inner => inner.r.v + inner.s).join(), held.every((inner, i) => inner === kept[i * 7].a));
//// two-names-of-one-outer-object.ts
// Two parameters name the same outer object. The inner object is read through both, held through one, and then read and stored through the other.
interface Inner { b: number; s: string }
interface Outer { a: Inner; n: number }
interface Box { f: Inner | null; g: Inner | null }
const lines: string[] = [];
function make(i: number): Outer { return { a: { b: i, s: "s" + i }, n: i }; }
function heldThroughTheFirst(x: Outer, y: Outer, box: Box): number { const c2 = y.a; const c1 = x.a; box.f = c2; return c1.b; }
function heldThroughTheSecond(x: Outer, y: Outer, box: Box): number { const c1 = x.a; const c2 = y.a; box.f = c2; return c1.b; }
function storedBehind(x: Outer, y: Outer, box: Box): number { const c2 = y.a; const c1 = x.a; box.f = c2; c1.b = 77; return box.f!.b; }
function comparedBehind(x: Outer, y: Outer, box: Box): boolean { const c2 = y.a; const c1 = x.a; box.f = c2; box.g = c1; return box.f === box.g; }
function inALoop(x: Outer, y: Outer, box: Box): number { let sum = 0; const c1 = x.a; for (let i = 0; i < 3; i++) { sum += c1.b; if (i === 1) box.f = y.a; c1.b += 1; } return sum * 1000 + box.f!.b; }
const kept: Outer[] = [];
for (let part = 0; part < 4; part++) for (let half = 0; half < 4; half++) for (let i = 0; i < 100; i++) kept.push(make(kept.length));
const box: Box = { f: null, g: null };
lines.push("held through the first " + heldThroughTheFirst(kept[5], kept[5], box) + " " + heldThroughTheFirst(kept[6], kept[7], box));
lines.push("held through the second " + heldThroughTheSecond(kept[8], kept[8], box) + " " + heldThroughTheSecond(kept[9], kept[10], box));
lines.push("stored behind " + storedBehind(kept[11], kept[11], box) + " " + kept[11].a.b + " " + storedBehind(kept[12], kept[13], box) + " " + kept[12].a.b);
lines.push("compared behind " + comparedBehind(kept[14], kept[14], box) + " " + comparedBehind(kept[15], kept[16], box));
lines.push("in a loop " + inALoop(kept[17], kept[17], box) + " " + inALoop(kept[18], kept[19], box));
let sum = 0;
for (let i = 0; i < kept.length; i++) sum += kept[i].a.b + kept[i].a.s.length;
lines.push("sum " + sum);
console.log(lines.join("\n"));
//// weak-things-on-the-inner-and-on-the-outer-object.ts
// Weak references, weak maps, weak sets and registries that name the inner object, or the outer one, of a pair.
import { fullGC } from "bun:jsc";

type Inner = { count: number; label: string };
type Outer = { inner: Inner; tag: number };

////= fill	abel: "label" + i
function churn(): number { const some: Outer[] = []; fill(some, 20, 20); return some[7].inner.count; }

const weakInner: WeakRef<Inner>[] = [];
const weakOuter: WeakRef<Outer>[] = [];
const byInner = new WeakMap<Inner, string>();
const byOuter = new WeakMap<Outer, Inner>();
const setOfInner = new WeakSet<Inner>();
let cleanedInner = 0, cleanedOuter = 0;
const registryOfInner = new FinalizationRegistry<number>(() => { cleanedInner++; });
const registryOfOuter = new FinalizationRegistry<number>(() => { cleanedOuter++; });

function watchInner(outer: Outer): void { weakInner.push(new WeakRef(outer.inner)); }
function watchOuter(outer: Outer): void { weakOuter.push(new WeakRef(outer)); }
function mapInner(outer: Outer): void { byInner.set(outer.inner, "mapped" + outer.tag); }
function mapOuter(outer: Outer): void { byOuter.set(outer, outer.inner); }
function addInner(outer: Outer): void { setOfInner.add(outer.inner); }
function registerBoth(outer: Outer): void { registryOfInner.register(outer.inner, outer.tag); registryOfOuter.register(outer, outer.tag); }

const kept: Outer[] = [];
const keptInner: Inner[] = [];
async function round(): Promise<void> {
  const outers: Outer[] = [];
  fill(outers, 10, 10);
  for (let i = 0; i < 10; i++) { watchInner(outers[i]); watchOuter(outers[i]); }
  for (let i = 10; i < 20; i++) { mapInner(outers[i]); mapOuter(outers[i]); addInner(outers[i]); }
  for (let i = 20; i < 30; i++) registerBoth(outers[i]);
  // Of each ten: the outer object of the first three is kept, of the next three only the inner one, the rest nothing.
  for (const start of [0, 10, 20]) {
    for (let i = 0; i < 3; i++) kept.push(outers[start + i]);
    keptInner.push(outers[start + 3].inner, outers[start + 4].inner, outers[start + 5].inner);
  }
}
await round();
for (let i = 0; i < 4; i++) { await new Promise(resolve => setTimeout(resolve, 1)); churn(); fullGC(); }

// While the outer object lives, so does the inner one, and it is the same one.
console.log(weakInner.slice(0, 3).map((ref, i) => ref.deref() === kept[i].inner).join(), weakOuter.slice(0, 3).map((ref, i) => ref.deref() === kept[i]).join());
console.log(weakInner.slice(3, 6).map((ref, i) => ref.deref() === keptInner[i]).join());
console.log(kept.slice(3, 6).map(outer => byInner.get(outer.inner) + " " + (byOuter.get(outer) === outer.inner) + " " + setOfInner.has(outer.inner)).join(" | "));
console.log(keptInner.slice(3, 6).map(inner => byInner.get(inner) + " " + setOfInner.has(inner) + " " + inner.count + inner.label).join(" | "));
console.log(kept.map(outer => outer.inner.count + outer.inner.label).join(), keptInner.map(inner => inner.count + inner.label).join());
console.log("no callback for what is kept:", cleanedInner <= 4, cleanedOuter <= 7);
//// what-an-inner-object-in-its-room-held-is-let-go.ts
// As what-the-inner-object-held-is-let-go.ts, with births that outweigh everything else, so that the inner object lies in a room of the outer one: whoever stores another value to the field or makes the object lets go of what the room held.
class Leaf { v: number; constructor(v: number) { this.v = v; } }
// A field that holds objects of two layouts has no room for either, so the leaves have cells of their own.
class LeafWithName extends Leaf { name = "leaf"; }
interface Inner { leaf: Leaf | null; n: number }
interface Outer { a: Inner | null; id: number }
const shared: Inner = { leaf: new LeafWithName(0), n: -1 };
const N = 16000;
function make(i: number): Outer { return { a: { leaf: new Leaf(i), n: i }, id: i }; }
function makeAll(): Outer[] {
  const kept: Outer[] = [];
  for (let part = 0; part < 4; part++) for (let half = 0; half < 2; half++) for (let i = 0; i < N / 8; i++) kept.push(make(kept.length));
  return kept;
}
function storeAnother(kept: Outer[]) { for (let i = 0; i < kept.length; i++) kept[i].a = shared; }
function storeNull(kept: Outer[]) { for (let i = 0; i < kept.length; i++) kept[i].a = null; }
function storeFresh(kept: Outer[]) { for (let i = 0; i < kept.length; i++) kept[i].a = { leaf: null, n: 0 }; }
function storeOverTheReference(kept: Outer[]) { for (let i = 0; i < kept.length; i++) kept[i].a!.leaf = null; }
function makeThenStoreOver(kept: Outer[]) { for (let i = 0; i < kept.length; i++) { const x = kept[i]; shared.n += Object.keys(x.a!).length - 2; x.a!.leaf = null; } }
function makeThenStoreAnother(kept: Outer[]) { for (let i = 0; i < kept.length; i++) { const x = kept[i]; shared.n += Object.keys(x.a!).length - 2; x.a = null; } }
function leavesOf(kept: Outer[]): WeakRef<Leaf>[] { const leaves: WeakRef<Leaf>[] = []; for (let i = 0; i < kept.length; i++) leaves.push(new WeakRef(kept[i].a!.leaf!)); return leaves; }
function total(kept: Outer[]): number { let sum = 0; for (let i = 0; i < kept.length; i++) { const x = kept[i]; sum += x.id + (x.a ? x.a.n : 0); } return sum; }
const pause = () => new Promise(resolve => setTimeout(resolve, 0));
async function run(name: string, letGo: (kept: Outer[]) => void) {
  const kept = makeAll();
  const leaves = leavesOf(kept);
  await pause();
  Bun.gc(true);
  const aliveBefore = leaves.filter(leaf => leaf.deref() !== undefined).length;
  await pause();
  letGo(kept);
  await pause();
  Bun.gc(true);
  Bun.gc(true);
  const aliveAfter = leaves.filter(leaf => leaf.deref() !== undefined).length;
  console.log(name, aliveBefore === N, aliveAfter < N / 10, total(kept));
}
await run("another object is stored", storeAnother);
await run("null is stored", storeNull);
await run("a fresh object is stored", storeFresh);
await run("the reference is stored over", storeOverTheReference);
await run("made, then the reference is stored over", makeThenStoreOver);
await run("made, then null is stored", makeThenStoreAnother);
//// what-the-inner-object-held-is-let-go.ts
// An inner object that lies in the outer one holds references. Whoever stores another value to the field, or deletes the field, lets go of them, though the outer object lives on.
interface Leaf { v: number }
interface Inner { leaf: Leaf | null; n: number }
interface Outer { a: Inner | null; id: number }
const shared: Inner = { leaf: null, n: -1 };
const N = 20000;
function make(i: number): Outer { return { a: { leaf: { v: i }, n: i }, id: i }; }
async function run(name: string, letGo: (x: Outer) => void) {
  const kept: Outer[] = [];
  const leaves: WeakRef<Leaf>[] = [];
  for (let i = 0; i < N; i++) kept.push(make(i));
  for (const x of kept) leaves.push(new WeakRef(x.a!.leaf!));
  await new Promise(resolve => setTimeout(resolve, 0));
  Bun.gc(true);
  const aliveBefore = leaves.filter(leaf => leaf.deref() !== undefined).length;
  await new Promise(resolve => setTimeout(resolve, 0));
  for (const x of kept) letGo(x);
  await new Promise(resolve => setTimeout(resolve, 0));
  Bun.gc(true);
  Bun.gc(true);
  const aliveAfter = leaves.filter(leaf => leaf.deref() !== undefined).length;
  let sum = 0;
  for (const x of kept) sum += x.id + (x.a ? x.a.n : 0);
  console.log(name, aliveBefore === N, aliveAfter < N / 10, sum);
}
await run("another object is stored", x => { x.a = shared; });
await run("null is stored", x => { x.a = null; });
await run("another object is stored by name", x => { (x as any)["a".slice(0)] = shared; });
await run("the field is deleted", x => { delete (x as any).a; });
await run("a fresh object is stored", x => { x.a = { leaf: null, n: 0 }; });
await run("the reference is stored over", x => { x.a!.leaf = null; });
await run("made, then the reference is stored over", x => { shared.n += Object.keys(x.a!).length - 2; x.a!.leaf = null; });
await run("made, then another object is stored", x => { shared.n += Object.keys(x.a!).length - 2; x.a = shared; });
