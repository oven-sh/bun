type C6 = { b: number };
type P6 = { a: C6; n: number };
function make6(i: number): P6 { return { a: { b: 0 }, n: i }; }
function use6(x: P6) { x.a = { b: x.n }; return x.n; }
function read6(x: P6) { return x.a.b; }
{
