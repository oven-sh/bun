function keep(x: Outer) { kept.push(x.a); }
function replace(x: Outer, i: number) { x.a = { b: i, s: "r" + i, o: null }; }
function total(x: Outer) { return x.a.b + x.a.s.length + (x.a.o ? x.a.o.v : 0); }

