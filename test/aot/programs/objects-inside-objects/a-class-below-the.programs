//// snapshots-and-censuses-over-pairs.ts
// Whatever walks the whole heap walks over pairs: heap snapshots of both kinds, statistics by type, the sizes of single objects.
import { edenGC, fullGC, heapStats, memoryUsage, estimateShallowMemoryUsageOf } from "bun:jsc";
import { writeHeapSnapshot, getHeapSnapshot, getHeapStatistics } from "node:v8";

type Inner = { count: number; label: string; list: number[] };
type Outer = { inner: Inner; tag: number };
function fill(into: Outer[], rows: number, columns: number): void {
  for (let row = 0; row < rows; row++) {
    for (let column = 0; column < columns; column++) {
      const i = row * columns + column;
      into.push({ inner: { count: i, label: "label" + i, list: [i] }, tag: i });
    }
  }
}
const held: Inner[] = [];
function hold(outer: Outer): void { held.push(outer.inner); }

const outers: Outer[] = [];
fill(outers, 40, 40);
for (let i = 0; i < outers.length; i += 100) hold(outers[i]);
fullGC();
const stats = heapStats();
console.log(typeof stats.objectCount, stats.objectCount > 1600, typeof stats.objectTypeCounts);
const snapshot = Bun.generateHeapSnapshot();
console.log(Array.isArray(snapshot.nodes), snapshot.nodes.length > 1000, Array.isArray(snapshot.edges));
const text = Bun.generateHeapSnapshot("v8");
console.log(typeof text, text.length > 10000, JSON.parse(text).snapshot.node_count > 1000);
console.log(typeof getHeapStatistics().used_heap_size, typeof memoryUsage().current);
console.log(estimateShallowMemoryUsageOf(outers[1]) > 0, estimateShallowMemoryUsageOf(outers[0].inner) > 0, estimateShallowMemoryUsageOf(outers[2].inner) > 0);
edenGC();
let sum = 0;
for (const outer of outers) sum += outer.inner.count + outer.inner.label.length + outer.inner.list[0];
for (const inner of held) sum += inner.count;
console.log(sum, Bun.inspect(outers[3]), Bun.inspect(outers[100]));
//// suspended-functions-and-closures-hold-only-the-inner-object.ts
// Arrays of pairs, pairs that hold arrays, closures, suspended functions that hold nothing but the inner object, other threads.
import { edenGC, fullGC } from "bun:jsc";

type Inner = { count: number; label: string; list: number[] };
type Outer = { inner: Inner; tag: number };

////= fill-2	, i + 2]
function churn(): number { const some: Outer[] = []; fill(some, 12, 12); return some[5].inner.list[1]; }
function collect(step: number): void { churn(); if (step % 2) edenGC(); else fullGC(); churn(); }
function show(inner: Inner): string { return `${inner.count} ${inner.label} ${inner.list.join("+")}`; }

function inArrays(x: Outer, y: Outer) { const pairs = [x, y, x]; const inners = pairs.map(each => each.inner); collect(8); return inners.map(show).join(" | ") + " | " + (inners[0] === inners[2]) + (inners[0] === x.inner); }
function sorted(some: Outer[]) { const copy = some.slice(0, 6).sort((a, b) => b.inner.count - a.inner.count); collect(9); return copy.map(each => each.inner.count).join(); }
function destructured(x: Outer) { const { inner: { count, list: [first, ...others] }, tag } = x; collect(10); return `${count} ${first} ${others.join("+")} ${tag}`; }
function closureOverInner(x: Outer | null) { const inner = x!.inner; const read = () => show(inner); x = null; collect(11); return read; }
function closureOverOuter(x: Outer) { return () => show(x.inner); }

function* yields(x: Outer | null): Generator<string, string, void> {
  const inner = x!.inner;
  x = null;
  yield show(inner);
  inner.count += 1;
  yield show(inner);
  return show(inner);
}
async function awaits(x: Outer | null): Promise<string> {
  const inner = x!.inner;
  x = null;
  await null;
  collect(12);
  inner.count += 1;
  await new Promise(resolve => setTimeout(resolve, 1));
  collect(13);
  return show(inner);
}
async function awaitsWithOuter(x: Outer): Promise<string> {
  const before = x.inner.count;
  await null;
  collect(14);
  x.inner.count += 1;
  await null;
  return before + " " + show(x.inner);
}

{
  for (let round = 0; round < 3; round++) {
    const o: Outer[] = [];
    fill(o, 8, 8);
    let next = 0;
    console.log(round, "arrays:", inArrays(o[next++], o[next++]));
    console.log(round, "sorted:", sorted(o));
    console.log(round, "destructured:", destructured(o[next++]));
    const overInner = closureOverInner(o[next]); o[next++] = o[0];
    const overOuter = closureOverOuter(o[next]); o[next++] = o[0];
    const generator = yields(o[next]); o[next++] = o[0];
    const first = generator.next().value;
    const waiting = awaits(o[next]); o[next++] = o[0];
    const waitingWithOuter = awaitsWithOuter(o[next]); o[next++] = o[0];
    collect(round);
    collect(round + 1);
    console.log(round, "closures:", overInner(), "|", overOuter());
    console.log(round, "generator:", first, "|", generator.next().value, "|", generator.next().value);
    console.log(round, "async:", await waiting, "|", await waitingWithOuter);
  }
}
//// the-fields-of-the-inner-object-are-read-and-stored.ts
// Nobody holds `c` as a value, so the fields of the inner object may lie in the outer object. They are read, stored and read through a local name.
interface Inner { d: number; e: string; f: Inner2 | null }
interface Inner2 { g: number }
interface Outer { b: number; c: Inner; next: Outer | null }
function make(n: number): Outer | null {
  let head: Outer | null = null;
  for (let i = 0; i < n; i++) head = { b: i, c: { d: i * 2, e: "s" + i, f: i % 2 ? { g: i } : null }, next: head };
  return head;
}
let text = "";
for (let p = make(5); p; p = p.next) { p.c.d += 0.5; p.c.e += "!"; const x = p.c; x.d *= 2; text += p.b + ":" + p.c.d + ":" + x.e + ":" + (p.c.f ? p.c.f.g : "-") + " "; }
console.log(text);
