//// closures-filled-by-the-constructor.js
// Fields that a constructor fills with closures are read, called, compared, replaced and deleted.
function Button(label) {
  this.label = label;
  this.clicks = 0;
  this.click = () => ++this.clicks;
  this.describe = function () { return this.label + " " + this.clicks; };
  this.reset = () => { this.clicks = 0; };
}
class Switch {
  constructor(label) {
    this.label = label;
    this.clicks = 0;
    this.click = () => ++this.clicks;
    this.describe = function () { return this.label + " " + this.clicks; };
    this.reset = () => { this.clicks = 0; };
  }
}
function use(button) {
  button.click();
  button.click();
  return button.describe() + " " + typeof button.reset + " " + (button.click === button.click) + " " + Object.keys(button).join();
}
for (const Maker of [Button, Switch]) {
  const made = [];
  for (let i = 0; i < 40; i++) made.push(new Maker("b" + i));
  console.log(use(made[0]), made[0].click === made[1].click);
  delete made[1].reset;
  made[2].click = function () { return (this.clicks += 10); };
  made[3].describe = null;
  made[4].click = made[5].click;
  Object.defineProperty(made[6], "describe", { get() { return () => "from a getter"; } });
  const kept = made[7].click;
  delete made[7].click;
  Maker.prototype.click = function () { return (this.clicks -= 1); };
  for (let i = 1; i < 9; i++) {
    try {
      console.log(i, use(made[i]));
    } catch (error) {
      console.log(i, error.constructor.name);
    }
  }
  console.log(kept(), made[7].clicks, made[5].clicks);
  delete Maker.prototype.click;
}
//// constructor-functions-entered-by-new-of-a-callee-that-nobody-knows.js
// `new holder.Reply(..)`, where nobody knows what the holder holds: the run time makes the object and hands it to the function as `this`. The function stores every field,
// and whoever reads the object afterwards tests it once. The same function is also called on objects that are finished, changed, frozen, or not its own.
const out = [];
const suffix = process.argv[2] ?? "";
const hide = new Function("value", "return value" + suffix);
const callUnseen = new Function("callee", "receiver", "a", "b", "return callee.call(receiver, a, b)" + suffix);
function show(name, value) {
  out.push(name + ": " + JSON.stringify(value, (_, v) => (v === undefined ? "undefined" : typeof v === "function" ? "function" : typeof v === "number" && !Number.isFinite(v) ? String(v) : v)));
}

function Reply(raw, log) {
  this.raw = raw;
  this.sent = false;
  this.count = 0;
  this.headers = null;
  this.log = log;
}
Reply.prototype.read = function () {
  return [this.raw, this.sent, this.count, typeof this.count, this.headers, this.log, Object.keys(this).join()];
};
Reply.prototype.change = function () {
  this.count++;
  this.sent = !this.sent;
  return this.count;
};
function read(reply) {
  return [reply.raw, reply.sent, reply.count, typeof reply.count, reply.headers, reply.log, Object.keys(reply).join()];
}

let between = () => {};
function Stepwise(first, second) {
  this.first = first;
  between(this);
  this.second = second;
  this.third = first + second;
}
function readStepwise(object) {
  return [object.first, object.second, object.third, Object.keys(object).join()];
}

function Partly(fill) {
  this.always = 1;
  if (fill) {
    this.sometimes = 2;
    this.number = 3;
  }
}
function readPartly(object) {
  return [object.always, object.sometimes, object.number, typeof object.number, Object.keys(object).join()];
}

function Child(raw, log, extra) {
  Reply.call(this, raw, log);
  this.extra = extra;
}
Object.setPrototypeOf(Child.prototype, Reply.prototype);

const holder = hide({ Reply, Stepwise, Partly, Child });
function attempt(action) {
  try {
    return action();
  } catch (error) {
    return "threw " + error.constructor.name;
  }
}

for (let i = 0; i < 40; i++) read(new holder.Reply(i, "log" + i));
const made = new holder.Reply(1, "a");
show("made by new of a callee that nobody knows", read(made));
show("through its own method", made.read());
show("changed", [made.change(), made.change(), read(made)]);
show("its prototype and constructor", [Object.getPrototypeOf(made) === Reply.prototype, made instanceof Reply, made.constructor === Reply]);
show("made by new of the function itself", read(new Reply(2, "b")));
show("undefined and null as arguments", read(new holder.Reply(undefined, null)));
show("no arguments", read(new holder.Reply()));

const again = new holder.Reply(3, "c");
again.change();
Reply.call(again, 4, "d");
show("called again on a finished object", read(again));
callUnseen(Reply, again, 5, "e");
show("called again by code that nobody sees", read(again));

const withoutField = new holder.Reply(6, "f");
delete withoutField.count;
show("a field deleted", read(withoutField));
Reply.call(withoutField, 7, "g");
show("and the function called on it", read(withoutField));
show("and changed", [withoutField.change(), read(withoutField)]);

const seen = [];
const withAccessor = new holder.Reply(8, "h");
Object.defineProperty(withAccessor, "sent", { get() { return "from the getter"; }, set(v) { seen.push(v); }, enumerable: true, configurable: true });
Reply.call(withAccessor, 9, "i");
show("an accessor in place of a field", [read(withAccessor), seen]);

const readOnly = new holder.Reply(10, "j");
Object.defineProperty(readOnly, "raw", { value: "fixed", writable: false });
show("a field that cannot be written", [attempt(() => Reply.call(readOnly, 11, "k")), read(readOnly)]);

const frozen = Object.freeze(new holder.Reply(12, "l"));
show("a frozen object", [attempt(() => Reply.call(frozen, 13, "m")), read(frozen)]);
const sealed = Object.seal(new holder.Reply(14, "n"));
show("a sealed object", [attempt(() => Reply.call(sealed, 15, "o")), read(sealed)]);

const foreign = hide({ log: "own", other: 1 });
Reply.call(foreign, 16, "p");
show("an object that is not its own", read(foreign));
const bare = Object.create(null);
callUnseen(Reply, bare, 17, "q");
show("an object without a prototype", read(bare));
const ofOtherFunction = new holder.Partly(true);
Reply.call(ofOtherFunction, 18, "r");
show("the object of another function", [read(ofOtherFunction), readPartly(ofOtherFunction)]);

function Other() {}
const forOther = Reflect.construct(holder.Reply, [19, "s"], Other);
show("for another new.target", [read(forOther), forOther instanceof Other, forOther instanceof Reply]);
const bound = hide(Reply.bind(null, 20));
show("through a bound function", read(new bound("t")));

show("nothing happens between the stores", readStepwise(new holder.Stepwise(1, 2)));
between = object => { delete object.first; };
show("the first field is deleted between the stores", readStepwise(new holder.Stepwise(1, 2)));
between = object => { object.third = "early"; object.added = true; };
show("a later field and another name are stored between the stores", readStepwise(new holder.Stepwise(1, 2)));
between = object => { Object.defineProperty(object, "second", { get: () => "getter", set() {}, enumerable: true, configurable: true }); };
show("a later field becomes an accessor between the stores", readStepwise(new holder.Stepwise(1, 2)));
let kept;
between = object => { kept = readStepwise(hide(object)); };
show("the object is read between the stores", [readStepwise(new holder.Stepwise(1, 2)), kept]);
between = object => { Object.freeze(object); };
show("the object is frozen between the stores", attempt(() => readStepwise(new holder.Stepwise(1, 2))));
show("called on a number, on undefined", [attempt(() => Reply.call(5, 1, "x")), attempt(() => Reply.call(undefined, 1, "x")), attempt(() => callUnseen(Reply, null, 1, "x"))]);
between = () => { throw new Error("thrown between the stores"); };
try {
  new holder.Stepwise(1, 2);
} catch (error) {
  show("the function throws between the stores", error.message);
}
between = () => {};
show("nothing happens between the stores, again", readStepwise(new holder.Stepwise(3, 4)));

show("every field stored", readPartly(new holder.Partly(true)));
show("two fields left out", readPartly(new holder.Partly(false)));
for (let i = 0; i < 20; i++) readPartly(new holder.Partly(i % 2 === 0));
show("every field stored, later", readPartly(new holder.Partly(true)));
show("two fields left out, later", readPartly(new holder.Partly(false)));

const child = new holder.Child(21, "u", "extra");
show("a function that calls the first on its own object", [read(child), child.extra, child.read(), child instanceof Reply]);
console.log(out.join("\n"));
//// copy-loops-between-the-kinds-of-a-family.ts
// A family of nodes made by one constructor function, told apart by `kind`, whose later members differ by kind: one name may hold a number in one kind and a node or a string in another.
// `clone[key] = node[key]` under one key moves each member to the member of the same name. Between two nodes of one kind every value fits. Between two kinds it may not, and the typed readers must see what was stored.
declare const console: { log(...values: unknown[]): void };
const lines: string[] = [];
function say(label: string, value: unknown) { lines.push(label + ": " + JSON.stringify(value, (_, v) => v === undefined ? "#undefined" : typeof v === "function" ? "#function" : v)); }

const enum Kind { Name = 1, Unary = 2, Binary = 3, Text = 4 }
interface Node { kind: Kind; pos: number; end: number; flags: number; parent: Node | undefined }
interface Name extends Node { kind: Kind.Name; text: string; operator?: undefined }
interface Unary extends Node { kind: Kind.Unary; operator: number; operand: Node }
interface Binary extends Node { kind: Kind.Binary; left: Node; operator: Node; right: Node }
interface Text extends Node { kind: Kind.Text; text: number; isLong: boolean }
const NodeObject = function (this: Node, kind: Kind, pos: number, end: number) { this.kind = kind; this.pos = pos; this.end = end; this.flags = 0; this.parent = undefined; } as unknown as new (kind: Kind, pos: number, end: number) => Node;
function base<T extends Node>(kind: T["kind"], pos = 0, end = 0): T { return new NodeObject(kind, pos, end) as T; }
function name(text: string): Name { const node = base<Name>(Kind.Name, 1, 2); node.text = text; return node; }
function unary(operator: number, operand: Node): Unary { const node = base<Unary>(Kind.Unary, 3, 4); node.operator = operator; node.operand = operand; operand.parent = node; return node; }
function binary(left: Node, operator: Node, right: Node): Binary { const node = base<Binary>(Kind.Binary, 5, 6); node.left = left; node.operator = operator; node.right = right; return node; }
function text(value: number, isLong: boolean): Text { const node = base<Text>(Kind.Text, 7, 8); node.text = value; node.isLong = isLong; return node; }

function has(object: object, key: string): boolean { return Object.prototype.hasOwnProperty.call(object, key); }
function cloneNode<T extends Node>(node: T): T {
  const clone = base<T>(node.kind);
  clone.flags |= node.flags;
  for (const key in node) { if (has(clone, key) || !has(node, key)) continue; clone[key] = node[key]; }
  return clone;
}
function copyAll<T extends Node>(target: T, source: T): T { for (const key in source) target[key] = source[key]; return target; }
function copyLoose(target: Node, source: Node): Node { for (const p in source) (target as any)[p] = (source as any)[p]; return target; }
function copyOtherKey(target: Node, source: Node, rename: (key: string) => string): Node { for (const p in source) (target as any)[rename(p)] = (source as any)[p]; return target; }

function textLength(node: Name): number { return node.text.length; }
function textTwice(node: Text): number { return node.text * 2; }
function operatorOf(node: Unary): number { return node.operator + 1; }
function operatorKind(node: Binary): number { return node.operator.kind; }
function span(node: Node): number { return node.end - node.pos + node.flags; }
function parentKind(node: Node): number { return node.parent ? node.parent.kind : 0; }
function weigh(node: Node): number {
  switch (node.kind) {
    case Kind.Name: return textLength(node as Name) + span(node);
    case Kind.Unary: return operatorOf(node as Unary) + weigh((node as Unary).operand);
    case Kind.Binary: return operatorKind(node as Binary) + weigh((node as Binary).left) + weigh((node as Binary).right);
    case Kind.Text: return textTwice(node as Text) + ((node as Text).isLong ? 1 : 0);
  }
}
function show(node: Node) { let weight: unknown; try { weight = weigh(node); } catch (error) { weight = (error as Error).constructor.name; } return [node.kind, weight, span(node), parentKind(node), Object.keys(node).join()]; }

const trees: Node[] = [];
for (let i = 0; i < 200; i++) trees.push(binary(unary(i, name("n" + i)), name("+"), text(i, i % 2 === 0)));
function tally() { let t = 0; for (const tree of trees) t += weigh(tree) + weigh(cloneNode(tree)) + span(cloneNode((tree as Binary).left)); return t; }
for (let round = 0; round < 40; round++) tally();
say("tally", tally());

say("a clone of each kind", [name("abc"), unary(4, name("x")), binary(name("l"), name("-"), name("r")), text(9, true)].map(node => [show(node), show(cloneNode(node)), cloneNode(node) !== node]));
{ const n = name("flagged"); n.flags = 6; n.parent = trees[0]; const c = cloneNode(n); say("what the constructor stored is kept", [show(c), c.flags, c.pos, c.parent === undefined]); }
{ const n = name("more") as Name & { extra?: number[] }; n.extra = [1, 2]; const c = cloneNode(n); say("a name more goes along", [show(c), c.extra === n.extra]); }
// One kind into another: the names agree, the types do not.
{ const target = unary(1, name("u")); copyAll<Node>(target, binary(name("l"), name("*"), name("r"))); say("a Binary into a Unary", [target.kind, typeof (target as any).operator, Object.keys(target).join()]); let seen: unknown; try { seen = operatorOf(target); } catch (error) { seen = (error as Error).constructor.name; } say("its operator, read as a number", seen); }
{ const target = name("t"); copyLoose(target, text(5, true)); say("a Text into a Name", [target.kind, typeof (target as any).text, Object.keys(target).join()]); let seen: unknown; try { seen = textLength(target); } catch (error) { seen = (error as Error).constructor.name; } say("its text, read as a string", seen); }
{ const target = text(1, false); copyLoose(target, name("word")); let seen: unknown = textTwice(target); say("a Name into a Text", [target.kind, seen !== seen ? "#NaN" : seen, (target as any).isLong]); }
{ const target = binary(name("a"), name("b"), name("c")); copyLoose(target, unary(8, name("z"))); let seen: unknown; try { seen = operatorKind(target); } catch (error) { seen = (error as Error).constructor.name; } say("a Unary into a Binary", [target.kind, seen, Object.keys(target).join()]); }
// Two keys: no relation at all.
{ const target = name("k"); copyOtherKey(target, text(3, true), key => key === "text" ? "pos" : key === "isLong" ? "flags" : key === "pos" ? "text" : key); say("under another key", [typeof (target as any).text, target.pos, (target as any).flags, span(target)]); }
// What a for-in also finds, and what it does not.
{ const proto = { inherited: 1 }; const source = Object.setPrototypeOf(name("p"), proto) as Name; const c = copyLoose(name("q"), source); say("a name from above the source", [Object.keys(c).join(), (c as any).inherited]); }
{ const source = name("g"); Object.defineProperty(source, "text", { get() { return "got"; }, enumerable: true, configurable: true }); const c = cloneNode(source); say("a getter in the source", [show(c), Object.getOwnPropertyDescriptor(c, "text")]); }
