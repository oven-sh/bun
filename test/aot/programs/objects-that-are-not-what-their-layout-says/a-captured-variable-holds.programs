//// filled-by-the-constructor-then-assigned-into-in-sloppy-code.cjs
// Object.assign stores into an object that a constructor filled, and a getter of the source disturbs the target half way. In sloppy code, where a refused store is silent.
////= Node-2
////= for-3
//// filled-by-the-constructor-then-copied.js
// Copies of a disturbed object have what it has, and a copy does not disturb its source.
////= Node-2
for (const Maker of [Node, Token]) {
  const made = make(Maker, 40);
  console.log(Maker.name, readAll(made));
  delete made[1].pos;
  made[2].flags = 1.5;
  Object.defineProperty(made[3], "end", { get() { return "got"; }, enumerable: true, configurable: true });
  for (let i = 0; i < 5; i++) {
    show("clone " + i, structuredClone(made[i]));
    show("spread " + i, { ...made[i] });
    show("assign " + i, Object.assign(new Maker(-1, -2, -3), made[i]));
    show("json " + i, JSON.parse(JSON.stringify(made[i])));
    show("below " + i, Object.create(made[i]));
    show("source " + i, made[i]);
  }
  console.log(Maker.name, readAll(made));
}
//// filled-by-the-constructor-then-deleted.js
// A delete empties a slot that the constructor filled.
////= Node-2
for (const Maker of [Node, Token]) {
  const made = make(Maker, 40);
  console.log(Maker.name, readAll(made));
  delete made[1].pos;
  delete made[2]["fl" + "ags"];
  Reflect.deleteProperty(made[3], "parent");
  delete made[4].kind;
  delete made[4].name;
  for (let i = 0; i < 6; i++) show(i, made[i]);
  console.log(Maker.name, readAll(made));
}
//// filled-by-the-constructor-then-deleted-and-added-again.js
// A field that was deleted and stored again is the last of the keys, and the object was disturbed for good.
////= Node-2
for (const Maker of [Node, Token]) {
  const made = make(Maker, 40);
  console.log(Maker.name, readAll(made));
  delete made[1].pos;
  made[1].pos = 7;
  delete made[2].flags;
  made[2].flags = 1.5;
  delete made[3].parent;
  made[3].parent = made[4];
  made[3].parent.name = "above";
  delete made[5].kind;
  delete made[5].end;
  made[5].end = 1;
  made[5].kind = 2;
  for (let i = 0; i < 7; i++) show(i, made[i]);
  console.log(JSON.stringify(made[5]), Object.entries(made[1]).join(";"));
  console.log(Maker.name, readAll(made));
}
//// filled-by-the-constructor-then-deleted-under-an-inherited-value.js
// Behind a delete the read finds what the prototype chain has under the name.
////= Node-2
for (const Maker of [Node, Token]) {
  const made = make(Maker, 40);
  console.log(Maker.name, readAll(made));
  Maker.prototype.pos = "inherited pos";
  Object.defineProperty(Maker.prototype, "flags", { get() { return 64 + this.kind; }, configurable: true });
  const middle = { parent: "parent from the middle" };
  Object.setPrototypeOf(Maker.prototype, middle);
  delete made[1].pos;
  delete made[2].flags;
  delete made[3].parent;
  for (let i = 0; i < 5; i++) show(i, made[i]);
  delete Maker.prototype.pos;
  delete Maker.prototype.flags;
  delete middle.parent;
  for (let i = 0; i < 5; i++) show(i, made[i]);
  console.log(Maker.name, readAll(made));
}
