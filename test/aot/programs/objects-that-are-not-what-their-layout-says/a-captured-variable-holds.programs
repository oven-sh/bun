////: Closed
function Closed(kind, pos) {
  this.kind = kind;
  Object.preventExtensions(this);
  this.pos = pos;
  this.flags = 0;
}
////: Frozen
function Frozen(kind, pos) {
  this.kind = kind;
  this.pos = pos;
  Object.freeze(this);
  this.pos = pos + 1;
  this.flags = 0;
}
////: Shown
function Shown(kind, pos) {
  halfMade.push(this);
  this.kind = kind;
  Object.preventExtensions(this);
  this.pos = pos;
  this.flags = 0;
}
