  made[1].pos = 1.5;
  made[2].flags = "many";
  made[3].kind = { valueOf() { return 3; }, toString() { return "three"; } };
  made[4].end = 2 ** 31;
  made[5].pos = -0;
  made[6].flags = NaN;
  made[7].parent = 12;
  made[8].name = 13;
  made[9].kind = 10n ** 3n > 5n;
  made[10].end = Symbol.iterator.description;
  made[11].pos = -(2 ** 31);
  made[12].pos = -(2 ** 31) + 1;
  made[13].pos = -(2 ** 31) + 4;
