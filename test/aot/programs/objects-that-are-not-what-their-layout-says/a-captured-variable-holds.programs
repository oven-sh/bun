console.log(Array.prototype.pop.call(made[1]), describe(made[1]));
console.log(Array.prototype.shift.call(made[2]), describe(made[2]));
console.log(Array.prototype.splice.call(made[4], 0, 1, "x", "y").length, describe(made[4]));
made[5].length = 2 ** 32;
console.log(describe(made[5]));
made[6].length = "2";
console.log(Array.prototype.push.call(made[6], "c"), describe(made[6]));
delete made[7].length;
console.log(Array.prototype.push.call(made[7], "d"), describe(made[7]));
console.log(Array.from(made[1]).join(), Array.prototype.join.call(made[4]));
//// instance-of-a-class-below.js
// An instance of a class below the class: the class below overrides the method and the getter, and its prototype object has the names that the instance leaves out. A function reads a field that most objects get late, and then relies on what lies above the object or beside the slot.
class A { constructor() { this.x = 1; } m() { return "A.m"; } get g() { return "A.g"; } }
class Below extends A { m() { return "Below.m"; } get g() { return "Below.g"; } }
Below.prototype.missing = "Below.missing";
Below.prototype.extra = "Below.extra";
Below.prototype.second = "Below.second";
////= readers
const states = ["filled", "empty", "holds undefined", "deleted"];
////= fill
function tell(reader, o) { try { return reader(o); } catch (error) { return error.constructor.name; } }
for (const [title, reader] of readers)
  for (const state of states)
    console.log(title + ", " + state + ": " + tell(reader, fill(new A(), state)) + " | " + tell(reader, fill(new Below(), state)));
//// instance-of-a-class-below-typed.ts
// An instance of a class below the class: the class below overrides the method and the getter, and its prototype object has the names that the instance leaves out. A function reads a field that most objects get late, and then relies on what lies above the object or beside the slot.
class A { x = 1; extra?: unknown; second?: unknown; third?: unknown; m(): string { return "A.m"; } get g(): string { return "A.g"; } }
class Below extends A { m() { return "Below.m"; } get g() { return "Below.g"; } }
(Below.prototype as any).missing = "Below.missing";
(Below.prototype as any).extra = "Below.extra";
(Below.prototype as any).second = "Below.second";
////= readers-2
const states = ["filled", "empty", "holds undefined", "deleted"];
////= fill-2
function tell(reader: (o: A) => string, o: A) { try { return reader(o); } catch (error) { return (error as Error).constructor.name; } }
for (const [title, reader] of readers)
  for (const state of states)
    console.log(title + ", " + state + ": " + tell(reader, fill(new A(), state)) + " | " + tell(reader, fill(new Below(), state)));
//// instances-born-for-another-new-target-in-every-order-of-two-births.js
// The constructor of a class makes an object for somebody else: a new target out of Reflect.construct, a class out of run-time text, a bound function, a Proxy. The constructor keeps `this`, and typed-looking code calls its members later. The order of the births is walked through.
const lines = [];
const say = text => { lines.push(text); };
const kept = [];
class Base {
  constructor(x) {
    this.x = x;
    this.y = 2;
    kept.push(this);
    this.seenAtBirth = this.name();
  }
  name() { return "base"; }
  get twice() { return this.x * 2; }
  sum() { return this.x + this.y; }
}
class Below extends Base {
  constructor(x) {
    super(x);
    this.z = 3;
  }
  name() { return "below"; }
  sum() { return super.sum() + this.z; }
}
function lookAll(label) {
  let text = "";
  for (let i = 0; i < kept.length; i++) {
    const o = kept[i];
    let one;
    try {
      one = o.name() + "," + o.twice + "," + o.sum() + "," + o.seenAtBirth + "," + (o instanceof Base) + "," + ("extra" in o) + "," + o.extra;
    } catch (error) {
      one = "threw " + error.name;
    }
    text += one + " | ";
  }
  say(label + ": " + text);
}
function Other() {}
Other.prototype.name = function () { return "other"; };
Other.prototype.sum = function () { return "other sum"; };
Other.prototype.extra = "extra of other";
Object.defineProperty(Other.prototype, "x", { get() { return "x above"; }, set(v) { say("setter above got " + v); }, configurable: true });
const births = [
  () => new Base(1),
  () => new Below(1),
  () => Reflect.construct(Base, [1], Other),
  () => Reflect.construct(Below, [1], Other),
  () => Reflect.construct(Base, [1], Below),
  () => new ((0, eval)("(B => class Text extends B { name() { return 'text'; } get twice() { return 'twice of text'; } })"))(Base)(1),
  () => new (Base.bind(null, 1))(),
  () => new (new Proxy(Below, { get(target, key, receiver) { return key === "prototype" ? Other.prototype : Reflect.get(target, key, receiver); } }))(1),
  () => Reflect.construct(Base, [1], Object.assign(function () {}, { prototype: null })),
  () => Reflect.construct(Base, [1], Array),
  () => Reflect.construct(Base, [1], new Proxy(function () {}, { get(target, key) { return key === "prototype" ? new Proxy({}, { get(t, k) { return typeof k === "string" && k !== "then" ? () => "trapped " + k : undefined; }, has() { return true; } }) : target[key]; } })),
];
for (let a = 0; a < births.length; a++) {
  for (let b = 0; b < births.length; b++) {
    kept.length = 0;
    for (const index of [a, b, a]) {
      try {
        births[index]();
      } catch (error) {
        say(index + " threw " + error.name);
      }
    }
    lookAll(a + "," + b);
  }
}
console.log(lines.join("\n"));
//// makers-of-objects-by-a-tag-that-hand-their-object-out-too-early.ts
// One constructor function makes the nodes of every kind, and the interface that writes the kind says which further names a node gets. Nothing here leaves for code that the compiler does not see,
// so whatever a maker fills before its object leaves its hands counts as filled for good. Each maker below lets somebody look earlier than that, or is entered in another way than by `new`.
const out: string[] = [];
const enum Kind { Name = 1, Sum = 2, Other = 3 }
interface Node { kind: Kind; pos: number; end: number }
interface Name extends Node { kind: Kind.Name; text: string }
interface Sum extends Node { kind: Kind.Sum; left: Node }
function look(node: Node): string { return String(node.kind) + " " + String(node.pos) + " " + String(node.end) + " [" + Object.keys(node).join() + "]"; }
type Maker = new (kind: Kind, pos: number, end: number) => Node;

function WholeObject(this: Node, kind: Kind, pos: number, end: number) { this.kind = kind; this.pos = pos; this.end = end; }
const Whole = WholeObject as unknown as Maker;
for (const kind of [Kind.Name, Kind.Sum, Kind.Other]) out.push("whole: " + look(new Whole(kind, 1, 2)));

function LooksObject(this: Node, kind: Kind, pos: number, end: number) { this.kind = kind; out.push("a helper looks: " + look(this)); this.pos = pos; this.end = end; }
const Looks = LooksObject as unknown as Maker;
for (const kind of [Kind.Name, Kind.Sum, Kind.Other]) out.push("then: " + look(new Looks(kind, 3, 4)));

let kept: Node[] = [];
function KeepsObject(this: Node, kind: Kind, pos: number, end: number) { this.kind = kind; kept.push(this); if (kept.length > 1) out.push("the one before, and this one: " + kept.map(look).join(" | ")); this.pos = pos; this.end = end; }
const Keeps = KeepsObject as unknown as Maker;
for (const kind of [Kind.Name, Kind.Sum, Kind.Other]) new Keeps(kind, 5, 6);
out.push("kept: " + kept.map(look).join(" | "));

function LeavesObject(this: Node, kind: Kind, pos: number, end: number) { this.kind = kind; if (pos < 0) return; this.pos = pos; if (end < 0) throw new RangeError("end"); this.end = end; }
const Leaves = LeavesObject as unknown as Maker;
out.push("returns early: " + look(new Leaves(Kind.Name, -1, 0)) + " | " + look(new Leaves(Kind.Sum, 7, 8)));
let thrown: Node | undefined;
function ThrowsObject(this: Node, kind: Kind, pos: number, end: number) { this.kind = kind; thrown = this; this.pos = pos; if (end < 0) throw new RangeError("end"); this.end = end; }
const Throws = ThrowsObject as unknown as Maker;
try { new Throws(Kind.Sum, 9, -1); } catch (error) { out.push("throws: " + (error as Error).name + " " + look(thrown!)); }

const bare: Node = Object.create(null);
(WholeObject as unknown as (this: Node, kind: Kind, pos: number, end: number) => void).call(bare, Kind.Name, 10, 11);
out.push("called on another object: " + look(bare) + " " + String(Object.getPrototypeOf(bare)));
class Below { }
const under = Reflect.construct(WholeObject, [Kind.Sum, 12, 13], Below) as Node;
out.push("constructed for another class: " + look(under) + " " + String(under instanceof Below) + " " + String(under instanceof (WholeObject as unknown as Function)));

function ReturnsObject(this: Node, kind: Kind, pos: number, end: number) { this.kind = kind; this.pos = pos; this.end = end; if (kind === Kind.Other) return { kind, pos: -pos, end: -end }; }
const Returns = ReturnsObject as unknown as Maker;
for (const kind of [Kind.Name, Kind.Other]) out.push("returns another object: " + look(new Returns(kind, 14, 15)));

const name = new Whole(Kind.Name, 16, 17) as Name;
name.text = "n";
const sum = new Whole(Kind.Sum, 18, 19) as Sum;
sum.left = name;
out.push("later names: " + look(name) + " " + name.text + " | " + look(sum) + " " + look(sum.left));
delete (name as Partial<Node>).pos;
out.push("a name is deleted: " + look(name));

console.log(out.join("\n"));
//// numbers-that-satisfy-the-type-of-a-field-and-not-the-room-it-was-given.ts
// Every store here is well typed: a `number` goes into a field declared `number`, and nothing is cast. All the program has ever shown of the fields is small integers,
// so a compiler may have given them four bytes. The numbers below are no small integers: the lowest int32, what lies past int32, fractions, NaN, -0, the infinities.
// Nothing may be refused, rounded or lost, and whoever says that such a field never changes its form has to say it of all numbers.
const lines: string[] = [];
function say(label: string, value: unknown) { lines.push(label + ": " + JSON.stringify(value, (_key, held) => typeof held === "number" && !Number.isFinite(held) ? "#" + held : Object.is(held, -0) ? "#-0" : held)); }

interface Kind { flags: number; id: number; next: Kind | undefined; }
const Kind = function (this: Kind, flags: number, id: number) { this.flags = flags; this.id = id; this.next = undefined; } as unknown as new (flags: number, id: number) => Kind;
class Mark { flags: number; id: number; constructor(flags: number, id: number) { this.flags = flags; this.id = id; } }

function flagsOf(kind: Kind) { return kind.flags; }
function idOf(kind: Kind) { return kind.id; }
function has(kind: Kind, bit: number) { return (kind.flags & bit) !== 0; }
function add(kind: Kind, bits: number) { kind.flags |= bits; }
function setFlags(kind: Kind, flags: number) { kind.flags = flags; }
function setId(kind: Kind, id: number) { kind.id = id; }
function show(kind: Kind) { return [flagsOf(kind), idOf(kind), has(kind, 1), kind.flags + kind.id, typeof kind.flags, Object.keys(kind).join()]; }
function flagsOfMark(mark: Mark) { return mark.flags; }
function setMark(mark: Mark, flags: number) { mark.flags = flags; }
function showMark(mark: Mark) { return [flagsOfMark(mark), mark.id, mark.flags * 2, Object.keys(mark).join()]; }

const warm: Kind[] = [], marks: Mark[] = [];
for (let i = 0; i < 300; i++) { warm.push(new Kind(i & 15, i)); marks.push(new Mark(i & 7, i)); }
let tally = 0;
for (let round = 0; round < 40; round++) for (let i = 0; i < 300; i++) { add(warm[i], round & 3); setId(warm[i], i + round); setMark(marks[i], round & 7); tally += flagsOf(warm[i]) + idOf(warm[i]) + flagsOfMark(marks[i]) + (has(warm[i], 2) ? 1 : 0); }
say("warm", tally);
let serial = 1000;
function fresh() { return new Kind(7, serial++); }

{ const a = fresh(); add(a, 1 << 31); say("bit 31 is added", show(a)); }
{ const a = fresh(); setFlags(a, 1 << 31); say("bit 31 alone", show(a)); }
{ for (let low = -2147483648; low <= -2147483640; low++) { const a = fresh(); setFlags(a, low); setId(a, low); say("the lowest int32 " + low, show(a)); } }
{ const a = fresh(); setFlags(a, 2147483647); setId(a, 2147483647); say("the highest int32", show(a)); setId(a, idOf(a) + 1); say("and one more", show(a)); }
{ const a = fresh(); setFlags(a, 2 ** 31); say("two to the 31st", show(a)); setFlags(a, 2 ** 32 + 1); say("past uint32", show(a)); setFlags(a, 2 ** 53); say("two to the 53rd", show(a)); }
{ const a = fresh(); setFlags(a, -(2 ** 31) - 1); say("below int32", show(a)); }
{ const a = fresh(); setFlags(a, 0.5); setId(a, -1.25); say("fractions", show(a)); }
{ const a = fresh(); setFlags(a, 0 / 0); say("NaN", show(a)); setFlags(a, 1 / 0); say("Infinity", show(a)); setFlags(a, -1 / 0); say("-Infinity", show(a)); }
{ const a = fresh(); setFlags(a, -0); say("-0", [Object.is(flagsOf(a), -0), 1 / flagsOf(a), show(a)]); }
{ const a = fresh(); setFlags(a, 1e308 * 10); setId(a, 5e-324); say("the ends of the doubles", show(a)); }
{ const a = fresh(); setFlags(a, 0.5); setFlags(a, 3); say("a fraction and an integer again", show(a)); add(a, 4); say("and a bit", show(a)); }
{ say("bit 31 into the constructor", show(new Kind(1 << 31, -2147483647))); }
{ say("a fraction into the constructor", show(new Kind(0.5, 2 ** 40))); }
{ say("NaN and -0 into the constructor", show(new Kind(0 / 0, -0))); }
{ const many: Kind[] = []; for (let i = 0; i < 400; i++) many.push(new Kind(i === 399 ? 1 << 31 : i, i === 398 ? 1.5 : i)); say("into a constructor that runs hot", [show(many[397]), show(many[398]), show(many[399])]); }
{ const m = new Mark(1, 2); setMark(m, 1 << 31); say("a class, bit 31", showMark(m)); setMark(m, 0.25); say("a class, a fraction", showMark(m)); setMark(m, 0 / 0); say("a class, NaN", showMark(m)); }
{ say("a class, into the constructor", [showMark(new Mark(1 << 31, 0.5)), showMark(new Mark(-2147483646, 2 ** 31))]); }
{ const a = fresh(); a.id++; a.flags <<= 28; say("shifted to the top", show(a)); a.flags <<= 3; say("and into bit 31", show(a)); a.flags >>>= 0; say("and read as unsigned", show(a)); }
{ const a = fresh(); a.flags **= 40; say("raised", show(a)); a.flags /= 3; say("divided", show(a)); a.flags %= 1; say("the remainder", show(a)); }
{ const a = fresh(); for (let i = 0; i < 40; i++) setId(a, idOf(a) * 2); say("doubled forty times", show(a)); }
{ const a = fresh(), b = fresh(); setFlags(b, 1 << 31); setId(b, 0.5); Object.assign(a, b); say("assigned from its own kind", show(a)); const c = { ...b }; say("spread", [c.flags, c.id]); }

let after = 0;
for (let i = 0; i < 300; i++) after += flagsOf(warm[i]) + idOf(warm[i]) + flagsOfMark(marks[i]);
say("the others are as they were", after);
console.log(lines.join("\n"));
//// objects-below-the-prototype-object-that-the-constructor-never-filled.js
function Item(name) {
  this.name = name;
  this.next = null;
}
Item.prototype.describe = function () {
  return String(this.name) + ":" + String(this.next) + ":" + Object.keys(this).length;
};
function Other() {}
const made = new Item("made");
const created = Object.create(Item.prototype);
const reflected = Reflect.construct(Other, [], Item);
const reflectedObject = Reflect.construct(Object, [], Item);
const borrowed = { name: "borrowed", describe: Item.prototype.describe };
for (const item of [made, created, reflected, reflectedObject, borrowed]) console.log(item.describe(), item instanceof Item);
Item.call(created, "filled late");
console.log(created.describe());
//// one-test-of-the-object-answers-for-all-the-fields-its-constructor-fills.js
// A reader of several fields tests the object once instead of each slot. Every object below goes through the same readers: the first one a constructor makes, one that lost a field, one whose
// field became an accessor, one that was seen before it was finished, one whose constructor left early, one made for another new.target, and one that the constructor was only called on.
// STATISTIC: BirthsFinished >= 2
const out = [];
globalThis.hide = new Function("value", "return value");
// What the compiler cannot read: it only knows that the objects go there.
const define = new Function("object", "key", "descriptor", "return Object.defineProperty(object, key, descriptor)");
const remove = new Function("object", "key", "return delete object[key]");

function Fiber(tag, key, child) {
  this.tag = tag;
  this.key = key;
  this.child = child;
  this.sibling = null;
  this.memo = undefined;
}
class Hook {
  constructor(state, queue) {
    this.state = state;
    this.queue = queue;
    this.next = null;
  }
}

function readFiber(fiber) {
  return [fiber.key, typeof fiber.key, `${fiber.key}`, fiber.child === null ? "no child" : typeof fiber.child, fiber.sibling, typeof fiber.sibling, fiber.memo, typeof fiber.memo, "key" in fiber, Object.keys(fiber).join()];
}
function readAcrossACall(fiber, between) {
  const before = fiber.key;
  between(fiber);
  return [before, fiber.key, fiber.sibling];
}
function storeIntoFiber(fiber, value) {
  fiber.key = value;
  fiber.sibling = value;
  return [fiber.key, fiber.sibling, Object.keys(fiber).join()];
}
function readHook(hook) {
  return [hook.state, hook.queue, hook.next];
}
function show(name, value) {
  out.push(name + ": " + JSON.stringify(value, (_, v) => (v === undefined ? "undefined" : v)));
}

const first = hide(new Fiber(0, "first", null));
show("the first object", readFiber(first));
for (let i = 0; i < 40; i++) readFiber(hide(new Fiber(i, "k" + i, first)));
show("a later object", readFiber(hide(new Fiber(1, "later", first))));

const deleted = hide(new Fiber(2, "deleted", null));
delete deleted.key;
show("a field deleted", readFiber(deleted));
show("a store creates it again, last", storeIntoFiber(deleted, "again"));
show("and it reads", readFiber(deleted));

Fiber.prototype.sibling = "inherited";
const uncovered = hide(new Fiber(3, "uncovered", null));
delete uncovered.sibling;
show("a deleted field uncovers the prototype's", readFiber(uncovered));
delete Fiber.prototype.sibling;

const accessor = hide(new Fiber(4, "accessor", null));
let reads = 0;
Object.defineProperty(accessor, "key", { get() { return "got " + ++reads; }, set(v) { reads = 100; }, configurable: true, enumerable: true });
show("a field redefined as an accessor", readFiber(accessor));
show("a store calls its setter", storeIntoFiber(accessor, "stored"));

const removed = hide(new Fiber(13, "removed", null));
remove(removed, "child");
show("a field deleted by code that nobody sees", readFiber(removed));
const redefined = hide(new Fiber(14, "redefined", null));
define(redefined, "memo", { get() { return "computed"; }, configurable: true, enumerable: false });
show("a field redefined by code that nobody sees", readFiber(redefined));
show("deleted in the middle of a reader by such code", readAcrossACall(hide(new Fiber(15, "there", null)), fiber => { remove(fiber, "key"); remove(fiber, "sibling"); }));
show("deleted in the middle of a reader", readAcrossACall(hide(new Fiber(5, "there", null)), fiber => { delete fiber.key; delete fiber.sibling; }));
show("left alone in the middle of a reader", readAcrossACall(hide(new Fiber(6, "there", null)), () => {}));

let seen;
function Early(key) {
  this.tag = 1;
  seen = readEarly(this);
  this.key = key;
  this.next = null;
}
function readEarly(early) {
  return [early.tag, early.key, early.next, Object.keys(early).join()];
}
const early = hide(new Early("early"));
show("seen before it was finished", seen);
show("and after", readEarly(early));

function Leaves(stop) {
  this.a = 1;
  if (stop) return;
  this.b = 2;
  this.c = 3;
}
function readLeaves(o) {
  return [o.a, o.b, o.c, Object.keys(o).join()];
}
show("the constructor ran to its end", readLeaves(hide(new Leaves(false))));
show("the constructor left early", readLeaves(hide(new Leaves(true))));

function Throws(fail, sink) {
  this.a = 1;
  sink.push(this);
  if (fail) throw new Error("stop");
  this.b = 2;
}
function readThrows(o) {
  return [o.a, o.b, Object.keys(o).join()];
}
const sink = [];
new Throws(false, sink);
try { new Throws(true, sink); } catch {}
show("the constructor threw", sink.map(readThrows));

function Other() {}
Other.prototype.marker = "other";
const forOther = hide(Reflect.construct(Fiber, [7, "for another new.target", null], Other));
show("made for another new.target", [readFiber(forOther), forOther.marker, forOther instanceof Fiber]);
class Setter { set key(v) { this.hidden = v; } }
const underSetter = hide(Reflect.construct(Fiber, [8, "under a setter", null], Setter));
show("a setter above takes the store", [readFiber(underSetter), underSetter.hidden]);

define(Fiber.prototype, "key", { set(v) { this.hidden = v; }, configurable: true });
const lateSetter = hide(new Fiber(10, "a setter has arrived", null));
show("a setter that arrived above takes the store", [readFiber(lateSetter), lateSetter.hidden]);
remove(Fiber.prototype, "key");
define(Fiber.prototype, "sibling", { value: "read-only above", writable: false, configurable: true });
const underReadOnly = hide((() => { try { return new Fiber(11, "read-only above", null); } catch (error) { return error.constructor.name; } })());
show("a read-only property that arrived above refuses the store", typeof underReadOnly === "string" ? underReadOnly : readFiber(underReadOnly));
remove(Fiber.prototype, "sibling");
show("and all is as before", readFiber(hide(new Fiber(12, "as before", null))));

const calledOn = hide({ own: true });
Fiber.call(calledOn, 9, "called on", null);
show("the constructor was called on another object", readFiber(calledOn));

const hook = hide(new Hook(1, "queue"));
show("an instance of a class", readHook(hook));
Object.defineProperty(hook, "queue", { value: "fixed", writable: false });
show("a field made read-only", readHook(hook));
const frozen = hide(Object.freeze(new Hook(2, "frozen")));
show("a frozen instance", readHook(frozen));
const copy = hide({ ...new Hook(3, "copied") });
show("a copy", readHook(copy));
const heir = hide(Object.create(new Hook(4, "inherited")));
show("an heir", [readHook(heir), Object.keys(heir).join()]);

console.log(out.join("\n"));
//// one-test-of-the-object-answers-for-its-numbers-and-booleans.ts
// A reader of numbers and booleans that every constructor stores tests the object once and then reads the raw values. undefined and null have room in such a slot,
// so whoever puts one there has to be seen by that one test: each way of doing so is tried below, on an object of its own, and every object goes through the same readers.
const out: string[] = [];
const suffix = process.argv[2] ?? "";
// What the compiler cannot read: it only knows that the objects go there.
const hide = new Function("value", "return value" + suffix) as <V>(value: V) => V;
const storeUnseen = new Function("object", "key", "value", "object[key] = value" + suffix) as (object: object, key: string, value: unknown) => void;
const storeUnderName = (key: string, head = "") => new Function("object", "value", head + "object." + key + " = value" + suffix) as (object: object, value: unknown) => void;
const defineUnseen = new Function("object", "key", "descriptor", "return Object.defineProperty(object, key, descriptor)" + suffix) as (object: object, key: string, descriptor: PropertyDescriptor) => void;
const removeUnseen = new Function("object", "key", "return delete object[key]" + suffix) as (object: object, key: string) => boolean;
const nothing = hide<unknown>(undefined);
const none = hide<unknown>(null);

class Counter {
  count: number;
  ratio: number;
  on: boolean;
  large: number;
  label: string;
  next: Counter | null;
  constructor(seed: number) {
    this.count = seed | 0;
    this.ratio = seed + 0.5;
    this.on = seed > 1;
    this.large = seed * 4294967296;
    this.label = "c" + seed;
    this.next = null;
  }
}

function read(counter: Counter): unknown[] {
  return [counter.count, typeof counter.count, counter.ratio, typeof counter.ratio, counter.on, typeof counter.on, counter.large, typeof counter.large, counter.label, Object.keys(counter).join()];
}
function compute(counter: Counter): unknown[] {
  return [counter.count | 0, counter.count + 1, counter.ratio * 2, counter.on ? "on" : "off", !counter.on, counter.large / 2, counter.count === 3, counter.count < 10, `${counter.count}|${counter.ratio}|${counter.on}`];
}
function change(counter: Counter): unknown[] {
  counter.count++;
  counter.ratio += 1;
  counter.on = !counter.on;
  counter.large -= 1;
  return [counter.count, counter.ratio, counter.on, counter.large];
}
function store(counter: Counter, count: number, ratio: number, on: boolean): unknown[] {
  counter.count = count;
  counter.ratio = ratio;
  counter.on = on;
  return [counter.count, counter.ratio, counter.on, Object.keys(counter).join()];
}
function readAcrossACall(counter: Counter, between: (counter: Counter) => void): unknown[] {
  const before = counter.count;
  const wasOn = counter.on;
  between(counter);
  return [before, counter.count, wasOn, counter.on, counter.ratio];
}
function show(name: string, value: unknown) {
  out.push(name + ": " + JSON.stringify(value, (_, v) => (v === undefined ? "undefined" : typeof v === "number" && !Number.isFinite(v) ? String(v) : v)));
}
function tryAll(name: string, counter: Counter) {
  show(name + ", read", read(counter));
  show(name + ", computed with", compute(counter));
  show(name + ", changed", change(counter));
  show(name + ", read again", read(counter));
  show(name + ", stored", store(counter, 3, 1.25, true));
  show(name + ", read at last", read(counter));
  show(name + ", computed with at last", compute(counter));
}

tryAll("the first object", hide(new Counter(1)));
for (let i = 0; i < 40; i++) read(hide(new Counter(i)));
tryAll("a later object", hide(new Counter(2)));

const keys = ["count", "ratio", "on", "large"];
for (const [word, value] of [["undefined", undefined], ["null", null]] as const) {
  for (const key of keys) {
    const byUnseenCode = hide(new Counter(3));
    storeUnseen(byUnseenCode, key, value);
    tryAll(`${word} stored under ${key} by code that nobody sees`, byUnseenCode);

    const named = storeUnderName(key);
    for (let turn = 0; turn < 4; turn++) named(new Counter(turn), key === "on" ? false : turn);
    const byNameInUnseenCode = hide(new Counter(3));
    named(byNameInUnseenCode, value);
    tryAll(`${word} stored as .${key} by code that nobody sees`, byNameInUnseenCode);
    const byNameInStrictCode = hide(new Counter(3));
    storeUnderName(key, "'use strict'; ")(byNameInStrictCode, value);
    tryAll(`${word} stored as .${key} by strict code that nobody sees`, byNameInStrictCode);

    const byKey: any = hide(new Counter(4));
    byKey[key] = value;
    tryAll(`${word} stored under the computed key ${key}`, byKey);

    const assigned = hide(new Counter(5));
    Object.assign(assigned, { [key]: value });
    tryAll(`${word} assigned to ${key}`, assigned);

    const defined = hide(new Counter(6));
    Object.defineProperty(defined, key, { value, writable: true, enumerable: true, configurable: true });
    tryAll(`${word} defined as ${key}`, defined);

    const definedUnseen = hide(new Counter(7));
    defineUnseen(definedUnseen, key, { value, writable: true, enumerable: true, configurable: true });
    tryAll(`${word} defined as ${key} by code that nobody sees`, definedUnseen);

    const reflected = hide(new Counter(8));
    Reflect.set(reflected, key, value);
    tryAll(`${word} set by Reflect under ${key}`, reflected);
  }

  const byName: any = hide(new Counter(9));
  byName.count = value;
  byName.ratio = value;
  byName.on = value;
  byName.large = value;
  tryAll(`${word} stored by name through any`, byName);

  const literal = hide(new Counter(10));
  Object.assign(literal, { count: value, ratio: value, on: value, large: value });
  tryAll(`${word} assigned to all four`, literal);
  const again = hide(new Counter(11));
  Object.assign(again, { count: value, ratio: value, on: value, large: value });
  tryAll(`${word} assigned to all four a second time`, again);

  const source = hide(new Counter(12));
  storeUnseen(source, "count", value);
  storeUnseen(source, "on", value);
  const copy = hide(new Counter(13));
  Object.assign(copy, source);
  tryAll(`${word} copied from another object of the class`, copy);
  show(`${word} in a spread of such an object`, { ...source });
}

function storeWhatTheTypeHides(counter: Counter, count: unknown, ratio: unknown, on: unknown): unknown[] {
  counter.count = count as number;
  counter.ratio = ratio as number;
  counter.on = on as boolean;
  return [counter.count, counter.ratio, counter.on];
}
for (const [word, value] of [["undefined", nothing], ["null", none]] as const) {
  const typed = hide(new Counter(14));
  show(`${word} behind a cast`, storeWhatTheTypeHides(typed, value, value, value));
  tryAll(`${word} stored behind a cast`, typed);
  const partly = hide(new Counter(15));
  show(`${word} and numbers behind a cast`, storeWhatTheTypeHides(partly, 7, value, false));
  tryAll(`${word} stored behind a cast beside numbers`, partly);
}

for (const key of keys) {
  const deleted: any = hide(new Counter(16));
  delete deleted[key];
  tryAll(`${key} deleted`, deleted);
  const removed = hide(new Counter(17));
  removeUnseen(removed, key);
  tryAll(`${key} deleted by code that nobody sees`, removed);
  const other = hide(new Counter(18));
  storeUnseen(other, key, "text");
  tryAll(`a string under ${key}`, other);
  const accessor = hide(new Counter(19));
  let held: unknown = undefined;
  Object.defineProperty(accessor, key, { get() { return held; }, set(v) { held = v; }, enumerable: true, configurable: true });
  tryAll(`${key} an accessor that answers undefined`, accessor);
}

show("undefined arrives in the middle of a reader", readAcrossACall(hide(new Counter(20)), counter => { storeUnseen(counter, "count", undefined); storeUnseen(counter, "on", null); }));
show("undefined arrives by name in the middle of a reader", readAcrossACall(hide(new Counter(21)), counter => { (counter as any).count = nothing; (counter as any).on = none; (counter as any).ratio = nothing; }));
show("nothing arrives in the middle of a reader", readAcrossACall(hide(new Counter(22)), () => {}));

function neverLeaves(value: unknown): unknown[] {
  const local = new Counter(23);
  const before = local.count;
  (local as any).count = value;
  (local as any).on = value;
  return [before, local.count, typeof local.count, local.on, local.ratio];
}
show("an object that never leaves its function gets undefined", neverLeaves(nothing));
show("an object that never leaves its function gets null", neverLeaves(none));
show("an object that never leaves its function gets a number", neverLeaves(5));

// The definition of a class field stores undefined, and a constructor need not store anything behind it.
class Declared {
  count!: number;
  on!: boolean;
  ratio!: number;
  label: string;
  constructor(fill: boolean) {
    this.label = "d";
    if (fill) {
      this.count = 1;
      this.on = true;
      this.ratio = 0.5;
    }
  }
}
function readDeclared(declared: Declared): unknown[] {
  return [declared.count, typeof declared.count, declared.on, typeof declared.on, declared.ratio, typeof declared.ratio, declared.label, Object.keys(declared).join()];
}
show("every declared field stored", readDeclared(hide(new Declared(true))));
show("the declared fields left as they were defined", readDeclared(hide(new Declared(false))));
for (let i = 0; i < 20; i++) readDeclared(hide(new Declared(i % 2 === 0)));
show("every declared field stored, later", readDeclared(hide(new Declared(true))));
show("the declared fields left as they were defined, later", readDeclared(hide(new Declared(false))));

class FilledBehindDefinitions {
  count: number;
  on: boolean;
  ratio: number;
  constructor(seed: number) {
    this.count = seed;
    this.on = seed > 0;
    this.ratio = seed / 2;
  }
}
function readFilled(filled: FilledBehindDefinitions): unknown[] {
  return [filled.count, filled.on, filled.ratio, typeof filled.count, Object.keys(filled).join()];
}
show("definitions and then stores", readFilled(hide(new FilledBehindDefinitions(3))));
show("definitions and then a store of what the type hides", readFilled(hide(new FilledBehindDefinitions(nothing as number))));
show("for another new.target", readFilled(hide(Reflect.construct(FilledBehindDefinitions, [4], class Other {}))));

let seenEarly: unknown[] = [];
class SeenEarly {
  count: number;
  on: boolean;
  constructor(seed: number) {
    seenEarly = readSeenEarly(hide(this));
    this.count = seed;
    seenEarly.push(...readSeenEarly(hide(this)));
    this.on = true;
  }
}
function readSeenEarly(object: SeenEarly): unknown[] {
  return [object.count, typeof object.count, object.on, typeof object.on];
}
const early = hide(new SeenEarly(6));
show("seen before it was finished", seenEarly);
show("and after", readSeenEarly(early));

console.log(out.join("\n"));
//// one-test-of-the-object-answers-for-objects-made-by-a-tag.ts
// One constructor function makes the nodes of every kind, and the interface that writes the kind says which further names a node gets. What the maker stores, numbers among it,
// is answered for by one test of the node. Every node below goes through the same readers, whatever has happened to it.
const out: string[] = [];
const suffix = process.argv[2] ?? "";
const hide = new Function("value", "return value" + suffix) as <V>(value: V) => V;
const storeUnseen = new Function("object", "key", "value", "object[key] = value" + suffix) as (object: object, key: string, value: unknown) => void;
const removeUnseen = new Function("object", "key", "return delete object[key]" + suffix) as (object: object, key: string) => boolean;

const enum Kind {
  Name = 1,
  Call = 2,
  Sum = 3,
  Block = 4,
}
interface Node {
  kind: Kind;
  pos: number;
  end: number;
  flags: number;
  id: number;
  parent: Node | undefined;
}
interface Name extends Node {
  kind: Kind.Name;
  text: string;
}
interface Call extends Node {
  kind: Kind.Call;
  callee: Node;
  operands: Node[];
}
interface Sum extends Node {
  kind: Kind.Sum;
  left: Node;
  right: Node;
}
interface Block extends Node {
  kind: Kind.Block;
  statements: Node[];
}

function NodeObject(this: Node, kind: Kind, pos: number, end: number) {
  this.pos = pos;
  this.end = end;
  this.kind = kind;
  this.id = 0;
  this.flags = 0;
  this.parent = undefined;
}
const NodeConstructor = NodeObject as unknown as new (kind: Kind, pos: number, end: number) => Node;

let nextId = 0;
function finish<N extends Node>(node: N, flags: number): N {
  node.id = ++nextId;
  node.flags |= flags;
  return node;
}
function createName(text: string, pos: number): Name {
  const node = new NodeConstructor(Kind.Name, pos, pos + text.length) as Name;
  node.text = text;
  return finish(node, 1);
}
function createCall(callee: Node, operands: Node[]): Call {
  const node = new NodeConstructor(Kind.Call, callee.pos, callee.end + 2) as Call;
  node.callee = callee;
  node.operands = operands;
  callee.parent = node;
  for (const operand of operands) operand.parent = node;
  return finish(node, 2);
}
function createSum(left: Node, right: Node): Sum {
  const node = new NodeConstructor(Kind.Sum, left.pos, right.end) as Sum;
  node.left = left;
  node.right = right;
  left.parent = node;
  right.parent = node;
  return finish(node, 4);
}
function createBlock(statements: Node[]): Block {
  const node = new NodeConstructor(Kind.Block, 0, 100) as Block;
  node.statements = statements;
  for (const statement of statements) statement.parent = node;
  return finish(node, 8);
}

function isName(node: Node): node is Name {
  return node.kind === Kind.Name;
}
function widthOf(node: Node): number {
  return node.end - node.pos;
}
function hasFlag(node: Node, flag: number): boolean {
  return (node.flags & flag) !== 0;
}
function depthOf(node: Node): number {
  let depth = 0;
  for (let current = node.parent; current !== undefined; current = current.parent) depth++;
  return depth;
}
function describe(node: Node): string {
  switch (node.kind) {
    case Kind.Name:
      return (node as Name).text;
    case Kind.Call:
      return describe((node as Call).callee) + "(" + (node as Call).operands.map(describe).join() + ")";
    case Kind.Sum:
      return describe((node as Sum).left) + "+" + describe((node as Sum).right);
    case Kind.Block:
      return "{" + (node as Block).statements.map(describe).join(";") + "}";
  }
  return "?" + String((node as Node).kind);
}
function read(node: Node): unknown[] {
  return [node.kind, typeof node.kind, node.pos, node.end, node.flags, typeof node.flags, node.id, isName(node), widthOf(node), hasFlag(node, 1), hasFlag(node, 6), depthOf(node), Object.keys(node).join()];
}
function show(name: string, value: unknown) {
  out.push(name + ": " + JSON.stringify(value, (_, v) => (v === undefined ? "undefined" : typeof v === "number" && !Number.isFinite(v) ? String(v) : v)));
}

function build(): Block {
  const a = createName("a", 1);
  const b = createName("bb", 3);
  const f = createName("f", 6);
  return hide(createBlock([createSum(a, b), createCall(f, [createName("c", 8), createSum(createName("d", 10), createName("e", 12))])]));
}
function forEachNode(node: Node, visit: (node: Node) => void) {
  visit(node);
  switch (node.kind) {
    case Kind.Call:
      forEachNode((node as Call).callee, visit);
      (node as Call).operands.forEach(operand => forEachNode(operand, visit));
      break;
    case Kind.Sum:
      forEachNode((node as Sum).left, visit);
      forEachNode((node as Sum).right, visit);
      break;
    case Kind.Block:
      (node as Block).statements.forEach(statement => forEachNode(statement, visit));
      break;
  }
}

const tree = build();
show("the tree", describe(tree));
forEachNode(tree, node => show("a node", read(node)));
for (let i = 0; i < 30; i++) forEachNode(build(), read);

for (const key of ["kind", "pos", "end", "flags", "id"]) {
  for (const [word, value] of [["undefined", undefined], ["null", null], ["a fraction", 1.5], ["a large number", 2 ** 40], ["a string", "text"]] as const) {
    const changed = build();
    const sum = changed.statements[0];
    storeUnseen(sum, key, value);
    show(`${word} under ${key} by code that nobody sees`, read(sum));
    show(`${word} under ${key}: the tree`, describe(changed));
    const byName: any = build().statements[1];
    byName[key] = value;
    show(`${word} under the computed key ${key}`, read(byName));
    finish(byName, 16);
    show(`${word} under ${key}, finished again`, read(byName));
  }
  const removed = build().statements[0];
  removeUnseen(removed, key);
  show(`${key} deleted by code that nobody sees`, read(removed));
  (removed as any)[key] = 2;
  show(`${key} stored again`, read(removed));
}

const twice = createName("twice", 5);
NodeObject.call(twice, Kind.Sum, 7, 9);
show("the maker called on a finished node", read(hide(twice)));
show("a kind that no interface writes", read(hide(new NodeConstructor(9 as Kind, 1, 4))));
show("a kind that is no number", read(hide(new NodeConstructor(hide<unknown>(undefined) as Kind, hide<unknown>(null) as number, 4))));
show("for another new.target", read(hide(Reflect.construct(NodeConstructor, [Kind.Call, 2, 3], function Other() {}))));

console.log(out.join("\n"));
//// one-test-of-the-object-answers-for-the-fields-that-every-literal-lists.ts
// Every literal of a shape lists the same names, so a reader of several of them tests the object once. Whoever takes one of those names away, or makes an object of the shape some other way,
// has to be seen by that one test: each way is tried below on an object of its own, and every object goes through the same readers.
const out: string[] = [];
const suffix = process.argv[2] ?? "";
const hide = new Function("value", "return value" + suffix) as <V>(value: V) => V;
const storeUnseen = new Function("object", "key", "value", "object[key] = value" + suffix) as (object: object, key: string, value: unknown) => void;
const defineUnseen = new Function("object", "key", "descriptor", "return Object.defineProperty(object, key, descriptor)" + suffix) as (object: object, key: string, descriptor: PropertyDescriptor) => void;
const removeUnseen = new Function("object", "key", "return delete object[key]" + suffix) as (object: object, key: string) => boolean;
const setPrototypeUnseen = new Function("object", "prototype", "return Object.setPrototypeOf(object, prototype)" + suffix) as (object: object, prototype: object | null) => void;

interface Hook { state: unknown; base: unknown; queue: Hook | null; label: string; next: Hook | null }
interface Pair { left: unknown; right: unknown; note?: string }

function make(seed: number): Hook { return hide({ state: seed, base: "b" + seed, queue: null, label: "hook " + seed, next: null }); }
function makeInOtherOrder(seed: number): Hook { return hide({ next: null, label: "other " + seed, queue: null, base: seed * 2, state: [seed] }); }
function makePair(seed: number): Pair { return hide({ left: seed, right: -seed }); }
function makePairWithNote(seed: number): Pair { return hide({ left: seed, right: -seed, note: "n" + seed }); }

function read(hook: Hook): unknown[] { return [hook.state, hook.base, hook.queue, hook.label, hook.next, Object.keys(hook).join()]; }
function copy(hook: Hook): Hook { return { state: hook.state, base: hook.base, queue: hook.queue, label: hook.label, next: null }; }
function change(hook: Hook): unknown[] { hook.state = "changed"; hook.base = 7; hook.next = hook; const same = hook.next === hook; hook.next = null; return [hook.state, hook.base, same, Object.keys(hook).join()]; }
function readAcrossACall(hook: Hook, between: (hook: Hook) => void): unknown[] { const before = hook.state; const label = hook.label; between(hook); return [before, hook.state, label, hook.label, hook.base]; }
function has(hook: Hook): unknown[] { return ["state" in hook, "base" in hook, Object.hasOwn(hook, "label"), hook.hasOwnProperty?.("next")]; }
function readPair(pair: Pair): unknown[] { return [pair.left, pair.right, pair.note, Object.keys(pair).join()]; }
function walk(head: Hook | null): string { let text = ""; for (let hook = head; hook !== null; hook = hook.next) text += hook.label + "=" + String(hook.state) + ";"; return text; }

// A literal that goes on with a getter, a computed key or a spread: each shape has readers of its own, so that the shapes above keep what they have.
interface Owner { host: unknown; readonly id: unknown; label: string }
interface Keyed { first: unknown; second: unknown; label: string }
interface Spread { first: unknown; second: unknown; label: string }
function makeOwner(seed: number): Owner { const held = { id: seed }; return hide({ host: "h" + seed, get id() { return held.id; }, label: "owner " + seed }); }
function makeKeyed(seed: number): Keyed { const key = hide("second"); return hide({ first: seed, [key]: -seed, label: "keyed " + seed } as unknown as Keyed); }
function makeSpread(seed: number): Spread { return hide({ first: seed, ...hide({ second: -seed, more: 1 }), label: "spread " + seed }); }
function readOwner(owner: Owner): unknown[] { return [owner.host, owner.id, owner.label, Object.keys(owner).join()]; }
function readKeyed(keyed: Keyed): unknown[] { return [keyed.first, keyed.second, keyed.label, Object.keys(keyed).join()]; }
function readSpread(spread: Spread): unknown[] { return [spread.first, spread.second, spread.label, Object.keys(spread).join()]; }

function show(name: string, value: unknown) {
    out.push(name + ": " + JSON.stringify(value, (_, v) => (v === undefined ? "undefined" : typeof v === "function" ? "function" : typeof v === "symbol" ? String(v) : v)));
}
function attempt(name: string, run: () => unknown) { try { show(name, run()); } catch (error) { show(name, (error as Error).constructor.name); } }
function tryAll(name: string, hook: Hook) {
    attempt(name + ", read", () => read(hook)); attempt(name + ", has", () => has(hook)); attempt(name + ", copy", () => read(copy(hook)));
    attempt(name + ", walk", () => walk(hook)); attempt(name + ", change", () => change(hook)); attempt(name + ", read again", () => read(hook));
}

for (let round = 0; round < 3; round++) {
    tryAll("as made", make(1));
    tryAll("in another order", makeInOtherOrder(2));
    { const hook = make(3); delete (hook as Partial<Hook>).state; tryAll("deleted here", hook); }
    { const hook = make(4); removeUnseen(hook, "base"); tryAll("deleted by unseen code", hook); }
    { const hook = make(5); removeUnseen(hook, "label"); setPrototypeUnseen(hook, { label: "inherited" }); tryAll("deleted, then inherited", hook); }
    { const hook = make(6); removeUnseen(hook, "state"); storeUnseen(hook, "state", "back"); tryAll("deleted and stored again", hook); }
    { const hook = make(7); defineUnseen(hook, "state", { get() { return "from a getter"; }, set() {}, configurable: true, enumerable: true }); tryAll("an accessor", hook); }
    { const hook = make(8); defineUnseen(hook, "base", { value: "read only", writable: false, configurable: true, enumerable: false }); tryAll("read only and hidden", hook); }
    { const hook = make(9); Object.freeze(hook); tryAll("frozen", hook); }
    { const hook = make(10); Object.seal(hook); tryAll("sealed", hook); }
    { const hook = make(11); storeUnseen(hook, "label", 12); storeUnseen(hook, "queue", "no hook"); tryAll("other types", hook); }
    { const hook = make(12); storeUnseen(hook, "state", undefined); storeUnseen(hook, "next", undefined); tryAll("undefined stored", hook); }
    { const hook = make(13); storeUnseen(hook, "extra", 1); tryAll("one more name", hook); }
    tryAll("parsed", hide(JSON.parse('{"state":1,"base":2,"queue":null,"label":"parsed","next":null}')) as Hook);
    tryAll("parsed, a name short", hide(JSON.parse('{"state":1,"queue":null,"label":"short","next":null}')) as Hook);
    tryAll("spread", hide({ ...make(14) }));
    tryAll("spread with a change", hide({ ...make(15), label: "spread" }));
    tryAll("assigned", hide(Object.assign({}, make(16))) as Hook);
    tryAll("assigned onto one", Object.assign(make(17), hide({ state: "assigned", label: "onto" })));
    tryAll("created with a prototype", hide(Object.create(make(18))) as Hook);
    tryAll("cloned", hide(structuredClone({ state: 1, base: 2, queue: null, label: "cloned", next: null })) as Hook);
    tryAll("from entries", hide(Object.fromEntries(Object.entries(make(19)))) as unknown as Hook);
    tryAll("empty", hide({}) as Hook);
    tryAll("a proxy", hide(new Proxy(make(20), { get: (target, key) => (key === "state" ? "trapped" : Reflect.get(target, key)) })));
    attempt("deleted between two reads", () => readAcrossACall(make(21), hook => { removeUnseen(hook, "state"); removeUnseen(hook, "label"); }));
    attempt("redefined between two reads", () => readAcrossACall(make(22), hook => defineUnseen(hook, "label", { get: () => "late", configurable: true })));
    attempt("nothing between two reads", () => readAcrossACall(make(23), () => {}));
    { const a = make(24), b = makeInOtherOrder(25), c = make(26); a.next = b; b.next = c; removeUnseen(b, "state"); attempt("a chain with a gap", () => walk(a)); }
    attempt("pair", () => readPair(makePair(1))); attempt("pair with note", () => readPair(makePairWithNote(2)));
    { const pair = makePairWithNote(3); removeUnseen(pair, "note"); attempt("pair, note deleted", () => readPair(pair)); }
    { const pair = makePair(4); removeUnseen(pair, "left"); attempt("pair, left deleted", () => readPair(pair)); }
    { const pair = makePair(5); storeUnseen(pair, "note", "late"); attempt("pair, note added", () => readPair(pair)); }
    attempt("a getter in the literal", () => readOwner(makeOwner(1)));
    { const owner = makeOwner(2); removeUnseen(owner, "host"); attempt("a getter in the literal, a field deleted", () => readOwner(owner)); }
    { const owner = makeOwner(3); owner.label = "stored"; storeUnseen(owner, "host", 7); attempt("a getter in the literal, fields stored", () => readOwner(owner)); }
    attempt("a computed key in the literal", () => readKeyed(makeKeyed(4)));
    { const keyed = makeKeyed(5); removeUnseen(keyed, "first"); attempt("a computed key in the literal, a field deleted", () => readKeyed(keyed)); }
    attempt("a spread in the literal", () => readSpread(makeSpread(6)));
    { const spread = makeSpread(7); removeUnseen(spread, "label"); storeUnseen(spread, "label", "again"); attempt("a spread in the literal, a field deleted and stored again", () => readSpread(spread)); }
}
console.log(out.join("\n"));
//// options-left-at-their-empty-default-are-read-at-the-pace-of-options-that-were-given.ts
// `function f(options: Options = {})`: some callers list every member, some leave the default. Reading the members of an object that was born empty costs about what reading a full one costs, not twice as much.
declare const console: { log(...values: unknown[]): void };
declare const performance: { now(): number };
interface Options { width?: number; height?: number; label?: string; next?: Options }
function withDefault(options: Options = {}): Options { return options; }
function measure(options: Options): number { return (options.width ?? 2) + (options.height ?? 3) + (options.label ? 1 : 0) + (options.next ? 1 : 0); }
const given: Options[] = [], left: Options[] = [];
for (let i = 0; i < 1000; i++) { given.push(withDefault({ width: i & 1, height: i & 3, label: "a" + i, next: undefined })); left.push(withDefault()); }
function sum(bags: Options[], rounds: number): number { let total = 0; for (let round = 0; round < rounds; round++) for (let i = 0; i < bags.length; i++) total += measure(bags[i]); return total; }
function fastestOf(runs: number, bags: Options[]): number {
  let fastest = Infinity;
  for (let run = 0; run < runs; run++) { const began = performance.now(); sum(bags, 4000); fastest = Math.min(fastest, performance.now() - began); }
  return fastest;
}
console.log(sum(given, 1), sum(left, 1));
const full = fastestOf(5, given), empty = fastestOf(5, left);
console.log(empty < full * 2 ? "the empty ones are read in under twice the time" : "the empty ones took over twice the time");
//// private-fields-are-read-from-what-object-create-made.ts
class Counter { #count = 1; static read(c: Counter): number { return c.#count; } bump(): number { return ++this.#count; } }
const stranger = Object.create(Counter.prototype) as Counter;
console.log(Counter.read(new Counter()));
try { console.log(Counter.read(stranger)); } catch (error) { console.log("threw", (error as Error).name); }
try { console.log(stranger.bump()); } catch (error) { console.log("threw", (error as Error).name); }
//// proto-is-assigned.js
// `__proto__` is assigned on an instance. A function reads a field that most objects get late, and then relies on what lies above the object or beside the slot.
class A { constructor() { this.x = 1; } m() { return "A.m"; } get g() { return "A.g"; } }
const parent = { m() { return "parent.m"; }, get g() { return "parent.g"; }, missing: "parent.missing", extra: "parent.extra" };
function reparent(o) { o.__proto__ = parent; return o; }
////= readers
const states = ["filled", "empty", "holds undefined", "deleted"];
////= fill
function tell(reader, o) { try { return reader(o); } catch (error) { return error.constructor.name; } }
////= for-12	reparent
//// proto-is-assigned-typed.ts
// `__proto__` is assigned on an instance. A function reads a field that most objects get late, and then relies on what lies above the object or beside the slot.
class A { x = 1; extra?: unknown; second?: unknown; third?: unknown; m(): string { return "A.m"; } get g(): string { return "A.g"; } }
const parent = { m() { return "parent.m"; }, get g() { return "parent.g"; }, missing: "parent.missing", extra: "parent.extra" };
function reparent(o: any) { o.__proto__ = parent; return o; }
////= readers-2
const states = ["filled", "empty", "holds undefined", "deleted"];
////= fill-2
function tell(reader: (o: A) => string, o: A) { try { return reader(o); } catch (error) { return (error as Error).constructor.name; } }
////= for-12	reparent
//// put-below-another-object.js
// Object.setPrototypeOf puts an instance below another object, which has the names that the instance leaves out. A function reads a field that most objects get late, and then relies on what lies above the object or beside the slot.
class A { constructor() { this.x = 1; } m() { return "A.m"; } get g() { return "A.g"; } }
const parent = { m() { return "parent.m"; }, get g() { return "parent.g"; }, missing: "parent.missing", extra: "parent.extra", second: "parent.second", third: "parent.third" };
////= readers
const states = ["filled", "empty", "holds undefined", "deleted"];
////= fill
function tell(reader, o) { try { return reader(o); } catch (error) { return error.constructor.name; } }
for (const [title, reader] of readers)
  for (const state of states)
    console.log(title + ", " + state + ": " + tell(reader, fill(new A(), state)) + " | " + tell(reader, fill(Object.setPrototypeOf(new A(), parent), state)));
//// put-below-another-object-typed.ts
// Object.setPrototypeOf puts an instance below another object, which has the names that the instance leaves out. A function reads a field that most objects get late, and then relies on what lies above the object or beside the slot.
class A { x = 1; extra?: unknown; second?: unknown; third?: unknown; m(): string { return "A.m"; } get g(): string { return "A.g"; } }
const parent = { m() { return "parent.m"; }, get g() { return "parent.g"; }, missing: "parent.missing", extra: "parent.extra", second: "parent.second", third: "parent.third" };
////= readers-2
const states = ["filled", "empty", "holds undefined", "deleted"];
////= fill-2
function tell(reader: (o: A) => string, o: A) { try { return reader(o); } catch (error) { return (error as Error).constructor.name; } }
for (const [title, reader] of readers)
  for (const state of states)
    console.log(title + ", " + state + ": " + tell(reader, fill(new A(), state)) + " | " + tell(reader, fill(Object.setPrototypeOf(new A(), parent), state)));
