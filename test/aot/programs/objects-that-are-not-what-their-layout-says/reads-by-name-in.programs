    for (const state of states)
      console.log(round + ", " + title + ", " + state + ": " + tell(reader, fill(new A(), state)));
  A.prototype.m = function () { return "replaced m"; }; Object.defineProperty(A.prototype, "g", { get() { return "replaced g"; }, configurable: true });
