// A constructor function is called as a function: on a plain object, on an object under its prototype, on one that is filled, frozen or of another class. In sloppy code, where a refused store is silent.
////= Node-2
function fill(target, kind) {
  attempt("filling " + kind, () => Node.call(target, kind, kind * 2, kind * 3));
  return target;
}
console.log(readAll(make(Node, 40)));
