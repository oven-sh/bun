// One arm of a conditional gives what Object.create(A.prototype) made, out of a variable of type `A | null`, the other an instance of B. Two fields that B declares as numbers are read from whichever it is.
class A {}
////= B
let held: A | null = null;
const made: B[] = [new B(1.5, 2.5)];
function sum(first: boolean): number {
  const it = held;
  if (it === null) return 0;
  const either: A | B = first ? it : made[0];
  return (either as any).x + (either as any).y;
}
console.log(sum(true), sum(false));
held = Object.create(A.prototype);
console.log(sum(true), sum(false));
(held as any).x = "a";
(held as any).y = "b";
console.log(sum(true), sum(false));
//// what-object-create-made-or-an-instance-of-another-class-has-a-number-field-stored.ts
// One arm of a conditional gives what Object.create(A.prototype) made, out of a variable of type `A | null`, the other an instance of B. Two fields that B declares as numbers are stored on whichever it is.
class A {}
////= B
let held: A | null = null;
const made: B[] = [new B(1.5, 2.5)];
function put(first: boolean, value: number) {
  const it = held;
  if (it === null) return 0;
  const either: A | B = first ? it : made[0];
  (either as any).x = value;
  (either as any).y = value + 1;
  return 1;
}
held = Object.create(A.prototype);
(held as any).first = "first";
(held as any).second = "second";
console.log(put(true, 1.5), put(false, 3.5));
console.log(JSON.stringify(held), Object.keys(held as object).join(), made[0].x, made[0].y);
//// what-object-create-made-or-an-instance-of-another-class-has-a-string-field-read.ts
// One arm of a conditional, of `??` or of a loop gives what Object.create(A.prototype) made, out of a variable of type `A | null`, the other an instance of B. A field that B declares as a string is read from whichever it is.
class A {}
class B {
  a = 1; b = 2; c = 3; d = 4; e = 5; f = 6; g = 7; h = 8;
  z = "s";
}
let held: A | null = null;
const made: B[] = [new B()];
function conditional(first: boolean) {
  const it = held;
  if (it === null) return 0;
  const either: A | B = first ? it : made[0];
  const text = (either as any).z;
  return text === undefined ? -1 : text.length + text.charCodeAt(0);
}
function coalesced() {
  const either: A | B = held ?? made[0];
  const text = (either as any).z;
  return text === undefined ? -1 : text.length + text.charCodeAt(0);
}
function aroundALoop(turns: number) {
  let either: A | B = made[0];
  let total = 0;
  for (let turn = 0; turn < turns; turn++) {
    const text = (either as any).z;
    total += text === undefined ? -1 : text.length;
    const it = held;
    if (it !== null) either = it;
  }
  return total;
}
console.log(conditional(true), conditional(false), coalesced(), aroundALoop(3));
held = Object.create(A.prototype);
console.log(conditional(true), conditional(false), coalesced(), aroundALoop(3));
(held as any).z = "longer";
console.log(conditional(true), conditional(false), coalesced(), aroundALoop(3));
