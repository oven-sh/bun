//// the-first-stores-of-a-constructor-are-seen-or-taken-by-others.ts
// A constructor function begins with plain stores: `this.flags = flags; this.id = id; ..`. Nothing seems to run between them. These cases let somebody see the object before they are through,
// or take a store away from the object: a setter, a constant or a proxy above it, another new.target, a call without `new`, a default of a parameter that hands `this` out, a heir, a constructor that leaves early.
declare const console: { log(...values: unknown[]): void };
const lines: string[] = [];
function say(label: string, value: unknown) { lines.push(label + ": " + JSON.stringify(value, (_, v) => v === undefined ? "#undefined" : typeof v === "function" ? "#function" : typeof v === "number" && v !== v ? "#NaN" : v)); }

interface Kind { flags: number; id: number; name: string; on: boolean }
type KindConstructor = new (flags: number, id: number) => Kind;
function flagsOf(kind: Kind): number { return kind.flags; }
function idOf(kind: Kind): number { return kind.id; }
function nameOf(kind: Kind): string { return kind.name; }
function isOn(kind: Kind): boolean { return kind.on; }
function show(kind: Kind) { return [flagsOf(kind), idOf(kind), nameOf(kind), isOn(kind), Object.keys(kind).join()]; }
function warm(make: KindConstructor): number { let t = 0; for (let i = 0; i < 3000; i++) { const kind = new make(i & 7, i); t += flagsOf(kind) + idOf(kind) + nameOf(kind).length + (isOn(kind) ? 1 : 0); } return t; }
const define = (object: object, key: string, descriptor: PropertyDescriptor) => Object.defineProperty(object, [key][0], descriptor);

// A setter arrives above the object under the name of a first store.
{ const A = function (this: Kind, flags: number, id: number) { this.flags = flags; this.id = id; this.name = "a" + id; this.on = id > 1; } as unknown as KindConstructor;
  say("A warm", warm(A)); const before = new A(1, 2); const seen: unknown[] = [];
  define(A.prototype, "id", { set(this: Kind, value: number) { seen.push([value, Object.keys(this).join(), flagsOf(this), nameOf(this)]); }, get() { return -5; }, configurable: true });
  const after = new A(3, 4); say("a setter above", [show(before), show(after), seen]);
  delete (A.prototype as any)[["id"][0]]; say("the setter is gone", [show(after), show(new A(5, 6))]); }
// A constant above the object: the store is refused.
{ const B = function (this: Kind, flags: number, id: number) { this.flags = flags; this.id = id; this.name = "b" + id; this.on = id > 1; } as unknown as KindConstructor;
  say("B warm", warm(B)); define(B.prototype, "name", { value: "fixed", writable: false, configurable: true });
  let made: unknown; try { made = show(new B(1, 2)); } catch (error) { made = (error as Error).constructor.name; } say("a constant above", made); }
// A proxy above the object sees every store that finds no own property.
{ const C = function (this: Kind, flags: number, id: number) { this.flags = flags; this.id = id; this.name = "c" + id; this.on = id > 1; } as unknown as KindConstructor;
  say("C warm", warm(C)); const seen: string[] = [];
  Object.setPrototypeOf(C.prototype, new Proxy({}, { set(_target, key, value, receiver) { seen.push(String(key) + ":" + Object.keys(receiver).join("+")); return Reflect.defineProperty(receiver, key, { value, writable: true, enumerable: true, configurable: true }); } }));
  say("a proxy above", [show(new C(1, 2)), seen]); }
// Another new.target.
{ const D = function (this: Kind, flags: number, id: number) { this.flags = flags; this.id = id; this.name = "d" + id; this.on = id > 1; } as unknown as KindConstructor;
  say("D warm", warm(D)); const seen: unknown[] = []; function Other() {} define(Other.prototype, "flags", { set(this: Kind, value: number) { seen.push([value, Object.keys(this).join()]); }, configurable: true });
  const made = Reflect.construct(D, [7, 8], Other) as Kind; say("another new.target", [show(made), seen, made instanceof D, made instanceof Other]); }
// A call without `new`, on whatever is handed in.
{ const E = function (this: Kind, flags: number, id: number) { this.flags = flags; this.id = id; this.name = "e" + id; this.on = id > 1; } as unknown as KindConstructor & ((this: unknown, flags: number, id: number) => void);
  say("E warm", warm(E)); const plain = { id: "mine", extra: 1 } as unknown as Kind; (E as Function).call(plain, 1, 2); say("on a literal", show(plain));
  const frozen = Object.freeze({ flags: 9 }) as unknown as Kind; let result: unknown; try { (E as Function).call(frozen, 1, 2); result = "stored"; } catch (error) { result = (error as Error).constructor.name; } say("on a frozen literal", [result, Object.keys(frozen).join(), flagsOf(frozen)]);
  const old = new E(1, 1); (E as Function).call(old, "text", undefined); say("again on its own object, with other values", show(old)); }
// A default of a parameter runs before the first store and hands `this` out.
{ const early: unknown[] = []; let held: Kind | undefined;
  const F = function (this: Kind, flags: number, id: number = (held = this, early.push(show(this)), 40)) { this.flags = flags; this.id = id; this.name = "f" + id; this.on = id > 1; } as unknown as new (flags: number, id?: number) => Kind;
  let t = 0; for (let i = 0; i < 3000; i++) t += idOf(new F(i & 7, i)); say("F warm", t);
  const made = new F(2); say("a default that sees `this`", [early, show(made), held === made]); }
// A value that runs code when it is worked out, between two stores.
{ const between: unknown[] = [];
  const G = function (this: Kind, flags: number, source: { id: number }) { this.flags = flags; this.id = source.id; this.name = "g"; this.on = true; } as unknown as new (flags: number, source: { id: number }) => Kind;
  let t = 0; for (let i = 0; i < 3000; i++) t += idOf(new G(i & 7, { id: i })); say("G warm", t);
  let made: Kind | undefined; const Peek = function (this: Kind, flags: number) { made = this; G.call(this as never, flags, { get id() { between.push(show(made!)); return 12; } }); } as unknown as new (flags: number) => Kind; Peek.prototype = G.prototype;
  say("a getter between two stores", [show(new Peek(3)), between]); }
// A heir whose own fields come behind, and one that looks before super() is through.
{ const H = function (this: Kind, flags: number, id: number) { this.flags = flags; this.id = id; this.name = "h" + id; this.on = id > 1; } as unknown as KindConstructor;
  say("H warm", warm(H)); class Heir extends H { extra = flagsOf(this) + 100; } const heir = new Heir(1, 2); say("a heir", [show(heir), heir.extra]); }
// A constructor that leaves early, throws, or answers another object.
{ const I = function (this: Kind, flags: number, id: number) { this.flags = flags; if (id < 0) return; this.id = id; if (id === 0) throw new RangeError("zero"); this.name = "i" + id; this.on = id > 1; if (id === 99) return { flags: -1, id: -1, name: "other", on: false }; } as unknown as KindConstructor;
  say("I warm", warm(function (this: Kind, flags: number, id: number) { return new I(flags, id + 1); } as unknown as KindConstructor));
  say("it leaves early", show(new I(1, -1))); let thrown: unknown; try { new I(1, 0); } catch (error) { thrown = (error as Error).message; } say("it throws", thrown); say("it answers another object", show(new I(1, 99))); }
// Chains and stores of one value under two names.
{ const J = function (this: Kind & { copy: number }, flags: number, id: number) { this.flags = this.copy = flags; this.id = id; this.name = "j"; this.on = false; } as unknown as new (flags: number, id: number) => Kind & { copy: number };
  let t = 0; for (let i = 0; i < 3000; i++) t += new J(i & 7, i).copy; say("J warm", t); say("a chain", [show(new J(4, 5)), new J(4, 5).copy]); }
console.log(lines.join("\n"));
//// the-method-is-shadowed-on-the-object.js
// The object has properties of its own under the names of the method and of the getter. A function reads a field that most objects get late, and then relies on what lies above the object or beside the slot.
class A { constructor() { this.x = 1; } m() { return "A.m"; } get g() { return "A.g"; } }
function shadow(o) { o.m = () => "own m"; Object.defineProperty(o, "g", { value: "own g", configurable: true }); return o; }
////= readers
const states = ["filled", "empty", "holds undefined", "deleted"];
////= fill
function tell(reader, o) { try { return reader(o); } catch (error) { return error.constructor.name; } }
////= for-12	shadow
//// the-method-is-shadowed-on-the-object-typed.ts
// The object has properties of its own under the names of the method and of the getter. A function reads a field that most objects get late, and then relies on what lies above the object or beside the slot.
class A { x = 1; extra?: unknown; second?: unknown; third?: unknown; m(): string { return "A.m"; } get g(): string { return "A.g"; } }
function shadow(o: any) { o.m = () => "own m"; Object.defineProperty(o, "g", { value: "own g", configurable: true }); return o; }
////= readers-2
const states = ["filled", "empty", "holds undefined", "deleted"];
////= fill-2
function tell(reader: (o: A) => string, o: A) { try { return reader(o); } catch (error) { return (error as Error).constructor.name; } }
////= for-12	shadow
//// the-method-of-the-class-is-replaced.js
// The method and the getter of the class are replaced between two rounds of the same reads. A function reads a field that most objects get late, and then relies on what lies above the object or beside the slot.
class A { constructor() { this.x = 1; } m() { return "A.m"; } get g() { return "A.g"; } }
////= readers
const states = ["filled", "empty", "holds undefined", "deleted"];
////= fill
function tell(reader, o) { try { return reader(o); } catch (error) { return error.constructor.name; } }
////= for-10
//// the-method-of-the-class-is-replaced-typed.ts
// The method and the getter of the class are replaced between two rounds of the same reads. A function reads a field that most objects get late, and then relies on what lies above the object or beside the slot.
class A { x = 1; extra?: unknown; second?: unknown; third?: unknown; m(): string { return "A.m"; } get g(): string { return "A.g"; } }
////= readers-2
const states = ["filled", "empty", "holds undefined", "deleted"];
////= fill-2
function tell(reader: (o: A) => string, o: A) { try { return reader(o); } catch (error) { return (error as Error).constructor.name; } }
////= for-10
//// the-tag-of-a-made-object-parts-from-the-layout-that-it-chose.ts
// An object that a constructor function makes has the layout of the tag that it was handed. Each family below parts the tag from that layout in a way of its own,
// and a reader that tests the tag must find the names that the object really has.
const nameOfTag: string = ["ki", "nd"].join("");
const lines: string[] = [];

// nothing is done to it
interface BaseUntouched { kind: number }
interface OneUntouched extends BaseUntouched { kind: 1; one: string }
interface TwoUntouched extends BaseUntouched { kind: 2; two: number; more: number }
function MakerUntouched(this: BaseUntouched, kind: number) { this.kind = kind; }
const NewUntouched = MakerUntouched as unknown as new (kind: number) => BaseUntouched;
////= lines	readUntouched	OneUntouched	TwoUntouched
{
  const first = new NewUntouched(1) as OneUntouched;
  first.one = "a";
  const second = new NewUntouched(2) as TwoUntouched;
  second.two = 5;
  second.more = 6;
  lines.push("Untouched: " + readUntouched(first) + " | " + readUntouched(second) + " | " + String((first as any).kind));
}

// the tag is stored again
interface BaseStoredAgain { kind: number }
interface OneStoredAgain extends BaseStoredAgain { kind: 1; one: string }
interface TwoStoredAgain extends BaseStoredAgain { kind: 2; two: number; more: number }
function MakerStoredAgain(this: BaseStoredAgain, kind: number) { this.kind = kind; }
const NewStoredAgain = MakerStoredAgain as unknown as new (kind: number) => BaseStoredAgain;
////= lines	readStoredAgain	OneStoredAgain	TwoStoredAgain
{
  const first = new NewStoredAgain(1) as OneStoredAgain;
  first.one = "a";
  const second = new NewStoredAgain(2) as TwoStoredAgain;
  second.two = 5;
  second.more = 6;
  (first as { kind: number }).kind = 2;
  lines.push("StoredAgain: " + readStoredAgain(first) + " | " + readStoredAgain(second) + " | " + String((first as any).kind));
}

// the tag is stored through any
interface BaseStoredThroughAny { kind: number }
interface OneStoredThroughAny extends BaseStoredThroughAny { kind: 1; one: string }
interface TwoStoredThroughAny extends BaseStoredThroughAny { kind: 2; two: number; more: number }
function MakerStoredThroughAny(this: BaseStoredThroughAny, kind: number) { this.kind = kind; }
const NewStoredThroughAny = MakerStoredThroughAny as unknown as new (kind: number) => BaseStoredThroughAny;
////= lines	readStoredThroughAny	OneStoredThroughAny	TwoStoredThroughAny
{
  const first = new NewStoredThroughAny(1) as OneStoredThroughAny;
  first.one = "a";
  const second = new NewStoredThroughAny(2) as TwoStoredThroughAny;
  second.two = 5;
  second.more = 6;
  (first as any).kind = 2;
  lines.push("StoredThroughAny: " + readStoredThroughAny(first) + " | " + readStoredThroughAny(second) + " | " + String((first as any).kind));
}

// the tag is stored under a computed name
interface BaseStoredUnderComputedName { kind: number }
interface OneStoredUnderComputedName extends BaseStoredUnderComputedName { kind: 1; one: string }
interface TwoStoredUnderComputedName extends BaseStoredUnderComputedName { kind: 2; two: number; more: number }
function MakerStoredUnderComputedName(this: BaseStoredUnderComputedName, kind: number) { this.kind = kind; }
const NewStoredUnderComputedName = MakerStoredUnderComputedName as unknown as new (kind: number) => BaseStoredUnderComputedName;
////= lines	readStoredUnderComputedName	OneStoredUnderComputedName	TwoStoredUnderComputedName
{
  const first = new NewStoredUnderComputedName(1) as OneStoredUnderComputedName;
  first.one = "a";
  const second = new NewStoredUnderComputedName(2) as TwoStoredUnderComputedName;
  second.two = 5;
  second.more = 6;
  (first as any)[nameOfTag] = 2;
  lines.push("StoredUnderComputedName: " + readStoredUnderComputedName(first) + " | " + readStoredUnderComputedName(second) + " | " + String((first as any).kind));
}

// Object.assign copies another tag over it
interface BaseAssigned { kind: number }
interface OneAssigned extends BaseAssigned { kind: 1; one: string }
interface TwoAssigned extends BaseAssigned { kind: 2; two: number; more: number }
function MakerAssigned(this: BaseAssigned, kind: number) { this.kind = kind; }
const NewAssigned = MakerAssigned as unknown as new (kind: number) => BaseAssigned;
////= lines	readAssigned	OneAssigned	TwoAssigned
{
  const first = new NewAssigned(1) as OneAssigned;
  first.one = "a";
  const second = new NewAssigned(2) as TwoAssigned;
  second.two = 5;
  second.more = 6;
  Object.assign(first, { kind: 2 });
  lines.push("Assigned: " + readAssigned(first) + " | " + readAssigned(second) + " | " + String((first as any).kind));
}

// Reflect.set stores another tag
interface BaseSetByReflect { kind: number }
interface OneSetByReflect extends BaseSetByReflect { kind: 1; one: string }
interface TwoSetByReflect extends BaseSetByReflect { kind: 2; two: number; more: number }
function MakerSetByReflect(this: BaseSetByReflect, kind: number) { this.kind = kind; }
const NewSetByReflect = MakerSetByReflect as unknown as new (kind: number) => BaseSetByReflect;
////= lines	readSetByReflect	OneSetByReflect	TwoSetByReflect
{
  const first = new NewSetByReflect(1) as OneSetByReflect;
  first.one = "a";
  const second = new NewSetByReflect(2) as TwoSetByReflect;
  second.two = 5;
  second.more = 6;
  Reflect.set(first, nameOfTag, 2);
  lines.push("SetByReflect: " + readSetByReflect(first) + " | " + readSetByReflect(second) + " | " + String((first as any).kind));
}

// the tag is deleted
interface BaseDeleted { kind: number }
interface OneDeleted extends BaseDeleted { kind: 1; one: string }
interface TwoDeleted extends BaseDeleted { kind: 2; two: number; more: number }
function MakerDeleted(this: BaseDeleted, kind: number) { this.kind = kind; }
const NewDeleted = MakerDeleted as unknown as new (kind: number) => BaseDeleted;
////= lines	readDeleted	OneDeleted	TwoDeleted
{
  const first = new NewDeleted(1) as OneDeleted;
  first.one = "a";
  const second = new NewDeleted(2) as TwoDeleted;
  second.two = 5;
  second.more = 6;
  delete (first as any).kind;
  lines.push("Deleted: " + readDeleted(first) + " | " + readDeleted(second) + " | " + String((first as any).kind));
}

// the tag is defined again
interface BaseRedefined { kind: number }
interface OneRedefined extends BaseRedefined { kind: 1; one: string }
interface TwoRedefined extends BaseRedefined { kind: 2; two: number; more: number }
function MakerRedefined(this: BaseRedefined, kind: number) { this.kind = kind; }
const NewRedefined = MakerRedefined as unknown as new (kind: number) => BaseRedefined;
////= lines	readRedefined	OneRedefined	TwoRedefined
{
  const first = new NewRedefined(1) as OneRedefined;
  first.one = "a";
  const second = new NewRedefined(2) as TwoRedefined;
  second.two = 5;
  second.more = 6;
  Object.defineProperty(first, nameOfTag, { value: 2 });
  lines.push("Redefined: " + readRedefined(first) + " | " + readRedefined(second) + " | " + String((first as any).kind));
}

// the tag becomes an accessor
interface BaseMadeAccessor { kind: number }
interface OneMadeAccessor extends BaseMadeAccessor { kind: 1; one: string }
interface TwoMadeAccessor extends BaseMadeAccessor { kind: 2; two: number; more: number }
function MakerMadeAccessor(this: BaseMadeAccessor, kind: number) { this.kind = kind; }
const NewMadeAccessor = MakerMadeAccessor as unknown as new (kind: number) => BaseMadeAccessor;
////= lines	readMadeAccessor	OneMadeAccessor	TwoMadeAccessor
{
  const first = new NewMadeAccessor(1) as OneMadeAccessor;
  first.one = "a";
  const second = new NewMadeAccessor(2) as TwoMadeAccessor;
  second.two = 5;
  second.more = 6;
  Object.defineProperty(first, nameOfTag, { get() { return 2; } });
  lines.push("MadeAccessor: " + readMadeAccessor(first) + " | " + readMadeAccessor(second) + " | " + String((first as any).kind));
}

// the maker is called again on a finished object
interface BaseCalledAgain { kind: number }
interface OneCalledAgain extends BaseCalledAgain { kind: 1; one: string }
interface TwoCalledAgain extends BaseCalledAgain { kind: 2; two: number; more: number }
function MakerCalledAgain(this: BaseCalledAgain, kind: number) { this.kind = kind; }
const NewCalledAgain = MakerCalledAgain as unknown as new (kind: number) => BaseCalledAgain;
////= lines	readCalledAgain	OneCalledAgain	TwoCalledAgain
{
  const first = new NewCalledAgain(1) as OneCalledAgain;
  first.one = "a";
  const second = new NewCalledAgain(2) as TwoCalledAgain;
  second.two = 5;
  second.more = 6;
  (MakerCalledAgain as unknown as (this: object, kind: number) => void).call(first, 2);
  lines.push("CalledAgain: " + readCalledAgain(first) + " | " + readCalledAgain(second) + " | " + String((first as any).kind));
}

// The maker hands its object out before it stores the tag.
interface BaseSeenEarly { kind: number }
interface OneSeenEarly extends BaseSeenEarly { kind: 1; one: string }
interface TwoSeenEarly extends BaseSeenEarly { kind: 2; two: number; more: number }
const seenEarly: string[] = [];
////= lines	readSeenEarly	OneSeenEarly	TwoSeenEarly
function MakerSeenEarly(this: BaseSeenEarly, kind: number) {
  seenEarly.push(readSeenEarly(this as OneSeenEarly));
  this.kind = kind;
}
const NewSeenEarly = MakerSeenEarly as unknown as new (kind: number) => BaseSeenEarly;
{
  const first = new NewSeenEarly(1) as OneSeenEarly;
  first.one = "a";
  lines.push("SeenEarly: " + seenEarly.join() + " | " + readSeenEarly(first));
}

// The maker stores the tag on one way only, and its prototype has the other tag.
interface BaseStoredSometimes { kind: number }
interface OneStoredSometimes extends BaseStoredSometimes { kind: 1; one: string }
interface TwoStoredSometimes extends BaseStoredSometimes { kind: 2; two: number; more: number }
function MakerStoredSometimes(this: BaseStoredSometimes, kind: number, stores: boolean) {
  if (stores) this.kind = kind;
}
MakerStoredSometimes.prototype.kind = 2;
const NewStoredSometimes = MakerStoredSometimes as unknown as new (kind: number, stores: boolean) => BaseStoredSometimes;
////= lines	readStoredSometimes	OneStoredSometimes	TwoStoredSometimes
{
  const first = new NewStoredSometimes(1, false) as OneStoredSometimes;
  first.one = "a";
  const second = new NewStoredSometimes(1, true) as OneStoredSometimes;
  second.one = "b";
  lines.push("StoredSometimes: " + readStoredSometimes(first) + " | " + readStoredSometimes(second));
}

// The maker stores into its object under another name too.
interface BaseOtherName { kind: number }
interface OneOtherName extends BaseOtherName { kind: 1; one: string }
interface TwoOtherName extends BaseOtherName { kind: 2; two: number; more: number }
function MakerOtherName(this: BaseOtherName, kind: number, other: BaseOtherName | undefined) {
  this.kind = kind;
  const target = other === undefined ? this : other;
  target.kind = 2;
}
const NewOtherName = MakerOtherName as unknown as new (kind: number, other: BaseOtherName | undefined) => BaseOtherName;
////= lines	readOtherName	OneOtherName	TwoOtherName
{
  const first = new NewOtherName(1, undefined) as OneOtherName;
  first.one = "a";
  lines.push("OtherName: " + readOtherName(first));
}

// Another function is new.target, so the maker fills an object that it has not allocated by the tag.
interface BaseOtherTarget { kind: number }
interface OneOtherTarget extends BaseOtherTarget { kind: 1; one: string }
interface TwoOtherTarget extends BaseOtherTarget { kind: 2; two: number; more: number }
function MakerOtherTarget(this: BaseOtherTarget, kind: number) { this.kind = kind; }
function OtherTarget() {}
const NewOtherTarget = MakerOtherTarget as unknown as new (kind: number) => BaseOtherTarget;
////= lines	readOtherTarget	OneOtherTarget	TwoOtherTarget
{
  const first = Reflect.construct(MakerOtherTarget, [1], OtherTarget) as OneOtherTarget;
  first.one = "a";
  const second = new NewOtherTarget(2) as TwoOtherTarget;
  second.two = 5;
  second.more = 6;
  lines.push("OtherTarget: " + readOtherTarget(first) + " | " + readOtherTarget(second) + " | " + (first instanceof OtherTarget));
}

// Zero and minus zero take one case of a switch. A tag that no type writes has no layout of its own.
interface BaseZero { kind: number }
interface OneZero extends BaseZero { kind: 0; one: string }
interface TwoZero extends BaseZero { kind: 2; two: number; more: number }
function MakerZero(this: BaseZero, kind: number) { this.kind = kind; }
const NewZero = MakerZero as unknown as new (kind: number) => BaseZero;
function readZero(e: OneZero | TwoZero): string {
  if (Object.is(e.kind, -0)) return "minus zero " + (e as OneZero).one;
  if (e.kind === 0) return "zero " + e.one;
  return "two " + e.two + " " + e.more;
}
{
  const first = new NewZero(-0) as OneZero;
  first.one = "a";
  const second = new NewZero(0) as OneZero;
  second.one = "b";
  const third = new NewZero(7) as unknown as TwoZero;
  third.two = 5;
  third.more = 6;
  lines.push("Zero: " + readZero(first) + " | " + readZero(second) + " | " + readZero(third));
}

console.log(lines.join("\n"));
//// three-levels-of-classes-a-level-is-skipped.js
function probe(label, run) { let text; try { const v = run(); text = typeof v === "string" ? JSON.stringify(v) : typeof v === "object" && v !== null ? JSON.stringify(v) : String(v); } catch (e) { text = "threw " + e.constructor.name; } console.log(label + " " + text); }
class A { #p = 7.5; constructor(seed) { this.n = seed + 0.5; this.i = seed | 0; } sum() { return this.n + this.i; } getP() { return this.#p; } }
class M extends A { #m = 1.5; w = 4.5; constructor(seed) { super(seed); this.s = "s" + seed; this.o = { k: seed }; } len() { return this.s.length; } deep() { return this.o.k; } getM() { return this.#m; } }
class S extends A { #z = 2.5; u = "sibling"; constructor(seed) { super(seed); this.r = seed * 2 + 0.5; } getZ() { return this.#z; } }
class B extends M { #y = 3.5; x = 1.25; constructor(seed) { super(seed); this.t = "t" + seed; this.q = { z: seed }; } more() { return this.x + this.n; } wide() { return this.t.length + this.s.length; } under() { return this.q.z + this.o.k + this.w; } getY() { return this.#y; } }
function hot(v) { return v.n * 2 + v.i + v.s.length + v.o.k + v.w + v.x + v.t.length + v.q.z + v.sum() + v.len() + v.deep() + v.more() + v.wide() + v.under() + v.getP() + v.getM() + v.getY(); }
////= readAll-2
const honest = [new B(1), new B(2)]; let warm = 0; for (let turn = 0; turn < 300; turn++) for (const each of honest) warm += hot(each); console.log("warm " + warm); new S(1); new M(1);
Object.setPrototypeOf(B, A); readAll("a level is skipped", new B(3)); Object.setPrototypeOf(B, M);
readAll("honest", honest[0]); readAll("fresh", new B(6));
