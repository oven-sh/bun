//// a-required-field-that-one-of-two-literals-leaves-out-is-returned-through-two-functions.ts
// Two literals make objects of one type. One leaves a required field out, and its objects never come to the function without a written result type that returns the field to a caller with one.
interface LeafA { kind: "a"; x: number }
interface LeafB { kind: "b"; y: number }
type Leaf = LeafA | LeafB;
interface Holder { id: number; leaf: Leaf }
function makeFull(id: number): Holder {
  return { id, leaf: id % 2 ? { kind: "a", x: id } : { kind: "b", y: id } };
}
function makeBare(id: number): Holder {
  return { id } as Holder;
}
function inner(holder: Holder) { return holder.leaf; }
function leafOf(holder: Holder, depth = 3): Leaf {
  if (depth > 0) return leafOf(holder, depth - 1);
  return inner(holder);
}
const full: Holder[] = [];
const bare: Holder[] = [];
////= for-11
let total = 0;
////= for-9
for (const holder of bare) total += holder.id;
console.log(total, [leafOf].map(read => read(full[3]).kind).join());
//// a-test-of-a-tag-narrows-its-object.js
// The same without types, with string tags, a getter in the way, a tag that changes and an object without the tag.
function make(type, value) { return { type, value } }
function visit(node, out) {
  if (node.type === "number") { node.seenAsNumber = true; out.push(node.value + 1) }
  else if (node.type === "text") { node.seenAsText = true; out.push(node.value.length) }
  else { node.seenAsOther = true; out.push(-1) }
}
const computed = { get type() { return this.flip ? "number" : "text" }, flip: false, value: "four" };
const changing = make("text", "ab");
const bare = { value: 0 };
const all = [make("number", 1), make("text", "abc"), make("list", []), computed, changing, bare];
const out = [];
for (const node of all) visit(node, out);
computed.flip = true; computed.value = 41;
changing.type = "number"; changing.value = 6;
for (const node of all) visit(node, out);
console.log(out.join(), all.map(node => Object.keys(node).join("+")).join(" "));
//// a-typed-literal-stands-above-what-object-create-makes-while-it-changes.ts
// A literal whose members the checker knows is handed to Object.create, is used by itself too, and changes meanwhile: every read below it sees the change.
const lines: string[] = [];
function say(label: string, value: unknown): void {
  lines.push(label + ": " + (typeof value === "string" ? value : JSON.stringify(value)));
}

const animal = {
  legs: 4,
  name: "animal",
  describe(): string {
    return this.name + " on " + this.legs;
  },
  get twice(): number {
    return this.legs * 2;
  },
  set twice(n: number) {
    this.legs = n / 2;
  },
};
type Animal = typeof animal;

function make(i: number): Animal {
  const made: Animal = Object.create(animal);
  if (i & 1) made.legs = i;
  return made;
}

function useBelow(i: number): string {
  const made = make(i);
  const before = made.describe() + "|" + made.twice;
  made.twice = 12;
  return before + "|" + made.legs + "|" + Object.keys(made).join() + "|" + ("name" in made) + "|" + Object.hasOwn(made, "name");
}

function useItself(): string {
  return animal.describe() + "|" + animal.twice + "|" + Object.keys(animal).join() + "|" + JSON.stringify(animal);
}

function walk(o: object): string {
  let names = "";
  for (const name in o) names += name + ";";
  return names;
}

// Functions whose parameter has the type of the literal, and that are only ever handed the literal.
function keysOf(v: Animal): string {
  let legs = 0;
  let others = "";
  for (const key of Object.keys(v)) {
    if (key === "legs") legs++;
    else others += key + ";";
  }
  return legs + ":" + others;
}
function legsOf(v: Animal): string {
  return typeof v.legs + " " + (v.legs + 1);
}
function nameOf(v: Animal): string {
  return typeof v.name + " " + v.name.length;
}
function looks(v: Animal): string {
  return [keysOf(v), legsOf(v), nameOf(v), Object.values(v).map(each => typeof each).join(), JSON.stringify(v), "legs" in v, Object.hasOwn(v, "twice")].join(" | ");
}
let seen = "";
for (let turn = 0; turn < 60; turn++) seen = looks(animal);
say("the literal under its own type", seen);

for (let i = 0; i < 30; i++) {
  const below = useBelow(i);
  const itself = useItself();
  if (i < 3 || i === 29) {
    say(i + " below", below);
    say(i + " itself", itself);
    say(i + " walk", walk(make(i)));
  }
}

animal.legs = 6;
say("legs stored above: below", useBelow(2));
say("legs stored above: itself", useItself());

animal.describe = function (this: Animal): string {
  return "replaced " + this.name;
};
say("method replaced: below", useBelow(2));
say("method replaced: itself", useItself());

Object.defineProperty(animal, "twice", {
  get(this: Animal): number {
    return this.legs * 3;
  },
  configurable: true,
  enumerable: false,
});
////= say	"getter redefined: below"	3
say("getter redefined: itself", useItself());

Object.defineProperty(animal, "legs", { value: 8, writable: false, configurable: true, enumerable: true });
////= say	"legs read-only above"	5
Object.defineProperty(animal, "legs", { value: 8, writable: true, configurable: true, enumerable: true });

delete (animal as Partial<Animal>).name;
////= say	"name deleted above: below"	4
say("name deleted above: itself", useItself());

(animal as Animal & { added?: number }).added = 1;
say("name added above: walk", walk(make(1)));

Object.setPrototypeOf(animal, { name: "from higher up", higher: true });
say("another object above the literal: below", make(0).name + "|" + walk(make(1)));

const other = { legs: 2, name: "bird", describe: animal.describe, twice: 0 };
function makeBelow(above: Animal, i: number): string {
  const made: Animal = Object.create(above);
  made.legs += i;
  return made.describe() + "|" + made.legs + "|" + (Object.getPrototypeOf(made) === above);
}
for (let i = 0; i < 6; i++) say("two literals in turn " + i, makeBelow(i & 1 ? other : animal, i));

Object.assign(animal, { legs: "many", extra: 1, 0: "zero" });
say("written into by a built-in", (() => {
  try {
    return looks(animal) + " || " + walk(make(0));
  } catch (error) {
    return (error as Error).constructor.name;
  }
})());
Object.assign(animal, { legs: 8 });

Object.freeze(animal);
say("frozen above", (() => {
  "use strict";
  try {
    const made = make(0);
    made.legs = 1;
    return "stored " + made.legs;
  } catch (error) {
    return (error as Error).constructor.name;
  }
})());

const counters = {
  count: 0,
  bump(): number {
    return ++this.count;
  },
};
function bumpBelow(i: number): number {
  const made: typeof counters = Object.create(counters);
  made.bump();
  if (i % 3 === 0) counters.bump();
  return made.bump() * 100 + counters.count;
}
let sum = 0;
for (let i = 0; i < 50; i++) sum += bumpBelow(i);
say("a counter above and below", sum + "|" + counters.count);

console.log(lines.join("\n"));
//// a-typed-literal-with-a-setter-of-an-element-is-written-into-and-then-stands-above-a-created-object.ts
const said: string[] = [];
function attempt(f: () => unknown): string { try { return String(f()); } catch (e) { return "threw " + (e as Error).constructor.name; } }

const victim = { la: { qb: 3 }, lb: 4, set 0(value: unknown) { said.push("0 is given " + String(value)); } };
type Victim = typeof victim;
function keysOneByOne(v: Victim): string { let la = 0, lb = 0, length = 0, others = ""; for (const key of Object.keys(v)) { if (key === "la") la++; else if (key === "lb") lb++; else if (key === "length") length++; else others += "+" + key; } return [la, lb, length, others].join(); }
function keysInALoop(v: Victim): string { let text = ""; for (const key in v) text += key === "la" || key === "lb" ? "." : key + ";"; return text; }
function tableByKeys(v: Victim): string { const table: Record<string, number> = { la: 1, lb: 2 }; return Object.keys(v).map(key => table[key]).join(); }
function ownNames(v: Victim): string { return Reflect.ownKeys(v).filter(name => name !== "la" && name !== "lb").map(String).join("+"); }
function values(v: Victim): string { return Object.values(v).map(each => typeof each).join(); }
function copied(v: Victim): string { return Object.keys({ ...v }).join("+"); }
function written(v: Victim): string { return JSON.stringify(v) ?? "nothing"; }
function asked(v: Victim): string { return ["la" in v, "nw" in v, "length" in v, 0 in v, Object.hasOwn(v, "length"), Object.hasOwn(v, 0)].join(); }
function laOfIt(v: Victim): string { return typeof v.la + " " + attempt(() => v.la.qb); }
function lbOfIt(v: Victim): string { return typeof v.lb + " " + attempt(() => v.lb + 1); }
function elements(v: Victim): string { const any: any = v; return typeof any.length + " " + String(any.length) + " " + String(any[0]) + " " + String(any[1]); }
function looks(v: Victim): string {
  return ["keysOneByOne " + attempt(() => keysOneByOne(v)), "keysInALoop " + attempt(() => keysInALoop(v)), "tableByKeys " + attempt(() => tableByKeys(v)), "ownNames " + attempt(() => ownNames(v)), "values " + attempt(() => values(v)), "copied " + attempt(() => copied(v)), "written " + attempt(() => written(v)), "asked " + attempt(() => asked(v)), "laOfIt " + attempt(() => laOfIt(v)), "lbOfIt " + attempt(() => lbOfIt(v)), "elements " + attempt(() => elements(v))].join("\n");
}
function road(): unknown { return Object.assign(victim, { la: "text", lb: { qb: 9 }, length: "long", 0: "zero", nw: 1 }); }
let before = "";
for (let turn = 0; turn < 60; turn++) before = looks(victim);
console.log(before);
console.log("road", attempt(() => { const answer = road(); return answer === victim ? "the object" : Array.isArray(answer) ? "[" + answer.join() + "]" : typeof answer; }));
console.log(looks(victim));
console.log("said", said.join("; "));
const heir = Object.create(victim); console.log(Object.keys(heir).length, typeof heir.lb, Object.getPrototypeOf(heir) === victim);
export {};
//// absent-field-after-prototype-change.ts
// Reads of an absent field stay correct as prototypes gain, lose and replace a property of that name.
const host = globalThis as any;
const collect = (full: boolean) => (host.Bun ? host.Bun.gc(full) : full ? host.fullGC() : host.edenGC());

interface P {
  a: number;
  b?: number;
}
interface HasX {
  x?: number;
}
interface HasToString {
  a: number;
  toString?: () => string;
}
class C {
  x?: number;
}
class DeclaredOnly {
  declare x?: number;
}

const objectCount = 10000;

function createRecord(a: number): P {
  return { a };
}
function createRecordWithPrototype(prototype: object | null, a: number): P {
  const record: any = createRecord(a);
  Object.setPrototypeOf(record, prototype);
  return record;
}
function readB(o: P): number | undefined {
  return o.b;
}
function readX(o: HasX): number | undefined {
  return o.x;
}
function readUntyped(o: any, name: string): unknown {
  return name === "b" ? o.b : o.x;
}
function summarizeRecords(records: P[]): string {
  const seen = new Set<string>();
  for (const record of records) seen.add(`${readB(record)} ${readUntyped(record, "b")} ${"b" in record}`);
  return [...seen].join(" | ");
}
function summarizeInstances(instances: HasX[]): string {
  const seen = new Set<string>();
  for (const instance of instances) seen.add(`${readX(instance)} ${readUntyped(instance, "x")} ${"x" in instance}`);
  return [...seen].join(" | ");
}

function changeRecordPrototype(label: string, holder: any, first: object) {
  const records: P[] = [];
  for (let i = 0; i < objectCount; i++) records.push(createRecordWithPrototype(first, i));
  console.log(label, "absent:", summarizeRecords(records));
  holder.other = 1;
  console.log(label, "other name:", summarizeRecords(records));
  holder.b = 7;
  records.push(createRecordWithPrototype(first, -1));
  console.log(label, "added:", summarizeRecords(records));
  delete holder.b;
  records.push(createRecordWithPrototype(first, -2));
  console.log(label, "deleted:", summarizeRecords(records));
  Object.setPrototypeOf(holder, { b: 8 });
  records.push(createRecordWithPrototype(first, -3));
  console.log(label, "replaced:", summarizeRecords(records));
}

function changeInstancePrototype(label: string, holder: any, value: number, create: () => HasX) {
  const instances: HasX[] = [];
  for (let i = 0; i < 100; i++) instances.push(create());
  console.log(label, "before:", summarizeInstances(instances));
  holder.x = value;
  instances.push(create());
  console.log(label, "added:", summarizeInstances(instances));
  delete holder.x;
  instances.push(create());
  console.log(label, "deleted:", summarizeInstances(instances));
  Object.setPrototypeOf(holder, { x: 8 });
  instances.push(create());
  console.log(label, "replaced:", summarizeInstances(instances));
}

function changeChain(depth: number) {
  const last: any = {};
  let first: any = last;
  for (let i = 1; i < depth; i++) first = Object.create(first);
  changeRecordPrototype(`chain of ${depth}`, last, first);
}

function changeClass(label: string, base: new () => HasX) {
  const Derived: any = new Function("Base", "return class D extends Base {}")(base);
  changeInstancePrototype(`${label} derived`, Derived.prototype, 1, () => new Derived());

  function F(this: any) {}
  F.prototype = { x: 2 };
  changeInstancePrototype(`${label} new target`, F.prototype, 3, () => Reflect.construct(base, [], F));
}

function readInheritedToString() {
  const o: HasToString = { a: 1 };
  const untypedRecord: any = { a: 2 };
  const withHelperPrototype: HasToString = untypedRecord;
  Object.setPrototypeOf(withHelperPrototype, { helper() {} });
  const withoutPrototype: HasToString = { a: 3 };
  Object.setPrototypeOf(withoutPrototype, null);
  console.log(o.toString === Object.prototype.toString, withHelperPrototype.toString === Object.prototype.toString, withoutPrototype.toString);
}

function changeEveryPrototype() {
  const prototype = { helper() {} };
  changeRecordPrototype("record", prototype, prototype);
  changeClass("class", C);
  changeClass("declared", DeclaredOnly);
  changeChain(8);
  changeChain(9);
  readInheritedToString();
}

changeEveryPrototype();
collect(true);
changeEveryPrototype();
console.log(createRecordWithPrototype(null, 1).b, createRecord(2).b);
//// accessors-and-key-order.js
// Getters and setters in object literals and classes: their position in the key order, and the names of functions with computed keys. A second getter of the same name keeps the place of the first, as ECMAScript says; in plain Bun it moves to the end.
const lines = [];
function say(label, value) {
  lines.push(label + ": " + value);
}
function keyText(key) {
  return typeof key === "symbol" ? key.toString() : JSON.stringify(key);
}
function flagsOf(descriptor) {
  return (descriptor.writable ? "w" : "-") + (descriptor.enumerable ? "e" : "-") + (descriptor.configurable ? "c" : "-");
}
function describeKey(object, key) {
  const descriptor = Reflect.getOwnPropertyDescriptor(object, key);
  const body = "value" in descriptor ? (typeof descriptor.value === "function" ? "function" : String(descriptor.value)) : (descriptor.get ? "get" : "") + (descriptor.set ? "set" : "");
  return keyText(key) + " " + flagsOf(descriptor) + " " + body;
}
function describe(object) {
  return Reflect.ownKeys(object)
    .map(key => describeKey(object, key))
    .join(", ");
}
////= lines-22	keysInLoop	keys	key
function report(label, object) {
  say(label, [Object.keys(object).join(), keysInLoop(object), JSON.stringify(object), describe(object)].join(" | "));
}

const tag = Symbol("tag");

function pair(i) {
  return { a: i, get b() { return this.a + 1; }, c: i + 2, set b(value) { this.a = value; } };
}
report("a getter and its setter around a value", pair(1));
const stored = pair(1);
stored.b = 10;
report("after the setter ran", stored);

function five(i) {
  return {
    start: i,
    get one() { return this.start + 1; },
    get two() { return this.start + 2; },
    middle: i * 2,
    set three(value) { this.start = value; },
    get four() { return this.start + 4; },
    get five() { return this.start + 5; },
    end: i * 3,
  };
}
report("five accessors in one literal", five(1));

report("only accessors", { get a() { return 1; }, set b(value) {}, get c() { return 3; } });
report("a value after a getter of the same name", { first: 0, get a() { return "getter"; }, between: 1, a: "value", last: 2 });
report("a getter after a value of the same name", { first: 0, a: "value", between: 1, get a() { return "getter"; }, last: 2 });
report("a setter, a value, a getter", { set a(value) {}, b: 0, a: "value", c: 1, get a() { return "getter"; } });
report("two getters of the same name", { get a() { return "first"; }, b: 0, get a() { return "second"; } });
report("the setter first", { set a(value) {}, b: 0, get a() { return "getter"; } });
report("a method after an accessor of the same name", { get a() { return "getter"; }, b: 0, a() {} });
report("indexes, numbers, strings and a symbol as names", {
  z: 0,
  get 1() { return "one"; },
  get 0() { return "zero"; },
  get 1.5() { return "one and a half"; },
  get "quoted name"() { return "quoted"; },
  get [tag]() { return "symbol"; },
  a: 1,
});
const namedProto = { get __proto__() { return "own"; }, a: 1 };
report("an accessor named __proto__", namedProto);
say("the prototype is unchanged", Object.getPrototypeOf(namedProto) === Object.prototype);

function computed(key, i) {
  return { a: i, get [key]() { return "got " + i; }, b: i + 1, set [key](value) { this.received = value; }, c: i + 2 };
}
for (const key of ["k", "a", "c", 0, "0", tag, "__proto__"]) report("computed accessors, " + keyText(key), computed(key, 1));

const first = { x: 1, middle: "from the first spread" };
const second = { y: 2, middle: "from the second spread" };
report("a getter between spreads", { ...first, get middle() { return "getter"; }, ...{ y: 2 }, z: 3 });
report("a spread over a getter", { get middle() { return "getter"; }, ...second, z: 3 });
report("a setter after a spread over a getter", { get middle() { return "getter"; }, ...second, set middle(value) {} });
report("a getter and a setter with a spread between them", { get middle() { return "getter"; }, ...{ y: 2 }, set middle(value) {} });
report("a spread of an object with accessors", { before: 0, ...pair(1), after: 1 });

const names = ["k", "longer name", "a"];
const orders = new Set();
let total = 0;
for (let i = 0; i < 100; i++) {
  const wide = five(i);
  wide.three = i + 1;
  const narrow = pair(i);
  narrow.b = i * 2;
  const keyed = computed(names[i % names.length], i);
  total += wide.one + wide.two + wide.four + wide.five + wide.middle + wide.end + narrow.b + narrow.c + keyed[names[i % names.length]].length + keyed.b;
  orders.add([Object.keys(wide).join(), Object.keys(narrow).join(), Object.keys(keyed).join()].join(" ; "));
}
say("100 of each", total + " | " + [...orders].join(" / "));

const removed = pair(1);
delete removed.b;
removed.b = "again";
report("an accessor deleted and its name assigned", removed);
const extended = pair(1);
extended.d = 4;
Object.defineProperty(extended, "e", { get() { return 5; }, enumerable: true });
Object.defineProperty(extended, "b", { enumerable: false });
report("properties added after the literal, and the accessor changed to non-enumerable", extended);
report("frozen", Object.freeze(pair(1)));

class Shape {
  constructor(side) {
    this.side = side;
  }
  get area() {
    return this.side * this.side;
  }
  set area(value) {
    this.side = Math.sqrt(value);
  }
  get [tag]() {
    return "tagged";
  }
  set ["comp" + "uted"](value) {
    this.side = value;
  }
  static get unit() {
    return new Shape(1);
  }
  static set ["comp" + "uted"](value) {}
}
say("accessors of a class", describe(Shape.prototype) + " | " + describeKey(Shape, "unit") + ", " + describeKey(Shape, "computed"));
const shape = new Shape(2);
shape.area = 9;
shape.computed = shape.side + 1;
report("an instance of it", shape);
say("its inherited accessors", [shape.area, shape[tag], Shape.unit.area].join());

function nameOf(callable) {
  const descriptor = Reflect.getOwnPropertyDescriptor(callable, "name");
  if (!descriptor) return "no own name";
  if (!("value" in descriptor)) return flagsOf(descriptor) + " an accessor that returns " + JSON.stringify(callable.name);
  return flagsOf(descriptor) + " " + (typeof descriptor.value === "function" ? "a method" : JSON.stringify(descriptor.value));
}
function namesOfAccessor(object, key) {
  const descriptor = Reflect.getOwnPropertyDescriptor(object, key);
  return (descriptor.get ? nameOf(descriptor.get) : "no getter") + ", " + (descriptor.set ? nameOf(descriptor.set) : "no setter");
}

const key = "computed";
const described = Symbol("description");
const functions = {
  [key + "Method"]() {},
  async [key + "Async"]() {},
  *[key + "Generator"]() {},
  async *[key + "AsyncGenerator"]() {},
  [key + "Arrow"]: () => {},
  [key + "Function"]: function () {},
  [key + "Class"]: class {},
  [key + "NamedFunction"]: function own() {},
  [key + "NamedClass"]: class Own {},
  [key + " with spaces"]: () => {},
  [""]: function () {},
  [1 + 1]() {},
  [1.5]: function () {},
  [described]() {},
  [Symbol("arrow description")]: () => {},
  [Symbol("class description")]: class {},
  [Symbol("")]() {},
  [Symbol()]() {},
  [Symbol.iterator]() {},
};
for (const name of Reflect.ownKeys(functions)) say("the function under " + keyText(name), nameOf(functions[name]));

const accessors = {
  get [key + "Getter"]() { return 1; },
  set [key + "Setter"](value) {},
  get [key + "Both"]() { return 1; },
  set [key + "Both"](value) {},
  get [described]() { return 1; },
  set [described](value) {},
  get [Symbol()]() { return 1; },
  get [3]() { return 1; },
};
for (const name of Reflect.ownKeys(accessors)) say("the accessor under " + keyText(name), namesOfAccessor(accessors, name));

const classes = {
  [key + "StaticMethod"]: class { static name() {} },
  [key + "StaticGetter"]: class { static get name() { return "from the getter"; } },
  [key + "StaticField"]: class { static name = "from the field"; },
  [key + "StaticComputedField"]: class { static ["na" + "me"] = "from the computed field"; },
  [key + "StaticComputedMethod"]: class { static ["na" + "me"]() {} },
  [key + "OtherStatics"]: class { static label = "label"; static length = 5; },
  [key + "Derived"]: class extends Shape {},
};
for (const name of Reflect.ownKeys(classes)) say("the class under " + keyText(name), nameOf(classes[name]));

class Members {
  [key + "Method"]() {}
  static [key + "Static"]() {}
  get [key + "Getter"]() { return 1; }
  static set [key + "Setter"](value) {}
  [described]() {}
  [key + "Field"] = () => {};
  [key + "FunctionField"] = function () {};
  [key + "ClassField"] = class {};
  [key + "NamedField"] = function own() {};
  [Symbol.for("field description")] = () => {};
  static [key + "StaticField"] = () => {};
  plainField = () => {};
}
const members = new Members();
say("members of a class with computed names", [
  nameOf(Members.prototype[key + "Method"]),
  nameOf(Members[key + "Static"]),
  namesOfAccessor(Members.prototype, key + "Getter"),
  namesOfAccessor(Members, key + "Setter"),
  nameOf(Members.prototype[described]),
  nameOf(members[key + "Field"]),
  nameOf(members[key + "FunctionField"]),
  nameOf(members[key + "ClassField"]),
  nameOf(members[key + "NamedField"]),
  nameOf(members[Symbol.for("field description")]),
  nameOf(Members[key + "StaticField"]),
  nameOf(members.plainField),
].join(" | "));

function methodUnder(name) {
  return { [name]() {} }[name];
}
function getterUnder(name) {
  return Reflect.getOwnPropertyDescriptor({ get [name]() { return 1; } }, name).get;
}
function arrowUnder(name) {
  return { [name]: () => {} }[name];
}
function classUnder(name) {
  return { [name]: class {} }[name];
}
for (const [label, create] of [["method", methodUnder], ["getter", getterUnder], ["arrow function", arrowUnder], ["class", classUnder]]) {
  const created = [];
  for (let i = 0; i < 100; i++) created.push(create(i % 10 ? "n" + (i % 10) : described));
  say("100 closures of one " + label, [...new Set(created.map(callable => callable.name))].join() + " | " + created[0].name + " " + created[1].name + " " + created[99].name);
}

report("no accessors", { a: 1, b: 2, c: 3 });
report("no accessors, a computed key", { a: 1, ["b"]: 2, c: 3 });
report("no accessors, a method", { a: 1, b() {}, c: 3 });
const written = { method() {}, arrow: () => {}, expression: function () {}, named: function own() {}, "quoted name"() {}, 7() {}, get getter() { return 1; }, set setter(value) {} };
say("names that are not computed", ["method", "arrow", "expression", "named", "quoted name", "7"].map(name => nameOf(written[name])).join(" | ") + " | " + namesOfAccessor(written, "getter") + " | " + namesOfAccessor(written, "setter"));

