{
  const make = () => new «1»;
  const all = (o, other, i) => {
    const parts = [o.value];
    o.value = i;
    parts.push(o.inner);
    o.value = i + 1;
    parts.push(o.value);
    const before = o.value;
    o.value = before + 2;
    parts.push(before, o.value += 3, o.value++ + ++o.value, o.value ??= 4, o.value ||= 5);
    ({ n: o.value } = { n: i });
    [o.value] = [o.value + 1];
    parts.push(o.value, o.value = other.value = i, o.inner, o.log, other.inner);
    return parts.join();
