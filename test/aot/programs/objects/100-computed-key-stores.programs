show({ a: 1, "1.5": 8, d: 10 });
show({ a: 1, NaN: 8, d: 10 });
show({ a: 1, Infinity: 8, d: 10 });
show({ a: 1, "-0": 8, d: 10 });
show({ a: 1, "1e21": 8, d: 10 });
show({ a: 1, "4294967295": 8, d: 10 });
show({ a: 1, "4294967294": 8, d: 10 });
const late = { a: 1 };
late["-1"] = 8;
late.d = 10;
show(late);
