console.log(has(q), own(q), keys(q), typeof q.action, JSON.stringify(q));
const r = fresh();
delete (r as Partial<Part>).action;
console.log(has(r), own(r), keys(r), typeof r.action, JSON.stringify(r));
//// a-member-of-what-object-create-made-is-read-twice-over-where-a-class-is-declared.ts
// An object made by Object.create() stands where a class is declared, and a member is read from it through `any`, twice over. The field of the literal below it holds integers or nothing, while the read expects no more than a number.
class Bag {
  list: number[];
  a: number;
  constructor(list: number[]) {
    this.list = list;
    this.a = list[0];
  }
  sum(): number {
    return this.list.length;
  }
}

function show(value: any, depth: number = 0): string {
  if (value === null) return "null";
  if (typeof value === "object") {
    if (depth > 3) return "{..}";
    let text = "{";
    for (const key of Object.keys(value)) text += key + ":" + show(value[key], depth + 1) + ",";
    return text + "}";
  }
  return typeof value + ":" + String(value);
}

let last = "";

// @ts-ignore
function readsDeep(n: number, bag: Bag = Object.create({ a: n, sum() { return 5; } })) { return (bag as any)?.a?.a; }
function mainReadsDeep(n: number) { return readsDeep(n, n % 10 === 7 ? Object.create({ a: n, sum() { return 5; } }) : undefined); }
function attemptReadsDeep(n: number) { try { return show(mainReadsDeep(n)); } catch (error) { return "threw " + (error as Error).name; } }
for (let n = 0; n < 1000; n++) { last = attemptReadsDeep(n); if (n < 12 || n === 27) console.log("reads deep", n, last); }

// Nothing declares the function.
// @ts-ignore
function mainHandsOn(n: number) { return declaredNowhere(n, n % 10 === 7 ? Object.create({ a: n, sum() { return 5; } }) : undefined); }
function attemptHandsOn(n: number) { try { return show(mainHandsOn(n)); } catch (error) { return "threw " + (error as Error).name; } }
for (let n = 0; n < 1000; n++) { last = attemptHandsOn(n); if (n < 12 || n === 27) console.log("hands on", n, last); }

// @ts-ignore
function spreadsAndAdds(n: number, bag: Bag = Object.create({ a: n, sum() { return 5; } })) { return { ...bag, c: n }; }
function mainSpreadsAndAdds(n: number) { return spreadsAndAdds(n, n % 10 === 7 ? Object.create({ a: n, sum() { return 5; } }) : undefined); }
function attemptSpreadsAndAdds(n: number) { try { return show(mainSpreadsAndAdds(n)); } catch (error) { return "threw " + (error as Error).name; } }
for (let n = 0; n < 1000; n++) { last = attemptSpreadsAndAdds(n); if (n < 12 || n === 27) console.log("spreads and adds", n, last); }
console.log(last);
//// a-member-over-its-object-made-on-demand-is-asked-for-behind-reflect-set.ts
// The member captures the object it lies in, is stored behind the literal, and is only called: the closure is made on demand. Then something else than a function is put under the name.
interface Part { count: number; action?: () => number; }
function fresh(n: number): Part { const part: Part = { count: n }; part.action = () => part.count + 2; return part; }
function has(p: Part): boolean { return "action" in p; }
function own(p: Part): boolean { return Object.hasOwn(p, "action"); }
function call(p: Part): number { return p.action!(); }
function keys(p: Part): string { return Object.keys(p).join(); }
function kind(p: Part): string { return typeof p.action; }
function read(p: Part): unknown { return p.action; }
let sum = 0;
for (let i = 0; i < 2000; i++) { const p = fresh(i & 3); sum += call(p) + (has(p) ? 1 : 0) + (own(p) ? 1 : 0); }
const p = fresh(1);
Reflect.set(p, "action", 5);
console.log(sum, has(p), own(p), keys(p), kind(p), read(p), JSON.stringify(p), { ...p }.action, Object.entries(p).length);
const q = fresh(1);
Object.defineProperty(q, "action", { value: "text", enumerable: true, writable: true, configurable: true });
console.log(has(q), own(q), keys(q), kind(q), read(q), JSON.stringify(q));
const r = fresh(1);
delete r.action;
console.log(has(r), own(r), keys(r), kind(r), read(r), JSON.stringify(r));
const s = fresh(1);
Reflect.set(s, "action", undefined);
console.log(has(s), own(s), keys(s), kind(s), read(s), JSON.stringify(s));
//// a-method-of-a-literal-leaves-its-field-and-comes-back-in-a-validating-build.js
// The method of a literal is a field whose function object is made when somebody first reads it. Built-ins that are handed the key as a value nobody knows at the build
// take the property out of the field and put it back: an accessor, a value again, gone, there again. A validating build compares the object before and after each call.
const hide = new Function("value", "return value");
function make() {
  return { top: { size: 1, method() { return "the method"; } } };
}
const steps = {
  "a getter, another getter, a value": (object, key) => {
    Object.defineProperty(object, key, { get() { return () => "the first getter"; }, configurable: true });
    Object.defineProperty(object, key, { get() { return () => "the second getter"; }, configurable: true });
    Object.defineProperty(object, key, { value: () => "a value again", writable: true, configurable: true });
  },
  "a getter, a value that is listed": (object, key) => {
    Object.defineProperty(object, key, { get() { return () => "a getter"; }, configurable: true, enumerable: true });
    Object.defineProperty(object, key, { value: () => "a value again", writable: true, configurable: true, enumerable: true });
  },
  "another value": (object, key) => {
    Object.defineProperty(object, key, { value: () => "another value" });
  },
  "deleted": (object, key) => {
    Reflect.deleteProperty(object, key);
  },
  "deleted and defined again": (object, key) => {
    Reflect.deleteProperty(object, key);
    Reflect.defineProperty(object, key, { value: () => "defined again", writable: true, configurable: true, enumerable: true });
  },
  "deleted and set again": (object, key) => {
    Reflect.deleteProperty(object, key);
    Reflect.set(object, key, () => "set again");
  },
  "set": (object, key) => {
    Reflect.set(object, key, () => "set");
  },
  "assigned": (object, key) => {
    Object.assign(object, { [key]: () => "assigned" });
  },
  "a getter by defineProperties, then assigned over": (object, key) => {
    Object.defineProperties(object, { [key]: { get() { return () => "a getter"; }, set(value) {}, configurable: true } });
    Object.assign(object, { [key]: () => "never kept" });
  },
  "read-only and hidden": (object, key) => {
    Object.defineProperty(object, key, { writable: false, enumerable: false });
  },
  "frozen": (object, key) => {
    Object.freeze(object);
  },
  "only looked at": (object, key) => {
    Object.getOwnPropertyDescriptor(object, key);
    Object.hasOwn(object, key);
  },
};
for (const readFirst of [false, true]) {
  for (const [where, key] of [["top", "method"]]) {
    for (const [name, step] of Object.entries(steps)) {
      const chain = hide(make());
      if (readFirst) chain[where][key]();
      step(chain[where], key);
      const object = chain.top;
      const descriptor = Object.getOwnPropertyDescriptor(object, "method");
      console.log((readFirst ? "read first, " : "") + name + ": " + (typeof object.method === "function" ? object.method() : typeof object.method) + " | " + Object.keys(object).join() + " | " + (descriptor ? Object.keys(descriptor).filter(word => descriptor[word] === true).join() : "no descriptor"));
    }
  }
}
//// a-name-of-an-object-filled-by-key-is-defined-anew-and-more-names-follow-across-collections.js
// Objects are filled by key. One of the names an object already has is defined anew with other attributes, more names are stored by key behind that,
// a collection runs, and then the object is asked for everything it was given.
const later = ["north", "east", "south", "west", "up", "down"];
const sizes = [0, 1, 2, 3, 5, 6, 7, 10, 30, 63, 64, 65, 70, 130, 300, 600];
////= descriptors

function fill(object, count) {
  for (let i = 0; i < count; i++) object["member" + i] = i;
}

function check(object, count, changed, added, isListed) {
  let wrong = 0;
  for (let i = 0; i < count; i++) if (object["member" + i] !== i) wrong++;
  if (object[changed] !== 5) wrong++;
  for (let i = 0; i < added.length; i++) {
    if (object[added[i]] !== 100 + i) wrong++;
    if (!Object.hasOwn(object, added[i])) wrong++;
    if (!(added[i] in object)) wrong++;
  }
  const names = Object.getOwnPropertyNames(object);
  if (names.length !== count + 1 + added.length) wrong++;
  if (names[count] !== changed) wrong++;
  for (let i = 0; i < added.length; i++) if (names[count + 1 + i] !== added[i]) wrong++;
  if (Object.keys(object).length !== names.length - (isListed ? 0 : 1)) wrong++;
  return wrong;
}

let wrong = 0;
let objects = 0;
for (let round = 0; round < 6; round++) {
  for (const count of sizes) {
    for (let kind = 0; kind < descriptors.length; kind++) {
      const object = {};
      fill(object, count);
      const changed = later[(round + kind) % later.length];
      object[changed] = 1;
      const descriptor = descriptors[kind]();
      Object.defineProperty(object, changed, descriptor);
      const added = [];
      for (let i = 1; i <= 1 + ((round + kind) % 4); i++) {
        const name = later[(round + kind + i) % later.length];
        object[name] = 100 + added.length;
        added.push(name);
      }
      if ((round + kind) % 3 === 0) Bun.gc(false);
      else if (count % 5 !== 1) Bun.gc(true);
      wrong += check(object, count, changed, added, descriptor.enumerable);

      const last = added.pop();
      if (!delete object[last] || last in object) wrong++;
      object["behind" + round] = 100 + added.length;
      added.push("behind" + round);
      if (kind === 2) Bun.gc(true);
      wrong += check(object, count, changed, added, descriptor.enumerable);
      objects++;
    }
  }
}
console.log("objects", objects, "wrong", wrong);
//// a-name-stored-by-key-behind-a-definition-answers-one-question-alone-behind-a-collection.js
// Objects are filled by key, one of the names an object already has is defined anew with other attributes, and one more name is stored by key behind that.
// Behind a collection each object is asked one question about that last name, and nothing else looks at its names.
////= descriptors

function fill(object, prefix, count) {
  for (let i = 0; i < count; i++) object[prefix + i] = i;
}
function readByKey(object, key) {
  return object[key] === 7;
}
function isIn(object, key) {
  return key in object;
}
function isOwn(object, key) {
  return Object.hasOwn(object, key);
}
////= lines-20	isOwnByMethod	object	object.hasOwnProperty
function isOwnByCall(object, key) {
  return Object.prototype.hasOwnProperty.call(object, key);
}
function isInByReflect(object, key) {
  return Reflect.has(object, key);
}

for (const question of [readByKey, isIn, isOwn, isOwnByMethod, isOwnByCall, isInByReflect]) {
  const names = [];
  for (const name of ["north", "east", "south", "west", "up", "down"]) names.push(name + "_" + question.name);
  const known = {};
  for (const name of names) known[name] = 1;
  let missing = 0;
  let asked = 0;
  for (let round = 0; round < 30; round++) {
    for (const count of [0, 1, 3, 8, 70]) {
      const object = {};
      fill(object, question.name, count);
      const changed = names[(round + 1) % names.length];
      object[changed] = 1;
      Object.defineProperty(object, changed, descriptors[round % descriptors.length]());
      object[names[round % names.length]] = 7;
      Bun.gc(round % 4 !== 3);
      asked++;
      if (!question(object, names[round % names.length])) missing++;
    }
  }
  console.log(question.name, "asked", asked, "missing", missing);
}
//// a-name-that-a-constructor-may-store-is-a-method-of-the-class-too.js
// A constructor stores `_read` only where its options name one, and the classes have a method of that name. The name is read and compared, read and called, on objects
// with the slot empty and filled, while the methods of the classes are replaced, hidden, deleted and turned into accessors, and the objects change their prototype.
const lines = [];

function Source(options) {
  this.count = 0;
  this.label = "source";
  if (options && typeof options.read === "function") this._read = options.read;
}
const baseRead = function baseRead(n) {
  this.count += n;
  return "base";
};
Source.prototype._read = baseRead;

function Request(options) {
  Source.call(this, options);
  this.label = "request";
}
Object.setPrototypeOf(Request.prototype, Source.prototype);
Object.setPrototypeOf(Request, Source);
const requestRead = function requestRead(n) {
  this.count += 2 * n;
  return "request";
};
Request.prototype._read = requestRead;

class Plain {
  constructor(options) {
    this.total = 0;
    if (options !== undefined && options.step !== undefined) this.step = options.step;
  }
  step(n) {
    this.total += n;
    return "class";
  }
}
const plainStep = Plain.prototype.step;

// What stands behind the comparison reads and stores more fields of the same object.
function isUntouched(request) {
  if (request._read !== requestRead) return "other:" + request.label;
  request.count += 1;
  request.label = request.label + "!";
  return "same:" + request.count + ":" + request.label.length;
}

function readAndCall(request, n) {
  const before = request.count;
  const answer = request._read(n);
  return answer + ":" + (request.count - before);
}

function stepOf(plain) {
  const step = plain.step;
  plain.total += 1;
  return (step === plainStep ? "same" : typeof step) + ":" + plain.total;
}

function round(title, objects) {
  const row = [];
  for (const object of objects) {
    if (object instanceof Plain) row.push(stepOf(object), object.step === undefined ? "none" : typeof object.step === "function" ? object.step(3) : String(object.step));
    else {
      let called;
      try {
        called = readAndCall(object, 5);
      } catch (error) {
        called = error.constructor.name;
      }
      row.push(isUntouched(object), called);
    }
  }
  lines.push(title + " " + row.join(" "));
}

const own = function ownRead(n) {
  this.count -= n;
  return "own";
};
function make() {
  return [
    new Request(),
    new Request({}),
    new Request({ read: own }),
    new Request({ read: requestRead }),
    new Source(),
    new Source({ read: own }),
    new Source({ read: baseRead }),
    new Plain(),
    new Plain({ step: 7 }),
    new Plain({ step: plainStep }),
    new Plain({ step: null }),
  ];
}

for (let i = 0; i < 40; i++) round("warm", make());
lines.length = 1;

let objects = make();
round("made", objects);

objects[0]._read = own;
objects[7].step = () => "arrow";
round("stored late", objects);

delete objects[0]._read;
delete objects[2]._read;
delete objects[7].step;
delete objects[8].step;
round("deleted", objects);

Object.defineProperty(objects[1], "_read", { get: () => own, configurable: true });
Object.defineProperty(objects[9], "step", { value: "fixed", writable: false, configurable: true });
round("defined", objects);

objects[3].extra = 1;
objects[4].other = 2;
objects[10].more = 3;
round("with more properties", objects);

objects = make();
Object.setPrototypeOf(objects[0], Source.prototype);
Object.setPrototypeOf(objects[1], { _read: own, __proto__: Request.prototype });
Object.setPrototypeOf(objects[7], null);
lines.push("no prototype " + String(objects[7].step));
objects[7] = new Plain();
round("other prototypes", objects);

objects = make();
Request.prototype._read = function replaced(n) {
  this.count += 3 * n;
  return "replaced";
};
round("replaced", objects);
round("replaced, new objects", make());

delete Request.prototype._read;
round("deleted above", make());

Object.defineProperty(Request.prototype, "_read", {
  get() {
    return this.label === "request" ? requestRead : own;
  },
  set(value) {
    Object.defineProperty(this, "_read", { value, writable: true, enumerable: true, configurable: true });
  },
  configurable: true,
});
round("accessor above", make());

Object.defineProperty(Request.prototype, "_read", { value: requestRead, writable: true, configurable: true });
round("put back", make());

Plain.prototype.step = 12;
round("a number above", make());
delete Plain.prototype.step;
round("nothing above", make());

console.log(lines.join("\n"));
//// a-number-listed-by-a-literal-is-read-from-the-object-it-made.ts
// An object that the function has just made lists a number, and the function reads it back: with nothing between, behind stores into other fields, behind a store of undefined, and behind code nobody has seen.
const outside: any = (globalThis as any)[process.argv[2] ?? "Array"];
type Late = { a?: number; flag?: boolean; p1?: number; p2?: number; p3?: number; p4?: number; p5?: number };

function behindOtherStores(c: number, v: number) {
  const o: Late = { a: v, flag: c > 1 };
  if (c & 1) o.p1 = 1;
  o.p1 = 2;
  if (c & 2) o.p2 = 1;
  o.p2 = 2;
  if (c & 4) o.p3 = 1;
  o.p3 = 2;
  if (c & 8) o.p4 = 1;
  o.p4 = 2;
  if (c & 16) o.p5 = 1;
  o.p5 = 2;
  return [o.a, o.flag, o.p1 + o.p2 + o.p3 + o.p4 + o.p5];
}
function undefinedOnOneWay(c: number, v: number) {
  const o: Late = { a: v };
  outside(c);
  if (c & 1) o.a = undefined;
  const read = o.a;
  outside(o);
  return [read, o.a];
}
function readThenUndefined(c: number, v: number) {
  const o: Late = { a: v };
  outside(c);
  const first = o.a;
  if (c & 1) o.a = undefined;
  const second = o.a;
  outside(o);
  return [first, second, o.a];
}
function undefinedListed(c: number, v: number) {
  const o: Late = { a: c & 1 ? undefined : v };
  const read = o.a;
  outside(o);
  return [read, o.a, "a" in o];
}
function changedByOthers(v: number, change: any) {
  const o: Late = { a: v };
  change(o);
  return [o.a, typeof o.a, "a" in o];
}

const changes = [(o: any) => {}, (o: any) => { o.a = "text"; }, (o: any) => { delete o.a; }, (o: any) => { o.a = undefined; }, (o: any) => { Object.defineProperty(o, "a", { get: () => 7 }); }];
const lines: string[] = [];
for (let turn = 0; turn < 200; turn++) {
  const row = [behindOtherStores(turn, turn), undefinedOnOneWay(turn, turn), readThenUndefined(turn, turn), undefinedListed(turn, turn), changedByOthers(turn, changes[turn < 150 ? 0 : turn % 5])];
  if (turn < 2 || turn > 194) lines.push(JSON.stringify(row));
}
console.log(lines.join("\n"));
//// a-required-field-that-one-of-two-literals-leaves-out-is-filled-on-demand-and-returned.ts
// Two literals make objects of one type. One leaves a required field out, and its objects never come to the function that fills the field where it is missing and returns it.
interface LeafA { kind: "a"; x: number }
interface LeafB { kind: "b"; y: number }
type Leaf = LeafA | LeafB;
interface Holder { id: number; leaf: Leaf }
function makeFull(id: number): Holder {
  return { id, leaf: id % 2 ? { kind: "a", x: id } : { kind: "b", y: id } };
}
function makeBare(id: number): Holder {
  return { id } as Holder;
}
function replace(holder: Holder) {
  holder.leaf = holder.id % 3 ? { kind: "a", x: 1 } : { kind: "b", y: 2 };
}
function leafOf(holder: Holder, depth = 3): Leaf {
  if (depth > 0) return leafOf(holder, depth - 1);
  holder.leaf ??= { kind: "b", y: 0 };
  return holder.leaf;
}
const full: Holder[] = [];
const bare: Holder[] = [];
////= for-11
let total = 0;
////= for-9
for (const holder of bare) total += holder.id;
for (const holder of full) replace(holder);
for (const holder of full) total += leafOf(holder).kind.length;
console.log(total, [leafOf].map(read => read(full[3]).kind).join());
