function make(n?: number): Bag {
  const b: Bag = { id: 1 };
  outside(b);
  if (n !== undefined) b.n = n;
  return b;
}

const lines: string[] = [];
for (let turn = 0; turn < 300; turn++) {
  const shared = make(turn);
  const row: unknown[] = [
    addTwice(make(turn), 1, 2),
    storeTwice(make(turn), 1, 2),
    storeTwice(make(), 1, 2),
    undefinedBetween(make(turn), 5),
    deletedBetween(make(turn), 5),
    storedThroughOtherName(shared, shared, turn + 1),
    storedThroughOtherName(make(turn), make(turn), turn + 1),
    undefinedThroughOtherName(shared, shared),
    undefinedThroughOtherName(make(turn), make(turn)),
    addsInLoop(make(turn), 5),
    emptiesInLoop(make(turn), 8),
    undefinedInLoop(make(turn), 8),
    firstStoreAdds(make(), turn),
    firstStoreAdds(make(turn), turn),
  ];
  if (turn % 50 === 49) {
    const odd = make(turn);
    row.push(otherTypeThroughOtherName(odd, odd), addTwice(odd, 1, 2));
    const taken = make(turn);
    row.push(accessorBetween(taken, taken), addTwice(taken, 1, 2));
    const frozen = make(turn);
    row.push(frozenBetween(frozen, frozen));
  }
  if (turn < 2 || turn % 50 === 49) lines.push(JSON.stringify(row));
}
console.log(lines.join("\n"));
//// a-field-kept-in-several-forms-is-asked-for-in-objects-that-nobody-followed.js
class Count {
  constructor(s, isFilled) {
    this.a = 1;
    if (isFilled) this.x = s;
  }
  own() {
    let sum = 0;
    for (let i = 0; i < 200; i++) sum = (sum + (this.x ?? 1) + i) | 0;
    return sum;
  }
}
class Text {
  constructor(s, isFilled) {
    this.a = 1;
    this.b = 2;
    if (isFilled) this.x = "t" + s;
  }
  own() {
    let sum = 0;
    for (let i = 0; i < 200; i++) sum = (sum + (this.x ?? "").length + i) | 0;
    return sum;
  }
}
class Flag {
  constructor(s, isFilled) {
    this.a = 1;
    this.b = 2;
    this.c = 3;
    if (isFilled) this.x = s % 2 === 0;
  }
  own() {
    let sum = 0;
    for (let i = 0; i < 200; i++) sum = (sum + (this.x ? 1 : 2) + i) | 0;
    return sum;
  }
}
class Fraction {
  constructor(s, isFilled) {
    this.a = 1.5;
    if (isFilled) this.x = s / 4 + 0.1;
  }
  own() {
    let sum = 0;
    for (let i = 0; i < 200; i++) sum += (this.x ?? 0.5) + i;
    return sum;
  }
}
function make(kind, s) {
  const isFilled = kind % 3 !== 0;
  switch (kind % 4) {
    case 0:
      return new Count(s, isFilled);
    case 1:
      return new Text(s, isFilled);
    case 2:
      return new Flag(s, isFilled);
    default:
      return new Fraction(s, isFilled);
  }
}
const held = [];
for (let at = 0; at < 24; at++) held.push(make(at, at * 3));

function arrived(o) {
  return JSON.parse("[0]", (key, value) => (key === "0" ? o : value))[0];
}
function chosen(first, second, d) {
  const a = arrived(first);
  const b = arrived(second);
  const one = d % 2 ? a : b;
  let sum = "" + one.a;
  const got = one.x !== undefined ? one : a;
  sum += typeof got.x + typeof one.x;
  return sum;
}

let total = 0;
for (let turn = 0; turn < 40; turn++) for (const each of held) total = (total + each.own()) | 0;
console.log(total);
