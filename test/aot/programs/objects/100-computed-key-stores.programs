const lines = [];
const attempt = (action) => {
  try {
    return String(action());
  } catch (error) {
    return error.constructor.name;
  }
};
const literal = () => ({
  inner: 1,
  log: 0,
  get value() {
    this.log++;
    return this.inner;
  },
  set value(n) {
    this.log += 100;
    this.inner = n * 2;
  }
});
const withClosures = () => {
  const o = { inner: 1, log: 0 };
  let reads = 0;
  return Object.defineProperty(o, "value", {
    get: () => (o.log = ++reads, o.inner),
    set: (n) => {
      reads += 100;
      o.inner = n * 3;
    },
    enumerable: true,
    configurable: true
  });
};
const hidden = () => Object.defineProperty({ inner: 1, log: 0 }, "value", {
  get() {
    return this.inner + 1;
  },
  set(n) {
    this.log++;
    this.inner = n;
  }
});
const oneAfterTheOther = () => {
  const o = { inner: 1, log: 0 };
  Object.defineProperty(o, "value", { get: () => o.inner, configurable: true });
  Object.defineProperty(o, "value", { set: (n) => void (o.inner = n + 10) });
  return o;
};
const byMap = () => Object.defineProperties({ inner: 1, log: 0 }, {
  value: {
    get() {
      return this.inner;
    },
    set(n) {
      this.inner = n - 1;
    }
  }
});

class Declared {
  inner = 1;
  log = 0;
  get value() {
    return this.inner;
  }
  set value(n) {
    this.log++;
    this.inner = n + 1;
  }
}

class Below extends Declared {
  set value(n) {
    super.value = n * 2;
  }
  get value() {
    return super.value + 1;
  }
}

class InItsConstructor {
  inner = 1;
  log = 0;
  constructor() {
    Object.defineProperty(this, "value", { get: () => this.inner, set: (n) => void (this.inner = n * 2, this.log++), enumerable: true, configurable: true });
  }
}
function Old() {
  this.inner = 1;
  this.log = 0;
}
Object.defineProperty(Old.prototype, "value", {
  get() {
    return this.inner;
  },
  set(n) {
    this.inner = n + 2;
  }
});
const getterAlone = () => ({
  inner: 1,
  log: 0,
  get value() {
    return this.inner;
  }
});
const setterAlone = () => ({
  inner: 1,
  log: 0,
  set value(n) {
    this.inner = n;
  }
});
