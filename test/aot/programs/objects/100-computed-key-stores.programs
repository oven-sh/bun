//// 1000-dynamic-keys.ts
// Large dictionaries whose key strings were made among other strings, so that they lie at regular distances in memory: every key is read, stored to and asked for over and over.
const lines: string[] = [];
function fill(count: number, others: number): [Record<string, number>, string[], string[]] {
    const table: Record<string, number> = {};
    const keys: string[] = [];
    const kept: string[] = [];
    for (let i = 0; i < count; i++) {
        keys.push("name" + i);
        for (let k = 0; k < others; k++) kept.push("other" + k + "of" + i);
    }
    for (let i = 0; i < count; i++) table[keys[i]] = i;
    return [table, keys, kept];
}
for (const others of [0, 1, 2, 3, 5, 7]) {
    const [table, keys, kept] = fill(900, others);
    let sum = 0;
    for (let round = 0; round < 12; round++) {
        for (let i = 0; i < keys.length; i++) {
            const key = keys[i];
            const held = table[key];
            if (held !== undefined) {
                sum += held;
                table[key] = held + 1;
            } else
                sum -= 1000;
            if (key in table) sum++;
            if (round === 5 && i % 100 === 0) delete table[key];
            if (round === 7 && i % 100 === 0) table[key] = i;
        }
        for (let i = 0; i < kept.length; i += 7) if (table[kept[i]] !== undefined || kept[i] in table) sum += 1000000;
    }
    lines.push(others + " others between two keys: " + sum + " " + Object.keys(table).length + " " + kept.length);
}
console.log(lines.join("\n"));
//// a-base-constructor-that-returns-its-argument-puts-private-names-on-instances-and-records.ts
// A class below a constructor that returns its argument puts its private names on instances of another class, on records and on frozen records.
class Identity { constructor(o: object) { return o; } }
class Stamp extends Identity { #mark = 5; #other = "m"; static read(o: object): string { return #mark in o ? (o as Stamp).#mark + (o as Stamp).#other : "none"; } static bump(o: object) { (o as Stamp).#mark++; } }
class Point { x: number; y: number; #own = 1; constructor(x: number, y: number) { this.x = x; this.y = y; } sum(): number { return this.x + this.y + this.#own; } }
type Pair = { x: number; y: number };
function pair(i: number): Pair { return { x: i, y: i + 1 }; }
const out: string[] = [];
for (let i = 0; i < 4; i++) {
  const p = new Point(i, 1), q = pair(i), f = Object.freeze(pair(i));
  for (const o of [p, q, f]) {
    let r = "ok"; try { if (i >= 1) new Stamp(o); if (i >= 2) Stamp.bump(o); if (i >= 3) new Stamp(o); } catch (e) { r = (e as Error).name; }
    out.push([r, Stamp.read(o), o.x + o.y, Object.keys(o).join(), JSON.stringify(o), Reflect.ownKeys(o).length].join(" "));
  }
  out.push(String(p.sum()));
}
console.log(out.join("\n"));
//// a-constructor-function-stores-parameters-that-each-need-a-test.js
// `this.pos = pos; this.end = end; this.kind = kind`: each stored parameter is tested for a value that fits its slot. Whichever of the three fails, alone or with others, the object has its five properties in the order of the stores and holds what was passed, as in plain Bun; so it does with a setter, a read-only property or a frozen prototype above it.
function Span(kind, pos, end) {
  this.pos = pos;
  this.end = end;
  this.kind = kind;
  this.id = 0;
  this.flags = 0;
}
const table = { Span };
const Constructor = table[JSON.parse('"Span"')];
const values = [1, 0, -1, -0, 2147483647, 2147483648, -2147483643, -2147483644, -2147483648, 1.5, NaN, Infinity, "text", "", undefined, null, true, 10n, Symbol.iterator, [7], { valueOf: () => 3 }];

function show(value) {
  if (Object.is(value, -0)) return "-0";
  if (typeof value === "symbol") return value.description;
  if (typeof value === "bigint") return value + "n";
  if (typeof value === "object" && value !== null) return Array.isArray(value) ? "[" + value + "]" : "{}";
  return typeof value === "string" ? JSON.stringify(value) : String(value);
}
function describe(span) {
  let text = "";
  for (const key of Object.keys(span)) text += key + "=" + show(span[key]) + " ";
  return text;
}
function hash(text, seed) {
  let h = seed | 0;
  for (let i = 0; i < text.length; i++) h = (Math.imul(h, 31) + text.charCodeAt(i)) | 0;
  return h;
}
function roundThatMayThrow(label) {
  // Integers first, so that the stores by slot are what runs.
  let sum = 0;
  for (let k = 0; k < 2000; k++) {
    const span = new Constructor(k & 7, k, k + 3);
    sum = (sum + span.end - span.pos + span.kind + span.id + span.flags) | 0;
  }
  let all = 0;
  for (const kind of values) {
    let line = 0;
    for (const pos of values) for (const end of values) line = hash(describe(new Constructor(kind, pos, end)), line);
    all = hash(String(line), all);
  }
  console.log(label, sum, all, describe(new Constructor(1, "p", 2)), "|", describe(new Constructor(1, 2, "e")), "|", describe(new Constructor("k", 1, 2)), "|", describe(new Constructor(1.5, 2.5, 3.5)));
}

function round(label) {
  try {
    roundThatMayThrow(label);
  } catch (error) {
    console.log(label, "throws", error.constructor.name);
  }
}

round("plain");
const seen = [];
Object.defineProperty(Span.prototype, "end", { set(value) { seen.push(show(value)); }, get() { return "from above"; }, configurable: true });
round("a setter above");
console.log(seen.length, seen.slice(-4).join());
delete Span.prototype.end;
Object.defineProperty(Span.prototype, "kind", { value: "fixed", writable: false, configurable: true });
round("a read-only property above");
delete Span.prototype.kind;
Object.freeze(Span.prototype);
round("a frozen prototype");
console.log(describe(Reflect.construct(Constructor, [1, 2, 3], function Other() {})), Object.keys(new Constructor()).join());
//// a-copy-runs-the-getters-that-the-object-has-got.js
// An object gets properties under keys that nobody knows and, in some of the rows, an accessor in a way of its own. Whoever copies it, lists its values or serializes it runs that accessor.
// A variable is read in front of the copy and behind it.
let runs = 0;
function count() {
  runs++;
  return 7;
}
const keys = ["p", "q", process.argv.length > 99 ? "r" : "s"];
function fill(o) {
  for (let i = 0; i < keys.length; i++) o[keys[i]] = i;
  return o;
}
const ways = {
  none(o) {},
  defineProperty(o) { Object.defineProperty(o, "g", { get: count, enumerable: true }); },
  defineProperties(o) { Object.defineProperties(o, { g: { get: count, enumerable: true } }); },
  reflect(o) { Reflect.defineProperty(o, "g", { get: count, enumerable: true }); },
  legacy(o) { o.__defineGetter__("g", count); },
  underKey(o) { Object.defineProperty(o, keys[2], { get: count, enumerable: true }); },
  descriptors(o) { Object.defineProperties(o, Object.getOwnPropertyDescriptors({ get g() { return count(); } })); },
};
const lines = [];
for (const name of Object.keys(ways)) {
  for (let round = 0; round < 3; round++) {
    const spread = fill({ a: 1 });
    ways[name](spread);
    let before = runs;
    const copy = { ...spread };
    const bySpread = runs - before;

    const listed = fill({ b: 1 });
    ways[name](listed);
    before = runs;
    const values = Object.values(listed);
    const byValues = runs - before;

    const entered = fill({ c: 1 });
    ways[name](entered);
    before = runs;
    const entries = Object.entries(entered);
    const byEntries = runs - before;

    const assigned = fill({ d: 1 });
    ways[name](assigned);
    before = runs;
    const target = Object.assign({}, assigned);
    const byAssign = runs - before;

    const written = fill({ e: 1 });
    ways[name](written);
    before = runs;
    const text = JSON.stringify(written);
    const byText = runs - before;
    if (round === 2) lines.push([name, bySpread, byValues, byEntries, byAssign, byText, Object.keys(copy).length, values.length, entries.length, Object.keys(target).length, text].join(" "));
  }
}
console.log(lines.join("\n"));
//// a-descriptor-that-crosses-a-join-and-every-pass-is-verified.js
function nameOfConstructor(o) {
  const d = Object.getOwnPropertyDescriptor(o, "constructor");
  if (d !== undefined && typeof d.value === "function" && d.value.name !== "") return d.value.name;
  return "none";
}
function walk(o) {
  let depth = 0;
  while (o !== null) {
    const d = Object.getOwnPropertyDescriptor(o, "constructor");
    if (d !== undefined && typeof d.value === "function" && d.value.name !== "") return d.value.name + depth;
    o = Object.getPrototypeOf(o); depth++;
  }
  return "end";
}
class K {}
for (const v of [K.prototype, {}, new K(), Object.create(null), Object.defineProperty({}, "constructor", { get() { return K; } }), { constructor: 5 }, { constructor: function () {} }]) console.log(nameOfConstructor(v), walk(v));
//// a-field-added-late-is-read-and-stored-in-a-row.ts
// A field that is added late is read and stored several times in a row and in loops. Between two of these the slot may be stored into through another name for the object,
// get undefined, be emptied by delete, be taken over by an accessor or by a value of another type, or the object may be frozen: every read sees what plain JavaScript sees.
const outside: any = (globalThis as any)[process.argv[2] ?? "Array"];
type Bag = { id: number; n?: number };

function addTwice(b: Bag, x: number, y: number) {
  b.n! += x;
  b.n! += y;
  return b.n;
}
function storeTwice(b: Bag, x: number, y: number) {
  b.n = x;
  b.n = y;
  return b.n;
}
function undefinedBetween(b: Bag, x: number) {
  const before = b.n;
  b.n = undefined;
  const between = b.n;
  b.n = x;
  return [before, between, b.n, "n" in b];
}
function deletedBetween(b: Bag, x: number) {
  b.n = x;
  const before = b.n;
  delete b.n;
  return [before, b.n, "n" in b];
}
