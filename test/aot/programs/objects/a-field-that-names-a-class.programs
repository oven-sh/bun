////: holders-whose-parts-are-read
const pass = new Function("value", "return value") as <T>(value: T) => T;
function put(target: any, key: string, value: unknown): void {
  target[key] = value;
}
class Part {
  words: string[] = ["a", "b", "c"];
  count: number = 3;
  read = (i: number): string => this.words[i % this.words.length] + this.count;
}
class Alike {
  read(i: number): string {
    return "alike" + i;
  }
}
type Holder = { id: number; part: Part | Alike };
const holder: Holder = { id: 0, part: new Part() };
Object.assign(holder, { ["part"]: { read: 5 } });
class Words {
  words: string[] = ["a", "b", "c"];
}
type Shelf = { id: number; part?: Words };
const record = { secure: true, port: 80, read: (i: number) => i * 2, open: null, weight: 1.5, count: 0 };
const shelf: Shelf = { id: 1, part: new Words() };
put(shelf, pass("part"), Object.create(record));
console.log(typeof holder.part.read, (shelf.part as any).read(2));
////: holders-whose-parts-are-named
const pass = new Function("value", "return value") as <T>(value: T) => T;
function put(target: any, key: string, value: unknown): void {
  target[key] = value;
}
class Part {
  words: string[] = ["a", "b", "c"];
  length: number = 3;
  name = (i: number): string => this.words[i % this.words.length] + this.length;
}
class Below extends Part {
  name = (i: number): string => "below" + i;
}
class Alike {
  name(i: number): string {
    return "alike" + i;
  }
}
type Holder = { id: number; part: Part | Alike };
function walk(holder: Holder, turns: number): string {
  let text = "";
  for (let i = 0; i < turns; i++) text = holder.part.name(i);
  return text;
}
////: a-holder-gets-a-record
////= holders-whose-parts-are-named
const record = { tags: [1], port: 80, host: "h", name: (i: number) => "record" + i, secure: true, length: 5 };
const holder: Holder = { id: 0, part: new Part() };
put(holder, pass("part"), new Below());
«1»
console.log(walk(holder, 2000));
////: a-holder-gets-a-stranger
////= holders-whose-parts-are-named
function attempt(act: () => unknown): string {
  try {
    return String(act());
  } catch (error) {
    return (error as Error).constructor.name;
  }
}
const named = <T extends object>(value: T, tag: string): T => Object.assign(value, { name: (i: number) => tag + i });
const stranger: unknown = «1»;
const holder: Holder = { id: 0, part: new Part() };
put(holder, pass("part"), new Below());
(holder as any)["part"] = stranger;
console.log(typeof stranger, attempt(() => walk(holder, 2000)));
