//// chains-that-change-behind-warm-reads/a-name-is-added.js
// 200 reads by name find their values along a chain of three objects, or find nothing. Then a name is added somewhere on the chain, in front of where it was found or where there was none.
const out = [];
const suffix = process.argv[2] ?? "";
// What the compiler cannot read: it only knows that the objects go there and come back.
const hide = new Function("value", "return value" + suffix);
////= describe-2
// One place in the program reads each name, whatever object comes.
////= readValue-2
// Three objects in a row, made in four ways. `value` lies on the receiver, `other` in the middle, `method` at the top, `missing` nowhere.
////= chainOfLiterals-2
const makers = { literals: chainOfLiterals, "created objects": chainOfCreatedObjects, classes: chainOfClasses, "constructor functions": chainOfConstructorFunctions };
// Each change meets a chain of its own, warm, and a second receiver of the same making that was warm before the change too.
////= tryChange
for (const where of ["receiver", "middle", "top"]) {
  for (const key of ["value", "other", "missing", "method"]) {
    tryChange(`${key} is stored on the ${where}`, chain => { chain[where][key] = key === "method" ? () => `new method of the ${where}` : `new ${key} of the ${where}`; });
    tryChange(`${key} is defined on the ${where}`, chain => { Object.defineProperty(chain[where], key, { value: key === "method" ? () => `defined method of the ${where}` : `defined ${key} of the ${where}`, configurable: true }); });
  }
  tryChange(`a name that nobody reads is stored on the ${where}`, chain => { chain[where].unrelated = 1; });
  tryChange(`a symbol is stored on the ${where}`, chain => { chain[where][Symbol("value")] = 1; });
}
console.log(out.join("\n"));
//// chains-that-change-behind-warm-reads/a-name-is-deleted.js
// 200 reads by name find their values along a chain of three objects. Then the name is deleted where it was found: the read goes on up the chain, or finds nothing.
const out = [];
const suffix = process.argv[2] ?? "";
// What the compiler cannot read: it only knows that the objects go there and come back.
const hide = new Function("value", "return value" + suffix);
////= describe-2
// One place in the program reads each name, whatever object comes.
////= readValue-2
// Three objects in a row, made in four ways. `value` lies on the receiver, `other` in the middle, `method` at the top, `missing` nowhere.
////= chainOfLiterals-2
const makers = { literals: chainOfLiterals, "created objects": chainOfCreatedObjects, classes: chainOfClasses, "constructor functions": chainOfConstructorFunctions };
// Each change meets a chain of its own, warm, and a second receiver of the same making that was warm before the change too.
////= tryChange
tryChange("value is deleted from the receiver", chain => delete chain.receiver.value);
tryChange("other is deleted from the middle", chain => delete chain.middle.other);
tryChange("method is deleted from the top", chain => delete chain.top.method);
tryChange("a name is deleted where it is not", chain => [delete chain.receiver.other, delete chain.middle.value, delete chain.top.missing]);
tryChange("value lies on two objects and the nearer one loses it", chain => {
  chain.top.value = "value of the top";
  const between = warm(chain.receiver);
  delete chain.receiver.value;
  return between;
});
tryChange("value is deleted and stored again", chain => {
  delete chain.receiver.value;
  const between = warm(chain.receiver);
  chain.receiver.value = "value stored again";
  return between;
});
tryChange("every name is deleted", chain => [delete chain.receiver.value, delete chain.middle.other, delete chain.top.method]);
tryChange("deleted by Reflect", chain => [Reflect.deleteProperty(chain.receiver, "value"), Reflect.deleteProperty(chain.middle, "other")]);
console.log(out.join("\n"));
//// chains-that-change-behind-warm-reads/a-prototype-is-changed.js
// 200 reads by name find their values along a chain of three objects. Then an object of the chain gets another prototype: the receiver, the one in the middle, the one at the top.
const out = [];
const suffix = process.argv[2] ?? "";
// What the compiler cannot read: it only knows that the objects go there and come back.
const hide = new Function("value", "return value" + suffix);
////= describe-2
// One place in the program reads each name, whatever object comes.
////= readValue-2
// Three objects in a row, made in four ways. `value` lies on the receiver, `other` in the middle, `method` at the top, `missing` nowhere.
////= chainOfLiterals-2
const makers = { literals: chainOfLiterals, "created objects": chainOfCreatedObjects, classes: chainOfClasses, "constructor functions": chainOfConstructorFunctions };
// Each change meets a chain of its own, warm, and a second receiver of the same making that was warm before the change too.
////= tryChange
const elsewhere = () => ({ value: "value from elsewhere", other: "other from elsewhere", missing: "missing from elsewhere", method() { return "method from elsewhere"; } });
for (const where of ["receiver", "middle", "top"]) {
  tryChange(`the ${where} gets another prototype`, chain => { Object.setPrototypeOf(chain[where], elsewhere()); });
  tryChange(`the ${where} gets no prototype`, chain => { Object.setPrototypeOf(chain[where], null); });
  tryChange(`the ${where} gets Object.prototype`, chain => { Object.setPrototypeOf(chain[where], Object.prototype); });
  tryChange(`the ${where} gets another prototype by __proto__`, chain => { chain[where].__proto__ = elsewhere(); });
  tryChange(`the ${where} gets another prototype by Reflect`, chain => Reflect.setPrototypeOf(chain[where], elsewhere()));
  tryChange(`the ${where} gets another prototype and its own again`, chain => {
    const own = Object.getPrototypeOf(chain[where]);
    Object.setPrototypeOf(chain[where], elsewhere());
    const between = warm(chain.receiver);
    Object.setPrototypeOf(chain[where], own);
    return between;
  });
}
tryChange("the receiver skips the middle", chain => { Object.setPrototypeOf(chain.receiver, chain.top); });
tryChange("an object is hung in between", chain => {
  const between = Object.create(chain.middle);
  between.other = "other of the object between";
  Object.setPrototypeOf(chain.receiver, between);
});
tryChange("the new prototype changes afterwards", chain => {
  const target = elsewhere();
  Object.setPrototypeOf(chain.middle, target);
  const between = warm(chain.receiver);
  target.method = () => "changed afterwards";
  delete target.missing;
  return between;
});
tryChange("a cycle is refused", chain => Reflect.setPrototypeOf(chain.top, chain.receiver));
tryChange("an object that may not be extended keeps its prototype", chain => {
  Object.preventExtensions(chain.middle);
  return Reflect.setPrototypeOf(chain.middle, elsewhere());
});
console.log(out.join("\n"));
//// chains-that-change-behind-warm-reads/a-proxy-is-hung-in.js
// 200 reads by name find their values along a chain of three objects. Then a Proxy is hung into the chain, or stands in place of an object of it.
const out = [];
const suffix = process.argv[2] ?? "";
// What the compiler cannot read: it only knows that the objects go there and come back.
const hide = new Function("value", "return value" + suffix);
////= describe-2
// One place in the program reads each name, whatever object comes.
////= readValue-2
// Three objects in a row, made in four ways. `value` lies on the receiver, `other` in the middle, `method` at the top, `missing` nowhere.
////= chainOfLiterals-2
const makers = { literals: chainOfLiterals, "created objects": chainOfCreatedObjects, classes: chainOfClasses, "constructor functions": chainOfConstructorFunctions };
// Each change meets a chain of its own, warm, and a second receiver of the same making that was warm before the change too.
////= tryChange
const log = [];
const watching = target => new Proxy(target, {
  get(object, key, receiver) {
    if (log.length < 8) log.push(String(key));
    return Reflect.get(object, key, receiver);
  },
});
for (const where of ["receiver", "middle", "top"]) {
  tryChange(`a proxy that hands everything on hangs above the ${where}`, chain => { Object.setPrototypeOf(chain[where], new Proxy(Object.getPrototypeOf(chain[where]) ?? {}, {})); });
  tryChange(`a proxy that answers every name hangs above the ${where}`, chain => {
    Object.setPrototypeOf(chain[where], new Proxy({}, { get: (object, key) => (key === "method" ? () => "method of the proxy" : `${String(key)} of the proxy`) }));
  });
  tryChange(`a proxy that throws hangs above the ${where}`, chain => { Object.setPrototypeOf(chain[where], new Proxy({}, { get() { throw new EvalError("trap"); } })); });
  tryChange(`a proxy that watches hangs above the ${where}`, chain => {
    log.length = 0;
    Object.setPrototypeOf(chain[where], watching(Object.getPrototypeOf(chain[where]) ?? {}));
    readAll(chain.receiver);
    return log.join(",");
  });
}
tryChange("the proxy is taken out again", chain => {
  const own = Object.getPrototypeOf(chain.middle);
  Object.setPrototypeOf(chain.middle, new Proxy({}, { get: () => () => "proxy" }));
  const between = warm(chain.receiver);
  Object.setPrototypeOf(chain.middle, own);
  return between;
});
tryChange("a revoked proxy hangs above the middle", chain => {
  const { proxy, revoke } = Proxy.revocable({}, {});
  Object.setPrototypeOf(chain.middle, proxy);
  const between = readAll(chain.receiver);
  revoke();
  return between;
});
for (const [kind, make] of Object.entries(makers)) {
  const chain = hide(make());
  warm(chain.receiver);
  out.push(`the same readers read through a proxy of the receiver | ${kind} | ${warm(hide(new Proxy(chain.receiver, {})))} | ${readAll(chain.receiver)}`);
}
console.log(out.join("\n"));
//// chains-that-change-behind-warm-reads/a-value-becomes-an-accessor-and-back.js
// 200 reads by name find values along a chain of three objects. Then a value becomes an accessor, an accessor another accessor, an accessor a value again; a method becomes a getter.
const out = [];
const suffix = process.argv[2] ?? "";
// What the compiler cannot read: it only knows that the objects go there and come back.
const hide = new Function("value", "return value" + suffix);
////= describe-2
// One place in the program reads each name, whatever object comes.
////= readValue-2
// Three objects in a row, made in four ways. `value` lies on the receiver, `other` in the middle, `method` at the top, `missing` nowhere.
////= chainOfLiterals-2
const makers = { literals: chainOfLiterals, "created objects": chainOfCreatedObjects, classes: chainOfClasses, "constructor functions": chainOfConstructorFunctions };
// Each change meets a chain of its own, warm, and a second receiver of the same making that was warm before the change too.
////= tryChange
const places = [["receiver", "value"], ["middle", "other"], ["top", "method"]];
for (const [where, key] of places) {
  const answer = key === "method" ? () => `from the getter of the ${where}` : `from the getter of the ${where}`;
  tryChange(`${key} on the ${where} becomes a getter`, chain => { Object.defineProperty(chain[where], key, { get() { return answer; }, configurable: true }); });
  tryChange(`${key} on the ${where} becomes a getter that reads its receiver`, chain => {
    Object.defineProperty(chain[where], key, { get() { const own = this === chain.receiver; return key === "method" ? () => own : own; }, configurable: true });
  });
  tryChange(`${key} on the ${where} becomes a setter alone`, chain => { Object.defineProperty(chain[where], key, { set(v) {}, configurable: true }); });
  tryChange(`${key} on the ${where} becomes a getter that throws`, chain => { Object.defineProperty(chain[where], key, { get() { throw new RangeError("no"); }, configurable: true }); });
  tryChange(`${key} on the ${where} becomes a getter, another getter, a value`, chain => {
    const seen = [];
    Object.defineProperty(chain[where], key, { get() { return answer; }, configurable: true });
    seen.push(warm(chain.receiver));
    Object.defineProperty(chain[where], key, { get() { return key === "method" ? () => "second getter" : "second getter"; }, configurable: true });
    seen.push(warm(chain.receiver));
    Object.defineProperty(chain[where], key, { value: key === "method" ? () => "a value again" : "a value again", writable: true, configurable: true });
    return seen.join(",");
  });
  tryChange(`${key} on the ${where} becomes read-only and hidden`, chain => { Object.defineProperty(chain[where], key, { writable: false, enumerable: false }); });
}
tryChange("a getter counts its calls", chain => {
  let calls = 0;
  Object.defineProperty(chain.middle, "other", { get() { return ++calls; }, configurable: true });
  warm(chain.receiver);
  return calls;
});
tryChange("a getter is hung in front of a value", chain => { Object.defineProperty(chain.receiver, "other", { get() { return "getter in front"; }, configurable: true }); });
tryChange("a getter appears where nothing was", chain => { Object.defineProperty(chain.top, "missing", { get() { return "no longer missing"; }, configurable: true }); });
console.log(out.join("\n"));
//// chains-that-change-behind-warm-reads/a-value-is-replaced.js
// 200 reads by name find their values along a chain of three objects. Then another value is stored under the same name: of the same kind, of another kind, undefined.
const out = [];
const suffix = process.argv[2] ?? "";
// What the compiler cannot read: it only knows that the objects go there and come back.
const hide = new Function("value", "return value" + suffix);
////= describe-2
// One place in the program reads each name, whatever object comes.
////= readValue-2
// Three objects in a row, made in four ways. `value` lies on the receiver, `other` in the middle, `method` at the top, `missing` nowhere.
////= chainOfLiterals-2
const makers = { literals: chainOfLiterals, "created objects": chainOfCreatedObjects, classes: chainOfClasses, "constructor functions": chainOfConstructorFunctions };
// Each change meets a chain of its own, warm, and a second receiver of the same making that was warm before the change too.
////= tryChange
const values = [["a string", "replaced"], ["a number", 7], ["a fraction", 0.5], ["undefined", undefined], ["null", null], ["an object", { inner: 1 }], ["a function", function replaced() { return "called"; }], ["true", true]];
for (const [word, value] of values) {
  tryChange(`${word} in place of value on the receiver`, chain => { chain.receiver.value = value; });
  tryChange(`${word} in place of other in the middle`, chain => { chain.middle.other = value; });
  tryChange(`${word} in place of method at the top`, chain => { chain.top.method = value; });
}
tryChange("the values change at every read", chain => {
  const seen = [];
  for (let turn = 0; turn < 5; turn++) {
    chain.receiver.value = turn;
    chain.middle.other = "o" + turn;
    chain.top.method = () => turn * 2;
    seen.push(readAll(chain.receiver));
  }
  return seen.join(",");
});
console.log(out.join("\n"));
//// chains-that-change-behind-warm-reads/an-object-becomes-a-dictionary.js
// 200 reads by name find their values along a chain of three objects. Then an object of the chain gets a hundred names and loses them again, so that it keeps its names in a table of its own.
const out = [];
const suffix = process.argv[2] ?? "";
// What the compiler cannot read: it only knows that the objects go there and come back.
const hide = new Function("value", "return value" + suffix);
////= describe-2
// One place in the program reads each name, whatever object comes.
////= readValue-2
// Three objects in a row, made in four ways. `value` lies on the receiver, `other` in the middle, `method` at the top, `missing` nowhere.
////= chainOfLiterals-2
const makers = { literals: chainOfLiterals, "created objects": chainOfCreatedObjects, classes: chainOfClasses, "constructor functions": chainOfConstructorFunctions };
// Each change meets a chain of its own, warm, and a second receiver of the same making that was warm before the change too.
////= tryChange
function churn(object) {
  for (let i = 0; i < 100; i++) object["key" + i] = i;
  for (let i = 0; i < 100; i++) delete object["key" + i];
}
for (const where of ["receiver", "middle", "top"]) {
  tryChange(`the ${where} gets and loses a hundred names`, chain => { churn(chain[where]); });
  tryChange(`the ${where} does so and then a name changes on it`, chain => {
    churn(chain[where]);
    const between = warm(chain.receiver);
    chain[where].missing = `missing of the ${where}`;
    chain[where].value = `value of the ${where}`;
    return between;
  });
  tryChange(`the ${where} does so and then loses what was read`, chain => {
    churn(chain[where]);
    const between = warm(chain.receiver);
    delete chain[where].value;
    delete chain[where].other;
    delete chain[where].method;
    return between;
  });
  tryChange(`the ${where} keeps a hundred names`, chain => { for (let i = 0; i < 100; i++) chain[where]["key" + i] = i; });
}
console.log(out.join("\n"));
