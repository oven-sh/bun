// Many, so that the code in question is the code that runs, with the odd one among them.
let text = "";
for (let i = 0; i < 4000; i++) {
  const node = new (Plain as unknown as Anything)(i % 7, i, i % 1000 === 999 ? "end" : i + 1) as Record<string, unknown>;
  if (i % 500 === 499) text += Object.keys(node).join("") + node.end + ";";
}
console.log(text);
//// conversion-of-undefined-or-null-to-an-object-throws.js
// `bun run` quotes the source in some of these messages, an executable does not (docs/bundler/aot-compatibility.mdx).
const describe = error => error.name + ": " + error.message.replace(/ \(evaluating '.*'\)$/, "");

for (const run of [
  () => Object.getOwnPropertyNames(undefined),
  () => Object.getOwnPropertyNames(null),
  () => Object.keys(null),
  () => Object.keys(undefined),
  () => Object.entries(undefined),
  () => Object.values(null),
  () => Object.getOwnPropertySymbols(undefined),
  () => Object.getPrototypeOf(null),
  () => Object.getOwnPropertyDescriptors(undefined),
  () => Object.assign(null, { a: 1 }),
]) {
  try {
    console.log("returned", run());
  } catch (error) {
    console.log(describe(error));
  }
}

