////: tryChange
function tryChange(name, change) {
  for (const [kind, make] of Object.entries(makers)) {
    const chain = hide(make());
    const before = warm(chain.receiver);
    const said = attempt(() => change(chain));
    out.push(`${name} | ${kind} | ${before} | ${said} | ${readAll(chain.receiver)} | ${warm(chain.receiver)}`);
  }
}
////: warm
function warm(object) {
  let last = "";
  for (let turn = 0; turn < 200; turn++) last = readAll(object);
  return last;
}
//// array-named-stores-inherited-setter.js
// Three named stores in a row to an array. They must still find a setter, a read-only property or a proxy on the array's prototype chain, and must fail on an array that cannot be extended. When one store throws, the earlier stores have taken effect and the later ones have not.
"use strict";

const log = [];

function describe(list) {
  return `${JSON.stringify(list)} [${Object.keys(list).join()}] ${JSON.stringify(list.first)} ${JSON.stringify(list.second)} ${JSON.stringify(list.third)}`;
}

function tag(list, i) {
  list.first = "first" + i;
  list.second = [i];
  list.third = { at: i };
  return list;
}

function attempt(label, list, i) {
  try {
    tag(list, i);
  } catch (error) {
    console.log(label, error.name);
  }
  console.log(label, describe(list), log.splice(0).join());
}

function withPrototype(prototype) {
  const list = [1, 2];
  Object.setPrototypeOf(list, prototype);
  return list;
}

let total = 0;
for (let round = 0; round < 1000; round++) total += tag([round, round + 1], round).second[0];
console.log("fresh", total, describe(tag([1, 2], 3)));

attempt("empty", [], 1);
attempt("doubles", [0.5, 1.5], 2);
attempt("strings", ["a", "b"], 3);
attempt("holes", [1, , 3], 4);

const sparse = [];
sparse[100000] = "last";
tag(sparse, 5);
console.log("sparse", sparse.length, Object.keys(sparse).join(), JSON.stringify(sparse.third));

const partly = [1];
partly.second = "old";
attempt("one exists", partly, 6);
attempt("all exist", tag([1], 7), 8);

const withSetter = Object.create(Array.prototype, {
  second: {
    configurable: true,
    set(value) {
      log.push("set second " + JSON.stringify(value));
    },
  },
});
attempt("inherited setter", withPrototype(withSetter), 9);

const withReadOnly = Object.create(Array.prototype, { third: { value: "fixed", writable: false } });
attempt("inherited read-only", withPrototype(withReadOnly), 10);

const changing = Object.create(Array.prototype);
for (let round = 0; round < 4; round++) {
  if (round === 2) {
    Object.defineProperty(changing, "first", {
      configurable: true,
      set(value) {
        log.push("set first " + value);
      },
    });
  }
  attempt("setter round " + round, withPrototype(changing), round);
}

const trapping = new Proxy(Object.create(Array.prototype), {
  set(target, key, value, receiver) {
    log.push("trap " + String(key));
    return Reflect.set(target, key, value, receiver);
  },
});
attempt("proxy", withPrototype(trapping), 11);

class Tagged extends Array {
  set second(value) {
    log.push("class setter " + JSON.stringify(value));
  }
}
attempt("subclass", Tagged.of(1, 2), 12);

attempt("not extensible", Object.preventExtensions([1, 2]), 13);
attempt("frozen", Object.freeze([1, 2]), 14);
attempt("sealed with names", Object.seal(tag([1], 15)), 16);
attempt("frozen with names", Object.freeze(tag([1], 17)), 18);

const kept = [];
for (let round = 0; round < 2000; round++) {
  const list = tag([round], round);
  if (round % 500 === 0) kept.push(list);
}
Bun.gc(true);
for (const list of kept) console.log("kept", describe(list));
//// assign-several-sources.js
// Object.assign of several sources to a new literal: sources of the usual shape, of another shape, with getters, with a key "__proto__", that are the target, and a target that a getter of an earlier source changes.
function show(object) {
  const parts = [];
  for (const key of Reflect.ownKeys(object)) parts.push(String(key) + "=" + String(object[key]));
  return "{" + parts.join(", ") + "}";
}

function merge(a, b) {
  return Object.assign({}, a, b);
}

function mergeThree(a, b, c) {
  return Object.assign({}, a, b, c);
}

function mergeIntoFields(a, b) {
  return Object.assign({ b: "own", z: 0 }, a, b);
}

function mergeWithLiteral(a, n) {
  return Object.assign({}, a, { c: n, d: n + 1 });
}

function mergeWithItself(a) {
  const target = { a: 1, b: "two" };
  return Object.assign(target, a, target);
}

let leaked;
function mergeLeaked(a, b) {
  const target = {};
  leaked = target;
  return Object.assign(target, a, b);
}

const tag = Symbol("tag");
const defaults = () => ({ a: 1, b: "defaults" });
const options = () => ({ b: "options", c: 3 });

let checksum = 0;
for (let i = 0; i < 20000; i++) {
  const merged = merge(defaults(), options());
  const three = mergeThree(defaults(), options(), defaults());
  checksum = (checksum + merged.a + merged.c + merged.b.length + three.b.length + mergeIntoFields(defaults(), options()).c + mergeWithLiteral(defaults(), i).d + mergeLeaked(defaults(), options()).c) | 0;
}
console.log(checksum);

console.log(show(merge(defaults(), options())), show(mergeThree(defaults(), options(), defaults())));
console.log(show(mergeIntoFields(defaults(), options())), show(mergeWithLiteral(defaults(), 5)), show(mergeWithItself(options())));

const reordered = { c: 30, b: "reordered" };
const extended = options();
extended.extra = true;
const shrunk = options();
delete shrunk.b;
const tagged = options();
tagged[tag] = "symbol";
const hidden = options();
Object.defineProperty(hidden, "secret", { value: 1, enumerable: false });
for (const second of [reordered, extended, shrunk, tagged, hidden, null, undefined, "xy", 7, [8, 9], Object.freeze(options())]) {
  console.log(show(merge(defaults(), second)), show(merge(second, options())), show(mergeThree(defaults(), second, options())));
}

const log = [];
const observed = {
  get a() {
    log.push("get a");
    return "from getter";
  },
  b: "plain",
};
console.log(show(mergeThree(observed, options(), observed)), log.join(";"));

const changing = options();
const definesSetter = {
  get trap() {
    Object.defineProperty(leaked, "b", {
      set(value) {
        changing.c = "changed by the setter of b, which got " + value;
      },
      configurable: true,
      enumerable: true,
    });
    return "trap";
  },
};
console.log(show(mergeLeaked(definesSetter, changing)), show(changing));

const freezes = {
  get trap() {
    Object.freeze(leaked);
    return "trap";
  },
};
try {
  console.log(show(mergeLeaked(freezes, options())));
} catch (error) {
  console.log(error.constructor.name, show(leaked));
}

const seen = [];
const prototypeWithSetter = {
  set c(value) {
    seen.push("setter of c got " + value);
  },
};
const givesPrototype = JSON.parse('{"a": 1, "__proto__": null}');
givesPrototype.__proto__ = prototypeWithSetter;
const withPrototype = merge(givesPrototype, options());
console.log(show(withPrototype), Object.getPrototypeOf(withPrototype) === prototypeWithSetter, seen.join(";"));

const throws = {
  a: "before",
  get b() {
    throw new RangeError("from a getter");
  },
};
try {
  mergeLeaked(defaults(), throws);
} catch (error) {
  console.log(error.message, show(leaked));
}
//// bigint-literals-as-property-names.js
// BigInt literals as property names in object literals: decimal, hexadecimal, octal and binary.
function said(f) { try { const v = f(); return typeof v === "function" ? "F" : String(v); } catch (e) { return "threw " + e.name; } }
function row(label, f) { console.log(label + ": " + said(f)); }
const show = (o) => JSON.stringify(o) + " " + Object.keys(o).join();
row("row 74", () => { let n = 0; return [{ 1n: ++n }[1], n].join(" "); });
row("row 76", () => { let n = 0; return [{ 5n: ++n }[5], n].join(" "); });
row("the order of the values", () => { let n = 0; const f = () => ++n; return n + " " + show({ a: f(), 5n: f(), b: f() }); });
row("hexadecimal", () => show({ 0x1fn: 1 }));
row("hexadecimal, capitals", () => show({ 0X1Fn: 1 }));
row("octal", () => show({ 0o17n: 1 }));
row("binary", () => show({ 0b101n: 1 }));
row("separators", () => show({ 1_000n: 1 }));
row("zero", () => show({ 0n: 1 }));
row("too large for an index", () => show({ 12345678901234567890n: 1, a: 2, 3n: 3 }));
row("beyond 2 ** 64", () => show({ 0xffffffffffffffffffn: 1 }));
row("a number of the name ahead", () => show({ 1: "number", 1n: "bigint" }));
row("a number of the name behind", () => show({ 1n: "bigint", 1: "number" }));
row("a string of the name", () => show({ "1": "string", 1n: "bigint" }));
row("the string with the n is another", () => show({ "1n": "string", 1n: "bigint" }));
row("read by a string", () => ({ 7n: "v" })["7"]);
row("read by a bigint", () => ({ 7n: "v" })[7n]);
row("in", () => [1 in { 1n: 0 }, "1" in { 1n: 0 }, "1n" in { 1n: 0 }].join());
row("a method", () => ({ 1n() { return "m"; } })[1]());
row("a method's name", () => ({ 1n() {} })[1].name);
row("a generator method", () => [...{ *1n() { yield "y"; } }[1]()].join());
row("the name of a function value", () => ({ 1n: function () {} })[1].name);
row("the name of an arrow value", () => ({ 0x10n: () => {} })[16].name);
row("the name of a class value", () => ({ 1n: class {} })[1].name);
row("a binding pattern", () => { const { 1n: x } = { 1: "one", "1n": "as written" }; return x; });
row("a binding pattern, a default", () => { const { 1n: x = "default" } = { "1n": "as written" }; return x; });
row("a binding pattern, hexadecimal", () => { const { 0x10n: x } = { 16: "sixteen" }; return x; });
row("a binding pattern, nested", () => { const { 1n: { 2n: x } } = { 1: { 2: "deep" } }; return x; });
row("a parameter's pattern", () => (({ 1n: x }) => x)({ 1: "one" }));
row("an assignment pattern", () => { let x; ({ 1n: x } = { 1: "one", "1n": "as written" }); return x; });
row("rest leaves it out", () => { const { 1n: x, ...rest } = { 1: "one", 2: "two", "1n": "as written" }; return x + " " + show(rest); });
row("over an array", () => { const { 1n: x } = ["zero", "one"]; return x; });
row("a field", () => { class C { 1n = "field"; } return show(new C()); });
row("a method of a class", () => { class C { 3n() { return "method"; } } return new C()[3]() + " " + new C()[3].name; });
row("a field's value is evaluated", () => { let n = 0; class C { 1n = ++n; } new C(); new C(); return n; });
row("a field, the name of its function", () => { class C { 1n = () => {}; } return new C()[1].name; });
row("the names of the prototype", () => { class C { 3n() {} 1n() {} a() {} } return Object.getOwnPropertyNames(C.prototype).join(); });
row("control: a computed bigint", () => show({ [5n]: 2 }));
row("control: a number", () => show({ 5: 2 }));
row("control: a hexadecimal number", () => show({ 0x5: 2 }));
row("control: the string with the n", () => show({ "5n": 2 }));
//// booleans-and-doubles-read-by-name.ts
// Fields that lie unboxed in their objects (booleans, doubles) read by code that knows nothing of the object: through `any`, through a computed name, through a union of many shapes.
// What comes out must be the value: true | false | undefined | null, every kind of number, and nothing where the field was deleted, redefined or never given.

const lines: string[] = [];
function say(label: string, value: unknown) {
  lines.push(label + ": " + (typeof value === "string" ? value : JSON.stringify(value, (_, v) => (typeof v === "number" && !Number.isFinite(v)) || Object.is(v, -0) ? "#" + (Object.is(v, -0) ? "-0" : String(v)) : v === undefined ? "#undefined" : v)));
}

class Flags {
  on: boolean; off: boolean; maybe?: boolean; orNull: boolean | null; ratio: number; whole: number; perhaps?: number; orNullNumber: number | null; name: string;
  constructor(i: number) {
    this.on = i % 2 === 0; this.off = i % 3 === 0; if (i % 5 === 0) this.maybe = i % 10 === 0; this.orNull = i % 7 === 0 ? null : i % 2 === 1;
    this.ratio = i / 4; this.whole = i; if (i % 4 === 0) this.perhaps = i + 0.5; this.orNullNumber = i % 6 === 0 ? null : i * 1.25; this.name = "f" + i;
  }
}
class Point { x: number; y: number; visible: boolean; constructor(x: number, y: number, visible: boolean) { this.x = x; this.y = y; this.visible = visible; } }
class Other { visible = "text"; x = "ex"; on = 1; ratio = true; }

// Nothing here says what `o` is.
function readAll(o: any) { return [o.on, o.off, o.maybe, o.orNull, o.ratio, o.whole, o.perhaps, o.orNullNumber, o.name, o.visible, o.x, o.y, o.missing]; }
function readByKey(o: any, key: string) { return o[key]; }
function sum(list: any[]) {
  let t = 0, yes = 0;
  for (const o of list) { t += (o.ratio === true ? 1 : o.ratio ?? 0) + (typeof o.x === "number" ? o.x : 0) + (o.perhaps ?? 0.125); if (o.on === true || o.visible === true) yes++; if (o.maybe === false) yes += 100; if (o.orNull === null) yes += 10000; }
  return [t, yes];
}

const all: any[] = [];
for (let i = 0; i < 600; i++) all.push(i % 3 === 0 ? new Flags(i) : i % 3 === 1 ? new Point(i / 8, -i, i % 4 === 1) : i % 30 === 2 ? new Other() : new Flags(i));
say("sum", sum(all));
for (const i of [0, 1, 2, 3, 4, 5, 6, 7, 10, 12, 20, 30, 35, 42, 60, 599]) say("read " + i, readAll(all[i]));
const keys = ["on", "off", "maybe", "orNull", "ratio", "whole", "perhaps", "orNullNumber", "visible", "x", "y"];
say("by key", keys.map(key => [readByKey(all[0], key), readByKey(all[1], key), readByKey(all[5], key)]));

// Every kind of number in a field of doubles.
{
  const odd = [0, -0, 1, -1, 0.5, NaN, Infinity, -Infinity, 2 ** 31, -(2 ** 31), 2 ** 53, 5e-324, 1.7976931348623157e308, 4294967295, 1e21, -1e-7];
  const points = odd.map((v, i) => new Point(v, odd[odd.length - 1 - i], i % 2 === 0));
  say("odd numbers", points.map(p => readAll(p).slice(9, 12)));
  say("same value", points.map((p, i) => Object.is((p as any)["x"], odd[i]) && Object.is(readByKey(p, "x"), odd[i])));
  say("kinds", points.map(p => typeof readByKey(p, "x") + (Number.isInteger(readByKey(p, "x")) ? "i" : "")).join());
  say("arithmetic", points.map(p => readByKey(p, "x") + 1 === p.x + 1 || Number.isNaN(p.x)));
}

// What the types do not allow, done through `any`: other values in those fields, deletion, redefinition.
{
  const f: any = new Flags(8);
  f.on = "yes"; f.ratio = "much"; f.off = undefined; f.whole = null; f.orNull = 0; f.orNullNumber = false;
  say("other values", readAll(f));
  f.on = false; f.ratio = 0.25; say("back", readAll(f));
  const g: any = new Flags(9);
  delete g.on; delete g.ratio; say("deleted", [readAll(g), "on" in g, Object.keys(g).join()]);
  g.on = true; g.ratio = 7.5; say("again", [readAll(g), Object.keys(g).join()]);
  const h: any = new Flags(10);
  let reads = 0;
  Object.defineProperty(h, "on", { get() { reads++; return "got"; }, configurable: true, enumerable: true });
  Object.defineProperty(h, "ratio", { value: 99.5, writable: false, enumerable: false });
  say("redefined", [readAll(h), reads, Object.keys(h).join()]);
  const frozen: any = Object.freeze(new Point(1.5, 2.5, true));
  say("frozen", readAll(frozen).slice(9, 12));
  const below: any = Object.create(new Point(3.5, 4.5, false));
  say("from above", [below.x, below.visible, readByKey(below, "y"), Object.keys(below).length]);
  below.visible = true; say("shadowed", [below.visible, Object.getPrototypeOf(below).visible]);
}

// Many rounds, so that whatever learns has learned, and collections in between.
{
  let t = 0, n = 0;
  for (let round = 0; round < 60; round++) {
    const fresh: any[] = [];
    for (let i = 0; i < 300; i++) fresh.push(i % 2 ? new Flags(i + round) : new Point(i + 0.25, round, (i + round) % 3 === 0));
    const [a, b] = sum(fresh); t += a; n += b;
  }
  say("rounds", [t, n]);
}

console.log(lines.join("\n"));
//// booleans-and-doubles-stored-by-name.ts
// Fields that lie unboxed in their objects (booleans, doubles) stored by code that knows nothing of the object: in code that runs once, in code that comes again, in strict and sloppy code, by definition.
// What is read back must be what was stored, whatever it was, and the keys must keep the order in which the properties came.

const lines: string[] = [];
function show(value: unknown): string {
  if (typeof value === "number") return Object.is(value, -0) ? "-0" : String(value);
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "function") return "a function";
  if (typeof value === "object" && value) return "{" + Object.keys(value).map(k => k + ":" + show((value as any)[k])).join(",") + "}";
  return String(value);
}
function say(label: string, ...values: unknown[]) { lines.push(label + ": " + values.map(show).join(" ")); }

type Settings = { on: boolean; ratio: number; maybe?: boolean; perhaps?: number; label: string };
function make(i: number): Settings {
  const s: Settings = { on: i % 2 === 0, ratio: i + 0.5, label: "s" + i };
  if (i % 3 === 0) s.maybe = i % 6 === 0;
  if (i % 4 === 0) s.perhaps = i / 8;
  return s;
}
class Flags {
  on: boolean; ratio: number; maybe?: boolean; perhaps?: number;
  constructor(i: number) { this.on = i % 2 === 1; this.ratio = i / 4; if (i % 5 === 0) this.maybe = true; if (i % 7 === 0) this.perhaps = -i; }
}
const hide = (v: unknown): any => new CustomEvent("x", { detail: v }).detail;

// Nothing here says what `o` is.
function storeAll(o: any, flag: unknown, number: unknown) { o.on = flag; o.ratio = number; o.maybe = flag; o.perhaps = number; }
function readAll(o: any) { return [o.on, o.ratio, o.maybe, o.perhaps]; }
const sloppyStore = new Function("o", "flag", "number", "o.on = flag; o.ratio = number; o.maybe = flag; o.perhaps = number;") as (o: any, flag: unknown, number: unknown) => void;

// Every kind of value, into slots that are filled and slots that are empty.
const flags: unknown[] = [true, false, undefined, null, 0, 1, "true", {}, Symbol.iterator === Symbol.iterator];
const numbers: unknown[] = [0, -0, 1, -1, 0.5, 2147483647, -2147483648, 2147483648, 4294967296, 1e308, 5e-324, NaN, Infinity, -Infinity, undefined, null, true, "7", 10n, { valueOf() { return 3; } }];
for (let i = 0; i < 12; i++) {
  for (const create of [make, (n: number) => new Flags(n)]) {
    const o = hide(create(i));
    const before = Object.keys(o).join();
    storeAll(o, flags[i % flags.length], numbers[(i * 3) % numbers.length]);
    say("stored " + i, before, o, ...readAll(o));
    storeAll(o, flags[(i + 4) % flags.length], numbers[(i * 5 + 1) % numbers.length]);
    say("again " + i, o);
    storeAll(o, i % 2 === 0, i * 1.5);
    say("back " + i, o);
  }
}
for (const number of numbers) { const o = hide(make(1)); o.ratio = number; o.perhaps = number; say("number", o.ratio, o.perhaps, typeof o.ratio, Object.keys(o).join()); }
for (const flag of flags) { const o = hide(make(1)); o.on = flag; o.maybe = flag; say("flag", o.on, o.maybe, typeof o.maybe, Object.keys(o).join()); }

// The order of the keys when the optional fields come late, and in the other order.
{ const o = hide(make(1)); o.perhaps = 1.5; o.maybe = false; say("perhaps first", Object.keys(o).join(), o); }
{ const o = hide(make(1)); o.maybe = true; o.extra = 1; o.perhaps = 2; say("an extra between", Object.keys(o).join(), o); }
{ const o = hide(make(12)); delete o.maybe; delete o.ratio; o.ratio = 9.25; o.maybe = true; say("deleted and given again", Object.keys(o).join(), o); }

// Objects that may not be stored to.
function attempt(label: string, o: any, store: (o: any, flag: unknown, number: unknown) => void) {
  let thrown = "nothing thrown";
  try { store(o, true, 3.5); } catch (e) { thrown = (e as Error).constructor.name; }
  say(label, thrown, o, Object.keys(o).join());
}
for (const [name, store] of [["strict", storeAll], ["sloppy", sloppyStore]] as const) {
  attempt(name + " frozen", hide(Object.freeze(make(12))), store);
  attempt(name + " frozen, fields missing", hide(Object.freeze(make(1))), store);
  attempt(name + " sealed", hide(Object.seal(make(12))), store);
  attempt(name + " sealed, fields missing", hide(Object.seal(make(1))), store);
  attempt(name + " not extensible, fields missing", hide(Object.preventExtensions(make(1))), store);
  const readOnly = make(12); Object.defineProperty(readOnly, "on", { writable: false }); Object.defineProperty(readOnly, "perhaps", { value: 1, writable: false });
  attempt(name + " read-only", hide(readOnly), store);
  const seen: unknown[] = [];
  const accessors = make(12); Object.defineProperty(accessors, "ratio", { set(v) { seen.push(v); }, get() { return "got"; }, enumerable: true }); Object.defineProperty(accessors, "maybe", { get() { return "only a getter"; }, enumerable: true });
  attempt(name + " accessors", hide(accessors), store); say(name + " the setter saw", ...seen);
}

// What stands above the object decides about a field that the object does not have yet.
class Watched { on = false; ratio = 0.5; maybe?: boolean; perhaps?: number; }
const caught: unknown[] = [];
{
  const before = hide(new Watched()); storeAll(before, true, 1.25); say("nothing above", before);
  Object.defineProperty(Watched.prototype, "maybe", { set(v) { caught.push("maybe", v); }, configurable: true });
  Object.defineProperty(Watched.prototype, "perhaps", { value: 7, writable: false, configurable: true });
  const o = hide(new Watched());
  attempt("a setter and a read-only property above", o, storeAll); say("caught", ...caught, o.perhaps);
  sloppyStore(o, false, 2.5); say("sloppy", o, ...caught);
  Object.defineProperty(o, "maybe", { value: true, writable: true, enumerable: true, configurable: true }); Object.defineProperty(o, "perhaps", { value: 4.5, writable: true, enumerable: true, configurable: true });
  storeAll(o, false, 8.5); say("defined on the object itself", o, Object.keys(o).join());
  delete (Watched.prototype as any).maybe; delete (Watched.prototype as any).perhaps;
  const after = hide(new Watched()); storeAll(after, true, 6.5); say("nothing above again", after);
}
{
  const o = hide(make(1)); Object.setPrototypeOf(o, { set maybe(v: unknown) { caught.push("other prototype", v); } }); o.maybe = true; o.perhaps = 0.25; say("another prototype", o, caught[caught.length - 1]);
  const below = Object.create(hide(make(12))); below.on = "own"; below.ratio = 1; say("an object below", Object.keys(below).join(), below.on, Object.getPrototypeOf(below).on);
}

// Definitions: an object literal's spread, Object.assign, a class field on an object that a base constructor returns.
{
  const target = hide(make(1)); Object.assign(target, { maybe: false, perhaps: -0, on: null, ratio: "text" }); say("assigned", target);
  class Base { constructor(o: object) { return o; } }
  class Stamps extends Base { on = true; ratio = 12.5; maybe = false; perhaps = NaN; }
  say("class fields on a given object", new Stamps(hide(make(1))), new Stamps(hide(make(12))));
  let thrown = "nothing thrown"; try { new Stamps(hide(Object.freeze(make(12)))); } catch (e) { thrown = (e as Error).constructor.name; } say("class fields on a frozen object", thrown);
}

// Receivers that are no such objects.
for (const other of [{ on: 1 }, [], function () {}, new Map(), Object.create(null)]) { const o = hide(other); storeAll(o, true, 0.5); say("another receiver", ...readAll(o)); }
for (const primitive of [1, "s", true, Symbol.iterator, 1n]) { let thrown = "nothing thrown"; try { storeAll(hide(primitive), true, 0.5); } catch (e) { thrown = (e as Error).constructor.name; } sloppyStore(hide(primitive), true, 0.5); say("a primitive", thrown); }
for (const nothing of [undefined, null]) { let thrown = "nothing thrown"; try { storeAll(hide(nothing), true, 0.5); } catch (e) { thrown = (e as Error).constructor.name; } say("nothing", thrown); }

// Code that comes again and again, over many objects of both kinds, so that whatever remembers a site gets to remember it.
const rounds = Number(process.argv[2] ?? 300);
const many: any[] = [];
for (let i = 0; i < 64; i++) many.push(hide(i % 2 ? make(i) : new Flags(i)));
let total = 0, yes = 0;
for (let r = 0; r < rounds; r++) {
  for (let i = 0; i < many.length; i++) {
    const o = r % 16 === 15 ? (many[i] = hide(i % 2 ? make(i + r) : new Flags(i + r))) : many[i];
    storeAll(o, (i + r) % 3 === 0, (i + r) % 5 === 0 ? i + r : (i + r) / 16);
    if (o.on === true && o.maybe === true) yes++;
    total += o.ratio + o.perhaps;
  }
}
say("many", total, yes, many[0], many[1], many[63]);
console.log(lines.join("\n"));
//// built-ins-that-copy-or-restrict-properties-in-a-validating-build.js
// Object.assign and a spread copy an object that holds itself, or that holds the target or another operand. Object.freeze, seal and preventExtensions are applied to objects with accessors and to arguments objects. What a program can see is what plain Bun shows, and a validating build has nothing to find.
function show(what, f) { let last; for (let round = 0; round < 50; round++) last = f(); console.log(what, JSON.stringify(last)); }
show("the source holds itself", () => { const a = {}, b = { x: 1 }; b.me = b; Object.assign(a, b); return [a.me === b, a.x, Object.keys(a)]; });
show("the source holds the target", () => { const a = { y: 2 }, b = { x: 1 }; b.other = a; Object.assign(a, b); return [a.other === a, a.x, a.y]; });
show("one source holds the next", () => { const a = {}, c = { z: 3 }, b = { next: c }; Object.assign(a, b, c); return [a.next === c, a.z]; });
show("late fields", () => { const a = {}, b = {}; for (let i = 0; i < 12; i++) b["f" + i] = i; b.self = b; Object.assign(a, b); return [a.self === b, Object.keys(a).length]; });
show("a spread of an object that holds itself", () => { const b = { x: 1 }; b.me = b; const a = { ...b }; return [a.me === b, a !== b]; });
show("under a symbol", () => { const key = Symbol.for("self"); const a = {}, b = {}; b[key] = b; Object.assign(a, b); return a[key] === b; });
show("an array that holds itself", () => { const a = {}, b = [1]; b.push(b); Object.assign(a, b); return [a[1] === b, a[0]]; });
function frozen() { return [Object.isFrozen(Object.freeze(arguments)), arguments.length, arguments[0]]; }
function sealed() { return [Object.isSealed(Object.seal(arguments)), arguments.length, arguments[1]]; }
function closed() { return [Object.isExtensible(Object.preventExtensions(arguments)), arguments.length]; }
function described() { const before = Object.getOwnPropertyDescriptor(arguments, "callee"); Object.freeze(arguments); const after = Object.getOwnPropertyDescriptor(arguments, "callee"); return [before.get === after.get, before.set === after.set, after.configurable, after.enumerable, Object.getOwnPropertyNames(arguments)]; }
show("arguments, frozen", () => frozen(1, 2));
show("arguments, sealed", () => sealed(1, 2));
show("arguments, closed", () => closed(1, 2));
show("arguments, the accessor under callee", () => described(1, 2));
show("an accessor, frozen", () => { const get = () => 1, set = () => {}; const o = Object.defineProperty({ x: 1 }, "a", { get, set, configurable: true, enumerable: true }); Object.freeze(o); const d = Object.getOwnPropertyDescriptor(o, "a"); return [d.get === get, d.set === set, d.configurable, o.a, Object.isFrozen(o)]; });
show("an accessor, sealed", () => { const get = () => 1; const o = Object.defineProperty({ x: 1 }, "a", { get, configurable: true }); Object.seal(o); const d = Object.getOwnPropertyDescriptor(o, "a"); return [d.get === get, d.set, d.configurable, Object.isSealed(o)]; });
show("an accessor, defined anew with the same functions", () => { const get = () => 1; const o = Object.defineProperty({}, "a", { get, configurable: true }); Object.defineProperty(o, "a", { get }); return Object.getOwnPropertyDescriptor(o, "a").get === get; });
show("an accessor, defined anew with another function", () => { const o = Object.defineProperty({}, "a", { get: () => 1, configurable: true }); Object.defineProperty(o, "a", { get: () => 2 }); return o.a; });
//// by-name-access-to-wide-layouts.ts
// Reads, writes, `in` and `hasOwnProperty` by names computed at run time on layouts with few and many fields, past the size of the field cache.
const registered: unique symbol = Symbol.for("x")
const fresh: unique symbol = Symbol("fresh")
interface Wide { f0: number; f1: number; f2: number; f3: number; f4: number; f5: number; f6: number; f7: number; f8: number; f9: number; f10: number; f11: number; f12: number; f13: number; f14: number; f15: number; f16: number; f17: number; f18: number; f19: number; f20: number; f21: number; f22: number; f23: number; f24: number; f25: number; f26: number; f27: number; f28: number; f29: number; f30: number; f31: number; f32: number; f33: number; f34: number; f35: number; f36: number; f37: number; f38: number; f39: number; }
interface Narrow { a: number; b: number; c: number }
interface Keyed { title: string; [Symbol.iterator]: () => Iterator<number>; [registered]: number; [fresh]: number }

const createWide = (): Wide => ({ f0: 0, f1: 1, f2: 2, f3: 3, f4: 4, f5: 5, f6: 6, f7: 7, f8: 8, f9: 9, f10: 10, f11: 11, f12: 12, f13: 13, f14: 14, f15: 15, f16: 16, f17: 17, f18: 18, f19: 19, f20: 20, f21: 21, f22: 22, f23: 23, f24: 24, f25: 25, f26: 26, f27: 27, f28: 28, f29: 29, f30: 30, f31: 31, f32: 32, f33: 33, f34: 34, f35: 35, f36: 36, f37: 37, f38: 38, f39: 39 })
const createNarrow = (): Narrow => ({ a: 1, b: 2, c: 3 })
const createKeyed = (): Keyed => ({ title: "keyed", [Symbol.iterator]: () => [1, 2][Symbol.iterator](), [registered]: 10, [fresh]: 20 })

function read(target: any, key: PropertyKey): unknown { return target[key] }
function write(target: any, key: PropertyKey, value: unknown) { target[key] = value }
function has(target: any, key: PropertyKey): boolean { return key in target }
function hasOwn(target: any, key: PropertyKey): boolean { return target.hasOwnProperty(key) }
function probe(title: string, target: any, key: PropertyKey) {
  const value = read(target, key)
  console.log(title, typeof value === "function" ? "function" : String(value), has(target, key), hasOwn(target, key))
}

const wide = createWide()
let sum = 0
for (let i = 0; i < 40; i++) {
  const name = "f" + i
  sum += read(wide, name) as number
  if (!has(wide, name) || !hasOwn(wide, name)) console.log("missing", name)
  write(wide, name, i * 2)
}
console.log("wide", sum, wide.f0, wide.f1, wide.f20, wide.f39, Object.keys(wide).length)

const narrow = createNarrow()
for (const name of ["a", "b", "c"]) {
  probe("narrow " + name, narrow, name)
  write(narrow, name, (read(narrow, name) as number) + 10)
}
console.log("narrow", narrow.a, narrow.b, narrow.c, Object.keys(narrow).join())

let found = 0
for (let i = 0; i < 5000; i++) {
  const name = "missing" + i
  for (const target of [wide, narrow]) {
    if (read(target, name) !== undefined || has(target, name) || hasOwn(target, name)) found++
  }
}
console.log("missing names found", found)
for (let i = 0; i < 40; i += 13) probe("wide again f" + i, wide, "f" + i)
probe("narrow again c", narrow, ["c"].join(""))

const rope = (left: string, right: string) => left + right
const prefix = JSON.parse('"f"') as string
probe("rope on wide", wide, rope(prefix, String(7)))
probe("rope on narrow", createNarrow(), rope(["a"].join(""), ""))
write(wide, rope(prefix, String(8)), 100)
console.log("stored by rope", wide.f8)
for (const target of [wide, narrow]) {
  probe("index name", target, "0")
  probe("__proto__", target, "__proto__")
  probe("constructor", target, "constructor")
}

const other = Symbol("other")
for (const key of [Symbol.iterator, Symbol.for("x"), fresh, other, Symbol.asyncIterator, Symbol.for("y")]) {
  for (const [title, create] of [["wide", createWide], ["narrow", createNarrow], ["keyed", createKeyed]] as [string, () => object][]) {
    const target = create()
    probe(title + " " + String(key), target, key)
    write(target, key, 5)
    probe(title + " stored " + String(key), target, key)
    console.log(Object.getOwnPropertySymbols(target).map(String).join(), Object.keys(target).length)
  }
}
console.log([...createKeyed()].join())

const additions = createWide() as any
for (let i = 40; i < 44; i++) write(additions, "f" + i, i)
write(additions, "0", "index")
console.log(Object.keys(additions).slice(0, 3).join(), Object.keys(additions).slice(-3).join(), has(additions, "f43"), hasOwn(additions, "f44"))
//// callbacks-of-native-built-ins.js
// A closure handed to a built-in that native code implements is called by native code.
const lines = [];
////= printer

{
  const print = printer("finalization");
  const o = { valueOf: (a, b) => 5 };
  print(o + 1);
}
{
  const print = printer("map-foreach");
  const t = new Uint8Array(2);
  t.forEach((v, i) => print(i));
}
{
  const print = printer("getter-defined");
  const t = {};
  Object.defineProperty(t, "x", { get: () => 44 });
  print(t.x);
}
{
  const print = printer("proxy-get");
  print(new Proxy({}, { get: () => 42 }).x);
}
{
  const print = printer("arrow-none");
  print(JSON.parse('1', () => 5));
}
{
  const print = printer("arrow-three");
  print(JSON.parse('{"a":1}', (k, v, c) => typeof v === "number" ? v + 1 : v).a);
}
{
  const print = printer("arrow");
  print(JSON.parse('{"a":1}', (k, v) => typeof v === "number" ? v + 1 : v).a);
}
{
  const print = printer("declaration");
  function revive(k, v) { return typeof v === "number" ? v + 1 : v; }
  print(JSON.parse('{"a":1}', revive).a);
}
{
  const print = printer("function");
  print(JSON.parse('{"a":1}', function (k, v) { return typeof v === "number" ? v + 1 : v; }).a);
}
{
  const print = printer("this");
  print(JSON.parse('{"a":1}', function (k, v) { return k === "" ? v : typeof this; }).a);
}
{
  const print = printer("replacer");
  print(JSON.stringify({ a: 1 }, (k, v) => typeof v === "number" ? v + 1 : v));
}
{
  const print = printer("then-extra");
  async function g() { return 4; }
  g().then(() => print("no parameter"));
}
{
  const print = printer("then");
  async function g() { return 4; }
  g().then(v => print(v));
}

await new Promise(resolve => setTimeout(resolve, 0));
console.log(lines.join("\n"));
//// callee-of-strict-arguments-is-read-stored-deleted-and-walked-over.js
"use strict";
// `callee` of the arguments of strict code is an accessor that throws: a read, a store and a deletion throw a TypeError, a walk over enumerable properties passes it by. Each question stands in place.
function readByName() {
  let said;
  try { const got = arguments.callee; said = "returned " + typeof got; } catch (error) { said = error.constructor.name; }
  console.log("read by name", said);
}
function readAndDropped() {
  let said = "returned";
  try { arguments.callee; } catch (error) { said = error.constructor.name; }
  console.log("read and dropped", said);
}
function storeByName() {
  let said = "returned";
  try { arguments.callee = 1; } catch (error) { said = error.constructor.name; }
  console.log("store by name", said);
}
function readByKey(key) {
  let said;
  try { const got = arguments[key]; said = "returned " + typeof got; } catch (error) { said = error.constructor.name; }
  console.log("read by key", said);
}
function storeByKey(key) {
  let said = "returned";
  try { arguments[key] = 1; } catch (error) { said = error.constructor.name; }
  console.log("store by key", said);
}
function asked() {
  console.log("has own", Object.hasOwn(arguments, "callee"), "callee" in arguments);
  console.log("names", Object.getOwnPropertyNames(arguments).join());
  console.log("keys", Object.keys(arguments).join());
  let said = "returned";
  try { Object.assign({}, arguments); } catch (error) { said = error.constructor.name; }
  console.log("assign", said);
  said = "returned";
  try { Reflect.get(arguments, "callee"); } catch (error) { said = error.constructor.name; }
  console.log("reflect get", said);
  said = "returned";
  try { const { callee } = arguments; said = "returned " + typeof callee; } catch (error) { said = error.constructor.name; }
  console.log("destructured", said);
  console.log("deleted", delete arguments.callee === false ? "refused" : "gone");
}
function deleted() {
  let said;
  try { said = "returned " + delete arguments.callee; } catch (error) { said = error.constructor.name; }
  console.log("delete", said);
}
const name = ["cal", "lee"].join("");
readByName(1); readAndDropped(1); storeByName(1); readByKey(name); storeByKey(name); deleted(1);
try { asked(1, 2); } catch (error) { console.log("asked threw", error.constructor.name); }
//// cells-over-8-kb-are-allocated-again-and-again.js
// Generated. A cell beyond MarkedSpace::largeCutoff (about 8 KB) has no size class, so compiled code never finds room for it and leaves it to the run time, at the first allocation and at every later one.
// 1100 members of 8 bytes each: an object literal, an instance of a class, an environment, and a closure that captures constants. Each is made five times, with collections in between.
