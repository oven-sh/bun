}
say("computed keys", describe(literal("middle", 7, 10)));
say("a computed __proto__ does not set the prototype", Object.getPrototypeOf(literal("middle", 7, 10)) === Object.prototype);

function repeated(key, i) {
  return { a: i, [key]: i + 1, b: i + 2, [key]: i + 3, c: i + 4 };
}
for (const key of ["k", "a", "b", "c", tag, 3, "3", "__proto__"]) say("defined twice, " + keyText(key), describe(repeated(key, 0)));

function between(key) {
  return { before: 0, [key]: "here", after: 1 };
}
const keyKinds = [
  0, -0, 1, 1.5, -1, 4294967294, 4294967295, 4294967296, 1e21, 1e-7, NaN, Infinity, true, null, undefined, 10n, "", "a b", [1, 2],
  { toString() { return "from toString"; } },
  { [Symbol.toPrimitive]() { return tag; } },
  Symbol.iterator, Symbol.for("registered"), Symbol(),
];
keyKinds.forEach((key, index) => say("key kind " + index, describe(between(key))));

const order = [];
function keyNamed(name) {
  return { toString() { order.push("key " + name); return name; } };
}
function noted(value) {
  order.push("value " + value);
  return value;
}
const ordered = { [keyNamed("x")]: noted(1), [keyNamed("y")]: noted(2), [keyNamed("x")]: noted(3) };
say("each key is converted before its value is evaluated", order.join(", ") + " | " + describe(ordered));
order.length = 0;
const thrown = attempt(() => describe({ a: noted("a"), [{ toString() { throw new RangeError("no key"); } }]: noted("never"), b: noted("never either") }));
say("a key that throws", thrown + " | " + order.join(", "));

const names = ["alpha", "beta", "gamma", "delta"];
const orders = new Set();
let total = 0;
for (let i = 0; i < 100; i++) {
  const text = names[i % names.length];
  const object = literal(text, i % 2, i);
  orders.add(Reflect.ownKeys(object).map(keyText).join());
  total += object.first + object[text] + object[tag] + object[i % 2] + object["__proto__"] + object.last;
}
say("constant strings as keys, 100 literals", total + " | " + [...orders].sort().join(" | "));

orders.clear();
total = 0;
for (let i = 0; i < 100; i++) {
  const built = "built" + (i % 3);
  const object = { [built]: i, [`templated${i % 2}`]: i + 1, [built + "!"]: i + 2, [String(i % 2)]: i + 3 };
  orders.add(Reflect.ownKeys(object).map(keyText).join());
  total += object[built] + object["templated" + (i % 2)] + object[built + "!"] + object[i % 2];
}
say("strings built at run time as keys, 100 literals", total + " | " + [...orders].sort().join(" | "));

function classWith(first, second) {
  return class {
    before = "before";
    [first] = "first";
    [second] = "second";
    after = "after";
    static [first] = "static first";
    static [second] = "static second";
  };
}
const fieldKeys = [["one", "two"], ["same", "same"], ["before", "after"], ["after", "before"], [tag, Symbol.for("registered")], [1, 0], ["__proto__", "constructor"], ["name", "length"]];
for (const [first, second] of fieldKeys) {
  const WithFields = classWith(first, second);
  let last;
  for (let i = 0; i < 100; i++) last = new WithFields();
  say("fields " + keyText(first) + " and " + keyText(second), describe(last) + " | static: " + describeKey(WithFields, first) + ", " + describeKey(WithFields, second));
}

class Returns {
  constructor(target) {
    return target;
  }
}
////= lines-162	DefinesAlpha	Returns	alpha	"by name"
function definerOf(key) {
  return class extends Returns {
    [key] = "by key";
  };
}
////= Point-2
const targetKeys = ["alpha", "x", tag, 0, 5, "length", "__proto__"];
const definers = new Map(targetKeys.map(key => [key, definerOf(key)]));
function define(definer, target) {
  return attempt(() => {
    new definer(target);
    return "defined";
  });
}
const targets = [
  ["an empty object", () => ({})],
  ["an object with the property", () => ({ alpha: "old", omega: "old" })],
  ["a frozen object", () => Object.freeze({ alpha: "old" })],
  ["a sealed object", () => Object.seal({ alpha: "old" })],
  ["a non-extensible object", () => Object.preventExtensions({ alpha: "old" })],
  ["a read-only property", () => Object.defineProperty({}, "alpha", { value: "old", configurable: true })],
  ["a getter", () => ({ get alpha() { return "old"; } })],
  ["an object without a prototype", () => Object.create(null)],
  ["a class instance", () => new Point(1, 2)],
  ["a frozen class instance", () => Object.freeze(new Point(1, 2))],
  ["a non-extensible class instance", () => Object.preventExtensions(new Point(1, 2))],
  ["an array", () => ["old", "old"]],
  ["a frozen array", () => Object.freeze(["old", "old"])],
  ["a typed array", () => new Uint8Array(2)],
];
for (const [label, create] of targets) {
  const named = create();
  say(label + ", alpha by name", define(DefinesAlpha, named) + " | " + describe(named));
  for (const key of targetKeys) {
    const target = create();
    say(label + ", " + keyText(key), define(definers.get(key), target) + " | " + describe(target));
  }
}

const otherKeys = ["alpha", tag, "name", "length", "prototype", "displayName", "declared", "message", "stack"];
const otherDefiners = new Map(otherKeys.map(key => [key, definerOf(key)]));
const otherTargets = [
  ["a function", () => function target() {}],
  ["an arrow function", () => () => {}],
  ["a bound function", () => function target() {}.bind(null)],
  ["a class", () => class Target { static declared = "old"; }],
  ["an error", () => new RangeError("old")],
  ["a Map", () => new Map()],
];
for (const [label, create] of otherTargets) {
  for (const key of otherKeys) {
    const target = create();
    say(label + ", " + keyText(key), define(otherDefiners.get(key), target) + " | " + describeKey(target, key) + " | " + Object.keys(target).join());
  }
}

function watched(target, allows) {
  const log = [];
  const proxy = new Proxy(target, {
    defineProperty(inner, key, descriptor) {
      log.push("defineProperty " + keyText(key) + " " + JSON.stringify(descriptor));
      return allows && Reflect.defineProperty(inner, key, descriptor);
    },
    set(inner, key) {
      log.push("set " + keyText(key));
      return true;
    },
    getOwnPropertyDescriptor(inner, key) {
      log.push("getOwnPropertyDescriptor " + keyText(key));
      return Reflect.getOwnPropertyDescriptor(inner, key);
    },
  });
  return { proxy, log };
}
for (const allows of [true, false]) {
  const label = allows ? "a Proxy whose trap succeeds" : "a Proxy whose trap returns false";
  const inner = { alpha: "old" };
  const { proxy, log } = watched(inner, allows);
  say(label + ", alpha by name", define(DefinesAlpha, proxy) + " | " + log.join("; "));
  for (const key of targetKeys) {
    log.length = 0;
    say(label + ", " + keyText(key), define(definers.get(key), proxy) + " | " + log.join("; "));
  }
  say(label + ", its target", describe(inner));
}

const extraDefiners = ["extra", "more", tag, "y"].map(definerOf);
total = 0;
orders.clear();
for (let i = 0; i < 100; i++) {
  const point = new Point(i, -i);
  for (const definer of extraDefiners) new definer(point);
  orders.add(describe(point).replaceAll(String(i), "i"));
  total += point.x + point.extra.length + point.more.length + point[tag].length + point.y.length;
}
say("undeclared names on 100 class instances", total + " | " + [...orders].join(" | "));

const calls = [];
const parent = {
  set watched(value) {
    calls.push(value);
  },
  get watched() {
    return "inherited";
  },
};
Object.defineProperty(parent, "fixed", { value: "inherited", enumerable: true });
function definedOver(key, value) {
  return { __proto__: parent, [key]: value };
}
function assignedOver(key, value) {
  "use strict";
  const object = { __proto__: parent };
  object[key] = value;
  return object;
}
let ownAfterDefinition = 0;
let ownAfterAssignment = 0;
for (let i = 0; i < 100; i++) {
  if (Object.hasOwn(definedOver("watched", i), "watched")) ownAfterDefinition++;
  if (Object.hasOwn(assignedOver("watched", i), "watched")) ownAfterAssignment++;
}
say("over an inherited setter", ownAfterDefinition + " definitions created an own property, " + ownAfterAssignment + " assignments did, the setter ran " + calls.length + " times");
say("over an inherited read-only property, defined", describe(definedOver("fixed", 1)));
say("over an inherited read-only property, assigned", attempt(() => describe(assignedOver("fixed", 1))));
say("no inherited property, defined and assigned", describe(definedOver("free", 1)) + " | " + describe(assignedOver("free", 1)));

calls.length = 0;
class Watches {
  set watched(value) {
    calls.push("watched " + value);
  }
  set [tag](value) {
    calls.push("tag " + value);
  }
}
class DefinesOverSetters extends Watches {
  watched = 1;
  [tag] = 2;
}
class AssignsToSetters extends Watches {
  constructor() {
    super();
    this.watched = 1;
    this[tag] = 2;
  }
}
say("fields over inherited setters", describe(new DefinesOverSetters()) + " | " + calls.join(", "));
say("assignments to inherited setters", describe(new AssignsToSetters()) + " | " + calls.join(", "));

console.log(lines.join("\n"));
//// definitions-in-literals-that-nobody-else-holds.ts
// Literals whose later definitions are made one by one: more fields than an allocation takes, values that are computed in between, code that runs once and code that runs often.
// While a literal is built nobody else has it. Afterwards everything may happen to it: a store of another type, a redefinition, a delete, a freeze. The keys keep the order of the source.
const lines: string[] = [];
const show = (label: string, value: unknown) => lines.push(label + ": " + (typeof value === "string" ? value : JSON.stringify(value)));
const keysOf = (object: object) => Reflect.ownKeys(object).map(String).join();
let calls = 0;
function next(): number { return ++calls; }

function large(start: number) { return { f0: start + 0, f1: start + 1, f2: start + 2, f3: Symbol.iterator, f4: start + 4, f5: "s5", f6: start + 6, f7: start + 7, f8: start + 8, f9: start + 9, f10: Symbol.iterator, f11: start + 11, f12: "s12", f13: start + 13, f14: start + 14, f15: start + 15, f16: start + 16, f17: Symbol.iterator, f18: start + 18, f19: "s19", f20: start + 20, f21: start + 21, f22: start + 22, f23: start + 23, f24: Symbol.iterator, f25: start + 25, f26: "s26", f27: start + 27, f28: start + 28, f29: start + 29, f30: start + 30, f31: Symbol.iterator, f32: start + 32, f33: "s33", f34: start + 34, f35: start + 35, f36: start + 36, f37: start + 37, f38: Symbol.iterator, f39: start + 39, f40: "s40", f41: start + 41, f42: start + 42, f43: start + 43, f44: start + 44, f45: Symbol.iterator, f46: start + 46, f47: "s47", f48: start + 48, f49: start + 49, f50: start + 50, f51: start + 51, f52: Symbol.iterator, f53: start + 53, f54: "s54", f55: start + 55, f56: start + 56, f57: start + 57, f58: start + 58, f59: Symbol.iterator, f60: start + 60, f61: "s61", f62: start + 62, f63: start + 63, f64: start + 64, f65: start + 65, f66: Symbol.iterator, f67: start + 67, f68: "s68", f69: start + 69, f70: start + 70, f71: start + 71, f72: start + 72, f73: Symbol.iterator, f74: start + 74, f75: "s75", f76: start + 76, f77: start + 77, f78: start + 78, f79: start + 79 }; }
const once = large(1000);
show("large, once", keysOf(once).length + " " + once.f0 + " " + String(once.f3) + " " + once.f5 + " " + once.f79 + " " + Object.keys(once).slice(60, 70).join());
let total = 0;
for (let i = 0; i < 300; i++) total += large(i).f79 + Object.keys(large(i)).length;
show("large, often", total);

type Wide = { a: number; b: string; c: symbol; d?: number; e?: string };
function computedBetween(): Wide { return { a: next(), b: String(next()), c: Symbol.for("c" + next()), d: next(), e: "e" + next() }; }
const built = computedBetween();
show("computed in between", keysOf(built) + " " + built.a + built.b + String(built.c) + built.d + built.e);

// Afterwards the fields leave their slots, and the next literal of the same place starts afresh.
const loose = built as any;
loose.c = 12; loose.a = "text"; delete loose.b; Object.defineProperty(loose, "d", { get() { return "getter"; }, enumerable: true, configurable: true });
show("changed afterwards", keysOf(loose) + " " + loose.a + " " + loose.b + " " + loose.c + " " + loose.d);
Object.freeze(loose);
const again = computedBetween();
show("the next one", keysOf(again) + " " + again.a + again.b + String(again.c) + again.d + again.e + " " + Object.isFrozen(again));

// What is no plain definition: a spread, a computed key that spells a later name, an accessor beside the names, another prototype, a value of another type. (A name twice and an accessor under a name that is also defined: the program beside this one, in JavaScript.)
const source = { d: "from the spread", z: 1 } as any;
function withSpread(i: number): any { return { a: i, ...source, d: i + 1, e: "e" }; }
function withSpreadBehind(i: number): any { return { a: i, d: i + 1, ...source, e: "e" }; }
function withComputedKey(key: string, i: number): any { return { a: i, [key]: "computed", d: i + 1, e: "e" }; }
function withAccessorBeside(i: number): any { return { a: i, get other() { return "getter " + this.d; }, set other(value) { this.e = value; }, d: i + 1, e: "e" }; }
function withPrototype(i: number): any { return { __proto__: { set d(value: number) { lines.push("the setter ran"); }, inherited: true }, a: i, d: i + 1, e: "e" }; }
function otherType(i: number): Wide { return { a: i, b: "b", c: Symbol.iterator, d: ("not a number " + i) as any, e: (i * 2) as any }; }
for (const [label, make] of Object.entries({ withSpread, withSpreadBehind, withAccessorBeside, withPrototype, otherType })) {
  let last: any;
  for (let i = 0; i < 40; i++) last = make(i);
  show(label, keysOf(last) + " | " + String(last.d) + " | " + String(last.e) + " | " + JSON.stringify(Object.getOwnPropertyDescriptor(last, "d")) + " | " + String(last.inherited));
}
for (const key of ["d", "e", "x", "a", "0"]) show("computed key " + key, keysOf(withComputedKey(key, 5)) + " | " + JSON.stringify(withComputedKey(key, 5)));

// One definition gets a value that its field does not admit, so that field lies outside its slot while the definitions behind it are made.
type Mixed = { a: number; run(): number; b: number; c: number; d: string; e?: number };
function mixed(i: number, odd: unknown): Mixed { return { __proto__: null, a: i, run() { return this.a + this.c; }, b: odd as number, c: i + 1, d: "d" + i, e: odd as number } as Mixed; }
function mixedBesideAccessor(i: number, odd: unknown): Mixed { return { get lazy() { return this.d; }, a: i, run() { return this.a + this.c; }, d: odd as string, b: i, c: i + 1 } as Mixed; }
for (const odd of [5, "text", undefined, null, 1.5, { object: 1 }, Symbol.iterator, -0, 2 ** 40, true]) {
  for (const make of [mixed, mixedBesideAccessor]) {
    let last = make(0, odd);
    for (let i = 1; i < 12; i++) last = make(i, odd);
    show(make.name + " " + String(odd), keysOf(last) + " | " + [last.a, last.b, last.c, last.d, last.e].map(String).join() + " | " + last.run() + " | " + Object.entries(Object.getOwnPropertyDescriptors(last)).map(([key, d]) => key + (d.writable ? "w" : "") + (d.enumerable ? "e" : "") + (d.configurable ? "c" : "")).join());
  }
}

// The value of a later definition throws, suspends, or looks at the world in between.
function throwsInBetween(i: number): Wide { return { a: i, b: "b", c: Symbol.iterator, d: i > 2 ? (() => { throw new RangeError("at " + i); })() : i, e: "e" }; }
for (let i = 0; i < 5; i++) { try { show("throws " + i, keysOf(throwsInBetween(i))); } catch (error) { show("throws " + i, (error as Error).message); } }
async function suspended(i: number): Promise<Wide> { return { a: i, b: await Promise.resolve("awaited"), c: Symbol.iterator, d: await Promise.resolve(i + 1), e: "e" }; }
function* yielded(i: number): Generator<number, Wide, number> { return { a: i, b: "b", c: Symbol.iterator, d: yield i, e: "e" + (yield i + 1) }; }
const generator = yielded(7); generator.next(); generator.next(70);
show("yielded", JSON.stringify(generator.next(71).value) );
show("nested", JSON.stringify({ outer: next(), inner: { a: next(), b: { c: next(), d: [next(), { e: next() }] } }, last: next() }));
show("suspended", JSON.stringify(await suspended(3), (key, value) => typeof value === "symbol" ? String(value) : value));
console.log(lines.join("\n"));
//// delete-optional-fields-via-any.ts
// `delete` of optional fields through a receiver of type `any`.
function normalize(given: any) {
  const params = given
  if (!params) return {}
  if (params?.message !== undefined) params.error = params.message
  delete params.message
  return params
}
function byKey(o: any, k: string) { delete o[k]; return o }
class Box { width = 1; height?: number = 2; label?: string = "b"; area() { return this.width * (this.height ?? NaN) } }
const a: { message?: string; error: string | undefined; code: number } = { message: "m", error: undefined, code: 7 }
const b: { message?: string; code: number; nested: { message?: string; keep: boolean } } = { message: "n", code: 8.5, nested: { message: "inner", keep: true } }
console.log(JSON.stringify(normalize(a)), "message" in a, a.message, Object.keys(a).join(), a.code + 1)
console.log(JSON.stringify(normalize(b)), JSON.stringify(normalize(b.nested)), b.code * 2, b.nested.keep)
const box = new Box()
console.log(JSON.stringify(byKey(box, "height")), box.area(), box.height, Object.hasOwn(box, "height"), box.label?.length)
box.height = 5
console.log(box.area(), JSON.stringify(box), Reflect.deleteProperty(box, "label"), box.label, Object.keys(box).join())
const frozen = Object.freeze({ message: "f" })
try { normalize(frozen) } catch (e) { console.log((e as Error).constructor.name) }
console.log(frozen.message)
//// deletion-of-one-field-leaves-the-others.js
// A deletion that names its key takes that field alone out of the object. The fields beside it stay where they are: reads, `in`, the order of the keys, a store that brings the field back,
// and a deletion under a computed key, which may take any of them.
function make(i) {
  return { cache: i, kept: i * 2, label: "n" + i };
}

const entry = make(1);
console.log(entry.kept, entry.cache, entry.label);
delete entry.cache;
console.log(entry.kept, entry.cache, entry.label, "cache" in entry, "kept" in entry, Object.keys(entry).join());
