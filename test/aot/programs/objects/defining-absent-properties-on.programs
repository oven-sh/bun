//// entries-of-literal-with-dictionary-spread.ts
// `Object.entries({ ...sent, 9: "tail" })`, where `sent` is a dictionary by number: TypeScript infers the values' type from the one written member and forgets what the spread brings. What is inferred never decides what the program does.
type Body = string | Uint8Array;
const sent: Record<number, Body> = { 1: new Uint8Array(2), 5: "five" };
const counts: { [index: number]: number | boolean } = { 1: true, 2: 2 };
const row = (name: string, f: () => unknown) => { let r: unknown; try { r = f(); } catch (e) { r = "THROWS " + (e as Error).message.split(" (bun")[0]; } console.log(name + ": " + JSON.stringify(r)); };
row("entries, taken apart in the parameter", () => Object.entries({ ...sent, 9: "tail" }).map(([number, content]) => [number, typeof content]));
row("entries, a parameter", () => Object.entries({ ...sent, 9: "tail" }).map(entry => typeof entry[1]));
row("entries, for..of", () => { const kinds: string[] = []; for (const [, content] of Object.entries({ ...sent, 9: "tail" })) kinds.push(typeof content); return kinds; });
row("values", () => Object.values({ ...sent, 9: "tail" }).map(content => typeof content));
row("values, kept first", () => { const all = Object.values({ ...counts, 9: 9 }); return all.map(n => typeof n); });
row("used as the type says", () => Object.entries({ ...sent, 9: "tail" }).map(([, content]) => content.length));
row("handed on", () => { const size = (text: unknown) => (typeof text === "string" ? text.length : -1); return Object.values({ ...sent, 9: "tail" }).map(content => size(content)); });
row("the spread behind the written member", () => Object.values({ 9: "tail", ...sent }).map(content => typeof content));
row("no spread: a fact as before", () => Object.values({ 1: "a", 9: "tail" }).map(content => content.length));
row("a spread of a literal: known", () => Object.values({ ...{ 1: "a" }, 9: "tail" }).map(content => content.length));
row("a dictionary by string", () => { const named: Record<string, Body> = { a: new Uint8Array(1) }; return Object.values({ ...named, b: "tail" }).map(content => typeof content); });
//// error-capture-stack-trace-on-a-class-and-on-records-with-and-without-a-stack-field.ts
// Error.captureStackTrace defines stack on an instance whose class declares it as a string, on a record that has it and on a record that lacks it.
class Failure { stack: string; code: number; constructor(code: number) { this.stack = "none"; this.code = code; } describe(): string { return this.stack.length > 4 ? "long" : this.stack; } }
type Plain = { stack: string; n: number };
type Bare = { a: number; b: string };
function plain(i: number): Plain { return { stack: "s" + i, n: i }; }
function bare(i: number): Bare { return { a: i, b: "b" + i }; }
const out: string[] = [];
for (let i = 0; i < 4; i++) {
  const f = new Failure(i), p = plain(i), b = bare(i);
  if (i >= 2) { (Error as any).captureStackTrace(f); (Error as any).captureStackTrace(p); (Error as any).captureStackTrace(b); }
  out.push([f.describe(), typeof f.stack, f.code, typeof p.stack, p.stack.startsWith("Error") || p.stack, p.n, b.a, b.b, typeof (b as any).stack, Object.keys(f).join(), Object.keys(p).join(), Object.keys(b).join(), Object.getOwnPropertyNames(b).join()].join(" "));
  f.stack = "again"; p.stack = "again";
  out.push(f.describe() + " " + p.stack + " " + JSON.stringify(p) + JSON.stringify(b));
}
console.log(out.join("\n"));
//// evaluated-text-stores-other-types-into-typed-variables.ts
// Evaluated text is one more writer of the variables it can see, and no type holds it back.
let count: number = 1;
let label: string = "one";
let on: boolean = true;
let point: { x: number; y: number } = { x: 1, y: 2 };
let callback: (value: number) => number = value => value + 1;

function describe(): string {
  return [typeof count, String(count), typeof label, String(label), typeof on, String(on), typeof point, JSON.stringify(point), typeof callback].join(" ");
}
function inner(): string {
  let total: number = 10;
  let name: string = "inner";
  let box: { value: number } = { value: 3 };
  const read = () => [typeof total, String(total), typeof name, String(name), JSON.stringify(box)].join(" ");
  const lines = [read()];
  eval("total = 'text'; name = 5; box = null");
  lines.push(read());
  eval("total = -0; name = undefined; box = [1]");
  lines.push(read() + " " + Object.is(total, -0));
  eval("total = 2 ** 31; name = 'back'; box = { value: 4 }");
  lines.push(read() + " " + (total + 1) + " " + name.length + " " + box.value);
  return lines.join("\n");
}
console.log(describe());
eval("count = 'text'; label = 7; on = null; point = 'none'; callback = 3");
console.log(describe());
eval("count = 0.5; label = undefined; on = 1; point = [1, 2]; callback = { call: 1 }");
console.log(describe());
eval("count = 3; label = 'three'; on = false; point = { x: 3, y: 4 }; callback = value => value * 2");
console.log(describe(), count + 1, label.length, point.x + point.y, callback(4));
console.log(inner());
//// exported-literal-accessors/files/lib.ts
let kept = 1;
export const own = { w: 1, get g() { return 2; } };
export const only = { get g() { return 3; } };
export const pair = { get x() { return kept; }, set x(v: number) { kept = v * 2; } };
export function make(n: number) { return { get g() { return n; } }; }
export const annotated: { g: number } = { get g() { return 4; } };
//// exported-literal-accessors/main.ts
// An object literal with getters and setters is exported from one file and used through a declared type in another.
import { own, only, pair, make, annotated } from "./files/lib.ts";
declare const console: any;
function line(name: string, f: () => unknown) { try { console.log(name, JSON.stringify(f())); } catch (e: any) { console.log(name, "THREW", e.constructor.name, String(e.message).slice(0, 70)); } }
const read = (p: { g: number }) => p.g;
line("own type, data beside", () => read(own));
line("own type, accessors only", () => read(only));
line("made by a function", () => [read(make(5)), read(make(6))]);
line("annotated over there", () => read(annotated));
line("directly", () => [own.g, own.w, only.g, annotated.g]);
line("a pair", () => { const p: { x: number } = pair; p.x = 4; return [p.x, pair.x]; });
line("assigned", () => { const seen: { g: number; w: number } = own; return seen.g + seen.w; });
line("in an array", () => { const all: { g: number }[] = [own, only, make(7), annotated, { g: 8 }]; return all.map(read); });
//// extra-property-reads-avoid-runtime.ts
// By-name reads of properties outside an object's layout (getters of a literal that also has data members, properties added later, absent names) are answered
// by the stubs without calling the runtime, for one object and for many. The jsc shell counts the calls; elsewhere the program checks the values alone.
declare const aotOperationCount: undefined | ((name: string) => number);
const operations = ["operationAOTGetById", "operationAOTGetByIdAndCache"];
function entered(): number { let sum = 0; if (typeof aotOperationCount === "function") for (const operation of operations) sum += aotOperationCount(operation); return sum; }
const lines: string[] = [];
function measure(label: string, reads: number, run: () => number): void {
    const before = entered();
    const result = run();
    const entries = entered() - before;
    lines.push(label + ": " + result + ", " + (entries * 20 < reads ? "few entries" : entries + " ENTRIES FOR " + reads + " READS"));
}
interface Point { x: number; readonly twice: number }
function point(x: number): Point { return { x, get twice() { return this.x * 2; } }; }
function twiceOf(from: any): number { return from.twice; }
function tagOf(from: any): unknown { return from.tag; }
function colorOf(from: any): unknown { return from.color; }
function anyTwiceOf(from: any): number { return from.twice; }

const one = point(3);
measure("getter of one object", 20000, () => { let sum = 0; for (let i = 0; i < 20000; i++) sum += twiceOf(one); return sum; });
const many: Point[] = [];
for (let i = 0; i < 200; i++) many.push(point(i));
measure("two hundred objects of the literal, in turn", 20000, () => { let sum = 0; for (let round = 0; round < 100; round++) for (const each of many) sum += twiceOf(each); return sum; });
measure("absent name", 20000, () => { let sum = 0; for (let round = 0; round < 100; round++) for (const each of many) if (tagOf(each) === undefined) sum++; return sum; });
for (const each of many) (each as any).color = each.x;
measure("property added later", 20000, () => { let sum = 0; for (let round = 0; round < 100; round++) for (const each of many) sum += colorOf(each) as number; return sum; });
const others: any[] = [JSON.parse('{"twice":1}'), JSON.parse('{"a":1,"twice":2}'), JSON.parse('{"a":1,"b":2,"twice":3}'), one];
measure("getter at a polymorphic site", 20000, () => { let sum = 0; for (let i = 0; i < 20000; i++) sum += anyTwiceOf(others[i & 3]); return sum; });
measure("new objects, each read once", 20000, () => { let sum = 0; for (let i = 0; i < 20000; i++) sum += twiceOf(point(i & 15)); return sum; });
console.log(lines.join("\n"));
//// extra-property-stores.ts
// Stores under names a class does not declare: adding, replacing, past the inline capacity, of young cells into old objects, after preventExtensions and freeze, over accessors, over a method's name.
class Point {
    x: number;
    y: number;
    constructor(x: number, y: number) { this.x = x; this.y = y; }
    norm(): number { return this.x * this.x + this.y * this.y; }
}
type Put = (target: Point, value: unknown) => void;
type Route = { title: string; put: Put; putNine: (target: Point, base: number) => void; read: (target: Point) => string };

function putTyped(point: Point, value: unknown): void { (point as any).tag = value; }
function putUntyped(object: any, value: unknown): void { object.tag = value; }
function putNineTyped(point: Point, base: number): void {
    const object = point as any;
    object.a = base + 1; object.b = base + 2; object.c = base + 3;
    object.d = base + 4; object.e = base + 5; object.f = base + 6;
    object.g = base + 7; object.h = base + 8; object.i = base + 9;
}
function putNineUntyped(object: any, base: number): void {
    object.a = base + 1; object.b = base + 2; object.c = base + 3;
    object.d = base + 4; object.e = base + 5; object.f = base + 6;
    object.g = base + 7; object.h = base + 8; object.i = base + 9;
}
// Class code is always strict. Plain Bun's transpiler drops a "use strict" directive inside a function, which would leave the reference run without a strict store.
class StrictCode {
    static mode = function (this: unknown): string { return this === undefined ? "strict" : "sloppy"; };
    static putTyped = function (point: Point, value: unknown): void { (point as any).tag = value; };
    static putUntyped = function (object: any, value: unknown): void { object.tag = value; };
    static putNineTyped = function (point: Point, base: number): void {
        const object = point as any;
        object.a = base + 1; object.b = base + 2; object.c = base + 3;
        object.d = base + 4; object.e = base + 5; object.f = base + 6;
        object.g = base + 7; object.h = base + 8; object.i = base + 9;
    };
    static putNineUntyped = function (object: any, base: number): void {
        object.a = base + 1; object.b = base + 2; object.c = base + 3;
        object.d = base + 4; object.e = base + 5; object.f = base + 6;
        object.g = base + 7; object.h = base + 8; object.i = base + 9;
    };
}
const { mode: classCodeMode, putTyped: putTypedStrictly, putUntyped: putUntypedStrictly, putNineTyped: putNineTypedStrictly, putNineUntyped: putNineUntypedStrictly } = StrictCode;
function readTyped(point: Point): string {
    const object = point as any;
    return [object.tag, object.a, object.b, object.c, object.d, object.e, object.f, object.g, object.h, object.i].join();
}
function readUntyped(object: any): string {
    return [object.tag, object.a, object.b, object.c, object.d, object.e, object.f, object.g, object.h, object.i].join();
}
function shadowTyped(point: Point, value: unknown): void { (point as any).norm = value; }
function shadowUntyped(object: any, value: unknown): void { object.norm = value; }
const routes: Route[] = [
    { title: "typed", put: putTyped, putNine: putNineTyped, read: readTyped },
    { title: "typed strict", put: putTypedStrictly, putNine: putNineTypedStrictly, read: readTyped },
    { title: "untyped", put: putUntyped, putNine: putNineUntyped, read: readUntyped },
    { title: "untyped strict", put: putUntypedStrictly, putNine: putNineUntypedStrictly, read: readUntyped },
];

function describeResult(f: () => unknown): string { try { return String(f()); } catch (e) { return "threw " + (e as Error).name; } }
function digest(texts: string[]): string {
    let hash = 0;
    for (const text of texts) for (let i = 0; i < text.length; i++) hash = (hash * 31 + text.charCodeAt(i)) | 0;
    return texts[0] + " .. " + texts[texts.length - 1] + " #" + hash;
}
function state(route: Route, point: Point): string { return "[" + route.read(point) + "] " + Object.keys(point).join() + " " + describeResult(() => point.norm()); }
const allocatedArrays: unknown[] = [];
const collect: () => void = (globalThis as any).gc ?? (() => (globalThis as any).Bun.gc(true));
const collectYoung: () => void = (globalThis as any).edenGC ?? (() => { for (let i = 0; i < 1000000; i++) allocatedArrays[i & 1023] = [i]; });

function storeInMany(route: Route): void {
    const report = (label: string, text: string) => console.log(route.title + ", " + label + ": " + text);
    const points: Point[] = [];
    for (let i = 0; i < 100; i++) points.push(new Point(i, -i));
    const readAll = () => digest(points.map(point => route.read(point)));
    for (const point of points) route.put(point, point.x);
    report("added", readAll());
    for (const point of points) route.put(point, point.x * 2);
    report("replaced", readAll());
    for (const point of points) route.putNine(point, point.x * 10);
    report("nine more", readAll());
    for (const point of points) route.putNine(point, point.x * 100);
    report("nine replaced", readAll());
    collect();
    for (const point of points) route.put(point, ["young", point.x]);
    collectYoung();
    report("young cells", readAll());
    report("keys", [...new Set(points.map(point => Object.keys(point).join()))].join(" | "));
    report("fields", String(points.reduce((sum, point) => sum + point.norm(), 0)));
}

function storeAfterIntegrityChange(route: Route): void {
    const report = (label: string, text: string) => console.log(route.title + ", " + label + ": " + text);
    const closed = new Point(1, 2);
    Object.preventExtensions(closed);
    report("not extensible", describeResult(() => route.put(closed, 5)) + " " + describeResult(() => route.putNine(closed, 10)) + " " + state(route, closed));
    const closedLater = new Point(1, 2);
    route.put(closedLater, 1);
    Object.preventExtensions(closedLater);
    report("not extensible after one", describeResult(() => route.put(closedLater, 2)) + " " + describeResult(() => route.putNine(closedLater, 10)) + " " + state(route, closedLater));
    const frozen = new Point(1, 2);
    route.put(frozen, 1);
    route.putNine(frozen, 10);
    Object.freeze(frozen);
    report("frozen", describeResult(() => route.put(frozen, 2)) + " " + describeResult(() => route.putNine(frozen, 20)) + " " + state(route, frozen));
}

function storeOverAccessors(route: Route): void {
    const report = (label: string, text: string) => console.log(route.title + ", " + label + ": " + text);
    const seen: unknown[] = [];
    const accessor = { get: () => seen.length, set: (value: unknown) => { seen.push(value); }, enumerable: true, configurable: true };
    const watched = new Point(3, 4);
    Object.defineProperty(watched, "tag", accessor);
    route.put(watched, 7);
    route.put(watched, 8);
    report("setter", seen.join() + " " + state(route, watched));
    const redefined = new Point(3, 4);
    route.put(redefined, 1);
    Object.defineProperty(redefined, "tag", accessor);
    route.put(redefined, 9);
    route.putNine(redefined, 10);
    report("setter over a value", seen.join() + " " + state(route, redefined));
    const readOnly = new Point(3, 4);
    Object.defineProperty(readOnly, "tag", { get: () => "got", configurable: true });
    report("getter alone", describeResult(() => route.put(readOnly, 1)) + " " + state(route, readOnly));
}

function shadowMethod(title: string, shadow: Put): void {
    const shadowed = new Point(5, 6);
    shadow(shadowed, 9);
    console.log(title + ", method name: " + Object.keys(shadowed).join() + " " + Object.values(shadowed).join() + " " + describeResult(() => shadowed.norm()));
    shadow(shadowed, () => -1);
    putUntyped(shadowed, "late");
    console.log(title + ", method replaced: " + shadowed.norm() + " " + Object.keys(shadowed).join() + " " + (shadowed as any).tag + " " + new Point(5, 6).norm());
    delete (shadowed as any).norm;
    console.log(title + ", method restored: " + shadowed.norm() + " " + Object.keys(shadowed).join());
}

console.log("functions without a directive are " + (function (this: unknown) { return this === undefined ? "strict" : "sloppy"; })());
console.log("functions in a class body are " + classCodeMode());
const parsed: any = JSON.parse('{"x":0,"y":0}');
putUntyped(parsed, 1);
putUntypedStrictly(parsed, 2);
putNineUntyped(parsed, 10);
putNineUntypedStrictly(parsed, 20);
shadowUntyped(parsed, 3);
console.log("parsed object: " + readUntyped(parsed) + " " + Object.keys(parsed).join());
for (const route of routes) storeInMany(route);
for (const route of routes) storeAfterIntegrityChange(route);
for (const route of routes) storeOverAccessors(route);
shadowMethod("typed", shadowTyped);
shadowMethod("untyped", shadowUntyped);
// This store makes the file a CommonJS module, so a function without a "use strict" directive is sloppy.
module.exports = {};
//// factories-that-finish-what-the-constructor-began.ts
// Objects whose constructor stores little and whose factory stores the rest: every place that makes them, some places, one place under a condition.
// What lies where in the object must not show: key order, enumeration, deletion, redefinition, freezing, a `this` that leaks early, a factory that throws half way.

const lines: string[] = [];
function say(label: string, value: unknown) {
  lines.push(label + ": " + (typeof value === "string" ? value : JSON.stringify(value)));
}

class Signature {
  flags: number;
  checker?: object;
  declaration?: string;
  typeParameters?: string[];
  parameters?: string[];
  thisParameter?: string;
  resolvedReturnType?: string;
  resolvedTypePredicate?: string;
  minArgumentCount?: number;
  resolvedMinArgumentCount?: number;
  target?: Signature;
  mapper?: (name: string) => string;
  compositeSignatures?: Signature[];
  compositeKind?: number;
  constructor(checker: object | undefined, flags: number) {
    this.flags = flags;
    if (checker) this.checker = checker;
  }
}

function createSignature(declaration: string | undefined, typeParameters: string[] | undefined, thisParameter: string | undefined, parameters: string[], resolvedReturnType: string | undefined, minArgumentCount: number, flags: number) {
  const signature = new Signature(undefined, flags);
  signature.declaration = declaration;
  signature.typeParameters = typeParameters;
  signature.parameters = parameters;
  signature.thisParameter = thisParameter;
  signature.resolvedReturnType = resolvedReturnType;
  signature.resolvedTypePredicate = undefined;
  signature.minArgumentCount = minArgumentCount;
  signature.resolvedMinArgumentCount = undefined;
  signature.target = undefined;
  signature.mapper = undefined;
  signature.compositeSignatures = undefined;
  signature.compositeKind = undefined;
  return signature;
}

function cloneSignature(signature: Signature) {
  const result = createSignature(signature.declaration, signature.typeParameters, signature.thisParameter, signature.parameters!, undefined, signature.minArgumentCount!, signature.flags & 3);
  result.target = signature.target;
  result.mapper = signature.mapper;
  result.compositeSignatures = signature.compositeSignatures;
  result.compositeKind = signature.compositeKind;
  return result;
}

{
  const all: Signature[] = [];
  for (let i = 0; i < 300; i++) {
    const made = createSignature(i % 3 ? "d" + i : undefined, i % 5 ? undefined : ["T"], undefined, ["a", "b"].slice(0, i % 3), i % 2 ? "r" + i : undefined, i % 4, i);
    all.push(i % 7 ? made : cloneSignature(made));
  }
  say("keys", Object.keys(all[1]).join());
  say("keys of a clone", Object.keys(all[7]).join());
  say("json", all[5]);
  let sum = 0;
  for (const one of all) sum += one.minArgumentCount! + one.parameters!.length + (one.resolvedReturnType ? 1 : 0) + (one.declaration ? 2 : 0);
  say("sum", sum);
  const seen: string[] = [];
  for (const key in all[2]) seen.push(key);
  say("for in", seen.join());
  say("entries", Object.entries(all[3]).filter(([, value]) => value !== undefined).map(([key]) => key).join());
}

// Deleted, added again, redefined, frozen.
{
  const one = createSignature("d", undefined, undefined, ["p"], "r", 1, 9);
  delete one.parameters;
  say("after delete", Object.keys(one).join());
  say("has", "parameters" in one);
  one.parameters = ["again"];
  say("added again", Object.keys(one).join());
  say("value", one.parameters);
  let reads = 0;
  Object.defineProperty(one, "minArgumentCount", { get() { reads++; return 41 + reads; }, enumerable: true, configurable: true });
  say("accessor", [one.minArgumentCount, one.minArgumentCount, reads]);
  say("descriptor", Object.getOwnPropertyDescriptor(one, "declaration"));
  Object.defineProperty(one, "declaration", { value: "fixed", writable: false });
  let threw = "no";
  try { one.declaration = "other"; } catch (error) { threw = (error as Error).constructor.name; }
  say("read-only", [one.declaration, threw]);
  const frozen = Object.freeze(createSignature("f", undefined, undefined, [], undefined, 0, 0));
  threw = "no";
  try { (frozen as Signature).resolvedReturnType = "x"; } catch (error) { threw = (error as Error).constructor.name; }
  say("frozen", [frozen.resolvedReturnType, threw, Object.isFrozen(frozen)]);
}

// Two factories: both fill `left`, only one fills `right`; a third place fills nothing.
class Pair {
  tag: string;
  left?: number;
  right?: number;
  rest?: number[];
  constructor(tag: string) { this.tag = tag; }
}
function both(left: number, right: number) { const pair = new Pair("both"); pair.left = left; pair.right = right; return pair; }
function onlyLeft(left: number) { const pair = new Pair("left"); pair.left = left; return pair; }
function bare() { return new Pair("bare"); }
{
  const pairs: Pair[] = [];
  for (let i = 0; i < 200; i++) pairs.push(i % 3 === 0 ? both(i, -i) : i % 3 === 1 ? onlyLeft(i) : bare());
  say("pairs", pairs.slice(0, 6));
  say("pair keys", pairs.slice(0, 3).map(pair => Object.keys(pair).join("+")));
  pairs[2].right = 5; pairs[2].left = 6;
  say("late, the other way round", Object.keys(pairs[2]).join("+"));
  let total = 0;
  for (const pair of pairs) total += (pair.left ?? 1000) + (pair.right ?? 100000);
  say("total", total);
}

// The object is seen before the factory has finished, and the factory may throw half way.
class Watched {
  id: number;
  first?: string;
  second?: string;
  third?: string;
  constructor(id: number, early: (made: Watched) => void) { this.id = id; early(this); }
}
const snapshots: string[] = [];
let kept: Watched | undefined;
function makeWatched(id: number, fail: boolean) {
  const made = new Watched(id, early => { snapshots.push(JSON.stringify(early) + Object.keys(early).length); kept = early; });
  made.first = "f" + id;
  if (fail) throw new RangeError("half way " + id);
  made.second = "s" + id;
  made.third = "t" + id;
  return made;
}
{
  for (let i = 0; i < 120; i++) {
    try { makeWatched(i, i % 40 === 39); } catch (error) { say("threw", [(error as Error).message, JSON.stringify(kept), Object.keys(kept!).join()]); }
  }
  say("snapshots", snapshots.slice(0, 2));
  say("last", kept);
}

// A subclass, Reflect.construct with another new.target, and a constructor function.
class Wider extends Pair {
  extra?: string;
  constructor() { super("wider"); }
}
function wider(left: number) { const made = new Wider(); made.left = left; made.extra = "e"; return made; }
function Legacy(this: { kind: number; name?: string; size?: number }, kind: number) { this.kind = kind; }
function legacy(kind: number, name: string, size: number) {
  const made = new (Legacy as unknown as new (kind: number) => { kind: number; name?: string; size?: number })(kind);
  made.name = name;
  made.size = size;
  return made;
}
{
  say("wider", [wider(1), Object.keys(wider(2)).join(), wider(3) instanceof Pair]);
  const odd = Reflect.construct(Pair, ["odd"], Wider) as Wider;
  odd.extra = "first"; odd.left = 3;
  say("another new.target", [odd, odd instanceof Wider, Object.keys(odd).join()]);
  const many = [] as ReturnType<typeof legacy>[];
  for (let i = 0; i < 150; i++) many.push(legacy(i, "n" + i, i * 2));
  say("legacy", [many[149], Object.keys(many[3]).join(), Object.getPrototypeOf(many[0]) === Legacy.prototype]);
  say("spread", { ...many[4], kind: "k" });
  say("assign", Object.assign({}, many[5], both(1, 2)));
}

// More birth fields than a cell takes.
class Wide {
  a0?: number; a1?: number; a2?: number; a3?: number; a4?: number; a5?: number; a6?: number; a7?: number; a8?: number; a9?: number;
  b0?: number; b1?: number; b2?: number; b3?: number; b4?: number; b5?: number; b6?: number; b7?: number; b8?: number; b9?: number;
  c0?: string; c1?: string; c2?: string; c3?: string; c4?: string; c5?: string; c6?: string; c7?: string; c8?: string; c9?: string;
}
function wide(n: number) {
  const w = new Wide();
  w.a0 = n; w.a1 = n + 0.5; w.a2 = n; w.a3 = n; w.a4 = n; w.a5 = n; w.a6 = n; w.a7 = n; w.a8 = n; w.a9 = n;
  w.b0 = n; w.b1 = n; w.b2 = n; w.b3 = n; w.b4 = n; w.b5 = n; w.b6 = n; w.b7 = n; w.b8 = n; w.b9 = -n;
  w.c0 = "x" + n; w.c1 = "x"; w.c2 = "x"; w.c3 = "x"; w.c4 = "x"; w.c5 = "x"; w.c6 = "x"; w.c7 = "x"; w.c8 = "x"; w.c9 = "y" + n;
  return w;
}
{
  const wides: Wide[] = [];
  for (let i = 0; i < 100; i++) wides.push(wide(i));
  say("wide", [wides[99].a1, wides[99].b9, wides[99].c9, Object.keys(wides[50]).length, JSON.stringify(wides[7]).length]);
}

console.log(lines.join("\n"));
//// field-read-after-aliased-store.ts
// A read that follows a store to the same field returns the stored value, also when two variables refer to the same object.
declare const console: any;
const log: any[] = [];
interface P { x: number; y: number | undefined; o?: number; q: P | undefined }
function make(x: number): P { return { x, y: undefined, q: undefined }; }
const hide = (v: unknown): any => v;
let moduleVariable = 0;
function changesModule(): number { moduleVariable += 10; return 1; }
function twoNames(a: P, b: P): number { a.x = 1; b.x = 2; return a.x * 10 + b.x; }
function callBetween(a: P, f: (p: P) => void): number { a.x = 1; f(a); return a.x; }
function throughAny(a: P): number { a.x = 1; hide(a).x = 5; return a.x; }
function otherField(a: P): number { a.x = 1; a.y = 2; return a.x * 10 + (a.y ?? 0); }
function deleted(a: P): string { a.o = 1; delete a.o; return String(a.o) + ("o" in a); }
function frozen(a: P): string { Object.freeze(a); try { a.x = 9; return "stored " + a.x; } catch (e: any) { return "threw " + e.constructor.name + " " + a.x; } }
function wrongUnderHandler(a: P, v: any): string { a.x = 1; try { a.x = v; return "stored " + a.x; } catch (e: any) { return "threw " + e.constructor.name + " " + a.x; } }
function oneWay(a: P, c: boolean): number { if (c) a.x = 7; return a.x; }
function bothWays(a: P, c: boolean): number { if (c) a.x = 7; else a.x = 8; return a.x; }
function inLoop(a: P, n: number): number { let s = 0; for (let i = 0; i < n; i++) { s += a.x; a.x = i; s += a.x; } return s; }
function loopCarried(a: P, b: P, n: number): number { a.x = 100; let s = 0; for (let i = 0; i < n; i++) { s += a.x; b.x = i; } return s; }
function numbers(a: P): string { const out: any[] = []; for (const v of [0, -0, 1.5, NaN, 2 ** 31, -(2 ** 31) - 1, 2 ** 53, Infinity]) { a.x = v; out.push(Object.is(a.x, v)); a.y = v; out.push(Object.is(a.y, v)); } return out.join(); }
function chain(a: P): number { a.q = make(3); a.q.x = 4; a.q.q = a; a.q.q.x = 5; return a.x * 10 + a.q.x; }
function environment(): string { let n = 0; const bump = () => { n += 5; }; n = 1; bump(); const first = n; n = 2; const second = n; bump(); return first + " " + second + " " + n; }
function module(): string { moduleVariable = 1; const a = moduleVariable; changesModule(); const b = moduleVariable; moduleVariable = 3; return a + " " + b + " " + moduleVariable; }
function nilReceiver(a: P | undefined): string { try { a!.x = 1; return "stored " + a!.x; } catch (e: any) { return "threw " + e.constructor.name; } }
function attempt(name: string, f: () => any) { try { log.push(name + ": " + f()); } catch (e: any) { log.push(name + " threw " + e.constructor.name); } }
for (let round = 0; round < 2; round++) {
    const p = make(0), r = make(0);
    attempt("twoNames, two", () => twoNames(p, r)); attempt("twoNames, one", () => twoNames(p, p)); attempt("callBetween", () => callBetween(p, x => { x.x = 42; })); attempt("callBetween, nothing", () => callBetween(p, () => { }));
    attempt("throughAny", () => throughAny(p)); attempt("otherField", () => otherField(p)); attempt("deleted", () => deleted(p)); attempt("frozen", () => frozen(make(3))); attempt("wrongUnderHandler, right", () => wrongUnderHandler(p, 6));
    attempt("oneWay yes", () => oneWay(make(1), true)); attempt("oneWay no", () => oneWay(make(1), false)); attempt("bothWays", () => bothWays(p, true) * 10 + bothWays(p, false)); attempt("inLoop", () => inLoop(make(50), 4));
    attempt("loopCarried, two", () => loopCarried(p, r, 3)); attempt("loopCarried, one", () => loopCarried(p, p, 3)); attempt("numbers", () => numbers(p)); attempt("chain", () => chain(make(1))); attempt("environment", environment); attempt("module", module);
    attempt("nilReceiver", () => nilReceiver(hide(undefined))); attempt("nilReceiver, there", () => nilReceiver(p));
}
console.log(log.join("\n"));
export {};
//// field-read-after-distant-store.ts
// `o.f = v; .. o.f ..`: cases where the value read is not simply the value stored (calls in between, aliases, deleted, redefined or frozen properties).
declare const console: any;
const log: any[] = [];
interface Links { check: number; other?: number }
interface Sym { flags: number; name?: string }
interface TransientSym extends Sym { links: Links; count: number; label?: string }
let seen: TransientSym | undefined;
function touch(s: TransientSym) { s.links = { check: 99 }; s.count = -1; }
function make(): TransientSym { return { flags: 1, links: { check: 0 }, count: 0, label: undefined }; }
// A call in between stores to it.
{ const s = make(); s.links = { check: 1 }; touch(s); log.push(s.links.check, s.count); }
// It has escaped, and what runs in between is not known.
{ const s = make(); seen = s; s.count = 5; (() => { seen!.count = 6; })(); log.push(s.count); }
// A second store to the same field, and a store to another one.
{ const s = make(); s.count = 1; s.flags = 2; s.count = 3; log.push(s.count, s.flags); }
// Two objects of one layout.
{ const a = make(); const b = make(); a.count = 1; b.count = 2; log.push(a.count, b.count); }
// Deleted, redefined, frozen in between.
{ const s: any = make(); s.label = "x"; delete s.label; log.push(s.label, "label" in s); }
{ const s = make(); s.count = 1; Object.defineProperty(s, "count", { value: 7, writable: true, enumerable: true, configurable: true }); log.push(s.count); }
{ const s = make(); s.count = 1; Object.freeze(s); try { s.count = 2; } catch (e) { log.push("frozen"); } log.push(s.count); }
// Numbers are read back unchanged.
{ const s = make(); s.count = -0; log.push(Object.is(s.count, -0)); s.count = NaN; log.push(s.count); s.count = 2 ** 40; log.push(s.count); s.count = 1.5; log.push(s.count); }
// The same object is read back: identity.
{ const s = make(); const l: Links = { check: 4 }; s.links = l; log.push(s.links === l); s.links.check = 8; log.push(l.check, s.links.check); }
// Through a view in which a member lacks the field, as in createSymbol.
function create(flags: number): TransientSym {
    const s = { flags } as Sym as TransientSym;
    s.links = { check: 0 };
    s.links.check = flags + 1;
    s.count = flags; s.label = undefined;
    return s;
}
log.push(JSON.stringify(create(3)), Object.keys(create(4)).join());
// In a loop: the store of one iteration, the read of the next.
{ const s = make(); let sum = 0; for (let i = 0; i < 4; i++) { sum += s.count; s.count = i; } log.push(sum, s.count); }
// On two ways.
function branch(c: boolean) { const s = make(); if (c) s.count = 1; else s.count = 2; return s.count; }
log.push(branch(true), branch(false));
// In a handler's sight.
function guarded() { const s = make(); try { s.count = 3; return s.count; } finally { log.push("finally"); } }
log.push(guarded());
// An accessor on the `prototype` of the function that makes the object: a store by its name runs the setter, which stores to ANOTHER field; a read by its name runs the getter.
interface Celsius { degrees: number; fahrenheit: number }
function Celsius(this: Celsius, f: number) { this.degrees = 0; this.fahrenheit = f; }
Object.defineProperty(Celsius.prototype, "fahrenheit", {
    get(this: Celsius) { return this.degrees * 9 / 5 + 32 + 1; },
    set(this: Celsius, f: number) { this.degrees = (f - 32) * 5 / 9; },
});
type CelsiusConstructor = new (f: number) => Celsius;
function boil() { const c = new (Celsius as unknown as CelsiusConstructor)(212); return c.degrees + " " + c.fahrenheit + " " + Object.keys(c).join(); }
function storeAndRead() { const c = new (Celsius as unknown as CelsiusConstructor)(32); c.fahrenheit = 50; const read = c.fahrenheit; return read + " " + c.degrees; }
function storeAcross() { const c = new (Celsius as unknown as CelsiusConstructor)(32); c.degrees = 7; c.fahrenheit = 212; return c.degrees; }
log.push(boil(), storeAndRead(), storeAcross());
console.log(log.join("\n"));
export {};
//// field-reads-by-name.ts
// Untyped code reads every field representation of a class instance by name and by key: present, undefined, null, absent, deleted, and deleted below a prototype that defines the name.
type Color = "red" | "green" | "blue";

class Point {
  constructor(
    public x: number,
    public y: number,
  ) {}
}

const colors: Color[] = ["red", "green", "blue"];
const boxedValues: unknown[] = [0, 1.5, "text", null, undefined, true, new Point(3, 4), -0, NaN];

class Sample {
  boxed: unknown;
  point: Point;
  color: Color;
  count: number;
  ratio: number;
  flag: boolean;
  byte: number;
  signedByte: number;
  halfWord: number;
  signedHalfWord: number;
  unsignedWord: number;
  wideInteger: number;
  optionalBoxed?: unknown;
  optionalPoint?: Point | null;
  optionalColor?: Color | null;
  optionalCount?: number | null;
  optionalRatio?: number | null;
  optionalFlag?: boolean | null;
  declare lateCount?: number | null;

  constructor(index: number, count: number) {
    this.boxed = boxedValues[index % boxedValues.length];
    this.point = new Point(index, -index);
    this.color = colors[index % colors.length];
    this.count = count;
    this.ratio = count / 2;
    this.flag = index % 2 === 0;
    this.byte = (index * 37) & 0xff;
    this.signedByte = ((index * 37) & 0xff) - 128;
    this.halfWord = (index * 4099) & 0xffff;
    this.signedHalfWord = ((index * 4099) & 0xffff) - 32768;
    this.unsignedWord = (index * 0x13579bdf) >>> 0;
    this.wideInteger = index * 2 ** 33 + index;
  }
}

class Derived extends Sample {}

const requiredNames = ["boxed", "point", "color", "count", "ratio", "flag", "byte", "signedByte", "halfWord", "signedHalfWord", "unsignedWord", "wideInteger"];
const optionalNames = ["optionalBoxed", "optionalPoint", "optionalColor", "optionalCount", "optionalRatio", "optionalFlag", "lateCount"];
const names = [...requiredNames, ...optionalNames];

function show(value: unknown): string {
  if (typeof value === "number") return Object.is(value, -0) ? "-0" : String(value);
  if (typeof value === "string") return JSON.stringify(value);
  if (value instanceof Point) return "Point(" + show(value.x) + "," + show(value.y) + ")";
  return String(value);
}

function readByName(sample: any): string {
  return [
    sample.boxed,
    sample.point,
    sample.color,
    sample.count,
    sample.ratio,
    sample.flag,
    sample.byte,
    sample.signedByte,
    sample.halfWord,
    sample.signedHalfWord,
    sample.unsignedWord,
    sample.wideInteger,
    sample.optionalBoxed,
    sample.optionalPoint,
    sample.optionalColor,
    sample.optionalCount,
    sample.optionalRatio,
    sample.optionalFlag,
    sample.lateCount,
  ]
    .map(value => show(value))
    .join(" ");
}

function readByKey(sample: any): string {
  return names.map(name => show(sample[name])).join(" ");
}

function report(label: string, sample: any) {
  const results = new Set<string>();
  for (let i = 0; i < 100; i++) {
    results.add(readByName(sample));
    results.add(readByKey(sample));
  }
  console.log(label + ": " + [...results].join("\n  differs: "));
}

function fill(sample: Sample) {
  sample.optionalBoxed = "boxed";
  sample.optionalPoint = new Point(1, 2);
  sample.optionalColor = "green";
  sample.optionalCount = 3;
  sample.optionalRatio = 0.25;
  sample.optionalFlag = false;
  sample.lateCount = 9;
}

function setAll(sample: Sample, value: null | undefined) {
  sample.optionalBoxed = value;
  sample.optionalPoint = value;
  sample.optionalColor = value;
  sample.optionalCount = value;
  sample.optionalRatio = value;
  sample.optionalFlag = value;
  sample.lateCount = value;
}

function deleteAll(sample: Sample) {
  delete sample.optionalBoxed;
  delete sample.optionalPoint;
  delete sample.optionalColor;
  delete sample.optionalCount;
  delete sample.optionalRatio;
  delete sample.optionalFlag;
  delete sample.lateCount;
}

report("parsed", JSON.parse('{"boxed":"parsed","count":2.5,"flag":false,"optionalCount":null}'));

const lowest = -(2 ** 31);
const counts = [1, 1.5, -0, NaN, 2 ** 31, 2 ** 31 - 1, lowest, lowest + 1, lowest + 2, lowest + 3, lowest + 4, lowest + 5, lowest - 1, Infinity];
for (let index = 0; index < counts.length; index++) report("count " + show(counts[index]), new Sample(index, counts[index]));

const sample = new Sample(1, 7);
report("constructed", sample);
fill(sample);
report("filled", sample);
sample.optionalCount = 1.5;
sample.optionalRatio = 8;
sample.optionalFlag = true;
sample.lateCount = lowest + 2;
report("filled with other numbers", sample);
sample.optionalCount = 4;
report("a whole number again", sample);
setAll(sample, null);
report("null", sample);
setAll(sample, undefined);
report("undefined", sample);
deleteAll(sample);
report("deleted", sample);
console.log(Object.keys(sample).join());

const inherited: Record<string, unknown> = {
  optionalBoxed: "inherited",
  optionalPoint: new Point(5, 6),
  optionalColor: "blue",
  optionalCount: 42,
  optionalRatio: 4.5,
  optionalFlag: true,
  lateCount: 43,
};
const prototype: any = Sample.prototype;
for (const name of optionalNames) prototype[name] = inherited[name];
report("deleted, the prototype defines the names", sample);

const shadowing = new Sample(2, 8);
report("constructed below that prototype", shadowing);
fill(shadowing);
report("own fields shadow the prototype", shadowing);
deleteAll(shadowing);
report("deleted below that prototype", shadowing);

Object.defineProperty(prototype, "optionalFlag", {
  get() {
    return !this.flag;
  },
  configurable: true,
});
report("deleted, the prototype has a getter", sample);
report("deleted, the same getter on another receiver", shadowing);

for (const name of optionalNames) delete prototype[name];
report("deleted, the prototype no longer defines the names", sample);

const derivedPrototype: any = Derived.prototype;
derivedPrototype.optionalCount = 1000;
derivedPrototype.lateCount = 1001;
const derived = new Derived(4, 10);
report("derived, constructed", derived);
deleteAll(derived);
report("derived, deleted", derived);
fill(derived);
report("derived, filled", derived);
console.log(Object.keys(derived).join());
//// field-stores-by-name.ts
// Stores by name through a receiver of type `any` into typed fields of every representation, and the stores that a field cannot take in place.
"use strict"
interface Shape { area(): number }
class Square implements Shape { side = 2; area() { return this.side * this.side } }
class Disk implements Shape { radius = 3; area() { return 3 * this.radius * this.radius } }
class Foo { id: number; constructor(id: number) { this.id = id } }
type Mode = "idle" | "busy" | "done"
let calls = 0
const addOne = () => { calls += 1 }
const addTen = () => { calls += 10 }
function addHundred() { calls += 100 }
class Widget {
  count: number = 0
  label: string = "first"
  mode: Mode = "idle"
  enabled: boolean = false
  owner: Foo | null = null
  parts: Foo[] = []
  action: () => void = addOne
  shape: Shape = new Square()
  declare note?: string
  declare weight?: number
}
interface Options { id: number; note?: string }
interface Panel { id: number; top?: number; left?: number; width?: number; height?: number; color?: string; title?: string; hidden?: boolean; locked?: boolean; parent?: Foo; child?: Foo; order?: number; hint?: string }

function setCount(target: any, value: any) { target.count = value }
function setLabel(target: any, value: any) { target.label = value }
function setMode(target: any, value: any) { target.mode = value }
function setEnabled(target: any, value: any) { target.enabled = value }
function setOwner(target: any, value: any) { target.owner = value }
function setParts(target: any, value: any) { target.parts = value }
function setAction(target: any, value: any) { target.action = value }
function setShape(target: any, value: any) { target.shape = value }
function setNote(target: any, value: any) { target.note = value }
function setWeight(target: any, value: any) { target.weight = value }
function setOrder(target: any, value: any) { target.order = value }
function setHint(target: any, value: any) { target.hint = value }
function setChild(target: any, value: any) { target.child = value }
function getNote(target: any) { return target.note }

function show(value: any): string {
  if (typeof value === "function") return "function " + value.name
  if (Array.isArray(value)) return "[" + value.map(element => show(element)).join() + "]"
  if (value instanceof Foo) return "Foo " + value.id
  if (value instanceof Square || value instanceof Disk) return value.constructor.name + " " + value.area()
  if (typeof value === "object" && value !== null) return JSON.stringify(value)
  return typeof value + " " + (Object.is(value, -0) ? "-0" : String(value))
}
function showAll(target: any): string { return Object.keys(target).map(key => key + "=" + show(target[key])).join(" ") }
function same(texts: string[]): string { return texts.every(text => text === texts[0]) ? texts[0] : "DIFFERENT: " + texts.join(" | ") }
function attempt(title: string, run: () => string) {
  try { console.log(title + ":", run()) } catch (error) { console.log(title + ": threw", (error as Error).constructor.name) }
}

// An object from JSON.parse goes through every function too, so that no receiver has a known layout.
const parsed: any = JSON.parse("{}")
const widgets: Widget[] = []
for (let i = 0; i < 5; i++) widgets.push(new Widget())
function storeInAll(set: (target: any, value: any) => void, value: unknown) {
  for (const widget of widgets) set(widget, value)
  set(parsed, value)
}

for (const value of [1, 1.5, 2, -0, 2 ** 31, -(2 ** 31), -(2 ** 31) + 1, -(2 ** 31) + 4, -(2 ** 31) + 5, NaN, 7]) {
  storeInAll(setCount, value)
  console.log("count", same(widgets.map(widget => show(widget.count))), show(parsed.count))
}
for (const value of ["busy", "done", ["id", "le"].join(""), "busy"]) {
  storeInAll(setMode, value)
  console.log("mode", same(widgets.map(widget => show(widget.mode) + " " + (widget.mode === "idle") + " " + (widget.mode === "busy"))), show(parsed.mode))
}
for (const value of ["second", "", "done", "x".repeat(40), "<" + parsed.mode + ">", widgets.length + "th"]) {
  storeInAll(setLabel, value)
  console.log("label", same(widgets.map(widget => show(widget.label) + " " + widget.label.length)), show(parsed.label))
}
for (const value of [true, false, true]) {
  storeInAll(setEnabled, value)
  console.log("enabled", same(widgets.map(widget => show(widget.enabled) + " " + (widget.enabled ? "on" : "off"))), show(parsed.enabled))
}
for (const value of [new Foo(1), null, new Foo(2)]) {
  storeInAll(setOwner, value)
  console.log("owner", same(widgets.map(widget => show(widget.owner) + " " + (widget.owner === null ? "none" : widget.owner.id + 1))), show(parsed.owner))
}
for (const value of [[new Foo(3)], [], [new Foo(4), new Foo(5)]]) {
  storeInAll(setParts, value)
  console.log("parts", same(widgets.map(widget => show(widget.parts) + " " + widget.parts.length)), show(parsed.parts))
}
for (const value of [addTen, addHundred, addOne.bind(null), addOne]) {
  storeInAll(setAction, value)
  for (const widget of widgets) widget.action()
  console.log("action", same(widgets.map(widget => show(widget.action))), show(parsed.action), calls)
}
for (const value of [new Disk(), new Square(), new Disk()]) {
  storeInAll(setShape, value)
  console.log("shape", same(widgets.map(widget => show(widget.shape) + " " + widget.shape.area())), show(parsed.shape))
}
console.log("all", same(widgets.map(showAll)))
console.log("parsed", showAll(parsed))

attempt("string into a number field", () => {
  const widget = new Widget()
  setCount(widget, "many")
  const stored = showAll(widget)
  setCount(widget, 3)
  return stored + " then " + showAll(widget)
})
attempt("plain object into an array field", () => {
  const widget = new Widget()
  setParts(widget, { size: 0 })
  return showAll(widget)
})
attempt("number into a function field", () => {
  const widget = new Widget()
  setAction(widget, 5)
  return showAll(widget)
})
attempt("object of another class into a class field", () => {
  const widget = new Widget()
  setOwner(widget, new Square())
  return showAll(widget)
})

const frozen = Object.freeze(new Widget())
attempt("store to a frozen instance", () => { setCount(frozen, 5); return "stored" })
attempt("creation on a frozen instance", () => { setNote(frozen, "late"); return "created" })
console.log("frozen", showAll(frozen))

setNote(parsed, "parsed")
setWeight(parsed, 0.5)
for (let round = 0; round < 4; round++) {
  attempt("creation " + round, () => {
    const first = new Widget()
    const second = new Widget()
    setWeight(first, round)
    setNote(first, "n" + round)
    setNote(second, "m" + round)
    setWeight(second, round + 0.5)
    setWeight(second, round)
    return Object.keys(first).slice(-3).join() + " " + first.weight + " " + first.note + " | " + Object.keys(second).slice(-3).join() + " " + second.weight + " " + second.note
  })
}

const seen: string[] = []
Object.defineProperty(Widget.prototype, "note", { set(value: string) { seen.push("setter got " + value) }, configurable: true })
attempt("setter on the prototype", () => {
  const widget = new Widget()
  setNote(widget, "for the setter")
  return Object.keys(widget).includes("note") + " " + show(getNote(widget)) + " " + seen.join()
})
delete (Widget.prototype as any).note
attempt("setter removed again", () => {
  const widget = new Widget()
  setNote(widget, "own")
  return Object.keys(widget).includes("note") + " " + show(getNote(widget)) + " " + seen.join()
})

const base = { set note(value: string) { seen.push("base got " + value) } }
for (let round = 0; round < 3; round++) {
  attempt("literal " + round, () => {
    const plain: Options = { id: round }
    const derived: Options = { id: round }
    Object.setPrototypeOf(derived, base)
    setNote(plain, "p" + round)
    setNote(derived, "d" + round)
    return showAll(plain) + " | " + showAll(derived) + " | " + seen.length
  })
}
console.log(seen.join())

setOrder(parsed, 1)
setHint(parsed, "parsed")
setChild(parsed, null)
for (let round = 0; round < 4; round++) {
  attempt("sparse " + round, () => {
    const panel: Panel = { id: round }
    setHint(panel, "h" + round)
    setChild(panel, new Foo(round))
    setOrder(panel, round)
    const created = showAll(panel)
    setOrder(panel, round + 0.25)
    setHint(panel, "again")
    setChild(panel, new Foo(round + 10))
    return created + " | " + Object.keys(panel).join() + " " + panel.order + " " + panel.hint + " " + show(panel.child)
  })
}
console.log("parsed", showAll(parsed))
//// fields-added-late-one-after-the-other-in-many-orders.ts
class Wide {
  id: number;
  a?: Wide | number;
  b?: Wide | number;
  c?: Wide | number;
  d?: Wide | number;
  e?: Wide | number;
  f?: Wide | number;
  g?: Wide | number;
  h?: Wide | number;
  i?: Wide | number;
  j?: Wide | number;
  k?: Wide | number;
  l?: Wide | number;
  m?: Wide | number;
  n?: Wide | number;
  o?: Wide | number;
  p?: Wide | number;
  constructor(id: number) {
    this.id = id;
  }
}
const setters: ((wide: Wide, value: Wide | number) => void)[] = [
  (wide, value) => { wide.a = value; },
  (wide, value) => { wide.b = value; },
  (wide, value) => { wide.c = value; },
  (wide, value) => { wide.d = value; },
  (wide, value) => { wide.e = value; },
  (wide, value) => { wide.f = value; },
  (wide, value) => { wide.g = value; },
  (wide, value) => { wide.h = value; },
  (wide, value) => { wide.i = value; },
  (wide, value) => { wide.j = value; },
  (wide, value) => { wide.k = value; },
  (wide, value) => { wide.l = value; },
  (wide, value) => { wide.m = value; },
  (wide, value) => { wide.n = value; },
  (wide, value) => { wide.o = value; },
  (wide, value) => { wide.p = value; },
];
function numberOf(value: Wide | number | undefined): number {
  return value === undefined ? 0 : typeof value === "number" ? value : value.id;
}
function sumOf(wide: Wide): number {
  return (
    numberOf(wide.a) + 2 * numberOf(wide.b) + 3 * numberOf(wide.c) + 4 * numberOf(wide.d) + 5 * numberOf(wide.e) + 6 * numberOf(wide.f) +
    7 * numberOf(wide.g) + 8 * numberOf(wide.h) + 9 * numberOf(wide.i) + 10 * numberOf(wide.j) + 11 * numberOf(wide.k) + 12 * numberOf(wide.l) +
    13 * numberOf(wide.m) + 14 * numberOf(wide.n) + 15 * numberOf(wide.o) + 16 * numberOf(wide.p)
  );
}
let seed = 12345;
function next(limit: number): number {
  seed = (Math.imul(seed, 1103515245) + 12345) & 0x7fffffff;
  return seed % limit;
}
const kept: Wide[] = [];
const expected: number[] = [];
let total = 0;
for (let round = 0; round < 40000; round++) {
  const wide = new Wide(round);
  const count = next(17);
  let sum = 0;
  const taken = new Set<number>();
  for (let step = 0; step < count; step++) {
    const which = next(16);
    const value = step % 3 === 0 ? wide : step + 1;
    if (taken.has(which)) continue;
    taken.add(which);
    setters[which](wide, value);
    sum += (which + 1) * numberOf(value);
    if (sumOf(wide) !== sum) throw new Error("round " + round + " step " + step + ": " + sumOf(wide) + " is not " + sum);
  }
  total = (total + sum) % 1000003;
  if (round % 16 === 0) {
    kept.push(wide);
    expected.push(sum);
  }
  if (round % 10000 === 9999) Bun.gc(true);
}
let wrong = 0;
for (let index = 0; index < kept.length; index++) if (sumOf(kept[index]) !== expected[index]) wrong++;
const inOrder = new Wide(7);
for (let which = 0; which < 16; which++) setters[which](inOrder, which + 1);
const backwards = new Wide(8);
for (let which = 15; which >= 0; which--) setters[which](backwards, which + 1);
console.log(total, wrong, kept.length, sumOf(inOrder), sumOf(backwards), Object.keys(inOrder).join(""), Object.keys(backwards).join(""));
//// fields-and-keys-found-through-heirs.js
// Fields, methods and keys of an object that are found through a proxy or through the objects that inherit from it.
const lines = [];
////= printer

{
  const print = printer("assign-heir");
  const c = Object.assign({}, Object.create({ a: 1 }));
  print(c.a);
}
{
  const print = printer("comma-call");
  let holder;
  function make(n) { return { run: () => n, n }; }
  function use() { return (0, holder.run)(); }
  holder = make(4);
  print(use());
}
{
  const print = printer("for-in-class-prototype-assigned");
  class C { x = 1; }
  C.prototype.extra = 2;
  for (const k in new C()) print(k);
}
{
  const print = printer("for-in-constructor-this");
  function P() { this.a = 1; this.b = 2; }
  const o = Object.create(new P());
  let n = 0;
  for (const k in o) n++;
  print(n);
}
{
  const print = printer("for-in-order");
  function make() { const p = {}; p.z = 1; p.a = 2; p.m = 3; return p; }
  const o = Object.create(make());
  let s = "";
  for (const k in o) s += k;
  print(s);
}
{
  const print = printer("for-in-shadowed");
  class P { a = 1; b = 2; }
  const o = Object.create(new P());
  o.a = 5;
  let s = "";
  for (const k in o) s += k + o[k];
  print(s);
}
{
  const print = printer("for-in-swapped-prototype");
  const a = { first: 1 };
  const b = { second: 2 };
  const o = Object.create(a);
  function list(x) { let s = ""; for (const k in x) s += k; return s; }
  print(list(o));
  Object.setPrototypeOf(o, b);
  print(list(o));
}
{
  const print = printer("for-in-three-levels");
  class A { a = 1; }
  class B { b = 2; }
  const top = new A();
  const middle = new B();
  Object.setPrototypeOf(middle, top);
  const o = Object.create(middle);
  o.own = 3;
  let s = "";
  for (const k in o) s += k + ",";
  print(s);
}
{
  const print = printer("get-prototype-read");
  class C { a = 7; }
  const o = Object.create(new C());
  print(Object.getPrototypeOf(o).a);
}
{
  const print = printer("instanceof-prototype-field");
  function F() {}
  const holder = { prototype: F.prototype, [Symbol.hasInstance]: undefined };
  print(typeof holder.prototype);
}
{
  const print = printer("is-prototype-of");
  const p = { a: 1 };
  const o = Object.create(p);
  print(p.isPrototypeOf(o), Object.getPrototypeOf(o) === p, Object.getPrototypeOf(o).a);
}
{
  const print = printer("locale-string-class");
  class C { toString() { return "c"; } }
  print(new C().toLocaleString());
}
{
  const print = printer("locale-string-literal");
  print(({ toString() { return "l"; } }).toLocaleString());
}
{
  const print = printer("own-symbols");
  const k = Symbol("k");
  const o = { [k]: 1 };
  print(Object.getOwnPropertySymbols(o).length);
}
{
  const print = printer("pattern-call");
  let holder;
  function make(n) { return { run: () => { print("ran"); }, n }; }
  function use() { const { run } = holder; run(); return holder.n; }
  holder = make(1);
  print(use());
  holder = make(2);
  print(use());
}
{
  const print = printer("property-is-enumerable");
  const o = { a: 1 };
  print(o.propertyIsEnumerable("a"));
}
{
  const print = printer("proto-getter-read");
  class C { a = 7; }
  const o = Object.create(new C());
  print(o.__proto__.a);
}
{
  const print = printer("proxy-target-field");
  const t = { a: 1 };
  const p = new Proxy(t, {});
  print(p.a);
}
{
  const print = printer("proxy-target-keys");
  const t = { a: 1, b: 2 };
  print(Object.keys(new Proxy(t, {})).length);
}
{
  const print = printer("proxy-target-method");
  const t = { m() { return 2; } };
  const p = new Proxy(t, {});
  print(p.m());
}
{
  const print = printer("pure-call-dropped");
  let holder;
  function make(n) { return { run: () => {}, n }; }
  function use() { holder.run(); return holder.n; }
  holder = make(1);
  print(use());
  print(typeof holder.n);
}
{
  const print = printer("stringify-heir");
  print(JSON.stringify(Object.create({ a: 1 })));
}
{
  const print = printer("variable-call");
  let holder;
  function make(n) { return { run: () => { print("ran"); }, n }; }
  function use() { const f = holder.run; f(); return holder.n; }
  holder = make(1);
  print(use());
}

await new Promise(resolve => setTimeout(resolve, 0));
console.log(lines.join("\n"));
//// fields-created-on-objects-that-have-other-extra-properties.ts
// A store that finds the slot of a field empty creates the property, and a read that finds it empty answers undefined, only where the property lies nowhere else on the object.
// That is so as long as no FIELD of the object has left its slot. A name that the layout has no field for, stored in between, changes nothing about the fields: the order of keys still has it in its place.
// A field that has left its slot (a value its slot cannot hold, an accessor, a property that is read-only) is found where it lies, by the same compiled stores and reads.
interface Message {
  socket?: string;
  complete?: boolean;
  url?: string;
  count?: number;
  trailers?: string[];
}

class Made {}
interface Made extends Message {}

const hand = new Function("value", "return value") as <T>(value: T) => T;
const odd = hand("odd" + "Name");
const mark = hand(Symbol("mark"));

function fillHead(message: Message, socket: string) {
  message.socket = socket;
  message.complete = false;
}
function fillTail(message: Message, url: string, count: number) {
  message.url = url;
  message.count = count;
  message.trailers = [url];
}
function read(message: Message) {
  return [message.socket, message.complete, message.url, message.count, message.trailers?.length, "url" in message, Object.hasOwn(message, "count")].join();
}
function show(label: string, message: Message) {
  const listed: string[] = [];
  for (const name in message) listed.push(name);
  console.log(label, "|", read(message), "|", Object.keys(message).join(), "|", listed.join(), "|", Reflect.ownKeys(message).length, "|", JSON.stringify(message));
}

function plain() {
  const message = hand(new Made());
  fillHead(message, "s");
  fillTail(message, "/plain", 1);
  return message;
}
function withExtraInBetween() {
  const message: any = hand(new Made());
  fillHead(message, "s");
  message[odd] = "extra";
  message[mark] = 1;
  fillTail(message, "/extra", 2);
  return message as Message;
}
function withExtraFirst() {
  const message: any = hand(new Made());
  message[odd] = "first";
  fillHead(message, "s");
  fillTail(message, "/first", 3);
  delete message[odd];
  return message as Message;
}
function withOtherTypeInField() {
  const message: any = hand(new Made());
  fillHead(message, "s");
  message.url = { not: "a string" };
  message.count = "seven";
  show("other types before the stores", message);
  fillTail(message, "/typed", 4);
  return message as Message;
}
function withAccessor() {
  const message: any = hand(new Made());
  const seen: unknown[] = [];
  Object.defineProperty(message, "url", { get: () => "from the getter", set: value => void seen.push(value), enumerable: true, configurable: true });
  fillHead(message, "s");
  fillTail(message, "/accessor", 5);
  console.log("the setter saw", seen.join());
  return message as Message;
}
function withReadOnly() {
  const message: any = hand(new Made());
  Object.defineProperty(message, "count", { value: -1, writable: false, enumerable: true, configurable: true });
  fillHead(message, "s");
  let thrown = "nothing";
  try {
    fillTail(message, "/read-only", 6);
  } catch (error) {
    thrown = (error as Error).constructor.name;
  }
  console.log("the store threw", thrown);
  return message as Message;
}
function withDeletedField() {
  const message: any = hand(new Made());
  fillHead(message, "s");
  fillTail(message, "/deleted", 7);
  delete message.url;
  message[odd] = "after the deletion";
  show("deleted", message);
  message.url = 8;
  show("another type after the deletion", message);
  fillTail(message, "/again", 9);
  return message as Message;
}

for (let round = 0; round < 3; round++) {
  show("plain", plain());
  show("extra in between", withExtraInBetween());
  show("extra first", withExtraFirst());
  show("other types", withOtherTypeInField());
  show("accessor", withAccessor());
  show("read-only", withReadOnly());
  show("deleted", withDeletedField());
}

let sum = 0;
for (let index = 0; index < 30000; index++) {
  const message = index % 3 ? withExtraInBetween() : plain();
  if (index % 1000 === 0) (message as any).count = "text";
  sum += typeof message.count === "number" ? message.count : 100;
  sum += Object.keys(message).length + (message.trailers?.length ?? 0);
}
console.log(sum);
//// fields-left-out-are-looked-for-above-the-object.ts
type Project = { cwd: string };
interface Session {
  readonly id: number;
  project: Project | null;
  optionalProject?: Project | null;
  title: string | null;
}
const home: Project = { cwd: "/home" };
const elsewhere: Project = { cwd: "/elsewhere" };
function make(id: number): Session {
  return { id, title: null } as Session;
}
function projectOf(holder: Session): Project | null | undefined {
  return holder.project;
}
function optionalProjectOf(holder: Session): Project | null | undefined {
  return holder.optionalProject;
}
const lines: string[] = [];
function show(name: string, session: Session) {
  lines.push(name + ": " + JSON.stringify(projectOf(session)) + " " + JSON.stringify(optionalProjectOf(session)));
}

const bare = make(1);
show("left out", bare);
show("left out, once more", bare);

const inheriting = make(2);
Object.setPrototypeOf(inheriting, { project: home });
show("inherited", inheriting);
show("left out, behind the other", bare);

const withGetters = make(3);
Object.setPrototypeOf(withGetters, {
  get project() {
    return { cwd: "seen by " + (this as Session).id };
  },
  get optionalProject() {
    return this === withGetters ? elsewhere : null;
  },
});
show("getters above", withGetters);

const changing = make(4);
const above: Record<string, unknown> = {};
Object.setPrototypeOf(changing, above);
show("nothing above yet", changing);
above.project = home;
show("added above", changing);
above.project = elsewhere;
show("replaced above", changing);
delete above.project;
show("deleted above", changing);
changing.project = elsewhere;
show("stored", changing);
delete (changing as { project?: Project | null }).project;
show("deleted", changing);
Object.defineProperty(changing, "optionalProject", { get() { return home; }, configurable: true });
show("an accessor of its own", changing);
Object.setPrototypeOf(changing, null);
show("no prototype", changing);

const behindProxy = make(5);
Object.setPrototypeOf(
  behindProxy,
  new Proxy({}, {
    get(target, key, receiver) {
      return key === "project" ? { cwd: "a proxy asked by " + receiver.id } : undefined;
    },
  }),
);
show("a proxy above", behindProxy);

let seen = 0;
for (let turn = 0; turn < 30000; turn++) {
  const session = turn % 3 === 0 ? bare : turn % 3 === 1 ? inheriting : withGetters;
  const project = projectOf(session);
  if (project) seen += project.cwd.length;
  const other = optionalProjectOf(session);
  if (other) seen += other.cwd.length;
}
lines.push("turns " + seen);
console.log(lines.join("\n"));
