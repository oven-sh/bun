//// fields-via-reflection.ts
// The fields of a typed object as reflection sees them: descriptors, enumerability, order.
interface Command { name: string; description: string; hidden: boolean; count: number }
function command(name: string, dynamic: boolean): Command {
  const made: Command = { name, description: dynamic ? "" : "static " + name, hidden: false, count: 1 }
  return made
}
const a = command("a", true), b = command("b", false)
console.log(a.description, a.description, b.description, Object.keys(a).join(), JSON.stringify(a), JSON.stringify(b))
console.log(Object.keys(b).join(), b.hidden, JSON.stringify(b), Object.getOwnPropertyNames(b).join())
b.hidden = true
b.count += 2
console.log(b.hidden, b.count, JSON.stringify({ ...b }), JSON.stringify({ ...a }))
a.count = 4
console.log(a.count, JSON.stringify(Object.getOwnPropertyDescriptor(a, "name")), typeof Object.getOwnPropertyDescriptor(a, "count")!.get)
console.log("count" in a, Object.keys(a).join())
class Point { x = 1; y = 2; sum() { return this.x + this.y } }
const p = new Point()
console.log(p.sum(), p.x, Object.keys(p).join())
//// for-in-after-the-prototype-chain-changed.js
// A for-in loop that runs many times over objects of one shape lists the same keys each time, and sees what a prototype gets, hides or loses between two loops.
////= Point-2
////= lines-22	keysOf	keys	key
function repeated(object) {
  const first = keysOf(object);
  for (let i = 0; i < 200; i++) {
    const next = keysOf(object);
    if (next !== first) return first + " then " + next + " at " + i;
  }
  return first;
}
function show(what, ...objects) {
  console.log(what + ": " + objects.map(repeated).join(" | "));
}

const a = new Point(1, 2), b = new Point(3, 4);
show("instances", a, b);
Point.prototype.tag = "t";
show("the prototype got a name", a, b);
Object.defineProperty(Point.prototype, "tag", { enumerable: false });
show("the name is hidden", a, b);
Object.defineProperty(Point.prototype, "tag", { enumerable: true });
show("the name is listed again", a, b);
delete Point.prototype.tag;
show("the name is gone", a, b);

const base = { inherited: 1 };
Object.setPrototypeOf(Point.prototype, base);
show("another object above the prototype", a, b);
base.more = 2;
show("it got a name", a, b);
a.inherited = 0;
show("an own name hides an inherited one", a, b);
Object.setPrototypeOf(Point.prototype, Object.prototype);
show("the usual chain again", a, b);

b.z = 5;
show("one instance got a name", a, b, new Point(0, 0));
delete b.x;
show("and lost one", a, b, new Point(0, 0));
b.x = 6;
show("and got it back", a, b);

function literal(flip) {
  return flip ? { p: 1, q: 2 } : { q: 2, p: 1 };
}
show("literals", literal(true), literal(false), literal(true));
function filled(order) {
  const object = {};
  for (const name of order) {
    if (name === "p") object.p = 1;
    else if (name === "q") object.q = 2;
    else object.r = 3;
  }
  return object;
}
show("filled in several orders", filled("pqr"), filled("rqp"), filled("qp"), filled("p"), filled(""), filled("pqr"));
show("frozen", Object.freeze(filled("pq")), filled("pq"), Object.seal(filled("qp")));

const heir = Object.create(literal(true));
heir.own = 1;
show("an object below a literal", heir);
Object.getPrototypeOf(heir).late = 3;
show("the literal got a name", heir);

class Indexed {
  constructor() {
    this.x = 1;
  }
}
const indexed = new Indexed();
show("class", indexed, indexed);
Indexed.prototype[0] = 1;
show("first index on the class prototype", indexed, new Indexed());
Indexed.prototype[1] = 1;
show("second index on the class prototype", indexed, new Indexed());
delete Indexed.prototype[0];
show("index deleted from the class prototype", indexed, new Indexed());

function Old() {
  this.y = 1;
}
Old.prototype.method = function () {};
const old = new Old();
show("constructor function", old, old);
Old.prototype[0] = 1;
show("first index on its prototype", old, new Old());
Old.prototype[1] = 1;
show("second index on its prototype", old, new Old());
delete Old.prototype[0];
show("index deleted from its prototype", old, new Old());

class Base {
  constructor() {
    this.z = 1;
  }
}
class Derived extends Base {
  constructor() {
    super();
    this.w = 2;
  }
}
const derived = new Derived();
show("derived class", derived, derived);
Base.prototype[7] = 1;
show("index on the base's prototype", derived, new Derived());
Base.prototype["8"] = 1;
show("second index on the base's prototype", derived, new Derived());
Object.defineProperty(Base.prototype, 7, { enumerable: false });
show("index hidden", derived, new Derived());
//// for-in-over-literals-that-change.js
// for-in loops over literals whose names the compiler knows, while callbacks delete, add, redefine and reorder what the loop walks: each loop lists what the language says, whatever it was compiled to.
const print = console.log;
const makeTriple = v => ({ first: v, second: v, third: v });
const makeReversed = v => ({ third: v, second: v, first: v });
function walk(object, note) {
  for (const key in object) note(key, object);
}
function copy(target, source) {
  for (const key in source) target[key] = source[key];
  return target;
}
function firstKey(object) {
  for (const key in object) return key;
  return "none";
}
const set = (object, key, value) => {
  object[key] = value;
  return object;
};
const remove = (object, key) => {
  delete object[key];
  return object;
};
const setPrototype = (object, prototype) => Object.setPrototypeOf(object, prototype);

const show = (what, object, change) => {
    let seen = "";
    try {
        walk(object, (key, walked) => {
            seen += " " + key + "=" + walked[key];
            change(key, walked);
        });
    } catch (error) {
        seen += " threw " + error;
    }
    print(what + ":" + seen);
};
const nothing = () => { };
for (let round = 0; round < 3; round++) {
    show("unchanged", makeTriple(round), nothing);
    show("other order", makeReversed(round), nothing);
}
show("next name deleted", makeTriple(1), (key, walked) => { if (key === "first") remove(walked, "second"); });
show("last name deleted", makeTriple(1), (key, walked) => { if (key === "first") remove(walked, "third"); });
show("own name deleted", makeTriple(1), (key, walked) => { remove(walked, key); });
show("all deleted at once", makeTriple(1), (key, walked) => { remove(walked, "first"); remove(walked, "second"); remove(walked, "third"); });
show("deleted and stored again", makeTriple(1), (key, walked) => { if (key === "first") { remove(walked, "second"); set(walked, "second", 9); } });
show("name added", makeTriple(1), (key, walked) => { if (key === "first") set(walked, "fourth", 4); });
show("index added", makeTriple(1), (key, walked) => { if (key === "second") set(walked, "5", 5); });
show("value stored", makeTriple(1), (key, walked) => { set(walked, "third", key); });
show("value of another kind stored", makeTriple(1), (key, walked) => { if (key === "first") set(walked, "second", { toString() { return "object"; } }); });
show("many names added", makeTriple(1), (key, walked) => { if (key === "first") for (let i = 0; i < 200; i++) set(walked, "name" + i, i); });
show("prototype changed", makeTriple(1), (key, walked) => { if (key === "first") setPrototype(walked, { inherited: 7 }); });
show("prototype set before", setPrototype(makeTriple(1), { inherited: 7, second: 8 }), nothing);
show("no prototype", setPrototype(makeTriple(1), null), nothing);
show("made an accessor", makeTriple(1), (key, walked) => { if (key === "first") Object.defineProperty(walked, "second", { get() { return "got"; }, enumerable: true, configurable: true }); });
show("hidden", makeTriple(1), (key, walked) => { if (key === "first") Object.defineProperty(walked, "second", { enumerable: false }); });
show("frozen", makeTriple(1), (key, walked) => { Object.freeze(walked); });
show("callback throws", makeTriple(1), key => { if (key === "second") throw "stop"; });
show("extra name before", set(makeTriple(1), "fourth", 4), nothing);
show("one name missing before", remove(makeTriple(1), "second"), nothing);
show("ordinary object", { first: 1, second: 2, third: 3 }, nothing);
show("array", [1, 2], nothing);
show("string", "ab", nothing);
show("null", null, nothing);
show("undefined", undefined, nothing);
show("number", 5, nothing);

const list = object => { let text = ""; for (const key in object) text += " " + key + "=" + object[key]; return text; };
print("copy:" + list(copy({}, makeTriple(2))));
print("copy of the other order:" + list(copy({}, makeReversed(2))));
print("copy into itself:" + list((triple => copy(triple, triple))(makeTriple(3))));
print("copy into a triple:" + list(copy(makeTriple(1), makeReversed(2))));
print("copy through a setter:" + list(copy({ set second(value) { this.seen = value; } }, makeTriple(4))));
const source = makeTriple(5);
print("copy into an object that changes the source:" + list(copy({ set first(value) { remove(source, "third"); } }, source)));
print("first key: " + firstKey(makeTriple(1)) + " " + firstKey(makeReversed(1)) + " " + firstKey({}) + " " + firstKey(remove(makeTriple(1), "first")));

////= lines-26	skipSecond	continue
////= lines-26	untilSecond	break
function pairs(object) {
  let seen = "";
  outer: for (const a in object) {
    for (const b in object) {
      if (b === "third") continue outer;
      seen += a[0] + b[0] + " ";
    }
  }
  return seen;
}
function closures(object) {
  const list = [];
  for (const key in object) list.push(() => key);
  return list.map(f => f()).join();
}
function withFinally(object) {
  let seen = "";
  for (const key in object) {
    try {
      if (key === "second") continue;
      seen += key;
    } finally {
      seen += "!";
    }
  }
  return seen;
}
function* yielded(object) {
  for (const key in object) yield key;
}
function counted(object) {
  let count = 0, last;
  for (var key in object) {
    count++;
    last = key;
  }
  return count + " " + last + " " + key;
}
for (let round = 0; round < 3; round++) {
  const triple = makeTriple(round), reversed = makeReversed(round);
  print(skipSecond(triple), skipSecond(reversed), untilSecond(triple), untilSecond(reversed));
  print(pairs(triple), "|", pairs(reversed));
  print(closures(triple), closures(reversed), withFinally(triple), withFinally(reversed));
  print([...yielded(triple)].join(), [...yielded(reversed)].join(), counted(triple), counted(reversed), counted({}));
}
//// for-in-reads-in-nested-loops.ts
// A member read by the key of a for-in loop stays the same value in every round of a loop nested in the body, whether that loop is written there or comes from an inlined call.
const lines: string[] = [];
const numbers: Record<string, number> = { a: 5, b: 6, c: 7.5 };
const texts: Record<string, string> = { a: "x", b: "yz" };
const mixed: any = { a: 1, b: "two", c: null, d: undefined, e: [3], f: { g: 4 }, 7: "seven", 0: "zero" };

let atTopLevel = 0;
for (const key in numbers) { const value = numbers[key]; let i = 0; while (i < 3) { atTopLevel += value; i++; } }
lines.push("top level while " + atTopLevel);

let withFor = 0;
for (const key in numbers) { const value = numbers[key]; for (let i = 0; i < 3; i++) withFor += value; }
lines.push("top level for " + withFor);

function whileLoop(o: Record<string, number>): number { let sum = 0; for (const key in o) { const value = o[key]; let i = 0; while (i < 4) { sum += value; i++; } } return sum; }
function forLoop(o: Record<string, number>): number { let sum = 0; for (const key in o) { const value = o[key]; for (let i = 0; i < 4; i++) sum += value; } return sum; }
function doLoop(o: Record<string, number>): number { let sum = 0; for (const key in o) { const value = o[key]; let i = 0; do { sum += value; i++; } while (i < 4); } return sum; }
function readInside(o: Record<string, number>): number { let sum = 0; for (const key in o) { for (let i = 0; i < 4; i++) sum += o[key]; } return sum; }
function readBoth(o: Record<string, number>): number { let sum = 0; for (const key in o) { const value = o[key]; for (let i = 0; i < 4; i++) sum += value + o[key]; sum -= value; } return sum; }
function twoLoops(o: Record<string, number>): number { let sum = 0; for (const key in o) { const value = o[key]; for (let i = 0; i < 2; i++) sum += value; for (let j = 0; j < 3; j++) sum -= value / 2; } return sum; }
function loopInLoop(o: Record<string, number>): number { let sum = 0; for (const key in o) { const value = o[key]; for (let i = 0; i < 2; i++) for (let j = 0; j < 3; j++) sum += value; } return sum; }
function leftEarly(o: Record<string, number>): number { let sum = 0; for (const key in o) { const value = o[key]; for (let i = 0; i < 9; i++) { if (i === 2) break; sum += value; } } return sum; }
function skipped(o: Record<string, number>): number { let sum = 0; for (const key in o) { const value = o[key]; for (let i = 0; i < 5; i++) { if (i % 2) continue; sum += value; } } return sum; }
function labelled(o: Record<string, number>): number { let sum = 0; outer: for (const key in o) { const value = o[key]; for (let i = 0; i < 5; i++) { if (value > 6 && i === 1) continue outer; sum += value; } } return sum; }
function noRounds(o: Record<string, number>, n: number): number { let sum = 0; for (const key in o) { const value = o[key]; for (let i = 0; i < n; i++) sum += value; sum += value; } return sum; }
function joined(o: Record<string, string>): string { let all = ""; for (const key in o) { const value = o[key]; for (let i = 0; i < 3; i++) all += key + value; } return all; }
function untyped(o: any): string { let all = ""; for (const key in o) { const value = o[key]; for (let i = 0; i < 2; i++) all += key + "=" + String(value) + ";"; } return all; }
function nestedForIn(o: Record<string, number>, p: Record<string, string>): string { let all = ""; for (const key in o) { const value = o[key]; for (const other in p) { const text = p[other]; for (let i = 0; i < 2; i++) all += value + text; } } return all; }
function guarded(o: Record<string, number>): number { let sum = 0; for (const key in o) { if (Object.hasOwn(o, key)) { const value = o[key]; for (let i = 0; i < 3; i++) sum += value; } } return sum; }
function stored(o: Record<string, number>): string { for (const key in o) { const value = o[key]; for (let i = 0; i < 3; i++) o[key] = o[key] + value; } return JSON.stringify(o); }
function removed(o: Record<string, number>): string { let all = ""; for (const key in o) { const value = o[key]; delete o.b; for (let i = 0; i < 2; i++) all += key + value; } return all; }
function caught(o: Record<string, number>): number { let sum = 0; for (const key in o) { const value = o[key]; try { for (let i = 0; i < 3; i++) { if (i === 2) throw new Error("out"); sum += value; } } catch { sum += value * 100; } } return sum; }
lines.push([whileLoop(numbers), forLoop(numbers), doLoop(numbers), readInside(numbers), readBoth(numbers), twoLoops(numbers), loopInLoop(numbers), leftEarly(numbers), skipped(numbers), labelled(numbers), noRounds(numbers, 0), noRounds(numbers, 2)].join(" "));
lines.push(joined(texts), untyped(mixed), untyped([1, 2]), untyped("ab"), nestedForIn(numbers, texts), String(guarded(numbers)), stored({ a: 1, b: 2 }), removed({ a: 1, b: 2, c: 3 }), String(caught(numbers)));

let calls = 0;
const table: Record<string, (n: number) => void> = { first(n) { calls += n; }, second(n) { calls += n * 10; } };
function callThrice(f: (n: number) => void): void { for (let i = 0; i < 3; i++) f(i); }
for (const key in table) callThrice(table[key]);
lines.push("calls " + calls);

class Base { inherited = 1; }
class Heir extends Base { own = 2; }
function overInstance(o: any): string { let all = ""; for (const key in o) { const value = o[key]; for (let i = 0; i < 2; i++) all += key + value; } return all; }
lines.push(overInstance(new Heir()), overInstance(Object.create({ fromPrototype: 3 }, { own: { value: 4, enumerable: true } })), overInstance(Object.assign(Object.create({ a: "shadowed", z: "far" }), { a: "near" })));

