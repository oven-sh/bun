//// for-in-several-uses-of-the-key.js
// Several uses of the key in one for-in body: own and inherited keys, objects that change between the uses, other objects under the same key, getters, proxies, arrays and nested loops.
function copyOwn(from) {
  const to = {};
  for (const key in from) {
    if (Object.hasOwn(from, key)) to[key] = from[key];
  }
  return to;
}

function describe(object) {
  const parts = [];
  for (const key in object) {
    parts.push(key + ":" + (key in object) + ":" + object.hasOwnProperty(key) + ":" + String(object[key]));
  }
  return parts.join(" ");
}

function deleteNextThenRead(object, doomed) {
  const parts = [];
  for (const key in object) {
    const before = object[key];
    delete object[doomed];
    parts.push(key + "=" + before + "/" + object[key] + "/" + (key in object) + "/" + Object.hasOwn(object, key));
  }
  return parts.join(" ");
}

function addThenRead(object) {
  const parts = [];
  let added = 0;
  for (const key in object) {
    const before = Object.hasOwn(object, key);
    object["added" + added++] = key;
    parts.push(key + "=" + before + "/" + object[key] + "/" + Object.hasOwn(object, key));
  }
  return parts.join(" ") + " | " + Object.keys(object).join(",");
}

function redefineThenRead(object, log) {
  const parts = [];
  for (const key in object) {
    const before = object[key];
    Object.defineProperty(object, key, {
      get() {
        log.push("get " + key);
        return "getter of " + key;
      },
      enumerable: true,
      configurable: true,
    });
    parts.push(before + "->" + object[key] + ":" + (key in object));
  }
  return parts.join(" ");
}

function compare(a, b) {
  const parts = [];
  for (const key in a) {
    parts.push(key + ":" + (key in b) + ":" + Object.hasOwn(b, key) + ":" + (a[key] === b[key]) + ":" + b[key]);
  }
  return parts.join(" ");
}

function callBetween(object, action) {
  const parts = [];
  for (const key in object) {
    const before = object[key];
    action(object, key);
    parts.push(key + "=" + before + "/" + object[key] + "/" + Object.hasOwn(object, key));
  }
  return parts.join(" ");
}

function sumInInnerLoop(object, rounds) {
  let sum = 0;
  for (const key in object) {
    for (let i = 0; i < rounds; i++) if (Object.hasOwn(object, key)) sum += object[key];
  }
  return sum;
}

function table(rows) {
  const parts = [];
  for (const row in rows) {
    for (const column in rows[row]) {
      if (Object.hasOwn(rows, row) && Object.hasOwn(rows[row], column)) parts.push(row + "." + column + "=" + rows[row][column]);
    }
  }
  return parts.join(" ");
}

const show = object => JSON.stringify(object);
const point = () => ({ x: 1, y: 2, z: 3 });

let checksum = 0;
for (let i = 0; i < 20000; i++) {
  const copy = copyOwn({ a: i, b: i + 1, c: "text" });
  checksum = (checksum + copy.a + copy.b + copy.c.length + sumInInnerLoop(point(), 3)) | 0;
}
console.log(checksum);

console.log(show(copyOwn(point())), describe(point()));

const base = { inherited: "base", shadowed: "base" };
const derived = Object.create(base);
derived.own = "derived";
derived.shadowed = "derived";
console.log(show(copyOwn(derived)), describe(derived));

console.log(deleteNextThenRead(point(), "y"), "|", deleteNextThenRead(point(), "x"), "|", deleteNextThenRead(point(), "z"));
console.log(addThenRead(point()));
const log = [];
console.log(redefineThenRead(point(), log), log.join(";"));

console.log(compare(point(), point()), "|", compare(point(), { x: 1, z: 4 }), "|", compare(point(), Object.create(point())), "|", compare(point(), [7, 8]));
console.log(callBetween(point(), () => {}), "|", callBetween(point(), (object, key) => delete object[key]), "|", callBetween(point(), (object, key) => (object[key] *= 10)));
console.log(callBetween(point(), object => Object.setPrototypeOf(object, base)), "|", callBetween(point(), object => Object.freeze(object)));

console.log(describe([10, , 30]), "|", describe(new String("ab")), "|", describe(Object.assign([1], { named: 2 })), "|", describe(new Map([[1, 2]])));
console.log(describe(Object.assign(Object.create(null), { bare: 1, hasOwnProperty: () => "mine" })));

const trapped = [];
const proxy = new Proxy(point(), {
  has(target, key) {
    trapped.push("has " + String(key));
    return key in target;
  },
  get(target, key) {
    trapped.push("get " + String(key));
    return target[key];
  },
  getOwnPropertyDescriptor(target, key) {
    trapped.push("describe " + String(key));
    return Reflect.getOwnPropertyDescriptor(target, key);
  },
});
console.log(show(copyOwn(proxy)), trapped.join(","));

console.log(table({ first: { a: 1, b: 2 }, second: { c: 3 } }), "|", table([{ a: 1 }, [5, 6]]));

const wide = {};
for (let i = 0; i < 200; i++) wide["key" + i] = i;
console.log(sumInInnerLoop(wide, 2), Object.keys(copyOwn(wide)).length);
delete wide.key7;
console.log(sumInInnerLoop(wide, 2), Object.keys(copyOwn(wide)).length);
//// freeze.ts
// Typed objects stay ordinary JavaScript objects: properties can be added and deleted, and they can be frozen and sealed.
class P { x = 1; y = "a"; get sum() { return this.x + this.y } }
const log: unknown[] = []
const p = new P()
const loose: any = p
loose.extra = 5
loose[Symbol.for("s")] = "sym"
loose[7] = "seven"
log.push(loose.extra, Object.keys(p).join(), "extra" in p, JSON.stringify(p), loose[Symbol.for("s")], loose[7], p instanceof P, p.sum)
log.push(delete loose.extra, loose.extra, Object.keys(p).join(), Object.getOwnPropertyNames(p).join())
function readX(o: P): number { return o.x }
let total = 0
for (let i = 0; i < 100; i++) total += readX(i % 2 ? p : new P())
log.push(total)
const many: any[] = [p, new P(), { x: 10, y: "lit" }]
log.push(many.map(o => o.x + o.y).join())
const frozen = Object.freeze({ a: 1, b: { c: 2 } })
log.push(Object.isFrozen(frozen), Object.isFrozen(frozen.b), Object.isSealed(frozen), Object.isExtensible(frozen))
try { (frozen as any).a = 2; log.push("written") } catch (e) { log.push((e as Error).constructor.name) }
try { (frozen as any).z = 2; log.push("added") } catch (e) { log.push((e as Error).constructor.name) }
try { delete (frozen as any).a; log.push("deleted") } catch (e) { log.push((e as Error).constructor.name) }
frozen.b.c = 3
log.push(frozen.a, frozen.b.c, JSON.stringify(Object.getOwnPropertyDescriptor(frozen, "a")))
const q = new P()
function bump(o: P): void { o.x++ }
bump(q); Object.freeze(q)
try { bump(q); log.push("bumped") } catch (e) { log.push((e as Error).constructor.name) }
log.push(q.x)
const sealed = Object.seal({ n: 1 })
sealed.n = 2
try { (sealed as any).m = 1; log.push("added") } catch (e) { log.push((e as Error).constructor.name) }
log.push(sealed.n, Object.isSealed(sealed), Object.isFrozen(sealed), JSON.stringify(Object.getOwnPropertyDescriptor(sealed, "n")))
// `k` is optional, so that it may be deleted. Of a required field: type-rules/freeze.
const open: { k?: number } = { k: 1 }
const closed = Object.preventExtensions(open)
closed.k = 5
try { (closed as any).j = 1; log.push("added") } catch (e) { log.push((e as Error).constructor.name) }
log.push(closed.k, Object.isExtensible(closed), delete closed.k, JSON.stringify(closed))
const copy = { ...p, more: true }
log.push(JSON.stringify(copy), JSON.stringify((Object.assign as any)({}, p)), Object.entries(p).length)
Object.defineProperty(loose, "hidden", { value: 9, enumerable: false })
log.push(loose.hidden, Object.keys(p).join())
console.log(log.join("\n"))
//// frozen-and-sealed-objects-with-indexed-properties.ts
// Object.freeze, Object.seal and Object.preventExtensions on typed objects that have elements, accessors under an index, added names and symbols.
function outcome(f: () => unknown): string { try { return JSON.stringify(f()) ?? "undefined" } catch (e) { return "throws " + (e as Error).name } }
function show(label: string, ...parts: unknown[]): void { console.log(label + ": " + parts.map(String).join(" | ")) }

class Row { [index: number]: unknown; constructor(public name: string, public size: number) {} }
type Rec = { name: string, size: number, [index: number]: unknown }
const mark = Symbol("mark")
const strict: any = (0, eval)(`({ store(o, k, v) { "use strict"; o[k] = v; return o[k]; }, remove(o, k) { "use strict"; return delete o[k]; } })`)

const kinds: [string, () => any][] = [["instance", () => new Row("row", 1)], ["literal", (): Rec => ({ name: "rec", size: 1 })]]
const contents: [string, (o: any) => void][] = [
  ["nothing more", () => {}],
  ["elements", o => { o[0] = "a"; o[1] = 1.5; o[2] = {} }],
  ["a sparse element", o => { o[0] = "a"; o[100000] = "far" }],
  ["an accessor under an index", o => { o[0] = "a"; Object.defineProperty(o, 1, { get() { return this.name }, set(v) { this.size = v }, configurable: true, enumerable: true }) }],
  ["a read-only element", o => { Object.defineProperty(o, 1, { value: "fixed", configurable: true, enumerable: true }) }],
  ["elements, a name and a symbol", o => { o[0] = "a"; o.added = "b"; o[mark] = "c" }],
]
const levels: [string, (o: object) => void][] = [["frozen", Object.freeze], ["sealed", Object.seal], ["not extensible", Object.preventExtensions]]

function describe(o: any): string {
  const descriptors = Object.getOwnPropertyDescriptors(o)
  return Reflect.ownKeys(descriptors).map(key => {
    const d = (descriptors as any)[key]
    return String(key) + ":" + ("value" in d ? "v" : "a") + (d.writable ? "w" : "") + (d.enumerable ? "e" : "") + (d.configurable ? "c" : "")
  }).join() + " " + [Object.isFrozen(o), Object.isSealed(o), Object.isExtensible(o)].join()
}

for (const [kind, create] of kinds) {
  for (const [content, fill] of contents) {
    for (const [level, apply] of levels) {
      const o = create()
      fill(o)
      apply(o)
      show([kind, content, level].join(", "), describe(o),
        outcome(() => strict.store(o, 0, "again")), outcome(() => strict.store(o, 1, 7)), outcome(() => strict.store(o, 5, "new")), outcome(() => strict.store(o, "name", "other")),
        outcome(() => strict.remove(o, 0)), outcome(() => strict.remove(o, 1)), outcome(() => strict.remove(o, "size")),
        outcome(() => Object.defineProperty(o, 0, { get() { return 1 } }) === o), outcome(() => Object.defineProperty(o, 9, { value: 1 }) === o),
        JSON.stringify(o), o.name, o.size, describe(o))
    }
  }
}
export {}
