//// function-names-from-number-keys.ts
// The `name` of a function, method, accessor or class that an object literal defines under a computed key that is a number.
enum K { A, B }

const nameAt = (o: any, key: any): string => o[key].name;
const getterAt = (o: object, key: any) => Object.getOwnPropertyDescriptor(o, key)!.get!;
const setterAt = (o: object, key: PropertyKey) => Object.getOwnPropertyDescriptor(o, key)!.set!;
const show = (label: string, value: unknown) => console.log(label + ": " + JSON.stringify(value));

show("method", nameAt({ [1 + 1]() {} }, 2));
show("method with super", nameAt({ [1 + 1]() { return super.x; } }, 2));
show("generator method with super", nameAt({ *[1 + 1]() { yield super.x; } }, 2));
show("async method with super", nameAt({ async [1 + 1]() { return super.x; } }, 2));
show("arrow function under an enum member", nameAt({ [K.A]: () => 1 }, 0));
show("function expression under an enum member", nameAt({ [K.B]: function () {} }, 1));
show("class expression under an enum member", nameAt({ [K.B]: class {} }, 1));
show("named function expression keeps its name", nameAt({ [K.B]: function own() {} }, 1));
show("getter", getterAt({ get [1 + 1]() { return 1; } }, 2).name);
show("getter with super", getterAt({ get [2]() { return super.x; } }, 2).name);
show("setter", setterAt({ set [1 + 2](v: number) {} }, 3).name);
show("setter with super", setterAt({ set [K.B](v: number) { super.x = v; } }, 1).name);

function methodName(key: number) { return nameAt({ [key]() { return super.x; } }, key); }
function arrowName(key: number) { return nameAt({ [key]: () => key }, key); }
function getterName(key: number) { return getterAt({ get [key]() { return super.x; } }, key).name; }
for (const key of [0, 7, -1, 0.5, -0, 4294967295, 1e21, 1e-7, NaN, Infinity, -Infinity]) {
  show(Object.is(key, -0) ? "-0" : String(key), [methodName(key), arrowName(key), getterName(key)]);
}

function untypedNames(key: any) {
  return [nameAt({ [key]() { return super.x; } }, key), nameAt({ [key]: () => 1 }, key), getterAt({ get [key]() { return super.x; } }, key).name];
}
show("bigint", untypedNames(5n));
show("boolean", untypedNames(true));
show("null", untypedNames(null));
show("undefined", untypedNames(undefined));
show("string", untypedNames("text"));
show("symbol", untypedNames(Symbol("tag")));
show("symbol without a description", untypedNames(Symbol()));

let conversions = 0;
const counted: any = { toString() { conversions++; return "counted"; } };
show("object", [nameAt({ [counted]() { return super.x; } }, "counted"), nameAt({ [counted]: () => 1 }, "counted"), conversions]);

const derived: any = { __proto__: { x: "inherited" }, [1 + 1]() { return super.x; }, get [K.B]() { return super.x; } };
show("the home object is the literal", [derived[2](), derived[1], Object.keys(derived)]);
//// functions-as-prototypes-of-functions.js
// Functions whose prototype is another function with getters, data and methods on it, read again and again while the chain changes in every way.
const lines = [];
function say(what, value) { lines.push(what + " " + value); }
let made = 0;
const styles = Object.defineProperties(function styles() {}, {
    bold: { get() { return build(this, "b"); }, configurable: true },
    level: { get() { return this.depth; }, configurable: true },
    kind: { value: "style", writable: true, configurable: true },
    describe: { value() { return this.path + ":" + this.depth; }, writable: true, configurable: true },
});
function build(parent, code) {
    const builder = text => builder.path + "(" + text + ")";
    Object.setPrototypeOf(builder, styles);
    builder.depth = (parent.depth | 0) + 1;
    builder.path = (parent.path ?? "") + code;
    made++;
    return builder;
}
function readAll(builder) {
    return builder.level + " " + builder.kind + " " + builder.describe() + " " + ("level" in builder) + " " + ("missing" in builder) + " " + builder.missing + " " + builder.length + " " + builder.name;
}
const root = build({}, "r");
const other = build(root, "o");
let seen = new Set();
for (let round = 0; round < 40; round++) seen.add(readAll(round & 1 ? root : other));
say("as made", [...seen].join(" | "));
say("chained", root.bold.bold("x") + " " + root.bold.bold.level + " " + made);

Object.defineProperty(styles, "level", { get() { return -this.depth; }, configurable: true });
say("another getter", readAll(root));
Object.defineProperty(styles, "level", { value: 7, writable: true, configurable: true });
say("data in place of the getter", readAll(root));
styles.kind = "changed";
say("data stored", readAll(root));
root.kind = "own";
say("shadowed", readAll(root) + " | " + readAll(other));
delete root.kind;
say("no longer shadowed", readAll(root));
delete styles.level;
say("deleted above", readAll(root));
styles.missing = "found";
say("added above", readAll(root) + " | " + readAll(other));
delete styles.missing;
say("taken away above", readAll(root));
Object.defineProperty(styles, "level", { get() { return this.depth * 10; }, configurable: true });
for (let round = 0; round < 40; round++) seen.add(readAll(root));
say("a getter again", readAll(root));

const between = function between() {};
between.extra = "between";
Object.setPrototypeOf(between, styles);
Object.setPrototypeOf(other, between);
function readExtra(builder) { return builder.extra + " " + builder.level + " " + ("extra" in builder); }
seen = new Set();
for (let round = 0; round < 40; round++) seen.add(readExtra(round & 1 ? root : other));
say("a function between", [...seen].join(" | "));
Object.defineProperty(between, "level", { value: "from between", configurable: true });
say("the function between answers", readExtra(other) + " | " + readExtra(root));
Object.setPrototypeOf(between, null);
say("the chain is cut", readExtra(other));
Object.setPrototypeOf(other, Function.prototype);
say("back under Function.prototype", readExtra(other) + " " + typeof other.call);

const bare = () => 1;
const underBare = () => 2;
Object.setPrototypeOf(underBare, bare);
function readLate(f) { return f.late + " " + ("late" in f) + " " + f.name + " " + f.length; }
for (let round = 0; round < 40; round++) readLate(underBare);
say("under a function without properties", readLate(underBare));
bare.late = "now";
say("which gets one", readLate(underBare));
delete bare.late;
say("and loses it", readLate(underBare));

styles.displayName = "shown";
say("displayName above", root.displayName + " " + Object.hasOwn(root, "displayName"));
try { root.level = "stored below a getter without a setter"; } catch (error) { say("a store below a getter throws", error.constructor.name); }
say("a store below a getter", root.level + " " + Object.hasOwn(root, "level"));
Object.freeze(styles);
say("frozen above", readAll(root));
console.log(lines.join("\n"));
//// getters-of-a-literal-that-is-evaluated-many-times.ts
// One literal with getters makes many objects. Each object has getters of its own, in the order of the literal, and what is done to one object says nothing about the next.
const out: string[] = [];
const log = (...parts: unknown[]) => { out.push(parts.map(part => (typeof part === "string" ? part : JSON.stringify(part))).join(" ")); };
const describe = (object: object) => Object.entries(Object.getOwnPropertyDescriptors(object)).map(([key, d]) => key + ":" + ("get" in d ? (d.get ? "g" : "-") + (d.set ? "s" : "-") : "v") + (d.enumerable ? "e" : "-") + (d.configurable ? "c" : "-")).join(" ");

interface Source { id: number; name: string; list: number[] }
function viewOf(source: Source) {
  return {
    get id() { return source.id; },
    get name() { return source.name; },
    get size() { return source.list.length; },
    get first() { return source.list[0]; },
    get never() { return source.name + source.id; },
    plain: source.id * 2,
    get last() { return source.list[source.list.length - 1]; },
  };
}
const views = [1, 2, 3, 4, 5, 6].map(id => viewOf({ id, name: "n" + id, list: [id, id + 1, id + 2].slice(0, (id % 3) + 1) }));
for (const view of views) log(view.id, view.name, view.size, view.first, view.last, view.plain);
log(describe(views[0]!)); log(describe(views[5]!));
log(Object.keys(views[3]!).join(), JSON.stringify(views[4]));
log("own getters", Object.getOwnPropertyDescriptor(views[0]!, "id")!.get === Object.getOwnPropertyDescriptor(views[1]!, "id")!.get, Object.getOwnPropertyDescriptor(views[0]!, "id")!.get === Object.getOwnPropertyDescriptor(views[0]!, "id")!.get);
log("called on another object", Object.getOwnPropertyDescriptor(views[2]!, "never")!.get!.call(views[0]));

// What happens to one object stays with it.
delete (views[0] as any).name;
Object.defineProperty(views[1]!, "id", { value: "data now", enumerable: false });
Object.defineProperty(views[2]!, "size", { get() { return "other getter"; }, configurable: true, enumerable: true });
Object.freeze(views[3]);
(views[4] as any).added = 1;
Object.setPrototypeOf(views[5]!, { inherited: "yes" });
for (const view of views) log(describe(view), (view as any).inherited);
const later = viewOf({ id: 9, name: "later", list: [] });
log(describe(later), JSON.stringify(later), later.first, later.last);
try { "use strict"; (later as any).id = 3; log("stored"); } catch (error) { log((error as Error).constructor.name); }

// Getters and setters of one name, names that are no identifiers, symbols, computed keys that name a member again.
const tag = Symbol("tag");
let written: unknown[] = [];
function mixed(n: number, key: string) {
  return {
    get both() { return n; }, set both(value: number) { written.push(value + n); },
    get twice() { return "once " + n; },
    set only(value: number) { written.push(-value); },
    get 0() { return "zero " + n; }, get "a b"() { return "spaced " + n; }, get [tag]() { return "symbol " + n; }, get [key]() { return "computed " + n; },
    data: n, get data2() { return n + 1; },
  };
}
for (const [n, key] of [[1, "x"], [2, "y"], [3, "data"], [4, "both"]] as [number, string][]) {
  const object: any = mixed(n, key);
  object.both = 10; object.only = n;
  log(describe(object), object.both, object.twice, object[0], object["a b"], object[tag], object[key], object.data, object.data2, object.only);
}
log(written);

// More getters than one operation takes, and objects that grow old between the allocation and the getters.
function wide(n: number) {
  const pause = () => { if (n % 7 === 0) Bun.gc(true); return n; };
  return {
    get g0() { return n; }, get g1() { return n + 1; }, get g2() { return n + 2; }, get g3() { return n + 3; }, get g4() { return n + 4; }, get g5() { return n + 5; }, get g6() { return n + 6; }, get g7() { return n + 7; },
    get g8() { return n + 8; }, get g9() { return n + 9; }, get g10() { return n + 10; }, get g11() { return n + 11; }, get g12() { return n + 12; }, get g13() { return n + 13; }, get g14() { return n + 14; }, get g15() { return n + 15; },
    middle: pause(),
    get g16() { return n + 16; }, get g17() { return n + 17; }, get g18() { return n + 18; }, get g19() { return n + 19; }, get g20() { return n + 20; }, get g21() { return n + 21; }, get g22() { return n + 22; }, get g23() { return n + 23; },
    get g24() { return n + 24; }, get g25() { return n + 25; }, get g26() { return n + 26; }, get g27() { return n + 27; }, get g28() { return n + 28; }, get g29() { return n + 29; }, get g30() { return n + 30; }, get g31() { return n + 31; },
    get g32() { return n + 32; }, get g33() { return n + 33; }, get g34() { return n + 34; }, get g35() { return n + 35; }, get g36() { return n + 36; }, get g37() { return n + 37; }, get g38() { return n + 38; }, get g39() { return n + 39; },
  };
}
let sum = 0; const keptWide: ReturnType<typeof wide>[] = [];
for (let n = 0; n < 60; n++) { const object = wide(n); keptWide.push(object); if (n % 11 === 0) Bun.gc(true); for (const value of Object.values(object)) sum += value; }
Bun.gc(true);
log(sum, keptWide.reduce((total, object) => total + object.g0 + object.g15 + object.g16 + object.g39 + object.middle, 0), Object.keys(keptWide[59]!).length, Object.keys(keptWide[7]!).slice(14, 20).join());

// Two literals of one type, with getters of their own.
interface Pair { readonly left: number; readonly right: number }
const plus = (n: number): Pair => ({ get left() { return n + 1; }, get right() { return n + 2; } });
const minus = (n: number): Pair => ({ get left() { return n - 1; }, get right() { return n - 2; } });
const swapped = (n: number): Pair => ({ get right() { return n * 2; }, get left() { return n * 3; } });
const pairs: Pair[] = [];
for (let n = 0; n < 12; n++) pairs.push([plus, minus, swapped][n % 3]!(n));
log(pairs.map(pair => pair.left + ":" + pair.right + ":" + Object.keys(pair).join("")).join(" "));

// A literal that is a prototype, a literal with another prototype, a literal behind a spread.
const base = (n: number) => ({ get inherited() { return "from base " + n; }, get shadowed() { return "base"; } });
for (let n = 0; n < 4; n++) {
  const child: any = Object.create(base(n)); Object.defineProperty(child, "shadowed", { get() { return "child " + n; } });
  const below = { __proto__: base(n + 10), get own() { return "own " + n; } } as any;
  const copy = { ...base(n + 20), get extra() { return n; } };
  log(child.inherited, child.shadowed, below.inherited, below.own, describe(below), describe(copy), copy.inherited);
}
console.log(out.join("\n"));
//// getters-of-every-kind-found-by-cached-reads.js
// A cached read by name or by key finds a getter of every kind: arrows, functions, methods, with parameters, bound, native, a proxy, a class, async, a generator, one that throws,
// one that recurses until the stack ends, one that replaces itself; while numbers and objects are live in the caller around the read.
const lines = [];
function say(what, value) { lines.push(what + " " + value); }
const kinds = {
    arrow: () => "arrow",
    plain: function () { return "plain " + typeof this; },
    strict: function () { "use strict"; return "strict " + (this === undefined ? "undefined" : typeof this); },
    withParameter: function (a) { return "parameter " + a; },
    withThreeParameters: function (a, b, c) { return "parameters " + a + b + c + arguments.length; },
    withDefault: function (a = 7) { return "default " + a; },
    withRest: function (...rest) { return "rest " + rest.length; },
    bound: function () { return "bound " + this.tag; }.bind({ tag: "kept" }),
    boundWithArgument: function (a) { return "bound argument " + a; }.bind(null, 5),
    native: Math.random.bind === undefined ? null : Object.prototype.toString,
    hostFunction: Array.prototype.slice,
    proxy: new Proxy(function () { return "target " + typeof this; }, {}),
    proxyWithTrap: new Proxy(function () {}, { apply(target, receiver, list) { return "trap " + typeof receiver + list.length; } }),
    async: async function () { return 1; },
