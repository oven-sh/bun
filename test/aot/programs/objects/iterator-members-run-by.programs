//// key-order-with-late-and-deleted-fields.ts
// The key order when fields are added late, deleted and added again.
interface O { a: number; b?: number; c?: string; d?: boolean }
function show(o: object) { return Object.keys(o).join() + " " + JSON.stringify(o) }
function build(x: boolean, y: boolean): O { const o: O = { a: 1 }; if (x) o.c = "c"; if (y) o.b = 2; return o }
console.log(show(build(true, true)), show(build(false, true)), show(build(true, false)), show(build(false, false)))
const mixed: O = { a: 1, d: true }
const open: any = mixed
mixed.c = "late"; mixed.b = 5
console.log(show(mixed))
delete open.c; mixed.c = "again"; open.a = 9
console.log(show(mixed), mixed.a + 1, mixed.c, "c" in mixed)
for (const k in mixed) console.log(k, (mixed as any)[k])
const again: O = { d: false, a: 2 }
delete (again as any).d
again.d = true; again.b = 1; delete again.b; again.c = "x"; again.b = 3
console.log(show(again), Object.entries(again).map(e => e.join("=")).join("&"), show({ ...again }), show(Object.assign({}, again)))
const sealed: O = Object.seal({ a: 1 } as O)
try { sealed.b = 2 } catch (e) { console.log((e as Error).constructor.name) }
console.log(show(sealed), Reflect.ownKeys(again).join())
function many(n: number) { const list: O[] = []; for (let i = 0; i < n; i++) { const o: O = i & 1 ? { a: i, b: i } : { b: i, a: i }; if (i % 3 === 0) o.d = true; list.push(o) } return list.map(o => Object.keys(o).join("")).join() }
console.log(many(7))
//// key-orders-that-grow-at-run-time.ts
// Objects of one declared type get their optional fields in orders that the build has not seen, one field at a time: the order of an object grows, several objects share an order while they agree,
// part where they differ, and none of them sees a key that another one added.
type Options = {
  a?: number; b?: number; c?: number; d?: number; e?: number; f?: number; g?: number; h?: number; i?: number; j?: number;
  k?: number; l?: number; m?: number; n?: number; o?: number; p?: number; q?: number; r?: number; s?: number; t?: number;
};
type Name = keyof Options;

function parsed(names: string): Options {
  return JSON.parse("{" + [...names].map((name, index) => JSON.stringify(name) + ":" + index).join(",") + "}");
}
function copyOf(from: Options): Options {
  return { ...from };
}
function add(to: Options, names: string): Options {
  for (const name of names) to[name as Name] = name.charCodeAt(0);
  return to;
}
function show(label: string, object: Options): void {
  console.log(label, Object.keys(object).join(""), JSON.stringify(object).length, Object.values(object).reduce((sum, value) => sum + value!, 0));
}

const first = copyOf(parsed("tsrqponm"));
const same = copyOf(parsed("tsrqponm"));
const shorter = copyOf(parsed("tsrq"));
const other = copyOf(parsed("tsrqabcd"));
const all: [string, Options][] = [["first", first], ["same", same], ["shorter", shorter], ["other", other]];
for (const [label, object] of all) show(label, object);

add(first, "lk");
for (const [label, object] of all) show("after first grew: " + label, object);
add(same, "kl");
for (const [label, object] of all) show("after same parted: " + label, object);
add(shorter, "ponmlk");
add(other, "e");
for (const [label, object] of all) show("after shorter followed: " + label, object);
add(first, "jihgfedcba");
add(shorter, "jihgfedcba");
add(same, "abcdefghij");
for (const [label, object] of all) show("full: " + label, object);

delete first.t;
add(first, "t");
delete shorter.a;
for (const [label, object] of all) show("after deletes: " + label, object);

const empty: Options = {};
const many: Options[] = [];
for (let round = 0; round < 6; round++) {
  const object = copyOf(empty);
  add(object, "abcdefghijklmnopqrst".slice(round * 3) + "abcdefghijklmnopqrst".slice(0, round * 3));
  many.push(object);
}
many.forEach((object, index) => show("rotated " + index, object));
//// key-orders-that-grow-in-turns.ts
// Objects of two declared types get their optional fields in turns, in orders that the build has not seen, so that the orders of several objects grow at the same time. Others are created whole, with a
// list of keys that goes on, by several keys at once, where the list of an earlier object ends, or leave an order that the build has seen halfway. Each lists its own keys in the order of creation, however it is asked.
type Bag = {
  a?: number; b?: number; c?: number; d?: number; e?: number; f?: number; g?: number; h?: number; i?: number; j?: number; k?: number; l?: number;
  m?: number; n?: number; o?: number; p?: number; q?: number; r?: number; s?: number; t?: number; u?: number; v?: number; w?: number; x?: number;
};
type Box = {
  a?: string; b?: string; c?: string; d?: string; e?: string; f?: string; g?: string; h?: string; i?: string; j?: string; k?: string; l?: string;
  m?: string; n?: string; o?: string; p?: string; q?: string; r?: string; s?: string; t?: string; u?: string; v?: string; w?: string; x?: string;
};
type Name = keyof Bag;

const letters = "abcdefghijklmnopqrstuvwx";

function bagOf(names: string): Bag {
  return JSON.parse("{" + [...names].map((name, index) => JSON.stringify(name) + ":" + index).join(",") + "}");
}
function copyOf(from: Bag): Bag {
  return { ...from };
}
function add(to: Bag, names: string): Bag {
  for (const name of names) to[name as Name] = name.charCodeAt(0);
  return to;
}
function keysOf(object: object): string {
  const byForIn: string[] = [];
  for (const key in object) byForIn.push(key);
  const ways = [
    Object.keys(object).join(""),
    byForIn.join(""),
    Object.entries(object).map(([key]) => key).join(""),
    Object.getOwnPropertyNames(object).join(""),
    Reflect.ownKeys(object).join(""),
    Object.keys({ ...object }).join(""),
    Object.keys(Object.assign({}, object)).join(""),
    Object.keys(JSON.parse(JSON.stringify(object))).join(""),
  ];
  return ways.every(way => way === ways[0]) ? ways[0] || "-" : "the ways differ: " + ways.join(" ");
}

const orders = ["xwvutsrqponmlkjihgfedcba", "axbwcvduetfsgrhqipjoknlm", "mlkjihgfedcbaxwvutsrqpon", "axbwcvduetfsmlnkojpiqhrg"];
const bags: Bag[] = [{}, {}, {}, {}];
const boxes: Box[] = [{}, {}, {}];
for (let step = 0; step < letters.length; step++) {
  bags.forEach((bag, index) => {
    bag[orders[index][step] as Name] = step;
  });
  boxes.forEach((box, index) => {
    box[orders[index + 1][step] as Name] = orders[index + 1][step];
  });
  if (step % 5 === 4 || step === letters.length - 1) {
    bags.forEach((bag, index) => console.log("in turns", step, "bag", index, keysOf(bag)));
    boxes.forEach((box, index) => console.log("in turns", step, "box", index, keysOf(box)));
  }
}
console.log("sums", bags.map(bag => Object.values(bag).reduce((sum, value) => sum + value!, 0)).join(" "), boxes.map(box => Object.values(box).join("")).join(" "));

for (const names of ["qr", "qrst", "qrstuvwx", "qrsx", "qrstuvwa", "q", "", "qrstuvwxabcdefghijklmnop", "qrstuvwxabcdefghijklmnpo", "rq", "qrstuvwxab"])
  console.log("whole", names || "-", keysOf(bagOf(names)), keysOf(copyOf(bagOf(names))), keysOf(add(copyOf(bagOf(names)), "jk")));

function literals(): Bag[] {
  return [{ a: 1, b: 2, c: 3 }, { a: 1, b: 2, d: 4 }, { a: 1, b: 2, d: 4, c: 3 }, { a: 1, b: 2 }, { b: 2, a: 1 }, { a: 1 }, {}];
}
for (const late of ["c", "d", "dc", "cd", "e", "ba", "xd", "dce", "ced"]) {
  console.log("leaves its order with", late, literals().map(bag => {
    for (const name of late) {
      if (!(name in bag))
        bag[name as Name] = 9;
    }
    return keysOf(bag);
  }).join(" "));
}

let asCreated = 0;
let created = 0;
for (let rotation = 0; rotation < letters.length; rotation++) {
  const rotated = letters.slice(rotation) + letters.slice(0, rotation);
  for (let swapped = 0; swapped + 1 < letters.length; swapped += 2) {
    const names = rotated.slice(0, swapped) + rotated[swapped + 1] + rotated[swapped] + rotated.slice(swapped + 2);
    for (const bag of [add({}, names), copyOf(bagOf(names)), add(copyOf(bagOf(names.slice(0, swapped))), names.slice(swapped))]) {
      created++;
      if (keysOf(bag) === names)
        asCreated++;
    }
  }
}
console.log("rotated and swapped", asCreated, "of", created);

function withOutsiders(steps: string): Bag {
  const bag: Bag = { a: 1 };
  for (const step of steps) {
    if (step >= "A" && step <= "Z")
      (bag as any)["outside" + step] = step;
    else
      bag[step as Name] = 2;
  }
  return bag;
}
function listed(object: object): string {
  const byForIn: string[] = [];
  for (const key in object) byForIn.push(key);
  const keys = Object.keys(object).join(",");
  return keys === byForIn.join(",") && keys === Reflect.ownKeys(object).join(",") && keys === Object.keys({ ...object }).join(",") ? keys : "the ways differ";
}
for (const steps of ["AbBc", "AbBc", "AbcB", "ABbc", "bAcB", "bcAB", "AbBcCdDe", "AbBcCdDf", "ABCDb", "ABCDb", "ABCDEb", "bABCDcEFd"])
  console.log("with keys from outside", steps, listed(withOutsiders(steps)));

const emptied = add({}, "hgfedcba");
for (const name of "geca") delete emptied[name as Name];
console.log("after deletes", keysOf(emptied), keysOf(add(emptied, "aceg")), keysOf(add(copyOf(emptied), "ijkl")));
//// keyed-caches-across-collections.ts
// What is remembered about a shape and a key must not outlive either. Shapes are made, asked in every way, dropped and collected, and new ones made with the same names at other places.
const collect: () => void = (globalThis as any).gc ?? (() => (globalThis as any).Bun?.gc(true));
function read(object: any, key: any): any { return object[key]; }
function isIn(object: any, key: any): boolean { return key in object; }
function owns(object: any, key: any): boolean { return Object.prototype.hasOwnProperty.call(object, key); }
function hasOwn(object: any, key: any): boolean { return Object.hasOwn(object, key); }
function store(object: any, key: any, value: any): void { object[key] = value; }
function fresh(text: string): string { return ("[" + text + "]").slice(1, -1); }

const names = ["alpha", "beta", "gamma", "delta", "epsilon", "zeta"];
const mark = Symbol("mark");
let wrong = 0;
let asked = 0;
function expect(what: string, got: any, wanted: any): void {
    asked++;
    if (got !== wanted && wrong++ < 20) console.log("WRONG " + what + ": " + String(got) + ", not " + String(wanted));
}
const parents: any[] = [{ fromParent: "p0" }, { fromParent: "p1", beta: "parent's beta" }, Object.create({ fromGrandparent: "g" })];
function make(round: number, variant: number): [any, Map<any, any>] {
    const parent = parents[variant % parents.length];
    const object: any = variant % 4 === 3 ? {} : Object.create(parent);
    const mirror = new Map<any, any>();
    object["only" + round + "_" + (variant >> 2)] = 0;
    for (let i = 0; i < names.length; i++) {
        const name = names[(i * (1 + variant % 5) + round + variant) % names.length];
        if ((i + variant) % 3 === 0 || mirror.has(name)) continue;
        object[name] = round * 1000 + variant * 10 + i;
        mirror.set(name, object[name]);
    }
    if (variant % 2) { object[mark] = variant; mirror.set(mark, variant); }
    return [object, mirror];
}
function ask(object: any, mirror: Map<any, any>, keys: any[], where: string): void {
    const prototype = Object.getPrototypeOf(object);
    for (const key of keys) {
        const name = typeof key === "string" ? names.find(n => n === key) ?? key : key;
        const own = mirror.has(name);
        expect(where + " read", read(object, key), own ? mirror.get(name) : prototype[name]);
        expect(where + " in", isIn(object, key), own || name in prototype);
        expect(where + " hasOwnProperty", owns(object, key), own);
        expect(where + " hasOwn", hasOwn(object, key), own);
    }
}
const everyKey: any[] = [...names, mark, "fromParent", "fromGrandparent", "toString", "nothing"];
let keep: [any, Map<any, any>][] = [];
for (let round = 0; round < 24; round++) {
    const made: [any, Map<any, any>][] = [];
    for (let variant = 0; variant < 120; variant++) made.push(make(round, variant));
    const cut = everyKey.map(key => typeof key === "string" ? fresh(key) : key);
    for (const [object, mirror] of made) { ask(object, mirror, everyKey, "new"); ask(object, mirror, cut, "new, cut keys"); }
    for (const [object, mirror] of keep) ask(object, mirror, everyKey, "kept");
    for (const [object, mirror] of made) {
        for (const key of ["added", names[round % names.length], mark]) { store(object, key, round); mirror.set(key, round); }
        ask(object, mirror, ["added", ...everyKey], "stored");
    }
    keep = made.filter((_, index) => index % 40 === round % 40).concat(keep.slice(0, 6));
    if (round % 3 !== 2) collect();
    for (const [object, mirror] of keep) ask(object, mirror, cut, "kept over a collection");
}

// An answer that a collection has left alone is still made false by what makes it false.
const base: any = {};
const heir: any = Object.create(base);
heir.own = 1;
expect("absent", read(heir, "arrives"), undefined);
expect("absent in", isIn(heir, "arrives"), false);
collect();
expect("absent after a collection", read(heir, "arrives"), undefined);
base.arrives = "on the prototype";
expect("inherited", read(heir, "arrives"), "on the prototype");
expect("inherited in", isIn(heir, "arrives"), true);
expect("not own", owns(heir, "arrives"), false);
collect();
expect("inherited after a collection", read(heir, "arrives"), "on the prototype");
delete base.arrives;
expect("gone", read(heir, "arrives"), undefined);
expect("gone in", isIn(heir, "arrives"), false);
collect();
Object.defineProperty(base, "arrives", { set(value) { this.caught = value; }, configurable: true });
const other: any = Object.create(base);
other.own = 1;
store(other, "arrives", 5);
expect("a setter that came after a collection", other.caught, 5);
expect("and no own property", owns(other, "arrives"), false);

// A dictionary keeps its shape while its properties come and go.
const table: any = {};
for (let i = 0; i < 150; i++) store(table, "t" + i, i);
for (let turn = 0; turn < 4; turn++) {
    for (let i = 0; i < 150; i++) {
        const there = turn === 0 || i % 2 === 1 || (turn === 3 && i % 4 === 0);
        expect("dictionary read", read(table, "t" + i), there ? i : undefined);
        expect("dictionary in", isIn(table, "t" + i), there);
        expect("dictionary hasOwn", hasOwn(table, "t" + i), there);
    }
    collect();
    if (turn === 0) for (let i = 0; i < 150; i += 2) delete table["t" + i];
    if (turn === 2) for (let i = 0; i < 150; i += 4) store(table, fresh("t" + i), i);
}
console.log("asked " + asked + ", wrong " + wrong);
//// keyed-read-cache-misses.ts
// object[key] where the pair of shape and key is new each time, or has just been made false: every kind of key against every kind of receiver, and what changes between two reads.
function read(object: any, key: any): any { return object[key]; }
function tried(object: any, key: any): any { try { return read(object, key); } catch (error) { return "threw " + (error as Error).constructor.name; } }
function show(value: any): string {
    if (typeof value === "function") return "function " + value.name;
    if (typeof value === "symbol") return value.toString();
    if (value && typeof value === "object") return Array.isArray(value) ? "[" + value.join() + "]" : "object";
    return typeof value === "string" ? JSON.stringify(value) : String(value);
}
const lines: string[] = [];
function note(what: string, value: any): void { lines.push(what + ": " + show(value)); }
// Strings that are no atoms when they arrive: cut, joined, changed in case.
function cut(text: string): string { return ("<" + text + ">").slice(1, -1); }
function joined(text: string): string { return text.length < 2 ? text : text.slice(0, 1) + text.slice(1); }
function lowered(text: string): string { return text.toUpperCase().toLowerCase(); }

const tag = Symbol("tag");
const other = Symbol("other");
const digits = Symbol("1");

class Point { x = 1; y = 2; get sum() { return this.x + this.y; } static origin = "0,0"; static [tag] = "static by symbol"; static make() { return new Point(); } }
class Point3 extends Point { z = 3; static depth = 3; }
function plainFunction(a: any, b: any) { return a + b; }
(plainFunction as any).extra = "on a function";
(plainFunction as any)[tag] = "symbol on a function";
const list: any = [10, 20, 30];
list.label = "on an array";
list[tag] = "symbol on an array";
const bare = Object.create(null);
bare.only = "no prototype";
const withGetter = { get computed() { return "from a getter"; }, plain: "beside a getter" };
const parent = { inherited: "from the parent", shadowed: "parent's", get viaGetter() { return "getter of the parent on " + (this as any).name; } };
const child = Object.create(parent);
child.name = "child";
child.shadowed = "child's";
const frozen = Object.freeze({ cold: "frozen" });
const proxy = new Proxy({ real: 1 }, { get(target, key) { return "trapped " + String(key); } });
const big: any = {};
for (let i = 0; i < 200; i++) big["k" + i] = i;
delete big.k7;
const bySymbol: any = { [tag]: "own symbol", [digits]: "symbol described by a digit" };
const numbered: any = { 0: "zero", 1: "one", "01": "zero one", "-1": "minus one", "1.5": "one and a half", "": "empty name" };
const receivers: [string, any][] = [
    ["literal", { a: 1, b: "two", length: 7, name: "n", prototype: "p" }], ["instance", new Point()], ["derived instance", new Point3()], ["class", Point], ["derived class", Point3], ["function", plainFunction],
    ["array", list], ["bare", bare], ["getter", withGetter], ["child", child], ["frozen", frozen], ["proxy", proxy], ["big", big], ["by symbol", bySymbol], ["numbered", numbered],
    ["string", "text"], ["number", 5], ["boolean", true], ["map", new Map([["a", 1]])], ["bytes", new Uint8Array([7, 8])], ["date", new Date(0)], ["regexp", /x/g], ["error", new RangeError("r")], ["bound", plainFunction.bind(null)],
    ["arrow", () => 1], ["arguments", (function (..._: any[]) { return arguments; })(4, 5)],
];
const names = ["a", "b", "x", "y", "z", "sum", "origin", "depth", "make", "extra", "label", "only", "computed", "plain", "inherited", "shadowed", "viaGetter", "cold", "real", "k0", "k7", "k199", "length", "name", "prototype",
    "constructor", "toString", "hasOwnProperty", "__proto__", "size", "message", "source", "callee", "0", "1", "2", "01", "-1", "-0", "1.5", "", "NaN", "Infinity", "undefined", "nowhere at all", "byteLength"];
for (const [what, receiver] of receivers) {
    for (const name of names) {
        const asAtom = show(tried(receiver, name));
        for (const [how, make] of [["cut", cut], ["joined", joined], ["lowered", lowered]] as [string, (text: string) => string][]) {
            if (how === "lowered" && name !== name.toLowerCase()) continue;
            const made = show(tried(receiver, make(name)));
            if (made !== asAtom) lines.push("DIFFERENT " + what + "[" + how + " " + name + "]: " + made + " and " + asAtom);
        }
        if (name === "__proto__") lines.push(what + ".__proto__ is its prototype: " + (read(receiver, name) === Object.getPrototypeOf(Object(receiver))));
        else if (asAtom !== "undefined") lines.push(what + "[" + JSON.stringify(name) + "]: " + asAtom);
    }
    for (const symbol of [tag, other, digits, Symbol.iterator, Symbol.toStringTag, Symbol.hasInstance]) {
        const found = read(receiver, symbol);
        if (found !== undefined) note(what + "[" + symbol.toString() + "]", found);
    }
    for (const key of [0, 1, 2, -1, 1.5, NaN, null, undefined, true, { toString() { return "a"; } }, ["b"]]) {
        const found = read(receiver, key);
        if (found !== undefined) note(what + "[" + (typeof key === "object" && key ? "an object" : String(key)) + "]", found);
    }
}
for (const nothing of [null, undefined]) {
    for (const key of ["a", cut("a"), tag, 0]) {
        try { read(nothing, key); lines.push("no error"); } catch (error) { lines.push("of " + nothing + ": " + (error as Error).constructor.name); }
    }
}

// New shapes all the time: no cache has the pair.
let sum = 0;
for (let round = 0; round < 3000; round++) {
    const record: any = {};
    for (let i = 0; i < 6; i++) record["r" + (round % 700) + "_" + i] = round + i;
    for (const key of Object.keys(record)) sum += read(record, key);
    sum += read(record, "r" + (round % 700) + "_3");
    if (read(record, "absent" + round) !== undefined || read(record, "toString") !== Object.prototype.toString) sum = NaN;
}
note("sum over new shapes", sum);

// What was read is made false, and read again.
const base: any = { kept: 1 };
const heir: any = Object.create(base);
heir.own = "own";
note("absent at first", read(heir, "late"));
base.late = "arrived on the prototype";
note("then inherited", read(heir, "late"));
heir.late = "arrived on the object";
note("then own", read(heir, "late"));
delete heir.late;
note("then inherited again", read(heir, "late"));
delete base.late;
note("then absent again", read(heir, "late"));
