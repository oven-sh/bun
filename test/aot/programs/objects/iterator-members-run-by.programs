for (let s = 0; s < 40; s++) { const record: any = {}; for (let i = 0; i <= s % 5; i++) record["g" + s + "_" + i] = s * 10 + i; survivors.push(record); }
let kept = 0;
for (let round = 0; round < 6; round++) {
