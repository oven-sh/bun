console.log(lines.join("\n"));
//// key-order-is-creation-order.ts
// The order of own keys is the order of creation, whatever the order in the declared type.
interface P { a: number; opt?: number; b: number }
const later: P = { a: 1, b: 2 }
later.opt = 3
const swapped: P = { b: 2, a: 1 }
const withOpt: P = { opt: 0, b: 2, a: 1 }
console.log(JSON.stringify(later), JSON.stringify(swapped), JSON.stringify(withOpt), Object.keys(later).join())
function make(flag: boolean): P { return flag ? { a: 1, b: 2, opt: 3 } : { b: 1, opt: 2, a: 3 } }
console.log(JSON.stringify(make(true)), JSON.stringify(make(false)))
class C { x = 1; y?: number; z = 3; constructor(early: boolean) { if (early) this.y = 2 } }
const c = new C(false)
c.y = 9
console.log(JSON.stringify(c), JSON.stringify(new C(true)))
const indexed: any = { name: "n" }
indexed[2] = "two"; indexed.extra = 1; indexed[1] = "one"
console.log(JSON.stringify(indexed), Object.keys(indexed).join())
const spread = { ...later, a: 5, c: 6 }
console.log(JSON.stringify(spread), JSON.stringify({ c: 0, ...swapped }))
//// key-order-of-class-instances.ts
// The key order of class instances whose fields have no initializers and are assigned in the constructor in another order.
class A { a: number; b: number; c = 3; constructor() { this.b = 2; this.a = 1 } }
class B { declare p: number; q: number | undefined; r?: string; constructor(set: boolean) { if (set) { this.r = "r"; this.p = 1 } } }
class D extends A { d = 4; e: number; constructor() { super(); this.e = 5 } }
console.log(JSON.stringify(new A()), Object.keys(new B(false)).join(), Object.keys(new B(true)).join(), JSON.stringify(new D()))
const late = new B(false)
late.r = "x"; late.q = 1
console.log(Object.keys(late).join())
//// key-order-of-long-store-runs.ts
// Many adjacent stores that create fields list their keys in the order of the stores, whatever the object has already.
interface Wide { a?: number; b?: number; c?: number; d?: number; e?: number; f?: number; g?: number; h?: number; i?: number; j?: number }
function show(o: object) { return Object.keys(o).join("") + " " + JSON.stringify(o) }

function fillAll(o: Wide, n: number) {
  o.a = n; o.b = n + 1; o.c = n + 2; o.d = n + 3; o.e = n + 4
  o.f = n + 5; o.g = n + 6; o.h = n + 7; o.i = n + 8; o.j = n + 9
}
function fillBackwards(o: Wide, n: number) {
  o.j = n; o.i = n; o.h = n; o.g = n; o.f = n; o.e = n; o.d = n; o.c = n; o.b = n; o.a = n
}
function fillFive(o: Wide, n: number) {
  o.c = n; o.d = n; o.e = n; o.f = n; o.g = n
}

const empty: Wide = {}
fillAll(empty, 0)
console.log(show(empty))

const backwards: Wide = {}
fillBackwards(backwards, 1)
console.log(show(backwards))

const startsInTheMiddle: Wide = { f: -1 }
fillAll(startsInTheMiddle, 10)
console.log(show(startsInTheMiddle))

const hasTheLast: Wide = { j: -1, e: -2 }
fillAll(hasTheLast, 20)
