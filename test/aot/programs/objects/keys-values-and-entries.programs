function describeTable(table: Table): string {
  return readByName(table) + " | " + readByKey(table) + " | " + digest(Object.values(table));
}

const table = createTable();
console.log("created: " + describeTable(table));
collect();
console.log("after a collection: " + describeTable(table));

const copy = { ...table };
console.log("spread: " + describeTable(copy) + " | " + Object.keys(copy).length + " " + (copy.k1 === table.k1) + " " + (copy.k2499 === table.k2499));

(table as any).added = { source: "added " + rounds };
console.log("added property: " + (table as any).added.source + " " + Object.keys(table).length + " " + Object.keys(table).at(-1) + " " + ("added" in table));
collectYoung();
collect();
console.log("added property after collections: " + (table as any).added.source + " | " + describeTable(table));
console.log("spread with the added property: " + digest(Object.values({ ...table })));
console.log("heap snapshot: " + (takeHeapSnapshot().nodes.length > 0));
console.log("after the heap snapshot: " + describeTable(table));

table.k0 = "young " + rounds;
table.k2499 = { source: "young " + rounds };
(table as any)["k" + indexes[4]] = "young by key " + rounds;
(table as any)["k" + indexes[5]] = { source: "young by key " + rounds };
collectYoung();
console.log("stored: " + describeTable(table));
console.log("the spread is unchanged: " + describeTable(copy));

const tables: Table[] = [];
for (let round = 0; round < rounds; round++) {
  const created = createTable();
  created.k2 = "round " + round;
  created.k2497 = { source: "round " + round };
  if (round % 3 === 0) tables.push(created);
}
collect();
console.log("one literal, many objects: " + tables.map(describeTable).join(" || "));

