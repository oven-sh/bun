//// literals-with-different-members-of-one-type-are-handed-on-and-changed.ts
// Literals with different members of one type meet in one place, are copied, frozen, deleted from and compared.
type Style = { color?: string; size?: number; bold?: boolean; margin?: number; padding?: number; border?: string };

function merge(...styles: Style[]): Style {
  let merged: Style = {};
  for (const style of styles) merged = { ...merged, ...style };
  return merged;
}

function pick(i: number): Style {
  switch (i % 6) {
    case 0: return { color: "red" };
    case 1: return { size: i };
    case 2: return { bold: i % 4 === 2 };
    case 3: return { margin: i / 2, padding: i };
    case 4: return { border: "1px", color: "blue", size: 1 };
    default: return {};
  }
}

function show(style: Style): string {
  return `${style.color}|${style.size}|${style.bold}|${style.margin}|${style.padding}|${style.border}|${Object.keys(style)}`;
}

const all: Style[] = [];
for (let i = 0; i < 24; i++) all.push(pick(i));
console.log(all.map(show).join("\n"));
console.log(show(merge(...all)));

const frozen = Object.freeze(pick(3));
try {
  "use strict";
  (frozen as Record<string, unknown>)["color"] = "no";
} catch (error) {
  console.log((error as Error).constructor.name);
}
console.log(show(frozen), Object.isFrozen(frozen));

const emptied = pick(4);
delete emptied.color;
delete emptied.margin;
console.log(show(emptied));

const map = new Map<Style, number>();
for (const style of all) map.set(style, (style.size ?? 0) + (style.padding ?? 0));
console.log([...map.values()].join(","));

class Box {
  style: Style = {};
  other: Style = { bold: true };
  constructor(public given: Style = { size: 3 }) {}
  total(): number {
    return (this.style.size ?? 1) + (this.other.size ?? 2) + (this.given.size ?? 4) + (this.given.margin ?? 8);
  }
}
console.log(new Box().total(), new Box({}).total(), new Box({ margin: 1 }).total(), new Box(pick(1)).total());

function generic<T extends Style>(style: T): T & { seen: boolean } {
  return { ...style, seen: style.bold ?? false };
}
console.log(JSON.stringify(generic({ bold: true })), JSON.stringify(generic({ size: 2 })), JSON.stringify(generic({})));
console.log(JSON.stringify(all.filter(style => style.size !== undefined).map(style => style.size)));
console.log(structuredClone(pick(3)), { ...pick(4) });
//// literals-with-dynamic-proto.js
// `{ __proto__: value, .. }`: an object, a function or null becomes the prototype of the literal; anything else is passed over. The value is only known when the program runs, and variables that are set before the literal are read behind it.
function describe(made) {
  const prototype = Object.getPrototypeOf(made);
  return [prototype === null ? "null" : prototype === Object.prototype ? "Object.prototype" : typeof prototype, Object.keys(made).join(), made.inherited];
}
function make(prototype, turn) {
  let label = "before";
  if (turn % 2) label = "odd";
  const made = describe({ __proto__: prototype, a: 1, [label]: turn });
  return label + ": " + made.join(" ");
}
const prototypes = [{ inherited: "from an object" }, Object.assign(function () {}, { inherited: "from a function" }), null, undefined, 5, "text", true, Symbol("s"), 10n];
prototypes.forEach((prototype, turn) => console.log(make(prototype, turn)));
//// literals-with-methods-accessors-and-another-prototype.js
// Literals as libraries write them: a descriptor below null with a method, an object of exports with accessors beside plain names, at the top level (run once) and in functions (run often).
// Objects of the same places are changed afterwards in every way that takes a field out of its slot, and the places run again.
const lines = [];
const keysOf = object => Reflect.ownKeys(object).map(String).join();
const describe = object => keysOf(object) + " | " + JSON.stringify(Object.getOwnPropertyDescriptors(object), (key, value) => typeof value === "function" ? "function " + value.name : typeof value === "symbol" ? String(value) : value);
let calls = 0;
const next = () => ++calls;

const descriptor = { __proto__: null, configurable: true, enumerable: true, get() { return "got " + this.tag; }, tag: "top" };
const api = {
  get lazy() { return "lazy " + this.plain; },
  plain: "p" + next(), count: next(), mark: Symbol.for("mark"),
  set both(value) { this.count = value; }, get both() { return this.count; },
  run() { return "run " + this.plain; }, list: [next()], nothing: undefined, none: null, last: next(),
};
lines.push("descriptor: " + describe(descriptor) + " | " + descriptor.get() + " | " + String(Object.getPrototypeOf(descriptor)));
lines.push("api: " + describe(api) + " | " + api.lazy + " | " + api.run() + " | " + api.both);

function makeDescriptor(tag) { return { __proto__: null, configurable: true, enumerable: tag !== "b", get() { return "got " + this.tag; }, tag }; }
function makeApi(i) {
  return {
    get lazy() { return "lazy " + this.plain; },
    plain: "p" + i, count: i, mark: Symbol.for("mark"),
    set both(value) { this.count = value; }, get both() { return this.count; },
    run() { return "run " + this.plain; }, list: [i], nothing: undefined, none: null, last: i + 1,
  };
}
function below(parent, i) { return { __proto__: parent, own: i, run() { return super.run() + " below " + this.own; }, after: i + 1 }; }
function check(label) {
  const made = makeApi(7), madeDescriptor = makeDescriptor("a"), heir = below(made, 3);
  lines.push(label + ": " + describe(made) + " | " + made.lazy + " | " + made.run() + " | " + describe(madeDescriptor) + " | " + madeDescriptor.get() + " | " + describe(heir) + " | " + heir.run() + " | " + heir.lazy + " | " + Object.isFrozen(made) + Object.isSealed(madeDescriptor) + Object.isExtensible(heir));
  return [made, madeDescriptor, heir];
}
let [made, madeDescriptor, heir] = check("first");
for (let i = 0; i < 200; i++) { makeApi(i); makeDescriptor("b"); below(made, i); }
made.plain = 12; made.count = "text"; made.mark = 1.5; made.list = "no list"; made.last = { object: true };
madeDescriptor.get = 4; madeDescriptor.tag = 5; heir.own = "own"; heir.after = null;
[made, madeDescriptor, heir] = check("after stores of other types");
delete made.plain; delete made.run; delete madeDescriptor.get; delete heir.after;
[made, madeDescriptor, heir] = check("after deletes");
Object.defineProperty(made, "count", { get() { return "redefined"; }, configurable: true });
Object.defineProperty(made, "last", { value: 1, writable: false });
Object.defineProperty(madeDescriptor, "tag", { value: "hidden", enumerable: false });
[made, madeDescriptor, heir] = check("after redefinitions");
Object.freeze(made); Object.seal(madeDescriptor); Object.preventExtensions(heir);
[made, madeDescriptor, heir] = check("after freezing");
Object.setPrototypeOf(made, { inherited: 1 }); Object.setPrototypeOf(madeDescriptor, made);
[made, madeDescriptor, heir] = check("after other prototypes");
made.extra = 1; madeDescriptor.extra = 2; heir[Symbol.iterator] = 3;
check("after extra properties");
console.log(lines.join("\n"));
//// literals-with-methods-between-fields.js
// Literals whose methods stand in front of, between and behind their fields: every member is there for whoever gets the object, in the order written.
const base = { greet() { return 1; }, twice(x) { return x * 2; }, arrow: (x) => x + 1, n: 4 };
function makeCounter(start) {
  return {
    step() { this.count++; return this.count; },
    count: start,
    reset() { this.count = 0; return this; },
    limit: start + 10,
  };
}
function makeHeir(start) {
  return {
    __proto__: base,
    first: start,
    greet() { return super.greet() + this.first + this.last; },
    last: start + 1,
  };
}
function makeGenerated(start) {
  return {
    *values() { yield this.from; yield this.from + 1; },
    from: start,
    async later() { return this.from; },
    ["computed" + start % 2]() { return this.from; },
    tail: start * 2,
  };
}
function makeAccessor(start) {
  return {
    step() { return 1; },
    count: start,
    get value() { return this.count; },
    tail: start + 2,
  };
}
let sum = 0, previous = null;
for (let i = 0; i < 3000; i++) {
  const counter = makeCounter(i), heir = makeHeir(i);
  sum += counter.step() + counter.limit + base.greet() + base.twice(i) + base.arrow(i) + base.n + heir.greet() + heir.last;
  if (previous && (previous.step === counter.step || previous.reset === counter.reset)) sum += 1e9;
  if (counter.step !== counter.step || counter.reset() !== counter) sum += 1e9;
  previous = counter;
}
console.log(sum, Object.keys(base).join(), Object.keys(previous).join(), Object.keys(makeHeir(1)).join());
console.log(previous.step.name, previous.step.length, typeof previous.step.prototype, base.twice.name, base.arrow.name);
const generated = makeGenerated(3);
console.log(Object.keys(generated).join(), [...generated.values()].join(), generated.computed1(), generated.tail, await generated.later());
for (let i = 0; i < 3; i++) {
  const made = makeAccessor(i);
  console.log(Object.keys(made).join(), JSON.stringify(made), made.value + made.tail, Object.entries(made).length);
}
try {
  new previous.step();
} catch (error) {
  console.log(error instanceof TypeError);
}
//// literals-with-spreads-and-definitions-behind-branches/main.ts
import { makeUntyped } from "./untyped.js";

interface Options {
  name?: string;
  limit?: number;
  strict?: boolean;
  mode?: string;
  list?: string[];
  [key: string]: unknown;
}
declare const aotOperationCount: undefined | ((name: string) => number);
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;

////= lines-180	function make(options: O
function onOneBranch(options: Options, wide: boolean) {
  const made: Record<string, unknown> = { first: 1, ...options };
  if (wide) {
    made.a = 1;
    made.b = 2;
  }
  return made;
}

const given: Options[] = [{}, { name: "n" }, { name: "n", limit: 9, strict: true, mode: "exact", list: [] }, { extra: 1, more: 2, other: 3, name: "long name" }, { last: "overwritten", delay: 1 }];
for (const options of given) {
  console.log(JSON.stringify(make(options)), Object.keys(make(options)).join());
  console.log(JSON.stringify(makeUntyped(options)), Object.keys(makeUntyped(options)).join());
  console.log(JSON.stringify(onOneBranch(options, true)), JSON.stringify(onOneBranch(options, false)));
}
const before = count("operationAOTFinishObjectLiteral");
let sum = 0;
for (let i = 0; i < 3000; ++i) sum += make(given[i % given.length]).limit + makeUntyped(given[i % given.length]).limit;
const asked = count("operationAOTFinishObjectLiteral") - before;
console.log(sum, asked <= 30 ? "no literal was copied at its end" : asked + " literals were copied at their end");
//// literals-with-spreads-and-definitions-behind-branches/untyped.js
