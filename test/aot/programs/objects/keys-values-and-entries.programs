//// late-fields-that-are-never-undefined-are-read-while-empty-untyped.js
// The untyped twin: a name that is stored late and never with undefined, asked for before its first store: `if (!this.cache) this.cache = make()`.
function Holder(id) {
  this.id = id;
}
Holder.prototype.cacheOf = function () {
  if (!this.cache) this.cache = { made: this.id };
  return this.cache;
};
Holder.prototype.countOf = function () {
  if (this.count === undefined) this.count = 0;
  return ++this.count;
};
function peek(holder) {
  return holder.cache ? holder.cache.made : "none";
}
////= lines-35	peekCount	holder	holder.count

let sum = 0;
const holders = [];
for (let index = 0; index < 3000; index++) {
  const holder = new Holder(index);
  holders.push(holder);
  if (peek(holder) !== "none" || peekCount(holder) !== undefined) throw new Error("found something in a new object");
  if (index % 3) sum += holder.cacheOf().made + holder.countOf() + holder.countOf();
}
for (const holder of holders) sum += (peek(holder) === "none" ? 1 : 2) + (peekCount(holder) ?? 5);
console.log(sum);

const one = holders[1];
delete one.cache;
delete one.count;
console.log(peek(one), peekCount(one), one.cacheOf().made, one.countOf(), Object.keys(one).join());
Holder.prototype.count = 100;
Holder.prototype.cache = { made: "above" };
console.log(peek(holders[0]), peekCount(holders[0]), holders[0].countOf(), peekCount(holders[0]), peek(holders[1]), holders[3].cacheOf().made);
delete Holder.prototype.count;
delete Holder.prototype.cache;
console.log(peek(holders[3]), peekCount(holders[3]), peekCount(holders[0]));
//// literal-accessors-in-type.ts
// Object literals with getters and setters that are used through annotated types.
declare const console: any;
function line(name: string, f: () => unknown) { try { console.log(name, JSON.stringify(f())); } catch (e: any) { console.log(name, "THREW", e.constructor.name, String(e.message).slice(0, 60)); } }
line("door 1: annotated", () => { const g: { x: number } = { get x() { return 5; } }; return g.x; });
line("door 1: readonly", () => { const g: { readonly x: number } = { get x() { return 2; } }; return g.x; });
line("door 1: pair", () => { let kept = 1; const g: { x: number } = { get x() { return kept; }, set x(v: number) { kept = v * 2; } }; g.x = 4; return [g.x, kept]; });
line("door 1: setter only", () => { let kept = 1; const g: { x: number } = { set x(v: number) { kept = v; } } as any; g.x = 4; return [kept]; });
line("door 1: two getters", () => { const g: { x: number; y: string } = { get x() { return 5; }, get y() { return "s"; } }; return [g.x, g.y, Object.keys(g)]; });
function made(): { x: number } { return { get x() { return 6; } }; }
line("door 1: returned", () => made().x);
function taken(p: { x: number }) { return p.x; }
line("door 1: argument", () => taken({ get x() { return 7; } }));
line("door 1: this", () => { const g: { x: number } = { get x(): number { return Object.keys(this).length; } }; return g.x; });
line("door 1: twice", () => { const f = (n: number): { x: number } => ({ get x() { return n; } }); return [f(1).x, f(2).x]; });
line("door 1: in a field", () => { const o: { inner: { x: number } } = { inner: { get x() { return 8; } } }; return o.inner.x; });
line("door 1: in an array", () => { const a: { x: number }[] = [{ get x() { return 9; } }, { x: 10 }]; return a.map(e => e.x); });
line("control: data beside", () => { const g: { x: number; d: number } = { d: 1, get x() { return 5; } }; return [g.x, g.d]; });
line("control: method beside", () => { const g: { x: number; m(): number } = { m() { return 1; }, get x() { return 5; } }; return [g.x, g.m()]; });
line("control: no annotation", () => { const g = { get x() { return 5; } }; return g.x; });
line("door 2: own type first", () => { const own = { w: 1, get g() { return 2; } }; const read = (p: { g: number }) => p.g; return read(own); });
line("door 2: names the data field", () => { const own = { w: 1, get g() { return 2; } }; const read = (p: { w: number; g: number }) => p.g + p.w; return read(own); });
line("door 2: accessors only", () => { const own = { get g() { return 2; } }; const read = (p: { g: number }) => p.g; return read(own); });
line("door 2: two literals, one shape", () => { const a = { w: 1, get g() { return "a"; } }, b = { w: 1, get g() { return "b"; } }; const read = (p: { g: string }) => p.g; return [read(a), read(b)]; });
line("door 2: assigned", () => { const own = { get g() { return 2; } }; const seen: { g: number } = own; return seen.g; });
//// literal-prototypes-in-loops.ts
// `{ __proto__: p, x, y }` in loops: the same place makes objects with one prototype, with many in turn, with null and with values that are passed over, before and after collections
// and after the prototypes of an earlier round have died. Every object answers for its own prototype, keeps its fields and their order, and finds what it inherits.
type Point = { x: number; y: number };
const collect = (full: boolean) => Bun.gc(full);

class Base {
  kind = "base";
  describe(this: Point): string {
    return this.x + "," + this.y;
  }
}
const base = new Base();
const other = { kind: "other", describe: () => "other" };

function withPrototype(prototype: object | null, i: number): Point {
  return { __proto__: prototype, x: i, y: i + 1 } as Point;
}
function prototypeLast(prototype: object | null, i: number): Point {
  return { x: i, y: i + 1, __proto__: prototype } as Point;
}
function prototypeBetween(prototype: unknown, i: number): Point {
  return { x: i, __proto__: prototype, y: i + 1 } as Point;
}
function withoutPrototype(i: number): Point {
  return { __proto__: null, x: i, y: i + 1 } as Point;
}
function plain(i: number): Point {
  return { x: i, y: i + 1 };
}

function nameOf(prototype: unknown): string {
  if (prototype === null) return "null";
  if (prototype === Object.prototype) return "Object.prototype";
  if (prototype === base) return "base";
  if (prototype === other) return "other";
  return "fresh " + (prototype as { id: number }).id;
}
function check(label: string, made: Point, expected: unknown, i: number) {
  const actual = Object.getPrototypeOf(made);
  if (actual !== expected || made.x !== i || made.y !== i + 1 || Object.keys(made).join() !== "x,y")
    console.log("WRONG", label, i, nameOf(actual), "instead of", nameOf(expected), JSON.stringify(made));
}

let checked = 0;
for (let round = 0; round < 6; round++) {
  const fresh = Array.from({ length: 150 }, (_, id) => ({ id: round * 1000 + id }));
  for (let i = 0; i < 3000; i++) {
    check("one prototype", withPrototype(base, i), base, i);
    check("no prototype", withoutPrototype(i), null, i);
    check("plain beside them", plain(i), Object.prototype, i);
    const turning = i % 3 === 0 ? base : i % 3 === 1 ? other : null;
    check("three in turn", prototypeLast(turning, i), turning, i);
    const one = fresh[i % fresh.length];
    check("many in turn", withPrototype(one, i), one, i);
    const passedOver = [1, "text", undefined, true, 2n][i % 5];
    check("passed over", prototypeBetween(passedOver, i), Object.prototype, i);
    check("taken", prototypeBetween(i % 2 ? one : null, i), i % 2 ? one : null, i);
    checked += 7;
    if (i % 1000 === 999) collect(i === 1999);
  }
  const inherits = withPrototype(base, round) as Point & Base;
  console.log("round", round, inherits.kind, inherits.describe(), inherits instanceof Base, "kind" in inherits, Object.hasOwn(inherits, "kind"));
  collect(true);
}
console.log("checked", checked);

// The values are read in the order of the source, and the object is complete before anyone sees it.
const order: string[] = [];
const note = <T>(label: string, value: T): T => (order.push(label), value);
const ordered = { a: note("a", 1), __proto__: note("prototype", base), b: note("b", 2) } as unknown as { a: number; b: number } & Base;
console.log(order.join(), ordered.a, ordered.b, ordered.kind, Object.keys(ordered).join());

// A prototype that changes later changes what every object made with it inherits.
const late = withPrototype(other, 1) as Point & { added?: number };
(other as { added?: number }).added = 7;
console.log(late.added, (withPrototype(other, 2) as Point & { added?: number }).added);
Object.setPrototypeOf(late, base);
console.log(nameOf(Object.getPrototypeOf(late)), nameOf(Object.getPrototypeOf(withPrototype(other, 3))));
//// literal-values-past-registers.js
// Untyped object literals with more values than the allocation stub takes in registers. A later store under a computed key makes two of them ordinary objects. The values past the registers are cells, and every value is read again after forced collections.
function describe(object) {
  return `${JSON.stringify(object)} [${Object.keys(object).join()}]`;
}

function seven(i) {
  const object = { a: "a" + i, b: [i], c: { at: i }, d: "d" + i, e: [i, i + 1], f: { at: i + 1 }, g: "g" + i };
  object["extra" + (i % 2)] = i;
  return object;
}
function isSeven(object, i) {
  return object.a === "a" + i && object.b[0] === i && object.c.at === i && object.d === "d" + i && object.e[1] === i + 1 && object.f.at === i + 1 && object.g === "g" + i;
}

function nine(i) {
  const object = { a: i, b: i + 0.5, c: "c" + i, d: null, e: undefined, f: [i], g: { at: i }, h: "h" + i, i: [[i]] };
  object["extra" + (i % 2)] = "x" + i;
  return object;
}
function isNine(object, i) {
  return object.a === i && object.b === i + 0.5 && object.c === "c" + i && object.d === null && object.e === undefined && object.f[0] === i && object.g.at === i && object.h === "h" + i && object.i[0][0] === i;
}

function sevenWithFixedKeys(i) {
  return { a: "a" + i, b: [i], c: { at: i }, d: "d" + i, e: [i, i + 1], f: { at: i + 1 }, g: "g" + i };
}

const cases = [
  ["seven", seven, isSeven],
  ["nine", nine, isNine],
  ["seven with fixed keys", sevenWithFixedKeys, isSeven],
];

for (const [label, make, isIntact] of cases) {
  const first = make(1);
  Bun.gc(true);
  console.log(label, describe(first));

  let damaged = 0;
  const survivors = [];
  for (let round = 0; round < 20000; round++) {
    const object = make(round);
    if (!isIntact(object, round)) damaged++;
    if (round % 5000 === 4999) {
      survivors.push([object, round]);
      Bun.gc(true);
    }
  }
  Bun.gc(true);
  console.log(label, "damaged", damaged);
  for (const [survivor, round] of survivors) console.log(label, isIntact(survivor, round), describe(survivor));
}
//// literal-with-fields-used-as-dictionary.js
// An object literal with fields, a class instance and an empty literal inside a constant literal each get hundreds of computed keys: reads, stores, `in`, hasOwnProperty, delete and key lists answer as for any object, and the fields keep their values.
const hasOwn = Object.prototype.hasOwnProperty;
const size = JSON.parse("300");

class Registry {
  constructor(label) {
    this.label = label;
    this.added = 0;
  }
  add(name, value) {
    if (!hasOwn.call(this, name)) this.added++;
    this[name] = value;
  }
}

function createTally() {
  return { total: 0, label: "tally" };
}
function createState() {
  return { byName: {}, order: [], version: 1 };
}

function fill(table, count, scale) {
  for (let i = 0; i < count; i++) table["key" + i] = i * scale;
}
function countTwice(table, names) {
  for (let round = 0; round < 2; round++) {
    for (let i = 0; i < names.length; i++) {
      const name = names[i];
      if (hasOwn.call(table, name)) table[name]++;
      else table[name] = 1;
    }
  }
}
function sum(table, count) {
  let result = 0;
  for (let i = 0; i < count; i++) {
    const value = table["key" + i];
    result += value === undefined ? -1 : value;
  }
  return result;
}
function present(table, count) {
  let own = 0, anywhere = 0;
  for (let i = 0; i < count; i++) {
    if (hasOwn.call(table, "key" + i)) own++;
    if ("key" + i in table) anywhere++;
  }
  return own + " own, " + anywhere + " in";
}
function inherited(table) {
  const names = ["toString", "hasOwnProperty", "constructor", "valueOf", "nothing"];
  return names.map(name => (name in table ? "in" : "out") + "/" + (hasOwn.call(table, name) ? "own" : "not own") + "/" + typeof table[name]).join(" ");
}
function removeEvery(table, step, count) {
  let removed = 0;
  for (let i = 0; i < count; i += step) if (delete table["key" + i]) removed++;
  return removed;
}
function keys(table) {
  const list = Object.keys(table);
  let listed = 0;
  for (const key in table) listed++;
  return list.length + " keys, " + listed + " in for-in, first " + list.slice(0, 3).join(",") + ", last " + list[list.length - 1];
}
function describe(what, table) {
  console.log(what + ": sum " + sum(table, size + 5) + ", " + present(table, size + 5) + ", " + keys(table));
  console.log(what + ": " + inherited(table));
}

function exercise(what, table, fields) {
  fill(table, size, 2);
  describe(what + " filled", table);
  console.log(what + " fields: " + fields());
  fill(table, size, 3);
  describe(what + " replaced", table);
  table["late" + size] = "late";
  console.log(what + " late: " + table["late" + size] + " " + hasOwn.call(table, "late" + size) + " " + Object.keys(table).length);
  console.log(what + " removed: " + removeEvery(table, 3, size));
  describe(what + " after deletes", table);
  fill(table, size, 5);
  describe(what + " filled again", table);
  table["toString"] = 1;
  console.log(what + ": " + inherited(table));
  console.log(what + " fields: " + fields());
}

const tally = createTally();
exercise("literal", tally, () => tally.total + " " + tally.label);
tally.total += 7;
console.log(tally.total, tally["to" + "tal"], hasOwn.call(tally, "total"), delete tally["total"], tally.total, "total" in tally);

const registry = new Registry("registry");
exercise("instance", registry, () => registry.label + " " + registry.added);
for (let i = 0; i < size + 10; i++) registry.add("key" + i, i);
console.log(registry.added, registry.label, registry instanceof Registry, Object.keys(registry).length);

const state = createState();
exercise("nested", state.byName, () => state.version + " " + state.order.length);
console.log(Object.keys(createState().byName).length, Object.keys(state).join(","));

const words = [];
for (let i = 0; i < 400; i++) words.push("w" + ((i * 7) % 150));
const counts = createTally();
countTwice(counts, words);
console.log(Object.keys(counts).length, counts.w0, counts.w149, counts.total, counts.label);

const first = createTally(), second = createTally();
fill(first, size, 1);
fill(second, size, 10);
second["only" + size] = true;
console.log(sum(first, size), sum(second, size), hasOwn.call(first, "only" + size), hasOwn.call(second, "only" + size), first["only" + size], second["only" + size]);

const left = new Registry("left"), right = new Registry("right");
fill(left, size, 1);
fill(right, size, 1);
console.log(left["sha" + "red"], "shared" in left, hasOwn.call(left, "shared"));
Registry.prototype.shared = "shared";
console.log(left["sha" + "red"], "shared" in left, hasOwn.call(left, "shared"));
left["sha" + "red"] = "own";
console.log(left.shared, right.shared, hasOwn.call(left, "shared"), hasOwn.call(right, "shared"));
delete Registry.prototype.shared;
console.log(left.shared, right["sha" + "red"], "shared" in right);
//// literals-of-one-to-forty-names-under-a-dictionary-type-are-listed-grown-frozen-and-kept.ts
// A literal whose type is a dictionary is an ordinary object. However many names it has, it lists them in the order written,
// takes more names, loses names, is frozen, copied and collected like any other.
type Table = Record<string | symbol, unknown>;
function make1(base: number): Table { return { k0: base + 0 }; }
function make5(base: number): Table { return { k0: base + 0, k1: base + 1, k2: base + 2, k3: base + 3, k4: base + 4 }; }
function make6(base: number): Table { return { k0: base + 0, k1: base + 1, k2: base + 2, k3: base + 3, k4: base + 4, k5: base + 5 }; }
function make7(base: number): Table { return { k0: base + 0, k1: base + 1, k2: base + 2, k3: base + 3, k4: base + 4, k5: base + 5, k6: base + 6 }; }
function make8(base: number): Table { return { k0: base + 0, k1: base + 1, k2: base + 2, k3: base + 3, k4: base + 4, k5: base + 5, k6: base + 6, k7: base + 7 }; }
function make9(base: number): Table { return { k0: base + 0, k1: base + 1, k2: base + 2, k3: base + 3, k4: base + 4, k5: base + 5, k6: base + 6, k7: base + 7, k8: base + 8 }; }
