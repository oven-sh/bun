//// late-fields-added-while-others-are-read.js
// A run of reads of late properties, with code in between that gives the same object more of them: a getter, a valueOf, a callback, a setter on the prototype.
// Each read sees the value that the object holds at that moment.
class Node {
  constructor(id) {
    this.id = id
  }
  get grow() {
    this.f1 = "g1"
    this.f0 = "g0"
    return "grown"
  }
  set push(value) {
    this.f2 = value
    this.f14 = value + 1
  }
}

function readRun(node) {
  return [node.f5, node.f9, node.grow, node.f0, node.f1, node.f5, node.f9, node.f13].join()
}
function readWithCallback(node, callback) {
  const before = node.f9
  const first = node.f5
  callback(node)
  return [before, first, node.f3, node.f4, node.f5, node.f9].join()
}
function sumWithValueOf(node) {
  return node.f5 + node.f6 + node.f7 + node.f5
}
function storeRun(node, value) {
  node.f13 = value
  node.push = value
  node.f12 = value + 2
  node.f2 = node.f2 + node.f14
  return [node.f2, node.f12, node.f13, node.f14].join()
}

const lines = []
for (let i = 0; i < 300; i++) {
  const node = new Node(i)
  node.f9 = "nine" + i
  node.f5 = i
  if (i % 3 === 0) node.f13 = "thirteen"
  const run = readRun(node)
  const again = readRun(node)
  const called = readWithCallback(node, target => { target.f4 = "four"; target.f3 = "three"; if (i % 2) target.f5 = -1 })
  node.f6 = { valueOf() { node.f8 = "eight"; node.f5 = 1000; node.f7 = 7; return 10 } }
  node.f7 = 1
  const sum = sumWithValueOf(node)
  const stored = storeRun(node, i)
  if (i < 4 || i === 299) lines.push([run, again, called, sum, stored, Object.keys(node).join()].join(" | "))
  if (i % 50 === 0 && typeof Bun !== "undefined") Bun.gc(true)
}
console.log(lines.join("\n"))

// for-in and Object.keys while the body adds and deletes.
const walked = new Node(1)
walked.f3 = 3
walked.f11 = 11
walked.f7 = 7
const seen = []
for (const key in walked) {
  seen.push(key + "=" + walked[key])
  if (key === "f3") { walked.f1 = 1; delete walked.f7 }
}
console.log(seen.join(), Object.keys(walked).join())

// Many objects that are kept alive while others die, so that storage is reused.
const survivors = []
for (let round = 0; round < 40; round++) {
  for (let i = 0; i < 500; i++) {
    const node = new Node(i)
    node.f10 = [round, i]
    if (i % 5 === 0) node.f0 = node
    if (i % 7 === 0) { node.f14 = "x" + i; node.f2 = i / 2 }
    if (i % 97 === 0) survivors.push(node)
  }
}
if (typeof Bun !== "undefined") Bun.gc(true)
let total = 0
for (const node of survivors) total += node.f10[0] + node.f10[1] + (node.f0 === node ? 1 : 0) + (node.f14 ? node.f14.length : 0) + (node.f2 ?? 0)
console.log(survivors.length, total)
//// late-fields-are-deleted-redefined-and-refilled-through-an-alias.ts
// Each function reads or stores a late field, changes the object through an untyped alias, and reads the field again.
////= Leaf
////= Crate

function readDeleteRead(a: Leaf, alias: any): unknown {
  const first = a.owner;
  delete alias.owner;
  return [first === undefined, a.owner === undefined];
}
function storeDeleteRead(a: Leaf, alias: any, other: Leaf): unknown {
  a.owner = other;
  delete alias.owner;
  return a.owner === undefined;
}
function readRedefineRead(a: Leaf, alias: any): unknown {
  const first = a.mark;
  Object.defineProperty(alias, "mark", { get() { return -1; }, configurable: true });
  return [first, a.mark];
}
function storeMisfitRead(a: Leaf, alias: any): unknown {
  a.mark = 5;
  alias.mark = "text";
  return a.mark;
}
function readStoreUndefinedRead(a: Leaf, alias: any): unknown {
  const first = a.mark;
  alias.mark = undefined;
  return [first, a.mark, "mark" in a];
}
function readStoreRead(a: Leaf, b: Leaf): unknown {
  const first = a.mark;
  b.mark = first + 1;
  return [first, a.mark];
}
function otherFamily(a: any, b: any): unknown {
  const first = a.mark;
  b.mark = first + 1;
  return [first, a.mark];
}
function cloneOf(a: Leaf): Leaf {
  const copy = new Leaf(a.weight);
  copy.mark = a.mark;
  copy.owner = a.owner;
  copy.mark = a.mark + 1;
  return copy;
}
function cloneOrSelf(a: Leaf, takeSelf: boolean): unknown {
  const copy = new Leaf(a.weight);
  const chosen = takeSelf ? a : copy;
  const first = chosen.mark;
  copy.mark = 7;
  return [first, chosen.mark];
}
function fillIfEmpty(a: Leaf, other: Leaf): number {
  if (!a.owner) a.owner = other;
  return a.owner.weight;
}

function leaf(weight: number, filled: boolean): Leaf {
  const made = new Leaf(weight);
  if (filled) {
    made.mark = weight;
    made.owner = made;
  }
  return made;
}
function crate(size: number): Crate {
  const made = new Crate(size);
  made.mark = size;
  made.owner = made;
  return made;
}

const lines: string[] = [];
for (let round = 0; round < 400; round++) {
  const filled = (round & 3) !== 3;
  const results = [
    readDeleteRead(leaf(round, filled), leaf(round, true)),
    storeDeleteRead(leaf(round, filled), leaf(round, true), leaf(1, true)),
    readRedefineRead(leaf(round, filled), leaf(round, true)),
    storeMisfitRead(leaf(round, filled), leaf(round, true)),
    readStoreUndefinedRead(leaf(round, filled), leaf(round, true)),
    readStoreRead(leaf(round, filled), leaf(round, true)),
    otherFamily(leaf(round, filled), crate(round)),
    otherFamily(crate(round), leaf(round, filled)),
    cloneOf(leaf(round, filled)).mark,
    cloneOrSelf(leaf(round, filled), (round & 1) === 0),
    fillIfEmpty(leaf(round, filled), leaf(9, true)),
  ];
  if (round % 97 === 0) lines.push(JSON.stringify(results));
}
for (const filled of [true, false]) {
  let same = leaf(3, filled);
  lines.push(JSON.stringify(readDeleteRead(same, same)));
  same = leaf(3, filled);
  lines.push(JSON.stringify(storeDeleteRead(same, same, leaf(1, true))));
  same = leaf(3, filled);
  lines.push(JSON.stringify(readRedefineRead(same, same)));
  same = leaf(3, filled);
  lines.push(JSON.stringify(storeMisfitRead(same, same)));
  same = leaf(3, filled);
  lines.push(JSON.stringify(readStoreUndefinedRead(same, same)));
  same = leaf(3, filled);
  lines.push(JSON.stringify(readStoreRead(same, same)));
  same = leaf(3, filled);
  lines.push(JSON.stringify(otherFamily(same, same)));
}
console.log(lines.join("\n"));
//// late-fields-in-every-order.js
// Objects of one class get their late properties in every order. Whatever the order, each object reads back what it was given, lists its keys in the order of creation,
// and keeps its other properties when one more is added between them, deleted, redefined or frozen.
class Record {
  constructor(id) {
    this.id = id
    this.tag = "r" + id
  }
}

const names = ["n0", "n1", "n2", "n3", "n4", "n5", "n6", "n7", "n8", "n9", "n10", "n11", "n12", "n13", "n14", "n15", "n16", "n17", "n18", "n19"]
function set(record, name, value) {
  switch (name) {
    case "n0": record.n0 = value; break
    case "n1": record.n1 = value; break
    case "n2": record.n2 = value; break
    case "n3": record.n3 = value; break
    case "n4": record.n4 = value; break
    case "n5": record.n5 = value; break
    case "n6": record.n6 = value; break
    case "n7": record.n7 = value; break
    case "n8": record.n8 = value; break
    case "n9": record.n9 = value; break
    case "n10": record.n10 = value; break
    case "n11": record.n11 = value; break
    case "n12": record.n12 = value; break
    case "n13": record.n13 = value; break
    case "n14": record.n14 = value; break
    case "n15": record.n15 = value; break
    case "n16": record.n16 = value; break
    case "n17": record.n17 = value; break
    case "n18": record.n18 = value; break
    default: record.n19 = value
  }
}
function readAll(record) {
  return [record.n0, record.n1, record.n2, record.n3, record.n4, record.n5, record.n6, record.n7, record.n8, record.n9,
    record.n10, record.n11, record.n12, record.n13, record.n14, record.n15, record.n16, record.n17, record.n18, record.n19]
}
function describe(record) {
  return readAll(record).map(value => value === undefined ? "-" : typeof value === "object" ? "o" + value.id : String(value)).join(",")
}

////= permutations

let checksum = 0
let wrong = 0
const kept = []
const chosen = ["n0", "n1", "n2", "n9", "n19"]
let id = 0
for (const order of permutations(chosen)) {
  const record = new Record(id++)
  const expected = ["id", "tag"]
  for (const name of order) {
    set(record, name, name === "n9" ? record : name + ":" + record.id)
    expected.push(name)
    if (Object.keys(record).join() !== expected.join()) wrong++
    for (const other of names) {
      const has = expected.includes(other)
      if ((record[other] !== undefined) !== has || Object.hasOwn(record, other) !== has || (other in record) !== has) wrong++
    }
  }
  checksum += describe(record).length
  kept.push(record)
}
console.log("orders", kept.length, "wrong", wrong, "checksum", checksum)
console.log(describe(kept[0]), Object.keys(kept[0]).join())
console.log(describe(kept[kept.length - 1]), Object.keys(kept[kept.length - 1]).join())

if (typeof Bun !== "undefined") Bun.gc(true)
wrong = 0
for (const record of kept) {
  if (record.n9 !== record || record.n0 !== "n0:" + record.id || record.n19 !== "n19:" + record.id) wrong++
}
console.log("after a collection, wrong", wrong)

// One name at a time, from the last to the first and back, with numbers, strings, objects and undefined.
const ladder = new Record(1000)
for (let i = names.length; i--;) set(ladder, names[i], i % 4 === 0 ? i : i % 4 === 1 ? "s" + i : i % 4 === 2 ? ladder : undefined)
console.log(describe(ladder), Object.keys(ladder).join())
for (let i = 0; i < names.length; i += 2) delete ladder[names[i]]
console.log(describe(ladder), Object.keys(ladder).join())
for (let i = 0; i < names.length; i += 2) set(ladder, names[i], i + 0.5)
console.log(describe(ladder), Object.keys(ladder).join())

// Redefined, frozen and sealed objects. The file is a module, so a refused store throws.
function attempt(action) {
  try { return String(action()) } catch (error) { return error.constructor.name }
}
const redefined = new Record(2000)
redefined.n3 = 3
redefined.n12 = 12
Object.defineProperty(redefined, "n7", { value: 7, writable: false, enumerable: false, configurable: true })
Object.defineProperty(redefined, "n12", { get() { return this.n3 * 4 }, enumerable: true, configurable: true })
Object.defineProperty(redefined, "n15", { value: 15, writable: true, enumerable: true, configurable: true })
redefined.n15 = 150
console.log(attempt(() => redefined.n7 = 70), attempt(() => redefined.n12 = 1), describe(redefined), Object.keys(redefined).join(), JSON.stringify(Object.getOwnPropertyDescriptor(redefined, "n7")))

const frozen = new Record(3000)
frozen.n1 = 1
frozen.n18 = 18
Object.freeze(frozen)
console.log(attempt(() => frozen.n1 = 2), attempt(() => frozen.n5 = 5), attempt(() => delete frozen.n18), attempt(() => set(frozen, "n18", 1)), attempt(() => set(frozen, "n6", 6)))
console.log(describe(frozen), Object.keys(frozen).join(), Object.isFrozen(frozen))

const sealed = new Record(4000)
sealed.n2 = 2
Object.seal(sealed)
sealed.n2 = 22
console.log(attempt(() => sealed.n4 = 4), attempt(() => set(sealed, "n17", 17)), attempt(() => delete sealed.n2), describe(sealed), Object.keys(sealed).join())

const closed = new Record(5000)
closed.n10 = 10
Object.preventExtensions(closed)
closed.n10 = 100
console.log(attempt(() => closed.n11 = 11), describe(closed), delete closed.n10, describe(closed))
console.log(attempt(() => closed.n10 = 1), attempt(() => set(closed, "n10", 1)), describe(closed))

// Copies.
const copy = { ...ladder }
const assigned = Object.assign(new Record(6000), ladder)
console.log(Object.keys(copy).join(), describe(assigned), assigned.id, JSON.stringify(Object.entries(redefined).map(entry => entry[0])))
console.log(JSON.stringify(structuredClone({ ...kept[3], n9: undefined })))
//// late-fields-of-two-classes-around-stores.ts
// Two unrelated families that share the name of a field that is stored late.
////= Leaf
////= Crate

// 1 | 3: a store under the name into the other family stands between two reads.
function twoFamilies(a: Leaf, b: Crate): number {
  const first = a.mark;
  b.mark = first + 1;
  return first + a.mark;
}
function twoFamiliesOfReferences(a: Leaf, b: Crate, c: Crate): number {
  const first = a.owner;
  b.owner = c;
  return first.weight + a.owner.weight;
}
// the same out of fields of a holder
class Holder {
  leaf: Leaf;
  crate: Crate;
  constructor(leaf: Leaf, crate: Crate) {
    this.leaf = leaf;
    this.crate = crate;
  }
}
function outOfHolder(h: Holder): number {
  const a = h.leaf;
  const b = h.crate;
  const first = a.mark;
  b.mark = first + 1;
  return first + a.mark;
}
// untyped
function untypedTwoFamilies(a: any, b: any): number {
  const first = a.mark;
  b.mark = first + 1;
  return first + a.mark;
}

// 2: a store that can only fill the slot
function countUp(a: Leaf, turns: number): number {
  for (let i = 0; i < turns; i++) a.mark = a.mark + 1;
  return a.mark;
}
function fillIfEmpty(a: Leaf, other: Leaf): number {
  if (!a.owner) a.owner = other;
  return a.owner.weight;
}
function storeThenRead(a: Leaf, other: Leaf): number {
  a.owner = other;
  return a.owner.weight;
}

// 4: a fresh array that is returned
function weights(xs: Leaf[]): number[] {
  const out: number[] = [];
  for (let i = 0; i < xs.length; i++) out.push(xs[i].weight);
  return out;
}
function weightsCounted(xs: Leaf[]): number {
  const out: number[] = [];
  for (let i = 0; i < xs.length; i++) out.push(xs[i].weight);
  return out.length;
}
function copyOf(a: Leaf): { mark: number; twice: number } {
  const o = { mark: 0, twice: 0 };
  o.mark = a.mark;
  o.twice = a.mark * 2;
  return o;
}

// 6: a field of birth and an optional late field
class Item {
  kind: number;
  declare label: string | undefined;
  constructor(kind: number) {
    this.kind = kind;
  }
}
function kindAndLabel(n: Item): number {
  return n.kind + (n.label ? 1 : 0);
}


// Anything may happen to an object that untyped code holds: nothing of it happens to the objects of the families at run time.
////= disturb

const pool: any[] = [];
for (let i = 0; i < 64; i++) {
  const leaf = new Leaf(i);
  leaf.mark = i;
  leaf.owner = leaf;
  const crate = new Crate(i);
  crate.mark = i;
  crate.owner = crate;
  const item = new Item(i);
  if (i & 1) item.label = "l" + i;
  pool.push(leaf, crate, item, new Holder(leaf, crate));
}
const leaves: Leaf[] = [];
for (let i = 0; i < 64; i++) leaves.push(pool[i * 4]);

const spare: any = { mark: 1, owner: 2, weight: 3, label: 4, kind: 5 };
pool.push(spare);
for (let how = 1; how <= 5; how++) disturb(pool[pool.length - 1], ["mark", "owner", "weight", "label", "kind"][how - 1], how);
let total = 0;
for (let round = 0; round < 2000; round++) {
  const at = (round & 63) * 4;
  total += twoFamilies(pool[at], pool[at + 1]);
  total += twoFamiliesOfReferences(pool[at], pool[at + 1], pool[at + 1]);
  total += outOfHolder(pool[at + 3]);
  total += untypedTwoFamilies(pool[at], pool[at + 1]);
  total += countUp(pool[at], 3);
  total += fillIfEmpty(pool[at], pool[at]);
  total += storeThenRead(pool[at], pool[at]);
  total += weights(leaves).length;
  total += weightsCounted(leaves);
  total += copyOf(pool[at]).twice;
  total += kindAndLabel(pool[at + 2]);
}
console.log(total);
//// late-fields-that-are-never-undefined-are-read-while-empty.ts
// A field that is stored late, and never with undefined, is expected to be filled where it is read. A read that finds it empty, deleted, out of its slot, or answered from above the object is still right.
////= lines-25	Type	flags
interface ObjectFlagsType extends Type {
  objectFlags: number;
  target: Type;
  name: string;
}

function createObjectType(flags: number, objectFlags: number): ObjectFlagsType {
  const type = new Type(flags) as ObjectFlagsType;
  type.objectFlags = objectFlags;
  type.target = type;
  type.name = "type " + objectFlags;
  return type;
}

function getObjectFlags(type: Type): number {
  return type.flags & 1 ? (type as ObjectFlagsType).objectFlags : 0;
}
function readAnyway(type: Type) {
  return (type as ObjectFlagsType).objectFlags;
}
function targetOf(type: Type) {
  return (type as ObjectFlagsType).target;
}
function nameOf(type: Type) {
  return (type as ObjectFlagsType).name;
}
function allOf(type: Type) {
  const object = type as ObjectFlagsType;
  return `${object.objectFlags} ${object.target === type} ${object.name}`;
}

const filled: Type[] = [];
for (let index = 0; index < 2000; index++) filled.push(createObjectType(1, index));
let sum = 0;
for (const type of filled) sum += getObjectFlags(type) + readAnyway(type) + (targetOf(type) === type ? 1 : 0) + nameOf(type).length;
console.log("filled", sum);

const bare = new Type(0);
console.log("never stored", getObjectFlags(bare), readAnyway(bare), targetOf(bare), nameOf(bare), allOf(bare));

const lies = new Type(1);
console.log("flags say it is there", getObjectFlags(lies), allOf(lies));

const deleted = createObjectType(1, 7);
delete (deleted as any).objectFlags;
delete (deleted as any).target;
console.log("deleted", getObjectFlags(deleted), readAnyway(deleted), targetOf(deleted), nameOf(deleted), Object.keys(deleted).join());
deleted.objectFlags = 8;
console.log("stored again", getObjectFlags(deleted), Object.keys(deleted).join());

const accessor = createObjectType(1, 9);
let reads = 0;
Object.defineProperty(accessor, "objectFlags", { get() { return ++reads + 40; }, configurable: true });
console.log("accessor", getObjectFlags(accessor), readAnyway(accessor), allOf(accessor), reads);

const other = createObjectType(1, 10);
(other as any).objectFlags = "a string";
(other as any).target = 5;
(other as any).name = undefined;
console.log("other values", getObjectFlags(other), readAnyway(other), targetOf(other), nameOf(other), allOf(other));

const nulled = createObjectType(1, 11);
(nulled as any).objectFlags = null;
(nulled as any).target = null;
console.log("null", getObjectFlags(nulled), targetOf(nulled), allOf(nulled));

const frozen = Object.freeze(createObjectType(1, 12));
console.log("frozen", getObjectFlags(frozen), allOf(frozen));

const below = Object.create(createObjectType(1, 13)) as Type;
console.log("inherited from an object", getObjectFlags(below), readAnyway(below), nameOf(below));

const reparented = new Type(1);
Object.setPrototypeOf(reparented, { objectFlags: 14, name: "from above" });
console.log("another prototype", getObjectFlags(reparented), nameOf(reparented), targetOf(reparented));

(Type.prototype as any).objectFlags = 15;
(Type.prototype as any).name = "on the prototype";
