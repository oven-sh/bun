////: Crate
class Crate {
  size: number;
  declare mark: number;
  declare owner: Crate;
  constructor(size: number) {
    this.size = size;
  }
}
////: Leaf
class Leaf {
  weight: number;
  declare mark: number;
  declare owner: Leaf;
  constructor(weight: number) {
    this.weight = weight;
  }
}
