//// live-object-census.ts
// Known numbers of objects, arrays, maps and closures are alive when the program exits, and 100,000 more objects are garbage by then. object-census.test.ts runs it with BUN_JSC_dumpAOTObjectCensusAtExit=1 and looks for those numbers in the census. The output is that of plain Bun.
////= Point-3

class Holder {
  items: Point[];
  lookup?: Map<string, Point>;
  constructor(items: Point[]) {
    this.items = items;
  }
}

class Button {
  label: string;
  press = () => "pressed";
  constructor(label: string) {
    this.label = label;
  }
}

function createTicket(number: number): () => number {
  return function ticket() {
    return number * 2 + 1;
  };
}

let scratch: Point[] = [];
function sumDroppedPoints(count: number): number {
  for (let i = 0; i < count; i++) scratch.push(new Point(i, 1));
  let sum = 0;
  for (const point of scratch) sum += point.x + point.y;
  scratch = [];
  return sum;
}
const droppedSum = sumDroppedPoints(100_000);

const points: Point[] = [];
for (let i = 0; i < 1000; i++) points.push(new Point(i, -2 * i));

const holders: Holder[] = [];
for (let i = 0; i < 10; i++) {
  const holder = new Holder(i < 4 ? [] : points.slice(0, i));
  if (i % 2 === 0) {
    const lookup = new Map<string, Point>();
    if (i % 4 === 0) lookup.set("first", points[i]);
    holder.lookup = lookup;
  }
  holders.push(holder);
}

const tickets: (() => number)[] = [];
for (let i = 0; i < 500; i++) tickets.push(createTicket(i));

const buttons: Button[] = [];
for (let i = 0; i < 100; i++) buttons.push(new Button("button " + i));
const handlers: (() => string)[] = [];
for (let i = 0; i < 30; i++) handlers.push(buttons[i].press);

function describeLiveObjects(): string {
  let coordinates = 0;
  for (const point of points) coordinates += point.x + point.y;
  let items = 0;
  let entries = 0;
  for (const holder of holders) {
    items += holder.items.length;
    if (holder.lookup) entries += holder.lookup.size;
  }
  let numbers = 0;
  for (const ticket of tickets) numbers += ticket();
  let characters = 0;
  for (const button of buttons) characters += button.label.length + button.press().length;
  for (const handler of handlers) characters += handler().length;
  return [scratch.length, coordinates, items, entries, numbers, characters].join(" ");
}
// Reachable from the global object, the function keeps every variable it reads alive until the exit, and none of the objects reaches untyped code.
(globalThis as any).describeLiveObjects = describeLiveObjects;
console.log(droppedSum, describeLiveObjects());
export {};
//// loops-over-maps-and-sets-rarely-filled.js
// Loops over a Map or a Set that the program never fills, fills on one path only, or hands to code that fills it.
const lines = [];
const say = (...values) => lines.push(values.join(" "));

const neverFilledMap = new Map();
for (const entry of neverFilledMap) say("entry", entry);
for (const [key, value] of neverFilledMap) say("pair", key, value);
for (const key of neverFilledMap.keys()) say("key", key);
for (const value of neverFilledMap.values()) say("value", value);
neverFilledMap.forEach((value, key) => say("forEach", key, value));
say("after the empty map", neverFilledMap.size, [...neverFilledMap].length);

const neverFilledSet = new Set();
for (const element of neverFilledSet) say("element", element);
for (const [first, second] of neverFilledSet.entries()) say("entries", first, second);
neverFilledSet.forEach(element => say("forEach", element));
say("after the empty set", neverFilledSet.size, [...neverFilledSet].length);

function fillOnOnePath(fill) {
    const map = new Map();
    const set = new Set();
    if (fill) {
        map.set("a", 1);
        set.add("b");
    }
    let text = "";
    for (const [key, value] of map) text += key + value;
    for (const element of set) text += element.length;
    map.forEach((value, key) => { text += key.toUpperCase() + (value + 1); });
    set.forEach(element => { text += element.toUpperCase(); });
    return text + "|";
}
say("one path", fillOnOnePath(false), fillOnOnePath(true), fillOnOnePath(false));

function fillThrough(fillers) {
    const map = new Map();
    const set = new Set();
    for (const fill of fillers) fill(map, set);
    let text = "";
    for (const [key, value] of map) text += String(key) + String(value);
    for (const element of set) text += String(element);
    return text + "|";
}
const fillers = JSON.parse("[0, 1]").map(n => n ? (map, set) => { map.set(n, undefined); set.add(undefined); } : () => { });
say("filled elsewhere", fillThrough([]), fillThrough(fillers));

const filledByBuiltIn = new Set();
["x", "yz"].forEach(Set.prototype.add, filledByBuiltIn);
for (const element of filledByBuiltIn) say("added by a built-in", element.length);
const filledByReflect = new Map();
Reflect.apply(Map.prototype.set, filledByReflect, ["k", "v"]);
for (const [key, value] of filledByReflect) say("set by a built-in", key + value);
const filledThroughBound = new Map();
const setBound = filledThroughBound.set.bind(filledThroughBound);
[["b", 2]].forEach(pair => setBound(...pair));
for (const [key, value] of filledThroughBound) say("set through a bound function", key, value + 1);

const holdsUndefined = new Map([[undefined, undefined]]);
for (const [key, value] of holdsUndefined) say("undefined entry", key, value);

class SetHeir extends Set { }
class MapHeir extends Map { }
const setHeir = new SetHeir(["a", "bc"]);
const emptySetHeir = new SetHeir();
const mapHeir = new MapHeir([["k", "v"]]);
let total = 0;
setHeir.forEach(element => { total += element.length; });
for (const element of setHeir) total += element.length;
emptySetHeir.forEach(element => { total += element.length; });
for (const element of emptySetHeir) total += element.length;
mapHeir.forEach((value, key) => { total += value.length + key.length; });
for (const [key, value] of new MapHeir()) total += key.length + value.length;
say("subclasses", total);

console.log(lines.join("\n"));
//// many-optional-fields-redefined-and-replaced.ts
// Objects with many fields, most of which start as undefined and are seldom filled, so that they need not lie in the object itself. Such fields are redefined as accessors, made
// hidden or read-only, given values of another kind, deleted and created again; the listing of the keys, the copies and the typed reads follow.
function outcome(f: () => unknown): string { try { return JSON.stringify(f()) ?? "undefined" } catch (e) { return "throws " + (e as Error).name } }
function show(label: string, ...parts: unknown[]): void { console.log(label + ": " + parts.map(String).join(" | ")) }

class Wide {
  id: number
  a0: number | undefined = undefined; a1: number | undefined = undefined; a2: number | undefined = undefined; a3: number | undefined = undefined; a4: number | undefined = undefined
  a5: string | undefined = undefined; a6: string | undefined = undefined; a7: string | undefined = undefined; a8: string | undefined = undefined; a9: string | undefined = undefined
  b0: Wide | undefined = undefined; b1: Wide | undefined = undefined; b2: Wide | undefined = undefined; b3: Wide | undefined = undefined; b4: Wide | undefined = undefined
  b5: boolean | undefined = undefined; b6: boolean | undefined = undefined; b7: boolean | undefined = undefined; b8: boolean | undefined = undefined; b9: boolean | undefined = undefined
  c0: unknown = undefined; c1: unknown = undefined; c2: unknown = undefined; c3: unknown = undefined; c4: unknown = undefined
  c5: number[] | undefined = undefined; c6: number[] | undefined = undefined; c7: number[] | undefined = undefined; c8: number[] | undefined = undefined; c9: number[] | undefined = undefined
  d0: number | undefined = undefined; d1: number | undefined = undefined; d2: number | undefined = undefined; d3: number | undefined = undefined; d4: number | undefined = undefined
  d5: string | undefined = undefined; d6: string | undefined = undefined; d7: string | undefined = undefined; d8: string | undefined = undefined; d9: string | undefined = undefined
  last = "last"
  constructor(id: number) { this.id = id }
}
const names = ["a0", "a5", "b0", "b5", "c0", "c5", "d4", "d9"] as const
const fitting = (w: Wide): Record<string, unknown> => ({ a0: 10.5, a5: "got", b0: w, b5: false, c0: "anything", c5: [9], d4: -3, d9: "" })

const text: any = (0, eval)(`({
  accessor(o, k, v) { Object.defineProperty(o, k, { get() { return this === o ? v : "wrong receiver"; }, set(x) { this.last = "set " + typeof x; }, enumerable: true, configurable: true }); },
  hidden(o, k) { Object.defineProperty(o, k, { enumerable: false }); },
  readOnly(o, k) { Object.defineProperty(o, k, { writable: false }); },
  defined(o, k, v) { Object.defineProperty(o, k, { value: v, writable: true, enumerable: true, configurable: true }); },
  definedHidden(o, k, v) { Object.defineProperty(o, k, { value: v, writable: true, enumerable: false, configurable: true }); },
  remove(o, k) { delete o[k]; },
  removeAndAdd(o, k) { delete o[k]; o[k] = undefined; },
  filledThenAccessor(o, k, v) { o[k] = v; Object.defineProperty(o, k, { get() { return v; }, enumerable: true, configurable: true }); },
  accessorThenValue(o, k, v) { Object.defineProperty(o, k, { get() { return v; }, enumerable: true, configurable: true }); Object.defineProperty(o, k, { value: v, writable: true }); },
  frozen(o, k) { Object.freeze(o); },
  otherKind(o, k) { o[k] = Symbol.for("other"); },
  store(o, k, v) { "use strict"; o[k] = v; return typeof o[k]; },
})`)

function readTyped(w: Wide): string { return [w.id, w.a0, w.a5, w.b0 === undefined ? "none" : w.b0.id, w.b5, String(w.c0), w.c5 === undefined ? "none" : w.c5.length, w.d4, w.d9, w.last].map(String).join(",") }
function readUntyped(w: any): string { return [w.id, w.a0, w.a5, typeof w.b0, w.b5, w.c0, typeof w.c5, w.d4, w.d9, w.last].map(String).join(",") }
function fillTyped(w: Wide): void { w.a0 = 1; w.a5 = "s"; w.b0 = w; w.b5 = true; w.c0 = 2; w.c5 = [3]; w.d4 = 4; w.d9 = "t" }
function seen(o: any): string {
  const keys = Object.keys(o)
  return [keys.length, keys.filter(k => !/^[a-d][0-9]$/.test(k) || names.includes(k as any)).join(), Reflect.ownKeys(o).length, Object.keys({ ...o }).length, JSON.stringify(o, (k, v) => k.startsWith("b") && v instanceof Wide ? "wide" : typeof v === "symbol" ? "symbol" : v).length, keys.indexOf("d9"), keys.indexOf("last")].join(" ; ")
}

for (const alteration of Object.keys(text)) {
  if (alteration === "store") continue
  for (const name of names) {
    const w = new Wide(1)
    text[alteration](w, name, fitting(w)[name])
    const descriptor = Object.getOwnPropertyDescriptor(w, name)
