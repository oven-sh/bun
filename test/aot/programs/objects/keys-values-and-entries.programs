const list: Wide[] = []
for (let i = 0; i < 500; i++) {
  const w = new Wide(i)
  if (i % 2 === 0) text.accessor(w, "a5", "got " + i)
  if (i % 3 === 0) text.hidden(w, "d4")
  if (i % 5 === 0) w.c5 = [i]
  list.push(w)
}
