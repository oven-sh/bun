//// maps-and-sets-with-ordinary-storage-are-walked-by-native-code-in-a-validating-build.js
// Native code that reads a whole map or set walks its table: Array.from, the methods of sets that take another set, structuredClone, the constructors, Object.fromEntries, a deep comparison. It changes nothing that a program can see, whatever the keys are and however many: as in plain Bun, and a validating build has nothing to find.
import { isDeepStrictEqual } from "node:util";
const objects = Array.from({ length: 300 }, (_, index) => ({ id: index }));
const symbols = Array.from({ length: 300 }, (_, index) => Symbol("s" + index));
const kinds = {
  strings: index => "k" + index,
  integers: index => index,
  doubles: index => index + 0.5,
  objects: index => objects[index],
  symbols: index => symbols[index],
  bigints: index => BigInt(index),
  mixed: index => (index === 0 ? undefined : index === 1 ? null : ["k" + index, index, index + 0.5, objects[index], symbols[index], BigInt(index)][index % 6]),
};
function readSet(set) {
  const before = [...set];
  const answers = [Array.from(set).length, Array.from(set.values()).length, new Set(set).size, set.union(new Set([-1])).size, set.intersection(set).size, set.difference(new Set()).size, set.isSubsetOf(set), new Set(set).isSupersetOf(set), isDeepStrictEqual(set, new Set(set))];
  const after = [...set];
  return answers.join() + " " + (before.length === after.length && before.every((value, index) => Object.is(value, after[index])));
}
function readMap(map, canBeCloned) {
  const before = [...map.keys()];
  const answers = [Array.from(map).length, Array.from(map.keys()).length, Array.from(map.values()).length, new Map(map).size, canBeCloned ? structuredClone(map).size : "-", isDeepStrictEqual(map, new Map(map)), Map.groupBy(map, () => 1).get(1)?.length];
  const after = [...map.keys()];
  return answers.join() + " " + (before.length === after.length && before.every((value, index) => Object.is(value, after[index])));
}
for (const kind in kinds) {
  for (const count of [0, 1, 5, 9, 255]) {
    const set = new Set(), map = new Map();
    for (let index = 0; index < count; index++) { set.add(kinds[kind](index)); map.set(kinds[kind](index), index); }
    console.log(kind, count, readSet(set), readMap(map, kind !== "symbols" && kind !== "mixed"));
    if (count < 5) continue;
    set.delete(kinds[kind](2)); map.delete(kinds[kind](2));
    console.log(kind, count, "with one deleted", readSet(set), readMap(map, kind !== "symbols" && kind !== "mixed"));
  }
}
//// megamorphic-key-reads.ts
// Many shapes, made one after the other, asked for the same names, and one shape asked for many names: whatever remembers a shape and a key has to tell the pairs apart.
function read(object: any, key: any): any { return object[key]; }
function isIn(object: any, key: any): boolean { return key in object; }
function store(object: any, key: any, value: any): void { object[key] = value; }
const names: string[] = [];
for (let i = 0; i < 48; i++) names.push("n" + i);
const symbols = [Symbol("s0"), Symbol("s1"), Symbol("s2")];
let wrong = 0;
let asked = 0;
function expect(what: string, got: any, wanted: any): void {
    asked++;
    if (got !== wanted && wrong++ < 20) console.log("WRONG " + what + ": " + String(got) + ", not " + String(wanted));
}
// Shape s has the names s % 7, s % 7 + step, .. in an order of its own, so that the same name lies at another place in each.
function make(s: number): any {
    const object: any = {};
    object["shape" + s] = s;
    const step = 1 + s % 5;
    for (let i = s % 7, place = 0; i < names.length; i += step, place++) object[names[(i + s) % names.length]] = s * 100 + place;
    if (s % 3 === 0) object[symbols[s % symbols.length]] = -s;
    return object;
}
function expected(s: number): Map<any, number> {
    const map = new Map<any, number>();
    const step = 1 + s % 5;
    for (let i = s % 7, place = 0; i < names.length; i += step, place++) map.set(names[(i + s) % names.length], s * 100 + place);
    if (s % 3 === 0) map.set(symbols[s % symbols.length], -s);
    return map;
}
const count = 400;
const objects: any[] = [];
const maps: Map<any, number>[] = [];
for (let s = 0; s < count; s++) { objects.push(make(s)); maps.push(expected(s)); }
const keys: any[] = [...names, ...symbols];
for (let round = 0; round < 3; round++) {
    // By shape, then by key; and by key, then by shape.
    for (let s = 0; s < count; s++) for (const key of keys) { expect("read", read(objects[s], key), maps[s].get(key)); expect("in", isIn(objects[s], key), maps[s].has(key)); }
    for (const key of keys) for (let s = 0; s < count; s++) { expect("read by key", read(objects[s], key), maps[s].get(key)); expect("in by key", isIn(objects[s], key), maps[s].has(key)); }
    // Replace what is there, add what is not, on a second object of each shape.
    for (let s = 0; s < count; s += 3) {
        const twin = make(s);
        const map = expected(s);
        for (const key of keys) { store(twin, key, round); map.set(key, round); }
        for (const key of keys) expect("stored", read(twin, key), map.get(key));
        expect("names of the twin", Reflect.ownKeys(twin).length, keys.length + 1);
        for (const key of keys) expect("untouched", read(objects[s], key), maps[s].get(key));
    }
}
console.log("asked " + asked + ", wrong " + wrong);
//// members-of-a-literal-run-on-what-object-create-makes-below-it-and-on-other-receivers.js
// The members of a literal store names through `this`. They run on objects made one and two steps below the literal, on the literal, on unrelated objects and on primitives,
// while the objects above gain, lose and redefine members.
const lines = [];
const answers = {
  get sent() {
    return this.res.sent;
  },
  has(name) {
    return this.res.names === name;
  },
  get status() {
    return this.res.code;
  },
  set status(code) {
    if (this.sent) return;
    this._explicitStatus = true;
    this.res.code = code;
  },
  get body() {
    return this._body;
  },
  set body(value) {
    const original = this._body;
    this._body = value;
    if (!this._explicitStatus) this.status = 200;
    if (!this.has("b")) this.length = value.length;
    if (original !== undefined) this.replaced = (this.replaced | 0) + 1;
  },
  set length(n) {
    this.res.size = n;
  },
  get length() {
    return this.res.size;
  },
  describe() {
    return Object.keys(this).join() + "|" + this._body + "|" + this._explicitStatus + "|" + this.replaced;
  },
  whatIsThis() {
    "use strict";
    return typeof this;
  },
};
class Application {
  constructor() {
    this.answers = Object.create(answers);
  }
  create(req, res) {
    const made = Object.create(this.answers);
    made.app = this;
    made.req = req;
    made.res = res;
    return made;
  }
}
const hidden = process.argv.length > 9 ? "x" : "";
const application = new Application();
const newRes = () => ({ sent: false, names: "a", code: 404, size: 0 });
function handle(answer, value) {
  answer.body = value;
  return answer.status + ":" + answer.length + ":" + answer.describe();
}
globalThis["handle" + hidden] = handle;
function call(answer, value) {
  try {
    return globalThis["handle" + hidden](answer, value);
  } catch (error) {
    return "threw " + error.constructor.name + " " + answers.describe.call(answer);
  }
}

for (let i = 0; i < 3; i++) lines.push(call(application.create({ url: "/" }, newRes()), "Hello" + "!".repeat(i)));

const twice = application.create({}, newRes());
lines.push(call(twice, "one"), call(twice, "three"), Object.getOwnPropertyNames(twice).join());

// The order of the names is the order of the stores.
const ordered = application.create({}, newRes());
ordered.replaced = 7;
ordered._explicitStatus = false;
lines.push(call(ordered, "x"), JSON.stringify(Object.entries(ordered).map(([name]) => name)));

// One step below, the literal itself, an unrelated object, a primitive.
application.answers.res = newRes();
lines.push(call(application.answers, "middle"), Object.keys(application.answers).join());
delete application.answers.res;
delete application.answers._body;
delete application.answers._explicitStatus;
answers.res = newRes();
lines.push(call(answers, "top"), Object.keys(answers).length);
delete answers.res;
delete answers._body;
delete answers._explicitStatus;
const stranger = { res: newRes(), has: answers.has, describe: answers.describe };
Object.defineProperty(stranger, "body", Object.getOwnPropertyDescriptor(answers, "body"));
lines.push(call(stranger, "far"), stranger.status, stranger.length);
lines.push(answers.whatIsThis.call(5), answers.whatIsThis.call(undefined), answers.whatIsThis.call("s"), answers.describe.call([1, 2]));
try {
  Object.getOwnPropertyDescriptor(answers, "body").set.call(undefined, "x");
} catch (error) {
  lines.push(error instanceof TypeError);
}

// A name that the members store gets an accessor above, then a value, then goes.
const seen = [];
Object.defineProperty(application.answers, "_body", {
  get() {
    return "from above";
  },
  set(value) {
    seen.push(value);
  },
  configurable: true,
});
const below = application.create({}, newRes());
lines.push(call(below, "caught"), seen.join(), Object.hasOwn(below, "_body"));
Object.defineProperty(application.answers, "_body", { value: "fixed", writable: false, configurable: true });
const refused = application.create({}, newRes());
lines.push(call(refused, "dropped"), Object.hasOwn(refused, "_body"));
delete application.answers._body;
lines.push(call(application.create({}, newRes()), "again"));

// An accessor of the literal becomes a value, a method is replaced, the link above changes.
Object.defineProperty(answers, "status", { value: 599, writable: true, configurable: true });
const plain = application.create({}, newRes());
lines.push(call(plain, "value"), Object.hasOwn(plain, "status"), plain.res.code);
answers.has = () => true;
lines.push(call(application.create({}, newRes()), "no length"));
Object.setPrototypeOf(application.answers, { describe: () => "other", set body(value) {}, status: 1, length: 2 });
lines.push(call(application.create({}, newRes()), "elsewhere"));

// Frozen, sealed and closed objects.
Object.setPrototypeOf(application.answers, answers);
delete answers.status;
for (const close of [Object.freeze, Object.seal, Object.preventExtensions]) {
  const closed = close(application.create({}, newRes()));
  lines.push(call(closed, "closed"), Object.keys(closed).join());
}
console.log(lines.join("\n"));
