//// missing-keys.ts
// Strings that are the name of no property anywhere, asked for again and again by the same string objects; then the name comes to be: on the object, above it, in a dictionary, and goes again.
const lines: string[] = [];
const asked = ["NOTHING_HAS_THIS_ONE", "NOTHING_HAS_THIS_TWO", "NOTHING_HAS_THIS_THREE", "NOTHING_HAS_THIS_FOUR", "NOTHING_HAS_THIS_FIVE", "NOTHING_HAS_THIS_SIX"];
function sameText(index: number): string {
    return ["NOTHING", "HAS", "THIS", ["ONE", "TWO", "THREE", "FOUR", "FIVE", "SIX"][index]!].join("_");
}
function ask(record: Record<string, unknown>, rounds: number): string {
    const seen: string[] = [];
    for (let round = 0; round < rounds; round++) {
        let line = "";
        for (let i = 0; i < asked.length; i++) {
            const value = record[asked[i]!];
            line += value === undefined ? "." : String(value);
        }
        if (seen[seen.length - 1] !== line) seen.push(line);
    }
    return seen.join(" ");
}
const grandparent: Record<string, unknown> = { old: 1 };
const parent: Record<string, unknown> = Object.create(grandparent);
parent.inherited = 1;
const small: Record<string, unknown> = Object.create(parent);
small.a = 1;
small.b = 2;
const twin: Record<string, unknown> = Object.create(parent);
twin.a = 1;
twin.b = 2;
lines.push("nothing yet: " + ask(small, 5) + " | " + ask(twin, 5));
small[sameText(0)] = "own";
lines.push("one on the object: " + ask(small, 5) + " | the twin " + ask(twin, 5));
parent[sameText(1)] = "above";
lines.push("one on the parent: " + ask(small, 5) + " | " + ask(twin, 5));
grandparent[sameText(2)] = "top";
lines.push("one on the grandparent: " + ask(small, 5) + " | " + ask(twin, 5) + " | " + ask({}, 5));
delete grandparent[sameText(2)];
delete parent[sameText(1)];
lines.push("both gone: " + ask(small, 5) + " | " + ask(twin, 5) + " | " + ask({}, 5));
Object.defineProperty(parent, sameText(3), { get() { return "got"; }, configurable: true });
lines.push("a getter above: " + ask(small, 5) + " | " + ask(twin, 5));
delete parent[sameText(3)];
Object.setPrototypeOf(twin, { [sameText(4)]: "other parent" });
lines.push("another parent: " + ask(small, 5) + " | " + ask(twin, 5));

const large: Record<string, unknown> = {};
for (let i = 0; i < 200; i++) large["key" + i] = i;
lines.push("a dictionary: " + ask(large, 5));
large[sameText(5)] = "in";
lines.push("it has one: " + ask(large, 5));
delete large[sameText(5)];
lines.push("no longer: " + ask(large, 5));
delete large.key7;
large[sameText(0)] = "for another";
lines.push("one out, one in: " + ask(large, 5));
delete large[sameText(0)];
large.key7 = 7;
lines.push("and back: " + ask(large, 5));

const list: any = [1, 2, 3];
function callable() { }
lines.push("an array, a function: " + ask(list, 4) + " | " + ask(callable as any, 4));
list[sameText(1)] = "on the array";
(callable as any)[sameText(2)] = "on the function";
lines.push("then: " + ask(list, 4) + " | " + ask(callable as any, 4));
const watched = new Proxy({}, { get(_target, name) { return typeof name === "string" && name.endsWith("SIX") ? "trapped" : undefined; } });
const belowProxy: Record<string, unknown> = Object.create(watched);
lines.push("below a proxy: " + ask(belowProxy, 4));
const bare: Record<string, unknown> = Object.create(null);
lines.push("no parent at all: " + ask(bare, 4));
bare[sameText(3)] = "bare";
lines.push("then: " + ask(bare, 4));
let total = 0;
for (let turn = 0; turn < 20000; turn++) {
    if (turn === 9000) parent[sameText(5)] = 1;
    if (turn === 15000) delete parent[sameText(5)];
    if (small[asked[turn % 6]!] !== undefined) total++;
}
lines.push("in a long loop: " + total);
console.log(lines.join("\n"));
//// mixed-accessor-data-reads.ts
// An object literal with data members and a getter is given more properties later. Names it has, names it lacks and names it inherits are read many times from the same places while it changes.
const lines: string[] = [];
function say(label: string, value: unknown): void { lines.push(label + ": " + String(value)); }
interface Box { size: number; readonly twice: number }
function makeBox(size: number): Box { return { size, get twice() { return this.size * 2; } }; }
function many(run: () => unknown): string { let last: unknown; for (let i = 0; i < 300; i++) last = run(); return String(last); }
function colorOf(from: any): unknown { return from.color; }
function thenOf(from: any): unknown { return from.then; }
function toStringOf(from: any): unknown { return typeof from.toString; }
function sizeOf(from: any): unknown { return from.size; }

const box = makeBox(3);
const other = makeBox(4);
const loose: any = box;
say("a name it lacks", many(() => colorOf(box)) + " " + many(() => thenOf(box)));
say("a name it inherits", many(() => toStringOf(box)));
loose.color = "red";
say("the name is there now", many(() => colorOf(box)) + " " + many(() => colorOf(other)));
loose.color = "green";
say("another value", many(() => colorOf(box)));
loose.weight = 1;
say("one property more", many(() => colorOf(box)) + " " + many(() => thenOf(box)));
delete loose.color;
say("deleted", many(() => colorOf(box)));
Object.defineProperty(loose, "color", { get() { return "from a getter"; }, configurable: true });
say("an accessor by that name", many(() => colorOf(box)));
Object.defineProperty(loose, "color", { value: "a value again", configurable: true, writable: false });
say("a value that cannot be written", many(() => colorOf(box)));
class Holder { size = 1 }
const held: any = new Holder();
Object.defineProperty(held, "twice", { get() { return 2; }, configurable: true });
say("an instance with an accessor of its own lacks the name", many(() => thenOf(held)) + " " + many(() => sizeOf(held)) + " " + held.twice);
loose.then = 5;
say("its own", many(() => thenOf(box)) + " " + many(() => thenOf(other)));
say("fields and the getter are as they were", many(() => sizeOf(box)) + " " + box.twice + " " + other.twice);
const boxes: Box[] = [];
for (let i = 0; i < 100; i++) { const made = makeBox(i); if (i % 3 === 0) (made as any).color = "c" + i; boxes.push(made); }
let seen = "";
for (let round = 0; round < 5; round++) for (const made of boxes) { const color = colorOf(made); if (round === 4 && color !== undefined && made.size < 20) seen += color; }
say("a hundred objects through one place", seen);
let garbage: unknown[] = [];
for (let i = 0; i < 200000; i++) { garbage.push({ i, get half() { return i / 2; } }); if (garbage.length > 1000) garbage = []; if (i % 50000 === 0) say("while garbage is made", String(colorOf(box)) + thenOf(box) + thenOf(other)); }
say("keys", Object.keys(box).join());
console.log(lines.join("\n"));
//// multi-spread-literals.js
const show = object => Reflect.ownKeys(object).map(key => String(key) + "=" + JSON.stringify(object[key])).join(",");
const errorLines = error => [...String(error.stack).matchAll(/multi-spread-literals\.js:(\d+)/g)].map(match => match[1]).join(",");

const first = { a: 1, b: 2 };
const second = { b: 3, c: 4 };
const third = { c: 5, d: 6 };
const fourth = { e: 7 };
const fifth = { a: 8, f: 9 };

for (let round = 0; round < 3; round++) {
  console.log("two", show({ before: 0, ...first, between: 1, ...second, after: 2 }));
  console.log("three", show({ ...first, x: 1, ...second, y: 2, ...third }));
  console.log("five", show({ ...first, ...second, x: 1, ...third, ...fourth, y: 2, ...fifth }));
  console.log("later named wins", show({ ...first, ...second, a: "named", c: "named" }));
  console.log("later source wins", show({ a: "named", c: "named", ...first, ...second }));
  console.log("nullish sources", show({ ...null, a: 1, ...undefined, ...second, ...0 }));
  console.log("index names", show({ ...first, 1: "one", ...second, 0: "zero" }));
  console.log("string source", show({ ...first, ..."hi", ...second }));
  console.log("symbol source", show({ ...first, ...{ [Symbol.for("multi")]: 1 }, ...second }));
}

const throwing = {
  get boom() {
    throw new Error("boom");
  },
};

function spreadThrows() {
  return {
    ...first,
    named: 1,
    ...second,
    ...throwing,
    ...third,
  };
}

for (let round = 0; round < 2; round++) {
  try {
    spreadThrows();
  } catch (error) {
    console.log(error.message, errorLines(error));
  }
}

const order = [];
const logged = name => ({
  get [name]() {
    order.push(name);
    return name;
  },
});
console.log("getters", show({ ...logged("p"), q: order.push("named"), ...logged("r") }), order.join(","));

const changing = [{ a: 1 }, { b: 2 }, { a: 3, b: 4 }, { b: 5, a: 6 }, Object.create({ inherited: 1 }), [7, 8], null, "s", { get a() { return 9; } }];
for (let round = 0; round < 2; round++) {
  for (const left of changing) {
    for (const right of changing) console.log("changing", show({ ...left, mid: 0, ...right }));
  }
}
//// named-stores-in-loops.ts
declare const console: { log(...values: unknown[]): void };
type Open = { [name: string]: unknown };
function show(v: unknown): string { return typeof v === "object" && v !== null ? JSON.stringify(v) : typeof v + ":" + (Object.is(v, -0) ? "-0" : String(v)); }
function garbage(n: number): number { let t = 0; for (let i = 0; i < n; i++) { const g: Open = { a: [i, i + 0.5], b: "g" + i }; t += (g.b as string).length; } return t; }
function wholes(o: Open, n: number): void { let w = n * 1000003; for (let i = 0; i < n; i++) { w += i; o.count = w; o.small = i; } }
function halves(o: Open, n: number, v: number): void { for (let i = 0; i < n; i++) { o.half = v + i * 0.5; o.ratio = i / 3; } }
function flags(o: Open, n: number): void { for (let i = 0; i < n; i++) { o.odd = (i & 1) === 1; o.none = undefined; o.nil = null; } }
function maybe(o: Open, a: number[], n: number): void { for (let i = 0; i < n; i++) o.element = a[i]; }
function texts(o: Open, n: number): void { for (let i = 0; i < n; i++) { o.text = "t" + i; o.count = i; garbage(3); } }
function cells(o: Open, n: number): void { for (let i = 0; i < n; i++) { o.cell = { at: i, list: [i, "x" + i] }; o.half = i + 0.5; garbage(3); } }
function either(o: Open, n: number): void { for (let i = 0; i < n; i++) { const v: number | string = i % 3 ? i * 1.5 : "s" + i; o.either = v; garbage(2); } }
function eitherCell(o: Open, n: number): void { for (let i = 0; i < n; i++) { const v: number | { at: number } = i & 1 ? { at: i } : i; o.other = v; garbage(2); } }
function anything(o: Open, values: unknown[]): void { for (let i = 0; i < values.length; i++) { o.any = values[i]; garbage(1); } }
class Row { [name: string]: unknown; constructor(n: number) { for (let i = 0; i < n; i++) { this.total = i * 2.5; this.label = "r" + i; this.index = i; } } }
const old: Open[] = [];
for (let i = 0; i < 40; i++) old.push({ count: 0, small: 0, half: 0, ratio: 0, odd: false, none: 1, nil: 1, element: 0, text: "", cell: null, either: 0, other: 0, any: 0 });
garbage(20000);
for (let turn = 0; turn < 3; turn++) {
    for (let k = 0; k < old.length; k++) {
        const o = old[k];
        wholes(o, 5 + k); halves(o, 4 + k, turn); flags(o, 3 + (k & 3)); maybe(o, [1.5, 2, 3.25], 2 + (k % 3)); texts(o, 6); cells(o, 6); either(o, 5 + (k % 4)); eitherCell(o, 4 + (k & 1)); anything(o, [1, "a" + k, { k }, 2.5, null, [k]].slice(0, 1 + (k % 6)));
    }
    garbage(30000);
    for (let k = 0; k < old.length; k += 7)
        console.log(turn + " " + k + ": " + Object.keys(old[k]).map(name => name + "=" + show(old[k][name])).join(" "));
    const row = new Row(4 + turn);
    garbage(5000);
    console.log(Object.keys(row).map(name => name + "=" + show(row[name])).join(" "));
}
