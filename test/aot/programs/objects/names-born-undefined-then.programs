//// names-used-as-values/late.ts
export const lateTag = Symbol("tag");

export function lateLiteral(start: number) {
  let held = start;
  return {
    get [lateTag]() { return "late " + held; },
    get level() { return held + 100; },
    set level(v: number) { held = v; },
  };
}

type LateSignal = typeof lateTag | typeof Symbol.iterator | string;
export function reactLate(signal: LateSignal): string {
  if (signal === lateTag) return "late tag";
  if (signal === Symbol.iterator) return "iterator";
  return "other " + String(signal);
}
//// names-used-as-values/main.ts
// Names that compiled code hands over as values: accessors of literals and classes, methods of a class that is evaluated several times, Object.hasOwn in code that runs once and in a loop, symbols in type tests. A name is one value in every module, before and after collections, and a symbol that is only declared or never read changes nothing.
import { lateLiteral, lateTag, reactLate } from "./late.ts";
// @ts-ignore
import { storeThroughSuper } from "./untyped.js";

const collect: () => void = (globalThis as any).gc ?? (() => (globalThis as any).Bun.gc(true));
const show = (v: unknown): string => (typeof v === "symbol" ? v.toString() : typeof v === "function" ? "function " + v.name : String(JSON.stringify(v)));
function describe(o: object): string {
  return Reflect.ownKeys(o)
    .map(key => {
      const d = Reflect.getOwnPropertyDescriptor(o, key)!;
      return show(key) + ":" + (d.get ? "g" : "") + (d.set ? "s" : "") + ("value" in d ? "v" : "") + (d.enumerable ? "e" : "");
    })
    .join(" ");
}

const tag = Symbol("tag");
const neverRead = Symbol("never read");
declare const onlyDeclared: unique symbol;
interface Marked {
  [onlyDeclared]?: number;
  level: number;
}

function literal(start: number) {
  let held = start;
  return {
    get level() { return held; },
    set level(v: number) { held = v * 2; },
    get [tag]() { return "tagged " + held; },
    get [Symbol.toStringTag]() { return "Literal"; },
    set onlySetter(v: number) { held += v; },
  };
}

function makeClass(suffix: string) {
  return class Made {
    static kind = "made " + suffix;
    method() { return "method " + suffix; }
    get reading() { return "reading " + suffix; }
    set reading(v: string) { suffix = v; }
    [tag]() { return "by symbol " + suffix; }
    static helper() { return "helper " + suffix; }
    ["com" + "puted"]() { return "computed " + suffix; }
    after() { return "after " + suffix; }
  };
}

const stop = Symbol("stop");
const skip = Symbol("skip");
type Signal = typeof stop | typeof skip | number;
function react(signal: Signal): string {
  if (signal === stop) return "stop";
  if (signal === skip) return "skip";
  return "other " + String(signal);
}

function countOwn(o: object, rounds: number): number {
  let count = 0;
  for (let i = 0; i < rounds; i++) {
    if (Object.hasOwn(o, "alpha")) count++;
    if (Object.hasOwn(o, "gamma")) count += 1000;
    if (Object.hasOwn(o, tag)) count += 10;
  }
  return count;
}

function round(title: string) {
  const o = literal(3);
  const marked: Marked = o;
  o.level = 4;
  o.onlySetter = 1;
  console.log(title, "literal:", describe(o), marked.level, o[tag], String(o), Object.getOwnPropertySymbols(o)[0] === tag);

  for (const suffix of ["a", "b"]) {
    const Made = makeClass(suffix);
    const made: any = new Made();
    made.reading = suffix + "!";
    console.log(title, "class:", describe(Made.prototype), "|", describe(Made), "|", made.method(), made.reading, made[tag](), Made.helper(), made.computed(), made.after(), Made.kind);
  }

  const record = { alpha: 1, [tag]: 2 };
  console.log(title, "own:", Object.hasOwn(record, "alpha"), Object.hasOwn(record, "beta"), Object.hasOwn(record, tag), Object.hasOwn(record, lateTag), Object.hasOwn(record, Symbol.iterator), record.hasOwnProperty("alpha"), countOwn(record, 50));

  const signals: any[] = [stop, skip, 3, Symbol("stop"), Symbol.iterator, lateTag, tag];
  console.log(title, "signals:", signals.map(signal => react(signal)).join(), "|", signals.map(signal => reactLate(signal)).join());

  const late = lateLiteral(5);
  late.level = 6;
  console.log(title, "other module:", describe(late), late.level, late[lateTag], (late as any)[tag], Object.getOwnPropertySymbols(late)[0] === lateTag);
  console.log(title, "super:", storeThroughSuper(tag, 7));
}

round("first");
collect();
round("after a collection");
collect();
collect();
round("after more collections");
//// names-used-as-values/untyped.js
const keyText = key => (typeof key === "symbol" ? key.toString() : key);

const base = {
  set width(v) { this.stored = "setter " + v; },
};

class Parent {
  set depth(v) { this.seen = "parent " + v; }
}
class Child extends Parent {
  assign(v) {
    super.depth = v;
    super.plain = v + 1;
    return Reflect.ownKeys(this).map(keyText).join() + " " + this.seen + " " + this.plain;
  }
}

export function storeThroughSuper(tag, v) {
  const derived = {
    __proto__: base,
    assign(value) {
      super.width = value;
      super.height = value + 1;
      super[tag] = value + 2;
      return Reflect.ownKeys(this).map(keyText).join() + " " + this.stored + " " + this.height + " " + this[tag];
    },
  };
  return derived.assign(v) + " | " + new Child().assign(v);
}
//// namespace-key-order.ts
// An exported function, class, enum or namespace of a namespace is a binding of its block, and its statement copies it to the property: key order, calls above the declaration, stores to the property from outside.
declare const console: { log(...values: unknown[]): void };
function said(f: () => unknown): string { try { return String(f()); } catch (e) { return "threw " + (e as Error).name; } }
function row(label: string, f: () => unknown) { console.log(label + ": " + said(f)); }
const keys = (o: object) => Object.keys(o).join();

namespace Ordered {
  export const first = 1;
  export function second() { return 2; }
  export class Third {}
  export enum Fourth { A }
  export namespace Fifth { export const inner = 5; }
  export let sixth = 6;
}
row("keys in statement order", () => keys(Ordered));

namespace Hoisted {
  export const keysAtCall = later();
  export const typeAtCall = typeof (Hoisted as any).later;
  export function later() { return "[" + keys(Hoisted) + "]"; }
  export const typeBehind = typeof (Hoisted as any).later;
}
row("a call above the declaration", () => Hoisted.keysAtCall);
row("the property above the declaration", () => Hoisted.typeAtCall);
row("the property behind the declaration", () => Hoisted.typeBehind);
row("keys with a hoisted function", () => keys(Hoisted));

namespace Replaced {
  export function f() { return "declared"; }
  export class C { static who = "declared"; }
  export function callInBlock() { return f(); }
  export function classInBlock() { return C.who; }
}
namespace Replaced {
  export function callInOtherBlock() { return f(); }
  export function classInOtherBlock() { return C.who; }
}
(Replaced as any).f = () => "stored";
(Replaced as any).C = class { static who = "stored"; };
row("a function, in its block", () => Replaced.callInBlock());
row("a function, in another block", () => Replaced.callInOtherBlock());
row("a function, from outside", () => Replaced.f());
row("a class, in its block", () => Replaced.classInBlock());
row("a class, in another block", () => Replaced.classInOtherBlock());

namespace Holder {
  export enum Level { Low = "low" }
  export namespace Nested {
    export let value = "declared";
    export function read() { return value; }
  }
  export function levelKeys() { return keys(Level); }
  export function nestedValue() { return Nested.value; }
}
const nested = Holder.Nested;
(Holder as any).Level = { Stored: 1 };
(Holder as any).Nested = { value: "stored" };
row("an enum, in its block", () => Holder.levelKeys());
row("an enum, from outside", () => keys(Holder.Level));
row("a namespace, in its block", () => Holder.nestedValue());
row("a namespace, from outside", () => Holder.Nested.value);
row("a variable of the nested namespace", () => nested.read());

namespace Split { export namespace Part { export const a = 1; } export enum Kind { A = "a" } }
const firstPart = Split.Part;
const firstKind = Split.Kind;
(Split as any).Part = { stored: true };
(Split as any).Kind = { stored: true };
namespace Split { export namespace Part { export const b = 2; } export enum Kind { B = "b" } }
row("a later block extends the property", () => keys(Split.Part) + " " + keys(Split.Kind));
row("and not the first object", () => keys(firstPart) + " " + keys(firstKind));

namespace Outer.Middle.Inner { export const leaf = 1; }
namespace Outer.Middle { export const branch = 2; }
row("dotted names", () => [keys(Outer), keys(Outer.Middle), keys(Outer.Middle.Inner)].join(" "));
//// namespace-that-replaces-its-own-functions.ts
// A namespace that replaces one of its own functions at the first call, under a computed name, as assertion libraries do. Its other members are read as before.
function noop(_?: unknown): void {}
namespace Debug {
  export let level = 0;
  export let isDebugging = false;
  export let host: { log(text: string): void } | undefined;
  const cache: Partial<Record<"assertNode" | "assertEach", { assertion: unknown }>> = {};
  function shouldAssert(name: "assertNode" | "assertEach"): boolean {
    if (level < 1) {
      cache[name] = { assertion: Debug[name] };
      (Debug as any)[name] = noop;
      return false;
    }
    return true;
  }
  export function assertNode(node: unknown, message?: string): void {
    if (shouldAssert("assertNode") && !node) throw new Error(message ?? "no node");
  }
  export function assertEach(nodes: readonly unknown[], message?: string): void {
    if (shouldAssert("assertEach") && !nodes.every(Boolean)) throw new Error(message ?? "no nodes");
  }
}
interface Type { flags: number; id: number; checker?: object }
function Type(this: Type, checker: object, flags: number) {
  this.flags = flags;
  if (Debug.isDebugging || Debug.host) this.checker = checker;
}
const TypeConstructor = Type as unknown as new (checker: object, flags: number) => Type;
const checker = {};
let count = 0;
function createType(flags: number): Type {
  const type = new TypeConstructor(checker, flags);
  type.id = ++count;
  return type;
}
let sum = 0;
for (let round = 0; round < 2000000; round++) {
  const type = createType(round & 15);
  if (round === 10) { Debug.assertNode(type); Debug.assertEach([type]); }
  sum += type.flags + (type.checker ? 1 : 0);
}
console.log(sum, count, Debug.assertNode === noop, Debug.assertEach === noop, Debug.isDebugging, Object.keys(Debug).join());
Debug.isDebugging = true;
console.log(createType(3).checker === checker);
//// native-code-changes-objects-that-no-compiled-code-changes.ts
// Every field of these objects is filled at the allocation and no compiled statement deletes, redefines or stores another type to it.
// Only built-in functions do, each on an object of a class of its own.
function show(label: string, ...values: unknown[]) {
  console.log(label + ": " + values.map(value => (typeof value === "function" ? "function" : JSON.stringify(value) ?? String(value))).join(" | "));
}
function attempt(run: () => unknown): unknown {
  try {
    return run();
  } catch (error) {
    return "throws " + (error as Error).constructor.name;
  }
}

class ByReflectSet { count: number = 1; ratio: number = 0.5; on: boolean = true; }
class ByProxy { count: number = 1; ratio: number = 0.5; on: boolean = true; }
class ByAssign { count: number = 1; ratio: number = 0.5; on: boolean = true; }
class ByDelete { count: number = 1; ratio: number = 0.5; on: boolean = true; }
class ByDefine { count: number = 1; ratio: number = 0.5; on: boolean = true; }
class ByPush { count: number = 1; ratio: number = 0.5; on: boolean = true; }
class ByCapture { count: number = 1; ratio: number = 0.5; on: boolean = true; }
class ByDefineGetter { count: number = 1; ratio: number = 0.5; on: boolean = true; }
class ByEntries { count: number = 1; ratio: number = 0.5; on: boolean = true; }

function sum(object: { count: number; ratio: number; on: boolean }): number {
  let total = 0;
  for (let i = 0; i < 3; i++) total += object.count + object.ratio + (object.on ? 1 : 0);
  return total;
}
function describe(object: { count: number; ratio: number; on: boolean }): string {
  return Object.keys(object).join(",") + " ; " + String(object.count) + " " + String(object.ratio) + " " + String(object.on) + " ; " + String(sum(object));
}

{
  const object = new ByReflectSet();
  show("Reflect.set before", describe(object));
  show("Reflect.set", Reflect.set(object, "count", "text"), Reflect.set(object, "ratio", null), Reflect.set(object, "on", undefined));
  show("Reflect.set after", describe(object));
}
{
  const object = new ByProxy();
  const proxy = new Proxy(object, {}) as any;
  proxy.count = "text";
  proxy.ratio = { valueOf() { return 2; } };
  proxy.on = 0;
  proxy.added = 1;
  delete proxy.on;
  show("Proxy", describe(object), (object as any).added);
}
{
  const object = new ByAssign();
  Object.assign(object, JSON.parse('{"count":"text","ratio":null,"on":7,"added":[1]}'));
  show("Object.assign", describe(object), (object as any).added);
}
{
  const object = new ByDelete();
  show("Reflect.deleteProperty", Reflect.deleteProperty(object, "count"), Reflect.deleteProperty(object, "on"), describe(object), "count" in object, Object.hasOwn(object, "on"));
}
{
  const object = new ByDefine();
  Object.defineProperty(object, "count", { get() { return 41; }, enumerable: false, configurable: true });
  Object.defineProperty(object, "ratio", { value: 3, writable: false });
  Object.defineProperties(object, { on: { value: "yes" }, 0: { get() { return "index"; }, configurable: true } });
  show("Object.defineProperty", describe(object), attempt(() => { "use strict"; object.ratio = 4; return object.ratio; }), (object as any)[0]);
}
{
  const object = new ByPush();
  show("Array.prototype.push", Array.prototype.push.call(object, "first", "second"), describe(object), (object as any)[1], (object as any).length);
}
{
  const object = new ByCapture();
  Error.captureStackTrace(object);
  show("Error.captureStackTrace", typeof (object as any).stack, Object.keys(object).join(","), Object.getOwnPropertyNames(object).includes("stack"), sum(object));
}
{
  const object = new ByDefineGetter() as any;
  object.__defineGetter__("count", () => 5);
  object.__defineSetter__("on", function (this: any, value: unknown) { this.seen = value; });
  object.on = "stored";
  show("__defineGetter__", describe(object), object.seen);
}
{
  const object = new ByEntries();
  for (const [key, value] of Object.entries({ count: -0, ratio: NaN, on: null })) Reflect.set(object, key, value);
  show("numbers", Object.is(object.count, -0), object.ratio, object.on, describe(object));
  for (const value of [2 ** 31, -(2 ** 31), -(2 ** 31) + 1, -(2 ** 31) + 4, -(2 ** 31) + 5, 2 ** 31 - 1, 0.5, Infinity]) {
    Reflect.set(object, "count", value);
    show("count", object.count, object.count + 1);
  }
}
//// nodes-that-their-factories-finish.ts
// One constructor function makes every node; a factory behind it stores the fields of its kind. A node is finished where its factory has stored the last of them.
// Here are the factories that do, and those that let a node out too early, fill it on one way only, fill it with what does not fit, or copy it name by name.
declare const console: { log(...values: unknown[]): void };

const lines: string[] = [];
function say(label: string, value: unknown) {
  lines.push(label + ": " + (typeof value === "string" ? value : JSON.stringify(value, (_, v) => v === undefined ? "#undefined" : typeof v === "function" ? "#function" : v)));
}

const enum Kind { Add = 1, Literal = 2, Group = 3, Negate = 4 }
interface Node { kind: Kind; pos: number; end: number; flags: number; parent: Node | undefined; }
interface AddNode extends Node { kind: Kind.Add; left: Expression; right: Expression; }
interface LiteralNode extends Node { kind: Kind.Literal; value: number; }
interface GroupNode extends Node { kind: Kind.Group; body: Expression; name: string; }
interface NegateNode extends Node { kind: Kind.Negate; operand: Expression; }
type Expression = AddNode | LiteralNode | GroupNode | NegateNode;
type Mutable<T> = { -readonly [K in keyof T]: T[K] };

function NodeObject(this: Mutable<Node>, kind: Kind, pos: number, end: number) {
  this.pos = pos; this.end = end; this.kind = kind; this.flags = 0; this.parent = undefined;
}
const objectAllocator = { getNodeConstructor: () => NodeObject as any as new (kind: Kind, pos: number, end: number) => Node };
let NodeConstructor: (new (kind: Kind, pos: number, end: number) => Node) | undefined;
function createBaseNode<T extends Node>(kind: T["kind"]): Mutable<T> {
  return new (NodeConstructor || (NodeConstructor = objectAllocator.getNodeConstructor()))(kind, -1, -1) as Mutable<T>;
}
function createBaseNodeAt<T extends Node>(kind: T["kind"], pos: any, end: any): Mutable<T> {
  return new (NodeConstructor || (NodeConstructor = objectAllocator.getNodeConstructor()))(kind, pos, end) as Mutable<T>;
}
function createLiteral(value: number): LiteralNode { const node = createBaseNode<LiteralNode>(Kind.Literal); node.value = value; return node; }
function createAdd(left: Expression, right: Expression): AddNode { const node = createBaseNode<AddNode>(Kind.Add); node.left = left; node.right = right; return node; }
function createGroup(body: Expression, name: string): GroupNode { const node = createBaseNode<GroupNode>(Kind.Group); node.body = body; node.name = name; return node; }
function createNegate(operand: Expression): NegateNode { const node = createBaseNode<NegateNode>(Kind.Negate); node.operand = operand; return node; }

// What typed code reads of a node.
function describe(node: Expression | undefined): unknown {
  if (!node) return "none";
  switch (node.kind) {
    case Kind.Add: return ["add", node.pos, node.end, node.flags, describeShallow(node.left), describeShallow(node.right)];
    case Kind.Literal: return ["literal", node.pos, node.end, node.flags, node.value];
    case Kind.Group: return ["group", node.pos, node.end, node.flags, describeShallow(node.body), node.name];
    case Kind.Negate: return ["negate", node.pos, node.end, node.flags, describeShallow(node.operand)];
  }
  return ["other", (node as any).kind];
}
function describeShallow(node: Expression | undefined): unknown { return node ? node.kind : node; }
function keysOf(node: object) { return Object.keys(node).join(); }
function evaluate(node: Expression): number {
  switch (node.kind) {
    case Kind.Add: return evaluate(node.left) + evaluate(node.right);
    case Kind.Literal: return node.value;
    case Kind.Group: return evaluate(node.body);
    case Kind.Negate: return -evaluate(node.operand);
  }
}

// The plain factories, often.
{
  let total = 0;
  for (let i = 0; i < 3000; i++) total += evaluate(createAdd(createLiteral(i), createNegate(createGroup(createLiteral(i >> 1), "g" + (i & 3)))));
  say("plain", total);
  const one = createAdd(createLiteral(1), createLiteral(2));
  say("one", [describe(one), keysOf(one), describe(one.left), keysOf(one.left)]);
}

// A node that gets out before it is filled.
const seen: unknown[] = [];
let held: Expression | undefined;
function look(node: Expression) { held = node; seen.push(describe(node), keysOf(node), "left" in node, (node as any).right === undefined); }
function createAddSeenEarly(left: Expression, right: Expression): AddNode {
  const node = createBaseNode<AddNode>(Kind.Add);
  look(node);
  node.left = left;
  look(node);
  node.right = right;
  look(node);
  return node;
}
{
  for (let i = 0; i < 300; i++) { seen.length = 0; createAddSeenEarly(createLiteral(i), createLiteral(i + 1)); }
  say("seen early", seen);
  say("held", [describe(held), evaluate(held!)]);
}

// One way fills, the other does not.
function createAddPerhaps(left: Expression, right: Expression | undefined): AddNode {
  const node = createBaseNode<AddNode>(Kind.Add);
  node.left = left;
  if (right) node.right = right;
  return node;
}
{
  const out: unknown[] = [];
  for (let i = 0; i < 300; i++) { const node = createAddPerhaps(createLiteral(i), i % 3 ? createLiteral(1) : undefined); if (i > 295) out.push(describe(node), keysOf(node), "right" in node); }
  say("perhaps", out);
  const late = createAddPerhaps(createLiteral(5), undefined);
  (late as Mutable<AddNode>).right = createLiteral(6);
  say("filled later", [describe(late), keysOf(late), evaluate(late)]);
}

// What does not fit: in the maker's own fields, and in the factory's.
function createLiteralAt(value: any, pos: any, end: any): LiteralNode { const node = createBaseNodeAt<LiteralNode>(Kind.Literal, pos, end); node.value = value; return node; }
{
  const out: unknown[] = [];
  const odd: any[] = [[1, 2, 3], [1.5, 2, 3], ["text", 2, 3], [1, "pos", 3], [1, 2, undefined], [undefined, 2, 3], [null, null, null], [1, 2.5, 1e20], [{ valueOf() { return 9; } }, 2, 3]];
  for (let round = 0; round < 100; round++) for (const [value, pos, end] of odd) { const node = createLiteralAt(value, pos, end); if (round === 99) out.push(describe(node), keysOf(node)); }
  say("what does not fit", out);
  const add: any = createAdd(createLiteral(1), createLiteral(2));
  const wrong = createAdd("left" as any, 7 as any);
  say("no nodes", [describe(wrong), keysOf(wrong), typeof (wrong as any).left]);
  add.left = "now text"; say("text later", [describe(add), keysOf(add)]);
}

// A factory that throws on its way, and one whose node is caught by a closure.
function createAddOrThrow(left: Expression, right: Expression, fail: boolean, keep: (node: AddNode) => void): AddNode {
  const node = createBaseNode<AddNode>(Kind.Add);
  node.left = left;
  if (fail) { keep(node); throw new Error("no"); }
  node.right = right;
  return node;
}
{
  let kept: AddNode | undefined, thrown = 0;
  for (let i = 0; i < 300; i++) { try { createAddOrThrow(createLiteral(i), createLiteral(i), i % 50 === 49, node => { kept = node; }); } catch { thrown++; } }
  say("thrown", [thrown, describe(kept), keysOf(kept!), "right" in kept!]);
}

// A copy name by name, as a tree is cloned.
function clone<T extends Expression>(node: T): T {
  const copy = createBaseNode<T>(node.kind as T["kind"]) as any;
  for (const key in node) { if (Object.hasOwn(copy, key) || !Object.hasOwn(node, key)) continue; copy[key] = (node as any)[key]; }
  return copy;
}
{
  let total = 0;
  const source = createAdd(createGroup(createLiteral(4), "inner"), createNegate(createLiteral(3)));
  for (let i = 0; i < 300; i++) total += evaluate(clone(source)) + evaluate(clone(source.left)) + evaluate(clone(source.right));
  say("clones", [total, describe(clone(source)), keysOf(clone(source)), describe(clone(source.left)), keysOf(clone(source.left))]);
}

// The fields in another order, a kind that only the run knows, the constructor reached in other ways.
function createAddBackwards(left: Expression, right: Expression): AddNode { const node = createBaseNode<AddNode>(Kind.Add); node.right = right; node.left = left; return node; }
function createOfKind(kind: Kind): Node { return createBaseNode<Node>(kind); }
{
  const backwards = createAddBackwards(createLiteral(1), createLiteral(2));
  say("backwards", [describe(backwards), keysOf(backwards), evaluate(backwards)]);
  const bare = [1, 2, 3, 4, 5, 0].map(kind => createOfKind(kind as Kind));
  say("bare", bare.map(node => [describe(node as Expression), keysOf(node)]));
  const reflected = Reflect.construct(NodeObject, [Kind.Add, 1, 2]) as AddNode;
  say("reflected", [describe(reflected), keysOf(reflected)]);
  const called: any = { own: true }; (NodeObject as any).call(called, Kind.Literal, 3, 4);
  say("called", [describe(called), keysOf(called)]);
  class Below extends (NodeObject as any as new (kind: Kind, pos: number, end: number) => Node) { extra = 1; }
  const below: any = new Below(Kind.Negate, 5, 6);
  say("below", [describe(below), keysOf(below)]);
}

console.log(lines.join("\n"));
