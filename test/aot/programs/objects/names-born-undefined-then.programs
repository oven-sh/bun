function sum(wide: Wide | undefined | null): number {
  return wide!.f2050 + wide!.f1;
}

for (const wide of [new Wide(), undefined, null, new Wide()]) {
  try {
    console.log(sum(wide));
  } catch (error) {
    console.log(error instanceof TypeError);
  }
}
//// number-fields-and-stores-under-their-names-into-what-has-no-field.ts
// Which number fields get an int32 slot. Every field below only ever holds small integers.
// 4: what the operation that fills a field says.
class ByAnd { head = 0; next() { this.head = (this.head + 1) & 7; return this.head; } }
class ByMod { head = 0; size = 8; next() { this.head = (this.head + 1) % this.size; return this.head; } }
class ByModOr { head = 0; size = 8; next() { this.head = ((this.head + 1) % this.size) | 0; return this.head; } }
class ByMul { child = 0; down(i: number) { this.child = i * 2 + 1; return this.child; } }
class ByShift { child = 0; down(i: number) { this.child = (i << 1) + 1; return this.child; } }
class ByNegate { delta = 1; flip() { this.delta = -this.delta; return this.delta; } }
class ByCode { code = 0; read(text: string, i: number) { this.code = text.charCodeAt(i); return this.code; } }
class ByIndexOf { at = 0; find(text: string, part: string) { this.at = text.indexOf(part); return this.at; } }
class ByFloor { half = 0; halve(n: number) { this.half = Math.floor(n / 2); return this.half; } }
class ByMin { least = 0; take(a: number, b: number) { this.least = Math.min(a, b); return this.least; } }
class ByLength { chars = 0; items = 0; count(text: string, list: number[]) { this.chars = text.length; this.items = list.length; return this.chars + this.items; } }

// 3: a store under the same name into what can have no such field.
type OnFunction = { mark: number; other: number };
type OnArray = { spot: number; other: number };
type OnError = { place: number; other: number };
function tagged() { return 1; }
tagged.mark = 1.5;
const listWithName: number[] & { spot?: number } = [1, 2, 3];
listWithName.spot = 1.5;
const failure: Error & { place?: number } = new Error("x");
failure.place = 1.5;

const section = process.argv[2] ?? "all";
const rounds = section === "all" ? 10 : 20_000_000;
function run(name: string, body: (i: number) => number) {
  if (section !== "all" && section !== name) return;
  let total = 0;
  for (let i = 0; i < rounds; i++) total += body(i & 1023);
  console.log(name, total);
}

const byAnd = new ByAnd(), byMod = new ByMod(), byModOr = new ByModOr(), byMul = new ByMul(), byShift = new ByShift(), byNegate = new ByNegate();
const byCode = new ByCode(), byIndexOf = new ByIndexOf(), byFloor = new ByFloor(), byMin = new ByMin(), byLength = new ByLength();
const text = "the quick brown fox jumps over the lazy dog".repeat(30);
const numbers = [1, 2, 3, 4];
const kept: unknown[] = [byAnd, byMod, byModOr, byMul, byShift, byNegate, byCode, byIndexOf, byFloor, byMin, byLength];

const onFunction: OnFunction[] = [], onArray: OnArray[] = [], onError: OnError[] = [];
for (let i = 0; i < 1024; i++) {
  onFunction.push({ mark: i, other: i });
  onArray.push({ spot: i, other: i });
  onError.push({ place: i, other: i });
}

run("and", () => byAnd.next());
run("mod", () => byMod.next());
run("modOr", () => byModOr.next());
run("mul", i => byMul.down(i));
run("shift", i => byShift.down(i));
run("negate", () => byNegate.flip());
run("code", i => byCode.read(text, i));
run("indexOf", () => byIndexOf.find("abc", "c"));
run("floor", i => byFloor.halve(i));
run("min", i => byMin.take(i, 7));
run("length", () => byLength.count(text, numbers));
run("mark", i => onFunction[i].mark);
run("markOther", i => onFunction[i].other);
run("spot", i => onArray[i].spot);
run("place", i => onError[i].place);
console.log(kept.length, tagged.mark, listWithName.spot, failure.place);
//// number-keys.ts
// Numbers as keys of Maps and Sets and as array indices: -0 is the key 0, and whole-number doubles equal integers.
const ks: number[] = ["0", "-0", "1", "-1", "7", "2147483647", "2147483648", "-2147483648", "-2147483649", "4294967295", "4294967296", "0.5", "-0.5", "1e21", "NaN", "Infinity", "-Infinity", "5e-324"].map(Number)
const m = new Map<number, string>(), s = new Set<number>()
const put = (k: number, v: string) => { m.set(k, v); s.add(k) }
const got = (k: number) => m.get(k) + "/" + m.has(k) + "/" + s.has(k)
ks.forEach((k, i) => put(k, "v" + i))
console.log(m.size, s.size, ks.map(got).join(" "))
console.log([...m.keys()].map(k => Object.is(k, -0) ? "-0" : String(k)).join(), [...s].map(k => Object.is(k, -0) ? "-0" : String(k)).join())
const half = (k: number) => k / 2
console.log(got(half(2)), got(half(0)), got(half(-0)), got(half(1)), got(half(14)), got(half(3)), got(0 / 0), got(-(0 / 0)))
const loose: any = m
console.log(loose.get(0), loose.get(-0), loose.get(1), loose.get(2147483648), loose.get(NaN), loose.get(0.5), loose.get("1"))
console.log(m.delete(half(-0)), m.has(0), m.delete(half(2)), m.has(1), m.delete(half(5)), m.size)
const a: string[] = ["a", "b", "c"]
const at = (k: number) => String(a[k])
console.log(ks.map(at).join(), at(half(2)), at(half(4)), at(half(-0)), at(half(1)), at(half(6)))
const set = (k: number, v: string) => { a[k] = v }
set(half(2), "B"); set(half(-0), "A"); set(half(8), "E"); set(half(1), "fraction"); set(-1, "minus")
console.log(a.join(), a.length, Object.keys(a).join())
//// numbers-and-booleans-stored-late-are-read-while-the-object-changes.ts
// A number or a boolean that is stored once the object is out in the world, or never, read by typed code.
// What a filled slot holds is the answer, whatever has become of the other members and whatever lies above the object: a number, a boolean, undefined or null.
// An empty one is undefined only while nothing above the object has the name and the member lies nowhere else.
declare const console: { log(...values: unknown[]): void };

const lines: string[] = [];
function say(label: string, value: unknown) {
  lines.push(label + ": " + (typeof value === "string" ? value : JSON.stringify(value, (_, v) => v === undefined ? "#undefined" : typeof v === "function" ? "#function" : Object.is(v, -0) ? "#-0" : typeof v === "number" && v !== v ? "#NaN" : v)));
}

interface Links { id: number; flags?: number; ratio?: number; seen?: boolean; done?: boolean | null; depth?: number | null; }
const Links = function (this: Links, id: number) { this.id = id; } as unknown as new (id: number) => Links;

// What is done to the objects from outside is done under names that only the run knows.
const names = ["flags", "ratio", "seen", "done", "depth", "id"];
function nameAt(index: number): string { return names[index % names.length]; }
function redefine(object: any, index: number, descriptor: PropertyDescriptor) { Object.defineProperty(object, nameAt(index), descriptor); }
function remove(object: any, index: number) { delete object[nameAt(index)]; }
function put(object: any, index: number, value: unknown) { object[nameAt(index)] = value; }
const FLAGS = 0, RATIO = 1, SEEN = 2, DONE = 3, DEPTH = 4;

// Each reads one late member of its argument, as a checker's small functions do.
function flagsOf(links: Links): number { const flags = links.flags; if (flags !== undefined) return flags; return -1; }
function ratioOf(links: Links): number | undefined { return links.ratio; }
function isSeen(links: Links): boolean { if (links.seen) return true; return false; }
function seenOf(links: Links): boolean | undefined { return links.seen; }
function doneOf(links: Links): boolean | null | undefined { return links.done; }
function depthOf(links: Links): number { return links.depth ?? -7; }
function depthAsItIs(links: Links): number | null | undefined { return links.depth; }
function mark(links: Links): number { return links.flags === undefined ? (links.flags = links.id & 7) : links.flags; }
function show(links: Links) { return [flagsOf(links), ratioOf(links), isSeen(links), seenOf(links), doneOf(links), depthOf(links), depthAsItIs(links)]; }

const all: Links[] = [];
for (let i = 0; i < 400; i++) {
  const links = new Links(i);
  all.push(links);
  if (i % 2) links.flags = i * 3;
  if (i % 3 === 0) links.ratio = i / 4;
  if (i % 5 === 0) links.seen = i % 10 === 0;
  if (i % 7 === 0) links.done = i % 14 === 0 ? null : true;
  if (i % 11 === 0) links.depth = i % 22 === 0 ? null : i;
}
function tally() {
  let t = 0;
  for (const links of all) t += flagsOf(links) + (ratioOf(links) ?? 0.5) + (isSeen(links) ? 2 : 1) + (doneOf(links) === null ? 5 : doneOf(links) ? 7 : 0) + depthOf(links);
  return t;
}
for (let round = 0; round < 40; round++) tally();
say("tally", tally());
say("some", [0, 1, 3, 5, 7, 10, 11, 14, 22, 35, 77, 385].map(i => show(all[i])));
say("mark", [mark(all[2]), mark(all[2]), mark(all[3]), Object.keys(all[2]).join()]);

// undefined and null stored: the member is there and holds them.
{
  const a = new Links(1000), b = new Links(1001), c = new Links(1002);
  a.flags = undefined; a.ratio = undefined; a.seen = undefined; a.done = undefined; a.depth = undefined;
  put(b, FLAGS, null); put(b, RATIO, null); put(b, SEEN, null); b.done = null; b.depth = null;
  say("undefined stored", [show(a), "flags" in a, Object.keys(a).join(), Object.hasOwn(a, "seen")]);
  say("null stored", [show(b), "flags" in b, Object.keys(b).join(), (b as any).flags === null, (b as any).seen === null]);
  say("nothing stored", [show(c), "flags" in c, Object.keys(c).join(), Object.hasOwn(c, "seen")]);
  a.flags = 9; a.seen = true; a.ratio = -0; a.depth = 0; say("then filled", [show(a), Object.keys(a).join()]);
}
// One member leaves its slot: the others are read as before, and it is read where it lies now.
{
  const a = new Links(2000); a.flags = 5; a.ratio = 1.5; a.seen = false; a.done = true; a.depth = 3;
  let reads = 0;
  redefine(a, FLAGS, { get() { reads++; return 77; }, configurable: true, enumerable: true });
  say("an accessor for one", [show(a), show(a), reads]);
  redefine(a, SEEN, { value: true, writable: false, configurable: true });
  say("a constant for another", [show(a), Object.getOwnPropertyDescriptor(a, "seen")]);
  remove(a, RATIO); remove(a, FLAGS); say("deleted", [show(a), Object.keys(a).join()]);
  a.flags = 6; a.ratio = 2.25; say("stored again", [show(a), Object.keys(a).join()]);
  const empty = new Links(2001);
  redefine(empty, DEPTH, { get() { return 41; }, configurable: true });
  redefine(empty, SEEN, { get() { return true; }, configurable: true });
  say("accessors where nothing was", show(empty));
  const frozen = Object.freeze(new Links(2002)); say("frozen and empty", show(frozen));
  const full = new Links(2003); full.flags = 8; full.seen = true; say("frozen and filled", show(Object.freeze(full)));
}
// Other values than the types allow.
{
  const a = new Links(3000); a.flags = 1; a.seen = true; a.ratio = 0.5; a.depth = 2;
  put(a, FLAGS, "text"); say("a string for the number", [show(a), typeof (a as any).flags]);
  put(a, SEEN, 1); say("a number for the boolean", [show(a), typeof (a as any).seen]);
  put(a, RATIO, { valueOf() { return 4; } }); say("an object for the number", [typeof ratioOf(a), isSeen(a), depthOf(a)]);
  put(a, DEPTH, true); say("a boolean for the number", show(a).slice(5));
  const b = new Links(3001);
  put(b, FLAGS, 2 ** 31); put(b, DEPTH, -(2 ** 31)); put(b, RATIO, NaN); say("numbers at the edges", show(b));
  put(b, FLAGS, -2147483647); put(b, DEPTH, -2147483646); say("numbers where markers may lie", show(b));
  put(b, FLAGS, 0.5); put(b, DEPTH, -0); put(b, RATIO, Infinity); say("fractions", show(b));
  put(b, FLAGS, 10n); say("a bigint", [typeof (b as any).flags, String(flagsOf(b))]);
}
// The name arrives above the object: an empty slot finds it, a filled one hides it.
{
  const filled = new Links(4000); filled.flags = 3; filled.seen = false; filled.depth = null;
  const empty = new Links(4001);
  say("before", [show(filled), show(empty)]);
  put(Links.prototype, FLAGS, 1234); put(Links.prototype, SEEN, true);
  say("on the prototype", [show(filled), show(empty), tally()]);
  redefine(Links.prototype, DEPTH, { get(this: Links) { return this.id; }, configurable: true });
  say("an accessor on the prototype", [show(filled), show(empty)]);
  remove(Links.prototype, FLAGS); remove(Links.prototype, SEEN); remove(Links.prototype, DEPTH);
  say("gone again", [show(filled), show(empty), tally()]);
  const other = Object.setPrototypeOf(new Links(4002), { flags: 55, seen: true, done: null });
  say("another prototype", show(other));
  const none = Object.setPrototypeOf(new Links(4003), null); none.seen = true;
  say("no prototype", show(none));
}
// A namespace that replaces one of its own functions under a computed name: its variables are read as before.
namespace Debug {
  export let level = 0;
  export let isDebugging = false;
  export let limit: number | undefined;
  export function check(value: unknown): void { if (level < 1) (Debug as any)[["check"][0]] = quiet; else if (!value) throw new Error("no value"); }
}
function quiet(): void {}
function debugging(): number { return (Debug.isDebugging ? 1 : 0) + (Debug.limit ?? 10) + Debug.level; }
{
  let t = 0;
  for (let i = 0; i < 3000; i++) { if (i === 100) Debug.check(i); if (i === 2000) Debug.limit = 20; if (i === 2500) Debug.isDebugging = true; t += debugging(); }
  say("namespace", [t, Debug.check === quiet, Object.keys(Debug).join()]);
  delete (Debug as any)[["limit"][0]]; say("a variable deleted", debugging());
  Object.defineProperty(Debug, ["isDebugging"][0], { get() { return false; }, configurable: true }); say("a variable redefined", debugging());
}
console.log(lines.join("\n"));
//// numeric-define-property.ts
declare const console: { log(...values: unknown[]): void };
function show(v: unknown): string { return typeof v + ":" + (Object.is(v, -0) ? "-0" : String(v)); }
function literal(x: number, y: number): { [name: string]: unknown } { return { a: x, b: x * 0.5, c: x + y, d: y / x, e: -x, f: Math.sqrt(y), g: "text", h: x }; }
function withSpread(base: { [name: string]: unknown }, x: number): { [name: string]: unknown } { return { ...base, a: x * 2, z: x / 3 }; }
function computed(name: string, x: number): { [name: string]: unknown } { return { [name]: x * 1.5, fixed: x * 0.25 }; }
function anything(x: number): unknown { const made: any = { first: x }; made.second = x * 0.5; made.third = x - 0.5; return made; }
class Holder { [name: string]: unknown; constructor(x: number) { this.one = x * 3; this.two = x / 7; } }
function inLoop(xs: number[]): { [name: string]: unknown }[] { const made: { [name: string]: unknown }[] = []; for (let i = 0; i < xs.length; i++) made.push({ index: i, value: xs[i], half: xs[i] / 2 }); return made; }
function tell(o: unknown): string { const record = o as { [name: string]: unknown }; return Object.keys(record).map(k => k + "=" + show(record[k])).join(" ") + " " + JSON.stringify(o); }
const given = [0, -0, 1, -1, 2.5, 1e21, -1e-7, 2147483647, 2147483648, -2147483648, -2147483649, 4294967296, NaN, Infinity, -Infinity, 0.1];
for (let turn = 0; turn < 2; turn++) {
    for (const x of given) {
        for (const y of [1, 0, 2.25, NaN])
            console.log(show(x) + " " + show(y) + ": " + tell(literal(x, y)));
        console.log(tell(withSpread({ a: "old", k: 1 }, x)) + " | " + tell(computed("n" + turn, x)) + " | " + tell(anything(x)) + " | " + tell(new Holder(x)));
    }
    console.log(inLoop(given).map(tell).join(" ; "));
}
//// object-assign-is-observable.ts
// `Object.assign` is an ordinary call: its getters, setters and order of evaluation are observable.
declare const console: any;
const show = (o: any) => JSON.stringify([Object.keys(o), Object.getOwnPropertyNames(o), Object.getPrototypeOf(o) === Object.prototype, o]);
console.log("defineProperties", show(Object.defineProperties({ a: 1 }, { b: { value: 2, enumerable: true } })));
console.log("defineProperties hidden", show(Object.defineProperties({ a: 1 }, { b: { value: 2 } })));
console.log("setPrototypeOf", show(Object.setPrototypeOf({ a: 1 }, { b: 2 })));
console.log("defineProperty", show(Object.defineProperty({ a: 1 }, "b", { value: 2, enumerable: true })));
console.log("assign", show(Object.assign({ a: 1 }, { b: 2 })));
interface P { x: number }
const laid: P = { x: 5 };
console.log("assign laid", show(Object.assign({ a: 1 }, laid)));
console.log("setPrototypeOf laid", show(Object.setPrototypeOf({ a: 1 }, laid)));
const proto: { v: number } = JSON.parse('{"__proto__": {"inherited": 1}, "v": 2}');
const got = Object.assign({ a: 1 }, proto);
console.log("__proto__", Object.getOwnPropertyNames(got).join(), (got as any).inherited, Object.getPrototypeOf(got) === Object.prototype);
let n = 0;
const r = (n++, Object).assign({ a: 1 }, { b: 2 });
console.log("receiver", n, show(r));
const mine: typeof Object.assign = ((target: any) => target) as any;
console.log("mine", show(mine({ a: 1 }, { b: 2 })));
const order: string[] = [];
const o2 = Object.assign({ a: (order.push("a"), 1) }, (order.push("s1"), { b: 2 }), { c: (order.push("c"), 3) });
console.log("order", order.join(), show(o2));
const withGetter = { get g() { order.push("get"); return 7; } };
console.log("getter source", show(Object.assign({ a: 1 }, withGetter)), order.join());
//// object-constructed-or-called-without-arguments-makes-what-an-empty-literal-makes.js
const lines = [];
const say = (...parts) => lines.push(parts.join(" "));

function describe(made) {
  return [
    Object.getPrototypeOf(made) === Object.prototype,
    made.constructor === Object,
    made instanceof Object,
    Object.keys(made).join(),
    JSON.stringify(made),
    Object.isExtensible(made),
    Object.prototype.toString.call(made),
  ].join(" ");
}

say("constructed", describe(new Object()));
say("constructed without a list", describe(new Object));
say("called", describe(Object()));
say("each is new", new Object() !== new Object(), Object() !== Object());

const filled = new Object();
filled.first = 1;
filled["second"] = "two";
filled[3] = true;
filled[Symbol.for("fourth")] = 4;
say("filled", describe(filled), Reflect.ownKeys(filled).map(String).join());
delete filled.first;
say("emptied", describe(filled));

const called = Object();
Object.defineProperty(called, "hidden", { value: 1 });
Object.defineProperty(called, "twice", { get() { return this.hidden * 2; }, enumerable: true });
say("defined", describe(called), called.twice);
say("frozen", Object.isFrozen(Object.freeze(new Object())));

const kept = [];
for (let i = 0; i < 5; i++) {
  const made = i & 1 ? new Object() : Object();
  made.index = i;
  if (i > 2) made.late = true;
  kept.push(made);
}
say("kept", JSON.stringify(kept));

say("with an argument", new Object(1) instanceof Number, typeof Object("text"), Object(filled) === filled, new Object(filled) === filled);
say("with nothing for an argument", describe(new Object(undefined)), describe(Object(null)));
say("with a list", describe(new Object(...[])), new Object(...[filled]) === filled);
say("asked whether it is there", describe(Object?.()));

function shadowedByAParameter(Object) {
  return [new Object().mark, Object().mark].join();
}
say("another function under the name", shadowedByAParameter(function () { return { mark: "mine" }; }));
{
  class Object {
    mark = "a class of the program";
  }
  say("a class under the name", new Object().mark);
}

////= lines-162	Below	Object	stamp	7
say("a class below", new Below().stamp, new Below() instanceof Below, Reflect.construct(Object, [], Below) instanceof Below);

const above = new Object();
above.inherited = "from above";
say("as a prototype", Object.create(above).inherited, Object.setPrototypeOf(new Object(), above).inherited);

console.log(lines.join("\n"));
//// object-create-from-many-prototypes.js
const makers = [];
for (let n = 0; n < 40; n++) {
  const proto = { ["tag" + n]: n, which() { return n; } };
  makers.push(value => {
    const self = Object.create(proto);
    self.value = value;
    return self;
  });
}
const collect = globalThis.gc ?? (() => globalThis.Bun.gc(true));
let sum = 0;
const kept = [];
for (let round = 0; round < 2000; round++) {
  const made = makers[round % 40](round);
  if (Object.getPrototypeOf(made).which() !== round % 40) throw new Error("wrong prototype");
  if (made["tag" + (round % 40)] !== round % 40) throw new Error("wrong inherited value");
  sum += made.value + made.which();
  if (round % 97 === 0) kept.push(made);
  if (round % 500 === 0) collect();
}
console.log(sum, kept.length, kept.map(made => made.which()).join());
console.log(Object.keys(Object.create({ a: 1 })).length, Object.create(null) instanceof Object);
//// object-create-null-then-stores.js
// Object.create(null), alone and beside other prototypes, followed by stores of constant names.
function table(a, b, c) {
  const o = Object.create(null)
  o.first = a
  o.second = b
  o.third = c
  return o
}
function wide(n) {
  const o = Object.create(null)
  o.a = n; o.b = n + 1; o.c = n + 2; o.d = n + 3; o.e = n + 4; o.f = n + 5; o.g = n + 6; o.h = n + 7; o.i = n + 8
  return o
}
function under(prototype) { return Object.create(prototype) }
function show(o) { return Object.keys(o).join() + " " + JSON.stringify(o) + " " + (Object.getPrototypeOf(o) === null) }

console.log(show(table(1, "two", null)), show(wide(10)), show(Object.create(null)))

const bare = table(1, 2, 3)
console.log("toString" in bare, "first" in bare, bare.toString, bare.hasOwnProperty, typeof bare, bare instanceof Object)
bare.__proto__ = { inherited: 1 }
console.log(Object.keys(bare).join(), Object.getPrototypeOf(bare), bare.inherited)

const base = { inherited: "yes" }
const prototypes = [null, base, null, Array.prototype, null, Object.prototype, function () {}]
console.log(prototypes.map(p => { const o = under(p); return (Object.getPrototypeOf(o) === p) + ":" + o.inherited + ":" + Object.keys(o).length }).join(" "))

for (const wrong of [undefined, 1, "text", true, Symbol.iterator, 10n]) {
  try { under(wrong); console.log("no error") } catch (error) { console.log(error.constructor.name) }
}

let kept = []
let sum = 0
for (let n = 0; n < 200000; n++) {
  const o = n & 1 ? table(n, n + 0.5, kept) : wide(n)
  if (n % 20000 === 0) kept.push(o)
  sum += n & 1 ? o.second : o.i
  if (Object.getPrototypeOf(o) !== null) sum = NaN
}
console.log(sum, kept.length, kept.map(o => Object.keys(o).length).join())

const frozen = Object.freeze(Object.create(null))
try { (function () { "use strict"; frozen.x = 1 })() } catch (error) { console.log(error.constructor.name) }
console.log(Object.keys(frozen).length, Object.isFrozen(frozen))
//// object-create-returned-at-once.ts
// `return Object.create(p)`: in strict code the call stands in tail position. What it makes is the object that `const made = Object.create(p); return made` makes:
// with accessors defined on it later, as a dictionary, below null, below a function, and with the TypeError of the built-in for what is no prototype.
interface Sized { size: number }
function create(p: object | null): any { return Object.create(p); }
function createTyped(p: object | null): Sized { return Object.create(p); }
function createKept(p: object | null): any { const made = Object.create(p); return made; }
const createArrow = (p: any) => Object.create(p);
class Factory { base = { inherited: 1 }; make(): any { return Object.create(this.base); } }

function describe(made: any): string {
  const names: string[] = [];
  for (const name in made) names.push(name);
  return JSON.stringify([Object.keys(made), names, Object.getPrototypeOf(made) === null ? "null" : typeof Object.getPrototypeOf(made), made.size, made.inherited]);
}

const proto = { inherited: 1 };
for (let round = 0; round < 3; round++) {
  for (const make of [create, createTyped, createKept, createArrow]) {
    const withGetter = make(proto);
    let reads = 0;
    Object.defineProperty(withGetter, "size", { get() { return ++reads + round; }, enumerable: true, configurable: true });
    const withValues = make(proto);
    withValues.size = round; withValues["key" + round] = true;
    const belowNull = make(null);
    belowNull.size = "none";
    const belowFunction = make(describe);
    console.log(round, make.name, describe(withGetter), withGetter.size, reads, describe(withValues), describe(belowNull), "toString" in belowNull, typeof belowFunction.call, describe(make(withGetter)));
    delete withGetter.size;
    console.log(describe(withGetter), Object.isExtensible(withGetter), withGetter instanceof Object, belowNull instanceof Object);
  }
  console.log(describe(new Factory().make()));
}
for (const make of [create, createTyped, createKept, createArrow]) {
  for (const wrong of [undefined, 1, "text", true, Symbol.iterator] as any[]) {
    try { make(wrong); console.log("made"); } catch (error) { console.log(make.name, typeof wrong, (error as Error).constructor.name, (error as Error).message); }
  }
}
//// object-create-stores-under-changing-prototype.js
// Adjacent stores to an object created under a prototype, while setters and read-only properties come and go along its chain.
"use strict";
const base = { inherited: 0 };
let seen = [];
let created;

function fill(n) {
  const o = Object.create(base);
  created = o;
  o.a = n;
  o.b = n + 1;
  o.c = n + 2;
  o.d = n + 3;
  return o;
}
function show(what) {
  let errors = 0;
  for (let n = 0; n < 300; n++) {
    try {
      fill(n);
    } catch (error) {
      if (!(error instanceof TypeError)) throw error;
      errors++;
    }
  }
  console.log(what, Object.keys(created).join(), JSON.stringify(created), created.b, created.c, errors, seen.length, seen[seen.length - 1]);
  seen = [];
}

show("nothing inherited");
Object.defineProperty(base, "c", { set(value) { seen.push(value); }, configurable: true });
show("inherited setter");
delete base.c;
show("setter deleted");
Object.defineProperty(base, "b", { value: "fixed", writable: false, configurable: true });
show("inherited read-only property");
Object.defineProperty(base, "b", { value: "loose", writable: true });
show("inherited writable property");
const above = { set d(value) { seen.push(-value); } };
Object.setPrototypeOf(base, above);
show("setter above the prototype");
delete above.d;
show("setter above deleted");
Object.setPrototypeOf(base, new Proxy({}, { set(target, key, value, receiver) { seen.push(String(key)); return Reflect.set(target, key, value, receiver); } }));
show("proxy above the prototype");
Object.setPrototypeOf(base, null);
show("nothing above the prototype");
Object.freeze(base);
show("frozen prototype");

function fillWide(prototype, n) {
  const o = Object.create(prototype);
  o.a = n; o.b = n; o.c = n; o.d = n; o.e = n; o.f = n; o.g = n; o.h = n; o.i = n;
  return o;
}
const other = { inherited: 1 };
let sum = 0;
for (let n = 0; n < 3000; n++) {
  const o = fillWide(n % 3 ? other : null, n);
  sum += o.a + o.i + Object.keys(o).length;
}
console.log(sum);
//// object-values-with-extra-properties.ts
// TypeScript infers the element type of Object.values(o) and Object.entries(o) from the properties that the type of `o` names.
// An object may have more properties than its type names, so the arrays hold whatever the object holds.
function tell(name: string, f: () => unknown): void {
  try {
    console.log(name + ": " + JSON.stringify(f()));
  } catch (e) {
    console.log(name + ": " + String(e).split("\n")[0]);
  }
}

const wide = { a: "x", b: 1 };
const narrow: { a: string } = wide;
tell("values of a narrower view", () => Object.values(narrow).map(v => typeof v));
tell("entries of a narrower view", () => Object.entries(narrow).map(([k, v]) => k + " " + typeof v));
function valuesOf(o: { a: string }) {
  return Object.values(o).map(v => typeof v);
}
tell("values, through a parameter", () => valuesOf(wide));
tell("values, in a loop", () => {
  const kinds = [];
  for (const v of Object.values(narrow)) kinds.push(typeof v);
  return kinds;
});
tell("entries, in a loop", () => {
  const kinds = [];
  for (const [k, v] of Object.entries(narrow)) kinds.push(k + " " + typeof v);
  return kinds;
});
tell("values, by index", () => {
  const values = Object.values(narrow);
  return [typeof values[0], typeof values[1], values.length];
});
tell("values that are all of the type", () => Object.values({ a: "x", b: "y" }).map(v => v.toUpperCase()));
tell("entries that are all of the type", () => Object.entries({ a: 1, b: 2 }).map(([k, v]) => k + (v + 1)));

type Body = string | Uint8Array;
const size = (data: Body) => data.length;
const dictionary: Record<string, number> = { n: 1 };
const byNumber: Record<number, Body> = { 1: new Uint8Array(2), 5: "xyz" };
tell("a dictionary is spread first", () => Object.values({ ...dictionary, s: "x" }).map(v => typeof v));
tell("a dictionary is spread last", () => Object.values({ s: "x", ...dictionary }).map(v => typeof v));
tell("entries of a spread dictionary", () => Object.entries({ ...byNumber, 9: "tail" }).map(([number, content]) => [number, size(content)]));
tell("through a const", () => {
  const o = { ...dictionary, s: "x" };
  return Object.values(o).map(v => typeof v);
});
tell("through a function", () => {
  const make = () => ({ ...dictionary, s: "x" });
  return Object.values(make()).map(v => typeof v);
});
tell("the type argument is written", () => Object.values<string | number>({ ...dictionary, s: "x" }).map(v => typeof v));
//// objects-born-in-a-constructor-function-and-completed-by-factories.js
// The shape of TypeScript's node factories: one constructor function, objects born in a callee and completed in the caller.
function Node(kind, pos, end) {
  this.pos = pos;
  this.end = end;
  this.kind = kind;
  this.id = 0;
  this.flags = 0;
  this.transformFlags = 0;
  this.parent = undefined;
  this.original = undefined;
}
var NodeConstructor;
var objectAllocator = { getNodeConstructor: function () { return Node; } };
var baseFactory = {
  createBaseNode: function (kind) {
    return new (NodeConstructor || (NodeConstructor = objectAllocator.getNodeConstructor()))(kind, -1, -1);
  },
};
function createBaseNode(kind) { return baseFactory.createBaseNode(kind); }
function createBaseDeclaration(kind) {
  var node = createBaseNode(kind);
  node.symbol = undefined;
  node.localSymbol = undefined;
  return node;
}
function createBinaryExpression(left, operatorToken, right) {
  var node = createBaseDeclaration(1);
  node.left = left;
  node.operatorToken = operatorToken;
  node.right = right;
  node.transformFlags |= left.transformFlags | right.transformFlags;
  node.jsDoc = undefined;
  return node;
}
function createNumericLiteral(text) {
  var node = createBaseNode(2);
  node.text = text;
  node.numericLiteralFlags = 0;
  return node;
}
function createConditional(condition, whenTrue, whenFalse) {
  var node = createBaseNode(3);
  node.condition = condition;
  node.whenTrue = whenTrue;
  node.whenFalse = whenFalse;
  node.flowNodeWhenTrue = undefined;
  node.flowNodeWhenFalse = undefined;
  return node;
}
function sum(node) {
  switch (node.kind) {
    case 1: return sum(node.left) + sum(node.right);
    case 2: return node.text.length;
    default: return sum(node.condition) + sum(node.whenTrue) + sum(node.whenFalse);
  }
}
function build(depth) {
  if (depth === 0) return createNumericLiteral("12");
  if (depth % 3 === 0) return createConditional(build(depth - 1), build(depth - 1), createNumericLiteral("7"));
  return createBinaryExpression(build(depth - 1), createNumericLiteral("+"), build(depth - 1));
}
var rounds = Number(process.argv[2] || 3);
var total = 0;
for (var round = 0; round < rounds; round++) total += sum(build(12));
console.log(total);
//// objects-born-in-a-constructor-function-and-completed-by-typed-factories.ts
// TypeScript's own way of making nodes: a constructor function stores what every node has, a factory gives the object its type and completes it.
interface Node { kind: number; pos: number; end: number; flags: number; parent: Node | undefined }
interface Identifier extends Node { escapedText: string; jsDoc: string[] | undefined; symbol: object | undefined }
interface BinaryExpression extends Node { left: Node; operatorToken: number; right: Node; jsDoc: string[] | undefined }
type Mutable<T> = { -readonly [K in keyof T]: T[K] };
function NodeObject(this: Mutable<Node>, kind: number, pos: number, end: number) {
  this.pos = pos;
  this.end = end;
  this.kind = kind;
  this.flags = 0;
  this.parent = undefined;
}
const objectAllocator = { getNodeConstructor: () => NodeObject as any as new (kind: number, pos: number, end: number) => Node };
let NodeConstructor: (new (kind: number, pos: number, end: number) => Node) | undefined;
function createBaseNode<T extends Node>(kind: number): Mutable<T> {
  return new (NodeConstructor || (NodeConstructor = objectAllocator.getNodeConstructor()))(kind, -1, -1) as Mutable<T>;
}
function createIdentifier(text: string): Identifier {
  const node = createBaseNode<Identifier>(80);
  node.escapedText = text;
  node.jsDoc = undefined;
  node.symbol = undefined;
  return node;
}
function createBinaryExpression(left: Node, operatorToken: number, right: Node): BinaryExpression {
  const node = createBaseNode<BinaryExpression>(227);
  node.left = left;
  node.operatorToken = operatorToken;
  node.right = right;
  node.jsDoc = undefined;
  return node;
}
function count(node: Node): number {
  return node.kind === 227 ? count((node as BinaryExpression).left) + count((node as BinaryExpression).right) : (node as Identifier).escapedText.length;
}
function build(depth: number): Node {
  return depth === 0 ? createIdentifier("name") : createBinaryExpression(build(depth - 1), 40, build(depth - 1));
}
const rounds = Number(process.argv[2] || 3);
let total = 0;
let last: Node | undefined;
for (let round = 0; round < rounds; round++) total += count(last = build(10));
console.log(total, Object.keys(last!).join(","), Object.keys((last as BinaryExpression).left).join(","), JSON.stringify(createIdentifier("x")));
//// objects-born-with-most-fields-empty.ts
// Objects, environments and the frames of async functions are born with most of their slots empty, in code that runs seldom: cells of every size up to 80 bytes and larger ones,
// slots that hold references, numbers, flags and closures. Cells die between the births, so a new cell lies where an old one held values.
// Every field that nobody stored reads as absent, by name, by `in`, in the order of keys and in a copy.
interface Small { a?: string; b?: object; c?: number }
interface Medium { a?: string; b?: object; c?: number; d?: boolean; e?: string[]; f?: () => number; g?: Small; h?: string }
interface Large extends Medium {
  i?: string; j?: object; k?: number; l?: boolean; m?: string[]; n?: () => number; o?: Small; p?: string;
  q?: string; r?: object; s?: number; t?: boolean; u?: string[]; v?: () => number; w?: Small; x?: string;
}
function describe(object: object): string {
  const record = object as Record<string, unknown>;
  const names = "abcdefghijklmnopqrstuvwx".split("");
  const present = names.filter(name => name in record);
  const defined = names.filter(name => record[name] !== undefined);
  return `${Object.keys(object).join("")}|${present.join("")}|${defined.join("")}|${JSON.stringify({ ...object })}`;
}
function fill(turn: number): unknown[] {
  const kept: unknown[] = [];
  for (let i = 0; i < 400; i++) {
    const text = "t" + turn + i;
    const full: Large = {
      a: text, b: [i], c: i + 0.5, d: true, e: [text], f: () => i, g: { a: text, b: {}, c: i }, h: text,
      i: text, j: [i], k: i + 0.5, l: true, m: [text], n: () => i, o: { a: text, b: {}, c: i }, p: text,
      q: text, r: [i], s: i + 0.5, t: true, u: [text], v: () => i, w: { a: text, b: {}, c: i }, x: text,
    };
    const medium: Medium = { a: text, b: [i], c: i + 0.5, d: false, e: [text], f: () => i, g: { c: i }, h: text };
    if (i % 97 === 0) kept.push(full, medium);
  }
  return kept;
}
function small(turn: number): Small[] { return [{}, { a: "a" + turn }, { c: turn }, { b: [turn] }]; }
function medium(turn: number): Medium[] { return [{}, { h: "h" + turn }, { c: turn + 0.25 }, { d: turn % 2 === 0 }, { f: () => turn }, { a: "a", e: ["e" + turn] }]; }
function large(turn: number): Large[] { return [{}, { x: "x" + turn }, { k: turn + 0.25, s: turn }, { l: true, t: false }, { n: () => turn }, { a: "a", m: ["m" + turn], w: { c: turn } }]; }
function counters(turn: number): (() => number)[] {
  let first: number | undefined, second: string | undefined, third: object | undefined, fourth: number[] | undefined, fifth: (() => number) | undefined, sixth: string | undefined;
  return [
    () => (first === undefined ? 0 : 1) + (second === undefined ? 0 : 2) + (third === undefined ? 0 : 4) + (fourth === undefined ? 0 : 8) + (fifth === undefined ? 0 : 16) + (sixth === undefined ? 0 : 32),
    () => { first = turn; fourth = [turn]; return 0; },
    () => { second = "s"; third = {}; fifth = () => turn; sixth = "x"; return 0; },
  ];
}
async function waits(turn: number): Promise<string> {
  let first: string | undefined, second: object | undefined, third: number[] | undefined, fourth: string | undefined, fifth: object | undefined, sixth: string | undefined;
  await null;
  const before = [first, second, third, fourth, fifth, sixth].filter(value => value !== undefined).length;
  if (turn % 2) { first = "f" + turn; third = [turn]; }
  await null;
  if (turn % 3 === 0) { second = {}; sixth = "s"; }
  await null;
  return before + ":" + [first, second, third, fourth, fifth, sixth].map(value => (value === undefined ? "-" : typeof value)[0]).join("");
}
const lines = new Set<string>();
let kept = 0;
for (let turn = 0; turn < 12; turn++) {
  kept += fill(turn).length;
  if (turn % 4 === 3) Bun.gc(true);
  for (const object of [...small(turn % 2), ...medium(turn % 2), ...large(turn % 2)]) lines.add(describe(object));
  const [state, one, two] = counters(turn);
  const states = [state()];
  one(); states.push(state());
  two(); states.push(state());
  lines.add("environment " + states.join(" "));
  lines.add("frame " + (await waits(turn % 6)));
}
console.log(kept);
for (const line of [...lines].sort()) console.log(line);
//// objects-given-names-by-key-are-as-if-each-name-were-written-out.js
// Objects are given their names by key, one name after another, from lists that come once, twice and many times, and in sizes at which an object changes the way it keeps its names.
// Whatever way that is, the order of the names, each value, and all that is done to the object later are those of an object whose names were written out.
function fresh(text) {
  return JSON.parse(JSON.stringify({ text })).text;
}
function namesOf(list, count) {
  const names = [];
  for (let k = 0; k < count; k++) names.push(fresh("n" + list + "_" + k * 3));
  return names;
}
function fill(object, names, from = 0) {
  for (let k = 0; k < names.length; k++) object[names[k]] = from + k;
  return object;
}
function describe(object) {
  let text = "";
  for (const key of Reflect.ownKeys(object)) {
    const descriptor = Object.getOwnPropertyDescriptor(object, key);
    const flags = (descriptor.writable ? "w" : "") + (descriptor.enumerable ? "e" : "") + (descriptor.configurable ? "c" : "");
    text += String(key) + "=" + ("value" in descriptor ? String(descriptor.value) : "get:" + String(object[key])) + ":" + flags + ";";
  }
  return text;
}
function digest(text) {
  let sum = 0;
  for (let k = 0; k < text.length; k++) sum = (sum * 31 + text.charCodeAt(k)) % 1000000007;
  return text.length + ":" + sum;
}
function listed(object) {
  let byForIn = "";
  for (const name in object) byForIn += name + ",";
  return digest(byForIn) + " " + digest(Object.keys(object).join()) + " " + digest(JSON.stringify(object) ?? "none") + " " + digest(Object.entries(object).join());
}
const sizes = [1, 2, 5, 6, 7, 8, 9, 10, 11, 16, 17, 32, 33, 64, 65, 127, 128, 129, 130, 200, 256, 257, 600];
const prototypes = { none: null, object: Object.prototype, other: { inherited: 1, n0_3: "above" } };

console.log("# lists of every size, each once, twice and five times");
for (const size of sizes) {
  for (const which in prototypes) {
    let line = size + " " + which + ":";
    for (const times of [1, 2, 5]) {
      const names = namesOf(size + "x" + times + which, size);
      let last;
      for (let time = 0; time < times; time++) last = fill(Object.create(prototypes[which]), names);
      line += " " + digest(describe(last)) + " " + listed(last);
    }
    console.log(line);
  }
}

console.log("# names that are no plain names");
const odd = ["0", "7", "07", "7th", "4294967294", "4294967295", "-1", "1.5", "1e3", "", " ", "then", "__proto__", "constructor", "toString", "valueOf", "hasOwnProperty", "length", "ķth", "中文", "😀", "a\u0000b"];
for (const size of [0, 3, 7, 40, 140]) {
  for (const which in prototypes) {
    for (const name of odd) {
      const object = fill(Object.create(prototypes[which]), namesOf("odd" + size, size));
      object[fresh("x" + name).slice(1)] = "odd";
      object[fresh("after")] = "after";
      console.log(size, which, JSON.stringify(name), digest(describe(object)), listed(object), Object.getPrototypeOf(object) === prototypes[which]);
    }
  }
}
for (const size of [0, 3, 40, 140]) {
  const object = fill({}, namesOf("proto" + size, size));
  const above = { fromAbove: size };
  object[fresh("__proto__")] = above;
  object[fresh("after")] = 1;
  console.log(size, "__proto__ takes an object:", Object.getPrototypeOf(object) === above, object.fromAbove, Object.hasOwn(object, "__proto__"), digest(describe(object)));
}

console.log("# symbols among the names");
const symbols = [Symbol("first"), Symbol.iterator, Symbol.for("shared"), Symbol.toPrimitive];
for (const size of [0, 5, 40, 140]) {
  const object = Object.create(null);
  const names = namesOf("symbols" + size, size);
  for (let k = 0; k < size; k++) {
    object[names[k]] = k;
    if (k % 11 === 3) object[symbols[(k / 11) % symbols.length | 0]] = -k;
  }
  object[symbols[0]] = "last";
  object[fresh("after")] = 1;
  console.log(size, digest(describe(object)), Object.getOwnPropertySymbols(object).length, listed(object));
}

console.log("# names deleted, and given again");
for (const size of [2, 6, 9, 20, 64, 129, 300]) {
  for (const step of [1, 2, 3, 7]) {
    const names = namesOf("deleted" + size + "_" + step, size);
    const object = fill(Object.create(null), names);
    for (let k = 0; k < size; k += step) delete object[names[k]];
    const afterDeleting = digest(describe(object));
    fill(object, namesOf("more" + size + "_" + step, 12), 1000);
    const afterMore = digest(describe(object));
    for (let k = 0; k < size; k += step) object[names[k]] = -k;
    console.log(size, step, afterDeleting, afterMore, digest(describe(object)), listed(object));
  }
}

console.log("# a queue of names: each turn the oldest goes and a new one comes");
{
  const queue = Object.create(null);
  let line = "";
  for (let turn = 0; turn < 2000; turn++) {
    queue[fresh("turn" + turn)] = turn;
    if (turn >= 20) delete queue[fresh("turn" + (turn - 20))];
    if (turn % 400 === 399) line += digest(describe(queue)) + " ";
  }
  console.log(line);
}

console.log("# getters, setters and attributes that come later");
for (const size of [1, 6, 8, 40, 140]) {
  const names = namesOf("later" + size, size);
  const object = fill({}, names);
  let stored = "nothing";
  Object.defineProperty(object, names[size >> 1], { get() { return "got"; }, set(value) { stored = value; }, enumerable: true, configurable: true });
  object[names[size >> 1]] = "through the setter";
  Object.defineProperty(object, names[0], { value: "fixed", writable: false, enumerable: size % 2 === 0, configurable: true });
  let threw = "no";
  try { fill(object, [names[0]]); } catch (error) { threw = error.constructor.name; }
  fill(object, namesOf("behind" + size, 5), 500);
  console.log(size, stored, threw, digest(describe(object)), listed(object));
}

console.log("# objects above that answer a store");
for (const size of [0, 4, 40, 140]) {
  let stored = [];
  const withSetter = Object.create(null, { caught: { set(value) { stored.push(value); }, configurable: true }, fixed: { value: 1, writable: false } });
  const object = fill(Object.create(withSetter), namesOf("below" + size, size));
  object[fresh("caught")] = size;
  let threw = "no";
  try { object[fresh("fixed")] = 2; } catch (error) { threw = error.constructor.name; }
  object[fresh("free")] = 3;
  console.log(size, stored.join(), threw, Object.hasOwn(object, "caught"), Object.hasOwn(object, "fixed"), digest(describe(object)));

  const seen = [];
  const behindProxy = fill(Object.create(new Proxy({}, { set(target, key, value, receiver) { seen.push(String(key)); return Reflect.defineProperty(receiver, key, { value, writable: true, enumerable: true, configurable: true }); } })), namesOf("proxy" + size, size));
  console.log(size, seen.length, digest(describe(behindProxy)));

  const late = fill(Object.create(withSetter), namesOf("late" + size, size));
  Object.defineProperty(withSetter, "afterwards", { set(value) { stored.push("afterwards " + value); }, configurable: true });
  late[fresh("afterwards")] = size;
  console.log(size, stored.join(), Object.hasOwn(late, "afterwards"));
  delete withSetter.afterwards;
}

console.log("# objects that take no more names");
for (const size of [1, 6, 8, 40, 140]) {
  for (const [how, close, isClosed] of [["preventExtensions", Object.preventExtensions, object => !Object.isExtensible(object)], ["seal", Object.seal, Object.isSealed], ["freeze", Object.freeze, Object.isFrozen]]) {
    const names = namesOf(how + size, size);
    const object = close(fill(Object.create(null), names));
    let threw = "no";
    try { object[fresh("more")] = 1; } catch (error) { threw = error.constructor.name; }
    let threwAtOld = "no";
    try { object[names[0]] = "again"; } catch (error) { threwAtOld = error.constructor.name; }
    console.log(size, how, threw, threwAtOld, isClosed(object), "more" in object, digest(describe(object)));
  }
}

console.log("# an object that others look up to is given names");
for (const size of [0, 5, 40, 140]) {
  const above = fill({}, namesOf("above" + size, size));
  const below = Object.create(above);
  const name = fresh("arrives" + size);
  let line = size + ":";
  for (let turn = 0; turn < 3; turn++) line += " " + below[name] + " " + (name in below);
  above[name] = "arrived";
  for (let turn = 0; turn < 3; turn++) line += " " + below[name] + " " + (name in below);
  delete above[name];
  line += " " + below[name] + " " + (name in below);
  console.log(line);
}

console.log("# copies, and what reads the names at once");
for (const size of [3, 8, 40, 140, 300]) {
  const object = fill(Object.create(null), namesOf("copied" + size, size));
  const spread = { ...object };
  const assigned = Object.assign({}, object);
  const { [fresh("ncopied" + size + "_0")]: first, ...rest } = object;
  const cloned = structuredClone(fill({}, namesOf("copied" + size, size)));
  console.log(size, digest(describe(spread)), digest(describe(assigned)), first, digest(describe(rest)), digest(describe(cloned)), digest(describe(Object.fromEntries(Object.entries(object)))));
  spread[fresh("more")] = 1;
  assigned[fresh("more")] = 1;
  rest[fresh("more")] = 1;
  console.log(size, digest(describe(spread)), digest(describe(assigned)), digest(describe(rest)));
}

console.log("# names that nothing but the object keeps, over collections");
{
  const kept = [];
  for (let round = 0; round < 40; round++) {
    const object = Object.create(null);
    for (let k = 0; k < 50; k++) object[fresh("round" + round + "name" + k)] = { round, k };
    if (round % 4 === 0) kept.push(object);
    if (round % 10 === 9) Bun.gc(true);
  }
  Bun.gc(true);
  let text = "";
  for (const object of kept) for (const name in object) text += name + object[name].round + object[name].k;
  console.log(digest(text));
}

console.log("# counts by words, each text in an order of its own");
{
  const words = [];
  for (let k = 0; k < 90; k++) words.push("word" + k);
  let line = "";
  for (let text = 0; text < 60; text++) {
    const counts = {};
    for (let k = 0; k < 300; k++) {
      const word = fresh(words[(k * (text + 7) + (k >> 3) * text) % words.length]);
      counts[word] = (counts[word] || 0) + 1;
    }
    if (text % 10 === 0) line += digest(describe(counts)) + " ";
  }
  console.log(line);
}
//// objects-grow-in-every-way-and-functions-are-bound.js
// Who makes Structures, and who binds: each way once or a few times, for the counts.
function bindMany(f, n) { const out = []; for (let i = 0; i < n; i++) out.push(f.bind(null, i)); return out; }
function addNames(n) { const o = {}; for (let i = 0; i < n; i++) o["k" + i] = i; return o; }
function withPrototype(p) { return Object.create(p); }
function makeClass(i) { return class { a() { return i; } b() { return i + 1; } }; }
const bound = bindMany(function add(a, b) { return a + b; }, 50);
const names = addNames(30);
const big = addNames(200);
const protos = []; for (let i = 0; i < 10; i++) protos.push(withPrototype({ i }));
const classes = []; for (let i = 0; i < 5; i++) classes.push(makeClass(i));
const entries = Object.fromEntries([["x", 1], ["y", 2], ["z", 3]]);
delete names.k3;
Object.freeze(entries);
console.log(bound[7](1), Object.keys(names).length, Object.keys(big).length, protos.length, new classes[2]().b(), entries.z);
//// objects-kept-in-last-index-read-through-heirs.ts
// An object that is kept in lastIndex of a regular expression is read through objects that inherit from the expression: it comes back whole, with every field that only such a read names.
declare const console: { log(...values: unknown[]): void };
function read(re: any): any { return re.lastIndex; }
function store(re: RegExp, value: any): void { re.lastIndex = value; }
const re: any = /a/g;
const heir: any = Object.create(re);
const heirOfHeir: any = Object.create(heir);
for (let i = 0; i < 3; i++) {
  store(re, { tag: "t" + i, more: new Array(1000).fill(i), deep: { level: i } });
  console.log(read(heir).tag + " " + read(heir).more.length + " " + read(heirOfHeir).deep.level);
}
//// objects-made-by-object-create-under-a-declared-type.ts
// `const made: Answer = Object.create(above)`: the interface declares what the objects hold and what lies above them. Names that the type requires are never stored, names that it does not
// declare are stored through `any`, values of other types arrive, and the members above change: nothing throws because of a type.
interface Wire { sent: boolean; code: number }
interface Answer {
  wire: Wire; label: string; count: number; note?: string; never: string;
  readonly sent: boolean; status: number; tell(prefix: string): string;
}
