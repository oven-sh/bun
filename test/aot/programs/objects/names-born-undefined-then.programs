//// names-defined-twice-and-beside-accessors-in-literals.js
// What TypeScript refuses in a literal and JavaScript allows: a name twice, an accessor under a name that is also defined, in either order, with values of one type and of several.
const lines = [];
const keysOf = object => Reflect.ownKeys(object).map(String).join();
function accessorFirst(i) { return { a: i, get d() { return "getter"; }, d: i + 1, e: "e" }; }
function accessorLast(i) { return { a: i, d: i + 1, get d() { return "getter " + this.a; }, e: "e" }; }
function setterFirst(i) { return { a: i, set d(value) { lines.push("the setter ran"); }, d: i + 1, e: "e" }; }
function setterLast(i) { return { a: i, d: i + 1, set d(value) { lines.push("the setter ran"); }, e: "e" }; }
function twice(i) { return { a: i, d: "first", e: "e", d: i + 1 }; }
function twiceWithCallsBetween(i) { return { a: i, d: String(i), e: [i].join(), d: i + 1, f: [i, i].join() }; }
function thrice(i) { return { d: 1, d: "two", d: { three: i } }; }
function prototypeTwiceInWords(i) { return { __proto__: null, ["__proto__"]: i, a: i, d: i + 1 }; }
function methodsAndNames(i) { return { run() { return this.d; }, d: i + 1, run2: () => i, e: "e", run() { return "second " + this.d; } }; }
for (const [label, make] of Object.entries({ accessorFirst, accessorLast, setterFirst, setterLast, twice, twiceWithCallsBetween, thrice, prototypeTwiceInWords, methodsAndNames })) {
  let last;
  for (let i = 0; i < 40; i++) last = make(i);
  lines.push(label + ": " + keysOf(last) + " | " + JSON.stringify(last.d) + " | " + JSON.stringify(Object.getOwnPropertyDescriptor(last, "d"), (key, value) => typeof value === "function" ? "function" : value) + " | " + (typeof last.run === "function" ? last.run() : "no run") + " | " + String(Object.getPrototypeOf(last) === Object.prototype));
}
console.log(lines.join("\n"));
//// names-of-every-kind-are-written-as-json-keys.ts
const sym = Symbol("s");
function a(n: number) { return { plain: n, "with space": n, "qu\"ote": n, "back\\slash": n, "tab\tkey": n, "café": n, "中": n, "": n, "del\u007f": n, [sym]: n, last: n }; }
function b(n: number) { return { "\n": n, x: n, "\u0000": n, y: { "a\"": n, b: [n] } }; }
function c(o: object) { return { ...o, extra: 1 }; }
for (let i = 0; i < 3; i++) {
  console.log(JSON.stringify(a(i)), JSON.stringify(b(i)), JSON.stringify(c(a(i))), JSON.stringify(c(b(i)), null, 1).length, Object.keys(c(a(i))).join("|"));
}
//// names-stored-by-constructors-under-any-new-target.js
// Classes that reach native code may be constructed under any new.target: what a constructor stores under a name that no class declares is found on the instance, whichever class the instance gets its shape from.
// STATISTIC: FlowAppendedFields <= 8
////= throughNativeCode
////= lines-21	mark	object	object.mark
////= lines-21	stamp	object	object.stamp
////= lines-21	seal	object	object.seal

class Point {
  constructor(x) {
    this.x = x;
    mark(this, x + 1);
  }
  norm() {
    return "norm " + this.x + " " + this.mark;
  }
}
class Box {
  constructor(w) {
    this.w = w;
    stamp(this, w * 2);
  }
  area() {
    return "area " + this.w + " " + this.stamp;
  }
}
class Heir extends Point {
  constructor(x) {
    super(x);
    this.y = x + 10;
    seal(this, "heir");
  }
}
class HeirOfSomething extends throughNativeCode(Point) {
  constructor(x) {
    super(x);
    this.z = x + 20;
  }
}
class Stranger {
  constructor() {
    this.own = "own";
  }
  mark() {
    return "method mark";
  }
  get stamp() {
    return "getter stamp";
  }
}

function show(label, object) {
  const names = ["x", "w", "y", "z", "own", "mark", "stamp", "seal"];
  console.log(
    label,
    "|",
    Object.keys(object).join(),
    "|",
    JSON.stringify(object),
    "|",
    names.filter(name => name in object).join(),
    "|",
    names.filter(name => Object.hasOwn(object, name)).join(),
    "|",
    typeof object.mark,
    typeof object.stamp,
    "|",
    Object.getPrototypeOf(object).constructor.name,
  );
}

const classes = [Point, Box, Heir, HeirOfSomething, Stranger].map(throughNativeCode);
globalThis.publish?.(classes);
for (const constructed of classes) {
  for (const target of classes) {
    let made;
    try {
      made = Reflect.construct(constructed, [3], target);
    } catch (error) {
      console.log(constructed.name, "as", target.name, "throws", error.constructor.name);
      continue;
    }
    show(constructed.name + " as " + target.name, made);
  }
}

show("new Point", new Point(1));
show("new Box", new Box(2));
show("new Heir", new Heir(3));
show("new HeirOfSomething", new HeirOfSomething(4));
show("new Stranger", new Stranger());
console.log(new Point(5).norm(), "|", new Box(6).area(), "|", new Heir(7).norm(), "|", new HeirOfSomething(8).norm(), "|", new Stranger().mark(), new Stranger().stamp);
//// names-stored-through-declared-receivers.ts
// One class makes the objects, the program sees them through interfaces and fills them from functions of their own, as a compiler fills its types, symbols and links.
// The receivers are in hands the compiler cannot follow, so only their declared types name the class. Whether a name gets a field, a slot out of line or an extra property, the object behaves the same:
// reads of what is absent, `in`, the order of keys, deletion, stores of values that the declared type does not admit, and names stored through a receiver without a type.
interface TypeLike {
  flags: number;
  id?: number;
  symbol?: string;
  widened?: TypeLike;
}
interface ObjectLike extends TypeLike {
  objectFlags: number;
  members?: Map<string, number>;
  properties?: string[];
}
interface Links {
  resolvedType?: TypeLike;
  resolvedName?: string;
  isVisible?: boolean;
  count?: number;
}

////= lines-25	Made	flags
const LinksMade = class implements Links {};

const hand = new Function("value", "return value") as <T>(value: T) => T;
const constructors = hand({ type: Made, links: LinksMade });

let nextId = 0;
function createType(flags: number): TypeLike {
  const result: TypeLike = new constructors.type(flags);
  result.id = ++nextId;
  return result;
}
function createTypeWithSymbol(flags: number, symbol: string): TypeLike {
  const result = createType(flags);
  result.symbol = symbol;
  return result;
}
function createObjectType(objectFlags: number, symbol: string): ObjectLike {
  const type = createTypeWithSymbol(8, symbol) as ObjectLike;
  type.objectFlags = objectFlags;
  type.members = undefined;
  type.properties = undefined;
  return type;
}
function resolveMembers(type: ObjectLike) {
  if (!type.members) {
    type.members = new Map([[type.symbol ?? "?", type.id ?? -1]]);
    type.properties = [...type.members.keys()];
  }
  return type.members;
}

const linksOf: Links[] = [];
function getLinks(id: number): Links {
  return (linksOf[id] ??= new constructors.links());
}

function show(label: string, object: object) {
  const listed: string[] = [];
  for (const name in object) listed.push(name);
  console.log(label, "|", Object.keys(object).join(), "|", listed.join(), "|", JSON.stringify(object, (_, value) => (value instanceof Map ? [...value] : value)));
}

const plain = hand(createType(1));
const named = hand(createTypeWithSymbol(2, "named"));
const object = hand(createObjectType(16, "object"));
const other = hand(createObjectType(32, "other"));
show("plain", plain);
show("named", named);
show("object", object);
console.log("id" in plain, "symbol" in plain, plain.symbol, "objectFlags" in plain, (plain as ObjectLike).objectFlags);
console.log("members" in object, object.members, Object.hasOwn(object, "properties"), "widened" in object, object.widened);

resolveMembers(object);
resolveMembers(object);
show("object resolved", object);
show("other unresolved", other);

named.widened = plain;
plain.widened = plain;
console.log(named.widened === plain, plain.widened === plain, Object.keys(named).join(), Object.keys(plain).join());

// The order of keys is the order of the stores, whatever the order of the fields.
const late = hand(createType(4)) as ObjectLike;
late.properties = ["p"];
late.symbol = "late";
late.objectFlags = 1;
show("late", late);
delete late.symbol;
show("late without symbol", late);
late.symbol = "again";
show("late with symbol again", late);

// Values that the declared types do not admit, and names that no type declares.
const loose: any = hand(createObjectType(64, "loose"));
loose.id = "a string";
loose.objectFlags = { boxed: true };
loose.members = 7;
loose.extra = "extra";
loose[Symbol.for("mark")] = 1;
show("loose", loose);
console.log(typeof loose.id, typeof loose.objectFlags, loose.members + 1, loose.extra, Object.getOwnPropertySymbols(loose).length);
Object.defineProperty(loose, "symbol", { get: () => "from a getter", enumerable: true, configurable: true });
console.log(loose.symbol, (loose as TypeLike).symbol, Object.getOwnPropertyDescriptor(loose, "symbol")!.get !== undefined);

for (let id = 0; id < 6; id++) {
  const links = getLinks(id);
  if (id % 2) links.resolvedType = id % 3 ? object : plain;
  if (id % 3 === 0) links.resolvedName = "n" + id;
  if (id === 4) links.isVisible = false;
  links.count = (links.count ?? 0) + id;
}
getLinks(4).count! += 10;
for (let id = 0; id < 6; id++) {
  const links = hand(getLinks(id));
  console.log(id, Object.keys(links).join(), links.resolvedType?.id, links.resolvedName, links.isVisible, links.count, "isVisible" in links);
}

// Many objects, so that the fields are filled by compiled code again and again, and a sum that depends on each of them.
let sum = 0;
const kept: TypeLike[] = [];
for (let index = 0; index < 20000; index++) {
  const type = index % 3 ? createObjectType(index, "s" + (index % 7)) : createTypeWithSymbol(index, "t");
  if (index % 5 === 0) type.widened = kept[index >> 1] ?? type;
  if (index % 3 === 1) resolveMembers(type as ObjectLike);
  kept.push(hand(type));
}
for (const type of kept) {
  const seen = type as ObjectLike;
  sum += (type.id ?? 0) + type.flags + (seen.objectFlags ?? 1) + (seen.members?.size ?? 2) + (seen.properties?.length ?? 3) + (type.widened ? type.widened.flags : 4) + Object.keys(type).length;
}
console.log(sum);
