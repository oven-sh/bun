//// one-place-adds-fields-to-typed-objects-with-different-keys.ts
// As one-place-adds-fields-to-objects-with-different-keys.js, typed and in strict code: a store that may not happen throws.
interface Base { kind: number; pos: number; late?: number | string; first?: number; second?: number | string; third?: number; earlier?: number }
class Made implements Base {
  kind: number; pos = 0;
  declare late?: number | string; declare first?: number; declare second?: number | string; declare third?: number; declare earlier?: number;
  constructor(kind: number) { this.kind = kind; }
}
class Below extends Made { own = "own"; }
function addOne(node: Base, value: number) { node.late = value; return node; }
function addRun(node: Base, a: number, b: number, c: number) { node.first = a; node.second = b; node.third = c; return node; }
function show(object: object) { return Object.keys(object).join(",") + " | " + JSON.stringify(object) + " | " + Object.entries(object).length; }
function attempt(work: () => object) { try { return show(work()); } catch (error) { return (error as Error).name; } }
const makers: (() => Base)[] = [
  () => new Made(1),
  () => { const made = new Made(2); made.earlier = 1; return made; },
  () => { const made = new Made(3); made.second = "already"; return made; },
  () => new Below(4),
  () => ({ kind: 5, pos: 1 }),
  () => ({ pos: 1, kind: 6 }),
  () => ({ kind: 7, pos: 1, third: 9 }),
  () => Object.freeze(new Made(8)),
  () => Object.preventExtensions(new Made(9)),
  () => { const made = new Made(10); made.late = 1; delete made.late; made.earlier = 2; return made; },
];
for (let round = 0; round < 4; round++) {
  for (let i = 0; i < makers.length; i++) {
    for (let again = 0; again < 3; again++) {
      console.log(round, i, again, attempt(() => addOne(makers[i]!(), round)), "/", attempt(() => addRun(makers[i]!(), 1, 2, 3)), "/", attempt(() => addRun(addOne(makers[i]!(), round), 1, 2, 3)), "/", attempt(() => addOne(addRun(makers[i]!(), 1, 2, 3), round)));
    }
  }
}
//// one-template-object-per-site.ts
// A tagged template passes the same strings array at every evaluation of one site, and different arrays at different sites.
declare const console: any;
const id = (s: TemplateStringsArray, ..._: unknown[]): TemplateStringsArray => s;
function typed(p: { x: number }): TemplateStringsArray { return id`a${p.x}b`; }
const letOut: any = typed;
const plain = () => JSON.parse('{"x":1}');
console.log("two bodies", typed({ x: 1 }) === typed({ x: 2 }), typed({ x: 1 }) === letOut(plain()), letOut(plain()) === letOut(plain()), letOut({ x: 3 }) === typed({ x: 3 }));
class Base {}
class Fields extends Base {
  f = id`field`;
  constructor(way: number) { if (way === 0) { super(); } else if (way === 1) { super(); } else { super(); } }
}
console.log("every super()", new Fields(0).f === new Fields(1).f, new Fields(1).f === new Fields(2).f, new Fields(0).f === new Fields(0).f);
function twoSites(): [TemplateStringsArray, TemplateStringsArray] { return [id`same`, id`same`]; }
const [p, q] = twoSites();
console.log("two sites, one text", p === q, p === twoSites()[0], q === twoSites()[1]);
function other(): TemplateStringsArray { return id`same`; }
console.log("another function", other() === p, other() === other());
const makers = [0, 1, 2].map(() => () => id`closure`);
console.log("closures of one site", makers[0]() === makers[1](), makers[1]() === makers[2]());
function* gen() { for (let i = 0; i < 3; i++) yield id`gen${i}`; }
const made = [...gen()];
console.log("a loop", made[0] === made[1], made[1] === made[2]);
class Static { static s = id`static`; static t = id`static`; m() { return id`method`; } }
console.log("static", Static.s === Static.t, new Static().m() === new Static().m());
console.log("frozen", Object.isFrozen(p), Object.isFrozen(p.raw), Array.isArray(p), p.length, p.raw.length);
function nested(p: { x: number }) { return [id`out${id`in${p.x}`}`, id`in${p.x}`]; }
const nestedOut: any = nested;
console.log("nested", nested({ x: 1 })[0] === nestedOut(plain())[0], nested({ x: 1 })[1] === nestedOut(plain())[1], nested({ x: 1 })[0] === nested({ x: 1 })[1]);
//// optional-keys.ts
declare const console: { log(...values: unknown[]): void };
function show(v: unknown): string { return typeof v === "number" ? (Object.is(v, -0) ? "-0" : String(v)) : String(v); }
const given: number[] = [0, -0, 1, -1, 7, 2.5, -2.5, 2147483647, -2147483648, 2147483648, -2147483649, 4294967295, 4294967296, 9007199254740991, 1e21, 5e-324, Infinity, -Infinity, NaN];
function holed(): number[] { const a = given.slice(); delete (a as unknown[])[3]; a.length = a.length + 2; return a; }
function wholes(): (number | undefined)[] { return [0, 1, undefined, 2147483647, -2147483648, 4294967296, 9007199254740991, undefined]; }
function fill(m: Map<number | undefined, string>, a: number[]): void { for (let i = 0; i < a.length; i++) m.set(a[i], "s" + i); }
function fillBoxed(m: Map<unknown, string>, a: unknown[]): void { for (let i = 0; i < a.length; i++) m.set(a[i], "b" + i); }
function getAll(m: Map<number | undefined, string>, a: number[]): string { let s = ""; for (let i = 0; i < a.length + 1; i++) s += String(m.get(a[i])) + " "; return s; }
function hasAll(m: Map<number | undefined, string>, a: number[]): string { let s = ""; for (let i = 0; i < a.length + 1; i++) s += m.has(a[i]) ? "y" : "n"; return s; }
function getOne(m: Map<number | undefined, string>, a: number[], i: number): string | undefined { return m.get(a[i]); }
function hasOne(s: Set<number | undefined>, a: number[], i: number): boolean { return s.has(a[i]); }
function addAll(s: Set<number | undefined>, a: number[]): void { for (let i = 0; i < a.length; i++) s.add(a[i]); }
function setHasAll(s: Set<number | undefined>, a: number[]): string { let t = ""; for (let i = 0; i < a.length + 1; i++) t += s.has(a[i]) ? "y" : "n"; return t; }
function deleteAll(m: Map<number | undefined, string>, a: number[]): string { let t = ""; for (let i = 0; i < a.length + 1; i++) t += m.delete(a[i]) ? "y" : "n"; return t; }
function wholeKeys(m: Map<number | undefined, string>, a: (number | undefined)[]): string { let s = ""; for (let i = 0; i < a.length; i++) { const k = a[i]; m.set(k === undefined ? undefined : k | 0, "w" + i); s += String(m.get(k === undefined ? undefined : k | 0)) + " "; } return s; }
function places(a: number[], keys: number[]): string { let s = ""; for (let i = 0; i < keys.length + 1; i++) s += a.indexOf(keys[i]) + "," + (a.includes(keys[i]) ? "y" : "n") + " "; return s; }
function counts(a: number[]): string { const m = new Map<number | undefined, number>(); for (let r = 0; r < 3; r++) for (let i = 0; i < a.length; i++) { const k = a[i]; const n = m.get(k); m.set(k, n === undefined ? 1 : n + 1); } let s = ""; for (const [k, n] of m) s += show(k) + ":" + n + " "; return s + m.size; }
for (let turn = 0; turn < 2; turn++) {
    for (const [name, make] of [["given", () => given.slice()], ["holed", holed], ["parsed", () => JSON.parse("[0,1,-1,7,2147483647,-2147483648]") as number[]], ["none", (): number[] => []]] as [string, () => number[]][]) {
        const a = make(), m = new Map<number | undefined, string>(), s = new Set<number | undefined>();
        fill(m, a); addAll(s, a);
        console.log(name + ": " + m.size + " " + s.size + " | " + getAll(m, a) + "| " + hasAll(m, a) + " " + setHasAll(s, a) + " | " + [...m.keys()].map(show).join() + " | " + [...s].map(show).join());
        console.log("  against given: " + getAll(m, given) + "| " + hasAll(m, given) + " " + setHasAll(s, given) + " | one: " + [0, 1, 3, 18, 99].map(i => String(getOne(m, given, i)) + (hasOne(s, given, i) ? "y" : "n")).join(" "));
        const boxed = new Map<unknown, string>();
        fillBoxed(boxed, [0, -0, 1, 2.5, NaN, undefined, null, "1", 2147483648, 1e21]);
        console.log("  filled boxed: " + getAll(boxed as Map<number | undefined, string>, a) + "| " + hasAll(boxed as Map<number | undefined, string>, a));
        console.log("  counts: " + counts(a) + " | places: " + places(a, given));
        console.log("  deleted: " + deleteAll(m, given) + " " + m.size + " " + deleteAll(m, a) + " " + m.size);
    }
    console.log(wholeKeys(new Map(), wholes()));
}
