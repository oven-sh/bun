const t1 = fresh(); log.push(alias(t1, t1), alias(fresh(), fresh()));
const t2 = fresh(); t2.next = t2; log.push(viaNext(t2)); const t3 = fresh(); t3.next = fresh(); log.push(viaNext(t3));
