//// reads-past-an-object-after-a-repeated-change-of-prototype.ts
// The same change of prototype, made again and again, is carried out by compiled code alone. A read that goes past the object afterwards finds what the new prototype has:
// behind Object.setPrototypeOf and Reflect.setPrototypeOf, called by name and through a variable, behind __proto__ in a literal, and behind a construction with another new.target or by another closure of a constructor function.
declare const console: { log(...args: unknown[]): void }
class Point {
  x: number
  declare label?: string
  constructor(x: number) {
    this.x = x
  }
}
const named = { label: "from the other prototype", extra: 7 }
function labelOf(point: Point): string | undefined {
  return point.label
}
function extraOf(value: { extra?: number }): number | undefined {
  return value.extra
}

const lines: string[] = []
for (let i = 0; i < 6; ++i) {
  const point = new Point(i)
  const before = labelOf(point)
  Object.setPrototypeOf(point, named)
  lines.push("Object.setPrototypeOf " + i + ": " + before + " -> " + labelOf(point) + ", " + extraOf(point as { extra?: number }) + ", " + (point instanceof Point))
}
for (let i = 0; i < 6; ++i) {
  const point = new Point(i)
  const changed = Reflect.setPrototypeOf(point, named)
  lines.push("Reflect.setPrototypeOf " + i + ": " + changed + " " + labelOf(point))
}
const throughVariable: (object: object, prototype: object | null) => object = [Object.setPrototypeOf][lines.length & 0]
for (let i = 0; i < 6; ++i) {
  const point = new Point(i)
  throughVariable(point, named)
  lines.push("through a variable " + i + ": " + labelOf(point))
}
for (let i = 0; i < 6; ++i) {
  const record: { a: number; label?: string; extra?: number } = { __proto__: named, a: i } as { a: number }
  lines.push("__proto__ in a literal " + i + ": " + record.label + ", " + extraOf(record) + ", " + Object.keys(record).join())
}
class Other {}
;(Other.prototype as { label?: string }).label = "from the prototype of new.target"
for (let i = 0; i < 6; ++i) {
  const point = Reflect.construct(Point, [i], i & 1 ? Other : Point) as Point
  lines.push("another new.target " + i + ": " + labelOf(point) + ", " + (point instanceof Point) + ", " + (point instanceof Other))
}
function makeConstructor(text: string) {
  function Made(this: { a: number; label?: string }, a: number) {
    this.a = a
  }
  Made.prototype.label = text
  return Made as unknown as new (a: number) => { a: number; label?: string }
}
for (let i = 0; i < 6; ++i) {
  const Made = makeConstructor("closure " + (i % 3))
  const first = new Made(i)
  const second = new Made(i + 1)
  lines.push("a closure of a constructor function " + i + ": " + first.label + ", " + second.label + ", " + (Object.getPrototypeOf(first) === Object.getPrototypeOf(second)))
}
for (let i = 0; i < 4; ++i) {
  const point = new Point(i)
  Object.setPrototypeOf(point, named)
  Object.setPrototypeOf(point, Point.prototype)
  lines.push("and back " + i + ": " + labelOf(point) + ", " + (point instanceof Point))
}
console.log(lines.join("\n"))
//// records-read-by-string-key.ts
// Records read by keys whose type is string: what is in the object, what is beside it, what is inherited, and what is nowhere, before and after it arrives.
type Table = Record<string, number | string | undefined>;
function read(table: Table, key: string): unknown { return table[key]; }
const lines: string[] = [];
const small: Table = { a: 1, b: "two" };
const large: Table = {};
for (let i = 0; i < 40; i++) large["n" + i] = i;
const names = ["a", "b", "c", "n0", "n5", "n6", "n7", "n39", "n40", "toString", "constructor", "__proto__", "length", ""];
function row(what: string, table: Table): void {
    lines.push(what + ": " + names.map(name => { const found = read(table, name) as unknown; return typeof found === "function" ? "function" : typeof found === "object" ? "object" : String(found); }).join());
}
for (let round = 0; round < 3; round++) { row("small", small); row("large", large); }
small.c = 3;
row("small with c", small);
delete small.a;
row("small without a", small);
small.a = "back";
row("small with a again", small);
large.n40 = "forty";
row("large with n40", large);

const parent: Table = { c: "from the parent" };
const heir: Table = Object.create(parent);
heir.a = 1;
row("heir", heir); row("heir", heir);
parent.n5 = "arrived on the parent";
row("heir after the parent got n5", heir);
delete parent.c;
row("heir after the parent lost c", heir);
const bare: Table = Object.create(null);
bare.b = 2;
row("bare", bare); row("bare", bare);
Object.setPrototypeOf(bare, parent);
row("bare with a parent", bare);
const computed: Table = { get a() { return "got"; }, b: 1 } as Table;
row("with a getter", computed); row("with a getter", computed);

// The same key, many tables of one shape and of many; what is nowhere stays nowhere until a table gets it.
let sum = 0;
const tables: Table[] = [];
for (let i = 0; i < 300; i++) { const table: Table = { x: i }; if (i % 3 === 0) table["y" + (i % 7)] = i; tables.push(table); }
for (let round = 0; round < 20; round++) {
    for (const table of tables) {
        sum += read(table, "x") as number;
        if (read(table, "late") !== undefined) sum += 1000000;
        if (read(table, "y3") !== undefined) sum += 1;
    }
    if (round === 10) tables[7].late = 1;
}
lines.push("sum " + sum);
console.log(lines.join("\n"));
//// references-stored-late-are-read-while-the-world-above-changes.ts
// A reference that is stored once the object is out in the world, or never, read by typed code.
// A filled slot is the answer whatever lies above the object. An empty one is undefined only while nothing above the object has the name and the field lies nowhere else.
declare const console: { log(...values: unknown[]): void };

const lines: string[] = [];
function say(label: string, value: unknown) {
  lines.push(label + ": " + (typeof value === "string" ? value : JSON.stringify(value, (_, v) => v === undefined ? "#undefined" : typeof v === "function" ? "#function" : v)));
}

interface Links { id: number; type?: Kind; target?: Links; mapper?: (n: number) => number; name?: string; list?: number[]; }
interface Kind { id: number; members?: Map<string, number>; resolved?: Kind; alias?: Links; }
const Links = function (this: Links, id: number) { this.id = id; } as unknown as new (id: number) => Links;
const Kind = function (this: Kind, id: number) { this.id = id; } as unknown as new (id: number) => Kind;

// What is done to the objects from outside is done under names that only the run knows.
const names = ["type", "target", "mapper", "name", "list", "members", "resolved"];
function nameAt(index: number): string { return names[index % names.length]; }
function redefine(object: any, index: number, descriptor: PropertyDescriptor) { Object.defineProperty(object, nameAt(index), descriptor); }
function remove(object: any, index: number) { delete object[nameAt(index)]; }
function put(object: any, index: number, value: unknown) { object[nameAt(index)] = value; }
const TYPE = 0, TARGET = 1, MAPPER = 2, NAME = 3, LIST = 4, MEMBERS = 5;

// Each reads one late field of its argument, as a checker's small functions do.
function typeOf(links: Links): number { const type = links.type; if (type) return type.id; return -1; }
function targetOf(links: Links): Links | undefined { return links.target; }
function membersOf(kind: Kind): number { if (!kind.members) return 0; return kind.members.size; }
function resolve(kind: Kind): Kind { return kind.resolved || (kind.resolved = new Kind(kind.id + 1000)); }
function mapped(links: Links, n: number): number { const mapper = links.mapper; return mapper ? mapper(n) : n; }
function nameOf(links: Links): string { return links.name ?? "none"; }
function firstOf(links: Links): number | undefined { return links.list?.[0]; }
function show(links: Links) { const target = targetOf(links); return [typeOf(links), target === undefined ? "#u" : target === null ? "#n" : (target as any).id ?? String(target), mapped(links, 5), nameOf(links), firstOf(links)]; }

const all: Links[] = [], kinds: Kind[] = [];
for (let i = 0; i < 400; i++) {
  const links = new Links(i), kind = new Kind(i);
  all.push(links); kinds.push(kind);
  if (i % 2) links.type = kind;
  if (i % 3 === 0 && i) links.target = all[i - 1];
  if (i % 5 === 0) links.mapper = n => n * i;
  if (i % 7 === 0) links.name = "n" + i;
  if (i % 11 === 0) links.list = [i, i];
  if (i % 4 === 0) kind.members = new Map([["a", i]]);
}
function tally() {
  let t = 0;
  for (const links of all) { t += typeOf(links) + mapped(links, 2) + nameOf(links).length + (firstOf(links) ?? 3); const target = targetOf(links); if (target) t += target.id; }
  for (const kind of kinds) t += membersOf(kind);
  return t;
}
for (let round = 0; round < 30; round++) tally();
say("tally", tally());
say("some", [0, 1, 3, 5, 7, 11, 15, 35, 77, 385].map(i => show(all[i])));
say("resolve", [resolve(kinds[1]).id, resolve(kinds[1]) === resolve(kinds[1]), resolve(resolve(kinds[2])).id]);

// undefined and null stored by name: the field is there and holds them.
{
  const a = new Links(1000), b = new Links(1001), c = new Links(1002);
  a.type = undefined; a.target = undefined; a.name = undefined; put(b, TYPE, null); put(b, TARGET, null); put(b, NAME, null);
  say("undefined stored", [show(a), "type" in a, Object.keys(a).join(), Object.hasOwn(a, "target")]);
  say("null stored", [show(b), "type" in b, Object.keys(b).join()]);
  say("nothing stored", [show(c), "type" in c, Object.keys(c).join(), Object.hasOwn(c, "target")]);
  a.type = kinds[3]; a.target = b; say("then filled", [show(a), Object.keys(a).join()]);
}
// The field leaves its slot: an accessor, a constant, a deletion.
{
  const a = new Links(2000); a.type = kinds[5]; a.target = all[5]; a.name = "first";
  let reads = 0;
  redefine(a, TYPE, { get() { reads++; return kinds[6]; }, configurable: true, enumerable: true });
  redefine(a, NAME, { value: "fixed", writable: false, configurable: true });
  say("redefined", [show(a), show(a), reads]);
  remove(a, TARGET); remove(a, TYPE); say("deleted", [show(a), Object.keys(a).join()]);
  a.type = kinds[7]; say("stored again", [show(a), Object.keys(a).join()]);
  const empty = new Links(2001);
  redefine(empty, TARGET, { get() { return all[9]; }, configurable: true });
  say("an accessor where nothing was", show(empty));
  const frozen = Object.freeze(new Links(2002)); say("frozen and empty", show(frozen));
  const full = new Links(2003); full.type = kinds[8]; full.name = "kept"; say("frozen and filled", show(Object.freeze(full)));
}
// Other values than the types allow.
{
  const a: any = new Links(3000);
  put(a, TYPE, 5); put(a, TARGET, "text"); put(a, MAPPER, null); put(a, NAME, 7); put(a, LIST, { 0: "zero" });
  let answer: unknown; try { answer = show(a); } catch (error) { answer = (error as Error).constructor.name; }
  say("other values", answer);
}
// The world above the objects changes. What is filled stays; what is empty finds what is above.
{
  const filled = new Links(4000); filled.type = kinds[9]; filled.target = all[1]; filled.name = "own"; filled.mapper = n => n + 1; filled.list = [8];
  const empty = new Links(4001), holdsUndefined = new Links(4002); holdsUndefined.name = undefined; holdsUndefined.target = undefined; holdsUndefined.type = undefined;
  const reparented = new Links(4003), other = new Links(4004);
  say("before", [show(filled), show(empty), show(holdsUndefined)]);
  const parent: any = {}; put(parent, NAME, "from the new parent"); put(parent, TARGET, all[2]); put(parent, TYPE, kinds[10]);
  Object.setPrototypeOf(reparented, parent);
  say("another parent", [show(reparented), show(other), show(filled)]);
  put(Links.prototype, NAME, "from the prototype");
  say("the prototype has the name", [show(filled), show(empty), show(holdsUndefined), show(reparented), nameOf(all[7]), nameOf(all[8])]);
  const top: any = {};
  Object.setPrototypeOf(Links.prototype, top); Object.setPrototypeOf(Kind.prototype, top);
  say("a new top that is empty", [show(filled), show(empty), show(holdsUndefined), membersOf(kinds[5])]);
  redefine(top, TARGET, { get() { return all[3]; }, configurable: true });
  say("an accessor at the top", [show(filled), show(empty), show(holdsUndefined), targetOf(all[3])!.id, targetOf(all[4])!.id]);
  put(top, MEMBERS, new Map([["x", 1], ["y", 2]]));
  say("members at the top", [membersOf(kinds[4]), membersOf(kinds[5])]);
  say("tally above", tally());
  remove(Links.prototype, NAME); remove(top, TARGET); remove(top, MEMBERS);
  say("taken away again", [show(filled), show(empty), show(holdsUndefined), membersOf(kinds[5]), tally()]);
}

// Fields that lie outside the cell, because sixty others took the room in it. One that a store of undefined creates is listed and has no storage: it is there, and it reads as undefined.
{
  interface Crowded { id: number; late?: Kind; later?: Kind; q00?: Kind; q01?: Kind; q02?: Kind; q03?: Kind; q04?: Kind; q05?: Kind; q06?: Kind; q07?: Kind; q08?: Kind; q09?: Kind; q10?: Kind; q11?: Kind; q12?: Kind; q13?: Kind; q14?: Kind; q15?: Kind; q16?: Kind; q17?: Kind; q18?: Kind; q19?: Kind; q20?: Kind; q21?: Kind; q22?: Kind; q23?: Kind; q24?: Kind; q25?: Kind; q26?: Kind; q27?: Kind; q28?: Kind; q29?: Kind; q30?: Kind; q31?: Kind; q32?: Kind; q33?: Kind; q34?: Kind; q35?: Kind; q36?: Kind; q37?: Kind; q38?: Kind; q39?: Kind; q40?: Kind; q41?: Kind; q42?: Kind; q43?: Kind; q44?: Kind; q45?: Kind; q46?: Kind; q47?: Kind; q48?: Kind; q49?: Kind; q50?: Kind; q51?: Kind; q52?: Kind; q53?: Kind; q54?: Kind; q55?: Kind; q56?: Kind; q57?: Kind; q58?: Kind; q59?: Kind; }
  const Crowded = function (this: Crowded, id: number) { this.id = id; } as unknown as new (id: number) => Crowded;
  function crowded(id: number, kind: Kind | undefined): Crowded {
    const one = new Crowded(id);
    if (!kind) return one;
    one.q00 = kind; one.q01 = kind; one.q02 = kind; one.q03 = kind; one.q04 = kind; one.q05 = kind; one.q06 = kind; one.q07 = kind; one.q08 = kind; one.q09 = kind; one.q10 = kind; one.q11 = kind; one.q12 = kind; one.q13 = kind; one.q14 = kind; one.q15 = kind; one.q16 = kind; one.q17 = kind; one.q18 = kind; one.q19 = kind; one.q20 = kind; one.q21 = kind; one.q22 = kind; one.q23 = kind; one.q24 = kind; one.q25 = kind; one.q26 = kind; one.q27 = kind; one.q28 = kind; one.q29 = kind; one.q30 = kind; one.q31 = kind; one.q32 = kind; one.q33 = kind; one.q34 = kind; one.q35 = kind; one.q36 = kind; one.q37 = kind; one.q38 = kind; one.q39 = kind; one.q40 = kind; one.q41 = kind; one.q42 = kind; one.q43 = kind; one.q44 = kind; one.q45 = kind; one.q46 = kind; one.q47 = kind; one.q48 = kind; one.q49 = kind; one.q50 = kind; one.q51 = kind; one.q52 = kind; one.q53 = kind; one.q54 = kind; one.q55 = kind; one.q56 = kind; one.q57 = kind; one.q58 = kind; one.q59 = kind;
    return one;
  }
  function lateOf(one: Crowded): number { const late = one.late; if (late) return late.id; return -1; }
  function laterOf(one: Crowded): Kind | undefined { return one.later; }
  function hasLate(one: Crowded): boolean { return "late" in one; }
  function hasLater(one: Crowded): boolean { return Object.hasOwn(one, "later"); }
  const pool: Crowded[] = [];
  for (let i = 0; i < 300; i++) pool.push(crowded(i, kinds[i]));
  for (let i = 0; i < 300; i++) {
    const one = pool[i];
    if (i % 3 === 0) one.late = kinds[i];
    if (i % 3 === 1) one.late = undefined;
    if (i % 4 === 0) one.later = undefined;
    if (i % 4 === 1) one.later = kinds[i + 1];
  }
  let t = 0, present = 0;
  for (let round = 0; round < 30; round++) for (const one of pool) { t += lateOf(one); const later = laterOf(one); if (later) t += later.id; if (hasLate(one)) present++; if (hasLater(one)) present += 1000; }
  say("outside the cell", [t, present]);
  say("listed without storage", [0, 1, 2, 3, 4, 5].map(i => [lateOf(pool[i]), laterOf(pool[i])?.id, hasLate(pool[i]), hasLater(pool[i]), Object.keys(pool[i]).filter(key => key.startsWith("l")).join()]));
  put(Crowded.prototype, 7, kinds[50]); names.push("late");
  put(Crowded.prototype, 7, kinds[50]);
  say("the prototype has it", [0, 1, 2].map(i => [lateOf(pool[i]), hasLate(pool[i]), Object.hasOwn(pool[i], "late")]));
  remove(Crowded.prototype, 7); remove(Crowded.prototype, 0);
  say("no longer", [0, 1, 2].map(i => [lateOf(pool[i]), hasLate(pool[i])]));
}

console.log(lines.join("\n"));
//// reflect-and-object-functions-change-the-fields-of-an-instance-and-of-a-record.ts
// Thirteen ways to delete, redefine, store to, freeze or move an object, each on an instance of a class and on a typed record, and what typed code reads afterwards.
class Point { x: number; y: number; constructor(x: number, y: number) { this.x = x; this.y = y; } sum(): number { return this.x + this.y; } }
type Pair = { x: number; y: number };
function pair(i: number): Pair { return { x: i, y: i + 1 }; }
function total(p: Pair): number { return p.x + p.y; }
const out: string[] = [];
const steps: ((o: object) => unknown)[] = [
  o => Reflect.deleteProperty(o, "x"),
  o => Reflect.defineProperty(o, "x", { get() { return 40; }, configurable: true }),
  o => Reflect.defineProperty(o, "y", { value: "text", writable: false }),
  o => Reflect.set(o, "x", "str"),
  o => Reflect.set({}, "x", 9.5, o),
  o => Reflect.set(Object.create(o), "y", null),
  o => Reflect.setPrototypeOf(o, { get x() { return 77; }, z: 1 }),
  o => Reflect.preventExtensions(o),
  o => Object.freeze(o),
  o => Object.seal(o),
  o => Object.defineProperties(o, { x: { enumerable: false }, w: { value: 1 } }),
  o => Object.assign(o, { x: undefined, y: 2n }),
  o => { delete (o as any).y; (o as any).y = 5; (o as any).x = 6; },
];
for (const step of steps) {
  for (const o of [new Point(1, 2), pair(1)] as (Point | Pair)[]) {
    let r: unknown; try { r = step(o); } catch (e) { r = (e as Error).name; }
    let stored = "ok"; try { o.x = 3; o.y = 4; } catch (e) { stored = (e as Error).name; }
    out.push([typeof r === "object" ? "object" : String(r), o instanceof Point ? String(o.sum()) : String(total(o)), String(o.x), String(o.y), stored, Object.keys(o).join(), JSON.stringify(Object.getOwnPropertyDescriptor(o, "x")), "x" in o, Object.isFrozen(o)].join(" "));
  }
}
console.log(out.join("\n"));
//// reflect-construct-with-every-kind-of-new-target.ts
// Reflect.construct pairs classes, a plain function and built-in classes with other classes, bound functions, proxies and functions whose prototype is no object as new.target.
class A { a: number; s: string; constructor() { this.a = 1; this.s = new.target.name; } who(): string { return "A" + this.a; } }
class B extends A { b: number; constructor() { super(); this.b = 2; } who(): string { return "B" + this.a + this.b; } }
class C { c = 3; who(): string { return "C" + this.c; } }
const F: any = function (this: any) { this.f = 4; };
F.prototype.who = function (this: any) { return "F" + this.f + this.a; };
const bound = A.bind(null);
const proxied = new Proxy(B, {});
const odd = new Proxy(C, { get(t, k, r) { return k === "prototype" ? null : Reflect.get(t, k, r); } });
const G: any = function () {}; G.prototype = 5;
const out: string[] = [];
for (let round = 0; round < 3; round++) {
  for (const [ctor, target] of [[A, A], [A, B], [A, C], [A, F], [B, A], [B, C], [A, bound], [A, proxied], [B, proxied], [A, odd], [A, G], [C, A], [F, A], [F, B], [B, F], [Object, A], [Array, B], [Map, A], [Error, B]] as [any, any][]) {
    let r: string;
    try {
      const o: any = Reflect.construct(ctor, [], target);
      r = [typeof o.who === "function" ? o.who() : "no who", o instanceof A, o instanceof B, o instanceof C, Object.keys(o).join(), o.a, o.b, o.c, o.s, Object.getPrototypeOf(o) === target.prototype].join(" ");
    } catch (e) { r = (e as Error).name + ": " + (e as Error).message; }
    out.push(r);
  }
  if (round === 0) F.prototype = { who() { return "F2"; } };
  if (round === 1) Object.setPrototypeOf(B, C);
}
console.log(out.join("\n"));
//// rest-patterns-slow-paths.js
const show = object => Reflect.ownKeys(object).map(key => String(key) + "=" + JSON.stringify(object[key])).join(",");
const symbol = Symbol.for("rest");

function constantKeys(s) {
  const { a, b, ...rest } = s;
  return [a, b, show(rest)];
}
function computedKey(s, k) {
  const { a, [k]: b, ...rest } = s;
  return [a, b, show(rest)];
}
function numericKey(s) {
  const { 0: zero, a, ...rest } = s;
  return [zero, a, show(rest)];
}
function onlyRest(s) {
  const { ...rest } = s;
  return show(rest);
}

const sources = [
  { a: 1, b: 2, c: 3 },
  { c: 3, b: 2, a: 1, d: 4 },
  { a: 1, [symbol]: 2, c: 3 },
  { 0: "zero", 1: "one", a: 1, c: 3 },
  ["x", "y"],
  "text",
  5,
  Object.create({ a: "inherited" }, { c: { value: 3, enumerable: true }, hidden: { value: 4 } }),
];
const keys = ["b", "c", "missing", symbol, 0, "0", 1.5];

for (let round = 0; round < 3; round++) {
  for (const s of sources) {
    console.log("constant", constantKeys(s).join(" "));
    console.log("numeric", numericKey(s).join(" "));
    console.log("only rest", onlyRest(s));
    for (const k of keys) console.log("computed", String(k), computedKey(s, k).map(String).join(" "));
  }
}

const log = [];
const loggingKey = {
  toString() {
    log.push("toString");
    return "b";
  },
};
const loggingSource = {
  a: 1,
  get b() {
    log.push("get b");
    return 2;
  },
  get c() {
    log.push("get c");
    return 3;
  },
};
console.log("key object", computedKey(loggingSource, loggingKey).join(" "), log.join(","));

const throwingKey = {
  toString() {
    throw new RangeError("no key");
  },
};
try {
  computedKey(loggingSource, throwingKey);
} catch (error) {
  console.log(error.name, error.message);
}

const proxyLog = [];
const proxy = new Proxy(
  { a: 1, b: 2, c: 3 },
  {
    ownKeys(target) {
      proxyLog.push("ownKeys");
      return Reflect.ownKeys(target);
    },
    getOwnPropertyDescriptor(target, key) {
      proxyLog.push("getOwnPropertyDescriptor " + String(key));
      return Reflect.getOwnPropertyDescriptor(target, key);
    },
    get(target, key) {
      proxyLog.push("get " + String(key));
      return target[key];
    },
  },
);
console.log("proxy", constantKeys(proxy).join(" "), proxyLog.join(","));

for (const nullish of [null, undefined]) {
  for (const attempt of [() => constantKeys(nullish), () => computedKey(nullish, "a"), () => onlyRest(nullish)]) {
    try {
      attempt();
      console.log("no error");
    } catch (error) {
      console.log(error.name);
    }
  }
}

for (let round = 0; round < 3; round++) {
  const { absent, ...rest } = { a: 1, b: 2 };
  console.log("absent name", absent, show(rest));
}
//// rest-patterns-that-leave-out-many-names.js
// A rest pattern that leaves out dozens of names copies what is left, in the order of creation, from sources with many sets and orders of keys.
const lines = [];
const show = object =>
  Reflect.ownKeys(object)
    .map(key => {
      const { value, get, writable, enumerable, configurable } = Object.getOwnPropertyDescriptor(object, key);
      return String(key) + "=" + (get ? "getter" : String(value)) + (writable && enumerable && configurable ? "" : "!");
    })
    .join(",");

const tag = Symbol("tag");
const other = Symbol("other");
const taken = JSON.parse('["a0","a7","b3","c9","d3","b0"]');
const kept = JSON.parse('["width","height","margin","padding","gap","wrap","grow","shrink","basis","display","overflow","position"]');

function component({
  a0, a1, a2, a3, a4, a5, a6, a7, a8, a9,
  b0, b1, b2, b3, b4, b5, b6, b7, b8, b9,
  c0, c1, c2, c3, c4, c5, c6, c7, c8, c9,
  d0, d1, d2, d3,
  ...style
}) {
  style.wrap ??= "nowrap";
  style.grow ??= 0;
  return [style, (a0 ?? 0) + (a7 ?? 0) + (b3 ?? 0) + (c9 ?? 0) + (d3 ?? 0) + (b0 ?? 0)];
}

// The same first name and as many names as `component` leaves out.
function sibling({
  a0, e1, e2, e3, e4, e5, e6, e7, e8, e9,
  f0, f1, f2, f3, f4, f5, f6, f7, f8, f9,
  g0, g1, g2, g3, g4, g5, g6, g7, g8, g9,
  width, height, margin, padding,
  ...others
}) {
  return others;
}

const few = ({ a0, width, ...others }) => others;
const withComputedKey = (source, key) => {
  const { a0, [key]: value, b3, c9, a7, d3, b0, margin, gap, ...others } = source;
  return [others, value];
};

// A set and an order of keys for each seed.
function props(seed) {
  const object = {};
  for (let i = 0; i < kept.length; i++) {
    const index = (i * 5 + seed) % kept.length;
    if ((seed >> index % 7) & 1) object[kept[index]] = seed + index;
    if (i < taken.length && (seed >> i) & 1) object[taken[i]] = -seed - i;
  }
  return object;
}

function digest(text, hash) {
  for (let i = 0; i < text.length; i++) hash = (Math.imul(hash, 31) + text.charCodeAt(i)) | 0;
  return hash;
}

function round(numberOfSeeds) {
  let hash = 7;
  let sum = 0;
  for (let seed = 0; seed < numberOfSeeds; seed++) {
    const source = props(seed);
    const before = show(source);
    const [style, total] = component(source);
    sum += total;
    hash = digest(show(style), hash);
    hash = digest(show(sibling(source)), hash);
    hash = digest(show(few(source)), hash);
    const [others, value] = withComputedKey(source, kept[seed % kept.length]);
    hash = digest(show(others) + String(value), hash);
    if (show(source) !== before) lines.push("the source changed: " + seed);
  }
  return hash + " " + sum;
}

