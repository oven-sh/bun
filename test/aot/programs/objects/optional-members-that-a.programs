//// plain-objects-of-two-files-share-a-layout/main.ts
// Two files make plain objects with the same names. They share one layout, and each file knows `run` by the function type that it writes itself: what either stores is read and called through the other's type.
import { one } from "./one";
import { two } from "./two";

const first = one({ skipped: 0, run: () => 1, size: 10 });
const second = two({ skipped: 0, run: () => 2, size: 20 });
let either = first;
console.log(either.run(), either.size);
either = second;
console.log(either.run(), either.size);
for (const rest of [first, second, first]) console.log(rest.run() + rest.size, Object.keys(rest).join(), JSON.stringify(rest));
second.run = first.run;
console.log(second.run(), "skipped" in second);
//// plain-objects-of-two-files-share-a-layout/one.ts
export function one(value: { skipped: number; run: () => number; size: number }) {
  const { skipped, ...rest } = value;
  return rest;
}
//// plain-objects-of-two-files-share-a-layout/two.ts
export function two(value: { skipped: number; run: () => number; size: number }) {
  const { skipped, ...rest } = value;
  return rest;
}
//// polymorphic-accessor-reads.ts
// One place in the program reads the same name from objects of many kinds: literals that mix data members and getters, literals of getters only, plain records, class instances.
const lines: string[] = [];
function say(label: string, value: unknown): void { lines.push(label + ": " + String(value)); }
interface Named { readonly id: string }
function idOf(from: Named): string { return from.id; }
function colorOf(from: any): unknown { return from.color; }

interface Sized extends Named { size: number }
interface Weighed extends Named { weight: number; height: number }
function mixed(id: string): Sized { return { size: 1, get id() { return "mixed " + id; } }; }
function mixedOtherwise(id: string): Weighed { return { weight: 2, height: 3, get id() { return "otherwise " + id; } }; }
function gettersOnly(id: string): Named { return { get id() { return "getter " + id; } }; }
function record(id: string): Named { return { id: "record " + id }; }
class Instance implements Named { constructor(private readonly name: string) {} get id(): string { return "instance " + this.name; } }
class Holder implements Named { id: string; constructor(name: string) { this.id = "holder " + name; } }

const all: Named[] = [mixed("a"), mixedOtherwise("b"), gettersOnly("c"), record("d"), new Instance("e"), new Holder("f")];
let seen = "";
for (let round = 0; round < 200; round++) for (const one of all) { const id = idOf(one); if (round === 199) seen += id + "; "; }
say("six kinds through one place", seen);

const first = all[0] as any;
const second = all[1] as any;
seen = "";
for (let round = 0; round < 200; round++) for (const one of all) { const color = colorOf(one); if (round === 199) seen += String(color) + " "; }
say("a name none of them has", seen);
first.color = "red";
second.color = "blue";
seen = "";
for (let round = 0; round < 200; round++) for (const one of all) { const color = colorOf(one); if (round === 199) seen += String(color) + " "; }
say("two of them have it now", seen);
Object.defineProperty(first, "id", { get() { return "another getter"; }, enumerable: true, configurable: true });
Object.defineProperty(second, "id", { value: "a value", enumerable: true, configurable: true, writable: true });
delete first.color;
seen = "";
for (let round = 0; round < 200; round++) for (const one of all) { const id = idOf(one) + "/" + String(colorOf(one)); if (round === 199) seen += id + "; "; }
say("after changes", seen);

const many: Named[] = [];
for (let i = 0; i < 60; i++) many.push(i % 3 === 0 ? mixed("m" + i) : i % 3 === 1 ? mixedOtherwise("o" + i) : record("r" + i));
let total = 0;
for (let round = 0; round < 30; round++) for (const one of many) total += idOf(one).length;
say("sixty objects of three kinds", total);
let garbage: unknown[] = [];
for (let i = 0; i < 150000; i++) { garbage.push({ i, get twice() { return i * 2; } }); if (garbage.length > 1000) garbage = []; if (i % 50000 === 0) { let now = ""; for (const one of all) now += idOf(one).length + ","; say("while garbage is made", now); } }
console.log(lines.join("\n"));
//// properties-added-by-evaluated-text.ts
// Compiled code never adds a property to these objects, so nothing in them is set aside for one. Evaluated text adds names, symbols, elements and accessors, redefines and
// deletes fields, changes the prototype and freezes. Typed code reads and writes the fields before and after, and many objects are altered so that each keeps its own.
function outcome(f: () => unknown): string { try { return JSON.stringify(f()) ?? "undefined" } catch (e) { return "throws " + (e as Error).name } }
function show(label: string, ...parts: unknown[]): void { console.log(label + ": " + parts.map(String).join(" | ")) }

class Item {
  constructor(public id: number, public label: string, public on: boolean) {}
  title(): string { return this.label + "#" + this.id + (this.on ? "+" : "-") }
}
type Entry = { id: number, label: string, on: boolean }

const alterations: Record<string, (o: any, n: number) => unknown> = (0, eval)(`({
  "a name"(o, n) { o.extra = "extra" + n; },
  "three names"(o, n) { o.p = n; o.q = n + 1; o.r = n + 2; },
  "a symbol"(o, n) { o[Symbol.for("added")] = n; },
  "an element"(o, n) { o[0] = n; },
  "an accessor"(o, n) { Object.defineProperty(o, "computed", { get() { return this.id + n; }, enumerable: true, configurable: true }); },
  "a hidden name"(o, n) { Object.defineProperty(o, "hidden", { value: n }); },
  "a name that hides a method"(o, n) { o.title = function () { return "own title " + n; }; },
  "a field becomes an accessor"(o, n) { Object.defineProperty(o, "label", { get() { return "got" + n; }, set(v) {}, enumerable: true, configurable: true }); },
  "a field becomes read-only"(o, n) { Object.defineProperty(o, "id", { writable: false }); },
  "a field holds another kind of value"(o, n) { o.id = "text" + n; o.on = { n }; },
  "a field is deleted"(o, n) { delete o.label; },
  "a field is deleted and added again"(o, n) { delete o.id; o.id = n; },
  "forty names"(o, n) { for (let i = 0; i < 40; i++) o["k" + i] = n + i; },
  "a name, then another prototype"(o, n) { o.extra = n; Object.setPrototypeOf(o, { title() { return "other " + this.extra; } }); },
  "a name, then it is a prototype"(o, n) { o.extra = n; return Object.create(o).extra; },
  "a name, then frozen"(o, n) { o.extra = n; Object.freeze(o); },
  "a name is added and deleted"(o, n) { o.extra = n; delete o.extra; },
  "assigned onto"(o, n) { Object.assign(o, { id: n, more: "more", [Symbol.for("added")]: 1 }); },
})`)

function readTyped(o: Item | Entry): string { return o.id + "," + o.label + "," + o.on }
function readUntyped(o: any): string { return o.id + "," + o.label + "," + o.on }
// Typed code is not shown a field that no longer holds what its type says.
const leavesTheTypes = new Set(["a field holds another kind of value", "a field is deleted"])
function writeTyped(o: Item | Entry, n: number): void { o.id = n; o.label = "written"; o.on = n > 5 }
function seen(o: any): string {
  return [Reflect.ownKeys(o).map(String).join(), JSON.stringify(o), JSON.stringify({ ...o }), Object.entries(o).length, typeof o.title === "function" && typeof o.label === "string" && typeof o.id === "number" ? outcome(() => o.title()) : "no title"].join(" ; ")
}

for (const [kind, create] of [["instance", (n: number) => new Item(n, "item", true)], ["literal", (n: number): Entry => ({ id: n, label: "entry", on: false })]] as const) {
  for (const [name, alter] of Object.entries(alterations)) {
    const o = create(1)
    const untouched = create(2)
    const before = readTyped(o)
    const result = alter(o, 5)
    const read = leavesTheTypes.has(name) ? readUntyped : readTyped
    show(kind + ", " + name, before, result, read(o), seen(o), outcome(() => { writeTyped(o, 7); return readTyped(o) }), seen(o), readTyped(untouched), seen(untouched))
  }
}

// Every object keeps its own additions, across collections.
const items: Item[] = []
for (let i = 0; i < 2000; i++) {
  const item = new Item(i, "n" + i, i % 2 === 0)
  if (i % 4 === 0) alterations["a name"](item, i)
  if (i % 6 === 0) alterations["an element"](item, i)
  if (i % 10 === 0) alterations["a field becomes an accessor"](item, i)
  items.push(item)
}
Bun.gc(true)
let right = 0, ids = 0
for (let i = 0; i < items.length; i++) {
  const item: any = items[i]
  ids += items[i].id
  if ((item.extra === (i % 4 === 0 ? "extra" + i : undefined)) && (item[0] === (i % 6 === 0 ? i : undefined)) && (items[i].label === (i % 10 === 0 ? "got" + i : "n" + i))) right++
}
show("2000 objects", right, ids, items[0].title(), items[1].title(), items[20].title())
export {}
//// property-runs.js
function store(target, i) {
  target.a = i;
  target.b = i + 1;
  target.c = i + 2;
  target.d = i + 3;
  return target;
}

function attempt(label, target, i) {
  try {
    store(target, i);
  } catch (error) {
    console.log(label, error.name);
  }
  console.log(label, JSON.stringify(target), Object.keys(target).join());
}

let sum = 0;
for (let round = 0; round < 100; round++) sum += store({}, round).d;
console.log("fresh", sum, JSON.stringify(store({}, 1)));

const existing = { a: 0, b: 0, c: 0, d: 0 };
for (let round = 0; round < 3; round++) attempt("all exist", existing, round);

attempt("two exist", { b: 0, a: 0 }, 1);
attempt("out of order", { d: 0, c: 0, b: 0, a: 0 }, 2);
attempt("gap", { a: 0, other: 0, b: 0, c: 0, d: 0 }, 3);

attempt("frozen", Object.freeze({ a: 0, b: 0, c: 0, d: 0 }), 4);
attempt("frozen empty", Object.freeze({}), 5);
attempt("sealed", Object.seal({ a: 0, b: 0, c: 0, d: 0 }), 6);
attempt("sealed partial", Object.seal({ a: 0 }), 7);
attempt("non-extensible", Object.preventExtensions({ a: 0, b: 0, c: 0, d: 0 }), 8);
attempt("non-extensible partial", Object.preventExtensions({ c: 0 }), 9);

const log = [];
const proto = { inherited: true };
const instances = [];
for (let round = 0; round < 4; round++) {
  if (round === 2) {
    Object.defineProperty(proto, "c", {
      configurable: true,
      set(value) {
        log.push(value);
      },
    });
  }
  const instance = store(Object.create(proto), round * 10);
  instances.push(instance);
  console.log("setter round", round, JSON.stringify(instance), Object.keys(instance).join(), JSON.stringify(log));
}
console.log("setter log", log.join());

const parent = {};
const child = Object.create(parent);
console.log("before parent", child.a);
store(parent, 20);
console.log("prototype", JSON.stringify(parent), child.a, child.d, Object.keys(child).length);

const dictionary = { x: 1, y: 2, z: 3 };
delete dictionary.x;
attempt("dictionary", dictionary, 30);
attempt("dictionary again", dictionary, 40);

const wide = {};
for (let i = 0; i < 20; i++) wide["k" + i] = i;
attempt("grows", wide, 50);
//// property-runs-into-old-objects.js
// Three named stores in a row into ordinary objects that survived a full collection. The stored values are young cells, so only a write barrier keeps them alive through the young collections that follow.
const keys = ["key"];

function create(i) {
  const target = {};
  target[keys[0]] = i;
  return target;
}

function fill(target, i) {
  target.a = "a" + i;
  target.b = [i];
  target.c = { at: i };
}

function isFilled(target, i) {
  return target.a === "a" + i && target.b[0] === i && target.c.at === i;
}

function garbage(count) {
  let total = 0;
  for (let i = 0; i < count; i++) total += [i, "g" + i].length;
  return total;
}

const old = [];
for (let i = 0; i < 64; i++) old.push(create(i));
Bun.gc(true);

let damaged = 0;
for (let round = 0; round < 200; round++) {
  for (const target of old) fill(target, round);
  garbage(5000);
  for (const target of old) {
    if (!isFilled(target, round)) damaged++;
  }
}
Bun.gc(true);
console.log("damaged", damaged);
console.log(JSON.stringify(old[0]), JSON.stringify(old[63]), Object.keys(old[63]).join());
//// proto-store-in-constructor/impl.js
const own = (o, k) => Object.prototype.hasOwnProperty.call(o, k);
const other = { from: "other" };
class First { constructor(p) { this.__proto__ = p; this.t = 1; } }
class Last { constructor(p) { this.a = 1; this.b = 2; this.__proto__ = p; } }
class Only { constructor(p) { this.__proto__ = p; } }
function Old(p) { this.x = 1; this.__proto__ = p; this.y = 2; }
function run(o, p) { o.r1 = 1; o.__proto__ = p; o.r2 = 2; return o; }
function show(what, make) {
    let right = 0;
    for (let i = 0; i < 40; i++) { const o = make(); if (Object.getPrototypeOf(o) === other && !own(o, "__proto__") && o.from === "other") right++; }
    const o = make();
    console.log(what, right, Object.keys(o).join(), o.from);
}
show("first", () => new First(other));
show("last", () => new Last(other));
show("only", () => new Only(other));
show("function", () => new Old(other));
show("run", () => run({}, other));
// The accessor ignores a value that is neither an object nor null.
{ const o = new First(5); console.log("a number", Object.getPrototypeOf(o) === First.prototype, own(o, "__proto__"), o.t); }
{ const o = new First(null); console.log("null", Object.getPrototypeOf(o), Object.keys(o).join()); }
//// proto-store-in-constructor/main.ts
// `this.__proto__ = p` among the first stores of an untyped constructor, and among a run of stores to a plain object.
import "./impl.js";
//// prototypes-changed-over-and-over.js
// Object.setPrototypeOf and Reflect.setPrototypeOf at sites that run again and again: the same change of the same kind of object, and every case in which the change must be refused, must be seen
// by somebody else, or is no change of a plain object at all
const lines = [];
const first = { name() { return "first"; }, shared() { return 1; } };
const second = { name() { return "second"; }, shared() { return 2; } };
const third = Object.create(first, { name: { value() { return "third"; }, configurable: true, writable: true } });
const prototypes = [first, second, third, null];

function describe(object) {
  const prototype = Object.getPrototypeOf(object);
  return prototype === null ? "none" : object.name() + (object.shared ? object.shared() : "");
}

function changesFreshObjects(turns) {
  const seen = {};
  for (let i = 0; i < turns; i++) {
    const object = { a: i, b: "text" };
    const result = Object.setPrototypeOf(object, prototypes[i % prototypes.length]);
    if (result !== object) lines.push("the result is not the object");
    const what = describe(object) + object.a % 2;
    seen[what] = (seen[what] ?? 0) + 1;
  }
  lines.push("fresh " + JSON.stringify(seen));
}

function changesOneObject(turns) {
  const object = { a: 1 };
  let text = "";
  for (let i = 0; i < turns; i++) {
    if (!Reflect.setPrototypeOf(object, prototypes[(i * 7) % prototypes.length])) lines.push("refused");
    if (i % 97 === 0) text += describe(object) + " ";
  }
  lines.push("one object " + text);
}

class Point {
  constructor(x) { this.x = x; }
  name() { return "point"; }
}
function changesInstances(turns) {
  let sum = 0;
  for (let i = 0; i < turns; i++) {
    const point = new Point(i);
    if (i % 3) Object.setPrototypeOf(point, i % 3 === 1 ? first : Point.prototype);
    sum += point.name().length + (point instanceof Point ? 100 : 0) + point.x % 2;
  }
  lines.push("instances " + sum);
}

function refusals(turns) {
  const counts = {};
  const count = what => { counts[what] = (counts[what] ?? 0) + 1; };
  for (let i = 0; i < turns; i++) {
    const object = { a: i };
    if (i % 4 === 1) Object.preventExtensions(object);
    if (i % 4 === 2) Object.freeze(object);
    if (i % 4 === 3) Object.seal(object);
    try {
      Object.setPrototypeOf(object, first);
      count("changed " + describe(object));
    } catch (error) {
      count(error.constructor.name + " " + (Object.getPrototypeOf(object) === Object.prototype));
    }
    count("reflect " + Reflect.setPrototypeOf(object, second) + " " + Reflect.setPrototypeOf(object, Object.getPrototypeOf(object)));
  }
  lines.push("refusals " + JSON.stringify(counts));
}

function cycles(turns) {
  let refused = 0;
  for (let i = 0; i < turns; i++) {
    const bottom = { level: 0 };
    const middle = { level: 1 };
    const top = { level: 2 };
    Object.setPrototypeOf(bottom, middle);
    Object.setPrototypeOf(middle, top);
    try {
      Object.setPrototypeOf(top, i % 2 ? bottom : middle);
    } catch (error) {
      refused += error instanceof TypeError ? 1 : 0;
    }
    if (Reflect.setPrototypeOf(top, top)) lines.push("an object is its own prototype");
    if (Object.getPrototypeOf(top) !== Object.prototype) lines.push("the top changed");
  }
  lines.push("cycles refused " + refused);
}

// A change in the middle of a chain is seen by reads that went through it before.
function changesAboveReaders(turns) {
  const holder = { kind: "holder" };
  Object.setPrototypeOf(holder, first);
  const readers = [];
  for (let i = 0; i < 8; i++) readers.push(Object.setPrototypeOf({ i }, holder));
  let text = "";
  for (let i = 0; i < turns; i++) {
    Object.setPrototypeOf(holder, i % 2 ? second : first);
    let sum = 0;
    for (const reader of readers) sum += reader.shared();
    if (i < 4 || i === turns - 1) text += readers[i % 8].name() + sum + " ";
  }
  lines.push("above readers " + text);
}

function otherReceivers(turns) {
  const counts = {};
  const count = what => { counts[what] = (counts[what] ?? 0) + 1; };
  for (let i = 0; i < turns; i++) {
    const receivers = [[i], function () {}, () => i, new Map(), new Proxy({}, {}), Object.create(null), new Date(0), /x/, i, "text", true, Symbol.iterator, 10n];
    for (const receiver of receivers) {
      const result = Object.setPrototypeOf(receiver, first);
      if (result !== receiver) lines.push("another result");
      count(typeof receiver + " " + (typeof receiver === "object" || typeof receiver === "function" ? receiver.shared() : Object.getPrototypeOf(receiver) === first));
    }
    for (const receiver of [undefined, null]) {
      try { Object.setPrototypeOf(receiver, first); } catch (error) { count("receiver " + error.constructor.name); }
      try { Reflect.setPrototypeOf(receiver, first); } catch (error) { count("reflect receiver " + error.constructor.name); }
    }
    for (const prototype of [undefined, 1, "text", true, Symbol.iterator]) {
      try { Object.setPrototypeOf({ a: i }, prototype); } catch (error) { count("prototype " + error.constructor.name); }
      try { Reflect.setPrototypeOf({ a: i }, prototype); } catch (error) { count("reflect prototype " + error.constructor.name); }
    }
  }
  lines.push("other receivers " + JSON.stringify(counts));
}

function proxiesAndExtras(turns) {
  let log = 0;
  const watching = new Proxy(first, { get(target, key, receiver) { log++; return Reflect.get(target, key, receiver); } });
  let sum = 0;
  for (let i = 0; i < turns; i++) {
    const object = { a: i };
    if (i % 2) object["extra" + (i % 5)] = i;
    Object.setPrototypeOf(object, i % 3 ? watching : second);
    sum += object.shared();
    if (i % 2 && object["extra" + (i % 5)] !== i) lines.push("an extra property is lost");
    if (Object.keys(object).length !== 1 + (i % 2)) lines.push("keys changed");
  }
  lines.push("proxies " + sum + " " + log);
}

function byValue(turns) {
  const functions = [Object.setPrototypeOf, Reflect.setPrototypeOf, (object, prototype) => Object.setPrototypeOf(object, prototype)];
  let sum = 0;
  for (let i = 0; i < turns; i++) {
    const object = { a: i };
    functions[i % 3](object, i % 2 ? first : second);
    sum += object.shared();
  }
  lines.push("by value " + sum);
}

function acrossCollections(turns) {
  let sum = 0;
  for (let i = 0; i < turns; i++) {
    const own = { shared() { return i; } };
    const object = Object.setPrototypeOf({ a: i }, own);
    if (i % 500 === 499) Bun.gc(true);
    sum += object.shared() + Object.setPrototypeOf({ a: i }, first).shared();
  }
  lines.push("collections " + sum);
}

changesFreshObjects(4000);
changesOneObject(1000);
changesInstances(3000);
refusals(400);
cycles(300);
changesAboveReaders(300);
otherReceivers(60);
proxiesAndExtras(600);
byValue(3000);
acrossCollections(2000);
console.log(lines.join("\n"));
//// proxy-frozen-instance.ts
// Proxies over instances and literals that are frozen, sealed or have a read-only extra property: what a get or set trap answers is checked against the target exactly as in plain Bun.
class Point { x: number = 1; y: number = 2 }

class Forwarding {
  get(t: object, k: PropertyKey): unknown { return Reflect.get(t, k) }
  set(t: object, k: PropertyKey, v: unknown): boolean { return Reflect.set(t, k, v) }
}

function outcome(f: () => unknown): string {
  try {
    return String(f())
  } catch (e) {
    return "threw " + (e as Error).name
  }
}

const key = Symbol("key")

const targets: [string, () => object][] = [
  ["instance", () => new Point()],
  ["frozen instance", () => Object.freeze(new Point())],
  ["sealed instance", () => Object.seal(new Point())],
  ["instance with a read-only extra property", () => Object.defineProperty(new Point(), "extra", { value: 3 })],
  ["frozen instance with an indexed and a symbol property", () => { const o: any = new Point(); o[0] = 7; o[key] = 8; return Object.freeze(o) }],
  ["frozen literal", () => { const literal: { x: number } = { x: 1 }; return Object.freeze(literal) }],
]

const handlers: [string, ProxyHandler<object>][] = [
  ["x is 42", { get: (t, k) => k === "x" ? 42 : Reflect.get(t, k), set: () => true }],
  ["every name is 42", { get: () => 42, set: () => true }],
  ["truthful", { get: (t, k) => Reflect.get(t, k), set: (t, k, v) => Reflect.set(t, k, v) }],
  ["truthful, traps inherited from a class", new Forwarding()],
]

function sumOfY(p: any): number {
  let sum = 0
  for (let i = 0; i < 100; i++) sum += p.y
  return sum
}

for (const [handlerLabel, handler] of handlers) {
  for (const [label, createTarget] of targets) {
    const p: any = new Proxy(createTarget(), handler)
    console.log(handlerLabel + ", " + label + ": " + [
      outcome(() => p.x),
      outcome(() => p.y),
      outcome(() => p.extra),
      outcome(() => p.absent),
      outcome(() => p[0]),
      outcome(() => p[key]),
      outcome(() => { p.x = 9; return "stored" }),
      outcome(() => { p.x = 1; return "stored" }),
      outcome(() => { p[0] = 9; return "stored" }),
      outcome(() => { p[key] = 9; return "stored" }),
      outcome(() => sumOfY(p)),
    ].join(" | "))
  }
}

export {}
//// questions-that-objects-answer-themselves.js
// Reads, `in` and hasOwn, by name and by key, of objects of every kind, each asked often enough to pass from the first question to a filed answer, and again behind every change.
const lines = [];
function hide(value) {
    globalThis[process.argv.length > 99 ? process.argv[9] : "hidden"] = value;
    return globalThis.hidden;
}
function show(value) {
    if (typeof value === "function") return "function " + value.name;
    if (typeof value === "symbol") return value.toString();
    if (typeof value === "bigint") return value + "n";
    if (value === null || typeof value !== "object") return String(value);
    return Array.isArray(value) ? "[" + value.map(show).join() + "]" : "{" + Object.keys(value).join() + "}";
}
const keys = ["alpha", "beta", "gamma", "delta", "toString", "constructor", "__proto__", "length", "name", "0", "1", "10", "-1", "1e3", "hasOwnProperty", "then", "prototype", "valueOf"];
function byName(o) {
    return [o.alpha, o.beta, o.gamma, o.delta, o.toString, o.constructor, o.__proto__ === undefined ? "none" : o.__proto__ === null ? "null" : typeof o.__proto__, o.length, o.name, o["0"], o["1"], o["10"], o["-1"], o["1e3"], o.hasOwnProperty, o.then, o.prototype === undefined ? undefined : typeof o.prototype, o.valueOf].map(show).join(" ");
}
function byKey(o) {
    let text = "";
    for (const key of keys) {
        const value = o[key];
        text += (key === "__proto__" || key === "prototype" ? typeof value : show(value)) + " ";
    }
    return text;
}
function inByName(o) {
    return ["alpha" in o, "beta" in o, "gamma" in o, "delta" in o, "toString" in o, "constructor" in o, "__proto__" in o, "length" in o, "name" in o, "0" in o, "1" in o, "10" in o, "then" in o].map(Number).join("");
}
function ownByName(o) {
    return [Object.hasOwn(o, "alpha"), Object.hasOwn(o, "beta"), Object.hasOwn(o, "gamma"), Object.hasOwn(o, "delta"), Object.hasOwn(o, "toString"), Object.hasOwn(o, "constructor"), Object.hasOwn(o, "__proto__"), Object.hasOwn(o, "length"), Object.hasOwn(o, "name"), Object.hasOwn(o, "0"), Object.hasOwn(o, "10")].map(Number).join("");
}
function inByKey(o) {
    let text = "";
    for (const key of keys) text += Number(key in o);
    return text;
}
function ownByKey(o) {
    let text = "";
    for (const key of keys) text += Number(Object.hasOwn(o, key));
    return text;
}
function ask(title, value) {
    const o = hide(value);
    let answers;
    for (let round = 0; round < 7; round++) {
        let now;
        try {
            now = byName(o) + " | " + byKey(o);
            if (o !== null && (typeof o === "object" || typeof o === "function")) now += " | " + inByName(o) + " " + ownByName(o) + " " + inByKey(o) + " " + ownByKey(o);
        } catch (error) {
            now = "throws " + error.constructor.name;
        }
        if (answers === undefined) answers = now;
        else if (answers !== now) answers += "\n    ROUND " + round + " DIFFERS: " + now;
    }
    lines.push(title + ": " + answers);
}
function built(pairs) {
    const o = {};
    for (const [key, value] of pairs) o[key] = value;
    return o;
}

// Ordinary objects.
ask("built key by key", built([["alpha", 1], ["beta", "two"], ["gamma", 3.5]]));
ask("empty", built([]));
ask("undefined as a value", built([["alpha", undefined], ["beta", null]]));
ask("parsed", JSON.parse('{"alpha":1,"delta":{"x":1},"0":"zero","10":"ten"}'));
ask("names that spell indices", built([["0", "zero"], ["1", "one"], ["alpha", 1], ["1e3", "text"], ["-1", "minus"]]));
ask("no prototype", Object.assign(Object.create(null), { alpha: 1, toString: "mine" }));
ask("own __proto__", Object.defineProperty(built([["alpha", 1]]), "__proto__", { value: 5, enumerable: true, configurable: true, writable: true }));
{
    const many = {};
    for (let k = 0; k < 70; k++) many["p" + k] = k;
    many.alpha = "past the cell"; many.beta = 2;
    ask("storage out of line", many);
    for (let k = 70; k < 300; k++) many["p" + k] = k;
    many.gamma = "in a wide table";
    ask("three hundred properties", many);
    for (let k = 0; k < 300; k += 2) delete many["p" + k];
    delete many.beta;
    ask("a dictionary", many);
    many.beta = "again";
    ask("a dictionary that got a name back", many);
}
{
    const o = built([["alpha", 1], ["beta", 2], ["gamma", 3]]);
    ask("before a deletion", o);
    delete o.beta;
    ask("behind a deletion", o);
    o.beta = "back";
    ask("the name is back", o);
    Object.freeze(o);
    ask("frozen", o);
}

// Accessors.
{
    let calls = 0;
    const o = built([["beta", 2]]);
    Object.defineProperty(o, "alpha", { get() { return "got " + ++calls + " " + (this === globalThis.hidden); }, configurable: true, enumerable: true });
    Object.defineProperty(o, "gamma", { set(value) { }, configurable: true });
    Object.defineProperty(o, "delta", { get: Math.random.bind(null).constructor.prototype.toString.bind(function named() { }), configurable: true });
    const first = hide(o);
    lines.push("getters: " + [first.alpha, first.alpha, first.alpha, first.alpha, first.alpha, first.alpha, first.gamma, first.gamma, first.gamma, first.gamma, first.gamma].join(", ") + " " + ("gamma" in first) + " " + typeof first.delta);
    const below = hide(Object.create(o));
    lines.push("getters above: " + [below.alpha, below.alpha, below.alpha, below.alpha, below.alpha, below["alpha"], below.gamma].join(", "));
    Object.defineProperty(o, "alpha", { get() { throw new RangeError("no alpha"); }, configurable: true });
    for (let round = 0; round < 6; round++) {
        try { below.alpha; lines.push("did not throw"); } catch (error) { if (!round) lines.push("a getter that throws: " + error.message); }
    }
    Object.defineProperty(o, "alpha", { value: "data now", configurable: true });
    lines.push("data in its place: " + [below.alpha, below.alpha, below.alpha, below.alpha, below.alpha].join());
}

// Chains.
{
    const top = built([["alpha", "top"], ["delta", "top"]]);
    const middle = Object.create(top); middle.beta = "middle";
    const bottom = Object.create(middle); bottom.gamma = "bottom";
    ask("three levels", bottom);
    middle.alpha = "middle now";
    ask("shadowed in the middle", bottom);
    delete middle.alpha;
    ask("the shadow is gone", bottom);
    Object.setPrototypeOf(middle, null);
    ask("the chain is cut", bottom);
    Object.setPrototypeOf(middle, new Proxy(top, { get(target, key, receiver) { return key === "delta" ? "trapped" : Reflect.get(target, key, receiver); }, has(target, key) { return key === "delta" || key in target; } }));
    ask("a proxy above", bottom);
    Object.setPrototypeOf(middle, [7, 8]);
    ask("an array above", bottom);
    Object.setPrototypeOf(middle, function above() { });
    ask("a function above", bottom);
    Object.setPrototypeOf(middle, new String("xy"));
    ask("a String object above", bottom);
    Object.setPrototypeOf(middle, top);
    ask("the chain is whole again", bottom);
}

// Compiled objects.
{
    const literal = () => ({ alpha: 1, beta: 2.5, gamma: "text", delta: true });
    ask("a literal", literal());
    const extra = literal(); extra.then = "extra"; extra["name"] = "named";
    ask("a literal with extra properties", extra);
    delete extra.then;
    ask("one extra property less", extra);
    const changed = literal(); changed.alpha = "a string now"; changed.beta = { x: 1 }; changed.delta = undefined;
    ask("values that do not fit", changed);
    const deleted = literal(); delete deleted.beta; delete deleted.gamma;
    ask("fields deleted", deleted);
    deleted.beta = "back";
    ask("a field is back", deleted);
    const indexed = literal(); indexed[0] = "zero"; indexed[10] = "ten";
    ask("a literal with elements", indexed);
    const defined = literal();
    Object.defineProperty(defined, "alpha", { get() { return "getter in place of a field"; }, configurable: true });
    Object.defineProperty(defined, "name", { get() { return "extra getter"; }, configurable: true });
    ask("accessors on a literal", defined);
    ask("created from a literal", Object.assign(Object.create(literal()), { then: 1 }));
    const other = literal(); Object.setPrototypeOf(other, { then: "inherited", get name() { return "inherited getter " + (this === globalThis.hidden); } });
    ask("a literal with another prototype", other);
    ask("a literal without a prototype", Object.setPrototypeOf(literal(), null));
    ask("a frozen literal", Object.freeze(literal()));
    ask("own accessors in a literal", { get alpha() { return "a"; }, set beta(value) { }, get gamma() { return this.delta; }, delta: 4 });
    ask("methods in a literal", { alpha() { }, beta: () => 1, gamma: function () { }, async delta() { } });
    ask("a spread", { ...literal(), then: 2, ...built([["name", "spread in"]]) });
}

// Classes.
{
    class Base { alpha = "base field"; beta() { return 1; } get gamma() { return "base getter " + this.alpha; } static delta = "static"; static then() { } }
    class Derived extends Base { delta = "derived field"; beta() { return 2; } get name() { return "derived getter"; } set name(value) { } }
    ask("an instance", new Base());
    ask("an instance of a derived class", new Derived());
    ask("a class", Base);
    ask("a derived class", Derived);
    ask("a prototype object", Derived.prototype);
    const instance = new Derived();
    instance.then = "extra";
    ask("an instance with an extra property", instance);
    Base.prototype.then = "added to the base";
    ask("the base got a member", new Derived());
    Derived.prototype.beta = "replaced";
    ask("a method is replaced", new Derived());
    delete Base.prototype.gamma;
    ask("a getter is deleted", new Derived());
    Object.setPrototypeOf(Derived.prototype, { alpha: "never seen", length: "new chain" });
    ask("another chain", new Derived());
    function Old() { this.alpha = 1; }
    Old.prototype.beta = function () { };
    Old.prototype.gamma = 3;
    ask("an instance of a constructor function", new Old());
    ask("a constructor function", Old);
}

// Objects whose prototype lies in a slot of their own: what text that is evaluated at run time constructs, once its function has been made more than once.
{
    const makeConstructor = new Function("return function Made() { this.alpha = 1; this.gamma = 3; }");
    for (let k = 0; k < 4; k++) {
        const Made = makeConstructor();
        Made.prototype.beta = "beta " + k;
        new Made();
        ask("constructed by evaluated text " + k, new Made());
        ask("created from it " + k, Object.create(new Made()));
    }
}

// A getter in a field of an object that is the prototype of others.
{
    const holder = { get alpha() { return "getter of the holder, this is the heir: " + (this === globalThis.hidden); }, beta: 2, get gamma() { return this.delta; } };
