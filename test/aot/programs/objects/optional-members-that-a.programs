//// optional-members-that-a-literal-leaves-out-are-read-in-every-way.ts
// What a reader sees of a member that the literal left out: nothing of its own, and whatever the prototypes have.
interface Options {
  a?: number;
  b?: string;
  c?: boolean;
  d?: number;
  e?: { deep?: number };
  f?: () => number;
}

const made: Options[] = [];
made.push({});
made.push({ a: 1 });
made.push({ b: "b" });
made.push({ c: false });
made.push({ d: 0.25 });
made.push({ e: {} });
made.push({ e: { deep: 7 } });
made.push({ f: () => 3 });
made.push({ a: 2, f() { return (this.a ?? 0) + 1; } });
made.push({ a: undefined });
made.push({ d: -0, c: true });

function read(o: Options): string {
  const own = ["a", "b", "c", "d", "e", "f"].map(name => (Object.hasOwn(o, name) ? 1 : 0)).join("");
  const has = [("a" in o), ("b" in o), ("c" in o), ("d" in o), ("e" in o), ("f" in o)].map(Number).join("");
  const { a = -1, b = "none", c = true, d = -2 } = o;
  return [o.a, o.b, o.c, Object.is(o.d, -0) ? "-0" : o.d, o.e?.deep, o.f?.(), own, has, a, b, c, Object.is(d, -0) ? "-0" : d, JSON.stringify(o), Object.entries(o).length, o.a === undefined, typeof o.f].join(" ");
}

for (const o of made) console.log(read(o));
let sum = 0;
for (let i = 0; i < 2000; i++) {
  const o = made[i % made.length];
  sum += (o.a ?? 10) + (o.d ?? 100) + (o.b?.length ?? 1000) + (o.c ? 1 : 0);
}
console.log(sum);

const above: Options = { d: 42, b: "inherited" };
for (const o of made) Object.setPrototypeOf(o, above);
for (const o of made) console.log(read(o));
for (const o of made) Object.setPrototypeOf(o, Object.prototype);
for (const o of made) console.log(read(o));

const parent: Options = { a: 5, c: true };
const child: Options = Object.setPrototypeOf({ b: "own" } as Options, parent);
console.log(read(child), child.a, child.c);
//// optional-members-that-a-literal-leaves-out-arrive-later-in-ways-nobody-sees.ts
// A literal leaves out optional members of the type it is written under, and no `o.name = v` in the program stores them. They arrive all the same.
interface Options {
  host?: string;
  port?: number;
  secure?: boolean;
  ratio?: number;
  tags?: string[];
}

function describe(options: Options): string {
  return `${options.host} ${options.port} ${options.secure} ${options.ratio} ${options.tags?.join("+")} | ${Object.keys(options).join(",")}`;
}

function underComputedKey(key: string, value: unknown): Options {
  const options: Options = { host: "a" };
  (options as Record<string, unknown>)[key] = value;
  return options;
}

function byAssign(more: Options): Options {
  const options: Options = { port: 1 };
  Object.assign(options, more);
  return options;
}

function byDefinition(): Options {
  const options: Options = { secure: true };
  Object.defineProperty(options, "ratio", { value: 0.5, enumerable: true, writable: true, configurable: true });
  Object.defineProperty(options, "tags", { get: () => ["g"], enumerable: false, configurable: true });
  return options;
}

function fill(this: Options, port: number): void {
  this.port = port;
  this.ratio = port / 4;
}

function byThis(): Options {
  const options: Options = { host: "t" };
  fill.call(options, 9);
  return options;
}

function byReflection(): Options {
  const options: Options = {};
  Reflect.set(options, "tags", ["r"]);
  Reflect.set(options, "secure", false);
  return options;
}

for (let round = 0; round < 3; round++) {
  console.log(describe(underComputedKey("port", 80 + round)));
  console.log(describe(underComputedKey("tags", ["x", String(round)])));
  console.log(describe(underComputedKey("other", round)));
  console.log(describe(byAssign({ host: "h", ratio: 1.5, tags: [] })));
  console.log(describe(byAssign({})));
  console.log(describe(byDefinition()));
  console.log(describe(byThis()));
  console.log(describe(byReflection()));
}
//// ordinary-object-literals.js
function show(label, value) {
  console.log(label, JSON.stringify(value), Object.keys(value).join());
}

function indexesBetweenNames(i) {
  return { a: i, 2: "two", b: i + 1, 0: "zero", c: i + 2 };
}
show("indexes", indexesBetweenNames(1));

function oneNameBesideIndex(i) {
  return { a: i, 7: "seven" };
}
show("one name and an index", oneNameBesideIndex(2));
show("only an index", { 5: "five" });

function manyNames() {
  return { p0: 0, p1: 1, p2: 2, p3: 3, p4: 4, p5: 5, p6: 6, p7: 7, p8: 8, p9: 9, p10: 10, p11: 11, p12: 12, p13: 13, p14: 14, p15: 15, p16: 16, p17: 17, p18: 18, p19: 19, p20: 20, p21: 21, p22: 22, p23: 23, p24: 24, p25: 25, p26: 26, p27: 27, p28: 28, p29: 29, p30: 30, p31: 31, p32: 32, p33: 33, p34: 34, p35: 35, p36: 36, p37: 37, p38: 38, p39: 39 };
}
const many = manyNames();
show("many", many);
console.log("many last", many.p39, Object.keys(many).length);

function withoutPrototype(i) {
  return { __proto__: null, x: i, y: i + 1 };
}
const bare = withoutPrototype(3);
console.log("null prototype", Object.getPrototypeOf(bare), Object.keys(bare).join(), bare.x, bare.y, bare.toString);

function oneName(i) {
  return { only: i };
}
show("one name", oneName(4));

function point(i) {
  return { alpha: i, beta: i + 1, gamma: i + 2 };
}
let sum = 0;
const seen = [];
for (let round = 0; round < 100; round++) {
  const value = point(round);
  sum += value.alpha + value.beta + value.gamma;
  if (round % 33 === 0) seen.push(value);
}
console.log("loop", sum, seen[0] !== seen[1], JSON.stringify(seen));
console.log("key order", Object.keys(point(0)).join());

console.log("inherited", point(1).hasOwnProperty("alpha"), point(1).hasOwnProperty("toString"), point(1).hasOwnProperty("missing"));
show("after lookups", point(2));

const holes = [, 1];
function fromHole(list) {
  return { first: list[0], second: list[1] };
}
const filled = fromHole(holes);
console.log("hole", "first" in filled, filled.first === undefined, Object.keys(filled).join(), filled.second);
//// own-accessors-in-slots.ts
// Own accessors, read in every way and changed in every way. Prints one line a case: the same under any engine.
const lines: string[] = [];
////= show-2
function attempt(run: () => unknown): unknown {
    try { return run(); } catch (error) { return "threw " + (error as Error).name + ": " + (error as Error).message.slice(0, 60); }
}
let calls = 0;

// 1. plain getters of a literal, read by name, in a loop
const plain = { get first() { calls++; return 1; }, get second() { calls++; return "two"; }, third: 3 };
function readPlain() { return plain.first + plain.second + plain.third; }
for (let i = 0; i < 3; i++) show("plain", readPlain(), calls);

// 2. this
const usesThis = { base: 10, get twice() { return this.base * 2; } };
show("this", usesThis.twice, (usesThis.base = 21, usesThis.twice));
const heir = Object.create(usesThis); heir.base = 4;
show("this through a prototype", heir.twice, Reflect.get(usesThis, "twice", { base: 100 }));
show("this through a proxy", new Proxy(usesThis, {}).twice, new Proxy(usesThis, { get: (target, key, receiver) => key === "base" ? 7 : Reflect.get(target, key, receiver) }).twice);

// 3. a pair
const pair = { held: 0, get value() { return this.held + 1; }, set value(next: number) { this.held = next * 10; } };
pair.value = 5;
show("pair", pair.value, pair.held, Object.keys(pair), typeof Object.getOwnPropertyDescriptor(pair, "value")!.set);
const setterFirst = { held: 0, set value(next: number) { this.held = next; }, get value() { return this.held - 1; } };
setterFirst.value = 9;
show("pair, setter first", setterFirst.value);
const setterAlone: any = { held: 1, set only(next: number) { this.held = next; } };
show("setter alone", setterAlone.only, (setterAlone.only = 3, setterAlone.held));

// 4. a store to a getter without a setter throws in strict code
const readOnly: any = { get fixed() { return 1; } };
show("store without a setter", attempt(() => { readOnly.fixed = 2; return "stored"; }), readOnly.fixed);

// 5. a getter that throws
const thrower = { get bad(): number { throw new RangeError("from the getter"); }, good: 1 };
function readBad() { return thrower.bad; }
for (let i = 0; i < 2; i++) show("throws", attempt(readBad), thrower.good);

// 6. a getter that makes a value of itself
const lazy: any = { get once() { calls++; Object.defineProperty(this, "once", { value: "made", writable: true, enumerable: true, configurable: true }); return "making"; } };
function readOnce() { return lazy.once; }
show("redefines itself", readOnce(), readOnce(), readOnce(), Object.getOwnPropertyDescriptor(lazy, "once"));
const lazyByDelete: any = { get once() { delete this.once; this.once = "stored"; return "storing"; } };
function readOnceMore() { return lazyByDelete.once; }
show("deletes itself", readOnceMore(), readOnceMore(), Object.keys(lazyByDelete));

// 7. deleted, and back in other forms
const deleted: any = { a: 1, get gone() { return "there"; }, z: 2 };
function readGone() { return deleted.gone; }
show("before the deletion", readGone(), "gone" in deleted, Object.keys(deleted));
delete deleted.gone;
show("deleted", readGone(), "gone" in deleted, Object.hasOwn(deleted, "gone"), Object.keys(deleted));
Object.defineProperty(deleted, "gone", { get: () => "another getter", enumerable: true, configurable: true });
show("back as another getter", readGone(), Object.keys(deleted));
delete deleted.gone; deleted.gone = "a value";
show("back as a value", readGone(), Object.keys(deleted));
delete deleted.gone; Object.setPrototypeOf(deleted, { get gone() { return "inherited"; } });
show("inherited behind the deletion", readGone());

// 8. replaced in place, the same attributes
const replaced: any = { get now() { return "first"; } };
function readNow() { return replaced.now; }
show("as defined", readNow());
Object.defineProperty(replaced, "now", { get() { return "second"; } });
show("another function", readNow(), Object.getOwnPropertyDescriptor(replaced, "now")!.enumerable);
Object.defineProperty(replaced, "now", { get: Math.random.bind(null).constructor === Function ? (function (this: unknown) { return "bound " + this; }).bind("receiver") : undefined });
show("a bound function", readNow());
Object.defineProperty(replaced, "now", { get: new Proxy(function () { return "behind a proxy"; }, {}) });
show("a proxy of a function", readNow());
Object.defineProperty(replaced, "now", { get: Date.now });
show("a native function", typeof readNow());
Object.defineProperty(replaced, "now", { get: undefined });
show("no getter", readNow(), Object.getOwnPropertyDescriptor(replaced, "now"));
Object.defineProperty(replaced, "now", { value: 5 });
show("a value", readNow(), Object.getOwnPropertyDescriptor(replaced, "now"));

// 9. only an attribute changes
const hidden: any = { get seen() { return "still"; }, other: 1 };
Object.defineProperty(hidden, "seen", { enumerable: false });
show("no longer enumerable", hidden.seen, Object.keys(hidden), JSON.stringify(hidden), Object.getOwnPropertyDescriptor(hidden, "seen")!.configurable);

// 10. frozen, sealed
const frozen: any = Object.freeze({ get cold() { return "cold"; }, value: 1 });
function readCold() { return frozen.cold; }
show("frozen", readCold(), Object.isFrozen(frozen), Object.getOwnPropertyDescriptor(frozen, "cold")!.configurable, attempt(() => delete frozen.cold), attempt(() => Object.defineProperty(frozen, "cold", { get: () => 1 })), readCold());
const sealed: any = Object.seal({ get shut() { return "shut"; } });
show("sealed", sealed.shut, Object.isSealed(sealed), Object.isFrozen(sealed), attempt(() => delete sealed.shut));
const closed: any = Object.preventExtensions({ get kept() { return "kept"; } });
delete closed.kept;
show("not extensible, deleted", closed.kept, attempt(() => Object.defineProperty(closed, "kept", { get: () => 1, configurable: true, enumerable: true })));

// 11. whoever walks the properties
let walked = 0;
const walkedObject = { a: 1, get b() { walked++; return 2; }, c: 3, get d() { walked++; return { deep: true }; } };
show("keys", Object.keys(walkedObject), Object.getOwnPropertyNames(walkedObject), Reflect.ownKeys(walkedObject), walked);
show("values", Object.values(walkedObject), Object.entries(walkedObject), walked);
show("JSON", JSON.stringify(walkedObject), walked);
show("spread", { ...walkedObject }, Object.getOwnPropertyDescriptor({ ...walkedObject }, "b"), walked);
show("assign", Object.assign({}, walkedObject), Object.assign({ b: 0 }, walkedObject).b, walked);
const { b: taken, ...rest } = walkedObject;
show("rest", taken, rest, walked);
const names: string[] = []; for (const name in walkedObject) names.push(name);
show("for in", names, walked);
show("structuredClone", structuredClone(walkedObject), walked);
show("descriptors", Object.keys(Object.getOwnPropertyDescriptors(walkedObject)), typeof Object.getOwnPropertyDescriptors(walkedObject).b.get, Object.getOwnPropertyDescriptors(walkedObject).b.set);
show("the same function", Object.getOwnPropertyDescriptor(walkedObject, "b")!.get === Object.getOwnPropertyDescriptor(walkedObject, "b")!.get, Object.getOwnPropertyDescriptor(walkedObject, "b")!.get!.name);
show("lookupGetter", (walkedObject as any).__lookupGetter__("b") === Object.getOwnPropertyDescriptor(walkedObject, "b")!.get, (walkedObject as any).__lookupGetter__("a"));
show("propertyIsEnumerable", Object.prototype.propertyIsEnumerable.call(walkedObject, "b"), Object.hasOwn(walkedObject, "d"), "d" in walkedObject);

// 12. closures: one function, many objects
function counter(start: number, step: number) {
    let current = start;
    return { get next() { current += step; return current; }, get start() { return start; } };
}
const byOne = counter(0, 1), byTen = counter(100, 10);
function drain(source: { readonly next: number; readonly start: number }) { return source.next + source.next + source.start; }
show("closures", drain(byOne), drain(byTen), drain(byOne), drain(byTen));

// 13. one shape, other functions
function shapeA() { return { get kind() { return "A"; }, size: 1 }; }
function shapeB() { return { get kind() { return "B"; }, size: 2 }; }
function shapeC() { return { kind: "C", size: 3 }; }
function kindOf(thing: { readonly kind: string; size: number }) { return thing.kind + thing.size; }
show("three makers", [shapeA(), shapeB(), shapeC(), shapeA(), shapeC(), shapeB()].map(kindOf));

// 14. defineProperty under constant names, every form
const defined: any = {};
Object.defineProperty(defined, "plain", { get: () => "plain" });
Object.defineProperty(defined, "listed", { get: () => "listed", enumerable: true });
Object.defineProperty(defined, "loose", { get: () => "loose", configurable: true });
Object.defineProperty(defined, "both", { get: () => "both", enumerable: true, configurable: true });
function readDefined() { return [defined.plain, defined.listed, defined.loose, defined.both]; }
show("defined", readDefined(), Object.keys(defined), attempt(() => delete defined.plain), delete defined.loose, readDefined());
show("defined twice", attempt(() => Object.defineProperty(defined, "plain", { get: () => "again" })), attempt(() => Object.defineProperty(defined, "both", { get: () => "again" })), readDefined());

// 15. built by a loop
const table = { ALPHA: (text: string) => text + "!", BETA: (text: string) => text + "?", GAMMA: (text: string) => text.toUpperCase() };
function build(shape: Record<string, (text: string) => string>): any {
    const accessor = {};
    for (const key of Object.keys(shape)) {
        const parse = shape[key]!;
        Object.defineProperty(accessor, key, { enumerable: true, configurable: true, get: () => parse(key.toLowerCase()) });
    }
    return accessor;
}
const built = build(table) as { ALPHA: string; BETA: string; GAMMA: string };
function readBuilt() { return built.ALPHA + built.BETA + built.GAMMA; }
show("built by a loop", readBuilt(), Object.keys(built), (built as any).DELTA);
Object.defineProperty(built, "BETA", { value: "pinned", configurable: true });
show("one of them pinned", readBuilt());
delete (built as any).ALPHA;
show("one of them deleted", readBuilt(), Object.keys(built));

// 16. other keys
const mark = Symbol("mark");
const otherKeys: any = { get [mark]() { return "symbol"; }, get 0() { return "index"; }, get ["comp" + "uted"]() { return "computed"; }, get "with space"() { return "quoted"; } };
show("other keys", otherKeys[mark], otherKeys[0], otherKeys.computed, otherKeys["with space"], Reflect.ownKeys(otherKeys));

// 17. super in a getter
const below = { __proto__: { get word() { return "above"; } }, get word(): string { return "below " + super.word; } };
show("super", below.word);

// 18. an object with getters as a prototype
class OnTop { declare inherited: string; own = "own"; }
Object.setPrototypeOf(OnTop.prototype, { get inherited() { return "from " + (this as any).own; } });
function readInherited(top: OnTop) { return top.inherited; }
show("under a class", readInherited(new OnTop()), readInherited(new OnTop()));

// 19. by key
const byKey: any = { get one() { return 1; }, get two() { return 2; }, three: 3 };
let sum = 0; for (const key of ["one", "two", "three", "four", "one"]) sum += byKey[key] ?? 100;
show("by key", sum);

// 20. defineGetter
const old: any = { kept: 1 };
old.__defineGetter__("late", function (this: any) { return this.kept + 1; });
show("defineGetter", old.late, Object.getOwnPropertyDescriptor(old, "late")!.enumerable, Object.keys(old));

// 21. a getter that changes its neighbours
const shifty: any = { get a() { delete this.b; return "a"; }, get b() { return "b"; }, get c() { Object.defineProperty(this, "a", { get: () => "new a", configurable: true, enumerable: true }); return "c"; } };
function readShifty() { return [shifty.a, shifty.b, shifty.c, shifty.a]; }
show("neighbours", readShifty(), readShifty(), Object.keys(shifty));

// 22. many objects, and collections in between
let total = 0;
for (let i = 0; i < 20000; i++) { const made = counter(i, 2); total += made.next + made.start; if (i % 5000 === 0) Bun.gc(true); }
show("many", total);

// 23. what a getter returns
const mixed = { turn: 0, get any(): unknown { this.turn++; return [1, "s", null, undefined, { o: 1 }, 1.5, true][this.turn % 7]; } };
const seen: unknown[] = []; for (let i = 0; i < 8; i++) seen.push(mixed.any);
show("mixed results", seen);

// 24. typeof, optional chains, calls of what a getter returns
const callable = { get run() { return function (this: unknown) { return this === callable; }; }, get nothing() { return undefined; } };
show("called", callable.run(), typeof callable.run, (callable as any).nothing?.deep, String(attempt(() => (callable as any).nothing())).slice(0, 15));

// 25. compound stores
const compound = { held: 1, get n() { return this.held; }, set n(value: number) { this.held = value; } };
compound.n += 4; compound.n++; compound.n *= 2;
show("compound", compound.n, compound.held);

// 26. class instances that get an own accessor
class Plain { x = 1; }
const decorated: any = new Plain();
Object.defineProperty(decorated, "x", { get: () => "over the field", configurable: true });
Object.defineProperty(decorated, "y", { get: () => "new name", configurable: true });
show("over a field of a class", decorated.x, decorated.y, new Plain().x);

console.log(lines.join("\n"));
//// own-accessors-on-instances.ts
// Own accessors on the instances of classes and of constructor functions, under names that the classes declare or do not declare.
const lines: string[] = [];
function show(name: string, ...values: unknown[]) { lines.push(name + ": " + values.map(value => typeof value === "function" ? "function " + value.name : JSON.stringify(value) ?? String(value)).join(" | ")); }
function attempt(run: () => unknown): unknown { try { return run(); } catch (error) { return "threw " + (error as Error).name; } }

class Meter {
    declare reading: number;
    scale = 2;
    constructor(private raw: number) { Object.defineProperty(this, "reading", { get: () => this.raw * this.scale, enumerable: true, configurable: true }); }
    bump() { this.raw++; return this.reading; }
}
class Fine extends Meter {
    declare fine: string;
    constructor(raw: number) { super(raw); Object.defineProperty(this, "fine", { get() { return "fine " + (this as Fine).reading; }, enumerable: false, configurable: true }); }
}
function readMeter(m: Meter) { return m.reading; }
function readFine(f: Fine) { return f.fine + "/" + f.reading; }
const meter = new Meter(3), fine = new Fine(5);
show("instances", readMeter(meter), readMeter(fine), readFine(fine), meter.bump(), Object.keys(meter), Object.keys(fine), JSON.stringify(fine));
Object.defineProperty(meter, "reading", { value: 100, writable: true, configurable: true, enumerable: true });
show("made a value", readMeter(meter), meter.bump(), attempt(() => { meter.reading = 7; return readMeter(meter); }), readMeter(new Meter(1)));
delete (fine as any).reading;
show("deleted", readMeter(fine), readFine(fine), "reading" in fine);
(Meter.prototype as any).reading = "from the prototype";
show("inherited", readMeter(fine), readFine(fine), readMeter(new Meter(2)));
delete (Meter.prototype as any).reading;

// A field that some instances hold as a value and others as an accessor.
class Either {
    declare held: unknown;
    constructor(lazy: boolean, value: unknown) { if (lazy) Object.defineProperty(this, "held", { get: () => value, enumerable: true, configurable: true }); else this.held = value; }
}
function readEither(e: Either) { return e.held; }
show("either", readEither(new Either(true, "lazy")), readEither(new Either(false, "eager")), Object.getOwnPropertyDescriptor(new Either(true, 1), "held")!.get !== undefined, Object.getOwnPropertyDescriptor(new Either(false, 1), "held")!.value);

// A getter and a setter, defined together and one after the other.
class Pair {
    declare both: number;
    store = 0;
    constructor() {
        Object.defineProperty(this, "both", { get: () => this.store, set: (v: number) => { this.store = v * 2; }, enumerable: true, configurable: true });
    }
}
function usePair(p: Pair) { p.both = 4; const first = p.both; p.both += 1; return [first, p.both, p.store]; }
show("pair", usePair(new Pair()), usePair(new Pair()));
const half = new Pair();
Object.defineProperty(half, "both", { set: undefined });
show("setter taken away", half.both, attempt(() => { "use strict"; half.both = 1; return "stored"; }), typeof Object.getOwnPropertyDescriptor(half, "both")!.get);
Object.defineProperty(half, "both", { get: undefined });
show("getter taken away", half.both, Object.getOwnPropertyDescriptor(half, "both"));

// Constructor functions.
function Old(this: any, n: number) { Object.defineProperty(this, "twice", { get() { return n * 2; }, enumerable: true, configurable: true }); this.n = n; }
function readOld(o: any) { return o.twice + o.n; }
show("constructor function", readOld(new (Old as any)(4)), readOld(new (Old as any)(5)), Object.keys(new (Old as any)(1)));

// this of the getter, through Reflect.get and super.
const own = { base: 10, get viaThis() { return this.base; } };
function readViaThis(o: typeof own) { return o.viaThis; }
show("receiver", readViaThis(own), Reflect.get(own, "viaThis", { base: 20 }), Object.create(own, { base: { value: 30 } }).viaThis);

// A getter that throws, that redefines itself, that deletes itself.
const odd: any = {
    get thrower() { throw new RangeError("no"); },
    get once() { Object.defineProperty(this, "once", { value: "settled", configurable: true, enumerable: true }); return "first"; },
    get gone() { delete this.gone; return "was here"; },
};
function readOdd(name: "thrower" | "once" | "gone") { return name === "thrower" ? odd.thrower : name === "once" ? odd.once : odd.gone; }
show("odd", attempt(() => readOdd("thrower")), readOdd("once"), readOdd("once"), readOdd("gone"), readOdd("gone"), Object.keys(odd));

let total = 0;
for (let i = 0; i < 20000; i++) { const m = i & 1 ? new Fine(i) : new Meter(i); total += readMeter(m); if (i % 5000 === 0) Bun.gc(true); }
show("many", total);
console.log(lines.join("\n"));
//// own-accessors-read-from-the-object-and-from-its-heirs.js
// Getters of a literal, read from the literal itself and, by name, from the objects below it.
const holder = { get alpha() { return 1; }, get beta() { return 2; }, gamma: 3 };
const heirs = [];
for (let k = 0; k < 4; k++) { const heir = Object.create(holder); heir["own" + k] = k; heirs.push(heir); }
globalThis[process.argv.length > 99 ? process.argv[9] : "hidden"] = heirs;
let sum = holder.alpha + holder.beta;
for (let r = 0, rounds = +(process.argv[2] ?? 1000); r < rounds; r++) { const o = globalThis.hidden[r & 3]; sum += o.alpha + o.beta + o.gamma; }
console.log(sum);
//// own-accessors-whose-getters-capture.ts
function counter(start: number, step: number) {
    let current = start;
    return { get next() { current += step; return current; }, get start() { return start; } };
}
const byOne = counter(0, 1), byTen = counter(100, 10);
function drain(source: { readonly next: number; readonly start: number }) { return source.next + source.next + source.start; }
const rounds = Number(process.argv[2] ?? 1000) | 0;
let sum = 0;
for (let r = 0; r < rounds; r++) sum += drain(byOne) + drain(byTen);
console.log(sum);
//// own-keys-hidden-extra-property.ts
// Object.getOwnPropertyNames and Reflect.ownKeys list the non-enumerable and symbol-keyed properties added to a typed object, Object.keys does not, every result is a fresh array, and Object.assign from an object with an own enumerable __proto__ sets the target's prototype.
class Point { x: number = 1; y: number = 2 }
class PointWithProtoField { x: number = 1; ["__proto__"]: object = { inherited: 1 } }
interface Spot { x: number; y: number }

const makers: [string, () => any][] = [
  ["instance", () => new Point()],
  ["literal", (): Spot => ({ x: 1, y: 2 })],
  ["instance with a __proto__ field", () => new PointWithProtoField()],
  ["frozen instance", () => Object.freeze(new Point())],
  ["sealed instance", () => Object.seal(new Point())],
  ["non-extensible instance", () => Object.preventExtensions(new Point())],
]

const steps: [string, (o: any) => void][] = [
  ["unchanged", () => {}],
  ["add extra", o => { o.extra = 3 }],
  ["define hidden", o => { Object.defineProperty(o, "hidden", { value: 4, enumerable: false, writable: true, configurable: true }) }],
  ["add symbol", o => { o[Symbol.for("s")] = 5 }],
  ["delete x", o => { delete o.x }],
  ["assign x and z", o => { Object.assign(o, { x: 9, z: 1 }) }],
  ["define hidden __proto__", o => { Object.defineProperty(o, "__proto__", { value: { inherited: 1 }, enumerable: false, writable: true, configurable: true }) }],
  ["define enumerable __proto__", o => { Object.defineProperty(o, "__proto__", { enumerable: true }) }],
  ["freeze", o => { Object.freeze(o) }],
]

const listings: [string, (o: any) => PropertyKey[]][] = [
  ["keys", o => Object.keys(o)],
  ["getOwnPropertyNames", o => Object.getOwnPropertyNames(o)],
  ["ownKeys", o => Reflect.ownKeys(o)],
]

const probedNames = ["x", "extra", "hidden", "absent"]

function show(o: any): string {
  return [
    Object.keys(o),
    Object.getOwnPropertyNames(o),
    Reflect.ownKeys(o).map(String),
    Object.values(o),
    JSON.stringify(Object.entries(o)),
    Reflect.ownKeys(Object.assign({}, o)).map(String),
    Object.getPrototypeOf(Object.assign({}, o)) === Object.prototype,
    Object.isFrozen(o),
    Object.isSealed(o),
    Object.isExtensible(o),
    ...probedNames.flatMap(name => [Object.hasOwn(o, name), Object.prototype.hasOwnProperty.call(o, name)]),
  ].join("|")
}

function applyStep(o: any, apply: (o: any) => void): string {
  try {
    apply(o)
    return "done"
  } catch (e) {
    return "threw " + (e as Error).name
  }
}

function writeToListing(o: any, list: (o: any) => PropertyKey[]): string {
  const k = list(o)
  k.push("q")
  k[0] = "r"
  return k.map(String).join()
}

for (const [label, make] of makers) {
  const o = make()
  for (const [step, apply] of steps) {
    console.log(label + ", " + step + ": " + applyStep(o, apply))
    console.log(show(o))
    for (const [listing, list] of listings) console.log(listing + " after writes: " + writeToListing(o, list))
    console.log(show(o))
  }
}

export {}
//// own-keys-of-parameters-and-of-instances-with-private-fields-are-walked.ts
// Own keys are walked: spreads, Object.assign, Object.values, for..in, over objects whose layouts are known.
interface Point { a: number; b: number }

function spreadOfParameter(o: Point): { a: number; b: number; c: number } {
  return { ...o, c: 1 };
}

function assignOfParameter(o: Point): Point {
  return Object.assign({}, o);
}

function valuesOfParameter(o: Point): number {
  const v = Object.values(o);
  return v[0] + v[1];
}

class WithPrivate {
  #p = 1;
  a = 2;
  b = 3;
  bump(): void { this.#p++; }
  get p(): number { return this.#p; }
}

class WithoutPrivate {
  p = 1;
  a = 2;
  b = 3;
}

function spreadOfPrivate(c: WithPrivate): number {
  const copy = { ...c };
  return copy.a + copy.b;
}

function valuesOfPrivate(c: WithPrivate): number {
  const v = Object.values(c);
  return v.length + v[0];
}

function namesOfPrivate(c: WithPrivate): number {
  let n = 0;
  for (const k in c) n += k.length;
  return n;
}

function spreadOfPublic(c: WithoutPrivate): number {
  const copy = { ...c };
  return copy.a + copy.b;
}

function valuesOfPublic(c: WithoutPrivate): number {
  const v = Object.values(c);
  return v.length + v[0];
}

function namesOfPublic(c: WithoutPrivate): number {
  let n = 0;
  for (const k in c) n += k.length;
  return n;
}

const points: Point[] = [];
for (let i = 0; i < 8; i++) points.push({ a: i, b: i + 1 });
const privates: WithPrivate[] = [];
const publics: WithoutPrivate[] = [];
for (let i = 0; i < 8; i++) {
  privates.push(new WithPrivate());
  publics.push(new WithoutPrivate());
}

let sum = 0;
for (let i = 0; i < 200000; i++) {
  const o = points[i & 7];
  sum += spreadOfParameter(o).c + spreadOfParameter(o).b;
  sum += assignOfParameter(o).a;
  sum += valuesOfParameter(o);
  const c = privates[i & 7];
  c.bump();
  sum += spreadOfPrivate(c) + valuesOfPrivate(c) + namesOfPrivate(c) + (c.p & 1);
  const d = publics[i & 7];
  sum += spreadOfPublic(d) + valuesOfPublic(d) + namesOfPublic(d);
  sum %= 1000003;
}
console.log(sum);
//// own-keys-of-typed-objects-with-added-properties.ts
interface P {
  a: number;
  b?: string;
  c?: number;
}

class K {
  x = 1;
  y?: number;
  #z = 2;
  z(): number {
    return this.#z;
  }
}

class A {
  name: string;
  constructor(cb?: (o: A) => void) {
    if (cb) {
      (this as any).tag = 1;
      cb(this);
    }
    this.name = "x";
  }
}

function print(value: unknown): void {
  console.log(JSON.stringify(value));
}

function show(value: unknown): string {
  if (typeof value === "function") return "function";
  if (typeof value === "symbol") return String(value);
  return String(JSON.stringify(value));
}

function describe(o: object): string {
  const forIn: string[] = [];
  for (const key in o) forIn.push(key);
  return [
    "keys " + Object.keys(o).join(),
    "values " + Object.values(o).map(show).join(),
    "entries " + Object.entries(o).map(([key, value]) => key + "=" + show(value)).join(),
    "for-in " + forIn.join(),
    "json " + JSON.stringify(o),
    "own " + Reflect.ownKeys(o).map(String).join(),
    "spread " + Object.keys({ ...o }).join(),
  ].join(" | ");
}

function repeated(name: string, create: () => object): void {
  const first = describe(create());
  console.log(name + ": " + first);
  for (let i = 1; i < 2000; i++) {
    const current = describe(create());
    if (current !== first) {
      console.log(name + " differs at " + i + ": " + current);
      return;
    }
  }
}

function once(name: string, create: () => object): void {
  console.log(name + ": " + describe(create()));
  console.log(name + ", again: " + describe(create()));
}

function createP(): P {
  return { a: 1 };
}

function add(o: object, names: string[]): void {
  for (const name of names) (o as any)[name] = name.length;
}

repeated("fields of an interface", () => createP());
repeated("optional fields", () => {
  const o = createP();
  o.c = 3;
  o.b = "b";
  return o;
});
repeated("fields of a class", () => new K());
repeated("one added", () => {
  const o = createP();
  add(o, ["one"]);
  return o;
});
repeated("three added", () => {
  const o = createP();
  add(o, ["one", "three", "seven"]);
  return o;
});
////= lines-210	repeated	"one added before an optional field"	o.b = "b"
repeated("three added before an optional field", () => {
  const o = createP();
  add(o, ["one", "three", "seven"]);
  o.c = 3;
  return o;
});
repeated("one added after an optional field", () => {
  const o = createP();
  o.b = "b";
  add(o, ["one"]);
  return o;
});
repeated("three added after an optional field", () => {
  const o = createP();
  o.c = 3;
  add(o, ["one", "three", "seven"]);
  return o;
});
repeated("added to a class", () => {
  const o = new K();
  add(o, ["one", "three"]);
  o.y = 2;
  return o;
});
repeated("frozen with added properties", () => {
  const o = createP();
  add(o, ["one", "three"]);
  return Object.freeze(o);
});
repeated("sealed with added properties", () => {
  const o = new K();
  add(o, ["one"]);
  return Object.seal(o);
});

const sameNames = ["left", "right"];
repeated("same added names, first object", () => {
  const o = createP();
  add(o, sameNames);
  return o;
});
repeated("same added names, second object", () => {
  const o = createP();
  add(o, sameNames);
  (o as any).left = "changed";
  return o;
});

for (let round = 0; round < 3; round++) {
  repeated("collections, round " + round, () => {
    const o = createP();
    add(o, ["one", "three"]);
    o.b = "b";
    return o;
  });
  (globalThis as any).Bun.gc(true);
}

const a = new A();
(a as any).tag = 1;
print(Object.keys({ ...a }));
new A(o => print(Object.keys({ ...o })));
new A(o => print(Object.entries(o).map(([key]) => key)));
new A(o => console.log(describe(o)));

////= lines-210	once	"an added accessor"	Object.defineProperty(o, "accessor", { get: () => 5, enumerable: true, configurable: true })
once("a non-enumerable added property", () => {
  const o = createP();
  add(o, ["one"]);
  Object.defineProperty(o, "hidden", { value: 6, enumerable: false });
  add(o, ["two"]);
  return o;
});
const addedSymbol = Symbol("added");
////= lines-210	once	"an added symbol"	(o as any)[addedSymbol] = 7
////= lines-210	once	"an added index key"	(o as any)["0"] = 8

const manyNames: string[] = [];
for (let i = 0; i < 2000; i++) manyNames.push("name" + i);
function printDictionary(o: object): void {
  const keys = Object.keys(o);
  const values = Object.values(o);
  const forIn: string[] = [];
  for (const key in o) forIn.push(key);
  print([keys.length, keys[0], keys[1], keys[keys.length - 1], values.length, forIn.length, Reflect.ownKeys(o).length]);
  print([JSON.stringify(o).length, Object.keys({ ...o }).length, Object.entries(o)[1]]);
}
for (let round = 0; round < 2; round++) {
  const o = createP();
  add(o, manyNames);
  printDictionary(o);
}

once("an added name deleted again", () => {
  const o = createP();
  add(o, ["one", "two"]);
  delete (o as any).one;
  return o;
});
once("the only added name deleted again", () => {
  const o = createP();
  add(o, ["one"]);
  delete (o as any).one;
  o.b = "b";
  return o;
});
once("an optional field deleted", () => {
  const o = createP();
  o.b = "b";
  add(o, ["one"]);
  delete o.b;
  return o;
});
once("an optional field deleted and created again", () => {
  const o = createP();
  o.b = "b";
  o.c = 3;
  add(o, ["one"]);
  delete o.b;
  o.b = "again";
  return o;
});
