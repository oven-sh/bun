}
const inherited = { configurable: true, get() { alter(this); return "inherited a"; }, set(value) { alter(this); } };

function readThree(o) { return o.a + " | " + o.b + " | " + o.c; }
function readAndCall(o) { return o.a + " | " + o.describe() + " | " + o.sum; }
function readAndStore(o) { const first = o.a; o.b = "stored"; o.c = "stored too"; return first + " | " + o.b + " | " + o.c + " | " + Object.keys(o).join(); }
function storeAndRead(o) { o.a = "new a"; return o.b + " | " + o.c + " | " + ("a" in o) + " | " + Object.keys(o).join(); }
function readInLoop(o) { let text = ""; for (let i = 0; i < 3; i++) text += o.a + ":" + o.b + ":" + o.c + ";"; return text; }
const uses = { readThree, readAndCall, readAndStore, storeAndRead, readInLoop };

const alterations = {
  nothing() {},
  "an accessor in place of b"(o) { Object.defineProperty(o, "b", { configurable: true, enumerable: true, get() { return "b by getter"; }, set() {} }); },
  "b is deleted"(o) { delete o.b; },
  "b and c are deleted and added again"(o) { delete o.b; delete o.c; o.c = "late c"; o.b = "late b"; },
  "an indexed accessor"(o) { Object.defineProperty(o, 0, { configurable: true, get() { return "zero"; } }); },
  "another prototype"(o) { Object.setPrototypeOf(o, { describe() { return "other " + this.b; }, get sum() { return "other sum"; }, get a() { return "other a"; } }); },
  "own members hide those of the class"(o) { o.describe = function () { return "own " + this.b; }; Object.defineProperty(o, "sum", { configurable: true, value: "own sum" }); },
  "frozen"(o) { Object.freeze(o); },
  "b holds another kind of value"(o) { o.b = { toString() { return "an object in b"; } }; o.c = 1.5; },
  "many more properties"(o) { for (let i = 0; i < 40; i++) o["extra" + i] = i; },
  "the method of the class is replaced"(o) { Box.prototype.describe = function () { return "replaced " + this.b; }; },
};

const describe = Box.prototype.describe;
for (const [useName, use] of Object.entries(uses)) {
  for (const [alterationName, alteration] of Object.entries(alterations)) {
    for (const hide of [value => value, unknown]) {
      Box.prototype.describe = describe;
      delete Box.prototype.a;
      alter = () => {};
      let text = "";
      for (let warm = 0; warm < 3; warm++) text = use(hide(new Box("a", "b", "c")));
      const box = hide(new Box("a", "b", "c"));
      delete box.a;
      Object.defineProperty(Box.prototype, "a", inherited);
      let ran = 0;
      alter = o => { if (!ran++) alteration(o); };
      let result;
      try { result = use(box); } catch (error) { result = error.constructor.name; }
      let again;
      try { again = use(box); } catch (error) { again = error.constructor.name; }
      lines.push(useName + ", " + alterationName + (hide === unknown ? ", unknown" : "") + ": " + text + " || " + result + " || " + again);
    }
  }
}
console.log(lines.join("\n"));
//// slow-path-rejoins-before-a-repeated-guard.js
function Links() { this.v = 0; this.w = 1; }
const table = [];
function linksOf(i) { return table[i] ?? (table[i] = new Links()); }

function sumTwice(o) {
  const a = o.x;
  const b = o.y;
  const c = o.x;
  return a + b + c;
}

function storeThenRead(o, n) {
  o.x = n;
  o.y = n + 1;
  return o.x + o.y;
}

function Base() { this.x = 1; this.y = 2; }
function Derived() { Base.call(this); this.z = 3; this.w = 4; }
Derived.prototype = Object.create(Base.prototype);

function pushBoth(list, a, b) {
  list.push(a);
  const n = list.length;
  list.push(b);
  return n + list.length;
}

const lines = [];
function log(name, value) { lines.push(name + " " + JSON.stringify(value)); }
function attempt(name, run) {
  try { log(name, run()); } catch (error) { log(name + " throws", error instanceof TypeError); }
}

let total = 0;
for (let i = 0; i < 200; i++) total += linksOf(i & 31).w;
log("links", total);
table.length = 8;
table[40] = undefined;
for (let i = 0; i < 64; i++) total += linksOf(i).w;
log("links with holes", [total, table.length]);
Object.defineProperty(table, 50, { get() { table.length = 4; return undefined; }, set(v) { total += 1000; }, configurable: true });
total += linksOf(50).w;
log("links behind an accessor", [total, table.length]);

for (let i = 0; i < 200; i++) total += sumTwice({ x: i, y: 1 });
log("plain", total);
let reads = 0;
const shifty = { get x() { reads++; if (reads === 1) delete this.y; else this.y = 7; return reads; }, y: 5 };
log("getter deletes the next field", sumTwice(shifty));
log("again", sumTwice(shifty));
const viaPrototype = Object.create({ get x() { Object.setPrototypeOf(viaPrototype, { x: 40, y: 2 }); return 1; }, y: 100 });
log("getter replaces the prototype", sumTwice(viaPrototype));
log("again", sumTwice(viaPrototype));

for (let i = 0; i < 200; i++) total += storeThenRead({ x: 0, y: 0 }, i);
log("stores", total);
const freezing = { set x(v) { Object.freeze(this); }, get x() { return 9; }, y: 3 };
attempt("setter freezes", () => storeThenRead(freezing, 50));
log("frozen", [Object.isFrozen(freezing), freezing.y]);
const growing = { set x(v) { Object.defineProperty(this, "y", { get() { return -1; }, set(w) { total += w; }, configurable: true }); }, get x() { return 2; }, y: 3 };
log("setter redefines the next field", [storeThenRead(growing, 60), total]);

for (let i = 0; i < 200; i++) { const d = new Derived(); total += d.x + d.y + d.z + d.w; }
log("constructors", total);
Object.defineProperty(Base.prototype, "y", { set(v) { Object.defineProperty(this, "z", { value: 30, writable: false, configurable: true }); }, get() { return 20; }, configurable: true });
attempt("setter on the prototype locks a later field", () => { const odd = new Derived(); return [odd.x, odd.y, odd.z, odd.w]; });
delete Base.prototype.y;
const usual = new Derived();
log("constructors again", [usual.x, usual.y, usual.z, usual.w]);

const numbers = [];
for (let i = 0; i < 100; i++) total += pushBoth(numbers, i, i + 1);
log("push", [total, numbers.length]);
const limited = [1, 2];
Object.defineProperty(limited, "push", { value(v) { if (this.length === 2) Object.preventExtensions(this); return Array.prototype.push.call(this, v); }, configurable: true });
attempt("own push", () => pushBoth(limited, 3, 4));
log("after own push", limited.length);
console.log(lines.join("\n"));
//// small-whole-number-keys.ts
// Maps and Sets keyed by small whole numbers beside every other kind of key: the order of insertion, growth, shrinking, deletion and the same table seen by typed and by untyped code.
const lines: string[] = [];
function digest(keys: Iterable<unknown>): string {
  let sum = 0;
  let n = 0;
  for (const k of keys) sum = (sum * 31 + (typeof k === "number" ? (Number.isFinite(k) ? Math.floor(k * 4) % 100003 : 11) : String(k).length) + ++n) % 1000003;
  return n + ":" + sum;
}
function dense(n: number): string {
  const table = new Map<number, number>();
  for (let i = 0; i < n; i++) table.set(i, i * 2);
  let total = 0;
  for (let r = 0; r < 3; r++) for (let i = -3; i < n + 3; i++) total += table.get(i) ?? -1;
  for (let i = 0; i < n; i += 3) table.delete(i);
  for (let i = -3; i < n + 3; i++) total += table.has(i) ? 1 : 0;
  for (let i = n; i-- > 0; ) if (i % 6 === 0) table.set(i, -i);
  return total + ":" + digest(table.keys()) + ":" + digest(table.values());
}
function strided(step: number, n: number): string {
  const seen = new Set<number>();
  for (let i = 0; i < n; i++) seen.add(i * step);
  let hits = 0;
  for (let i = 0; i < n * step; i += 7) if (seen.has(i)) hits++;
  return hits + ":" + digest(seen);
}
function mixedKinds(): string {
  const table = new Map<unknown, number>();
  const keys: unknown[] = [0, -0, 1, 2, 3, 7, 8, 15, 16, 31, 32, 33, 63, 64, 65, 1000, 2147483647, -1, -2147483648, 0.5, 1.5, 4294967296, NaN, "0", "1", "7", true, false, null, undefined, 1n, 7n];
  const own = {};
  keys.push(own, [], Symbol.iterator);
  for (let r = 0; r < 3; r++) keys.forEach((k, i) => table.set(k, (table.get(k) ?? 0) + i));
  const typed = table as Map<number, number>;
  let sum = 0;
  for (let i = -2; i < 70; i++) sum += typed.get(i) ?? 0;
  for (let i = 0; i < 200; i++) typed.set(i * 3, i);
  for (let i = -2; i < 70; i++) sum += typed.get(i) ?? 0;
  const loose: any = table;
  for (let i = 0; i < 70; i++) sum += loose.get(i) ?? 0;
  for (let i = 0; i < 600; i += 2) loose.delete(i);
  for (let i = 0; i < 70; i++) sum += (typed.has(i) ? 1 : 0) + (loose.has(i) ? 2 : 0);
  return sum + ":" + digest(table.keys()) + ":" + table.size;
}
function shrinks(): string {
  const table = new Map<number, string>();
  for (let i = 0; i < 5000; i++) table.set(i, "v" + i);
  for (let i = 0; i < 4990; i++) table.delete(i);
  let found = "";
  for (let i = 4980; i < 5005; i++) found += table.get(i) ?? "-";
  for (let i = 0; i < 40; i++) table.set(i * 100, "w");
  return found + ":" + digest(table.keys());
}
function copies(): string {
  const first = new Map<number, number>();
  for (let i = 0; i < 300; i++) first.set((i * 37) % 301, i);
  const second = new Map(first);
  const third = new Set(first.keys());
  second.delete(5);
  let sum = 0;
  for (let i = 0; i < 310; i++) sum += (first.get(i) ?? 0) + (second.get(i) ?? 0) * 2 + (third.has(i) ? 1 : 0);
  return sum + ":" + digest(second.keys()) + ":" + digest(third);
}
lines.push(dense(1), dense(7), dense(8), dense(9), dense(100), dense(5000), dense(70000));
lines.push(strided(1, 500), strided(2, 500), strided(64, 500), strided(1024, 300), strided(65536, 200), mixedKinds(), shrinks(), copies());
console.log(lines.join("\n"));
//// specializing-stores.ts
// An object is created as a base type and gets the optional fields of a subtype later, one store at a time, many times over at the same sites.
const show = (what: string, o: object) => console.log(what, JSON.stringify(Object.keys(o)), JSON.stringify(o, (key, value) => (key === "target" || key === "constraint" ? value.id : typeof value === "function" ? "function" : value)))
interface Type { flags: number; id: number }
interface ObjectType extends Type { objectFlags: number; members?: string[] }
interface AnonymousType extends ObjectType { target?: AnonymousType; mapper?: (n: number) => number; count?: number; ratio?: number; label?: string; done?: boolean; note?: string | null }
interface TypeParameter extends Type { constraint?: Type; target?: TypeParameter; isThis?: boolean }
interface UnionType extends Type { types?: Type[]; origin?: Type | undefined }
let nextId = 0
function TypeCtor(this: Type, flags: number) { this.flags = flags; this.id = ++nextId }
const Type = TypeCtor as unknown as new (flags: number) => Type
function createObjectType(objectFlags: number): ObjectType { const made = new Type(1) as ObjectType; made.objectFlags = objectFlags; return made }
function instantiate(from: AnonymousType, step: number): AnonymousType {
  const result = createObjectType(from.objectFlags | 64) as AnonymousType
  result.target = from
  result.mapper = n => n + step
  return result
}
function clone(from: TypeParameter): TypeParameter { const result = new Type(2) as TypeParameter; result.target = from; return result }
function constrain(parameter: TypeParameter, constraint: Type) { parameter.constraint = constraint }
function setCount(type: AnonymousType, count: number) { type.count = count }
function setRatio(type: AnonymousType, ratio: number) { type.ratio = ratio }
function setLabel(type: AnonymousType, label: string) { type.label = label }
function setDone(type: AnonymousType, done: boolean) { type.done = done }
function setNote(type: AnonymousType, note: string | null) { type.note = note }
function setOrigin(type: UnionType, origin: Type | undefined) { type.origin = origin }
function setTypes(type: UnionType, types: Type[]) { type.types = types }

const root = createObjectType(0) as AnonymousType
let last = root
let sum = 0
for (let i = 0; i < 20000; i++) {
  const made = instantiate(i % 3 ? root : last, i)
  sum += made.mapper!(made.target!.id) + made.objectFlags
  if (i % 1000 === 0) last = made
}
console.log("instantiated", sum, nextId)
show("one", instantiate(root, 1))

const parameter = new Type(2) as TypeParameter
let chain = parameter
for (let i = 0; i < 5000; i++) {
  chain = clone(chain)
  constrain(chain, i % 2 ? root : parameter)
}
let depth = 0
for (let at: TypeParameter | undefined = chain; at; at = at.target) depth += at.constraint ? at.constraint.flags : 10
console.log("cloned", depth)
show("parameter", chain)

// Every kind of value, each the first field of the subtype that the object gets.
const kinds: AnonymousType[] = []
for (let i = 0; i < 3000; i++) {
  const made = createObjectType(i) as AnonymousType
  switch (i % 8) {
    case 0: setCount(made, i); break
    case 1: setCount(made, i + 0.5); break
    case 2: setRatio(made, -0); break
    case 3: setLabel(made, "l" + i); break
    case 4: setDone(made, i % 16 === 4); break
    case 5: setNote(made, null); break
    case 6: setNote(made, "n"); break
    default: setCount(made, 2 ** 40 + i)
  }
  if (i >= 2992) kinds.push(made)
}
for (const kind of kinds) show("kind", kind)
console.log(Object.is(kinds[2].ratio, -0), kinds[7].count)

// The order of the keys is the order of the stores.
const forwards = createObjectType(1) as AnonymousType
setCount(forwards, 1); setLabel(forwards, "a"); setDone(forwards, true)
const backwards = createObjectType(1) as AnonymousType
setDone(backwards, false); setLabel(backwards, "b"); setCount(backwards, 2)
show("forwards", forwards); show("backwards", backwards)

// `undefined` is a value: the key is there.
const unions: UnionType[] = []
for (let i = 0; i < 2000; i++) {
  const union = new Type(4) as UnionType
  setOrigin(union, i % 2 ? undefined : root)
  if (i % 5 === 0) setTypes(union, [root, union])
  if (i >= 1994) unions.push(union)
}
for (const union of unions) console.log("origin" in union, union.origin?.id, Object.keys(union).join(), union.types?.length)

// Objects that refuse, at sites that have made the transition thousands of times.
function attempt(what: string, run: () => void) { try { run(); console.log(what, "stored") } catch (error) { console.log(what, (error as Error).constructor.name) } }
const frozen = Object.freeze(createObjectType(1)) as AnonymousType
attempt("frozen", () => setCount(frozen, 1)); show("frozen", frozen)
const sealed = Object.seal(createObjectType(1)) as AnonymousType
attempt("sealed", () => setLabel(sealed, "x")); show("sealed", sealed)
const closed = Object.preventExtensions(createObjectType(1)) as AnonymousType
attempt("closed", () => { closed.target = root }); show("closed", closed)
attempt("closed, written", () => { closed.objectFlags = 9 }); show("closed", closed)

// An object that has a property nobody declared keeps it, in its place among the keys.
const marked = createObjectType(1) as AnonymousType
;(marked as any).extra = "kept"
setCount(marked, 3); marked.target = root
show("marked", marked)
delete (marked as any).extra
setLabel(marked, "after"); show("marked", marked)

// A field that was deleted comes back last.
const again = instantiate(root, 1)
delete again.target
show("deleted", again)
again.target = last
show("stored again", again)

// Old objects that get young ones.
const host = globalThis as any
const collect: () => void = host.Bun ? () => host.Bun.gc(true) : host.gc
const old: AnonymousType[] = []
for (let i = 0; i < 2000; i++) old.push(createObjectType(i) as AnonymousType)
collect()
for (let i = 0; i < old.length; i++) { old[i].target = createObjectType(-i) as AnonymousType; old[i].mapper = n => n * i * 3; if (i % 500 === 0) collect() }
collect()
let kept = 0
for (let i = 0; i < old.length; i++) kept += old[i].target!.objectFlags + old[i].mapper!(1)
console.log("kept", kept)
