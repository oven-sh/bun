////: permutations
function permutations(list) {
  if (list.length < 2) return [list]
  const result = []
  for (let i = 0; i < list.length; i++)
    for (const rest of permutations([...list.slice(0, i), ...list.slice(i + 1)])) result.push([list[i], ...rest])
  return result
}
////: printer
function printer(label) {
  return (...values) => {
    let text = label + ":";
    for (let i = 0; i < values.length; i++) text += " " + String(values[i]);
    lines.push(text);
  };
}
////: shorten
function shorten(parts: string[]): string {
  if (parts.length <= 6) return parts.join(",");
  let sum = 0;
  for (const part of parts) for (let i = 0; i < part.length; i++) sum = (Math.imul(sum, 31) + part.charCodeAt(i)) | 0;
  return parts.slice(0, 2).join(",") + ",..(" + parts.length + " in all, checksum " + sum + ")..," + parts.slice(-2).join(",");
}
////: show-2
function show(name: string, ...values: unknown[]) {
    lines.push(name + ": " + values.map(value => {
        if (typeof value === "function") return "function " + value.name;
        if (typeof value === "symbol") return value.toString();
        try { return JSON.stringify(value) ?? String(value); } catch (error) { return "unprintable " + (error as Error).name; }
    }).join(" | "));
}
