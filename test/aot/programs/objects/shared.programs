////: Point-3
class Point {
  x: number;
  y: number;
  constructor(x: number, y: number) {
    this.x = x;
    this.y = y;
  }
}
////: attempt-2
function attempt(action) {
  try {
    return action();
  } catch (error) {
    return error.name + ": " + error.message;
  }
}
////: disturb
function disturb(o: any, name: string, how: number): void {
  if (how === 1) delete o[name];
  else if (how === 2) Object.defineProperty(o, name, { get() { return 1; }, configurable: true });
  else if (how === 3) o[name] = how;
  else if (how === 4) Object.setPrototypeOf(o, null);
  else if (how === 5) Object.freeze(o);
}
////: kinds
const kinds: [string, KeyAt][] = [
  ["strings", index => "k" + index],
  ["integers", index => index],
  ["doubles", index => index + 0.5],
  ["objects", index => objects[index]],
  ["«1»],
  ["mixed", index => (index === 0 ? undefined : index === 1 ? null : ["k" + index, index, index + 0.5, objects[index], «2»][index % 6])],
];
