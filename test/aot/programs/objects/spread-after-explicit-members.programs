// A literal that spreads an object with symbol keys and adds members has room for all of them in the object itself, so what inherits from it reads them without another load.
import { jscDescribe } from "bun:jsc";
const tag = Symbol("tag");
const base = { kind: "base", [tag]: 1, pipe() {}, [Symbol.iterator]() {}, toJSON() {}, toString() {}, asEffect() {} };
const extend = options => ({ ...base, identifier: options.op, evaluate: options.evaluate, onSuccess: options.onSuccess, onFailure: options.onFailure, onBoth: options.onBoth });
for (let i = 0; i < 3; i++) console.log("the copy has storage out of line:", !/\(\d+\/\d+, 0\/0\)/.test(jscDescribe(extend({ op: i }))));
//// spread-replaces-accessors.ts
// Spread defines properties: an accessor of the literal is replaced by an own property of the source with the same key, also when the key is `__proto__`.
class Fields { ["__proto__"] = 2; a = 3 }
function describe(object: object): string {
  const properties = Reflect.ownKeys(object).map(key => {
    const descriptor = Object.getOwnPropertyDescriptor(object, key);
    return String(key) + "=" + (descriptor && "value" in descriptor ? descriptor.value : "accessor");
  });
  return properties.join() + (Object.getPrototypeOf(object) === Object.prototype ? "" : " with another prototype");
}
function overProto(source: object): object { return { get __proto__() { return 1 }, ...source } }
function overA(source: object): object { return { get a() { return 1 }, ...source } }
function overBoth(source: object): object { return { get __proto__() { return 1 }, set a(value: number) {}, b: 0, ...source } }
function withoutA(source: any): object { const { a, ...rest } = source; return rest }

const sources: [string, () => object][] = [
  ["class instance", () => new Fields()],
  ["class instance with an added property", () => Object.assign(new Fields(), { added: 4 })],
  ["literal", () => ({ ["__proto__"]: 2, a: 3 })],
  ["parsed object", () => JSON.parse('{"__proto__":2,"a":3}')],
];
for (const [name, create] of sources) {
  for (let round = 0; round < 3; round++)
    console.log(name, "|", describe(overProto(create())), "|", describe(overA(create())), "|", describe(overBoth(create())), "|", describe(withoutA(create())));
}
//// spread-replaces-accessors-runtime-code.ts
// Spread and rest in functions created from text at run time define properties: an own property of the source replaces an accessor of the literal with the same key and calls neither its getter nor its setter, also when the key is `__proto__`.
const marker = { inherited: true };
class Fields { ["__proto__"] = 2; a = 3 }
class Linked { ["__proto__"] = marker; a = 3 }

function describe(object: object): string {
  const properties = Reflect.ownKeys(object).map(key => {
    const descriptor = Object.getOwnPropertyDescriptor(object, key);
    if (!descriptor || !("value" in descriptor)) return String(key) + "=accessor";
    const isOrdinary = descriptor.writable && descriptor.enumerable && descriptor.configurable;
    return String(key) + "=" + (descriptor.value === marker ? "marker" : descriptor.value) + (isOrdinary ? "" : " restricted");
  });
  const prototype = Object.getPrototypeOf(object);
  return properties.join() + (prototype === Object.prototype ? "" : prototype === null ? " without a prototype" : " with another prototype");
}

type Copy = (source: object, log: string[]) => object;
const createCopy = (body: string) => new Function("source", "log", body) as Copy;
const copies: [string, Copy][] = [
  ["alone", createCopy("return { ...source }")],
  ["before a member", createCopy("return { ...source, b: 0 }")],
  ["over a getter __proto__", createCopy("return { get __proto__() { log.push('get __proto__'); return 1 }, ...source }")],
  ["over a setter __proto__", createCopy("return { set __proto__(value) { log.push('set __proto__') }, ...source }")],
  ["over a getter a", createCopy("return { get a() { log.push('get a'); return 1 }, ...source }")],
  ["over a setter a", createCopy("return { set a(value) { log.push('set a') }, ...source }")],
  ["over both", createCopy("return { get __proto__() { log.push('get __proto__'); return 1 }, set a(value) { log.push('set a') }, b: 0, ...source }")],
  ["over an unrelated getter", createCopy("return { get c() { log.push('get c'); return 1 }, ...source }")],
  ["under a null prototype", createCopy("return { __proto__: null, ...source }")],
  ["rest without a", createCopy("var { a, ...rest } = source; return rest")],
  ["rest without __proto__", createCopy("var { __proto__: excluded, ...rest } = source; return rest")],
  ["rest without a computed __proto__", createCopy("var key = '__proto__'; var { [key]: excluded, ...rest } = source; return rest")],
];

const sources: [string, () => object][] = [
  ["class instance", () => new Fields()],
  ["class instance with an object value", () => new Linked()],
  ["class instance with an added property", () => Object.assign(new Fields(), { added: 4 })],
  ["class instance with a non-enumerable __proto__", () => Object.defineProperty(new Fields(), "__proto__", { enumerable: false })],
  ["class instance with a non-enumerable a", () => Object.defineProperty(new Fields(), "a", { enumerable: false })],
  ["frozen class instance", () => Object.freeze(new Fields())],
  ["literal", () => ({ ["__proto__"]: 2, a: 3 })],
  ["literal with an object value", () => ({ ["__proto__"]: marker, a: 3 })],
  ["parsed object", () => JSON.parse('{"__proto__":2,"a":3}')],
];

for (const [sourceName, createSource] of sources) {
  for (const [copyName, copy] of copies) {
    const rounds: string[] = [];
    for (let round = 0; round < 3; round++) {
      const log: string[] = [];
      rounds.push(describe(copy(createSource(), log)) + (log.length ? " called " + log.join() : ""));
    }
    console.log(sourceName, "|", copyName, "|", rounds.join(" | "));
  }
}
//// spreads-array-loops-constructors-and-closures-in-fields.ts
// What a spread copies beside the slots; loops over arrays; constructors; closures in fields.
type Pair = { a: number; b: number };
function make(a: number, b: number): Pair {
  return { a, b };
}
function copyAndAskForAnotherName(p: Pair): unknown {
  const c = { ...p };
  return (c as any).zz;
}
function copyAndRead(p: Pair): unknown {
  const c = { ...p };
  return c.a;
}
function copyAndHas(p: Pair): boolean {
  const c = { ...p };
  return "zz" in c;
}
function copyAndKeys(p: Pair): string {
  const c: Pair = { ...p };
  return Object.keys(c).join();
}

////= lines-25	Leaf	weight
class Crate {
  size: number;
  handler: () => number;
  constructor(size: number) {
    this.size = size;
    this.handler = () => this.size + 1;
  }
}
function sumWeights(xs: Leaf[]): number {
  let total = 0;
  for (let i = 0; i < xs.length; i++) total += xs[i].weight;
  return total;
}
function weights(xs: Leaf[]): number[] {
  const out: number[] = [];
  for (let i = 0; i < xs.length; i++) out.push(xs[i].weight);
  return out;
}
function weightsCounted(xs: Leaf[]): number {
  const out: number[] = [];
  for (let i = 0; i < xs.length; i++) out.push(xs[i].weight);
  return out.length;
}
function weightsByIndex(xs: Leaf[], out: number[]): number {
  for (let i = 0; i < xs.length; i++) out[i] = xs[i].weight;
  return out.length;
}
function callTwice(c: Crate): number {
  return c.handler() + c.handler();
}

////= disturb

const names = ["zz", "a", "weight", "size", "handler"];
const pool: any[] = [];
const leaves: Leaf[] = [];
for (let i = 0; i < 64; i++) {
  const leaf = new Leaf(i);
  leaves.push(leaf);
  pool.push(leaf, new Crate(i), make(i, i + 1));
}
const spare: any = { zz: 1, a: 2, weight: 3, size: 4, handler: 5 };
pool.push(spare);
for (let how = 1; how <= 5; how++) disturb(pool[pool.length - 1], names[how - 1], how);

const withAnotherName: any = make(1, 2);
withAnotherName[names[0]] = 7;
const withText: any = make(3, 4);
withText[names[1]] = "text";

const target: number[] = [];
let total = 0;
for (let round = 0; round < 3000; round++) {
  const at = (round & 63) * 3;
  total += sumWeights(leaves) + weights(leaves).length + weightsCounted(leaves) + weightsByIndex(leaves, target);
  total += callTwice(pool[at + 1]);
  total += (copyAndRead(pool[at + 2]) as number) + (copyAndAskForAnotherName(pool[at + 2]) === undefined ? 1 : 0) + (copyAndHas(pool[at + 2]) ? 1 : 0) + copyAndKeys(pool[at + 2]).length;
}
console.log(total);
console.log(copyAndAskForAnotherName(withAnotherName), copyAndHas(withAnotherName), copyAndKeys(withAnotherName), copyAndRead(withAnotherName));
console.log(copyAndAskForAnotherName(withText), copyAndHas(withText), copyAndKeys(withText), copyAndRead(withText));
//// stores-by-key-that-replace.js
// Stores by key that meet a property the object itself has, in every state in which the store may not simply put the value there. What plain Bun prints.
"use strict";
const lines = [];
function show(label, o) { lines.push(label + ": " + JSON.stringify(Object.getOwnPropertyDescriptors(o))); }
function attempt(label, run) { try { run(); lines.push(label + ": done"); } catch (error) { lines.push(label + ": " + error.constructor.name); } }
const keys = ["alpha", "beta", "gamma", "0", "length", "__proto__", "constructor", ""].map(k => (k + process.argv.length).slice(0, k.length));
function storeAll(label, o, value) { for (const k of keys) attempt(label + " " + k, () => { o[k] = value; }); show(label, o); }
function make() { const o = {}; o[keys[0]] = 1; o[keys[1]] = 2; return o; }
for (let round = 0; round < 3; round++) {
    storeAll("plain", make(), round);
    storeAll("frozen", Object.freeze(make()), round);
    storeAll("sealed", Object.seal(make()), round);
    storeAll("not extensible", Object.preventExtensions(make()), round);
    storeAll("read-only", Object.defineProperty(make(), "alpha", { value: 5, writable: false, enumerable: true, configurable: true }), round);
    storeAll("hidden", Object.defineProperty(make(), "alpha", { value: 5, writable: true, enumerable: false, configurable: false }), round);
    let seen = [];
    storeAll("setter", Object.defineProperty(make(), "alpha", { get() { return seen.length; }, set(v) { seen.push(v); }, enumerable: true, configurable: true }), round);
    storeAll("getter alone", Object.defineProperty(make(), "beta", { get() { return 7; }, enumerable: true, configurable: true }), round);
    const dictionary = make(); for (let k = 0; k < 80; k++) dictionary["d" + k] = k; for (let k = 0; k < 78; k++) delete dictionary["d" + k];
    storeAll("dictionary", dictionary, round);
    const wide = make(); for (let k = 0; k < 12; k++) wide["w" + k] = k; wide.gamma = "out of line";
    storeAll("out of line", wide, round);
    const prototype = make(); const heir = Object.create(prototype);
    storeAll("prototype", prototype, round); storeAll("heir", heir, round); show("prototype behind the heir", prototype);
    const readOnlyAbove = Object.create(Object.freeze(make()));
    storeAll("below a frozen object", readOnlyAbove, round);
    storeAll("array", [1, 2, 3], round);
    storeAll("with elements", Object.assign(make(), { 0: "zero" }), round);
    storeAll("literal", { alpha: 1, beta: 2 }, round);
    storeAll("instance", new (class { alpha = 1; beta = 2; })(), round);
    const cells = make(); storeAll("cells", cells, { round }); storeAll("cells again", cells, [round]);
    // Compiled objects with extra properties.
    const extend = o => { o[keys[2]] = "extra"; return o; };
    storeAll("literal with an extra", extend({ alpha: 1, beta: 2 }), round);
    storeAll("frozen with an extra", Object.freeze(extend({ alpha: 1, beta: 2 })), round);
    storeAll("sealed with an extra", Object.seal(extend({ alpha: 1, beta: 2 })), round);
    storeAll("read-only extra", Object.defineProperty({ alpha: 1, beta: 2 }, "gamma", { value: 5, writable: false, enumerable: true, configurable: true }), round);
    storeAll("hidden extra", Object.defineProperty({ alpha: 1, beta: 2 }, "gamma", { value: 5, writable: true, enumerable: false, configurable: true }), round);
    const stored = [];
    storeAll("extra with a setter", Object.defineProperty({ alpha: 1, beta: 2 }, "gamma", { get() { return stored.length; }, set(v) { stored.push(v); }, enumerable: true, configurable: true }), round);
    storeAll("extra with a setter of the host", Object.defineProperty({ alpha: 1, beta: 2 }, "gamma", { set: Object.getOwnPropertyDescriptor(Object.prototype, "__proto__").set, enumerable: true, configurable: true }), round);
    storeAll("extra with a bound setter", Object.defineProperty({ alpha: 1, beta: 2 }, "gamma", { set: function (v) { this.push(v); }.bind(stored), enumerable: true, configurable: true }), round);
    storeAll("instance with an extra", extend(new (class { alpha = 1; beta = 2; })()), round);
    const many = extend({ alpha: 1 }); for (let k = 0; k < 80; k++) many["m" + k] = k; for (let k = 0; k < 78; k++) delete many["m" + k];
    storeAll("extras as a dictionary", many, round);
    storeAll("below a literal with an extra", Object.create(extend({ alpha: 1, beta: 2 })), round);
    storeAll("cells into an extra", extend({ alpha: 1 }), { round });
    storeAll("a field with the empty name", extend({ "": 1, alpha: 2 }), round);
    storeAll("an extra with the empty name", (o => { o[keys[7]] = "empty"; return o; })({ alpha: 2 }), round);
    // Definitions by key.
    const key = keys[0];
    show("defined over plain", { ...make(), [key]: round });
    const target = Object.defineProperty(make(), "alpha", { value: 5, writable: false, enumerable: false, configurable: true });
    show("spread over hidden", Object.assign(Object.create(null), target, { [key]: round }));
}
console.log(lines.join("\n"));
//// stores-into-objects-that-nobody-else-holds-yet.js
// `const o = {}; o.a = ..; o.b = ..`: at the top level (run once), in functions, in loops and behind branches. Until the function hands the object on, nobody else can have changed it.
