//// text-made-at-run-time-stores-names-that-are-no-fields.js
// Text that is compiled at run time stores, under names that are no fields, into objects that compiled code laid out.
// The same store comes again and again, so whatever is remembered of the first ones answers for the later ones.
function Bag() {}
Bag.prototype = Object.create(null);

////= Point-2

function Counted() {
  this.count = 0;
}
Counted.prototype.describe = function () {
  return Object.keys(this).join();
};

const fillBag = new Function("Bag", "a", "b", "const bag = new Bag(); bag.first = a; bag.second = b; bag.first = a + 1; return bag;");
const label = new Function("object", "text", "object.label = text; object.label = object.label + '!'; return object;");
const labelStrictly = new Function("object", "text", "'use strict'; object.label = text; return object;");
const many = new Function("object", "for (let i = 0; i < 3; i++) { object.a = i; object.b = i; object.c = i; object.d = i; object.e = i; object.f = i; object.g = i; object.h = i; object.i = i; object.j = i; } return object;");

let sum = 0;
let last;
for (let i = 0; i < 300; i++) {
  last = fillBag(Bag, i, "x" + i);
  sum += last.first + last.second.length;
}
console.log(sum, Object.keys(last).join(), last.first, last.second, Object.getPrototypeOf(last) === Bag.prototype);

for (let i = 0; i < 300; i++) last = label(new Point(i, -i), "p" + i);
console.log(JSON.stringify(last), Object.keys(last).join());

for (let i = 0; i < 300; i++) last = label(new Counted(), "c" + i);
console.log(last.describe(), last.label, last.count);

for (let i = 0; i < 100; i++) last = many(new Bag());
console.log(Object.keys(last).join(""), Object.values(last).join(""));
for (let i = 0; i < 100; i++) last = many(new Point(1, 2));
console.log(Object.keys(last).join(""), Object.values(last).join(""));

// An object that takes no more properties.
for (let i = 0; i < 50; i++) last = label(Object.preventExtensions(new Point(i, i)), "no");
console.log(JSON.stringify(last), "label" in last);
let thrown = 0;
////= for-12	preventExtensions(new Point(i, i
console.log(thrown);
for (let i = 0; i < 50; i++) last = label(Object.freeze(label(new Point(i, i), "kept")), "no");
console.log(JSON.stringify(last));
thrown = 0;
////= for-12	freeze(label(new Point(i, i), "kept"
console.log(thrown);

// The name is deleted and comes again behind the others.
for (let i = 0; i < 50; i++) {
  last = label(new Point(i, i), "first");
  last.other = 1;
  delete last.label;
  label(last, "again");
}
console.log(Object.keys(last).join(), last.label);

// A setter, then a property that cannot be written, appear above the objects after the stores have been remembered.
const seen = [];
Object.defineProperty(Point.prototype, "label", {
  configurable: true,
  set(value) {
    seen.push(value);
  },
  get() {
    return "from above";
  },
});
for (let i = 0; i < 3; i++) last = label(new Point(i, i), "s" + i);
console.log(seen.join(), Object.keys(last).join(), last.label);
Object.defineProperty(Point.prototype, "label", { configurable: true, writable: false, value: "fixed" });
for (let i = 0; i < 3; i++) last = label(new Point(i, i), "w" + i);
console.log(Object.keys(last).join(), last.label);
thrown = 0;
try {
  labelStrictly(new Point(0, 0), "w");
} catch (error) {
  if (error instanceof TypeError) thrown++;
}
console.log(thrown);
delete Point.prototype.label;
for (let i = 0; i < 3; i++) last = label(new Point(i, i), "back" + i);
console.log(Object.keys(last).join(), last.label);

// The prototype of a bag gets a setter too.
Object.defineProperty(Bag.prototype, "first", {
  set(value) {
    seen.push("bag " + value);
  },
});
seen.length = 0;
last = fillBag(Bag, 1, "b");
console.log(seen.join(), Object.keys(last).join());

// Objects live on through collections with what was stored.
const kept = [];
for (let i = 0; i < 2000; i++) kept.push(label(new Counted(), "k" + i));
Bun.gc(true);
let right = 0;
for (let i = 0; i < kept.length; i++) if (kept[i].label === "k" + i + "!" && kept[i].count === 0) right++;
console.log(right);
//// the-five-lowest-int32-in-fields.ts
// A four-byte slot for an integer keeps a few of the lowest int32 for its own markers. Those numbers are ordinary values: 1 << 31 is a flag like any other.
declare const console: { log(...values: unknown[]): void };
const lines: string[] = [];
function say(label: string, value: unknown) { lines.push(label + ": " + JSON.stringify(value)); }
const lowest = [-2147483648, -2147483647, -2147483646, -2147483645, -2147483644, -2147483643, -2147483642];

const enum Flags { None = 0, A = 1 << 0, B = 1 << 1, C = 1 << 2, Top = 1 << 31 }
class Point { constructor(public flags: number, public id: number) {} }
class Late { flags = 0; id = 0; other?: number; }
interface Rec { flags: number; id: number }
const Made = function (this: Rec, flags: number, id: number) { this.flags = flags; this.id = id; } as unknown as new (flags: number, id: number) => Rec;
function flagsOf(r: Rec): number { return r.flags; }
function hasTop(r: Rec): boolean { return (r.flags & Flags.Top) !== 0; }
function add(r: Rec, f: number) { r.flags |= f; }
function sum(list: Rec[]): number { let t = 0; for (const r of list) t += flagsOf(r) % 1000 + r.id; return t; }

const points: Rec[] = [], lates: Rec[] = [], mades: Rec[] = [], literals: Rec[] = [];
for (let round = 0; round < 300; round++) for (let i = 0; i < lowest.length; i++) {
  points.push(new Point(lowest[i], i)); const late = new Late(); late.flags = lowest[i]; late.id = i; late.other = lowest[i]; lates.push(late);
  mades.push(new Made(lowest[i], i)); literals.push({ flags: lowest[i], id: i });
}
say("sums", [sum(points), sum(lates), sum(mades), sum(literals)]);
say("points", points.slice(0, 7).map(flagsOf)); say("lates", lates.slice(0, 7).map(r => [flagsOf(r), (r as Late).other])); say("mades", mades.slice(0, 7).map(flagsOf)); say("literals", literals.slice(0, 7).map(flagsOf));
say("keys", [Object.keys(points[0]).join(), Object.keys(lates[1]).join(), Object.keys(mades[2]).join(), Object.keys(literals[3]).join()]);
say("top", [points, lates, mades, literals].map(list => list.slice(0, 7).map(hasTop)));
for (const list of [points, lates, mades, literals]) { const r = list[6]; r.flags = 0; add(r, Flags.Top); const first = flagsOf(r); add(r, Flags.A); const second = flagsOf(r); add(r, Flags.B | Flags.C); say("set by bits", [first, second, flagsOf(r), JSON.stringify(r)]); }
{ const p = new Point(Flags.Top | Flags.A, Flags.Top); say("both fields", [p.flags, p.id, p.flags === -2147483647, p.id === -2147483648, { ...p }]); }
{ const copies = points.slice(0, 5).map(p => ({ ...p })); say("spread", copies); say("assign", Object.assign(new Late(), lates[0])); }
say("sums again", [sum(points), sum(lates), sum(mades), sum(literals)]);
console.log(lines.join("\n"));
//// the-functions-under-callee-of-strict-arguments-are-asked-in-place.js
"use strict";
// The function under get | set of `callee` of the arguments of strict code, and of `caller` | `arguments` of Function.prototype, is one function of the engine that throws a TypeError. Each question stands in place.
function byDescriptor() {
  const found = Object.getOwnPropertyDescriptor(arguments, "callee");
  console.log("descriptor: typeof get", typeof found.get);
  console.log("descriptor: typeof set", typeof found.set);
  console.log("descriptor: get is set", found.get === found.set);
  console.log("descriptor: get is undefined", found.get === undefined);
  console.log("descriptor: instanceof", found.get instanceof Function);
  console.log("descriptor: length", found.get.length);
  let called;
  try { found.get(); called = "returned"; } catch (error) { called = error.constructor.name; }
  console.log("descriptor: called", called);
  const holder = { held: found.get };
  console.log("descriptor: stored", typeof holder.held);
  console.log("descriptor: truthy", found.get ? "yes" : "no");
  console.log("descriptor: has value", "value" in found);
  console.log("descriptor: frozen", Object.isFrozen(found.get));
}
function byReflect() {
  const found = Reflect.getOwnPropertyDescriptor(arguments, "callee");
  console.log("reflect: typeof get", typeof found.get);
  let called;
  try { found.set(1); called = "returned"; } catch (error) { called = error.constructor.name; }
  console.log("reflect: called", called);
  console.log("reflect: truthy", found.set ? "yes" : "no");
}
function byAllDescriptors() {
  const found = Object.getOwnPropertyDescriptors(arguments).callee;
  console.log("all: typeof get", typeof found.get);
  let called;
  try { found.get.call(undefined); called = "returned"; } catch (error) { called = error.constructor.name; }
  console.log("all: called", called);
}
function byLookup() {
  const getter = arguments.__lookupGetter__("callee");
  console.log("lookup: typeof", typeof getter);
  let called;
  try { getter(); called = "returned"; } catch (error) { called = error.constructor.name; }
  console.log("lookup: called", called);
}
function sameEverywhere() {
  const mine = Object.getOwnPropertyDescriptor(arguments, "callee").get;
  const ofCaller = Object.getOwnPropertyDescriptor(Function.prototype, "caller").get;
  const ofArguments = Object.getOwnPropertyDescriptor(Function.prototype, "arguments").set;
  console.log("same: caller", typeof ofCaller, mine === ofCaller);
  console.log("same: arguments", typeof ofArguments, mine === ofArguments);
  const list = [mine, ofCaller, ofArguments];
  console.log("same: in a list", list.map(each => typeof each).join());
}
byDescriptor(1, 2);
byReflect(1, 2);
byAllDescriptors(1, 2);
byLookup(1, 2);
sameEverywhere(1, 2);
//// the-list-of-own-keys-is-the-same-however-it-is-used.js
const lines = [];
const say = (...parts) => lines.push(parts.join(" "));

const shape = { a: 1, b: 2, c: 3, d: 4, e: 5 };
say("measured", Object.keys(shape).length);
say("joined", Object.keys(shape).join());
say("searched", Object.keys(shape).includes("c"), Object.keys(shape).includes("z"), Object.keys(shape).indexOf("e"));
say("each call makes a list", Object.keys(shape) !== Object.keys(shape));

const changed = Object.keys(shape);
changed.push("more");
changed[0] = "first";
say("a list that is changed", changed.join(), Object.keys(shape).join());

function listOf(value) {
  return Object.keys(value).join() + ":" + Object.keys(value).length;
}
say("in the order of creation", listOf({ z: 1, y: 2, x: 3 }), listOf({ x: 3, y: 2, z: 1 }));
say("indexes first", listOf({ b: 1, 2: 1, a: 1, 1: 1, "-1": 1, "01": 1 }));
say("no symbols", listOf({ a: 1, [Symbol("s")]: 2, [Symbol.iterator]: 3, b: 4 }));
say("accessors are listed and not run", listOf({ a: 1, get b() { say("the getter ran"); return 2; }, set c(value) {}, d: 4 }));
say("methods", listOf({ a() {}, b: () => 1, async c() {}, *d() {} }));
say("nothing inherited", listOf(Object.create({ above: 1 })), listOf(Object.assign(Object.create({ above: 1 }), { own: 2 })));

function optional(withMiddle) {
  const made = { first: 1 };
  if (withMiddle) made.middle = 2;
  made.last = 3;
  return made;
}
say("a name that is added at times", listOf(optional(true)), listOf(optional(false)));

const emptied = { a: 1, b: 2, c: 3 };
delete emptied.b;
say("behind a delete", listOf(emptied));
emptied.b = 4;
say("added again", listOf(emptied));

const hidden = { a: 1, b: 2, c: 3 };
Object.defineProperty(hidden, "b", { enumerable: false });
say("a name that is hidden", listOf(hidden));
Object.defineProperty(hidden, "d", { value: 4 });
Object.defineProperty(hidden, "e", { value: 5, enumerable: true });
say("names that are defined", listOf(hidden));
say("frozen and sealed", listOf(Object.freeze({ a: 1, b: 2 })), listOf(Object.seal({ c: 1 })));

class Point {
  x = 1;
  y = 2;
  #secret = 3;
  static origin = 0;
  get length() { return this.#secret; }
  move() {}
}
////= lines-162	Point3	Point	z	3
say("instances", listOf(new Point()), listOf(new Point3()), listOf(Point), listOf(Point.prototype));

say("what is no object of the program", listOf([7, 8]), listOf("ab"), listOf(5), listOf(true), listOf(function named(a) {}), listOf(new Map([[1, 2]])));
for (const nothing of [undefined, null]) {
  try {
    Object.keys(nothing);
  } catch (error) {
    say("of nothing", error instanceof TypeError);
  }
}
say("behind a proxy", listOf(new Proxy({ a: 1, b: 2 }, { ownKeys() { return ["b", "a"]; } })));

const many = [{ a: 1, b: 2 }, { b: 2, a: 1 }, { a: 1 }, {}, new Point(), [1], optional(true)];
let counted = 0;
for (let i = 0; i < 700; i++) counted += Object.keys(many[i % many.length]).length;
say("counted", counted);

let read = 0;
for (let i = 0; i < 100; i++) for (const key of Object.keys(shape)) read += shape[key];
say("read by its keys", read);

const growing = {};
const lengths = [];
for (const name of ["p", "q", "r"]) {
  growing[name] = 1;
  lengths.push(Object.keys(growing).length);
}
say("while it grows", lengths.join());

console.log(lines.join("\n"));
//// the-members-of-a-literal-behind-an-accessor-a-computed-key-or-a-spread-are-listed.js
// The members of a literal that stand behind an accessor, a computed key, a spread, a call or a name that is no field are own properties like the others: JSON.stringify, Object.keys, Reflect.ownKeys and for-in list them.
const tag = Symbol("tag");
const show = (title, o) => console.log(title, JSON.stringify(o), Object.keys(o).join(), Reflect.ownKeys(o).map(String).join(), Object.entries(o).length);
function spread(rest) { return { a: 1, ...rest, b: 2 }; }
show("spread", spread({ x: 9 }));
show("empty spread", spread({}));
show("spread over", spread({ b: 7, a: 8 }));
function computed(key) { return { a: 1, [key]: 5, b: 2 }; }
show("computed", computed("k"));
show("computed symbol", computed(tag));
show("computed same", computed("b"));
show("computed index", computed(0));
function called(f) { return { a: 1, m: f(), b: 2 }; }
show("call", called(() => 3));
function getter() { return { a: 1, get g() { return 4; }, b: 2 }; }
show("getter", getter());
function method() { return { a: 1, m() { return 4; }, b: 2 }; }
show("method", method());
function proto(p) { return { a: 1, __proto__: p, b: 2 }; }
show("proto", proto({ inherited: 1 }));
function numeric() { return { a: 1, 1.5: 5, b: 2 }; }
show("numeric", numeric());
function nested(rest) { return { a: { c: 1, ...rest, d: 2 }, ...rest, b: { e: 1, [tag]: 2, f: 3 } }; }
show("nested", nested({ x: 9 }));
const direct = { a: 1, ...{ x: 9 }, b: 2 };
console.log(JSON.stringify(direct), Object.keys(direct).join());
const directComputed = { a: 1, [tag]: 2, b: 3 };
console.log(JSON.stringify(directComputed), Object.keys(directComputed).join());
for (const k in directComputed) console.log("for in", k);
console.log(JSON.stringify({ ...directComputed }), JSON.stringify(Object.assign({}, directComputed)));
//// the-members-of-a-typed-object-are-assigned-to-an-empty-literal-validated.ts
// The names that Object.assign copies onto `{}` are those of the source's type, so the literal's layout gets its fields from the copy. The build checks itself while it runs:
// it stops where the object that the literal makes is not what the types of `copy` and of what is read from it say.
interface Pair { label: string; count: number }
function pair(label: string): Pair { return { label, count: label.length }; }
function copyUnder(key: string, source: Pair) {
  const byKey: any = Object.assign({}, source);
  byKey[key] = source.count + 1;
  return byKey;
}
const assigned = pair("r");
const copy = Object.assign({}, assigned);
console.log(copy.label, copy.count, Object.keys(copy).join());
const twice = Object.assign({}, assigned, { more: true });
console.log(twice.label, twice.count, twice.more, Object.keys(twice).join());
console.log(JSON.stringify(copyUnder("k" + copy.count, assigned)), JSON.stringify(copyUnder("label", pair("long"))));
console.log(JSON.stringify(Object.assign({}, {})), Object.keys(Object.assign({}, null, undefined, "ab")).join());
//// the-prototype-property-of-a-function-is-replaced-between-constructions.js
// The prototype property of a constructor function is replaced by a store and by definitions, at last by null, between constructions.
function Shape(n) { this.n = n; this.tag = "s"; }
Shape.prototype.area = function () { return this.n * 2; };
function make(n) { return new Shape(n); }
const out = [];
for (let i = 0; i < 9; i++) {
  if (i === 3) Shape.prototype = { area() { return this.n * 3; } };
  if (i === 5) Object.defineProperty(Shape, "prototype", { value: { area() { return this.n * 5; } } });
  if (i === 7) Object.defineProperty(Shape, "prototype", { value: null, writable: false });
  const s = make(i), r = Reflect.construct(Shape, [i]), t = Reflect.construct(Object, [], Shape);
  out.push([typeof s.area === "function" ? s.area() : "none", typeof r.area === "function" ? r.area() : "none", typeof t.area, s instanceof Object, Object.getPrototypeOf(s) === Shape.prototype, Object.getPrototypeOf(s) === Object.prototype, s.n + s.tag].join(" "));
}
console.log(out.join("\n"));
//// the-size-of-a-written-set-or-map-is-asked-behind-its-first-lookup.ts
// A Set or a Map written as a literal of texts is asked for its size, then for a key, then for its size again, all in one function, at the first time that anybody touches it.
const word: string = String(process.argv[2] ?? "beta");
const piece: string = ("x" + word + "y").slice(1, 1 + word.length);
const absent: string = word + "?";
const lines: string[] = [];
function report(label: string, ...values: unknown[]): void { lines.push(label + " " + JSON.stringify(values)); }

const setForHas = new Set(["alpha", "beta", "gamma"]);
function sizeAroundHas(w: string): unknown[] { const before = setForHas.size; const found = setForHas.has(w); return [before, found, setForHas.size]; }
const mapForGet = new Map([["alpha", 1], ["beta", 2], ["gamma", 3], ["delta", 4]]);
function sizeAroundGet(w: string): unknown[] { const before = mapForGet.size; const found = mapForGet.get(w); return [before, found, mapForGet.size]; }
const mapForHas = new Map([["alpha", 1], ["beta", 2]]);
function sizeAroundMapHas(w: string): unknown[] { const before = mapForHas.size; const found = mapForHas.has(w); return [before, found, mapForHas.size]; }
const setForPiece = new Set(["alpha", "beta", "gamma", "delta", "epsilon"]);
function sizeAroundPiece(w: string): unknown[] { const before = setForPiece.size; const found = setForPiece.has(w); return [before, found, setForPiece.size]; }
const setForMiss = new Set(["alpha", "beta", "gamma"]);
function sizeAroundMiss(w: string): unknown[] { const before = setForMiss.size; const found = setForMiss.has(w); return [before, found, setForMiss.size]; }
const setInLoop = new Set(["alpha", "beta", "gamma"]);
function sizeInLoop(w: string): number { let total = 0; for (let turn = 0; turn < 1000; turn++) { total += setInLoop.size; if (turn === 500 && setInLoop.has(w)) total += 1_000_000; } return total; }
const mapTwice = new Map([["alpha", 1], ["beta", 2], ["gamma", 3]]);
function getTwice(w: string): unknown[] { return [mapTwice.get(w), mapTwice.get("alpha"), mapTwice.get(w), mapTwice.size]; }
const setWalked = new Set(["alpha", "beta", "gamma"]);
function lookupInsideWalk(w: string): unknown[] { const seen: string[] = []; for (const text of setWalked) { seen.push(text + (setWalked.has(w) ? "+" : "-") + setWalked.size); } return seen; }
const setWithIterator = new Set(["alpha", "beta", "gamma"]);
function lookupBetweenSteps(w: string): unknown[] { const steps = setWithIterator.values(); const first = steps.next().value; const found = setWithIterator.has(w); return [first, found, steps.next().value, steps.next().value, steps.next().done, setWithIterator.size]; }
const mapWritten = new Map([["alpha", 1], ["beta", 2]]);
function lookupThenStore(w: string): unknown[] { const before = mapWritten.size; const found = mapWritten.get(w); mapWritten.set("new", 9); return [before, found, mapWritten.size, mapWritten.get("new"), [...mapWritten.keys()].join()]; }
const setSpread = new Set(["alpha", "beta", "gamma"]);
function lookupThenSpread(w: string): unknown[] { const found = setSpread.has(w); return [found, [...setSpread].join(), setSpread.size]; }

for (const round of [1, 2]) {
  report("has " + round, sizeAroundHas(word));
  report("get " + round, sizeAroundGet(word));
  report("map has " + round, sizeAroundMapHas(word));
  report("a piece of another text " + round, sizeAroundPiece(piece));
  report("a miss " + round, sizeAroundMiss(absent));
  report("in a loop " + round, sizeInLoop(word));
  report("twice " + round, getTwice(word));
  report("inside a walk " + round, lookupInsideWalk(word));
  report("between the steps of an iterator " + round, lookupBetweenSteps(word));
  report("then a store " + round, lookupThenStore(word));
  report("then a spread " + round, lookupThenSpread(word));
}
console.log(lines.join("\n"));
