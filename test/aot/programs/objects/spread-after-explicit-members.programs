//// spread-after-explicit-members.ts
// An object literal without a written type, with a spread of a source whose members are not all known behind its written members: the spread may bring a written member again, of another kind.
const row = (name: string, f: () => unknown) => { let r: unknown; try { r = JSON.stringify(f()); } catch (e) { r = "THROWS " + (e as Error).message.split(" (bun")[0]; } console.log(name + ": " + r); };
const byObject = (more: object = {}) => ({ sound: 1, name: "shapes", ...more });
const byRecord = (more: Record<string, unknown> = {}) => ({ sound: 1, name: "shapes", ...more });
const byEmpty = (more: {} = {}) => ({ sound: 1, name: "shapes", ...more });
const byUnknown = (more: unknown = {}) => ({ sound: 1, name: "shapes", ...(more as object) });
const byAny = (more: any = {}) => ({ sound: 1, name: "shapes", ...more });
const spreadFirst = (more: object = {}) => ({ ...more, sound: 1, name: "shapes" });
const nested = (more: object = {}) => ({ install: { cache: "c", linker: "hoisted", ...more } });
for (const [name, f] of [["object", byObject], ["Record<string, unknown>", byRecord], ["{}", byEmpty], ["unknown as object", byUnknown], ["any", byAny], ["the spread first", spreadFirst], ["nested", nested]] as const) {
  row(name + ": nothing more", () => f());
  row(name + ": one member more", () => f({ extra: true }));
  row(name + ": a written member overridden by another kind", () => f({ sound: "loud" }));
  row(name + ": the result read", () => { const r = f({ extra: true }) as any; return [r.sound ?? r.install?.cache, r.extra ?? r.install?.extra, Object.keys(r)]; });
}
const port = (options: Record<string, unknown>) => { const made = { port: 80, host: "h", ...options }; return JSON.stringify(made); };
for (const given of ["81", undefined, null, 81]) row("into a variable, port " + String(given), () => port({ port: given }));
interface Written { port: number; host: string }
const written = (options: object): Written => ({ port: 80, host: "h", ...options });
row("under a written type: nothing more", () => written({}));
row("under a written type: one member more", () => written({ extra: true }));
function generic<T extends object>(more: T) { return { sound: 1, name: "shapes", ...more }; }
row("a type parameter", () => [generic({ extra: true }), generic({ sound: "loud" } as object)]);
interface Wide { model: string; max: number; judges?: boolean; a?: number; b?: number; c?: number; d?: number; e?: number; f?: number; g?: number; h?: string[] }
const wide = (options: Wide) => [options.model, options.max, options.judges, options.h?.length];
for (const served of [true, false]) row("a conditional spread of a literal, then a written type, " + served, () => { const made = { model: "m", max: 1, ...(served && { judges: true }), h: ["h"] }; return [wide(made), Object.keys(made)]; });
row("one of two literals", () => { const made = { model: "m", ...(frames() ? { max: 1 } : { max: 2, a: 3 }) }; return [wide(made), Object.keys(made)]; });
function frames() { return Object.keys({}).length > 0; }
const twice = (a: object, b: object) => ({ first: 1, ...a, second: 2, ...b });
row("two spreads", () => [twice({}, {}), twice({ first: "f" }, { second: "s" }), twice({ second: "lost" }, { first: "last" })]);
//// spread-and-assign-guards.js
// Object.assign and object spread copy data properties by a plan per pair of structures. A target or source that the plan cannot serve takes the generic path and gives the same result.
"use strict";
const lines = [];
const events = [];
const parse = text => JSON.parse(text);

function describe(object) {
  return Reflect.ownKeys(object)
    .map(key => {
      const descriptor = Object.getOwnPropertyDescriptor(object, key);
      const flags = (descriptor.writable ? "w" : "-") + (descriptor.enumerable ? "e" : "-") + (descriptor.configurable ? "c" : "-");
      return String(key) + "=" + ("value" in descriptor ? String(descriptor.value) : "accessor") + ":" + flags;
    })
    .join(" ");
}
function show(name, run) {
  const results = [];
  for (let round = 0; round < 4; round++) {
    let result;
    try {
      result = describe(run());
    } catch (error) {
      result = error.constructor.name;
    }
    if (events.length) result += " [" + events.splice(0).join(", ") + "]";
    if (!results.includes(result)) results.push(result);
  }
  lines.push(name + ": " + results.join(" | "));
}

function assign(target, source) { return Object.assign(target, source); }
function assignTwo(target, first, second) { return Object.assign(target, first, second); }
function assignAndKeep(target, source) {
  try {
    Object.assign(target, source);
  } catch (error) {
    events.push(error.constructor.name);
  }
  return target;
}
function spread(source) { return { ...source }; }
function spreadAfter(source) { return { a: "own", z: "own", ...source }; }
function spreadBefore(source) { return { ...source, a: "own" }; }
function spreadTwo(first, second) { return { ...first, ...second }; }
function spreadUnder(prototype, source) { return { __proto__: prototype, ...source }; }

const small = '{"a":1,"b":2,"c":3}';
const wide = JSON.stringify(Object.fromEntries(Array.from({ length: 20 }, (_, i) => ["p" + i, i])));

show("assign to an empty literal", () => assign({}, parse(small)));
show("assign over own properties", () => assign({ c: "own", a: "own" }, parse(small)));
show("assign to a parsed target", () => assign(parse('{"c":0,"x":0}'), parse(small)));
show("assign that grows the storage", () => assign(parse('{"x":0}'), parse(wide)));
show("assign two sources", () => assignTwo({}, parse(small), parse('{"b":"second","d":4}')));
show("assign a literal", () => assign({}, { a: 1, b: "two", c: 3.5, d: null, e: undefined, f: true }));
show("assign a literal to a parsed target", () => assign(parse('{"b":0}'), { a: 1, b: "two" }));
show("assign an object to itself", () => { const object = parse(small); return assign(object, object); });
show("assign nothing", () => assignTwo(parse(small), null, undefined));
show("spread a parsed object", () => spread(parse(small)));
show("spread 20 properties", () => spread(parse(wide)));
show("spread after own properties", () => spreadAfter(parse(small)));
show("spread before an own property", () => spreadBefore(parse(small)));
show("spread two sources", () => spreadTwo(parse(small), parse('{"b":"second","d":4}')));
show("spread a literal", () => spread({ a: 1, b: "two", c: 3.5 }));
show("spread primitives", () => spreadTwo(spreadTwo(null, 7), spreadTwo(undefined, "ab")));

function Foo() {}
Foo.prototype.greet = function () { return "first"; };
class Bar { greet() { return "first"; } }
function greet(object) { return object.greet(); }
function greetOften(object) { let text = ""; for (let i = 0; i < 200; i++) text = greet(object); return text; }
const foo = new Foo(), bar = new Bar();
for (const name of ["second", "third", "fourth"]) {
  const before = greetOften(foo) + " " + greetOften(bar);
  const mixin = Object.fromEntries([["greet", function () { return name; }]]);
  assign(Foo.prototype, mixin);
  assign(Bar.prototype, mixin);
  lines.push("method replaced on a prototype: " + before + " -> " + greetOften(foo) + " " + greetOften(bar) + ", keys " + Object.keys(Foo.prototype).join() + "|" + Object.keys(Bar.prototype).join());
}
assign(Foo.prototype, { greet() { return "from a literal"; }, extra: 1 });
lines.push("method replaced by a literal: " + greetOften(foo) + " " + foo.extra);

function readA(object) { return object.a; }
function readOften(object) { let value; for (let i = 0; i < 200; i++) value = readA(object); return value; }
const shared = assign(parse('{"a":0}'), parse(small));
const child = Object.create(shared);
const inheritedBefore = readOften(child);
assign(shared, parse('{"a":"changed","b":2,"c":3}'));
lines.push("target became a prototype: " + inheritedBefore + " -> " + readOften(child));

show("frozen target", () => assignAndKeep(Object.freeze(parse('{"a":0}')), parse(small)));
show("frozen literal", () => assignAndKeep(Object.freeze({ a: 0 }), parse(small)));
show("frozen target, empty source", () => assign(Object.freeze(parse('{"a":0}')), parse("{}")));
show("sealed target", () => assignAndKeep(Object.seal(parse('{"a":0,"b":0}')), parse(small)));
show("sealed target with every name", () => assign(Object.seal(parse('{"c":0,"b":0,"a":0}')), parse(small)));
show("non-extensible target", () => assignAndKeep(Object.preventExtensions(parse('{"b":0}')), parse(small)));
show("read-only own property", () => assignAndKeep(Object.defineProperty(parse('{"a":0}'), "b", { value: "fixed", enumerable: true }), parse(small)));
show("own setter", () => assign(Object.defineProperty(parse('{"a":0}'), "b", { set(value) { events.push("set b " + value); }, configurable: true }), parse(small)));
show("hidden own property", () => assign(Object.defineProperty({}, "b", { value: 0, writable: true, configurable: true }), parse(small)));

function dictionary(count) {
  const object = {};
  for (let i = 0; i < count; i++) object["k" + i] = i;
  for (let i = 0; i < count; i += 2) delete object["k" + i];
  return object;
}
function summarize(object) {
  const keys = Object.keys(object);
  return keys.length + " keys, " + keys.slice(0, 2).join() + " .. " + keys.slice(-4).map(key => key + "=" + object[key]).join();
}
lines.push("dictionary target: " + summarize(assign(dictionary(300), parse('{"k1":"replaced","a":1,"k0":"again"}'))));
lines.push("dictionary source: " + summarize(assign(parse('{"k1":"own","a":1}'), dictionary(300))));
lines.push("dictionary spread: " + summarize(spreadAfter(dictionary(300))));

const withSetter = { set a(value) { events.push("inherited set a " + value); } };
const withReadOnly = Object.defineProperty({}, "b", { value: "inherited", writable: false });
show("setter on the prototype", () => assign(Object.create(withSetter), parse(small)));
show("read-only property on the prototype", () => assignAndKeep(Object.create(withReadOnly), parse(small)));
show("spread ignores a setter on the prototype", () => spreadUnder(withSetter, parse(small)));
show("spread ignores a read-only property on the prototype", () => spreadUnder(withReadOnly, parse(small)));
show("proxy as the prototype", () => assign(Object.create(new Proxy({}, { set(target, key, value, receiver) { events.push("trap " + String(key)); return Reflect.set(target, key, value, receiver); } })), parse(small)));

const base = {};
const middle = Object.create(base);
show("plain prototypes", () => assign(Object.create(middle), parse(small)));
Object.defineProperty(base, "b", { set(value) { events.push("late set b " + value); }, configurable: true });
show("setter added to a prototype later", () => assign(Object.create(middle), parse(small)));
delete base.b;
show("setter removed again", () => assign(Object.create(middle), parse(small)));
Object.defineProperty(middle, "c", { value: "fixed", writable: false, configurable: true });
show("read-only property added to a prototype later", () => assignAndKeep(Object.create(middle), parse(small)));

const symbol = Symbol("visible"), hiddenSymbol = Symbol("hidden");
function withGetters() {
  return {
    get a() { events.push("get a"); return 1; },
    b: 2,
    get c() { events.push("get c"); return 3; },
  };
}
function withChangingGetter() {
  return {
    get a() { events.push("get a"); delete this.b; this.d = "late"; return 1; },
    b: 2,
    c: 3,
  };
}
function withSymbols() {
  const object = { [symbol]: "s", a: 1 };
  Object.defineProperty(object, hiddenSymbol, { value: "h", enumerable: false });
  Object.defineProperty(object, "hidden", { value: "h", enumerable: false });
  object.b = 2;
  return object;
}
for (const [name, copy] of [["assign", source => assign({}, source)], ["assign over", source => assign(parse('{"b":0,"1":0}'), source)], ["spread", spread], ["spread after", spreadAfter]]) {
  show(name + ": getters", () => copy(withGetters()));
  show(name + ": getter that changes the source", () => copy(withChangingGetter()));
  show(name + ": throwing getter", () => copy({ a: 1, get b() { throw new RangeError("b"); } }));
  show(name + ": index keys", () => copy({ 2: "two", b: 1, 0: "zero", a: 2, 1: "one" }));
  show(name + ": parsed index keys", () => copy(parse('{"2":"two","b":1,"0":"zero"}')));
  show(name + ": array", () => copy(["x", , "z"]));
  show(name + ": symbols and hidden properties", () => copy(withSymbols()));
  show(name + ": own __proto__", () => { const result = copy(parse('{"a":1,"__proto__":{"inherited":true}}')); events.push("inherited " + result.inherited); return result; });
  show(name + ": class instance", () => copy(new (class { #secret = 1; a = 1; b = 2; get c() { return this.#secret; } })()));
  show(name + ": proxy", () => copy(new Proxy(parse(small), { ownKeys(target) { events.push("ownKeys"); return Reflect.ownKeys(target).reverse(); } })));
}

const sources = [];
for (let i = 0; i < 5000; i++) {
  if (i & 1) {
    const source = {};
    source["p" + i] = i;
    source.shared = i + 1;
    sources.push(source);
  } else {
    sources.push(parse('{"p' + i + '":' + i + ',"shared":' + (i + 1) + "}"));
  }
}
const copies = [];
let wrong = 0, sum = 0;
for (let round = 0; round < 2; round++) {
  for (let i = 0; i < sources.length; i++) {
    const assigned = assign(parse('{"first":0}'), sources[i]);
    const spreadCopy = spreadAfter(sources[i]);
    if (Object.keys(assigned).join() !== "first,p" + i + ",shared" || Object.keys(spreadCopy).join() !== "a,z,p" + i + ",shared") wrong++;
    sum += assigned["p" + i] + assigned.shared + spreadCopy["p" + i] + spreadCopy.shared;
    copies.push(assigned, spreadCopy);
  }
}
lines.push("5000 pairs of shapes: " + wrong + " wrong, sum " + sum + ", " + copies.length + " copies");

console.log(lines.join("\n"));
//// spread-copies.js
// Object spread copies. A stub copies a plain object whose properties are all inline, from a cache keyed by structure. The runtime copies every other source.
const print = (...parts) => console.log(parts.join(" "));

const show = object =>
  "{ " +
  Reflect.ownKeys(object)
    .map(key => {
      const { value, writable, enumerable, configurable } = Object.getOwnPropertyDescriptor(object, key);
      const text = typeof value === "function" ? "function" : JSON.stringify(value);
      return String(key) + ": " + text + (writable && enumerable && configurable ? "" : " (not a default data property)");
    })
    .join(", ") +
  " }" +
  (Object.getPrototypeOf(object) === Object.prototype ? "" : " (another prototype)") +
  (Object.isExtensible(object) ? "" : " (not extensible)");

const forms = [
  ["{ ...o }", o => ({ ...o })],
  ["{ ...o, a: 1 }", o => ({ ...o, a: 1 })],
  ["{ ...o, a: 1, b: 2 }", o => ({ ...o, a: 1, b: 2 })],
  ["{ a: 1, ...o }", o => ({ a: 1, ...o })],
];

const values = [1, 1.5, "text", null, true, { nested: 1 }, [1, 2]];
const textOf = names => "{" + names.map((name, i) => JSON.stringify(name) + ":" + JSON.stringify(values[i])).join(",") + "}";
const namesStartingWithA = count => Array.from({ length: count }, (_, i) => (i === 0 ? "a" : "p" + i));
const namesEndingWithB = count => Array.from({ length: count }, (_, i) => (i === count - 1 ? "b" : "q" + i));

for (const count of [0, 1, 6, 7]) {
  const texts = [textOf(namesStartingWithA(count)), textOf(namesEndingWithB(count))];
  for (const [form, copy] of forms) {
    const counts = new Map();
    let sharedObjects = 0;
    let changedSources = 0;
    for (let i = 0; i < 1000; i++) {
      const text = texts[i & 1];
      const source = JSON.parse(text);
      const copied = copy(source);
      const shown = show(copied);
      counts.set(shown, (counts.get(shown) ?? 0) + 1);
      for (const key in source) {
        if (typeof source[key] === "object" && source[key] !== null && copied[key] === source[key]) sharedObjects++;
      }
      for (const key in copied) copied[key] = i;
      copied.added = i;
      if (JSON.stringify(source) !== text) changedSources++;
    }
    for (const [shown, times] of counts) print(count, "properties,", form + ":", times, "times", shown);
    print(count, "properties,", form + ":", sharedObjects, "shared objects,", changedSources, "changed sources");
  }
}

const sourcesWithOwnStructure = Array.from({ length: 600 }, (_, i) => JSON.parse(`{"k${i}":${i},"shared":"s"}`));
for (const [form, copy] of forms) {
  let keys = 0;
  let mismatches = 0;
  for (let round = 0; round < 3; round++) {
    for (let i = 0; i < sourcesWithOwnStructure.length; i++) {
      const copied = copy(sourcesWithOwnStructure[i]);
      if (copied["k" + i] !== i || copied.shared !== "s") mismatches++;
      keys += Object.keys(copied).length;
    }
  }
  print("600 structures,", form + ":", keys, "keys,", mismatches, "mismatches");
}

function copyInLoop(label, createSource) {
  for (const [form, copy] of forms) {
    const counts = new Map();
    for (let i = 0; i < 100; i++) {
      const shown = show(copy(createSource()));
      counts.set(shown, (counts.get(shown) ?? 0) + 1);
    }
    for (const [shown, times] of counts) print(label + ",", form + ":", times, "times", shown);
  }
}

copyInLoop("out-of-line properties", () => {
  const source = {};
  for (let i = 0; i < 10; i++) source["w" + i] = i;
  return source;
});

let getterCalls = 0;
copyInLoop("getter", () => ({
  x: 1,
  get y() {
    getterCalls++;
    return this.x + 1;
  },
}));
print("getter calls:", getterCalls);

copyInLoop("index keys", () => ({ x: 1, 2: "two", 0: "zero" }));
copyInLoop("index key in parsed JSON", () => JSON.parse('{"x":1,"0":"zero"}'));
copyInLoop("array", () => [1, 2]);
copyInLoop("inherited property", () => Object.assign(Object.create({ inherited: 1 }), { x: 1 }));
copyInLoop("null prototype", () => Object.assign(Object.create(null), { x: 1 }));
copyInLoop("non-enumerable property", () => Object.defineProperty(JSON.parse('{"x":1}'), "hidden", { value: 2, enumerable: false }));
copyInLoop("frozen", () => Object.freeze(JSON.parse('{"x":1,"a":2}')));
copyInLoop("null", () => null);
copyInLoop("undefined", () => undefined);
copyInLoop("string", () => "ab");
copyInLoop("number", () => 7);

class Point {
  constructor(x, y) {
    this.x = x;
    this.y = y;
  }
  sum() {
    return this.x + this.y;
  }
}
copyInLoop("class instance", () => new Point(1, 2));
copyInLoop("class instance with an extra property", () => {
  const point = new Point(1, 2);
  point.extra = "extra";
  return point;
});

class Reading {
  constructor(value) {
    this.value = value;
  }
}
const showNumber = number => (Object.is(number, -0) ? "-0" : String(number));
for (const [form, copy] of forms) {
  for (const value of [1, 1.5, 2 ** 31, -0]) {
    const source = new Reading(value);
    const copied = copy(source);
    copied.value += 0.25;
    const sourceAfterCopyChanged = source.value;
    source.value = 9.5;
    print("number field,", form + ":", "source", showNumber(sourceAfterCopyChanged), "copy", showNumber(copied.value));
  }
}

class Button {
  constructor(label) {
    this.label = label;
  }
  onClick = () => this.label;
}
for (const [form, copy] of forms) {
  let sameFunction = 0;
  let sameReceiver = 0;
  for (let i = 0; i < 100; i++) {
    const source = new Button("label " + i);
    const copied = copy(source);
    if (copied.onClick === source.onClick) sameFunction++;
    copied.label = "changed";
    if (copied.onClick() === "label " + i) sameReceiver++;
  }
  print("arrow function field,", form + ":", sameFunction, "same function,", sameReceiver, "same receiver,", show(copy(new Button("last"))));
}
//// spread-copies-properties-outside-the-slots.ts
// A spread copies what lies beside the slots of its source too.
type Pair = { a: number; b: number };
function make(a: number, b: number): Pair {
  return { a, b };
}
function copyAndAskForAnotherName(p: Pair): unknown {
  if (p == null) return -1;
  const c = { ...p };
  return (c as any).zz;
}
function copyAndHas(p: Pair): boolean {
  if (p == null) return false;
  const c = { ...p };
  return "zz" in c;
}
function copyAndRead(p: Pair): unknown {
  if (p == null) return -1;
  const c = { ...p };
  return c.a;
}
function copyAndStore(p: Pair): unknown {
  if (p == null) return -1;
  const c = { ...p };
  c.a = 9;
  return (c as any).a;
}
function put(o: any, name: string, value: unknown): void {
  o[name] = value;
}

const names = ["zz", "a"];
const pool: Pair[] = [];
for (let i = 0; i < 64; i++) pool.push(make(i, i + 1));
const withAnotherName = make(1, 2);
put(withAnotherName, names[0], 7);
const withText = make(3, 4);
put(withText, names[1], "text");

let total = 0;
for (let round = 0; round < 3000; round++) {
  const p = pool[round & 63];
  total += (copyAndRead(p) as number) + (copyAndStore(p) as number) + (copyAndAskForAnotherName(p) === undefined ? 1 : 0) + (copyAndHas(p) ? 1 : 0);
}
console.log(total);
for (const p of [withAnotherName, withText]) console.log(copyAndAskForAnotherName(p), copyAndHas(p), copyAndRead(p), copyAndStore(p));
//// spread-copy-delete-optional-field.ts
// Deleting an optional field from a spread copy leaves it absent in the copy, even where every object of the type is created with the field and no original loses it.
interface Note { id: number; text?: string }
function make(id: number): Note { return { id, text: "note " + id } }
function lengthOf(note: Note): number { return note.text === undefined ? -1 : note.text.length }
const derived = Object.create(make(0));
let total = 0;
for (let i = 0; i < 2000; i++) {
  const copy: Note = { ...make(i) };
  if (i % 2) delete copy.text;
  total += lengthOf(copy) + ("text" in copy ? 1 : 0);
}
console.log(total, derived.id, derived.text);
//// spread-copy-mutations.js
// A spread copy of a literal that nothing else changes accepts every change JavaScript allows, in cold code and in a hot loop, and the source stays as it was.
const defaults = { a: 1, b: 2 };
const mutations = {
  add(copy) { copy.c = 3 },
  remove(copy) { delete copy.a },
  redefine(copy) { Object.defineProperty(copy, "a", { get() { return 10 }, enumerable: true, configurable: true }) },
  hide(copy) { Object.defineProperty(copy, "b", { value: 20, enumerable: false }) },
  freeze(copy) { Object.freeze(copy) },
  seal(copy) { Object.seal(copy) },
  storeOtherType(copy) { copy.a = "text" },
  storeIndex(copy) { copy[0] = "element" },
  storeSymbol(copy) { copy[Symbol.iterator] = null },
  changePrototype(copy) { Object.setPrototypeOf(copy, { inherited: true }) },
  becomePrototype(copy) { Object.create(copy).own = 1 },
};
function describe(object) {
  return [JSON.stringify(object), Reflect.ownKeys(object).map(String).join(), Object.isFrozen(object), Object.isSealed(object), object.inherited].join(" ");
}
function copyAndMutate(mutate) {
  const copy = { ...defaults };
  mutate(copy);
  return copy;
}
function copyWithStoreAndMutate(mutate) {
  const copy = { ...defaults, b: 5 };
  mutate(copy);
  return copy;
}
for (const name in mutations) {
  const mutate = mutations[name];
  console.log(name, describe(copyAndMutate(mutate)), "|", describe(copyWithStoreAndMutate(mutate)));
  let last;
  for (let i = 0; i < 2000; i++) last = [copyAndMutate(mutate), copyWithStoreAndMutate(mutate)];
  console.log(name, describe(last[0]), "|", describe(last[1]));
}
console.log(defaults.a, defaults.b);
