const wide = {}; for (let i = 0; i < 70; i++) wide[i % 7 ? "p" + i : Symbol.for("s" + i)] = i;
for (let i = 0; i < 3; i++) console.log("seventy properties:", Reflect.ownKeys({ ...wide, more: i }).length, show({ ...wide, more: i }).length);
