//// to-string-tag-of-class-instances.ts
// Object.prototype.toString on instances of the program's classes: the answer is remembered by structure, and forgotten when a prototype on the way gets, changes or loses Symbol.toStringTag.
const tagOf = (value: unknown): string => Object.prototype.toString.call(value);

class Animal {
  name: string;
  constructor(name: string) {
    this.name = name;
  }
  speak(): string {
    return this.name;
  }
}
class Dog extends Animal {
  tricks: number = 0;
}
class Tagged {
  value = 1;
  get [Symbol.toStringTag](): string {
    return "Tagged" + this.value;
  }
}
class Later {
  size = 2;
}
////= lines-162	LaterChild	Later	more	3
type Row = { id: number };

function tags(values: unknown[]): string {
  let all = "";
  for (let round = 0; round < 3; round++) {
    all = "";
    for (const value of values) all += tagOf(value) + " ";
  }
  return all;
}

const later = new Later();
const laterChild = new LaterChild();
const row: Row = { id: 1 };
const values: unknown[] = [new Animal("a"), new Dog("d"), new Tagged(), later, laterChild, row, [1], new Map(), () => 1, Animal, null, undefined, 1, "s", Object.create(later), Object.create(null)];
console.log(tags(values));

(Later.prototype as any)[Symbol.toStringTag] = "Late";
console.log(tags(values));
(LaterChild.prototype as any)[Symbol.toStringTag] = "Child";
console.log(tags(values));
(Later.prototype as any)[Symbol.toStringTag] = 5;
console.log(tags(values));
delete (LaterChild.prototype as any)[Symbol.toStringTag];
console.log(tags(values));
delete (Later.prototype as any)[Symbol.toStringTag];
console.log(tags(values));
(later as any)[Symbol.toStringTag] = "Own";
console.log(tags(values));
Object.defineProperty(Dog.prototype, Symbol.toStringTag, { get() { return "Dog of " + (this as Dog).name; }, configurable: true });
console.log(tags(values), new Dog("e").speak(), new Animal("f").speak());

let count = 0;
for (let i = 0; i < 20000; i++) if (tagOf(i % 2 ? new Animal("x") : new Later()) === "[object Object]") count++;
console.log(count);
//// top-level-literals-in-try/main.ts
// Object literals with members in top-level code inside `try` blocks keep all their members.
// @ts-ignore
import "./text.js";
//// top-level-literals-in-try/text.js
var log = [];
function show(o) { return Object.keys(o).join() + " " + JSON.stringify(o); }
function id(x) { return x; }
var b = { name: "b", hidden: false, count: 1 };
Object.defineProperty(b, "hidden", { enumerable: false }); log.push("1 no try, descriptor: " + show(b));
var c = { name: "c", hidden: false, count: 1 };
try { Object.defineProperty(c, "hidden", { enumerable: false }); log.push("2 try, descriptor: " + show(c)); } catch (e) { log.push("2 threw"); }
var d = {};
try { Object.defineProperty(d, "name", { value: "d", enumerable: true }); log.push("3 try, a new name: " + show(d) + " " + d.name); } catch (e) { log.push("3 threw"); }
try { var e1 = { name: "e", k: 1 }; log.push("4 try, a literal kept: " + show(e1)); } catch (e) { log.push("4 threw"); }
try { var f1 = id({ name: "f", k: 1 }); log.push("5 try, a literal handed on: " + show(f1)); } catch (e) { log.push("5 threw"); }
try { var g1 = { name: id("g"), k: id(1) }; log.push("6 try, members that are calls: " + show(g1)); } catch (e) { log.push("6 threw"); }
var stored = 0, h = { count: 1 };
try { Object.defineProperty(h, "count", { get: () => stored, set: (v) => { stored = v * 10; }, enumerable: true, configurable: true }); } catch (e) { log.push("7 threw"); }
h.count = 4; log.push("7 try, getter and setter: " + h.count + " " + stored + " " + typeof Object.getOwnPropertyDescriptor(h, "count").get);
var list = [];
try { list.push({ name: "zeta", v: 1 }); list.push({ name: "alpha", v: 2 }); list.push({ name: id("mid"), v: 3 }); } catch (e) { log.push("8 threw"); }
log.push("8 try, records pushed: " + (function () { try { return list.toSorted((x, y) => x.name.localeCompare(y.name)).map((r) => r.name).join(); } catch (e) { return e.constructor.name + ": " + e.message; } })());
console.log(log.join("\n"));
//// ts-namespace-as-value.ts
// A TypeScript `namespace` that is used as a value is a real object: `this` in its functions, uses before its statement has run, nested and merged namespaces.
declare const console: any;
function line(name: string, f: () => unknown) { try { console.log(name, JSON.stringify(f())); } catch (e: any) { console.log(name, "THREW", e.constructor.name); } }
line("before the statement: a function", () => { Late.f(); return "ran"; });
line("before the statement: a variable", () => Late.v);
line("before the statement: nested", () => Late.Inner.g());
namespace Late { export function f() { return 1; } export const v = 2; export namespace Inner { export function g() { return 3; } } }
line("after the statement", () => [Late.f(), Late.v, Late.Inner.g()]);
namespace N { export function g(this: unknown) { return typeof this; } export function self(this: unknown) { return this === N; } export const arrow = () => 5; export let count = 0; export function bump() { return ++count; } }
line("this", () => N.g());
line("this is the namespace", () => N.self());
line("detached", () => { const g = N.g; return g(); });
line("by key", () => (N as any)["g"]());
line("an arrow", () => N.arrow());
line("an exported let", () => { N.bump(); N.count += 10; return [N.count, N.bump()]; });
namespace Outer { export namespace Inner { export function who(this: unknown) { return this === Inner; } export function outer(this: unknown) { return this === Outer; } } }
line("nested: this", () => [Outer.Inner.who(), Outer.Inner.outer()]);
namespace Merged { export function a(this: unknown) { return this === Merged; } }
namespace Merged { export function b(this: unknown) { return this === Merged; } export const both = () => [a.call(Merged), b.call(Merged)]; }
line("merged", () => [Merged.a(), Merged.b(), Merged.both()]);
function Fn() { return "called"; }
namespace Fn { export function member(this: unknown) { return this === Fn; } }
line("with a function", () => [Fn(), Fn.member()]);
class Cl { static s(this: unknown) { return this === Cl; } }
namespace Cl { export function member(this: unknown) { return this === Cl; } }
line("with a class", () => [Cl.s(), Cl.member()]);
namespace Unused { export function never() { return 1; } }
line("keys", () => [Object.keys(Late), Object.keys(N), Object.keys(Outer), Object.keys(Merged), Object.keys(Fn), Object.keys(Cl)]);
line("stored to from outside", () => { (N as any).g = function () { return "replaced"; }; return N.g(); });
//// typed-object-as-prototype.ts
// A typed object serves as the prototype of another object.
const base = { greeting: "hello", count: 1 }
const derived = Object.create(base)
derived.own = true
console.log(derived.greeting, derived.count, derived.own, Object.getPrototypeOf(derived) === base, "greeting" in derived, Object.keys(derived).join())
base.count = 2
console.log(derived.count)
derived.count = 5
console.log(derived.count, base.count)
class Point { constructor(public x: number, public y: number) {} sum() { return this.x + this.y } }
const p = new Point(1, 2)
const q = Object.create(p)
console.log(q.x, q.y, q instanceof Point, p.sum())
const many: unknown[] = []
for (let i = 0; i < 20000; i++) many.push(Object.create({ i }))
console.log((many[19999] as any).i)
// The prototype of a compiled object is not changed where JavaScript refuses it too. Where JavaScript changes it: type-rules/typed-object-prototype-changes.
const parent = { inherited: "yes", hello() { return "hi " + (this as any).a } }
try { Object.setPrototypeOf(parent, Object.create(parent)); console.log("no cycle found") } catch (e) { console.log((e as Error).name) }
const sealed = Object.preventExtensions({ b: 2 })
try { Object.setPrototypeOf(sealed, parent); console.log("changed") } catch (e) { console.log((e as Error).name) }
// A method of Object.prototype is shadowed on a compiled object, by a name that is not known at compile time.
const shadowing: Record<string, unknown> = { kept: 1 }
for (const key of ["toString", "valueOf", "hasOwnProperty"]) shadowing[key] = () => "mine " + key
console.log(String((shadowing.toString as () => string)()), Object.keys(shadowing).join(), `${shadowing}`)
const withSetter = Object.create({ set seen(v: number) { (this as any).stored = v * 2 } }) as any
const child: any = { own: 1 }
Object.setPrototypeOf(child, withSetter)
child.seen = 21
console.log(child.stored, Object.keys(child).join())
//// typed-objects-used-by-untyped-code.ts
// User-defined typed objects are read and written by code that does not know their type.
class P {
  flag = true
  small = 7
  big = 5000000000
  real = 1.5
  name = "p"
  next: P | null = null
  maybe: number | undefined = undefined
  opt?: number
  any: unknown = 3
}
function hide(x: unknown): any { return x }
const p = new P()
const x = hide(p)
console.log(x.flag, x.small, x.big, x.real, x.name, x.next, x.maybe, x.opt, x.any, x.none)
x.flag = false
x.small = 8
x.real = 2.25
x.name = "q"
x.next = p
x.maybe = 4
x.any = "s"
console.log(p.flag, p.small, p.real, p.name, p.next === p, p.maybe, p.any)
let total = 0
const many: any[] = [hide(new P()), hide({ small: 1, real: 0.5 }), hide(new P())]
for (let round = 0; round < 1000; round++) {
  for (let i = 0; i < many.length; i++) total += many[i].small + many[i].real
}
console.log(total, Object.keys(x).join(","), JSON.stringify(hide({ a: 1, b: [true, null], c: "d" })))
//// undefined-stored-into-fields-that-lie-outside-the-cell.ts
// An object with many fields that are seldom filled keeps some of them outside its cell, and room for those is made when a value needs it.
// `undefined` needs none: it is stored where the room is there already, in a new object, in one that has some of the room, and in one that has all of it.
function given<T>(text: string): T { return JSON.parse(text) as T; }
class Wide {
  id: number; name: string;
  a?: string; b?: number; c?: object; d?: string[]; e?: boolean; f?: Wide; g?: string; h?: number; i?: object; j?: string; k?: number; l?: boolean; m?: string; n?: number; o?: object; p?: string; q?: number; r?: Wide; s?: string; t?: number;
  constructor(id: number, name: string) {
    this.id = id; this.name = name;
    this.a = undefined; this.b = undefined; this.c = undefined; this.d = undefined; this.e = undefined; this.f = undefined; this.g = undefined; this.h = undefined; this.i = undefined; this.j = undefined;
    this.k = undefined; this.l = undefined; this.m = undefined; this.n = undefined; this.o = undefined; this.p = undefined; this.q = undefined; this.r = undefined; this.s = undefined; this.t = undefined;
  }
}
const letters = "abcdefghijklmnopqrst".split("") as (keyof Wide)[];
function show(wide: Wide): string { return wide.id + wide.name + ":" + letters.map(letter => { const value = wide[letter]; return value === undefined ? "-" : typeof value === "object" ? "o" : String(value); }).join("") + ":" + Object.keys(wide).length; }
function clearAll(wide: Wide) {
  wide.a = undefined; wide.b = undefined; wide.c = undefined; wide.d = undefined; wide.e = undefined; wide.f = undefined; wide.g = undefined; wide.h = undefined; wide.i = undefined; wide.j = undefined;
  wide.k = undefined; wide.l = undefined; wide.m = undefined; wide.n = undefined; wide.o = undefined; wide.p = undefined; wide.q = undefined; wide.r = undefined; wide.s = undefined; wide.t = undefined;
}
function clearLast(wide: Wide) { wide.t = undefined; }
function clearSome(wide: Wide) { wide.c = undefined; wide.j = undefined; wide.q = undefined; wide.s = undefined; }
function fillSome(wide: Wide, seed: number) { wide.b = seed; wide.j = "j" + seed; wide.q = seed + 0.5; wide.s = "s"; }
function fillAll(wide: Wide, seed: number) {
  wide.a = "a"; wide.b = seed; wide.c = {}; wide.d = ["d"]; wide.e = true; wide.f = wide; wide.g = "g"; wide.h = seed + 1; wide.i = {}; wide.j = "j";
  wide.k = seed + 2; wide.l = false; wide.m = "m"; wide.n = seed + 3; wide.o = {}; wide.p = "p"; wide.q = seed + 4; wide.r = wide; wide.s = "s"; wide.t = seed + 5;
}
const seed = given<number>("3");

const fresh = new Wide(1, "fresh"); console.log(show(fresh));
clearAll(fresh); clearLast(fresh); clearSome(fresh); console.log(show(fresh));

const partly = new Wide(2, "partly"); fillSome(partly, seed); console.log(show(partly));
clearSome(partly); console.log(show(partly)); fillSome(partly, seed + 1); clearLast(partly); console.log(show(partly)); clearAll(partly); console.log(show(partly));

const full = new Wide(3, "full"); fillAll(full, seed); console.log(show(full));
clearLast(full); console.log(show(full)); clearSome(full); console.log(show(full)); clearAll(full); console.log(show(full)); fillAll(full, seed); console.log(show(full));

// One field at a time: filled, cleared, filled again.
for (const letter of letters) {
  const one = new Wide(4, letter) as unknown as Record<string, unknown>;
  one[letter] = letter; const filled = show(one as unknown as Wide);
  clearAll(one as unknown as Wide); const cleared = show(one as unknown as Wide);
  one[letter] = 7; console.log(filled, cleared, show(one as unknown as Wide), letter in one, Object.hasOwn(one, letter));
}

// Literals that name only some of the fields, and get the others as undefined later.
interface Options { id: number; a?: string; b?: number; c?: object; d?: string; e?: number; f?: string; g?: number; h?: string; i?: number; j?: string; k?: number; l?: string; m?: number; n?: string; o?: number; p?: string }
function blank(options: Options) { options.k = undefined; options.l = undefined; options.m = undefined; options.n = undefined; options.o = undefined; options.p = undefined; }
function list(options: Options): string { return Object.entries(options).map(([key, value]) => key + "=" + value).join(); }
const small: Options = { id: 1 }; blank(small); console.log(list(small));
const medium: Options = { id: 2, a: "a", l: "l", p: "p" }; blank(medium); console.log(list(medium));
const large: Options = { id: 3, a: "a", b: 1, c: {}, d: "d", e: 2, f: "f", g: 3, h: "h", i: 4, j: "j", k: 5, l: "l", m: 6, n: "n", o: 7, p: "p" }; blank(large); console.log(list(large));

// Many, with collections in between.
const kept: Wide[] = [];
for (let i = 0; i < 6000; i++) { const wide = new Wide(i, "w"); if (i % 3 === 0) fillSome(wide, i); if (i % 5 === 0) fillAll(wide, i); if (i % 7 === 0) clearSome(wide); if (i % 11 === 0) clearAll(wide); if (i % 13 === 0) kept.push(wide); if (i % 2000 === 0) Bun.gc(true); }
let sum = 0; for (const wide of kept) sum += show(wide).length + (wide.q ?? 0) + (wide.t ?? 0);
console.log(kept.length, sum, show(kept[5]), show(kept[15]), show(kept[kept.length - 1]));
