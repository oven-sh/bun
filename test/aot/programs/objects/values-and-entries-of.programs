//// weak-collections-untyped.js
// `WeakMap.prototype.get`, `WeakMap.prototype.has` and `WeakSet.prototype.has` are inlined and answer as the built-in functions do (the same program without type annotations).
////= lines-20	getOf	map	map.get
////= lines-20	hasOf	map	map.has
////= lines-20	inSet	set	set.has
////= lines-20	getOfAnything	map	map.get
////= lines-20	hasAnything	map	map.has
////= lines-20	anythingInSet	set	set.has
const collect = globalThis.gc ?? (() => globalThis.Bun.gc(true));
function aroundACollection(map, key) {
  const before = map.get(key);
  collect();
  const behind = map.get(key);
  return before === behind && behind !== undefined;
}
const table = { getOf, hasOf, inSet, getOfAnything, hasAnything, anythingInSet, aroundACollection };
const call = (name, ...given) => table[name](...given);
const empty = new WeakMap;
const emptySet = new WeakSet;
const one = {};
console.log("empty:", call("getOf", empty, one), call("hasOf", empty, one), call("inSet", emptySet, one));
const map = new WeakMap;
const set = new WeakSet;
const keys = [];
const others = [];
for (let i = 0;i < 1000; i++) {
  const key = i % 3 ? { i } : i % 2 ? [i] : () => i;
  keys.push(key);
  map.set(key, i);
  set.add(key);
  others.push({ i });
}
let sum = 0;
let had = 0;
let within = 0;
let strangers = 0;
for (const key of keys) {
  sum += call("getOf", map, key);
  had += call("hasOf", map, key) ? 1 : 0;
  within += call("inSet", set, key) ? 1 : 0;
}
for (const key of others)
  strangers += (call("getOf", map, key) === undefined ? 0 : 1) + (call("hasOf", map, key) ? 1 : 0) + (call("inSet", set, key) ? 1 : 0);
console.log("a thousand keys:", sum, had, within, "strangers found:", strangers);
for (let i = 0;i < 1000; i += 2) {
  map.delete(keys[i]);
  set.delete(keys[i]);
}
sum = 0;
had = 0;
within = 0;
for (const key of keys) {
  sum += call("getOf", map, key) ?? 0;
  had += call("hasOf", map, key) ? 1 : 0;
  within += call("inSet", set, key) ? 1 : 0;
}
console.log("half of them deleted:", sum, had, within);
for (let i = 0;i < 1000; i += 2) {
  map.set(keys[i], -i);
  set.add(keys[i]);
}
sum = 0;
for (const key of keys)
  sum += call("getOf", map, key);
console.log("and put back:", sum);
const local = Symbol("local");
map.set(local, 77);
set.add(local);
for (const key of [1, 1.5, "text", "", null, undefined, true, 10n, Symbol.for("registered"), Symbol.iterator, local, NaN])
  console.log("a key that is", typeof key === "symbol" ? String(key) : typeof key + " " + String(key), call("getOfAnything", map, key), call("hasAnything", map, key), call("anythingInSet", set, key));
map.set(one, undefined);
console.log("undefined for a value:", call("getOf", map, one), call("hasOf", map, one));

class Answering extends WeakMap {
  get(key) {
    return 42;
  }
  has(key) {
    return false;
  }
}

class Plain extends WeakMap {
}
const answering = new Answering;
const plain = new Plain;
const altered = new WeakMap;
answering.set(one, 1);
plain.set(one, 2);
altered.set(one, 3);
altered.get = () => 7;
console.log("a class that answers itself:", call("getOf", answering, one), call("hasOf", answering, one), "\xB7 one that does not:", call("getOf", plain, one), call("hasOf", plain, one), "\xB7 a get of its own:", call("getOf", altered, one), call("hasOf", altered, one));
for (const wrong of [new Map, new WeakSet, {}, 1]) {
  try {
    console.log(WeakMap.prototype.get.call(wrong, one));
  } catch (error) {
    console.log("on what is no WeakMap:", error.constructor.name);
  }
}
const kept = [];
const crowded = new WeakMap;
for (let i = 0;i < 100; i++) {
  const key = { i };
  kept.push(key);
  crowded.set(key, i);
}
for (let round = 0;round < 4; round++) {
  for (let i = 0;i < 20000; i++)
    crowded.set({ i }, i);
  let held = 0;
  for (const key of kept)
    held += call("aroundACollection", crowded, key) ? 1 : 0;
  console.log("round", round, "kept keys found before and behind a collection:", held);
}
//// well-known-symbol-keys.ts
// Well-known symbols as the constant key of in, delete, reads, stores, accessors and literals that spread afterwards, in code that runs once and in loops. A property named like the description of a symbol is another property.
type Bag = Record<PropertyKey, unknown>;

class Tagged {
  [Symbol.toStringTag] = "Tagged";
  size = 1;
}

class Ranged {
  limit: number;
  constructor(limit: number) {
    this.limit = limit;
  }
  *[Symbol.iterator](): Generator<number> {
    for (let i = 0; i < this.limit; i++) yield i;
  }
  get [Symbol.toStringTag](): string {
    return "Ranged" + this.limit;
  }
  static [Symbol.hasInstance](value: unknown): boolean {
    return typeof value === "number";
  }
}

const trapped: string[] = [];
const proxy = new Proxy({}, {
  has(target: object, key: PropertyKey): boolean {
    trapped.push("has " + String(key));
    return key === Symbol.iterator;
  },
  deleteProperty(target: object, key: PropertyKey): boolean {
    trapped.push("delete " + String(key));
    return true;
  },
});

const subjects: [string, object][] = [
  ["array", []],
  ["map", new Map()],
  ["date", new Date(0)],
  ["plain", {}],
  ["no prototype", Object.create(null)],
  ["text names", { iterator: 1, toStringTag: 2, "Symbol.iterator": 3, "Symbol(Symbol.iterator)": 4 }],
  ["field", new Tagged()],
  ["methods", new Ranged(2)],
  ["class", Ranged],
  ["function", function () {}],
  ["proxy", proxy],
];

const show = (bag: object): string => Reflect.ownKeys(bag).map(key => String(key) + "=" + String((bag as Bag)[key])).join(" ");

function attempt(run: () => string): string {
  try {
    return run();
  } catch (error) {
    return (error as Error).name;
  }
}

function membership(value: object): string {
  return [Symbol.iterator in value, Symbol.asyncIterator in value, Symbol.toStringTag in value, Symbol.hasInstance in value, Symbol.toPrimitive in value].map(Number).join("");
}

function fieldMembership(value: Tagged): string {
  return [Symbol.toStringTag in value, Symbol.iterator in value, "toStringTag" in value, "size" in value].map(Number).join("");
}

console.log("once", Symbol.iterator in subjects[0][1], Symbol.toStringTag in subjects[6][1], Symbol.iterator in subjects[5][1], Symbol.hasInstance in Ranged);
for (const [name, value] of subjects) console.log(name, membership(value));
console.log(trapped.join(", "));
console.log("field", fieldMembership(new Tagged()));

function countInLoop(values: object[], rounds: number): number {
  let count = 0;
  for (let i = 0; i < rounds; i++) {
    const value = values[i % values.length];
    if (Symbol.iterator in value) count += 1;
    if (Symbol.toStringTag in value) count += 100;
    if (Symbol.iterator in value) count += 10000;
  }
  return count;
}
const withoutProxy = subjects.filter(([name]) => name !== "proxy").map(([, value]) => value);
console.log("in a loop", countInLoop(withoutProxy, 20000), countInLoop([new Tagged()], 3), countInLoop([{ iterator: 1 }], 3));

function literalThenSpread(rest: object): Bag {
  return { [Symbol.iterator]: "first", [Symbol.toStringTag]: "tag", plain: 1, ...rest };
}
for (let i = 0; i < 3; i++) {
  console.log("spread", show(literalThenSpread({})), "|", show(literalThenSpread({ [Symbol.iterator]: "second", other: i })), "|", show(literalThenSpread(new Tagged())), "|", show(literalThenSpread([i])));
}

function remove(bag: Bag): string {
  const before = Symbol.toStringTag in bag;
  const removed = delete bag[Symbol.toStringTag];
  return [before, removed, Symbol.toStringTag in bag, "toStringTag" in bag, show(bag)].join(" ");
}
for (let i = 0; i < 3; i++) {
  console.log("delete", remove({ [Symbol.toStringTag]: "x", toStringTag: "text" }), "|", remove({ toStringTag: i }), "|", remove(new Tagged() as unknown as Bag), "|", attempt(() => remove(Object.freeze({ [Symbol.toStringTag]: "frozen" }) as Bag)));
}
trapped.length = 0;
console.log("delete", remove(proxy as Bag), trapped.join(", "));

function withAccessors(start: number) {
  let current = start;
  return {
    get [Symbol.toStringTag](): string {
      return "tag" + current;
    },
    set [Symbol.toStringTag](value: string) {
      current = value.length;
    },
    get [Symbol.toPrimitive]() {
      return () => current;
    },
    plain: start,
  };
}
for (let i = 0; i < 3; i++) {
  const object = withAccessors(i);
  const first = Object.prototype.toString.call(object) + " " + Number(object) + " " + `${object}`;
  object[Symbol.toStringTag] = "four";
  const descriptor = Object.getOwnPropertyDescriptor(object, Symbol.toStringTag)!;
  console.log("accessors", first, Object.prototype.toString.call(object), Number(object), typeof descriptor.get, typeof descriptor.set, descriptor.enumerable, descriptor.configurable, Reflect.ownKeys(object).map(String).join());
}

function readThenStore(bag: Bag, value: unknown): string {
  const before = bag[Symbol.unscopables];
  bag[Symbol.unscopables] = value;
  return String(before) + ">" + String(bag[Symbol.unscopables]) + " " + String(bag["unscopables"]);
}
for (let i = 0; i < 3; i++) {
  const bag: Bag = { unscopables: "text" };
  console.log("stores", readThenStore(bag, i), readThenStore(bag, "again"), show(bag));
  try {
    console.log("an array", readThenStore([] as unknown as Bag, i));
  } catch (error) {
    console.log("an array", (error as Error).name);
  }
}

Bun.gc(true);
console.log("after a collection", subjects.map(([, value]) => membership(value)).join(" "), show(literalThenSpread({ last: true })), countInLoop(withoutProxy, 1000));
//// what-the-first-call-of-object-create-is-handed.js
// Each function has one call of Object.create. The first object that the call is handed is a literal, null, a proxy, a function, an array, the prototype object of a class, of a constructor
// function or of a built-in class, an object that Object.create made, a frozen literal, or no object at all; later calls are handed the others.
const log = [];
class Shape { area() { return "area of " + this.name; } get name2() { return this.name + "!"; } }
function Old() {}
Old.prototype.area = function () { return "old area of " + this.name; };
const literal = { area() { return "literal area of " + this.name; }, get name2() { return this.name + "?"; } };
const handed = {
  literal: () => literal,
  nothing: () => null,
  proxy: () => new Proxy(literal, { get(target, key, receiver) { return key === "area" ? () => "trapped" : Reflect.get(target, key, receiver); }, set(target, key, value, receiver) { log.push("set trap " + String(key)); return Reflect.set(target, key, value, receiver); } }),
  function: () => function named() {},
  array: () => [1, 2, 3],
  classPrototype: () => Shape.prototype,
  oldPrototype: () => Old.prototype,
  builtinPrototype: () => Map.prototype,
  created: () => Object.create(literal),
  frozen: () => Object.freeze({ area() { return "frozen area"; }, name: "frozen name" }),
  number: () => 7,
  undefined: () => undefined,
  string: () => "text",
};
const makers = [
  above => { const made = Object.create(above); made.name = "a"; made.extra = 1; return made; },
  above => { const made = Object.create(above); made.name = "b"; made.extra = 2; return made; },
  above => { const made = Object.create(above); made.name = "c"; made.extra = 3; return made; },
  above => { const made = Object.create(above); made.name = "d"; made.extra = 4; return made; },
  above => { const made = Object.create(above); made.name = "e"; made.extra = 5; return made; },
  above => { const made = Object.create(above); made.name = "f"; made.extra = 6; return made; },
  above => { const made = Object.create(above); made.name = "g"; made.extra = 7; return made; },
  above => { const made = Object.create(above); made.name = "h"; made.extra = 8; return made; },
  above => { const made = Object.create(above); made.name = "i"; made.extra = 9; return made; },
  above => { const made = Object.create(above); made.name = "j"; made.extra = 10; return made; },
  above => { const made = Object.create(above); made.name = "k"; made.extra = 11; return made; },
  above => { const made = Object.create(above); made.name = "l"; made.extra = 12; return made; },
  above => { const made = Object.create(above); made.name = "m"; made.extra = 13; return made; },
];
function look(made) {
  let answer = typeof made.area === "function" ? made.area() : String(made.area);
  answer += " | " + made.name + " | " + made.name2 + " | " + made.extra + " | " + made.length + " | " + Object.keys(made).join();
  answer += " | " + (Object.getPrototypeOf(made) === null ? "null" : typeof Object.getPrototypeOf(made)) + " | " + (made instanceof Shape) + (made instanceof Old) + " | " + typeof made.toString;
  return answer;
}
const names = Object.keys(handed);
makers.forEach((make, first) => {
  for (let step = 0; step < names.length * 2; step++) {
    const name = names[(first + step) % names.length];
    try {
      const above = handed[name]();
      const made = make(above);
      log.push(first + " " + name + ": " + look(made) + " | " + (Object.getPrototypeOf(made) === above));
    } catch (error) {
      log.push(first + " " + name + ": " + error.constructor.name + ": " + error.message);
    }
  }
});
console.log(log.join("\n"));
//// word-count-by-key.ts
// Keys cut out of a text: read and then stored under, asked for with `in` and then stored under, once and again, by fresh strings and by strings that are kept.
const text = "the quick brown fox jumps over the lazy dog and the quick cat sleeps while the dog barks at the fox";
const lines: string[] = [];
function words(): string[] { return text.split(" "); }
function count(list: string[]): Record<string, number> {
    const counts: Record<string, number> = {};
    for (const word of list) counts[word] = (counts[word] ?? 0) + 1;
    return counts;
}
function show(record: Record<string, unknown>): string {
    return Object.keys(record).map(key => key + ":" + String(record[key])).join(" ");
}
lines.push("counted: " + show(count(words())));
lines.push("again: " + show(count(words())));
const kept = words();
lines.push("by kept strings: " + show(count(kept)) + " | " + show(count(kept)) + " | " + show(count(kept)));
const groups: Record<string, string[]> = {};
for (const word of words()) {
    const key = word.slice(0, 1);
    if (!(key in groups)) groups[key] = [];
    groups[key]!.push(word);
}
lines.push("grouped: " + Object.keys(groups).map(key => key + "=" + groups[key]!.length).join(" "));
const first: Record<string, number> = {};
words().forEach((word, index) => { first[word] ??= index; });
lines.push("first seen: " + show(first));
const lengths: Record<string, number> = {};
for (let round = 0; round < 3; round++) {
    for (const word of kept) {
        const before = lengths[word];
        lengths[word] = before === undefined ? word.length : before + 1;
    }
}
lines.push("three rounds: " + show(lengths));
const two: Record<string, number> = {};
const other: Record<string, number> = {};
for (const word of words()) {
    const seen = two[word];
    other[word] = (seen ?? 0) + 1;
    two[word] = (other[word] ?? 0) + 1;
}
lines.push("two tables: " + show(two) + " | " + show(other));
let total = 0;
const big: Record<string, number> = {};
for (let turn = 0; turn < 3000; turn++) {
    const key = "k" + (turn % 700);
    big[key] = (big[key] ?? 0) + turn;
    total += big[key]!;
}
lines.push("many: " + total + " " + Object.keys(big).length);
console.log(lines.join("\n"));
