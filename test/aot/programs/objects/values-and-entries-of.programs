  belowTop: () => Object.defineProperty(Object.assign(Object.create(top), { own: "own" }), "hidden", { value: "own hidden", writable: true, enumerable: true, configurable: true }),
  plain: () => JSON.parse('{"own":"own"}'),
  instance: () => new Derived(),
