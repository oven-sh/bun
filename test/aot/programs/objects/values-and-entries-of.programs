//// warm-reads-then-arrays-and-strings-change.js
"use strict";
// Strings, arrays, regular expressions, numbers and booleans as receivers of reads by name, at sites that see them all, 200 times over; then the arrays and what is above them change.
const unknown = String(process.argv.length > 99 ? process.argv[99] : "");
class List extends Array {
  first() {
    return this[0];
  }
  get size() {
    return this.length;
  }
}
const otherPrototype = { map: "otherPrototype.map", marker: "otherPrototype.marker", 1: "otherPrototype[1]" };
const makers = {
  text: () => "text" + unknown,
  emptyText: () => "" + unknown,
  rope: () => "a long piece of text, " + unknown + "joined to another long piece of text",
  wrappedText: () => new String("wrapped"),
  integers: () => [1, 2, 3],
  doubles: () => [1.5, 2.5],
  objects: () => [{}, "x", null],
  empty: () => [],
  holes: () => [1, , 3],
  matched: () => /(?<word>b+)/.exec("abbbc"),
  list: () => List.from([7, 8]),
  pattern: () => /x+/g,
  integer: () => 7,
  double: () => 7.25,
  truth: () => true,
  plain: () => ({ length: "own length", 0: "plain[0]" }),
};
const readers = {
  length: o => o.length,
  slice: o => o.slice,
  indexOf: o => o.indexOf,
  map: o => o.map,
  push: o => o.push,
  at: o => o.at,
  index: o => o.index,
  input: o => o.input,
  groups: o => o.groups,
  first: o => o.first,
  size: o => o.size,
  lastIndex: o => o.lastIndex,
  source: o => o.source,
  global: o => o.global,
  toFixed: o => o.toFixed,
  valueOf: o => o.valueOf,
  toString: o => o.toString,
  constructor: o => o.constructor,
  then: o => o.then,
  marker: o => o.marker,
  extra: o => o.extra,
  zero: o => o[0],
  zeroAsText: o => o["0"],
  oneAsText: o => o["1"],
  sliced: o => (typeof o.slice === "function" ? o.slice(0, 2) : "no slice"),
};
const show = value => (typeof value === "function" ? "function " + value.name : typeof value === "object" && value !== null ? JSON.stringify(value) : String(value));
const makeAll = () => Object.entries(makers).map(([kind, make]) => [kind, make()]);
////= readAll
const attempt = change => {
  try {
    change();
    return "done";
  } catch (error) {
    return error.constructor.name;
  }
};
const arraysOf = receivers => receivers.map(([, receiver]) => receiver).filter(Array.isArray);

const receivers = makeAll();
const warm = readAll(receivers);
////= for-2
console.log(warm);

const steps = [
  ["the arrays get a property of their own", () => { for (const array of arraysOf(receivers)) array.extra = "own extra"; }],
  ["a property of their own hides a method", () => { for (const array of arraysOf(receivers)) { array.map = "own map"; array.then = "own then"; } }],
  ["they grow and shrink", () => { for (const array of arraysOf(receivers)) { for (let i = 0; i < 100; i++) array.push(i); array.length = 2; } }],
  ["they hold other kinds of elements", () => { for (const array of arraysOf(receivers)) { array[0] = "a string"; array[1] = 2.5; } }],
  ["an element far away", () => { for (const array of arraysOf(receivers)) array[100000] = "far"; }],
  ["the properties are deleted", () => { for (const array of arraysOf(receivers)) { delete array.map; delete array.then; delete array.extra; array.length = 3; } }],
  ["the class above a list gets and loses members", () => { List.prototype.marker = "List.marker"; delete List.prototype.first; Object.defineProperty(List.prototype, "size", { value: "a value now", configurable: true }); }],
  ["the arrays stand below another object", () => { for (const array of arraysOf(receivers)) Object.setPrototypeOf(array, otherPrototype); }],
  ["that object changes", () => { otherPrototype.map = "changed"; otherPrototype.extra = "otherPrototype.extra"; delete otherPrototype.marker; }],
  ["below Array.prototype again, frozen", () => { for (const array of arraysOf(receivers)) Object.freeze(Object.setPrototypeOf(array, Array.prototype)); }],
  ["the expression has matched", () => { for (const [, receiver] of receivers) if (receiver instanceof RegExp) receiver.test("axxb"); }],
  ["the wrapped text gets a property", () => { for (const [, receiver] of receivers) if (receiver instanceof String) receiver.extra = "extra of the wrapper"; }],
];
for (const [what, change] of steps) {
  console.log("\n--- " + what + ": " + attempt(change));
  for (let round = 0; round < 40; round++) {
    const now = readAll(receivers);
    const fresh = readAll(makeAll());
    if (round === 0 || round === 39) console.log(now + "\n- new ones\n" + fresh);
  }
}
//// warm-reads-then-fields-of-literals-above-are-stored.js
"use strict";
// Objects below literals: what they inherit lies in fields of compiled objects. Warm reads by name at sites that see many receivers; then the fields above are stored to by compiled code,
// with values of the same kind and of other kinds, emptied and filled again; behind each step the same reads.
const unknown = String(process.argv.length > 99 ? process.argv[99] : "");
let getterCalls = 0;
const top = {
  count: 1,
  ratio: 1.5,
  flag: true,
  text: "top text",
  list: [1, 2],
  child: { inner: "inner of top" },
  nothing: null,
  missing: undefined,
  method() {
    return "top.method of " + this.own;
  },
  arrow: () => "top.arrow",
  get computed() {
    getterCalls++;
    return "computed for " + this.own;
  },
};
const middle = Object.setPrototypeOf({ count: 10, middleText: "middle text", later: undefined }, top);
const makers = {
  parsed: () => Object.setPrototypeOf(JSON.parse('{"own":"parsed"}'), middle),
  created: () => Object.assign(Object.create(middle), { own: "created" }),
  belowTop: () => Object.assign(Object.create(top), { own: "belowTop" }),
  literal: () => Object.setPrototypeOf({ own: "literal", flag: false }, middle),
  literalWithMore: () => Object.assign(Object.setPrototypeOf({ own: "literalWithMore" }, top), { ["more" + unknown]: 1 }),
};
const readers = {
  own: o => o.own,
  count: o => o.count,
  ratio: o => o.ratio,
  flag: o => o.flag,
  text: o => o.text,
  list: o => o.list,
  child: o => o.child,
  inner: o => o.child?.inner,
  nothing: o => o.nothing,
  missing: o => o.missing,
  method: o => (typeof o.method === "function" ? o.method() : o.method),
  arrow: o => (typeof o.arrow === "function" ? o.arrow() : o.arrow),
  computed: o => o.computed,
  middleText: o => o.middleText,
  later: o => o.later,
};
const show = value => (typeof value === "object" && value !== null ? JSON.stringify(value) : String(value));
const makeAll = () => Object.entries(makers).map(([kind, make]) => [kind, make()]);
////= readAll

const receivers = makeAll();
const warm = readAll(receivers);
////= for-2
console.log(warm);

const steps = [
  ["values of the same kind", () => { top.count = 2; top.ratio = 2.5; top.flag = false; top.text = "second text"; top.list = [3]; top.child = { inner: "second inner" }; middle.count = 20; middle.middleText = "second middle text"; }],
  ["stored in a loop, read in between", () => { for (let i = 0; i < 300; i++) { top.count = i; top.text = "text " + (i & 3); for (const [, receiver] of receivers) if (readers.text(receiver) !== "text " + (i & 3)) throw new Error("stale text at " + i); if (readers.count(receivers[2][1]) !== i) throw new Error("stale count at " + i); } }],
  ["values of other kinds", () => { top.count = "a string now"; top.ratio = 7; top.flag = "yes"; top.text = 42; top.list = null; top.child = 1.25; top.nothing = { no: "longer nothing" }; top.missing = 0; }],
  ["undefined and null", () => { top.count = undefined; top.ratio = null; top.flag = undefined; top.text = null; top.child = undefined; middle.count = undefined; }],
  ["a field that was undefined is filled", () => { middle.later = "later is here"; top.missing = "no longer missing"; }],
  ["methods are replaced", () => { top.method = function second() { return "second method of " + this.own; }; top.arrow = "no function any more"; }],
  ["fields are deleted", () => { delete top.text; delete top.child; delete middle.count; delete middle.later; }],
  ["and stored again", () => { top.text = "text again"; top.child = { inner: "inner again" }; middle.count = 30; middle.later = "later again"; }],
  ["the getter becomes a value, a value a getter", () => { Object.defineProperty(top, "computed", { value: "a plain value", writable: true, configurable: true, enumerable: true }); Object.defineProperty(top, "ratio", { get() { return "ratio for " + this.own; }, configurable: true, enumerable: true }); }],
];
////= for
console.log("the getter ran", getterCalls, "times");
//// warm-reads-then-functions-change.js
"use strict";
// Functions of every kind as receivers of reads by name, at sites that see them all, 200 times over; then they get, hide and lose properties, and stand below other objects.
const unknown = String(process.argv.length > 99 ? process.argv[99] : "");
function declared(a, b) {
  return a + b;
}
class Plain {
  method(a) {
    return a;
  }
}
class WithStatics {
  static call = "a static field named call";
  static tag = "a static tag";
  static toString() {
    return "a static toString";
  }
  static get listener() {
    return "a static getter";
  }
  static bind(a, b, c) {
    return "a static method named bind";
  }
}
class Heir extends WithStatics {
  static own = "own of the heir";
}
const otherPrototype = { call: "otherPrototype.call", marker: "otherPrototype.marker" };
const makers = {
  arrow: () => (a, b, c) => a,
  capturing: () => {
    const captured = unknown;
    return () => captured;
  },
  declared: () => declared,
  expression: () => function named(a) {},
  anonymous: () => (0, function () {}),
  method: () => new Plain().method,
  shorthand: () => ({ short(a, b) {} }).short,
  getter: () => Object.getOwnPropertyDescriptor({ get got() { return 1; } }, "got").get,
  asynchronous: () => async function later(a) {},
  generator: () => function* many(a, b) {},
  bound: () => declared.bind(null, 1),
  boundTwice: () => declared.bind(null).bind(null, 1, 2),
  plainClass: () => Plain,
  classWithStatics: () => WithStatics,
  heir: () => Heir,
  freshClass: () => class Fresh { static call = "call of a fresh class"; },
  host: () => Math.max,
  hostMethod: () => [].push,
  constructorOfHost: () => Map,
  fromText: () => new Function("a", "b", "return a" + unknown),
  withProperties: () => Object.assign(function decorated() {}, { tag: "own tag", listener: "own listener" }),
};
const readers = {
  name: o => o.name,
  length: o => o.length,
  prototype: o => typeof o.prototype,
  prototypeIsKept: o => o.prototype === o.prototype,
  call: o => o.call,
  apply: o => o.apply,
  bind: o => o.bind,
  toString: o => o.toString,
  constructor: o => o.constructor,
  hasInstance: o => o[Symbol.hasInstance],
  tag: o => o.tag,
  listener: o => o.listener,
  own: o => o.own,
  marker: o => o.marker,
  then: o => o.then,
  displayName: o => o.displayName,
};
const show = value => (typeof value === "function" ? "function " + value.name : String(value));
const makeAll = () => Object.entries(makers).map(([kind, make]) => [kind, make()]);
////= readAll
const outcomes = [];
const attemptOnEach = (receivers, change) => {
  const failed = [];
  for (const [kind, receiver] of receivers) {
    try {
      change(receiver);
    } catch (error) {
      failed.push(kind + " " + error.constructor.name);
    }
  }
  return failed.length ? failed.join(", ") : "done";
};
// What is shared by every round stays as it is: the steps change functions made for them alone.
const isFresh = kind => !["declared", "plainClass", "classWithStatics", "heir", "host", "hostMethod", "constructorOfHost"].includes(kind);

const receivers = makeAll();
const warm = readAll(receivers);
////= for-2
console.log(warm);

const fresh = receivers.filter(([kind]) => isFresh(kind));
const steps = [
  ["they get a property", () => attemptOnEach(fresh, f => { f.tag = "tag stored"; })],
  ["a property of their own hides what Function.prototype has", () => attemptOnEach(fresh, f => { f.call = "own call"; f.then = "own then"; })],
  ["the name and the length are defined anew", () => attemptOnEach(fresh, f => { Object.defineProperty(f, "name", { value: "renamed" }); Object.defineProperty(f, "length", { value: 99 }); })],
  ["the name and the length are deleted", () => attemptOnEach(fresh, f => { delete f.name; delete f.length; })],
  ["the prototype property is stored", () => attemptOnEach(fresh, f => { f.prototype = { stored: true }; })],
  ["the properties are deleted", () => attemptOnEach(fresh, f => { delete f.tag; delete f.call; delete f.then; })],
  ["they stand below another object", () => attemptOnEach(fresh, f => { Object.setPrototypeOf(f, otherPrototype); })],
  ["that object changes", () => { otherPrototype.call = "changed"; otherPrototype.tag = "otherPrototype.tag"; delete otherPrototype.marker; return "done"; }],
  ["below Function.prototype again, frozen", () => attemptOnEach(fresh, f => { Object.freeze(Object.setPrototypeOf(f, Function.prototype)); })],
  ["the statics of a class change", () => { WithStatics.tag = "tag changed"; delete WithStatics.call; WithStatics.marker = "a new static"; Object.defineProperty(WithStatics, "listener", { value: "a value now", configurable: true }); return "done"; }],
  ["the heir hides and gets statics", () => { Heir.tag = "tag of the heir"; Heir.call = "call of the heir"; delete Heir.own; return "done"; }],
  ["the heir stands below another class", () => { Object.setPrototypeOf(Heir, Plain); return "done"; }],
];
for (const [what, change] of steps) {
  console.log("\n--- " + what + ": " + change());
  for (let round = 0; round < 40; round++) {
    const now = readAll(receivers);
    const again = readAll(makeAll());
    if (round === 0 || round === 39) console.log(now + "\n- new ones\n" + again);
  }
}
//// warm-reads-then-the-collector-runs-between.js
"use strict";
// Reads by name of many kinds of receivers at sites that see them all, 200 times over; then objects above them change while the collector runs in between; then the same reads again, of the same objects and of new ones.
const unknown = String(process.argv.length > 99 ? process.argv[99] : "");
////= Base-2
Old.prototype.method = function oldMethod() {};
Old.prototype.value = "Old.value";
const top = { value: "top.value", hidden: "top.hidden", method: function topMethod() {} };
const middle = Object.setPrototypeOf({ hidden: "middle.hidden", middleOnly: "middle.only" }, top);
const otherTop = { value: "otherTop.value", added: "otherTop.added" };
////= makers-2
const show = value => (typeof value === "function" ? "function " + value.name : String(value));
const makeAll = () => Object.entries(makers).map(([kind, make]) => [kind, make()]);
////= readAll

const receivers = makeAll();
const warm = readAll(receivers);
////= for-2
console.log(warm);

