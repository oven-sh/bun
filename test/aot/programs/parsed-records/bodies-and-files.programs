//// members-that-the-objects-the-program-makes-never-have.ts
// Texts that hold members which the program's own objects of that shape never have.
type Row = { id: number; name: string };
type Nested = { row: Row; rows: Row[]; tag?: string };
const made: Row = { id: 1, name: "made" };
const nest: Nested = { row: made, rows: [made, { id: 2, name: "two" }] };
const out: string[] = [];
function show(label: string, value: unknown) {
  out.push(label + " " + JSON.stringify(value) + " " + (value && typeof value === "object" ? Object.keys(value as object).join() : ""));
}
function row(text: string): Row { return JSON.parse(text) as Row; }
function nested(text: string): Nested { return JSON.parse(text) as Nested; }
function use(r: Row): string { return r.id + ":" + r.name + ":" + ("ok" in r) + ":" + Object.keys(r).length; }
////= texts
for (let round = 0; round < 60; round++) {
  out.length = 0;
  for (const text of texts) { const r = row(text); show(text, r); out.push(use(r)); }
  show("made", made); out.push(use(made));
  for (const text of [
    '{"row":{"id":1,"name":"a","x":1},"rows":[{"id":2,"name":"b"},{"id":3,"name":"c","y":2},{"z":0,"id":4,"name":"d"}]}',
    '{"row":{"id":1,"name":"a"},"rows":[],"tag":"t","more":{"row":{"id":9,"name":"deep","w":1}}}',
    '{"more":1,"row":{"id":1,"name":"a"},"rows":[{"id":2,"name":"b"}]}',
  ]) { const n = nested(text); show(text, n); out.push(use(n.row) + "|" + n.rows.map(use).join("|") + "|" + n.tag); }
  for (const bad of ['{"id":7,"name":"row","ok":}', '{"id":7,"name":"row","ok":true', '{"id":7,"name":"row",}', '{"id":7,"name":"row" "ok":1}', '{"id":7,"ok":tru,"name":"x"}']) {
    try { show(bad, row(bad)); } catch (e) { out.push(bad + " " + (e as Error).name); }
  }
  const revived = JSON.parse('{"id":7,"name":"row","ok":true}', (k, v) => (k === "ok" ? undefined : v)) as Row;
  show("revived", revived);
  const written = row('{"id":7,"name":"row","ok":true}'); written.id = 9; (written as any).later = 1; delete (written as any).ok; show("written", written);
}
show("nest", nest);
console.log(out.join("\n"));
//// members-that-the-objects-the-program-makes-never-have-in-untyped-code.js
// Texts that hold members which the program's own objects of that shape never have.


const made = { id: 1, name: "made" };
const nest = { row: made, rows: [made, { id: 2, name: "two" }] };
const out = [];
function show(label, value) {
  out.push(label + " " + JSON.stringify(value) + " " + (value && typeof value === "object" ? Object.keys(value).join() : ""));
}
function row(text) { return JSON.parse(text); }
function nested(text) { return JSON.parse(text); }
function use(r) { return r.id + ":" + r.name + ":" + ("ok" in r) + ":" + Object.keys(r).length; }
////= texts
for (let round = 0; round < 60; round++) {
  out.length = 0;
  for (const text of texts) { const r = row(text); show(text, r); out.push(use(r)); }
  show("made", made); out.push(use(made));
  for (const text of [
    '{"row":{"id":1,"name":"a","x":1},"rows":[{"id":2,"name":"b"},{"id":3,"name":"c","y":2},{"z":0,"id":4,"name":"d"}]}',
    '{"row":{"id":1,"name":"a"},"rows":[],"tag":"t","more":{"row":{"id":9,"name":"deep","w":1}}}',
    '{"more":1,"row":{"id":1,"name":"a"},"rows":[{"id":2,"name":"b"}]}',
  ]) { const n = nested(text); show(text, n); out.push(use(n.row) + "|" + n.rows.map(use).join("|") + "|" + n.tag); }
  for (const bad of ['{"id":7,"name":"row","ok":}', '{"id":7,"name":"row","ok":true', '{"id":7,"name":"row",}', '{"id":7,"name":"row" "ok":1}', '{"id":7,"ok":tru,"name":"x"}']) {
    try { show(bad, row(bad)); } catch (e) { out.push(bad + " " + e.name); }
  }
  const revived = JSON.parse('{"id":7,"name":"row","ok":true}', (k, v) => (k === "ok" ? undefined : v));
  show("revived", revived);
  const written = row('{"id":7,"name":"row","ok":true}'); written.id = 9; written.later = 1; delete written.ok; show("written", written);
}
show("nest", nest);
console.log(out.join("\n"));
//// nested-objects-and-arrays.ts
const leak = new Function("value", process.argv.length > 99 ? "" : "return value");
////= parse
interface Item { sku: string; quantity: number }
interface Customer { id: number; name: string }
interface Order { customer: Customer; items: Item[]; note?: string; history: Order[] }
function count(order: Order): number {
  let sum = order.customer.id;
  for (const item of order.items) sum += item.quantity * item.sku.length;
  for (const earlier of order.history) sum += count(earlier);
  return sum;
}
function names(order: Order): string {
  return [order.customer.name, ...order.items.map(item => item.sku), ...order.history.map(names)].join("/");
}
const made: Order = { customer: { id: 1, name: "a" }, items: [{ sku: "s", quantity: 2 }], history: [] };
leak(made);
console.log(count(made), names(made));
function text(depth: number): string {
  const items = Array.from({ length: depth + 1 }, (_, n) => `{"sku":"sku-${n}","quantity":${n + 1}}`).join();
  const history = depth ? `${text(depth - 1)},${text(depth - 1)}` : "";
  return `{"customer":{"id":${depth},"name":"c${depth}"},"items":[${items}],"history":[${history}]}`;
}
for (let round = 0; round < 3; round++) {
  for (let depth = 0; depth < 5; depth++) {
    const order = parse(text(depth));
    console.log(count(order), names(order).length, JSON.stringify(order) === text(depth));
  }
  const mixed = parse('[{"sku":"a","quantity":1},{"quantity":2,"sku":"b"},{"sku":"c"},{"sku":"d","quantity":4,"x":1},[{"sku":"e","quantity":5}],null,7,{"id":1,"name":"n"}]');
  console.log(JSON.stringify(mixed), mixed.map((value: any) => (value && typeof value === "object" ? Object.keys(value).join("+") : String(value))).join());
  const shared = parse('{"customer":{"id":1,"name":"x"},"items":[],"history":[]}');
  const other = parse('{"customer":{"id":1,"name":"x"},"items":[],"history":[]}');
  console.log(shared !== other, shared.customer !== other.customer, shared.items !== other.items);
}
