//// booleans-nulls-and-values-that-do-not-fit-behind-them.ts
// JSON.parse makes records whose fields are booleans, numbers of every width and texts that may be null. A value that its field does not take, behind values that theirs have taken, gives the record up; collections run in between and find every cell whole.
const leak = new Function("value", process.argv.length > 99 ? "" : "return value");
function parse(text: string): any {
  return JSON.parse(text);
}
interface Row { id: number; on: boolean; off: boolean; maybe: boolean | null; name: string | null; count: number | null; ratio: number; inner: { deep: boolean }; tags: string[]; last: boolean }
function read(row: Row): string {
  return [row.id, row.on, row.off, row.maybe, row.name, row.count, row.ratio, JSON.stringify(row.inner), JSON.stringify(row.tags), row.last, typeof row.on, typeof row.maybe, row.on ? 1 : 0, row.off === false, row.maybe === null, Object.keys(row).join("")].join(" ");
}
leak({ id: 0, on: true, off: false, maybe: null, name: null, count: null, ratio: 0.5, inner: { deep: true }, tags: [], last: true } satisfies Row);
console.log(read({ id: 1, on: false, off: true, maybe: true, name: "n", count: 1, ratio: 1, inner: { deep: false }, tags: ["t"], last: false }));

const fitting: Record<string, string> = { id: "7", on: "true", off: "false", maybe: "null", name: '"n"', count: "3", ratio: "0.25", inner: '{"deep":true}', tags: '["a","b"]', last: "false" };
const odd = ["null", "true", "0", "1.5", '"text"', "[]", "{}", "[true]", '{"deep":1}', "-0", "1e400", "2147483648"];
const textWith = (changed: string, value: string) => `{${Object.keys(fitting).map(key => `"${key}":${key === changed ? value : fitting[key]}`).join(",")}}`;
const lines: string[] = [];
const kept: unknown[] = [];
for (let round = 0; round < 3; round++) {
  lines.push(read(parse(textWith("", ""))));
  for (const key of Object.keys(fitting)) {
    for (const value of odd) {
      const row = parse(textWith(key, value));
      kept.push(row);
      lines.push(`${key} ${value}: ${read(row)}`);
    }
    Bun.gc(true);
  }
  const many = parse(`[${Array.from({ length: 200 }, (_, index) => textWith(index % 7 === 3 ? "last" : index % 7 === 5 ? "off" : "id", index % 7 === 3 ? '"no"' : index % 7 === 5 ? "null" : String(index))).join(",")}]`) as Row[];
  Bun.gc(true);
  lines.push(many.map(row => `${row.id}${row.on}${row.off}${row.last}`).join("|"));
}
console.log(lines.join("\n"));
console.log(kept.length, JSON.stringify(kept[kept.length - 1]));
export {};
//// changes-after-the-parse.ts
const leak = new Function("value", process.argv.length > 99 ? "" : "return value");
////= parse
interface Config { host: string; port: number; secure?: boolean }
function url(config: Config): string {
  return `${config.secure ? "https" : "http"}://${config.host}:${config.port}`;
}
leak({ host: "", port: 0, secure: false } satisfies Config);
console.log(url({ host: "h", port: 1 }));
const text = '{"host":"example.com","port":8080,"secure":true}';
function parseText(): any {
  return parse(text);
}
function report(label: string, value: any) {
  let shown: string;
  try {
    shown = url(value);
  } catch (error) {
    shown = String(error);
  }
  console.log(label, shown, Object.keys(value).join(), JSON.stringify(value), JSON.stringify(Object.getOwnPropertyDescriptors(value)));
}
for (let round = 0; round < 3; round++) {
  let value = parseText();
  delete value.port;
  report("delete", value);
  value.port = 1;
  report("add again", value);
  value = parseText();
  value.extra = [1];
  value[5] = "five";
  value[Symbol.for("s")] = 1;
  report("add", value);
  console.log(Object.getOwnPropertySymbols(value).length, Reflect.ownKeys(value).length);
  value = parseText();
  value.port = "eighty";
  value.host = 5;
  value.secure = null;
  report("other types", value);
  value = parseText();
  Object.defineProperty(value, "port", { get: () => 99, enumerable: false, configurable: true });
  report("getter", value);
  value = parseText();
  Object.defineProperty(value, "host", { value: "fixed", writable: false });
  try {
    "use strict";
    value.host = "changed";
  } catch (error) {
    console.log((error as Error).constructor.name);
  }
  report("read-only", value);
  value = parseText();
  Object.freeze(value);
  console.log(Object.isFrozen(value), Object.isSealed(value), Object.isExtensible(value));
  try {
    value.port = 2;
  } catch (error) {
    console.log((error as Error).constructor.name);
  }
  report("frozen", value);
  value = parseText();
  Object.setPrototypeOf(value, { inherited: 1, get port2() { return (this as any).port + 1; } });
  console.log(value.inherited, value.port2, value instanceof Object);
  report("prototype", value);
  value = parseText();
  Object.setPrototypeOf(value, null);
  report("no prototype", value);
  value = parseText();
  const proxy = new Proxy(value, {});
  report("proxy", proxy);
  console.log(structuredClone(parseText()), Bun.deepEquals(parseText(), parseText()), Bun.inspect(parseText()));
  const map = new Map([[parseText(), 1]]);
  const weak = new WeakMap([[value, 2]]);
  console.log(map.size, weak.get(value));
}
