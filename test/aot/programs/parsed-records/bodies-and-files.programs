//// parsed-in-untyped-module/decode.js
export const leak = new Function("value", process.argv.length > 99 ? "" : "return value");
const seen = new Map();
export function decode(text) {
  return JSON.parse(text);
}
export function decodeLater(text) {
  return Promise.resolve(text).then(value => JSON.parse(value));
}
export function cached(text) {
  let value = seen.get(text);
  if (!value) seen.set(text, (value = JSON.parse(text)));
  return value;
}
//// parsed-in-untyped-module/main.ts
import { cached, decode, decodeLater, leak } from "./decode.js";
interface Address { city: string; zip: string }
interface Person { name: string; age: number; address: Address; previous: Address[] }
function summary(person: Person): string {
  return `${person.name} (${person.age}) ${person.address.city} ${person.address.zip} ${person.previous.map(address => address.city).join("+")}`;
}
leak({ name: "", age: 0, address: { city: "", zip: "" }, previous: [] } satisfies Person);
console.log(summary({ name: "a", age: 1, address: { city: "c", zip: "z" }, previous: [] }));
const text = '{"name":"Ann","age":41,"address":{"city":"Oslo","zip":"0150"},"previous":[{"city":"Lisbon","zip":"1000"},{"zip":"80202","city":"Denver"}]}';
for (let round = 0; round < 3; round++) {
  console.log(summary(decode(text) as Person));
  console.log(summary((await decodeLater(text)) as Person));
  const holder = { body: undefined as unknown };
  holder.body = decode(text);
  console.log(summary(holder.body as Person));
  console.log(cached(text) === cached(text), summary(cached(text) as Person));
}
//// reviver.ts
const leak = new Function("value", process.argv.length > 99 ? "" : "return value");
////= parse
interface Money { amount: number; currency: string }
function format(money: Money): string {
  return `${money.amount} ${money.currency}`;
}
leak({ amount: 0, currency: "" } satisfies Money);
console.log(format({ amount: 1, currency: "USD" }));
const text = '{"price":{"amount":5,"currency":"EUR"},"list":[{"amount":1,"currency":"a"},{"amount":2,"currency":"b"}]}';
for (let round = 0; round < 3; round++) {
  const seen: string[] = [];
  const doubled = parse(text, function (this: any, key: string, value: any) {
    seen.push(`${key}:${typeof value}:${Object.keys(this).join("+")}`);
    return typeof value === "number" ? value * 2 : value;
  });
  console.log(seen.join(" "), format(doubled.price), doubled.list.map(format).join(), JSON.stringify(doubled));
  const dropped = parse(text, (key: string, value: any) => (key === "currency" ? undefined : value));
  console.log(format(dropped.price), Object.keys(dropped.price).join(), JSON.stringify(dropped));
  const replaced = parse(text, (key: string, value: any) => (key === "price" ? { currency: "X", amount: 0, more: 1 } : value));
  console.log(format(replaced.price), JSON.stringify(replaced));
  for (const notCallable of [undefined, null, 1, "f", {}, []] as any[]) {
    const value = parse(text, notCallable);
    console.log(format(value.price), value.list.map(format).join());
  }
}
export {};
//// texts-that-fit-their-type-texts-that-do-not-and-texts-that-are-no-json.ts
// JSON.parse `as` a record: texts that fit the type in any order of keys, texts whose values do not fit, repeated keys, __proto__, extra keys, every kind of malformed text, primitives and arrays in place of the record, revivers.
type Inner = { x: number; y?: string };
type Rec = { id: number; name: string; ok: boolean; tags: string[]; inner: Inner; opt?: number; nul: null; list: Inner[] };
function show(v: unknown) { return Bun.inspect(v, { depth: 9, sorted: false }).replace(/\s+/g, " "); }
function tryParse(t: string) { try { const r = JSON.parse(t) as Rec; return show(r) + " | " + Object.keys(r as any).join(); } catch (e: any) { return e.constructor.name + ": " + e.message.split(" (evaluating")[0]; } }
const texts = [
  '{"id":1,"name":"a","ok":true,"tags":["x"],"inner":{"x":1},"nul":null,"list":[]}',
  '{"name":"a","id":1,"list":[{"x":1,"y":"q"},{"y":"r","x":2}],"ok":false,"tags":[],"inner":{"y":"s","x":-0},"nul":null}',
  '{"id":"not a number","name":5,"ok":null,"tags":{"0":"x"},"inner":[1],"nul":1,"list":"no"}',
  '{"id":1,"id":2,"name":"a","name":"b"}', '{"__proto__":{"evil":1},"id":1}', '{"id":1,"extra":{"deep":[1,{"a":null}]},"constructor":1,"toString":2}',
  '{"id":1e400,"name":"\\u0041\\ud83d\\ude00\\n","ok":true}', '{"id":-0,"opt":0.1e1,"inner":{"x":1E+2}}', '{"id":01}', '{"id":1,}', '{"id":+1}', "{'id':1}", '{"id":1}x', ' \n\t{"id" : 1 } \r', '{"id":.5}', '{"id":1.}', '{"id":-}', '{"name":"\t"}', '{"name":"\\x41"}', '{"name":"\\u12"}', '{"name":"unterminated', '', 'null', '[]', '1', '"s"', 'true', '[1,2,,3]', '{"10":1,"2":2,"a":3,"1":4}', '{"":1," ":2}', '﻿{"id":1}', '{"id":123456789012345678901234567890}', '{"id":9007199254740993}', '{"tags":["a","b",3,null,["n"]]}', '{"list":[{"x":1},null,5,{"x":"s"}]}', '{"inner":null}', '{"inner":{"x":1,"x":{"y":2}}}',
];
for (const t of texts) console.log(tryParse(t));
const r = JSON.parse(texts[0]) as Rec; console.log(r.id + 1, r.name.length, r.tags.length, r.inner.x * 2, r.opt === undefined, r.list.length, Object.getPrototypeOf(r) === Object.prototype, Array.isArray(r.tags));
const bad = JSON.parse(texts[2]) as Rec; console.log(typeof bad.id, typeof bad.name, bad.ok, typeof bad.tags, Array.isArray(bad.inner), bad.nul, typeof bad.list);
console.log(show(JSON.parse('{"a":1,"b":[1,2,{"c":3}]}', function (k, v) { return typeof v === "number" ? v * 2 : v; })), show(JSON.parse('{"a":1,"b":2}', (k, v) => (k === "a" ? undefined : v))));
function sum(n: number) { let t = 0; for (let i = 0; i < n; i++) { const o = JSON.parse('{"id":' + i + ',"name":"n","ok":true,"tags":["a","b"],"inner":{"x":' + i / 2 + '},"nul":null,"list":[{"x":1}]}') as Rec; t += o.id + o.inner.x + o.tags.length + o.list[0].x; } return t; } console.log(sum(300));
//// values-that-do-not-fit.ts
const leak = new Function("value", process.argv.length > 99 ? "" : "return value");
////= parse
interface Row { count: number; ok: boolean; name: string; tags: string[]; inner: { depth: number } }
function read(row: Row): string {
  return [typeof row.count, row.count, typeof row.ok, row.ok, typeof row.name, row.name, Array.isArray(row.tags), JSON.stringify(row.tags), JSON.stringify(row.inner)].join(" ");
}
function total(rows: Row[]): number {
  let sum = 0;
  for (const row of rows) sum += row.count;
  return sum;
}
////= show	read(value), JSON.stringify(value)
leak({ count: 0, ok: true, name: "", tags: [], inner: { depth: 0 } } satisfies Row);
const rows: Row[] = [];
for (let i = 0; i < 4; i++) rows.push({ count: i, ok: i % 2 === 0, name: `n${i}`, tags: [`t${i}`], inner: { depth: i } });
console.log(total(rows), read(rows[3]!));
const fits = '"ok":true,"name":"n","tags":["a"],"inner":{"depth":1}';
for (let round = 0; round < 3; round++) {
  for (const count of ["1", "-1", "0", "-0", "1.5", "1e3", "1e21", "2147483647", "2147483648", "-2147483648", "-2147483649", "9007199254740993", "1e400", "null", '"7"', "true", "[]", "{}"])
    show(`{"count":${count},${fits}}`);
  show('{"count":1,"ok":null,"name":"n","tags":["a"],"inner":{"depth":1}}');
  show('{"count":1,"ok":0,"name":"n","tags":["a"],"inner":{"depth":1}}');
  show('{"count":1,"ok":true,"name":null,"tags":["a"],"inner":{"depth":1}}');
  show('{"count":1,"ok":true,"name":5,"tags":["a"],"inner":{"depth":1}}');
  show('{"count":1,"ok":true,"name":"n","tags":{"0":"a"},"inner":{"depth":1}}');
  show('{"count":1,"ok":true,"name":"n","tags":[1,null,{}],"inner":{"depth":1}}');
  show('{"count":1,"ok":true,"name":"n","tags":null,"inner":null}');
  show('{"count":1,"ok":true,"name":"n","tags":["a"],"inner":{"depth":"deep"}}');
  show('{"count":1,"ok":true,"name":"n","tags":["a"],"inner":[1]}');
  show('{"count":1,"ok":true,"name":"n","tags":["a"],"inner":{"depth":1,"more":2}}');
  console.log(total(parse(`[{"count":1,${fits}},{"count":2.5,${fits}},{"count":"x",${fits}}]`)));
}
export {};
