//// private-members-on-unknown-objects.js
// Private members on objects nothing is known about, in loops long enough to fill the keyed tables.
////= describeOutcome
function collectOutcomes(f) {
  const results = new Set();
  for (let i = 0; i < 100; i++) results.add(describeOutcome(f));
  return [...results].join(" / ");
}
function show(...parts) {
  console.log(parts.join(" | "));
}

class Identity {
  constructor(target) {
    return target;
  }
}

class Stamp extends Identity {
  #field = 1;
  #method() {
    return "method " + this.#field;
  }
  get #getter() {
    return "getter " + this.#field;
  }
  set #setter(value) {
    this.#field = value;
  }
  get #both() {
    return this.#field * 2;
  }
  set #both(value) {
    this.#field = value / 2;
  }
  static #staticField = 10;
  static #staticMethod() {
    return "static method";
  }
  static get #staticAccessor() {
    return Stamp.#staticField + 1;
  }
  static set #staticAccessor(value) {
    Stamp.#staticField = value;
  }

  static readField(o) {
    return o.#field;
  }
  static writeField(o, value) {
    o.#field = value;
    return o.#field;
  }
  static callMethod(o) {
    return o.#method();
  }
  static writeMethod(o) {
    o.#method = 1;
  }
  static readGetter(o) {
    return o.#getter;
  }
  static writeGetter(o) {
    o.#getter = 1;
  }
  static readSetter(o) {
    return o.#setter;
  }
  static writeSetter(o, value) {
    o.#setter = value;
    return o.#field;
  }
  static readBoth(o) {
    return o.#both;
  }
  static writeBoth(o, value) {
    o.#both = value;
    return o.#both;
  }
  static hasField(o) {
    return #field in o;
  }
  static hasMethod(o) {
    return #method in o;
  }
  static hasGetter(o) {
    return #getter in o;
  }
  static readStatic(o) {
    return o.#staticField;
  }
  static writeStatic(o, value) {
    o.#staticField = value;
    return o.#staticField;
  }
  static callStatic(o) {
    return o.#staticMethod();
  }
  static readStaticAccessor(o) {
    return o.#staticAccessor;
  }
  static writeStaticAccessor(o, value) {
    o.#staticAccessor = value;
    return o.#staticAccessor;
  }
  static hasStatic(o) {
    return #staticField in o;
  }
}

class Fields extends Identity {
  #value = "field";
  static read(o) {
    return o.#value;
  }
  static has(o) {
    return #value in o;
  }
}

class Methods extends Identity {
  #method() {
    return "only a method";
  }
  static call(o) {
    return o.#method();
  }
  static has(o) {
    return #method in o;
  }
}

class Plain {
  #field = "own";
  #method() {
    return this.#field + " method";
  }
  get #accessor() {
    return this.#field + " accessor";
  }
  set #accessor(value) {
    this.#field = value;
  }
  static describe(o) {
    o.#accessor = o.#field + "!";
    return [o.#field, o.#method(), o.#accessor, #field in o, #method in o, #accessor in o].join();
  }
}

const trapped = [];
const proxyTarget = {};
const traps = {};
for (const name of ["get", "set", "has", "defineProperty", "getOwnPropertyDescriptor", "deleteProperty", "ownKeys"]) {
  traps[name] = (...args) => {
    trapped.push(name);
    return Reflect[name](...args);
  };
}
const proxy = new Proxy(proxyTarget, traps);
const frozenFirst = Object.freeze({ shown: 1 });
const frozenLater = { shown: 2 };
const dictionary = {};
for (let i = 0; i < 200; i++) dictionary["key" + i] = i;
for (let i = 0; i < 190; i++) delete dictionary["key" + i];

const stamped = [
  ["plain", {}],
  ["with properties", { a: 1, b: 2 }],
  ["array", []],
  ["function", function () {}],
  ["frozen first", frozenFirst],
  ["frozen later", frozenLater],
  ["dictionary", dictionary],
  ["proxy", proxy],
];
for (const [, target] of stamped) new Stamp(target);
Object.freeze(frozenLater);

for (const [title, o] of stamped) {
  show(
    title,
    collectOutcomes(() => Stamp.readField(o)),
    collectOutcomes(() => Stamp.callMethod(o)),
    collectOutcomes(() => Stamp.readGetter(o)),
    collectOutcomes(() => Stamp.readBoth(o)),
    collectOutcomes(() => [Stamp.hasField(o), Stamp.hasMethod(o), Stamp.hasGetter(o), Stamp.hasStatic(o)]),
  );
  let total = 0;
  for (let i = 0; i < 100; i++) total += Stamp.writeField(o, i);
  show(
    title + " writes",
    total,
    collectOutcomes(() => Stamp.writeSetter(o, 7)),
    collectOutcomes(() => Stamp.writeBoth(o, 8)),
    collectOutcomes(() => Stamp.writeMethod(o)),
    collectOutcomes(() => Stamp.writeGetter(o)),
    collectOutcomes(() => Stamp.readSetter(o)),
  );
}
show("proxy traps that ran", trapped.length, "target has the field", Stamp.hasField(proxyTarget));
show("frozen objects stay frozen", Object.isFrozen(frozenFirst), Object.isFrozen(frozenLater));

const inherited = Object.create(stamped[0][1]);
const absent = [
  ["no members", {}],
  ["inherits them", inherited],
  ["frozen", Object.freeze({})],
  ["proxy of a stamped object", new Proxy(stamped[0][1], {})],
  ["prototype", Stamp.prototype],
];
for (const [title, o] of absent) {
  show(
    title,
    collectOutcomes(() => Stamp.readField(o)),
    collectOutcomes(() => Stamp.writeField(o, 1)),
    collectOutcomes(() => Stamp.callMethod(o)),
    collectOutcomes(() => Stamp.readGetter(o)),
    collectOutcomes(() => Stamp.writeSetter(o, 1)),
    collectOutcomes(() => [Stamp.hasField(o), Stamp.hasMethod(o), Stamp.hasGetter(o)]),
  );
}

for (const [title, value] of [["number", 5], ["string", "text"], ["boolean", true], ["symbol", Symbol.iterator], ["bigint", 5n], ["null", null], ["undefined", undefined]]) {
  show(
    title,
    collectOutcomes(() => Stamp.readField(value)),
    collectOutcomes(() => Stamp.writeField(value, 1)),
    collectOutcomes(() => Stamp.callMethod(value)),
    collectOutcomes(() => Stamp.hasField(value)),
    collectOutcomes(() => Stamp.hasMethod(value)),
  );
}

////= show	"static members"	Stamp
let staticTotal = 0;
for (let i = 0; i < 100; i++) staticTotal += Stamp.writeStatic(Stamp, i) + Stamp.writeStaticAccessor(Stamp, i);
show("static writes", staticTotal);
class Derived extends Stamp {}
////= show	"static members of a subclass"	Derived

const twice = {};
new Fields(twice);
show("field added twice", describeOutcome(() => new Fields(twice)), Fields.read(twice));
const twiceFrozen = Object.freeze({});
new Fields(twiceFrozen);
show("field added twice to a frozen object", describeOutcome(() => new Fields(twiceFrozen)), Fields.read(twiceFrozen));
show(
  "field added over and over",
  collectOutcomes(() => new Fields(twice) === twice),
);
const sameShape = [];
for (let i = 0; i < 100; i++) sameShape.push(new Fields({ shape: i }));
show("fields added to one shape", sameShape.every(Fields.has), collectOutcomes(() => Fields.read(sameShape[99])));

const methodsTwice = {};
new Methods(methodsTwice);
show("methods installed twice", describeOutcome(() => new Methods(methodsTwice)), Methods.call(methodsTwice));
const methodsOnFrozen = Object.freeze({});
new Methods(methodsOnFrozen);
show("methods installed twice on a frozen object", describeOutcome(() => new Methods(methodsOnFrozen)), Methods.call(methodsOnFrozen));
show(
  "methods installed over and over",
  collectOutcomes(() => new Methods(methodsTwice) === methodsTwice),
);

const before = {};
const sameStructure = {};
show("absent brand", collectOutcomes(() => Methods.has(before)), collectOutcomes(() => Fields.has(before)));
new Methods(before);
show("brand after install", collectOutcomes(() => Methods.has(before)), collectOutcomes(() => Fields.has(before)));
show("brand of another object", collectOutcomes(() => Methods.has(sameStructure)));
new Fields(before);
show("field after install", collectOutcomes(() => Fields.has(before)), collectOutcomes(() => Fields.read(before)));
show("field of another object", collectOutcomes(() => Fields.has(sameStructure)), collectOutcomes(() => Fields.read(sameStructure)));

const reflected = {};
new Stamp(reflected);
show(
  "private members are not properties",
  Reflect.ownKeys(reflected).length,
  JSON.stringify(reflected),
  Object.getOwnPropertySymbols(reflected).length,
);

const instances = [];
for (let i = 0; i < 100; i++) instances.push(new Plain());
show("right class", new Set(instances.map(Plain.describe)).size, Plain.describe(instances[0]));
show("wrong class", collectOutcomes(() => Plain.describe({})), collectOutcomes(() => Plain.describe(new Stamp({}))));
const right = new Stamp({});
show(
  "right class through the helpers",
  collectOutcomes(() => Stamp.readField(right)),
  collectOutcomes(() => Stamp.callMethod(right)),
  collectOutcomes(() => Stamp.readGetter(right)),
  collectOutcomes(() => Stamp.writeSetter(right, 3)),
  collectOutcomes(() => Stamp.writeBoth(right, 4)),
  collectOutcomes(() => [Stamp.hasField(right), Stamp.hasMethod(right), Stamp.hasGetter(right)]),
);
//// private-members-stamped-on-foreign-objects.js
// A constructor that returns another object hands it to the derived class as `this`: its private members and fields land on that object, whatever it is.
function attempt(run) { try { return run(); } catch (error) { return error.constructor.name; } }
class Hand { constructor(object) { return object; } }
class Stamp extends Hand {
  #secret = 1;
  #method() { return "method " + this.#secret; }
  get #twice() { return this.#secret * 2; }
  set #twice(value) { this.#secret = value / 2; }
  shown = "shown";
  static has(object) { return #secret in object; }
  static read(object) { return object.#secret; }
  static write(object, value) { object.#secret = value; return object.#secret; }
  static call(object) { return object.#method(); }
  static twice(object) { object.#twice = 10; return object.#twice; }
}
const targets = {
  literal: { a: 1 },
  array: [1, 2],
  callable: function named() {},
  arrow: () => 1,
  frozen: Object.freeze({ f: 1 }),
  sealed: Object.seal({ s: 1 }),
  closed: Object.preventExtensions({ c: 1 }),
  bare: Object.create(null),
  map: new Map(),
  date: new Date(0),
  error: new Error("e"),
  proxy: new Proxy({ p: 1 }, {}),
  instance: new (class Other { o = 1; })(),
  regexp: /x/,
  typed: new Uint8Array(2),
  boxed: Object("text"),
  promise: Promise.resolve(1),
  klass: class Target {},
};
for (const [name, target] of Object.entries(targets)) {
  const before = Stamp.has(target);
  const made = attempt(() => new Stamp(target) === target);
  console.log(name, before, made, Stamp.has(target), attempt(() => Stamp.read(target)), attempt(() => Stamp.write(target, 5)), attempt(() => Stamp.call(target)), attempt(() => Stamp.twice(target)), attempt(() => target.shown), Object.keys(target).join());
}
// Twice on one object: the second initialization throws, and what stood there stays.
const once = {};
new Stamp(once);
Stamp.write(once, 42);
console.log(attempt(() => new Stamp(once)), Stamp.read(once));
// Two classes on one object.
class Second extends Hand { #secret = "second"; static read(object) { return object.#secret; } static has(object) { return #secret in object; } }
new Second(once);
console.log(Stamp.read(once), Second.read(once), Second.has({}), Stamp.has(new Second({})));
// A primitive that is returned is refused for a derived class; undefined means the object that super made.
class HandsPrimitive { constructor(value) { return value; } }
class Below extends HandsPrimitive { #p = 1; static has(object) { return #p in object; } }
console.log(attempt(() => Below.has(new Below(5))), attempt(() => Below.has(new Below(undefined))), attempt(() => Below.has(new Below(null))), attempt(() => Below.has(new Below("s"))));
class ReturnsFromDerived extends Object { constructor(value) { super(); return value; } }
console.log(attempt(() => typeof new ReturnsFromDerived(5)), attempt(() => typeof new ReturnsFromDerived(undefined)), attempt(() => new ReturnsFromDerived(once) === once), attempt(() => typeof new ReturnsFromDerived(null)));
//// private-method-calls-from-everywhere.js
// A private method called on `this`, on another instance, from a static method, from closures and arrow fields and from field initializers, with too few, too many and spread arguments, recursively, and read as a value and called later with and without a receiver.
function said(f) { try { return String(f()); } catch (e) { return "threw " + e.name; } }
class C {
  constructor(v) { this.v = v; }
  first = this.#tag("initializer");
  #tag(text) { return text + ":" + this.v; }
  #add(a, b) { return this.v + a + b; }
  #rest(...r) { return r.length; }
  #count() { return arguments.length; }
  #fib(n) { return n < 2 ? n : this.#fib(n - 1) + this.#fib(n - 2); }
  #receiver() { return this === undefined ? "no receiver" : this.v; }
  arrowField = () => this.#add(1, 2);
  onThis() { return this.#add(1, 2); }
  onOther(o) { return o.#add(1, 2); }
  static onArgument(o) { return o.#add(1, 2); }
  inArrow() { return (() => this.#add(1, 2))(); }
  inFunction() { const self = this; return function () { return self.#add(1, 2); }; }
  few() { return this.#add(1); }
  many() { return this.#add(1, 2, 3, 4); }
  spread(list) { return this.#add(...list); }
  rest() { return this.#rest(1, 2, 3); }
  count() { return this.#count(1, 2, 3, 4, 5); }
  fib(n) { return this.#fib(n); }
  bare() { const f = this.#receiver; return f(); }
  held() { const holder = { v: "holder", f: this.#receiver }; return holder.f(); }
  called(o) { return this.#receiver.call(o); }
  same(o) { return this.#receiver === o.#receiver; }
}
const c = new C(10), d = new C(20);
console.log([c.first, c.onThis(), c.onOther(d), C.onArgument(d), c.inArrow(), c.inFunction()(), c.arrowField(), c.few(), c.many(), c.spread([3, 4]), c.rest(), c.count(), c.fib(15)].join());
console.log([c.bare(), c.held(), c.called({ v: "called" }), c.same(d)].join());
console.log([said(() => C.onArgument({})), said(() => C.onArgument(null)), said(() => C.onArgument(1)), said(() => c.onOther(Object.create(d))), said(() => c.onOther(new Proxy(d, {})))].join());
//// private-method-calls-on-an-open-class-avoid-runtime.ts
// A call of a private method on a class that also takes untyped objects does not look the method up by name. The program counts the entries of the operations that a lookup by name goes through.
declare const aotOperationCount: undefined | ((name: string) => number);
const counted = typeof aotOperationCount === "function" ? aotOperationCount : null;
function entered(): number {
  return counted ? counted("operationAOTGetById") + counted("operationAOTGetByIdAndCache") : 0;
}
class Pool {
  served = 0;
  #next(): boolean {
    this.served++;
    return false;
  }
  #drain(): void {
    while (this.#next());
  }
  drain(): void {
    this.#drain();
  }
}
const Untyped: any = Pool;
class Heir extends Untyped {}
const taken: any[] = [new Heir(), new Pool()];
const pool = taken[1] as Pool;
pool.drain();
const before = entered();
for (let turn = 0; turn < 2000; turn++) pool.drain();
const entries = entered() - before;
console.log(pool.served, entries);
//// private-method-calls-several-classes-untyped.js
// Calls of private methods in JavaScript: on `this`, on another object of the class, on an object that lacks the method, in classes that are evaluated once and many times, with more and fewer arguments than parameters, and of a private field that holds a function.
const thrownBy = f => { try { return "no error: " + f(); } catch (error) { return error.constructor.name; } };
class Router {
  #routes = [];
  #handler = (path) => "field " + path;
  #match(method, path) { return method + " " + path + " " + this.#routes.length; }
  #rest(first, ...others) { return first + ":" + others.join(); }
  #defaulted(a, b = a + 1) { return a + b; }
  async #later(value) { return value + 1; }
  *#each() { yield* this.#routes; }
  static #count(router) { return router.#routes.length; }
  add(route) { this.#routes.push(route); return this; }
  match(method, path) { return this.#match(method, path); }
  matchOn(other, method, path) { return other.#match(method, path); }
  few() { return this.#match("GET"); }
  many() { return this.#match("GET", "/", "ignored", "too"); }
  rest() { return this.#rest(1) + " " + this.#rest(1, 2, 3); }
  defaulted() { return this.#defaulted(1) + this.#defaulted(1, 5); }
  later() { return this.#later(1); }
  each() { return [...this.#each()].join(); }
  handler(path) { return this.#handler(path); }
  replaceHandler(f) { this.#handler = f; return this; }
  optional(other) { return other?.#match("GET", "/o"); }
  detached() { const f = this.#match; return f.call(this, "GET", "/d") + " " + (f === this.#match) + " " + f.name + " " + f.length; }
  static count(router) { return Router.#count(router); }
}
const router = new Router().add("a").add("b"), other = new Router();
let said = new Set();
for (let i = 0; i < 2000; i++) said.add(router.match("GET", "/x") + " | " + router.matchOn(other, "PUT", "/y") + " | " + router.few() + " | " + router.many() + " | " + router.rest() + " | " + router.defaulted() + " | " + router.each() + " | " + router.handler("/h"));
console.log([...said].join("\n"));
console.log(thrownBy(() => router.matchOn({}, "GET", "/")), thrownBy(() => router.matchOn(null, "GET", "/")), thrownBy(() => router.matchOn(Object.create(router), "GET", "/")), thrownBy(() => Router.prototype.match.call({}, "GET", "/")), router.optional(undefined), router.optional(other), thrownBy(() => router.optional({})));
console.log(router.detached(), Router.count(router), thrownBy(() => Router.count({})), router.replaceHandler(path => "replaced " + path).handler("/r"), thrownBy(() => router.replaceHandler(5).handler("/r")));
// A class that is evaluated many times: each has a method of its own, which captures what is around it.
const classes = [1, 2, 3].map(n => class {
  #scaled(x) { return x * n; }
  scale(x) { return this.#scaled(x); }
  scaleOn(object, x) { return object.#scaled(x); }
});
const objects = classes.map(C => new C());
console.log(objects.map(object => object.scale(10)).join(), objects.map((object, i) => thrownBy(() => object.scaleOn(objects[(i + 1) % 3], 10))).join(), objects[1].scaleOn(new classes[1](), 4));
// Two classes that use the same spelling.
class Left { #name() { return "left"; } name() { return this.#name(); } static on(object) { return object.#name(); } }
class Right { #name() { return "right"; } name() { return this.#name(); } static on(object) { return object.#name(); } }
console.log(new Left().name(), new Right().name(), thrownBy(() => Left.on(new Right())), thrownBy(() => Right.on(new Left())), Left.on(new Left()));
router.later().then(value => console.log("later", value));
//// private-method-read-before-its-arguments.ts
// `this.#m(f())` reads the method before it evaluates the arguments: an object without the method throws before f runs, also when the class takes untyped objects.
const log: string[] = [];
function argument(): number {
  log.push("argument");
  return 1;
}
class Pool {
  total = 0;
  #add(amount: number): number {
    this.total += amount;
    return this.total;
  }
  get #counted(): number {
    return this.total;
  }
  addTwice(): number {
    this.#add(argument());
    return this.#add(argument()) + this.#counted;
  }
  static addTo(other: Pool): number {
    return other.#add(argument());
  }
}
const Untyped: any = Pool;
class Heir extends Untyped {}
const taken: any[] = [new Heir(), new Pool()];
console.log((taken[0] as Pool).addTwice(), (taken[1] as Pool).addTwice(), Pool.addTo(taken[0]));
try {
  log.length = 0;
  Pool.addTo({ total: 0 } as any);
} catch (error) {
  console.log((error as Error).name, log.length);
}
//// private-methods-are-searched-for-once.ts
// A private method that is read by name is searched for among the methods of its class once, not at every read. The program counts how often the run time is asked for it.
declare const aotOperationCount: undefined | ((name: string) => number);
const counted = typeof aotOperationCount === "function" ? aotOperationCount : null;
let evaluated = 0;
function argument(): number {
  evaluated++;
  return 1;
}
class Pool {
  total = 0;
  #add(amount: number): number {
    this.total += amount;
    return this.total;
  }
  add(): number {
    return this.#add(argument());
  }
}
const Untyped: any = Pool;
class Heir extends Untyped {}
const taken: any[] = [new Heir(), new Pool()];
const pool = taken[1] as Pool;
for (let turn = 0; turn < 2000; turn++) pool.add();
const searches = counted ? counted("operationAOTPrivateGet") : null;
console.log(pool.total, evaluated, searches === null || searches < 10);
