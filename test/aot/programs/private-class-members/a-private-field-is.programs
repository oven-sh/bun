//// module-cycle-untyped/main.js
// Two modules that import each other, each with a class with static private methods (the same program without type annotations).
import "./files/a.js";
//// name-per-class-evaluation.ts
// Each evaluation of a class creates its own private names, even where two names have one spelling.
function said(f: () => unknown): string { try { return String(f()) } catch (e) { return "threw " + (e as Error).name } }
function show(...parts: unknown[]): void { console.log(parts.join(" | ")) }

function makeBox(tag: string) {
  return class Box {
    shown: string = tag
    #value: string = tag
    #method(): string { return "m" + this.#value }
    get #accessor(): string { return "a" + this.#value }
    static #count: number = 0
    static has(o: object): string { return [#value in o, #method in o, #accessor in o].join() }
    static hasStatic(o: object): boolean { return #count in o }
    static read(o: any): string { return said(() => o.#value + o.#method() + o.#accessor) }
    static method(o: any): unknown { return o.#method }
    static increment(): number { return ++Box.#count }
  }
}
type Constructor = new (...args: any[]) => object
const Tagged = <T extends Constructor>(Base: T) => class extends Base {
  #id: number = 1
  static has(o: object): boolean { return #id in o }
  bump(): number { return ++this.#id }
}
class Single {
  #value: string = "s"
  static has(o: object): boolean { return #value in o }
}
class Outer {
  #x: number = 1
  static read(o: any): string { return said(() => o.#x) }
  static Inner = class {
    #x: number = 2
    static read(o: any): string { return said(() => o.#x) }
  }
}

const A = makeBox("a"), B = makeBox("b")
const boxes: [string, typeof A][] = [["A", A], ["B", B]]
const values: [string, object][] = [["new A()", new A()], ["new B()", new B()], ["A", A], ["B", B], ["new Single()", new Single()]]
for (const [boxName, X] of boxes) {
  for (const [title, o] of values) show(boxName, title, X.has(o), X.read(o), X.hasStatic(o), Single.has(o))
}
show("one method per evaluation", A.method(new A()) === A.method(new A()), A.method(new A()) === B.method(new B()))
show("one static field per evaluation", A.increment(), A.increment(), B.increment())

const classes: any[] = []
for (let i = 0; i < 3; i++) classes.push(class { #n: number = i; static get(o: any) { return said(() => o.#n) } })
for (let j = 0; j < 3; j++) show("class " + j + " of a loop", classes[j].get(new classes[0]()), classes[j].get(new classes[1]()), classes[j].get(new classes[2]()))

const Inner = Tagged(Object), Both = Tagged(Inner), Apart = Tagged(Object), both = new Both()
show("two fields of one spelling", Inner.has(both), Both.has(both), Apart.has(both))
show(
  "each field counts alone",
  Inner.prototype.bump.call(both),
  Both.prototype.bump.call(both),
  Inner.prototype.bump.call(both),
  Both.prototype.bump.call(both),
  said(() => Apart.prototype.bump.call(both)),
)
show("nested classes", Outer.read(new Outer()), Outer.read(new Outer.Inner()), Outer.Inner.read(new Outer()), Outer.Inner.read(new Outer.Inner()))
export {}
//// outer-name-in-heritage-clause.js
// A private name in the heritage clause of a class is the enclosing class's, even if the class declares the same name.
class Outer {
  #name = "outer";
  static read(object) {
    let seen;
    class Inner extends ((seen = object.#name), Object) {
      #name = "inner";
      static read(other) { return other.#name; }
    }
    return seen + " " + Inner.read(new Inner());
  }
  static has(object) {
    let seen;
    class Inner extends ((seen = #name in object), Object) {
      #name = "inner";
      static has(other) { return #name in other; }
    }
    return seen + " " + Inner.has(object);
  }
}
console.log(Outer.read(new Outer()));
console.log(Outer.has(new Outer()));
//// own-keys-of-objects-with-private-fields-are-walked-in-a-validating-build.ts
// The own keys of an instance with private fields, a private method or both are walked by a rest pattern, a spread, Object.keys | values | entries | assign, for-in and JSON.stringify: on the object where it is made, on one that a variable of the module holds, and on one out of a list. A private name is no key: as in plain Bun, and a validating build has nothing to find.
class Field { #hidden = 1; shown = 2; other = 3; read() { return this.#hidden } }
class Method { #method() { return 1 } shown = 2; other = 3; read() { return this.#method() } }
class Between { shown = 2; #hidden = 1; other = 3; read() { return this.#hidden } }
class Last { shown = 2; other = 3; #hidden = 1; read() { return this.#hidden } }
class Only { #hidden = 1; shown = 2; read() { return this.#hidden } }
class Late { #hidden = 1; shown = 2; late?: string; read() { return this.#hidden } }
class TwoOrders { #hidden = 1; shown = 0; other = 0; a?: number; b?: number; constructor(first: boolean) { if (first) { this.a = 1; this.b = 2 } else { this.b = 2; this.a = 1 } } read() { return this.#hidden } }
class Below extends Field { #more = 4; added = 5; readMore() { return this.#more } }
type Shown = { shown: number; read(): number }
function walks(o: Shown): string {
  const { shown, ...rest } = o
  const seen: string[] = []
  for (const key in o) seen.push(key)
  return [JSON.stringify(rest), JSON.stringify({ ...o }), Object.keys(o).join(), Object.values(o).join(), JSON.stringify(Object.entries(o)), JSON.stringify(Object.assign({}, o)), seen.join(), JSON.stringify(o), Reflect.ownKeys(o).length, shown, o.read()].join(" ")
}
function repeat(label: string, make: (round: number) => Shown): void {
  let last = ""
  for (let round = 0; round < 300; round++) last = walks(make(round))
  console.log(label, last)
}
const held = { field: new Field(), method: new Method(), between: new Between(), last: new Last(), only: new Only(), late: new Late(), below: new Below() }
const list: Shown[] = [new Field(), new Method(), new Between(), new Last(), new Only(), new Late(), new TwoOrders(true), new TwoOrders(false), new Below()]
repeat("made here: field", () => new Field())
repeat("made here: method", () => new Method())
repeat("made here: between", () => new Between())
repeat("made here: last", () => new Last())
repeat("made here: only", () => new Only())
repeat("made here: late", () => new Late())
repeat("made here: two orders, the first", () => new TwoOrders(true))
repeat("made here: two orders, the second", () => new TwoOrders(false))
repeat("made here: two orders, in turn", round => new TwoOrders(round % 2 === 0))
repeat("made here: below", () => new Below())
repeat("held: field", () => held.field)
repeat("held: method", () => held.method)
repeat("held: between", () => held.between)
repeat("held: last", () => held.last)
repeat("held: only", () => held.only)
repeat("held: late", () => held.late)
repeat("held: below", () => held.below)
for (let which = 0; which < list.length; which++) repeat("out of a list: " + which, () => list[which])
const secret = new Only()
function restOfSecret() { const { shown, ...rest } = secret; return rest }
let last: object = {}
for (let i = 0; i < 2000; i++) last = restOfSecret()
console.log("a variable of the module", JSON.stringify(last), Object.keys(last).join())
//// private-fields-declared-without-a-value-are-read-before-and-behind-their-first-store.ts
// Private fields that a class declares without a value hold undefined from birth: they are read before anything is stored, behind a store, on objects that are not finished, and on objects that never had them.
function say(label: string, make: () => unknown): void {
  let text: string;
  try {
    text = String(make());
  } catch (error) {
    text = (error as Error).constructor.name;
  }
  console.log(label, text);
}

class Reply {
  #status: number | undefined;
  #text: string | undefined;
  #headers: Map<string, string> | undefined;
  #done: boolean | undefined;
  kind = "reply";
  status(): number {
    return this.#status ?? 200;
  }
  setStatus(status: number): this {
    this.#status = status;
    return this;
  }
  text(): string {
    return this.#text ?? "none";
  }
  setText(text: string | undefined): void {
    this.#text = text;
  }
  header(name: string): string | undefined {
    return this.#headers?.get(name);
  }
  setHeader(name: string, value: string): void {
    (this.#headers ??= new Map()).set(name, value);
  }
  done(): boolean | undefined {
    return this.#done;
  }
  finish(): void {
    this.#done = true;
  }
  static statusOf(value: unknown): unknown {
    return (value as Reply).#status;
  }
  static has(value: object): boolean {
    return #status in value;
  }
}

let sum = 0;
for (let turn = 0; turn < 2000; turn++) {
  const reply = new Reply();
  sum += reply.status();
  if (turn % 3 === 0) reply.setStatus(turn % 600);
  if (turn % 500 === 7) reply.setStatus(2 ** 40 + turn);
  if (turn % 500 === 9) reply.setStatus(0.5);
  sum += reply.status();
  if (turn % 5 === 0) reply.setText("t" + (turn & 7));
  if (turn % 10 === 0) reply.setText(undefined);
  sum += reply.text().length;
  if (turn % 7 === 0) reply.setHeader("a", "b" + turn);
  sum += reply.header("a")?.length ?? 1;
  if (turn % 11 === 0) reply.finish();
  sum += reply.done() ? 2 : reply.done() === undefined ? 3 : 5;
}
console.log(sum);

say("of an instance", () => Reply.statusOf(new Reply()));
say("of a stored one", () => Reply.statusOf(new Reply().setStatus(404)));
say("of a literal", () => Reply.statusOf({ kind: "reply" }));
say("of what Object.create makes", () => Reply.statusOf(Object.create(Reply.prototype)));
say("of a proxy", () => Reply.statusOf(new Proxy(new Reply(), {})));
say("of null", () => Reply.statusOf(null));
say("of a number", () => Reply.statusOf(5));
say("has: an instance", () => Reply.has(new Reply()));
say("has: what Object.create makes", () => Reply.has(Object.create(Reply.prototype)));
say("of a frozen one", () => Reply.statusOf(Object.freeze(new Reply())));
say("stored into a frozen one", () => Reply.statusOf(Object.freeze(new Reply()).setStatus(7)));

const seen: Leaky[] = [];
class Leaky {
  #first: number | undefined;
  early = seen.push(this);
  #second: string | undefined;
  #third: number | undefined = Leaky.thirdOf(this, "while it is made");
  constructor(fails: boolean) {
    if (fails) throw new RangeError("no");
  }
  static firstOf(value: Leaky): unknown {
    return value.#first;
  }
  static secondOf(value: Leaky): unknown {
    return value.#second;
  }
  static thirdOf(value: Leaky, label: string): number | undefined {
    say(label, () => value.#third);
    return undefined;
  }
}
class Stops {
  #before: number | undefined;
  stop = Stops.fail(this);
  #behind: number | undefined;
  static kept: Stops | undefined;
  static fail(value: Stops): number {
    Stops.kept = value;
    throw new EvalError("stop");
  }
  static beforeOf(value: Stops): unknown {
    return value.#before;
  }
  static behindOf(value: Stops): unknown {
    return value.#behind;
  }
}
for (let turn = 0; turn < 3; turn++) {
  say("made", () => Leaky.secondOf(new Leaky(false)));
  say("fails", () => new Leaky(true));
  say("first of what failed", () => Leaky.firstOf(seen[seen.length - 1]!));
  say("second of what failed", () => Leaky.secondOf(seen[seen.length - 1]!));
  Leaky.thirdOf(seen[seen.length - 1]!, "third of what failed");
  say("stops", () => new Stops());
  say("before", () => Stops.beforeOf(Stops.kept!));
  say("behind", () => Stops.behindOf(Stops.kept!));
}

class Hands {
  constructor(value: object) {
    return value;
  }
}
class Stamp extends Hands {
  #mark: number | undefined;
  static markOf(value: object): unknown {
    return (value as Stamp).#mark;
  }
  static mark(value: object, mark: number): void {
    (value as Stamp).#mark = mark;
  }
}
const stamped = { a: 1 };
say("before the stamp", () => Stamp.markOf(stamped));
new Stamp(stamped);
say("behind the stamp", () => Stamp.markOf(stamped));
Stamp.mark(stamped, 9);
say("marked", () => Stamp.markOf(stamped));
say("stamped twice", () => new Stamp(stamped));
const reply = new Reply();
new Stamp(reply);
say("an instance of another class, stamped", () => [Stamp.markOf(reply), Reply.statusOf(reply), reply.status()]);

class Below extends Reply {
  #status: string | undefined;
