//// methods-as-values.ts
// Private methods used as values: where the first read happens (a loop, a `try`, a branch) makes no difference to their identity.
declare const console: { log(...a: unknown[]): void };
function said(f: () => unknown): string { try { return String(f()); } catch (e) { return "threw " + (e as Error).name; } }
function row(label: string, f: () => unknown): void { console.log(label + ": " + said(f)); }
const collect: () => void = (globalThis as any).gc ?? (() => (globalThis as any).Bun.gc(true));

function make(n: number) {
  return class P {
    static #m() { return n; }
    static #heard() { P.log.push("fired " + n); }
    static log: string[] = [];
    static get() { return P.#m; }
    static firstInLoop() { const fs: unknown[] = []; for (let i = 0; i < 5; i++) fs.push(P.#m); return fs.every(f => f === fs[0]) && fs[4] === P.get(); }
    static firstInTry() { let f, g, h; try { f = P.#m; throw 1; } catch { g = P.#m; } finally { h = P.#m; } return f === g && g === h && h === P.get(); }
    static firstInBranch(c: boolean) { let a; if (c) a = P.#m; const b = P.#m; return (c ? a === b : a === undefined) && b === P.get(); }
    static firstDropped() { P.#m; (P.#m as any).k = 1; return (P.#m as any).k; }
    static firstOnlyCompared() { return P.#m === P.#m && P.#m === P.get(); }
    static firstOnlyTested() { return typeof P.#m + " " + (P.#m === P.get()); }
    static acrossCollection() { (P.#m as any).k = 7; collect(); collect(); return (P.#m as any).k; }
    static hot() { const f = P.get(); let bad = 0; for (let i = 0; i < 100000; i++) if (P.get() !== f || P.#m !== f) bad++; return bad; }
    static *suspended() { const a = P.#m; yield 1; const b = P.#m; yield a === b && b === P.get(); }
    static async awaited() { const a = P.#m; await null; const b = P.#m; return a === b && b === P.get(); }
    static listen(s: Set<() => void>) { s.add(P.#heard); s.delete(P.#heard); return s.size; }
    static count() { return (P.#m as any).calls = ((P.#m as any).calls || 0) + 1; }
    static assigned() { Object.assign(P.#m, { k: 7 }); return "k" in P.#m; }
    static frozen() { Object.freeze(P.#m); return Object.isFrozen(P.#m); }
    static inCallback() { return [1, 2, 3].map(() => P.#m).every(f => f === P.#m); }
    static bound() { return P.#m.bind(null)() + " " + (P.#m.bind(null) === P.#m.bind(null)); }
  };
}
