//// a-private-field-is-read-from-values-that-are-no-instances.ts
// A static method with a typed parameter returns a private field of it. Through `any` it also gets an object from JSON.parse, a literal, null and undefined: each of those reads throws a TypeError, as in plain Bun.
class Safe {
  #code = 42;
  static codeOf(safe: Safe): number {
    return safe.#code;
  }
}

const parsed: Safe = JSON.parse("{}");
const others: any[] = [new Safe(), parsed, {}, null, undefined];
console.log(Safe.codeOf(new Safe()));
for (const other of others) {
  try {
    console.log(Safe.codeOf(other));
  } catch (error) {
    console.log(error instanceof TypeError);
  }
}

export {};
//// a-private-name-is-asked-for-in-objects-that-gain-it-later.ts
// `#name in value` for values of every kind, again and again, while ordinary objects gain the name by a constructor that returns them, turn into dictionaries, or belong to another evaluation of the class.
const lines: string[] = [];
function say(label: string, value: unknown): void {
  lines.push(label + ": " + String(value));
}

class Branded {
  #brand = 1;
  static is(value: object): boolean {
    return #brand in value;
  }
}

const Returns = function (this: unknown, value: object): object {
  return value;
} as unknown as new (value: object) => object;
class Stamp extends Returns {
  #mark = 7;
  #method(): number {
    return this.#mark;
  }
  static has(value: object): boolean {
    return #mark in value;
  }
  static hasMethod(value: object): boolean {
    return #method in value;
  }
  static read(value: object): number {
    return (value as Stamp).#method();
  }
}

function makeClass() {
  return class Evaluated extends Returns {
    #own = 1;
    static has(value: object): boolean {
      return #own in value;
    }
  };
}
const First = makeClass();
const Second = makeClass();

const plain = { a: 1 };
const sameShape = { a: 2 };
const list = [1, 2];
const sameList = [3, 4];
const fn = function () {};
const proxy = new Proxy({ a: 1 }, {});
const frozen = Object.freeze({ a: 3 });
const bare = Object.create(null) as object;
const dictionary: Record<string, number> = {};
for (let i = 0; i < 200; i++) dictionary["k" + i] = i;
for (let i = 0; i < 150; i++) delete dictionary["k" + i];
const map = new Map<number, number>();
const all: object[] = [new Branded(), plain, sameShape, list, sameList, fn, proxy, frozen, bare, dictionary, map, new Branded()];

function ask(): string {
  let text = "";
  for (const value of all) text += (Branded.is(value) ? "B" : "-") + (Stamp.has(value) ? "S" : "-") + (Stamp.hasMethod(value) ? "M" : "-") + (First.has(value) ? "1" : "-") + (Second.has(value) ? "2" : "-") + " ";
  return text;
}
let last = "";
for (let turn = 0; turn < 40; turn++) last = ask();
say("before", last);

new Stamp(plain);
say("one of two objects of a shape is stamped", ask());
say("read", Stamp.read(plain));
new Stamp(list);
say("one of two arrays", ask());
new Stamp(dictionary);
say("a dictionary", ask());
new Stamp(proxy);
new Stamp(fn);
new Stamp(bare);
new Stamp(map);
say("a proxy, a function, an object below nothing, a map", ask());
new First(sameShape);
say("the first evaluation", ask());
new Second(sameShape);
new Second(sameList);
say("the second evaluation", ask());
say("a frozen object", (() => {
  try {
    new Stamp(frozen);
    return ask();
  } catch (error) {
    return (error as Error).constructor.name + " " + ask();
  }
})());
say("twice", (() => {
  try {
    new Stamp(plain);
    return "stamped again";
  } catch (error) {
    return (error as Error).constructor.name;
  }
})());
say("no object", (() => {
  try {
    return Branded.is(1 as unknown as object);
  } catch (error) {
    return (error as Error).constructor.name;
  }
})());
// Many shapes in turn: more than anything remembers.
let count = 0;
for (let turn = 0; turn < 400; turn++) {
  const value: Record<string, number> = {};
  value["p" + (turn % 37)] = turn;
  if (turn % 5 === 0) new Stamp(value);
  if (Stamp.has(value)) count++;
  if (Branded.is(value)) count += 1000;
}
say("many shapes", count);
console.log(lines.join("\n"));
//// accessors.ts
// Private accessors: reading one that has only a setter and writing one that has only a getter throw, in every kind of expression.
declare const console: { log(...a: unknown[]): void };
function said(f: () => unknown): string { try { return String(f()); } catch (e) { return "threw " + (e as Error).name; } }
function row(label: string, f: () => unknown): void { console.log(label + ": " + said(f)); }
const collect: () => void = (globalThis as any).gc ?? (() => (globalThis as any).Bun.gc(true));

function make(n: number) {
  return class C {
    static log: string[] = [];
    static #kept = n;
    static set #w(v: number) { C.log.push("set " + v + " " + (this === C)); C.#kept = v; }
    static get #r() { C.log.push("get " + (this === C)); return C.#kept; }
    static get #rw() { C.log.push("get"); return C.#kept; }
    static set #rw(v: number) { C.log.push("set " + v); C.#kept = v; }
    static rows(label: string) {
      const t = (what: string, f: () => unknown) => { C.log.length = 0; const r = said(f); console.log(label + " " + what + ": " + r + " [" + C.log.join() + "] " + C.#kept); };
      t("read of a setter alone", () => (C as any).#w);
      t("read of a setter alone on this", () => C.readOnThis());
      t("typeof a setter alone", () => typeof (C as any).#w);
      t("a setter alone called", () => (C as any).#w());
      t("a setter alone as a tag", () => (C as any).#w`a`);
      t("a setter alone +=", () => (C as any).#w += 1);
      t("a setter alone ++", () => (C as any).#w++);
      t("a setter alone ??=", () => (C as any).#w ??= 5);
      t("a setter alone ||=", () => (C as any).#w ||= 5);
      t("a setter alone &&=", () => (C as any).#w &&= 5);
      t("a setter alone =", () => C.#w = 4);
      t("a setter alone in a pattern", () => { [C.#w] = [8]; });
      t("a setter alone in", () => #w in C);
      t("a getter alone read", () => C.#r);
      t("a getter alone =", () => (C as any).#r = 4);
      t("a getter alone +=", () => (C as any).#r += 1);
      t("a getter alone ++", () => (C as any).#r++);
      t("a getter alone ||=", () => (C as any).#r ||= 5);
      t("a getter alone &&=", () => (C as any).#r &&= 5);
      t("a getter alone ??=", () => (C as any).#r ??= 5);
      t("a getter alone in a pattern", () => { [(C as any).#r] = [8]; });
      t("both read", () => C.#rw);
      t("both =", () => C.#rw = 6);
      t("both +=", () => C.#rw += 1);
      t("both ++", () => C.#rw++);
      t("both prefix --", () => --C.#rw);
      t("both ||=", () => C.#rw ||= 5);
      t("both &&=", () => C.#rw &&= 5);
      t("both ??=", () => C.#rw ??= 5);
    }
    static readOnThis() { return (this as any).#w; }
  };
}
make(1).rows("first");
make(20).rows("second");
class T {
  static set #w(v: number) {}
  static get #r() { return 1; }
  static #m() {}
  static {
    row("top read of a setter alone", () => (T as any).#w);
    row("top a setter alone +=", () => (T as any).#w += 1);
    row("top a getter alone =", () => (T as any).#r = 1);
  }
}
