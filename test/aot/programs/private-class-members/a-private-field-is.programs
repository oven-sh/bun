}
make(1).rows();
make(2).rows();
class T {
  static #m(...a) { return "m " + who(this, T) + " " + a.length; }
  static #f = function (...a) { return "f " + who(this, T) + " " + a.length; };
  static get #g() { return function (...a) { return "g " + who(this, T) + " " + a.length; }; }
  static x = T.#m`a`;
  static y = T.#f`a`;
