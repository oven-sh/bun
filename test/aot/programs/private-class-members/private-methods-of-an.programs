//// private-names-per-class-evaluation.js
// Every evaluation of a class creates new private names. One class declaration creates one set.
////= describeOutcome
function show(...parts) {
  console.log(parts.join(" | "));
}

function createBox(tag) {
  return class Box {
    shown = tag;
    #value = tag;
    #method() {
      return "method " + this.#value;
    }
    get #accessor() {
      return "accessor " + this.#value;
    }
    static #count = 0;
    static has(o) {
      return [#value in o, #method in o, #accessor in o].join();
    }
    static hasStatic(o) {
      return #count in o;
    }
    static read(o) {
      return o.#value;
    }
    static write(o, value) {
      o.#value = value;
      return o.#value;
    }
    static call(o) {
      return o.#method();
    }
    static readAccessor(o) {
      return o.#accessor;
    }
    static methodOf(o) {
      return o.#method;
    }
    static increment() {
      return ++this.#count;
    }
  };
}

const classes = [createBox("first"), createBox("second"), createBox("third")];
const instances = classes.map(Box => new Box());
for (let i = 0; i < classes.length; i++) {
  for (let j = 0; j < instances.length; j++) {
    const Box = classes[i];
    const o = instances[j];
    show(
      "class " + i + " on instance " + j,
      Box.has(o),
      describeOutcome(() => Box.read(o)),
      describeOutcome(() => Box.call(o)),
      describeOutcome(() => Box.readAccessor(o)),
      describeOutcome(() => Box.write(o, "written " + i)),
      Box.hasStatic(classes[j]),
    );
  }
}

const sites = [];
for (let i = 0; i < 100; i++) {
  const Box = classes[i % 3];
  const o = instances[(i + 1) % 3];
  sites.push([Box.has(o), describeOutcome(() => Box.read(o))].join(" "));
}
show("one site over three evaluations", [...new Set(sites)].join(" / "));

show("one method per evaluation", classes[0].methodOf(instances[0]) === classes[0].methodOf(new classes[0]()));
show("methods differ between evaluations", classes[0].methodOf(instances[0]) === classes[1].methodOf(instances[1]));
show("one static field per evaluation", classes[0].increment(), classes[0].increment(), classes[1].increment(), classes[2].increment());

for (let i = 0; i < classes.length; i++) {
  const o = instances[i];
  show(
    "inspected",
    Bun.inspect(classes[i]),
    Bun.inspect(o),
    Reflect.ownKeys(o).join(),
    Object.getOwnPropertySymbols(o).length,
    JSON.stringify(o),
  );
}

const loopClasses = [];
for (let i = 0; i < 3; i++) {
  loopClasses.push(
    class {
      #number = i;
      static read(o) {
        return o.#number;
      }
    },
  );
}
for (let i = 0; i < 3; i++) {
  show(
    "class " + i + " of a loop",
    describeOutcome(() => loopClasses[i].read(new loopClasses[0]())),
    describeOutcome(() => loopClasses[i].read(new loopClasses[1]())),
    describeOutcome(() => loopClasses[i].read(new loopClasses[2]())),
  );
}

class Once {
  shown = "once";
  #value = "declared once";
  #method() {
    return this.#value + " method";
  }
  static has(o) {
    return [#value in o, #method in o].join();
  }
  static read(o) {
    return o.#value + ", " + o.#method();
  }
}
function createOnce() {
  return new Once();
}
const once = [createOnce(), createOnce(), createOnce()];
for (const o of once) show("declared once", Once.has(o), describeOutcome(() => Once.read(o)), Bun.inspect(o));
show("declared once, other objects", Once.has({}), describeOutcome(() => Once.read({})), Once.has(instances[0]), describeOutcome(() => Once.read(instances[0])));
//// private-set-on-returned-object.js
// A private field added to objects a base constructor returned: no slot, so every access goes by key.
class Base {
  constructor(target) {
    return target;
  }
}

class Derived extends Base {
  #x = 0;
  static get(object) {
    return object.#x;
  }
  static set(object, value) {
    object.#x = value;
  }
  static has(object) {
    return #x in object;
  }
}

const errorNameOf = action => {
  try {
    action();
    return "no error";
  } catch (error) {
    return error.name;
  }
};

const objectWithoutField = {};
console.log("set before", errorNameOf(() => Derived.set(objectWithoutField, 1)), Derived.has(objectWithoutField));

const first = {};
new Derived(first);
console.log("added twice before", errorNameOf(() => new Derived(first)));

const values = [];
let present = 0;
for (let i = 0; i < 100; i++) {
  const object = i % 2 ? { a: i } : {};
  if (Derived.has(object)) present--;
  new Derived(object);
  Derived.set(object, i);
  Derived.set(object, Derived.get(object) + 1);
  if (Derived.has(object)) present++;
  values.push(Derived.get(object));
}
console.log(values.join(" "));
console.log("present", present);

const repeated = {};
new Derived(repeated);
for (let i = 0; i < 100; i++) Derived.set(repeated, i);
console.log("repeated", Derived.get(repeated), Object.keys(repeated).length);
console.log("added twice after", errorNameOf(() => new Derived(repeated)), Derived.get(repeated));
console.log("set after", errorNameOf(() => Derived.set(objectWithoutField, 1)), Derived.has(objectWithoutField));
console.log("get after", errorNameOf(() => Derived.get(objectWithoutField)));
//// same-private-name-in-two-classes.ts
// Top-level classes declare private fields, methods, accessors and statics with the same names. Each class finds only its own members.
function attempt(f: () => unknown): string { try { return String(f()); } catch (e) { return "threw " + (e as Error).name; } }
const collect: () => void = (globalThis as any).gc ?? (() => (globalThis as any).Bun.gc(true));

interface Probe {
  has(o: any): boolean;
  hasEach(o: any): string;
  read(o: any): number;
  write(o: any, v: number): number;
  call(o: any): string;
  readAccessor(o: any): string;
  writeAccessor(o: any, v: string): void;
  readStatic(o: any): string;
}

////= lines	A	1	"A.#m "	"A.#g "	"A.#s"
////= lines	B	2	"B.#m "	"B.#g "	"B.#s"

console.log("has", A.has(new B()), B.has(new A()), A.has(new A()), B.has(new B()));
console.log("read", attempt(() => A.read(new B())), attempt(() => B.read(new A())), attempt(() => A.read(new A())), attempt(() => B.read(new B())));
console.log("typed read", attempt(() => A.readTyped(new B() as any)), attempt(() => B.readTyped(new A() as any)), A.readTyped(new A()), B.readTyped(new B()));

class C extends A {
  #x = 3;
  #m(): string { return "C.#m " + this.#x; }
  get #g(): string { return "C.#g " + this.#x; }
  set #g(v: string) { this.#x = v.length; }
  static #s = "C.#s";
  static has(o: any): boolean { return #x in o; }
  static hasEach(o: any): string { return [#x in o, #m in o, #g in o, #s in o].join(); }
  static read(o: any): number { return o.#x; }
  static write(o: any, v: number): number { return o.#x = v; }
  static call(o: any): string { return o.#m(); }
  static readAccessor(o: any): string { return o.#g; }
  static writeAccessor(o: any, v: string): void { o.#g = v; }
  static readStatic(o: any): string { return o.#s; }
}

const probes: [string, Probe][] = [["A", A], ["B", B], ["C", C]];
const values: [string, () => any][] = [
  ["an A", () => new A()],
  ["a B", () => new B()],
  ["a C", () => new C()],
  ["class A", () => A],
  ["class B", () => B],
  ["class C", () => C],
  ["an object", () => ({})],
  ["an object that inherits from an A", () => Object.create(new A())],
  ["a proxy of an A", () => new Proxy(new A(), {})],
  ["a number", () => 1],
  ["null", () => null],
];
function report(): void {
  for (const [name, probe] of probes) {
    for (const [title, create] of values) {
      console.log(name, "with", title + ":", [
        attempt(() => probe.has(create())),
        attempt(() => probe.hasEach(create())),
        attempt(() => probe.read(create())),
        attempt(() => probe.write(create(), 7)),
        attempt(() => probe.call(create())),
        attempt(() => probe.readAccessor(create())),
        attempt(() => probe.writeAccessor(create(), "four")),
        attempt(() => probe.readStatic(create())),
      ].join(" | "));
    }
  }
}
report();

const both = new C();
console.log("both", A.read(both), C.read(both), attempt(() => B.read(both)));
A.write(both, 10);
console.log("both", A.read(both), C.read(both), A.call(both), C.call(both));
C.writeAccessor(both, "twelve chars");
console.log("both", A.read(both), C.read(both), A.readAccessor(both), C.readAccessor(both));
collect();
console.log("both", A.read(both), C.read(both), attempt(() => B.write(both, 1)), A.hasEach(both), B.hasEach(both), C.hasEach(both));
report();
//// static-async-constructor-method-awaits.js
// `static async constructor() {}` is a static async method named `constructor`: it may await, returns a promise and cannot be constructed.
class Adds {
  static async constructor(x) {
    const value = await x;
    return value + 1;
  }
}
class Both {
  constructor() {
    this.made = true;
  }
  static async constructor() {
    await null;
    return new Both().made;
  }
}
const results = [];
results.push(Adds.constructor(Promise.resolve(1)) instanceof Promise);
results.push(await Adds.constructor(Promise.resolve(1)));
results.push(await Both.constructor());
results.push(Object.getPrototypeOf(Adds.constructor) === Object.getPrototypeOf(async function () {}));
results.push(Adds.constructor.name, Adds.constructor.length, "prototype" in Adds.constructor);
try {
  new Adds.constructor();
} catch (error) {
  results.push(error.name);
}
console.log(results.join("\n"));
//// static-constructor-method-before-constructor.js
// A static method named `constructor` written before the real constructor.
function t() {
  class C {
    static constructor() {}
    constructor() {}
  }
  console.log("own: " + C.hasOwnProperty("constructor"));
  console.log("differ: " + (C.prototype.constructor !== C.constructor));
}
t();
class D {
  static constructor() {}
  constructor() {}
}
console.log("own: " + D.hasOwnProperty("constructor"));
console.log("differ: " + (D.prototype.constructor !== D.constructor));
//// static-constructor-method-in-function.js
// A static method named `constructor` in a class expression that a function returns.
function said(f) { try { const v = f(); return typeof v === "function" ? "F" : String(v); } catch (e) { return "threw " + e.name; } }
function row(label, f) { console.log(label + ": " + said(f)); }
let calls = 0;
function make() { return class C { static constructor() { calls++; return "static"; } }; }
function makeAsync() { return class C { static async constructor() { calls++; return "later"; } }; }
row("own property", () => Object.hasOwn(make(), "constructor") + " " + Object.hasOwn(makeAsync(), "constructor"));
row("new does not run it", () => { const K = make(); new K(); return calls; });
row("called", () => make().constructor() + " " + calls);
row("the prototype's constructor", () => { const K = make(); return K.prototype.constructor === K; });
row("async", () => typeof makeAsync().constructor().then);
//// static-constructor-method-with-constructor.js
// A class with both a constructor and a static method named `constructor`: `new` runs the real constructor.
function said(f) { try { const v = f(); return typeof v === "function" ? "F" : String(v); } catch (e) { return "threw " + e.name; } }
function row(label, f) { console.log(label + ": " + said(f)); }
let calls = 0;
class Both { constructor(v) { this.made = v; } static constructor() { calls++; return "static"; } }
class Alone { static constructor() { calls++; return "alone"; } }
class Async { constructor() { this.made = 1; } static async constructor() { return "later"; } }
class Quoted { constructor() { this.made = 2; } static "constructor"() { return "quoted"; } }
class Heir extends Both { static constructor() { return "heir " + super.constructor(); } }
row("new runs the constructor", () => new Both(5).made + " " + calls);
row("the static method", () => Both.constructor() + " " + calls);
row("it is the class's own property", () => Object.hasOwn(Both, "constructor") + " " + Object.hasOwn(Alone, "constructor"));
row("the prototype's constructor is the class", () => (Both.prototype.constructor === Both) + " " + (Alone.prototype.constructor === Alone));
row("new of a class that has only the static one", () => Object.keys(new Alone()).length + " " + calls + " " + (new Alone() instanceof Alone));
row("the static one alone", () => Alone.constructor() + " " + calls);
row("it cannot be constructed", () => new Both.constructor());
row("its name and length", () => Both.constructor.name + " " + Both.constructor.length + " " + Both.length);
row("async", () => new Async().made + " " + typeof Async.constructor().then);
row("quoted", () => new Quoted().made + " " + Quoted.constructor());
row("an heir", () => Heir.constructor() + " " + new Heir(6).made);
