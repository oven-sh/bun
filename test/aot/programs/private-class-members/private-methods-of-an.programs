////: look
function look(label«1») {
  row(label + " same", () => K.same() && K.m() === K.m());
  row(label + " not one seen before", () => seen.every(f => f !== K.m()));
  row(label + " brand", () => K.has(K) + " " + seen.length);
  row(label + " count", () => K.count() + " " + K.count());
  seen.push(K.m());
}
//// private-methods-of-an-open-class.ts
// A call of a private method on a class that also takes untyped objects tests the shape and calls the method directly; an untyped heir and an object without the method take the general path.
class Pool {
  served = 0;
  #next(): boolean {
    this.served++;
    return this.served < 3;
  }
  #drain(): void {
    while (this.#next());
  }
  drain(): number {
    this.#drain();
    return this.served;
  }
  static drainOf(other: Pool): number {
    other.#drain();
    return other.served;
  }
}
const Untyped: any = Pool;
////= lines-2	Heir	Untyped	1
const taken: any[] = [new Heir(), new Pool()];
const heir = taken[0] as Pool;
const pool = taken[1] as Pool;
console.log(heir.drain(), pool.drain());
for (const other of [{ served: 0 }, null, undefined, 1]) {
  try {
    console.log(Pool.drainOf(other as any));
  } catch (error) {
    console.log((error as Error).name);
  }
}
//// private-methods-reach-untyped-heirs.ts
// An object that a class with a fixed layout constructs for another new.target has that class's private methods and accessors, as ECMAScript installs them; an object that the class did not construct has none.
class Base {
  total = 0;
  #add(amount: number): number {
    this.total += amount;
    return this.total;
  }
  get #doubled(): number {
    return this.total * 2;
  }
  set #doubled(value: number) {
    this.total = value / 2;
  }
  run(): string {
    this.#add(2);
    this.#doubled = this.#doubled + 2;
    return `${this.total} ${#add in this} ${#doubled in this}`;
  }
  static has(other: object): boolean {
    return #add in other;
  }
}
class Derived extends Base {
  #label(): string {
    return "derived";
  }
  describe(): string {
    return `${this.#label()} ${this.run()}`;
  }
  static has(other: object): boolean {
    return #label in other;
  }
}
class Unrelated {
  #hidden(): number {
    return 1;
  }
  static has(other: object): boolean {
    return #hidden in other;
  }
}
const UntypedBase: any = Base;
const UntypedDerived: any = Derived;
////= lines-2	HeirOfBase	UntypedBase	1
////= lines-2	HeirOfDerived	UntypedDerived	2
class HeirOfHeir extends HeirOfDerived {}
function attempt(name: string, action: () => unknown): void {
  try {
    console.log(name, action());
  } catch (error) {
    console.log(name, (error as Error).name);
  }
}
attempt("base", () => new Base().run());
attempt("derived", () => new Derived().describe());
attempt("heir of base", () => (new HeirOfBase() as any).run());
attempt("heir of derived", () => (new HeirOfDerived() as any).describe());
attempt("heir of heir", () => (new HeirOfHeir() as any).describe());
attempt("heir of base has derived's", () => Derived.has(new HeirOfBase()));
attempt("heir of derived has both", () => `${Base.has(new HeirOfDerived())} ${Derived.has(new HeirOfDerived())}`);
const forFunction: any = Reflect.construct(Base, [], function Other() {});
attempt("another new.target", () => `${forFunction.run === undefined} ${Base.prototype.run.call(forFunction)}`);
const forUnrelated: any = Reflect.construct(Base, [], Unrelated);
attempt("an unrelated class as new.target", () => `${Base.has(forUnrelated)} ${Unrelated.has(forUnrelated)} ${Base.prototype.run.call(forUnrelated)}`);
attempt("only the prototype", () => (Object.create(Base.prototype) as Base).run());
attempt("only the heir's prototype", () => Object.create(HeirOfBase.prototype).run());
attempt("a look-alike", () => Base.prototype.run.call({ total: 0 } as any));
//// private-names-are-found-again-by-the-shape-of-a-native-object.ts
// An instance of a class with a built-in parent, and an object that a constructor returned, keep a private name as a property. The run time remembers where the name lies for the
// shapes it has met. What it remembers says nothing about which evaluation of the class an object belongs to, about an object of another shape, or about a name that is defined twice.
const lines: string[] = [];
function attempt(label: string, run: () => unknown): void {
  try { lines.push(label + ": " + String(run())); } catch (error) { lines.push(label + ": threw " + (error as Error).constructor.name); }
}

class Failure extends Error {
  #code: number;
  #notes: string[] = [];
  extra = 1;
  constructor(code: number) { super("failure " + code); this.#code = code; }
  code(): number { return this.#code; }
  bump(): number { this.#code += 1; return this.#code; }
  note(text: string): number { this.#notes.push(text); return this.#notes.length; }
  static codeOf(value: unknown): number { return (value as Failure).#code; }
  static has(value: object): boolean { return #code in value; }
}
class Deeper extends Failure { more = 2; #own = "deep"; own(): string { return this.#own + this.code(); } }
class Table extends Map<string, number> { #reads = 0; read(key: string): number { this.#reads++; return (this.get(key) ?? -1) + this.#reads; } }
class List extends Array<number> { #sum = 0; add(value: number): number { this.push(value); this.#sum += value; return this.#sum; } }

const failures = [new Failure(1), new Failure(2), new Deeper(3)];
for (let round = 0; round < 4; ++round) {
  for (const failure of failures) attempt("round " + round, () => failure.code() + "," + failure.bump() + "," + failure.note("n" + round) + "," + Failure.codeOf(failure));
}
attempt("deeper", () => (failures[2] as Deeper).own());
const table = new Table([["a", 10]]), list = new List();
for (let round = 0; round < 4; ++round) attempt("table and list " + round, () => table.read("a") + "," + table.read("b") + "," + list.add(round + 1) + "," + list.length);

// The same shape, another evaluation of the class.
function makeClass() {
  return class Stamped extends Error {
    #mark: number;
    constructor(mark: number) { super("stamped"); this.#mark = mark; }
    static read(value: unknown): number { return (value as Stamped).#mark; }
    static write(value: unknown, mark: number): number { return (value as Stamped).#mark = mark; }
  };
}
const First = makeClass(), Second = makeClass();
const first = new First(10), second = new Second(20);
for (let round = 0; round < 3; ++round) {
  attempt("first by First", () => First.read(first));
  attempt("second by Second", () => Second.read(second));
  attempt("second by First", () => First.read(second));
  attempt("first by Second", () => Second.read(first));
  attempt("store second by First", () => First.write(second, 1));
  attempt("store first by First", () => First.write(first, 11 + round));
}

// Objects of many shapes get the name from a constructor that returns them.
class Returns { constructor(value: object) { return value; } }
class Stamp extends Returns {
  #seal = 7;
  constructor(value: object) { super(value); }
  static seal(value: object): number { return (value as Stamp).#seal; }
  static reseal(value: object, seal: number): void { (value as Stamp).#seal = seal; }
}
const shapes: object[] = [{}, { a: 1 }, { b: 1 }, { a: 1, b: 2 }, [1, 2], new Map(), new Error("e"), () => 1, new Date(0), { c: 1, d: 2, e: 3 }];
for (const shape of shapes) new Stamp(shape);
for (let round = 0; round < 3; ++round) attempt("seals " + round, () => shapes.map((shape, index) => { Stamp.reseal(shape, Stamp.seal(shape) + index); return Stamp.seal(shape); }).join());
attempt("no seal", () => Stamp.seal({ a: 1 }));
attempt("sealed twice", () => new Stamp(shapes[1]));

// The shape changes under the name.
const changing = new Failure(40) as Failure & Record<string, unknown>;
attempt("before", () => changing.code());
changing.added = 1;
attempt("a name more", () => changing.bump());
delete (changing as Record<string, unknown>).extra;
attempt("a name less", () => changing.bump());
for (let index = 0; index < 80; ++index) changing["k" + index] = index;
for (let index = 0; index < 80; index += 2) delete changing["k" + index];
attempt("many names come and gone", () => changing.bump() + "," + Failure.has(changing));
Object.freeze(changing);
attempt("frozen", () => changing.bump() + "," + changing.note("frozen"));
Object.setPrototypeOf(failures[0], null);
attempt("no prototype", () => Failure.codeOf(failures[0]) + "," + Failure.has(failures[0]));
attempt("a primitive", () => Failure.codeOf(5));
attempt("nothing", () => Failure.codeOf(undefined));
console.log(lines.join("\n"));
//// private-names-are-put-on-arrays-that-were-frozen-first.js
// A private name is no property, so an object that was frozen takes one: through a base constructor that answers the object it was handed. Arrays of every kind of storage stay frozen arrays behind it.
class Base { constructor(o) { return o; } }
class Stamp extends Base {
  #n = 1;
  #method() { return "method " + this.#n; }
  get #accessor() { return this.#n * 2; }
  constructor(o) { super(o); }
  static has(o) { return [#n in o, #method in o, #accessor in o].join(); }
  static touch(o) { return ++o.#n + " " + o.#method() + " " + o.#accessor; }
}
function said(f) { try { return f(); } catch (e) { return "threw " + e.constructor.name; } }
const makers = [["numbers", () => [1, 2]], ["doubles", () => [1.5, 2.5]], ["strings", () => ["a", "b"]], ["empty", () => []], ["holes", () => [1, , 3]], ["long", () => Array.from({ length: 100 }, (_, i) => i)]];
for (const [title, create] of makers) {
  const o = Object.freeze(create());
  const before = JSON.stringify(o);
  console.log(title, said(() => new Stamp(o) === o), Stamp.has(o), said(() => Stamp.touch(o)), said(() => Stamp.touch(o)), said(() => new Stamp(o)));
  console.log(title, Object.isFrozen(o), Array.isArray(o), o.length, JSON.stringify(o) === before, Object.keys(o).length, Reflect.ownKeys(o).length, said(() => { "use strict"; o[0] = 9; return "stored"; }), said(() => { "use strict"; o.push(1); return "pushed"; }), said(() => { "use strict"; o.length = 0; return "cut"; }), said(() => { "use strict"; o.extra = 1; return "added"; }), said(() => { "use strict"; delete o[0]; return "deleted"; }));
  let total = 0;
  for (let i = 0; i < o.length; i++) total += typeof o[i] === "number" ? o[i] : 1;
  console.log(title, total, o.map(x => x).length, [...o].length, o.slice(1).length, o.indexOf(o[o.length - 1]), o.concat([1]).length);
}
//// private-names-in-computed-keys.ts
// Every kind of expression with a private name (read, store, call, `in`) inside a computed member key.
declare const console: { log(...a: unknown[]): void };
declare const JSON: { parse(s: string): any };
function said(f: () => unknown): string { try { const v = f(); return typeof v === "function" ? "F" : String(v); } catch (e) { return "threw " + (e as Error).name; } }
const lines: string[] = [];
const o: any = JSON.parse("{}");
const fn = Object.assign(() => 7, { toString() { return "fn"; } });
let later: [string, (x: any) => unknown][] = [];
let keys = 0;
function both(label: string, f: (x: any) => unknown): string { lines.push(label + ", ahead: " + said(() => f(o))); later.push([label, f]); return "k" + ++keys; }
function afterwards(where: string, C: any) { for (const [label, f] of later) lines.push(where + " " + label + ", behind, of the class: " + said(() => f(C)) + "; of another: " + said(() => f(o))); later = []; }
class Top {
  static #f: any = fn;
  [both("top read", (x: any) => x.#f)]() {}
  [both("top typeof", (x: any) => typeof x.#f)]() {}
  [both("top call", (x: any) => x.#f())]() {}
  [both("top in", (x: any) => #f in x)]() {}
  [both("top compared", (x: any) => x.#f === x.#f)]() {}
  [both("top a template tag", (x: any) => x.#f`t`)]() {}
  [both("top called in parentheses", (x: any) => (x.#f)())]() {}
  [both("top an optional call", (x: any) => x.#f?.())]() {}
  [both("top in an array", (x: any) => [x.#f].length)]() {}
  [both("top an argument", (x: any) => String(x.#f))]() {}
  [both("top spread", (x: any) => [...[x.#f]].length)]() {}
  [both("top a condition", (x: any) => x.#f ? 1 : 2)]() {}
  [both("top negated", (x: any) => !x.#f)]() {}
  [both("top store", (x: any) => x.#f = fn)]() {}
  [both("top add", (x: any) => x.#f += 1)]() {}
  [both("top increment", (x: any) => x.#f++)]() {}
  [both("top decrement ahead", (x: any) => --x.#f)]() {}
  [both("top or", (x: any) => x.#f ||= fn)]() {}
  [both("top and", (x: any) => x.#f &&= fn)]() {}
  [both("top nullish", (x: any) => x.#f ??= fn)]() {}
  [both("top an array pattern", (x: any) => ([x.#f] = [fn]).length)]() {}
  [both("top an object pattern", (x: any) => ({ a: x.#f } = { a: fn }).a === fn)]() {}
  [both("top a pattern with a default", (x: any) => ([x.#f = fn] = []).length)]() {}
  [both("top a rest element", (x: any) => ([...x.#f] = [1]).length)]() {}
  [both("top a for-of head", (x: any) => { for (x.#f of [fn]); return "done"; })]() {}
  [both("top a for-in head", (x: any) => { for (x.#f in { a: 1 }); x.#f = fn; return "done"; })]() {}
}
afterwards("top", Top);
