//// static-names-in-keys-reevaluated-class-typed.ts
// Computed member keys use static private names of their own class, in a class expression that is evaluated more than once, with type annotations.
declare const console: { log(...a: unknown[]): void };
declare const JSON: { parse(s: string): any };
function said(f: () => unknown): string { try { const v = f(); return typeof v === "function" ? "F" : String(v); } catch (e) { return "threw " + (e as Error).name; } }
const lines: string[] = [];
function row(label: string, f: () => unknown): string { lines.push(label + ": " + said(f)); return "k" + lines.length; }
const o: any = JSON.parse("{}");
const later: any[] = [];
function field(n: number) { return class C { static #f = n; [row("a field read of another object " + n, () => o.#f)]() {} [row("stored " + n, () => (o.#f = 2))]() {} [row("in " + n, () => #f in o)]() {} static get() { return C.#f; } }; }
function method(n: number) { return class C { static #m() { return n; } [row("in, a method " + n, () => #m in o)]() {} [row("in, of what is no object " + n, () => #m in (1 as any))]() {} [(later.push((x: any) => x.#m, (x: any) => #m in x), "k")]() {} }; }
function behind(n: number) { return class C { [row("ahead of the name " + n, () => #f in o)]() {} [row("read ahead of the name " + n, () => o.#f)]() {} static #f = n; }; }
const F1 = field(1), F2 = field(2), M1 = method(1), M2 = method(2);
behind(1);
for (let i = 0; i < 2; i++) { class L { static #f = i; [row("in a loop " + i, () => (#f in o) + " " + said(() => o.#f))]() {} } }
row("an earlier evaluation, asked in the key of a later one", () => { let first: any; function make() { return class C { static #f = 1; [row("  inside", () => first ? (#f in first) + " " + said(() => first.#f) : "none")]() {} }; } first = make(); make(); return "made"; });
row("behind the declaration", () => F1.get() + " " + F2.get());
row("arrows made in keys, called later", () => said(() => later[0](M1)) + " " + said(() => later[0](M2)) + " " + later[1](M1) + " " + later[1](M2) + " " + said(() => later[2](M2)) + " " + later[3](M1));
for (const line of lines) console.log(line);
//// static-names-in-own-class-keys.js
// Computed member keys use static private names of the class that is being defined.
function said(f) { try { const v = f(); return typeof v === "function" ? "F" : String(v); } catch (e) { return "threw " + e.name; } }
const lines = [];
function row(label, f) { lines.push(label + ": " + said(f)); return "k" + lines.length; }
const o = JSON.parse("{}");
let later = [];
class Field { static #f = 1; [row("a field read of another object", () => o.#f)]() {} [row("a field stored to another object", () => (o.#f = 2))]() {} [row("in, a field", () => #f in o)]() {} }
class Method { static #m() { return 7; } [row("in, a method", () => #m in o)]() {} [row("in, of what is no object", () => #m in 1)]() {} [(later.push((x) => x.#m, (x) => #m in x), "k")]() {} static self() { return Method; } }
class Accessor { static get #g() { return 8; } static set #g(v) {} [row("in, an accessor", () => #g in o)]() {} [(later.push((x) => x.#g, (x) => (x.#g = 1)), "k")]() {} }
class Behind { [row("ahead of the declaration of the name", () => #f in o)]() {} [row("read ahead of it", () => o.#f)]() {} static #f = 1; }
class Both { static #s = 1; #i = 2; [row("an instance name beside", () => o.#i)]() {} [row("and the static one", () => o.#s)]() {} static has(x) { return (#s in x) + " " + (#i in x); } }
class Heir extends Field { static #h = 1; [row("in an heir", () => (#h in o) + " " + (#h in Field))]() {} }
const Expr = class { static #e = 1; [row("in a class expression", () => #e in o)]() {} static has(x) { return #e in x; } };
{ class Block { static #b = 1; [row("in a block", () => (#b in o))]() {} } }
row("the methods are there", () => Object.getOwnPropertyNames(Field.prototype).join());
row("an arrow made in a key, called later: a method", () => said(() => later[0](Method)) + " " + said(() => later[0](o)) + " " + later[1](Method) + " " + later[1](o));
row("an arrow made in a key, called later: an accessor", () => said(() => later[2](Accessor)) + " " + said(() => later[2](o)) + " " + said(() => later[3](Accessor)) + " " + said(() => later[3](o)));
row("behind the declaration", () => Both.has(Both) + " " + Both.has(new Both()) + " " + Both.has(o) + " " + Expr.has(Expr) + " " + Expr.has(o));
for (const line of lines) console.log(line);
//// static-names-in-own-class-keys-typed.ts
// Computed member keys use static private names of the class that is being defined, with type annotations.
declare const console: { log(...a: unknown[]): void };
declare const JSON: { parse(s: string): any };
function said(f: () => unknown): string { try { const v = f(); return typeof v === "function" ? "F" : String(v); } catch (e) { return "threw " + (e as Error).name; } }
const lines: string[] = [];
function row(label: string, f: () => unknown): string { lines.push(label + ": " + said(f)); return "k" + lines.length; }
const o: any = JSON.parse("{}");
const later: any[] = [];
class Field { static #f = 1; [row("a field read of another object", () => o.#f)]() {} [row("a field stored to another object", () => (o.#f = 2))]() {} [row("in, a field", () => #f in o)]() {} }
class Method { static #m() { return 7; } [row("in, a method", () => #m in o)]() {} [row("in, of what is no object", () => #m in (1 as any))]() {} [(later.push((x: any) => x.#m, (x: any) => #m in x), "k")]() {} static self() { return Method; } }
class Accessor { static get #g() { return 8; } static set #g(v: number) {} [row("in, an accessor", () => #g in o)]() {} [(later.push((x: any) => x.#g, (x: any) => (x.#g = 1)), "k")]() {} }
class Behind { [row("ahead of the declaration of the name", () => #f in o)]() {} [row("read ahead of it", () => o.#f)]() {} static #f = 1; }
class Both { static #s = 1; #i = 2; [row("an instance name beside", () => o.#i)]() {} [row("and the static one", () => o.#s)]() {} static has(x: any) { return (#s in x) + " " + (#i in x); } }
class Heir extends Field { static #h = 1; [row("in an heir", () => (#h in o) + " " + (#h in Field))]() {} }
const Expr = class { static #e = 1; [row("in a class expression", () => #e in o)]() {} static has(x: any) { return #e in x; } };
{ class Block { static #b = 1; [row("in a block", () => (#b in o))]() {} } }
row("the methods are there", () => Object.getOwnPropertyNames(Field.prototype).join());
row("an arrow made in a key, called later: a method", () => said(() => later[0](Method)) + " " + said(() => later[0](o)) + " " + later[1](Method) + " " + later[1](o));
row("an arrow made in a key, called later: an accessor", () => said(() => later[2](Accessor)) + " " + said(() => later[2](o)) + " " + said(() => later[3](Accessor)) + " " + said(() => later[3](o)));
row("behind the declaration", () => Both.has(Both) + " " + Both.has(new Both()) + " " + Both.has(o) + " " + Expr.has(Expr) + " " + Expr.has(o));
for (const line of lines) console.log(line);
//// subclasses-of-a-class-with-private-names.js
// Subclasses of a class with private fields, methods and accessors: written out, made by a function, made twice, with private names of their own that are spelled like the base's. The base's members work on every instance and each class sees its own.
function said(f) { try { return String(f()); } catch (e) { return "threw " + e.name; } }
class K {
  #p = 7;
  a = 1;
  #m() { return this.#p + this.a; }
  get #g() { return "K getter " + this.#p; }
  read() { return this.#m() + " " + this.#g; }
  static has(o) { return #m in o; }
}
class Plain extends K { }
class Own extends K {
  #p = "own p";
  #m() { return "own m " + this.#p; }
  readOwn() { return this.#m(); }
  static has(o) { return #m in o; }
}
function make(tag) { return class extends K { b = tag; get() { return this.b; } }; }
const First = make("first"), Second = make("second");
for (const C of [K, Plain, Own, First, Second]) {
  const o = new C();
  console.log([said(() => o.read()), said(() => o.readOwn()), said(() => o.get()), K.has(o), Own.has(o), Object.keys(o).join("+")].join(" | "));
}
let total = 0;
for (let i = 0; i < 20000; i++) total += new (i & 1 ? First : Second)().read().length + new Own().readOwn().length;
console.log(total);
