  line = [self === a, a.next === a, a.next!.next!.next === a, chain(a, b).next === b, before, (h.item ? h.item.tag : "null") + "/" + (g.item ? g.item.tag : "null")].join();
}
console.log(line);

// A long chain built by a helper, one link a call: every link must live as long as the head.
let head: Item = { tag: "head" };
let tail = head;
for (let i = 0; i < 2000; i++) {
  const link: Item = { tag: "link" + i };
  chain(tail, link);
  tail = link;
}
churn(60);
let links = 0;
let lastTag = "";
for (let at: Item | null | undefined = head; at; at = at.next) {
  links++;
  lastTag = at.tag;
}
console.log(links, lastTag);

// The store goes into a closure's variable, and the closure is the parameter.
function feed(sink: (i: Item) => void, i: Item): void {
  sink(i);
}
function makeSink(): { sink: (i: Item) => void; last: () => Item | null } {
  let last: Item | null = null;
  return { sink: i => void (last = i), last: () => last };
}
const sinks = [makeSink(), makeSink()];
for (let i = 0; i < 300; i++) feed(sinks[i & 1].sink, { tag: "fed" + i });
console.log(churn(60), sinks.map(s => s.last()!.tag).join());
//// a-store-lands-in-one-of-two.ts
// `(first ? a : b).x = v` runs on every path and stores into one of the two. Whoever writes down "a.x is v when the call is over" for both has promised an object where a number stays. Every function here stores, deletes, freezes or appends through a name that stands for one of several objects; the callers read the other one.
////= churn
////= lines-2	Payload	n	tag	string
interface Box {
  x: number | Payload;
  tag: string;
}
const weigh = (x: number | Payload | undefined): number => (typeof x === "number" ? x + 1 : x === undefined ? -1000 : x.n * 1000);
const shared: Box = { x: 7, tag: "shared" };

function intoOneOfTwo(a: Box, b: Box, first: boolean, v: Payload): void {
  const o = first ? a : b;
  o.x = v;
}
function intoOneOrTheShared(a: Box, own: boolean, v: Payload): void {
  (own ? a : shared).x = v;
}
function intoOneOrTheFallback(a: Box | undefined, fallback: Box, v: Payload): void {
  const o = a ?? fallback;
  o.x = v;
}
function intoTheLastThatFits(list: Box[], a: Box, v: Payload): void {
  let o = a;
  for (const item of list) if (item.tag === "fits") o = item;
  o.x = v;
}
function intoOneOfThree(a: Box, b: Box, c: Box, which: number, v: Payload): void {
  let o: Box;
  switch (which) {
    case 0:
      o = a;
      break;
    case 1:
      o = b;
      break;
    default:
      o = c;
  }
  o.x = v;
}
function readBackOutOfOwn(first: boolean, v: Payload): number | Payload {
  const p: Box = { x: 3, tag: "p" };
  const q: Box = { x: 4, tag: "q" };
  (first ? p : q).x = v;
  return p.x;
}
////= returns	TheFirstOfOwn(first: boolean, v: Payload): Box	p
////= returns	BothOfOwn(first: boolean, v: Payload): [Box, Box]	[p, q]
function ownOrParameter(a: Box, own: boolean, v: Payload): Box {
  const p: Box = { x: 5, tag: "own" };
  (own ? p : a).x = v;
  return p;
}
function deletesFromOneOfTwo(a: Partial<Box>, b: Partial<Box>, first: boolean): void {
  delete (first ? a : b).x;
}
function freezesOneOfTwo(a: Box, b: Box, first: boolean): void {
  Object.freeze(first ? a : b);
}
function appendsToOneOfTwo(a: Payload[], b: Payload[], first: boolean, v: Payload): void {
  (first ? a : b).push(v);
}
function elementOfOneOfTwo(a: (number | Payload)[], b: (number | Payload)[], first: boolean, v: Payload): void {
  (first ? a : b)[0] = v;
}
class Holder {
  x: number | Payload = 9;
  intoThisOrTheOther(other: Holder, self: boolean, v: Payload): void {
    (self ? this : other).x = v;
  }
}
function twoStoresThatCross(a: Box, b: Box, first: boolean, v: Payload): void {
  const o = first ? a : b;
  const other = first ? b : a;
  o.x = v;
  other.x = 11;
}

let total = 0;
const seen: string[] = [];
for (let i = 0; i < 600; i++) {
  const first = i % 3 !== 0;
  const v: Payload = { n: i, tag: "v" + i };
  const a: Box = { x: 1, tag: "a" };
  const b: Box = { x: 2, tag: "b" };
  intoOneOfTwo(a, b, first, v);
  total += weigh(a.x) + weigh(b.x);
  const c: Box = { x: 1, tag: "c" };
  intoOneOrTheShared(c, first, v);
  total += weigh(c.x) + weigh(shared.x);
  shared.x = 7;
  const d: Box = { x: 1, tag: "d" };
  const fallback: Box = { x: 2, tag: "fallback" };
  intoOneOrTheFallback(first ? d : undefined, fallback, v);
  total += weigh(d.x) + weigh(fallback.x);
  const e: Box = { x: 1, tag: "e" };
  const inList: Box = { x: 2, tag: first ? "fits" : "does not" };
  intoTheLastThatFits([inList], e, v);
  total += weigh(e.x) + weigh(inList.x);
  const t0: Box = { x: 1, tag: "t0" };
  const t1: Box = { x: 2, tag: "t1" };
  const t2: Box = { x: 3, tag: "t2" };
  intoOneOfThree(t0, t1, t2, i % 3, v);
  total += weigh(t0.x) + weigh(t1.x) + weigh(t2.x);
  total += weigh(readBackOutOfOwn(first, v));
  total += weigh(returnsTheFirstOfOwn(first, v).x);
  const [p, q] = returnsBothOfOwn(first, v);
  total += weigh(p.x) + weigh(q.x);
  const f: Box = { x: 1, tag: "f" };
  total += weigh(ownOrParameter(f, first, v).x) + weigh(f.x);
  const g: Partial<Box> = { x: 1, tag: "g" };
  const h: Partial<Box> = { x: 2, tag: "h" };
  deletesFromOneOfTwo(g, h, first);
  total += weigh(g.x) + weigh(h.x);
  const j: Box = { x: 1, tag: "j" };
  const k: Box = { x: 2, tag: "k" };
  freezesOneOfTwo(j, k, first);
  try {
    j.x = 20;
  } catch {
    total += 5;
  }
  try {
    k.x = 30;
  } catch {
    total += 6;
  }
  total += weigh(j.x) + weigh(k.x);
  const l: Payload[] = [];
  const m: Payload[] = [];
  appendsToOneOfTwo(l, m, first, v);
  total += l.length * 10 + m.length;
  const n: (number | Payload)[] = [1];
  const o: (number | Payload)[] = [2];
  elementOfOneOfTwo(n, o, first, v);
  total += weigh(n[0]) + weigh(o[0]);
  const r = new Holder();
  const s = new Holder();
  r.intoThisOrTheOther(s, first, v);
  total += weigh(r.x) + weigh(s.x);
  const u: Box = { x: 1, tag: "u" };
  const w: Box = { x: 2, tag: "w" };
  twoStoresThatCross(u, w, first, v);
  total += weigh(u.x) + weigh(w.x);
  if (i % 199 === 198) {
    churn(30);
    seen.push([a.x, b.x, c.x, d.x, e.x, t0.x, t1.x, t2.x, p.x, q.x, f.x, g.x, h.x, n[0], o[0], r.x, s.x, u.x, w.x].map(x => (typeof x === "object" ? x.tag : String(x))).join());
  }
}
console.log(total, churn(60));
console.log(seen.join("\n"));
//// a-store-on-every-path-but-the-thrown-one.ts
// "The callee stores parameter j into field f on every path" holds when the callee returns. Where it throws half way, the caller's handler sees an object that is half filled; where the store itself fails or is turned into something else, the field does not hold what was stored.
interface Record2 {
  a?: number;
  b?: string;
  c?: { tag: string };
}
function risky(fail: boolean): number {
  if (fail) throw new Error("failed in the middle");
  return 1;
}
function fill(r: Record2, c: { tag: string }, fail: boolean): void {
  r.a = 1;
  r.b = "b" + risky(fail);
  r.c = c;
}
function fillAndDescribe(fail: boolean): string {
  const r: Record2 = {};
  const c = { tag: "c" };
  try {
    fill(r, c, fail);
  } catch (error) {
    return "caught: " + JSON.stringify(r) + " " + (r.c === undefined) + " " + ("c" in r);
  }
  return "filled: " + JSON.stringify(r) + " " + (r.c === c);
}
let line = "";
for (let i = 0; i < 300; i++) line = fillAndDescribe(i % 100 === 99);
console.log(line, "|", fillAndDescribe(false), "|", fillAndDescribe(true));

// A constructor that throws half way, and an object that had left before.
const half: Half[] = [];
class Half {
  first: string;
  second!: string;
  constructor(fail: boolean) {
    this.first = "first";
    half.push(this);
    this.second = "second" + risky(fail);
  }
}
for (const fail of [false, true]) {
  try {
    new Half(fail);
  } catch {}
}
console.log(half.map(h => h.first + "/" + h.second + "/" + Object.keys(h).join("+")).join(" | "));

// The operand's evaluation throws between two stores of a literal, an array, a call.
function literalHalfWay(fail: boolean, seen: string[]): unknown {
  try {
    return { a: seen.push("a"), b: risky(fail), c: seen.push("c") };
  } catch {
    return seen.join();
  }
}
console.log(JSON.stringify(literalHalfWay(false, [])), literalHalfWay(true, []));

// The store does not take.
function storeAndRead<T>(o: { f: T }, v: T): T | string {
  try {
    o.f = v;
  } catch (error) {
    return (error as Error).constructor.name + ", still " + String(o.f);
  }
  return o.f;
}
let warm = 0;
for (let i = 0; i < 500; i++) warm += storeAndRead({ f: 0 }, i) as number;
console.log(warm);
const readOnly = Object.defineProperty({} as { f: number }, "f", { value: 1, writable: false });
const getterOnly = {
  get f() {
    return 2;
  },
} as { f: number };
const clamping = {
  stored: 0,
  get f() {
    return this.stored;
  },
  set f(v: number) {
    this.stored = Math.min(v, 10);
  },
};
const below = Object.create(Object.freeze({ f: 3 })) as { f: number };
const belowSetter = Object.create({
  set f(v: number) {},
  get f() {
    return 4;
  },
}) as { f: number };
const sealed = Object.preventExtensions({}) as { f: number };
console.log([storeAndRead(Object.freeze({ f: 0 }), 99), storeAndRead(readOnly, 99), storeAndRead(getterOnly, 99), storeAndRead(clamping, 99), storeAndRead(below, 99), storeAndRead(belowSetter, 99), storeAndRead(sealed, 99)].join(" | "));

// Elements: typed arrays convert, a frozen array refuses, `length` cuts.
function storeElement(list: { [i: number]: number }, i: number, v: number): number | string | undefined {
  try {
    list[i] = v;
  } catch (error) {
    return (error as Error).constructor.name;
  }
  return list[i];
}
for (let i = 0; i < 500; i++) warm += storeElement([0, 0], 1, i) as number;
console.log([storeElement(new Uint8Array(2), 0, 300), storeElement(new Uint8ClampedArray(2), 0, 300), storeElement(new Int8Array(2), 0, 200), storeElement(new Float32Array(2), 0, 0.1), storeElement(new Uint8Array(2), 5, 1), storeElement(new Int32Array(2), 0, 1.9), storeElement(new Int32Array(2), 0, NaN), storeElement(Object.freeze([1, 2]) as number[], 0, 9), storeElement([1, 2], -1, 9), storeElement([1, 2], 1.5, 9)].join(" | "));

// A primitive takes no property.
function tagIt(x: unknown, tag: string): unknown {
  try {
    (x as { tag: string }).tag = tag;
  } catch (error) {
    return (error as Error).constructor.name;
  }
  return (x as { tag: string }).tag;
}
console.log([tagIt({}, "t"), tagIt("text", "t"), tagIt(5, "t"), tagIt(true, "t"), tagIt(Symbol(), "t"), tagIt(null, "t"), tagIt(undefined, "t"), tagIt(() => 1, "t"), tagIt([], "t")].join(" | "));

// The field holds what was stored last, and "last" is decided at run time.
function storeTwice(o: { f: unknown }, first: unknown, second: unknown, both: boolean): unknown {
  o.f = first;
  if (both) o.f = second;
  return o.f;
}
function storeInLoop(o: { f: unknown }, values: unknown[]): unknown {
  for (const v of values) o.f = v;
  return o.f;
}
console.log(storeTwice({ f: 0 }, 1, "two", false), storeTwice({ f: 0 }, 1, "two", true), storeInLoop({ f: "none" }, []), storeInLoop({ f: "none" }, [1, "x", null]));

// `finally` stores after the return value was computed.
function returnsThenStores(o: { f: number }): number {
  try {
    return o.f;
  } finally {
    o.f = -1;
  }
}
const late = { f: 5 };
console.log(returnsThenStores(late), late.f);
//// a-store-that-the-returned-object-never-got.ts
// One place in the source makes many objects. `do { o.x = 1; o = { tag: n }; } while (..); return o;`: the store stands on every path to the return and names an object of the very place that the result comes from, and yet the object that is returned was made behind the last store.
interface T {
  tag: number;
  x?: number;
  next?: T;
}
////= lines-29	literalInALoop	o.x = 1
class C {
  x?: number;
  constructor(public tag: number) {}
}
////= lines-28	instanceInALoop	C	new C
function factory(tag: number): T {
  return { tag };
}
////= lines-28	factoryInALoop	T	factory
function fill(o: T): void {
  o.x = 1;
}
////= lines-29	filledByACallee	fill(o)
function oneSiteOnly(n: number): T {
  let previous: T | null = null;
  for (;;) {
    const o: T = { tag: n };
    if (previous) {
      previous.x = 1;
      if (--n <= 0) return o;
    }
    previous = o;
  }
}
function returnsThePrevious(n: number): T {
  let previous: T = { tag: -1 };
  for (let i = 0; i < n; i++) {
    const o: T = { tag: i };
    o.x = i;
    const old = previous;
    previous = o;
    if (i === n - 1) return old;
  }
  return previous;
}
function chainOfOneSite(n: number): T {
  let head: T = { tag: n };
  while (--n >= 0) {
    const o: T = { tag: n };
    o.next = head;
    head = o;
  }
  return head;
}
function byRecursion(n: number, previous: T | null): T {
  const o: T = { tag: n };
  if (previous) previous.x = 1;
  return n === 0 ? o : byRecursion(n - 1, o);
}
const describe = (o: T | C): string => Object.keys(o).join("+") + ":" + o.tag + ":" + o.x + ":" + ("x" in o);
let warm = 0;
for (let i = 1; i < 1500; i++) warm += literalInALoop(i % 4 + 1).tag + instanceInALoop(i % 4 + 1).tag + factoryInALoop(i % 4 + 1).tag + filledByACallee(i % 4 + 1).tag + oneSiteOnly(i % 4 + 1).tag + returnsThePrevious(i % 4 + 1).tag + chainOfOneSite(i % 4).tag + byRecursion(i % 4, null).tag;
console.log(warm);
for (const n of [1, 2, 3]) console.log([literalInALoop(n), instanceInALoop(n), factoryInALoop(n), filledByACallee(n), oneSiteOnly(n), returnsThePrevious(n), byRecursion(n, null)].map(describe).join(" | "));
let length = 0;
for (let at: T | undefined = chainOfOneSite(5); at; at = at.next) length = length * 10 + at.tag;
console.log(length);

// The caller reads the field that "every path stores".
function xOf(o: T): number {
  return (o.x as number) + 1;
}
console.log(xOf(literalInALoop(3)), xOf(factoryInALoop(3)), xOf(filledByACallee(3)), xOf(oneSiteOnly(3)), xOf(returnsThePrevious(3)), xOf(returnsThePrevious(1)));

// Two objects of one place are alive at once, and only one of them is the result.
function twoOfOnePlace(a: number, b: number): [T, T] {
  const made: T[] = [];
  for (const tag of [a, b]) made.push({ tag });
  made[0].x = 100;
  return [made[1], made[0]];
}
function resultAndSibling(n: number): T {
  const make = (tag: number): T => ({ tag });
  const sibling = make(n);
  const result = make(n + 1);
  sibling.x = 5;
  result.next = sibling;
  return result;
}
const [second, first] = twoOfOnePlace(1, 2);
console.log(describe(second), describe(first), describe(resultAndSibling(1)), describe(resultAndSibling(1).next!));

// The kept one and the returned one come from one place.
const keptOnes: T[] = [];
function keepsEveryOther(n: number): T {
  let o: T = { tag: -1 };
  for (let i = 0; i <= n; i++) {
    o = { tag: i };
    if (i < n) keptOnes.push(o);
  }
  return o;
}
const fresh = keepsEveryOther(2);
fresh.x = 9;
Bun.gc(true);
console.log(describe(fresh), keptOnes.map(describe).join(" | "), keptOnes.includes(fresh));
function keepsTheLastToo(n: number): T {
  let o: T = { tag: -1 };
  for (let i = 0; i <= n; i++) {
    o = { tag: i };
    keptOnes.push(o);
  }
  return o;
}
const notFresh = keepsTheLastToo(1);
notFresh.x = 7;
console.log(keptOnes[keptOnes.length - 1] === notFresh, describe(keptOnes[keptOnes.length - 1]));
