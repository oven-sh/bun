  if (really) h.item = i;
}
function putBoth(h: Holder, a: Item, b: Item, first: boolean): void {
  h.item = first ? a : b;
}
function exchange(a: Holder, b: Holder): void {
  const old = a.item;
  a.item = b.item;
  b.item = old;
}
