//// a-base-constructor-hands-this-to-a-helper.js
// While the constructor of the base class runs, the fields of the heir do not exist yet: a helper that is handed `this` there and stores under the name of such a field meets whatever the chain has under that name: the setter of the class in between. Afterwards the field is defined over it. "This field is always filled" is true of every read and says nothing about that store.
////= churn-2
const keptBySetter = [];
const unfinished = [];
////= lines-9	fill	o	v	o.value
////= lines-16	fillAndRead	o	o.value	o.value
////= lines-17	fillByKey	o	key	v	o[key
function look(o) {
  return "value" in o ? typeof o.value : "nothing";
}
class Base {
  constructor(v) {
    this.early = look(this);
    fill(this, v);
    this.answer = fillAndRead(this, { tag: v.tag + ", second" });
    fillByKey(this, "value", { tag: v.tag + ", by key" });
    this.own = Object.hasOwn(this, "value");
  }
}
class Between extends Base {
  set value(v) {
    if (v.tag.endsWith("99") || v.tag.includes("99,")) {
      keptBySetter.push(v);
      unfinished.push(this);
    }
  }
  get value() {
    return "from the getter";
  }
}
class Heir extends Between {
  value = { tag: "the field" };
  after = 1;
}
class HeirWithoutSetter extends Base {
  value = { tag: "the field" };
}
class HeirOfAFrozenThis extends Base {
  constructor(v) {
    super(v);
    Object.freeze(this);
  }
}
let line = "";
for (let i = 0; i < 400; i++) {
  const h = new Heir({ tag: "handed " + i });
  const plain = new HeirWithoutSetter({ tag: "plain " + i });
  const frozen = new HeirOfAFrozenThis({ tag: "frozen " + i });
  line = [h.early, h.answer, h.own, h.value.tag, h.after, plain.early, plain.answer.tag, plain.own, plain.value.tag, frozen.value.tag].join(" | ");
}
console.log(line);
console.log(churn(60), keptBySetter.map(v => v.tag).join(" | "));
console.log(unfinished.map(o => o.value.tag + " " + o.after + " " + o.own).join(" | "), new Set(unfinished).size);

// The same with a helper that is a method of the base, a callback, and Reflect.set with another receiver.
class Base2 {
  constructor(v, how) {
    how(this, v);
  }
  put(v) {
    this.slot = v;
  }
}
const seenBySlot = [];
class Between2 extends Base2 {
  set slot(v) {
    seenBySlot.push(v.tag);
  }
}
class Heir2 extends Between2 {
  slot = null;
}
const hows = [
  (o, v) => o.put(v),
  (o, v) => Base2.prototype.put.call(o, v),
  (o, v) => Reflect.set(o, "slot", v),
  (o, v) => Reflect.set({}, "slot", v, o),
  (o, v) => Object.assign(o, { slot: v }),
  (o, v) => ({ slot: o.slot } = { slot: v }),
  (o, v) => [o.slot] = [v],
  (o, v) => Object.defineProperty(o, "slot", { value: v, writable: true, configurable: true, enumerable: true }),
];
const made = hows.map((how, i) => new Heir2({ tag: "way " + i }, how));
console.log(seenBySlot.join(), made.map(o => String(o.slot)).join());
//// a-callback-stores-its-argument.ts
// A helper makes an object and hands it to the callback it was passed. What becomes of the object is decided by the caller's callback: one reads it, one writes it, one keeps it, each in its own way.
////= churn
////= lines-2	Temp	n	label	string
function withTemp(i: number, use: (t: Temp) => unknown): number {
  const temp: Temp = { n: i, label: "temp" + i };
  use(temp);
  return temp.n;
}
function withTempTwice(i: number, use: (t: Temp) => unknown): number {
  return withTemp(i, use) + withTemp(i + 1, use);
}
function answersOf(count: number, f: (t: Temp) => unknown): unknown[] {
  const out: unknown[] = [];
  for (let i = 0; i < count; i++) out.push(f({ n: i, label: "answer" + i }));
  return out;
}
const inModule: Temp[] = [];
let lastInModule: Temp | null = null;
function keepInModule(t: Temp): void {
  lastInModule = t;
}
class Shelf {
  items: Temp[] = [];
  only: Temp | null = null;
  keep(t: Temp): void {
    this.items.push(t);
    this.only = t;
  }
}
function run(): void {
  let sum = 0;
  const local: Temp[] = [];
  const box: { held: Temp | null } = { held: null };
  let thunk: () => string = () => "nothing";
  const shelf = new Shelf();
  const set = new Set<Temp>();
  const trapped: unknown[][] = [];
  const throughProxy = new Proxy((t: Temp) => t.n, {
    apply(target, self, args) {
      trapped.push(args);
      return Reflect.apply(target, self, args);
    },
  });
  const table: ((t: Temp) => unknown)[] = [t => t.n, t => local.push(t)];
  for (let i = 0; i < 400; i++) {
    sum += withTempTwice(i, t => {
      sum += t.n;
    });
    sum += withTempTwice(i, t => {
      t.n = -t.n;
    });
    if (i % 100 === 10) sum += withTempTwice(i, t => inModule.push(t));
    if (i % 100 === 20) sum += withTempTwice(i, keepInModule);
    if (i % 100 === 30) sum += withTempTwice(i, t => local.push(t));
    if (i % 100 === 40) {
      sum += withTempTwice(i, t => {
        box.held = t;
      });
    }
    if (i % 100 === 50) {
      sum += withTempTwice(i, t => {
        thunk = () => t.label;
      });
    }
    if (i % 100 === 60) sum += withTempTwice(i, shelf.keep.bind(shelf));
    if (i % 100 === 70) sum += withTempTwice(i, set.add.bind(set));
    if (i % 100 === 80) sum += withTempTwice(i, throughProxy);
    sum += withTempTwice(i, table[i % 100 === 90 ? 1 : 0]);
  }
  console.log(sum, churn(60));
  const labels = (list: Iterable<Temp>) => Array.from(list, t => t.label + "=" + t.n).join();
  console.log(labels(inModule));
  console.log(lastInModule!.label, labels(local));
  console.log(box.held!.label, thunk(), labels(shelf.items), shelf.only === shelf.items[shelf.items.length - 1]);
  console.log(labels(set), trapped.map(args => (args[0] as Temp).label).join());
}
run();
const same = answersOf(300, t => t) as Temp[];
const numbers = answersOf(300, t => t.n) as number[];
const wrapped = answersOf(300, t => ({ inner: t })) as { inner: Temp }[];
const thunks = answersOf(300, t => () => t) as (() => Temp)[];
console.log(churn(60), same[299].label, numbers[299], wrapped[150].inner.label, thunks[7]().label, thunks[7]() === thunks[7](), same[1] === same[2]);

// The elements of the caller's array go to the caller's callback; the callback changes the array while the helper walks it.
function each<T>(list: T[], visit: (item: T, index: number) => void): void {
  for (let i = 0; i < list.length; i++) visit(list[i], i);
}
const seen: string[] = [];
const growing: (number | string | Temp)[] = [1, 2, 3];
each(growing, (item, index) => {
  seen.push(typeof item === "object" ? item.label : typeof item + item);
  if (index === 0) growing.push("four");
  if (index === 1) growing.push({ n: 5, label: "five" });
  if (index === 2) growing[3] = 4.5;
});
const shrinking = [{ n: 1, label: "a" }, { n: 2, label: "b" }, { n: 3, label: "c" }];
const popped: Temp[] = [];
each(shrinking, item => {
  seen.push(item.label);
  popped.push(shrinking.pop()!);
});
console.log(seen.join(), churn(40), popped.map(t => t.label).join());
//// a-called-parameter-is-whatever-the-caller-passed.ts
// "Parameter cb is only called, with an object made here" is composed at each call site with the closure that stands there. The composition is wrong where the helper does not call what it was passed as it came in, where it calls it in another way than a plain call, or where what stands at the site is no plain closure.
////= churn
////= lines-2	Temp	n	tag	string
type Use = (t: Temp) => unknown;
const kept: Temp[] = [];
const keeper: Use = t => kept.push(t);
const reader: Use = t => t.n;
const temp = (n: number, how: string): Temp => ({ n, tag: how + n });
const rare = (n: number) => n % 90 === 89;

// The parameter is stored to before the call.
function replacesItsParameter(n: number, use: Use): unknown {
  if (rare(n)) use = keeper;
  return use(temp(n, "replaced parameter "));
}
// A default stands in for a missing callback.
function hasADefault(n: number, use: Use = keeper): unknown {
  return use(temp(n, "default "));
}
// One of two.
function choosesBetween(n: number, first: Use, second: Use): unknown {
  return (rare(n) ? second : first)(temp(n, "chosen "));
}
// The callback goes through a field, an array, a variable of a closure.
function throughAField(n: number, use: Use): unknown {
  const holder = { use };
  return holder.use(temp(n, "through a field "));
}
function throughAList(n: number, use: Use): unknown {
  return [reader, use][1](temp(n, "through a list "));
}
function throughAClosure(n: number, use: Use): unknown {
  const call = (t: Temp) => use(t);
  return call(temp(n, "through a closure "));
}
// Called in other ways.
function byCall(n: number, use: Use): unknown {
  return use.call(null, temp(n, "by call "));
}
function byApply(n: number, use: Use): unknown {
  return use.apply(null, [temp(n, "by apply ")]);
}
function byReflect(n: number, use: Use): unknown {
  return Reflect.apply(use, null, [temp(n, "by Reflect ")]);
}
function asThis(n: number, use: (this: Temp) => unknown): unknown {
  return use.call(temp(n, "as this "));
}
function byABuiltIn(n: number, use: Use): unknown {
  return [temp(n, "by forEach ")].forEach(use);
}
function withMore(n: number, use: (...all: Temp[]) => unknown): unknown {
  return use(temp(n, "first of three "), temp(n, "second of three "), temp(n, "third of three "));
}
function constructed(n: number, Use: new (t: Temp) => unknown): unknown {
  return new Use(temp(n, "constructed with "));
}
function later(n: number, use: Use): void {
  const t = temp(n, "later ");
  queueMicrotask(() => use(t));
}
// The answer of the callback is the answer of the helper.
function answers(n: number, use: (t: Temp) => Temp | number): Temp | number {
  return use(temp(n, "answered "));
}
// The callback is handed on.
function handsOn(n: number, use: Use): unknown {
  return throughAClosure(n, use);
}
let sum = 0;
function run(): void {
  const local: Temp[] = [];
  for (let i = 0; i < 270; i++) {
    const keep = rare(i);
    sum += replacesItsParameter(i, reader) as number;
    sum += (keep ? hasADefault(i) : hasADefault(i, reader)) as number;
    sum += choosesBetween(i, reader, keeper) as number;
    const mine: Use = keep ? t => local.push(t) : t => t.n;
    for (const helper of [throughAField, throughAList, throughAClosure, byCall, byApply, byReflect, handsOn]) sum += helper(i, mine) as number;
    byABuiltIn(i, mine);
    asThis(i, function (this: Temp) {
      if (keep) local.push(this);
      return this.n;
    });
    withMore(i, (...all) => {
      if (keep) local.push(all[2]);
    });
    withMore(i, function () {
      if (keep) local.push(arguments[1]);
    });
    constructed(
      i,
      class {
        constructor(t: Temp) {
          if (keep) local.push(t);
        }
      },
    );
    later(i, t => {
      if (keep) local.push(t);
    });
    const answer = answers(i, keep ? t => t : t => t.n);
    if (typeof answer === "object") local.push(answer);
  }
  console.log(sum, churn(60));
  console.log(kept.map(t => t.tag).join(" | "));
  console.log(local.map(t => t.tag).join(" | "));
  queueMicrotask(() => console.log(churn(20), local.slice(-3).map(t => t.tag).join(" | ")));
}
run();
await null;

// What stands at the site is no plain closure.
kept.length = 0;
const coroutines: Promise<string>[] = [];
const generators: Generator<string>[] = [];
function withTemp(n: number, use: Use): unknown {
  return use(temp(n, "for a site "));
}
const bound = keeper.bind(null);
const proxied = new Proxy(reader, {
  apply(target, self, args: [Temp]) {
    kept.push(args[0]);
    return target(args[0]);
  },
});
const set = new Set<Temp>();
class Sink {
  items: Temp[] = [];
  take = (t: Temp) => this.items.push(t);
  method(t: Temp) {
    return this.items.push(t);
  }
}
const sink = new Sink();
for (let i = 0; i < 100; i++) {
  withTemp(i, reader);
  if (i % 45 !== 44) continue;
  withTemp(i, bound);
  withTemp(i, proxied);
  withTemp(i, set.add.bind(set));
  withTemp(i, sink.take);
  withTemp(i, sink.method.bind(sink));
  withTemp(i, async t => {
    coroutines.push(Promise.resolve().then(() => "in a reaction " + t.tag));
    await null;
    kept.push(t);
  });
  withTemp(i, t => {
    generators.push(
      (function* () {
        yield "in a generator " + t.tag;
      })(),
    );
  });
  withTemp(i, ({ tag }) => kept.push({ n: -1, tag: "only its tag: " + tag }));
  withTemp(i, (t, extra = kept.push(t)) => extra);
  withTemp(i, Array.prototype.push.bind(kept) as Use);
  withTemp(i, Object.freeze);
  withTemp(i, JSON.stringify as Use);
}
churn(60);
await null;
await null;
console.log(kept.map(t => t.tag).join(" | "));
console.log([...set].map(t => t.tag).join(), sink.items.map(t => t.tag).join(), (await Promise.all(coroutines)).join(), generators.map(g => g.next().value).join());
//// a-callee-is-replaced-at-run-time.ts
// What a call does to its operands is what the callee OF THAT MOMENT does. A variable that holds a function is stored to, a method is replaced on the prototype, on the instance, on the class; a function declaration is assigned; an accessor takes the place of a method. The first callee keeps nothing and answers a fresh object; its successor keeps everything.
////= churn
////= Thing
const kept: Thing[] = [];
const keeper = (t: Thing): number => {
  kept.push(t);
  return -t.n;
};

// A `let` that holds a function.
let inVariable = (t: Thing): number => t.n;
function callsVariable(i: number): number {
  return inVariable({ n: i, tag: "variable" + i });
}
// A function declaration that is assigned.
////= lines-3	declared	t	Thing	number	return	t.n
function callsDeclared(i: number): number {
  return declared({ n: i, tag: "declared" + i });
}
// A method on the prototype.
class Service {
  handle(t: Thing): number {
    return t.n;
  }
  static make(i: number): Thing {
    return { n: i, tag: "static fresh" + i };
  }
}
function callsMethod(service: Service, i: number): number {
  return service.handle({ n: i, tag: "method" + i });
}
// A method that one instance gets for itself.
function callsOnInstance(service: Service, i: number): number {
  return service.handle({ n: i, tag: "instance" + i });
}
// A field that holds a function.
const withField = { handle: (t: Thing): number => t.n };
function callsField(i: number): number {
  return withField.handle({ n: i, tag: "field" + i });
}
// An element of an array of functions.
const handlers: ((t: Thing) => number)[] = [t => t.n, t => t.n + 1];
function callsElement(i: number): number {
  return handlers[i & 1]({ n: i, tag: "element" + i });
}
// A static factory whose answer was fresh.
const pool: Thing = { n: 0, tag: "the pooled one" };
function usesFactory(i: number): number {
  const made = Service.make(i);
  made.n += 1;
  return made.n;
}
// A function captured by a closure that a setter function replaces.
function makePair() {
  let current = (t: Thing): number => t.n;
  return {
    call: (i: number) => current({ n: i, tag: "captured" + i }),
    replace: (f: (t: Thing) => number) => {
      current = f;
    },
  };
}
const pair = makePair();
const service = new Service();
const special = new Service();
function round(i: number): number {
  return callsVariable(i) + callsDeclared(i) + callsMethod(service, i) + callsOnInstance(special, i) + callsField(i) + callsElement(i) + usesFactory(i) + pair.call(i);
}
let sum = 0;
for (let i = 0; i < 500; i++) sum += round(i);
console.log(sum, kept.length);
inVariable = keeper;
// @ts-ignore: a function declaration is a variable
declared = keeper;
Service.prototype.handle = keeper;
withField.handle = keeper;
handlers[1] = keeper;
Service.make = () => pool;
pair.replace(keeper);
for (let i = 500; i < 503; i++) sum += round(i);
console.log(sum, churn(60), kept.map(t => t.tag).join(), pool.n);
kept.length = 0;
special.handle = t => {
  kept.push(t, t);
  return 0;
};
delete (Service.prototype as Partial<Service>).handle;
Object.defineProperty(Service.prototype, "handle", {
  get() {
    kept.push({ n: -1, tag: "the getter ran on " + (this === service ? "service" : "another") });
    return (t: Thing) => t.n * 2;
  },
  configurable: true,
});
console.log(callsMethod(service, 7), callsOnInstance(special, 8), churn(40), kept.map(t => t.tag).join());

// The replacement happens in the middle of the call that passes the object: an argument's evaluation replaces the callee.
let late = (a: Thing, b: number): string => "first callee " + a.tag + b;
function replaceAndAnswer(): number {
  late = (a, b) => {
    kept.push(a);
    return "second callee " + a.tag + b;
  };
  return 1;
}
console.log(late({ n: 0, tag: "x" }, replaceAndAnswer()), late({ n: 0, tag: "y" }, 2));
const host = {
  run(a: Thing, b: number): string {
    return "first method " + a.tag + b;
  },
};
function replaceMethod(): number {
  host.run = (a, b) => "second method " + a.tag + b;
  return 1;
}
console.log(host.run({ n: 0, tag: "x" }, replaceMethod()), host.run({ n: 0, tag: "y" }, 2));

// The callee replaces itself on its first call.
let lazy = (t: Thing): Thing => {
  const memo = t;
  lazy = () => memo;
  return { n: t.n, tag: "fresh copy of " + t.tag };
};
const answers: Thing[] = [];
for (let i = 0; i < 4; i++) answers.push(lazy({ n: i, tag: "lazy" + i }));
console.log(churn(40), answers.map(t => t.tag).join(), answers[1] === answers[2], answers[0] === answers[1]);
//// a-closure-is-kept-by-a-callee-of-a-callee.ts
// A closure goes down a chain of calls, and only the last one keeps it, only on a rare path. Each chain is one call longer; each keeper keeps in another way. The closures are called when the frames that made them are long gone.
////= churn
type Read = () => string;
const inList: Read[] = [];
let inVariable: Read | null = null;
const inField: { read: Read | null } = { read: null };
const inMap = new Map<number, Read>();
let inClosure: () => string = () => "";
const inBound: Read[] = [];
function keep1(f: Read, i: number): string {
  if (i % 100 === 91) inList.push(f);
  return f();
}
function keep2(f: Read, i: number): string {
  if (i % 100 === 92) inVariable = f;
  return f();
}
function keep3(f: Read, i: number): string {
  if (i % 100 === 93) inField.read = f;
  return f();
}
function keep4(f: Read, i: number): string {
  if (i % 100 === 94) inMap.set(i, f);
  return f();
}
function keep5(f: Read, i: number): string {
  if (i % 100 === 95) inClosure = () => "again " + f();
  return f();
}
function keep6(f: Read, i: number): string {
  if (i % 100 === 96) inBound.push(f.bind(null));
  return f();
}
const down2 = (f: Read, i: number) => keep2(f, i);
const down3a = (f: Read, i: number) => keep3(f, i);
const down3 = (f: Read, i: number) => down3a(f, i);
const down4b = (f: Read, i: number) => keep4(f, i);
const down4a = (f: Read, i: number) => down4b(f, i);
const down4 = (f: Read, i: number) => down4a(f, i);
const down5c = (f: Read, i: number) => keep5(f, i);
const down5b = (f: Read, i: number) => down5c(f, i);
const down5a = (f: Read, i: number) => down5b(f, i);
const down5 = (f: Read, i: number) => down5a(f, i);
const down6d = (f: Read, i: number) => keep6(f, i);
const down6c = (f: Read, i: number) => down6d(f, i);
const down6b = (f: Read, i: number) => down6c(f, i);
const down6a = (f: Read, i: number) => down6b(f, i);
const down6 = (f: Read, i: number) => down6a(f, i);
function work(i: number): number {
  const state = { tag: "state" + i, reads: 0 };
  let local = i;
  const read: Read = () => {
    state.reads++;
    local++;
    return state.tag + "/" + state.reads + "/" + local;
  };
  return keep1(read, i).length + down2(read, i).length + down3(read, i).length + down4(read, i).length + down5(read, i).length + down6(read, i).length;
}
let sum = 0;
for (let i = 0; i < 300; i++) sum += work(i);
console.log(sum, churn(80));
console.log(inList.map(f => f()).join());
console.log(inVariable!(), inField.read!(), [...inMap].map(([i, f]) => i + "=" + f()).join());
console.log(inClosure(), inBound.map(f => f()).join());

// The closure is wrapped on its way down: what is kept is a closure over a closure over the caller's variable.
const wrappers: Read[] = [];
function wrap(f: Read): Read {
  return () => "<" + f() + ">";
}
function wrapAndMaybeKeep(f: Read, i: number): string {
  const wrapped = wrap(wrap(f));
  if (i % 70 === 69) wrappers.push(wrapped);
  return wrapped();
}
