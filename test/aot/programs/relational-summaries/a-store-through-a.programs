  warm += divide(i * 2, 2) + remainder(i, 7) + power(i % 10, 2) + sumOfThree(i, i, i) + addThenTruncate(i, i) + multiplyThenTruncate(i, 2) + average(i, i) + count(i, 3) + countDown(i, 3) + sumList([i, i]);
