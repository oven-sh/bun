//// built-ins-on-constants-and-on-values-agree.ts
// A built-in whose operands are known at the build can be computed at the build, also where the constants arrive through helpers that return them. Each line computes the same thing twice: from constants, and from the same values read out of JSON at run time. The two must agree with each other and with plain Bun, to the last digit, sign of zero and kind of answer.
const data = JSON.parse('{"n":[0,-0.0,1,-1,0.5,-0.5,1.5,2.5,-2.5,255,4294967295,2147483648,1e21,1e-7,123.456,0.1,0.2],"s":["","abc","ABC","  pad  ","a,b,,c","ß","İ","𝒳y","12px","0x1f","1e3","-0"," 42 ","Infinity","é","é"]}') as { n: number[]; s: string[] };
const show = (x: unknown): string => (typeof x === "number" && Object.is(x, -0) ? "-0" : Array.isArray(x) ? "[" + x.map(show).join("|") + "]" : typeof x === "string" ? JSON.stringify(x) : String(x));
let row = 0;
function both(fromConstants: unknown, fromValues: unknown): void {
  const a = show(fromConstants);
  const b = show(fromValues);
  console.log(++row + " " + (a === b ? "agree " : "DISAGREE " + b + " ") + a);
}
const zero = () => 0;
const minusZero = () => -0;
const half = () => 0.5;
const minusHalf = () => -0.5;
const abc = () => "abc";
const csv = () => "a,b,,c";
