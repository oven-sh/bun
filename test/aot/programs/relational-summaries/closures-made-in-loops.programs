const one = /a./g;
console.log(firstMatch(one, "abacad"), firstMatch(one, "abacad"), firstMatch(one, "abacad"), firstMatch(one, "abacad"), firstMatch(one, "abacad"));
const isSame = (a: unknown, b: unknown): boolean => a === b;
