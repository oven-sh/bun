const l3 = (a: number) => l2(a) - 3;
const l4 = (a: number) => l3(a) * l3(a);
const l5 = (a: number) => l4(a) + l1(a);
const l6 = (a: number) => l5(a) * 1000;
const l7 = (a: number) => l6(a) * 1000;
const l8 = (a: number) => l7(a) * 1000;
