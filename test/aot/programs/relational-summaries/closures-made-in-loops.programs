//// closures-made-in-loops-and-tail-calls.ts
// Every round of a loop has variables of its own, and every call of a function that calls itself last has a frame of its own, even where the compiler makes one storage of them. A closure that is only called in 99 rounds and kept in the hundredth must hold the variables of ITS round, as they were left by that round, whatever later rounds write.
////= churn
////= lines-23	call	f
const kept: (() => string)[] = [];
const rare = (i: number) => i % 100 === 99;
const flush = () => kept.splice(0).map(f => f()).join(" ");

function countedLoop(): number {
  let sum = 0;
  for (let i = 0; i < 300; i++) {
    const read = () => "i" + i;
    sum += call(read).length;
    if (rare(i)) kept.push(read);
  }
  return sum;
}
function constInTheBody(): number {
  let sum = 0;
  for (let i = 0; i < 300; i++) {
    const box = { n: i };
    let count = 0;
    const read = () => "box" + box.n + "." + ++count;
    sum += call(read).length;
    box.n += 1000;
    if (rare(i)) kept.push(read);
  }
  return sum;
}
function forOf(): number {
  let sum = 0;
  const items = Array.from({ length: 300 }, (_, i) => ({ n: i }));
  for (const item of items) {
    const read = () => "item" + item.n;
    sum += call(read).length;
    if (rare(item.n)) kept.push(read);
  }
  return sum;
}
function forIn(): number {
  let sum = 0;
  for (const key in { a: 1, b: 2, c: 3 }) {
    const read = () => "key " + key;
    sum += call(read).length;
    kept.push(read);
  }
  return sum;
}
function whileLoop(): number {
  let sum = 0;
  let i = 0;
  while (i < 300) {
    const mine = i;
    const read = () => "mine" + mine + " shared" + i;
    sum += call(read).length;
    if (rare(i)) kept.push(read);
    i++;
  }
  return sum;
}
function varInALoop(): number {
  let sum = 0;
  for (var v = 0; v < 300; v++) {
    var inner = v * 2;
    const read = () => "v" + v + " inner" + inner;
    sum += call(read).length;
    if (rare(v)) kept.push(read);
  }
  return sum;
}
function theClosureWritesTheCounter(): string {
  const seen: number[] = [];
  for (let i = 0; i < 10; i++) {
    seen.push(i);
    call(() => {
      i += 2;
    });
    if (i === 5) kept.push(() => "counter as round 3 left it: " + i);
  }
  return seen.join();
}
function closuresInTheHead(): string {
  const reads: (() => number)[] = [];
  for (let i = 0, first = () => i; i < 3; reads.push(() => i), i++) {
    if (i === 0) reads.push(first);
  }
  return reads.map(f => f()).join();
}
function nestedLoops(): number {
  let sum = 0;
  for (let i = 0; i < 20; i++) {
    const outer = { i };
    for (let j = 0; j < 20; j++) {
      const read = () => outer.i + ":" + j;
      sum += call(read).length;
      if (i === 19 && j % 9 === 8) kept.push(read);
    }
    outer.i += 100;
  }
  return sum;
}
function continueAndBreak(): number {
  let sum = 0;
  for (let i = 0; i < 300; i++) {
    const read = () => "c" + i;
    if (i % 2) {
      if (rare(i)) kept.push(read);
      continue;
    }
    sum += call(read).length;
    if (i === 250) {
      kept.push(read);
      break;
    }
  }
  return sum;
}
function switchInALoop(): number {
  let sum = 0;
  for (let i = 0; i < 300; i++) {
    switch (i % 100) {
      case 99: {
        const only = { tag: "case " + i };
        kept.push(() => only.tag);
        break;
      }
      default: {
        const only = { tag: "default" };
        sum += call(() => only.tag).length;
      }
    }
  }
  return sum;
}
function tryInALoop(): number {
  let sum = 0;
  for (let i = 0; i < 300; i++) {
    try {
      if (rare(i)) throw { tag: "thrown " + i };
      sum++;
    } catch (e) {
      kept.push(() => (e as { tag: string }).tag);
    } finally {
      const last = { tag: "finally " + i };
      if (rare(i)) kept.push(() => last.tag);
    }
  }
  return sum;
}
for (const loop of [countedLoop, constInTheBody, forOf, forIn, whileLoop, varInALoop, theClosureWritesTheCounter, closuresInTheHead, nestedLoops, continueAndBreak, switchInALoop, tryInALoop]) {
  const answer = loop();
  console.log(loop.name, answer, churn(40), flush());
}

// A function that calls itself last.
function tail(n: number, acc: number): number {
  const mine = { n };
  let local = n;
  const read = () => "tail" + mine.n + "." + local;
  acc += call(read).length;
  local = -n;
  if (rare(n)) kept.push(read);
  return n === 0 ? acc : tail(n - 1, acc);
}
function tailWithParameters(n: number, carried: { tag: string }): string {
  if (rare(n)) kept.push(() => carried.tag + "@" + n);
  return n === 0 ? carried.tag : tailWithParameters(n - 1, { tag: "carried " + n });
}
function tailThatStoresToItsParameter(n: number, text: string): string {
  const read = () => text + n;
  if (rare(n)) kept.push(read);
  text = "changed" + n + " ";
  if (n === 0) return call(read);
  return tailThatStoresToItsParameter(n - 1, "passed" + n + " ");
}
function evenTail(n: number): string {
  const mine = { tag: "even " + n };
  if (n % 100 === 50) kept.push(() => mine.tag);
  return n === 0 ? "done" : oddTail(n - 1);
}
function oddTail(n: number): string {
  const mine = { tag: "odd " + n };
  if (rare(n)) kept.push(() => mine.tag);
  return evenTail(n - 1);
}
console.log(tail(300, 0), churn(40), flush());
console.log(tailWithParameters(300, { tag: "first" }), churn(40), flush());
console.log(tailThatStoresToItsParameter(300, "first "), churn(40), flush());
console.log(evenTail(300), churn(40), flush());

// Objects of one round are compared with those of the next.
function roundsAreApart(): string {
  let previous: { n: number } | null = null;
  let previousRead: (() => number) | null = null;
  let same = 0;
  let stale = 0;
  for (let i = 0; i < 200; i++) {
    const o = { n: i };
    const read = () => o.n;
    if (previous === o || previousRead === read) same++;
    if (previous && (previous.n !== i - 1 || previousRead!() !== i - 1)) stale++;
    previous = o;
    previousRead = read;
  }
  return same + "/" + stale;
}
console.log(roundsAreApart());

// Each call makes an object that holds the one its caller made, hands it to the next call, and nobody keeps any of them: in a recursion every frame is still there when the last call walks the chain. Where the last call becomes a jump there is one frame.
////= lines-25	Chain	n	number	prev
function total(from: Chain | null): string {
  let sum = 0;
  let links = 0;
  for (let at = from; at !== null && links < 10000; at = at.prev) {
    sum += at.n;
    links++;
  }
  return links + ":" + sum;
}
function chainByTailCalls(n: number, prev: Chain | null): string {
  const mine: Chain = { n, prev };
  return n === 0 ? total(mine) : chainByTailCalls(n - 1, mine);
}
function chainOfClosures(n: number, prev: () => number): number {
  const mine = () => n + prev();
  return n === 0 ? mine() : chainOfClosures(n - 1, mine);
}
function chainByTwo(n: number, prev: Chain | null): string {
  const mine: Chain = { n, prev };
  return n === 0 ? total(mine) : chainByTwoOther(n - 1, mine);
}
function chainByTwoOther(n: number, prev: Chain | null): string {
  const mine: Chain = { n: -n, prev };
  return n === 0 ? total(mine) : chainByTwo(n - 1, mine);
}
function chainInALoop(count: number): string {
  let prev: Chain | null = null;
  for (let i = 0; i <= count; i++) {
    const mine: Chain = { n: i, prev };
    prev = mine;
  }
  return total(prev);
}
function lastTwoInALoop(count: number): string {
  let last: Chain | null = null;
  let beforeLast: Chain | null = null;
  for (let i = 0; i < count; i++) {
    const mine: Chain = { n: i, prev: null };
    beforeLast = last;
    last = mine;
  }
  return last!.n + "," + beforeLast!.n + "," + (last === beforeLast);
}
function accumulates(n: number, acc: number[]): string {
  const next = [...acc, n];
  return n === 0 ? next.join("") : accumulates(n - 1, next);
}
console.log(chainByTailCalls(300, null), chainOfClosures(300, () => 0), chainByTwo(300, null), chainInALoop(300), lastTwoInALoop(300), accumulates(9, []));

// A function declaration is one closure for each entry into its scope: the same wherever it is named there, another in the next call and in the next round.
function declaredOnce(): (() => number)[] {
  function inner(): number {
    return 1;
  }
  return [inner, inner, (() => inner)()];
}
function declaredInRounds(): (() => number)[] {
  const all: (() => number)[] = [];
  for (let i = 0; i < 3; i++) {
    function inRound(): number {
      return i;
    }
    all.push(inRound, inRound);
  }
  return all;
}
function counted(): number {
  return ++(counted as unknown as { calls: number }).calls;
}
(counted as unknown as { calls: number }).calls = 0;
class Declared {
  static uses = 0;
}
const once = declaredOnce();
const rounds = declaredInRounds();
const registry = new Map<unknown, string>([
  [counted, "the function"],
  [Declared, "the class"],
]);
console.log(once[0] === once[1], once[1] === once[2], declaredOnce()[0] === once[0], rounds[0] === rounds[1], rounds[1] === rounds[2], rounds.map(f => f()).join(""), counted(), counted(), call(counted), registry.get(counted), registry.get(Declared), ++Declared.uses, ++Declared.uses, [counted].includes(counted), new Set([Declared, Declared]).size);
//// closures-that-nobody-calls-keep-what-they-captured.js
// Closures that nobody ever calls, and that somebody keeps: what they have captured lives as long as they do.
const kept = [];
let slot = null;
const holder = { f: null };
function keep(f) {
  kept.push(f);
}
function pushed(p) {
  kept.push(() => p.n);
}
function inAVariable(p) {
  slot = () => p.n;
}
function returned(p) {
  return () => p.n;
}
function inAMemberOfAParameter(p, o) {
  o.f = () => p.n;
}
function insideAnotherClosure(p) {
  const g = () => p.n;
  kept.push(() => g);
}
function thrown(p) {
  throw () => p.n;
}
function handedToAHelper(p) {
  keep(() => p.n);
}
function inAnObjectThatIsKept(p) {
  kept.push({ f: () => p.n });
}
function inAnArrayThatIsReturned(p) {
  return [() => p.n];
}
function dies(p) {
  const g = () => p.n;
}
const names = ["pushed", "inAVariable", "returned", "inAMemberOfAParameter", "insideAnotherClosure", "thrown", "handedToAHelper", "inAnObjectThatIsKept", "inAnArrayThatIsReturned", "dies"];
const watched = names.map(() => []);
const results = [];
function ask() {
  for (let i = 0; i < 300; i++) {
    const make = k => {
      const p = { n: i };
      watched[k].push(new WeakRef(p));
      return p;
    };
    pushed(make(0));
    inAVariable(make(1));
    results.push(returned(make(2)));
    const o = { f: null };
    inAMemberOfAParameter(make(3), o);
    results.push(o);
    insideAnotherClosure(make(4));
    try {
      thrown(make(5));
    } catch (e) {
      results.push(e);
    }
    handedToAHelper(make(6));
    inAnObjectThatIsKept(make(7));
    results.push(inAnArrayThatIsReturned(make(8)));
    dies(make(9));
  }
}
ask();
await new Promise(resolve => setTimeout(resolve, 1));
Bun.gc(true);
await new Promise(resolve => setTimeout(resolve, 1));
Bun.gc(true);
// The collector scans the stack conservatively: a few may be alive by chance.
const few = n => (n < 20 ? "none or by chance" : n === 300 ? "all" : "some");
names.forEach((name, k) => console.log(name + ": " + few(watched[k].filter(r => r.deref() !== undefined).length)));
console.log(kept.length, results.length, typeof slot, holder.f);
//// constant-arrays-are-made-anew-each-time.ts
// An array literal of constants can lie in read-only data as long as nobody writes it, asks who it is, or keeps it where a write may follow. Each evaluation of the literal is a new array: a change to one is not seen in the next, two are never the same, and a helper that "only reads" may hand it to one that sorts.
function primes(): number[] {
  return [2, 3, 5, 7, 11];
}
function names(): string[] {
  return ["ada", "grace", "edsger"];
}
function grid(): number[][] {
  return [
    [1, 2],
    [3, 4],
  ];
}
function mixed(): (number | string | null | boolean)[] {
  return [1, "two", null, true, 2.5, -0];
}
function holes(): (number | undefined)[] {
  return [1, , 3];
}
function empty(): number[] {
  return [];
}
function records(): { id: number; tags: string[] }[] {
  return [
    { id: 1, tags: ["a"] },
    { id: 2, tags: [] },
  ];
}
function sumOf(list: readonly number[]): number {
  let sum = 0;
  for (let i = 0; i < list.length; i++) sum += list[i];
  return sum;
}
function largest(list: number[]): number {
  return list.sort((a, b) => b - a)[0];
}
function readsOrSorts(list: number[], sorts: boolean): number {
  return sorts ? largest(list) : list[0];
}
let warm = 0;
for (let i = 0; i < 2000; i++) warm += sumOf(primes()) + sumOf([1, 2, 3]) + names().length + grid()[1][0] + readsOrSorts([4, 9, 6], false) + mixed().length + empty().length + records()[1].id;
console.log(warm);

// Two evaluations are two arrays.
console.log(primes() === primes(), grid()[0] === grid()[0], records()[0] === records()[0], records()[0].tags === records()[0].tags, empty() === empty(), new Set([primes(), primes()]).size, Object.is(mixed()[5], -0));
function twice(): boolean {
  const lists: number[][] = [];
  for (let i = 0; i < 2; i++) lists.push([1, 2, 3]);
  return lists[0] === lists[1];
}
console.log(twice());

// Every way to change one, and then a new one is looked at.
const changes: [string, (list: number[]) => unknown][] = [
  ["store", l => (l[0] = 99)],
  ["push", l => l.push(99)],
  ["pop", l => l.pop()],
  ["shift", l => l.shift()],
  ["unshift", l => l.unshift(99)],
  ["sort", l => l.sort((a, b) => b - a)],
  ["reverse", l => l.reverse()],
  ["splice", l => l.splice(1, 2)],
  ["fill", l => l.fill(0)],
  ["copyWithin", l => l.copyWithin(0, 3)],
  ["length", l => (l.length = 1)],
  ["grow", l => (l[10] = 1)],
  ["delete", l => delete l[0]],
  ["a double", l => (l[0] = 0.5)],
  ["a string", l => ((l as unknown[])[0] = "s")],
  ["a property", l => ((l as unknown as { extra: number }).extra = 1)],
  ["defineProperty", l => Object.defineProperty(l, 0, { value: 99 })],
  ["an accessor", l => Object.defineProperty(l, 0, { get: () => 99 })],
  ["assign", l => Object.assign(l, [99, 98])],
  ["Reflect.set", l => Reflect.set(l, 0, 99)],
  ["swap", l => ([l[0], l[1]] = [l[1], l[0]])],
  ["increment", l => l[0]++],
  ["compound", l => (l[0] += 5)],
  ["destructuring", l => ([l[0]] = [99])],
  ["for-of target", l => {
    for (l[0] of [99]);
  }],
  ["borrowed push", l => Array.prototype.push.call(l, 99)],
  ["freeze", l => Object.freeze(l)],
  ["seal", l => Object.seal(l)],
  ["setPrototypeOf", l => Object.setPrototypeOf(l, null)],
];
for (const [name, change] of changes) {
  const mine = primes();
  change(mine);
  const next = primes();
  console.log(name + ":", Array.prototype.join.call(mine, "/"), "|", next.join("/"), Object.isFrozen(next), Object.isSealed(next), Object.getPrototypeOf(next) === Array.prototype, Object.keys(next).length);
}

// The literal goes to a helper that sorts on a rare path; the caller reads it afterwards, and the next round gets a new one.
let trace = "";
for (let i = 0; i < 300; i++) {
  const list = [4, 9, 6];
  const answer = readsOrSorts(list, i % 100 === 99);
  if (i % 100 >= 98) trace += answer + ":" + list.join("") + " ";
}
console.log(trace);

// Kept, and written much later.
const keptLists: number[][] = [];
function keepSome(list: number[], i: number): number {
  if (i % 100 === 50) keptLists.push(list);
  return list[1];
}
for (let i = 0; i < 300; i++) warm += keepSome([10, 20, 30], i);
keptLists[0][1] = -1;
keptLists[1].push(40);
console.log(keptLists.map(l => l.join("/")).join(" "), keepSome([10, 20, 30], 1), keptLists[0] === keptLists[1]);

// Inner arrays and objects of a constant literal.
const g1 = grid();
g1[0][0] = 100;
g1[1] = [0];
const r1 = records();
r1[0].tags.push("b");
r1[1].id = 20;
console.log(JSON.stringify(g1), JSON.stringify(grid()), JSON.stringify(r1), JSON.stringify(records()));

// Holes stay holes; strings stay what they were.
const h = holes();
console.log(1 in h, h.length, Object.keys(h).join(), (h[1] = 2), 1 in holes(), names().map(n => n.toUpperCase()).join(), names().join());

// A default parameter, a class field, a spread, a template's strings.
