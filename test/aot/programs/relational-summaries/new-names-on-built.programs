  const o = {};
  if (c) o.x = b;
  return o;
};
const throughAnAlias = (a, b) => {
  const o = { x: a };
  const alias = o;
  alias.x = b;
  return o;
};
const throughAnArray = (a, b) => {
  const o = { x: a };
  const list = [o];
  list[0].x = b;
  return o;
};
const throughAnotherObject = (a, b) => {
  const o = { x: a };
  const holder = { held: o };
  holder.held.x = b;
  return o;
};
const byACallee = (a, b) => {
  const o = { x: a };
