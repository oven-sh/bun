//// what-a-copy-and-a-literal-of-constants-are-born-with.ts
// A fresh object is not an empty one. A copy is born with what its source holds, a literal of constants with its constants, and the
// rest of a destructuring with everything that was not named. Whoever lists the stores into such a result and takes the list for
// the whole object reads `undefined`, or the one store that is listed, where the caller finds something else.
type Thing = { tag: string; n: number; a?: Thing | null; x?: unknown; y?: unknown };
type Bag = Record<string, unknown>;

const lines: string[] = [];
const say = (name: string, ...what: unknown[]) => lines.push(name + ": " + what.map(show).join(" "));
function show(v: unknown): string {
  if (v === null || typeof v !== "object") return typeof v === "symbol" ? v.toString() : typeof v === "string" ? JSON.stringify(v) : String(v);
  if (Array.isArray(v)) return "[" + v.map(show).join() + "]";
  return "{" + Reflect.ownKeys(v).map(k => String(k) + "=" + show((v as Bag)[k as string])).join() + "}";
}

const copyThenName = (prev: Thing, x: unknown) => ({ ...prev, x });
const nameThenCopy = (prev: Thing, x: unknown) => ({ x, ...prev });
const copyOnly = (prev: Thing) => ({ ...prev });
const copyTwo = (first: Thing, second: Thing) => ({ ...first, ...second });
const copyBetween = (prev: Thing, x: unknown, y: unknown) => ({ x, ...prev, y });
const restOf = ({ x, ...rest }: Thing) => rest;
const restWithoutKey = (p: Bag, k: string) => {
  const { [k]: gone, ...rest } = p;
  return rest;
};
const constants = () => ({ x: 3, tag: "p" });
const constantsThenStore = (v: unknown) => {
  const p: Bag = { x: 3, tag: "p" };
  p.y = v;
  return p;
};
const constantsThenStoreOnOnePath = (v: unknown, c: boolean) => {
  const p: Bag = { x: 3, tag: "p" };
  if (c) p.x = v;
  return p;
};
const constantsNested = () => ({ x: { n: 1 }, list: [1, 2, 3], tag: "p" });
const assigned = (prev: Thing, x: unknown) => Object.assign({ x }, prev);
const copyOfCopy = (prev: Thing, x: unknown) => ({ ...copyThenName(prev, x) });

let sum = 0;
let same = 0;
for (let i = 0; i < 400; i++) {
  const inner: Thing = { tag: "inner", n: i };
  const prev: Thing = { tag: "prev", n: i, a: inner, x: "of prev" };
  const bare: Thing = { tag: "bare", n: i, a: inner };
  const mine = { mine: i };

  const r1 = copyThenName(prev, mine);
  const r2 = nameThenCopy(prev, mine);
  const r3 = nameThenCopy(bare, mine);
  const r4 = copyOnly(prev);
  const r5 = copyTwo(prev, bare);
  const r6 = copyBetween(prev, mine, mine);
  const r7 = restOf(prev);
  const r8 = restWithoutKey(prev as unknown as Bag, i % 2 ? "a" : "n");
  const r9 = constants();
  const r10 = constantsThenStore(mine);
  const r11 = constantsThenStoreOnOnePath(mine, i % 3 === 0);
  const r12 = constantsNested();
  const r13 = assigned(prev, mine);
  const r14 = copyOfCopy(prev, mine);

  same += +(r1.x === mine) + +(r1.a === inner) + +(r1.tag === "prev") + +(r1.n === i);
  same += +(r2.x === "of prev") + +(r2.a === inner) + +(r3.x === mine) + +(r3.a === inner);
  same += +(r4.x === "of prev") + +(r4.a === inner) + +((r4 as Thing) !== prev);
  same += +(r5.tag === "bare") + +(r5.x === "of prev") + +(r5.a === inner);
  same += +(r6.x === "of prev") + +(r6.y === mine) + +(r6.n === i);
  same += +(r7.a === inner) + +!("x" in r7) + +(r7.tag === "prev");
  same += +(("a" in r8) === (i % 2 === 0)) + +(("n" in r8) === (i % 2 === 1)) + +(r8.x === "of prev");
  same += +(r9.x === 3) + +(r9.tag === "p") + +(r10.x === 3) + +(r10.y === mine) + +(r10.tag === "p");
  same += +(r11.x === (i % 3 === 0 ? mine : 3)) + +(r11.tag === "p");
  same += +(r12.x.n === 1) + +(r12.list[2] === 3) + +(r12.list.length === 3);
  same += +(r13.x === "of prev") + +(r13.a === inner) + +(r14.x === mine) + +(r14.a === inner) + +(r14.n === i);

  prev.n = -1;
  prev.a = null;
  r9.x = 4;
  r12.x.n = 2;
  r12.list.push(4);
  sum += r1.n + r4.n + r14.n + (r1.a === inner ? 1 : 0) + constants().x + constantsNested().x.n + constantsNested().list.length;
  r1.n = -2;
  sum += prev.n;
}
say("in the loop", same, sum);

const hidden = Symbol("hidden");
const proto = { inherited: "from the prototype" };
const rich: Bag = Object.create(proto);
rich.plain = 1;
rich[hidden as unknown as string] = "by a symbol";
Object.defineProperty(rich, "unseen", { value: "not enumerable", enumerable: false });
let reads = 0;
Object.defineProperty(rich, "computed", { get: () => ++reads, enumerable: true });
const copies = [0, 1, 2].map(() => copyOnly(rich as unknown as Thing) as unknown as Bag);
say("a getter is read once a copy", copies.map(c => c.computed), reads);
say("what is copied", copies[0], "inherited" in copies[0], "unseen" in copies[0], Object.getPrototypeOf(copies[0]) === Object.prototype);
say("the copy has a value where the source has a getter", Object.getOwnPropertyDescriptor(copies[2], "computed"));

const spreadAnything = (v: unknown, x: unknown) => ({ ...(v as object), x });
say("of null and undefined", spreadAnything(null, 1), spreadAnything(undefined, 2));
say("of a string, an array, a number", spreadAnything("ab", 1), spreadAnything([7, 8], 2), spreadAnything(5, 3));
say("of a key that looks like the prototype", Object.getPrototypeOf(spreadAnything(JSON.parse('{"__proto__":{"evil":1}}'), 1)) === Object.prototype);

const asked: string[] = [];
const keptByTraps: unknown[] = [];
const watched = new Proxy({ x: "of the target", z: 1 } as Bag, {
  ownKeys(target) {
    asked.push("ownKeys");
    return Reflect.ownKeys(target);
  },
  getOwnPropertyDescriptor(target, key) {
    asked.push("descriptor " + String(key));
    return Reflect.getOwnPropertyDescriptor(target, key);
  },
  get(target, key, receiver) {
    asked.push("get " + String(key));
    keptByTraps.push(receiver);
    return Reflect.get(target, key, receiver);
  },
});
say("of a proxy", nameThenCopy(watched as unknown as Thing, "mine"), asked.join(), keptByTraps.every(r => r === watched));

const throwing = Object.defineProperty({ before: 1 } as Bag, "bad", {
  get() {
    throw new Error("from the getter");
  },
  enumerable: true,
});
try {
  copyThenName(throwing as unknown as Thing, 1);
} catch (e) {
  say("a getter that throws", (e as Error).message);
}

const order = copyBetween({ tag: "t", n: 1, y: "early", x: "late" }, "first", "last");
say("the order of the keys", Object.keys(order).join());
say("numbers come first", Object.keys(spreadAnything({ b: 1, 2: 1, a: 1, 1: 1 }, 0)).join());

console.log(lines.join("\n"));
//// what-a-result-lacks-is-found-above.js
// A member that a helper stores on one path only is not `undefined` on the other: the read goes on to the prototype that the literal names.
// And a store is no store where the prototype has a setter, or a member that may not be written.
const lines = [];
function onOnePath(c, v, above) {
  const o = { __proto__: above, always: v };
  if (c) o.maybe = v;
  return o;
}
function onEveryPath(v, above) {
  const o = { __proto__: above, always: v };
  o.maybe = v;
  return o;
}
function never(v, above) {
  return { __proto__: above, always: v };
}
function changedLater(c, v, above) {
  const o = { always: v };
  if (c) o.maybe = v;
  Object.setPrototypeOf(o, above);
  return o;
}
function count(name, f) {
  const seen = new Map();
  for (let i = 0; i < 300; i++) {
    let what;
    try {
      what = f(i);
    } catch (e) {
      what = "throws a " + e.constructor.name;
    }
    seen.set(what, (seen.get(what) ?? 0) + 1);
  }
  lines.push(name + ": " + [...seen].map(([k, n]) => String(k) + " x" + n).join(", "));
}
const mine = "mine";
let reads = 0;
const taken = [];
const kinds = {
  "nothing above": {},
  "null above": null,
  "a value above": { maybe: "from above" },
  "an accessor above": {
    get maybe() {
      reads++;
      return "from the getter above";
    },
    set maybe(v) {
      taken.push(v);
    },
  },
  "a getter alone above": {
    get maybe() {
      return "from the getter alone";
    },
  },
  "a frozen value above": Object.freeze({ maybe: "frozen above" }),
  "two steps above": Object.create({ maybe: "from two steps above" }),
};
for (const [name, above] of Object.entries(kinds)) {
  count(name + ", one path", i => onOnePath(i % 3 === 0, mine, above).maybe);
  count(name + ", every path", i => onEveryPath(mine, above).maybe);
  count(name + ", never", i => never(mine, above).maybe);
  count(name + ", changed later", i => changedLater(i % 3 === 0, mine, above).maybe);
  count(name + ", own", i => Object.hasOwn(onEveryPath(mine, above), "maybe"));
}
lines.push("the getter ran " + reads + " times, the setter took " + taken.length);
console.log(lines.join("\n"));
//// what-is-read-out-of-a-parameter-may-not-be-there.ts
// "The result is an element of parameter 0", "the result is field f of parameter 1": the caller knows what it put there and concludes the kind of the answer. But the index is past the end, the element is a hole, the key is missing or inherited, the collection was changed on the way: the answer is undefined, or something that the caller never stored.
function first<T>(list: T[]): T {
  return list[0];
}
function last<T>(list: T[]): T {
  return list[list.length - 1];
}
function at<T>(list: T[], i: number): T {
  return list[i];
}
function atMethod<T>(list: T[], i: number): T | undefined {
  return list.at(i);
}
function popped<T>(list: T[]): T | undefined {
  return list.pop();
}
function shifted<T>(list: T[]): T | undefined {
  return list.shift();
}
function found<T>(list: T[], test: (x: T) => boolean): T | undefined {
  return list.find(test);
}
function byKey<T>(o: Record<string, T>, key: string): T {
  return o[key];
}
function fromMap<K, V>(map: Map<K, V>, key: K): V | undefined {
  return map.get(key);
}
function field(o: { f?: number }): number | undefined {
  return o.f;
}
function nested(o: { inner?: { f: number } }): number | undefined {
  return o.inner?.f;
}
function firstOfPattern<T>([head]: T[]): T {
  return head;
}
function secondOfPattern<T>([, second = "default" as T]: T[]): T {
  return second;
}
function fieldOfPattern({ f = -1 }: { f?: number }): number {
  return f;
}
function restOfPattern<T>([, ...rest]: T[]): T[] {
  return rest;
}
////= lines-27	plusOne	n	1
let warm = 0;
for (let i = 0; i < 2000; i++) {
  const list = [i, i + 1, i + 2];
  warm += plusOne(first(list)) + plusOne(last(list)) + plusOne(at(list, 1)) + plusOne(atMethod(list, -1)!) + plusOne(found(list, x => x > i)!) + plusOne(byKey({ a: i }, "a")) + plusOne(fromMap(new Map([[1, i]]), 1)!) + plusOne(field({ f: i })!) + plusOne(nested({ inner: { f: i } })!);
  warm += plusOne(firstOfPattern(list)) + plusOne(secondOfPattern(list)) + plusOne(fieldOfPattern({ f: i })) + restOfPattern(list).length + plusOne(popped(list)!) + plusOne(shifted(list)!);
}
console.log(warm);
const empty: number[] = [];
console.log([first(empty), last(empty), at(empty, 0), at([1, 2], 2), at([1, 2], -1), at([1, 2], 1.5), at([1, 2], NaN), atMethod([1, 2], 2), atMethod([1, 2], -3), popped(empty), shifted(empty), found([1, 2], x => x > 5)].map(String).join());
console.log([plusOne(first(empty)), plusOne(last(empty)), plusOne(at([1, 2], 2)), plusOne(popped(empty)!), plusOne(fromMap(new Map<number, number>(), 1)!), plusOne(field({})!), plusOne(nested({})!), plusOne(byKey({}, "a"))].join());
console.log([first([, 1] as number[]), at([1, , 3] as number[], 1), firstOfPattern(empty), secondOfPattern([1]), secondOfPattern([1, undefined as unknown as number]), secondOfPattern([1, null as unknown as number]), fieldOfPattern({}), fieldOfPattern({ f: undefined }), restOfPattern(empty).length, restOfPattern([1]).length].map(String).join());

// Keys that every object answers.
const bag: Record<string, number> = { a: 1 };
console.log(["a", "b", "constructor", "toString", "__proto__", "hasOwnProperty", "valueOf", ""].map(key => typeof byKey(bag, key)).join());
const bare: Record<string, number> = Object.assign(Object.create(null), { a: 1 });
console.log(["a", "constructor", "__proto__"].map(key => typeof byKey(bare, key)).join());
console.log(["0", "length", "push", "-1", "1"].map(key => typeof byKey([7] as unknown as Record<string, number>, key)).join(), typeof byKey("text" as unknown as Record<string, number>, "0"), typeof byKey("text" as unknown as Record<string, number>, "length"));

// The collection is changed between the caller's store and the helper's read.
function readAfter<T>(list: T[], change: (list: T[]) => void): T {
  change(list);
  return list[0];
}
console.log([readAfter([1, 2], l => l.shift()), readAfter([1, 2], l => (l.length = 0)), readAfter([1, 2], l => l.reverse()), readAfter<number | string>([1, 2], l => (l[0] = "text")), readAfter([1, 2], l => delete l[0]), readAfter([1, 2], l => l.unshift(0.5)), readAfter([1, 2], l => l.fill(-0)), readAfter([1, 2], l => l.splice(0, 1, 9, 8))].map(x => (Object.is(x, -0) ? "-0" : String(x))).join());

// What comes out is the very object that went in, and taking it out of the collection does not end it.
////= churn-3
////= lines-6	Thing	tag
const keptThings: Thing[] = [];
let same = 0;
for (let i = 0; i < 300; i++) {
  const a: Thing = { tag: "a" + i };
  const b: Thing = { tag: "b" + i };
  if (first([a, b]) === a && last([a, b]) === b && at([a, b], 1) === b && popped([a, b]) === b && shifted([a, b]) === a && found([a, b], x => x === b) === b && byKey({ a, b }, "b") === b && fromMap(new Map([[a, b]]), a) === b && firstOfPattern([a]) === a && restOfPattern([a, b])[0] === b) same++;
  if (i % 100 === 99) keptThings.push(popped([{ tag: "popped " + i }])!, first([{ tag: "first " + i }]), fromMap(new Map([[1, { tag: "out of a map " + i }]]), 1)!, byKey({ k: { tag: "out of a literal " + i } }, "k"), restOfPattern([a, { tag: "rest " + i }])[0]);
}
console.log(same, churn(60), keptThings.map(t => t.tag).join(" | "));

// Lists of one kind at one site and of another kind at the next.
console.log(typeof first([1]), typeof first(["s"]), typeof first([{}]), typeof first([null]), typeof first([1.5]), typeof first([() => 1]), typeof first([1n]), typeof first([[1]]), typeof first<unknown>([undefined]), typeof first([true]), typeof first([Symbol()]));
console.log(plusOne(first([2147483647])), plusOne(first([0.5])), plusOne(first([-1])), Object.is(first([-0]), -0), first([NaN]) === first([NaN]));

// Typed arrays, strings, arguments objects, array-likes.
function firstOfAny(list: ArrayLike<unknown>): unknown {
  return list[0];
}
function argumentsOf(..._: unknown[]): IArguments {
  return (function () {
    return arguments;
  })
    // @ts-ignore: the inner function takes what it is given
    .apply(null, _);
}
