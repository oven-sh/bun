const b = { tag: "b" };
console.log(defaultFromAnother(a) === a, defaultFromAnother(a, undefined) === a, defaultFromAnother(a, b) === b, defaultIsFresh(a) === a, defaultIsFresh() === defaultIsFresh(), defaultIsFresh(undefined).tag);
