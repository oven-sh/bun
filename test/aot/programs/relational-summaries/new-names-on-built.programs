//// what-only-a-frame-holds-lives-through-collections.ts
// An object or a closure that lies in a frame, or was taken apart into scalars, may hold the only reference to cells of the heap. The collector runs inside the callee, at every depth, young and full: it must find those cells through the frame, and must not take what lies in a frame for a cell.
import { edenGC, fullGC } from "bun:jsc";
////= lines-2	Leaf	n	text	string
interface Holder {
  leaf: Leaf;
  list: Leaf[];
  inner: { leaf: Leaf };
  read: () => Leaf;
}
function leaf(n: number): Leaf {
  return { n, text: "leaf " + n };
}
////= garbage	{ i }, "g" + i]
function collect(kind: number): void {
  if (kind % 3 === 0) edenGC();
  else if (kind % 3 === 1) fullGC();
  else garbage(400);
}
function check(l: Leaf, n: number): number {
  return l.n === n && l.text === "leaf " + n ? 1 : 0;
}
function readsAfterCollecting(h: Holder, n: number, kind: number): number {
  collect(kind);
  garbage(50);
  return check(h.leaf, n) + check(h.list[0], n + 1) + check(h.list[1], n + 2) + check(h.inner.leaf, n + 3) + check(h.read(), n + 4);
}
function deeper(h: Holder, n: number, kind: number, depth: number): number {
  const mine = { leaf: leaf(n + 100 + depth) };
  const below = depth === 0 ? readsAfterCollecting(h, n, kind) : deeper(h, n, kind, depth - 1);
  return below + check(mine.leaf, n + 100 + depth);
}
function caller(n: number, kind: number): number {
  const captured = leaf(n + 4);
  const holder: Holder = { leaf: leaf(n), list: [leaf(n + 1), leaf(n + 2)], inner: { leaf: leaf(n + 3) }, read: () => captured };
  return deeper(holder, n, kind, n % 5);
}
let good = 0;
let expected = 0;
for (let i = 0; i < 120; i++) {
  good += caller(i, i);
  expected += 5 + (i % 5) + 1;
}
console.log(good === expected, good);

// The callee writes a new cell into the caller's object, then collects, then the caller reads.
function refill(h: { leaf: Leaf | null }, n: number, kind: number): void {
  h.leaf = leaf(n);
  collect(kind);
}
function refilled(n: number, kind: number): number {
  const h: { leaf: Leaf | null } = { leaf: null };
  refill(h, n, kind);
  garbage(50);
  const first = check(h.leaf!, n);
  refill(h, n + 1, kind + 1);
  return first + check(h.leaf!, n + 1);
}
good = 0;
for (let i = 0; i < 90; i++) good += refilled(i, i);
console.log(good);

// Closures: the variable is written by the callee through the closure, between collections.
function callTwice(set: (l: Leaf) => void, n: number, kind: number): void {
  set(leaf(n));
  collect(kind);
  set(leaf(n + 1));
  collect(kind + 1);
}
function written(n: number, kind: number): number {
  let last: Leaf | null = null;
  const history: Leaf[] = [];
  callTwice(l => {
    last = l;
    history.push(l);
  }, n, kind);
  garbage(50);
  return check(last!, n + 1) + check(history[0], n) + check(history[1], n + 1);
}
good = 0;
for (let i = 0; i < 90; i++) good += written(i, i);
console.log(good);

// Fresh results of fresh results, each holding cells, with collections while they are put together.
function build(n: number, kind: number): { a: { leaf: Leaf }; b: { leaf: Leaf } } {
  const a = { leaf: leaf(n) };
  collect(kind);
  const b = { leaf: leaf(n + 1) };
  collect(kind + 1);
  return { a, b };
}
function usesBuilt(n: number, kind: number): number {
  const built = build(n, kind);
  collect(kind + 2);
  return check(built.a.leaf, n) + check(built.b.leaf, n + 1);
}
good = 0;
for (let i = 0; i < 90; i++) good += usesBuilt(i, i);
console.log(good);

// Strings, ropes, big integers, symbols, numbers that are cells: everything a field can hold.
function mixed(n: number): { rope: string; big: bigint; double: number; symbol: symbol; date: Date; regexp: RegExp } {
  return { rope: "rope " + n + " " + "x".repeat(n % 7), big: BigInt(n) ** 5n, double: n + 0.5, symbol: Symbol("s" + n), date: new Date(n * 1000), regexp: new RegExp("r" + n) };
}
function describeAfterCollecting(m: ReturnType<typeof mixed>, kind: number): string {
  collect(kind);
  garbage(50);
  return [m.rope, m.big, m.double, m.symbol.description, m.date.getTime(), m.regexp.source].join("|");
}
let text = "";
for (let i = 0; i < 60; i++) text = describeAfterCollecting(mixed(i), i);
console.log(text);

// Rest arrays, argument lists and spreads made for a call.
function restAfterCollecting(kind: number, ...leaves: Leaf[]): number {
  collect(kind);
  garbage(50);
  let sum = 0;
  for (let i = 0; i < leaves.length; i++) sum += check(leaves[i], i);
  return sum;
}
good = 0;
for (let i = 0; i < 60; i++) good += restAfterCollecting(i, leaf(0), leaf(1), leaf(2)) + restAfterCollecting(i, ...[leaf(0), leaf(1)]);
console.log(good);

// An exception unwinds frames that hold objects; the handler collects and goes on with its own.
function throwsAfterAllocating(n: number): never {
  const doomed = { leaf: leaf(n) };
  throw new Error("thrown with " + doomed.leaf.text);
}
function catches(n: number, kind: number): number {
  const mine = { leaf: leaf(n) };
  try {
    throwsAfterAllocating(n + 1);
  } catch (error) {
    collect(kind);
    return check(mine.leaf, n) + ((error as Error).message === "thrown with leaf " + (n + 1) ? 1 : 0);
  }
}
good = 0;
for (let i = 0; i < 60; i++) good += catches(i, i);
console.log(good);
//// what-the-callee-passes-back-the-caller-may-keep.ts
// A callee that returns its parameter, wraps it in what it returns, or hangs it into another parameter keeps nothing itself: what becomes of the value is decided by what the CALLER does with the answer or with the other operand, perhaps much later, perhaps in the caller's caller.
////= churn
type Read = () => string;
interface Box<T> {
  content: T;
}
////= lines-26	identity	x
function firstOf<T>(a: T, b: T): T {
  return a;
}
function either<T>(a: T, b: T, first: boolean): T {
  return first ? a : b;
}
function wrap<T>(x: T): Box<T> {
  return { content: x };
}
function wrapTwice<T>(x: T): Box<Box<T>> {
  return wrap(wrap(x));
}
function pairUp<T>(a: T, b: T): [T, T] {
  return [a, b];
}
function thunk<T>(x: T): () => T {
  return () => x;
}
function attach<T>(box: Box<T | null>, x: T): void {
  box.content = x;
}
function attachAndReturn<T>(box: Box<T | null>, x: T): Box<T | null> {
  box.content = x;
  return box;
}
function through<T>(x: T): T {
  return identity(identity(identity(x)));
}
const keptReads: Read[] = [];
const keptBoxes: Box<unknown>[] = [];
const rare = (n: number) => n % 90 === 89;
// The caller keeps the answer on a rare path.
function caller(i: number): number {
  const state = { tag: "state" + i };
  const a = identity(() => "identity " + state.tag);
  const b = firstOf(() => "first " + state.tag, () => "never");
  const c = either(() => "left " + state.tag, () => "right " + state.tag, i % 2 === 0);
  const d = wrap(() => "wrapped " + state.tag);
  const e = wrapTwice(() => "wrapped twice " + state.tag);
  const f = pairUp(() => "pair 0 " + state.tag, () => "pair 1 " + state.tag);
  const g = thunk(() => "thunk " + state.tag);
  const h: Box<Read | null> = { content: null };
  attach(h, () => "attached " + state.tag);
  const j = attachAndReturn({ content: null } as Box<Read | null>, () => "attached and returned " + state.tag);
  const k = through(() => "through " + state.tag);
  if (rare(i)) {
    keptReads.push(a, b, c, f[1], g(), k);
    keptBoxes.push(d, e, h, j);
  }
  return a().length + b().length + c().length + d.content().length + e.content.content().length + f[0]().length + g()().length + h.content!().length + j.content!().length + k().length;
}
let sum = 0;
for (let i = 0; i < 270; i++) sum += caller(i);
console.log(sum, churn(80));
console.log(keptReads.map(f => f()).join(" | "));
function open(box: Box<unknown>): string {
  const inner = box.content;
  return typeof inner === "function" ? inner() : open(inner as Box<unknown>);
}
console.log(keptBoxes.map(open).join(" | "));

// The caller returns the answer, and ITS caller keeps it.
function middle(i: number): Read {
  const state = { tag: "middle" + i };
  return identity(() => state.tag);
}
function middleBox(i: number): Box<Read> {
  const state = { tag: "middle box" + i };
  return wrap(() => state.tag);
}
function top(i: number): number {
  const read = middle(i);
  const box = middleBox(i);
  if (rare(i)) keptReads.push(read, box.content);
  return read().length + box.content().length;
}
keptReads.length = 0;
for (let i = 0; i < 270; i++) sum += top(i);
console.log(sum, churn(80), keptReads.map(f => f()).join(" | "));

// The other operand is long-lived.
const longLived: Box<Read | null> = { content: null };
const shelf: Box<Read | null>[] = [];
function fills(i: number): void {
  const state = { tag: "filled" + i };
  attach(longLived, () => state.tag);
  const fresh: Box<Read | null> = { content: null };
  attach(fresh, () => "on the shelf " + state.tag);
  if (rare(i)) shelf.push(fresh);
}
for (let i = 0; i < 270; i++) fills(i);
console.log(churn(80), longLived.content!(), shelf.map(b => b.content!()).join(" | "));

// The answer is kept first and the value is made reachable afterwards.
const early: Box<Read | null>[] = [];
function keptThenFilled(i: number): void {
  const box: Box<Read | null> = { content: null };
  if (rare(i)) early.push(box);
  const state = { tag: "filled after it was kept " + i };
  attach(box, () => state.tag);
}
for (let i = 0; i < 270; i++) keptThenFilled(i);
console.log(churn(80), early.map(b => b.content!()).join(" | "));

// The answer is compared with what went in, and both are used.
let same = 0;
for (let i = 0; i < 200; i++) {
  const o = { n: i };
  const p = { n: -i };
  if (identity(o) === o) same++;
  if (either(o, p, i % 2 === 0) === (i % 2 === 0 ? o : p)) same++;
  if (wrap(o).content === o) same++;
  if (pairUp(o, p)[1] === p) same++;
  if (thunk(o)() === o) same++;
  if (wrap(o) !== wrap(o)) same++;
  identity(o).n++;
  wrap(o).content.n++;
  if (o.n === i + 2) same++;
}
console.log(same);
