  apply(chain);
  show(`${change} call`, () => call(chain.bottom, 2));
  show(`${change} read`, () => read(chain.bottom));
  for (let i = 0; i < 300; i++) { try { call(chain.bottom, i); } catch {} read(chain.bottom); }
  show(`${change} warm again`, () => [call(chain.bottom, 3), read(chain.bottom)]);
