//// evaluated-text-environments.js
// Functions made from text at run time whose variables are captured, so that each call, each block and each turn of a loop makes an environment: with none, one, two, many variables,
// let and const that are read too early, async functions and generators, `this` in strict and sloppy code. Each case runs many times: the first environments of a scope are made the long way.
const lines = [];
async function show(name, run, turns = 8) {
  const seen = [];
  for (let turn = 0; turn < turns; turn++) {
    try {
      seen.push(JSON.stringify(await run(turn)) ?? "undefined");
    } catch (error) {
      seen.push(error.constructor.name);
    }
  }
  const distinct = new Set(seen.map(text => text.replace(/\d+/g, "#")));
  lines.push(name + ": " + distinct.size + " form(s): " + seen[0] + " | " + seen[1] + " | " + seen[2] + " | " + seen[turns - 1]);
}
const make = (parameters, text) => new Function(...parameters, text);

await show("one captured parameter", make(["a"], "return (() => a)();"));
await show("two captured variables", make(["a"], "let b = a + 1; return (() => [a, b])();"));
await show("three, four, five", make(["a"], "let b = a + 1, c = a + 2; const d = a + 3; var e = a + 4; return [(() => [a, b, c])(), (() => [a, b, c, d])(), (() => [a, b, c, d, e])()];"));
await show("forty captured variables", (() => {
  const names = Array.from({ length: 40 }, (_, i) => "v" + i);
  return make(["a"], names.map((n, i) => `let ${n} = a + ${i};`).join("") + "return (() => " + names.join(" + ") + ")();");
})());
await show("two thousand captured variables", (() => {
  const names = Array.from({ length: 2000 }, (_, i) => "v" + i);
  return make(["a"], names.map((n, i) => `let ${n} = a + ${i};`).join("") + "return (() => v0 + v1 + v999 + v1999)();");
})());
await show("an environment for each turn of a loop", make(["a"], "const list = []; for (let i = 0; i < 4; i++) { let twice = i * 2; list.push(() => [a, i, twice]); } return list.map(f => f());"));
await show("each closure keeps its own", make(["a"], "const list = []; for (let i = 0; i < 3; i++) list.push([() => i, () => { i += a; }]); list[1][1](); return list.map(pair => pair[0]());"));
await show("a block with let read too early", make(["a"], "{ const early = () => late; try { return early(); } catch (error) { return [error.constructor.name, a]; } let late = 1; }"));
await show("var is undefined, let is not there yet", make(["a"], "const seen = [(() => typeof early)()]; try { (() => late)(); } catch (error) { seen.push(error.constructor.name); } var early = a; let late = a; seen.push((() => [early, late])()); return seen;"));
await show("nested blocks", make(["a"], "let r = []; { let b = a; { let c = b + 1; { let d = c + 1; r.push(() => [a, b, c, d]); } } } return r[0]();"));
await show("switch and catch", make(["a"], "switch (a & 1) { case 0: { let x = 'even'; return (() => x)(); } default: try { throw a; } catch (caught) { return (() => caught)(); } }"));
await show("an async function", make(["a"], "return (async function (c) { try { const r = await c; return [r, a]; } catch (error) { return 'caught'; } })(a + 1);"));
await show("an async arrow that captures", make(["a"], "const add = async b => { const c = await b; return (() => a + c)(); }; return add(10);"));
await show("an async function that throws behind an await", make(["a"], "return (async function () { await 0; let late = (() => late)(); return late; })().catch(error => [error.constructor.name, a]);"));
await show("a generator", make(["a"], "function* g(n) { for (let i = 0; i < n; i++) { const f = () => i + a; yield f(); } } return [...g(3)];"));
await show("an async generator", make(["a"], "return (async () => { const all = []; for await (const v of (async function* () { let i = a; yield (() => i)(); i++; yield (() => i)(); })()) all.push(v); return all; })();"));
await show("this in strict code", make(["a"], "'use strict'; function f() { return this; } return [f() === undefined, f.call(a), typeof f.call('s'), f.call(null), f.call(true), typeof f.call({})];"));
await show("this in sloppy code", make(["a"], "function f() { return this; } return [f() === globalThis, typeof f.call(a), typeof f.call('s'), f.call(null) === globalThis, typeof f.call(true), typeof f.call({})];"));
await show("this in a strict async function", make(["a"], "'use strict'; return (async function () { return [this === undefined, a]; })();"));
await show("environments that are kept while many more are made", (() => {
  const kept = [];
  const one = make(["a"], "let b = a * 2, c = 'text' + a; return () => [a, b, c];");
  return turn => { for (let i = 0; i < 2000; i++) { const f = one(turn * 2000 + i); if (i % 500 === 0) kept.push(f); } return kept.slice(-3).map(f => f()); };
})());
console.log(lines.join("\n"));
//// evaluated-text-extra-properties-of-compiled-objects.js
// Text that is made at run time reads properties that compiled objects got behind their construction, at places that have run often:
// from objects whose properties came in another order, in other numbers, were deleted, redefined, shadowed, or never came.
function Holder(def) {
  this.def = def;
  this.traits = 1;
}
function Other(def) {
  this.traits = 2;
  this.def = def;
  this.more = 3;
}
function make(Constructor, names) {
  const holder = new Constructor(names.join("+"));
  for (const name of names) holder[name] = name + "#" + names.length;
  return holder;
}
const lines = [];
function show(label, f) {
  try {
    lines.push(label + ": " + String(f()));
  } catch (error) {
    lines.push(label + ": throws " + error.constructor.name);
  }
}
function reader(text) {
  return new Function("object", text);
}
const many = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "run", "check"];
const kinds = {
  runThenCheck: () => make(Holder, ["run", "check"]),
  checkThenRun: () => make(Holder, ["check", "run"]),
  onlyRun: () => make(Holder, ["run"]),
  onlyCheck: () => make(Holder, ["check"]),
  nothing: () => make(Holder, []),
  many: () => make(Holder, many),
  manyBackwards: () => make(Holder, many.toReversed()),
  otherLayout: () => make(Other, ["run", "check"]),
  ordinary: () => ({ def: "ordinary", run: "run of an ordinary object", check: "check of an ordinary object" }),
  withoutPrototype: () => Object.assign(Object.create(null), { run: "bare" }),
  inherits: () => Object.create(make(Holder, ["run", "check"])),
  string: () => "text",
  number: () => 7,
  undefined: () => undefined,
  null: () => null,
};
const texts = {
  run: "return object.run",
  all: "return object.run + '|' + object.check + '|' + object.def + '|' + object.traits",
  twice: "const first = object.run; const second = object.run; return first === second",
  last: "return object.l + '|' + object.a",
};
for (const warmWith of ["runThenCheck", "many", "otherLayout", "ordinary", "nothing"]) {
  for (const [name, text] of Object.entries(texts)) {
    const read = reader(text);
    const warm = kinds[warmWith]();
    for (let i = 0; i < 300; i++) read(warm);
    for (const [kind, create] of Object.entries(kinds)) show(`${warmWith} ${name} ${kind}`, () => read(create()));
    show(`${warmWith} ${name} again`, () => read(warm));
  }
}

const changes = {
  deleted(object) { delete object.run; },
  deletedAndStoredAgain(object) { delete object.run; object.run = "again"; },
  otherDeleted(object) { delete object.check; },
  stored(object) { object.run = "stored"; },
  storedUndefined(object) { object.run = undefined; },
  getter(object) { Object.defineProperty(object, "run", { get() { return "getter of " + this.def; }, configurable: true }); },
  getterThenValue(object) {
    Object.defineProperty(object, "run", { get() { return "getter"; }, configurable: true });
    Object.defineProperty(object, "run", { value: "value again", writable: true, configurable: true, enumerable: true });
  },
  readOnly(object) { Object.defineProperty(object, "run", { value: "read only", writable: false }); },
  hidden(object) { Object.defineProperty(object, "run", { enumerable: false }); },
  frozen(object) { Object.freeze(object); },
  sealed(object) { Object.seal(object); },
  moreProperties(object) { for (let i = 0; i < 40; i++) object["p" + i] = i; },
  otherPrototype(object) { Object.setPrototypeOf(object, { run: "of the new prototype", extra: 1 }); },
  otherPrototypeAndDeleted(object) { Object.setPrototypeOf(object, { run: "of the new prototype" }); delete object.run; },
  fieldDeleted(object) { delete object.def; },
  elements(object) { object[0] = "element"; object[5] = "another"; },
};
for (const [change, apply] of Object.entries(changes)) {
  for (const kind of ["runThenCheck", "many", "otherLayout"]) {
    const read = reader(texts.all);
    const object = kinds[kind]();
    const untouched = kinds[kind]();
    for (let i = 0; i < 300; i++) read(object);
    apply(object);
    show(`${change} ${kind}`, () => read(object));
    show(`${change} ${kind} untouched`, () => read(untouched));
    show(`${change} ${kind} keys`, () => Object.keys(object).length);
    for (let i = 0; i < 300; i++) read(object);
    show(`${change} ${kind} warm again`, () => read(object));
  }
}

// What lies in a compiled object ABOVE an ordinary receiver: values of every kind, methods, getters; and what happens to the holder, to the receiver and to the chain behind a warm place.
function makeHolder() {
  return {
    whole: 5, fraction: 1.5, truth: true, text: "text", nothing: null, missing: undefined, big: 2 ** 40, list: [1, 2], inner: { a: 1 },
    method() { return "method of " + typeof this; },
    arrow: () => "arrow",
    get got() { return "got by " + (this === undefined ? "nothing" : Object.keys(this).length); },
  };
}
const namesAbove = ["whole", "fraction", "truth", "text", "nothing", "missing", "big", "list", "inner", "method", "arrow", "got", "absent"];
const changesAbove = {
  none() {},
  storedInHolder(holder, receiver, name) { holder[name] = "stored in the holder"; },
  otherKindInHolder(holder, receiver, name) { holder[name] = typeof holder[name] === "number" ? "no number now" : 77; },
  deletedInHolder(holder, receiver, name) { delete holder[name]; },
  getterInHolder(holder, receiver, name) { Object.defineProperty(holder, name, { get() { return "new getter"; }, configurable: true }); },
  ownInReceiver(holder, receiver, name) { receiver[name] = "own"; },
  ownThenDeleted(holder, receiver, name) { receiver[name] = "own"; delete receiver[name]; },
  receiverGetsOtherPrototype(holder, receiver) { Object.setPrototypeOf(receiver, { whole: "elsewhere", method: "elsewhere" }); },
  holderGetsOtherPrototype(holder) { Object.setPrototypeOf(holder, { absent: "now above the holder" }); },
  holderFrozen(holder) { Object.freeze(holder); },
  holderGetsMore(holder) { for (let i = 0; i < 30; i++) holder["more" + i] = i; },
};
for (const [change, apply] of Object.entries(changesAbove)) {
  for (const depth of [1, 2]) {
    for (const name of namesAbove) {
      const read = reader("const value = object." + name + "; return typeof value === 'function' ? value.call(object) : typeof value === 'object' && value ? JSON.stringify(value) : value");
      const holder = makeHolder();
      const receiver = depth === 1 ? Object.create(holder) : Object.create(Object.create(holder));
      for (let i = 0; i < 300; i++) read(receiver);
      const before = String(read(receiver));
      show(`above ${change} ${depth} ${name} changes`, () => apply(holder, receiver, name));
      show(`above ${change} ${depth} ${name}`, () => before + " > " + String(read(receiver)));
      for (let i = 0; i < 300; i++) read(receiver);
      show(`above ${change} ${depth} ${name} warm again`, () => read(receiver));
    }
  }
}

// One place, objects in turn.
const inTurn = reader(texts.all);
const turn = Object.values(kinds).slice(0, 10).map(create => create());
let sum = 0;
for (let i = 0; i < 3000; i++) sum += inTurn(turn[i % turn.length]).length;
lines.push("in turn: " + sum);

// The objects of a place die, and others of the same making come.
const afterCollections = reader(texts.all);
for (let round = 0; round < 4; round++) {
  let object = make(Holder, ["run", "round" + round, "check"]);
  for (let i = 0; i < 300; i++) afterCollections(object);
  show("round " + round, () => afterCollections(object));
  object = null;
  if (typeof Bun !== "undefined") Bun.gc(true);
}
console.log(lines.join("\n"));
//// evaluated-text-for-in.js
// Functions made from text at run time that walk the names of an object with for-in and, inside the loop, read the object under the name, ask whether it has the name, and change it.
// The objects: of the text's own literals, of compiled code's literals and classes, arrays, strings, objects with inherited names, with indexed names, with many names, proxies.
// Each case runs several times: the first run links, the later ones take the short way.
const lines = [];
////= show
const make = (parameters, text) => new Function(...parameters, text);
class Point { x = 1; y = 2.5; label = "p"; next = null; }
class Named extends Point { name = "n"; }
const walk = make(["o"], "const all = []; for (const k in o) all.push(k, o[k]); return all;");
const ask = make(["o"], "const all = []; for (const k in o) all.push(k in o, Object.prototype.hasOwnProperty.call(o, k), Object.hasOwn(o, k)); return all;");
const sum = make(["o"], "let t = 0; for (const k in o) { const v = o[k]; if (typeof v === 'number') t += v; } return t;");

const subjects = {
  "a literal of compiled code": () => ({ a: 1, b: "two", c: null, d: [4] }),
  "an instance of a compiled class": () => new Point(),
  "an instance of a class below a class": () => new Named(),
  "an array": () => [10, 20, , 40],
  "a string object": () => new String("abc"),
  "inherited names": () => Object.create({ inherited: 1, shadowed: 2 }, { shadowed: { value: 3, enumerable: true }, hidden: { value: 4, enumerable: false } }),
  "indexed and named": () => Object.assign({ z: 1 }, { 2: "two", 0: "zero", a: 2 }),
  "an object parsed from JSON": () => JSON.parse('{"value":1,"issues":[],"more":{"x":1}}'),
  "no prototype": () => Object.assign(Object.create(null), { a: 1, b: 2 }),
  "forty names": () => Object.fromEntries(Array.from({ length: 40 }, (_, i) => ["n" + i, i])),
  "a compiled instance with one more property": () => Object.assign(new Point(), { extra: 9 }),
  "a compiled instance that lost a field": () => { const p = new Point(); delete p.y; return p; },
  "a frozen literal": () => Object.freeze({ a: 1, b: 2 }),
  "a proxy": () => new Proxy({ a: 1, b: 2 }, {}),
  "a function with properties": () => Object.assign(function f() {}, { a: 1 }),
  "a typed array": () => new Uint8Array([7, 8, 9]),
  "null and undefined": () => null,
};
for (const [name, create] of Object.entries(subjects)) {
  show("names and values: " + name, () => walk(create()));
  show("questions: " + name, () => ask(create()));
  show("a sum: " + name, () => sum(create()));
}

show("the text's own literal", make([], "return function (x) { const o = { a: x, b: x + 1, c: 'c' }; const all = []; for (const k in o) all.push(k, o[k]); return all; };")());
show("another object under the same name", make(["other"], "return function () { const o = { a: 1, b: 2 }; const all = []; for (const k in o) all.push(o[k], other[k]); return all; };")({ a: "A", b: "B" }));
show("the object loses a name in the loop", make([], "return function () { const o = { a: 1, b: 2, c: 3 }; const all = []; for (const k in o) { all.push(k, o[k]); delete o.b; } return all; };")());
show("the object gets a name in the loop", make([], "return function () { const o = { a: 1, b: 2 }; const all = []; for (const k in o) { all.push(k, o[k]); o.z = 9; } return [all, o.z]; };")());
show("a value changes in the loop", make([], "return function () { const o = { a: 1, b: 2, c: 3 }; const all = []; for (const k in o) { o.c = 'changed'; all.push(o[k]); } return all; };")());
show("the variable is assigned in the loop", make([], "return function () { const o = { a: 1, b: 2 }; const all = []; for (let k in o) { all.push(o[k]); k = 'b'; all.push(o[k]); } return all; };")());
show("one loop, objects of several kinds", (() => {
  const list = [{ a: 1 }, new Point(), [5], { b: 2, a: 3 }, new Named(), "st"];
  return () => list.map(o => walk(o));
})());
show("a loop in a loop", make(["o", "p"], "const all = []; for (const k in o) for (const j in p) all.push(k + j, o[k], p[j]); return all;").bind(null, { a: 1, b: 2 }, new Point()));
show("a getter is met", make(["o"], "const all = []; for (const k in o) all.push(o[k]); return all;").bind(null, { get g() { return "got"; }, v: 1 }));
show("three hundred temporaries around the loop", (() => {
  const names = Array.from({ length: 300 }, (_, i) => "v" + i);
  const f = make(["o"], names.map((n, i) => `let ${n} = ${i};`).join("") + "const all = []; for (const k in o) all.push(k, o[k]); return [all, " + names.join("+") + "];");
  return () => f({ a: 1, b: new Point().y });
})());

console.log(lines.join("\n"));
//// evaluated-text-getters-of-host-objects.js
// Text evaluated at run time reads the getters of the host's objects again and again: those whose answer the object keeps (url, headers, signal, body) and those that are computed each time.
// The same object twice, other objects of the class, objects of a subclass, an object with a property of its own under the name, a getter replaced on the prototype, a receiver of another class.
const lines = [];
function show(name, run, turns = 6) {
  const seen = [];
  for (let turn = 0; turn < turns; turn++) {
    try {
      seen.push(JSON.stringify(run(turn)) ?? "undefined");
    } catch (error) {
      seen.push(error.constructor.name);
    }
  }
  lines.push(name + ": " + [...new Set(seen)].join(" | "));
}
const make = (parameters, text) => new Function(...parameters, text);
const at = "http://example.com/a/b?c=";

const readUrl = make(["r"], "return r.url;");
const readTwice = make(["r"], "const u = r.url, v = r.url; return [u, u === v];");
const readMany = make(["r"], "return [r.url, r.method, r.headers === r.headers, r.signal === r.signal, typeof r.body, r.bodyUsed, r.redirect, r.keepalive, r.mode, r.cache];");
show("url of a fresh request", turn => readUrl(new Request(at + turn)));
show("url twice", turn => readTwice(new Request(at + turn)));
const kept = new Request(at + "kept", { method: "POST", body: "text", headers: { a: "1" } });
show("url of the same request", () => readUrl(kept));
show("ten getters", turn => readMany(new Request(at + turn, { method: turn & 1 ? "POST" : "PUT", body: "b" })));
show("ten getters of the same request", () => readMany(kept));
show("headers are kept and can be changed", (() => {
  const read = make(["r", "i"], "r.headers.set('x', String(i)); return [r.headers.get('x'), r.headers.get('a')];");
  return turn => read(kept, turn);
})());
show("a clone has its own", (() => {
  const read = make(["r"], "const c = r.clone(); return [c.url === r.url, c.headers === r.headers, c.headers.get('a')];");
  return () => read(kept);
})());
show("a subclass", (() => {
  class Mine extends Request { get extra() { return "extra " + this.url; } }
  const read = make(["r"], "return [r.url, r.extra, r.method];");
  return turn => read(new Mine(at + turn));
})());
show("a subclass that overrides the getter", (() => {
  class Mine extends Request { get url() { return "mine " + super.url; } }
  return turn => [readUrl(new Mine(at + turn)), readUrl(new Request(at + turn))];
})());
show("a property of its own under the name", turn => {
  const request = new Request(at + turn);
  const before = readUrl(request);
  Object.defineProperty(request, "url", { value: "own " + turn, configurable: true });
  const own = readUrl(request);
  delete request.url;
  return [before, own, readUrl(request)];
});
show("requests, responses and plain objects at one place", turn => readUrl([new Request(at + turn), new Response("x"), { url: "plain " + turn }, Response.redirect(at + turn)][turn % 4]));
show("the getter on another receiver", (() => {
  const read = make(["r"], "return Object.create(r).url;");
  return turn => read(new Request(at + turn));
})());
show("response", (() => {
  const read = make(["r"], "return [r.status, r.ok, r.statusText, r.headers === r.headers, r.headers.get('content-type'), r.url, r.type, r.redirected, r.bodyUsed, r.body === r.body];");
  return turn => read(new Response("body " + turn, { status: 200 + turn, headers: { "content-type": "text/x" + turn } }));
})());
show("blob, file and url", (() => {
  const read = make(["b", "u"], "return [b.size, b.type, u.href, u.pathname, u.searchParams === u.searchParams, u.searchParams.get('c')];");
  return turn => read(new Blob(["x".repeat(turn)], { type: "text/t" + turn }), new URL(at + turn));
})());
show("an abort signal that changes", (() => {
  const read = make(["s"], "return [s.aborted, s.reason === undefined];");
  return turn => { const controller = new AbortController(); const before = read(controller.signal); controller.abort("why"); return [before, read(controller.signal)]; };
})());
show("the getter is replaced on the prototype and put back", (() => {
  const original = Object.getOwnPropertyDescriptor(Response.prototype, "statusText");
  const read = make(["r"], "return r.statusText;");
  return turn => {
    const response = new Response("", { statusText: "text " + turn });
    const before = read(response);
    let during = "not replaced";
    try {
      Object.defineProperty(Response.prototype, "statusText", { get() { return "replaced"; }, configurable: true });
      during = read(response);
    } catch (error) {
      during = error.constructor.name;
    } finally {
      try { Object.defineProperty(Response.prototype, "statusText", original); } catch {}
    }
    return [before, during, read(response)];
  };
})());
console.log(lines.join("\n"));
//// evaluated-text-literals-that-get-more-properties.js
// Object literals in text evaluated at run time whose objects get more properties afterwards: by the text itself, by compiled code, by Object.assign and defineProperty.
// The run time gives later objects of such a literal more room. Whatever room an object has, its keys, their order and their values are the same.
const lines = [];
const describe = object => JSON.stringify(object) + " " + Object.keys(object).join() + " " + Reflect.ownKeys(object).length;
function show(name, run, turns = 12) {
  const seen = [];
  const kept = [];
  for (let turn = 0; turn < turns; turn++) {
    const object = run(turn);
    kept.push(object);
    seen.push(describe(object));
  }
  const distinct = [...new Set(seen.map(text => text.replace(/\d+/g, "#")))];
  lines.push(name + ": " + distinct.length + " form(s): " + seen[0] + " .. " + seen[turns - 1] + " | the first again: " + describe(kept[0]) + " | the fifth: " + describe(kept[4]));
}
const make = (parameters, text) => new Function(...parameters, text);

show("eight names and one more", make(["i"], "const c = { a: i, b: 1, c: 2, d: 3, e: 4, f: 5, g: 6, h: 7 }; c.query = i + 1; return c;"));
show("six names and one more", make(["i"], "const c = { a: i, b: 1, c: 2, d: 3, e: 4, f: 5 }; c.body = i; return c;"));
show("two names and twelve more", make(["i"], "const c = { a: i, b: 1 }; c.p0 = 0; c.p1 = 1; c.p2 = 2; c.p3 = 3; c.p4 = 4; c.p5 = 5; c.p6 = 6; c.p7 = 7; c.p8 = 8; c.p9 = 9; c.p10 = 10; c.p11 = i; return c;"));
show("one name, more in every turn", make(["i"], "const c = { a: i }; for (let k = 0; k < i; k++) c['k' + k] = k; return c;"), 24);
show("sixteen names and three more", make(["i"], "const c = { a: 0, b: 1, c: 2, d: 3, e: 4, f: 5, g: 6, h: 7, i: 8, j: 9, k: 10, l: 11, m: 12, n: 13, o: 14, p: i }; c.q = 1; c.r = 2; c.s = i; return c;"));
show("the same literal at two places, one of which adds", (() => {
  const both = make(["i", "adds"], "const c = adds ? { a: i, b: 1, c: 2 } : { a: i, b: 1, c: 2 }; if (adds) { c.d = 1; c.e = 2; c.f = 3; c.g = 4; c.h = 5; } return c;");
  return turn => both(turn, turn % 3 !== 0);
})());
show("other names in other turns", make(["i"], "const c = { a: i, b: 1, c: 2, d: 3, e: 4, f: 5 }; if (i & 1) c.odd = i; else c.even = i; c.last = 0; return c;"));
show("compiled code adds", (() => {
  const literal = make(["i"], "return { a: i, b: 1, c: 2, d: 3, e: 4, f: 5 };");
  return turn => { const c = literal(turn); c.added = turn; c.more = 1; c.evenMore = 2; return c; };
})());
show("Object.assign and defineProperty add", (() => {
  const literal = make(["i"], "const c = { a: i, b: 1, c: 2, d: 3, e: 4, f: 5 }; c.g = 6; return c;");
  return turn => { const c = Object.assign(literal(turn), { x: 1, y: 2 }); Object.defineProperty(c, "hidden", { value: turn, enumerable: false }); return c; };
})());
show("a property is deleted and added again", make(["i"], "const c = { a: i, b: 1, c: 2, d: 3, e: 4, f: 5 }; c.g = 6; delete c.b; c.b = i; c.h = 7; return c;"));
show("an index and a symbol are added", make(["i"], "const c = { a: i, b: 1, c: 2, d: 3, e: 4, f: 5 }; c[0] = i; c[Symbol.for('s')] = 1; c.g = 2; return c;"));
show("frozen behind the addition", make(["i"], "const c = { a: i, b: 1, c: 2, d: 3, e: 4, f: 5 }; c.g = 6; Object.freeze(c); try { c.h = 7; } catch {} return c;"));
show("a literal with the names of a compiled record gets more", (() => {
  const compiled = turn => ({ value: turn, issues: [] });
  const literal = make(["i"], "const c = { value: i, issues: [] }; c.aborted = true; c.more = i; c.evenMore = 1; return c;");
  return turn => (turn & 1 ? literal(turn) : Object.assign(compiled(turn), { aborted: true, more: turn, evenMore: 1 }));
})());
show("a nested literal gets more", make(["i"], "const c = { request: i, set: { headers: {}, status: 200 } }; c.set.cookie = i; c.set.redirect = 1; c.set.more = 2; c.set.headers.a = 1; c.query = i; return c;"));
console.log(lines.join("\n"));
//// evaluated-text-literals-with-the-names-of-compiled-records.js
const lines = [];
function show(label, value) {
  lines.push(label + " " + JSON.stringify(value, (key, item) => (item === undefined ? "<undefined>" : typeof item === "function" ? "<function>" : typeof item === "bigint" ? item + "n" : typeof item === "symbol" ? String(item) : item)));
}
const evaluate = (...list) => new Function(...list);

function payload(value) {
  return { value, issues: [] };
}
function total(p) {
  return p.issues.length + (typeof p.value === "number" ? p.value : 0);
}
function push(p, issue) {
  p.issues.push(issue);
  return p;
}
function describe(p) {
  return [Reflect.ownKeys(p).map(String), Object.getOwnPropertyDescriptors(p), Object.getPrototypeOf(p) === Object.prototype, JSON.stringify(p), { ...p }, Object.entries(p)];
}
function forIn(p) {
  const names = [];
  for (const name in p) names.push(name);
  return names;
}

const leak = evaluate("p", "return p");
leak(payload(0));

const same = evaluate("v", "return { value: v, issues: [] };");
const swapped = evaluate("v", "return { issues: [], value: v };");
const fewer = evaluate("v", "return { value: v };");
const more = evaluate("v", "return { value: v, issues: [], extra: v };");
const between = evaluate("v", "return { value: v, extra: v, issues: [] };");
const odd = evaluate("v", "return { value: v, issues: v };");

const makers = { payload, same, swapped, fewer, more, between };
for (let turn = 0; turn < 30; turn++) {
  for (const name in makers) {
    const made = makers[name](turn);
    if (made.issues) total(push(made, turn));
  }
}
for (const name in makers) {
  const made = makers[name](7);
  show(name, [describe(made), forIn(made), made.issues ? total(made) : "no issues"]);
}

for (const value of [undefined, null, true, 1.5, -0, 2 ** 40, "text", 10n, Symbol.for("s"), () => 1, [1], { a: 1 }, new Map()]) {
  const made = same(value);
  show("value " + typeof value, [Object.is(made.value, value), total(made), Object.keys(made)]);
  const strange = odd(value);
  let answer;
  try {
    answer = total(strange);
  } catch (error) {
    answer = error.constructor.name;
  }
  show("issues " + typeof value, [Object.is(strange.issues, value), answer]);
}

function change(label, action) {
  for (const maker of [payload, same]) {
    const made = maker(1);
    let result;
    try {
      result = action(made);
    } catch (error) {
      result = String(error);
    }
    show(label + " " + maker.name, [result, describe(made), forIn(made)]);
  }
}
change("delete and add again", p => { delete p.value; p.value = 2; return total(p); });
change("delete both", p => { delete p.value; delete p.issues; return Object.keys(p).length; });
change("add names", p => { p.aborted = true; p[0] = "zero"; p[Symbol.for("k")] = 1; return total(p); });
change("an accessor in place of a field", p => { Object.defineProperty(p, "value", { get() { return 41; }, enumerable: true, configurable: true }); return total(p); });
change("not enumerable", p => { Object.defineProperty(p, "issues", { enumerable: false }); return total(p); });
change("read-only", p => { Object.defineProperty(p, "value", { writable: false }); p.value = 9; return total(p); });
change("frozen", p => { Object.freeze(p); p.value = 9; p.more = 1; return [total(p), Object.isFrozen(p)]; });
change("sealed", p => { Object.seal(p); p.value = 9; delete p.issues; return [total(p), Object.isSealed(p)]; });
change("not extensible", p => { Object.preventExtensions(p); p.more = 1; return [total(p), Object.isExtensible(p)]; });
change("another prototype", p => { Object.setPrototypeOf(p, { inherited: 5 }); return [total(p), p.inherited]; });
change("no prototype", p => { Object.setPrototypeOf(p, null); return [total(p), "toString" in p]; });
change("assigned from another", p => { Object.assign(p, { issues: [1, 2], value: 3, other: 4 }); return total(p); });
change("structured clone", p => total(structuredClone(p)));

const read = evaluate("p", "return [p.value, p.issues.length, 'value' in p, 'missing' in p, p.missing, Object.keys(p).join()];");
const store = evaluate("p", "v", "p.value = v; p.issues = [v]; p.added = v; return p;");
for (let turn = 0; turn < 30; turn++) {
  read(payload(turn));
  read(same(turn));
  store(payload(turn), turn);
  store(same(turn), turn);
}
show("read in evaluated text", [read(payload(1)), read(same(1))]);
show("stored in evaluated text", [describe(store(payload(1), 2)), describe(store(same(1), 2))]);

const kept = [];
for (let turn = 0; turn < 30000; turn++) kept.push(turn & 1 ? same(turn) : payload(turn));
if (typeof Bun !== "undefined") Bun.gc(true);
let sum = 0;
for (const item of kept) sum += total(push(item, 1));
show("kept across collections", sum);

console.log(lines.join("\n"));
//// evaluated-text-object-literals.js
const lines = [];
function show(label, value) {
  lines.push(label + " " + JSON.stringify(value, (key, item) => (item === undefined ? "<undefined>" : typeof item === "function" ? "<function " + item.name + ">" : typeof item === "bigint" ? item + "n" : typeof item === "symbol" ? String(item) : item)));
}
function describe(object) {
  return [Reflect.ownKeys(object).map(String), Object.getOwnPropertyDescriptors(object), Object.getPrototypeOf(object) === Object.prototype];
}
function warm(label, text, ...operands) {
  const run = new Function("log", "a", "b", "c", text);
  let last;
  for (let turn = 0; turn < 12; turn++) {
    const log = [];
    try {
      last = [run(log, ...operands), log];
    } catch (error) {
      last = ["threw " + error, log];
    }
    if (turn === 0 || turn === 11) show(label + " turn " + turn, last);
  }
  return last[0];
}

warm("locals", "return { x: a, y: b, z: c };", 1, "two", [3]);
warm("constants", "return { n: 1, s: 'text', t: true, u: undefined, z: null, d: 1.5, big: 10n };");
warm("calls in order", "const f = name => (log.push(name), name); return { x: f('x'), y: f('y'), z: f('z') };");
warm("a later value assigns an earlier local", "let v = a; return { first: v, second: (v = b), third: v };", 1, 2);
warm("a later value increments an earlier local", "let v = a; return { first: v, second: v++, third: v, fourth: ++v, fifth: v };", 1);
warm("a later call changes an earlier local", "let v = a; const bump = () => { v += 10; return v; }; return { first: v, second: bump(), third: v };", 1);
warm("assigned to a variable that a value reads", "let v = { inner: a }; v = { outer: v, again: v }; return v;", 1);
warm("assigned to a parameter that a value reads", "a = { was: a, b }; return a;", 1, 2);
warm("nested", "return { x: { y: { z: a } }, list: [{ p: b }, { p: c }] };", 1, 2, 3);
warm("conditional values", "return { x: a ? b : c, y: a && b, z: a || c, w: a ?? b };", 0, 1, 2);
warm("a value throws", "const f = name => { log.push(name); if (name === 'y') throw new Error(name); return name; }; return { x: f('x'), y: f('y'), z: f('z') };");
warm("dead zone", "const o = { x: a, y: later }; const later = 1; return o;", 1);
warm("duplicate names", "return { x: a, y: b, x: c };", 1, 2, 3);
warm("duplicate names, calls", "const f = name => (log.push(name), name); return { x: f(1), x: f(2), y: f(3), x: f(4) };");
warm("index names", "return { 1: a, x: b, 0: c, '2': a, y: b };", 1, 2, 3);
warm("shorthand", "return { a, b, c };", 1, 2, 3);
warm("own __proto__ by shorthand", "const __proto__ = a; const o = { __proto__, x: b }; return [Object.keys(o), Object.getPrototypeOf(o) === Object.prototype, o.x];", { p: 1 }, 2);
warm("prototype by __proto__", "const o = { x: b, __proto__: a, y: c }; return [Object.keys(o), Object.getPrototypeOf(o) === a, o.p];", { p: 1 }, 2, 3);
warm("computed names", "return { x: a, [b]: b, y: c };", 1, "k", 3);
warm("spread", "return { x: a, ...b, y: c };", 1, { x: "spread", q: 2 }, 3);
warm("accessors", "const o = { x: a, get y() { return this.x + 1; }, set y(v) { this.x = v; }, z: c }; o.y = 5; return [o.y, Object.keys(o)];", 1, 2, 3);
warm("function names", "const o = { f: function () {}, g: () => {}, h() {}, k: class {}, named: function other() {} }; return [o.f.name, o.g.name, o.h.name, o.k.name, o.named.name];");
warm("methods with super", "const o = { __proto__: { m() { return 'above'; } }, x: a, m() { return super.m() + this.x; } }; return o.m();", 1);
warm("this and arguments", "return (function () { return { self: this, count: arguments.length, first: arguments[0] }; }).call(a, b, c);", "receiver", 2, 3);
warm("seventeen names", "return { p0: a, p1: b, p2: c, p3: a, p4: b, p5: c, p6: a, p7: b, p8: c, p9: a, p10: b, p11: c, p12: a, p13: b, p14: c, p15: a, p16: b };", 1, 2, 3);
warm("sixteen names", "return { p0: a, p1: b, p2: c, p3: a, p4: b, p5: c, p6: a, p7: b, p8: c, p9: a, p10: b, p11: c, p12: a, p13: b, p14: c, p15: a };", 1, 2, 3);
warm("one name", "return { only: a };", 1);
warm("no name", "return {};");
warm("as an argument", "const f = (o, p) => [o, p]; return f({ x: a }, { y: b, z: c });", 1, 2, 3);
warm("in a loop", "const list = []; for (let i = 0; i < 5; i++) list.push({ i, twice: i * 2, a }); return list;", 1);
warm("the object is a value of itself later", "const o = { x: a }; o.self = { holder: o, y: b }; return o.self.holder === o;", 1, 2);
warm("generator", "function* g() { const o = { x: yield 1, y: yield 2 }; return o; } const it = g(); it.next(); it.next(a); return it.next(b).value;", "first", "second");
warm("symbols, functions and holes as values", "return describe({ s: a, f: b, e: [, 1] });".replace("describe", "(o => [typeof o.s, typeof o.f, 0 in o.e])"), Symbol("s"), () => 1);

const make = new Function("a", "b", "return { x: a, y: b };");
for (let turn = 0; turn < 12; turn++) make(turn, turn);
show("descriptors", describe(make(1, 2)));
const grown = make(1, 2);
grown.z = 3;
delete grown.x;
grown.x = 4;
show("changed afterwards", describe(grown));
show("frozen", describe(Object.freeze(make(1, 2))));

const many = [];
for (let turn = 0; turn < 20000; turn++) many.push(make(turn, [turn]));
if (typeof Bun !== "undefined") Bun.gc(true);
let sum = 0;
for (const item of many) sum += item.x + item.y[0];
show("kept across collections", sum);

const wide = new Function("a", "let t0 = a" + Array.from({ length: 300 }, (_, i) => ", t" + (i + 1) + " = t" + i + " + 1").join("") + "; return { first: t0, middle: t150, last: t300 };");
for (let turn = 0; turn < 12; turn++) wide(turn);
show("registers beyond the short form", wide(1));
const manyNames = new Function("a", "const list = []; " + Array.from({ length: 300 }, (_, i) => "list.push({ n" + i + ": a, m" + i + ": " + i + " });").join(" ") + " return list;");
for (let turn = 0; turn < 12; turn++) manyNames(turn);
show("names beyond the short form", [manyNames(1)[0], manyNames(1)[299]]);

console.log(lines.join("\n"));
//// evaluated-text-reads-and-stores-fields-of-every-representation.ts
// Evaluated text runs in the interpreter, whose handlers read, test and store the fields of compiled objects in place.
// One field of each representation, every kind of number in the fields that hold doubles. Each access runs often enough to leave its slow path. Output must match plain Bun.
class Fields {
  whole: number = 3;
  ratio: number = 1.5;
  maybeRatio?: number;
  wholeOrNothing: number | null | undefined = 7;
  flag: boolean = true;
  maybeFlag?: boolean;
  name: string = "n";
  kind: "a" | "b" = "a";
  other: Fields | null = null;
  maybeOther?: Fields;
  anything: unknown = 1;
}

function show(value: unknown): string {
  if (typeof value === "number") return Object.is(value, -0) ? "-0" : String(value);
  if (value instanceof Fields) return "Fields";
  return typeof value === "string" ? JSON.stringify(value) : String(value);
}

const names = Object.keys(new Fields()).concat("missing");
const readAll = new Function("o", "let r; for (let i = 0; i < 4; i++) r = [" + names.map(name => "o." + name).join() + "]; return r;");
const readByKey = new Function("o", "keys", "let r; for (let i = 0; i < 4; i++) r = keys.map(key => o[key]); return r;");
const testAll = new Function("o", "keys", "let r; for (let i = 0; i < 4; i++) r = [" + names.map(name => JSON.stringify(name) + " in o").join() + "].concat(keys.map(key => key in o)); return r;");
const stores: Record<string, Function> = {};
for (const name of names) stores[name] = new Function("o", "v", "for (let i = 0; i < 4; i++) o." + name + " = v; return o." + name + ";");

function tell(label: string, object: Fields) {
  console.log(label, readAll(object).map(show).join(), "|", readByKey(object, names).map(show).join(), "|", testAll(object, names).map((present: boolean) => (present ? 1 : 0)).join(""));
}

tell("fresh", new Fields());

const numbers = [0, -0, 1, -1, 1.5, -1.5, 0.1 + 0.2, 2147483647, 2147483648, -2147483648, -2147483649, 4294967296, 9007199254740991, 1e21, 1e300, -1e300, 5e-324, Infinity, -Infinity, NaN];
for (const name of ["whole", "ratio", "maybeRatio", "wholeOrNothing", "anything"]) {
  const object = new Fields();
  const seen: string[] = [];
  for (const number of numbers) {
    seen.push(show(stores[name](object, number)) + ":" + show((object as any)[name]));
  }
  console.log("numbers in", name, seen.join(" "));
  tell("after", object);
}

const values: unknown[] = [undefined, null, true, false, "a", "b", "text", new Fields(), {}, 2, 2.5];
for (const name of names) {
  const seen: string[] = [];
  for (const value of values) {
    const object = new Fields();
    try {
      seen.push(show(stores[name](object, value)) + ":" + show((object as any)[name]) + ":" + (name in object ? 1 : 0));
    } catch (error) {
      seen.push((error as Error).constructor.name);
    }
  }
  console.log("values in", name, seen.join(" "));
}

const frozen = Object.freeze(new Fields());
const strictStore = new Function("o", "v", "'use strict'; o.ratio = v;");
try {
  strictStore(frozen, 2.5);
  console.log("stored in a frozen object");
} catch (error) {
  console.log("frozen", (error as Error).constructor.name, show(frozen.ratio));
}
stores.ratio(frozen, 2.5);
tell("frozen", frozen);

function sumInCompiledCode(object: Fields): number {
  return object.whole + object.ratio + (object.maybeRatio ?? 0) + (object.wholeOrNothing ?? 0);
}
const shared = new Fields();
for (const number of [0.5, 3, -0, 1e300]) {
  stores.ratio(shared, number);
  stores.maybeRatio(shared, number);
  console.log("read by compiled code", show(shared.ratio), show(shared.maybeRatio), show(sumInCompiledCode(shared)));
}

export {};
//// evaluated-text-reads-fields-that-may-be-undefined.ts
// Text evaluated at run time reads, asks for and lists fields whose type admits undefined, on objects where the field holds a value, holds undefined, was deleted, was never made, or is answered from above.
class Row { id: number; count: number | undefined; ratio?: number; label: string | undefined; on: boolean | undefined; list: number[] | undefined; inner?: { a: number };
    constructor(i: number, full: boolean) { this.id = i; this.count = full ? i : undefined; if (full) this.ratio = i + 0.5; this.label = full ? "l" + i : undefined; this.on = full ? true : undefined; this.list = full ? [i] : undefined; if (full) this.inner = { a: i }; } }
class Below extends Row { extra: number | undefined = undefined; }
const names = ["id", "count", "ratio", "label", "on", "list", "inner", "extra", "missing"];
const readers = names.map(n => new Function("o", `return o.${n};`));
const askers = names.map(n => new Function("o", `return "${n}" in o;`));
const owners = names.map(n => new Function("o", `return Object.hasOwn(o, "${n}");`));
const byKey = new Function("o", "k", "return o[k];");
const lister = new Function("o", "const k = []; for (const n in o) k.push(n); return k.join('+');");
const text = (v: unknown) => v === undefined ? "undefined" : JSON.stringify(v);
function look(title: string, o: object) {
    for (let turn = 0; turn < 3; turn++) console.log(title, turn, names.map((n, i) => n + "=" + text(readers[i](o)) + "/" + text(byKey(o, n)) + "/" + askers[i](o) + "/" + owners[i](o) + "/" + text((o as any)[n])).join(" "), lister(o), Object.keys(o).join("+"), JSON.stringify(o));
}
const scenes: [string, (o: any) => void][] = [
    ["as made", () => {}],
    ["stored undefined", o => { o.count = undefined; o.ratio = undefined; o.label = undefined; o.on = undefined; o.list = undefined; o.inner = undefined; }],
    ["stored values", o => { o.count = 7; o.ratio = 7.5; o.label = "seven"; o.on = false; o.list = [7]; o.inner = { a: 7 }; }],
    ["deleted", o => { delete o.count; delete o.ratio; delete o.label; delete o.on; delete o.list; delete o.inner; }],
    ["deleted and stored undefined", o => { delete o.count; delete o.label; o.count = undefined; o.label = undefined; }],
    ["other types", o => { o.count = "text"; o.ratio = null; o.label = 5; o.on = {}; o.list = "no list"; }],
    ["getter", o => { Object.defineProperty(o, "count", { get() { return "got"; }, configurable: true, enumerable: true }); }],
    ["hidden", o => { Object.defineProperty(o, "count", { enumerable: false }); Object.defineProperty(o, "label", { value: undefined, enumerable: false }); }],
    ["frozen", o => { Object.freeze(o); }],
    ["extra names", o => { o.missing = undefined; o.more = 1; }],
];
const above: [string, () => void, () => void][] = [
    ["nothing above", () => {}, () => {}],
    ["values above", () => { for (const n of names) (Row.prototype as any)[n] = "above " + n; }, () => { for (const n of names) delete (Row.prototype as any)[n]; }],
    ["getters above", () => { for (const n of names) Object.defineProperty(Row.prototype, n, { get() { return "getter " + n; }, set(v) { Object.defineProperty(this, n, { value: v, writable: true, enumerable: true, configurable: true }); }, configurable: true }); }, () => { for (const n of names) delete (Row.prototype as any)[n]; }],
    ["undefined above", () => { for (const n of names) (Row.prototype as any)[n] = undefined; }, () => { for (const n of names) delete (Row.prototype as any)[n]; }],
];
for (const order of ["change first", "look first"]) for (const [where, put, take] of above) for (const [what, change] of scenes) for (const make of [() => new Row(1, true), () => new Row(2, false), () => new Below(3, false), () => new Below(4, true)]) {
    const o = make();
    if (order === "look first") look("before", o);
    change(o); look(order + " | nothing yet | " + what, o);
    put(); look(order + " | " + where + " | " + what, o);
    const later = make(); change(later); look(order + " | " + where + " | made later | " + what, later);
    take(); look(order + " | taken away | " + what, o);
}
//// evaluated-text-reads-what-compiled-code-read-first.ts
// Compiled code reads a property of an ordinary object by name before evaluated text reads it at a site of its own. The site then sees
// the same kind of object again and again, other kinds in between, and objects whose property has moved, gone or become an accessor.
const lines: string[] = [];
function show(label: string, value: unknown): void {
  lines.push(label + " " + JSON.stringify(value));
}

const make = new Function("value", "return { value: value, issues: [] };");
const makeOther = new Function("value", "return { issues: [], extra: 1, value: value };");
function readInCompiledCode(payload: any): unknown {
  return payload.issues.length === 0 ? payload.value : undefined;
}
let total = 0;
for (let i = 0; i < 100; i++) total += readInCompiledCode(make(i)) as number;
for (let i = 0; i < 100; i++) total += readInCompiledCode(makeOther(i)) as number;
show("read by compiled code", total);

const read = new Function("payload", "return payload.value;");
const readTwice = new Function("a", "b", "return [a.value, b.value, a.issues.length, b.issues.length];");
total = 0;
for (let i = 0; i < 100; i++) total += read(make(i));
show("one kind", total);
total = 0;
for (let i = 0; i < 100; i++) total += read(i & 1 ? make(i) : makeOther(i));
show("two kinds in turn", total);
show("two sites", readTwice(make(1), makeOther(2)));

const removed = make(5);
delete removed.value;
const accessor = make(6);
Object.defineProperty(accessor, "value", { get() { return "computed"; } });
const inherited = Object.create(make(7));
const shadowed = Object.create(make(8));
shadowed.value = "own";
class Compiled { value = "field"; issues: unknown[] = []; }
show("removed, accessor, inherited, shadowed, compiled, primitive", [read(removed), read(accessor), read(inherited), read(shadowed), read(new Compiled()), read("text"), read(9)]);
show("and the first kind again", [read(make(10)), read(makeOther(11))]);
for (const bad of [undefined, null]) {
  try {
    read(bad);
  } catch (error) {
    show("of " + bad, (error as Error).constructor.name);
  }
}

console.log(lines.join("\n"));
//// evaluated-text-reduces-array-like-objects-made-by-compiled-code.cjs
function toObject(array) { var o = {}; for (var i in array) o[i] = array[i]; o.length = array.length; o.reduce = Array.prototype.reduce; return o; }
function toUnorderedObject(array) { var o = {}; var props = []; for (var i in array) props.push(i); for (var i = props.length - 1; i >= 0; i--) o[props[i]] = array[props[i]]; o.length = array.length; o.reduce = Array.prototype.reduce; return o; }
var callCount = 0;
console.log(eval("[1,2,3].reduce(function(a,b){ return a + b; })"));
console.log(eval("toUnorderedObject([0,1,2,3]).reduce(function(a,b){ return a + b; }, 4)"));
console.log(eval("toUnorderedObject([1,2,3]).reduce(function(a,b){ return a + b; }, 4)"));
console.log(eval("toObject([1, 2, 3, 4]).reduce(function(a,b, i, thisObj){ thisObj.length++; callCount++; return a + b; }, 0); callCount"));
//// evaluated-text-stores-to-ordinary-objects.ts
// Evaluated text stores into ordinary objects at sites that have seen the same store before: a property that is added, with and
// without prototypes to ask, a value that is replaced, and what changes under a site that has settled: a setter or a read-only
// property that appears on a prototype, a frozen, sealed or non-extensible receiver, another prototype, storage that grows.
declare const Bun: { gc(synchronous: boolean): void };

const lines: string[] = [];
function show(label: string, value: unknown): void {
  lines.push(label + " " + JSON.stringify(value));
}

const add = new Function("make", "value", "const o = make(); o.first = value; o.second = [value]; o.third = value + 1; return o;");
const literal = new Function("value", "return { first: value, second: { inner: value }, third: [value] };");
const replace = new Function("o", "value", "o.first = value; return o;");
const strictAdd = new Function("o", "value", "'use strict'; o.added = value; return o;");

for (let i = 0; i < 40; i++) {
  add(() => ({}), i);
  literal(i);
}
show("added", add(() => ({}), 7));
show("literal", literal(7));

const parent: Record<string, unknown> = {};
const underParent = () => Object.create(parent);
for (let i = 0; i < 40; i++) add(underParent, i);
show("under a prototype", add(underParent, 8));
const seen: unknown[] = [];
Object.defineProperty(parent, "second", { set(value) { seen.push(value); }, get() { return "from the getter"; }, configurable: true });
const afterSetter = add(underParent, 9);
show("a setter has appeared", [Object.keys(afterSetter), afterSetter.second, seen]);
Object.defineProperty(parent, "third", { value: "fixed", writable: false, configurable: true });
const afterReadOnly = add(underParent, 10);
show("a read-only property has appeared", [Object.keys(afterReadOnly), afterReadOnly.third]);
delete parent.second;
delete parent.third;
show("both are gone", add(underParent, 11));

const other = { first: "inherited" };
show("another prototype", [add(() => Object.create(other), 12), add(() => Object.create(null), 13).first]);

const target: Record<string, unknown> = { first: 0, kept: "kept" };
for (let i = 0; i < 40; i++) replace(target, i);
show("replaced", replace(target, { deep: [1, 2] }));
show("replaced in a frozen object", replace(Object.freeze({ first: 0, kept: "kept" }), 5));
show("replaced in a sealed object", replace(Object.seal({ first: 0, kept: "kept" }), 5));
show("replaced by undefined, null and a string", [replace(target, undefined).first, replace(target, null).first, replace(target, "text").first]);

for (let i = 0; i < 40; i++) strictAdd({ a: 1 }, i);
show("added in strict code", strictAdd({ a: 1 }, 1));
const closers: [string, (o: object) => object][] = [["frozen", o => Object.freeze(o)], ["sealed", o => Object.seal(o)], ["not extensible", o => Object.preventExtensions(o)]];
for (const [name, close] of closers) {
  try {
    show(name, strictAdd(close({ a: 1 }), 2));
  } catch (error) {
    show(name, (error as Error).constructor.name);
  }
}

const grow = new Function("o", "count", "for (let i = 0; i < count; i++) { o.a = i; o.b = i; o.c = i; o.d = i; o.e = i; o.f = i; o.g = i; o.h = i; o.i = i; o.j = i; } return o;");
for (let i = 0; i < 40; i++) grow({}, 2);
show("storage that grows", grow({}, 3));

// An object that has survived collections takes young values from evaluated text, and they are still there after the next collection.
const old: Record<string, unknown>[] = [];
for (let i = 0; i < 200; i++) old.push({ first: 0 });
Bun.gc(true);
Bun.gc(true);
const keep = new Function("o", "i", "o.first = { young: [i, String(i)] }; o.late = { alsoYoung: i };");
for (let round = 0; round < 3; round++) {
  for (let i = 0; i < old.length; i++) keep(old[i], i + round);
  const garbage: unknown[] = [];
  for (let i = 0; i < 20000; i++) garbage.push({ i, text: "garbage" + i });
  Bun.gc(round === 1);
}
let sum = 0;
for (const o of old) sum += (o.first as { young: [number, string] }).young[0] + Number((o.first as { young: [number, string] }).young[1]) + (o.late as { alsoYoung: number }).alsoYoung;
show("young values in old objects", sum);

console.log(lines.join("\n"));
//// every-member-of-built-in-prototypes-is-deleted-and-put-back.js
// Each member of 22 built-in prototypes is deleted, where that is allowed, and put back as it was. An heir then finds every member as before.
function describe(value) { return typeof value === "function" ? "function " + value.name : typeof value; }
function look(proto) {
    const parts = [];
    for (const key of Reflect.ownKeys(proto)) {
        const d = Reflect.getOwnPropertyDescriptor(proto, key);
        parts.push(String(key) + ":" + ("value" in d ? describe(d.value) : describe(d.get) + "/" + describe(d.set)) + (d.writable ? "w" : "") + (d.enumerable ? "e" : "") + (d.configurable ? "c" : ""));
    }
    return parts.sort().join();
}
function scene(title, proto) {
    const before = look(proto);
    let keys = 0;
    for (const key of Reflect.ownKeys(proto)) {
        keys++;
        const d = Reflect.getOwnPropertyDescriptor(proto, key);
        let gone = false;
        try { gone = delete proto[key]; } catch { }
        if (gone && !Reflect.defineProperty(proto, key, d))
            console.log(title, "cannot put back", String(key));
    }
    try { proto.aNameNothingHas = 1; delete proto.aNameNothingHas; } catch { }
    console.log(title, keys, before === look(proto));
}
const prototypes = {
    Map: Map.prototype, Set: Set.prototype, WeakMap: WeakMap.prototype, Date: Date.prototype, TypedArray: Object.getPrototypeOf(Uint8Array.prototype), ArrayBuffer: ArrayBuffer.prototype,
    Symbol: Symbol.prototype, Number: Number.prototype, Error: Error.prototype, DataView: DataView.prototype, Buffer: Buffer.prototype, URL: URL.prototype, Headers: Headers.prototype,
    Request: Request.prototype, Response: Response.prototype, URLSearchParams: URLSearchParams.prototype, EventTarget: EventTarget.prototype, AbortSignal: AbortSignal.prototype, Blob: Blob.prototype,
    TextDecoder: TextDecoder.prototype, String: String.prototype, Array: Array.prototype,
};
for (const title in prototypes)
    scene(title, prototypes[title]);
const map = new Map([[1, 2]]), set = new Set([1]), date = new Date(0), bytes = new Uint8Array([1, 2]), url = new URL("http://a.example/b?c=d");
console.log(map.get(1), map.size, set.has(1), set.size, date.getTime(), date.toISOString(), bytes.length, bytes.indexOf(2), url.pathname, url.searchParams.get("c"), "a,b".split(",").length, [3, 1].sort().join(), Buffer.from("a").toString("hex"));
//// extra-properties-that-grow-their-storage.js
// Stores by name and by symbol that add properties the object's layout has no room for, so many that their storage
// has to grow several times; and the neighbors where the same store must not add: an object that is not extensible,
// a setter or a read-only property that the prototype gets later.
"use strict";
const outOfSight = new Proxy({}, {});

////= Message
outOfSight.value = Message;

const first = Symbol("first");
const second = Symbol("second");

function decorate(message, step) {
  message.a1 = step;
  message.a2 = step + 1;
  message.a3 = step + 2;
  message.a4 = step + 3;
  message.a5 = step + 4;
  message.a6 = step + 5;
  message[first] = "first";
  message.a7 = step + 6;
  message.a8 = step + 7;
  message.a9 = step + 8;
  message.a10 = step + 9;
  message.a11 = step + 10;
  message[second] = "second";
  message.a12 = step + 11;
  message.a13 = step + 12;
  message.a14 = step + 13;
  message.a15 = step + 14;
  message.a16 = step + 15;
  message.a17 = step + 16;
  message.a18 = step + 17;
  message.a19 = step + 18;
  message.a20 = step + 19;
}
outOfSight.decorate = decorate;

function describe(message) {
  let sum = 0;
  for (const key of Object.keys(message)) sum += message[key];
  return Object.keys(message).join(",") + " sum " + sum + " " + String(message[first]) + " " + String(message[second]);
}

////= attempt	message	decorate(message

const seen = new Map();
function note(line) {
  seen.set(line, (seen.get(line) ?? 0) + 1);
}

for (let round = 0; round < 100; round++) {
  const plain = new outOfSight.value(1);
  note("plain " + attempt(plain, 1) + " " + describe(plain));

  const withIndexes = new outOfSight.value(1);
  withIndexes[JSON.parse("3")] = 30;
  withIndexes[JSON.parse("0")] = 10;
  note("indexes " + attempt(withIndexes, 1) + " " + describe(withIndexes));

  const closed = new outOfSight.value(1);
  closed.a1 = 0;
  closed.a2 = 0;
  Object.preventExtensions(closed);
  note("closed " + attempt(closed, 1) + " " + describe(closed));

  const twice = new outOfSight.value(1);
  attempt(twice, 1);
  note("twice " + attempt(twice, 2) + " " + describe(twice));
}
for (const [line, count] of [...seen].sort()) console.log(count, line);

let calls = 0;
Object.defineProperty(Message.prototype, "a7", { configurable: true, set(value) { calls += value; } });
const belowSetter = new outOfSight.value(1);
console.log("setter", attempt(belowSetter, 1), calls, describe(belowSetter));

Object.defineProperty(Message.prototype, "a7", { configurable: true, writable: false, value: 70 });
const belowReadOnly = new outOfSight.value(1);
console.log("read-only", attempt(belowReadOnly, 1), describe(belowReadOnly), belowReadOnly.a7);

delete Message.prototype.a7;
const again = new outOfSight.value(1);
console.log("again", attempt(again, 1), describe(again));

Object.defineProperty(Message.prototype, second, { configurable: true, set(value) { calls += 1000; } });
const belowSymbolSetter = new outOfSight.value(1);
console.log("symbol setter", attempt(belowSymbolSetter, 1), calls, describe(belowSymbolSetter));
//// extra-property-storage-growth-by-key.js
// Stores under computed keys that add properties the object's layout has no room for: their storage is allocated, then doubled,
// by the stub up to a capacity and by the run time beyond it; and the same names on an ordinary object, whose own storage grows
// the same way. The neighbors where the stub must leave the growth to the run time or must not add at all: index keys beside the
// names, an object that has survived a collection, an object that is frozen halfway.
"use strict";
const outOfSight = new Proxy({}, {});

function Entry(id) {
  this.id = id;
}
outOfSight.Entry = Entry;
outOfSight.names = Array.from({ length: 150 }, (unused, index) => "k" + index);

function fill(entry, from, to, step) {
  const names = outOfSight.names;
  for (let index = from; index < to; index++) entry[names[index]] = step + index;
}
outOfSight.fill = fill;

function describe(entry) {
  let sum = 0;
  const keys = Object.keys(entry);
  for (const key of keys) sum += entry[key];
  return keys.length + " keys, sum " + sum + ", first " + keys[0] + ", last " + keys[keys.length - 1];
}

////= attempt	entry, from, to	fill(entry, from, to

const seen = new Map();
function note(line) {
  seen.set(line, (seen.get(line) ?? 0) + 1);
}

const counts = [0, 1, 4, 5, 6, 7, 8, 9, 10, 11, 12, 14, 15, 18, 19, 22, 23, 38, 39, 40, 70, 71, 72, 134, 135, 136, 150];
for (let round = 0; round < 40; round++) {
  for (const count of counts) {
    const plain = new outOfSight.Entry(1);
    note("plain " + count + " " + attempt(plain, 0, count, round & 1) + " " + describe(plain));

    const ordinary = JSON.parse("{}");
    note("ordinary " + count + " " + attempt(ordinary, 0, count, round & 1) + " " + describe(ordinary));
  }

  const withIndexes = new outOfSight.Entry(1);
  withIndexes[JSON.parse("2")] = 20;
  withIndexes[JSON.parse("0")] = 10;
  note("indexes " + attempt(withIndexes, 0, 80, 1) + " " + describe(withIndexes) + " " + withIndexes[0] + " " + withIndexes[2]);

  const indexesLater = new outOfSight.Entry(1);
  attempt(indexesLater, 0, 9, 1);
  indexesLater[JSON.parse("1")] = 5;
  note("indexes later " + attempt(indexesLater, 9, 80, 1) + " " + describe(indexesLater) + " " + indexesLater[1]);

  const frozenHalfway = new outOfSight.Entry(1);
  attempt(frozenHalfway, 0, 10, 1);
  Object.freeze(frozenHalfway);
  note("frozen " + attempt(frozenHalfway, 10, 20, 1) + " " + describe(frozenHalfway));

  const overwritten = new outOfSight.Entry(1);
  attempt(overwritten, 0, 50, 1);
  note("overwritten " + attempt(overwritten, 0, 50, 2) + " " + describe(overwritten));
}

const survivors = [];
for (let index = 0; index < 20; index++) {
  const survivor = new outOfSight.Entry(1);
  attempt(survivor, 0, index, 1);
  survivors.push(survivor);
}
Bun.gc(true);
const held = { toString() { return "held"; } };
for (let index = 0; index < survivors.length; index++) {
  attempt(survivors[index], index, index + 30, 1);
  survivors[index][outOfSight.names[149]] = 0;
  survivors[index].held = held;
}
Bun.gc(true);
for (const survivor of survivors) note("survivor " + Object.keys(survivor).length + " " + String(survivor.held) + " " + survivor.k0 + " " + survivor.k149);

for (const [line, count] of [...seen].sort()) console.log(count, line);
//// fields-beside-their-slots-are-read-and-stored-warm.ts
// Fields that most objects never fill, so the last of them lie outside the cell. Some objects get such a field in another form or with a value of another type than the constructor's code shows:
// the property then lies beside the fields. Warm reads, stores and questions by name and by key have to follow it there and back.
const box: any[] = JSON.parse("[null]");
function hide(x: any): any { box[0] = x; return box[0]; }
const one: number = hide(1);

interface NodeLike { nodeKind: number; n0?: NodeLike; n1?: NodeLike; n2?: NodeLike; n3?: NodeLike; n4?: NodeLike; n5?: NodeLike; n6?: NodeLike; n7?: NodeLike; n8?: NodeLike; n9?: NodeLike; n10?: NodeLike; n11?: NodeLike; n12?: NodeLike; n13?: NodeLike; n14?: NodeLike; n15?: NodeLike; n16?: NodeLike; n17?: NodeLike; n18?: NodeLike; n19?: NodeLike; n20?: NodeLike; n21?: NodeLike; n22?: NodeLike; n23?: NodeLike; n24?: NodeLike; n25?: NodeLike; n26?: NodeLike; n27?: NodeLike; n28?: NodeLike; n29?: NodeLike; n30?: NodeLike; n31?: NodeLike; n32?: NodeLike; n33?: NodeLike; n34?: NodeLike; n35?: NodeLike; n36?: NodeLike; n37?: NodeLike; n38?: NodeLike; n39?: NodeLike; }
function NodeObject(this: NodeLike, kind: number) { this.nodeKind = kind; this.n0 = undefined; this.n1 = undefined; this.n2 = undefined; this.n3 = undefined; this.n4 = undefined; this.n5 = undefined; this.n6 = undefined; this.n7 = undefined; this.n8 = undefined; this.n9 = undefined; this.n10 = undefined; this.n11 = undefined; this.n12 = undefined; this.n13 = undefined; this.n14 = undefined; this.n15 = undefined; this.n16 = undefined; this.n17 = undefined; this.n18 = undefined; this.n19 = undefined; this.n20 = undefined; this.n21 = undefined; this.n22 = undefined; this.n23 = undefined; this.n24 = undefined; this.n25 = undefined; this.n26 = undefined; this.n27 = undefined; this.n28 = undefined; this.n29 = undefined; this.n30 = undefined; this.n31 = undefined; this.n32 = undefined; this.n33 = undefined; this.n34 = undefined; this.n35 = undefined; this.n36 = undefined; this.n37 = undefined; this.n38 = undefined; this.n39 = undefined; }
const NodeConstructor: new (kind: number) => NodeLike = NodeObject as any;
function makeNodes(count: number): NodeLike[] { const list: NodeLike[] = []; for (let r = 0; r < one; r++) for (let q = 0; q < one; q++) for (let i = 0; i < count; i++) list.push(new NodeConstructor(i)); return list; }
