  const inner = make(["«2» });
  return () => inner();
})());
////: texts
const texts = {
    addField: "o.added = 1; o.added2 = 'x'",
    deleteField: "delete o.balance",
    retype: "o.balance = 'text'; o.rate = {}; o.owner = 5",
    toDouble: "o.balance = 0.5",
    big: "o.balance = 2 ** 40",
    accessor: "Object.defineProperty(o, 'balance', { get() { return 1234 }, set(v) { this.seen = v }, configurable: true })",
    readOnly: "Object.defineProperty(o, 'balance', { value: 3, writable: false })",
    hidden: "Object.defineProperty(o, 'owner', { enumerable: false })",
    protoMethod: "Object.getPrototypeOf(o).deposit = function (n) { this.balance -= n; return this }",
    protoGetter: "Object.defineProperty(Account.prototype, 'double', { get() { return 'replaced' }, configurable: true })",
    protoShadow: "Account.prototype.balance = 'from the prototype'; delete o.balance",
    protoSetter: "Object.defineProperty(Account.prototype, 'fresh', { set(v) { this.caught = v }, configurable: true })",
    swapProto: "Object.setPrototypeOf(o, { deposit() { return 'swapped' }, peek: Account.prototype.peek })",
    nullProto: "Object.setPrototypeOf(o, null)",
    swapParent: "Object.setPrototypeOf(Savings.prototype, { deposit(n) { this.balance = -n; return this } })",
    freeze: "Object.freeze(o)",
    indices: "o[0] = 'zero'; o[5] = 'five'; o[4294967295] = 'big'",
    manyFields: "for (let i = 0; i < 100; i++) o['f' + i] = i; for (let i = 0; i < 100; i += 2) delete o['f' + i]",
    statics: "Account.make = () => 'no account'",
    subclass: "globalThis.Sub = class extends Account { constructor() { super('sub'); this.balance = 'sub' } }; Object.setPrototypeOf(o, Sub.prototype)",
    construct: "globalThis.made = Reflect.construct(Account, ['r'], function () {})",
    constructProxy: "globalThis.made = Reflect.construct(Savings, ['r'], new Proxy(Savings, {}))",
    withStatement: "with (o) { balance = 77; var owner = 'with' }",
};
//// a-built-in-object-gets-a-name-of-its-own-through-one-store-that-runs-many-times.js
// A built-in object gets a property of its own that changes what the language does with it. The store stands in one place and runs many times, each time on a new object.
function store(object, name, value) { object[name] = value; }
function storeConstructor(object, value) { object.constructor = value; }
function storeThen(object, value) { object.then = value; }
function storeJoin(object, value) { object.join = value; }
function storeIterator(object, value) { object[Symbol.iterator] = value; }
function storeSpreadable(object, value) { object[Symbol.isConcatSpreadable] = value; }
function storeNext(object, value) { object.next = value; }
function storeToString(object, value) { object.toString = value; }
function storeValueOf(object, value) { object.valueOf = value; }
function storeExec(object, value) { object.exec = value; }
function storeSet(object, value) { object.set = value; object.add = value; }
class Other extends Array {}
const lines = [];
function* nine() { yield 9; }
for (let turn = 0; turn < 8; turn++) {
  const row = [];
  let a = [1, 2, 3]; storeConstructor(a, Other);
  row.push(a.slice() instanceof Other, a.slice(1) instanceof Other, a.map(x => x) instanceof Other, a.filter(x => x) instanceof Other, a.concat([4]) instanceof Other, a.splice(0, 1) instanceof Other, a.flat() instanceof Other);
  a = [1.5, 2.5]; storeConstructor(a, { [Symbol.species]: Other }); row.push(a.slice() instanceof Other, a.map(x => x) instanceof Other);
  a = [1, 2, 3]; storeIterator(a, nine); { const [first] = a; row.push([...a].join(), first, Array.from(a).join(), Math.max(...a), new Set(a).size); let sum = 0; for (const x of a) sum += x; row.push(sum); }
  a = [1, 2, 3]; store(a, Symbol.iterator, nine); row.push([...a].join());
  a = [1, 2, 3]; storeSpreadable(a, false); row.push([0].concat(a).length);
  a = [1, 2, 3]; storeJoin(a, () => "joined"); row.push(String(a), `${a}`, a + "");
  a = [1, 2, 3]; storeToString(a, () => "text"); row.push(String(a), `${a}`, a + "");
  a = [1, 2, 3]; storeValueOf(a, () => 7); row.push(a + 1, a * 2);
  a = ["x"]; store(a, "constructor", Other); row.push(a.slice() instanceof Other);
  const it = [1, 2][Symbol.iterator](); storeNext(it, () => ({ done: true })); row.push([...it].length);
  const re = /a/g; storeExec(re, () => null); row.push(re.test("a"), "aaa".replace(re, "b"), "a".match(re), "a".search(re));
  const m = new Map([[1, 2]]); storeIterator(m, nine); try { row.push(new Map(m).size); } catch (error) { row.push(error.constructor.name); } row.push([...m].join());
  const s = new Set([1, 2]); storeIterator(s, nine); row.push(new Set(s).size, [...s].join());
  const text = new String("ab"); storeIterator(text, nine); row.push([...text].join());
  const d = new Date(0); storeValueOf(d, () => 5); storeToString(d, () => "date"); row.push(d - 0, d + "", `${d}`);
  const n = new Number(1); storeValueOf(n, () => 5); row.push(n + 1);
  const f = function () {}; storeToString(f, () => "fn"); row.push(f + "");
  const e = new Error("m"); storeToString(e, () => "err"); row.push(e + "");
  lines.push(row.join(" "));
}
const order = [];
async function waits(turn) {
  const p = Promise.resolve(turn); storeConstructor(p, function NotPromise() {}); storeThen(p, function (resolve) { order.push("then " + turn); resolve("own " + turn); });
  order.push(await p);
  const q = Promise.resolve(turn); storeThen(q, function (resolve) { order.push("then of q " + turn); resolve("own q " + turn); });
  order.push(await q, await Promise.resolve(q), (await Promise.all([q]))[0], await (async () => q)());
}
(async () => { for (let turn = 0; turn < 8; turn++) await waits(turn); console.log(lines.join("\n")); console.log(order.join("\n")); })();
//// a-cloned-map-is-read-by-name-while-its-prototype-loses-members.js
// The size of a Map that structuredClone() made is read by name, while its prototype loses members and is given and robbed of many names.
const map = structuredClone(new Map([[1, "one"]]));
function size(o) { return o.size; }
function absent(o) { return o.nothingOfThisName; }
function drop(proto, names) { for (const name of names) delete proto[name]; }
function churn(proto, tag) { for (let i = 0; i < 300; i++) { proto[tag + i] = i; delete proto[tag + i]; } }
const odd = [{}, { a: 1 }, function () {}];
for (let i = 0; i < 60; i++) { size(map); for (const o of odd) size(o); }
console.log("before:", size(map));
drop(Map.prototype, ["getOrInsert", "getOrInsertComputed"]);
churn(Map.prototype, "z");
console.log("churned:", size(map));
for (let i = 0; i < 40; i++) absent(map);
console.log("walked:", size(map));
//// a-constant-string-is-the-key-of-a-name-that-nothing-has.ts
// A string constant that is no property name anywhere in the program is used as a computed key, again and again.
// The name is absent at first; then it appears on the object, on a prototype, in process.env, and goes away again.
const names = ["quite-absent-one", "quite-absent-two", "quite-absent-three", "HOME"];

function reader(holder: Record<string, unknown>, key: string): () => unknown {
  return () => holder[key];
}

function has(holder: object, key: string): boolean {
  return key in holder;
}

function show(label: string, readers: (() => unknown)[], holder: object): void {
  const seen: string[] = [];
  for (let round = 0; round < 3; round++) {
    for (let i = 0; i < readers.length; i++) seen.push(String(readers[i]()) + (has(holder, names[i]) ? "+" : "-"));
  }
  console.log(label, seen.join(" "));
}

const parent: Record<string, unknown> = { inheritedFromTheStart: true };
const plain: Record<string, unknown> = Object.assign(Object.create(parent), { a: 1, b: 2 });
const plainReaders = names.map(name => reader(plain, name));
show("absent", plainReaders, plain);
plain[names[0]] = "own";
show("own", plainReaders, plain);
parent[names[1]] = "inherited";
show("inherited", plainReaders, plain);
delete plain[names[0]];
show("deleted", plainReaders, plain);
delete parent[names[1]];
show("gone", plainReaders, plain);

const withoutPrototype: Record<string, unknown> = Object.create(null);
const bareReaders = names.map(name => reader(withoutPrototype, name));
show("bare", bareReaders, withoutPrototype);
Object.setPrototypeOf(withoutPrototype, { [names[2]]: "late parent" });
show("late parent", bareReaders, withoutPrototype);

const environment = process.env as Record<string, unknown>;
const environmentReaders = names.slice(0, 3).map(name => reader(environment, name));
const showEnvironment = (label: string) => console.log(label, environmentReaders.map(read => String(read())).join(" "), environmentReaders.map(read => String(read())).join(" "));
showEnvironment("environment");
process.env[names[0]] = "set";
showEnvironment("environment set");
delete process.env[names[0]];
showEnvironment("environment unset");

const many: Record<string, unknown> = {};
for (let i = 0; i < 300; i++) many["k" + i] = i;
const manyReaders = names.map(name => reader(many, name));
show("many", manyReaders, many);
many[names[2]] = "in a dictionary";
show("many set", manyReaders, many);

const trapped = new Proxy({}, { get: (_, key) => "trap:" + String(key), has: () => true });
show("proxy", names.map(name => reader(trapped as Record<string, unknown>, name)), trapped);
//// a-literal-with-numbers-for-keys-is-asked-for-indices-it-has-and-has-not.js
// Objects that keep elements beside their fields are asked, through a function that knows nothing of them, for indices that they have, that they lack, that something above them has, and for keys that only look like indices.
function ask(table, key) { return table[key]; }
function show(label, table, keys) { console.log(label, keys.map(key => String(ask(table, key))).join(" ")); }
const keys = JSON.parse('[204, 205, 200, 0, 1, 303, 304, 305, 1000000, -1, 2147483647, 204.0, 204.5, "204", "200", "-1", 4294967295, 4294967294, -0]');
keys.push(NaN, undefined, null, true);
show("booleans", { 204: true, 205: true, 304: true }, keys);
show("integers", { 0: 1, 1: 2, 3: 4 }, keys);
show("doubles", { 0: 1.5, 1: 2.5, 3: 4.5 }, keys);
show("names too", { 1: "one", "-1": "minus one", name: "named" }, keys);

const above = { 200: "inherited 200", 1: "inherited 1" };
const below = { 204: "own 204", 3: "own 3" };
show("as written", below, keys);
Object.setPrototypeOf(below, above);
show("below another table", below, keys);
above[0] = "inherited 0, stored later";
show("which gets one more", below, keys);
Object.setPrototypeOf(below, null);
show("below nothing", below, keys);
Object.setPrototypeOf(below, Object.prototype);
show("as written again", below, keys);

const created = Object.create({ 7: "seven above" });
created[1] = "one";
created[2] = "two";
show("created below a table", created, [1, 2, 7, 8]);
class Table { constructor() { this[1] = "one"; this[3] = "three"; } }
Table.prototype[2] = "two above";
show("instance of a class", new Table(), [0, 1, 2, 3, 4]);
const withGetter = { 1: "one", 2: "two" };
Object.defineProperty(withGetter, 5, { get() { return "got 5"; } });
show("with a getter", withGetter, [1, 2, 3, 5, 6]);
const holes = { 0: "a", 1: "b", 2: "c" };
delete holes[1];
show("with a hole", holes, [0, 1, 2, 3]);
const trapped = { 1: "one" };
Object.setPrototypeOf(trapped, new Proxy({}, { get(_, key) { return "trapped " + String(key); } }));
show("below a proxy", trapped, [1, 2, 3]);
