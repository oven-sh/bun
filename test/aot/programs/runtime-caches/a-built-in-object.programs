function empty(fills, v) { var o = {}; if (fills) { o.a = v; o.b = v; o.c = v; o.d = v; o.e = v; o.f = v; o.length = v; } return o; }
console.log(Object.keys(empty(true, 1)).join(), Object.keys(empty(true, "x")).join(), Object.keys(empty(true, {})).join());
