//// conversion-methods-replaced-on-an-ordinary-prototype.js
// The engine remembers, with the Structure of an object, which valueOf, toString and toJSON its prototype gives it, and asks to hear of it when another value takes their place there.
// The stores that replace them are ordinary stores by name to an ordinary object, which has been stored to many times before anybody asked to hear of anything.
const hide = (0, eval)("(value) => value");
const lines = [];
function replace(target, which, value) {
    if (which === 0) target.valueOf = value;
    else if (which === 1) target.toString = value;
    else if (which === 2) target.toJSON = value;
    else target.plain = value;
}
function convert(object) {
    return [+object, `${object}`, JSON.stringify(object), object.plain].join(" ");
}
// The object's own names, read from the object itself.
function own(object) {
    return [typeof object.valueOf, typeof object.toString, typeof object.toJSON, object.plain, object.absent, Object.keys(object).join()].join(" ");
}
function family(label) {
    // No literal of the program: an object that the run time makes.
    const above = JSON.parse('{"valueOf":0,"toString":0,"toJSON":0,"plain":0}');
    const below = [];
    for (let i = 0; i < 4; i++) below.push(Object.create(above));
    return { above, below };
}
for (const label of ["a", "b", "c"]) {
    const { above, below } = family(label);
    // Stores before anybody has converted anything.
    for (let round = 0; round < 40; round++) {
        for (let which = 0; which < 4; which++) {
            const number = round * 4 + which;
            replace(hide(above), which, which === 0 ? () => number : which === 3 ? number : () => label + number);
        }
    }
    lines.push(label + " before: " + below.map(convert).join(" | "));
    // Conversions, over and over: now it is remembered.
    let sum = 0;
    for (let round = 0; round < 200; round++) {
        for (const object of below) sum += +object + `${object}`.length + JSON.stringify(object).length;
    }
    lines.push(label + " sum: " + sum);
    lines.push(label + " own: " + own(hide(above)) + " | " + own(hide(below[0])));
    // And each is replaced again, the same way.
    for (let round = 0; round < 6; round++) {
        for (let which = 0; which < 4; which++) {
            const number = 1000 + round * 4 + which;
            replace(hide(above), which, which === 0 ? () => number : which === 3 ? number : () => label + number);
            lines.push(label + " " + round + "." + which + ": " + below.map(convert).join(" | ") + " own: " + own(hide(above)));
        }
        for (let again = 0; again < 50; again++) {
            for (const object of below) sum += +object + `${object}`.length + JSON.stringify(object).length;
        }
    }
    lines.push(label + " sum: " + sum);
}
console.log(lines.join("\n"));
//// dictionaries-read-and-stored-by-name.js
// An object in dictionary mode is read and stored by name while names are added, deleted, replaced and redefined under it, before and after it was flattened once.
const trips = JSON.parse("50");
const names = JSON.parse('["shared", "other"]');

function read(o, n) { let last; for (let i = 0; i < n; i++) last = o.shared; return last; }
function store(o, n) { for (let i = 0; i < n; i++) o.shared = i; return o[names[0]]; }
function storeInStrictCode(o, n) { "use strict"; let thrown = 0; for (let i = 0; i < n; i++) { try { o.shared = i; } catch { thrown++; } } return thrown; }
function fill(o, from, to) { for (let i = from; i < to; i++) o["k" + i] = i; }
function drop(o, from, to) { for (let i = from; i < to; i++) delete o["k" + i]; }

function exercise(what, o) {
  const said = [];
  said.push(read(o, trips));
  o[names[0]] = "replaced";
  said.push(read(o, trips));
  said.push(store(o, trips));
  said.push(read(o, trips));
  fill(o, 1000, 1010);
  said.push(read(o, trips));
  delete o[names[0]];
  said.push(read(o, trips));
  o[names[0]] = "added";
  said.push(read(o, trips));
  drop(o, 1000, 1005);
  fill(o, 2000, 2005);
  said.push(read(o, trips));
  Object.defineProperty(o, names[0], { get() { return "getter"; }, set(value) { this.seen = value; }, configurable: true });
  said.push(read(o, trips));
  said.push(store(o, trips), o.seen);
  Object.defineProperty(o, names[0], { value: "read-only", writable: false, configurable: true });
  said.push(read(o, trips), storeInStrictCode(o, trips), read(o, trips));
  delete o[names[0]];
  Object.setPrototypeOf(o, { shared: "inherited" });
  said.push(read(o, trips));
  Object.getPrototypeOf(o).shared = "inherited, replaced";
  said.push(read(o, trips));
  said.push(store(o, trips), Object.getPrototypeOf(o).shared);
  console.log(what + ": " + said.join(" | "));
}

function exerciseEach(kind, create, createEmpty) {
  const bySize = create();
  fill(bySize, 0, 200);
  exercise(kind + ", dictionary by size", bySize);

  const byDeletion = create();
  fill(byDeletion, 0, 200);
  drop(byDeletion, 0, 150);
  exercise(kind + ", dictionary by deletion", byDeletion);

  const again = create();
  fill(again, 0, 200);
  drop(again, 0, 150);
  read(again, trips);
  fill(again, 200, 400);
  exercise(kind + ", dictionary again after it was flattened", again);

  const againByDeletion = create();
  fill(againByDeletion, 0, 200);
  drop(againByDeletion, 0, 150);
  read(againByDeletion, trips);
  fill(againByDeletion, 200, 400);
  drop(againByDeletion, 200, 300);
  exercise(kind + ", dictionary by deletion after it was flattened", againByDeletion);

  const withoutName = createEmpty();
  fill(withoutName, 0, 200);
  drop(withoutName, 0, 150);
  read(withoutName, trips);
  fill(withoutName, 200, 400);
  exercise(kind + ", the name is absent at first", withoutName);
}

exerciseEach("parsed", () => JSON.parse('{"shared":"first"}'), () => JSON.parse("{}"));
exerciseEach("literal", () => ({ shared: "first" }), () => ({}));
