//// members-of-built-in-objects-are-replaced-before-their-first-call.js
// Each member of a built-in object is replaced where the object lets it be. A call that names the member runs the replacement then, and what was there before otherwise.
import fs from "node:fs"; import path from "node:path"; import util from "node:util"; import os from "node:os"; import events from "node:events"; import assert from "node:assert"; import url from "node:url"; import qs from "node:querystring"; import zlib from "node:zlib"; import nodeCrypto from "node:crypto";
////= cases
const text = v => { try { return typeof v === "bigint" ? v + "n" : String(v); } catch { return "?"; } };
const run = f => { try { return text(f()); } catch (e) { return "threw " + (e && e.constructor && e.constructor.name); } };
let violations = 0, replaced = 0, refused = 0;
const say = (...a) => { violations++; log(a.join(" ")); };
const log = console.log.bind(console);
const nameOf = new Map([[Math, "Math"], [Object, "Object"], [globalThis, "globalThis"], [fs, "fs"], [Bun, "Bun"], [process, "process"], [path, "path"], [util, "util"], [Buffer, "Buffer"], [Reflect, "Reflect"], [JSON, "JSON"], [Number, "Number"], [Array, "Array"], [String, "String"], [Promise, "Promise"]]);
const getDescriptor = Reflect.getOwnPropertyDescriptor, define = Reflect.defineProperty, is = Object.is;
const mode = process.argv[2] ?? "cold";
