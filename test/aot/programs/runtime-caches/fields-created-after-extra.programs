  if (how === "parsed") {
    let text = "{";
    for (let i = 0; i < size; i++) text += (i ? "," : "") + JSON.stringify("k" + i) + ":" + i;
    o = JSON.parse(hide(text + "}"));
  } else {
    o = how === "bare" ? Object.create(null) : JSON.parse(hide("{}"));
    o = hide(o);
    for (let i = 0; i < size; i++) o["k" + i] = i;
  }
  o = hide(o);
  o.last = "last";
  return o;
}
function sweep(title, o, size) {
  let sum = 0, present = 0, own = 0, absent = 0;
  for (let turn = 0; turn < 3; turn++) {
    for (let i = 0; i < size + 40; i++) {
      const k = hide("k" + i), v = readKey(o, k);
      if (v === undefined) absent++; else sum += typeof v === "number" ? v : 1;
      if (hasKey(o, k)) present++;
      if (ownKey(o, k)) own++;
      if (readKey(o, hide("x" + i)) !== undefined || hasKey(o, hide("y" + i))) sum = NaN;
    }
  }
  lines.push([title, "sum", sum, "present", present, "own", own, "absent", absent, "keys", Object.keys(o).length].join(" "));
}
function warm(title, o) {
  let text = "";
  for (let turn = 0; turn < 40; turn++) {
    const now = [readK3(o), readK127(o), readLast(o), readNowhere(o), hasK3(o), hasNowhere(o), readKey(o, "k3"), readKey(o, "k128"), readKey(o, "nowhere"), readKey(o, "toString") === Object.prototype.toString,
      hasKey(o, "k64"), hasKey(o, "valueOf"), ownKey(o, "valueOf"), ownKey(o, "last")].map(show).join(" ");
    if (turn && now !== text) lines.push(title + ": CHANGED AT TURN " + turn);
    text = now;
  }
  lines.push(title + ": " + text);
}
function stores(title, o, size) {
  const refused = [];
  for (let turn = 0; turn < 20; turn++) {
    for (const i of [3, 64, 127, 128, size - 1]) {
      try { storeKey(o, hide("k" + i), turn * 1000 + i); } catch (e) { if (!turn) refused.push("k" + i + " " + e.constructor.name); }
    }
    try { storeK3(o, turn); } catch (e) { if (!turn) refused.push("k3 by name " + e.constructor.name); }
    try { storeLast(o, "last " + turn); } catch (e) { if (!turn) refused.push("last " + e.constructor.name); }
  }
  lines.push(title + ": refused " + refused.join(", "));
}
let ran = 0;
for (const size of [129, 200, 255, 256, 257, 300, 1000, 5000]) {
  for (const how of ["parsed", "stored", "bare"]) {
    const name = size + " " + how;
    const o = make(size, how);
    sweep(name + " new", o, size); warm(name + " new", o);
    stores(name + " stores", o, size); sweep(name + " stored", o, size); warm(name + " stored", o);
    delete o.k3; delete o[hide("k128")]; delete o[hide("k" + (size - 1))];
    sweep(name + " three deleted", o, size); warm(name + " three deleted", o);
    stores(name + " stores again", o, size); sweep(name + " back", o, size); warm(name + " back", o);
    Object.defineProperty(o, "k3", { get() { ran++; return "got"; }, set(v) { ran += 100; }, enumerable: true, configurable: true });
    Object.defineProperty(o, "k127", { value: "fixed", writable: false, enumerable: true, configurable: true });
    Object.defineProperty(o, hide("k64"), { value: "hidden", writable: true, enumerable: false, configurable: true });
    sweep(name + " other forms", o, size); warm(name + " other forms", o);
    stores(name + " stores to other forms", o, size); warm(name + " after those", o);
    const below = hide(Object.create(o));
    below.own = 1;
    sweep(name + " from below", below, size); warm(name + " from below", below);
    stores(name + " stores below", below, size); warm(name + " below after stores", below); warm(name + " above after stores", o);
    Bun.gc(true);
    warm(name + " after a collection", o);
    Object.freeze(o);
    stores(name + " frozen", o, size); warm(name + " frozen", o); sweep(name + " frozen", o, size);
  }
}
lines.push("accessors ran " + ran);
console.log(lines.join("\n"));
//// objects-with-hundreds-of-names-are-read-stored-and-asked-by-key-while-names-come-and-go.js
// Objects get from 100 to 700 names by key, so many that each keeps a table of its own. Names are read, stored, asked for and deleted by key, among them accessors, read-only names and symbols, on the objects and on objects below them.
const sizes = [100, 127, 128, 129, 130, 200, 254, 255, 256, 257, 400, 700];
const marks = [Symbol("a"), Symbol("b"), Symbol.iterator];
let sum = 0;
const note = v => { const text = typeof v === "symbol" ? v.toString() : typeof v === "function" ? "function" : String(v); for (let i = 0; i < text.length; i++) sum = (sum * 31 + text.charCodeAt(i)) | 0; };
const attempt = run => { try { return run(); } catch (error) { return error.constructor.name; } };
function namesFor(size, salt) { const list = []; for (let i = 0; i < size; i++) list.push("k" + ((i * 37 + salt) % 1009).toString(36) + "_" + (i % 7)); return list; }
function storeStrict(o, k, v) { "use strict"; o[k] = v; }
function visit(o, keys) {
    for (let r = 0; r < 3; r++) for (let i = 0; i < keys.length; i++) {
        const k = keys[i];
        note(attempt(() => o[k])); note(k in o); note(Object.hasOwn(o, k));
        if (r === 1) { note(attempt(() => storeStrict(o, k, i))); note(attempt(() => o[k])); }
        if (r === 2) { note(attempt(() => { o[k] = (o[k] ?? 0) + 1; })); note(attempt(() => o[k])); }
    }
}
for (const size of sizes) {
    for (const bare of [false, true]) {
        const names = namesFor(size, size), others = namesFor(40, size + 500);
        const o = bare ? Object.create(null) : {};
        for (let i = 0; i < names.length; i++) o[names[i]] = i;
        visit(o, names); visit(o, others.slice(0, 10)); visit(o, marks);
        Object.defineProperty(o, names[3], { get() { return "got"; }, set(v) { this.caught = v; }, configurable: true, enumerable: true });
        Object.defineProperty(o, names[5], { value: "fixed", writable: false, configurable: true, enumerable: true });
        o[marks[0]] = "marked";
        visit(o, names.slice(0, 12)); visit(o, marks);
        for (let i = 0; i < names.length; i += 3) note(delete o[names[i]]);
        visit(o, names.slice(0, 40));
        for (let i = names.length - 1; i >= 0; i -= 3) note(attempt(() => { o[names[i]] = -i; }));
        visit(o, names.slice(-40));
        const below = Object.create(o); below.own = 1;
        visit(below, names.slice(0, 30)); visit(below, ["own", "caught", "toString", "__proto__", "constructor"]);
        note(Object.keys(o).length); note(Object.keys(below).length);
        const kept = names.join(" ").split(" ");
        visit(o, kept.slice(10, 50));
        Object.freeze(o);
        visit(o, names.slice(20, 40)); visit(below, names.slice(20, 40));
        console.log(size, bare, sum, Object.keys(o).length, Reflect.ownKeys(below).length);
    }
}
//// one-place-reads-a-name-from-objects-of-many-kinds.js
// One place in the text reads one name from objects of many kinds in turn: what is remembered at the place fits one of them at most,
// so the others are answered by what is remembered for their kind. Then the kinds change under the place.
function read(object) {
  return object.mark;
}
function readTwice(object) {
  return [object.mark, object.other];
}

class Field {
  constructor(mark) {
    this.mark = mark;
  }
}
class Late {
  constructor() {
    this.first = 1;
  }
}
class Inherits {}
Inherits.prototype.mark = "from the prototype";
class Computes {
  get mark() {
    return "computed " + this.seed;
  }
  constructor(seed) {
    this.seed = seed;
  }
}
class Lacks {
  constructor() {
    this.nothing = 0;
  }
}
function Bag() {}
Bag.prototype = Object.create(null);

function make(kind, i) {
  switch (kind) {
    case 0:
      return new Field("field " + i);
    case 1: {
      const late = new Late();
      late["ma" + "rk"] = "extra " + i;
      return late;
    }
    case 2:
      return new Inherits();
    case 3:
      return new Computes(i);
    case 4:
      return new Lacks();
    case 5:
      return JSON.parse('{"mark":"parsed ' + i + '"}');
    case 6: {
      const many = JSON.parse("{}");
      for (let n = 0; n < 12; n++) many["k" + n] = n;
      many.mark = "out of line " + i;
      return many;
    }
    case 7: {
      const bag = new Bag();
      bag["other"] = i;
      bag["mark"] = "bag " + i;
      return bag;
    }
    case 8:
      return Object.create({ mark: "above an ordinary object" });
    case 9:
      return function () {};
    case 10:
      return [i];
    case 11:
      return "text";
    default:
      return i;
  }
}

const kinds = 13;
function round(label) {
  const seen = [];
  for (let i = 0; i < kinds * 40; i++) {
    const value = read(make(i % kinds, i));
    if (i >= kinds * 39) seen.push(String(value));
  }
  console.log(label, seen.join(" | "));
}
round("as they are made:");

Object.defineProperty(Lacks.prototype, "mark", { configurable: true, get() { return "now computed above"; } });
round("a getter above the one that lacked it:");
delete Lacks.prototype.mark;
Inherits.prototype.mark = "stored again above";
round("the getter gone, another value above:");
delete Inherits.prototype.mark;
const top = { mark: "at the top" };
Object.setPrototypeOf(Inherits.prototype, top);
Object.setPrototypeOf(Lacks.prototype, top);
Object.setPrototypeOf(Bag.prototype, top);
round("another object at the top of three chains:");
delete top.mark;
round("and nothing in it:");
top.mark = "there again";
Object.setPrototypeOf(Lacks.prototype, Object.prototype);
Object.setPrototypeOf(Computes.prototype, { other: "far above" });
round("as at first, but for what was deleted:");

const pairs = [];
for (let i = 0; i < kinds * 30; i++) {
  const object = make(i % kinds, i);
  if (i % kinds === 0 && i % 2) delete object.mark;
  if (i % kinds === 1 && i % 2) Object.defineProperty(object, "mark", { get() { return "own getter"; } });
  if (i % kinds === 5 && i % 2) Object.freeze(object);
  if (i % kinds === 7 && i % 2) delete object.other;
  const pair = readTwice(object);
  if (i >= kinds * 28) pairs.push(pair.map(String).join("+"));
}
console.log(pairs.join(" | "));
