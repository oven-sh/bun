delete globalThis.shared;

console.log("inherited: " + (readByKey(keys[1], trips) === Object.prototype.hasOwnProperty) + " " + hasOwnByKey(keys[1], trips));
console.log("never there: " + readByKey(keys[2], trips) + " " + hasOwnByKey(keys[2], trips));
