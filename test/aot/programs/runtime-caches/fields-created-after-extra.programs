////: readAll
function readAll(receiver) {
    const parts = [];
    for (const read of readers) {
        const value = read(receiver);
        parts.push(read.name + "=" + (typeof value === "function" ? "function " + value.name : String(value)));
    }
    return parts.join(" ");
}
////: repeated
function repeated(access) {
  const answer = access();
  for (let i = 1; i < «1»; i++) {
    const next = access();
    if (next !== answer) return answer + " then " + next + " at " + i;
  }
  return «2»;
}
////: stage
function stage(label: string) {
    for (let turn = 0; turn < 3; turn++) {
        const line = [
            show(() => trimOf("  a ")), show(() => trimStartOf("  a ")), show(() => trimEndOf("  a ")), show(() => atOf("abc", -1)), show(() => boldOf("b")),
            show(() => dateText(d)), show(() => dateTemplate(d)), show(() => dateConcat(d)), show(() => dateLocale(d)),
            show(() => errorText(e)), show(() => errorTemplate(e)), show(() => errorName(e)), show(() => errorMessage(e)), show(() => errorConstructor(e)),
            show(() => errorText(bare)), show(() => errorName(bare)), show(() => errorMessage(bare)),
            show(() => aborted(signal)), show(() => reason(signal)), show(() => throwIf(signal)), show(() => listen(target)),
            show(() => insert(m)), show(() => union(s)), show(() => weakInsert(w)),
        ].join(" | ");
        console.log(label, turn, line);
    }
}
//// fields-created-after-extra-properties.js
// A field that is created on an object which already has properties under names the compiler never saw:
// the keys keep the order of creation, however many such properties came first, and what was cached about
// the objects below a prototype does not outlive a field that the prototype gets.
const outOfSight = new Proxy({}, {});

////= Message
outOfSight.value = Message;

function addUnderUnknownNames(message, names) {
  for (const name of names) message[name] = name.length;
}

function finish(message, step) {
  message.status = step;
  if (step % 2) message.body = "b" + step;
  message.done = true;
}

