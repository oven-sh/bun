delete cat.legs;
round("shadow deleted");
Dog.prototype.legs = 5;
round("shadowed in the middle of the chain");
delete Dog.prototype.legs;
round("middle shadow deleted");
delete Animal.prototype.legs;
round("deleted");
Animal.prototype.legs = 8;
