        }
    }
}
console.log(lines, sum);
//// typed-fields-from-untyped-code.ts
// Untyped code reads, stores, creates and deletes fields, extra properties and class members of typed objects, by name and by key. Each access runs in a loop until it is cached, then the cached answer is invalidated.
const turns: number = JSON.parse("40");
const box: any[] = JSON.parse("[0]");
function hidden(value: unknown): any { box[0] = value; return box[0]; }
function said(run: () => unknown): string { try { return String(run()); } catch (error) { return "threw " + (error as Error).constructor.name; } }
const lines: string[] = [];
function say(label: string, ...values: unknown[]): void { lines.push(label + ": " + values.map(String).join(" ")); }

class Sample { flag: boolean = true; maybeFlag: boolean | undefined = undefined; small: number = 1; real: number = 1.5; either: number = 1; maybeNumber: number | undefined = undefined; text: string = "a"; big: bigint = 10n; link: Sample | null = null; loose: any = 0; declare late?: number;
  handler = () => this.small; method() { return this.small + 1; } get doubled() { return this.small * 2; } set doubled(value: number) { this.small = value / 2; } }
type Entry = { id: number; note?: string };
function makeEntry(id: number): Entry { return { id }; }
const fieldNames: string[] = JSON.parse('["flag","maybeFlag","small","real","either","maybeNumber","text","big","link","loose"]');
const int32AndDoubleValues: any[] = JSON.parse("[1.5,2,-0,2147483648]");

function valuesFor(o: any, i: number): any[] {
  return hidden([i % 2 === 0, i % 3 ? true : undefined, i, i + 0.5, int32AndDoubleValues[i % 4], i % 3 ? i : undefined, "t" + i, BigInt(i), i % 2 ? o : null, i % 2 ? "s" : i]);
}
function readByName(o: any): string {
  const answers = new Set<string>();
  for (let i = 0; i < turns; i++) {
    answers.add(o.flag + " " + o.maybeFlag + " " + o.small + " " + o.real + " " + o.either + " " + o.maybeNumber + " " + o.text + " " + o.big + " " + o.link + " " + o.loose);
  }
  return [...answers].join(" | ");
}
function readByKey(o: any, names: string[]): string {
  const answers = new Set<string>();
  for (let i = 0; i < turns; i++) {
    const values: string[] = [];
    for (let k = 0; k < names.length; k++) values.push("" + o[names[k]]);
    answers.add(values.join(" "));
  }
  return [...answers].join(" | ");
}
function storeByName(o: any, i: number): void {
  for (let round = 0; round < turns; round++, i++) {
    const values = valuesFor(o, i);
    o.flag = values[0];
    o.maybeFlag = values[1];
    o.small = values[2];
    o.real = values[3];
    o.either = values[4];
    o.maybeNumber = values[5];
    o.text = values[6];
    o.big = values[7];
    o.link = values[8];
    o.loose = values[9];
  }
}
function storeByKey(o: any, names: string[], i: number): void {
  for (let round = 0; round < turns; round++, i++) {
    const values = valuesFor(o, i);
    for (let k = 0; k < names.length; k++) o[names[k]] = values[k];
  }
}
const sample = new Sample();
const untypedSample = hidden(sample);
say("created, read by name", readByName(untypedSample));
say("created, read by key", readByKey(untypedSample, fieldNames));
for (const first of [1, 2, 3]) {
  storeByName(untypedSample, first);
  say("stored by name, read by name", readByName(untypedSample));
  say("stored by name, read by key", readByKey(untypedSample, fieldNames));
  storeByKey(untypedSample, fieldNames, first + 3);
  say("stored by key, read by name", readByName(untypedSample));
  say("stored by key, read by key", readByKey(untypedSample, fieldNames));
  say("stored by key, read by typed code", sample.small + sample.real, sample.text, sample.link === sample);
}

function storeEither(o: any, value: any): void {
  for (let i = 0; i < turns; i++) o.either = value;
}
function readEither(o: any, key: string): string {
  const answers = new Set<string>();
  for (let i = 0; i < turns; i++) answers.add(o.either + " " + Object.is(o.either, -0) + " " + o[key] + " " + Object.is(o[key], -0));
  return [...answers].join(" | ");
}
for (const value of int32AndDoubleValues) {
  storeEither(untypedSample, value);
  say("int32 or double", readEither(untypedSample, fieldNames[4]), sample.either, Object.is(sample.either, -0));
}

function readNote(o: any): string {
  const answers = new Set<string>();
  for (let i = 0; i < turns; i++) answers.add(o.note + " " + ("note" in o));
  return [...answers].join(" | ");
}
const entry = makeEntry(1);
const untypedEntry = hidden(entry);
say("optional record field, absent", readNote(untypedEntry), entry.note);
untypedEntry.note = "n";
say("optional record field, stored", readNote(untypedEntry), entry.note);
delete untypedEntry.note;
say("optional record field, deleted", readNote(untypedEntry), entry.note);

function readLate(o: any): string {
  const answers = new Set<string>();
  for (let i = 0; i < turns; i++) answers.add(o.late + " " + ("late" in o) + " " + Object.hasOwn(o, "late"));
  return [...answers].join(" | ");
}
const partial = new Sample();
const untypedPartial = hidden(partial);
say("optional class field, absent", readLate(untypedPartial), partial.late);
untypedPartial.late = 5;
say("optional class field, stored", readLate(untypedPartial), partial.late);
delete untypedPartial.late;
say("optional class field, deleted", readLate(untypedPartial), partial.late);
(Sample.prototype as any).late = 9;
say("optional class field, absent below a prototype property", readLate(untypedPartial), partial.late);
delete (Sample.prototype as any).late;
say("optional class field, prototype property deleted", readLate(untypedPartial), partial.late);

function createLate(create: () => Sample): string {
  let sum = 0;
  let last = create();
  for (let i = 0; i < turns; i++) {
    last = create();
    hidden(last).late = i;
    sum += last.late!;
  }
  return sum + " " + Object.keys(last).join();
}
say("field created by an untyped store", createLate(() => new Sample()));
say("field created on a frozen object", said(() => createLate(() => Object.freeze(new Sample()))));
say("field created on a non-extensible object", said(() => createLate(() => Object.preventExtensions(new Sample()))));
say("field created by an untyped store again", createLate(() => new Sample()));

let seen: unknown = "nothing";
function addExtra(): any {
  let o: any;
  for (let i = 0; i < turns; i++) {
    o = hidden(new Sample());
    o.extra = i;
  }
  return o;
}
function storeExtra(o: any): void {
  for (let i = 0; i < turns; i++) o.extra = 100 + i;
}
function readExtra(o: any): string {
  const answers = new Set<string>();
  for (let i = 0; i < turns; i++) answers.add(o.extra + " " + ("extra" in o));
  return [...answers].join(" | ");
}
const extended = addExtra();
say("extra property, added", readExtra(extended));
storeExtra(extended);
say("extra property, replaced", readExtra(extended));
delete extended.extra;
say("extra property, deleted", readExtra(extended));
Object.defineProperty(extended, "extra", { get() { return 7; }, set(v) { seen = v; }, configurable: true });
storeExtra(extended);
say("extra property, accessor", readExtra(extended), seen, Object.keys(extended).join());
Object.defineProperty(Sample.prototype, "extra", { set(v) { seen = "prototype " + v; }, configurable: true });
say("extra property, added below a prototype setter", Object.hasOwn(addExtra(), "extra"), seen);
delete (Sample.prototype as any).extra;
say("extra property, prototype setter deleted", Object.hasOwn(addExtra(), "extra"), seen);

function addAndReadExtra(create: () => unknown): number {
  let sum = 0;
  for (let i = 0; i < turns; i++) {
    const o = hidden(create());
    o.extra = i;
    sum += o.extra;
  }
  return sum;
}
class BelowProxy { own: number = 1; }
let trapCalls = 0;
Object.setPrototypeOf(BelowProxy.prototype, new Proxy({}, { set(target, key, value, receiver) { trapCalls++; return Reflect.set(target, key, value, receiver); } }));
say("extra property, added by a proxy on the prototype chain", addAndReadExtra(() => new BelowProxy()), trapCalls);
class BelowDefiningSetter { own: number = 1; }
let setterCalls = 0;
Object.defineProperty(BelowDefiningSetter.prototype, "extra", { set(value) { setterCalls++; Object.defineProperty(this, "extra", { value, writable: true, enumerable: true, configurable: true }); }, configurable: true });
say("extra property, added by a prototype setter", addAndReadExtra(() => new BelowDefiningSetter()), setterCalls);

function useMembers(o: any): string {
  const answers = new Set<string>();
  for (let i = 0; i < turns; i++) {
    o.doubled = 8;
    answers.add(o.method() + " " + o.doubled + " " + o.small);
  }
  return [...answers].join(" | ");
}
const instance = new Sample();
const untypedInstance = hidden(instance);
say("class members", useMembers(untypedInstance), instance.method(), instance.doubled);
Sample.prototype.method = function () { return -1; };
say("class members, method replaced", useMembers(untypedInstance), instance.method(), instance.doubled);
Object.defineProperty(Sample.prototype, "doubled", { get() { return -2; }, set(value) { this.small = value; }, configurable: true });
say("class members, accessor replaced", useMembers(untypedInstance), instance.method(), instance.doubled);

function readHandler(o: any, typed: Sample): string {
  const answers = new Set<string>();
  for (let i = 0; i < turns; i++) answers.add((o.handler === o.handler) + " " + o.handler() + " " + (typed.handler === o.handler));
  return [...answers].join(" | ");
}
const listener = new Sample();
const untypedListener = hidden(listener);
say("closure in a field", readHandler(untypedListener, listener));
untypedListener.handler = () => 5;
say("closure in a field, replaced", readHandler(untypedListener, listener));

console.log(lines.join("\n"));
export {};
//// undefined-and-null-stored-by-name-in-fields-of-numbers-and-booleans.ts
// A field that its class declares as a number or a boolean gets undefined or null from code that knows nothing of the class, by name and by key, behind the constructor.
// Typed code that reads the field afterwards sees what plain Bun sees, whether every constructor fills the field or it is created later, and so does whoever lists the keys.
class Filled {
  count: number;
  ratio: number;
  ready: boolean;
  constructor(seed: number) {
    this.count = seed | 0;
    this.ratio = seed + 0.5;
    this.ready = (seed & 1) === 1;
  }
}
class Late {
  id: number;
  declare count: number;
  declare ratio: number;
  declare ready: boolean;
  constructor(seed: number) {
    this.id = seed | 0;
  }
}
const data: any = JSON.parse('{"values":[null,1,2.5,true,false,-7,1e10],"names":["count","ratio","ready"]}');
const values: any[] = [undefined, ...data.values];

function storeCount(o: any, v: any) { o.count = v; }
function storeRatio(o: any, v: any) { o.ratio = v; }
function storeReady(o: any, v: any) { o.ready = v; }
function storeByKey(o: any, key: any, v: any) { o[key] = v; }
function define(o: any, v: any) { Object.defineProperty(o, "count", { value: v, writable: true, enumerable: true, configurable: true }); }

function sumOfFilled(o: Filled): string { return `${o.count + 1} ${o.ratio * 2} ${o.ready ? "yes" : "no"} ${o.count === undefined} ${o.ratio === null} ${typeof o.ready}`; }
function sumOfLate(o: Late): string { return `${o.id} ${o.count + 1} ${o.ratio * 2} ${o.ready ? "yes" : "no"} ${o.count === undefined} ${o.ratio === null} ${typeof o.ready}`; }
function describe(o: object): string { return `${Object.keys(o).join()} ${JSON.stringify(o)} ${"count" in o} ${Object.hasOwn(o, "ready")}`; }

const lines: string[] = [];
for (let turn = 0; turn < 40; turn++) {
  for (const first of values) {
    for (const second of [values[turn % values.length], undefined, null, 3]) {
      const filled = new Filled(turn);
      const late = new Late(turn);
      const before = sumOfFilled(filled) + " | " + sumOfLate(late);
      storeCount(filled, first); storeRatio(filled, second); storeReady(filled, first);
      storeCount(late, first); storeRatio(late, second); storeReady(late, first);
      const between = sumOfFilled(filled) + " | " + sumOfLate(late) + " | " + describe(filled) + " | " + describe(late);
      storeCount(filled, second); storeByKey(filled, data.names[turn % 3], first); storeCount(late, second); storeByKey(late, data.names[turn % 3], first);
      if (turn % 5 === 0) { define(filled, first); define(late, second); }
      if (turn % 7 === 0) { delete (late as any).count; storeCount(late, first); delete (filled as any).ratio; storeRatio(filled, second); }
      const after = sumOfFilled(filled) + " | " + sumOfLate(late) + " | " + describe(filled) + " | " + describe(late);
      if (turn < 8 || turn % 5 === 0 || turn % 7 === 0) lines.push(before, between, after);
    }
  }
}
console.log(lines.join("\n"));

// Objects that have had a marker and hold numbers again, beside objects that never had one.
const many: Filled[] = [];
for (let i = 0; i < 3000; i++) {
  const o = new Filled(i);
  if (i % 3 === 0) storeCount(o, i % 2 ? undefined : null);
  if (i % 6 === 0) storeCount(o, i);
  if (i % 5 === 0) storeReady(o, undefined);
  many.push(o);
}
let total = 0, holes = 0, ready = 0;
for (const o of many) {
  const sum = o.count + o.ratio;
  if (sum === sum) total += sum; else holes++;
  if (o.ready) ready++;
}
console.log(total, holes, ready);
//// what-a-method-found-by-name-returns-is-read-by-name-while-prototypes-change.js
// What a method found by name returns is itself read by name, for a Map and for a Buffer, while members of their prototypes are deleted and many names come and go.
////= churn
////= drop
function absent(o) { return o.nothingOfThisName; }
function absent2(o) { return o.nothingOfThatName; }

////= scene

const map = new Map([[1, "one"]]);
console.log(map.get(1), map.has(1), map.size);
scene("Map", map, Map.prototype, ["clear", "delete", "forEach", "entries", "keys", "values", "getOrInsert", "getOrInsertComputed"],
    [o => o.get(1), o => o.has(1), o => o.set(2, "two").size, o => typeof o.get, o => o.get.name, o => o.has.name, o => o.set.name]);

const buffer = Buffer.from("abc");
console.log(buffer.toString("hex"), buffer.readUInt8(0), buffer.length);
scene("Buffer", buffer, Buffer.prototype, ["readInt8", "writeInt8", "swap16", "swap32", "readDoubleBE", "writeDoubleBE", "asciiSlice", "latin1Slice"],
    [o => o.toString("hex"), o => o.readUInt8(0), o => o.length, o => o.toString.name, o => o.readUInt8.name]);
//// workers-come-and-go-while-every-thread-changes-its-own-prototypes.ts
// Every thread runs the same work on its own objects and prototypes: shapes are made and dropped, members of prototypes come and go, collections run. Workers end while others go on. Each answer is held to the main thread's.
declare var self: Worker;
class Animal { name: string; legs: number; constructor(n: string, l: number) { this.name = n; this.legs = l; } speak(): string { return this.name + this.legs; } get twice(): number { return this.legs * 2; } }
class Dog extends Animal { tail = true; speak(): string { return "dog " + super.speak(); } }
function readAll(o: any): string { return [o.name, o.legs, o.tail, o.twice, o.size, o.missing, o.extra, o.length, typeof o.speak, typeof o.get, typeof o.trim, typeof o.getOrInsert, o.message].join(); }
function work(seed: number): string {
    let state = seed * 2654435761 >>> 0;
    const next = (n: number) => { state = (Math.imul(state, 1103515245) + 12345) >>> 0; return (state >>> 8) % n; };
    let sum = 0;
    const add = (t: string) => { for (let i = 0; i < t.length; i++) sum = (Math.imul(sum, 31) + t.charCodeAt(i)) | 0; };
    const pool: any[] = [new Animal("a", 4), new Dog("d", 4), new Map([[1, 2]]), new Set([1]), [1, 2, 3], "text", new Error("e"), { name: "lit", legs: 2 }, new Date(0), Object.create({ extra: 1 }), new Uint8Array(3), () => 1];
    const protos: any[] = [Animal.prototype, Dog.prototype, Map.prototype, Set.prototype, Error.prototype, String.prototype, Date.prototype, Object.getPrototypeOf(pool[9])];
    const open: [any, string][] = [[Map.prototype, "getOrInsert"], [Set.prototype, "union"], [String.prototype, "trim"], [Error.prototype, "message"], [Animal.prototype, "speak"], [Dog.prototype, "speak"], [Date.prototype, "toString"]];
    const kept = open.map(([o, k]) => Object.getOwnPropertyDescriptor(o, k)!);
    for (let step = 0; step < 400; step++) {
        switch (next(10)) {
        case 0: { const p = protos[next(protos.length)]; const n = 20 + next(90); for (let i = 0; i < n; i++) p["t" + i] = i; for (let i = 0; i < n; i++) delete p["t" + i]; break; }
        case 1: { const i = next(open.length); delete open[i][0][open[i][1]]; break; }
        case 2: { const i = next(open.length); Object.defineProperty(open[i][0], open[i][1], kept[i]); break; }
        case 3: { const i = next(open.length); Object.defineProperty(open[i][0], open[i][1], { get() { return () => "g" + i; }, configurable: true }); break; }
        case 4: { const o: any = {}; const n = next(40); for (let i = 0; i < n; i++) o["k" + next(50)] = i; add(Object.keys(o).join()); pool[7] = next(2) ? o : { name: "lit", legs: step }; break; }
        case 5: { protos[next(protos.length)].extra = step; break; }
        case 6: { for (const p of protos) delete p.extra; break; }
        case 7: { if (next(8) === 0) Bun.gc(true); break; }
        case 8: { const o = pool[next(2)]; o["own" + next(5)] = step; if (next(3) === 0) delete o["own" + next(5)]; break; }
        default: break;
        }
        for (const o of pool) add(readAll(o));
        try { add(pool[1].speak() + pool[0].speak() + "  x ".trim() + String(pool[6]) + pool[2].getOrInsert(3, 4)); } catch (e: any) { add(e.constructor.name); }
    }
    open.forEach(([o, k], i) => Object.defineProperty(o, k, kept[i]));
    for (const p of protos) delete p.extra;
    return String(sum);
}
if (Bun.isMainThread) {
    const seeds = 6;
    const expected: string[] = []; for (let s = 0; s < seeds; s++) expected.push(work(s));
    let right = 0, wrong = 0, ended = 0;
    for (let round = 0; round < 6; round++) {
        const workers: Worker[] = []; const waits: Promise<void>[] = [];
        for (let i = 0; i < 12; i++) {
            const worker = new Worker(import.meta.url); workers.push(worker);
            waits.push(new Promise<void>(resolve => {
                let answers = 0;
                worker.onmessage = (event: MessageEvent) => { const [seed, answer] = event.data; if (answer === expected[seed]) right++; else wrong++; if (++answers === seeds) resolve(); };
                if (i % 3 === 2) setTimeout(() => { worker.terminate(); ended++; resolve(); }, 5 + i * 7);
            }));
            worker.postMessage(seeds);
        }
        for (let s = 0; s < seeds; s++) if (work(s) !== expected[s]) wrong++;
        await Promise.all(waits);
        for (const worker of workers) await worker.terminate();
    }
    console.log("wrong", wrong, right > 100);
} else {
    self.onmessage = (event: MessageEvent) => { for (let s = 0; s < event.data; s++) self.postMessage([s, work(s)]); };
}
