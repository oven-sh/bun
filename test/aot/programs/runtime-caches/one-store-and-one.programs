//// reads-of-fields-that-exist-without-storage.js
// Reads by name and by symbol of fields that a store of undefined creates and that have no storage then: never created, created with undefined, filled, deleted, redefined,
// while the prototype has nothing of the name, gets undefined, another value, a getter, and loses it again. Every read runs often enough to be answered by a cache.
var unseen = new Function("x", "return x");
var kMark = Symbol("mark");

function Base() {}
Base.prototype.origin = "base";
unseen(Base);

////= Message
Object.setPrototypeOf(Message.prototype, Base.prototype);
Message.prototype.kind = "message";
unseen(Message);

function fillOthers(message, value) {
  message.first = value;
  message.second = value;
  message.third = value;
  message.fourth = value;
  message.fifth = value;
  message.sixth = value;
  message.seventh = value;
  message.eighth = value;
  message.ninth = value;
  message.tenth = value;
  message.eleventh = value;
  message.twelfth = value;
  message.thirteenth = value;
  message.fourteenth = value;
  message.fifteenth = value;
  message.sixteenth = value;
}

function setStatus(message, value) {
  message.status = value;
  message[kMark] = value;
}

function listStatus(message) {
  message.status = undefined;
  message[kMark] = undefined;
}

function readStatus(message) {
  return message.status;
}

function readMark(message) {
  return message[kMark];
}

// The fields that are read and filled most stay in the cell. The two that this is about are to lie outside of it.
function countOthers(message) {
  var count = 0;
  for (var round = 0; round < 3; round++) {
    for (var inner = 0; inner < 3; inner++) {
      fillOthers(message, message.first);
      if (message.first) count++;
      if (message.second) count++;
      if (message.third) count++;
      if (message.fourth) count++;
      if (message.fifth) count++;
      if (message.sixth) count++;
      if (message.seventh) count++;
      if (message.eighth) count++;
      if (message.ninth) count++;
      if (message.tenth) count++;
      if (message.eleventh) count++;
      if (message.twelfth) count++;
      if (message.thirteenth) count++;
      if (message.fourteenth) count++;
      if (message.fifteenth) count++;
      if (message.sixteenth) count++;
    }
  }
  return count;
}

var readers = unseen({ readStatus, readMark });

function describe(message) {
  var byName;
  var bySymbol;
  for (var round = 0; round < 60; round++) {
    byName = readers.readStatus(message);
    bySymbol = readers.readMark(message);
  }
  return [
    String(byName),
    String(bySymbol),
    "status" in message,
    kMark in message,
    Object.prototype.hasOwnProperty.call(message, "status"),
    Object.prototype.hasOwnProperty.call(message, kMark),
    Object.keys(message).indexOf("status"),
    Object.getOwnPropertySymbols(message).length,
  ].join(" ");
}

function make() {
  var never = unseen(new Message(1));
  var listed = unseen(new Message(2));
  listStatus(listed);
  var filled = unseen(new Message(3));
  setStatus(filled, "filled");
  var emptied = unseen(new Message(4));
  setStatus(emptied, "once");
  listStatus(emptied);
  var deleted = unseen(new Message(5));
  listStatus(deleted);
  delete deleted.status;
  delete deleted[kMark];
  var besideOthers = unseen(new Message(6));
  fillOthers(besideOthers, 1);
  besideOthers.id += countOthers(besideOthers);
  fillOthers(besideOthers, "text");
  besideOthers.id += countOthers(besideOthers);
  fillOthers(besideOthers, 0.5);
  besideOthers.id += countOthers(besideOthers);
  fillOthers(besideOthers, besideOthers);
  besideOthers.id += countOthers(besideOthers);
  var listedBesideOthers = unseen(new Message(7));
  listStatus(listedBesideOthers);
  fillOthers(listedBesideOthers, undefined);
  var withExtraProperty = unseen(new Message(8));
  withExtraProperty["made up " + withExtraProperty.id] = 1;
  var listedWithExtraProperty = unseen(new Message(9));
  listedWithExtraProperty["made up " + listedWithExtraProperty.id] = 1;
  setStatus(listedWithExtraProperty, undefined);
  var redefined = unseen(new Message(10));
  listStatus(redefined);
  Object.defineProperty(redefined, "status", { value: undefined, enumerable: false, writable: false, configurable: true });
  Object.defineProperty(redefined, kMark, { get() { return "own getter"; }, configurable: true });
  var frozen = unseen(new Message(11));
  listStatus(frozen);
  Object.freeze(frozen);
  var heir = unseen(Object.create(listed));
  return { never, listed, filled, emptied, deleted, besideOthers, listedBesideOthers, withExtraProperty, listedWithExtraProperty, redefined, frozen, heir };
}

function report(title) {
  var messages = make();
  var lines = [title];
  for (var name in messages) lines.push("  " + name + ": " + describe(messages[name]));
  for (var name in kept) lines.push("  kept " + name + ": " + describe(kept[name]));
  console.log(lines.join("\n"));
}

var kept = make();
report("nothing above");

Message.prototype.status = undefined;
Message.prototype[kMark] = undefined;
report("undefined above");

Message.prototype.status = 5;
Message.prototype[kMark] = null;
report("a value above");

Message.prototype.status = undefined;
Message.prototype[kMark] = undefined;
report("undefined above again");

function accessorFor(key, title) {
  return {
    get() { return title + this.id; },
    set(value) { Object.defineProperty(this, key, { value, writable: true, enumerable: true, configurable: true }); },
    configurable: true,
  };
}
Object.defineProperty(Message.prototype, "status", accessorFor("status", "getter of "));
Object.defineProperty(Message.prototype, kMark, accessorFor(kMark, "symbol getter of "));
report("a getter above");

delete Message.prototype.status;
delete Message.prototype[kMark];
report("nothing above again");

Base.prototype.status = "from Base.prototype";
Base.prototype[kMark] = "symbol from Base.prototype";
report("a value far above");

Base.prototype.status = undefined;
Base.prototype[kMark] = undefined;
report("undefined far above");

delete Base.prototype.status;
delete Base.prototype[kMark];
report("nothing above at the end");

Object.setPrototypeOf(Message.prototype, { status: "from a new parent", [kMark]: 0 });
report("a new parent");
//// reads-past-the-site-cache-limit.js
// Past the limit on site caches a read by name calls a stub that takes the receiver in the register it is already in, and the receiver has to outlive the call for the next read.
function two(o) { return o.first === o.second; }
function three(o) { return [o.first, o.second, o.third]; }
function sum(o) { return o.first + o.second + o.third + o.first + o.second + o.third; }
function twoReceivers(a, b) { return [a.first, b.first, a.second, b.second, a.third, b.third]; }
function manyReceivers(a, b, c, d, e, f) { return [a.first, b.first, c.first, d.first, e.first, f.first, a.second, b.second, c.second, d.second, e.second, f.second]; }
function inLoop(o, n) { let s = 0; for (let i = 0; i < n; i++) s += o.first + o.second; return s; }
function nested(o) { return o.inner.first + o.inner.second + o.first; }

class Point { constructor(x) { this.first = x; this.second = x; this.third = x + 1; } }
class WithAccessors { #x; constructor(x) { this.#x = x; } get first() { return this.#x; } get second() { return this.#x; } get third() { return this.#x + 1; } }
function outOfLine(x) { const o = {}; for (let i = 0; i < 40; i++) o["own" + i] = i; o.first = x; o.second = x; o.third = x + 1; return o; }
function dictionary(x) { const o = outOfLine(x); for (let i = 0; i < 40; i += 2) delete o["own" + i]; return o; }
function inherited(x) { return Object.create({ first: x, second: x, third: x + 1 }); }
function partlyInherited(x) { const o = Object.create({ second: x }); o.first = x; o.third = x + 1; return o; }
Number.prototype.first = 1; Number.prototype.second = 1; Number.prototype.third = 2;
String.prototype.third = 3;

const receivers = [
  x => ({ first: x, second: x, third: x + 1 }), x => ({ third: x + 1, second: x, first: x }), x => new Point(x), x => new WithAccessors(x), outOfLine, dictionary, inherited, partlyInherited,
  x => x, x => "text" + x, x => [x], x => ({}), x => Object.assign(() => x, { first: x, second: x, third: x + 1 }), x => new Proxy({ first: x, second: x, third: x + 1 }, {}),
];
const show = v => JSON.stringify(v, (k, w) => (w === undefined ? "undefined" : w));
for (let round = 0; round < 3; round++) {
  const lines = [];
  receivers.forEach((make, i) => {
    const o = make(i + round);
    lines.push([two(o), three(o), sum(o), inLoop(o, 100), nested({ inner: o, first: round })].map(show).join(" "));
    receivers.forEach((other, j) => lines.push(show(twoReceivers(o, other(j)))));
  });
  lines.push(show(manyReceivers(...receivers.slice(round, round + 6).map((make, i) => make(i)))));
  if (!round) console.log(lines.join("\n"));
  else console.log(lines.length);
}
//// run-time-text-reads-and-stores-fields-of-compiled-objects-at-sites-that-remember.js
"use strict";
// Text that nobody knows at the build runs in the interpreter, whose accesses by name remember what they saw last. Here they see fields of compiled objects that come, go and change their form.
const unknown = String(process.argv.length > 99 ? process.argv[99] : "");
const text = (parameters, body) => new Function(...parameters, body + unknown);
const lines = [];
const say = (...values) => lines.push(values.map(value => typeof value === "string" ? value : Object.is(value, -0) ? "-0" : typeof value === "symbol" || typeof value === "bigint" ? String(value) : JSON.stringify(value) ?? String(value)).join(" "));

class Point {
  constructor(x, y) {
    this.x = x;
    this.y = y;
  }
}
class Holder {
  constructor(value) {
    this.value = value;
  }
  late() {
    this.added = "late";
  }
}
class Below extends Holder {}
function Old(value) {
  this.value = value;
}
Old.prototype.shared = "from the prototype";

const readValue = text(["o"], "return o.value;");
const readAdded = text(["o"], "return o.added;");
const readX = text(["o"], "return o.x;");
const readShared = text(["o"], "return o.shared;");
const hasValue = text(["o"], "return 'value' in o;");
const hasAdded = text(["o"], "return 'added' in o;");
const storeValue = text(["o", "v"], "o.value = v; return o;");

// Every kind of value at one site.
for (const value of [1, -0, 1.5, NaN, "text", "", true, false, null, undefined, { a: 1 }, [1, 2], 10n, Symbol.for("s"), () => 1]) {
  const holder = new Holder(value);
  for (let i = 0; i < 3; i++) say("value", typeof readValue(holder), typeof value === "function" ? "function" : readValue(holder));
}

// A field that goes and comes back, in every way.
{
  const holder = new Holder("first");
  for (let i = 0; i < 4; i++) readValue(holder);
  say(readValue(holder), hasValue(holder));
  delete holder.value;
  say(readValue(holder), hasValue(holder));
  Holder.prototype.value = "inherited";
  say(readValue(holder), hasValue(holder), readValue(new Holder("own")));
  delete Holder.prototype.value;
  say(readValue(holder), hasValue(holder));
  holder.value = "again";
  say(readValue(holder), hasValue(holder), Object.keys(holder).join());
  let calls = 0;
  Object.defineProperty(holder, "value", { get() { return "getter " + ++calls; }, configurable: true, enumerable: true });
  say(readValue(holder), readValue(holder), hasValue(holder));
  Object.defineProperty(holder, "value", { value: "data again", writable: true, configurable: true, enumerable: true });
  say(readValue(holder), readValue(new Holder("other")));
}

// A field that is created late.
{
  const holder = new Holder(0);
  for (let i = 0; i < 4; i++) say(readAdded(holder), hasAdded(holder));
  holder.late();
  for (let i = 0; i < 4; i++) say(readAdded(holder), hasAdded(holder));
  say(readAdded(new Holder(1)), hasAdded(new Holder(1)));
}

// One site, many kinds of receivers, in turns.
{
  const receivers = [new Holder("holder"), new Below("below"), new Old("old"), { value: "literal" }, { other: 1, value: "second literal" }, Object.create({ value: "above" }), Object.assign(new Holder("with more"), { ["m" + unknown]: 1 }), "string", 5, [], new Map()];
  for (let round = 0; round < 4; round++) {
    for (const receiver of receivers) say(round, readValue(receiver), typeof receiver === "object" ? hasValue(receiver) : "-");
  }
  for (const nothing of [null, undefined]) {
    try {
      readValue(nothing);
    } catch (error) {
      say(error.constructor.name);
    }
  }
}

// Fields that hold raw numbers, and a method and a value of the prototype.
{
  const points = [new Point(1, 2), new Point(1.5, 2), new Point(-0, 0), new Point(2 ** 31, 0), new Point(NaN, 0)];
  for (let round = 0; round < 3; round++) for (const point of points) say(readX(point));
  for (let round = 0; round < 4; round++) say(readShared(new Old(round)));
  Old.prototype.shared = "changed";
  say(readShared(new Old(0)));
  const own = new Old(1);
  own.shared = "own";
  say(readShared(own), readShared(new Old(2)));
}

// Stores.
{
  const holder = new Holder("start");
  for (const value of ["a", 1, null, undefined, { b: 1 }, 1.5, true]) say(storeValue(holder, value).value, readValue(holder));
  const frozen = Object.freeze(new Holder("frozen"));
  try {
    text(["o"], "'use strict'; o.value = 1;")(frozen);
  } catch (error) {
    say(error.constructor.name, frozen.value);
  }
  storeValue(frozen, 2);
  say(frozen.value);
  const emptied = new Holder("x");
  delete emptied.value;
  say(storeValue(emptied, "created by text").value, Object.keys(emptied).join());
}

// Structures that die while sites remember them.
{
  let sum = 0;
  for (let round = 0; round < 40; round++) {
    const reader = text(["o"], "return o.value;");
    for (let i = 0; i < 30; i++) {
      const holder = new Holder(i);
      holder["extra" + round + "_" + (i & 3) + unknown] = i;
      sum += reader(holder) + readValue(holder);
    }
    if (round % 8 === 7) Bun.gc(true);
  }
  say("sum", sum);
}

// Properties that text adds to its own objects below prototypes that change.
{
  const top = { marker: "top" };
  const middle = Object.create(top);
  const make = text(["proto"], "const o = Object.create(proto); o.k = 1; o.l = 2; return o;");
  const plain = text([], "const o = {}; o.k = 1; o.l = 2; return o;");
  for (let i = 0; i < 5; i++) say(Object.keys(make(middle)).join(), Object.keys(plain()).join());
  const seen = [];
  Object.defineProperty(top, "l", { set(value) { seen.push("top " + value); }, configurable: true });
  say(Object.keys(make(middle)).join(), seen.join());
  Object.defineProperty(middle, "k", { set(value) { seen.push("middle " + value); }, configurable: true });
  say(Object.keys(make(middle)).join(), seen.join(), Object.keys(plain()).join());
  delete top.l;
  delete middle.k;
  say(Object.keys(make(middle)).join(), seen.join());
  Object.defineProperty(top, "k", { value: "read only", writable: false, configurable: true });
  say(Object.keys(make(middle)).join(), make(middle).k);
}

// Empty array literals of text, whose sites learn what the arrays come to hold.
{
  const fresh = text(["v", "n"], "const a = []; for (let i = 0; i < n; i++) a.push(v); return a;");
  for (const value of [1, 1.5, "s", undefined, { o: 1 }, 2, 2.5]) {
    for (const n of [0, 1, 4, 5, 6, 9]) {
      const array = fresh(value, n);
      say(array.length, 0 in array, n in array, array[n], array[5], JSON.stringify(array));
    }
  }
  const sparse = text([], "const a = []; a[3] = 1.5; return a;");
  for (let i = 0; i < 4; i++) say(JSON.stringify(sparse()), Object.keys(sparse()).join(), 1 in sparse());
  const filled = text(["a", "b", "c"], "return [[a], [a, b], [a, b, c], [a, b, c, a, b, c, a]];");
  for (const [a, b, c] of [[1, 2, 3], [1.5, 2, 3], ["x", 2, null], [undefined, undefined, undefined]]) say(JSON.stringify(filled(a, b, c)));
}

console.log(lines.length);
console.log(lines.join("\n"));
//// setters-defined-by-name-on-a-literal-found-below-created-objects.cjs
// Sloppy code. Accessors put on a literal by __defineSetter__ and __defineGetter__ under names that come out of a list hand on to a member of the receiver. They are found by name and by key
// from objects made by Object.create. A setter's result is dropped, a setter that throws is seen, a setter that changes the chain it was found on is called once.
const log = [];
const context = { kind: "context" };
function handOn(holder, target, name) {
  holder.__defineGetter__(name, function () {
    return this[target][name];
  });
  holder.__defineSetter__(name, function (value) {
    log.push("hands on " + name);
    return (this[target][name] = value);
  });
}
for (const name of ["body", "status"]) handOn(context, "answer", name);
const application = Object.create(context);
function make() {
  const made = Object.create(application);
  made.answer = { body: null, status: 404 };
  return made;
}
function storeByName(object, value) {
  return (object.body = value);
}
function storeByKey(object, key, value) {
  return (object[key] = value);
}
for (let i = 0; i < 60; i++) {
  storeByName(make(), i);
  storeByKey(make(), i & 1 ? "body" : "status", i);
}
log.length = 0;
let current = make();
log.push("the value of the assignment " + storeByName(current, "text") + " " + current.answer.body + " " + Object.keys(current));
log.push("by key " + storeByKey(current, "status", 200) + " " + current.answer.status + " " + current.status);
context.__defineSetter__("body", function (value) {
  throw new RangeError("refused " + value);
});
try {
  storeByName(make(), 1);
} catch (error) {
  log.push(error.name + " " + error.message);
}
context.__defineSetter__("body", function (value) {
  log.push("removes itself " + value);
  delete context.body;
});
current = make();
storeByName(current, 2);
log.push("behind the first " + Object.keys(current));
storeByName(current, 3);
log.push("behind the second " + Object.keys(current) + " " + current.body);
current = make();
storeByName(current, 4);
log.push("a new object " + Object.keys(current) + " " + current.body);
context.__defineGetter__("body", function () {
  return "a getter alone";
