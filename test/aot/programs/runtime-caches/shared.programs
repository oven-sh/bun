////: Message
function Message(id) {
  this.id = id;
}
////: churn
function churn(proto, tag) {
    for (let i = 0; i < 300; i++) {
        try {
            proto[tag + i] = i;
            delete proto[tag + i];
        } catch {
            return;
        }
    }
}
////: drop
function drop(proto, names) {
    const done = [];
    for (const name of names) {
        try { if (delete proto[name]) done.push(name); } catch (e) { done.push("!" + name); }
    }
    return done.length;
}
