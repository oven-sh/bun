//// closures-die-and-their-cells-come-back-at-a-call.js
// A call site meets a closure, the closure dies, and a collection later other closures, of other code, stand where it stood. The site calls each of them, not what it remembers.
const unknown = value => new CustomEvent("unknown", { detail: value }).detail; // what native code hands back is unknown to the compiler

function callIt(callee) {
  return callee(1);
}
function callMethod(holder) {
  return holder.act(2);
}
function construct(callee) {
  return new callee(3).made;
}

function firstKind(captured) {
  return function (argument) {
    return "first " + captured + " " + argument;
  };
}
function secondKind(captured) {
  return function (argument) {
    return "second " + captured + " " + argument;
  };
}
function thirdKind(captured) {
  return argument => "third " + captured + " " + argument;
}
function firstMaker(captured) {
  return function (argument) {
    this.made = "made first " + captured + " " + argument;
  };
}
function secondMaker(captured) {
  return function (argument) {
    this.made = "made second " + captured + " " + argument;
  };
}

function teach(round) {
  // Only this frame holds the closures.
  return [callIt(unknown(firstKind(round))), callMethod(unknown({ act: firstKind(round) })), construct(unknown(firstMaker(round)))].join(" | ");
}
////= fillStack

let wrong = 0;
////= check

for (let round = 0; round < 6; round++) {
  console.log(teach(round));
  console.log(teach(round));
  fillStack(50);
  Bun.gc(true);
  const kept = [];
  for (let i = 0; i < 3000; i++) {
    const kind = i % 3;
    const callee = kind === 0 ? secondKind(i) : kind === 1 ? thirdKind(i) : firstKind(i);
    const name = kind === 0 ? "second " : kind === 1 ? "third " : "first ";
    kept.push(callee);
    check(callIt(unknown(callee)), name + i + " 1");
    check(callMethod(unknown({ act: callee })), name + i + " 2");
    const maker = i % 2 ? secondMaker(i) : firstMaker(i);
    kept.push(maker);
    check(construct(unknown(maker)), (i % 2 ? "made second " : "made first ") + i + " 3");
  }
  console.log("round", round, "kept", kept.length, "wrong", wrong);
}

export {};
//// collections-run-inside-getters-setters-traps-and-conversions.ts
// The general way of a read, a store or a call runs code of the program: a getter, a setter, a trap, a conversion. That code drops objects, runs a full collection and makes new structures before it returns. What the operation holds on to survives, and what it remembers afterwards is true.
interface Sample {
  value: unknown;
  other: unknown;
  act?: () => unknown;
}

function churn(mark: string): void {
  const dropped: object[] = [];
  for (let i = 0; i < 50; i++) dropped.push({ ["churn " + mark + i]: i, value: "wrong", other: "wrong" });
  dropped.length = 0;
  Bun.gc(true);
  for (let i = 0; i < 50; i++) dropped.push({ ["after " + mark + i]: i, pad: 0, other: "wrong", value: "wrong" });
}
function fresh(text: string): { text: string } {
  return { text: text + "!" };
}

////= lines	valueOf	sample	Sample	unknown	sample.value
////= lines	otherOf	sample	Sample	unknown	sample.other
////= lines-2	setValue	sample	Sample	value	unknown	sample.value
function act(sample: Sample): unknown {
  return sample.act!();
}
function look(mark: string, make: () => Sample): void {
  const sample = make();
  const parts = [valueOf(sample), valueOf(sample), otherOf(sample)];
  setValue(sample, fresh("stored"));
  parts.push(valueOf(sample), otherOf(sample), sample.act ? act(sample) : "no act", valueOf(make()), otherOf(make()));
  console.log(mark + ":", JSON.stringify(parts));
}

let round = 0;

look("honest", () => ({ value: fresh("value"), other: fresh("other") }));
look("a getter collects", () => ({
  get value() {
    churn("g" + round++);
    return fresh("from the getter");
  },
  set value(_value: unknown) {},
  other: fresh("other"),
}));
look("a setter collects", () => {
  let held: unknown = fresh("held");
  return {
    get value() {
      return held;
    },
    set value(value: unknown) {
      churn("s" + round++);
