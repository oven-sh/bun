////: attempt-3
function attempt(run: () => unknown): string {
  try {
    const value = run();
    return typeof value === "object" ? JSON.stringify(value) : String(value);
  } catch (error) {
    return "throws " + (error as Error).constructor.name;
  }
}
////: attempt-4
function attempt(run: () => «1»): string {
  try {
    return show(run());
  } catch (error) {
    return "throws " + (error as Error).constructor.name;
  }
}
