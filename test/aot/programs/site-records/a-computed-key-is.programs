//// literals-with-spread.ts
// Object literals with spreads, in front of, between and behind named fields. What is spread has the declared fields, others, fewer, getters, hidden and symbol properties, index keys, an own `__proto__`, or is no object at all.
interface Point {
  x: number;
  y: number;
  label?: string;
}

const trail: string[] = [];
const mark = Symbol("mark");

function show(value: object): string {
  return JSON.stringify(value) + " [" + Reflect.ownKeys(value).map(String).join() + "] " + (Object.getPrototypeOf(value) === Object.prototype);
}
////= attempt-4	object

function withDefaults(point: Partial<Point>): Point {
  return { x: 0, y: 0, ...point };
}
function overridden(point: Point): Point {
  return { ...point, x: -1 };
}
function between(point: Point): object {
  return { before: "b", ...point, after: "a" };
}
function twice(point: Point): object {
  const again: Partial<Point> = point;
  return { ...point, y: 5, ...again };
}
function alone(point: Point): Point {
  return { ...point };
}
function nested(point: Point): object {
  return { outer: { ...point, inner: { ...point } }, list: [{ ...point }] };
}
function look(name: string, make: () => unknown): void {
  console.log(name + ":");
  console.log("  defaults:", attempt(() => withDefaults(make() as Point)), trail.splice(0).join(";"));
  console.log("  overridden:", attempt(() => overridden(make() as Point)), trail.splice(0).join(";"));
  console.log("  between:", attempt(() => between(make() as Point)), trail.splice(0).join(";"));
  console.log("  twice:", attempt(() => twice(make() as Point)), trail.splice(0).join(";"));
  console.log("  alone:", attempt(() => alone(make() as Point)), trail.splice(0).join(";"));
  console.log("  nested:", attempt(() => nested(make() as Point)), trail.splice(0).join(";"));
}

class PointClass {
  y = 2;
  x = 1;
  norm(): number {
    return this.x + this.y;
  }
  get computed(): number {
    return 3;
  }
}

look("expected", (): Point => ({ x: 1, y: 2 }));
look("expected with the optional field", (): Point => ({ x: 1, y: 2, label: "l" }));
look("class instance", () => new PointClass());
look("reordered and more", () => ({ z: 3, y: 2, label: undefined, x: 1 }));
look("fewer", () => ({ y: 2 }));
look("empty", () => ({}));
look("other kinds of values", () => ({ x: "x", y: null }));
look("getters", () => ({
  get x() {
    trail.push("get x");
    return 10;
  },
  get y() {
    trail.push("get y");
    return 20;
  },
}));
look("a getter that throws", () => ({
  x: 1,
  get y(): number {
    throw new RangeError("y");
  },
}));
look("a getter that deletes what follows", () => ({
  get x() {
    delete (this as any).y;
    return 1;
  },
  y: 2,
}));
look("hidden and symbol properties", () => Object.defineProperty({ x: 1, [mark]: "m", y: 2 }, "x", { enumerable: false }));
look("index keys", () => ({ x: 1, 2: "two", y: 2, 0: "zero" }));
look("an own __proto__", () => JSON.parse('{"x":1,"__proto__":{"y":"inherited?"}}'));
look("inherited fields", () => Object.create({ x: 1, y: 2 }));
look("parsed", () => JSON.parse('{"label":"p","y":2,"x":1}'));
look("array", () => [7, 8]);
look("text", () => "ab");
look("number", () => 5);
look("null", () => null);
look("undefined", () => undefined);
look("proxy", () =>
  new Proxy(
    { x: 1, y: 2 },
    {
      ownKeys(target) {
        trail.push("keys");
        return Reflect.ownKeys(target).reverse();
      },
      getOwnPropertyDescriptor(target, key) {
        trail.push("describe " + String(key));
        return Reflect.getOwnPropertyDescriptor(target, key);
      },
      get(target, key) {
        trail.push("get " + String(key));
        return Reflect.get(target, key);
      },
    },
  ),
);
look("expected", (): Point => ({ x: 1, y: 2 }));

export {};
//// look-alikes-arrive-at-a-method-call.ts
// A method call that expects instances of one class gets other classes, literals, parsed objects, functions, primitives, null. The method is looked up before the arguments run, `this` is the receiver, and what cannot be called throws after the arguments ran.
class Task {
  label = "task";
  run(first: number, second: number): string {
    return this.label + "(" + first + "," + second + ")";
  }
  toString(): string {
    return "Task " + this.label;
  }
}
class OtherTask {
  extra = 0;
  label = "other";
  run(first: number): string {
    return this.label + "<" + first + "," + arguments.length + ">";
  }
}
class StaticTask {
  static label = "static";
  static run(...all: number[]): string {
    return this.label + "[" + all.join() + "]";
  }
}

const trail: string[] = [];

////= attempt
////= noted-2	"argument "
function runIt(task: Task): string {
  return task.run(noted(1), noted(2));
}
////= lines-3	textOf	task	Task	string	task.toString
function look(mark: string, value: unknown): void {
  const task = value as Task;
  console.log(mark + ":", attempt(() => runIt(task)), "|", attempt(() => runIt(task)), "|", attempt(() => textOf(task)), "|", trail.splice(0).join(";"));
}

function plainFunction() {}
plainFunction.run = function (this: unknown, first: number, second: number) {
  return (this === plainFunction) + " " + (first + second);
};
plainFunction.toString = () => "a function with members";

look("expected", new Task());
look("another class", new OtherTask());
look("another class", new OtherTask());
look("expected", new Task());
look("a class with static members", Object.assign(StaticTask, { toString: () => "StaticTask" }));
look("a literal with a method", {
  label: "literal",
  run(this: { label: string }, first: number, second: number) {
    return this.label + "{" + first * second + "}";
  },
});
look("a literal with an arrow", { run: (first: number) => "arrow " + first });
look("a literal that borrows the method", { label: "borrower", run: Task.prototype.run });
look("a function", plainFunction);
look("an heir of an instance", Object.create(new Task(), { label: { value: "heir" } }));
look("no method", { label: "no method" });
look("parsed", JSON.parse('{"label":"parsed","run":5}'));
look("no prototype", Object.create(null));
look("expected", new Task());
look("null", null);
look("undefined", undefined);
look("a number", 5);
look("a text", "text");
look("a symbol", Symbol("s"));
look("a bigint", 5n);
look("true", true);
look("an array", [1, 2]);
look("expected", new Task());

export {};
//// look-alikes-made-by-native-code-arrive-at-a-read.ts
// Objects that native code made have the fields a read expects, as own properties in any order, further up their chain, or as special properties of their kind.
interface Named {
  name: string;
  length: number;
  message: string;
}

////= lines	nameOf	value	Named	unknown	value.name
////= lines	lengthOf	value	Named	unknown	value.length
////= lines	messageOf	value	Named	unknown	value.message
function look(mark: string, value: unknown): void {
  const named = value as Named;
  console.log(mark + ":", JSON.stringify([nameOf(named), lengthOf(named), messageOf(named)]), JSON.stringify([nameOf(named), lengthOf(named), messageOf(named)]));
}

class Listing extends Array<number> {
  name = "listing";
  message = "of numbers";
}
function declared(first: number, second: number): number {
  return first + second;
}

const honest: Named = { name: "honest", length: 1, message: "made here" };
const bare = Object.assign(Object.create(null), { message: "bare", name: "no prototype", length: -1 });
const heir = Object.create({ name: "inherited", length: 10 }, { message: { value: "own, hidden", enumerable: false } });
const failure = new RangeError("out of range");
const ownNameFailure = Object.assign(new TypeError("typed"), { name: "Renamed", length: 0.5 });

look("honest", honest);
look("parsed", JSON.parse('{"message":"m","length":2,"name":"parsed"}'));
look("parsed, other order", JSON.parse('{"length":3,"name":"parsed again","extra":null,"message":"n"}'));
look("honest", honest);
look("from entries", Object.fromEntries([["name", "entries"], ["message", 5], ["length", "six"]]));
look("cloned", structuredClone(honest));
look("no prototype", bare);
look("heir", heir);
look("error", failure);
look("error with own name", ownNameFailure);
look("function", declared);
look("arrow", (only: number) => only);
look("bound", declared.bind(null, 1));
look("class", Listing);
look("array", [1, 2, 3]);
look("array below a class", Listing.from([4, 5]));
look("array with properties", Object.assign([9], { name: "array", message: "with properties" }));
look("map with properties", Object.assign(new Map(), { name: "map", length: 4, message: "with properties" }));
look("typed array", new Uint8Array(7));
look("string object", new String("boxed"));
look("regular expression", Object.assign(/x/g, { name: "pattern" }));
look("honest", honest);

export {};
