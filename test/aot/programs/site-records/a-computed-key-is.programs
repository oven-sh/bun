////: look
function look(mark«1» {
  console.log(
    mark + ":",
    valueOf(setting),
    valueOf(setting),
    attempt(() => setValue(setting, 2)),
    valueOf(setting),
    String(noteOf(setting)),
    attempt(() => setNote(setting, "noted")),
    String(noteOf(setting)),
    attempt(() => remove(setting)),
    String(valueOf(setting)),
    JSON.stringify(setting),
  );
}
////: noted
function noted<T>(value: T, name: string): T {
  trail.push(name);
  return value;
}
//// a-computed-key-is-converted-before-its-value-is-evaluated.ts
// `{ [key]: value }`: ECMAScript converts the key to a property key before it evaluates the value. Plain Bun evaluates the value first, so this program has an .expected.txt.
const trail: string[] = [];
const mark = Symbol("mark");

////= noted
function keyBetween(key: any): object {
  return { a: noted(1, "a"), [noted(key, "key")]: noted("computed", "value"), b: noted(2, "b") };
}
function look(name: string, key: unknown): void {
  let answer: string;
  try {
    answer = Reflect.ownKeys(keyBetween(key)).map(String).join();
  } catch (error) {
    answer = "throws " + (error as Error).constructor.name;
  }
  console.log(name + ":", answer, "|", trail.splice(0).join(";"));
}

for (let round = 0; round < 3; round++) {
  look("a text", "c");
  look("an object that converts", {
    toString() {
      trail.push("converted");
      return "a";
    },
  });
  look("an object that converts by a symbol", {
    [Symbol.toPrimitive](hint: string) {
      trail.push("hint " + hint);
      return mark;
    },
  });
  look("an object that throws", {
    toString() {
      throw new RangeError("no key");
    },
  });
  look("an object that cannot be converted", Object.create(null));
}
//// a-field-is-deleted-and-added-again.ts
// A field is deleted and added again, once and several times, the first, a middle and the last one. Reads, stores, `in` and the order of the keys follow.
class Record3 {
  first = "first";
  middle = 2;
  last = true;
}

////= lines	firstOf	value	Record3	unknown	value.first
////= lines	middleOf	value	Record3	unknown	value.middle
////= lines	lastOf	value	Record3	unknown	value.last
////= lines-2	setMiddle	value	Record3	to	number	value.middle
function hasMiddle(value: Record3): boolean {
  return "middle" in value;
}
function state(mark: string, value: Record3): void {
  console.log(mark + ":", String(firstOf(value)), String(middleOf(value)), String(lastOf(value)), hasMiddle(value), Object.keys(value).join(), JSON.stringify(value));
}

const untouched = new Record3();
const changed = new Record3();
const open = changed as any;

state("at first", changed);
delete open.middle;
state("middle deleted", changed);
state("another one", untouched);
setMiddle(changed, 20);
state("middle stored again", changed);
delete open.middle;
open.extra = "extra";
state("deleted, another added", changed);
setMiddle(changed, 21);
state("middle after the other", changed);
delete open.first;
state("first deleted", changed);
open.first = "first again";
state("first again", changed);
delete open.last;
delete open.extra;
state("last and extra deleted", changed);
open.last = false;
state("last again", changed);
delete open.first;
delete open.middle;
delete open.last;
state("empty", changed);
open.first = "f";
open.middle = 3;
open.last = true;
state("filled in the old order", changed);
state("another one", untouched);

const literal = { first: "literal", middle: 5, last: false };
state("literal", literal);
delete (literal as any).last;
state("literal without last", literal);
literal.last = true;
state("literal with last", literal);
delete (literal as any).first;
literal.first = "back";
state("literal, first moved behind", literal);
setMiddle(literal, 6.5);
state("literal, a fraction", literal);

export {};
//// a-method-is-replaced-on-the-instance.ts
// A method call expects the method of the class. One instance gets a property of its own under that name: a closure, a bound function, a method of another class, a getter, something that cannot be called. Other instances go on as before.
class Greeter {
  name = "greeter";
  greet(to: string): string {
    return this.name + " greets " + to;
  }
  twice(to: string): string {
    return this.greet(to) + " and " + this.greet(to);
  }
}
class Stranger {
  name = "stranger";
  greet(to: string): string {
    return this.name + " ignores " + to;
  }
}

////= attempt
////= lines-15	greet	greeter	Greeter	string	greeter.greet	"you"
////= lines-15	greetTwice	greeter	Greeter	string	greeter.twice	"them"
function look(mark: string, greeter: Greeter): void {
  console.log(mark + ":", attempt(() => greet(greeter)), "|", attempt(() => greetTwice(greeter)), "|", attempt(() => greet(untouched)));
}

const untouched = new Greeter();
const changed = new Greeter();
const open = changed as any;
let reads = 0;

look("at first", changed);
open.greet = function (this: Greeter, to: string) {
  return this.name + " has its own way with " + to;
};
look("a function of its own", changed);
open.greet = (to: string) => "an arrow for " + to;
look("an arrow", changed);
open.greet = Stranger.prototype.greet;
look("the method of another class", changed);
open.greet = Stranger.prototype.greet.bind(new Stranger());
look("bound to another object", changed);
open.greet = Greeter.prototype.greet;
look("the same method, as its own property", changed);
Object.defineProperty(changed, "greet", {
  get() {
    reads++;
    return (to: string) => "read " + reads + " for " + to;
  },
  configurable: true,
});
look("a getter", changed);
Object.defineProperty(changed, "greet", { value: undefined, writable: true, configurable: true });
look("undefined", changed);
open.greet = null;
look("null", changed);
open.greet = 5;
look("a number", changed);
open.greet = {};
look("an object", changed);
open.greet = class {
  constructor() {}
};
look("a class", changed);
open.greet = new Proxy(Greeter.prototype.greet, {
  apply(target, self, list) {
    return "trapped: " + Reflect.apply(target, self, list);
  },
});
look("a proxy", changed);
open.greet = String.prototype.toUpperCase;
look("a native function", changed);
delete open.greet;
look("deleted", changed);

