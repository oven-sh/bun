// In sloppy code a store that a frozen, sealed or non-extensible object refuses does nothing and throws nothing. Each object is read before it is stored to.
function Setting() {
  this.key = "key";
  this.value = 1;
}

////= attempt-2
////= lines-6	valueOf	setting	setting.value
////= lines-12	setValue	setting	value	setting.value
////= lines-6	noteOf	setting	setting.note
////= lines-12	setNote	setting	note	setting.note
function remove(setting) {
  return delete setting.value;
}
