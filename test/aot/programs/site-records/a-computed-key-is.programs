//// another-layout-arrives-at-a-store.ts
// A store that expects one layout gets objects whose field stands in another slot or is kept in another form. Only that field changes: every neighbor keeps its value.
class Expected {
  a = 1;
  b = 2;
  c = 3;
}
class Shifted {
  before = "before";
  a = 10;
  between = "between";
  b = 20;
  c = 30;
  after = "after";
}
class Backward {
  c = 300;
  b = 200;
  a = 100;
}
class Fractions {
  a = 0.5;
  b = 1.5;
  c = 2.5;
}
class Texts {
  a = "a";
  b = "b";
  c = "c";
}
class Flags {
  a = true;
  b = false;
  c = true;
}
class References {
  a: object | null = { in: "a" };
  b: object | null = null;
  c: object | null = [3];
}
////= lines-17	Narrow	b	2000

////= lines-2	setA	value	Expected	to	number	value.a
////= lines-2	setB	value	Expected	to	number	value.b
////= lines-2	setC	value	Expected	to	number	value.c
function look(mark: string, value: unknown): void {
  const expected = value as Expected;
  const before = JSON.stringify(value);
  setB(expected, -2);
  const afterB = JSON.stringify(value);
  setA(expected, -1.5);
  setC(expected, 2 ** 40);
  console.log(mark + ":", before, afterB, JSON.stringify(value));
}

look("expected", new Expected());
look("shifted", new Shifted());
look("shifted", new Shifted());
look("backward", new Backward());
look("shifted", new Shifted());
look("expected", new Expected());
look("fractions", new Fractions());
look("texts", new Texts());
look("flags", new Flags());
look("references", new References());
look("narrow", new Narrow());
look("texts", new Texts());
look("parsed", JSON.parse('{"c":"c","x":"x","b":"b","y":"y","a":"a","z":"z"}'));
look("parsed", JSON.parse('{"c":"c","x":"x","b":"b","y":"y","a":"a","z":"z"}'));
look("parsed, shorter", JSON.parse('{"b":0}'));
look("literal", { x: 0, a: 1, b: 2, c: 3 });
look("array", Object.assign([7, 8], { b: "of an array" }));
look("expected", new Expected());

const kept = [new Expected(), new Shifted(), new Backward(), new Fractions(), new Texts()];
setA(kept[0] as Expected, 5);
setA(kept[1] as Expected, 5);
setA(kept[2] as Expected, 5);
setA(kept[3] as Expected, 5);
setA(kept[4] as any, 5);
setA(kept[3] as Expected, 6);
setA(kept[1] as Expected, 6);
setA(kept[4] as any, 6);
setA(kept[0] as Expected, 6);
setA(kept[2] as Expected, 6);
console.log(JSON.stringify(kept));

export {};
//// another-layout-with-the-same-field-arrives-at-a-read.ts
// A read that expects one layout gets objects of other layouts: the field stands in another slot, is kept in another form, or is missing.
interface Options {
  name: string;
  retries: number;
  verbose: boolean;
  tag: string;
}

class Plain {
  name = "plain";
  retries = 1;
  verbose = false;
  tag = "p";
}
class Reordered {
  tag = "r";
  verbose = true;
  retries = 2.5;
  name = "reordered";
}
class Wider {
  before = 0.5;
  name = "wider";
  between = [1];
  retries = 3;
  verbose = false;
  after: null | string = null;
  tag = "w";
}
class OtherKinds {
  name: unknown = 7;
  retries: unknown = "four";
  verbose: unknown = null;
  tag: unknown = { inner: "t" };
}
////= lines-17	Fewer	name	"fewer"

function describe(options: Options): string {
  const name = options.name;
  const retries = options.retries;
  const verbose = options.verbose;
  const tag = options.tag;
  return typeof name + " " + String(name) + " | " + typeof retries + " " + String(retries) + " | " + typeof verbose + " " + String(verbose) + " | " + typeof tag + " " + JSON.stringify(tag);
}

const literal: Options = { name: "literal", retries: 0, verbose: true, tag: "l" };
const reordered = new Reordered();
const wider = new Wider();
const otherKinds = new OtherKinds() as any;
const fewer = new Fewer() as any;

console.log("expected:", describe(literal));
console.log("plain:", describe(new Plain()));
console.log("reordered:", describe(reordered));
console.log("reordered again:", describe(reordered));
console.log("wider:", describe(wider));
console.log("reordered after wider:", describe(reordered));
console.log("expected again:", describe(literal));
console.log("other kinds:", describe(otherKinds));
console.log("other kinds again:", describe(otherKinds));
console.log("fewer:", describe(fewer));
console.log("fewer again:", describe(fewer));
console.log("wider after fewer:", describe(wider));
console.log("expected at last:", describe(literal));

