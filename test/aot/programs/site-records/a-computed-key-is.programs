//// calls-with-254-to-300-arguments.js
// Calls, method calls, constructions and calls by value with 254, 255, 256, 257 and 300 arguments: around and beyond what one byte can count. Every argument arrives, in its place.
function summarize() {
  let sum = 0;
  for (let i = 0; i < arguments.length; i++) sum += arguments[i] * (i % 7 + 1);
  return arguments.length + " " + sum + " " + arguments[0] + " " + arguments[arguments.length - 1];
}
function summarizeRest(first, ...rest) {
  let sum = first;
  for (let i = 0; i < rest.length; i++) sum += rest[i] * ((i + 1) % 7 + 1);
  return rest.length + 1 + " " + sum + " " + first + " " + rest[rest.length - 1];
}
class Receiver {
  constructor() {
    this.made = summarize.apply(null, arguments);
  }
  method() {
    return "method " + summarize.apply(null, arguments) + " " + (this instanceof Receiver);
  }
}
const other = {
  method(...all) {
    return "other " + summarize(...all);
  },
};

