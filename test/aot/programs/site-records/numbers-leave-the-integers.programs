// Two reads of one field of one layout share what they expect and what they learn, and so do two stores. Each of them keeps getting a layout of its own.
////= lines-4	Expected	id	1	label	"expected"
////= lines-4	Left	label	"left"	id	2
class Right {
  extra = "x";
  other = 0.25;
  label = "right";
  id = 3;
}

////= lines	labelHere	value	Expected	string	value.label
////= lines	labelThere	value	Expected	string	value.label
