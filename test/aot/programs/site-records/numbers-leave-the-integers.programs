//// stores-to-primitives-null-and-undefined-in-sloppy-code.cjs
// In sloppy code a store to a primitive value does nothing and throws nothing; a store to null or undefined throws. The right side runs first.
function Target() {
  this.field = 1;
}

var trail = [];

////= attempt-2
function noted(value) {
  trail.push("right side " + value);
  return value;
}
function store(target) {
  target.field = noted(2);
}
function create(target) {
  target.extra = noted(3);
}
function update(target) {
  return (target.field += noted(4));
}
function increment(target) {
  return target.field++;
}
function storeLength(target) {
  target.length = noted(0);
}
function look(mark, target) {
  console.log(mark + ":", attempt(() => store(target)), attempt(() => create(target)), attempt(() => update(target)), attempt(() => increment(target)), attempt(() => storeLength(target)), trail.splice(0).join(";"));
}

look("null first", null);
look("honest", new Target());
look("undefined", undefined);
look("zero", 0);
look("fraction", 0.5);
look("not a number", NaN);
look("true", true);
look("false", false);
look("honest", new Target());
look("empty text", "");
look("text", "text");
look("joined text", ["a", "b"].join("-") + "c".repeat(30));
look("symbol", Symbol("s"));
look("bigint", 5n);
look("large bigint", 2n ** 100n);
look("null", null);
look("honest", new Target());
console.log((5).field, "text".extra, "text".length);
//// stores-to-primitives-null-and-undefined-in-strict-code.ts
// A store that expects an object gets null, undefined and primitive values. The right side runs first, then the store throws, or finds a setter on the wrapper's prototype chain. Nothing is created anywhere.
class Target {
  field = 1;
  declare extra?: number;
}

const trail: string[] = [];

////= attempt
////= noted-2	"right side "
function store(target: Target): void {
  target.field = noted(2);
}
function create(target: Target): void {
  target.extra = noted(3);
}
function update(target: Target): number {
  return (target.field += noted(4));
}
function increment(target: Target): number {
  return target.field++;
}
function storeLength(target: { length: number }): void {
  target.length = noted(0);
}
function look(mark: string, value: unknown): void {
  const target = value as Target;
  console.log(mark + ":", attempt(() => store(target)), attempt(() => create(target)), attempt(() => update(target)), attempt(() => increment(target)), attempt(() => storeLength(value as { length: number })), trail.splice(0).join(";"));
}

look("null first", null);
look("honest", new Target());
look("undefined", undefined);
look("zero", 0);
look("fraction", 0.5);
look("not a number", NaN);
look("true", true);
look("false", false);
look("honest", new Target());
look("empty text", "");
look("text", "text");
look("joined text", ["a", "b"].join("-") + "c".repeat(30));
look("symbol", Symbol("s"));
look("bigint", 5n);
look("large bigint", 2n ** 100n);
look("null", null);
look("honest", new Target());
console.log((5 as any).field, ("text" as any).extra, "text".length);

export {};
//// structures-die-and-their-ids-come-back-at-a-method-call.js
// A method call learns the structure of a receiver and the method found for it, on the receiver or on its prototype. Receiver, prototype and method die. New receivers, whose structures get the old ids, have other methods.
const unknown = value => new CustomEvent("unknown", { detail: value }).detail; // what native code hands back is unknown to the compiler

class Expected {
  act(argument) {
    return "expected " + argument;
  }
}

function act(receiver) {
  return receiver.act(1);
}
function actTwice(receiver) {
  return receiver.act(2) + "/" + receiver.act(3);
}

function teach(round) {
  const own = {};
  own["only in round " + round] = 0;
  own.act = argument => "own of round " + round + " " + argument;
  const prototype = {};
  prototype["prototype of round " + round] = 0;
  prototype.act = function (argument) {
    return "inherited in round " + round + " " + argument + " " + this.id;
  };
  const heir = Object.create(prototype);
  heir.id = "heir";
  const ShortLived = class {
    act(argument) {
      return "class of round " + round + " " + argument;
    }
  };
  return [act(unknown(own)), act(unknown(own)), act(unknown(heir)), actTwice(unknown(heir)), act(unknown(new ShortLived())), actTwice(unknown(new ShortLived()))].join(" | ");
}
////= fillStack

let wrong = 0;
////= check

function successor(round, index) {
  const name = "successor " + round + " " + index;
  switch (index % 4) {
    case 0: {
      const value = {};
      value[name] = 0;
      value.act = argument => name + " own " + argument;
      return [value, name + " own "];
    }
    case 1: {
      const prototype = {};
      prototype[name] = 0;
      prototype.pad = 0;
      prototype.act = argument => name + " inherited " + argument;
      const value = Object.create(prototype);
      value.id = index;
      return [value, name + " inherited "];
    }
    case 2: {
      const value = new (class {
        act(argument) {
          return name + " class " + argument;
        }
      })();
      return [value, name + " class "];
    }
    default: {
      const value = Object.create(Expected.prototype);
      value[name] = 0;
      return [value, "expected "];
    }
  }
}

for (let round = 0; round < 8; round++) {
  console.log(act(new Expected()), "|", teach(round));
  fillStack(50);
  Bun.gc(true);
  const kept = [];
  for (let index = 0; index < 600; index++) {
    const [value, prefix] = successor(round, index);
    kept.push(value);
    check(act(unknown(value)), prefix + 1);
    check(actTwice(unknown(value)), prefix + 2 + "/" + prefix + 3);
  }
  console.log("round", round, "kept", kept.length, "wrong", wrong, act(new Expected()));
}

export {};
//// structures-die-and-their-ids-come-back-at-a-read.js
// A read learns where an ordinary object keeps the field. All objects of that structure die, a collection frees the structure, and hundreds of new structures are made, one of which gets the old one's id. In them the field stands elsewhere, is an accessor, or is missing.
const unknown = value => new CustomEvent("unknown", { detail: value }).detail; // what native code hands back is unknown to the compiler

class Expected {
  constructor() {
    this.name = "expected";
    this.size = 1;
  }
}

////= lines-6	nameOf	value	value.name
////= lines-6	sizeOf	value	value.size
function hasName(value) {
  return "name" in value;
}

function shortLived(round) {
  // The key that depends on the round gives each round a structure of its own.
  const value = {};
  value["only in round " + round] = 0;
  value.pad = 1;
  value.name = "short-lived " + round;
  value.size = round;
  return value;
}
function teach(round) {
  const value = unknown(shortLived(round));
  return [nameOf(value), nameOf(value), sizeOf(value), sizeOf(value), hasName(value)].join();
}
////= fillStack

let wrong = 0;
function check(actual, expected, what) {
  if (actual !== expected) {
    wrong++;
    if (wrong < 10) console.log("WRONG:", what, String(actual), "instead of", String(expected));
  }
}

function successor(round, index) {
  const value = {};
  value["successor " + round + " " + index] = "not the name";
  switch (index % 6) {
    case 0:
      value.name = "name " + index;
      value.size = index;
      return [value, "name " + index, index];
    case 1:
      value.size = index;
      value.a = "not the name either";
      value.b = "nor this";
      value.name = "name " + index;
      return [value, "name " + index, index];
    case 2:
      value.a = "a";
      value.b = "b";
      value.c = "c";
      return [value, undefined, undefined];
    case 3:
      value.pad = "pad";
      Object.defineProperty(value, "name", { get: () => "getter " + index, enumerable: true, configurable: true });
      value.size = index;
      return [value, "getter " + index, index];
    case 4:
      value.pad = 1;
      value.size = "size first";
      value.name = index;
      return [value, index, "size first"];
    default:
      value.pad = 1;
      value.name = 0.5 + index;
      return [Object.freeze(value), 0.5 + index, undefined];
  }
}

for (let round = 0; round < 8; round++) {
  console.log(nameOf(new Expected()), teach(round));
  fillStack(50);
  Bun.gc(true);
  const kept = [];
  for (let index = 0; index < 600; index++) {
    const [value, name, size] = successor(round, index);
    kept.push(value);
    const hidden = unknown(value);
    check(nameOf(hidden), name, "name");
    check(sizeOf(hidden), size, "size");
    check(hasName(hidden), name !== undefined, "has");
  }
  console.log("round", round, "kept", kept.length, "wrong", wrong, nameOf(new Expected()), sizeOf(new Expected()));
}

export {};
//// structures-die-and-their-ids-come-back-at-a-store.js
// A store learns where an ordinary object keeps the field, or which structure the object gets when the store creates the field. Those structures die, and new ones get their ids. A store by the old knowledge would overwrite a neighbor, write past the object, or give it a dead structure.
const unknown = value => new CustomEvent("unknown", { detail: value }).detail; // what native code hands back is unknown to the compiler

class Expected {
  constructor() {
    this.level = 1;
  }
}

////= lines-12	setLevel	value	level	value.level
////= lines-12	setExtra	value	extra	value.extra

function teach(round) {
  const replaces = {};
  replaces["only in round " + round] = 0;
  replaces.pad = "pad";
  replaces.level = "old";
  const creates = {};
  creates["created in round " + round] = 0;
  setLevel(unknown(replaces), "replaced");
  setLevel(unknown(replaces), "replaced twice");
  setLevel(unknown(creates), "created");
  setExtra(unknown(creates), "extra");
  const createsAgain = {};
  createsAgain["created in round " + round] = 0;
  setLevel(unknown(createsAgain), "created again");
  setExtra(unknown(createsAgain), "extra again");
  return JSON.stringify([replaces, creates, createsAgain]);
}
////= fillStack

let wrong = 0;
////= check

function successor(round, index) {
  const first = "successor " + round + " " + index;
  const value = {};
  value[first] = "first";
  const stored = "L" + index;
  switch (index % 6) {
    case 0:
      value.level = "old";
      value.after = "after";
      return [value, { [first]: "first", level: stored, after: "after", extra: index }];
    case 1:
      value.a = "a";
      value.b = "b";
      value.c = "c";
      value.level = "old";
      return [value, { [first]: "first", a: "a", b: "b", c: "c", level: stored, extra: index }];
    case 2:
      return [value, { [first]: "first", level: stored, extra: index }];
    case 3:
      value.pad = "pad";
      value.other = "other";
      return [value, { [first]: "first", pad: "pad", other: "other", level: stored, extra: index }];
    case 4:
      value.extra = "old extra";
      value.pad = "pad";
      return [value, { [first]: "first", extra: index, pad: "pad", level: stored }];
    default:
      value.pad = "pad";
      value.level = "old";
      return [value, { [first]: "first", pad: "pad", level: stored, extra: index }];
  }
}

for (let round = 0; round < 8; round++) {
  const honest = new Expected();
  setLevel(honest, round);
  console.log(JSON.stringify(honest), teach(round));
  fillStack(50);
  Bun.gc(true);
  const kept = [];
  for (let index = 0; index < 600; index++) {
    const [value, expected] = successor(round, index);
    kept.push(value);
    setLevel(unknown(value), "L" + index);
    setExtra(unknown(value), index);
    check(JSON.stringify(value), JSON.stringify(expected));
  }
  Bun.gc(true);
  let length = 0;
  for (const value of kept) length += JSON.stringify(value).length;
  console.log("round", round, "kept", kept.length, "wrong", wrong, "length", length);
}

export {};
//// subclasses-arrive-where-the-base-is-expected.ts
// Instances of subclasses arrive where reads, stores and method calls expect the base class: with more fields, with the field declared again, with an accessor or a method under the field's name.
const stores: string[] = [];

class Shape {
  name = "shape";
  sides = 0;
  area(): number {
    return this.sides;
  }
  describe(): string {
    return this.name + " " + this.sides + " " + this.area();
  }
}
class Square extends Shape {
  edge = 2;
  name = "square";
  sides = 4;
  area(): number {
    return this.edge * this.edge;
  }
}
class Tall extends Square {
  height = 3;
  area(): number {
    return super.area() * this.height;
  }
}
class Quiet extends Shape {}
class Computed extends Shape {
  constructor() {
    super();
    delete (this as any).sides;
    delete (this as any).name;
  }
}
Object.defineProperty(Computed.prototype, "sides", {
  get() {
    return 99;
  },
  set(value: number) {
    stores.push("sides=" + value);
  },
  configurable: true,
});
Object.defineProperty(Computed.prototype, "name", {
  get() {
    return "computed";
  },
  configurable: true,
});
class EarlyReader extends Shape {
  seen: string;
  late = "late";
  constructor() {
    super();
    this.seen = nameOf(this) + "/" + sidesOf(this);
  }
}
class FromFunction extends (function (this: any) {
  this.name = "from a function";
  this.sides = -1;
} as unknown as new () => { name: string; sides: number }) {
  area(): number {
    return 0.5;
  }
  describe(): string {
    return "described below a function";
  }
}

////= attempt
////= lines	nameOf	shape	Shape	string	shape.name
////= lines	sidesOf	shape	Shape	number	shape.sides
////= lines-2	setSides	shape	Shape	sides	number	shape.sides
////= lines-3	areaOf	shape	Shape	number	shape.area
////= lines-3	describe	shape	Shape	string	shape.describe
function look(mark: string, shape: Shape): void {
  const before = [attempt(() => nameOf(shape)), attempt(() => sidesOf(shape)), attempt(() => areaOf(shape)), "[" + attempt(() => describe(shape)) + "]"].join(" ");
  const stored = attempt(() => setSides(shape, sidesOf(shape) + 1));
  console.log(mark + ":", before, stored, "->", attempt(() => sidesOf(shape)), attempt(() => areaOf(shape)), Object.keys(shape).join(), shape instanceof Shape, stores.splice(0).join());
}

look("base", new Shape());
look("square", new Square());
look("base", new Shape());
look("tall", new Tall());
look("square", new Square());
look("quiet", new Quiet());
look("computed", new Computed());
look("computed", new Computed());
look("early reader", new EarlyReader());
console.log(new EarlyReader().seen);
look("below a function", new FromFunction());
look("tall", new Tall());
look("base", new Shape());

const borrowed = Object.create(new Square());
look("below an instance", borrowed);
look("below an instance, after the store", borrowed);

const constructedFor = Reflect.construct(Shape, [], Tall);
look("the base constructed for a subclass", constructedFor);
const constructedForFunction = Reflect.construct(Square, [], function () {});
look("a subclass constructed for a function", constructedForFunction);

export {};
//// super-calls-after-the-chain-changes.ts
// `super.method()` starts at the prototype of the object that the method was defined in, at the moment of the call. That prototype's method is replaced, deleted, becomes a getter, and the chain is hung elsewhere. `super()` calls whatever the class hangs below.
class Bottom {
  tag = "bottom";
  name(): string {
    return "Bottom.name of " + this.tag;
  }
  static make(): string {
    return "Bottom.make";
  }
}
class Middle extends Bottom {
  name(): string {
    return "Middle.name > " + super.name();
  }
  static make(): string {
    return "Middle.make > " + super.make();
  }
}
class Top extends Middle {
  tag = "top";
  name(): string {
    return "Top.name > " + super.name();
  }
  viaArrow(): string {
    return (() => super.name())();
  }
  static make(): string {
    return "Top.make > " + super.make();
  }
}
class Elsewhere {
  name(): string {
    return "Elsewhere.name of " + (this as any).tag;
  }
  static make(): string {
    return "Elsewhere.make";
  }
}

////= attempt

const top = new Top();
const originalMiddle = Middle.prototype.name;
const borrowed = { tag: "borrower", name: Top.prototype.name };

function look(mark: string): void {
  console.log(mark + ":", attempt(() => top.name()), "|", attempt(() => top.viaArrow()), "|", attempt(() => borrowed.name()), "|", attempt(() => Top.make()));
}

look("at first");
look("again");
Middle.prototype.name = function (this: Bottom) {
  return "replaced Middle.name of " + this.tag;
};
look("Middle.name replaced");
delete (Middle.prototype as any).name;
look("Middle.name deleted");
Object.defineProperty(Middle.prototype, "name", { get: () => () => "from a getter", configurable: true });
look("Middle.name is a getter");
Object.defineProperty(Middle.prototype, "name", { value: 5, writable: true, configurable: true });
look("Middle.name is a number");
Middle.prototype.name = originalMiddle;
look("the original");
Object.setPrototypeOf(Top.prototype, Elsewhere.prototype);
look("Top.prototype hangs elsewhere");
Object.setPrototypeOf(Top.prototype, Middle.prototype);
Object.setPrototypeOf(Middle.prototype, Elsewhere.prototype);
look("Middle.prototype hangs elsewhere");
Object.setPrototypeOf(Middle.prototype, null);
look("Middle.prototype hangs nowhere");
Object.setPrototypeOf(Middle.prototype, Bottom.prototype);
look("as at first");
Object.setPrototypeOf(Top, Elsewhere);
look("Top hangs below Elsewhere");
console.log("constructed:", attempt(() => JSON.stringify(new Top())), attempt(() => new Top() instanceof Middle), attempt(() => new Top().name()));
Object.setPrototypeOf(Top, Middle);
(Middle as any).make = () => "replaced Middle.make";
look("Middle.make replaced");
delete (Middle as any).make;
look("Middle.make deleted");

function Plain(this: any) {
  this.tag = "made by a function";
  this.more = true;
}
Object.setPrototypeOf(Top, Plain);
console.log("below a function:", attempt(() => JSON.stringify(new Top())), attempt(() => new Top().name()));
Object.setPrototypeOf(Top, null);
console.log("below nothing:", attempt(() => new Top()));
Object.setPrototypeOf(Top, Middle);
console.log("as at first:", attempt(() => JSON.stringify(new Top())), attempt(() => new Top().name()));

