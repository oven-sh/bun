//// this-of-a-method-call-on-a-primitive-in-sloppy-code.cjs
// In sloppy code a method that is called on a primitive value sees a wrapper object as `this`, and a function called by value sees the global object. In strict functions of the same file `this` is the value itself.
function kindOfThis() {
  return typeof this + " " + (this === globalThis ? "global" : Object.prototype.toString.call(this));
}
function strictKindOfThis() {
  "use strict";
  return typeof this + " " + String(typeof this === "symbol" ? "symbol" : this);
}
function Holder() {
  this.sloppy = kindOfThis;
  this.strict = strictKindOfThis;
}

////= attempt-2
////= lines-19	callSloppy	holder	holder.sloppy
////= lines-19	callStrict	holder	holder.strict
function callByValue(callee) {
  return callee();
}
function look(mark, holder) {
  console.log(mark + ":", attempt(() => callSloppy(holder)), "|", attempt(() => callStrict(holder)));
}

// String.prototype takes new names under --aot too.
String.prototype.sloppy = kindOfThis;
String.prototype.strict = strictKindOfThis;

look("holder", new Holder());
look("literal", { sloppy: kindOfThis, strict: strictKindOfThis });
look("text", "text");
look("empty text", "");
look("joined text", ["a", "b"].join("-") + "c".repeat(30));
look("holder", new Holder());
look("string object", new String("boxed"));
look("text", "text");
look("number", 5);
look("null", null);
look("undefined", undefined);
console.log(callByValue(kindOfThis), "|", callByValue(strictKindOfThis), "|", callByValue(new Holder().sloppy), "|", callByValue(new Holder().strict), "|", callByValue("text".sloppy), "|", callByValue("text".strict));
console.log(kindOfThis.call(5), "|", strictKindOfThis.call(5), "|", kindOfThis.call(null), "|", strictKindOfThis.call(null), "|", kindOfThis.apply(undefined), "|", kindOfThis.call("text"), "|", kindOfThis.call(true), "|", kindOfThis.call(5n), "|", kindOfThis.call(Symbol("s")));
delete String.prototype.sloppy;
delete String.prototype.strict;
look("text, after the names are gone", "text");
//// two-call-sites-share-what-they-expect-and-see-different-callees.ts
// Two calls of one method name with one argument count on one class share what they expect and what they learn. Each keeps getting receivers of its own, whose methods differ.
class Handler {
  id = "handler";
  handle(input: number): string {
    return this.id + " handles " + input;
  }
}
class Doubler {
  id = "doubler";
  handle(input: number): string {
    return this.id + " doubles to " + input * 2;
  }
}
class Negator {
  spare = 0;
  id = "negator";
  handle(input: number): string {
    return this.id + " negates to " + -input;
  }
}

////= lines-15	here	handler	Handler	string	handler.handle	1
////= lines-15	there	handler	Handler	string	handler.handle	2
function hereWithTwo(handler: Handler): string {
  return (handler as any).handle(3, 4);
}
////= lines-18	byValueHere	handle	input	string	5
////= lines-18	byValueThere	handle	input	string	6

const handler = new Handler();
const doubler = new Doubler();
const negator = new Negator();
const literal = { id: "literal", handle: (input: number) => "literal takes " + input };
const ownMethod = new Handler();
ownMethod.handle = input => "own method takes " + input;

function round(mark: string): void {
  console.log(mark, "|", here(doubler), "|", there(negator), "|", here(doubler), "|", there(negator));
  console.log(mark, "|", here(negator), "|", there(doubler), "|", hereWithTwo(doubler), "|", hereWithTwo(negator));
  console.log(mark, "|", here(handler), "|", there(literal), "|", here(ownMethod), "|", there(handler));
  console.log(mark, "|", byValueHere(literal.handle), "|", byValueThere(ownMethod.handle), "|", byValueHere(ownMethod.handle), "|", byValueThere(literal.handle));
  console.log(mark, "|", byValueHere(doubler.handle.bind(doubler)), "|", byValueThere(negator.handle.bind(negator)), "|", byValueHere(handler.handle.bind(negator)));
}

round("first");
round("second");
Doubler.prototype.handle = function (this: Doubler, input: number) {
  return this.id + " now triples to " + input * 3;
};
round("third");

