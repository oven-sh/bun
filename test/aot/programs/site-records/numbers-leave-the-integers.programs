////= lines	idThere	value	Expected	number	value.id
////= lines-2	renameHere	value	Expected	label	string	value.label
////= lines-2	renameThere	value	Expected	label	string	value.label

const expected = new Expected();
const left = new Left();
const right = new Right();
const parsedLeft: Expected = JSON.parse('{"label":"parsed left","id":4}');
const parsedRight: Expected = JSON.parse('{"a":0,"b":0,"c":0,"id":5,"label":"parsed right"}');

function round(mark: string): void {
  console.log(mark, "layouts:", labelHere(left), labelThere(right), labelHere(left), labelThere(right), idHere(left), idThere(right), idHere(left), idThere(right));
  console.log(mark, "crossed:", labelHere(right), labelThere(left), idHere(right), idThere(left));
  console.log(mark, "parsed:", labelHere(parsedLeft), labelThere(parsedRight), labelHere(parsedLeft), labelThere(parsedRight), idHere(parsedLeft), idThere(parsedRight));
  console.log(mark, "mixed:", labelHere(left), labelThere(parsedRight), labelHere(expected), labelThere(expected), idHere(parsedLeft), idThere(right));
  renameHere(left, "left " + mark);
  renameThere(right, "right " + mark);
  renameHere(parsedLeft, "parsed left " + mark);
  renameThere(parsedRight, "parsed right " + mark);
  renameHere(expected, "expected " + mark);
  console.log(mark, "renamed:", JSON.stringify([expected, left, right, parsedLeft, parsedRight]));
  console.log(mark, "read back:", labelThere(left), labelHere(right), labelThere(parsedLeft), labelHere(parsedRight), labelThere(expected));
}

round("first");
round("second");
round("third");

export {};
//// unions-of-layouts-and-tags-that-lie.ts
// A site whose type is a union of layouts reads the tag and then the fields of the member that the tag names. Honest members arrive in every order; then objects whose tag names another member, an unknown member, or changes between the test and the read.
////= lines-20	Circle	kind	"circle"	radius	number
interface Rectangle {
  kind: "rectangle";
  width: number;
  height: number;
}
////= lines-20	Label	text	string	kind	"label"
type Figure = Circle | Rectangle | Label;

////= attempt
////= lines	kindOf	figure	Figure	string	figure.kind
function measure(figure: Figure): number | string {
  switch (figure.kind) {
    case "circle":
      return figure.radius * 2;
    case "rectangle":
      return figure.width * figure.height;
    case "label":
      return figure.text.length;
  }
}
function measureByFields(figure: Figure): number | string {
  if ("radius" in figure) return figure.radius;
  if ("width" in figure) return figure.width + figure.height;
  return figure.text;
}
function grow(figure: Figure): void {
  if (figure.kind === "circle") figure.radius += 1;
  else if (figure.kind === "rectangle") figure.width += 1;
  else figure.text += "+";
}
function look(mark: string, value: unknown): void {
  const figure = value as Figure;
  console.log(mark + ":", attempt(() => kindOf(figure)), attempt(() => measure(figure)), attempt(() => measureByFields(figure)), attempt(() => grow(figure)), attempt(() => measure(figure)), attempt(() => JSON.stringify(figure)));
}

look("circle", { kind: "circle", radius: 1 });
look("rectangle", { kind: "rectangle", width: 2, height: 3 });
look("label", { text: "label", kind: "label" });
look("circle", { kind: "circle", radius: 1.5 });
look("label", { text: "", kind: "label" });
look("rectangle", { kind: "rectangle", width: 2, height: 3 });
look("circle, fields in another order", { radius: 4, kind: "circle" });
look("rectangle, one more field", { kind: "rectangle", depth: 9, width: 2, height: 3 });
look("a circle that says rectangle", { kind: "rectangle", radius: 1 });
look("a rectangle that says circle", { kind: "circle", width: 2, height: 3 });
look("a label that says circle", { text: "label", kind: "circle" });
look("a circle that says label", { kind: "label", radius: 1 });
look("an unknown tag", { kind: "triangle", radius: 1, width: 2, height: 3, text: "all of them" });
look("no tag", { radius: 1 });
look("a tag put together", { kind: ["cir", "cle"].join(""), radius: 5 });
look("a tag that is a string object", { kind: new String("circle"), radius: 5 });
look("a tag that is a number", { kind: 0, radius: 5 });
look("parsed circle", JSON.parse('{"radius":6,"kind":"circle"}'));
look("parsed rectangle", JSON.parse('{"height":2,"kind":"rectangle","width":"3"}'));

let reads = 0;
look("a tag that changes with every read", {
  get kind() {
    return ["circle", "rectangle", "label"][reads++ % 3];
  },
  radius: 1,
  width: 2,
  height: 3,
  text: "text",
});
look("a tag whose getter removes the field", {
  get kind() {
    delete (this as any).radius;
    return "circle";
  },
  radius: 1,
});
look("null", null);
look("a text", "circle");
look("circle", { kind: "circle", radius: 1 });

export {};
//// workers-collect-and-make-structures-beside-each-other.ts
// Several Workers run the same sites at the same time. Each teaches them short-lived structures and closures, collects, and sends their successors through. A Worker's collection clears what that Worker's sites learned and nothing of the others'.
import { isMainThread, parentPort, Worker, workerData } from "node:worker_threads";

interface Holder {
  wanted: unknown;
  act(): unknown;
}

////= lines	wantedOf	holder	Holder	unknown	holder.wanted
////= lines-2	setWanted	holder	Holder	to	unknown	holder.wanted
////= lines-3	act	holder	Holder	unknown	holder.act
function call(callee: () => unknown): unknown {
  return callee();
}

function made(worker: number, round: number, index: number): Holder {
  const holder: any = {};
  holder["w" + worker + "r" + round + "i" + index] = "not wanted";
  if ((index + worker) % 3 === 0) holder.pad = "not wanted";
  if ((index + worker) % 3 === 1) holder.act = () => "early " + index;
  holder.wanted = index * worker;
  holder.act ??= () => "late " + index;
  return holder;
}

function work(worker: number): string {
  let wrong = 0;
  let sum = 0;
  const honest: Holder = { wanted: "honest", act: () => "honest acts" };
  for (let round = 0; round < 12; round++) {
    const kept: Holder[] = [];
    for (let index = 0; index < 400; index++) {
      const holder = made(worker, round, index);
      if (index % 2) kept.push(holder);
      if (wantedOf(holder) !== index * worker) wrong++;
      setWanted(holder, index + round);
      if (wantedOf(holder) !== index + round) wrong++;
      const expected = ((index + worker) % 3 === 1 ? "early " : "late ") + index;
      if (act(holder) !== expected) wrong++;
      if (call(holder.act) !== expected) wrong++;
      if (call(() => index) !== index) wrong++;
      sum += index + round;
    }
    if (wantedOf(honest) !== "honest" || act(honest) !== "honest acts") wrong++;
    Bun.gc(true);
    for (const holder of kept) if (typeof wantedOf(holder) !== "number" || typeof act(holder) !== "string") wrong++;
  }
  return "worker " + worker + ": wrong " + wrong + ", sum " + sum;
}

////= lines-14	start	worker	number	thread

if (isMainThread) {
  const others = [start(1), start(2), start(3), start(4)];
  console.log(work(0).replace("worker 0", "main"));
  for (const answer of await Promise.all(others)) console.log(answer);
  console.log(work(5).replace("worker 5", "main again"));
} else {
  parentPort?.postMessage(work(Number(workerData)));
}

export {};
