type Plain = { x: number };
function outer(): number {
  const o: Plain = { x: 0 };
  middle(o);
  return o.x;
}
function middle(o: Plain): void { inner(o); }
function inner(q: Plain): void {
  let p: Plain = { x: 5 };
  function change(): void { p.x = 1; }
  p = q;
  change();
}
console.log(outer());

class Point { x = 0; y = 0; }
function outerOfClass(start: number): number {
  const o = new Point();
  o.x = start;
  middleOfClass(o);
  return o.x + o.y;
}
function middleOfClass(o: Point): void { innerOfClass(o); }
function innerOfClass(q: Point): void {
  let p: Point | null = null;
  const change = (): void => { if (p) { p.x += 1; p.y = 7; } };
  p = q;
  change();
}
const seen: number[] = [];
for (let i = 0; i < 5; i++) seen.push(outerOfClass(i * 10));
console.log(seen.join());
//// an-object-handed-two-calls-down-is-changed-through-a-variable-that-holds-it.js
// `inner` holds what it is handed in a variable of its scope, and a closure over the scope stores through the variable. The object does not outlive the call, and
// still it is changed when the call returns: to `outer`, which made it and has handed it to nobody else, and which is two calls away from the store.
function outer() {
  const o = { x: 0 };
  middle(o);
  return o.x;
}
function middle(o) { inner(o); }
////= inner
console.log(outer());

// The same where every function runs several times.
function outerAgain(start) {
  const o = { x: start };
  middleAgain(o);
  return o.x;
}
function middleAgain(o) { innerAgain(o); }
function innerAgain(q) {
  let p = null;
  function change() { p.x += 1; }
  p = q;
  change();
}
const seen = [];
for (let i = 0; i < 5; i++) seen.push(outerAgain(i * 10));
console.log(seen.join());

// Three calls away, and the value before the call is not a constant.
function far(n) {
  const o = { x: n, y: n * 2 };
  one(o);
  return o.x + o.y;
}
function one(o) { two(o); }
function two(o) { three(o); }
function three(q) {
  let p = null;
  const change = () => { p.y = p.x + 100; };
  p = q;
  change();
}
console.log(far(1), far(2));
//// an-object-handed-two-calls-down-is-changed-through-what-holds-it.js
// What a function is handed lies in an object, an array or a closure of the function's own, which it hands on. Whoever gets that reads the first object out and changes
// it. The maker of the object is two calls away from the function that stored it.
function changeBox(b) { b.o.x = 1; }
function holdInBox(o) { const box = { o }; changeBox(box); }
function viaBox(o) { holdInBox(o); }
function first() { const o = { x: 0 }; viaBox(o); return o.x; }

function changeDeep(b) { b.inner.o.x += 2; }
function holdDeep(o) { const box = { inner: { o } }; changeDeep(box); }
function viaDeep(o) { holdDeep(o); }
function second() { const o = { x: 0 }; o.x = 5; viaDeep(o); return o.x; }

function changeList(list) { list[0].x = 9; }
function holdInList(o) { changeList([o]); }
function viaList(o) { holdInList(o); }
function third() { const o = { x: 0 }; viaList(o); return o.x; }

function changePushed(list) { list[list.length - 1].x = 11; }
function holdPushed(o) { const list = []; list.push(o); changePushed(list); }
function viaPushed(o) { holdPushed(o); }
function fourth() { const o = { x: 0 }; viaPushed(o); return o.x; }

function run(f) { f(); }
function holdInClosure(o) { run(() => { o.x = 13; }); }
function viaClosure(o) { holdInClosure(o); }
function fifth() { const o = { x: 0 }; viaClosure(o); return o.x; }

function runMethod(holder) { holder.change(); }
function holdInMethod(o) { runMethod({ change() { o.x = 17; } }); }
function viaMethod(o) { holdInMethod(o); }
function sixth() { const o = { x: 0 }; viaMethod(o); return o.x; }

function changeMap(map) { map.get("o").x = 19; }
function holdInMap(o) { const map = new Map(); map.set("o", o); changeMap(map); }
function viaMap(o) { holdInMap(o); }
function seventh() { const o = { x: 0 }; viaMap(o); return o.x; }

console.log(first(), second(), third(), fourth(), fifth(), sixth(), seventh());
let sum = 0;
for (let i = 0; i < 4; i++) sum += first() + second() + third() + fourth() + fifth() + sixth() + seventh();
console.log(sum);
//// an-object-handed-two-calls-down-is-changed-under-another-name.js
// The function that is handed the object gets a second name for it: from a call that returns it, from `arguments`, from a rest parameter, from `this` in an arrow,
// from a bound function, from a catch clause, from a generator, from a getter. The store goes through the second name, two calls away from the maker of the object.
const results = [];
function check(name, make) {
  results.push(name + ":" + make() + ":" + make());
}

function same(o) { return o; }
function innerReturned(q) { same(q).x = 1; }
function middleReturned(o) { innerReturned(o); }
check("returned", () => { const o = { x: 0 }; middleReturned(o); return o.x; });

function changeFirst(list) { list[0].x = 2; }
function innerArguments(q) { changeFirst(arguments); }
function middleArguments(o) { innerArguments(o); }
check("arguments", () => { const o = { x: 0 }; middleArguments(o); return o.x; });

function innerRest(...rest) { changeFirst(rest); }
function middleRest(o) { innerRest(o); }
check("rest", () => { const o = { x: 0 }; middleRest(o); return o.x; });

class Counter {
  x = 0;
  bump() { const change = () => { this.x = 3; }; change(); }
}
function middleThis(o) { o.bump(); }
check("this", () => { const o = new Counter(); middleThis(o); return o.x; });

function changeGiven(p) { p.x = 4; }
function innerBound(q) { const bound = changeGiven.bind(null, q); bound(); }
function middleBound(o) { innerBound(o); }
check("bound", () => { const o = { x: 0 }; middleBound(o); return o.x; });

function innerThrown(q) { try { throw q; } catch (caught) { caught.x = 5; } }
function middleThrown(o) { innerThrown(o); }
check("thrown", () => { const o = { x: 0 }; middleThrown(o); return o.x; });

function* each(q) { yield q; }
function innerGenerator(q) { for (const p of each(q)) p.x = 6; }
function middleGenerator(o) { innerGenerator(o); }
check("generator", () => { const o = { x: 0 }; middleGenerator(o); return o.x; });

function innerGetter(q) { const holder = { get it() { return q; } }; holder.it.x = 7; }
function middleGetter(o) { innerGetter(o); }
check("getter", () => { const o = { x: 0 }; middleGetter(o); return o.x; });

function innerSpread(q) { const box = { ...{ o: q } }; box.o.x = 8; }
function middleSpread(o) { innerSpread(o); }
check("spread", () => { const o = { x: 0 }; middleSpread(o); return o.x; });

function innerPattern(q) { const [{ o: p }] = [{ o: q }]; p.x = 9; }
function middlePattern(o) { innerPattern(o); }
check("pattern", () => { const o = { x: 0 }; middlePattern(o); return o.x; });

let kept = null;
function changeKept() { kept.x = 10; }
function innerGlobal(q) { kept = q; changeKept(); kept = null; }
function middleGlobal(o) { innerGlobal(o); }
check("variable of the module", () => { const o = { x: 0 }; middleGlobal(o); return o.x; });

function innerLoop(q) {
  const made = [];
  for (let round = 0; round < 3; round++) made.push(() => { q.x += round; });
  for (const each of made) each();
}
function middleLoop(o) { innerLoop(o); }
check("closures of a loop", () => { const o = { x: 10 }; middleLoop(o); return o.x; });

console.log(results.join("\n"));
//// an-object-handed-two-calls-down-is-read-or-reshaped-through-what-holds-it.js
// What holds the object is handed on, and whoever gets it reads the object, adds a property, deletes one, freezes it, or gives it another prototype. The maker of the
// object is two calls away: a store in front of the call is not dead, and what it knew of the object's shape no longer holds behind the call.
const seen = [];
function read(h) { seen.push(h.inner.x); }
function holdToRead(o) { read({ inner: o }); }
function viaRead(o) { holdToRead(o); }
function storesAroundTheCall() { const o = { x: 0 }; o.x = 5; viaRead(o); o.x = 6; return o.x; }

function grow(h) { h.inner.extra = 7; }
function holdToGrow(o) { grow({ inner: o }); }
function viaGrow(o) { holdToGrow(o); }
function grown() { const o = { x: 1 }; viaGrow(o); return [o.x, o.extra, Object.keys(o).join("+")].join(); }

function shrink(h) { delete h.inner.x; }
function holdToShrink(o) { shrink({ inner: o }); }
function viaShrink(o) { holdToShrink(o); }
function shrunk() { const o = { x: 1, y: 2 }; viaShrink(o); return [o.x, o.y, "x" in o, Object.keys(o).join("+")].join(); }

function freeze(h) { Object.freeze(h.inner); }
function holdToFreeze(o) { freeze({ inner: o }); }
function viaFreeze(o) { holdToFreeze(o); }
function frozen() {
  const o = { x: 1 };
  viaFreeze(o);
  let refused = false;
  try { o.x = 2; } catch { refused = true; }
  return [o.x, refused, Object.isFrozen(o)].join();
}

function reparent(h) { Object.setPrototypeOf(h.inner, { inherited: 9 }); }
function holdToReparent(o) { reparent({ inner: o }); }
function viaReparent(o) { holdToReparent(o); }
function reparented() { const o = { x: 1 }; const before = o.inherited; viaReparent(o); return [before, o.inherited].join(); }

function define(h) { Object.defineProperty(h.inner, "x", { get() { return 42; } }); }
function holdToDefine(o) { define({ inner: o }); }
function viaDefine(o) { holdToDefine(o); }
function defined() { const o = { x: 1 }; viaDefine(o); return o.x; }

function push(h) { h.inner.push(3); h.inner[0] = 10; }
function holdToPush(list) { push({ inner: list }); }
function viaPush(list) { holdToPush(list); }
function pushed() { const list = [1, 2]; viaPush(list); return [list.length, list[0], list.join("+")].join(); }

for (let round = 0; round < 2; round++) {
  console.log(storesAroundTheCall(), seen.join(), grown(), shrunk(), frozen(), reparented(), defined(), pushed());
}
