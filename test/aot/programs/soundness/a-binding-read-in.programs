// The error has to name null. The function with the read has no handler of its own: the caller catches.
class Person {
  first: string = "ann";
}
class Animal {}
class Dog extends Animal {
  owner: Person = new Person();
}
class Cat extends Animal {}
interface Keeper {
  ownerName(a: Animal): string;
}
const keeper: Keeper = { ownerName: (d: Dog) => (d.owner ?? null)!.first };
////= tryAll
console.log("cat " + tryAll(new Cat()));
console.log("dog " + tryAll(new Dog()));
