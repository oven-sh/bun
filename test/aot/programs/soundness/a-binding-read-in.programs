////: tryAll
function tryAll(a: Animal): string {
  let out = "";
  const uses: (() => unknown)[] = [() => 1, () => 2, () => 3, () => 4, () => keeper.ownerName(a)];
  for (const use of uses) {
    try {
      out += String(use()) + ";";
    } catch (error) {
      out += (error as Error).constructor.name + " " + (error as Error).message.split(" ")[0] + ";";
    }
  }
  return out;
}
