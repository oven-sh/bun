//// contents-of-collections-change-kind-inside-a-built-in-callback.js
// Keys, values and receivers of Map, Set and Array methods change inside a callback of another built-in.
function run(f) { "x".replace("x", f); }
function main() {
  const m = new Map();
  let key = 1, value = "one";
  function change() { key = { k: 1 }; value = { v: 2 }; return ""; }
  const keys = [];
  for (let i = 0; i < 2; i++) { m.set(key, value); keys.push(key); run(change); }
  console.log(typeof m.get(keys[0]), typeof m.get(keys[1]), m.get(keys[1]).v, m.size);
  let store = new Map();
  const first = store;
  function other() { store = new Map(); return ""; }
  for (let i = 0; i < 2; i++) { store.set("k", i ? { late: i } : 0); run(other); }
  console.log(typeof first.get("k"), typeof store.get("k"));
  const list = [];
  let item = 1;
  function next() { item = { boxed: 1 }; return ""; }
  for (let i = 0; i < 2; i++) { list.push(item); run(next); }
  console.log(typeof list[0], typeof list[1], list[1].boxed, typeof list.pop(), typeof list.pop(), typeof list.pop());
  const s = new Set();
  for (let i = 0; i < 2; i++) { s.add(i ? item : 0); }
  let kinds = "";
  for (const e of s) kinds += typeof e;
  console.log(kinds);
}
main();
//// conversion-installs-conversion.js
function print(a, b, c) { let s = "" + a; if (b !== undefined) s += " " + b; if (c !== undefined) s += " " + c; console.log(s); }
////= show-2
let state = 0;
const p = { v: 1 };
const o = { toString() { p.valueOf = function () { state = "changed"; return 7; }; return "o"; } };
function use(tag) { const before = state; show(tag, p + 1); show(tag, "" + o); show(tag, p + 1); show(tag, state); show(tag, before); }
use("first");
use("second");
//// conversion-methods-added-by-a-function-found-late.js
// What a conversion finds (valueOf, toString, @@toPrimitive, toJSON, @@hasInstance, @@species) changes after it has run once, in a function that is found under a key read from a field before the constructor stores it.
function print(a, b, c) { let s = "" + a; if (b !== undefined) s += " " + b; if (c !== undefined) s += " " + c; console.log(s); }
////= show-2
function nothing() {}
let leaked = "a";
function probe(x) { leaked = x.k; }
class Leak { constructor() { probe(this); this.k = "a"; } }
function h0(f) { const choices = { a: nothing, undefined: f }; new Leak(); return choices[leaked](); }

////= convertOwnValueof-2
main();
//// conversion-methods-that-appear-after-the-first-conversion.js
// What a conversion finds (valueOf, toString, @@toPrimitive, toJSON, @@hasInstance, @@species) changes after it has run once, in code that is reached through a chain of calls.
function print(a, b, c) { let s = "" + a; if (b !== undefined) s += " " + b; if (c !== undefined) s += " " + c; console.log(s); }
////= show-2
function h0(f) { return h1(f); }
function h1(f) { return h2(f); }
function h2(f) { return h3(f); }
function h3(f) { return h4(f); }
function h4(f) { return h5(f); }
function h5(f) { return h6(f); }
function h6(f) { return h7(f); }
function h7(f) { return h8(f); }
function h8(f) { return f(); }

////= convertOwnValueof-2
main();
