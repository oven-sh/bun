////: Below
class Below extends Legacy {
  constructor(value) {
    super(value);
    this.next = value + 1;
  }
}
////: Button
class Button {
  constructor(label) {
    this.label = label;
    this.press = this.press.bind(this);
  }
  press() {
    return "pressed " + this.label;
  }
}
