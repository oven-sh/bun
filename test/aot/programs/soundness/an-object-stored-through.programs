  inOperator: o => "x" in o, computedIn: o => JSON.parse('"y"') in o, forIn: o => { let s = ""; for (const k in o) s += k; return s; }, stringify: o => JSON.stringify(o), inspect: o => util.inspect(o), clone: o => structuredClone(o).x,
