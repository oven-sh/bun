function store(target, value, s) { const before = s.n; target[1] = value; return typeof before + " " + typeof s.n; }
console.log(store(list, 1, state));
console.log(store(list, writes, state));

const throws = { valueOf() { throw "thrown text"; } };
function storeInTry(target, value) { try { target[0] = value; return "stored"; } catch (e) { return typeof e === "string" ? e.length : e.message; } }
console.log(storeInTry(list, 1));
console.log(storeInTry(list, throws));
//// value-is-used-after-array-includes.js
// Value is used after array includes.
const a = ["a whole text with a tail", "tail"];
const b = ["a whole text with a tai", "whole text"];
let total = 0;
for (let i = 0; i < b.length; i++) {
  const n = b[i].length * 3;
  if (a.includes(b[i])) total += 1000;
  total += n;
}
console.log(total);
//// variable-without-a-value-is-used-in-rare-code.ts
// Variable without a value is used in rare code.
class Rec { constructor(public name: string, public n: number) {} }
const spare = new Rec("spare", 0);
let left = 0, fresh = false;
function a(): string {
  if (left === 0) return "a()";
  left--;
  return b(fresh ? new Rec("f", left) : spare, fresh ? "s" + left : "s", left + 0.5);
}
function b(p0: Rec, p1: string, p2: number): string {
  if (left === 0) return "b(" + p0.name + p0.n + "," + p1 + "," + p2 + ")";
  left--;
  return a();
}
for (const [hops, makes] of [[1, false], [3, true], [5, false], [100001, true]] as [number, boolean][]) {
  left = hops;
  fresh = makes;
  console.log(a());
}
//// writable-field-shadows-a-setter-for-an-heir.js
// Writable field shadows a setter for an heir.
const log = [];
const top = { set tag(v) { log.push("setter " + v); }, get tag() { return "top"; } };
const middle = { __proto__: top, tag: 1 };
const heir = { __proto__: middle };
heir.tag = 2;
console.log(log.join(), Object.hasOwn(heir, "tag"), Object.keys(heir).join());
