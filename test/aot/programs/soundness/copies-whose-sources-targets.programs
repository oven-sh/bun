  "a String object": () => new String("abc"),
  "a typed array": () => new Uint8Array([7, 8, 9]),
  "an empty typed array": () => new Uint8Array(0),
  "an array": () => [7, 8, 9],
  "a frozen array": () => Object.freeze([7, 8, 9]),
  "an array with a getter and a setter": () =>
