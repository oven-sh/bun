////: say-2
function say(label, run) {
  try {
    lines.push(label + ": " + JSON.stringify(run()));
  } catch (error) {
    lines.push(label + ": threw " + error.name);
  }
}
////: seenOf
const seenOf = (object, proto, key) => [
  object[key],
  Object.hasOwn(object, key),
  Object.hasOwn(proto, key),
  object.seen,
  object.other,
];
//// copies-whose-sources-targets-and-keys-arrive-late.js
// Copies of properties whose sources, targets, keys and excluded keys arrive late.
function id(x) { return x; }
function chain(x) { return id(id(id(id(id(id(id(id(x)))))))); }
function show(...parts) { console.log(parts.map(String).join(" | ")); }
function dynamic(text) { return (text + "!").slice(0, text.length); }

// 1: the source gets a property after the copy was seen
{
  const source = { a: 1 };
  function grow(s) { s.late = "text"; }
  grow(chain(source));
  const copy = { ...source };
  show("1", copy.a + 1, copy.late.length);
}
// 2: another source, another target
{
  function assign(t, s) { return Object.assign(t, s); }
  const t1 = assign({}, { a: 1 });
  const t2 = assign(chain({ own: true }), { a: 1 });
  const t3 = assign({}, chain({ b: "text" }));
  show("2", t1.a + 1, t2.a + 1, t2.own, t3.b.length, t3.a);
}
// 3: Object.assign runs a setter that appears late on the chain of the target
{
  const log = [];
  const proto = {};
  const target = Object.create(proto);
  function assign(t, s) { return Object.assign(t, s); }
  assign({}, { x: 0 });
  Object.defineProperty(chain(proto), "x", { set(v) { log.push(v); this.hidden = v; }, configurable: true });
  assign(target, { x: 5 });
  show("3", Object.keys(target).join(), target.hidden + 1, log.join());
}
// 4: the getter of a source appears late
{
  const source = { a: 1 };
  Object.defineProperty(chain(source), "g", { get() { return helper(); }, enumerable: true });
  function helper() { return ["from getter"]; }
  const copy = { ...source };
  show("4", copy.g.length, copy.g[0].length, Object.getOwnPropertyDescriptor(copy, "g").value.length);
}
// 5: a rest pattern whose excluded key is one name first and two names later
{
  function omit(o, k) { const { [k]: dropped, ...rest } = o; return rest; }
  const first = omit({ a: 1, b: "text" }, "a");
  show("5a", first.a, first.b.length);
  const second = omit({ a: 1, b: "text" }, chain("b"));
  show("5b", second.a + 1, second.b);
}
// 6: a rest pattern with a key that nobody can name
{
  function omit(o, k) { const { [k]: dropped, ...rest } = o; return rest; }
  const rest = omit({ a: 1, b: "text" }, dynamic("a"));
  show("6", rest.a, rest.b.length);
  const rest2 = omit({ a: 1, b: "text" }, dynamic("zz"));
  show("6b", rest2.a + 1, rest2.b.length);
}
// 7: a string as a source, arriving late
{
  function spread(s) { return { ...s }; }
  show("7a", Object.keys(spread({ a: 1 })).join());
  const characters = spread(chain("hi"));
  show("7b", Object.keys(characters).join(), characters[0].length, characters[1]);
}
// 8: unnamed members of the source
{
  const source = {};
  source[dynamic("k")] = [1, 2];
  const copy = { ...source };
  show("8", copy.k.length);
  const source2 = {};
  const copy2 = Object.assign({ k: 0 }, source2);
  show("8b", copy2.k + 1);
  function fill(s) { s[dynamic("k")] = "text"; }
  fill(chain(source2));
  const copy3 = Object.assign({ k: 0 }, source2);
  show("8c", copy3.k.length);
}
// 9: a copy of a copy of a copy, the first source grows last
{
  const source = { a: 1 };
  function clone(o) { return { ...o }; }
  const make = () => clone(clone(clone(source)));
  show("9a", make().a + 1, make().z);
  chain(source).z = () => "called";
  show("9b", make().z());
}
// 10: symbols and non-enumerable properties
{
  const s = Symbol("s");
  const source = { [s]: "symbol" };
  Object.defineProperty(source, "hidden", { value: 1, enumerable: false });
  const copy = { ...chain(source) };
  show("10", copy[s].length, copy.hidden, "hidden" in copy);
}
// 11: arrays as sources and targets
{
  const copy = Object.assign([], chain([1, "two"]));
  show("11", copy.length, copy[0] + 1, copy[1].length);
  const spread = { ...chain(["zero"]) };
  show("11b", spread[0].length, spread["0"].length);
}
//// declared-field-of-subclass-keeps-what-the-base-stored.ts
class A {
  value: unknown;
  constructor() { this.value = this.make(); }
  make(): unknown { return 1; }
}
class B extends A {
  declare value: string;
  make(): unknown { return "made"; }
  size(): number { return this.value.length; }
}
console.log(new B().size(), new B().value, new A().value);
//// declared-optional-field-stored-through-any-under-a-computed-key.ts
// A declared optional field is stored through `any` under a key that only the run knows. Untyped reads get the value back, typed reads see the objects that hold what the type says.
const names: string[] = JSON.parse('["late", "count"]');
const input: any = JSON.parse('{"late": 5, "count": "many"}');
interface Entry {
  count: number;
  late?: string;
}
class Holder {
  count: number = 0;
  late?: string;
  lateLength(): number {
    return this.late === undefined ? -1 : this.late.length;
  }
}
function entry(count: number): Entry {
  return { count };
}
function lateLength(e: Entry): number {
  return e.late === undefined ? -1 : e.late.length;
}
function twice(e: Entry): number {
  return e.count * 2;
}
function untyped(o: any): string {
  return typeof o.late + ":" + String(o.late) + " " + typeof o.count + ":" + String(o.count) + " " + Object.keys(o).join("+") + " " + JSON.stringify(o);
}
const a = entry(1);
(a as any)[names[0]] = 5;
const b = entry(2);
b.late = "text";
const c = entry(3);
for (const k of Object.keys(input)) (c as any)[k] = input[k];
const d: Entry = Object.assign(entry(4), input);
const e = entry(5);
(e as any)[names[0]] = "fits";
const h = new Holder();
(h as any)[names[0]] = 5;
const i = new Holder();
i.late = "text";
const j = new Holder();
for (const k of Object.keys(input)) (j as any)[k] = input[k];
const k = new Holder();
(k as any)[names[0]] = "fits";
for (const o of [a, b, c, d, e, h, i, j, k]) console.log(untyped(o));
console.log(twice(a), lateLength(b), twice(b), lateLength(e), twice(e), h.count, i.lateLength(), i.count, k.lateLength(), k.count);
let total = 0;
for (let n = 0; n < 6000; n++) {
  total += lateLength(n & 1 ? b : e) + (n & 1 ? i : k).lateLength() + twice(n % 3 === 0 ? a : n % 3 === 1 ? b : e);
}
console.log(total);
a.late = "typed again";
h.late = undefined;
console.log(lateLength(a), h.lateLength(), untyped(a), untyped(h));
//// definitions-of-a-module-read-before-they-stand.mjs
// The variables of a module get their values where the definitions stand. Hoisted functions that run earlier find them uninitialized, also when the value is an object that costs nothing to make.
const log = [];
const attempt = (name, f) => { try { log.push(name + ": " + f()); } catch (e) { log.push(name + ": " + e.name); } };
function all(when) {
  attempt(when + " table", () => table.a);
  attempt(when + " list", () => list.length);
  attempt(when + " helper", () => helper());
  attempt(when + " class", () => new Thing().n);
  attempt(when + " pattern", () => pattern.test("a"));
  attempt(when + " symbol", () => mark.description);
  attempt(when + " map", () => byName.size);
  attempt(when + " typeof table", () => typeof table);
  attempt(when + " var", () => String(early));
  attempt(when + " declared function", () => declared());
  attempt(when + " exported", () => shared.n);
}
all("before");
const table = { a: 1 };
const list = [1, 2];
const helper = () => 5;
class Thing { n = 1; }
const pattern = /a/;
all("between");
const mark = Symbol("mark");
const byName = new Map();
var early = [1];
function declared() { return "declared"; }
export const shared = { n: 7 };
all("after");
let count = 1;
const box = { count };
const snapshot = [count, table.a];
count = 2;
table.a = 3;
log.push("moment: " + [box.count, snapshot, count, table.a].join());
console.log(log.join("\n"));
//// definitions-read-across-a-cycle-of-modules/first.mjs
import { seenEarly, look } from "./second.mjs";
export const table = { a: 1 };
export const helper = () => 5;
export class Thing { n = 1; }
export let counter = 1;
export var loose = [1];
export function declared() { return "declared"; }
export default { kind: "default" };
counter = 2;
export function report() { return [...seenEarly, ...look("late")]; }
//// definitions-read-across-a-cycle-of-modules/main.mjs
// first.mjs imports second.mjs, which imports first.mjs again and runs first: what first.mjs defines is not there yet, but for its function declarations.
import { report } from "./first.mjs";
console.log(report().join("\n"));
//// definitions-read-across-a-cycle-of-modules/second.mjs
import main, { table, helper, Thing, counter, loose, declared } from "./first.mjs";
import * as all from "./first.mjs";
const attempt = (name, f) => { try { return name + ": " + f(); } catch (e) { return name + ": " + e.name; } };
export function look(when) {
  return [
    attempt(when + " table", () => table.a), attempt(when + " helper", () => helper()), attempt(when + " class", () => new Thing().n), attempt(when + " counter", () => counter),
    attempt(when + " var", () => String(loose)), attempt(when + " declared", () => declared()), attempt(when + " default", () => main.kind),
    attempt(when + " namespace keys", () => Object.keys(all).join()), attempt(when + " namespace read", () => all.table.a), attempt(when + " namespace has", () => "table" in all),
    attempt(when + " namespace descriptor", () => typeof Object.getOwnPropertyDescriptor(all, "helper").value),
  ];
}
export const seenEarly = look("early");
//// descriptors-arrive-late-or-change-kind.js
// Descriptors and maps of descriptors that arrive late or change their kind.
function id(x) { return x; }
function chain(x) { return id(id(id(id(id(id(id(id(x)))))))); }
function show(...parts) { console.log(parts.map(String).join(" | ")); }
function dynamic(text) { return (text + "!").slice(0, text.length); }

// 1: the receiver is known long before the descriptor
{
  function define(o, d) { Object.defineProperty(o, "p", d); }
  const o = {};
  define(o, chain(chain(chain({ value: "text", configurable: true }))));
  show("1", o.p.length);
}
// 2: a data descriptor first, an accessor descriptor late
{
  function define(o, d) { Object.defineProperty(o, "p", d); }
  const a = {}, b = {};
  define(a, { value: 1, configurable: true });
  show("2a", a.p + 1);
  define(b, chain({ get() { return helper(); }, configurable: true }));
  function helper() { return "getter"; }
  show("2b", b.p.length);
  define(a, chain({ get() { return [1]; } }));
  show("2c", a.p.length);
}
// 3: an accessor descriptor first, a data descriptor late
{
  function define(o, d) { Object.defineProperty(o, "p", d); }
  const a = {};
  define(a, { get() { return "getter"; }, configurable: true });
  show("3a", a.p.length);
  define(a, chain({ value: 7 }));
  show("3b", a.p + 1);
}
// 4: the fields of the descriptor are filled late
{
  const d = {};
  function fill(x) { x.get = function () { return this.base + 1; }; x.configurable = true; }
  fill(chain(d));
  const o = { base: 1 };
  Object.defineProperty(o, "p", d);
  show("4", o.p + 1);
}
// 5: the descriptor inherits its fields
{
  const inherited = Object.create({ value: "inherited" });
  const o = {};
  Object.defineProperty(o, "p", chain(inherited));
  show("5", o.p.length);
  const parent = {};
  const child = Object.create(parent);
  chain(parent).get = () => "late getter";
  const q = {};
  Object.defineProperty(q, "p", child);
  show("5b", q.p.length);
}
// 6: the key arrives late
{
  function define(o, k, v) { Object.defineProperty(o, k, { value: v, enumerable: true }); }
  const o = {};
  define(o, "a", 1);
  define(o, chain("b"), "text");
  define(o, dynamic("c"), [1]);
  show("6", o.a + 1, o.b.length, o.c.length);
}
// 7: a map whose keys and descriptors arrive late
