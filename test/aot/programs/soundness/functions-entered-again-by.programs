// What a loop, a pattern or a spread finds (@@iterator, next, return, the results, the contents) changes after it has run once, in a function that is found under a key read from a field before the constructor stores it.
function print(a, b, c) { let s = "" + a; if (b !== undefined) s += " " + b; if (c !== undefined) s += " " + c; console.log(s); }
////= show-2
function nothing() {}
let leaked = "a";
function probe(x) { leaked = x.k; }
class Leak { constructor() { probe(this); this.k = "a"; } }
function h0(f) { const choices = { a: nothing, undefined: f }; new Leak(); return choices[leaked](); }

////= iterateOwnIterator-2
main();
//// iteration-methods-and-contents-that-change-after-the-first-loop.js
// What a loop, a pattern or a spread finds (@@iterator, next, return, the results, the contents) changes after it has run once, in code that is reached through a chain of calls.
function print(a, b, c) { let s = "" + a; if (b !== undefined) s += " " + b; if (c !== undefined) s += " " + c; console.log(s); }
////= show-2
function h0(f) { return h1(f); }
function h1(f) { return h2(f); }
function h2(f) { return h3(f); }
function h3(f) { return h4(f); }
function h4(f) { return h5(f); }
function h5(f) { return h6(f); }
function h6(f) { return h7(f); }
function h7(f) { return h8(f); }
function h8(f) { return f(); }

////= iterateOwnIterator-2
main();
//// iterator-helpers-hand-on-what-their-generator-yields.js
const item = { n: 1 };
const other = { n: 2 };
const same = value => value;
function show(label, value) {
  console.log(label, typeof value, value === item, value === other);
}

show("spread of map", [...[item, other].values().map(same)][0]);
show("toArray of map", [item, other].values().map(same).toArray()[1]);
show("spread of filter", [...[item, other].values().filter(value => value === other)][0]);
show("toArray of take", [item, other].values().take(1).toArray()[0]);
show("spread of drop", [...[item, other].values().drop(1)][0]);
show("spread of flatMap", [...[item].values().flatMap(value => [value, other])][1]);

const step = [item, other].values().filter(() => true).next();
console.log("step", typeof step, Object.keys(step).join(), step.done);
show("value of a step", step.value);

const doubled = [...[1, 2].values().map(value => value * 2)];
console.log("numbers", doubled.length, doubled.join(), doubled[0] + 1);
for (const number of doubled) console.log(number + 1);

const called = [() => 21, () => 42].values().drop(1).next();
console.log("function", typeof called, called.done, called.value());

const empty = [].values().map(same);
const last = empty.next();
console.log("completed", last.done, last.value, JSON.stringify(empty.next()));

const closed = [item].values().map(same);
console.log("closed", JSON.stringify(closed.return()), JSON.stringify(closed.next()));
const started = [item, other].values().map(same);
show("before return", started.next().value);
console.log("return", JSON.stringify(started.return()), JSON.stringify(started.next()));

function* twice() {
  yield item;
  return other;
}
const byHand = twice();
show("yielded", byHand.next().value);
const returned = byHand.next();
console.log("returned", returned.done);
show("returned value", returned.value);
const after = byHand.next();
console.log("after the end", after.done, after.value);
show("over a generator", [...twice().map(same)][0]);
show("over a set", [...new Set([other]).values().map(same)][0]);
show("for-of", (() => { for (const value of [item].values().map(same)) return value; })());
show("Array.from", Array.from([other].values().map(same))[0]);
const [first] = [item].values().map(same);
show("pattern", first);
//// json-replacer-and-reviver-arrive-late.js
// The replacer and the reviver of JSON change from nothing to a function to a list, and toJSON adds a member with its own toJSON.
function main() {
  let replacer = null;
  const data = { a: 1, b: { c: 2 } };
  const seen = [];
  function pick(key, value) { seen.push(typeof this, key); replacer = ["a"]; return value; }
  const out = [];
  for (let i = 0; i < 3; i++) { out.push(JSON.stringify(data, replacer)); if (!i) replacer = pick; }
  console.log(out.join(" "), seen.join());
  let reviver = undefined;
  function revive(key, value) { return typeof value === "number" ? { n: value } : value; }
  const parsed = [];
  for (let i = 0; i < 2; i++) { parsed.push(JSON.parse('{"x":1}', reviver)); reviver = revive; }
  console.log(typeof parsed[0].x, typeof parsed[1].x, parsed[1].x.n);
  const withToJSON = { toJSON() { withToJSON.extra = { toJSON() { return "inner"; } }; return { extra: withToJSON.extra }; } };
  console.log(JSON.stringify(withToJSON), JSON.stringify(withToJSON));
}
main();
//// keys-and-objects-of-reflective-accesses-arrive-late.js
// The key of a reflective read changes inside a function that is found through the first read.
function main() {
let key = "first";
const table = {
  first() { key = "second"; return 1; },
  second() { key = "third"; return "two"; },
  third: { deep: true },
};
let seen = [];
for (let i = 0; i < 3; i++) {
  const member = Reflect.get(table, key);
  seen.push(typeof member === "function" ? typeof member() : member.deep);
}
console.log(seen.join());

// The object changes the same way.
let source = { value() { source = { value: "late object" }; return 0; } };
let out = [];
for (let i = 0; i < 2; i++) {
  const v = Reflect.get(source, "value");
  out.push(typeof v === "function" ? v() : v.length);
}
console.log(out.join());

// A store under a key that arrives late.
let storeKey = "a";
const stored = { a: 0, b: 0 };
function bump() { storeKey = "b"; return "text"; }
for (let i = 0; i < 2; i++) Reflect.set(stored, storeKey, i ? bump : bump());
console.log(typeof stored.a, typeof stored.b);
for (let i = 0; i < 2; i++) Reflect.set(stored, storeKey, { n: i });
console.log(typeof stored.a, typeof stored.b, stored.b.n);

let definedKey = "x";
const definedOn = { x: 1, y: 2 };
const descriptor = { get() { definedKey = "y"; return "got"; }, configurable: true };
for (let i = 0; i < 2; i++) { Object.defineProperty(definedOn, definedKey, descriptor); definedOn.x; }
console.log(definedOn.x, definedOn.y);
}
main();
//// keys-listed-of-an-object-that-never-had-the-removed-field-in-a-validating-build.js
// Two allocations have the layout of B: the one of First stores `first`, which nothing reads, and the one the super call makes for A never has it and lists its keys.
function A() { this.x = 1; let names = ""; for (const k in this) names += k + ","; this.names = names; }
class First { constructor() { this.first = "First"; } }
class B extends First {}
Object.setPrototypeOf(B, A);
console.log(new B().names);
