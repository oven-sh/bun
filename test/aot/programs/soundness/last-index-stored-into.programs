//// loops-meet-odd-values-and-go-on.js
// A loop that has run on numbers for a while meets a value of another kind, once or often, at the start, in the middle or at the end, and goes on.
var log = [];

function unknown(value) {
  return JSON.parse(JSON.stringify({ value: value })).value;
}

function list(length, odd) {
  var items = [];
  for (var i = 0; i < length; i++) items.push(unknown(i % 7));
  for (var at in odd) items[at] = odd[at];
  return items;
}

function sum(values) {
  var total = 0;
  for (var i = 0; i < values.length; i++) total += values[i];
  return total;
}

function sumAndCount(values) {
  var state = { total: 0, count: 0 };
  for (var i = 0; i < values.length; i++) {
    state.total += values[i];
    state.count++;
  }
  return state.total + "/" + state.count;
}

function product(values) {
  var result = 1;
  for (var i = 0; i < values.length; i++) result = (result * (values[i] + 1)) % 1009;
  return result;
}

function chase(next, steps) {
  var at = 0;
  var seen = 0;
  for (var step = 0; step < steps; step++) {
    at = next[at];
    seen++;
  }
  return String(at) + ":" + seen;
}

function largest(values) {
  var best = -Infinity;
  for (var i = 0; i < values.length; i++) {
    if (values[i] > best) best = values[i];
  }
  return best;
}

function nested(rows) {
  var total = 0;
  for (var i = 0; i < rows.length; i++) {
    var row = 0;
    for (var j = 0; j < rows[i].length; j++) row += rows[i][j];
    total += row;
  }
  return total;
}

function carriedThroughBoth(rows) {
  var total = 0;
  for (var i = 0; i < rows.length; i++) {
    for (var j = 0; j < rows[i].length; j++) total += rows[i][j];
    total += 1;
  }
  return total;
}

function untilOdd(values) {
  var total = 0;
  var i = 0;
  while (true) {
    var value = values[i++];
    if (value === undefined) break;
    if (typeof value === "string") continue;
    total += value;
  }
  return total + "@" + i;
}

function caught(values) {
  var total = 0;
  var failures = 0;
  for (var i = 0; i < values.length; i++) {
    try {
      total += values[i];
    } catch (error) {
      failures++;
      total = 0;
    } finally {
      total += 1;
    }
  }
  return String(total) + "!" + failures;
}

function closures(values) {
  var readers = [];
  let total = 0;
  for (let i = 0; i < values.length; i++) {
    total += values[i];
    if (i % 40 === 0) readers.push(() => i + ":" + total);
  }
  return readers.map(reader => reader()).join();
}

var plain = list(200, {});
log.push(sum(plain), sumAndCount(plain), product(plain), largest(plain));

for (var at of [0, 1, 99, 198, 199]) {
  var odd = {};
  odd[at] = "x";
  var values = list(200, odd);
  log.push(at + " " + sum(values).length + " " + sumAndCount(values).length + " " + product(values) + " " + largest(values) + " " + untilOdd(values));
}

log.push(sum(list(200, { 10: 0.5, 20: -0, 30: 2147483647, 40: 4294967296, 50: NaN })));
log.push(sum(list(200, { 10: 0.5, 20: 1e300, 30: -1e300 })), product(list(200, { 3: 0.25 })), largest(list(200, { 7: 6.5, 8: "9", 9: null })));
log.push(sum(list(200, { 5: null, 6: true, 7: false })), String(sum(list(200, { 5: undefined }))), sum(list(200, { 199: [1, 2] })));

var calls = 0;
var counting = {
  valueOf() {
    calls++;
    return calls;
  },
};
log.push(sum(list(200, { 0: counting, 100: counting, 199: counting })), calls, sumAndCount(list(50, { 25: counting })), calls);

var shrinking = list(200, {});
shrinking[50] = {
  valueOf() {
    shrinking.length = 60;
    return 1000;
  },
};
log.push(sum(shrinking), shrinking.length);

var growing = list(20, {});
growing[10] = {
  valueOf() {
    if (growing.length < 40) growing.push(0.5, "tail");
    return 1;
  },
};
log.push(sum(growing), growing.length);

var holey = list(100, {});
holey[30] = {
  valueOf() {
    delete holey[31];
    holey[32] = 1.5;
    return 0;
  },
};
log.push(String(sum(holey)));

////= lines-71	sum(list(100, { 60: 1n })
////= lines-71	sum(list(100, { 60: Symbol("s") })
log.push(caught(list(100, { 10: 1n, 50: Symbol("s"), 99: "end" })), caught(plain));

var ring = [];
for (var n = 0; n < 64; n++) ring.push(unknown((n * 5 + 3) % 64));
log.push(chase(ring, 1000));
ring[17] = "18";
log.push(chase(ring, 1000));
ring[18] = 19.0;
ring[19] = 20.5;
log.push(chase(ring, 1000));
ring[19] = { toString: () => "21" };
log.push(chase(ring, 1000));
ring[21] = -1;
log.push(chase(ring, 1000));

var rows = [];
for (var r = 0; r < 30; r++) rows.push(list(30, r === 12 ? { 4: "s" } : r === 20 ? { 29: 0.5 } : {}));
log.push(nested(rows), carriedThroughBoth(rows).length);
rows[12] = list(30, {});
log.push(nested(rows), carriedThroughBoth(rows));

log.push(closures(list(100, { 41: "c" })), closures(list(100, {})));

var repeated = 0;
for (var round = 0; round < 300; round++) {
  var mixed = round % 50 === 49 ? list(40, { 20: "m" }) : plain;
  var answer = sum(mixed);
  repeated += typeof answer === "string" ? answer.length : answer;
}
log.push(repeated);

console.log(log.join("\n"));
//// loops-over-collections-with-proven-contents-reach-their-end.ts
class Key {
  constructor(public x: number) {}
}
class Value {
  constructor(public y: string) {}
}

const byKey = new Map<Key, Value>([
  [new Key(1), new Value("one")],
  [new Key(2), new Value("two")],
]);
for (const [key, value] of byKey) console.log("entries", key.x, value.y);
for (const key of byKey.keys()) console.log("keys", key.x);
for (const value of byKey.values()) console.log("values", value.y);
byKey.forEach((value, key) => console.log("forEach", key.x, value.y));

const counts = new Map<string, number>();
for (const word of ["a", "b", "a"]) counts.set(word, (counts.get(word) ?? 0) + 1);
let total = 0;
for (const [word, count] of counts) total += count * word.length;
console.log("counts", total);

const keys = new Set<Key>([new Key(3), new Key(4)]);
for (const key of keys) console.log("set", key.x);
keys.forEach(key => console.log("set forEach", key.x));

const empty = new Map<string, Value>();
for (const [name, value] of empty) console.log("never", name.length, value.y);
console.log("end");
//// lying-predicates-unbound-methods-literals-for-class-types-and-narrowing-that-a-call-undoes.ts
// What TypeScript lets through: reads past the end of an array, type predicates and assertions that lie, methods taken off their objects, literals for class types, readonly members changed through an alias, accessors behind the fields of an interface, narrowing that a call undoes, tuples that shrink.
function show(label: string, f: () => unknown) {
    try { console.log(label, String(f())); } catch (e) { console.log(label, "threw", (e as Error).constructor.name); }
}
// 8. out of bounds
show("out of bounds", () => { const a: number[] = [1, 2, 3]; const f = (i: number) => a[i] + 1; return [f(10), f(-1), f(1.5), f(2)].join(); });
show("holes", () => { const a: number[] = [1, , 3] as number[]; let t = 0; for (let i = 0; i < a.length; i++) t += a[i]; return t; });
show("string array oob", () => { const a: string[] = ["x"]; const f = (i: number) => a[i].length; return f(0) + "," + f(3); });
// 9. a lying type predicate
interface Foo { foo: number; inner: { v: number } }
function isFoo(x: unknown): x is Foo { return true; }
show("lying predicate", () => { const f = (x: unknown) => isFoo(x) ? x.foo + 1 : -1; return [f({ foo: 1, inner: { v: 1 } }), f({ bar: 1 }), f("text"), f(7)].join(); });
show("lying predicate deep", () => { const f = (x: unknown) => isFoo(x) ? x.inner.v : -1; return f({ foo: 1 }); });
function assertFoo(x: unknown): asserts x is Foo {}
show("lying assertion", () => { const f = (x: unknown) => { assertFoo(x); return x.foo * 2; }; return [f({ foo: 4, inner: { v: 1 } }), f({}), f("s")].join(); });
// 10. unbound method
class Counter { n = 1; inc() { return ++this.n; } }
show("unbound method", () => { const c = new Counter(); const m = c.inc; return m(); });
show("method on another object", () => { const c = new Counter(); const o = { n: 41.5, inc: c.inc }; return o.inc() + "," + c.n; });
show("method.call", () => Counter.prototype.inc.call({ n: "7" } as unknown as Counter));
// 11. a literal for a class type
class Point { x = 1; y = 2; norm() { return this.x * this.x + this.y * this.y; } }
function readX(p: Point) { return p.x + p.y; }
show("literal as class", () => { const p: Point = { x: 10, y: 20, norm() { return -1; } }; return [readX(p), p.norm(), p instanceof Point, readX(new Point())].join(); });
show("reordered literal as class", () => { const p: Point = { norm: () => 5, y: 20, x: 10 }; return [readX(p), p.norm()].join(); });
show("wider literal as class", () => { const w = { z: 0, y: 20.5, x: "10" as unknown as number, norm() { return 3; } }; const p: Point = w; return [readX(p), p.norm()].join(); });
// 12. readonly through a mutable alias
interface RO { readonly v: number }
show("readonly alias", () => { const m = { v: 1 }; const r: RO = m; const f = (r: RO, g: () => void) => { const a = r.v; g(); return a + r.v; }; return f(r, () => { m.v = 10; }); });
class ROClass { constructor(readonly v: number) {} }
show("readonly class", () => { const c = new ROClass(1); const f = (r: ROClass, g: () => void) => { const a = r.v; g(); return a + r.v; }; return f(c, () => { (c as { v: number }).v = 10; }); });
show("readonly array", () => { const m = [1, 2]; const r: readonly number[] = m; const f = (r: readonly number[], g: () => void) => { const a = r.length + r[0]; g(); return a + "," + r.length + "," + r[0]; }; return f(r, () => { m.unshift(9); }); });
// 18. an accessor behind a field of an interface
interface HasX { x: number }
class Acc { calls = 0; get x() { return ++this.calls; } }
class Plain { x = 100; }
function twice(h: HasX) { return h.x + h.x; }
show("accessor for field", () => [twice(new Acc()), twice(new Plain()), twice({ x: 5 }), twice({ get x() { return 7; } }), twice(Object.create({ x: 8 }) as HasX)].join());
function store(h: HasX, v: number) { h.x = v; return h.x; }
show("store to accessor", () => { let seen = 0; const o = { get x() { return seen; }, set x(v: number) { seen = v * 2; } }; return [store(o, 4), store(new Plain(), 4), store(Object.create({ x: 8 }) as HasX, 4)].join(); });
show("store to getter only", () => store(new Acc() as HasX, 4));
show("store to frozen", () => store(Object.freeze({ x: 1 }) as HasX, 4));
// 20. narrowing that a call undoes
interface Box { v?: { n: number } }
show("narrowing undone", () => { const b: Box = { v: { n: 1 } }; const clear = () => { b.v = undefined; }; if (b.v !== undefined) { clear(); return b.v.n; } return "none"; });
show("let narrowing undone", () => { let s: string | number = "text"; const change = () => { s = 5; }; if (typeof s === "string") { change(); return s.length; } return "none"; });
// 22. a discriminant changed through an alias
type Shape = { kind: "c"; r: number } | { kind: "s"; side: string };
show("discriminant alias", () => { const s: Shape = { kind: "c", r: 2 } as Shape; const any = s as any; const f = (s: Shape, g: () => void) => { if (s.kind === "c") { g(); return s.r * 2; } return s.side; }; return f(s, () => { any.kind = "s"; delete any.r; any.side = "x"; }); });
// 23. tuples
show("tuple pop", () => { const t: [number, number] = [1, 2]; t.pop(); const f = (t: [number, number]) => t[0] + t[1]; return f(t) + "," + t.length; });
show("tuple push", () => { const t: [number, string] = [1, "a"]; t.push(5); const [a, b, ...rest] = t as unknown as unknown[]; return [a, b, rest.length].join(); });
