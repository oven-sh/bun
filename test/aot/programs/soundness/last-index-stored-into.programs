////: attempt-4
function attempt(label, store, use) {
  let answer;
  try {
    store();
    answer = "no error";
  } catch (error) {
    answer = error.constructor.name;
  }
  let result;
  try {
    result = use();
  } catch (error) {
    result = error.constructor.name;
  }
  console.log(label + ": " + answer + ", then " + String(result));
}
