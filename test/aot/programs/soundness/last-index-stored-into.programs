Object.assign(proto, { a1: one });
show("Object.assign:", () => new Set().a1());
Object.defineProperties(proto, { a2: { value: one, configurable: true } });
show("Object.defineProperties:", () => new Set().a2());
Reflect.set(proto, "a3", one);
show("Reflect.set:", () => new Set().a3());
Reflect.defineProperty(proto, "a4", { get() { return "got 4"; }, configurable: true });
show("Reflect.defineProperty:", () => new Set().a4);
proto.__defineGetter__("a5", function () { return "got 5"; });
show("__defineGetter__:", () => new Set().a5);
[["a6", one]].forEach(([key, value]) => { proto[key] = value; });
show("in a callback:", () => new Set().a6());
Reflect.apply(Object.defineProperty, null, [proto, "a7", { value: one, configurable: true }]);
show("Reflect.apply:", () => new Set().a7());
util._extend(proto, { a8: one });
show("util._extend:", () => new Set().a8());
EventEmitter.call(proto);
show("EventEmitter.call:", () => typeof new Set()._events);
console.log("after:", all());
console.log(new Set([1]));
//// new-names-on-built-ins-held-as-values-nobody-can-follow-validated.mjs
// The program puts new names on built-in objects that it holds as values nobody can follow: out of evaluated text, or back from native code. The run time refuses no new name,
// so compiled code that reads the name off the built-in finds what was put there.
const glue = (first, second) => [first, second].join(process.argv.length > 99 ? "x" : "");
const evaluate = text => new Function(glue(text, ""))();
const unknown = value => new CustomEvent("unknown", { detail: value }).detail;
function twice(read) {
  let sum = 0;
  for (let round = 0; round < 2; round++) sum += read();
  return sum;
}
evaluate("return []").constructor.extra = 5;
console.log("a constructor, through an instance:", Array.extra, twice(() => Array.extra));
const set = evaluate("return new Set()");
Object.getPrototypeOf(set).extra = 6;
console.log("a prototype:", new Set().extra, twice(() => new Set().extra));
Object.getPrototypeOf(set)[glue("ex", "tra2")] = 7;
console.log("a prototype, under a computed key:", new Set().extra2, twice(() => new Set().extra2));
unknown(Math).extra = 8;
console.log("a namespace:", Math.extra, twice(() => Math.extra));
unknown(Error.prototype).code = 9;
console.log("Error.prototype:", new RangeError("r").code, twice(() => new RangeError("r").code));
unknown(Array.prototype).last = 10;
console.log("Array.prototype:", [].last, twice(() => [].last));
unknown(String.prototype).red = 11;
console.log("String.prototype:", "s".red, twice(() => "s".red));
//// new-target-of-a-built-in-constructor-arrives-late.js
// new.target of a built-in constructor arrives late: first a subclass, then the built-in itself, then another subclass.
function main() {
class Keyed extends Map { tag() { return "keyed"; } }
class Other extends Map { tag() { return 2; } }
let target = Keyed;
const order = [];
function step(made) {
  order.push(made instanceof Keyed ? made.tag() : made instanceof Other ? made.tag() + 1 : typeof made.tag);
  target = target === Keyed ? Map : Other;
}
for (let i = 0; i < 3; i++) {
  const made = Reflect.construct(Map, [[[1, { v: i }]]], target);
  step(made);
  console.log(made.get(1).v, made.size);
}
console.log(order.join());

class Rows extends Array { first() { return this[0]; } }
class Columns extends Array { first() { return "column " + this[0]; } }
function make(C, x) { return new C(x, x); }
let made = make(Rows, 1);
console.log(made.first(), made.length);
function again() { made = make(Columns, "c"); }
[1].forEach(again);
console.log(made.first(), made.length);
}
main();
//// numbers-given-for-enums-fields-read-before-their-initializers-and-covariant-arrays.ts
// What TypeScript lets through: a fraction, 2 ** 40 and NaN for a numeric enum, fields read by an overridden method before they are initialized, fields that are never assigned, covariant arrays, bivariant methods, an optional alias of a required field.
function show(label: string, f: () => unknown) {
    try { console.log(label, String(f())); } catch (e) { console.log(label, "threw", (e as Error).constructor.name); }
}
// 1. number into a numeric enum
enum E { A, B, C }
enum Flags { None = 0, X = 1, Y = 2, Z = 4 }
function addQuarter(e: E) { return e + 0.25; }
function orFlags(a: Flags, b: Flags): Flags { return a | b; }
function keep(e: E): E { return e; }
class HoldsEnum { e: E = E.A; f: Flags = Flags.None; constructor(e: E, f: Flags) { this.e = e; this.f = f; } }
const argc: number = process.argv.length; // 2 under plain, 1 or 2 compiled: not printed
const half: number = Math.min(argc, 0) + 2.5;
const big: number = Math.min(argc, 0) + 2 ** 40;
const nan: number = Math.min(argc, 0) / 0;
show("enum half", () => addQuarter(half));
show("enum big", () => addQuarter(big));
show("enum nan", () => addQuarter(nan));
show("enum keep", () => [keep(half), keep(big), keep(nan), keep(-0 as number)].map(x => Object.is(x, -0) ? "-0" : x).join());
show("enum field", () => { const h = new HoldsEnum(half, big); return h.e + "," + h.f + "," + (h.e * 2) + "," + (h.f + 1); });
show("enum array", () => { const a: E[] = [E.A, E.B]; a.push(half); a.push(big); return a.join() + "|" + a.map(x => x + 1).join(); });
show("flags", () => orFlags(half, Flags.Z) + "," + orFlags(big + 1, Flags.Y));
show("enum switch", () => { const f = (e: E) => { switch (e) { case E.A: return "A"; case E.B: return "B"; case E.C: return "C"; default: return "other " + e; } }; return [f(half), f(big), f(1), f(nan)].join(); });
show("enum index", () => { const names = ["a", "b", "c"]; const f = (e: E) => names[e]; return [f(half), f(big), f(2), f(-1 as number)].join(); });
show("enum reverse", () => [E[half], E[1], E[big]].join());

// 2. a base constructor calls an overridden method that reads fields of the derived class
class Base { log: string[] = []; constructor() { this.init(); } init() { this.log.push("base"); } }
class Derived extends Base {
    n: number = 5; s: string = "s"; b: boolean = true; o: { v: number } = { v: 1 }; a: number[] = [1]; i: number = 7;
    init() { this.log.push([this.n, this.s, this.b, this.o, this.a, typeof this.i].join("/")); this.log.push(String(this.n + 1)); }
}
show("fields before init", () => new Derived().log.join(";"));
class Derived2 extends Base {
    o: { v: number } = { v: 1 };
    init() { try { this.log.push(String(this.o.v)); } catch (e) { this.log.push("threw " + (e as Error).constructor.name); } }
}
show("object field before init", () => new Derived2().log.join(";"));

// 3. definite assignment that never happens
class Never { x!: number; y!: string; z!: { v: number }; w!: boolean; sum() { return this.x + 1; } }
show("never assigned", () => { const n = new Never(); return [n.x, n.y, n.z, n.w, n.sum(), "x" in n, Object.keys(n).join("+")].join(); });
class Declared { declare x: number; y = 1; }
show("declared field", () => { const d = new Declared(); return [d.x, "x" in d, Object.keys(d).join("+")].join(); });

// 4. array covariance
class Animal { name = "animal"; }
class Dog extends Animal { bark() { return "woof " + this.tricks; } tricks = 3; }
class Cat extends Animal { lives = 9; }
show("covariant array", () => { const dogs: Dog[] = [new Dog()]; const animals: Animal[] = dogs; animals.push(new Cat()); return dogs.map(d => { try { return d.tricks + ":" + d.bark(); } catch (e) { return "threw " + (e as Error).constructor.name; } }).join(); });
show("covariant numbers", () => { const n: number[] = [1, 2]; const u: (number | string)[] = n; u.push("three"); let t = 0 as number | string; for (const x of n) t = (t as number) + x; return t; });

// 5. bivariant method parameters
interface Handler { handle(a: Animal): string }
show("bivariant method", () => { const h: Handler = { handle(d: Dog) { return String(d.tricks * 2); } }; return h.handle(new Cat()) + "," + h.handle(new Dog()); });

// 6. optional alias
show("optional alias", () => { const strict: { a: number; b: number } = { a: 1, b: 2 }; const loose: { a?: number; b: number } = strict; loose.a = undefined; const r1 = strict.a + 1; delete loose.a; return r1 + "," + (strict.a + 1) + "," + Object.keys(strict).join("+"); });
//// object-frozen-in-the-middle-of-a-loop-refuses-the-stores-that-follow.js
// An object is frozen at iteration 150 of a loop that stores to it. Nothing reads the property: every store from then on throws.
"use strict";
const print = text => console.log(text);
let count = 0;
let trail = "";
////= note-2
////= A
////= make
function run() {
  let seen, before, line;
  const o = make();
  let last = "";
  for (let i = 0; i < 300; i++) {
    if (i === 150) {
      try {
        Object.freeze(o);
      } catch (e) {
        note("the change threw " + e.name);
      }
    }
    before = count;
    try {
      o.k = 5;
      seen = "stored";
    } catch (e) {
      seen = "threw " + e.name;
    }
    line = seen + " | " + (count - before) + " " + trail;
    trail = "";
    if (line !== last) {
      print(i + ": " + line);
      last = line;
    }
  }
}
////= lines
print("end: " + count + " " + trail);
