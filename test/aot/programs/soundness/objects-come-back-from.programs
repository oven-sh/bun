  for (const k of Object.keys(row)) target[k] = row[k];
  return target;
}
function fromRowIn(row, i) {
  const target = record(i);
  for (const k in row) target[k] = row[k];
  return target;
}
function fromEntries(row, i) {
  const target = record(i);
  for (const [k, v] of Object.entries(row)) target[k] = v;
  return target;
}
function named(i) {
  const target = record(i);
