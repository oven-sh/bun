say("json parsed twenty deep in revivers", () => { function p(n) { return JSON.parse('[1,2]', (k, v) => (k === '0' && n ? p(n - 1).length : v)); } return JSON.stringify(p(20)); });
say("json of depth 5000", () => { const t = '['.repeat(5000) + ']'.repeat(5000); let v = JSON.parse(t), d = 0; while (v.length) { v = v[0]; d++; } return d; });
say("json of 300000 objects", () => { const a = []; for (let i = 0; i < 300000; i++) a.push({ id: i, name: 'n' + i, ok: i % 2 === 0 }); const b = JSON.parse(JSON.stringify(a)); let t = 0; for (const o of b) t += o.id + o.name.length + (o.ok ? 1 : 0); return t; });
say("object with 300 nested levels", () => { let o = { v: 0 }; for (let i = 1; i < 300; i++) o = { v: i, inner: o }; let t = 0; for (let p = o; p; p = p.inner) t += p.v; return t + ',' + JSON.stringify(o).length; });
