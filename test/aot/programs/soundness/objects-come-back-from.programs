//// objects-come-back-from-built-ins-under-another-name-8.js
// An object goes into a built-in and comes out under another name: a store through that name is seen by reads through the first. Each case has a class, an allocation and a store of its own.
const id = x => x;
class Cell175 { constructor(n) { this.n = n; this.list = [1, 2]; } twice() { return this.n * 2; } total() { let s = 0; for (let i = 0; i < this.list.length; i++) s += this.list[i]; return s; } }
{
  const c = new Cell175(21);
  const before = c.twice() + c.total();
  const done = o => { if (o === null || typeof o !== "object") return console.log('deepEquals', "gave", typeof o); o.n = "x"; o.list.push("y"); console.log('deepEquals', before, String(c.twice()), typeof c.n, c.total()); };
  try { const out = (c => (Bun.deepEquals(c, c), c))(c); if (out instanceof Promise) out.then(done, e => console.log('deepEquals', "rejected", String(e))); else done(out); } catch (e) { console.log('deepEquals', "threw", e.name); }
}
//// objects-come-out-of-array-from-iterator-from-and-promises.js
// What goes into Array.from, a typed array from, Iterator.from, for await over a synchronous iterable and the functions of Promise comes out as the object that went in.
const rows = [];
function say(label, value) { rows.push(label + ": " + value); }
function one(n) { return n + 1; }
function two(n) { return n + 2; }
class Point { constructor(x) { this.x = x; } }

// Array.from, with and without a map function, over every kind of source
const fromArray = Array.from([new Point(1), new Point(2)]);
say("from array", fromArray[1].x + " " + fromArray.length);
const fromSet = Array.from(new Set([one, two]));
say("from set", fromSet[1](1));
const fromMap = Array.from(new Map([["k", new Point(3)]]));
say("from map", fromMap[0][0] + fromMap[0][1].x);
const fromString = Array.from("ab");
say("from string", fromString[1].toUpperCase());
const fromLike = Array.from({ length: 2, 0: new Point(4), 1: new Point(5) });
say("from array-like", fromLike[1].x);
const fromHoles = Array.from([, new Point(6)]);
say("from holes", fromHoles[0] + " " + fromHoles[1].x);
function* gen() { yield new Point(7); yield new Point(8); }
say("from generator", Array.from(gen())[1].x);
say("from iterator object", Array.from({ [Symbol.iterator]() { let i = 0; return { next: () => ({ done: i++ > 1, value: new Point(i) }) }; } }).map(p => p.x).join());
class Mine extends Array {}
const mine = Mine.from([new Point(9)]);
say("subclass from", (mine instanceof Mine) + " " + mine[0].x);
say("from with this", Array.from.call(function (n) { this.made = n; }, [1, 2]).made + "");
say("from mapped", Array.from([1, 2], v => new Point(v))[1].x);

// typed arrays
const bytes = Uint8Array.from([1, 2, 300]);
say("typed from", bytes[2] + " " + bytes.length);
say("typed from set", Float64Array.from(new Set([1.5, 2.5]))[1]);
say("typed from typed", Int16Array.from(bytes)[1]);
say("typed from like", Uint8Array.from({ length: 2, 0: 7, 1: 8 })[1]);
say("typed from mapped", Uint8Array.from([1, 2], v => v * 2)[1]);
say("typed from objects", Uint8Array.from([{ valueOf() { return 5; } }])[0]);

// Iterator.from: a wrapper around an iterator that is no Iterator
const wrapped = Iterator.from({ next() { return { done: false, value: new Point(10) }; }, return() { return { done: true, value: "closed" }; } });
const step = wrapped.next();
say("wrapped next", typeof step + " " + step.done + " " + step.value.x);
say("wrapped return", wrapped.return().value);
say("wrapped take", wrapped.take(2).toArray().map(p => p.x).join());
say("from an Iterator", Iterator.from([one, two].values()).next().value(1));
say("from a string", Iterator.from("xy").toArray().join());

// for await over a synchronous iterable
async function overSync() {
  let text = "";
  for await (const p of [new Point(11), Promise.resolve(new Point(12))]) text += p.x + ",";
  for await (const f of new Set([one, two])) text += f(1) + ",";
  for await (const p of gen()) text += p.x + ",";
  return text;
}
say("for await over sync", await overSync());
async function* delegating() { yield* [new Point(13), new Point(14)]; yield* gen(); }
let delegated = "";
for await (const p of delegating()) delegated += p.x + ",";
say("yield* of sync in async generator", delegated);

// promises
say("resolve", (await Promise.resolve(new Point(15))).x);
say("resolve thenable", (await Promise.resolve({ then(r) { r(new Point(16)); } })).x);
say("all", (await Promise.all([new Point(17), Promise.resolve(new Point(18))]))[1].x);
say("allSettled", (await Promise.allSettled([Promise.reject(new Point(19)), new Point(20)])).map(r => r.status + (r.value ?? r.reason).x).join());
say("race", (await Promise.race([new Point(21)])).x);
say("any", (await Promise.any([Promise.reject(1), new Point(22)])).x);
say("then chain", await Promise.resolve(one).then(f => f(1)).then(n => two(n)));
say("finally", (await Promise.resolve(new Point(23)).finally(() => new Point(0))).x);
say("withResolvers", await (() => { const { promise, resolve } = Promise.withResolvers(); resolve(new Point(24)); return promise.then(p => p.x); })());
say("try", (await Promise.try(() => new Point(25))).x);
say("fromAsync", (await Array.fromAsync([Promise.resolve(new Point(26))]))[0].x);
console.log(rows.join("\n"));
//// objects-in-native-code-get-members-and-prototypes-late.js
// An object reaches code nobody sees first. What it holds arrives later, in a function that is found late: a method, a value in a field, an accessor, a prototype, an object behind a property.
function show(...parts) { let text = ""; for (let i = 0; i < parts.length; i++) text += (i ? " | " : "") + String(parts[i]); console.log(text); }
let stash;
const box = new Proxy({}, { set(target, key, value) { stash = value; return true; }, get() { return stash; } });
function hide(value) { box.kept = value; return box.kept; }
// `seen` is undefined at run time: the field is read through a leak of `this` before its store. An analysis learns that late, and only then finds the member `undefined`.
class Leaking { constructor() { leak(this); this.key = "early"; } }
let seen;
function leak(o) { seen = o.key; }
new Leaking();

// 1: a method in a property that is added late
{ const o = { a: 1 }; const u = hide(o); const table = { early() {}, undefined() { o.m = function (x) { return typeof x; }; } }; table[seen](); show("1", u.m("s"), u.m(1), u.m()); }
// 2: a function in a field that held null
{ const o = { callback: null }; const u = hide(o); const table = { early() {}, undefined() { o.callback = function (x) { return typeof x; }; } }; table[seen](); show("2", u.callback("s"), u.callback(1)); }
// 3: the store through the hidden value is seen first, the object is hidden late
{ const o = { a: 1 }; function setA(t) { t.a = "s"; } setA(hide({ a: 2 })); const table = { early() { return { a: 3 }; }, undefined() { return hide(o); } }; setA(table[seen]()); show("3", typeof o.a, o.a); }
// 4: an accessor defined late
{ let hits = 0; const o = { a: 1 }; const u = hide(o);
  const table = { early() {}, undefined() { Object.defineProperty(o, "g", { get() { hits++; return typeof this.a; }, set(v) { hits += 10; this.a = v; } }); } }; table[seen]();
  show("4a", u.g, hits); u.g = "s"; show("4b", u.g, hits, typeof o.a); }
// 5: the prototype is set late, and changed through the hidden value
{ const proto = { tag: 1 }; const o = {}; const u = hide(o); const table = { early() {}, undefined() { Object.setPrototypeOf(o, proto); } }; table[seen]();
  Object.getPrototypeOf(u).tag = "s"; show("5", typeof proto.tag, typeof o.tag); }
// 6: the prototype is changed through a value that is hidden late
{ const o = { a: 1 }; function reparent(t) { Object.setPrototypeOf(t, { m() { return "inherited"; } }); } reparent(hide({}));
  const table = { early() { return {}; }, undefined() { return hide(o); } }; reparent(table[seen]()); show("6", typeof o.m, o.m ? o.m() : "none"); }
// 7: an object behind a property that is filled late
{ const inner = { v: 1 }; const outer = { inner: null }; const u = hide(outer); const table = { early() {}, undefined() { outer.inner = inner; } }; table[seen](); u.inner.v = "s"; show("7", typeof inner.v); }
// 8: the constructor is reached through an instance that is hidden late
{ class A { constructor(v) { this.v = v; } get() { return typeof this.v; } } const a = new A(1); const table = { early() { return a; }, undefined() { return hide(a); } };
  const b = new (table[seen]().constructor)("s"); show("8", a.get(), b.get(), b instanceof A); }
// 9: a static field through a class that is hidden late
{ class S { static s = 1; static get() { return typeof S.s; } } const table = { early() { return { s: 0 }; }, undefined() { return hide(S); } }; table[seen]().s = "s"; show("9", S.get(), typeof S.s); }
//// objects-of-one-class-lose-their-shape.js
// Objects of a proven layout lose their shape in every way the language has.
class P { constructor() { this.x = 1; this.y = 2; this.z = 3; } sum() { return this.x + this.y + this.z; } }
const t = (name, f) => { const p = new P(); let r; try { r = f(p); } catch (e) { r = e.name; } console.log(name, r, String(p.sum()), Object.keys(p).join(), JSON.stringify(Object.getOwnPropertyDescriptor(p, "y") || null)); };
t("delete", p => delete p.y); t("delete add", p => { delete p.x; p.x = 9; });
t("accessor", p => { Object.defineProperty(p, "y", { get() { return 20; }, configurable: true, enumerable: true }); });
t("setter only", p => { Object.defineProperty(p, "y", { set(v) { this.x = v; }, configurable: true }); p.y = 50; });
t("non writable", p => { Object.defineProperty(p, "y", { writable: false }); p.y = 50; });
t("non enumerable", p => { Object.defineProperty(p, "y", { enumerable: false }); });
t("freeze", p => { Object.freeze(p); p.y = 50; p.w = 1; delete p.x; return Object.isFrozen(p); });
t("seal", p => { Object.seal(p); p.y = 50; p.w = 1; delete p.x; return Object.isSealed(p); });
t("prevent", p => { Object.preventExtensions(p); p.w = 1; p.y = 5; return Object.isExtensible(p); });
t("strict frozen", p => { "use strict"; Object.freeze(p); p.y = 50; });
t("many", p => { for (let i = 0; i < 300; i++) p["k" + i] = i; for (let i = 0; i < 300; i++) delete p["k" + i]; });
t("index", p => { p[0] = "i"; p[1000000] = "j"; return p[0] + p[1000000]; });
t("symbol", p => { const s = Symbol(); p[s] = 1; return Object.getOwnPropertySymbols(p).length; });
t("define props", p => { Object.defineProperties(p, { x: { value: "dx" }, q: { value: 1, enumerable: true } }); });
t("reflect define", p => Reflect.defineProperty(p, "z", { value: "rz" }));
t("reflect delete", p => Reflect.deleteProperty(p, "z"));
t("legacy getter", p => { p.__defineGetter__("y", () => 7); });
t("assign", p => { Object.assign(p, { y: "ay", n: 1 }); });
t("proto accessor", p => { Object.defineProperty(P.prototype, "late", { set(v) { this.x = v; }, configurable: true }); p.late = 77; delete P.prototype.late; });
t("proto shadows", p => { delete p.y; P.prototype.y = 1000; const r = p.sum(); delete P.prototype.y; return r; });
t("proto readonly", p => { Object.defineProperty(P.prototype, "w", { value: 1, writable: false, configurable: true }); p.w = 2; const r = p.w; delete P.prototype.w; return r; });
t("structured", p => JSON.stringify(structuredClone(p)));
t("entries", p => Object.entries(p).map(e => e.join("=")).join());
t("spread", p => { const q = { ...p, y: undefined }; return q.x + q.y; });
t("with proxy", p => { const q = new Proxy(p, { set(o, k, v) { o[k] = v + 1; return true; } }); q.y = 1; return q.sum(); });
t("swap values", p => { [p.x, p.y] = [p.y + "", p.x]; });
t("nan", p => { p.x = NaN; p.y = -0; p.z = undefined; return Object.is(p.y, -0); });
//// objects-of-the-program-stand-in-the-prototype-chains-of-classes.js
// Objects that no class made stand in prototype chains: above the prototype object of a constructor function, between two of them, between an instance and its class. They get names, accessors and other parents late.
const Unknown = structuredClone({}).constructor;
function hide(x) { return Unknown(x); }
function show(...parts) { console.log(parts.map(String).join(" | ")); }
function attempt(f) { try { return f(); } catch (error) { return error.constructor.name; } }
const log = [];

// 1: the parent of the prototype object is an object of the program. The constructor creates its fields under it.
{
  const shared = { kind: "shared" };
  function Point(x) { this.a = x; this.b = x + 1; this.c = x + 2; }
  Point.prototype = Object.create(shared);
  Point.prototype.sum = function () { return this.a + this.b + this.c; };
  hide(Point);
  function run(n) { let total = 0; for (let i = 0; i < n; i++) { const p = new Point(i); total += p.sum() + Object.keys(p).length; } return total; }
  show("1a", run(300), new Point(1).kind);
  Object.defineProperty(hide(shared), "b", { set(v) { log.push("1 set b " + v); }, get() { return 100; }, configurable: true });
  show("1b", run(3), Object.keys(new Point(1)).join(), log.length);
  delete hide(shared).b;
  show("1c", run(3), Object.keys(new Point(1)).join());
  Object.defineProperty(hide(shared), "c", { value: 7, writable: false, configurable: true });
  show("1d", attempt(() => run(3)), attempt(() => Object.keys(new Point(1)).join()));
  delete hide(shared).c;
  hide(shared).sum = function () { return -1; };
  show("1e", run(3));
  delete hide(Point.prototype).sum;
  show("1f", run(3));
}

// 2: an object of the program between the prototype objects of two constructor functions.
{
  function Base() { this.events = 0; }
  Base.prototype.on = function () { this.events++; return this; };
  Base.prototype.name = function () { return "base"; };
  function Stream(size) { Base.call(this); this.size = size; this.ended = false; }
  const between = Object.create(Base.prototype);
  Object.setPrototypeOf(Stream.prototype, between);
  Stream.prototype.end = function () { this.ended = true; return this.on(); };
  hide(Stream); hide(Base);
  function run(n) { let total = 0; for (let i = 0; i < n; i++) { const s = new Stream(i).end().on(); total += s.events + s.name().length + Object.keys(s).length; } return total; }
  show("2a", run(300));
  hide(between).name = function () { return "between"; };
  show("2b", run(3), new Stream(1).name());
  hide(Base.prototype).on = function () { this.events += 10; return this; };
  show("2c", run(3));
  Object.defineProperty(hide(between), "size", { set(v) { log.push("2 set size " + v); }, configurable: true });
  show("2d", run(3), Object.keys(new Stream(4)).join(), log.length);
  Object.setPrototypeOf(hide(between), { on() { this.events += 100; return this; }, name() { return "other parent"; } });
  show("2e", run(3), new Stream(1) instanceof Base);
}

// 3: each instance gets a prototype of the application, which leads back to the class.
{
  function Emitter() { this.count = 0; }
  Emitter.prototype.emit = function (n) { this.count += n; return this.count; };
  function Incoming(url) { Emitter.call(this); this.url = url; this.complete = false; }
  Object.setPrototypeOf(Incoming.prototype, Emitter.prototype);
  Incoming.prototype.header = function (name) { return name + "@" + this.url; };
  hide(Incoming); hide(Emitter);
  const library = Object.create(Incoming.prototype);
  library.get = function (name) { return this.header(name).length; };
  const application = Object.create(library);
  function handle(i) {
    const request = new Incoming("/" + i);
    Object.setPrototypeOf(request, application);
    request.next = i; request.params = null; request.route = "r";
    return request.get("host") + request.emit(2) + request.header("a").length + Object.keys(request).length;
  }
  function run(n) { let total = 0; for (let i = 0; i < n; i++) total += handle(i % 10); return total; }
  show("3a", run(300), new Incoming("x") instanceof Incoming, Object.setPrototypeOf(new Incoming("y"), application) instanceof Emitter);
  hide(application).header = function (name) { return name; };
  show("3b", run(3), new Incoming("z").header("h"));
  Object.defineProperty(hide(library), "params", { set(v) { log.push("3 set params " + v); }, get() { return "from library"; }, configurable: true });
  show("3c", run(3), log.length);
  hide(application).emit = function () { return 1000; };
  show("3d", run(3), new Incoming("z").emit(1));
  Object.setPrototypeOf(hide(library), { header() { return "cut off"; }, emit() { return 5; } });
  show("3e", run(3), Object.setPrototypeOf(new Incoming("y"), application) instanceof Incoming);
}

// 4: the same with classes, and one object hides a method under a key that arrives late.
{
  class Shape { constructor(w) { this.w = w; } area() { return this.w * this.w; } get twice() { return this.w * 2; } }
  class Box extends Shape { constructor(w, h) { super(w); this.h = h; } area() { return this.w * this.h; } label() { return "box" + this.area(); } }
  hide(Shape); hide(Box);
  function measure(o) { return o.area() + o.twice + o.label().length; }
  function run(list, n) { let total = 0; for (let i = 0; i < n; i++) total += measure(list[i % list.length]); return total; }
  const boxes = [new Box(1, 2), new Box(2, 3), new Box(3, 4)];
  show("4a", run(boxes, 300));
  hide(boxes[1])[hide(["area"])[0]] = function () { return 1; };
  show("4b", run(boxes, 3), Object.keys(boxes[1]).join());
  Object.defineProperty(hide(boxes[2]), "twice", { get() { return -1; }, configurable: true });
  show("4c", run(boxes, 3));
  const custom = Object.create(Box.prototype);
  Object.setPrototypeOf(boxes[0], hide(custom));
  show("4d", run(boxes, 3), boxes[0] instanceof Box);
  custom.label = function () { return "custom"; };
  show("4e", run(boxes, 3));
  Object.setPrototypeOf(boxes[0], null);
  show("4f", attempt(() => measure(boxes[0])), boxes[0] instanceof Box, boxes[0].w);
}

// 5: a method is assigned to the prototype object after an instance got a prototype that has the name already.
{
  function Late(v) { this.v = v; }
  hide(Late);
  const early = new Late(1);
  Object.setPrototypeOf(early, hide(Object.create(Late.prototype, { read: { value() { return "mine " + this.v; }, configurable: true, writable: true } })));
  Late.prototype.read = function () { return "class " + this.v; };
  function read(o) { return o.read(); }
  const list = [new Late(2), early, new Late(3)];
  const answers = new Set();
  for (let i = 0; i < 300; i++) answers.add(read(list[i % 3]));
  show("5", [...answers].join(), early instanceof Late);
}

// 6: an object that is constructed for a function nobody knows inherits from what that function names.
{
  class Task { constructor(id) { this.id = id; this.done = false; } finish() { this.done = true; return this.id; } describe() { return "task " + this.id; } }
  hide(Task);
  function Special() {}
  Special.prototype = Object.create(Task.prototype);
  Special.prototype.describe = function () { return "special " + this.id; };
  function run(n) {
    let text = "";
    for (let i = 0; i < n; i++) {
      const task = i % 3 ? new Task(i) : Reflect.construct(Task, [i], hide(Special));
      text = task.describe() + "/" + task.finish() + "/" + Object.keys(task).length;
    }
    return text;
  }
  show("6a", run(299), run(300), run(301));
  hide(Special.prototype).finish = function () { return "never"; };
  show("6b", run(299), run(300), run(301));
}
show("log", log.join("; "));
//// objects-that-borrow-the-iterator-of-arrays-beside-arrays-and-strings.js
// A loop goes over arrays, strings, a String object and objects that only borrow Array.prototype[Symbol.iterator].
// Each receiver is iterated by the method that it finds itself, and what the steps hand out is what it holds.
class Row {
  constructor(id) {
    this.id = id;
  }
}

class Shelf {
  constructor(...rows) {
    this.length = rows.length;
    rows.forEach((row, index) => (this[index] = row));
  }
}
Shelf.prototype[Symbol.iterator] = Array.prototype[Symbol.iterator];

const borrowed = { 0: new Row(7), 1: new Row(8), length: 2, [Symbol.iterator]: Array.prototype.values };

function describe(value) {
  return value instanceof Row ? `row ${value.id}` : `${typeof value} ${String(value)}`;
}

function list(iterable) {
  const seen = [];
  for (const value of iterable) seen.push(describe(value));
  return seen;
}

function first([value]) {
  return describe(value);
}

const iterables = [[new Row(1), new Row(2)], "ab", new String("cd"), new Shelf(new Row(3), new Row(4)), borrowed, new Set([new Row(5)]), new Map([[new Row(6), 1]]).keys()];
for (const iterable of iterables) console.log(JSON.stringify(list(iterable)), first(iterable), JSON.stringify([...iterable].map(describe)));

Promise.all([new Row(9)]).then(([row]) => console.log(describe(row), row.id));
//// objects-under-objects-hide-setters.js
const log = [];
const top = { set x(v) { log.push("top setter " + v); }, get x() { return "top"; } };
