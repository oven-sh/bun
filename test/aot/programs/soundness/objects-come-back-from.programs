//// server-fetch-reads-its-options.ts
// server.fetch(url, options) reads method, headers and body of its second operand, which runs the getters and conversions of the program.
let gettersRun = 0;
let conversionsRun = 0;

const server = Bun.serve({
  port: 0,
  async fetch(request) {
    return new Response(`${request.method} ${request.headers.get("x-from-init")} ${await request.text()}`);
  },
});

const init = {
  get method() {
    gettersRun++;
    return {
      toString() {
        conversionsRun++;
        return "POST";
      },
    };
  },
  get headers() {
    gettersRun++;
    return { "x-from-init": "yes" };
  },
  get body() {
    gettersRun++;
    return "the body";
  },
};

type FetchWithInit = (url: string, init: object) => Promise<Response>;
const response = await (server.fetch as FetchWithInit).call(server, "/path", init);
console.log(await response.text());
console.log(gettersRun, conversionsRun);
server.stop(true);
//// setter-defined-over-a-data-property-reads-undefined.js
function read(o) {
  return o.a + o.b;
}

const literal = { a: 1, b: 2, set a(v) {} };
console.log(read(literal), typeof literal.a);

const later = { a: 1, b: 2 };
later.__defineSetter__("a", () => {});
console.log(read(later), typeof later.a);

function make(n) {
  return { a: n, b: 2 };
}
const list = [make(1), make(2), make(3)];
list[1].__defineSetter__("a", () => {});
console.log(list.map(read).join());

const holder = { a: 1.5, b: { x: 1 } };
holder.__defineSetter__("b", () => {});
try {
  console.log(holder.b.x);
} catch (e) {
  console.log("threw", e instanceof TypeError);
}

const both = { a: 1, b: 2 };
both.__defineGetter__("a", () => "g");
both.__defineSetter__("a", () => {});
console.log(read(both), typeof both.a);
//// setter-planted-between-two-instances-runs-for-the-second-constructor.js
// A setter is defined on the prototype between two constructions. Nothing reads the property: the store in the second constructor runs the setter.
"use strict";
const print = text => console.log(text);
let count = 0;
let trail = "";
////= note-2
class A {
  constructor() {
    this.a = 1;
    this.k = 2;
    this.z = 3;
  }
  m() {
    return "m";
  }
}
////= make
function run() {
  let seen, before, line;
  const first = make();
  before = count;
  try {
    make();
    seen = "made";
  } catch (e) {
    seen = "threw " + e.name;
  }
  line = seen + " | " + (count - before) + " " + trail;
  trail = "";
  print("first before" + ": " + line);
  try {
    Object.defineProperty(A.prototype, "k", {
      set(v) {
        note("set " + str(v));
      },
      enumerable: true,
      configurable: true,
    });
  } catch (e) {
    note("the change threw " + e.name);
  }
  const second = make();
  before = count;
  try {
    make();
    seen = "made";
  } catch (e) {
    seen = "threw " + e.name;
  }
  line = seen + " | " + (count - before) + " " + trail;
  trail = "";
  print("second" + ": " + line);
  before = count;
  try {
    make();
    seen = "made";
  } catch (e) {
    seen = "threw " + e.name;
  }
  line = seen + " | " + (count - before) + " " + trail;
  trail = "";
  print("first after" + ": " + line);
}
////= lines
print("end: " + count + " " + trail);
//// setter-without-getter-runs-on-an-instance-that-escaped.js
// A store under the name of a setter that has no getter runs the setter, also on an instance that a host function has seen.
let count = 0;
let last;

class InConstructor { constructor() { this.x = 1; } set x(v) { count++; last = v; } }
const a = new InConstructor();
console.log(a);
console.log(count, last, Object.keys(a).join(), "x" in a, a.x);

class Outside { set x(v) { count++; last = v; } }
const b = new Outside();
console.log(b);
console.log("x" in b, Object.hasOwn(b, "x"));
b.x = "stored";
console.log(count, last, Object.keys(b).join(), "x" in b, Object.hasOwn(b, "x"), b.x);

class Base { set x(v) { count++; last = v; } }
class Derived extends Base { constructor() { super(); this.x = 3; } }
const c = new Derived();
console.log(c);
console.log(count, last, Object.keys(c).join());

class Both { constructor() { this.x = 4; } get x() { return "from getter"; } set x(v) { count++; last = v; } }
const d = new Both();
console.log(d);
console.log(count, last, Object.keys(d).join(), d.x);

class NeverEscapes { constructor() { this.x = 5; } set x(v) { count++; last = v; } }
const e = new NeverEscapes();
console.log(count, last, Object.keys(e).join());

class Plain { constructor() { this.x = 6; } }
const f = new Plain();
console.log(f);
console.log(count, Object.keys(f).join(), f.x + 1);

setTimeout((o) => { o.x = "late"; console.log(count, last, Object.keys(o).join(), Object.keys(b).join()); }, 0, b);
//// sizes-at-which-representations-change.js
// Each case pushes one thing past a size at which the compiler or the run time changes its representation.
const out = []; const say = (name, f) => { let r; try { r = f(); } catch (e) { r = 'threw ' + e.name; } console.log(name + ': ' + String(r)); };
say("instance with 70000 computed keys", () => { class C { constructor() { this.first = 1; } mark(v) { this.late = v; return this.first + this.late; } } const o = new C(); for (let i = 0; i < 70000; i++) o['k' + i] = i; return o.mark(2) + ',' + o.k69999 + ',' + Object.keys(o).length + ',' + o.late; });
say("literal with 200000 computed keys", () => { const d = { a: 1 }; for (let i = 0; i < 200000; i++) d['k' + i] = i; for (let i = 0; i < 200000; i += 2) delete d['k' + i]; let t = 0; for (const k in d) t += d[k]; return t + ',' + Object.keys(d).length + ',' + d.a; });
say("instance with 5000 symbol keys", () => { class C { x = 1; } const o = new C(), ss = []; for (let i = 0; i < 5000; i++) { const y = Symbol(i); ss.push(y); o[y] = i; } return o[ss[4999]] + o.x + ',' + Object.getOwnPropertySymbols(o).length; });
say("instance with 100000 index keys", () => { class C { x = 1; } const o = new C(); for (let i = 0; i < 100000; i++) o[i] = i; return o[99999] + o.x + ',' + Object.keys(o).length; });
say("instance with one huge index key", () => { class C { x = 1; } const o = new C(); o[4294967294] = 1; o[4294967295] = 2; o[2147483648] = 3; return Object.keys(o).join() + ',' + o.x; });
