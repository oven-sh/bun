// Parsed data is copied key by key onto literal objects. Another object of the same layout gets one of the names by a direct store, with another type.
const input = JSON.parse('{"late": 5, "x": "seven", "other": [1, 2]}');
////= record
function copyOnto(target, source) {
  for (const k of Object.keys(source)) target[k] = source[k];
  return target;
}
function describe(o) {
  return typeof o.late + ":" + typeof o.x + ":" + typeof o.y + ":" + Object.keys(o).join("+");
}
const plain = record(1);
plain.late = "text";
const copied = copyOnto(record(2), input);
const both = record(3);
both.late = "first a string";
copyOnto(both, input);
console.log(describe(plain), describe(copied), describe(both));
console.log(JSON.stringify(plain), JSON.stringify(copied), JSON.stringify(both));
let total = 0;
for (let i = 0; i < 10000; i++) {
  const o = i % 3 === 0 ? plain : i % 3 === 1 ? copied : both;
  total += o.late.length === undefined ? o.late : o.late.length;
  total += typeof o.x === "number" ? o.x : o.x.length;
}
console.log(total);
//// parsed-text-cast-to-an-interface-has-a-member-that-another-object-gets-by-name.ts
// Parsed text cast to an interface has a member beside the declared ones. Another object of the interface gets that name by an untyped store, with another type.
interface Entry {
  count: number;
}
function parse(text: string): Entry {
  return JSON.parse(text) as Entry;
}
function untyped(o: any): string {
  return typeof o.late + ":" + String(o.late) + " " + Object.keys(o).join("+") + " " + JSON.stringify(o);
}
function twice(e: Entry): number {
  return e.count * 2;
}
const a = parse('{"count": 1, "late": 5}');
const b: Entry = { count: 2 };
(b as any).late = "text";
const c = parse('{"late": [1, 2], "count": 3}');
const d = parse('{"count": 4}');
const e = parse('{"count": 5, "late": "fits"}');
for (const o of [a, b, c, d, e]) console.log(twice(o), untyped(o));
let total = 0;
for (let i = 0; i < 5000; i++) {
  const o: any = i % 5 === 0 ? a : i % 5 === 1 ? b : i % 5 === 2 ? c : i % 5 === 3 ? d : e;
  total += twice(o) + (typeof o.late === "string" ? o.late.length : o.late === undefined ? 0 : 1);
}
console.log(total);
