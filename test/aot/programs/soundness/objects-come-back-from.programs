//// sloppy-this-is-the-global-object-only-without-a-receiver.cjs
function getX() { return this.x; }
function setX() { this.x = "text"; }
var a = { x: 1, get: getX };
var b = { x: "s", set: setX };
function Client() { this.fetch = function () { return 1; }; }
exports.run = function () {
  b.set();
  var c = new Client();
  return [a.get(), b.x, typeof fetch, c.fetch()].join(" ");
};

function mark(name) { this[name] = (this[name] || 0) + 1; return this === globalThis; }
function markFixed() { this.s003Fixed = (this.s003Fixed || 0) + 1; return this === globalThis; }
exports.guard = function () {
  var answers = [];
  answers.push(markFixed());
  answers.push(markFixed.call(undefined));
  answers.push(markFixed.apply(null, []));
  answers.push(Reflect.apply(markFixed, undefined, []));
  answers.push(markFixed.bind(undefined)());
  [1].forEach(function () { answers.push(markFixed.call(this)); });
  [1].map(markFixed).forEach(function (answer) { answers.push(answer); });
  answers.push(mark("s003Named"));
  var holder = { markFixed: markFixed };
  answers.push(holder.markFixed());
  var loose = holder.markFixed;
  answers.push(loose());
  answers.push((0, holder.markFixed)());
  return answers.join(",") + " " + globalThis.s003Fixed + " " + globalThis.s003Named + " " + holder.s003Fixed;
};
console.log(exports.run());
console.log(exports.guard());
//// sources-of-object-assign-arrive-late.js
// Sources of Object.assign arrive late, have getters, and the target changes.
function run(f) { "x".replace("x", f); }
function main() {
  let source = { a: 1 };
  let target = {};
  const first = target;
  function change() { source = { get a() { target = { second: true }; return "from getter"; }, b: { deep: 1 } }; return ""; }
  for (let i = 0; i < 3; i++) { Object.assign(target, source); run(change); }
  console.log(typeof first.a, typeof first.b, first.b.deep, typeof target.a, target.second);
  const many = Object.assign({}, { x: 1 }, null, "ab", [true], { x: "last" });
  console.log(typeof many.x, many[0], many[1]);
  const withSetter = { set v(value) { this.seen = typeof value; } };
  Object.assign(withSetter, { v: { o: 1 } });
  console.log(withSetter.seen);
  const frozen = Object.freeze({ f: 1 });
  try { Object.assign(frozen, { f: 2 }); console.log("assigned"); } catch (e) { console.log("threw", frozen.f); }
}
main();
//// species-constructor-result-gets-the-elements.js
// What a species constructor returns arrives in the result after the built-in has been looked at, and gets the elements all the same.
function run(f) { "x".replace("x", f); }
class Rows extends Array {}
class Boxed extends Array { static get [Symbol.species]() { return Holder; } }
function Holder(n) { this.made = "by species"; this.length = 0; }
function main() {
  const r = new Rows();
  r.push({ a: 1 }, { a: 2 });
  const s = r.slice(0, 1);
  console.log(s instanceof Rows, s.length, s[0].a);
  const c = r.concat([{ a: "x" }]);
  console.log(c instanceof Rows, c.length, typeof c[2].a);
  const b = new Boxed();
  b.push({ a: "boxed" });
  const t = b.slice(0);
  console.log(t instanceof Holder, t.made, typeof t[0], t[0].a);
  let source = r;
  function swap() { source = b; return ""; }
  for (let i = 0; i < 2; i++) { const copy = source.slice(0); console.log(copy instanceof Array, typeof copy[0].a, typeof copy.made); run(swap); }
}
main();
//// species-getter-picks-another-class.js
class A extends Array {
  constructor(...list) { super(...list); this.kind = this.describe(); }
  describe() { return "A"; }
}
class B extends A {
  extra = "x";
  static get [Symbol.species]() { return which; }
  describe() { return "B"; }
}
class Other { constructor(n) { this.n = n; this.kind = "Other"; } }
function Plain(n) { this.n = n; this.kind = "Plain"; }
let which;
function show(label, o) { console.log(label, o.constructor.name, o.kind, o.extra, o.length, o.n, o[0], o[1], o instanceof B, o instanceof A, Object.keys(o).join()); }
const b = new B(1, 2, 3);
for (const [label, species] of [["A", A], ["Array", Array], ["Other", Other], ["Plain", Plain], ["undefined", undefined], ["null", null], ["B", B]]) {
  which = species;
  show(label + " map", b.map(x => x + 1));
  show(label + " filter", b.filter(x => x > 1));
  show(label + " slice", b.slice(0, 2));
}
//// species-of-array-constructs-the-lowest-class.js
const log = [];
class A extends Array {
  static count = 0;
  constructor(...list) { super(...list); this.kind = this.describe(); new.target.count++; log.push(new.target.name + "(" + list.join() + ")"); }
  describe() { return "A"; }
}
////= B
function show(label, o) { console.log(label, o.constructor.name, o.kind, o.extra, o.length, Array.prototype.join.call(o), o instanceof B, Object.keys(o).join()); }
const b = B.from([1, 2, 3]);
show("from", b);
show("of", B.of(7, 8));
show("map", b.map(x => x * 2));
show("filter", b.filter(x => x > 1));
show("slice", b.slice(1));
show("concat", b.concat([9]));
show("flat", b.flat());
show("flatMap", b.flatMap(x => [x, x]));
show("splice", b.splice(0, 1));
show("after splice", b);
show("base", new A(1, 2));
console.log(A.count, B.count, Object.hasOwn(B, "count"), log.join(" "));
//// species-of-reg-exp-constructs-the-lowest-class.js
const log = [];
class A extends RegExp {
  constructor(pattern, flags) { super(pattern, flags); this.kind = this.describe(); log.push(new.target.name + " " + flags); }
  describe() { return "A"; }
}
class B extends A {
  extra = "x";
  describe() { return "B " + this.extra; }
  exec(text) { const r = super.exec(text); log.push("exec " + this.kind + " " + this.extra); return r; }
}
const b = new B("-", "g");
console.log("a-b-c".split(b).join("|"));
console.log([..."a-b".matchAll(b)].length);
console.log("a-b".replace(b, "+"), b.test("-"), b.kind, b.extra);
console.log(log.join(","));
//// species-of-typed-array-and-buffer-construct-the-lowest-class.js
const log = [];
class A extends Uint8Array {
  constructor(...list) { super(...list); this.kind = this.describe(); log.push(new.target.name + ":" + list.length); }
  describe() { return "A"; }
}
////= B
function show(label, o) { console.log(label, o.constructor.name, o.kind, o.extra, o.length, Array.prototype.join.call(o), o instanceof B); }
const b = B.from([1, 2, 3]);
show("from", b);
show("of", B.of(4, 5));
show("map", b.map(x => x * 2));
show("filter", b.filter(x => x > 1));
show("slice", b.slice(1));
show("subarray", b.subarray(1));
show("base", new A(2));
class BaseBuffer extends ArrayBuffer {
  constructor(n) { super(n); this.kind = this.describe(); log.push(new.target.name); }
  describe() { return "BaseBuffer"; }
}
class LowerBuffer extends BaseBuffer { extra = "y"; describe() { return "LowerBuffer " + this.extra; } }
const s = new LowerBuffer(8).slice(2);
console.log(s.constructor.name, s.kind, s.extra, s.byteLength, s instanceof LowerBuffer);
console.log(log.join());
//// stack-traces-hand-the-object-that-is-being-made-to-the-program.js
// Stack traces hand the error that is being made to the program.
function attempt(f) { try { return f(); } catch (e) { return "threw " + e.constructor.name; } }
function mayThrow() { if (JSON.parse("true")) throw new RangeError("midway"); }
const seen = [];
Error.prepareStackTrace = (e, sites) => { seen.push(attempt(() => e.ha.qg)); return "trace"; };
class X extends Error { ha = { qg: 1 }; }
const x = new X("m"); x.stack;
class Y { constructor() { Error.captureStackTrace(this); this.stack; this.ha = { qg: 2 }; } }
const y = new Y(); y.stack;
console.log(seen.join("|"), x.ha.qg, y.ha.qg);
