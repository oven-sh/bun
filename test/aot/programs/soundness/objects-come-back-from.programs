say("200000 names read from one object", () => { const o = { a: 1 }; let misses = 0; for (let i = 0; i < 200000; i++) if (o['n' + i] === undefined) misses++; return misses + ',' + o.a; });
say("keys of 10000 characters", () => { const o = {}; const k = 'x'.repeat(10000); o[k + 1] = 1; o[k + 2] = 2; const rope = 'x'.repeat(5000) + 'x'.repeat(5000) + 1; return o[rope] + ',' + o[k + 2] + ',' + (k + 3 in o) + ',' + Object.keys(o)[0].length; });
say("string built from a million pieces", () => { let t = ''; for (let i = 0; i < 1000000; i++) t += i % 10; let c = 0; for (let i = 0; i < t.length; i += 99991) c += t.charCodeAt(i); return t.length + ',' + c; });
say("strings built twenty deep", () => { function b(n) { let t = ''; for (let i = 0; i < 50; i++) t += n ? (i === 25 ? b(n - 1).length : i) : i; return t; } return b(20).length; });
say("join of 300000 strings", () => { const a = []; for (let i = 0; i < 300000; i++) a.push('v' + i); const j = a.join('-'); return j.length + ',' + j.slice(-7); });
say("template with 400 parts", () => { const v = 7; return `${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x${v}x`.length; });
say("array of five million integers", () => { const a = []; for (let i = 0; i < 5000000; i++) a.push(i & 255); let t = 0; for (let i = 0; i < a.length; i++) t += a[i]; return t + ',' + a.length; });
say("array made sparse", () => { const a = [1, 2, 3]; a[10000000] = 4; let t = 0; a.forEach(v => { t += v; }); return t + ',' + a.length + ',' + a[5] + ',' + a.indexOf(4); });
say("array with the largest length", () => { const a = [1]; a.length = 4294967295; let e; try { a.push(2); } catch (x) { e = x.name; } return e + ',' + a.length + ',' + a[0] + ',' + a[4294967295]; });
say("array index beyond int32", () => { const a = [1, 2]; const i = 2147483648; a[i] = 9; return a[i] + ',' + a.length + ',' + a[i - 1] + ',' + a[1]; });
say("stack overflow in typed code and on", () => { class P { constructor(n) { this.n = n; } } let deepest = 0; function d(n) { const p = new P(n); deepest = p.n; return d(n + 1) + p.n; } let e; try { d(0); } catch (x) { e = x.name; } const q = new P(5); return e + ',' + (deepest > 1000) + ',' + q.n; });
say("stack overflow inside a built-in callback", () => { let n = 0; function r() { n++; return [1].map(r); } let e; try { r(); } catch (x) { e = x.name; } return e + ',' + (n > 100); });
say("100000 classes from one factory", () => { const make = i => class { get() { return i; } static s = i; }; let t = 0; for (let i = 0; i < 100000; i++) { const K = make(i); t += new K().get() + K.s; } return t; });
say("100000 subclasses from one factory", () => { class B { constructor() { this.b = 1; } } const make = i => class extends B { x = i; }; let t = 0; for (let i = 0; i < 100000; i++) { const o = new (make(i))(); t += o.x + o.b; } return t; });
say("prototype chain of 10000 objects", () => { let o = { deep: 1 }; for (let i = 0; i < 10000; i++) o = Object.create(o); return o.deep + ',' + ('deep' in o) + ',' + o.none; });
say("map of a million entries changed while looping", () => { const m = new Map(); for (let i = 0; i < 1000000; i++) m.set(i, i); let t = 0, n = 0; for (const [k, v] of m) { t += v; n++; if (k % 2 === 0) m.delete(k + 1); } return t + ',' + n + ',' + m.size; });
say("set that grows while looping", () => { const s = new Set([0]); for (const v of s) if (v < 200000) s.add(v + 1); return s.size; });
say("100000 live generators", () => { function* g(i) { yield i; yield i + 1; } const gs = []; for (let i = 0; i < 100000; i++) { const x = g(i); x.next(); gs.push(x); } let t = 0; for (const x of gs) t += x.next().value; return t; });
