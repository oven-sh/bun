////: passingNames
function passingNames(p, count) {
  for (let i = 0; i < count; i++) {
    Reflect.set(p, "passing" + i, i);
    if (i) Reflect.deleteProperty(p, "passing" + (i - 1));
  }
}
////: record
function record(i) {
  return { x: i, y: i + 1 };
}
////: report
function report(a, b) {
  a.inc(); a.inc(); a.K.s = 5; a.obj.n = 7;
  console.log(a === b, globalThis.runs, a.id, b.id, b.inc(), a.K === b.K, b.K.s, a.sym === b.sym, a.obj === b.obj, b.obj.n, new a.K() instanceof b.K);
}
////: run
function run(change, form, Made, Base, make, probe, changesFirst) {
  var name = change + (changesFirst ? " first, " : " later, ") + form;
  Made = unseen(Made);
  Base = unseen(Base);
  if (!changesFirst)
    construct(name + ", untouched", make, 1, probe);
  var secondStep = changes[change](Made, Base);
  construct(name + ", changed", make, 2, probe);
  if (secondStep) {
    secondStep();
    construct(name + ", changed again", make, 3, probe);
  }
}
////: say
function say(label, f) {
  try {
    rows.push(label + ": " + f());
  } catch (e) {
    rows.push(label + ": threw " + e.name);
  }
}
////: show-2
function show(tag, v) {
  let t = typeof v;
  let extra = "";
  if (t === "number") extra = v + 1;
  else if (t === "string") extra = v + "!";
  else if (t === "object" && v !== null) extra = Object.keys(v).join(",");
  print(tag, t, extra);
}
////: show-4
function show(label, value) {
  console.log(label, typeof value === "symbol" ? String(value) : value);
}
////: spy
const spy = {
  set pos(value) {
