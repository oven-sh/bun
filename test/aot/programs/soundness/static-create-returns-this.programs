//// super-called-in-a-branch-an-arrow-a-try-and-twice.js
// Super() in odd places.
function attempt(f) { try { return f(); } catch (e) { return "threw " + e.constructor.name; } }
function mayThrow() { if (JSON.parse("true")) throw new RangeError("midway"); }
const seen = [];
class P { constructor() { this.pa = { qd: 1 }; } }
class Q1 extends P { qa = { qd: 2 }; constructor(k) { if (k) super(); else super(); seen.push(this.qa.qd); } }
new Q1(0); new Q1(1);
class Q2 extends P { qb = { qd: 3 }; constructor() { const s = () => super(); s(); seen.push(this.qb.qd); } }
new Q2();
class Q3 extends P { qc = { qd: 4 }; constructor() { try { super(); mayThrow(); } catch {} finally { seen.push(attempt(() => this.qc.qd)); } } }
new Q3();
class Q4 extends P { qe = { qd: 5 }; constructor() { super(); seen.push(attempt(() => super())); seen.push(this.qe.qd); } }
attempt(() => new Q4());
let early; class Q5 extends P { qf = (early = this, mayThrow(), { qd: 6 }); qg = { qd: 7 }; constructor() { try { super(); } catch {} seen.push(attempt(() => this.qg.qd)); } }
attempt(() => new Q5());
console.log(seen.join("|"), attempt(() => early.qf.qd), attempt(() => early.qg.qd), attempt(() => early.pa.qd));
class Q6 extends P { qh = { qd: 8 }; constructor() { const f = () => this.qh.qd; seen.push(attempt(f)); super(); seen.push(attempt(f)); } }
new Q6();
console.log(seen.join("|"));
//// super-static-and-computed-members-change-late.js
// super, static members, computed members and home objects whose chains change late.
function id(x) { return x; }
function chain(x) { return id(id(id(id(id(id(id(id(x)))))))); }
function show(...parts) { let text = ""; for (let i = 0; i < parts.length; i++) text += (i ? " | " : "") + String(parts[i]); console.log(text); }
function dynamic(text) { return (text + "!").slice(0, text.length); }
// 1: super.m() where the parent's prototype gets the method late
{ class A {} class B extends A { run() { return super.late ? super.late() : "none"; } } const b = new B(); show("1a", b.run()); chain(A.prototype).late = function () { return 7; }; show("1b", b.run() + 1); }
// 2: the prototype of the home object changes
{ class A { who() { return "A"; } } class Z { who() { return 26; } } class B extends A { who() { return super.who(); } } const b = new B(); show("2a", b.who().length); Object.setPrototypeOf(chain(B.prototype), Z.prototype); show("2b", b.who() + 1); }
// 3: super.x = v with a setter that appears late above the home object
{ const log = []; class A {} class B extends A { put(v) { super.x = v; } } const b = new B(); b.put(1); show("3a", Object.keys(b).join(), b.x + 1);
  Object.defineProperty(chain(A.prototype), "x", { set(v) { log.push(v); this.hidden = v; }, configurable: true }); const c = new B(); c.put(2); show("3b", Object.keys(c).join(), c.hidden + 1, log.join()); }
// 4: super in an object literal
{ const base = { hi() { return "base"; } }; const o = { __proto__: base, hi() { return super.hi(); } }; show("4a", o.hi().length); Object.setPrototypeOf(chain(o), { hi() { return 4; } }); show("4b", o.hi() + 1); }
// 5: static members through the chain of class objects
{ class A {} class B extends A {} function r(c) { return c.config; } show("5a", r(B)); chain(A).config = "static"; show("5b", r(B).length); Object.defineProperty(chain(B), "config", { get() { return 5; } }); show("5c", r(B) + 1, r(A).length); }
// 6: a static field under a computed key replaces a static method
{ const name = chain("make"); class A { static make() { return "method"; } static [name] = 6; } show("6", typeof A.make, A.make + 1); }
// 7: a computed method name that is one of two
{ function build(name) { return class { [name]() { return name; } }; } const X = build("a"), Y = build(chain("b")); show("7", new X().a(), typeof new X().b, new Y().b(), typeof new Y().a); }
// 8: a computed accessor whose name nobody can name
{ const name = dynamic("value"); class A { get [name]() { return "getter"; } set [name](v) { this.kept = v; } } const a = new A(); show("8a", a.value.length); a.value = 3; show("8b", a.kept + 1, Object.keys(a).join()); }
// 9: static super
{ class A { static make() { return "A"; } } class B extends A { static make() { return super.make(); } } show("9a", B.make().length); Object.setPrototypeOf(chain(B), { make() { return 9; } }); show("9b", B.make() + 1); }
// 10: a method borrowed by another object keeps its home object
{ class A { who() { return "A"; } } class B extends A { who() { return super.who(); } } const other = { who: B.prototype.who }; show("10a", other.who().length); chain(A.prototype).who = () => 10; show("10b", other.who() + 1); }
// 11: accessors that are inherited by two receivers get each receiver as this
{ class A { get me() { return this.tag; } set me(v) { this.tag = v; } } class B extends A {} class C extends A {} const b = new B(), c = new C(); function w(o, v) { o.me = v; } function r(o) { return o.me; }
  w(b, 1); show("11a", r(b) + 1, r(c)); w(chain(c), "text"); show("11b", r(b) + 1, r(c).length); }
//// symbols-returned-by-a-function-that-runs-again-differ.js
// A function that runs again returns another symbol each time: by two calls, in a loop, by recursion, as a callback.
////= show-4

function make() { return Symbol("dog"); }
const first = make();
const second = make();
show("two calls differ", first !== second);
show("two calls ==", first == second);
const both = { [first]: 1, [second]: 2 };
show("two keys", Object.getOwnPropertySymbols(both).length);
show("first", both[first]);
show("second", both[second]);

function makeInLoop() { return Symbol("loop"); }
const made = [];
for (let i = 0; i < 3; i++)
  made.push(makeInLoop());
show("loop size", new Set(made).size);
show("loop text", made.map(String).join());

const inBody = [];
for (let i = 0; i < 3; i++)
  inBody.push(Symbol("body"));
show("body size", new Set(inBody).size);

function makeTwiceByCondition(flag) { return flag ? Symbol("yes") : Symbol("no"); }
show("yes", makeTwiceByCondition(true));
show("no", makeTwiceByCondition(false));
show("yes again differs", makeTwiceByCondition(true) !== makeTwiceByCondition(true));

function recurse(depth) { return depth ? recurse(depth - 1) : Symbol("deep"); }
show("deep", recurse(3));
show("deep differs", recurse(2) !== recurse(2));

function makeFromCallback() { return Symbol("callback"); }
const mapped = [1, 2].map(makeFromCallback);
show("callback differs", mapped[0] !== mapped[1]);

const holder = {};
for (let i = 0; i < 2; i++) {
  Object.defineProperty(holder, "pet", { value: make(), writable: true, enumerable: true, configurable: true });
  show("defined again", holder.pet.description);
  show("defined is not the first", holder.pet !== first);
}
//// symbols-with-declared-types-returned-by-functions.ts
// Symbols in typed code: a declared result type, a unique symbol of a function that runs again, a symbol as the key of an interface, a field of type symbol that a built-in fills.
function show(label: string, value: unknown) {
  console.log(label, typeof value === "symbol" ? String(value) : value);
}

function makeTyped(): symbol { return Symbol("typed"); }
interface Holder { pet?: symbol }
const holder: Holder = {};
Object.defineProperty(holder, "pet", { value: makeTyped(), writable: true, enumerable: true, configurable: true });
show("typed", holder.pet);
show("typed description", holder.pet!.description);

function makeUnique() {
  const unique = Symbol("unique");
  return unique;
}
const firstUnique = makeUnique();
const secondUnique = makeUnique();
show("unique differs", (firstUnique as symbol) !== (secondUnique as symbol));

const mark: unique symbol = Symbol("mark");
interface Marked { [mark]: number }
function makeMarked(): Marked { return { [mark]: 4 }; }
show("marked", makeMarked()[mark]);
show("marked key", Object.getOwnPropertySymbols(makeMarked())[0] === mark);

class Pet {
  mark: symbol;
  constructor(mark: symbol) { this.mark = mark; }
}
function makeForPet(): symbol { return Symbol("pet"); }
const pet = new Pet(makeForPet());
show("pet", pet.mark);
Reflect.set(pet, "mark", makeTyped());
show("pet set", pet.mark);

function makeEither(flag: boolean): symbol | string { return flag ? Symbol("either") : "text"; }
show("either symbol", makeEither(true));
show("either text", makeEither(false));

const makers: Array<() => symbol> = [() => Symbol("a"), () => Symbol("b")];
show("makers", makers.map(make => String(make())).join());
//// text-assigned-under-the-name-of-a-method.ts
// Object.assign takes its target as an object, so the checker lets it put anything under the name of a method.
// The typed call that follows throws a TypeError, as in plain Bun. It never calls what is no function.
interface Shape {
  m(): string;
}
class A implements Shape {
  m(): string {
    return "m";
  }
}
function make(): Shape {
  return new A();
}
function report(label: string, o: Shape): void {
  try {
    console.log(label, o.m());
  } catch (e) {
    console.log(label, "threw", e instanceof TypeError);
  }
}

const first: Shape = new A();
Object.assign(first, { early: 1, m: "assigned" });
report("beside a name that the class does not have", first);

const second = make();
report("before", second);
Object.assign(second, { early: 1, m: "assigned", late: 2 });
report("between two such names", second);
console.log(Object.keys(second).join());

const third = make();
Object.assign(third, { m: 7 });
report("alone", third);

const fourth = make();
Object.assign({}, {
  get trigger() {
    Object.assign(fourth, { early: 1, m: "assigned" });
    return 1;
  },
});
report("inside a getter that Object.assign runs", fourth);

const fifth = make();
Object.assign(fifth, { early: 1, m: () => "replaced" });
report("a function", fifth);
report("another object of the class", make());
//// text-evaluated-at-run-time-meets-the-program-again-1/main.mjs
import { createRequire } from "node:module";
const require = createRequire(import.meta.url);
// Text evaluated at run time and the program meet again later: through listeners, handlers and callbacks that native code keeps, through containers on the global object that are filled afterwards,
// through accessors, proxies, iterators, thenables and classes that the text made. Each case has a class of its own, an instance that the text can reach and one that it cannot.
const never = process.argv.length > 99;
const glue = (...parts) => parts.join(never ? "x" : "");
const make = (...parts) => Function(...parts.slice(0, -1), glue(parts[parts.length - 1], ""));
const sleep = () => new Promise(r => setTimeout(r, 2));
await (async () => {
  class C { constructor(n) { this.n = n; this.list = [1, 2]; } twice() { return this.n * 2; } total() { let s = 0; for (let i = 0; i < this.list.length; i++) s += this.list[i]; return s; } }
  const o = new C(21), other = new C(1), notes = [];
  const note = (...a) => notes.push(a.map(String).join(" "));
  const first = () => note(o.twice(), o.total());
  first();
  try { const t = new EventTarget(); t.addEventListener('e', make('e', 'const o = e.detail; o.n = \"x\"; o.list.push(\"y\")')); t.dispatchEvent(new CustomEvent('e', { detail: o })); } catch (e) { note("threw " + e.name); }
  let after; try { after = [String(o.twice()), typeof o.n, String(o.total())].join(" "); } catch (e) { after = "threw " + e.name; }
  console.log('event target hands the detail to a listener from text', "|", notes.join(", "), "|", after, "|", String(other.twice()), typeof other.n, other.total());
})();
