class Leaking { constructor() { leak(this); this.key = "early"; } }
let seen;
function leak(o) { seen = o.key; }
new Leaking();

function evaluateLate(text) { const table = { early() {}, undefined() { return (0, eval)(hide(text)); } }; return table[seen](); }
