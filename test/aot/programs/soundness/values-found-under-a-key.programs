function look(w) {
  const seen = [];
  for (const o of w.heirs) {
    seen.push(show(attempt(() => read(o))), has(o) ? "+" : "-", owns(o) ? "o" : ".", show(attempt(() => call(o))), show(attempt(() => readAgain(o))));
