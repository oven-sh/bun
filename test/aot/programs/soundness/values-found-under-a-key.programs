//// variables-that-only-take-their-type.ts
// Variables that a group of closures shares, and variables of the module, whose every store names them.
// What is stored fits their types as long as the other typed places hold theirs, so a read needs no test. One store of a value out of `any` takes that away, for the variable and for whatever is fed from it.
function createScanner(text: string) {
    var pos: number;
    var end: number;
    let flags: number = 0;
    let token: string = "";
    let loose: number = 0;

    function reset(position: number, length: number) {
        pos = position;
        end = position + length;
        flags = 0;
    }
    function lookAhead<T>(callback: () => T): T {
        const savedPos = pos;
        const savedFlags = flags;
        const savedToken = token;
        const result = callback();
        pos = savedPos;
        flags = savedFlags;
        token = savedToken;
        return result;
    }
    function scan(): number {
        while (pos < end && text.charCodeAt(pos) === 32) pos++;
        if (pos >= end) return -1;
        const start = pos;
        while (pos < end && text.charCodeAt(pos) !== 32) pos++;
        token = text.substring(start, pos);
        flags |= token.length & 7;
        return pos - start;
    }
    function takeLoose(value: any) {
        loose = value;
    }
    // Before anybody else can call a thing: nobody sees what `pos` and `end` start as.
    reset(0, text.length);
    return { reset, lookAhead, scan, takeLoose, token: () => token, flags: () => flags, pos: () => pos, loose: () => loose };
}

// The same text once more: whatever is done to these variables below says nothing of the ones above.
function createSpoiledScanner(text: string) {
    var pos: number;
    var end: number;
    let flags: number = 0;
    let token: string = "";
    let loose: number = 0;

    function reset(position: number, length: number) {
        pos = position;
        end = position + length;
        flags = 0;
    }
    function lookAhead<T>(callback: () => T): T {
        const savedPos = pos;
        const savedFlags = flags;
        const savedToken = token;
        const result = callback();
        pos = savedPos;
        flags = savedFlags;
        token = savedToken;
        return result;
    }
    function scan(): number {
        while (pos < end && text.charCodeAt(pos) === 32) pos++;
        if (pos >= end) return -1;
        const start = pos;
        while (pos < end && text.charCodeAt(pos) !== 32) pos++;
        token = text.substring(start, pos);
        flags |= token.length & 7;
        return pos - start;
    }
    function takeLoose(value: any) {
        loose = value;
    }
    return { reset, lookAhead, scan, takeLoose, token: () => token, flags: () => flags, pos: () => pos, loose: () => loose };
}

let total: number = 0;
let rounds: number = 0;
let label: string = "none";
var last: number;

function count(words: string) {
    const scanner = createScanner(words);
    scanner.reset(0, words.length);
    let length: number;
    while ((length = scanner.scan()) >= 0) {
        total += length;
        last = length;
        label = scanner.token();
    }
    rounds++;
    return scanner.flags();
}

const lines = ["the quick brown fox", "jumps over", "", "   the lazy   dog ", "-0 NaN 2147483648 9007199254740993"];
let bits = 0;
for (let round = 0; round < 3; round++)
    for (const line of lines) bits = (bits * 31 + count(line)) | 0;
console.log(total, rounds, label, last!, bits);

const peeking = createScanner("one two three");
peeking.reset(0, 13);
console.log(peeking.lookAhead(() => [peeking.scan(), peeking.scan(), peeking.token()].join()), peeking.pos(), peeking.flags(), JSON.stringify(peeking.token()));
console.log(peeking.scan(), peeking.token(), peeking.pos(), peeking.flags());

// Positions that are no int32, and none at all.
const odd = createSpoiledScanner("a b");
odd.reset(-0, 3);
console.log(Object.is(odd.pos(), -0), odd.scan(), odd.pos());
odd.reset(0.5, 2);
console.log(odd.pos(), odd.scan(), odd.pos());
odd.reset(NaN, 1);
console.log(odd.pos(), odd.scan(), odd.pos());
odd.reset(2147483647, 2);
console.log(odd.pos(), odd.scan(), odd.pos());
odd.reset(9007199254740992, 1);
console.log(odd.pos(), odd.scan());

// Read before any store: undefined, whatever the type says.
const fresh = createSpoiledScanner("x");
console.log(fresh.pos(), typeof fresh.pos(), fresh.flags(), fresh.scan());

// What does not fit comes in through `any`.
const spoiled = createSpoiledScanner("x y");
spoiled.takeLoose("text");
console.log(spoiled.loose(), typeof spoiled.loose());
spoiled.takeLoose(undefined);
console.log(spoiled.loose(), typeof spoiled.loose());
spoiled.takeLoose(7);
console.log(spoiled.loose() + 1);
(spoiled.reset as any)("1", "2");
console.log(spoiled.pos(), typeof spoiled.pos(), spoiled.scan(), spoiled.pos());
(spoiled.reset as any)();
console.log(spoiled.pos(), spoiled.scan(), spoiled.flags());

// A variable that is saved and restored: what it starts as is never read, though what is read from it is stored back.
function createWalker(start: number) {
    var context: number;
    var cleared: number;
    var fed: number;
    context = start;
    cleared = start;
    fed = start;
    function inside<T>(flag: number, callback: () => T): T {
        const saved = context;
        context |= flag;
        const result = callback();
        context = saved;
        return result;
    }
    function clear() {
        fed = cleared;
        cleared = undefined!;
    }
    return { inside, clear, context: () => context, cleared: () => cleared, fed: () => fed };
}
const walker = createWalker(1);
console.log(walker.inside(4, () => walker.inside(8, () => walker.context()) + walker.context()), walker.context());
walker.clear();
console.log(walker.cleared(), walker.fed(), typeof walker.cleared());
walker.clear();
console.log(walker.cleared(), walker.fed(), typeof walker.fed());
for (const start of [-0, 0.5, NaN, 2147483648, -2147483649, 9007199254740993]) {
    const other = createWalker(start);
    console.log(Object.is(other.context(), start), other.inside(1, () => other.context()), other.context());
}
try {
    walker.inside(16, () => { throw new Error("left inside"); });
} catch (error) {
    console.log((error as Error).message, walker.context());
}
//// what-a-class-inherits-from-a-built-in-parent-is-hidden-later.ts
// Something is stored on each of these classes under a name that nobody knows at build time, so what they inherit from their built-in parents is found under a guard.
// The guard holds until the class itself gets the name.
class List extends Array<number> {}
class Bag extends Map<string, number> {}
class Deep extends Bag {
  read(key: string): number {
    return super.get(key) ?? -1;
  }
}
class Other {
  static isArray(_value: unknown): boolean {
    return false;
  }
  static of(..._values: number[]): number[] {
    return [];
  }
  get(_key: string): number {
    return -5;
  }
}

function patch(target: any, key: string, value: unknown): void {
  target[key] = value;
}
const join = (...parts: string[]) => parts.join("");

function ask(values: unknown[], turns: number): number {
  let count = 0;
  for (let i = 0; i < turns; i++) if (List.isArray(values[i & 3])) count++;
  return count;
}
function make(turns: number): number {
  let count = 0;
  for (let i = 0; i < turns; i++) count += List.of(i, i + 1).length;
  return count;
}
function read(deep: Deep, turns: number): number {
  let sum = 0;
  for (let i = 0; i < turns; i++) sum += deep.read("k");
  return sum;
}

patch(List, join("ex", "tra"), 1);
patch(Bag.prototype, join("ex", "tra"), 1);

const part = process.env.PART ?? "all";
const turns = Number(process.env.TURNS ?? 20000);
const values: unknown[] = [1, [2], "3", new List()];
const deep = new Deep();
deep.set("k", 3);
const is = (name: string) => part === name || part === "all";

if (is("ask")) console.log("ask", ask(values, turns));
if (is("make")) console.log("make", make(turns));
if (is("read")) console.log("read", read(deep, turns));
if (part === "all") {
  patch(List, join("is", "Array"), () => false);
  console.log("isArray stored on the class", ask(values, 100), make(100));
  delete (List as any).isArray;
  console.log("and deleted", ask(values, 100), make(100));
  Object.defineProperty(List, join("o", "f"), { value: () => [7], configurable: true });
  console.log("of defined on the class", ask(values, 100), make(100));
  delete (List as any).of;
  console.log("and deleted", ask(values, 100), make(100));
  Object.setPrototypeOf(List, Other);
  console.log("another parent", ask(values, 100), make(100));

  patch(Bag.prototype, join("g", "et"), () => -9);
  console.log("get stored on the prototype between", read(deep, 100), deep.get("k"));
  delete (Bag.prototype as any).get;
  console.log("and deleted", read(deep, 100), deep.get("k"));
  Object.setPrototypeOf(Bag.prototype, Other.prototype);
  console.log("another prototype above", read(deep, 100));
}
//// what-a-function-called-by-native-code-sees-as-this.js
// What `this` is, and how many arguments arrive, in a function that native code calls.
"use strict";
const lines = [];
function note(label) {
  return function () {
    const kind = this === undefined ? "undefined" : this === null ? "null" : typeof this;
    lines.push(
      `${label}: this ${kind}${kind === "object" ? " " + Object.prototype.toString.call(this) : ""}, ${arguments.length} arguments`,
    );
  };
}
setTimeout(note("setTimeout"), 0);
setTimeout(note("setTimeout with two more"), 0, 1, 2);
const interval = setInterval(function () {
  clearInterval(interval);
  note("setInterval").apply(this, arguments);
}, 0);
setImmediate(note("setImmediate"));
queueMicrotask(note("queueMicrotask"));
process.nextTick(note("process.nextTick"));
process.nextTick(note("process.nextTick with one more"), 1);
Promise.resolve(1).then(note("then"));
Promise.reject(1).catch(note("catch"));
Promise.resolve(1).finally(note("finally"));
[1].forEach(note("forEach"));
[1].forEach(note("forEach with an object"), {});
new Map([[1, 2]]).forEach(note("Map forEach"));
[2, 1].sort(note("sort"));
"a".replace(/a/, note("replace"));
JSON.parse("[1]", note("reviver"));
JSON.stringify({ a: 1 }, note("replacer"));
Array.from([1], note("Array.from"));
Reflect.apply(note("Reflect.apply"), 5, []);
const target = new EventTarget();
target.addEventListener("ping", note("addEventListener"));
target.dispatchEvent(new Event("ping"));
const controller = new AbortController();
controller.signal.addEventListener("abort", note("abort listener"));
controller.signal.onabort = note("onabort");
controller.abort();
process.on("exit", note("process exit"));
process.on("beforeExit", function () {
  if (lines.done) return;
  lines.done = true;
  note("process beforeExit").apply(this, arguments);
});
new FinalizationRegistry(note("registry"));
structuredClone({
  get a() {
    note("getter in structuredClone").call(this);
    return 1;
  },
});
process.on("exit", () => console.log(lines.join("\n")));
