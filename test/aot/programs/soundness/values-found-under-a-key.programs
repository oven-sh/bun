//// what-changes-while-a-function-is-suspended.ts
// A function reads something, is suspended, and reads it again. In between other code has changed it. The second read answers the new value.
export {};
async function t(name: string, f: () => unknown) { let r: string; try { r = String(await f()); } catch (e) { r = "threw " + (e instanceof Error ? e.name : typeof e); } console.log(name, r); }
const later = (): Promise<void> => new Promise(resolve => setTimeout(resolve, 0));
const muchLater = (): Promise<void> => new Promise(resolve => setTimeout(resolve, 5));
class Dog { legs = 4; }
class Counter { v = 1; #hidden = 1; static shared = 1; async run(wait: Promise<unknown>) { const a = this.v; await wait; return [a, this.v].join(); } async runHidden(wait: Promise<unknown>) { const a = this.#hidden; await wait; return [a, this.#hidden].join(); } bump(): void { this.v++; this.#hidden++; } }
let moduleLevel = 1;
await t("an async function that was started before stores null", async () => { const o: { pet: Dog | null } = { pet: new Dog() }; const other = (async () => { await later(); o.pet = null; })(); if (o.pet === null) return "null"; await other; return o.pet.legs; });
await t("an async function that was started before stores a number", async () => { const o = { v: 1 }; const other = (async () => { await later(); o.v = 2; })(); const a = o.v; await other; return [a, o.v].join(); });
