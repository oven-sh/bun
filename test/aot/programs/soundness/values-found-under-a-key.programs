//// values-live-across-array-searches-for-strings.js
// Values of every kind stay live across Array.prototype.includes and indexOf while the search compares strings, reads through getters and converts its start index.
const known = ["a whole text with a tail", "tail", "alpha", "beta"];
const asked = ["a whole text with a tai", "whole text", "beta", "alph" + "a", "", "tail"];

let total = 0;
for (let i = 0; i < asked.length; i++) {
  const weight = asked[i].length * 3;
  if (known.includes(asked[i])) total += 1000;
  total += weight;
}
console.log(total);

for (const text of asked)
  console.log(known.includes(text), text);

for (const text of asked)
  console.log(known[0].endsWith(text), known.includes(text), known.indexOf(text), text.length);

function search(list, texts) {
  let found = 0;
  let lengths = 0;
  let last = "none";
  let half = 0.5;
  const seen = [];
  for (let i = 0; i < texts.length; i++) {
    const text = texts[i];
    const isLong = text.length > 4;
    const at = list.indexOf(text);
    const has = list.includes(text, 1);
    if (at >= 0) found++;
    if (has) last = text;
    if (isLong) lengths += text.length;
    half += at / 2;
    seen.push(i, at, has, isLong);
  }
  return [found, lengths, last, half, seen.join()].join(" ");
}
console.log(search(known, asked));
console.log(search(asked, known));

const listLike = {
  get length() {
    return 3;
  },
  get 0() {
    return "x" + "y";
  },
  1: "tail",
  2: "beta",
};
for (const text of asked) {
  const before = text + "!";
  const has = Array.prototype.includes.call(listLike, text);
  const at = Array.prototype.indexOf.call(listLike, text, { valueOf: () => 0 });
  console.log(before, has, at, text);
}
//// values-of-other-types-reach-typed-fields-of-classes-with-computed-bases.ts
// Classes whose base is the value of an expression inherit typed fields. Values of other types reach those fields in every untyped way, on them and on the base class, and untyped reads get them back.
const names: string[] = JSON.parse('["x", "y"]');
const parsed: any = JSON.parse('{"x": "parsed", "y": 7}');
class P {
  x: number = 1;
  y: string = "s";
  sum(): number {
    return this.x + 1;
  }
}
type Constructor<T> = new (...a: any[]) => T;
const Mix = <B extends Constructor<P>>(b: B) => class extends b { w: number = 4; };
const Again = <B extends Constructor<P>>(b: B) => class extends b { v: number = 5; };
function pick<T>(c: T): T {
  return c;
}
const M = Mix(P);
const MM = Again(Mix(P));
const Picked = pick(P);
class FromPicked extends Picked {
  u: number = 6;
}
class FromCondition extends (names.length > 1 ? P : P) {
  t: number = 7;
}
function show(o: object): string {
  const a = o as any;
  return typeof a.x + ":" + String(a.x) + " " + typeof a.y + ":" + String(a.y) + " " + Object.keys(o).join("+") + " " + JSON.stringify(o);
}
function putByName(o: any): void {
  o.x = "by name";
}
function putWider(o: { x: number | string }): void {
  o.x = "wider";
}
function putByKey(o: any): void {
  o[names[0]] = "by key";
  o[names[1]] = 8;
}
function copy(o: any): void {
  for (const k of Object.keys(parsed)) o[k] = parsed[k];
}
function restore(p: P): number {
  p.x = 2;
  p.y = "t";
  return p.sum();
}
const makers: (() => P)[] = [() => new M(), () => new MM(), () => new FromPicked(), () => new FromCondition(), () => new P()];
const actions: ((o: any) => void)[] = [putByName, putWider, putByKey, copy, o => Object.assign(o, parsed), o => Reflect.set(o, names[0], null), o => { delete o.x; }, o => Object.defineProperty(o, "x", { value: "defined", writable: true, enumerable: true, configurable: true })];
for (const make of makers) {
  for (const act of actions) {
    const untouched = make();
    const o = make();
    act(o);
    console.log(show(o), "|", restore(o), show(o), "|", untouched.sum(), show(untouched));
  }
}
//// values-stay-alive-across-array-search-calls.ts
// Integers, doubles, strings and objects that a caller holds across `indexOf` and `includes`, more of them than there are registers, with search elements that take every path of the search.
const names = ["", "alice", "bob", "carol", "dave"];
const numbers = [1, 2, 3, 4, 5];
const doubles = [0.5, 1.5, 2.5, 3.5];
const marker = { name: "marker" };
const mixed: unknown[] = ["alice", 2, marker, null, undefined, 2.5, "bob"];

function copyOf(text: string): string {
  return text.split("").join("");
}

function loopCounter(list: string[], wanted: string): string {
  let line = "counter:";
  for (let i = 0; i < 4; i++) line += " " + list.indexOf(wanted) + "+";
  return line;
}

function positions(list: string[], wanted: string[]): number[] {
  const result: number[] = [];
  for (let i = 0; i < wanted.length; i++) result.push(list.indexOf(wanted[i]));
  return result;
}

function countPresent(list: string[], wanted: string[]): number {
  let found = 0;
  for (let i = 0; i < wanted.length; i++) if (list.includes(wanted[i])) found++;
  return found;
}

function nestedText(list: string[], wanted: string): string {
  let line = "nested:";
  for (const start of [0, 1, 2, -1]) line += " " + list.indexOf(wanted, start) + (list.includes(wanted, start) ? "+" : "-");
  return line;
}

function manyIntegers(list: unknown[], wanted: unknown, seed: number): string {
  let a = seed | 0, b = a + 1, c = a + 2, d = a + 3, e = a + 4, f = a + 5, g = a + 6, h = a + 7;
  let i = a + 8, j = a + 9, k = a + 10, l = a + 11, m = a + 12, n = a + 13, o = a + 14, p = a + 15;
  let total = 0;
  for (let round = 0; round < 3; round++) {
    const at = list.indexOf(wanted);
    const has = list.includes(wanted);
    total += at + (has ? 100 : 0);
    a += b; b += c; c += d; d += e; e += f; f += g; g += h; h += i;
    i += j; j += k; k += l; l += m; m += n; n += o; o += p; p += at;
  }
  return [total, a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p].join(",");
}

function manyDoubles(list: unknown[], wanted: unknown, seed: number): string {
  let a = seed + 0.25, b = a * 2, c = a * 3, d = a * 4, e = a * 5, f = a * 6, g = a * 7, h = a * 8;
  let i = a * 9, j = a * 10, k = a * 11, l = a * 12, m = a * 13, n = a * 14, o = a * 15, p = a * 16;
  let total = 0;
  for (let round = 0; round < 3; round++) {
    const at = list.indexOf(wanted);
    const has = list.includes(wanted);
    total += at + (has ? 0.5 : 0);
    a += b; b += c; c += d; d += e; e += f; f += g; g += h; h += i;
    i += j; j += k; k += l; l += m; m += n; n += o; o += p; p += at;
  }
  return [total, a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p].join(",");
}

function manyCells(list: unknown[], wanted: unknown): string {
  const a = { v: "a" }, b = { v: "b" }, c = { v: "c" }, d = { v: "d" }, e = { v: "e" }, f = { v: "f" }, g = { v: "g" }, h = { v: "h" };
  const s = copyOf("s"), t = copyOf("t"), u = copyOf("u"), w = copyOf("w");
  let line = "";
  for (let round = 0; round < 2; round++) {
    const at = list.indexOf(wanted);
    const has = list.includes(wanted);
    line += a.v + b.v + c.v + d.v + e.v + f.v + g.v + h.v + s + t + u + w + at + has + ";";
  }
  return line;
}

function thrownFromConversion(list: string[]): string {
  let kept = 41;
  const text = copyOf("kept");
  const start: any = { valueOf() { throw new Error("start"); } };
  try {
    kept++;
    list.indexOf("bob", start);
  } catch (error) {
    return text + " " + kept + " " + (error as Error).message;
  }
  return "no exception";
}

console.log(loopCounter(names, copyOf("alice")));
console.log(loopCounter(names.map(copyOf), "dave"));
console.log(loopCounter(names, "erin"));
console.log(positions(names, ["carol", "bob", "erin", ""].map(copyOf)).join(","));
console.log(countPresent(names.map(copyOf), ["carol", "bob", "erin", "alice"]));
console.log(nestedText(names.map(copyOf), copyOf("bob")));
for (const [list, wanted] of [[names, copyOf("carol")], [names, "erin"], [numbers, 4], [numbers, 4.5], [doubles, 2.5], [doubles, NaN], [mixed, copyOf("bob")], [mixed, marker], [mixed, undefined], [mixed, null], [mixed, 2.5], [[], "a"]] as [unknown[], unknown][]) {
  console.log(manyIntegers(list, wanted, 3));
  console.log(manyDoubles(list, wanted, 3));
  console.log(manyCells(list, wanted));
}
console.log(thrownFromConversion(names));
//// values-that-the-type-checker-lets-through.ts
// The holes of TypeScript's own type system, each in a try: the compiled program may print what plain prints or a TypeError, never garbage.
function attempt(name: string, f: () => unknown) { try { console.log(name, String(f())); } catch (e) { console.log(name, "threw", (e as Error).name); } }
class Animal { name: string; constructor(n: string) { this.name = n; } }
class Dog extends Animal { legs: number = 4; bark(): number { return this.legs * 2; } }
class Cat extends Animal { lives: string = "nine"; }
attempt("array covariance", () => { const dogs: Dog[] = [new Dog("a")]; const animals: Animal[] = dogs; animals.push(new Cat("c")); let s = 0; for (const d of dogs) s += d.legs; return s; });
attempt("array covariance call", () => { const dogs: Dog[] = [new Dog("a")]; const animals: Animal[] = dogs; animals[0] = new Cat("c"); return dogs[0].bark(); });
interface Handler { handle(a: Animal): number }
attempt("method bivariance", () => { const h: Handler = { handle(d: Dog) { return d.legs + 1; } }; return h.handle(new Cat("c")); });
function isDog(a: Animal): a is Dog { return true; }
attempt("lying predicate", () => { const a: Animal = new Cat("c"); return isDog(a) ? a.legs + 1 : 0; });
attempt("out of bounds", () => { const xs: number[] = [1, 2]; const v: number = xs[5]; return v + 1; });
attempt("out of bounds object", () => { const ds: Dog[] = []; return ds[0].legs; });
attempt("index signature", () => { const m: Record<string, number> = { a: 1 }; const v: number = m["b"]; return v * 2; });
class Unset { x!: number; y!: Dog; sum() { return this.x + 1; } }
attempt("definite assignment", () => new Unset().sum());
attempt("definite assignment object", () => new Unset().y.legs);
attempt("non-null", () => { const m = new Map<string, Dog>(); return m.get("k")!.legs; });
enum Color { Red, Green }
attempt("enum out of range", () => { const c: Color = JSON.parse("7") as Color; const names: string[] = ["r", "g"]; return names[c].length; });
attempt("narrowing undone", () => { const o: { d: Dog | null } = { d: new Dog("a") }; const clear = () => { o.d = null; }; if (o.d !== null) { clear(); return o.d.legs; } return -1; });
attempt("void callback", () => { const f: () => void = () => 5; const r = f(); return typeof r; });
interface Pt { x: number; y: number }
attempt("getter as field", () => { let n = 0; const p: Pt = { get x() { return ++n; }, y: 1 }; return p.x + p.x + p.y; });
attempt("other layout", () => { const len = (p: Pt) => p.x * p.x + p.y * p.y; return [len({ x: 1, y: 2 }), len({ y: 2, x: 1 }), len(Object.assign(new Dog("d"), { x: 3, y: 4 })), len(Object.create({ x: 5, y: 6 }))].join(); });
attempt("tuple push", () => { const t: [number, string] = [1, "a"]; t.push(2); t.pop(); t.pop(); const s: string = t[1]; return s.length; });
attempt("readonly alias", () => { const o = { v: 1 }; const r: { readonly v: number } = o; const before = r.v; o.v = 2; return before + r.v; });
attempt("extracted method", () => { const d = new Dog("a"); const f = d.bark; return f(); });
attempt("any leak", () => { const a: any = "str"; const n: number = a; return n * 2; });
attempt("any leak object", () => { const a: any = { legs: "many" }; const d: Dog = a; return d.legs + 1; });
attempt("any leak into array", () => { const xs: number[] = [1]; (xs as any).push("s"); let t = 0; for (const x of xs) t += x; return t; });
attempt("any leak into field", () => { const d = new Dog("a"); (d as any).legs = "x"; return d.bark(); });
attempt("optional", () => { const o: { a?: number } = {}; const f = (p: { a?: number }) => p.a! + 1; return f(o); });
attempt("generic", () => { function first<T>(xs: T[]): T { return xs[0]; } const v: number = first<number>([]); return v + 1; });
attempt("spread loses methods", () => { const d = { ...new Dog("a") } as Dog; return d.bark(); });
attempt("parsed", () => { const d = JSON.parse('{"name":1,"legs":"4"}') as Dog; return d.legs + 1; });
attempt("delete", () => { const o: { a: number; b?: number } = { a: 1, b: 2 }; delete o.b; delete (o as any).a; return o.a + 1; });
attempt("proto swap", () => { const d = new Dog("a"); Object.setPrototypeOf(d, Cat.prototype); return d.bark(); });
attempt("class patched", () => { const d = new Dog("a"); (Dog.prototype as any).bark = function () { return "patched"; }; return d.bark(); });
//// variables-of-a-module-that-nothing-reads-keep-objects-alive.mjs
// What a module exports, a static field and a property of the global object hold their objects as long as the module is there.
// A variable that nothing reads holds nothing behind the await, compiled or not: whether its object is still there hangs on what the
// collector finds on the stack, so that is not printed.
async function collect() { for (let i = 0; i < 4; i++) { await new Promise(done => setTimeout(done, 1)); Bun.gc(true); } }
