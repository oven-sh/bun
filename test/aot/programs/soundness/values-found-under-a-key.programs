show("array for bound", () => Reflect.construct(Array, [], bound({ peek() {}, mark: "m3" })));
show("error for bound", () => Reflect.construct(Error, [], bound({ peek() {}, mark: "m4" })));
show("promise for bound", () => Reflect.construct(Promise, [() => {}], bound({ peek() {}, mark: "m5" })));
