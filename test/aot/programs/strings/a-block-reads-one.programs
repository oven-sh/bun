const subject =
  "\ud800퟿𝟿a\ud83d\ud800\ud835퟿\udc00😀a￿￿\udc00￿\udc00Ā￿\ud800a퟿🟿\ud83d🐀aĀ\ud835\udbff\ude00\ud835aa\ud835퟿\udc00\ude00aĀa\udc00😀Ā\ud83da\ud835퟿퟿\ud800￿￿a\ude00\ude00";
