// Every match of these patterns holds a character or a text that stands behind a run of many characters. In a subject without it no place is tried. Each is timed against itself with one more alternative,
// a run longer than any in the subject, which holds nothing in particular: that one has to be tried place by place.
const nothing = String(Date.now()).slice(99);
const words = "the worker-7 finished job 8123 in 41 ms with status ok and no retries left ".repeat(1500) + "end";
const searches: [string, RegExp, RegExp][] = [
  ["a literal, a character behind a bounded run:", /\b([a-z0-9-]{1,64}@[a-z0-9-]+)\b/i, /\b([a-z0-9-]{1,64}@[a-z0-9-]+)\b|[a-z0-9-]{70}/i],
  ["a literal, a text behind two runs:", /\b([a-z0-9-]+\.[a-z0-9-]+\.example\.invalid)\b/i, /\b([a-z0-9-]+\.[a-z0-9-]+\.example\.invalid)\b|[a-z0-9-]{70}/i],
  ["a literal, one of two signs behind a word:", /\b[a-z]+\s*[=#]\s*(\S+)/i, /\b[a-z]+\s*[=#]\s*(\S+)|[a-z]{70}/i],
  ["a literal in unicode mode, a character behind a bounded run:", /\b([\p{L}\p{N}-]{1,64}@[a-z0-9-]+)\b/u, /\b([\p{L}\p{N}-]{1,64}@[a-z0-9-]+)\b|[\p{L}\p{N}-]{70}/u],
  ["a literal, a run that has to reach the end:", /[ \t\r\n\xa0\u2003\ufeff]+$/, /[ \t\r\n\xa0\u2003\ufeff]+$|[a-z0-9-]{70}/],
  ["a literal, a run at the start or one that has to reach the end:", /^[ \t\r\n\xa0\u2003\ufeff]+|[ \t\r\n\xa0\u2003\ufeff]+$/, /^[ \t\r\n\xa0\u2003\ufeff]+|[ \t\r\n\xa0\u2003\ufeff]+$|[a-z0-9-]{70}/],
  ["run-time text, a run that has to reach the end:", new RegExp("[ \\t\\xa0]+$" + nothing), new RegExp("[ \\t\\xa0]+$|[a-z0-9-]{70}" + nothing)],
  ["run-time text, a character behind a bounded run:", new RegExp("\\b([a-z0-9-]{1,63}@[a-z0-9-]+)\\b" + nothing, "i"), new RegExp("\\b([a-z0-9-]{1,63}@[a-z0-9-]+)\\b|[a-z0-9-]{70}" + nothing, "i")],
  ["run-time text, a text behind two runs:", new RegExp("\\b([a-z0-9-]+\\.[a-z0-9-]+\\.example\\.test)\\b" + nothing, "i"), new RegExp("\\b([a-z0-9-]+\\.[a-z0-9-]+\\.example\\.test)\\b|[a-z0-9-]{70}" + nothing, "i")],
  ["run-time text that looks back over a group, a character behind a run:", new RegExp("(?<!(?:x|y)+z)\\b([a-z0-9-]{1,64}@[a-z0-9-]+)\\b" + nothing, "i"), new RegExp("(?<!(?:x|y)+z)\\b([a-z0-9-]{1,64}@[a-z0-9-]+)\\b|[a-z0-9-]{70}" + nothing, "i")],
];
function fastestOf(runs: number, pattern: RegExp, subject: string): number {
  let fastest = Infinity;
  for (let run = 0; run < runs; run++) {
    const began = performance.now();
    if (pattern.test(subject)) console.log("found");
    fastest = Math.min(fastest, performance.now() - began);
  }
  return fastest;
}
for (const subject of [words, "\u4e00 " + words]) {
  for (const [name, pattern, triedEverywhere] of searches)
    console.log(name, fastestOf(12, pattern, subject) * 6 < fastestOf(4, triedEverywhere, subject) ? "no place is tried" : "as slow as a try at every place");
}
//// a-text-a-colon-and-a-number-of-one-object-are-joined-once-each.ts
// `item.name + ":" + item.count` joins each of its three parts once, also where the object comes out of a field that may hold undefined.
class Item {
  name: string;
  count: number;

  constructor(name: string, count: number) {
    this.name = name;
    this.count = count;
  }
}

class Special extends Item {
  extra: boolean;

  constructor(name: string, count: number, extra: boolean) {
    super(name, count);
    this.extra = extra;
  }
}

class Box<T> {
  value: T;

  constructor(value: T) {
    this.value = value;
  }
}

function summarize(box: Box<Item | undefined>): string {
  const item = box.value;
  return item === undefined ? "empty" : item.name + ":" + item.count;
}

const optional = new Box<Item | undefined>(undefined);
console.log(summarize(optional));
optional.value = new Item("first", 1);
console.log(summarize(optional));
optional.value = new Special("second", 2, true);
console.log(summarize(optional));
//// a-text-in-one-piece-is-compared-with-a-text-just-put-together.js
// `===` between a text that lies in one piece and a text that was just put together, in every shape that putting together gives.
const part = JSON.parse('["text/html","; charset=","utf-8","W/\\"","d-","abcDEF0123456789+/","\\"","","é","日本","x"]');
const flat = text => JSON.parse(JSON.stringify(text));
const shapes = [
  () => part[0] + part[1] + part[2],
  () => (part[0] + part[1]) + part[2],
  () => part[0] + (part[1] + part[2]),
  () => `${part[3]}${part[4]}${part[5]}${part[6]}`,
  () => part[3] + part[4] + part[5] + part[6] + part[7],
  () => part[7] + part[0] + part[7],
  () => { let s = ""; for (let i = 0; i < 40; i++) s += part[10]; return s; },
  () => { let s = ""; for (let i = 0; i < 40; i++) s = part[10] + s; return s; },
  () => { let s = part[0]; for (let i = 0; i < 12; i++) s = s + part[1] + s.length; return s; },
  () => (part[0] + part[1] + part[2]).slice(3, 20) + part[2],
  () => part[5].slice(2, 9) + part[5].slice(9) + part[0].slice(1),
  () => part[0] + part[8] + part[2],
  () => part[0] + part[9] + part[2],
  () => part[9] + part[9],
  () => part[0].repeat(30) + part[1],
  () => [part[0], part[1], part[2]].join("") + part[10],
];
function same(a, b) { return a === b; }
function differs(a, b) { return a !== b; }
function remembered(holder, value) { if (holder.last !== value) { holder.last = value; return 1; } return 0; }
const out = [];
for (let round = 0; round < 8; round++) {
  out.length = 0;
  shapes.forEach((make, n) => {
    const text = flat(make());
    const changed = [0, 1, text.length >> 1, text.length - 1].map(at => flat(text.slice(0, at) + (text[at] === "~" ? "!" : "~") + text.slice(at + 1)));
    const line = [same(make(), text), same(text, make()), same(make(), make()), differs(make(), text), ...changed.map(other => same(make(), other)), ...changed.map(other => same(other, make())), same(make(), text + part[10]), same(make() + part[10], text), same(make(), flat(text.slice(1))), same(make().slice(1), flat(text.slice(1)))];
    const holder = { last: text }; const met = remembered(holder, make()) + remembered(holder, make()) + remembered(holder, changed[2]) + remembered(holder, make());
    const used = make(); const wasEqual = same(used, text);
    out.push(n + ":" + line.map(Number).join("") + met + Number(wasEqual) + used.length + used.charCodeAt(used.length - 1) + (used === text) + (used + "!" === text + "!") + new Map([[text, 1]]).has(used) + ({ [text]: 1 })[used]);
  });
}
console.log(out.join("\n"));
//// a-text-is-read-between-and-behind-its-appends.js
// A text that is built by appending is read, by position and as a whole, in loops between its appends and behind them: each read sees what has been appended so far.
function codes(count, wide) {
  let text = "";
  for (let k = 0; k < count; k++) text += String.fromCharCode((wide && k % 7 === 3 ? 0x4e00 : 65) + (k & 15));
  let sum = 0;
  for (let k = 0; k < text.length; k++) sum = (sum * 31 + text.charCodeAt(k)) | 0;
  return sum + ":" + text.length;
}
function between(count) {
  let text = "";
  let sum = 0;
  for (let k = 0; k < count; k++) {
    text += "ab" + k;
    for (let j = 0; j < text.length; j += 3) sum = (sum + text.charCodeAt(j)) | 0;
  }
  return sum + ":" + text.length;
}
function rarely(count) {
  let text = "";
  let sum = 0;
  for (let k = 0; k < count; k++) {
    text += k;
    let j = k % 50 === 49 ? 0 : text.length;
    while (j < text.length) sum = (sum + text.charCodeAt(j++)) | 0;
  }
  return sum + ":" + text.length;
}
function kept(count) {
  let text = "";
  const seen = [];
  for (let k = 0; k < count; k++) {
    text += String.fromCharCode(97 + (k % 26));
    if (k % 5 === 0) seen.push(text);
    if (k % 5 === 1) seen.push(text, text);
  }
  let same = 0;
  for (let k = 1; k < seen.length; k++) if (seen[k] === seen[k - 1]) same++;
  return seen.join("|").length + ":" + same + ":" + seen[seen.length - 1];
}
function twice(count) {
  let left = "";
  let right = "";
  let sum = 0;
  for (let k = 0; k < count; k++) {
    left += "l" + k;
    right += "r";
    for (let j = 0; j < right.length; j++) sum = (sum + left.charCodeAt(j) + right.charCodeAt(j)) | 0;
  }
  return sum + ":" + left.length + ":" + right.length;
}
function again(rounds, count) {
  let sum = 0;
  for (let r = 0; r < rounds; r++) {
    let text = "";
    for (let k = 0; k < count + r; k++) text += String.fromCharCode(48 + ((k + r) % 10));
    for (let k = 0; k < text.length; k++) sum = (sum + text.charCodeAt(k) * (k + 1)) | 0;
    if (r % 3 === 0) text += "tail";
    for (let k = text.length - 1; k >= 0; k -= 2) sum = (sum ^ text.charCodeAt(k)) | 0;
  }
  return sum;
}
for (let round = 0; round < 3; round++) {
  for (const count of [0, 1, 2, 15, 16, 17, 64, 1000, 70000]) console.log(count, codes(count, false), codes(count, true));
  for (const count of [0, 1, 7, 200]) console.log(count, between(count), rarely(count * 10), kept(count), twice(count), again(count % 9, count));
}
//// a-text-looked-for-at-one-position.ts
const texts: string[] = ["", "a", "ab", "abc", "abcabc", "/usr/lib/node.d.ts", ".", ".ts", "..", "é", "éa", "日本語", "日本", "a日本", "x".repeat(40), "x".repeat(39) + "y"];
const left = "/usr/";
const ropes: string[] = [left + texts[3] + texts[4], texts[11] + left + texts[2], texts[14] + texts[15]];
const all = texts.concat(ropes);

function startsWithByLastIndexOf(text: string, prefix: string): boolean {
  return text.lastIndexOf(prefix, 0) === 0;
}
function endsWithByIndexOf(text: string, suffix: string): boolean {
  const expected = text.length - suffix.length;
  return expected >= 0 && text.indexOf(suffix, expected) === expected;
}

let rows = 0;
let digest = 0;
const wrong: string[] = [];
for (let i = 0; i < all.length; i++) {
  for (let j = 0; j < all.length; j++) {
    const text = all[i];
    const other = all[j];
    const starts = text.startsWith(other);
    const ends = text.endsWith(other);
    if (starts !== startsWithByLastIndexOf(text, other)) wrong.push(`start ${i} ${j}`);
    if (ends !== endsWithByIndexOf(text, other)) wrong.push(`end ${i} ${j}`);
    if (starts !== (text.slice(0, other.length) === other)) wrong.push(`slice ${i} ${j}`);
    for (const position of [-1, 0, 1, 2, 5, 39, 40, 41, 1000]) {
      const at = text.startsWith(other, position);
      const clamped = Math.min(Math.max(position, 0), text.length);
      if (at !== (text.slice(clamped, clamped + other.length) === other)) wrong.push(`at ${i} ${j} ${position}`);
      const until = text.endsWith(other, position);
      if (until !== (clamped >= other.length && text.slice(clamped - other.length, clamped) === other)) wrong.push(`until ${i} ${j} ${position}`);
      digest = (digest * 31 + (at ? 1 : 0) + (until ? 2 : 0)) | 0;
      rows++;
    }
    digest = (digest * 31 + (starts ? 1 : 0) + (ends ? 2 : 0)) | 0;
  }
}
console.log(rows, digest, wrong.length, wrong.slice(0, 8).join("|"));

for (const text of all) {
  console.log(
    JSON.stringify(text.length > 12 ? text.slice(0, 12) : text),
    text.lastIndexOf(".", 0),
    text.lastIndexOf("", 0),
    text.lastIndexOf("a", 0),
    text.lastIndexOf("ab", 0),
    text.lastIndexOf("ab", -5),
    text.lastIndexOf("/usr/", 0),
    text.lastIndexOf("日", 0),
    text.lastIndexOf("日本", 0),
    text.lastIndexOf("é", 0),
    text.lastIndexOf("é", -1),
    text.lastIndexOf("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", 0),
    text.lastIndexOf(".", 1),
    text.lastIndexOf("a", NaN),
    text.lastIndexOf("ab", 3),
  );
}
//// a-text-made-in-either-arm-grows-in-a-try-whose-catch-reads-it.ts
// An object is made in either arm of a test, with a text of the same form in one field: a constant and a number. The text grows inside a try, and the catch reads
// the field: as it was made where the call in front of the append throws, grown where the call behind it does.
type Row = { n: number; t: string };

function refuse(at: number, when: number): void {
  if (at % 4 === when) throw new Error("refused " + at);
}

function objects(at: number): number | string {
  let it: Row;
  if (at % 3) it = { n: at, t: "t" + at };
  else it = { n: at + 10, t: "t" + (at + 10) };
  try {
    it.t += "y";
    refuse(at, 3);
    return it.n;
  } catch {
    return it.t;
  }
}

function objectsRefusedFirst(at: number): number | string {
  let it: Row;
  if (at % 3) it = { n: at, t: "t" + at };
  else it = { n: at + 10, t: "t" + (at + 10) };
  try {
    refuse(at, 2);
    it.t += "y";
    refuse(at, 3);
    return it.n;
  } catch {
    return it.t;
  }
}

function pairs(at: number): number | string {
  const it: [number, string] = at % 2 ? [at, "t" + at] : [at + 10, "t" + (at + 10)];
  try {
    it[1] += "y";
    refuse(at, 1);
    return it[0];
  } catch {
    return it[1].length + it[0] + it[1];
  }
}

function leftByFinally(at: number, seen: (number | string)[]): void {
  let it: Row;
  if (at % 3) it = { n: at, t: "t" + at };
  else it = { n: at + 10, t: "t" + (at + 10) };
  try {
    it.t += "y";
    refuse(at, 0);
    seen.push(it.n);
  } finally {
    seen.push(it.t);
  }
}

class Line {
  constructor(
    public n: number,
    public t: string,
  ) {}
}

function instances(at: number): number | string {
  const it = at % 2 ? new Line(at, "t" + at) : new Line(at + 10, "t" + (at + 10));
  try {
    it.t += "y";
    refuse(at, 2);
    return it.n;
  } catch {
    return it.t;
  }
}

function oneTryInAnother(at: number): string {
  let it: Row;
  if (at % 3) it = { n: at, t: "t" + at };
  else it = { n: at + 10, t: "t" + (at + 10) };
  try {
    it.t += "x";
    try {
      it.t += "y";
      refuse(at, 1);
    } catch {
      it.t += "!";
      refuse(at + 1, 2);
    }
    refuse(at, 3);
    return "left " + it.n;
  } catch {
    return "outer " + it.t;
  }
}

function* steps(at: number): Generator<string, void, unknown> {
  const it = at % 2 ? { t: "t" + at } : { t: "t" + (at + 10) };
  try {
    it.t += "y";
    yield "in";
    refuse(at, 1);
  } catch {
    yield it.t;
  }
}

async function later(at: number): Promise<string> {
  const it = at % 2 ? { t: "t" + at } : { t: "t" + (at + 10) };
  try {
    it.t += "y";
    await null;
    refuse(at, 3);
    return "fine";
  } catch {
    return it.t;
  }
}

const seen: (number | string)[] = [];
for (let at = 0; at < 9; at++) {
  seen.push(objects(at), objectsRefusedFirst(at), pairs(at), instances(at), oneTryInAnother(at), ...steps(at), await later(at));
  try {
    leftByFinally(at, seen);
  } catch (error) {
    seen.push((error as Error).message);
  }
}
console.log(seen.join());

// The same in the loop itself, where nothing throws.
const quiet: (number | string)[] = [];
for (let at = 0; at < 9; at++) {
  let it: Row;
  if (at % 3) it = { n: at, t: "t" + at };
  else it = { n: at + 10, t: "t" + (at + 10) };
  try {
    it.t += "y";
    quiet.push(it.n);
  } catch {
    quiet.push(it.t);
  }
}
console.log(quiet.join());
//// a-text-takes-the-place-of-what-a-pattern-finds.ts
// String.prototype.replace with a RegExp and a text, where the RegExp matches: every form of the replacement, of the subject and of the RegExp.
const shown = (text: string): string => JSON.stringify(text);
const face = String.fromCodePoint(0x1f600);
const line = "2026-01-02 10:11:12 info worker-7 finished job 8123 in 41 ms, told ann@host.example";

function pieceOf(text: string, start: number, end: number): string {
  return text.substring(start, end);
}

////= lines-10	joined	first	second	string

const subjects: string[] = [
  line,
  "",
  "a",
  "aaa",
  "  padded  ",
  "ann@host bob@home",
  "x" + face + "y" + face,
  face,
  "\u00e9t\u00e9 \u00e0 la mer",
  "\u0436\u0436 ann@host \u0436",
  pieceOf("0123456789 " + line + " 0123456789", 11, 11 + line.length),
  pieceOf(line + line, 20, 100),
  joined(line.slice(0, 40), line.slice(40)),
  joined("ann@", "host"),
];

const replacements: string[] = [
  "",
  "-",
  "[it]",
  "$&",
  "<$&>",
  "$1",
  "$2$1",
  "$`",
  "$'",
  "$$",
  "$",
  "$0",
  "$3",
  "$10",
  "$01",
  "$<name>",
  "$<none>",
  "$<",
  "\u0436",
  face,
  "$1" + face + "$&",
];

const patterns: RegExp[] = [
  /\b([a-z0-9-]+)@([a-z0-9-]+)/,
  /\b([a-z0-9-]+)@([a-z0-9-]+)/g,
  /\b([a-z0-9-]+)@([a-z0-9-]+)/i,
  /(?<name>[a-z]+)@(?<host>[a-z]+)/,
  /(?<name>[a-z]+)@(?<host>[a-z]+)/g,
  /(?:(?<name>ann)|(?<name>bob))@/g,
  /^\s+/,
  /\s+$/,
  /\s+/g,
  /^\s*(.*?)\s*$/,
  /a*/,
  /a*/g,
  /(?:)/,
  /(?:)/g,
  /(?:)/gu,
  /x*/gu,
  /./gu,
  /./g,
  /.$/u,
  /[^]/gv,
  /(a)|(b)/g,
  /(z)?a/g,
  /\d+/g,
  /\d{4,}/g,
  /(\d+)-(\d+)-(\d+)/,
  /told/,
  /told/g,
  /a/g,
  /a/,
  /@/g,
  /\u0436/g,
  /\u0436+/,
  /(?<=@)[a-z]+/g,
  /(?<!\d)\d\d(?!\d)/g,
  /$/,
  /$/g,
  /^/gm,
  /\b/g,
  /(((((((((((a)))))))))))/,
];

let answers = 0;
for (const pattern of patterns) {
  for (const subject of subjects) {
    const row: string[] = [];
    for (const replacement of replacements) {
      pattern.lastIndex = 3;
      row.push(shown(subject.replace(pattern, replacement)) + "@" + pattern.lastIndex);
      answers++;
    }
    console.log(String(pattern), shown(subject), row.join(" "));
  }
}
console.log(answers, "answers");

// What the last match leaves behind.
const legacy = RegExp as unknown as Record<string, string>;
function leftBehind(): string {
  return [legacy["$&"], legacy["$1"], legacy["$2"], legacy["$`"], legacy["$'"], legacy["$_"]]
    .map(text => shown(text!))
    .join(" ");
}
for (const pattern of [/(\w+)@(\w+)/, /(\w+)@(\w+)/g, /told/, /told/g, /(\d)(\d)/g, /^(\d+)/]) {
  console.log(String(pattern), shown(line.replace(pattern, "#")), leftBehind());
  console.log(String(pattern), shown(line.replace(pattern, "$2")), leftBehind());
  console.log(String(pattern), shown(line.replace(pattern, "")), leftBehind());
}

// A RegExp that is not as it was made.
const sticky = /\d+/y;
sticky.lastIndex = 5;
console.log(shown(line.replace(sticky, "#")), sticky.lastIndex);
console.log(shown(line.replace(sticky, "#")), sticky.lastIndex);
const stickyAndGlobal = /\d+-?/gy;
stickyAndGlobal.lastIndex = 5;
console.log(shown(line.replace(stickyAndGlobal, "#")), stickyAndGlobal.lastIndex);

const frozen = Object.freeze(/\d+/g);
try {
