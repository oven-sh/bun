//// a-text-that-is-read-cut-back-and-joined-with-objects-while-it-grows.ts
// The text is read in the middle of its growth, cut back by a throw, and goes on growing.
////= hash

const kept: string[] = [];
function readWhileGrowing(rounds: number, piece: string): string {
  let out = "";
  for (let i = 0; i < rounds; i++) {
    out += piece;
    out += i;
    if (i % 7 === 3) kept.push(out);
    out += ",";
  }
  return out;
}

function failsAt(i: number, at: number): string {
  if (i === at) throw new RangeError("at " + i);
  return "<" + i + ">";
}

function cutBackByThrow(rounds: number, at: number): string {
  let out = "start";
  for (let i = 0; i < rounds; i++) {
    try {
      out += "a" + failsAt(i, at) + "b";
      out += i;
    } catch (error) {
      out += "!" + (error as Error).message;
    }
  }
  return out;
}

class Talker {
  said = 0;
  constructor(public name: string) {}
  toString(): string {
    this.said++;
    let out = "";
    for (let i = 0; i < this.said; i++) out += this.name + i;
    return out;
  }
  valueOf(): number {
    return this.said * 1000;
  }
}

function withObjects(rounds: number, talker: Talker, thrower: { toString(): string }): string {
  let out = "";
  for (let i = 0; i < rounds; i++) {
    out += talker;
    out += `${talker}`;
    out += String(talker);
    out += "/";
    try {
      out += "before" + thrower;
    } catch {
      out += "caught";
    }
  }
  return out;
}

function withPrimitiveHook(rounds: number): string {
  let calls: string[] = [];
  const hooked = {
    [Symbol.toPrimitive](hint: string) {
      calls.push(hint);
      let inner = "";
      for (let i = 0; i < calls.length; i++) inner += hint + i;
      return inner;
    },
  };
  let out = "";
  for (let i = 0; i < rounds; i++) {
    out += hooked;
    out += `${hooked}`;
    out += ";";
  }
  return out + calls.join();
}

function withBigAndSymbol(): string {
  let out = "";
  for (let i = 0; i < 5; i++) {
    out += 12345678901234567890123456789012345678901234567890n * BigInt(i);
    out += String(Symbol("mark" + i));
    try {
      out += (Symbol("thrown") as unknown as string);
    } catch (error) {
      out += (error as Error).constructor.name;
    }
  }
  return out;
}

function grownByLongPieces(rounds: number): number {
  const long = "L".repeat(70000);
  const wide = "中".repeat(3);
  let out = "";
  let sum = 0;
  for (let i = 0; i < rounds; i++) {
    out += long;
    out += i;
    out += wide;
    out += "tail";
    if (i % 3 === 1) sum = (sum + hash(out)) >>> 0;
  }
  return (sum + hash(out)) >>> 0;
}

for (const rounds of [0, 1, 2, 5, 20, 100, 1000]) {
  for (const piece of ["", "p", "piece of sixteen", "a piece that is longer than sixteen characters", "\xe9", "中"]) {
    kept.length = 0;
    const text = readWhileGrowing(rounds, piece);
    let sum = hash(text);
    for (const earlier of kept) sum = (sum + hash(earlier)) >>> 0;
    console.log(rounds, piece.length, text.length, kept.length, sum);
  }
}
for (const at of [-1, 0, 1, 5, 19]) console.log(cutBackByThrow(20, at));
console.log(hash(withObjects(12, new Talker("t"), { toString() { throw new Error("no"); } })), withObjects(2, new Talker("u"), { toString() { throw new Error("no"); } }));
console.log(withPrimitiveHook(3), hash(withPrimitiveHook(40)));
console.log(withBigAndSymbol());
console.log(grownByLongPieces(1), grownByLongPieces(7), grownByLongPieces(40));
//// a-text-too-long-that-nobody-reads.ts
// A text grows past the longest text there can be, and nobody reads it. The error comes all the same.
function repeat(piece: string, count: number): string {
  let text = "";
  for (let i = 0; i < count; i++) text += piece;
  return text;
}
const big = repeat("M", 1 << 20);
function tries(): string {
  try {
    repeat(big, 4096);
    return "no error";
  } catch (error) {
    return (error as Error).constructor.name;
  }
}
let seen = "";
for (let turn = 0; turn < 3; turn++) seen += tries() + " ";
console.log(seen);
//// adjacent-strings.ts
// The texts of a program's strings lie in one pool in the executable. Whatever stands between them there, each string is what the source says, also where one is the end or a part of another.
declare const console: { log(...args: unknown[]): void }
const parts = ["firstHalfOfAWord", "secondHalfOfAWord", "HalfOfAWord", "OfAWord", "Word", "d", "", "first", "firstHalf", "été", "étéHalf", "日本", "日本語"]
const record: Record<string, number> = { firstHalfOfAWord: 1, secondHalfOfAWord: 2, HalfOfAWord: 3, Word: 4 }
for (const part of parts) console.log(JSON.stringify(part), part.length, record[part] ?? "none", part === "Word", part.endsWith("Word"), part.startsWith("first"), part + "|")
console.log(parts.join(""), Object.keys(record).join(""))
//// alternations-out-of-run-time-text-answer-as-in-plain-bun.ts
// Thousands of patterns with alternations, put together at run time out of a seeded generator, so that none of them is known to the build: lists of words that share first letters and lists that do not,
// nested groups, captures, optional and repeated groups, classes, anchors, lookaheads, back references, with and without the flag i, against subjects of narrow and of wide characters.
// Which alternative wins, where the match lies and what every group holds is printed as a sum for every two hundred patterns. The output is that of plain Bun.
// No alternative is written empty: on a repeated group with an empty alternative, as in /(|[^b]??|)+/ inside a longer pattern, plain Bun misses matches that ECMAScript has and that the compiled program finds.
let seed = 12345 + (typeof process === "object" ? process.argv.length - process.argv.length : 0);
function random(limit: number): number {
  seed = (Math.imul(seed, 1103515245) + 12345) & 0x7fffffff;
  return (seed >>> 8) % limit;
}
function pick(list: string[]): string {
  return list[random(list.length)];
}
const letters = ["a", "b", "c", "A", "B", "x", "é", "Ж", "1", "_", " "];
const classes = ["[ab]", "[^a]", "[a-c]", "\\w", "\\d", "\\s", ".", "[\\u200b\\u0416]", "[^\\u0416b]", "[A-Cx]"];
const quantifiers = ["", "", "", "", "?", "*", "+", "??", "*?", "+?", "{2}", "{1,2}", "{0,2}?"];
function word(): string {
  let text = "";
  for (let i = 1 + random(4); i > 0; i--) text += pick(letters);
  return text;
}
function spacedWord(): string {
  return [...word()].join("[\\u200b_]*");
}
function atom(depth: number, groups: { count: number }): string {
  switch (random(depth > 0 ? 12 : 7)) {
    case 0: case 1: case 2: return pick(letters);
    case 3: case 4: return pick(classes);
    case 5: return word();
    case 6: return pick(["^", "$", "\\b", "\\B"]);
    case 7: return "(?:" + disjunction(depth - 1, groups) + ")";
    case 8: groups.count++; return "(" + disjunction(depth - 1, groups) + ")";
    case 9: return pick(["(?=", "(?!"]) + disjunction(depth - 1, groups) + ")";
    case 10: return groups.count ? "\\" + (1 + random(groups.count)) : pick(letters);
    default: return "(?:" + disjunction(depth - 1, groups) + ")";
  }
}
function alternative(depth: number, groups: { count: number }): string {
  let text = "";
  for (let i = 1 + random(3); i > 0; i--) {
    const piece = atom(depth, groups);
    const isAssertion = piece === "^" || piece === "$" || piece === "\\b" || piece === "\\B" || piece.startsWith("(?=") || piece.startsWith("(?!");
    text += piece.length > 1 && !piece.startsWith("(") && !piece.startsWith("[") && !piece.startsWith("\\") ? piece : piece + (isAssertion ? "" : pick(quantifiers));
  }
  return text;
}
function disjunction(depth: number, groups: { count: number }): string {
  const kind = random(6);
  const count = kind === 0 ? 1 : kind === 1 ? 2 : kind === 2 ? 3 + random(3) : kind === 3 ? 8 + random(30) : 1 + random(4);
  const list: string[] = [];
  for (let i = 0; i < count; i++) list.push(kind === 3 ? (random(2) ? word() : spacedWord()) : alternative(depth, groups));
  return list.join("|");
}
function subject(): string {
  let text = "";
  for (let i = random(24); i > 0; i--) text += random(8) ? pick(letters) : pick(["​", "ab", "abc", "\n", "xA"]);
  return text;
}
let sum = 0;
let made = 0;
const lines: string[] = [];
for (let round = 0; round < 6000; round++) {
  const source = disjunction(2, { count: 0 });
  const flags = pick(["", "i", "g", "gi", "m", "y", "s"]);
  let pattern: RegExp;
  try {
    pattern = new RegExp(source, flags);
  } catch {
    sum = (sum * 31 + 7) | 0;
    continue;
  }
  made++;
  for (let i = 0; i < 4; i++) {
    const text = subject();
    pattern.lastIndex = random(3);
    const match = pattern.exec(text);
    if (!match) {
      sum = (sum * 31 + 1) | 0;
      continue;
    }
    sum = (sum * 31 + match.index + 2) | 0;
    for (const group of match) sum = (sum * 31 + (group === undefined ? 3 : group.length * 5 + (group.charCodeAt(0) | 0))) | 0;
    sum = (sum * 31 + text.replace(pattern, "<$&>").length) | 0;
  }
  if (round % 200 === 199) lines.push(round + 1 + " " + sum);
}
console.log(made);
console.log(lines.join("\n"));
//// anything-compared-with-the-empty-string.ts
const launder = new Function("value", "return value") as <V>(value: V) => V;

class Named {
  name: string;
  nickname: string | undefined;
  note: string | null;
  anything: unknown;
  constructor(name: string, nickname: string | undefined, note: string | null, anything: unknown) {
    this.name = name;
    this.nickname = nickname;
    this.note = note;
    this.anything = anything;
  }
}

const long = "abcdefghijklmnopqrstuvwxyz".repeat(3);
const texts: string[] = [
  "",
  "a",
  " ",
  "\0",
  "ab",
  long,
  long.slice(5, 5),
  long.slice(5, 6),
  long.substring(40),
  long.substring(long.length),
  "é",
  "中",
  "中".slice(1),
  "" + "",
  ["", ""].join(""),
  String(launder("")) + launder(""),
  launder("x") + launder(""),
  launder(long) + launder(long),
  launder("").concat(launder("")),
  " ".trim(),
  "abc".replace("abc", ""),
  String.fromCharCode(),
  new String("").valueOf(),
  `${launder("")}`,
];
const others: unknown[] = [undefined, null, 0, -0, NaN, false, true, 1, 0n, [], [""], {}, new String(""), Symbol.iterator, () => "", { toString: () => "" }];

function ofTypedFields(one: Named): string {
  let said = "";
  said += one.name === "" ? "E" : "n";
  said += one.name !== "" ? "n" : "E";
  said += "" === one.name ? "E" : "n";
  said += one.nickname === "" ? "E" : "n";
  said += one.nickname !== "" ? "n" : "E";
  said += one.note === "" ? "E" : "n";
  said += one.note !== "" ? "n" : "E";
  said += one.anything === "" ? "E" : "n";
  said += one.anything !== "" ? "n" : "E";
  const isEmpty = one.nickname === "";
  const isNot = one.anything !== "";
  said += String(isEmpty) + String(isNot);
  switch (one.nickname) {
    case "":
      said += "|empty";
      break;
    case "a":
      said += "|a";
      break;
    case undefined:
      said += "|undefined";
      break;
    default:
      said += "|other";
  }
  switch (one.anything) {
    case "":
      said += "|empty";
      break;
    case 0:
      said += "|zero";
      break;
    default:
      said += "|other";
  }
  return said;
}

function loosely(value: unknown): string {
  return (value == "" ? "E" : "n") + (value != "" ? "n" : "E") + ("" == value ? "E" : "n");
}

const lines: string[] = [];
for (let round = 0; round < 3; round++) {
  for (let i = 0; i < texts.length; i++) {
    const text = launder(texts[i]);
    const one = launder(new Named(text, i % 3 === 0 ? undefined : text, i % 4 === 0 ? null : text, i % 5 === 0 ? i : text));
    const line = i + " " + text.length + " " + ofTypedFields(one) + " " + loosely(text);
    if (round === 2) lines.push(line);
  }
  for (let i = 0; i < others.length; i++) {
    const one = launder(new Named("x", undefined, null, launder(others[i])));
    const line = "other " + i + " " + ofTypedFields(one) + " " + loosely(others[i]);
    if (round === 2) lines.push(line);
  }
}
console.log(lines.join("\n"));
//// append-by-host-failure.ts
// A conversion that throws inside Bun.escapeHTML leaves the built string as it was before that append.
function fragile(throwOnCall: number): any {
  let calls = 0;
  return {
    toString() {
      if (++calls === throwOnCall) throw new RangeError("conversion " + calls);
      return "<" + calls + ">";
    },
  };
}
function appendStatements(value: any): string {
  let html = "";
  try {
    for (let round = 1; round <= 5; round++) {
      html += "[" + round + "]";
      html += Bun.escapeHTML(value);
    }
  } catch (e) {
    console.log("caught", (e as Error).message, html);
  }
  return html;
}
function appendInOneStatement(value: any): string {
  let html = "start";
  try {
    for (let round = 1; round <= 5; round++) html += "<p>" + round + Bun.escapeHTML(value) + "</p>";
  } catch (e) {
    console.log("caught", (e as Error).message, html);
  }
  return html;
}
function appendWide(value: any): string {
  let html = "日本";
  try {
    for (let round = 1; round <= 5; round++) {
      html += "&" + round;
      html += Bun.escapeHTML(value);
    }
  } catch (e) {
    console.log("caught", (e as Error).message, html);
  }
  return html + "|after";
}
function template(value: any): string {
  try {
    return `<a>${Bun.escapeHTML(value)}</a>`;
  } catch (e) {
    return "template " + (e as Error).message;
  }
}
console.log(appendStatements(fragile(3)));
console.log(appendInOneStatement(fragile(3)));
console.log(appendWide(fragile(3)));
console.log(appendStatements(fragile(1)));
console.log(appendStatements(fragile(9)));
