//// append-escaped-html.ts
// Bun.escapeHTML called through a constant in the middle of a concatenation.
const escape = Bun.escapeHTML;
const log: string[] = [];
////= show-4	length <= 100 ? text : text.slice(0, 40) + ".." + text.slice(-40
const texts = [
  "", "a", "&", "<", ">", '"', "'", "a&b", "<b>bold</b>", `"quoted" & 'single'`, "plain text without anything to escape",
  "0123456789abcde", "0123456789abcdef", "0123456789abcdef0", "0123456789abcde&", "&123456789abcdef0123456789abcdef", "x".repeat(31) + "<", "x".repeat(64) + ">" + "y".repeat(64),
  "café & crème", "ÿ<ÿ", "日本語", "日<本>&語", "😀&", "\ud83d<", "<".repeat(500), "z".repeat(5000), ("w".repeat(99) + "&").repeat(40), "—&".repeat(200),
];
function link(href: string, label: string): string {
  return `<a href="${escape(href)}">${escape(label)}</a>`;
}
function list(items: string[]): string {
  let html = "<ul>";
  for (const item of items) html += "<li>" + escape(item) + "</li>";
  return html + "</ul>";
}
function mixed(text: string, n: number, missing: string | undefined): string {
  let html = "";
  html += escape(text.slice(1)) + `<i>${n}</i>`;
  html += escape(text) + escape(text + "&");
  return `${html}|${escape(missing as string)}|${escape(n as any)}|${escape("a<b")}`;
}
function page(items: string[]): string {
  return `<body>${list(items)}${items.length ? link(items[0]!, items[items.length - 1]!) : ""}</body>`;
}
for (const text of texts) {
  show("link", link(text, text));
  show("mixed", mixed(text, text.length, text.length % 2 ? undefined : text));
  show("same", String(link(text, "x") === '<a href="' + Bun.escapeHTML(text) + '">x</a>'));
}
const long = ("y".repeat(1000) + "&").repeat(2100);
show("long", link(long, "short"));
show("long", link("short", long));
show("long", mixed(long, 1, long));
function emitted(text: string): string {
  let html = "";
  let from = 0;
  const emit = (markup: string, end: number) => {
    html += escape(text.slice(from, end - 1)) + markup;
    from = end;
  };
  for (let at = 0; at < text.length; at++) {
    if (text[at] === "`") emit(`<code>${escape(text.slice(at, at + 2))}</code>`, at + 1);
    else if (text[at] === "[") emit(`<a href="${escape(text.slice(at + 1, at + 4))}" rel="x">${escape(text.slice(at + 2, at + 6))}</a>`, at + 1);
  }
  return html + escape(text.slice(from));
}
for (const text of texts) show("emitted", emitted(text + "`<&>` and [\"'x'\"] " + text));
show("emitted", emitted(long.slice(0, 1100000) + "`" + long));
show("list", list(texts));
show("page", page(texts));
show("page", page([]));

const talker = { toString() { log.push("toString"); return "<t>"; }, valueOf() { log.push("valueOf"); return "<v>"; } };
function loose(value: unknown): string {
  return `[${escape(value as any)}]` + escape(value as any) + "!";
}
show("loose", loose(talker));
show("loose", loose(12.5));
show("loose", loose(null));
show("loose", loose(true));
show("log", log.join(","));

const original = Bun.escapeHTML;
(Bun as any).escapeHTML = (text: string) => {
  log.push("replaced " + text);
  return talker;
};
show("still the original", link("<", ">"));
const replaced: (text: string) => any = Bun.escapeHTML;
function other(text: string): string {
  return `(${replaced(text)})` + replaced(text + "2") + ".";
}
log.length = 0;
show("replaced", other("<x>"));
show("log", log.join(","));
(Bun as any).escapeHTML = original;
show("restored", other("<y>") + link("&", "&"));
//// append-length-limit.ts
// Strings over 2^31 - 1 characters: the RangeError comes from the same concatenation as in plain Bun, with the same side effects before it.
const log: string[] = [];
////= doubled
const powers: string[] = [];
for (let k = 0; k <= 30; k++) powers.push(doubled(k));
const big = powers[30]!;
const half = powers[29]!;

function noisy(label: string, text: string): string {
  log.push(label);
  return text;
}
function attempt(label: string, run: () => string): void {
  log.length = 0;
  let outcome: string;
  try {
    outcome = "length " + run().length;
  } catch (error) {
    outcome = (error as Error).name + ": " + (error as Error).message;
  }
  console.log(label, outcome, log.join(","));
}

function wrap(label: string, text: string, times: number): string {
  let html = "<w>";
  for (let i = 0; i < times; i++) {
    log.push(label + i);
    html += `[${text}]`;
  }
  return html + "</w>";
}
function pair(a: string, b: string): string {
  return `${noisy("a", a)}${wrap("p", b, 1)}${noisy("c", "c")}`;
}
function nested(a: string, b: string, times: number): string {
  return `<n>${noisy("first", a)}${wrap("n", b, times)}${noisy("last", "!")}</n>`;
}
function conditional(a: string, b: string, flag: boolean): string {
  return `<c>${a}${flag ? `(${wrap("t", b, 1)})` : `{${noisy("f", b)}}`}${noisy("end", ".")}</c>`;
}
function everyPower(from: number): string {
  let text = "";
  for (let k = from; k <= 30; k++) text += powers[k]!;
  return text;
}

attempt("small", () => pair("a", "b"));
attempt("half half", () => pair(half, half));
attempt("big half", () => pair(big, half));
attempt("big big", () => pair(big, big));
attempt("inner alone", () => nested("a", big, 2));
attempt("inner alone 3", () => nested("a", big, 3));
attempt("outer only", () => nested(big, half, 1));
attempt("outer only 2", () => nested(big, half, 2));
attempt("conditional true", () => conditional(big, big, true));
attempt("conditional false", () => conditional(big, big, false));
attempt("conditional fits", () => conditional(half, half, true));
attempt("every power", () => everyPower(0));
attempt("every power and one", () => everyPower(0) + "y");
attempt("every power in a template", () => `${everyPower(0)}${noisy("after", "")}`);
attempt("one too many in a template", () => `${everyPower(0)}${noisy("after", "z")}`);
attempt("after all that", () => nested("a", "b", 3));
console.log(nested("a", "b", 2), conditional("p", "q", true), conditional("p", "q", false));
//// append-nested-strings.ts
// A string that is built only to become a part of a longer string: the arms of a conditional, the string of an inner loop, a conditional inside an arm.
// Each function has a neighbor in which building it in place could be seen: the longer string is read in between, an object is converted in front of it, an arm throws.
const log: string[] = [];

function armsOfConditional(names: string[], extra: string): string {
  let out = "";
  for (let i = 0; i < names.length; i++) out += `<li class="${i & 1 ? "a " + extra + " b" : "off"}">${names[i]}</li>`;
  return out;
}

function conditionalIsLastPart(names: string[]): string {
  let out = "";
  for (let i = 0; i < names.length; i++) out += i ? "," + names[i] : names[i];
  return out;
}

function stringOfInnerLoop(rows: string[][]): string {
  let out = "<table>";
  for (const cells of rows) {
    let row = "";
    for (const cell of cells) row += "<td>" + cell + "</td>";
    out += "<tr>" + row + "</tr>";
  }
  return out + "</table>";
}

function twoConditionals(names: string[], first: boolean, second: boolean): string {
  let out = "";
  for (const name of names) out += `<${first ? "x-" + name : "div"}|${name.length}|${second ? name + "!" : "none"}>`;
  return out;
}

function conditionalInsideArm(names: string[]): string {
  let out = "";
  for (let i = 0; i < names.length; i++) out += i % 3 ? "[" + (i % 2 ? "odd " + names[i] : "even") + "]" : "third";
  return out;
}

function partsOfEveryKind(values: (number | boolean | null | undefined | bigint | string)[]): string {
  let out = "";
  for (let i = 0; i < values.length; i++) out += `${i}:${values[i]}:${i & 1 ? values[i] + "/" + i : "-"};`;
  return out;
}

function armReadsLongerString(names: string[]): string {
  let out = "";
  for (let i = 0; i < names.length; i++) out += "<" + (i & 1 ? "at " + out.length : "off") + ">";
  return out;
}

function laterPartReadsLongerString(names: string[]): string {
  let out = "";
  for (let i = 0; i < names.length; i++) out += "<" + (i & 1 ? "a " + names[i] : "off") + "|" + out.length + ">";
  return out;
}

function objectInFront(names: string[]): string {
  let out = "";
  for (let i = 0; i < names.length; i++) {
    const noisy = { toString() { log.push("converted " + i); return "o" + i; } };
    out += `${noisy}${i & 1 ? (log.push("arm " + i), "a " + names[i]) : "off"};`;
  }
  return out;
}

function armThrows(names: string[]): string {
  let out = "";
  for (let i = 0; i < names.length; i++) {
    try {
      out += "<" + (i % 3 === 2 ? "bad " + fail(names[i]) : "ok " + names[i]) + ">";
    } catch (error) {
      out += "(" + (error as Error).message + ")";
    }
  }
  return out;
}

function fail(name: string): string {
  throw new Error("no " + name);
}

function laterPartThrows(names: string[]): string {
  let out = "";
  for (let i = 0; i < names.length; i++) {
    try {
      out += "<" + (i & 1 ? "a " + names[i] : "off") + "|" + (i % 3 === 2 ? fail(names[i]) : names[i]) + ">";
    } catch {
      out += "?";
    }
  }
  return out;
}

function beginsAgainInInnerLoop(rows: string[][]): string {
  let out = "";
  for (const cells of rows) {
    let row = "";
    for (const cell of cells) {
      if (cell === "reset") row = "z";
      row += cell;
    }
    out += "[" + row + "]";
  }
  return out;
}

function carriedBesideLongerString(names: string[]): string {
  let out = "";
  let previous = "x";
  for (const name of names) {
    out += "<" + previous + ">";
    previous = "y" + name;
  }
  return out + previous;
}

function nestedStringReadTwice(names: string[]): string {
  let out = "";
  let longest = "";
  for (let i = 0; i < names.length; i++) {
    const label = i & 1 ? "a " + names[i] : "off";
    out += label;
    if (label.length > longest.length) longest = label;
  }
  return out + "|" + longest;
}

function leavesLoopInArm(names: string[]): string {
  let out = "";
  for (let i = 0; i < names.length; i++) {
    let label: string;
    if (names[i] === "stop") break;
    else if (i & 1) label = "a " + names[i];
    else label = "off";
    out += "<" + label + ">";
  }
  return out;
}

const names = ["alpha", "beta", "gamma", "delta", "épsilon", "ζήτα", "eta"];
const rows = [["a", "b"], [], ["c"], ["d", "reset", "e", "f"], ["ж", "reset"]];
for (let round = 0; round < 3; round++) {
  console.log(armsOfConditional(names, "c" + round));
  console.log(armsOfConditional([], "none"));
  console.log(conditionalIsLastPart(names));
  console.log(stringOfInnerLoop(rows));
  console.log(twoConditionals(names, round === 0, round === 1));
  console.log(conditionalInsideArm(names));
  console.log(partsOfEveryKind([1, -0, 1.5, NaN, true, null, undefined, 12n, "s", 1e21]));
  console.log(armReadsLongerString(names));
  console.log(laterPartReadsLongerString(names));
  console.log(objectInFront(names.slice(0, 3)), log.splice(0).join(","));
  console.log(armThrows(names));
  console.log(laterPartThrows(names));
  console.log(beginsAgainInInnerLoop(rows));
  console.log(carriedBesideLongerString(names));
  console.log(nestedStringReadTwice(names));
  console.log(leavesLoopInArm(["one", "two", "three", "stop", "four"]));
}
//// append-nested-strings-length-limit.ts
// A string built only to become a part of a longer string, where the longer string passes 2^31 - 1 characters:
// the RangeError comes from the same concatenation as in plain Bun, with the same side effects before it, and is caught by the same catch.
const log: string[] = [];
////= doubled
const big = doubled(30);
const half = doubled(29);

function noisy(label: string, text: string): string {
  log.push(label);
  return text;
}
////= attempt-3	result	result.length < 20 ? result : "length " + result.length	","

function nothingAfterArm(first: string, text: string, times: number): string {
  let out = first;
  for (let i = 0; i < times; i++) out += "<" + (i & 1 ? text + "x" : "off") + ">";
  return out;
}

function callAfterArm(first: string, text: string, times: number): string {
  let out = first;
  for (let i = 0; i < times; i++) out += "<" + (i & 1 ? text + "x" : "off") + noisy("after " + i, ">");
  return out;
}

function conversionAfterArm(first: string, text: string, values: (string | undefined | number)[]): string {
  let out = first;
  for (let i = 0; i < values.length; i++) out += `<${i & 1 ? text + "x" : "off"}|${values[i]}>`;
  return out;
}

////= lines-41	objectConvertedAfterArm	`<${i & 1 ? text + "x" : "off"}|${noisyObject}>`

////= lines-41	objectConvertedInArm	"<" + (i & 1 ? text + noisyObject : "off") + ">"

function callInArm(first: string, text: string, times: number): string {
  let out = first;
  for (let i = 0; i < times; i++) out += "<" + (i & 1 ? noisy("arm " + i, text) + "x" : "off") + ">";
  return out;
}

function callInInnerLoop(first: string, text: string, times: number): string {
  let out = first;
  for (let i = 0; i < 2; i++) {
    let row = "";
    for (let j = 0; j < times; j++) row += noisy("cell " + i + j, text);
    out += "[" + row + "]";
  }
  return out;
}

function storeInInnerLoop(first: string, text: string, times: number, seen: number[]): string {
  let out = first;
  for (let i = 0; i < 2; i++) {
    let row = "";
    for (let j = 0; j < times; j++) {
      row += text;
      seen[0] = i * 10 + j;
    }
    out += "[" + row + "]";
  }
  return out;
}

////= lines-38	leavesAfterArm	leaveAt	leaveAt) return "left at " + i

////= lines-38	skipsAfterArm	skipAt	skipAt) continue

function armInItsOwnTry(first: string, text: string, times: number): string {
  let out = first;
  for (let i = 0; i < times; i++) {
    let label: string;
    try {
      label = i & 1 ? text + "x" : "off";
    } catch {
      label = "caught";
      log.push("caught in the arm " + i);
    }
    out += "<" + label + ">";
  }
  return out;
}

function counterSeenByCatch(first: string, text: string, times: number): string {
  let out = first;
  let j = 0;
  try {
    for (let i = 0; i < 2; i++) {
      let row = "";
      for (j = 0; j < times; j++) row += text;
      out += "[" + row + "]";
    }
  } catch (error) {
    return (error as Error).name + " at " + j;
  }
  return out;
}

const seen = [-1];
attempt("nothing after the arm, fits", () => nothingAfterArm(half, half, 2));
attempt("nothing after the arm", () => nothingAfterArm(big, big, 2));
attempt("a call after the arm, fits", () => callAfterArm(half, half, 2));
attempt("a call after the arm", () => callAfterArm(big, big, 2));
attempt("a conversion after the arm, fits", () => conversionAfterArm(half, half, [1, undefined]));
attempt("a conversion after the arm", () => conversionAfterArm(big, big, [1, undefined]));
attempt("an object converted after the arm", () => objectConvertedAfterArm(big, big, 2));
attempt("an object converted in the arm, fits", () => objectConvertedInArm(half, half, 2));
attempt("an object converted in the arm", () => objectConvertedInArm(big, big, 2));
attempt("a call in the arm", () => callInArm(big, big, 2));
attempt("a call in the inner loop, fits", () => callInInnerLoop("a", "b", 2));
attempt("a call in the inner loop", () => callInInnerLoop(big, half, 2));
attempt("a store in the inner loop", () => storeInInnerLoop(big, half, 2, seen) + seen[0]);
console.log("stored", seen[0]);
attempt("leaves after the arm", () => leavesAfterArm(big, big, 1));
attempt("does not leave", () => leavesAfterArm(big, big, 5));
attempt("skips after the arm", () => skipsAfterArm(big, big, 1));
attempt("the arm in its own try", () => armInItsOwnTry(big, big, 2));
attempt("the counter seen by the catch", () => counterSeenByCatch(big, half, 2));
attempt("after all that", () => callAfterArm("a", "b", 3));
//// append-pieces-chosen-by-conditions.js
// Strings chosen by a condition are pieces of a template that is itself chosen by a condition and then concatenated.
function describe(item, colors) {
  const kind = item.isClass ? "a-class" : "a-function";
  const color = item.isClass ? colors.classes : colors.functions;
  const first = item.isAsync ? `async ` : "";
  const second = item.isGenerator ? `*` : "";
  const label = item.isClass ? `[class ${item.name}]` : `[${first}${second}function ${item.name}]`;
  return `<i class="${kind}" style="${color}">` + label + "</i>";
}
console.log(describe({ name: "f", isAsync: true }, { classes: "red", functions: "blue" }));
console.log(describe({ name: "C", isClass: true }, { classes: "red", functions: "blue" }));
console.log(describe({ name: "g", isGenerator: true }, { classes: "red", functions: "blue" }));
console.log(describe({ name: "h", isAsync: true, isGenerator: true }, { classes: "red" }));
console.log(describe({}, {}));
//// append-pieces-of-wide-texts.ts
// Pieces of a text that holds a character outside Latin-1 are appended in loops, as they are and escaped: the pieces that are Latin-1 themselves, those that are not, and the texts whole. The answers are plain Bun's.
const escape = Bun.escapeHTML;
////= show-4	length <= 120 ? text : text.slice(0, 50) + ".." + text.slice(-50
function pieces(text: string, size: number): string {
  let out = "";
  for (let at = 0; at < text.length; at += size) out += "[" + text.slice(at, at + size) + "]";
  return out;
}
function escapedPieces(text: string, size: number): string {
  let out = "";
  for (let at = 0; at < text.length; at += size) out += "<i>" + escape(text.slice(at, at + size)) + "</i>";
  return out;
}
function escapedWords(text: string): string {
  let out = "";
  for (const word of text.split(" ")) out += escape(word) + "|";
  return out;
}
function words(text: string): string {
  let out = "";
  for (const word of text.split(" ")) out += word + "|";
  return out;
}
function whole(texts: string[]): string {
  let out = "";
  for (const text of texts) out += escape(text) + "," + text + ";";
  return out;
}
const texts: string[] = [
  "plain words <b>and</b> 'marks' & \"more\" 東京",
  "東京 at the start, café & crème after it",
  "one 😀 pair, a lone \ud83d half & another \ude00 half",
  "ÿþý <Latin-1> only until here: 語",
  "語",
  "a語",
  "<語>",
  "0123456789abcdef".repeat(20) + "&語" + "0123456789abcdef".repeat(20),
];
for (const text of texts) {
  for (const size of [1, 2, 3, 7, 16, 33, 1000]) {
    show("pieces " + size, pieces(text, size));
    show("escaped pieces " + size, escapedPieces(text, size));
  }
  show("words", words(text));
  show("escaped words", escapedWords(text));
  show("a slice of a slice", escapedPieces(text.slice(1, -1), 5));
  show("a rope", escapedPieces(text + "|" + text, 9));
}
show("whole", whole(texts));
let total = 0;
for (let round = 0; round < 3000; round++) {
  total += escapedPieces("round " + round + " <of> many & 東京 " + (round % 5 ? "" : "😀"), 4).length + words("a b " + round + " 語").length;
  if (round % 1000 === 0) Bun.gc(true);
}
console.log(total);
//// append-slices-and-conversions.ts
////= show-4	slice(0, 24)), JSON.stringify(text.slice(-24

////= lines-22	appendSlices	slice	i	j
////= lines-22	appendSubstrings	substring	j	i
function appendNumbers(count: number): string {
  let out = "";
  for (let n = 0; n < count; n++) out += String(n * 37 - 1000);
  return out;
}
function appendFractions(count: number): string {
  let out = "";
  for (let n = 0; n < count; n++) out += String(n / 4);
  return out;
}

let other = "";
const noisy = {
  toString(): string {
    other += "x";
    return "<" + other.length + ">";
  },
};
function appendObjects(o: { toString(): string }, count: number): string {
  let out = "";
  for (let n = 0; n < count; n++) out += String(o);
  return out;
}
////= lines-30	appendBackwardSlice	1	slice	1	3
////= lines-30	appendOpenEndedSlice	undefined	substring	3	undefined
function appendSymbol(value: symbol | string): string {
  let out = "a";
  out += String(value);
  out += "b";
  return out;
}
function appendRegisteredSymbol(): string {
  let out = "a";
  out += String(Symbol.for("registered"));
  out += "b";
  return out;
}
function appendUntilThrow(o: { toString(): string }): string {
  let out = "kept";
  try {
    out += "-more";
    out += String(o);
    out += "-not reached";
  } catch (error) {
    out += "|" + (error as Error).message;
  }
  return out;
}

const latin = "abcdefghijklmnop";
const wide = "abcdefg日本語hijklm";
const rope = latin + String(latin.length) + wide.slice(0, 4);
const view = ("<<" + latin + latin + ">>").slice(2, -2);

show("slices", appendSlices(latin, 10000));
show("substrings", appendSubstrings(latin, 10000));
show("wide slices", appendSlices(wide, 10000));
show("wide substrings", appendSubstrings(wide, 10000));
show("rope slices", appendSlices(rope, 10000));
show("rope substrings", appendSubstrings(rope, 10000));
show("view slices", appendSlices(view, 10000));
show("view substrings", appendSubstrings(view, 10000));
show("numbers", appendNumbers(10000));
show("fractions", appendFractions(10000));
show("objects", appendObjects(noisy, 10000));
show("other", other);

console.log(appendBackwardSlice(latin), appendBackwardSlice(wide));
console.log(appendOpenEndedSlice(latin), appendOpenEndedSlice(wide));
console.log(appendSymbol(Symbol("s")), appendSymbol("text"), appendRegisteredSymbol());
console.log(appendUntilThrow({ toString(): string { throw new Error("no text"); } }));
console.log(appendUntilThrow({ toString(): string { return "fine"; } }));

export {};
//// appends-of-every-length.js
const pieces = [];
for (let length = 0; length <= 300; length++) pieces.push("abcdefghijklmnopqrstuvwxyz0123456789".repeat(9).slice(0, length));
pieces.push("é".repeat(5), "中文", "x" + "y".repeat(70000), ("r" + process.argv.length) + ("s" + process.argv.length));
function join(a, b, c) { return "<" + a + "|" + b + "|" + c + ">"; }
let sum = 0, text = "";
for (let i = 0; i < pieces.length; i++) {
  const joined = join(pieces[i], pieces[(i * 7 + 3) % pieces.length], pieces[pieces.length - 1 - i]);
  sum = (sum * 31 + joined.length) % 1000003;
