const narrowFiller = "abXi\u00f8cdy\u00e9efgwx\u00c9h";
const wideFiller = "ab\u0278c\u7800\u01e9d\u00e9exf\u0178g\u7801\u78e9";

for (let length = 0; length <= 80; length++) {
