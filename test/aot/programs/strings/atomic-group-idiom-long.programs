//// concatenation-untyped.js
// String concatenations with numbers among their operands, and their use as property keys (the same program without type annotations).
const print = (s) => console.log(s);
////= show-5
export function pairKey(a, b) {
  return a.id + "," + b.id;
}
export function templateKey(a, b, postfix) {
  return `${a.id},${b.id}${postfix}`;
}
export function idAndAlias(a, alias) {
  return a.id + alias;
}
export function aliasAndId(alias, a) {
  return alias + a.id;
}
export function three(a, b, c) {
  return a + ":" + b + ":" + c;
}
export function named(a, n) {
  return a.name + "#" + n;
}
export function stringsOnly(a, b) {
  return a.name + "," + b.name;
}
export function withBoolean(a, flag) {
  return a.id + "," + flag;
}
export function usedTwice(a, b) {
  const head = a.id + ",";
  return head + b.id + head;
}
export function textTwice(a) {
  const text = "" + a.id;
  return text + "/" + text;
}
export function manyParts(a) {
  return a + "a" + a + "b" + a + "c" + a + "d" + a + "e" + a;
}
export function longConstant(a) {
  return "0123456789012345678901234567890123456789012345678901234" + a;
}
export function appended(ids) {
  let result = "";
  for (const id of ids) {
    if (result.length)
      result += ",";
    result += id;
  }
  return result;
}
export function between(a, b, log) {
  const head = a.name + a.id;
  log.push("between");
  return head + b.id;
}
export function handled(a, b) {
  try {
    return a.id + "," + b.id;
  } catch {
    return a.id + "!";
  }
}
export function integers(s, i) {
  return s.length + ":" + (i | 0) + ":" + (i >>> 0);
}
const numbers = [0, -0, 1, 9, 10, 1023, 1024, 65535, 123456, 2147483647, 2147483648, -1, -2147483648, -2147483649, 4294967295, 9007199254740992, -9007199254740992, 1000000000000000000000, 0.0000001, 0.1, -0.5, 1.5, NaN, 1 / 0, -1 / 0, , 0.];
const strings = ["", "x", "@12", "caf\xE9", "\u65E5\u672C", "a".repeat(30), "a".repeat(40), "a".repeat(41), "a".repeat(42), "a".repeat(52), "a".repeat(53), "a".repeat(64), "a".repeat(200), cat("ab", "cd"), cat3("a", "b", "c"), part("xxabcdefxx", 2, 8), flattened(cat("ab", "cd")), cat("\u65E5", "x")];
function check(made, expected, what) {
  return made === expected && made.length === expected.length ? "" : " DIFFERS " + what + " " + show(made) + " " + show(expected);
}
let bad = "";
let sum = 0;
function note(s) {
  for (let i = 0;i < s.length; i++)
    sum = sum * 31 + s.charCodeAt(i) | 0;
}
for (const x of numbers) {
  for (const y of numbers) {
    const a = { id: x, name: "n" + x }, b = { id: y, name: "m" };
    const X = String(x), Y = String(y);
    bad += check(pairKey(a, b), [X, Y].join(","), "pairKey") + check(three(x, y, x), [X, Y, X].join(":"), "three") + check(usedTwice(a, b), X + "," + Y + X + ",", "usedTwice") + check(handled(a, b), [X, Y].join(","), "handled");
    note(pairKey(a, b));
    note(withBoolean(a, y > 0));
    for (const s of strings) {
      bad += check(templateKey(a, b, s), [X, Y].join(",").concat(s), "templateKey");
      if (x === y)
        bad += check(idAndAlias(a, s), X.concat(s), "idAndAlias") + check(aliasAndId(s, a), s.concat(X), "aliasAndId") + check(named({ id: 0, name: s }, x), s.concat("#", X), "named") + check(stringsOnly({ id: 0, name: s }, b), s.concat(",m"), "stringsOnly");
    }
  }
  bad += check(textTwice({ id: x, name: "" }), String(x) + "/" + String(x), "textTwice") + check(manyParts(x), [x, x, x, x, x, x].map(String).join("?").replace("?", "a").replace("?", "b").replace("?", "c").replace("?", "d").replace("?", "e"), "manyParts");
  bad += check(longConstant(x), "0123456789012345678901234567890123456789012345678901234".concat(String(x)), "longConstant") + check(integers("abc", x), "3:" + String(x | 0) + ":" + String(x >>> 0), "integers");
}
print("differences:" + bad + " " + sum);
print(appended([]) + "|" + appended([5]) + "|" + appended([1, 22, 333, 4444, 55555, 666666, 7777777, 88888888, 999999999, 1.5, -0, NaN]) + "|" + appended(Array.from({ length: 40 }, (_, i) => i * 1000)).length);
const log = [];
print(between({ id: 1, name: "n" }, { id: 2, name: "" }, log) + " " + log.join());
const map = new Map;
const set = new Set;
const record = {};
for (let i = 0;i < 300; i++) {
  const a = { id: i * 37, name: "" }, b = { id: 1e5 - i, name: "" };
  map.set(pairKey(a, b), i);
  set.add(templateKey(a, b, i & 1 ? "" : ":1"));
  record[idAndAlias(a, "@" + i)] = i;
}
let found = 0;
for (let i = 0;i < 300; i++) {
  const plain = String(i * 37) + "," + String(1e5 - i);
  if (map.get(plain) === i)
    found++;
  if (map.get(pairKey({ id: i * 37, name: "" }, { id: 1e5 - i, name: "" })) === i)
    found++;
  if (set.has(plain + (i & 1 ? "" : ":1")))
    found++;
  if (record[String(i * 37) + "@" + String(i)] === i)
    found++;
  if (map.has(three(i, i, i)))
    found--;
}
print("found " + found + " of 1200; " + map.size + " " + set.size + " " + Object.keys(record).length + " " + [...map.keys()].slice(0, 3).join(" "));
function nil() {
  return numbers.length > 1000 ? { id: 1, name: "" } : undefined;
}
print(attempt(() => pairKey(nil(), { id: 1, name: "" })) + " " + attempt(() => pairKey({ id: 1, name: "" }, nil())) + " " + attempt(() => templateKey({ id: 1, name: "" }, nil(), "")));
globalThis.kept = [pairKey, templateKey, idAndAlias, aliasAndId, three, named, stringsOnly, withBoolean, usedTwice, textTwice, manyParts, longConstant, appended, between, handled, integers];
