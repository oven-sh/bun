//// code-units-of-letters-and-pieces-cut-from-a-string.ts
// The code units of what was cut from a string: letters of a for-of loop (pairs of surrogates too), slices, substrings, characters by index, positions outside the piece.
function sumOfLetters(text: string): number {
  let sum = 0;
  for (const letter of text) sum += letter.charCodeAt(0);
  return sum;
}
function secondUnits(text: string): string {
  const units: number[] = [];
  for (const letter of text) units.push(letter.charCodeAt(1));
  return units.join(",");
}
function codePoints(text: string): string {
  const points: (number | undefined)[] = [];
  for (const letter of text) points.push(letter.codePointAt(0));
  return points.join(",");
}
function unitOfSlice(text: string, from: number, to: number, position: number): number {
  return text.slice(from, to).charCodeAt(position);
}
function unitOfSubstring(text: string, from: number, to: number, position: number): number {
  return text.substring(from, to).charCodeAt(position);
}
function unitOfPieceOfPiece(text: string, from: number, position: number): number {
  return text.slice(from).slice(1, 4).charCodeAt(position);
}
function unitOfEither(first: string, second: string, takeFirst: boolean, position: number): number {
  const piece = takeFirst ? first.slice(1, 3) : second.slice(2);
  return piece.charCodeAt(position);
}
const texts = ["iteration", "", "a", "né", "a\u{1F600}b", "\uD83D", "\uDE00\uD83D", "x".repeat(40) + "yz", "left" + String(Date.now() > 0 ? "-right" : "")];
for (const text of texts) {
  console.log(JSON.stringify(text.length), sumOfLetters(text), secondUnits(text), codePoints(text));
  for (const from of [0, 1, 3, -2, 50, 1.5, NaN])
    for (const to of [0, 2, 5, -1, 60])
      for (const position of [0, 1, 2, -1, 7, 0.5, NaN])
        console.log(unitOfSlice(text, from, to, position), unitOfSubstring(text, from, to, position), unitOfPieceOfPiece(text, from, position));
  for (const position of [0, 1, 2, 3, -1]) console.log(unitOfEither(text, "second", true, position), unitOfEither("first", text, false, position));
}
//// collections-iterated-from-untyped-code.ts
// `for..of` through a value of no known type over Sets and Maps of every kind of key, their iterators, changed while they are stepped through: deleted from, added to, cleared, grown past a rehash.
const out: string[] = [];
function all(x: any): string { const seen: string[] = []; for (const v of x) seen.push(Array.isArray(v) ? "[" + v.map(String).join(",") + "]" : typeof v === "symbol" ? v.toString() : Object.is(v, -0) ? "-0" : String(v)); return seen.join(" "); }
function some(x: any, stopAt: number): string { const seen: string[] = []; for (const v of x) { seen.push(String(v)); if (seen.length === stopAt) break; } return seen.join(" "); }
function changing(x: any, change: (v: any, turn: number) => void, limit = 60): string { const seen: string[] = []; let turn = 0; for (const v of x) { seen.push(String(v)); change(v, turn++); if (turn >= limit) break; } return seen.join(" "); }
const o = { toString() { return "object"; } }, sym = Symbol("s");
const kinds: [string, () => unknown[]][] = [
    ["integers", () => [0, 7, 14, 21, 28, 35]], ["doubles", () => [0.5, -0, NaN, Infinity, 1e21, 2 ** 31]], ["strings", () => ["a", "bb", "", "ccc", "7", "a b"]],
    ["mixed", () => [1, "1", true, null, undefined, o, sym, 10n, "x"]], ["none", () => []], ["one", () => [42]],
];
for (const [name, make] of kinds) {
    const keys = make();
    const set = new Set<unknown>(keys), map = new Map<unknown, unknown>(keys.map((k, i) => [k, i]));
    out.push(name + " | " + [all(set), all(set.values()), all(set.keys()), all(set.entries()), all(map), all(map.keys()), all(map.values()), all(map.entries())].join(" | "));
    out.push(name + " left early | " + [some(set, 2), some(map.keys(), 2), some(map.values(), 1), some(set, 100)].join(" | "));
    const it = set.values(); it.next();
    out.push(name + " begun elsewhere | " + all(it) + " | " + all(it));
}
for (const start of [[1, 2, 3, 4, 5, 6, 7, 8], ["a", "b", "c", "d", "e", "f", "g", "h"]] as unknown[][]) {
    const fresh = () => new Set<unknown>(start);
    let s = fresh(); out.push("deletes what comes next | " + changing(s, (v, t) => s.delete(start[t + 1 + (t & 1)])) + " | " + all(s));
    s = fresh(); out.push("deletes itself | " + changing(s, v => s.delete(v)) + " | " + all(s));
    s = fresh(); out.push("deletes and adds itself again | " + changing(s, (v, t) => { if (t < 12) { s.delete(v); s.add(v); } }) + " | " + all(s));
    s = fresh(); out.push("adds | " + changing(s, (v, t) => { if (t < 40) s.add(typeof v === "number" ? 100 + t : "k" + t); }).length + " | " + s.size);
    s = fresh(); out.push("clears | " + changing(s, (v, t) => { if (t === 2) s.clear(); }) + " | " + all(s));
    s = fresh(); out.push("clears and fills | " + changing(s, (v, t) => { if (t === 2) { s.clear(); s.add("new"); s.add(5); s.add(start[0]); } }) + " | " + all(s));
    s = fresh(); out.push("another kind of key comes | " + changing(s, (v, t) => { if (t === 1) { s.add(typeof v === "number" ? "text" : 99); s.add(o); } }) + " | " + all(s));
    s = fresh(); out.push("two at once | " + changing(s, v => { out.push("  inner " + some(s, 3)); }, 2));
    const m = new Map<unknown, unknown>(start.map((k, i) => [k, i]));
    out.push("a map's values, deleted from | " + changing(m.values(), (v, t) => m.delete(start[t + 2])) + " | " + all(m));
    const m2 = new Map<unknown, unknown>(start.map((k, i) => [k, i]));
    out.push("a map's keys, grown | " + changing(m2.keys(), (v, t) => { if (t < 30) m2.set(typeof v === "number" ? 1000 + t : "z" + t, t); }).length + " | " + m2.size);
}
let total = 0; const big = new Set<unknown>(); for (let i = 0; i < 5000; i++) big.add(i * 3); for (let r = 0; r < 20; r++) for (const v of big as any) total += v; out.push("big " + total);
console.log(out.join("\n"));
//// compare-with-literals.ts
// Strings in every internal representation, undefined, null, numbers and objects are compared with string literals of 0 to 33 characters and with non-ASCII literals: === !== == != as a condition and as a value, in loops and outside, typed string, string | undefined and unknown.
const opaque = new Function("value", "return value") as <T>(value: T) => T;
const unseen = new Function("f", "return (...values) => f(...values)") as <F>(f: F) => F;

const flat = (text: string): string => opaque(text.split("").join(""));
const rope = (text: string): string => (text.length < 2 ? flat(text) : flat(text.slice(0, 1)) + flat(text.slice(1)));
const substring = (text: string): string => flat("<" + text + ">").slice(1, -1);
const wide = (text: string): string => flat(text + "☃").replace("☃", "");
const wideSubstring = (text: string): string => flat("☃" + text).slice(1);
const wideRope = (text: string): string => (text.length < 2 ? wide(text) : wide(text.slice(0, 1)) + wide(text.slice(1)));
const mixedRope = (text: string): string => (text.length < 2 ? flat(text) : flat(text.slice(0, 1)) + wide(text.slice(1)));
const makers = [flat, rope, substring, wide, wideSubstring, wideRope, mixedRope];

// Every code unit is the literal's plus 0x100: a comparison that looks at the low bytes alone finds it equal.
const raised = (text: string): string => String.fromCharCode(...text.split("").map(unit => unit.charCodeAt(0) + 0x100));

function nearMisses(text: string): string[] {
  if (text.length === 0) return [" ", "\0", "☃"];
  const middle = text.length >> 1;
  return [text.slice(0, -1), text + text.slice(-1), text + "\0", "~" + text.slice(1), text.slice(0, -1) + "~", text.slice(0, middle) + "~" + text.slice(middle + 1)];
}

function stringsFor(text: string): string[] {
  const subjects = makers.map(make => make(text));
  subjects.push(raised(text));
  for (const miss of nearMisses(text)) for (const make of makers) subjects.push(make(miss));
  subjects.push(flat(""));
  return subjects;
}

function optionalsFor(text: string): (string | undefined)[] {
  return [...stringsFor(text), undefined];
}

function valuesFor(text: string): unknown[] {
  const others: unknown[] = [undefined, null, 0, -0, 7, 7.5, NaN, true, false, 7n, Symbol.iterator, {}, [], [text], [[text]], { toString: () => text }, { valueOf: () => text }, new String(text)];
  return (stringsFor(text) as unknown[]).concat(others);
}

type Check = {
  text: string;
  ofString: (s: string) => number;
  ofOptional: (s: string | undefined) => number;
  ofUnknown: (x: unknown) => number;
  ofStrings: (list: string[], masks: number[]) => void;
  ofOptionals: (list: (string | undefined)[], masks: number[]) => void;
  ofUnknowns: (list: unknown[], masks: number[]) => void;
};

const checks: Check[] = [
  {
    text: "",
    ofString: (s: string): number => (s === "" ? 1 : 0) | (s !== "" ? 2 : 0) | (s == "" ? 4 : 0) | (s != "" ? 8 : 0) | ("" === s ? 16 : 0) | (Number(s === "") << 5),
    ofOptional: (s: string | undefined): number => (s === "" ? 1 : 0) | (s !== "" ? 2 : 0) | (s == "" ? 4 : 0) | (s != "" ? 8 : 0) | ("" === s ? 16 : 0) | (Number(s === "") << 5),
