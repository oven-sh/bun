      yield "2";
    case "three":
      yield "3";
      return;
    default:
      try {
        yield "d";
      } finally {
        yield "f";
      }
  }
  yield s === "one" ? "end one" : s === "two" ? "end two" : "end";
}
export function searchCaught(s) {
