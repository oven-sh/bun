//// every-spelling-of-a-conversion-answers-the-same.ts
// `+text` and `Number(text)`, `String(value)` and a template: the spellings of one conversion answer the same, whatever the text or the value.
const texts: string[] = ["", " ", "0", "-0", "12", " 12 ", "1e3", "1e400", "-1e400", ".5", "5.", "0x1f", "0b101", "0o17", "0x", "1_000", "Infinity", "-Infinity", "+Infinity", "infinity", "NaN",
  "12px", "1 2", "\n7\t", " 7﻿", "9007199254740993", "0.1", "1e-7", "123456789012345678901234567890", "١", "١٢", "+", "-", "+-1", "1n", "٣", "😀", "1\u0000"];
const ropes: string[] = texts.map((text, index) => text + (index & 1 ? "" : "") + "1".repeat(index % 3));
const wide: string[] = texts.map(text => (text + "一").slice(0, -1));

function plus(text: string): number { return +text; }
function called(text: string): number { return Number(text); }
function minusZero(text: string): number { return text as any - 0; }
function timesOne(text: string): number { return (text as any) * 1; }
function ofASlice(text: string): number { return +text.slice(1); }
function ofASum(a: string, b: string): number { return +(a + b); }
function ofEither(value: string | number): number { return +value; }
function ofMaybe(value: string | undefined): number { return +(value as any); }
function show(n: number): string { return Object.is(n, -0) ? "-0" : String(n); }

for (const list of [texts, ropes, wide]) {
  console.log(list.map(text => show(plus(text))).join());
  console.log(list.every(text => Object.is(plus(text), called(text)) && Object.is(plus(text), timesOne(text)) && Object.is(minusZero(text), called(text) - 0)));
  console.log(list.map(text => show(ofASlice(text))).join());
  console.log(list.map((text, index) => show(ofASum(text, list[(index + 1) % list.length]))).join());
  console.log(list.map((text, index) => show(ofEither(index & 1 ? text : index)) + show(ofMaybe(index & 2 ? text : undefined))).join());
}

const numbers: number[] = [0, -0, 1, -1, 7, 255, 256, 1023, 65536, 2147483647, -2147483648, 2147483648, 4294967296, 9007199254740991, 9007199254740992, 1e21, 1e-7, 0.1, 1.5, -1.5, NaN, Infinity, -Infinity, 123456789.125];
function stringOfNumber(n: number): string { return String(n); }
function templateOfNumber(n: number): string { return `${n}`; }
function stringOfInteger(n: number): string { return String(n | 0); }
function stringOfUnsigned(n: number): string { return String(n >>> 0); }
function stringOfText(s: string): string { return String(s); }
function stringOfBoolean(b: boolean): string { return String(b); }
function stringOfBigInt(b: bigint): string { return String(b); }
function stringOfMaybeNumber(n: number | undefined): string { return String(n); }
function stringOfMaybeText(s: string | null): string { return String(s); }
function stringOfTextOrNumber(v: string | number): string { return String(v); }
function stringOfPrimitive(v: string | number | boolean | bigint | null | undefined): string { return String(v); }
function stringOfAnything(v: unknown): string { return String(v); }
function stringOfNothing(): string { return String(); }

console.log(numbers.map(stringOfNumber).join(), numbers.every(n => stringOfNumber(n) === templateOfNumber(n) && stringOfNumber(n) === "" + n && stringOfNumber(n) === n.toString()));
console.log(numbers.map(stringOfInteger).join(), numbers.map(stringOfUnsigned).join());
console.log(texts.every(text => stringOfText(text) === text), ropes.every(text => stringOfText(text) === text), stringOfBoolean(true), stringOfBoolean(false), stringOfBigInt(-12345678901234567890n), JSON.stringify(stringOfNothing()));
console.log(numbers.map((n, index) => stringOfMaybeNumber(index & 1 ? n : undefined)).join(), texts.slice(0, 6).map((text, index) => stringOfMaybeText(index & 1 ? text : null)).join("|"));
console.log(numbers.map((n, index) => stringOfTextOrNumber(index & 1 ? n : "t" + index)).join());
console.log([1, "a", true, 2n, null, undefined, 1.5, -0].map(stringOfPrimitive).join());
console.log([1, "a", Symbol("s"), Symbol(), { toString() { return "mine"; } }, [1, [2, 3]], null, undefined, () => 1, new Date(0).getTime(), { valueOf() { return 1; } }].map(stringOfAnything).join("|"));
try { console.log(`${Symbol("s") as any}`); } catch (error) { console.log((error as Error).constructor.name); }
try { console.log(+(Symbol("s") as any)); } catch (error) { console.log((error as Error).constructor.name); }
try { console.log(+(1n as any)); } catch (error) { console.log((error as Error).constructor.name, Number(1n)); }
//// every-use-of-a-pattern-out-of-run-time-text-finds-the-match-behind-fifty-million-turns-of-a-group.js
// exec, test, match, matchAll, replace, replaceAll, search and split of a pattern whose first alternative fails only behind more than fifty million turns of its group, on subjects of 8-bit and of 16-bit characters.
const nothing = String(Date.now()).slice(99);
const text = "(?:a|a)*c|a+" + nothing;
const narrow = "a".repeat(26) + nothing;
const wide = "a".repeat(25) + "一" + nothing;
console.log("exec", new RegExp(text).exec(narrow)?.[0].length);
console.log("test", new RegExp(text).test(wide));
console.log("match", narrow.match(new RegExp(text))?.[0].length);
console.log("matchAll", [...wide.matchAll(new RegExp(text, "g"))].map(match => match[0].length).join());
console.log("replace", narrow.replace(new RegExp(text), "<$&>").length);
console.log("replaceAll", wide.replaceAll(new RegExp(text, "g"), "-"));
console.log("search", narrow.search(new RegExp(text)));
console.log("split", wide.split(new RegExp(text)).length);
console.log("sticky", new RegExp(text, "y").exec(narrow)?.[0].length);
//// exec-and-match-prefix-forms.ts
const lines: string[] = [];
function log(text: string): void {
  lines.push(text);
}
function show(part: string | undefined): string {
  return part === undefined ? "<undefined>" : part;
}
function state(re: RegExp): string {
  return "lastIndex=" + re.lastIndex + " $1=" + RegExp.$1 + " $2=" + RegExp.$2;
}

function rope(parts: string[]): string {
  let text = "";
  for (const part of parts) text += part;
  return text;
}
const flat = "key=value;other=thing";
const roped = rope(["ke", "y=va", "lue;oth", "er=thing"]);
const cut = ("xxxx" + flat + "yyyy").substring(4, 4 + flat.length);
const wide = "clé=valeur;其他=东西";
const subjects: string[] = [flat, roped, cut, wide, "", "no separators here"];

function execNoGroups(s: string): string {
  const re = /=/;
  const m = re.exec(s);
  if (m) return show(m[0]) + "|" + m.length + "|" + state(re);
  return "null|" + state(re);
}
////= lines-43	execTwoGroups	/(\p{L}+)=(\p{L}+)/u
function execThreeGroups(s: string): string {
  const re = /(\w+)(=)(\w+)/;
  const m = re.exec(s);
  if (m) return show(m[1]) + "|" + show(m[2]) + "|" + show(m[3]) + "|" + m.length + "|" + state(re);
  return "null|" + state(re);
}
function execOptionalGroup(s: string): string {
  const re = /(y)(zzz)?(=)/;
  const m = re.exec(s);
  if (m) return show(m[1]) + "|" + show(m[2]) + "|" + show(m[3]) + "|" + m.length + "|" + state(re);
  return "null|" + state(re);
}
function execBeyondLastGroup(s: string): string {
  const re = /(=)/;
  const m = re.exec(s);
  if (m) return show(m[1]) + "|" + show(m[2]) + "|" + m.length;
  return "null";
}
function execGlobal(s: string): string {
  const re = /(\w+)=(\w+)/g;
  let text = "";
  for (let i = 0; i < 3; i++) {
    const m = re.exec(s);
    if (m) text += show(m[1]) + "," + show(m[2]) + "," + m.length + " " + state(re) + ";";
    else text += "null " + state(re) + ";";
  }
  return text;
}
function execSticky(s: string): string {
  const re = /(\w)(\w)/y;
  let text = "";
  for (let i = 0; i < 3; i++) {
    const m = re.exec(s);
    if (m) text += show(m[1]) + show(m[2]) + " " + state(re) + ";";
    else text += "null " + state(re) + ";";
  }
  return text;
}
////= lines-43	execIndices	new RegExp("(\\w+)=(\\w+)", "d")
////= lines-43	execNamed	/(?<name>\w+)=(?<content>\w+)/
function execWithPatternParameter(re: RegExp, s: string): string {
  const m = re.exec(s);
  if (m) return show(m[1]) + "|" + show(m[2]) + "|" + m.length + "|" + state(re);
  return "null|" + state(re);
}

function matchNoGroups(s: string): string {
  const re = /=/;
  const [whole, missing] = s.match(re) ?? [];
  return show(whole) + "|" + show(missing) + "|" + state(re);
}
function matchTwoGroups(s: string): string {
  const re = /(\w+)=(\w+)/;
  const [, a, b] = s.match(re) ?? [];
  return show(a) + "|" + show(b) + "|" + state(re);
}
function matchThreeGroups(s: string): string {
  const re = /(\w+)(=)(\w+)/;
  const [, a, b, c] = s.match(re) ?? [];
  return show(a) + "|" + show(b) + "|" + show(c) + "|" + state(re);
}
function matchOptionalGroup(s: string): string {
  const re = /(y)(zzz)?(=)/;
  const [, a, b, c] = s.match(re) ?? [];
  return show(a) + "|" + show(b) + "|" + show(c) + "|" + state(re);
}
function matchGlobalDestructured(s: string): string {
  const re = /\w+/g;
  const [first, second, third] = s.match(re) ?? [];
  return show(first) + "|" + show(second) + "|" + show(third) + "|" + state(re);
}
function matchGlobalLength(s: string): string {
  const re = /=/g;
  const m = s.match(re);
  return m ? show(m[0]) + "|" + m.length + "|" + state(re) : "null|" + state(re);
}
function matchSticky(s: string): string {
  const re = /(\w)(\w)/y;
  const first = s.match(re);
  const second = s.match(re);
  return (first ? show(first[2]) : "null") + "|" + (second ? show(second[2]) : "null") + "|" + state(re);
}
function matchNamed(s: string): string {
  const re = /(?<name>\w+)=(?<content>\w+)/;
  const [, a, b] = s.match(re) ?? [];
  return show(a) + "|" + show(b) + "|" + state(re);
}

for (const s of subjects) {
  log("subject " + JSON.stringify(s));
  log(execNoGroups(s));
  log(execTwoGroups(s));
  log(execThreeGroups(s));
  log(execOptionalGroup(s));
  log(execBeyondLastGroup(s));
  log(execGlobal(s));
  log(execSticky(s));
  log(execIndices(s));
  log(execNamed(s));
  log(execWithPatternParameter(/(\w)=(\w)/, s));
  log(matchNoGroups(s));
  log(matchTwoGroups(s));
  log(matchThreeGroups(s));
  log(matchOptionalGroup(s));
  log(matchGlobalDestructured(s));
  log(matchGlobalLength(s));
  log(matchSticky(s));
  log(matchNamed(s));
}

function hotLoop(parts: string[]): string {
  const re = /(\d+)-(\d+)?(x)?/;
  let total = 0;
  let text = "";
  for (let round = 0; round < 2000; round++) {
    const s = parts[round % parts.length];
    const m = re.exec(s);
    if (m) {
      total += Number(m[1]) + m.length;
      if (m[2] === undefined) total += 7;
      if (m[3] !== undefined) total += 11;
    }
    const [, a, b] = s.match(re) ?? [];
    if (a !== undefined) total += a.length;
    if (b !== undefined) total += b.length;
    if (round % 500 === 0) text += state(re) + ";";
  }
  return total + " " + text;
}
log(hotLoop(["12-34x", "5-", "none", rope(["7", "8-", "9"]), "٣-٤"]));

function wholeIndex(s: string): string {
  const m = /(b)/.exec(s);
  return m ? m.index + "|" + m.input + "|" + show(m[1]) : "null";
}
function wholeGroups(s: string): string {
  const m = /(?<year>\d{4})-(?<month>\d\d)/.exec(s);
  return m ? show(m.groups?.year) + "|" + show(m.groups?.month) + "|" + show(m[1]) : "null";
}
function wholeReturned(s: string): RegExpExecArray | null {
  return /(a)(b)?/.exec(s);
}
function wholeMatchGlobal(s: string): string[] | null {
  return s.match(/a/g);
}
log(wholeIndex("abc"));
log(wholeIndex("xyz"));
log(wholeGroups("on 2026-10"));
log(wholeGroups("never"));
log(JSON.stringify(wholeReturned("za")));
log(JSON.stringify(wholeReturned("zz")));
log(JSON.stringify(wholeMatchGlobal("banana")));
log(JSON.stringify(wholeMatchGlobal("xyz")));

function lastIndexObject(): string {
  const re = /(a)(b)/g;
  const seen: string[] = [];
  (re as any).lastIndex = {
    valueOf() {
      seen.push("v");
      return 0;
    },
  };
  const m = re.exec("xab");
  return (m ? show(m[1]) + show(m[2]) : "null") + "|" + seen.join("") + "|" + re.lastIndex;
}
log(lastIndexObject());

function ownExec(): string {
  const re = /(a)(b)/;
  re.exec = () => null;
  const m = re.exec("ab");
  const [, a, b] = "ab".match(re) ?? [];
  return (m ? show(m[1]) : "null") + "|" + show(a) + "|" + show(b);
}
log(ownExec());

////= Counting	s
function subclass(): string {
  const re = new Counting("(a)(b)");
  const m = re.exec("ab");
  const [, a, b] = "ab".match(re) ?? [];
  return (m ? show(m[2]) : "null") + "|" + show(a) + "|" + show(b) + "|" + re.calls;
}
log(subclass());

function readOnlyLastIndex(): string {
  const re = /a/g;
  Object.defineProperty(re, "lastIndex", { writable: false });
  try {
    re.lastIndex = 1;
    return "stored " + re.lastIndex;
  } catch (error) {
    return error instanceof TypeError ? "TypeError " + re.lastIndex : "other";
  }
}
log(readOnlyLastIndex());

