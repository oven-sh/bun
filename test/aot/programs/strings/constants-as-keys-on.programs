//// control-flow-inside-string-constructs-untyped.js
// `try`, `await`, `yield`, labelled `break` and `return` inside every string construct that the compiler treats specially (the same program without type annotations).
const print = (s) => console.log(s);
////= show-5
const log = [];
function boom(when, what) {
  if (when)
    throw new Error(what);
  return what;
}
export function switchCaught(s) {
  let out = "";
  switch (s) {
    case "one":
      try {
        out += boom(true, "1");
      } catch (e) {
        out += "c" + e.message;
      }
      break;
    case "two":
      try {
        out += "2";
        break;
      } finally {
        out += "f";
      }
    case "three":
      out += "3";
    case "four":
      try {
        return out + "4";
      } finally {
        log.push("left " + s);
      }
    default:
      try {
        out += boom(s.length > 6, "d");
      } catch {
        out += "D";
      }
  }
  return out + ".";
}
export function switchInTry(s) {
  try {
    switch (s) {
      case "one":
        return "1";
      case "two":
        throw new Error("two");
      case "three":
        return boom(true, "three");
      case "four":
        break;
      default:
        return "d";
    }
    return "after";
  } catch (e) {
    switch (e.message) {
      case "two":
        return "caught two";
      case "three":
        return "caught three";
      default:
        return "caught?";
    }
  } finally {
    log.push("f:" + s);
  }
}
export function chainLabelled(list) {
  let out = "";
  outer:
    for (const s of list) {
      for (let k = 0;k < 2; k++) {
        if (s === "skip")
          continue outer;
        else if (s === "stop")
          break outer;
        else if (s === "inner")
          break;
        else if (s === "ret")
          return out + "R";
        out += s[0] + k;
      }
      out += ";";
    }
  return out;
}
export async function switchAwaited(s) {
  let out = "";
  switch (s) {
    case "one":
      out += await Promise.resolve("1");
      break;
    case "two":
