// A character read from a string and compared with one-character literals in an if chain.
declare const console: any;

const texts: string[] = ["", "a", "abcdefgh", "hgfedcba", "a\0b", "\xe9a", "Āa￿b", "😀c", "  \t\n,;"];

function byIndex(text: string, i: number): number {
    const c = text[i];
    if (c === "a") return 1;
    if (c === "b") return 2;
    if (c === "c") return 3;
    if (c === "d") return 4;
    if (c === "\0") return 5;
    if (c === "\xe9") return 6;
    if (c === "Ā") return 7;
    if (c === "￿") return 8;
    return 0;
}

function byCharAt(text: string, i: number): number {
    const c = text.charAt(i);
    if (c === "a") return 1;
    else if (c === "b") return 2;
    else if (c === "c") return 3;
    else if (c === "") return 4;
    else if (c === "ab") return 5;
    return 0;
}

function byAt(text: string, i: number): number {
    const c = text.at(i);
    if (c === "a") return 1;
    if (c === "h") return 2;
    if (c === ";") return 3;
    if (c === undefined) return 4;
    return 0;
}

function repeatedCase(text: string, i: number): number {
    const c = text[i];
    if (c === "a") return 1;
    if (c === "b") return 2;
    if (c === "a") return 3;
    if (c === "c") return 4;
    return 0;
}

function keepsTheCharacter(text: string, i: number): string | undefined | number {
    const c = text[i];
    if (c === "a") return 1;
    if (c === "b") return 2;
    if (c === "c") return 3;
    return c;
}

function countOfSeparators(text: string): number {
    let count = 0;
    for (let i = 0; i <= text.length; i++) {
        const c = text[i];
        if (c === " ") count += 1;
        else if (c === "\t") count += 10;
        else if (c === "\n") count += 100;
        else if (c === ",") count += 1000;
        else if (c === ";") count += 10000;
        else count += 100000;
    }
    return count;
}

for (const text of texts) {
    for (let i = -2; i <= text.length + 1; i++)
        console.log(JSON.stringify(text), i, byIndex(text, i), byCharAt(text, i), byAt(text, i), repeatedCase(text, i), keepsTheCharacter(text, i));
    console.log(JSON.stringify(text), countOfSeparators(text));
}
console.log(byIndex("abc", 1.5), byIndex("abc", NaN), byIndex("abc", -0), byCharAt("abc", 1.5), byCharAt("abc", NaN), byCharAt("abc", Infinity), byAt("abc", -1.5), byAt("abc", NaN));
export {};
//// inspected-slices.ts
// Results of slice, substring, substr, charAt, at and [] that are only inspected answer like results that are also stored.
const narrow = "0123456789abcdefghijklmnopqrstuvwxyzé-42.5e1 ÿ0x1F";
const wide = "0123456789abcdefghijklmnopqrstuvwxyzā😀\ud83d-42.5e1 日本0x1F";
const raised = Array.from(narrow, unit => String.fromCharCode(unit.charCodeAt(0) + 0x100)).join("");
const nothing: any = undefined;

function copy(text: string): string {
    return text.split("").join("");
}

const bases: [string, () => string][] = [
    ["8-bit", () => copy(narrow)],
    ["16-bit", () => copy(wide)],
    ["8-bit rope", () => copy(narrow.slice(0, 20)) + copy(narrow.slice(20))],
    ["16-bit rope", () => copy(wide.slice(0, 38)) + copy(wide.slice(38))],
    ["8-bit substring", () => ("##" + copy(narrow) + "##").slice(2, -2)],
    ["16-bit substring", () => ("##" + copy(wide) + "##").slice(2, -2)],
    ["8-bit text in 16-bit storage", () => ("ā" + copy(narrow) + "ā").slice(1, -1)],
    ["every unit 0x100 higher", () => copy(raised)],
    ["one unit", () => copy("7")],
    ["empty", () => copy("")],
];

function flags(...answers: boolean[]): string {
    let text = "";
    for (const answer of answers) text += answer ? "1" : "0";
    return text;
}

////= lines-18	inspectSlice	slice

////= lines-11	inspectStoredSlice	slice

////= lines-18	inspectSubstring	substring

////= lines-11	inspectStoredSubstring	substring

////= lines-18	inspectSubstr	substr

////= lines-11	inspectStoredSubstr	substr

function inspectCharAt(x: string, i: number): string {
    const c = x.charAt(i);
    return `${flags(c === "", c === "3", c === "é", c === "ā", c === "\ud83d", c === "345", c > "2", c >= "é", "z" < c)} ${c.length} ${c.charCodeAt(0)} ${c.codePointAt(0)} ${Number(c)} ${parseInt(c)} ${c.slice(0, 1) === "3"}`;
}

function inspectStoredCharAt(x: string, i: number, stored: (string | undefined)[]): string {
    const c = x.charAt(i);
    stored.push(c);
    return `${flags(c === "", c === "3", c === "é", c === "ā", c === "\ud83d", c === "345", c > "2", c >= "é", "z" < c)} ${c.length} ${c.charCodeAt(0)} ${c.codePointAt(0)} ${Number(c)} ${parseInt(c)} ${c.slice(0, 1) === "3"}`;
}

function inspectAt(x: string, i: number): string {
    const c = x.at(i);
    return `${flags(c === "", c === "3", c === "é", c === "ā", c === "\ud83d", c === "345", c! > "2", c! >= "é", "z" < c!)} ${parseInt(c!)}`;
}

function inspectStoredAt(x: string, i: number, stored: (string | undefined)[]): string {
    const c = x.at(i);
    stored.push(c);
    return `${flags(c === "", c === "3", c === "é", c === "ā", c === "\ud83d", c === "345", c! > "2", c! >= "é", "z" < c!)} ${parseInt(c!)}`;
}

function inspectElement(x: string, i: number): string {
    const c = x[i];
    return `${flags(c === "", c === "3", c === "é", c === "ā", c === "\ud83d", c === "345", c > "2", c >= "é", "z" < c)} ${parseInt(c)}`;
}

function inspectStoredElement(x: string, i: number, stored: (string | undefined)[]): string {
    const c = x[i];
    stored.push(c);
    return `${flags(c === "", c === "3", c === "é", c === "ā", c === "\ud83d", c === "345", c > "2", c >= "é", "z" < c)} ${parseInt(c)}`;
}

function inspectUndefinedArguments(x: string, a: number): string {
    return `${x.slice(undefined, a).length} ${x.slice(a, undefined).length} ${x.slice(undefined, undefined).length} ${x.slice(undefined).charCodeAt(0)} ${x.slice(undefined, a) === "012"}`
        + ` ${x.substring(a, undefined).length} ${x.substring(nothing, a).length} ${x.substr(a, undefined).length} ${x.substr(nothing, a).length}`
        + ` ${x.charAt(nothing) === "0"} ${x.at(nothing) === "0"} ${x[nothing] === "0"}`;
}

function matchWideLiterals(x: string): string {
    return flags(
        x.slice(36, 37) === "ā", x.slice(36, 38) === "ā\ud83d", x.slice(36, 39) === "ā😀", x.slice(36, 40) === "ā😀\ud83d", x.slice(36, 41) === "ā😀\ud83d-",
        x.slice(36, 42) === "ā😀\ud83d-4", x.slice(36, 43) === "ā😀\ud83d-42", x.slice(36, 44) === "ā😀\ud83d-42.", x.slice(36, 45) === "ā😀\ud83d-42.5",
        x.slice(36, 45) === "ā😀\ud83d-42.6", x.slice(36, 45) === "Ā😀\ud83d-42.5", x.slice(36, 43) === "ā😀\ud83c-42", x.slice(35, 37) === "zā", x.slice(35, 37) === "zé",
    );
}

function scan(x: string): string {
    const answers: (number | boolean | undefined)[] = [];
    for (let i = 0; i <= x.length + 1; i++) {
        const s = x.slice(i, i + 3);
        const t = x.substring(i + 2.5, i);
        const u = x.substr(-i, 2);
        const c = x.charAt(i);
        const d = x.at(-i);
        const e = x[i];
        answers.push(s === "345", s === "ā😀", s.length, s.charCodeAt(2), Number(s), s.slice(1) === "45", t === "é-", t.codePointAt(1), u === "1F", parseInt(u), c === "ÿ", c.length, d === "F", e === "日");
    }
    return answers.join(" ");
}

function scanAndStore(x: string, stored: (string | undefined)[]): string {
    const answers: (number | boolean | undefined)[] = [];
    for (let i = 0; i <= x.length + 1; i++) {
        const s = x.slice(i, i + 3);
        const t = x.substring(i + 2.5, i);
        const u = x.substr(-i, 2);
        const c = x.charAt(i);
        const d = x.at(-i);
        const e = x[i];
        stored.push(s, t, u, c, d, e);
        answers.push(s === "345", s === "ā😀", s.length, s.charCodeAt(2), Number(s), s.slice(1) === "45", t === "é-", t.codePointAt(1), u === "1F", parseInt(u), c === "ÿ", c.length, d === "F", e === "日");
    }
    return answers.join(" ");
}

let digest = 0;
let mismatches = 0;

function mix(text: string): void {
    for (let i = 0; i < text.length; i++) digest = (digest * 31 + text.charCodeAt(i)) | 0;
}

function compare(label: string, a: number, b: number, inspected: string, stored: string): void {
    mix(inspected);
    if (inspected === stored) return;
    mismatches++;
    console.log("mismatch:", label, a, b, "inspected:", inspected, "stored:", stored);
}

for (const [name, create] of bases) {
    const length = create().length;
    const positions = [NaN, -1, 0, 1.5, 3, 6, 36, 37, 38, 39, 40, 44, 47, length, length + 1, Infinity, -Infinity];
    const stored: (string | undefined)[] = [];
    digest = 0;
    for (const a of positions) {
        for (const b of positions) {
            compare(name + " slice", a, b, inspectSlice(create(), a, b), inspectStoredSlice(create(), a, b, stored));
            compare(name + " substring", a, b, inspectSubstring(create(), a, b), inspectStoredSubstring(create(), a, b, stored));
            compare(name + " substr", a, b, inspectSubstr(create(), a, b), inspectStoredSubstr(create(), a, b, stored));
        }
        compare(name + " charAt", a, a, inspectCharAt(create(), a), inspectStoredCharAt(create(), a, stored));
        compare(name + " at", a, a, inspectAt(create(), a), inspectStoredAt(create(), a, stored));
        compare(name + " []", a, a, inspectElement(create(), a), inspectStoredElement(create(), a, stored));
        mix(inspectUndefinedArguments(create(), a));
    }
    compare(name + " loop", 0, length + 1, scan(create()), scanAndStore(create(), stored));
    mix(JSON.stringify(stored));
    console.log(name, length, digest);
    console.log("  slice(3, 6)", inspectSlice(create(), 3, 6));
    console.log("  slice(36, 38)", inspectSlice(create(), 36, 38));
    console.log("  slice(38, 40)", inspectSlice(create(), 38, 40));
    console.log("  slice(-4, Infinity)", inspectSlice(create(), -4, Infinity));
    console.log("  substring(39, 36)", inspectSubstring(create(), 39, 36));
    console.log("  substring(NaN, 36)", inspectSubstring(create(), NaN, 36));
    console.log("  substr(-13, 7.9)", inspectSubstr(create(), -13, 7.9));
    console.log("  charAt(36)", inspectCharAt(create(), 36), "| at(-1)", inspectAt(create(), -1), "| [37]", inspectElement(create(), 37), "| [1.5]", inspectElement(create(), 1.5));
    console.log("  undefined", inspectUndefinedArguments(create(), 3));
    console.log("  wide literals", matchWideLiterals(create()));
}
console.log("mismatches", mismatches);
export {};
//// integers-become-text-once-twice-and-often.js
// The text of an integer is asked for once, twice and often, by every spelling, in orders that make integers meet in one place of a table, with collections in between, and the texts serve as keys.
const spellings = [n => String(n), n => "" + n, n => `${n}`, n => n.toString(), n => [n].join(), n => String(n + 0.0)];
function digitsOf(n) {
    if (n === 0) return "0";
    let text = "";
    for (let rest = Math.abs(n); rest > 0; rest = Math.floor(rest / 10)) text = "0123456789"[rest % 10] + text;
    return n < 0 ? "-" + text : text;
}
let wrong = 0;
let asked = 0;
function ask(n, spelling) {
    asked++;
    if (spelling(n) !== digitsOf(n)) { wrong++; if (wrong < 5) console.log("wrong", n, spelling(n)); }
}
const edges = [0, 1, 9, 10, 255, 256, 257, 511, 512, 65535, 65536, 65537, 16777216, 2147483646, 2147483647, 2147483648, 4294967295, 4294967296, -1, -255, -256, -257, -2147483648, -2147483649, 9007199254740991];
for (const spelling of spellings) {
    for (let round = 0; round < 4; round++) for (const n of edges) ask(n, spelling);
    for (let n = 0; n < 70000; n += 7) ask(n, spelling);
    for (let round = 0; round < 3; round++) for (let n = 300; n < 300 + 256 * 40; n += 256) ask(n, spelling);
    for (let round = 0; round < 3; round++) { for (let n = 1000; n < 4000; n++) ask(n, spelling); if (round === 1) Bun.gc(true); }
    for (let i = 0; i < 3000; i++) { ask(300 + (i & 1) * 256, spelling); ask(100000 + i, spelling); }
}
const counts = {};
const byText = new Map();
for (let round = 0; round < 3; round++) {
    for (let n = 250; n < 3000; n += 3) {
        const key = spellings[(n + round) % spellings.length](n);
        counts[key] = (counts[key] ?? 0) + 1;
        byText.set(key, (byText.get(key) ?? 0) + n);
    }
    Bun.gc(true);
}
let sum = 0;
for (const key in counts) sum += counts[key] * Number(key);
for (const [key, value] of byText) sum += value - 3 * Number(key);
console.log(asked, wrong, Object.keys(counts).length, byText.size, sum, counts[253], counts["256"], counts[String(2998)]);
//// integers-that-come-once-become-text-between-small-collections.js
// One integer becomes text twice, early. Then integers that come once become text while the program allocates enough for many small collections, and nothing else is written into the tables of texts.
let length = 0;
const kept = [];
for (let i = 300; i < 3_000_000; i++) {
    length += String(i).length;
    if (i === 5000) kept.push(String(i - 904));
}
console.log(length, kept.length, kept[0]);
//// joins-of-literals-and-raw-templates.ts
// join on an array literal and String.raw on a template are concatenations, so a pattern made of them is known at build time. Every line prints what plain Bun prints.
declare const console: { log(...values: unknown[]): void };
function opaque<T>(value: T): T { return [value][Number(String(0))]; }

function joined(a: string, b: string, separator: string): string { return [a, b, a].join(separator); }
function joinedWithComma(a: string, n: number): string { return [a, n, true, 10n].join(); }
function joinedWithUndefinedSeparator(a: string, b: string): string { return [a, b].join(undefined); }
function nullishElements(a: string): string { return [a, undefined, null, a].join("-"); }
function negativeZero(): string { return [-0, 0.5, NaN, Infinity, 1e21].join(" "); }
function one(n: number): string { return [n].join("+"); }
function none(separator: string): string { return ([] as string[]).join(separator); }
function maybeMissing(a: string, b?: string): string { return [a, b].join("/"); }
function objects(log: string[]): string {
    const first = { toString() { log.push("first"); return "1"; } };
    const second = { toString() { log.push("second"); return "2"; } };
    return [first, second].join({ toString() { log.push("separator"); return ":"; } } as any);
}
function symbolElement(): string {
    try { return [Symbol("s") as any, "x"].join(","); } catch (error) { return (error as Error).name; }
}
function holes(a: string): string { return [a, , a].join("|"); }
function usedTwice(a: string): string { const list = [a, a]; list.push("z"); return list.join("."); }

function raw(): string { return String.raw`\d+\n${1}A`; }
function rawWith(a: string, n: number, missing?: string): string { return String.raw`<${a}\t${n}\\${missing}>`; }
function rawObject(log: string[]): string {
    return String.raw`a${{ toString() { log.push("x"); return "X"; } }}b${{ toString() { log.push("y"); return "Y"; } }}c`;
}
function rawSymbol(): string {
    try { return String.raw`a${Symbol("s") as any}`; } catch (error) { return (error as Error).name; }
}
function rawCalled(): string { return String.raw({ raw: ["x", "y", "z"] }, 1, 2, 3); }

const alternatives = new RegExp(["ab+", "cd+", "e"].join("|"), "g");
const digits = new RegExp(String.raw`^\d+\.\d+$`);
const number = new RegExp(12 as any);
const nothing = new (RegExp as any)() as RegExp;
const undefinedPattern = new RegExp(undefined as any, "gi");
const nullPattern = new RegExp(null as any);
const truePattern = (RegExp as any)(true) as RegExp;

const log: string[] = [];
const out: unknown[] = [
    joined(opaque("a"), opaque("b"), opaque(", ")), joinedWithComma(opaque("a"), opaque(1.5)), joinedWithUndefinedSeparator(opaque("a"), opaque("b")),
    nullishElements(opaque("n")), negativeZero(), one(opaque(-0)), JSON.stringify(none(opaque("x"))), maybeMissing(opaque("a")), maybeMissing(opaque("a"), opaque("b")),
    objects(log), symbolElement(), holes(opaque("h")), usedTwice(opaque("u")),
    raw(), rawWith(opaque("s"), opaque(2)), rawWith(opaque("s"), opaque(2), opaque("m")), rawObject(log), rawSymbol(), rawCalled(), log.join(","),
];
for (const regExp of [alternatives, digits, number, nothing, undefinedPattern, nullPattern, truePattern])
    out.push(`${regExp.source} ${regExp.flags} ${String(regExp)} ${regExp.test(opaque("abb 12 1.5 null true"))} ${regExp.test(opaque("1.5"))}`);
out.push(opaque("xabbxcddxe").replace(alternatives, "_"), opaque("").match(nothing)?.length, opaque("ab").split(nothing).length);
console.log(out.map(String).join("\n"));
//// json-stringify-changed-typed-objects/main.ts
import { Account, Money, Wallet, labeled, line, point, type Point } from "./records";
import { write } from "./writer.js";

function show(title: string, value: unknown, replacer?: unknown, indent?: unknown): void {
  console.log(title, write(value, replacer, indent));
}

function changed(change: (target: any) => void, target: Point = labeled(1, 2, "p")): Point {
  change(target);
  return target;
}

for (let round = 0; round < 2; round++) {
  show("plain", point(1, 2));
  show("nested", line());
  show("absent label", point(1, 2));
  show("undefined label", labeled(1, 2, undefined));
  show("label created late", changed((p) => (p.label = "late"), point(1, 2)));
  show("tag before label", changed((p) => ((p.tag = 1), (p.label = "l")), point(1, 2)));
  show("label before tag", changed((p) => ((p.label = "l"), (p.tag = 1)), point(1, 2)));

  show("added", changed((p) => (p.added = true)));
  show("added index", changed((p) => ((p[2] = "two"), (p[0] = "zero"), (p["1"] = "one"))));
  show("added symbol", changed((p) => (p[Symbol("s")] = 1)));
  show("deleted", changed((p) => delete p.x));
  show("deleted and created", changed((p) => (delete p.x, (p.x = 9))));
  show("other type", changed((p) => (p.x = "text")));
  show("hidden", changed((p) => Object.defineProperty(p, "y", { enumerable: false })));
  show("getter", changed((p) => Object.defineProperty(p, "y", { get: () => 42, enumerable: true })));
  show("getter that changes", changed((p) => Object.defineProperty(p, "x", { get: () => (delete p.label, 1), enumerable: true })));
  show("frozen", Object.freeze(labeled(1, 2, "f")));
  show("sealed", Object.seal(labeled(1, 2, "s")));

  show("own toJSON", changed((p) => (p.toJSON = () => "own")));
  show("own toJSON that is no function", changed((p) => (p.toJSON = 5)));
  show("hidden own toJSON", changed((p) => Object.defineProperty(p, "toJSON", { value: () => "hidden own" })));
  show("toJSON through a new prototype", changed((p) => Object.setPrototypeOf(p, { toJSON: () => "inherited" })));
  show("null prototype", changed((p) => Object.setPrototypeOf(p, null)));
  show("toJSON of a class", new Money(5, "EUR"));
  show("toJSON of a member", new Wallet("ann", new Money(7, "USD")));
  show("toJSON in an array", [new Money(1, "A"), point(1, 1), new Money(2, "B")]);

  show("undefined", changed((p) => (p.tag = undefined)));
  show("function", changed((p) => (p.tag = () => 1)));
  show("function with toJSON", changed((p) => (p.tag = Object.assign(() => 1, { toJSON: () => "f" }))));
  show("symbol", changed((p) => (p.tag = Symbol("t"))));
  show("array of nothing", changed((p) => (p.tag = [undefined, () => 1, Symbol("t")])));
  show("bigint", changed((p) => (p.tag = 10n)));
  show("boxed", changed((p) => (p.tag = [new Number(1), new String("s"), new Boolean(true), Object(2n)].slice(0, 3))));
  show("proxy", changed((p) => (p.tag = new Proxy(point(3, 4), {}))));
  show("proxy of an array", changed((p) => (p.tag = new Proxy([point(3, 4)], {}))));
  show("date", changed((p) => (p.tag = new Date(0))));
  show("invalid date", changed((p) => (p.tag = new Date(NaN))));
  show("map", changed((p) => (p.tag = new Map([[1, 2]]))));
  show("numbers", changed((p) => (p.tag = [-0, 0, NaN, Infinity, -Infinity, 1e21, 1e-7, 2 ** 31, -(2 ** 31), 0.1])));
  show("texts", changed((p) => (p.tag = ["", "\"", "\\", "\n\u0000\u001f", "\u007fé", "€", "😀", "\ud800", "\udc00x", "a".repeat(40)])));
  show("lone surrogate label", labeled(1, 2, "\udfff"));
  show("wide label", labeled(1, 2, "中文"));

  show("instance", new Account(1, "ann"));
  const used = new Account(2, "bob");
  used.describe();
  const handler = used.describe;
  show("instance whose closure exists", used);
  (handler as any).toJSON = () => "closure";
  show("instance whose closure has toJSON", used);

  const cycle: any = line();
  cycle.points.push(cycle.from);
  show("shared, no cycle", cycle);
  cycle.to.tag = cycle;
  show("cycle", cycle);
  const self: any = point(1, 2);
  self.tag = self;
  show("self", self);

  show("replacer function", line(), (key: string, value: unknown) => (key === "y" ? undefined : value));
  show("replacer array", line(), ["from", "x", "points"]);
  show("indent", labeled(1, 2, "i"), null, 2);
  show("indent text", line(), undefined, "--");
  show("empty indent", point(1, 2), undefined, "");
}

(Account.prototype as any).toJSON = function (this: Account) {
  return `account ${this.id}`;
};
show("toJSON added to the class", new Account(3, "cy"));
show("toJSON added to the class, in a member", { holder: new Account(4, "di"), at: point(1, 2) });
delete (Account.prototype as any).toJSON;
show("toJSON removed again", new Account(5, "ed"));
//// json-stringify-changed-typed-objects/records.ts
export interface Point {
  x: number;
  y: number;
  label?: string;
  tag?: unknown;
}

export interface Line {
  from: Point;
  to: Point;
  points: Point[];
}

export class Account {
  id: number;
  owner: string;
  #secret = "hidden";
  describe = () => `${this.owner}#${this.id}${this.#secret.length}`;
  constructor(id: number, owner: string) {
    this.id = id;
    this.owner = owner;
  }
  get summary(): string {
    return this.describe();
  }
}

export class Money {
  constructor(
    public amount: number,
    public currency: string,
  ) {}
  toJSON(): string {
    return `${this.amount} ${this.currency}`;
  }
}

export class Wallet {
  constructor(
    public owner: string,
    public balance: Money,
  ) {}
}

export function point(x: number, y: number): Point {
  return { x, y };
}

export function labeled(x: number, y: number, label: string | undefined): Point {
  return { x, y, label };
}

export function line(): Line {
  return { from: point(0, -0), to: labeled(1.5, NaN, "end"), points: [point(1, 2), labeled(3, Infinity, undefined)] };
}
//// json-stringify-changed-typed-objects/writer.js
export function write(value, replacer, indent) {
  try {
    return String(JSON.stringify(value, replacer, indent));
  } catch (error) {
    return `${error.name}: ${error.message}`;
  }
}
//// json-stringify-through-untyped-function/data.ts
export interface Profile {
  id: number;
  name: string;
  active: boolean;
  score: number;
}

export interface Item {
  id: number;
  title: string;
  priceCents: number;
  inStock: boolean;
}

export interface Catalog {
  profile: Profile;
  items: Item[];
}

export interface Page {
  page: number;
  sort: string;
}

interface ProductRow {
  id: number;
  title: string;
  priceCents: number;
  stock: number;
}

const names = ["Ada", "Grace"];
const products: ProductRow[] = [];
for (let id = 1; id <= 50; id++) products.push({ id, title: ["Product", id].join(" "), priceCents: 199 + id * 350, stock: id % 7 });

export function catalog(userId: number): Catalog {
  return {
    profile: { id: userId, name: names[userId % names.length]!, active: userId % 2 === 0, score: userId + 0.5 },
    items: products.map((product) => ({
      id: product.id,
      title: product.title,
      priceCents: product.priceCents,
      inStock: product.stock > 0,
    })),
  };
}

export function page(number: number, sort: string | undefined): Page {
  return { page: number, sort: sort ?? "new" };
}
//// json-stringify-through-untyped-function/main.ts
import { catalog, page } from "./data";
import { Sender } from "./sender.js";

const rounds = Number(process.argv[2] ?? 3);
const sender = new Sender();
let last = "";
for (let round = 0; round < rounds; round++) {
  last = sender.json(catalog(42 + (round & 1))).body;
  if (round < 2) console.log(last);
  sender.json(page(round, round & 1 ? "old" : undefined), 201);
  sender.json([1, "two", null]);
  sender.json("text");
}
console.log(sender.sent, last.length, sender.json(page(7, "top"), 201));
//// json-stringify-through-untyped-function/sender.js
export class Sender {
  sent = 0;
  json = (object, status) => {
    const body = JSON.stringify(object);
    this.sent += body.length;
    return { status: status ?? 200, body };
  };
}
//// json-stringify-typed-objects.ts
// `JSON.stringify` of typed objects: every kind of field, every order of keys, and everything that leaves the fast path.
const print = (s: string) => console.log(s);
////= show-6
function cat(a: string, b: string): string { return a + b; }
function cat3(a: string, b: string, c: string): string { return `${a}${b}${c}`; }
function part(s: string, from: number, to: number): string { return s.slice(from, to); }
function flattened(s: string): string { s.charCodeAt(0); return s; }
const forms = (x: unknown) => attempt(() => JSON.stringify(x)) + " " + attempt(() => JSON.stringify(x, null, 2)) + " " + attempt(() => JSON.stringify(x, null, "\t")) + " " + attempt(() => JSON.stringify([x, x])) + " " + attempt(() => JSON.stringify({ wrapped: x }));
interface Point { x: number; y: number }
interface Mixed { a: number; b: number[]; c: { d: string }; e: null; f: boolean }
interface Optional { a?: number; b?: string; c?: boolean; d?: Point; e?: number | null; f?: string | undefined; g?: boolean | null }
const mixed: Mixed = { a: 1, b: [1, 2, 3], c: { d: "x" }, e: null, f: true };
print(forms(mixed));
for (const n of [0, -0, 1, -1, 2147483647, -2147483648, -2147483647, -2147483646, -2147483645, -2147483644, 2147483648, 4294967295, 1.5, -1.5, 1e21, 1e-7, 9007199254740991, NaN, Infinity, -Infinity]) {
    const p: Point = { x: n, y: 0 }; p.y = n; print(forms(p));
}
for (const s of ["", "x", "with \"quotes\" and \\", "\n\t\r\b\f\u0000\u001f", "caf\u00e9", "\u65e5\u672c", "\ud83d\ude00", "\ud800", "\udc00x", "</script>", "\u2028\u2029", "\u007f\u0080", cat("ro", "pe"), part("a substring here", 2, 11), "long ".repeat(40), "x".repeat(5000)])
    print(forms({ d: s }).length + " " + forms({ d: s }).slice(0, 300));
const optionals: Optional[] = [{}, { a: 1 }, { b: "s" }, { c: false }, { d: { x: 1, y: 2 } }, { e: null }, { e: 5 }, { f: undefined }, { f: "f" }, { g: null }, { g: true }, { a: undefined }, { a: 1, b: "s", c: true, d: { x: 1, y: 2 }, e: null, f: "f", g: false }, { g: false, f: "f", e: 1, d: { y: 2, x: 1 }, c: true, b: "s", a: 1 }];
for (const o of optionals) print(forms(o));
// The order of the keys is that of their creation.
function inOrder(keys: string): Optional { const o: Optional = {}; for (const k of keys) { if (k === "a") o.a = 1; else if (k === "b") o.b = "s"; else if (k === "c") o.c = true; else if (k === "e") o.e = 2; else if (k === "g") o.g = null; } return o; }
for (const keys of ["abc", "cba", "bca", "eag", "gea", "a", "ga", "abceg", "gecba", "cabge"]) print(keys + " " + forms(inOrder(keys)));
{ const o = inOrder("abc"); delete o.b; print(forms(o)); o.b = "again"; print(forms(o)); delete o.a; delete o.c; print(forms(o)); o.a = 3; print(forms(o)); }
for (let round = 0; round < 3; round++) for (const keys of ["abc", "cba", "abc", "abc", "bca"]) print(JSON.stringify(inOrder(keys)));
// Classes.
class Plain { x = 1; y = "two"; z: number[] = [3]; }
class WithMethods { x = 1; method() { return 2; } get computed() { return 3; } static fixed = 4; }
class WithPrivate { #hidden = 1; shown = 2; reveal() { return this.#hidden; } }
class WithToJSON { x = 1; toJSON() { return { replaced: this.x }; } }
class Inherits extends WithToJSON { y = 2; }
class Derived extends Plain { w = true; }
class WithKey { x = 1; toJSON(key: string) { return "key " + key; } }
class OwnToJSON { x = 1; toJSON: unknown = 5; }
class OwnCallable { x = 1; toJSON = () => "own"; }
class WithAccessor { _v = 1; get v() { return this._v; } set v(n: number) { this._v = n; } }
for (const o of [new Plain(), new WithMethods(), new WithPrivate(), new WithToJSON(), new Inherits(), new Derived(), new WithKey(), new OwnToJSON(), new OwnCallable(), new WithAccessor()]) print(forms(o));
// Values that are not JSON values, and values that leave the fast path.
print(forms({ f: () => 1, s: Symbol.iterator, u: undefined, n: 1 }) + " | " + forms({ big: 1n }) + " | " + forms({ d: new Date(0) }) + " | " + forms({ m: new Map([[1, 2]]), s: new Set([1]), r: /x/g, e: new Error("m") }) + " | " + forms({ n: new Number(5), s: new String("s"), b: new Boolean(false) }) + " | " + forms({ a: [undefined, () => 1, Symbol.iterator, null, [], {}] }));
{ const o: any = { a: 1, b: 2 }; o.extra = 3; o[5] = "index"; o[Symbol.iterator] = 1; print(forms(o)); const p: any = new Plain(); p.extra = { deep: [1, { x: 2 }] }; print(forms(p)); Object.defineProperty(p, "hidden", { value: 1, enumerable: false }); Object.defineProperty(p, "got", { get() { return "getter"; }, enumerable: true }); print(forms(p)); }
{ const cycle: any = { a: 1 }; cycle.self = cycle; print(forms(cycle)); const inner: { up?: unknown; v: number } = { v: 1 }; const outer = { inner }; inner.up = outer; print(forms(outer)); }
print(forms(Object.freeze({ a: 1, b: "s" })) + " | " + forms(Object.seal({ a: 1 })) + " | " + forms(Object.preventExtensions({ a: [1] })));
print(forms({ "key with space": 1, "quote\"": 2, "\u00e9": 3, "\u65e5": 4, "": 5, "\n": 6, "0": 7, "-1": 8, "01": 9, "__proto__x": 10 }));
let deep: unknown = 1; for (let i = 0; i < 60; i++) deep = i & 1 ? { d: deep } : [deep]; print(forms(deep).length + " " + JSON.stringify(deep).slice(0, 80));
let tooDeep: unknown = 1; for (let i = 0; i < 20000; i++) tooDeep = { d: tooDeep }; print(attempt(() => JSON.stringify(tooDeep).length));
const many: Mixed[] = []; for (let i = 0; i < 3000; i++) many.push({ a: i, b: [i, i + 1], c: { d: "s" + i }, e: null, f: (i & 1) === 0 }); print(JSON.stringify(many).length + " " + JSON.stringify(many, null, 1).length + " " + JSON.stringify(many.slice(2990)));
// Code of the program between two properties: the keys are those at the start, each value is read at its turn.
{
    interface Holder { first: unknown; second?: number; third?: string }
    const deleting: Holder = { first: null, second: 2, third: "3" }; deleting.first = { toJSON() { delete deleting.second; return "deleted second"; } }; print(forms(deleting) + " " + Object.keys(deleting).join());
    const changing: Holder = { first: null, second: 2, third: "3" }; changing.first = { toJSON() { changing.second = 22; changing.third = "33"; return "changed"; } }; print(JSON.stringify(changing));
    const adding: Holder = { first: null, second: 2 }; adding.first = { toJSON() { adding.third = "added"; return "added third"; } }; print(JSON.stringify(adding) + " " + JSON.stringify(adding));
    const extra: Holder = { first: null, second: 2 }; extra.first = { toJSON() { (extra as any).more = "first extra property"; return "added an extra"; } }; print(JSON.stringify(extra) + " " + JSON.stringify(extra));
    const again: Holder = { first: null, second: 2, third: "3" }; again.first = { toJSON() { delete again.second; again.second = 222; return "deleted and created again"; } }; print(JSON.stringify(again) + " " + JSON.stringify(again));
    const byReplacer: Holder = { first: 1, second: 2, third: "3" }; print(JSON.stringify(byReplacer, function (k, v) { if (k === "first") { delete byReplacer.third; (byReplacer as any).late = 1; } return v; }) + " " + JSON.stringify(byReplacer));
    const byGetter: any = { first: 1, second: 2 }; Object.defineProperty(byGetter, "mid", { enumerable: true, get() { delete byGetter.second; return "getter"; } }); byGetter.last = 9; print(JSON.stringify(byGetter));
}
// Documents of our objects alone, and with a plain one first.
print(JSON.stringify([{ x: 1, y: 2 } as Point, { x: 3, y: 4 } as Point]) + " " + JSON.stringify([JSON.parse("{}"), { x: 1, y: 2 } as Point]) + " " + JSON.stringify({ p: { x: 1, y: 2 } as Point, q: JSON.parse('{"z":1}') }));
// Replacers, gaps, toJSON on prototypes.
print([JSON.stringify(mixed, ["a", "c", "d"]), JSON.stringify(mixed, (k, v) => typeof v === "number" ? v + 1 : v), JSON.stringify(mixed, null, 20), JSON.stringify(mixed, null, "0123456789abc"), JSON.stringify(mixed, null, 0), JSON.stringify(mixed, null, ""), JSON.stringify(mixed, undefined, 1.9), JSON.stringify(mixed, null, new Number(1) as any), JSON.stringify(mixed, [] as any)].join(" | "));
print([JSON.stringify(undefined), JSON.stringify(null), JSON.stringify(1), JSON.stringify("s"), JSON.stringify(true), JSON.stringify([]), JSON.stringify({}), JSON.stringify(() => 1), JSON.stringify(Symbol.iterator)].map(show).join());
let sum = 0; for (let i = 0; i < 20000; i++) { mixed.a = i; mixed.c.d = "v" + (i & 7); mixed.f = (i & 1) === 0; sum = (sum + JSON.stringify(mixed).length + JSON.stringify(inOrder(i & 1 ? "abc" : "cba")).length) % 1000003; } print(String(sum));
print(JSON.stringify(JSON.parse(JSON.stringify(mixed))) + " " + JSON.stringify(Object.assign({}, mixed)) + " " + JSON.stringify({ ...mixed, g: 1 }));
//// json-stringify-typed-objects-untyped.js
// `JSON.stringify` of typed objects: every kind of field, every order of keys, and everything that leaves the fast path (the same program without type annotations).
class Plain {
  x = 1;
  y = "two";
  z = [3];
}

class WithMethods {
  x = 1;
  method() {
    return 2;
  }
  get computed() {
    return 3;
  }
  static fixed = 4;
}

class WithPrivate {
  #hidden = 1;
  shown = 2;
  reveal() {
    return this.#hidden;
  }
}

class WithToJSON {
  x = 1;
  toJSON() {
    return { replaced: this.x };
  }
}

class WithKey {
  x = 1;
  toJSON(key) {
    return "key " + key;
  }
}

class OwnToJSON {
  x = 1;
  toJSON = 5;
}

class OwnCallable {
  x = 1;
  toJSON = () => "own";
}

class WithAccessor {
  _v = 1;
  get v() {
    return this._v;
  }
  set v(n) {
    this._v = n;
  }
}
const print = (s) => console.log(s);
