//// json-values-of-unknown-type.ts
// `JSON.stringify` of typed objects whose `unknown` fields hold every kind of value, and the generic answer where the writer declines.
const print = (s: string) => console.log(s);
interface Box { before: number; value: unknown; after: string }
interface Point { x: number; y: number }
class L extends Array<number> { }
class Mixed extends Array<unknown> { }
class Labeled extends Array<number> {
    toJSON(): string {
        return "from subclass";
    }
}
class LaterDate extends Date { }

function box(value: unknown): Box {
    return { before: 1, value, after: "end" };
}
function attempt(f: () => unknown): string {
    try {
        return String(f());
    } catch (e) {
        return "throws " + (e as Error).name;
    }
}
function show(label: string, value: unknown): void {
    print(label);
    print("  property " + attempt(() => JSON.stringify(box(value))));
    print("  element  " + attempt(() => JSON.stringify([value, 2])));
    print("  nested   " + attempt(() => JSON.stringify(box(box(value)))));
    print("  root     " + attempt(() => JSON.stringify(value)));
}
function cat(a: string, b: string): string {
    return a + b;
}
function nestedArrays(depth: number): unknown {
    let value: unknown = [];
    for (let i = 0; i < depth; i++)
        value = [value];
    return value;
}
function pointWithExtraProperties(): Point {
    const point: Point = { x: 1, y: 2 };
    (point as any).z = "extra";
    (point as any)["with space"] = [3];
    return point;
}
function subclassInstance(): L {
    const list = new L();
    list.push(1, 2, 3);
    return list;
}
function mixedSubclassInstance(): Mixed {
    const list = new Mixed();
    list.push(1, "two", "日", { three: 3 }, [4]);
    return list;
}
function labeledSubclassInstance(): Labeled {
    const list = new Labeled();
    list.push(1, 2);
    return list;
}
function sparseSubclassInstance(): L {
    const list = new L(3);
    list[0] = 1;
    return list;
}

const point: Point = { x: 1, y: 2.5 };
show("typed object", point);
show("extra properties", pointWithExtraProperties());
show("ints", [1, 2, 3]);
show("doubles", [1.5, -0, 1e21, 2.5]);
show("strings", ["a", "b\"c", "日本"]);
show("typed objects", [point, { x: 3, y: 4 } as Point, point]);
show("nested arrays", nestedArrays(50));
show("shallow nested arrays", nestedArrays(5));
show("subclass", subclassInstance());
show("subclass with plain object", mixedSubclassInstance());
show("empty subclass", new L());
show("null prototype array", Object.setPrototypeOf([1, 2], null));
show("date", new Date(0));
show("invalid date", new Date(NaN));
show("wide string", "日本語");
show("wide string to escape", "日\"\n\ud800");
show("escapes", "quote \" backslash \\ newline \n tab \t control \u0001 end");
show("rope", cat("left side of the rope ".repeat(3), "right side of the rope ".repeat(3)));
show("wide rope", cat("left ".repeat(8), "日本".repeat(8)));
show("primitives", [null, true, false, 0, NaN, Infinity]);

show("function", () => 1);
show("symbol", Symbol("s"));
show("undefined", undefined);
show("function with toJSON", Object.assign(() => 1, { toJSON() { return "from function"; } }));
show("object with toJSON", { a: 1, toJSON() { return "from object"; } });
show("array with toJSON", Object.assign([1, 2], { toJSON() { return "from array"; } }));
show("subclass with toJSON", labeledSubclassInstance());
show("subclass instance with own toJSON", Object.assign(subclassInstance(), { toJSON() { return "from instance"; } }));
show("subclass with hole", sparseSubclassInstance());
show("array with toJSON on new prototype", Object.setPrototypeOf([1, 2], { toJSON() { return "from prototype"; } }));
const withGetter = pointWithExtraProperties();
Object.defineProperty(withGetter, "computed", { get() { return 7; }, enumerable: true });
show("getter among extra properties", withGetter);
show("hole", [1, , 3]);
show("wide string before hole", ["日", , 1]);
show("undefined and symbol elements", [undefined, Symbol("s"), () => 1]);
show("bigint", BigInt(10));
show("bigint element", [1, BigInt(10)]);
show("date subclass", new LaterDate(0));
print(attempt(() => JSON.stringify(undefined)));
print(attempt(() => JSON.stringify(() => 1)));
(L.prototype as any).toJSON = function () { return "added later"; };
show("subclass after toJSON is added", subclassInstance());
//// keys-built-at-run-time.ts
// Short strings built at run time and used as keys come from a cache of recent keys. Equal keys find the same entries while the cache grows, evicts keys and loses them to collections.
const collect: () => void = (globalThis as any).gc ?? (() => (globalThis as any).Bun.gc(true));

// The same text, built in a way the compiler does not look through.
function spell(parts: (string | number)[]): string {
  return parts.map(part => String(part)).join("").split("").join("");
}

const distinctKeyCount = 70000;
const counts = new Map<string, number>();
const sums: Record<string, number> = {};
function countKeys(start: number, end: number): void {
  for (let i = start; i < end; i++) {
    const key = "k" + (i % distinctKeyCount);
    counts.set(key, (counts.get(key) ?? 0) + 1);
    sums[key] = (sums[key] ?? 0) + i;
  }
}
function describeCounts(): string {
  let total = 0;
  let weighted = 0;
  for (const [key, count] of counts) {
    total += count;
    weighted += count * key.length;
  }
  let sum = 0;
  for (const key in sums) sum += sums[key];
  return [counts.size, total, weighted, Object.keys(sums).length, sum].join(" ");
}
function countMismatches(): number {
  let mismatches = 0;
  for (let i = 0; i < distinctKeyCount; i += 997) {
    const key = "k" + i;
    const spelled = spell(["k", i]);
    if (key !== spelled || key.length !== spelled.length) mismatches++;
    if (!counts.has(spelled) || counts.get(key) !== counts.get(spelled) || sums[key] !== sums[spelled]) mismatches++;
    if (counts.has("q" + i) || counts.has("k" + i + "x") || "q" + i in sums) mismatches++;
  }
  return mismatches;
}
countKeys(0, 100000);
console.log("the first 100000:", describeCounts(), countMismatches());
collect();
countKeys(100000, 200000);
console.log("200000:", describeCounts(), countMismatches());
collect();
collect();
countKeys(0, 200000);
console.log("the same keys again:", describeCounts(), countMismatches());

const byNumber = new Map<string, number>();
for (let i = 0; i < 60000; i++) byNumber.set(String(i * 7), i);
let numbersFound = 0;
for (let i = 0; i < 60000; i++) {
  if (byNumber.get("" + i * 7) === i) numbersFound++;
  if (byNumber.has(i * 7 + 1 + "")) numbersFound--;
}
console.log("numbers as keys:", byNumber.size, numbersFound, byNumber.get(spell([419993])));

const words = ["Accept", "Cache", "Content", "Control", "Encoding", "Forwarded", "Host", "Language", "Length", "Location", "Modified", "Origin", "Range", "Type", "Upgrade", "X"];
const headerNames: string[] = [];
for (let i = 0; i < 300; i++) headerNames.push(words[i % words.length] + "-" + words[(i * 5 + 3) % words.length] + "-" + i);
function convertHeaderNames(): string {
  const lowered = new Map<string, number>();
  let checksum = 0;
  let wrong = 0;
  for (let i = 0; i < headerNames.length; i++) {
    const name = headerNames[i];
    const lower = name.toLowerCase();
    const upper = name.toUpperCase();
    lowered.set(lower, (lowered.get(lower) ?? 0) + 1);
    if (lower.toUpperCase() !== upper || upper.toLowerCase() !== lower || lower.length !== name.length) wrong++;
    if (lower !== spell([lower]) || upper !== spell([upper])) wrong++;
    checksum += lower.charCodeAt(0) + upper.charCodeAt(1) * (i + 1);
  }
  return [lowered.size, checksum, wrong, headerNames[7].toLowerCase(), headerNames[299].toUpperCase()].join(" ");
}
console.log("300 header names:", convertHeaderNames());
console.log("again:", convertHeaderNames());
collect();
console.log("after a collection:", convertHeaderNames());

const codes = (text: string): string => Array.from(text, character => character.codePointAt(0)!.toString(16)).join(".");
const oddCases = ["straße", "ÉtÉ", "ÿes", "5µm", "naïve", "İx", "ﬁx", "ǅ"];
for (let round = 0; round < 2; round++) {
  for (const text of oddCases) console.log("case of", codes(text), "is", codes(text.toLowerCase()), "and", codes(text.toUpperCase()));
}

const byLength = new Map<string, number>();
const convertedLengths: number[] = [];
for (const length of [2, 3, 63, 64, 65, 66, 1000]) {
  const prefix = "P".repeat(length - 1);
  for (let round = 0; round < 3; round++) {
    for (let digit = 0; digit < 10; digit++) {
      const key = prefix + digit;
      byLength.set(key, (byLength.get(key) ?? 0) + 1);
      sums[key] = (sums[key] ?? 0) + digit;
      const lower = key.toLowerCase();
      if (lower.length !== length || lower[0] !== "p" || lower[length - 1] !== String(digit) || lower.toUpperCase() !== key) convertedLengths.push(length);
    }
  }
}
let lengthsSeen = "";
for (const [key, count] of byLength) {
  if (key.endsWith("7")) lengthsSeen += key.length + ":" + count + ":" + sums[spell([key])] + " ";
}
console.log("keys of 2 to 1000 characters:", byLength.size, lengthsSeen + "wrong conversions:", convertedLengths.length);

const wide = new Map<string, number>();
for (let i = 0; i < 3000; i++) {
  const beyondLatin1 = "kĀ" + (i % 1000);
  const lastOfLatin1 = "kÿ" + (i % 1000);
  const astral = "\u{1f600}" + (i % 1000);
  wide.set(beyondLatin1, (wide.get(beyondLatin1) ?? 0) + 1);
  wide.set(lastOfLatin1, (wide.get(lastOfLatin1) ?? 0) + 2);
  wide.set(astral, (wide.get(astral) ?? 0) + 3);
}
console.log("characters at and above U+00FF:", wide.size, wide.get("kĀ" + 5), wide.get(spell(["kÿ", 5])), wide.get("\u{1f600}" + 999), wide.has("k" + 5), wide.has("kā" + 5));

let narrowedFound = 0;
for (let i = 0; i < 2000; i++) {
  const narrowed = ("kĀ" + i).replace("Ā", "");
  if (counts.get(narrowed) === counts.get("k" + i) && sums[narrowed] === sums["k" + i] && narrowed === "k" + i) narrowedFound++;
}
console.log("Latin-1 texts cut out of wider strings:", narrowedFound);

const tiny = new Map<string, number>();
const tinySums: Record<string, number> = {};
const letters = "abcdefghij";
for (let i = 0; i < 1000; i++) {
  const digit = "" + (i % 10);
  const letter = letters.slice(i % 10, (i % 10) + 1) + letters.slice(3, 3);
  const empty = letters.slice(i % 10, i % 10) + letters.slice(5, 5);
  for (const key of [digit, letter, empty]) {
    tiny.set(key, (tiny.get(key) ?? 0) + 1);
    tinySums["_" + key] = (tinySums["_" + key] ?? 0) + 1;
    tinySums[key] = (tinySums[key] ?? 0) + 1;
  }
}
console.log("keys of one and no characters:", tiny.size, tiny.get(""), tiny.get("7"), tiny.get("c"), tinySums[""], tinySums["7"], tinySums["c"], tinySums["_"], tinySums["_7"], Object.keys(tinySums).length);
//// keys-concatenated-from-fields-that-are-tested.ts
// A key is made of fields of several objects, as TypeScript's checker does with `source.id + "," + target.id`. Each field is read and tested between two concatenations.
// Most objects hold what their type says. Some hold a string, undefined, null, a boolean, a bigint, an object whose conversion has an effect, a symbol, or have a getter with an effect:
// the conversions, the reads and the errors come in the order of the source text, and every key is the text that plain Bun makes.
// One case is left out: a symbol in front of a part whose read or conversion has an effect. ECMAScript refuses the symbol first, and so does the compiled program; the interpreter reads and converts the later parts first.
interface Item {
  id: number
  name: string
}
const log: string[] = []
function item(id: unknown, name: unknown = "n"): Item {
  return { id, name } as Item
}
function pairKey(source: Item, target: Item): string {
  return source.id + "," + target.id
}
function tripleKey(first: Item, second: Item, third: Item): string {
  return first.id + ":" + second.id + ":" + third.id
}
function namedKey(source: Item, target: Item): string {
  return source.name + "/" + target.name + "#" + source.id
}
function keyWithCall(source: Item, target: Item, between: () => void): string {
  const start = source.id + ","
  between()
  return start + target.id
}
function keyInTry(source: Item, target: Item): string {
  try {
    return source.id + "|" + target.id
  } catch (error) {
    return "caught " + (error as Error).constructor.name
  }
}
function templateKey(source: Item, target: Item): string {
  return `${source.id}-${target.id}-${source.name}`
}
function attempt(action: () => string): string {
  try {
    return action()
  } catch (error) {
    return (error as Error).constructor.name
  }
}
function flush(): string {
  return log.splice(0).join(" ")
}

const cache = new Map<string, number>()
let hits = 0
const items: Item[] = []
for (let i = 0; i < 300; i++) items.push(item(i, "n" + i))
for (let round = 0; round < 40; round++) {
  for (let i = 0; i < items.length; i++) {
    const key = pairKey(items[i], items[(i * 7 + round) % items.length])
    if (cache.has(key)) hits++
    else cache.set(key, i)
  }
}
console.log(cache.size, hits, tripleKey(items[1], items[22], items[299]), namedKey(items[3], items[4]), templateKey(items[5], items[6]))

function talking(label: string, result: unknown): object {
  return {
    valueOf() {
      log.push("valueOf " + label)
      return result
    },
    toString() {
      log.push("toString " + label)
      return "text " + label
    },
  }
}
function withGetter(label: string, id: unknown): Item {
  return {
    get id() {
      log.push("get " + label)
      return id
    },
    name: label,
  } as Item
}
const unusual: [string, () => Item][] = [
  ["number", () => item(7)],
  ["fraction", () => item(0.5)],
  ["negative zero", () => item(-0)],
  ["not a number", () => item(NaN)],
  ["large", () => item(1e21)],
  ["string", () => item("s")],
  ["empty", () => item("")],
  ["undefined", () => item(undefined)],
  ["null", () => item(null)],
  ["boolean", () => item(true)],
  ["bigint", () => item(12345678901234567890n)],
  ["object", () => item(talking("o", 5))],
  ["object to string", () => item(talking("p", {}))],
  ["symbol", () => item(Symbol("x"))],
  ["getter", () => withGetter("g", 9)],
  ["getter of object", () => withGetter("h", talking("h", "hv"))],
  ["throwing getter", () => ({ get id(): number { log.push("throw"); throw new RangeError("no id") }, name: "t" })],
  ["missing", () => ({ name: "m" }) as Item],
  ["array", () => item([1, 2])],
]
const withEffect = new Set(["object", "object to string", "getter", "getter of object", "throwing getter"])
for (const [firstLabel, first] of unusual) {
  for (const [secondLabel, second] of unusual) {
    if (firstLabel === "symbol" && withEffect.has(secondLabel)) continue
    const results = [
      attempt(() => pairKey(first(), second())), flush(),
      attempt(() => keyInTry(first(), second())), flush(),
      attempt(() => templateKey(first(), second())), flush(),
      attempt(() => keyWithCall(first(), second(), () => log.push("between"))), flush(),
    ]
    console.log(firstLabel, "+", secondLabel, "=", results.join(" ; "))
  }
}
for (const [label, make] of unusual) {
  console.log(label, attempt(() => tripleKey(item(1), make(), item(3))), flush(), attempt(() => tripleKey(make(), item(2), make())), flush(), attempt(() => tripleKey(item(1), item(2), make())), flush())
  console.log(label, attempt(() => namedKey(item(1, make().id), item(2, "b"))), flush(), attempt(() => namedKey(item(make().id, "a"), item(2, make().id))), flush())
}
console.log(attempt(() => pairKey(undefined as unknown as Item, item(1))), attempt(() => pairKey(item(1), null as unknown as Item)), attempt(() => keyWithCall(item(1), null as unknown as Item, () => log.push("between"))), flush())
//// keys-concatenated-from-substrings-and-ropes.ts
// The parts of a key that is put together on the spot need not be flat strings: slices of a longer text, pieces of a split, groups of a match, ropes, ropes of slices; 8-bit and 16-bit; short, and too long for any buffer. Each lookup is repeated with a key that was flattened beforehand.
const report: string[] = [];
let wrong = 0;
function flat(text: string): string {
  return text.split("").join("");
}
function note(table: Map<string, number>, left: string, right: string): void {
  const label = left + "=" + right;
  const times = table.get(label);
  table.set(label, times === undefined ? 1 : times + 1);
  if (table.get(flat(left) + "=" + flat(right)) !== (times ?? 0) + 1) wrong++;
}
const sources = ["the quick brown fox jumps over the lazy dog", "déjà vu, déjà lu, déjà bu", "αβγ δεζ αβγ δεζ", "0123456789".repeat(14)];

for (const source of sources) {
  const bySlices = new Map<string, number>();
  for (let width = 1; width <= 41; width += 8) for (let at = 0; at + 2 * width <= source.length; at += width) note(bySlices, source.slice(at, at + width), source.substring(at + width, at + 2 * width));
  const byPieces = new Map<string, number>();
  const words = source.split(" ");
  for (let turn = 0; turn < 2; turn++) for (let i = 0; i < words.length; i++) note(byPieces, words[i]!, words[(i + 2) % words.length]!);
  const byRopes = new Map<string, number>();
  for (let i = 1; i < words.length + 3; i++) {
    const rope = words[i % words.length]! + words[(i - 1) % words.length]!;
    note(byRopes, rope, rope.slice(1) + rope);
    note(byRopes, rope + rope + rope, source.slice(0, i));
  }
  report.push(bySlices.size + " " + byPieces.size + " " + byRopes.size + " " + [...byPieces.keys()].slice(0, 2).join("|"));
}

const shape = /(\w+)-(\d+)(?:-(\w+))?/;
const byGroups = new Set<string>();
let repeats = 0;
for (const code of ["ab-12", "ab-12-x", "cd-7-yy", "ab-12", "zz", "cd-7", "cd-7-yy"]) {
  const parts = shape.exec("<" + code + ">");
  if (!parts) continue;
  const label = parts[2]! + "@" + parts[1]! + "@" + parts[3];
  if (byGroups.has(label)) repeats++;
  else byGroups.add(label);
}
report.push([...byGroups].join(" ") + " " + repeats, "wrong " + wrong);
console.log(report.join("\n"));
//// keys-concatenated-then-looked-up.ts
// A string key put together on the spot and first used to look something up in a Map or Set. What the parts may be: constants, whole numbers, fractions, strings that are empty, short, long, Latin-1 or 16-bit, undefined and null behind a string type. What the table may be: empty, of a few keys, of hundreds, of tens of thousands. Every answer is checked against the same lookup by a key that was made beforehand.
const report: string[] = [];
let wrong = 0;
function expect(condition: boolean): void {
  if (!condition) wrong++;
}

const pieces: string[] = ["", "x", "left", "neé", "π", "a-piece-of-thirty-two-characters!", "w".repeat(70)];
const numbers: number[] = [0, 7, -7, 1024, 2147483647, -2147483648, 4294967297, 0.25, -0, NaN];

function tally(table: Map<string, number>, head: string, tail: string): number {
  const label = head + ":" + tail;
  const seen = table.get(label);
  table.set(label, seen === undefined ? 1 : seen + 1);
  return seen === undefined ? 0 : seen;
}
function tallyByNumber(table: Map<string, number>, head: string, n: number): number {
  const label = `${head}#${n}`;
  const seen = table.get(label) ?? 0;
  table.set(label, seen + 2);
  return seen;
}
function tallyThreeNumbers(table: Map<string, number>, a: number, b: number, c: number): void {
  const label = a + "." + b + "." + c;
  if (table.has(label)) table.set(label, table.get(label)! * 3);
  else table.set(label, 1);
}
function joinOnce(group: Set<string>, head: string, n: number, tail: string): boolean {
  const label = head + n + tail;
  if (group.has(label)) return false;
  group.add(label);
  return true;
}

{
  const table = new Map<string, number>();
  const plain = new Map<string, number>();
  for (let turn = 0; turn < 3; turn++)
    for (const head of pieces)
      for (const tail of pieces) {
        const made = [head, tail].join(":");
        const before = plain.get(made) ?? 0;
        plain.set(made, before + 1);
        expect(tally(table, head, tail) === before);
      }
  expect(table.size === plain.size);
  for (const [label, times] of plain) expect(table.get(label) === times);
  report.push("two strings " + table.size + " " + [...table.keys()].filter(label => label.length < 8).join("|"));
}
{
  const table = new Map<string, number>();
  const plain = new Map<string, number>();
  for (let turn = 0; turn < 2; turn++)
    for (const head of pieces)
      for (const n of numbers) {
        const made = [head, String(n)].join("#");
        const before = plain.get(made) ?? 0;
        plain.set(made, before + 2);
        expect(tallyByNumber(table, head, n) === before);
      }
  report.push("a string and a number " + table.size + " " + [...table.keys()].slice(0, numbers.length).join("|"));
}
{
  const table = new Map<string, number>();
  for (let a = -2; a < 9; a++) for (let b = 0; b < 40; b += 3) for (let c = 0; c < 2000; c += 999) tallyThreeNumbers(table, a, b, (a * b + c) % 5);
  let product = 0;
  for (const times of table.values()) product += times;
  report.push("three numbers " + table.size + " " + product + " " + [...table.keys()].slice(-3).join("|"));
}
{
  const group = new Set<string>();
  let fresh = 0;
  for (let turn = 0; turn < 2; turn++) for (const head of pieces) for (const n of numbers) for (const tail of ["", "!", "π"]) if (joinOnce(group, head, n, tail)) fresh++;
  report.push("a set " + fresh + " " + group.size);
}

function grownStepByStep(limit: number): string {
  const table = new Map<string, number>();
  let found = 0;
  for (let n = 0; n < limit; n++) {
    const label = "entry " + (n % 2 === 0 ? n : n - 1);
    const held = table.get(label);
    if (held === undefined) table.set(label, n);
    else {
      found++;
      expect(held === n - 1);
    }
  }
  return table.size + " " + found;
}
report.push("sizes " + [1, 2, 9, 10, 300, 600, 70000].map(grownStepByStep).join(" | "));

function behindAType(values: string[], n: number): string {
  const table = new Map<string, number>();
  for (let turn = 0; turn < 2; turn++)
    for (const value of values) {
      const label = value + "/" + n;
      table.set(label, (table.get(label) ?? 0) + 1);
    }
  return [...table].join(" ");
}
report.push(behindAType([undefined, null, "real", undefined] as unknown as string[], 5));

function changedInBetween(): string {
  const table = new Map<string, number>();
  const log: string[] = [];
  for (let n = 0; n < 6; n++) {
    const label = "slot" + (n % 3);
    const first = table.get(label);
    table.delete(label);
    table.set(label, (first ?? 0) + 1);
    const second = table.get(label);
    for (let extra = 0; extra < 30; extra++) table.set("filler" + n + "," + extra, extra);
    table.set(label, (second ?? 0) + 10);
    const third = table.has(label);
    table.clear();
    if (third) table.set(label, n);
    log.push(label + "=" + table.get(label) + "/" + table.size);
  }
  return log.join(" ");
}
report.push(changedInBetween());

function keptAfterwards(table: Map<string, string[]>, family: string, rank: number, member: string): string {
  const label = family + "~" + rank;
  const list = table.get(label);
  if (list === undefined) table.set(label, [member]);
  else list.push(member);
  return label;
}
{
  const table = new Map<string, string[]>();
  const labels: string[] = [];
  for (let n = 0; n < 40; n++) labels.push(keptAfterwards(table, pieces[n % 5]!, n % 3, "m" + n));
  expect(labels.every(label => table.has(label)));
  report.push("lists " + table.size + " " + [...table].map(([label, list]) => label + ":" + list.length).join(" "));
}
