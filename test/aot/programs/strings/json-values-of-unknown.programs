//// long-texts-that-differ-in-one-place.ts
function textOf(length: number, base: number, changed: number): string {
  const codes: number[] = [];
  for (let i = 0; i < length; i++) codes.push(base + ((i * 7) % 23) + (i === changed ? 1 : 0));
  return String.fromCharCode(...codes);
}
function same(a: string, b: string): boolean {
  return a === b;
}
function sameWhateverTheyAre(a: unknown, b: unknown): boolean {
  return a === b;
}
function looselySame(a: any, b: any): boolean {
  return a == b;
}
const lines: string[] = [];
for (const base of [0x41, 0xc0, 0x3b1]) {
  for (let length = 28; length <= 76; length++) {
    const text = textOf(length, base, -1);
    const places = [-1, 0, 1, 3, 4, 7, 8, 9, length >> 1, length - 10, length - 9, length - 8, length - 5, length - 4, length - 2, length - 1];
    let bits = "";
    for (const place of places) {
      const other = textOf(length, base, place);
      const list = [textOf(length, base, 2), other, textOf(length, base, length - 3)];
      bits += same(text, other) ? "s" : ".";
      bits += sameWhateverTheyAre(other, text) ? "u" : ".";
      bits += looselySame(text, other) ? "l" : ".";
      bits += text !== other ? "." : "n";
      bits += list.includes(text) ? "i" : ".";
      bits += list.indexOf(text);
      bits += new Set(list).has(text) ? "h" : ".";
      bits += " ";
    }
    lines.push(`${base} ${length} ${bits}`);
  }
}
const narrow = textOf(40, 0x41, -1);
const wide = (textOf(40, 0x41, -1) + String.fromCharCode(0x3b1)).slice(0, 40);
lines.push(`${same(narrow, wide)} ${sameWhateverTheyAre(wide, narrow)} ${[wide].includes(narrow)} ${same(narrow, textOf(41, 0x41, -1))}`);
console.log(lines.join("\n"));
//// lookups-by-keys-whose-parts-were-joined-before.ts
// `table.get(a + "|" + b)`: the key is looked up by its parts. The parts of a key that was made before, of one that never was, numbers, empty parts, parts of two bytes a character, long parts.
const table = new Map<string, number>();
const words = new Set<string>();
const parts = ["alpha", "", "b", "été", "中文", "x".repeat(300), "7", "-0"];
const numbers = [0, -1, 7, 2147483647, -2147483648];

let stored = 0;
for (const a of parts) {
  for (const b of parts) {
    if ((a.length + b.length) % 2) continue;
    const key = a + "|" + b;
    table.set(key, ++stored);
    words.add(key);
  }
}
for (const a of parts) for (const n of numbers) if (n % 2) table.set(a + ":" + n, ++stored);
table.set("7", -7);
words.add("77");

const found: unknown[] = [];
for (let round = 0; round < 3; round++) {
  for (const a of parts) {
    for (const b of parts) {
      found.push(table.get(a + "|" + b) ?? "-", words.has(a + "|" + b) ? 1 : 0, table.has(b + "|" + a) ? 1 : 0);
    }
    for (const n of numbers) found.push(table.get(a + ":" + n) ?? "-");
    found.push(table.get(a + "") ?? "-", words.has(a + a) ? 1 : 0);
  }
}
console.log(found.join(" "));
table.delete("alpha|b");
words.delete("alpha|b");
console.log(table.get("alpha" + "|" + parts[2]), words.has(parts[0] + "|" + parts[2]), table.get(parts[0] + "|" + parts[2]));
table.clear();
console.log(table.get(parts[0] + "|" + parts[0]), table.has(parts[2] + "|" + parts[2]), words.has(parts[2] + "|" + parts[2]));
//// loop-carried-char-codes-or-integers.ts
// A variable that holds char codes and integers, stored anew at the foot of a loop and read at its head.
const lines: string[] = [];
function show(label: string, ...values: unknown[]): void {
    lines.push(label + ": " + values.map(value => (Object.is(value, -0) ? "-0" : String(value))).join(" "));
}

function parseNumbers(text: string): number {
    let total = 0;
    let i = 0;
    let c = i < text.length ? text.charCodeAt(i) : 0;
    while (i < text.length) {
        let value = 0;
        while (c >= 48 && c <= 57) {
            value = value * 10 + (c - 48);
            i++;
            c = i < text.length ? text.charCodeAt(i) : 0;
        }
        if (c === 46) {
            i++;
            c = i < text.length ? text.charCodeAt(i) : 0;
            let scale = 0.1;
            while (c >= 48 && c <= 57) {
                value += (c - 48) * scale;
                scale *= 0.1;
                i++;
                c = i < text.length ? text.charCodeAt(i) : 0;
            }
        }
        total += value;
        i++;
        c = i < text.length ? text.charCodeAt(i) : 0;
    }
    return total;
}

function runsOffTheEnd(text: string): [number, number, boolean] {
    let i = 0;
    let c = text.charCodeAt(i);
    let digits = 0;
    while (c >= 48 && c <= 57) {
        digits++;
        c = text.charCodeAt(++i);
    }
    return [digits, c, c !== c];
}

function joinedWithFraction(text: string, at: number): number[] {
    const seen: number[] = [];
    let x = 0;
    for (let i = 0; i < text.length; i++) {
        seen.push(x < 50 ? 1 : 0, x >= 0.5 ? 1 : 0, x);
        x = i === at ? 0.5 : text.charCodeAt(i);
    }
    seen.push(x);
    return seen;
}

function joinedWithNegativeZero(text: string, at: number): unknown[] {
    const seen: unknown[] = [];
    let z = 1;
    for (let i = 0; i < text.length; i++) {
        seen.push(z, 1 / z, z < 1, z <= 0, z > -1, z >= 0);
        z = i === at ? -0 : text.charCodeAt(i) - text.charCodeAt(i);
    }
    seen.push(z);
    return seen;
}

function swapped(text: string, turns: number): number[] {
    let a = text.charCodeAt(0);
    let b = 7;
    let c = text.charCodeAt(1000);
    let below = 0;
    for (let i = 0; i < turns; i++) {
        if (a < 50) below++;
        if (c < 50 || c >= 50) below += 100;
        const held = a;
        a = b;
        b = c;
        c = held;
    }
    return [a, b, c, below];
}

function sometimesMissing(text: string): unknown[] {
    const seen: unknown[] = [];
    let u: number | undefined = undefined;
    for (let i = 0; i < text.length; i++) {
        seen.push(u, u !== undefined && u < 60, u !== undefined && u >= 60, u === undefined);
        u = i % 3 ? text.charCodeAt(i) : undefined;
    }
    seen.push(u);
    return seen;
}

function everyComparison(text: string): string {
    let out = "";
    let c = -1;
    for (let i = 0; i <= text.length + 1; i++) {
        for (const bound of [-2, -1, 0, 65, 65535, 65536]) {
            out += (c < bound ? "a" : "-") + (c <= bound ? "b" : "-") + (c > bound ? "c" : "-") + (c >= bound ? "d" : "-") + (bound < c ? "e" : "-") + (bound <= c ? "f" : "-") + (bound > c ? "g" : "-") + (bound >= c ? "h" : "-") + (c === bound ? "i" : "-") + (c !== bound ? "j" : "-");
        }
        out += "|";
        c = text.charCodeAt(i);
    }
    return out;
}

function nested(rows: string[]): number {
    let sum = 0;
    let c = 0;
    for (let r = 0; r < rows.length; r++) {
        const row = rows[r];
        for (let i = 0; i < row.length; i++) {
            if (c > 96) sum += c;
            c = row.charCodeAt(i);
        }
        if (c < 97) sum -= 1;
    }
    return sum + c;
}

show("numbers", parseNumbers("12.5 7 0.25 1000 3.125"), parseNumbers(""), parseNumbers("."), parseNumbers("9"), parseNumbers("x1y22z"));
show("off the end", ...runsOffTheEnd("123"), ...runsOffTheEnd(""), ...runsOffTheEnd("12a"), ...runsOffTheEnd("￿"));
show("fraction", ...joinedWithFraction("0Az", 1), ...joinedWithFraction("0Az", 9), ...joinedWithFraction("", 0));
show("negative zero", ...joinedWithNegativeZero("abc", 1), ...joinedWithNegativeZero("abc", 2));
show("swapped", ...swapped("A", 0), ...swapped("A", 1), ...swapped("A", 2), ...swapped("A", 3), ...swapped("0", 7), ...swapped("", 4));
show("missing", ...sometimesMissing("0Az9"), ...sometimesMissing(""));
show("comparisons", everyComparison("A\u0000￿"), everyComparison(""));
show("nested", nested(["abc", "", "XYZ", "q"]), nested([]), nested([""]));
console.log(lines.join("\n"));
//// loops-over-segments.ts
// `for..of` over the result of `segmenter.segment(text)` skips the iterator protocol as long as the program cannot observe that.
const print = (s: string) => console.log(s);
////= show-6
function cat(a: string, b: string): string { return a + b; }
function cat3(a: string, b: string, c: string): string { return `${a}${b}${c}`; }
function part(s: string, from: number, to: number): string { return s.slice(from, to); }
function flattened(s: string): string { s.charCodeAt(0); return s; }

const log: string[] = [];
const graphemes = new Intl.Segmenter(), words = new Intl.Segmenter("en", { granularity: "word" });
export function typed(s: string): string { let out = ""; for (const { segment, index } of graphemes.segment(s)) out += index + show(segment); return out; }
export function untyped(g: any, s: any): any { let out = ""; for (const { segment } of g.segment(s)) out += "[" + segment + "]"; return out; }
export function whole(s: string): string { let out = ""; for (const data of graphemes.segment(s)) out += Object.keys(data).join() + (data.input === s) + ";"; return out; }
export function held(segments: any): any { let out = ""; for (const { index } of segments) out += index; return out; }
export function leaving(s: string, at: number): string { let out = ""; for (const { segment, index } of graphemes.segment(s)) { if (index === at) break; if (index === at - 1) continue; if (index === at + 2) return "R" + out; out += segment; } return out; }
export function throwing(s: string): string { let out = ""; try { for (const { segment, index } of graphemes.segment(s)) { try { if (index === 1) throw new Error("inner"); out += segment; } catch (e) { out += "!"; } if (index === 2) throw new Error("outer"); } } catch (e) { out += (e as Error).message; } finally { out += "."; } return out; }
export function nested(a: string, b: string): string { let out = ""; for (const x of graphemes.segment(a)) for (const y of graphemes.segment(b)) for (const z of words.segment(a)) out += x.index + "" + y.index + z.index + ","; return out; }
export async function awaiting(s: string): Promise<string> { let out = ""; for (const { segment } of graphemes.segment(s)) { await null; out += segment + "."; } return out; }
export function* yielding(s: string): Generator<string> { for (const { segment } of graphemes.segment(s)) yield segment; }
export function spread(s: string): string { return [...graphemes.segment(s)].map(x => x.index).join() + "|" + Array.from(graphemes.segment(s), x => x.segment.length).join(); }
print(typed("ab") + " " + typed("") + "|" + typed("éx\r\n😀─") + " " + untyped(graphemes, "a日b") + " " + untyped(words, "two words") + " " + untyped(new Intl.Segmenter("ja", { granularity: "sentence" }), "One. Two.") + " " + whole("ab") + " " + spread("aéb"));
// One Segments object, iterated twice, and while another iteration of it is under way; its own iterator, held.
{ const segments = graphemes.segment("abc"); print(held(segments) + held(segments)); let out = ""; for (const a of segments) for (const b of segments) out += a.index + "" + b.index + ","; print(out); const it = segments[Symbol.iterator](); it.next(); print(held(it) + "|" + held(it) + JSON.stringify(it.next())); }
// Somebody can tell.
{ const segments: any = graphemes.segment("ab"); segments[Symbol.iterator] = function () { log.push("own iterator"); return [{ index: "x" }][Symbol.iterator](); }; print(held(segments) + log.splice(0).join()); }
{ const segments: any = graphemes.segment("ab"); segments.extra = 1; print(held(segments) + segments.extra); }
