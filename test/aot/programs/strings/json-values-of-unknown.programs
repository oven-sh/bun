//// keys-made-only-where-they-are-needed.ts
// A key is put together in one place and used in others: looked up on one branch and handed on in the other, used again behind a join, inside a loop that the key stands outside of, in a closure, returned, thrown, caught; and the table may be one that nothing proves to be a plain Map or Set. The string has to be the same everywhere, however late it is made.
const report: string[] = [];
let wrong = 0;

class Account {
  constructor(readonly owner: string, readonly label: string) {}
}
const ledger = new Map<string, Account>();
const archive: Record<string, Account> = {};
function open(owner: string, year: number, archived: boolean): Account {
  const label = owner + "@" + year;
  if (archived) {
    const old = archive[label];
    return old ?? (archive[label] = new Account(owner, label));
  }
  const held = ledger.get(label);
  if (held) return held;
  const fresh = new Account(owner, label);
  ledger.set(label, fresh);
  return fresh;
}
for (let turn = 0; turn < 3; turn++)
  for (const owner of ["ann", "bo", "", "zoë", "Женя"])
    for (let year = 1998; year < 2040; year += 7) {
      const live = open(owner, year, false);
      const stored = open(owner, year, true);
      if (live.label !== stored.label || live.label !== [owner, year].join("@") || live === (stored as unknown)) wrong++;
      if (open(owner, year, false) !== live || open(owner, year, true) !== stored) wrong++;
    }
report.push("branches " + ledger.size + " " + Object.keys(archive).length);

function afterAJoin(table: Map<string, number>, stem: string, n: number): string {
  const label = stem + "-" + n;
  let value: number;
  if (n % 3 === 0) value = label.length;
  else value = table.get(label) ?? -1;
  if (n % 2 === 0) table.set(label, value + 1);
  return n % 5 === 0 ? label + ">" + value : "";
}
{
  const table = new Map<string, number>();
  let text = "";
  for (let turn = 0; turn < 2; turn++) for (let n = 0; n < 31; n++) text += afterAJoin(table, turn ? "s" : "stem", n % 16);
  report.push("join " + table.size + " " + text);
}

function outsideTheLoop(table: Map<string, number>, stem: string, n: number): string {
  const label = `${stem}[${n}]`;
  let sum = 0;
  for (let i = 0; i < 6; i++) {
    sum += table.get(label) ?? 1;
    if (i === 2) table.set(label, 10);
    if (i === 4) table.delete(label);
  }
  const copies: string[] = [];
  while (copies.length < 2) copies.push(label);
  return sum + copies.join("");
}
report.push("loop " + outsideTheLoop(new Map(), "q", 4) + " " + outsideTheLoop(new Map([["q[4]", 3]]), "q", 4));

function later(group: Set<string>, stem: string, n: number): () => string {
  const label = stem + "/" + n;
  if (group.has(label)) return () => "again " + label;
  group.add(label);
  return () => "first " + label;
}
{
  const group = new Set<string>();
  report.push("closure " + [later(group, "c", 1), later(group, "c", 2), later(group, "c", 1)].map(say => say()).join(", "));
}

function itself(table: Map<string, string>, stem: string, n: number): string {
  const label = stem + "*" + n;
  const held = table.get(label);
  if (held !== undefined) return held + "'";
  table.set(label, label);
  return label;
}
{
  const table = new Map<string, string>();
  report.push("returned " + itself(table, "r", 9) + " " + itself(table, "r", 9) + " " + itself(table, "", -1) + " " + table.size);
}

function orThrow(table: Map<string, number>, stem: string, n: number): number {
  const label = stem + "!" + n;
  const held = table.get(label);
  if (held === undefined) throw label;
  return held;
}
function insideTry(table: Map<string, number>, stems: string[]): string {
  let failures = 0;
  let last = "";
  for (let i = 0; i < stems.length; i++) {
    try {
      const label = stems[i]! + "?" + (i % 4);
      const held = table.get(label);
      if (i % 5 === 2) throw new TypeError(label);
      table.set(label, held === undefined ? i : held - i);
    } catch (problem) {
      failures++;
      last = (problem as Error).message;
    }
  }
  return failures + " " + last + " " + table.size;
}
{
  const table = new Map<string, number>([["t!1", 8]]);
  const said: string[] = [];
  for (const n of [1, 2, 1]) {
    try {
      said.push(String(orThrow(table, "t", n)));
    } catch (label) {
      said.push("no " + label);
    }
  }
  report.push("thrown " + said.join(", ") + " | " + insideTry(new Map(), ["a", "b", "a", "c", "a", "b", "a", "d", "a", "b", "c", "a", "b"]));
}

class Folding extends Map<string, number> {
  asked = 0;
  get(label: string): number | undefined {
    this.asked++;
    return super.get(label.toLowerCase());
  }
  set(label: string, value: number): this {
    return super.set(label.toLowerCase(), value);
  }
}
type Shelf = { counts: Map<string, number>; present: Set<string> };
function onAnyShelf(shelves: Shelf[], stems: string[]): string {
  for (let i = 0; i < stems.length * 3; i++) {
    const shelf = shelves[i % shelves.length]!;
    const label = stems[i % stems.length]! + "_" + stems[(i * 2 + 1) % stems.length]!;
    const times = shelf.counts.get(label);
    shelf.counts.set(label, times === undefined ? 1 : times + 1);
    if (!shelf.present.has(label)) shelf.present.add(label);
  }
  return shelves.map(shelf => shelf.counts.size + "," + shelf.present.size + "," + [...shelf.counts].slice(0, 2).join("+")).join(" ");
}
{
  const folding = new Folding();
  report.push("any table " + onAnyShelf([{ counts: new Map(), present: new Set() }, { counts: folding, present: new Set() }], ["Ab", "aB", "cd", "CD", "e"]) + " " + folding.asked);
}

class Halving extends Map<number, number> {
  get(key: number): number | undefined {
    const held = super.get(key);
    if (key % 4 === 0) super.delete(key);
    return held === undefined ? undefined : held / 2;
  }
}
function numbersOnAnyTable(tables: Map<number, number>[], keys: number[]): string {
  let sum = 0;
  for (let turn = 0; turn < 3; turn++)
    for (let i = 0; i < keys.length; i++) {
      const table = tables[(i + turn) % tables.length]!;
      const key = keys[i]!;
      if (table.has(key)) sum += table.get(key)!;
      else table.set(key, i + 1);
      const half = table.get(key + 0.5);
      table.set(key + 0.5, half === undefined ? 1 : half + 1);
    }
  return sum + " " + tables.map(table => table.size).join();
}
report.push("numbers " + numbersOnAnyTable([new Map(), new Halving()], [8, 3, 12, 3, 8, 5, 16, 12, 1]), "wrong " + wrong);
console.log(report.join("\n"));
//// keys-returned-to-lookups.ts
// Functions that make a key and return it, as TypeScript's getRelationKey does; their callers look it up in a Map, a Set and an object, keep it in arrays, compare it and read its characters.
// The keys are short and long, of one byte and of two bytes a character, look like array indexes, are empty, and are made of numbers, strings, booleans, undefined and null.
interface Item {
  id: number
  name: string
}
function relationKey(source: Item, target: Item, postfix: string): string {
  return `${source.id},${target.id}${postfix}`
}
function nameKey(source: Item, target: Item): string {
  return source.name + "|" + target.name
}
function indexKey(first: number, second: number): string {
  return "" + first + second
}
function listKey(items: readonly Item[]): string {
  let result = ""
  for (const item of items) {
    if (result.length) result += ","
    result += item.id
  }
  return result
}
function chosenKey(source: Item, target: Item, byName: boolean): string {
  return byName ? nameKey(source, target) : relationKey(source, target, "")
}
function mixedKey(a: unknown, b: unknown): string {
  return a + ":" + b
}

const items: Item[] = []
const names = ["a", "", "long".repeat(40), "é", "日本語", "😀", "0", "-1", "x y", "__proto__", "constructor", "\u0000", "a|b"]
for (let i = 0; i < 200; i++) items.push({ id: i * 37 - 500, name: names[i % names.length] + (i > 100 ? i : "") })

const relation = new Map<string, number>()
const seen = new Set<string>()
const table: Record<string, number> = {}
const kept: string[] = []
let found = 0
for (let round = 0; round < 30; round++) {
  for (let i = 0; i < items.length; i++) {
    const source = items[i]
    const target = items[(i * 13 + round) % items.length]
    const id = relationKey(source, target, round % 3 ? "" : ":" + (round % 5))
    const entry = relation.get(id)
    if (entry !== undefined) found += entry
    else relation.set(id, i)
    if (!seen.has(id)) {
      seen.add(id)
      if (id.startsWith("-") && kept.length < 50) kept.push(id)
    }
    const named = nameKey(source, target)
    table[named] = (table[named] ?? 0) + 1
    const chosen = chosenKey(source, target, round % 2 === 0)
    if (relation.has(chosen)) found++
  }
}
console.log(relation.size, seen.size, found, Object.keys(table).length, kept.length, kept.slice(0, 5).join(" "), kept[7].length, kept[9].charCodeAt(1), kept[3] === relationKey(items[0], items[3], ""))

let total = 0
for (const key of Object.keys(table).sort()) total = (total * 31 + key.length * table[key]) | 0
console.log(total, table["a|"], table["|a"], table[nameKey(items[3], items[4])], table[nameKey(items[9], items[10])], Object.getPrototypeOf(table) === Object.prototype)

const byIndex: number[] = []
const sparse: Record<string, string> = {}
for (let first = 0; first < 12; first++) {
  for (let second = 0; second < 12; second++) {
    const key = indexKey(first, second)
    sparse[key] = key
    byIndex[key as unknown as number] = first + second
  }
}
console.log(byIndex.length, Object.keys(sparse).slice(0, 14).join(), sparse["00"], sparse["0"], sparse[indexKey(1, 0)], byIndex[10], byIndex[indexKey(11, 11) as unknown as number], Object.keys(byIndex).length)

const lists = new Map<string, number>()
for (let length = 0; length < 40; length++) lists.set(listKey(items.slice(0, length)), length)
console.log(lists.size, lists.get(""), lists.get("-500"), lists.get(listKey(items.slice(0, 3))), lists.get(listKey(items.slice(0, 39))), listKey(items.slice(0, 39)).length)

const mixed = new Map<string, string>()
const parts: unknown[] = [0, -0, 1.5, NaN, Infinity, 1e21, 1e-7, 4294967295, 4294967296, true, false, undefined, null, "", "s", 12n, "é", "日"]
for (const a of parts) for (const b of parts) mixed.set(mixedKey(a, b), String(a) + "&" + String(b))
console.log(mixed.size, mixed.get("0:0"), mixed.get("NaN:undefined"), mixed.get(":"), mixed.get("12:é"), mixed.get(mixedKey(1e21, -0)), mixed.get(mixedKey("日", null)), [...mixed.keys()].join("").length)
//// keys-that-helpers-build-and-callers-look-up.ts
// Keys of Maps as a type checker builds them: a helper returns the text, the caller looks it up. Few distinct keys, asked for again and again.
type Item = { id: number };
function listId(items: readonly Item[]): string {
  let result = "";
  const length = items.length;
  let i = 0;
  while (i < length) {
    const startId = items[i]!.id;
    let count = 1;
    while (i + count < length && items[i + count]!.id === startId + count) count++;
    if (result.length) result += ",";
    result += startId;
    if (count > 1) result += ":" + count;
    i += count;
  }
  return result;
}
function aliasId(symbol: Item | undefined, args: readonly Item[] | undefined): string { return symbol ? "@" + symbol.id + (args ? ":" + listId(args) : "") : ""; }
function pairId(a: Item, b: Item): string { return a.id + "," + b.id; }
const items: Item[] = []; for (let i = 0; i < 4096; i++) items.push({ id: i * 7 + 3 });
const lists: Item[][] = []; for (let i = 0; i < 512; i++) lists.push([items[i]!, items[(i * 5) & 4095]!, items[(i * 11 + 1) & 4095]!]);
const byList = new Map<string, number>(), byAlias = new Map<string, number>(), byPair = new Map<string, number>();
let hits = 0;
const which = Number(process.argv[2] ?? 0), rounds = Number(process.argv[3] ?? 2000);
for (let r = 0; r < rounds; r++) {
  const list = lists[r & 511]!;
  if (which === 0 || which === 1) { const id = listId(list); const found = byList.get(id); if (found === undefined) byList.set(id, r); else hits++; }
  if (which === 0 || which === 2) { const id = aliasId(list[0], list); const found = byAlias.get(id); if (found === undefined) byAlias.set(id, r); else hits++; }
  if (which === 0 || which === 3) { const id = pairId(list[0]!, list[1]!); const found = byPair.get(id); if (found === undefined) byPair.set(id, r); else hits++; }
}
console.log(hits, byList.size, byAlias.size, byPair.size);
//// keys-that-look-like-integers.ts
function spell(parts: (string | number)[]): string {
  return parts.map(part => String(part)).join("").split("").join("");
}

function joinIds(ids: number[]): string {
  let result = "";
  for (let i = 0; i < ids.length; i++) {
    if (result.length) result += ",";
    result += ids[i];
  }
  return result;
}

function joinTexts(texts: string[]): string {
  let result = "";
  for (const text of texts) result += text;
  return result;
}

function pairKey(a: number, b: number, suffix: string): string {
  return `${a},${b}${suffix}`;
}

function tripleKey(a: number, separator: string, b: number): string {
  return a + separator + b;
}

const table = new Map<string, string>();
const list: string[] = [];
list[7] = "seven";
list[10] = "ten";
list[12345678] = "eight digits";

function describe(key: string, expected: string): string {
  const spelled = spell([expected]);
  table.set(spelled, "stored " + expected);
  const indexed = (list as unknown as Record<string, string | undefined>)[key];
  return [JSON.stringify(key), key === spelled, key.length, table.get(key), table.has(key + " "), indexed, String(Number(key))].join(" | ");
}

const numbers = [0, 1, 7, 9, 10, 99, 100, 255, 256, 257, 65535, 999999, 1000000, 9999999, 10000000, 12345678, 99999999, 100000000, 100000001, 999999999, 1000000000, 2147483647, 2147483648, 4294967294, 4294967295, 4294967296, 9999999999];
for (const number of numbers) {
  console.log("one id:", describe(joinIds([number]), String(number)));
  console.log("by parts:", describe(tripleKey(number, "", 0).slice(0, -1), String(number)));
}
for (let round = 0; round < 3; round++) {
  for (const number of numbers) {
    if (joinIds([number]) !== String(number)) console.log("differs", number);
    if (table.get(joinIds([number])) !== "stored " + number) console.log("not found", number);
  }
}

const texts = [["0", "0"], ["0", "7"], ["00", "7"], ["1", "0"], ["1", "", "0"], ["12", "/"], ["12", ":"], ["/", "12"], [":", "12"], ["1", ",", "2"], ["1", " "], [" ", "1"], ["1", "a"], ["1", "°"], ["±", "1"], ["1", "ÿ", "1"], ["-", "1"], ["1", "e", "3"], ["1234", "5678"], ["1234", "56789"], ["12345", "67890"], ["12345", "678901"], ["4294", "967295"], ["0123", "4567"], ["1", "٠"]];
for (const parts of texts) {
  console.log("texts:", describe(joinTexts(parts), parts.join("")));
}

for (const [a, b] of [[0, 0], [1, 2], [-1, 2], [1, -2], [99999999, 100000000], [100000000, 99999999], [2147483647, -2147483648], [12, 345678], [1.5, 2], [1, 2.5], [1e21, 1], [-0, 0], [NaN, 1]]) {
  for (const suffix of ["", ":1", ":", "é", "一", "x".repeat(50), "x".repeat(70)]) {
    console.log("pair:", describe(pairKey(a, b, suffix), a + "," + b + suffix));
  }
  for (const separator of ["", ",", "0", "-", "·", "一"]) {
    console.log("triple:", describe(tripleKey(a, separator, b), String(a) + separator + String(b)));
  }
}

let found = 0;
const pairs = new Map<string, number>();
for (let round = 0; round < 3; round++) {
  for (let i = 0; i < 40000; i++) {
    const key = pairKey(i * 31, i % 977, i % 5 ? "" : ":" + (i % 3));
    const former = pairs.get(key);
    if (former === undefined) pairs.set(key, i);
    else if (former === i) found++;
    const other = tripleKey(i, ",", i * 7);
    if (other !== spell([i, ",", i * 7]) && found >= 0) found = -1000000;
  }
}
console.log("pairs:", pairs.size, found);
//// large-patterns-made-once-are-collected.js
// A pattern made from a large text and used once is garbage afterwards, with its text and whatever was made of it.
function use(number) {
  const words = [];
  for (let i = 0; i < 2500; i++) words.push("w" + number + "x" + i);
  return new RegExp("^(?:" + words.join("|") + ")$").test("w" + number + "x2499");
}
for (let number = 0; number < 20; number++) use(-number);
Bun.gc(true);
const before = process.memoryUsage().rss;
let matches = 0;
for (let number = 1; number <= 1000; number++) if (use(number)) matches++;
Bun.gc(true);
const grown = (process.memoryUsage().rss - before) / (1024 * 1024);
if (process.argv[2] === "show") console.log(Math.round(grown) + " MB");
console.log(matches, grown < 150 ? "the memory did not grow with the number of patterns" : "the memory grew by " + Math.round(grown) + " MB");
//// last-index-of-a-character-from-every-position.ts
// lastIndexOf with a text of one character, a longer text and every kind of position, on 8-bit, 16-bit and concatenated strings. Every line prints what plain Bun prints.
declare const console: { log(...values: unknown[]): void };
function opaque<T>(value: T): T { return [value][Number(String(0))]; }
function lastSlash(s: string): number { return s.lastIndexOf("/") + s.length * 100; }
function lastSlashFrom(s: string, from: number): number { return s.lastIndexOf("/", from) + s.length * 100; }
function lastPair(s: string, from: number): number { return s.lastIndexOf("::", from) + s.length * 100; }
function lastWide(s: string, from: number): number { return s.lastIndexOf("β", from) + s.length * 100; }
function extension(s: string): string { return s.slice(s.lastIndexOf(".") + 1) + s.charCodeAt(0); }

const out: unknown[] = [];
const subjects = ["", "/", "a", "a/b", "/a/b/", "a//b", "α/β/β", opaque("left/") + opaque("right/x"), "a::b:::c"];
for (const s of subjects) {
    out.push(lastSlash(opaque(s)), extension(opaque(s + ".ts")));
    for (const from of [-Infinity, -5, -1, 0, 1, 2, 3.7, 100, Infinity, NaN])
        out.push(lastSlashFrom(opaque(s), opaque(from)), lastPair(opaque(s), opaque(from)), lastWide(opaque(s), opaque(from)));
}
console.log(out.join(" "));
