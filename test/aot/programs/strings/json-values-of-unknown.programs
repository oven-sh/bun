console.log(hits, entries() - before < 100 ? "few entries" : "MANY ENTRIES", seen());
var pairs = /(\d\d)/g, sticky = /[a-z]\d/y, ends = 0;
before = entries();
for (var k = 0; k < 2000; k++) {
  pairs.lastIndex = k & 3;
  if (tests(pairs, "a12b34")) ends += pairs.lastIndex;
  sticky.lastIndex = k % 3;
