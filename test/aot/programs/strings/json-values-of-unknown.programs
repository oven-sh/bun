//// literals-on-cold-paths.ts
// A string literal that is only wanted where something goes wrong: the message of an assertion, the default of a lookup, the text of an error. The literal must be there in every arm that uses it, whichever is taken first.
const out: string[] = [];
namespace Debug {
    export let failures = 0;
    export function fail(message?: string): never { failures++; throw new Error(message ? "Debug Failure. " + message : "Debug Failure."); }
    export function assert(expression: unknown, message?: string, verbose?: string | (() => string)): asserts expression {
        if (!expression) {
            message = message ? "False expression: " + message : "False expression.";
            if (verbose) message += "\r\nVerbose Debug Information: " + (typeof verbose === "string" ? verbose : verbose());
            fail(message);
        }
    }
}
let assertOfTheDay: (expression: unknown, message?: string) => void = Debug.assert;
function token(kind: number): number {
    Debug.assert(kind >= 0 && kind <= 166, "Invalid token");
    Debug.assert(kind <= 15 || kind >= 18, "Invalid token. Use 'createTemplateLiteralLikeNode' to create template literals.");
    Debug.assert(kind <= 9 || kind >= 15, "Invalid token. Use 'createLiteralLikeNode' to create literals.");
    Debug.assert(kind !== 80, "Invalid token. Use 'createIdentifier' to create identifiers");
    return kind * 2;
}
function throughVariable(kind: number): number {
    assertOfTheDay(kind !== 7, "seven is not wanted here");
    assertOfTheDay(kind !== 8, "nor is eight");
    return kind + 1;
}
function twoArms(kind: number, other: number): string {
    const message = "a text for two arms";
    if (kind === 1000) return message + "!";
    if (other === 1000) return "?" + message;
    return "";
}
function threeArms(kind: number): string {
    const message = "a text for three arms";
    if (kind === 1000) return message + "1";
    if (kind === 2000) return message + "2";
    if (kind === 3000) return message + "3";
    return "";
}
function alsoOnTheUsualPath(kind: number): number {
    const message = "a text that is always wanted";
    if (kind === 1000) return (message + "!").length;
    if (kind === 2000) return ("?" + message).length;
    return message.length + kind;
}
function inLoop(list: number[]): string {
    const message = "a text used in a loop's rare arm";
    let found = "";
    for (const x of list) { if (x === 1000) found += message; else if (x === 2000) found += message.length; }
    return found;
}
function sameCell(kind: number): boolean {
    const message = "one literal, one value";
    const a = kind === 1000 ? message : "x";
    const b = kind >= 1000 ? message : "y";
    return a === b;
}
function attempt(what: string, f: () => unknown): void { try { out.push(what + ": " + String(f())); } catch (e) { out.push(what + " threw: " + (e as Error).message); } }
let sum = 0;
for (let i = 0; i < 300; i++) { const kind = i % 167; if ((kind > 9 && kind < 18) || kind === 80) continue; sum += token(kind) + throughVariable(kind > 8 ? kind : 1) + twoArms(kind, i).length + threeArms(kind).length + alsoOnTheUsualPath(kind); }
out.push("sum " + sum);
for (const kind of [-1, 167, 16, 17, 10, 14, 80, 0, 166]) attempt("token " + kind, () => token(kind));
for (const kind of [7, 8, 9]) attempt("through a variable " + kind, () => throughVariable(kind));
assertOfTheDay = (expression, message) => { out.push("another assert: " + String(expression) + " " + message); };
for (const kind of [7, 8, 9]) attempt("through another " + kind, () => throughVariable(kind));
out.push([twoArms(1000, 0), twoArms(0, 1000), twoArms(1000, 1000), twoArms(0, 0)].join("|"));
out.push([threeArms(1000), threeArms(2000), threeArms(3000), threeArms(0)].join("|"));
out.push([alsoOnTheUsualPath(1000), alsoOnTheUsualPath(2000), alsoOnTheUsualPath(3)].join("|"));
out.push(inLoop([1, 1000, 2, 2000, 1000]) + "|" + inLoop([]) + "|" + inLoop([5]));
out.push([sameCell(1000), sameCell(1001), sameCell(1)].join("|"));
out.push("failures " + Debug.failures);
console.log(out.join("\n"));
//// long-classes-that-take-turns-in-a-pattern-out-of-run-time-text.ts
// The parser takes a character class whose text it has parsed before in the same pattern without parsing it again: the last short one, and the last sixteen long ones.
// Here long classes take turns, twenty of them push each other out, two differ in their last character only, one is the beginning of another, one comes negated, one stands under (?i: ) and outside of it,
// and each is followed by another quantifier. The patterns are put together at run time. The output is that of plain Bun.
const given: string = typeof process === "object" ? process.argv.slice(2).join("") : String(Date.now()).slice(0, 0);
function longClass(first: number, count: number, more = ""): string {
  let text = "[";
  for (let i = 0; i < count; i++) text += "\\u" + (first + i * 2).toString(16).padStart(4, "0");
  return text + more + given + "]";
}
const log: string[] = [];
function show(source: string, flags: string, ...subjects: string[]) {
  const pattern = new RegExp(source, flags);
  log.push(source.length + " " + flags + " " + subjects.map(subject => {
    pattern.lastIndex = 0;
    const match = pattern.exec(subject);
    return match ? match.index + ":" + JSON.stringify(match[0]) + ":" + (match.length - 1) : "no";
  }).join(" "));
}
const a = longClass(0x61, 6), b = longClass(0x62, 6), c = longClass(0x41, 6), d = longClass(0x30, 5);
show("^" + a + b + a + b + c + d + a + "$", "", "abcbA0a", "abcbA1a", "bbcbA0a", "acedC8k");
show("^" + a + "+" + b + "*" + a + "?" + b + "{2}" + a + "+?" + b + "*?$", "", "aabbbdd", "acebdfbd", "bd", "abb");
const twenty: string[] = [];
for (let i = 0; i < 20; i++) twenty.push(longClass(0x100 + i * 32, 6, String.fromCharCode(97 + i)));
show("^" + twenty.join("") + twenty.join("") + twenty[0] + twenty[19] + twenty[3] + "$", "", "abcdefghijklmnopqrstabcdefghijklmnopqrstatd", "abcdefghijklmnopqrstabcdefghijklmnopqrstatc", "ĀbcdefghijklmnopqrstĂbcdefghijklmnopqrstatd");
const endsInX = longClass(0x61, 6, "x"), endsInY = longClass(0x61, 6, "y");
show("^" + endsInX + endsInY + endsInX + endsInY + "$", "", "xyxy", "yxyx", "aaaa", "xxxx");
const whole = longClass(0x61, 8), beginning = longClass(0x61, 7);
show("^" + whole + beginning + whole + beginning + "$", "", "oaoa", "oooo", "amom", "aooa");
const negated = "[^" + a.slice(1);
show("^" + a + negated + a + negated + "$", "", "abab", "aaaa", "a1c2", "bbbb");
show("^" + a + "(?i:" + a + a + ")" + a + "$", "", "aAAa", "aaaa", "AAAA", "aACa", "aAaA");
show("^(?:" + a + "|" + b + ")(" + a + ")(?=" + b + ")(?!" + a + ")" + b + "$", "", "aab", "bab", "aaa", "bcd");
show("(" + a + ")\\1" + a, "g", "xxaacxx", "aba", "cce");
show("^[ab][ab][cd][ab][cd][cd]" + a + "[ab]" + a + "[ab]$", "", "abcadcabab", "abcadcaccb", "abcadcabcc");
show("^" + a + "-" + a + "]" + a + "$", "", "a-c]e", "a-c]f");
console.log(log.join("\n"));
//// long-pattern-source.ts
// The `source` property of very long regular expressions, with slashes and escapes.
declare const console: { log(...a: unknown[]): void }
function sum(s: string): number { let h = 0; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0; return h }
function fill(n: number, head: string): string { return head + "|[" + "a".repeat(n - head.length - 7) + "]{9}~" }
const heads: [string, string][] = [["plain", "xy+z"], ["escaped slash", "x\\/y"], ["slash in brackets", "x[/]y"], ["bare slash", "x/y"], ["bare slash behind an escaped one", "x\\/y/z"], ["bracket closed, then a slash", "[a]/b"], ["escaped bracket, then a slash", "\\[/\\]"], ["line feed", "x\ny"], ["carriage return", "x\ry"], ["escaped line feed", "x\\\ny"], ["u2028", "x" + String.fromCharCode(0x2028) + "y"], ["16 bits", "x" + String.fromCharCode(0x4e00) + "y"], ["16 bits and a slash", "x" + String.fromCharCode(0x4e00) + "/y"], ["backslash at the end of the head", "x\\\\"]]
const lengths: number[] = [64, 4095, 4096, 4097, 5000, 16384, 16385, 65535, 65536, 65537, 70000]
let rows = 0
for (const [name, head] of heads) {
  let line = name + ":"
  for (const n of lengths) {
    for (const flags of ["", "giu"]) {
      let r: RegExp
      try { r = new RegExp(fill(n, head), flags) } catch (e) { line += " " + n + flags + ":" + (e as Error).name; rows++; continue }
      const s = r.source, again = r.source, t = r.toString(), copy = new RegExp(r), text = String(r)
      line += " " + n + flags + ":" + s.length + "," + sum(s) + "," + (s === again) + "," + t.length + "," + sum(t) + "," + (copy.source === s) + "," + (text === t) + "," + JSON.stringify(s.slice(0, 12)) + "," + r.test("xy") + r.test("aaaaaaaaa~")
      rows++
    }
  }
  console.log(line)
}
const a = new RegExp(fill(5000, "one")), b = new RegExp(fill(6000, "two\\/"))
const joined = new RegExp(a.source + "|" + b.source, "g")
console.log(joined.source.length, sum(joined.source), joined.source === a.source + "|" + b.source, new RegExp("").source, new RegExp("/").source, /a\/b/.source, /[/]/.source)
console.log(rows + " rows")
