let sum = 0;
for (let i = 0; i < 60000; i++) {
  const text = `${2000 + (i % 30)}-${10 + (i % 3)}-${10 + (i % 19)}`;
  const match = i & 1 ? execs(date, text) : execsUntyped(date, text);
