  recent[i & 7] = narrow;
  recent[8 + (i & 7)] = wide;
  length += narrow.length + wide[3].length;
  if (/^(\d{4})-(\d{2})-(\d{2})$/.exec(wideDates[i & 7]) || dates[i & 7].match(/^(\d{4})年(\d{1,2})月(.)/)) length = -1;
}
