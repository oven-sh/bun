function table(rows: string[], columns: string[]): string[] {
  const lines: string[] = [];
  for (let i = 0; i < rows.length; i++) {
    const a = rows[i];
    let line = "";
    for (let j = 0; j < columns.length; j++) {
      const b = columns[j];
      line += a < b ? "<" : a > b ? ">" : a <= b && a >= b ? "=" : "-";
    }
    lines.push(line);
  }
  return lines;
}
for (const line of table(texts.map(flat), texts.map(rope))) console.log(line);
console.log(String(table(texts.map(wideRope), texts.map(substring)).join() === table(texts.map(deepRope), texts.map(wide)).join()));

const same = rope("abcdefghi");
console.log("one cell " + describe(allFour(same, same)) + describe(allFourUntyped(same, same)) + describe(oneAtATime(same, same)));

const sometimesMissing: (string | undefined | null)[] = [undefined, null, flat(""), flat("a"), rope("10"), flat("0"), rope("null"), substring("undefined")];
for (const a of sometimesMissing) console.log("missing " + sometimesMissing.map(b => describe(allFourOptional(a, b)) + describe(allFourUntyped(a, b))).join(" "));

const others: unknown[] = [9, 10.5, NaN, true, 10n, [2], {}, { valueOf: () => 11 }, { toString: () => "b" }];
for (const text of ["10", "9", "a", ""]) console.log("against other values " + quoted(text) + " " + others.map(other => describe(allFourUntyped(rope(text), other)) + describe(allFourUntyped(other, wide(text)))).join(" "));

const sorted = texts.map(rope).reverse().sort(sign);
console.log(sorted.map(quoted).join(" "));
console.log("sort() agrees " + String(sorted.join("|") === texts.map(wide).sort().join("|")));
//// parse-int-of-slices-with-radix.ts
// parseInt of a piece of a string, with a radix.
declare const console: any;

const texts: string[] = ["", "0", "12345", "ff00ff", "0x1f", "  42  ", "-17", "+8", "zz", "undefined", "１２", "1e3", "9007199254740993", "101010", "7\0", "Ā12"];
const radixes: number[] = [0, 2, 8, 10, 16, 36, 37, 1, -1, 4294967306, -4294967286];

function decimal(text: string, from: number, to: number): number { return parseInt(text.slice(from, to), 10); }
function hexadecimal(text: string, from: number, to: number): number { return parseInt(text.substring(from, to), 16); }
function anyInteger(text: string, from: number, radix: number): number { return parseInt(text.slice(from), radix | 0); }
function anyNumber(text: string, from: number, radix: number): number { return parseInt(text.slice(from), radix); }
function anyValue(text: string, from: number, radix: any): number { return parseInt(text.slice(from), radix); }
function digit(text: string, i: number): number { return parseInt(text[i], 10); }
function digitOfBase36(text: string, i: number): number { return parseInt(text[i], 36); }
function digitOfBase31(text: string, i: number): number { return parseInt(text[i], 31); }
function digitOfBase30(text: string, i: number): number { return parseInt(text[i], 30); }
function digitOfAnyBase(text: string, i: number, radix: number): number { return parseInt(text[i], radix | 0); }
function character(text: string, i: number): number { return parseInt(text.charAt(i), 16); }
function last(text: string): number { return parseInt(text.at(-1) as string, 36); }

for (const text of texts) {
    for (let from = -1; from <= text.length + 1; from++) {
        console.log(JSON.stringify(text), from, decimal(text, from, from + 3), hexadecimal(text, from, from + 2), digit(text, from), digitOfBase36(text, from), digitOfBase31(text, from), digitOfBase30(text, from), character(text, from));
        for (const radix of radixes)
            console.log(radix, anyInteger(text, from, radix), anyNumber(text, from, radix), anyValue(text, from, radix), digitOfAnyBase(text, from, radix));
    }
    console.log(last(text), anyNumber(text, 0, 16.9), anyNumber(text, 0, NaN), anyValue(text, 0, "16"), anyValue(text, 0, undefined), anyValue(text, 0, null), anyValue(text, 0, { valueOf() { return 8; } }));
}
export {};
//// parts-of-every-kind-now-and-then-behind-a-text-of-every-length.ts
// Every kind of part is appended, some of them only now and then, behind a text of every length from 0 to 300.
////= hash

const letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_";
function textOfLength(length: number): string {
  let text = "";
  while (text.length < length) text += letters;
  return text.slice(0, length);
}

function withConstants(head: string, integer: number, rounds: number): string {
  let out = head;
  for (let i = 0; i < rounds; i++) {
    out += "0123456789abcdef";
    if (i & 1) out += integer;
    out += "x";
    if (integer & 1) out += "0123456789abcde";
    out += "\xe9\xff";
    out += integer;
  }
  return out;
}

function withNumbers(head: string, integer: number, number: number, rounds: number): string {
  let out = head;
  for (let i = 0; i < rounds; i++) {
    out += integer;
    if (i & 1) out += ",";
    out += number;
    out += ",";
    if (number > 0) out += integer | 0;
    out += number * 0.5;
  }
  return out;
}

function withWords(head: string, flag: boolean, maybe: string | null | undefined, other: string | null | undefined, rounds: number): string {
  let out = head;
  for (let i = 0; i < rounds; i++) {
    out += flag;
    if (flag) out += maybe;
    out += !flag;
    out += other;
    if (i & 1) out += flag;
    out += maybe;
  }
  return out;
}

function withRanges(head: string, source: string, from: number, to: number, rounds: number): string {
  let out = head;
  for (let i = 0; i < rounds; i++) {
    out += source.slice(from, to);
    if (i & 1) out += "|";
    out += source.substring(from, to);
    out += "|";
    out += source.substr(from, to);
    if (from > 0) out += "|";
    out += source.charAt(from);
    out += out.length;
  }
  return out;
}

function withStrings(head: string, first: string, second: string, third: string, rounds: number): string {
  let out = head;
  for (let i = 0; i < rounds; i++) {
    out += first;
    if (i & 1) out += second;
    out += third;
    if (out.length > 140) out += first;
    out += out.length;
  }
  return out;
}

function withAnything(head: string, value: string | number | boolean | null | undefined, rounds: number): string {
  let out = head;
  for (let i = 0; i < rounds; i++) {
    out += value;
    if (i & 1) out += ";";
    out += value;
  }
  return out;
}

const integers = [0, 7, 10, 99, 12345, 9999999, 99999999, 100000000, 2147483647, -1, -2147483648, 4294967295, 9007199254740991, -9007199254740991];
const numbers = [0, -0, 0.1, -0.000001234567890123, 1e21, 1.7976931348623157e308, -1.7976931348623157e308, 5e-324, 123456789012345680000, NaN, Infinity, -Infinity, 1e-7, 99999999.5, 4294967296.25, -1e-7];
const positions = [0, 1, -1, 5, -5, 63, 64, 65, 1000, -1000, NaN, Infinity, -Infinity, 1.9, -1.9, 4294967296, -4294967296, 9223372036854775807, -9223372036854775808, 1e300, -1e300, -0];
const wide = "中文 and 😀 and a lone \ud800 half";
const wideButPlainInside = "中plain text behind one wide character, long enough to cut pieces out of it";
const words: (string | null | undefined)[] = [null, undefined, "", "s", "sixteen letters!", wide, textOfLength(40)];

const sums: number[] = [0, 0, 0, 0, 0, 0];
for (let length = 0; length <= 300; length++) {
  const head = textOfLength(length);
  const rope = head + "~" + length;
  const piece = textOfLength(400).slice(length % 7, (length % 7) + (length % 90));
  const rounds = 1 + (length % 3);
  for (const integer of integers) sums[0] = (sums[0] + hash(withConstants(head, integer, rounds))) >>> 0;
  for (const integer of integers) for (const number of numbers) sums[1] = (sums[1] + hash(withNumbers(head, integer, number, rounds))) >>> 0;
  for (const maybe of words) for (const other of words) sums[2] = (sums[2] + hash(withWords(head, (length & 1) === 0, maybe, other, rounds))) >>> 0;
  for (const from of positions) for (const to of positions) {
    sums[3] = (sums[3] + hash(withRanges(head, letters, from, to, rounds))) >>> 0;
    sums[3] = (sums[3] + hash(withRanges(head, wideButPlainInside, from, to, rounds))) >>> 0;
    sums[3] = (sums[3] + hash(withRanges(head, rope, from, to, rounds))) >>> 0;
  }
  for (const text of [rope, piece, wide, "", "\xe9", head]) sums[4] = (sums[4] + hash(withStrings(head, text, piece, rope, rounds))) >>> 0;
  for (const value of [...integers, ...numbers, ...words, true, false]) sums[5] = (sums[5] + hash(withAnything(head, value, rounds))) >>> 0;
  if (length % 25 === 0) console.log(length, sums.join(" "));
}
console.log(sums.join(" "));
console.log(withConstants("", 5, 2), withNumbers("", -0, -0, 2), withWords("", true, null, undefined, 2), withRanges("", letters, 2, -2, 2), withStrings("", "a", "b", "c", 2), withAnything("", -0, 2));
//// parts-of-every-kind-one-after-the-other-behind-a-text-of-every-length.ts
// Every kind of part is appended behind a text of every length from 0 to 300.
////= hash

const letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_";
function textOfLength(length: number): string {
  let text = "";
  while (text.length < length) text += letters;
  return text.slice(0, length);
}

function withConstants(head: string, integer: number): string {
  let out = "";
  out += head;
  out += "0123456789abcdef";
  out += integer;
  out += "x";
  out += "0123456789abcde";
  out += "\xe9\xff";
  out += integer;
  return out;
}

function withNumbers(head: string, integer: number, number: number): string {
  let out = "";
  out += head;
  out += integer;
  out += ",";
  out += number;
  out += ",";
  out += integer | 0;
  out += ",";
  out += number * 0.5;
  return out;
}

function withWords(head: string, flag: boolean, maybe: string | null | undefined, other: string | null | undefined): string {
  let out = "";
  out += head;
  out += flag;
  out += maybe;
  out += !flag;
  out += other;
  out += flag;
  return out;
}

function withRanges(head: string, source: string, from: number, to: number): string {
  let out = "";
  out += head;
  out += source.slice(from, to);
  out += "|";
  out += source.substring(from, to);
  out += "|";
  out += source.substr(from, to);
  out += "|";
  out += source.charAt(from);
  out += "|";
  out += out.length;
  return out;
}

function withStrings(head: string, first: string, second: string, third: string): string {
  let out = "";
  out += head;
  out += first;
  out += second;
  out += third;
  out += first + second;
  out += out.length;
  return out;
}

function withAnything(head: string, value: string | number | boolean | null | undefined): string {
  let out = "";
  out += head;
  out += value;
  out += ";";
  out += value;
  out += ";";
  return out;
}

const integers = [0, 7, 10, 99, 12345, 9999999, 99999999, 100000000, 2147483647, -1, -2147483648, 4294967295, 9007199254740991, -9007199254740991];
const numbers = [0, -0, 0.1, -0.000001234567890123, 1e21, 1.7976931348623157e308, -1.7976931348623157e308, 5e-324, 123456789012345680000, NaN, Infinity, -Infinity, 1e-7, 99999999.5, 4294967296.25, -1e-7];
const positions = [0, 1, -1, 5, -5, 63, 64, 65, 1000, -1000, NaN, Infinity, -Infinity, 1.9, -1.9, 4294967296, -4294967296, 9223372036854775807, -9223372036854775808, 1e300, -1e300, -0];
const wide = "中文 and 😀 and a lone \ud800 half";
const wideButPlainInside = "中plain text behind one wide character, long enough to cut pieces out of it";
const words: (string | null | undefined)[] = [null, undefined, "", "s", "sixteen letters!", wide, textOfLength(40)];

let total = 0;
const sums: number[] = [0, 0, 0, 0, 0, 0];
for (let length = 0; length <= 300; length++) {
  const head = textOfLength(length);
  const rope = head + "~" + length;
  const piece = textOfLength(400).slice(length % 7, (length % 7) + (length % 90));
  for (const integer of integers) sums[0] = (sums[0] + hash(withConstants(head, integer))) >>> 0;
  for (const integer of integers) for (const number of numbers) sums[1] = (sums[1] + hash(withNumbers(head, integer, number))) >>> 0;
  for (const maybe of words) for (const other of words) sums[2] = (sums[2] + hash(withWords(head, (length & 1) === 0, maybe, other))) >>> 0;
  for (const from of positions) for (const to of positions) {
    sums[3] = (sums[3] + hash(withRanges(head, letters, from, to))) >>> 0;
    sums[3] = (sums[3] + hash(withRanges(head, wideButPlainInside, from, to))) >>> 0;
    sums[3] = (sums[3] + hash(withRanges(head, rope, from, to))) >>> 0;
  }
  for (const text of [rope, piece, wide, "", "\xe9", head]) sums[4] = (sums[4] + hash(withStrings(head, text, piece, rope))) >>> 0;
  for (const value of [...integers, ...numbers, ...words, true, false]) sums[5] = (sums[5] + hash(withAnything(head, value))) >>> 0;
  total += head.length;
  if (length % 50 === 0) console.log(length, sums.join(" "));
}
console.log(total, sums.join(" "));
console.log(withConstants("", 5), withNumbers("", -0, -0), withWords("", true, null, undefined), withRanges("", letters, 2, -2), withStrings("", "a", "b", "c"), withAnything("", -0));
//// paths-cut-at-a-class-of-characters.ts
const hidden = new Function("v", "return v") as <V>(v: V) => V;

type Stats = { isFile(): boolean; isDirectory(): boolean };
type Options = { ignored: (path: string, stats?: Stats) => boolean };
function watch(options: Options): (path: string) => boolean {
  return hidden((path: string) => options.ignored(path, undefined));
}
const isIgnored = watch({
  ignored: (path, stats) => {
    if (stats && !stats.isFile() && !stats.isDirectory()) return true;
    if (path.split(/[/\\]/).some(dir => dir === ".git")) return true;
    return false;
  },
});
function words(text: string): string[] { return text.toLowerCase().split(/\s+/); }
function parts(name: string): string[] { return name.split(/[:_-]/).filter(Boolean); }
function lines(text: string): string[] { return text.split(/\r\n?|\n/); }
function limited(text: string): string[] { return text.split(/[,;]/, 2); }
function captured(text: string): string[] { return text.split(/([,;])/); }

const paths = ["/home/user/project/src/index.ts", "/home/user/project/.git/HEAD", "C:\\Users\\me\\.git\\config", "relative/path", "", "/", "no-separator", "/très/loin/.git", "/日本語/のフォルダ/.git/x"];
const texts = ["Run the tests  and\treport", "", " leading and trailing ", "one", "a\nb\r\nc\rd", "x,y;z,,w", "skill:name_with-parts", "日本語 の テキスト"];
let digest = 0;
function note(pieces: string[]): void {
  digest = (digest * 31 + pieces.length) | 0;
  for (const piece of pieces) digest = (digest * 31 + piece.length + (piece.length ? piece.charCodeAt(0) : 0)) | 0;
}
const rounds = Number(process.argv[2] ?? 10);
for (let round = 0; round < rounds; round++) {
  for (const path of paths) {
    const copy = hidden(path.split("").join(""));
    digest = (digest * 31 + (isIgnored(copy) ? 1 : 0)) | 0;
    digest = (digest * 31 + (isIgnored(hidden("<" + copy + ">").slice(1, -1)) ? 1 : 0)) | 0;
  }
  for (const text of texts) {
    const copy = hidden(text.split("").join(""));
    note(words(copy)); note(parts(copy)); note(lines(copy)); note(limited(copy)); note(captured(copy));
  }
}
"a-b".split(/-/);
console.log(digest, paths.map(isIgnored).join(), JSON.stringify(words("A b  C")), JSON.stringify(parts("a:b_c-d")), JSON.stringify(captured("a,b;c")), RegExp.lastMatch, JSON.stringify(RegExp.leftContext));
//// patterns-are-recompiled-moved-and-emptied-while-they-are-used.js
// Patterns are recompiled, moved and emptied by the callbacks and conversions that run while strings are matched, replaced and split.
function show(f) { try { const v = f(); return typeof v === "object" && v ? JSON.stringify(v) : String(v); } catch (e) { return "threw " + e.constructor.name; } }
const text = "aa1bb22cc333dd4444" + "é".repeat(3) + "\u{1F600}x9";
const lines = [];
for (const flags of ["", "g", "y", "gy", "gu", "gi", "gd", "gv", "gs", "gm"]) {
    const make = () => new RegExp("(\\d+)|(?<w>[a-c])", flags);
    const scenes = {
        compileInCallback: r => text.replace(r, m => { r.compile("z", flags.replace(/[dv]/g, "")); return "<" + m + ">"; }),
        compileToGroups: r => text.replace(r, (...a) => { r.compile("(a)(b)(c)(d)?", "g"); return a.length; }),
        lastIndexInCallback: r => text.replace(r, m => { r.lastIndex = 1e9; return "#"; }) + r.lastIndex,
        lastIndexObject: r => { let n = 0; r.lastIndex = { valueOf() { n++; r.compile("b+", flags.replace(/[dv]/g, "")); return 2; } }; return JSON.stringify(r.exec(text)) + n + "," + show(() => r.lastIndex); },
        negative: r => { r.lastIndex = -5; return JSON.stringify(r.exec(text)) + r.lastIndex; },
        fraction: r => { r.lastIndex = 2.7; return JSON.stringify(r.exec(text)) + r.lastIndex; },
        inSurrogate: r => { r.lastIndex = text.indexOf("\u{1F600}") + 1; return JSON.stringify(r.exec(text)) + r.lastIndex; },
        frozen: r => { Object.freeze(r); return show(() => r.exec(text)) + show(() => text.replace(r, "x")) + show(() => r.test(text)); },
        readOnlyLastIndex: r => { Object.defineProperty(r, "lastIndex", { value: 3, writable: false }); return show(() => r.exec(text)) + show(() => text.match(r)) + show(() => text.split(r).length); },
        ownExec: r => { r.exec = function (s) { this.exec = undefined; return null; }; return show(() => text.replace(r, "x")) + show(() => r.test(text)) + show(() => text.match(r)); },
        ownExecBad: r => { r.exec = () => 5; return show(() => r.test(text)) + show(() => text.replace(r, "x")); },
        ownExecArrayLike: r => { let n = 0; r.exec = () => n++ ? null : { index: 1e9, length: 3, 0: "q", 1: { toString() { return "g1"; } }, 2: undefined, groups: { w: "W" } }; return show(() => text.replace(r, "[$1|$2|$<w>|$&]")); },
        ownFlags: r => { Object.defineProperty(r, "flags", { value: "g" }); return show(() => text.replace(r, "x")) + show(() => [...text.matchAll(r)].length); },
        ownGlobal: r => { Object.defineProperty(r, "global", { get() { return true; } }); return show(() => text.replace(r, "x")); },
        matchAllThenCompile: r => { const it = text.matchAll(r); const a = it.next(); r.compile("nothing"); return JSON.stringify([a, it.next()]); },
        splitLimit: r => JSON.stringify(text.split(r, { valueOf() { r.compile("c"); return 4; } })),
        species: r => { r.constructor = { [Symbol.species]: function (p, f) { return new RegExp("b", f); } }; return JSON.stringify(text.split(r)) + show(() => [...text.matchAll(r)].length); },
        replaceValueObject: r => text.replace(r, { toString() { r.lastIndex = 5; return "$2$1$0$9$<w>$<none>$'"; } }).length,
        subject: r => r.exec({ toString() { r.compile("dd"); return text; } }),
        legacy: r => { r.exec(text); return [RegExp.$1, RegExp.lastMatch, RegExp.leftContext.length, RegExp["$+"], RegExp.input === text].join(); },
        emptyMatches: r => { r.compile("", flags.replace(/[dv]/g, "")); return text.replace(r, "-").length + "," + show(() => text.match(r)?.length) + "," + text.split(r).length; },
        collect: r => text.replace(r, m => { Bun.gc(true); return m + m; }),
        rope: r => { let s = ""; for (let i = 0; i < 50; i++) s += text; return s.replace(r, (m, a, b, at) => at % 7 ? "" : m).length; },
        subclass: r => { class R extends RegExp { exec(s) { const m = super.exec(s); if (m) m[0] = "!"; return m; } } const x = new R(r.source, flags); return show(() => text.replace(x, "[$&]")) + show(() => text.search(x)) + show(() => x.test(text)); },
        indices: r => JSON.stringify(r.exec(text)?.indices ?? null),
        symbolOff: r => { r[Symbol.match] = false; return show(() => text.includes(r)) + show(() => text.startsWith(r)); },
        source: r => [r.source, r.flags, String(r), r.sticky, r.unicode, r.hasIndices, r.dotAll].join(),
    };
    for (const [name, scene] of Object.entries(scenes)) if (flags.includes("g") || !["ownFlags", "ownGlobal"].includes(name)) for (const warm of [false, true]) { const r = make(); if (warm) { r.test(text); text.replace(r, "x"); r.lastIndex = 0; } lines.push(flags + " " + name + " " + warm + " " + show(() => scene(r)) + " @" + show(() => r.lastIndex)); }
}
console.log(lines.join("\n"));
//// patterns-made-at-run-time-are-refused-when-they-are-made.js
// A pattern that parses but is too large to build throws from new RegExp(), not from the first match.
function tryOut(text, flags) {
  let made;
  try {
    made = new RegExp(text, flags);
  } catch (error) {
    return "refused when made: " + error.name;
  }
  try {
    return "made; test answers " + made.test("aaa");
  } catch (error) {
    return "made; refused when used: " + error.name;
  }
}
