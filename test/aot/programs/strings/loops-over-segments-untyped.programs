// `text.slice(from, to)` where `to` is a number or undefined, and the other methods of strings that take a position: each is compiled in line for both cases, and answers as in plain Bun.
// STATISTIC: InlineBuiltinGroups >= 12
const positions: (number | undefined)[] = [undefined, 0, 1, 3, 6, 7, -1, -3, -7, 1.5, NaN, Infinity, -Infinity, 2 ** 31, -(2 ** 31), 1e20];
const texts: string[] = ["a,b!c,", "", "€,€!", "a,b" + String(positions.length).slice(0, 1) + "!c,"];

////= lines-12	slice	from	number	to	string
function sliceFrom(text: string, from?: number): string {
  return text.slice(from);
}
////= lines-12	substring	from	number	to	string
////= lines-12	substr	from	number	length	string
////= lines-12	indexOf	sought	string	from	number
////= lines-12	lastIndexOf	sought	string	from	number
////= lines-12	includes	sought	string	from	boolean
////= lines-12	startsWith	sought	string	at	boolean
////= lines-12	endsWith	sought	string	end	boolean
function upToQuery(url: string, start: number): string {
  const query = url.indexOf("!", start);
  return url.slice(start, query === -1 ? undefined : query);
}

for (const text of texts) {
  const sought = text.length > 1 ? text[1] : ",";
  for (const position of positions) {
    console.log(
      JSON.stringify([
        slice(text, 1, position), sliceFrom(text, position), substring(text, 1, position), substr(text, 1, position), indexOf(text, sought, position), lastIndexOf(text, sought, position),
        includes(text, sought, position), startsWith(text, sought, position), endsWith(text, sought, position), upToQuery(text, position ?? 0),
      ]),
    );
  }
}
//// primitives-in-templates.ts
// A template converts each value as String() does but for symbols. Numbers, booleans, undefined, null and bigints in templates: alone, between texts, as keys of a Map, with calls that run between the reads.
const lines: string[] = [];
const hide = <T,>(value: T): T => new CustomEvent("x", { detail: value }).detail;

const numbers: number[] = hide([0, -0, 1, -1, 7, 10, 99, 100, 2147483647, -2147483648, 2147483648, 4294967295, 9007199254740991, 1e21, 1e-7, 0.1, 1.5, -2.25, 123456789.125, NaN, Infinity, -Infinity, 5e-324, 1.7976931348623157e308]);
type Item = { id: number; on: boolean; big: bigint; maybe?: number | null };
const items: Item[] = numbers.map((n, i) => ({ id: n, on: i % 2 === 0, big: BigInt(i) ** 9n - 5n, maybe: i % 3 === 0 ? undefined : i % 3 === 1 ? null : n }));

function pair(a: Item, b: Item, state: number): string {
  const postFix = state ? ":" + state : "";
  return `${a.id},${b.id}${postFix}`;
}
function all(a: Item): string { return `${a.id}|${a.on}|${a.big}|${a.maybe}`; }
function alone(n: number): string { return `${n}`; }
function integers(i: number, j: number): string { return `${i | 0}-${j >>> 0}-${(i * j) | 0}`; }
function joined(a: number, b: boolean): string { return String(a) + String(b) + a.toString() + b; }

let order = "";
function noted<T>(name: string, value: T): T { order += name; return value; }
function withCalls(a: Item): string { return `${noted("a", a.id)}${noted("b", a.on)}${noted("c", a.big)}`; }

const texts = { toString() { order += "!"; return "object"; } };
function withObject(n: number, o: { toString(): string }, m: number): string { return `${n}${o}${m}`; }
function withUnknown(n: number, u: unknown, m: number): string { return `${n}<${u}>${m}`; }

for (const [i, item] of items.entries()) {
  const other = items[(i * 7 + 3) % items.length]!;
  lines.push(pair(item, other, i % 4 === 0 ? i : 0), all(item), alone(item.id), integers(item.id, other.id), joined(item.id, item.on), withCalls(item), withObject(item.id, texts, other.id));
}
lines.push(order);
for (const value of hide<unknown[]>([1, "s", true, null, undefined, 3n, [1, 2], { toString() { return "own"; } }, Symbol("no"), Object.create(null)])) {
  try { lines.push(withUnknown(1, value, 2)); } catch (error) { lines.push((error as Error).constructor.name); }
}

// The same keys made again and again find what was stored under them, whichever way the text was made.
const seen = new Map<string, number>();
let found = 0;
for (let round = 0; round < 3; round++) {
  for (let i = 0; i < 2000; i++) {
    const a = items[i % items.length]!, b = items[(i * 5 + round) % items.length]!;
    const key = pair(a, b, i % 8 === 0 ? 2 : 0);
    const spelled = String(a.id) + "," + String(b.id) + (i % 8 === 0 ? ":2" : "");
    if (key !== spelled) lines.push("DIFFERENT: " + key + " " + spelled);
    if (seen.has(spelled)) found++;
    seen.set(key, i);
  }
}
lines.push(found + " " + seen.size);
console.log(lines.join("\n"));
//// read-only-last-index-sloppy.js
// A CommonJS file is sloppy: a store to a read-only lastIndex does nothing and does not throw.
function readOnly(re) {
  Object.defineProperty(re, "lastIndex", { writable: false });
  return re;
}
function attempt(store) {
  try {
    return String(store());
  } catch (error) {
    return error instanceof TypeError ? "TypeError" : "other error";
  }
}

function storeToLiteral() {
  const re = /a/g;
  Object.defineProperty(re, "lastIndex", { writable: false });
  re.lastIndex = 1;
  return re.lastIndex;
}
function storeToWritableLiteral() {
  const re = /a/g;
  re.lastIndex = 1;
  return re.lastIndex;
}
function storeToParameter(receiver, value) {
  receiver.lastIndex = value;
  return receiver.lastIndex;
}
// Class code is always strict. Plain Bun's transpiler drops a "use strict" directive inside a function, which would leave the reference run without a strict store.
class StrictCode {
  static storeToLiteralStrict = function () {
    const re = /a/g;
    Object.defineProperty(re, "lastIndex", { writable: false });
    re.lastIndex = 1;
    return re.lastIndex;
  };
  static storeToParameterStrict = function (receiver, value) {
    receiver.lastIndex = value;
    return receiver.lastIndex;
  };
}
const { storeToLiteralStrict, storeToParameterStrict } = StrictCode;

console.log("literal:", attempt(storeToLiteral));
console.log("writable literal:", attempt(storeToWritableLiteral));
console.log("literal, strict:", attempt(storeToLiteralStrict));
for (const store of [storeToParameter, storeToParameterStrict]) {
  console.log(store.name);
  console.log("  read-only:", attempt(() => store(readOnly(/a/g), 1)));
  console.log("  read-only, an object stored:", attempt(() => typeof store(readOnly(/a/y), {})));
  console.log("  writable:", attempt(() => store(/a/g, 1)));
  console.log("  frozen object:", attempt(() => store(Object.freeze({ lastIndex: 5 }), 1)));
  console.log("  ordinary object:", attempt(() => store({}, 1)));
  console.log("  number:", attempt(() => store(7, 1)));
}

const sticky = readOnly(/a/y);
sticky.lastIndex = 2;
console.log("exec after an ignored store:", attempt(() => sticky.exec("aaa").index), sticky.lastIndex);

module.exports = { storeToParameter, storeToParameterStrict };
//// regexp-assembled-patterns-cached.ts
function opening(tag: string) {
  return new RegExp("<" + tag + "(?=[\\s>])");
}
function closing(tag: string) {
  return new RegExp("</" + tag + "\\s*>", "g");
}
const patterns = [opening("alpha"), opening("beta"), opening("gamma-ray"), opening("caf\xe9"), closing("alpha"), closing("beta"), closing("gamma-ray"), closing("\u4e2d\u6587")];
const text = "<alpha x><beta></beta ><gamma-ray>text</gamma-ray></alpha><caf\xe9 ></\u4e2d\u6587>";
console.log(patterns.map(pattern => `${pattern.source} ${pattern.flags} ${text.search(pattern)}`).join("\n"));
console.log(patterns.map(pattern => text.replace(pattern, "#").length).join(), patterns.map(pattern => pattern.test("<alpha>")).join());

const wideTwin = new RegExp(("\u4e2d<" + "alpha(?=[\\s>])").slice(1), "m");
console.log(wideTwin.source === patterns[0].source, wideTwin.flags, wideTwin.test(text), text.search(wideTwin));

const unseen = String(Math.floor(Math.random() * 900000) + 100000);
const long = new RegExp("(a|" + unseen + ")" + "x".repeat(900000) + "$");
console.log(long.source.length, long.test(unseen + "x".repeat(900000)), long.test("c" + "x".repeat(900000)));
const near = [new RegExp("<alpha" + unseen + "(?=[\\s>])"), new RegExp("</" + unseen + "\\s*>", "g"), new RegExp("<" + unseen + "(?=[\\s>])")];
console.log(near.map(pattern => `${pattern.source.length} ${pattern.test(text)} ${pattern.test("<" + unseen + "></" + unseen + ">")}`).join(" "));
//// regexp-empty-groups-fixed-count.ts
const patterns = [/^(a|){3}b/, /^((a)|){3}b/, /^(?:a|){3}b/, /^(|a){3}b/, /(a|){2}/, /(a|b|){4}c/, /^(?:(a)|(b)|){3}$/, /^(a?){3}b/, /^(a*){2}b/, /^(?:a??){3}a/, /(\b){3}x/, /(?:){5}y/, /^(?:(?=a)|b){3}a/, /^((a|){2}){2}b/, /^(a|){3}\1b/, /^(?:x(a|){2}y){2}$/, /^(a|){2,4}b/, /^(a|){3,}b/, /(?:[0-9a-f]{1,4}:(?::|\b)|){5}z/, /^(?<n>a|){3}b/, /(a|){3}$/, /^(?:a|){3}?b/, /^(ab|a|){3}b/, /^(a|){3}(b|){2}c/];
const subjects = ["", "b", "ab", "aab", "aaab", "aaaab", "abc", "c", "abac", "bbbc", "aba", "ab b", "x", " x", "y", "aa", "aaa", "aaaa", "xy", "xayxaay", "xaayxy", "xaaay", "1:2:3:z", "1::2:z", "ff:ff:ff:ff:ff:z", "ff:ff:ff:ff:ff:ff:z", "z", "abab", "ababb", "abbc", "aabbc", "aaabbc", "\u4e2daab", "aab\u4e2d"];
for (const pattern of patterns) {
  const line: string[] = [];
  for (const subject of subjects) {
    const match = pattern.exec(subject);
    line.push(match ? `${JSON.stringify(match)}@${match.index}` : "-");
    if (pattern.test(subject) !== !!match) line.push("TEST DISAGREES");
  }
  console.log(String(pattern), line.join(" "));
}
console.log("aaab aab b".replace(/(a|){3}b/g, "[$1]"), "aab".split(/(a|){2}/).join("|"), [..."aabab".matchAll(/(a|){2}b/g)].map(match => match.index + ":" + match[1]).join());
