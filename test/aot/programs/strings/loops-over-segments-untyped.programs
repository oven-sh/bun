// Positions that a computation makes.
function halves(s: string, n: number): string {
    let out = "";
    for (let x = -n; x <= n; x += 0.75) out += s.substring(x, x * x) + "," + s.slice(x / 0.3, -x) + "," + s.substr(Math.sqrt(x), x + n) + ";";
    return out;
}
