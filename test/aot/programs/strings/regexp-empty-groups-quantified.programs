check("with classes 2, any case", /Content-Type: text\/[a-z]+; charset=utf-8/i, ["Content-Type: text/html; charset=utf-8", "content-type: text/html; charset=UTF-8"]);
check("with classes 3", /abcdefgh.ijklmnop.qrstuvwx/, ["abcdefgh-ijklmnop_qrstuvwx", "abcdefgh\nijklmnop.qrstuvwx"]);
check("with classes 3, any case", /abcdefgh.ijklmnop.qrstuvwx/i, ["abcdefgh-ijklmnop_qrstuvwx", "abcdefgh\nijklmnop.qrstuvwx"]);
//// regexp-literal-inline-allocation.ts
// A RegExp literal that must be a new object at every evaluation (`g`, `y`, or an object that escapes) is allocated without a call into the runtime once its pattern exists. Every evaluation still gives an object of its own: `lastIndex` 0, writable, extensible, no property of an earlier one.
// Only the jsc shell with --aotCountsPath=<path> can count: there `few calls` is false if the 30,000 evaluations enter operationAOTNewRegExpLiteral more than 1,000 times (an empty free list enters it). Elsewhere the program checks the answers alone.
const count: (name: string) => number = (globalThis as any).aotOperationCount ?? (() => 0);
const literalCalls = () => count("operationAOTNewRegExpLiteral");

function sumOfNumbers(text: string) {
  const digits = /\d+/g;
  let sum = 0;
  for (let match = digits.exec(text); match; match = digits.exec(text)) sum += Number(match[0]);
  return sum;
}
function wordLength(text: string) {
  const word = /[a-z]+/y;
  return word.test(text) ? word.lastIndex : -1;
}
function create(): RegExp {
  return /a(b)?/i;
}

const texts = ["12 and 30", "none", "7", "cab 1 2 3 4"];
const recent: RegExp[] = [];
function evaluateEach(turn: number) {
  const text = texts[turn % texts.length];
  const created = create();
  recent[turn % 8] = created;
  return sumOfNumbers(text) + wordLength(text) + (created.test(text) ? 1 : 0) + created.lastIndex;
}
let warmUp = 0;
for (let turn = 0; turn < 8; turn++) warmUp += evaluateEach(turn);
const before = literalCalls();
let total = 0;
for (let turn = 0; turn < 10000; turn++) total += evaluateEach(turn);
console.log(warmUp, total, new Set(recent).size, "few calls", literalCalls() - before < 1000);

const first = create();
const second = create();
console.log(first === second, first.source, first.flags, first.lastIndex, first instanceof RegExp, Object.getPrototypeOf(first) === RegExp.prototype);
(first as any).mine = 1;
first.lastIndex = 5;
Object.freeze(first);
const third = create();
console.log((third as any).mine, third.lastIndex, Object.isFrozen(third), Object.isExtensible(third), Object.getOwnPropertyDescriptor(third, "lastIndex")!.writable);
third.lastIndex = 3;
console.log(first.lastIndex, third.lastIndex, create().lastIndex, JSON.stringify(third.exec("xAB")), JSON.stringify(first.exec("xa")));

const held: RegExp[] = [];
for (let index = 0; index < 10000; index++) {
  const pattern = create();
  pattern.lastIndex = index;
  held.push(pattern);
  sumOfNumbers("1 22 333");
}
let intact = 0;
for (let index = 0; index < held.length; index++) {
  const pattern = held[index];
  if (pattern.lastIndex === index && pattern.source === "a(b)?" && pattern.exec("xAB")![1] === "B") intact++;
}
console.log(intact, new Set(held).size);
//// regexp-literal-last-index.js
// A RegExp literal is a new object with lastIndex 0 at each evaluation, whichever overload of the method takes it.
function testsNumber(n) { return /\d/.test(n); }
function testsNumberGlobal(n) { return /\d/g.test(n); }
function testsObjectGlobal(o) { return /\d/g.test(o); }
function execsNumber(n) { return /\d/.exec(n)[0]; }
function execsNumberGlobal(n) { return /\d/g.exec(n).index; }
function printsItself() { return /a+/gi.toString() + /a+/gi.flags + /a+/gi.source; }
function matchesBySymbol(s) { return /\d/g[Symbol.match](s).join(); }
function replacesBySymbol(s) { return /\d/g[Symbol.replace](s, "-"); }
function searchesBySymbol(s) { return /\d/g[Symbol.search](s); }
function splitsBySymbol(s) { return /\d/g[Symbol.split](s).join("|"); }
const converted = { toString() { return testsNumberGlobal(7) ? "5" : "x"; } };
for (let round = 0; round < 3; round++) {
    console.log(testsNumber(15), testsNumberGlobal(15), testsObjectGlobal(converted), execsNumber(15), execsNumberGlobal(15));
    console.log(printsItself(), matchesBySymbol("a1b2"), replacesBySymbol("a1b2"), searchesBySymbol("a1b2"), splitsBySymbol("a1b2c"));
}
//// regexp-literal-match-forms.ts
// `test`, `exec`, `search` and `match` of RegExp literals with no flag, `g`, `y`, `gy`, `u` and `d`: every kind of subject, every kind of `lastIndex`, one pattern with and without `g`, literals that get no code, and what `RegExp.$1` holds afterward.
type Found = RegExpExecArray | RegExpMatchArray | null;
type Forms = {
  literal: RegExp;
  test(s: string): boolean;
  exec(s: string): Found;
  search(s: string): number;
  match(s: string): Found;
};

const plain = /(\d)(\d)?/;
const global = /(\d)(\d)?/g;
const sticky = /(\d)(\d)?/y;
const globalSticky = /(\d)(\d)?/gy;
const unicode = /(\d)(\d)?/u;
const indices = /(\d)(\d)?/d;
const anyCodePoint = /(.)(\d)?/u;
const anyCodePointGlobal = /(.)(\d)?/gu;
const anyCodePointSticky = /(.)(\d)?/uy;
const text = /12/;
const textGlobal = /12/g;
const withoutCode = /(\d)(\d)?|x{2147483648}/;
const withoutCodeGlobal = /(\d)(\d)?|x{2147483648}/g;
const withoutCodeSticky = /(\d)(\d)?|x{2147483648}/y;

const literals: Forms[] = [
  { literal: plain, test: s => plain.test(s), exec: s => plain.exec(s), search: s => s.search(plain), match: s => s.match(plain) },
  { literal: global, test: s => global.test(s), exec: s => global.exec(s), search: s => s.search(global), match: s => s.match(global) },
  { literal: sticky, test: s => sticky.test(s), exec: s => sticky.exec(s), search: s => s.search(sticky), match: s => s.match(sticky) },
  { literal: globalSticky, test: s => globalSticky.test(s), exec: s => globalSticky.exec(s), search: s => s.search(globalSticky), match: s => s.match(globalSticky) },
  { literal: unicode, test: s => unicode.test(s), exec: s => unicode.exec(s), search: s => s.search(unicode), match: s => s.match(unicode) },
  { literal: indices, test: s => indices.test(s), exec: s => indices.exec(s), search: s => s.search(indices), match: s => s.match(indices) },
  { literal: anyCodePoint, test: s => anyCodePoint.test(s), exec: s => anyCodePoint.exec(s), search: s => s.search(anyCodePoint), match: s => s.match(anyCodePoint) },
  { literal: anyCodePointGlobal, test: s => anyCodePointGlobal.test(s), exec: s => anyCodePointGlobal.exec(s), search: s => s.search(anyCodePointGlobal), match: s => s.match(anyCodePointGlobal) },
  { literal: anyCodePointSticky, test: s => anyCodePointSticky.test(s), exec: s => anyCodePointSticky.exec(s), search: s => s.search(anyCodePointSticky), match: s => s.match(anyCodePointSticky) },
  { literal: text, test: s => text.test(s), exec: s => text.exec(s), search: s => s.search(text), match: s => s.match(text) },
  { literal: textGlobal, test: s => textGlobal.test(s), exec: s => textGlobal.exec(s), search: s => s.search(textGlobal), match: s => s.match(textGlobal) },
  { literal: withoutCode, test: s => withoutCode.test(s), exec: s => withoutCode.exec(s), search: s => s.search(withoutCode), match: s => s.match(withoutCode) },
  { literal: withoutCodeGlobal, test: s => withoutCodeGlobal.test(s), exec: s => withoutCodeGlobal.exec(s), search: s => s.search(withoutCodeGlobal), match: s => s.match(withoutCodeGlobal) },
  { literal: withoutCodeSticky, test: s => withoutCodeSticky.test(s), exec: s => withoutCodeSticky.exec(s), search: s => s.search(withoutCodeSticky), match: s => s.match(withoutCodeSticky) },
];

const narrow = "ab 12 cd 345 e6";
const wide = "中文 12 \u{1f600}3 終 45";
////= lines-10	join	left	right	string
function cut(whole: string, from: number, to: number): string {
  return whole.slice(from, to);
}
const subjects: [string, () => string][] = [
  ["flat", () => narrow],
  ["rope", () => join(cut(narrow, 0, 4), cut(narrow, 4, narrow.length))],
  ["substring", () => cut("<<<" + narrow + ">>>", 3, 3 + narrow.length)],
  ["16-bit", () => wide],
  ["16-bit rope", () => join(cut(wide, 0, 4), cut(wide, 4, wide.length))],
  ["8-bit and 16-bit rope", () => join("7 ", wide)],
  ["16-bit substring", () => cut("中<<" + wide + ">>", 3, 3 + wide.length)],
  ["no digit", () => join("no ", "digit")],
  ["one digit", () => "7"],
  ["empty", () => ""],
];

const log: string[] = [];
const lastIndexes: [string, () => unknown][] = [
  ["0", () => 0],
  ["3", () => 3],
  ["7", () => 7],
  ["-1", () => -1],
  ["1.5", () => 1.5],
  ["past the end", () => 100],
  ["2 ** 32 + 3", () => 2 ** 32 + 3],
  ["valueOf", () => ({ valueOf: () => (log.push("valueOf"), 3) })],
  ["symbol", () => Symbol.iterator],
];

function legacy(): string {
  return [RegExp.$1, RegExp.$2, RegExp.lastMatch, RegExp.leftContext.length].join("|");
}

function show(value: unknown): string {
  if (typeof value === "number") return Object.is(value, -0) ? "-0" : String(value);
  if (!Array.isArray(value)) return typeof value === "object" && value !== null ? "object" : String(value);
  const found = value as RegExpMatchArray;
  return `${JSON.stringify(found)}@${found.index}${found.indices ? JSON.stringify(found.indices) : ""}`;
}

