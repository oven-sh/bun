////: for
for (const text of [narrow, wide]) {
  for (let from = 0; from < text.length; from += 3) {
    for (const length of [0, 1, 2, 3, 7, 12, 40]) {
      lines.push(`${from}+${length} ${ask(text.substring(from, from + length))}`);
      lines.push(`${from}~${length} ${ask(text.slice(from, from + length + 2).slice(1))}`);
    }
  }
}
////: for-2
for (const first of parts) {
  for (const second of parts) {
    lines.push(`${JSON.stringify(first)} ${JSON.stringify(second)} ${ask(first + second)}`);
    lines.push(`three ${ask(first + second + first)}`);
    lines.push(`piece of both ${ask((first + narrow.substring(2, 9) + second).substring(1))}`);
  }
}
////: for-3
for (let turn = 0; turn < 2000; turn++) {
  if (/^ab+c/.test(kept)) hits++;
  if (/^ab+c/.test(narrow.substring(2 + (turn & 1), 12))) hits += 10;
  if (narrow.substring(turn & 7, 30).search(/z+a/) >= 0) hits += 100;
  if (/(z+)(a)/.exec(narrow.substring(turn & 15, 20)) !== null) hits += 1000;
}
//// regexp-empty-groups-quantified.ts
// A group that can match nothing, under ?, *, + or a count with a least and a most: a turn beyond the least count that consumes nothing is refused and the group tries its other ways; the answers are those of plain Bun.
const subjects = ["", "a", "b", "ab", "ba", "aa", "aab", "xay", "xy", "xaay", "abab", "c", "aac", "bc", "z", "aaz", "ababz", "a\nb", "aXa", "aaa", "xby", "baab", "\u4e2d", "\u4e2daab", "x\u4e2dy", "aa\u4e2d"];
function sumOf(text: string, sum: number) {
  for (let i = 0; i < text.length; i++) sum = (Math.imul(sum, 31) + text.charCodeAt(i)) | 0;
  return sum;
}
let all = 0;
function row(pattern: RegExp) {
  let sum = 7;
  let found = 0;
  for (const subject of subjects) {
    const match = pattern.exec(subject);
    if (match) found++;
    sum = sumOf(match ? JSON.stringify(match) + "@" + match.index : "null", sum);
    sum = sumOf(String(pattern.test(subject)) + JSON.stringify(subject.replace(pattern, "<$&|$1>")) + subject.search(pattern), sum);
  }
  all = (Math.imul(all, 33) + sum) | 0;
  console.log(String(pattern), found, sum);
}
