function inLoop(text: string): number {
  let hits = 0;
  for (let turn = 0; turn < 2000; turn++) {
    if (/(\d+)-x/.test(text + turn + "-x")) hits++;
    if (/^[a-z]+$/.exec(text) !== null) hits += 2;
    if ((text + turn).search(/9$/) >= 0) hits += 4;
    if ((text + turn).match(/(7)(7)/)) hits += 8;
  }
  return hits;
}
