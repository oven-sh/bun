let marks = "";
for (let k = 0;k < 300; k++)
  marks += String.fromCodePoint(8192 + k + (k >= 112 ? 256 : 0));
marks = flat(marks);
const cyrillic = flat("\u0416".repeat(400));
const astral = flat("\uD835\uDC00".repeat(320));
const snow = flat("\u2603".repeat(320));
const narrow = flat("x".repeat(320));
const late = flat("\u2603\u2603" + "\u4E2D".repeat(320));
for (const [name, re] of [["20", re20], ["100", re100], ["300", re300]]) {
  const row = [name];
  for (const s of [cyrillic, astral, snow, narrow, late, marks, marks.slice(1), flat(marks.slice(0, 150) + cyrillic), cyrillic.slice(0, 19), cyrillic.slice(0, 99), cyrillic.slice(0, 299), cyrillic.slice(0, 300)]) {
    const m = re.exec(s);
    row.push(m ? m.index + ":" + m[0].length : "no");
  }
  console.log(row.join(" "));
}
//// regexp-many-latin1-classes.ts
// Dozens of different classes of Latin-1 characters in one program, each asked about every Latin-1 character and a few beyond, in both string widths.
export { };
function hash(h: number, n: number): number { return (Math.imul(h, 31) + n) | 0; }
const classes: RegExp[] = [/[a-zA-Z_$]/, /[a-zA-Z0-9_$]/, /[a-zA-Z0-9_-]/, /[a-zA-Z0-9._~-]/, /[ \t\r\n,;]/, /[!#$%&'*+.^_`|~0-9a-zA-Z-]/, /[^a-zA-Z0-9]/, /[^ \t\r\n"'<>=]/, /[+*?()\[\]{}|^$.\\/-]/, /[aeiouAEIOU]/, /[^aeiouAEIOU\s]/, /[0-9a-fA-F:.]/, /[\xa0-\xff_a-z]/, /[^\x00-\x1f\x7f-\x9f]/, /[A-Za-z\xc0-\xd6\xd8-\xf6\xf8-\xff]/, /[\w.+-]/, /[\w\s]/, /[^\w\s]/, /[\d\s,.]/, /[<>&"']/, /[(){}\[\],;:]/, /[a-z0-9]/, /[A-Z_]/, /[b-df-hj-np-tv-z]/, /[#.:>+~\s]/, /[\x21-\x2f\x3a-\x40\x5b-\x60\x7b-\x7e]/, /[^\x46-\x49\xc6\x32-\x3b\x38-\x39\xb5]/, /[\x29\x8f-\x92\x31\x37-\x40]/, /[\xb0\x59-\x72\xc0-\xc9]/, /[^\xb5-\xb8\x2c\x2b-\x34\x42-\x43\x8b\xaa\xb2-\xb3]/, /[^\xce\x3a-\x43\xb2-\xcb\x50-\x51\x38-\x41\xd6\xb0\xbe\x9f-\xb8]/, /[\xe6-\xe7\x97-\xa0\x94-\x95\x6c\xeb\xd2]/, /[\x6c-\x75\x9e-\x9f\xda-\xdd\x69-\x72\x32\xa3-\xa6\x4a-\x4b]/, /[\x8b\xcb\xe3-\xec\xb2-\xb3\x77-\x90\x79-\x82]/, /[^\xec-\xef\x31\x65-\x68\xd2-\xeb\x30\xdb-\xf4\x6f-\x88]/, /[\x92-\x93\xd7-\xda\xcb-\xcc\x25-\x28\x7a\xbc\x9e\x57-\x58]/, /[\x5f-\x62\x84-\x87\x34\x92-\x95\xac-\xad\x43-\x46\xac-\xad\xd4-\xd7]/, /[\x81\x46\x4d\x5b-\x74\x5b\x9c-\xa5\x4e-\x4f\x68]/, /[\xa8-\xa9\xbc-\xc5\x71\xd0-\xd9\xbe-\xd7\xcd-\xe6]/, /[\xe7-\xff\xec-\xf5\x84-\x87\x86-\x89\x3a-\x3d\xc2-\xc5]/, /[\x31\x90\x3c-\x3d\xb9]/, /[\xb1\xa9\x7d-\x86]/, /[\x55-\x5e\x80\xc2-\xc3]/, /[^\x7d-\x80\x3f\x9c-\x9f\x9a-\x9d\x6f\x44\xdf-\xe0]/, /[^\x9a-\xb3\x49-\x52\x25\xa7-\xa8\x45-\x5e]/, /[\xe2-\xeb\x6c-\x85\x37-\x50]/, /[\x7d\x7b\xa8-\xb1\xe7-\xf0\x74-\x8d\x59-\x62\xef]/, /[\x86-\x9f\xed\x53-\x5c\x9e-\x9f\xdb\x27-\x28\x98-\x99\x51-\x6a\xba-\xbb]/, /[^\xd9-\xda\x7d\x58\x5a-\x5d\x52-\x53\x54-\x57\xbf-\xc8\x20-\x23\xc7-\xc8]/, /[\xc9\x83-\x9c\xe0]/, /[\x8f-\xa8\x75\xed-\xff\x85-\x88]/, /[\x35-\x4e\x48\x40\x46-\x4f\x97-\xb0\x45-\x4e\xb8-\xbb\xc8-\xc9]/, /[\xac\x25\xec-\xff\xc6\xa6-\xbf\x43-\x46\x51]/, /[\x56-\x57\xa0\xe3-\xec\x73-\x74\xab-\xae]/, /[\xdd-\xde\x95-\xae\xb5-\xbe]/, /[^\xa0\xa8\xa6-\xaf\x24-\x27\xe6\xbb\xe6\x4c\x99-\xa2]/, /[^\xae\x73-\x8c\xa4-\xad]/, /[^\xe8\xaf\x5f\x66\xe5\xa1-\xa4]/, /[^\xe2\x91-\x92\xbc-\xc5]/, /[\x53-\x6c\x66-\x69\xa2-\xab\xee-\xf1\xa1\xd2-\xdb\x62-\x6b]/, /[^\x92\x8a\x84-\x87\x70\xcb\x8d\x56-\x6f\x6d\xe6]/, /[\xc9-\xca\x44-\x45\x43-\x46\x58-\x71\x38-\x3b\x9c\xca\x49-\x62]/, /[^\x87-\x88\x8b\x7b-\x7c\x37-\x50\x7d\x76-\x7f\x95-\x98]/, /[\x82-\x83\xa4-\xad\x6b-\x74]/, /[\xe9\x3a\x63-\x64]/, /[^\x4e-\x4f\xe1\x8c-\xa5\x62-\x65\x46-\x4f\xa3-\xac\x9e-\xb7\x73\x67]/];
for (const r of classes) {
    let narrow = 0, wide = 0, runs = 0;
    for (let c = 0; c < 0x130; ++c) {
        const s = String.fromCharCode(c);
        if (c < 0x100) narrow = hash(narrow, r.test("-" + s) || r.test(s) ? c : -c);
        wide = hash(wide, r.test(s + "\u4e2d") ? c : -c);
    }
    let all = ""; for (let c = 1; c < 0x100; ++c) all += String.fromCharCode(c);
    const g = new RegExp(r.source + "+", "g");
    for (const m of all.matchAll(g)) runs = hash(runs, m.index * 256 + m[0].length);
    console.log(r.source.length, narrow, wide, runs);
}
