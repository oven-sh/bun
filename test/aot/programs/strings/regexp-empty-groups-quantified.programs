  console.log(digits.test(subject()), left());
  console.log(digits.exec(subject())?.index, left());
  console.log(subject().search(digits), left());
  console.log(subject().match(digits)?.index, left());
  console.log(codePoints.test(subject()), left());
  console.log(codePoints.exec(subject())?.index, left());
  console.log(everyDigit.test(subject()), everyDigit.lastIndex, left());
  console.log(subject().match(everyDigit)?.length, everyDigit.lastIndex, left());
  console.log(plainText.test(subject()), left());
  console.log(subject().search(plainText), left());
}
//// regexp-literals-made-at-first-read.ts
// A RegExp literal that a constant of a module holds is made by the first read of the constant. It is one object from then on: it keeps its lastIndex and its properties, and every reader finds the same one.
// TODO: the build counts 2: STATISTIC: RegExpsDeferredInVariables >= 3
const words = /[a-z]+/g;
const sticky = /ab/y;
const plain = /(\d+)-(\d+)/;
const marked = /x/;
const neverRead = /never/;
const readAtStart = /start/;

const hidden: any = (value: unknown) => value;

function nextWord(text: string): string {
  const match = words.exec(text);
  return match ? match[0] + "@" + words.lastIndex : "none@" + words.lastIndex;
}

function otherReaderOfWords(): RegExp {
  return words;
}

function stickyAt(text: string, index: number): string {
  sticky.lastIndex = index;
  return sticky.test(text) + "@" + sticky.lastIndex;
}

function parts(text: string): string {
  const match = plain.exec(text);
  return match ? match[1] + "|" + match[2] : "none";
}

function mark(): void {
  hidden(marked).note = "kept";
}

function readMark(): string {
  return String(hidden(marked).note) + " " + marked.source + " " + marked.flags;
}

console.log(readAtStart.test("the start"));
console.log(nextWord("one two three"), nextWord("one two three"), nextWord("one two three"), nextWord("one two three"), nextWord("one two three"));
console.log(otherReaderOfWords() === words, otherReaderOfWords() === otherReaderOfWords(), hidden(words) === otherReaderOfWords());
console.log(stickyAt("xxab", 2), stickyAt("xxab", 1), stickyAt("abab", 0));
console.log(parts("10-20"), parts("nothing"), "7-8 9-10".replace(plain, "$2-$1"));
console.log(readMark());
mark();
console.log(readMark());
console.log(Object.getPrototypeOf(plain) === RegExp.prototype, plain instanceof RegExp, String(plain), typeof plain);
//// regexp-literals-match-ropes.ts
// A RegExp literal that is matched where it stands meets subjects that are ropes: pieces cut out of a longer text and texts that were just put together, narrow and wide.
// test, exec, search and match answer what plain Bun answers, and lastIndex moves as it does there.
const narrow: string = JSON.parse('"xxabbbc-abc-zzabbcabcabbbbc--the quick brown fox, 12 + 345 = 357; done"');
const wide: string = JSON.parse('"\\u4e2d\\u6587 abbbc \\u03c0 12\\u5186 abc \\u7d42 345 \\u4e2dabbc"');
const parts: string[] = JSON.parse('["abb", "bbc", "c-a", "zzz", "", "1", "23 ", "\\u4e2d", "\\u03c0ab", "bc\\u5186"]');

function show(match: RegExpMatchArray | RegExpExecArray | null): string {
  return match ? `${JSON.stringify(match)}@${match.index}/${match.input!.length}` : "null";
}
function ask(s: string): string {
  const all = /ab+/g;
  const found: string[] = [];
  while (all.test(s) && found.length < 9) found.push(String(all.lastIndex));
  const sticky = /a|b/y;
  let steps = 0;
  while (sticky.test(s)) steps++;
  const walked: string[] = [];
  const walker = /(\d)(\d*)/g;
  for (let m = walker.exec(s); m !== null && walked.length < 9; m = walker.exec(s)) walked.push(`${m[1]}|${m[2]}@${m.index}:${walker.lastIndex}`);
  return [
    /^ab+c/.test(s), /b+c$/.test(s), /\d+\s/.test(s), /[一-仿]/.test(s), /^$/.test(s), /π/u.test(s), /ABB/i.test(s),
    s.search(/b+c/), s.search(/\d/), s.search(/[^\x00-\xff]/), s.search(/q(?=u)/),
    show(/(a)(b+)c/.exec(s)), show(/(?<number>\d+)/.exec(s)), show(/(z)?(\d)/.exec(s)), show(/nothing like it/.exec(s)),
    show(s.match(/(a)(b+)c/)), show(s.match(/\s(\S)/)), JSON.stringify(s.match(/b+/g)), JSON.stringify(s.match(/[^\x00-\x7f]/g)),
    found.join(), all.lastIndex, steps, sticky.lastIndex, walked.join(),
  ].join(" ");
}

const lines: string[] = [];
////= for
////= for-2
function nested(depth: number, part: string): string {
  return depth ? nested(depth - 1, part) + part + depth : part;
}
