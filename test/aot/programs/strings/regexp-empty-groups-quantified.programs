n4J8qSIPrsGBwCoe|0QjhfYh_g5zO3VhiWZ7At54nuaYFDrC1r|cwNwTkRjSgg7_j76bvUUhaP__zeA7Yb|PShYOJimNYpl2TfRzMCP|M1LR_ITi|SKrNWhSqFmun47rX|Ih4XicHmBvM62OA|GTlj9mqCaqh\-5\-d5Ifa7oQw1Qq0JKLSkY|Ayaml_h8ugQXLID|Ccsdu\-10|ONy3n7dTgFqDPzF);/;
function check(name: string, r: RegExp, all: string[]): void {
    let whole = 0, changed = 0, h = 0;
    for (const word of all) {
        for (const tail of ["", "\u4e2d"]) {
            for (const subject of [word, word.toUpperCase(), "  " + word + ";"]) {
                const m = (subject + tail).slice(0, tail === "" ? undefined : subject.length + 1).match(r);
                if (m !== null) ++whole;
                h = hash(h, m === null ? -1 : (m.index ?? 0) * 256 + m[0].length);
            }
            for (let at = 0; at < word.length; ++at) {
                const other = word.slice(0, at) + (word[at] === "q" ? "r" : "q") + word.slice(at + 1);
                const wide = word.slice(0, at) + "\u0161" + word.slice(at + 1);
                for (const subject of [other + tail, wide]) {
                    const found = r.test(subject);
                    if (found) ++changed;
                    h = hash(h, found ? at : -at - 1);
                }
            }
        }
    }
    console.log(name, whole, changed, h);
}
check("any word", anyWord, words);
check("any word, any case", anyWordAnyCase, words);
check("somewhere", somewhere, words);
check("150 characters", /XMgn30mR5A__2DhFv8QXWY5d7vItk6kf_Kg0wOz\-eXx8nxw6Av6I\-xvOfhBG26sp7NiKkhoxMwexjUoeW0pDHkXAX9bwOeuWC4Iuj6kGpk57a705wQ4rI4\-SdM7Cv4BJUKkPhriJ7dM9AbT53gBdj_/, ["XMgn30mR5A__2DhFv8QXWY5d7vItk6kf_Kg0wOz-eXx8nxw6Av6I-xvOfhBG26sp7NiKkhoxMwexjUoeW0pDHkXAX9bwOeuWC4Iuj6kGpk57a705wQ4rI4-SdM7Cv4BJUKkPhriJ7dM9AbT53gBdj_"]);
