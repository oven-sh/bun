export function lastIndexOfMasked(s, x, p) {
  return s.lastIndexOf(x, p & 31) * 100 + s.lastIndexOf(x, -(p & 31));
}
////= lines-3	startsWith1	s	x	s.startsWith
////= lines-7	startsWith2	x	p	startsWith
////= lines-3	endsWith1	s	x	s.endsWith
////= lines-7	endsWith2	x	p	endsWith
