  { pattern: /\d/, all: /\d/g, holds: code => code >= 48 && code <= 57 },
  { pattern: /[A-Z]/, all: /[A-Z]/g, holds: code => code >= 65 && code <= 90 },
  { pattern: /[a-z_]/, all: /[a-z_]/g, holds: code => (code >= 97 && code <= 122) || code === 95 },
