// A pattern that is one class of characters, over 16-bit subjects: it finds the first such character from wherever it is asked to begin, in subjects of every length, with the character at every place.
type Row = { pattern: RegExp; all: RegExp; holds: (code: number) => boolean };
const inText = (text: string) => (code: number) => text.includes(String.fromCharCode(code));
////= rows
const fillers = ["\u4e2d", "\u0100", "\u8000", "\uffff", "\u0141", "\u2261", "\u013f", "\u0180"];
const narrowFillers = ["a", " ", "5", "\x01", "\xfc", "~"];
const marks = ['"', "<", "*", "7", "Q", "_", "f", "\x03", "\x7f", "\t", " ", "a", "\x80", "\xe3", "\xe9", "\xff", "\xa0", "k", "S", "@", "\x00", "?", "\xbf", "\xc0", "\u0122", "\u013c", "\u8022", "\uff3c", "\u0400"];
let checked = 0;
const wrong: string[] = [];
function first(subject: string, holds: (code: number) => boolean, from: number) {
  for (let at = from; at < subject.length; at++) if (holds(subject.charCodeAt(at))) return at;
  return -1;
}
////= check
for (const row of rows) {
  for (const filler of narrowFillers) {
    for (let length = 1; length <= 60; length += length < 36 ? 1 : 7) {
      for (const wide of ["\u4e2d", "\u0122"]) {
        for (const at of [0, length >> 1, length - 1]) check(row, filler.repeat(at) + wide + filler.repeat(length - at - 1));
        check(row, filler.repeat(length) + "<7Q" + wide);
      }
    }
  }
  for (const filler of fillers) {
    for (let length = 0; length <= 84; length += length < 40 ? 1 : 11) {
      const plain = filler.repeat(length);
      check(row, plain);
      for (let at = 0; at < length; at += at < 36 || at > length - 19 ? 1 : 5) {
        for (const mark of marks) {
          if (!row.holds(mark.charCodeAt(0)) && (at + length) % 5) continue;
          check(row, plain.slice(0, at) + mark + plain.slice(at + 1));
        }
      }
    }
  }
}
console.log(checked, wrong.length, wrong.slice(0, 8).join("\n"));

const text = ("The <b>quick</b> brown fox & the \"lazy\" dog's tail; 12 of 345 \xe9t\xe9s\t\u4e2d\u6587 ".repeat(5) + "plain words without any of them on and on and on for a while longer than a block or two\u2261").repeat(2);
for (const row of rows) {
  const places: number[] = [];
  row.all.lastIndex = 0;
  for (const match of text.matchAll(row.all)) places.push(match.index);
  console.log(String(row.all), places.length, places.slice(0, 5).join(), places.slice(-3).join(), text.replace(row.all, "").length, text.split(row.pattern).length, JSON.stringify(text.replace(row.pattern, "[$&]").slice(0, 12)));
}
