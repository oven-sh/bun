  Bun.gc(true);
  console.log(name, first === describe(make()), describe(retained[i]) === first, sumWithCollectionInLoop(make()) === sumWithoutCollection(make()));
}
//// rope-slow-paths.js
// Reads, comparisons and searches on ropes of 3 and 70,000 pieces agree with the same operations on flat strings.
function digest(text) {
  let hash = 0;
  for (let i = 0; i < text.length; i++) hash = (hash * 31 + text.charCodeAt(i)) | 0;
  return text.length + ":" + hash;
}
function concatenate(pieces) {
  let text = "";
  for (let i = 0; i < pieces.length; i++) text += pieces[i];
  return text;
}
function threePieces(a, b, c) {
  return a + b + c;
}
function flat(text) {
  return Array.from({ length: text.length }, (_, i) => text[i]).join("");
}
function repeated(count, piece, wide) {
  const pieces = [];
  for (let i = 0; i < count; i++) pieces.push(i === wide ? "日" : piece + (i % 10));
  return pieces;
}
const manyNarrow = repeated(70000, "a", -1);
const manyWide = repeated(70000, "b", 35000);
const sources = {
  "three narrow": () => threePieces("alpha-", "beta-", "gamma"),
  "three wide": () => threePieces("alpha-", "日本-", "gamma"),
  "three with empty": () => threePieces("", "middle", ""),
  "many narrow": () => concatenate(manyNarrow),
  "many wide": () => concatenate(manyWide),
  "substring of rope": () => threePieces("prefix-", concatenate(manyWide), "-suffix").substring(3, 69990),
  "rope of substrings": () => threePieces("alpha-beta".substring(2, 7), "日本語".substring(1), "gamma".substring(0, 0)),
};
const flats = {};
for (const name in sources) flats[name] = flat(sources[name]());
function positionsOf(length) {
  if (length > 1000) return [0, length >> 1, length - 1, length, -1, NaN];
  return [0, 1, 2, length >> 1, length - 1, length, length + 1, -1, -length, NaN, 2.5, Infinity, -Infinity];
}
function readsOf(make, length) {
  const lines = [];
  for (const position of positionsOf(length)) {
    lines.push(["charCodeAt", position, make().charCodeAt(position)]);
    lines.push(["at", position, make().at(position)]);
    lines.push(["startsWith", position, make().startsWith("a", position), make().startsWith("", position)]);
    lines.push(["indexOf", position, make().indexOf("a", position), make().indexOf("5-g", position), make().indexOf("日", position), make().indexOf("", position)]);
    lines.push(["substring", position, digest(make().substring(position)), digest(make().substring(1, position)), digest(make().substring(position, position))]);
  }
  return lines.map(line => line.join(" ")).join("\n");
}
function comparisonsOf(make, other) {
  const changed = other.slice(0, -1) + "~";
  return [
    make() === other, make() !== other, make() === make(), make() === changed, make() === other + "x",
    make() < other, make() > other, make() <= other, make() < changed, changed < make(), make() < "", "" < make(), make() < make(),
    make() < other + "x", make() + "x" > other,
  ].join(" ");
}
for (const name in sources) {
  const make = sources[name];
  const other = flats[name];
  const onRope = readsOf(make, other.length);
  const onFlat = readsOf(() => other, other.length);
  console.log(name, digest(make()), onRope === onFlat ? "same reads" : "different reads");
  console.log(onRope.length > 2000 ? digest(onRope) : onRope);
  console.log(comparisonsOf(make, other));
  console.log(comparisonsOf(() => other, other));
}
const empty = () => threePieces("", "", "");
console.log(empty() === "", empty().length, empty().charCodeAt(0), empty().indexOf(""), empty().indexOf("", 5), empty().startsWith(""), empty().startsWith("", 5), empty().substring(0, 5) === "");
console.log(threePieces("a￿", "b", "") < threePieces("a\ud83d", "\ude00", ""), threePieces("ÿ", "", "x") < threePieces("Ā", "", ""));
//// ropes-and-conversions-by-stub.ts
// Ropes of two and three strings, int32 to string, letter case, decimal digits: what the string stubs answer themselves, and where they must call C++.
// Only the jsc shell can count. Elsewhere the program checks the answers alone.
const shellCount: ((name: string) => number | null) | undefined = (globalThis as any).aotOperationCount;
const counts = shellCount !== undefined && shellCount("operationAOTConcat") !== null;
function count(name: string): number {
  return counts ? shellCount!(name)! : 0;
}
function reportCalls(what: string, calls: number, low: number, high: number): void {
  const isExpected = !counts || (calls >= low && calls <= high);
  console.log(what + ": " + (isExpected ? "as expected" : calls + " calls, expected " + low + " to " + high));
}

////= lines-10	concatenateTwo	a	b	string
function concatenateThree(a: string, b: string, c: string): string {
  return a + b + c;
}
function asSubstring(text: string): string {
  return ("-" + text + "-").slice(1, -1);
}
function toLower(text: string): string {
  return text.toLowerCase();
}
function toUpper(text: string): string {
  return text.toUpperCase();
}
function integerToString(value: number): string {
  return String(value | 0);
}
function numberToString(value: number): string {
  return String(value);
}
function asNumber(text: string): number {
  return Number(text);
}
function parsed(text: string): number {
  return parseInt(text);
}
function parsedInDecimal(text: string): number {
  return parseInt(text, 10);
}
function parsedInHexadecimal(text: string): number {
  return parseInt(text, 16);
}
function parsedInRadix(text: string, radix: number): number {
  return parseInt(text, radix);
}
function show(value: number): string {
  return Object.is(value, -0) ? "-0" : String(value);
}
function codePoints(text: string): string {
  return text.length + ":" + Array.from(text, character => character.codePointAt(0)!.toString(16)).join(".");
}

const [left, right, latinLeft, wideRight, one, two, three, plain, wide, digits, wideText]: string[] = JSON.parse(
  '["left-", "right", "léft-", "r中ght", "one,", "two,", "three", "plain", "wā中", "0123456789abcdef", "中文ābcdef"]',
);
const rounds: number = JSON.parse("10000");

function checkRopes(): void {
  const operands: { create: () => string; characters: string[] }[] = [
    { create: () => "", characters: [] },
    { create: () => plain, characters: Array.from("plain") },
    { create: () => wide, characters: Array.from("wā中") },
    { create: () => concatenateTwo(left, right), characters: Array.from("left-right") },
    { create: () => concatenateTwo(latinLeft, wideRight), characters: Array.from("léft-r中ght") },
    { create: () => concatenateThree(one, two, three), characters: Array.from("one,two,three") },
    { create: () => digits.slice(3, 12), characters: Array.from("3456789ab") },
    { create: () => wideText.slice(1, 6), characters: Array.from("文ābcd") },
  ];
  let checked = 0;
  let checksum = 0;
  let wrong = "";
  function check(what: string, text: string, expected: string[]): void {
    const length = text.length;
    const characters = Array.from(text);
    let isSame = length === expected.length && characters.length === expected.length;
    for (let i = 0; isSame && i < expected.length; i++) isSame = characters[i] === expected[i];
    if (!isSame) wrong += " " + what;
    for (const character of characters) checksum = (checksum * 31 + character.charCodeAt(0)) | 0;
    checked++;
  }
  for (let i = 0; i < operands.length; i++) {
    for (let j = 0; j < operands.length; j++) {
      const a = operands[i];
      const b = operands[j];
      check(i + "+" + j, concatenateTwo(a.create(), b.create()), [...a.characters, ...b.characters]);
      for (let k = 0; k < operands.length; k++) {
        const c = operands[k];
        const expected = [...a.characters, ...b.characters, ...c.characters];
        check(i + "+" + j + "+" + k, concatenateThree(a.create(), b.create(), c.create()), expected);
      }
    }
  }
  console.log("ropes: " + checked + " checked, checksum " + checksum + ", wrong:" + (wrong || " none"));

  const nonEmpty: string[] = [left, right, latinLeft, wideRight, one, two, three, plain];
  const latest: string[] = new Array<string>(64).fill("");
  const before = count("operationAOTConcat");
  for (let i = 0; i < rounds; i++) latest[i & 63] = concatenateTwo(nonEmpty[i & 7], nonEmpty[(i + 3) & 7]);
  reportCalls("ropes of non-empty strings are allocated without C++", count("operationAOTConcat") - before, 0, 100);
  console.log("latest ropes: " + codePoints(latest[0]) + " " + codePoints(latest[63]) + " " + latest.join("").length);
}

function checkLengthLimit(): void {
  const powers: string[] = ["x"];
  for (let k = 1; k <= 30; k++) powers.push(concatenateTwo(powers[k - 1], powers[k - 1]));
  const big = powers[30];
  const half = powers[29];
  let almostBig = "";
  for (let k = 0; k < 30; k++) almostBig = concatenateTwo(almostBig, powers[k]);
  const longest = concatenateTwo(big, almostBig);
  function attempt(what: string, run: () => string): void {
    let outcome: string;
    try {
      outcome = "length " + run().length;
    } catch (error) {
      outcome = error instanceof RangeError ? "RangeError" : "another error";
    }
    console.log(what + ": " + outcome);
  }
  attempt("2^30 + 2^30", () => concatenateTwo(big, big));
  attempt("2^30 + (2^30 - 1)", () => concatenateTwo(big, almostBig));
  attempt("longest + empty", () => concatenateTwo(longest, ""));
  attempt("empty + longest", () => concatenateTwo("", longest));
  attempt("longest + 1", () => concatenateTwo(longest, "y"));
  attempt("1 + longest", () => concatenateTwo("y", longest));
  attempt("2^29 + 2^29 + 2^30", () => concatenateThree(half, half, big));
  attempt("2^30 + 2^30 + empty", () => concatenateThree(big, big, ""));
  attempt("2^30 + (2^30 - 1) + empty", () => concatenateThree(big, almostBig, ""));
  attempt("2^30 + (2^30 - 1) + 1", () => concatenateThree(big, almostBig, "y"));
  attempt("empty + empty + empty", () => concatenateThree("", "", ""));
}

function checkIntegers(): void {
  const integers: number[] = [-1, 0, 9, 10, 255, 256, 1023, 1024, 65536, 2 ** 31 - 1, -(2 ** 31)];
  for (let round = 0; round < 2; round++)
    console.log("integers: " + integers.map(value => integerToString(value) + " " + numberToString(value)).join(", "));

  const repeated: number = JSON.parse("65536");
  let total = 0;
  const before = count("operationAOTIntToString");
  for (let i = 0; i < rounds; i++) total += integerToString(repeated).length;
  reportCalls("an integer converted before comes from the cache", count("operationAOTIntToString") - before, 0, 100);
  console.log("digits written: " + total);
}

function checkLetterCase(): void {
  const [lowerBase, mixedBase, upperBase]: string[] = JSON.parse('["--lowercase--", "--LowerCase--", "--UPPERCASE--"]');
  const texts: string[] = ["abc", "ABC", "aBc", "straße", "İ", "", "@[`{\u007f", "àÿµ", wideText.slice(3, 8)];
  for (const base of [lowerBase, mixedBase, upperBase]) texts.push(base.slice(2, 11), base.slice(2, 5));
  for (const text of texts) console.log(codePoints(text) + " | " + codePoints(toLower(text)) + " | " + codePoints(toUpper(text)));

  const toLowerPairs: string[][] = [["A", "a"], ["Z", "z"], ["@", "@"], ["[", "["], ["À", "à"]];
  const toUpperPairs: string[][] = [["a", "A"], ["z", "Z"], ["`", "`"], ["{", "{"], ["à", "À"]];
  let wrong = 0;
  for (let length = 1; length <= 17; length++) {
    for (let at = 0; at < length; at++) {
      for (const [from, to] of toLowerPairs) {
        const head = "a".repeat(at);
        const tail = "a".repeat(length - at - 1);
        if (toLower(asSubstring(head + from + tail)) !== head + to + tail) wrong++;
      }
      for (const [from, to] of toUpperPairs) {
        const head = "A".repeat(at);
        const tail = "A".repeat(length - at - 1);
        if (toUpper(asSubstring(head + from + tail)) !== head + to + tail) wrong++;
      }
    }
  }
  console.log("one other character at every position of 1 to 17: " + wrong + " wrong");

  const operation = "operationAOTStringToLowerCase";
  const flat: string = JSON.parse('"already lower case, 0123456789"');
  const substring = asSubstring(flat);
  let total = 0;
  let before = count(operation);
  for (let i = 0; i < rounds; i++) total += toLower(flat).length + toLower(substring).length;
  reportCalls("a lower-case string is its own lower case without C++", count(operation) - before, 0, 0);

  const mixed = "aBc".repeat(100);
  before = count(operation);
  for (let i = 0; i < 100; i++) total += toLower(mixed.slice(3 * i, 3 * i + 3)) === "abc" ? 1 : 0;
  reportCalls("each new mixed-case string is converted by C++", count(operation) - before, 100, 100);

  const repeatedText = mixed.slice(0, 3);
  before = count(operation);
  for (let i = 0; i < rounds; i++) total += toLower(repeatedText) === "abc" ? 1 : 0;
  reportCalls("a mixed-case string converted before comes from the cache", count(operation) - before, 1, 100);
  console.log("letter case total: " + total);
}

function checkDigits(): void {
  const numerals: string[] = ["0", "007", "9".repeat(15), "9".repeat(16), "1e3", " 1", "-1", "", "1/", "1:"];
  const radixes: number[] = [0, 10, 16];
  for (const numeral of numerals) {
    for (const text of [numeral, asSubstring(numeral)]) {
      const values = [asNumber(text), parsed(text), parsedInDecimal(text), parsedInHexadecimal(text)];
      for (const radix of radixes) values.push(parsedInRadix(text, radix));
      console.log(JSON.stringify(text) + ": " + values.map(show).join(" "));
    }
  }
}

checkRopes();
checkLengthLimit();
checkIntegers();
checkLetterCase();
checkDigits();
//// ropes-appended-to-a-text-that-grows.ts
// `text += rope`: a string that was joined and never read is still a rope when it is appended. Ropes of two and three pieces, of every length round the widths in which characters are copied,
// with pieces that are ropes or pieces of other strings themselves, with 16-bit pieces, into an empty text and into one that is nearly full, and the same rope again and again.
const lines: string[] = [];
const hide = <T,>(value: T): T => new CustomEvent("x", { detail: value }).detail;
const letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789".repeat(40);
const flat = (length: number, from = 0): string => hide(Buffer.from(letters.slice(from, from + length)).toString("latin1"));
const join2 = (a: string, b: string): string => hide(a) + hide(b);
const join3 = (a: string, b: string, c: string): string => hide(a) + hide(b) + hide(c);
function checksum(text: string): string {
  let sum = 0;
  for (let i = 0; i < text.length; i++) sum = (sum * 31 + text.charCodeAt(i)) | 0;
  return text.length + ":" + (sum >>> 0).toString(36);
}
function appended(start: string, pieces: string[]): string {
  let text = start;
  for (const piece of pieces) text += piece;
  return text;
}
function framed(id: number, title: string, price: number): string {
  let text = "";
  for (let i = 0; i < 3; i++) text += `${id},${title},${price}\n`;
  return text;
}

const lengths = [1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 18, 31, 32, 33, 47, 48, 49, 63, 64, 65, 100, 127, 128, 129, 255, 256, 257, 600];
for (const a of lengths) {
  for (const b of [1, 2, 7, 8, 16, 17, 33, 200]) {
    const two = join2(flat(a), flat(b, 5));
    const three = join3(flat(b, 9), flat(a, 3), flat(1 + (a + b) % 19, 11));
    lines.push(`${a} ${b} ${checksum(appended("<", [two, ">"]))} ${checksum(appended("<", [three, two, three]))} ${checksum(appended("", [two, three]))} ${checksum(framed(a, two, b))}`);
    if (appended("<", [two, three]) !== "<" + letters.slice(0, a) + letters.slice(5, 5 + b) + letters.slice(9, 9 + b) + letters.slice(3, 3 + a) + letters.slice(11, 12 + (a + b) % 19)) lines.push("WRONG TEXT " + a + " " + b);
  }
}

// Pieces that are no flat 8-bit strings.
const nested = join2(join2(flat(3), flat(4, 1)), join3(flat(2, 2), join2(flat(5, 3), flat(1, 4)), flat(6, 5)));
const deep = [1, 2, 3, 4, 5, 6, 7, 8, 9].reduce((text, n) => join2(text, flat(n, n)), flat(2));
const pieceOfFlat = join2(hide(flat(40)).slice(3, 21), hide(flat(40, 7)).substring(30));
const wide = join2(flat(4), hide("Жя"));
const wideFirst = join3(hide("日本"), flat(9), flat(2));
const narrowTextInWideString = join2(hide("Жabcdefgh").slice(1), flat(3));
const single = join3(hide("x"), hide("y"), hide("z"));
for (const [name, rope] of Object.entries({ nested, deep, pieceOfFlat, wide, wideFirst, narrowTextInWideString, single })) {
  lines.push(`${name} ${appended("[", [rope, "]"])} ${appended("", [rope])} ${appended("[", [rope, rope, rope])} ${checksum(framed(1, rope, 2))}`);
}

// The rope is still what it was, and may be read afterwards.
const kept = join2(flat(12), flat(5, 20));
const before = appended("a", [kept, kept]);
lines.push(before, kept, String(kept.length), kept.charAt(13), appended("b", [kept]), String(kept === letters.slice(0, 12) + letters.slice(20, 25)));

// A text that grows past every capacity while ropes are appended.
let long = "start";
const unit = join3(flat(13), flat(21, 1), flat(8, 2));
for (let i = 0; i < 3000; i++) long += i % 7 === 0 ? join2(flat(1 + (i % 29)), flat(1 + (i % 13), 3)) : unit;
lines.push(checksum(long));

// Many times over the same objects, as a server does for each request.
type Product = { id: number; title: string; priceCents: number };
const products: Product[] = [];
for (let i = 0; i < 40; i++) products.push({ id: i + 1, title: join2("Product ", String(i + 1)), priceCents: 100 + i * 7 });
let total = 0;
const turns = Number(process.argv[2] ?? 200);
let last = "";
for (let turn = 0; turn < turns; turn++) {
  let text = "id,title,priceCents\n";
  for (const product of products) text += `${product.id},${product.title},${product.priceCents}\n`;
  total += text.length;
  last = text;
}
lines.push(String(total), checksum(last), last.slice(0, 60));
console.log(lines.join("\n"));
//// ropes-as-subjects-of-literals.ts
// Literals matched against subjects that are ropes: concatenations and pieces of other strings, of 8 and of 16 bits, that match and that do not; with the flags g and y, whose lastIndex counts;
// with groups; and what RegExp keeps of the last match.
const lines: string[] = [];
const hide = <T,>(value: T): T => new CustomEvent("x", { detail: value }).detail as T;
const invalid = /[^\t\x20-\x7e\x80-\xff]/, token = /^[\^_`a-zA-Z\-0-9!#$%&'*+.|~]+$/, pair = /(\w+)=(\w*)/, every = /a+/g, sticky = /b+/y, named = /(?<key>[a-z]+):(?<value>\d+)/, wide = /[α-ω]+/u;
const heads: string[] = hide(["text/", "key", "aa", "bbb", "x\u0001", "αβ", "", "name:"]), tails: string[] = hide(["plain; charset=utf-8", "=value", "baab", "bcb", "y", "γδ z", "", "42 more"]);
const long: string = hide("0123456789 key=value aaa bbb name:7 αβγ and a long tail so that a piece of it stays a piece");
function show(value: unknown): string { return value === null ? "null" : JSON.stringify(value); }
function all(subject: () => string, label: string) {
  const row: string[] = [];
  row.push(show(invalid.exec(subject()) !== null), show(invalid.test(subject())), show(token.test(subject())), show(token.exec(subject())));
  const m = pair.exec(subject()); row.push(show(m && [m.index, m.input.length, ...m]), show(RegExp.$1), show(RegExp.lastMatch));
  every.lastIndex = 0; row.push(show(every.exec(subject())), String(every.lastIndex), show(every.exec(subject())), String(every.lastIndex), show(every.test(subject())), String(every.lastIndex));
  sticky.lastIndex = 0; row.push(show(sticky.test(subject())), String(sticky.lastIndex), show(sticky.exec(subject())), String(sticky.lastIndex));
  sticky.lastIndex = 2; row.push(show(sticky.exec(subject())), String(sticky.lastIndex));
  const n = named.exec(subject()); row.push(show(n && n.groups && [n.groups.key, n.groups.value]), show(wide.exec(subject())), show(wide.test(subject())));
  row.push(String(subject().search(pair)), show(subject().match(pair)), show(subject().match(every)));
  lines.push(label + ": " + row.join(" "));
}
for (let i = 0; i < heads.length; i++)
  for (let j = 0; j < tails.length; j++) all(() => heads[i]! + tails[j]!, "joined " + i + " " + j);
for (let from = 0; from < 60; from += 7) all(() => long.slice(from, from + 30), "piece " + from);
for (let i = 0; i < heads.length; i++) all(() => heads[i]! + long.slice(8, 40) + tails[i]!, "three " + i);

let count = 0;
const which = Number(process.argv[2] ?? -1), rounds = Number(process.argv[3] ?? 0);
const type: string = hide("text/html"), charset: string = hide("; charset=utf-8");
for (let i = 0; i < rounds; i++) {
  switch (which) {
  case 0: if (invalid.exec(type + charset) !== null) count++; break;
  case 1: if (invalid.test(type + charset)) count++; break;
  case 2: if (token.test(type + charset)) count++; break;
  case 3: { const m = pair.exec(type + charset); if (m) count += m[1]!.length; break; }
  case 4: if ((type + charset).length) count++; break;
  case 5: if (invalid.test(long.slice(3, 40))) count++; break;
  }
}
lines.push("count " + count);
console.log(lines.join("\n"));
//// runs-of-a-character-class-replaced.ts
// s.replace(/[class]+/g, "constant"): global patterns that are one character class, repeated or not, alone and in chains. Each is checked against a loop that walks the string with a predicate, and RegExp's legacy static properties against the same pattern given to replace through a variable that is used twice. Patterns that are not of that form stand beside them.
const report: string[] = [];
let wrong = 0;
const legacy = RegExp as unknown as Record<string, string>;
function left(): string {
  return [legacy.lastMatch, legacy.input, legacy.leftContext, legacy.rightContext].join("│");
}
function byHand(text: string, isMember: (code: number) => boolean, inserted: string, joinsRuns: boolean): string {
  let out = "";
  let wasMember = false;
  for (let i = 0; i < text.length; i++) {
    const member = isMember(text.charCodeAt(i));
    if (!member) out += text[i];
    else if (!joinsRuns || !wasMember) out += inserted;
    wasMember = member;
  }
  return out;
}
const isHex = (c: number) => (c >= 48 && c <= 57) || (c >= 97 && c <= 102);
const isBlank = (c: number) => (c >= 9 && c <= 13) || c === 32 || c === 160 || c === 0xfeff || c === 0x2003;
const isWordly = (c: number) => (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || c === 95 || (c >= 97 && c <= 122);
const isVowel = (c: number) => "aeiou".includes(String.fromCharCode(c));

const hexRuns = /[0-9a-f]+/g;
const cases: [string, (text: string) => string, (text: string) => string][] = [
  ["hex runs", text => text.replace(hexRuns, "H"), text => byHand(text, isHex, "H", true)],
  ["blank runs", text => text.replace(/\s+/g, "·"), text => byHand(text, isBlank, "·", true)],
  ["each blank", text => text.replace(/\s/g, ""), text => byHand(text, isBlank, "", false)],
  ["not wordly", text => text.replace(/\W+/g, "_"), text => byHand(text, c => !isWordly(c), "_", true)],
  ["wordly", text => text.replace(/\w+/g, "word"), text => byHand(text, isWordly, "word", true)],
  ["vowels", text => text.replace(/[aeiou]/g, "()"), text => byHand(text, isVowel, "()", false)],
  ["not vowels", text => text.replace(/[^aeiou]+/g, "-"), text => byHand(text, c => !isVowel(c), "-", true)],
  ["one letter", text => text.replace(/l+/g, "L"), text => byHand(text, c => c === 108, "L", true)],
  ["all but line ends", text => text.replace(/.+/g, "line"), text => byHand(text, c => c !== 10 && c !== 13 && c !== 0x2028 && c !== 0x2029, "line", true)],
  ["then another", text => text.replace(/[0-9a-f]+/g, "<H>").replace(/\s+/g, "<S>"), text => byHand(byHand(text, isHex, "<H>", true), isBlank, "<S>", true)],
  ["a gap ahead of runs", text => text.replace(/l/g, "").replace(/o+/g, "0"), text => byHand(byHand(text, c => c === 108, "", false), c => c === 111, "0", true)],
  ["classes that overlap", text => text.replace(/[a-h]+/g, "{1}").replace(/[e-p]+/g, "{2}").replace(/\d/g, "n"), text => byHand(byHand(byHand(text, c => c >= 97 && c <= 104, "{1}", true), c => c >= 101 && c <= 112, "{2}", true), c => c >= 48 && c <= 57, "n", false)],
];
const texts = ["", "plain", "f", "cafe babe 2026", "hello  world\t\tfolloow\n\nlines  ", "A1-b2_C3 d4!", "olé   olé 99", "世界 12 ab   cd", "e".repeat(75) + "X" + "7".repeat(75), "lollol oollo"];
for (let turn = 0; turn < 3; turn++)
  for (const [name, replaced, expected] of cases)
