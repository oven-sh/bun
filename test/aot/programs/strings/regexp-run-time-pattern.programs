const samples: string[] = ["a", "Z", "9", "_", "$", " ", "-", "\u03a9", "\u03c9", "\u0416", "\u4e2d", "\u0661", "\u0301", "\ud835\udc00", "\ud83d\ude00", "\ud835", "\u203f", "\uff21"];
console.log(long.source.length);
for (let k = 0; k < 620; k += 7) {
    const head = "k" + String(k).padStart(3, "0");
    let h = 0, found = 0;
    for (const a of samples) {
        for (const b of samples) {
            for (const subject of [head + a + ";", head + a + b + ";", head + a + a + b + ";", head + a + b]) {
                const is = long.test(subject);
                if (is) ++found;
                h = hash(h, is ? 1 : 2);
            }
        }
    }
    console.log(head, found, h);
}
//// regexp-word-boundaries-known-chars.ts
// Word boundaries next to terms whose characters are all word characters or all other characters, next to look-alikes where that is not known.
export { };
////= escape
const narrow: string[] = ["", "foo", "foo bar", "xfoo", "foox", "xfoox", " foo ", "-foo-", "a", "-", "a-", "-a", "a-a", "-a-", "ab", "a b", "ab-cd", "abcd-", "c-ab", "if", "elsewhere", "for-", "-x ", "x", "xy", "y", "-y", "y-", "y-z", "yx-", "aab", "aa-", "--a", "aa--", "aaa", "ac", "bc-", "-c", "ca", "c-", "+c-d", "a+c", "ab ", "-+a", "a1_", "12 34", "a-a", "barfoobar", "foobar", "k", "s", "K", "S", "k ", " s"];
const wide: string[] = ["\u212a", "\u017f", "a\u212a", "\u212aa", "\u017f ", " \u017f", "foo\u4e2d", "\u4e2dfoo", "\u4e2d", "a\u4e2d-", "\u00e9a", "a\u00e9", "\ud835\udc00a", "a\ud835\udc00", "k\u212a", "s\u017f-"];
function show(r: RegExp): void {
    const parts: string[] = [];
    for (const subject of narrow.concat(narrow.map((s: string): string => s + " \u0100"), wide)) {
        r.lastIndex = 0;
        const m = subject.match(r);
        parts.push(m === null ? "-" : (m.index === undefined ? "" : m.index + ":") + m.map((c: string | undefined): string => c === undefined ? "~" : "<" + escape(c) + ">").join(""));
    }
    console.log(String(r), parts.join(" "));
}
