  "\u4E05",
  "\u4E06",
  "\u4E7E",
  "\u4E80",
  "\u4E82",
  "\u4E83",
  "\u4E61",
  "\u0161",
  "\u0100",
  "\u017F",
  "\u2061",
  "\uFF41"
];
const subjects = [];
for (const p of pieces)
  for (const tail of ["x", "y", "q", "bc", "99x", "g", ":", "!", "#", "@", "zz", "c"]) {
    subjects.push(p + tail);
