const others = [/[acegi]x/, /[a-cx-z]q/, /[a-f]x/i, /[0-9a-f]{2}:/, /[aeiou][aeiou]!/, /(?:a|c|e)q/, /[\x41\xc3\x45]y/, /ab/, /a|b/, /[ab]x/];
const pieces = [
  "",
