////: Counting
class Counting extends RegExp {
  calls = 0;
  exec(«1»: string): RegExpExecArray | null {
    this.calls++;
    return super.exec(«1»);
  }
}
////: attempt
function attempt(f) {
  try {
    return show(f());
  } catch (e) {
    return "throws " + e.name;
  }
}
////: attempt-2
function attempt(f: () => unknown): string {
    try {
        return show(f());
    } catch (e) {
        return "throws " + (e as Error).name;
    }
}
////: attempt-3
function attempt(label: string, run: () => string): void {
  log.length = 0;
  let outcome: string;
  try {
    const «1» = run();
    outcome = «2»;
  } catch (error) {
    outcome = (error as Error).name + ": " + (error as Error).message;
  }
  console.log(label, outcome, log.join(«3»));
}
