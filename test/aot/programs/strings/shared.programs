////: cat
function cat(a, b) {
  return a + b;
}
////: cat3
function cat3(a, b, c) {
  return `${a}${b}${c}`;
}
////: doubled
function doubled(times: number): string {
  let text = "x";
  for (let i = 0; i < times; i++) text = text + text;
  return text;
}
////: escape
function escape(s: string): string {
    let out = "";
    for (let i = 0; i < s.length; ++i) { const c = s.charCodeAt(i); out += c >= 0x20 && c < 0x7f ? s[i] : "\\u" + c.toString(16).padStart(4, "0"); }
    return out;
}
////: flattened
function flattened(s) {
  s.charCodeAt(0);
  return s;
}
////: hash
function hash(text: string): number {
  let h = 2166136261;
  for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 16777619);
  return h >>> 0;
}
