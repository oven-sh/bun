function digest(): string {
  let hash = 0;
  for (const s of seen) for (let i = 0; i < s.length; i++) hash = (Math.imul(hash, 31) + s.charCodeAt(i)) | 0;
  return seen.length + "/" + new Set(seen).size + "/" + hash;
}
function use(group: () => void): string {
  group();
  const result = digest();
  seen = [];
  collect();
  return result;
}
for (let round = 0; round < 3; round++) console.log("round", round, use(ascii), use(latin1), use(wide), use(surrogates));
ascii(); latin1(); wide(); surrogates();
console.log("all", digest());
seen = [];

type Mode = "read-only mode" | "read-write mode" | "mode é" | "モード three" | "mode \ud800" | "a mode whose name is longer than the sixty-four characters that fit in a small buffer";
class Setting { constructor(public mode: Mode) {} }
function rank(mode: Mode): number {
  switch (mode) {
    case "read-only mode": return 1;
    case "read-write mode": return 2;
    case "mode é": return 3;
    case "モード three": return 4;
    case "mode \ud800": return 5;
    case "a mode whose name is longer than the sixty-four characters that fit in a small buffer": return 6;
    default: return 0;
  }
}
function same(a: Mode, b: Mode): boolean { return a === b; }
// A string that is no member is refused at the cast. Plain Bun lets it through, and then it ranks 0 and is the same as no member. Both give the same answer here.
function rankOfText(text: string): number { try { return rank(text as Mode); } catch { return 0; } }
function isMember(text: string, mode: Mode): boolean {
  try {
    const built = text as Mode;
    return same(built, mode) || same(mode, built) || new Setting(built).mode === mode;
  } catch {
    return false;
  }
}
const modes: Mode[] = ["read-only mode", "read-write mode", "mode é", "モード three", "mode \ud800", "a mode whose name is longer than the sixty-four characters that fit in a small buffer"];

const flat = (s: string): string => s.split("").join("");
const rope = (s: string): string => flat(s.slice(0, 3)) + flat(s.slice(3));
const substring = (s: string): string => flat("<<" + s + ">>").slice(2, -2);
