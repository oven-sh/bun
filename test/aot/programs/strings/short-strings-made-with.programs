measure("one space", () => text.split(/\s/));
measure("a character", () => text.split(/,/));
measure("a class", () => text.split(/[,;]+/));
measure("a negated class", () => text.split(/[^a-z]+/));
measure("a limit", () => text.split(/\s+/, 2));
measure("two terms", () => text.split(/,\s*/));
measure("a group", () => text.split(/(\s+)/));
measure("a flag", () => text.split(/\s+/u));
measure("may be empty", () => text.split(/\s*/));
measure("a string", () => text.split(" "));
function wordsOf(words: string): string[] {
  return words.split(/\s+/).filter(word => word !== "");
}
function firstWords(words: string, most: number): string {
  return wordsOf(words).slice(0, most).join(" ");
}
function lastWord(words: string): string {
  return words.split(/\s+/).at(-1)!;
}
measure("the same call in three places", () => [firstWords(text, 2), lastWord(text), ...wordsOf(text)]);
//// split-prefix-forms.ts
function show(...parts: (string | number | undefined)[]): string {
  return JSON.stringify(parts.map(part => (part === undefined ? "<undefined>" : part)));
}

function commaThree(s: string): string { const [a, b, c] = s.split(","); return show(a, b, c); }
function commaFirst(s: string): string { return show(s.split(",")[0]); }
function commaLength(s: string): string { return show(s.split(",").length); }
function commaSecondAndLength(s: string): string { const parts = s.split(","); return show(parts[1], parts.length); }

function spacedThree(s: string): string { const [a, b, c] = s.split(", "); return show(a, b, c); }
function spacedFirst(s: string): string { return show(s.split(", ")[0]); }
function spacedLength(s: string): string { return show(s.split(", ").length); }
function spacedSecondAndLength(s: string): string { const parts = s.split(", "); return show(parts[1], parts.length); }

function longThree(s: string): string { const [a, b, c] = s.split("<<--separator-->>"); return show(a, b, c); }
function longFirst(s: string): string { return show(s.split("<<--separator-->>")[0]); }
function longLength(s: string): string { return show(s.split("<<--separator-->>").length); }
function longSecondAndLength(s: string): string { const parts = s.split("<<--separator-->>"); return show(parts[1], parts.length); }

function accentThree(s: string): string { const [a, b, c] = s.split("é"); return show(a, b, c); }
function accentFirst(s: string): string { return show(s.split("é")[0]); }
function accentLength(s: string): string { return show(s.split("é").length); }
function accentSecondAndLength(s: string): string { const parts = s.split("é"); return show(parts[1], parts.length); }

function emptyThree(s: string): string { const [a, b, c] = s.split(""); return show(a, b, c); }
function emptyFirst(s: string): string { return show(s.split("")[0]); }
function emptyLength(s: string): string { return show(s.split("").length); }
function emptySecondAndLength(s: string): string { const parts = s.split(""); return show(parts[1], parts.length); }

function parameterThree(s: string, x: string): string { const [a, b, c] = s.split(x); return show(a, b, c); }
function parameterFirst(s: string, x: string): string { return show(s.split(x)[0]); }
function parameterLength(s: string, x: string): string { return show(s.split(x).length); }
function parameterSecondAndLength(s: string, x: string): string { const parts = s.split(x); return show(parts[1], parts.length); }

function overlappingThree(s: string): string { const [a, b, c] = s.split("aa"); return show(a, b, c); }
function overlappingLength(s: string): string { return show(s.split("aa").length); }

function escaped(s: string, x: string): string[] { return s.split(x); }
function lastByAt(s: string): string { const parts = s.split(","); return show(parts.at(-1)); }
function iterated(s: string): string {
  let out = "";
  for (const part of s.split(",")) out += "[" + part + "]";
  return out;
}
function limited(s: string): string { const parts = s.split(",", 2); return show(parts[0], parts[1], parts[2], parts.length); }

const forms: [string, ((s: string) => string)[]][] = [
  [",", [commaThree, commaFirst, commaLength, commaSecondAndLength]],
  [", ", [spacedThree, spacedFirst, spacedLength, spacedSecondAndLength]],
  ["<<--separator-->>", [longThree, longFirst, longLength, longSecondAndLength]],
  ["é", [accentThree, accentFirst, accentLength, accentSecondAndLength]],
  ["", [emptyThree, emptyFirst, emptyLength, emptySecondAndLength]],
];

function subjectsFor(x: string): string[] {
  const joined = (count: number): string => {
    let text = "p0";
    for (let i = 1; i <= count; i++) text += x + "p" + i;
    return text;
  };
  const exact = joined(3);
  return [
    "",
    "nothing here",
    joined(2),
    exact,
    joined(6),
    joined(3) + x,
    x + joined(1),
    x,
    x + x,
    joined(2) + x + String(exact.length),
    ("<<" + exact + ">>").slice(2, -2),
    exact.substring(1),
    "日本" + x + "語" + x + "文" + x + "字",
    ("日本" + x + "語" + x + "文").slice(1),
  ];
}

for (const [x, group] of forms) {
  for (const subject of subjectsFor(x)) {
    const answers = group.map(form => form(subject));
    const byParameter = [parameterThree(subject, x), parameterFirst(subject, x), parameterLength(subject, x), parameterSecondAndLength(subject, x)];
    console.log(JSON.stringify(x), JSON.stringify(subject), answers.join(" "), byParameter.join(" "));
    console.log(JSON.stringify(escaped(subject, x)), lastByAt(subject), iterated(subject), limited(subject));
  }
}

for (const subject of ["aaa", "aaaa", "aaaaa", "baab", "a", ""]) {
  console.log(JSON.stringify(subject), overlappingThree(subject), overlappingLength(subject), parameterThree(subject, "aa"), JSON.stringify(escaped(subject, "aa")));
}

export {};
//// split-results-beside-arrays-that-are-filled.ts
// A result of split() that is never made stands beside an array whose first capacity the compiler takes from the length of another array.
let guard = 0;
function filledByLength(line: string): string {
  if (guard > 1e9) return filledByLength(line + "x");
  const cols = line.split(",");
  const out: number[] = [];
  for (let i = 0; i < cols.length; i++) out.push(i * 2);
  return out.join("+") + "|" + cols[0] + "|" + cols[1];
}
function storedByLength(line: string): string {
  if (guard > 1e9) return storedByLength(line + "x");
  const cols = line.split(";");
  const out: string[] = [];
  for (let i = 0; i < cols.length; i++) out[i] = "<" + i + ">";
  return out.join("") + cols.length;
}
function spreadBeside(line: string, more: string[]): string {
  if (guard > 1e9) return spreadBeside(line + "x", more);
  const cols = line.split(",");
  const out = [cols[0], ...more, cols[1]];
  return out.join("/") + cols.length;
}
let out = "";
for (const line of ["", "a", "a,b", "1,2,3,4,5,6,7,8,9", ";;", "x;y,z"]) out += [filledByLength(line), storedByLength(line), spreadBeside(line, ["m", "n"])].join(" # ") + "\n";
guard += out.length > 1e12 ? 1 : 0;
console.log(out);
export {};
//// split-whose-list-is-never-built.ts
// `text.split(separator)` where only the length or the first pieces are read, with separators of one character and of more, in Latin-1 and UTF-16 strings, ropes and substrings.
const parsed: any = JSON.parse('{"texts":["","a",",","a,b",",a,",",,","a,,b","aXbXc","é,é","ééé","中,文","中文中","😀,😀","a\ud83db","ab,ab,ab","aaaa"],"separators":[",","a","X","é","中","\ud83d","\ude00","ab","aa",",,","","文中","Ā"]}');
function count(text: string, separator: string): number { return text.split(separator).length; }
function first(text: string, separator: string): string | undefined { return text.split(separator)[0]; }
function second(text: string, separator: string): string | undefined { return text.split(separator)[1]; }
function firstThree(text: string, separator: string): string { const [a, b, c] = text.split(separator); return a + "|" + b + "|" + c; }
function whole(text: string, separator: string): string { return JSON.stringify(text.split(separator)); }
const texts: string[] = parsed.texts.slice();
for (const text of parsed.texts as string[]) {
  texts.push(text + "," + text + parsed.texts[3], ("__" + text + "__").slice(2, -2), (text + text + text + text + "0123456789").repeat(2));
}
const lines: string[] = [];
for (let round = 0; round < 40; round++) {
  for (const text of texts) {
    for (const separator of parsed.separators as string[]) {
      const line = count(text, separator) + " " + JSON.stringify([first(text, separator), second(text, separator), firstThree(text, separator)]);
      if (!round) lines.push(line + " " + (JSON.parse(whole(text, separator)).length === count(text, separator)));
    }
  }
}
console.log(lines.join("\n"));
//// starts-and-ends-with-texts-known-only-at-run-time.ts
// startsWith and endsWith where neither string is known to the compiler: sought texts of every length from none to longer than two machine words, at every position,
// that differ in their first, last or a middle character or not at all; characters of 8 and of 16 bits on either side; ropes on either side; positions that are no integers.

const lines: string[] = [];
const hide = <T,>(value: T): T => new CustomEvent("x", { detail: value }).detail as T;
const letters = "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";

function starts(text: string, sought: string, at?: number): boolean { return at === undefined ? text.startsWith(sought) : text.startsWith(sought, at); }
function ends(text: string, sought: string, at?: number): boolean { return at === undefined ? text.endsWith(sought) : text.endsWith(sought, at); }

function changed(text: string, index: number): string { return text.slice(0, index) + "#" + text.slice(index + 1); }
function flat(text: string): string { return hide(JSON.parse(JSON.stringify(text)) as string); }

let yes = 0, no = 0, sum = 0;
function count(answer: boolean, weight: number) { if (answer) { yes++; sum = (sum * 31 + weight) % 1000003; } else no++; }

const subject = flat(letters);
for (let length = 0; length <= 24; length++) {
  for (let from = 0; from + length <= 40; from += 3) {
    const piece = flat(subject.slice(from, from + length));
    for (let at = 0; at <= 44; at++) {
      count(starts(subject, piece, at), at * 100 + length);
      count(ends(subject, piece, at), at * 100 + length + 50);
    }
    for (const index of [0, length >> 1, length - 1]) {
      if (index < 0 || index >= length) continue;
      const other = flat(changed(piece, index));
      count(starts(subject, other, from), 7);
      count(ends(subject, other, from + length), 9);
    }
  }
  lines.push("length " + length + ": " + yes + " " + no + " " + sum);
}

const wide = flat("αβγδεζηθικλμνξοπρστυφχψω" + letters);
const cases: [string, string][] = [
  [subject, ""], ["", ""], ["", "a"], [subject, subject], [subject, subject + "!"], [wide, "αβγ"], [wide, flat("ω" + letters.slice(0, 5))], [wide, letters.slice(0, 9)],
  [subject, "α"], [subject, flat("abc") + flat("def")], [flat("abc") + flat("defghijklmnopqrstuvwxyz"), flat("abcdefg")], [flat("abc") + flat("def"), flat("ab") + flat("cd")],
  [wide, flat("XY") + flat("Z")], [subject, "XYZ"], [subject, "xYZ"], [subject, flat("9ABCDEFGHIJKLMNOPQRSTUVWXYZ")], [subject, flat("8ABCDEFGHIJKLMNOPQRSTUVWXYZ")],
];
for (const [text, sought] of cases)
  lines.push([starts(text, sought), ends(text, sought), starts(text, sought, 24), ends(text, sought, 27), starts(text, sought, 3), ends(text, sought, 6)].join(" "));

const positions: number[] = [-1, -0, 0.9, 1.5, NaN, Infinity, -Infinity, 2 ** 31, 2 ** 32 + 1, -(2 ** 31) - 1, 61.99, 62, 63];
for (const at of positions)
  lines.push(String(at) + ": " + [starts(subject, hide("a"), at), starts(subject, hide("b"), at), starts(subject, hide(""), at), ends(subject, hide("Z"), at), ends(subject, hide("a"), at), ends(subject, hide(""), at)].join(" "));

console.log(lines.join("\n"));
//// static-properties-of-regexp-after-fused-replacements.ts
// RegExp.input, lastMatch, leftContext, rightContext, lastParen and $1 after chains of replacements that are done in one pass: read at once, read twice, read after a collection, after another match, after an assignment to RegExp.input, after a chain that found nothing.
const report: string[] = [];
const legacy = RegExp as unknown as Record<string, string>;
function all(): string {
  return [legacy.input, legacy.lastMatch, legacy.leftContext, legacy.rightContext, legacy.lastParen, legacy.$1, legacy.$_].map(text => "[" + text + "]").join("");
}
function quote(text: string): string {
  return text.replace(/%/g, "%25").replace(/#/g, "%23").replace(/\?/g, "%3F");
}
function blank(text: string): string {
  return text.replace(/[0-9a-f]+/g, "x").replace(/\s/g, ".");
}
function makeGarbage(): number {
  let kept = 0;
  for (let i = 0; i < 30000; i++) kept += [String(i), i].length + { i }.i;
  return kept;
}
for (const text of ["50%", "a#b?c%d", "fade 12 cab", "zzz", "", "??##", "%"]) {
  quote(text);
  report.push("at once " + all());
  quote(text);
  blank(text);
  report.push("second chain " + all());
  blank(text);
  quote(text);
  makeGarbage();
  report.push("after a collection " + all() + all());
  quote(text + "#");
  /(o|r)+/.exec("door");
  report.push("another match behind " + all());
  /(o|r)+/.exec("door");
  quote(text + "?");
  report.push("another match ahead " + legacy.rightContext + "|" + legacy.leftContext + "|" + legacy.input);
  quote("%" + text);
  legacy.input = "assigned";
  report.push("assigned " + all());
  blank(text + " 0");
  report.push("input alone " + legacy.input);
  blank("f " + text);
  "untouched".replace(/Q/g, "q").replace(/Z/g, "z");
  report.push("nothing found behind " + legacy.lastMatch + "|" + legacy.input);
}
console.log(report.join("\n"));
//// string-builder-await-and-catch.ts
// A string that a loop appends to keeps its content when a part or the append itself throws, across await, yield and collections, when 16-bit text arrives, and at the length limit.
const collect: () => void = (globalThis as any).gc ?? (() => (globalThis as any).Bun.gc(true));
function show(label: string, text: string): void {
  let hash = 0;
  for (let i = 0; i < text.length; i++) hash = (hash * 31 + text.charCodeAt(i)) | 0;
  console.log(label + ": " + text.length + " " + hash + " " + JSON.stringify(text.length <= 90 ? text : text.slice(0, 40) + ".." + text.slice(-40)));
}
function risky(i: number): string { if (i % 3 === 2) throw new Error("part " + i); return "p" + i; }
function partThrows(n: number): string { let s = "<"; for (let i = 0; i < n; i++) { try { s += "[" + i + ":" + risky(i) + "]"; } catch (error) { s += "(" + (error as Error).message + " at " + s.length + ")"; } } return s + ">"; }
function throwExitsLoop(n: number): string { let s = ""; try { for (let i = 0; i < n; i++) { s += i; s += risky(i); s += ","; } } catch { s += "!"; } finally { s += "."; } return s; }
function handlerReturnsOldState(n: number): string { let s = "kept"; try { for (let i = 0; i < n; i++) s += risky(i); } catch { return s; } return s + " all"; }
const throwingToString = { toString(): string { throw new Error("no text"); } };
const plainToString = { toString(): string { return "text"; } };
function conversionThrows(parts: any[]): string { let s = ""; for (const part of parts) { try { s += "<" + part + ">"; } catch (error) { s += "{" + (error as Error).name + "}"; } } return s; }
async function later<T>(value: T): Promise<T> { await null; return value; }
async function fails(i: number): Promise<string> { await null; throw new Error("awaited " + i); }
async function acrossAwait(n: number): Promise<string> { let s = "start"; for (let i = 0; i < n; i++) { s += ":" + i; await null; s += i % 2 ? "odd" : await later("even"); } return s; }
async function awaitInTry(n: number): Promise<string> { let s = ""; for (let i = 0; i < n; i++) { try { s += i; s += i === 1 ? await fails(i) : await later("ok"); } catch (error) { s += "(" + (error as Error).message + ")"; } finally { s += ";"; } } return s; }
async function twoAtOnce(): Promise<string> { const [a, b] = await Promise.all([acrossAwait(4), acrossAwait(3)]); return a + "|" + b; }
function* yieldsLengths(n: number): Generator<number, string> { let s = ""; for (let i = 0; i < n; i++) { s += "ab"; yield s.length; s += i; } return s; }
function drained(n: number): string { const lengths: number[] = []; const generator = yieldsLengths(n); for (;;) { const step = generator.next(); if (step.done) return lengths.join() + " " + step.value; lengths.push(step.value as number); } }
function wideText(n: number): string { let s = ""; for (let i = 0; i < n; i++) s += i === 3 ? "\u65e5\u672c\u8a9e" : i === 5 ? "\u{1F600}" : i === 6 ? "\ud800" : i === 7 ? "\u00e9\u00ff" : i === 8 ? "\u0100" : "ab"; return s; }
function wideFromStart(n: number): string { let s = "\u8a9e"; for (let i = 0; i < n; i++) s += i + "\u00e9"; return s; }
function long(n: number): string { let s = ""; for (let i = 0; i < n; i++) s += "0123456789abcdef" + i; return s; }
function doubled(times: number): string { let text = "x"; for (let i = 0; i < times; i++) text = text + text; return text; }
function lengthLimit(): void {
  const big = doubled(29); let s = "head"; let appended = 0; let name = "none";
  try { for (let i = 0; i < 8; i++) { s += big; appended++; } } catch (error) { name = (error as Error).name; }
  const lengthAfterFailure = s.length; s += "tail";
  console.log("length limit: " + appended + " " + name + " " + lengthAfterFailure + " " + s.length);
}
function multipartLengthLimit(): void {
  const big = doubled(29); let s = "head"; let appended = 0; let name = "none";
  try { for (let i = 0; i < 8; i++) { s += "[" + big + "]" + i; appended++; } } catch (error) { name = (error as Error).name; }
  console.log("length limit, several parts: " + appended + " " + name + " " + s.length);
}
async function manyAtOnce(count: number): Promise<string> { const pending: Promise<string>[] = []; for (let i = 0; i < count; i++) pending.push(acrossAwait(1 + i % 4)); return (await Promise.all(pending)).join("|"); }
async function collectsAcrossAwait(n: number): Promise<string> { let s = "start"; for (let i = 0; i < n; i++) { s += ":" + i; await null; collect(); s += "."; } return s; }
function collectsAcrossYield(n: number): string { const generator = yieldsLengths(n); let s = ""; for (;;) { const step = generator.next(); collect(); if (step.done) return s + step.value; s += (step.value as number) + ","; } }
show("a part throws", partThrows(7));                       show("a throw exits the loop", throwExitsLoop(7));           show("no throw", throwExitsLoop(2));
show("the handler returns the old state", handlerReturnsOldState(7));                                                    show("no handler run", handlerReturnsOldState(2));
show("a conversion throws", conversionThrows([1, "two", throwingToString, null, plainToString, Symbol("s"), undefined, 4n, true]));
show("across await", await acrossAwait(5));                 show("await in try", await awaitInTry(4));                   show("two at once", await twoAtOnce());
console.log("across yield: " + drained(4));
show("16-bit text arrives", wideText(11));                  show("16-bit text from the start", wideFromStart(5));        show("long", long(20000));
lengthLimit();
multipartLengthLimit();
show("many at once", await manyAtOnce(12));                 show("collections across await", (await Promise.all([collectsAcrossAwait(3), collectsAcrossAwait(2)])).join("|"));
console.log("collections across yield: " + collectsAcrossYield(4));
//// string-builder-interleaved.ts
// Two strings are appended to in turn in one loop, a function that builds a string is called while another string is being built, a collection runs between two builders, and a string is read while it grows.
const collect: () => void = (globalThis as any).gc ?? (() => (globalThis as any).Bun.gc(true));
function inTurn(n: number): string { let a = "a:"; let b = "b:"; for (let i = 0; i < n; i++) { a += i; b += i * 2; a += ","; b += ";"; } return a + "|" + b; }
function chosenByCondition(n: number): string { let even = ""; let odd = ""; for (let i = 0; i < n; i++) { if (i & 1) odd += i; else even += i; } return even + "/" + odd; }
function swapped(n: number): string { let a = "a"; let b = "b"; for (let i = 0; i < n; i++) { a += i; [a, b] = [b, a]; } return a + "|" + b; }
function oneIntoAnother(n: number): string { let a = ""; let b = ""; for (let i = 0; i < n; i++) { b += i; a += b; a += ";"; } return a; }
function inner(k: number): string { let s = "("; for (let j = 0; j < k; j++) s += j; return s + ")"; }
function nestedCalls(n: number): string { let s = ""; for (let i = 0; i < n; i++) { s += "<"; s += inner(i); s += ">"; } return s; }
function nestedLoops(n: number): string { let s = ""; for (let i = 0; i < n; i++) { let row = ""; for (let j = 0; j <= i; j++) row += j; s += row + "\n"; } return s; }
function recursive(depth: number): string { let s = "["; for (let i = 0; i < 2; i++) { s += depth; if (depth) s += recursive(depth - 1); } return s + "]"; }
function deepRecursion(depth: number): string { let s = "("; for (let i = 0; i < 2; i++) { s += depth; if (i === 0 && depth) s += deepRecursion(depth - 1); } return s + ")"; }
function collectsBetweenBuilders(n: number): string { let s = ""; for (let i = 0; i < n; i++) { s += inner(i); collect(); } return s; }
function readInLoop(n: number): string { let s = ""; let sum = 0; for (let i = 0; i < n; i++) { s += "xy"; sum += s.length; if (s.endsWith("yxy")) sum++; } return s + sum; }
function retainedStates(n: number): string { const states: string[] = []; let s = ""; for (let i = 0; i < n; i++) { s += i; states.push(s); } return states.join("|"); }
function previousState(n: number): string { let s = ""; let previous = ""; for (let i = 0; i < n; i++) { previous = s; s += i; } return previous + "|" + s; }
function prepended(n: number): string { let s = ""; for (let i = 0; i < n; i++) s = i + s; return s; }
function separators(items: string[]): string { let s = ""; for (const item of items) { if (s) s += ", "; s += item; } return s; }
function readBetweenLoops(n: number): string { let s = ""; for (let i = 0; i < n; i++) s += i; const middle = s; for (let i = 0; i < n; i++) s += "-" + i; return middle + "|" + s; }
function neverRead(n: number): number { let s = ""; let count = 0; for (let i = 0; i < n; i++) { s += i; count++; } return count; }
function keys(n: number): string {
  const counts: Record<string, number> = {}; const sums = new Map<string, number>();
  for (let i = 0; i < n; i++) { const key = (i % 3) + ":" + (i % 2); counts[key] = (counts[key] ?? 0) + 1; sums.set(key, (sums.get(key) ?? 0) + i); }
  return JSON.stringify(counts) + " " + [...sums].join(";");
}
for (const n of [0, 1, 5, 40]) {
  console.log(n + " in turn: " + inTurn(n));                       console.log(n + " chosen by a condition: " + chosenByCondition(n));     console.log(n + " swapped: " + swapped(n));
  console.log(n + " one into the other: " + oneIntoAnother(n).length + " " + oneIntoAnother(n).slice(-30));                                  console.log(n + " nested calls: " + nestedCalls(Math.min(n, 6)));
  console.log(n + " nested loops: " + JSON.stringify(nestedLoops(Math.min(n, 6))));                                                          console.log(n + " recursive: " + recursive(Math.min(n, 3)));
  console.log(n + " read in the loop: " + readInLoop(n));          console.log(n + " retained states: " + retainedStates(Math.min(n, 8))); console.log(n + " previous state: " + previousState(n));
  console.log(n + " prepended: " + prepended(n));                  console.log(n + " read between loops: " + readBetweenLoops(n));         console.log(n + " never read: " + neverRead(n));
  console.log(n + " keys: " + keys(n));
  console.log(n + " deep recursion: " + deepRecursion(Math.min(n, 12)));                                                                     console.log(n + " collections between builders: " + collectsBetweenBuilders(Math.min(n, 6)));
}
console.log("separators: " + separators([]) + "|" + separators(["a"]) + "|" + separators(["", "a", "", "b"]) + "|" + separators(["x", "y", "z"]));
//// string-builder-part-forms.ts
// A string that a loop appends to takes each form of part: integers and numbers near powers of ten, constants at and over the inline limit, strings of every internal representation, a rope, an initial value, and lengths just under and over each size limit of the builder.
function show(label: string, text: string): void {
  let hash = 0;
  for (let i = 0; i < text.length; i++) hash = (hash * 31 + text.charCodeAt(i)) | 0;
  console.log(label + ": " + text.length + " " + hash + " " + JSON.stringify(text.length <= 90 ? text : text.slice(0, 40) + ".." + text.slice(-40)));
}
function doubled(times: number): string { let text = "x"; for (let i = 0; i < times; i++) text = text + text; return text; }
function nearPowersOfTen(): number[] { const values = [2147483647, -2147483648]; for (let power = 1; power <= 1e9; power *= 10) values.push(power - 1, power, power + 1, 1 - power, -power, -power - 1); return values; }
function integerParts(values: number[]): string { let s = ""; for (const value of values) s += "<" + (value | 0) + ">"; return s; }
function numberParts(values: number[]): string { let s = ""; for (const value of values) s += value + ";"; return s; }
function constantParts(n: number): string { let s = ""; for (let i = 0; i < n; i++) { s += "0123456789abcdef"; s += "|"; s += "0123456789abcdefg"; s += ""; s += "\u00e9"; } return s; }
function constantAtInlineLimit(n: number): string { let s = ""; for (let i = 0; i < n; i++) s += "0123456789abcdef"; return s; }
function constantOverInlineLimit(n: number): string { let s = ""; for (let i = 0; i < n; i++) s += "0123456789abcdefg"; return s; }
function nonASCIIConstant(n: number): string { let s = ""; for (let i = 0; i < n; i++) s += "\u00e9"; return s; }
function stringParts(parts: string[], rounds: number): string { let s = ""; for (let round = 0; round < rounds; round++) for (const part of parts) s += part + "|"; return s; }
function ropeAsThirdPart(rope: string, n: number): string { let s = ""; for (let i = 0; i < n; i++) s += "<" + i + rope + ">"; return s; }
function appendsToInitialValue(initial: string, n: number): string { let s = initial; for (let i = 0; i < n; i++) s += i; return s; }
function partLengthSweep(text: string): string {
  let s = "";
  for (let size = 2; size <= 131072; size *= 2) for (let length = size - 2; length <= size + 1; length++) { s += text.slice(0, length); s += "|"; s += appendsToInitialValue(text.slice(0, length), 1); s += "|"; }
  return s;
}
show("integer parts", integerParts(nearPowersOfTen()));     show("number parts", numberParts([...nearPowersOfTen(), 1.5, -0, 0.1 + 0.2, 1e21, 1e-7, NaN, Infinity, -Infinity, 4294967296]));
show("constant parts", constantParts(300));                 show("a rope as the third part", ropeAsThirdPart(doubled(3), 40));
show("a 16-character constant", constantAtInlineLimit(300)); show("a 17-character constant", constantOverInlineLimit(300)); show("a non-ASCII constant", nonASCIIConstant(300));
const latin1Parts = ["", "a", "0123456789abcdef", "0123456789abcdefg", doubled(3), doubled(5), "0123456789abcdefghij".slice(2, 12), "\u00e9\u00ff"];
show("Latin-1 string parts", stringParts(latin1Parts, 60)); show("16-bit string parts", stringParts([...latin1Parts, "\u8a9eabcd".slice(1), "\u8a9e", "\u{1F600}"], 60));
show("one string alone", appendsToInitialValue("alone", 0)); show("part lengths near powers of two", partLengthSweep("0123456789".repeat(13200)));
export {};
//// string-comparison-at-word-boundaries.ts
// `<`, `<=`, `>` and `>=` on strings of lengths 0, 7, 8, 9, 16 and 17 that differ at every position.
declare const $vm: any;
const narrow = (text: string): string => text.split("").join("");
function typed(a: string, b: string): number { return (a < b ? 1 : 0) + (a <= b ? 2 : 0) + (a > b ? 4 : 0) + (a >= b ? 8 : 0); }
function any(a: any, b: any): number { return (a < b ? 1 : 0) + (a <= b ? 2 : 0) + (a > b ? 4 : 0) + (a >= b ? 8 : 0); }
const base = "abcdefghijklmnopq", out: number[] = [];
for (const m of [0, 7, 8, 9, 16, 17]) for (const n of [0, 7, 8, 9, 16, 17]) out.push(typed(narrow(base.slice(0, m)), narrow(base.slice(0, n))), any(narrow(base.slice(0, m)), narrow(base.slice(0, n))));
for (let at = 0; at < 17; at++) for (const unit of ["\u0000", "`", "z", "\u007f", "\u0080", "ÿ"]) for (const against of ["\u007f", "\u0080", "ÿ", base[at]!]) {
  const a = narrow(base.slice(0, at) + unit + base.slice(at + 1)), b = narrow(base.slice(0, at) + against + base.slice(at + 1));
  out.push(typed(a, b), any(b, a));
}
console.log(out.join(""));
