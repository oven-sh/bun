for (const m of [0, 7, 8, 9, 16, 17])
  for (const n of [0, 7, 8, 9, 16, 17])
    out.push(typed(narrow(base.slice(0, m)), narrow(base.slice(0, n))), any(narrow(base.slice(0, m)), narrow(base.slice(0, n))));
