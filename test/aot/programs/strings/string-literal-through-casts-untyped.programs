//// string-literal-through-casts-untyped.js
// A string literal gives the same answer whether the build can see the literal or not (strings/string-literal-through-casts without type annotations, so without its casts).
function any(x) {
  return x;
}
const hidden = [(x) => x];
function show(v) {
  if (typeof v !== "string")
    return typeof v + ":" + String(v);
  const c = [];
  for (let i = 0;i < v.length; i++)
    c.push(v.charCodeAt(i));
  return v.length + ":" + JSON.stringify(v) + "[" + c.join() + "]";
}
let rows = 0;
let bad = 0;
function check(name, a, b) {
  let x, y;
  try {
    x = show(a());
  } catch (e) {
    x = "throws " + e.name;
  }
  try {
    y = show(b());
  } catch (e) {
    y = "throws " + e.name;
  }
  rows++;
  if (x !== y) {
    bad++;
    console.log("DIFFERS " + name + ": " + x + " | " + y);
  }
}
const subjects = ["text", "NaN", "5", "05", "0.5", ".5", "12", "true", "false", "", "x", "7", "16", "null", "undefined", "1e+21", "1e-7", "\xE9", "\u0416", "a longer text, of forty bytes or so, written"];
const holder = { text: 1, NaN: 2, "5": 3, "05": 4, "0.5": 5, true: 6, "": 7 };
const table = new Map([["text#1", 1], ["NaN#1", 2], ["5#1", 3], ["05#1", 4], ["0.5#1", 5], ["true#1", 6], ["#1", 7]]);
for (let turn = 0;turn < 2; turn++) {
