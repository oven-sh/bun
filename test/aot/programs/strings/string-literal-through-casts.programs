//// string-literal-through-casts.ts
// A string literal that goes through casts gives the same answer whether the build can see the literal or not: a cast that a string passes leaves it as it is, and a cast to `number` or `boolean` throws a TypeError in both.
function any(x: unknown): any { return x }
const hidden: ((x: unknown) => any)[] = [x => x]
function show(v: unknown): string { if (typeof v !== "string") return typeof v + ":" + String(v); const c: number[] = []; for (let i = 0; i < v.length; i++) c.push(v.charCodeAt(i)); return v.length + ":" + JSON.stringify(v) + "[" + c.join() + "]" }
let rows = 0, bad = 0
function check(name: string, a: () => unknown, b: () => unknown): void { let x: string, y: string; try { x = show(a()) } catch (e) { x = "throws " + (e as Error).name } try { y = show(b()) } catch (e) { y = "throws " + (e as Error).name } rows++; if (x !== y) { bad++; console.log("DIFFERS " + name + ": " + x + " | " + y) } }
const subjects: string[] = ["text", "NaN", "5", "05", "0.5", ".5", "12", "true", "false", "", "x", "7", "16", "null", "undefined", "1e+21", "1e-7", "\u00e9", "\u0416", "a longer text, of forty bytes or so, written"]
const holder: Record<string, number> = { text: 1, NaN: 2, "5": 3, "05": 4, "0.5": 5, true: 6, "": 7 }
const table = new Map<string, number>([["text#1", 1], ["NaN#1", 2], ["5#1", 3], ["05#1", 4], ["0.5#1", 5], ["true#1", 6], ["#1", 7]])
for (let turn = 0; turn < 2; turn++) {
  check("\"text\" as number as unknown as string: new RegExp(v).source", () => new RegExp((any("text") as number as unknown as string) || "q").source, () => new RegExp((hidden[0]("text") as number as unknown as string) || "q").source)
  check("\"text\" as boolean as unknown as string: new RegExp(v).source", () => new RegExp((any("text") as boolean as unknown as string) || "q").source, () => new RegExp((hidden[0]("text") as boolean as unknown as string) || "q").source)
  check("\"text\" as string: new RegExp(v).source", () => new RegExp((any("text") as string) || "q").source, () => new RegExp((hidden[0]("text") as string) || "q").source)
  check("\"\" as number as unknown as string: new RegExp(v).source", () => new RegExp((any("") as number as unknown as string) || "q").source, () => new RegExp((hidden[0]("") as number as unknown as string) || "q").source)
  check("\"\" as boolean as unknown as string: new RegExp(v).source", () => new RegExp((any("") as boolean as unknown as string) || "q").source, () => new RegExp((hidden[0]("") as boolean as unknown as string) || "q").source)
  check("\"\" as string: new RegExp(v).source", () => new RegExp((any("") as string) || "q").source, () => new RegExp((hidden[0]("") as string) || "q").source)
  check("\"12\" as number as unknown as string: new RegExp(v).source", () => new RegExp((any("12") as number as unknown as string) || "q").source, () => new RegExp((hidden[0]("12") as number as unknown as string) || "q").source)
  check("\"12\" as boolean as unknown as string: new RegExp(v).source", () => new RegExp((any("12") as boolean as unknown as string) || "q").source, () => new RegExp((hidden[0]("12") as boolean as unknown as string) || "q").source)
  check("\"12\" as string: new RegExp(v).source", () => new RegExp((any("12") as string) || "q").source, () => new RegExp((hidden[0]("12") as string) || "q").source)
  check("\"05\" as number as unknown as string: new RegExp(v).source", () => new RegExp((any("05") as number as unknown as string) || "q").source, () => new RegExp((hidden[0]("05") as number as unknown as string) || "q").source)
