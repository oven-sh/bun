function ends62(s: string): boolean { return s.endsWith("abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghij") }
function literal62(): string { return "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghij" }
function latin62(): string { return "àáâãäåæçèéêëìíîïðñòóàáâãäåæçèéêëìíîïðñòóàáâãäåæçèéêëìíîïðñòóàá" }
function wide62(): string { return "ĀāĂăĄąĆćĈĉĊċČčĎďĐđĒēĔĕĖėĘęĚěĜĝĞğĠġĢģĤĥĦħĀāĂăĄąĆćĈĉĊċČčĎďĐđĒēĔĕ" }
function mixed62(): string { return "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghi→" }
