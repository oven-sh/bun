function mixed5000(): string { return "→" }
const rows: [number, (s: string) => boolean, (s: string) => boolean, (s: string) => boolean, () => string, () => string, () => string, () => string][] = [
  [1, is1, starts1, ends1, literal1, latin1, wide1, mixed1],
  [2, is2, starts2, ends2, literal2, latin2, wide2, mixed2],
  [3, is3, starts3, ends3, literal3, latin3, wide3, mixed3],
  [62, is62, starts62, ends62, literal62, latin62, wide62, mixed62],
  [63, is63, starts63, ends63, literal63, latin63, wide63, mixed63],
  [64, is64, starts64, ends64, literal64, latin64, wide64, mixed64],
  [126, is126, starts126, ends126, literal126, latin126, wide126, mixed126],
  [127, is127, starts127, ends127, literal127, latin127, wide127, mixed127],
  [128, is128, starts128, ends128, literal128, latin128, wide128, mixed128],
  [253, is253, starts253, ends253, literal253, latin253, wide253, mixed253],
  [254, is254, starts254, ends254, literal254, latin254, wide254, mixed254],
  [255, is255, starts255, ends255, literal255, latin255, wide255, mixed255],
  [256, is256, starts256, ends256, literal256, latin256, wide256, mixed256],
  [257, is257, starts257, ends257, literal257, latin257, wide257, mixed257],
  [300, is300, starts300, ends300, literal300, latin300, wide300, mixed300],
  [511, is511, starts511, ends511, literal511, latin511, wide511, mixed511],
  [512, is512, starts512, ends512, literal512, latin512, wide512, mixed512],
  [1000, is1000, starts1000, ends1000, literal1000, latin1000, wide1000, mixed1000],
  [5000, is5000, starts5000, ends5000, literal5000, latin5000, wide5000, mixed5000],
]
for (const [n, is, starts, ends, literal, latin, wide, mixed] of rows) {
  const exact = flat(made(n))
  const forms: string[] = [exact, made(n), flat("<" + exact + ">").slice(1, 1 + n), flat("\u0100" + exact).slice(1), exact + "x", "x" + exact, exact.slice(1), exact.slice(0, -1), exact.slice(0, -1) + "#", "#" + exact.slice(1), exact + exact, ""]
  let row = ""
  for (const form of forms) row += (is(form) ? 1 : 0) + "" + (starts(form) ? 1 : 0) + (ends(form) ? 1 : 0) + " "
  console.log(n, row, literal().length, sum(literal()), literal() === exact, latin().length, sum(latin()), wide().length, sum(wide()), mixed().length, sum(mixed()), mixed().charCodeAt(n - 1))
}
