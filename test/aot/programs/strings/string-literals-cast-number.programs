function starts63(s: string): boolean { return s.startsWith("abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijk") }
function ends63(s: string): boolean { return s.endsWith("abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijk") }
function literal63(): string { return "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijk" }
function latin63(): string { return "àáâãäåæçèéêëìíîïðñòóàáâãäåæçèéêëìíîïðñòóàáâãäåæçèéêëìíîïðñòóàáâ" }
function wide63(): string { return "ĀāĂăĄąĆćĈĉĊċČčĎďĐđĒēĔĕĖėĘęĚěĜĝĞğĠġĢģĤĥĦħĀāĂăĄąĆćĈĉĊċČčĎďĐđĒēĔĕĖ" }
