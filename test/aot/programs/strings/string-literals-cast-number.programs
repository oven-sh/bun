console.log(answers, calls === 0 ? "=== on 8-bit flat strings and substrings calls no operation" : `=== CALLED THE OPERATION ${calls} TIMES`);

answers = 0;
before = count("operationAOTCompareStrings");
for (let round = 0; round < rounds; round++) {
  if (less(flatText, flatChanged)) answers++;
  if (less(flatChanged, flatText)) answers++;
  if (less(flatText, flatCopy)) answers++;
}
calls = count("operationAOTCompareStrings") - before;
console.log(answers, calls === 0 ? "< on 8-bit flat strings calls no operation" : `< CALLED THE OPERATION ${calls} TIMES`);

before = count("operationAOTStringsAreEqual");
const isSameText = equal(flatText, wideSubstring(alphabet));
calls = count("operationAOTStringsAreEqual") - before;
console.log(isSameText, !canCount || calls > 0 ? "8 bits against 16 bits calls the operation" : "8 BITS AGAINST 16 BITS DID NOT CALL THE OPERATION");

console.log(failures === 0 ? "every answer matches the code units" : `${failures} WRONG ANSWERS`);
//// strings-become-names-while-their-characters-are-read.ts
// A string is walked character by character while, in the same loop, it is used as a property key for the first time, and memory is collected.
function make(prefix: string, n: number): string { let s = prefix; for (let i = 0; i < n; i++) s += String.fromCharCode(97 + (i * 7) % 26); return s; }
function fresh(text: string): string { return (text + "!").slice(0, -1); }
function copyOf(text: string): string { return text.split("").join(""); }
function pressure(): number { let t = 0; for (let i = 0; i < 300; i++) { const a = make("p" + i, 40); t += a.length; } Bun.gc(true); return t; }
const table: Record<string, number> = {};
function walk(o: Record<string, number>, s: string): number {
    let t = 0;
    for (let i = 0; i < s.length; i++) {
        t = (t * 31 + s.charCodeAt(i)) | 0;
        if (i === 3) { t += o[s] | 0; pressure(); }
        if (i === 9) { o[s] = i; pressure(); }
    }
    return t;
}
function walkIndex(o: Record<string, number>, s: string): string {
    let t = "";
    for (let i = 0; i < s.length; i++) {
        if (i === 2) { if (s in o) t += "+"; pressure(); }
        t += s[i];
        if (i === 5) { t += Object.hasOwn(o, s) ? "y" : "n"; pressure(); }
    }
    return t;
}
function walkUntyped(o: any, s: any): number {
    let t = 0;
    const n = s.length;
    for (let i = 0; i < n; i++) {
        t = (t + s.codePointAt(i)) | 0;
        if (i === 1) { o[s]; Symbol.for(s); pressure(); }
    }
    return t;
}
function compare(o: Record<string, number>, a: string, b: string): boolean {
    let same = true;
    for (let i = 0; i < 6; i++) {
        same = same && a === b;
        if (i === 1) { o[a] = 1; pressure(); }
        if (i === 3) { o[b] = 2; pressure(); }
    }
    return same;
}
for (const length of [1, 5, 12, 17, 40, 300, 5000]) {
    const text = make("k" + length, length);
    table[text] = length;                      // The name exists before the other strings of the same text become names.
    const results: (string | number | boolean)[] = [];
    results.push(walk(table, fresh(text)), walk(table, copyOf(text)), walk({}, fresh(text + "x")), walk({}, copyOf(text + "y")));
    results.push(walkIndex(table, fresh(text)).length, walkIndex(table, copyOf(text)) === walkIndex({}, fresh(text)).replace("n", "y").replace(/^(..)/, "$1+"));
    results.push(walkUntyped(table, fresh(text)), walkUntyped(new Map(), copyOf(text)), walkUntyped({}, fresh(text + "z")));
    results.push(compare({}, fresh(text), copyOf(text)), compare(table, copyOf(text), fresh(text)));
    console.log(length, results.join(" "));
}
const wide = make("中文", 30);
table[wide] = 1;
console.log(walk(table, fresh(wide)), walkIndex(table, copyOf(wide)).length, walkUntyped(table, fresh(wide)));
//// strings-built-and-read-locally.ts
// A string built with += in a loop and read in the same function. The sizes are such that a run that makes the string anew at every read does not end within any time limit: 300,000 turns are a fraction of a second where it is made once.
const out: string[] = [];
function builtThenRead(n: number): number { let result = ""; for (let i = 0; i < n; i++) { result += i * 7919; result += "."; } let sum = 0; for (let i = 0; i < result.length; i++) sum = (sum * 31 + result.charCodeAt(i)) | 0; return sum; }
function builtThenReadBackwards(n: number): number { let s = "<"; for (let i = 0; i < n; i++) s += i & 7; let sum = 0; for (let i = s.length - 1; i >= 0; i--) sum = (sum * 33 + s.charCodeAt(i)) | 0; return sum; }
function builtThenSearched(n: number): number { let s = ""; for (let i = 0; i < n; i++) { s += i; s += ","; } let found = 0; for (let i = 0; i < 2000; i++) if (s.indexOf("," + (n - 1 - i) + ",") >= 0) found++; return found; }
function builtThenSliced(n: number): number { let s = ""; for (let i = 0; i < n; i++) { s += i % 10; } let sum = 0; for (let i = 0; i + 4 <= s.length; i += 4) sum = (sum + Number(s.slice(i, i + 4))) | 0; return sum; }
function builtThenCompared(n: number): number { let s = ""; for (let i = 0; i < n; i++) s += "ab"; let same = 0; for (let i = 0; i < n; i++) if (s === "abab" || s.length === 2 * n) same++; return same; }
function builtThenHandedOn(n: number, take: (s: string) => number): number { let s = ""; for (let i = 0; i < n; i++) { s += i; s += ";"; } let sum = 0; for (let i = 0; i < 1000; i++) sum += take(s); return sum; }
function readWhileBuilt(n: number): number { let s = ""; let sum = 0; for (let i = 0; i < n; i++) { s += i; if ((i & 1023) === 0) sum = (sum + s.charCodeAt(s.length - 1) + s.charCodeAt(0)) | 0; } return sum + s.length; }
function readAtEveryTurn(n: number): number { let s = ""; let sum = 0; for (let i = 0; i < n; i++) { s += i % 10; sum = (sum + s.charCodeAt(i)) | 0; } return sum; }
function builtOnAfterReading(n: number): string { let s = ""; for (let i = 0; i < n; i++) s += i; const first = s.charCodeAt(1); const before = s; for (let i = 0; i < n; i++) s += "-"; return first + " " + before.length + " " + s.length + " " + s.charCodeAt(before.length) + " " + before.charCodeAt(before.length - 1) + " " + (before === s) + " " + s.startsWith(before); }
function twoBuilders(n: number): number { let a = ""; let b = ""; for (let i = 0; i < n; i++) { a += i; b += n - i; } let sum = 0; for (let i = 0; i < a.length && i < b.length; i++) sum = (sum * 7 + a.charCodeAt(i) - b.charCodeAt(i)) | 0; return sum; }
function sometimesEmpty(n: number): number { let s = ""; for (let i = 0; i < n; i++) s += i; let sum = 0; for (let i = 0; i < 10; i++) sum += s.length ? s.charCodeAt(0) : -1; return sum; }
function wide(n: number): number { let s = ""; for (let i = 0; i < n; i++) { s += i; s += "ā"; } let sum = 0; for (let i = 0; i < s.length; i++) sum = (sum * 31 + s.charCodeAt(i)) | 0; return sum; }
function inBranches(n: number, which: boolean): number { let s = ""; for (let i = 0; i < n; i++) s += i; let sum = 0; if (which) { for (let i = 0; i < s.length; i++) sum += s.charCodeAt(i); } else { for (let i = 0; i < s.length; i += 2) sum -= s.charCodeAt(i); } return sum + s.length; }
for (const n of [0, 1, 2, 7, 40, 1000, 300000]) {
    out.push([n, builtThenRead(n), builtThenReadBackwards(n), builtThenSliced(n), builtThenCompared(n), readWhileBuilt(n), twoBuilders(n), sometimesEmpty(n), wide(n), inBranches(n, true), inBranches(n, false)].join(" "));
}
for (const n of [0, 1, 50, 20000]) out.push([n, builtThenSearched(n), builtThenHandedOn(n, s => s.length + (s.length ? s.charCodeAt(s.length >> 1) : 0)), readAtEveryTurn(n), builtOnAfterReading(n)].join(" "));
console.log(out.join("\n"));
//// strings-built-piece-by-piece-and-kept-on-the-way.ts
// Strings are built in loops. What they are on the way is kept, used as keys, compared and cut, pieces throw, and builders nest.
let seed = 7;
function random(n: number): number { seed = (Math.imul(seed, 1103515245) + 12345) & 0x7fffffff; return seed % n; }
function hash(s: string): number { let h = s.length; for (let i = 0; i < s.length; i++) h = (Math.imul(h, 31) + s.charCodeAt(i)) | 0; return h; }
const long8 = "abcdefghij".repeat(40), long16 = "中文xy".repeat(50);
class Thrower { constructor(public when: number) {} toString(): string { if (this.when-- <= 0) throw new RangeError("piece"); return "<t>"; } }
function piece(kind: number, i: number): unknown {
    switch (kind % 14) {
    case 0: return "a";
    case 1: return i;
    case 2: return i * 1000003;
    case 3: return -i - 0.5;
    case 4: return "xyz" + i;
    case 5: return long8.slice(i % 30, i % 30 + 1 + (i % 90));
    case 6: return long8;
    case 7: return "é";
    case 8: return i % 97 === 0 ? "中" : "q";
    case 9: return null;
    case 10: return undefined;
    case 11: return i % 2 === 0;
    case 12: return i % 211 === 0 ? long16.slice(1, 9) : "";
    default: return String.fromCharCode(48 + (i % 70));
    }
}
function kept(n: number, kinds: number): number {
    const all: string[] = []; let s = "";
    for (let i = 0; i < n; i++) { s += piece(random(kinds), i); if (i % 3 === 0) all.push(s); }
    let h = hash(s);
    for (const x of all) h = (Math.imul(h, 17) + hash(x)) | 0;
    return h;
}
function keys(n: number): number {
    const o: Record<string, number> = {}; let s = "k";
    for (let i = 0; i < n; i++) { s += i % 10; o[s] = i; if (i % 16 === 15) s = "k" + i; }
    let h = 0; for (const k in o) h = (Math.imul(h, 13) + hash(k) + o[k]) | 0;
    return h;
}
function throwing(n: number, at: number): string {
    let s = "start"; const t = new Thrower(at); const seen: string[] = [];
    for (let i = 0; i < n; i++) {
        try { s += "[" + i + t + "]"; } catch (e) { s += "!" + (e as Error).message; }
        seen.push(s);
    }
    return hash(s) + ":" + hash(seen.join("|"));
}
function nested(depth: number, n: number): string {
    let s = "";
    for (let i = 0; i < n; i++) { s += depth; if (depth > 0 && i % 2 === 0) s += "(" + nested(depth - 1, n - 1) + ")"; }
    return s;
}
function template(n: number): number {
    let h = 0; let s = "";
    for (let i = 0; i < n; i++) { const t = `${i}:${s.length}/${piece(i, i)}-${i * 0.25}`; s = i % 7 === 0 ? t : s + t; h = (h + hash(t) + hash(s)) | 0; }
    return h;
}
function cut(n: number): number {
    let s = "", h = 0;
    for (let i = 0; i < n; i++) { s += piece(i, i); if (s.length > 150) { const head = s.slice(0, 20), tail = s.slice(-20); h = (h + hash(head) + hash(tail)) | 0; s = s.slice(100); } if (i % 5 === 0) h = (h + hash(s.toUpperCase())) | 0; }
    return h + hash(s);
}
function edges(): number {
    let h = 0;
    for (let target = 100; target < 160; target++) {
        for (const last of [1, 12, 123456789, -1.5, 4294967295, 1e21, "ab", "中", long8.slice(0, 17), true, null]) {
            let s = ""; while (s.length < target) s += "x";
            const before = s; s += last; s += "|"; s += last;
            h = (Math.imul(h, 7) + hash(s) + hash(before)) | 0;
        }
    }
    return h;
}
function joined(n: number): number {
    const parts: string[] = []; let s = "";
    for (let i = 0; i < n; i++) { s += "p" + i; parts.push(s + ","); if (i % 4 === 0) s = parts[parts.length - 1] + s; if (s.length > 4000) s = ""; }
    return hash(parts.join(""));
