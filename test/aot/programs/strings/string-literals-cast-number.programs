const out: unknown[] = [];

out.push("a-b".replace(/(-)/, "+"), RegExp.$1, RegExp.lastMatch, RegExp["$`"], RegExp["$'"]);
out.push("xyz".search(/(y)/), RegExp.$1, RegExp.input);
