//// string-literals-cast-number-roundtrip-untyped.js
// String literals that go through casts such as `as number` and back, used as RegExp patterns, flags and operands (the same program without type annotations).
function any(x) {
  return x;
}
const hidden = [(x) => x];
const coerces = hidden[0]("1") === 1;
let rows = 0;
let bad = 0;
function expect(name, got, byRule, plain) {
  rows++;
  const wanted = coerces ? byRule : plain;
  if (got !== wanted || got.length !== wanted.length) {
    bad++;
    console.log("WRONG " + name + ": " + got.length + ":" + JSON.stringify(got) + " for " + JSON.stringify(wanted));
  }
}
function tail(pos) {
  return "=" + pos;
}
function raw(pos) {
  return "<" + pos + ">";
}
function template(pos) {
  return `<${pos}>`;
}
function flag(b) {
  return "<" + b + ">";
}
function text(s) {
  return "<" + s + ">";
}
for (let turn = 0;turn < 2; turn++) {
  expect("a pattern of a text alone", new RegExp(any("1e3")).source, "1e3", "1e3");
  expect("a pattern and back", new RegExp(any("1e3")).source, "1000", "1e3");
  expect("a pattern's test and back", String(new RegExp(any("1e3")).test("1e3")), "false", "true");
  expect("flags and back", String(new RegExp("a", any("") === "false" ? "g" : "i").flags), "g", "i");
  expect("text and back", text(any("05")), "<5>", "<05>");
  expect("length and back", String(any("text").length), "3", "4");
  expect("equal and back", String(any("05") === "05"), "false", "true");
  expect("equal and back, 5", String(any("05") === "5"), "true", "false");
  expect("starts and back", String("05x".startsWith(any("05"))), "false", "true");
  expect("tail text", tail(any("text")), "=NaN", "=text");
  expect("raw text", raw(any("text")), "<NaN>", "<text>");
  expect("template text", template(any("text")), "<NaN>", "<text>");
  expect("raw a longer text", raw(any("a longer text, of forty bytes or so, written")), "<NaN>", "<a longer text, of forty bytes or so, written>");
  expect("raw empty", raw(any("")), "<0>", "<>");
  expect("tail empty", tail(any("")), "=0", "=");
  expect("raw 05", raw(any("05")), "<5>", "<05>");
  expect("raw 0x10", raw(any("0x10")), "<16>", "<0x10>");
  expect("raw spaces", raw(any("   7   ")), "<7>", "<   7   >");
  expect("text 12345", text(any(12345)), "<12345>", "<12345>");
  expect("text 0.5", text(any(0.5)), "<0.5>", "<0.5>");
  expect("text true", text(any(true)), "<true>", "<true>");
  expect("raw .5", raw(any(".5")), "<0.5>", "<.5>");
  expect("raw 1e21", raw(any("1e21")), "<1e+21>", "<1e21>");
  expect("flag empty", flag(any("")), "<false>", "<>");
  expect("flag text", flag(any("text")), "<true>", "<text>");
  expect("flag false", flag(any("false")), "<true>", "<false>");
}
console.log(rows + " rows, " + bad + " wrong");
//// string-maps-as-iterables.ts
// Maps and Sets with string keys, and their iterators, handed to functions that know them only as Iterable<T>.
class Sym { constructor(public name: string, public id: number) {} }
const out: string[] = [];
function say(what: string, ...parts: unknown[]): void { out.push(what + ": " + parts.join(" ")); }
function names(count: number, prefix: string): string[] { const all: string[] = []; for (let i = 0; i < count; i++) all.push(prefix + i); return all; }
function listOf<T>(all: Iterable<T>): T[] { const list: T[] = []; for (const one of all) list.push(one); return list; }
function sumOf(all: Iterable<Sym>): number { let t = 0; for (const one of all) t += one.id; return t; }
function joined(all: Iterable<string>): string { let t = ""; for (const one of all) t += one + ","; return t; }
function firstOf<T>(all: Iterable<T>, count: number): T[] { const list: T[] = []; for (const one of all) { list.push(one); if (list.length === count) break; } return list; }
function each<T>(all: Iterable<T>, act: (one: T, index: number) => void): number { let i = 0; for (const one of all) act(one, i++); return i; }
function tableOf(keys: string[]): Map<string, Sym> { const m = new Map<string, Sym>(); for (let i = 0; i < keys.length; i++) m.set(keys[i], new Sym(keys[i], i + 1)); return m; }

for (const size of [0, 1, 2, 4, 5, 8, 9, 14, 15, 24, 25, 43, 44, 64, 100, 300]) {
    const keys = names(size, "k");
    const m = tableOf(keys);
    const s = new Set<string>(keys);
    say("size " + size, sumOf(m.values()), joined(m.keys()).length, listOf(m.entries()).length, listOf(m).length, joined(s).length, joined(s.values()).length, joined(s.keys()).length, listOf(s.entries()).length);
}

{
    const m = tableOf(names(6, "a"));
    say("values", listOf(m.values()).map(v => v.name + v.id).join(" "));
    say("keys", joined(m.keys()));
    say("entries", listOf(m.entries()).map(([k, v]) => k + "=" + v.id).join(" "));
    say("the map", listOf(m).map(([k, v]) => k + "=" + v.id).join(" "));
    const numbers = new Map<string, number>([["x", 1.5], ["y", -0], ["z", 2 ** 40], ["w", NaN]]);
    say("numbers", listOf(numbers.values()).map(v => Object.is(v, -0) ? "-0" : String(v)).join(" "));
    const mixed = new Map<string, unknown>([["a", undefined], ["b", null], ["c", true], ["d", "text"], ["e", 7], ["f", { toString() { return "object"; } }]]);
    say("mixed", listOf(mixed.values()).map(String).join(" "));
}

{
    const m = tableOf(names(10, "b"));
    const it = m.values();
    say("first three", firstOf(it, 3).map(v => v.id).join(" "));
    say("the next two", firstOf(it, 2).map(v => v.id).join(" "));
    say("by hand", it.next().value!.id);
    say("the rest", listOf(it).map(v => v.id).join(" "));
    say("over", listOf(it).length, it.next().done);
    m.set("late", new Sym("late", 99));
    say("still over", listOf(it).length);
}

{
    const m = tableOf(names(8, "c"));
    const it = m.keys();
    const seen: string[] = [];
    each(it, (k, i) => { seen.push(k); if (i % 2 === 0) { const skipped = it.next(); seen.push("(" + (skipped.done ? "done" : skipped.value) + ")"); } });
    say("stepped inside the loop", seen.join(" "));
}

{
    const m = tableOf(names(8, "d"));
    const seen: string[] = [];
    each(m.values(), (v, i) => { seen.push(v.name); if (i === 1) { m.delete("d2"); m.delete("d0"); m.delete("d7"); } if (i === 3) m.set("d2", new Sym("again", 0)); });
    say("deleted and put back", seen.join(" "), m.size);
}

{
    const m = tableOf(names(4, "e"));
    const seen: string[] = [];
    const turns = each(m.values(), (v, i) => { seen.push(v.name); if (i < 60) m.set("more" + i, new Sym("more" + i, i)); });
    say("grown while iterated", turns, seen.length, seen[3], seen[4], seen[63], m.size);
}

{
    const s = new Set<string>(names(4, "f"));
    let text = "";
    const turns = each(s, (k, i) => { text += k[0]; if (i < 100) s.add("g" + i); if (i % 3 === 0) s.delete(k); });
    say("a set grown and thinned", turns, text.length, s.size);
    const t = new Set<string>(names(20, "h"));
    const seen: string[] = [];
    each(t.values(), (k, i) => { seen.push(k); if (i === 4) t.clear(); if (i === 4) { t.add("fresh1"); t.add("fresh2"); } });
    say("cleared and filled anew", seen.join(" "), t.size);
}

{
    const m = tableOf(names(12, "i"));
    const seen: string[] = [];
    each<any>((m as Map<any, any>).keys(), (k, i) => { seen.push(String(k)); if (i === 5) (m as Map<any, any>).set(42, new Sym("number", 42)); if (i === 7) (m as Map<any, any>).set(NaN, new Sym("nan", 0)); });
    say("other keys come while iterated", seen.join(" "), m.size);
    say("afterwards", listOf((m as Map<any, Sym>).values()).map(v => v.name).join(" "));
}

{
    const m = tableOf(names(9, "j"));
    const a = m.values(), b = m.values(), c = m.keys();
    const seen: string[] = [];
    each(a, (v, i) => { seen.push(v.name); if (i % 2) seen.push("b:" + b.next().value!.name); if (i % 4 === 0) seen.push("c:" + c.next().value); });
    say("three iterators", seen.join(" "));
    say("what is left", listOf(b).length, listOf(c).length);
}

{
    const m = tableOf(names(5, "l"));
    const it = m.values() as IterableIterator<Sym> & { mark?: string };
    it.mark = "own";
    say("an iterator with a property", sumOf(it), it.mark);
    const other = m.values() as any;
    let closed = 0;
    other.return = function () { closed++; return {}; };
    say("an iterator with its own return", firstOf(other as Iterable<Sym>, 2).length, closed);
    const third = m.values() as any;
    let calls = 0;
    const next = third.next;
    third.next = function () { calls++; return next.call(this); };
    say("an iterator with its own next", sumOf(third as Iterable<Sym>), calls);
}

{
    class Counted extends Map<string, Sym> { reads = 0; override values() { this.reads++; return super.values(); } }
    const m = new Counted();
    for (const k of names(7, "n")) m.set(k, new Sym(k, k.length));
    say("an heir of Map", sumOf(m.values()), m.reads, listOf(m).length);
}

{
    let total = 0;
    for (let round = 0; round < 300; round++) {
        const m = tableOf(names(round % 50, "r"));
        total += sumOf(m.values()) + joined(m.keys()).length;
        if (round % 7 === 0) for (const k of listOf(m.keys())) if (k.length % 2) m.delete(k);
        total += sumOf(m.values());
    }
    say("many", total);
}
console.log(out.join("\n"));
//// string-maps-mutated-during-iteration.ts
// Maps and sets with string keys are added to, deleted from, cleared and grown while they are iterated over, in every way of iterating.
declare const console: { log(...values: unknown[]): void };
function filled(count: number): Map<string, number> {
  const map = new Map<string, number>();
  for (let i = 0; i < count; i++) map.set("k" + i, i);
  return map;
}
function keysOf(map: Map<string, number>): string {
  return [...map.keys()].join(" ");
}

for (const count of [0, 1, 3, 4, 5, 8, 9, 12, 30, 260]) {
  // Added during iteration: the new entries are visited.
  {
    const map = filled(count);
    let visited = 0;
    for (const [key, value] of map) {
      visited++;
      if (value < count && visited <= count) map.set("new" + key, value + 1000);
    }
    console.log(count, "added in for-of", visited, map.size);
  }
  {
    const map = filled(count);
    let visited = 0;
    map.forEach((value, key) => {
      visited++;
      if (value < count) map.set("new" + key, value + 1000);
    });
    console.log(count, "added in forEach", visited, map.size);
  }
  // Deleted before and after the current entry.
  {
    const map = filled(count);
    const seen: string[] = [];
    for (const key of map.keys()) {
      seen.push(key);
      const n = Number(key.slice(1));
      map.delete("k" + (n + 1));
      if (n % 4 === 0) map.delete(key);
      if (n % 6 === 0) map.delete("k" + (n - 2));
    }
    console.log(count, "deleted", seen.length, seen.slice(0, 8).join(" "), "|", keysOf(map).slice(0, 60));
  }
  // Deleted and added again: it goes to the end and is visited again.
  {
    const map = filled(count);
    let visited = 0;
    for (const [key, value] of map) {
      if (++visited > 3 * count + 3) break;
      if (value < 2 * count && value % 2 === 0) {
        map.delete(key);
        map.set(key, value + count + (count % 2) + 1);
      }
    }
    console.log(count, "moved to the end", visited, keysOf(map).slice(0, 60));
  }
  // Cleared, then filled again.
  {
    const map = filled(count);
    const seen: string[] = [];
    let cleared = false;
    for (const key of map.keys()) {
      seen.push(key);
      if (!cleared && seen.length === (count >> 1) + 1) {
        cleared = true;
        map.clear();
        map.set("after", 1);
        map.set("k0", 2);
      }
    }
    console.log(count, "cleared", seen.length, seen.slice(-3).join(" "), keysOf(map));
  }
  // An iterator by hand that outlives growth, deletion of everything, and a clear.
  {
    const map = filled(count);
    const iterator = map.entries();
    const first = iterator.next();
    for (let i = 0; i < 300; i++) map.set("more" + i, i);
    const second = iterator.next();
    for (const key of [...map.keys()]) if (key !== "more299") map.delete(key);
    const third = iterator.next();
    const fourth = iterator.next();
    map.set("late", 1);
    const fifth = iterator.next();
    console.log(count, "by hand", JSON.stringify([first, second, third, fourth, fifth]));
  }
  {
    const set = new Set<string>(filled(count).keys());
    const values = set.values();
    const out: string[] = [];
    for (let step = values.next(), n = 0; !step.done && n < 600; step = values.next(), n++) {
      out.push(step.value);
      if (n < 5) set.add("x" + n);
      if (n === 2) set.delete("x0");
      if (n === 3) set.add("x0");
    }
    console.log(count, "set", out.length, out.slice(-6).join(" "));
  }
  // Two iterations at once over one map.
  {
    const map = filled(count);
    let pairs = 0;
    for (const a of map.keys()) {
      for (const b of map.keys()) {
        pairs++;
        if (a === "k1" && b === "k2") map.delete("k3");
      }
    }
    console.log(count, "nested", pairs);
  }
}

// Order after deletions and additions, through the sizes at which a table changes its form.
{
  const map = new Map<string, number>();
  const log: string[] = [];
  for (let i = 0; i < 600; i++) {
    map.set("k" + i, i);
    if (i % 3 === 2) map.delete("k" + (i - 2));
    if (i % 7 === 6) map.set("k" + (i - 6), -i);
    if ([3, 4, 7, 8, 9, 15, 16, 17, 100, 253, 254, 255, 256, 257, 400, 599].includes(i)) log.push(i + ":" + map.size + ":" + [...map].slice(-3).join("/"));
  }
  console.log(log.join(" "));
  let sum = 0;
  for (const [key, value] of map) sum = (sum * 31 + value + key.length) | 0;
  console.log("order", sum);
}

// Spread, Array.from and copies.
{
  const map = filled(10);
  map.delete("k4");
  map.set("k4", 44);
  console.log([...map].join(";"), Array.from(map.values()).join(), JSON.stringify(Object.fromEntries(map)));
  const copy = new Map(map);
  copy.set("own", 1);
  map.delete("k0");
  console.log(copy.size, map.size, copy.get("k0"), map.get("own"), keysOf(copy));
  const grouped = Map.groupBy(["one", "two", "three", "four"], word => "length" + word.length);
  console.log([...grouped].join(";"), grouped.get("length3")!.length);
  const a = new Set<string>(["a", "b", "c"]), b = new Set<string>(["b", "c", "d"]);
  console.log([...a.union(b)].join(), [...a.intersection(b)].join(), [...a.difference(b)].join(), a.isSubsetOf(b), a.isDisjointFrom(new Set<string>(["z"])));
}
//// string-maps-odd-keys-and-receivers.ts
// A Map or Set declared with string keys meets keys that are no strings, receivers that are no plain maps, and methods that are reached in other ways.
declare const console: { log(...values: unknown[]): void };
const collect: () => void = (globalThis as any).gc ?? (() => (globalThis as any).Bun.gc(true));
function show(label: string, ...values: unknown[]): void {
  console.log(label, ...values.map(value => (typeof value === "bigint" ? value + "n" : typeof value === "symbol" ? value.toString() : Object.is(value, -0) ? "-0" : value)));
}
function entries(map: any): string {
  const out: string[] = [];
  for (const [key, value] of map) out.push(typeof key + ":" + String(Object.is(key, -0) ? "-0" : key) + "=" + String(value));
  return out.join(" ");
}

// Keys through `any`.
{
  const map = new Map<string, number>();
  const loose: any = map;
  map.set("NaN", 1).set("0", 2).set("-0", 3).set("undefined", 4).set("null", 5).set("1", 6).set("true", 7);
  loose.set(NaN, 10);
  loose.set(0, 20);
  loose.set(-0, 30);
  loose.set(undefined, 40);
  loose.set(null, 50);
  loose.set(1, 60);
  loose.set(true, 70);
  loose.set(1.5, 80);
  loose.set(10n, 90);
  loose.set(2 ** 40, 100);
  show("mixed", entries(map), map.size);
  show("by text", map.get("NaN"), map.get("0"), map.get("-0"), map.get("undefined"), map.get("null"), map.get("1"), map.get("true"));
  show("by value", loose.get(NaN), loose.get(0 / 0), loose.get(0), loose.get(-0), loose.get(undefined), loose.get(null), loose.get(1), loose.get(1.0), loose.get(true), loose.get(1.5), loose.get(10n), loose.get(BigInt(10)), loose.get(2 ** 40));
  show("has", loose.has(NaN), loose.has(-0), loose.has(2), loose.has("2"), loose.has(false), loose.has(11n));
  show("delete", loose.delete(NaN), loose.delete(NaN), loose.delete(-0), loose.delete(0), map.delete("0"), map.size);
  show("left", entries(map));
}
{
  const map = new Map<string, string>();
  const loose: any = map;
  loose.set(-0, "zero");
  for (const key of loose.keys()) show("minus zero is kept as", key, typeof key);
  const set = new Set<string>();
  (set as any).add(-0);
  (set as any).add(NaN);
  (set as any).add(NaN);
  for (const key of set as any) show("in the set", key, typeof key);
  show("size", set.size, (set as any).has(0), (set as any).has(NaN), set.has("0"), set.has("NaN"));
}
{
  const object = {};
  const symbol = Symbol("key");
  const map = new Map<string, number>([["a", 1], ["b", 2]]);
  const loose: any = map;
  loose.set(object, 3);
  loose.set(symbol, 4);
  loose.set([1], 5);
  show("objects", loose.get(object), loose.get({}), loose.get(symbol), loose.get(Symbol("key")), loose.get([1]), map.get("a"), map.get("[object Object]"), map.get("1"), map.size);
}

// A key that may be undefined or null by its type.
function lookUp(map: Map<string, number>, key: string | undefined | null): number | undefined {
  return map.get(key as string);
}
{
  const map = new Map<string, number>([["undefined", 1], ["null", 2], ["", 3]]);
  show("absent keys", lookUp(map, undefined), lookUp(map, null), lookUp(map, ""), lookUp(map, "undefined"), map.has(undefined as any), map.has(null as any));
  (map as any).set(undefined, 4);
  (map as any).set(null, 5);
  show("present keys", lookUp(map, undefined), lookUp(map, null), lookUp(map, ""), lookUp(map, "null"), map.size);
}

// Values of every kind, and a table that has to change how it keeps them.
{
  const map = new Map<string, unknown>();
  const item = { n: 1 };
  map.set("object", item).set("undefined", undefined).set("null", null).set("true", true).set("false", false);
  show("narrow", map.get("object") === item, map.get("undefined"), map.has("undefined"), map.get("null"), map.get("true"), map.get("false"), map.get("none"), map.has("none"));
  map.set("int", 7).set("double", 1.5).set("minus zero", -0).set("nan", NaN).set("text", "t").set("bigint", 5n).set("symbol", Symbol.iterator).set("big", 2 ** 53);
  show("wide", map.get("object") === item, map.get("undefined"), map.get("null"), map.get("true"), map.get("false"), map.get("int"), map.get("double"), map.get("minus zero"), map.get("nan"), map.get("text"), map.get("bigint"), map.get("symbol"), map.get("big"));
  map.set("object", 0).set("true", "yes");
  show("overwritten", map.get("object"), map.get("true"), [...map.keys()].join());
  const first = new Map<string, unknown>();
  first.set("n", 1);
  first.set("o", item);
  show("a number first", first.get("n"), first.get("o") === item);
}

// Subclasses, own properties, and methods reached in other ways.
class Counting extends Map<string, number> {
  reads = 0;
  override get(key: string): number | undefined {
    this.reads++;
    return super.get(key.toLowerCase());
  }
}
class Plain extends Map<string, number> {}
class Shouting extends Set<string> {
  override has(key: string): boolean {
    return super.has(key.toUpperCase());
  }
  override add(key: string): this {
    return super.add(key.toUpperCase());
  }
}
function read(map: Map<string, number>, key: string): number | undefined {
  return map.get(key);
}
function readInLoop(map: Map<string, number>, keys: string[]): string {
  let out = "";
  for (const key of keys) out += map.get(key) + ",";
  return out;
}
function write(map: Map<string, number>, key: string, value: number): Map<string, number> {
  return map.set(key, value);
}
{
  const plain = new Map<string, number>([["a", 1]]);
  const counting = new Counting([["a", 2]]);
  const derived = new Plain([["a", 3]]);
  const own = new Map<string, number>([["a", 4]]);
  (own as any).get = function (key: string) {
    return key.length;
  };
  const later = new Map<string, number>([["a", 5]]);
  for (const map of [plain, counting, derived, own, later, plain]) show("read", read(map, "a"), read(map, "A"), readInLoop(map, ["a", "A", "b"]));
  show("reads", counting.reads);
  (later as any).extra = 1;
  show("with a property", read(later, "a"), readInLoop(later, ["a"]), write(later, "b", 6) === later, later.size);
  Object.setPrototypeOf(later, Counting.prototype);
  show("with another prototype", read(later, "A"), readInLoop(later, ["A", "B"]));
  const shouting = new Shouting(["a"]);
  const asSet: Set<string> = shouting;
  show("set", asSet.has("a"), asSet.has("A"), [...asSet.add("b")].join());
  show("frozen", read(Object.freeze(new Map<string, number>([["a", 7]])), "a"), write(Object.freeze(new Map<string, number>()), "k", 1).size);
}
{
  const map = new Map<string, number>([["a", 1]]);
  const loose: any = map;
  const get = map.get;
  const name = "get";
  show("other ways", loose.get("a"), loose[name]("a"), get.call(map, "a"), Map.prototype.get.call(map, "a"), Reflect.apply(Map.prototype.get, map, ["a"]), map.get.bind(map)("a"), map["get"]("a"));
  for (const receiver of [new Set(["a"]), {}, null, undefined, "a", new WeakMap(), Object.create(Map.prototype)]) {
    try {
      show("no map", Map.prototype.get.call(receiver as any, "a"));
    } catch (error) {
      show("no map", (error as Error).constructor.name);
    }
    try {
      show("no set", Set.prototype.has.call(receiver as any, "a"));
    } catch (error) {
      show("no set", (error as Error).constructor.name);
    }
  }
  try {
    show("nil", read(null as any, "a"));
  } catch (error) {
    show("nil", (error as Error).constructor.name);
  }
  show("more and fewer arguments", (loose.get as Function)("a", "b"), (loose.get as Function)(), (loose.has as Function)(), (loose.set as Function)("only").get("only"), loose.has("only"), (loose.set as Function)().has(undefined), map.size);
}

// With frozen prototypes. Object.freeze succeeds in a compiled program too: it only tightens what is fixed from the start. Nothing is printed unless it throws.
try {
  Object.freeze(Map.prototype);
} catch (error) {
  show("freeze Map.prototype", (error as Error).constructor.name);
}
try {
  Object.freeze(Set.prototype);
} catch (error) {
  show("freeze Set.prototype", (error as Error).constructor.name);
}
{
  const map = new Map<string, number>();
  for (let i = 0; i < 20; i++) map.set("k" + i, i);
  let total = 0;
  for (let i = 0; i < 25; i++) total += map.get("k" + i) ?? -1;
  show("frozen prototypes", total, map.size, new Set<string>(map.keys()).has("k7"));
}
collect();
//// string-maps-vs-model.ts
// Maps and sets with string keys do what a list of pairs does, through a long random sequence of operations, with keys in every internal representation.
declare const console: { log(...values: unknown[]): void };
const collect: () => void = (globalThis as any).gc ?? (() => (globalThis as any).Bun.gc(true));

let seed = 12345;
function random(below: number): number {
  seed = (Math.imul(seed, 1103515245) + 12345) & 0x7fffffff;
  return (seed >>> 8) % below;
}

class Item {
  constructor(public label: string, public rank: number) {}
}

// The same text each time, as another string each time.
const wide = "Ā";
function flat(text: string): string {
  return text.split("").join("");
}
function rope(text: string): string {
  const at = text.length >> 1;
  return flat(text.slice(0, at)) + flat(text.slice(at));
}
function part(text: string): string {
  return ("<<" + text + ">>").slice(2, 2 + text.length);
}
function partOfWide(text: string): string {
  return (wide + text + wide).slice(1, 1 + text.length);
}
function flatWide(text: string): string {
  return (text + wide).split("").slice(0, -1).join("");
}
function represented(text: string, how: number): string {
  switch (how) {
    case 0: return text;
    case 1: return flat(text);
    case 2: return rope(text);
    case 3: return part(text);
    case 4: return partOfWide(text);
    case 5: return flatWide(text);
    default: return `${text}`;
  }
}

const pool: string[] = [];
for (let i = 0; i < 700; i++) pool.push("k" + i);
for (let length = 0; length < 140; length += length < 20 ? 1 : 7) pool.push("x".repeat(length) + (length % 3 ? "" : "y"));
pool.push("", "a", "b", "0", "1", "-0", "NaN", "undefined", "null", "__proto__", "constructor", "get", "size", "é", "éè", "Ā", "Āā", "😀", "a\u0000b", "a\u0000c");

class Model {
  keys: string[] = [];
  values: Item[] = [];
  find(key: string): number {
    for (let i = 0; i < this.keys.length; i++) if (this.keys[i] === key) return i;
    return -1;
  }
}

let wrong = 0;
let checksum = 0;
function mix(value: number): void {
  checksum = (Math.imul(checksum, 31) + value) | 0;
}
function fail(what: string): void {
  if (wrong++ < 10) console.log("wrong:", what);
}

function compare(map: Map<string, Item>, set: Set<string>, model: Model): void {
  if (map.size !== model.keys.length) fail("size of the map " + map.size + " " + model.keys.length);
  if (set.size !== model.keys.length) fail("size of the set " + set.size + " " + model.keys.length);
  let i = 0;
  for (const [key, value] of map) {
    if (key !== model.keys[i] || value !== model.values[i]) fail("order of the map at " + i);
    i++;
  }
  if (i !== model.keys.length) fail("entries of the map " + i);
  i = 0;
  for (const key of set) {
    if (key !== model.keys[i]) fail("order of the set at " + i);
    i++;
  }
  if (i !== model.keys.length) fail("entries of the set " + i);
}

function run(rounds: number, keysInUse: number, from: number): void {
  const map = new Map<string, Item>();
  const set = new Set<string>();
  const model = new Model();
  for (let round = 0; round < rounds; round++) {
    const text = pool[from + random(keysInUse)]!;
    const key = represented(text, random(7));
    const at = model.find(text);
    const what = random(100);
    if (what < 35) {
      const found = map.get(key);
      if (found !== (at < 0 ? undefined : model.values[at])) fail("get " + JSON.stringify(text));
      mix(found ? found.rank : -1);
    } else if (what < 45) {
      if (map.has(key) !== at >= 0) fail("has " + JSON.stringify(text));
      if (set.has(key) !== at >= 0) fail("has of the set " + JSON.stringify(text));
    } else if (what < 80) {
      const item = new Item(text, round);
      if (map.set(key, item) !== map) fail("set yields the map");
      if (set.add(key) !== set) fail("add yields the set");
      if (at < 0) {
        model.keys.push(text);
        model.values.push(item);
      } else model.values[at] = item;
    } else if (what < 97) {
      if (map.delete(key) !== at >= 0) fail("delete " + JSON.stringify(text));
      if (set.delete(key) !== at >= 0) fail("delete of the set " + JSON.stringify(text));
      if (at >= 0) {
        model.keys.splice(at, 1);
        model.values.splice(at, 1);
      }
    } else if (what < 98 && random(8) === 0) {
      map.clear();
      set.clear();
      model.keys.length = 0;
      model.values.length = 0;
    } else compare(map, set, model);
    if (key.length !== text.length || key !== text) fail("the key is as it was");
    if (round % 5000 === 4999) collect();
  }
  compare(map, set, model);
  mix(map.size);
}

for (const keysInUse of [1, 2, 3, 4, 5, 6, 8, 9, 10, 12, 16, 24, 40, 100, 200, 260, 400, 700]) run(6000, keysInUse, 0);
run(20000, pool.length, 0);
run(20000, pool.length - 700, 700);
console.log("wrong", wrong, "checksum", checksum);
