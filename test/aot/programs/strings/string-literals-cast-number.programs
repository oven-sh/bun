}
const cores: Units[] = [[], unitsOf("x"), unitsOf("ā"), unitsOf("a b"), alphabet, changedAt(alphabet, 12, 0x101)];
const edges: [Units, Units][] = [
  [[], []],
  [[0x20], []],
  [[], [0x20]],
  ...[...whiteSpace, ...notWhiteSpace].map((unit): [Units, Units] => [
    [0x20, unit],
    [unit, 0x0a],
