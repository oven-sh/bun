function starts1(s: string): boolean { return s.startsWith("a") }
function ends1(s: string): boolean { return s.endsWith("a") }
function literal1(): string { return "a" }
function latin1(): string { return "à" }
function wide1(): string { return "Ā" }
function mixed1(): string { return "→" }
function is2(s: string): boolean { return s === "ab" }
function starts2(s: string): boolean { return s.startsWith("ab") }
function ends2(s: string): boolean { return s.endsWith("ab") }
function literal2(): string { return "ab" }
function latin2(): string { return "àá" }
function wide2(): string { return "Āā" }
function mixed2(): string { return "a→" }
function is3(s: string): boolean { return s === "abc" }
function starts3(s: string): boolean { return s.startsWith("abc") }
function ends3(s: string): boolean { return s.endsWith("abc") }
function literal3(): string { return "abc" }
function latin3(): string { return "àáâ" }
function wide3(): string { return "ĀāĂ" }
function mixed3(): string { return "ab→" }
