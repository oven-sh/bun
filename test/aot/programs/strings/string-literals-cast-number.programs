// Literals of every length around the sizes at which the image lists a length apart: compared, searched for at both ends, used as names, in 8 and in 16 bits.
declare const console: { log(...args: unknown[]): void }
function made(n: number): string { let s = ""; for (let i = 0; i < n; i++) s += String.fromCharCode(97 + i % 26); return s }
const flatten = /^$/
function flat(s: string): string { flatten.test(s); return s }
function sum(s: string): number { let t = 0; for (let i = 0; i < s.length; i++) t = (t * 31 + s.charCodeAt(i)) % 1000003; return t }
