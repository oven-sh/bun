  ['n4', /^\u4e2d[\u0400-\u041f\u0460-\u047f\u04c0-\u04df\u0520-\u053f\u0580-\u059f\u05e0-\u05ff\u0640-\u065f\u06a0-\u06bf\u0700-\u071f\u0760-\u077f\u07c0-\u07df\u0820-\u083f\u0880-\u089f\u08e0-\u08ff\u0940-\u095f\u09a0-\u09bf\u0a00-\u0a1f\u0a60-\u0a7f\u0ac0-\u0adf\u0b20-\u0b3f\u0b80-\u0b9f\u0be0-\u0bff\u0c40-\u0c5f\u0ca0-\u0cbf\u0d00-\u0d1f\u0d60-\u0d7f\u0dc0-\u0ddf\u0e20-\u0e3f\u0e80-\u0e9f\u0ee0-\u0eff\u0f40-\u0f5f\u0fa0-\u0fbf\u1000-\u101f\u1060-\u107f\u10c0-\u10df\u1120-\u113f\u1180-\u119f\u11e0-\u11ff\u1240-\u125f\u12a0-\u12bf\u1300-\u131f\u1360-\u137f\u13c0-\u13df\u1420-\u143f\u1480-\u149f\u14e0-\u14ff\u1540-\u155f\u15a0-\u15bf\u1600-\u161f\u1660-\u167f\u16c0-\u16df\u1720-\u173f\u1780-\u179f\u17e0-\u17ff\u1840-\u185f\u18a0-\u18bf\u1900-\u191f\u1960-\u197f\u19c0-\u19df\u1a20-\u1a3f\u1a80-\u1a9f\u1ae0-\u1aff\u1b40-\u1b5f\u1ba0-\u1bbf\u1c00-\u1c1f\u1c60-\u1c7f\u1cc0-\u1cdf\u1d20-\u1d3f\u1d80-\u1d9f\u1de0-\u1dff\u1e40-\u1e5f\u1ea0-\u1ebf\u1f00-\u1f1f\u1f60-\u1f7f\u1fc0-\u1fdf\u2020-\u203f\u2080-\u209f\u20e0-\u20ff\u2140-\u215f\u21a0-\u21bf\u2200-\u221f\u2260-\u227f\u22c0-\u22df\u2320-\u233f\u2380-\u239f\u23e0-\u23ff\u2440-\u245f\u24a0-\u24bf\u2500-\u251f\u2560-\u257f\u25c0-\u25df\u2620-\u263f\u2680-\u269f\u26e0-\u26ff\u2740-\u275f\u27a0-\u27bf\u2800-\u281f\u2860-\u287f\u28c0-\u28df\u2920-\u293f\u2980-\u299f\u29e0-\u29ff\u2a40-\u2a5f\u2aa0-\u2abf\u2b00-\u2b1f\u2b60-\u2b7f\u2bc0-\u2bdf\u2c20-\u2c3f\u2c80-\u2c9f\u2ce0-\u2cff\u2d40-\u2d5f\u2da0-\u2dbf\u2e00-\u2e1f\u2e60-\u2e7f\u2ec0-\u2edf\u2f20-\u2f3f\u2f80-\u2f9f\u2fe0-\u2fff\u3040-\u305f\u30a0-\u30bf\u3100-\u311f\u3160-\u317f\u31c0-\u31df\u3220-\u323f\u3280-\u329f\u32e0-\u32ff\u3340-\u335f\u33a0-\u33bf\u3400-\u341f\u3460-\u347f\u34c0-\u34df\u3520-\u353f\u3580-\u359f\u35e0-\u35ff\u3640-\u365f\u36a0-\u36bf\u3700-\u371f\u3760-\u377f\u37c0-\u37df\u3820-\u383f\u3880-\u389f\u38e0-\u38ff\u3940-\u395f\u39a0-\u39bf\u3a00-\u3a1f\u3a60-\u3a7f\u3ac0-\u3adf\u3b20-\u3b3f\u3b80-\u3b9f\u3be0-\u3bff\u3c40-\u3c5f\u3ca0-\u3cbf\u3d00