u14e0-\u14ff\u1540-\u155f\u15a0-\u15bf\u1600-\u161f\u1660-\u167f\u16c0-\u16df\u1720-\u173f\u1780-\u179f\u17e0-\u17ff\u1840-\u185f\u18a0-\u18bf\u1900-\u191f\u1960-\u197f\u19c0-\u19df\u1a20-\u1a3f\u1a80-\u1a9f\u1ae0-\u1aff\u1b40-\u1b5f\u1ba0-\u1bbf])$/i],
  ['i2', /^\u4e2d[a-z\u0400-\u041f\u0460-\u047f\u04c0-\u04df\u0520-\u053f\u0580-\u059f\u05e0-\u05ff\u0640-\u065f\u06a0-\u06bf\u0700-\u071f]$/i, /^\u4e2d[^a-z\u0400-\u041f\u0460-\u047f\u04c0-\u04df\u0520-\u053f\u0580-\u059f\u05e0-\u05ff\u0640-\u065f\u06a0-\u06bf\u0700-\u071f]$/i, /^\u4e2d[a-z\u0400-\u041f\u0460-\u047f\u04c0-\u04df\u0520-\u053f\u0580-\u059f\u05e0-\u05ff\u0640-\u065f\u06a0-\u06bf\u0700-\u071f]+$/i, /^\u4e2d[a-z\u0400-\u041f\u0460-\u047f\u04c0-\u04df\u0520-\u053f\u0580-\u059f\u05e0-\u05ff\u0640-\u065f\u06a0-\u06bf\u0700-\u071f]+?$/i, /(?<=^\u4e2d[a-z\u0400-\u041f\u0460-\u047f\u04c0-\u04df\u0520-\u053f\u0580-\u059f\u05e0-\u05ff\u0640-\u065f\u06a0-\u06bf\u0700-\u071f])$/i],
  ['i3', /^\u4e2d[\u0400-\u042f\u0391-\u03a9\u1000-\u101f\u1060-\u107f\u10c0-\u10df\u1120-\u113f\u1180-\u119f\u11e0-\u11ff\u1240-\u125f\u12a0-\u12bf\u1300-\u131f]$/i, /^\u4e2d[^\u0400-\u042f\u0391-\u03a9\u1000-\u101f\u1060-\u107f\u10c0-\u10df\u1120-\u113f\u1180-\u119f\u11e0-\u11ff\u1240-\u125f\u12a0-\u12bf\u1300-\u131f]$/i, /^\u4e2d[\u0400-\u042f\u0391-\u03a9\u1000-\u101f\u1060-\u107f\u10c0-\u10df\u1120-\u113f\u1180-\u119f\u11e0-\u11ff\u1240-\u125f\u12a0-\u12bf\u1300-\u131f]+$/i, /^\u4e2d[\u0400-\u042f\u0391-\u03a9\u1000-\u101f\u1060-\u107f\u10c0-\u10df\u1120-\u113f\u1180-\u119f\u11e0-\u11ff\u1240-\u125f\u12a0-\u12bf\u1300-\u131f]+?$/i, /(?<=^\u4e2d[\u0400-\u042f\u0391-\u03a9\u1000-\u101f\u1060-\u107f\u10c0-\u10df\u1120-\u113f\u1180-\u119f\u11e0-\u11ff\u1240-\u125f\u12a0-\u12bf\u1300-\u131f])$/i],
  ['i4', /^\u4e2d[\w\u0400-\u041f\u0460-\u047f\u04c0-\u04df\u0520-\u053f\u0580-\u059f\u05e0-\u05ff\u0640-\u065f\u06a0-\u06bf\u0700-\u071f]$/i, /^\u4e2d[^\w\u0400-\u041f\u0460-\u047f\u04c0-\u04df\u0520-\u053f\u0580-\u059f\u05e0-\u05ff\u0640-\u065f\u06a0-\u06bf\u0700-\u071f]$/i, /^\u4e2d[\w\u0400-\u041f\u0460-\u047f\u04c0-\u04df\u0520-\u053f\u0580-\u059f\u05e0-\u05ff\u0640-\u065f\u06a0-\u06bf\u0700-\u071f]+$/i, /^\u4e2d[\w\u0400-\u041f\u0460-\u047f\u04c0-\u04df\u0520-\u053f\u0580-\u059f\u05e0-\u05ff\u0640-\u065f\u06a0-\u06bf\u0700-\u071f]+?$/i, /(?<=^\u4e2d[\w\u0400-\u041f\u0460-\u047f\u04c0-\u04df\u0520-\u053f\u0580-\u059f\u05e0-\u05ff\u0640-\u065f\u06a0-\u06bf\u0700-\u071f])$/i],
  ['i5', /^\u4e2d[\W]$/i, /^\u4e2d[^\W]$/i, /^\u4e2d[\W]+$/i, /^\u4e2d[\W]+?$/i, /(?<=^\u4e2d[\W])$/i],
]
const points: number[] = []
for (let block = 0; block < 0x1100; block++) for (const low of [0, 1, 31, 32, 33, 254, 255]) points.push(block * 256 + low)
for (const [from, to] of [[0, 0x2ff], [0x3000, 0x30ff], [0xd7f0, 0xe010], [0xdbf0, 0xdc10], [0xfff0, 0x1000f], [0x1f300, 0x1f6ff], [0x2fa00, 0x2fb00], [0x323a0, 0x323c0], [0xe0000, 0xe01ff], [0xfff00, 0x100100], [0x10fff0, 0x10ffff]]) for (let c = from; c <= to; c++) points.push(c)
const one: string[] = [], two: string[] = []
for (const c of points) { const s = String.fromCodePoint(c); one.push("\u4e2d" + s); two.push("\u4e2d" + s + s) }
for (const row of rows) {
  const line: (string | number)[] = [row[0]]
  for (let shape = 1; shape <= 5; shape++) {
    const re = row[shape] as RegExp; let n = 0, h = 0
    const step = shape <= 2 ? 1 : 8, subjects = shape === 3 || shape === 4 ? two : one
    for (let i = 0; i < points.length; i += step) if (re.test(subjects[i])) { n++; h = (Math.imul(h, 31) + points[i]) | 0 }
    line.push(n, h)
  }
  console.log(line.join(" "))
}
console.log("points", points.length, "classes", rows.length)
//// unicode-property-classes-at-block-edges-untyped.js
// Unicode property classes such as `\p{L}` under the `u` flag, tested at the edges of every block of code points (the same program without type annotations).
const rows = [
  ["u0", /^\u4e2d[\p{L}]$/u, /^\u4e2d[^\p{L}]$/u, /^\u4e2d[\p{L}]+$/u, /^\u4e2d[\p{L}]+?$/u, /(?<=^\u4e2d[\p{L}])$/u],
  ["u1", /^\u4e2d[\p{Lu}]$/u, /^\u4e2d[^\p{Lu}]$/u, /^\u4e2d[\p{Lu}]+$/u, /^\u4e2d[\p{Lu}]+?$/u, /(?<=^\u4e2d[\p{Lu}])$/u],
  ["u2", /^\u4e2d[\p{Ll}]$/u, /^\u4e2d[^\p{Ll}]$/u, /^\u4e2d[\p{Ll}]+$/u, /^\u4e2d[\p{Ll}]+?$/u, /(?<=^\u4e2d[\p{Ll}])$/u],
  ["u3", /^\u4e2d[\p{N}]$/u, /^\u4e2d[^\p{N}]$/u, /^\u4e2d[\p{N}]+$/u, /^\u4e2d[\p{N}]+?$/u, /(?<=^\u4e2d[\p{N}])$/u],
  ["u4", /^\u4e2d[\p{M}]$/u, /^\u4e2d[^\p{M}]$/u, /^\u4e2d[\p{M}]+$/u, /^\u4e2d[\p{M}]+?$/u, /(?<=^\u4e2d[\p{M}])$/u],
  ["u5", /^\u4e2d[\p{P}]$/u, /^\u4e2d[^\p{P}]$/u, /^\u4e2d[\p{P}]+$/u, /^\u4e2d[\p{P}]+?$/u, /(?<=^\u4e2d[\p{P}])$/u],
  ["u6", /^\u4e2d[\p{S}]$/u, /^\u4e2d[^\p{S}]$/u, /^\u4e2d[\p{S}]+$/u, /^\u4e2d[\p{S}]+?$/u, /(?<=^\u4e2d[\p{S}])$/u],
  ["u7", /^\u4e2d[\p{Z}]$/u, /^\u4e2d[^\p{Z}]$/u, /^\u4e2d[\p{Z}]+$/u, /^\u4e2d[\p{Z}]+?$/u, /(?<=^\u4e2d[\p{Z}])$/u],
  ["u8", /^\u4e2d[\p{Cf}]$/u, /^\u4e2d[^\p{Cf}]$/u, /^\u4e2d[\p{Cf}]+$/u, /^\u4e2d[\p{Cf}]+?$/u, /(?<=^\u4e2d[\p{Cf}])$/u],
  ["u9", /^\u4e2d[\p{Co}]$/u, /^\u4e2d[^\p{Co}]$/u, /^\u4e2d[\p{Co}]+$/u, /^\u4e2d[\p{Co}]+?$/u, /(?<=^\u4e2d[\p{Co}])$/u],
  ["u10", /^\u4e2d[\p{Cn}]$/u, /^\u4e2d[^\p{Cn}]$/u, /^\u4e2d[\p{Cn}]+$/u, /^\u4e2d[\p{Cn}]+?$/u, /(?<=^\u4e2d[\p{Cn}])$/u],
  ["u11", /^\u4e2d[\p{Cs}]$/u, /^\u4e2d[^\p{Cs}]$/u, /^\u4e2d[\p{Cs}]+$/u, /^\u4e2d[\p{Cs}]+?$/u, /(?<=^\u4e2d[\p{Cs}])$/u],
  ["u12", /^\u4e2d[\p{Script=Han}]$/u, /^\u4e2d[^\p{Script=Han}]$/u, /^\u4e2d[\p{Script=Han}]+$/u, /^\u4e2d[\p{Script=Han}]+?$/u, /(?<=^\u4e2d[\p{Script=Han}])$/u],
  ["u13", /^\u4e2d[\p{Script=Cyrillic}]$/u, /^\u4e2d[^\p{Script=Cyrillic}]$/u, /^\u4e2d[\p{Script=Cyrillic}]+$/u, /^\u4e2d[\p{Script=Cyrillic}]+?$/u, /(?<=^\u4e2d[\p{Script=Cyrillic}])$/u],
  ["u14", /^\u4e2d[\p{Script=Greek}]$/u, /^\u4e2d[^\p{Script=Greek}]$/u, /^\u4e2d[\p{Script=Greek}]+$/u, /^\u4e2d[\p{Script=Greek}]+?$/u, /(?<=^\u4e2d[\p{Script=Greek}])$/u],
  ["u15", /^\u4e2d[\p{Script_Extensions=Latin}]$/u, /^\u4e2d[^\p{Script_Extensions=Latin}]$/u, /^\u4e2d[\p{Script_Extensions=Latin}]+$/u, /^\u4e2d[\p{Script_Extensions=Latin}]+?$/u, /(?<=^\u4e2d[\p{Script_Extensions=Latin}])$/u],
  ["u16", /^\u4e2d[\p{Extended_Pictographic}]$/u, /^\u4e2d[^\p{Extended_Pictographic}]$/u, /^\u4e2d[\p{Extended_Pictographic}]+$/u, /^\u4e2d[\p{Extended_Pictographic}]+?$/u, /(?<=^\u4e2d[\p{Extended_Pictographic}])$/u],
  ["u17", /^\u4e2d[\p{Emoji}]$/u, /^\u4e2d[^\p{Emoji}]$/u, /^\u4e2d[\p{Emoji}]+$/u, /^\u4e2d[\p{Emoji}]+?$/u, /(?<=^\u4e2d[\p{Emoji}])$/u],
  ["u18", /^\u4e2d[\p{ID_Start}]$/u, /^\u4e2d[^\p{ID_Start}]$/u, /^\u4e2d[\p{ID_Start}]+$/u, /^\u4e2d[\p{ID_Start}]+?$/u, /(?<=^\u4e2d[\p{ID_Start}])$/u],
  ["u19", /^\u4e2d[\p{ID_Continue}]$/u, /^\u4e2d[^\p{ID_Continue}]$/u, /^\u4e2d[\p{ID_Continue}]+$/u, /^\u4e2d[\p{ID_Continue}]+?$/u, /(?<=^\u4e2d[\p{ID_Continue}])$/u],
  ["u20", /^\u4e2d[\p{Alphabetic}]$/u, /^\u4e2d[^\p{Alphabetic}]$/u, /^\u4e2d[\p{Alphabetic}]+$/u, /^\u4e2d[\p{Alphabetic}]+?$/u, /(?<=^\u4e2d[\p{Alphabetic}])$/u],
  ["u21", /^\u4e2d[\p{White_Space}]$/u, /^\u4e2d[^\p{White_Space}]$/u, /^\u4e2d[\p{White_Space}]+$/u, /^\u4e2d[\p{White_Space}]+?$/u, /(?<=^\u4e2d[\p{White_Space}])$/u],
  ["u22", /^\u4e2d[\P{L}]$/u, /^\u4e2d[^\P{L}]$/u, /^\u4e2d[\P{L}]+$/u, /^\u4e2d[\P{L}]+?$/u, /(?<=^\u4e2d[\P{L}])$/u],
  ["u23", /^\u4e2d[\P{Cn}]$/u, /^\u4e2d[^\P{Cn}]$/u, /^\u4e2d[\P{Cn}]+$/u, /^\u4e2d[\P{Cn}]+?$/u, /(?<=^\u4e2d[\P{Cn}])$/u],
  ["u24", /^\u4e2d[\P{ASCII}]$/u, /^\u4e2d[^\P{ASCII}]$/u, /^\u4e2d[\P{ASCII}]+$/u, /^\u4e2d[\P{ASCII}]+?$/u, /(?<=^\u4e2d[\P{ASCII}])$/u],
