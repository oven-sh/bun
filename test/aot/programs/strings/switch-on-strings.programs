  long.slice(0, 5), long.slice(5, 10), long.slice(10, 21), long.slice(21), ("alpha紅").slice(0, 5), "alphā", undefined, null, 0, 1.5, NaN, true, false,
  Symbol("alpha"), 10n, { toString() { return "alpha"; } }, ["alpha"], new String("alpha"), function alpha() {},
];
