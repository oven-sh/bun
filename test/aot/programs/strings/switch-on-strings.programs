  ['n3', /^\u4e2d[\u0400-\u041f\u0460-\u047f\u04c0-\u04df\u0520-\u053f\u0580-\u059f\u05e0-\u05ff\u0640-\u065f\u06a0-\u06bf\u0700-\u071f\u0760-\u077f\u07c0-\u07df\u0820-\u083f\u0880-\u089f\u08e0-\u08ff\u0940-\u095f\u09a0-\u09bf\u0a00-\u0a1f\u0a60-\u0a7f\u0ac0-\u0adf\u0b20-\u0b3f\u0b80-\u0b9f\u0be0-\u0bff\u0c40-\u0c5f\u0ca0-\u0cbf\u0d00-\u0d1f\u0d60-\u0d7f\u0dc0-\u0ddf\u0e20-\u0e3f\u0e80-\u0e9f\u0ee0-\u0eff\u0f40-\u0f5f\u0fa0-\u0fbf\u1000-\u101f\u1060-\u107f\u10c0-\u10df\u1120-\u113f\u1180-\u119f\u11e0-\u11ff\u1240-\u125f\u12a0-\u12bf\u1300-\u131f\u1360-\u137f\u13c0-\u13df\u1420-\u143f\u1480-\u149f\u14e0-\u14ff\u1540-\u155f\u15a0-\u15bf\u1600-\u161f\u1660-\u167f\u16c0-\u16df\u1720-\u173f\u1780-\u179f\u17e0-\u17ff\u1840-\u185f\u18a0-\u18bf\u1900-\u191f\u1960-\u197f\u19c0-\u19df\u1a20-\u1a3f\u1a80-\u1a9f\u1ae0-\u1aff\u1b40-\u1b5f\u1ba0-\u1bbf]$/, /^\u4e2d[^\u0400-\u041f\u0460-\u047f\u04c0-\u04df\u0520-\u053f\u0580-\u059f\u05e0-\u05ff\u0640-\u065f\u06a0-\u06bf\u0700-\u071f\u0760-\u077f\u07c0-\u07df\u0820-\u083f\u0880-\u089f\u08e0-\u08ff\u0940-\u095f\u09a0-\u09bf\u0a00-\u0a1f\u0a60-\u0a7f\u0ac0-\u0adf\u0b20-\u0b3f\u0b80-\u0b9f\u0be0-\u0bff\u0c40-\u0c5f\u0ca0-\u0cbf\u0d00-\u0d1f\u0d60-\u0d7f\u0dc0-\u0ddf\u0e20-\u0e3f\u0e80-\u0e9f\u0ee0-\u0eff\u0f40-\u0f5f\u0fa0-\u0fbf\u1000-\u101f\u1060-\u107f\u10c0-\u10df\u1120-\u113f\u1180-\u119f\u11e0-\u11ff\u1240-\u125f\u12a0-\u12bf\u1300-\u131f\u1360-\u137f\u13c0-\u13df\u1420-\u143f\u1480-\u149f\u14e0-\u14ff\u1540-\u155f\u15a0-\u15bf\u1600-\u161f\u1660-\u167f\u16c0-\u16df\u1720-\u173f\u1780-\u179f\u17e0-\u17ff\u1840-\u185f\u18a0-\u18bf\u1900-\u191f\u1960-\u197f\u19c0-\u19df\u1a20-\u1a3f\u1a80-\u1a9f\u1ae0-\u1aff\u1b40-\u1b5f\u1ba0-\u1bbf]$/, /^\u4e2d[\u0400-\u041f\u0460-\u047f\u04c0-\u04df\u0520-\u053f\u0580-\u059f\u05e0-\u05ff\u0640-\u065f\u06a0-\u06bf\u0700-\u071f\u0760-\u077f\u07c0-\u07df\u0820-\u083f\u0880-\u089f\u08e0-\u08ff\u0940-\u095f\u09a0-\u09bf\u0a00-\u0a1f\u0a60-\u0a7f\u0ac0-\u0adf\u0b20-\u0b3f\u0b80-\u0b9f\u0be0-\u0bff\u0