//// whole-numbers-become-text.ts
const hidden = new Function("v", "return v") as <V>(v: V) => V;

function byTemplate(x: number): string { return `${x}`; }
function byPlus(x: number): string { return x + ""; }
function byString(x: number): string { return String(x); }
function byMethod(x: number): string { return x.toString(); }
function keyOf(a: number, b: number): string { return a / 2 + "," + b * 0.5; }
function half(x: number): number { return x / 2; }

const numbers = [0, -0, 1, -1, 2, 9, 10, 99, 255, 256, 1000, 65535, 123456789, 2 ** 31 - 1, 2 ** 31, -(2 ** 31), -(2 ** 31) - 1, 2 ** 32, 2 ** 53, -(2 ** 53), 0.5, -0.5, 1.5, 1e21, 1e-7, 123456.789, NaN, Infinity, -Infinity, Number.MAX_VALUE, Number.MIN_VALUE, 4294967295.5];
let digest = 0;
function note(text: string): void {
  for (let i = 0; i < text.length; i++) digest = (digest * 31 + text.charCodeAt(i)) | 0;
}
const rounds = Number(process.argv[2] ?? 20);
for (let round = 0; round < rounds; round++) {
  for (const n of numbers) {
    const x = hidden(n), doubled = hidden(n * 2);
    note(byTemplate(half(doubled))); note(byPlus(half(doubled))); note(byString(half(doubled))); note(byMethod(half(doubled)));
    note(keyOf(doubled, x * 2 + round * 2));
  }
  for (let i = 0; i < 300; i++) note(byTemplate(half(hidden(i * 2 + round * 600))));
}
// A module's top level runs once: there a conversion has its short form.
const a = hidden(84) / 2, b = hidden(-0) / 2, c = hidden(1) / 2, d = hidden(2 ** 32) / 2, e = hidden(-(2 ** 32)) / 2, f = hidden(NaN) / 2, g = hidden(2 ** 33) / 2;
console.log(digest, `${a}`, `${b}`, `${c}`, `${d}`, `${e}`, `${f}`, `${g}`, a + "", String(b), d.toString(), numbers.map(byTemplate).join(" "));
//// whole-numbers-kept-as-doubles-print-as-integers.ts
// A number that is whole may be kept as a double: the result of a division, a product, Math.floor, a field declared `number`. Every way of printing it gives the digits of the integer: JSON.stringify with and without indentation, replacer and toJSON, String, a template, concatenation, join, a property key. Negative zero, the ends of the 32-bit range and what lies just outside them print as the language says
function half(x: number): number {
  return x / 2;
}
interface Row { id: number; size: number; ratio: number; tags: number[] }
function makeRow(i: number): Row {
  return { id: half(i * 2), size: Math.floor(i * 1.5) * 2, ratio: i / 4, tags: [half(i * 4), i * 0.5, half(i)] };
}

const lines: string[] = [];
const values: number[] = [
  half(6), half(-6), half(0), -half(0), half(1), half(4294967294), half(4294967296), half(-4294967296), half(-4294967298), half(2 ** 53), 1e21, half(2e21), 1e-7, 0.1 + 0.2, half(200) / 100,
  NaN, Infinity, -Infinity, Math.floor(7.9), Math.round(-7.5), Math.sqrt(81), 2 ** 10, 5 % 3, 10 * 0.1,
];
for (const value of values) {
  const holder: Record<string, number> = {};
  holder[value as unknown as string] = 1;
  lines.push(
    [String(value), `${value}`, value + "", [value].join(), [value, value].join("|"), value.toString(), JSON.stringify(value), JSON.stringify([value]), JSON.stringify({ v: value }), JSON.stringify({ v: value }, null, 1).replace(/\s+/g, " "),
      JSON.stringify({ v: value }, (key, inner) => inner), Object.keys(holder)[0], Object.is(value, -0) ? "negative zero" : "-"].join(" ; "),
  );
}

const rows: Row[] = [];
for (let i = 0; i < 40; i++) rows.push(makeRow(i));
lines.push(JSON.stringify(rows));
lines.push(JSON.stringify(rows.slice(0, 3), null, 2));
lines.push(JSON.stringify({ toJSON() { return half(84); } }));
lines.push(JSON.stringify(new Map([[half(2), half(4)]]).get(1)));
lines.push(JSON.stringify(Float64Array.of(half(2), half(3), -half(0))));
lines.push(JSON.stringify({ wide: "☃", n: half(10), list: [half(12), "☃", half(13)] }));
let sum = "";
for (let i = 0; i < 300; i++) sum += half(i * 2) + ",";
lines.push(sum);

console.log(lines.join("\n"));
//// whole-numbers-made-the-keys-of-maps.ts
// Whole numbers, most of them held as doubles, are made the keys of a Map on four roads: by a helper and in place, from a double and from an int32.
// Each road has 5,000 numbers of its own and asks for their texts 80,000 | 40,000 | 20,000 | 10,000 times. whole-numbers-made-keys-avoid-runtime.test.ts counts what that asks of the run time.
class Thing {
  id: number;
  constructor(id: number) {
    this.id = id;
  }
}
function make(first: number): Thing[] {
  const list: Thing[] = [];
  let next = first + 0.5;
  for (let i = 0; i < 5000; i++) {
    list.push(new Thing(next - 0.5));
    next += 1;
  }
  return list;
}
function textOfDouble(thing: Thing): string {
  return "" + thing.id;
}
function textOfInteger(thing: Thing): string {
  return "" + (thing.id | 0);
}
////= lines-32	helperWithDouble	textOfDouble
////= lines-32	helperWithInteger	textOfInteger
function inPlaceWithDouble(list: Thing[], rounds: number): number {
  const map = new Map<string, number>();
  for (const thing of list) map.set("" + thing.id, thing.id);
  let sum = 0;
  for (let r = 1; r < rounds; r++) for (const thing of list) sum += map.get("" + thing.id)!;
  return sum;
}
function inPlaceWithInteger(list: Thing[], rounds: number): number {
  const map = new Map<string, number>();
  for (const thing of list) map.set("" + (thing.id | 0), thing.id);
  let sum = 0;
  for (let r = 1; r < rounds; r++) for (const thing of list) sum += map.get("" + (thing.id | 0))!;
  return sum;
}
console.log(helperWithDouble(make(2000), 16), helperWithInteger(make(12000), 8), inPlaceWithDouble(make(22000), 4), inPlaceWithInteger(make(32000), 2));
//// workers-use-the-names-and-texts-of-the-program-for-the-first-time-at-once.ts
// Six Workers and the main thread use the same few hundred names and texts of the program for the first time, all at once: as property names by code that knows nothing of the object, as keys that are
// put together at run time, as constants, as names that reflection hands out. Whatever the run time makes of a name or a text at its first use, every thread has to find it whole, and the same.
import { isMainThread, parentPort, Worker } from "node:worker_threads";

const hide = (v: unknown): any => new CustomEvent("x", { detail: v }).detail;
function record() {
  return {
    alder: 1, birch: 2, cedar: 3, dogwood: 4, elm: 5, fir: 6, ginkgo: 7, hazel: 8, ironwood: 9, juniper: 10, katsura: 11, larch: 12, maple: 13, nutmeg: 14, oak: 15, pine: 16,
    quince: 17, redwood: 18, spruce: 19, tamarack: 20, umbrellaPine: 21, viburnum: 22, walnut: 23, xylosma: 24, yew: 25, zelkova: 26, "a name with spaces": 27, "naïve": 28, "αβγ": 29, "": 30,
  };
}
class Grove { ash = "ash tree"; beech = "beech tree"; chestnut = "chestnut tree"; #hidden = "hidden tree"; static kind = "grove"; get hidden() { return this.#hidden; } [Symbol.toPrimitive]() { return "a grove"; } }
const mark = Symbol("mark"), shared = Symbol.for("shared mark");

function work(): string {
  const out: string[] = [];
  const o = hide(record());
  let sum = 0;
  for (const key of Object.keys(o)) sum += o[key];
  out.push("sum " + sum, Object.keys(o).join("|"));
  // Names put together at run time are the names of the program.
  const parts = [["al", "der"], ["bir", "ch"], ["ce", "dar"], ["umbrella", "Pine"], ["a name", " with spaces"], ["na", "ïve"], ["α", "βγ"], ["", ""], ["no", "such name"]];
  out.push(parts.map(([a, b]) => String(o[hide(a) + hide(b)])).join());
  out.push(o.alder + o.zelkova + o.maple + o.quince + "", String("oak" in o), String("teak" in o), String(Object.hasOwn(o, "pine")), String(o.hasOwnProperty("willow")));
  o.willow = 31; o["sweet" + hide("gum")] = 32; delete o.birch;
  out.push(JSON.stringify(o).length + "", Object.getOwnPropertyNames(o).slice(-3).join());
  const g = hide(new Grove());
  out.push(g.ash, g.beech, g.chestnut, g.hidden, `${g}`, Grove.kind, Grove.name, Object.keys(g).join(), work.name, record.name);
  g[mark] = "marked"; g[shared] = "shared";
  out.push(g[mark], g[Symbol.for("shared mark")], String(mark.description), Object.getOwnPropertySymbols(g).map(s => String(s)).join());
  // Texts as values: compared, looked for, switched on, used as keys of a Map.
  const texts = ["ash tree", "beech tree", "chestnut tree", "hidden tree", "grove", "a grove", "marked", "shared", "never said"];
  const seen = new Map<string, number>();
  for (const t of texts) for (const v of [g.ash, g.beech, g.chestnut, g.hidden, Grove.kind]) if (hide(t) === v) seen.set(t, (seen.get(t) ?? 0) + 1);
  out.push([...seen].join(";"));
  const kinds = texts.map(t => { switch (hide(t)) { case "ash tree": return 1; case "beech tree": return 2; case "grove": return 3; case "marked": return 4; default: return 0; } });
  out.push(kinds.join());
  try { hide(null).alder; } catch (e) { out.push((e as Error).name); }
  try { hide(undefined).zelkova(); } catch (e) { out.push((e as Error).name); }
  return out.join("\n");
}

if (isMainThread) {
  const answers: Promise<string>[] = [];
  for (let i = 0; i < 6; i++) {
    const worker = new Worker(new URL(import.meta.url));
    answers.push(new Promise(resolve => worker.once("message", resolve)));
  }
  const mine = work();
  const theirs = await Promise.all(answers);
  console.log(mine);
  console.log("workers agree", theirs.map(t => t === mine).join());
} else parentPort!.postMessage(work());
