  /\ud83d/u, /\ude00/u, /\u{1F600}/u, /\u{1F600}+/u, /\u{10ffff}$/u, /\S\s/u, /\s\S/u, /(.)\1/u, /(\p{L})\1/u, /(?:.\p{L})+/u, /^(?:\p{L}|\p{So})*$/u,
  /\p{Extended_Pictographic}/u, /\p{Cs}/u, /\P{Cs}/u, /\w|\W/u, /\W\w/u, /\b./u, /.\B/u, /Я/iu, /[а-я]+/iu, /[^а-я]/iu, /\u{10000}|中/u, /(?=.)\p{L}/u, /(?!\p{L})./u,
  /(?<=.)\p{L}/u, /(?<!\p{L})./u, /(?<=\u{1F600})./u, /[\p{L}--[a-z]]/v, /[\p{L}&&\p{Script=Cyrillic}]/v, /^\p{RGI_Emoji}$/v,
