  ["n8", /^\u4e2d[\u04ff-\u04ff\u05ff-\u05ff\u06ff-\u06ff\u07ff-\u07ff\u08ff-\u08ff\u09ff-\u09ff\u0aff-\u0aff\u0bff-\u0bff\u0cff-\u0cff\u0dff-\u0dff\u0eff-\u0eff\u0fff-\u0fff\u10ff-\u10ff\u11ff-\u11ff\u12ff-\u12ff\u13ff-\u13ff\u14ff-\u14ff\u15ff-\u15ff\u16ff-\u16ff\u17ff-\u17ff\u18ff-\u18ff\u19ff-\u19ff\u1aff-\u1aff\u1bff-\u1bff\u1cff-\u1cff\u1dff-\u1dff\u1eff-\u1eff\u1fff-\u1fff\u20ff-\u20ff\u21ff-\u21ff\u22ff-\u22ff\u23ff-\u23ff\u24ff-\u24ff\u25ff-\u25ff\u26ff-\u26ff\u27ff-\u27ff\u28ff-\u28ff\u29ff-\u29ff\u2aff-\u2aff\u2bff-\u2bff\u2cff-\u2cff\u2dff-\u2dff\u2eff-\u2eff\u2fff-\u2fff\u30ff-\u30ff\u31ff-\u31ff\u32ff-\u32ff\u33ff-\u33ff\u34ff-\u34ff\u35ff-\u35ff\u36ff-\u36ff\u37ff-\u37ff\u38ff-\u38ff\u39ff-\u39ff\u3aff-\u3aff\u3bff-\u3bff\u3cff-\u3cff\u3dff-\u3dff\u3eff-\u3eff\u3fff-\u3fff\u40ff-\u40ff\u41ff-\u41ff\u42ff-\u42ff\u43ff-\u43ff\u44ff-\u44ff\u45ff-\u45ff\u46ff-\u46ff\u47ff-\u47ff\u48ff-\u48ff\u49ff-\u49ff\u4aff-\u4aff\u4bff-\u4bff\u4cff-\u4cff\u4dff-\u4dff\u4eff-\u4eff\u4fff-\u4fff\u50ff-\u50ff\u51ff-\u51ff\u52ff-\u52ff\u53ff-\u53ff\u54ff-\u54ff\u55ff-\u55ff\u56ff-\u56ff\u57ff-\u57ff\u58ff-\u58ff\u59ff-\u59ff\u5aff-\u5aff\u5bff-\u5bff\u5cff-\u5cff\u5dff-\u5dff\u5eff-\u5eff\u5fff-\u5fff\u60ff-\u60ff\u61ff-\u61ff\u62ff-\u62ff\u63ff-\u63ff\u64ff-\u64ff\u65ff-\u65ff\u66ff-\u66ff\u67ff-\u67ff\u68ff-\u68ff\u69ff-\u69ff\u6aff-\u6aff\u6bff-\u6bff\u6cff-\u6cff\u6dff-\u6dff\u6eff-\u6eff\u6fff-\u6fff\u70ff-\u70ff\u71ff-\u71ff\u72ff-\u72ff\u73ff-\u73ff\u74ff-\u74ff\u75ff-\u75ff\u76ff-\u76ff\u77ff-\u77ff\u78ff-\u78ff\u79ff-\u79ff\u7aff-\u7aff\u7bff-\u7bff\u7cff-\u7cff\u7dff-\u7dff\u7eff-\u7eff\u7fff-\u7fff\u80ff-\u80ff\u81ff-\u81ff\u82ff-\u82ff\u83ff-\u83ff\u84ff-\u84ff\u85ff-\u85ff\u86ff-\u86ff\u87ff-\u87ff\u88ff-\u88ff\u89ff-\u89ff\u8aff-\u8aff\u8bff-\u8bff\u8cff-\u8cff\u8dff-\u8dff\u8eff-\u8eff\u8fff-\u8fff\u90ff-\u90ff\u91ff-\u91ff\u92ff-\u92ff\u93ff-\u93ff\u94ff-\u94ff\u95ff-\u95ff\u96ff-\u96ff\u97ff-\u97ff\u98ff-\u98ff\u99ff-\u99ff\u9aff-\u9aff\u9bff-\u9bff\u9cff