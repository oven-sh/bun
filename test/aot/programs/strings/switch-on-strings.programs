  h = mix(h, s.replace(/\p{L}/gu, "<$&>").length);
  h = mix(h, s.split(/(?:)/u).length);
  h = mix(h, s.search(/\p{So}/u) + 1);
  h = mix(h, s.replace(/[^\p{L}]+/gu, "").length);
}
