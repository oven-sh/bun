function «1»(list: Thing[], rounds: number): number {
  const map = new Map<string, number>();
  for (const thing of list) map.set(«2»(thing), thing.id);
  let sum = 0;
  for (let r = 1; r < rounds; r++) for (const thing of list) sum += map.get(«2»(thing))!;
  return sum;
}
