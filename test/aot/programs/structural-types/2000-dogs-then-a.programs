class OtherKinds {
  count: string = "many";
  label: number = 5;
}

const s = new Subject();

////= lines-81	readOn	receiver	object	number	s.readCount.call	receiver
////= lines-81	plusOneOn	receiver	object	number	s.countPlusOne.call	receiver
////= lines-81	lengthOn	receiver	object	number	s.labelLength.call	receiver
////= lines-81	actOn	receiver	object	number	s.runAction.call	receiver
////= lines-81	bumpOn	receiver	object	number	s.bump.call	receiver
////= lines-81	secretOn	receiver	object	number	s.readSecret.call	receiver

const honest: Subject[] = [];
for (let i = 0; i < 10; i++) honest.push(new Subject());
let total = 0;
for (let i = 0; i < 2000; i++) {
  const receiver = honest[i % 10];
  total += readOn(receiver) + plusOneOn(receiver) + lengthOn(receiver) + actOn(receiver) + secretOn(receiver);
  bumpOn(receiver);
}
show("2000 honest receivers", () => total);

const others: [string, object][] = [
  ["reordered", new Reordered()],
  ["fewer", new Fewer()],
  ["other kinds", new OtherKinds()],
  ["a literal", { count: 3000, label: "literal" }],
  ["an array", [1, 2]],
  ["honest again", new Subject()],
];
for (const [name, receiver] of others) {
  show(name + " read", () => readOn(receiver));
  show(name + " plus one", () => plusOneOn(receiver));
  show(name + " length", () => lengthOn(receiver));
  show(name + " act", () => actOn(receiver));
  show(name + " bump", () => bumpOn(receiver));
  show(name + " secret", () => secretOn(receiver));
  show(name + " read after the bump", () => readOn(receiver));
}

const mixed: object[] = [];
for (let i = 0; i < 2000; i++) mixed.push(i === 1500 ? new Reordered() : i === 1700 ? new OtherKinds() : honest[i % 10]);
let sum = 0;
let strange = "";
for (let i = 0; i < mixed.length; i++) {
  const n = readOn(mixed[i]);
  if (typeof n === "number") sum += n;
  else strange += i + ":" + typeof n + " ";
}
show("two strangers in the middle of a loop: sum", () => sum);
show("two strangers in the middle of a loop: strange", () => strange);
//// a-base-constructor-calls-a-function-typed-field-of-the-subclass.ts
////= text-12

const log: string[] = [];

class Base {
  constructor() {
    try {
      this.start();
    } catch (error) {
      log.push("start threw " + (error instanceof Error ? error.constructor.name : typeof error));
    }
  }
  start(): void {
    log.push("base start");
  }
}

class Arrow extends Base {
  count: number = 1;
  handler: () => number = () => this.count;
  start(): void {
    log.push("typeof handler " + typeof this.handler);
    log.push("handler() " + this.handler());
  }
}

class ArrowOverMethod extends Base {
  start = (): void => {
    log.push("the arrow in the field ran");
  };
}

class Bound extends Base {
  count: number = 2;
  read = this.plainRead.bind(this);
  plainRead(): number {
    return this.count;
  }
  start(): void {
    log.push("plainRead() " + this.plainRead());
    log.push("typeof read " + typeof this.read);
    log.push("read() " + this.read());
  }
}

class Listeners extends Base {
  listeners: (() => string)[] = [() => "one"];
  start(): void {
    log.push("typeof listeners " + typeof this.listeners);
    for (const listener of this.listeners) log.push(listener());
  }
}

class Kept extends Base {
  value: number = 3;
  early: (() => number) | undefined;
  start(): void {
    saved = () => this.value;
    log.push("saved() early " + saved());
  }
}
let saved: () => number = () => -1;

function flush(title: string): void {
  for (const entry of log) console.log(title + ": " + entry);
  log.length = 0;
}

const arrow = new Arrow();
flush("arrow, early");
arrow.start();
flush("arrow, late");

const over = new ArrowOverMethod();
flush("arrow over a method, early");
over.start();
flush("arrow over a method, late");
show("own start", () => Object.hasOwn(over, "start"));

const bound = new Bound();
flush("bound, early");
bound.start();
flush("bound, late");

const listeners = new Listeners();
flush("listeners, early");
listeners.start();
flush("listeners, late");

new Kept();
flush("kept, early");
show("saved() late", () => saved());
