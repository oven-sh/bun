class Swapped {
  own = "own field";
  constructor(replacement: Swapped | undefined) {
    if (replacement !== undefined) return replacement;
  }
}

////= lines-16	Derived	Swapped	extra	"field of the subclass"	hello	"hello "

const honest = new Derived(undefined);
console.log("honest: " + describe(honest) + " " + honest.hello() + " " + (honest instanceof Derived));

const target: Swapped = { own: "a literal" };
const made = new Derived(target);
console.log("same object: " + (Object.is(made, target)));
console.log("made: " + describe(made));
console.log("target: " + describe(target));
console.log("instance: " + (made instanceof Derived) + " " + (made instanceof Swapped));
console.log("extra: " + made.extra + " " + typeof made.hello);

const again = new Derived(honest);
console.log("an earlier instance: " + Object.is(again, honest) + " " + describe(again) + " " + again.hello());
//// a-base-constructor-turns-this-into-a-string.ts
////= text-12

class Base {
  asText: string;
  asTemplate: string;
  asJson: string;
  asNumber: number;
  compared: boolean;
  constructor() {
    this.asText = String(this);
    this.asTemplate = `<${this}>`;
    this.asJson = JSON.stringify(this);
    this.asNumber = +this;
    this.compared = this.valueOf() > 1;
  }
  valueOf(): number {
    return 0;
  }
}

class Money extends Base {
  amount: number = 12.5;
  unit: string = "usd";
  parts: number[] = [1, 2];
  toString(): string {
    return typeof this.amount + " " + this.amount + " " + typeof this.unit + " " + this.unit;
  }
  toJSON(): { amount: number; unit: string; doubled: number } {
    return { amount: this.amount, unit: this.unit, doubled: this.amount * 2 };
  }
  valueOf(): number {
    return this.amount;
  }
}

class Careless extends Base {
  unit: string = "eur";
  parts: number[] = [1, 2];
  toString(): string {
    return this.unit.toUpperCase();
  }
}

class Listing extends Base {
  parts: number[] = [1, 2];
  toJSON(): number {
    return this.parts.length;
  }
}

const money = new Money();
show("asText", () => money.asText);
show("asTemplate", () => money.asTemplate);
show("asJson", () => money.asJson);
show("asNumber", () => money.asNumber);
show("compared", () => money.compared);
show("String now", () => String(money));
show("JSON now", () => JSON.stringify(money));
show("number now", () => +money);
show("compared now", () => money.valueOf() > 1);
show("keys", () => Object.keys(money).join());
show("a toString that needs its field", () => new Careless());
show("a toJSON that needs its field", () => new Listing());
