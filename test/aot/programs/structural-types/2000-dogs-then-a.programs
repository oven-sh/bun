//// a-base-constructor-returns-a-primitive-or-nothing.ts
////= describe

////= lines-18	Plain	base	1

function returning(value: unknown): new () => Plain {
  function Old(this: Plain): unknown {
    this.base = 5;
    return value;
  }
  Old.prototype = Plain.prototype;
  const bag: object = { Old };
  return Reflect.get(bag, "Old");
}

for (const [label, value] of [["undefined", undefined], ["null", null], ["a number", 5], ["a string", "text"], ["an object", { other: true }]] satisfies [string, unknown][]) {
  class Derived extends returning(value) {
    extra = 2;
  }
  const made = new Derived();
  console.log(label + ": " + describe(made) + " instance " + (made instanceof Derived));
}
//// a-base-constructor-returns-a-proxy.ts
////= describe

const seen: string[] = [];

class Watched {
  constructor() {
    return new Proxy(this, {
      defineProperty(target, key, descriptor) {
        seen.push("define " + String(key));
        return Reflect.defineProperty(target, key, descriptor);
      },
      set(target, key, value, receiver) {
        seen.push("set " + String(key));
        return Reflect.set(target, key, value, receiver);
      },
      get(target, key, receiver) {
        if (typeof key === "string") seen.push("get " + key);
        return Reflect.get(target, key, receiver);
      },
    });
  }
}

class Derived extends Watched {
  first = 1;
  second: number;
  constructor() {
    super();
    this.second = this.first + 1;
  }
}

const made = new Derived();
console.log("traps while constructing: " + seen.join(", "));
seen.length = 0;
console.log("members: " + made.first + " " + made.second);
console.log("traps while reading: " + seen.join(", "));
console.log("instance: " + (made instanceof Derived));
console.log(describe(made));
