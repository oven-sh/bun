//// a-callback-type-taken-from-a-method-signature-gets-a-cat.ts
////= Person-5

type Visit = { bivarianceHack(a: Animal): number }["bivarianceHack"];
type Name = { bivarianceHack(a: Animal): string }["bivarianceHack"];

function each(list: Animal[], visit: Visit): string {
  const results: string[] = [];
  for (const a of list) {
    try {
      const n: number = visit(a);
      results.push(typeof n + " " + n);
    } catch (error) {
      results.push("threw");
    }
  }
  return results.join(", ");
}

function total(list: Animal[], visit: Visit): number {
  let sum = 0;
  for (let i = 0; i < list.length; i++) sum += visit(list[i]);
  return sum;
}

function names(list: Animal[], name: Name): string {
  let all = "";
  for (const a of list) all += name(a) + ";";
  return all;
}

function withVisitor(list: Animal[], visitor: { visit(a: Animal): number }): string {
  return list.map(a => String(visitor.visit(a))).join();
}

const mixed: Animal[] = [new Dog("rex"), new Cat("tom"), new Spider("boris"), new Animal("thing"), new Dog("fido")];
const dogs: Animal[] = [new Dog("a"), new Dog("b"), new Dog("c")];

////= lines-20	legs	d	Dog	number	return	d.legs

show("dogs, arrow", () => each(dogs, (d: Dog) => d.legs));
show("mixed, arrow", () => each(mixed, (d: Dog) => d.legs));
show("mixed, arithmetic", () => each(mixed, (d: Dog) => d.legs * 2 + 1));
show("mixed, bit operation", () => each(mixed, (d: Dog) => d.legs | 0));
show("mixed, string length", () => each(mixed, (d: Dog) => d.tag.length));
show("mixed, object field", () => each(mixed, (d: Dog) => d.owner.first.length));
show("mixed, array field", () => each(mixed, (d: Dog) => d.tricks.length));
show("mixed, method", () => each(mixed, (d: Dog) => d.bark().length));
show("mixed, store", () => each(mixed, (d: Dog) => (d.legs = 3)));
show("mixed, declared function", () => each(mixed, legs));
show("dogs, total", () => total(dogs, legs));
show("mixed, total", () => total(mixed, legs));
show("honest call of the same function", () => legs(new Dog("direct")));
show("dogs, names", () => names(dogs, (d: Dog) => d.tag));
show("mixed, names", () => names(mixed, (d: Dog) => d.tag));
show("mixed, upper case", () => names(mixed, (d: Dog) => d.tag.toUpperCase()));
show("dogs, visitor", () => withVisitor(dogs, { visit: (d: Dog) => d.legs }));
show("mixed, visitor", () => withVisitor(mixed, { visit: (d: Dog) => d.legs }));
show("mixed afterwards", () => mixed);
//// a-callback-typed-in-method-syntax-loses-its-object.ts
////= show-6

interface Task {
  weight: number;
  run(): number;
  describe(prefix: string): string;
}
interface Api {
  load: () => number;
  name: string;
}

class Heavy implements Task {
  weight: number = 100;
  run(): number {
    return this.weight;
  }
  describe(prefix: string): string {
    return prefix + this.weight;
  }
}
class Service {
  name: string = "service";
  hits: number = 0;
  load(): number {
    return ++this.hits;
  }
}

const literal: Task = {
  weight: 5,
  run() {
    return this.weight;
  },
  describe(prefix) {
    return prefix + this.weight;
  },
};

function exec(run: Task["run"]): number {
  return run();
}
function execWith(describe: Task["describe"], prefix: string): string {
  return describe(prefix);
}
function viaInterface(task: Task): number {
  const { run } = task;
  return run();
}
////= lines-19	honest	task	Task	number	task.run
////= lines-242	useApi	api	Api	number	load	api.load
////= lines-19	useApiHonestly	api	Api	number	api.load

const heavy = new Heavy();
show("honest class", () => honest(heavy));
show("honest literal", () => honest(literal));
show("exec class", () => exec(heavy.run));
show("exec literal", () => exec(literal.run));
show("execWith class", () => execWith(heavy.describe, "w"));
show("execWith literal", () => execWith(literal.describe, "w"));
show("viaInterface class", () => viaInterface(heavy));
show("viaInterface literal", () => viaInterface(literal));
show("exec an arrow", () => exec(() => heavy.run()));

const mixed: Task = { weight: 1, run: heavy.run, describe: literal.describe };
show("a task made of other tasks' methods: run", () => mixed.run());
show("a task made of other tasks' methods: describe", () => mixed.describe("m"));

const service = new Service();
show("a method for a function-typed member: honest", () => useApiHonestly(service));
show("a method for a function-typed member: taken off", () => useApi(service));
show("an arrow for the same member", () => useApi({ name: "arrow", load: () => 5 }));
show("hits", () => service.hits);

let total = 0;
for (let i = 0; i < 2000; i++) total += honest(i % 2 === 0 ? heavy : literal);
show("2000 honest runs", () => total);
show("then taken off", () => viaInterface(heavy));
show("then honest", () => honest(heavy));
//// a-callback-without-parameters-counts-what-it-is-given.ts
function text(value: unknown): string {
  if (typeof value === "number") return "number " + (Object.is(value, -0) ? "-0" : String(value));
  if (typeof value === "function") return "function";
  if (typeof value === "object" && value !== null) return Array.isArray(value) ? "list" : "object";
  return typeof value + " " + String(value);
}

let counts: string[] = [];

function counting(): number {
  counts.push(arguments.length + "(" + Array.from(arguments, text).join("; ") + ")");
  return 0;
}

function countingText(): string {
  Reflect.apply(counting, null, arguments);
  return "-";
}

function report(label: string, run: () => unknown): void {
  counts = [];
  run();
  console.log(label + ": " + counts.join(" "));
}

report("forEach", () => [5].forEach(counting));
report("map", () => [5].map(counting));
report("filter", () => [5].filter(counting));
report("find", () => [5].find(counting));
report("findLast", () => [5].findLast(counting));
report("some", () => [5].some(counting));
report("every", () => [5].every(counting));
report("flatMap", () => [5].flatMap(counting));
report("reduce", () => [5, 6].reduce(counting));
report("reduce with a start", () => [5].reduce(counting, 1));
report("reduceRight", () => [5, 6].reduceRight(counting));
report("toSorted", () => [5, 6].toSorted(counting));
report("Array.from", () => Array.from([5], counting));
report("Array.from an array-like", () => Array.from({ length: 1 }, counting));
report("a typed array's map", () => new Uint8Array([5]).map(counting));
report("a set's forEach", () => new Set([5]).forEach(counting));
report("a map's forEach", () => new Map([[5, 6]]).forEach(counting));
report("an iterator's map", () => [5].values().map(counting).toArray());
report("an iterator's reduce", () => [5, 6].values().reduce(counting));
report("replace with a text", () => "abc".replace("b", countingText));
report("replace with two groups", () => "abc".replace(/(a)(b)/, countingText));
report("replace with a named group", () => "abc".replace(/(?<first>a)/, countingText));
report("replaceAll", () => "aa".replaceAll("a", countingText));
report("JSON.stringify's replacer", () => JSON.stringify({ k: 1 }, counting));
report("Object.groupBy", () => Object.groupBy([5], counting));
report("Map.groupBy", () => Map.groupBy([5], counting));
const slot: { x?: number } = {};
report("a getter", () => Object.defineProperty(slot, "x", { get: counting, configurable: true }).x);
report("a setter", () => {
  Object.defineProperty(slot, "x", { set: counting, configurable: true }).x = 5;
});
report("valueOf", () => +Object({ valueOf: counting }));
report("toString in a template", () => `${Object({ toString: countingText })}`);
report("Symbol.toPrimitive", () => `${Object({ [Symbol.toPrimitive]: countingText })}`);
report("toJSON", () => JSON.stringify({ k: { toJSON: counting } }));
const tag: (strings: TemplateStringsArray, ...values: number[]) => number = counting;
report("a tag", () => tag`a${1}b`);
report("a proxy's get trap", () => new Proxy<{ x?: number }>({}, { get: counting }).x);
report("a proxy's apply trap", () => new Proxy(counting, { apply: counting })());

counts = [];
await Promise.resolve(5).then(counting);
await Promise.reject(5).catch(counting);
await Promise.resolve(5).finally(counting);
await new Promise<void>(resolve => queueMicrotask(() => {
  counting();
  resolve();
}));
new Promise(counting);
console.log("then, catch, finally, a job, an executor: " + counts.join(" "));

function own(visit: (a: number, b: string, c: boolean, d: null) => void): void {
  visit(1, "two", true, null);
}
report("the program's own function gives four", () => own(counting));
report("through bind with two more", () => own(counting.bind(null)));

