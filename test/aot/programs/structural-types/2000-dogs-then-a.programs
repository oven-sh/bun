class DogRegister implements Register {
  latest: Dog = new Dog("nobody");
  all: Dog[] = [];
  byName = new Map<string, Dog>();
  legs: number[] = [];
  tags: string[] = [];
  totalLegs: number = 0;
  enter(d: Dog): void {
    this.latest = d;
    this.all.push(d);
    this.byName.set(d.name, d);
    this.legs.push(d.legs);
    this.tags.push(d.tag);
    this.totalLegs += d.legs;
  }
}

