  return s.edge * 2;
});
attempt("in the same function as the test: an asserting method", () => {
  const s: Shape = new Shape();
  s.assertSquare();
  return s.edge * 2;
});
for (const [name, narrow] of ways) attempt("honest again by " + name, () => [edgeTwice(narrow(new Square())), areaOf(narrow(new Square()))]);
//// a-base-with-setters-for-the-names-of-the-fields-of-a-mixin.ts
////= describe

const seen: string[] = [];

class Base {
  set tag(value: string) {
    seen.push("the setter of the base got " + value);
  }
  get tag(): string {
    return "from the getter of the base";
  }
}

function Declares(Parent: new () => Base) {
  return class extends Parent {
    constructor() {
      super();
      this.tag = "stored in the constructor";
    }
  };
}

const stored = new (Declares(Base))();
console.log(describe(stored) + " tag: " + stored.tag + " seen: " + seen.join(", "));
