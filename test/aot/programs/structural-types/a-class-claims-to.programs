round("a subclass");

f.Kind = Swapped;
Factory.Kind = Swapped;
round("a look-alike with its fields in another order");

f.Kind = Point.bind(null, 50);
Factory.Kind = Point.bind(null, 50);
round("the class, bound to a first argument");

f.Kind = new Proxy(Point, {
  construct(target, args) {
    return new target(args[1], args[0]);
  },
});
Factory.Kind = new Proxy(Point, {});
round("proxies of the class");

f.Kind = Point;
Factory.Kind = Point;
round("restored");

