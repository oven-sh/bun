//// a-class-is-taken-for-an-object-type-that-its-static-members-satisfy.ts
// A class whose static members are those of an object type is passed where the type is declared, beside a literal, a namespace and an enum: static fields, methods, accessors and stores behave as in plain Bun.
interface Counter { count: number; step(): number }
class Up { static count = 0; static step() { return ++Up.count; } }
class Down { static count = 10; static step() { return --this.count; } }
class Heir extends Up {}
class Computed { static #n = 1; static get count() { return Computed.#n; } static set count(n: number) { Computed.#n = n * 2; } static step() { return Computed.count; } }
namespace Space { export let count = 100; export function step() { return (count += 5); } }
function run(c: Counter): number { const before = c.count; c.count = before + 1; return c.step() + c.count + before; }
function names(c: Counter): string { return Object.keys(c).join() + typeof c + ("step" in c); }
let n = 0, t = "";
const literal: Counter = { count: 1, step() { return this.count * 2; } };
for (let i = 0; i < 100; i++) {
  n += run(Up) + run(Down) + run(literal) + run(Space) + run(Computed) % 1000 + run(Heir);
  t = names(Up) + names(literal) + names(Space) + names(Heir);
}
console.log(n, t, Up.count, Down.count, Heir.count, Space.count);
//// a-class-is-used-while-it-is-being-defined.ts
////= text-12

const log: string[] = [];

function attempt(label: string, run: () => unknown): string {
  let result: string;
  try {
    result = text(run());
  } catch (error) {
    result = "threw " + (error instanceof Error ? error.constructor.name : typeof error);
  }
  log.push(label + ": " + result);
  return "key" + log.length;
}

class Plain {}

////= lines-41	childName	string	Child.name

function parentOf(): typeof Plain {
  attempt("in the extends clause", childName);
  return Plain;
}

class Child extends parentOf() {
  [attempt("in a computed method name", childName)](): void {}
  static [attempt("in a computed static method name", childName)](): void {}
  static first: string = attempt("in a static initializer", () => Child.name);
  static {
    attempt("in a static block", () => Child.name);
    attempt("an instance made in a static block", () => new Child().field);
    attempt("a later static read in a static block", () => Child.last);
  }
  field: string = attempt("in a field initializer", () => Child.last);
  static last: number = 9;
}

new Child();
for (const entry of log.splice(0)) console.log(entry);
show("names on the prototype", () => Object.getOwnPropertyNames(Child.prototype).join());
show("static keys", () => Object.keys(Child).join());

const Expression = class Inner {
  static self: string = attempt("the inner name in a static initializer", () => Inner.name);
  static outer: string = attempt("the outer name in a static initializer", () => Expression.name);
};
for (const entry of log.splice(0)) console.log(entry);
show("afterwards", () => Expression.name);

function makeEarly(): string {
  return attempt("a class declared later in the same block", () => new Later().n);
}
makeEarly();
////= lines-29	Later	n	number	1
makeEarly();
for (const entry of log.splice(0)) console.log(entry);

function perCall(n: number): number {
  class Local {
    static base: number = n;
    value: number = Local.base * 2;
  }
  return new Local().value;
}
show("a class made on every call", () => [perCall(1), perCall(2), perCall(3)].join());
