function watcher(o: Subject): { bare: () => number; kept: () => number; late: () => number } {
  const method = o.readCount;
  return {
    bare: () => method(),
    kept: () => method.call(o),
    late: () => o.readCount(),
  };
}

const s = new Subject();
const watch = watcher(s);
show("bare", watch.bare);
show("kept", watch.kept);
show("late", watch.late);

s.count = 11;
show("after a store: kept", watch.kept);
show("after a store: late", watch.late);

s.readCount = () => -1;
show("after an own member hides the method: kept", watch.kept);
show("after an own member hides the method: late", watch.late);

const original = Subject.prototype.readCount;
Subject.prototype.readCount = function (): number {
  return this.count * 100;
};
const t = new Subject();
const second = watcher(t);
show("taken off after the prototype changed: kept", second.kept);
show("the first one still has the old function: kept", watch.kept);
Subject.prototype.readCount = original;
show("put back: what was taken off stays: kept", second.kept);
show("put back: late", second.late);

let current: Subject = new Subject();
const method = current.countPlusOne;
const onCurrent = (): number => method.call(current);
show("a captured variable: first object", onCurrent);
current = t;
t.count = 70;
show("a captured variable: second object", onCurrent);
let total = 0;
for (let i = 0; i < 2000; i++) total += onCurrent();
show("2000 calls", () => total);
const stranger: Subject = Object.create(Subject.prototype);
current = stranger;
show("a captured variable: an object without fields", onCurrent);
//// a-closure-reads-a-variable-before-it-is-assigned.ts
////= text-21

function numbers(): string {
  let n: number;
  const read = () => n;
  const plusOne = () => n + 1;
  const whole = () => n | 0;
  const kind = () => typeof n;
  const before = kind() + " " + read() + " " + plusOne() + " " + whole();
  n = 4;
  return before + " | " + kind() + " " + read() + " " + plusOne() + " " + whole();
}

function strings(): string {
  let s: string;
  const read = () => s;
  const joined = () => s + "!";
  const size = () => s.length;
  let before = typeof read() + " " + joined();
  try {
    before += " " + size();
  } catch (error) {
    before += " threw";
  }
  s = "set";
  return before + " | " + typeof read() + " " + joined() + " " + size();
}

function objects(): string {
  let p: Person;
  const read = () => p;
  const name = () => p.first;
  let before = typeof read();
  try {
    before += " " + name();
  } catch (error) {
    before += " threw";
  }
  p = new Person();
  return before + " | " + typeof read() + " " + name();
}

function functions(): string {
  let f: () => number;
  const call = () => f();
  let before: string;
  try {
    before = String(call());
  } catch (error) {
    before = "threw";
  }
  f = () => 3;
  return before + " | " + call();
}

function arrays(): string {
  let list: number[];
  const size = () => list.length;
  const kind = () => typeof list;
  let before = kind();
  try {
    before += " " + size();
  } catch (error) {
    before += " threw";
  }
  list = [1, 2];
  return before + " | " + kind() + " " + size();
}

function counters(): string {
  let count: number;
  const bump = () => {
    count++;
    return count;
  };
  const first = bump();
  count = 10;
  return first + " | " + bump();
}

function loops(): string {
  let total: number;
  const add = (n: number) => {
    total += n;
  };
  for (let i = 0; i < 3; i++) add(i);
  const peek = () => total;
  const early = peek();
  total = 0;
  for (let i = 0; i < 2000; i++) add(1);
  return early + " | " + total;
}

function hoisted(): string {
  const before = typeof peek() + " " + peek();
  var v: number = 5;
  function peek(): number {
    return v;
  }
  return before + " | " + typeof peek() + " " + peek();
}

show("numbers", numbers);
show("strings", strings);
show("objects", objects);
show("functions", functions);
show("arrays", arrays);
show("counters", counters);
show("loops", loops);
show("hoisted var", hoisted);

let shared: number;
////= lines-34	readShared	number	return	shared
////= lines-240	sharedPlusOne	shared
show("a variable of the module", readShared);
show("plus one", sharedPlusOne);
shared = 1;
show("assigned", readShared);
show("plus one", sharedPlusOne);
//// a-comparator-method-loses-its-object.ts
////= show-6

class Sorter {
  direction: number = -1;
  key: "size" | "name" = "size";
  compare(a: number, b: number): number {
    return (a - b) * this.direction;
  }
  byKey(a: { size: number; name: string }, b: { size: number; name: string }): number {
    const x = a[this.key];
    const y = b[this.key];
    return x < y ? -1 : x > y ? 1 : 0;
  }
  static ascending(a: number, b: number): number {
    return a - b;
  }
  static flipped(a: number, b: number): number {
    return -this.ascending(a, b);
  }
}

const sorter = new Sorter();
const items = [
  { size: 2, name: "b" },
  { size: 1, name: "c" },
  { size: 3, name: "a" },
];

show("honest arrow", () => [1, 3, 2].sort((a, b) => sorter.compare(a, b)).join());
show("bound", () => [1, 3, 2].sort(sorter.compare.bind(sorter)).join());
show("bare", () => [1, 3, 2].sort(sorter.compare).join());
show("bare, one element", () => [1].sort(sorter.compare).join());
show("bare, no element", () => [].sort(sorter.compare).length);
show("bare toSorted", () => [1, 3, 2].toSorted(sorter.compare).join());
show("bare on a typed array", () => new Int8Array([1, 3, 2]).sort(sorter.compare).join());
show("byKey honest", () => [...items].sort((a, b) => sorter.byKey(a, b)).map(i => i.name).join());
show("byKey bare", () => [...items].sort(sorter.byKey).map(i => i.name).join());
show("static that needs no this", () => [1, 3, 2].sort(Sorter.ascending).join());
show("static that needs this", () => [1, 3, 2].sort(Sorter.flipped).join());
show("static that needs this, an arrow", () => [1, 3, 2].sort((a, b) => Sorter.flipped(a, b)).join());
const borrowed = { direction: 1, compare: sorter.compare };
show("borrowed by another object, an arrow", () => [1, 3, 2].sort((a, b) => borrowed.compare(a, b)).join());
show("the array is whole after a comparator that throws", () => {
  const list = [1, 3, 2];
  try {
    list.sort(sorter.compare);
  } catch (error) {
    return [...list].sort(Sorter.ascending).join();
  }
  return "did not throw";
});
//// a-conditional-type-resolves-to-another-type-at-each-call.ts
////= show-32

type Element<T> = T extends readonly (infer U)[] ? U : T;
type Result<T> = T extends (...parameters: never[]) => infer R ? R : T;
type Text<T> = T extends number ? string : T extends string ? number : T;

function elementOf<T>(value: T, pick: (value: T) => Element<T>): Element<T> {
  return pick(value);
}

function resultOf<T>(value: T, run: (value: T) => Result<T>): Result<T> {
  return run(value);
}

function turned<T>(value: T, turn: (value: T) => Text<T>): Text<T> {
  return turn(value);
}

function keep<T>(value: T, pick: (value: T) => Element<T>): Element<T>[] {
  const kept: Element<T>[] = [];
  for (let i = 0; i < 3; i++) kept.push(pick(value));
  return kept;
}

