//// a-class-with-seventy-methods-honest.ts
////= Wide

class Below extends Wide {
  m70(): number {
    return super.m70() + 1000;
  }
}

function some(w: Wide): string {
  return [w.m1(), w.m2(), w.m32(), w.m33(), w.m63(), w.m64(), w.m65(), w.m66(), w.m69(), w.m70()].join(" ");
