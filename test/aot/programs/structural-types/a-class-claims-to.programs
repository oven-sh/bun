//// a-class-that-implements-array-like.ts
////= show-30

const log: string[] = [];

class Squares implements ArrayLike<number> {
  readonly [index: number]: number;
  constructor(public readonly length: number) {
    for (let i = 0; i < length; i++) {
      Object.defineProperty(this, i, {
        get() {
          log.push("get " + i);
          return i * i;
        },
        enumerable: true,
      });
    }
  }
}

class Sparse implements ArrayLike<number> {
  readonly [index: number]: number;
  readonly 0 = 10;
  readonly 2 = 30;
  readonly length = 4;
}

class Counting implements ArrayLike<number> {
  readonly [index: number]: number;
  readonly 0 = 1;
  readonly 1 = 2;
  reads = 0;
  get length(): number {
    this.reads++;
    return 2;
  }
}

function lazy(length: number): ArrayLike<number> {
  return new Proxy<ArrayLike<number>>({ length }, {
    get(target, key) {
      if (key === "length") return target.length;
      log.push("trap " + String(key));
      return typeof key === "string" ? Number(key) + 0.5 : undefined;
    },
    has(target, key) {
      log.push("has " + String(key));
      return key in target;
    },
  });
}

////= sum-3

function inspect(list: ArrayLike<number>): string[] {
  const lines: string[] = [];
  for (let i = 0; i < list.length; i++) lines.push(i + " " + (i in list ? "present" : "absent") + " " + typeof list[i] + " " + list[i]);
  return lines;
}

function last(list: ArrayLike<number>): number {
  return list[list.length - 1];
}

function toArray(list: ArrayLike<number>): number[] {
  return Array.from(list);
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += sum([i, 1]) + inspect([i]).length + last([i, 2]) + toArray([i]).length;
console.log("after 2000 arrays", warm);

const makers: [string, () => ArrayLike<number>][] = [
  ["an array", () => [1, 2, 3]],
  ["squares behind getters", () => new Squares(3)],
  ["a sparse class", () => new Sparse()],
  ["a counted length", () => new Counting()],
  ["a proxy", () => lazy(2)],
  ["bytes", () => new Uint8Array([250, 251])],
  ["a literal", () => ({ 0: 5, 1: 6, length: 2 })],
];
for (const [name, make] of makers) {
  log.length = 0;
  attempt(name + ": sum", () => sum(make()));
  attempt(name + ": elements", () => inspect(make()));
  attempt(name + ": last", () => last(make()));
  attempt(name + ": Array.from", () => toArray(make()));
  attempt(name + ": map.call", () => Array.prototype.map.call(make(), value => typeof value));
  attempt(name + ": isArray", () => Array.isArray(make()));
  attempt(name + ": keys", () => Object.keys(make()));
  attempt(name + ": into a Float64Array", () => Array.from(new Float64Array(make())));
  console.log(name + ": log", log.length, log.slice(0, 6).join("; "));
}
attempt("how often the length is read", () => {
  const counting = new Counting();
  const total = sum(counting);
  return [total, counting.reads];
});
attempt("an array again", () => [sum([1, 2, 3]), last([4])]);
//// a-class-that-implements-iterable.ts
////= show-30

const log: string[] = [];

class Countdown implements Iterable<number> {
  constructor(private from: number) {}
  [Symbol.iterator](): Iterator<number> {
    let current = this.from;
    log.push("iterator");
    return {
      next: () => {
        log.push("next");
        return current > 0 ? { done: false, value: current-- } : { done: true, value: undefined };
      },
      return: () => {
        log.push("return");
        return { done: true, value: undefined };
      },
    };
  }
}

class Liar implements Iterable<number> {
  *[Symbol.iterator](): Generator<number> {
    const numbers: number[] = new Array<number>(2);
    yield numbers[0];
    yield 1;
    yield numbers[1];
  }
}

////= total-6

function firstAbove(numbers: Iterable<number>, limit: number): number {
  for (const number of numbers) if (number > limit) return number;
  return -1;
}

function firstTwo(numbers: Iterable<number>): number[] {
  const [a, b] = numbers;
  return [a, b];
}

function firstAndRest(numbers: Iterable<number>): [number, number[]] {
  const [first, ...rest] = numbers;
  return [first, rest];
}

function spread(numbers: Iterable<number>): number[] {
  return [...numbers];
}

function largest(numbers: Iterable<number>): number {
  return Math.max(...numbers);
}

function* plusOne(numbers: Iterable<number>): Generator<number> {
  for (const number of numbers) yield number + 1;
}

function* delegated(numbers: Iterable<number>): Generator<number> {
  yield* numbers;
}

function throwsInside(numbers: Iterable<number>): number {
  for (const number of numbers) if (number < 3) throw new RangeError("low");
  return 0;
}

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = [i, 2, 3];
  warm += total(honest) + firstAbove(honest, 2) + firstTwo(honest)[1] + firstAndRest(honest)[1].length + spread(honest).length + largest(honest) + total(plusOne(honest)) + total(delegated(honest));
}
console.log("after 2000 arrays", warm);

const makers: [string, () => Iterable<number>][] = [
  ["an array", () => [3, 2, 1]],
  ["a countdown", () => new Countdown(3)],
  ["a set", () => new Set([3, 2, 1, 3])],
  ["keys of a map", () => new Map([[3, "c"], [2, "b"]]).keys()],
  ["bytes", () => new Uint8Array([3, 2, 1])],
  ["a generator", () => plusOne([2, 1, 0])],
  ["an array with holes", () => new Array<number>(2)],
  ["a liar", () => new Liar()],
  ["an empty countdown", () => new Countdown(0)],
];
for (const [name, make] of makers) {
  log.length = 0;
  attempt(name + ": total", () => total(make()));
  attempt(name + ": first above 1", () => firstAbove(make(), 1));
  attempt(name + ": first two", () => firstTwo(make()));
  attempt(name + ": first and rest", () => firstAndRest(make()));
  attempt(name + ": spread", () => spread(make()));
  attempt(name + ": largest", () => largest(make()));
  attempt(name + ": plus one", () => spread(plusOne(make())));
  attempt(name + ": delegated", () => spread(delegated(make())));
  attempt(name + ": throws inside the loop", () => throwsInside(make()));
  attempt(name + ": Array.from", () => Array.from(make(), number => number * 2));
  attempt(name + ": new Set", () => new Set(make()).size);
  console.log(name + ": log", log.join(" "));
}
//// a-class-whose-constructor-stores-its-tag-is-retagged-and-mistagged.ts
////= show-4

const log: string[] = [];

////= attempt-2

type Kind = "number" | "word";

class Token {
  constructor(
    public kind: Kind,
    public text: string,
  ) {}
  value(): number {
    return this.kind === "number" ? Number(this.text) : this.text.length;
  }
}

class Leaf {
  readonly kind = "leaf";
  constructor(public value: number) {}
}

class Branch {
  readonly kind = "branch";
  constructor(
    public left: Tree,
    public right: Tree,
  ) {}
}

type Tree = Leaf | Branch;

function sum(t: Tree): number {
  return t.kind === "leaf" ? t.value : sum(t.left) + sum(t.right);
}

function describe(t: Token): string {
  switch (t.kind) {
    case "number":
      return "number " + t.value();
    case "word":
      return "word " + t.value();
  }
}

function otherKind(): Kind {
  const box: { kind: Kind } = { kind: "word" };
  const open: { kind: string } = box;
  open.kind = "other";
  return box.kind;
}

attempt("honest", () => [describe(new Token("number", "12")), describe(new Token("word", "abc")), sum(new Branch(new Leaf(1), new Branch(new Leaf(2), new Leaf(3))))]);
let warm = 0;
for (let i = 0; i < 2000; i++) warm += new Token(i & 1 ? "number" : "word", "12").value() + describe(new Token("word", "ab")).length + sum(new Branch(new Leaf(i), new Leaf(1)));
console.log("2000 honest rounds", warm);

attempt("stored to by its own type", () => {
  const t = new Token("number", "12");
  const before = describe(t);
  t.kind = "word";
  return [before, describe(t), JSON.stringify(t)];
});
attempt("stored to in a loop", () => {
  const t = new Token("number", "12");
  const seen: string[] = [];
  for (let i = 0; i < 4; i++) {
    t.kind = i & 1 ? "word" : "number";
    seen.push(describe(t));
  }
  return seen;
});
attempt("constructed with a tag outside the type", () => {
  const t = new Token(otherKind(), "12");
  return [t.kind, t.value(), describe(t), JSON.stringify(t)];
});
attempt("stored a tag outside the type", () => {
  const t = new Token("number", "12");
  t.kind = otherKind();
  return [t.kind, t.value(), describe(t)];
});
attempt("retagged by Reflect.set", () => {
  const t = new Token("number", "12");
  Reflect.set(t, "kind", "word");
  return describe(t);
});
attempt("retagged by Object.assign", () => describe(Object.assign(new Token("number", "12"), { kind: "word" })));
attempt("the tag becomes a getter", () => {
  const t = new Token("number", "12");
  let reads = 0;
  Object.defineProperty(t, "kind", { get: () => (reads++ & 1 ? "word" : "number") });
  return [describe(t), describe(t), t.value(), t.value()];
});
attempt("the tag is deleted", () => {
  const t = new Token("number", "12");
  Reflect.deleteProperty(t, "kind");
  return [t.kind, t.value(), describe(t), Object.keys(t)];
});
attempt("a read-only tag is stored to through a view", () => {
  const leaf = new Leaf(5);
  const open: { kind: string } = leaf;
  open.kind = "branch";
  return [leaf.kind, JSON.stringify(leaf)];
});
attempt("a leaf that says it is a branch", () => {
  const leaf = new Leaf(5);
  const open: { kind: string } = leaf;
  open.kind = "branch";
  return sum(leaf);
});
attempt("a branch that says it is a leaf", () => {
  const branch = new Branch(new Leaf(1), new Leaf(2));
  const open: { kind: string } = branch;
  open.kind = "leaf";
  return [sum(branch), typeof sum(branch)];
});
attempt("deep in a tree", () => {
  const odd = new Leaf(5);
  const tree = new Branch(new Leaf(1), new Branch(odd, new Leaf(2)));
  const before = sum(tree);
  const open: { kind: string } = odd;
  open.kind = "twig";
  let after: unknown;
  try {
    after = sum(tree);
  } catch (error) {
    after = error instanceof Error ? error.constructor.name : "other";
  }
  return [before, after];
});
attempt("a literal stands for a leaf and for a branch", () => {
  const fakeLeaf: Leaf = { kind: "leaf", value: 10 };
  const fakeBranch: Branch = { kind: "branch", left: fakeLeaf, right: new Leaf(1) };
  return [sum(fakeLeaf), sum(fakeBranch), fakeLeaf instanceof Leaf];
});
attempt("a subclass with the same tag", () => {
  class Heavy extends Leaf {
    weight = 100;
  }
  return sum(new Branch(new Heavy(1), new Leaf(2)));
});
attempt("honest again", () => [describe(new Token("number", "12")), describe(new Token("word", "abc")), sum(new Branch(new Leaf(1), new Leaf(3)))]);
