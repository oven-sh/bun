//// a-class-claims-to-be-an-error-a-date-and-a-regexp-by-a-merged-interface.ts
////= text-11

interface Failure extends Error {}
////= lines-29	Failure	code	number	1

interface Stamp extends Date {}
////= lines-29	Stamp	id	number	2

interface Pattern extends RegExp {}
////= lines-29	Pattern	id	number	3

////= lines-20	messageOf	error	Error	string	return	error.message

////= lines-32	messageLength	error	Error	number	error.message.length

////= lines-19	timeOf	date	Date	number	date.getTime

function matches(pattern: RegExp, s: string): boolean {
  return pattern.test(s);
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += messageOf(new Error("ab")).length + messageLength(new RangeError("c")) + timeOf(new Date(i)) + (matches(/a/, "a") ? 1 : 0);
show("2000 honest rounds", () => warm);

const failure = new Failure();
show("message", () => messageOf(failure));
show("the length of the message", () => messageLength(failure));
show("its name", () => failure.name);
show("stack", () => failure.stack);
show("instanceof Error", () => failure instanceof Error);
show("toString", () => failure.toString());
show("thrown and caught", () => {
  try {
    throw failure;
  } catch (caught) {
    return [caught === failure, caught instanceof Error, typeof caught];
  }
});
show("thrown out of the function", () => {
  throw failure;
});
show("as a cause", () => new Error("outer", { cause: failure }).cause === failure);
show("keys", () => Object.keys(failure));

const stamp = new Stamp();
show("getTime", () => timeOf(stamp));
show("typeof getTime", () => typeof stamp.getTime);
show("the real getTime on it", () => Date.prototype.getTime.call(stamp));
show("valueOf is typed number", () => typeof stamp.valueOf());
show("new Date from it", () => new Date(stamp).getTime());
show("JSON", () => JSON.stringify(stamp));

const pattern = new Pattern();
show("test", () => matches(pattern, "a"));
show("source", () => pattern.source);
show("lastIndex", () => pattern.lastIndex);
show("lastIndex plus one", () => pattern.lastIndex + 1);
show("flags", () => pattern.flags);
show("replace with it", () => "[object Object]!".replace(pattern, "x"));
show("split with it", () => "a[object Object]b".split(pattern));
show("match with it", () => "abc".match(pattern));
show("new RegExp from it", () => new RegExp(pattern).source);
show("honest again", () => [messageOf(new Error("m")), timeOf(new Date(5)), matches(/a/, "b")]);
//// a-class-claims-to-be-callable-by-a-merged-interface.ts
////= text-11

interface Adder {
  (n: number): number;
}
////= lines-29	Adder	step	number	1

interface Maker {
  new (n: number): { made: number };
}
////= lines-29	Maker	id	number	2

interface Routine extends Function {}
////= lines-29	Routine	id	number	3

////= apply

function make(maker: new (n: number) => { made: number }, n: number): number {
  return new maker(n).made;
}

class Real {
  made: number;
  constructor(n: number) {
    this.made = n;
  }
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += apply(n => n + 1, i) + make(Real, i);
show("2000 honest rounds", () => warm);

const adder = new Adder();
show("typeof", () => typeof adder);
show("called", () => adder(1));
show("given to a typed function", () => apply(adder, 1));
show("as a callback", () => [1, 2].map(adder));
show("its own member", () => adder.step);
show("keys", () => Object.keys(adder));

const maker = new Maker();
show("constructed", () => new maker(1));
show("given to a typed function", () => make(maker, 1));

const routine = new Routine();
show("call", () => routine.call(undefined));
show("apply", () => routine.apply(undefined, []));
show("bind", () => routine.bind(undefined));
show("its name", () => routine.name);
show("its length", () => routine.length);
show("its length plus one", () => routine.length + 1);
show("its prototype", () => routine.prototype);
show("toString", () => routine.toString());
show("instanceof Function", () => routine instanceof Function);
show("the real call on it", () => Function.prototype.call.call(routine, undefined));
show("honest again", () => [apply(n => n + 1, 1), make(Real, 2)]);
//// a-class-claims-to-be-iterable-and-disposable-by-a-merged-interface.ts
////= text-11

interface Countdown {
  [Symbol.iterator](): Iterator<number>;
}
////= lines-29	Countdown	from	number	1

interface Feed {
  [Symbol.asyncIterator](): AsyncIterator<number>;
}
////= lines-29	Feed	id	number	2

interface Handle {
  [Symbol.dispose](): void;
}
////= lines-29	Handle	id	number	3

interface Money {
  [Symbol.toPrimitive](hint: string): number;
}
////= lines-29	Money	cents	number	4

////= lines-192	total	numbers	Iterable	sum	n

function listOf(numbers: Iterable<number>): number[] {
  return [...numbers];
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += total([i, 1]) + total(new Set([i])) + listOf([i]).length;
show("2000 honest rounds", () => warm);

const range = new Countdown();
show("for of", () => total(range));
show("spread", () => listOf(range));
show("Array.from takes it for an array-like", () => Array.from(range));
show("new Set", () => new Set(range).size);
show("taken apart", () => {
  const [first] = range;
  return first;
});
show("Math.max", () => Math.max(...range));
show("yield*", () => {
  function* all(): Generator<number> {
    yield* range;
  }
  return [...all()];
});
show("the method itself", () => range[Symbol.iterator]);
show("in", () => Symbol.iterator in range);

const stream = new Feed();
try {
  let sum = 0;
  for await (const n of stream) sum += n;
  show("for await", () => sum);
} catch (error) {
  show("for await", () => {
    throw error;
  });
}

show("using", () => {
  using handle = new Handle();
  return handle.id;
});
show("the stack of disposables", () => {
  const stack = new DisposableStack();
  stack.use(new Handle());
  return "taken";
});

const money = new Money();
show("the method itself", () => money[Symbol.toPrimitive]);
show("called", () => money[Symbol.toPrimitive]("number"));
show("in a template", () => `${money}`);
show("honest again", () => [total([1, 2]), listOf(new Set([3]))]);

export {};
