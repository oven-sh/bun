function build(flag: boolean): { sum(): number; extra: string } {
  const Parent: new () => { sum(): number } = flag ? Point : Other;
  class Local extends Parent {
    extra = flag ? "over point" : "over other";
  }
  return new Local();
}

for (const flag of [true, false, true, false]) {
