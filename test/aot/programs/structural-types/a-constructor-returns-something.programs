//// a-default-type-argument-names-a-number-and-a-string-arrives.ts
////= show-32

function parse<T = number>(text: string): T {
  return JSON.parse(text);
}

////= lines-27	Config	port	number	host	string

function load<T = Config>(text: string): T {
  return JSON.parse(text);
}

class Cell<T = number> {
  value: T;
  constructor(text: string) {
    this.value = JSON.parse(text);
  }
}

function address(c: Config): string {
  return c.host.toLowerCase() + ":" + (c.port + 1);
}

////= lines-21	next	cell	Cell	number	cell.value

let total = 0;
for (let i = 0; i < 2000; i++) total += parse(String(i)) + address(load('{"port":' + i + ',"host":"H"}')).length + next(new Cell(String(i)));
console.log("2000 honest rounds: " + total);

for (const text of ["1", "1.5", "-0", "1e400", '"text"', "null", "true", "[1]", '{"a":1}']) {
  console.log("parsed from " + text);
  attempt("  typeof", () => typeof parse(text));
  attempt("  + 1", () => parse(text) + 1);
  attempt("  * 2", () => parse(text) * 2);
  attempt("  | 0", () => parse(text) | 0);
  attempt("  toFixed(1)", () => parse(text).toFixed(1));
  attempt("  a local", () => {
    const n = parse(text);
    return n - n;
  });
  attempt("  a cell", () => next(new Cell(text)));
  attempt("  a cell's JSON", () => JSON.stringify(new Cell(text)));
}

for (const text of ['{"port":80,"host":"A"}', '{"host":"A","port":80}', '{"port":"80","host":"A"}', '{"port":80,"host":5}', '{"port":80}', "{}", "[]", "null", "5", '{"port":80,"host":"A","more":1}']) {
  console.log("loaded from " + text);
  attempt("  address", () => address(load(text)));
  attempt("  port", () => load(text).port);
  attempt("  keys", () => Object.keys(load<object>(text)));
}

attempt("another type argument", () => parse<string>('"text"').toUpperCase());
attempt("another type argument, a cell", () => new Cell<string>('"text"').value.toUpperCase());

export {};
//// a-default-value-is-not-what-its-type-says.ts
////= text-14

const table: number[] = [1, 2];
const holes: number[] = new Array<number>(3);
const record: Record<string, number> = { one: 1 };
const words: string[] = ["a"];

////= lines-193	short	number	void	1
const spent: Iterator<number> = short();
spent.next();
spent.next();

class Sink {
  last: number = 0;
  all: number[] = [];
  reals: Float64Array = new Float64Array(1);
}
const sink = new Sink();

function use(n: number): string {
  const read = (): number => n;
  const next = (): number => n + 1;
  sink.last = n;
  sink.all.push(n);
  sink.reals[0] = n;
  let fixed: string;
  try {
    fixed = n.toFixed(1);
  } catch (error) {
    fixed = failure(error);
  }
  return text(n) + ", captured " + text(read()) + ", next " + text(next()) + ", whole " + text(n | 0) + ", field " + text(sink.last) + ", element " + text(sink.all[sink.all.length - 1]) + ", real " + text(sink.reals[0]) + ", " + fixed;
}

////= lines-231	pastTheEnd	table[9
////= lines-231	fromAHole	holes[1
////= lines-231	missingKey	record["missing"
function parsedText(n: number = JSON.parse('"text"')): string {
  return use(n);
}
function parsedNull(n: number = JSON.parse("null")): string {
  return use(n);
}
function afterTheEnd(n: number = spent.next().value): string {
  return use(n);
}
function reflected(n: number = Reflect.get(record, "nothing")): string {
  return use(n);
}
////= lines-231	honest	table[1
function fromAPattern({ n = table[9] }: { n?: number } = {}): string {
  return use(n);
}
function fromAnArrayPattern([n = holes[0]]: number[] = []): string {
  return use(n);
}
function chained(a: number = table[9], b: number = a): string {
  return use(b);
}
function word(w: string = words[5]): string {
  const read = (): string => w;
  let length: string;
  try {
    length = text(w.length);
  } catch (error) {
    length = failure(error);
  }
  return text(w) + ", captured " + text(read()) + ", added " + text(w + "!") + ", length " + length;
}

const functions: [string, (n?: number) => string][] = [
  ["honest", honest],
  ["past the end of a list", pastTheEnd],
  ["a hole", fromAHole],
  ["a missing key", missingKey],
  ["a parsed text", parsedText],
  ["a parsed null", parsedNull],
  ["an iterator that has ended", afterTheEnd],
  ["Reflect.get", reflected],
  ["two defaults in a chain", chained],
];

let warm = 0;
for (let i = 0; i < 2000; i++) for (const [, f] of functions) warm += f(i & 7).length;
sink.all.length = 0;
console.log("2000 rounds with the argument given: " + warm);

for (const [label, f] of functions) {
  console.log(label + ", given: " + f(5));
  console.log(label + ", not given: " + f());
  console.log(label + ", undefined given: " + f(undefined));
}
console.log("an object pattern: " + fromAPattern() + " | " + fromAPattern({}) + " | " + fromAPattern({ n: 5 }));
console.log("an array pattern: " + fromAnArrayPattern() + " | " + fromAnArrayPattern([5]));
console.log("a string parameter: " + word() + " | " + word("given"));
console.log("the list of numbers: " + sink.all.map(text).join(", "));
console.log("as json: " + JSON.stringify(sink.all));
