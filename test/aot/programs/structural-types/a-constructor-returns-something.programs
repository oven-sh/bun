    this.title = name;
  }
  bark() {
    return "woof";
  }
}

export function takes(s, n) {
  return typeof s + ":" + typeof n;
}

export const Color = { Red: "red", Green: 5 };
export const Level = { Low: 10, High: 20 };

export function callBack(f) {
  return [f("8"), f(null), f()];
}

