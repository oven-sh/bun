//// a-constructor-that-takes-a-dog-is-given-a-cat.ts
////= Person-5

class Yard {
  size: number;
  constructor(a: Animal) {
    this.size = a.name.length;
  }
  describe(): string {
    return "yard " + this.size;
  }
}

class DogYard extends Yard {
  legs: number;
  tag: string;
  owner: Person;
  constructor(d: Dog) {
    super(d);
    this.legs = d.legs;
    this.tag = d.tag;
    this.owner = d.owner;
  }
  describe(): string {
    return "dog yard " + this.size + " " + this.legs + " " + this.tag;
  }
}

class LoudYard extends Yard {
  sound: string;
  constructor(public d: Dog) {
    super(d);
    this.sound = d.bark();
  }
}

function build(Make: typeof Yard, a: Animal): Yard {
  return new Make(a);
}

const makers: (typeof Yard)[] = [Yard, DogYard, LoudYard];
const animals: Animal[] = [new Dog("rex"), new Cat("tom"), new Spider("boris"), new Animal("thing")];

for (const Make of makers) {
  for (const animal of animals) {
    const label = Make.name + " of " + animal.constructor.name;
    show(label, () => build(Make, animal));
    show(label + " describe", () => build(Make, animal).describe());
  }
}

const Chosen: typeof Yard = DogYard;
const built = new Chosen(new Cat("direct"));
show("direct", () => built);
if (built instanceof DogYard) {
  show("legs", () => built.legs);
  show("legs + 1", () => built.legs + 1);
  show("tag", () => built.tag);
  show("tag length", () => built.tag.length);
  show("owner", () => built.owner);
  show("owner's name", () => built.owner.first);
  show("keys", () => Object.keys(built).join());
}

show("honest", () => new DogYard(new Dog("honest")).describe());
let sum = 0;
for (let i = 0; i < 2000; i++) sum += new DogYard(animals[0] instanceof Dog ? animals[0] : new Dog("never")).legs;
show("2000 honest constructions", () => sum);
show("a cat after them", () => build(DogYard, animals[1]).describe());
show("by Reflect.construct", () => Reflect.construct(Chosen, [new Cat("reflected")]).describe());
//// a-constructor-throws-halfway-and-the-object-is-kept.ts
////= text-21

const kept: Account[] = [];

class Account {
  id: number;
  balance: number;
  name: string;
  owner: Person;
  history: number[];
  ready: boolean = true;
  constructor(stopAfter: number) {
    kept.push(this);
    if (stopAfter === 0) throw new RangeError("stopped");
    this.id = 7;
    if (stopAfter === 1) throw new RangeError("stopped");
    this.balance = 1.5;
    if (stopAfter === 2) throw new RangeError("stopped");
    this.name = "acct";
    if (stopAfter === 3) throw new RangeError("stopped");
    this.owner = new Person();
    if (stopAfter === 4) throw new RangeError("stopped");
    this.history = [1];
  }
  worth(): number {
    return this.id + this.balance;
  }
  title(): string {
    return this.name.toUpperCase() + " of " + this.owner.first;
  }
  entries(): number {
    return this.history.length;
  }
}

for (let stop = 0; stop <= 5; stop++) {
  show("stop after " + stop, () => new Account(stop).id);
}

for (let i = 0; i < kept.length; i++) {
  const account = kept[i];
  show(i + " id", () => account.id);
  show(i + " balance", () => account.balance);
  show(i + " name", () => account.name);
  show(i + " owner", () => account.owner);
  show(i + " history", () => account.history);
  show(i + " ready", () => account.ready);
  show(i + " worth", () => account.worth());
  show(i + " title", () => account.title());
  show(i + " entries", () => account.entries());
  show(i + " keys", () => Object.keys(account).join());
  show(i + " JSON", () => JSON.stringify(account));
}

