function increment(c: Counter): number {
  return ++c.count;
}

function rename(c: Counter, name: string): string {
  c.name = name;
  return c.name;
}

function fill(counters: Counter[], value: number): number {
  let done = 0;
  for (const c of counters) {
    c.count = value;
    done++;
  }
  return done;
}

