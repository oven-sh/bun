//// a-dispose-method-runs-with-and-without-its-object.ts
////= show-6

const log: string[] = [];

class Handle {
  name: string;
  open: boolean = true;
  constructor(name: string) {
    this.name = name;
  }
  [Symbol.dispose](): void {
    this.open = false;
    log.push("closed " + this.name);
  }
  close(): void {
    this[Symbol.dispose]();
  }
}

show("using", () => {
  using handle = new Handle("first");
  log.push("in use " + handle.name);
  return handle.open;
});
show("log", () => log.splice(0).join(", "));
show("two of them close in reverse order", () => {
  using a = new Handle("a");
  using b = new Handle("b");
  return a.open && b.open;
});
show("log", () => log.splice(0).join(", "));
show("the dispose method, taken off", () => {
  const handle = new Handle("bare");
  const dispose = handle[Symbol.dispose];
  dispose();
  return handle.open;
});
show("close, taken off", () => {
  const { close } = new Handle("bare close");
  close();
});
show("dispose on a look-alike", () => {
  const like = { name: "like", open: true };
  new Handle("source")[Symbol.dispose].call(like);
  return like.open;
});
show("log", () => log.splice(0).join(", "));
show("a literal that borrows the method", () => {
  const source = new Handle("source");
  {
    using borrowed = { name: "borrowed", open: true, [Symbol.dispose]: source[Symbol.dispose] };
    log.push("in use " + borrowed.name);
  }
  return source.open;
});
show("log", () => log.splice(0).join(", "));
show("a literal whose dispose lost its object", () => {
  const source = new Handle("source");
  const dispose = source[Symbol.dispose];
  using broken = { [Symbol.dispose]: () => dispose() };
  return typeof broken;
});
show("log", () => log.splice(0).join(", "));
show("a stack that is handed the bare method", () => {
  const source = new Handle("stacked");
  const stack = new DisposableStack();
  stack.defer(source[Symbol.dispose].bind(source));
  stack.dispose();
  return source.open;
});
show("log", () => log.splice(0).join(", "));
//// a-dog-method-destructures-its-parameter-and-gets-a-cat.ts
////= Person-5

const spare = new Dog("spare");

interface Keeper {
  parts(a: Animal): string;
  nested(a: Animal): string;
  withDefaults(a: Animal): string;
  firstTrick(a: Animal): string;
  others(a: Animal): string;
  orSpare(a?: Animal): number;
}

class DogKeeper implements Keeper {
  parts({ legs, tag }: Dog): string {
    return typeof legs + " " + legs + " " + typeof tag + " " + tag;
  }
  nested({ owner: { first } }: Dog): string {
    return first;
  }
  withDefaults({ legs = -1, tag = "no tag" }: Dog): string {
    return legs + " " + tag;
  }
  firstTrick({ tricks: [first] }: Dog): string {
    return first;
  }
  others({ name, ...rest }: Dog): string {
    return name + ": " + Object.keys(rest).join();
  }
  orSpare(d: Dog = spare): number {
    return d.legs;
  }
}

const keeper: Keeper = new DogKeeper();
const animals: Animal[] = [new Dog("rex"), new Cat("tom"), new Spider("boris"), new Animal("thing"), { name: "literal" }];
for (const animal of animals) {
  const kind = animal.constructor.name;
  show(kind + " parts", () => keeper.parts(animal));
  show(kind + " nested", () => keeper.nested(animal));
  show(kind + " withDefaults", () => keeper.withDefaults(animal));
  show(kind + " firstTrick", () => keeper.firstTrick(animal));
  show(kind + " others", () => keeper.others(animal));
  show(kind + " orSpare", () => keeper.orSpare(animal));
}
show("nobody orSpare", () => keeper.orSpare());
show("undefined orSpare", () => keeper.orSpare(undefined));
//// a-dog-method-destructures-null-or-a-primitive.ts
////= Person-5

type Wide = Animal | null | undefined | string | number;

interface Keeper {
  parts(a: Wide): string;
  nested(a: Wide): string;
  withDefaults(a: Wide): string;
  nothing(a: Wide): string;
  others(a: Wide): string;
  inBody(a: Wide): string;
  list(a: Wide[]): string;
}

class DogKeeper implements Keeper {
  parts({ legs, tag }: Dog): string {
    return typeof legs + " " + typeof tag;
  }
  nested({ owner: { first } }: Dog): string {
    return typeof first;
  }
  withDefaults({ legs = -1, name = "no name" }: Dog): string {
    return legs + " " + name;
  }
  nothing({}: Dog): string {
    return "took nothing";
  }
  others({ name, ...rest }: Dog): string {
    return typeof name + " " + Object.keys(rest).join("+");
  }
  inBody(d: Dog): string {
    const { legs } = d;
    return typeof legs;
  }
  list([first, second]: Dog[]): string {
    return typeof first + " " + typeof second;
  }
}

const keeper: Keeper = new DogKeeper();
const values: [string, Wide][] = [
  ["dog", new Dog("rex")],
  ["null", null],
  ["undefined", undefined],
  ["string", "text"],
  ["number", 5],
  ["cat", new Cat("tom")],
];
for (const [label, value] of values) {
  show(label + " parts", () => keeper.parts(value));
  show(label + " nested", () => keeper.nested(value));
  show(label + " withDefaults", () => keeper.withDefaults(value));
  show(label + " nothing", () => keeper.nothing(value));
  show(label + " others", () => keeper.others(value));
  show(label + " inBody", () => keeper.inBody(value));
}
show("list of two", () => keeper.list([new Dog("a"), null]));
show("list of none", () => keeper.list([]));
show("list of strings", () => keeper.list(["x", 5]));
//// a-dog-method-gets-null-undefined-or-a-primitive.ts
////= Person-5

type Wide = Animal | null | undefined | string | number | boolean;

interface Keeper {
  legsOf(a: Wide): number;
  nameOf(a: Wide): string;
  tagLength(a: Wide): number;
  speak(a: Wide): string;
  shoe(a: Wide): void;
  isDog(a: Wide): boolean;
  exists(a: Wide): boolean;
  kind(a: Wide): string;
  chained(a: Wide): number | undefined;
  keep(a: Wide): void;
}

class DogKeeper implements Keeper {
  kept: Dog = new Dog("kept");
  legsOf(d: Dog): number {
    return d.legs;
  }
  nameOf(d: Dog): string {
    return d.name;
  }
  tagLength(d: Dog): number {
    return d.tag.length;
  }
  speak(d: Dog): string {
    return d.bark();
  }
  shoe(d: Dog): void {
    d.legs = 6;
  }
  isDog(d: Dog): boolean {
    return d instanceof Dog;
  }
  exists(d: Dog): boolean {
    return d ? true : false;
  }
  kind(d: Dog): string {
    return typeof d;
  }
  chained(d: Dog): number | undefined {
    return d?.legs;
  }
  keep(d: Dog): void {
    this.kept = d;
  }
}

const own = new DogKeeper();
const keeper: Keeper = own;
const values: [string, Wide][] = [
  ["dog", new Dog("rex")],
  ["null", null],
  ["undefined", undefined],
  ["string", "text"],
  ["empty string", ""],
  ["number", 5],
  ["zero", 0],
  ["true", true],
  ["false", false],
  ["dog again", new Dog("fido")],
];

for (const [label, value] of values) {
  show(label + " legsOf", () => keeper.legsOf(value));
  show(label + " nameOf", () => keeper.nameOf(value));
  show(label + " tagLength", () => keeper.tagLength(value));
  show(label + " speak", () => keeper.speak(value));
  show(label + " shoe", () => keeper.shoe(value));
  show(label + " isDog", () => keeper.isDog(value));
  show(label + " exists", () => keeper.exists(value));
  show(label + " kind", () => keeper.kind(value));
  show(label + " chained", () => keeper.chained(value));
  show(label + " keep", () => keeper.keep(value));
  show(label + " kept", () => typeof own.kept);
  show(label + " kept legs", () => own.kept.legs);
}
