class Widget {
  size: number = 3;
  saved: () => number = this.measure;
  savedBound: () => number = this.measure.bind(this);
  savedArrow: () => number = () => this.measure();
  measure(): number {
    return this.size * 2;
  }
}

const a = new Widget();
