//// a-field-that-left-its-slot-begins-the-call-again-and-nothing-runs-twice.ts
// A typed function is given objects of the declared layout whose fields have left their slots: a getter, a value of another type, a deleted field. Every getter and every effect runs once, in order.
// STATISTIC: RestartsInGenericVersion >= 1
type Point = { x: number; y: number; label: string };

const log: string[] = [];
let calls = 0;

function describe(p: Point): string {
  let text = p.label + ":" + (p.x + p.y);
  if (p.x > p.y) text += " wide";
  if (p.label.length > 3) text += " long";
  return text;
}

function countThenRead(p: Point): string {
  const x = p.x;
  calls++;
  log.push("counted " + calls);
  return x + "/" + p.y + "/" + p.label;
}

function sumAll(points: Point[]): number {
  let sum = 0;
  for (let i = 0; i < points.length; i++) sum += points[i].x * 2 + points[i].y;
  return sum;
}

const table: Record<string, (p: any) => unknown> = { describe, countThenRead, sumAll };
const names = (process.argv[2] ?? "describe,countThenRead").split(",");

function honest(i: number): Point {
  return { x: i, y: i * 2, label: "p" + i };
}

function withGetter(key: "x" | "y" | "label", value: unknown): Point {
  const p = honest(5);
  Object.defineProperty(p, key, {
    get() {
      log.push("get " + key);
      return value;
    },
    enumerable: true,
    configurable: true,
  });
  return p;
}

function withOtherType(key: "x" | "y" | "label", value: unknown): Point {
  const p: any = honest(6);
  p[key] = value;
  return p;
}

function without(key: "x" | "y" | "label"): Point {
  const p: any = honest(7);
  delete p[key];
  return p;
}

const given: Point[] = [honest(1), honest(2)];
for (const key of ["x", "y", "label"] as const) {
  given.push(withGetter(key, key === "label" ? "from a getter" : 40));
  given.push(withGetter(key, undefined));
  given.push(withOtherType(key, key === "label" ? 12 : "twelve"));
  given.push(withOtherType(key, { valueOf: () => (log.push("valueOf " + key), 3), toString: () => (log.push("toString " + key), "obj") }));
  given.push(without(key));
}
given.push(JSON.parse('{"x":"1","y":2,"label":"parsed"}'), JSON.parse('{"x":1,"y":2,"label":null}'), JSON.parse('{"label":"other order","y":2,"x":1}'));
given.push(Object.freeze(honest(8)), Object.create(honest(9)), new Proxy(honest(10), { get: (target, key) => (log.push("trap " + String(key)), (target as any)[key]) }));

for (let round = 0; round < 3; round++) {
  for (const name of names) {
    for (const p of given) {
      let answer: unknown;
      try {
        answer = table[name](p);
      } catch (error) {
        answer = "threw " + (error as Error).constructor.name;
      }
      console.log(round, name, String(answer), "|", log.join(", "), "|", calls);
      log.length = 0;
    }
  }
  try {
    console.log(round, "sumAll", String(table.sumAll(given)), "|", log.join(", "));
  } catch (error) {
    console.log(round, "sumAll threw", (error as Error).constructor.name, "|", log.join(", "));
  }
  log.length = 0;
}
//// a-field-typed-as-a-number-is-the-target-of-loops-patterns-and-parameter-properties.ts
////= show-10

////= Point-5

class Sized {
  constructor(
    public width: number,
    public height: number = 2,
  ) {}
  area(): number {
    return this.width * this.height;
  }
}

class Derived extends Sized {
  depth: number;
  constructor(sizes: number[]) {
    super(sizes[0], sizes[1]);
    this.depth = sizes[2];
  }
  volume(): number {
    return this.area() * this.depth;
  }
}

class Initialized {
  static source: number[] = [1];
  first = Initialized.source[0];
  second = Initialized.source[1];
  both(): number {
    return this.first + this.second;
  }
}

function state(o: object): string {
  return JSON.stringify(o) + " " + Object.keys(o).join();
}

function byForOf(): string {
  const p = new Point();
  for (p.x of new Array<number>(2));
  return typeof p.x + " " + show(p.x + 1) + " " + show(p.sum()) + " " + state(p);
}

function byForOfOverAShortList(): string {
  const p = new Point();
  const list = [5, 6];
  list.length = 3;
  for (p.y of list);
  return typeof p.y + " " + show(p.y * 2) + " " + show(p.sum()) + " " + state(p);
}

function byAListPattern(): string {
  const p = new Point();
  const list = [5];
  [p.x, p.y] = list;
  return typeof p.x + " " + typeof p.y + " " + show(p.sum()) + " " + state(p);
}

function byAnObjectPattern(): string {
  const p = new Point();
  const ages: Record<string, number> = { ann: 30 };
  ({ ann: p.x, bob: p.y } = ages);
  return typeof p.x + " " + typeof p.y + " " + show(p.sum()) + " " + state(p);
}

function byParameterProperties(): string {
  const list = [3];
  const s = new Sized(list[0], list[1]);
  const t = new Sized(list[1], list[0]);
  return show(s.area()) + " " + state(s) + " | " + typeof t.width + " " + show(t.area()) + " " + state(t);
}

function bySuper(): string {
  const d = new Derived([2]);
  const e = new Derived([2, 3, 4]);
  return typeof d.height + " " + typeof d.depth + " " + show(d.area()) + " " + show(d.volume()) + " " + state(d) + " | " + show(e.volume());
}

function byInitializers(): string {
  const i = new Initialized();
  return typeof i.first + " " + typeof i.second + " " + show(i.both()) + " " + state(i);
}

function byIncrement(): string {
  const p = new Point();
  const list = [1];
  p.x = list[3];
  p.x++;
  p.y = list[3];
  p.y += 1;
  return show(p.x) + " " + show(p.y) + " " + state(p);
}

function byAChain(): string {
  const p = new Point();
  const q = new Point();
  const list = [1];
  p.x = q.y = list[3];
  return typeof p.x + " " + typeof q.y + " " + show(p.sum()) + " " + show(q.sum());
}

function byAConditional(pick: boolean): string {
  const p = new Point();
  const list = [1];
  p.x = pick ? list[0] : list[3];
  return typeof p.x + " " + show(p.sum());
}

function honest(i: number): number {
  const p = new Point();
  for (p.x of [i, i + 1]);
  [p.x, p.y] = [p.y, p.x];
  return p.sum() + new Sized(i).area() + new Derived([i, 1, 1]).volume();
}

let total = 0;
for (let i = 0; i < 2000; i++) total += honest(i);
console.log("2000 honest rounds: " + total);
console.log("the target of for of over holes: " + byForOf());
console.log("the target of for of over a list made longer: " + byForOfOverAShortList());
console.log("a list pattern: " + byAListPattern());
console.log("an object pattern: " + byAnObjectPattern());
console.log("parameter properties: " + byParameterProperties());
console.log("arguments of super: " + bySuper());
console.log("initializers: " + byInitializers());
console.log("increments: " + byIncrement());
console.log("a chain: " + byAChain());
console.log("a conditional: " + byAConditional(true) + " | " + byAConditional(false));

export {};
//// a-field-typed-by-an-interface-is-given-what-a-plain-function-constructs.ts
interface Internals { kind: string; limit: number }
interface Schema { internals: Internals; label: string; check(value: unknown): boolean }
interface Issue { code: string; input: unknown; inst?: Schema; schema?: Schema; continue?: boolean }
interface Payload<T = unknown> { value: T; issues: Issue[] }

function construct(this: any, kind: string, limit: number) {
  const inst = this ?? {};
  Object.defineProperty(inst, "internals", { value: { kind, limit }, enumerable: false });
  inst.label = kind + ":" + limit;
  inst.check = function (value: unknown) { return typeof value === kind; };
  return inst;
}
const Constructed = construct as unknown as new (kind: string, limit: number) => Schema;
const record = (kind: string, limit: number): Schema => ({ internals: { kind, limit }, label: kind + "=" + limit, check: value => typeof value === kind });

const pattern = /^SKU-\d+$/;
function checkText(inst: Schema): (payload: Payload<string>) => void {
  return payload => {
    if (pattern.test(payload.value) && payload.value.length <= inst.internals.limit) return;
    payload.issues.push({ code: "text", input: payload.value, inst, continue: !inst.label });
  };
}
function checkNumber(inst: Schema): (payload: Payload<number>) => void {
  return payload => {
    if (payload.value <= inst.internals.limit) return;
    payload.issues.push({ code: "number", input: payload.value, schema: inst });
  };
}
function describe(issue: Issue): string {
  const of = (s: Schema | undefined) => (s === undefined ? "none" : s.label + "/" + s.internals.kind + "/" + s.check(issue.input) + "/" + Object.keys(s).join("+"));
  return [issue.code, String(issue.input), of(issue.inst), of(issue.schema), String(issue.continue), Object.keys(issue).join("+"), "inst" in issue, JSON.stringify(issue)].join(" ");
}

const schemas: Schema[] = [new Constructed("string", 8), record("string", 8), new Constructed("number", 50), record("number", 50)];
const texts = [checkText(schemas[0]), checkText(schemas[1])];
const numbers = [checkNumber(schemas[2]), checkNumber(schemas[3])];
const inputs: unknown[] = ["SKU-1", "SKU-123456789", "other", 7, 70, 50.5];
const seen = new Map<string, number>();
for (let turn = 0; turn < 300; turn++) {
  for (const input of inputs) {
    const payload: Payload = { value: input, issues: [] };
    for (const check of typeof input === "string" ? texts : numbers) (check as (payload: Payload) => void)(payload);
    for (const issue of payload.issues) {
      if (turn % 100 === 99) issue.inst = issue.schema ?? issue.inst;
      if (turn % 150 === 149) delete issue.schema;
      const line = describe(issue);
      seen.set(line, (seen.get(line) ?? 0) + 1);
    }
  }
}
for (const [line, count] of seen) console.log(count, line);
//// a-fluent-method-that-returns-this-is-taken-off.ts
////= show-6

class Builder {
  parts: string[] = [];
  size: number = 0;
  add(part: string): this {
    this.parts.push(part);
    this.size++;
    return this;
  }
  self(): this {
    return this;
  }
  build(): string {
    return this.parts.join("+") + " (" + this.size + ")";
  }
}
class Loud extends Builder {
  volume: number = 11;
  shout(): this {
    this.parts.push("!");
    return this;
  }
}

const builder = new Builder();
show("honest chain", () => builder.add("a").add("b").build());
const { add, self: same, build } = builder;
show("bare add", () => add("c"));
show("bare self", () => same());
show("bare self, then a member", () => same().size);
show("bare self, then a chain", () => same().add("d").build());
show("bare build", () => build());

const like = { parts: ["x"], size: 1 };
show("self on a look-alike is the look-alike", () => builder.self.call(like) === like);
show("add on a look-alike", () => builder.add.call(like, "y") === like);
show("the look-alike afterwards", () => JSON.stringify(like));
show("build on a look-alike", () => builder.build.call(like));
