  lives: string = "nine";
  weight: number = 3.5;
  toys: number[] = [7, 8, 9];
}
//// a-dog-method-in-one-module-gets-a-cat-from-another/honest.ts
import { Dog } from "./animals.ts";
import { dogKeeper } from "./keeper.ts";

export function honest(d: Dog): string {
  return dogKeeper.legsOf(d) + " " + dogKeeper.tagOf(d) + " " + dogKeeper.ownerName(d) + " " + dogKeeper.speak(d);
}

export function honestLegs(count: number): number {
  const d = new Dog("loop");
  let sum = 0;
  for (let i = 0; i < count; i++) sum += dogKeeper.legsOf(d);
  return sum;
}
//// a-dog-method-in-one-module-gets-a-cat-from-another/impostor.ts
import { Animal, Cat } from "./animals.ts";
import type { Keeper } from "./keeper.ts";

export function makeImpostor(): Animal {
  return new Cat("tom");
}

export function tryAll(keeper: Keeper, a: Animal): string[] {
  const out: string[] = [];
  const uses: [string, () => unknown][] = [
    ["legsOf", () => keeper.legsOf(a)],
    ["legsOf + 1", () => keeper.legsOf(a) + 1],
    ["tagOf", () => keeper.tagOf(a)],
    ["ownerName", () => keeper.ownerName(a)],
    ["speak", () => keeper.speak(a)],
  ];
  for (const [label, use] of uses) {
    try {
      const value = use();
      out.push(label + ": " + typeof value + " " + String(value));
    } catch (error) {
      out.push(label + ": threw " + (error instanceof Error ? error.constructor.name : typeof error));
    }
  }
  return out;
}
//// a-dog-method-in-one-module-gets-a-cat-from-another/keeper.ts
import { Animal, Dog } from "./animals.ts";

export interface Keeper {
  legsOf(a: Animal): number;
  tagOf(a: Animal): string;
  ownerName(a: Animal): string;
  speak(a: Animal): string;
}

export class DogKeeper implements Keeper {
  legsOf(d: Dog): number {
    return d.legs;
  }
  tagOf(d: Dog): string {
    return d.tag;
  }
  ownerName(d: Dog): string {
    return d.owner.first;
  }
  speak(d: Dog): string {
    return d.bark();
  }
}

export const dogKeeper = new DogKeeper();
export const keeper: Keeper = dogKeeper;
//// a-dog-method-in-one-module-gets-a-cat-from-another/main.ts
import { Dog } from "./animals.ts";
import { honest, honestLegs } from "./honest.ts";
import { makeImpostor, tryAll } from "./impostor.ts";
import { keeper } from "./keeper.ts";

console.log("honest: " + honest(new Dog("rex")));
console.log("2000 honest: " + honestLegs(2000));
for (const line of tryAll(keeper, makeImpostor())) console.log("cat " + line);
for (const line of tryAll(keeper, new Dog("fido"))) console.log("dog " + line);
console.log("honest again: " + honest(new Dog("rex")));
//// a-field-in-a-subclass-over-an-accessor-of-the-base.ts
const log: string[] = [];

////= lines-28	Base	level	number

class Base {
  hidden = 1;
  read(): number {
    return this.level;
  }
  raise(): number {
    this.level += 1;
    return this.level;
  }
}

Object.defineProperty(Base.prototype, "level", {
  get(this: Base) {
    log.push("get");
    return this.hidden * 10;
  },
  set(this: Base, value: number) {
    log.push("set " + value);
    this.hidden = value;
  },
  configurable: true,
});

class Plain extends Base {}

////= lines-14	class	WithField	extends	Base	level	5

class WithEmptyField extends Base {
  level: number;
  constructor() {
    super();
    log.push("own before the store: " + Object.hasOwn(this, "level"));
    this.level = 6;
  }
}

class WithDeclaredField extends Base {
  declare level: number;
}

////= read-3

////= attempt-17

const makers: [string, () => Base][] = [
  ["the base", () => new Base()],
  ["a plain subclass", () => new Plain()],
  ["a field with an initializer", () => new WithField()],
  ["a field stored by the constructor", () => new WithEmptyField()],
  ["a field that is only declared", () => new WithDeclaredField()],
];

for (const [label, make] of makers) {
  attempt(label + ", made", () => JSON.stringify(make()));
  attempt(label + ", read", () => read(make()));
  attempt(label + ", read by a method of the base", () => make().read());
  attempt(label + ", stored", () => {
    const made = make();
    return write(made, 7) + " hidden " + made.hidden;
  });
  attempt(label + ", raised by a method of the base", () => {
    const made = make();
    return made.raise() + " hidden " + made.hidden;
  });
  attempt(label + ", own", () => Object.hasOwn(make(), "level") + " keys " + Object.keys(make()).join());
}

const honest = new Base();
let warm = 0;
for (let i = 0; i < 2000; i++) warm += write(honest, i) + read(honest);
console.log("2000 with the accessor: " + warm);
for (const [label, make] of makers) attempt("then " + label, () => write(make(), 3) + " " + make().raise());

