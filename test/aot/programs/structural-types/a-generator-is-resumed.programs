//// a-generic-box-is-read-before-it-is-filled.ts
////= text-21

class Box<T> {
  value!: T;
  filled: boolean = false;
  fill(value: T): this {
    this.value = value;
    this.filled = true;
    return this;
  }
  get(): T {
    return this.value;
  }
  getOr(fallback: T): T {
    return this.value ?? fallback;
  }
  map<U>(f: (value: T) => U): U {
    return f(this.value);
  }
}

class Late<T> {
  declare value: T;
  get(): T {
    return this.value;
  }
}

const numbers = new Box<number>();
show("number", () => numbers.get());
show("number + 1", () => numbers.get() + 1);
show("number or", () => numbers.getOr(5));
show("number mapped", () => numbers.map(n => n * 2));
show("number toFixed", () => numbers.map(n => n.toFixed(1)));
show("keys", () => Object.keys(numbers).join());
numbers.fill(4);
show("filled number + 1", () => numbers.get() + 1);
show("filled number mapped", () => numbers.map(n => n * 2));

const strings = new Box<string>();
show("string", () => strings.get());
show("string + '!'", () => strings.get() + "!");
show("string length", () => strings.map(s => s.length));
strings.fill("text");
show("filled string length", () => strings.map(s => s.length));

const people = new Box<Person>();
show("person", () => people.get());
show("person's name", () => people.map(p => p.first));
people.fill(new Person());
show("filled person's name", () => people.map(p => p.first));

const lists = new Box<number[]>();
show("list", () => lists.get());
show("list length", () => lists.map(l => l.length));
const functions = new Box<() => number>();
show("function", () => functions.get());
show("function called", () => functions.map(f => f()));

show("late number", () => new Late<number>().get());
show("late number + 1", () => new Late<number>().get() + 1);
show("late keys", () => Object.keys(new Late<number>()).length);

const boxes: Box<number>[] = [];
for (let i = 0; i < 2000; i++) boxes.push(new Box<number>().fill(1));
boxes.push(new Box<number>());
let sum = 0;
for (let i = 0; i < 2000; i++) sum += boxes[i].get();
show("2000 filled boxes", () => sum);
show("with the empty one", () => sum + boxes[2000].get());
//// a-generic-box-of-dogs-gets-a-cat.ts
////= show-33

class Box<T> {
  label = "box";
  value: T;
  stores = 0;
  constructor(value: T) {
    this.value = value;
  }
  get(): T {
    return this.value;
  }
  set(value: T): void {
    this.stores++;
    this.value = value;
  }
  map<U>(change: (value: T) => U): Box<U> {
    return new Box(change(this.value));
  }
}

interface Slot<T> {
  value: T;
}

function legsIn(box: Box<Dog>): number {
  return box.get().legs + 1;
}

function legsByField(box: Box<Dog>): number {
  return box.value.legs + 1;
}

function barkIn(box: Box<Dog>): string {
  return box.get().bark();
}

function twice(box: Box<number>): number {
  return box.get() * 2;
}

function fill(box: Box<Animal>, animal: Animal): void {
  box.set(animal);
}

function fillSlot(slot: Slot<Animal>, animal: Animal): void {
  slot.value = animal;
}

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = new Box(new Dog("d"));
  fill(honest, new Dog("e"));
  warm += legsIn(honest) + legsByField(honest) + barkIn(honest).length + twice(new Box(i)) + new Box("text").get().length;
}
console.log("after 2000 honest boxes", warm);

function report(name: string, box: Box<Dog>): void {
  attempt(name + ": legs by the method", () => legsIn(box));
  attempt(name + ": legs by the field", () => legsByField(box));
  attempt(name + ": bark", () => barkIn(box));
  attempt(name + ": mapped", () => box.map(dog => dog.legs * 2).get());
  attempt(name + ": the other fields", () => [box.label, box.stores]);
}

{
  const box = new Box(new Dog("rex"));
  const wide: Box<Animal> = box;
  wide.set(new Cat("tom"));
  report("by the method of an alias", box);
}
{
  const box = new Box(new Dog("rex"));
  const wide: Box<Animal> = box;
  wide.value = new Cat("tom");
  report("by the field of an alias", box);
}
{
  const box = new Box(new Dog("rex"));
  fill(box, new Cat("tom"));
  report("in a callee", box);
}
{
  const box = new Box(new Dog("rex"));
  fillSlot(box, new Cat("tom"));
  report("as a slot", box);
}
attempt("a box of numbers gets a string", () => {
  const box = new Box(1);
  const wide: Box<number | string> = box;
  wide.set("one");
  return [twice(box), box.get() + 1, typeof box.value];
});
attempt("a box of numbers gets undefined", () => {
  const box = new Box(1);
  const wide: Box<number | undefined> = box;
  wide.set(undefined);
  return [twice(box), box.get() + 1, typeof box.value];
});
attempt("a box of strings gets a number", () => {
  const box = new Box("text");
  const wide: Box<string | number> = box;
  wide.set(5);
  return [box.get() + "!", typeof box.get(), box.get().length];
});
attempt("boxes of several types in one array", () => {
  const boxes: Box<{}>[] = [new Box(1), new Box("two"), new Box(new Dog("three")), new Box(4.5), new Box(true)];
  return boxes.map(box => box.get());
});
attempt("a box in a box", () => {
  const outer = new Box(new Box(new Dog("rex")));
  const wide: Box<Box<Animal>> = outer;
  wide.get().set(new Cat("tom"));
  const first = outer.get().get().legs;
  wide.set(new Box<Animal>(new Cat("kit")));
