class NumberSink implements Sink<number> {
  sum: number = 0;
  values: number[] = [];
  put(value: number): void {
    this.sum += value;
    this.values.push(value);
  }
}
const numberSink = new NumberSink();
const wideSink: Sink<number | string | undefined> = numberSink;
for (let i = 0; i < 2000; i++) numberSink.put(1);
show("2000 numbers", () => numberSink.sum);
wideSink.put("text");
show("after a string", () => numberSink.sum);
numberSink.sum = 1;
wideSink.put(undefined);
show("after undefined", () => numberSink.sum);
show("the last two values", () => numberSink.values.slice(-2).map(v => typeof v).join());
show("the last value plus one", () => numberSink.values[numberSink.values.length - 1] + 1);
//// a-generic-mixin-keeps-the-type-of-its-base-and-typed-code-reads-both.ts
////= describe-7

function Tagged<B extends new (...args: any[]) => object>(Base: B) {
  return class extends Base {
    tag = "tagged";
    shout(): string {
      return this.tag.toUpperCase();
    }
  };
}

const TaggedPoint = Tagged(Point);
type TaggedPoint = InstanceType<typeof TaggedPoint>;

function total(p: TaggedPoint): number {
  return p.x + p.y + p.tag.length;
}

function move(p: TaggedPoint): void {
  p.x += 10;
  p.tag += "!";
}

const made = new TaggedPoint();
console.log(describe(made));
console.log("read: " + made.x + " " + made.y + " " + made.tag + " " + made.sum() + " " + made.shout() + " " + total(made));
move(made);
console.log("after stores: " + describe(made) + " " + total(made) + " " + made.sum());
let warm = 0;
for (let i = 0; i < 2000; i++) warm += total(new TaggedPoint());
console.log("2000 rounds: " + warm);
//// a-generic-over-array-likes.ts
////= show-30

function total<T extends ArrayLike<number>>(list: T): number {
  let sum = 0;
  for (let i = 0; i < list.length; i++) sum += list[i];
  return sum;
}

function lastOf<T>(list: ArrayLike<T>): T {
  return list[list.length - 1];
}

function toList<T>(list: ArrayLike<T>): T[] {
  const result: T[] = [];
  for (let i = 0; i < list.length; i++) result.push(list[i]);
  return result;
}

function same<T extends ArrayLike<unknown>>(list: T): T {
  return list;
}

function firstOf<T extends { [index: number]: number }>(list: T): number {
  return list[0] + 1;
}

function longer<T extends ArrayLike<unknown>>(a: T, b: T): T {
  return a.length >= b.length ? a : b;
}

class Section<T extends ArrayLike<number>> {
  constructor(private list: T, private start: number) {}
  read(offset: number): number {
    return this.list[this.start + offset];
  }
  sum(count: number): number {
    let sum = 0;
    for (let i = 0; i < count; i++) sum += this.read(i);
    return sum;
  }
}

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = [i, 2, 3];
  warm += total(honest) + lastOf(honest) + toList(honest).length + same(honest).length + firstOf(honest) + longer(honest, [1]).length + new Section(honest, 1).sum(2);
}
console.log("after 2000 arrays", warm);

attempt("total of an array", () => total([1, 2, 3]));
attempt("total of doubles", () => total([0.5, 0.25]));
attempt("total of bytes", () => total(new Uint8Array([200, 100])));
attempt("total of floats", () => total(new Float32Array([0.5, 0.25])));
attempt("total of a literal", () => total({ 0: 1, 1: 2, length: 2 }));
attempt("total of a literal that is too short", () => total({ 0: 1, length: 3 }));
attempt("total of holes", () => total(new Array<number>(2)));
attempt("total of a tuple", () => total([1, 2] satisfies [number, number]));
attempt("last of an array, a string, bytes, a literal", () => [lastOf([1, 2]), lastOf("xyz"), lastOf(new Uint8Array([7, 8])), lastOf({ 0: "only", length: 1 })]);
attempt("last of something empty", () => [lastOf([]), lastOf(""), lastOf(new Uint8Array(0)), lastOf({ length: 0 })]);
attempt("last of a literal that is too short, used as a number", () => lastOf<number>({ 0: 1, length: 2 }) + 1);
attempt("last of a literal that is too short, used as a string", () => lastOf<string>({ 0: "a", length: 2 }).length);
attempt("to a list", () => [toList("ab"), toList(new Int8Array([-1])), toList({ 1: true, length: 2 }), toList(new Array<number>(2))]);
attempt("the list made of holes has no holes", () => 0 in toList(new Array<number>(1)));
attempt("the same comes back", () => [same("text").toUpperCase(), same([1, 2]).concat(3), same(new Uint8Array(2)).byteLength]);
attempt("first of an array, a tuple, a literal, bytes", () => [firstOf([1]), firstOf([2, 3] satisfies [number, number]), firstOf({ 0: 3 }), firstOf(new Uint8Array([4]))]);
attempt("first of an empty array", () => {
  const empty: number[] = [];
  return firstOf(empty);
});
attempt("longer", () => [longer("ab", "abc"), longer([1, 2], [3]), longer<ArrayLike<unknown>>("ab", [1, 2, 3])]);
attempt("a window over an array", () => [new Section([1, 2, 3], 1).sum(2), new Section([1, 2, 3], 1).sum(3)]);
attempt("a window over bytes", () => [new Section(new Uint8Array([1, 2, 3]), 1).sum(2), new Section(new Uint8Array([1, 2, 3]), 1).sum(3)]);
attempt("a window that starts before the array", () => new Section([1, 2, 3], -1).read(0));
//// a-generic-patch-by-pick-carries-members-the-type-forgot.ts
////= show-32

class Settings {
  volume = 5;
  speed = 1.5;
  theme = "dark";
  loud(): boolean {
    return this.volume > 7;
  }
  faster(): number {
    return this.speed * 2;
  }
  banner(): string {
    return this.theme.toUpperCase();
  }
}

function patch<T, K extends keyof T>(target: T, part: Pick<T, K>): void {
  for (const key in part) target[key] = part[key];
}

function report(title: string, s: Settings): void {
  console.log(title + ": " + typeof s.volume + " " + show(s.volume) + ", " + typeof s.speed + " " + show(s.speed) + ", " + typeof s.theme + " " + show(s.theme) + ", keys " + Object.keys(s).join() + ", " + JSON.stringify(s));
  attempt("  loud", () => s.loud());
  attempt("  faster", () => s.faster());
  attempt("  banner", () => s.banner());
}

const s = new Settings();
let total = 0;
for (let i = 0; i < 2000; i++) {
  patch(s, { volume: i % 11 });
  patch(s, { speed: i / 8, theme: "t" + (i % 3) });
  total += (s.loud() ? 1 : 0) + s.faster() + s.banner().length;
}
console.log("2000 honest patches: " + total);
report("honest", s);

const form = { volume: 9, speed: "fast", theme: 3 };
const volumeOnly: { volume: number } = form;
patch(s, volumeOnly);
report("a patch of the volume brings a speed and a theme along", s);

const t = new Settings();
const withAMethod = { theme: "light", loud: "very", banner: 12 };
const themeOnly: { theme: string } = withAMethod;
patch(t, themeOnly);
report("a patch of the theme brings own members over two methods", t);

const u = new Settings();
const unknownMember = { speed: 2, depth: 4 };
const speedOnly: { speed: number } = unknownMember;
patch(u, speedOnly);
report("a patch of the speed brings a member the class never had", u);
report("a fresh instance", new Settings());

