console.log("a string in the fraction: " + describe(p));
attempt("y + 1", () => p.y + 1);
attempt("y * 2", () => p.y * 2);
attempt("y / 2", () => p.y / 2);
attempt("y | 0", () => p.y | 0);
attempt("y === 7", () => p.y === 7);
attempt("y < 10", () => p.y < 10);
attempt("y.toFixed(1)", () => p.y.toFixed(1));
attempt("Math.sqrt(y)", () => Math.sqrt(p.y));
attempt("y += 1", () => (p.y += 1));
console.log("after y += 1: " + describe(p));

set(p, "x", 4);
set(p, "y", 0.5);
console.log("honest again: " + describe(p) + " " + (p.x + p.y));

export {};
//// a-generic-setter-with-a-union-key-writes-into-a-tuple.ts
////= show-32

type Entry = [number, string];
type Wide = [number, string, () => number, { id: number }];

////= set

////= swap

function use(entry: Entry): string {
  return entry[0] + 1 + " " + entry[1].toUpperCase();
}

////= lines-312	destructured	count * 2 + " " + name.length

const yes: boolean = process.argv.length > 0;

function report(title: string, entry: Entry): void {
  console.log(title + ": " + show(entry) + " " + typeof entry[0] + " " + typeof entry[1] + " length " + entry.length);
  attempt("  used", () => use(entry));
  attempt("  destructured", () => destructured(entry));
  attempt("  [0].toFixed(1)", () => entry[0].toFixed(1));
  attempt("  [1].length", () => entry[1].length);
}

let total = 0;
for (let i = 0; i < 2000; i++) {
  const entry: Entry = [0, "a"];
  set(entry, 0, i);
  set(entry, 1, "n" + i);
  total += use(entry).length + destructured(entry).length;
}
console.log("2000 honest rounds: " + total);

const a: Entry = [1, "a"];
set(a, yes ? 0 : 1, "text");
report("a string in the first place", a);
set(a, yes ? 1 : 0, 2);
report("a number in the second place", a);

const b: Entry = [1, "b"];
swap(b, 0, 1);
report("the places are exchanged", b);
swap(b, 0, 1);
report("and back", b);

const c: Entry = [1, "c"];
set(c, yes ? "0" : "1", "by a string key");
report("the key is a string of digits", c);

const d: Entry = [1, "d"];
set(d, yes ? "length" : 0, 1);
report("the length or the first place: the length", d);

const w: Wide = [1, "w", () => 2, { id: 3 }];
swap(w, 0, 2);
swap(w, 1, 3);
console.log("four places, exchanged in pairs: " + typeof w[0] + " " + typeof w[1] + " " + typeof w[2] + " " + typeof w[3]);
attempt("  [0] + 1", () => typeof (w[0] + 1));
attempt("  [1].length", () => w[1].length);
attempt("  [2]()", () => w[2]());
attempt("  [3].id", () => w[3].id);

export {};
//// a-generic-setter-with-a-union-key-writes-into-the-fields-of-a-class.ts
////= show-32

class Point {
  x: number;
  y: number;
  label: string;
  constructor(x: number, y: number, label: string) {
    this.x = x;
    this.y = y;
    this.label = label;
  }
  norm(): number {
    return this.x * this.x + this.y * this.y;
  }
  sum(): number {
    return this.x + this.y;
  }
  shout(): string {
    return this.label.toUpperCase() + "!";
  }
  width(): number {
    return this.label.length;
  }
}

////= set

function describe(p: Point): string {
  return typeof p.x + " " + show(p.x) + ", " + typeof p.y + " " + show(p.y) + ", " + typeof p.label + " " + show(p.label) + ", keys " + Object.keys(p).join() + ", " + JSON.stringify(p) + ", " + (p instanceof Point);
}

function report(title: string, p: Point): void {
  console.log(title + ": " + describe(p));
  attempt("  norm", () => p.norm());
  attempt("  sum", () => p.sum());
  attempt("  shout", () => p.shout());
  attempt("  width", () => p.width());
}

const yes: boolean = process.argv.length > 0;

const p = new Point(3, 0.5, "p");
report("before", p);
set(p, yes ? "x" : "label", "three");
report("a string in x", p);
set(p, yes ? "y" : "label", "half");
report("a string in y too", p);
set(p, yes ? "label" : "x", 12);
report("a number in the label", p);
set(p, "x", 1);
set(p, "y", 2);
set(p, "label", "q");
report("honest again", p);
report("another instance was never touched", new Point(3, 0.5, "p"));

export {};
//// a-generic-stack-holds-integers-fractions-strings-and-objects.ts
////= show-4

const log: string[] = [];

////= attempt-2

class Stack<T> {
  private items: T[] = [];
  push(item: T): number {
    return this.items.push(item);
  }
  pop(): T | undefined {
    return this.items.pop();
  }
  peek(): T {
    return this.items[this.items.length - 1];
  }
  at(index: number): T {
    return this.items[index];
  }
  get size(): number {
    return this.items.length;
  }
  *[Symbol.iterator](): Generator<T> {
    for (let i = 0; i < this.items.length; i++) yield this.items[i];
  }
  fold<U>(start: U, f: (sum: U, item: T) => U): U {
    let sum = start;
    for (const item of this.items) sum = f(sum, item);
    return sum;
  }
}

function filled<T>(...items: T[]): Stack<T> {
  const s = new Stack<T>();
  for (const item of items) s.push(item);
  return s;
}

function sum(s: Stack<number>): number {
  return s.fold(0, (a, b) => a + b);
}

function topPlusOne(s: Stack<number>): number {
  return s.peek() + 1;
}

function letters(s: Stack<string>): number {
  let n = 0;
  for (const word of s) n += word.length;
  return n;
}

attempt("integers", () => [sum(filled(1, 2, 3)), topPlusOne(filled(1, 2, 3))]);
attempt("fractions", () => [sum(filled(0.5, 0.25)), topPlusOne(filled(0.5))]);
attempt("integers then a fraction", () => [sum(filled(1, 2, 0.5)), topPlusOne(filled(1, 0.5))]);
attempt("negative zero", () => [filled(-0).peek(), sum(filled(-0)), filled(-0, -0).fold(-0, (a, b) => a + b)]);
attempt("not a number", () => [sum(filled(1, NaN)), topPlusOne(filled(NaN))]);
attempt("large integers", () => [sum(filled(2147483647, 1)), topPlusOne(filled(2147483647)), sum(filled(-2147483648, -1))]);
attempt("strings", () => letters(filled("a", "bc")));
attempt("objects", () => filled({ n: 1 }, { n: 2 }).fold(0, (a, o) => a + o.n));
attempt("objects of two shapes", () => {
  const wider = { extra: "e", n: 2 };
  return filled<{ n: number }>({ n: 1 }, wider).fold(0, (a, o) => a + o.n);
});
attempt("stacks of stacks", () => filled(filled(1), filled(2, 3)).fold(0, (a, s) => a + sum(s)));
let warm = 0;
for (let i = 0; i < 2000; i++) warm += sum(filled(i, 1)) + topPlusOne(filled(i)) + letters(filled("ab"));
console.log("2000 honest rounds", warm);

attempt("peek at an empty stack", () => topPlusOne(new Stack<number>()));
attempt("peek at an empty stack of strings", () => new Stack<string>().peek().length);
attempt("at past the end", () => filled(1, 2).at(5) + 1);
attempt("at a negative index", () => filled(1, 2).at(-1) + 1);
attempt("at a fraction", () => filled(1, 2).at(0.5) + 1);
attempt("pop until empty", () => {
  const s = filled(1, 2);
  return [s.pop(), s.pop(), s.pop(), s.size];
});
attempt("a stack of numbers seen as wider", () => {
  const numbers = filled(1, 2);
  const wide: Stack<number | string> = numbers;
  wide.push("3");
  return [sum(numbers), topPlusOne(numbers), numbers.size];
});
attempt("a stack of numbers gets undefined", () => {
  const numbers = filled(1, 2);
  const wide: Stack<number | undefined> = numbers;
  wide.push(undefined);
  return [sum(numbers), topPlusOne(numbers)];
});
attempt("a stack of strings gets a number", () => {
  const words = filled("a");
  const wide: Stack<string | number> = words;
  wide.push(5);
  return letters(words);
});
attempt("pushed while iterating", () => {
  const s = filled(1, 2);
  let n = 0;
  for (const item of s) {
    if (s.size < 5) s.push(item * 10);
    n += item;
  }
  return n;
});
attempt("spread and destructured", () => {
  const [first, second, third] = filled(1, 2);
  return [first, second, third, [...filled("a", "b")], Math.max(...filled(3, 9, 4))];
});
//// a-generic-swap-exchanges-a-number-field-and-a-string-field.ts
////= show-32

class Row {
  id = 7;
  ratio = 0.5;
  title = "row";
  done = false;
  next(): number {
    return this.id + 1;
  }
  half(): number {
    return this.ratio / 2;
  }
  shout(): string {
    return this.title.toUpperCase();
  }
}

////= swap

function move<T, K extends keyof T>(target: T, from: K, to: K): void {
  target[to] = target[from];
}

function rotate<T, K extends keyof T>(target: T, keys: K[]): void {
  const first = target[keys[0]];
  for (let i = 0; i + 1 < keys.length; i++) target[keys[i]] = target[keys[i + 1]];
  target[keys[keys.length - 1]] = first;
}

function report(title: string, row: Row): void {
  console.log(title + ": " + typeof row.id + " " + show(row.id) + ", " + typeof row.ratio + " " + show(row.ratio) + ", " + typeof row.title + " " + show(row.title) + ", " + typeof row.done + " " + show(row.done) + ", " + JSON.stringify(row));
  attempt("  next", () => row.next());
  attempt("  half", () => row.half());
  attempt("  shout", () => row.shout());
  attempt("  done ? 1 : 2", () => (row.done ? 1 : 2));
  attempt("  !done", () => !row.done);
}

const a = new Row();
report("before", a);
swap(a, "id", "ratio");
report("two numbers change places", a);
swap(a, "id", "title");
report("a number and a string change places", a);
swap(a, "id", "title");
swap(a, "id", "ratio");
report("put back", a);

const b = new Row();
move(b, "title", "id");
report("the title is moved into the id", b);
move(b, "ratio", "title");
report("the ratio is moved into the title", b);
move(b, "done", "ratio");
report("the flag is moved into the ratio", b);

const c = new Row();
rotate(c, ["id", "ratio", "title", "done"]);
report("all four rotate once", c);
rotate(c, ["id", "ratio", "title", "done"]);
report("twice", c);
rotate(c, ["id", "ratio", "title", "done"]);
rotate(c, ["id", "ratio", "title", "done"]);
report("four times", c);

export {};
