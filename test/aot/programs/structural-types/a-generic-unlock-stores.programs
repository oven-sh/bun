//// a-getter-and-a-setter-of-different-types.ts
////= text-12

class Width {
  raw: number = 0;
  sets: string[] = [];
  get w(): number {
    return this.raw;
  }
  set w(v: number | string) {
    this.sets.push(typeof v);
    this.raw = typeof v === "string" ? v.length : v;
  }
}

class Keeps {
  raw: number | string = 0;
  get w(): number | string {
    return this.raw;
  }
  set w(v: number) {
    this.raw = v === 0 ? "zero" : v;
  }
}

class Unrelated {
  stored: string = "";
  get v(): number {
    return this.stored.length;
  }
  set v(text: string) {
    this.stored = text;
  }
}

const literal = {
  raw: 1,
  get half(): number {
    return this.raw / 2;
  },
  set half(v: number | boolean) {
    this.raw = v === true ? 100 : v === false ? 0 : v * 2;
  },
};

const width = new Width();
show("start", () => width.w);
show("the value of a store of a string", () => (width.w = "four"));
show("read back", () => width.w);
show("the value of a store of a number", () => (width.w = 2.5));
show("read back", () => width.w);
show("+=", () => (width.w += 1));
show("read back", () => width.w);
show("++ after", () => width.w++);
show("read back", () => width.w);
show("++ before", () => ++width.w);
show("sets", () => width.sets.join());

function asPlain(o: { w: number }): number {
  o.w = o.w + 10;
  return o.w;
}
show("as a plain number property", () => asPlain(width));
show("a plain object at the same function", () => asPlain({ w: 1 }));
show("sets", () => width.sets.join());

const keeps = new Keeps();
keeps.w = 5;
show("keeps 5", () => keeps.w);
keeps.w = 0;
show("keeps 0", () => keeps.w);
show("keeps: the value of the store", () => (keeps.w = 0));

const unrelated = new Unrelated();
unrelated.v = "hello";
show("unrelated read", () => unrelated.v);
show("unrelated read + 1", () => unrelated.v + 1);
show("unrelated: the value of the store", () => (unrelated.v = "ab"));
show("unrelated read", () => unrelated.v);

show("literal half", () => literal.half);
literal.half = true;
show("literal half after true", () => literal.half);
literal.half = 4;
show("literal half after 4", () => literal.half);
show("literal keys", () => Object.keys(literal).join());
show("literal as JSON", () => JSON.stringify(literal));

let sum = 0;
for (let i = 0; i < 2000; i++) {
  width.w = i;
  sum += width.w;
}
show("2000 numbers", () => sum);
width.w = "abc";
show("then a string", () => width.w);
//// a-getter-answers-differently-after-narrowing.ts
////= show-4

const log: string[] = [];

////= attempt-2

type Shape = { kind: "circle"; radius: number } | { kind: "square"; side: number };

////= area-2

function double(o: { readonly v: number | string }): number | string {
  return typeof o.v === "number" ? o.v * 2 : "text: " + o.v;
}

function fixed(o: { readonly v: number | string }): string {
  if (typeof o.v === "number") return o.v.toFixed(1);
  return o.v.toUpperCase();
}

function lengthOf(o: { name: string | null }): number {
  return o.name === null ? -1 : o.name.length;
}

function callIt(o: { f?: () => number }): number {
  return o.f ? o.f() : -1;
}

function alternating(): { readonly v: number | string } {
  let reads = 0;
  return {
    get v() {
      log.push("get-v");
      return reads++ % 2 === 0 ? 1 : "text";
    },
  };
}

class Flicker {
  #reads = 0;
  get v(): number | string {
    return this.#reads++ % 2 === 0 ? 1 : "text";
  }
  get name(): string | null {
    return this.#reads++ % 2 === 0 ? "name" : null;
  }
  set name(value: string | null) {}
  get f(): (() => number) | undefined {
    return this.#reads++ % 2 === 0 ? () => 5 : undefined;
  }
}

function flickeringShape(): Shape {
  let reads = 0;
  return {
    get kind(): "square" | "circle" {
      log.push("get-kind");
      return reads++ % 2 === 0 ? "square" : "circle";
    },
    radius: 2,
    side: 5,
  };
}

attempt("honest double", () => [double({ v: 2 }), double({ v: "a" })]);
attempt("honest fixed", () => [fixed({ v: 2 }), fixed({ v: "a" })]);
attempt("honest lengthOf", () => [lengthOf({ name: "ab" }), lengthOf({ name: null })]);
attempt("honest callIt", () => [callIt({ f: () => 1 }), callIt({})]);
attempt("honest area", () => [area({ kind: "circle", radius: 1 }), area({ kind: "square", side: 2 })]);
let warm = 0;
for (let i = 0; i < 2000; i++) warm += Number(double({ v: i })) + fixed({ v: i }).length + lengthOf({ name: "ab" }) + callIt({ f: () => i }) + area({ kind: "square", side: i });
console.log("2000 honest rounds", warm);

attempt("a literal's getter: double", () => double(alternating()));
attempt("a literal's getter: fixed", () => fixed(alternating()));
attempt("a class's getter: double", () => double(new Flicker()));
attempt("a class's getter: fixed", () => fixed(new Flicker()));
attempt("a class's getter: lengthOf", () => lengthOf(new Flicker()));
attempt("a class's getter: callIt", () => callIt(new Flicker()));
attempt("the tag is a getter: area", () => area(flickeringShape()));
attempt("the tag is a getter: twice", () => {
  const s = flickeringShape();
  return [area(s), area(s), area(s)];
});
attempt("the tag is a getter: if", () => {
  const s = flickeringShape();
  if (s.kind === "square") return s.kind + ":" + s.side;
  return s.kind + ":" + s.radius;
});
attempt("in a field", () => {
  class Holder {
    o: { readonly v: number | string } = alternating();
    read(): number | string {
      return typeof this.o.v === "number" ? this.o.v + 1 : this.o.v + "!";
    }
  }
  return new Holder().read();
});
attempt("in an element", () => {
  const list: { readonly v: number | string }[] = [{ v: 1 }, alternating(), { v: "z" }];
  return list.map(double);
});
attempt("honest again", () => [double({ v: 2 }), fixed({ v: 2 }), lengthOf({ name: "ab" }), callIt({ f: () => 1 }), area({ kind: "circle", radius: 1 })]);
//// a-getter-arrives-after-2000-plain-reads-and-stores.ts
////= lines-27	Cell	value	number	next	number

const log: string[] = [];

////= lines-20	read	c	Cell	number	return	c.value

////= lines-80	write	c	Cell	v	number	c.value

function shift(c: Cell): number {
  c.value = c.next;
  c.next = c.value + 1;
  return c.value;
}

////= lines-93	accumulate	cells	Cell	sum	value

////= flush

function accessor(): Cell {
  let stored = 100;
  return {
    get value() {
      log.push("get value");
      return stored;
    },
    set value(v: number) {
      log.push("set value " + v);
      stored = v * 2;
    },
    next: 5,
  };
}

const plain: Cell = { value: 0, next: 1 };
let sum = 0;
for (let i = 0; i < 2000; i++) {
  write(plain, i);
  sum += read(plain) + shift(plain);
}
flush("2000 honest rounds", sum);

const odd = accessor();
flush("read", read(odd));
flush("write", write(odd, 7));
flush("read back", read(odd));
flush("shift", shift(odd));
flush("plain again", (write(plain, 3), read(plain)));
flush("odd again", read(odd));

const many: Cell[] = [];
for (let i = 0; i < 2000; i++) many.push({ value: 1, next: 0 });
flush("2000 plain elements", accumulate(many));
many[1000] = accessor();
flush("one accessor among them", accumulate(many));
many[1000] = { next: 0, value: 1 };
flush("one of another order among them", accumulate(many));

const turning: Cell = { value: 1, next: 2 };
const seen: number[] = [];
for (let i = 0; i < 6; i++) {
  seen.push(read(turning));
  if (i === 2) {
    Object.defineProperty(turning, "value", {
      get() {
        log.push("late getter");
        return -1;
      },
      set(v: number) {
        log.push("late setter " + v);
      },
      enumerable: true,
      configurable: true,
    });
  }
  write(turning, i + 10);
}
flush("one object turns in the middle of a loop", seen.join());

Object.defineProperty(turning, "value", { value: 50, writable: true, enumerable: true, configurable: true });
flush("and turns back", (write(turning, 51), read(turning)));

class Box {
  cell: Cell = { value: 1, next: 1 };
  read(): number {
    return this.cell.value + this.cell.next;
  }
}

const box = new Box();
let boxed = 0;
for (let i = 0; i < 2000; i++) boxed += box.read();
flush("2000 reads through a field", boxed);
box.cell = accessor();
flush("the field now holds the accessor", box.read());

