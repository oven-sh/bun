//// a-grid-of-numbers-gets-a-string-row.ts
////= show-30

function sum(grid: number[][]): number {
  let total = 0;
  for (let i = 0; i < grid.length; i++) {
    const row = grid[i];
    for (let j = 0; j < row.length; j++) total += row[j];
  }
  return total;
}

function sumByForOf(grid: number[][]): number {
  let total = 0;
  for (const row of grid) for (const cell of row) total += cell;
  return total;
}

function rowLengths(grid: number[][]): number[] {
  return grid.map(row => row.length);
}

function rowKinds(grid: number[][]): string[] {
  return grid.map(row => typeof row + (Array.isArray(row) ? " array" : ""));
}

function corner(grid: number[][]): number {
  return grid[grid.length - 1][0] * 2;
}

function rowSums(grid: number[][]): number[] {
  return grid.map(row => row.reduce((total, cell) => total + cell, 0));
}

function transpose(grid: number[][]): number[][] {
  const result: number[][] = [];
  for (let j = 0; j < grid[0].length; j++) {
    const column: number[] = [];
    for (let i = 0; i < grid.length; i++) column.push(grid[i][j]);
    result.push(column);
  }
  return result;
}

function make(): number[][] {
  return [[1, 2, 3], [4.5, 5.5, 6.5]];
}

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = make();
  warm += sum(honest) + sumByForOf(honest) + rowLengths(honest)[0] + rowKinds(honest).length + corner(honest) + rowSums(honest)[1] + transpose(honest).length;
}
console.log("after 2000 honest grids", warm);

function report(name: string, grid: number[][]): void {
  attempt(name + ": the grid", () => grid);
  attempt(name + ": sum", () => sum(grid));
  attempt(name + ": sum by for-of", () => sumByForOf(grid));
  attempt(name + ": lengths of the rows", () => rowLengths(grid));
  attempt(name + ": kinds of the rows", () => rowKinds(grid));
  attempt(name + ": corner * 2", () => corner(grid));
  attempt(name + ": sums of the rows", () => rowSums(grid));
  attempt(name + ": transposed", () => transpose(grid));
}

{
  const grid = make();
  const wide: (number[] | string)[] = grid;
  wide.push("789");
  report("a string as a row", grid);
}
{
  const grid = make();
  const wide: (number[] | string)[] = grid;
  wide[0] = "";
  report("an empty string as the first row", grid);
}
{
  const grid = make();
  const wide: (number | string)[][] = grid;
  wide.push(["7", "8", "9"]);
  report("a row of strings", grid);
}
{
  const grid = make();
  const wide: (number | string)[][] = grid;
  wide[1][1] = "x";
  report("a string in a row of doubles", grid);
}
{
  const grid = make();
  const wide: (number | string)[][] = grid;
  wide[0].push("x");
  report("a string pushed into a row of integers", grid);
}
{
  const grid = make();
  const wide: ArrayLike<number>[] = grid;
  wide.push(new Float64Array([7.5, 8.5, 9.5]));
  report("a typed array as a row", grid);
}
{
  const grid = make();
  const wide: ArrayLike<number>[] = grid;
  wide.push({ 0: 7, 1: 8, length: 3 });
  report("an array-like literal as a row", grid);
}
{
  const grid = make();
  const wide: (number[] | undefined)[] = grid;
  wide.push(undefined);
  report("undefined as a row", grid);
}
report("honest again", make());
//// a-hand-written-stack-is-popped-below-its-bottom.ts
////= show-32

class Stack<T> {
  private items: T[] = [];
  private top = 0;
  push(item: T): void {
    this.items[this.top++] = item;
  }
  pop(): T {
    return this.items[--this.top];
  }
  peek(): T {
    return this.items[this.top - 1];
  }
  get size(): number {
    return this.top;
  }
  state(): string {
    return "top " + this.top + ", length " + this.items.length + ", keys " + Object.keys(this.items).join();
  }
}

////= Point-7

function addTwo(stack: Stack<number>): number {
  return stack.pop() + stack.pop();
}

function glueTwo(stack: Stack<string>): string {
  return stack.pop().toUpperCase() + stack.pop().toUpperCase();
}

let total = 0;
const warmNumbers = new Stack<number>();
const warmStrings = new Stack<string>();
for (let i = 0; i < 2000; i++) {
  warmNumbers.push(i);
  warmNumbers.push(0.5);
  warmStrings.push("a");
  warmStrings.push("b");
  total += addTwo(warmNumbers) + glueTwo(warmStrings).length;
}
console.log("2000 honest rounds: " + total + ", " + warmNumbers.state());

const numbers = new Stack<number>();
attempt("peek at an empty stack of numbers", () => [typeof numbers.peek(), numbers.peek() + 1]);
attempt("pop an empty stack of numbers", () => [typeof numbers.pop(), numbers.size, numbers.state()]);
attempt("push after that: the item lands at minus one", () => {
  numbers.push(7);
  return [numbers.size, numbers.state(), typeof numbers.peek()];
});
attempt("pop again: it comes back", () => [numbers.pop(), numbers.size, numbers.state()]);
attempt("two pops are added", () => {
  const stack = new Stack<number>();
  stack.push(1);
  return [addTwo(stack), stack.state()];
});

const strings = new Stack<string>();
attempt("peek at an empty stack of strings", () => [typeof strings.peek(), strings.peek() + "!"]);
attempt("a method of what is popped off an empty stack", () => strings.pop().length);
attempt("two pops are glued", () => {
  const stack = new Stack<string>();
  stack.push("a");
  return glueTwo(stack);
});

const points = new Stack<Point>();
attempt("a member of what is popped off an empty stack", () => points.pop().x);
const functions = new Stack<() => number>();
attempt("what is popped off an empty stack is called", () => functions.pop()());

attempt("what was popped is still in the list", () => {
  const stack = new Stack<number>();
  stack.push(1);
  stack.push(2);
  stack.pop();
  return [stack.size, stack.state(), stack.peek()];
});
attempt("honest again", () => {
  warmNumbers.push(3);
  warmNumbers.push(4);
  return [addTwo(warmNumbers), warmNumbers.state()];
});

