//// a-handler-that-is-a-proxy-logs-every-trap-lookup.ts
////= show-30

const log: string[] = [];

////= logged

class Item {
  price = 5;
  name = "item";
  note?: string;
  total(count: number): number {
    return this.price * count;
  }
}

function spied<T extends object>(target: T): T {
  const handler = new Proxy<ProxyHandler<T>>({}, {
    get(_, trap) {
      log.push(String(trap));
      return undefined;
    },
  });
  return new Proxy(target, handler);
}

const uses: [string, (item: Item) => unknown][] = [
  ["a read", item => item.price],
  ["a store", item => (item.price = 6)],
  ["++", item => item.price++],
  ["a call", item => item.total(2)],
  ["in", item => "price" in item],
  ["delete", item => delete item.note],
  ["keys", item => Object.keys(item)],
  ["for-in", item => {
    let count = 0;
    for (const _ in item) count++;
    return count;
  }],
  ["JSON", item => JSON.stringify(item)],
  ["spread", item => Object.keys({ ...item })],
  ["rest", item => {
    const { price, ...others } = item;
    return [price, Object.keys(others)];
  }],
  ["Object.assign from it", item => Object.keys(Object.assign({}, item))],
  ["Object.assign onto it", item => Object.assign(item, { price: 1 }).price],
  ["instanceof", item => item instanceof Item],
  ["getPrototypeOf", item => Object.getPrototypeOf(item) === Item.prototype],
  ["setPrototypeOf", item => Object.setPrototypeOf(item, Item.prototype) === item],
  ["hasOwn", item => Object.hasOwn(item, "price")],
  ["defineProperty", item => Object.defineProperty(item, "price", { value: 1 }).price],
  ["freeze", item => Object.isFrozen(Object.freeze(item))],
  ["seal", item => Object.isSealed(Object.seal(item))],
  ["isExtensible", item => Object.isExtensible(item)],
  ["entries", item => Object.entries(item).length],
  ["String()", item => String(item)],
  ["a template", item => `${item}`],
  ["==", item => item == item],
  ["typeof", item => typeof item],
  ["a tag", item => Object.prototype.toString.call(item)],
  ["isArray", item => Array.isArray(item)],
  ["await", item => typeof Promise.resolve(item)],
  ["a key of a map", item => new Map([[item, 1]]).get(item)],
  ["a weak key", item => new WeakMap([[item, 1]]).get(item)],
];
for (const [, use] of uses) for (let i = 0; i < 300; i++) use(new Item());
console.log("after 300 honest items at every use");

for (const [name, use] of uses) logged(name, () => use(spied(new Item())));
logged("a function: called", () => spied((value: number) => value + 1)(1));
logged("a class: constructed", () => new (spied(Item))().price);
logged("an array: push", () => spied([1, 2]).push(3));
logged("an array: for-of", () => {
  let sum = 0;
  for (const value of spied([1, 2])) sum += value;
  return sum;
});
//// a-heterogeneous-enum-holds-numbers-and-strings.ts
////= show-35

enum Answer {
  No = 0,
  Yes = "YES",
  Maybe = 2,
  Never = "",
}

////= lines-57	kindOf	answer	Answer

function nameOf(answer: Answer): string {
  switch (answer) {
    case Answer.No:
      return "no";
    case Answer.Yes:
      return "yes";
    case Answer.Maybe:
      return "maybe";
    case Answer.Never:
      return "never";
  }
}

function split(answer: Answer): string {
  if (typeof answer === "number") return "number " + show(answer + 1);
  return "string " + show(answer.length);
}

function truthy(answer: Answer): string {
  if (answer) return "truthy " + (answer === Answer.Yes ? "yes" : "maybe " + show(answer));
  return "falsy " + (answer === Answer.No ? "no" : "never " + show(answer));
}

class Vote {
  answer: Answer = Answer.No;
  constructor(answer: Answer) {
    this.answer = answer;
  }
  text(): string {
    return nameOf(this.answer) + ":" + split(this.answer);
  }
}

attempt("keys", () => Object.keys(Answer));
attempt("entries", () => Object.entries(Answer));
attempt("members", () => [Answer.No, Answer.Yes, Answer.Maybe, Answer.Never]);
attempt("reverse", () => [Answer[0], Answer[2], Answer[1]]);

const honest: Answer[] = [Answer.No, Answer.Yes, Answer.Maybe, Answer.Never];
let warm = 0;
for (let i = 0; i < 2000; i++) {
  const answer = honest[i % 4];
  warm += kindOf(answer).length + nameOf(answer).length + split(answer).length + truthy(answer).length + new Vote(answer).text().length;
}
console.log("2000 honest rounds", warm);
for (const answer of honest) attempt("honest " + show(answer), () => [kindOf(answer), nameOf(answer), split(answer), truthy(answer), new Vote(answer).text()]);

const numbers: number[] = [1, 3, -0, 0.5, NaN, 2 ** 31, -1];
for (const n of numbers) {
  const answer: Answer = n;
  const label = show(n);
  attempt(label + " kind", () => kindOf(answer));
  attempt(label + " name", () => nameOf(answer));
  attempt(label + " split", () => split(answer));
  attempt(label + " truthy", () => truthy(answer));
  attempt(label + " in a field", () => new Vote(answer).text());
  attempt(label + " in a list", () => {
    const votes: Answer[] = [Answer.Yes, answer, Answer.Never];
    return [votes, votes.map(nameOf), votes.map(kindOf), votes.indexOf(answer), votes.includes(answer)];
  });
}
//// a-heterogeneous-enum-value-is-asked-for-its-type.ts
////= lines-70	Answer	No	0	Yes	"YES"

function kind(answer: Answer): string {
  if (typeof answer === "number") return answer === Answer.No ? "no" : "another number " + answer;
  return answer === Answer.Yes ? "yes" : "another string";
}
function truth(answer: Answer): string {
  return answer ? (answer === Answer.Yes ? "yes" : "truthy, not yes: " + answer) : answer === Answer.No ? "no" : "falsy, not no";
}

const numbers: number[] = [0, 1, -0, 0.5];
console.log(kind(Answer.No), kind(Answer.Yes), truth(Answer.No), truth(Answer.Yes));
for (const n of numbers) {
  const answer: Answer = n;
  console.log(kind(answer), "|", truth(answer));
}
const nan: number = NaN;
console.log(kind(nan), "|", truth(nan));
