//// a-getter-on-the-prototype-is-covered-by-an-own-data-member.ts
const log: string[] = [];

class Box {
  width = 2;
  height = 3;
  get area(): number {
    log.push("get area");
    return this.width * this.height;
  }
  get label(): string {
    log.push("get label");
    return "box";
  }
  set label(value: string) {
    log.push("set label " + value);
  }
  doubled(): number {
    return this.area * 2;
  }
}

////= Holder-11	public	box	Box	ask	box.area

////= lines-20	byParameter	b	Box	number	return	b.area

function byElement(list: Box[]): number {
  return list[0].area;
}

////= lines-20	labelOf	b	Box	string	return	b.label

function relabel(b: Box, value: string): string {
  b.label = value;
  return b.label;
}

const changed = new Box();
const honest = new Box();
const holder = new Holder(changed);
const list = [changed];
const captured = (): number => changed.area;

function everywhere(label: string): void {
  const local = changed;
  const values = [changed.area, local.area, byParameter(changed), holder.ask(), byElement(list), captured(), changed.doubled()];
  console.log(label + ": " + values.join(" ") + ", getter ran " + log.length + " times");
  log.length = 0;
  console.log(label + ", the label: " + labelOf(changed) + " " + relabel(changed, "new") + " [" + log.join(", ") + "]");
  log.length = 0;
  console.log(label + ", the honest one: " + byParameter(honest) + " " + honest.doubled() + " " + labelOf(honest) + ", own " + Object.hasOwn(changed, "area") + " " + Object.hasOwn(changed, "label") + ", keys " + Object.keys(changed).join() + ", json " + JSON.stringify(changed));
  log.length = 0;
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += byParameter(changed) + holder.ask() + byElement(list) + captured() + changed.doubled() + labelOf(changed).length;
log.length = 0;
console.log("2000 honest: " + warm);
everywhere("before");

Object.defineProperty(changed, "area", { value: 99, writable: true, enumerable: true, configurable: true });
everywhere("area is an own value");

Object.defineProperty(changed, "label", { value: "own label", writable: true, enumerable: true, configurable: true });
everywhere("label is an own value too");

changed.width = 10;
everywhere("after a store to the width");

Reflect.deleteProperty(changed, "area");
Reflect.deleteProperty(changed, "label");
everywhere("uncovered");

Object.defineProperty(changed, "area", { value: undefined, configurable: true });
everywhere("an own undefined that is not listed");

Object.defineProperty(changed, "area", {
  get() {
    log.push("own getter");
    return -1;
  },
  configurable: true,
});
everywhere("an own getter");

Reflect.deleteProperty(changed, "area");
everywhere("restored");

export {};
//// a-getter-on-the-prototype-where-the-type-says-a-plain-member.ts
////= lines-27	Named	name	string	rank	number

const log: string[] = [];

class Computed {
  constructor(private seed: number) {}
  get name(): string {
    log.push("name");
    return "computed" + this.seed;
  }
  get rank(): number {
    log.push("rank");
    return this.seed * 2;
  }
}

////= lines-14	class	Deep	extends	Computed	extra	"extra"

class Half {
  name = "half";
  get rank(): number {
    log.push("half rank");
    return 50;
  }
}

const base = {
  get name(): string {
    log.push("base name");
    return "from the base";
  },
  get rank(): number {
    log.push("base rank");
    return 7;
  },
};
const created: Named = Object.create(base);
const twoLevels: Named = Object.create(Object.create(base));

function flush(label: string, value: unknown): void {
  console.log(label + ": " + String(value) + " [" + log.join() + "]");
  log.length = 0;
}

////= lines-78	card	n	Named	n.name	"#"	n.rank

////= lines-78	reversed	n	Named	n.rank	"#"	n.name

function listing(n: Named): string {
  const walked: string[] = [];
  for (const key in n) walked.push(key);
  return "keys " + Object.keys(n).join() + " for-in " + walked.join() + " json " + JSON.stringify(n) + " spread " + JSON.stringify({ ...n });
}

const table: [string, Named][] = [
  ["plain", { name: "plain", rank: 1 }],
  ["class getters", new Computed(4)],
  ["inherited class getters", new Deep(5)],
  ["one field, one getter", new Half()],
  ["Object.create", created],
  ["two levels of Object.create", twoLevels],
];

for (const [label, n] of table) {
  flush(label + ", name then rank", card(n));
  flush(label + ", rank then name", reversed(n));
  flush(label + ", listing", listing(n));
  flush(label + ", own", Object.hasOwn(n, "name") + " " + Object.hasOwn(n, "rank") + " " + ("name" in n));
}

class Badge {
  constructor(public holder: Named) {}
  print(): string {
    return "[" + this.holder.name + "]";
  }
}

for (const [label, n] of table) flush(label + ", field", new Badge(n).print());

const everyone = table.map(row => row[1]);
flush("sorted by rank", everyone.toSorted((a, b) => a.rank - b.rank).length);
flush("names", everyone.map(n => n.name).join());

let length = 0;
const plain: Named = { name: "plain", rank: 1 };
for (let i = 0; i < 2000; i++) length += card(plain).length;
flush("2000 honest", length);
flush("then class getters", card(new Computed(9)));
flush("then Object.create", card(created));
flush("then plain", card(plain));

const thisSeen: unknown[] = [];
const watcher = {
  get name(): string {
    thisSeen.push(this);
    return "watcher";
  },
  rank: 0,
};
const child: Named = Object.create(watcher);
card(child);
console.log("the getter's this is the object that was read: " + (thisSeen[0] === child) + " " + (thisSeen[0] === watcher));

export {};
//// a-getter-replaces-itself-with-a-value-on-its-first-read.ts
const log: string[] = [];

class Report {
  rows: number[];
  constructor(...rows: number[]) {
    this.rows = rows;
  }
  get total(): number {
    log.push("computed");
    let sum = 0;
    for (const row of this.rows) sum += row;
    Object.defineProperty(this, "total", { value: sum, configurable: true });
    return sum;
  }
  get shared(): string {
    log.push("shared computed");
    Object.defineProperty(Report.prototype, "shared", { value: "shared by " + this.rows.length, configurable: true });
    return "first read";
  }
  summary(): string {
    return this.total + " of " + this.rows.length;
  }
}

////= lines-20	totalOf	r	Report	number	return	r.total

////= lines-68	twice	r	Report	number	r.total	r.total

////= line

const a = new Report(1, 2, 3);
line("the first read", totalOf(a));
line("the second read", totalOf(a));
line("own now", Object.hasOwn(a, "total") + " keys " + Object.keys(a).join());
a.rows.push(100);
line("the rows changed, the value stays", totalOf(a) + " " + a.summary());
Reflect.deleteProperty(a, "total");
line("forgotten", totalOf(a) + " " + a.summary());

line("two reads in one expression", twice(new Report(5)));
line("through a method", new Report(7).summary());

const many: Report[] = [];
for (let i = 0; i < 2000; i++) many.push(new Report(i, 1));
let sum = 0;
for (const r of many) sum += totalOf(r) + totalOf(r);
line("2000 reports, two reads each, computed " + log.length + " times", sum);

line("the shared getter, first", a.shared);
line("second", a.shared);
line("another instance", new Report().shared);

export {};
//// a-getter-that-throws-where-the-type-says-a-plain-member.ts
////= lines-27	Config	port	number	host	string

class Unavailable extends Error {}

const log: string[] = [];

const throwing: Config = {
  get port(): number {
    log.push("port");
    throw new Unavailable("port");
  },
  get host(): string {
    log.push("host");
    throw new RangeError("host");
  },
};

const second: Config = {
  port: 80,
  get host(): string {
    log.push("host");
    throw new Unavailable("host");
  },
};

class Lazy {
  get port(): number {
    log.push("lazy port");
    throw new SyntaxError("port");
  }
  host = "lazy";
}

////= attempt-15

////= address

////= lines-78	portFirst	c	Config	c.port	"@"	c.host

function guarded(c: Config): string {
  let port = -1;
  let host = "none";
  try {
    port = c.port;
  } catch {
    log.push("caught port");
  }
  try {
    host = c.host;
  } catch {
    log.push("caught host");
  } finally {
    log.push("finally");
  }
  return host + ":" + port;
}

function dropped(c: Config): string {
  c.port;
  return "survived";
}

const table: [string, Config][] = [
  ["plain", { port: 1, host: "plain" }],
  ["both throw", throwing],
  ["host throws", second],
  ["a getter of a class throws", new Lazy()],
];

for (const [label, c] of table) {
  attempt(label + ", host first", () => address(c));
  attempt(label + ", port first", () => portFirst(c));
  attempt(label + ", guarded", () => guarded(c));
  attempt(label + ", value dropped", () => dropped(c));
  attempt(label + ", json", () => JSON.stringify(c));
  attempt(label + ", spread", () => JSON.stringify({ ...c }));
  attempt(label + ", keys", () => Object.keys(c).join());
  attempt(label + ", values", () => Object.values(c).join());
  attempt(label + ", pattern", () => (({ host, port }: Config) => host + port)(c));
  attempt(label + ", pattern with a default parameter", () => ((config: Config, port = config.port) => port)(c));
  attempt(label + ", template", () => `${c.port}/${c.host}`);
  attempt(label + ", argument order", () => [log.push("before"), c.port, log.push("after")].length);
}

const plain: Config = { port: 1, host: "plain" };
let total = 0;
for (let i = 0; i < 2000; i++) total += address(plain).length;
console.log("2000 honest: " + total);
attempt("then the throwing one", () => address(throwing));
attempt("then plain", () => address(plain));

let reached = 0;
try {
  for (const c of [plain, plain, second, plain]) {
    address(c);
    reached++;
  }
} catch (error) {
  console.log("the loop stopped after " + reached + " with " + (error instanceof Unavailable));
}

export {};
//// a-getter-where-a-number-member-is-read-twice.ts
////= lines-28	Sample	value	number

let reads = 0;

////= lines-159	twice	s	Sample	s.value	10	s.value

const counting: Sample = {
  get value() {
    return ++reads;
  },
};

console.log(twice({ value: 3 }));
console.log(twice(counting));
console.log(reads);
