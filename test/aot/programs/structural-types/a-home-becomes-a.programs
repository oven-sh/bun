// A host object and built-in objects satisfy an object type of the program's own and are stored into a field of a class and of a literal declared with it.
type Sized = { length: number };
type Platform = { platform: string; env: Record<string, string | undefined> };

class Probe {
  constructor(private readonly host: Platform = process) {}
  kind(): string {
    return typeof this.host.platform + " " + typeof this.host.env.PATH + " " + (this.host === process);
  }
}
function wrap(sized: Sized) {
  return { sized, twice: sized.length * 2 };
}
function measure(box: { sized: Sized; twice: number }): string {
  return box.sized.length + " " + box.twice + " " + typeof box.sized;
}
console.log(new Probe().kind());
console.log(new Probe({ platform: "none", env: {} }).kind());
console.log(new Probe().kind());
const boxes = [wrap("four"), wrap([1, 2, 3]), wrap({ length: 9 }), wrap(function (a: number, b: number) {}), wrap(new Uint8Array(5))];
for (const box of boxes) console.log(measure(box));
const box = wrap({ length: 1 });
for (const sized of ["ab", [1], { length: 7 }, new Float64Array(2)] as Sized[]) {
  box.sized = sized;
  console.log(measure(box));
}
//// a-javascript-caller-reaches-int32-parameters-and-fields/caller.js
import { Cursor, lineOf, table, uses } from "./typed.ts";

export const ways = {
  "out of a table": n => table.uses(n),
  "by call": n => uses.call(null, n),
  "by apply": n => uses.apply(null, [n]),
  "bound": n => uses.bind(null, n)(),
  "as a callback": n => [n].map(uses)[0],
  "under another name": n => {
    const run = uses;
    return run(n);
  },
  "out of a list": n => [uses][0](n),
  "by Reflect.apply": n => Reflect.apply(uses, undefined, [n]),
  "stored in a field": n => {
    const cursor = new Cursor(1);
    cursor.line = n;
    return [lineOf(cursor), cursor.lineOf(), cursor.sum(), cursor.plainSum(), JSON.stringify(cursor)];
  },
  "stored in a field by a computed name": n => {
    const cursor = new Cursor(1);
    cursor[["li", "ne"].join("")] = n;
    return [lineOf(cursor), cursor.lineOf(), cursor.sum(), cursor.plainSum()];
  },
  "constructed by Reflect.construct": n => {
    const cursor = Reflect.construct(Cursor, [n]);
    return [lineOf(cursor), cursor.sum(), cursor.plainSum()];
  },
  "a look-alike is handed over": n => lineOf({ line: n, column: 0 }),
};

export function withNothing() {
  const run = uses;
  return run();
}
