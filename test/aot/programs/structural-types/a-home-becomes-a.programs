console.log("filter " + list.filter(n => n === undefined).length);
console.log("filter by typeof " + list.filter(n => typeof n !== "number").length);
console.log("map " + list.map(n => typeof n).join());
console.log("map + 1 " + list.map(n => n + 1).join());
console.log("reduce " + list.reduce((text, n) => text + typeof n + " ", ""));
console.log("findLast " + typeof list.findLast(n => typeof n !== "number" || n > 100));
console.log("flatMap " + list.flatMap(n => [typeof n]).join());
console.log("Array.from " + Array.from(list, n => typeof n).join());
let walked = "";
for (const n of list) walked += typeof n + " ";
console.log("for of " + walked);
let indexed = "";
for (let i = 0; i < list.length; i++) indexed += typeof list[i] + " ";
console.log("by index " + indexed);
let sum = 0;
for (const n of list) sum += n;
console.log("sum " + sum);
let visited = 0;
////= list-forEach
console.log("forEach " + visited);
console.log("spread " + [...list].map(n => typeof n).join());
console.log("join " + list.join("-"));
console.log("JSON " + JSON.stringify(list));
console.log("keys " + Object.keys(list).join());

export {};
//// a-list-of-numbers-is-stored-to-inside-the-loop-that-reads-it-honest.ts
////= nameOf-4

////= attempt-52	"an honest store, the kind of an element"	typeof list[1] === "number"
////= attempt-52	"an honest store, the sum of three elements"	list[0] + list[1] + list[2] === 6
////= attempt-52	"an honest store, the length"	list.length === 3
////= attempt-52	"an honest store, whether an element is there"	1 in list
////= attempt-41	"an honest store, indexOf"	indexOf	2	1
////= attempt-52	"an honest store, includes"	list.includes(2)
////= attempt-41	"an honest store, at"	at	1	2
////= attempt-52	"an honest store, reduce"	list.reduce((a, b) => a + b, 0) === 6
////= attempt-52	"an honest store, every"	list.every(n => typeof n === "number")
////= attempt-52	"an honest store, join"	list.join() === "1,2,3"
attempt("an honest store, a loop inside the loop", () => {
  const list: number[] = [1, 2, 3];
  let held = 0;
  for (let i = 0; i < 2000; i++) {
    if (i === 1000) list[1] = 2;
    let total = 0;
    for (const n of list) total += n;
    if (total === 6) held++;
  }
  return held;
});
attempt("an honest store, a typed store", () => {
  const list: number[] = [1, 2, 3];
  let held = 0;
  try {
    for (let i = 0; i < 2000; i++) {
      if (i === 1000) list[1] = 2;
      list[1] = i;
      if (list[1] === i) held++;
    }
  } catch (error) {
    return held + " threw " + nameOf(error) + " " + list.join();
  }
  return held + " " + list.join();
});

export {};
