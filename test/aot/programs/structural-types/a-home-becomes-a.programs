  warm += orASize(honest) + orASize({ size: i }) + orAString(honest).length + orAThunk(honest) + orAThunk(() => i);
  warm += orAList(honest).length + orBytes(honest).length + orABoolean(honest).length + orABoolean(i % 2 === 0).length;
}
