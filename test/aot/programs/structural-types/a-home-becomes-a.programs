class Point {
  x = 3;
  norm(): number {
    return this.x * this.x;
  }
  get half(): number {
    return this.x / 2;
  }
}

class Other {
  x = 0;
  norm(): number {
    return -100;
  }
  get half(): number {
    return -50;
  }
}

