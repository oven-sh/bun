//// a-literal-and-an-instance-arrive-under-one-interface.ts
// One interface is satisfied by an object literal and by instances of a class; the same typed functions read and write both, by turns.
interface Shape {
  name: string;
  size: number;
  parent: Shape | null;
  area(): number;
}
class Square implements Shape {
  name = "square";
  parent: Shape | null = null;
  constructor(public size: number) {}
  area(): number {
    return this.size * this.size;
  }
}
function literal(size: number): Shape {
  return { name: "literal", size, parent: null, area() { return this.size * 2; } };
}
function grow(shape: Shape, parent: Shape | null): string {
  shape.size += 1;
  shape.name = shape.name + "+";
  shape.parent = parent;
  return shape.name + " " + shape.size + " " + shape.area() + " " + (shape.parent ? shape.parent.name : "none");
}
class Holder {
  shape: Shape;
  constructor(shape: Shape) {
    this.shape = shape;
  }
  swap(next: Shape): Shape {
    const before = this.shape;
    this.shape = next;
    return before;
  }
}
const shapes: Shape[] = [];
for (let index = 0; index < 6; index++) shapes.push(index % 2 ? new Square(index) : literal(index));
let parent: Shape | null = null;
for (const shape of shapes) {
  console.log(grow(shape, parent));
  parent = shape;
}
const holder = new Holder(shapes[0]);
for (const shape of shapes) console.log(holder.swap(shape).name, holder.shape.area(), holder.shape instanceof Square);
//// a-literal-born-with-null-is-filled-through-a-type-that-says-more.ts
// An object literal whose own type says `null` is written through a declared type that allows a string as well; another literal of the same name holds a boolean.
type Color = "red" | "blue";
type Holder = { color: Color | null };
type HolderWithAge = { color: Color | null; age?: number };

function pick(): Color {
  return Math.random() < 2 ? "red" : "blue";
}
function makeEmpty() {
  return { color: null };
}
function makeFlag(on: boolean) {
  return { color: on };
}
function fill(holder: Holder): Color {
  if (holder.color === null) holder.color = pick();
  return holder.color;
}
function fillAndAge(holder: HolderWithAge): string {
  if (holder.color === null) holder.color = pick();
  holder.age = (holder.age ?? 0) + 1;
  return holder.color + " " + holder.age;
}

const first = makeEmpty();
const second = makeEmpty();
console.log(makeFlag(true).color, fill(first), first.color);
console.log(fillAndAge(second), fillAndAge(second), JSON.stringify(second), Object.keys(second).join());
for (let round = 0; round < 3; round++) {
  const holder = makeEmpty();
  console.log(round, holder.color, fill(holder), JSON.stringify(holder));
}
