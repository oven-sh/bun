const log: string[] = [];

class Plain {
  width = 2;
  height = 3;
  area(): number {
    return this.width * this.height;
  }
}

class Watched {
  private w = 20;
  private h = 30;
  get width(): number {
    log.push("get width");
    return this.w;
  }
  set width(value: number) {
    log.push("set width " + value);
    this.w = value;
  }
  get height(): number {
    log.push("get height");
    return this.h;
  }
  set height(value: number) {
    log.push("set height " + value);
    this.h = value;
  }
  area(): number {
    log.push("area");
    return this.width * this.height;
  }
}

////= flush

////= lines-20	width	p	Plain	number	return	p.width

function perimeter(p: Plain): number {
  return 2 * (p.width + p.height);
}

function widen(p: Plain, by: number): number {
  p.width += by;
  return p.width;
}

function grow(p: Plain): void {
  p.height++;
  p.width = p.height;
}

