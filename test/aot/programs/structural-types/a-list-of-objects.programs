//// a-loop-is-left-early-and-the-iterators-return-throws.ts
////= text-14

let log: string[] = [];

class Source implements Iterable<number> {
  how: string;
  constructor(how: string) {
    this.how = how;
  }
  [Symbol.iterator](): Iterator<number> {
    let n = 0;
    const how = this.how;
    return {
      next(): IteratorResult<number> {
        n++;
        log.push("next " + n);
        if (how === "next throws" && n === 2) throw new RangeError("next");
        return n > 3 ? { done: true, value: undefined } : { done: false, value: n };
      },
      return(): IteratorResult<number> {
        log.push("return");
        if (how === "return throws") throw new SyntaxError("return");
        if (how === "return gives a number") return JSON.parse("5");
        if (how === "return gives null") return JSON.parse("null");
        return { done: true, value: undefined };
      },
    };
  }
}

function leaveByBreak(numbers: Iterable<number>): string {
  let last = 0;
  for (const n of numbers) {
    last = n;
    if (n === 1) break;
  }
  return "broke at " + last;
}

function leaveByReturn(numbers: Iterable<number>): string {
  for (const n of numbers) return "returned at " + n;
  return "empty";
}

function leaveByThrow(numbers: Iterable<number>): string {
  for (const n of numbers) throw new EvalError("body " + n);
  return "empty";
}

function leaveByContinueOuter(numbers: Iterable<number>): string {
  let rounds = 0;
  outer: for (let i = 0; i < 2; i++) {
    for (const n of numbers) {
      rounds += n;
      continue outer;
    }
  }
  return "rounds " + rounds;
}

function leaveByPattern(numbers: Iterable<number>): string {
  const [a] = numbers;
  return "took " + a;
}

function patternDefaultThrows(numbers: Iterable<number | undefined>): string {
  const explode = (): number => {
    throw new EvalError("default");
  };
  const [a, b = explode()] = numbers;
  return "took " + a + " and " + b;
}

function runToTheEnd(numbers: Iterable<number>): string {
  let sum = 0;
  for (const n of numbers) sum += n;
  return "sum " + sum;
}

function* leaveInsideAGenerator(numbers: Iterable<number>): Generator<number, string, void> {
  for (const n of numbers) yield n;
  return "ended";
}

const kinds = ["well behaved", "return throws", "return gives a number", "return gives null", "next throws"];
const ways: [string, (numbers: Iterable<number>) => string][] = [
  ["break", leaveByBreak],
  ["return", leaveByReturn],
  ["throw", leaveByThrow],
  ["continue outer", leaveByContinueOuter],
  ["pattern", leaveByPattern],
  ["pattern with a default", patternDefaultThrows],
  ["to the end", runToTheEnd],
  ["a generator that is closed", numbers => {
    const g = leaveInsideAGenerator(numbers);
    g.next();
    return text(g.return("closed"));
  }],
  ["a generator that is thrown at", numbers => {
    const g = leaveInsideAGenerator(numbers);
    g.next();
    return text(g.throw(new URIError("thrown in")));
  }],
];

for (const kind of kinds) {
  for (const [label, leave] of ways) {
    log = [];
    let outcome: string;
    try {
      outcome = leave(new Source(kind));
    } catch (error) {
      outcome = failure(error);
    }
    console.log(kind + ", " + label + ": " + outcome + " [" + log.join(", ") + "]");
  }
}
//// a-loop-runs-one-past-the-end-of-four-kinds-of-arrays.ts
////= show-32

////= Point-11

////= lines-191	sum	numbers	number	total	0

function sumAsIntegers(numbers: number[]): number {
  let total = 0;
  for (let i = 0; i <= numbers.length; i++) total = (total + numbers[i]) | 0;
  return total;
}

function largest(numbers: number[]): number {
  let best = -Infinity;
  for (let i = 0; i <= numbers.length; i++) if (numbers[i] > best) best = numbers[i];
  return best;
}

function countZeros(numbers: number[]): number {
  let count = 0;
  for (let i = 0; i <= numbers.length; i++) if (numbers[i] === 0) count++;
  return count;
}

function countFalsy(numbers: number[]): number {
  let count = 0;
  for (let i = 0; i <= numbers.length; i++) if (!numbers[i]) count++;
  return count;
}

////= lines-191	glue	strings	string	text	""

function widths(strings: string[]): number {
  let total = 0;
  for (let i = 0; i <= strings.length; i++) total += strings[i].length;
  return total;
}

function xs(points: Point[]): number {
  let total = 0;
  for (let i = 0; i <= points.length; i++) total += points[i].x;
  return total;
}

function twices(points: Point[]): number {
  let total = 0;
  for (let i = 0; i <= points.length; i++) total += points[i].twice();
  return total;
}

////= runAll	let i = 0; i <= functions.length; i++) total += functions[i]

function copy(numbers: number[]): number[] {
  const out: number[] = [];
  for (let i = 0; i <= numbers.length; i++) out.push(numbers[i]);
  return out;
}

function copyByIndex(numbers: number[]): number[] {
  const out = new Array<number>(numbers.length);
  for (let i = 0; i <= numbers.length; i++) out[i] = numbers[i];
  return out;
}

function pairs(numbers: number[]): number[] {
  const out: number[] = [];
  for (let i = 0; i < numbers.length; i++) out.push(numbers[i] + numbers[i + 1]);
  return out;
}

function fromMinusOne(numbers: number[]): number {
  let total = 0;
  for (let i = -1; i < numbers.length; i++) total += numbers[i];
  return total;
}

function tupleSum(pair: [number, number]): number {
  let total = 0;
  for (let i = 0; i <= pair.length; i++) total += pair[i];
  return total;
}

attempt("integers: sum", () => sum([1, 2, 3]));
attempt("integers: sum as integers", () => sumAsIntegers([1, 2, 3]));
attempt("integers: largest", () => largest([1, 2, 3]));
attempt("integers: zeros", () => countZeros([0, 1, 0]));
attempt("integers: falsy ones", () => countFalsy([0, 1, 0]));
attempt("fractions: sum", () => sum([0.5, 1.5]));
attempt("fractions: zeros", () => countZeros([0.5, 0, -0]));
attempt("fractions: largest", () => largest([0.5, 1.5]));
attempt("an empty list", () => [sum([]), sumAsIntegers([]), largest([]), countZeros([]), countFalsy([])]);
attempt("strings: glued", () => glue(["a", "b"]));
attempt("strings: widths", () => widths(["a", "b"]));
attempt("points: xs", () => xs([new Point(1)]));
attempt("points: twices", () => twices([new Point(1)]));
attempt("functions", () => runAll([() => 1]));
attempt("a copy by push", () => copy([1, 2]));
attempt("a copy by index", () => copyByIndex([1, 2]));
attempt("a copy of fractions", () => [copy([0.5]), copyByIndex([0.5])]);
attempt("a copy, summed honestly", () => copy([1, 2]).reduce((a, b) => a + b, 0));
attempt("each with its neighbor", () => [pairs([1, 2, 3]), pairs([0.5]), pairs([])]);
attempt("from minus one", () => fromMinusOne([1, 2]));
attempt("a tuple", () => tupleSum([1, 2]));

