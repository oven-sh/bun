//// a-method-is-handed-to-a-function-that-calls-it.ts
////= Owner-2

function run<T>(f: () => T): T {
  return f();
}
function runTwice(f: () => number): number {
  return f() + f();
}

const s = new Subject();

show("readCount", () => run(s.readCount));
show("countPlusOne", () => run(s.countPlusOne));
show("readLabel", () => run(s.readLabel));
show("labelLength", () => run(s.labelLength));
show("ownerName", () => run(s.ownerName));
show("runAction", () => run(s.runAction));
show("readSecret", () => run(s.readSecret));
show("storeCount", () => run(s.storeCount));
show("bump", () => run(s.bump));
show("storeLabel", () => run(s.storeLabel));
show("callsOther", () => run(s.callsOther));
show("kind", () => run(s.kind));
show("twice: readCount", () => runTwice(s.readCount));
show("twice: an arrow around it", () => runTwice(() => s.readCount()));
show("twice: bound", () => runTwice(s.readCount.bind(s)));
let total = 0;
for (let i = 0; i < 2000; i++) total += runTwice(() => s.readCount());
show("2000 honest calls", () => total);
show("then the bare method", () => runTwice(s.readCount));
show("then an honest one", () => runTwice(() => s.readCount()));
show("afterwards: count", () => s.count);
show("afterwards: label", () => s.label);
show("afterwards: keys", () => Object.keys(s).join());
show("on the object: readCount", () => s.readCount());
show("on the object: readSecret", () => s.readSecret());
show("on the object: callsOther", () => s.callsOther());
//// a-method-is-handed-to-timers-microtasks-and-promises.ts
////= show-6

const log: string[] = [];

class Job {
  id: number = 7;
  name: string = "job";
  note(): void {
    let seen: string;
    try {
      seen = typeof this + " " + typeof this.id + " " + this.id;
    } catch (error) {
      seen = "no this";
    }
    log.push(seen);
  }
  value(): number {
    return this.id;
  }
  title(): string {
    return this.name.toUpperCase();
  }
}

const job = new Job();

function wait(): Promise<void> {
  return new Promise(resolve => setTimeout(resolve, 1));
}

////= settle	promise:	promise

async function main(): Promise<void> {
  queueMicrotask(job.note);
  await null;
  console.log("queueMicrotask: " + log.splice(0).join());
  process.nextTick(job.note);
  await wait();
  console.log("nextTick: " + log.splice(0).join());
  setTimeout(job.note, 0);
  await wait();
  await wait();
  console.log("setTimeout saw an object or nothing: " + log.splice(0).map(entry => entry.endsWith("undefined") || entry === "no this").join());
  setImmediate(job.note);
  await wait();
  await wait();
  console.log("setImmediate saw an object or nothing: " + log.splice(0).map(entry => entry.endsWith("undefined") || entry === "no this").join());
  setTimeout(job.note.bind(job), 0);
  await wait();
  await wait();
  console.log("setTimeout, bound: " + log.splice(0).join());
  setTimeout(() => job.note(), 0);
  await wait();
  await wait();
  console.log("setTimeout, an arrow: " + log.splice(0).join());

  await settle("then value", Promise.resolve(0).then(job.value));
  await settle("then title", Promise.resolve(0).then(job.title));
  await settle("then value, bound", Promise.resolve(0).then(job.value.bind(job)));
  await settle("catch value", Promise.reject(new RangeError("no")).catch(job.value));
  await settle("finally note", Promise.resolve(5).finally(job.note));
  console.log("finally: " + log.splice(0).join());
  await settle("the executor is a method", new Promise<void>(job.note));
  console.log("executor: " + log.splice(0).join());
  await settle("all of mapped", Promise.all([1, 2].map(job.value.bind(job))));
  await settle("thenable made of a method", Promise.resolve({ id: 70, then: job.thenLike }));
}

interface Job {
  thenLike(resolve: (value: number) => void): void;
}
Job.prototype.thenLike = function (this: Job, resolve: (value: number) => void): void {
  resolve(this.id);
};

main();
