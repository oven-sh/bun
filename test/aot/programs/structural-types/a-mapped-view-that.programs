////= show-6

interface Counter {
  (): number;
  count: number;
  read(): number;
  bump(): number;
  again(): number;
}

function make(): Counter {
  return Object.assign(
    function (): number {
      return 1;
    },
    {
      count: 10,
      read(this: { count: number }): number {
        return this.count;
      },
      bump(this: { count: number }): number {
        return ++this.count;
      },
      again(this: () => number): number {
        return this() + 1;
      },
    },
  );
}

