function «1»(p: «2», rounds: number, at: number): string {
  const seen: number[] = [];
  let total = 0;
  for (let i = 0; i < rounds; i++) {
    const n = p.norm();
    total += n;
    if (i >= at - 1) seen.push(n);
  }
  return seen.join(" ") + " total " + total;
}
