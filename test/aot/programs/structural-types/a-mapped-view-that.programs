//// a-method-is-registered-as-a-listener.ts
////= show-6

import { EventEmitter } from "node:events";

const log: string[] = [];

class Screen {
  taps: number = 0;
  name: string = "screen";
  onTap(): void {
    let seen: string;
    try {
      this.taps++;
      seen = "taps " + typeof this.taps + " " + this.taps + ", name " + typeof this.name;
    } catch (error) {
      seen = "no this";
    }
    log.push(seen);
  }
  who(): void {
    log.push(this === undefined ? "nothing" : this === screen ? "the screen" : Object.is(this, emitter) ? "the emitter" : Object.is(this, target) ? "the target" : "something else");
  }
  onTapArrow = (): void => {
    this.taps++;
    log.push("arrow: taps " + this.taps);
  };
  handleEvent(): void {
    this.who();
  }
}

const screen = new Screen();
const emitter = new EventEmitter();
const target = new EventTarget();

emitter.on("tap", screen.onTap);
emitter.on("tap", screen.who);
emitter.on("tap", screen.onTapArrow);
emitter.on("tap", screen.onTap.bind(screen));
emitter.once("tap", screen.who);
show("emit", () => emitter.emit("tap"));
show("what the listeners saw", () => log.splice(0).join(" | "));
show("emit again", () => emitter.emit("tap"));
show("what the listeners saw", () => log.splice(0).join(" | "));
show("the screen's taps", () => screen.taps);
show("the emitter got a member", () => "taps" in emitter);
show("its value", () => String(Reflect.get(emitter, "taps")));

target.addEventListener("tap", screen.onTap);
target.addEventListener("tap", screen.who);
target.addEventListener("tap", screen.onTapArrow);
target.addEventListener("tap", screen);
show("dispatch", () => target.dispatchEvent(new Event("tap")));
show("what the listeners saw", () => log.splice(0).join(" | "));
show("the screen's taps", () => screen.taps);
show("the target got a member", () => "taps" in target);

class Own {
  listeners: (() => void)[] = [];
  label: string = "own";
  on(listener: () => void): void {
    this.listeners.push(listener);
  }
  fireByIndex(): void {
    for (let i = 0; i < this.listeners.length; i++) this.listeners[i]();
  }
  fireByValue(): void {
    for (const listener of this.listeners) listener();
  }
  fireWithThis(): void {
    for (const listener of this.listeners) listener.call(this);
  }
}
const own = new Own();
own.on(screen.onTap);
own.on(screen.onTapArrow);
own.fireByIndex();
show("fired by index: the array is this", () => log.splice(0).join(" | "));
show("keys of the array", () => Object.keys(own.listeners).join());
own.fireByValue();
show("fired by value", () => log.splice(0).join(" | "));
own.fireWithThis();
show("fired with the emitter as this", () => log.splice(0).join(" | "));
show("keys of the emitter", () => Object.keys(own).join());
//// a-method-is-replaced-across-a-yield.ts
class Lamp {
  name: string;
  constructor(name: string) {
    this.name = name;
  }
  color(): string {
    return "method of " + this.name;
  }
  *watch(): Generator<string, string, void> {
    yield this.color();
    yield this.color();
    yield this.color();
    return this.color();
  }
  static kind(): string {
    return "static method";
  }
}

function* watch(l: Lamp): Generator<string, string, void> {
  yield l.color();
  yield l.color();
  yield l.color();
  return l.color();
}

function* watchLoop(l: Lamp, rounds: number): Generator<string, void, void> {
  for (let i = 0; i < rounds; i++) yield l.color() + " / " + Lamp.kind();
}

const original = Lamp.prototype.color;
const originalKind = Lamp.kind;

function drive(label: string, l: Lamp, it: Generator<string, string, void>): void {
  const seen: string[] = [];
  seen.push(String(it.next().value));
  l.color = () => "own";
  seen.push(String(it.next().value));
  Reflect.deleteProperty(l, "color");
  Lamp.prototype.color = function () {
    return "patched for " + this.name;
  };
  seen.push(String(it.next().value));
  Lamp.prototype.color = original;
  seen.push(String(it.next().value));
  console.log(label + ": " + seen.join(" | "));
}

const a = new Lamp("a");
drive("a generator function", a, watch(a));
const b = new Lamp("b");
drive("a generator method", b, b.watch());

const c = new Lamp("c");
let step = 0;
for (const seen of watchLoop(c, 8)) {
  console.log("for-of, step " + step + ": " + seen);
  if (step === 0) c.color = () => "own";
  if (step === 1) Lamp.kind = () => "patched static";
  if (step === 2) Reflect.deleteProperty(c, "color");
  if (step === 3) Lamp.prototype.color = () => "arrow on the prototype";
  if (step === 4) Lamp.kind = originalKind;
  if (step === 5) Lamp.prototype.color = original;
  step++;
}

const d = new Lamp("d");
let count = 0;
let last = "";
for (const seen of watchLoop(d, 2003)) {
  count++;
  last = seen;
  if (count === 2000) d.color = () => "own after 2000";
  if (count > 2000) console.log("step " + count + ": " + seen);
}
console.log("the last: " + last);

function* delegating(l: Lamp): Generator<string, void, void> {
  const inner = yield* watch(l);
  yield "returned " + inner + ", now " + l.color();
}

const e = new Lamp("e");
const outer = delegating(e);
const through: string[] = [];
for (let r = outer.next(); !r.done; r = outer.next()) {
  through.push(r.value);
  if (through.length === 2) e.color = () => "own";
}
console.log("through yield*: " + through.join(" | "));

export {};
//// a-method-is-replaced-across-an-await.ts
class Job {
  id: number;
  constructor(id: number) {
    this.id = id;
  }
  state(): string {
    return "method " + this.id;
  }
  async watch(gate: Promise<void>): Promise<string> {
    const before = this.state();
    await gate;
    return before + " -> " + this.state();
  }
  static kind(): string {
    return "static method";
  }
}

async function watch(j: Job, gate: Promise<void>): Promise<string> {
  const before = j.state();
  await gate;
  return before + " -> " + j.state();
}

async function watchStatic(gate: Promise<void>): Promise<string> {
  const before = Job.kind();
  await gate;
  return before + " -> " + Job.kind();
}

async function watchMany(j: Job, gates: Promise<void>[]): Promise<string> {
  const seen: string[] = [j.state()];
  for (const gate of gates) {
    await gate;
    seen.push(j.state());
  }
  return seen.join(" -> ");
}

function gate(): { promise: Promise<void>; open: () => void } {
  let open: () => void = () => {};
  const promise = new Promise<void>(resolve => {
    open = resolve;
  });
  return { promise, open };
}

const original = Job.prototype.state;
const originalKind = Job.kind;

{
  const j = new Job(1);
  const g = gate();
  const results = [watch(j, g.promise), j.watch(g.promise)];
  j.state = () => "own";
  g.open();
  console.log("an own member: " + (await Promise.all(results)).join(" | "));
  Reflect.deleteProperty(j, "state");
  console.log("uncovered: " + (await watch(j, Promise.resolve())));
}

{
  const j = new Job(2);
  const g = gate();
  const results = [watch(j, g.promise), j.watch(g.promise), watchStatic(g.promise)];
  Job.prototype.state = function () {
    return "patched " + this.id;
  };
  Job.kind = () => "patched static";
  g.open();
  console.log("the prototype and the class: " + (await Promise.all(results)).join(" | "));
  Job.prototype.state = original;
  Job.kind = originalKind;
  console.log("put back: " + (await watch(j, Promise.resolve())) + " | " + (await watchStatic(Promise.resolve())));
}

{
  const j = new Job(3);
  const gates = [gate(), gate(), gate(), gate()];
  const result = watchMany(
    j,
    gates.map(g => g.promise),
  );
  j.state = () => "own";
  gates[0].open();
  await gates[0].promise;
  await null;
  Reflect.deleteProperty(j, "state");
  gates[1].open();
  await gates[1].promise;
  await null;
  Job.prototype.state = () => "arrow on the prototype";
  gates[2].open();
  await gates[2].promise;
  await null;
  Job.prototype.state = original;
  gates[3].open();
  console.log("four awaits in a loop: " + (await result));
}

{
  const j = new Job(4);
  let letters = 0;
  for (let i = 0; i < 2000; i++) letters += (await watch(j, Promise.resolve())).length;
  console.log("2000 honest: " + letters);
  const g = gate();
  const result = watch(j, g.promise);
  j.state = () => "own";
  g.open();
  console.log("then an own member: " + (await result));
}

export {};
