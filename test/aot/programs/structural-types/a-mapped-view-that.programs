//// a-method-hands-its-own-sibling-to-a-built-in.ts
////= show-6

const registered: (() => string)[] = [];

class Report {
  factor: number = 10;
  rows: number[] = [1, 2, 3];
  title: string = "report";
  constructor() {
    registered.push(this.heading);
    registered.push(() => this.heading());
  }
  scale(n: number): number {
    return n * this.factor;
  }
  keep(n: number): boolean {
    return n * this.factor > 10;
  }
  add(sum: number, n: number): number {
    return sum + n * this.factor;
  }
  heading(): string {
    return this.title.toUpperCase();
  }
  scaledWrong(): number[] {
    return this.rows.map(this.scale);
  }
  scaledWithThis(): number[] {
    return this.rows.map(this.scale, this);
  }
  scaledByArrow(): number[] {
    return this.rows.map(n => this.scale(n));
  }
  keptWrong(): number[] {
    return this.rows.filter(this.keep);
  }
  keptWithThis(): number[] {
    return this.rows.filter(this.keep, this);
  }
  totalWrong(): number {
    return this.rows.reduce(this.add, 0);
  }
  totalBound(): number {
    return this.rows.reduce(this.add.bind(this), 0);
  }
  localCopy(): number {
    const scale = this.scale;
    return scale(2);
  }
  localPair(): number {
    const { scale, factor } = this;
    return factor + scale(2);
  }
}

const report = new Report();
show("scaledWrong", () => report.scaledWrong().join());
show("scaledWithThis", () => report.scaledWithThis().join());
show("scaledByArrow", () => report.scaledByArrow().join());
show("keptWrong", () => report.keptWrong().join());
show("keptWithThis", () => report.keptWithThis().join());
show("totalWrong", () => report.totalWrong());
show("totalBound", () => report.totalBound());
show("localCopy", () => report.localCopy());
show("localPair", () => report.localPair());
show("registered in the constructor, bare", () => registered[0].call(undefined));
show("registered in the constructor, as an element", () => registered[0]());
show("registered in the constructor, an arrow", () => registered[1]());
report.rows = [];
show("no rows: scaledWrong", () => report.scaledWrong().length);
show("no rows: totalWrong", () => report.totalWrong());
//// a-method-is-added-to-a-class-in-the-middle-of-the-chain.ts
class Top {
  id = 1;
  who(): string {
    return "top " + this.id;
  }
  get rank(): number {
    return 1;
  }
  static make(): string {
    return "top make";
  }
}

class Middle extends Top {}

class Lower extends Middle {}

class Leaf extends Lower {}

////= lines-53	whoOf	t	Top	t.who	" "	t.rank

////= lines-53	leafWho	l	Leaf	l.who	" "	l.rank

////= lines-53	lowerWho	l	Lower	l.who	" "	l.rank

const leaf = new Leaf();
const lower = new Lower();
const middle = new Middle();
const top = new Top();

function round(label: string): void {
  console.log(label + ": leaf " + leaf.who() + " " + leafWho(leaf) + " " + whoOf(leaf) + " | lower " + lowerWho(lower) + " " + lowerWho(leaf) + " | middle " + whoOf(middle) + " | top " + whoOf(top) + " | static " + [Leaf.make(), Lower.make(), Middle.make(), Top.make()].join());
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += leafWho(leaf).length + lowerWho(lower).length + whoOf(middle).length + whoOf(top).length + Leaf.make().length;
console.log("2000 honest: " + warm);
round("before");

////= lines-129	Lower	who	"lower "	id
round("the lower class gets a method of its own");

////= lines-129	Middle	who	"middle "	id
round("the middle class too");

Reflect.deleteProperty(Lower.prototype, "who");
round("the lower class loses its own");

Reflect.deleteProperty(Middle.prototype, "who");
round("the middle class too");

Object.defineProperty(Lower.prototype, "rank", { get: () => 3, configurable: true });
round("the lower class gets a getter of its own");

Object.defineProperty(Leaf.prototype, "rank", { value: 4, configurable: true });
round("the leaf class gets a plain value");

Reflect.deleteProperty(Lower.prototype, "rank");
Reflect.deleteProperty(Leaf.prototype, "rank");
round("both removed");

Lower.make = () => "lower make";
round("the lower class gets a static method of its own");

Reflect.deleteProperty(Lower, "make");
round("removed");

