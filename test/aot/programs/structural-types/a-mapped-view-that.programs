class Cell {
  leaf: Leaf | null = new Leaf();
  count = 1;
  update(patch: Partial<Cell>): void {
    Object.assign(this, patch);
  }
  weigh(): number {
    return this.leaf === null ? -1 : this.leaf.weight;
  }
}

