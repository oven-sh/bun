abstract class Shape {
  abstract sides: number;
  abstract label: string;
  abstract area(): number;
  twice(): number {
    return this.sides * 2;
  }
  heading(): string {
    return this.label + "!";
  }
  bigger(): number {
    return this.area() + 1;
  }
}

class Honest extends Shape {
  sides: number = 4;
  label: string = "honest";
  area(): number {
    return 16;
  }
}

class Declared extends Shape {
  declare sides: number;
  declare label: string;
  declare area: () => number;
}

interface Merged {
  sides: number;
  label: string;
  area(): number;
}
class Merged extends Shape {}

