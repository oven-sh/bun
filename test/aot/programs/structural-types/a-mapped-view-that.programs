const log: string[] = [];

function renumber<T extends { id: number }>(item: T, id: number): T {
  item.id = id;
  return item;
}

function renumberAll<T extends { id: number }>(items: T[]): T[] {
  for (let i = 0; i < items.length; i++) items[i].id = i + 0.5;
  return items;
}

