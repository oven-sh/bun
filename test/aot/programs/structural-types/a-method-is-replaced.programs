//// a-method-is-replaced-by-a-store-whose-key-comes-out-of-a-list.ts
class Row {
  id = 7;
  next(): number {
    return this.id + 1;
  }
  twice(): number {
    return this.id * 2;
  }
  both(): number {
    return this.next() + this.twice();
  }
}

type MethodName = "next" | "twice";

function isMethodName(text: string): text is MethodName {
  return text === "next" || text === "twice";
}

