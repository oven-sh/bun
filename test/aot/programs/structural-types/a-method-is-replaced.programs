//// a-method-is-replaced-on-the-way-to-a-catch-or-a-finally-block.ts
////= Target

const replacement = (): number => -1;

function patchAndThrow(target: Target, really: boolean): void {
  if (!really) return;
  target.norm = replacement;
  throw new RangeError("patched");
}

function deeper(target: Target, really: boolean): void {
  patchAndThrow(target, really);
}

async function patchAndReject(target: Target, really: boolean): Promise<void> {
  await null;
  patchAndThrow(target, really);
}

////= trap

////= Caught

////= aroundCaught

////= lines-51	Caught	aroundCaught	"caught"

////= Finally

////= aroundFinally

////= lines-51	Finally	aroundFinally	"a finally block"

////= Deep

////= aroundDeep

////= lines-51	Deep	aroundDeep	"thrown two calls down"

////= InCatch

function aroundInCatch(p: InCatch, really: boolean): string {
  const before = p.norm();
  let after = -100;
  try {
    if (really) throw new RangeError("really");
  } catch {
    InCatch.prototype.norm = replacement;
  }
  after = p.norm();
  return before + " " + after + " " + p.norm();
}

////= lines-51	InCatch	aroundInCatch	"the store is in the catch block"

////= InFinally

function aroundInFinally(p: InFinally, really: boolean): string {
  const before = p.norm();
  let after = -100;
  try {
    after = p.norm();
  } finally {
    if (really) InFinally.prototype.norm = replacement;
  }
  after = after * 100 + p.norm();
  return before + " " + after + " " + p.norm();
}

////= lines-51	InFinally	aroundInFinally	"the store is in the finally block"

////= ByGetter

////= aroundByGetter

////= lines-51	ByGetter	aroundByGetter	"a getter that replaces and throws"

