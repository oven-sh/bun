////: uses-4
function uses(d: Door): string {
  const parts: string[] = [];
  parts.push(d.ready() ? "ready" : "not ready");
  if (!d.ready()) parts.push("really not");
  switch (d.kind()) {
    case "wood":
      parts.push("wooden");
      break;
    case "steel":
      parts.push("of steel");
      break;
  }
  parts.push(d.owner()?.toUpperCase() ?? "nobody");
  const lock = d.lock();
  parts.push(lock === null ? "no lock" : "code " + lock.code);
  parts.push(d.label() === "door" ? "a door" : "called " + JSON.stringify(d.label()));
  parts.push(String(d.label().length));
  const size = d.size();
  parts.push(typeof size === "number" ? "number " + (size + 1) : "string " + size.length);
  return parts.join(", ");
}
////: uses-5
function uses(s: Stock): string {
  const n = s.count();
  return [show(n), show(s.count() + 1), show(s.count() * 2), show(s.count() | 0), show(s.count() >>> 0), show(1 / s.count()), show(s.count() % 2), show(-s.count()), String(s.items[s.count() - 1]), String(s.count() === 3), String(s.count() < 3), typeof n].join(" ");
}
