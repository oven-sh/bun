    n = 2;
    who(): string {
      return tag + " " + this.n * factor;
    }
    get label(): string {
      return "label of " + tag;
    }
    static kind(): string {
      return "kind of " + tag;
    }
    both(): string {
      return this.who() + " / " + this.label;
    }
  };
}

