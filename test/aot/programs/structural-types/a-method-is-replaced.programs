////= DefinedOnPrototype

function loopOverDefinedOnPrototype(p: DefinedOnPrototype, rounds: number, at: number): string {
  const written = p.norm;
  const seen: number[] = [];
  let total = 0;
  for (let i = 0; i < rounds; i++) {
    if (i === at) Object.defineProperty(DefinedOnPrototype.prototype, "norm", { value: replacement, writable: true, configurable: true });
    if (i === at + 2) DefinedOnPrototype.prototype.norm = written;
    const n = p.norm();
    total += n;
    if (i >= at - 1) seen.push(n);
  }
  return seen.join(" ") + " total " + total;
}

