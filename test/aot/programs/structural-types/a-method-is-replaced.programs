//// a-method-taken-off-in-one-module-is-called-in-another/main.ts
import fallback, { bump, labelLength, readShared, shared, Subject } from "./subject.ts";
import * as everything from "./subject.ts";
import { run, runOn } from "./runner.ts";

console.log(run("honest", () => shared.readCount()));
console.log(run("an exported constant", readShared));
console.log(run("an exported constant, called here", () => readShared()));
console.log(run("exported by destructuring: labelLength", labelLength));
console.log(run("exported by destructuring: bump", bump));
console.log(run("the default export", fallback));
console.log(run("as a member of the namespace object", () => everything.readShared()));
console.log(run("as a member of the namespace object: bump", () => everything.bump()));
console.log(runOn("on a look-alike", readShared, { count: 70 }));
console.log(runOn("on the shared one", readShared, shared));
console.log(runOn("on a new one", Subject.prototype.readCount, new Subject()));
console.log(run("the shared one is untouched", () => shared.count));
//// a-method-taken-off-in-one-module-is-called-in-another/runner.ts
export function run(title: string, f: () => unknown): string {
  try {
    const value = f();
    return title + ": " + typeof value + " " + String(value);
  } catch (error) {
    return title + ": " + (error instanceof TypeError ? "threw a TypeError" : "threw something else");
  }
}

export function runOn(title: string, f: (this: { count: number }) => number, receiver: { count: number }): string {
  return run(title, () => f.call(receiver));
}
//// a-method-taken-off-in-one-module-is-called-in-another/subject.ts
export class Subject {
  count: number = 10;
  label: string = "subject";
  readCount(): number {
    return this.count;
  }
  labelLength(): number {
    return this.label.length;
  }
  bump(): number {
    return ++this.count;
  }
}

export const shared = new Subject();
export const readShared = shared.readCount;
export const { labelLength, bump } = shared;
export default shared.readCount;
//// a-method-taken-off-through-an-interface-or-an-abstract-class.ts
////= show-6

////= Shape-4
abstract class Base implements Shape {
  scale: number = 2;
  abstract area(): number;
  name(): string {
    return "shape of " + this.area();
  }
  scaled(): number {
    return this.area() * this.scale;
  }
}
class Square extends Base {
  side: number = 3;
  area(): number {
    return this.side * this.side;
  }
}
class Circle extends Base {
  radius: number = 1;
  area(): number {
    return 3 * this.radius * this.radius;
  }
  name(): string {
    return "circle, " + super.name();
  }
}

const shapes: Shape[] = [new Square(), new Circle(), { area: () => 7, name: () => "literal" }];
const bases: Base[] = [new Square(), new Circle()];

for (let i = 0; i < shapes.length; i++) {
  const shape = shapes[i];
  show(i + " honest area", () => shape.area());
  show(i + " honest name", () => shape.name());
  show(i + " bare area", () => {
    const { area } = shape;
    return area();
  });
  show(i + " bare name", () => {
    const f = shape.name;
    return f();
  });
  show(i + " area on the next shape", () => shape.area.call(shapes[(i + 1) % 3]));
  show(i + " name on the next shape", () => shape.name.call(shapes[(i + 1) % 3]));
}
for (const base of bases) {
  show("honest scaled", () => base.scaled());
  show("bare scaled", () => (0, base.scaled)());
  show("scaled on a look-alike", () => base.scaled.call({ scale: 10, area: () => 5 }));
  show("scaled on a look-alike whose area uses this", () =>
    base.scaled.call({
      scale: 10,
      side: 4,
      area(): number {
        return this.side;
      },
    }),
  );
  show("scaled on a look-alike without area", () => base.scaled.call({ scale: 10 }));
}
////= show-29	areas through map", () => shapes.map(shape => shape.area).map(area	String(area()
show("a square's area on a circle", () => bases[0].area.call(bases[1]));
show("a circle's area on a square", () => bases[1].area.call(bases[0]));
