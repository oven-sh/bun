round("a string");
give(undefined);
round("undefined");
give(null);
round("null");
give({ a: 1 });
round("an object");
give(7n);
round("a bigint");
give(true);
round("a boolean");
give([4]);
round("a list");

Object.assign(Point.prototype, { norm: 5, label: "not a function" });
Object.assign(Point, { zero: undefined });
round("members that cannot be called");

