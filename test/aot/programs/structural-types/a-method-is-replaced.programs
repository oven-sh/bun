class Robot {
  id: number;
  constructor(id: number) {
    this.id = id;
  }
  twice(): string {
    return this.beep() + this.beep();
  }
}

////= lines-19	beepOf	robot	Robot	string	robot.beep

function attempt(robot: Robot): string {
  try {
    return beepOf(robot);
  } catch (error) {
    return error instanceof TypeError ? "TypeError" : "another error";
  }
}

const first = new Robot(1);
show("before", () => [attempt(first), typeof first.beep, "beep" in first]);

show("a loop in which it appears and goes away", () => {
  const seen: string[] = [];
  const optional: { beep?: () => string } = Robot.prototype;
  for (let i = 0; i < 6; i++) {
    if (i === 2) {
      Robot.prototype.beep = function (this: Robot): string {
        return "beep" + this.id;
      };
    }
    if (i === 4) delete optional.beep;
    seen.push(attempt(first));
  }
  return seen;
});

Robot.prototype.beep = function (this: Robot): string {
  return "b" + this.id;
};
let letters = 0;
for (let i = 0; i < 2000; i++) letters += beepOf(new Robot(i % 10)).length + new Robot(1).twice().length;
show("2000 calls while it is there", () => letters);

const gone: { beep?: () => string } = Robot.prototype;
delete gone.beep;
show("after it is deleted", () => [attempt(first), attempt(new Robot(2)), typeof first.beep]);
show("in the method of the class", () => first.twice());

Robot.prototype.charge = 50;
show("a number on the prototype", () => [first.charge, first.charge + 1, Object.keys(first), "charge" in first]);
first.charge -= 1;
show("stored on one instance", () => [first.charge, new Robot(3).charge, Object.keys(first)]);
//// a-method-of-a-generic-class-is-taken-off.ts
////= show-6

class Box<T> {
  value: T;
  reads: number = 0;
  constructor(value: T) {
    this.value = value;
  }
  get(): T {
    this.reads++;
    return this.value;
  }
  peek(): T {
    return this.value;
  }
  set(value: T): void {
    this.value = value;
  }
  map<U>(f: (value: T) => U): Box<U> {
    return new Box(f(this.value));
  }
}

const numbers = new Box(5);
const strings = new Box("five");
const lists = new Box([1, 2]);

show("honest", () => numbers.get() + strings.get().length + lists.get().length);
show("bare peek of a number", () => (0, numbers.peek)());
show("bare get of a number", () => (0, numbers.get)());
show("bare set", () => (0, numbers.set)(6));
show("bare map", () => (0, numbers.map)(n => n + 1));

const peekNumber = numbers.peek;
show("a number box's peek on a string box", () => peekNumber.call(strings));
show("plus one", () => peekNumber.call(strings) + 1);
show("a string box's peek on a number box: length", () => strings.peek.call(numbers).length);
show("a list box's peek on a number box: length", () => lists.peek.call(numbers).length);
show("a number box's set on a string box", () => numbers.set.call(strings, 7));
show("the string box now holds", () => typeof strings.value + " " + strings.value);
show("its length", () => strings.get().length);
show("a look-alike", () => numbers.peek.call({ value: 50, reads: 0 }) + 1);
show("a look-alike of another kind", () => numbers.peek.call({ value: "fifty", reads: 0 }) + 1);
show("a look-alike without reads: get", () => {
  const like = { value: 1 };
  return numbers.get.call(like) + " " + JSON.stringify(like);
});
show("map on a look-alike", () => numbers.map.call({ value: 3 }, n => String(n)).value);
show("reads", () => numbers.reads + " " + strings.reads + " " + lists.reads);

const getters: (() => number)[] = [numbers.peek, numbers.peek.bind(numbers), () => numbers.peek()];
show("three ways in one array, called by value", () => {
  const out: string[] = [];
  for (const f of getters) {
    try {
      out.push(String(f()));
    } catch (error) {
      out.push("threw");
    }
  }
  return out.join();
});
