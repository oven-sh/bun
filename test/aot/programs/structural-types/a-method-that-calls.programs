class Base {
  n = 2;
  twice(): number {
    return this.n * 2;
  }
  get label(): string {
    return "base " + this.n;
  }
  static kind(): string {
    return "base kind";
  }
}

function Louder(Parent: typeof Base) {
  return class extends Parent {
    extra = 1;
    twice(): number {
      return super.twice() + this.extra;
    }
    get label(): string {
      return super.label + " and more";
    }
    static kind(): string {
      return super.kind() + " and more";
    }
  };
}

const Made = Louder(Base);
