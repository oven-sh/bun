////: loop
function loop(c: Cell): string {
  const seen: string[] = [];
  for (let i = 0; i < c.list.length; i++) {
    seen.push(String(c.list[i]));
    c.touch();
  }
  return seen.join();
}
////: loop-3
function loop(b: Builder): string {
  let at = b;
  for (let i = 0; i < 4; i++) at = at.add(String(i));
  return at.build() + " / " + b.build();
}
////: loop-4
function loop(c: Circle, rounds: number): number {
  let total = 0;
  for (let i = 0; i < rounds; i++) total += c.area();
  return total;
}
////: nested
function nested(c: Cell): string {
  const inner = c.inner;
  const d = inner.depth;
  c.touch();
  return d + " " + inner.depth + " " + c.inner.depth + " " + (inner === c.inner);
}
////: outer
function outer(g: Gate): string {
  try {
    return "sum " + unguarded(g);
  } catch (error) {
    return "caught outside " + (error instanceof Error ? error.constructor.name : typeof error) + " after " + g.passes;
  }
}
////: overwritten
function overwritten(c: Circle): number {
  let x = c.area();
  x = c.area();
  return x;
}
////: partial
function partial(g: Gate): string {
  const steps: number[] = [];
  try {
    steps.push(1);
    g.open();
    steps.push(2);
    g.open();
    steps.push(3);
  } catch {
    steps.push(-1);
  }
  return steps.join();
}
