////: show-20
function show(list: number[]): string {
  const parts: string[] = [];
  for (let i = 0; i < list.length; i++) parts.push(i in list ? (Object.is(list[i], -0) ? "-0" : String(list[i])) : "hole");
  return "[" + parts.join() + "]";
}
