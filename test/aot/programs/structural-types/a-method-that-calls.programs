//// a-method-that-stores-into-this-is-constructed-all-the-same.ts
// bump and the setter store into `this`, which they declare to be a Counter: they are methods. Somebody constructs them all the same.
interface Counter { count: number; step: number; bump(): number; stride: number }
function Counter(this: Counter, step: number) {
  this.count = 0;
  this.step = step;
}
Counter.prototype.bump = function bump(this: Counter) {
  this.count += this.step;
  return this.count;
};
const descriptor = {
  set: function setStride(this: Counter, step: number) {
    this.step = step;
  },
  get: function getStride(this: Counter) {
    return this.step;
  },
};
Object.defineProperty(Counter.prototype, "stride", descriptor);
const CounterConstructor = Counter as unknown as new (step: number) => Counter;

const lines: string[] = [];
const counter = new CounterConstructor(2);
let total = 0;
for (let i = 0; i < 2000; i++) {
  if (i === 1000) counter.stride = 3;
  total += counter.bump();
}
lines.push(String(total), Object.keys(counter).join(","), String(counter.stride));

type Constructible = new (...values: unknown[]) => Record<string, unknown>;
const Bump = counter.bump as unknown as Constructible;
const bumped = new Bump();
lines.push(Object.keys(bumped).join(","), String(bumped.count), String(bumped instanceof Bump), String(bumped instanceof Counter));
lines.push(String(Object.getPrototypeOf(bumped) === Bump.prototype));

const SetStride = descriptor.set as unknown as Constructible;
const made = new SetStride(7);
lines.push(JSON.stringify(made), String(made instanceof SetStride));

// What the method made is handed to the method, and to the other one.
lines.push(String(counter.bump.call(made as unknown as Counter)), JSON.stringify(made));
(made as unknown as Counter).count = 1;
lines.push(String(counter.bump.call(made as unknown as Counter)), JSON.stringify(made));
descriptor.set.call(bumped as unknown as Counter, 5);
lines.push(JSON.stringify(bumped));

// Many of them, beside the real ones, through one function.
////= lines-68	countOf	value	Counter	number	value.count	value.step
let sum = 0;
for (let i = 0; i < 3000; i++) {
  const value = i % 3 === 0 ? (new SetStride(i) as unknown as Counter) : new CounterConstructor(i);
  const count = countOf(value);
  sum += count === count ? count : 1;
}
lines.push(String(sum));
console.log(lines.join("\n"));
//// a-method-that-takes-a-function-is-called-with-something-else.ts
////= text-12

class Plan {
  steps: number = 3;
  run(): number {
    return this.steps;
  }
}

type Wide = (() => number) | number | string | Plan | null | undefined;

interface Runner {
  run(v: Wide): number;
  runTwice(v: Wide): number;
  kind(v: Wide): string;
  arity(v: Wide): number;
  title(v: Wide): string;
  viaCall(v: Wide): number;
  viaApply(v: Wide): number;
  bound(v: Wide): number;
  keep(v: Wide): void;
  each(v: Wide): number[];
}

class FunctionRunner implements Runner {
  kept: () => number = () => -1;
  run(f: () => number): number {
    return f();
  }
  runTwice(f: () => number): number {
    return f() + f();
  }
  kind(f: () => number): string {
    return typeof f;
  }
  arity(f: () => number): number {
    return f.length;
  }
  title(f: () => number): string {
    return f.name;
  }
  viaCall(f: () => number): number {
    return f.call(undefined);
  }
  viaApply(f: () => number): number {
    return f.apply(undefined);
  }
  bound(f: () => number): number {
    return f.bind(undefined)();
  }
  keep(f: () => number): void {
    this.kept = f;
  }
  each(f: () => number): number[] {
    return [1, 2].map(f);
  }
}

const own = new FunctionRunner();
const runner: Runner = own;
////= lines-34	seven	number	return	7
const values: [string, Wide][] = [
  ["function", seven],
  ["arrow", () => 8],
  ["number", 5],
  ["string", "text"],
  ["plan", new Plan()],
  ["null", null],
  ["undefined", undefined],
  ["function again", seven],
];

for (const [label, value] of values) {
  show(label + " run", () => runner.run(value));
  show(label + " runTwice", () => runner.runTwice(value));
  show(label + " kind", () => runner.kind(value));
  show(label + " arity", () => runner.arity(value));
  show(label + " title", () => runner.title(value));
  show(label + " viaCall", () => runner.viaCall(value));
  show(label + " viaApply", () => runner.viaApply(value));
  show(label + " bound", () => runner.bound(value));
  show(label + " each", () => runner.each(value));
  show(label + " keep", () => runner.keep(value));
  show(label + " kept kind", () => typeof own.kept);
  show(label + " kept called", () => own.kept());
}
//// a-method-that-takes-a-number-is-called-with-a-string.ts
////= text-12

interface Meter {
  same(v: number | string | null | undefined | boolean | bigint): number;
  plusOne(v: number | string | null | undefined | boolean | bigint): number;
  twice(v: number | string | null | undefined | boolean | bigint): number;
  whole(v: number | string | null | undefined | boolean | bigint): number;
  unsigned(v: number | string | null | undefined | boolean | bigint): number;
  negated(v: number | string | null | undefined | boolean | bigint): number;
  fixed(v: number | string | null | undefined | boolean | bigint): string;
  below(v: number | string | null | undefined | boolean | bigint): boolean;
  isFive(v: number | string | null | undefined | boolean | bigint): boolean;
  truthy(v: number | string | null | undefined | boolean | bigint): string;
  root(v: number | string | null | undefined | boolean | bigint): number;
  next(v: number | string | null | undefined | boolean | bigint): number;
  keep(v: number | string | null | undefined | boolean | bigint): void;
  index(v: number | string | null | undefined | boolean | bigint): string;
}

class NumberMeter implements Meter {
  last: number = 0;
  all: number[] = [];
  same(n: number): number {
    return n;
  }
  plusOne(n: number): number {
    return n + 1;
  }
  twice(n: number): number {
    return n * 2;
  }
  whole(n: number): number {
    return n | 0;
  }
  unsigned(n: number): number {
    return n >>> 0;
  }
  negated(n: number): number {
    return -n;
  }
  fixed(n: number): string {
    return n.toFixed(1);
  }
  below(n: number): boolean {
    return n < 10;
  }
  isFive(n: number): boolean {
    return n === 5;
  }
  truthy(n: number): string {
    return n ? "yes" : "no";
  }
  root(n: number): number {
    return Math.sqrt(n);
  }
  next(n: number): number {
    n++;
    return n;
  }
  keep(n: number): void {
    this.last = n;
    this.all.push(n);
  }
  index(n: number): string {
    return "abcdefgh"[n];
  }
}

const own = new NumberMeter();
const meter: Meter = own;
const values: [string, number | string | null | undefined | boolean | bigint][] = [
  ["5", 5],
  ["2.5", 2.5],
  ["-0", -0],
  ["NaN", NaN],
  ["'5'", "5"],
  ["'text'", "text"],
  ["''", ""],
  ["null", null],
  ["undefined", undefined],
  ["true", true],
  ["7n", 7n],
];

for (const [label, value] of values) {
  show(label + " same", () => meter.same(value));
  show(label + " plusOne", () => meter.plusOne(value));
  show(label + " twice", () => meter.twice(value));
  show(label + " whole", () => meter.whole(value));
  show(label + " unsigned", () => meter.unsigned(value));
  show(label + " negated", () => meter.negated(value));
  show(label + " fixed", () => meter.fixed(value));
  show(label + " below", () => meter.below(value));
  show(label + " isFive", () => meter.isFive(value));
  show(label + " truthy", () => meter.truthy(value));
  show(label + " root", () => meter.root(value));
  show(label + " next", () => meter.next(value));
  show(label + " index", () => meter.index(value));
  show(label + " keep", () => meter.keep(value));
  show(label + " kept", () => own.last);
  show(label + " kept plus one", () => own.last + 1);
}
show("all kept", () => own.all.map(n => typeof n).join());
show("sum of all but the last", () => {
  let sum = 0;
  for (let i = 0; i < own.all.length - 1; i++) sum += own.all[i];
  return sum;
});
//// a-method-that-takes-a-string-is-called-with-a-number.ts
////= text-12

type Wide = string | number | null | undefined | string[] | { length: number };

interface Reader {
  same(v: Wide): string;
  size(v: Wide): number;
  first(v: Wide): string;
  code(v: Wide): number;
  upper(v: Wide): string;
  joined(v: Wide): string;
  template(v: Wide): string;
  slice(v: Wide): string;
  has(v: Wide): boolean;
  equal(v: Wide): boolean;
  before(v: Wide): boolean;
  letters(v: Wide): string;
  keep(v: Wide): void;
  asKey(v: Wide): number;
}

const table: Record<string, number> = { abc: 1, "5": 2, undefined: 3, null: 4, "a,b": 5 };

class StringReader implements Reader {
  last: string = "";
  all: string[] = [];
  same(s: string): string {
    return s;
  }
  size(s: string): number {
    return s.length;
  }
  first(s: string): string {
    return s[0];
  }
  code(s: string): number {
    return s.charCodeAt(0);
  }
  upper(s: string): string {
    return s.toUpperCase();
  }
  joined(s: string): string {
    return s + "!";
  }
  template(s: string): string {
    return `<${s}>`;
  }
  slice(s: string): string {
    return s.slice(1);
  }
  has(s: string): boolean {
    return s.includes("b");
  }
  equal(s: string): boolean {
    return s === "abc";
  }
  before(s: string): boolean {
    return s < "b";
  }
  letters(s: string): string {
    let out = "";
    for (const letter of s) out += "[" + letter + "]";
    return out;
  }
  keep(s: string): void {
    this.last = s;
    this.all.push(s);
  }
  asKey(s: string): number {
    return table[s];
  }
}

const own = new StringReader();
const reader: Reader = own;
const values: [string, Wide][] = [
  ["'abc'", "abc"],
  ["''", ""],
  ["5", 5],
  ["NaN", NaN],
  ["null", null],
  ["undefined", undefined],
  ["['a','b']", ["a", "b"]],
  ["{length:2}", { length: 2 }],
];

for (const [label, value] of values) {
  show(label + " same", () => reader.same(value));
  show(label + " size", () => reader.size(value));
  show(label + " first", () => reader.first(value));
  show(label + " code", () => reader.code(value));
  show(label + " upper", () => reader.upper(value));
  show(label + " joined", () => reader.joined(value));
  show(label + " template", () => reader.template(value));
  show(label + " slice", () => reader.slice(value));
  show(label + " has", () => reader.has(value));
  show(label + " equal", () => reader.equal(value));
  show(label + " before", () => reader.before(value));
  show(label + " letters", () => reader.letters(value));
  show(label + " asKey", () => reader.asKey(value));
  show(label + " keep", () => reader.keep(value));
  show(label + " kept", () => own.last);
  show(label + " kept length", () => own.last.length);
}
show("all kept", () => own.all.map(s => typeof s).join());
show("all kept joined", () => own.all.join("|"));
//// a-method-that-takes-a-wider-literal-shape-reads-a-member-that-is-not-there.ts
////= text-12

////= lines-27	Point2	x	number	y	number
interface Point3 extends Point2 {
  z: number;
  label: string;
}

interface Plotter {
  depth(p: Point2): number;
  sum(p: Point2): number;
  title(p: Point2): string;
  raise(p: Point2): void;
  copy(p: Point2): Point3;
}

const plotter: Plotter = {
  depth(p: Point3) {
    return p.z;
  },
  sum(p: Point3) {
    return p.x + p.y + p.z;
  },
  title(p: Point3) {
    return p.label.toUpperCase();
  },
  raise(p: Point3) {
    p.z += 1;
  },
  copy(p: Point3) {
    return { ...p };
  },
};

function makers(): [string, Point2][] {
  const extra = { x: 1, y: 2, w: "extra", z: "a string called z" };
  const reordered = { label: "r", z: 30, y: 20, x: 10 };
  const whole: Point3 = { x: 1, y: 2, z: 3, label: "p" };
  return [
    ["honest", whole],
    ["flat", { x: 1, y: 2 }],
    ["another z", extra],
    ["reordered", reordered],
    ["class", new (class Flat { x = 5; y = 6; })()],
    ["honest again", reordered],
  ];
}

for (const [kind, p] of makers()) {
  show(kind + " depth", () => plotter.depth(p));
  show(kind + " sum", () => plotter.sum(p));
  show(kind + " title", () => plotter.title(p));
  show(kind + " copy", () => plotter.copy(p));
  show(kind + " raise", () => plotter.raise(p));
  show(kind + " afterwards", () => p);
  show(kind + " keys", () => Object.keys(p).join());
}

const honest: Point3 = { x: 1, y: 1, z: 1, label: "h" };
let total = 0;
for (let i = 0; i < 2000; i++) total += plotter.sum(honest);
show("2000 honest sums", () => total);
show("then a flat one", () => plotter.sum({ x: 1, y: 1 }));
show("then an honest one", () => plotter.sum(honest));
//// a-method-that-takes-an-array-is-called-with-something-else.ts
////= text-12

type Wide = number[] | string | Set<number> | { length: number; 0: number } | Float64Array | null;

interface Summer {
  size(v: Wide): number;
  first(v: Wide): number;
  sum(v: Wide): number;
  sumOf(v: Wide): number;
  add(v: Wide): number;
  doubled(v: Wide): number[];
  spread(v: Wide): number[];
  head(v: Wide): number;
  put(v: Wide): void;
  isArray(v: Wide): boolean;
}

class ArraySummer implements Summer {
  size(list: number[]): number {
    return list.length;
  }
  first(list: number[]): number {
    return list[0];
  }
  sum(list: number[]): number {
    let sum = 0;
    for (let i = 0; i < list.length; i++) sum += list[i];
    return sum;
  }
  sumOf(list: number[]): number {
    let sum = 0;
    for (const n of list) sum += n;
    return sum;
  }
  add(list: number[]): number {
    return list.push(4);
  }
  doubled(list: number[]): number[] {
    return list.map(n => n * 2);
  }
  spread(list: number[]): number[] {
    return [...list, 99];
  }
  head(list: number[]): number {
    const [head] = list;
    return head;
  }
  put(list: number[]): void {
    list[1] = 50;
  }
  isArray(list: number[]): boolean {
    return Array.isArray(list);
  }
}

const summer: Summer = new ArraySummer();
const makers: [string, () => Wide][] = [
  ["array", () => [1, 2, 3]],
  ["string", () => "123"],
  ["set", () => new Set([1, 2, 3])],
  ["array-like", () => ({ length: 2, 0: 10, 1: 20 })],
  ["float64", () => new Float64Array([1.5, 2.5, 3.5])],
  ["null", () => null],
  ["array again", () => [4, 5, 6]],
];

for (const [label, make] of makers) {
  show(label + " size", () => summer.size(make()));
  show(label + " first", () => summer.first(make()));
  show(label + " sum", () => summer.sum(make()));
  show(label + " sumOf", () => summer.sumOf(make()));
  show(label + " add", () => summer.add(make()));
  show(label + " doubled", () => summer.doubled(make()));
  show(label + " spread", () => summer.spread(make()));
  show(label + " head", () => summer.head(make()));
  show(label + " isArray", () => summer.isArray(make()));
  show(label + " put", () => {
    const value = make();
    summer.put(value);
    return value instanceof Set ? [...value, Object.keys(value).join()] : value;
  });
}
//// a-method-that-takes-containers-of-dogs-gets-containers-of-cats.ts
////= Person-5

interface Wide {
  list(v: Animal[]): string;
  legsTotal(v: Animal[]): number;
  map(v: Map<string, Animal>): string;
  set(v: Set<Animal>): string;
  home(v: { pet: Animal }): string;
  deep(v: { home: { pet: Animal } }): string;
  maker(v: () => Animal): string;
  pair(v: [Animal, Animal]): string;
  record(v: Record<string, Animal>): string;
  later(v: Promise<Animal>): Promise<string>;
  closure(v: Animal): () => string;
}

function about(d: Dog): string {
  let bark: string;
  try {
    bark = d.bark();
  } catch (error) {
    bark = "no bark";
  }
  return typeof d.legs + " " + d.legs + " " + typeof d.tag + " " + typeof d.owner + " " + bark;
}

class Narrow implements Wide {
  list(dogs: Dog[]): string {
    return dogs.map(about).join("; ");
  }
  legsTotal(dogs: Dog[]): number {
    let total = 0;
    for (const d of dogs) total += d.legs;
    return total;
  }
  map(dogs: Map<string, Dog>): string {
    const out: string[] = [];
    for (const [key, d] of dogs) out.push(key + " " + about(d));
    return out.join("; ");
  }
  set(dogs: Set<Dog>): string {
    return [...dogs].map(about).join("; ");
  }
  home(home: { pet: Dog }): string {
    return about(home.pet);
  }
  deep(v: { home: { pet: Dog } }): string {
    return typeof v.home.pet.legs + " " + (v.home.pet.legs + 1);
  }
  maker(make: () => Dog): string {
    return about(make());
  }
  pair([first, second]: [Dog, Dog]): string {
    return about(first) + "; " + about(second);
  }
  record(dogs: Record<string, Dog>): string {
    return Object.keys(dogs).map(key => key + " " + about(dogs[key])).join("; ");
  }
  async later(dog: Promise<Dog>): Promise<string> {
    return about(await dog);
  }
  closure(d: Dog): () => string {
    return () => about(d);
  }
}

const wide: Wide = new Narrow();
const rex = new Dog("rex");
const tom = new Cat("tom");
const boris = new Spider("boris");

show("list of dogs", () => wide.list([rex, rex]));
show("list with a cat", () => wide.list([rex, tom, boris]));
show("legs of dogs", () => wide.legsTotal([rex, rex]));
show("legs with a cat", () => wide.legsTotal([rex, tom]));
show("legs with a spider", () => wide.legsTotal([rex, boris]));
show("map of dogs", () => wide.map(new Map([["r", rex]])));
show("map with a cat", () => wide.map(new Map<string, Animal>([["r", rex], ["t", tom]])));
show("set with a cat", () => wide.set(new Set<Animal>([rex, tom])));
show("home of a dog", () => wide.home({ pet: rex }));
show("home of a cat", () => wide.home({ pet: tom }));
show("deep home of a dog", () => wide.deep({ home: { pet: rex } }));
show("deep home of a cat", () => wide.deep({ home: { pet: tom } }));
show("deep home of a spider", () => wide.deep({ home: { pet: boris } }));
show("maker of a dog", () => wide.maker(() => rex));
show("maker of a cat", () => wide.maker(() => tom));
show("pair", () => wide.pair([tom, rex]));
show("record", () => wide.record({ r: rex, t: tom }));
const dogClosure = wide.closure(rex);
const catClosure = wide.closure(tom);
show("closure over a dog", dogClosure);
show("closure over a cat", catClosure);
show("closure over a dog again", dogClosure);
show("honest call of the helper", () => about(rex));

wide.later(Promise.resolve(rex)).then(result => {
  console.log("promise of a dog: " + result);
  return wide.later(Promise.resolve(tom));
}).then(result => console.log("promise of a cat: " + result));
//// a-method-that-takes-numbers-gets-an-array-of-something-else.ts
////= text-12

type Loose = (number | string | undefined | null | boolean | number[] | { valueOf(): number })[];

interface Stats {
  sum(list: Loose): number;
  sumOf(list: Loose): number;
  reduced(list: Loose): number;
  doubled(list: Loose): number[];
  whole(list: Loose): number[];
  largest(list: Loose): number;
  sorted(list: Loose): number[];
  sortedByValue(list: Loose): number[];
  first(list: Loose): number;
  firstFixed(list: Loose): string;
  hasTwo(list: Loose): boolean;
  grown(list: Loose): number;
  toFloats(list: Loose): number[];
  kinds(list: Loose): string;
}

class NumberStats implements Stats {
  sum(list: number[]): number {
    let total = 0;
    for (let i = 0; i < list.length; i++) total += list[i];
    return total;
  }
  sumOf(list: number[]): number {
    let total = 0;
    for (const n of list) total += n;
    return total;
  }
  reduced(list: number[]): number {
    return list.reduce((a, b) => a + b, 0);
  }
  doubled(list: number[]): number[] {
    return list.map(n => n * 2);
  }
  whole(list: number[]): number[] {
    return list.map(n => n | 0);
  }
  largest(list: number[]): number {
    return Math.max(...list);
  }
  sorted(list: number[]): number[] {
    return [...list].sort();
  }
  sortedByValue(list: number[]): number[] {
    return [...list].sort((a, b) => a - b);
  }
  first(list: number[]): number {
    return list[0];
  }
  firstFixed(list: number[]): string {
    return list[0].toFixed(1);
  }
  hasTwo(list: number[]): boolean {
    return list.includes(2);
  }
  grown(list: number[]): number {
    const copy = list.slice();
    copy.push(1.5);
    return copy[copy.length - 1] + copy.length;
  }
  toFloats(list: number[]): number[] {
    return Array.from(new Float64Array(list));
  }
  kinds(list: number[]): string {
    return list.map(n => typeof n).join();
  }
}

const stats: Stats = new NumberStats();
const holes: number[] = [1, 2, 3];
delete holes[1];
const lists: [string, Loose][] = [
  ["whole numbers", [3, 1, 2]],
  ["fractions", [1.5, 0.5, 2]],
  ["strings", ["3", "1", "2"]],
  ["words", ["b", "a"]],
  ["mixed", [1, "2", 3]],
  ["undefined inside", [1, undefined, 3]],
  ["null inside", [1, null, 3]],
  ["booleans", [true, false]],
  ["nested", [[1], [2, 3]]],
  ["objects", [{ valueOf: () => 4 }, { valueOf: () => 2 }]],
  ["holes", holes],
  ["empty", []],
  ["whole numbers again", [3, 1, 2]],
];

function list(values: unknown[]): string {
  return values.map(v => typeof v + ":" + (Object.is(v, -0) ? "-0" : String(v))).join(" ");
}

for (const [label, values] of lists) {
  show(label + " sum", () => stats.sum(values));
  show(label + " sumOf", () => stats.sumOf(values));
  show(label + " reduced", () => stats.reduced(values));
  show(label + " doubled", () => list(stats.doubled(values)));
  show(label + " whole", () => list(stats.whole(values)));
  show(label + " largest", () => stats.largest(values));
  show(label + " sorted", () => list(stats.sorted(values)));
  show(label + " sortedByValue", () => list(stats.sortedByValue(values)));
  show(label + " first", () => stats.first(values));
  show(label + " firstFixed", () => stats.firstFixed(values));
  show(label + " hasTwo", () => stats.hasTwo(values));
  show(label + " grown", () => stats.grown(values));
  show(label + " toFloats", () => list(stats.toFloats(values)));
  show(label + " kinds", () => stats.kinds(values));
}
//// a-method-that-takes-one-member-of-a-union-gets-another.ts
////= text-12

////= lines-27	Circle	kind	"circle"	radius	number
////= lines-27	Square	kind	"square"	side	number
interface Label {
  kind: "label";
  text: string;
  radius: string;
}
type Shape = Circle | Square | Label;

interface Wide {
  kind(s: Shape): string;
  isCircle(s: Shape): boolean;
  isNotCircle(s: Shape): boolean;
  radius(s: Shape): number;
  area(s: Shape): number;
  guarded(s: Shape): number;
  switched(s: Shape): string;
  grow(s: Shape): void;
  onlyUndefined(v: undefined | number | null | string): string;
  onlyNull(v: undefined | number | null | string): string;
  onlyTrue(v: boolean | number): string;
  onlyOne(v: number): string;
}

class Narrow implements Wide {
  kind(c: Circle): string {
    return c.kind;
  }
  isCircle(c: Circle): boolean {
    return c.kind === "circle";
  }
  isNotCircle(c: Circle): boolean {
    return c.kind !== "circle";
  }
  radius(c: Circle): number {
    return c.radius;
  }
  area(c: Circle): number {
    return c.radius * c.radius * 3;
  }
  guarded(c: Circle): number {
    return c.kind === "circle" ? c.radius : -1;
  }
  switched(c: Circle): string {
    switch (c.kind) {
      case "circle":
        return "a circle";
      default:
        return "something else";
    }
  }
  grow(c: Circle): void {
    c.radius += 1;
  }
  onlyUndefined(u: undefined): string {
    return (u === undefined) + " " + typeof u + " " + (u ?? "fallback") + " " + String(u);
  }
  onlyNull(n: null): string {
    return (n === null) + " " + typeof n + " " + (n ?? "fallback") + " " + String(n);
  }
  onlyTrue(t: true): string {
    return (t === true) + " " + (t ? "yes" : "no") + " " + !t + " " + String(t);
  }
  onlyOne(one: 1): string {
    return (one === 1) + " " + (one + 1) + " " + one * 2 + " " + String(one);
  }
}

const wide: Wide = new Narrow();
const shapes: [string, () => Shape][] = [
  ["circle", () => ({ kind: "circle", radius: 2 })],
  ["square", () => ({ kind: "square", side: 3 })],
  ["label", () => ({ kind: "label", text: "t", radius: "wide" })],
  ["circle with other key order", () => ({ radius: 4, kind: "circle" })],
];
for (const [label, make] of shapes) {
  show(label + " kind", () => wide.kind(make()));
  show(label + " isCircle", () => wide.isCircle(make()));
  show(label + " isNotCircle", () => wide.isNotCircle(make()));
  show(label + " radius", () => wide.radius(make()));
  show(label + " area", () => wide.area(make()));
  show(label + " guarded", () => wide.guarded(make()));
  show(label + " switched", () => wide.switched(make()));
  show(label + " grow", () => {
    const shape = make();
    wide.grow(shape);
    return shape;
  });
}
for (const value of [undefined, null, 0, 5, "", "text"]) {
  show(String(value) + " (" + typeof value + ") as undefined", () => wide.onlyUndefined(value));
  show(String(value) + " (" + typeof value + ") as null", () => wide.onlyNull(value));
}
for (const value of [true, false, 1, 0]) show(String(value) + " as true", () => wide.onlyTrue(value));
for (const value of [1, 2, 0, -0, NaN, 1.5]) show(String(value) + " as 1", () => wide.onlyOne(value));
//// a-method-that-uses-its-number-as-an-index-or-a-count-gets-something-else.ts
////= text-12

type Wide = number | string | null | undefined | boolean;

interface Counts {
  at(v: Wide): string;
  put(v: Wide): string;
  loop(v: Wide): number;
  down(v: Wide): number;
  fresh(v: Wide): number;
  repeat(v: Wide): string;
  slice(v: Wide): string;
  odd(v: Wide): number;
  shift(v: Wide): number;
  floor(v: Wide): number;
  char(v: Wide): string;
  clamp(v: Wide): number;
  typed(v: Wide): number;
}

const letters = ["a", "b", "c", "d"];

class NumberCounts implements Counts {
  at(i: number): string {
    return letters[i];
  }
  put(i: number): string {
    const copy = ["a", "b"];
    copy[i] = "z";
    return copy.length + " " + Object.keys(copy).join("+");
  }
  loop(n: number): number {
    let rounds = 0;
    for (let i = 0; i < n; i++) rounds++;
    return rounds;
  }
  down(n: number): number {
    let rounds = 0;
    while (n > 0 && rounds < 10) {
      n--;
      rounds++;
    }
    return rounds;
  }
  fresh(n: number): number {
    return new Array<number>(n).length;
  }
  repeat(n: number): string {
    return "x".repeat(n);
  }
  slice(n: number): string {
    return letters.slice(n).join("");
  }
  odd(n: number): number {
    return n % 2;
  }
  shift(n: number): number {
    return n << 1;
  }
  floor(n: number): number {
    return Math.floor(n);
  }
  char(n: number): string {
    return "abcd".charAt(n);
  }
  clamp(n: number): number {
    return Math.min(Math.max(n, 0), 3);
  }
  typed(n: number): number {
    return new Uint8Array([7, 8, 9])[n];
  }
}

const counts: Counts = new NumberCounts();
const values: [string, Wide][] = [
  ["2", 2],
  ["1.5", 1.5],
  ["-1", -1],
  ["-0", -0],
  ["NaN", NaN],
  ["2 ** 31", 2 ** 31],
  ["2 ** 32 + 1", 2 ** 32 + 1],
  ["'2'", "2"],
  ["'02'", "02"],
  ["'length'", "length"],
  ["''", ""],
  ["null", null],
  ["undefined", undefined],
  ["true", true],
  ["2 again", 2],
];

for (const [label, value] of values) {
  show(label + " at", () => counts.at(value));
  show(label + " put", () => counts.put(value));
  if (value !== 2 ** 31 && value !== 2 ** 32 + 1) show(label + " loop", () => counts.loop(value));
  show(label + " down", () => counts.down(value));
  if (value !== 2 ** 31) show(label + " fresh", () => counts.fresh(value));
  if (value !== 2 ** 31 && value !== 2 ** 32 + 1) show(label + " repeat", () => counts.repeat(value));
  show(label + " slice", () => counts.slice(value));
  show(label + " odd", () => counts.odd(value));
  show(label + " shift", () => counts.shift(value));
  show(label + " floor", () => counts.floor(value));
  show(label + " char", () => counts.char(value));
  show(label + " clamp", () => counts.clamp(value));
  show(label + " typed", () => counts.typed(value));
}
