//// a-module-patches-a-class-that-another-module-already-uses/logger.ts
export class Logger {
  lines: string[] = [];
  prefix = "log";
  format(message: string): string {
    return this.prefix + ": " + message;
  }
  write(message: string): number {
    return this.lines.push(this.format(message));
  }
  static create(): Logger {
    return new Logger();
  }
}

export const shared = Logger.create();
//// a-module-patches-a-class-that-another-module-already-uses/main.ts
import { early, use } from "./user.ts";
import { remove } from "./plugin.ts";
import { shared } from "./logger.ts";

console.log("before the plugin loaded: " + early);
console.log("after it loaded: " + use("first"));

let letters = 0;
for (let i = 0; i < 2000; i++) letters += use("w").length;
console.log("2000 rounds: " + letters);

remove();
console.log("the plugin removed: " + use("second"));
console.log("lines of the shared logger: " + shared.lines.length + ", " + shared.lines[0] + ", " + shared.lines[1] + ", " + shared.lines[shared.lines.length - 1]);
//// a-module-patches-a-class-that-another-module-already-uses/plugin.ts
import { Logger } from "./logger.ts";

const format = Logger.prototype.format;
const create = Logger.create;

Logger.prototype.format = function (message) {
  return "[" + format.call(this, message) + "]";
};

Logger.create = () => {
  const made = create();
  made.prefix = "plugin";
  return made;
};

export function remove(): void {
  Logger.prototype.format = format;
  Logger.create = create;
}
//// a-module-patches-a-class-that-another-module-already-uses/user.ts
import { Logger, shared } from "./logger.ts";

export function use(message: string): string {
  shared.write(message);
  const own = Logger.create();
  own.write(message);
  return shared.lines[shared.lines.length - 1] + " | " + own.lines.join() + " | " + own.format("direct");
}

export const early = use("while the modules load");
