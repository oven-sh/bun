////: Point-9
class Point {
  x: number;
  y: number;
  constructor(x: number, y: number) {
    this.x = x;
    this.y = y;
  }
  clone(): Point {
    return new Point(this.x, this.y);
  }
  norm(): number {
    return this.x * this.x + this.y * this.y;
  }
}
////: Sink
class Sink {
  take(p: Pair): void {}
  takeList(list: number[]): void {}
  takeFunction(f: () => number): void {}
}
////: Table
class Table {
  row(): number[] {
    return [1, 2, 3];
  }
}
////: around
function around(c: Cell): string {
  const a = c.value;
  const s = c.text;
  c.touch();
  return a + " " + c.value + " " + s + " " + c.text;
}
////: churn
function churn(): number {
  let total = 0;
  for (let i = 0; i < 20000; i++) {
    const junk = { x: -i, y: -i, z: [i, i, i] };
    total += junk.z.length + junk.x - junk.y;
  }
  return total;
}
////: copying
function copying(this: Builder, part: string): Builder {
  const next = new Builder();
  next.parts = [...this.parts, part.toUpperCase()];
  return next;
}
////: counting
function counting(this: Circle): number {
  calls++;
  return this.r + calls;
}
////: diverting
function diverting(part: string): Builder {
  spare.parts.push(part);
  return spare;
}
////: feed
function feed(s: Sink, i: number): number {
  const p = { x: i, y: i * 2 };
  s.take(p);
  return p.x + p.y;
}
////: feed-2
