function Streaming(Base: new () => Point) {
  return class extends Base {
    step = 10;
    async later(): Promise<number> {
      await null;
      return this.x + this.step;
    }
    *each(): Generator<number> {
      yield this.x;
      yield this.y;
      yield this.step;
    }
    async *slowly(): AsyncGenerator<number> {
      yield this.sum();
      yield this.step;
    }
  };
}

