////: round
function round(label: string, c: Circle): void {
  calls = 0;
  const parts: string[] = [];
  for (const [name, run] of [
    ["unused", () => unused(c)],
    ["twice", () => twice(c)],
    ["loop", () => loop(c, 5)],
    ["short circuit, true", () => shortCircuit(c, true)],
    ["short circuit, false", () => shortCircuit(c, false)],
    ["overwritten", () => overwritten(c)],
    ["times zero", () => timesZero(c)],
    ["in a condition", () => inACondition(c)],
  ] satisfies [string, () => unknown][]) {
    const before = calls;
    parts.push(name + " " + String(run()) + " (" + (calls - before) + ")");
  }
  console.log(label + ": " + parts.join(", "));
}
////: round-4
function round(label: string, s: Sink): void {
  const parts: string[] = [];
  for (let i = 1; i <= 3; i++) parts.push(feed(s, i) + " " + feedList(s, i) + " " + feedFunction(s, i));
  console.log(label + ": " + parts.join(" | "));
}
////: round-5
function round(label: string): void {
  log.length = 0;
  console.log(label + ": " + guarded(new Gate()) + " | " + partial(new Gate()) + " | " + stores(new Gate()) + " | " + inALoop(new Gate()) + " | " + outer(new Gate()) + " | " + log.join());
}
////: round-6
function round(label: string): void {
  spare.parts.length = 0;
  console.log(label + ": " + chain(new Builder()) + " | " + same(new Builder()) + " | " + ignoring(new Builder()) + " | " + loop(new Builder()) + " | spare " + spare.build());
}
////: same
function same(b: Builder): string {
  const r = b.add("x");
  return (r === b) + " " + r.parts.length + " " + b.parts.length;
}
