////: ignoring
function ignoring(b: Builder): string {
  b.add("p");
  b.add("q");
  return b.build();
}
////: inALoop-4
function inALoop(g: Gate): string {
  let done = 0;
  let failed = 0;
  for (let i = 0; i < 4; i++) {
    try {
      g.open();
      done++;
    } catch {
      failed++;
    }
  }
  return done + " done, " + failed + " failed, " + g.passes + " passes";
}
////: integers
function integers(t: Table): string {
  const r = t.row();
  return [r[0] | 0, r[1] + 1, r[2] * 2, r[0] / 2, r.length].map(n => (Object.is(n, -0) ? "-0" : String(n))).join(" ");
}
////: keepList
function keepList(list: number[]): void {
