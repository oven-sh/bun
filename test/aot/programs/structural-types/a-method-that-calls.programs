////: feedFunction
function feedFunction(s: Sink, i: number): number {
  let count = i;
  s.takeFunction(() => ++count);
  return count;
}
////: feedList
function feedList(s: Sink, i: number): string {
  const list = [i, i + 1];
  s.takeList(list);
  return list.length + ":" + list.join();
}
////: grow
function grow(t: Table): string {
  const r = t.row();
  try {
    r.push(4);
    r[0] = 100;
  } catch (error) {
    return "threw " + (error instanceof Error ? error.constructor.name : typeof error) + " " + show(r);
  }
  return show(r);
}
////: guarded
function guarded(g: Gate): string {
  try {
    return "opened " + g.open();
  } catch (error) {
    return "caught " + (error instanceof Error ? error.constructor.name : typeof error);
  } finally {
    log.push("finally");
  }
}
