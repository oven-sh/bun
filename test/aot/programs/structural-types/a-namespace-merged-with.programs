class Meter {
  own: number;
  constructor(own: number, extra: number, note: string) {
    this.own = own;
    this.extra = extra;
    this.note = note;
  }
  plusExtra(): number {
    return this.own + this.extra;
  }
  heading(): string {
    return this.note + "!";
  }
}

