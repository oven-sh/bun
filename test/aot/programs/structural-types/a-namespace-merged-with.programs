//// a-partial-with-undefined-is-spread-over-required-number-fields.ts
////= show-32

interface Size {
  width: number;
  height: number;
  scale: number;
}

function area(s: Size): number {
  return s.width * s.height * s.scale;
}

function report(title: string, s: Size): void {
  console.log(title + ": " + typeof s.width + " " + show(s.width) + ", " + typeof s.height + " " + show(s.height) + ", " + typeof s.scale + " " + show(s.scale) + ", keys " + Object.keys(s).join() + ", " + JSON.stringify(s));
  attempt("  area", () => area(s));
  attempt("  width + 1", () => s.width + 1);
  attempt("  width | 0", () => s.width | 0);
  attempt("  scale + 0.5", () => s.scale + 0.5);
  attempt("  width.toFixed(0)", () => s.width.toFixed(0));
  attempt("  'width' in it", () => "width" in s);
  attempt("  width === undefined", () => s.width === undefined);
}

const full: Size = { width: 2, height: 3, scale: 0.5 };

let total = 0;
for (let i = 0; i < 2000; i++) {
  const change: Partial<Size> = i % 2 === 0 ? { width: i } : { scale: i / 4 };
  const next: Size = { ...full, ...change };
  total += area(next);
}
console.log("2000 honest spreads: " + total);

const nothing: Partial<Size> = {};
const same: Size = { ...full, ...nothing };
report("an empty partial", same);

const blankWidth: Partial<Size> = { width: undefined };
const first: Size = { ...full, ...blankWidth };
report("width: undefined", first);

const blankScale: Partial<Size> = { scale: undefined, height: 7 };
const second: Size = { ...full, ...blankScale };
report("scale: undefined and a height", second);

const blankAll: Partial<Size> = { scale: undefined, height: undefined, width: undefined };
const third: Size = { ...full, ...blankAll };
report("all three undefined", third);

const onTop: Size = { ...blankAll, ...full };
report("the other way around: the partial's order of keys", onTop);

const twice: Size = { ...full, ...blankWidth, ...{ width: 9 } };
report("undefined and then a number", twice);

report("the full one was never touched", full);

export {};
//// a-partial-with-undefined-is-spread-over-required-strings-objects-and-functions.ts
////= show-32

////= lines-35	Owner	name	"ann"	greet	"hello "

interface Card {
  title: string;
  owner: Owner;
  tags: string[];
  open: () => number;
  active: boolean;
}

function report(label: string, c: Card): void {
  console.log(label + ": " + typeof c.title + ", " + typeof c.owner + ", " + typeof c.tags + ", " + typeof c.open + ", " + typeof c.active + ", keys " + Object.keys(c).join() + ", " + JSON.stringify(c));
  attempt("  title.length", () => c.title.length);
  attempt("  title + '!'", () => c.title + "!");
  attempt("  owner.greet()", () => c.owner.greet());
  attempt("  owner.name", () => c.owner.name);
  attempt("  tags.length", () => c.tags.length);
  attempt("  tags[0]", () => c.tags[0]);
  attempt("  open()", () => c.open());
  attempt("  active ? 1 : 2", () => (c.active ? 1 : 2));
  attempt("  active === false", () => c.active === false);
}

const full: Card = { title: "card", owner: new Owner(), tags: ["t"], open: () => 1, active: true };
report("the full one", full);

const noTitle: Partial<Card> = { title: undefined };
const a: Card = { ...full, ...noTitle };
report("title: undefined", a);

const noOwner: Partial<Card> = { owner: undefined };
const b: Card = { ...full, ...noOwner };
report("owner: undefined", b);

const noTags: Partial<Card> = { tags: undefined };
const c: Card = { ...full, ...noTags };
report("tags: undefined", c);

const noOpen: Partial<Card> = { open: undefined };
const d: Card = { ...full, ...noOpen };
report("open: undefined", d);

const noFlag: Partial<Card> = { active: undefined };
const e: Card = { ...full, ...noFlag };
report("active: undefined", e);

export {};
//// a-pet-field-gets-a-primitive-through-a-wider-alias.ts
////= show-33

class Home {
  street = "main";
  pet: Dog = new Dog("rex");
  number = 12;
  legs(): number {
    return this.pet.legs + 1;
  }
  petKind(): string {
    return typeof this.pet;
  }
  hasPet(): boolean {
    return this.pet ? true : false;
  }
}

function legsOf(home: { pet: Dog }): number {
  return home.pet.legs + 1;
}

function nameOf(home: { pet: Dog }): string {
  return home.pet.name;
}

function barkOf(home: { pet: Dog }): string {
  return home.pet.bark();
}

////= lines-102	put	home	pet	unknown	value	home.pet

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const home = new Home();
  const literal = { pet: new Dog("d") };
  put(home, new Dog("e"));
  put(literal, new Dog("f"));
  warm += home.legs() + home.petKind().length + (home.hasPet() ? 1 : 0) + legsOf(home) + legsOf(literal) + nameOf(literal).length + barkOf(home).length;
}
console.log("after 2000 honest homes", warm);

const visitors: [string, unknown][] = [
  ["5", 5],
  ["0", 0],
  ["-0", -0],
  ["2.5", 2.5],
  ["NaN", NaN],
  ["2 ** 40", 2 ** 40],
  ["a string", "text"],
  ["an empty string", ""],
  ["true", true],
  ["false", false],
  ["null", null],
  ["undefined", undefined],
  ["a symbol", Symbol("s")],
  ["a bigint", 5n],
  ["a function", legsOf],
  ["an empty object", {}],
];
for (const [name, visitor] of visitors) {
  attempt(name + " in an instance: what is held", () => {
    const home = new Home();
    put(home, visitor);
    const held: unknown = home.pet;
    return [home.petKind(), held, Object.is(held, visitor), home.hasPet(), home.street, home.number];
  });
  attempt(name + " in an instance: legs + 1", () => {
    const home = new Home();
    put(home, visitor);
    return [home.legs(), legsOf(home)];
  });
  attempt(name + " in an instance: name", () => {
    const home = new Home();
    put(home, visitor);
    return nameOf(home);
  });
  attempt(name + " in an instance: bark", () => {
    const home = new Home();
    put(home, visitor);
    return barkOf(home);
  });
  attempt(name + " in a literal", () => {
    const home = { before: 1, pet: new Dog("rex"), after: 2 };
    put(home, visitor);
    const held: unknown = home.pet;
    return [typeof home.pet, held, home.before, home.after, JSON.stringify(Object.keys(home))];
  });
  attempt(name + " in a literal: legs + 1", () => {
    const home = { pet: new Dog("rex") };
    put(home, visitor);
    return legsOf(home);
  });
  attempt(name + ": a dog comes back", () => {
    const home = new Home();
    put(home, visitor);
    put(home, new Dog("back"));
    return [home.legs(), barkOf(home)];
  });
}
//// a-pet-field-is-stored-to-through-a-wider-alias.ts
////= show-33

class Home {
  street = "main";
  pet: Dog = new Dog("rex");
  number = 12;
  legs(): number {
    return this.pet.legs + 1;
  }
  bark(): string {
    return this.pet.bark();
  }
}

function legsOf(home: { pet: Dog }): number {
  return home.pet.legs + 1;
}

function tagOf(home: { pet: Dog }): number {
  return home.pet.tag.length;
}

function ownerOf(home: { pet: Dog }): number {
  return home.pet.owner.id;
}

function barkOf(home: { pet: Dog }): string {
  return home.pet.bark();
}

////= lines-102	adopt	home	pet	Animal	animal	home.pet

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const literal = { pet: new Dog("d") };
  const home = new Home();
  warm += legsOf(literal) + tagOf(literal) + ownerOf(literal) + barkOf(literal).length + legsOf(home) + home.legs() + home.bark().length;
  adopt(literal, new Dog("e"));
  adopt(home, new Dog("f"));
  warm += legsOf(literal) + home.legs();
}
console.log("after 2000 honest homes", warm);

function report(name: string, home: { pet: Dog }): void {
  attempt(name + ": legs + 1", () => legsOf(home));
  attempt(name + ": length of the tag", () => tagOf(home));
  attempt(name + ": id of the owner", () => ownerOf(home));
  attempt(name + ": bark", () => barkOf(home));
  attempt(name + ": in place", () => [home.pet.name, home.pet.legs, home.pet.tag, home.pet instanceof Dog]);
}

{
  const home = { pet: new Dog("rex") };
  const wide: { pet: Animal } = home;
  wide.pet = new Cat("tom");
  report("a literal, by an alias", home);
}
{
  const home = { pet: new Dog("rex") };
  adopt(home, new Cat("tom"));
  report("a literal, in a callee", home);
}
{
  const home = new Home();
  adopt(home, new Cat("tom"));
  report("an instance, in a callee", home);
  attempt("an instance: its own methods", () => [home.legs(), home.street, home.number]);
  attempt("an instance: its own bark", () => home.bark());
}
{
  const home = new Home();
  adopt(home, new Animal("plain"));
  report("an instance gets a plain animal", home);
}
{
  const home = { pet: new Dog("rex") };
  adopt(home, { name: "only a name" });
  report("a literal gets a literal", home);
}
{
  const fixed: { readonly pet: Dog } = { pet: new Dog("rex") };
  adopt(fixed, new Cat("tom"));
  attempt("a readonly member", () => [fixed.pet.legs, fixed.pet.name]);
}
{
  const town = { home: { pet: new Dog("rex") } };
  const wide: { home: { pet: Animal } } = town;
  wide.home.pet = new Cat("tom");
  attempt("nested: the inner member", () => town.home.pet.legs + 1);
  wide.home = { pet: new Cat("kit") };
  attempt("nested: the outer member", () => [town.home.pet.legs + 1, town.home.pet.name]);
}
attempt("in the middle of a loop", () => {
  const home = new Home();
  const wide: { pet: Animal } = home;
  let total = 0;
  for (let i = 0; i < 2000; i++) {
    if (i === 1500) wide.pet = new Cat("tom");
    if (i === 1510) wide.pet = new Dog("back");
    total += Number.isNaN(home.pet.legs + 0) ? 1000 : home.pet.legs;
  }
  return total;
});
attempt("null through an alias", () => {
  const home = new Home();
  const wide: { pet: Dog | null } = home;
  wide.pet = null;
  return home.legs();
});
attempt("undefined through an alias", () => {
  const home = new Home();
  const wide: { pet?: Dog } = home;
  wide.pet = undefined;
  return [Object.keys(home), home.pet === undefined, home.legs()];
});
attempt("deleted through an alias", () => {
  const home = new Home();
  const wide: { pet?: Dog } = home;
  delete wide.pet;
  return [Object.keys(home), "pet" in home, home.pet === undefined];
});
report("an honest home again", new Home());
//// a-polluted-array-across-await-and-yield.ts
////= show-33

async function totalLegs(dogs: Dog[]): Promise<number> {
  let total = 0;
  for (let i = 0; i < dogs.length; i++) {
    await null;
    total += dogs[i].legs;
  }
  return total;
}

async function legsBeforeAndAfter(dogs: Dog[], between: () => void): Promise<unknown[]> {
  const before = dogs[0].legs;
  await null;
  between();
  await null;
  return [before, dogs[0].legs, dogs[0].name];
}

async function heldAcrossAnAwait(dogs: Dog[], between: () => void): Promise<unknown[]> {
  const dog = dogs[0];
  await Promise.resolve().then(between);
  return [dog.legs, dogs[0].legs];
}

function* eachLegs(dogs: Dog[]): Generator<number> {
  for (const dog of dogs) yield dog.legs;
}

function* eachDog(dogs: Dog[]): Generator<Dog, void, Animal | undefined> {
  const animals: Animal[] = dogs;
  for (let i = 0; i < dogs.length; i++) {
    const replacement = yield dogs[i];
    if (replacement !== undefined && i + 1 < dogs.length) animals[i + 1] = replacement;
  }
}

function kennel(): Dog[] {
  return [new Dog("rex"), new Dog("fido"), new Dog("spot")];
}

let warm = 0;
for (let i = 0; i < 300; i++) {
  warm += (await totalLegs(kennel())) + (await legsBeforeAndAfter(kennel(), () => {})).length + [...eachLegs(kennel())].length;
}
console.log("after 300 honest kennels", warm);

{
  const dogs = kennel();
  const animals: Animal[] = dogs;
  animals[1] = new Cat("tom");
  console.log("polluted before the call ->", show(await totalLegs(dogs)));
}
{
  const dogs = kennel();
  const animals: Animal[] = dogs;
  const pending = totalLegs(dogs);
  animals[2] = new Cat("tom");
  console.log("polluted while the function is suspended ->", show(await pending));
}
{
  const dogs = kennel();
  const animals: Animal[] = dogs;
  console.log("polluted between two awaits ->", show(await legsBeforeAndAfter(dogs, () => void (animals[0] = new Cat("tom")))));
}
{
  const dogs = kennel();
  const animals: Animal[] = dogs;
  console.log("an element held across an await ->", show(await heldAcrossAnAwait(dogs, () => void (animals[0] = new Cat("tom")))));
}
attempt("polluted between two yields", () => {
  const dogs = kennel();
  const animals: Animal[] = dogs;
  const seen: unknown[] = [];
  for (const legs of eachLegs(dogs)) {
    seen.push(legs);
    animals[2] = new Cat("tom");
  }
  return seen;
});
attempt("a cat is sent into the generator", () => {
  const generator = eachDog(kennel());
  const seen: unknown[] = [];
  let step = generator.next();
  while (!step.done) {
    seen.push(step.value.name, step.value.legs);
    step = generator.next(seen.length === 2 ? new Cat("tom") : undefined);
  }
  return seen;
});
{
  const dogs = kennel();
  const animals: Animal[] = dogs;
  animals.push(new Cat("tom"));
  console.log("mapped to promises ->", show(await Promise.all(dogs.map(async dog => dog.legs + 1))));
}

export {};
