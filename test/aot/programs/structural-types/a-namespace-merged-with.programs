attempt("an array of numbers and objects", () => sumAsText([1, new Price(250), 0.5, { toFixed: () => "x" }, NaN]));
attempt("numbers computed at run time", () => {
  const amounts: Fixable[] = [];
  for (let i = 0; i < 5; i++) amounts.push(i / 2);
  return sumAsText(amounts);
});
