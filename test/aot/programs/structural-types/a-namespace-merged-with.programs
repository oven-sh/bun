class Meter {
  own: number;
  constructor(own: number) {
    this.own = own;
  }
  plusExtra(): number {
    return this.own + this.extra;
  }
}

function filled(own: number, extra: number): Meter {
  const meter = new Meter(own);
  meter.extra = extra;
  return meter;
}

