////= Color
function fail(value: never): string {
  return "undefined: " + (value === undefined) + ", null: " + (value === null) + ", a number: " + (typeof value === "number");
}
function nameOf(color: Color): string {
  switch (color) {
    case Color.Red:
      return "red";
    case Color.Green:
      return "green";
    default:
      return fail(color);
  }
}
