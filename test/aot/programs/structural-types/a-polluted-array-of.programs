type HasLength = { length: number };

////= lines-20	size	this	HasLength	number	return	this.length

////= lines-57	kind	this	HasLength

////= lines-223	isTheSame	this	HasLength	other

function sizeInALoop(this: HasLength, times: number): number {
  let total = 0;
  for (let i = 0; i < times; i++) total += this.length;
  return total;
}

function grow(this: HasLength): number {
  this.length = this.length + 1;
  return this.length;
}

function fixed(this: { toFixed(digits: number): string }): string {
  return typeof this + " " + this.toFixed(1);
}

function later(this: HasLength): () => number {
  return () => this.length;
}

const values: [string, () => HasLength][] = [
  ["literal", () => ({ length: 4 })],
  ["string", () => "hello"],
  ["empty string", () => ""],
  ["array", () => [1, 2]],
  ["function", () => size],
  ["typed array", () => new Uint8Array(3)],
];

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = { length: i };
  warm += size.call(honest) + kind.call(honest).length + (isTheSame.call(honest, honest) ? 1 : 0) + sizeInALoop.call(honest, 2) + grow.call(honest) + later.call(honest)();
}
console.log("after 2000 literals", warm);

for (const [name, make] of values) {
  attempt(name + ": call", () => size.call(make()));
  attempt(name + ": apply", () => size.apply(make()));
  attempt(name + ": bind", () => size.bind(make())());
  attempt(name + ": Reflect.apply", () => Reflect.apply(size, make(), []));
  attempt(name + ": typeof this", () => kind.call(make()));
  attempt(name + ": this is the value", () => {
    const value = make();
    return isTheSame.call(value, value);
  });
  attempt(name + ": in a loop", () => sizeInALoop.call(make(), 3));
  attempt(name + ": a store to this", () => grow.call(make()));
  attempt(name + ": captured by an arrow function", () => later.call(make())());
  attempt(name + ": as a method of a holder", () => {
    const holder = { length: 99, size };
    return [holder.size(), holder.size.call(make())];
  });
}
attempt("numbers as this", () => [fixed.call(1), fixed.call(2.5), fixed.call(-0), fixed.call(new Number(3)), fixed.call({ toFixed: () => "own" })]);
attempt("this from forEach", () => {
  const seen: string[] = [];
  [1].forEach(function (this: HasLength) {
    seen.push(typeof this + " " + this.length);
  }, "abc");
  [1].forEach(function (this: HasLength) {
    seen.push(typeof this + " " + this.length);
  }, { length: 7 });
  return seen;
});
//// a-primitive-is-used-as-a-weak-key.ts
////= show-30

type HasLength = { length: number };

const weights = new WeakMap<HasLength, number>();
const seen = new WeakSet<HasLength>();

function remember(item: HasLength, weight: number): number | undefined {
  weights.set(item, weight);
  return weights.get(item);
}

function recall(item: HasLength): number | undefined {
  return weights.get(item);
}

////= lines-36	known	item	HasLength	boolean	weights.has	item

////= lines-36	forget	item	HasLength	boolean	weights.delete	item

function mark(item: HasLength): boolean {
  seen.add(item);
  return seen.has(item);
}

////= lines-36	marked	item	HasLength	boolean	seen.has	item

function weakly(item: HasLength): number | undefined {
  return new WeakRef(item).deref()?.length;
}

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = { length: i };
  warm += (remember(honest, i) ?? 0) + (recall(honest) ?? 0) + (known(honest) ? 1 : 0) + (forget(honest) ? 1 : 0) + (mark(honest) ? 1 : 0) + (marked(honest) ? 1 : 0) + (weakly(honest) ?? 0);
}
console.log("after 2000 literals", warm);

const values: [string, HasLength][] = [
  ["literal", { length: 1 }],
  ["string", "abc"],
  ["empty string", ""],
  ["array", [1]],
  ["function", remember],
  ["String object", new String("abc")],
];
for (const [name, value] of values) {
  attempt(name + ": get before", () => recall(value));
  attempt(name + ": has before", () => known(value));
  attempt(name + ": delete before", () => forget(value));
  attempt(name + ": set", () => remember(value, 5));
  attempt(name + ": get after", () => recall(value));
  attempt(name + ": has after", () => known(value));
  attempt(name + ": add", () => mark(value));
  attempt(name + ": marked", () => marked(value));
  attempt(name + ": WeakRef", () => weakly(value));
}

function keyed(key: {} & object, value: number): number | undefined {
  return new WeakMap<object, number>([[key, value]]).get(key);
}
