function checkedInPlace(list: number[]): number {
  if (list[0] !== undefined) return list[0] + 1;
  return -1;
}

function checkedThenChanged(list: number[], change: () => void): number {
  if (list[0] !== undefined) {
    change();
    return list[0] + 1;
  }
  return -1;
}

