class Record2 {
  count: number;
  name: string;
  items: number[];
  owner: Dog;
  ready: boolean;
  run: () => number;

  next(): number {
    return this.count + 1;
  }
  bump(): number {
    return ++this.count;
  }
  title(): string {
    return this.name + "!";
  }
  width(): number {
    return this.name.length;
  }
  total(): number {
    let sum = 0;
    for (const n of this.items) sum += n;
    return sum;
  }
  add(n: number): number {
    return this.items.push(n);
  }
  legs(): number {
    return this.owner.legs;
  }
  state(): string {
    return this.ready ? "ready" : "waiting";
  }
  go(): number {
    return this.run() + 1;
  }
  fill(): this {
    this.count = 1;
    this.name = "ab";
    this.items = [1, 2];
    this.owner = new Dog();
    this.ready = true;
    this.run = () => 5;
    return this;
  }
}

attempt("honest", () => {
  const r = new Record2().fill();
  return [r.next(), r.bump(), r.title(), r.width(), r.total(), r.add(3), r.legs(), r.state(), r.go(), Object.keys(r)];
});
let warm = 0;
for (let i = 0; i < 2000; i++) {
  const r = new Record2().fill();
  warm += r.next() + r.bump() + r.width() + r.total() + r.add(i) + r.legs() + r.go();
}
