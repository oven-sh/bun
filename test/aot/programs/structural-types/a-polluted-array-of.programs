//// a-proxy-is-frozen-sealed-and-kept-from-growing.ts
////= show-38

const log: string[] = [];

////= logged

function watched(target: Vec): Vec {
  return new Proxy(target, {
    isExtensible: inner => (log.push("isExtensible"), Reflect.isExtensible(inner)),
    preventExtensions: inner => (log.push("preventExtensions"), Reflect.preventExtensions(inner)),
    defineProperty: (inner, key, descriptor) => (log.push("define:" + String(key)), Reflect.defineProperty(inner, key, descriptor)),
    getOwnPropertyDescriptor: (inner, key) => (log.push("describe:" + String(key)), Reflect.getOwnPropertyDescriptor(inner, key)),
    ownKeys: inner => (log.push("ownKeys"), Reflect.ownKeys(inner)),
    set: (inner, key, value, receiver) => (log.push("set:" + String(key)), Reflect.set(inner, key, value, receiver)),
  });
}

////= lines-239	setX	v	Vec	v.x	9

function grow(v: Vec & { extra?: number }): number | undefined {
  v.extra = 1;
  return v.extra;
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += setX(new Vec(i, 1)) + (grow(new Vec(i, 1)) ?? 0);
console.log("after 2000 honest vectors", warm);

logged("a store", () => setX(watched(new Vec(3, 4))));
logged("a new member", () => grow(watched(new Vec(3, 4))));
logged("freeze", () => Object.isFrozen(Object.freeze(watched(new Vec(3, 4)))));
logged("seal", () => Object.isSealed(Object.seal(watched(new Vec(3, 4)))));
logged("preventExtensions", () => Object.isExtensible(Object.preventExtensions(watched(new Vec(3, 4)))));
logged("a store after freeze", () => setX(Object.freeze(watched(new Vec(3, 4)))));
logged("a store after seal", () => setX(Object.seal(watched(new Vec(3, 4)))));
logged("a new member after preventExtensions", () => grow(Object.preventExtensions(watched(new Vec(3, 4)))));
logged("the target is frozen through the proxy", () => {
  const target = new Vec(3, 4);
  Object.freeze(watched(target));
  return [Object.isFrozen(target), (() => { try { return setX(target); } catch { return "threw"; } })()];
});
logged("the target is frozen behind the proxy's back", () => {
  const target = new Vec(3, 4);
  const proxy = watched(target);
  const before = setX(proxy);
  Object.freeze(target);
  return [before, (() => { try { return setX(proxy); } catch { return "threw"; } })(), proxy.x];
});
logged("a proxy that refuses to stop growing", () => Object.preventExtensions(new Proxy(new Vec(3, 4), { preventExtensions: () => false })));
logged("a proxy that only says that it stopped growing", () => Object.preventExtensions(new Proxy(new Vec(3, 4), { preventExtensions: () => true })));
logged("a proxy that lies about growing", () => Object.isExtensible(new Proxy(new Vec(3, 4), { isExtensible: () => false })));
logged("a proxy that refuses definitions", () => Object.defineProperty(new Proxy(new Vec(3, 4), { defineProperty: () => false }), "x", { value: 1 }));
logged("a store through a proxy that refuses definitions", () => setX(new Proxy(new Vec(3, 4), { defineProperty: () => (log.push("define"), false) })));
logged("honest again", () => [setX(new Vec(3, 4)), grow(new Vec(3, 4))]);
//// a-proxy-is-revoked-in-the-middle-of-typed-code.ts
////= show-38

const log: string[] = [];

////= logged

////= lines-68	total	v	Vec	number	v.x	v.y

function sumWhile(v: Vec, rounds: number, between: (round: number) => void): string {
  let sum = 0;
  let round = 0;
  try {
    for (; round < rounds; round++) {
      between(round);
      sum += v.x;
    }
  } catch (error) {
    return "threw " + (error instanceof TypeError) + " in round " + round + " with " + sum;
  }
  return "finished with " + sum;
}

function twoReads(v: Vec, between: () => number): number {
  return v.x + between() + v.y;
}

function callAfter(v: Vec, between: () => void): number {
  const norm = v.norm;
  between();
  return norm.call(v);
}

async function acrossAnAwait(v: Vec, between: () => void): Promise<string> {
  const before = v.x;
  await Promise.resolve().then(between);
  try {
    return before + " " + v.x;
  } catch (error) {
    return before + " threw " + (error instanceof TypeError);
  }
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += total(new Vec(i, 1)) + twoReads(new Vec(i, 1), () => 0) + callAfter(new Vec(3, 4), () => {});
console.log("after 2000 honest vectors", warm, sumWhile(new Vec(1, 1), 2000, () => {}));

attempt("before it is revoked", () => {
  const { proxy } = Proxy.revocable(new Vec(3, 4), {});
  return [total(proxy), proxy.norm(), typeof proxy];
});
attempt("in round 1500 of a loop", () => {
  const { proxy, revoke } = Proxy.revocable(new Vec(1, 1), {});
  return sumWhile(proxy, 3000, round => void (round === 1500 && revoke()));
});
attempt("between two reads of one expression", () => {
  const { proxy, revoke } = Proxy.revocable(new Vec(3, 4), {});
  return twoReads(proxy, () => (revoke(), 0));
});
attempt("between the read of a method and its call", () => {
  const { proxy, revoke } = Proxy.revocable(new Vec(3, 4), {});
  return callAfter(proxy, revoke);
});
attempt("by one of its own traps", () => {
  const pair = Proxy.revocable(new Vec(3, 4), {
    get(target, key, receiver) {
      if (key === "y") pair.revoke();
      return Reflect.get(target, key, receiver);
    },
  });
  return [total(pair.proxy), (() => { try { return total(pair.proxy); } catch { return "threw"; } })()];
});
attempt("what still works afterwards", () => {
  const { proxy, revoke } = Proxy.revocable(new Vec(3, 4), {});
  revoke();
  const list: Vec[] = [proxy];
  return [typeof proxy, proxy === list[0], list.includes(proxy), new Set(list).has(proxy), list.length];
});
const throwing: [string, (v: Vec) => unknown][] = [
  ["a read", v => v.x],
  ["a store", v => (v.x = 1)],
  ["a call", v => v.norm()],
  ["in", v => "x" in v],
  ["delete", v => Reflect.deleteProperty(v, "x")],
  ["keys", v => Object.keys(v)],
  ["instanceof", v => v instanceof Vec],
  ["isArray", v => Array.isArray(v)],
  ["JSON", v => JSON.stringify(v)],
  ["spread", v => ({ ...v })],
  ["String()", v => String(v)],
  ["a template", v => `${v}`],
  ["getPrototypeOf", v => Object.getPrototypeOf(v)],
  ["isFrozen", v => Object.isFrozen(v)],
  ["a proxy around it", v => typeof new Proxy(v, {})],
  ["a read through a proxy around it", v => new Proxy(v, {}).x],
  ["a read through a child of it", v => {
    const child: Vec = Object.create(v);
    return child.x;
  }],
];
for (const [name, use] of throwing) {
  attempt("revoked: " + name, () => {
    const { proxy, revoke } = Proxy.revocable(new Vec(3, 4), {});
    revoke();
    return use(proxy);
  });
}
{
  const { proxy, revoke } = Proxy.revocable(new Vec(3, 4), {});
  console.log("across an await -> " + (await acrossAnAwait(proxy, revoke)));
}
attempt("revoked twice", () => {
  const { revoke } = Proxy.revocable(new Vec(3, 4), {});
  revoke();
  revoke();
  return "fine";
});

export {};
//// a-proxy-is-the-prototype-of-an-object-typed-as-a-vector.ts
////= show-38

const log: string[] = [];

////= logged

////= watched	Vec): Vec	getPrototypeOf: inner => (log.push("getPrototypeOf"), Reflect.getPrototypeOf(inner

function child(): Vec {
  return Object.create(watched(new Vec(3, 4)));
}

function childWithX(): Vec {
  return Object.create(watched(new Vec(3, 4)), { x: { value: 30, writable: true, enumerable: true, configurable: true } });
}

function reparented(): Vec {
  return Object.setPrototypeOf(new Vec(1, 2), watched(new Vec(3, 4)));
}

const uses: [string, (v: Vec) => unknown][] = [
  ["x + y", v => v.x + v.y],
  ["name", v => v.name],
  ["norm()", v => v.norm()],
  ["the getter", v => v.sum],
  ["x = 9", v => {
    v.x = 9;
    return [v.x, Object.keys(v)];
  }],
  ["y++", v => {
    v.y++;
    return [v.y, Object.keys(v)];
  }],
  ["the setter", v => {
    v.sum = 7;
    return [v.x, v.y, Object.keys(v)];
  }],
  ["in", v => ["x" in v, "missing" in v]],
  ["own", v => [Object.hasOwn(v, "x"), Object.hasOwn(v, "y")]],
  ["instanceof", v => v instanceof Vec],
  ["keys", v => Object.keys(v)],
  ["for-in", v => {
    const names: string[] = [];
    for (const name in v) names.push(name);
    return names;
  }],
  ["JSON", v => JSON.stringify(v)],
];
for (const [, use] of uses) for (let i = 0; i < 500; i++) use(new Vec(3, 4));
console.log("after 500 honest vectors at every use");

for (const [name, make] of [["an empty child", child], ["a child with its own x", childWithX], ["a vector with a new prototype", reparented]] satisfies [string, () => Vec][]) {
  for (const [use, run] of uses) logged(name + ": " + use, () => run(make()));
}
logged("a prototype that swallows stores", () => {
  const swallowing: Vec = Object.create(new Proxy(new Vec(3, 4), { set: (_, key) => (log.push("set:" + String(key)), true) }));
  swallowing.x = 9;
  return [swallowing.x, Object.keys(swallowing)];
});
logged("a prototype that refuses stores", () => {
  const refusing: Vec = Object.create(new Proxy(new Vec(3, 4), { set: () => false }));
  refusing.x = 9;
  return refusing.x;
});
//// a-proxy-is-this-of-methods-getters-and-setters.ts
////= show-38

const log: string[] = [];

////= logged

class Account {
  balance = 10;
  history: number[] = [];
  deposit(amount: number): number {
    this.balance += amount;
    this.history.push(amount);
    return this.balance;
  }
  get doubled(): number {
    return this.balance * 2;
  }
  set doubled(value: number) {
    this.balance = value / 2;
  }
  self(): Account {
    return this;
  }
  later(): () => number {
    return () => this.balance;
  }
  static open(this: typeof Account): Account {
    return new this();
  }
}

function watched<T extends object>(target: T): T {
  return new Proxy(target, {
    get: (inner, key, receiver) => (log.push("get:" + String(key)), Reflect.get(inner, key, receiver)),
    set: (inner, key, value, receiver) => (log.push("set:" + String(key)), Reflect.set(inner, key, value, receiver)),
  });
}

function deposit(account: Account, amount: number): number {
  return account.deposit(amount);
}

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = new Account();
  warm += deposit(honest, i) + honest.doubled + honest.later()() + (honest.self() === honest ? 1 : 0);
  honest.doubled = 4;
}
console.log("after 2000 honest accounts", warm);

logged("a method called on the proxy", () => deposit(watched(new Account()), 5));
logged("a method of the target called with the proxy as this", () => {
  const target = new Account();
  return [target.deposit.call(watched(target), 5), target.balance];
});
logged("a method of the proxy called with the target as this", () => {
  const target = new Account();
  return watched(target).deposit.call(target, 5);
});
logged("the getter", () => watched(new Account()).doubled);
logged("the setter", () => {
  const target = new Account();
  watched(target).doubled = 50;
  return target.balance;
});
logged("this comes back", () => {
  const target = new Account();
  const proxy = watched(target);
  return [proxy.self() === proxy, proxy.self() === target];
});
logged("this captured by an arrow function", () => watched(new Account()).later()());
logged("apply", () => Reflect.apply(Account.prototype.deposit, watched(new Account()), [5]));
logged("bind", () => Account.prototype.deposit.bind(watched(new Account()), 5)());
logged("the getter taken from its descriptor", () => Object.getOwnPropertyDescriptor(Account.prototype, "doubled")?.get?.call(watched(new Account())));
logged("Reflect.get with the proxy as the receiver", () => Reflect.get(new Account(), "doubled", watched(new Account())));
logged("Reflect.set with the proxy as the receiver", () => {
  const receiver = new Account();
  return [Reflect.set(new Account(), "doubled", 50, watched(receiver)), receiver.balance];
});
logged("a static method with a proxy of the class as this", () => watched(Account).open().balance);
logged("a vector's norm on a proxy", () => watched(new Vec(3, 4)).norm());
logged("handed to forEach as this", () => {
  const seen: number[] = [];
  [1].forEach(function (this: Account) {
    seen.push(this.balance);
  }, watched(new Account()));
  return seen;
});
