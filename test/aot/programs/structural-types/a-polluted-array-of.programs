export function origin() {
  return { x: 0, y: 0 };
}

export class Counter {
  constructor(start) {
    this.n = start;
  }
  next() {
    return ++this.n;
  }
}

export const limit = 10;
//// a-project-with-paths-packages-and-declaration-files-honest/packages/shapes/index.ts
////= Point-14

export class Pixel implements Point {
  constructor(
    public x: number,
    public y: number,
  ) {}
  sum(): number {
    return this.x + this.y;
  }
}

export function sum(p: Point): number {
  return p.x + p.y;
}
//// a-project-with-paths-packages-and-declaration-files-honest/src/scale.ts
import settings from "#settings";
import type { Point } from "shapes";

export function scaled(p: Point): Point {
  return { x: p.x * settings.scale + settings.offset.x, y: p.y * settings.scale + settings.offset.y };
}
