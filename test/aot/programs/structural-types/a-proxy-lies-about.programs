function change(l: Loose, size: number): void {
  l.size = size;
  l.label = "changed";
}

function readAroundACall(f: Fixed, act: () => void): string {
  const before = f.size;
  act();
  const after = f.size;
  return before + " -> " + after;
}

function sumWhileChanging(f: Fixed, l: Loose): number {
  let sum = 0;
  for (let i = 0; i < 2000; i++) {
    sum += f.size;
    if (i === 999) l.size = 2;
  }
  return sum;
}

