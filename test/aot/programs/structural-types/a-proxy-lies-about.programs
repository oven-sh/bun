////= show-30

const log: string[] = [];

////= logged

////= watched	number[]): number[]	deleteProperty: (inner, key) => (log.push("delete:" + String(key)), Reflect.deleteProperty(inner, key

////= sum

////= sumByForOf

const uses: [string, (numbers: number[]) => unknown][] = [
  ["sum", sum],
  ["sum by for-of", sumByForOf],
  ["length", numbers => numbers.length],
  ["[1]", numbers => numbers[1]],
  ["[5]", numbers => numbers[5]],
  ["[1] = 9", numbers => (numbers[1] = 9)],
  ["push", numbers => numbers.push(4)],
  ["pop", numbers => numbers.pop()],
  ["shift", numbers => numbers.shift()],
  ["length = 1", numbers => (numbers.length = 1)],
  ["map", numbers => numbers.map(number => number * 2)],
  ["indexOf", numbers => numbers.indexOf(3)],
  ["includes", numbers => numbers.includes(3)],
  ["join", numbers => numbers.join("-")],
  ["reverse", numbers => sum(numbers.reverse())],
  ["spread", numbers => [...numbers]],
  ["a pattern", numbers => {
    const [first, second] = numbers;
    return [first, second];
  }],
  ["Math.max", numbers => Math.max(...numbers)],
  ["concat", numbers => [0].concat(numbers)],
  ["1 in", numbers => 1 in numbers],
  ["delete [1]", numbers => delete numbers[1]],
  ["isArray", numbers => Array.isArray(numbers)],
  ["instanceof", numbers => numbers instanceof Array],
  ["JSON", numbers => JSON.stringify(numbers)],
  ["keys", numbers => Object.keys(numbers)],
  ["Array.from", numbers => Array.from(numbers)],
  ["a Float64Array", numbers => new Float64Array(numbers).length],
];
for (const [, use] of uses) for (let i = 0; i < 500; i++) use([1, 2, 3]);
console.log("after 500 honest arrays at every use");

for (const [name, use] of uses) logged(name, () => use(watched([1, 2, 3])));
logged("a proxy whose elements are doubled", () => {
  const doubled = new Proxy([1, 2, 3], { get: (inner, key, receiver) => (typeof key === "string" && /^\d+$/.test(key) ? inner[Number(key)] * 2 : Reflect.get(inner, key, receiver)) });
  return [sum(doubled), sumByForOf(doubled), doubled.map(number => number), [...doubled]];
});
logged("a proxy that claims a longer length", () => {
  const longer = new Proxy([1, 2, 3], { get: (inner, key, receiver) => (key === "length" ? 5 : Reflect.get(inner, key, receiver)) });
  return [longer.length, sum(longer), [...longer], longer.map(number => number).length];
});
logged("a proxy whose elements are strings", () => {
  const texts = new Proxy([1, 2, 3], { get: (inner, key, receiver) => (typeof key === "string" && /^\d+$/.test(key) ? "s" + key : Reflect.get(inner, key, receiver)) });
  return [sum(texts), typeof texts[0], texts[0] * 2];
});
logged("a proxy among arrays", () => [[1, 2], watched([3, 4]), [5, 6]].map(sum));
//// a-proxy-under-an-object-type-logs-its-traps.ts
////= Point-2

const log: string[] = [];

function watched(target: Point): Point {
  return new Proxy(target, {
    get(t, key, receiver) {
      log.push("get " + String(key));
      return Reflect.get(t, key, receiver);
    },
    set(t, key, value, receiver) {
      log.push("set " + String(key) + "=" + String(value));
      return Reflect.set(t, key, value, receiver);
    },
    has(t, key) {
      log.push("has " + String(key));
      return Reflect.has(t, key);
    },
    ownKeys(t) {
      log.push("ownKeys");
      return Reflect.ownKeys(t);
    },
    getOwnPropertyDescriptor(t, key) {
      log.push("describe " + String(key));
      return Reflect.getOwnPropertyDescriptor(t, key);
    },
    defineProperty(t, key, descriptor) {
      log.push("define " + String(key));
      return Reflect.defineProperty(t, key, descriptor);
    },
    deleteProperty(t, key) {
      log.push("delete " + String(key));
      return Reflect.deleteProperty(t, key);
    },
    getPrototypeOf(t) {
      log.push("getPrototypeOf");
      return Reflect.getPrototypeOf(t);
    },
  });
}

////= flush

////= sum-2

function reversedSum(p: Point): number {
  return p.y - p.x;
}

function move(p: Point): void {
  p.x += 1;
  p.y = p.x;
}

////= lines-134	Holder	point	Point	sum	point.x	point.y

////= lines-86	Pair	7	8	total

const p = watched({ x: 1, y: 2 });
flush("x then y", sum(p));
flush("y then x", reversedSum(p));
flush("stores", move(p));
flush("field", new Holder(p).sum());
flush("in", "x" in p);
flush("hasOwn", Object.hasOwn(p, "x"));
flush("keys", Object.keys(p).join());
flush("entries", Object.entries(p).join("|"));
flush("json", JSON.stringify(p));
flush("spread", JSON.stringify({ ...p }));
flush("rest pattern", JSON.stringify((({ x, ...rest }: Point) => rest)(p)));
flush("for-in", (() => {
  let keys = "";
  for (const key in p) keys += key;
  return keys;
})());
flush("assign from", JSON.stringify(Object.assign({}, p)));
flush("assign to", JSON.stringify(Object.assign(p, { x: 5 })));
flush("pattern", (({ y, x }: Point) => y * 10 + x)(p));
flush("instanceof", p instanceof Object);
flush("typeof", typeof p);

const plain: Point = { x: 1, y: 2 };
let total = 0;
for (let i = 0; i < 2000; i++) total += sum(plain);
flush("2000 honest", total);
flush("then the proxy", sum(p));
flush("then plain", sum(plain));

const list: Point[] = [plain, p, plain];
flush("elements", list.map(sum).join());

const instance: Pair = new Proxy(new Pair(), {
  get(t, key, receiver) {
    log.push("get " + String(key));
    return Reflect.get(t, key, receiver);
  },
});
flush("a method through a proxy of an instance", instance.total());
flush("instanceof its class", instance instanceof Pair);

const inventing: Point = new Proxy({ x: 0, y: 0 }, { get: (_, key) => (key === "x" ? 40 : 2) });
flush("a proxy that invents its values", sum(inventing));

const { proxy: revocable, revoke } = Proxy.revocable({ x: 1, y: 1 }, {});
const soonGone: Point = revocable;
flush("before revoking", sum(soonGone));
revoke();
try {
  flush("after revoking", sum(soonGone));
} catch (error) {
  flush("after revoking", "threw " + (error instanceof Error ? error.constructor.name : typeof error));
}

