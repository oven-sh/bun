import readByDefault, { Holder, honest, listing, read, store } from "./reader.ts";
import * as reader from "./reader.ts";
import { log, makers } from "./makers.ts";

////= attempt-15

for (const [label, make] of makers) attempt("before any honest use, " + label, () => read(make()));

console.log("the reader's own honest uses: " + honest());

for (const [label, make] of makers) {
  attempt(label + ", read", () => read(make()));
  attempt(label + ", the default export", () => readByDefault(make()));
  attempt(label + ", through the namespace", () => reader.read(make()));
  attempt(label + ", listing", () => listing(make()));
  attempt(label + ", stored", () => {
    const p = make();
    store(p, 50);
    return read(p) + " " + JSON.stringify(p);
  });
  attempt(label + ", in the other module's class", () => new Holder(make()).read());
}

const late = await import("./reader.ts");
for (const [label, make] of makers) attempt(label + ", through a dynamic import", () => late.read(make()));

console.log("honest again: " + honest());
//// a-reader-in-one-module-gets-other-layouts-from-another/makers.ts
import type { Point } from "./reader.ts";

export const log: string[] = [];

export class Reversed {
  y = 4;
  x = 3;
}

export function flipped(): Point {
  return { y: 2, x: 1 };
}

export function wide(): Point {
  const all = { a: "a", y: 6, b: "b", x: 5, c: "c" };
  return all;
}

export function accessors(): Point {
  let x = 7;
  return {
    get x() {
      log.push("get x");
      return x;
    },
    set x(value: number) {
      log.push("set x " + value);
      x = value;
    },
    y: 8,
  };
}

export function inherited(): Point {
  return Object.create({ x: 9, y: 10 });
}

export function frozen(): Point {
  return Object.freeze({ x: 11, y: 12 });
}

export const makers: [string, () => Point][] = [
  ["flipped", flipped],
  ["wide", wide],
  ["a class", () => new Reversed()],
  ["accessors", accessors],
  ["inherited", inherited],
  ["frozen", frozen],
];
//// a-reader-in-one-module-gets-other-layouts-from-another/reader.ts
////= Point-14

export function read(p: Point): number {
  return p.x * 100 + p.y;
}

export function store(p: Point, value: number): void {
  p.x = value;
  p.y = value + 1;
}

export function listing(p: Point): string {
  let walked = "";
  for (const key in p) walked += key;
  return Object.keys(p).join() + " " + walked + " " + JSON.stringify(p) + " " + JSON.stringify({ ...p });
}

export function honest(): number {
  let total = 0;
  for (let i = 0; i < 2000; i++) {
    const p: Point = { x: i, y: i };
    store(p, i);
    total += read(p) + listing(p).length;
  }
  return total;
}

export class Holder {
  constructor(public point: Point) {}
  read(): number {
    return this.point.x * 100 + this.point.y;
  }
}

export default read;
//// a-readonly-array-changes-under-its-reader.ts
////= show-30

function firstTwice(list: ReadonlyArray<number>, change: () => void): number[] {
  const before = list[0];
  change();
  return [before, list[0]];
}

function lengthTwice(list: readonly number[], change: () => void): number[] {
  const before = list.length;
  change();
  return [before, list.length];
}

function sumWhileChanging(list: readonly number[], change: (index: number) => void): number {
  let total = 0;
  for (let i = 0; i < list.length; i++) {
    total += list[i];
    change(i);
  }
  return total;
}

function sumByForOfWhileChanging(list: readonly number[], change: (value: number) => void): number {
  let total = 0;
  for (const value of list) {
    total += value;
    change(value);
  }
  return total;
}

function lastAfter(list: readonly number[], change: () => void): unknown[] {
  const index = list.length - 1;
  change();
  return [index in list, list[index], typeof list[index]];
}

function kindsAfter(list: readonly number[], change: () => void): string {
  change();
  return list.map(value => typeof value).join();
}

class Ledger {
  private entries: number[] = [1, 2, 3];
  get view(): readonly number[] {
    return this.entries;
  }
  add(value: number): void {
    this.entries.push(value);
  }
  clear(): void {
    this.entries.length = 0;
  }
}

let warm = 0;
const still: readonly number[] = [1, 2, 3];
for (let i = 0; i < 2000; i++) {
  warm += firstTwice(still, () => {})[1] + lengthTwice(still, () => {})[1] + sumWhileChanging(still, () => {}) + sumByForOfWhileChanging(still, () => {});
}
console.log("after 2000 arrays that stay", warm);

attempt("the first element is stored to", () => {
  const list = [1, 2, 3];
  return firstTwice(list, () => void (list[0] = 100));
});
