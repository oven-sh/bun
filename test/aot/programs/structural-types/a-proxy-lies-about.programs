//// a-required-parameter-behind-an-optional-one-in-a-method.ts
////= Person-5

interface Walker {
  walk(d: Dog, miles?: number): number;
  call(d: Dog, word?: string): string;
  pair(d: Dog, friend?: Dog): number;
  list(d: Dog, extra?: string[]): number;
  then(d: Dog, after?: () => string): string;
}

class StrictWalker implements Walker {
  total: number = 0;
  walk(d: Dog, miles: number): number {
    this.total += miles;
    return d.legs * miles;
  }
  call(d: Dog, word: string): string {
    return d.name + " " + word.toUpperCase();
  }
  pair(d: Dog, friend: Dog): number {
    return d.legs + friend.legs;
  }
  list(d: Dog, extra: string[]): number {
    return d.tricks.length + extra.length;
  }
  then(d: Dog, after: () => string): string {
    return d.name + after();
  }
}

const own = new StrictWalker();
const walker: Walker = own;
const rex = new Dog("rex");

show("typed walk", () => own.walk(rex, 2));
show("typed call", () => own.call(rex, "come"));
show("typed pair", () => own.pair(rex, rex));
show("typed list", () => own.list(rex, ["x"]));
show("typed then", () => own.then(rex, () => "!"));
show("total", () => own.total);

show("walk with miles", () => walker.walk(rex, 3));
show("walk without", () => walker.walk(rex));
show("walk with undefined", () => walker.walk(rex, undefined));
show("total after a walk without miles", () => own.total);
show("typeof total", () => typeof own.total);
show("call without", () => walker.call(rex));
show("pair without", () => walker.pair(rex));
show("list without", () => walker.list(rex));
show("then without", () => walker.then(rex));

own.total = 0;
for (let i = 0; i < 2000; i++) walker.walk(rex, 1);
show("2000 walks with miles", () => own.total);
walker.walk(rex);
show("one more without", () => own.total);
own.total = 5;
show("typed walk again", () => own.walk(rex, 2));
show("total again", () => own.total);
//// a-required-view-of-an-object-loses-members-through-its-optional-alias.ts
////= text-11

interface Options {
  depth?: number;
  title?: string;
  tags?: string[];
  onDone?: () => number;
}

type Full = Required<Options>;

////= lines-21	depthPlusOne	full	Full	number	full.depth

////= lines-32	titleLength	full	Full	number	full.title.length

////= lines-32	tagCount	full	Full	number	full.tags.length

////= lines-19	finish	full	Full	number	full.onDone

function fresh(): Full {
  return { depth: 1, title: "full", tags: ["t"], onDone: () => 9 };
}

function all(label: string, full: Full): void {
  show(label + ": the number", () => [full.depth, depthPlusOne(full)]);
  show(label + ": the text", () => full.title);
  show(label + ": the length of the text", () => titleLength(full));
  show(label + ": the list", () => tagCount(full));
  show(label + ": the function", () => finish(full));
  show(label + ": keys", () => Object.keys(full));
  show(label + ": JSON", () => JSON.stringify(full));
}

class Job {
  options: Full = fresh();
  run(): number {
    return this.options.depth + this.options.title.length + this.options.onDone();
  }
}

let sum = 0;
for (let i = 0; i < 2000; i++) {
  const full = fresh();
  sum += depthPlusOne(full) + titleLength(full) + tagCount(full) + finish(full);
}
show("2000 honest rounds", () => sum);
all("untouched", fresh());

const deleted = fresh();
const looseDeleted: Options = deleted;
delete looseDeleted.depth;
delete looseDeleted.title;
delete looseDeleted.tags;
delete looseDeleted.onDone;
all("deleted through the alias", deleted);

const blanked = fresh();
const looseBlanked: Options = blanked;
looseBlanked.depth = undefined;
looseBlanked.title = undefined;
looseBlanked.tags = undefined;
looseBlanked.onDone = undefined;
all("undefined stored through the alias", blanked);

const partial: Options = { depth: undefined, title: "given" };
const merged: Full = { ...fresh(), ...partial };
all("an optional object spread over a full one", merged);

const assigned: Full = Object.assign(fresh(), partial);
all("an optional object assigned over a full one", assigned);

const job = new Job();
show("in a field: before", () => job.run());
const looseField: Options = job.options;
delete looseField.depth;
show("in a field: the number deleted", () => job.run());
delete looseField.onDone;
show("in a field: the function deleted", () => job.run());

const queue: Full[] = [fresh(), fresh(), fresh()];
const looseQueue: Options[] = queue;
looseQueue[1] = {};
show("in a list: an empty object stored through the alias of the list", () => queue.map(full => full.depth));
show("in a list: added up", () => queue.reduce((total, full) => total + full.depth, 0));
show("in a list: the length of each text", () => queue.map(titleLength));
//// a-rest-pattern-collects-the-extras.ts
////= Point-2

const log: string[] = [];

function withoutX(p: Point): { y: number } {
  const { x, ...rest } = p;
  log.push("x was " + x);
  return rest;
}

function withoutBoth(p: Point): {} {
  const { x, y, ...rest } = p;
  log.push("x + y was " + (x + y));
  return rest;
}

function parameterPattern({ y, ...rest }: Point): string {
  return y + " " + JSON.stringify(rest);
}

function renamed(p: Point): string {
  const { y: second, x: first } = p;
  return first + "," + second;
}

const tag = Symbol("tag");
const extras = { w: 0, x: 1, y: 2, z: 3 };
const flipped = { y: 5, x: 4 };
const getters = {
  get y(): number {
    log.push("get y");
    return 7;
  },
  extra: "extra",
  get x(): number {
    log.push("get x");
    return 6;
  },
};
const hidden = Object.defineProperty({ x: 8, y: 9, z: 10 }, "z", { enumerable: false });
const inherited: Point = Object.assign(Object.create({ y: 12, z: 13 }), { x: 11 });
const symbols = { [tag]: 1, x: 14, y: 15 };

class Pair {
  y = 17;
  x = 16;
  other = 18;
  method(): void {}
}

const table: [string, Point][] = [
  ["honest", { x: 0, y: 0 }],
  ["extras", extras],
  ["flipped", flipped],
  ["getters", getters],
  ["a hidden extra", hidden],
  ["y inherited", inherited],
  ["a symbol", symbols],
  ["an instance", new Pair()],
];

for (const [name, p] of table) {
  const rest = withoutX(p);
  console.log(name + ", without x: " + JSON.stringify(rest) + " keys " + Object.keys(rest).join() + " y " + rest.y);
  console.log(name + ", symbols kept: " + Object.getOwnPropertySymbols(rest).length);
  console.log(name + ", without both: " + JSON.stringify(withoutBoth(p)));
  console.log(name + ", parameter pattern: " + parameterPattern(p));
  console.log(name + ", renamed: " + renamed(p));
  console.log(name + ", log: " + log.join("; "));
  log.length = 0;
}

const local: Point = extras;
const { y, ...others } = local;
console.log("local: " + y + " " + JSON.stringify(others));

const list: Point[] = [extras, flipped, new Pair()];
console.log("elements: " + JSON.stringify(list.map(({ x, ...rest }) => rest)));

for (const { x, ...rest } of list) console.log("for-of pattern: " + x + " " + JSON.stringify(rest));

let a = 0;
let remaining: { y: number } = { y: 0 };
({ x: a, ...remaining } = local);
console.log("assignment pattern: " + a + " " + JSON.stringify(remaining));
//// a-rest-pattern-takes-a-list-that-object-assign-wrote-to.ts
function tail(): string {
  const list: number[] = [1, 2, 3];
  Object.assign(list, { 1: 5 });
  const [, ...rest] = list;
  return rest.join();
}

console.log(tail());

