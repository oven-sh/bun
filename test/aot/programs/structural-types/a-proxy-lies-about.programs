  helper?(): number;
  describe(): string {
    return this.kind;
  }
}

class Derived extends Base {
  size = 2;
  twice(): number {
    return this.size * 2;
  }
  helped(): number {
    return this.helper?.() ?? -1;
  }
}

////= lines-19	twice	value	Derived	number	value.twice

////= lines-19	describe	value	Derived	string	value.describe

////= lines-19	helped	value	Derived	number	value.helped

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = new Derived();
  warm += twice(honest) + describe(honest).length + helped(honest);
}
console.log("before the proxy is put in", warm);

const old = new Derived();
const above = Object.getPrototypeOf(Base.prototype);
Object.setPrototypeOf(
  Base.prototype,
  new Proxy(above, {
    get(target, key, receiver) {
      log.push("get:" + String(key));
      if (key === "helper") return () => 77;
      return Reflect.get(target, key, receiver);
    },
    has: (target, key) => (log.push("has:" + String(key)), Reflect.has(target, key)),
    set: (target, key, value, receiver) => (log.push("set:" + String(key)), Reflect.set(target, key, value, receiver)),
  }),
);

for (const [name, make] of [["an old instance", () => old], ["a new instance", () => new Derived()]] satisfies [string, () => Derived][]) {
  logged(name + ": its own method", () => twice(make()));
  logged(name + ": an inherited method", () => describe(make()));
  logged(name + ": an optional method that only the proxy has", () => helped(make()));
  logged(name + ": fields", () => [make().size, make().kind]);
  logged(name + ": in", () => ["size" in make(), "helper" in make(), "nothing" in make()]);
  logged(name + ": toString", () => String(make()));
  logged(name + ": hasOwnProperty", () => make().hasOwnProperty("size"));
  logged(name + ": instanceof", () => [make() instanceof Derived, make() instanceof Base, make() instanceof Object]);
  logged(name + ": keys and JSON", () => [Object.keys(make()), JSON.stringify(make())]);
  logged(name + ": a store to a field", () => {
    const value = make();
    value.size = 5;
    return value.twice();
  });
}
logged("construction", () => new Derived().size);
Object.setPrototypeOf(Base.prototype, above);
logged("after the proxy is taken out", () => [twice(new Derived()), describe(old), helped(old)]);
//// a-proxy-that-forwards-every-trap-is-used-as-a-point.ts
////= show-41

const forward: ProxyHandler<Point> = {
  get: (target, key, receiver) => Reflect.get(target, key, receiver),
  set: (target, key, value, receiver) => Reflect.set(target, key, value, receiver),
  has: (target, key) => Reflect.has(target, key),
  deleteProperty: (target, key) => Reflect.deleteProperty(target, key),
  ownKeys: target => Reflect.ownKeys(target),
  getOwnPropertyDescriptor: (target, key) => Reflect.getOwnPropertyDescriptor(target, key),
  defineProperty: (target, key, descriptor) => Reflect.defineProperty(target, key, descriptor),
  getPrototypeOf: target => Reflect.getPrototypeOf(target),
  setPrototypeOf: (target, prototype) => Reflect.setPrototypeOf(target, prototype),
  isExtensible: target => Reflect.isExtensible(target),
  preventExtensions: target => Reflect.preventExtensions(target),
};

////= uses-7

let warm = 0;
////= for-21
for (const [, use] of uses) for (let i = 0; i < 200; i++) use(new Point(i, 0.5));
console.log("after the honest points", warm);

for (const [name, use] of uses) {
  attempt(name, () => use(new Proxy(new Point(3, 4), forward)));
}
////= lines-104	forward
attempt("honest again", () => [total(new Point(3, 4)), distance(new Point(3, 4)), rename(new Point(3, 4), "honest")]);
//// a-proxy-that-hands-the-target-to-its-methods-is-used-as-a-point.ts
////= show-41

const unwrap: ProxyHandler<Point> = {
  get: (target, key) => Reflect.get(target, key, target),
  set: (target, key, value) => Reflect.set(target, key, value, target),
};

////= uses-7

let warm = 0;
////= for-21
for (const [, use] of uses) for (let i = 0; i < 200; i++) use(new Point(i, 0.5));
console.log("after the honest points", warm);

for (const [name, use] of uses) {
  attempt(name, () => use(new Proxy(new Point(3, 4), unwrap)));
}
////= lines-104	unwrap
attempt("honest again", () => [total(new Point(3, 4)), distance(new Point(3, 4)), rename(new Point(3, 4), "honest")]);
//// a-proxy-typed-as-a-class.ts
////= show-30

const log: string[] = [];

////= logged

class Point {
  static made = 0;
  static origin(): Point {
    return new this(0, 0);
  }
  constructor(public x: number, public y: number) {
    Point.made++;
  }
  sum(): number {
    return this.x + this.y;
  }
}

function watched(target: typeof Point): typeof Point {
  return new Proxy(target, {
    construct: (inner, list, newTarget) => (log.push("construct:" + list.join() + ":" + (newTarget === inner ? "target" : "other")), Reflect.construct(inner, list, newTarget)),
    get: (inner, key, receiver) => (log.push("get:" + String(key)), Reflect.get(inner, key, receiver)),
    apply: () => (log.push("apply"), undefined),
  });
}

function build(Class: typeof Point, x: number, y: number): Point {
  return new Class(x, y);
}

function sumOfBuilt(Class: typeof Point): number {
  return new Class(3, 4).sum();
}

function isOne(Class: typeof Point, value: object): boolean {
  return value instanceof Class;
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += build(Point, i, 1).x + sumOfBuilt(Point) + (isOne(Point, new Point(1, 1)) ? 1 : 0);
console.log("after 2000 honest constructions", warm);

logged("constructed", () => build(watched(Point), 3, 4));
logged("constructed and used", () => sumOfBuilt(watched(Point)));
logged("what is made is an instance of the class", () => build(watched(Point), 3, 4) instanceof Point);
logged("instanceof the proxy", () => [isOne(watched(Point), new Point(1, 1)), isOne(watched(Point), {})]);
logged("a static method", () => watched(Point).origin().sum());
logged("a static field", () => typeof watched(Point).made);
logged("name, length, typeof", () => [watched(Point).name, watched(Point).length, typeof watched(Point)]);
logged("the prototype", () => watched(Point).prototype === Point.prototype);
logged("Reflect.construct", () => Reflect.construct(watched(Point), [3, 4]).sum());
logged("without traps", () => sumOfBuilt(new Proxy(Point, {})));
logged("a construct trap that makes a literal", () => {
  const Fake = new Proxy(Point, { construct: (_, list) => ({ x: list[0], y: list[1] }) });
  const made = build(Fake, 3, 4);
  return [made.x + made.y, made instanceof Point, typeof made.sum];
});
logged("a construct trap that makes a literal, used", () => sumOfBuilt(new Proxy(Point, { construct: (_, list) => ({ x: list[0], y: list[1] }) })));
logged("a construct trap that swaps the arguments", () => build(new Proxy(Point, { construct: (inner, list) => new inner(list[1], list[0]) }), 3, 4));
logged("a construct trap that answers a number", () => build(new Proxy(Point, { construct: () => Object(5).valueOf() }), 3, 4));
logged("a construct trap that throws", () => build(new Proxy(Point, { construct: () => { throw new RangeError("no"); } }), 3, 4));
logged("a subclass of the proxy", () => {
  class Child extends watched(Point) {
    z = 5;
  }
  const child = new Child(3, 4);
  return [child.sum(), child.z, child instanceof Point, Object.keys(child)];
});
logged("a revoked class", () => {
  const { proxy, revoke } = Proxy.revocable(Point, {});
  const before = sumOfBuilt(proxy);
  revoke();
  return [before, sumOfBuilt(proxy)];
});
logged("honest again", () => [build(Point, 3, 4), sumOfBuilt(Point)]);
//// a-proxy-typed-as-a-function.ts
////= show-30

const log: string[] = [];

////= logged

type Unary = (value: number) => number;

////= lines-158	double	value	number	number	2

function watched(target: Unary): Unary {
  return new Proxy(target, {
    apply: (inner, self, list) => (log.push("apply:" + typeof self + ":" + list.join()), Reflect.apply(inner, self, list)),
    get: (inner, key, receiver) => (log.push("get:" + String(key)), Reflect.get(inner, key, receiver)),
  });
}

function callIt(f: Unary, value: number): number {
  return f(value);
}

function callTwice(f: Unary, value: number): number {
  return f(f(value));
}

function callInALoop(f: Unary): number {
  let total = 0;
  for (let i = 0; i < 3; i++) total += f(i);
  return total;
}

class Tool {
  constructor(public run: Unary) {}
  use(value: number): number {
    return this.run(value);
  }
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += callIt(double, i) + callTwice(double, i) + callInALoop(double) + new Tool(double).use(i);
console.log("after 2000 honest calls", warm);

logged("called", () => callIt(watched(double), 4));
logged("called twice", () => callTwice(watched(double), 4));
logged("called in a loop", () => callInALoop(watched(double)));
logged("as a field", () => new Tool(watched(double)).use(4));
logged("call", () => watched(double).call(undefined, 4));
logged("apply", () => watched(double).apply(undefined, [4]));
logged("bind", () => watched(double).bind(undefined, 4)());
logged("Reflect.apply", () => Reflect.apply(watched(double), undefined, [4]));
logged("handed to map", () => [1, 2].map(watched(double)));
logged("handed to Array.from", () => Array.from([1, 2], watched(double)));
logged("as a reaction, later", () => "see the last line");
logged("typeof, name, length", () => [typeof watched(double), watched(double).name, watched(double).length]);
logged("instanceof Function", () => watched(double) instanceof Function);
logged("without an apply trap", () => callIt(new Proxy(double, {}), 4));
logged("an apply trap that answers a string", () => callIt(new Proxy(double, { apply: () => "four" }), 4) + 1);
logged("an apply trap that answers nothing", () => callIt(new Proxy(double, { apply: () => undefined }), 4) + 1);
logged("an apply trap that throws", () => callIt(new Proxy(double, { apply: () => { throw new RangeError("no"); } }), 4));
logged("an apply trap that changes the argument", () => callIt(new Proxy(double, { apply: (inner, self, list) => inner(list[0] + 1) }), 4));
logged("a revoked function", () => {
  const { proxy, revoke } = Proxy.revocable(double, {});
  const before = callIt(proxy, 4);
  revoke();
  return [before, typeof proxy, callIt(proxy, 4)];
});
logged("a proxy of an arrow function is constructed", () => Reflect.construct(new Proxy((value: number) => value, {}), [1]));
logged("a proxy of a bound function", () => callIt(watched(double.bind(null)), 4));
logged("a proxy of a proxy", () => callIt(watched(watched(double)), 4));
logged("a proxy of a method keeps no this", () => {
  const counter = { step: 2, add(value: number) { return value + this.step; } };
  const add: Unary = new Proxy(counter.add, {});
  return add(1);
});
logged("honest again", () => [callIt(double, 4), callTwice(double, 4)]);
console.log("as a reaction -> " + (await Promise.resolve(4).then(watched(double))));

export {};
