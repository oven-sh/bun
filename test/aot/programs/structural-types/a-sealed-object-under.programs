function storeAt(numbers: number[], index: number, value: number): number {
  numbers[index] = value;
  return numbers.length;
}

function present(numbers: number[]): string[] {
  const seen: string[] = [];
  for (const key in numbers) seen.push(key + "=" + numbers[key]);
  return seen;
}

function sumOfPresent(numbers: number[]): number {
  let total = 0;
  for (const key of Object.keys(numbers)) total += numbers[Number(key)];
  return total;
}

for (const index of [3, 4, 100, 10000, 1000000, 2 ** 31, 2 ** 32 - 2]) {
  attempt("a store at " + index + ": length and members", () => {
    const numbers = [1, 2, 3];
    return [storeAt(numbers, index, 9), present(numbers), sumOfPresent(numbers)];
  });
  attempt("a store at " + index + ": around it", () => {
    const numbers = [1.5, 2.5, 3.5];
    storeAt(numbers, index, 9.5);
    return [numbers[index], numbers[index - 1], numbers[index + 1], index - 1 in numbers, numbers[0], numbers[2]];
  });
}
for (const index of [2 ** 32 - 1, 2 ** 32, -1, 1.5]) {
  attempt("a store at " + index + " makes a member, not an element", () => {
    const numbers = [1, 2, 3];
    return [storeAt(numbers, index, 9), present(numbers), numbers[index]];
  });
}
report("sparse, then read from the start", () => {
  const numbers = [1, 2];
  numbers[1000000] = 3;
  numbers.length = 3;
  return numbers;
});
attempt("sparse: push, pop, indexOf", () => {
  const numbers: number[] = [];
  numbers[1000000] = 3;
  const length = numbers.push(4);
  return [length, numbers.indexOf(4), numbers.pop(), numbers.pop(), numbers.pop(), numbers.length];
});
attempt("sparse: sum of the first thousand", () => {
  const numbers: number[] = [];
  numbers[1000000] = 3;
  let total = 0;
  for (let i = 0; i < 1000; i++) total += numbers[i] ?? 1;
  return total;
});
attempt("filled backwards", () => {
  const numbers: number[] = [];
  for (let i = 9; i >= 0; i--) numbers[i] = i;
  return [numbers.length, sum(numbers), inspect(numbers).length];
});
attempt("every other index", () => {
  const numbers: number[] = [];
  for (let i = 0; i < 10; i += 2) numbers[i] = i + 0.5;
  return [inspect(numbers), sumOfPresent(numbers), sum(numbers)];
});
//// a-store-made-by-the-base-constructor-and-three-ways-to-declare-the-field.ts
////= text-12

////= Base-2

class WithInitializer extends Base {
  count: number = 0;
  label: string = "initial";
  init(): void {
    this.count = 5;
    this.label = "early";
  }
}

class SurelyAssigned extends Base {
  count!: number;
  label!: string;
  init(): void {
    this.count = 5;
    this.label = "early";
  }
}

class Declared extends Base {
  declare count: number;
  declare label: string;
  init(): void {
    this.count = 5;
    this.label = "early";
  }
}

class InConstructor extends Base {
  count: number;
  label: string;
  constructor() {
    super();
    this.count = this.readCount() + 1;
    this.label = this.readLabel() + "+";
  }
  readCount(): number {
    return this.count;
  }
  readLabel(): string {
    return this.label;
  }
  init(): void {
    this.count = 5;
    this.label = "early";
  }
}

////= lines-27	Counted	count	number	label	string

function all(kind: string, o: Counted): void {
  show(kind + " count", () => o.count);
  show(kind + " count + 1", () => o.count + 1);
  show(kind + " label", () => o.label);
  show(kind + " label.length", () => o.label.length);
  show(kind + " keys", () => Object.keys(o).join());
  show(kind + " JSON", () => JSON.stringify(o));
}

all("with an initializer", new WithInitializer());
all("surely assigned", new SurelyAssigned());
all("declared", new Declared());
all("in the constructor", new InConstructor());

class Parent {
  size: number = 1;
  name: string = "parent";
  sizeSeenByParent: number;
  constructor() {
    this.sizeSeenByParent = this.size;
  }
  parentSize(): number {
    return this.size;
  }
}
class Redeclares extends Parent {
  size: number = 2;
  declare name: string;
}
class Narrower extends Parent {
  declare size: 1;
}
const redeclares = new Redeclares();
show("redeclared: size", () => redeclares.size);
show("redeclared: size as the parent's constructor saw it", () => redeclares.sizeSeenByParent);
show("redeclared: size as the parent's method sees it", () => redeclares.parentSize());
show("redeclared: name", () => redeclares.name);
show("redeclared: keys", () => Object.keys(redeclares).join());
show("narrower: size", () => new Narrower().size);
show("narrower: keys", () => Object.keys(new Narrower()).join());
//// a-store-through-a-narrower-type-changes-the-right-member.ts
////= Point-2

////= setX-3

function setBoth(p: Point, value: number): void {
  p.y = value;
  p.x = value + 0.5;
}

function bump(p: Point): number {
  p.x++;
  p.y += 10;
  return p.x + p.y;
}

function swap(p: Point): void {
  [p.x, p.y] = [p.y, p.x];
}

class Holder {
  constructor(public point: Point) {}
  move(by: number): void {
    this.point.x += by;
    this.point.y -= by;
  }
}

function fresh(): [string, Point, () => string][] {
  const honest = { x: 1, y: 2 };
  const flipped = { y: 2, x: 1 };
  const front = { a: "a", b: "b", x: 1, y: 2 };
  const between = { x: 1, a: "a", y: 2, b: "b" };
  const numbers = { u: 100, y: 2, v: 200, x: 1, w: 300 };
  const fractions = { u: 0.25, x: 1, v: 0.75, y: 2 };
  return [
    ["honest", honest, () => JSON.stringify(honest)],
    ["flipped", flipped, () => JSON.stringify(flipped)],
    ["extras in front", front, () => JSON.stringify(front)],
    ["extras between", between, () => JSON.stringify(between)],
    ["number extras", numbers, () => JSON.stringify(numbers)],
    ["fraction extras", fractions, () => JSON.stringify(fractions)],
  ];
}

for (const [name, p, whole] of fresh()) {
  setX(p, 50);
  console.log(name + ", x stored: " + whole());
}

for (const [name, p, whole] of fresh()) {
  setBoth(p, 60);
  console.log(name + ", both stored: " + whole());
}

for (const [name, p, whole] of fresh()) {
  console.log(name + ", bumped: " + bump(p) + " " + whole());
}

for (const [name, p, whole] of fresh()) {
  swap(p);
  console.log(name + ", swapped: " + whole());
}

for (const [name, p, whole] of fresh()) {
  new Holder(p).move(5);
  console.log(name + ", moved through a field: " + whole());
}

for (const [name, p, whole] of fresh()) {
  const store = (value: number) => {
    p.y = value;
  };
  store(-0);
  console.log(name + ", stored by a closure: " + whole() + " " + Object.is(p.y, -0));
}

for (const [name, p, whole] of fresh()) {
  Object.assign(p, { x: 8, y: 9 });
  console.log(name + ", Object.assign: " + whole());
}

const list = fresh().map(row => row[1]);
for (let i = 0; i < list.length; i++) list[i].x = i * 11;
console.log("stored through elements: " + JSON.stringify(list));

const target = { before: "before", y: 0, x: 0, after: "after" };
for (let i = 0; i < 2000; i++) setX({ x: 0, y: 0 }, i);
setX(target, 77);
setBoth(target, 88);
console.log("after 2000 honest stores: " + JSON.stringify(target));
