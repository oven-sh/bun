class DogHome implements Home {
  current: Dog = new Dog("first");
  legsSeen: number[] = [];
  tagsSeen: string[] = [];
  get pet(): Dog {
    return this.current;
  }
  set pet(d: Dog) {
    this.legsSeen.push(d.legs);
    this.tagsSeen.push(d.tag);
    this.current = d;
  }
}

class FieldHome implements Home {
  pet: Dog = new Dog("field");
}

