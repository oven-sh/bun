//// a-standard-field-decorator-changes-the-kind-of-value-within-its-type.ts
////= describe

function emptied(target: undefined, context: ClassFieldDecoratorContext<Holder, number | string>) {
  return function (this: Holder, initial: number | string): number | string {
    return typeof initial === "number" ? "was " + initial : initial.length;
  };
}

class Holder {
  @emptied a: number | string = 1;
  @emptied b: number | string = "four";
  plain: number | string = 2;
  show(): string {
    return typeof this.a + " " + this.a + " " + typeof this.b + " " + this.b + " " + typeof this.plain;
  }
}

console.log(describe(new Holder()));
console.log(new Holder().show());
//// a-static-block-replaces-a-method-of-its-own-class.ts
class Point {
  x: number;
  y: number;
  constructor(x: number, y: number) {
    this.x = x;
    this.y = y;
  }
  norm(): number {
    return this.x * this.x + this.y * this.y;
  }
  twice(): number {
    return this.norm() * 2;
  }
  static zero(): Point {
    return new Point(0, 0);
  }
  static written = Point.prototype.norm;
  static writtenZero = Point.zero;
  static {
    this.prototype.norm = function () {
      return -this.x;
    };
    this.zero = () => new Point(7, 7);
  }
}

////= normOf

const p = new Point(3, 4);
let sum = 0;
for (let i = 0; i < 2000; i++) sum += normOf(p) + p.norm() + p.twice() + Point.zero().x;
console.log("2000 rounds: " + sum);
console.log("what runs: " + p.norm() + " " + normOf(p) + " " + p.twice() + " " + JSON.stringify(Point.zero()));
console.log("what was written: " + Point.written.call(p) + " " + JSON.stringify(Point.writtenZero()));
console.log("the same: " + (Point.prototype.norm === Point.written) + " " + (Point.zero === Point.writtenZero));
Point.prototype.norm = Point.written;
Point.zero = Point.writtenZero;
console.log("put back: " + p.norm() + " " + normOf(p) + " " + p.twice() + " " + JSON.stringify(Point.zero()));

