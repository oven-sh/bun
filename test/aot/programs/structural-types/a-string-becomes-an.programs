//// a-subclass-overrides-an-overloaded-method-and-answers-the-other-way-round.ts
////= text-19

class Reader {
  lines: string[] = ["one", "two", "three"];
  read(): string;
  read(count: number): string[];
  read(count?: number): string | string[] {
    return count === undefined ? this.lines[0] : this.lines.slice(0, count);
  }
}

class Swapped extends Reader {
  read(): string;
  read(count: number): string[];
  read(count?: number): string | string[] {
    return count === undefined ? this.lines.slice(0, 2) : this.lines[count];
  }
}

class CountsArguments extends Reader {
  read(): string;
  read(count: number): string[];
  read(...given: [] | [number]): string | string[] {
    return given.length === 0 ? "nothing given" : ["given " + text(given[0])];
  }
}

class Narrow extends Reader {
  read(): string;
  read(count: number): string[];
  read(): string | string[] {
    return "always " + arguments.length;
  }
}

function first(reader: Reader): string {
  const line: string = reader.read();
  return text(line) + " | length " + text(line.length) + " | upper " + line.toUpperCase();
}

function some(reader: Reader): string {
  const lines: string[] = reader.read(2);
  return text(lines) + " | length " + text(lines.length) + " | joined " + lines.join("+");
}

function both(reader: Reader): string {
  return reader.read() + "/" + reader.read(1).length;
}

let warm = 0;
const honest = new Reader();
for (let i = 0; i < 2000; i++) warm += first(honest).length + some(honest).length;
console.log("2000 honest reads: " + warm);

const readers: [string, () => Reader][] = [
  ["the base", () => new Reader()],
  ["swapped", () => new Swapped()],
  ["counts its arguments", () => new CountsArguments()],
  ["takes no parameter", () => new Narrow()],
];

for (const [label, make] of readers) {
  attempt(label + ", first", () => first(make()));
  attempt(label + ", some", () => some(make()));
  attempt(label + ", both", () => both(make()));
}

interface Loose {
  read(count?: number): unknown;
}
for (const [label, make] of readers) {
  const loose: Loose = make();
  attempt(label + ", undefined is given", () => loose.read(undefined));
}

const list: Reader[] = readers.map(([, make]) => make());
attempt("a list of readers", () => list.map(reader => typeof reader.read() + " " + Array.isArray(reader.read(1))));
attempt("the base again", () => first(honest));
//// a-subclass-overrides-half-of-an-accessor-pair.ts
const log: string[] = [];

////= attempt-21

class Base {
  protected stored = 1;
  get level(): number {
    log.push("Base get");
    return this.stored;
  }
  set level(value: number) {
    log.push("Base set " + value);
    this.stored = value;
  }
}

class OnlyGetter extends Base {
  get level(): number {
    log.push("OnlyGetter get");
    return -1;
  }
}

class OnlySetter extends Base {
  set level(value: number) {
    log.push("OnlySetter set " + value);
    this.stored = value * 100;
  }
}

class Both extends Base {
  get level(): number {
    log.push("Both get");
    return super.level + 1000;
  }
  set level(value: number) {
    log.push("Both set " + value);
    super.level = value + 1;
  }
}

class Untouched extends Base {}

////= read-3

function bump(b: Base): number {
  return ++b.level;
}

const makers: [string, () => Base][] = [
  ["the base", () => new Base()],
  ["a subclass that leaves it alone", () => new Untouched()],
  ["only the getter overridden", () => new OnlyGetter()],
  ["only the setter overridden", () => new OnlySetter()],
  ["both overridden", () => new Both()],
];

for (const [label, make] of makers) {
  attempt(label + ", read", () => read(make()));
  attempt(label + ", typeof", () => typeof read(make()));
  attempt(label + ", store", () => write(make(), 5));
  attempt(label + ", increment", () => bump(make()));
  attempt(label + ", plus one", () => read(make()) + 1);
  attempt(label + ", own", () => Object.hasOwn(make(), "level") + " " + Object.keys(make()).join());
}

const honest = new Base();
let sum = 0;
for (let i = 0; i < 2000; i++) sum += write(honest, i) + read(honest);
log.length = 0;
console.log("2000 honest: " + sum);
for (const [label, make] of makers) attempt("then " + label, () => write(make(), 7));

const list: Base[] = makers.map(([, make]) => make());
attempt("elements read", () => list.map(read).join());
attempt("elements stored", () => list.map(b => write(b, 1)).join());

class Holder {
  constructor(public inner: Base) {}
  raise(): number {
    this.inner.level += 10;
    return this.inner.level;
  }
}
for (const [label, make] of makers) attempt(label + ", through a field", () => new Holder(make()).raise());

