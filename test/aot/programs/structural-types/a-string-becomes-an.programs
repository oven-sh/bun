//// a-string-field-is-read-while-the-set-constructor-runs.ts
class Counting extends Set<number> {
  name = "counting";
  add(value: number): this {
    try {
      console.log("length " + this.name.length);
    } catch (error) {
      console.log("threw " + (error instanceof TypeError));
    }
    return super.add(value);
  }
}

console.log("size " + new Counting([1]).add(2).size);

export {};
//// a-string-field-is-stored-to-through-a-wider-alias.ts
////= show-30

class Label {
  id = 1;
  text = "label";
  weight = 0.5;
  size(): number {
    return this.text.length;
  }
  shout(): string {
    return this.text.toUpperCase();
  }
  suffixed(): string {
    return this.text + "!";
  }
}

function put<T>(box: { text: string | T }, value: T): void {
  box.text = value;
}

function sizeOf(box: { text: string }): number {
  return box.text.length;
}

function suffixed(box: { text: string }): string {
  return box.text + "!";
}

function inATemplate(box: { text: string }): string {
  return `<${box.text}>`;
}

function firstCode(box: { text: string }): number {
  return box.text.charCodeAt(0);
}

function firstLetter(box: { text: string }): string {
  return box.text[0];
}

function isEmpty(box: { text: string }): boolean[] {
  return [box.text === "", box.text == "", !box.text];
}

function isFive(box: { text: string }): boolean[] {
  return [box.text === "5", box.text == "5"];
}

function kind(box: { text: string }): string {
  return typeof box.text;
}

function appended(box: { text: string }): string {
  box.text += "x";
  return box.text;
}

const ways: [string, (box: { text: string }) => void][] = [
  ["5", box => put(box, 5)],
  ["0", box => put(box, 0)],
  ["0.5", box => put(box, 0.5)],
  ["undefined", box => put(box, undefined)],
  ["null", box => put(box, null)],
  ["false", box => put(box, false)],
  ["a symbol", box => put(box, Symbol("s"))],
  ["a bigint", box => put(box, 5n)],
  ["an array of strings", box => put(box, ["a", "b"])],
  ["a String object", box => put(box, new String("boxed"))],
  ["an object with toString", box => put(box, { toString: () => "made" })],
  ["an honest string", box => put(box, "honest")],
];

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const literal = { text: "t" + i };
  const label = new Label();
  warm += sizeOf(literal) + suffixed(literal).length + inATemplate(literal).length + firstCode(literal) + firstLetter(literal).length + isEmpty(literal).length + isFive(literal).length;
  warm += kind(literal).length + appended(literal).length + label.size() + label.shout().length + label.suffixed().length + sizeOf(label);
}
console.log("after 2000 honest boxes", warm);

for (const [name, store] of ways) {
  const stored = (): Label => {
    const label = new Label();
    store(label);
    return label;
  };
  attempt(name + ": typeof", () => kind(stored()));
  attempt(name + ": length", () => sizeOf(stored()));
  attempt(name + ": with a suffix", () => suffixed(stored()));
  attempt(name + ": in a template", () => inATemplate(stored()));
  attempt(name + ": first code", () => firstCode(stored()));
  attempt(name + ": first letter", () => firstLetter(stored()));
  attempt(name + ": empty", () => isEmpty(stored()));
  attempt(name + ": the text 5", () => isFive(stored()));
  attempt(name + ": +=", () => appended(stored()));
  attempt(name + ": its own size", () => stored().size());
  attempt(name + ": its own shout", () => stored().shout());
  attempt(name + ": its own suffix", () => stored().suffixed());
  attempt(name + ": the other fields", () => [stored().id, stored().weight, Object.keys(stored())]);
  attempt(name + ": in a literal", () => {
    const literal = { a: 1, text: "t", b: 2 };
    store(literal);
    return [literal.a, kind(literal), literal.b];
  });
}
//// a-string-is-stored-into-numbers-through-a-wider-alias.ts
////= show-30

type Wide = (number | string)[];

const ways: [string, (wide: Wide) => void][] = [
  ["push", wide => void wide.push("x")],
  ["an index store", wide => void (wide[1] = "x")],
  ["an index store past the end", wide => void (wide[wide.length] = "x")],
  ["splice", wide => void wide.splice(1, 1, "x")],
  ["fill", wide => void wide.fill("x", 1, 2)],
  ["unshift", wide => void wide.unshift("x")],
  ["a destructuring assignment", wide => void ([wide[0], wide[1]] = [wide[1], "x"])],
  ["a helper", wide => helper(wide)],
  ["push.apply", wide => void Array.prototype.push.apply(wide, ["x"])],
  ["Object.assign", wide => void Object.assign(wide, ["x"])],
  ["Reflect.set", wide => void Reflect.set(wide, 2, "x")],
  ["copyWithin after push", wide => void (wide.push("x"), wide.copyWithin(0, wide.length - 1))],
  ["a sort callback", wide => void wide.sort((a, b) => ((wide[0] = "x"), 0))],
  ["a forEach callback", wide => wide.forEach((_, index) => void (index === 1 && (wide[2] = "x")))],
];

function helper(list: Wide): void {
  list[list.length - 1] = "x";
}

////= sum

////= sumByForOf

function sumByReduce(numbers: number[]): number {
  return numbers.reduce((total, number) => total + number, 0);
}

function product(numbers: number[]): number {
  let total = 1;
  for (let i = 0; i < numbers.length; i++) total *= numbers[i];
  return total;
}

function asIntegers(numbers: number[]): number[] {
  const result: number[] = [];
  for (let i = 0; i < numbers.length; i++) result.push(numbers[i] | 0);
  return result;
}

function largest(numbers: number[]): number {
  return Math.max(...numbers);
}

function fixed(numbers: number[]): string {
  let text = "";
  for (const number of numbers) text += number.toFixed(1) + " ";
  return text;
}

function kinds(numbers: number[]): string {
  return numbers.map(number => typeof number).join();
}

const reads: [string, (numbers: number[]) => unknown][] = [
  ["sum", sum],
  ["sum by for-of", sumByForOf],
  ["sum by reduce", sumByReduce],
  ["product", product],
  ["as integers", asIntegers],
  ["largest", largest],
  ["toFixed", fixed],
  ["kinds", kinds],
  ["the array", numbers => numbers],
];

const starts: [string, () => number[]][] = [
  ["integers", () => [1, 2, 3]],
  ["doubles", () => [1.5, 2.5, 3.5]],
];

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = i % 2 === 0 ? [i, 2, 3] : [i + 0.5, 2.5, 3.5];
  warm += sum(honest) + sumByForOf(honest) + sumByReduce(honest) + product(honest) + asIntegers(honest)[0] + largest(honest) + fixed(honest).length + kinds(honest).length;
}
console.log("after 2000 honest arrays", warm);

for (const [start, make] of starts) {
  for (const [way, pollute] of ways) {
    for (const [read, run] of reads) {
      attempt(start + ", " + way + ": " + read, () => {
        const numbers = make();
        const wide: Wide = numbers;
        pollute(wide);
        return run(numbers);
      });
    }
  }
}
attempt("honest again", () => [sum([1, 2, 3]), product([1.5, 2]), fixed([1]), largest([1, 2])]);
