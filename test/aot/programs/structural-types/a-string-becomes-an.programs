class Label {
  id: number;
  constructor(id: number) {
    this.id = id;
  }
  heading(): string {
    return this.note + "!";
  }
  width(): number {
    return this.note.length;
  }
}

function filled(id: number, note: string): Label {
  const label = new Label(id);
  label.note = note;
  return label;
}

