//// a-thenable-under-await-calls-back-twice.ts
////= text-4

type Fulfilled<T, A> = ((value: T) => A | PromiseLike<A>) | null;
type Rejected<B> = ((reason: unknown) => B | PromiseLike<B>) | null;

class Scripted implements PromiseLike<number> {
  label: string;
  script: (resolve: (value: number) => unknown, reject: (reason: unknown) => unknown) => void;
  constructor(label: string, script: (resolve: (value: number) => unknown, reject: (reason: unknown) => unknown) => void) {
    this.label = label;
    this.script = script;
  }
  then<A = number, B = never>(onfulfilled?: Fulfilled<number, A>, onrejected?: Rejected<B>): PromiseLike<A | B> {
    console.log(this.label + ": then gets " + typeof onfulfilled + " and " + typeof onrejected + ", " + arguments.length + " arguments");
    this.script(
      value => (onfulfilled ? onfulfilled(value) : "no function"),
      reason => (onrejected ? onrejected(reason) : "no function"),
    );
    return new Promise<A | B>(() => {});
  }
}

let continued = 0;

async function wait(thenable: PromiseLike<number>, label: string): Promise<string> {
  try {
    const n: number = await thenable;
    continued++;
    return label + " continued with " + text(n) + ", twice it is " + text(n * 2);
  } catch (error) {
    continued++;
    return label + " caught " + text(error);
  }
}

const scripts: [string, (resolve: (value: number) => unknown, reject: (reason: unknown) => unknown) => void][] = [
  ["once", resolve => {
    console.log("  the callback returns " + text(resolve(1)));
  }],
  ["twice", resolve => {
    resolve(1);
    console.log("  the second call returns " + text(resolve(2)));
  }],
  ["three times", resolve => {
    resolve(1);
    resolve(2);
    resolve(3);
  }],
  ["resolves and then rejects", (resolve, reject) => {
    resolve(1);
    reject("too late");
  }],
  ["rejects and then resolves", (resolve, reject) => {
    reject("first");
    resolve(2);
  }],
  ["rejects twice", (_, reject) => {
    reject("first");
    reject("second");
  }],
  ["once now and once in a later job", resolve => {
    resolve(1);
    queueMicrotask(() => {
      console.log("  the later call returns " + text(resolve(2)));
    });
  }],
  ["only in a later job, twice", resolve => {
    queueMicrotask(() => {
      resolve(10);
      resolve(20);
    });
  }],
];

for (const [label, script] of scripts) {
  continued = 0;
  console.log(await wait(new Scripted(label, script), label));
  await null;
  await null;
  console.log(label + ": the function went on " + continued + " time(s)");
}

console.log(await wait(Promise.resolve(5), "a real promise at the same place"));

export {};
//// a-third-number-is-promised-to-a-class-of-two-numbers.ts
////= text-11

////= lines-28	Vector	z	number
class Vector {
  x: number;
  y: number;
  constructor(x: number, y: number) {
    this.x = x;
    this.y = y;
  }
  squared(): number {
    return this.x * this.x + this.y * this.y + this.z * this.z;
  }
  plus(other: Vector): Vector {
    const sum = new Vector(this.x + other.x, this.y + other.y);
    sum.z = this.z + other.z;
    return sum;
  }
}

function deep(x: number, y: number, z: number): Vector {
  const vector = new Vector(x, y);
  vector.z = z;
  return vector;
}

function parts(vector: Vector): unknown[] {
  return [vector.x, vector.y, vector.z];
}

const flat = new Vector(1.5, 2.5);
show("parts", () => parts(flat));
show("squared", () => flat.squared());
show("keys", () => Object.keys(flat));
show("JSON", () => JSON.stringify(flat));
show("flat plus flat", () => parts(flat.plus(flat)));
show("keys of the sum", () => Object.keys(flat.plus(flat)));
show("flat plus deep", () => parts(flat.plus(deep(1, 1, 1))));
show("deep plus deep", () => parts(deep(1, 2, 3).plus(deep(0.5, 0.5, 0.5))));

let sum = 0;
for (let i = 0; i < 2000; i++) sum += deep(i, 1, 0.5).squared();
show("2000 deep ones", () => sum);
show("a flat one", () => new Vector(3, 4).squared());
show("a deep one", () => deep(3, 4, 0).squared());

const many: Vector[] = [];
for (let i = 0; i < 6; i++) many.push(i % 3 === 2 ? new Vector(i, i) : deep(i, i, i));
show("z of six", () => many.map(v => v.z));
show("x of six", () => many.map(v => v.x));
show("z added up", () => many.reduce((total, v) => total + v.z, 0));
show("z added up where it is a number", () => many.reduce((total, v) => total + (typeof v.z === "number" ? v.z : 100), 0));
show("in a typed array", () => Array.from(new Float64Array(many.map(v => v.z))));
show("in a typed array of whole numbers", () => Array.from(new Int32Array(many.map(v => v.z))));
//// a-this-type-promises-an-object-that-the-helper-does-not-pass.ts
////= show-6

interface Description<D, M> {
  data: D;
  methods: M & ThisType<D & M>;
}

function joined<D extends object, M extends object>(description: Description<D, M>): D & M {
  return Object.assign({}, description.data, description.methods);
}
function onlyMethods<D extends object, M extends object>(description: Description<D, M>): M {
  return description.methods;
}
function dataBelow<D extends object, M extends object>(description: Description<D, M>): M {
  return Object.assign(Object.create(description.data), description.methods);
}

////= lines-66	honest	joined
show("joined: read", () => honest.read());
show("joined: bump", () => honest.bump());
show("joined: title", () => honest.title());
show("joined: twice", () => honest.twice());
show("joined: keys", () => Object.keys(honest).join());

////= lines-66	bare	onlyMethods
show("only the methods: read", () => bare.read());
show("only the methods: bump", () => bare.bump());
show("only the methods: title", () => bare.title());
show("only the methods: twice", () => bare.twice());
show("only the methods: keys", () => Object.keys(bare).join());

const source = { count: 1, label: "below" };
const below = dataBelow({
  data: source,
  methods: {
    read(): number {
      return this.count;
    },
    bump(): number {
      return ++this.count;
    },
    title(): string {
      return this.label.toUpperCase();
    },
  },
});
show("data on the prototype: read", () => below.read());
show("data on the prototype: bump", () => below.bump());
show("data on the prototype: title", () => below.title());
show("data on the prototype: keys", () => Object.keys(below).join());
show("data on the prototype: the source", () => source.count);
//// a-trap-changes-the-target-in-the-middle-of-typed-code.ts
////= show-38

const log: string[] = [];

////= logged

////= lines-68	total	v	Vec	number	v.x	v.y

function nameThenTotal(v: Vec): string {
  return v.name + ":" + (v.x + v.y);
}

function normTwice(v: Vec): number[] {
  return [v.norm(), v.norm()];
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += total(new Vec(i, 1)) + nameThenTotal(new Vec(i, 1)).length + normTwice(new Vec(3, 4))[1];
console.log("after 2000 honest vectors", warm);

function onRead(of: string, change: (target: Vec) => void): [Vec, Vec] {
  const target = new Vec(3, 4);
  let done = false;
  const proxy = new Proxy(target, {
    get(inner, key, receiver) {
      if (key === of && !done) {
        done = true;
        log.push("changed at " + of);
        change(inner);
      }
      return Reflect.get(inner, key, receiver);
    },
  });
  return [proxy, target];
}

const changes: [string, (target: Vec) => void][] = [
  ["y is deleted", target => void Reflect.deleteProperty(target, "y")],
  ["y becomes a string", target => void Reflect.set(target, "y", "four")],
  ["y becomes a getter", target => void Object.defineProperty(target, "y", { get: () => (log.push("getter"), 40), configurable: true })],
  ["a member is added", target => void Reflect.set(target, "extra", 1)],
  ["many members are added", target => {
    for (let i = 0; i < 100; i++) Reflect.set(target, "extra" + i, i);
  }],
  ["the prototype is removed", target => void Object.setPrototypeOf(target, null)],
  ["norm is covered by an own member", target => void Object.defineProperty(target, "norm", { value: () => -1, configurable: true })],
  ["the target is frozen", target => void Object.freeze(target)],
  ["x and y are swapped by deleting and adding", target => {
    const { x, y } = target;
    Reflect.deleteProperty(target, "x");
    Reflect.deleteProperty(target, "y");
    target.y = x;
    target.x = y;
  }],
];
for (const [name, change] of changes) {
  logged(name + " at the read of x: x + y", () => total(onRead("x", change)[0]));
  logged(name + " at the read of the name: name and total", () => nameThenTotal(onRead("name", change)[0]));
  logged(name + " at the read of norm: norm twice", () => normTwice(onRead("norm", change)[0]));
  logged(name + ": the target afterwards, used directly", () => {
    const [proxy, target] = onRead("x", change);
    total(proxy);
    return [total(target), Object.keys(target).slice(0, 5), typeof target.norm];
  });
}
