type Shape = { kind: "circle"; radius: number } | { kind: "square"; side: number };

function area(s: Shape): number {
  return s.kind === "circle" ? s.radius * 3 : s.side * s.side;
}

function circle(radius: number): Shape {
  return { kind: "circle", radius };
}

function square(side: number): Shape {
  return { kind: "square", side };
}

function retag(t: { kind: "circle" | "square" }): void {
  t.kind = t.kind === "circle" ? "square" : "circle";
}

attempt("one object, one site", () => {
  const s = circle(1);
  let sum = 0;
  for (let i = 0; i < 2004; i++) {
    if (i === 2000) retag(s);
    if (i === 2002) retag(s);
    sum += area(s);
  }
  return sum;
});
attempt("many objects, one site, the last is retagged", () => {
  const shapes: Shape[] = [];
  for (let i = 0; i < 2001; i++) shapes.push(i & 1 ? circle(1) : square(1));
  retag(shapes[2000]);
  let sum = 0;
  let bad = 0;
  for (const s of shapes) {
    const a = area(s);
    if (a !== a) bad++;
    else sum += a;
  }
  return [sum, bad];
});
attempt("a field, read in a method", () => {
  class Holder {
    shape: Shape = circle(2);
    area(): number {
      return this.shape.kind === "circle" ? this.shape.radius * 3 : this.shape.side * this.shape.side;
    }
  }
  const h = new Holder();
  let sum = 0;
  for (let i = 0; i < 2000; i++) sum += h.area();
  retag(h.shape);
  return [sum, h.area()];
});
attempt("a captured shape", () => {
  const s = square(2);
  const read = () => area(s);
  let sum = 0;
  for (let i = 0; i < 2000; i++) sum += read();
  retag(s);
  return [sum, read()];
});
attempt("a result", () => {
  let spoiled = false;
  const make = (): Shape => {
    const s = circle(1);
    if (spoiled) retag(s);
    return s;
  };
  let sum = 0;
  for (let i = 0; i < 2000; i++) sum += area(make());
  spoiled = true;
  return [sum, area(make())];
});
attempt("stored to after the tag lies", () => {
  const grow = (s: Shape): void => {
    if (s.kind === "circle") s.radius += 1;
    else s.side += 1;
  };
  const s = circle(1);
  for (let i = 0; i < 2000; i++) grow(s);
  retag(s);
  grow(s);
  return [JSON.stringify(s), Object.keys(s)];
});
attempt("called after the tag lies", () => {
  type Action = { kind: "run"; run: () => number } | { kind: "wait"; ticks: number };
  const act = (a: Action): number => (a.kind === "run" ? a.run() : a.ticks);
  const waiting: Action = [{ kind: "wait", ticks: 5 } satisfies Action][0];
  let sum = 0;
  for (let i = 0; i < 2000; i++) sum += act(waiting);
  const open: { kind: "run" | "wait" } = waiting;
  open.kind = "run";
  return [sum, act(waiting)];
});
attempt("iterated after the tag lies", () => {
  type Bag = { kind: "many"; items: number[] } | { kind: "one"; item: number };
  const total = (b: Bag): number => {
    if (b.kind === "one") return b.item;
    let sum = 0;
    for (const n of b.items) sum += n;
    return sum;
  };
  const one: Bag = [{ kind: "one", item: 5 } satisfies Bag][0];
  let sum = 0;
  for (let i = 0; i < 2000; i++) sum += total(one);
  const open: { kind: "many" | "one" } = one;
  open.kind = "many";
  return [sum, total(one)];
});
//// a-tag-stored-alone-leaves-the-fields-of-the-old-variant.ts
////= show-35

type Shape = { kind: "circle"; radius: number } | { kind: "square"; side: number; label: string } | { kind: "dot" };

function area(shape: Shape): number {
  switch (shape.kind) {
    case "circle":
      return shape.radius * shape.radius * 3;
    case "square":
      return shape.side * shape.side;
    case "dot":
      return 0;
  }
}
function labelOf(shape: Shape): string {
  return shape.kind === "square" ? shape.label : shape.kind;
}
function labelLength(shape: Shape): number {
  return shape.kind === "square" ? shape.label.length : -1;
}
function retag(shape: Shape, kind: Shape["kind"]): void {
  shape.kind = kind;
}
function look(shape: Shape): unknown[] {
  return [shape.kind, Object.keys(shape), JSON.stringify(shape), area(shape), labelOf(shape)];
}

const makers: [string, () => Shape][] = [
  ["circle", () => ({ kind: "circle", radius: 2 })],
  ["square", () => ({ kind: "square", side: 3, label: "three" })],
  ["dot", () => ({ kind: "dot" })],
];
const kinds: Shape["kind"][] = ["circle", "square", "dot"];

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const shape = makers[i % 3][1]();
  warm += area(shape) + labelOf(shape).length + labelLength(shape);
}
console.log("2000 honest rounds", warm);

for (const [from, make] of makers) {
  for (const to of kinds) {
    attempt(from + " tagged " + to, () => {
      const shape = make();
      retag(shape, to);
      return look(shape);
    });
    attempt(from + " tagged " + to + ", the label is used", () => {
      const shape = make();
      retag(shape, to);
      return labelLength(shape);
    });
  }
}
attempt("tagged in the middle of a list", () => {
  const shapes: Shape[] = [makers[0][1](), makers[1][1](), makers[2][1]()];
  retag(shapes[0], "square");
  retag(shapes[1], "circle");
  retag(shapes[2], "circle");
  return [shapes.map(area), shapes.map(labelOf)];
});
attempt("tagged after it was narrowed", () => {
  const shape = makers[0][1]();
  if (shape.kind !== "circle") return "no circle";
  const alias: Shape = shape;
  retag(alias, "square");
  return [shape.kind, shape.radius, area(shape), area(alias)];
});
attempt("tagged and tagged back", () => {
  const shape = makers[1][1]();
  retag(shape, "dot");
  const between = look(shape);
  retag(shape, "square");
  return [between, look(shape)];
});
attempt("honest again", () => makers.map(([, make]) => look(make())));
//// a-tag-stored-alone-puts-a-number-where-the-new-variant-has-a-string.ts
////= show-35

////= lines-27	Count	kind	"count"	value	number
////= lines-27	Name	kind	"name"	value	string
interface Group {
  kind: "group";
  value: Count[];
}
type Entry = Count | Name | Group;

function size(entry: Entry): number {
  if (entry.kind === "count") return entry.value + 1;
  if (entry.kind === "name") return entry.value.length;
  return entry.value.length * 100;
}
function text(entry: Entry): string {
  switch (entry.kind) {
    case "count":
      return entry.value.toFixed(1);
    case "name":
      return entry.value.toUpperCase();
    case "group":
      return entry.value.map(count => count.value).join("+");
  }
}
function retag(entry: Entry, kind: Entry["kind"]): Entry {
  entry.kind = kind;
  return entry;
}

const makers: [string, () => Entry][] = [
  ["count", () => ({ kind: "count", value: 41 })],
  ["fraction", () => ({ kind: "count", value: 0.5 })],
  ["name", () => ({ kind: "name", value: "abc" })],
  ["group", () => ({ kind: "group", value: [{ kind: "count", value: 1 }, { kind: "count", value: 2 }] })],
];
const kinds: Entry["kind"][] = ["count", "name", "group"];

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const entry = makers[i % 4][1]();
  warm += size(entry) + text(entry).length;
}
console.log("2000 honest rounds", warm);

for (const [from, make] of makers) {
  for (const to of kinds) {
    attempt(from + " tagged " + to + ": size", () => size(retag(make(), to)));
    attempt(from + " tagged " + to + ": text", () => text(retag(make(), to)));
    attempt(from + " tagged " + to + ": json", () => JSON.stringify(retag(make(), to)));
  }
}
