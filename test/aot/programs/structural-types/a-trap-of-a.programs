//// a-vector-of-three-numbers-is-seen-before-each-is-set.ts
////= text-12

const seen: string[] = [];

function look(when: string, v: Vector): void {
  seen.push(
    when +
      ": " +
      [v.x, v.y, v.z].map(n => typeof n + " " + n).join(", ") +
      " | sum " +
      (v.x + v.y + v.z) +
      " | length " +
      v.length() +
      " | whole " +
      ((v.x | 0) + (v.y | 0) + (v.z | 0)) +
      " | keys " +
      Object.keys(v).join("+"),
  );
}

class Vector {
  x: number;
  y: number;
  z: number;
  constructor(x: number, y: number, z: number) {
    look("nothing set", this);
    this.x = x;
    look("x set", this);
    this.y = y;
    look("y set", this);
    this.z = z;
    look("all set", this);
  }
  length(): number {
    return Math.sqrt(this.x * this.x + this.y * this.y + this.z * this.z);
  }
}

new Vector(1.5, 2.5, 3.5);
new Vector(3, 4, 0);
new Vector(-0, NaN, 1e300);
for (const entry of seen) console.log(entry);
seen.length = 0;

class Whole {
  a: number;
  b: number;
  constructor(visit: (w: Whole) => void) {
    visit(this);
    this.a = 1;
    visit(this);
    this.b = 2;
    visit(this);
  }
}

