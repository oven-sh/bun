//// a-typed-event-map-is-emitted-under-a-union-of-names.ts
////= Person-5

interface Events {
  dog: Dog;
  cat: Cat;
  count: number;
  word: string;
}

type Handlers = { [K in keyof Events]: ((event: Events[K]) => void)[] };

class Bus {
  handlers: Handlers = { dog: [], cat: [], count: [], word: [] };
  on<K extends keyof Events>(name: K, handler: (event: Events[K]) => void): void {
    this.handlers[name].push(handler);
  }
  emit<K extends keyof Events>(name: K, event: Events[K]): number {
    const list = this.handlers[name];
    for (const handler of list) handler(event);
    return list.length;
  }
}

const log: string[] = [];
let legs = 0;
let counted = 0;
let letters = 0;
const bus = new Bus();
bus.on("dog", d => {
  legs += d.legs;
  log.push("dog handler: legs " + typeof d.legs + " " + d.legs + ", tag " + typeof d.tag);
});
bus.on("dog", d => {
  log.push("dog handler: " + d.bark());
});
bus.on("cat", c => {
  log.push("cat handler: lives " + typeof c.lives + " " + c.lives + ", weight " + (c.weight + 1));
});
bus.on("count", n => {
  counted += n;
  log.push("count handler: " + typeof n + " " + (n + 1));
});
bus.on("word", w => {
  letters += w.length;
  log.push("word handler: " + typeof w + " " + w.length);
});

function pick<T>(first: T, second: T, useFirst: boolean): T {
  return useFirst ? first : second;
}

show("honest dog", () => bus.emit("dog", new Dog("rex")));
show("honest cat", () => bus.emit("cat", new Cat("tom")));
show("honest count", () => bus.emit("count", 2));
show("honest word", () => bus.emit("word", "four"));

const petName: "dog" | "cat" = pick<"dog" | "cat">("dog", "cat", true);
show("a cat under 'dog'", () => bus.emit(petName, new Cat("sly")));
const otherPet: "dog" | "cat" = pick<"dog" | "cat">("dog", "cat", false);
show("a dog under 'cat'", () => bus.emit(otherPet, new Dog("lost")));
const scalar: "count" | "word" = pick<"count" | "word">("count", "word", true);
show("a string under 'count'", () => bus.emit(scalar, "text"));
const otherScalar: "count" | "word" = pick<"count" | "word">("count", "word", false);
show("a number under 'word'", () => bus.emit(otherScalar, 7));
const anyName: keyof Events = pick<keyof Events>("dog", "count", true);
show("a number under 'dog'", () => bus.emit(anyName, 7));

for (const entry of log) console.log(entry);
show("legs", () => legs);
show("counted", () => counted);
show("letters", () => letters);
//// a-typed-parameter-holds-another-kind-of-value-across-an-await-and-a-yield.ts
////= text-7

////= failure

class Sink {
  last: number = 0;
  all: number[] = [];
  reals: number[] = [0.5];
}

async function scaled(n: number, sink: Sink): Promise<string> {
  const before = typeof n;
  await null;
  const twice: number = n * 2;
  const next: number = n + 1;
  sink.last = n;
  sink.all.push(n);
  sink.reals.push(n);
  await null;
  return before + " -> " + text(n) + ", twice " + text(twice) + ", next " + text(next) + ", whole " + text(n | 0) + ", kept " + text(sink.last) + " " + text(sink.all[sink.all.length - 1]) + " " + text(sink.reals[sink.reals.length - 1]);
}

function* stepped(n: number, sink: Sink): Generator<string, string, void> {
  yield typeof n;
  const twice: number = n * 2;
  sink.last = n;
  sink.all.push(n);
  yield text(twice);
  return text(n) + ", next " + text(n + 1) + ", kept " + text(sink.last) + " " + text(sink.all[sink.all.length - 1]);
}

async function* streamed(n: number): AsyncGenerator<string, void, void> {
  yield typeof n;
  await null;
  yield text(n) + ", twice " + text(n * 2);
}

async function shouted(word: string): Promise<string> {
  await null;
  const length: number = word.length;
  await null;
  return text(word) + ", length " + text(length) + ", added " + text(word + "!");
}

async function chosen(on: boolean): Promise<string> {
  await null;
  return text(on) + ", " + (on ? "yes" : "no") + ", not " + text(!on);
}

const values: [string, unknown][] = [
  ["a whole number", 3],
  ["a fraction", 0.5],
  ["minus zero", -0],
  ["past 2 ** 31", 4294967296],
  ["a numeric text", "7"],
  ["a text", "text"],
  ["undefined", undefined],
  ["null", null],
  ["true", true],
  ["a bigint", 5n],
  ["a list", [4]],
  ["an object with valueOf", { valueOf: () => 9 }],
];

const sink = new Sink();
let warm = 0;
for (let i = 0; i < 2000; i++) warm += (await scaled(i & 7, sink)).length;
console.log("2000 honest calls: " + warm);
sink.all.length = 0;
sink.reals.length = 1;

for (const [label, value] of values) {
  const promise: Promise<string> = Reflect.apply(scaled, undefined, [value, sink]);
  console.log("async, " + label + ": " + (await promise.catch(failure)));

  try {
    const walker: Generator<string, string, void> = Reflect.apply(stepped, undefined, [value, sink]);
    console.log("generator, " + label + ": " + [walker.next().value, walker.next().value, walker.next().value].join(" | "));
  } catch (error) {
    console.log("generator, " + label + ": " + failure(error));
  }

  try {
    const stream: AsyncGenerator<string, void, void> = Reflect.apply(streamed, undefined, [value]);
    const out: string[] = [];
    for await (const line of stream) out.push(line);
    console.log("async generator, " + label + ": " + out.join(" | "));
  } catch (error) {
    console.log("async generator, " + label + ": " + failure(error));
  }

  const word: Promise<string> = Reflect.apply(shouted, undefined, [value]);
  console.log("a string parameter, " + label + ": " + (await word.catch(failure)));
  const flag: Promise<string> = Reflect.apply(chosen, undefined, [value]);
  console.log("a boolean parameter, " + label + ": " + (await flag.catch(failure)));
}

console.log("the list of numbers: " + sink.all.map(text).join(" | "));
console.log("the list of reals: " + sink.reals.map(text).join(" | "));

const loose: (...given: never[]) => Promise<string> = scaled;
console.log("nothing at all: " + (await loose().catch(failure)));
console.log("honest again: " + (await scaled(2, new Sink())));

