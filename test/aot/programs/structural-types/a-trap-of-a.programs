//// a-trap-throws-in-the-middle-of-typed-code.ts
////= show-38

const log: string[] = [];

////= logged

class Stop extends Error {}

function throwingAt(of: string, kind: "get" | "set"): Vec {
  return new Proxy(new Vec(3, 4), {
    get(target, key, receiver) {
      log.push("get:" + String(key));
      if (kind === "get" && key === of) throw new Stop(of);
      return Reflect.get(target, key, receiver);
    },
    set(target, key, value, receiver) {
      log.push("set:" + String(key));
      if (kind === "set" && key === of) throw new Stop(of);
      return Reflect.set(target, key, value, receiver);
    },
  });
}

const effects: string[] = [];
////= lines-220	effect	name	string	number	effects	1

const uses: [string, (v: Vec) => unknown][] = [
  ["x + y", v => v.x + v.y],
  ["effect + x + effect + y + effect", v => effect("a") + v.x + effect("b") + v.y + effect("c")],
  ["arguments", v => Math.max(effect("a"), v.x, effect("b"), v.y, effect("c"))],
  ["an object literal", v => ({ a: effect("a"), x: v.x, b: effect("b"), y: v.y })],
  ["x = effect", v => (v.x = effect("a"))],
  ["x = y = effect", v => (v.x = v.y = effect("a"))],
  ["x += effect", v => (v.x += effect("a"))],
  ["a swap", v => ([v.x, v.y] = [v.y, v.x])],
  ["norm()", v => v.norm()],
  ["the setter", v => (v.sum = effect("a"))],
  ["try and finally", v => {
    try {
      return v.x + v.y;
    } finally {
      effect("finally");
    }
  }],
  ["caught and read again", v => {
    try {
      return v.y;
    } catch {
      return v.x;
    }
  }],
  ["JSON", v => JSON.stringify(v)],
  ["spread", v => ({ ...v })],
];
for (const [, use] of uses) for (let i = 0; i < 300; i++) use(new Vec(3, 4));
console.log("after 300 honest vectors at every use");

for (const [of, kind] of [["x", "get"], ["y", "get"], ["x", "set"], ["y", "set"]] satisfies [string, "get" | "set"][]) {
  for (const [name, use] of uses) {
    effects.length = 0;
    logged(kind + " of " + of + " throws: " + name, () => use(throwingAt(of, kind)));
    console.log("  effects: " + effects.join(" "));
  }
}
//// a-tuple-is-filled-and-copied-within.ts
////= show-32

type Entry = [number, string, number];

function use(entry: Entry): string {
  return entry[0] + entry[2] + " " + entry[1].toUpperCase();
}

function report(title: string, entry: Entry): void {
  console.log(title + ": " + show(entry) + " " + typeof entry[0] + " " + typeof entry[1] + " " + typeof entry[2]);
  attempt("  used", () => use(entry));
  attempt("  [0] + [2]", () => entry[0] + entry[2]);
  attempt("  [0] * [2]", () => entry[0] * entry[2]);
  attempt("  [1].length", () => entry[1].length);
}

function fresh(): Entry {
  return [1, "a", 2.5];
}

let total = 0;
for (let i = 0; i < 2000; i++) total += use([i, "n", 0.5]).length;
console.log("2000 honest rounds: " + total);

report("filled with a string", fresh().fill("x"));
report("filled with a number", fresh().fill(7));
report("filled with a string from 2 on", fresh().fill("x", 2));
report("filled with a number at 1 only", fresh().fill(7, 1, 2));
report("filled from -1 on", fresh().fill("end", -1));
report("filled nowhere", fresh().fill("x", 3));
report("the second is copied to the front", fresh().copyWithin(0, 1, 2));
report("the first is copied to the middle", fresh().copyWithin(1, 0, 1));
report("everything moves one to the left", fresh().copyWithin(0, 1));
report("everything moves one to the right", fresh().copyWithin(1, 0));

const kept = fresh();
const same = kept.fill("kept");
console.log("fill returns the same list: " + Object.is(kept, same));
report("seen through the first name", kept);

