//// a-well-known-symbol-that-is-only-declared-names-a-member.ts
////= text-11

declare global {
  interface SymbolConstructor {
    readonly special: unique symbol;
    readonly other: unique symbol;
  }
}

class Marked {
  [Symbol.special]: number = 1;
  plain: number = 2;
  [Symbol.other](): string {
    return "the method ran";
  }
  read(): number {
    return this[Symbol.special];
  }
}

interface HasSpecial {
  [Symbol.special]: number;
}

function specialOf(value: HasSpecial): number {
  return value[Symbol.special];
}

show("the symbol", () => [Symbol.special, typeof Symbol.special]);
show("are the two the same", () => Object.is(Symbol.special, Symbol.other));
show("its description", () => Symbol.special.description);

const marked = new Marked();
show("read", () => [marked[Symbol.special], marked.read(), specialOf(marked)]);
show("keys", () => Object.keys(marked));
show("own symbols", () => Object.getOwnPropertySymbols(marked).length);
show("JSON", () => JSON.stringify(marked));
show("names of the prototype", () => Object.getOwnPropertyNames(Marked.prototype));
show("the method has the same name, and the field hides it", () => typeof marked[Symbol.other]);
show("the method called", () => marked[Symbol.other]());
show("the method on the prototype", () => Marked.prototype[Symbol.other]());

const literal = { [Symbol.special]: 5, plain: 6 };
show("a literal", () => [specialOf(literal), Object.keys(literal), JSON.stringify(literal)]);
show("both through one function", () => [specialOf(marked), specialOf(literal)]);

marked[Symbol.special] = 9;
show("after a store", () => [marked.read(), Object.keys(marked), JSON.stringify(marked)]);
show("by the word", () => {
  const byName: Record<string, unknown> = { ...marked };
  return byName["undefined"];
});
show("a real symbol beside it", () => {
  const both = { [Symbol.iterator]: 1, [Symbol.special]: 2 };
  return [Object.keys(both), Object.getOwnPropertySymbols(both).length];
});

export {};
//// a-wider-object-is-read-through-a-narrower-type.ts
////= Point-2

function show(label: string, value: number): void {
  console.log(label + ": " + (Object.is(value, -0) ? "-0" : String(value)));
}

////= lines-159	read	p	Point	p.x	100	p.y

function readInALoop(p: Point): number {
  let total = 0;
  for (let i = 0; i < 3; i++) {
    try {
      total += p.x * 100 + p.y;
    } catch {
      total = -1;
    }
  }
  return total;
}

class Holder {
  point: Point;
  constructor(point: Point) {
    this.point = point;
  }
  read(): number {
    return this.point.x * 100 + this.point.y;
  }
}

const honest = { x: 1, y: 2 };
const front = { a: "a", b: "b", x: 3, y: 4 };
const between = { x: 5, a: "a", y: 6 };
const behind = { x: 7, y: 8, a: "a", b: "b" };
const around = { a: 0.5, x: 9, b: { x: -1, y: -1 }, y: 10, c: [11], d: null, e: true, f: "f", g: 12 };

function choose(which: number): Point {
  if (which === 0) return honest;
  if (which === 1) return front;
  if (which === 2) return between;
  if (which === 3) return behind;
  return around;
}

const local: Point = around;
show("local", local.x * 100 + local.y);
show("parameter", read(around));
show("parameter in a loop", readInALoop(around));
const result = choose(4);
show("result", result.x * 100 + result.y);
show("field", new Holder(around).read());
const pair: Point[] = [honest, around];
show("element", pair[1].x * 100 + pair[1].y);
const captured = () => local.x * 100 + local.y;
show("captured", captured());

const table: [string, Point][] = [
  ["honest", honest],
  ["extras in front", front],
  ["an extra between", between],
  ["extras behind", behind],
  ["extras all around", around],
];

for (const [name, p] of table) {
  show(name + ", local", p.x * 100 + p.y);
  show(name + ", parameter", read(p));
  show(name + ", parameter in a loop", readInALoop(p));
  show(name + ", field", new Holder(p).read());
  const closure = () => p.y * 100 + p.x;
  show(name + ", captured", closure());
}

for (let which = 0; which < 5; which++) {
  const chosen = choose(which);
  show("result " + which, chosen.x * 100 + chosen.y);
}

const holder = new Holder(honest);
for (const [name, p] of table) {
  holder.point = p;
  show(name + ", stored into one field", holder.read());
}

let total = 0;
for (const p of table.map(row => row[1])) total += p.x;
show("sum of x over the elements", total);
//// a-word-read-past-the-end-of-a-list-is-none-of-the-words.ts
type Word = "yes" | "no";
const words: Word[] = ["yes", "no"];

////= text-10	word	Word	"yes"	"yes"	"no"	"no"
////= other-3	word	Word	"yes"	"yes"	"no: "	"no"
function kind(word: Word): string {
  if (word === "yes" || word === "no") return "known";
  return typeof word === "string" ? "a string" : "no string";
}

console.log(text(words[0]), text(words[1]));
console.log(other(words[2]));
console.log(kind(words[2]));
console.log(text(words[2]));
//// a-write-between-two-calls-in-one-function-covers-the-method-with-an-own-member.ts
////= Target

function spare(): Target {
  return { norm: () => 0 };
}

const replacement = (): number => -1;
const key: "norm" = ["no", "rm"].join("") === "norm" ? "norm" : "norm";

////= drive-4

////= ByStore

////= lines-303	byStore	ByStore	p	target.norm = replacement

////= lines-50	ByStore	"a plain store"	byStore

////= ByAssign

////= lines-303	byAssign	ByAssign	p	Object.assign(target, { norm: replacement })

////= lines-50	ByAssign	"Object.assign"	byAssign

////= ByDefine

////= lines-303	byDefine	ByDefine	p	Object.defineProperty(target, "norm", { value: replacement, writable: true, configurable: true })

////= lines-50	ByDefine	"Object.defineProperty"	byDefine

////= ByDefineSeveral

////= lines-303	byDefineSeveral	ByDefineSeveral	p	Object.defineProperties(target, { norm: { value: replacement, writable: true, configurable: true } })

////= lines-50	ByDefineSeveral	"Object.defineProperties"	byDefineSeveral

////= ByReflectSet

////= lines-303	byReflectSet	ByReflectSet	p	Reflect.set(target, "norm", replacement)

////= lines-50	ByReflectSet	"Reflect.set"	byReflectSet

////= ByReflectDefine

////= lines-303	byReflectDefine	ByReflectDefine	p	Reflect.defineProperty(target, "norm", { value: replacement, writable: true, configurable: true })

////= lines-50	ByReflectDefine	"Reflect.defineProperty"	byReflectDefine

////= ByGetter

////= lines-303	byGetter	ByGetter	p	Object.defineProperty(target, "norm", { get: () => replacement, configurable: true })

////= lines-50	ByGetter	"a getter"	byGetter

////= ByComputedName

////= lines-303	byComputedName	ByComputedName	p	target[key] = replacement

////= lines-50	ByComputedName	"a computed name"	byComputedName

////= ByProxy

function byProxy(p: ByProxy, really: boolean): string {
  const before = p.norm();
  const target: Target = really ? p : spare();
  new Proxy(target, {}).norm = replacement;
  return before + " " + p.norm();
}

////= lines-50	ByProxy	"a store through a proxy"	byProxy

////= ByPattern

////= lines-303	byPattern	ByPattern	p	({ norm: target.norm } = { norm: replacement })

////= lines-50	ByPattern	"an object pattern"	byPattern

export {};
