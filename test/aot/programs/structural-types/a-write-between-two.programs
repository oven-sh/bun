//// a-yield-in-a-finally-block-holds-up-a-return.ts
////= text-14

function* stubborn(label: string): Generator<number, string, string> {
  let kept = "nothing";
  try {
    kept = yield 1;
    console.log(label + ": after the first yield " + text(kept));
    kept = yield 2;
    return "try " + kept;
  } finally {
    console.log(label + ": finally begins with " + text(kept));
    const inFinally: string = yield 100;
    console.log(label + ": finally was sent " + text(inFinally));
    const second: string = yield 200;
    console.log(label + ": finally was sent " + text(second));
  }
}

const a = stubborn("by hand");
console.log(text(a.next()));
console.log(text(a.return("asked")));
console.log(text(a.next("one")));
console.log(text(a.next("two")));
console.log(text(a.next("three")));

const b = stubborn("return twice");
console.log(text(b.next()));
console.log(text(b.return("first")));
console.log(text(b.return("second")));
console.log(text(b.next("late")));

const c = stubborn("throw in finally");
console.log(text(c.next()));
console.log(text(c.return("asked")));
try {
  console.log(text(c.throw(new SyntaxError("thrown in"))));
} catch (error) {
  console.log("throw in finally: " + failure(error));
}
console.log(text(c.next("late")));

const d = stubborn("break");
const hidden: Iterable<number> = d;
for (const n of hidden) {
  console.log("break: for-of got " + n);
  break;
}
console.log("break: the generator is still alive");
console.log(text(d.next("after the loop")));
console.log(text(d.next("and again")));
console.log(text(d.next("and once more")));

const e = stubborn("destructuring");
const alsoHidden: Iterable<number> = e;
const [first] = alsoHidden;
console.log("destructuring: got " + first);
console.log(text(e.next("after the pattern")));
console.log(text(e.next("and again")));

const f = stubborn("normal end");
console.log(text(f.next()));
console.log(text(f.next("x")));
console.log(text(f.next("y")));
console.log(text(f.next("z")));
console.log(text(f.next("w")));
console.log(text(f.next("v")));
//// abstract-members-are-read-by-the-base-constructor.ts
////= text-12

const log: string[] = [];

abstract class Shape {
  abstract readonly sides: number;
  abstract name: string;
  abstract area(): number;
  abstract get corners(): number;
  summary: string;
  doubled: number;
  constructor() {
    this.summary = this.describe();
    this.doubled = this.twice();
  }
  describe(): string {
    return typeof this.sides + " " + this.sides + " " + typeof this.name + " " + this.name + " " + this.corners;
  }
  twice(): number {
    return this.sides * 2;
  }
  safeArea(): string {
    try {
      return String(this.area());
    } catch (error) {
      return "threw";
    }
  }
}

class Square extends Shape {
  readonly sides: number = 4;
  name: string = "square";
  side: number = 3;
  area(): number {
    return this.side * this.side;
  }
  get corners(): number {
    return this.sides;
  }
}

class Fixed extends Shape {
  get sides(): number {
    return 3;
  }
  get name(): string {
    return "fixed";
  }
  set name(value: string) {
    log.push("name set to " + value);
  }
  area(): number {
    return 1;
  }
  get corners(): number {
    return 3;
  }
}

class Early extends Shape {
  readonly sides: number = 5;
  name: string = "early";
  areaSeen: string;
  points: number[] = [1, 2];
  constructor() {
    super();
    this.areaSeen = this.safeArea();
  }
  area(): number {
    return this.points.length;
  }
  get corners(): number {
    return this.points.length;
  }
  describe(): string {
    try {
      return super.describe();
    } catch (error) {
      return "threw " + (error instanceof Error ? error.constructor.name : typeof error);
    }
  }
}

const square = new Square();
show("square summary", () => square.summary);
show("square doubled", () => square.doubled);
show("square describe now", () => square.describe());
show("square twice now", () => square.twice());
show("square area", () => square.area());
show("square keys", () => Object.keys(square).join());

const fixed = new Fixed();
show("fixed summary", () => fixed.summary);
show("fixed doubled", () => fixed.doubled);
fixed.name = "other";
show("fixed name", () => fixed.name);
show("log", () => log.join());
show("fixed keys", () => Object.keys(fixed).join());

const early = new Early();
show("early summary", () => early.summary);
show("early doubled", () => early.doubled);
show("early area seen", () => early.areaSeen);

const shapes: Shape[] = [square, fixed, early];
let total = 0;
for (const shape of shapes) total += shape.doubled;
show("all doubled added", () => total);
show("sides", () => shapes.map(s => s.sides).join());
//// accessors-a-getter-typed-number-returns-a-string-after-a-while.ts
////= say

class Gauge {
  raw: number | string = 1;
  ticks = 0;
  tick(): void {
    this.ticks++;
    if (this.ticks > 2) this.raw = "text";
  }
  get level(): number {
    if (typeof this.raw === "number") {
      this.tick();
      return this.raw;
    }
    return -1;
  }
}

const gauge = new Gauge();
for (let i = 0; i < 5; i++) {
  const level = gauge.level;
  say("read " + i, level);
  say("read " + i + " plus one", level + 1);
  say("read " + i + " doubled", level * 2);
}

////= half

const second = new Gauge();
say("first", half(second.level));
say("second", half(second.level));
say("third", half(second.level));
say("fourth", half(second.level));
//// accessors-a-getter-typed-number-turns-into-a-string-in-five-places.ts
////= text-13

class Gauge {
  raw: number | string = 1;
  turnsAfter: number;
  reads = 0;
  constructor(turnsAfter: number) {
    this.turnsAfter = turnsAfter;
  }
  tick(): void {
    if (++this.reads > this.turnsAfter) this.raw = "text";
  }
  get level(): number {
    if (typeof this.raw === "number") {
      this.tick();
      return this.raw;
    }
    return -1;
  }
}

////= lines-203	interface	Leveled	readonly	level

////= half

function inAParameter(g: Leveled): unknown {
  return [g.level, g.level + 1, half(g.level)];
}

function inALocal(turnsAfter: number): unknown {
  const g = new Gauge(turnsAfter);
  const level = g.level;
  return [level, level + 1, level * 2, half(level)];
}

class Panel {
  gauge: Gauge;
  last = 0;
  constructor(turnsAfter: number) {
    this.gauge = new Gauge(turnsAfter);
  }
  inAField(): unknown {
    this.last = this.gauge.level;
    return [this.last, this.last + 1, half(this.last)];
  }
}

function inAnElement(gauges: Leveled[]): unknown {
  const levels: number[] = [];
  for (const g of gauges) levels.push(g.level);
  let sum = 0;
  for (const n of levels) sum += n;
  return [levels, sum];
}

function inACapturedVariable(turnsAfter: number): unknown {
  const g = new Gauge(turnsAfter);
  let level = 0;
  const read = (): void => {
    level = g.level;
  };
  read();
  return [level, level + 1, half(level)];
}

const never = 1e9;

function round(label: string, turnsAfter: number): void {
  attempt(label + " in a parameter", () => inAParameter(new Gauge(turnsAfter)));
  attempt(label + " in a local", () => inALocal(turnsAfter));
  attempt(label + " in a field", () => new Panel(turnsAfter).inAField());
  attempt(label + " in an element", () => inAnElement([new Gauge(never), new Gauge(turnsAfter), { level: 3 }]));
  attempt(label + " in a captured variable", () => inACapturedVariable(turnsAfter));
}

round("steady", never);
let sum = 0;
const longLived = new Gauge(2000);
for (let i = 0; i < 2000; i++) sum += longLived.level;
console.log("2000 honest reads: " + sum);
attempt("read 2001 at the same getter", () => {
  const level = longLived.level;
  return [level, level + 1, half(level)];
});
attempt("read 2002", () => longLived.level);
round("turned at once", 0);
round("turned at the second read", 1);
round("steady again", never);
//// accessors-a-member-with-only-a-getter-is-stored-to-in-sloppy-code.cts
////= say

say("strict", (function (this: unknown) {
  return this === undefined;
})());

const literal = {
  get size(): number {
    return 5;
  },
};

const writeOnly = {
  got: 0,
  set level(value: number) {
    this.got = value;
  },
};

type Loose = { size: number };

function store(o: Loose): number {
  return (o.size = 6);
}

function add(o: Loose): number {
  return (o.size += 1);
}

function increment(o: Loose): number {
  return o.size++;
}

say("a store", store(literal));
say("afterwards", literal.size);
say("plus equals", add(literal));
say("afterwards", literal.size);
say("increment", increment(literal));
say("afterwards", literal.size);
say("a plain object", store({ size: 1 }) + add({ size: 1 }) + increment({ size: 1 }));
say("write only: read", writeOnly.level);
say("write only: plus equals", (writeOnly.level += 1));
say("write only: got", writeOnly.got);
let sum = 0;
for (let i = 0; i < 2000; i++) sum += store(i % 2 === 0 ? literal : { size: i }) + literal.size;
say("2000 rounds", sum);
//// accessors-a-member-with-only-a-getter-is-stored-to-through-a-mutable-view.ts
////= text-13

class Fixed {
  get size(): number {
    return 5;
  }
}

class Child extends Fixed {}

class Counted {
  static get size(): number {
    return 5;
  }
}

function literal() {
  return {
    get size(): number {
      return 5;
    },
  };
}

type Loose = { size: number };

const stores: [string, (o: Loose) => unknown][] = [
  ["a store", o => (o.size = 6)],
  ["plus equals", o => (o.size += 1)],
  ["increment", o => o.size++],
  ["or equals, which stores nothing", o => (o.size ||= 6)],
  ["and equals", o => (o.size &&= 6)],
  ["nullish equals, which stores nothing", o => (o.size ??= 6)],
  ["a destructuring store", o => ([o.size] = [6])],
  ["Object.assign", o => Object.assign(o, { size: 6 }).size],
  ["Reflect.set", o => Reflect.set(o, "size", 6)],
  ["Object.defineProperty", o => Object.defineProperty(o, "size", { value: 6 }).size],
];

const makers: [string, () => Loose][] = [
  ["a class", () => new Fixed()],
  ["a subclass", () => new Child()],
  ["a literal", literal],
  ["a static member", () => Counted],
  ["a plain object", () => ({ size: 5 })],
];

for (const [kind, make] of makers) {
  for (const [name, store] of stores) {
    if (kind === "a static member" && name === "Object.defineProperty") continue;
    attempt(kind + ": " + name, () => {
      const o = make();
      let result: unknown;
      try {
        result = store(o);
      } finally {
        console.log("  afterwards: " + text(o.size) + ", own: " + Object.hasOwn(o, "size"));
      }
      return result;
    });
  }
}
let sum = 0;
const mixed: Loose[] = [];
for (let i = 0; i < 2000; i++) mixed.push({ size: i });
mixed.push(new Fixed());
let threw = 0;
for (const o of mixed) {
  try {
    o.size += 1;
  } catch {
    threw++;
  }
  sum += o.size;
}
console.log("2000 plain objects and one with only a getter: " + sum + ", threw " + threw);
//// accessors-a-member-with-only-a-setter-in-every-use.ts
////= text-13

const log: string[] = [];

class Sink {
  got: unknown[] = [];
  set level(value: number) {
    log.push("set " + String(value));
    this.got.push(value);
  }
}

const literal = {
  got: 0,
  set level(value: number) {
    log.push("literal set " + String(value));
    this.got = value;
  },
};

interface WriteOnly {
  set level(value: number);
}

class Child extends Sink {}

class Fixed {
  static got = 0;
  static set level(value: number) {
    log.push("static set " + String(value));
    Fixed.got = value;
  }
}

////= half

function uses(label: string, make: () => { level: number }): void {
  attempt(label + ": read", () => make().level);
  attempt(label + ": plus one", () => make().level + 1);
  attempt(label + ": handed on", () => half(make().level));
  attempt(label + ": to fixed", () => make().level.toFixed(1));
  attempt(label + ": kept in a constant", () => {
    const n: number = make().level;
    return [n, n * 2];
  });
  attempt(label + ": plus equals", () => (make().level += 1));
  attempt(label + ": increment", () => make().level++);
  attempt(label + ": or equals", () => (make().level ||= 5));
  attempt(label + ": nullish equals", () => (make().level ??= 5));
  attempt(label + ": destructured", () => {
    const { level } = make();
    return [level, level + 1];
  });
  attempt(label + ": destructured with a default", () => {
    const { level = 9 } = make();
    return level;
  });
  attempt(label + ": the name is there", () => "level" in make());
  attempt(label + ": keys", () => Object.keys(make()).join());
  attempt(label + ": as JSON", () => JSON.stringify(make()));
  attempt(label + ": copied by Object.assign", () => JSON.stringify(Object.assign({}, make())));
  attempt(label + ": filled by Object.assign", () => {
    const o = make();
    Object.assign(o, { level: 3 });
    return o.level;
  });
}

uses("a class", () => new Sink());
uses("a subclass", () => new Child());
uses("a literal", () => literal);
uses("a static member", () => Fixed);
attempt("through an interface", () => {
  const w: WriteOnly = new Sink();
  w.level = 4;
  return [w.level, w.level + 1];
});
attempt("a spread of the literal", () => {
  const copy = { ...literal };
  return [Object.keys(copy).join(), copy.level];
});
console.log(log.join(", "));
let sum = 0;
const plainOnes: { level: number }[] = [];
for (let i = 0; i < 2000; i++) plainOnes.push({ level: i });
plainOnes.push(new Sink());
for (const o of plainOnes) sum += o.level;
console.log("2000 plain members and one write-only member: " + sum);
