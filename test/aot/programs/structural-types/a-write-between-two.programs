say("a boolean", box.size);
Object.assign(box, { size: null });
say("null", box.size);
Object.assign(box, { size: undefined });
say("undefined", box.size);
try {
  Object.assign(box, { size: 5n });
  say("a bigint", box.size);
} catch (error) {
