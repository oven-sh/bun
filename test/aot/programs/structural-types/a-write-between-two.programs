abstract class Shape {
  abstract sides: number;
  copy: number;
  doubled: number;
  whole: number;
  constructor() {
    this.copy = this.sidesNow();
    this.doubled = this.sidesNow() * 2;
    this.whole = this.sidesNow() | 0;
  }
  sidesNow(): number {
    return this.sides;
  }
  copyPlusOne(): number {
    return this.copy + 1;
  }
}

////= lines-87	ByField	Shape	sides	number	4

////= lines-92	ByGetter	Shape	get	sides	number	3

class ByParameter extends Shape {
  constructor(public sides: number) {
    super();
  }
}

class ByStore extends Shape {
  sides: number;
  constructor() {
    super();
    this.sides = 6;
  }
}

////= lines-20	copyOf	shape	Shape	number	return	shape.copy

let sum = 0;
for (let i = 0; i < 2000; i++) sum += copyOf(new ByGetter()) + new ByGetter().doubled + new ByGetter().copyPlusOne();
show("2000 that have it in time", () => sum);

for (const shape of [new ByGetter(), new ByField(), new ByParameter(5), new ByStore()]) {
  const kind = shape.constructor.name;
  show(kind + ": sides now", () => shape.sides);
  show(kind + ": the copy", () => [shape.copy, typeof shape.copy, copyOf(shape)]);
  show(kind + ": the copy plus one", () => [shape.copy + 1, shape.copyPlusOne()]);
  show(kind + ": doubled", () => shape.doubled);
  show(kind + ": whole", () => shape.whole);
  show(kind + ": keys", () => Object.keys(shape));
  show(kind + ": JSON", () => JSON.stringify(shape));
}

const shapes: Shape[] = [new ByGetter(), new ByField(), new ByGetter()];
show("copies", () => shapes.map(copyOf));
show("copies added", () => shapes.reduce((total, shape) => total + shape.copy, 0));
show("copies as doubles", () => Array.from(Float64Array.from(shapes, copyOf)));
//// an-abstract-string-a-list-and-an-object-are-used-by-the-base-constructor.ts
////= text-11

////= Person-3

abstract class Page {
  abstract title: string;
  abstract lines: string[];
  abstract author: Person;
  seen: string[] = [];
  heading: string;
  constructor() {
    this.heading = this.titleNow() + "!";
    this.note("title", () => this.title);
    this.note("the length of the title", () => this.title.length);
    this.note("the title in capitals", () => this.title.toUpperCase());
    this.note("lines", () => this.lines);
    this.note("the number of lines", () => this.lines.length);
    this.note("lines iterated", () => [...this.lines].length);
    this.note("author", () => this.author);
    this.note("the name of the author", () => this.author.first);
  }
  titleNow(): string {
    return this.title;
  }
  note(label: string, run: () => unknown): void {
    try {
      const value = run();
      this.seen.push(label + " " + typeof value + " " + String(value));
    } catch (error) {
      this.seen.push(label + " threw " + (error instanceof TypeError ? "TypeError" : "another error"));
    }
  }
}

class ByFields extends Page {
  title: string = "fields";
  lines: string[] = ["one", "two"];
  author: Person = new Person();
}

class ByGetters extends Page {
  get title(): string {
    return "getters";
  }
  get lines(): string[] {
    return ["only"];
  }
  get author(): Person {
    return new Person();
  }
}

abstract class Strict {
  abstract title: string;
  width: number;
  constructor() {
    this.width = this.measure();
  }
  measure(): number {
    return this.title.length;
  }
}

////= lines-87	StrictByField	Strict	title	string	"late"

////= lines-92	StrictByGetter	Strict	get	title	string	"early"

const byGetters = new ByGetters();
show("getters: heading", () => byGetters.heading);
for (const line of byGetters.seen) console.log("getters: " + line);

const byFields = new ByFields();
show("fields: heading", () => byFields.heading);
for (const line of byFields.seen) console.log("fields: " + line);
show("fields: now", () => [byFields.title, byFields.lines, byFields.author.first]);
show("fields: keys", () => Object.keys(byFields));

show("a constructor that needs it: by a getter", () => new StrictByGetter().width);
show("a constructor that needs it: by a field", () => new StrictByField().width);
show("2000 of each", () => {
  let made = 0;
  let failed = 0;
  for (let i = 0; i < 2000; i++) {
    made += new StrictByGetter().width;
    try {
      made += new StrictByField().width;
    } catch {
      failed++;
    }
  }
  return [made, failed];
});
