////= text-11

abstract class Model {
  abstract size(): number;
  abstract label(): string;
  abstract fill(): void;
  sizeAtStart: number;
  labelAtStart: string;
  constructor() {
    this.sizeAtStart = this.size();
    this.labelAtStart = this.label();
    this.fill();
  }
}

class Grid extends Model {
  columns: number = 3;
  rows: number = 2;
  caption: string = "grid";
  cells: number[] = [];
  size(): number {
    return this.columns * this.rows;
  }
  label(): string {
    return this.caption + " " + this.columns;
  }
  fill(): void {
    this.rows = 50;
    this.caption = "filled early";
  }
}

class Constant extends Model {
  size(): number {
    return 7;
  }
  label(): string {
    return "constant";
  }
  fill(): void {}
}

class Pushes extends Model {
  cells: number[] = [];
  size(): number {
    return 0;
  }
  label(): string {
    return "pushes";
  }
  fill(): void {
    this.cells.push(1);
  }
}

////= lines-20	startOf	model	Model	number	return	model.sizeAtStart

let sum = 0;
for (let i = 0; i < 2000; i++) sum += startOf(new Constant()) + new Constant().labelAtStart.length;
show("2000 that need no field", () => sum);

const grid = new Grid();
show("the size at the start", () => [grid.sizeAtStart, typeof grid.sizeAtStart, startOf(grid), startOf(grid) + 1]);
show("the label at the start", () => [grid.labelAtStart, grid.labelAtStart.length]);
show("the size now", () => grid.size());
show("the label now", () => grid.label());
show("what the early stores left", () => [grid.rows, grid.caption]);
show("keys", () => Object.keys(grid));
show("JSON", () => JSON.stringify(grid));
show("one that pushes into a list that is not there", () => new Pushes());
show("the constant one", () => [startOf(new Constant()), new Constant().labelAtStart, Object.keys(new Constant())]);
show("three in a row", () => [new Constant(), new Grid(), new Constant()].map(startOf));
//// an-abstract-method-that-takes-a-dog-is-called-with-a-cat.ts
////= Person-5

abstract class Keeper {
  abstract legsOf(a: Animal): number;
  abstract tagOf(a: Animal): string;
  abstract ownerOf(a: Animal): Person;
  abstract speak(a: Animal): string;
  abstract shoe(a: Animal, legs: number): void;
  report(a: Animal): string {
    return "legs " + this.legsOf(a) + ", tag " + this.tagOf(a);
  }
  doubled(a: Animal): number {
    const legs: number = this.legsOf(a);
    return legs * 2;
  }
  shout(a: Animal): string {
    const tag: string = this.tagOf(a);
    return tag.toUpperCase();
  }
  greet(a: Animal): string {
    const owner: Person = this.ownerOf(a);
    return "hello " + owner.first;
  }
}

////= DogKeeper	extends

const own = new DogKeeper();
const keeper: Keeper = own;

function all(kind: string, a: Animal): void {
  show(kind + " legsOf", () => keeper.legsOf(a));
  show(kind + " tagOf", () => keeper.tagOf(a));
  show(kind + " ownerOf", () => keeper.ownerOf(a));
  show(kind + " speak", () => keeper.speak(a));
  show(kind + " report", () => keeper.report(a));
  show(kind + " doubled", () => keeper.doubled(a));
  show(kind + " shout", () => keeper.shout(a));
  show(kind + " greet", () => keeper.greet(a));
  show(kind + " shoe", () => keeper.shoe(a, 6));
  show(kind + " legsOf after shoe", () => keeper.legsOf(a));
  show(kind + " afterwards", () => a);
}

const rex = new Dog("rex");
show("typed caller legsOf", () => own.legsOf(rex));
show("typed caller speak", () => own.speak(rex));
all("dog", rex);
all("cat", new Cat("tom"));
all("animal", new Animal("thing"));
all("spider", new Spider("boris"));
all("dog again", new Dog("fido"));
show("typed caller doubled", () => own.doubled(rex));
//// an-abstract-number-is-copied-into-a-number-field-by-the-base-constructor.ts
