say("the getter typed number", t.v);
say("the getter typed number, plus one", t.v + 1);
t.v = "again";
say("a string again", t.v);
//// accessors-a-store-narrows-what-the-getter-then-contradicts.ts
////= text-13

class Words {
  kept: number | string = 0;
  get v(): number | string {
    return this.kept;
  }
  set v(value: number) {
    this.kept = value === 0 ? "zero" : value < 0 ? "negative" : value;
  }
}

////= Leaf

class Loses {
  kept: Leaf | null = null;
  get leaf(): Leaf | null {
    return this.kept;
  }
  set leaf(value: Leaf) {
    this.kept = value.weight > 5 ? null : value;
  }
}

class Flips {
  kept: "on" | "off" = "off";
  get mode(): "on" | "off" {
    return this.kept;
  }
  set mode(value: "on") {
    this.kept = this.kept === "on" ? "off" : "on";
  }
}

////= half

attempt("an honest store", () => {
  const w = new Words();
  w.v = 5;
  return [w.v, w.v + 1, w.v * 2, half(w.v), w.v.toFixed(1)];
});
let sum = 0;
const shared = new Words();
for (let i = 1; i <= 2000; i++) {
  shared.v = i;
  sum += shared.v;
}
console.log("2000 honest stores: " + sum);
attempt("zero comes back as a word", () => {
  const w = new Words();
  w.v = 0;
  return [w.v, w.v + 1, w.v * 2, half(w.v)];
});
attempt("zero comes back as a word, a method of numbers", () => {
  const w = new Words();
  w.v = 0;
  return w.v.toFixed(1);
});
attempt("at the site of the 2000 stores", () => {
  shared.v = -1;
  sum += shared.v;
  return sum;
});
attempt("kept in a constant", () => {
  const w = new Words();
  w.v = 0;
  const n: number = w.v;
  return [n, n - 1];
});
attempt("the value of the store itself", () => {
  const w = new Words();
  const n = (w.v = 0);
  return [n, n + 1];
});
attempt("an object comes back as null", () => {
  const l = new Loses();
  l.leaf = new Leaf();
  return l.leaf;
});
attempt("an object comes back as null, a member", () => {
  const l = new Loses();
  l.leaf = new Leaf();
  return l.leaf.weight;
});
attempt("a literal comes back as the other one", () => {
  const f = new Flips();
  f.mode = "on";
  const first: "on" = f.mode;
  f.mode = "on";
  const second: "on" = f.mode;
  return [first, second, second === "on"];
});
attempt("an honest store again", () => {
  const w = new Words();
  w.v = 5;
  return [w.v, w.v + 1];
});
//// accessors-a-typed-setter-gets-what-its-parameter-does-not-list.ts
////= text-13

const seen: string[] = [];

class Narrow {
  kept = 0;
  get v(): number {
    return this.kept;
  }
  set v(value: number) {
    seen.push(typeof value);
    this.kept = value * 2;
  }
}

class Adds {
  kept = 0;
  get v(): number {
    return this.kept;
  }
  set v(value: number) {
    seen.push(typeof value);
    this.kept = value + 1;
  }
}

class TakesText {
  kept = "";
  get v(): number {
    return this.kept.length;
  }
  set v(value: string) {
    seen.push(typeof value);
    this.kept = value + "!";
  }
}

interface Wide {
  get v(): number;
  set v(value: number | string | null);
}

function store(w: Wide, value: number | string | null): unknown {
  w.v = value;
  return w.v;
}

function storeANumber(o: { v: number }, value: number): unknown {
  o.v = value;
  return o.v;
}

attempt("honest: a number for a setter of numbers", () => [store(new Narrow(), 4), store(new Adds(), 4)]);
for (let i = 0; i < 2000; i++) {
  store(new Narrow(), i);
  store(new Adds(), i);
}
seen.length = 0;
attempt("a string for a setter that multiplies", () => {
  const n = new Narrow();
  return [store(n, "text"), n.kept, n.v + 1];
});
attempt("a numeric string for a setter that multiplies", () => {
  const n = new Narrow();
  return [store(n, "21"), n.kept, n.v + 1];
});
attempt("a string for a setter that adds", () => {
  const a = new Adds();
  return [store(a, "text"), a.kept, a.v + 1, a.v * 2];
});
attempt("null for a setter that adds", () => {
  const a = new Adds();
  return [store(a, null), a.kept];
});
attempt("a number for a setter of strings", () => {
  const t = new TakesText();
  return [storeANumber(t, 12), t.kept, typeof t.kept];
});
attempt("Reflect.set hands over an object", () => {
  const a = new Adds();
  return [Reflect.set(a, "v", { valueOf: () => 9 }), a.kept, a.v];
});
attempt("Object.assign hands over a boolean", () => {
  const a = new Adds();
  Object.assign(a, { v: true });
  return [a.kept, a.v];
});
attempt("Object.assign hands over undefined", () => {
  const n = new Narrow();
  Object.assign(n, { v: undefined });
  return [n.kept, n.v];
});
console.log("what the setters saw: " + seen.join());
attempt("honest again", () => [store(new Narrow(), 4), store(new Adds(), 4)]);
//// accessors-and-fields-override-each-other-through-a-base-that-is-a-call.ts
