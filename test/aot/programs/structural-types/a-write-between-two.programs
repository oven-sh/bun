  }
  set size(value: number | string) {
    seen.push(typeof value);
    this.kept = typeof value === "string" ? value.length : value + 1;
  }
}

const box = new Box();
Object.assign(box, { size: 4 });
say("a number", box.size);
Object.assign(box, { size: "four" });
say("a string", box.size);
