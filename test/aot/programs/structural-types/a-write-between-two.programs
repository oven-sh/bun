class Unrelated {
  stored = "";
  get v(): number {
    return this.stored.length;
  }
  set v(text: string) {
    this.stored = text;
  }
}

////= Leaf

class Wraps {
  inner = new Leaf();
  get leaf(): Leaf {
    return this.inner;
  }
  set leaf(weight: number) {
    this.inner = new Leaf();
    this.inner.weight = weight;
  }
}

class Lists {
  items: number[] = [];
  get all(): number[] {
    return this.items;
  }
  set all(one: number) {
    this.items.push(one);
  }
}

class Calls {
  count = 0;
  get run(): () => number {
    return () => this.count;
  }
  set run(count: number) {
    this.count = count;
  }
}

attempt("a number out, a string in", () => {
  const u = new Unrelated();
  const stored = (u.v = "hello");
  return [stored, u.v, u.v + 1, u.v * 2];
});
attempt("plus equals joins the number and a string", () => {
