////= ByReflectSet

function byReflectSet(p: ByReflectSet, really: boolean): string {
  const before = p.norm();
  const target: Target = really ? ByReflectSet.prototype : spare();
  Reflect.set(target, "norm", replacement);
  return before + " " + p.norm();
}

