//// an-array-made-by-a-mixin-behaves-like-an-array.ts
function Tagged(Base: new (...items: number[]) => number[]) {
  return class extends Base {
    tag = "tagged";
  };
}

const Made = Tagged(Array<number>);
const list = new Made();
list.push(1, 2);
list[4] = 5;
console.log("length " + list.length + " keys " + Object.keys(list).join(" ") + " json " + JSON.stringify(list) + " isArray " + Array.isArray(list));
list.length = 2;
console.log("shortened: " + list.join("+") + " keys " + Object.keys(list).join(" "));
const mapped = list.map(n => n * 2);
console.log("mapped: " + mapped.join("+") + " same class " + (mapped instanceof Made) + " keys " + Object.keys(mapped).join(" "));
const sliced = list.slice(1);
console.log("sliced: " + sliced.join("+") + " same class " + (sliced instanceof Made) + " length " + sliced.length);
console.log("concat: " + [0].concat(list).join("+") + " spread: " + [...list].join("+") + " from: " + Array.from(list).join("+"));
const [first, second, third] = list;
console.log("destructured: " + first + " " + second + " " + third);
let sum = 0;
for (const n of list) sum += n;
for (let i = 0; i < list.length; i++) sum += list[i];
console.log("summed twice: " + sum);
console.log("three: " + new Made(3).length + " one two: " + new Made(1, 2).join("+"));
//// an-array-of-circles-gets-a-square.ts
////= show-30

////= lines-27	Circle	kind	"circle"	radius	number

////= lines-27	Square	kind	"square"	side	number

type Shape = Circle | Square;

////= lines-88	radiusTimesTwo	circle	Circle	circle.radius	2

////= lines-95	totalRadius	circles	Circle	total	circle	circle.radius

function kinds(circles: Circle[]): string {
  return circles.map(circle => circle.kind).join();
}

function allCircles(circles: Circle[]): boolean {
  return circles.every(circle => circle.kind === "circle");
}

function area(shape: Shape): number {
  switch (shape.kind) {
    case "circle":
      return shape.radius * shape.radius * 3;
    case "square":
      return shape.side * shape.side;
  }
}

function describe(circle: Circle): string {
  return circle.kind === "circle" ? "round " + circle.radius : "impossible";
}

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest: Circle[] = [{ kind: "circle", radius: i }, { kind: "circle", radius: 0.5 }];
  warm += radiusTimesTwo(honest[0]) + totalRadius(honest) + kinds(honest).length + (allCircles(honest) ? 1 : 0) + area(honest[1]) + describe(honest[0]).length;
}
console.log("after 2000 honest arrays", warm);

