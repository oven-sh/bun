sheet.width = 3;
show("an own one", () => sheet.area());
const loose: { width?: number } = sheet;
delete loose.width;
show("deleted again", () => sheet.area());
show("keys", () => Object.keys(sheet).join());

class Plain {
  size: number = 1;
  name: string = "plain";
  double(): number {
