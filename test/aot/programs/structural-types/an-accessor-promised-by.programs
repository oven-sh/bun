//// an-array-changes-while-it-is-iterated.ts
////= show-31

let warm = 0;
////= for-3
console.log("after 4000 dense arrays", warm);

function forOfWith(numbers: number[], change: (value: number, numbers: number[]) => void): unknown[] {
  const seen: unknown[] = [];
  for (const value of numbers) {
    seen.push(value);
    change(value, numbers);
    if (seen.length > 12) break;
  }
  return seen;
}

function forEachWith(numbers: number[], change: (value: number, numbers: number[]) => void): unknown[] {
  const seen: unknown[] = [];
  numbers.forEach(value => {
    seen.push(value);
    change(value, numbers);
  });
  return seen;
}

function mapWith(numbers: number[], change: (value: number, numbers: number[]) => void): number[] {
  return numbers.map(value => {
    change(value, numbers);
    return value * 2;
  });
}

function indexWith(numbers: number[], change: (value: number, numbers: number[]) => void): unknown[] {
  const seen: unknown[] = [];
  for (let i = 0; i < numbers.length && seen.length <= 12; i++) {
    seen.push(numbers[i]);
    change(numbers[i], numbers);
  }
  return seen;
}

const changes: [string, (value: number, numbers: number[]) => void][] = [
  ["nothing", () => {}],
  ["push while short", (_, numbers) => void (numbers.length < 6 && numbers.push(numbers.length * 10))],
  ["pop", (_, numbers) => void numbers.pop()],
  ["shift", (_, numbers) => void numbers.shift()],
  ["unshift once", (value, numbers) => void (value === 1 && numbers.unshift(0))],
  ["delete the last", (_, numbers) => void delete numbers[numbers.length - 1]],
  ["delete the next", (value, numbers) => void delete numbers[numbers.indexOf(value) + 1]],
  ["empty it", (_, numbers) => void (numbers.length = 0)],
  ["store a fraction ahead", (_, numbers) => void (numbers[numbers.length - 1] = 0.5)],
  ["reverse once", (value, numbers) => void (value === 1 && numbers.reverse())],
  ["sort descending once", (value, numbers) => void (value === 1 && numbers.sort((a, b) => b - a))],
  ["splice out the next", (value, numbers) => void numbers.splice(numbers.indexOf(value) + 1, 1)],
];

for (const [name, change] of changes) {
  attempt(name + ": for-of", () => forOfWith([1, 2, 3, 4], change));
  attempt(name + ": forEach", () => forEachWith([1, 2, 3, 4], change));
  attempt(name + ": map", () => inspect(mapWith([1, 2, 3, 4], change)));
  attempt(name + ": by index", () => indexWith([1, 2, 3, 4], change));
}
attempt("a sort whose comparator empties the array", () => {
  const numbers = [3, 1, 2];
  numbers.sort((a, b) => {
    numbers.length = 0;
    return a - b;
  });
  return inspect(numbers);
});
attempt("a reduce that pushes", () => {
  const numbers = [1, 2, 3];
  return [numbers.reduce((total, value) => (numbers.push(100), total + value), 0), numbers.length];
});
attempt("an iterator kept after the end", () => {
  const numbers = [1];
  const iterator = numbers[Symbol.iterator]();
  const steps = [iterator.next(), iterator.next()];
  numbers.push(2);
  steps.push(iterator.next());
  return steps.map(step => step.done + ":" + step.value);
});
attempt("a spread of an array whose getter grows it", () => {
  const numbers = [1, 2];
  Object.defineProperty(numbers, 0, {
    get() {
      if (numbers.length < 4) numbers.push(9);
      return 1;
    },
  });
  return [...numbers];
});
//// an-array-gets-an-iterator-of-its-own.ts
////= lines-52	sum	list	number	total	n

function spread(list: number[]): string {
  return [...list].join();
}

function firstTwo(list: number[]): string {
  const [a, b] = list;
  return a + " " + b;
}

function rest(list: number[]): string {
  const [, ...others] = list;
  return others.join();
}

function largest(list: number[]): number {
  return Math.max(...list);
}

////= lines-59	byIndex	list	number	number	total	0

function all(list: number[]): string {
  return [sum(list), spread(list), firstTwo(list), rest(list), largest(list), byIndex(list), Array.from(list).join(), new Set(list).size, list.join(), list.map(n => n).join(), [0].concat(list).join(), Object.keys(list).join()].join(" | ");
}

function* countdown(): Generator<number, undefined, unknown> {
  yield 30;
  yield 20;
  yield 10;
  return undefined;
}

const honest = [1, 2, 3];
const changed = [1, 2, 3];
let warm = 0;
for (let i = 0; i < 2000; i++) warm += sum(honest) + sum(changed) + largest(changed) + spread(changed).length + firstTwo(changed).length;
console.log("2000 honest: " + warm);
console.log("before: " + all(changed));

changed[Symbol.iterator] = countdown;
console.log("an own iterator method: " + all(changed));
console.log("the honest one: " + all(honest));
console.log("own: " + Object.getOwnPropertySymbols(changed).length + ", is an array: " + Array.isArray(changed));

changed[Symbol.iterator] = honest.values.bind(honest);
honest.push(4);
console.log("the values of another array: " + all(changed));

changed[Symbol.iterator] = changed.values;
console.log("its own values method as an own member: " + all(changed));

Reflect.deleteProperty(changed, Symbol.iterator);
console.log("removed: " + all(changed));

class Evens extends Array<number> {
  *[Symbol.iterator](): Generator<number, undefined, unknown> {
    for (let i = 0; i < this.length; i += 2) yield this[i];
    return undefined;
  }
}

const evens = new Evens();
evens.push(1, 2, 3, 4, 5);
console.log("a subclass with its own iterator: " + all(evens));
console.log("what map makes of it: " + all(evens.map(n => n * 10)));

const nested: number[][] = [[1, 2], [3, 4]];
nested[1][Symbol.iterator] = countdown;
let total = 0;
for (const row of nested) for (const n of row) total += n;
console.log("one row of a grid: " + total + " | " + nested.flat().join() + " | " + nested.map(([first]) => first).join());

const tuple: [number, number] = [1, 2];
tuple[Symbol.iterator] = countdown;
const [x, y] = tuple;
console.log("a tuple: " + x + " " + y + " | " + tuple[0] + " " + tuple[1]);

