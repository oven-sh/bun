//// an-iterator-gives-results-without-done.ts
////= text-4

let calls = 0;

class Countdown implements Iterator<number>, Iterable<number> {
  left: number;
  constructor(left: number) {
    this.left = left;
  }
  next(): IteratorResult<number> {
    calls++;
    if (this.left > 0) return { value: this.left-- };
    return { done: true, value: undefined };
  }
  [Symbol.iterator](): Countdown {
    return this;
  }
}

function* honest(from: number): Generator<number, void, void> {
  for (let i = from; i > 0; i--) yield i;
}

function byNegation(it: Iterator<number>): number[] {
  const out: number[] = [];
  for (let r = it.next(); !r.done; r = it.next()) out.push(r.value);
  return out;
}

function byComparison(it: Iterator<number>): number[] {
  const out: number[] = [];
  for (let r = it.next(); r.done === false; r = it.next()) out.push(r.value);
  return out;
}

function keysOfTheFirst(it: Iterator<number>): string {
  const r = it.next();
  return Object.keys(r).join() + " | done in it: " + ("done" in r) + " | " + text(r.done) + " | " + text(r.value);
}

function* delegating(numbers: Iterable<number>): Generator<number, void, void> {
  yield* numbers;
}

const uses: [string, (make: () => Iterable<number> & Iterator<number>) => unknown][] = [
  ["by negation", make => byNegation(make())],
  ["by comparison with false", make => byComparison(make())],
  ["keys of the first result", make => keysOfTheFirst(make())],
  ["for-of", make => {
    const out: number[] = [];
    for (const n of make()) out.push(n);
    return out;
  }],
  ["spread", make => [...make()]],
  ["Array.from", make => Array.from(make())],
  ["destructuring", make => {
    const [x, y, z, w] = make();
    return [text(x), text(y), text(z), text(w)];
  }],
  ["yield*", make => [...delegating(make())]],
  ["yield*, first result", make => keysOfTheFirst(delegating(make()))],
  ["Iterator.from", make => Iterator.from(make()).toArray()],
  ["Math.min", make => Math.min(...make())],
];

for (const [label, use] of uses) {
  calls = 0;
  console.log(label + ", countdown: " + text(use(() => new Countdown(3))) + " after " + calls + " calls");
  console.log(label + ", generator: " + text(use(() => honest(3))));
}

let sum = 0;
for (let i = 0; i < 2000; i++) for (const n of honest(2)) sum += n;
for (const n of new Countdown(2)) sum += n;
console.log("2000 generators and one countdown at other sites: " + sum);

////= total-2
let grand = 0;
for (let i = 0; i < 2000; i++) grand += total(honest(2));
grand += total(new Countdown(4));
grand += total(honest(1));
console.log("2000 generators and one countdown at one site: " + grand);
//// an-iterator-member-in-every-form.ts
interface Series {
  name: string;
  [Symbol.iterator](): Iterator<number>;
}

const log: string[] = [];

function flush(label: string, value: unknown): void {
  console.log(label + ": " + String(value) + " [" + log.join(",") + "]");
  log.length = 0;
}

function logged(values: number[]): Iterator<number> {
  let i = 0;
  return {
    next() {
      log.push("next");
      return i < values.length ? { done: false, value: values[i++] } : { done: true, value: undefined };
    },
    return() {
      log.push("return");
      return { done: true, value: undefined };
    },
  };
}

class MethodForm {
  name = "a method of a class";
  [Symbol.iterator](): Iterator<number> {
    return logged([1, 2, 3]);
  }
}

class GeneratorForm {
  name = "a generator method";
  *[Symbol.iterator](): Generator<number> {
    try {
      yield 4;
      yield 5;
      yield 6;
    } finally {
      log.push("finally");
    }
  }
}

class FieldForm {
  name = "an arrow in a field";
  [Symbol.iterator] = (): Iterator<number> => logged([7, 8, 9]);
}

class GetterForm {
  name = "a getter";
  get [Symbol.iterator](): () => Iterator<number> {
    log.push("get iterator");
    return () => logged([10, 11, 12]);
  }
}

const literal: Series = {
  name: "a literal",
  [Symbol.iterator]: () => logged([13, 14, 15]),
};

const inherited: Series = Object.assign(Object.create(new MethodForm()), { name: "inherited" });
const borrowed: Series = { name: "an array's own iterator", [Symbol.iterator]: [16, 17, 18][Symbol.iterator].bind([16, 17, 18]) };
const list: Series = Object.assign([19, 20, 21], { name: "an array with a name" });

function sum(s: Series): number {
  let total = 0;
  for (const n of s) total += n;
  return total;
}

function firstOnly(s: Series): number {
  for (const n of s) return n;
  return -1;
}

////= firstTwo	s	Series	a	b	"+"

function* relay(s: Series): Generator<number> {
  yield* s;
}

const table: Series[] = [new MethodForm(), new GeneratorForm(), new FieldForm(), new GetterForm(), literal, inherited, borrowed, list];

for (const s of table) {
  flush(s.name + ", for-of", sum(s));
  flush(s.name + ", left early", firstOnly(s));
  flush(s.name + ", pattern", firstTwo(s));
  flush(s.name + ", spread", [...s].join());
  flush(s.name + ", arguments", Math.max(...s));
  flush(s.name + ", Array.from", Array.from(s, n => n * 2).join());
  flush(s.name + ", a set", new Set(s).size);
  flush(s.name + ", yield*", [...relay(s)].join());
  flush(s.name + ", own", Object.hasOwn(s, Symbol.iterator) + " " + Object.keys(s).join());
}

const honest = new MethodForm();
let total = 0;
for (let i = 0; i < 2000; i++) total += sum(honest);
log.length = 0;
console.log("2000 honest: " + total);
for (const s of table) flush("then " + s.name, sum(s));

const changing: Series = new MethodForm();
flush("before it is replaced", sum(changing));
changing[Symbol.iterator] = () => logged([100]);
flush("an own member hides the method", sum(changing));
MethodForm.prototype[Symbol.iterator] = () => logged([200]);
flush("the class's method replaced", sum(new MethodForm()) + " " + sum(inherited) + " " + sum(changing));

export {};
//// an-iterator-of-numbers-ends-and-its-value-is-still-read-as-a-number.ts
////= text-14

class Short implements Iterator<number> {
  at = 0;
  limit: number;
  constructor(limit: number) {
    this.limit = limit;
  }
  next(): IteratorResult<number> {
    if (this.at < this.limit) return { done: false, value: ++this.at };
    return { done: true, value: undefined };
  }
}

class Endless implements Iterator<number> {
  at = 0;
  next(): IteratorResult<number> {
    return { done: false, value: ++this.at };
  }
}

class EndsWithText implements Iterator<number, string> {
  at = 0;
  next(): IteratorResult<number, string> {
    if (this.at < 2) return { done: false, value: ++this.at };
    return { done: true, value: "over" };
  }
}

function* twoThenText(): Generator<number, string, void> {
  yield 1;
  yield 2;
  return "finished";
}

class Row {
  cells: number[] = [];
  last: number = 0;
}

function takeFive(it: Iterator<number>): string {
  const row = new Row();
  let sum = 0;
  let whole = 0;
  for (let i = 0; i < 5; i++) {
    const n: number = it.next().value;
    sum += n;
    whole = (whole + n) | 0;
    row.cells.push(n);
    row.last = n;
  }
  return "sum " + text(sum) + ", whole " + text(whole) + ", last " + text(row.last) + ", cells " + row.cells.map(text).join("; ") + ", json " + JSON.stringify(row);
}

function fixed(it: Iterator<number>): string {
  const out: string[] = [];
  for (let i = 0; i < 4; i++) {
    const n: number = it.next().value;
    try {
      out.push(n.toFixed(1));
    } catch (error) {
      out.push(failure(error));
    }
  }
  return out.join();
}

console.log("endless: " + takeFive(new Endless()));
console.log("short: " + takeFive(new Short(3)));
console.log("ends with text: " + takeFive(new EndsWithText()));
console.log("a generator that returns text: " + takeFive(twoThenText()));
console.log("an array's iterator: " + takeFive([1, 2][Symbol.iterator]()));
console.log("endless again: " + takeFive(new Endless()));

console.log("fixed, endless: " + fixed(new Endless()));
console.log("fixed, short: " + fixed(new Short(2)));
console.log("fixed, ends with text: " + fixed(new EndsWithText()));

const forever = new Endless();
let warm = 0;
function one(it: Iterator<number>): number {
  return it.next().value;
}
for (let i = 0; i < 2000; i++) warm += one(forever);
console.log("2000 honest reads: " + warm);
const ending = new Short(1);
console.log("then: " + text(one(ending)) + ", " + text(one(ending)) + ", " + text(one(ending) + 1));
console.log("and honest again: " + text(one(forever)));
//// an-iterator-of-the-program-loses-its-object.ts
////= show-6

class Countdown implements IterableIterator<number> {
  left: number;
  constructor(from: number) {
    this.left = from;
  }
  next(): IteratorResult<number> {
    if (this.left <= 0) return { done: true, value: undefined };
    return { done: false, value: this.left-- };
  }
  return(): IteratorResult<number> {
    this.left = 0;
    return { done: true, value: undefined };
  }
  [Symbol.iterator](): this {
    return this;
  }
}

show("honest", () => [...new Countdown(3)].join());
show("bare next", () => {
  const { next } = new Countdown(3);
  return next().value;
});
show("next on a look-alike", () => {
  const like = { left: 2 };
  const countdown = new Countdown(9);
  return countdown.next.call(like).value + " " + like.left + " " + countdown.left;
});
show("next on a wrong look-alike", () => JSON.stringify(new Countdown(9).next.call({ left: "two" })));
show("next on an empty object", () => JSON.stringify(new Countdown(9).next.call({})));
show("an iterable made of another one's methods", () => {
  const source = new Countdown(9);
  const borrowed = { left: 2, next: source.next, [Symbol.iterator]: source[Symbol.iterator] };
  return [...borrowed].join() + " " + source.left;
});
show("an iterable whose iterator method lost its object", () => {
  const source = new Countdown(2);
  const iterate = source[Symbol.iterator];
  const broken: Iterable<number> = { [Symbol.iterator]: () => iterate() };
  return [...broken].join();
});
show("an iterator object with a bare next", () => {
  const source = new Countdown(2);
  const next = source.next;
  const broken: Iterable<number> = { [Symbol.iterator]: () => ({ next: () => next() }) };
  return [...broken].join();
});
show("an iterator object that carries next as its member", () => {
  const source = new Countdown(2);
  const carrier: Iterable<number> = { [Symbol.iterator]: () => ({ next: source.next }) };
  const seen: string[] = [];
  for (const n of carrier) {
    seen.push(String(n));
    if (seen.length === 3) break;
  }
  return seen.join() + " " + source.left;
});
show("the same with a field of its own", () => {
  const source = new Countdown(9);
  const carrier: Iterable<number> = { [Symbol.iterator]: () => ({ left: 2, next: source.next }) };
  return [...carrier].join() + " " + source.left;
});
show("break calls return on the right object", () => {
  const source = new Countdown(5);
  for (const n of source) if (n === 4) break;
  return source.left;
});
show("destructuring", () => {
  const source = new Countdown(5);
  const [a, b] = source;
  return a + " " + b + " " + source.left;
});
show("Array.from with a bare next inside", () => {
  const source = new Countdown(2);
  return Array.from({ [Symbol.iterator]: () => ({ next: source.next.bind(source) }) }).join();
});
//// an-object-changes-between-two-uses-in-one-function.ts
class Thing {
  x = 1;
  y = 2;
  m(): number {
    return 3;
  }
}

let target: Thing = new Thing();
let armed = false;

function mutate(): void {
  if (!armed) return;
  target.x = 100;
  target.m = () => -1;
  Object.freeze(target);
}

function mutated(): number {
  mutate();
  return 0;
}

class Trigger {
  list = [1];
  optional?: number = 1;
  toString(): string {
    mutate();
    return "t";
  }
  valueOf(): number {
    mutate();
    return 0;
  }
  toJSON(): string {
    mutate();
    return "j";
  }
  get read(): number {
    mutate();
    return 0;
  }
  set write(value: number) {
    mutate();
  }
  *[Symbol.iterator](): Generator<number> {
    mutate();
    yield 1;
  }
  static [Symbol.hasInstance](value: unknown): boolean {
    void value;
    mutate();
    return true;
  }
}

const trapped: { key?: number } = new Proxy<{ key?: number }>({ key: 1 }, {
  has() {
    mutate();
    return true;
  },
  deleteProperty() {
    mutate();
    return true;
  },
});

function after(p: Thing, before: number): string {
  let stored = "stored";
  try {
    p.y = 5;
  } catch {
    stored = "threw";
  }
  return before + " -> " + p.x + " " + p.m() + " " + stored;
}

function tag(strings: TemplateStringsArray): string {
  mutate();
  return strings[0];
}

const forms: [string, (p: Thing, t: Trigger) => string][] = [
  ["nothing", p => { const b = p.x + p.m(); return after(p, b); }],
  ["a call", p => { const b = p.x + p.m(); mutate(); return after(p, b); }],
  ["a template", (p, t) => { const b = p.x + p.m(); `${t}`; return after(p, b); }],
  ["concatenation", (p, t) => { const b = p.x + p.m(); "" + t; return after(p, b); }],
  ["unary plus", (p, t) => { const b = p.x + p.m(); +t; return after(p, b); }],
  ["String()", (p, t) => { const b = p.x + p.m(); String(t); return after(p, b); }],
  ["join", (p, t) => { const b = p.x + p.m(); [t].join(); return after(p, b); }],
  ["JSON.stringify", (p, t) => { const b = p.x + p.m(); JSON.stringify(t); return after(p, b); }],
  ["a getter", (p, t) => { const b = p.x + p.m(); t.read; return after(p, b); }],
  ["a setter", (p, t) => { const b = p.x + p.m(); t.write = 1; return after(p, b); }],
  ["for-of", (p, t) => { const b = p.x + p.m(); for (const _ of t); return after(p, b); }],
  ["an array spread", (p, t) => { const b = p.x + p.m(); [...t]; return after(p, b); }],
  ["an array pattern", (p, t) => { const b = p.x + p.m(); const [first] = t; return after(p, b + first - 1); }],
  ["an object spread", (p, t) => { const b = p.x + p.m(); ({ ...{ get g() { return t.read; } } }); return after(p, b); }],
  ["instanceof", (p, t) => { const b = p.x + p.m(); t instanceof Trigger; return after(p, b); }],
  ["in", p => { const b = p.x + p.m(); "key" in trapped; return after(p, b); }],
  ["delete", p => { const b = p.x + p.m(); delete trapped.key; return after(p, b); }],
  ["a callback of map", (p, t) => { const b = p.x + p.m(); t.list.map(mutate); return after(p, b); }],
  ["a comparator", p => { const b = p.x + p.m(); [2, 1].sort((l, r) => (mutate(), l - r)); return after(p, b); }],
  ["a default in a pattern", p => { const b = p.x + p.m(); const { missing = mutated() }: { missing?: number } = {}; return after(p, b + missing); }],
  ["a default parameter", p => { const b = p.x + p.m(); ((v = mutate()) => v)(); return after(p, b); }],
  ["a tagged template", p => { const b = p.x + p.m(); tag`x`; return after(p, b); }],
  ["a constructor", p => { const b = p.x + p.m(); new (class { constructor() { mutate(); } })(); return after(p, b); }],
  ["a catch block", p => { const b = p.x + p.m(); try { throw new Error("e"); } catch { mutate(); } return after(p, b); }],
  ["a finally block", p => { const b = p.x + p.m(); try { b.toFixed(); } finally { mutate(); } return after(p, b); }],
  ["a computed key", (p, t) => { const b = p.x + p.m(); ({ [`${t}`]: 1 }); return after(p, b); }],
];

const trigger = new Trigger();

for (const [, form] of forms) for (let i = 0; i < 300; i++) form(new Thing(), trigger);

for (const [label, form] of forms) {
  target = new Thing();
  armed = true;
  const result = form(target, trigger);
  armed = false;
  console.log(label + ": " + result);
}

for (const [label, form] of forms) console.log(label + ", unarmed again: " + form(new Thing(), trigger));

export {};
//// an-object-changes-while-an-async-function-or-a-generator-waits.ts
////= Point-18

////= Pair-2

function nameOf(error: unknown): string {
  return error instanceof Error ? error.constructor.name : typeof error;
}

function state(p: Point): string {
  return p.x + "," + p.y + "," + p.z + " " + Object.keys(p).join("") + " " + JSON.stringify(p);
}

async function readTwice(p: Point, gate: Promise<void>): Promise<string> {
  const before = state(p);
  await gate;
  return before + " -> " + state(p);
}

async function storeAfter(p: Point, gate: Promise<void>): Promise<string> {
  p.x = 10;
  await gate;
  try {
    p.x = 20;
    p.z = 30;
    return "stored " + state(p);
  } catch (error) {
    return "threw " + nameOf(error) + " " + state(p);
  }
}

async function callAfter(p: Pair, gate: Promise<void>): Promise<string> {
  const before = p.sum() + " " + (p instanceof Pair);
  await gate;
  return before + " -> " + p.sum() + " " + (p instanceof Pair);
}

function* steps(p: Point): Generator<string, string, void> {
  yield state(p);
  yield state(p);
  try {
    p.y = 99;
  } catch (error) {
    return "threw " + nameOf(error);
  }
  return state(p);
}

const changes: [string, (p: Point) => void][] = [
  ["nothing", () => {}],
  ["a store", p => { p.x = -1; }],
  ["an optional member added", p => { p.z = 3; }],
  ["a getter defined", p => { Object.defineProperty(p, "x", { get: () => 77, enumerable: true, configurable: true }); }],
  ["frozen", p => { Object.freeze(p); }],
  ["members deleted and added in another order", p => {
    const { x, y } = p;
    Reflect.deleteProperty(p, "x");
    Reflect.deleteProperty(p, "y");
    Object.assign(p, { y, x });
  }],
  ["a member moved to a new prototype", p => {
    Reflect.deleteProperty(p, "y");
    Object.setPrototypeOf(p, { y: 55 });
  }],
];

for (const [label, change] of changes) {
  let open: () => void = () => {};
  const gate = new Promise<void>(resolve => {
    open = resolve;
  });
  const a: Point = { x: 1, y: 2 };
  const b: Point = { x: 1, y: 2 };
  const reading = readTwice(a, gate);
  const storing = storeAfter(b, gate);
  change(a);
  change(b);
  open();
  console.log(label + ", read across an await: " + (await reading));
  console.log(label + ", stored across an await: " + (await storing));

  const c: Point = { x: 1, y: 2 };
  const generator = steps(c);
  const first = generator.next().value;
  change(c);
  console.log(label + ", across yields: " + first + " -> " + generator.next().value + " -> " + generator.next().value);
}

const pairChanges: [string, (p: Pair) => void][] = [
  ["nothing", () => {}],
  ["an own method", p => { p.sum = () => -1; }],
  ["another prototype", p => { Object.setPrototypeOf(p, { sum: () => -2 }); }],
  ["the class's method replaced", () => { Pair.prototype.sum = () => -3; }],
];

for (const [label, change] of pairChanges) {
  let open: () => void = () => {};
  const gate = new Promise<void>(resolve => {
    open = resolve;
  });
  const p = new Pair();
  const calling = callAfter(p, gate);
  change(p);
  open();
  console.log(label + ", called across an await: " + (await calling));
}

export {};
//// an-object-created-from-the-prototype-gets-its-fields-later.ts
////= show-30

class Point {
  x = 1;
  y = 2.5;
  label = "point";
  sum(): number {
    return this.x + this.y;
  }
  describe(): string {
    return this.label + " " + this.x + " " + this.y;
  }
}

function bare(): Point {
  return Object.create(Point.prototype);
}

////= sum-2

////= lines-32	labelLength	p	Point	number	p.label.length

function fill(p: Point, x: number, y: number, label: string): Point {
  p.x = x;
  p.y = y;
  p.label = label;
  return p;
}

function fillBackwards(p: Point, x: number, y: number, label: string): Point {
  p.label = label;
  p.y = y;
  p.x = x;
  return p;
}

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = new Point();
  warm += sum(honest) + labelLength(honest) + honest.sum() + honest.describe().length + sum(fill(new Point(), i, 1, "l")) + sum(fillBackwards(new Point(), i, 1, "l"));
}
console.log("after 2000 honest points", warm);

attempt("nothing is there", () => {
