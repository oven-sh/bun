});
attempt("among honest points", () => [new Point(), bare(), fill(bare(), 3, 4, "f"), new Point()].map(sum));
attempt("honest again", () => [sum(new Point()), new Point().describe()]);
//// an-object-in-a-string-field-is-appended-in-a-loop-through-a-member-of-a-literal.ts
////= lines-28	Planet	label	string
function read(planet: Planet): string {
  const bag = { held: planet };
  let built = "";
  for (let i = 0; i < 3; i++) built += bag.held.label;
  return built;
}
const honest: Planet = { label: "ab" };
console.log("honest " + read(honest));
const victim: Planet = { label: "ab" };
const wide: { label: unknown } = victim;
wide.label = Object(3);
console.log("victim " + read(victim));
//// an-object-is-frozen-in-ways-that-are-hard-to-see.ts
////= Point-2

////= Pair

function setX(p: Point): string {
  try {
    p.x = 50;
    return "stored " + p.x;
  } catch (error) {
    return "threw " + (error instanceof Error ? error.constructor.name : typeof error) + " " + p.x;
  }
}

function shift(p: Pair): string {
  try {
    return "shifted " + p.shift();
  } catch (error) {
    return "threw " + (error instanceof Error ? error.constructor.name : typeof error) + " " + p.x;
  }
}

function apply(action: (target: object) => unknown, target: object): void {
  action(target);
}

function deepFreeze(value: unknown): void {
  if (typeof value !== "object" || value === null) return;
  for (const inner of Object.values(value)) deepFreeze(inner);
  Object.freeze(value);
}

const renamed = Object.freeze;
const { freeze: taken } = Object;
const bound = Object.freeze.bind(Object);
const inAList = [Object.freeze];
const inARecord: Record<string, (target: object) => unknown> = { go: Object.freeze };
const made = new Function("target", "Object.freeze(target);");
const evaluated: (target: object) => void = (0, eval)("(function (target) { Object.freeze(target); })");
const key: string = ["g", "o"].join("");

const freezers: [string, (target: object) => void][] = [
  ["not at all", () => {}],
  ["directly", target => { Object.freeze(target); }],
  ["under another name", target => { renamed(target); }],
  ["taken out by a pattern", target => { taken(target); }],
  ["bound", target => { bound(target); }],
  ["call", target => { Object.freeze.call(Object, target); }],
  ["apply", target => { Object.freeze.apply(Object, [target]); }],
  ["Reflect.apply", target => { Reflect.apply(Object.freeze, Object, [target]); }],
  ["handed to forEach", target => { [target].forEach(Object.freeze); }],
  ["handed to map", target => { [target].map(renamed); }],
  ["handed to a function of ours", target => { apply(Object.freeze, target); }],
  ["out of a list", target => { inAList[0](target); }],
  ["out of a record by a computed name", target => { inARecord[key](target); }],
  ["from inside a wrapper object", target => { deepFreeze({ wrapped: [target] }); }],
  ["by code made at run time", target => { made(target); }],
  ["by evaluated code", target => { evaluated(target); }],
  ["in a promise reaction", () => {}],
  ["piece by piece", target => {
    Object.preventExtensions(target);
    for (const name of Object.keys(target)) Object.defineProperty(target, name, { writable: false, configurable: false });
  }],
  ["through a proxy", target => { Object.freeze(new Proxy(target, {})); }],
];

////= for-28

for (const [label, freeze] of freezers) {
  const literal: Point = { x: 1, y: 2 };
  const instance = new Pair();
  if (label === "in a promise reaction") {
    await Promise.resolve(literal).then(Object.freeze);
    await Promise.all([instance].map(async target => Object.freeze(target)));
  }
  freeze(literal);
  freeze(instance);
  console.log(label + ": literal " + setX(literal) + ", instance " + setX(instance) + ", its method " + shift(instance) + ", frozen " + Object.isFrozen(literal) + " " + Object.isFrozen(instance));
}

console.log("untouched afterwards: " + setX({ x: 1, y: 2 }) + ", " + shift(new Pair()));

export {};
//// an-object-literal-method-that-takes-a-dog-gets-a-cat.ts
////= Person-5

////= Keeper

const shorthand: Keeper = {
  legsOf(d: Dog) {
    return d.legs;
  },
  tagOf(d: Dog) {
    return d.tag;
  },
  ownerName(d: Dog) {
    return d.owner.first;
  },
  speak(d: Dog) {
    return d.bark();
  },
  shoe(d: Dog) {
    d.legs = d.legs + 1;
  },
};

const arrows: Keeper = {
  legsOf: (d: Dog) => d.legs,
  tagOf: (d: Dog) => d.tag,
  ownerName: (d: Dog) => d.owner.first,
  speak: (d: Dog) => d.bark(),
  shoe: (d: Dog) => {
    d.legs += 1;
  },
};

////= lines-20	legsOfDog	d	Dog	number	return	d.legs
////= lines-20	tagOfDog	d	Dog	string	return	d.tag
////= lines-32	ownerNameOfDog	d	Dog	string	d.owner.first
////= lines-19	speakDog	d	Dog	string	d.bark
function shoeDog(d: Dog): void {
  d.legs++;
}

const declared: Keeper = {
  legsOf: legsOfDog,
  tagOf: tagOfDog,
  ownerName: ownerNameOfDog,
  speak: speakDog,
  shoe: shoeDog,
};

function all(kind: string, keeper: Keeper, a: Animal): void {
  show(kind + " legsOf", () => keeper.legsOf(a));
  show(kind + " tagOf", () => keeper.tagOf(a));
  show(kind + " ownerName", () => keeper.ownerName(a));
  show(kind + " speak", () => keeper.speak(a));
  show(kind + " shoe", () => keeper.shoe(a));
  show(kind + " afterwards", () => a);
}

const forms: [string, Keeper][] = [
  ["shorthand", shorthand],
  ["arrows", arrows],
  ["declared", declared],
];
for (const [form, keeper] of forms) {
  all(form + " dog", keeper, new Dog("rex"));
  all(form + " cat", keeper, new Cat("tom"));
  all(form + " animal", keeper, new Animal("thing"));
  all(form + " spider", keeper, new Spider("boris"));
}

const honest = new Dog("honest");
show("the same function called honestly: legs", () => legsOfDog(honest));
show("the same function called honestly: tag", () => tagOfDog(honest));
show("the same function called honestly: owner", () => ownerNameOfDog(honest));
show("the same function called honestly: speak", () => speakDog(honest));
show("the same function called honestly: shoe", () => shoeDog(honest));
show("honest afterwards", () => honest);
//// an-object-literal-stands-in-for-a-class-instance.ts
class Temperature {
  degrees = 20;
  scale = "C";
  warmer(by: number): Temperature {
    const next = new Temperature();
    next.degrees = this.degrees + by;
    return next;
  }
  label(): string {
    return this.degrees + this.scale;
  }
  get freezing(): boolean {
    return this.degrees <= 0;
  }
}

const calls: string[] = [];

const literal: Temperature = {
  scale: "F",
  degrees: 68,
  warmer(by) {
    calls.push("warmer " + by);
    return this;
  },
  label() {
    calls.push("label");
    return "literal " + this.degrees;
  },
  freezing: true,
};

const arrows: Temperature = {
  degrees: -5,
  scale: "K",
  warmer: () => literal,
  label: () => "arrow",
  get freezing() {
    calls.push("get freezing");
    return false;
  },
};

function inspect(t: Temperature): string {
  return [
    t.label(),
    t.degrees,
    t.scale,
    t.freezing,
    t.warmer(1).label(),
    t instanceof Temperature,
    t.constructor === Object,
    Object.getPrototypeOf(t) === Object.prototype,
    Object.keys(t).join("+"),
    Object.hasOwn(t, "label"),
    "label" in t,
  ].join(" ");
}

function chain(t: Temperature): string {
  return t.warmer(1).warmer(2).warmer(3).label();
}

class Room {
  constructor(public temperature: Temperature) {}
  status(): string {
    return this.temperature.label() + (this.temperature.freezing ? " cold" : " fine");
  }
}

console.log("an instance: " + inspect(new Temperature()));
console.log("a literal: " + inspect(literal));
console.log("a literal of arrows: " + inspect(arrows));
console.log("calls: " + calls.join());
calls.length = 0;

console.log("chain, instance: " + chain(new Temperature()));
console.log("chain, literal: " + chain(literal));
console.log("chain, arrows: " + chain(arrows));
console.log("calls: " + calls.join());
calls.length = 0;

console.log("field, instance: " + new Room(new Temperature()).status());
console.log("field, literal: " + new Room(literal).status());
console.log("field, arrows: " + new Room(arrows).status());

const list: Temperature[] = [new Temperature(), literal, arrows];
console.log("elements: " + list.map(t => t.label()).join());
console.log("json: " + JSON.stringify(list));
console.log("instances among them: " + list.filter(t => t instanceof Temperature).length);

let text = "";
for (let i = 0; i < 2000; i++) text = new Temperature().label();
console.log("2000 honest labels, the last: " + text);
const sameSite = (t: Temperature) => t.label();
for (let i = 0; i < 2000; i++) sameSite(list[0]);
console.log("then the literal at that site: " + sameSite(literal));
console.log("then the arrows: " + sameSite(arrows));

const taken = literal.label;
console.log("a literal's method on an instance: " + taken.call(new Temperature()));
console.log("the class's method on a literal: " + Temperature.prototype.label.call(literal));

export {};
//// an-object-made-elsewhere-stays-the-same-object.ts
////= Point-2

class Holder {
  point: Point;
  points: Point[] = [];
  constructor(point: Point) {
    this.point = point;
    this.points.push(point);
  }
  move(): void {
    this.point.x += 1;
  }
}

////= lines-45	identity	p	Point	Point

////= setX-3

////= sum-2

const outsideRead = new Function("o", "return o.x + ',' + o.y + ',' + Object.keys(o).join('');");
const outsideStore = new Function("o", "v", "o.x = v;");
const outsideSame = new Function("a", "b", "return a === b;");

const makers: [string, () => Point][] = [
  ["a literal", () => ({ x: 1, y: 2 })],
  ["JSON.parse", () => JSON.parse('{"x":1,"y":2}')],
  ["JSON.parse, other order and an extra", () => JSON.parse('{"z":0,"y":2,"x":1}')],
  ["structuredClone", () => structuredClone({ x: 1, y: 2 })],
  ["Object.assign", () => Object.assign({}, { x: 1 }, { y: 2 })],
  ["code made at run time", () => new Function("return { x: 1, y: 2 };")()],
  ["evaluated code", () => (0, eval)("({ y: 2, x: 1 })")],
  ["a reviver", () => JSON.parse('{"p":{"x":1,"y":2}}', (key, value: unknown) => value).p],
  ["Object.create and stores", () => {
    const made: Point = Object.create(Object.prototype);
    made.x = 1;
    made.y = 2;
    return made;
  }],
];

const notes = new WeakMap<Point, string>();

for (const [label, make] of makers) {
  const original = make();
  const through = identity(original);
  const holder = new Holder(original);
  const list: Point[] = [{ x: 0, y: 0 }, original];
  notes.set(original, label);
  const captured = () => original;
  console.log(
    label + ", the same object: " +
      [
        through === original,
        holder.point === original,
        holder.points[0] === original,
        list[1] === original,
        list.includes(original),
        list.indexOf(original),
        new Set(list).has(through),
        notes.get(holder.point) === label,
        captured() === through,
        Object.is(through, original),
        outsideSame(holder.point, original),
      ].join(" "),
  );
  setX(through, 10);
  console.log(label + ", a typed store seen from outside: " + outsideRead(original));
  outsideStore(original, 20);
  console.log(label + ", an outside store seen by typed code: " + sum(through) + " " + sum(holder.point) + " " + sum(list[1]));
  holder.move();
  console.log(label + ", a store through a field: " + outsideRead(original) + " " + original.x);
  list[1].y = 30;
  console.log(label + ", a store through an element: " + outsideRead(original) + " " + JSON.stringify(through));
}

let warm = 0;
const honest: Point = { x: 1, y: 2 };
for (let i = 0; i < 2000; i++) warm += sum(identity(honest));
console.log("2000 honest: " + warm);
const parsed: Point = JSON.parse('{"x":5,"y":6}');
console.log("then a parsed one: " + sum(identity(parsed)) + " " + (identity(parsed) === parsed));

const shared: Point = JSON.parse('{"x":0,"y":0}');
const holders = [new Holder(shared), new Holder(shared), new Holder(shared)];
for (const h of holders) h.move();
console.log("three holders of one object: " + shared.x + " " + holders.every(h => h.point === shared));

export {};
