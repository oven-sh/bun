//// an-object-of-getters-is-used-as-a-config.ts
////= show-39

function computed(source: Config): Config {
  const copy = { ...source };
  return {
    get port() {
      return copy.port;
    },
    set port(value) {
      copy.port = value;
    },
    get ratio() {
      return copy.ratio;
    },
    get host() {
      return copy.host;
    },
    set host(value) {
      copy.host = value;
    },
    get secure() {
      return copy.secure;
    },
    get paths() {
      return copy.paths;
    },
    get limits() {
      return copy.limits;
    },
  };
}

