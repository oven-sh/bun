//// an-overloaded-subscribe-method-sends-handlers-another-payload.ts
////= text-14

class Chunk {
  bytes: number;
  label: string;
  constructor(bytes: number, label: string) {
    this.bytes = bytes;
    this.label = label;
  }
  describe(): string {
    return this.label + " of " + this.bytes;
  }
}

type Payload = string | number | Chunk | undefined;

////= lines-244	Handler	T	handle	payload	void

class Hub {
  handlers = new Map<string, Handler<Payload>[]>();
  on(event: "text", handler: Handler<string>): void;
  on(event: "count", handler: Handler<number>): void;
  on(event: "chunk", handler: Handler<Chunk>): void;
  on(event: "end", handler: Handler<undefined>): void;
  on(event: string, handler: Handler<Payload>): void {
    const list = this.handlers.get(event) ?? [];
    list.push(handler);
    this.handlers.set(event, list);
  }
  send(event: string, payload: Payload): void {
    for (const handler of this.handlers.get(event) ?? []) {
      try {
        handler.handle(payload);
      } catch (error) {
        console.log("  the handler of " + event + " " + failure(error));
      }
    }
  }
}

const hub = new Hub();

let total = 0;
let quiet = 0;

class Summing implements Handler<number> {
  sum: number = 0;
  handle(n: number): void {
    this.sum += n;
    quiet += n;
  }
}
const summing = new Summing();

hub.on("text", {
  handle(line) {
    console.log("  text: " + text(line) + ", length " + text(line.length) + ", upper " + line.toUpperCase());
  },
});
hub.on("count", {
  handle(n) {
    total += n;
    console.log("  count: " + text(n) + ", doubled " + text(n * 2) + ", total " + text(total));
  },
});
hub.on("chunk", {
  handle(chunk) {
    console.log("  chunk: " + text(chunk) + ", bytes + 1 " + text(chunk.bytes + 1) + ", " + chunk.describe());
  },
});
hub.on("end", {
  handle(nothing) {
    console.log("  end: " + arguments.length + " arguments, first " + text(nothing) + ", undefined " + (nothing === undefined));
  },
});

const payloads: [string, Payload][] = [
  ["a text", "line"],
  ["a number", 5],
  ["a chunk", new Chunk(3, "c")],
  ["nothing", undefined],
];

console.log("honest:");
hub.send("text", "line");
hub.send("count", 5);
hub.send("chunk", new Chunk(3, "c"));
hub.send("end", undefined);

for (let i = 0; i < 2000; i++) summing.handle(1);
console.log("2000 honest counts: " + quiet + " " + summing.sum);
hub.on("count", summing);

for (const event of ["text", "count", "chunk", "end"]) {
  for (const [label, payload] of payloads) {
    console.log(event + " gets " + label + ":");
    hub.send(event, payload);
  }
}
console.log("total " + text(total) + ", quiet " + text(quiet) + ", sum " + text(summing.sum) + ", " + JSON.stringify(summing));

console.log("honest again:");
total = 0;
hub.send("count", 1);
hub.send("text", "again");
//// an-override-narrows-its-parameter-to-a-dog-and-gets-a-cat.ts
////= Person-5

class Keeper {
  weigh(a: Animal): number {
    return a.name.length;
  }
  describe(a: Animal): string {
    return "an animal called " + a.name;
  }
  adopt(a: Animal): void {
    a.name = a.name + "!";
  }
  weighTwice(a: Animal): number {
    return this.weigh(a) + this.weigh(a);
  }
}

class DogKeeper extends Keeper {
  weigh(d: Dog): number {
    return d.legs * 10;
  }
  describe(d: Dog): string {
    return super.describe(d) + " with tag " + d.tag + " of " + d.owner.first;
  }
  adopt(d: Dog): void {
    super.adopt(d);
    d.tricks.push("stay");
  }
}

class PuppyKeeper extends DogKeeper {
  weigh(d: Dog): number {
    return super.weigh(d) / 4;
  }
}

const keepers: Keeper[] = [new Keeper(), new DogKeeper(), new PuppyKeeper()];
const animals: Animal[] = [new Dog("rex"), new Cat("tom"), new Animal("thing"), new Spider("boris")];

for (const keeper of keepers) {
  for (const animal of animals) {
    const label = keeper.constructor.name + " " + animal.constructor.name;
    show(label + " weigh", () => keeper.weigh(animal));
    show(label + " weighTwice", () => keeper.weighTwice(animal));
    show(label + " describe", () => keeper.describe(animal));
    show(label + " adopt", () => keeper.adopt(animal));
    show(label + " afterwards", () => animal);
  }
}

function weighWith(keeper: Keeper, animal: Animal): number {
  return keeper.weigh(animal);
}

let total = 0;
const dogKeeper = new DogKeeper();
const dog = new Dog("loop");
for (let i = 0; i < 2000; i++) total += weighWith(dogKeeper, dog);
show("2000 dogs", () => total);
show("then a cat", () => weighWith(dogKeeper, new Cat("late")));
show("then a spider", () => weighWith(dogKeeper, new Spider("late")));
show("then a dog", () => weighWith(dogKeeper, dog));
