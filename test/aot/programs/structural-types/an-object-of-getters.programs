//// an-object-with-the-members-of-a-generator-stands-for-a-generator.ts
////= text-14

type Numbers = Generator<number, string, number>;

class Pretender extends Iterator<number, string, number> {
  at = 0;
  heard: string[] = [];
  next(...sent: [] | [number]): IteratorResult<number, string> {
    this.heard.push("next " + sent.length + " " + text(sent[0]));
    this.at++;
    return this.at > 3 ? { done: true, value: "pretended end" } : { done: false, value: this.at * 100 };
  }
  return(value: string): IteratorResult<number, string> {
    this.heard.push("return " + text(value));
    this.at = 99;
    return { done: true, value: "pretended " + value };
  }
  throw(error: unknown): IteratorResult<number, string> {
    this.heard.push("throw " + text(error));
    return { done: false, value: -1 };
  }
  [Symbol.iterator](): this {
    this.heard.push("iterator");
    return this;
  }
}

function* real(): Numbers {
  let sum = 0;
  for (let i = 1; i <= 3; i++) sum += yield i * 100;
  return "real end " + sum;
}

function drain(g: Numbers): string {
  const out: string[] = [];
  let result = g.next(0);
  while (!result.done) {
    out.push(String(result.value));
    result = g.next(1);
  }
  return out.join() + " " + result.value + " " + result.value.length;
}

function closeIt(g: Numbers): string {
  g.next(0);
  return text(g.return("closed")) + " " + text(g.next(1));
}

function upset(g: Numbers): string {
  g.next(0);
  try {
    return text(g.throw("upset"));
  } catch (error) {
    return failure(error);
  }
}

function* through(g: Numbers): Numbers {
  const end: string = yield* g;
  return "through: " + end;
}

function looped(g: Generator<number, string, undefined | number>): number {
  let sum = 0;
  for (const n of g) sum += n;
  return sum;
}

class Shelf {
  kept: Numbers;
  all: Numbers[] = [];
  constructor(kept: Numbers) {
    this.kept = kept;
    this.all.push(kept);
  }
  step(): string {
    return text(this.kept.next(5)) + " " + text(this.all[0].next(6));
  }
}

const makers: [string, () => Numbers][] = [
  ["real", real],
  ["pretender", () => new Pretender()],
];

let warm = "";
for (let i = 0; i < 2000; i++) warm = drain(real());
console.log("2000 real ones: " + warm);

for (const [label, make] of makers) {
  console.log(label + ", drain: " + drain(make()));
  console.log(label + ", close: " + closeIt(make()));
  console.log(label + ", upset: " + upset(make()));
  console.log(label + ", through yield*: " + drain(through(make())));
  console.log(label + ", for-of: " + looped(make()));
  console.log(label + ", spread by way of an iterable: " + text(Array.from(make())));
  console.log(label + ", on a shelf: " + new Shelf(make()).step());
  console.log(label + ", helper: " + text(make().map(n => n + 1).toArray()));
  console.log(label + ", tag: " + Object.prototype.toString.call(make()));
  console.log(label + ", instanceof Iterator: " + (make() instanceof Iterator));
  console.log(label + ", keys: " + Object.keys(make()).join());
}

const watched = new Pretender();
const asGenerator: Numbers = watched;
drain(through(asGenerator));
console.log("heard: " + watched.heard.join(" | "));
console.log("real again: " + drain(real()));
//// an-object-with-the-members-of-a-promise-stands-for-a-promise.ts
////= text-4

type Fulfilled<T, A> = ((value: T) => A | PromiseLike<A>) | null;
type Rejected<B> = ((reason: unknown) => B | PromiseLike<B>) | null;

let asked: string[] = [];

class Pretend<T> implements Promise<T> {
  readonly [Symbol.toStringTag] = "Pretend";
  held: T;
  constructor(held: T) {
    this.held = held;
  }
  then<A = T, B = never>(onfulfilled?: Fulfilled<T, A>, onrejected?: Rejected<B>): Promise<A | B> {
    asked.push("then(" + typeof onfulfilled + ", " + typeof onrejected + ")");
    return new Promise<A | B>(resolve => {
      if (onfulfilled) resolve(onfulfilled(this.held));
    });
  }
  catch<B = never>(onrejected?: Rejected<B>): Promise<T | B> {
    asked.push("catch(" + typeof onrejected + ")");
    return Promise.resolve(this.held);
  }
  finally(onfinally?: (() => void) | null): Promise<T> {
    asked.push("finally(" + typeof onfinally + ")");
    onfinally?.();
    return Promise.resolve(this.held);
  }
}

////= lines-174	plusOne	p	Promise

function chained(p: Promise<number>): Promise<string> {
  return p.then(n => "got " + n);
}

function guarded(p: Promise<number>): Promise<number> {
  return p.catch(() => -1).finally(() => {});
}

function cleaned(p: Promise<number>): Promise<number> {
  return p.finally(() => {
    asked.push("cleanup");
  });
}

function make(real: boolean): Promise<number> {
  return real ? Promise.resolve(1) : new Pretend(1);
}

class Job {
  pending: Promise<number>;
  queue: Promise<number>[] = [];
  constructor(pending: Promise<number>) {
    this.pending = pending;
    this.queue.push(pending, pending);
  }
  async run(): Promise<number> {
    let sum = await this.pending;
    for (const p of this.queue) sum += await p;
    return sum;
  }
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += await plusOne(Promise.resolve(i & 1));
console.log("2000 real promises: " + warm);

for (const real of [true, false, true]) {
  const label = real ? "real" : "pretend";
  const uses: [string, (p: Promise<number>) => unknown][] = [
    ["awaited", plusOne],
    ["then", chained],
    ["catch and finally", guarded],
    ["finally", cleaned],
    ["in a field and a list", p => new Job(p).run()],
    ["captured", p => (async () => (await p) * 10)()],
    ["returned from an async function", p => (async (): Promise<number> => p)()],
    ["Promise.resolve gives it back", p => Promise.resolve(p) === p],
    ["instanceof Promise", p => p instanceof Promise],
    ["tag", p => Object.prototype.toString.call(p)],
    ["Promise.all", p => Promise.all([p, p])],
    ["Promise.race", p => Promise.race([p])],
    ["Promise.allSettled", p => Promise.allSettled([p])],
    ["Promise.any", p => Promise.any([p])],
    ["for await", async p => {
      let sum = 0;
      for await (const n of [p, p]) sum += n;
      return sum;
    }],
  ];
  for (const [name, use] of uses) {
    asked = [];
    console.log(label + ", " + name + ": " + text(await use(make(real))) + " [" + asked.join(", ") + "]");
  }
}

