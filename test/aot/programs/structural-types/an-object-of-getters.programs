    last += typeof friend + (friend === d ? " same " : " other ");
  };
  new Set(dogs).forEach(keep);
  return last;
});
show("dogs afterwards", () => dogs.map(d => d.legs));
//// an-optional-parameter-is-forgotten-and-comes-back-as-another-type.ts
////= Person-5

function visit(times: number, d?: Dog): string {
  if (d === undefined) return "nobody " + times;
  return d.tag + " " + (d.legs + times) + " " + d.owner.first;
}
function count(times: number, d?: Dog): number {
  return d === undefined ? times : d.legs * times;
}
function rename(times: number, d?: Dog): void {
  if (d !== undefined) d.tag = "renamed" + times;
}
function measure(times: number, unit?: string): number {
  return unit === undefined ? times : unit.length * times;
}

const visitShort: (times: number) => string = visit;
const visitCat: (times: number, c?: Cat) => string = visitShort;
const countShort: (times: number) => number = count;
const countCat: (times: number, c?: Cat) => number = countShort;
const countNumber: (times: number, n?: number) => number = countShort;
const renameShort: (times: number) => void = rename;
const renameCat: (times: number, c?: Cat) => void = renameShort;
const measureShort: (times: number) => number = measure;
const measureNumber: (times: number, unit?: number) => number = measureShort;
const measureList: (times: number, unit?: number[]) => number = measureShort;
const measureDog: (times: number, unit?: Dog) => number = measureShort;

const rex = new Dog("rex");
const tom = new Cat("tom");

show("honest visit", () => visit(1, rex));
show("honest visit of nobody", () => visit(1));
show("visit with a cat", () => visitCat(1, tom));
show("visit with no cat", () => visitCat(1));
show("honest count", () => count(2, rex));
show("count with a cat", () => countCat(2, tom));
show("count with a number", () => countNumber(2, 7));
show("count with zero", () => countNumber(2, 0));
show("rename a dog", () => rename(1, rex));
show("rename a cat", () => renameCat(2, tom));
show("the dog afterwards", () => rex);
show("the cat afterwards", () => tom);
show("honest measure", () => measure(2, "cm"));
show("measure with a number", () => measureNumber(2, 7));
show("measure with a list", () => measureList(2, [1, 2, 3]));
show("measure with a dog", () => measureDog(2, rex));

let sum = 0;
for (let i = 0; i < 2000; i++) sum += count(1, rex);
show("2000 honest counts", () => sum);
show("count with a cat after them", () => countCat(2, tom));
show("honest count again", () => count(2, rex));
//// an-optional-string-parameter-gets-the-index-from-a-built-in.ts
////= text-12

const log: string[] = [];

function note(s: string, suffix?: string): void {
  log.push(s + " " + typeof suffix + " " + (suffix === undefined ? "none" : suffix.length));
}
function upper(s: string, suffix?: string): string {
  return suffix === undefined ? s : s + suffix.toUpperCase();
}
function joined(s: string, suffix?: string): string {
  return s + (suffix ?? "");
}
function defaulted(s: string, suffix: string = "-") : string {
  return s + suffix + suffix.length;
}
function keepIf(s: string, suffix?: string): boolean {
  return suffix === undefined || suffix.length > 0;
}

const noteShort: (s: string) => void = note;
const upperShort: (s: string) => string = upper;
const joinedShort: (s: string) => string = joined;
const defaultedShort: (s: string) => string = defaulted;
const keepIfShort: (s: string) => boolean = keepIf;

const words = ["a", "b", "c"];

show("honest note", () => note("x", "yz"));
show("honest upper", () => upper("x", "yz"));
show("honest joined", () => joined("x", "yz"));
show("honest defaulted", () => defaulted("x", "yz"));
show("short call: upper", () => upperShort("x"));
show("short call: defaulted", () => defaultedShort("x"));

show("forEach note", () => words.forEach(noteShort));
show("map upper", () => words.map(upperShort));
show("map joined", () => words.map(joinedShort));
show("map defaulted", () => words.map(defaultedShort));
show("filter keepIf", () => words.filter(keepIfShort));
show("some keepIf", () => words.some(keepIfShort));
show("every keepIf", () => words.every(keepIfShort));
show("find keepIf", () => words.find(keepIfShort));
show("findIndex keepIf", () => words.findIndex(keepIfShort));
show("flatMap joined", () => words.flatMap(joinedShort));
show("Array.from joined", () => Array.from(words, joinedShort));
show("Array.from upper", () => Array.from(words, upperShort));
show("Array.from a set, joined", () => Array.from(new Set(words), joinedShort));
show("set forEach note", () => new Set(words).forEach(noteShort));
show("map forEach note", () => new Map([["k", "v"]]).forEach(noteShort));
show("replace joined", () => "abc".replace("b", joinedShort));
show("replace with a group, joined", () => "abc".replace(/(b)/, joinedShort));
show("replace upper", () => "abc".replace("b", upperShort));
show("replace with a group, upper", () => "abc".replace(/(b)/, upperShort));
show("replaceAll joined", () => "abcb".replaceAll("b", joinedShort));

for (const entry of log) console.log("log " + entry);

const results: string[] = [];
Promise.resolve("p")
  .then(joinedShort)
  .then(value => {
    results.push(value);
    return value;
  })
  .then(defaultedShort)
  .then(value => {
    results.push(value);
    console.log("then " + results.join());
  });
