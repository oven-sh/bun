class Keeper {
  text = "";
  flag = false;
  inner: Inner = { x: 0 };
  keep(w: Whole): this {
    this.text = w.text;
    this.flag = w.flag;
    this.inner = w.inner;
    return this;
  }
}

for (let i = 0; i < 2000; i++) {
