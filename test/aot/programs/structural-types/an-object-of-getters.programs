interface Draft {
  title: string;
  body?: string;
  pages?: number;
  done?: boolean;
}

function state(d: Draft): string {
  return Object.keys(d).join() + " " + JSON.stringify(d) + " " + [d.title, d.body, d.pages, d.done].join("/");
}

