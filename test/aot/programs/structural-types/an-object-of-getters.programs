//// an-optional-number-parameter-gets-an-array-or-a-string-from-a-built-in.ts
////= text-12

function scaled(n: number, index?: number, scale?: number): number {
  return n * (scale ?? 1);
}
function shifted(n: number, index?: number, shift?: number): number {
  return shift === undefined ? n : n + shift;
}
function kinds(n: number, index?: number, extra?: number): string {
  return typeof index + "/" + typeof extra;
}
function whole(n: number, index?: number, extra: number = 0): number {
  return (n + extra) | 0;
}
function add(sum: number, n: number, bonus?: number, factor?: number): number {
  return sum + n + (bonus ?? 0) * 1000 + (factor === undefined ? 0 : factor * 0);
}
function compare(a: number, b: number, bias?: number): number {
  return a - b + (bias ?? 0);
}
function offsetOf(match: string, offset?: boolean): string {
  return match + ":" + typeof offset + ":" + (offset ? "yes" : "no") + ":" + (offset === true);
}

const scaledShort: (n: number) => number = scaled;
const shiftedShort: (n: number) => number = shifted;
const kindsShort: (n: number) => string = kinds;
const wholeShort: (n: number) => number = whole;
const addShort: (sum: number, n: number) => number = add;
const compareShort: (a: number, b: number) => number = compare;
const offsetShort: (match: string) => string = offsetOf;

const numbers = [3, 1, 2];

show("honest scaled", () => scaled(2, 0, 10));
show("honest shifted", () => shifted(2, 0, 10));
show("honest whole", () => whole(2, 0, 10));
show("honest add", () => add(1, 2, 3, 4));
show("map scaled", () => numbers.map(scaledShort));
show("map shifted", () => numbers.map(shiftedShort));
show("map kinds", () => numbers.map(kindsShort));
show("map whole", () => numbers.map(wholeShort));
show("typed array map scaled", () => Array.from(new Float64Array(numbers).map(scaledShort)));
show("typed array map shifted", () => Array.from(new Float64Array(numbers).map(shiftedShort)));
show("Array.from kinds", () => Array.from(numbers, kindsShort));
show("Array.from shifted", () => Array.from(numbers, shiftedShort));
show("reduce add", () => numbers.reduce(addShort, 0));
show("reduce add without a start", () => numbers.reduce(addShort));
show("reduceRight add", () => numbers.reduceRight(addShort, 0));
show("sort compare", () => [...numbers].sort(compareShort));
show("toSorted compare", () => numbers.toSorted(compareShort));
show("replace offset", () => "abc".replace("a", offsetShort));
show("replace offset further on", () => "abc".replace("c", offsetShort));
show("replace offset with a group", () => "abc".replace(/(c)/, offsetShort));

let total = 0;
for (let i = 0; i < 2000; i++) total += shifted(i, i, 1);
show("2000 honest calls", () => total);
show("map shifted after them", () => numbers.map(shiftedShort));
show("honest shifted again", () => shifted(2, 0, 10));
//// an-optional-object-parameter-gets-the-index-from-a-built-in.ts
////= Person-5

function legsWith(d: Dog, friend?: Dog): number {
  return friend === undefined ? d.legs : d.legs + friend.legs;
}
function tagWith(d: Dog, friend?: Dog): string {
  return friend ? d.tag + "+" + friend.tag : d.tag;
}
function ownerWith(d: Dog, friend?: Dog): string {
  return d.owner.first + "+" + (friend === undefined ? "nobody" : friend.owner.first);
}
function barkWith(d: Dog, friend?: Dog): string {
  return friend === undefined ? d.bark() : friend.bark();
}
function chained(d: Dog, friend?: Dog): string {
  return typeof friend + " " + friend?.legs + " " + friend?.owner?.first;
}
function callWith(d: Dog, after?: () => string): string {
  return after === undefined ? d.name : d.name + after();
}
function listWith(d: Dog, more?: string[]): number {
  return d.tricks.length + (more === undefined ? 0 : more.length);
}
function storeWith(d: Dog, friend?: Dog): number {
  if (friend !== undefined) friend.legs = 1;
  return d.legs;
}

const legsShort: (d: Dog) => number = legsWith;
const tagShort: (d: Dog) => string = tagWith;
const ownerShort: (d: Dog) => string = ownerWith;
const barkShort: (d: Dog) => string = barkWith;
const chainedShort: (d: Dog) => string = chained;
const callShort: (d: Dog) => string = callWith;
const listShort: (d: Dog) => number = listWith;
const storeShort: (d: Dog) => number = storeWith;

const dogs = [new Dog("rex"), new Dog("fido"), new Dog("spot")];

show("honest legs", () => legsWith(dogs[0], dogs[1]));
show("honest tag", () => tagWith(dogs[0], dogs[1]));
show("honest owner", () => ownerWith(dogs[0], dogs[1]));
show("honest bark", () => barkWith(dogs[0], dogs[1]));
show("honest call", () => callWith(dogs[0], () => "!"));
show("honest list", () => listWith(dogs[0], ["x"]));
show("short legs", () => legsShort(dogs[0]));

show("map legs", () => dogs.map(legsShort));
show("map tag", () => dogs.map(tagShort));
show("map owner", () => dogs.map(ownerShort));
show("map bark", () => dogs.map(barkShort));
show("map chained", () => dogs.map(chainedShort));
show("map call", () => dogs.map(callShort));
show("map list", () => dogs.map(listShort));
show("map store", () => dogs.map(storeShort));
show("set forEach: the friend is the dog itself", () => {
  const out: string[] = [];
  new Set(dogs).forEach((d: Dog) => out.push(tagShort(d)));
  new Set(dogs).forEach(d => out.push(String(legsShort(d))));
  return out;
});
show("set forEach handed the function", () => {
  let last = "";
