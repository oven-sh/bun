//// an-own-member-covers-a-method-after-2000-calls-at-every-site.ts
////= Point-6

////= Holder-5

////= byParameter

function byElement(list: Point[], index: number): number {
  return list[index].norm();
}

const target = new Point(3, 4);
const other = new Point(1, 2);
const holder = new Holder(target);
const list = [other, target];
const captured = (): number => target.norm();

function round(): number {
  const local = target;
  return target.norm() + local.norm() + byParameter(target) + holder.ask() + byElement(list, 1) + captured();
}

function honestRound(): number {
  return other.norm() + byParameter(other) + byElement(list, 0);
}

function warm(label: string): void {
  let sum = 0;
  for (let i = 0; i < 2000; i++) sum += round() + honestRound();
  console.log(label + ": 2000 rounds " + sum + ", one round " + round() + ", an honest round " + honestRound());
}

warm("the method");

target.norm = () => 1;
warm("an own arrow");

target.norm = function () {
  return this.y;
};
warm("an own function");

const view: { norm?: () => number } = target;
delete view.norm;
warm("uncovered");

let flips = "";
for (let i = 0; i < 8; i++) {
  if (i % 2 === 0) target.norm = () => i;
  else delete view.norm;
  flips += round() + " ";
}
console.log("covered and uncovered in turn: " + flips);
warm("at the end");

export {};
//// an-own-member-covers-a-method-in-every-place.ts
////= Point-6

////= Holder-5

////= byParameter

function byLocal(make: () => Point): number {
  const local = make();
  return local.norm();
}

////= lines-258	byElement	list	Point	number	norm

function capture(p: Point): () => number {
  return () => p.norm();
}

const changed = new Point(3, 4);
const honest = new Point(1, 2);
const changedHolder = new Holder(changed);
const honestHolder = new Holder(honest);
const changedList = [changed];
const honestList = [honest];
const changedCapture = capture(changed);
const honestCapture = capture(honest);

function everywhere(label: string): void {
  console.log(label + ", the changed one, directly: " + changed.norm());
  console.log(label + ", the changed one, a parameter: " + byParameter(changed));
  console.log(label + ", the changed one, a local: " + byLocal(() => changed));
  console.log(label + ", the changed one, a field: " + changedHolder.ask());
  console.log(label + ", the changed one, an element: " + byElement(changedList));
  console.log(label + ", the changed one, captured: " + changedCapture());
  console.log(label + ", the honest one: " + [honest.norm(), byParameter(honest), byLocal(() => honest), honestHolder.ask(), byElement(honestList), honestCapture()].join(" "));
  console.log(label + ", own " + Object.hasOwn(changed, "norm") + ", keys " + Object.keys(changed).join() + ", json " + JSON.stringify(changed));
}

everywhere("before");

changed.norm = () => 5;
everywhere("an arrow");

changed.norm = function () {
  return this.x + 1000;
};
everywhere("a function that reads this");

const view: { norm?: () => number } = changed;
delete view.norm;
everywhere("uncovered");

changed.norm = Point.prototype.norm;
everywhere("the method itself as an own member");

changed.x = 10;
everywhere("after a store to x");

delete view.norm;
everywhere("uncovered again");

