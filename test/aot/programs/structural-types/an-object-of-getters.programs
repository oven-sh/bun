const narrow: { a: number; b?: never } = { a: 4 };
const alias: { a: number; b?: unknown } = narrow;
alias.b = "both";
wide.b = "unused";
console.log(which(narrow));
console.log(Object.keys(narrow).join(), String(narrow.b), typeof narrow.b);
