//// built-in-objects-with-members-of-their-own-are-used-through-interfaces-that-extend-their-types.ts
// Maps, sets, errors, dates, regular expressions and promises that a cast gave members of their own are used through interfaces that extend the built-in type. An interface that extends Iterable takes a Set and an instance of a class of the program.
interface MultiMap<K, V> extends Map<K, V[]> { add(key: K, value: V): V[]; count: number }
interface Tagged extends Set<string> { tag: string }
interface Coded extends Error { code: string }
type WithStatus = Error & { status: number };
interface Cancelable<T> extends Promise<T> { cancel(): void; canceled: boolean }
interface Stamp extends Date { zone: string }
interface Named extends RegExp { title: string }
interface Lookup extends ReadonlyMap<string, number> { fallback: number }
interface Bag extends Iterable<number> { size: number }
function add<K, V>(this: MultiMap<K, V>, key: K, value: V) { this.count++; let values = this.get(key); if (values) values.push(value); else this.set(key, values = [value]); return values; }
function createMultiMap<K, V>(): MultiMap<K, V> { const map = new Map<K, V[]>() as MultiMap<K, V>; map.add = add; map.count = 0; return map; }
function entries(m: MultiMap<string, number>): number { let n = m.size + m.count; for (const [k, v] of m) n += k.length + v.length; m.forEach(v => { n += v.length; }); return n + [...m.keys()].length; }
function tagged(s: Tagged): string { let t = s.tag; for (const x of s) t += x; return t + s.size + s.has("a"); }
function coded(e: Coded): string { return e.code + e.message + (e instanceof Error) + e.name; }
function status(e: WithStatus): string { return e.status + e.message; }
function stamp(d: Stamp): string { return d.zone + d.getTime(); }
function named(r: Named): string { return r.title + r.test("abc") + r.source; }
function lookup(l: Lookup, k: string): number { return l.get(k) ?? l.fallback; }
function bag(b: Bag): number { let n = b.size; for (const x of b) n += x; return n; }
class OwnBag implements Bag { size = 2; *[Symbol.iterator]() { yield 1; yield 2; } }
async function cancelable(p: Cancelable<number>): Promise<number> { p.cancel(); return (await p) + (p.canceled ? 1 : 0); }
let n = 0, t = "";
const m = createMultiMap<string, number>();
for (let i = 0; i < 100; i++) {
  m.add("k" + (i % 3), i); n += entries(m);
  const s = new Set(["a", "b"]) as Tagged; s.tag = "t"; t = tagged(s);
  const e = new Error("m") as Coded; e.code = "E"; t += coded(e);
  const w = Object.assign(new TypeError("w"), { status: 4 }); t += status(w);
  const d = new Date(5) as Stamp; d.zone = "z"; t += stamp(d);
  const r = /b/ as Named; r.title = "r"; t += named(r);
  const l = new Map([["a", 1]]) as Map<string, number> & { fallback: number }; l.fallback = 9; n += lookup(l, "a") + lookup(l, "b");
  const b = new Set([1, 2]); n += bag(b) + bag(new OwnBag());
}
const p = Promise.resolve(3) as Cancelable<number>; p.canceled = false; p.cancel = function (this: Cancelable<number>) { this.canceled = true; };
console.log(n, t, await cancelable(p));
//// built-ins-call-functions-that-take-an-int32.ts
import type { int32 } from "bun";

////= show-34

let warm = 0;
for (let i = 0; i < 2000; i++) warm += uses(i | 0).length + uses(-i | 0).length;
console.log("4000 honest uses", warm);

const odd: number[] = JSON.parse("[1.5, -0, 2147483648, -2147483649, 1e21, 3]");
odd.push(NaN, Infinity);

const seen: unknown[][] = [];
function note(v: int32): int32 {
  seen.push(uses(v));
  return v;
}
function plus(sum: int32, v: int32): int32 {
  return (sum + v) | 0;
}
function plainPlus(sum: int32, v: int32): number {
  return sum + v;
}
function order(a: int32, b: int32): int32 {
  return a < b ? -1 : a > b ? 1 : 0;
}
function small(v: int32): boolean {
  return v < 2;
}
function drain(): unknown[][] {
  return seen.splice(0);
}

const few: number[] = [1.5, -0, 2 ** 31];
attempt("map", () => [few.map(note), drain()]);
attempt("forEach", () => [few.forEach(note), drain()]);
attempt("reduce", () => [few.reduce(plus, 0), few.reduce(plainPlus, 0), few.reduce(plainPlus)]);
attempt("reduceRight", () => few.reduceRight(plainPlus, 0));
attempt("sort", () => [2.5, 2.25, -0, 0, NaN, 2 ** 31].sort(order));
attempt("toSorted", () => [2.5, 2.25, 2 ** 32, 1e21].toSorted(order));
attempt("filter, find, some, every", () => [few.filter(small), few.find(small), few.findIndex(small), few.findLast(small), few.some(small), few.every(small)]);
attempt("Array.from", () => [Array.from(few, note), drain()]);
attempt("a float array", () => [Array.from(new Float64Array(few).map(note)), drain()]);
attempt("the values of a map", () => {
  new Map([["a", 0.25]]).forEach(note);
  return drain();
});
attempt("the values of a set", () => {
  new Set([0.75]).forEach(note);
  return drain();
});
attempt("flatMap", () => [few.flatMap(note), drain()]);
await Promise.resolve(3.5).then(note);
attempt("a promise", () => drain());
await new Promise<void>(resolve => {
  setTimeout(
    (v: int32) => {
      note(v);
      resolve();
    },
    0,
    4.5,
  );
});
attempt("a timer", () => drain());
attempt("honest again", () => [[1, 2].map(note), drain()]);
//// built-ins-make-arrays-of-int32-out-of-fractions.ts
import type { int32 } from "bun";

////= show-34

let warm = 0;
for (let i = 0; i < 2000; i++) warm += uses(i | 0).length + uses(-i | 0).length;
console.log("4000 honest uses", warm);

const odd: number[] = JSON.parse("[1.5, -0, 2147483648, -2147483649, 1e21, 3]");
odd.push(NaN, Infinity);

////= lines-154	head	list	int32	int32	list[0

const makers: [string, () => int32[]][] = [
  ["map", () => [3, 5].map(v => v / 2)],
  ["Array.from with a function", () => Array.from({ length: 2 }, (_, i) => (i + 1) / 2)],
  ["Array.from a float array", () => Array.from(new Float64Array([1.5, 2.5]))],
  ["a float array is spread", () => [...new Float64Array([-0, 2.5])]],
  ["Array.of", () => Array.of(2 ** 31, 1)],
  ["flatMap", () => [1].flatMap(v => [v / 4, v])],
  ["Object.values", () => Object.values({ a: NaN, b: 1 })],
  ["the values of a map", () => [...new Map([["a", 1e21]]).values()]],
  ["a set is spread", () => [...new Set([0.25])]],
  ["filter", () => [0.75, 1].filter(v => v < 1)],
  ["slice", () => [2.5, 1].slice(0, 1)],
  ["toSorted", () => [3, 0.125].toSorted((a, b) => a - b)],
  ["a clone", () => structuredClone([Infinity])],
  ["parsed", () => JSON.parse("[6.5]")],
  ["split and converted", () => "7.5,8".split(",").map(Number)],
  ["Array.from a length alone", () => Array.from<int32>({ length: 2 })],
];

for (const [label, make] of makers) {
  attempt(label, () => {
    const list = make();
    const v: int32 = head(list);
    return [list, uses(v)];
  });
}
//// built-ins-over-arrays-of-numbers-with-holes.ts
////= show-31

let warm = 0;
////= for-3
console.log("after 4000 dense arrays", warm);

function holey(): number[] {
  const numbers = new Array<number>(4);
  numbers[0] = 3;
  numbers[2] = 1;
  return numbers;
}

function allHoles(): number[] {
  return new Array<number>(2);
}

const uses: [string, (numbers: number[]) => unknown][] = [
  ["Math.max", numbers => Math.max(...numbers)],
  ["Math.min.apply", numbers => Math.min.apply(null, numbers)],
  ["reduce", numbers => numbers.reduce((total, number) => total + number, 0)],
  ["reduce without a start", numbers => numbers.reduce((total, number) => total + number)],
  ["reduceRight", numbers => numbers.reduceRight((total, number) => total + number, 0)],
  ["visits of forEach", numbers => {
    const seen: number[] = [];
    numbers.forEach((_, index) => seen.push(index));
    return seen;
  }],
  ["map", numbers => inspect(numbers.map(number => number + 1))],
  ["filter", numbers => inspect(numbers.filter(() => true))],
  ["some undefined", numbers => numbers.some(number => number === undefined)],
  ["every number", numbers => numbers.every(number => typeof number === "number")],
  ["find undefined", numbers => numbers.findIndex(number => number === undefined)],
  ["findLast", numbers => numbers.findLastIndex(number => number === undefined)],
  ["sort", numbers => inspect(numbers.sort())],
  ["sort with a comparator", numbers => inspect(numbers.sort((a, b) => a - b))],
  ["toSorted", numbers => inspect(numbers.toSorted((a, b) => a - b))],
  ["reverse", numbers => inspect(numbers.reverse())],
  ["toReversed", numbers => inspect(numbers.toReversed())],
  ["with", numbers => inspect(numbers.with(0, 9))],
  ["toSpliced", numbers => inspect(numbers.toSpliced(0, 1))],
  ["join", numbers => numbers.join("-")],
  ["toString", numbers => String(numbers)],
  ["flat", numbers => inspect(numbers.flat())],
  ["flatMap", numbers => inspect(numbers.flatMap(number => [number]))],
  ["concat", numbers => inspect(numbers.concat(numbers))],
  ["slice", numbers => inspect(numbers.slice(1, 3))],
  ["indexOf NaN", numbers => [numbers.indexOf(NaN), numbers.includes(NaN)]],
  ["entries", numbers => [...numbers.entries()].map(([index, number]) => index + ":" + number)],
  ["keys", numbers => [...numbers.keys()]],
  ["values", numbers => inspect([...numbers.values()])],
  ["Object.entries", numbers => Object.entries(numbers).map(([key, number]) => key + ":" + number)],
  ["Object.values", numbers => inspect(Object.values(numbers))],
  ["for-in", numbers => {
    const names: string[] = [];
    for (const name in numbers) names.push(name);
    return names;
  }],
  ["Array.from", numbers => inspect(Array.from(numbers))],
  ["spread", numbers => inspect([...numbers])],
  ["structuredClone", numbers => inspect(structuredClone(numbers))],
  ["JSON and back", numbers => JSON.stringify(numbers)],
  ["a Float64Array", numbers => Array.from(new Float64Array(numbers))],
  ["an Int32Array", numbers => Array.from(new Int32Array(numbers))],
  ["a set", numbers => [...new Set(numbers)].length],
  ["at", numbers => [numbers.at(1), numbers.at(-1)]],
  ["pop", numbers => [numbers.pop(), numbers.length]],
  ["shift", numbers => [numbers.shift(), inspect(numbers)]],
  ["fill", numbers => inspect(numbers.fill(0, 1, 2))],
  ["lastIndexOf", numbers => numbers.lastIndexOf(1)],
  ["Object.groupBy", numbers => Object.keys(Object.groupBy(numbers, number => typeof number))],
];

for (const [name, use] of uses) {
  for (let i = 0; i < 100; i++) use([3, 2, 1, i]);
  attempt(name + ": dense", () => use([3, 2, 1, 0]));
  attempt(name + ": with holes", () => use(holey()));
  attempt(name + ": only holes", () => use(allHoles()));
}
//// built-ins-store-values-of-another-type-into-typed-places.ts
////= show-4

const log: string[] = [];

////= attempt-2

class Dog {
  legs = 4;
  name = "rex";
  toys: number[] = [1, 2];
  friend: Dog | null = null;
  speak: () => number = () => 1;
  bark(): number {
    return this.legs * 2;
  }
  title(): string {
    return this.name.toUpperCase();
  }
  count(): number {
    let sum = 0;
    for (const toy of this.toys) sum += toy;
    return sum;
  }
  say(): number {
    return this.speak() + 1;
  }
}

function read(d: Dog): unknown[] {
  const results: unknown[] = [];
  for (const use of [() => d.legs + 1, () => d.bark(), () => d.title(), () => d.count(), () => d.say(), () => Object.keys(d).join()]) {
    try {
      results.push(use());
    } catch (error) {
      results.push(error instanceof Error ? error.constructor.name : "other");
    }
  }
  return results;
}

attempt("honest", () => read(new Dog()));
let warm = 0;
for (let i = 0; i < 2000; i++) {
  const d = new Dog();
  d.legs = i;
  warm += d.bark() + d.title().length + d.count() + d.say();
}
console.log("2000 honest rounds", warm);

const wrong = { legs: "many", name: 7, toys: "12", speak: null };

const writers: [string, (d: Dog) => void][] = [
  ["Reflect.set", d => { for (const [key, value] of Object.entries(wrong)) Reflect.set(d, key, value); }],
  ["Object.assign", d => { Object.assign(d, wrong); }],
  ["Object.defineProperty with values", d => { for (const [key, value] of Object.entries(wrong)) Object.defineProperty(d, key, { value, writable: true, enumerable: true, configurable: true }); }],
  ["Object.defineProperty with getters", d => { for (const [key, value] of Object.entries(wrong)) Object.defineProperty(d, key, { get: () => (log.push("get-" + key), value), enumerable: true, configurable: true }); }],
  ["Object.defineProperties", d => { Object.defineProperties(d, { legs: { value: "many" }, name: { value: 7 } }); }],
  ["Reflect.defineProperty", d => { Reflect.defineProperty(d, "legs", { value: null }); }],
  ["Reflect.deleteProperty", d => { for (const key of Object.keys(wrong)) Reflect.deleteProperty(d, key); }],
  ["Object.setPrototypeOf to a literal", d => { Object.setPrototypeOf(d, { bark: () => "other bark", title: () => 5, count: () => null, say: () => undefined }); }],
  ["Object.setPrototypeOf to null", d => { Object.setPrototypeOf(d, null); }],
  ["Reflect.setPrototypeOf", d => { Reflect.setPrototypeOf(d, Array.prototype); }],
  ["Object.freeze, then typed stores", d => { Object.freeze(d); }],
  ["an own member over the method", d => { Object.assign(d, { bark: () => "own bark" }); }],
  ["a copy from entries", d => { Object.assign(d, Object.fromEntries(Object.entries(wrong))); }],
];

for (const [name, write] of writers) {
  attempt(name, () => {
    const d = new Dog();
    write(d);
    return read(d);
  });
  attempt(name + ", after honest uses of the same dog", () => {
    const d = new Dog();
    let sum = 0;
    for (let i = 0; i < 100; i++) sum += d.bark() + d.count();
    write(d);
    return [sum, ...read(d)];
  });
  attempt(name + ", then a typed store", () => {
    const d = new Dog();
    write(d);
    d.legs = 8;
    d.name = "again";
    return read(d);
  });
}

attempt("elements: Reflect.set", () => {
  const list = [1, 2, 3];
  Reflect.set(list, 1, "two");
  Reflect.set(list, "length", 2);
  return [list, list.map(n => n + 1)];
});
attempt("elements: Object.assign", () => {
  const list = [1, 2, 3];
  Object.assign(list, ["a", "b"]);
  return [list, list.reduce((a, b) => a + b, 0)];
});
attempt("elements: Object.defineProperty", () => {
  const list = [1, 2, 3];
  Object.defineProperty(list, 0, { get: () => (log.push("get-0"), "zero") });
  return [list[0], list[0] + 1, list.length];
});
attempt("a literal", () => {
  const p = { x: 1, y: 2 };
  Reflect.set(p, "x", "one");
  Object.assign(p, { y: null });
  return [p.x + 1, p.y + 1, JSON.stringify(p)];
});
attempt("a captured literal", () => {
  const p = { n: 1 };
  const next = () => p.n + 1;
  const before = next();
  Reflect.set(p, "n", "text");
  return [before, next()];
});
attempt("honest again", () => read(new Dog()));
