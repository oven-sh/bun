//// arrays-that-only-ever-held-integers-get-fractions-through-generic-functions.ts
////= show-32

function put<T>(list: T[], index: number, item: T): void {
  list[index] = item;
}

function add<T>(list: T[], ...items: T[]): number {
  return list.push(...items);
}

function replaceAll<T>(list: T[], item: T): void {
  for (let i = 0; i < list.length; i++) list[i] = item;
}

////= sum

function bits(numbers: number[]): number {
  let all = 0;
  for (let i = 0; i < numbers.length; i++) all |= numbers[i];
  return all;
}

function signs(numbers: number[]): string {
  let text = "";
  for (let i = 0; i < numbers.length; i++) text += 1 / numbers[i] < 0 ? "-" : "+";
  return text;
}

function report(title: string, numbers: number[]): void {
  console.log(title + ": " + show(numbers));
  attempt("  sum", () => sum(numbers));
  attempt("  bits", () => bits(numbers));
  attempt("  signs", () => signs(numbers));
  attempt("  JSON", () => JSON.stringify(numbers));
  attempt("  sorted", () => numbers.toSorted((a, b) => a - b));
  attempt("  index of the second", () => numbers.indexOf(numbers[1]));
  attempt("  includes the second", () => numbers.includes(numbers[1]));
}

let total = 0;
for (let i = 0; i < 2000; i++) {
  const numbers = [i, 1, 2];
  put(numbers, 1, i);
  add(numbers, 3);
  total += sum(numbers) + bits(numbers);
}
console.log("2000 rounds with integers: " + total);

for (const value of [0.5, 2 ** 31, -(2 ** 31) - 1, -0, NaN, Infinity, 2 ** 53, 5e-324]) {
  const stored = [1, 2, 3];
  put(stored, 1, value);
  report("stored " + show(value), stored);
  const pushed = [1];
  add(pushed, value, 3);
  report("pushed " + show(value), pushed);
}

const all = [1, 2, 3];
replaceAll(all, 0.25);
report("every one is replaced by a quarter", all);
replaceAll(all, 4);
report("and by an integer again", all);

const tuple: [number, number] = [1, 2];
put(tuple, 0, 0.5);
console.log("a tuple of two integers: " + show(tuple) + " " + (tuple[0] + tuple[1]) + " " + (tuple[0] | tuple[1]));

const grown: number[] = [];
for (let i = 0; i < 10; i++) add(grown, i);
add(grown, 10.5);
for (let i = 11; i < 20; i++) add(grown, i);
report("twenty numbers, the eleventh is a fraction", grown);

const computed = [1, 2, 3];
for (let i = 0; i < computed.length; i++) put(computed, i, computed[i] / 2);
report("each is halved in place", computed);
const scaled = [1, 2, 3];
for (let i = 0; i < scaled.length; i++) put(scaled, i, scaled[i] * 1e9);
report("each is multiplied past 32 bits in place", scaled);

export {};
//// arrays-tuples-and-records-of-int32-are-written-with-numbers-in-them.ts
import type { int32 } from "bun";

////= show-34

let warm = 0;
for (let i = 0; i < 2000; i++) warm += uses(i | 0).length + uses(-i | 0).length;
console.log("4000 honest uses", warm);

const odd: number[] = JSON.parse("[1.5, -0, 2147483648, -2147483649, 1e21, 3]");
odd.push(NaN, Infinity);

interface Row {
  cells: int32[];
  ends: [int32, int32];
  named: Record<string, int32>;
}

function firstCell(row: Row): int32 {
  return row.cells[0];
}
function width(row: Row): int32 {
  return (row.ends[1] - row.ends[0]) | 0;
}
function plainWidth(row: Row): number {
  return row.ends[1] - row.ends[0];
}
function named(row: Row, name: string): int32 {
  return row.named[name];
}

for (const n of odd) {
  const label = show(n);
  attempt(label + " in an array", () => {
    const list: int32[] = [n];
    const v: int32 = list[0];
    return uses(v);
  });
  attempt(label + " in a tuple", () => {
    const pair: [int32, int32] = [n, 1];
    const v: int32 = pair[0];
    return uses(v);
  });
  attempt(label + " in a record", () => {
    const record: Record<string, int32> = { a: n };
    const v: int32 = record.a;
    return uses(v);
  });
  attempt(label + " in a row", () => {
    const row: Row = { cells: [n, 2], ends: [1, n], named: { key: n } };
    return [firstCell(row), width(row), plainWidth(row), named(row, "key"), named(row, "none"), JSON.stringify(row)];
  });
  attempt(label + " spread", () => {
    const list: int32[] = [...[n], ...[2]];
    const v: int32 = list[0];
    return uses(v);
  });
}
//// arrow-function-fields-of-a-copy-still-see-the-source.ts
////= show-30

class Counter {
  count = 0;
  step = 2;
  bump = (): number => {
    this.count += this.step;
    return this.count;
  };
  read = (): number => this.count;
  method(): number {
    this.count += this.step;
    return this.count;
  }
}

////= lines-19	bump	counter	Counter	number	counter.bump

////= lines-19	read	counter	Counter	number	counter.read

////= lines-20	field	counter	Counter	number	return	counter.count

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = new Counter();
  warm += bump(honest) + read(honest) + field(honest) + honest.method();
}
console.log("after 2000 honest counters", warm);

function withPrototype(source: Counter): Counter {
  return Object.assign(Object.create(Counter.prototype), source);
}
////= lines-36	child	source	Counter	Counter	Object.create	source

const makers: [string, (source: Counter) => Counter][] = [
  ["the counter itself", source => source],
  ["an assigned copy", source => Object.assign({}, source)],
  ["a copy with the prototype", withPrototype],
  ["a child", child],
  ["a proxy", source => new Proxy(source, {})],
  ["a proxy that logs nothing but answers 100 for count", source => new Proxy(source, { get: (target, key, receiver) => (key === "count" ? 100 : Reflect.get(target, key, receiver)) })],
];
for (const [name, make] of makers) {
  attempt(name + ": the arrow function bumps", () => {
    const source = new Counter();
    const made = make(source);
    return [bump(made), bump(made), field(made), read(made), field(source)];
  });
  attempt(name + ": a store to the copy's step", () => {
    const source = new Counter();
    const made = make(source);
    made.step = 10;
    return [bump(made), field(made), field(source), source.step];
  });
  attempt(name + ": the method bumps", () => {
    const source = new Counter();
    const made = make(source);
    return [made.method(), field(made), read(made), field(source)];
  });
  attempt(name + ": the functions are the same", () => {
    const source = new Counter();
    return [make(source).bump === source.bump, Object.hasOwn(make(source), "bump")];
  });
}
attempt("a clone refuses the functions", () => structuredClone(new Counter()));
attempt("text drops the functions", () => {
  const parsed: Counter = JSON.parse(JSON.stringify(new Counter()));
  return [Object.keys(parsed), typeof parsed.bump];
});
attempt("text drops the functions, called", () => {
  const parsed: Counter = JSON.parse(JSON.stringify(new Counter()));
  return bump(parsed);
});
attempt("an arrow function taken off and called", () => {
  const source = new Counter();
  const { bump: taken } = source;
  return [taken(), taken.call(new Counter()), field(source)];
});
//// arrow-functions-in-fields-are-own-members-with-an-identity.ts
////= attempt-7

interface Clickable {
  id: number;
  onClick: () => number;
}

let made = 0;

class Button {
  id: number;
  onClick = (): number => this.id * 10;
  order = ++made;
  onHover = (): string => "hover " + this.id;
  constructor(id: number) {
    this.id = id;
  }
}

const a = new Button(1);
const b = new Button(2);

console.log("the same function each time it is read: " + (a.onClick === a.onClick));
console.log("another one for each instance: " + (a.onClick === b.onClick));
console.log("keys before any call: " + Object.keys(new Button(3)).join());
console.log("own: " + Object.hasOwn(a, "onClick") + " on the prototype: " + ("onClick" in Button.prototype));
console.log("name and length: " + a.onClick.name + " " + a.onClick.length + " " + typeof a.onClick);
console.log("json leaves them out: " + JSON.stringify(a));
console.log("values: " + Object.values(a).map(v => typeof v).join());
console.log("entries: " + Object.entries(a).map(([key, value]) => key + ":" + typeof value).join());

const copy = { ...a };
console.log("a copy has the very same function: " + (copy.onClick === a.onClick) + " " + Object.keys(copy).join());
copy.id = 100;
console.log("which still sees the first object: " + copy.onClick() + " " + a.onClick());

const taken = a.onClick;
a.id = 5;
console.log("taken off, it follows its object: " + taken() + " " + taken.call(b) + " " + taken.bind(b)());

const notes = new WeakMap<object, string>();
notes.set(a.onClick, "noted");
console.log("as a weak key: " + notes.get(a.onClick) + " " + notes.get(b.onClick));
const set = new Set([a.onClick, a.onClick, b.onClick, a.onHover]);
console.log("in a set: " + set.size);

////= lines-19	click	c	Clickable	number	c.onClick

