function kinds(list: unknown[]): string {
  return list.map(v => (Array.isArray(v) ? "array(" + v.length + ")" : v instanceof Object ? Object.prototype.toString.call(v) : typeof v + " " + String(v))).join(", ");
}

const texts = ["1", "", "x", "2.5"];
const numbers = [0, 1, 2.5, NaN];

