//// boolean-and-bigint-literal-members-are-stored-over.ts
////= show-35

interface Done {
  done: true;
  count: 1n;
  zero: 0;
  empty: "";
}

////= lines-20	isDone	state	Done	true	return	state.done
////= lines-219	doneText	state	Done	state.done	"done"	"not done"
////= lines-20	countOf	state	Done	1n	return	state.count
////= lines-116	countIsOne	state	Done	state.count	1n
////= lines-219	zeroText	state	Done	state.zero	"not zero"	"zero"
function emptyText(state: Done): string {
  return state.empty || "empty";
}
function look(state: Done): unknown[] {
  return [isDone(state), doneText(state), !state.done, countOf(state), countIsOne(state), state.count + 1n, state.zero, zeroText(state), state.zero + 1, state.empty, emptyText(state), state.empty.length, JSON.stringify({ ...state, count: String(state.count) })];
}
function make(): Done {
  return { done: true, count: 1n, zero: 0, empty: "" };
}

class Task implements Done {
  done: true = true;
  count: 1n = 1n;
  zero: 0 = 0;
  empty: "" = "";
}

interface Wide {
  done: boolean;
  count: bigint;
  zero: number;
  empty: string;
}
function overwrite(wide: Wide): void {
  wide.done = false;
  wide.count = -(2n ** 64n);
  wide.zero = 0.5;
  wide.empty = "full";
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += look(i % 2 ? make() : new Task()).length;
console.log("2000 honest rounds", warm);

attempt("a literal before", () => look(make()));
attempt("a literal after", () => {
  const state = make();
  overwrite(state);
  return look(state);
});
attempt("an instance before", () => look(new Task()));
attempt("an instance after", () => {
  const task = new Task();
  overwrite(task);
  return look(task);
});
attempt("elements", () => {
  const yes: true[] = [true, true];
  const wide: boolean[] = yes;
  wide[1] = false;
  const ones: 1n[] = [1n];
  const wideOnes: bigint[] = ones;
  wideOnes.push(0n);
  return [yes, yes.every(flag => flag), yes.map(flag => (flag ? 1 : 0)), ones, ones.map(one => one === 1n), ones.map(one => (one ? "truthy" : "falsy"))];
});
attempt("negative zero for zero", () => {
  const state = make();
  const wide: Wide = state;
  wide.zero = -0;
  return [state.zero, 1 / state.zero, state.zero === 0, Object.is(state.zero, 0), zeroText(state)];
});
//// booleans-bigints-and-symbols-under-object-types.ts
////= show-30

type Localized = { toLocaleString(): string };
type Comparable = { valueOf(): unknown; toString(): string };

class Holder<T extends {}> {
  history: T[] = [];
  constructor(public current: T) {}
  put(next: T): T {
    this.history.push(this.current);
    this.current = next;
    return this.current;
  }
}

function kindAndText(value: Comparable): string {
  return typeof value + " " + String(value.valueOf() === value) + " " + value.toString();
}

function localKind(value: Localized): string {
  return typeof value + " " + typeof value.toLocaleString();
}

function asKey(value: {}): string {
  const record: Record<string, number> = {};
  record[String(value)] = 1;
  return Object.keys(record)[0];
}

function inATemplate(value: {}): string {
  return `[${value}]`;
}

function added(value: {}): string {
  return value + "!";
}

const values: [string, Comparable & Localized][] = [
  ["a literal", { valueOf: () => 0, toString: () => "literal", toLocaleString: () => "local" }],
  ["true", true],
  ["false", false],
  ["0n", 0n],
  ["-5n", -5n],
  ["2n ** 100n", 2n ** 100n],
  ["a symbol", Symbol("mark")],
  ["a symbol without a description", Symbol()],
  ["a well-known symbol", Symbol.asyncIterator],
];

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = { valueOf: () => i, toString: () => "t" + i };
  warm += kindAndText(honest).length + localKind(honest).length + asKey(honest).length + inATemplate(honest).length + added(honest).length + new Holder(honest).put(honest).valueOf();
}
console.log("after 2000 literals", warm);

for (const [name, value] of values) {
  attempt(name + ": kind and text", () => kindAndText(value));
  attempt(name + ": local", () => localKind(value));
  attempt(name + ": as a key", () => asKey(value));
  attempt(name + ": in a template", () => inATemplate(value));
  attempt(name + ": added to a string", () => added(value));
  attempt(name + ": in a holder", () => {
    const holder = new Holder<{}>({});
    holder.put(value);
    holder.put(0);
    holder.put(value);
    return [holder.current, holder.history];
  });
}
attempt("a holder of booleans", () => {
  const holder = new Holder(true);
  holder.put(false);
  return [holder.current, holder.history, holder.current ? "truthy" : "falsy"];
});
attempt("a holder of bigints", () => {
  const holder = new Holder(1n);
  holder.put(holder.current + 2n ** 64n);
  return [holder.current, holder.history, holder.current * 2n];
});
attempt("a holder of symbols", () => {
  const holder = new Holder(Symbol.for("a"));
  holder.put(Symbol.for("b"));
  return [holder.current.description, holder.history[0] === Symbol.for("a")];
});
//// bound-and-wrapped-functions-typed-as-the-function.ts
////= show-30

import { deprecate } from "node:util";

type Scale = (value: number, factor?: number) => number;

function scale(this: unknown, value: number, factor: number = 2): number {
  return value * factor;
}

class Ruler {
  unit = 10;
  measure(value: number): number {
    return value * this.unit;
  }
}

function callIt(f: Scale, value: number): number {
  return f(value);
}

function callWithBoth(f: Scale, value: number): number {
  return f(value, 3);
}

function facts(f: Scale): unknown[] {
  return [typeof f, f.name, f.length, "prototype" in f, f === scale];
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += callIt(scale, i) + callWithBoth(scale, i) + facts(scale).length;
console.log("after 2000 honest calls", warm);

const quiet = process.noDeprecation;
process.noDeprecation = true;

const makers: [string, () => Scale][] = [
  ["the function", () => scale],
  ["bound to nothing", () => scale.bind(undefined)],
  ["bound to a first argument", () => scale.bind(undefined, 5)],
  ["bound to both arguments", () => scale.bind(undefined, 5, 6)],
  ["bound twice", () => scale.bind(undefined).bind(undefined)],
  ["a proxy", () => new Proxy(scale, {})],
  ["marked as deprecated", () => deprecate(scale, "zzold")],
  ["with members assigned", () => Object.assign(scale.bind(undefined), { extra: 1 })],
  ["an arrow function around it", () => (value, factor) => scale(value, factor)],
  ["a method bound to its object", () => {
    const ruler = new Ruler();
    return ruler.measure.bind(ruler);
  }],
  ["a method taken off its object", () => new Ruler().measure],
  ["a built-in", () => Math.abs],
];
for (const [name, make] of makers) {
  attempt(name + ": called", () => callIt(make(), 4));
  attempt(name + ": called with both", () => callWithBoth(make(), 4));
  attempt(name + ": facts", () => facts(make()));
  attempt(name + ": handed to map", () => [1, 2].map(make()));
  attempt(name + ": call and apply", () => [make().call(undefined, 4), make().apply(undefined, [4, 3])]);
}
process.noDeprecation = quiet;
attempt("honest again", () => [callIt(scale, 4), callWithBoth(scale, 4)]);
//// bound-functions-stand-for-the-functions-they-wrap.ts
////= text-12

class Account {
  balance: number = 10;
  name: string = "acct";
  add(amount: number, bonus: number): number {
    this.balance += amount + bonus;
    return this.balance;
  }
  title(): string {
    return this.name.toUpperCase();
  }
}

function area(this: { scale: number }, w: number, h: number): number {
  return this.scale * w * h;
}
function plain(a: number, b: number, c: number): string {
  return a + "," + b + "," + c;
}
////= lines-234	Legacy	this	made	number	this.made	1

const account = new Account();
const add = account.add.bind(account);
const addFive = account.add.bind(account, 5);
const addFiveOne = account.add.bind(account, 5, 1);
const title = account.title.bind(account);
const rebound = title.bind(new Account());
const scaled = area.bind({ scale: 2 });
const scaledThree = area.bind({ scale: 2 }, 3);
const partial = plain.bind(null, 1);
const twicePartial = partial.bind(null, 2);

function run2(f: (a: number, b: number) => number): number {
  return f(1, 2);
}
////= lines-118	run0	f	string

show("add", () => add(1, 2));
show("addFive", () => addFive(1));
show("addFiveOne", () => addFiveOne());
show("balance", () => account.balance);
show("title", () => title());
account.name = "renamed";
show("title after a rename", () => title());
show("bound again to another object", () => rebound());
show("call with another this", () => title.call(new Account()));
show("scaled", () => scaled(2, 3));
show("scaledThree", () => scaledThree(3));
show("partial", () => partial(2, 3));
show("twicePartial", () => twicePartial(3));
show("as a parameter", () => run2(add));
show("as a parameter", () => run2(scaled));
show("as a parameter", () => run0(title));
show("an unbound method as a parameter", () => run0(account.title));

const all: [string, Function][] = [
  ["add", add],
  ["addFive", addFive],
  ["addFiveOne", addFiveOne],
  ["title", title],
  ["rebound", rebound],
  ["scaledThree", scaledThree],
  ["twicePartial", twicePartial],
  ["unbound", account.add],
];
for (const [label, f] of all) {
  show(label + " name", () => f.name);
  show(label + " length", () => f.length);
  show(label + " has a prototype", () => "prototype" in f);
  show(label + " own keys", () => Reflect.ownKeys(f).map(String).join());
}
show("same function twice", () => account.add.bind(account) === account.add.bind(account));
show("map with a bound method", () => [1, 2].map(addFive));
show("balance", () => account.balance);

let sum = 0;
const direct = (a: number, b: number): number => a + b;
for (let i = 0; i < 2000; i++) sum += run2(direct);
show("2000 plain functions", () => sum);
show("then a bound one", () => run2(add));
show("then a plain one", () => run2(direct));
show("a bound legacy constructor", () => typeof Legacy.bind({ made: 0 }));
//// branded-types-are-made-without-a-cast.ts
////= show-35

type UserId = string & { readonly __brand: "UserId" };
type Meters = number & { readonly unit: "m" };
type Checked = { value: number } & { readonly checked: true };

function isUserId(text: string): text is UserId {
  return text.startsWith("u");
}
function isMeters(n: number): n is Meters {
  return n >= 0;
}
function assertChecked(box: { value: number }): asserts box is Checked {
  if (box.value < 0) throw new RangeError("negative");
}
function brand(text: string): UserId;
