//// array-is-array-turns-unknown-into-a-list-of-anything.ts
import { runInNewContext } from "node:vm";

////= Point-2

const log: string[] = [];

////= show-15

////= attempt-6

////= total

function asNumbers(u: unknown): unknown {
  if (!Array.isArray(u)) return "no list";
  const list: number[] = u;
  let sum = 0;
  for (const n of list) sum += n;
  return [sum, total(list), list.length, list.map(n => n * 2), list[0] + 1];
}

function asPoints(u: unknown): unknown {
  if (!Array.isArray(u)) return "no list";
  const list: Point[] = u;
  let sum = 0;
  for (const p of list) sum += p.x + p.y;
  return [sum, list.map(p => p.x)];
}

function asTexts(u: unknown): unknown {
  if (!Array.isArray(u)) return "no list";
  const list: string[] = u;
  return [list.map(s => s.length), list.join("+")];
}

function firstAsNumber(u: unknown): unknown {
  if (!Array.isArray(u)) return "no list";
  const n: number = u[0];
  const [, m]: number[] = u;
  return [n + 1, m + 1, typeof n];
}

function pushedTo(u: unknown): unknown {
  if (!Array.isArray(u)) return "no list";
  const list: number[] = u;
  const length = list.push(9);
  return [length, list.length, list[list.length - 1], list.pop()];
}

class Loud extends Array<number> {
  push(...items: number[]): number {
    log.push("push");
    return super.push(...items) + 100;
  }
  map<U>(f: (n: number, i: number, all: number[]) => U): U[] {
    log.push("map");
    return [];
  }
  *[Symbol.iterator](): ArrayIterator<number> {
    log.push("iterate");
    yield 1000;
  }
}

const lists: [string, () => unknown][] = [
  ["numbers", () => [1, 2]],
  ["texts", () => ["a", "b"]],
  ["mixed", () => [1, "b", null, undefined, true]],
  ["points", () => [{ x: 1, y: 2 }]],
  ["points with texts", () => [{ x: "1", y: 2 }, { y: 1 }]],
  ["empty", () => []],
  ["holes", () => [, 1, ,]],
  ["only holes", () => Array(2)],
  ["bigints", () => [1n]],
  ["lists", () => [[1], [2]]],
  ["a subclass", () => Loud.from([1, 2])],
  [
    "a proxy",
    () =>
      new Proxy([1, 2], {
        get(target, key, receiver) {
          log.push("get " + String(key));
          return Reflect.get(target, key, receiver);
        },
      }),
  ],
  ["frozen", () => Object.freeze([1, 2])],
  ["another prototype", () => Object.setPrototypeOf([1, 2], { length: "inherited" })],
  ["no prototype", () => Object.setPrototypeOf([1, 2], null)],
  ["an own method", () => Object.assign([1, 2], { map: () => "own map", push: () => "own push" })],
  ["another realm", () => runInNewContext("[1, 2]")],
  ["another realm, texts", () => runInNewContext("['a', 'b']")],
  ["an array-like", () => ({ 0: 1, 1: 2, length: 2 })],
  ["a typed array", () => new Uint8Array([1, 2])],
  ["a text", () => "12"],
];

const uses: [string, (u: unknown) => unknown][] = [
  ["numbers", asNumbers],
  ["points", asPoints],
  ["texts", asTexts],
  ["its first", firstAsNumber],
  ["pushed to", pushedTo],
];

for (const [use, run] of uses) {
  let rounds = 0;
  const honest = use === "points" ? [{ x: 1, y: 2 }] : use === "texts" ? ["a"] : [1, 2];
  for (let i = 0; i < 2000; i++) {
    run(honest);
    rounds++;
  }
  console.log("as " + use + ": " + rounds + " honest rounds");
  for (const [name, make] of lists) attempt("as " + use + ", " + name, () => run(make()));
}
//// array-subclass-results-of-slice-map-filter-and-concat.ts
////= show-30

const log: string[] = [];

class Stack extends Array<number> {
  label = "stack";
  constructor(...items: number[]) {
    super(...items);
    log.push("constructed with " + items.join());
  }
  top(): number | undefined {
    return this[this.length - 1];
  }
  push(...items: number[]): number {
    log.push("push " + items.join());
    return super.push(...items);
  }
}

function stackOf(a: number, b: number, c: number): Stack {
  return new Stack(a, b, c);
}

function describe(numbers: number[]): unknown[] {
  return [numbers.constructor.name, numbers instanceof Stack, Array.isArray(numbers), [...numbers], Object.keys(numbers)];
}

////= sum

////= lines-233	pushOne	numbers	number	numbers.push	9

const makers: [string, (stack: Stack) => number[]][] = [
  ["slice", stack => stack.slice(1)],
  ["slice of everything", stack => stack.slice()],
  ["map", stack => stack.map(value => value * 2)],
  ["filter", stack => stack.filter(value => value > 1)],
  ["filter of nothing", stack => stack.filter(() => false)],
  ["concat", stack => stack.concat([4, 5])],
  ["concat onto a plain array", stack => [0].concat(stack)],
  ["splice", stack => stack.splice(0, 2)],
  ["flat", stack => stack.flat()],
  ["flatMap", stack => stack.flatMap(value => [value, value])],
  ["toSorted", stack => stack.toSorted()],
  ["toReversed", stack => stack.toReversed()],
  ["toSpliced", stack => stack.toSpliced(0, 1)],
  ["with", stack => stack.with(0, 7)],
  ["spread", stack => [...stack]],
  ["Array.from", stack => Array.from(stack)],
  ["reverse", stack => stack.reverse()],
  ["sort", stack => stack.sort()],
  ["fill", stack => stack.fill(0)],
  ["structuredClone", stack => structuredClone(stack)],
];

let warm = 0;
for (let i = 0; i < 2000; i++) warm += sum([i, 2, 3]) + pushOne([i]) + describe([i]).length;
console.log("after 2000 plain arrays", warm);

for (const [name, make] of makers) {
  log.length = 0;
  attempt(name + ": what it is", () => describe(make(stackOf(1, 2, 3))));
  console.log("  log: " + log.join("; "));
  attempt(name + ": sum", () => sum(make(stackOf(1, 2, 3))));
  log.length = 0;
  attempt(name + ": push", () => pushOne(make(stackOf(1, 2, 3))));
  console.log("  log: " + log.filter(entry => entry.startsWith("push")).join("; "));
}
attempt("a map to strings is still a stack", () => {
  const texts: string[] = stackOf(1, 2, 3).map(value => "s" + value);
  return [texts.constructor.name, texts instanceof Stack, texts.join()];
});
attempt("one element: the constructor takes it for a length", () => {
  const one = new Stack(3);
  return [one.length, 0 in one, one.map(value => value).length];
});
