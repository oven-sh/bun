//// built-in-iterators-are-stepped-by-hand-where-generators-were.ts
////= text-4

function* counting(): Generator<number, undefined, unknown> {
  yield 1;
  yield 2;
  return undefined;
}

function shape(result: IteratorResult<number, undefined>): string {
  return Object.keys(result).join() + " " + text(result.value) + " " + text(result.done);
}

function stepFour(walk: IterableIterator<number, undefined, unknown>): string {
  const out: string[] = [];
  for (let i = 0; i < 4; i++) out.push(shape(walk.next()));
  return out.join(" | ");
}

function isItsOwnIterator(walk: IterableIterator<number, undefined, unknown>): boolean {
  return walk[Symbol.iterator]() === walk;
}

function freshResults(walk: IterableIterator<number, undefined, unknown>): boolean {
  const a = walk.next();
  const b = walk.next();
  return a !== b;
}

function listOfArguments(...rest: number[]): IterableIterator<number, undefined, unknown> {
  return rest[Symbol.iterator]();
}

let warm = "";
for (let i = 0; i < 2000; i++) warm = stepFour(counting());
console.log("2000 generators: " + warm);

const makers: [string, () => IterableIterator<number, undefined, unknown>][] = [
  ["a generator", counting],
  ["array values", () => [1, 2].values()],
  ["array keys", () => ["x", "y"].keys()],
  ["an array with a hole", () => [1, , 3].values().map(n => (n === undefined ? -1 : n))],
  ["set values", () => new Set([1, 2]).values()],
  ["map keys", () => new Map([[1, "x"], [2, "y"]]).keys()],
  ["map values", () => new Map([["x", 1], ["y", 2]]).values()],
  ["typed array values", () => new Uint8Array([1, 2]).values()],
  ["a rest parameter", () => listOfArguments(1, 2)],
  ["a helper", () => [0, 1].values().map(n => n + 1)],
  ["a helper over a generator", () => counting().filter(n => n > 0)],
  ["Iterator.from a generator", () => Iterator.from(counting())],
];

for (const [label, make] of makers) {
  console.log(label + ": " + stepFour(make()));
  console.log(label + ", its own iterator: " + isItsOwnIterator(make()) + ", fresh results: " + freshResults(make()));
  console.log(label + ", tag: " + Object.prototype.toString.call(make()));
}

console.log("a generator again: " + stepFour(counting()));

const growing = [1];
const walker = growing.values();
console.log("first: " + shape(walker.next()));
growing.push(2);
console.log("after a push: " + shape(walker.next()));
console.log("at the end: " + shape(walker.next()));
growing.push(3);
console.log("a push after the end: " + shape(walker.next()));

const members = new Set([1, 2, 3]);
const setWalker = members.values();
console.log("set first: " + shape(setWalker.next()));
members.delete(2);
members.add(4);
console.log("set after a delete and an add: " + shape(setWalker.next()) + " | " + shape(setWalker.next()) + " | " + shape(setWalker.next()));
//// built-in-loops-over-an-array-that-changes-its-length.ts
////= show-32

function study(title: string, change: (list: number[], index: number) => void): void {
  console.log(title);
  attempt("  forEach", () => {
    const list = [1, 2, 3, 4];
    const seen: string[] = [];
    list.forEach((n, i) => {
      seen.push(i + ":" + show(n));
      change(list, i);
    });
    return [seen.join(" "), list];
  });
  attempt("  map", () => {
    const list = [1, 2, 3, 4];
    const mapped = list.map((n, i) => {
      change(list, i);
      return n + 1;
    });
    return [mapped, list];
  });
  attempt("  filter", () => {
    const list = [1, 2, 3, 4];
    return list.filter((n, i) => {
      change(list, i);
      return n !== 2;
    });
  });
  attempt("  reduce", () => {
    const list = [1, 2, 3, 4];
    return list.reduce((sum, n, i) => {
      change(list, i);
      return sum + n;
    }, 0);
  });
  attempt("  reduceRight", () => {
    const list = [1, 2, 3, 4];
    return list.reduceRight((text, n, i) => {
      change(list, i);
      return text + show(n);
    }, "");
  });
  attempt("  find sees holes", () => {
    const list = [1, 2, 3, 4];
    const seen: string[] = [];
    list.find((n, i) => {
      seen.push(typeof n);
      change(list, i);
      return false;
    });
    return seen.join();
  });
  attempt("  findLast", () => {
    const list = [1, 2, 3, 4];
    const seen: string[] = [];
    list.findLast((n, i) => {
      seen.push(typeof n);
      change(list, i);
      return false;
    });
    return seen.join();
  });
  attempt("  every", () => {
    const list = [1, 2, 3, 4];
    let rounds = 0;
    const all = list.every((n, i) => {
      rounds++;
      change(list, i);
      return n + 1 > 0;
    });
    return [all, rounds];
  });
  attempt("  entries", () => {
    const list = [1, 2, 3, 4];
    const seen: string[] = [];
    for (const [i, n] of list.entries()) {
      if (seen.length > 8) break;
      seen.push(i + ":" + show(n));
      change(list, i);
    }
    return seen.join(" ");
  });
  attempt("  flatMap", () => {
    const list = [1, 2, 3, 4];
    return list.flatMap((n, i) => {
      change(list, i);
      return [n, n * 2];
    });
  });
  attempt("  Array.from with a map function", () => {
    const list = [1, 2, 3, 4];
    return Array.from(list, (n, i) => {
      if (i < 8) change(list, i);
      return n + 1;
    }).length;
  });
}

study("nothing changes", () => {});
study("popped each round", list => list.pop());
study("cut to 1 in the first round", (list, i) => {
  if (i === 0 || i === 3) list.length = 1;
});
study("pushed to in the first two rounds", (list, i) => {
  if (i < 2) list.push(9);
});
study("the next one is deleted", (list, i) => {
  delete list[i + 1];
});
study("the next one is replaced by a fraction", (list, i) => {
  if (i + 1 < list.length) list[i + 1] = 0.5;
});
study("shifted in the first round", (list, i) => {
  if (i === 0) list.shift();
});

