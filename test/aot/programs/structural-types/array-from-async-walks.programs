type MakesPromise = () => Promise<number>;
type MakesIterator = () => Iterator<number>;
type MakesIterable = () => Iterable<number>;

const asyncArrow: MakesPromise = async () => 1;
const plainPromise: MakesPromise = () => Promise.resolve(2);
const thenableClass: MakesPromise = () => new (class Sub extends Promise<number> {})(resolve => resolve(3));
async function throwsLater(): Promise<number> {
  throw new RangeError("later");
}
function throwsNow(): Promise<number> {
  throw new RangeError("now");
}

////= lines-270	generator	number	1	2
const handMade: MakesIterator = () => {
  let n = 0;
  return { next: () => (n < 2 ? { done: false, value: ++n * 10 } : { done: true, value: undefined }) };
};
const fromArray: MakesIterator = () => [5, 6][Symbol.iterator]();

function drain(make: MakesIterator): string {
  const it = make();
  const out: number[] = [];
  for (let r = it.next(); !r.done; r = it.next()) out.push(r.value);
  return out.join();
}
function collect(make: MakesIterable): string {
  return [...make()].join();
}

show("drain a generator", () => drain(generator));
show("drain a hand-made iterator", () => drain(handMade));
show("drain an array's iterator", () => drain(fromArray));
show("collect a generator", () => collect(generator));
show("collect an array", () => collect(() => [7, 8]));
show("collect a set", () => collect(() => new Set([9, 9, 10])));
show("collect a typed array", () => collect(() => new Uint8Array([1, 300])));

let reads = 0;
class Lazy {
  get run(): () => number {
    reads++;
    return () => reads;
  }
  method(): number {
    return -1;
  }
}
////= lines-69	Runs	run	number
////= lines-215	runTwice	r	Runs	r.run	","	r.run
show("a getter that returns a function, as a method", () => runTwice(new Lazy()));
show("reads", () => reads);
show("a real method at the same place", () => runTwice({ run: () => 5 }));
show("a class with the method", () => runTwice(new (class { run(): number { return 6; } })()));

async function settle(label: string, make: MakesPromise): Promise<void> {
  try {
    const promise = make();
    console.log(label + ": " + promise.constructor.name + " " + (await promise));
  } catch (error) {
    console.log(label + ": threw " + (error instanceof Error ? error.constructor.name : typeof error));
  }
}
function startsSynchronously(make: MakesPromise): string {
  try {
    make().catch(() => {});
    return "returned";
  } catch (error) {
    return "threw at once";
  }
}
show("an async function that throws", () => startsSynchronously(throwsLater));
show("a plain function that throws", () => startsSynchronously(throwsNow));

async function main(): Promise<void> {
  await settle("async arrow", asyncArrow);
  await settle("plain promise", plainPromise);
  await settle("subclass of Promise", thenableClass);
  await settle("throws later", throwsLater);
  await settle("throws now", throwsNow);
}
main().then(() => console.log("done"));
//// async-and-generator-methods-are-taken-off-their-object.ts
////= show-6

class Feed {
  items: number[] = [1, 2, 3];
  name: string = "feed";
  async first(): Promise<number> {
    return this.items[0];
  }
  async afterAwait(): Promise<string> {
    await null;
    return this.name;
  }
  *each(): Generator<number> {
    for (const item of this.items) yield item;
  }
  *lazyName(): Generator<string> {
    yield "started";
    yield this.name;
  }
  async *stream(): AsyncGenerator<number> {
    yield this.items.length;
  }
  [Symbol.iterator](): Iterator<number> {
    return this.items[Symbol.iterator]();
  }
}

const feed = new Feed();
const { first, afterAwait, each, lazyName, stream } = feed;
const iterate = feed[Symbol.iterator];

////= settle	run: () =>	run()

show("calling the bare async method does not throw", () => {
  const promise = first();
  promise.catch(() => {});
  return typeof promise;
});
show("calling the bare generator method does not throw", () => typeof each());
show("its first step does", () => each().next().value);
show("spread of it", () => [...each()].join());
show("lazyName: first step", () => lazyName().next().value);
show("lazyName: second step", () => {
  const it = lazyName();
  it.next();
  return it.next().value;
});
show("the bare iterator method", () => iterate());
show("honest spread", () => [...feed].join());
show("honest each", () => [...feed.each()].join());
show("each on a look-alike", () => [...feed.each.call({ items: [7, 8] })].join());
show("each on a string for items", () => [...feed.each.call({ items: "ab" })].join());
show("each on a number for items", () => [...feed.each.call({ items: 5 })].join());
show("iterator on a look-alike", () => feed[Symbol.iterator].call({ items: [9] }).next().value);

async function main(): Promise<void> {
  await settle("bare first", () => first());
  await settle("bare afterAwait", () => afterAwait());
  await settle("honest first", () => feed.first());
  await settle("honest afterAwait", () => feed.afterAwait());
  await settle("first on a look-alike", () => feed.first.call({ items: [70] }));
  await settle("first on empty items", () => feed.first.call({ items: [] }));
  await settle("afterAwait on a look-alike", () => feed.afterAwait.call({ name: 5 }));
  await settle("bare stream", () => stream().next());
  await settle("honest stream", async () => (await feed.stream().next()).value);
  await settle("then with the bare method", () => Promise.resolve(0).then(first));
  await settle("then with the bare method that awaits", () => Promise.resolve(0).then(afterAwait));
}
main();
