//// copies-and-parsed-objects-typed-as-a-dog-reach-a-dog-method.ts
////= Person-5

class DogKeeper {
  legsOf(d: Dog): number {
    return d.legs;
  }
  legsPlusOne(d: Dog): number {
    return d.legs + 1;
  }
  tagOf(d: Dog): string {
    return d.tag;
  }
  tagLength(d: Dog): number {
    return d.tag.length;
  }
  ownerName(d: Dog): string {
    return d.owner.first;
  }
  speak(d: Dog): string {
    return d.bark();
  }
  shoe(d: Dog): void {
    d.legs = 6;
  }
  isDog(d: Dog): boolean {
    return d instanceof Dog;
  }
}

const keeper = new DogKeeper();
const rex = new Dog("rex");

const cloned: Dog = structuredClone(rex);
const assigned: Dog = Object.assign({}, rex);
const parsed: Dog = JSON.parse('{"name":"parsed","legs":4,"tag":"t","owner":{"first":"p"},"tricks":[]}');
const parsedWrong: Dog = JSON.parse('{"tricks":5,"owner":"nobody","tag":7,"legs":"four","name":null}');
const parsedEmpty: Dog = JSON.parse("{}");
const parsedNull: Dog = JSON.parse("null");
const parsedNumber: Dog = JSON.parse("12");
const parsedArray: Dog = JSON.parse("[1,2]");
const roundTrip: Dog = JSON.parse(JSON.stringify(rex));
const evaluated: Dog = eval("({ name: 'evaluated', legs: 2, get tag() { return 'from a getter'; }, owner: { first: 'e' }, tricks: [], bark() { return 'evaluated bark'; } })");
const created: Dog = Object.create(rex);
const reflected: Dog = Reflect.get({ pet: new Cat("reflected") }, "p" + "et");

const all: [string, Dog][] = [
  ["honest", rex],
  ["cloned", cloned],
  ["assigned", assigned],
  ["parsed", parsed],
  ["parsed wrong", parsedWrong],
  ["parsed empty", parsedEmpty],
  ["parsed null", parsedNull],
  ["parsed number", parsedNumber],
  ["parsed array", parsedArray],
  ["round trip", roundTrip],
  ["evaluated", evaluated],
  ["created", created],
  ["reflected", reflected],
  ["honest again", new Dog("fido")],
];

for (const [label, d] of all) {
  show(label + " legsOf", () => keeper.legsOf(d));
  show(label + " legsPlusOne", () => keeper.legsPlusOne(d));
  show(label + " tagOf", () => keeper.tagOf(d));
  show(label + " tagLength", () => keeper.tagLength(d));
  show(label + " ownerName", () => keeper.ownerName(d));
  show(label + " speak", () => keeper.speak(d));
  show(label + " isDog", () => keeper.isDog(d));
  show(label + " shoe", () => keeper.shoe(d));
  show(label + " legsOf after shoe", () => keeper.legsOf(d));
}
show("rex after the one made from it was shod", () => rex.legs);
show("direct: cloned", () => keeper.speak(cloned));
show("direct: cloned legs", () => keeper.legsPlusOne(cloned));
show("direct: parsed wrong legs", () => keeper.legsPlusOne(parsedWrong));
show("direct: reflected legs", () => keeper.legsPlusOne(reflected));
//// counters-pass-two-to-the-31-across-awaits-and-yields.ts
////= text-4

async function climbs(start: number, step: number, rounds: number): Promise<string> {
  let n = start;
  const trail: string[] = [];
  for (let i = 0; i < rounds; i++) {
    n += step;
    await null;
    trail.push(text(n));
  }
  return trail.join(", ");
}

async function increments(start: number): Promise<string> {
  let n = start;
  n++;
  await null;
  n++;
  await null;
  n++;
  return text(n) + " " + text(n | 0) + " " + text(n >>> 0);
}

async function multiplies(start: number): Promise<string> {
  let n = start;
  const trail: string[] = [];
  for (let i = 0; i < 4; i++) {
    n *= await Promise.resolve(65536);
    trail.push(text(n));
  }
  return trail.join(", ");
}

async function signs(): Promise<string> {
  let zero = 0;
  await null;
  zero *= -1;
  await null;
  const remainder = -4 % (await Promise.resolve(2));
  const rounded = Math.round(await Promise.resolve(-0.2));
  return [zero, remainder, rounded, zero + 0, 1 / zero].map(text).join(", ");
}

function* climbing(start: number): Generator<number, number, number> {
  let n = start;
  for (let i = 0; i < 4; i++) n += yield n;
  return n;
}

function* dividing(): Generator<number, void, number> {
  let n = 12;
  for (;;) n = n / (yield n);
}

console.log("near the top: " + (await climbs(2147483645, 1, 5)));
console.log("near the bottom: " + (await climbs(-2147483646, -1, 5)));
console.log("a fraction arrives: " + (await climbs(1, 0.5, 3)));
console.log("small: " + (await climbs(1, 1, 3)));
console.log("increments: " + (await increments(2147483646)));
console.log("increments, small: " + (await increments(1)));
console.log("multiplies: " + (await multiplies(3)));
console.log("signs: " + (await signs()));

const c = climbing(2147483646);
console.log("yielded: " + [c.next(0), c.next(1), c.next(1), c.next(-3), c.next(0.5)].map(text).join(" "));

const d = dividing();
console.log("divided: " + [d.next(1), d.next(2), d.next(4), d.next(4), d.next(0), d.next(-1), d.next(Infinity), d.next(-1)].map(r => text(r.value)).join(", "));

let shared = 2147483640;
async function bump(times: number): Promise<void> {
  for (let i = 0; i < times; i++) {
    shared++;
    await null;
  }
}
await Promise.all([bump(5), bump(5)]);
console.log("a shared counter: " + text(shared));

class Meter {
  ticks: number = 2147483646;
  async tick(): Promise<number> {
    const before = this.ticks;
    await null;
    this.ticks = before + 1;
    return this.ticks;
  }
}
const meter = new Meter();
console.log("a field: " + [await meter.tick(), await meter.tick(), await meter.tick()].map(text).join(", "));

const cells: number[] = [2147483647, 1, 2];
async function bumpCells(): Promise<void> {
  for (let i = 0; i < cells.length; i++) {
    cells[i] += await Promise.resolve(1);
  }
}
await bumpCells();
console.log("elements: " + text(cells));

export {};
