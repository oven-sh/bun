//// concat-takes-an-array-like-that-is-not-spread.ts
////= show-31

let warm = 0;
////= for-3
console.log("after 4000 dense arrays", warm);

function fake(): ConcatArray<number> {
  return {
    length: 2,
    0: 5,
    1: 6,
    join: () => "5,6",
    slice: () => [5, 6],
  };
}

function spreadable(): ConcatArray<number> {
  return Object.assign(fake(), { [Symbol.isConcatSpreadable]: true });
}

function tooShort(): ConcatArray<number> {
  return Object.assign({ length: 3, 0: 5, join: () => "5", slice: () => [5] }, { [Symbol.isConcatSpreadable]: true });
}

function notSpreadable(): number[] {
  return Object.assign([5, 6], { [Symbol.isConcatSpreadable]: false });
}

function joinOn(numbers: number[], more: ConcatArray<number>): number[] {
  return numbers.concat(more);
}

for (let i = 0; i < 2000; i++) warm += joinOn([i], [2, 3]).length + sum(joinOn([i], [0.5]));
console.log("after 2000 honest concatenations", warm);

report("an array", () => joinOn([1], [5, 6]));
report("an object that only looks like one", () => joinOn([1], fake()));
report("the same, marked as spreadable", () => joinOn([1], spreadable()));
report("spreadable and too short", () => joinOn([1], tooShort()));
report("an array marked as not spreadable", () => joinOn([1], notSpreadable()));
report("an array with holes", () => joinOn([1], new Array<number>(2)));
attempt("what the element really is", () => {
  const joined = joinOn([1], fake());
  return [joined.length, typeof joined[1], joined[1] === undefined, Array.isArray(joined[1])];
});
attempt("the receiver is marked as not spreadable", () => {
  const joined = notSpreadable().concat([7]);
  return [joined.length, typeof joined[0], joined[1]];
});
attempt("a readonly array", () => {
  const fixed: readonly number[] = [5, 6];
  return inspect(joinOn([1], fixed));
});
attempt("a subclass", () => {
  class List extends Array<number> {}
  const joined = joinOn(List.from([1]), List.from([2]));
  return [joined.constructor.name, inspect(joined)];
});
//// const-enums-and-plain-enums-side-by-side.ts
////= show-4

const log: string[] = [];

////= attempt-2

const enum Fast {
  Zero,
  One,
  Two = One + One,
  Text = "text",
  Negative = -1,
  Big = 2 ** 31,
  Shifted = 1 << 31,
  Fraction = 1 / 4,
  MinusZero = -0,
  Glued = `a${"b"}`,
}

enum Slow {
  Zero,
  One,
  Two = One + One,
  Text = "text",
  Negative = -1,
  Big = 2 ** 31,
  Shifted = 1 << 31,
  Fraction = 1 / 4,
  Nothing = 0 / 0,
  Endless = 1 / 0,
  MinusZero = -0,
  Glued = `a${"b"}`,
}

function fastName(f: Fast): string {
  switch (f) {
    case Fast.Zero:
      return "zero";
    case Fast.One:
      return "one";
    case Fast.Two:
      return "two";
    case Fast.Text:
      return "text";
    default:
      return "other " + f;
  }
}

function fastMath(f: Fast.One | Fast.Two): number {
  return f * 10;
}

attempt("const enum values", () => [Fast.Zero, Fast.One, Fast.Two, Fast.Text, Fast.Negative, Fast.Big, Fast.Shifted, Fast.Fraction, Fast.MinusZero, Fast.Glued]);
attempt("plain enum values", () => [Slow.Zero, Slow.One, Slow.Two, Slow.Text, Slow.Negative, Slow.Big, Slow.Shifted, Slow.Fraction, Slow.Nothing, Slow.Endless, Slow.MinusZero, Slow.Glued]);
attempt("by a quoted name", () => [Fast["Two"], Slow["Two"], Fast["Text"], Slow["Text"]]);
attempt("plain enum keys", () => Object.keys(Slow));
attempt("plain enum reverse", () => [Slow[0], Slow[1], Slow[2], Slow[-1], Slow[2147483648], Slow[-2147483648], Slow[0.25], Slow[NaN], Slow[Infinity]]);
attempt("one over minus zero", () => [1 / Fast.MinusZero, 1 / Slow.MinusZero, Object.is(Fast.MinusZero, -0), Object.is(Slow.MinusZero, -0)]);
attempt("names", () => [fastName(Fast.Zero), fastName(Fast.Two), fastName(Fast.Text), fastName(Fast.Big), fastName(Fast.MinusZero)]);
attempt("math", () => [fastMath(Fast.One), fastMath(Fast.Two), Fast.Big + 1, Fast.Shifted - 1, Fast.Big | 0, Fast.Fraction * 4]);
attempt("typeof", () => [typeof Fast.One, typeof Fast.Text, typeof Slow.One, typeof Slow, typeof Slow.Text]);
attempt("as keys", () => {
  const table = { [Fast.One]: "one", [Fast.Text]: "text", [Fast.Negative]: "negative", [Fast.Fraction]: "fraction" };
  return [Object.keys(table), table[Fast.One], table[Fast.Text], table[Fast.Negative]];
});
attempt("a number outside a const enum", () => {
  const n: number = 77;
  const f: Fast = n;
  return fastName(f);
});
attempt("a number typed as one member of a const enum", () => {
  const n: number = 77;
  const f: Fast.One = n;
  return [f, fastMath(f), f === Fast.One];
});
attempt("compared with each other through numbers", () => {
  const a: number = Fast.Two;
  const b: number = Slow.Two;
  return [a === b, Slow.Nothing === Slow.Nothing, Object.is(Slow.Nothing, NaN), Slow.Endless > Fast.Big];
});
let warm = 0;
for (let i = 0; i < 2000; i++) warm += fastMath(i & 1 ? Fast.One : Fast.Two) + fastName(Fast.Two).length + Slow.Two + Fast.Negative;
console.log("2000 rounds", warm);
attempt("the plain enum's object is stored to through an alias", () => {
  const open: { One: number; Text: string } = Slow;
  open.One = 100;
  open.Text = "changed";
  const read: { readonly One: number; readonly Text: string } = Slow;
  return [Slow.One, Slow.Text, read.One, read.Text, Slow[1], Slow[100], Object.keys(Slow).length];
});
