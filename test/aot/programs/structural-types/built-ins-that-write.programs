interface Setter {
  set(v: number | string | undefined): void;
}

let moduleNumber: number = 1;
////= lines-34	readModule	number	return	moduleNumber
////= lines-240	modulePlusOne	moduleNumber
const moduleSetter: Setter = {
  set(v: number) {
    moduleNumber = v;
  },
};

function makeCell(): { setter: Setter; read: () => number; plusOne: () => number; bump: () => number } {
  let cell: number = 1;
  return {
    setter: {
      set(v: number) {
        cell = v;
      },
    },
    read: () => cell,
    plusOne: () => cell + 1,
    bump: () => ++cell,
  };
}

interface Installer {
  install(f: ((n: number) => number) | string | undefined): void;
}
let action: (n: number) => number = n => n * 2;
////= lines-60	runAction	n	number	number	action	n
const installer: Installer = {
  install(f: (n: number) => number) {
    action = f;
  },
};

let total = 0;
for (let i = 0; i < 2000; i++) {
  moduleSetter.set(i);
  total += readModule();
}
show("2000 honest stores", () => total);
moduleSetter.set("text");
show("module: a string", readModule);
show("module: plus one", modulePlusOne);
show("module: direct", () => moduleNumber);
show("module: typeof", () => typeof moduleNumber);
moduleSetter.set(undefined);
show("module: undefined", readModule);
show("module: plus one", modulePlusOne);
moduleSetter.set(2.5);
show("module: a number again", modulePlusOne);

const cell = makeCell();
show("cell: start", cell.read);
cell.setter.set(4);
show("cell: 4", cell.plusOne);
cell.setter.set("text");
show("cell: a string", cell.read);
show("cell: plus one", cell.plusOne);
show("cell: bump", cell.bump);
show("cell: after the bump", cell.read);
cell.setter.set(undefined);
show("cell: undefined", cell.read);
show("cell: plus one", cell.plusOne);
const other = makeCell();
show("another cell is untouched", other.plusOne);

show("action: start", () => runAction(2));
installer.install(n => n + 100);
show("action: replaced", () => runAction(2));
installer.install("not a function");
show("action: a string", () => runAction(2));
show("action: typeof", () => typeof action);
installer.install(undefined);
show("action: undefined", () => runAction(2));
installer.install(Math.abs);
show("action: a built-in", () => runAction(-2));
//// captured-int32-variables-are-set-by-callbacks-typed-with-number.ts
import type { int32 } from "bun";

////= show-34

let warm = 0;
for (let i = 0; i < 2000; i++) warm += uses(i | 0).length + uses(-i | 0).length;
console.log("4000 honest uses", warm);

const odd: number[] = JSON.parse("[1.5, -0, 2147483648, -2147483649, 1e21, 3]");
odd.push(NaN, Infinity);

let total: int32 = 0;
const setTotal: (v: number) => void = (v: int32) => {
  total = v;
};
////= lines-34	totalOf	int32	return	total

function counter(): { set: (v: number) => void; get: () => int32; bump: () => int32 } {
  let count: int32 = 0;
  return {
    set: (v: int32) => {
      count = v;
    },
    get: () => count,
    bump: () => {
      count = (count + 1) | 0;
      return count;
    },
  };
}

class Tally {
  count: int32 = 0;
  readonly set: (v: number) => void = (v: int32) => {
    this.count = v;
  };
  twice(): number {
    return this.count * 2;
  }
}

for (let i = 0; i < 2000; i++) setTotal(i);
console.log("2000 honest stores", totalOf());

for (const n of odd) {
  const label = show(n);
  attempt(label + " a variable of the module", () => {
    setTotal(n);
    return uses(totalOf());
  });
  attempt(label + " a variable of a function", () => {
    const c = counter();
    c.set(n);
    return [uses(c.get()), c.bump(), c.get()];
  });
  attempt(label + " a field", () => {
    const tally = new Tally();
    tally.set(n);
    return [uses(tally.count), tally.twice(), JSON.stringify(tally)];
  });
  attempt(label + " by forEach", () => {
    [n].forEach(setTotal);
    return uses(totalOf());
  });
}
//// caught-values-are-untyped-and-fill-typed-places/main.ts
////= Point-2

const log: string[] = [];

////= show-14

////= attempt-6

////= sum-8

class Holder {
  p: Point = { x: 0, y: 0 };
  n = 0;
  take(thrown: unknown): this {
    try {
      throw thrown;
    } catch (e) {
      this.p = e;
      this.n = e;
    }
    return this;
  }
}

const uses: [string, (thrown: unknown) => unknown][] = [
  [
    "a local point",
    thrown => {
      try {
        throw thrown;
      } catch (e) {
        const p: Point = e;
        return [p.x, p.y, p.x + p.y];
      }
    },
  ],
  [
    "a parameter",
    thrown => {
      try {
        throw thrown;
      } catch (e) {
        return sum(e);
      }
    },
  ],
  [
    "fields",
    thrown => {
      const holder = new Holder().take(thrown);
      return [holder.p.x, holder.n + 1, typeof holder.n];
    },
  ],
  [
    "an element and a map value",
    thrown => {
      const list: Point[] = [{ x: 1, y: 2 }];
      const map = new Map<string, Point>();
      try {
        throw thrown;
      } catch (e) {
        list.push(e);
        map.set("k", e);
      }
      return [list.map(sum), map.get("k")?.y];
    },
  ],
  [
    "a pattern",
    thrown => {
      try {
        throw thrown;
      } catch ({ x, y }) {
        const a: number = x;
        const b: number = y;
        return [a + b, plusOne(a)];
      }
    },
  ],
  [
    "a number",
    thrown => {
      try {
        throw thrown;
      } catch (e) {
        const n: number = e;
        return [n + 1, plusOne(e), [10, 20, 30, 40][n], typeof n];
      }
    },
  ],
  [
    "a function",
    thrown => {
      try {
        throw thrown;
      } catch (e) {
        const f: (n: number) => number = e;
        return f(1) + 1;
      }
    },
  ],
  [
    "members of an error",
    thrown => {
      try {
        throw thrown;
      } catch (e) {
        const message: string = e.message;
        const code: number = e.code;
        return [message + "!", code + 1, typeof e.stack];
      }
    },
  ],
  [
    "thrown again from finally",
    thrown => {
      let n = 0;
      try {
        try {
          throw thrown;
        } finally {
          n = 1;
        }
      } catch (e) {
        n += e;
      }
      return [n, typeof n];
    },
  ],
];

const thrown: [string, unknown][] = [
  ["a point", { x: 1, y: 2 }],
  ["texts", { x: "1", y: "2" }],
  ["an error", new Error("e")],
  ["an error with a code", Object.assign(new RangeError("r"), { code: "7", x: 1, y: 2 })],
  [
    "getters",
    {
      get x() {
        log.push("x");
        return 1;
      },
      get y() {
        log.push("y");
        return 2;
      },
    },
  ],
  ["a number", 3],
  ["a text", "3"],
  ["a bigint", 3n],
  ["a list", [1, 2]],
  ["a function", (n: number) => n + "!"],
  ["null", null],
  ["undefined", undefined],
];

for (const [use, run] of uses) {
  let rounds = 0;
  const honest = use === "a number" || use === "thrown again from finally" ? 3 : use === "a function" ? (n: number) => n + 1 : use === "members of an error" ? Object.assign(new Error("e"), { code: 1 }) : { x: 1, y: 2 };
  for (let i = 0; i < 2000; i++) {
    run(honest);
    rounds++;
  }
  console.log(use + ": " + rounds + " honest rounds");
  for (const [name, value] of thrown) attempt(use + ", " + name, () => run(value));
}
