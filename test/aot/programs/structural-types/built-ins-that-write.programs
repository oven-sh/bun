//// class-instances-for-an-interface-keep-their-own-form.ts
interface Shape {
  name: string;
  sides: number;
  area(): number;
}

const log: string[] = [];

class Square implements Shape {
  name = "square";
  sides = 4;
  constructor(private edge: number) {}
  area(): number {
    return this.edge * this.edge;
  }
}

class Triangle {
  sides = 3;
  base = 4;
  height = 5;
  name = "triangle";
  area(): number {
    return (this.base * this.height) / 2;
  }
}

class Circle {
  get name(): string {
    log.push("get name");
    return "circle";
  }
  set name(value: string) {
    log.push("set name " + value);
  }
  get sides(): number {
    log.push("get sides");
    return 0;
  }
  set sides(value: number) {
    log.push("set sides " + value);
  }
  area = (): number => 3;
}

class Fixed {
  static shared = 0;
  name = "fixed";
  sides = 1;
  area(): number {
    return ++Fixed.shared;
  }
}

const literal: Shape = { area: () => 7, sides: 2, name: "literal" };
const created: Shape = Object.create({ name: "created", sides: 9, area: () => 8 });

function summary(s: Shape): string {
  return s.name + " " + s.sides + " " + s.area();
}

////= listing-2	s	Shape	inherited

function rename(s: Shape, name: string): string {
  s.name = name;
  s.sides += 1;
  return s.name + " " + s.sides;
}

function shapes(): Shape[] {
  return [new Square(2), new Triangle(), new Circle(), new Fixed(), literal, created];
}

for (const s of shapes()) {
  console.log("summary: " + summary(s));
  console.log("listing: " + listing(s));
  console.log("own name, own area: " + Object.hasOwn(s, "name") + " " + Object.hasOwn(s, "area"));
  console.log("log: " + log.join());
  log.length = 0;
}

for (const s of shapes()) {
  console.log("renamed: " + rename(s, "renamed"));
  console.log("log: " + log.join());
  log.length = 0;
}

let total = 0;
for (let i = 0; i < 2000; i++) total += new Square(i % 3).area();
console.log("2000 squares: " + total);
const areaOf = (s: Shape) => s.area();
for (let i = 0; i < 2000; i++) areaOf(new Square(1));
console.log("then the rest at one site: " + shapes().map(areaOf).join());

class Drawing {
  shapes: Shape[] = [];
  main: Shape = new Square(1);
  add(s: Shape): this {
    this.shapes.push(s);
    this.main = s;
    return this;
  }
  total(): number {
    let sum = 0;
    for (const s of this.shapes) sum += s.area() + s.sides;
    return sum;
  }
}

const drawing = new Drawing();
for (const s of shapes()) console.log("main is now: " + drawing.add(s).main.name);
console.log("total: " + drawing.total());

export {};
//// classes-and-other-things-stand-for-a-construct-signature.ts
////= text-12

class Thing {
  static kind: string = "thing";
  n: number;
  constructor(n: number) {
    this.n = n;
  }
  twice(): number {
    return this.n * 2;
  }
}

class SubThing extends Thing {
  static kind: string = "sub";
  extra: string = "extra";
  twice(): number {
    return this.n * 20;
  }
}

class Unrelated {
  static kind: string = "unrelated";
  before: string = "first";
  n: number;
  constructor(n: number) {
    this.n = n + 0.5;
  }
  twice(): number {
    return -this.n;
  }
}

const standIn: Thing = { n: 99, twice: () => -99 };
class Returns {
  static kind: string = "returns";
  n: number = 0;
  constructor(n: number) {
    return standIn;
  }
  twice(): number {
    return 0;
  }
}

interface ThingMaker {
  new (n: number): Thing;
  kind: string;
}

const log: string[] = [];
const proxied: ThingMaker = new Proxy(Thing, {
  construct(target, args, newTarget) {
    log.push("construct " + args.length);
    return Reflect.construct(target, [7], newTarget);
  },
  get(target, key, receiver) {
    log.push("get " + String(key));
    return Reflect.get(target, key, receiver);
  },
});
const bound: ThingMaker = Thing.bind(null);
const boundWithArgument = Thing.bind(null, 5);

function make(M: ThingMaker, n: number): Thing {
  return new M(n);
}
////= lines-20	kindOf	M	ThingMaker	string	return	M.kind

const makers: [string, ThingMaker][] = [
  ["Thing", Thing],
  ["SubThing", SubThing],
  ["Unrelated", Unrelated],
  ["Returns", Returns],
  ["proxied", proxied],
  ["bound", bound],
];

for (const [label, M] of makers) {
  show(label + " kind", () => kindOf(M));
  show(label + " made", () => make(M, 3));
  show(label + " n", () => make(M, 3).n);
  show(label + " twice", () => make(M, 3).twice());
  show(label + " instanceof Thing", () => make(M, 3) instanceof Thing);
  show(label + " instanceof M", () => make(M, 3) instanceof M);
  show(label + " constructor", () => make(M, 3).constructor.name);
  show(label + " name", () => M.name);
  show(label + " length", () => M.length);
  show(label + " has a prototype", () => "prototype" in M);
  show(label + " keys of what is made", () => Object.keys(make(M, 3)).join());
}
show("log", () => log.join());
show("bound with an argument: n", () => new boundWithArgument().n);
show("bound with an argument: instanceof Thing", () => new boundWithArgument() instanceof Thing);
show("bound with an argument: length", () => boundWithArgument.length);
show("bound with an argument: name", () => boundWithArgument.name);

let sum = 0;
for (let i = 0; i < 2000; i++) sum += make(Thing, 1).n;
show("2000 honest constructions", () => sum);
show("then the unrelated class", () => make(Unrelated, 1).n);
show("then the one that returns a stand-in", () => make(Returns, 1).n);
show("then the honest one", () => make(Thing, 1).n);
show("new Returns directly", () => new Returns(1).n);
show("new Returns directly is the stand-in", () => new Returns(1) === standIn);
//// classes-implement-one-method-with-every-kind-of-parameter-list.ts
////= text-4

interface Shape {
  area(scale?: number): string;
}

class NoParameter implements Shape {
  area(): string {
    return "none, " + arguments.length + " given";
  }
}

class Optional implements Shape {
  area(scale?: number): string {
    return "optional " + text(scale) + ", " + arguments.length + " given";
  }
}

class Defaulted implements Shape {
  side = 3;
  area(scale: number = this.side): string {
    return "defaulted " + text(scale) + ", doubled " + text(scale * 2) + ", " + arguments.length + " given";
  }
}

class Rest implements Shape {
  area(...all: (number | undefined)[]): string {
    return "rest of " + all.length + " " + text(all[0]);
  }
}

class Needed implements Shape {
  area(scale: number): string {
    return "required " + text(scale) + ", doubled " + text(scale * 2) + ", whole " + text(scale | 0);
  }
}

class Hidden implements Shape {
  area(scale?: number, unit?: string): string {
    return "hidden " + text(scale) + " " + text(unit) + ", " + arguments.length + " given";
  }
}

class TwoDefaults implements Shape {
  area(scale: number = 1, offset: number = scale + 1): string {
    return "two defaults " + text(scale) + " " + text(offset);
  }
}

class Arrow implements Shape {
  area = (scale?: number): string => "arrow " + text(scale);
}

class Getter implements Shape {
  get area(): (scale?: number) => string {
    return scale => "getter " + text(scale);
  }
}

////= lines-14	class	Inherited	extends	Defaulted	side	30

class Overriding extends Defaulted {
  area(scale: number = 7): string {
    return "overriding, " + super.area(scale) + " | " + super.area();
  }
}

const literal: Shape = {
  area(scale = 11) {
    return "literal " + text(scale);
  },
};

const shapes: Shape[] = [
  new NoParameter(), new Optional(), new Defaulted(), new Rest(), new Needed(), new Hidden(),
  new TwoDefaults(), new Arrow(), new Getter(), new Inherited(), new Overriding(), literal,
];

////= lines-19	none	shape	Shape	string	shape.area
////= lines-36	explicit	shape	Shape	string	shape.area	undefined
////= lines-36	given	shape	Shape	string	shape.area	2
function spread(shape: Shape, parts: [number?]): string {
  return shape.area(...parts);
}

let warm = 0;
const usual = new Defaulted();
for (let i = 0; i < 2000; i++) warm += none(usual).length + explicit(usual).length + given(usual).length;
console.log("2000 rounds with one class: " + warm);

for (const shape of shapes) {
  const name = shape === literal ? "literal" : shape.constructor.name;
  console.log(name + ", area(): " + none(shape));
  console.log(name + ", area(undefined): " + explicit(shape));
  console.log(name + ", area(2): " + given(shape));
  console.log(name + ", area(...[]): " + spread(shape, []));
  console.log(name + ", area(...[undefined]): " + spread(shape, [undefined]));
  console.log(name + ", length " + shape.area.length);
}

interface Wider {
  area(scale: number, unit: number, more: number): string;
}
const wider: Wider[] = [new NoParameter(), new Optional(), new Defaulted(), new Rest(), new Needed(), new TwoDefaults()];
for (const shape of wider) console.log(shape.constructor.name + ", three given: " + shape.area(1, 2, 3));

const narrow: Shape = new Hidden();
const forgetful: { area(scale: number, unit: number): string } = narrow;
console.log("a number arrives in the hidden text parameter: " + forgetful.area(1, 2));
console.log("the usual one again: " + none(usual));
//// closures-kept-in-fields-keep-their-identity-and-can-be-replaced.ts
////= text-12

class Button {
  clicks: number = 0;
  label: string = "button";
  onClick: () => number = () => ++this.clicks;
  describe: () => string = () => this.label + " " + this.clicks;
  plain: (n: number) => number = function (n: number): number {
    return n * 2;
  };
  method(): number {
    return this.clicks;
  }
}

const a = new Button();
const b = new Button();

show("same closure on every read", () => a.onClick === a.onClick);
show("another instance has another closure", () => a.onClick === b.onClick);
show("typeof", () => typeof a.onClick);
show("name", () => a.onClick.name);
show("name of the function expression", () => a.plain.name);
show("length", () => a.plain.length);
show("keys", () => Object.keys(a).join());
show("own", () => Object.hasOwn(a, "onClick"));
show("JSON", () => JSON.stringify(a));
show("call", () => a.onClick());
show("taken off", () => {
  const f = a.onClick;
  return f() + f();
});
show("the other is untouched", () => b.clicks);
show("call with another this", () => a.onClick.call(b));
show("by a computed name", () => {
  const key: "onClick" | "method" = a.label.length > 0 ? "onClick" : "method";
  return a[key]();
});
show("spread copies the closure", () => {
  const copy = { ...a };
  return (copy.onClick === a.onClick) + " " + copy.onClick() + " " + copy.clicks + " " + a.clicks;
});
show("in a set", () => new Set([a.onClick, a.onClick, b.onClick]).size);
show("as a map key", () => new Map([[a.describe, "found"]]).get(a.describe));
show("handed to a built-in", () => [1, 2].map(a.plain));
show("values", () => Object.values(a).map(v => typeof v).join());

const first = a.describe;
a.describe = () => "replaced";
show("replaced", () => a.describe());
show("the old one still works", () => first());
show("the other instance", () => b.describe());

const wide: { onClick: (() => number) | number | undefined } = a;
wide.onClick = 5;
show("a number in the field: typeof", () => typeof a.onClick);
show("a number in the field: called", () => a.onClick());
wide.onClick = undefined;
show("undefined in the field: called", () => a.onClick());
show("undefined in the field: keys", () => Object.keys(a).join());
wide.onClick = () => -1;
