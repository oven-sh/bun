//// default-values-see-the-parameters-and-not-the-variables-of-the-body.ts
////= text-4

const where = "outer";

function shadowedByVar(read: () => string = () => where): string {
  var where = "inner";
  return read() + " and " + where;
}

function shadowedByLet(read: () => string = () => where): string {
  let where = "inner";
  return read() + " and " + where;
}

function shadowedByFunction(read: () => string = () => typeof helper): string {
  function helper(): void {}
  return read() + " and " + typeof helper;
}
const helper = 5;

function separate(a: number, read: () => number = () => a): string {
  var a: number;
  const before = a;
  a = 99;
  return "before " + text(before) + ", variable " + text(a) + ", parameter " + text(read());
}

function shared(a: number): string {
  const read = (): number => a;
  var a: number;
  const before = a;
  a = 99;
  return "before " + text(before) + ", variable " + text(a) + ", through a closure " + text(read());
}

function written(a: number, write: (n: number) => void = n => {
  a = n;
}, read: () => number = () => a): string {
  var a: number;
  write(5);
  return "variable " + text(a) + ", parameter " + text(read());
}

function simpleList(a: number, b: number): string {
  a = 10;
  return text(arguments[0]) + " " + text(arguments[1]) + " " + text(a + b);
}

function withADefault(a: number, b: number = 2): string {
  a = 10;
  return text(arguments[0]) + " " + text(arguments[1]) + " " + text(a + b);
}

function argumentsInADefault(a: number, count: number = arguments.length, firstOne: unknown = arguments[0]): string {
  return text(a) + " " + text(count) + " " + text(firstOne);
}

function thisInAnArrowDefault(this: { tag: string }, read: () => string = () => this.tag): string {
  return read();
}

function makeCounter(start: number = 0, step: () => number = () => ++start): () => number {
  return step;
}

console.log("a var of the body: " + shadowedByVar());
console.log("a let of the body: " + shadowedByLet());
console.log("a function of the body: " + shadowedByFunction());
console.log("a var with the parameter's name: " + separate(1));
console.log("the same without a default: " + shared(1));
console.log("a default writes the parameter: " + written(1));
console.log("arguments, simple list: " + simpleList(1, 2));
console.log("arguments, with a default: " + withADefault(1));
console.log("arguments, with a default that is given: " + withADefault(1, 5));
console.log("arguments in a default: " + argumentsInADefault(7));
console.log("arguments in a default, all given: " + argumentsInADefault(7, 8, 9));
console.log("this in an arrow default: " + thisInAnArrowDefault.call({ tag: "receiver" }));

const counterA = makeCounter();
const counterB = makeCounter(10);
console.log("closures over a parameter: " + [counterA(), counterA(), counterB(), counterA(), counterB()].join());

let total = 0;
for (let i = 0; i < 2000; i++) total += separate(i).length + shadowedByVar().length;
console.log("2000 calls: " + total);
//// defensive-checks-inside-a-typed-method-are-not-folded-away.ts
////= Person-5

type Anything = number | string | boolean | null | undefined | bigint | symbol | Animal | number[] | (() => number);

interface Wide {
  number(v: Anything): string;
  string(v: Anything): string;
  dog(v: Anything): string;
  array(v: Anything): string;
  func(v: Anything): string;
}

class Careful implements Wide {
  number(n: number): string {
    if (typeof n !== "number") return "not a number: " + typeof n;
    if (n === undefined || n === null) return "nothing";
    if (Number.isNaN(n)) return "NaN";
    if (!Number.isInteger(n)) return "fraction " + n;
    return "whole " + n;
  }
  string(s: string): string {
    if (typeof s !== "string") return "not a string: " + typeof s;
    if (s == null) return "nothing";
    return "string of " + s.length;
  }
  dog(d: Dog): string {
    if (d === null) return "null";
    if (d === undefined) return "undefined";
    if (typeof d !== "object") return "not an object: " + typeof d;
    if (!(d instanceof Animal)) return "not an animal: " + Object.prototype.toString.call(d);
    if (!(d instanceof Dog)) return "an animal but not a dog";
    if (!("legs" in d)) return "a dog without legs";
    if (typeof d.legs !== "number") return "legs are " + typeof d.legs;
    return "dog on " + d.legs;
  }
  array(list: number[]): string {
    if (!Array.isArray(list)) return "not an array: " + typeof list;
    if (list.length === 0) return "empty";
    return "array of " + list.length;
  }
  func(f: () => number): string {
    if (typeof f !== "function") return "not a function: " + typeof f;
    return "function gives " + f();
  }
}

const wide: Wide = new Careful();
const legless = new Dog("legless");
const loose: { legs?: number } = legless;
delete loose.legs;
const wrongLegs = new Dog("wrong");
const wider: { legs: number | string } = wrongLegs;
wider.legs = "four";

const values: [string, Anything][] = [
  ["5", 5],
  ["2.5", 2.5],
  ["NaN", NaN],
  ["'text'", "text"],
  ["''", ""],
  ["true", true],
  ["null", null],
  ["undefined", undefined],
  ["7n", 7n],
  ["symbol", Symbol.iterator],
  ["dog", new Dog("rex")],
  ["cat", new Cat("tom")],
  ["legless dog", legless],
  ["dog with wrong legs", wrongLegs],
  ["literal", { name: "literal" }],
  ["[1]", [1]],
  ["[]", []],
  ["function", () => 3],
];

for (const [label, value] of values) {
  show(label + " as a number", () => wide.number(value));
  show(label + " as a string", () => wide.string(value));
  show(label + " as a dog", () => wide.dog(value));
  show(label + " as an array", () => wide.array(value));
  show(label + " as a function", () => wide.func(value));
}
