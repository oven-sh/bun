////= Gauge

////= Fine

const before = new Gauge();
const fine = new Fine();

let quiet = false;
const log: string[] = [];

////= text-29

////= lines-19	takeOne	g	Gauge	number	g.one

////= useOne

////= loopOne

////= lines-19	takeTwo	g	Gauge	number	g.two

////= useTwo

