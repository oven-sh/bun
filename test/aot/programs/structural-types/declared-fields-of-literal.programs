  ["dense", () => [1, 2, 3]],
  ["holes", () => new Array<number>(3)],
  ["undefined from Array.from", () => Array.from<number>({ length: 3 })],
  ["empty", () => []],
  ["only the first", firstOnly],
  ["only the second", secondOnly],
  ["zeros", () => [0, -0, 0]],
  ["NaN", () => [NaN, NaN, NaN]],
];
for (const [name, make] of makers) {
  log.length = 0;
  attempt(name + ": two with defaults", () => twoWithDefaults(make()));
  attempt(name + ": two without", () => twoWithout(make()));
  attempt(name + ": with rest", () => withRest(make()));
  attempt(name + ": the third or -1", () => skipping(make()));
  attempt(name + ": by keys", () => byKeys(make()));
  attempt(name + ": assigned", () => assigned(make()));
  attempt(name + ": swapped", () => swapped(make()));
  attempt(name + ": defaults that are counted", () => [lazyDefaults(make()), log.join()]);
}
attempt("nested: holes outside", () => nested(new Array<number[]>(1)));
attempt("nested: holes inside", () => nested([new Array<number>(1)]));
attempt("nested: dense", () => nested([[3]]));
//// destructuring-primitives-under-object-types.ts
////= show-30

type HasLength = { length: number };

function inTheParameter({ length }: HasLength): number {
  return length;
}

function renamed({ length: size }: HasLength): number {
  return size + 1;
}

function inTheBody(item: HasLength): number {
  const { length } = item;
  return length;
}

function withADefault({ length = -1 }: { length?: number }): number {
  return length;
}

function withRest(item: HasLength): [number, string[]] {
  const { length, ...others } = item;
  return [length, Object.keys(others)];
}

function assigned(item: HasLength): number {
  let length = 0;
  ({ length } = item);
  return length;
}

function nested({ item: { length } }: { item: HasLength }): number {
  return length;
}

function fromAList([first, second]: HasLength[]): number[] {
  return [first.length, second.length];
}

function inAForOf(items: HasLength[]): number {
  let total = 0;
  for (const { length } of items) total += length;
  return total;
}

function method({ toFixed }: { toFixed(digits: number): string }): string {
  return typeof toFixed + " " + toFixed.name;
}

function computed(item: HasLength, key: "length"): number {
  const { [key]: value } = item;
  return value;
}

const values: [string, HasLength][] = [
  ["literal", { length: 4 }],
  ["string", "hello"],
  ["empty string", ""],
  ["array", [1, 2]],
  ["function", inTheBody],
  ["typed array", new Uint8Array(3)],
];

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = { length: i };
  warm += inTheParameter(honest) + renamed(honest) + inTheBody(honest) + withADefault(honest) + withRest(honest)[0] + assigned(honest);
  warm += nested({ item: honest }) + fromAList([honest, honest])[1] + inAForOf([honest]) + computed(honest, "length");
}
console.log("after 2000 literals", warm);

for (const [name, value] of values) {
  attempt(name + ": in the parameter", () => inTheParameter(value));
  attempt(name + ": renamed", () => renamed(value));
  attempt(name + ": in the body", () => inTheBody(value));
  attempt(name + ": with rest", () => withRest(value));
  attempt(name + ": assigned", () => assigned(value));
  attempt(name + ": nested", () => nested({ item: value }));
  attempt(name + ": from a list", () => fromAList([value, { length: 0 }]));
  attempt(name + ": in a for-of", () => inAForOf([{ length: 1 }, value, value]));
  attempt(name + ": by a computed key", () => computed(value, "length"));
}
attempt("a default that is not needed", () => [withADefault("abc"), withADefault(""), withADefault([]), withADefault({}), withADefault({ length: undefined })]);
attempt("a method of a number", () => [method(1), method(0.5), method({ toFixed: () => "" })]);
attempt("an empty pattern", () => {
  const take = ({}: {}) => "taken";
  return [take(0), take(""), take(false), take({})];
});
//// destructuring-takes-more-than-four-kinds-of-arrays-have.ts
////= show-42

function thirdNumber(numbers: number[]): number {
  const [, , third] = numbers;
  return third + 1;
}

function thirdText(strings: string[]): number {
  const [, , third] = strings;
  return third.length;
}

function thirdPoint(points: Point[]): number {
  const [, , third] = points;
  return third.x;
}

function thirdFunction(functions: (() => number)[]): number {
  const [, , third] = functions;
  return third();
}

function kinds<T>(list: T[]): string {
  const [a, b, c, ...rest] = list;
  return typeof a + " " + typeof b + " " + typeof c + " " + rest.length;
}

function inParameters([a, b]: number[]): number {
  return a + b;
}

function withDefaults([a = 1, b = 2]: number[]): number {
  return a + b;
}

function nested([[a], [b]]: number[][]): number {
  return a + b;
}

function exchange(numbers: number[], i: number, j: number): number[] {
  [numbers[i], numbers[j]] = [numbers[j], numbers[i]];
  return numbers;
}

let total = 0;
for (let i = 0; i < 2000; i++) total += thirdNumber([1, 2, i]) + thirdText(["a", "b", "c"]) + thirdPoint([new Point(1), new Point(2), new Point(i)]) + thirdFunction([() => 1, () => 2, () => i]) + inParameters([i, 1]) + withDefaults([i]) + nested([[i], [1]]);
console.log("2000 honest rounds: " + total);

attempt("numbers", () => [thirdNumber([1, 2]), thirdNumber([]), thirdNumber([0.5, 1.5]), kinds([1, 2]), kinds<number>([])]);
attempt("strings", () => kinds(["a"]));
attempt("strings: a method", () => thirdText(["a", "b"]));
attempt("points: a member", () => thirdPoint([new Point(1)]));
attempt("functions: called", () => thirdFunction([() => 1]));
attempt("holes", () => [kinds(new Array<number>(5)), thirdNumber(new Array<number>(5))]);
attempt("in parameters", () => [inParameters([1]), inParameters([]), inParameters([1, 2, 3])]);
attempt("defaults", () => [withDefaults([]), withDefaults([5]), withDefaults(new Array<number>(2)), withDefaults([5, 6])]);
attempt("nested", () => nested([[1], []]));
attempt("nested: the inner list is missing", () => nested([[1]]));
attempt("exchanged within", () => exchange([1, 2, 3], 0, 2));
attempt("exchanged with a place past the end", () => {
  const numbers = exchange([1, 2, 3], 0, 5);
  return [show(numbers), numbers.length, typeof numbers[0], numbers[0] + 1, numbers[5] + 1];
});
attempt("exchanged with minus one", () => {
  const numbers = exchange([1, 2], 0, -1);
  return [show(numbers), Object.keys(numbers)];
});
attempt("from a string", () => {
  const [a, b, c] = "ab";
  return [a, b, typeof c];
});
attempt("from a string: a method", () => {
  const [, , c] = "ab";
  return c.length;
});
attempt("from a set and a map", () => {
  const [a, b] = new Set([1]);
  const [[k, v], second] = new Map([["k", 1]]);
  return [a, typeof b, k, v, typeof second];
});
attempt("from a split", () => {
  const [name, value] = "no equals sign".split("=");
  return [name, typeof value];
});
attempt("from a split: a method", () => {
  const [, value] = "no equals sign".split("=");
  return value.trim();
});
attempt("from a match", () => {
  const [whole, group] = /a(b)?/.exec("a") ?? [];
  return [whole, typeof group];
});

export {};
