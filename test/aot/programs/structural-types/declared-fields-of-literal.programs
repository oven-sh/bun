////= lines-19	takeThree	g	Gauge	number	g.three

////= useThree

////= loopThree

////= lines-20	takeSix	g	Gauge	number	return	g.six

////= useSix

////= loopSix

////= lines-20	takeSeven	g	Gauge	number	return	g.seven

function useSeven(label: string): void {
  attempt(label + ", an instance made before", () => before.seven);
  attempt(label + ", an instance made now", () => new Gauge().seven);
  attempt(label + ", plus one", () => before.seven + 1);
  attempt(label + ", typeof the member", () => typeof before.seven);
  attempt(label + ", is of its kind", () => typeof before.seven === "number");
  attempt(label + ", is undefined", () => before.seven === undefined);
  attempt(label + ", a typed function", () => takeSeven(before));
  attempt(label + ", a subclass instance", () => fine.seven);
  attempt(label + ", through super", () => fine.superSeven());
  attempt(label + ", from another method", () => before.all());
  attempt(label + ", own, in, and the names of the prototype", () => Object.hasOwn(before, "seven") + " " + ("seven" in before) + " " + Object.getOwnPropertyNames(Gauge.prototype).join());
  attempt(label + ", keys and for-in of an instance", () => (() => {
    let walked = "";
    for (const key in before) walked += key + ",";
    return Object.keys(before).join() + " " + walked;
  })());
}

function loopSeven(label: string, write: () => void): void {
  let honest = 0;
  let last: unknown = "nothing";
  attempt(label + ", written in the middle of a loop", () => {
    for (let i = 0; i < 2000; i++) {
      if (i === 1000) write();
      const value = before.seven;
      if (typeof value === "number") honest++;
      last = value;
    }
    return "finished";
  });
  if (!quiet) console.log(label + ", rounds that gave a number: " + honest + ", the last value: " + text(last));
}

quiet = true;
for (let i = 0; i < 2000; i++) {
  useOne("");
  useTwo("");
  useThree("");
  useSix("");
  useSeven("");
}
quiet = false;

useOne("one, untouched");
loopOne("one becomes a getter that answers a function", () => {
  Object.defineProperty(Gauge.prototype, "one", { get: () => (log.push("get one"), () => 100), configurable: true });
});
useOne("one becomes a getter that answers a function");

useTwo("two, untouched");
loopTwo("two becomes a getter that answers a number", () => {
  Object.defineProperty(Gauge.prototype, "two", { get: () => (log.push("get two"), 5), configurable: true });
});
useTwo("two becomes a getter that answers a number");

useThree("three, untouched");
loopThree("three becomes a getter that throws", () => {
  Object.defineProperty(Gauge.prototype, "three", {
    get: () => {
      throw new RangeError("three");
    },
    configurable: true,
  });
});
useThree("three becomes a getter that throws");

useSix("six, untouched");
loopSix("the getter six is replaced by another", () => {
  Object.defineProperty(Gauge.prototype, "six", { get: () => (log.push("get six"), 600), configurable: true });
});
useSix("the getter six is replaced by another");

useSeven("seven, untouched");
loopSeven("the getter seven is replaced by one that answers a string", () => {
  Object.defineProperty(Gauge.prototype, "seven", { get: () => "text", configurable: true });
});
useSeven("the getter seven is replaced by one that answers a string");

