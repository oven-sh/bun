//// each-route-alone/a-guard-takes-a-function-for-an-object.ts
////= say-7

const costs = { on: 10, off: 20 };

function claims(v: (() => number) | Task): v is Task {
  return true;
}

function make(): (() => number) | Task {
  return () => 1;
}

const v = make();
if (claims(v)) {
  say("typeof v", typeof v);
  say("v.cost", v.cost);
  say("v.cost * 2", v.cost * 2);
}
//// each-route-alone/a-guard-takes-a-literal-for-a-class.ts
////= say-7

const costs = { on: 10, off: 20 };

function claims(v: Task | { price: number }): v is Task {
  return true;
}

function make(): Task | { price: number } {
  return { price: 4 };
}

const v = make();
if (claims(v)) {
  say("v.cost", v.cost);
  say("v.cost * 2", v.cost * 2);
  say("v instanceof Task", v instanceof Task);
}
