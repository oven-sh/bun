////: edgeOrRadius
function edgeOrRadius(s: Circle | Square): string {
  if ("edge" in s) return "edge " + typeof s.edge + " " + String(s.edge) + " " + s.corner;
  return "radius " + typeof s.radius + " " + String(s.radius);
}
////: edgeOrRadius-2
function edgeOrRadius(s: Circle | Square): string {
  if ("edge" in s) return "edge " + typeof s.edge + " " + String(s.edge);
  return "radius " + s.radius;
}
////: for-22
for (let i = 0; i < 2000; i++) {
  shared.size = i;
  sum += shared.size;
}
////: for-4
for (let i = 0; i < 2000; i++) {
  const c = new Cell();
  if (typeof c.value === "number" && c.leaf !== null) sum += c.value + c.leaf.weight;
}
////: for-5
for (let i = 0; i < 2000; i++) {
  const c = new Cell();
  sum += c.count + c.run() + (c.ready ? 1 : 0) + c.title.length;
}
////: if
if (typeof cell.value === "number" && cell.leaf !== null) {
  change(cell);
  say("value", cell.value);
  say("value plus one", cell.value + 1);
  say("value doubled", cell.value * 2);
  say("leaf", cell.leaf === null ? "null" : "a leaf");
}
////: if-2
if (typeof values[0] === "number" && leaves[0] !== null) {
  change();
  say("the first value", values[0]);
  say("the first value plus one", values[0] + 1);
  say("the first leaf", leaves[0] === null ? "null" : "a leaf");
}
////: if-3
if ("edge" in square) {
  change(square);
  say("edge", square.edge);
  say("edge doubled", square.edge * 2);
  say("in", "edge" in square);
}
////: if-4
if (claims(v)) {
  say("v", v);
  say("v + 1", v + 1);
  say("v * 2", v * 2);
  say("v | 0", v | 0);
}
