////: Box
class Box {
  kept = 0;
  other = 5;
  get size(): number {
    return this.kept;
  }
  set size(value: number) {
    this.kept = value + 1;
  }
}
////: Cell
class Cell {
  count = 1;
  ready = false;
  title = "a";
  run: () => number = () => 1;
  other = 5;
}
////: Cell-2
class Cell {
  value: number | string = 1;
  leaf: Leaf | null = new Leaf();
  other = 5;
}
////: Other
class Other {
  price = 4;
}
////: Task
class Task {
  cost = 3;
}
////: Wide-2
interface Wide {
