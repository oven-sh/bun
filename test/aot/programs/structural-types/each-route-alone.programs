//// every-way-to-store-a-cat-into-dogs.ts
////= show-33

function helper(list: Animal[], animal: Animal): void {
  list[0] = animal;
}

function genericPush<T>(list: T[], item: T): void {
  list.push(item);
}

const ways: [string, (animals: Animal[], cat: Cat) => void][] = [
  ["push", (animals, cat) => void animals.push(cat)],
  ["an index store", (animals, cat) => void (animals[1] = cat)],
  ["an index store past the end", (animals, cat) => void (animals[animals.length] = cat)],
  ["splice in", (animals, cat) => void animals.splice(1, 0, cat)],
  ["splice over", (animals, cat) => void animals.splice(0, 2, cat)],
  ["fill", (animals, cat) => void animals.fill(cat)],
  ["fill one", (animals, cat) => void animals.fill(cat, 1)],
  ["unshift", (animals, cat) => void animals.unshift(cat)],
  ["a destructuring assignment", (animals, cat) => void ([animals[0]] = [cat])],
  ["a swap by destructuring", (animals, cat) => void ([animals[0], animals[1]] = [cat, animals[0]])],
  ["an object pattern", (animals, cat) => void ({ cat: animals[1] } = { cat })],
  ["a for-of target", (animals, cat) => {
    for (animals[1] of [cat]);
  }],
  ["a helper", (animals, cat) => helper(animals, cat)],
  ["a generic helper", (animals, cat) => genericPush(animals, cat)],
  ["push.call", (animals, cat) => void Array.prototype.push.call(animals, cat)],
  ["Object.assign", (animals, cat) => void Object.assign(animals, [cat])],
  ["Reflect.set", (animals, cat) => void Reflect.set(animals, 1, cat)],
  ["defineProperty", (animals, cat) => void Object.defineProperty(animals, 1, { value: cat, writable: true, enumerable: true, configurable: true })],
  ["a getter at an index", (animals, cat) => void Object.defineProperty(animals, 1, { get: () => cat, enumerable: true, configurable: true })],
  ["a logical assignment", (animals, cat) => void (animals[5] ??= cat)],
];

function legs(dogs: Dog[]): unknown[] {
  const seen: unknown[] = [];
  for (let i = 0; i < dogs.length; i++) seen.push(i in dogs ? dogs[i].legs : "hole");
  return seen;
}

////= totalLegs

function barks(dogs: Dog[]): string {
  return dogs.map(dog => dog.bark()).join();
}

function names(dogs: Dog[]): string {
  return dogs.map(dog => dog.name + ":" + dog.constructor.name).join();
}

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = [new Dog("a"), new Dog("b")];
  warm += legs(honest).length + totalLegs(honest) + barks(honest).length + names(honest).length;
}
console.log("after 2000 honest kennels", warm);

for (const [way, store] of ways) {
  const make = (): Dog[] => {
    const dogs = [new Dog("rex"), new Dog("fido")];
    store(dogs, new Cat("tom"));
    return dogs;
  };
  attempt(way + ": names", () => names(make()));
  attempt(way + ": legs", () => legs(make()));
  attempt(way + ": total legs", () => totalLegs(make()));
  attempt(way + ": barks", () => barks(make()));
}
//// every-way-to-store-to-an-exported-variable-of-a-namespace.ts
////= text-11

namespace Board {
  export let score: number = 0;
  export let title: string = "start";
  export let maybe: number | undefined;
  export let flag: boolean = false;
  export function assign(n: number): number {
    return (score = n);
  }
  export function raise(): number[] {
    return [score++, ++score, score--, --score];
  }
  export function compound(): number[] {
    return [(score += 5), (score -= 1), (score *= 2), (score /= 4), (score **= 2), (score %= 7), (score <<= 2), (score |= 1)];
  }
  export function logical(): unknown[] {
    return [(maybe ??= 3), (maybe ??= 4), (flag ||= true), (flag &&= false)];
  }
  export function fromList(list: [number, string]): void {
    [score, title] = list;
  }
  export function fromObject(from: { score: number; title: string }): void {
    ({ score, title } = from);
  }
  export function fromObjectByOtherNames(from: { a: number; b: string }): void {
    ({ a: score, b: title } = from);
  }
  export function withDefaults(from: { score?: number }): void {
    ({ score = 99 } = from);
  }
  export function loopOf(list: number[]): number {
    let rounds = 0;
    for (score of list) rounds++;
    return rounds;
  }
  export function loopIn(from: Record<string, number>): number {
    let rounds = 0;
    for (title in from) rounds++;
    return rounds;
  }
  export function shorthand(): { score: number; title: string } {
    return { score, title };
  }
  export function inClosure(): () => number {
    return () => ++score;
  }
  export function shadowed(score: number): number {
    score++;
    return score;
  }
}

function state(): unknown[] {
  return [Board.score, Board.title, Board.maybe, Board.flag];
}

show("at first", () => state());
show("=", () => [Board.assign(4), state()]);
show("++ and --", () => [Board.raise(), state()]);
show("compound", () => [Board.compound(), state()]);
show("logical", () => [Board.logical(), state()]);
show("taken apart from a list", () => [Board.fromList([7, "list"]), state()]);
show("taken apart from an object", () => [Board.fromObject({ score: 8, title: "object" }), state()]);
show("taken apart by other names", () => [Board.fromObjectByOtherNames({ a: 9, b: "names" }), state()]);
show("taken apart with a default", () => [Board.withDefaults({}), state()]);
show("for of", () => [Board.loopOf([1, 2, 3]), state()]);
show("for in", () => [Board.loopIn({ k: 1, last: 2 }), state()]);
show("shorthand", () => Board.shorthand());
show("in a closure", () => [Board.inClosure()(), state()]);
show("a parameter of the same name", () => [Board.shadowed(50), state()]);
show("from outside", () => {
  Board.score = 1.5;
  Board.score++;
  [Board.score, Board.title] = [Board.score + 1, "outside"];
  return [state(), Board.shorthand()];
});
show("keys", () => Object.keys(Board).slice(0, 4));
show("did globals appear", () => ["score" in globalThis, "title" in globalThis]);

let sum = 0;
for (let i = 0; i < 2000; i++) {
  Board.assign(i);
  Board.raise();
  sum += Board.score;
}
show("2000 rounds", () => sum);
//// excess-members-get-past-the-check-by-way-of-a-variable.ts
////= lines-27	Options	size	number	label	string

function summary(o: Options): string {
  return o.label + "/" + o.size + "/" + Object.keys(o).join() + "/" + JSON.stringify(o);
}

////= lines-276	identity	T	value

function build(): { debug: boolean; size: number; label: string; depth: number } {
  return { debug: true, size: 2, label: "built", depth: 9 };
}

class Widget {
  options: Options;
  constructor(options: Options) {
    this.options = options;
  }
  summary(): string {
    return summary(this.options);
  }
}

const variable = { color: "red", size: 1, label: "variable" };
console.log("a variable: " + summary(variable));

console.log("a result: " + summary(build()));

console.log("a generic call: " + summary(identity({ size: 3, label: "generic", extra: [1, 2] })));

const spreadSource = { size: 4, label: "spread", more: "more" };
console.log("a spread in the literal: " + summary({ ...spreadSource }));
console.log("a spread and a member: " + summary({ ...spreadSource, size: 40 }));

const list = [{ size: 5, label: "element", index: 0 }];
console.log("an element: " + summary(list[0]));

const nested = { inner: { label: "nested", other: null, size: 6 } };
console.log("a member: " + summary(nested.inner));

const other = { first: 1, size: 7, label: "conditional" };
console.log("a conditional: " + summary(list.length > 0 ? other : variable));

const assigned = Object.assign({ size: 8, label: "assigned" }, { late: true });
console.log("Object.assign: " + summary(assigned));

const [destructured] = [{ label: "destructured", size: 9, tail: "tail" }];
console.log("a pattern: " + summary(destructured));

class Rich {
  hidden = "hidden";
  size = 10;
  label = "instance";
  extra = 0;
}
console.log("an instance: " + summary(new Rich()));

console.log("a field: " + new Widget(variable).summary());
console.log("a field from a result: " + new Widget(build()).summary());

const all: Options[] = [variable, build(), spreadSource, list[0], nested.inner, assigned, destructured, new Rich()];
console.log("all sizes: " + all.map(o => o.size).join());
console.log("all labels: " + all.map(o => o.label).join());
console.log("all counts: " + all.map(o => Object.keys(o).length).join());
console.log("all as json: " + JSON.stringify(all));

const captured = () => summary(variable) + " " + summary(all[1]);
console.log("captured: " + captured());

let widest: Options = { size: 0, label: "none" };
for (const o of all) if (Object.keys(o).length > Object.keys(widest).length) widest = o;
console.log("the widest: " + summary(widest));
//// experimental-decorators-emit-the-types-of-members-as-metadata/main.ts
export {};

declare global {
  namespace Reflect {
    function metadata(key: string, value: unknown): (target: object, member?: string | symbol) => void;
  }
}

const seen: string[] = [];

function nameOf(value: unknown): string {
  if (Array.isArray(value)) return "[" + value.map(nameOf).join(" ") + "]";
  return typeof value === "function" ? value.name : String(value);
}

Reflect.metadata = (key, value) => (target, member) => {
  seen.push(String(member ?? "the class") + " " + key + " " + nameOf(value));
};

function noted(target: object, member?: string | symbol, extra?: unknown): void {}

