////= Point-17

const key: "norm" = ["no", "rm"].join("") === "norm" ? "norm" : "norm";

////= ways

////= round-3

const p = new Point();
let warm = 0;
for (let i = 0; i < 2000; i++) for (const [, run] of ways) warm += run(p).length;
console.log("2000 honest: " + warm);
