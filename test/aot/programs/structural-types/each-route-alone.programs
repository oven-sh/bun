//// each-route-alone/tag-stored-by-a-setter-on-a-new-prototype.ts
////= say-4

type Tagged = { kind: "circle" | "square" };

function retag(c: Circle): void {
  const loose: Tagged & { alias?: "circle" | "square" } = c;
  const parent: Tagged & { alias: "circle" | "square" } = {
    kind: "circle",
    set alias(value: "circle" | "square") {
      this.kind = value;
    },
  };
  Object.setPrototypeOf(c, parent);
  loose.alias = "square";
}

