class Pixel {
  color: Color = Color.Red;
  flag: Flag = Flag.Off;
  level: 1 | 2 | 3 = 1;
  read(): string {
    return show(this.color) + " " + show(this.flag) + " " + show(this.level);
  }
  sum(): number {
    return this.color + this.flag + this.level;
  }
  isRed(): boolean {
    return this.color === Color.Red;
  }
}

function paint(p: Pixel, color: Color, flag: Flag): void {
  p.color = color;
  p.flag = flag;
}

