const log: string[] = [];

////= attempt-2

let calls = 0;
function counted(n: number): number {
  calls++;
  return n;
}

enum Size {
  Small = "ab".length,
  Medium = Small * 2,
  Large = counted(10),
  Huge = Math.floor(99.9),
  Odd = counted(0.5),
  Missing = counted(NaN),
  Negative = -counted(0),
}

enum Flags {
  None = 0,
  Read = 1 << 0,
  Write = 1 << 1,
  All = Read | Write,
  High = 1 << 31,
  Top = 1 << 30,
}

enum Mixed {
  No = 0,
  Yes = "YES",
  Count = "abc".length,
}

enum Gaps {
  A = 5,
  B,
  C = 1,
  D,
  E = D,
}

////= lines-40	sizeName	s	Size	string	Size[s

////= lines-42	sizePlus	s	Size	number	s	1

function can(f: Flags, wanted: Flags): boolean {
  return (f & wanted) === wanted;
}

