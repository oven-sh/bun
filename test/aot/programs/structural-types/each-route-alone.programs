//// every-object-is-taken-for-a-type-whose-members-are-all-optional.ts
// A type whose members are all optional takes every object: one filled by name, a literal, an empty literal, an array, a Map. Reads, stores, spread, destructuring with defaults, fields and lists of such a type behave as in plain Bun.
interface Options { module?: number; target?: number; strict?: boolean; name?: string; nested?: Options }
interface Loose { [key: string]: unknown; id?: number }
type Some = Partial<{ a: number; b: string }>;
function parse(names: string[]): Options { const options: Record<string, unknown> = {}; for (const name of names) options[name] = 1; return options as Options; }
function target(o: Pick<Options, "module" | "target">): number { return (o.target ?? 0) + (o.module ?? 0); }
function fill(o: Options, i: number): Options { o.target = i; o.name = "n" + i; o.nested = { strict: true }; return o; }
function describe(o: Options): string { return `${o.name}${o.target}${o.strict}${o.nested?.strict}${Object.keys(o).length}`; }
function loose(l: Loose): number { return (l.id ?? 0) + Object.keys(l).length; }
function some(s: Some): string { return (s.a ?? 1) + (s.b ?? "b"); }
function merge(a: Options, b: Options): Options { return { ...a, ...b }; }
function pick({ target = 3, strict }: Options): number { return target + (strict ? 1 : 0); }
class Holder { options: Options = {}; set(o: Options) { this.options = o; return this.options.target ?? -1; } }
function list(all: Options[]): number { let n = 0; for (const o of all) n += o.target ?? 0; return n; }
let n = 0, t = "";
const parsed = parse(["module", "target"]);
const holder = new Holder();
for (let i = 0; i < 100; i++) {
  n += target(parsed) + target({ target: i }) + target({}) + target(new Holder().options) + target([] as Options) + target(new Map() as Options);
  t = describe(fill({}, i)) + describe(fill(parse(["module"]), i)) + describe(merge(parsed, { name: "m" }));
  n += loose({ id: 1, x: 2 }) + loose({}) + loose(parsed as Loose);
  t += some({}) + some({ a: 2 }) + some({ b: "c", a: 3 });
  n += pick(parsed) + pick({ strict: true }) + holder.set(parsed) + holder.set({ target: i }) + list([parsed, {}, { target: 2 }]);
}
console.log(n, t);
//// every-place-where-a-later-block-reads-an-export-of-an-earlier-block.ts
////= text-11

namespace Shop {
  export let stock: number = 3;
  export const label: string = "shop";
  export let missing: number;
}

namespace Shop.Back {
  export let shelves: number = 2;
}

namespace Shop {
  export function plain(): number {
    return stock;
  }
  export function shorthand(): { stock: number; label: string } {
    return { stock, label };
  }
  export function kind(): string[] {
    return [typeof stock, typeof label, typeof missing];
  }
  export function byDefault(n: number = stock): number {
    return n;
  }
  export function inTemplate(): string {
    return `${label}:${stock}`;
  }
  export function inClosure(): () => number {
    return () => stock * 2;
  }
  export function inList(): number[] {
    return [stock, ...[stock]];
  }
  export function asArgument(): number {
    return Math.max(stock, 1);
  }
  export function asKey(): Record<string, number> {
    return { [label]: stock };
  }
  export function neverStored(): unknown[] {
    return [missing, missing + 1, missing ?? "default"];
  }
  export class Clerk {
    seen: number = stock;
    static atStart: number = stock;
    count(): number {
      return stock + this.seen;
    }
  }
  export namespace Front {
    export function outer(): number {
      return stock;
    }
    export function sibling(): number {
      return Back.shelves;
    }
  }
  export const copied: number = stock;
}

namespace Shop.Back {
  export function shelvesNow(): number {
    return shelves;
  }
  export function stockNow(): number {
    return stock;
  }
}

function all(): unknown[] {
  return [
    Shop.plain(),
    Shop.shorthand(),
    Shop.kind(),
    Shop.byDefault(),
    Shop.inTemplate(),
    Shop.inClosure()(),
    Shop.inList(),
    Shop.asArgument(),
    Shop.asKey(),
    new Shop.Clerk().seen,
    new Shop.Clerk().count(),
    Shop.Clerk.atStart,
    Shop.Front.outer(),
    Shop.Front.sibling(),
    Shop.Back.shelvesNow(),
    Shop.Back.stockNow(),
    Shop.copied,
  ];
}

show("at first", () => all());
show("the one without a value", () => Shop.neverStored());
Shop.stock = 10;
Shop.Back.shelves = 20;
show("after stores from outside", () => all());
Shop.missing = 1;
show("the one without a value, stored", () => Shop.neverStored());
show("keys", () => [Object.keys(Shop), Object.keys(Shop.Back), Object.keys(Shop.Front)]);

let sum = 0;
for (let i = 0; i < 2000; i++) {
  Shop.stock = i;
  sum += Shop.plain() + Shop.byDefault() + Shop.Front.outer() + Shop.Back.stockNow();
}
show("2000 rounds", () => sum);
//// every-way-a-dog-keeper-becomes-a-keeper.ts
////= Person-5

////= lines-84	Keeper	legsOf	a	Animal	number

class DogKeeper implements Keeper {
  legsOf(d: Dog): number {
    return d.legs + 1;
  }
}

const cat: Animal = new Cat("tom");
const dog: Animal = new Dog("rex");

function test(way: string, keeper: Keeper): void {
  show(way + ": cat", () => keeper.legsOf(cat));
  show(way + ": dog", () => keeper.legsOf(dog));
}

function returned(): Keeper {
  return new DogKeeper();
}
////= lines-276	identity	T	value
function defaulted(keeper: Keeper = new DogKeeper()): Keeper {
  return keeper;
}
function rest(...keepers: Keeper[]): Keeper {
  return keepers[0];
}
function* yielded(): Generator<Keeper> {
  yield new DogKeeper();
}
class Holder {
  keeper: Keeper = new DogKeeper();
  static shared: Keeper = new DogKeeper();
  constructor(public given: Keeper) {}
}

const variable: Keeper = new DogKeeper();
test("a variable", variable);
test("an argument", new DogKeeper());
test("a result", returned());
test("a type argument", identity<Keeper>(new DogKeeper()));
test("a default", defaulted());
test("a rest parameter", rest(new DogKeeper()));
test("a field", new Holder(new DogKeeper()).keeper);
test("a parameter property", new Holder(new DogKeeper()).given);
test("a static field", Holder.shared);

const dogKeepers: DogKeeper[] = [new DogKeeper()];
const asList: Keeper[] = dogKeepers;
test("an array of them", asList[0]);
test("a spread array", [...dogKeepers][0]);
const literalList: Keeper[] = [new DogKeeper()];
test("an array literal", literalList[0]);
const tuple: [Keeper, number] = [new DogKeeper(), 1];
test("a tuple", tuple[0]);
const record: Record<string, Keeper> = { k: new DogKeeper() };
test("a record", record.k);
test("values of a record", Object.values(record)[0]);
const nested: { inner: { keeper: Keeper } } = { inner: { keeper: new DogKeeper() } };
test("a nested literal", nested.inner.keeper);
const { inner: { keeper: destructured } } = nested;
test("destructured", destructured);
const conditional: Keeper = cat.name.length > 0 ? new DogKeeper() : { legsOf: () => 0 };
test("a conditional", conditional);
const maybe: Keeper | null = cat.name.length > 0 ? new DogKeeper() : null;
if (maybe !== null) test("a union with null", maybe);
const missing: DogKeeper | undefined = undefined;
test("after ??", missing ?? new DogKeeper());
test("after ||", missing || new DogKeeper());
test("after a comma", (dog.name.trim(), new DogKeeper()));
for (const keeper of yielded()) test("yielded", keeper);
for (const keeper of new Set<Keeper>([new DogKeeper()])) test("from a set", keeper);
const fromMap = new Map<number, Keeper>([[1, new DogKeeper()]]).get(1);
if (fromMap !== undefined) test("from a map", fromMap);
const made: () => Keeper = () => new DogKeeper();
test("a function type's result", made());
const makesDogKeeper = (): DogKeeper => new DogKeeper();
const widened: () => Keeper = makesDogKeeper;
test("a function type widened", widened());
class SubKeeper extends DogKeeper {}
test("a subclass", new SubKeeper());
test("Object.assign", Object.assign(new DogKeeper(), { extra: 1 }));
test("Object.create", Object.create(new DogKeeper()));

Promise.resolve<Keeper>(new DogKeeper()).then(keeper => {
  test("a promise", keeper);
  return (async (): Promise<Keeper> => new DogKeeper())();
}).then(keeper => test("an async result", keeper));
