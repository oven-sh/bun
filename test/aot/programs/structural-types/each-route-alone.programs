attempt("plus one", () => [sizePlus(Size.Small), sizePlus(Size.Odd), sizePlus(Size.Missing), sizePlus(Size.Negative)]);
attempt("one over the negative member", () => 1 / Size.Negative);
attempt("any literal is a Size", () => {
