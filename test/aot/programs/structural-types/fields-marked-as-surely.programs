for (const [name, make] of letters) {
  attempt("for-of over a " + name, () => each(make()));
  attempt("spread of a " + name, () => spreadOut(make()));
  attempt("first two of a " + name, () => firstTwo(make()));
  attempt("by hand over a " + name, () => byHand(make()));
