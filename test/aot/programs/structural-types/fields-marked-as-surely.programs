//// flags-joined-by-or-are-typed-as-the-enum-and-are-no-member.ts
////= show-35

enum Flag {
  None = 0,
  Read = 1,
  Write = 2,
  Run = 4,
}

const labels: Record<Flag, string> = { [Flag.None]: "none", [Flag.Read]: "read", [Flag.Write]: "write", [Flag.Run]: "run" };
const words = ["zero", "one", "two", "three", "four"];

function nameOf(flag: Flag): string {
  switch (flag) {
    case Flag.None:
      return "none";
    case Flag.Read:
      return "read";
    case Flag.Write:
      return "write";
    case Flag.Run:
      return "run";
  }
}

function has(flags: Flag, one: Flag): boolean {
  return (flags & one) === one;
}

function add(flags: Flag, one: Flag): Flag {
  return flags | one;
}

function remove(flags: Flag, one: Flag): Flag {
  return flags & ~one;
}

class Entry {
  mode: Flag = Flag.None;
  grant(one: Flag): this {
    this.mode |= one;
    return this;
  }
  describe(): string {
    return nameOf(this.mode) + "/" + Flag[this.mode] + "/" + labels[this.mode];
  }
}

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const flag: Flag = 1 << (i % 3);
  warm += nameOf(flag).length + labels[flag].length + Flag[flag].length + (has(flag, Flag.Read) ? 1 : 0);
}
console.log("2000 honest rounds", warm);

const made: [string, Flag][] = [
  ["read | write", Flag.Read | Flag.Write],
  ["all three", Flag.Read | Flag.Write | Flag.Run],
  ["~read", ~Flag.Read],
  ["~none", ~Flag.None],
  ["run + 1", Flag.Run + 1],
  ["run << 29", Flag.Run << 29],
  ["run * 2 ** 29", Flag.Run * 2 ** 29],
  ["~read >>> 0", ~Flag.Read >>> 0],
  ["read / 2", Flag.Read / 2],
  ["-none", -Flag.None],
  ["read % none", Flag.Read % Flag.None],
];

for (const [label, flag] of made) {
  attempt(label + " value", () => flag);
  attempt(label + " name", () => nameOf(flag));
  attempt(label + " length of the name", () => nameOf(flag).length);
  attempt(label + " reverse", () => Flag[flag]);
  attempt(label + " label", () => labels[flag]);
  attempt(label + " word", () => words[flag]);
  attempt(label + " has read, write, run", () => [has(flag, Flag.Read), has(flag, Flag.Write), has(flag, Flag.Run)]);
  attempt(label + " add and remove", () => [add(flag, Flag.Run), remove(flag, Flag.Read), remove(add(flag, Flag.Run), flag)]);
  attempt(label + " in a field", () => {
    const entry = new Entry();
    entry.mode = flag;
    return [entry.mode, entry.describe(), entry.grant(Flag.Write).mode];
  });
}

attempt("granted one by one", () => new Entry().grant(Flag.Read).grant(Flag.Run).describe());
attempt("honest again", () => [nameOf(Flag.Run), labels[Flag.Write], Flag[Flag.Read], new Entry().grant(Flag.Write).describe()]);
//// flags-with-the-top-bit-are-tested-and-shifted.ts
enum Bit {
  None = 0,
  Low = 1,
  Top = 1 << 31,
  All = ~0,
}

function has(bits: Bit, bit: Bit): boolean {
  return (bits & bit) === bit;
}
function hasAny(bits: Bit, bit: Bit): boolean {
  return (bits & bit) !== 0;
}
function unsigned(bits: Bit): number {
  return bits >>> 0;
}
function without(bits: Bit, bit: Bit): Bit {
  return bits & ~bit;
}

console.log(Bit.Top, Bit.All, Bit[Bit.Top], Bit[Bit.All], Bit[-1], Bit[2147483648]);
console.log(has(Bit.All, Bit.Top), has(Bit.Top, Bit.Low), hasAny(Bit.Top, Bit.All), unsigned(Bit.Top), unsigned(Bit.All));
console.log(without(Bit.All, Bit.Top), without(Bit.Top, Bit.Top), without(Bit.None, Bit.All));
const wideTop: number = 2 ** 31;
const topBit: Bit = wideTop;
console.log(topBit === Bit.Top, has(topBit, Bit.Top), hasAny(topBit, Bit.Top), unsigned(topBit), topBit | 0, Bit[topBit]);
const doubled: Bit = Bit.Top * 2;
console.log(doubled, doubled | 0, has(doubled, Bit.Top), unsigned(doubled));
const summed: Bit = Bit.Top + Bit.Top + Bit.Low;
console.log(summed, summed | 0, has(summed, Bit.Low), unsigned(summed));
let walking: Bit = Bit.Low;
let steps = 0;
while (walking !== Bit.None && steps < 40) {
  walking <<= 1;
  steps++;
}
console.log(steps, walking);
//// for-await-walks-a-sync-generator-that-throws-or-yields-a-rejection.ts
////= text-14

let log: string[] = [];

function* throwsInTheMiddle(): Generator<number, void, void> {
  try {
    yield 1;
    throw new RangeError("in the middle");
  } finally {
    log.push("finally");
  }
}

function* yieldsARejection(): Generator<number | Promise<number>, void, void> {
  try {
    yield 1;
    yield Promise.reject(new TypeError("rejected"));
    log.push("went on after the rejection");
    yield 3;
  } catch (error) {
    log.push("the generator caught " + failure(error));
  } finally {
    log.push("finally");
  }
}

function* returnsAPromise(): Generator<number, Promise<string>, void> {
  yield 1;
  return Promise.resolve("the end");
}

function* returnsARejection(): Generator<number, Promise<string>, void> {
  yield 1;
  return Promise.reject(new SyntaxError("at the end"));
}

function* yieldsInFinally(): Generator<number, void, void> {
  try {
    yield 1;
    yield 2;
  } finally {
    log.push("finally begins");
    yield 100;
    log.push("finally ends");
  }
}

function* throwsInFinally(): Generator<number, void, void> {
  try {
    yield 1;
    yield 2;
  } finally {
    log.push("finally throws");
    throw new EvalError("from finally");
  }
}

async function walk(items: Iterable<number | PromiseLike<number>>, stopAt: number): Promise<string> {
  const seen: string[] = [];
  try {
    for await (const n of items) {
      seen.push(text(n));
      if (n === stopAt) break;
    }
  } catch (error) {
    return seen.join() + " then " + failure(error);
  }
  return seen.join() + " then the loop ended";
}

async function bodyThrows(items: Iterable<number | PromiseLike<number>>): Promise<string> {
  try {
    for await (const n of items) throw new URIError("body " + n);
  } catch (error) {
    return failure(error);
  }
  return "empty";
}

const makers: [string, () => Iterable<number | PromiseLike<number>>][] = [
  ["throws in the middle", throwsInTheMiddle],
  ["yields a rejection", yieldsARejection],
  ["returns a promise", returnsAPromise],
  ["returns a rejection", returnsARejection],
  ["yields in finally", yieldsInFinally],
  ["throws in finally", throwsInFinally],
];

for (const [label, make] of makers) {
  log = [];
  console.log(label + ", to the end: " + (await walk(make(), -1)) + " [" + log.join(", ") + "]");
  log = [];
  console.log(label + ", left at 1: " + (await walk(make(), 1)) + " [" + log.join(", ") + "]");
  log = [];
  console.log(label + ", the body throws: " + (await bodyThrows(make())) + " [" + log.join(", ") + "]");
}

async function* relay(items: Iterable<number | PromiseLike<number>>): AsyncGenerator<number, string, void> {
  yield* items;
  return "relayed";
}

for (const [label, make] of makers) {
  log = [];
  const seen: string[] = [];
  try {
    const relaying = relay(make());
    for (let r = await relaying.next(); ; r = await relaying.next()) {
      seen.push(text(r.value));
      if (r.done) break;
    }
  } catch (error) {
    seen.push(failure(error));
  }
  console.log(label + ", through yield* of an async generator: " + seen.join(" | ") + " [" + log.join(", ") + "]");
}

