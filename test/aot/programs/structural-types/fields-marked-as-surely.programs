  ["string", () => "abc"],
  ["empty string", () => ""],
  ["one letter", () => "z"],
  ["string with a pair of surrogates", () => "a\u{1F600}b"],
  ["string with half a pair", () => "a\uD83Db"],
  ["set", () => new Set(["a", "b", "a"])],
  ["generator", abc],
  ["keys of a map", () => new Map([["k", 1]]).keys()],
  ["String object", () => new String("ab")],
