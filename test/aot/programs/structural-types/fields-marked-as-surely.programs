//// function-typed-unions-and-optional-callbacks-are-called.ts
////= text-12

type Formatter = ((n: number) => string) | string | null;
type Listener = (() => void) | { handle(): void };

function format(f: Formatter, n: number): string {
  if (typeof f === "function") return f(n);
  if (f === null) return String(n);
  return f + n;
}

const log: string[] = [];
function notify(l: Listener): void {
  if (typeof l === "function") l();
  else l.handle();
}
function notifyByMember(l: Listener): void {
  if ("handle" in l) l.handle();
  else l();
}

function withCallback(n: number, done?: (result: number) => void): number {
  const result = n * 2;
  done?.(result);
  return result;
}
function withDefault(n: number, map: (n: number) => number = x => x + 1): number {
  return map(n);
}

show("a function", () => format(n => "<" + n + ">", 1));
show("a string", () => format("#", 1));
show("null", () => format(null, 1));
show("a built-in", () => format(String, 1));
show("a bound function", () => format(String.bind(null), 1));
show("a proxy", () => format(new Proxy((n: number) => "proxied " + n, {}), 1));

const both = Object.assign(() => { log.push("called"); }, { handle() { log.push("handled"); } });
notify(() => { log.push("plain function"); });
notify({ handle() { log.push("plain object"); } });
notify(both);
notifyByMember(() => { log.push("plain function"); });
notifyByMember({ handle() { log.push("plain object"); } });
notifyByMember(both);
class Handler {
  handle(): void {
    log.push("class instance");
  }
  static handle(): void {
    log.push("static side");
  }
}
notify(new Handler());
notifyByMember(new Handler());
show("a class with a static handle, by typeof", () => notify(Handler));
show("a class with a static handle, by member", () => notifyByMember(Handler));
show("log", () => log.join());

let seen = -1;
show("no callback", () => withCallback(2));
show("undefined", () => withCallback(2, undefined));
show("a callback", () => withCallback(2, r => { seen = r; }) + " " + seen);
show("default", () => withDefault(1));
show("undefined takes the default", () => withDefault(1, undefined));
show("given", () => withDefault(1, x => x * 10));
show("a built-in given", () => withDefault(-1, Math.abs));

let total = 0;
for (let i = 0; i < 2000; i++) total += withCallback(1, i % 2 === 0 ? undefined : r => { total += r; });
show("2000 calls, every other one with a callback", () => total);
//// functions-and-arrows-inside-a-method-see-another-this.ts
////= show-6

class Panel {
  width: number = 4;
  items: number[] = [1, 2];
  viaArrow(): number {
    const inner = (): number => this.width;
    return inner();
  }
  viaFunction(): string {
    const inner = function (this: unknown): string {
      return typeof this;
    };
    return inner();
  }
  viaCallbackArrow(): number[] {
    return this.items.map(item => item * this.width);
  }
  viaCallbackFunction(): string[] {
    return this.items.map(function (this: unknown): string {
      return typeof this;
    });
  }
  viaCallbackFunctionWithThis(): number[] {
    return this.items.map(function (this: Panel, item: number): number {
      return item * this.width;
    }, this);
  }
  makeReader(): () => number {
    return () => this.width;
  }
  makeWriter(): (n: number) => void {
    return n => {
      this.width = n;
    };
  }
  nestedObject(): number {
    const inner = {
      width: 400,
      read(): number {
        return this.width;
      },
      arrow: (): number => this.width,
    };
    return inner.read() + inner.arrow();
  }
  withDefault(n: number = this.width): number {
    return n;
  }
}

const panel = new Panel();
show("honest viaArrow", () => panel.viaArrow());
show("honest viaFunction", () => panel.viaFunction());
show("honest viaCallbackArrow", () => panel.viaCallbackArrow().join());
show("honest viaCallbackFunction", () => panel.viaCallbackFunction().join());
show("honest viaCallbackFunctionWithThis", () => panel.viaCallbackFunctionWithThis().join());
show("honest nestedObject", () => panel.nestedObject());
show("honest withDefault", () => panel.withDefault());

const { viaArrow, viaFunction, viaCallbackArrow, makeReader, makeWriter, nestedObject, withDefault } = panel;
show("bare viaArrow", () => viaArrow());
show("bare viaFunction", () => viaFunction());
show("bare viaCallbackArrow", () => viaCallbackArrow());
show("bare nestedObject", () => nestedObject());
show("bare withDefault", () => withDefault());
show("bare withDefault, given", () => withDefault(9));
show("bare makeReader does not throw", () => typeof makeReader());
show("what it made does", () => makeReader()());
show("what the bare makeWriter made", () => makeWriter()(5));

const like = { width: 40, items: [10] };
const reader = panel.makeReader.call(like);
const writer = panel.makeWriter.call(like);
show("a reader made for a look-alike", () => reader());
writer(41);
show("after its writer ran", () => reader() + " " + like.width + " " + panel.width);
show("viaCallbackArrow on a look-alike", () => panel.viaCallbackArrow.call(like).join());
show("viaCallbackFunctionWithThis on a look-alike", () => panel.viaCallbackFunctionWithThis.call(like).join());
show("nestedObject on a look-alike", () => panel.nestedObject.call(like));
show("withDefault on a look-alike", () => panel.withDefault.call(like));
show("withDefault on a wrong look-alike", () => panel.withDefault.call({ width: "wide" }));
const honestReader = panel.makeReader();
show("an honest reader, taken anywhere", () => [0].map(honestReader)[0]);
//// functions-and-methods-are-only-ever-called-indirectly.ts
function attempt(label: string, run: () => unknown): void {
  try {
    console.log(label + ": " + String(run()));
  } catch (error) {
    console.log(label + ": threw " + (error instanceof TypeError ? "TypeError" : error instanceof Error ? "Error" : typeof error));
  }
}

