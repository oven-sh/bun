//// fields-marked-as-surely-assigned-are-undefined.ts
////= text-21

class Sheet {
  width!: number;
  title!: string;
  owner!: Person;
  rows!: number[];
  onChange!: () => number;
  ready!: boolean;
  height: number = 2;
  setUp(): void {
    this.width = 3;
    this.title = "t";
    this.owner = new Person();
    this.rows = [1];
    this.onChange = () => 9;
    this.ready = true;
  }
  area(): number {
    return this.width * this.height;
  }
  widthPlusOne(): number {
    return this.width + 1;
  }
  wholeWidth(): number {
    return this.width | 0;
  }
  widthOr(fallback: number): number {
    return this.width ?? fallback;
  }
  heading(): string {
    return this.title + "!";
  }
  titleLength(): number {
    return this.title.length;
  }
  ownerName(): string {
    return this.owner.first;
  }
  rowCount(): number {
    return this.rows.length;
  }
  change(): number {
    return this.onChange();
  }
  state(): string {
    return this.ready ? "ready" : "not ready";
  }
}

function all(label: string, sheet: Sheet): void {
  show(label + " width", () => sheet.width);
  show(label + " title", () => sheet.title);
  show(label + " owner", () => sheet.owner);
  show(label + " rows", () => sheet.rows);
  show(label + " onChange", () => typeof sheet.onChange);
  show(label + " ready", () => sheet.ready);
  show(label + " keys", () => Object.keys(sheet).join());
  show(label + " width in sheet", () => "width" in sheet);
  show(label + " own width", () => Object.hasOwn(sheet, "width"));
  show(label + " JSON", () => JSON.stringify(sheet));
  show(label + " area", () => sheet.area());
  show(label + " widthPlusOne", () => sheet.widthPlusOne());
  show(label + " wholeWidth", () => sheet.wholeWidth());
  show(label + " widthOr", () => sheet.widthOr(7));
  show(label + " heading", () => sheet.heading());
  show(label + " titleLength", () => sheet.titleLength());
  show(label + " ownerName", () => sheet.ownerName());
  show(label + " rowCount", () => sheet.rowCount());
  show(label + " change", () => sheet.change());
  show(label + " state", () => sheet.state());
}

const empty = new Sheet();
all("empty", empty);
const filled = new Sheet();
filled.setUp();
all("filled", filled);
empty.setUp();
all("filled late", empty);

let later!: number;
let laterText!: string;
let laterOwner!: Person;
show("a variable marked the same way", () => later);
show("plus one", () => later + 1);
show("a string variable", () => laterText);
show("its length", () => laterText.length);
show("an object variable", () => laterOwner);
show("its member", () => laterOwner.first);
later = 4;
show("assigned", () => later + 1);
//// fields-of-every-kind-are-read-while-the-set-constructor-runs.ts
class Counting extends Set<number> {
  name = "counting";
  list = [1, 2];
  flag = true;
  inner = { depth: 1 };
  whole = 7;
  half = 0.5;
  add(value: number): this {
    console.log([typeof this.name, typeof this.list, typeof this.flag, typeof this.inner, typeof this.whole, typeof this.half].join(" "));
    console.log(String(this.name) + " " + String(this.list) + " " + String(this.flag) + " " + String(this.inner) + " " + String(this.whole) + " " + String(this.half));
    try {
      console.log("length " + this.name.length);
    } catch (error) {
      console.log("the name: threw " + (error instanceof TypeError));
    }
    try {
      console.log("first " + this.list[0]);
    } catch (error) {
      console.log("the list: threw " + (error instanceof TypeError));
    }
    try {
      console.log("depth " + this.inner.depth);
    } catch (error) {
      console.log("the object: threw " + (error instanceof TypeError));
    }
    return super.add(value);
  }
}

console.log("size " + new Counting([1]).add(2).size);

