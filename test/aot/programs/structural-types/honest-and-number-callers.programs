////= text-11

////= lines-194	Row	column	number	string

interface Attributes {
  [name: `data-${string}`]: number;
  id: string;
}

////= lines-194	Tagged	tag	symbol	number

class Bag {
  [item: string]: number;
  count: number = 0;
}

class Table {
  static [name: string]: number;
  static rows: number = 2;
}

function cell(row: Row, column: number): string {
  return row[column];
}

function cellWidth(row: Row, column: number): number {
  return row[column].length;
}

function inBag(bag: Bag, item: string): number {
  return bag[item];
}

const row: Row = { 0: "a", 2: "ccc" };
show("by number: there", () => [cell(row, 0), cellWidth(row, 2)]);
show("by number: missing", () => [cell(row, 1), typeof cell(row, 1)]);
show("by number: the length of a missing one", () => cellWidth(row, 1));
show("by number: negative, a fraction, far out", () => [cell(row, -1), cell(row, 0.5), cell(row, 2 ** 32)]);
show("by number: a list under the same type", () => {
  const list: Row = ["x", "y"];
  return [cell(list, 1), cell(list, 2), cell(list, -1)];
});
show("by number: a string under the same type", () => {
  const word: Row = "hi";
  return [cell(word, 1), cell(word, 2)];
});

const attributes: Attributes = { id: "main", "data-width": 3 };
show("by a pattern: there", () => [attributes["data-width"], attributes["data-width"] + 1]);
show("by a pattern: missing", () => [attributes["data-height"], attributes["data-height"] + 1]);
show("by a pattern: a computed name", () => {
  const names: `data-${string}`[] = ["data-width", "data-depth", "data-"];
  return names.map(name => attributes[name]);
});

const mark = Symbol("mark");
const other = Symbol("other");
const tagged: Tagged = { [mark]: 1 };
show("by a symbol: there and missing", () => [tagged[mark], tagged[other], tagged[other] + 1]);
show("by a symbol: one that every object answers to", () => typeof tagged[Symbol.toStringTag]);

const bag = new Bag();
show("in a class: the field", () => [bag.count, inBag(bag, "count")]);
show("in a class: missing", () => [bag.apples, inBag(bag, "apples"), bag.apples + 1]);
bag.apples = 3;
show("in a class: after a store", () => [bag.apples, inBag(bag, "apples"), Object.keys(bag)]);
show("in a class: another instance", () => [new Bag().apples, Object.keys(new Bag())]);
show("on the static side", () => [Table.rows, Table.columns, Table.columns + 1, Object.keys(Table)]);

let sum = 0;
for (let i = 0; i < 2000; i++) sum += inBag(bag, i % 2 === 0 ? "apples" : "count") + cellWidth(row, 2);
show("2000 honest rounds", () => sum);
show("then missing ones", () => [inBag(bag, "pears"), cell(row, 7)]);
//// instanceof-against-bound-proxied-and-lying-classes.ts
////= Person-5

class Claims {
  legs: number = 4;
  tag: string = "claims";
  static [Symbol.hasInstance](value: unknown): boolean {
    return typeof value === "object" && value !== null;
  }
}

class Never {
  n: number = 1;
  static [Symbol.hasInstance](value: unknown): boolean {
    return false;
  }
}

const BoundDog = Dog.bind(null);
const ProxiedDog = new Proxy(Dog, {});

function legsIfClaims(value: Animal | Claims): string {
  if (value instanceof Claims) return "claims " + typeof value.legs + " " + value.legs + " " + typeof value.tag;
  return "animal " + value.name;
}
////= lines-225	legsIfDog	Dog
////= lines-225	legsIfBound	BoundDog
////= lines-225	legsIfProxied	ProxiedDog
function notNever(value: Never | Cat): string {
  if (value instanceof Never) return "never " + value.n;
  return "cat " + typeof value.lives + " " + value.lives;
}

const relinked: Animal = Object.setPrototypeOf(new Cat("relinked"), Dog.prototype);
const created: Animal = Object.assign(Object.create(Dog.prototype), { name: "created" });
const unlinked: Animal = Object.setPrototypeOf(new Dog("unlinked"), Animal.prototype);

const animals: [string, Animal][] = [
  ["dog", new Dog("rex")],
  ["cat", new Cat("tom")],
  ["a cat relinked to Dog.prototype", relinked],
  ["made from Dog.prototype", created],
  ["a dog relinked to Animal.prototype", unlinked],
  ["literal", { name: "literal" }],
];
for (const [label, animal] of animals) {
  show(label + ": Claims", () => legsIfClaims(animal));
  show(label + ": Dog", () => legsIfDog(animal));
  show(label + ": bound Dog", () => legsIfBound(animal));
  show(label + ": proxied Dog", () => legsIfProxied(animal));
}
show("a real Claims", () => legsIfClaims(new Claims()));
show("a real Never", () => notNever(new Never()));
show("a cat", () => notNever(new Cat("tom")));

function byConstructor(value: Animal): string {
  if (value.constructor === Dog) return "constructor says dog";
  return "constructor says " + value.constructor.name;
}
for (const [label, animal] of animals) show(label + ": constructor", () => byConstructor(animal));

const original = Object.getPrototypeOf(Dog.prototype);
show("the chain of Dog.prototype", () => original === Animal.prototype);
let count = 0;
const rex = new Dog("rex");
for (let i = 0; i < 2000; i++) if (legsIfDog(rex).startsWith("dog")) count++;
show("2000 honest tests", () => count);
show("then the relinked cat", () => legsIfDog(relinked));
//// instanceof-is-answered-by-the-prototype-chain-not-the-type.ts
////= Bird

////= lines-96	Plane	wings	2	sing	"roar"

////= lines-14	class	Sparrow	extends	Bird	small	true

function isBird(b: Bird): boolean {
  return b instanceof Bird;
}

function branch(b: Bird): string {
  if (b instanceof Bird) return "bird " + b.sing();
  return "not a bird";
}

function facts(b: Bird): string {
  return [
    isBird(b),
    branch(b),
    b.constructor.name,
    Bird.prototype.isPrototypeOf(b),
    Object.getPrototypeOf(b) === Bird.prototype,
    Bird[Symbol.hasInstance](b),
  ].join(" | ");
}

const relinked: Bird = new Bird();
const promoted: Bird = new Plane();
const bare: Bird = Object.create(Bird.prototype);
const literal: Bird = { wings: 2, sing: () => "literal" };
const nullProto: Bird = Object.assign(Object.create(null), { wings: 2, sing: () => "null prototype" });
const proxied: Bird = new Proxy(new Bird(), {});
const lyingProxy: Bird = new Proxy(new Plane(), { getPrototypeOf: () => Bird.prototype });

console.log("a bird: " + facts(new Bird()));
console.log("a sparrow: " + facts(new Sparrow()));
console.log("a plane: " + facts(new Plane()));
console.log("only the prototype: " + isBird(bare) + " " + branch(bare) + " " + bare.wings);
console.log("a literal: " + facts(literal));
console.log("no prototype: " + isBird(nullProto) + " " + branch(nullProto));
console.log("a proxy of a bird: " + facts(proxied));
console.log("a proxy that claims the prototype: " + isBird(lyingProxy) + " " + branch(lyingProxy));

console.log("before the prototype changes: " + facts(relinked));
Object.setPrototypeOf(relinked, Plane.prototype);
console.log("a bird relinked to Plane: " + facts(relinked));
console.log("before: " + facts(promoted));
Object.setPrototypeOf(promoted, Bird.prototype);
console.log("a plane relinked to Bird: " + facts(promoted));

let yes = 0;
for (let i = 0; i < 2000; i++) if (isBird(new Bird())) yes++;
console.log("2000 honest: " + yes);
console.log("then a plane: " + isBird(new Plane()) + ", a literal: " + isBird(literal) + ", a bird: " + isBird(new Bird()));

const flock: Bird[] = [new Bird(), new Plane(), new Sparrow(), literal, bare, relinked, promoted];
console.log("elements: " + flock.map(isBird).join());
console.log("filtered: " + flock.filter((b): b is Bird => b instanceof Bird).length);

class Club {
  static [Symbol.hasInstance](value: unknown): boolean {
    return typeof value === "object" && value !== null && "wings" in value;
  }
  wings = 0;
}

function inClub(c: Club): boolean {
  return c instanceof Club;
}

console.log("its own test, an instance: " + inClub(new Club()));
console.log("its own test, a bird: " + inClub(new Bird()));
console.log("its own test, anything: " + ({} instanceof Club) + " " + ({ wings: 1 } instanceof Club));

const originalPrototype = Object.getPrototypeOf(Sparrow.prototype);
const sparrow: Bird = new Sparrow();
console.log("a sparrow before: " + isBird(sparrow) + " " + sparrow.sing());
Object.setPrototypeOf(Sparrow.prototype, Plane.prototype);
console.log("its class relinked: " + isBird(sparrow) + " " + sparrow.sing() + " " + (sparrow instanceof Plane));
Object.setPrototypeOf(Sparrow.prototype, originalPrototype);
console.log("and back: " + isBird(sparrow) + " " + sparrow.sing());

