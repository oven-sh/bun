type HasLength = { length: number };

const uses: [string, (item: HasLength) => unknown][] = [
  ["in", item => "length" in item],
  ["in with an index", item => 0 in item],
  ["Reflect.has", item => Reflect.has(item, "length")],
  ["Reflect.get", item => Reflect.get(item, "length")],
  ["Reflect.ownKeys", item => Reflect.ownKeys(item).length],
  ["Reflect.getPrototypeOf", item => Reflect.getPrototypeOf(item) === null],
  ["Reflect.isExtensible", item => Reflect.isExtensible(item)],
  ["Reflect.getOwnPropertyDescriptor", item => Reflect.getOwnPropertyDescriptor(item, "length")?.writable],
  ["Object.getPrototypeOf", item => Object.getPrototypeOf(item) === null],
  ["Object.getOwnPropertyNames", item => Object.getOwnPropertyNames(item)],
  ["Object.getOwnPropertyDescriptor", item => Object.getOwnPropertyDescriptor(item, "length")?.writable],
  ["Object.isFrozen", item => Object.isFrozen(item)],
  ["Object.isSealed", item => Object.isSealed(item)],
  ["Object.isExtensible", item => Object.isExtensible(item)],
  ["Object.freeze", item => Object.freeze(item) === item],
  ["Object.preventExtensions", item => Object.preventExtensions(item) === item],
  ["Object.entries", item => Object.entries(item)],
  ["Object.values", item => Object.values(item)],
  ["Object.hasOwn", item => Object.hasOwn(item, "length")],
  ["Object.create", item => typeof Object.create(item)],
  ["Object.setPrototypeOf", item => Object.setPrototypeOf(item, null) === item],
  ["Object.defineProperty", item => Object.defineProperty(item, "extra", { value: 1 }) === item],
  ["Object.assign from it", item => Object.assign({}, item)],
  ["new Proxy", item => new Proxy(item, {}).length],
  ["new WeakRef", item => new WeakRef(item).deref() === item],
  ["structuredClone", item => structuredClone(item)],
];

const makers: [string, () => HasLength][] = [
  ["literal", () => ({ length: 2 })],
  ["string", () => "ab"],
  ["empty string", () => ""],
  ["array", () => [7, 8]],
  ["String object", () => new String("ab")],
];

for (const [use, run] of uses) {
  for (let i = 0; i < 200; i++) run({ length: i });
  for (const [name, make] of makers) attempt(use + " of a " + name, () => run(make()));
}

function lengthIsIn(item: HasLength): boolean {
  return "length" in item;
}
function guardedRead(item: HasLength | { size: number }): number {
  if ("length" in item) return item.length;
  return item.size;
}
let warm = 0;
for (let i = 0; i < 2000; i++) warm += (lengthIsIn({ length: i }) ? 1 : 0) + guardedRead({ length: 1 }) + guardedRead({ size: 2 });
console.log("after 2000 literals", warm);
attempt("in, after 2000 literals, of a string", () => lengthIsIn("abc"));
attempt("in, after 2000 literals, of a function", () => lengthIsIn(lengthIsIn));
attempt("a read guarded by in, of a string", () => guardedRead("abc"));
attempt("a read guarded by in, of an array", () => guardedRead([1]));
attempt("in, of a literal again", () => lengthIsIn({ length: 0 }));
//// index-of-misses-and-minus-one-is-used-as-an-index.ts
////= show-42

function found(numbers: number[], wanted: number): number {
  return numbers[numbers.indexOf(wanted)];
}

function foundText(strings: string[], wanted: string): string {
  return strings[strings.indexOf(wanted)];
}

function foundPoint(points: Point[], x: number): Point {
  return points[points.findIndex(p => p.x === x)];
}

function after(numbers: number[], wanted: number): number {
  return numbers[numbers.indexOf(wanted) + 1];
}

function remove(numbers: number[], wanted: number): number[] {
  numbers.splice(numbers.indexOf(wanted), 1);
  return numbers;
}

function replace(numbers: number[], wanted: number, by: number): number[] {
  numbers[numbers.indexOf(wanted)] = by;
  return numbers;
}

function letterAfter(text: string, wanted: string): string {
  return text[text.indexOf(wanted) + wanted.length];
}

function letterAt(text: string, wanted: string): string {
  return text[text.indexOf(wanted)];
}

function cutAt(text: string, wanted: string): string {
  return text.slice(0, text.indexOf(wanted));
}

function extension(name: string): string {
  return name.substring(name.lastIndexOf(".") + 1);
}

let total = 0;
for (let i = 0; i < 2000; i++) total += found([i, 1], i) + foundText(["a", "b"], "b").length + foundPoint([new Point(i)], i).x + after([i, 5], i) + letterAt("abc", "b").length;
console.log("2000 honest rounds: " + total);

attempt("numbers", () => [found([1, 2], 2), typeof found([1, 2], 3), found([1, 2], 3) + 1, found([0.5], 1) * 2]);
attempt("not a number is never found", () => [typeof found([NaN], NaN), [NaN].indexOf(NaN), [NaN].includes(NaN), [NaN].findIndex(n => Number.isNaN(n))]);
attempt("zero and minus zero", () => [[0].indexOf(-0), [-0].indexOf(0), show(found([-0], 0)), [-0].includes(0)]);
attempt("holes are never found", () => [new Array<number | undefined>(2).indexOf(undefined), new Array<number | undefined>(2).includes(undefined), new Array<number | undefined>(2).findIndex(n => n === undefined)]);
attempt("strings", () => [foundText(["a"], "a"), typeof foundText(["a"], "z"), foundText(["a"], "z") + "!"]);
attempt("strings: a method", () => foundText(["a"], "z").length);
attempt("points", () => [foundPoint([new Point(1)], 1).x, typeof foundPoint([new Point(1)], 2)]);
attempt("points: a member", () => foundPoint([new Point(1)], 2).x);
attempt("the one after", () => [after([1, 2], 1), typeof after([1, 2], 2), after([1, 2], 9)]);
attempt("a miss removes the last one", () => [remove([1, 2, 3], 2), remove([1, 2, 3], 9), remove([], 9)]);
attempt("a miss stores at minus one", () => {
  const numbers = replace([1, 2], 9, 5);
  return [show(numbers), Object.keys(numbers), numbers.length, found(numbers, 100)];
});
attempt("letters", () => [letterAt("abc", "b"), typeof letterAt("abc", "z"), letterAfter("abc", "b"), typeof letterAfter("abc", "c"), letterAfter("abc", "z"), letterAfter("abc", "")]);
attempt("letters: a method", () => letterAt("abc", "z").toUpperCase());
