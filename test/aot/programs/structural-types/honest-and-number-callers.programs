//// hybrids-kept-in-fields-arrays-and-maps-are-called-and-read.ts
////= text-12

interface Rule {
  (value: number): boolean;
  title: string;
  weight: number;
}

function rule(title: string, weight: number, test: (value: number) => boolean): Rule {
  return Object.assign((value: number) => test(value), { title, weight });
}

const positive = rule("positive", 1, v => v > 0);
const even = rule("even", 2.5, v => v % 2 === 0);
const small = rule("small", 4, v => v < 10);
const boundRule: Rule = Object.assign(positive.bind(null), { title: "bound", weight: 8 });
const proxyRule: Rule = new Proxy(even, {});
////= lines-186	declared	value	number	declared.weight
declared.title = "declared";
declared.weight = 16;

class Checker {
  main: Rule = positive;
  rules: Rule[] = [positive, even, small, boundRule, proxyRule, declared];
  byTitle = new Map<string, Rule>();
  constructor() {
    for (const r of this.rules) this.byTitle.set(r.title, r);
  }
  check(value: number): string {
    return this.rules.map(r => (r(value) ? r.title : "-")).join();
  }
  score(value: number): number {
    let total = 0;
    for (const r of this.rules) if (r(value)) total += r.weight;
    return total;
  }
  one(title: string, value: number): boolean | undefined {
    return this.byTitle.get(title)?.(value);
  }
  mainTitle(): string {
    return this.main.title + " " + this.main(1) + " " + this.main(-1);
  }
}

const checker = new Checker();
show("check 4", () => checker.check(4));
show("check 16", () => checker.check(16));
show("check -3", () => checker.check(-3));
show("score 4", () => checker.score(4));
show("score 16", () => checker.score(16));
show("one even 3", () => checker.one("even", 3));
show("one bound 3", () => checker.one("bound", 3));
show("one missing", () => checker.one("missing", 3));
show("main", () => checker.mainTitle());
checker.main = proxyRule;
show("main is the proxy", () => checker.mainTitle());
checker.main = boundRule;
show("main is the bound one", () => checker.mainTitle());
checker.main = declared;
show("main is the declared one", () => checker.mainTitle());

show("as a method, this is the checker", () => {
  const holder = {
    tag: "holder",
    run: Object.assign(
      function (this: { tag: string } | void): string {
        return this ? this.tag : "no this";
      },
      { title: "uses this" },
    ),
  };
  const bare = holder.run;
  return holder.run() + " " + bare() + " " + holder.run.title;
});
show("filter by a hybrid", () => [-2, -1, 0, 1, 2].filter(positive));
show("filter by the proxy", () => [-2, -1, 0, 1, 2].filter(proxyRule));
show("sorted by weight", () => [...checker.rules].sort((a, b) => b.weight - a.weight).map(r => r.title).join());
show("titles by destructuring", () => checker.rules.map(({ title }) => title).join());
show("names", () => checker.rules.map(r => r.name).join("|"));

even.weight = 100;
show("a store is seen through the proxy", () => proxyRule.weight);
proxyRule.title = "renamed through the proxy";
show("and the other way", () => even.title);

let total = 0;
for (let i = 0; i < 2000; i++) total += checker.score(i % 20);
show("2000 scores", () => total);
//// implementations-of-one-method-take-other-numbers-of-parameters-and-are-exchanged.ts
interface Runner {
  run(a?: number, b?: number, c?: number): string;
}

////= lines-119	None	implements	Runner	run	"none"

////= lines-250	One	implements	Runner	"one "

class Two implements Runner {
  run(a?: number, b: number = 20): string {
    return "two " + a + " " + b;
  }
}

class Three implements Runner {
  run(a?: number, b?: number, c?: number): string {
    return "three " + a + " " + b + " " + c;
  }
}

class Rest implements Runner {
  run(...all: (number | undefined)[]): string {
    return "rest " + all.length + " " + all.join();
  }
}

class Counted implements Runner {
  run(a?: number): string {
    return "counted " + arguments.length + " " + a;
  }
}

class Capturing implements Runner {
  run: (a?: number, b?: number) => string = (a, b) => "field of " + this.constructor.name + " " + a + " " + b;
}

abstract class Base {
  abstract run(a?: number, b?: number, c?: number): string;
}

////= lines-250	BelowOne	extends	Base	"below one "

class BelowRest extends Base {
  run(...all: (number | undefined)[]): string {
    return "below rest " + all.length;
  }
}

function calls(r: Runner): string {
  const pair: [number, number] = [8, 9];
  return [r.run(), r.run(1), r.run(1, 2), r.run(1, 2, 3), r.run(undefined, 2), r.run(...pair)].join(" | ");
}

function baseCalls(b: Base): string {
  return [b.run(), b.run(1), b.run(1, 2, 3)].join(" | ");
}

const runners: Runner[] = [new None(), new One(), new Two(), new Three(), new Rest(), new Counted(), new Capturing()];
const bases: Base[] = [new BelowOne(), new BelowRest()];

function round(label: string): void {
  for (const r of runners) console.log(label + ", " + r.constructor.name + ": " + calls(r));
  for (const b of bases) console.log(label + ", " + b.constructor.name + ": " + baseCalls(b));
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += calls(runners[i % 7]).length + baseCalls(bases[i % 2]).length;
console.log("2000 honest: " + warm);
round("as written");
One.prototype.run = Rest.prototype.run;
Three.prototype.run = None.prototype.run;
None.prototype.run = Counted.prototype.run;
BelowOne.prototype.run = BelowRest.prototype.run;
round("exchanged");

