console.log("wrapped instanceof Iterator: " + (wrapped instanceof Iterator));
const g = generated(1);
const same: unknown = Iterator.from(g);
console.log("Iterator.from of a generator is the generator: " + (same === g));
console.log("a generator instanceof Iterator: " + (g instanceof Iterator));
//// iterator-results-are-parsed-from-json.ts
////= text-14

class Replay implements Iterable<number> {
  texts: string[];
  returned = 0;
  constructor(texts: string[]) {
    this.texts = texts;
  }
  [Symbol.iterator](): Iterator<number> {
    let at = 0;
    return {
      next: (): IteratorResult<number> => JSON.parse(at < this.texts.length ? this.texts[at++] : '{"done":true}'),
      return: (): IteratorResult<number> => {
        this.returned++;
        return { done: true, value: undefined };
      },
    };
  }
}

function* delegating(numbers: Iterable<number>): Generator<number, void, void> {
  yield* numbers;
}

const scripts: [string, string[]][] = [
  ["honest", ['{"value":1,"done":false}', '{"value":2,"done":false}']],
  ["done is zero", ['{"value":1,"done":0}', '{"value":2,"done":0}']],
  ["done is an empty text", ['{"value":1,"done":""}']],
  ["done is null", ['{"value":1,"done":null}']],
  ["done is one", ['{"value":1,"done":false}', '{"value":2,"done":1}', '{"value":3,"done":false}']],
  ["done is a text", ['{"value":1,"done":"no"}', '{"value":2,"done":false}']],
  ["done is an object", ['{"value":1,"done":{}}']],
  ["no members at all", ["{}", "{}"]],
  ["an array", ["[]", "[5]"]],
  ["the value is a text", ['{"value":"one","done":false}', '{"value":2,"done":false}']],
  ["the value is null", ['{"value":null,"done":false}']],
  ["a number", ["1"]],
  ["null", ["null"]],
  ["a text", ['"text"']],
  ["true", ["true"]],
  ["a number after an honest one", ['{"value":1,"done":false}', "2"]],
];

const uses: [string, (numbers: Iterable<number>) => unknown][] = [
  ["for-of", numbers => {
    let sum = 0;
    const kinds: string[] = [];
    for (const n of numbers) {
      kinds.push(typeof n);
      sum += n;
    }
    return kinds.join() + " sum " + text(sum);
  }],
  ["spread", numbers => [...numbers].map(text)],
  ["destructuring", numbers => {
    const [a, b] = numbers;
    return text(a) + " and " + text(b);
  }],
  ["yield*", numbers => [...delegating(numbers)].map(text)],
  ["Array.from", numbers => Array.from(numbers, n => text(n * 2))],
];

for (const [name, script] of scripts) {
  for (const [label, use] of uses) {
    const replay = new Replay(script);
    try {
      console.log(name + ", " + label + ": " + text(use(replay)) + ", returned " + replay.returned);
    } catch (error) {
      console.log(name + ", " + label + ": " + failure(error) + ", returned " + replay.returned);
    }
  }
}
//// iterator-results-have-getters-and-extra-members.ts
////= text-4

let log: string[] = [];
let made: IteratorResult<number>[] = [];

function result(n: number, last: boolean): IteratorResult<number> {
  const r = {
    extra: "more " + n,
    get value(): number {
      log.push("value " + n);
      return n;
    },
    get done(): boolean {
      log.push("done " + n);
      return last;
    },
  };
  made.push(r);
  return r;
}

class Watched implements Iterable<number> {
  limit: number;
  constructor(limit: number) {
    this.limit = limit;
  }
  [Symbol.iterator](): Iterator<number> {
    log.push("iterator");
    let n = 0;
    const limit = this.limit;
    const iterator = {
      get next(): () => IteratorResult<number> {
        log.push("get next");
        return () => {
          n++;
          log.push("next " + n);
          return result(n, n > limit);
        };
      },
      get return(): () => IteratorResult<number> {
        log.push("get return");
        return () => {
          log.push("return");
          return result(-1, true);
        };
      },
    };
    return iterator;
  }
}

function* delegating(numbers: Iterable<number>): Generator<number, void, void> {
  yield* numbers;
}

const uses: [string, (numbers: Iterable<number>) => unknown][] = [
  ["for-of", numbers => {
    let sum = 0;
    for (const n of numbers) sum += n;
    return sum;
  }],
  ["for-of with a break", numbers => {
    for (const n of numbers) return n;
    return 0;
  }],
  ["for-of that ignores the value", numbers => {
    let count = 0;
    for (const _ of numbers) count++;
    return count;
  }],
  ["spread", numbers => [...numbers]],
  ["destructuring one", numbers => {
    const [a] = numbers;
    return a;
  }],
  ["destructuring with a gap", numbers => {
    const [, b] = numbers;
    return b;
  }],
  ["destructuring all and more", numbers => {
    const [a, b, c] = numbers;
    return [a, b, text(c)];
  }],
  ["Array.from", numbers => Array.from(numbers)],
  ["new Set", numbers => new Set(numbers).size],
  ["yield* under spread", numbers => [...delegating(numbers)]],
];

for (const [label, use] of uses) {
  log = [];
  made = [];
  console.log(label + ": " + text(use(new Watched(2))));
  console.log(label + " log: " + log.join(", "));
}

log = [];
made = [];
const outer = delegating(new Watched(2));
const first = outer.next();
console.log("yield* by hand log before a read: " + log.join(", "));
console.log("yield* hands on the very object: " + (first === made[0]));
console.log("keys " + Object.keys(first).join());
console.log("extra in it: " + ("extra" in first));
console.log("value " + text(first.value) + " done " + text(first.done));
console.log("log: " + log.join(", "));
log = [];
console.log("return through yield*: " + Object.keys(outer.return()).join());
console.log("log: " + log.join(", "));
//// iterators-and-generators-get-a-next-of-their-own.ts
const log: string[] = [];

function* count(): Generator<number, undefined, unknown> {
  yield 1;
  yield 2;
  yield 3;
  return undefined;
}

////= walk	(it: Iterable<number	it

////= walk	Generator(g: Generator<number, undefined, unknown	g

function spreadGenerator(g: Generator<number, undefined, unknown>): string {
  return [...g].join();
}

function* through(g: Generator<number, undefined, unknown>): Generator<number, undefined, unknown> {
  yield* g;
  return undefined;
}

////= lines-269	line	", "

function twice(): () => IteratorResult<number, undefined> {
  let calls = 0;
  return () => {
    log.push("own next");
    return ++calls <= 2 ? { done: false, value: calls * 100 } : { done: true, value: undefined };
  };
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += walkGenerator(count()).length + spreadGenerator(count()).length + walk([1, 2].values()).length;
line("2000 honest", String(warm));
line("a generator", walkGenerator(count()) + " | " + spreadGenerator(count()) + " | " + walk(through(count())));

function withNext(): Generator<number, undefined, unknown> {
  const g = count();
  g.next = twice();
  return g;
}

line("with a next of its own, for-of", walkGenerator(withNext()));
line("spread", spreadGenerator(withNext()));
line("yield*", walk(through(withNext())));
line("Array.from", Array.from(withNext()).join());
line("a pattern", (([a, b]: Iterable<number>) => a + " " + b)(withNext()));

const closing = count();
closing.return = value => {
  log.push("own return");
  return { done: true, value: undefined };
};
let firstSeen = 0;
for (const n of closing) {
  firstSeen = n;
  break;
}
line("with a return of its own, left early", firstSeen + ", then " + walkGenerator(closing));

const redirected = count();
redirected[Symbol.iterator] = () => {
  log.push("own iterator method");
  return count();
};
redirected.next();
line("with an iterator method of its own", walkGenerator(redirected) + " | by hand " + String(redirected.next().value));

const late = count();
const seen: number[] = [];
for (const n of late) {
  seen.push(n);
  late.next = twice();
}
line("a next that appears while the loop runs", seen.join());

const values = [1, 2, 3].values();
values.next = twice();
line("an array iterator with a next of its own", walk(values));

const keys = new Map([[1, "a"]]).keys();
keys.next = twice();
line("a map iterator with a next of its own", walk(keys));

const members = new Set([1]).values();
members.next = twice();
line("a set iterator with a next of its own", [...members].join());

const entries = [7, 8].entries();
entries.next = () => {
  log.push("own next of entries");
  return { done: true, value: undefined };
};
let pairs = 0;
for (const [index, value] of entries) pairs += index + value;
line("the entries of an array with a next of their own", String(pairs));

line("honest again", walkGenerator(count()) + " | " + walk([1, 2].values()));

export {};
