//// look-alikes-with-other-layouts-reach-a-dog-method.ts
////= Person-5

const log: string[] = [];

class Wolf extends Animal {
  pack: string = "grey";
  tricks: string[] = ["howl"];
  owner: Person = new Person("nobody");
  tag: string = "wolf-tag";
  legs: number = 40;
  bark(): string {
    return this.name + " howls on " + this.legs;
  }
}

class Robot extends Animal {
  get legs(): number {
    log.push("get legs");
    return 2;
  }
  set legs(n: number) {
    log.push("set legs " + n);
  }
  get tag(): string {
    log.push("get tag");
    return "robot-tag";
  }
  get owner(): Person {
    log.push("get owner");
    return new Person("maker");
  }
  get tricks(): string[] {
    log.push("get tricks");
    return [];
  }
  get bark(): () => string {
    log.push("get bark");
    return () => "beep";
  }
}

class Broken extends Animal {
  get legs(): number {
    throw new RangeError("no legs");
  }
}

////= Keeper

class DogKeeper implements Keeper {
  legsOf(d: Dog): number {
    return d.legs;
  }
  tagOf(d: Dog): string {
    return d.tag;
  }
  ownerName(d: Dog): string {
    return d.owner.first;
  }
  speak(d: Dog): string {
    return d.bark();
  }
  shoe(d: Dog): void {
    d.legs = 6;
  }
}

const own = new DogKeeper();
const keeper: Keeper = own;
const inherited: Animal = Object.create(new Dog("parent"));
const proxied: Animal = new Proxy(new Dog("behind a proxy"), {
  get(target, key, receiver) {
    log.push("trap get " + String(key));
    return Reflect.get(target, key, receiver);
  },
  set(target, key, value, receiver) {
    log.push("trap set " + String(key));
    return Reflect.set(target, key, value, receiver);
  },
});
const frozen: Animal = Object.freeze(new Dog("frozen"));

const animals: [string, Animal][] = [
  ["dog", new Dog("rex")],
  ["wolf", new Wolf("grey")],
  ["robot", new Robot("r2")],
  ["broken", new Broken("b")],
  ["inherited", inherited],
  ["proxied", proxied],
  ["frozen", frozen],
  ["dog again", new Dog("fido")],
];

for (const [kind, a] of animals) {
  show(kind + " legsOf", () => keeper.legsOf(a));
  show(kind + " tagOf", () => keeper.tagOf(a));
  show(kind + " ownerName", () => keeper.ownerName(a));
  show(kind + " speak", () => keeper.speak(a));
  show(kind + " shoe", () => keeper.shoe(a));
  show(kind + " legsOf after shoe", () => keeper.legsOf(a));
  show(kind + " own keys", () => Object.keys(a).join());
  show(kind + " log", () => log.splice(0).join(" | "));
}

const wolfAsDog: Dog = new Wolf("typed as a dog");
show("a wolf typed as a dog, typed caller: legs", () => own.legsOf(wolfAsDog));
show("a wolf typed as a dog, typed caller: tag", () => own.tagOf(wolfAsDog));
show("a wolf typed as a dog, typed caller: owner", () => own.ownerName(wolfAsDog));
show("a wolf typed as a dog, typed caller: speak", () => own.speak(wolfAsDog));
const robotAsDog: Dog = new Robot("typed as a dog");
show("a robot typed as a dog, typed caller: legs", () => own.legsOf(robotAsDog));
show("a robot typed as a dog, typed caller: speak", () => own.speak(robotAsDog));
show("log", () => log.splice(0).join(" | "));
//// loops-and-indexes-stay-within-the-length-honest.ts
////= show-32

////= lines-99	Point	x	y	number

type Entry = [number, string];

////= sum

function dot(a: number[], b: number[]): number {
  let total = 0;
  for (let i = 0; i < a.length; i++) total += a[i] * b[i];
  return total;
}

////= lines-93	widths	strings	string	total	length

function xs(points: Point[]): number {
  let total = 0;
  for (let i = 0; i < points.length; i++) total += points[i].x + points[i].y;
  return total;
}

////= runAll	let i = 0; i < functions.length; i++) total += functions[i]

function weigh(entry: Entry): number {
  return entry[0] * 2 + entry[1].length;
}

function codes(text: string): number {
  let total = 0;
  for (let i = 0; i < text.length; i++) total += text.charCodeAt(i);
  return total;
}

////= lines-83	viewSum	view	Float64Array	total

const integers: number[] = [];
const fractions: number[] = [];
const strings: string[] = [];
const points: Point[] = [];
const functions: (() => number)[] = [];
const view = new Float64Array(64);
for (let i = 0; i < 64; i++) {
  integers.push(i);
  fractions.push(i / 4);
  strings.push("s" + i);
  points.push(new Point(i, i / 2));
  functions.push(() => i);
  view[i] = i / 8;
}

let total = 0;
for (let round = 0; round < 2000; round++) {
  integers[round % 64] = round;
  fractions[round % 64] = round / 4;
  const entry: Entry = [round, "entry"];
  total += sum(integers) + sum(fractions) + dot(integers, fractions) + widths(strings) + xs(points) + runAll(functions) + weigh(entry) + codes("some text") + viewSum(view);
}
console.log("total " + total);
console.log(integers.length + " " + fractions.length + " " + strings.length + " " + points.length + " " + functions.length + " " + view.length);
console.log(typeof integers[63] + " " + typeof fractions[63] + " " + typeof strings[63] + " " + typeof points[63] + " " + typeof functions[63] + " " + typeof view[63]);

export {};
//// many-layouts-stand-behind-one-interface.ts
interface Node {
  kind: string;
  value: number;
  weight(): number;
}

class A0 { kind = "A0"; value = 0; weight(): number { return this.value + 100; } }
class A1 { value = 1; kind = "A1"; weight(): number { return this.value + 101; } }
class A2 { pad = 0; kind = "A2"; value = 2; weight(): number { return this.value + 102; } }
class A3 { kind = "A3"; pad = 0; value = 3; weight(): number { return this.value + 103; } }
class A4 { kind = "A4"; value = 4; pad = 0; weight(): number { return this.value + 104; } }
class A5 { p = 0; q = 0; kind = "A5"; value = 5; weight(): number { return this.value + 105; } }
class A6 { p = 0; kind = "A6"; q = 0; value = 6; weight(): number { return this.value + 106; } }
class A7 { value = 7; p = 0; q = 0; r = 0; kind = "A7"; weight(): number { return this.value + 107; } }
class A8 extends A0 { kind = "A8"; value = 8; weight(): number { return super.weight() + 8; } }
class A9 extends A1 { extra = "x"; weight(): number { return -9; } }
class A10 { kind = "A10"; get value(): number { return 10; } weight(): number { return 110; } }
class A11 { kind = "A11"; value = 11; weight = (): number => 111; }

const literals: Node[] = [
  { kind: "L0", value: 20, weight: () => 120 },
  { value: 21, kind: "L1", weight: () => 121 },
  { weight: () => 122, value: 22, kind: "L2" },
  { kind: "L3", value: 23, weight() { return this.value + 100; } },
];

function grown(count: number): Node {
  const extras: Record<string, number> = {};
  for (let i = 0; i < count; i++) extras["e" + i] = i;
  return Object.assign(extras, { kind: "G" + count, value: 30 + count, weight: () => 130 + count });
}

function everything(): Node[] {
  const all: Node[] = [new A0(), new A1(), new A2(), new A3(), new A4(), new A5(), new A6(), new A7(), new A8(), new A9(), new A10(), new A11(), ...literals];
  for (let count = 0; count < 70; count++) all.push(grown(count));
  return all;
}

////= lines-20	value	n	Node	number	return	n.value

////= lines-19	weight	n	Node	number	n.weight

////= lines-20	kind	n	Node	string	return	n.kind

const all = everything();
console.log("how many: " + all.length);
console.log("kinds: " + all.map(kind).join());
console.log("values: " + all.map(value).join());
console.log("weights: " + all.map(weight).join());

let total = 0;
for (let round = 0; round < 50; round++) for (const n of all) total += n.value + n.weight();
console.log("fifty rounds: " + total);

for (const n of all) {
  if (!(n instanceof A10)) n.value += 1000;
}
console.log("after stores: " + all.map(value).join());
console.log("weights again: " + all.map(weight).join());

let honest = 0;
const only = new A0();
for (let i = 0; i < 2000; i++) honest += value(only) + weight(only);
console.log("2000 of one class: " + honest);
console.log("backwards through all: " + [...all].reverse().map(n => kind(n) + ":" + value(n)).slice(0, 12).join());

const byKind = new Map<string, Node>();
for (const n of all) byKind.set(n.kind, n);
console.log("out of a map: " + ["A7", "L2", "G69", "A10", "G0"].map(k => byKind.get(k)?.weight()).join());

console.log("key counts: " + all.map(n => Object.keys(n).length).join());

