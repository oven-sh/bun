class Fixed {
  readonly n = 4;
  readonly mode = "on";
  readonly flag = true;
  twice(): number {
    return this.n * 2;
  }
  label(): string {
    return this.mode + ":" + this.mode.length + ":" + (this.flag ? "yes" : "no");
  }
}

interface Config {
  readonly depth: 3;
  readonly name: "config";
}

