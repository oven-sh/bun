function inner(): string {
  const out: string[] = [];
  const tryRead = (): void => {
    try {
      out.push(String(local));
    } catch (error) {
      out.push(error instanceof Error ? error.constructor.name : typeof error);
    }
  };
  tryRead();
  const local: number = 21;
  tryRead();
  return out.join();
}
show("inside a function", inner);

function inLoop(): string {
  const out: string[] = [];
  for (let i = 0; i < 3; i++) {
    const peek = (): number => each;
    try {
      out.push(String(peek()));
    } catch (error) {
      out.push("threw");
    }
    const each: number = i * 2;
    out.push(String(peek()));
  }
  return out.join();
}
show("in every round of a loop", inLoop);

function inSwitch(which: number): string {
  const peek = (): string => {
    try {
      return String(read());
    } catch (error) {
      return "threw";
    }
  };
  let read: () => number = () => -1;
  switch (which) {
    case 0:
      let chosen: number = 1;
      read = () => chosen;
      return peek();
    default:
      read = () => chosen;
      return peek();
  }
}
show("a switch that enters at the declaration", () => inSwitch(0));
show("a switch that jumps over it", () => inSwitch(1));
//// lists-and-tuples-are-changed-in-one-module-and-read-in-another/changes.ts
export function grow(list: unknown[], length: number): void {
  list.length = length;
}

export function drop(list: unknown[], index: number): void {
  delete list[index];
}

export function turn(list: unknown[]): void {
  list.reverse();
}

export function shorten(list: unknown[]): void {
  list.pop();
}

export const shared: number[] = [1, 2, 3];
export const entry: [number, string] = [1, "a"];
