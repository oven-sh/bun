//// members-of-a-mixin-instance-are-deleted-added-and-frozen.ts
////= describe-7

function Tagged(Base: new () => Point) {
  return class extends Base {
    tag?: string = "tagged";
  };
}

const made = new (Tagged(Point))();
delete made.tag;
console.log("deleted: " + describe(made) + " " + made.tag);
made.tag = "again";
console.log("stored again: " + describe(made));
Object.assign(made, { added: 1 });
console.log("added: " + describe(made));
Object.freeze(made);
try {
  made.x = 100;
  console.log("stored to a frozen instance");
} catch (error) {
  console.log("a store to the frozen instance threw a TypeError: " + (error instanceof TypeError));
}
console.log("frozen: " + describe(made) + " " + made.sum());
//// members-of-an-enum-computed-at-run-time-are-fractions-nan-and-huge.ts
////= show-35

const given: number[] = JSON.parse("[0.5, null, 2147483648, 9007199254740993, -1]");

function at(index: number): number {
  return given[index] ?? NaN;
}

////= lines-207	Base	Two	2

enum Made {
  Half = at(0),
  Nothing = at(1),
  Wide = at(2),
  Huge = at(3),
  Zero = at(4) * 0,
  Length = "abc".length,
  FromOther = Base.Two * at(0),
  Last = Math.sqrt(at(4)),
}

////= lines-42	plusOne	made	Made	number	made	1
////= lines-241	whole	made	Made
////= lines-40	nameOf	made	Made	string	Made[made
////= lines-186	isHalf	made	Made	Made.Half

class Holder {
  made: Made = Made.Length;
  list: Made[] = [];
  put(made: Made): this {
    this.made = made;
    this.list.push(made);
    return this;
  }
  sum(): number {
    let sum = 0;
    for (const made of this.list) sum += made;
    return sum + this.made;
  }
}

attempt("keys", () => Object.keys(Made));
attempt("entries", () => Object.entries(Made));

const members: [string, Made][] = [
  ["half", Made.Half],
  ["nothing", Made.Nothing],
  ["wide", Made.Wide],
  ["huge", Made.Huge],
  ["zero", Made.Zero],
  ["length", Made.Length],
  ["from other", Made.FromOther],
  ["last", Made.Last],
];

let warm = 0;
for (let i = 0; i < 2000; i++) warm += plusOne(Made.Length) + whole(Made.Length) + nameOf(Made.Length).length + new Holder().put(Made.Length).sum();
console.log("2000 rounds with the integer", warm);

for (const [label, made] of members) {
  attempt(label, () => [made, typeof made, plusOne(made), whole(made), nameOf(made), isHalf(made), 1 / made]);
  attempt(label + " held", () => {
    const holder = new Holder().put(Made.Length).put(made);
    return [holder.made, holder.list, holder.sum(), JSON.stringify(holder)];
  });
}
attempt("all in one list", () => {
  const holder = new Holder();
  for (const [, made] of members) holder.put(made);
  return [holder.list, holder.list.map(whole), holder.list.indexOf(Made.Nothing), holder.list.includes(Made.Nothing), holder.list.indexOf(Made.Zero)];
});
