for (const text of texts) {
  attempt(text + " x", () => {
    const point: Point = JSON.parse(text);
    return uses(xOf(point));
  });
  attempt(text + " y", () => {
    const point: Point = JSON.parse(text);
    return [uses(yOf(point)), Object.keys(point), JSON.stringify(point)];
  });
}
