const early: string[] = [];
////= note-3

class Packed extends Base {
  flag: boolean = false;
  on: boolean = true;
  digit: 0 | 1 | 2 = 0;
  level: Level = Level.Low;
  mode: "a" | "b" = "a";
  small: number = 0;
  byte: number = 255;
  ratio: number = 0;
  big: bigint = 0n;
  next: Link | null = null;
  maybe: Link | undefined = undefined;
  key: symbol = Symbol.iterator;
  init(): void {
    note("flag", () => this.flag);
    note("flag === false", () => this.flag === false);
    note("!flag", () => !this.flag);
    note("on", () => this.on);
    note("digit", () => this.digit);
    note("digit === 0", () => this.digit === 0);
    note("level", () => this.level);
    note("level === Low", () => this.level === Level.Low);
    note("name of level", () => Level[this.level]);
    note("mode", () => this.mode);
    note("mode === 'a'", () => this.mode === "a");
    note("small", () => this.small);
    note("small === 0", () => this.small === 0);
    note("small + 1", () => this.small + 1);
    note("byte", () => this.byte);
    note("ratio", () => this.ratio);
    note("ratio === 0", () => this.ratio === 0);
    note("big", () => this.big);
    note("big + 1n", () => this.big + 1n);
    note("next", () => this.next);
    note("next === null", () => this.next === null);
    note("next == null", () => this.next == null);
    note("next?.value", () => this.next?.value);
    note("maybe", () => this.maybe);
    note("key", () => typeof this.key);
  }
  bump(): void {
    this.small++;
    this.byte = (this.byte + 1) & 255;
    this.flag = !this.flag;
  }
}

const packed = new Packed();
for (const entry of early) console.log("early " + entry);
early.length = 0;
packed.init();
for (const entry of early) console.log("late " + entry);
for (let i = 0; i < 2001; i++) packed.bump();
show("small after 2001 bumps", () => packed.small);
show("byte after 2001 bumps", () => packed.byte);
show("flag after 2001 bumps", () => packed.flag);

class Unset {
  flag!: boolean;
  digit!: 0 | 1 | 2;
  level!: Level;
  mode!: "a" | "b";
  small!: number;
  next!: Link | null;
}
const unset = new Unset();
show("unset flag", () => unset.flag);
show("unset flag === false", () => unset.flag === false);
show("unset digit", () => unset.digit);
show("unset level", () => unset.level);
show("unset mode", () => unset.mode);
show("unset small", () => unset.small);
show("unset small++", () => unset.small++);
show("unset small afterwards", () => unset.small);
show("unset next", () => unset.next);
show("unset next === null", () => unset.next === null);
show("unset JSON", () => JSON.stringify(unset));
show("unset keys", () => Object.keys(unset).join());
//// narrowed-a-union-of-a-class-and-a-look-alike-literal.ts
////= text-13

class Dog {
  name = "rex";
  legs = 4;
  speak(): string {
    return this.name + " barks";
  }
}

type Puppet = { name: string; strings: number; speak(): string };

function lookAlike(): Dog {
  return {
    name: "toy",
    legs: 0,
    speak() {
      return this.name + " squeaks";
    },
  };
}

function puppet(): Puppet {
  return { name: "punch", strings: 9, speak: () => "punch talks" };
}

function dogWithStrings(): Dog {
  return Object.assign(new Dog(), { strings: "attached" });
}

function byInstanceof(x: Dog | Puppet): unknown {
  if (x instanceof Dog) return ["a dog", x.legs, x.legs * 2, x.speak()];
  return ["a puppet", x.strings, x.strings * 2, x.speak()];
}

function byIn(x: Dog | Puppet): unknown {
  if ("strings" in x) return ["a puppet", x.strings, x.strings * 2, x.speak()];
  return ["a dog", x.legs, x.legs * 2, x.speak()];
}

function onlyDogs(x: Dog): unknown {
  if (x instanceof Dog) return ["a dog", x.legs, x.speak()];
  return ["typed never", typeof x];
}

function byConstructor(x: Dog | Puppet): unknown {
  if (x.constructor === Dog) return ["a dog", x.legs, x.speak()];
  return ["something else", x.name, x.speak()];
}

const values: [string, () => Dog | Puppet][] = [
  ["a dog", () => new Dog()],
  ["a puppet", puppet],
  ["a literal typed as a dog", lookAlike],
  ["a dog with strings attached", dogWithStrings],
];

for (let i = 0; i < 2000; i++) {
  byInstanceof(i % 2 === 0 ? new Dog() : puppet());
  byIn(i % 2 === 0 ? new Dog() : puppet());
  onlyDogs(new Dog());
}
for (const [name, make] of values) {
  attempt(name + " by instanceof", () => byInstanceof(make()));
  attempt(name + " by in", () => byIn(make()));
  attempt(name + " by its constructor", () => byConstructor(make()));
}
attempt("a dog where only dogs are allowed", () => onlyDogs(new Dog()));
attempt("a literal where only dogs are allowed", () => onlyDogs(lookAlike()));
attempt("in one array", () => [new Dog(), lookAlike(), puppet(), dogWithStrings()].map(byInstanceof));
