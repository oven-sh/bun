////: Range
class Range {
  constructor(
    public from: number,
    public to: number,
  ) {}
  [Symbol.iterator](): Iterator<number> {
    log.push("iterator");
    let next = this.from;
    const «1» = this.to;
    return {
      next: () => {
        log.push("next");
        return next <= «1» ? { done: false, value: next++ } : { done: true, value: undefined };
      },
      return: () => {
        log.push("return");
        return { done: true, value: undefined };
      },
    };
  }
}
