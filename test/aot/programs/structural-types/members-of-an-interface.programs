    yield* new Range(1, 2);
  }
  return [...all()];
});
attempt("instanceof", () => {
  const values: unknown[] = [2, 3, "2"];
  return values.map(v => v instanceof Even);
});
attempt("using", () => {
  {
    using a = new Resource("a");
    using b = new Resource("b");
    log.push("body:" + a.name + b.name);
  }
  return "left";
});
attempt("using, left by a throw", () => {
