  get value(): number | string {
    return this.kept;
  }
  set value(v: number | string) {
    this.kept = "<" + v + ">";
  }
}

class Drops {
  kept: Texts | null = null;
  get inner(): Texts | null {
    return this.kept;
  }
  set inner(v: Texts | null) {}
}

