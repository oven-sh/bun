//// narrowed-by-a-call-that-is-typed-never-and-returns.ts
////= text-13

////= Leaf

const quiet: (() => never)[] = [];
const loose: (() => void)[] = quiet;
loose.push(() => {});

const returns: () => never = quiet[0];
const throws: () => never = () => {
  throw new RangeError("stopped");
};

class Stopper {
  stop(): never {
    throw new RangeError("stopped");
  }
}

function weightOf(l: Leaf | null, stop: () => never): unknown {
  if (l === null) stop();
  return l.weight;
}

function double(v: number | string, stop: () => never): unknown {
  if (typeof v === "string") stop();
  return [v, v * 2, v + 1];
}

function afterTheCall(stop: () => never): unknown {
  const seen: string[] = ["before"];
  try {
    stop();
    seen.push("after");
  } catch {
    seen.push("caught");
  }
  return seen;
}

function resultOfTheCall(stop: () => never): unknown {
  const nothing: never = stop();
  return ["typed never", typeof nothing];
}

function everyPathStops(v: number, stop: () => never): number {
  if (v > 0) return v;
  stop();
}

function inASwitch(mode: "on" | "off", stop: () => never): string {
  switch (mode) {
    case "on":
      return "lit";
    case "off":
      stop();
  }
}

function withTheConstant(l: Leaf | null): unknown {
  if (l === null) returns();
  return l.weight;
}

function round(label: string, stop: () => never): void {
  attempt(label + ": a leaf", () => weightOf(new Leaf(), stop));
  attempt(label + ": null", () => weightOf(null, stop));
  attempt(label + ": a number", () => double(4, stop));
  attempt(label + ": a string", () => double("text", stop));
  attempt(label + ": what follows the call", () => afterTheCall(stop));
  attempt(label + ": the result of the call", () => resultOfTheCall(stop));
  attempt(label + ": a function whose every path stops", () => [everyPathStops(1, stop), everyPathStops(-1, stop)]);
  attempt(label + ": the last case of a switch", () => [inASwitch("on", stop), inASwitch("off", stop)]);
}

round("it throws", throws);
round("a method that throws", () => new Stopper().stop());
for (let i = 0; i < 2000; i++) {
  weightOf(new Leaf(), throws);
  double(i, throws);
  everyPathStops(1, throws);
}
round("it returns", returns);
attempt("called by its own name: a leaf", () => withTheConstant(new Leaf()));
attempt("called by its own name: null", () => withTheConstant(null));
round("it throws again", throws);
//// narrowed-by-a-condition-kept-in-a-constant.ts
////= text-16

class Cell {
  readonly value: number | string = 1;
  readonly shape: Shape = new Square();
  readonly next: Cell | null = null;
}

type Loose = { value: number | string; shape: Shape; next: Cell | null };
type Between = (c: Loose) => void;
const keep: Between = () => {};
const spoil: Between = c => {
  c.value = "text";
  c.shape = new Shape();
  c.next = null;
};

function withNext(): Cell {
  const c = new Cell();
  const loose: Loose = c;
  loose.next = new Cell();
  return c;
}

const uses: [string, (c: Cell, between: Between) => unknown][] = [
  ["typeof", (c, between) => {
    const isNumber = typeof c.value === "number";
    between(c);
    if (isNumber) return [c.value, c.value + 1, c.value * 2];
    return "other";
  }],
  ["instanceof", (c, between) => {
    const isSquare = c.shape instanceof Square;
    between(c);
    if (isSquare) return [c.shape.edge, c.shape.edge * 2, c.shape.sides];
    return "other";
  }],
  ["not null", (c, between) => {
    const hasNext = c.next !== null;
    between(c);
    if (hasNext) return c.next.value;
    return "other";
  }],
  ["two conditions in one constant", (c, between) => {
    const both = typeof c.value === "number" && c.shape instanceof Square;
    between(c);
    if (both) return [c.value + 1, c.shape.edge];
    return "other";
  }],
  ["a constant made from a constant", (c, between) => {
    const isNumber = typeof c.value === "number";
    const really = isNumber;
    between(c);
    return really ? c.value + 1 : "other";
  }],
  ["the negation", (c, between) => {
    const isText = typeof c.value === "string";
    between(c);
    if (!isText) return c.value + 1;
    return "other";
  }],
  ["used twice, the change in between", (c, between) => {
    const isNumber = typeof c.value === "number";
    const first = isNumber ? c.value + 1 : "other";
    between(c);
    const second = isNumber ? c.value + 1 : "other";
    return [first, second];
  }],
];

function round(label: string, between: Between): void {
  for (const [name, use] of uses) attempt(label + ": " + name, () => use(withNext(), between));
}

round("honest", keep);
for (let i = 0; i < 2000; i++) for (const [, use] of uses) use(withNext(), keep);
round("changed through a view that may store", spoil);
round("honest again", keep);
//// narrowed-by-a-destructured-tag.ts
////= text-13

type Action = { kind: "add"; payload: number } | { kind: "name"; payload: string };

class Add {
  kind: "add" = "add";
  payload: number = 1;
}

class Name {
  kind: "name" = "name";
  payload: string = "n";
}

function inTheBody(action: Action): unknown {
  const { kind, payload } = action;
  if (kind === "add") return [kind, payload, payload + 1, payload * 2];
  return [kind, payload, payload.length, payload.toUpperCase()];
}

function inTheParameters({ kind, payload }: Action): unknown {
  if (kind === "add") return [kind, payload, payload + 1, payload * 2];
  return [kind, payload, payload.length, payload.toUpperCase()];
}

function inASwitch({ kind, payload }: Add | Name): unknown {
  switch (kind) {
    case "add":
      return [kind, payload, payload + 1];
    case "name":
      return [kind, payload, payload.length];
  }
}

function all(label: string, make: () => Add | Name): void {
  attempt(label + " in the body", () => inTheBody(make()));
  attempt(label + " in the parameters", () => inTheParameters(make()));
  attempt(label + " in a switch", () => inASwitch(make()));
}

function retag(t: { kind: "add" | "name" }, kind: "add" | "name"): void {
  t.kind = kind;
}

all("an honest add", () => new Add());
all("an honest name", () => new Name());
for (let i = 0; i < 2000; i++) {
  inTheBody(i % 2 === 0 ? new Add() : new Name());
  inTheParameters(i % 2 === 0 ? new Add() : new Name());
  inASwitch(i % 2 === 0 ? new Add() : new Name());
}
all("a name tagged add", () => {
  const n = new Name();
  retag(n, "add");
  return n;
});
all("an add tagged name", () => {
  const a = new Add();
  retag(a, "name");
  return a;
});
attempt("the payload is a getter that runs after the tag", () => {
  const order: string[] = [];
  const action: Action = {
    get kind(): "add" {
      order.push("kind");
      return "add";
    },
    get payload(): number {
      order.push("payload");
      return 5;
    },
  };
  return [inTheBody(action), inTheParameters(action), order.join()];
});
all("an honest add again", () => new Add());
