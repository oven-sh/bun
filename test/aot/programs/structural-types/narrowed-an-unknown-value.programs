////= Shape

class Square extends Shape {
  edge = 2;
  corner = 90;
  area(): number {
    return this.edge * this.edge;
  }
}

////= Circle-2

////= Holder-10

type Between = (h: Holder) => void;
const keep: Between = () => {};
////= lines-204	toBase	h	h.shape	Shape
////= lines-204	toSibling	h	h.shape	Circle

////= lines-20	edgeOf	s	Square	number	return	s.edge

function inAParameter(h: Holder, between: Between): unknown {
  if (h.shape instanceof Square) {
    between(h);
    return [h.shape.edge, h.shape.corner, h.shape.sides, edgeOf(h.shape), Object.keys(h.shape).join()];
  }
  return "not a square";
}

function callsInAParameter(h: Holder, between: Between): unknown {
  if (h.shape instanceof Square) {
    between(h);
    return h.shape.area();
  }
  return "not a square";
}

function inALocal(between: Between): unknown {
  const h = new Holder();
  if (h.shape instanceof Square) {
    between(h);
    return [h.shape.edge, h.shape.corner, h.shape.sides, edgeOf(h.shape)];
  }
  return "not a square";
}

class Owner {
  holder = new Holder();
  own: Shape = new Square();
  inAField(between: Between): unknown {
    if (this.holder.shape instanceof Square) {
      between(this.holder);
      return [this.holder.shape.edge, this.holder.shape.corner, this.holder.shape.sides, edgeOf(this.holder.shape)];
    }
    return "not a square";
  }
  change(to: Shape | null): void {
    if (to !== null) this.own = to;
  }
  inItsOwnField(to: Shape | null): unknown {
    if (this.own instanceof Square) {
      this.change(to);
      return [this.own.edge, this.own.corner, this.own.sides, edgeOf(this.own)];
    }
    return "not a square";
  }
}

function inAnElement(shapes: Shape[], to: Shape | null): unknown {
  const change = (): void => {
    if (to !== null) shapes[0] = to;
  };
  if (shapes[0] instanceof Square) {
    change();
    return [shapes[0].edge, shapes[0].corner, shapes[0].sides, edgeOf(shapes[0])];
  }
  return "not a square";
}

function inACapturedVariable(to: Shape | null): unknown {
  let s: Shape = new Square();
  const change = (): void => {
    if (to !== null) s = to;
  };
  if (s instanceof Square) {
    change();
    return [s.edge, s.corner, s.sides, edgeOf(s)];
  }
  return "not a square";
}

function round(label: string, between: Between, make: () => Shape | null): void {
  attempt(label + " in a parameter", () => inAParameter(new Holder(), between));
  attempt(label + " in a parameter, a method", () => callsInAParameter(new Holder(), between));
  attempt(label + " in a local", () => inALocal(between));
  attempt(label + " in a field", () => new Owner().inAField(between));
  attempt(label + " in its own field", () => new Owner().inItsOwnField(make()));
  attempt(label + " in an element", () => inAnElement([new Square()], make()));
  attempt(label + " in a captured variable", () => inACapturedVariable(make()));
}

round("honest", keep, () => null);
let rounds = 0;
for (let i = 0; i < 2000; i++) {
  inAParameter(new Holder(), keep);
  callsInAParameter(new Holder(), keep);
  inALocal(keep);
  new Owner().inAField(keep);
  new Owner().inItsOwnField(null);
  inAnElement([new Square()], null);
  inACapturedVariable(null);
  rounds++;
}
console.log("honest rounds: " + rounds);
round("the base class", toBase, () => new Shape());
round("a sibling", toSibling, () => new Circle());
round("honest again", keep, () => null);
//// narrowed-in-one-function-with-honest-callers-and-one-odd-caller.ts
////= text-32

////= Holder-13	constructor(readonly hook: (h: Holder) => void) {}

function edgeOf(h: Holder): unknown {
  if (h.shape instanceof Square) {
    h.hook(h);
    return [h.shape.edge, h.shape.edge * 2, h.shape.sides];
  }
  return "other";
}

const quiet = (h: Holder): void => {};
const swaps = (h: Holder): void => {
  h.shape = new Circle();
};

function firstHonestCaller(): unknown {
  return edgeOf(new Holder(quiet));
}

function secondHonestCaller(): unknown {
  const h = new Holder(quiet);
  return [edgeOf(h), edgeOf(h)];
}

function thirdHonestCaller(): unknown {
  let last: unknown = null;
  for (let i = 0; i < 2000; i++) last = edgeOf(new Holder(quiet));
  return last;
}

function oddCaller(): unknown {
  return edgeOf(new Holder(swaps));
}

const table = { edgeOf };
const list = [edgeOf];

attempt("the first honest caller", firstHonestCaller);
attempt("the second honest caller", secondHonestCaller);
attempt("the third honest caller", thirdHonestCaller);
attempt("the odd caller", oddCaller);
attempt("the odd caller through call", () => edgeOf.call(undefined, new Holder(swaps)));
attempt("the odd caller through apply", () => edgeOf.apply(undefined, [new Holder(swaps)]));
attempt("the odd caller through bind", () => edgeOf.bind(undefined, new Holder(swaps))());
attempt("the odd caller through a member", () => table.edgeOf(new Holder(swaps)));
attempt("the odd caller through an element", () => list[0](new Holder(swaps)));
attempt("the odd caller through map", () => [new Holder(quiet), new Holder(swaps), new Holder(quiet)].map(edgeOf));
attempt("the odd caller through Reflect.apply", () => Reflect.apply(edgeOf, undefined, [new Holder(swaps)]));
attempt("the first honest caller again", firstHonestCaller);
attempt("the second honest caller again", secondHonestCaller);
//// narrowed-members-of-a-proxy-typed-as-the-class.ts
////= text-16

////= Holder-3

const log: string[] = [];

function alternating(): Holder {
  const reads = new Map<PropertyKey, number>();
  const second: Holder = { shape: new Shape(), value: "text", leaf: null, mode: "off" };
  return new Proxy(new Holder(), {
    get(target, key, receiver) {
      const n = reads.get(key) ?? 0;
      reads.set(key, n + 1);
      log.push(String(key) + n);
      return Reflect.get(n % 2 === 0 ? target : second, key);
    },
  });
}

function transparent(): Holder {
  return new Proxy(new Holder(), {});
}

function swallowsStores(): Holder {
  return new Proxy(new Holder(), {
    set() {
      return true;
    },
  });
}

const uses: [string, (h: Holder) => unknown][] = [
  ["instanceof", h => (h.shape instanceof Square ? h.shape.edge : "other")],
  ["instanceof, doubled", h => (h.shape instanceof Square ? h.shape.edge * 2 : "other")],
  ["typeof", h => (typeof h.value === "number" ? h.value : "other")],
  ["typeof, plus one", h => (typeof h.value === "number" ? h.value + 1 : "other")],
  ["not null", h => (h.leaf !== null ? h.leaf : "other")],
  ["not null, a member", h => (h.leaf !== null ? h.leaf.edge : "other")],
  ["a literal", h => (h.mode === "on" ? h.mode : "other")],
  ["a store narrows, then a read", h => {
    h.value = "stored";
    return [h.value, h.value.length];
  }],
  ["a store of a number narrows, then arithmetic", h => {
    h.value = 41;
    return h.value + 1;
  }],
  ["a store of null narrows", h => {
    h.leaf = null;
    return h.leaf;
  }],
];

for (const [name, use] of uses) attempt("a plain holder: " + name, () => use(new Holder()));
for (let i = 0; i < 2000; i++) for (const [, use] of uses) use(new Holder());
for (const [name, use] of uses) attempt("a proxy without traps: " + name, () => use(transparent()));
for (const [name, use] of uses) attempt("a proxy that alternates: " + name, () => use(alternating()));
console.log("reads: " + log.join(" "));
for (const [name, use] of uses) attempt("a proxy that swallows stores: " + name, () => use(swallowsStores()));
for (const [name, use] of uses) attempt("a plain holder again: " + name, () => use(new Holder()));
