class Stamp extends Returns {
  #mark = 1;
  edge = 2;
  area(): number {
    return this.edge * this.#mark;
  }
  static marked(o: object): unknown {
    if (#mark in o) {
      return [o.#mark, o.edge, typeof o.area, o instanceof Stamp].join();
    }
    return "no mark";
  }
  static area(o: object): number {
    if (#mark in o) return o.area();
    return -1;
  }
}

