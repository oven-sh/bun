class Shape {
  sides = 4;
  isSquare(): this is Square {
    return this instanceof Square;
  }
}

////= Square-2

////= Circle-2

class Holder {
  shape: Shape = new Square();
  value: number | string = 1;
  holdsANumber(): this is Holder & { value: number } {
    return typeof this.value === "number";
  }
}

function isSquare(s: Shape): s is Square {
  return s instanceof Square;
}

function isNumber(v: number | string): v is number {
  return typeof v === "number";
}

function mustBeSquare(s: Shape): asserts s is Square {
  if (!(s instanceof Square)) throw new RangeError("not a square");
}

function mustBeNumber(v: number | string): asserts v is number {
  if (typeof v !== "number") throw new RangeError("not a number");
}

////= mustHold

type Between = (h: Holder) => void;
const keep: Between = () => {};
////= lines-122	toBase	Shape	"text"
////= lines-122	toSibling	Circle	""

const uses: [string, (h: Holder, between: Between) => unknown][] = [
  ["a guard over a class", (h, between) => (isSquare(h.shape) ? (between(h), [h.shape.edge, h.shape.edge * 2, h.shape.sides]) : "other")],
  ["a guard over a number", (h, between) => (isNumber(h.value) ? (between(h), [h.value, h.value + 1, h.value * 2]) : "other")],
  ["a guard on this", (h, between) => (h.shape.isSquare() ? (between(h), [h.shape.edge, h.shape.edge * 2, h.shape.sides]) : "other")],
  ["a guard on this about a member", (h, between) => (h.holdsANumber() ? (between(h), [h.value, h.value + 1, h.value * 2]) : "other")],
  ["an assertion over a class", (h, between) => {
    mustBeSquare(h.shape);
    between(h);
    return [h.shape.edge, h.shape.edge * 2, h.shape.sides];
  }],
  ["an assertion over a number", (h, between) => {
    mustBeNumber(h.value);
    between(h);
    return [h.value, h.value + 1, h.value * 2];
  }],
  ["an asserted condition over a class", (h, between) => {
    mustHold(h.shape instanceof Square);
    between(h);
    return [h.shape.edge, h.shape.edge * 2, h.shape.sides];
  }],
  ["an asserted condition over a number", (h, between) => {
    mustHold(typeof h.value === "number");
    between(h);
    return [h.value, h.value + 1, h.value * 2];
