function inAClosure(v: number | string): () => number {
  if (typeof v === "string") v = v.length;
  const read = () => v + 1;
  arguments[0] = "text";
  return read;
}

function straight(v: number | string): unknown {
  if (typeof v === "number") {
    arguments[0] = "text";
    return v + 1;
  }
  return "other";
}

////= lines-199	throughAHelper	overwrite	arguments

function overwrite(list: IArguments): void {
  list[0] = "text";
}

////= Leaf

////= cleared	arguments[0] = null

function aLiteral(mode: "on" | "off"): unknown {
  if (mode === "on") {
    arguments[0] = "off";
    return mode;
  }
  return "other";
}

function notPassed(v?: number | string): unknown {
  if (v === undefined) {
    arguments[0] = "text";
    return v;
  }
  return "other";
}

