}
console.log("2000 honest rounds: " + total);

const keys = [3, 1, -1, 1.5, -0, 0, NaN, Infinity, -Infinity, 0.1 + 0.2, 1e21, 1e-7, 123456789012345680000, 2 ** 31, 2 ** 32 - 2, 2 ** 32 - 1, 2 ** 53, 2 ** 53 + 1, 0.000001, 1 / 3, 5e-324, 1.7976931348623157e308];
const record: Record<number, string> = {};
for (const key of keys) write(record, key, "at " + show(key));
console.log("keys: " + Object.keys(record).join("|"));
for (const key of keys) attempt("read " + show(key), () => [read(record, key), width(record, key)]);
attempt("what is not there", () => [typeof read(record, 2), typeof read(record, -2), typeof read(record, 0.5)]);
attempt("what is not there: its width", () => width(record, 2));
attempt("what is not there: glued", () => read(record, 2) + "!");

const byText: Record<string, string> = record;
attempt("the same by strings", () => [byText["3"], byText["-1"], byText["1.5"], byText["0"], byText["-0"], byText["NaN"], byText["Infinity"], byText["0.30000000000000004"], byText["1e+21"], byText["1e21"], byText["1e-7"], byText["9007199254740992"], byText["0.000001"]]);

const written: Record<number, string> = {};
written[-0] = "minus zero";
written[1e21] = "large";
written[NaN] = "nan";
written[0.5] = "half";
written[1_000] = "thousand";
written[0b11] = "three";
console.log("written out: " + Object.keys(written).join("|") + " " + JSON.stringify(written));
attempt("written out: reads", () => [written[0], written[-0], written[1e21], written[NaN], written[0.5], written[1000], written[3], typeof written[4]]);

const points: Record<number, { x: number }> = { 1: { x: 1 } };
attempt("objects: there", () => points[1].x);
attempt("objects: not there", () => points[2].x);
attempt("objects: 1.0 and 1", () => points[1.0] === points[1]);
const functions: Record<number, () => number> = { 0: () => 5 };
attempt("functions: there, by minus zero", () => functions[-0]());
attempt("functions: not there", () => functions[1]());

const list: Record<number, string> = ["a", "b"];
attempt("a list behind the record type", () => [read(list, 0), typeof read(list, 2), typeof read(list, -1), Object.keys(list)]);
write(list, 3, "d");
write(list, -1, "minus");
attempt("stored to", () => [Object.keys(list), Array.isArray(list) ? list.length : -1]);
const text: Record<number, string> = "xyz";
attempt("a string behind the record type", () => [read(text, 0), typeof read(text, 3), width(text, 1)]);
attempt("a string behind the record type is stored to", () => write(text, 0, "q"));

export {};
//// number-members-come-out-of-every-listing-unchanged.ts
////= lines-27	Reading	a	number	b	number

////= lines-99	Sample	a	b	number

function text(value: unknown): string {
  if (typeof value !== "number") return typeof value;
  return Object.is(value, -0) ? "-0" : String(value);
}

function byKey(r: Reading, key: keyof Reading): number {
  return r[key];
}

function everyWay(r: Reading): string {
  const walked: string[] = [];
  for (const key in r) walked.push(text(Reflect.get(r, key)));
  const { a, ...rest } = r;
  const copy = { ...r };
  return [
    "direct " + text(r.a) + " " + text(r.b),
    "by key " + text(byKey(r, "a")) + " " + text(byKey(r, "b")),
    "values " + Object.values(r).map(text).join(" "),
    "entries " + Object.entries(r).map(([, value]) => text(value)).join(" "),
    "for-in " + walked.join(" "),
    "copy " + text(copy.a) + " " + text(copy.b),
    "rest " + text(a) + " " + text(rest.b),
    "assign " + text(Object.assign({ a: 0, b: 0 }, r).b),
    "clone " + text(structuredClone(r).a) + " " + text(structuredClone(r).b),
    "descriptor " + text(Object.getOwnPropertyDescriptor(r, "b")?.value),
    "json " + JSON.stringify(r),
    "list " + [r.a, r.b].map(text).join(" "),
    "text " + `${r.a} ${r.b}`,
  ].join("; ");
}

const numbers = [0, -0, 1, -1, 0.1, NaN, Infinity, -Infinity, 2147483647, 2147483648, -2147483649, 4294967296, 1e21, 5e-324, 9007199254740993];

for (const n of numbers) {
  console.log(text(n) + ", a literal: " + everyWay({ a: n, b: n }));
  console.log(text(n) + ", an instance: " + everyWay(new Sample(n, n)));
}

const changing: Reading = { a: 1, b: 2 };
const instance = new Sample(1, 2);
for (const n of numbers) {
  changing.b = n;
  instance.b = n;
  console.log("stored " + text(n) + ": " + Object.values(changing).map(text).join(" ") + " | " + Object.values(instance).map(text).join(" ") + " | " + JSON.stringify([changing, instance]));
}

const nan1: Reading = { a: NaN, b: 0 / 0 };
const bits = new Float64Array([nan1.a, nan1.b, -nan1.a, Math.sqrt(-1)]);
console.log("every not-a-number is one: " + Array.from(bits).map(text).join(" ") + " " + Object.is(nan1.a, nan1.b) + " " + (nan1.a === nan1.b) + " " + [nan1.a].includes(nan1.b) + " " + [nan1.a].indexOf(nan1.b));

const odd = new Float64Array(new BigUint64Array([0xfff8000000000001n, 0x7ff0000000000001n, 0xffffffffffffffffn]).buffer);
const carried: Reading[] = Array.from(odd, n => ({ a: n, b: n }));
console.log("unusual bit patterns read from memory: " + carried.map(r => everyWay(r).length + ":" + text(r.a) + ":" + typeof r.b).join(" "));
const carriedInstances = Array.from(odd, n => new Sample(n, n));
console.log("in instances: " + carriedInstances.map(r => text(r.a) + ":" + Object.values(r).map(text).join("/")).join(" "));

export {};
//// number-members-hold-every-kind-of-number-in-every-layout.ts
////= lines-27	Reading	value	number	count	number

////= lines-280	text

////= lines-20	value	r	Reading	number	return	r.value

////= lines-159	twice	r	Reading	r.value	2	r.count

function truncated(r: Reading): number {
  return (r.value | 0) + (r.count | 0);
}

function increment(r: Reading): number {
  r.count++;
  r.value += 1;
  return r.count;
}

const numbers = [
  0,
  -0,
  1,
  -1,
  0.5,
  NaN,
  Infinity,
  -Infinity,
  2147483647,
  2147483648,
  -2147483648,
  -2147483649,
  4294967295,
  9007199254740991,
  9007199254740992,
  1e308,
  5e-324,
];

function layouts(n: number): [string, Reading][] {
  const wide = { label: "wide", count: n, other: 0.25, value: n };
  return [
    ["value first", { value: n, count: n }],
    ["count first", { count: n, value: n }],
    ["wide", wide],
    ["cloned", structuredClone({ count: n, value: n })],
    ["assigned", Object.assign({}, { value: n }, { count: n })],
  ];
}

for (const n of numbers) {
  for (const [name, r] of layouts(n)) {
    const line = [text(value(r)), text(twice(r)), text(truncated(r)), text(increment(r)), text(r.value), text(r.count)];
    console.log(text(n) + ", " + name + ": " + line.join(" "));
  }
}

const one: Reading = { value: 1, count: 1 };
const history: string[] = [];
for (const n of numbers) {
  one.value = n;
  one.count = n;
  history.push(text(one.value) + "/" + text(twice(one)));
}
console.log("one object takes them all: " + history.join(" "));

const grows: Reading = { count: 2147483646, value: 2147483646 };
for (let i = 0; i < 4; i++) console.log("past the 32-bit limit: " + increment(grows) + " " + grows.value);

const shrinks: Reading = { value: 0, count: 0 };
shrinks.value *= -1;
shrinks.count = shrinks.count % -1;
console.log("zero times minus one: " + text(shrinks.value) + " " + text(shrinks.count) + " " + JSON.stringify(shrinks));
console.log("one over it: " + text(1 / shrinks.value));

export {};
