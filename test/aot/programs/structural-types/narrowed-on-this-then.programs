class Byte {
  n: number = 0;
  flag: boolean = false;
  set(v: number): void {
    this.n = v & 255;
  }
  read(): number {
    return this.n;
  }
}
class Flags {
  a: boolean = false;
  b: boolean = true;
  c: boolean = false;
}

const values: number[] = [
  0,
  -0,
  1,
  -1,
  127,
  128,
  -128,
  -129,
  255,
  256,
  32767,
  32768,
  -32768,
  65535,
  65536,
  2147483647,
  2147483648,
  -2147483648,
  -2147483649,
  4294967295,
  4294967296,
  9007199254740991,
  9007199254740992,
  -9007199254740991,
  5e-324,
  1.7976931348623157e308,
  Infinity,
  -Infinity,
  NaN,
  0.1,
  1e21,
];

function exact(n: number): string {
  return typeof n + " " + (Object.is(n, -0) ? "-0" : String(n));
}

const whole = new Whole();
const fraction = new Fraction();
for (const value of values) {
  whole.n = value;
  fraction.n = value;
  const label = exact(value);
  show(label + " in the whole field", () => exact(whole.read()) + " " + whole.isSet() + " " + Object.is(whole.n, value));
  show(label + " in the fraction field", () => exact(fraction.read()) + " " + fraction.isSet() + " " + Object.is(fraction.n, value));
  show(label + " keys", () => Object.keys(whole).join() + " " + JSON.stringify(whole));
}

