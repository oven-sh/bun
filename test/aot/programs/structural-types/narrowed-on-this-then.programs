//// narrowing-survives-an-await-and-a-yield.ts
////= show-4

const log: string[] = [];

////= attempt-2

export {};

interface Cell {
  value: number | string;
  inner: { n: number } | null;
}

async function afterAwait(c: Cell): Promise<number> {
  if (typeof c.value === "number") {
    await null;
    return c.value + 1;
  }
  return -1;
}

async function innerAfterAwait(c: Cell): Promise<number> {
  if (c.inner !== null) {
    await null;
    return c.inner.n;
  }
  return -1;
}

function* afterYield(c: Cell): Generator<string, number, void> {
  if (typeof c.value === "number") {
    yield "paused";
    return c.value + 1;
  }
  return -1;
}

async function capturedAfterAwait(spoil: boolean): Promise<number> {
  let v: number | string = 1;
  const change = async () => {
    v = "text";
  };
  if (typeof v === "number") {
    if (spoil) await change();
    else await null;
    return v + 1;
  }
  return -1;
}

async function attemptAsync(label: string, run: () => Promise<unknown>): Promise<void> {
  try {
    console.log(label, "->", show(await run()));
  } catch (error) {
    console.log(label, "threw", error instanceof Error ? error.constructor.name : typeof error);
  }
}

const make = (): Cell => ({ value: 1, inner: { n: 5 } });

await attemptAsync("honest await", () => afterAwait(make()));
await attemptAsync("honest inner", () => innerAfterAwait(make()));
attempt("honest yield", () => {
  const g = afterYield(make());
  return [g.next().value, g.next().value];
});
await attemptAsync("honest captured", () => capturedAfterAwait(false));
let warm = 0;
for (let i = 0; i < 2000; i++) {
  warm += (await afterAwait(make())) + (await innerAfterAwait(make()));
  const g = afterYield(make());
  g.next();
  warm += Number(g.next().value);
}
console.log("2000 honest rounds", warm);

await attemptAsync("changed during the await", () => {
  const c = make();
  const running = afterAwait(c);
  c.value = "text";
  return running;
});
await attemptAsync("cleared during the await", () => {
  const c = make();
  const running = innerAfterAwait(c);
  c.inner = null;
  return running;
});
attempt("changed during the yield", () => {
  const c = make();
  const g = afterYield(c);
  g.next();
  c.value = "text";
  return g.next().value;
});
await attemptAsync("a captured variable changed during the await", () => capturedAfterAwait(true));
await attemptAsync("two runs over one cell", async () => {
  const c = make();
  const spoil = async (): Promise<number> => {
    c.value = "spoiled";
    return 0;
  };
  return Promise.all([afterAwait(c), spoil(), afterAwait(c)]);
});
await attemptAsync("for await and a narrowed element", async () => {
  const cells: Cell[] = [make(), make()];
  async function* each(): AsyncGenerator<Cell> {
    for (const c of cells) yield c;
  }
  const results: number[] = [];
  for await (const c of each()) {
    if (typeof c.value === "number") {
      cells[0].value = "first";
      cells[1].value = "second";
      await null;
      results.push(c.value + 1);
    }
  }
  return results;
});
await attemptAsync("honest again", () => afterAwait(make()));
//// nested-arrays-of-dogs-get-cats.ts
////= show-33

function legsAt(packs: Dog[][], row: number, column: number): number {
  return packs[row][column].legs + 1;
}

function totalLegs(packs: Dog[][]): number {
  let total = 0;
  for (let i = 0; i < packs.length; i++) for (let j = 0; j < packs[i].length; j++) total += packs[i][j].legs;
  return total;
}

function barks(packs: Dog[][]): string {
  let text = "";
  for (const pack of packs) for (const dog of pack) text += dog.bark() + ";";
  return text;
}

function flatLegs(packs: Dog[][]): number[] {
  return packs.flat().map(dog => dog.legs);
}

function make(): Dog[][] {
  return [[new Dog("a"), new Dog("b")], [new Dog("c")]];
}

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = make();
  warm += legsAt(honest, 0, 1) + totalLegs(honest) + barks(honest).length + flatLegs(honest).length;
}
console.log("after 2000 honest packs", warm);

function report(name: string, packs: Dog[][]): void {
  attempt(name + ": names", () => packs.map(pack => pack.map(dog => dog.name + ":" + dog.constructor.name)));
  attempt(name + ": legs", () => packs.map(pack => pack.map(dog => dog.legs)));
  attempt(name + ": total legs", () => totalLegs(packs));
  attempt(name + ": flat legs", () => flatLegs(packs));
  attempt(name + ": barks", () => barks(packs));
  attempt(name + ": legs at 0, 1", () => legsAt(packs, 0, 1));
}

{
  const packs = make();
  const wide: Animal[][] = packs;
  wide.push([new Cat("tom")]);
  report("a row of cats is pushed", packs);
}
{
  const packs = make();
  const wide: Animal[][] = packs;
  wide[0].push(new Cat("tom"));
  report("a cat is pushed into a row", packs);
}
{
  const packs = make();
  const wide: Animal[][] = packs;
  wide[0][1] = new Cat("tom");
  report("a cat is stored into a row", packs);
}
{
  const packs = make();
  const row: Animal[] = packs[0];
  row[1] = new Cat("tom");
  report("through an alias of one row", packs);
}
{
  const packs = make();
  const wide: Animal[][] = packs;
  wide[0] = [new Cat("tom"), new Cat("kit")];
  report("a row is replaced", packs);
}
{
  const packs = make();
  const wide: (Dog[] | Cat[])[] = packs;
  wide[1] = [new Cat("tom")];
  report("an array of either kind of row", packs);
}
{
  const packs = make();
  const shared = packs[0];
  packs.push(shared);
  const wide: Animal[] = shared;
  wide[0] = new Cat("tom");
  report("one row is there twice", packs);
}
{
