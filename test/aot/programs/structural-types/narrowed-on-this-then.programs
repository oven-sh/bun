class Shape {
  sides = 4;
  edgeOrSides(): unknown {
    if (this instanceof Square) return this.edge;
    return this.sides;
  }
  doubled(): unknown {
    return this instanceof Square ? this.edge * 2 : this.sides * 2;
  }
  hasEdge(): unknown {
    return "edge" in this ? typeof this.edge : "no edge";
  }
}

