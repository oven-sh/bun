//// narrowed-on-this-then-a-method-stores.ts
////= text-16

class Machine {
  value: number | string = 1;
  shape: Shape = new Square();
  next: Machine | null = null;
  mode: "on" | "off" = "on";
  #hidden: number | string = 1;
  static shared: number | string = 1;

  spoil(really: boolean): void {
    if (!really) return;
    this.value = "text";
    this.shape = new Shape();
    this.next = null;
    this.mode = "off";
    this.#hidden = "text";
    Machine.shared = "text";
  }

  typeofThis(really: boolean): unknown {
    if (typeof this.value === "number") {
      this.spoil(really);
      return [this.value, this.value + 1, this.value * 2];
    }
    return "other";
  }

  instanceofThis(really: boolean): unknown {
    if (this.shape instanceof Square) {
      this.spoil(really);
      return [this.shape.edge, this.shape.edge * 2, this.shape.sides];
    }
    return "other";
  }

  notNullThis(really: boolean): unknown {
    this.next = new Machine();
    if (this.next !== null) {
      this.spoil(really);
      return this.next.mode;
    }
    return "other";
  }

  literalThis(really: boolean): unknown {
    if (this.mode === "on") {
      this.spoil(really);
      return [this.mode, this.mode === "on", this.mode.length];
    }
    return "other";
  }

  privateThis(really: boolean): unknown {
    if (typeof this.#hidden === "number") {
      this.spoil(really);
      return [this.#hidden, this.#hidden + 1, this.#hidden * 2];
    }
    return "other";
  }

  staticMember(really: boolean): unknown {
    Machine.shared = 1;
    if (typeof Machine.shared === "number") {
      this.spoil(really);
      return [Machine.shared, Machine.shared + 1, Machine.shared * 2];
    }
    return "other";
  }

  inAnArrow(really: boolean): unknown {
    const read = (): unknown => {
      if (typeof this.value === "number") {
        this.spoil(really);
        return [this.value, this.value + 1];
      }
      return "other";
    };
    return read();
  }

  get computed(): unknown {
    if (typeof this.value === "number") {
      this.spoil(true);
      return [this.value, this.value + 1];
    }
    return "other";
  }
}

class Quiet extends Machine {
  spoil(really: boolean): void {}
}

function round(label: string, make: () => Machine, really: boolean): void {
  attempt(label + ": typeof", () => make().typeofThis(really));
  attempt(label + ": instanceof", () => make().instanceofThis(really));
  attempt(label + ": not null", () => make().notNullThis(really));
  attempt(label + ": a literal", () => make().literalThis(really));
  attempt(label + ": a private field", () => make().privateThis(really));
  attempt(label + ": a static member", () => make().staticMember(really));
  attempt(label + ": in an arrow function", () => make().inAnArrow(really));
}

round("honest", () => new Machine(), false);
for (let i = 0; i < 2000; i++) {
  const m = new Machine();
  m.typeofThis(false);
  m.instanceofThis(false);
  m.notNullThis(false);
  m.literalThis(false);
  m.privateThis(false);
  m.staticMember(false);
  m.inAnArrow(false);
}
round("a method stores", () => new Machine(), true);
round("a subclass whose method stores nothing", () => new Quiet(), true);
attempt("inside a getter", () => new Machine().computed);
attempt("inside a getter of the quiet subclass", () => new Quiet().computed);
round("honest again", () => new Machine(), false);
//// narrowed-parameters-that-depend-on-each-other.ts
////= text-13

type Args = [kind: "add", payload: number] | [kind: "name", payload: string];

const handle: (...args: Args) => unknown = (kind, payload) => {
  if (kind === "add") return [kind, payload, payload + 1, payload * 2];
  return [kind, payload, payload.length, payload.toUpperCase()];
};

function declared(...args: Args): unknown {
  const [kind, payload] = args;
  if (kind === "add") return [kind, payload, payload + 1, payload * 2];
  return [kind, payload, payload.length, payload.toUpperCase()];
}

function byIndex(...args: Args): unknown {
  if (args[0] === "add") return [args[0], args[1], args[1] + 1];
  return [args[0], args[1], args[1].length];
}

const inASwitch: (...args: Args) => unknown = (kind, payload) => {
  switch (kind) {
    case "add":
      return payload + 1;
    case "name":
      return payload.length;
  }
};

const all: [string, (...args: Args) => unknown][] = [
  ["an arrow function", handle],
  ["a rest parameter taken apart", declared],
  ["a rest parameter read by index", byIndex],
  ["a switch", inASwitch],
];

function mixedUp(kind: "add" | "name"): Args {
  const args: Args = kind === "add" ? ["add", 1] : ["name", "n"];
  const loose: (string | number)[] = args;
  loose[1] = kind === "add" ? "text" : 5;
  return args;
}

function short(): Args {
  const args: Args = ["add", 1];
  const loose: (string | number)[] = args;
  loose.pop();
  return args;
}

for (const [name, f] of all) attempt("honest: " + name, () => [f("add", 1), f("name", "n")]);
for (let i = 0; i < 2000; i++) for (const [, f] of all) i % 2 === 0 ? f("add", i) : f("name", "n");
for (const [name, f] of all) {
  attempt("add with a string: " + name, () => f(...mixedUp("add")));
  attempt("name with a number: " + name, () => f(...mixedUp("name")));
  attempt("add with nothing: " + name, () => f(...short()));
  attempt("through apply: " + name, () => f.apply(undefined, mixedUp("add")));
}
for (const [name, f] of all) attempt("honest again: " + name, () => [f("add", 1), f("name", "n")]);
