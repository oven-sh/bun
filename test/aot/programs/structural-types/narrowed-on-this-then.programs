//// narrowed-to-never-and-the-code-still-runs.ts
////= text-13

////= Circle

////= Square-10

type Shape = Circle | Square;

////= lines-102	retag	o	kind	string	kind	o.kind

function triangle(): Shape {
  const s = new Square();
  retag(s, "triangle");
  return s;
}

function offTheEnd(s: Shape): number {
  switch (s.kind) {
    case "circle":
      return s.radius;
    case "square":
      return s.edge;
  }
}

function intoTheDefault(s: Shape): unknown {
  switch (s.kind) {
    case "circle":
      return s.radius;
    case "square":
      return s.edge;
    default: {
      const impossible: never = s;
      return ["typed never", typeof impossible, JSON.stringify(impossible)];
    }
  }
}

function pastTheLastElse(s: Shape): unknown {
  if (s.kind === "circle") return s.radius;
  else if (s.kind === "square") return s.edge;
  else return ["typed never", typeof s];
}

function refuses(value: never): never {
  throw new RangeError("unexpected");
}

function intoARefusal(s: Shape): unknown {
  if (s.kind === "circle") return s.radius;
  if (s.kind === "square") return s.edge;
  return refuses(s);
}

function afterTheChain(s: Shape): unknown {
  let result = "nothing was stored";
  if (s.kind === "circle") result = "circle";
  else if (s.kind === "square") result = "square";
  return result;
}

function aTableOfHandlers(s: Shape): unknown {
  const handlers = { circle: () => "round", square: () => "flat" };
  return handlers[s.kind]();
}

const uses: [string, (s: Shape) => unknown][] = [
  ["a switch without a default", offTheEnd],
  ["a switch with a default", intoTheDefault],
  ["a chain of ifs", pastTheLastElse],
  ["a function that takes never", intoARefusal],
  ["a variable that every branch stores to", afterTheChain],
  ["a table of handlers", aTableOfHandlers],
];

for (const [name, use] of uses) attempt("honest: " + name, () => [use(new Circle()), use(new Square())]);
for (let i = 0; i < 2000; i++) for (const [, use] of uses) use(i % 2 === 0 ? new Circle() : new Square());
for (const [name, use] of uses) attempt("a tag outside the union: " + name, () => use(triangle()));
attempt("the result typed number is used", () => {
  const n: number = offTheEnd(triangle());
  return [n, n + 1, n * 2];
});
for (const [name, use] of uses) attempt("honest again: " + name, () => [use(new Circle()), use(new Square())]);
//// narrowed-to-one-literal-then-a-call-stores-another.ts
////= say

class Switch {
  mode: "on" | "off" = "on";
  level: 0 | 1 | 2 = 0;
  armed: boolean = true;
  owner: null | "someone" = null;
  note: undefined | "noted" = undefined;
}

function flip(s: Switch): void {
  s.mode = "off";
  s.level = 2;
  s.armed = false;
  s.owner = "someone";
  s.note = "noted";
}

const costs = { on: 10, off: 20 };
const names = ["zero", "one", "two"];

const s = new Switch();
if (s.mode === "on" && s.level === 0 && s.armed === true && s.owner === null && s.note === undefined) {
  flip(s);
  say("mode", s.mode);
  say("mode is on", s.mode === "on");
  say("cost", costs[s.mode]);
  say("level", s.level);
  say("level plus one", s.level + 1);
  say("name", names[s.level]);
  say("armed", s.armed);
  say("armed picks", s.armed ? "yes" : "no");
  say("owner", s.owner);
  say("owner or nobody", s.owner ?? "nobody");
  say("note", s.note);
  say("note or nothing", s.note ?? "nothing");
  const mode: "on" = s.mode;
  const level: 0 = s.level;
  const armed: true = s.armed;
  const owner: null = s.owner;
  const note: undefined = s.note;
  say("kept", [mode, level, armed, owner, note].join());
}
//// narrowed-under-a-constant-key-then-stored-to.ts
////= text-16

const mark = Symbol("mark");

class Cell {
  value: number | string = 1;
  shape: Shape = new Square();
  [mark]: number | string = 1;
  7: number | string = 1;
}

type Between = (c: Cell) => void;
const keep: Between = () => {};
const spoil: Between = c => {
  c.value = "text";
  c.shape = new Shape();
  c[mark] = "text";
  c[7] = "text";
};

const uses: [string, (c: Cell, between: Between) => unknown][] = [
  ["a constant string key", (c, between) => {
    const key = "value";
    if (typeof c[key] === "number") {
      between(c);
      return [c[key], c[key] + 1, c[key] * 2, c.value];
    }
    return "other";
  }],
  ["a literal key in brackets", (c, between) => {
    if (typeof c["value"] === "number") {
      between(c);
      return [c["value"], c["value"] + 1, c.value + 1];
    }
    return "other";
  }],
  ["tested with a dot, read with brackets", (c, between) => {
    if (typeof c.value === "number") {
      between(c);
      return [c["value"] + 1];
    }
    return "other";
  }],
  ["a constant key to a class", (c, between) => {
    const key = "shape";
    if (c[key] instanceof Square) {
      between(c);
      return [c[key].edge, c[key].edge * 2, c[key].sides];
    }
    return "other";
  }],
  ["a symbol key", (c, between) => {
    if (typeof c[mark] === "number") {
      between(c);
      return [c[mark], c[mark] + 1, c[mark] * 2];
    }
    return "other";
  }],
  ["a numeric key", (c, between) => {
    if (typeof c[7] === "number") {
      between(c);
      return [c[7], c[7] + 1, c[7] * 2];
    }
    return "other";
  }],
];

function underAParameter(record: Record<string, number | string>, key: string, really: boolean): unknown {
  const change = (): void => {
    if (really) record[key] = "text";
  };
  if (typeof record[key] === "number") {
    change();
    return [record[key], record[key] + 1, record[key] * 2];
  }
  return "other";
}

function underAnIndex(list: (number | string)[], index: number, really: boolean): unknown {
  const change = (): void => {
    if (really) list[index] = "text";
  };
  if (typeof list[index] === "number") {
    change();
    return [list[index], list[index] + 1, list[index] * 2];
  }
  return "other";
}

function underAKeyOfAClass(c: Cell, key: "value" | 7, between: Between): unknown {
  if (typeof c[key] === "number") {
    between(c);
    return [c[key], c[key] + 1, c[key] * 2];
  }
  return "other";
}

function round(label: string, between: Between, really: boolean): void {
  for (const [name, use] of uses) attempt(label + ": " + name, () => use(new Cell(), between));
  attempt(label + ": a key that is a parameter", () => underAParameter({ a: 1, b: 2 }, "b", really));
  attempt(label + ": an index that is a parameter", () => underAnIndex([1, 2, 3], 1, really));
  attempt(label + ": one of two keys of a class", () => [underAKeyOfAClass(new Cell(), "value", between), underAKeyOfAClass(new Cell(), 7, between)]);
}

round("honest", keep, false);
for (let i = 0; i < 2000; i++) {
  for (const [, use] of uses) use(new Cell(), keep);
  underAParameter({ a: 1, b: 2 }, "b", false);
  underAnIndex([1, 2, 3], 1, false);
  underAKeyOfAClass(new Cell(), "value", keep);
}
round("stored to", spoil, true);
round("honest again", keep, false);
//// narrowing-by-equality-and-values-that-compare-equal.ts
////= show-4

const log: string[] = [];

////= attempt-2

function reciprocal(x: 0 | 1): number {
  if (x === 0) return 1 / x;
  return x;
}

function zeroText(x: 0 | 1): string {
  return x === 0 ? Object.is(x, 0) + ":" + Object.is(x, -0) : "one";
}

function switchOnZero(x: 0 | 1 | 2): number {
  switch (x) {
    case 0:
      return 10 / x;
    case 1:
      return 10;
    case 2:
      return 5;
  }
}

function common(a: number | string, b: string | boolean): number {
  if (a === b) return a.length + b.length;
  return -1;
}

function looseNull(v: number | null | undefined): number {
  if (v == null) return -1;
  return v + 1;
}

function notUndefined(v: number | undefined): number {
  return v !== undefined ? v + 1 : -1;
}

function sameObject(a: { n: number } | null, b: { n: number }): number {
  if (a === b) return a.n + b.n;
  return -1;
}

function literal(mode: "on" | "off", other: "on" | "auto"): string {
  if (mode === other) return mode + other;
  return "differ";
}

const negativeZero: 0 = -0;

attempt("honest", () => [reciprocal(0), reciprocal(1), zeroText(0), switchOnZero(0), switchOnZero(2), common("ab", "ab"), common(1, true), looseNull(null), looseNull(undefined), looseNull(0), notUndefined(0), literal("on", "on")]);
let warm = 0;
for (let i = 0; i < 2000; i++) warm += reciprocal(1) + switchOnZero(i & 1 ? 1 : 2) + common("a", "a") + looseNull(i) + notUndefined(i);
console.log("2000 honest rounds", warm);

attempt("negative zero typed 0: reciprocal", () => reciprocal(negativeZero));
attempt("negative zero typed 0: text", () => zeroText(negativeZero));
attempt("negative zero typed 0: switch", () => switchOnZero(negativeZero));
attempt("negative zero typed 0: written in place", () => reciprocal(-0));
attempt("negative zero typed 0: in a field", () => {
  class Holder {
    x: 0 | 1 = -0;
    read(): number {
      return this.x === 0 ? 1 / this.x : 7;
    }
  }
  return new Holder().read();
});
attempt("negative zero typed 0: in an element", () => {
  const list: (0 | 1)[] = [0, -0, 1];
  return list.map(reciprocal);
});
attempt("negative zero typed 0: as a key", () => {
  const names: Record<0 | 1, string> = { 0: "zero", 1: "one" };
  return names[negativeZero];
});
attempt("negative zero typed 0: in a template", () => `${negativeZero}` + String(negativeZero) + JSON.stringify(negativeZero) + [negativeZero].join());
attempt("negative zero typed 0: in a Map and a Set", () => {
  const m = new Map<0 | 1, string>([[negativeZero, "stored"]]);
  return [m.get(0), [...m.keys()].map(k => Object.is(k, -0)), new Set<0 | 1>([0, negativeZero]).size];
