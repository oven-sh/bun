attempt("NaN never equals itself", () => {
  const same = (a: number, b: number): string => (a === b ? "same" : a !== a ? "not a number" : "differ");
  return [same(NaN, NaN), same(0, -0), same(1, 1)];
});
attempt("the same object", () => {
