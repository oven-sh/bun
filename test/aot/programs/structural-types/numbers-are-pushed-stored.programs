//// one-class-expression-extends-many-bases.ts
////= show-4

const log: string[] = [];

////= attempt-2

function Tagged(Base: new () => object) {
  return class extends Base {
    tag = "tagged";
    describe(): string {
      return this.tag + ":" + Object.keys(this).join();
    }
  };
}

function Counted(Base: new () => object) {
  return class extends Base {
    count = 0;
    #hidden = 5;
    static made = 0;
    constructor() {
      super();
      Counted.total++;
    }
    next(): number {
      return ++this.count + this.#hidden;
    }
    get twice(): number {
      return this.count * 2;
    }
  };
}
Counted.total = 0;

////= Point-4

class Name {
  first = "a";
  last = "b";
  middle = "c";
}

class Empty {}

class Wide {
  a = 1;
  b = 2;
  c = 3;
  d = 4;
  e = 5;
  f = 6;
}

////= Child-4

const bases: [string, new () => object][] = [
  ["Point", Point],
  ["Name", Name],
  ["Empty", Empty],
  ["Wide", Wide],
  ["Child", Child],
  ["Array", Array],
  ["Map", Map],
  ["Error", Error],
  ["Object", Object],
  ["Date", Date],
];

for (const [name, Base] of bases) {
  attempt("Tagged " + name, () => {
    const made = new (Tagged(Base))();
    return [made.describe(), made.tag, JSON.stringify(Object.keys(made)), made instanceof Base];
  });
  attempt("Counted " + name, () => {
    const made = new (Counted(Base))();
    return [made.next(), made.next(), made.twice, Object.keys(made).join(), made instanceof Base];
  });
  attempt("Counted over Tagged " + name, () => {
    const made = new (Counted(Tagged(Base)))();
    return [made.next(), Object.keys(made).join(), made instanceof Base];
  });
}

attempt("again in the other order", () => [...bases].reverse().map(([, Base]) => new (Tagged(Base))().describe()));
attempt("two classes from one base are different classes", () => {
  const A = Tagged(Point);
  const B = Tagged(Point);
  return [A === B, new A() instanceof B, new A().describe(), new B().describe()];
});
attempt("one class, many instances", () => {
  const A = Tagged(Point);
  const list = [new A(), new A(), new A()];
  list[1].tag = "changed";
  return list.map(item => item.describe());
});
attempt("2000 classes over alternating bases", () => {
  let length = 0;
  for (let i = 0; i < 2000; i++) length += new (Tagged(bases[i % 5][1]))().describe().length;
  return length;
});
attempt("members of the base are still there", () => {
  const made = new (Tagged(Point))();
  const asPoint: object = made;
  return asPoint instanceof Point ? [asPoint.x, asPoint.y, asPoint.sum()] : "no point";
});
attempt("how often the constructors ran", () => Counted.total);
//// one-class-factory-has-honest-callers-and-odd-callers.ts
////= describe

////= lines-86	Base	1	2	sum

////= derive	"dq"

function honestOne(): number {
  return new (derive(Base))().twice();
}

function honestTwo(): string {
  return describe(new (derive(Base))());
}

const Kept = derive(Base);

function honestThree(): number {
  const made = new Kept();
  made.x = 5;
  return made.twice();
}

console.log("honest: " + honestOne() + " " + honestTwo() + " " + honestThree());
let warm = 0;
for (let i = 0; i < 2000; i++) warm += honestOne() + honestThree();
console.log("2000 honest rounds: " + warm);

class LookAlike {
  y = 20;
  x = 10;
  more = "more";
  sum(): number {
    return -1;
  }
}

class Child extends Base {
  z = 3;
  sum(): number {
    return super.sum() + this.z;
  }
}

class WithAccessors {
  #x = 100;
  get x(): number {
    return this.#x;
  }
  set x(value: number) {
    this.#x = value;
  }
  y = 200;
  sum(): number {
    return this.x + this.y;
  }
}

const Wrapped = new Proxy(Base, {});
const Returning: typeof Base = class {
  x = 0;
  y = 0;
  constructor() {
    return { x: 7, y: 8, sum: () => 15 };
  }
  sum(): number {
    return 0;
  }
};

function report(label: string, Parent: typeof Base): void {
  const made = new (derive(Parent))();
  console.log(label + ": " + describe(made) + " sum " + made.sum() + " typeof twice " + typeof made.twice + " base " + (made instanceof Base));
}

report("a look-alike", LookAlike);
report("a subclass", Child);
report("accessors", WithAccessors);
report("a proxy", Wrapped);
report("a constructor that returns a literal", Returning);
report("what the factory made", derive(Base));
report("the honest base again", Base);
console.log("honest again: " + honestOne() + " " + honestTwo() + " " + honestThree());
