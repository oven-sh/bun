console.log(describe(make(A)));
//// one-function-closes-iterators-that-have-return-and-throw-and-ones-that-do-not.ts
////= text-14

type Walk = Iterator<number, string | undefined, undefined>;

function* generator(): Generator<number, string, undefined> {
  try {
    yield 1;
    yield 2;
    return "ran out";
  } finally {
    console.log("  the generator's finally");
  }
}

class OnlyNext implements Walk {
  n = 0;
  next(): IteratorResult<number, string | undefined> {
    return { done: false, value: ++this.n };
  }
}

class WithReturn extends OnlyNext {
  return(value?: string): IteratorResult<number, string | undefined> {
    console.log("  return got " + text(value) + " with " + arguments.length + " arguments");
    return { done: true, value: "closed by return" };
  }
}

class WithThrow extends OnlyNext {
  throw(error?: unknown): IteratorResult<number, string | undefined> {
    console.log("  throw got " + text(error) + " with " + arguments.length + " arguments");
    return { done: false, value: -1 };
  }
}

class ReturnIsUndefined extends OnlyNext {
  return: undefined = undefined;
  throw: undefined = undefined;
}

function close(walk: Walk): string {
  const first = walk.next();
  const closed = walk.return?.("please");
  const after = walk.next();
  return text(first) + " | " + text(closed) + " | " + text(after);
}

function closeWithNothing(walk: Walk): string {
  walk.next();
  return text(walk.return?.());
}

function upset(walk: Walk): string {
  walk.next();
  try {
    return text(walk.throw?.("upset"));
  } catch (error) {
    return failure(error);
  }
}

const makers: [string, () => Walk][] = [
  ["a generator", generator],
  ["only next", () => new OnlyNext()],
  ["with return", () => new WithReturn()],
  ["with throw", () => new WithThrow()],
  ["return is undefined", () => new ReturnIsUndefined()],
  ["an array's iterator", () => [1, 2, 3][Symbol.iterator]()],
  ["a set's iterator", () => new Set([1, 2, 3]).values()],
  ["a helper over an array", () => [1, 2, 3].values().map(n => n * 2)],
  ["a helper over a generator", () => generator().map(n => n * 2)],
];

for (const [label, make] of makers) {
  console.log(label + ", typeof return " + typeof make().return + ", typeof throw " + typeof make().throw);
  console.log(label + ", close: " + close(make()));
  console.log(label + ", close with nothing: " + closeWithNothing(make()));
  console.log(label + ", upset: " + upset(make()));
}

let count = 0;
for (let i = 0; i < 2000; i++) {
  const walk: Walk = new WithThrow();
  walk.next();
  if (walk.return === undefined) count++;
}
console.log("2000 without return: " + count);
console.log("then a generator at the shared site: " + close(generator()));
//// one-function-has-callers-with-and-without-the-optional-member.ts
////= lines-71	Task	id	number	due	number

function describe(t: Task): string {
  const copy = { ...t };
  return [t.id, t.due, "due" in t, Object.keys(t).join("+"), JSON.stringify(t), "due" in copy, (t.due ?? 0) + 1].join(" ");
}

function withCallerOne(): string {
  return describe({ id: 1, due: 10 });
}

function withCallerTwo(): string {
  const t: Task = { id: 2, due: 20 };
  return describe(t);
}

function withMany(): number {
  let total = 0;
  for (let i = 0; i < 2000; i++) total += describe({ id: i, due: i }).length;
  return total;
}

function withoutCaller(): string {
  return describe({ id: 3 });
}

function undefinedCaller(): string {
  return describe({ id: 4, due: undefined });
}

function flippedCaller(): string {
  return describe({ due: 50, id: 5 });
}

function deletedCaller(): string {
  const t: Task = { id: 6, due: 60 };
  delete t.due;
  return describe(t);
}

function addedCaller(): string {
  const t: Task = { id: 7 };
  t.due = 70;
  return describe(t);
}

const registry = { describe };
const key: keyof typeof registry = "describe";

class Board {
  printer: (t: Task) => string = describe;
  print(t: Task): string {
    return this.printer(t);
  }
}

console.log("without, first of all: " + withoutCaller());
console.log("with, one: " + withCallerOne());
console.log("with, two: " + withCallerTwo());
console.log("with, 2000 times: " + withMany());
console.log("without: " + withoutCaller());
console.log("undefined: " + undefinedCaller());
console.log("flipped: " + flippedCaller());
console.log("deleted: " + deletedCaller());
console.log("added: " + addedCaller());
console.log("with again: " + withCallerOne());

console.log("call, without: " + describe.call(undefined, { id: 8 }));
console.log("apply, undefined: " + describe.apply(undefined, [{ id: 9, due: undefined }]));
console.log("bind, without: " + describe.bind(undefined, { id: 10 })());
console.log("Reflect.apply, with: " + Reflect.apply(describe, undefined, [{ id: 11, due: 1 }]));
console.log("by a computed name, without: " + registry[key]({ id: 12 }));
console.log("through a field, undefined: " + new Board().print({ id: 13, due: undefined }));

const mixed: Task[] = [{ id: 14 }, { id: 15, due: 1 }, { id: 16, due: undefined }, { due: 2, id: 17 }];
console.log("a built-in calls it:");
for (const line of mixed.map(t => describe(t))) console.log("  " + line);
console.log("sorted by due: " + [...mixed].sort((a, b) => (a.due ?? -1) - (b.due ?? -1)).map(t => t.id).join());
console.log("those that have it: " + mixed.filter(t => "due" in t).map(t => t.id).join());
console.log("those where it is defined: " + mixed.filter(t => t.due !== undefined).map(t => t.id).join());

console.log("a promise reaction, without: " + (await Promise.resolve<Task>({ id: 18 }).then(describe)));
console.log("with, at the end: " + withCallerTwo());

