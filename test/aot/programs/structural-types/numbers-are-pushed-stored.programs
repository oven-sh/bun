for (let i = 0; i < 2000; i++) sum += highOf(honest);
show("2000 honest reads", () => sum);
show("bare", () => highOf(bare));
show("halfway", () => highOf(halfway));
show("assigned", () => highOf(assigned));
show("honest", () => highOf(honest));

bare.high = 7;
show("bare after a store", () => bare.sum());
show("bare keys", () => Object.keys(bare).join());
bare.low = 1;
show("bare after two stores", () => bare.sum());
//// objects-of-many-widths-share-one-array.ts
////= Point-2

////= lines-159	read	p	Point	p.x	1000	p.y

function widen(count: number, x: number, y: number, where: "front" | "middle" | "behind"): Point {
  const extras: Record<string, number> = {};
  if (where === "behind") Object.assign(extras, { x, y });
  for (let i = 0; i < count; i++) {
    if (where === "middle" && i === count >> 1) Object.assign(extras, { y, x });
    extras["k" + i] = -i;
  }
  return Object.assign(extras, { x, y });
}

const literals: Point[] = [
  { x: 1, y: 2 },
  ((o: { a: number; x: number; y: number }) => o)({ a: 0, x: 3, y: 4 }),
  ((o: { a: number; b: number; c: number; d: number; e: number; f: number; x: number; y: number }) => o)({
    a: 0,
    b: 0,
    c: 0,
    d: 0,
    e: 0,
    f: 0,
    x: 5,
    y: 6,
  }),
];
console.log("literals: " + literals.map(read).join());

const widths = [0, 1, 2, 3, 5, 6, 7, 8, 15, 16, 17, 31, 33, 63, 64, 65, 100, 300];
const all: Point[] = [];
for (const where of ["front", "middle", "behind"] satisfies ("front" | "middle" | "behind")[]) {
  for (const width of widths) all.push(widen(width, width + 1, width + 2, where));
}

console.log("read: " + all.map(read).join());
console.log("counts: " + all.map(p => Object.keys(p).length).join());
console.log("place of x: " + all.map(p => Object.keys(p).indexOf("x")).join());
console.log("place of y: " + all.map(p => Object.keys(p).indexOf("y")).join());

let total = 0;
for (const p of all) total += p.x - p.y;
console.log("x - y over all: " + total);

for (const p of all) {
  p.x += 1;
  p.y = p.x * 2;
}
console.log("after stores: " + all.map(read).join());
console.log("extras untouched: " + all.map(p => Object.values(p).reduce((a, b) => a + b, 0) - p.x - p.y).join());
console.log("copies: " + all.map(p => Object.keys({ ...p }).length).join());
console.log("json lengths: " + all.map(p => JSON.stringify(p).length).join());

const shrunk: Record<string, number> & Point = Object.assign({ x: 7, y: 8 }, { a: 1, b: 2, c: 3 });
const view: Point = shrunk;
delete shrunk.a;
delete shrunk.c;
console.log("after deleting extras: " + read(view) + " " + JSON.stringify(view));
shrunk.d = 4;
console.log("after adding one: " + read(view) + " " + JSON.stringify(view));
//// odd-number-keys-on-an-array-of-numbers.ts
////= show-32

////= lines-112	read	numbers	number	key	number	numbers[key

function readPlusOne(numbers: number[], key: number): number {
  return numbers[key] + 1;
}

function write(numbers: number[], key: number, value: number): void {
  numbers[key] = value;
}

function isIn(numbers: number[], key: number): boolean {
  return key in numbers;
}

function state(numbers: number[]): string {
  return "length " + numbers.length + ", keys " + Object.keys(numbers).join() + ", " + (numbers.length < 10 ? JSON.stringify(numbers) : "long");
}

let total = 0;
const warm = [1, 2, 3];
for (let i = 0; i < 2000; i++) {
  write(warm, i % 3, i);
  total += read(warm, i % 3) + readPlusOne(warm, (i + 1) % 3) + (isIn(warm, i % 3) ? 1 : 0);
}
console.log("2000 honest rounds: " + total);

const keys = [1, -1, 1.5, -0, NaN, Infinity, -Infinity, 0.1 + 0.2, 2 ** 31 - 1, 2 ** 31, -(2 ** 31), 2 ** 32 - 2, 2 ** 32 - 1, 2 ** 32, 2 ** 53, 1e21, 5e-324];
for (const key of keys) {
  attempt("read " + show(key), () => {
    const numbers = [10, 20, 30];
    return [typeof read(numbers, key), read(numbers, key), readPlusOne(numbers, key), isIn(numbers, key)];
  });
  attempt("write " + show(key), () => {
    const numbers = [10, 20, 30];
    write(numbers, key, 7);
    return [state(numbers), read(numbers, key), isIn(numbers, key)];
  });
  attempt("delete " + show(key), () => {
    const numbers = [10, 20, 30];
    write(numbers, key, 7);
    const deleted = delete numbers[key];
    return [deleted, state(numbers)];
  });
}

const literal = [10, 20, 30];
attempt("written out: reads", () => [literal[-1], literal[1.5], literal[-0], literal[NaN], literal[Infinity], literal[4294967294], literal[4294967295], literal[9007199254740992], literal[1e21]]);
literal[-1] = 1;
literal[1.5] = 2;
literal[-0] = 3;
literal[NaN] = 4;
literal[Infinity] = 5;
literal[4294967295] = 6;
literal[9007199254740992] = 7;
literal[1e21] = 8;
console.log("written out: after eight stores: " + state(literal));
attempt("written out: reads again", () => [literal[-1], literal[1.5], literal[-0], literal[0], literal[NaN], literal[Infinity], literal[4294967295], literal[9007199254740992], literal[9007199254740993], literal[1e21]]);
attempt("the elements alone", () => [literal.map(n => n + 1), literal.reduce((a, b) => a + b, 0), [...literal], literal.slice()]);
attempt("for in", () => {
  const seen: string[] = [];
  for (const key in literal) seen.push(key + "=" + literal[key]);
  return seen;
});
literal[4294967294] = 9;
console.log("the largest index: " + state(literal));

