////: states
const states: [string, () => Athlete][] = [
  ["untouched", () => new Athlete()],
  [
    "an optional member added",
    () => {
      const a = new Athlete();
      a.note = "added";
      return a;
    },
  ],
  [
    "an optional field deleted",
    () => {
      const a = new Athlete();
      delete a.spare;
      return a;
    },
  ],
  [
    "a symbol key added",
    () => {
      const a = new Athlete();
      a[mark] = true;
      return a;
    },
  ],
  ["frozen", () => Object.freeze(new Athlete())],
  ["sealed", () => Object.seal(new Athlete())],
  ["not extensible", () => Object.preventExtensions(new Athlete())],
  [
    "a field redefined as an accessor",
    () => {
      const a = new Athlete();
      Object.defineProperty(a, "pace", { get: () => 6, configurable: true });
      return a;
    },
  ],
  [
    "the prototype of another object",
    () => {
      const a = new Athlete();
      Object.create(a);
      return a;
    },
  ],
  [
    "many members added and deleted",
    () => {
      const a = new Athlete();
      for (let i = 0; i < 40; i++) Reflect.set(a, "k" + i, i);
      for (let i = 0; i < 40; i++) Reflect.deleteProperty(a, "k" + i);
      return a;
    },
  ],
  ["a child of an instance", () => Object.create(new Athlete())],
];
//// numbers-are-pushed-stored-and-filled-into-an-array-of-int32.ts
import type { int32 } from "bun";

////= show-34

let warm = 0;
for (let i = 0; i < 2000; i++) warm += uses(i | 0).length + uses(-i | 0).length;
console.log("4000 honest uses", warm);

const odd: number[] = JSON.parse("[1.5, -0, 2147483648, -2147483649, 1e21, 3]");
odd.push(NaN, Infinity);

////= lines-154	head	list	int32	int32	list[0
function tail(list: int32[]): int32 {
  return list[list.length - 1];
}

for (const n of odd) {
  const label = show(n);
  attempt(label + " pushed", () => {
    const list: int32[] = [1, 2];
    list.push(n);
    return [list, uses(tail(list))];
  });
  attempt(label + " stored", () => {
    const list: int32[] = [1, 2];
    list[0] = n;
    return [list, uses(head(list))];
  });
  attempt(label + " filled", () => {
    const list: int32[] = [1, 2];
    list.fill(n);
    return [list, uses(head(list))];
  });
  attempt(label + " unshifted", () => {
    const list: int32[] = [1, 2];
    list.unshift(n);
    return [list, uses(head(list))];
  });
  attempt(label + " spliced in", () => {
    const list: int32[] = [1, 2];
    list.splice(0, 1, n);
    return [list, uses(head(list))];
  });
  attempt(label + " joined on", () => {
    const list: int32[] = [1, 2];
    const longer: int32[] = list.concat(n, [n]);
    return [longer, uses(tail(longer))];
  });
  attempt(label + " replaced in a copy", () => {
    const list: int32[] = [1, 2];
    const copy: int32[] = list.with(0, n);
    return [copy, uses(head(copy))];
  });
}
attempt("after 2000 honest pushes", () => {
  const list: int32[] = [];
  for (let i = 0; i < 2000; i++) list.push(i | 0);
  list.push(odd[0]);
  let sum = 0;
  for (const v of list) sum += v;
  return [sum, uses(tail(list))];
});
//// numbers-in-fields-typed-as-objects.ts
////= show-30

type Fixable = { toFixed(digits: number): string };

class Cell {
  before = 1;
  value: {};
  after = 2;
  constructor(value: {}) {
    this.value = value;
  }
  kind(): string {
    return typeof this.value;
  }
}

class Amount {
  label = "amount";
  value: Fixable;
  scale = 0.5;
  constructor(value: Fixable) {
    this.value = value;
  }
  text(): string {
    return this.value.toFixed(2);
  }
}

class Pair {
  constructor(public left: Object, public right: { valueOf(): number }) {}
  sum(): number {
    return this.right.valueOf() + this.right.valueOf();
  }
}

function readCell(cell: Cell): {} {
  return cell.value;
}

////= lines-68	around	cell	Cell	number	cell.before	cell.after

const numbers: [string, number][] = [
  ["0", 0],
  ["-0", -0],
  ["1", 1],
  ["-1", -1],
  ["0.5", 0.5],
  ["NaN", NaN],
  ["Infinity", Infinity],
  ["2 ** 31 - 1", 2 ** 31 - 1],
  ["2 ** 31", 2 ** 31],
  ["-(2 ** 31) - 1", -(2 ** 31) - 1],
  ["2 ** 32 + 5", 2 ** 32 + 5],
  ["2 ** 53", 2 ** 53],
  ["the smallest double", Number.MIN_VALUE],
  ["the largest double", Number.MAX_VALUE],
  ["1e-7", 1e-7],
];

let warm = 0;
const reused = new Cell({});
const reusedAmount = new Amount({ toFixed: () => "" });
for (let i = 0; i < 2000; i++) {
  const cell = new Cell({ i });
  warm += cell.kind().length + around(cell) + Object.keys(readCell(cell)).length;
  reused.value = { i };
  warm += new Amount({ toFixed: digits => String(digits) }).text().length + new Pair({}, { valueOf: () => i }).sum();
}
console.log("after 2000 objects", warm);

for (const [name, number] of numbers) {
  attempt(name + ": a new cell", () => {
    const cell = new Cell(number);
    return [cell.kind(), readCell(cell), cell.value, around(cell), Object.is(cell.value, number)];
  });
  attempt(name + ": stored into an old cell", () => {
    reused.value = number;
    return [reused.kind(), readCell(reused), around(reused), Object.is(reused.value, number)];
  });
  attempt(name + ": an amount", () => {
    const amount = new Amount(number);
    reusedAmount.value = number;
    return [amount.label, amount.text(), amount.scale, reusedAmount.text(), typeof reusedAmount.value];
  });
  attempt(name + ": a pair", () => {
    const pair = new Pair(number, number);
    return [pair.left, pair.right, pair.sum()];
  });
  attempt(name + ": a member of a literal", () => {
    const literal: { a: number; held: {}; b: number } = { a: 1, held: number, b: 2 };
    return [literal.a, literal.held, literal.b, JSON.stringify(literal)];
  });
}

const others: [string, {}][] = [
  ["a string", "text"],
  ["true", true],
  ["false", false],
  ["a symbol", Symbol("s")],
  ["a bigint", 2n ** 64n],
  ["an object again", { back: true }],
];
for (const [name, value] of others) {
  attempt(name + ": stored into an old cell", () => {
    reused.value = value;
    return [reused.kind(), readCell(reused), around(reused), reused.value === value];
  });
}
attempt("many cells, each with another kind", () => {
  const cells: Cell[] = [];
  for (let i = 0; i < 12; i++) cells.push(new Cell(i % 4 === 0 ? i : i % 4 === 1 ? i / 8 : i % 4 === 2 ? "s" + i : { i }));
  return cells.map(cell => cell.value);
});
//// numeric-keys-and-their-string-forms.ts
////= lines-27	Pair	0	string	1	string

////= lines-27	Quoted	"0"	string	"1"	string

interface Mixed {
  b: number;
  2: number;
  a: number;
  1: number;
  "-1": number;
  "01": number;
  1.5: number;
}

function both(p: Pair): string {
  return p[0] + p[1];
}

function bothQuoted(q: Quoted): string {
  return q["0"] + q["1"];
}

////= listing-2	o	object	walked

const numbers: Pair = { 0: "a", 1: "b" };
const strings: Pair = { "1": "d", "0": "c" };
const quoted: Quoted = numbers;
const unquoted: Pair = quoted;
const tuple: Pair = ["e", "f"];
const longer: Pair = ["g", "h", "i"];
const computed: Pair = { [0]: "l", ["1"]: "m" };
const padded = { z: 0, 1: "o", y: 0, 0: "n" };

const pairs: [string, Pair][] = [
  ["number keys", numbers],
  ["string keys, other order", strings],
  ["through the quoted type", unquoted],
  ["an array", tuple],
  ["a longer array", longer],
  ["computed keys", computed],
  ["with named extras", padded],
];

for (const [label, p] of pairs) {
  console.log(label + ": " + both(p) + " " + bothQuoted(p) + " " + typeof p + " " + Array.isArray(p));
  console.log(label + ", has: " + Object.hasOwn(p, 0) + " " + Object.hasOwn(p, "0") + " " + Object.hasOwn(p, "1"));
  console.log(label + ", listing: " + listing(p));
}

const mixed: Mixed = { b: 1, 2: 2, a: 3, 1: 4, "-1": 5, "01": 6, 1.5: 7 };
console.log("index keys come first, in number order: " + listing(mixed));
console.log("reads: " + [mixed.b, mixed[2], mixed["2"], mixed.a, mixed[1], mixed["-1"], mixed["01"], mixed[1.5], mixed["1.5"]].join());

const sameMembers: Mixed = { 1.5: 70, "01": 60, "-1": 50, 1: 40, a: 30, 2: 20, b: 10 };
console.log("written backwards: " + listing(sameMembers));

function store(p: Pair, value: string): string {
  p[0] = value;
  p["1"] = value + value;
  return both(p);
}

////= attempt-7

for (const [label, p] of pairs) attempt(label + ", stored", () => store(p, "x") + " " + JSON.stringify(p));

interface Big {
  4294967294: string;
  4294967295: string;
  4294967296: string;
  first: string;
}
const big: Big = { first: "f", 4294967296: "c", 4294967295: "b", 4294967294: "a" };
console.log("around the largest index: " + listing(big) + " " + big[4294967294] + big[4294967295] + big[4294967296]);

let length = 0;
for (let i = 0; i < 2000; i++) length += both(numbers).length;
console.log("2000 honest: " + length);
console.log("then: " + pairs.map(row => both(row[1])).join());

const index: number = pairs.length - 7;
const key: string = String(index);
const record: Record<number, string> = { ...numbers };
const byString: Record<string, string> = { ...numbers };
console.log("by a number and by its text: " + record[index] + " " + byString[key] + " " + byString[index]);

export {};
