function Tagged(Base: new () => object): new () => { tag: string } {
  return class extends Base {
    tag = "over " + Base.name;
  };
}

function make(Kind: new () => { tag: string }): { tag: string } {
  return new Kind();
}

const A = Tagged(Point);
const B = Tagged(Name);
