//// one-generic-copy-function-over-many-classes.ts
////= show-30

////= Point-4

class Person {
  name = "Ada";
  age = 36.5;
  greet(): string {
    return "hello " + this.name;
  }
}

class Basket {
  items: string[] = ["apple"];
  #weight = 3;
  add(item: string): number {
    return this.items.push(item);
  }
  weight(): number {
    return this.#weight;
  }
}

class Timer {
  ticks = 0;
  tick = (): number => ++this.ticks;
}

function withPrototype<T extends object>(value: T): T {
  return Object.assign(Object.create(Object.getPrototypeOf(value)), value);
}

function flat<T extends object>(value: T): T {
  return Object.assign({}, value);
}

function deep<T>(value: T): T {
  return structuredClone(value);
}

function text<T>(value: T): T {
  return JSON.parse(JSON.stringify(value));
}

function wrapped<T extends object>(value: T): T {
  return new Proxy(value, {});
}

////= same-2

const copiers: [string, <T extends object>(value: T) => T][] = [
  ["the same object", same],
  ["a copy with the prototype", withPrototype],
  ["a flat copy", flat],
  ["a deep copy", deep],
  ["a copy through text", text],
  ["a proxy", wrapped],
];

let warm = 0;
for (let i = 0; i < 2000; i++) warm += same(new Point()).sum() + same(new Person()).greet().length + same(new Basket()).add("pear") + same(new Basket()).weight() + same(new Timer()).tick();
console.log("after 2000 honest uses", warm);

for (const [name, copy] of copiers) {
  attempt(name + ": a point's fields", () => copy(new Point()).x + copy(new Point()).y);
  attempt(name + ": a point's method", () => copy(new Point()).sum());
  attempt(name + ": a person's fields", () => [copy(new Person()).name.length, copy(new Person()).age * 2]);
  attempt(name + ": a person's method", () => copy(new Person()).greet());
  attempt(name + ": a basket's list is shared", () => {
    const source = new Basket();
    const made = copy(source);
    made.items.push("pear");
    return [source.items.length, made.items === source.items];
  });
  attempt(name + ": a basket's method", () => copy(new Basket()).add("pear"));
  attempt(name + ": a basket's private name", () => copy(new Basket()).weight());
  attempt(name + ": a timer's arrow function", () => {
    const source = new Timer();
    const made = copy(source);
    return [made.tick(), made.tick(), made.ticks, source.ticks];
  });
  attempt(name + ": classes", () => [copy(new Point()) instanceof Point, copy(new Person()) instanceof Person, copy(new Basket()) instanceof Basket]);
  attempt(name + ": keys", () => [Object.keys(copy(new Point())), Object.keys(copy(new Person())), Object.keys(copy(new Basket()))]);
  attempt(name + ": an array", () => {
    const made = copy([1, 2, 3]);
    return [Array.isArray(made), made.length, made[1], typeof made.push];
  });
  attempt(name + ": a map", () => copy(new Map([["a", 1]])).get("a"));
}
//// one-generic-factory-constructs-many-classes.ts
////= text-12

////= lines-29	Small	a	number	1
class Large {
  a: string = "one";
  b: number = 2;
  c: number[] = [3];
  d: Small = new Small();
}
class Counting {
  static made: number = 0;
  id: number = ++Counting.made;
}
class Private {
  #secret: number = 5;
  reveal(): number {
    return this.#secret;
  }
}
abstract class Shape {
  abstract area(): number;
  describe(): string {
    return this.constructor.name + " " + this.area();
  }
}
class Square extends Shape {
  side: number = 2;
  area(): number {
    return this.side * this.side;
  }
}
class Circle extends Shape {
  radius: number = 1;
  area(): number {
    return 3 * this.radius;
  }
}

function build<T>(C: new () => T): T {
  return new C();
}
function buildMany<T>(C: new () => T, count: number): T[] {
  const list: T[] = [];
  for (let i = 0; i < count; i++) list.push(new C());
  return list;
}
function nameOf(C: abstract new () => Shape): string {
  return C.name + " " + C.length + " " + typeof C.prototype.describe;
}
function buildWith<A extends unknown[], T>(C: new (...args: A) => T, ...args: A): T {
  return new C(...args);
}

show("small", () => build(Small));
show("large", () => build(Large));
show("large b + 1", () => build(Large).b + 1);
show("small a + 1", () => build(Small).a + 1);
show("large a + 1", () => build(Large).a + 1);
show("counting", () => build(Counting).id);
show("counting again", () => build(Counting).id);
show("private", () => build(Private).reveal());
show("square", () => build(Square).describe());
show("circle", () => build(Circle).describe());
show("Date is a date", () => build(Date) instanceof Date);
show("Map", () => build(Map).size);
show("Array", () => build(Array).length);
show("Object", () => Object.keys(build(Object)).length);
show("Error", () => build(Error).message);
show("a set of numbers", () => build(Set<number>).add(1).size);
show("an anonymous class", () => build(class { z = 26; }).z);
show("abstract name", () => nameOf(Shape));
show("concrete name", () => nameOf(Square));
show("many", () => buildMany(Counting, 3).map(c => c.id).join());
show("with arguments: Map", () => buildWith(Map<string, number>, [["a", 1]]).get("a"));
show("with arguments: Array", () => buildWith(Array<number>, 3).length);
show("with arguments: Date", () => buildWith(Date, 0).getTime());

const shapes: (new () => Shape)[] = [Square, Circle, Square];
show("from an array of classes", () => shapes.map(C => new C().describe()).join());

let sum = 0;
for (let i = 0; i < 2000; i++) sum += build(Small).a;
show("2000 small ones", () => sum);
show("then a large one", () => build(Large).a);
show("then a small one", () => build(Small).a);
//// one-generic-setter-has-honest-callers-and-one-caller-with-a-union-key.ts
////= show-32

class Account {
  balance = 100;
  rate = 0.25;
  owner = "ann";
  interest(): number {
    return this.balance * this.rate;
  }
  title(): string {
    return this.owner.toUpperCase();
  }
}

////= set

function describe(a: Account): string {
  return typeof a.balance + " " + show(a.balance) + ", " + typeof a.rate + " " + show(a.rate) + ", " + typeof a.owner + " " + show(a.owner) + ", " + JSON.stringify(a);
}

function deposit(a: Account, amount: number): void {
  set(a, "balance", a.balance + amount);
}

function newRate(a: Account, rate: number): void {
  set(a, "rate", rate);
}

function newOwner(a: Account, owner: string): void {
  set(a, "owner", owner);
}

function fromAForm(a: Account, field: "balance" | "rate" | "owner", text: string): void {
  set(a, field, text);
}

function report(title: string, a: Account): void {
  console.log(title + ": " + describe(a));
  attempt("  interest", () => a.interest());
  attempt("  title", () => a.title());
  attempt("  balance + 1", () => a.balance + 1);
}

const honest = new Account();
const odd = new Account();
let total = 0;
for (let i = 0; i < 2000; i++) {
  deposit(honest, 1);
  newRate(honest, i / 4000);
  newOwner(honest, "o" + (i % 10));
  total += honest.interest() + honest.title().length;
}
console.log("2000 honest rounds: " + total);
report("the honest account", honest);
fromAForm(odd, "owner", "bob");
report("the form sets the owner", odd);
fromAForm(odd, "balance", "250");
report("the form sets the balance", odd);
deposit(odd, 1);
report("a deposit on top of it", odd);
fromAForm(odd, "rate", "0.5");
report("the form sets the rate", odd);
newRate(odd, 0.5);
set(odd, "balance", 10);
report("honest again", odd);
deposit(honest, 1);
report("the honest account once more", honest);

export {};
//// one-mixin-member-has-another-kind-of-value-over-each-base.ts
////= describe

class WithNumber {
  value: number | string | number[] = 7;
}

class WithText {
  value: number | string | number[] = "seven";
}

class WithList {
  value: number | string | number[] = [7, 7];
}

function Measured(Base: new () => { value: number | string | number[] }) {
  return class extends Base {
    size(): number {
      const v = this.value;
      return typeof v === "number" ? v : v.length;
    }
    kind(): string {
      return typeof this.value;
    }
    doubled(): string {
      const v = this.value;
      return typeof v === "number" ? String(v * 2) : typeof v === "string" ? v + v : v.concat(v).join("");
    }
  };
}

const kinds = [WithNumber, WithText, WithList];
for (let round = 0; round < 2; round++) {
  for (const Base of kinds) {
    const made = new (Measured(Base))();
    console.log(Base.name + ": " + made.size() + " " + made.kind() + " " + made.doubled() + " " + describe(made));
  }
}
const One = Measured(WithNumber);
let warm = 0;
for (let i = 0; i < 2000; i++) warm += new One().size();
console.log("2000 rounds over numbers: " + warm);
const changed = new One();
changed.value = "now a text";
console.log("one instance changes its kind: " + changed.size() + " " + changed.kind() + " " + changed.doubled());
//// one-mixin-method-reads-a-member-that-each-base-keeps-in-another-place.ts
////= describe

////= lines-28	HasX	x	number

////= lines-14	class	First	implements	HasX	x	1

class Third implements HasX {
  a = "a";
  b = "b";
  x = 3;
}

class Last implements HasX {
  a = 0.5;
  b = [1];
  c = { n: 1 };
  d = "d";
  e = true;
  x = 6;
}

class Computed implements HasX {
  hidden = 20;
  get x(): number {
    return this.hidden + 1;
  }
  set x(value: number) {
    this.hidden = value;
  }
}

////= lines-14	class	Inherited	extends	Third	own	"own"

////= lines-14	class	Fraction	implements	HasX	x	0.5

function Reader(Base: new () => HasX) {
  return class extends Base {
    mine = "mine";
    read(): number {
      return this.x + 1;
    }
    write(value: number): number {
      this.x = value;
      return this.x;
    }
    bump(): number {
      return ++this.x;
    }
  };
}

const bases: (new () => HasX)[] = [First, Third, Last, Computed, Inherited, Fraction];
for (const Base of bases) {
  const made = new (Reader(Base))();
  console.log(Base.name + ": read " + made.read() + " write " + made.write(50) + " bump " + made.bump() + " " + describe(made));
}
const OverFirst = Reader(First);
let warm = 0;
for (let i = 0; i < 2000; i++) warm += new OverFirst().read();
console.log("2000 honest rounds over the first base: " + warm);
for (const Base of bases) console.log(Base.name + " again: " + new (Reader(Base))().read());
