//// one-primitive-among-4000-objects-in-a-loop.ts
////= show-30

type HasLength = { length: number };
type Fixable = { toFixed(digits: number): string };

////= lines-93	total	items	HasLength	sum	length

function totalWithALocal(items: HasLength[]): number {
  let sum = 0;
  let current: HasLength = { length: 0 };
  for (let i = 0; i < items.length; i++) {
    current = items[i];
    sum += current.length;
  }
  return sum + current.length;
}

function kindsSeen(items: HasLength[]): string {
  const counts = new Map<string, number>();
  for (const item of items) counts.set(typeof item, (counts.get(typeof item) ?? 0) + 1);
  return [...counts].map(([kind, count]) => kind + "=" + count).join();
}

function lastDigits(items: Fixable[]): string {
  let text = "";
  for (let i = 0; i < items.length; i++) {
    const fixed = items[i].toFixed(1);
    if (i % 1000 === 500) text += fixed + ";";
  }
  return text;
}

function build(at: number, visitor: HasLength): HasLength[] {
  const items: HasLength[] = [];
  for (let i = 0; i < 4000; i++) items.push(i === at ? visitor : { length: 1 });
  return items;
}

const visitors: [string, HasLength][] = [
  ["nothing unusual", { length: 1 }],
  ["a string", "hello world"],
  ["an empty string", ""],
  ["an array", [1, 2, 3]],
  ["a function", total],
  ["a typed array", new Uint32Array(7)],
];

for (const [name, visitor] of visitors) {
  for (const at of [0, 1500, 3999]) {
    attempt(name + " at " + at + ": total", () => total(build(at, visitor)));
    attempt(name + " at " + at + ": through a local", () => totalWithALocal(build(at, visitor)));
    attempt(name + " at " + at + ": kinds", () => kindsSeen(build(at, visitor)));
  }
}

attempt("a number among objects with toFixed", () => {
  const items: Fixable[] = [];
  for (let i = 0; i < 4000; i++) items.push(i === 1500 || i === 2500 ? i / 4 : { toFixed: digits => "o" + digits });
  return lastDigits(items);
});
attempt("an object among numbers", () => {
  const items: Fixable[] = [];
  for (let i = 0; i < 4000; i++) items.push(i === 1500 ? { toFixed: digits => "o" + digits } : i / 4);
  return lastDigits(items);
});
attempt("stored in the middle of the loop", () => {
  const items = build(-1, "");
  let sum = 0;
  for (let i = 0; i < items.length; i++) {
    if (i === 2000) items[2001] = "a string of 17 ch";
    sum += items[i].length;
  }
  return sum;
});
//// one-reader-has-callers-with-plain-members-and-callers-with-accessors.ts
////= lines-27	Item	price	number	count	number

const log: string[] = [];

////= lines-151	cost	item	Item	item.price	item.count

function restock(item: Item, by: number): number {
  item.count += by;
  return item.count;
}

////= flush

function plainCallerOne(): number {
  return cost({ price: 2, count: 3 });
}

function plainCallerTwo(): number {
  const item: Item = { price: 4, count: 5 };
  restock(item, 1);
  return cost(item);
}

function plainMany(): number {
  const item: Item = { price: 1, count: 0 };
  let total = 0;
  for (let i = 0; i < 2000; i++) total += cost(item) + restock(item, 1);
  return total;
}

function watched(): Item {
  let count = 7;
  return {
    get price() {
      log.push("get price");
      return 6;
    },
    get count() {
      log.push("get count");
      return count;
    },
    set count(value: number) {
      log.push("set count " + value);
      count = value;
    },
  };
}

class Stock {
  #count = 9;
  get price(): number {
    log.push("Stock price");
    return 8;
  }
  get count(): number {
    log.push("Stock get count");
    return this.#count;
  }
  set count(value: number) {
    log.push("Stock set count " + value);
    this.#count = value;
  }
}

function accessorCaller(): number {
  return cost(watched());
}

function classCaller(): number {
  const stock = new Stock();
  restock(stock, 1);
  return cost(stock);
}

function inheritedCaller(): number {
  const item: Item = Object.create(watched());
  restock(item, 1);
  return cost(item);
}

const tools = { cost, restock };
const which: keyof typeof tools = "cost";

flush("accessors first of all", accessorCaller());
flush("plain, one", plainCallerOne());
flush("plain, two", plainCallerTwo());
flush("plain, 2000 times", plainMany());
flush("own accessors", accessorCaller());
flush("accessors of a class", classCaller());
flush("accessors on the prototype", inheritedCaller());
flush("plain again", plainCallerOne());
flush("call", cost.call(undefined, watched()));
flush("apply", cost.apply(undefined, [new Stock()]));
flush("bind", restock.bind(undefined, watched(), 2)());
flush("Reflect.apply", Reflect.apply(restock, undefined, [new Stock(), 3]));
flush("by a computed name", tools[which](watched()));
flush("a built-in calls it", [{ price: 1, count: 1 }, watched(), new Stock()].map(cost).join());
flush("a comparator", [watched(), { price: 1, count: 1 }].toSorted((a, b) => cost(a) - cost(b)).length);
flush("a reducer", [watched(), new Stock()].reduce((sum, item) => sum + cost(item), 0));
flush("a promise reaction", await Promise.resolve(watched()).then(cost));
flush("plain at the end", plainCallerTwo());

