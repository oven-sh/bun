function Moved(Base: new () => Point) {
  return class extends Base {
    x = 100;
    sum(): number {
      return -super.sum();
    }
  };
}

function total(p: Point): number {
  return p.x + p.y + p.sum();
}

const kinds: (new () => Point)[] = [Point, Tagged(Point), Moved(Point), Moved(Tagged(Point)), Tagged(Moved(Point))];
for (const Kind of kinds) console.log(total(new Kind()) + " " + describe(new Kind()));
let warm = 0;
for (let i = 0; i < 2000; i++) warm += total(new Point());
console.log("2000 honest rounds: " + warm);
for (const Kind of kinds) console.log("again " + total(new Kind()));
//// only-a-proxy-calls-the-traps-of-a-handler-class.ts
const log: string[] = [];

class Handler implements ProxyHandler<{ x: number }> {
  get(target: { x: number }, key: string | symbol, receiver: unknown): unknown {
    log.push("get " + String(key));
    return Reflect.get(target, key, receiver);
  }
  has(target: { x: number }, key: string | symbol): boolean {
    log.push("has " + String(key));
    return Reflect.has(target, key);
  }
  set(target: { x: number }, key: string | symbol, value: unknown, receiver: unknown): boolean {
    log.push("set " + String(key));
    return Reflect.set(target, key, value, receiver);
  }
  ownKeys(target: { x: number }): (string | symbol)[] {
    log.push("ownKeys");
    return Reflect.ownKeys(target);
  }
}

const p = new Proxy({ x: 1 }, new Handler());
p.x = 2;
console.log(p.x + " " + ("x" in p) + " " + Object.keys(p).join() + " [" + log.join(", ") + "]");

