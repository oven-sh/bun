////= text-12

class Person {
  first: string = "ann";
  greet(): string {
    return "hi " + this.first;
  }
}

const early: string[] = [];

////= Base-2

class Form extends Base {
  owner: Person = new Person();
  title: string = "form";
  fields: string[] = ["a", "b"];
  submit: () => number = () => 1;
  width: number = 10;
  init(): void {
    early.push("owner?.first " + this.owner?.first);
    early.push("owner?.greet() " + this.owner?.greet());
    early.push("title?.length " + this.title?.length);
    early.push("title?.toUpperCase() " + this.title?.toUpperCase());
    early.push("fields?.length " + this.fields?.length);
    early.push("fields?.[0] " + this.fields?.[0]);
    early.push("fields?.map " + this.fields?.map(f => f + f));
    early.push("submit?.() " + this.submit?.());
    early.push("width?.toFixed " + this.width?.toFixed(1));
    early.push("owner ?? " + (this.owner ?? "nobody"));
    early.push("width ?? " + (this.width ?? -1));
    early.push("title ?? " + (this.title ?? "untitled"));
    early.push("owner === undefined " + (this.owner === undefined));
    early.push("owner == null " + (this.owner == null));
    early.push("!owner " + !this.owner);
    early.push("owner && " + (this.owner && this.owner.first));
    early.push("typeof owner " + typeof this.owner);
    early.push("width === undefined " + (this.width === undefined));
    early.push("width !== undefined ? " + (this.width !== undefined ? this.width + 1 : "no width"));
    early.push("isNaN " + Number.isNaN(this.width));
  }
  fill(): void {
    this.width ??= 20;
    this.title ||= "filled";
  }
}

const form = new Form();
for (const entry of early) console.log("early " + entry);
early.length = 0;
form.init();
for (const entry of early) console.log("late " + entry);

class Slot {
  declare value: number;
  declare label: string;
  declare next: Slot;
  fill(): void {
    this.value ??= 20;
    this.label ||= "filled";
  }
  depth(): number {
    return this.next?.depth() + 1;
  }
  depthOrZero(): number {
    return (this.next?.depthOrZero() ?? 0) + 1;
  }
}
const slot = new Slot();
show("value before", () => slot.value);
slot.fill();
show("value after ??=", () => slot.value);
show("label after ||=", () => slot.label);
slot.fill();
show("value after another", () => slot.value);
show("depth", () => slot.depth());
show("depthOrZero", () => slot.depthOrZero());
slot.next = new Slot();
slot.next.next = new Slot();
show("depthOrZero of three", () => slot.depthOrZero());

const list: Person[] = [new Person()];
show("past the end ?.", () => list[3]?.first);
show("past the end ?.()", () => list[3]?.greet());
show("past the end", () => list[3].first);
const table: Record<string, Person> = { a: new Person() };
show("no such key ?.", () => table["b"]?.first);
show("no such key", () => table["b"].first);
//// optional-default-and-rest-parameters-meet-every-way-of-passing-nothing.ts
////= text-4

type Taker = (a?: number) => string;

function optional(a?: number): string {
  return arguments.length + " arguments, a is " + text(a);
}

function defaulted(a: number = 7): string {
  return arguments.length + " arguments, a is " + text(a) + ", a + 1 is " + text(a + 1);
}

function rest(...a: (number | undefined)[]): string {
  return arguments.length + " arguments, " + a.length + " collected, 0 in it " + (0 in a) + ", first " + text(a[0]);
}

function optionalThenRest(a?: number, ...others: number[]): string {
  return arguments.length + " arguments, a is " + text(a) + ", others " + text(others);
}

function defaultThenDefault(a: number = 1, b: number = a + 1): string {
  return arguments.length + " arguments, a is " + text(a) + ", b is " + text(b);
}

function destructured(...[a = 9]: [number?]): string {
  return arguments.length + " arguments, a is " + text(a);
}

const arrowOptional: Taker = a => "a is " + text(a);
const arrowDefaulted: Taker = (a = 7) => "a is " + text(a);
const arrowRest: Taker = (...a) => a.length + " collected, first " + text(a[0]);

class Host {
  base = 100;
  method(a?: number): string {
    return arguments.length + " arguments, a is " + text(a);
  }
  withDefault(a: number = this.base): string {
    return arguments.length + " arguments, a is " + text(a);
  }
}
const host = new Host();

const takers: [string, Taker][] = [
  ["optional", optional],
  ["defaulted", defaulted],
  ["rest", rest],
  ["optional then rest", optionalThenRest],
  ["two defaults", defaultThenDefault],
  ["a destructured rest", destructured],
  ["an arrow, optional", arrowOptional],
  ["an arrow, defaulted", arrowDefaulted],
  ["an arrow, rest", arrowRest],
  ["a method", a => (a === undefined ? host.method() : host.method(a))],
  ["a bound method", host.method.bind(host)],
  ["a bound method with a default", host.withDefault.bind(host)],
];

const empty: [] = [];
const one: [number] = [1];
const maybeNone: [number?] = [];
const maybeUndefined: [number?] = [undefined];
const hole: [number?] = [,];

const calls: [string, (f: Taker) => string][] = [
  ["f()", f => f()],
  ["f(undefined)", f => f(undefined)],
  ["f(void 0)", f => f(void 0)],
  ["f(...[])", f => f(...[])],
  ["f(...[undefined])", f => f(...[undefined])],
  ["f(...empty)", f => f(...empty)],
  ["f(...one)", f => f(...one)],
  ["f(...maybeNone)", f => f(...maybeNone)],
  ["f(...maybeUndefined)", f => f(...maybeUndefined)],
  ["f(...hole)", f => f(...hole)],
  ["f(0)", f => f(0)],
  ["f(-0)", f => f(-0)],
  ["f(NaN)", f => f(NaN)],
  ["f.call(null)", f => f.call(null)],
  ["f.call(null, undefined)", f => f.call(null, undefined)],
  ["f.apply(null)", f => f.apply(null)],
  ["f.apply(null, [])", f => f.apply(null, [])],
  ["f.apply(null, [undefined])", f => f.apply(null, [undefined])],
  ["f.bind(null)()", f => f.bind(null)()],
  ["f.bind(null, undefined)()", f => f.bind(null, undefined)()],
  ["Reflect.apply(f, null, [])", f => Reflect.apply(f, null, [])],
];

for (const [name, f] of takers) for (const [form, call] of calls) console.log(name + ", " + form + ": " + call(f));

console.log("direct: " + optional() + " | " + optional(undefined) + " | " + optional(...[]) + " | " + optional(...one));
console.log("direct: " + defaulted() + " | " + defaulted(undefined) + " | " + defaulted(...[]) + " | " + defaulted(...one));
console.log("direct: " + rest() + " | " + rest(undefined) + " | " + rest(...[]) + " | " + rest(...one));
//// optional-fields-of-a-class.ts
class Profile {
  name = "profile";
  nickname?: string;
  age?: number = undefined;
  city?: string = "here";
}

class Ordered {
  b: number;
  a: number;
  c?: number;
  constructor(flip: boolean) {
    if (flip) {
      this.a = 1;
      this.b = 2;
    } else {
      this.b = 2;
      this.a = 1;
    }
  }
}

class WithParameter {
  constructor(
    public id: number,
    public alias?: string,
  ) {}
}

class Child extends Profile {
  nickname?: string = undefined;
  extra?: boolean;
}

function listing(o: object): string {
  return Object.keys(o).join() + " " + JSON.stringify(o) + " copy " + Object.keys({ ...o }).join();
}

////= lines-183	nickname	p	Profile	string	p.nickname	"none"

function hasNickname(p: Profile): boolean {
  return "nickname" in p;
}

const p = new Profile();
console.log("a fresh profile: " + listing(p));
console.log("nickname: " + hasNickname(p) + " " + Object.hasOwn(p, "nickname") + " " + nickname(p));
console.log("age: " + ("age" in p) + " " + p.age + ", city: " + ("city" in p) + " " + p.city);

p.nickname = "nick";
console.log("stored: " + listing(p) + " " + nickname(p));
delete p.nickname;
console.log("deleted: " + listing(p) + " " + hasNickname(p) + " " + nickname(p));
p.nickname = "back";
console.log("stored again: " + listing(p));
delete p.city;
delete p.age;
console.log("two more deleted: " + listing(p));

console.log("assigned b then a: " + listing(new Ordered(false)));
console.log("assigned a then b: " + listing(new Ordered(true)));

console.log("parameter properties, one given: " + listing(new WithParameter(1)) + " " + ("alias" in new WithParameter(1)));
console.log("parameter properties, both given: " + listing(new WithParameter(1, "a")));
console.log("parameter properties, undefined given: " + listing(new WithParameter(1, undefined)));

const child = new Child();
console.log("a subclass that declares it again: " + listing(child));
child.nickname = "kid";
console.log("stored: " + listing(child) + " " + nickname(child));

const literal: Profile = { name: "literal" };
const full: Profile = { city: "there", age: 3, nickname: "full", name: "full" };
console.log("a literal without them: " + listing(literal) + " " + hasNickname(literal) + " " + nickname(literal));
console.log("a literal with all, backwards: " + listing(full) + " " + hasNickname(full) + " " + nickname(full));

let count = 0;
