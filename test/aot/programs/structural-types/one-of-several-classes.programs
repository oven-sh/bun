//// optional-methods-absent-undefined-own-and-inherited.ts
interface Plugin {
  name: string;
  setup?(): string;
  teardown?: () => string;
}

const log: string[] = [];

////= attempt-15

function run(p: Plugin): string {
  return (p.setup?.() ?? "no setup") + " / " + (p.teardown?.() ?? "no teardown");
}

function guarded(p: Plugin): string {
  if (p.setup) return p.setup();
  return "skipped";
}

function byTypeof(p: Plugin): string {
  return typeof p.setup === "function" ? p.setup() : typeof p.setup;
}

function byIn(p: Plugin): string {
  return ("setup" in p) + " " + Object.hasOwn(p, "setup") + " " + Object.keys(p).join();
}

////= lines-35	Base	name	"class"	setup	"setup of "

class WithField {
  name = "field";
  setup?: () => string;
  teardown = (): string => "teardown of " + this.name;
}

class Watching {
  name = "watching";
  get setup(): (() => string) | undefined {
    log.push("get setup");
    return log.length % 2 === 1 ? () => "from the getter" : undefined;
  }
}

const table: [string, Plugin][] = [
  ["absent", { name: "absent" }],
  ["undefined", { name: "undefined", setup: undefined, teardown: undefined }],
  ["own methods", { name: "own", setup() { return "setup of " + this.name; }, teardown: () => "arrow" }],
  ["a method of a class", new Base()],
  ["a declared field never set", new WithField()],
  ["inherited through Object.create", Object.assign(Object.create({ setup: () => "inherited" }), { name: "created" })],
  ["a getter that answers every other time", new Watching()],
];

for (const [label, p] of table) {
  attempt(label + ", optional call", () => run(p));
  attempt(label + ", truthiness", () => guarded(p));
  attempt(label + ", typeof", () => byTypeof(p));
  attempt(label + ", in", () => byIn(p));
}

const honest: Plugin = { name: "honest", setup: () => "ready" };
let length = 0;
for (let i = 0; i < 2000; i++) length += run(honest).length + guarded(honest).length;
console.log("2000 that have it: " + length);
for (const [label, p] of table) attempt("then " + label, () => run(p) + " | " + guarded(p));

const changing: Plugin = { name: "changing" };
const seen: string[] = [];
for (let i = 0; i < 6; i++) {
  seen.push(guarded(changing));
  if (i === 1) changing.setup = () => "added";
  if (i === 3) delete changing.setup;
}
console.log("added and deleted in a loop: " + seen.join());

const plugins: Plugin[] = table.map(row => row[1]);
attempt("all of them", () => plugins.map(p => p.setup?.() ?? "-").join());

const instance = new Base();
const asPlugin: Plugin = instance;
delete asPlugin.setup;
attempt("deleting a method that lives on the prototype", () => run(asPlugin) + " " + instance.setup());
asPlugin.setup = undefined;
attempt("undefined stored over a method of a class", () => run(asPlugin));
attempt("and the class's own type still says it is there", () => instance.setup());

export {};
//// optional-methods-are-called-when-they-are-there.ts
////= Person-5

interface Hooks {
  before?(a: Animal): string;
  after?: (a: Animal) => string;
  count?: number;
  each?(a: Animal, index: number): number;
}

class NoHooks implements Hooks {}

class DogHooks implements Hooks {
  before(d: Dog): string {
    return "before " + d.tag + " " + d.legs;
  }
  after = (a: Animal): string => "after " + a.name;
  count = 2;
  each(d: Dog, index: number): number {
    return d.legs * index;
  }
}

class OnlyUndefined implements Hooks {
  before = undefined;
  after = undefined;
  count = undefined;
}

const literal: Hooks = {
  before(d: Dog) {
    return "literal " + d.bark();
  },
};

function run(hooks: Hooks, a: Animal): string {
  return [hooks.before?.(a), hooks.after?.(a), hooks.count, hooks.each?.(a, 3)].map(v => typeof v + ":" + v).join(" | ");
}
function has(hooks: Hooks): string {
  return ["before" in hooks, "after" in hooks, "count" in hooks, "each" in hooks].join() + " keys " + Object.keys(hooks).join("+");
}
function guarded(hooks: Hooks, a: Animal): string {
  if (hooks.before) return hooks.before(a);
  if (hooks.after !== undefined) return hooks.after(a);
  return "no hook";
}
function countPlusOne(hooks: Hooks): number {
  return (hooks.count ?? 0) + 1;
}

const all: [string, Hooks][] = [
  ["none", new NoHooks()],
  ["dog hooks", new DogHooks()],
  ["only undefined", new OnlyUndefined()],
  ["literal", literal],
  ["empty literal", {}],
];
const animals: Animal[] = [new Dog("rex"), new Cat("tom"), new Spider("boris")];

for (const [label, hooks] of all) {
  show(label + " has", () => has(hooks));
  show(label + " count + 1", () => countPlusOne(hooks));
  for (const animal of animals) {
    show(label + " run " + animal.constructor.name, () => run(hooks, animal));
    show(label + " guarded " + animal.constructor.name, () => guarded(hooks, animal));
  }
}

const late: Hooks = {};
show("before it is added", () => run(late, animals[0]));
late.before = (a: Animal) => "added " + a.name;
show("after it is added", () => run(late, animals[0]));
delete late.before;
show("after it is deleted", () => run(late, animals[0]));
late.before = undefined;
show("set to undefined", () => run(late, animals[0]) + " " + has(late));

let calls = 0;
const counting: Hooks = {
  get before() {
    calls++;
    return calls % 2 === 1 ? (a: Animal) => "odd " + a.name : undefined;
  },
};
show("a getter that changes its mind: optional call", () => counting.before?.(animals[0]));
show("a getter that changes its mind: optional call", () => counting.before?.(animals[0]));
show("a getter that changes its mind: test, then call", () => guarded(counting, animals[0]));
show("reads", () => calls);
