}

export class Store {
  #items = new Map();
  set(key, value) {
    this.#items.set(String(key), String(value));
    return undefined;
  }
  get(key) {
    return this.#items.get(String(key));
  }
  get size() {
    return String(this.#items.size);
  }
}
