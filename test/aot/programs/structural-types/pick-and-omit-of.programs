////= lines-156	tagAt	dogs	Dog	string	tag

////= lines-156	nameAt	dogs	Dog	string	name

function barkAt(dogs: Dog[], index: number): string {
  return dogs[index].bark();
}

function kindAt(dogs: Dog[], index: number): string {
  return typeof dogs[index];
}

function isDogAt(dogs: Dog[], index: number): boolean {
  return dogs[index] instanceof Dog;
}

function truthyAt(dogs: Dog[], index: number): boolean {
  return dogs[index] ? true : false;
}

function storeLegs(dogs: Dog[], index: number): number {
  dogs[index].legs = 3;
  return dogs[index].legs;
}

////= totalLegs

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = [new Dog("a"), new Dog("b")];
  warm += legsAt(honest, 1) + legsPlusOne(honest, 1) + tagAt(honest, 1).length + nameAt(honest, 1).length + barkAt(honest, 1).length + kindAt(honest, 1).length;
  warm += (isDogAt(honest, 1) ? 1 : 0) + (truthyAt(honest, 1) ? 1 : 0) + storeLegs(honest, 1) + totalLegs(honest);
}
console.log("after 2000 honest kennels", warm);

const visitors: [string, unknown][] = [
  ["5", 5],
  ["0", 0],
  ["2.5", 2.5],
  ["NaN", NaN],
  ["a string", "text"],
  ["an empty string", ""],
  ["true", true],
  ["false", false],
  ["null", null],
  ["undefined", undefined],
  ["a symbol", Symbol("s")],
  ["a bigint", 5n],
  ["a function", legsAt],
  ["an array", [1]],
  ["an empty object", {}],
];
for (const [name, visitor] of visitors) {
  const make = (): Dog[] => {
    const dogs = [new Dog("rex")];
    const things: unknown[] = dogs;
    things.push(visitor);
    return dogs;
  };
  attempt(name + ": typeof", () => kindAt(make(), 1));
  attempt(name + ": legs", () => legsAt(make(), 1));
  attempt(name + ": legs + 1", () => legsPlusOne(make(), 1));
  attempt(name + ": tag", () => tagAt(make(), 1));
  attempt(name + ": name", () => nameAt(make(), 1));
  attempt(name + ": bark", () => barkAt(make(), 1));
  attempt(name + ": instanceof Dog", () => isDogAt(make(), 1));
  attempt(name + ": truthy", () => truthyAt(make(), 1));
  attempt(name + ": a store to its legs", () => storeLegs(make(), 1));
  attempt(name + ": total legs", () => totalLegs(make()));
}
attempt("honest again", () => [legsAt([new Dog("a")], 0), barkAt([new Dog("a")], 0)]);
//// primitives-in-a-class-field-typed-as-a-length-holder.ts
////= show-30

type HasLength = { length: number };

class Shelf {
  item: HasLength;
  reads = 0;
  constructor(item: HasLength) {
    this.item = item;
  }
  size(): number {
    this.reads++;
    return this.item.length;
  }
  kind(): string {
    return typeof this.item;
  }
  swap(next: HasLength): HasLength {
    const old = this.item;
    this.item = next;
    return old;
  }
}

class StartsAsAString {
  before = 1.5;
  item: HasLength = "initial";
  after = 2.5;
}

class Hidden {
  #item: HasLength;
  constructor(item: HasLength) {
    this.#item = item;
  }
  size(): number {
    return this.#item.length;
  }
  kind(): string {
    return typeof this.#item;
  }
}

class ByParameter {
  constructor(public readonly item: HasLength, public weight: number) {}
}

class Registry {
  static latest: HasLength = { length: -1 };
  static size(): number {
    return Registry.latest.length;
  }
}

////= lines-32	sizeOfShelf	shelf	Shelf	number	shelf.item.length

////= values	"function"	sizeOfShelf	class", Shelf	"typed array"	Int16Array	9

let warm = 0;
const reused = new Shelf({ length: 0 });
for (let i = 0; i < 2000; i++) {
  const shelf = new Shelf({ length: i });
  warm += shelf.size() + sizeOfShelf(shelf);
  reused.swap({ length: i });
  warm += reused.size() + new Hidden({ length: i }).size() + new ByParameter({ length: i }, i).item.length;
}
console.log("after 2000 literals", warm);

for (const [name, value] of values) {
  attempt(name + ": a new shelf", () => {
    const shelf = new Shelf(value);
    return [shelf.kind(), shelf.size(), sizeOfShelf(shelf), shelf.reads, shelf.item === value];
  });
  attempt(name + ": swapped into an old shelf", () => {
    const old = reused.swap(value);
    return [typeof old, old.length, reused.kind(), reused.size(), sizeOfShelf(reused)];
  });
  attempt(name + ": a private field", () => {
    const hidden = new Hidden(value);
    return [hidden.kind(), hidden.size()];
  });
  attempt(name + ": a parameter property", () => {
    const made = new ByParameter(value, 0.5);
    return [typeof made.item, made.item.length, made.weight];
  });
  attempt(name + ": a static field", () => {
    Registry.latest = value;
    return [typeof Registry.latest, Registry.size()];
  });
  attempt(name + ": a member of a literal", () => {
    const box: { first: number; item: HasLength; last: number } = { first: 1, item: value, last: 2 };
    return [box.first, typeof box.item, box.item.length, box.last];
  });
}
attempt("a field that starts as a string", () => {
  const made = new StartsAsAString();
  const seen = [made.before, typeof made.item, made.item.length, made.after];
  made.item = { length: 77 };
  return [...seen, typeof made.item, made.item.length, made.before, made.after];
});
attempt("keys and JSON of a shelf that holds a string", () => [Object.keys(new Shelf("ab")), JSON.stringify(new Shelf("ab"))]);
//// primitives-satisfy-the-constraint-of-a-type-parameter.ts
////= show-4

const log: string[] = [];

////= attempt-2

function lengthOf<T extends { length: number }>(x: T): number {
  return x.length;
}

function longer<T extends { length: number }>(a: T, b: T): T {
  return a.length >= b.length ? a : b;
}

function textOf<T extends { toString(): string }>(x: T): string {
  return x.toString();
}

function valueOf<T extends { valueOf(): number }>(x: T): number {
  return x.valueOf() + 1;
}

function anything<T extends {}>(x: T): string {
  return typeof x;
}

function fixed<T extends { toFixed(digits: number): string }>(x: T): string {
  return x.toFixed(1);
}

function at<T extends { at(index: number): unknown }>(x: T): unknown {
  return x.at(-1);
}

function sliced<T extends { slice(start: number): T }>(x: T): T {
  return x.slice(1);
}

function kept<T extends { length: number }>(x: T): { held: T; size: number } {
  return { held: x, size: x.length };
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += lengthOf([i]) + longer([i], [i, 1]).length + textOf({ toString: () => "t" }).length + valueOf({ valueOf: () => i }) + fixed({ toFixed: () => "f" }).length;
console.log("2000 honest rounds with objects", warm);

attempt("length of a string", () => lengthOf("abc"));
attempt("length of an empty string", () => lengthOf(""));
attempt("length of an array", () => lengthOf([1, 2]));
attempt("length of a function", () => lengthOf((a: number, b: number) => a + b));
attempt("length of a class", () => lengthOf(class { constructor(a: number) {} }));
attempt("length of a typed array", () => lengthOf(new Uint8Array(3)));
attempt("length of a String object", () => lengthOf(new String("abcd")));
attempt("length of a literal", () => lengthOf({ length: -1 }));
attempt("length of a getter", () => lengthOf({ get length() { log.push("get-length"); return 7; } }));
attempt("length of arguments", () => (function (a: number, b: number) { return lengthOf(arguments); })(1, 2));
attempt("longer of two strings", () => longer("ab", "abc"));
attempt("longer of two arrays", () => longer([1, 2, 3], [4]));
attempt("longer of a string and an array", () => longer<string | number[]>("ab", [1, 2, 3]));
attempt("text of a number", () => textOf(5));
attempt("text of negative zero", () => textOf(-0));
attempt("text of a string", () => textOf("s"));
attempt("text of a boolean", () => textOf(true));
attempt("text of a bigint", () => textOf(5n));
attempt("text of a symbol", () => textOf(Symbol("s")));
attempt("text of an array", () => textOf([1, [2, 3]]));
attempt("text of a function", () => textOf(Math.max).length > 0);
attempt("text of a literal", () => textOf({}));
attempt("value of a number", () => valueOf(5));
attempt("value of a Number object", () => valueOf(new Number(5)));
attempt("value of a date", () => valueOf(new Date(5)));
attempt("anything", () => [anything(1), anything("s"), anything(true), anything(1n), anything(Symbol()), anything([]), anything(() => {}), anything({})]);
attempt("fixed of a number", () => fixed(1.25));
attempt("fixed of a Number object", () => fixed(new Number(2)));
attempt("at of a string and an array", () => [at("abc"), at([1, 2]), at(new Uint8Array([7, 8]))]);
attempt("sliced", () => [sliced<string>("abc"), sliced([1, 2, 3])]);
attempt("kept in a member", () => {
  const a = kept("abc");
