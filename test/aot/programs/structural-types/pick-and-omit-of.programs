//// reflect-apply-and-call-put-any-value-in-a-typed-parameter.ts
////= text-7

////= failure

class Dog {
  name: string = "rex";
  legs: number = 4;
  bark(): string {
    return this.name + " barks";
  }
}

function double(n: number): string {
  return "n " + text(n) + ", doubled " + text(n * 2) + ", plus one " + text(n + 1) + ", whole " + text(n | 0);
}

function shout(word: string): string {
  return "word " + text(word) + ", length " + text(word.length) + ", upper " + word.toUpperCase();
}

function walk(dog: Dog): string {
  return "dog " + text(dog) + ", legs " + text(dog.legs) + ", " + dog.bark();
}

function total(list: number[]): string {
  let sum = 0;
  for (let i = 0; i < list.length; i++) sum += list[i];
  return "list " + text(list) + ", length " + text(list.length) + ", sum " + text(sum);
}

function flag(on: boolean): string {
  return "on " + text(on) + ", " + (on ? "yes" : "no") + ", not " + text(!on) + ", is true " + (on === true);
}

const values: [string, unknown][] = [
  ["a number", 3],
  ["a fraction", 0.5],
  ["a text", "text"],
  ["a numeric text", "7"],
  ["undefined", undefined],
  ["null", null],
  ["true", true],
  ["a bigint", 5n],
  ["a dog", new Dog()],
  ["a look-alike", { name: "fake", legs: "many" }],
  ["a list", [1, 2]],
  ["a list of texts", ["a", "b"]],
  ["an array-like", { length: 2, 0: 5, 1: 6 }],
  ["an object with valueOf", { valueOf: () => 9 }],
];

const functions: [string, Function, unknown][] = [
  ["double", double, 2],
  ["shout", shout, "w"],
  ["walk", walk, new Dog()],
  ["total", total, [1, 2, 3]],
  ["flag", flag, false],
];

////= attempt-11

let warm = 0;
for (let i = 0; i < 2000; i++) warm += double(i).length + shout("w").length + total([i]).length + flag(i % 2 === 0).length;
console.log("2000 honest calls: " + warm);

for (const [name, f, honest] of functions) {
  attempt(name + ", honest", () => Reflect.apply(f, undefined, [honest]));
  for (const [label, value] of values) attempt(name + ", " + label, () => Reflect.apply(f, undefined, [value]));
  attempt(name + ", nothing", () => Reflect.apply(f, undefined, []));
}

attempt("direct: Reflect.apply(double, undefined, ['7'])", () => Reflect.apply(double, undefined, ["7"]));
attempt("direct: Function.prototype.call.call(double, null, '7')", () => Function.prototype.call.call(double, null, "7"));
attempt("direct: Function.prototype.apply.call(shout, null, [5])", () => Function.prototype.apply.call(shout, null, [5]));
attempt("direct: an array-like of arguments", () => Reflect.apply(double, undefined, { length: 1, 0: "8" }));
attempt("direct: a longer length than members", () => Reflect.apply(double, undefined, { length: 3 }));

const asFunction: Function = walk;
attempt("called as a Function", () => asFunction({ name: "loose", legs: 0, bark: () => "no bark" }));
attempt("called as a Function with a number", () => asFunction(5));
attempt("honest again", () => [double(1), shout("x"), walk(new Dog()), total([1]), flag(true)]);
//// reflect-construct-and-bound-constructors.ts
////= show-30

const log: string[] = [];

class Point {
  x: number;
  y: number;
  label = "point";
  constructor(x: number = -1, y: number = -2) {
    log.push("Point(" + x + ", " + y + ") for " + new.target.name);
    this.x = x;
    this.y = y;
  }
  sum(): number {
    return this.x + this.y;
  }
}

class Point3 extends Point {
  z = 3;
  sum(): number {
    return super.sum() + this.z;
  }
}

////= sum-2

////= lines-19	call	p	Point	number	p.sum

let warm = 0;
for (let i = 0; i < 2000; i++) warm += sum(new Point(i, 1)) + call(new Point(i, 1)) + call(new Point3(i, 1));
console.log("after 2000 honest points", warm);

const BoundOne = Point.bind(null, 10);
const BoundBoth = Point.bind(null, 10, 20);
const BoundTwice = BoundOne.bind(null, 30);

const makers: [string, () => Point][] = [
  ["new", () => new Point(1, 2)],
  ["Reflect.construct", () => Reflect.construct(Point, [1, 2])],
  ["Reflect.construct without arguments", () => Reflect.construct(Point, [])],
  ["Reflect.construct with one argument", () => Reflect.construct(Point, [1])],
  ["Reflect.construct with too many", () => Reflect.construct(Point, [1, 2, 3, 4])],
  ["Reflect.construct with an array-like", () => Reflect.construct(Point, { 0: 1, 1: 2, length: 2 })],
  ["Reflect.construct with strings", () => Reflect.construct(Point, ["one", "two"])],
  ["Reflect.construct for itself", () => Reflect.construct(Point, [1, 2], Point)],
  ["Reflect.construct for the subclass", () => Reflect.construct(Point, [1, 2], Point3)],
  ["Reflect.construct of the subclass", () => Reflect.construct(Point3, [1, 2])],
  ["a constructor bound to one argument", () => new BoundOne(2)],
  ["a constructor bound to both", () => new BoundBoth()],
  ["a constructor bound twice", () => new BoundTwice()],
  ["Reflect.construct of a bound constructor", () => Reflect.construct(BoundOne, [2])],
  ["the constructor read from an instance", () => Reflect.construct(new Point(0, 0).constructor, [1, 2])],
  ["the constructor in a variable", () => {
    const Class: new (x: number, y: number) => Point = Point;
    return new Class(1, 2);
  }],
  ["spread arguments", () => new Point(...([1, 2] satisfies [number, number]))],
];
for (const [name, make] of makers) {
  log.length = 0;
  attempt(name, () => {
    const made = make();
    return [made.x, made.y, made.label, Object.keys(made), made instanceof Point, made instanceof Point3, made.constructor.name];
  });
  console.log("  log: " + log.join("; "));
  attempt(name + ": x + y", () => sum(make()));
  attempt(name + ": sum()", () => call(make()));
}
attempt("bound constructors: name, length, prototype", () => [BoundOne.name, BoundOne.length, "prototype" in BoundOne, new BoundOne(2) instanceof BoundOne]);
attempt("called without new", () => Reflect.apply(Point, undefined, [1, 2]));
attempt("Reflect.construct of what is no constructor", () => Reflect.construct(Math.max, [1, 2]));
attempt("Reflect.construct for what is no constructor", () => Reflect.construct(Point, [1, 2], Math.max));
