class Table {
  cells: Record<string, number> = {};
  set(key: string, value: number): this {
    this.cells[key] = value;
    return this;
  }
  total(): number {
    let t = 0;
    for (const key in this.cells) t += this.cells[key];
    return t;
  }
}
