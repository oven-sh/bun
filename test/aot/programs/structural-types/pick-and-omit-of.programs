//// range-proofs-about-an-int32-parameter-meet-other-numbers.ts
import type { int32 } from "bun";

////= show-35

function upOnce(i: int32): int32 {
  return i < 100 ? i + 1 : i;
}
function downOnce(i: int32): int32 {
  return i > -100 ? i - 1 : i;
}
function upTwice(i: int32): int32 {
  if (i < 100) {
    i++;
    i++;
  }
  return i;
}
function notAtLeast(i: int32): int32 {
  if (!(i >= 100)) i++;
  return i;
}
function until(i: int32): int32 {
  do {
    if (i >= 100) break;
    i++;
  } while (true);
  return i;
}
function product(i: int32, j: int32): int32 {
  return i < 100 && j < 100 && i > 0 && j > 0 ? i * j : 0;
}
function negative(i: int32): int32 {
  return i > 0 ? -i : 0;
}
function remainder(i: int32): int32 {
  return i >= 0 ? i % 7 : 0;
}
function remainderOf(i: int32, j: int32): int32 {
  return i >= 0 && j > 0 ? i % j : 0;
}
function quotient(i: int32): int32 {
  return i > 0 ? Math.floor(7 / i) : 0;
}
function counted(from: int32, to: int32): int32 {
  let turns: int32 = 0;
  for (let i: int32 = from; i < to; i++) turns = (turns + 1) | 0;
  return turns;
}
function least(a: int32, b: int32): int32 {
  return Math.min(a, b);
}
////= lines-36	sign	a	int32	int32	Math.sign	a
function half(a: int32): int32 {
  return Math.floor(a / 2);
}
////= lines-158	times	a	int32	int32	1
function and(a: int32): int32 {
  return a && 1;
}

const one: [string, (i: number) => number][] = [
  ["up once", upOnce],
  ["down once", downOnce],
  ["up twice", upTwice],
  ["not at least", notAtLeast],
  ["negative", negative],
  ["remainder", remainder],
  ["quotient", quotient],
  ["sign", sign],
  ["half", half],
  ["times one", times],
  ["and", and],
];
const two: [string, (i: number, j: number) => number][] = [
  ["product", product],
  ["remainder of", remainderOf],
  ["counted", counted],
  ["least", least],
];

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const v = (i % 150) | 0;
  warm += upOnce(v) + downOnce(v) + upTwice(v) + notAtLeast(v) + until(v) + product(v, 3) + negative(v) + remainder(v) + remainderOf(v, 5) + quotient(v) + counted(0, v) + least(v, 7) + sign(v) + half(v) + times(v) + and(v);
}
console.log("2000 honest rounds", warm);

const odd: number[] = [1.5, 99.5, -0, -0.5, 0.25, NaN, 2 ** 31, -(2 ** 31) - 1, 1e21, Infinity, -Infinity, 7.5];
for (const n of odd) {
  attempt(show(n), () => one.map(([, run]) => run(n)));
  const some = Math.abs(n) < 1000 || n !== n ? two : two.filter(([label]) => label !== "counted");
  attempt(show(n) + " and 3", () => some.map(([, run]) => run(n, 3)));
  attempt("2 and " + show(n), () => some.map(([, run]) => run(2, n)));
}
attempt("until, from a fraction", () => {
  const run: (i: number) => number = until;
  return [run(98.5), run(99.5), run(-0), run(2 ** 31), run(Infinity)];
});
attempt("labels", () => [...one, ...two].map(([label]) => label));
//// read-only-tuples-of-literals-are-changed-by-reflection.ts
////= show-35

type Pair = readonly [1, "one"];
type Flags = readonly [true, false];

////= lines-40	numberOf	pair	Pair	1	pair[0
////= lines-40	textOf	pair	Pair	"one"	pair[1
function sumOf(pair: Pair): number {
  return pair[0] + pair[1].length + pair.length;
}
function both(flags: Flags): string {
  return (flags[0] ? "yes" : "no") + (flags[1] ? "yes" : "no");
}
function spreadOf(pair: Pair): unknown[] {
  const [first, second] = pair;
  return [first, second, [...pair]];
}

let warm = 0;
const honest: Pair = [1, "one"];
for (let i = 0; i < 2000; i++) warm += numberOf(honest) + textOf(honest).length + sumOf(honest);
console.log("2000 honest rounds", warm);

attempt("Reflect.set of the number", () => {
  const pair: Pair = [1, "one"];
  Reflect.set(pair, 0, 2.5);
  return [numberOf(pair), numberOf(pair) === 1, sumOf(pair), spreadOf(pair)];
});
attempt("Reflect.set of the text", () => {
  const pair: Pair = [1, "one"];
  Reflect.set(pair, 1, "fifteen");
  return [textOf(pair), textOf(pair) === "one", sumOf(pair), spreadOf(pair)];
});
attempt("the two change places", () => {
  const pair: Pair = [1, "one"];
  Object.assign(pair, { 0: "one", 1: 1 });
  return [numberOf(pair), textOf(pair), typeof numberOf(pair), spreadOf(pair)];
});
attempt("the two change places and are used", () => {
  const pair: Pair = [1, "one"];
  Object.assign(pair, { 0: "one", 1: 1 });
  return sumOf(pair);
});
attempt("the length is cut", () => {
  const pair: Pair = [1, "one"];
  Reflect.set(pair, "length", 1);
  return [pair.length, textOf(pair), spreadOf(pair)];
});
attempt("the length is cut and the text is used", () => {
  const pair: Pair = [1, "one"];
  Reflect.set(pair, "length", 1);
  return sumOf(pair);
});
attempt("the length is raised", () => {
  const pair: Pair = [1, "one"];
  Reflect.set(pair, "length", 4);
  return [pair.length, sumOf(pair), spreadOf(pair)];
});
attempt("flags are flipped", () => {
  const flags: Flags = [true, false];
  Reflect.set(flags, 0, false);
  Reflect.set(flags, 1, true);
  return [both(flags), flags[0] === true, flags];
});
attempt("sorted through a wider name", () => {
  const list: [3, 1, 2] = [3, 1, 2];
  const wide: number[] = list;
  wide.sort();
  const first: 3 = list[0];
  return [first, first === 3, list];
});
attempt("honest again", () => [numberOf(honest), textOf(honest), sumOf(honest), both([true, false])]);
//// readonly-and-other-mapped-views-of-one-object.ts
////= attempt-7

interface Cart {
  items: number;
  price: number;
  note: string;
}

type Mutable<T> = { -readonly [K in keyof T]: T[K] };
type Nullable<T> = { [K in keyof T]: T[K] | null };
type Boxed<T> = { [K in keyof T]: { value: T[K] } };
type Getters<T> = { [K in keyof T as `get${Capitalize<string & K>}`]: () => T[K] };

function cost(c: Readonly<Cart>): number {
  return c.items * c.price;
}

function costAround(c: Readonly<Cart>, act: () => void): string {
  const before = c.items * c.price;
  act();
  return before + " -> " + c.items * c.price;
}

function restock(c: Mutable<Readonly<Cart>>, items: number): number {
  c.items = items;
  return c.items;
}

const cart: Cart = { items: 2, price: 5, note: "open" };
const view: Readonly<Cart> = cart;
console.log("a view of an open object: " + cost(view));
cart.items = 3;
console.log("the object changed under the view: " + cost(view) + " " + view.items);
console.log("around a call: " + costAround(view, () => { cart.price = 7; }));
attempt("the view made mutable again", () => restock(view, 4) + " " + cart.items);

const frozen = Object.freeze({ items: 2, price: 5, note: "frozen" });
console.log("a frozen object: " + cost(frozen));
attempt("made mutable by its type only", () => restock(frozen, 4));
console.log("it holds: " + JSON.stringify(frozen));

let sum = 0;
for (let i = 0; i < 2000; i++) {
  sum += cost(view);
  if (i === 999) cart.items = 1;
}
console.log("changed in the middle of 2000 reads: " + sum);

const nullable: Nullable<Cart> = cart;
nullable.note = null;
nullable.items = null;
console.log("null stored through a wider view: " + cart.note + " " + cart.items + " " + typeof cart.note + " " + cost(cart) + " " + (cart.items + 1));
attempt("a method of the string that is null now", () => cart.note.length);
cart.items = 2;
cart.note = "back";

const boxed: Boxed<Cart> = { price: { value: 1 }, note: { value: "n" }, items: { value: 2 } };
console.log("a mapped type keeps the literal's order: " + Object.keys(boxed).join() + " " + JSON.stringify(boxed));

class Shop {
  constructor(private cart: Cart) {}
  getItems(): number {
    return this.cart.items;
  }
  getPrice(): number {
    return this.cart.price;
  }
  getNote(): string {
    return this.cart.note;
  }
}

function describe(g: Getters<Cart>): string {
  return g.getItems() + " " + g.getPrice() + " " + g.getNote() + " / " + Object.keys(g).join();
}

const literalGetters: Getters<Cart> = { getNote: () => "literal", getPrice: () => 1, getItems: () => 0 };
console.log("renamed keys, a class: " + describe(new Shop(cart)));
console.log("renamed keys, a literal: " + describe(literalGetters));

const scores: Record<string, number> = { a: 1 };
const fixedScores: Readonly<Record<string, number>> = scores;
scores.b = 2;
delete scores.a;
console.log("a readonly record changes too: " + JSON.stringify(fixedScores) + " " + fixedScores.a + " " + fixedScores.b);

const map = new Map<string, number>([["a", 1]]);
const fixedMap: ReadonlyMap<string, number> = map;
const sizeOf = (m: ReadonlyMap<string, number>) => m.size;
console.log("a readonly map, before: " + sizeOf(fixedMap) + " " + fixedMap.get("b"));
map.set("b", 2);
console.log("a readonly map, after: " + sizeOf(fixedMap) + " " + fixedMap.get("b"));

const deep: Readonly<{ inner: Cart }> = { inner: cart };
deep.inner.items = 9;
console.log("readonly is one level deep: " + cart.items);

const views: Readonly<Cart>[] = [cart, frozen, { note: "third", price: 1, items: 1 }];
console.log("elements: " + views.map(cost).join() + " " + views.map(v => Object.keys(v).join("")).join());
attempt("all restocked", () => views.map(v => restock(v, 1)).join());
console.log("afterwards: " + views.map(cost).join());

