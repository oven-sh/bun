//// primitives-under-object-types-across-await-and-yield.ts
////= show-30

type HasLength = { length: number };

async function afterAnAwait(item: HasLength): Promise<number> {
  await null;
  return item.length;
}

async function beforeAndAfter(item: HasLength): Promise<string> {
  const before = item.length;
  await Promise.resolve();
  const kind = typeof item;
  await Promise.resolve();
  return before + " " + kind + " " + item.length;
}

async function awaited(promise: Promise<HasLength>): Promise<number> {
  const item = await promise;
  return item.length;
}

async function awaitedItself(item: HasLength | Promise<HasLength>): Promise<string> {
  const settled = await item;
  return typeof settled + " " + settled.length;
}

async function total(items: HasLength[]): Promise<number> {
  let sum = 0;
  for (const item of items) {
    await null;
    sum += item.length;
  }
  return sum;
}

function* lengths(items: HasLength[]): Generator<number, string, HasLength> {
  let answer = "";
  for (const item of items) {
    const sent = yield item.length;
    answer += typeof sent + sent.length + " " + typeof item + item.length + ";";
  }
  return answer;
}

function* hand(items: HasLength[]): Generator<HasLength> {
  for (const item of items) yield item;
}

async function* handLater(items: HasLength[]): AsyncGenerator<HasLength> {
  for (const item of items) {
    await null;
    yield item;
  }
}

const values: [string, HasLength][] = [
  ["literal", { length: 4 }],
  ["string", "hello"],
  ["empty string", ""],
  ["array", [1, 2]],
  ["function", awaited],
];

let warm = 0;
for (let i = 0; i < 500; i++) {
  const honest = { length: i };
  warm += (await afterAnAwait(honest)) + (await beforeAndAfter(honest)).length + (await awaited(Promise.resolve(honest))) + (await total([honest, honest]));
}
console.log("after 500 literals", warm);

for (const [name, value] of values) {
  console.log(name + ": after an await ->", show(await afterAnAwait(value)));
  console.log(name + ": before and after ->", show(await beforeAndAfter(value)));
  console.log(name + ": the value of a promise ->", show(await awaited(Promise.resolve(value))));
  console.log(name + ": awaited itself ->", show(await awaitedItself(value)));
  console.log(name + ": then ->", show(await Promise.resolve(value).then(item => item.length)));
}
const all = values.map(([, value]) => value);
console.log("total ->", show(await total(all)));
console.log("Promise.all ->", show((await Promise.all(all.map(item => Promise.resolve(item)))).map(item => typeof item + item.length)));

attempt("sent into a generator", () => {
  const generator = lengths(all);
  const seen: unknown[] = [generator.next("unused").value];
  for (const value of ["sent", [1], { length: 9 }, "", lengths] satisfies HasLength[]) seen.push(generator.next(value).value);
  return seen;
});
attempt("handed out by a generator", () => {
  let sum = 0;
  for (const item of hand(all)) sum += item.length;
  return sum;
});
let sumLater = "";
for await (const item of handLater(all)) sumLater += typeof item + item.length + ";";
console.log("handed out by an async generator ->", sumLater);

export {};
//// private-and-protected-members-are-ordinary-members-at-run-time.ts
class Wallet {
  private cash = 5;
  protected limit = 100;
  owner = "wallet";
  spend(amount: number): number {
    this.cash -= amount;
    return this.cash;
  }
  richerThan(other: Wallet): boolean {
    return this.cash > other.cash;
  }
  room(): number {
    return this.limit - this.cash;
  }
}

class Purse extends Wallet {
  protected limit = 50;
  owner = "purse";
  roomOf(other: Purse): number {
    return other.limit;
  }
}

type Public = Pick<Wallet, keyof Wallet>;

class Imitation {
  owner = "imitation";
  spend(amount: number): number {
    return -amount;
  }
  richerThan(): boolean {
    return true;
  }
  room(): number {
    return -1;
  }
}

function listing(value: object): string {
  return Object.keys(value).join() + " " + JSON.stringify(value) + " " + JSON.stringify({ ...value });
}

function use(w: Public): string {
  return w.owner + " " + w.spend(1) + " " + w.room() + " " + w.richerThan(new Wallet()) + " " + (w instanceof Wallet);
}

function nominal(w: Wallet): string {
  return w.owner + " " + w.spend(1) + " " + w.room() + " " + w.richerThan(new Wallet()) + " " + (w instanceof Wallet);
}

console.log("a wallet lists its private members: " + listing(new Wallet()));
console.log("a purse: " + listing(new Purse()));
console.log("the public side, a wallet: " + use(new Wallet()));
console.log("the public side, a purse: " + use(new Purse()));
console.log("the public side, an imitation: " + use(new Imitation()));
console.log("the class type, a wallet: " + nominal(new Wallet()));
console.log("the class type, a purse: " + nominal(new Purse()));

const proxied: Wallet = new Proxy(new Wallet(), {
  get(target, key, receiver) {
    return key === "cash" ? 1000 : Reflect.get(target, key, receiver);
  },
});
console.log("the class type, a proxy: " + nominal(proxied));
console.log("a wallet against the proxy: " + new Wallet().richerThan(proxied));

const bare: Wallet = Object.create(Wallet.prototype);
console.log("the class type, only the prototype: " + nominal(bare));
console.log("what it holds afterwards: " + listing(bare));

const cloned: Wallet = Object.assign(Object.create(Wallet.prototype), { owner: "copy", cash: 7 });
console.log("the class type, some members: " + nominal(cloned));

const everyone: Public[] = [new Wallet(), new Imitation(), new Purse(), proxied, bare];
console.log("owners: " + everyone.map(w => w.owner).join());
console.log("spent: " + everyone.map(w => w.spend(2)).join());
console.log("instances: " + everyone.map(w => w instanceof Wallet).join());

let total = 0;
const spendOne = (w: Public) => w.spend(1);
const honest = new Wallet();
for (let i = 0; i < 2000; i++) total += spendOne(honest);
console.log("2000 honest: " + total);
console.log("then the imitation: " + spendOne(new Imitation()));

const purse = new Purse();
console.log("protected through a sibling: " + purse.roomOf(new Purse()) + " " + purse.room());
console.log("by name at run time: " + Object.entries(purse).map(([key, value]) => key + "=" + value).join());

