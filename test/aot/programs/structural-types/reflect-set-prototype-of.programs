class Meter {
  #value = 0;
  doubled = 0;
  static limit = 10;
  static origin: Point = { x: 0, y: 0 };
  set value(n: number) {
    this.#value = n;
    this.doubled = n * 2;
  }
  get value(): number {
    return this.#value;
  }
  overLimit(): boolean {
    return this.#value > Meter.limit;
  }
}

