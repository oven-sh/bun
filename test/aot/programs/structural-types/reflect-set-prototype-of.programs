for (let i = 0; i < 500; i++) warm += total(Object.values(counts)) + sum(structuredClone(point)) + total(points.map(sum)) + sum(points.toSorted((a, b) => a.x - b.x)[0]) + sum(Object.assign({ x: i, y: 1 }, { z: 1 }));
