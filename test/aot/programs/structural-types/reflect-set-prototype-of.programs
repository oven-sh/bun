let quiet = false;
const log: string[] = [];

////= text-24

const changes: [string, (p: Part) => Part][] = [
  [
    "the prototype becomes null",
    p => {
      Reflect.setPrototypeOf(p, null);
      return p;
    },
  ],
  [
    "the prototype becomes Object.prototype",
    p => {
      Reflect.setPrototypeOf(p, Object.prototype);
      return p;
    },
  ],
  [
    "the prototype becomes that of another class",
    p => {
      Reflect.setPrototypeOf(p, Twin.prototype);
      return p;
    },
  ],
  [
    "the prototype becomes a plain object with the methods",
    p => {
      Reflect.setPrototypeOf(p, { total: () => -1, title: () => "plain" });
      return p;
    },
  ],
  [
    "the prototype has members named like the fields",
    p => {
      Reflect.setPrototypeOf(p, { count: 100, extra: 5, total: () => -2, title: () => "named" });
      return p;
    },
  ],
  [
    "the prototype becomes a child of its own",
    p => {
      Reflect.setPrototypeOf(p, Object.create(Part.prototype));
      return p;
    },
  ],
  [
    "the prototype becomes that of the subclass",
    p => {
      Reflect.setPrototypeOf(p, SubPart.prototype);
      return p;
    },
  ],
  [
    "the prototype becomes a proxy of its own",
    p => {
      Reflect.setPrototypeOf(
        p,
        new Proxy(Part.prototype, {
          get(target, key, receiver) {
            log.push("get " + String(key));
            return Reflect.get(target, key, receiver);
          },
        }),
      );
      return p;
    },
  ],
];

