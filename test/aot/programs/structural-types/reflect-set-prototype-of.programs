//// required-defaults-are-overridden-by-an-explicit-undefined.ts
////= show-32

interface Options {
  depth?: number;
  ratio?: number;
  name?: string;
  log?: (text: string) => number;
}

function withDefaults<T>(given: T, defaults: Required<T>): Required<T> {
  return { ...defaults, ...given };
}

const defaults: Required<Options> = { depth: 2, ratio: 0.5, name: "none", log: text => text.length };

function use(o: Required<Options>): string {
  return o.depth + 1 + " " + o.ratio * 2 + " " + o.name.toUpperCase() + " " + o.log("abc");
}

function report(title: string, o: Required<Options>): void {
  console.log(title + ": " + typeof o.depth + " " + show(o.depth) + ", " + typeof o.ratio + " " + show(o.ratio) + ", " + typeof o.name + " " + show(o.name) + ", " + typeof o.log + ", keys " + Object.keys(o).join() + ", " + JSON.stringify(o));
  attempt("  depth + 1", () => o.depth + 1);
  attempt("  ratio * 2", () => o.ratio * 2);
  attempt("  name.toUpperCase()", () => o.name.toUpperCase());
  attempt("  log('abc')", () => o.log("abc"));
  attempt("  all of them", () => use(o));
}

let width = 0;
for (let i = 0; i < 2000; i++) width += use(withDefaults<Options>(i % 2 === 0 ? { depth: i } : { name: "n" + i }, defaults)).length;
console.log("2000 honest rounds: " + width);

report("nothing given", withDefaults<Options>({}, defaults));
report("depth: undefined", withDefaults<Options>({ depth: undefined }, defaults));
report("ratio: undefined", withDefaults<Options>({ ratio: undefined }, defaults));
report("name: undefined", withDefaults<Options>({ name: undefined }, defaults));
report("log: undefined", withDefaults<Options>({ log: undefined }, defaults));
const wide = { depth: 1, name: "wide", ratio: 1, log: undefined, more: "more" };
report("a variable with one member more", withDefaults<Options>(wide, defaults));
report("the defaults were never touched", defaults);

export {};
//// required-members-disappear-through-an-optional-alias.ts
interface Loose {
  width?: number;
  title?: string;
  inner?: { depth: number };
}

type Strict = Required<Loose>;

////= attempt-7

////= lines-88	width	s	Strict	s.width	2

////= lines-32	title	s	Strict	number	s.title.length

////= lines-32	depth	s	Strict	number	s.inner.depth

function state(s: Strict): string {
  return Object.keys(s).join() + " " + JSON.stringify(s) + " " + typeof s.width + " " + typeof s.title + " " + typeof s.inner;
}

function fresh(): Strict {
  return { width: 2, title: "four", inner: { depth: 6 } };
}

function strip(l: Loose): void {
  delete l.width;
  delete l.title;
  delete l.inner;
}

function blank(l: Loose): void {
  l.width = undefined;
  l.title = undefined;
  l.inner = undefined;
}

function all(label: string, s: Strict): void {
  attempt(label + ", number", () => width(s));
  attempt(label + ", string", () => title(s));
  attempt(label + ", object", () => depth(s));
  console.log(label + ", state: " + state(s));
}

all("untouched", fresh());

const deleted = fresh();
strip(deleted);
all("deleted through the alias", deleted);

const blanked = fresh();
blank(blanked);
all("set to undefined through the alias", blanked);

const local = fresh();
const alias: Loose = local;
delete alias.width;
console.log("local: " + (local.width + 1) + " " + (local.width | 0) + " " + ("width" in local));

const steady = fresh();
let sum = 0;
for (let i = 0; i < 2000; i++) sum += width(steady) + title(steady) + depth(steady);
console.log("2000 honest: " + sum);
strip(steady);
all("then stripped", steady);

const looped = fresh();
let total = 0;
attempt("stripped in the middle of a loop", () => {
  for (let i = 0; i < 2000; i++) {
    total += looped.inner.depth;
    if (i === 1200) strip(looped);
  }
  return "finished";
});
console.log("the loop got to: " + total);

class Panel {
  strict: Strict = fresh();
  list: Strict[] = [fresh(), fresh()];
  measure(): number {
    return this.strict.width + this.list[0].width + this.list[1].inner.depth;
  }
}

const panel = new Panel();
console.log("fields and elements: " + panel.measure());
strip(panel.strict);
console.log("the field stripped: " + panel.measure());
strip(panel.list[1]);
attempt("an element stripped", () => panel.measure());

const rebuilt = fresh();
strip(rebuilt);
Object.assign(rebuilt, { inner: { depth: 1 }, title: "t", width: 1 });
all("stripped and filled in another order", rebuilt);

const partialOfRequired: Partial<Strict> = {};
const roundTrip: Loose = partialOfRequired;
console.log("Partial<Required<T>> is T again: " + JSON.stringify(roundTrip) + " " + roundTrip.width);

export {};
