class Settings {
  depth?: number;
  title?: string;
  id: number = 1;
}

class Filled extends Settings {
  depth: number = 2;
  title: string = "filled";
}

function depthOf(settings: Required<Settings>): number {
  return settings.depth;
}

////= lines-229	titleLength	settings	Required	Settings	number	settings.title.length

function strip(settings: Settings): void {
  delete settings.depth;
  delete settings.title;
}

function blank(settings: Settings): void {
  settings.depth = undefined;
  settings.title = undefined;
}

let sum = 0;
for (let i = 0; i < 2000; i++) sum += depthOf(new Filled()) + titleLength(new Filled());
show("2000 honest rounds", () => sum);

const filled = new Filled();
show("filled", () => [depthOf(filled), depthOf(filled) + 1, titleLength(filled), Object.keys(filled)]);
strip(filled);
show("stripped: the number", () => [depthOf(filled), depthOf(filled) + 1, filled.depth]);
show("stripped: the length of the text", () => titleLength(filled));
show("stripped: keys", () => Object.keys(filled));
show("stripped: in", () => ["depth" in filled, "title" in filled]);

const blanked = new Filled();
blank(blanked);
show("blanked: the number", () => [depthOf(blanked), depthOf(blanked) + 1]);
show("blanked: the length of the text", () => titleLength(blanked));
show("blanked: keys", () => Object.keys(blanked));
show("blanked: JSON", () => JSON.stringify(blanked));

show("a bare instance of the base class", () => [Object.keys(new Settings()), "depth" in new Settings(), new Settings().depth]);
show("three in a row", () => [new Filled(), filled, blanked].map(depthOf));
show("a fresh one again", () => [depthOf(new Filled()), titleLength(new Filled())]);
//// required-parameters-are-left-out-through-a-type-with-a-rest-parameter.ts
////= text-19

function lengths(a: string, b: string): string {
  return "a " + text(a) + ", b " + text(b) + ", lengths " + (a.length + b.length);
}

function joined(a: string, b: string): string {
  return "a " + text(a) + ", b " + text(b) + ", joined " + (a + b);
}

function sum(a: number, b: number, c: number): string {
  return [a, b, c].map(text).join(", ") + ", sum " + text(a + b + c) + ", whole " + text((a + b + c) | 0);
}

class Point {
  x: number;
  y: number;
  constructor(x: number, y: number) {
    this.x = x;
    this.y = y;
  }
  norm(): number {
    return Math.abs(this.x) + Math.abs(this.y);
  }
}

function distance(from: Point, to: Point): string {
  return text(from) + " " + text(to) + " " + text(to.norm() - from.norm());
}

const looseLengths: (...parts: string[]) => string = lengths;
const looseJoined: (...parts: string[]) => string = joined;
const looseSum: (...parts: number[]) => string = sum;
const looseDistance: (...points: Point[]) => string = distance;
const LoosePoint: new (...parts: number[]) => Point = Point;

attempt("honest lengths", () => lengths("ab", "c"));
attempt("lengths of none", () => looseLengths());
attempt("lengths of one", () => looseLengths("ab"));
attempt("lengths of two", () => looseLengths("ab", "c"));
attempt("lengths of three", () => looseLengths("ab", "c", "d"));
attempt("lengths of a list", () => looseLengths(...["x"]));
attempt("lengths of an empty list", () => looseLengths(...[]));

attempt("joined of none", () => looseJoined());
attempt("joined of one", () => looseJoined("ab"));

attempt("honest sum", () => sum(1, 2, 3));
attempt("sum of none", () => looseSum());
attempt("sum of two", () => looseSum(1, 2));
attempt("sum of three", () => looseSum(1, 2, 3));
const list: number[] = [1, 2, 3];
attempt("sum of a list", () => looseSum(...list));
list.pop();
attempt("sum of the list after a pop", () => looseSum(...list));
attempt("sum of holes", () => looseSum(...new Array<number>(3)));

attempt("honest distance", () => distance(new Point(0, 0), new Point(1, 2)));
attempt("distance of one", () => looseDistance(new Point(1, 2)));
attempt("distance of none", () => looseDistance());

attempt("honest point", () => new Point(1, 2));
attempt("a point of one", () => {
  const p = new LoosePoint(1);
  return [p, Object.keys(p).join(), text(p.y), text(p.norm())];
});
attempt("a point of none", () => {
  const p = new LoosePoint();
  return [p, Object.keys(p).join(), text(p.x), text(p.norm())];
});

let warm = 0;
for (let i = 0; i < 2000; i++) warm += sum(i, 1, 2).length + lengths("a", "b").length;
console.log("2000 honest calls: " + warm);
attempt("sum of one after them", () => looseSum(5));
attempt("lengths of one after them", () => looseLengths("z"));
attempt("honest again", () => sum(1, 2, 3));

function callAll(functions: ((...parts: number[]) => string)[], ...parts: number[]): string[] {
  return functions.map(f => f(...parts));
}
attempt("in a list of functions", () => callAll([sum, looseSum, (...all) => "rest " + all.length], 1));

class Shape {
  scale(by: number, around: Point): string {
    return text(by) + " " + text(around) + " " + text(around.x * by);
  }
}
interface Scalable {
  scale(...given: never[]): string;
}
const scalable: Scalable = new Shape();
attempt("a method behind a rest of never", () => scalable.scale());
//// rest-parameters-and-tuples-get-another-count-or-kind.ts
////= text-12

function sum(...numbers: number[]): number {
  let total = 0;
  for (const n of numbers) total += n;
  return total;
}
function pairText(...pair: [number, string]): string {
  const [n, s] = pair;
  return pair.length + " " + typeof n + " " + typeof s + " " + (n + 1) + " " + s.length;
}
function two(n: number, s: string): string {
  return typeof n + " " + typeof s + " " + (n + 1) + " " + s.length;
}
function tail(first: string, ...others: string[]): string {
  return first + " " + others.length + " " + others.map(o => typeof o + ":" + o.length).join();
}
function optionalTuple(...args: [number, string?]): string {
  return args.length + " " + typeof args[1];
}

const sumTwo: (a: number, b: number) => number = sum;
const sumOne: (a: number) => number = sum;
const tailShort: (first: string) => string = tail;

show("honest sum", () => sum(1, 2, 3));
show("sum of none", () => sum());
show("sum as two", () => sumTwo(1, 2));
show("map sum: index and array arrive", () => [1, 2].map(sumOne).map(v => typeof v + " " + v));
show("reduce sum: index and array arrive", () => {
  const result = [1, 2, 3].reduce(sumTwo, 0);
  return typeof result + " " + result;
});
show("honest tail", () => tail("a", "bc", "def"));
show("map tail: index and array arrive", () => ["a", "b"].map(tailShort));
show("replace tail", () => "abc".replace("b", tailShort));

const pair: [number, string] = [1, "one"];
show("a tuple is spread", () => pairText(...pair));
show("a tuple is spread into two parameters", () => two(...pair));
pair.reverse();
show("reversed, spread", () => pairText(...pair));
show("reversed, spread into two parameters", () => two(...pair));
pair.reverse();
pair.pop();
show("after pop, spread", () => pairText(...pair));
show("after pop, spread into two parameters", () => two(...pair));
pair.push("again", 7, "more");
show("after three pushes, spread", () => pairText(...pair));
show("after three pushes, spread into two parameters", () => two(...pair));
pair.splice(0);
show("emptied, spread", () => pairText(...pair));
show("emptied, spread into two parameters", () => two(...pair));

show("optional tuple with one", () => optionalTuple(1));
show("optional tuple with two", () => optionalTuple(1, "x"));
show("optional tuple with undefined", () => optionalTuple(1, undefined));

const numbers: number[] = new Array<number>(3);
show("holes are spread", () => sum(...numbers));
show("holes are spread: count", () => ((...all: number[]) => all.length + " " + (0 in all))(...numbers));
show("apply with a tuple", () => two.apply(undefined, [2, "two"]));
show("Math.max of holes", () => Math.max(...numbers));
//// rest-parameters-typed-as-unions-of-tuples-get-tuples-that-were-changed.ts
////= text-19

type Line = [kind: "line", x: number, y: number];
type Circle = [kind: "circle", radius: number];
type Stop = [kind: "stop"];
type Move = Line | Circle | Stop;

function draw(...move: Move): string {
  const seen = move.length + " given: " + move.map(text).join(", ") + " -> ";
  switch (move[0]) {
    case "line":
      return seen + "line to " + text(move[1] + move[2]);
    case "circle":
      return seen + "circle of " + text(move[1] * 2);
    case "stop":
      return seen + "stop";
  }
}

function byLength(...move: Move): string {
  if (move.length === 3) return "three: " + text(move[1] + move[2]);
  if (move.length === 2) return "two: " + text(move[1].toFixed(1));
  return "one: " + move[0].toUpperCase();
}

function named(...[kind, first = -1, second = -2]: Move): string {
  return text(kind) + " " + text(first) + " " + text(second);
}

function mixed(...parts: [id: number, note?: string, ...flags: boolean[]]): string {
  const [id, note, ...flags] = parts;
  return parts.length + " | " + text(id) + " | " + text(note) + " | " + text(flags) + " | " + (note === undefined ? "no note" : text(note.length));
}

attempt("honest line", () => draw("line", 1, 2));
attempt("honest circle", () => draw("circle", 3));
attempt("honest stop", () => draw("stop"));

const functions: [string, (...move: Move) => string][] = [
  ["draw", draw],
  ["by length", byLength],
  ["named", named],
];

const changes: [string, (line: Line) => void][] = [
  ["untouched", () => {}],
  ["popped", line => void line.pop()],
  ["popped twice", line => {
    line.pop();
    line.pop();
  }],
  ["emptied by splice", line => void line.splice(0)],
  ["pushed", line => void line.push(9)],
  ["reversed", line => void line.reverse()],
  ["shifted", line => void line.shift()],
  ["sorted", line => void line.sort()],
  ["filled", line => void line.fill(7, 1)],
  ["a hole", line => void Reflect.deleteProperty(line, 1)],
  ["the kind of a circle by copyWithin", line => void line.copyWithin(0, 1)],
];

for (const [name, f] of functions) {
  for (const [label, change] of changes) {
    const line: Line = ["line", 1, 2];
    change(line);
    attempt(name + ", " + label, () => f(...line));
    attempt(name + ", " + label + ", by apply", () => f.apply(null, line));
  }
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += draw("line", i, 1).length + draw("circle", i).length + draw("stop").length;
console.log("2000 honest rounds: " + warm);
const late: Circle = ["circle", 4];
late.pop();
attempt("a circle without a radius after them", () => draw(...late));

attempt("mixed(1)", () => mixed(1));
attempt("mixed(1, undefined)", () => mixed(1, undefined));
attempt("mixed(1, 'n')", () => mixed(1, "n"));
attempt("mixed(1, 'n', true, false)", () => mixed(1, "n", true, false));
attempt("mixed(1, undefined, true)", () => mixed(1, undefined, true));
const parts: [number, string?, ...boolean[]] = [1, "n", true];
parts.reverse();
attempt("mixed, reversed", () => mixed(...parts));
parts.length = 0;
attempt("mixed, emptied", () => mixed(...parts));

const moves: Move[] = [["line", 1, 2], ["circle", 3], ["stop"]];
attempt("a list of moves", () => moves.map(move => draw(...move)));
for (const move of moves) move.reverse();
attempt("the list, each reversed", () => moves.map(move => draw(...move)));
//// results-defaults-and-spread-operands-come-from-untyped-values.ts
////= Point-29

let text = "1";

////= lines-184	aNumber	number	JSON.parse	text

const anArrow = (): number => JSON.parse(text);

////= lines-184	aPoint	Point	JSON.parse	text

async function later(): Promise<number> {
  return JSON.parse(text);
}

function* yielded(): Generator<number, number, undefined> {
  yield JSON.parse(text);
  return JSON.parse(text);
}

class Source {
  get value(): number {
    return JSON.parse(text);
  }
  method(): number {
    return JSON.parse(text);
  }
  static make(): number {
    return JSON.parse(text);
  }
}

function withDefault(n: number = JSON.parse(text)): number {
  return n + 1;
}

function withDefaultPoint(p: Point = JSON.parse(text)): number {
  return p.x + p.y;
}

function withPattern({ x, y = JSON.parse(text) }: { x: number; y?: number }): number {
  return x + y;
}

function add(a: number, b: number): number {
  return a + b;
}

function addAll(...rest: number[]): number {
  let total = 0;
  for (const n of rest) total += n;
  return total;
}

function spreadIntoAdd(): number {
  const [a, b] = JSON.parse(text);
  return add(a, b);
}

function spreadIntoRest(): number {
  return addAll(...JSON.parse(text));
}

function spreadIntoAList(): number[] {
  return [0, ...JSON.parse(text)];
}

function spreadIntoALiteral(): Point {
  return { x: 1, y: 2, ...JSON.parse(text) };
}

const numbers = ["1", "1.5", "-0", '"1"', "true", "null", "[1]", "{}"];

let warm = 0;
for (let i = 0; i < 2000; i++) warm += aNumber() + anArrow() + new Source().value + new Source().method() + Source.make() + withDefault() + withPattern({ x: 1 });
console.log("2000 honest rounds: " + warm);

for (text of numbers) {
  attempt("a result " + text, () => [aNumber(), aNumber() + 1, typeof aNumber()]);
  attempt("an arrow's result " + text, () => [anArrow() + 1, [1, 2].map(anArrow)]);
  attempt("a getter " + text, () => [new Source().value + 1, typeof new Source().value]);
  attempt("a method " + text, () => new Source().method() + 1);
  attempt("a static method " + text, () => Source.make() + 1);
  attempt("a default " + text, () => [withDefault(), withDefault(undefined), withDefault(1)]);
  attempt("a default in a pattern " + text, () => [withPattern({ x: 1 }), withPattern({ x: 1, y: 1 })]);
  attempt("yielded and returned " + text, () => {
    const g = yielded();
    const first = g.next();
    const last = g.next();
    return [first.value + 1, last.value + 1, [...yielded()]];
  });
  const awaited = await later();
  attempt("awaited " + text, () => [awaited, awaited + 1, typeof awaited]);
}

for (text of ['{"x":1,"y":2}', '{"y":2,"x":1}', '{"x":"1","y":"2"}', '{"x":1}', "{}", "[1,2]", '"xy"', "5"]) {
  attempt("a point as a result " + text, () => [aPoint().x + aPoint().y, Object.keys(aPoint()).join()]);
  attempt("a point as a default " + text, () => [withDefaultPoint(), withDefaultPoint({ x: 1, y: 2 })]);
  attempt("spread into a literal " + text, () => {
    const p = spreadIntoALiteral();
    return [p.x + p.y, JSON.stringify(p)];
  });
}
text = "null";
attempt("a point as a result null", () => aPoint().x);
attempt("a point as a default null", () => withDefaultPoint());
attempt("spread into a literal null", () => JSON.stringify(spreadIntoALiteral()));

for (text of ["[1,2]", '["1",2]', "[1]", "[]", "[1,2,3]", '"12"', "[null,[2]]"]) {
  attempt("two operands " + text, spreadIntoAdd);
  attempt("rest operands " + text, spreadIntoRest);
  attempt("spread into a list " + text, () => [spreadIntoAList(), addAll(...spreadIntoAList())]);
}
text = "{}";
attempt("rest operands {}", spreadIntoRest);
attempt("spread into a list 5", () => ((text = "5"), spreadIntoAList()));

