//// return-and-throw-pass-through-yield-star-to-iterators-that-lack-them.ts
////= text-14

let log: string[] = [];

function source(members: string): Iterable<number, string> {
  return {
    [Symbol.iterator](): Iterator<number, string> {
      let n = 0;
      const iterator: Iterator<number, string> = {
        next(sent?: unknown): IteratorResult<number, string> {
          log.push("next " + text(sent));
          return ++n > 3 ? { done: true, value: "inner end" } : { done: false, value: n };
        },
      };
      if (members.includes("return")) {
        iterator.return = (value?: string): IteratorResult<number, string> => {
          log.push("return " + text(value));
          return members.includes("stubborn") ? { done: false, value: -5 } : { done: true, value: "inner closed" };
        };
      }
      if (members.includes("throw")) {
        iterator.throw = (error?: unknown): IteratorResult<number, string> => {
          log.push("throw " + text(error));
          return members.includes("ends") ? { done: true, value: "inner gave up" } : { done: false, value: -9 };
        };
      }
      return iterator;
    },
  };
}

function* outer(members: string): Generator<number, string, unknown> {
  try {
    const end: string = yield* source(members);
    log.push("yield* gave " + text(end));
    yield 50;
    return "outer end after " + end;
  } catch (error) {
    log.push("outer caught " + failure(error));
    return "outer recovered";
  } finally {
    log.push("outer finally");
  }
}

const kinds = ["only next", "return", "throw", "return and throw", "return, stubborn", "throw, ends", "return and throw, ends"];

for (const members of kinds) {
  for (const [label, act] of [
    ["return", (g: Generator<number, string, unknown>) => [g.return("asked"), g.next("after")]],
    ["throw", (g: Generator<number, string, unknown>) => [g.throw("raised"), g.next("after")]],
    ["next with a value", (g: Generator<number, string, unknown>) => [g.next("sent"), g.next()]],
  ] satisfies [string, (g: Generator<number, string, unknown>) => unknown][]) {
    log = [];
    const g = outer(members);
    g.next("first");
    let outcome: string;
    try {
      outcome = text(act(g));
    } catch (error) {
      outcome = failure(error);
    }
    console.log(members + ", " + label + ": " + outcome);
    console.log("  " + log.join(", "));
  }
}

function* overAnArray(): Generator<number, string, unknown> {
  try {
    yield* [1, 2, 3];
    return "array ran out";
  } finally {
    log.push("finally");
  }
}
log = [];
const a = overAnArray();
a.next();
console.log("an array, return: " + text(a.return("asked")) + " [" + log.join() + "]");
log = [];
const b = overAnArray();
b.next();
try {
  console.log("an array, throw: " + text(b.throw(new RangeError("raised"))));
} catch (error) {
  console.log("an array, throw: " + failure(error) + " [" + log.join() + "]");
}
//// return-and-throw-reach-a-generator-that-never-started-or-has-ended.ts
////= text-19

let bodies = 0;
let defaults = 0;

function cost(): number {
  defaults++;
  return 3;
}

function* counted(limit: number = cost()): Generator<number, string, void> {
  bodies++;
  try {
    for (let i = 0; i < limit; i++) yield i;
    return "ended at " + limit;
  } finally {
    console.log("counted: finally");
  }
}

const neverStarted = counted();
console.log("defaults run when the generator is made: " + defaults + ", bodies " + bodies);
attempt("return before the start", () => neverStarted.return("early"));
attempt("next after that", () => neverStarted.next());
console.log("bodies " + bodies);

const thrownAt = counted();
attempt("throw before the start", () => thrownAt.throw(new EvalError("early")));
attempt("next after that", () => thrownAt.next());
attempt("throw again", () => thrownAt.throw("again"));
console.log("bodies " + bodies);

const ended = counted(1);
attempt("first", () => ended.next());
attempt("second", () => ended.next());
attempt("third", () => ended.next());
attempt("return after the end", () => ended.return("late"));
attempt("throw after the end", () => ended.throw(new URIError("late")));
attempt("next after all that", () => ended.next());
console.log("bodies " + bodies + " defaults " + defaults);

function lengthOfTheEnd(generator: Generator<number, string, void>): number {
  let result = generator.next();
  while (!result.done) result = generator.next();
  const after = generator.next();
  if (after.done) return after.value.length;
  return -1;
}

attempt("the text after the end has a length", () => lengthOfTheEnd(counted(2)));

function endOf(generator: Generator<number, string, void>): string {
  let result = generator.next();
  while (!result.done) result = generator.next();
  return result.value;
}

attempt("the text at the end", () => endOf(counted(2)));
attempt("the text at the end of one that has ended", () => {
  const g = counted(0);
  endOf(g);
  const second: string = endOf(g);
  return [typeof second, second + "!", second === undefined];
});

function* failsInItsDefault(limit: number = missing()): Generator<number, void, void> {
  yield limit;
}
function missing(): number {
  throw new RangeError("no default");
}
attempt("a default that throws, throws at the call", () => {
  const g = failsInItsDefault();
  return "made " + typeof g;
});
//// return-is-called-on-a-generator-inside-try-and-finally.ts
////= text-19

function* plain(): Generator<number, string, void> {
  let step = 1;
  yield step++;
  yield step++;
  console.log("plain: never printed after a return");
  return "end " + step;
}

function* guarded(): Generator<number, string, void> {
  let step = 1;
  try {
    yield step++;
    yield step++;
    return "try " + step;
  } finally {
    console.log("guarded: finally at step " + step);
  }
}

////= lines-293	overriding	return "finally wins"

////= lines-293	throwing	throw new RangeError("from finally")

function* nested(): Generator<number, string, void> {
  try {
    try {
      yield 1;
    } finally {
      console.log("nested: inner finally");
    }
    console.log("nested: between, never printed after a return");
    yield 2;
  } finally {
    console.log("nested: outer finally");
  }
  return "end";
}

function* catching(): Generator<number, string, void> {
  try {
    yield 1;
  } catch (error) {
    console.log("catching: a return is not caught, never printed");
  }
  return "end";
}

const makers: [string, () => Generator<number, string, void>][] = [
  ["plain", plain],
  ["guarded", guarded],
  ["overriding", overriding],
  ["throwing", throwing],
  ["nested", nested],
  ["catching", catching],
];

for (const [label, make] of makers) {
  const g = make();
  attempt(label + " next", () => g.next());
  attempt(label + " return", () => g.return("asked"));
  attempt(label + " next after it", () => g.next());
  attempt(label + " return after it", () => g.return("again"));

  const length = make();
  length.next();
  attempt(label + " length of the returned text", () => {
    const result = length.return("four");
    return result.done ? result.value.length : -result.value;
  });

  let seen = 0;
  attempt(label + " left by a break", () => {
    for (const n of make()) {
      seen += n;
      break;
    }
    return seen;
  });
}
//// set-and-map-subclasses-with-fields-and-overrides-honest.ts
class CountingSet extends Set<number> {
  name = "counting";
  adds = 100;
  flag = true;
  add(value: number): this {
    this.adds++;
    return super.add(value * (this.flag ? 10 : 1) + this.name.length);
  }
}

class CountingMap extends Map<string, number> {
  stores = 100;
  set(key: string, value: number): this {
    this.stores++;
    return super.set(key, value * 10);
  }
}

function include(s: Set<number>, value: number): string {
  return [...s.add(value)].join();
}

function put(m: Map<string, number>, key: string, value: number): string {
  m.set(key, value);
  return key + "=" + m.get(key) + " size " + m.size;
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += include(new CountingSet(), i).length + put(new CountingMap(), "k", i).length + include(new Set(), i).length + put(new Map(), "k", i).length;
console.log("2000 rounds: " + warm);

const set = new CountingSet();
console.log("a set subclass: " + include(set, 1) + " | " + include(set, 2) + " | adds " + set.adds + " | keys " + Object.keys(set).join());
const map = new CountingMap();
console.log("a map subclass: " + put(map, "a", 1) + " | " + put(map, "b", 2) + " | stores " + map.stores);
console.log("plain ones at the same sites: " + include(new Set([9]), 3) + " | " + put(new Map(), "c", 3));

