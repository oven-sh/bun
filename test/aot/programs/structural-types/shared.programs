////= kind
////: distance
function distance(p: Point): number {
  return p.norm();
}
////: doubled
function doubled(numbers: number[]): number[] {
  return numbers.map(number => number * 2);
}
////: doubled-2
function doubled(«1»: «2»[]): number[] {
  return «1».map(«3» => «3» * 2);
}
////: doubledByHand
function doubledByHand(numbers: number[]): number[] {
  const result: number[] = [];
  for (let i = 0; i < numbers.length; i++) result.push(numbers[i] * 2);
  return result;
}
////: drive
function drive<T extends { norm(): number }>(label: string, p: T, holder: { norm(): number }, run: (p: T, fire: () => void) => string): void {
  let warm = 0;
  for (let i = 0; i < 2000; i++) warm += run(p, nothing).length;
  const written = holder.norm;
  const change = (): void => {
    holder.norm = () => -1;
  };
  const parts = [String(warm), run(p, nothing), run(p, change), run(p, nothing)];
  holder.norm = written;
  parts.push(run(p, nothing));
  console.log(label + ": " + parts.join(" | "));
}
////: drive-2
function drive<T extends { norm(): number }>(label: string, p: T, run: (p: T, fire: () => void) => string): void {
  let warm = 0;
  for (let i = 0; i < 2000; i++) warm += run(p, nothing).length;
  const change = (): void => {
    p.norm = () => -1;
  };
  const parts = [String(warm), run(p, nothing), run(p, change), run(p, nothing)];
  Reflect.deleteProperty(p, "norm");
  parts.push(run(p, nothing));
  console.log(label + ": " + parts.join(" | "));
}
////: drive-3
function drive<T extends { norm(): number }>(label: string, p: T, run: (p: T, fire: () => void) => string): void {
  let warm = 0;
  for (let i = 0; i < 2000; i++) warm += run(p, nothing).length;
  const change = nothing;
  const parts = [String(warm), run(p, nothing), run(p, change), run(p, nothing)];
  parts.push(run(p, nothing));
  console.log(label + ": " + parts.join(" | "));
}
////: drive-4
function drive<T extends Target>(label: string, p: T, holder: Target, run: (p: T, really: boolean) => string): void {
  let warm = 0;
  for (let i = 0; i < 2000; i++) warm += run(p, false).length;
  const written = Object.getOwnPropertyDescriptor(holder, "norm");
  const parts = [String(warm), run(p, false), run(p, true), run(p, false)];
  if (written) Object.defineProperty(holder, "norm", written);
  else Reflect.deleteProperty(holder, "norm");
  parts.push(run(p, false));
  console.log(label + ": " + parts.join(" | "));
}
////: effect
function effect<T>(label: string, value: T): T {
  log.push(label);
  return value;
}
////: facts
function facts(p: Point): string {
  const before = reads;
  const sum = p.x + p.y;
  return sum + " reads " + (reads - before) + " keys " + Object.keys(p).join("") + " json " + JSON.stringify(p) + " has " + ("x" in p);
}
////: failure
function failure(error: unknown): string {
  return "threw " + (error instanceof Error ? error.constructor.name : text(error));
}
////: failure-2
function failure(error: unknown): string {
  return "caught " + (error instanceof Error ? error.constructor.name : text(error));
}
////: failure-3
function failure(error: unknown): string {
  return "rejected " + (error instanceof Error ? error.constructor.name : text(error));
}
////: firstGroup
function firstGroup(pattern: RegExp, text: string): string {
  const match = pattern.exec(text);
  if (match === null) return "no match";
  return match[1];
}
////: firstTwo
function firstTwo(«1»: «2»): string {
  const [«3», «4»] = «1»;
  return «3» + «5» + «4»;
}
////: flush
function flush(label: string, value: unknown): void {
  console.log(label + ": " + String(value) + " [" + log.join(", ") + "]");
  log.length = 0;
}
////: for
for (const [sink, run] of sinks) {
  let rounds = 0;
  for (let i = 0; i < 2000; i++) {
    run("honest");
    rounds++;
  }
  console.log(sink + ": " + rounds + " honest rounds");
  for (const name of names) attempt(sink + ", " + name, () => run(name));
  attempt(sink + ", honest again", () => run("honest"));
}
////: for-10
for (const [label, write] of noteWrites) {
  const first = fresh();
  write(first);
  useNote(label + ", an instance", first);
  const second = other();
  write(second);
  briefNote(label + ", a subclass instance", second);
  noteInPlaces(label, () => {
    const made = fresh();
    write(made);
    return made;
  });
  noteInALoop(label, write);
}
////: for-11
for (let i = 0; i < labels.length; i++) {
  const x = values[i];
  let line = labels[i] + ":";
  if (isUndefined(x)) line += " isUndefined";
  if (isNotUndefined(x)) line += " isNotUndefined";
  if (isNull(x)) line += " isNull";
  if (isNullish(x)) line += " isNullish";
  if (kindIsUndefined(x)) line += " kindIsUndefined";
  if (kindIsNumber(x)) line += " kindIsNumber";
  if (kindIsNotNumber(x)) line += " kindIsNotNumber";
  if (kindIsString(x)) line += " kindIsString";
  if (kindIsNotString(x)) line += " kindIsNotString";
  if (kindIsBoolean(x)) line += " kindIsBoolean";
  if (kindIsObject(x)) line += " kindIsObject";
  if (kindIsNotObject(x)) line += " kindIsNotObject";
  if (kindIsFunction(x)) line += " kindIsFunction";
  if (isFalsy(x)) line += " isFalsy";
  if (isTruthy(x)) line += " isTruthy";
  if (isItself(x)) line += " isItself";
  if (isAList(x)) line += " isAList";
  if (isAnObject(x)) line += " isAnObject";
  console.log(line);
}
////: for-12
for (const [label, write] of writes) {
