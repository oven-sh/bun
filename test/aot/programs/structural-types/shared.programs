////: via0
function via0(s: S0): T0 {
  const t: T0 = s;
  return t;
}
////: via1
function via1(s: S1): T1 {
  let t: T1 = honest1();
  t = s;
  return t;
}
////: via11
function via11(s: S11): T11 {
  const list: T11[] = [honest11(), s];
  return list[1];
}
////: via12
function via12(s: S12): T12 {
  const holder: { held: T12 } = { held: s };
  return holder.held;
}
////: via13
function via13(s: S13): T13 {
  const held = s;
  const holder: { held: T13 } = { held };
  return holder.held;
}
////: via14
function via14(s: S14): T14 {
  class Keeper {
    held: T14 = s;
  }
  return new Keeper().held;
}
////: via16
function via16(s: S16): T16 {
  const take = (t: T16 = s): T16 => t;
  return take();
}
////: via17
function via17(s: S17): T17 {
  const { held = s }: { held?: T17 } = {};
  return held;
}
////: via18
function via18(s: S18): T18 {
  const list: [S18] = [s];
  return take18(...list);
}
////: via20
function via20(s: S20): T20 {
  const sources: S20[] = [s];
  const list: T20[] = [...sources];
  return list[0];
}
////: via21
function via21(s: S21): T21 {
  const source = { held: s };
  const holder: { held: T21 } = { ...source };
  return holder.held;
}
////: via22
function via22(s: S22): T22 {
  const list: T22[] = [];
  list.push(s);
  return list[0];
}
////: via23
function via23(s: S23): T23 {
  const map = new Map<string, T23>();
  map.set("k", s);
  return map.get("k") ?? honest23();
}
////: via24
function via24(s: S24): T24 {
  const map = new Map<string, T24>([["k", s]]);
  return map.get("k") ?? honest24();
}
////: via25
function via25(s: S25): T25 {
  const set = new Set<T25>();
  set.add(s);
  for (const t of set) return t;
  return honest25();
}
////: via26
function via26(s: S26): T26 {
  function* give(): Generator<T26> {
    yield s;
  }
  for (const t of give()) return t;
  return honest26();
}
////: via27
function via27(s: S27): T27 {
  const seen: T27[] = [];
  function* take(): Generator<undefined, void, T27> {
    seen.push(yield);
  }
  const generator = take();
  generator.next(honest27());
  generator.next(s);
  return seen[0];
}
////: via35
function via35(s: S35): T35 {
  let t: T35 = honest35();
  for (t of [s]);
  return t;
}
////: via36
function via36(s: S36): T36 {
  let t: T36 | undefined;
  t ??= s;
  return t;
}
////: via37
function via37(s: S37): T37 {
  let t: T37 | undefined;
  t ||= s;
  return t;
}
