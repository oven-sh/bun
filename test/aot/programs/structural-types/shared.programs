    "a map value",
    name => {
      const map = new Map<string, Point>([["first", new Point(1, 2)]]);
      map.set("second", get(name));
      let total = 0;
      for (const p of map.values()) total += p.y;
      return total;
    },
  ],
  [
    "its keys",
    name => {
      const p: Point = get(name);
      return [Object.keys(p).join(), JSON.stringify(p), p.constructor === Point];
    },
  ],
];
