////: sinks
const sinks: [string, (name: string) => unknown][] = [
  [
    "itself",
    name => {
      const n: number = get(name);
      return [n, typeof n];
    },
  ],
  [
    "arithmetic",
    name => {
      const n: number = get(name);
      return [n + 1, n - 1, n * 2, n / 2, n % 2, -n];
    },
  ],
  [
    "bits",
    name => {
      const n: number = get(name);
      return [n | 0, n >>> 0, n << 1, ~n];
    },
  ],
  [
    "comparisons",
    name => {
      const n: number = get(name);
      return [n < 4, n >= 3, n === 3, n == 3, n !== n];
    },
  ],
  [
    "an index",
    name => {
      const n: number = get(name);
      return [table[n], "abcd"[n], table.at(n), "abcd".charAt(n)];
    },
  ],
  ["a parameter", name => [plusOne(get(name)), pick(get(name))]],
  [
    "a field",
    name => {
      const counter = new Counter(name);
      return [counter.next(), counter.bump(), counter.n];
    },
  ],
  [
    "an element",
    name => {
      const list: number[] = [1, get(name)];
      list.push(get(name));
      let total = 0;
      for (const n of list) total += n;
      return [total, list];
    },
  ],
  [
    "a map value",
    name => {
      const map = new Map<string, number>([["first", 1]]);
      map.set("second", get(name));
      let total = 0;
      for (const n of map.values()) total += n;
      return total;
    },
  ],
  [
    "an update",
    name => {
      let n: number = get(name);
      n++;
      const after = n;
      n += 1;
      return [after, n, typeof n];
    },
  ],
  [
    "a bound of a loop",
    name => {
      const n: number = get(name);
      let count = 0;
      for (let i = 0; i < n && i < 5; i++) count++;
      return count;
    },
  ],
  [
    "a text",
    name => {
      const n: number = get(name);
      return [String(n), `<${n}>`, n + ""];
    },
  ],
  [
    "a method",
    name => {
      const n: number = get(name);
      return n.toFixed(1);
    },
  ],
];
////: sinks-2
const sinks: [string, (name: string) => unknown][] = [
  [
    "a local",
    name => {
      const p: Point = get(name);
      return [p.x, p.y, p.x + p.y, typeof p.x];
    },
  ],
  [
    "a field",
    name => {
      const holder = new Holder(name);
      return [holder.p.x, holder.sum()];
    },
  ],
  ["a parameter", name => sum(get(name))],
  [
    "an element",
    name => {
      const list: Point[] = [{ x: 1, y: 2 }, get(name)];
      list.push(get(name));
      let total = 0;
      for (const p of list) total += p.x;
      return [total, list[1].y, list.length];
    },
  ],
  [
    "a map value",
    name => {
      const map = new Map<string, Point>([["first", { x: 1, y: 2 }]]);
      map.set("second", get(name));
      let total = 0;
      for (const p of map.values()) total += p.y;
      return total;
    },
  ],
  [
    "its keys",
    name => {
      const p: Point = get(name);
      return [Object.keys(p).join(), JSON.stringify(p), "x" in p];
    },
  ],
  [
    "a store",
    name => {
      const p: Point = get(name);
      p.x = 7;
      return [p.x, sum(p)];
    },
  ],
];
