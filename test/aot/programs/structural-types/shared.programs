////: Point-3
class Point {
  x: number;
  y: number;
  label = "point";
  visible = true;
  tags: string[] = ["first"];
  origin: { id: number } = { id: 7 };
  note?: string;
  #secret = 42;
  constructor(x: number, y: number) {
    this.x = x;
    this.y = y;
  }
  norm(): number {
    return Math.sqrt(this.x * this.x + this.y * this.y);
  }
  get sum(): number {
    return this.x + this.y;
  }
  set sum(value: number) {
    this.x = value;
    this.y = 0;
  }
  secret(): number {
    return this.#secret;
  }
  static isPoint(value: object): boolean {
    return #secret in value;
  }
}
