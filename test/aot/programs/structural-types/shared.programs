////= facts
////: guarded-2
function guarded(run: () => unknown): string {
  try {
    return show(run());
  } catch (error) {
    return "threw " + (error instanceof Error ? error.constructor.name : typeof error);
  }
}
////: half
function half(n: number): number {
  return n / 2;
}
////: idInALoop
function idInALoop(label: string, write: (p: Part) => void): void {
  const p = fresh();
  let honest = 0;
  let last: unknown = "nothing";
  attempt(label + ", written in the middle of a loop", () => {
    for (let i = 0; i < 2000; i++) {
      if (i === 1000) write(p);
      const value = p.id + 1;
      if (typeof value === "number") honest++;
      last = value;
    }
    return "finished";
  });
  if (!quiet) console.log(label + ", rounds of the declared kind: " + honest + ", the last value: " + text(last));
}
////: idInPlaces
function idInPlaces(label: string, make: () => Part): void {
  const holder = new Holder(make());
  attempt(label + ", in a field of a class", () => holder.part.id + 1);
  const list: Part[] = [fresh(), make(), fresh()];
  attempt(label + ", an element", () => list[1].id + 1);
  attempt(label + ", a result", () => make().id + 1);
}
////: inALocal
function inALocal(index: number): unknown {
  const local: Held = pick(index);
  return [typeof local, «1»];
}
////: inALocalThatChanges
function inALocalThatChanges(index: number): unknown {
  let local: Held = honest(1);
  const seen: unknown[] = [];
  for (let round = 0; round < 3; round++) {
    seen.push(«1»);
    local = round === 0 ? pick(index) : honest(2);
  }
  return seen;
}
////: inALoop
function inALoop(label: string, change: (p: Part) => Part): void {
  let p = fresh();
  let honest = 0;
  let last: unknown = "nothing";
  attempt(label + ", changed in the middle of a loop", () => {
    for (let i = 0; i < 2000; i++) {
      if (i === 1000) p = change(p);
      const value = p.total() + p.count;
      if (typeof value === "number" && value === value) honest++;
      last = value;
    }
    return "finished";
  });
  if (!quiet) console.log(label + ", rounds that gave a number: " + honest + ", the last value: " + text(last));
}
////: inALoop-2
function inALoop(label: string, write: (list: number[]) => void): void {
  const list = numbers();
  let honest = 0;
  let last: unknown = "nothing";
  attempt(label + ", written in the middle of a loop", () => {
    for (let i = 0; i < 2000; i++) {
      if (i === 1000) write(list);
      const value = list[0] + list[1] + list.length;
      if (typeof value === "number" && value === value) honest++;
      last = value;
    }
    return "finished";
  });
  if (!quiet) console.log(label + ", rounds that gave a number: " + honest + ", the last value: " + text(last));
}
////: inALoop-3
function inALoop(label: string, write: (c: Counter) => void): void {
  const c = makeCounter();
  let honest = 0;
  let last: unknown = "nothing";
  attempt(label + ", written in the middle of a loop", () => {
    for (let i = 0; i < 2000; i++) {
      if (i === 1000) write(c);
      const value = c(1) + c.calls + c.label.length;
      if (typeof value === "number" && value === value) honest++;
      last = value;
    }
    return "finished";
  });
  if (!quiet) console.log(label + ", rounds that gave a number: " + honest + ", the last value: " + text(last));
}
////: inAMapValue
function inAMapValue(map: Map<string, Held>, key: string): unknown {
  const held = map.get(key);
  return held === undefined ? "missing" : «1»;
}
////: inEveryElement
function inEveryElement(list: Held[]): unknown[] {
  const seen: unknown[] = [];
  for (const held of list) seen.push(«1»);
  return seen;
}
////: inPlaces
function inPlaces(label: string, make: () => Part): void {
  const holder = new Holder(make());
  attempt(label + ", in a field of a class", () => holder.part.total() + holder.part.count);
  const list: Part[] = [fresh(), make(), fresh()];
  attempt(label + ", an element", () => list[1].total() + list[1].count);
  attempt(label + ", a result", () => make().total());
}
////: inPlaces-2
function inPlaces(label: string, make: () => number[]): void {
  const holder = new Holder(make());
  attempt(label + ", in a field of a class", () => holder.list[0] + holder.list.length);
  const lists: number[][] = [numbers(), make()];
  attempt(label + ", an element", () => lists[1][0] + lists[1].length);
  attempt(label + ", a result", () => make()[0] + make().length);
}
////: inPlaces-3
function inPlaces(label: string, make: () => Counter): void {
  const holder = new Holder(make());
  attempt(label + ", in a field of a class", () => holder.counter(2) + holder.counter.calls);
  const list: Counter[] = [makeCounter(), make()];
  attempt(label + ", an element", () => list[1](2) + list[1].calls);
  attempt(label + ", a result", () => make()(2));
}
////: increment
function increment(item: HasLength): number {
  item.length++;
  return item.length;
}
////: innerInALoop
function innerInALoop(label: string, write: (p: Part) => void): void {
  const p = fresh();
  let honest = 0;
  let last: unknown = "nothing";
  attempt(label + ", written in the middle of a loop", () => {
    for (let i = 0; i < 2000; i++) {
      if (i === 1000) write(p);
      const value = p.inner.depth;
      if (typeof value === "number") honest++;
      last = value;
    }
    return "finished";
  });
  if (!quiet) console.log(label + ", rounds of the declared kind: " + honest + ", the last value: " + text(last));
}
////: innerInPlaces
function innerInPlaces(label: string, make: () => Part): void {
  const holder = new Holder(make());
  attempt(label + ", in a field of a class", () => holder.part.inner.depth);
  const list: Part[] = [fresh(), make(), fresh()];
  attempt(label + ", an element", () => list[1].inner.depth);
  attempt(label + ", a result", () => make().inner.depth);
}
////: inspect
function inspect(numbers: number[]): string[] {
  const lines: string[] = [];
  for (let i = 0; i < numbers.length; i++) {
    const value = numbers[i];
    const exact = Object.is(value, undefined) ? "undefined" : Object.is(value, 0) ? "zero" : Object.is(value, -0) ? "minus zero" : Object.is(value, NaN) ? "not a number" : String(value);
    lines.push(i + " " + (i in numbers ? "present" : "absent") + " " + typeof value + " " + exact);
  }
  return lines;
}
////: kind
function kind(error: unknown): string {
  return error instanceof ReferenceError ? "a ReferenceError" : error instanceof TypeError ? "a TypeError" : "something else";
}
////: labelInALoop
function labelInALoop(label: string, write: (p: Part) => void): void {
  const p = fresh();
  let honest = 0;
  let last: unknown = "nothing";
  attempt(label + ", written in the middle of a loop", () => {
    for (let i = 0; i < 2000; i++) {
      if (i === 1000) write(p);
      const value = p.label.length;
      if (typeof value === "number") honest++;
      last = value;
    }
    return "finished";
  });
  if (!quiet) console.log(label + ", rounds of the declared kind: " + honest + ", the last value: " + text(last));
}
////: labelInPlaces
function labelInPlaces(label: string, make: () => Part): void {
  const holder = new Holder(make());
  attempt(label + ", in a field of a class", () => holder.part.label.length);
  const list: Part[] = [fresh(), make(), fresh()];
  attempt(label + ", an element", () => list[1].label.length);
  attempt(label + ", a result", () => make().label.length);
}
////: later
function later(target: Target, replacement: () => number): Promise<void> {
  return new Promise(resolve => {
    setTimeout(
      (arrived: Target) => {
        arrived.norm = replacement;
        resolve();
      },
      0,
      target,
    );
  });
}
