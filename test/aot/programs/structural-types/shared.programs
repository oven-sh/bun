////: make
function make(): Meter {
  return {
    reading: 5,
    read() {
      return this.reading * 2;
    },
    arrow: n => n + 1,
    get level(): number {
      return this.reading + 100;
    },
    twice() {
      return this.read() + this.read();
    },
  };
}
////: makeCounter
function makeCounter(): Counter {
  const counter: Counter = Object.assign(
    function count(step: number): number {
      counter.calls += 1;
      return step * 2;
    },
    {
      calls: 0,
      label: "counter",
      reset(): void {
        counter.calls = 0;
      },
    },
  );
  return counter;
}
////: meter
const meter = {
  reading: 3,
  read() {
    return this.reading * 2;
  },
  arrow: (n: number): number => n + 1,
  get level(): number {
    return this.reading + 100;
  },
  twice(): number {
    return this.read() + this.read();
  },
};
