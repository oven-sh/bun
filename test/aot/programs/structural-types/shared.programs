////: forget
function forget(item: { length?: number }): boolean {
  return delete item.length;
}
////: fresh
function fresh(): Part {
  return {
    count: 1,
    label: "part",
    inner: { depth: 2 },
    action: () => 3,
    note: "note",
    id: 4,
    total() {
      return this.count + this.inner.depth + this.action() + this.id;
    },
    title() {
      return this.label + ":" + (this.note ?? "none");
    },
  };
}
////: fresh-2
function fresh(): Part {
  return new Part();
}
