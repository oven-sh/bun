////: budget
function budget(c: Config): number {
  return c.limits.max * c.ratio + c.port;
}
////: byParameter
function byParameter(p: Point): number {
  return p.norm();
}
////: captured
function captured(start: Held): { use(): unknown; put(next: Held): void } {
  let held = start;
  return {
    use: () => «1»,
    put(next) {
      held = next;
    },
  };
}
////: changed
function changed(change: (p: Point) => void): Point {
  const p = new Point(1, 2);
  change(p);
  return p;
}
////: changes
const changes: [string, (p: Part) => Part][] = [
  ["rebuilt from its entries", p => Object.assign(Object.create(Object.getPrototypeOf(p)), Object.fromEntries(Object.entries(p)))],
  ["rebuilt from its entries backwards", p => Object.assign(Object.create(Object.getPrototypeOf(p)), Object.fromEntries(Object.entries(p).reverse()))],
  ["rebuilt without its first entry", p => Object.assign(Object.create(Object.getPrototypeOf(p)), Object.fromEntries(Object.entries(p).slice(1)))],
  ["rebuilt without a prototype", p => Object.assign(Object.create(null), Object.fromEntries(Object.entries(p)))],
  ["rebuilt from its descriptors", p => Object.create(Object.getPrototypeOf(p), Object.getOwnPropertyDescriptors(p))],
  [
    "rebuilt from its descriptors, all read-only",
    p => {
      return Object.create(
        Object.getPrototypeOf(p),
        Object.fromEntries(Object.entries(Object.getOwnPropertyDescriptors(p)).map(([key, descriptor]) => [key, { ...descriptor, writable: false }])),
      );
    },
  ],
];
////: config
function config(port: number): Config {
  return { port, ratio: 0.5, host: "localhost", secure: true, paths: ["/"], limits: { max: 10 } };
}
////: countInALoop
function countInALoop(label: string, write: (p: Part) => void): void {
  const p = fresh();
  let honest = 0;
  let last: unknown = "nothing";
  attempt(label + ", written in the middle of a loop", () => {
    for (let i = 0; i < 2000; i++) {
      if (i === 1000) write(p);
      const value = p.count + 1;
      if (typeof value === "number") honest++;
      last = value;
    }
    return "finished";
  });
  if (!quiet) console.log(label + ", rounds of the declared kind: " + honest + ", the last value: " + text(last));
}
////: countInPlaces
function countInPlaces(label: string, make: () => Part): void {
  const holder = new Holder(make());
  attempt(label + ", in a field of a class", () => holder.part.count + 1);
  const list: Part[] = [fresh(), make(), fresh()];
  attempt(label + ", an element", () => list[1].count + 1);
  attempt(label + ", a result", () => make().count + 1);
}
////: counter
function counter(prefix: string, box: { count: number }): (n: number) => number {
  return n => {
    box.count++;
    return prefix.length * 1000 + box.count * 100 + n;
  };
}
////: depthOf
function depthOf(p: Part): number {
  return p.inner.depth;
}
