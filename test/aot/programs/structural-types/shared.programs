////: note
function note(label: string, run: () => unknown): void {
  try {
    early.push(label + ": " + text(run()));
  } catch (error) {
    early.push(label + ": threw " + (error instanceof Error ? error.constructor.name : typeof error));
  }
}
////: note-2
export function note(label: string, run: () => unknown): void {
  try {
    const value = run();
    lines.push(label + ": " + typeof value + " " + String(value));
  } catch (error) {
    lines.push(label + ": threw " + (error instanceof Error ? error.constructor.name : typeof error));
  }
}
