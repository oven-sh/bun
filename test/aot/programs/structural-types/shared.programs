////= Machine-2
////: underDeleteTrap
function underDeleteTrap(p: UnderDeleteTrap, fire: () => void): string {
  const before = p.norm();
  const made = delete trapped({
    deleteProperty(target, key) {
      fire();
      return Reflect.deleteProperty(target, key);
    },
  }).extra;
  return before + " " + String(made) + " " + p.norm();
}
////: underDescriptorTrap
function underDescriptorTrap(p: UnderDescriptorTrap, fire: () => void): string {
  const before = p.norm();
  const made = {
    ...trapped({
      getOwnPropertyDescriptor(target, key) {
        fire();
        return Reflect.getOwnPropertyDescriptor(target, key);
      },
    }),
  }.value;
  return before + " " + String(made) + " " + p.norm();
}
////: underForIn
function underForIn(p: UnderForIn, fire: () => void): string {
  const before = p.norm();
  let made = 0;
  for (const key in trapped({
    ownKeys(target) {
      fire();
      return Reflect.ownKeys(target);
    },
  }))
    made += key.length;
  return before + " " + String(made) + " " + p.norm();
}
////: underGetTrap
function underGetTrap(p: UnderGetTrap, fire: () => void): string {
  const before = p.norm();
  const made = trapped({
    get(target, key, receiver) {
      fire();
      return Reflect.get(target, key, receiver);
    },
  }).value;
  return before + " " + String(made) + " " + p.norm();
}
////: underHasTrap
function underHasTrap(p: UnderHasTrap, fire: () => void): string {
  const before = p.norm();
  const made =
    "value" in
    trapped({
      has(target, key) {
        fire();
        return Reflect.has(target, key);
      },
    });
  return before + " " + String(made) + " " + p.norm();
}
////: underOwnKeysTrap
function underOwnKeysTrap(p: UnderOwnKeysTrap, fire: () => void): string {
  const before = p.norm();
  const made = Object.keys(
    trapped({
      ownKeys(target) {
        fire();
        return Reflect.ownKeys(target);
      },
    }),
  ).length;
  return before + " " + String(made) + " " + p.norm();
}
////: underPrototypeTrap
function underPrototypeTrap(p: UnderPrototypeTrap, fire: () => void): string {
  const before = p.norm();
  const made =
    trapped({
      getPrototypeOf(target) {
        fire();
        return Reflect.getPrototypeOf(target);
      },
    }) instanceof Plain;
  return before + " " + String(made) + " " + p.norm();
}
////: underSetTrap
function underSetTrap(p: UnderSetTrap, fire: () => void): string {
  const before = p.norm();
  const made = (trapped({
    set(target, key, value, receiver) {
      fire();
      return Reflect.set(target, key, value, receiver);
    },
  }).value = 5);
  return before + " " + String(made) + " " + p.norm();
}
////: use
function use(label: string, p: Part): void {
  attempt(label + ", total", () => p.total());
  attempt(label + ", title", () => p.title());
  attempt(label + ", typeof total", () => typeof p.total);
  attempt(label + ", a typed function calls total", () => totalOf(p));
  attempt(label + ", count", () => p.count + 1);
  attempt(label + ", typeof count", () => typeof p.count);
  attempt(label + ", label", () => p.label.length);
  attempt(label + ", inner", () => p.inner.depth);
  attempt(label + ", action", () => p.action());
  attempt(label + ", note", () => p.note ?? "none");
  attempt(label + ", id", () => p.id + 1);
  attempt(label + ", instanceof its class", () => p instanceof Part);
  attempt(label + ", instanceof the subclass", () => p instanceof SubPart);
  attempt(label + ", its prototype is that of its class", () => Object.getPrototypeOf(p) === Part.prototype);
  attempt(label + ", the name of its constructor", () => p.constructor.name);
  attempt(label + ", keys", () => Object.keys(p).join());
  attempt(label + ", for-in", () => (() => {
    let walked = "";
    for (const key in p) walked += key + ",";
    return walked;
  })());
  attempt(label + ", json", () => JSON.stringify(p));
  attempt(label + ", a copy", () => JSON.stringify({ ...p }));
  attempt(label + ", as text", () => String(p));
  attempt(label + ", has toString", () => "toString" in p);
  attempt(label + ", hasOwnProperty", () => p.hasOwnProperty("count"));
  attempt(label + ", count stored", () => (p.count = 10));
  attempt(label + ", total after the store", () => p.total());
}
////: use-2
function use(label: string, c: Counter): void {
  attempt(label + ", called", () => c(2));
  attempt(label + ", a typed function calls it", () => invoke(c));
  attempt(label + ", calls", () => c.calls);
  attempt(label + ", typeof calls", () => typeof c.calls);
  attempt(label + ", calls is a number", () => typeof c.calls === "number");
  attempt(label + ", calls is undefined", () => c.calls === undefined);
  attempt(label + ", reset is a function", () => typeof c.reset === "function");
  attempt(label + ", calls plus one", () => c.calls + 1);
  attempt(label + ", a typed function reads calls", () => callsPlusOne(c));
  attempt(label + ", the length of the label", () => c.label.length);
  attempt(label + ", reset", () => (c.reset(), c.calls));
  attempt(label + ", its name", () => c.name);
  attempt(label + ", its length", () => c.length);
  attempt(label + ", typeof", () => typeof c);
  attempt(label + ", through call", () => c.call(undefined, 3));
  attempt(label + ", through apply", () => c.apply(undefined, [4]));
  attempt(label + ", bound", () => c.bind(undefined, 5)());
  attempt(label + ", keys", () => Object.keys(c).join());
  attempt(label + ", a copy", () => JSON.stringify({ ...c }));
  attempt(label + ", instanceof Function", () => c instanceof Function);
  attempt(label + ", handed to map", () => [1, 2].map(c).join());
  attempt(label + ", calls stored", () => (c.calls = 50));
  attempt(label + ", calls incremented", () => ++c.calls);
  attempt(label + ", the label stored", () => (c.label = "stored"));
  attempt(label + ", called again", () => c(6) + c.calls);
}
