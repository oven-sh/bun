////: Gauge
class Gauge {
  level = 1;
  one(): number {
    return this.level + 1;
  }
  two(): number {
    return this.level + 2;
  }
  three(): number {
    return this.level + 3;
  }
  four(): number {
    return this.level + 4;
  }
  five(): number {
    return this.level + 5;
  }
  get six(): number {
    return this.level + 6;
  }
  get seven(): number {
    return this.level + 7;
  }
  all(): number {
    return this.one() + this.two() + this.three() + this.four() + this.five() + this.six + this.seven;
  }
}
////: Geometry
namespace Geometry {
  export function area(side: number): number {
    return side * side;
  }
  export function twice(side: number): number {
    return area(side) * 2;
  }
  export function twiceByName(side: number): number {
    return Geometry.area(side) * 2;
  }
  export let scale: (n: number) => number = n => n * 10;
  export function scaled(n: number): number {
    return scale(n);
  }
}
