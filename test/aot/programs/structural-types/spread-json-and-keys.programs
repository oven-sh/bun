  return [held, held + 1, typeof held, missing in table];
});
attempt("switches", () => {
  const flags: boolean[] = [true, false];
  const made: Switch[] = flags.map((flag): Switch => `is-${flag}`);
  return [made, made.map(isOn)];
});
attempt("bigints", () => {
