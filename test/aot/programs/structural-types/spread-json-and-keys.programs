//// standard-decorators-add-initializers-and-run-in-order.ts
const seen: string[] = [];

function mark(label: string) {
  seen.push("evaluated " + label);
  return function (target: unknown, context: DecoratorContext): void {
    seen.push("applied " + label + " to " + context.kind + " " + String(context.name) + (context.kind !== "class" && context.static ? " (static)" : ""));
    context.addInitializer(function () {
      seen.push("initializer of " + label);
    });
  };
}

@mark("class one")
@mark("class two")
class Meter {
  @mark("field") amount = (seen.push("the field's own initializer"), 2);
  @mark("static field") static shared = 1;
  @mark("method")
  read(): number {
    return this.amount;
  }
  @mark("static method")
  static make(): Meter {
    return new Meter();
  }
  @mark("getter")
  get twice(): number {
    return this.amount * 2;
  }
  @mark("private method")
  #hidden(): number {
    return 1;
  }
  constructor() {
    seen.push("constructor body " + this.#hidden());
  }
}

console.log("after the definition:");
for (const line of seen) console.log("  " + line);
seen.length = 0;
const made = Meter.make();
console.log("after one construction:");
for (const line of seen) console.log("  " + line);
console.log("members: " + made.amount + " " + made.read() + " " + made.twice + " " + Meter.shared + " keys [" + Object.keys(made).join(" ") + "]");
//// standard-decorators-replace-methods-accessors-and-fields.ts
////= describe

const seen: string[] = [];

function doubled(target: (this: Meter) => number, context: ClassMethodDecoratorContext<Meter, (this: Meter) => number>) {
  seen.push("method " + String(context.name));
  return function (this: Meter): number {
    return target.call(this) * 2;
  };
}

function plusOne(target: (this: Meter) => number, context: ClassGetterDecoratorContext<Meter, number>) {
  seen.push("getter " + String(context.name));
  return function (this: Meter): number {
    return target.call(this) + 1;
  };
}

function tripled(target: undefined, context: ClassFieldDecoratorContext<Meter, number>) {
  seen.push("field " + String(context.name));
  return function (this: Meter, initial: number): number {
    return initial * 3;
  };
}

function watched(target: ClassAccessorDecoratorTarget<Meter, number>, context: ClassAccessorDecoratorContext<Meter, number>): ClassAccessorDecoratorResult<Meter, number> {
  seen.push("accessor " + String(context.name));
  return {
    get() {
      seen.push("read");
      return target.get.call(this);
    },
    set(value) {
      seen.push("write " + value);
      target.set.call(this, value);
    },
    init(initial) {
      return initial + 100;
    },
  };
}

class Meter {
  @tripled amount = 2;
  @watched accessor level = 1;
  @doubled
  read(): number {
    return this.amount;
  }
  @plusOne
  get next(): number {
    return this.amount;
  }
}

const made = new Meter();
console.log(describe(made));
console.log("amount " + made.amount + " read " + made.read() + " next " + made.next + " level " + made.level);
made.level = 5;
console.log("level " + made.level);
console.log(seen.join(", "));
