//// spread-json-and-keys-of-primitives-under-object-types.ts
////= show-30

type HasLength = { length: number };

////= lines-152	spread	item	HasLength

function spreadWithMore(item: HasLength): { first: number; length: number; last: number } {
  return { first: 1, ...item, last: 2 };
}

function spreadThenOverride(item: HasLength): HasLength {
  return { ...item, length: -1 };
}

function lengthOfSpread(item: HasLength): number {
  const copy = { ...item };
  return copy.length;
}

////= lines-36	json	item	HasLength	string	JSON.stringify	item

function jsonInside(item: HasLength): string {
  return JSON.stringify({ item, list: [item] });
}

////= lines-224	keys	item	HasLength

function entries(item: HasLength): [string, unknown][] {
  return Object.entries(item);
}

function rest(item: HasLength): {} {
  const { length, ...others } = item;
  return { length, others };
}

const makers: [string, () => HasLength][] = [
  ["literal", () => ({ length: 2 })],
  ["wider literal", () => ({ z: 1, length: 2, a: 3 })],
  ["string", () => "ab"],
  ["empty string", () => ""],
  ["array", () => [7, 8]],
  ["function", () => spread],
  ["typed array", () => new Uint8Array([5, 6])],
  ["String object", () => new String("ab")],
  ["function with members", () => Object.assign((a: number) => a, { extra: true })],
];

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const honest = { length: i };
  warm += spread(honest).length + spreadWithMore(honest).length + spreadThenOverride(honest).length + lengthOfSpread(honest);
  warm += json(honest).length + jsonInside(honest).length + keys(honest).length + entries(honest).length + Object.keys(rest(honest)).length;
}
console.log("after 2000 literals", warm);

for (const [name, make] of makers) {
  attempt(name + ": spread", () => spread(make()));
  attempt(name + ": spread between members", () => spreadWithMore(make()));
  attempt(name + ": keys of that", () => Object.keys(spreadWithMore(make())));
  attempt(name + ": spread, then length", () => spreadThenOverride(make()));
  attempt(name + ": the length of the spread", () => lengthOfSpread(make()));
  attempt(name + ": JSON", () => json(make()));
  attempt(name + ": JSON inside", () => jsonInside(make()));
  attempt(name + ": keys", () => keys(make()));
  attempt(name + ": entries", () => entries(make()));
  attempt(name + ": rest", () => rest(make()));
}
//// spread-rest-and-destructuring-of-a-polluted-array.ts
////= show-33

function polluted(): Dog[] {
  const dogs = [new Dog("rex"), new Dog("fido")];
  const animals: Animal[] = dogs;
  animals.splice(1, 0, new Cat("tom"));
  return dogs;
}

function honest(): Dog[] {
  return [new Dog("rex"), new Dog("max"), new Dog("fido")];
}

function legsOfAll(...dogs: Dog[]): number[] {
  return dogs.map(dog => dog.legs);
}

function legsOfThree(a: Dog, b: Dog, c: Dog): number {
  return a.legs + b.legs + c.legs;
}

function secondLegs([, second]: Dog[]): number {
  return second.legs + 1;
}

function secondLegsByPattern([, { legs }]: Dog[]): number {
  return legs + 1;
}

function secondLegsWithDefault([, { legs = -1 }]: Dog[]): number {
  return legs + 1;
}

function restLegs([, ...others]: Dog[]): number[] {
  return others.map(dog => dog.legs);
}

function copied(dogs: Dog[]): number {
  const copy = [...dogs];
  return copy[1].legs + 1;
}

function copiedElement(dogs: Dog[]): Dog {
  return { ...dogs[1], bark: dogs[1].bark };
}

function tagsByForOf(dogs: Dog[]): string[] {
  const tags: string[] = [];
  for (const { tag, owner } of dogs) tags.push(tag + "/" + typeof owner);
  return tags;
}

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const dogs = honest();
  const [a, b, c] = dogs;
  warm += legsOfAll(...dogs)[1] + legsOfThree(a, b, c) + secondLegs(dogs) + secondLegsByPattern(dogs) + secondLegsWithDefault(dogs);
  warm += restLegs(dogs)[0] + copied(dogs) + copiedElement(dogs).legs + tagsByForOf(dogs).length;
}
console.log("after 2000 honest arrays", warm);

for (const [name, make] of [["polluted", polluted], ["honest", honest]] satisfies [string, () => Dog[]][]) {
  attempt(name + ": spread into a rest parameter", () => legsOfAll(...make()));
  attempt(name + ": destructured, then passed", () => {
    const [a, b, c] = make();
    return legsOfThree(a, b, c);
  });
  attempt(name + ": the second by a pattern in the parameter", () => secondLegs(make()));
  attempt(name + ": its legs by a nested pattern", () => secondLegsByPattern(make()));
  attempt(name + ": its legs with a default", () => secondLegsWithDefault(make()));
  attempt(name + ": the rest", () => restLegs(make()));
  attempt(name + ": a copy by spread", () => copied(make()));
  attempt(name + ": a copy of the element", () => Object.keys(copiedElement(make())));
  attempt(name + ": the copy's legs", () => copiedElement(make()).legs + 1);
  attempt(name + ": patterns in a for-of", () => tagsByForOf(make()));
  attempt(name + ": concat", () => make().concat(make()).map(dog => dog.legs));
  attempt(name + ": slice", () => make().slice(1).map(dog => dog.legs));
  attempt(name + ": with", () => make().with(0, new Dog("new")).map(dog => dog.legs));
  attempt(name + ": toReversed", () => make().toReversed().map(dog => dog.legs));
  attempt(name + ": at", () => make().at(1)?.legs);
  attempt(name + ": pop and shift", () => {
    const dogs = make();
    dogs.pop();
    dogs.shift();
    return [dogs.pop()?.legs, dogs.length];
  });
  attempt(name + ": structuredClone", () => structuredClone(make()).map(dog => dog.legs));
  attempt(name + ": JSON", () => JSON.stringify(make()));
}
//// spreads-with-undefined-and-forgotten-members-that-never-leave-their-function.ts
////= show-10

interface Size {
  width: number;
  scale: number;
  unit: string;
}

function blankWidth(): string {
  const full: Size = { width: 2, scale: 0.5, unit: "m" };
  const change: Partial<Size> = { width: undefined };
  const merged: Size = { ...full, ...change };
  return typeof merged.width + " " + show(merged.width) + " " + show(merged.width + 1) + " " + show(merged.width * merged.scale) + " " + show(merged.width | 0) + " " + Object.keys(merged).join() + " " + JSON.stringify(merged);
}

function blankScale(): string {
  const full: Size = { width: 2, scale: 0.5, unit: "m" };
  const change: Partial<Size> = { scale: undefined };
  const merged: Size = { ...full, ...change };
  return typeof merged.scale + " " + show(merged.scale + 1) + " " + show(merged.width * merged.scale) + " " + JSON.stringify(merged);
}

function blankUnit(): string {
  const full: Size = { width: 2, scale: 0.5, unit: "m" };
  const change: Partial<Size> = { unit: undefined };
  const merged: Size = { ...full, ...change };
  let upper: string;
  try {
    upper = merged.unit.toUpperCase();
  } catch (error) {
    upper = "threw " + (error instanceof TypeError);
  }
  return typeof merged.unit + " " + show(merged.unit + "!") + " " + upper + " " + JSON.stringify(merged);
}

function forgotten(): string {
  const wide = { width: "wide", extra: true };
  const onlyExtra: { extra: boolean } = wide;
  const full = { width: 2, extra: false };
  const merged: { width: number; extra: boolean } = { ...full, ...onlyExtra };
  return typeof merged.width + " " + show(merged.width + 1) + " " + show(merged.width * 2) + " " + JSON.stringify(merged);
}

function omitted(): string {
  const full: Size = { width: 2, scale: 0.5, unit: "m" };
  const rest: Omit<Size, "width"> = full;
  const merged: { width: string; scale: number; unit: string } = { width: "text", ...rest };
  let upper: string;
  try {
    upper = merged.width.toUpperCase();
  } catch (error) {
    upper = "threw " + (error instanceof TypeError);
  }
  return typeof merged.width + " " + show(merged.width + "!") + " " + show(merged.width.length) + " " + upper + " " + JSON.stringify(merged);
}

function assigned(): string {
  const full: Size = { width: 2, scale: 0.5, unit: "m" };
  const change: Partial<Size> = { width: undefined, scale: undefined };
  Object.assign(full, change);
  return typeof full.width + " " + show(full.width + 1) + " " + show(full.scale * 2) + " " + JSON.stringify(full);
}

function restOfADestructuring(): string {
  const full: Size = { width: 2, scale: 0.5, unit: "m" };
  const narrow: { width: number } = full;
  const { width, ...rest } = narrow;
  return show(width) + " " + Object.keys(rest).join() + " " + JSON.stringify(rest);
}

function honest(i: number): number {
  const full: Size = { width: i, scale: 0.5, unit: "m" };
  const change: Partial<Size> = { width: i + 1 };
  const merged: Size = { ...full, ...change };
  return merged.width * merged.scale + merged.unit.length;
}

let total = 0;
for (let i = 0; i < 2000; i++) total += honest(i);
console.log("2000 honest rounds: " + total);
console.log("width: undefined: " + blankWidth());
console.log("scale: undefined: " + blankScale());
console.log("unit: undefined: " + blankUnit());
console.log("a forgotten member: " + forgotten());
console.log("an omitted member: " + omitted());
console.log("assigned: " + assigned());
console.log("the rest of a destructuring: " + restOfADestructuring());

