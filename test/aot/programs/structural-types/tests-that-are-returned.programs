//// the-data-of-events-and-messages-is-untyped.ts
import { EventEmitter } from "node:events";

////= Point-2

////= show-14

////= guarded-2

////= sum-8

const values: [string, unknown][] = [
  ["honest", { x: 1, y: 2 }],
  ["swapped", { y: 2, x: 1 }],
  ["texts", { x: "1", y: "2" }],
  ["partial", { x: 1 }],
  ["a list", [1, 2]],
  ["a map", new Map([["x", 1]])],
  ["bigints", { x: 1n, y: 2n }],
  ["a number", 5],
  ["a text", "xy"],
  ["null", null],
  ["undefined", undefined],
];

const lines: string[] = [];

const channel = new MessageChannel();
const received = new Promise<void>(resolve => {
  let count = 0;
  channel.port2.onmessage = event => {
    const p: Point = event.data;
    const n: number = event.data;
    lines.push("a message, " + values[count][0] + " -> " + guarded(() => [p.x, sum(p)]) + " " + guarded(() => [n + 1 === n + 1, typeof plusOne(n)]));
    if (++count === values.length) resolve();
  };
});
for (const [, value] of values) channel.port1.postMessage(value);
await received;
channel.port1.close();
channel.port2.close();

const target = new EventTarget();
let turn = 0;
target.addEventListener("custom", event => {
  if (!(event instanceof CustomEvent)) return;
  const p: Point = event.detail;
  lines.push("a custom event, " + values[turn][0] + " -> " + guarded(() => [p.x, p.y, sum(p)]));
});
for (const [, value] of values) {
  target.dispatchEvent(new CustomEvent("custom", { detail: value }));
  turn++;
}

const emitter = new EventEmitter();
function onPoint(p: Point, n: number): void {
  lines.push("an emitter, " + values[turn][0] + " -> " + guarded(() => [p.x, sum(p)]) + " " + guarded(() => [n, plusOne(n)]));
}
emitter.on("point", onPoint);
for (let i = 0; i < 2000; i++) emitter.emit("warm", { x: i, y: 1 }, i);
turn = 0;
for (const [, value] of values) {
  emitter.emit("point", value, value);
  turn++;
}
turn = 0;
emitter.emit("point");
emitter.once("once", function (this: Point, n: number) {
  lines.push("this of a listener -> " + guarded(() => [typeof this.x, this === Object(emitter), plusOne(n)]));
});
emitter.emit("once", "1");

const message = new MessageEvent("message", { data: JSON.parse("\"text\"") });
const fromEvent: Point = message.data;
lines.push("a message event made by hand -> " + guarded(() => [fromEvent.x, sum(fromEvent)]));

const failure = new ErrorEvent("error", { error: "no error object" });
const error: Error = failure.error;
lines.push("an error event -> " + guarded(() => [typeof error, error.message]) + " " + guarded(() => error.message.length));

for (const line of lines) console.log(line);
//// the-dispose-method-is-replaced-after-the-resource-was-declared.ts
const log: string[] = [];

class Resource {
  name: string;
  constructor(name: string) {
    this.name = name;
  }
  [Symbol.dispose](): void {
    log.push("class dispose " + this.name);
  }
}

class AsyncResource {
  name: string;
  constructor(name: string) {
    this.name = name;
  }
  async [Symbol.asyncDispose](): Promise<void> {
    log.push("class async dispose " + this.name);
  }
}

function line(label: string): void {
  console.log(label + ": " + log.join(", "));
  log.length = 0;
}

function plain(): void {
  using r = new Resource("a");
  log.push("body " + r.name);
}

function replacedInTheBody(): void {
  using r = new Resource("b");
  r[Symbol.dispose] = () => {
    log.push("own dispose");
  };
  log.push("body " + r.name);
}

function replacedBefore(): void {
  const made = new Resource("c");
  made[Symbol.dispose] = () => {
    log.push("own dispose, set before");
  };
  using r = made;
  log.push("body " + r.name);
}

function prototypeReplacedInTheBody(): void {
  using r = new Resource("d");
  Resource.prototype[Symbol.dispose] = function () {
    log.push("patched dispose " + this.name);
  };
  log.push("body " + r.name);
}

function two(): void {
  using first = new Resource("first");
  using second = new Resource("second");
  log.push("body " + first.name + " " + second.name);
}

async function asynchronous(): Promise<void> {
  await using r = new AsyncResource("e");
  r[Symbol.asyncDispose] = async () => {
    log.push("own async dispose");
  };
  log.push("body " + r.name);
}

const original = Resource.prototype[Symbol.dispose];

for (let i = 0; i < 2000; i++) plain();
console.log("2000 honest: " + log.length);
log.length = 0;

plain();
line("nothing replaced");
replacedInTheBody();
line("an own member appears in the body");
replacedBefore();
line("an own member from before the declaration");
prototypeReplacedInTheBody();
line("the prototype's is replaced in the body");
plain();
line("the next resource");
two();
line("two resources");
Resource.prototype[Symbol.dispose] = original;
two();
line("put back");
await asynchronous();
line("an asynchronous one");

