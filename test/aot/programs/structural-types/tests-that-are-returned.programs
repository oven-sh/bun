function inspect(list: ArrayLike<number>): string[] {
  const lines: string[] = [];
  for (let i = 0; i <= list.length; i++) lines.push(i + " " + (i in list ? "present" : "absent") + " " + typeof list[i] + " " + show(list[i]));
  return lines;
}

