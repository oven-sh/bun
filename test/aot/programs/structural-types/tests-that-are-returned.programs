//// the-first-block-of-a-namespace-uses-what-the-second-block-makes.ts
////= text-11

////= attempt-18

namespace Steps {
  export let count: number = 0;
  export function viaLater(): number {
    return later() + 1;
  }
  export function readValue(): number {
    return value;
  }
  export function readValuePlusOne(): number {
    return value + 1;
  }
  export function makeLate(): number {
    return new Late().size;
  }
  export function lateMode(): number {
    return Mode.Second;
  }
  export enum Mode {
    First,
  }
  export const atStart: string[] = [attempt(viaLater), attempt(readValue), attempt(readValuePlusOne), attempt(makeLate), attempt(lateMode)];
}

show("what the first block saw", () => Steps.atStart);
show("between the blocks", () => [attempt(Steps.viaLater), attempt(Steps.readValue), attempt(Steps.readValuePlusOne), attempt(Steps.makeLate), attempt(Steps.lateMode)]);
show("between the blocks: from outside", () => [attempt(() => Steps.value), attempt(() => Steps.later()), attempt(() => Steps.Mode.Second), typeof Steps.Late]);
show("between the blocks: keys", () => [Object.keys(Steps), Object.keys(Steps.Mode)]);

namespace Steps {
  export function later(): number {
    return count * 10;
  }
  export const value: number = 7;
  export class Late {
    size: number = 3;
  }
  export enum Mode {
    Second = 5,
  }
}

show("after both", () => [attempt(Steps.viaLater), attempt(Steps.readValue), attempt(Steps.readValuePlusOne), attempt(Steps.makeLate), attempt(Steps.lateMode)]);
show("after both: keys", () => [Object.keys(Steps), Object.keys(Steps.Mode)]);

Steps.count = 5;
show("a variable of the first block, stored from outside and read by the second", () => [Steps.count, Steps.later(), Steps.viaLater()]);

let sum = 0;
for (let i = 0; i < 2000; i++) {
  Steps.count++;
  sum += Steps.viaLater() + Steps.readValue();
}
show("2000 rounds", () => [sum, Steps.count]);
//// the-first-value-sent-to-a-generator-is-dropped.ts
////= text-4

////= lines-99	Order	id	note	string

function* orders(start: number): Generator<string, number, Order> {
  console.log("body starts with " + start);
  let ids = start;
  let count = 0;
  while (count < 3) {
    const order: Order = yield "waiting " + count;
    count++;
    console.log("order " + count + ": " + text(order) + " id " + text(order.id) + " note " + text(order.note));
    ids += order.id;
  }
  return ids;
}

function feed(list: Order[]): string[] {
  const out: string[] = [];
  const generator = orders(1000);
  for (const order of list) out.push(text(generator.next(order)));
  out.push(text(generator.next(new Order(-1, "late"))));
  return out;
}

const list = [new Order(1, "first"), new Order(2, "second"), new Order(3, "third"), new Order(4, "fourth")];
for (const line of feed(list)) console.log(line);

function* echo(): Generator<number, void, number> {
  let last = 0;
  for (;;) {
    const sent: number = yield last;
    last = sent + 1;
  }
}

const echoing = echo();
console.log("first next(41): " + text(echoing.next(41)));
console.log("second next(41): " + text(echoing.next(41)));
let answer = 0;
for (let i = 0; i < 2000; i++) {
  const step = echoing.next(i);
  if (!step.done) answer += step.value;
}
console.log("after 2000: " + answer);

function* withDefault(first: number = 7): Generator<number, number, number> {
  const sent: number = yield first;
  return first + sent;
}

const a = withDefault();
console.log(text(a.next(1)) + " " + text(a.next(2)) + " " + text(a.next(3)));
const b = withDefault(undefined);
console.log(text(b.next(1)) + " " + text(b.next(2)) + " " + text(b.next(3)));
const c = withDefault(10);
console.log(text(c.next(1)) + " " + text(c.next()) + " " + text(c.next(3)));
