//// the-key-order-of-an-instance-follows-what-its-constructor-did.ts
function listing(o: object): string {
  let walked = "";
  for (const key in o) walked += key + ",";
  return Object.keys(o).join() + " | " + walked + " | " + JSON.stringify(o) + " | " + Object.keys({ ...o }).join();
}

class FieldsAndParameters {
  first = 1;
  constructor(
    public given: number,
    readonly fixed: string,
  ) {}
  last = 2;
}

class Branching {
  declare a: number;
  declare b: number;
  declare c?: number;
  constructor(order: number) {
    if (order === 0) {
      this.a = 1;
      this.b = 2;
    } else if (order === 1) {
      this.b = 2;
      this.a = 1;
    } else {
      this.c = 3;
      this.b = 2;
      this.a = 1;
    }
  }
}

class Base {
  baseFirst = 1;
  constructor() {
    this.setup();
  }
  setup(): void {}
  baseLast = 2;
}

class Derived extends Base {
  declare early: number;
  derived = 3;
  setup(): void {
    this.early = 0;
  }
}

class StopsEarly {
  declare x: number;
  declare y: number;
  constructor(stop: boolean) {
    this.x = 1;
    if (stop) return;
    this.y = 2;
  }
}

class AddsOnTheWay {
  a = 1;
  b = (Object.assign(this, { slipped: true }), 2);
  c = 3;
}

class Looping {
  declare p: number;
  declare q: number;
  declare r: number;
  constructor(names: ("p" | "q" | "r")[]) {
    let n = 0;
    for (const name of names) this[name] = ++n;
  }
}

