export {};
//// the-only-method-replacement-where-the-prototype-is-yielded-by-a-generator.ts
////= Point-25

const five = (): number => 5;

const original = Point.prototype.norm;
const p = new Point(3, 4);

function* targets(): Generator<Target, void, unknown> {
  yield Point.prototype;
}

////= report-2

let sum = 0;
for (let i = 0; i < 2000; i++) sum += normOf(p) + p.norm() + p.twice();
console.log("2000 honest rounds: " + sum);
report("before");
for (const target of targets()) target.norm = minus;
report("replaced by a function");
for (const target of targets()) target.norm = five;
report("replaced by an arrow");
for (const target of targets()) target.norm = original;
report("put back");

export {};
//// the-only-new-parent-of-a-subclass-prototype-goes-by-another-name.ts
////= Walker-2

const { setPrototypeOf: hang } = Object;

const p = new Person();

////= report-6

let warm = 0;
for (let i = 0; i < 2000; i++) warm += moveOf(p).length + asWalker(p).length + p.above().length + (p instanceof Walker ? 1 : 0);
console.log("2000 honest rounds: " + warm);
report("before");
hang(Person.prototype, Swimmer.prototype);
report("under the swimmer");
hang(Person.prototype, Walker.prototype);
report("back under the walker");
hang(Person.prototype, Swimmer.prototype);
report("under the swimmer again");

export {};
