//// the-only-freeze-walks-down-from-a-wrapper.ts
////= Point-28

function deepFreeze(value: unknown): void {
  if (typeof value !== "object" || value === null) return;
  for (const inner of Object.values(value)) deepFreeze(inner);
  Object.freeze(value);
}

