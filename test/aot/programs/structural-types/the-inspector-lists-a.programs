const five = (): number => 5;

const original = Point.prototype.norm;
const p = new Point(3, 4);

function patch(target: Target, replacement: () => number): void {
  arguments[0].norm = arguments[1];
}

////= report-2

let sum = 0;
for (let i = 0; i < 2000; i++) sum += normOf(p) + p.norm() + p.twice();
console.log("2000 honest rounds: " + sum);
report("before");
patch(Point.prototype, minus);
report("replaced by a function");
patch(Point.prototype, five);
report("replaced by an arrow");
patch(Point.prototype, original);
report("put back");

export {};
//// the-only-method-replacement-where-the-prototype-is-the-cause-of-an-error.ts
////= Point-25

const five = (): number => 5;

const original = Point.prototype.norm;
const p = new Point(3, 4);

const carrier = new Error("carrier", { cause: Point.prototype });

function patch(replacement: () => number): void {
  const cause = carrier.cause;
  if (typeof cause === "object" && cause !== null && "norm" in cause) cause.norm = replacement;
}

////= report-2

let sum = 0;
for (let i = 0; i < 2000; i++) sum += normOf(p) + p.norm() + p.twice();
console.log("2000 honest rounds: " + sum);
report("before");
patch(minus);
report("replaced by a function");
patch(five);
report("replaced by an arrow");
patch(original);
report("put back");

export {};
//// the-only-method-replacement-where-the-prototype-is-the-result-of-a-getter.ts
////= Point-25

const five = (): number => 5;

const original = Point.prototype.norm;
const p = new Point(3, 4);

const holder = {
  get target(): Target {
    return Point.prototype;
  },
};

////= report-2

let sum = 0;
for (let i = 0; i < 2000; i++) sum += normOf(p) + p.norm() + p.twice();
console.log("2000 honest rounds: " + sum);
report("before");
holder.target.norm = minus;
report("replaced by a function");
holder.target.norm = five;
report("replaced by an arrow");
holder.target.norm = original;
report("put back");

export {};
