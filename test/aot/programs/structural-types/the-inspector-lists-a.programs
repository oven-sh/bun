});
attempt("a frozen length", () => {
  const numbers = [1, 2, 3];
  Object.defineProperty(numbers, "length", { writable: false });
  const results: unknown[] = [];
  for (const change of [() => numbers.push(4), () => numbers.pop(), () => setLength(numbers, 1), () => (numbers[5] = 1), () => (numbers[0] = 10)]) {
    try {
      results.push(change());
    } catch (error) {
      results.push(error instanceof Error ? error.constructor.name : "?");
    }
  }
  return [results, inspect(numbers)];
});
//// the-length-of-an-open-tuple-is-stored-to.ts
////= show-32

type Open = [number, ...string[]];
type Optional = [number, string?];
type Tail = [...number[], string];

////= lines-260	head	tuple	Open	tuple[0

function names(tuple: Open): string {
  const [, ...rest] = tuple;
  return rest.map(name => name.toUpperCase()).join();
}

function headOfOptional(tuple: Optional): number {
  return tuple[0] * 2;
}

function last(tuple: Tail): string {
  const [...all] = tuple;
  return typeof all[all.length - 1];
}

let total = 0;
for (let i = 0; i < 2000; i++) total += head([i, "a", "b"]) + names([i, "a"]).length + headOfOptional([i]) + last([i, "z"]).length;
console.log("2000 honest rounds: " + total);

