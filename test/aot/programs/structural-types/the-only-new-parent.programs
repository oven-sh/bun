//// the-tag-of-a-union-is-stored-through-an-alias-after-narrowing.ts
////= show-4

const log: string[] = [];

////= attempt-2

type Shape = { kind: "circle"; radius: number } | { kind: "square"; side: number };
type Tagged = { kind: "circle" | "square" };

////= area-2

////= lines-221	circle	Shape	kind	"circle"	radius	2

////= lines-221	square	Shape	kind	"square"	side	3

function retag(t: Tagged): void {
  t.kind = t.kind === "circle" ? "square" : "circle";
}

function inALocal(change: boolean): string {
  const s = circle();
  if (s.kind === "circle") {
    if (change) retag(s);
    return s.kind + ":" + s.radius + ":" + area(s);
  }
  return "not a circle";
}

function inAParameter(s: Shape, change: boolean): string {
  if (s.kind === "circle") {
    const alias: Tagged = s;
    if (change) alias.kind = "square";
    return s.kind + ":" + s.radius + ":" + area(s);
  }
  return s.kind + ":" + s.side + ":" + area(s);
}

function made(change: boolean): Shape {
  const s = square();
  if (change) retag(s);
  return s;
}

class Holder {
  shape: Shape = { kind: "circle", radius: 2 };
  read(change: boolean): string {
    if (this.shape.kind === "circle") {
      if (change) retag(this.shape);
      return this.shape.kind + ":" + this.shape.radius + ":" + area(this.shape);
    }
    return "not a circle";
  }
}

function inAnElement(shapes: Shape[], change: boolean): string {
  const first = shapes[0];
  if (first.kind === "circle") {
    if (change) retag(shapes[0]);
    return first.kind + ":" + first.radius + ":" + area(first) + ":" + shapes.map(area).join();
  }
  return "not a circle";
}

function captured(change: boolean): string {
  const s = circle();
  const flip = () => retag(s);
  const read = () => (s.kind === "circle" ? "circle " + s.radius : "square " + s.side);
  const before = read();
  if (change) flip();
  return before + " then " + read() + " area " + area(s);
}

function everything(label: string, change: boolean): void {
  attempt(label + " local", () => inALocal(change));
  attempt(label + " parameter", () => inAParameter({ kind: "circle", radius: 2 }, change));
  attempt(label + " result", () => area(made(change)));
  attempt(label + " result kind", () => {
    const s = made(change);
    return s.kind === "square" ? s.side + 1 : s.radius + 1;
  });
  attempt(label + " field", () => new Holder().read(change));
  attempt(label + " element", () => inAnElement([{ kind: "circle", radius: 2 }, { kind: "square", side: 2 }], change));
  attempt(label + " captured", () => captured(change));
}

everything("honest", false);
let warm = 0;
for (let i = 0; i < 2000; i++) warm += area(i & 1 ? { kind: "circle", radius: i } : { kind: "square", side: 2 }) + inAParameter({ kind: "circle", radius: i }, false).length + inALocal(false).length;
console.log("2000 honest rounds", warm);
everything("retagged", true);
everything("honest again", false);

attempt("in a loop", () => {
  const s = circle();
  const results: number[] = [];
  for (let i = 0; i < 6; i++) {
    if (i === 3) retag(s);
    results.push(area(s));
  }
  return results;
});
attempt("a tag outside the union", () => {
  const s = circle();
  const open: { kind: string } = s;
  open.kind = "triangle";
  return [area(s), typeof area(s), area(s) + 1];
});
attempt("a tag outside the union, after narrowing away one member", () => {
  const s = circle();
  const open: { kind: string } = s;
  open.kind = "triangle";
  if (s.kind === "circle") return "circle";
  return s.kind + ":" + s.side;
});
attempt("the tag is stored with no alias at all", () => {
  const set = (p: Shape) => {
    p.kind = "square";
  };
  const s = circle();
  set(s);
  return [area(s), JSON.stringify(s)];
});
//// the-tags-of-a-union-stand-in-constant-literals-and-change-later.ts
// Objects of a union whose tags are texts, written as constant literals: the tag is told from the other tags, until somebody stores another text, another kind of value, or deletes it, behind the checker's back.
const lines: string[] = [];
function say(label: string, value: unknown): void {
  lines.push(label + ": " + String(value));
}
type Shape = { kind: "circle"; r: number } | { kind: "square"; w: number } | { kind: "dot" };
const shapes: Shape[] = [{ kind: "circle", r: 2 }, { kind: "square", w: 3 }, { kind: "dot" }];
function area(s: Shape): number {
  if (s.kind === "circle") return s.r * s.r * 3;
  if (s.kind === "square") return s.w * s.w;
  return 0;
}
function name(s: Shape): string {
  switch (s.kind) {
    case "circle":
      return "c" + s.r;
    case "square":
      return "s" + s.w;
    case "dot":
      return "d";
    default:
      return "other " + typeof (s as { kind: unknown }).kind + " " + String((s as { kind: unknown }).kind);
  }
}
function all(): string {
  let text = "";
  for (const s of shapes) text += area(s) + name(s) + s.kind.length + ";";
  return text;
}
const nested = { outer: { kind: "circle", r: 1 } as Shape, label: "fixed", list: ["circle", "square", "kind"] };
function inner(): string {
  return name(nested.outer) + nested.label + nested.list.join() + nested.list.includes(nested.outer.kind) + (nested.label === "fixed");
}
const table = { circle: "round", square: "flat", dot: "small" } as const;
function look(s: Shape): string {
  return table[s.kind] + (table.circle === "round") + Object.values(table).join();
}
function attempt(f: () => unknown): string {
  try {
    return String(f());
  } catch (error) {
    return (error as Error).constructor.name;
  }
}
let last = "";
for (let turn = 0; turn < 60; turn++) last = all() + inner() + look(shapes[turn % 3]!);
say("before", last);
(shapes[0] as { kind: string }).kind = "square";
say("another tag of the union", attempt(all));
(shapes[1] as { kind: string }).kind = "hexagon";
say("a text that is no tag", attempt(all));
(shapes[2] as unknown as { kind: number }).kind = 7;
say("a number", attempt(all));
delete (shapes[0] as { kind?: string }).kind;
say("deleted", attempt(all));
Object.defineProperty(shapes[1], "kind", { get: () => "circle", configurable: true });
say("a getter", attempt(all));
(nested.outer as { kind: string }).kind = ["d", "ot"].join("");
say("a text made at run time", attempt(inner));
(nested as { label: string }).label = "fix" + "ed".slice(0);
say("the same text made anew", attempt(inner));
Object.assign(nested, { label: 5 });
say("assigned by a built-in", attempt(inner));
(table as unknown as Record<string, string>)["circle"] = "square";
say("the table", attempt(() => look({ kind: "circle", r: 1 })));
shapes.push(JSON.parse('{"kind":"circle","r":5}') as Shape, { kind: "square", w: lines.length });
say("parsed and made", attempt(all));
console.log(lines.join("\n"));
//// the-then-method-is-replaced-between-awaits.ts
const log: string[] = [];

////= Later

async function wait(l: Later): Promise<number> {
  return await l;
}

////= waitTwice

////= line

const l = new Later(1);
let warm = 0;
for (let i = 0; i < 2000; i++) warm += await wait(l);
log.length = 0;
line("2000 honest", warm);
line("the class's then", await wait(l));

const hundred: Later["then"] = (resolve, reject) => {
  log.push("own then");
  return Promise.resolve(100).then(resolve, reject);
};

line(
  "an own then appears between two awaits",
  await waitTwice(l, () => {
    l.then = hundred;
  }),
);
line("it stays", await wait(l));
line("Promise.resolve", await Promise.resolve(l));
line("Promise.all", (await Promise.all([l, new Later(2)])).join());
line("returned from an async function", await (async () => l)());
line("returned from a reaction", await Promise.resolve(0).then(() => l));
Reflect.deleteProperty(l, "then");
line("uncovered", await wait(l));

const original = Later.prototype.then;
Later.prototype.then = hundred;
line("replaced on the prototype", (await wait(l)) + " " + (await wait(new Later(5))));
Later.prototype.then = original;
line("put back", await wait(l));

const real = Promise.resolve(7);
line("a real promise", await real);
real.then = (resolve, reject) => {
  log.push("own then of a real promise");
  return Promise.resolve(700).then(resolve, reject);
};
line("with a then of its own, awaited", await real);
line("Promise.resolve gives it back", Promise.resolve(real) === real);
line("Promise.all", (await Promise.all([real])).join());
line("Promise.race", await Promise.race([real]));
line("returned from an async function", await (async () => real)());
line("returned from a reaction", await Promise.resolve(0).then(() => real));
line("called by name", await real.then(n => n + 1));
Reflect.deleteProperty(real, "then");
line("removed", await real);

