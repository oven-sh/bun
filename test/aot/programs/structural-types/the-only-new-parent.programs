//// the-receiver-changes-its-shape-between-two-calls-of-a-borrowed-method.ts
////= Owner-2

const s = new Subject();
const read = s.readCount;
const measure = s.labelLength;
const act = s.runAction;

function look(title: string, receiver: object): void {
  show(title + ": count", () => read.call(receiver));
  show(title + ": label length", () => measure.call(receiver));
  show(title + ": action", () => act.call(receiver));
}

const subject = new Subject();
look("at the start", subject);
const loose: { count?: number; label?: string; action?: () => number } = subject;
delete loose.count;
look("count deleted", subject);
subject.count = 5;
look("count set again", subject);
const wide: { label: string | number; action: (() => number) | string } = subject;
wide.label = 12;
look("a number in label", subject);
wide.action = "not a function";
look("a string in action", subject);
Object.defineProperty(subject, "count", { get: () => 77, configurable: true });
look("count is a getter", subject);
Object.setPrototypeOf(subject, null);
look("no prototype", subject);
Object.freeze(subject);
look("frozen", subject);
show("a store to the frozen one", () => s.storeLabel.call(subject));

const literal: { count: number; label?: string; action?: () => number } = { count: 1 };
look("a literal with a count", literal);
literal.label = "added";
look("a label added", literal);
literal.action = () => 9;
look("an action added", literal);
delete literal.label;
look("the label deleted", literal);

let total = 0;
const steady = new Subject();
const steadyLoose: { count?: number } = steady;
for (let i = 0; i < 2000; i++) {
  if (i === 1000) delete steadyLoose.count;
  if (i === 1500) steady.count = 1;
  const n = read.call(steady);
  total += n === undefined ? 1000 : n;
}
show("deleted and set again in the middle of a loop", () => total);
//// the-result-of-a-void-callback-is-awaited.ts
////= text-9

////= failure-2

const trail: string[] = [];

type Task = () => void;

const tasks: [string, Task][] = [
  ["returns nothing", () => {}],
  ["returns a number", () => 5],
  ["is async", async () => {
    trail.push("async task starts");
    await null;
    trail.push("async task ends");
    return "async result";
  }],
  ["returns a promise", () => Promise.resolve({ from: "promise" })],
  ["returns a thenable", () => ({
    then(resolve: (value: string) => void): void {
      trail.push("then of the task's result");
      resolve("thenable result");
    },
  })],
  ["returns a rejection", () => Promise.reject(new RangeError("task"))],
  ["returns a function", () => () => 1],
];

async function runAwaited(task: Task): Promise<string> {
  try {
    const result: void = await task();
    return text(result) + ", undefined: " + (result === undefined);
  } catch (error) {
    return failure(error);
  }
}

async function runReturned(task: Task): Promise<void> {
  return task();
}

function runStored(task: Task): string {
  const result: void = task();
  const kept: void[] = [result];
  const seen: unknown = result;
  if (seen instanceof Promise) seen.catch(() => {});
  return typeof result + ", in a list " + typeof kept[0] + ", a promise " + (seen instanceof Promise);
}

for (const [label, task] of tasks) {
  trail.length = 0;
  console.log(label + ", awaited: " + (await runAwaited(task)) + " [" + trail.join(", ") + "]");
  trail.length = 0;
  console.log(label + ", returned from an async function: " + (await runReturned(task).then(text, failure)) + " [" + trail.join(", ") + "]");
  console.log(label + ", stored: " + runStored(task));
  await null;
  await null;
}

trail.length = 0;
[1, 2, 3].forEach(async n => {
  trail.push("start " + n);
  await null;
  trail.push("end " + n);
});
trail.push("forEach is over");
await null;
await null;
console.log("forEach with an async function: " + trail.join(", "));

function onEach(items: number[], visit: (n: number) => void): void[] {
  const results: void[] = [];
  for (const n of items) results.push(visit(n));
  return results;
}
const collected = onEach([1, 2], async n => n * 2);
console.log("collected: " + collected.map(r => typeof r).join() + ", settled " + text(await Promise.all(collected)));

class Runner {
  last: void = undefined;
  hook: Task = () => {};
  async run(): Promise<string> {
    this.last = this.hook();
    const settled: void = await this.last;
    return typeof this.last + " then " + text(settled);
  }
}
const runner = new Runner();
console.log("a field, honest: " + (await runner.run()));
runner.hook = async () => 7;
console.log("a field, async: " + (await runner.run()));

export {};
