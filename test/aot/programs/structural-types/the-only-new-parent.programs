////: Counter-2
class Counter {
  static step = 2;
  static count = 0;
  static next(): number {
    this.count += this.step;
    return this.count;
  }
  static twice(): number {
    return Counter.next() + this.next();
  }
}
////: Counter-4
////= Counter-2

////= ask

////= askThrough

////= minus-2
////: ask
function ask(): number {
  return Counter.next();
}
////: askThrough
function askThrough(c: typeof Counter): number {
  return c.next();
}
////: facts-2
function facts(c: Cat): string {
  return c.speak() + " " + (c instanceof Cat) + " " + (c instanceof Robot) + " " + c.constructor.name;
}
