//// the-static-side-of-a-class-stands-for-an-object-type.ts
////= Person-5

interface Extension {
  id: number;
  title: string;
  run(a: Animal): string;
  count(): number;
}

class DogPlugin {
  static id: number = 1;
  static title: string = "dogs";
  static calls: number = 0;
  static run(d: Dog): string {
    this.calls++;
    return d.tag + " " + d.legs;
  }
  static count(): number {
    return this.calls;
  }
}

class Inherits extends DogPlugin {
  static title: string = "inherits";
}

class WithGetters {
  static get id(): number {
    return 3;
  }
  static get title(): string {
    return "getters";
  }
  static run(a: Animal): string {
    return a.name;
  }
  static count(): number {
    return -1;
  }
}

const literal: Extension = {
  id: 4,
  title: "literal",
  run(a: Animal) {
    return "literal " + a.name;
  },
  count() {
    return 0;
  },
};

const plugins: Extension[] = [DogPlugin, Inherits, WithGetters, literal];
const rex = new Dog("rex");
const tom = new Cat("tom");

function describe(p: Extension): string {
  return p.id + " " + p.title + " " + typeof p;
}
function runWith(p: Extension, a: Animal): string {
  return p.run(a);
}

for (const p of plugins) {
  show(p.title + " describe", () => describe(p));
  show(p.title + " run a dog", () => runWith(p, rex));
  show(p.title + " run a cat", () => runWith(p, tom));
  show(p.title + " count", () => p.count());
  show(p.title + " keys", () => Object.keys(p).join());
  show(p.title + " run taken off", () => {
    const run = p.run;
    return run(rex);
  });
}

const one: Extension = DogPlugin;
one.id = 10;
one.title = "renamed";
show("a store through the object type", () => DogPlugin.id + " " + DogPlugin.title);
show("the subclass sees the id", () => Inherits.id);
const sub: Extension = Inherits;
sub.id = 20;
show("a store on the subclass", () => DogPlugin.id + " " + Inherits.id + " " + Object.hasOwn(Inherits, "id"));
show("a store where there is only a getter", () => {
  const getters: Extension = WithGetters;
  getters.id = 30;
  return WithGetters.id;
});

function named(o: { name: string; length: number }): string {
  return o.name + " " + o.length;
}
show("name and length of a class", () => named(DogPlugin));
show("name and length of a function", () => named(describe));
show("name and length of an object", () => named({ name: "object", length: 9 }));

function prototypeLegs(o: { prototype: Dog }): unknown {
  return o.prototype.legs;
}
show("legs of Dog.prototype", () => prototypeLegs(Dog));
show("bark of Dog.prototype", () => Dog.prototype.bark());

let total = 0;
for (let i = 0; i < 2000; i++) total += describe(literal).length;
show("2000 literals", () => total);
show("then a class", () => describe(DogPlugin));
//// the-static-side-of-one-class-stands-in-for-another.ts
class Apple {
  static kind = "apple";
  static count = 0;
  static create(): Apple {
    Apple.count++;
    return new Apple();
  }
  static get plural(): string {
    return "apples";
  }
  taste = "sweet";
  bite(): string {
    return "crunch";
  }
}

class Lemon {
  static count = 100;
  static kind = "lemon";
  static create(): Lemon {
    Lemon.count += 10;
    return new Lemon();
  }
  static get plural(): string {
    return "lemons";
  }
  taste = "sour";
  bite(): string {
    return "wince";
  }
}

function grow(Fruit: typeof Apple): string {
  const made = new Fruit();
  const created = Fruit.create();
  return [
    Fruit.kind,
    Fruit.plural,
    Fruit.count,
    Fruit.name,
    made.taste,
    made.bite(),
    created.taste,
    made instanceof Apple,
    made instanceof Fruit,
    created instanceof Fruit,
    made.constructor === Fruit,
    Fruit === Apple,
    Fruit.prototype === Apple.prototype,
  ].join(" ");
}

function construct(Fruit: new () => Apple): string {
  const made = new Fruit();
  return made.taste + " " + made.bite() + " " + (made instanceof Apple);
}

class Orchard {
  constructor(public Fruit: typeof Apple) {}
  harvest(n: number): string {
    const basket: Apple[] = [];
    for (let i = 0; i < n; i++) basket.push(new this.Fruit());
    return basket.map(f => f.bite()).join() + " " + this.Fruit.kind;
  }
}

const Local: typeof Apple = Lemon;
console.log("local: " + Local.kind + " " + new Local().taste + " " + Local.name + " " + (new Local() instanceof Apple));
console.log("parameter, Apple: " + grow(Apple));
console.log("parameter, Lemon: " + grow(Lemon));
console.log("construct signature, Apple: " + construct(Apple));
console.log("construct signature, Lemon: " + construct(Lemon));
console.log("field, Apple: " + new Orchard(Apple).harvest(2));
console.log("field, Lemon: " + new Orchard(Lemon).harvest(2));

const classes: (typeof Apple)[] = [Apple, Lemon, Apple];
console.log("elements: " + classes.map(C => new C().bite()).join());
console.log("static through elements: " + classes.map(C => C.kind + C.count).join());

for (let i = 0; i < 2000; i++) grow(Apple);
console.log("after 2000 honest: " + grow(Lemon));
console.log("counts: " + Apple.count + " " + Lemon.count);

Local.kind = "changed";
console.log("a static stored through the alias: " + Apple.kind + " " + Lemon.kind);

////= lines-14	class	Juicy	extends	Local	juice	"yes"
const juicy = new Juicy();
console.log("a subclass of the alias: " + juicy.taste + " " + juicy.bite() + " " + (juicy instanceof Apple) + " " + (juicy instanceof Lemon));
console.log("its static side: " + Juicy.kind + " " + Juicy.plural + " " + Object.getPrototypeOf(Juicy).name);

const reflected: Apple = Reflect.construct(Apple, [], Lemon);
console.log("constructed for another target: " + reflected.taste + " " + reflected.bite() + " " + (reflected instanceof Apple) + " " + (reflected instanceof Lemon));

