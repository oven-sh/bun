//// throw-is-called-on-a-generator-with-values-of-every-kind.ts
////= text-14

function* patient(): Generator<number, string, number> {
  let total = 0;
  let caught = 0;
  for (let i = 0; i < 12; i++) {
    try {
      const sent: number = yield total;
      total += sent;
    } catch (error) {
      caught++;
      console.log("caught " + caught + ": " + (error instanceof Error ? error.constructor.name : text(error)) + ", total is still " + text(total));
    }
  }
  return "total " + total + " caught " + caught;
}

const thrown: unknown[] = [new TypeError("t"), "a string", 7, -0, undefined, null, { code: 5 }, [1, 2], true];

const g = patient();
console.log(text(g.next()));
console.log(text(g.next(5)));
for (const value of thrown) console.log("throw gives " + text(g.throw(value)));
console.log(text(g.next(6)));
console.log(text(g.next(7)));
console.log(text(g.next(8)));

function* careless(): Generator<number, string, number> {
  const sent: number = yield 1;
  console.log("careless: never printed " + sent);
  return "end";
}

for (const value of thrown) {
  const c = careless();
  c.next();
  try {
    console.log("careless gives " + text(c.throw(value)));
  } catch (error) {
    console.log("careless " + failure(error) + ", same value " + Object.is(error, value));
  }
  console.log("careless afterwards " + text(c.next(1)));
}

function* rethrows(): Generator<number, string, number> {
  try {
    yield 1;
  } catch (error) {
    throw new RangeError("wrapped", { cause: error });
  } finally {
    console.log("rethrows: finally");
  }
  return "end";
}

const r = rethrows();
r.next();
try {
  r.throw("reason");
} catch (error) {
  console.log("rethrows " + failure(error) + " cause " + (error instanceof Error ? text(error.cause) : "none"));
}

function* turnsIntoAReturn(): Generator<number, string, number> {
  try {
    yield 1;
  } catch {
    return "caught and returned";
  }
  return "end";
}

const t = turnsIntoAReturn();
t.next();
const last = t.throw(new Error("e"));
console.log("turned into a return: " + text(last) + " " + (last.done ? last.value.length : -1));
//// timers-and-next-tick-pass-operands-nobody-checks.ts
////= Point-2

////= show-9

////= guarded-2

const lines: string[] = [];
let label = "";

function takesPoint(p: Point, n: number): void {
  lines.push(label + " -> " + guarded(() => [p.x, p.x + p.y]) + " " + guarded(() => [n, n + 1, typeof n]));
}

function takesNothing(): void {
  lines.push(label + " -> " + arguments.length + " operands");
}

const loose = JSON.parse('[{"x":"1","y":2},"3"]');
const values: [string, ReturnType<typeof JSON.parse>[]][] = [
  ["honest", [{ x: 1, y: 2 }, 3]],
  ["parsed", loose],
  ["swapped", [3, { x: 1, y: 2 }]],
  ["too few", [{ x: 1, y: 2 }]],
  ["none", []],
  ["nulls", [null, null]],
];

function tick(): Promise<void> {
  return new Promise(resolve => setImmediate(resolve));
}

for (const [name, operands] of values) {
  label = "nextTick, " + name;
  process.nextTick(takesPoint, ...operands);
  await tick();
  label = "setTimeout, " + name;
  await new Promise<void>(resolve => {
    setTimeout(takesPoint, 0, ...operands);
    setTimeout(resolve, 1);
  });
  label = "setImmediate, " + name;
  setImmediate(takesPoint, ...operands);
  await tick();
  await tick();
}

label = "a timer gives a function without parameters";
await new Promise<void>(resolve => {
  setTimeout(takesNothing, 0);
  setTimeout(resolve, 1);
});
label = "queueMicrotask gives";
queueMicrotask(takesNothing);
await tick();

label = "an interval";
await new Promise<void>(resolve => {
  let count = 0;
  const timer = setInterval(
    (p: Point) => {
      lines.push(label + " " + count + " -> " + guarded(() => p.x + p.y));
      if (++count === 2) {
        clearInterval(timer);
        resolve();
      }
    },
    0,
    loose[0],
  );
});

for (const line of lines) console.log(line);

