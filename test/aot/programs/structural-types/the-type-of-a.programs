//// this-leaves-the-constructor-before-the-fields-are-set.ts
////= text-21

const registry: Widget[] = [];
const byName = new Map<string, Widget>();
let latest: Widget | undefined;
const seen: string[] = [];

function look(label: string, w: Widget): void {
  const parts: string[] = [];
  const uses: [string, () => unknown][] = [
    ["size", () => w.size],
    ["size + 1", () => w.size + 1],
    ["title", () => w.title],
    ["title.length", () => w.title.length],
    ["owner", () => w.owner],
    ["owner.first", () => w.owner.first],
    ["parts.length", () => w.parts.length],
    ["area()", () => w.area()],
    ["keys", () => Object.keys(w).join("+")],
  ];
  for (const [name, use] of uses) {
    try {
      parts.push(name + "=" + text(use()));
    } catch (error) {
      parts.push(name + "=threw " + (error instanceof Error ? error.constructor.name : typeof error));
    }
  }
  seen.push(label + ": " + parts.join(", "));
}

class Widget {
  size: number;
  title: string;
  owner: Person;
  parts: number[];
  constructor(name: string, visit: (w: Widget) => void) {
    latest = this;
    registry.push(this);
    byName.set(name, this);
    look("at the start", this);
    visit(this);
    this.size = 2;
    look("after size", this);
    this.title = name;
    this.owner = new Person();
    look("after owner", this);
    [1].forEach(() => look("in a built-in's callback", this));
    this.parts = [1, 2];
    look("at the end", this);
  }
  area(): number {
    return this.size * this.size;
  }
}

const first = new Widget("first", w => look("in the caller's callback", w));
for (const entry of seen) console.log(entry);
seen.length = 0;

show("the global is the widget", () => latest === first);
show("the collection holds it", () => registry[0] === first);
show("the map holds it", () => byName.get("first") === first);

new Widget("second", w => {
  w.size = 100;
  w.title = "set by the callback";
});
for (const entry of seen) console.log(entry);
seen.length = 0;

////= lines-20	sizeOf	w	Widget	number	return	w.size
let sum = 0;
for (let i = 0; i < 2000; i++) sum += sizeOf(first);
show("2000 finished widgets", () => sum);
let earlySize: unknown = "not run";
new Widget("third", w => {
  earlySize = sizeOf(w);
});
show("an unfinished one at the same function", () => earlySize);
//// this-of-a-typed-base-constructor-for-new-targets-that-are-not-below-it.ts
class Base {
  x: number;
  tag = 7;
  constructor(x: number) {
    this.x = x;
  }
  who(): string {
    return "base";
  }
}
////= lines-96	Unrelated	name	"u"	who	"unrelated"
class Derived extends Base {
  y = 3;
  who(): string {
    return "derived";
  }
}
class List extends Array<number> {}
class Failure extends Error {}

function describe(label: string, made: any, target: any): void {
  console.log(
    label + ":",
    "keys", Object.keys(made).join(),
    "| x", made.x, "tag", made.tag, "y", made.y,
    "| who", typeof made.who === "function" ? made.who() : typeof made.who,
    "| Base", made instanceof Base, "Derived", made instanceof Derived, "Unrelated", made instanceof Unrelated,
    "| array", Array.isArray(made),
    "| prototype is the target's", Object.getPrototypeOf(made) === target.prototype,
  );
}

function OldStyle(this: any) {}
OldStyle.prototype.who = function () {
  return "old style";
};
const bound = Base.bind(null);
const handedOut: unknown[] = [Unrelated.prototype, Derived.prototype, null, 5, Base.prototype];
let reads = 0;
const proxy: any = new Proxy(function () {}, {
  get(target, key, receiver) {
    if (key === "prototype") return handedOut[reads++ % handedOut.length];
    return Reflect.get(target, key, receiver);
  },
});

for (let round = 0; round < 3; round++) {
  describe("new", new Base(round), Base);
  describe("itself", Reflect.construct(Base, [round], Base), Base);
  describe("another class", Reflect.construct(Base, [round], Unrelated), Unrelated);
  describe("a class below", Reflect.construct(Base, [round], Derived), Derived);
  describe("the class above", Reflect.construct(Derived, [round], Base), Base);
  describe("another class, from below", Reflect.construct(Derived, [round], Unrelated), Unrelated);
  describe("a subclass of Array", Reflect.construct(Base, [round], List), List);
  describe("a subclass of Error", Reflect.construct(Base, [round], Failure), Failure);
  describe("a function", Reflect.construct(Base, [round], OldStyle), OldStyle);
  describe("Object", Reflect.construct(Base, [round], Object), Object);
  describe("Map", Reflect.construct(Base, [round], Map), Map);
  describe("a bound function", Reflect.construct(Base, [round], bound), Object);
}
for (let round = 0; round < 10; round++) {
  const made: any = Reflect.construct(round & 1 ? Derived : Base, [round], proxy);
  const parent = Object.getPrototypeOf(made);
  const name = parent === Object.prototype ? "Object" : parent.constructor.name;
  console.log("a proxy:", round, "keys", Object.keys(made).join(), "x", made.x, "tag", made.tag, "y", made.y, "prototype of", name);
}
