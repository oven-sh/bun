////: round-2
function round(label: string, m: Money): void {
  log.length = 0;
  try {
    const text = all(m);
    console.log(label + ": " + text);
  } catch (error) {
    console.log(label + ": threw " + (error instanceof Error ? error.constructor.name : typeof error));
  }
  console.log(label + ", ran: " + log.join(" "));
}
