export * from "../types/widget";
//// two-builds-of-one-package-share-one-declaration-file/packages/new/index.js
export class Widget {
  #area;
  static count = "many";
  constructor(width, height) {
    this.height = height;
    this.width = width;
    this.#area = width * height;
  }
  area() {
    return this.#area;
  }
}

export function make(width, height) {
  return new Widget(width, height);
}

export function isWidget(value) {
  return value instanceof Widget;
}
//// two-builds-of-one-package-share-one-declaration-file/packages/old/index.d.ts
export * from "../types/widget";
//// two-builds-of-one-package-share-one-declaration-file/packages/old/index.js
export function Widget(width, height) {
  this.width = width;
  this.height = height;
  Widget.count++;
}
Widget.count = 0;
Widget.prototype.area = function () {
  return this.width * this.height;
};

export function make(width, height) {
  return new Widget(width, height);
}

export function isWidget(value) {
  return value instanceof Widget;
}
