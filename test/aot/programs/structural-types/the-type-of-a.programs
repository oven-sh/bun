////: Money
class Money {
  amount: number;
  constructor(amount: number) {
    this.amount = amount;
  }
  [Symbol.toPrimitive](hint: string): string | number {
    log.push("class:" + hint);
    return hint === "string" ? "$" + this.amount : this.amount;
  }
  valueOf(): number {
    log.push("valueOf");
    return -this.amount;
  }
  toString(): string {
    log.push("toString");
    return "money " + this.amount;
  }
}
