////: Model-2
class Model {
  static table = "models";
  id = 1;
  static create(): Model {
    return new this();
  }
  static where(): string {
    return "from " + this.table + " by " + this.name;
  }
  static both(): string {
    return this.where() + " / " + this.create().describe();
  }
  describe(): string {
    return "a " + this.constructor.name + " with " + Object.keys(this).join();
  }
}
