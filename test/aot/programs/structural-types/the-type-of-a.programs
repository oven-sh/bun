function which(dog: Dog): string {
  if (dog instanceof Copy) return "the copy: " + dog.tail + " " + dog.bark();
  if (dog instanceof FromKennel) return "the kennel: " + dog.bark();
  return "neither: " + describe(dog) + " " + JSON.stringify(dog);
}

