////= Point-2

function listings(p: Point): string[] {
  const seen: string[] = [];
  for (const key in p) seen.push(key);
  return [
    "keys " + Object.keys(p).join(),
    "for-in " + seen.join(),
    "json " + JSON.stringify(p),
    "spread " + JSON.stringify({ ...p }),
    "entries " + Object.entries(p).join("|"),
    "values " + Object.values(p).join(),
    "assign " + JSON.stringify(Object.assign({}, p)),
    "names " + Object.getOwnPropertyNames(p).join(),
    "own keys " + Reflect.ownKeys(p).map(String).join(),
    "clone " + JSON.stringify(structuredClone(p)),
    "descriptors " + Object.keys(Object.getOwnPropertyDescriptors(p)).join(),
  ];
}

function print(label: string, p: Point): void {
  for (const line of listings(p)) console.log(label + ": " + line);
}

class Holder {
  constructor(public point: Point) {}
  keys(): string {
    return Object.keys(this.point).join();
  }
  json(): string {
    return JSON.stringify(this.point);
  }
  copy(): Point {
    return { ...this.point };
  }
}

function make(flipped: boolean): Point {
  return flipped ? { y: 20, x: 10 } : { x: 1, y: 2 };
}

const xy: Point = { x: 1, y: 2 };
const yx: Point = { y: 20, x: 10 };
const withExtras = { z: 300, y: 200, w: 400, x: 100 };
const narrowed: Point = withExtras;

print("x then y", xy);
print("y then x", yx);
print("z y w x", narrowed);
print("result, x then y", make(false));
print("result, y then x", make(true));

console.log("local keys: " + Object.keys(yx).join());
console.log("local json: " + JSON.stringify(yx));
console.log("local spread: " + JSON.stringify({ ...yx }));

for (const p of [xy, yx, narrowed]) {
  const holder = new Holder(p);
  console.log("field keys: " + holder.keys());
  console.log("field json: " + holder.json());
  console.log("field copy: " + JSON.stringify(holder.copy()));
  const captured = () => Object.keys(p).join() + " " + JSON.stringify(p);
  console.log("captured: " + captured());
}

const zero = { x: 0 };
const list: Point[] = [xy, yx, narrowed, make(true), make(false)];
console.log("array json: " + JSON.stringify(list));
console.log("array keys: " + list.map(p => Object.keys(p).join("")).join());
console.log("array copies: " + JSON.stringify(list.map(p => ({ ...p }))));
console.log("array with a member replaced: " + JSON.stringify(list.map(p => ({ ...p, x: 0 }))));
console.log("array with a member first: " + JSON.stringify(list.map(p => ({ ...zero, ...p }))));
//// two-layers-of-proxies-log-in-order.ts
////= show-38

const log: string[] = [];

////= logged

function layer(name: string, target: Vec): Vec {
  return new Proxy(target, {
    get: (inner, key, receiver) => (log.push(name + ".get:" + String(key)), Reflect.get(inner, key, receiver)),
    set: (inner, key, value, receiver) => (log.push(name + ".set:" + String(key)), Reflect.set(inner, key, value, receiver)),
    has: (inner, key) => (log.push(name + ".has:" + String(key)), Reflect.has(inner, key)),
    defineProperty: (inner, key, descriptor) => (log.push(name + ".define:" + String(key)), Reflect.defineProperty(inner, key, descriptor)),
    getOwnPropertyDescriptor: (inner, key) => (log.push(name + ".describe:" + String(key)), Reflect.getOwnPropertyDescriptor(inner, key)),
    ownKeys: inner => (log.push(name + ".ownKeys"), Reflect.ownKeys(inner)),
    getPrototypeOf: inner => (log.push(name + ".getPrototypeOf"), Reflect.getPrototypeOf(inner)),
    deleteProperty: (inner, key) => (log.push(name + ".delete:" + String(key)), Reflect.deleteProperty(inner, key)),
  });
}

function twice(): Vec {
  return layer("outer", layer("inner", new Vec(3, 4)));
}

const uses: [string, (v: Vec) => unknown][] = [
  ["x + y", v => v.x + v.y],
  ["x = 9", v => (v.x = 9)],
  ["x++", v => v.x++],
  ["norm()", v => v.norm()],
  ["the getter", v => v.sum],
  ["the setter", v => {
    v.sum = 7;
    return [v.x, v.y];
  }],
  ["in", v => "x" in v],
  ["instanceof", v => v instanceof Vec],
  ["keys", v => Object.keys(v)],
  ["delete", v => Reflect.deleteProperty(v, "name")],
  ["JSON", v => JSON.stringify(v)],
];
for (const [, use] of uses) for (let i = 0; i < 500; i++) use(new Vec(3, 4));
console.log("after 500 honest vectors at every use");

for (const [name, use] of uses) logged(name, () => use(twice()));
logged("ten layers", () => {
  let v = new Vec(3, 4);
  for (let depth = 0; depth < 10; depth++) v = new Proxy(v, { get: (inner, key, receiver) => (log.push(String(depth)), Reflect.get(inner, key, receiver)) });
  return v.x;
});
logged("the inner layer is revoked", () => {
  const inner = Proxy.revocable(new Vec(3, 4), {});
  const outer = layer("outer", inner.proxy);
  const before = outer.x;
  inner.revoke();
  return [before, outer.x];
});
//// two-members-of-a-union-share-one-tag.ts
////= show-4

const log: string[] = [];

////= attempt-2

type Signal = { type: "key"; code: number } | { type: "key"; name: string } | { type: "click"; x: number; y: number };

function describe(s: Signal): string {
  if (s.type === "key") {
    if ("code" in s) return "code " + (s.code + 1);
    return "name " + s.name.toUpperCase();
  }
  return "click " + (s.x + s.y);
}

function weight(s: Signal): number {
  switch (s.type) {
    case "key":
      return "name" in s ? s.name.length : s.code;
    case "click":
      return s.x * s.y;
  }
}

function both(): { type: "key"; code: number; name: string } {
  return { type: "key", code: 1, name: "one" };
}

const signals: Signal[] = [{ type: "key", code: 65 }, { type: "key", name: "enter" }, { type: "click", x: 2, y: 3 }, both()];

for (const s of signals) {
  attempt("describe " + JSON.stringify(s), () => describe(s));
  attempt("weight " + JSON.stringify(s), () => weight(s));
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += weight(signals[i % 3]) + describe(signals[i % 3]).length;
console.log("2000 honest rounds", warm);

attempt("a name member that also has a code of another type", () => {
  const odd: { type: "key"; name: string; code: string } = { type: "key", name: "odd", code: "not a number" };
  const named: { type: "key"; name: string } = odd;
  return describe(named);
});
attempt("a code member that also has a name of another type", () => {
  const odd: { type: "key"; code: number; name: number } = { type: "key", code: 7, name: 8 };
  const coded: { type: "key"; code: number } = odd;
  return weight(coded);
});
attempt("a code that is inherited", () => {
  class Base {
    code = 5;
  }
  class Key extends Base {
    type: "key" = "key";
  }
  return describe(new Key()) + "/" + weight(new Key());
});
attempt("a code on the prototype", () => {
  class Key {
    type: "key" = "key";
    get code(): number {
      log.push("get-code");
      return 9;
    }
  }
  return describe(new Key()) + "/" + weight(new Key());
});
attempt("a code that is present and undefined", () => {
  const partial: { type: "key"; name: string; code?: undefined } = { type: "key", name: "n", code: undefined };
  return describe(partial);
});
attempt("the code is deleted between the test and the read", () => {
  const s: { type: "key"; code?: number; name: string } = { type: "key", code: 1, name: "n" };
  const view: { type: "key"; name: string } = s;
  const seen: Signal = view;
  const first = describe(seen);
  delete s.code;
  return first + "/" + describe(seen);
});
for (const s of signals) attempt("honest again " + JSON.stringify(s), () => describe(s) + "/" + weight(s));
//// two-parameters-of-different-types-are-the-same-object.ts
////= lines-28	Narrow	x	number

////= lines-27	Wide	x	number	y	number

////= lines-203	interface	Fixed	readonly	x

interface Maybe {
  x?: number;
}

////= lines-48	A	x	1	y	2

////= lines-48	B	y	20	x	10

////= lines-189	narrowAndWide	Narrow	Wide	x

////= lines-189	fixedAndNarrow	Fixed	Narrow	x

function twoClasses(a: A, b: B): string {
  const before = a.x;
  b.x = before + 100;
  const between = a.x;
  a.y = -1;
  return before + " " + between + " " + b.y;
}

////= lines-189	classAndInterface	A	Wide	y

function fullAndMaybe(a: Narrow, b: Maybe): string {
  const before = a.x;
  delete b.x;
  return before + " " + a.x + " " + ("x" in a);
}

function loopOverTwoViews(a: Fixed, b: Narrow): number {
  let sum = 0;
  for (let i = 0; i < 2000; i++) {
    sum += a.x;
    b.x++;
  }
  return sum;
}

function loopOverTwoClasses(a: A, b: B): number {
  let sum = 0;
  for (let i = 0; i < 2000; i++) {
    sum += a.x;
    b.x += 2;
  }
  return sum;
}

function elementAndParameter(list: Narrow[], b: Wide): string {
  const before = list[0].x;
  b.x = before + 100;
  return before + " " + list[0].x;
}

class Holder {
  constructor(public inner: A) {}
  fieldAndParameter(b: B): string {
    const before = this.inner.x;
    b.x = before + 100;
    return before + " " + this.inner.x;
  }
}

function apart(): void {
  console.log("two objects, narrow and wide: " + narrowAndWide({ x: 1 }, { x: 2, y: 3 }));
  console.log("two objects, fixed and narrow: " + fixedAndNarrow({ x: 1 }, { x: 2 }));
  console.log("two objects, two classes: " + twoClasses(new A(), new B()));
  console.log("two objects, class and interface: " + classAndInterface(new A(), { x: 0, y: 0 }));
  console.log("two objects, full and maybe: " + fullAndMaybe({ x: 1 }, { x: 2 }));
  console.log("two objects, a loop: " + loopOverTwoViews({ x: 1 }, { x: 1 }));
  console.log("two objects, a loop over classes: " + loopOverTwoClasses(new A(), new B()));
}

for (let i = 0; i < 500; i++) {
  narrowAndWide({ x: 1 }, { x: 2, y: 3 });
  twoClasses(new A(), new B());
}
apart();

const literal = { x: 1, y: 2 };
console.log("one literal, narrow and wide: " + narrowAndWide(literal, literal));
console.log("one literal, fixed and narrow: " + fixedAndNarrow(literal, literal));
console.log("one literal, two classes: " + twoClasses(literal, literal));
console.log("one literal, full and maybe: " + fullAndMaybe(literal, literal));

const a = new A();
console.log("one A, two classes: " + twoClasses(a, a));
console.log("one A, class and interface: " + classAndInterface(a, a));
console.log("one A, narrow and wide: " + narrowAndWide(a, a));
console.log("one A, a loop: " + loopOverTwoViews(a, a));
console.log("one A, a loop over classes: " + loopOverTwoClasses(a, a));

const b = new B();
console.log("one B, two classes: " + twoClasses(b, b));
console.log("one B, class and interface: " + classAndInterface(b, b));
console.log("one B, a loop over classes: " + loopOverTwoClasses(b, b));
console.log("one B, element and parameter: " + elementAndParameter([b], b));
console.log("one B, field and parameter: " + new Holder(b).fieldAndParameter(b));
console.log("one A, field and parameter: " + new Holder(a).fieldAndParameter(a));

apart();

export {};
//// two-subclasses-hang-under-one-new-link-and-one-runs-the-method-of-the-other.ts
////= First

