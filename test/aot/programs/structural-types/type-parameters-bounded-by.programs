//// what-is-left-after-every-member-of-an-enum-is-asked-what-it-is.ts
////= Color

function rest(color: Color): string {
  if (color === Color.Red) return "red";
  if (color === Color.Green) return "green";
  const left: never = color;
  return typeof left + " " + String(left) + " " + (left === undefined) + " " + (left === null) + " " + (typeof left === "number");
}

const numbers: number[] = [0, 1, 2, 0.5, -1];
for (const n of numbers) console.log(rest(n));
const nan: number = NaN;
console.log(rest(nan));
//// what-is-left-after-every-member-of-an-enum-is-compared-with-undefined.ts
////= Color
function rest(color: Color): string {
  if (color === Color.Red) return "red";
  if (color === Color.Green) return "green";
  return "is " + (color === undefined);
}
const two: number = 2;
console.log(rest(two));
//// what-is-left-after-every-member-of-an-enum-is-kept-in-a-list.ts
////= Color
function rest(color: Color): string {
  if (color === Color.Red) return "red";
  if (color === Color.Green) return "green";
  const kept: Color[] = [color];
  return "kept " + kept.length + " " + kept[0] + " " + (kept[0] === color) + " " + JSON.stringify({ color });
}
const two: number = 2;
console.log(rest(two));
