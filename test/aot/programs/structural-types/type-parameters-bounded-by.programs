//// what-arrives-through-a-message-channel-is-used-as-a-point.ts
////= show-41

function sent(source: Point): Promise<Point> {
  return new Promise(resolve => {
    const { port1, port2 } = new MessageChannel();
    port2.onmessage = event => {
      port1.close();
      port2.close();
      resolve(event.data);
    };
    port1.postMessage(source);
  });
}

