import type { int32 } from "bun";

////= show-34

let warm = 0;
for (let i = 0; i < 2000; i++) warm += uses(i | 0).length + uses(-i | 0).length;
console.log("4000 honest uses", warm);

const odd: number[] = JSON.parse("[1.5, -0, 2147483648, -2147483649, 1e21, 3]");
odd.push(NaN, Infinity);

function fromInt32(list: Int32Array, index: int32): int32 {
  return list[index];
}
function fromInt16(list: Int16Array, index: int32): int32 {
  return list[index];
}
function fromInt8(list: Int8Array, index: int32): int32 {
  return list[index];
}
function fromUint8(list: Uint8Array, index: int32): int32 {
  return list[index];
}
function fromUint16(list: Uint16Array, index: int32): int32 {
  return list[index];
}
function fromClamped(list: Uint8ClampedArray, index: int32): int32 {
  return list[index];
}
function sum(list: Int32Array, count: int32): int32 {
  let total: int32 = 0;
  for (let i: int32 = 0; i < count; i++) total = (total + list[i]) | 0;
  return total;
}
function plainSum(list: Int32Array, count: int32): number {
  let total = 0;
  for (let i: int32 = 0; i < count; i++) total += list[i];
  return total;
}

const ints = new Int32Array([1, -2, 2147483647]);
let rounds = 0;
for (let i = 0; i < 2000; i++) rounds += fromInt32(ints, (i % 3) | 0) + sum(ints, 2);
console.log("2000 honest rounds", rounds);

const places: int32[] = [3, -1, 1000, 2147483647, -2147483648];
for (const index of places) {
  attempt("Int32Array at " + index, () => uses(fromInt32(ints, index)));
  attempt("Int16Array at " + index, () => uses(fromInt16(new Int16Array(3), index)));
  attempt("Int8Array at " + index, () => uses(fromInt8(new Int8Array(3), index)));
  attempt("Uint8Array at " + index, () => uses(fromUint8(new Uint8Array(3), index)));
  attempt("Uint16Array at " + index, () => uses(fromUint16(new Uint16Array(3), index)));
  attempt("Uint8ClampedArray at " + index, () => uses(fromClamped(new Uint8ClampedArray(3), index)));
}
attempt("summed past the end", () => [sum(ints, 5), plainSum(ints, 5)]);
attempt("of an empty array", () => uses(fromInt32(new Int32Array(0), 0)));
attempt("after the buffer was handed over", () => {
  const list = new Int32Array([5, 6]);
  const moved = list.buffer.transfer();
  return [moved.byteLength, list.length, uses(fromInt32(list, 0))];
});
attempt("after the buffer shrank", () => {
  const buffer = new ArrayBuffer(8, { maxByteLength: 16 });
  const list = new Int32Array(buffer);
  list[1] = 9;
  const before = fromInt32(list, 1);
  buffer.resize(4);
  return [before, list.length, uses(fromInt32(list, 1))];
});
attempt("a Buffer", () => uses(fromUint8(Buffer.from([1, 2]), 2)));
attempt("honest again", () => [fromInt32(ints, 2), sum(ints, 3)]);
//// typed-callbacks-of-replace-get-groups-where-they-expect-numbers.ts
////= show-9

////= attempt-4

const seen: string[] = [];

function atOffset(whole: string, offset: number): string {
  seen.push(typeof offset + " " + show(offset) + " " + show(offset + 1) + " " + show(offset * 2));
  return "<" + (offset + 1) + ">";
}

function offsetAndText(whole: string, offset: number, text: string): string {
  seen.push(typeof offset + " " + typeof text + " " + show(text.length) + " " + show(offset | 0));
  return whole.toUpperCase();
}

function withGroups(whole: string, first: string, offset: number, text: string, groups: { year: string }): string {
  seen.push([typeof first, typeof offset, typeof text, typeof groups].join(" "));
  return groups.year + "/" + (offset + 1);
}

function indexed(whole: string, offset: number): string {
  return "abcdef"[offset] + [10, 20, 30][offset];
}

function run(label: string, replace: () => string): void {
  seen.length = 0;
  attempt(label, replace);
  console.log("  saw: " + seen.join(" ; "));
}

let warm = "";
for (let i = 0; i < 2000; i++) warm = "a-b".replace("-", atOffset) + "a-b".replace(/-/, offsetAndText) + "a-b".replace(/-/g, indexed);
console.log("2000 honest rounds: " + warm);

run("no group: the second operand is the offset", () => "a-b-c".replace(/-/g, atOffset));
run("one group: the second operand is the group", () => "a-b-c".replace(/(-)/g, atOffset));
run("a group of digits", () => "a1b22c".replace(/(\d+)/g, atOffset));
run("a group that took no part", () => "ab".replace(/(x)?b/, atOffset));
run("two groups", () => "k=v".replace(/(\w)=(\w)/, atOffset));
run("offset and text, no group", () => "a-b".replace(/-/, offsetAndText));
run("offset and text, one group", () => "a-b".replace(/(-)/, offsetAndText));
run("offset and text, a group that took no part", () => "a-b".replace(/(x)?-/, offsetAndText));
run("offset and text, two groups", () => "a-b".replace(/(a)(-)/, offsetAndText));
run("named groups, as declared", () => "in 2024".replace(/(?<year>\d+)/, withGroups));
run("named groups, none in the pattern", () => "in 2024".replace(/(\d+)/, withGroups));
run("named groups, another name", () => "in 2024".replace(/(?<month>\d+)/, withGroups));
run("named groups, one group more", () => "in 2024".replace(/(?<year>\d)(\d+)/, withGroups));
run("an index, no group", () => "a-b".replace(/-/, indexed));
run("an index, a group of digits", () => "a2b".replace(/(\d)/, indexed));
run("an index, a group of letters", () => "a2b".replace(/([a-z])/g, indexed));
run("a text pattern", () => "a-b".replace("-", atOffset));

seen.length = 0;
attempt("replaceAll", () => "a1b2".replaceAll(/(\d)/g, atOffset));
console.log("  saw: " + seen.join(" ; "));

seen.length = 0;
attempt("an object with its own replace method", () =>
  "text".replace(
    {
      [Symbol.replace](text: string, replacer: (whole: string, ...rest: never[]) => string): string {
        return Reflect.apply(replacer, undefined, [text, { valueOf: () => 4 }, null]);
      },
    },
    atOffset,
  ),
);
console.log("  saw: " + seen.join(" ; "));

console.log("honest again: " + "a-b".replace("-", atOffset) + "a-b".replace(/-/, offsetAndText));

