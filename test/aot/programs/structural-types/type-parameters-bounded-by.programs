function get(name: string) {
  switch (turn++ % 4) {
    case 0:
      return lookUp(name);
    case 1:
      return lookUp.call(undefined, name);
    case 2:
      return lookUp.apply(undefined, [name]);
    default:
      return lookUp.bind(undefined, name)();
  }
}
