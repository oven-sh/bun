//// an-object-literal-the-key-is-not-known-where-it-is-used.ts
// An interface declares fields under symbols, and an object literal with computed keys fills them. A function gets the key as a value of type symbol, or as anything. It reads and stores the same fields as code that names the symbol.
export {};

const kMass = Symbol("mass");
const kLabel = Symbol("label");
const kNote = Symbol("note");

////= Body-5

const world: Body[] = [make(1, "a"), make(2, "bb"), make(3, "ccc"), make(4, "d")];
console.log(measure(world), keysOf(world[0]));
const first: any = world[0];
function readBy(object: any, key: any): unknown {
  return object[key];
}
function storeBy(object: any, key: symbol | string, value: unknown): void {
  object[key] = value;
}
const keys: (symbol | string)[] = [kMass, "plain", kLabel, kNote, Symbol("mass"), "mass", Symbol.iterator];
const seen: unknown[] = [];
for (let round = 0; round < 50; round++)
  for (const key of keys) seen[keys.indexOf(key)] = readBy(world[round % 4], key);
console.log(seen.map(String).join());
for (const key of keys) storeBy(world[0], key, 12);
console.log(world[0][kMass], world[0][kLabel], world[0][kNote], keysOf(world[0]), measure(world.slice(1)));
////= console-log-2
//// an-object-without-a-prototype.ts
// An object literal with `__proto__: null` and one made by Object.create(null) hold properties under the symbol.
export {};

const kMass = Symbol("mass");
interface Bare {
  [kMass]: number;
}
const literal: Bare = { __proto__: null, [kMass]: 1 } as Bare;
const created: Bare = Object.create(null);
created[kMass] = 2;
function read(bare: Bare): number {
  return bare[kMass];
}
let total = 0;
for (let round = 0; round < 300; round++) total += read(literal) * 10 + read(created);
console.log(
  total,
  Object.getPrototypeOf(literal),
  Reflect.ownKeys(literal).length,
  Reflect.ownKeys(created).length,
  kMass in literal,
);
//// one-place-in-the-text-makes-several-symbols.js
// One `Symbol()` in the text runs several times: in a function called twice, in a factory of objects, in a factory of classes, in a recursion, in a generator. Each symbol names a property of its own. Symbol.for gives one symbol however its text is put together.
function mk() { return Symbol("k"); }
const a = mk(), b = mk();
const o = {}; o[a] = 1; o[b] = 2;
console.log(o[a], o[b], a === b, Object.getOwnPropertySymbols(o).length);
function box(v) { const s = Symbol("slot"); const r = { [s]: v, get() { return this[s]; }, key: s }; return r; }
const x = box(1), y = box(2);
console.log(x.get(), y.get(), x[y.key], y[x.key], x.get.call(y), y.get.call(x));
x[y.key] = 9; console.log(x.get(), x[y.key], Object.getOwnPropertySymbols(x).length);
class C { static make() { const t = Symbol("t"); return class { constructor() { this[t] = 1; } has(o) { return t in o; } }; } }
const K1 = C.make(), K2 = C.make(); const k1 = new K1(), k2 = new K2();
console.log(k1.has(k1), k1.has(k2), k2.has(k1), k2.has(k2));
const once = Symbol("once"); const p = { [once]: 5 }; function rd(q) { return q[once]; }
console.log(rd(p), rd({ [Symbol("once")]: 6 }), rd({}), rd({ [once]: 7 }));
function rec(n, acc) { const s = Symbol("r"); acc[s] = n; return n ? rec(n - 1, acc) : acc; }
console.log(Object.getOwnPropertySymbols(rec(3, {})).length);
function* g() { const s = Symbol("g"); yield s; } const s1 = g().next().value, s2 = g().next().value; const h = { [s1]: 1 }; console.log(h[s1], h[s2]);
const kA = Symbol.for("shared"), kB = Symbol.for("sha" + "red"), kC = Symbol.for(["shared"][0]); const z = { [kA]: 1 }; console.log(z[kB], z[kC], kA === kC, Symbol.keyFor(kB));
let t = 0; for (let i = 0; i < 10000; i++) { const u = box(i); t += u.get() + (u[x.key] === undefined ? 1 : 0); } console.log(t);
//// one-symbol-names-fields-of-unrelated-classes.ts
// Three classes that have nothing else in common have a field under the same symbol, at different places among their fields. One function reads all of them.
export {};

const kSize = Symbol("size");
class Front {
  [kSize]: number;
  a = 1;
  b = 2;
  constructor(size: number) {
    this[kSize] = size;
  }
}
class Back {
  a = "a";
  b = "b";
  c = "c";
  [kSize]: number;
  constructor(size: number) {
    this[kSize] = size;
  }
}
class Text {
  [kSize]: string;
  constructor(size: string) {
    this[kSize] = size;
  }
}
function sizeOf(object: Front | Back | Text | { [kSize]: boolean }): number | string | boolean {
  return object[kSize];
}
const all = [new Front(1), new Back(2), new Text("three"), { [kSize]: true }, new Front(5)];
const seen: string[] = [];
for (let round = 0; round < 300; round++)
  for (let index = 0; index < all.length; index++) seen[index] = String(sizeOf(all[index]));
console.log(seen.join());
//// symbols-without-a-description.ts
// Symbol() and Symbol(undefined) have no description, Symbol("") has an empty one. Each names a field of its own.
export {};

const kBare = Symbol();
const kUndefined = Symbol(undefined);
const kEmpty = Symbol("");
class Three {
  [kBare] = 1;
  [kUndefined] = 2;
  [kEmpty] = 3;
  sum(): number {
    return this[kBare] * 100 + this[kUndefined] * 10 + this[kEmpty];
  }
}
let total = 0;
const three = new Three();
for (let round = 0; round < 300; round++) total += three.sum();
console.log(
  total,
  Object.getOwnPropertySymbols(three)
    .map(key => typeof key.description + String(key))
    .join(),
);
//// the-symbol-comes-through-a-namespace/keys.ts
export const kMass = Symbol("mass");
export const kLabel = Symbol("label");
//// the-symbol-comes-through-a-namespace/main.ts
// The symbol is read from the namespace object of its module at each use, and once into a constant that is declared with its type.
import * as keys from "./keys.ts";

const kMass: typeof keys.kMass = keys.kMass;
class Body {
  [keys.kMass]: number;
  [keys.kLabel]: string;
  constructor(mass: number, label: string) {
    this[keys.kMass] = mass;
    this[keys.kLabel] = label;
  }
}
const body = new Body(3, "ccc");
let total = 0;
for (let round = 0; round < 300; round++) total += body[kMass] + body[keys.kMass] * 10 + body[keys.kLabel].length * 100;
const { kLabel } = keys;
console.log(total, body[kLabel], kMass === keys.kMass, Reflect.ownKeys(body).map(String).join());
//// the-symbol-is-a-value-too.ts
// The symbol that names a field is also stored in fields, compared, put into collections and handed around. It stays the same symbol.
export {};

const kSelf = Symbol("self");
class Holder {
  [kSelf]: symbol;
  constructor() {
    this[kSelf] = kSelf;
  }
}
const holder = new Holder();
const byKey = new Map<symbol, string>([[kSelf, "found"]]);
const wrapped = Object(kSelf);
console.log(
  (holder as any)[holder[kSelf]] === kSelf,
  byKey.get(holder[kSelf]),
  (holder as any)[wrapped] === kSelf,
  typeof wrapped,
  wrapped == kSelf,
  kSelf.description,
  kSelf.toString(),
  [kSelf].includes(holder[kSelf]),
);
try {
  console.log("" + (holder[kSelf] as any));
} catch (error) {
  console.log((error as Error).name);
}
//// the-symbol-is-exported-again/keys.ts
export const kMass = Symbol("mass");
//// the-symbol-is-exported-again/main.ts
// The symbol reaches this module three ways: through `export { .. } from`, through `export *` and under another name. All three name one field.
import { kMass } from "./named.ts";
import { kMass as kStar } from "./star.ts";
import { kWeight } from "./renamed.ts";

class Body {
  [kMass]: number;
  constructor(mass: number) {
    this[kMass] = mass;
  }
}
const body = new Body(4);
let total = 0;
for (let round = 0; round < 300; round++) total += body[kMass] + body[kStar] * 10 + body[kWeight] * 100;
body[kWeight] = 5;
console.log(total, body[kMass], kMass === kStar, kStar === kWeight, Reflect.ownKeys(body).length);
//// the-symbol-is-exported-again/named.ts
export { kMass } from "./keys.ts";
//// the-symbol-is-exported-again/renamed.ts
export { kMass as kWeight } from "./keys.ts";
//// the-symbol-is-exported-again/star.ts
export * from "./keys.ts";
//// the-symbol-is-imported/keys.ts
export const kMass = Symbol("mass");
export const kLabel = Symbol("label");
export function describe(object: { [kMass]: number; [kLabel]: string }): string {
  return object[kLabel] + object[kMass];
}
//// the-symbol-is-imported/main.ts
// The symbols are made in another module and imported by name. A class here has fields under them, and the other module reads those fields.
import { kLabel, kMass, describe } from "./keys.ts";

class Body {
  [kMass]: number;
  [kLabel]: string;
  constructor(mass: number, label: string) {
    this[kMass] = mass;
    this[kLabel] = label;
  }
}
const bodies = [new Body(1, "a"), new Body(2, "bb")];
let total = 0;
for (let round = 0; round < 300; round++) for (const body of bodies) total += body[kMass] + body[kLabel].length;
console.log(total, bodies.map(describe).join(), Object.getOwnPropertySymbols(bodies[0]).map(String).join());
//// the-symbol-is-required/keys.cjs
const kMass = Symbol("mass");
module.exports = {
  kMass,
  kLabel: Symbol("label"),
  read(object) {
    return object[kMass] * 10;
  },
};
//// the-symbol-is-required/main.ts
// The symbols hang on the exports object of a CommonJS module and are taken out of it by destructuring.
const { kMass, kLabel, read } = require("./keys.cjs");

class Body {
  [key: symbol]: unknown;
  constructor(mass: number, label: string) {
    this[kMass] = mass;
    this[kLabel] = label;
  }
}
const bodies = [new Body(1, "a"), new Body(2, "bb")];
let total = 0;
for (let round = 0; round < 300; round++) for (const body of bodies) total += (body[kMass] as number) + read(body);
console.log(
  total,
  bodies[1][kLabel],
  Reflect.ownKeys(bodies[0]).map(String).join(),
  require("./keys.cjs").kMass === kMass,
);
//// the-symbol-is-used-before-it-is-made.ts
// A function that names the symbol runs before the declaration has run: a ReferenceError, and nothing is stored.
export {};

class Body {
  declare [kMass]: number;
  fill(mass: number): this {
    this[kMass] = mass;
    return this;
  }
}
const early = new Body();
try {
  early.fill(1);
  console.log("stored");
} catch (error) {
  console.log((error as Error).name, Reflect.ownKeys(early).length);
}
const kMass = Symbol("mass");
console.log(early.fill(2)[kMass], Reflect.ownKeys(early).length);
//// the-variable-of-the-symbol-is-stored-again/keys.ts
export let kMass = Symbol("mass");
export function replace(): void {
  kMass = Symbol("mass");
}
//// the-variable-of-the-symbol-is-stored-again/main.ts
// The other module exports the symbol in a `let` and replaces it. What was stored under the first symbol is not found under the second.
import { kMass, replace } from "./keys.ts";

const holder: Record<symbol, number> = {};
function store(value: number): void {
  holder[kMass] = value;
}
function read(): number {
  return holder[kMass];
}
store(1);
const before = kMass;
console.log(read());
replace();
console.log(read(), before === kMass);
store(2);
console.log(read(), holder[before], Object.getOwnPropertySymbols(holder).length);
//// two-symbols-with-one-description.ts
// Two calls of Symbol with the same text make two symbols, and a class has a field under each.
export {};

const kFirst = Symbol("same");
const kSecond = Symbol("same");
class Pair {
  [kSecond]: number;
  [kFirst]: number;
  constructor(first: number, second: number) {
    this[kFirst] = first;
    this[kSecond] = second;
  }
  difference(): number {
    return this[kFirst] - this[kSecond];
  }
}
let total = 0;
const pairs = [new Pair(10, 1), new Pair(20, 2)];
for (let round = 0; round < 300; round++) for (const pair of pairs) total += pair.difference();
const symbols = Object.getOwnPropertySymbols(pairs[0]);
console.log(
  total,
  symbols.length,
  symbols[0] === kSecond,
  symbols[1] === kFirst,
  (kFirst as symbol) === kSecond,
  String(kFirst) === String(kSecond),
);
pairs[0][kFirst] = 0;
console.log(pairs[0][kFirst], pairs[0][kSecond], pairs[0].difference(), (pairs[0] as any)[Symbol("same")]);
