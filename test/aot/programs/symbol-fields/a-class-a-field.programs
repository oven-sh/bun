//// a-function-constructor-an-heir-is-made-of-it.ts
// An interface declares fields under symbols, and a function that is called with `new` stores them. An object made by Object.create finds the fields of the object above it. A store through the heir makes a property of its own and leaves the field alone.
export {};

const kMass = Symbol("mass");
const kLabel = Symbol("label");
const kNote = Symbol("note");

////= Body-4

const world: Body[] = [make(1, "a"), make(2, "bb"), make(3, "ccc"), make(4, "d")];
console.log(measure(world), keysOf(world[0]));
const first: any = world[0];
const heir: Body = Object.create(world[0]);
console.log(heir[kMass], heir[kLabel], keysOf(heir), measure([heir]));
heir[kMass] = 40;
console.log(heir[kMass], world[0][kMass], keysOf(heir), measure([heir, world[0]]));
world[0][kLabel] = "longer";
console.log(heir[kLabel], delete (heir as any)[kMass], heir[kMass]);
Object.setPrototypeOf(world[1], { [kNote]: "moved", weight: () => 1000 });
console.log(world[1][kNote], world[1][kMass], measure(world));
