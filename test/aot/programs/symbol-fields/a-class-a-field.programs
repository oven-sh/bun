//// a-function-constructor-the-key-is-not-known-where-it-is-used.ts
// An interface declares fields under symbols, and a function that is called with `new` stores them. A function gets the key as a value of type symbol, or as anything. It reads and stores the same fields as code that names the symbol.
export {};

const kMass = Symbol("mass");
const kLabel = Symbol("label");
const kNote = Symbol("note");

////= Body-4

const world: Body[] = [make(1, "a"), make(2, "bb"), make(3, "ccc"), make(4, "d")];
console.log(measure(world), keysOf(world[0]));
const first: any = world[0];
function readBy(object: any, key: any): unknown {
  return object[key];
}
function storeBy(object: any, key: symbol | string, value: unknown): void {
  object[key] = value;
}
const keys: (symbol | string)[] = [kMass, "plain", kLabel, kNote, Symbol("mass"), "mass", Symbol.iterator];
const seen: unknown[] = [];
for (let round = 0; round < 50; round++)
  for (const key of keys) seen[keys.indexOf(key)] = readBy(world[round % 4], key);
console.log(seen.map(String).join());
for (const key of keys) storeBy(world[0], key, 12);
console.log(world[0][kMass], world[0][kLabel], world[0][kNote], keysOf(world[0]), measure(world.slice(1)));
////= console-log-2
//// a-function-constructor-the-symbol-lies-above-an-empty-field.ts
// An interface declares fields under symbols, and a function that is called with `new` stores them. While the optional field is empty a read finds what lies under the symbol above the object. A store makes the field, a deletion uncovers what lies above again.
export {};

const kMass = Symbol("mass");
const kLabel = Symbol("label");
const kNote = Symbol("note");

////= Body-4

const world: Body[] = [make(1, "a"), make(2, "bb"), make(3, "ccc"), make(4, "d")];
console.log(measure(world), keysOf(world[0]));
const first: any = world[0];
const above = Object.getPrototypeOf(world[0]);
console.log(world[0][kNote], measure(world));
above[kNote] = "above";
console.log(world[0][kNote], Object.hasOwn(world[0], kNote), kNote in world[0], measure(world), keysOf(world[0]));
world[0][kNote] = "own";
console.log(world[0][kNote], world[1][kNote], Object.hasOwn(world[0], kNote), keysOf(world[0]));
delete world[0][kNote];
console.log(world[0][kNote], keysOf(world[0]));
////= Object-defineProperty-2
world[1][kNote] = "caught";
console.log(world[1][kNote], Object.hasOwn(world[1], kNote), measure(world));
delete above[kNote];
console.log(measure(world));
//// a-registered-symbol.ts
// Symbol.for answers the same symbol for the same text wherever it is called, so a field under it is found through every call.
export {};

const kShared = Symbol.for("shared.mass");
const kLocal = Symbol("shared.mass");
class Body {
  [kShared]: number;
  [kLocal]: number;
  constructor(mass: number) {
    this[kShared] = mass;
    this[kLocal] = -mass;
  }
}
function again(): symbol {
  return Symbol.for("shared" + "." + ["mass"][0]);
}
const bodies = [new Body(1), new Body(2)];
let total = 0;
for (let round = 0; round < 300; round++)
  for (const body of bodies)
    total += body[kShared] * 10 + (body as any)[Symbol.for("shared.mass")] + (body as any)[again()];
console.log(
  total,
  kShared === again(),
  (kShared as symbol) === kLocal,
  Symbol.keyFor(kShared),
  Symbol.keyFor(kLocal),
  bodies[0][kLocal],
);
(bodies[0] as any)[again()] = 50;
console.log(bodies[0][kShared], Object.getOwnPropertySymbols(bodies[0]).length);
//// a-static-field-under-a-symbol.ts
// A static field under a symbol lies on the class itself, and a subclass finds it there until it stores its own.
export {};

const kCount = Symbol("count");
class Counter {
  static [kCount] = 0;
  static bump(): number {
    return ++this[kCount];
  }
}
class Below extends Counter {}
for (let round = 0; round < 300; round++) Counter.bump();
console.log(Counter[kCount], Below[kCount], Object.hasOwn(Below, kCount), Object.getOwnPropertySymbols(Counter).length);
Below.bump();
console.log(Counter[kCount], Below[kCount], Object.hasOwn(Below, kCount));
//// a-subclass-and-its-base-share-a-symbol.ts
// The base class and a subclass store under the same symbol: one field. Another subclass has a getter under it, and a third a method.
export {};

const kValue = Symbol("value");
class Base {
  [kValue]: number | (() => number);
  constructor(value: number) {
    this[kValue] = value;
  }
}
class Doubles extends Base {
  constructor(value: number) {
    super(value);
    this[kValue] = value * 2;
  }
}
class Plain {
  get [kValue](): number {
    return 7;
  }
}
class Method {
  [kValue](): number {
    return 9;
  }
}
function read(object: Base | Plain | Method): number {
  const value = object[kValue];
  return typeof value === "function" ? value.call(object) : value;
}
const all = [new Base(1), new Doubles(1), new Plain(), new Method()];
let total = 0;
for (let round = 0; round < 300; round++) for (const each of all) total += read(each);
console.log(
  total,
  all.map(each => Object.getOwnPropertySymbols(each).length).join(),
  all.map(each => kValue in each).join(),
);
Object.defineProperty(all[3], kValue, { value: 100, writable: true, configurable: true, enumerable: true });
(all[0] as Base)[kValue] = () => 1000;
console.log(all.map(read).join());
//// a-symbol-made-in-a-function.ts
// Each call of the function makes another symbol, so the one place in the text stands for many keys. What is stored under one is not found under another.
export {};

function makeKey(): symbol {
  return Symbol("made");
}
const first = makeKey();
const second = makeKey();
const holder: Record<symbol, number> = {};
holder[first] = 1;
holder[second] = 2;
function read(object: Record<symbol, number>, key: symbol): number {
  return object[key];
}
let total = 0;
for (let round = 0; round < 300; round++) total += read(holder, first) * 10 + read(holder, second);
console.log(total, first === second, Object.getOwnPropertySymbols(holder).length, holder[makeKey()]);
function tagged(value: number) {
  const key = Symbol("inner");
  const object = { [key]: value, key };
  return object;
}
const one = tagged(1);
const two = tagged(2);
console.log(
  (one as any)[one.key],
  (two as any)[two.key],
  (one as any)[two.key],
  (two as any)[one.key],
  one.key === two.key,
);
//// a-symbol-made-in-a-loop.ts
// One call of Symbol in a loop at the top of the module makes a symbol in each round. An object holds a property under each of them.
export {};

const keys: symbol[] = [];
const holder: Record<symbol, number> = {};
for (let index = 0; index < 5; index++) {
  const key = Symbol("round");
  keys.push(key);
  holder[key] = index;
}
let last: symbol = keys[0];
for (const key of keys) last = key;
console.log(
  keys.map(key => holder[key]).join(),
  Object.getOwnPropertySymbols(holder).length,
  holder[last],
  new Set(keys).size,
);
let again = Symbol("again");
const early = again;
const both = { [again]: "early" } as Record<symbol, string>;
again = Symbol("again");
both[again] = "late";
console.log(both[early], both[again], early === again, Object.getOwnPropertySymbols(both).length);
//// a-well-known-symbol-names-a-field.ts
// Fields under Symbol.toStringTag, Symbol.iterator and Symbol.toPrimitive are read by built-ins, which must find what the constructor has stored.
export {};

class Tagged {
  [Symbol.toStringTag]!: string;
  [Symbol.iterator]!: () => Iterator<number>;
  [Symbol.toPrimitive]!: (hint: string) => number | string;
  constructor(tag: string, count: number) {
    this[Symbol.toStringTag] = tag;
    this[Symbol.iterator] = function* () {
      for (let index = 0; index < count; index++) yield index;
    };
    this[Symbol.toPrimitive] = hint => (hint === "number" ? count : tag);
  }
}
const tagged = new Tagged("Mine", 3);
console.log(
  Object.prototype.toString.call(tagged),
  [...tagged].join(),
  +tagged,
  `${tagged}`,
  Object.getOwnPropertySymbols(tagged).map(String).join(),
);
tagged[Symbol.toStringTag] = "Other";
delete (tagged as any)[Symbol.iterator];
let spread: string;
try {
  spread = [...tagged].join();
} catch (error) {
  spread = (error as Error).name;
}
console.log(String(Object.prototype.toString.call(tagged)), spread);
