//// a-chain-runs-through-a-method-a-getter-a-closure-and-a-default-value.ts
// The program names only Start. From its method the chain goes on through a function, a getter of another class, a closure in a field, a default value of a parameter, a default in a pattern, and a static method.
class Start {
  go(): string {
    return afterMethod();
  }
}
function afterMethod(): string {
  return new WithGetter().value;
}
class WithGetter {
  get value(): string {
    return afterGetter();
  }
}
function afterGetter(): string {
  return new WithField().closure();
}
class WithField {
  closure = () => afterField();
}
function afterField(value = afterDefault()): string {
  return value;
}
function afterDefault({ value = afterPatternDefault() }: { value?: string } = {}): string {
  return value;
}
function afterPatternDefault(): string {
  return WithStatic.last();
}
class WithStatic {
  static last(): string {
    return "the end of the chain";
  }
}

console.log(new Start().go());
//// a-class-decorator-registers-a-class-that-nothing-names.ts
// No expression names Handler: the decorator gets the class and puts it into a list, and the program constructs what the list holds.
const registry: (new () => { run(): string })[] = [];

function register<T extends new () => { run(): string }>(value: T, context: ClassDecoratorContext): void {
  registry.push(value);
}

////= lines-4	suffix	string	"!"

@register
class Handler {
  name = "handler";
  run(): string {
    return this.describe() + suffix();
  }
  describe(): string {
    return "ran " + this.name;
  }
}

for (const entry of registry) console.log(new entry().run());
//// a-class-is-named-only-by-a-jsx-tag.tsx
// The tag <Counter /> is the only reference to the class Counter. The factory constructs it and calls render().
/* @jsxRuntime classic */
/* @jsx h */
export {};
declare global { namespace JSX { interface IntrinsicElements { [name: string]: any } } }

