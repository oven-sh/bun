//// an-export-reads-this-through-eval/barrel.js
export * from "./with-eval.js";
export * from "./without-eval.js";
//// an-export-reads-this-through-eval/main.js
// start() never writes `this`: the text it gives to eval does. It is called as a member of the namespace of a barrel, and `other` is declared in a file that has no eval.
import * as barrel from "./barrel.js";

console.log(barrel.start());
//// an-export-reads-this-through-eval/with-eval.js
export function start() { return "start, " + eval("this").other(); }
//// an-export-reads-this-through-eval/without-eval.js
export function other() { return "other"; }
//// an-exported-function-is-replaced-by-its-module/lib.ts
export let viaLet = function () { return "let: first"; };
export function declared() { return "declaration: first"; }
export default function byDefault() { return "default: first"; }

function secondLet() { return "let: second"; }
function secondDeclared() { return "declaration: second"; }
function secondDefault() { return "default: second"; }

export function swap() {
  viaLet = secondLet;
  (declared as any) = secondDeclared;
  (byDefault as any) = secondDefault;
}
//// an-exported-function-is-replaced-by-its-module/main.ts
// An import is a live binding: after lib.ts has stored to its exported let, to its exported function declaration and to its default export's binding, the importer calls the replacement.
import viaDefault, { viaLet, declared, swap } from "./lib";
import * as lib from "./lib";

console.log(viaLet(), declared(), viaDefault(), lib.viaLet(), lib.declared());
swap();
console.log(viaLet(), declared(), viaDefault(), lib.viaLet(), lib.declared());
