  }
} else {
  function inArm() {
    return "the second arm, " + helperOfSecondArm();
  }
}
console.log(inArm());

{
  function inBlock() {
    return "in a block, " + helperOfBlock();
  }
}
console.log(inBlock());

label: function labeled() {
  return "labeled, " + helperOfLabeled();
}
console.log(labeled());

try {
  function inTry() {
    return "in try, " + helperOfTry();
  }
} finally {
}
console.log(inTry());

function helperOfFirstArm() { return "helper of the first arm"; }
function helperOfSecondArm() { return "helper of the second arm"; }
function helperOfBlock() { return "helper of the block"; }
function helperOfLabeled() { return "helper of the labeled one"; }
function helperOfTry() { return "helper of try"; }
//// functions-handed-to-the-host.ts
// Each function is named once, as an argument to something that calls it later or from native code: timers, microtasks, promise reactions, sort, replace, JSON, array methods, event targets, process events and a finalizer of `using`.
const log: string[] = [];
function onTimeout() { log.push("timeout"); finish(); }
function onMicrotask() { log.push("microtask"); }
function onResolve(value: string) { log.push("then " + value); }
function onReject(error: Error) { log.push("catch " + error.message); }
function onFinally() { log.push("finally"); }
function compare(a: number, b: number) { return b - a; }
function replacer(match: string) { return match.toUpperCase(); }
function reviver(key: string, value: unknown) { return typeof value === "number" ? value + 1 : value; }
function stringifier(key: string, value: unknown) { return typeof value === "number" ? value * 2 : value; }
function mapper(value: number) { return value * 3; }
function reducer(sum: number, value: number) { return sum + value; }
function listener(event: Event) { log.push("event " + event.type); }
function onExit() { console.log(log.join("\n")); }
function finish() { log.push("finished"); }
function executor(resolve: (value: string) => void) { resolve("from the executor"); }

setTimeout(onTimeout, 1);
queueMicrotask(onMicrotask);
Promise.resolve("resolved").then(onResolve).finally(onFinally);
Promise.reject(new Error("rejected")).catch(onReject);
new Promise(executor).then(onResolve);
log.push([1, 3, 2].sort(compare).join());
log.push("abc".replace(/b/, replacer));
log.push(JSON.stringify(JSON.parse('{"a":1}', reviver), stringifier));
log.push(String([1, 2].map(mapper).reduce(reducer, 0)));
const target = new EventTarget();
target.addEventListener("ping", listener);
target.dispatchEvent(new Event("ping"));
(globalThis as any).process.on("exit", onExit);
//// functions-named-by-words-that-are-sometimes-keywords.ts
// Words that mean something only in certain places are ordinary names elsewhere. Each is the name of a function here, and the one reference to it is a call, a shorthand property, a tag or an argument, in a place where a parser has to decide.
function async() { return "async"; } function of() { return "of"; } function get() { return "get"; } function set() { return "set"; }
function type() { return "type"; } function namespace() { return "namespace"; } function module() { return "module"; } function declare() { return "declare"; }
function abstract() { return "abstract"; } function as() { return "as"; } function from() { return "from"; } function satisfies() { return "satisfies"; }
function accessor() { return "accessor"; } function using() { return "using"; } function is() { return "is"; } function asserts() { return "asserts"; }
function keyof() { return "keyof"; } function readonly() { return "readonly"; } function infer() { return "infer"; } function unique() { return "unique"; }
function global() { return "global"; } function override() { return "override"; } function out() { return "out"; } function defer() { return "defer"; }
function target() { return "target"; } function meta() { return "meta"; } function constructor() { return "constructor"; } function require2() { return "require2"; }

const log: string[] = [];
log.push(async());
log.push(of(), get(), set());
log.push(type());
log.push(namespace());
log.push(module());
log.push(declare());
log.push(abstract());
log.push(as(), from(), satisfies(), accessor());
log.push(using());
log.push([is, asserts, keyof, readonly].map(each => each()).join());
log.push(Object.values({ infer, unique, global, override }).map(each => each()).join());
log.push((out as () => string)(), defer satisfies () => string ? defer() : "");
for (const each of [target]) log.push(each());
log.push(`${meta()}`, constructor(), require2());
console.log(log.join(" "));
