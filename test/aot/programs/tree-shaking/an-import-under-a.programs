//// expression-statements-whose-value-nothing-uses.js
// Statements that compute something and drop it. Reading a member can run a getter or a trap, naming a variable can throw, an operator can convert an object, and a function that is called on the spot runs. `bun run` and `bun build --compile` print the same.
const log = [];
function effect(name) { log.push(name); return name; }
const source = { get getter() { return effect("a getter"); }, plain: 1 };
const trapped = new Proxy({}, { get(target, key) { return effect("a get trap for " + String(key)); } });
const converts = { valueOf() { effect("valueOf"); return 1; }, toString() { effect("toString"); return "s"; } };

source.getter;
source.plain;
source["getter"];
source?.getter;
trapped.anything;
trapped[effect("a computed key")];
+converts;
`${converts}`;
converts + 1;
converts == 1;
converts < 2;
-converts;
!converts;
typeof converts;
void effect("the operand of void");
(() => effect("a function called on the spot"))();
(function () { effect("an old-style one"); })();
new (class { constructor() { effect("a constructor"); } })();
[effect("an element")];
({ key: effect("a value") });
effect("the left of a comma"), 1;
true && effect("the right of &&");
false || effect("the right of ||");
null ?? effect("the right of ??");
try {
  notDeclaredAnywhere;
} catch (error) {
  log.push(error.name + " for a name that is not declared");
}
typeof notDeclaredAnywhere;
try {
  null.member;
} catch (error) {
  log.push(error.name + " for a member of null");
}
1;
"text";
source;

console.log(log.join("\n"));
//// fields-are-assigned-in-the-constructor-of-a-class-nobody-constructs/main.ts
// With "strict" a field without an initializer must be assigned in the constructor, and a function with a return type must return on every path. Whether that holds is read from bodies that nobody calls here. A build that does not look into them must not report what they prove.
class NeverConstructed {
  first: number;
  second: string;
  readonly third: boolean;
  constructor(flag: boolean) {
    this.first = 1;
    if (flag) this.second = "a";
    else this.second = "b";
    this.third = flag;
  }
}
function neverCalled(value: number | string): string {
  if (typeof value === "number") return "number";
  else return value;
}
function alwaysThrows(): never {
  throw new Error("never called");
}
function usesNever(value: string | undefined): string {
  if (value === undefined) alwaysThrows();
  return value;
}
let assignedInBody: number;
function assigns() {
  assignedInBody = 1;
}
type Instance = InstanceType<typeof NeverConstructed>;
const literal: Instance = { first: 2, second: "c", third: true };

console.log(literal.first, literal.second, literal.third);
