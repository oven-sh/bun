import { viaExports, viaModuleExports, viaThis, viaComputed } from "./members.cjs";
import literal from "./literal.cjs";
import { shorthand } from "./literal.cjs";
import * as assigned from "./assigned.cjs";
import { viaDefine, viaGetter } from "./defined.cjs";
import whole from "./whole.cjs";
import Klass from "./class.cjs";

console.log(viaExports(), viaModuleExports(), viaThis(), viaComputed());
console.log(literal.shorthand(), literal.renamed(), literal.method(), literal.getter(), shorthand === literal.shorthand);
console.log(assigned.viaAssign(), assigned.default.viaAssign());
console.log(viaDefine(), viaGetter());
console.log(whole(), whole.property());
console.log(new Klass().method(), Klass.helper());
//// every-way-to-fill-the-exports-of-a-commonjs-module/members.cjs
function viaExports() { return "exports.name"; }
function viaModuleExports() { return "module.exports.name"; }
function viaThis() { return "this.name"; }
function viaComputed() { return "exports[name]"; }

exports.viaExports = viaExports;
module.exports.viaModuleExports = viaModuleExports;
this.viaThis = viaThis;
exports["via" + "Computed"] = viaComputed;
//// every-way-to-fill-the-exports-of-a-commonjs-module/whole.cjs
module.exports = whole;
module.exports.property = property;

function whole() { return "the function is the module"; }
function property() { return "a property of that function"; }
//// every-way-to-use-a-top-level-name.ts
// Each constant, class and enum at the top level is used once, each in another way: typeof, a shorthand property, a default of a parameter, a template, a computed key, extends, a reverse mapping, patterns.
const byTypeof = 1;
const shorthand = 2;
const inDefault = 3;
const inTemplate = 4;
const key = "computed";
class Base { name() { return "base"; } }
const Mixed = class extends Base {};
enum Color { Red = 5 }
const enum Inlined { One = 6 }
const frozen = Object.freeze({ a: 7 });
const list = [8, 9];
const [first] = list;
const { a: renamed } = frozen;
function take(value = inDefault) { return value; }
console.log(typeof byTypeof, JSON.stringify({ shorthand }), take(), `${inTemplate}`, { [key]: 1 }.computed, new Mixed().name(), Color.Red, Color[5], Inlined.One, first, renamed);
//// export-equals-and-import-equals/class.ts
class Klass {
  method() { return "the method"; }
}
namespace Klass {
  export function helper() { return "the function of the merged namespace"; }
}
export = Klass;
//// export-equals-and-import-equals/function.ts
function helper() { return "helper"; }
function exported() { return "the function, " + helper(); }
export = exported;
//// export-equals-and-import-equals/main.ts
// `export =` of a function, of a class merged with a namespace and of an object, each imported with `import x = require()`.
import fn = require("./function");
import Klass = require("./class");
import table = require("./object");

console.log(fn());
console.log(new Klass().method(), Klass.helper());
console.log(table.entry(), table.renamed());
//// export-equals-and-import-equals/object.ts
function entry() { return "entry"; }
function original() { return "renamed"; }
export = { entry, renamed: original };
//// exported-overloads-and-their-implementation/barrel.ts
export * from "./lib";
//// exported-overloads-and-their-implementation/lib.ts
export function format(value: number): string;
export function format(value: string): string;
export function format(value: number | string): string { return "format " + typeof value; }

export function parse(text: string): string;
export function parse(value: number): string;
export function parse(value: unknown): string { return "parse " + typeof value; }

export function measure(list: unknown[]): string;
export function measure(text: string): string;
export function measure(value: { length: number }): string { return "measure " + value.length; }

export default function build(): string;
export default function build(value: number): string;
export default function build(value?: number): string { return "build " + value; }
//// exported-overloads-and-their-implementation/main.ts
// The first declaration of each name is a signature without a body; the body comes last. The names are imported, re-exported by a barrel, and read from a namespace.
import { format } from "./lib";
import { parse } from "./barrel";
import * as lib from "./lib";
import build from "./lib";

console.log(format(1), format("a"), parse("1"), parse(2), lib.measure([1]), lib.measure("ab"), build(1), build());
//// exports-named-like-members-of-every-object/converted.js
