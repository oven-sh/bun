// Classes that are constructed by Reflect.construct, by `new (pick())()`, by new on a member of an array, through new.target, through a bound copy, by a subclass that has no constructor of its own and by Object.create plus call of a function.
function note(text: string) { return "constructed " + text; }
class ByReflect { value = note("by Reflect.construct"); }
class ByPick { value = note("by new (pick())()"); }
class InArray { value = note("from an array"); }
class ByNewTarget {
  value = note("through new.target");
  static again(this: unknown, first: ByNewTarget) { return first.copy; }
  copy: ByNewTarget | undefined;
  constructor(nested = false) { if (!nested) this.copy = new new.target(true); }
}
class Bound { constructor(public value: string) {} }
class Parent { value = note("by a subclass without a constructor"); }
class Child extends Parent {}
function Old(this: { value: string }) { this.value = note("by call on Object.create"); }
class AsNewTarget { describe() { return "prototype of the new.target argument"; } }

function pick() { return ByPick; }
console.log(Reflect.construct(ByReflect, []).value);
console.log(new (pick())().value);
console.log(new [InArray][0]().value);
console.log(new ByNewTarget().copy!.value);
console.log(new (Bound.bind(null, note("through bind")))().value);
console.log(new Child().value);
const old = Object.create(Old.prototype);
Old.call(old);
console.log(old.value, old instanceof Old);
console.log((Reflect.construct(Object, [], AsNewTarget) as AsNewTarget).describe());
//// declarations-inside-blocks-loops-and-labels-at-the-top-level.js
// What stands inside a block, a loop, a label, an arm or a try at the top level is not a declaration of the top level, except a var. Some of it is used after the block, some inside, some nowhere, and an arm that a constant condition removes declares a var all the same.
const log = [];
{
  const insideOnly = "read inside its block";
  const unusedInside = { a: 1 };
  var leaks = "a var leaks out of a block";
  class InBlock { name() { return "a class in a block"; } }
  log.push(insideOnly, new InBlock().name());
}
for (var counter = 0; counter < 2; counter++) {
  const perTurn = "turn " + counter;
  var lastTurn = perTurn;
}
label: {
  var inLabel = "a var in a labeled block";
  const unusedInLabel = 1;
  break label;
}
if (false) {
  var neverAssigned = "never";
  const neverEvaluated = log.push("never");
}
if (log.length) {
  var inArm = "a var in an arm";
  let unusedInArm = [1];
}
try {
  var inTry = "a var in try";
  const unusedInTry = "x";
} finally {
  var inFinally = "a var in finally";
}
while (true) {
  var inWhile = "a var in while";
  break;
}
var unusedInNoBlock = 1;
log.push(leaks, counter, lastTurn, inLabel, String(neverAssigned), inArm, inTry, inFinally, inWhile);
console.log(log.join("\n"));
//// decorator-metadata-asks-a-barrel-for-a-class/main.ts
// The classes come through the barrel of a pure package written in TypeScript, and this file writes them only as types: of a decorated constructor's parameters, of a decorated property, through a namespace import. With emitDecoratorMetadata those types are values, so the barrel is asked for them. One class is written as a type where no decorator stands, and one is asked for by nobody.
import { Engine, Wheel, OnlyAType } from "car-parts";
import * as parts from "car-parts";

declare global { namespace Reflect { function metadata(key: string, value: unknown): (target: any, member?: string | symbol) => void; } }
const recorded = new Map<string, any>();
Reflect.metadata = (key, value) => (target, member) => { recorded.set(key + " " + String(member ?? "class"), value); };
function noted(...anything: unknown[]): void {}

@noted
class Car {
  @noted radio!: parts.Radio;
  plain: OnlyAType | undefined;
  constructor(engine: Engine, wheel: Wheel) {}
}

const [engine, wheel] = recorded.get("design:paramtypes class");
console.log(new engine().start(), new wheel().turn(), new (recorded.get("design:type radio"))().play());
