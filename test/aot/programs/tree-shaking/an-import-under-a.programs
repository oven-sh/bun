const b = () => c;
const c = () => a;

const ping = n => (n === 0 ? "ping" : pong(n - 1));
const pong = n => (n === 0 ? "pong" : pang.run(n - 1));
const pang = { run: n => (n === 0 ? "pang" : ping(n - 1)) };

class Hen { static lays() { return Egg; } }
class Egg { static hatches() { return Hen; } }

