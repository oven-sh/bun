export const seen: string[] = [];
export function mark(label: string) {
  return (target: object, key: string | symbol | undefined, index: number): void => {
    seen.push(`${label} at parameter ${index} of ${String(key)}`);
  };
}
//// this-in-a-decorator-of-a-parameter-is-that-of-the-function-around-the-class/own.ts
import { mark } from "./marks.ts";
// Here `this` belongs to the method: the function around the class looks at nothing.
export function defaultValueBehindADecorator() {
  class Made {
    method(@mark("own") value: unknown = this) {
      return value === this;
    }
  }
  return new Made().method();
}
