//// used-declarations-around-declarations-that-are-left-out.js
// Declarations that are used stand between ones that nothing uses. What is used is evaluated in the order written, a function that is hoisted reads constants that come later, and a read that comes too early still throws.
const log = [];
const unused1 = { a: 1 };
const first = log.push("first");
const unused2 = [1, 2, 3];
function hoisted() { return [second, third.value, Fourth.name].join(); }
const unused3 = () => hoisted();
////= lines-10	" before second"
const second = "second";
const unused4 = "text";
////= lines-10	" before third"
const third = { value: "third" };
class Unused5 {}
////= lines-10	" before Fourth"
class Fourth {}
const unused6 = class {};
log.push(hoisted());
var late = "a var is undefined before its statement";
function readsVar() { return typeof early + " " + typeof late; }
log.push(readsVar());
var early = 1;
log.push(readsVar());
console.log(log.join("\n"));
//// values-that-look-inert-and-are-not.js
// Each unused declaration looks like a plain value and hides something that runs when it is evaluated: a computed key that is an object, a class's computed key, a spread, a template with an object, a getter behind a pattern, a default in a pattern, a tag, `in`, instanceof, a comparison and a sum that convert an object, a class that extends a call, `new` without a mark, an optional call, a comma. `bun run` runs all of it. `bun build --compile` takes a name as the computed key of a class member for harmless, so the two classes go and the key's toString runs once, for the object literal; everything else runs.
const log = [];
const effect = name => { log.push(name); return name; };
const keyObject = { toString() { return effect("toString of a key"); } };
const converts = { valueOf() { effect("valueOf"); return 1; }, [Symbol.toPrimitive]: undefined };
const primitive = { [Symbol.toPrimitive]() { return effect("Symbol.toPrimitive"); } };
const withGetter = { get value() { return effect("a getter"); } };
const iterable = { *[Symbol.iterator]() { effect("an iterator"); } };
class HasInstance { static [Symbol.hasInstance]() { effect("Symbol.hasInstance"); return true; } }
const trap = new Proxy({}, { has() { effect("a has trap"); return true; }, get() { return effect("a get trap"); } });

const a1 = { [keyObject]: 1 };
class A2 { [keyObject]() {} }
class A3 { static [keyObject] = 1; }
const a4 = { ...withGetter };
const a5 = [...iterable];
const a6 = `${primitive}`;
const a7 = "" + primitive;
const { value: a8 } = withGetter;
const [a9] = iterable;
const { a10 = effect("a default in a pattern") } = {};
const a11 = effect`a tag`;
const a12 = "key" in trap;
const a13 = {} instanceof HasInstance;
const a14 = converts == 1;
const a15 = converts < 2;
const a16 = converts + 1;
const a17 = -converts;
const a18 = ~converts;
class A19 extends (effect("extends"), Object) {}
const a20 = new (class { constructor() { effect("a constructor"); } })();
const a21 = effect?.("an optional call");
const a22 = (effect("the left of a comma"), 1);
const a23 = trap.anything;
const a24 = trap["any" + "thing"];
const a25 = withGetter?.value;
const a26 = [effect("an element")];
const a27 = { key: effect("a property value") };
const a28 = true && effect("the right of &&");
const a29 = null ?? effect("the right of ??");
const a30 = log.length ? effect("an arm") : 0;
const a31 = typeof effect("the operand of typeof");
const a32 = void effect("the operand of void");
const a33 = !effect("the operand of !");
const a34 = delete trap.gone;
let a35 = 0;
const a36 = a35++;

console.log(log.join("\n"));
//// variables-that-are-stored-to-and-never-read.js
// Each variable has a plain initializer and nothing ever reads it, but something stores to it, each in another way. The right-hand sides have effects, so the stores stay and need a variable to store to.
const log = [];
function effect(name) { log.push(name); return name; }

let plain = 1;
plain = effect("a plain store");
let compound = 1;
compound += effect("a compound store").length;
let logical = null;
logical ??= effect("a logical store");
let counted = 1;
counted++;
--counted;
let inArray = 1;
[inArray] = [effect("an array pattern")];
let inObject = 1;
({ inObject } = { inObject: effect("an object pattern") });
let renamed = 1;
({ key: renamed } = { key: effect("a renamed property") });
let withDefault = 1;
({ withDefault = effect("a default in a pattern") } = {});
let restOfArray = 1;
[...restOfArray] = [effect("a rest element")];
let restOfObject = 1;
({ ...restOfObject } = { a: effect("a rest property") });
let nested = 1;
[{ deep: [nested] }] = [{ deep: [effect("a nested pattern")] }];
let inForOf = 1;
for (inForOf of [effect("a for-of head")]);
let inForIn = 1;
for (inForIn in { [effect("a for-in head")]: 1 });
let inForOfPattern = 1;
for ([inForOfPattern] of [[effect("a pattern in a for-of head")]]);
var viaVar = 1;
viaVar = effect("a store to a var");
let inFunction = 1;
function stores() { inFunction = effect("a store inside a function"); }
stores();
let inArrow = 1;
(() => (inArrow = effect("a store inside an arrow function")))();
let inClass = 1;
class Storer { static { inClass = effect("a store inside a static block"); } }
let chained = 1, alsoChained = 1;
chained = alsoChained = effect("a chained store");

console.log(log.join("\n"));
//// what-a-function-nobody-calls-declares-inside-is-a-type-outside.ts
// The return types of these functions name things that exist only inside their bodies: a local class, a local enum, an object with a method, a closure, a tuple from a destructuring. Nobody calls the functions; the types are used on values that are made elsewhere.
function makesLocalClass() {
  class Local {
    size = 3;
    grow() {
      return this.size + 1;
    }
  }
  return new Local();
}
function makesLocalEnum() {
  enum Direction {
    Up = "up",
    Down = "down",
  }
  return Direction.Up as Direction;
}
function makesClosure() {
  let count = 0;
  return { next: () => ++count, reset: (to: number) => void (count = to) };
}
function makesTuple() {
  const [first, ...rest] = [1, "two", true] as [number, string, boolean];
  return { first, rest };
}
function inferredPredicate(value: unknown) {
  return typeof value === "string";
}

const local: ReturnType<typeof makesLocalClass> = { size: 5, grow: () => 6 };
const direction = "down" as ReturnType<typeof makesLocalEnum>;
const closure: ReturnType<typeof makesClosure> = { next: () => 1, reset: () => {} };
const tuple: ReturnType<typeof makesTuple> = { first: 2, rest: ["three", false] };
const predicate: typeof inferredPredicate = (value): value is string => typeof value === "string";

const unknown: unknown = "text";
console.log(local.size + local.grow(), direction.toUpperCase(), closure.next() + 1, closure.reset(2), tuple.first + 1, tuple.rest[0].length, !tuple.rest[1]);
if (predicate(unknown)) console.log(unknown.length);
