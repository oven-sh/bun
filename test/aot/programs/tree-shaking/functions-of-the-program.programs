// Nothing constructs these classes or names them in an expression. They are used as types: of an object literal, of a parameter, after implements, as the base of an interface, through InstanceType and through an indexed access. The types of their members come from initializers and bodies.
class Point {
  x = 1;
  y = 2;
  label = "point";
  norm() {
    return Math.hypot(this.x, this.y);
  }
  get doubled() {
    return { x: this.x * 2, y: this.y * 2 };
  }
  static origin() {
    return new Point();
  }
}
class Named {
  name = "";
  greet() {
    return "hello " + this.name;
  }
}

const literal: Point = { x: 3, y: 4, label: "literal", norm() { return 5; }, doubled: { x: 6, y: 8 } };
function describe(point: Point) {
  return point.label + " " + point.norm().toFixed(1) + " " + point.doubled.x;
}
class Person implements Named {
  name = "Ada";
  greet() {
    return "hi " + this.name;
  }
}
interface Labeled extends Named {
  tag: string;
}
const labeled: Labeled = { name: "Bo", tag: "t", greet: () => "hey" };
const instance: InstanceType<typeof Point> = literal;
const norm: Point["norm"] = () => 9;
const made: ReturnType<typeof Point.origin> = literal;

console.log(describe(literal), new Person().greet(), labeled.greet(), labeled.tag, instance.y, norm() + 1, made.x);
//// the-type-of-a-function-nobody-calls-is-asked-for.ts
// These functions are never called, so their bodies may go. Their types stay in use: each has no return type written down, and code that runs is typed by ReturnType, Parameters, typeof and Awaited of them.
function shape() {
  return { width: 2, height: 3, label: "box" };
}
function pair(first: number, second: string) {
  return [first, second] as const;
}
async function later() {
  return { done: true, count: 1 };
}
function* steps() {
  yield 1;
  yield 2;
}
const arrow = (value: number) => ({ doubled: value * 2 });
function nested() {
  return shape().width > 1 ? pair(1, "a") : undefined;
}

type Shape = ReturnType<typeof shape>;
const box: Shape = { width: 4, height: 5, label: "crate" };
const args: Parameters<typeof pair> = [1, "one"];
const result: Awaited<ReturnType<typeof later>> = { done: false, count: 7 };
const step: ReturnType<typeof steps> extends Generator<infer T> ? T : never = 2;
const doubled: ReturnType<typeof arrow> = { doubled: 8 };
const maybe: ReturnType<typeof nested> = [1, "a"];
let same: typeof shape | undefined;

console.log(box.width * box.height, box.label.toUpperCase());
console.log(args[0] + 1, args[1].length, result.count + 1, !result.done, step + 1, doubled.doubled / 2, maybe?.[1], same);
