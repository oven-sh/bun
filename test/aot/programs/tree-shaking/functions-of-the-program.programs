const literal = {
  load() {
    return "method of a literal, " + load();
  },
  get size() {
    return size() + 1;
  },
  own: function own(depth: number): string {
    return depth === 0 ? "a function expression calls itself" : own(depth - 1);
  },
};

class Klass {
  load() {
    return "method of a class, " + load();
  }
  make = make();
  static size() {
    return size() + 2;
  }
}

