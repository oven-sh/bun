function whenMain() { return "imported-commonjs.cjs is the entry point"; }
function whenNotMain() { return "imported-commonjs.cjs is not the entry point"; }

module.exports = require.main === module ? whenMain() : whenNotMain();
//// what-the-program-is-started-as-decides-a-branch/imported.ts
function whenMain() { return "imported.ts is the entry point"; }
function whenNotMain() { return "imported.ts is not the entry point"; }

export const fromImported = import.meta.main ? whenMain() : whenNotMain();
//// what-the-program-is-started-as-decides-a-branch/main.ts
// import.meta.main and require.main === module are true in the entry point and false in a file it imports. Each branch calls a function that nothing else names.
import { fromImported } from "./imported";
import fromCommonJS from "./imported-commonjs.cjs";

function whenMain() { return "main.ts is the entry point"; }
function whenNotMain() { return "main.ts is not the entry point"; }

console.log(import.meta.main ? whenMain() : whenNotMain());
if (!import.meta.main) console.log(whenNotMain());
console.log(fromImported);
console.log(fromCommonJS);
//// which-jsx-tags-name-a-binding-and-which-are-text.tsx
// <box /> is the text "box" although a function box exists. <_Box />, <$Box /> and <ui.box /> name bindings although they do not start with a capital.
/* @jsxRuntime classic */
/* @jsx h */
export {};
declare global { namespace JSX { interface IntrinsicElements { [name: string]: any } } }

function h(tag: any, props: any): any {
  return typeof tag === "function" ? tag(props) : "text " + tag;
}

////= lines-3	box	"the function box"
////= lines-3	_Box	"the function _Box"
////= lines-3	$Box	"the function $Box"
////= lines-3	inner	"the function inner"
const ui = { box: () => inner() };

console.log(<box />);
console.log(<_Box />);
console.log(<$Box />);
console.log(<ui.box />);
