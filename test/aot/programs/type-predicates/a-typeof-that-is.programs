//// a-typeof-that-is-kept-or-switched-on.js
// `const kind = typeof value` and `switch (typeof value)` are tests of the type of the value only while the value is still the one that was asked.
const values = () => [undefined, null, true, 0, 1.5, 10n, "", "text", Symbol.iterator, {}, [], () => 1, function () {}, class {}, new Date(0), /r/, new Proxy({}, {}), new Proxy(function () {}, {})];
const plus = value => { try { return typeof (value + 1); } catch (error) { return error.constructor.name; } };
const show = (label, ask) => console.log(label, values().map(value => { try { return String(ask(value)); } catch (error) { return error.constructor.name; } }).join(" "));

show("kept", function (x) { const kind = typeof x; return kind === "string" ? x.length : kind === "number" ? x + 1 : kind === "object" ? (x === null ? "null" : "object") : kind; });
show("kept, the name on the left", function (x) { const kind = typeof x; return "function" === kind ? x.length : "bigint" == kind ? x + 1n : "undefined" !== kind ? "some" : "none"; });
show("kept, not equal", function (x) { const kind = typeof x; if (kind !== "string") return "no text"; return x.length; });
show("kept, object alone", function (x) { const kind = typeof x; return kind === "object"; });
show("kept, not object", function (x) { const kind = typeof x; return kind !== "object" ? typeof x : "object"; });
show("kept, a name that is none", function (x) { const kind = typeof x; return kind === "array" || kind === "null" || kind === "String"; });
show("kept, two of them", function (x) { const kind = typeof x; return kind === "string" || kind === "number" ? `${x}!` : "other"; });
show("kept and printed", function (x) { const kind = typeof x; return kind === "symbol" ? kind : kind.length; });
show("kept, compared with what is no constant", function (x) { const kind = typeof x, wanted = ["string"][0]; return kind === wanted ? x.length : -1; });
show("kept, switched on", function (x) { const kind = typeof x; switch (kind) { case "string": return x.length; case "number": return x + 1; case "object": return x === null; default: return kind; } });

show("the value changes behind the question", function (x) { let value = x; const kind = typeof value; value = "changed"; return kind === "string" ? value.length : `${kind} ${value.length}`; });
show("the parameter changes behind the question", function (x) { const kind = typeof x; x = 5; return kind === "number" ? x + 1 : `${kind} ${x + 1}`; });
show("the parameter changes through arguments", function (x) { const kind = typeof x; arguments[0] = 5; return kind === "number" ? x + 1 : `${kind} ${plus(x)}`; });
show("the value changes in a closure", function (x) { let value = x; const kind = typeof value; (() => { value = 7; })(); return kind === "number" ? value + 1 : `${kind} ${value + 1}`; });
show("the value changes only sometimes", function (x) { let value = x; const kind = typeof value; if (kind === "boolean") value = "was a boolean"; return kind === "boolean" ? value.length : kind === "string" ? value.length : kind; });
show("the kind changes", function (x) { let kind = typeof x; if (x === null) kind = "null"; return kind === "object" ? "object" : kind === "null" ? "nothing" : kind; });
show("the kind changes in a closure", function (x) { let kind = typeof x; (() => { kind = "string"; })(); return kind === "string" ? typeof x : "never"; });
show("the kind is a var read too early", function (x) { const early = kind === "string" ? "text" : String(kind); var kind = typeof x; return `${early} ${kind === "string"}`; });
show("the kind is a var in a loop", function (x) { let all = ""; for (let turn = 0; turn < 2; turn++) { all += kind === "string" ? "T" : "-"; var kind = typeof (turn ? 1 : x); } return all; });
show("the kind in its dead zone", function (x) { const ask = () => (kind === "string" ? x.length : -1); const early = (() => { try { return ask(); } catch (error) { return error.constructor.name; } })(); const kind = typeof x; return `${early} ${ask()}`; });
show("the value is a var asked too early", function (x) { const kind = typeof value; var value = x; return kind === "undefined" ? typeof value : `never ${kind}`; });
show("the value is a let without a value yet", function (x) { let value; const kind = typeof value; value = x; return kind === "undefined" ? typeof value : `never ${kind}`; });
show("the value is a function declared below", function (x) { const kind = typeof declared; function declared() { return x; } return kind === "function" ? typeof declared() : kind; });
show("the value is caught", function (x) { try { throw x; } catch (caught) { const kind = typeof caught; return kind === "string" ? caught.length : kind === "object" ? "object" : kind; } });
show("the value in its dead zone", function (x) { try { const kind = typeof later; const later = x; return kind === "string" ? later.length : kind; } catch (error) { return error.constructor.name; } });
show("asked in a closure", function (x) { const kind = typeof x; return [0].map(() => (kind === "string" ? x.length : kind === "function" ? x.name.length : kind))[0]; });
show("asked of what a closure holds", function (x) { return (() => { const kind = typeof x; return kind === "string" ? x.length : kind; })(); });
show("behind eval", function (x) { const kind = typeof x; try { eval("x = 5"); } catch {} return kind === "number" ? x + 1 : `${kind} ${typeof x}`; });
show("a fresh one each turn", function (x) { let all = ""; for (const value of [x, 1, "s"]) { const kind = typeof value; all += kind === "string" ? value.length : kind === "number" ? value + 1 : kind[0]; } return all; });
show("of a pattern", function ({ length } = "abc", [first] = [1]) { const kind = typeof length, other = typeof first; return `${kind === "number" ? length + 1 : kind} ${other === "number" ? first + 1 : other}`; });
show("of a default", function (x = "default") { const kind = typeof x; return kind === "string" ? x.length : kind; });
show("of this", function (x) { return (function () { const self = this, kind = typeof self; return kind === "object" ? self === null : kind; }).call(x); });
show("of a member", function (x) { let reads = 0; const holder = { get held() { reads++; return x; } }; const kind = typeof holder.held; return `${kind === "string" ? holder.held.length : kind} ${reads}`; });
show("of a call", function (x) { let calls = 0; const give = () => (calls++, x); const kind = typeof give(); return `${kind === "string" ? "text" : kind} ${calls}`; });

show("switched", function (x) { switch (typeof x) { case "string": return x.length; case "number": return x + 1; case "boolean": return !x; case "bigint": return x + 1n; case "symbol": return x.description; case "undefined": return "none"; case "function": return x.length; case "object": return x === null ? "null" : Object.keys(x).length; } return "never"; });
show("switched, object without function", function (x) { switch (typeof x) { case "object": return x === null ? "null" : "object"; default: return typeof x; } });
show("switched, object in front of function", function (x) { switch (typeof x) { case "object": return "object"; case "function": return x.length; default: return "other"; } });
show("switched, function in front of object", function (x) { switch (typeof x) { case "function": return x.length; case "object": return "object"; } return "other"; });
show("switched, function alone", function (x) { switch (typeof x) { case "function": return x.length; } return "other"; });
show("switched, falling through", function (x) { let all = ""; switch (typeof x) { case "string": all += "s"; case "number": all += "n"; break; case "object": all += "o"; default: all += "d"; case "boolean": all += "b"; } return all; });
show("switched, the default first", function (x) { switch (typeof x) { default: return "other"; case "string": return x.length; case "object": return "object"; } });
show("switched, the default in the middle", function (x) { let all = ""; switch (typeof x) { case "string": all += "s"; break; default: all += "d"; case "number": all += "n"; } return all; });
show("switched, a name twice", function (x) { switch (typeof x) { case "string": return "first"; case "string": return "second"; case "object": return "o1"; case "object": return "o2"; default: return "other"; } });
show("switched, several names for one body", function (x) { switch (typeof x) { case "string": case "number": case "bigint": return `${x}`; case "object": case "function": return "reference"; default: return "rest"; } });
show("switched, a name that is none", function (x) { switch (typeof x) { case "array": return "never"; case "null": return "never"; case "": return "never"; case "string": return x.length; default: return "other"; } });
show("switched, no case", function (x) { switch (typeof x) { } return "behind"; });
show("switched, only a default", function (x) { switch (typeof x) { default: return typeof x; } });
show("switched, a case that is no constant", function (x) { const name = ["string"][0]; switch (typeof x) { case name: return x.length; case "number": return x + 1; default: return "other"; } });
show("switched, a case that is a number", function (x) { switch (typeof x) { case 1: return "never"; case "number": return x + 1; default: return "other"; } });
show("switched, the value changes in a body", function (x) { let value = x, all = ""; switch (typeof value) { case "string": value = 5; all += typeof value; case "number": all += typeof value; value = null; case "object": all += typeof value; } return all; });
show("switched, a declaration in the block", function (x) { switch (typeof x) { case "string": let size = x.length; return size; case "number": try { return size; } catch (error) { return error.constructor.name; } default: return "other"; } });
show("switched, a break out of a loop", function (x) { let all = ""; outer: for (const value of [x, "s", 1]) { switch (typeof value) { case "number": all += "n"; break outer; case "string": all += value.length; continue; default: all += "?"; } all += "."; } return all; });
show("switched, a member read once", function (x) { let reads = 0; const holder = { get held() { reads++; return x; } }; switch (typeof holder.held) { case "string": return `text ${reads}`; case "object": return `object ${reads}`; default: return `other ${reads}`; } });
show("switched, a name nobody declared", function () { switch (typeof neverDeclaredAnywhere) { case "undefined": return "none"; case "object": return "object"; default: return "other"; } });
show("switched, in its dead zone", function (x) { try { switch (typeof later) { case "undefined": return "none"; default: return "other"; } const later = x; } catch (error) { return error.constructor.name; } });
show("switched, in parentheses and negated", function (x) { switch ((typeof (x))) { case "string": return "text"; } switch (!typeof x) { case false: return "false"; } return "never"; });
show("switched, in a generator", function (x) { return [...(function* (value) { const kind = typeof value; yield 1; switch (typeof value) { case "string": yield value.length; break; case "object": yield kind === "object"; break; default: yield kind; } })(x)].join("/"); });
const later = await Promise.all(values().map(async x => { const kind = typeof x; await null; switch (kind) { case "string": return x.length; case "number": return x + 1; default: return kind === "object" ? "o" : kind[0]; } }));
console.log("behind an await", later.join(" "));
//// a-typeof-that-is-kept-or-switched-on-with-types.ts
// The same under declared types: the arms go by what the test proves, also where a cast stands around the question or the value.
type Any = string | number | boolean | null | undefined | bigint | symbol | object | (() => number);
const values = (): Any[] => [undefined, null, true, 0, 1.5, 10n, "", "text", Symbol.iterator, {}, [], () => 1, new Date(0)];
const show = (label: string, ask: (value: Any) => unknown) => console.log(label, values().map(value => String(ask(value))).join(" "));

show("kept", (x: Any) => { const kind = typeof x; return kind === "string" ? (x as string).length : kind === "number" ? (x as number) + 1 : kind === "function" ? (x as () => number).length : kind; });
show("kept, under a cast", (x: Any) => { const kind = typeof x as string; return kind === "string" ? (x as string).length : kind; });
show("kept, of a cast", (x: Any) => { const kind = typeof (x as unknown); return kind === "number" ? (x as number) + 1 : kind; });
show("kept, of what is asserted", (x: Any) => { const kind = typeof x!; return kind === "object" ? "object" : kind; });
show("kept, declared", (x: Any) => { const kind: string = typeof x; return kind === "bigint" ? (x as bigint) + 1n : kind; });
show("switched", (x: Any) => { switch (typeof x) { case "string": return x.length; case "number": return x + 1; case "function": return x(); case "object": return x === null ? "null" : Object.keys(x).length; case "bigint": return x * 2n; default: return String(x); } });
show("switched on what is kept", (x: Any) => { const kind = typeof x; switch (kind) { case "string": return (x as string).length; case "boolean": return !x; default: return kind; } });
function either(x: string | number[]): number { switch (typeof x) { case "string": return x.length; case "object": return x.length + 100; } }
console.log(either("abc"), either([1, 2]));
function lying(x: string): string { const kind = typeof x; return kind === "string" ? "text" : `a ${kind} where the type says text`; }
try { console.log(lying(JSON.parse("5"))); } catch (error) { console.log((error as Error).constructor.name); }
//// array-is-array-narrows-a-union.ts
function lengthOf(value: string | number[]): number {
  if (Array.isArray(value)) return value.length;
  return -value.length;
}

function firstOf(value: string | number[] | undefined): number | string {
  if (!Array.isArray(value)) return value === undefined ? "none" : value;
  return value[0];
}

class Stack extends Array<number> {
  top(): number {
    return this[this.length - 1];
  }
}

function describe(value: Stack | string): string {
  return Array.isArray(value) ? `list of ${value.length}, top ${value.top()}` : `text ${value}`;
}

const many = process.argv.length > 100;
console.log(lengthOf(many ? "x" : [1, 2, 3]), lengthOf(many ? [1] : "four"));
console.log(firstOf(many ? "x" : [7, 8]), firstOf(many ? [1] : "text"), firstOf(undefined));
const stack = new Stack();
stack.push(4, 5);
console.log(describe(stack), describe("plain"));
console.log(ArrayBuffer.isView(many ? "x" : new Uint8Array(2)), ArrayBuffer.isView(many ? new DataView(new ArrayBuffer(1)) : "x"));
//// callable-proxies.ts
function make() {
  return new Proxy(function () { return 1; }, {});
}
const p = make();
console.log(typeof p);
console.log(typeof p === "function");
if (typeof p === "function") console.log("callable", p());
else console.log("not callable");
const q = new Proxy(class A {}, {});
console.log(typeof q, typeof q === "function" ? new q().constructor.name : "no");
function kind(x: unknown): string {
  return typeof x === "function" ? "f" : typeof x === "object" ? "o" : "p";
}
console.log(kind(p), kind(new Proxy({}, {})), kind(new Proxy([], {})));
function call(f: Function | string): unknown {
  return typeof f === "function" ? f() : f;
}
console.log(call(p), call("text"));
import { inspect, types } from "node:util";
console.log(types.isProxy(p), inspect(p, { showProxy: true }), inspect(p));
function shown(f: () => number): string {
  return inspect(f, { showProxy: true });
}
console.log(shown(p), shown(() => 2));
//// classes-that-are-told-by-their-class-info.ts
// The classes of the engine whose instances have no kind of cell of their own: WeakRef, FinalizationRegistry, Intl.DateTimeFormat, Intl.NumberFormat, generators, bound functions.
// A parameter of such a type is handed instances, instances of classes below, objects that only have the prototype, and everything else.
class Reference extends WeakRef<object> {}
class Registry extends FinalizationRegistry<number> {}
class Dates extends Intl.DateTimeFormat {}
class Numbers extends Intl.NumberFormat {}
const kept = { a: 1 };
function* count(to: number): Generator<number> {
  for (let k = 0; k < to; k++) yield k;
}
function named(this: unknown, a: number, b: number): number {
  return a + b;
}

function alive(reference: WeakRef<object>): boolean {
  return reference.deref() === kept;
}
function registers(registry: FinalizationRegistry<number>): boolean {
  registry.register(kept, 1, kept);
  return registry.unregister(kept);
}
function zone(dates: Intl.DateTimeFormat): string {
  return dates.resolvedOptions().timeZone;
}
function digits(numbers: Intl.NumberFormat): string {
  return numbers.format(1234.5);
}
function total(steps: Generator<number>): number {
  let sum = 0;
  for (const step of steps) sum += step;
  return sum;
}
function totalOfAny(steps: IterableIterator<number>): number {
  let sum = 0;
  for (const step of steps) sum += step;
  return sum;
}

function values(): any[] {
  return [
    new WeakRef(kept), new Reference(kept), Object.create(WeakRef.prototype),
    new FinalizationRegistry<number>(() => {}), new Registry(() => {}), Object.create(FinalizationRegistry.prototype),
    new Intl.DateTimeFormat("en-US", { timeZone: "UTC" }), new Dates("en-US", { timeZone: "UTC" }), Object.create(Intl.DateTimeFormat.prototype),
    new Intl.NumberFormat("en-US"), new Numbers("en-US"), Object.create(Intl.NumberFormat.prototype),
    count(4), Object.create(count.prototype), Object.setPrototypeOf(count(3), null), [1, 2, 3].values(), new Set([5, 6]).values(), new Map([[7, 8]]).keys(), "12"[Symbol.iterator](),
    named.bind(null, 1), named, () => 1, kept, {}, [], new Map(), new Proxy(new WeakRef(kept), {}), undefined, null, 0, "text", Symbol.iterator, 1n,
  ];
}
const asked: Record<string, (value: any) => unknown> = { alive, registers, zone, digits, total, totalOfAny };
for (const name of Object.keys(asked)) {
  const answers: string[] = [];
  const size = values().length;
  for (let round = 0; round < 3; round++) {
    for (let which = 0; which < size; which++) {
      let answer: string;
      try {
        answer = String(asked[name](values()[which]));
      } catch (error) {
        answer = "!" + (error as Error).constructor.name;
      }
      if (round === 2) answers.push(answer);
    }
  }
  console.log(name + ": " + answers.join(" "));
}
console.log(values().map(value => (typeof value === "function" ? value.name + "/" + value.length : typeof value)).join(" "));
//// instanceof-asks-a-method-defined-by-a-descriptor-on-what-a-bound-function-was-made-of.js
// `value instanceof bound` asks Symbol.hasInstance of the function that was bound. Here that is a method written in a descriptor, and the same test is also given a bound proxy. The method is called, so it is part of the executable.
function ask(value, ctor) { return value instanceof ctor; }
let calls = 0;
const D = () => {};
Object.defineProperty(D, Symbol.hasInstance, { value(value) { calls++; return value === 1; } });
const boundD = D.bind();
try { console.log("bound", ask(1, boundD), ask(2, boundD), calls); } catch (e) { console.log("bound threw", String(e).slice(0, 70)); }
const arrow = () => {};
const proxy = new Proxy(arrow, { get(target, key, receiver) { return Reflect.get(target, key, receiver); } });
const boundProxy = proxy.bind();
try { console.log("proxy", ask(1, boundProxy)); } catch (e) { console.log("proxy threw", String(e).slice(0, 70)); }
//// instanceof-on-functions-that-stand-under-functions.js
// Constructor functions that stand under other functions (Object.setPrototypeOf(Below, Above), as node's streams do), asked with instanceof from inside and outside: the answer follows
// Symbol.hasInstance wherever it appears on the chain of functions, the prototype property, and the chain of the value, whenever any of them changes.
function Root() { if (!(this instanceof Root)) return { refusedBy: "Root" }; this.root = 1; }
function Middle() { if (!(this instanceof Middle)) return { refusedBy: "Middle" }; Root.call(this); this.middle = 1; }
function Leaf() { if (!(this instanceof Leaf)) return { refusedBy: "Leaf" }; Middle.call(this); this.leaf = 1; }
function OnlyBase() { if (!(this instanceof OnlyBase)) return "called without new"; this.base = 1; }
function Heir() { OnlyBase.call(this); this.heir = 1; }
function Alone() { this.alone = 1; }
for (const [below, above] of [[Middle, Root], [Leaf, Middle], [Heir, OnlyBase]]) { Object.setPrototypeOf(below.prototype, above.prototype); Object.setPrototypeOf(below, above); }
const all = { Root, Middle, Leaf, OnlyBase, Heir, Alone };
function ask(v) { let line = ""; for (const name in all) line += v instanceof all[name] ? "1" : "0"; return line; }
function askEach(v) { return [v instanceof Root, v instanceof Middle, v instanceof Leaf, v instanceof OnlyBase, v instanceof Heir, v instanceof Alone].map(Number).join(""); }
function attempt(run) { try { return run(); } catch (e) { return e.constructor.name; } }
function make() { return [() => new Root(), () => new Middle(), () => new Leaf(), () => new Heir(), () => new Alone(), () => Root(), () => Middle(), () => Leaf(), () => ({}), () => null, () => 5, () => Object.create(Leaf.prototype), () => Object.create(null), () => Leaf, () => Leaf.prototype].map(attempt); }
function round(title) { let line = ""; for (let i = 0; i < 40; i++) line = make().map(v => (typeof v === "string" ? v : "") + ask(v) + "/" + askEach(v)).join(" "); console.log(title + ": " + line); }
round("as made");
console.log(OnlyBase(), typeof OnlyBase.call({}), Heir.prototype instanceof OnlyBase);
Object.defineProperty(Root, Symbol.hasInstance, { value: v => v === 5, configurable: true }); round("the top function answers for itself and for all below");
delete Root[Symbol.hasInstance]; round("no longer");
Object.defineProperty(Middle, Symbol.hasInstance, { value: () => true, configurable: true }); round("the middle one says yes");
delete Middle[Symbol.hasInstance]; round("no longer");
const between = Object.create(Root, { [Symbol.hasInstance]: { value: () => false, configurable: true } }); Object.setPrototypeOf(Middle, between); round("an object between two functions says no");
delete between[Symbol.hasInstance]; round("it says nothing");
Object.setPrototypeOf(Middle, Function.prototype); round("the middle one stands alone");
Object.setPrototypeOf(Middle, Root); round("and under the top again");
Object.setPrototypeOf(Leaf, null); let thrown; try { ({}) instanceof Leaf; thrown = "no"; } catch (e) { thrown = e.constructor.name; } console.log("a function under nothing:", thrown, new (Object.setPrototypeOf(Leaf, Middle))() instanceof Leaf);
const oldPrototype = Middle.prototype; Middle.prototype = { fresh: true }; round("another prototype property");
Middle.prototype = oldPrototype; round("the old one again");
Object.setPrototypeOf(Leaf.prototype, Root.prototype); round("the chain of the values skips the middle");
Object.setPrototypeOf(Leaf.prototype, Middle.prototype); round("and has it again");
Object.defineProperty(OnlyBase, Symbol.hasInstance, { value: () => true, configurable: true }); console.log(attempt(() => OnlyBase.call(5) === undefined), 5 instanceof OnlyBase, 5 instanceof Heir); round("the base that makes nothing says yes");
delete OnlyBase[Symbol.hasInstance]; console.log(new OnlyBase().base, ask(new OnlyBase())); round("and now it has made one");
//// library-cell-type-tests.ts
import { inspect, promisify } from "node:util";

class Deferred extends Promise<number> {}
class Rows extends Array<number> {}
class Index extends Map<string, number> {}

console.log(Bun.peek(Promise.resolve(5)), Bun.peek(7), Bun.peek(Deferred.resolve(6)));
console.log(Bun.peek.status(Promise.resolve(1)), Bun.peek.status(new Promise(() => {})), Bun.peek.status("text" as never));
console.log(inspect([1, 2, new Map([[1, 2]]), new Set([3])]));
console.log(inspect(Rows.from([1, 2])), inspect(new Index([["a", 1]])));
console.log(inspect(new Proxy([1], {}), { showProxy: true }), inspect(new Proxy({ a: 1 }, {})));
console.log(Buffer.from(new Uint8Array([1, 2])), Buffer.from(new Float32Array([1])).length, Buffer.from(new DataView(new ArrayBuffer(2)) as never).length);
new Map([[1, 2]]).forEach((value, key) => console.log(key, value));
try {
  Map.prototype.forEach.call(new Set([1]), () => {});
} catch (error) {
  console.log((error as Error).name);
}
const sleep = promisify((done: (error: null, value: number) => void) => done(null, 3));
console.log(await sleep());
//// lists-of-classes-below-array.ts
// An instance of a class of the program below Array is an array: Array.isArray says so in place, through a parameter declared as the class or a string, below two classes, and in a loop.
class Stack extends Array<number> {}
const s = new Stack();
console.log(Array.isArray(s));
function f(x: Stack | string) { return Array.isArray(x) ? "list" : "text"; }
console.log(f(s), f("t"));
class Deep extends Stack { extra = 1; }
function g(x: Deep | number | null) { return Array.isArray(x) ? "list" : "other"; }
console.log(g(new Deep()), g(5), g(null), Array.isArray(new Deep()));
let lists = 0;
for (let i = 0; i < 20000; i++) { if (Array.isArray(i & 1 ? s : "t")) lists++; if (f(i & 1 ? s : "t") === "list") lists++; }
console.log(lists);
//// methods-of-dates-that-are-not-plain.ts
// The members of Date.prototype are fixed in a compiled program, so a call on a parameter declared as a Date goes to the built-in function. Not where one date has a property of that name, where a class below Date has the method, where another prototype lies above the date, or where the value is a Proxy or no date at all.
const log: string[] = [];
function time(d: Date): number { return d.getTime(); }
function year(d: Date): number { return d.getUTCFullYear(); }
function iso(d: Date): string { return d.toISOString(); }
function json(d: Date): string | null { return d.toJSON(); }
function plus(d: Date): number { return +d; }
function minus(a: Date, b: Date): number { return (a as any) - (b as any); }
function less(a: Date, b: Date): boolean { return a < b; }
