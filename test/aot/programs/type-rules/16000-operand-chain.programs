//// checks-inside-async-functions.ts
// Inside an async function every declared place checks what enters it: parameters of calls through a variable, annotated variables, results of untyped calls and property reads, ahead of and behind an await, inside try blocks and loops.
interface Entry { name: string; tags: string[] }
class Holder { constructor(public held: number) {} }

const untyped: any = {
  text: "text", count: 3, list: ["a", "b"], entry: { name: "n", tags: ["t"] }, holder: new Holder(5), nothing: undefined, call: () => 2,
  give(key: string) { return this[key]; },
};

async function takesText(value: string): Promise<string> { return "text " + value.length; }
async function takesOptionalText(value?: string): Promise<string> { return value === undefined ? "nothing" : "text " + value.length; }
async function takesList(value: string[]): Promise<string> { return "list " + value.length; }
async function takesHolder(value: Holder): Promise<string> { return "holder " + value.held; }
async function takesFunction(value: (x: number) => number): Promise<string> { return "function " + value(1); }
async function takesTwo(first: string, second: string[]): Promise<string> { await null; return first + second.length; }

async function aheadOfTheAwait(key: string): Promise<string> {
  const value: string = untyped[key];
  await null;
  return "ahead " + value.length;
}
async function behindTheAwait(key: string): Promise<string> {
  await null;
  const value: string = untyped[key];
  return "behind " + value.length;
}
async function listBehindTheAwait(key: string): Promise<string> {
  await null;
  const value: string[] = untyped.give(key);
  return "list behind " + value.length;
}
async function optionalBehindTheAwait(key: string): Promise<string> {
  await null;
  const value: string | undefined = untyped.give(key);
  return "optional behind " + (value === undefined ? "nothing" : value.length);
}
async function holderBehindTheAwait(key: string): Promise<string> {
  await null;
  const value: Holder = untyped.give(key);
  return "holder behind " + value.held;
}
async function inATry(key: string): Promise<string> {
  await null;
  try {
    const value: string = untyped.give(key);
    return "fine " + value.length;
  } catch (error) {
    return "caught " + (error as Error).name;
  }
}
async function inALoop(keys: string[]): Promise<string> {
  await null;
  let sum = 0;
  for (const key of keys) {
    const value: string = untyped.give(key);
    sum += value.length;
  }
  return "sum " + sum;
}
async function result(key: string): Promise<string> {
  await null;
  return untyped.give(key);
}

async function row(name: string, run: () => Promise<unknown>): Promise<void> {
  try {
    const value = await run();
    console.log(name, typeof value === "function" ? "a function" : String(value));
  } catch (error) {
    console.log(name, "threw", (error as Error).name);
  }
}
async function main(): Promise<void> {
  const byValue: Record<string, (...given: any[]) => Promise<string>> = { takesText, takesOptionalText, takesList, takesHolder, takesFunction, takesTwo };
  for (const key of ["text", "count", "list", "entry", "holder", "nothing", "call"]) {
    for (const name of ["takesText", "takesOptionalText", "takesList", "takesHolder", "takesFunction"]) await row(name + " " + key, () => byValue[name](untyped[key]));
    await row("takesTwo text " + key, () => byValue.takesTwo("t", untyped[key]));
    await row("takesTwo " + key + " list", () => byValue.takesTwo(untyped[key], ["l"]));
    for (const run of [aheadOfTheAwait, behindTheAwait, listBehindTheAwait, optionalBehindTheAwait, holderBehindTheAwait, inATry, result]) await row(run.name + " " + key, () => run(key));
  }
  await row("takesText, no argument", () => byValue.takesText());
  await row("takesOptionalText, no argument", () => byValue.takesOptionalText());
  await row("in a loop", () => inALoop(["text", "text"]));
  await row("in a loop, the second is wrong", () => inALoop(["text", "count", "text"]));
}
main();
//// claim-every-type-kind.ts
// Each written type tests every kind of value: once from cold code and in a hot loop.
// A literal type tests the kind of the primitive only, in a parameter as in a cast.
interface HasX { x: number }
class K { x = 1 }
class ArraySubclass extends Array {}

function takesNumber(x: number) { return x }
function takesSmallIntegers(x: 0 | 1 | 2) { return x }
function takesPositiveIntegers(x: 1 | 2 | 3) { return x }
function takesBoolean(x: boolean) { return x }
function takesTrue(x: true) { return x }
function takesString(x: string) { return x }
function takesLiterals(x: "a" | "b") { return x }
function takesSymbol(x: symbol) { return x }
function takesBigInt(x: bigint) { return x }
function takesObject(x: object) { return x }
function takesInterface(x: HasX) { return x }
function takesClass(x: K) { return x }
function takesArray(x: unknown[]) { return x }
function takesMap(x: Map<string, number>) { return x }
function takesDate(x: Date) { return x }
function takesFunction(x: () => void) { return x }
function takesOptionalNumber(x: number | undefined) { return x }
function takesRequest(x: Request) { return x }
function castsNumberToSmallIntegers(x: number) { return x as 0 | 1 | 2 }
function castsNumberToPositiveIntegers(x: number) { return x as 1 | 2 | 3 }
function castsBooleanToTrue(x: boolean) { return x as true }
function castsStringToLiterals(x: string) { return x as "a" | "b" }
function castsLiteralsToFewer(x: "a" | "b" | "c") { return x as "a" | "b" }
function castsLiteralsToNumber(x: "a" | "b") { return (x as unknown) as number }

const values: any[] = [
  undefined, null, true, false, 0, -0, 1.5, NaN, 2 ** 31, 2 ** 53,
  "", "a", Symbol(), 1n, {}, [], new ArraySubclass(), function () {}, class {}, new Map(),
  new Date(0), /x/, Promise.resolve(), new Proxy({}, {}), 2, new K(), () => 1, new Proxy(function () {}, {}), Object.create(null), new Request("http://localhost/"),
  "c",
]

const checks: [string, (x: any) => unknown][] = [
  ["number", takesNumber],
  ["0 | 1 | 2", takesSmallIntegers],
  ["1 | 2 | 3", takesPositiveIntegers],
  ["boolean", takesBoolean],
  ["true", takesTrue],
  ["string", takesString],
  ['"a" | "b"', takesLiterals],
  ["symbol", takesSymbol],
  ["bigint", takesBigInt],
  ["object", takesObject],
  ["interface", takesInterface],
  ["class", takesClass],
  ["unknown[]", takesArray],
  ["Map", takesMap],
  ["Date", takesDate],
  ["() => void", takesFunction],
  ["number | undefined", takesOptionalNumber],
  ["Request", takesRequest],
  ["number as 0 | 1 | 2", castsNumberToSmallIntegers],
  ["number as 1 | 2 | 3", castsNumberToPositiveIntegers],
  ["boolean as true", castsBooleanToTrue],
  ['string as "a" | "b"', castsStringToLiterals],
  ['"a" | "b" | "c" as "a" | "b"', castsLiteralsToFewer],
  ['"a" | "b" as number', castsLiteralsToNumber],
]

function outcome(check: (x: any) => unknown, value: any, iterations: number): string {
  try {
    for (let i = 0; i < iterations; i++) check(value)
    return "ok"
  } catch (error: any) {
    return error.name
  }
}

for (const [name, check] of checks) {
  console.log(name, "once:", values.map(value => outcome(check, value, 1)).join(" "))
  console.log(name, "hot:", values.map(value => outcome(check, value, 2000)).join(" "))
}
//// class-accessors.ts
// Classes with accessors that the program redefines or deletes, on instances and on the prototype.
interface Sized { size: number }
const seen: string[] = []
function flush(): string { return seen.splice(0).join(",") }
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
class Bag implements Sized {
  items: number[] = []
  get size(): number { seen.push("get"); return this.items.length }
  set size(n: number) { seen.push("set" + n); this.items.length = n }
}
class Half extends Bag { override get size(): number { return super.size + 100 } }
class Both extends Bag {
  override get size(): number { return super.size * 2 }
  override set size(n: number) { super.size = n + 1 }
}
function grow(s: Sized): number { s.size += 2; return s.size }
const shadowed = new Bag()
try { Object.defineProperty(shadowed, "size", { value: 7, writable: true, enumerable: true, configurable: true }); console.log("own data property in front of the accessor: no error") } catch (e) { console.log("own data property in front of the accessor:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(grow(shadowed), flush(), Object.keys(shadowed).join(), shadowed.items.length)
// A getter that turns itself into a data property.
class LazyBox {
  get value(): number { seen.push("compute"); Object.defineProperty(this, "value", { value: 5, enumerable: true }); return 5 }
}
const lazy = new LazyBox()
try { lazy.value; console.log("getter that turns itself into a data property: no error") } catch (e) { console.log("getter that turns itself into a data property:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(flush(), Object.keys(lazy).length, Object.hasOwn(lazy, "value"))
// The accessor of the class is replaced, made a data property, deleted.
const before = new Bag()
try { Object.defineProperty(Bag.prototype, "size", { get() { seen.push("patched"); return -1 }, configurable: true }); console.log("accessor replaced on the prototype: no error") } catch (e) { console.log("accessor replaced on the prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(before.size, new Bag().size, attempt(() => grow(before)), new Half().size, new Both().size, flush())
try { Object.defineProperty(Bag.prototype, "size", { value: 12, writable: true, configurable: true }); console.log("accessor made a data property on the prototype: no error") } catch (e) { console.log("accessor made a data property on the prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(before.size, grow(before), Object.keys(before).join(), new Bag().size, new Half().size, flush())
try { delete (Half.prototype as any).size; console.log("accessor deleted from the prototype: no error") } catch (e) { console.log("accessor deleted from the prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(new Half().size, attempt(() => grow(new Half())), attempt(() => grow(new Both())), flush())
// A subclass overrides only the setter: the property it defines has no getter, so a read gives `undefined`, which passes every written type. TypeScript gives the read the type `number`.
class Cup { n = 1; get size(): number { return this.n } set size(v: number) { this.n = v } }
class SetterOnly extends Cup { override set size(v: number) { super.size = v + 1 } }
function sizeOf(c: Cup): number { return c.size }
try { console.log(sizeOf(new SetterOnly())); console.log("read of an accessor whose getter was overridden away: no error") } catch (e) { console.log("read of an accessor whose getter was overridden away:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(sizeOf(new Cup()))
//// classes-implementing-interfaces.ts
// A method taken off its class and called on an object that is not an instance of the class throws a TypeError.
class Square {
  sides = 4
  constructor(public edge: number) {}
  area() { return this.edge * this.edge }
}
class Framed extends Square {
  frame = 1
  override area() { return super.area() + this.frame }
}
const area = Square.prototype.area
try { console.log(area.call({ edge: 3 })); console.log("method of a class on a literal: no error") } catch (e) { console.log("method of a class on a literal:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { console.log(Framed.prototype.area.call({ edge: 2, frame: 5 })); console.log("method of a subclass on a literal: no error") } catch (e) { console.log("method of a subclass on a literal:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { console.log(Framed.prototype.area.call(new Square(2))); console.log("method of a subclass on an instance of the base: no error") } catch (e) { console.log("method of a subclass on an instance of the base:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(area.call(new Framed(4)), area.call(new Square(3)))
//// comparing-fresh-objects-js.js
// In plain JavaScript, TypeScript's advice that two fresh objects are never equal (TS2839) is a warning: the program is valid and is built.
console.log({} !== {}, [] == [], {} === {}, /a/ != /a/, [1] === [1]);
if ({} === {}) console.log("never");
else console.log("compared by reference");
//// comparing-fresh-objects-ts.ts
// In TypeScript, TS2839 is a type error like any other and stops the build.
console.log({} !== {});
//// computed-and-special-keys.ts
// `__proto__ =` on a typed object, optional fields named like members of `Object.prototype`, and a field that is inherited behave as in plain JavaScript.
interface Base1 { inherited: string }
const base1: Base1 = { inherited: "yes" }
const target1: { own: number } = { own: 3 }
try { (target1 as any).__proto__ = base1; console.log("__proto__ = an object: no error") } catch (e) { console.log("__proto__ = an object:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(Object.keys(target1).join(), (target1 as any).inherited, Object.getPrototypeOf(target1) === Object.prototype, target1.own)
try { (target1 as any).__proto__ = 5; console.log("__proto__ = 5: no error") } catch (e) { console.log("__proto__ = 5:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(Object.getPrototypeOf(target1) === Object.prototype, Object.keys(target1).join())
// An optional field that is absent, under a name that Object.prototype has, is looked for on the prototype chain, by typed code
// as by code that has been handed the object as `any`.
function hide(x: unknown): any { return x }
interface Shadow { hasOwnProperty: number; valueOf?: () => unknown; toString?: () => string }
const shadow: Shadow = { hasOwnProperty: 1 }
console.log(typeof shadow.valueOf, typeof shadow.toString, typeof (shadow as any).valueOf, typeof hide(shadow).valueOf, typeof hide(shadow).toString)
shadow.valueOf = () => 42
console.log(typeof shadow.valueOf, +shadow + 1)
delete shadow.valueOf
console.log(typeof shadow.valueOf, shadow.valueOf === Object.prototype.valueOf, hide(shadow).valueOf === Object.prototype.valueOf)
// A field that the object inherits is read through the declared type.
function depthOf(v: { depth: number }): number { return v.depth }
try { console.log("inherited depth: no error", depthOf(Object.create({ depth: 8 }))) } catch (e) { console.log("inherited depth:", e instanceof TypeError ? "TypeError" : "other " + e) }
//// constant-keys-requiring-brackets.ts
class Vault {
  private secret = "hidden";
  protected guarded = "kept";
  private open(): string {
    return this.secret + "!";
  }
}
const vault = new Vault();
console.log(vault["secret"], vault["guarded"], vault["open"]());

function pick<T extends { size: number }>(from: T): T["size"] {
  return from["size"];
}
console.log(pick({ size: 3, more: true }));

function store<T extends { size: number }>(into: T, size: T["size"]): T {
  into["size"] = size;
  return into;
}
console.log(store({ size: 3 }, 4)["size"]);

const table: Record<string, number> = { one: 1 };
console.log(table["one"], table["two"]);

function nameOf(it: { name: string } | { name: number }): number {
  return typeof it["name"] === "string" ? it["name"].length : it["name"] + 1;
}
console.log(nameOf({ name: "four" }), nameOf({ name: 4 }));

function narrowed(it: { kind: "a"; a: number } | { kind: "b"; b: string }): number | string {
  return it["kind"] === "a" ? it.a : it["b"];
}
console.log(narrowed({ kind: "a", a: 1 }), narrowed({ kind: "b", b: "two" }));

enum Color {
  Red,
  Green,
}
console.log(Color["Green"], Color[Color["Green"]]);

const enum Flag {
  On = 1,
}
console.log(Flag["On"]);

class Late {
  value!: number;
  constructor() {
    console.log(this["value"]);
    this["value"] = 1;
  }
}
console.log(new Late()["value"]);

const loose: any = { deep: { deeper: 5 } };
console.log(loose["deep"]["deeper"], loose["absent"]);

const tuple: [number, string] = [1, "two"];
console.log(tuple["length"], tuple["0"], tuple["1"]);

const byName: Record<string, number> = { one: 1 };
console.log(byName["one"]! < 2, byName["two"]! < 2, byName["two"]! + 1);
console.log(byName.one! < 2, byName.two! < 2, byName.two! + 1);
