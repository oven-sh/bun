//// a-type-that-is-written-out-is-compared-to-its-end-whoever-made-it-first/main.ts
// reader.ts writes `Box<[[[number]]]>` out and then compares `Box<number>` with `Crate<number>`, which differ at that depth: a type that is written out is compared to its end, so the build stops, as it does where reader.ts stands alone. bystander.ts, which is checked first, makes the same type by instantiation, and that changes nothing.
import { convert, depth } from "./reader";
import { other } from "./bystander";
const deep = { v: [[[1]]] as [[[number]]], next: null };
console.log(depth(deep), other({ make: () => deep }), convert({ v: 1, next: null }).v);
//// a-type-that-is-written-out-is-compared-to-its-end-whoever-made-it-first/reader.ts
import type { Box, Crate } from "./shared";
type Repeat<N extends number, M, A extends unknown[] = []> = A["length"] extends N ? A : Repeat<N, M, [...A, M]>;
export function depth(x: Box<[[[number]]]>): unknown { return x.v; }
export function convert(b: Box<number>): Crate<number> { return b; }
//// a-type-that-is-written-out-is-compared-to-its-end-whoever-made-it-first/shared.ts
export interface Box<T> { v: T; next: Box<[T]> | null }
export interface Crate<T> { v: T extends [[[infer _]]] ? string : T; next: Crate<[T]> | null }
