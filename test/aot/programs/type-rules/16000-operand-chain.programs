//// accessor-reads-beside-field-reads.ts
// A read of a member that its class declares as an accessor tests nothing: the getter tests what it returns. The same read of a declared field throws.
const text: any = "text";
////= attempt-2
class Gauge {
  count: number = 1;
  get level(): number { return 2; }
  get broken(): number { return text; }
}
const lookalike: any = { count: "text", level: "text" };
function readField(gauge: Gauge) { return typeof gauge.count; }
function readAccessor(gauge: Gauge) { return typeof gauge.level; }
function readAccessorIntoNumber(gauge: Gauge) { const n: number = gauge.level; return typeof n; }

attempt("a field of an instance", () => readField(new Gauge()));
attempt("an accessor of an instance", () => readAccessor(new Gauge()));
attempt("a field, and the object holds a string there", () => readField(lookalike));
attempt("an accessor, and the object holds a string there", () => readAccessor(lookalike));
attempt("the same read into an annotated variable", () => readAccessorIntoNumber(lookalike));
attempt("a getter that returns a string", () => typeof new Gauge().broken);
//// always-throws-under-a-comment-directive.ts
// `// @ts-expect-error` and `// @ts-ignore` silence every diagnostic on the next line, "this always throws a TypeError under --aot"
// among them: whoever wrote the comment knows that the line is ill-typed, and the line may never run. The build goes on. What the
// line does when it runs is unchanged: the argument is still held to the parameter's type.
interface Matcher {
  kind: string;
}
function match(pattern: Matcher, handler: () => number[]): number[] {
  return pattern.kind ? handler() : [];
}
function underExpectError() {
  // @ts-expect-error
  return match(1, () => [1, 2]);
}
function underIgnore() {
  // @ts-ignore
  return match(2, () => [1, 2]);
}
function insideAnExpression() {
  return [
    // @ts-expect-error: a reason
    match(3, () => [1, 2]),
  ];
}
function neverCalled() {
  // @ts-expect-error
  return match(4, () => [1, 2]);
}
for (const call of [underExpectError, underIgnore, insideAnExpression]) {
  try {
    console.log(call.name, "returned", JSON.stringify(call()));
  } catch (error) {
    console.log(call.name, "threw a TypeError:", error instanceof TypeError);
  }
}
console.log(typeof neverCalled, JSON.stringify(match({ kind: "k" }, () => [1, 2])));
//// an-assertion-picks-a-member-of-a-union.ts
// `value as Leaf` with `value: Leaf | Opaque` picks the Leaf, so the type Leaf stands for a Leaf alone. A value that is declared Opaque and is something else, or is a Root,
// still goes through the cast as it does in plain Bun: reads and stores find what the object has.
interface Opaque { readonly mark?: never }
class Leaf { size: number; constructor(size: number) { this.size = size; } }
class Root { name = "root"; size = "wide"; }
const hidden = (value: unknown): any => value;
function sizeOf(value: Leaf | Opaque | null): unknown { return (value as Leaf).size; }
function rename(value: Root | Opaque): unknown { (value as Root).name = "renamed"; return (value as Root).name; }
function both(value: Leaf | Root | Opaque): unknown { return String((value as Leaf).size) + " " + String((value as Root).name); }
const attempt = (f: () => unknown): unknown => { try { return f(); } catch (error) { return (error as Error).name; } };
const host: Opaque = hidden({ other: 1 });
const rootAsOpaque: Opaque = hidden(new Root());
const frozen: Opaque = hidden(Object.freeze({ name: "fixed" }));
for (let round = 0; round < 4; round++) {
  console.log(sizeOf(new Leaf(round)), sizeOf(host), sizeOf(rootAsOpaque), sizeOf(hidden("text")), sizeOf(hidden(round)));
  console.log(rename(new Root()), rename(host), rename(hidden(new Leaf(7))), attempt(() => rename(frozen)), JSON.stringify(host));
  console.log(both(new Leaf(round)), "|", both(new Root()), "|", both(host), "|", both(hidden([1, 2])));
}
console.log(attempt(() => sizeOf(null)), attempt(() => rename(hidden(undefined))));
//// an-object-born-with-never-and-null-fields-is-filled-through-a-wider-view.ts
// Strict TypeScript: an object is born with a field of never[] and one of null, and both are filled through a wider view of it.
function either(n: number, c: boolean) {
  const kept = c ? { last: null } : { list: [] };
  const lists: { list?: number[] } = kept;
  const lasts: { last?: unknown } = kept;
  if (lists.list) lists.list.push(n);
  else lasts.last = n;
  return kept;
}
function state(n: number) {
  const kept = { last: null, list: [] };
  const view: { last: unknown; list: number[] } = kept;
  view.last = n;
  view.list.push(n);
  return kept;
}
let sum = 0;
for (let i = 0; i < 3000; i++) {
  const a = either(i, i % 2 === 0);
  const b = state(i);
  const first: unknown = a.list ? a.list[0] : a.last;
  const second: unknown = b.list[0];
  const third: unknown = b.last;
  if (typeof first === "number") sum += first;
  if (typeof second === "number") sum += second;
  if (typeof third === "number") sum += third;
  if (a.last === null || b.last === null) sum -= 1000000;
}
console.log(sum, JSON.stringify(either(5, true)), JSON.stringify(either(6, false)), JSON.stringify(state(7)));
