// An array or typed array with its own Symbol.iterator, from a subclass or stored on the value. `for...of`, destructuring and spread call it at every declared type, as in plain Bun.
class Heir extends Array<number> { *[Symbol.iterator](): ArrayIterator<number> { yield 7; yield 8; } }
class Bytes extends Uint8Array { *[Symbol.iterator](): ArrayIterator<number> { yield 5; } }
function attempt(name: string, f: () => unknown): void {
  try { console.log(name + ":", JSON.stringify(f())); } catch (e) { console.log(name + ":", e instanceof Error ? e.name + ": " + e.message.split(" (bun compile")[0] : String(e)); }
}
const heir: number[] = new Heir(1, 2);
const own: number[] = [1, 2];
(own as any)[Symbol.iterator] = function* () { yield 9; };
const pair: [number, number] = [1, 2];
(pair as any)[Symbol.iterator] = function* () { yield 9; yield 10; };
const bytes: Uint8Array = new Bytes(2);
const ordinary: number[] = [1, 2];

attempt("names", () => { const [a, b] = heir; return [a, b]; });
attempt("a rest element", () => { const [a, ...rest] = heir; return [a, rest]; });
attempt("defaults", () => { const [a = 3, b = 4, c = 5] = heir; return [a, b, c]; });
attempt("an assignment", () => { let a = 0, b = 0; [a, b] = heir; return [a, b]; });
attempt("a parameter", () => (([a, b]: number[]) => [a, b])(heir));
attempt("for...of", () => { let sum = 0; for (const x of heir) sum += x; return sum; });
attempt("an iterator stored on the array, names", () => { const [a] = own; return a; });
attempt("an iterator stored on the array, for...of", () => { let sum = 0; for (const x of own) sum += x; return sum; });
attempt("a tuple, names", () => { const [a, b] = pair; return [a, b]; });
attempt("a typed array, for...of", () => { let sum = 0; for (const x of bytes) sum += x; return sum; });
attempt("a typed array, names", () => { const [a] = bytes; return a; });

attempt("spread", () => [...heir]);
attempt("spread into a call", () => Math.max(...heir));
attempt("Array.from", () => Array.from(heir));
attempt("new Set", () => [...new Set(heir)]);
attempt("by index", () => [heir[0], heir[1], heir.length]);

const iterable: Iterable<number> = new Heir(1, 2);
attempt("at Iterable<number>, names", () => { const [a, b] = iterable; return [a, b]; });
attempt("at Iterable<number>, for...of", () => { let sum = 0; for (const x of iterable) sum += x; return sum; });
attempt("at its own class, for...of", () => { let sum = 0; for (const x of new Heir(1, 2)) sum += x; return sum; });
attempt("an ordinary array", () => { const [a, b] = ordinary; let sum = 0; for (const x of ordinary) sum += x; return [a, b, sum]; });
//// arrays-filled-with-sums-of-their-own-elements.ts
function show(name: string, f: () => unknown) { try { console.log(name, String(f())); } catch (e) { console.log(name, "threw", (e as Error).constructor.name); } }

function pushed() { const parts = []; parts.push("a"); parts.push(parts[0] + parts[1]); parts.push(parts[7] + parts[8]); return parts.join("|") + " " + typeof parts[2]; }
function onlyStrings() { const parts = []; parts.push("a"); parts.push(parts[0] + "b"); parts.push("c" + parts[1]); return parts.join("|") + " " + typeof parts[2] + " " + parts[2].length; }
function byIndex() { const parts = []; parts[0] = "a"; parts[1] = parts[0] + parts[0]; parts[2] = parts[8] + parts[9]; return parts.join("|") + " " + typeof parts[2]; }
function unshifted() { const parts = []; parts.unshift("a"); parts.unshift(parts[5] + parts[6]); return parts.join("|") + " " + typeof parts[0]; }
function eachOther() { const left = []; const right = []; left.push("a"); right.push("b"); left.push(right[0] + "x"); right.push(left[3] + left[4]); left.push(right[1] + right[1]); return left.join("|") + " " + right.join("|") + " " + typeof left[2] + " " + typeof right[1]; }
function nested() { const rows = []; rows.push(["a"]); rows.push([rows[0][0] + rows[0][1]]); rows.push([rows[0][5] + rows[0][6]]); return rows.join("|") + " " + typeof rows[2][0]; }
function lengthOfElement() { const parts = []; parts.push("a"); parts.push(parts[3] + parts[4]); return parts[1].length; }
function inALoop(count: number) { const parts = []; parts.push("a"); for (let i = 0; i < count; i++) parts.push(parts[i] + parts[i + 2]); return parts.join("|") + " " + typeof parts[count]; }
function fromOutside(text: string) { const parts = []; parts.push("a"); parts.push(parts[0] + JSON.parse(text)); parts.push(JSON.parse(text)); parts.push(parts[2] + parts[2]); return parts.join("|") + " " + typeof parts[2] + " " + typeof parts[3]; }

show("pushed", pushed);
show("only strings", onlyStrings);
show("by index", byIndex);
show("unshifted", unshifted);
show("each other", eachOther);
show("nested", nested);
show("length of an element", lengthOfElement);
show("in a loop", () => inALoop(3));
show("from outside", () => fromOutside("4"));
//// as-after-tail-call.ts
// `as` around a tail call tests the result exactly as it does when the call is not a tail call, at every depth of the recursion: a primitive of another kind throws a TypeError, an object, `null` and `undefined` pass, and nothing is converted.
const untyped: any = {};
let bottom: any = 0;
function toNumber(n: number): number {
  if (n === 0) return untyped.give() as number;
  return untyped.toNumber(n - 1) as number;
}
function toText(n: number): string {
  if (n === 0) return untyped.give() as string;
  return untyped.toText(n - 1) as string;
}
Object.assign(untyped, { toNumber, toText, give: () => bottom });
const show = (value: unknown) => (typeof value === "symbol" || typeof value === "bigint" ? typeof value : `${typeof value} ${JSON.stringify(value)}`);
function numberAt(depth: number): string {
  const value = toNumber(depth);
  return show(value);
}
function textAt(depth: number): string {
  const value = toText(depth);
  return show(value);
}
for (const value of [1, 2.5, "5", "", true, null, undefined, {}, [7], 1n, Symbol.iterator]) {
  bottom = value;
  for (const depth of [0, 1, 3, 100000]) {
    for (const [name, call] of [["toNumber", numberAt], ["toText", textAt]] as [string, (depth: number) => string][]) {
      try {
        console.log(name, show(value), depth, "->", call(depth));
      } catch (error) {
        console.log(name, show(value), depth, "throws", (error as Error).constructor.name);
      }
    }
  }
}
//// asserted-objects-reach-other-places/main.ts
// An object that went through `as` is admitted by the place it reaches and by the place after that, in this file and in another one: functions, arrow functions in variables, methods, overriding methods, constructors, super(), static methods, accessors, rest parameters, private and static fields, captured variables, results, awaited results, yielded values. A place of the same type that only untyped values reach still tests them.
import { Widget, Panel, Cell, share, shared, forward, untouched, half, later, last, once, same, sameAgain, Taker, mix, type Setting, type Listener } from "./widgets";

function describe(value: unknown): string { return value === null ? "null" : Array.isArray(value) ? "array" : typeof value; }
function attempt(label: string, action: () => unknown): void {
  try { console.log(label + ":", describe(action())); } catch (error) { console.log(label + ":", (error as Error).constructor.name); }
}
const hide = (value: unknown): any => value;
const callback = () => 1;
const values: [string, unknown][] = [["a function", callback], ["an array", [1]], ["an object", { y: 1 }], ["a number", 7]];

for (const [label, value] of values) {
  attempt(label + " into a function of another file, a variable there and back", () => share(value as Setting));
  attempt(label + " read from that variable", () => shared);
  attempt(label + " through an arrow function on into a function", () => forward(value as Setting));
  attempt(label + " into a method and out of a field", () => { const widget = new Widget(); widget.put(value as Setting); return widget.get(); });
  attempt(label + " into an overriding method and its super method", () => { const widget: Widget = new Panel(0); widget.put(value as Setting); return widget.get(); });
  attempt(label + " into a constructor", () => new Widget(value as Setting).setting);
  attempt(label + " into a constructor and super()", () => new Panel(value as Setting).get());
  attempt(label + " into a private field", () => new Widget().hide(value as Setting));
  attempt(label + " into a static method and a static field", () => Widget.remember(value as Setting));
  attempt(label + " into a captured variable", () => { let held: Setting = 0; const set = (next: Setting) => { held = next; }; set(value as Setting); return held; });
  attempt(label + " into a function declared in a function", () => { function inner(next: Setting): Setting { return next; } const call = () => inner(value as Setting); return call(); });
  attempt(label + " into a setter and out of a getter", () => { const cell = new Cell(); cell.value = value as Setting; const got: Setting = cell.value; return got; });
  attempt(label + " into a rest parameter", () => last(1, value as Setting));
  attempt(label + " out of a generator", () => { let got: Setting = 0; for (const item of once(value)) got = item; return got; });
  attempt(label + " into one of two functions", () => { const chosen = label.length > 100 ? forward : share; return chosen(value as Setting); });
  attempt(label + " as a function type into a method and a field", () => new Widget().listen(value as Listener));
  attempt(label + " into the overriding method of a class that a mixin made", () => new (mix(Taker))().run(value));
}

for (const [label, value] of values) {
  try { const got: Setting = await later(value); console.log(label + " out of an async function:", describe(got)); } catch (error) { console.log(label + " out of an async function:", (error as Error).constructor.name); }
}

console.log("the same function:", share(callback as unknown as Setting) === (callback as unknown), new Widget(callback as unknown as Setting).get() === (callback as unknown));

attempt("an untyped function into a function no assertion reaches", () => untouched(hide(callback)));
attempt("an untyped object into a number parameter", () => half(hide({})));
attempt("an untyped string into a number parameter", () => half(hide("4")));
attempt("an untyped function into a field no assertion reaches", () => { const widget = new Widget(); widget.untouched = hide(callback); return widget.untouched; });
attempt("a symbol under an assertion", () => share(hide(Symbol.iterator) as Setting));
attempt("an untyped symbol into a place that admits objects", () => share(hide(Symbol.iterator)));
attempt("numbers are still numbers", () => half(8) + half(hide(4)));

// A helper that hands its parameter on admits what one caller passes it under an assertion. The place behind the call of another caller keeps its test.
attempt("an object as an array through a helper into a variable", () => { const got: number[] = same({ y: 1 } as unknown as number[]); return got; });
attempt("an object as an array through two helpers into a variable", () => { const got: number[] = sameAgain({ y: 1 } as unknown as number[]); return got; });
attempt("an array through the same helpers", () => { const got: number[] = sameAgain(same([1, 2])); return got; });
attempt("an untyped object through the helper into a variable no assertion reaches", () => { const got: number[] = same(hide({ y: 1 })); return got; });
attempt("the result of a built-in and of a function under an assertion", () => { const got: string[] = [1, 2].slice(1) as unknown[] as string[]; const more: string[] = same([3]) as unknown[] as string[]; return got.concat(more); });
//// asserted-objects-reach-other-places/widgets.ts
export type Setting = boolean | string | number;
export type Listener = () => void;

export class Widget {
  setting: Setting = 0;
  untouched: Setting = 0;
  listener: Listener = () => {};
  #hidden: Setting = 0;
  static latest: Setting = 0;
  constructor(initial: Setting = 0) { this.setting = initial; }
  put(value: Setting): void { this.setting = value; }
  get(): Setting { return this.setting; }
  hide(value: Setting): Setting { this.#hidden = value; return this.#hidden; }
  listen(listener: Listener): Listener { this.listener = listener; return this.listener; }
  static remember(value: Setting): Setting { Widget.latest = value; return Widget.latest; }
}

export class Panel extends Widget {
  constructor(initial: Setting) { super(initial); }
  put(value: Setting): void { super.put(value); }
}

export class Cell {
  private stored: Setting = 0;
  get value(): Setting { return this.stored; }
  set value(next: Setting) { this.stored = next; }
}

export let shared: Setting = 0;
export function share(value: Setting): Setting { shared = value; return shared; }
export const forward = (value: Setting): Setting => share(value);
export function untouched(value: Setting): Setting { return value; }
export function half(n: number): number { return n / 2; }
export async function later(value: unknown): Promise<Setting> { return value as Setting; }
export function last(...values: Setting[]): Setting { return values[values.length - 1]; }
export function* once(value: unknown): Generator<Setting> { yield value as Setting; }
export function same<T>(items: T[]): T[] { return items; }
export function sameAgain<T>(items: T[]): T[] { return same(items); }
export class Taker { take(value: Setting): unknown { return value; } run(value: unknown): unknown { return this.take(value as Setting); } }
export function mix<T extends new (...list: any[]) => Taker>(Base: T) { return class extends Base { take(value: Setting): unknown { return [value][0]; } }; }
//// asserted-store/main.ts
// `undefined` and `null` out of `any` pass into every variable of type number or boolean and stay what they are: `var`, `let`, hoisted reads, captured and module-level variables.
////= attempt
const o: any = { present: 5 }
attempt("var, read early by a hoisted function", () => { peek(); var n = 0; n = o.missing; return n; function peek() { return String(n) } })
attempt("var, every read after the declaration", () => { var n = 0; const peek = () => String(n); n = o.missing; return peek() })
attempt("var, not captured", () => { var n = 0; n = o.missing; return String(n) })
var ofModule = 0
attempt("var of the module", () => { ofModule = o.missing; return String(ofModule) })
attempt("var that is cleared elsewhere", () => { var n = 0; const clear = () => { n = undefined! }; clear(); n = o.missing; return String(n) })
attempt("var without a value", () => { var n: number; n = o.missing; return String(n) })
attempt("let without a value", () => { let n: number; n = o.missing; return String(n) })
attempt("boolean", () => { peek(); var b = false; b = o.missing; return String(b); function peek() { return String(b) } })
attempt("null", () => { peek(); var n = 0; n = JSON.parse("null"); return String(n); function peek() { return String(n) } })
attempt("the initializer of a var, annotated", () => { peek(); var n: number = o.missing; return String(n); function peek() { return String(n) } })
attempt("the initializer of a var is `undefined!`", () => { peek(); var n: number = undefined!; return String(n); function peek() { return String(n) } })
// What fits is stored, the clear is let through, and a type with `undefined` in it takes it.
attempt("a number out of any", () => { peek(); var n = 0; n = o.present; return n + 1; function peek() { return String(n) } })
attempt("the clear", () => { var n = 0; const read = () => String(n); n = undefined!; return read() })
attempt("number | undefined", () => { var n: number | undefined = 0; n = o.missing; return String(n) })
attempt("the blank start", () => { return peek(); var n = 0; function peek() { return String(n) } })
//// asserted-store/tsconfig.json
////= lines
//// await-mistyped-promises.ts
// The value that an await of a `PromiseLike<T>` or a `Promise<T>` yields is not checked against `T`: declaration files declare the one and extend the other. A value of another type goes on as in plain Bun, from a native promise or a thenable, inside try blocks and loops, until it enters something written: `return n + 1` under `Promise<number>` rejects where the sum is a string. type-rules/awaited-value-checked-against-annotation has the awaited values that flow into a declared type.
interface Point { x: number; y: number }
class Box { constructor(public held: string) {} }
type Handler = (text: string) => number;

function lie<T>(value: unknown): Promise<T> {
  return Promise.resolve(value) as Promise<T>;
}
function thenable<T>(value: unknown): PromiseLike<T> {
  return { then(resolve: (value: T) => void) { resolve(value as T); } } as PromiseLike<T>;
}
async function text(p: PromiseLike<string>): Promise<number> { const s = await p; return s.length; }
async function textOfPromise(p: Promise<string>): Promise<number> { const s = await p; return s.length; }
async function optionalText(p: PromiseLike<string | undefined>): Promise<string> { const s = await p; return s === undefined ? "none" : "some " + s; }
async function list(p: PromiseLike<string[]>): Promise<number> { const l = await p; return l.length; }
async function point(p: PromiseLike<Point>): Promise<number> { const q = await p; return q.x + q.y; }
async function box(p: PromiseLike<Box>): Promise<string> { const b = await p; return b.held; }
async function handler(p: PromiseLike<Handler>): Promise<number> { const h = await p; return h("four"); }
async function either(p: PromiseLike<Box | string>): Promise<string> { const e = await p; return typeof e === "string" ? e : e.held; }
async function count(p: PromiseLike<number>): Promise<number> { const n = await p; return n + 1; }
async function flag(p: PromiseLike<boolean>): Promise<string> { const f = await p; return f ? "yes" : "no"; }
async function caught(p: PromiseLike<string>): Promise<string> {
  try {
    const s = await p;
    return "fine " + s.length;
  } catch (error) {
    return "caught " + (error as Error).name + ": " + (error as Error).message;
  }
}
async function inALoop(all: PromiseLike<string>[]): Promise<number> {
  let sum = 0;
  for (const p of all) sum += (await p).length;
  return sum;
}
async function twice(p: PromiseLike<string>, q: PromiseLike<string[]>): Promise<number> {
  const s = await p;
  const l = await q;
  return s.length + l.length;
}
async function row(name: string, run: () => Promise<unknown>): Promise<void> {
  try {
    console.log(name, String(await run()));
  } catch (error) {
    console.log(name, "threw", (error as Error).name);
  }
}
async function main(): Promise<void> {
  await row("text", () => text(lie("four")));
  await row("text of a thenable", () => text(thenable("three")));
  await row("text, a number", () => text(lie(4)));
  await row("text, an object", () => text(lie({ length: 9 })));
  await row("text, an array", () => text(lie(["a"])));
  await row("text, a thenable's number", () => text(thenable(4)));
  await row("text of a promise", () => textOfPromise(lie("four")));
  await row("text of a promise, a number", () => textOfPromise(lie(4)));
  await row("optional text", () => optionalText(lie("s")));
  await row("optional text, undefined", () => optionalText(lie(undefined)));
  await row("optional text, false", () => optionalText(lie(false)));
  await row("optional text, 0", () => optionalText(lie(0)));
  await row("list", () => list(lie(["a", "b"])));
  await row("list, a string", () => list(lie("ab")));
  await row("list, an object", () => list(lie({ length: 2 })));
  await row("point", () => point(lie<Point>({ x: 1, y: 2 } as Point)));
  await row("point, a string", () => point(lie("xy")));
  await row("point, a box", () => point(lie(new Box("b"))));
  await row("box", () => box(lie(new Box("held"))));
  await row("box, a look-alike", () => box(lie({ held: "not a box" })));
  await row("box, a number", () => box(lie(1)));
  await row("handler", () => handler(lie((t: string) => t.length)));
  await row("handler, a string", () => handler(lie("h")));
  await row("either, a string", () => either(lie("e")));
  await row("either, a box", () => either(lie(new Box("in a box"))));
  await row("either, a number", () => either(lie(7)));
  await row("count", () => count(lie(41)));
  await row("count, a string", () => count(lie("41")));
  await row("flag", () => flag(lie(true)));
  await row("flag, a number", () => flag(lie(1)));
  await row("caught", () => caught(lie("abc")));
  await row("caught, a number", () => caught(lie(3)));
  await row("in a loop", () => inALoop([lie("a"), lie("bc"), thenable("def")]));
  await row("in a loop, the second is wrong", () => inALoop([lie("a"), lie(2), lie("def")]));
  await row("twice", () => twice(lie("ab"), lie(["c"])));
  await row("twice, the second is wrong", () => twice(lie("ab"), lie("c")));
}
main();
