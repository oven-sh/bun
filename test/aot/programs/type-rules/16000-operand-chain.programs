//// arithmetic-behind-an-assertion.ts
// `x!` tests nothing: arithmetic on the undefined or null behind it gives what JavaScript gives.
////= say
let maybe: number | undefined;
let other: number | null = null;
const holder: { count?: number; size: number | null } = { size: null };
const small: number[] = [1, 2];
const byName = new Map<string, number>([["a", 3]]);
function pick(flag: boolean): number | undefined { return flag ? 3 : undefined; }

say("a variable, plus one", () => maybe! + 1);
say("a variable, times two", () => maybe! * 2);
say("a variable, minus", () => 10 - maybe!);
say("a variable, or zero", () => maybe! | 0);
say("a variable, negated", () => -maybe!);
say("a variable, compared", () => maybe! < 5);
say("a variable, incremented", () => { let n = maybe!; n++; return n; });
say("null, plus one", () => other! + 1);
say("null, times two", () => other! * 2);
say("a property, plus one", () => holder.count! + 1);
say("a null property, plus one", () => holder.size! + 1);
say("an element, plus one", () => small[7]! + 1);
say("an element, shifted", () => small[7]! << 1);
say("a Map entry, plus one", () => byName.get("b")! + 1);
say("a result, plus one", () => pick(false)! + 1);
say("a result that is there, plus one", () => pick(true)! + 1);
say("as an index", () => small[maybe!]);
say("in a template", () => `${maybe! + 1}`);
maybe = 3;
other = 4;
holder.count = 5;
holder.size = 6;
say("set: a variable, plus one", () => maybe! + 1);
say("set: null, plus one", () => other! + 1);
say("set: a property, plus one", () => holder.count! + 1);
say("set: a null property, plus one", () => holder.size! + 1);
//// arithmetic-on-an-argument-that-is-undefined-after-all.ts
// TypeScript narrows `current` to number at the assignment and does not see that the call undoes it, so undefined reaches a parameter of type number.
let current: number | undefined = 3;
function clear(): void { current = undefined; }
function plusOne(n: number): number { return n + 1; }
function twice(n: number): number { return n * 2; }
function inText(n: number): string { return `${n + 1}`; }
function pick(n: number): number | undefined { return [10, 20, 30][n + 1]; }
function name(n: number): string { switch (n + 1) { case 0: return "zero"; case 4: return "four"; default: return "other"; } }
console.log((() => { current = 3; clear(); return plusOne(current); })());
console.log((() => { current = 3; clear(); return twice(current); })(), (() => { current = 3; clear(); return inText(current); })());
console.log((() => { current = 3; clear(); return pick(current); })(), (() => { current = 3; clear(); return name(current); })());
//// arithmetic-on-external-data.ts
// The result of JSON.parse is cast to a type that it does not match and kept in a variable without an annotation:
// every operator has to produce what ECMAScript says for the actual values.
// string + anything is a string, and number - * / anything is a number, so a variable holding such a result keeps its inferred type. number + anything may be a string.
const data = JSON.parse('{"t":"abc","u":"d","n":5,"b":true,"z":null,"o":{"x":1},"l":["x","y"],"d":{"k":"v"}}') as { t: number; u: number; n: number; b: number; z: number; o: number; l: number[]; d: Record<string, number> };
const say = (label: string, f: () => unknown): void => { let r: string; try { const v = f(); r = typeof v + " " + String(v); } catch (e) { r = "throws " + (e as Error).constructor.name; } console.log(label + " ==> " + r); };
const one = [1].length;

// Nested operands: the operand is itself a binary, conditional or assignment expression.
say("1 + data.t + 1", () => 1 + data.t + 1);
say("data.t + 1 + 1", () => data.t + 1 + 1);
say("data.t + data.u + 1", () => data.t + data.u + 1);
say("data.n + data.t + data.u", () => data.n + data.t + data.u);
say("1 + (data.t + 1)", () => 1 + (data.t + 1));
say("string + (data.t + 1)", () => "a" + (data.t + 1));
say("(data.t + 1) - 1", () => data.t + 1 - 1);
say("(data.t + 1) * 2", () => (data.t + 1) * 2);
say("-(data.t + 1)", () => -(data.t + 1));
say("(data.t + 1) < 5", () => data.t + 1 < 5);
say("Math.max(data.t + 1, 2)", () => Math.max(data.t + 1, 2));
say("(c ? data.t : 1) + 1", () => (data.n ? data.t : 1) + 1);
say("(data.t || 1) + 1", () => (data.t || 1) + 1);
say("(data.t ?? 1) + 1", () => (data.t ?? 1) + 1);
say("(data.z ?? 1) + 1", () => (data.z ?? 1) + 1);
say("(data.t, data.u) + 1", () => (data.t, data.u) + 1);
say("(x = data.t) + 1", () => { let x = 0; return (x = data.t) + 1; });
say("(x += data.t) + 1", () => { let x = 0; return (x += data.t) + 1; });

// Element and computed-key accesses as operands.
const key = ["t"].join("") as "t" | "u";
say("data[key] + 1", () => data[key] + 1);
say("data[key] + data[key]", () => data[key] + data[key]);
say("data[key] * 2", () => data[key] * 2);
say("data.l[0] + 1", () => data.l[0] + 1);
say("data.l[one] + 1", () => data.l[one] + 1);
say("data.l[0] + data.l[1]", () => data.l[0] + data.l[1]);
say("data.l[5] + 1", () => data.l[5] + 1);
say("data.d.k + 1", () => data.d.k + 1);
say("data.d[key] + 1", () => data.d[key] + 1);
say("for of", () => { let s = ""; for (const v of data.l) s += v + 1; return s; });
say("map", () => data.l.map(v => v + 1));
say("reduce", () => data.l.reduce((a, v) => a + v, 0));

// Variables with inferred types.
for (const name of ["t", "n", "b", "z", "o"] as const) {
  say(name + ": string += data", () => { let s = ""; s += data[name]; s += "!"; return s; });
  say(name + ": string = string + data", () => { let s = "a"; for (let i = 0; i < 2; i++) s = s + data[name]; return s; });
  say(name + ": string = data + string", () => { let s = "a"; for (let i = 0; i < 2; i++) s = data[name] + s; return s; });
  say(name + ": length afterwards", () => { let s = ""; for (let i = 0; i < 3; i++) s += data[name]; return s.length; });
  say(name + ": number += data", () => { let n = 1; n += data[name]; return n; });
  say(name + ": number -= data", () => { let n = 1; n -= data[name]; return n; });
  say(name + ": number *= data", () => { let n = 2; n *= data[name]; return n; });
  say(name + ": number /= data", () => { let n = 2; n /= data[name]; return n; });
  say(name + ": number %= data", () => { let n = 7; n %= data[name]; return n; });
  say(name + ": number **= data", () => { let n = 2; n **= data[name]; return n; });
  say(name + ": number |= data", () => { let n = 1; n |= data[name]; return n; });
  say(name + ": number &= data", () => { let n = 7; n &= data[name]; return n; });
  say(name + ": number ^= data", () => { let n = 7; n ^= data[name]; return n; });
  say(name + ": number <<= data", () => { let n = 1; n <<= data[name]; return n; });
  say(name + ": number >>= data", () => { let n = 64; n >>= data[name]; return n; });
  say(name + ": number >>>= data", () => { let n = 64; n >>>= data[name]; return n; });
  say(name + ": number = data - number", () => { let n = 1; n = data[name] - n; return n; });
  say(name + ": number = data * data", () => { let n = 1; n = data[name] * data[name]; return n; });
  say(name + ": number = data + data", () => { let n = 1; n = data[name] + data[name]; return n; });
  say(name + ": number = -data", () => { let n = 1; n = -data[name]; return n; });
  say(name + ": number = ~data", () => { let n = 1; n = ~data[name]; return n; });
  say(name + ": number = +data", () => { let n = 1; n = +data[name]; return n; });
  say(name + ": number = number + (data - 1)", () => { let n = 1; n = n + (data[name] - 1); return n; });
  say(name + ": number = number + (data + 1)", () => { let n = 1; n = n + (data[name] + 1); return n; });
  say(name + ": toFixed afterwards", () => { let n = 0; for (let i = 0; i < 3; i++) n -= data[name]; return n.toFixed(1); });
}
//// array-elements-flow-on-external-data.ts
// Elements read back from an array with an inferred element type that holds external data flow on into variables, other containers and functions.
const data = JSON.parse('{"t":"abc"}') as { t: number };
const say = (label: string, f: () => unknown): void => { let r: string; try { const v = f(); r = typeof v + " " + (typeof v === "object" ? JSON.stringify(v) : String(v)); } catch (e) { r = "throws " + (e as Error).constructor.name; } console.log(label + " ==> " + r); };
say("a variable assigned from an element", () => { const c = [data.t]; let n = 0; n = c[0]; return n + 1; });
say("a variable assigned from pop", () => { const c = [data.t]; let n = 0; n = c.pop()!; return n + 1; });
say("a variable that adds up elements", () => { const c = [1, data.t]; let n = 0; for (let i = 0; i < c.length; i++) n += c[i]; return n; });
say("a const taken from an element", () => { const c = [data.t]; const first = c[0]; return first + 1; });
say("an element pushed onto another array", () => { const c = [data.t]; const d = [1]; d.push(c[0]); return d[1] + 1; });
say("a slice", () => { const c = [1, data.t]; return c.slice(1)[0] + 1; });
say("a filter", () => { const c = [1, data.t]; return c.filter(() => true)[1] + 1; });
say("a copy by spread", () => { const c = [data.t]; const d = [...c]; return d[0] + 1; });
say("an alias", () => { const c = [data.t]; const d = c; return d[0] + 1; });
say("a concat", () => { const c = [data.t]; return [1].concat(c)[1] + 1; });
say("an element returned by a function", () => { const c = [data.t]; const first = () => c[0]; return first() + 1; });
say("an element in a literal property", () => { const c = [data.t]; const o = { v: c[0] }; return o.v + 1; });
say("length, indexOf and includes stay exact", () => { const c = [1, data.t]; return [c.length, c.indexOf(1), c.includes(1)].join(); });
say("trusted stays exact", () => { const c = [1, 2]; let n = 0; n = c[0]; return n + c.pop()! + 1; });
say("Array.from", () => { const c = [data.t]; return Array.from(c)[0] + 1; });
say("Array.from with a function", () => { const c = [data.t]; return Array.from(c, v => v + 1)[0]; });
say("into a Set and out", () => { const c = [data.t]; return [...new Set(c)][0] + 1; });
say("flat", () => { const c = [data.t]; return [c].flat()[0] + 1; });
say("Object.values", () => { const c = [data.t]; return Object.values(c)[0] + 1; });
say("nested", () => { const c = [data.t]; const outer = [c]; return outer[0][0] + 1; });
//// array-subclass-is-an-array-type.ts
// An instance of a subclass of Array is an array: it passes where the array type `T[]` is declared, and `for...of` calls the iterator of its class.
class Sub extends Array<number> { *[Symbol.iterator](): Generator<number, undefined, unknown> { yield 100; yield 200 } }
class Plain extends Array<number> {}
function each(x: any) { const out: unknown[] = []; for (const v of x) out.push(v); return out.join() }
function total(a: number[]) { let t = 0; for (let i = 0; i < a.length; i++) t += a[i]; return t }
function attempt(label: string, f: () => unknown) { try { console.log(label + ": no error", String(f())) } catch (e) { console.log(label + ":", e instanceof TypeError ? "TypeError" : "other " + e) } }
attempt("Sub.from, whose type is number[]", () => each(Sub.from([1, 2])))
attempt("Plain.from, whose type is number[]", () => each(Plain.from([4, 5])))
attempt("new Sub, at its own type", () => { const s = new Sub(); s.push(1); return each(s) })
attempt("new Plain, at its own type", () => { const p = new Plain(); p.push(4, 5); return each(p) + " " + p.length })
attempt("new Plain, at number[]", () => { const p: number[] = new Plain(); p.push(4, 5); return each(p) })
attempt("new Plain, passed as number[]", () => { const p = new Plain(); p.push(4, 5); return total(p) })
attempt("new Plain, through any, at number[]", () => { const p: any = new Plain(); p.push(4, 5); const a: number[] = p; return a.length })
attempt("new Plain, through any, as number[]", () => { const p: any = new Plain(); p.push(4, 5); return (p as number[]).length })
export {};
