// `x as T` never converts. A type that a string satisfies (ArrayLike, Iterable, { length: number }, String), alone or in a union, takes a string as it is.
// A primitive that does not satisfy the type throws a TypeError. A type parameter tests nothing.
declare const console: { log(...values: unknown[]): void };
interface HasLength { length: number }
const values: unknown[] = [123, 12.5, true, false, 10n, "ab"];
function attempt(label: string, run: (value: unknown) => unknown): void {
  console.log(label + ": " + values.map(value => { try { const got = run(value); return typeof got === "bigint" ? got + "n" : JSON.stringify(got); } catch (error) { return "threw " + (error as Error).name; } }).join(" "));
}
function isArrayLike(value?: any): boolean { return value != null && typeof value !== "function" && typeof (value as ArrayLike<unknown>).length === "number"; }
function items(collection: unknown): string[] { const list = collection as ArrayLike<unknown>; return Array.from(list).map(String); }
function generic<T extends ArrayLike<unknown>>(value: unknown): string { return typeof (value as T); }

attempt("isArrayLike", value => isArrayLike(value));
attempt("items", value => items(value));
attempt("ArrayLike<unknown>", value => typeof (value as ArrayLike<unknown>));
attempt("{ length: number }", value => typeof (value as { length: number }));
attempt("HasLength", value => typeof (value as HasLength));
attempt("Iterable<string>", value => typeof (value as Iterable<string>));
attempt("String", value => typeof (value as String));
attempt("string | object", value => typeof (value as string | object));
attempt("readonly unknown[] | string", value => typeof (value as readonly unknown[] | string));
attempt("string | ArrayLike<string>", value => typeof (value as string | ArrayLike<string>));
attempt("number | Date", value => typeof (value as number | Date));
attempt("a type parameter", value => generic(value));
attempt("length through the cast", value => (value as ArrayLike<unknown>).length);
attempt("length through { length: number }", value => (value as { length: number }).length);
attempt("the value itself", value => value as ArrayLike<unknown>);
attempt("double cast", value => typeof (value as unknown as Iterable<unknown>));
attempt("from any", value => { const given: any = value; return typeof (given as ArrayLike<unknown>); });
//// casts-of-untyped-values-read-on-the-spot.ts
// `(value as Row).name`, where nothing is known of the value: any object passes the cast and stays what it is, and a primitive throws. The read through the cast is a typed read: a property of another kind throws, a missing one is undefined.
////= lines-8	Row	name	string	n	number
////= lines-8	Order	id	number	row	Row
const rows: Row[] = [
  { name: "Ada", n: 1 },
  { name: "Bo", n: 2 },
];
function label(row: Row): string {
  return row.name + ":" + row.n;
}
const hidden = (value: unknown): unknown => value;

console.log((hidden(rows[0]) as Row).name, (hidden(rows[0]) as Row).n + 1, label(rows[0]!));
const loose: any = { name: "loose", n: "3" };
try {
  console.log((loose as Row).name, (loose as Row).n + 1, typeof (loose as Row).n);
} catch (error) {
  console.log("a text where the type says number:", (error as Error).constructor.name);
}
try {
  console.log((hidden({ id: 1, row: { name: "inner", n: 4 } }) as Order).row.name, (hidden({ id: 1, row: 5 }) as Order).row.name);
} catch (error) {
  console.log("a number where the type says Row:", (error as Error).constructor.name);
}
try {
  console.log((hidden({}) as Row).name, (hidden([]) as Row).name, (hidden(() => 1) as Row).name, (hidden(5) as Row).name, (hidden("text") as Row).n);
} catch (error) {
  console.log("a number under the cast:", (error as Error).constructor.name);
}
for (const nothing of [undefined, null]) {
  try {
    console.log((hidden(nothing) as Row).name);
  } catch (error) {
    console.log((error as Error).constructor.name);
  }
}
try {
  throw rows[1];
} catch (error) {
  console.log((error as Row).name, (error as Row) === rows[1]);
}
console.log(Array.prototype.map.call(rows, row => (row as Row).name).join());
console.log((hidden({ get name() { return "computed"; } }) as Row).name, (hidden(Object.create({ name: "inherited" })) as Row).name);
console.log((hidden(rows[0]) as Row)["name"], (hidden(rows[1])! as Row).n);
let total = 0;
for (const row of rows) total += row.n + (hidden(row) as Row).n;
console.log(total);
//// casts-refuse-no-object.ts
// `e as T` refuses no object (a function is one) and neither `undefined` nor `null`, whatever `T` is, and the place that receives the value admits it: a parameter, a variable, a field, a result, and the place after that. Nothing is copied. `x!` checks nothing. An untyped value that enters a written place is tested as ever, and so is a primitive of the wrong kind under a cast: a test that fails throws nothing, and the program goes on as under `bun run`.
declare const console: { log(...values: unknown[]): void };
type Attribute = boolean | string | number;
type Name = "a" | "b";
interface Point { x: number }
type Callback = () => void;
const hide = (value: unknown): unknown => value;
function describe(value: unknown): string { return value === null ? "null" : Array.isArray(value) ? "array" : typeof value; }
////= lines-13	attempt	describe
////= lines-13	show	String

class Holder { attribute: Attribute = 0; name: Name = "a"; point: Point = { x: 1 }; callback: Callback = () => {}; }
function takesAttribute(value: Attribute): unknown { return value; }
function takesName(value: Name): unknown { return value; }
function takesPoint(value: Point): unknown { return value; }
function takesCallback(value: Callback): unknown { return value; }
function givesAttribute(value: unknown): Attribute { return value as Attribute; }
function givesName(value: unknown): Name { return value as Name; }
function givesPoint(value: unknown): Point { return value as Point; }
function givesCallback(value: unknown): Callback { return value as Callback; }
function storesAttribute(holder: Holder, value: Attribute): unknown { holder.attribute = value; return holder.attribute; }
function passesOn(value: Attribute): unknown { const kept: Attribute = value; return takesAttribute(kept); }

const values: [string, unknown][] = [["a function", () => 1], ["an array", [1]], ["an object", { y: 1 }], ["null", null], ["undefined", undefined]];
for (const [label, value] of values) {
    attempt(label + " as primitives", () => value as Attribute);
    attempt(label + " as literals", () => value as Name);
    attempt(label + " as an object type", () => value as Point);
    attempt(label + " as a function type", () => value as Callback);
    attempt(label + " through unknown", () => value as unknown as Attribute);
    attempt(label + " through any", () => value as any as Attribute);

    attempt(label + " as primitives, into a parameter", () => takesAttribute(value as Attribute));
    attempt(label + " as literals, into a parameter", () => takesName(value as Name));
    attempt(label + " as an object type, into a parameter", () => takesPoint(value as Point));
    attempt(label + " as a function type, into a parameter", () => takesCallback(value as Callback));

    attempt(label + " as primitives, into a variable", () => { const kept: Attribute = value as Attribute; return kept; });
    attempt(label + " as literals, into a variable", () => { const kept: Name = value as Name; return kept; });
    attempt(label + " as an object type, into a variable", () => { const kept: Point = value as Point; return kept; });
    attempt(label + " as a function type, into a variable", () => { const kept: Callback = value as Callback; return kept; });

    attempt(label + " as primitives, into a field", () => { const holder = new Holder(); holder.attribute = value as Attribute; return holder.attribute; });
    attempt(label + " as literals, into a field", () => { const holder = new Holder(); holder.name = value as Name; return holder.name; });
    attempt(label + " as an object type, into a field", () => { const holder = new Holder(); holder.point = value as Point; return holder.point; });
    attempt(label + " as a function type, into a field", () => { const holder = new Holder(); holder.callback = value as Callback; return holder.callback; });

    attempt(label + " as primitives, as a result", () => givesAttribute(value));
    attempt(label + " as literals, as a result", () => givesName(value));
    attempt(label + " as an object type, as a result", () => givesPoint(value));
    attempt(label + " as a function type, as a result", () => givesCallback(value));

    attempt(label + " from a parameter on into a field", () => storesAttribute(new Holder(), value as Attribute));
    attempt(label + " from a parameter on into a variable and a parameter", () => passesOn(value as Attribute));
}

const callback = () => 1;
const list = [1];
show("the same function through a parameter", () => takesAttribute(callback as unknown as Attribute) === callback);
show("the same function as a result", () => givesAttribute(callback) === (callback as unknown));
show("the same array through a field", () => storesAttribute(new Holder(), list as unknown as Attribute) === list);

function double(n: number): number { return n * 2; }
attempt("a right primitive under a cast", () => hide(2) as number);
attempt("an untyped string into a number parameter", () => double("4" as any));
attempt("an untyped object into a number parameter", () => double({} as any));
attempt("an untyped function into a string variable", () => { const text: string = hide(callback) as any; return text; });
attempt("a string cast to number", () => hide("2") as number);
attempt("a string cast to number through unknown", () => "2" as unknown as number);
attempt("a number cast to literals", () => hide(1) as Name);
attempt("an element of the right kind, read through a cast", () => (hide(["a"]) as string[])[0]);
attempt("an element of the wrong kind, read through a cast", () => (hide([1]) as string[])[0]);
attempt("a property of the right kind, read through a cast", () => (hide({ x: 1 }) as Point).x);
attempt("a property of the wrong kind, read through a cast", () => (hide({ x: "1" }) as Point).x);
attempt("x! on a value", () => (hide("a") as string | null)!);
attempt("x! on null", () => (hide(null) as string | null)!);
attempt("x! on undefined", () => (hide(undefined) as string | undefined)!);
show("a member of x! on null throws as in plain Bun", () => { try { return (hide(null) as string | null)!.length; } catch (error) { return error instanceof TypeError && !error.message.startsWith("expected "); } });
function countOf(list: string[]): number { return list.length; }
function lastOf(list: string[]): unknown { return list[list.length - 1]; }
function grown(list: string[]): number { list.push("more"); return list.length; }
const mixed: (string | number)[] = ["a", "b", "c"];
show("a slice cast to an array type, into an array parameter", () => countOf(mixed.slice(0, 2) as string[]));
show("a map cast to an array type, into an array parameter", () => lastOf(mixed.map(item => item) as string[]));
show("a filter cast to an array type, into an array parameter", () => countOf(mixed.filter(item => item !== "b") as string[]));
show("a concat cast to an array type, into an array parameter", () => grown(mixed.concat(["d"]) as string[]));
show("an array cast through unknown[] to another array type", () => lastOf(mixed.slice(1) as unknown[] as string[]));
show("an array behind any, into an array parameter", () => countOf((hide(["x"]) as any) as string[]));
show("an array behind unknown, into an array parameter", () => countOf(hide(["x", "y"]) as string[]));
show("an array-like object behind unknown, into an array parameter", () => countOf(hide({ length: 7 }) as string[]));
show("an array-like object behind any, into an array parameter", () => countOf((hide({ length: 8 }) as any) as string[]));
show("an array-like object behind never, into an array parameter", () => countOf(hide({ length: 9 }) as never as string[]));
show("a function cast to another function type, then called", () => ((() => "called") as (count: number) => string)(1));

//// changed-prototypes.ts
// The prototypes of records, instances and classes are changed, and methods are replaced, added and shadowed.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name + ": " + e.message.split("\n")[0] : String(e))) } }
function hide(v: unknown): any { return v }
function parse(t: string): any { return JSON.parse(t) }
type Item = { id: number; n: number };
class Animal { name = "a"; speak(): string { return this.name + "!" } }
class Dog extends Animal { speak(): string { return super.speak() + "?" } }
row("setPrototypeOf on a record", () => { const t: Item = { id: 1, n: 1 }; Object.setPrototypeOf(t, { extra: 7 }); return hide(t).extra + " " + t.n + " " + Object.keys(t).join() });
row("__proto__ stored through any", () => { const t: Item = { id: 1, n: 1 }; hide(t).__proto__ = { extra: 7 }; return hide(t).extra + " " + t.n });
row("setPrototypeOf(record, null)", () => { const t: Item = { id: 1, n: 1 }; Object.setPrototypeOf(t, null); return t.n + " " + (Object.getPrototypeOf(t) === null) + " " + ("toString" in t) });
row("setPrototypeOf on an instance", () => { const d = new Dog(); Object.setPrototypeOf(d, Animal.prototype); return d.speak() + " " + (d instanceof Dog) });
row("a method replaced on the prototype", () => { const d = new Dog(); hide(Dog.prototype).speak = function () { return "replaced" }; return d.speak() + " " + new Dog().speak() });
row("a method added to the prototype", () => { hide(Animal.prototype).run = function (this: Animal) { return this.name + " runs" }; return hide(new Dog()).run() });
row("a method shadowed on the instance", () => { const a = new Animal(); hide(a).speak = () => "own"; return a.speak() });
row("the prototype of the class's prototype changed", () => { class Base { hi(): string { return "base" } } class Other { hi(): string { return "other" } } class Kid extends Base { } Object.setPrototypeOf(Kid.prototype, Other.prototype); return new Kid().hi() + " " + (new Kid() instanceof Base) });
//// checked-read-by-name.ts
// Fields read by name from many shapes, and values of another kind that throw at the read.
declare const console: { log(...values: unknown[]): void };
interface Fields { n?: number; b?: boolean; s?: string; a?: number[] }
function show(value: unknown): string { return value === undefined ? "undefined" : JSON.stringify(value) }
function report(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name : String(e))) } }
function readNumber(f: Fields): number | undefined { return f.n }
function readBoolean(f: Fields): boolean | undefined { return f.b }
function readString(f: Fields): string | undefined { return f.s }
function readArray(f: Fields): number[] | undefined { return f.a }
function readAll(f: Fields): string { return [show(readNumber(f)), show(readBoolean(f)), show(readString(f)), show(readArray(f))].join(" ") }
function outOfLine(): Fields { const o: any = {}; for (let i = 0; i < 40; i++) o["k" + i] = i; o.n = 1.5; o.b = false; o.s = "far"; o.a = [4]; return o }
class Base { n = 3; get b(): boolean { return true } get s(): string { return "got" } get a(): number[] { return [5, 6] } }
class Derived extends Base { extra = 1 }
class Numbers extends Array<number> {}
report("own inline", () => readAll({ n: 1, b: true, s: "x", a: [1, 2] }));
report("own inline double", () => readAll({ n: 0.5, b: false, s: "", a: [] }));
report("other key order", () => readAll({ a: [9], s: "y", b: true, n: -2 }));
report("out of line", () => readAll(outOfLine()));
report("inherited", () => readAll(Object.create({ n: 7, b: true, s: "proto", a: [8] })));
report("getters in a class", () => readAll(new Derived()));
report("getters in a literal", () => readAll({ get n() { return 2 }, get b() { return false }, get s() { return "lit" }, get a() { return [3] } }));
report("absent", () => readAll({}));
report("some absent", () => readAll({ n: 4 }));
report("null", () => readAll({ n: null, b: null, s: null, a: null } as any));
report("undefined", () => readAll({ n: undefined, b: undefined, s: undefined, a: undefined }));
report("array subclass", () => show(readArray({ a: Numbers.of(1, 2) })));
report("rope", () => readString({ s: "left-" + String(readNumber({ n: 1 })) }));
report("primitive receiver", () => readAll(5 as any));
report("null receiver", () => readAll(null as any));
report("number holds a string", () => readNumber({ n: "1" } as any));
report("number holds a boolean", () => readNumber({ n: true } as any));
report("number holds an object", () => readNumber({ n: {} } as any));
report("boolean holds a number", () => readBoolean({ b: 1 } as any));
report("boolean holds a string", () => readBoolean({ b: "true" } as any));
report("string holds a number", () => readString({ s: 7 } as any));
report("string holds an object", () => readString({ s: {} } as any));
report("array holds a string", () => readArray({ a: "abc" } as any));
report("array holds an object", () => readArray({ a: { length: 0 } } as any));
report("array holds a typed array", () => readArray({ a: new Uint8Array(1) } as any));
report("getter returns another kind", () => readNumber({ get n() { return "no" } } as any));
report("inherited holds another kind", () => readString(Object.create({ s: 1 })));
//// checked-reads-of-untyped-objects.ts
// `(o as any).n as number | null | undefined`, and the same for boolean, string and arrays: a property read by name and cast on the spot. The read must accept and reject exactly what a cast of a variable accepts and rejects, and must hand on an accepted value unchanged, in and outside `try`. What a cast of a variable does is found out as the program runs, so it prints the same with types, with types erased and in plain Bun. Then two reads in a row, and a read that is only tested, with getters that throw: the stack names the line of the read that threw. Four rows differ from plain Bun, with or without the types: its transpiler puts a constant that is used once in the place of its use, so `const b = a.b; return b.c` runs as `return a.b.c` there and the second read is reported at the line of the first.
type Kind = "number" | "boolean" | "string" | "array";
type Read = (o: unknown) => unknown;

const rounds = 40;
const rejected = Symbol("rejected");
const hidden: any = JSON.parse('["text"]');

function castToNumber(value: unknown): unknown {
  return value as number | null | undefined;
}
function castToBoolean(value: unknown): unknown {
  return value as boolean | null | undefined;
}
function castToString(value: unknown): unknown {
  return value as string | null | undefined;
}
function castToArray(value: unknown): unknown {
  return value as unknown[] | null | undefined;
}

////= lines-12	numberOf	number
////= lines-12	booleanOf	boolean
////= lines-12	stringOf	string
function arrayOf(o: unknown): unknown[] | null | undefined {
  return (o as any).n as unknown[] | null | undefined;
}
////= lines-4	numberInTry	number
////= lines-4	booleanInTry	boolean
////= lines-4	stringInTry	string
function arrayInTry(o: unknown): unknown {
  try {
    return (o as any).n as unknown[] | null | undefined;
  } catch (error) {
    return error instanceof TypeError ? rejected : error;
  }
}

const reads: [Kind, string, Read, Read][] = [
  ["number", "outside try", numberOf, castToNumber],
  ["number", "in try", numberInTry, castToNumber],
  ["boolean", "outside try", booleanOf, castToBoolean],
  ["boolean", "in try", booleanInTry, castToBoolean],
  ["string", "outside try", stringOf, castToString],
  ["string", "in try", stringInTry, castToString],
  ["array", "outside try", arrayOf, castToArray],
  ["array", "in try", arrayInTry, castToArray],
];

const sources: [string, (value: unknown) => unknown][] = [
  ["literal", value => ({ n: value })],
  ["from entries", value => Object.fromEntries([["n", value]])],
  ["out of line", value => Object.fromEntries([..."abcdefghijkl"].map(key => [key, 0] as [string, unknown]).concat([["n", value]]))],
  ["inherited", value => Object.create(Object.fromEntries([["n", value]]))],
  ["getter", value => ({ get n() { return value; } })],
  ["proxy", value => new Proxy({}, { get: () => value })],
];

class List extends Array<unknown> {}
const values: unknown[] = [0, 1, -1, 1.5, -0, NaN, Infinity, 2 ** 31, true, false, "", "text", null, undefined, [], [1, "two"], new List(), {}, () => 1, 10n, Symbol.iterator, new Date(0), new Uint8Array(1)];

function fits(kind: Kind, value: unknown): boolean {
  if (value === null || value === undefined) return true;
  switch (kind) {
    case "number":
      return typeof value === "number";
    case "boolean":
      return typeof value === "boolean";
    case "string":
      return typeof value === "string";
    case "array":
      return Array.isArray(value);
  }
}

function describe(value: unknown): string {
  if (value === rejected) return "rejected";
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "function") return "function";
  if (typeof value === "object" && value !== null) return Array.isArray(value) ? "array" : "object";
  return String(value);
}

function attempt(read: Read, o: unknown): unknown {
  try {
    return read(o);
  } catch (error) {
    return error instanceof TypeError ? rejected : error;
  }
}

function isSameAsCast(result: unknown, cast: Read, value: unknown): boolean {
  return Object.is(result, attempt(cast, value));
}

function verdictOf(label: string, value: unknown, read: Read, cast: Read, o: unknown): string {
  for (let round = 0; round < rounds; round++) {
    const result = attempt(read, o);
    if (!isSameAsCast(result, cast, value)) return "WRONG(" + describe(result) + " in round " + round + ")";
  }
  return label;
}

for (const [kind, where, read, cast] of reads) {
  console.log(kind, where, "a value that fits passes the cast:", values.every(value => !fits(kind, value) || Object.is(attempt(cast, value), value)));
  for (const [source, create] of sources) console.log(kind, where, source + ":", values.map(value => verdictOf(fits(kind, value) ? "fits" : "other", value, read, cast, create(value))).join(" "));
  console.log(kind, where, "absent:", [{}, Object.create(null), [], 5, "text", true].map(o => describe(attempt(read, o))).join(" "));
  console.log(kind, where, "no receiver:", [null, undefined].map(o => describe(attempt(read, o))).join(" "));
}

// One site meets every value in turn, so what it cached for the last receiver never answers for the next.
for (const [kind, where, read, cast] of reads) {
  const receivers = values.flatMap(value => sources.map(([, create]) => [value, create(value)] as [unknown, unknown]));
  let wrong = 0;
  for (let round = 0; round < rounds; round++) {
    for (const [value, o] of receivers) {
      if (!isSameAsCast(attempt(read, o), cast, value)) wrong++;
    }
  }
  console.log(kind, where, "in turn:", wrong, "wrong of", rounds * receivers.length);
}

function lineIn(name: string, error: unknown): string {
  const found = String((error as Error).stack)
    .split("\n")
    .find(line => line.includes("at " + name + " "));
  return /:(\d+):\d+\)?$/.exec(found ?? "")?.[1] ?? "none";
}
const fail = (): never => {
  throw new Error("from a getter");
};
function report(label: string, name: string, run: () => unknown): void {
  const outcomes = new Set<string>();
  for (let round = 0; round < rounds; round++) {
    try {
      outcomes.add("returned " + describe(run()));
    } catch (error) {
      outcomes.add((error as Error).constructor.name + " at line " + lineIn(name, error));
    }
  }
  console.log(label + ":", [...outcomes].join(" | "));
}

////= lines-11	chain
function chainOnOneLine(a: any): unknown {
  return a.b.c;
}
function chainKeepingBoth(a: any): unknown {
  const b = a.b;
  const c = b.c;
  return [b, c].length;
}
// prettier-ignore
////= lines-6	pair
// prettier-ignore
function pairOfTwoObjects(o: any, p: any): unknown {
  return {
    x: o.x,
    y: p.y,
  };
}
function kindIsText(o: any): string {
  if (o.kind === "text") return "text";
  return "other";
}
function flagIsSet(o: any): string {
  if (o.flag) return "set";
  return "clear";
}
function chainInTry(a: any): unknown {
  try {
    const b = a.b;
    return b.c;
  } catch (error) {
    return (error as Error).constructor.name + " at line " + lineIn("chainInTry", error);
  }
}

const throwsOnB: any = { get b() { return fail(); } };
const throwsOnC: any = { b: { get c() { return fail(); } } };
const throwsOnX: any = { get x() { return fail(); }, y: 2 };
const throwsOnY: any = { x: 1, get y() { return fail(); } };
const complete: any = { b: { c: "c" }, x: 1, y: 2, kind: "text", flag: 1, n: 1 };

report("chain, first read", "chain", () => chain(throwsOnB));
report("chain, second read", "chain", () => chain(throwsOnC));
report("chain, nothing to read from", "chain", () => chain({ b: null }));
report("chain, no receiver", "chain", () => chain(undefined));
report("chain", "chain", () => chain(complete));
report("chain on one line, first read", "chainOnOneLine", () => chainOnOneLine(throwsOnB));
report("chain on one line, second read", "chainOnOneLine", () => chainOnOneLine(throwsOnC));
report("chain on one line", "chainOnOneLine", () => chainOnOneLine(complete));
report("chain keeping both, first read", "chainKeepingBoth", () => chainKeepingBoth(throwsOnB));
report("chain keeping both, second read", "chainKeepingBoth", () => chainKeepingBoth(throwsOnC));
report("chain keeping both", "chainKeepingBoth", () => chainKeepingBoth(complete));
report("chain in try, first read", "chainInTry", () => chainInTry(throwsOnB));
report("chain in try, second read", "chainInTry", () => chainInTry(throwsOnC));
report("pair, first read", "pair", () => pair(throwsOnX));
report("pair, second read", "pair", () => pair(throwsOnY));
report("pair, no receiver", "pair", () => pair(null));
report("pair", "pair", () => JSON.stringify(pair(complete)));
