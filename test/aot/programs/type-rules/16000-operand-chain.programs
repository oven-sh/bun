//// 16000-operand-chain/tsconfig.json
{ "compilerOptions": { "strict": true, "target": "esnext", "module": "esnext", "moduleResolution": "bundler", "allowJs": true, "noEmit": true, "types": [] } }
//// a-generic-type-has-the-names-of-a-type-with-an-int32-member.ts
// Box<int32>, Box<number> and Whole list the same name. A read through Whole or Box<int32> is an int32.
import type { int32 } from "bun";
interface Box<Value> {
  value: Value;
}
interface Whole {
  value: int32;
}
function open(box: Box<int32>): int32 {
  return box.value;
}
////= lines-3	whole	box	Whole	int32	box.value
function fraction(box: Box<number>): number {
  return box.value / 2;
}
console.log(open({ value: 3 }), whole({ value: 4 }), fraction({ value: 5 }));
//// a-literal-with-the-names-of-a-type-with-int32-members-holds-fractions.ts
// The literal further down has the names of Point and holds a fraction. It is never taken for a Point, so the `x` of a Point is still an int32, wherever in the file the read stands.
import type { int32 } from "bun";
////= lines-8	Point	x	int32	y	int32
////= lines-3	readAbove	point	Point	int32	point.x
function half(n: number): number {
  const local = { x: n / 2, y: 2 };
  return local.x + local.y;
}
////= lines-3	readBelow	point	Point	int32	point.y
console.log(readAbove({ x: 1, y: 2 }), half(2.5), readBelow({ x: 3, y: 4 }));
//// a-private-member-read-by-name-from-a-project-that-reports-no-unused-locals/lenient/peek.ts
import type { Holder } from "../reports/holder";

export function peek(holder: Holder): number {
  return holder["hidden"];
}
//// a-private-member-read-by-name-from-a-project-that-reports-no-unused-locals/lenient/tsconfig.json
{
  "extends": "../tsconfig.json"
}
//// a-private-member-read-by-name-from-a-project-that-reports-no-unused-locals/main.ts
// Whether a private member is unused is a question of the file that declares it, under its own tsconfig.json. A read by name in a file of another project, which is checked first because the two import each other, counts there whatever that project reports.
import { Holder } from "./reports/holder";
import { Control } from "./reports/control";

console.log(new Holder().show(), new Control().show());
//// a-private-member-read-by-name-from-a-project-that-reports-no-unused-locals/reports/control.ts
import { peekControl } from "./peek-control";

export class Control {
  private hidden = 2;
  show(): number {
    return peekControl(this);
  }
}
//// a-private-member-read-by-name-from-a-project-that-reports-no-unused-locals/reports/holder.ts
import { peek } from "../lenient/peek";

export class Holder {
  private hidden = 1;
  show(): number {
    return peek(this);
