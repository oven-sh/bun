export class Core {
  n = 1;
}
//// awaited-value-checked-against-annotation/heir.js
import { Core } from "./core.ts";
export class Heir extends Core {
  then(resolve) {
    resolve("a string");
  }
}
//// awaited-value-checked-against-annotation/main.ts
// What comes of awaiting an object may be anything, because an heir may have a `then`. Where the program writes down a type for it, at a variable or a parameter, the value is held to that type.
import { Core } from "./core.ts";
import { Heir } from "./heir.js";

const core: Core = new Heir();
const attempt = async (label: string, run: () => Promise<unknown>) => {
  try {
    console.log(label + ":", String(await run()));
  } catch (error) {
    console.log(label + ":", (error as Error).constructor.name);
  }
};
const take = (given: Core) => given.n;

await attempt("nothing is written", async () => {
  const got = await core;
  return typeof got;
});
await attempt("a variable with a type", async () => {
  const got: Core = await core;
  return typeof got;
});
await attempt("a parameter with a type", async () => take(await core));
await attempt("a variable with a type, and the value fits", async () => {
  const got: Core = await (new Core() as Core);
  return got.n;
});
//// branded-primitives-cast-from-untyped-values.ts
type Name = string & { readonly __brand: "Name" };
type UserId = number & { readonly __brand: "UserId" };
type Flag = boolean & { readonly __brand: "Flag" };
type Big = bigint & { readonly __brand: "Big" };
type Loose = string & {};
type Slug = `${string}-${string}` & { readonly __brand: "Slug" };

////= lines-9	greet	name	Name	string	"hi "	name
function show(id: UserId): string {
  return "#" + (id + 1);
}
function flip(flag: Flag): boolean {
  return !flag;
}
function double(big: Big): bigint {
  return big * 2n;
}
////= lines-3	loose	text	Loose	number	text.length
function slug(text: Slug): string {
  return text.toUpperCase();
}
function either(value: Name | UserId): string {
  return typeof value === "string" ? "name " + value : "id " + value;
}
function maybe(name: Name | undefined): string {
  return name === undefined ? "nobody" : greet(name);
}

const body: any = JSON.parse('{"name":"ada","id":7,"flag":true,"slug":"a-b"}');
console.log(greet(body.name as Name));
console.log(show(body.id as UserId));
console.log(flip(body.flag as Flag));
console.log(loose(body.name as Loose));
console.log(slug(body.slug as Slug));
console.log(either(body.name as Name | UserId), either(body.id as Name | UserId));
console.log(maybe(body.name as Name | undefined), maybe(body.missing as Name | undefined));

const raw: unknown = "bob";
console.log(greet(raw as Name));
const count: unknown = 41;
console.log(show(count as UserId));
const large: unknown = 21n;
console.log(String(double(large as Big)));

const held = body.name as Name;
console.log(typeof held, held.length, greet(held));
const names: Name[] = [body.name as Name, raw as Name];
console.log(names.map(greet).join(", "));
const record: { name: Name; id: UserId } = { name: body.name as Name, id: body.id as UserId };
console.log(greet(record.name), show(record.id));

function brand(value: unknown): Name {
  return value as Name;
}
console.log(greet(brand("eve")));

const typed = JSON.parse('{"name":"kay"}') as { name: string };
console.log(greet(typed.name as Name));
//// branded-primitives-through-casts.ts
// A brand is a phantom: no value has it when the program runs. A branded string, and the `void & { brand }` beside it, is a string or `undefined`, so a cast from it to `string` is no cast of an object, and `.slice` on the result is the string's. A real object cast to `string` is still let through, and the place that receives it takes it. Every line prints what plain Bun prints.
type Escaped = (string & { __escaped: void }) | (void & { __escaped: void }) | "known";
type Id = number & { __tag: "id" };
const hide = (value: unknown): unknown => value;

function escape(text: string): Escaped { return (text.startsWith("__") ? "_" + text : text) as Escaped; }
function unescape(name: Escaped): string { const text = name as string; return text.length >= 3 && text.startsWith("___") ? text.slice(1) : text; }
function firstOf(text: string): string { return text.slice(0, 1); }
function next(id: Id): number { return (id as number) + 1; }
function describe(text: string): string { return typeof text + " " + String(text === undefined ? "nothing" : text.slice(0, 2)); }

console.log(unescape(escape("__proto__")), unescape(escape("plain")), unescape("known"));
console.log(firstOf(unescape(escape("abc"))), firstOf(escape("xyz") as string));
console.log(next(41 as Id), next(hide(1) as Id));
console.log(describe(hide(undefined) as Escaped as string));
const names: Escaped[] = [escape("a"), escape("__b"), "known"];
console.log(names.map(name => unescape(name)).join(","));

const sliceable = { slice: (from: number, to: number) => "object " + from + to };
console.log(firstOf(sliceable as unknown as string), describe(sliceable as unknown as string));
//// built-in-prototypes-are-immutable.ts
// `Object.prototype` is locked and not extensible: stores throw, and the `Reflect` functions return false.
const op: any = Object.prototype
try { op.polluted = 1; console.log("a property added to Object.prototype: no error") } catch (e) { console.log("a property added to Object.prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(Reflect.set(op, "polluted2", 1), Reflect.defineProperty(op, "polluted3", { value: 1 }))
console.log(Object.isExtensible(op), "[" + Object.keys(op).join() + "]")
const o = { z: 1 }
try { op.polluted4 = 1; console.log("the same once an object has been made: no error") } catch (e) { console.log("the same once an object has been made:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(Object.isExtensible(op), "[" + Object.keys(op).join() + "]", o.z, (o as any).polluted, (o as any).polluted4)
//// builtin-mutation-forms.ts
// Methods of built-in prototypes and globals are replaced, added, wrapped and restored. A member of a locked prototype or of Math cannot be replaced, a store of the value it holds changes nothing and succeeds, Array.prototype takes no index, and Object.prototype takes nothing. A method added to Array.prototype, and what is not fixed (JSON.stringify, the bindings Promise and parseInt, the members of Error), changes as in plain Bun.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name : String(e))) } }
function hide(v: unknown): any { return v }
function parse(t: string): any { return JSON.parse(t) }
row("a method of Array.prototype replaced", () => { const was = Array.prototype.includes; try { hide(Array.prototype).includes = function () { return "mine" }; return String(hide([1]).includes(1)) + " " + String([1].includes(1)) } finally { hide(Array.prototype).includes = was } });
row("a method added to Array.prototype", () => { hide(Array.prototype).last = function (this: unknown[]) { return this[this.length - 1] }; const v = hide([1, 2, 3]).last(); delete hide(Array.prototype).last; return v });
row("a polyfill that is not needed", () => { if (!hide(Array.prototype).at) hide(Array.prototype).at = function () { return "polyfill" }; return [1, 2].at(-1) });
row("a polyfill that stores what is there already", () => { hide(Object).assign = Object.assign; hide(Array.prototype).map = Array.prototype.map; return [1].map(x => x + 1).join() });
row("Object.prototype gets a property", () => { hide(Object.prototype).marker = 7; const v = hide({}).marker + " " + hide([]).marker; delete hide(Object.prototype).marker; return v });
row("Symbol.iterator of Array.prototype replaced", () => { const was = Array.prototype[Symbol.iterator]; try { hide(Array.prototype)[Symbol.iterator] = function* () { yield 42 }; const out: number[] = []; for (const x of [1, 2]) out.push(x); return out.join() + " " + [...[1, 2]].join() } finally { hide(Array.prototype)[Symbol.iterator] = was } });
row("Math.max replaced", () => { const was = Math.max; try { hide(Math).max = () => -1; return Math.max(1, 2) + " " + hide(Math).max(1, 2) } finally { hide(Math).max = was } });
row("JSON.stringify wrapped", () => { const was = JSON.stringify; try { hide(JSON).stringify = function (...a: unknown[]) { return "<" + hide(was)(...a) + ">" }; return JSON.stringify(1) } finally { hide(JSON).stringify = was } });
row("globalThis.Promise replaced", () => { const was = Promise; try { hide(globalThis).Promise = class Mine { }; return hide(globalThis).Promise.name + " " + (Promise === was) } finally { hide(globalThis).Promise = was } });
row("a global function replaced", () => { const was = parseInt; try { hide(globalThis).parseInt = () => 7; return parseInt("1") + " " + hide(globalThis).parseInt("1") } finally { hide(globalThis).parseInt = was } });
row("String.prototype.toString, valueOf of a wrapper", () => { const was = Number.prototype.valueOf; try { hide(Number.prototype).valueOf = function () { return 5 }; return hide(new Number(1)) + 1 } finally { hide(Number.prototype).valueOf = was } });
row("an indexed accessor on Array.prototype", () => { try { Object.defineProperty(Array.prototype, "1", { get() { return "hole" }, configurable: true }); const a: unknown[] = [0, , 2]; return a[1] + " " + hide(a)[1] } finally { delete hide(Array.prototype)[1] } });
row("Error.prepareStackTrace | captureStackTrace", () => { const o: any = {}; hide(Error).captureStackTrace?.(o); return typeof o.stack });
row("Object.freeze(Array.prototype)", () => { return Object.isFrozen(Array.prototype) + " " + Object.isExtensible(Array.prototype) + " " + JSON.stringify(Object.getOwnPropertyDescriptor(Array.prototype, "push")?.writable) });
//// builtin-results-are-checked.ts
// What a built-in function or a catch clause yields is checked where it enters a declared place: JSON.parse, Reflect.get, Map.get, Object.values, Array.prototype.find and pop on untyped data, inside loops and try blocks.
class Failure extends Error { constructor(public code: number) { super("failure " + code); } }

function parsedText(text: string): string { const value: string = JSON.parse(text); return "text " + value.length; }
function parsedOptionalText(text: string): string { const value: string | undefined | null = JSON.parse(text); return value == null ? "nothing" : "text " + value.length; }
function parsedList(text: string): string { const value: string[] = JSON.parse(text); return "list " + value.length; }
function parsedCount(text: string): string { const value: number = JSON.parse(text); return "count " + (value + 1); }
function reflected(holder: object, key: string): string { const value: string = Reflect.get(holder, key); return "reflected " + value.length; }
function mapped(map: Map<string, any>, key: string): string { const value: string = map.get(key); return "mapped " + value.length; }
function firstValue(holder: Record<string, any>): string { const value: string = Object.values(holder)[0]; return "first " + value.length; }
function found(list: any[]): string { const value: string = list.find(x => x !== null); return "found " + value.length; }
function popped(list: any[]): string { const value: string[] = list.pop(); return "popped " + value.length; }
////= lines-7	caughtFailure	failure	Failure	failure.code
////= lines-7	caughtText	text	string	text.length
function inALoop(texts: string[]): string {
  let sum = 0;
  for (const text of texts) {
    const value: string = JSON.parse(text);
    sum += value.length;
  }
  return "sum " + sum;
}
function inATry(text: string): string {
  try {
    const value: string[] = JSON.parse(text);
    return "fine " + value.length;
  } catch (error) {
    return "caught " + (error as Error).name;
  }
}
function row(name: string, run: () => string): void {
  try {
    console.log(name, run());
  } catch (error) {
    console.log(name, "threw", (error as Error).name);
  }
}
const texts = ['"four"', "4", '["a","b"]', '{"length":2}', "null", "true"];
for (const text of texts) {
  for (const run of [parsedText, parsedOptionalText, parsedList, parsedCount, inATry]) row(run.name + " " + text, () => run(text));
}
const values: any[] = ["four", 4, ["a", "b"], { length: 2 }, undefined, false, () => 1, new Failure(7)];
for (const value of values) {
  const shown = typeof value === "function" ? "function" : value instanceof Failure ? "Failure" : JSON.stringify(value);
  row("reflected " + shown, () => reflected({ key: value }, "key"));
  row("mapped " + shown, () => mapped(new Map([["key", value]]), "key"));
  row("firstValue " + shown, () => firstValue({ key: value }));
  row("found " + shown, () => found([null, value]));
  row("popped " + shown, () => popped([value]));
  row("caughtFailure " + shown, () => caughtFailure(value));
  row("caughtText " + shown, () => caughtText(value));
}
row("in a loop", () => inALoop(['"a"', '"bc"']));
row("in a loop, the second is wrong", () => inALoop(['"a"', "2", '"bc"']));
//// builtin-writes-in-sloppy-code/main.ts
// In sloppy mode JavaScript ignores an assignment that fails. An assignment that the lock of a built-in refuses is not one of those: it throws a TypeError, whatever value it would replace, no setter runs, and `Reflect.set` returns false. What the language itself refuses stays ignored. Array.prototype keeps its members and takes no index and no well-known symbol, but a new ordinary name and a symbol of the program are stored as in plain Bun.
import { writes } from "./sloppy.cjs";
for (const it of writes) {
  try { console.log(it.label + ": " + String(it.write())); } catch (e: any) { console.log(it.label + ": " + e.name); }
}
//// builtin-writes-in-sloppy-code/sloppy.cjs
function f() {}
const key = Symbol.for("key");
module.exports.writes = [
  { label: "this is sloppy code", write() { return (function () { return this === undefined; })(); } },
  { label: "over a function", write() { Array.prototype.push = f; return Array.prototype.push === f; } },
  { label: "over the length of an array", write() { Array.prototype.length = 3; return Array.prototype.length; } },
  { label: "a new name", write() { Array.prototype.added = f; return "added" in Array.prototype; } },
  { label: "a new index", write() { Array.prototype[0] = f; return 0 in Array.prototype; } },
  { label: "a new symbol", write() { Array.prototype[key] = f; return key in Array.prototype; } },
  { label: "a new well-known symbol", write() { Array.prototype[Symbol.toPrimitive] = f; return Symbol.toPrimitive in Array.prototype; } },
  { label: "a new Symbol.toStringTag", write() { Array.prototype[Symbol.toStringTag] = "T"; return Symbol.toStringTag in Array.prototype; } },
  { label: "a new property named prototype", write() { Array.prototype.prototype = f; return "prototype" in Array.prototype; } },
  { label: "over a function under a symbol", write() { RegExp.prototype[Symbol.match] = f; return RegExp.prototype[Symbol.match] === f; } },
  { label: "read-only: a number", write() { Math.PI = 3; return Math.PI === 3; } },
  { label: "read-only: the name of a function", write() { Array.name = "x"; return Array.name; } },
  { label: "read-only: a string under a symbol", write() { Map.prototype[Symbol.toStringTag] = "x"; return Map.prototype[Symbol.toStringTag]; } },
  { label: "read-only: a function under a symbol", write() { Date.prototype[Symbol.toPrimitive] = f; return Date.prototype[Symbol.toPrimitive] === f; } },
  { label: "read-only: Symbol.hasInstance", write() { Function.prototype[Symbol.hasInstance] = f; return Function.prototype[Symbol.hasInstance] === f; } },
  { label: "not configurable: delete the length of an array", write() { return delete Array.prototype.length; } },
  { label: "an accessor without a setter", write() { Map.prototype.size = 1; return "ignored"; } },
  { label: "a setter that throws", write() { Function.prototype.caller = f; return "ignored"; } },
  { label: "Reflect.set, a setter that throws", write() { return Reflect.set(Iterator.prototype, "constructor", f); } },
  { label: "Reflect.set, an index", write() { return Reflect.set(Array.prototype, 0, f); } },
  { label: "Reflect.set, a symbol", write() { return Reflect.set(Array.prototype, key, f); } },
  { label: "the same value again", write() { Array.prototype.push = Array.prototype.push; return "stored"; } },
];
//// bun-int32-is-32-bit.ts
// `int32` as the module "bun" declares it is a 32-bit integer, under whatever name it is imported or aliased: the build stops at a value that it cannot prove to be one. The name alone says nothing: see int32-alias-is-number.
import type { int32 } from "bun";
import type { int32 as Whole } from "bun";
type Count = int32;
type Inline = import("bun").int32;
const given: number[] = JSON.parse("[3, 1.5]");
function half(n: int32): number { return n / 2; }
function whole(n: Whole): number { return n + 1; }
function counted(n: Count): number { return n * 2; }
function inline(n: Inline): number { return n - 1; }
function yielded(n: number): int32 { return n; }
class Cursor { line: int32 = 0; move(by: number): int32 { this.line = by; return this.line; } }
for (const n of given) {
  const kept: int32 = n;
  console.log(half(n), whole(n), counted(n), inline(n), yielded(n), new Cursor().move(n), kept);
}
//// callable-values-as-function-types.ts
// Any callable value fits a function type, whatever its representation. Anything else throws a TypeError.
type Unary = (x: number) => number
function double(x: number): number { return x * 2 }
class Box { value = 1 }
function call(f: Unary): number { return f(-3) }
function kindOf(f: Unary): string { return typeof f }
function attempt(label: string, value: any) { try { console.log(label + ":", call(value)) } catch (e) { console.log(label + ":", e instanceof TypeError ? "TypeError" : "other " + e) } }

console.log("arrow function:", call(x => x + 1))
console.log("bound function:", call(double.bind(null)))
console.log("class:", kindOf(Box as any))
console.log("callable Proxy:", call(new Proxy(double, {})))
console.log("native function:", call(Math.abs))

attempt("object", {})
attempt("Proxy of an object", new Proxy({}, {}))
attempt("number", 1)
attempt("string", "f")
export {};
//// callbacks-returning-objects-beside-external-data.ts
// A callback that gets untrusted elements and returns an object literal still makes the object of the type that is expected where the callback stands; only primitive results are left unasserted.
type Source = "built-in" | "plugin" | "file";
type Row = { readonly name: string; readonly source: Source };
const parsed = JSON.parse('{"names":["a","b"],"sources":["file","plugin"]}') as { names: string[]; sources: Source[] };
function report(rows: ReadonlyArray<Row>): string { let text = ""; for (const { name, source } of rows) text += name + ":" + source + " "; return text; }
function rowsOfNames(): Row[] { const names = ["x", ...parsed.names]; return names.map(name => ({ name, source: "file" })); }
function rowsOfSources(): Row[] { const sources = ["built-in" as Source, ...parsed.sources]; return sources.map(source => ({ name: "n", source })); }
function atOnce(): Row { const name = parsed.names[0]; const row: Row = (() => ({ name, source: "plugin" }))(); return row; }
console.log(report(rowsOfNames()), report(rowsOfSources()), report([atOnce()]));
//// cast-parsed-data-missing-members.ts
// Parsed JSON is cast to an interface: complete, without required members, with an unknown enumeration value, with one member more.
declare const console: { log(...values: unknown[]): void };
// An interface that the program ALSO makes by a literal somewhere (so it is not taken for data from outside), and casts from JSON elsewhere.
// (1) complete JSON (2) JSON that lacks required members the program never reads (3) an enumeration's value the type does not know yet.
interface Ctx { cwd: string }
interface Session { type: 'session'; id: string; title: string | null; status: 'idle' | 'running'; created: string; ctx: Ctx; tags?: string[] }
function fresh(id: string): Session { return { type: 'session', id, title: null, status: 'idle', created: 'now', ctx: { cwd: '/' } } }
function unwrap(data: unknown): Session | undefined { return data as Session | undefined }
function idOf(text: string): string { try { return String(unwrap(JSON.parse(text))?.id) } catch (e) { return 'THROWN: ' + (e as Error).message } }
console.log(fresh('a').id)
console.log('complete:', idOf('{"type":"session","id":"x","title":null,"status":"idle","created":"c","ctx":{"cwd":"/"}}'))
console.log('partial:', idOf('{"id":"y"}'))
console.log('new enum value:', idOf('{"type":"session","id":"z","title":null,"status":"paused","created":"c","ctx":{"cwd":"/"}}'))
console.log('one member more:', idOf('{"type":"session","id":"w","title":null,"status":"idle","created":"c","ctx":{"cwd":"/"},"extra":1}'))
