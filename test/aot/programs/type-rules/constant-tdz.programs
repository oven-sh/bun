//// early-error-after-ts-ignore.ts
// Plain Bun does not read `@ts-ignore`, so the comment does not suppress an ECMAScript early error in a compiled file.
console.log("never printed");
// @ts-ignore
break;
//// early-error-in-unchecked-file.ts
// Under `@ts-nocheck` the type error is not reported. The duplicate label is an ECMAScript early error and still stops the build.
// @ts-nocheck
const n: number = "x";
again: { again: { console.log(n); } }
//// early-errors-in-checked-code.ts
// Plain Bun rejects each of these while parsing. TypeScript accepts the first, and `@ts-ignore` hides its own errors for the other two, so the ECMAScript early errors stop the build.
function nested(await: number) { return 1; }
let held = 1;
// @ts-ignore
delete (held);
class Named {
  // @ts-ignore
  static prototype = 1;
}
console.log(nested, held, Named);
export {};
//// early-errors-in-expressions-after-ts-ignore.ts
// Plain Bun rejects every line below a `@ts-ignore` before it runs anything, so the comment does not suppress these early errors, which the checker reports while it types expressions.
declare const anything: any;
declare const makeDecorator: any;
function makeFields() { return class {
  // @ts-ignore
  field = arguments;
}; }
class NoBase { constructor() {
  // @ts-ignore
  super();
} }
function reads() {
  // @ts-ignore
  return super.member;
}
function calls() {
  // @ts-ignore
  super();
}
// @ts-ignore
console.log(anything.#name);
// @ts-ignore
@makeDecorator()()
class Decorated {}
console.log(makeFields, NoBase, reads, calls, Decorated);
//// enforced-types-slow-path.ts
// Functions that run once, whose written types are false, and null and undefined in reference slots that are then called and read.
function attempt(label: string, body: () => unknown): void {
  try {
    console.log(label, "returned", body());
  } catch (error) {
    console.log(label, "threw", error instanceof TypeError ? "TypeError" : "another error");
  }
}

class Point {
  x: number = 1;
  y: number = 2;
}

type Mode = "fast" | "slow" | 1;
type Small = 1 | 2 | 3;

////= lines-9	takesNumber	value	number	string	"number "	value
////= lines-9	takesMode	mode	Mode	string	"mode "	mode
////= lines-9	takesSmall	value	Small	string	"small "	value
function takesPoint(point: Point): string {
  return "point " + point.x;
}

attempt("number given number", () => takesNumber(1));
attempt("number given string", () => takesNumber("one" as any));
attempt("number given undefined", () => takesNumber(undefined as any));
attempt("number given null", () => takesNumber(null as any));

attempt("mode given string literal", () => takesMode("slow"));
attempt("mode given number literal", () => takesMode(1));
attempt("mode given other string", () => takesMode("medium" as any));
attempt("mode given other number", () => takesMode(2 as any));

attempt("small given member", () => takesSmall(3));
attempt("small given other integer", () => takesSmall(7 as any));
attempt("small given string", () => takesSmall("1" as any));

attempt("point given point", () => takesPoint(new Point()));
attempt("point given number", () => takesPoint(5 as any));
attempt("point given object with wrong field", () => takesPoint({ x: "wrong", y: 2 } as any));

class Holder {
  callback: (() => string) | null = null;
  target: Point | null = null;
  missing: Point | undefined = undefined;
}

function callCallback(holder: Holder): string {
  return holder.callback!();
}
function readTarget(holder: Holder): number {
  return holder.target!.x;
}
function readMissing(holder: Holder): number {
  return holder.missing!.x;
}
function storeTarget(holder: Holder): void {
  holder.target!.x = 3;
}

const empty = new Holder();
attempt("null slot called", () => callCallback(empty));
attempt("null slot read", () => readTarget(empty));
attempt("undefined slot read", () => readMissing(empty));
attempt("null slot stored", () => storeTarget(empty));

const filled = new Holder();
filled.callback = () => "called";
filled.target = new Point();
filled.missing = new Point();
attempt("filled slot called", () => callCallback(filled));
attempt("filled slot read", () => readTarget(filled));
attempt("filled undefined slot read", () => readMissing(filled));
//// enum-or-zero/main.ts
// A numeric enum type, and `Flags | 0`, is checked as `number`: -0, fractions and larger numbers are stored and read as in plain Bun.
////= attempt
enum Flags { None = 0, A = 1, B = 2, Top = 1 << 30 }
interface Complete { flags: Flags; name: string[] }
interface Incomplete { flags: Flags | 0; name: string[] }
const names = ["n"]
const whole: Complete = { flags: Flags.A | Flags.B, name: names }
const part: Incomplete = { flags: 0, name: names }
function flagsOf(it: Complete | Incomplete) { return it.flags }
console.log(flagsOf(whole), flagsOf(part), flagsOf(whole) | flagsOf(part), (flagsOf(part) & Flags.A) === 0, 1 / flagsOf(part))
part.flags = Flags.Top; console.log(part.flags, part.flags | 0, part.flags << 1)
part.flags = 0; console.log(part.flags, JSON.stringify(part))
let either: Flags | 0 = 0
function pass(f: Flags | 0): Flags | 0 { return f }
either = pass(Flags.B); console.log(either, pass(0), pass(either) + 1)
const minusZero: any = -0, fraction: any = 1.5, big: any = 2 ** 40
attempt("-0 into Flags", () => { whole.flags = minusZero; return 1 / whole.flags })
attempt("-0 into Flags | 0", () => { part.flags = minusZero; return 1 / part.flags })
attempt("1.5 into Flags", () => { whole.flags = fraction; return whole.flags })
attempt("1.5 into Flags | 0", () => { part.flags = fraction; return part.flags })
attempt("2 ** 40 into Flags | 0", () => { part.flags = big; return part.flags })
attempt("-0 into a variable", () => { either = minusZero; return 1 / either })
attempt("-0 as an argument", () => 1 / pass(minusZero))
// By itself `0` is a number: same as plain Bun.
function sign(x: number) { return x === 0 ? 1 / x : x }
console.log(sign(0), sign(-0), sign(3))
function zeroOrOne(x: number) { return x === 0 || x === 1 ? 1 / x : 0 }
console.log(zeroOrOne(0), zeroOrOne(-0), zeroOrOne(1))
const zero: 0 = -0; console.log(1 / zero, Object.is(zero, -0))
