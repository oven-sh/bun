// A cast to an object type lets any object through. A typed read behind a cast that finds a value of another kind throws a TypeError while the initializer of a top-level constant runs: that is while the module is loaded, not when the constant is first read.
////= load	typeof module.made
await load("a record as a class", () => import("./a-record-as-a-class"));
await load("a list as a class", () => import("./a-list-as-a-class"));
await load("a function as a class or null", () => import("./a-function-as-a-class-or-null"));
await load("a record as a class with a private field", () => import("./a-record-as-a-class-with-a-private-field"));
await load("a list as an error", () => import("./a-list-as-an-error"));
await load("a getter as a field that holds a function", () => import("./a-getter-as-a-field-that-holds-a-function"));
await load("a string read as a number", () => import("./a-string-read-as-a-number"));
await load("a number read as an object", () => import("./a-number-read-as-an-object"));
//// feature-test-in-try-catch-js.js
// A write that the lock of a built-in refuses and that a `catch` around it takes over is a warning, and the build goes on: the write throws a TypeError when it runs. A name that `Array.prototype` or `String.prototype` does not have can be added to it, a write to a built-in that is not locked succeeds, and the program sees them all.
const said = [];
try { Object.defineProperty(Array.prototype, "at", { value() { return "replaced"; }, writable: true, configurable: true }); said.push("defined"); } catch (e) { said.push("fell back: " + e.name); }
try { Object.defineProperty(Array.prototype, "lastOne", { get() { return this[this.length - 1]; }, configurable: true }); said.push("defined"); } catch (e) { said.push("fell back: " + e.name); }
try { String.prototype.shout = function () { return this.toUpperCase() + "!"; }; said.push("assigned"); } catch { said.push("fell back"); }
try {
  if (said.length === 3) {
    for (const name of ["a"]) {
      switch (name) {
        case "a":
          Math.max = () => 0;
          said.push("replaced");
      }
    }
  }
} catch (e) {
  said.push("fell back: " + (e instanceof TypeError));
} finally {
  said.push("finally");
}
try { try { Date.now = () => 42; said.push("replaced"); } finally { said.push("inner finally"); } } catch (e) { said.push("the outer catch: " + e.name); }
const later = () => { Object.prototype.never = 1; };
try { later(); said.push("stored"); } catch (e) { said.push("thrown in a function: " + e.name); }
console.log(said.join("\n"));
console.log([1, 2, 3].at(0), [1, 2, 3].lastOne, typeof "a".shout, Math.max(1, 2), Date.now() === 42, [].never);
//// field-covariance.ts
// A `{ pet: Dog }` used as a `{ pet: Animal }` receives a Cat.
interface Animal { species: string; legs: number }
interface Dog extends Animal { bark(): string; collar?: string }
interface Cat extends Animal { meow(): string }
interface DogOwner { who: string; pet: Dog }
interface AnimalOwner { who: string; pet: Animal }
function rule(label: string, f: () => unknown) { try { console.log(label + ": no error", f()) } catch (e) { console.log(label + ":", e instanceof TypeError ? "TypeError" : "other " + e) } }
const rex: Dog = { species: "dog", legs: 4, bark() { return "woof" } }
const tom: Cat = { species: "cat", legs: 4, meow() { return "meow" } }
function adopt(o: AnimalOwner, a: Animal) { o.pet = a }
function petOf(o: AnimalOwner): Animal { return o.pet }

const owner: DogOwner = { who: "ann", pet: rex }
adopt(owner, tom)
rule("a Cat read through the narrow view", () => owner.pet.species)
adopt(owner, { species: "snake", legs: 0 })
rule("a literal of the wide type read through the narrow view", () => owner.pet.legs)
rule("a store to what is read through the narrow view", () => { owner.pet.collar = "red"; return "stored" })
console.log(JSON.stringify(petOf(owner)), owner.who)

class Shelter { resident: Animal = tom; swap(a: Animal) { this.resident = a } legs() { return this.resident.legs } }
class Kennel extends Shelter { declare resident: Dog; noise() { return this.resident.bark() } }
const kennel = new Kennel()
rule("a field declared narrower in the subclass, in a method", () => kennel.noise())
rule("a field declared narrower in the subclass, from outside", () => kennel.resident.species)
console.log(kennel.legs())

interface Handler<T> { handle(x: T): string }
const dogHandler: Handler<Dog> = { handle(d) { return d.species } }
function handleWith(h: Handler<Animal>, a: Animal): string { return h.handle(a) }
rule("a handler for dogs is given a cat", () => handleWith(dogHandler, tom))

interface Frozenish { readonly pet: Dog }
const looked: Frozenish = owner
adopt(owner, tom)
rule("a readonly narrow view", () => looked.pet.species)

interface MaybeDog { pet?: Dog; spare: Dog | null }
interface MaybeAnimal { pet?: Animal; spare: Animal | null }
const maybe: MaybeDog = { spare: null }
function fill(m: MaybeAnimal) { m.pet = tom; m.spare = tom }
fill(maybe)
rule("an optional field", () => maybe.pet?.species)
rule("a field of a union type", () => maybe.spare?.legs)
console.log(Object.keys(maybe).join())

interface Boxed<T> { value: T }
const inner: Boxed<Boxed<Dog>> = { value: { value: rex } }
function refill(outer: Boxed<Boxed<Animal>>) { outer.value.value = tom }
refill(inner)
rule("two levels down", () => inner.value.value.species)
function replace(outer: Boxed<Boxed<Animal>>) { outer.value = { value: { species: "eel", legs: 0 } } }
replace(inner)
rule("a box of the wide type read through the narrow view", () => inner.value.value.species)
interface DogMaker { make: () => Dog }
interface AnimalMaker { make: () => Animal }
const maker: DogMaker = { make: () => rex }
function remake(m: AnimalMaker) { m.make = () => tom }
remake(maker)
rule("the result of a function-typed field", () => maker.make().species)
//// field-covariance-linked-list.ts
// Field covariance in a linked list: through the base type, `next` is given a node that is not of the subtype.
interface ListItem { value: number; next: ListItem | null }
interface TwoWay { value: number; next: TwoWay | null; prev: TwoWay | null }
function toText(head: ListItem | null): string { const out: number[] = []; for (let n = head; n !== null; n = n.next) out.push(n.value); return out.join() }
function reverse(head: ListItem | null): ListItem | null { let done: ListItem | null = null; while (head !== null) { const next: ListItem | null = head.next; head.next = done; done = head; head = next } return done }
function nextOfTwoWay(t: TwoWay): TwoWay | null { return t.next }
const first: TwoWay = { prev: null, value: 10, next: null }
const second: TwoWay = { value: 20, next: null, prev: first }
first.next = second
const mixedHead: ListItem = { value: 0, next: first }
try { console.log(toText(reverse(mixedHead))); console.log("stores through the narrower type: no error") } catch (e) { console.log("stores through the narrower type:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { console.log(nextOfTwoWay(second) === first); console.log("a link that holds a TwoWay: no error") } catch (e) { console.log("a link that holds a TwoWay:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { console.log(nextOfTwoWay(first) === (mixedHead as object)); console.log("a link that holds a ListItem, read as TwoWay: no error") } catch (e) { console.log("a link that holds a ListItem, read as TwoWay:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(toText(second), JSON.stringify(mixedHead))
//// field-made-readonly-via-untyped-ref.ts
// Untyped code makes a declared field of parsed JSON read-only that typed code holds too.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name + ": " + e.message.split("\n")[0] : String(e))) } }
function hide(v: unknown): any { return v }
function parse(t: string): any { return JSON.parse(t) }
interface Sub { v: number }
interface Item { id: string; n: number; sub: Sub | null }
const made: Item[] = [{ id: "m", n: 0.5, sub: { v: 1 } }, { id: "m", n: 1, sub: null }];
function bump(x: Item): number { x.n += 1; return x.n }
function kind(x: Item): string { return typeof x.n }
row("(made by typed code)", () => bump(made[0]) + bump(made[1]));
const text = '{"id":"s","n":7,"sub":null}';
row("made read-only by the untyped holder", () => { const held = parse(text); const t: Item = held; Object.defineProperty(held, "n", { writable: false }); let s = ""; try { bump(t) } catch (e) { s = (e as Error).name } return s + " " + held.n });
//// fields-read-through-this-external-data.ts
// A field with an inferred type that holds external data is read inside its class, through `this`.
const data = JSON.parse('{"t":"abc"}') as { t: number };
const say = (label: string, f: () => unknown): void => { let r: string; try { const v = f(); r = typeof v + " " + String(v); } catch (e) { r = "throws " + (e as Error).constructor.name; } console.log(label + " ==> " + r); };
class Public { v = data.t; sum() { return this.v + 1; } read() { return this.v; } }
class Assigned { v = 0; load() { this.v = data.t; return this; } sum() { return this.v + 1; } }
class Trusted { v = 2; sum() { return this.v + 1; } }
say("a public field, used inside", () => new Public().sum());
say("a public field, returned", () => new Public().read() + 1);
say("a public field assigned in a method", () => new Assigned().load().sum());
say("trusted fields stay exact", () => new Trusted().sum());
//// for-in-changed-prototypes.ts
// `for..in` over typed objects after attempts to change their prototype, their class's prototype, or the kind of their fields.
interface Rec { a: number; b?: string; c?: boolean; d: number }
function keysOf(o: object): string { const out: string[] = []; for (const k in o) out.push(k); return out.join("") }
function at(o: Rec, k: string): string { return String((o as unknown as Record<string, unknown>)[k]) }
function pairs(o: Rec): string { const out: string[] = []; for (const k in o) out.push(k + "=" + at(o, k)); return out.join("&") }
const full: Rec = { a: 1, b: "b", c: true, d: 4 }

const proto: Rec = { a: 10, b: "proto", d: 40 }
try { const child = Object.create(proto) as Rec & { own?: number }; console.log(keysOf(child)); console.log("inheritor of a compiled object cast to its type: no error") } catch (e) { console.log("inheritor of a compiled object cast to its type:", e instanceof TypeError ? "TypeError" : "other " + e) }

const moved: Rec = { a: 1, d: 2 }
try { Object.setPrototypeOf(moved, { inherited: 1, a: "hidden by own" }); console.log("another prototype: no error") } catch (e) { console.log("another prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { Object.setPrototypeOf(moved, full); console.log("a compiled object for prototype: no error") } catch (e) { console.log("a compiled object for prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { Object.setPrototypeOf(moved, null); console.log("no prototype: no error") } catch (e) { console.log("no prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(keysOf(moved), moved.a + moved.d, moved.b, moved.c)

class Base2 { p = 1; method() { return 0 } get acc() { return 0 } }
class Derived2 extends Base2 { q = 2; r?: number }
const inst = new Derived2()
try { (Base2.prototype as any).patched = true; console.log("property added to the prototype of a class: no error") } catch (e) { console.log("property added to the prototype of a class:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(keysOf(inst).replace("r", ""))
// Deleting an absent property is not an error, as in ECMAScript.
try { console.log(delete (Base2.prototype as any).patched); console.log("absent property of the prototype of a class deleted: no error") } catch (e) { console.log("absent property of the prototype of a class deleted:", e instanceof TypeError ? "TypeError" : "other " + e) }

const dressed: Rec = { a: 1, d: 2 }
const anyDressed: any = dressed
anyDressed.x = 1; anyDressed[5] = 1; dressed.b = "late"; anyDressed[Symbol("s")] = 1; anyDressed[0] = 1
console.log(keysOf(dressed))

const accessor: Rec = { a: 1, d: 2 }
let reads = 0
try { Object.defineProperty(accessor, "a", { get() { reads++; return 7 }, enumerable: true, configurable: true }); console.log("field made an accessor: no error") } catch (e) { console.log("field made an accessor:", e instanceof TypeError ? "TypeError" : "other " + e) }
const hiddenField: Rec = { a: 1, b: "h", d: 2 }
try { Object.defineProperty(hiddenField, "b", { enumerable: false }); console.log("field made non-enumerable: no error") } catch (e) { console.log("field made non-enumerable:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(keysOf(accessor), reads, pairs(accessor), reads, keysOf(hiddenField), hiddenField.b)

const parsed: Rec = JSON.parse('{"d":1,"z":0,"a":2,"1":3}')
console.log(keysOf(parsed), pairs(parsed))
//// freeze.ts
// Typed objects that are frozen, sealed or made non-extensible, and `delete` on them.
const closed = Object.preventExtensions({ k: 1 })
closed.k = 5
try { delete (closed as any).k; console.log("delete of a required field: no error") } catch (e) { console.log("delete of a required field:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(closed.k, Object.isExtensible(closed), JSON.stringify(closed))
//// frozen-and-sealed-objects.ts
// `delete` and stores on typed objects that are frozen, sealed or non-extensible.
interface Rec { a: number; b: string; opt?: number; flag?: boolean; inner: { n: number } }
const fixedWith: Rec = Object.preventExtensions({ flag: false, a: 1, b: "b", opt: 0, inner: { n: 1 } })
try { delete fixedWith.opt; console.log("delete of a field the literal has: no error") } catch (e) { console.log("delete of a field the literal has:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { delete fixedWith.flag; console.log("of the other: no error") } catch (e) { console.log("of the other:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { fixedWith.opt = 1; fixedWith.flag = true; console.log("stores to them: no error") } catch (e) { console.log("stores to them:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(JSON.stringify(fixedWith), Object.isExtensible(fixedWith), Object.isSealed(fixedWith), Object.isFrozen(fixedWith))
// The same without preventExtensions.
const made = { a: 1, b: "b", opt: 0, inner: { n: 1 } }
const seen: Rec = made
try { delete seen.opt; console.log("made as its own type, seen as Rec: no error") } catch (e) { console.log("made as its own type, seen as Rec:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(made.opt + 1, Object.keys(seen).join())
//// function-typed-members.ts
// A store into a member written as a function type, or declared as a method, refuses what is no function and takes any function, whatever its signature.
interface Handler {
  run: (n: number) => number;
  stop(): void;
}
////= attempt-2
const handler: Handler = { run: n => n + 1, stop() {} };
const notFunctions: [string, any][] = [
  ["a number", 0],
  ["a string", "text"],
  ["a boolean", true],
  ["an object", {}],
  ["an array", []],
  ["a symbol", Symbol("s")],
  ["a bigint", 10n],
  ["a regular expression", /x/],
];
const functions: [string, any][] = [
  ["a function of another signature", (a: string, b: string) => a + b],
  ["a class", class {}],
  ["a bound function", function () {}.bind(null)],
  ["an async function", async () => {}],
  ["a generator function", function* () {}],
  ["undefined", undefined],
  ["null", null],
];
function readRun(h: Handler) { return typeof h.run; }

for (const [label, value] of notFunctions) attempt("run = " + label, () => { handler.run = value; return "stored"; });
for (const [label, value] of notFunctions) attempt("stop = " + label, () => { handler.stop = value; return "stored"; });
attempt("run is what it was", () => handler.run(1));
for (const [label, value] of functions) attempt("run = " + label, () => { handler.run = value; return "stored"; });
for (const [label, value] of functions) attempt("stop = " + label, () => { handler.stop = value; return "stored"; });
attempt("a number stored through any", () => { (handler as any).run = 5; return typeof (handler as any).run; });
attempt("and a typed read of it", () => readRun(handler));
//// functions-written-for-typeof-json-parse.ts
// A function can be written for `typeof globalThis.JSON.parse`: it writes the types of its parameters.
type Reviver = (this: any, key: string, value: any) => any;
const parse: typeof globalThis.JSON.parse = (text: string, reviver?: Reviver) => globalThis.JSON.parse(text.trim(), reviver);
const first: typeof globalThis.JSON.parse = (text: string) => globalThis.JSON.parse(text.slice(0, 1));
const holder: { read: typeof globalThis.JSON.parse } = { read: (text: string, reviver?: Reviver) => globalThis.JSON.parse(text, reviver) };
const write: typeof JSON.stringify = (value: unknown) => JSON.stringify(value);
type Parsed = ReturnType<typeof globalThis.JSON.parse>;
const parsed: Parsed = parse("[7]");
console.log(parse(' {"a":1} ').a, first("12"), holder.read("[1,2]", (key, value) => (typeof value === "number" ? value + 1 : value)).join(), write([1]), parsed[0].toFixed(1));
Promise.resolve('{"b":2}').then(globalThis.JSON.parse).then(value => console.log(value.b));
interface Point { x: number; y: number }
console.log((JSON.parse('{"x":1,"y":2}') as Point).y, JSON.stringify({ x: 1, y: 2 }));
//// generator-yield-and-return-types.ts
// What a generator yields is tested against the element type written in its result type (`Generator<T>`, `Iterable<T>`, `AsyncGenerator<T>`). What it returns is not tested, and neither is anything in a generator whose result type is inferred.
const text: any = "text";
function* yields(v: any): Generator<number> { yield 1; yield v; }
function* yieldsIterable(v: any): Iterable<number> { yield v; }
function* returns(v: any): Generator<number, number> { yield 1; return v; }
function* inferred(v: any) { yield 1; yield v; }
async function* yieldsLater(v: any): AsyncGenerator<number> { yield v; }
////= attempt-2
function drain(iterable: Iterable<unknown>): string {
  const seen: unknown[] = [];
  try { for (const value of iterable) seen.push(value); } catch (e) { seen.push((e as Error).constructor.name); }
  return seen.join();
}

attempt("Generator<number> yields a number", () => drain(yields(2)));
attempt("Generator<number> yields a string", () => drain(yields(text)));
attempt("Generator<number> yields undefined", () => drain(yields(undefined)));
attempt("Iterable<number> yields a string", () => drain(yieldsIterable(text)));
attempt("Generator<number, number> returns a string", () => { const g = returns(text); g.next(); return g.next().value; });
attempt("an inferred result type, a string", () => drain(inferred(text)));
console.log("AsyncGenerator<number> yields a string:", await yieldsLater(text).next().then(step => String(step.value), e => (e as Error).constructor.name));
console.log("AsyncGenerator<number> yields a number:", await yieldsLater(3).next().then(step => String(step.value), e => (e as Error).constructor.name));
export {};
//// generators-and-promises-external-data.ts
// What a generator with an inferred type yields, and what a promise of an async function with an inferred type resolves to, may be external data of another type.
const data = JSON.parse('{"t":"abc"}') as { t: number };
const lines: string[] = [];
const say = (label: string, f: () => unknown): void => { let r: string; try { const v = f(); r = typeof v + " " + (typeof v === "object" ? JSON.stringify(v) : String(v)); } catch (e) { r = "throws " + (e as Error).constructor.name; } lines.push(label + " ==> " + r); };
function* each() { yield 1; yield data.t; }
function* trusted() { yield 1; yield 2; }
const later = async () => data.t;
say("a spread of a generator", () => [...each()][1] + 1);
say("for of over a generator", () => { let r = ""; for (const v of each()) r += v + 1; return r; });
say("destructured from a generator", () => { const [, second] = each(); return second + 1; });
say("Array.from of a generator", () => Array.from(each())[1] + 1);
say("added up", () => { let n = 0; for (const v of each()) n += v; return n; });
say("a trusted generator stays exact", () => { let n = 0; for (const v of trusted()) n += v; return n + 1; });
