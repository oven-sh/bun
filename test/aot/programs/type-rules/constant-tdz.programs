//// definite-assignment-only-referenced.ts
// `let value!: T; value;` names a variable that nothing was ever stored to and drops what it reads: an idiom of tests of types. Nothing goes by the value, so it is held to nothing, and the build does not stop.
type Color = "red" | "green";
let color!: Color;
color;
void color;
function inside(): string {
  let size!: number;
  size;
  return "ran";
}
console.log(inside());
let later!: number;
later;
later = 3;
later;
console.log(later);
for (let turn = 0; turn < 2; turn++) {
  let each!: { a: number };
  each;
  console.log(turn);
}
//// definite-assignment-read-in-initializer/made.ts
function make(known: boolean): { size: number } { let size!: number; if (known) size = 1; return { size }; }
export const made = make([1].length > 1);
//// definite-assignment-read-in-initializer/main.ts
// `let size!: number` promises that the variable is assigned before it is read. Nothing tests the promise: a read that finds the variable unassigned gives `undefined`, which passes every written type.
let loaded = false;
try {
  const module = await import("./made");
  loaded = true;
  console.log(JSON.stringify(module.made));
} catch (error) {
  console.log((error as Error).name, loaded ? "when it was read" : "while it was loaded");
}
//// delete-optional-field.ts
// `delete` of optional and nested fields through `any` and through optional chains.
const made = { a: { b: 1, c: 2 }, n: null }
const o: any = made
try { delete o.a?.b; console.log("delete o.a?.b: no error") } catch (e) { console.log("delete o.a?.b:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { delete o.a?.["c"]; console.log("delete o.a?.[c]: no error") } catch (e) { console.log("delete o.a?.[c]:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(JSON.stringify(o))
//// dependency-with-type-error/main.ts
// A package that ships TypeScript is held to the types it wrote, like the program. A file of a package that has a type error is not: its annotations test nothing, and the build goes on. The other files of the package keep their tests.
import { half as looseHalf } from "loose-package";
import { half as neighborHalf } from "loose-package/neighbor";
import { half as soundHalf } from "sound-package";

const eight: any = "8";
////= attempt-2
attempt("a package without type errors", () => soundHalf(eight));
attempt("a file of a package with a type error", () => looseHalf(eight));
attempt("another file of that package", () => neighborHalf(eight));
//// dependency-with-type-error/node_modules/loose-package/index.ts
export const mistyped: number = "text";
export function half(n: number) { return n / 2; }
//// dependency-with-type-error/node_modules/loose-package/neighbor.ts
