//// constant-tdz.ts
// A read of a `const` in its temporal dead zone throws a ReferenceError, also where the initializer is a constant primitive expression that the compiler folds.
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
enum Color { Red = 1, Green = 2 }
function readNumber(): number { return earlyNumber }
function readDouble(): number { return earlyDouble }
function readBoolean(): boolean { return earlyBoolean }
function readText(): string { return earlyText }
function readNull(): null { return earlyNull }
function readUndefined(): undefined { return earlyUndefined }
function typeOfIt(): string { return typeof earlyNumber }
function readComputed(): number { return earlyComputed }
function readOther(): number { return earlyOther }
function readMember(): Color { return earlyMember }
function readTemplate(): string { return earlyTemplate }
console.log("constants:", [readNumber, readDouble, readBoolean, readText, readNull, readUndefined, typeOfIt, readComputed, readOther, readMember, readTemplate].map(attempt).join())
let caught = "no"
try { readNumber() } catch { caught = "yes" }
// @ts-expect-error A read in the dead zone that is not inside a function is what this line is for.
try { caught += earlyDouble } catch (e) { caught += (e as Error).constructor.name }
console.log("caught:", caught)
function inner(): string {
  const read = () => local
  const first = attempt(read)
  const local = "set"
  return first + " " + attempt(read)
}
console.log("in a function:", inner())
// Initializers that are no constant primitive expressions.
function readLet(): number { return earlyLet }
function readObject(): { v: number } { return earlyObject }
function readCall(): number { return earlyCall }
function readLong(): string { return earlyLong }
function readOfLet(): number { return earlyOfLet }
function readClass(): unknown { return EarlyClass }
function readKindOfClass(): string { return typeof EarlyClass }
console.log("exact:", [readLet, readObject, readCall, readLong, readOfLet, readKindOfClass].map(attempt).join())
const earlyNumber: number = 5, earlyDouble: number = 0.5, earlyBoolean: boolean = false, earlyText: string = "", earlyNull = null, earlyUndefined = undefined
const earlyComputed = 2 * 3 + 1, earlyOther = earlyComputed - 1, earlyMember = Color.Green, earlyTemplate = `a${earlyOther}b`
let earlyLet = 5
const earlyObject = { v: 0 }, earlyCall = Math.abs(-5), earlyOfLet = earlyLet
const earlyLong = "0123456789012345678901234567890123456789012345678901234567890123456789"
class EarlyClass {}
console.log("after:", [readNumber, readDouble, readBoolean, readText, readNull, readUndefined, typeOfIt, readComputed, readOther, readMember, readTemplate].map(attempt).join())
console.log("after:", [readLet, readCall, readOfLet].map(attempt).join(), readObject().v, readLong().length, readClass() === EarlyClass)
//// construct-signatures.ts
// `new` on values that are known only by a construct signature: functions, classes and proxies of classes.
function rule(label: string, f: () => unknown) { try { console.log(label + ": no error", f()) } catch (e) { console.log(label + ":", e instanceof TypeError ? "TypeError" : "other " + e) } }
interface Gauge { level: number; unit: string; read(): string; reset?(): void }
interface GaugeCtor { new (level: number): Gauge; readonly kindName: string }
class ClassGauge implements Gauge {
  static kindName = "class"
  unit = "c"
  level: number
  constructor(level: number) { this.level = level }
  read() { return this.level + this.unit }
}
class ResettableGauge extends ClassGauge {
  static override kindName = "resettable"
  initial: number
  constructor(level: number) { super(level); this.initial = level; this.unit = "r" }
  reset() { this.level = this.initial }
}
function FnGauge(this: Gauge, level: number) { this.level = level; this.unit = "f" }
FnGauge.prototype.read = function (this: Gauge) { return this.unit + ":" + this.level }
FnGauge.kindName = "function"
const byFunction = new (FnGauge as unknown as GaugeCtor)(4)
rule("method on F.prototype", () => byFunction.read())
console.log(byFunction.level + byFunction.unit, Object.keys(byFunction).join())
const constructLog: string[] = []
const ProxiedGauge: typeof ClassGauge = new Proxy(ClassGauge, {
  construct(target, args, newTarget) { constructLog.push("construct " + args.join() + " " + (newTarget === ProxiedGauge)); return Reflect.construct(target, [args[0] * 2], newTarget) },
})
rule("proxy of a class as new.target", () => new ProxiedGauge(4).read())
console.log(constructLog.join(";"), ProxiedGauge.kindName)
class ReturningGauge {
  static kindName = "returning"
  ignored = 1
  constructor(level: number) { return { level, unit: "o", read() { return "other " + this.level } } as any }
}
rule("constructor of a class returns another object", () => new (ReturningGauge as unknown as GaugeCtor)(4).read())
const config: { Gauge: GaugeCtor } = { Gauge: ClassGauge }
rule("field that holds the constructor made an accessor", () => Object.defineProperty(config, "Gauge", { get() { return ClassGauge }, configurable: true, enumerable: true }) === config)
console.log(new config.Gauge(5).read(), typeof Object.getOwnPropertyDescriptor(config, "Gauge")!.get)
//// constructor-as-generator.js
// An instance method named `constructor` that is a generator is an ECMAScript early error, so it stops the build in a JavaScript file too.
class A { *constructor() {} }
console.log(typeof A);
//// constructor-as-generator-after-ts-ignore.ts
// Plain Bun rejects an instance generator named `constructor` while parsing, so `@ts-ignore` does not suppress the error in a compiled file.
class A {
  // @ts-ignore
  *constructor() {}
}
console.log(typeof A);
//// constructor-read-through-object.ts
// `constructor` is declared once, in `interface Object`, as a Function for every object. What an object really holds there is its own business.
const lines: string[] = [];
function* numbers() {
  yield 1;
}
async function* later() {
  yield 1;
}
function kind(value: {} | null | undefined): string {
  switch (value?.constructor?.name) {
    case "String":
      return "a string";
    case "Array":
      return "an array";
    default:
      return "something else: " + typeof value?.constructor;
  }
}
function nameOf(value: object): string | undefined {
  return value.constructor.name;
}
function typeOfConstructor(value: object): string {
  const constructor = value.constructor;
  return typeof constructor;
}
function isMadeBy(value: object, maker: Function): boolean {
  return value.constructor === maker;
}
function lengthOf(value: object): unknown {
  return value.constructor.length;
}
class Point {
  constructor(
    readonly x: number,
    readonly y: number,
  ) {}
  again(): Point {
    return new (this.constructor as typeof Point)(this.y, this.x);
  }
}
class Shadowed {
  declare ["constructor"]: typeof Shadowed;
  static label = "static member";
  label(): string {
    return this.constructor.label;
  }
}
const withoutPrototype: object = Object.create(null);
const withNumber: object = Object.create({ constructor: 5 });
const withString: object = { constructor: "text" };
const withObject: object = { constructor: { name: "an object's name" } };
const withUndefined: object = { constructor: undefined };
const withNull: object = { constructor: null };
lines.push([kind("a"), kind([1]), kind(numbers()), kind(later()), kind(withoutPrototype), kind(null), kind(undefined), kind(1), kind(new Point(1, 2))].join(" | "));
lines.push([kind(withNumber), kind(withString), kind(withObject), kind(withUndefined), kind(withNull)].join(" | "));
for (const [title, value] of [
  ["a generator", numbers()],
  ["an async generator", later()],
  ["a generator function's prototype", numbers.prototype],
  ["a number there", withNumber],
  ["a string there", withString],
  ["an object there", withObject],
  ["an instance", new Point(1, 2)],
  ["an array", []],
  ["a function", kind],
  ["a class", Point],
  ["a Map", new Map()],
  ["a promise", Promise.resolve(1)],
  ["an error", new RangeError("x")],
  ["a bound function", kind.bind(null)],
  ["a proxy", new Proxy({}, { get: () => 7 })],
  ["arguments", (function () { return arguments; })()],
] as [string, object][])
  lines.push(`${title}: ${String(nameOf(value))}, ${typeOfConstructor(value)}, ${isMadeBy(value, Object)}, ${String(lengthOf(value))}`);
for (const [title, value] of [
  ["nothing there", withoutPrototype],
  ["undefined there", withUndefined],
  ["null there", withNull],
] as [string, object][]) {
  lines.push(`${title}: ${typeOfConstructor(value)}, ${isMadeBy(value, Object)}`);
  try {
    lines.push(String(nameOf(value)));
  } catch (error) {
    lines.push(`${title}: reading its name threw ${(error as Error).constructor.name}`);
  }
}
const turned = new Point(1, 2).again();
lines.push(`${turned.x} ${turned.y} ${turned.constructor === Point} ${new Shadowed().label()}`);
console.log(lines.join("\n"));
//// containers-of-objects-stay-typed-beside-external-data.ts
// The rule for containers that hold external data is about primitive elements. An array of promises or of objects derived from external data keeps its element type: what such objects are is decided by their own types.
type Part = { id?: number; name?: string };
function later<R>(text: string): Promise<R> { return Promise.resolve(JSON.parse(text) as R); }
async function both(): Promise<string> {
  const [first, second] = await Promise.all([later<{ k: Part }>('{"k":{"id":1}}'), later<{ e: string }>('{"e":"x"}')]);
  return JSON.stringify(first.k) + second.e;
}
const parsed = JSON.parse('{"items":[{"id":1},{"id":2}]}') as { items: Part[] };
function objects(): string {
  const picked = [parsed.items[0], parsed.items[1]];
  picked.push(parsed.items[0]);
  let ids = "";
  for (const part of picked) ids += part.id;
  return ids + picked.length;
}
console.log(await both(), objects());
