//// literals-test-the-kind.ts
// A literal type (`"a" | "b"`, `1 | 2`, `true`, `keyof X`, a template literal type, an enum) tests the kind of the primitive and never the value, wherever it is written: in a cast, a parameter, a variable, a result, a field, an element. A string outside the list goes through, and so does a number: nothing throws that `bun run` does not throw, and the code that has the type is left for the code that does not.
declare const console: { log(...values: unknown[]): void };
interface Specs { "reference": number; "amd-module": number }
const table: Specs = { "reference": 1, "amd-module": 2 };
enum Color { Red = "red", Blue = "blue" }
enum Level { Low = 1, High = 2 }
type Size = `${number}px`;
const hide = (value: unknown): unknown => value;
////= lines-13	attempt	String

function find(text: string): number | undefined {
    const name = text.toLowerCase() as keyof Specs;
    return table[name];
}
attempt("keyof, a key", () => find("REFERENCE"));
attempt("keyof, no key", () => find("nothing"));
attempt("keyof typeof", () => table["other" + "" as keyof typeof table]);

attempt("strings, listed", () => hide("a") as "a" | "b");
attempt("strings, not listed", () => hide("c") as "a" | "b");
attempt("strings, a number", () => hide(1) as "a" | "b");
attempt("strings, an object", () => hide({}) as "a" | "b");
attempt("strings, undefined", () => hide(undefined) as "a" | "b");
attempt("numbers, listed", () => hide(2) as 1 | 2 | 3);
attempt("numbers, not listed", () => hide(7.5) as 1 | 2 | 3);
attempt("numbers, a string", () => hide("2") as 1 | 2 | 3);
attempt("true, false", () => hide(false) as true);
attempt("true, a number", () => hide(1) as true);
attempt("bigint, not listed", () => hide(5n) as 1n | 2n);
attempt("bigint, a number", () => hide(5) as 1n | 2n);
attempt("template, fits", () => hide("4px") as Size);
attempt("template, does not fit", () => hide("wide") as Size);
attempt("template, a number", () => hide(4) as Size);
attempt("string enum, a member", () => hide("red") as Color);
attempt("string enum, no member", () => hide("green") as Color);
attempt("string enum, a number", () => hide(1) as Color);
attempt("numeric enum, no member", () => hide(9) as Level);
attempt("numeric enum, a string", () => hide("Low") as Level);
attempt("mixed, not listed", () => hide("z") as "a" | 1 | Specs);
attempt("mixed, a boolean", () => hide(true) as "a" | 1 | Specs);

const wide = hide({ a: 1, b: 2, c: 3 }) as { a: number; b: number };
attempt("an array of keys, one not listed", () => { let all = ""; for (const key of Object.keys(wide) as (keyof typeof wide)[]) all += key; return all; });
attempt("an array, not listed", () => (hide(["c"]) as ("a" | "b")[])[0]);
attempt("an array, a number", () => (hide([1]) as ("a" | "b")[])[0]);
attempt("a set, not listed", () => { let all = ""; for (const name of hide(new Set(["c"])) as Set<"a" | "b">) all += name; return all; });
attempt("a map, not listed", () => (hide(new Map([["c", 7]])) as Map<"a" | "b", 1 | 2>).get("c" as "a"));

function switched(text: string): string {
    switch (text as "a" | "b") {
        case "a": return "first";
        case "b": return "second";
    }
    return "neither";
}
attempt("a switch over the cast", () => switched("a") + " " + switched("b") + " " + switched("c"));
function compared(text: string): boolean { const name = text as "a" | "b"; return name === "a" || name === "b"; }
attempt("compared with every literal", () => compared("a") + " " + compared("c"));

function takes(name: "a" | "b"): string { return name; }
function gives(value: unknown): keyof Specs { return value as any; }
class Holder { name: "a" | "b" = "a"; level: 1 | 2 = 1; on: true = true; color: Color = Color.Red; }
interface Update { destination: "session" | "argument"; }
const widen = (value: unknown): any => value;
attempt("a parameter, listed", () => takes(widen("b")));
attempt("a parameter, not listed", () => takes(widen("c")));
attempt("a parameter, a number", () => takes(widen(1)));
attempt("a variable, not listed", () => { const name: "a" | "b" = widen("c"); return name; });
attempt("a variable, a number", () => { const name: "a" | "b" = widen(1); return name; });
attempt("a result, not listed", () => gives("nothing"));
attempt("a result, a number", () => gives(1));
attempt("a field, not listed", () => { const holder = new Holder(); holder.name = widen("c"); return holder.name; });
attempt("a field, a number", () => { const holder = new Holder(); holder.name = widen(1); return holder.name; });
attempt("a number field, not listed", () => { const holder = new Holder(); holder.level = widen(7.5); return holder.level; });
attempt("a number field, a string", () => { const holder = new Holder(); holder.level = widen("1"); return holder.level; });
attempt("a true field, false", () => { const holder = new Holder(); holder.on = widen(false); return holder.on; });
attempt("a true field, a number", () => { const holder = new Holder(); holder.on = widen(1); return holder.on; });
attempt("an enum field, no member", () => { const holder = new Holder(); holder.color = widen("green"); return holder.color; });
attempt("an enum field, a number", () => { const holder = new Holder(); holder.color = widen(1); return holder.color; });
attempt("a cast into a property, not listed", () => { const source: "session" | "argument" | "flag" = widen("flag"); const update: Update = { destination: source as Update["destination"] }; return update.destination; });
attempt("a property, a number", () => { const update: Update = { destination: widen(1) }; return update.destination; });
attempt("an element, not listed", () => { const names: ("a" | "b")[] = []; names.push(widen("c")); return names[0]; });
attempt("an element, a number", () => { const names: ("a" | "b")[] = widen([1]); return names[0]; });

function exhaustive(name: "a" | "b"): string {
    switch (name) {
        case "a": return "first";
        case "b": return "second";
    }
}
attempt("a switch that lists every literal", () => exhaustive(widen("a")) + " " + exhaustive(widen("c")));
function outside(name: "a" | "b"): boolean { return (name as string) === "c"; }
attempt("compared with a literal outside the list", () => outside(widen("c")) + " " + outside(widen("a")));
type Shape = { kind: "circle"; radius: number } | { kind: "square"; side: number };
function measure(shape: Shape): unknown { return shape.kind === "circle" ? shape.radius : shape.side; }
attempt("a discriminant outside the list", () => measure(widen({ kind: "line", radius: 1, side: 2 })));
//// live-code-compares-with-the-literal-of-a-removed-arm.ts
// A build that removes an arm makes no new type error in live code: the result that the checker infers is TypeScript's, with the literal of the removed arm in it.
function mode(fast: boolean) {
  if (false) {
    return "dev";
  }
  if (fast) return "fast";
  return "prod";
}
function shape(fast: boolean) {
  if (false) {
    return { kind: "dev" as const, trace: "t" };
  }
  return fast ? { kind: "fast" as const } : { kind: "prod" as const };
}
function compared(fast: boolean): string {
  return mode(fast) === "dev" ? "development" : "other";
}
function switched(fast: boolean): string {
  switch (mode(fast)) {
    case "dev":
      return "never";
    case "fast":
      return "quick";
    default:
      return "slow";
  }
}
function read(fast: boolean): string {
  const made = shape(fast);
  return made.kind === "dev" ? made.trace : made.kind;
}
console.log(compared(true), switched(true), switched(false), read(true), read(false));
//// locked-prototypes-beside-a-replaced-math-function.ts
// `Object.prototype` is closed entirely: a store of a new name throws. `Array.prototype` only keeps its members: it takes a new name, and every array sees it. The members of `Math` are fixed but for the few that packages replace. `Math.sign` is one of those, a constant only in a program that never writes it: this program replaces it and sees its write.
interface Rec { n: number; o?: number }
function fresh(): Rec { return { n: 1 } }
try { (Object.prototype as any).o = 12; console.log("a property added to Object.prototype: no error") } catch (e) { console.log("a property added to Object.prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(fresh().o, delete (Object.prototype as any).o, fresh().o)
try { (Array.prototype as any).o6 = 12; console.log("a property added to Array.prototype: no error") } catch (e) { console.log("a property added to Array.prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(([] as any).o6)
// A member that is not fixed can be replaced, and the program sees its write.
try { (Math as any).sign = () => 0; console.log("Math.sign replaced: no error") } catch (e) { console.log("Math.sign replaced:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(Math.sign(1.5))
//// log-build-continues-after-mismatch.ts
// A log build goes on after a value fails its type, and the code after the check works on the value as it is: it prints what plain Bun prints.
import type { int32 } from "bun";

const raw: any = JSON.parse('{"text":"3","number":4,"fraction":1.5,"list":["a",2,null],"point":{"y":1,"x":"left"},"flag":"yes"}');

function double(n: number): number {
  return n * 2;
}
console.log(double(raw.text), double(raw.number));
console.log((raw.text as number) + 1, (raw.number as number) + 1);

////= lines-8	Point	x	number	y	number
function sum(point: Point): number {
  return point.x + point.y;
}
console.log(sum(raw.point), sum({ x: 1, y: 2 }), sum(raw.text));

class Counter {
  count: number = 0;
  label: string = "counter";
  add(step: number): number {
    this.count += step;
    return this.count;
  }
}
const counter = new Counter();
console.log(counter.add(1), counter.add(raw.text), counter.add(1));
console.log(typeof counter.count, counter.count);
counter.label = raw.number;
console.log(typeof counter.label, counter.label + 1);
const detached: any = counter.add;
console.log(detached.call({ count: 5 }, 2), detached.call(raw.point, 2));

const literal: Point = { x: raw.text, y: 2 };
console.log(literal.x + literal.y, Object.keys(literal).join());

const numbers: number[] = raw.list;
let total: number = 0;
for (const value of numbers) total += value;
console.log(total);
const own: number[] = [1, 2];
own.push(raw.text);
console.log(own[2] * 2, own.map(value => value + 1).join());

type Flag = "on" | "off";
function describe(flag: Flag): string {
  switch (flag) {
    case "on":
      return "is on";
    case "off":
      return "is off";
    default: {
      const impossible: never = flag;
      return "neither: " + impossible;
    }
  }
}
console.log(describe("on"), describe(raw.flag));

function untyped(): any {
  return raw.text;
}
function result(): number {
  return untyped();
}
console.log(result() + 1);

function pick(condition: boolean, a: string, b: string): string {
  return condition ? a : b;
}
console.log(pick(raw.text, "truthy", "falsy"), pick(raw.missing, "truthy", "falsy"), pick(true, raw.number, "b"));

let shared: number = 1;
const bump = () => {
  shared = shared + 1;
  return shared;
};
shared = raw.text;
console.log(bump(), bump());

function half(whole: int32): number {
  return whole / 2;
}
// An `any` that is passed for an `int32` stops the build, so these two calls go a way that the build does not follow.
const halfOfAnything: (whole: any) => number = half;
console.log(half(8), halfOfAnything(raw.fraction), halfOfAnything(raw.text));

function rest(...values: number[]): number {
  let joined: number = 0;
  for (const value of values) joined += value;
  return joined;
}
console.log(rest(1, 2), rest(1, raw.text, 2));

async function later(value: number): Promise<number> {
  return value;
}
console.log((await later(raw.text)) + 1);
//// loop-bounds-that-arrive-boxed.ts
// A loop counts an int32 against a bound that arrives boxed: integers, fractions, -0, NaN, infinities, numbers beyond int32, with each relation and the bound on either side. The output is that of plain Bun.
const bounds: any[] = JSON.parse("[0, 1, 2, 5, -1, -5, 2.5, 4.000001, 3.999999, -0.5, 0.5, 2147483647, 2147483648, -2147483648, -2147483649, 1e10, -1e10, 4611686018427387904, -4611686018427387904, 1e300]");
bounds.push(-0, NaN, Infinity, -Infinity);

let bound: number = 0;
function setBound(value: any, depth: number): void { if (depth > 0) setBound(value, depth - 1); bound = value; }

const most = 8;
function below(): number { let turns = 0; const n = bound; for (let i = 0; i < n; i = (i + 1) | 0) { if (++turns >= most) break; } return turns; }
function atMost(): number { let turns = 0; const n = bound; for (let i = 0; i <= n; i = (i + 1) | 0) { if (++turns >= most) break; } return turns; }
function above(): number { let turns = 0; const n = bound; for (let i = 0; i > n; i = (i - 1) | 0) { if (++turns >= most) break; } return turns; }
function atLeast(): number { let turns = 0; const n = bound; for (let i = 0; i >= n; i = (i - 1) | 0) { if (++turns >= most) break; } return turns; }
function boundOnLeftAbove(): number { let turns = 0; const n = bound; for (let i = 0; n > i; i = (i + 1) | 0) { if (++turns >= most) break; } return turns; }
function boundOnLeftAtLeast(): number { let turns = 0; const n = bound; for (let i = 0; n >= i; i = (i + 1) | 0) { if (++turns >= most) break; } return turns; }
function boundOnLeftBelow(): number { let turns = 0; const n = bound; for (let i = 0; n < i; i = (i - 1) | 0) { if (++turns >= most) break; } return turns; }
function boundOnLeftAtMost(): number { let turns = 0; const n = bound; for (let i = 0; n <= i; i = (i - 1) | 0) { if (++turns >= most) break; } return turns; }
function nearTheTop(): number { let turns = 0; const n = bound; for (let i = 2147483645; i < n; i = (i + 1) | 0) { if (++turns >= most) break; } return turns; }

let lines: string[] = [];
for (let round = 0; round < 200; round++) {
  lines = [];
  for (const value of bounds) {
    setBound(value, 0);
    lines.push([below(), atMost(), above(), atLeast(), boundOnLeftAbove(), boundOnLeftAtLeast(), boundOnLeftBelow(), boundOnLeftAtMost(), nearTheTop()].join(" "));
  }
}
console.log(lines.join("\n"));
//// method-declared-in-another-file/default.ts
export interface Dial { level: number; inner: { a: number }; turn(this: Dial, to: number): number }
function turnTo(this: Dial, to: number): number { this.level = to; return this.level + 7; }
export default turnTo;
//// method-declared-in-another-file/main.ts
// A function that begins with a store to `this` looks like a constructor function, but here another file stores it as a method, so its `this` may be anything that satisfies the type: an heir of a typed object too.
import { reset, fill as fillGauge, type Tally, type Gauge } from "./methods";
import turn, { type Dial } from "./default";
function makeTally(count: number): Tally { return { count, inner: { a: count }, reset }; }
const tallies: Tally[] = [makeTally(1), makeTally(2)];
const gauges: Gauge[] = [{ level: 1, inner: { a: 1 }, fill: fillGauge }, { level: 2, inner: { a: 2 }, fill: fillGauge }];
const dials: Dial[] = [{ level: 1, inner: { a: 1 }, turn }, { level: 2, inner: { a: 2 }, turn }];
let sum = 0;
for (const t of tallies) sum += t.reset(3) + t.inner.a;
for (const g of gauges) sum += g.fill(3) + g.inner.a;
for (const d of dials) sum += d.turn(3) + d.inner.a;
console.log(sum);
const call = function (o: any, name: string, x: any): any { try { return [o[name](x), Object.keys(o).join()].join(" "); } catch (error: any) { return error.constructor.name; } };
console.log("the typed objects:", call(tallies[0], "reset", 5), "|", call(gauges[0], "fill", 5), "|", call(dials[0], "turn", 5));
console.log("heir; the method has the word export:", call(Object.create(tallies[0]!), "reset", 5));
console.log("heir; the method is named in an export list:", call(Object.create(gauges[0]!), "fill", 5));
console.log("heir; the method is the default export:", call(Object.create(dials[0]!), "turn", 5));
//// method-declared-in-another-file/methods.ts
export interface Tally { count: number; inner: { a: number }; reset(this: Tally, to: number): number }
export function reset(this: Tally, to: number): number { this.count = to; return this.count + 1; }
export interface Gauge { level: number; inner: { a: number }; fill(this: Gauge, to: number): number }
function fillTo(this: Gauge, to: number): number { this.level = to; return this.level * 2; }
export { fillTo as fill };
//// method-named-like-one-of-the-runtime.ts
// What a program does may not depend on what its methods are called. Both pairs of classes are the same but for the name of one method,
// and the modules that the runtime itself is written in have methods of the first name.
let seen: number = 0;
class Base { constructor() { seen = this.peek(); } peek(): number { return 1; } }
class Derived extends Base { n: number = 3; peek(): number { return this.n; } }
new Derived();
console.log(typeof seen, seen + 1);
let seenToo: number = 0;
class BaseToo { constructor() { seenToo = this.peekAtTheField(); } peekAtTheField(): number { return 1; } }
class DerivedToo extends BaseToo { n: number = 3; peekAtTheField(): number { return this.n; } }
new DerivedToo();
console.log(typeof seenToo, seenToo + 1);
//// method-replaced-by-any-function.ts
// A method that the program replaces with a function of type `any`: the result of that function is checked
// against the method's return type, like the result of a function stored in a variable of the method's type.
type Answer = { ok: true; value: string } | { ok: false; error: string }
class Client {
  constructor(readonly base: string) {}
  get(id: number): Answer { return { ok: true, value: this.base + id } }
  async later(id: number): Promise<Answer> { return this.get(id) }
}
const client = new Client("real")
function nameOf(id: number) { const answer = client.get(id); return answer.ok ? answer.value : answer.error }
async function nameLater(id: number) { const answer = await client.later(id); return answer.ok ? answer.value : answer.error }
function attempt(label: string, f: () => unknown) {
  try { console.log(label + ":", String(f())) } catch (e) { console.log(label + ":", e instanceof TypeError ? "TypeError" : "other " + e) }
}
attempt("the method", () => nameOf(1))
const real = client.get
client.get = () => ({ ok: false, error: "typed" })
attempt("a function of the method's type", () => nameOf(1))
const named = { ok: false, error: "named" }
client.get = (() => named) as any
attempt("an object with a name of its own", () => nameOf(1))
const functions: any[] = [() => ({ ok: true, value: "listed" })]
client.get = functions[0]
attempt("a function out of an array of any", () => nameOf(1))
client.get = real
attempt("the method again", () => nameOf(2))
const late = { ok: true, value: "late" }
client.later = (async () => late) as any
console.log(await nameLater(1))
//// method-results-of-overloaded-generic-records.ts
// A generic overload over an implementation that is typed with `unknown`, one step on: a method of the record that the implementation makes
// returns a record of its own, laid out as { value: unknown }, and the call through the promised type expects { value: number }. The value fits, so the record is taken as it is.
interface Fold<In extends unknown[], Out> {
  readonly run: (box: { value: In }) => { value: Out };
  readonly initial: Out;
}
function fold<In extends unknown[], Out>(initial: Out): Fold<In, Out>;
function fold(initial: unknown): Fold<unknown[], unknown> {
  return { initial, run(box) { return { value: box.value.length }; } };
}
const step = fold<number[], number>(0);
console.log(step.run({ value: [9, -12, 345] }).value + 1);
//// methods-through-interfaces.ts
// Interfaces with methods, implemented by literals, classes, inheriting objects and proxies, and methods called with another object as `this`.
interface Speaker { id: number; speak(greeting: string): string; shout?(): string }
function sharedSpeak(this: Speaker, greeting: string): string { return greeting + " shared " + this.id }
class ClassSpeaker implements Speaker {
  constructor(public id: number) {}
  speak(greeting: string): string { return greeting + " class " + this.id }
}
class LoudSpeaker extends ClassSpeaker {
  override speak(greeting: string): string { return super.speak(greeting).toUpperCase() }
  shout(): string { return "LOUD" + this.id }
}
////= attempt
function talk(s: Speaker): string { return s.speak("hi") + "|" + (s.shout?.() ?? "-") + "|" + ("shout" in s) + "|" + Object.keys(s).join("") }
const literalMethod: Speaker = { id: 1, speak(greeting) { return greeting + " method " + this.id } }
const literalArrow: Speaker = { id: 2, speak: greeting => greeting + " arrow", shout: () => "arrow shout" }
attempt("an heir of a literal with the methods", () => { const inherited: Speaker = Object.assign(Object.create({ speak: sharedSpeak, shout(this: Speaker) { return "proto shout " + this.id } }), { id: 11 }); return talk(inherited) })
attempt("an heir of a Speaker", () => talk(Object.create(literalMethod)))
// A proxy does not have the type of its target, and is accepted unchanged.
attempt("a proxy", () => { const proxied: Speaker = new Proxy<Speaker>({ id: 13, speak: sharedSpeak }, {}); return talk(proxied) })
// A method takes for `this` whatever object the call gives it: `this` of a method is not tested.
attempt("a method of an extending class on a literal", () => new LoudSpeaker(5).speak.call(literalArrow, "d"))
attempt("a method of a literal on another literal", () => literalMethod.speak.call(literalArrow, "d"))
attempt("a method of a literal on an object of a class", () => literalMethod.speak.call(new LoudSpeaker(5), "d"))
//// minus-zero-under-literal-types.ts
// -0 has the literal type 0: it enters every location whose type lists 0, and it stays -0 there.
type Digit = 0 | 1 | 2;
type Sign = -1 | 0 | 1;
interface Cell { digit: Digit; sign: Sign; zero: 0 }
class Counter {
  digit: Digit = 0;
  set(value: Digit): Digit { this.digit = value; return this.digit }
}

const describe = (value: number) => (Object.is(value, -0) ? "-0" : String(value)) + " (" + 1 / value + ")";
function pass(value: Digit): Digit { return value }
function roundToDigit(value: number): Digit { return Math.round(value) as Digit }
function signOf(value: number): Sign { return Math.sign(value) as Sign }
function negate(value: 0): 0 { return -value as 0 }
function fromAnywhere(value: unknown): Digit { return value as Digit }

const inputs = [-0.4, -0, 0, 0.4, 1.2, 1.6];
const cell: Cell = { digit: 0, sign: 0, zero: 0 };
const counter = new Counter();
const digits: Digit[] = [];
const byName = new Map<string, Digit>();

let minusZeros = 0;
for (let round = 0; round < 3_000; round++) {
  const input = inputs[round % inputs.length];
  cell.digit = roundToDigit(input);
  cell.sign = signOf(input);
  cell.zero = negate(cell.zero);
  digits[round % 8] = pass(cell.digit);
  byName.set("digit", counter.set(digits[round % 8]));
  for (const value of [cell.digit, cell.sign, cell.zero, digits[round % 8], counter.digit, byName.get("digit")!, fromAnywhere(cell.digit)])
    if (Object.is(value, -0)) minusZeros++;
}
console.log("minus zeros:", minusZeros);

for (const input of inputs) {
  cell.digit = roundToDigit(input);
  cell.sign = signOf(input);
  console.log(input, "|", describe(roundToDigit(input)), "|", describe(signOf(input)), "|", describe(pass(cell.digit)), "|", describe(cell.sign), "|", describe(counter.set(cell.digit)), "|", describe(fromAnywhere(input === 0 ? input : 1)));
}
console.log(describe(negate(0)), describe(negate(negate(0))), JSON.stringify(cell), [cell.digit === 0, cell.sign === 0].join());
switch (roundToDigit(-0.2)) {
  case 0: console.log("case 0"); break;
  default: console.log("default");
}
//// mismatch-messages-by-kind-of-value.ts
// The TypeError message for each kind of value that reaches a parameter of each kind of written type through `any`. An object type tests only that the value is an object: a property of the wrong type is reported by the typed read of that property. An `int32` is a promise that the build proves and has no test when the program runs.
import type { int32 } from "bun";

class Point { x: number; y: number; constructor(x: number, y: number) { this.x = x; this.y = y; } }
interface Labeled { label: string; size: number }
class Circle { kind: string = "circle"; radius: number = 1; }
class Square { kind: string = "square"; side: number = 2; }
class ShapeA { tag: string = "a"; a: number = 1; }
class ShapeB { tag: string = "b"; b: number = 2; }
class ShapeC { tag: string = "c"; c: number = 3; }
class ShapeD { tag: string = "d"; d: number = 4; }
class ShapeE { tag: string = "e"; e: number = 5; }

function takesNumber(value: number): unknown { return value; }
function takesInt32(value: int32): unknown { return value; }
function takesMethod(value: "GET" | "POST"): { method: "GET" | "POST" } { return { method: value }; }
function takesStrings(value: string[]): unknown { return value; }
function takesMap(value: Map<string, number>): unknown { return value; }
function takesPoint(value: Point): unknown { return value == null ? value : value.x + value.y; }
function takesLabeled(value: Labeled): unknown { return value == null ? value : value.label + value.size; }
function takesShape(value: Circle | Square): unknown { return value == null ? value : value.kind; }
function takesCallback(value: () => void): unknown { return value; }
function takesLetter(value: "a" | "b" | "c" | "d" | "e"): unknown { return value; }
function takesWideUnion(value: ShapeA | ShapeB | ShapeC | ShapeD | ShapeE): unknown { return value == null ? value : value.tag; }

function outcome(run: () => unknown): string {
  try { return "no error, " + typeof run(); } catch (error) { return (error as Error).name + ": " + (error as Error).message.replace(/ \(bun compile [^)]*\)/, ""); }
}

const parameters: [string, any][] = [
  ["number", takesNumber], ["int32", takesInt32], ['"GET" | "POST"', takesMethod], ["string[]", takesStrings], ["Map<string, number>", takesMap],
  ["Point", takesPoint], ["Labeled", takesLabeled], ["Circle | Square", takesShape], ["() => void", takesCallback],
];
const Legacy: any = (0, eval)("(class Legacy { constructor() { this.x = 1; this.y = 2; } })");
function greet(): void {}
const values: [string, any][] = [
  ["undefined", undefined], ["true", true], ["1.5", 1.5], ["a string of 60 characters", "abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghij"],
  ["a symbol", Symbol("s")], ["a bigint", 10n], ["an array", ["a"]], ["a Set", new Set([1])],
  ["an object with a missing property", JSON.parse('{"x":1,"label":"tag"}')],
  ["an object with a wrong property", JSON.parse('{"x":"one","y":2,"label":3,"size":4,"kind":5}')],
  ["an instance of an untyped class", new Legacy()], ["a class", Point], ["a named function", greet], ["an anonymous function", function () {}],
];
for (const [type, takes] of parameters) for (const [kind, value] of values) console.log(type + " <- " + kind + ": " + outcome(() => takes(value)));

const tag: Labeled = { label: "tag", size: 1 };
console.log("number <- 7: " + outcome(() => (takesNumber as any)(7)));
console.log("int32 <- 7: " + outcome(() => (takesInt32 as any)(7)));
console.log('"GET" | "POST" <- "POST": ' + outcome(() => (takesMethod as any)("POST")));
console.log("string[] <- an empty array: " + outcome(() => (takesStrings as any)([])));
console.log("Map<string, number> <- a Map: " + outcome(() => (takesMap as any)(new Map([["a", 1]]))));
console.log("Point <- a Point: " + outcome(() => (takesPoint as any)(new Point(1, 2))));
console.log("Labeled <- a Labeled: " + outcome(() => (takesLabeled as any)(tag)));
console.log("Labeled <- an untyped object with all properties: " + outcome(() => (takesLabeled as any)(JSON.parse('{"label":"tag","size":1}'))));
console.log("Circle | Square <- a Circle: " + outcome(() => (takesShape as any)(new Circle())));
console.log("Circle | Square <- a Square: " + outcome(() => (takesShape as any)(new Square())));
console.log("() => void <- an arrow function: " + outcome(() => (takesCallback as any)(() => {})));

console.log("five literals <- 1.5: " + outcome(() => (takesLetter as any)(1.5)).replace(/"[a-e]"/g, '"x"'));
console.log('five literals <- "c": ' + outcome(() => (takesLetter as any)("c")));
console.log("five classes <- 1.5: " + outcome(() => (takesWideUnion as any)(1.5)).replace(/Shape[A-E]/g, "Shape"));
for (const shape of [new ShapeA(), new ShapeB(), new ShapeC(), new ShapeD(), new ShapeE()]) console.log("five classes <- " + shape.tag + ": " + outcome(() => (takesWideUnion as any)(shape)));
//// mismatch-names-written-class.ts
// An abstract class and the only subclass of it that is ever created have the same instances, so both types are tested the same way. The TypeError still names the type written at the parameter that failed.
abstract class Vehicle { wheels: number = 4; }
class Car extends Vehicle { doors: number = 2; }

function takesVehicle(value: Vehicle): unknown { return value == null ? value : value.wheels; }
function takesCar(value: Car): unknown { return value == null ? value : value.doors; }
function takesVehicles(value: Vehicle[]): unknown { return value == null ? value : value.length; }
function takesCars(value: Car[]): unknown { return value == null ? value : value.length; }

function outcome(run: () => unknown): string {
  try { return "no error, " + typeof run(); } catch (error) { return (error as Error).name + ": " + (error as Error).message.replace(/ \(bun compile [^)]*\)/, ""); }
}

const parameters: [string, any][] = [["Vehicle", takesVehicle], ["Car", takesCar], ["Vehicle[]", takesVehicles], ["Car[]", takesCars]];
for (const [type, takes] of parameters) {
  console.log(type + " <- 1.5: " + outcome(() => takes(1.5)));
  console.log(type + " <- true: " + outcome(() => takes(true)));
  console.log(type + " <- undefined: " + outcome(() => takes(undefined)));
}
console.log("Vehicle <- a Car: " + outcome(() => (takesVehicle as any)(new Car())));
console.log("Car <- a Car: " + outcome(() => (takesCar as any)(new Car())));
console.log("Vehicle[] <- an array of a Car: " + outcome(() => (takesVehicles as any)([new Car()])));
console.log("Car[] <- an array of a Car: " + outcome(() => (takesCars as any)([new Car()])));
