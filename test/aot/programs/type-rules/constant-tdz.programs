// The second half of an intersection type is added to an object after its creation, by `Object.assign`.
type HasId = { id: number }
type HasLabel = { label: string; note?: string }
function show(o: object): string { return Object.keys(o).join() + " " + JSON.stringify(o) }
function idOf(h: HasId): number { return h.id }
// A cast from any lets the object through as it is, with the property that was added.
const cast: HasLabel = { label: "cast" }
const assignLoosely: (target: object, source: object) => any = Object.assign
try { const grown = assignLoosely(cast, { id: 7 }) as HasLabel & HasId; console.log(grown.id, idOf(grown), grown.label, show(cast), (grown as object) === cast); console.log("cast from any: no error") } catch (e) { console.log("cast from any:", e instanceof TypeError ? "TypeError" : "other " + e) }
function labelOf(h: HasLabel): string { return h.label }
class Base { base = 1; hello() { return "base " + this.base } }
try { const mixed: Base & HasLabel = Object.assign(new Base(), { label: "mixed" }); console.log(labelOf(mixed)); console.log("an instance with the other half beside it, seen as that half: no error") } catch (e) { console.log("an instance with the other half beside it, seen as that half:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { const mixed = assignLoosely(new Base(), { label: "mixed" }) as Base & HasLabel; console.log(labelOf(mixed)); console.log("the same, cast from any: no error") } catch (e) { console.log("the same, cast from any:", e instanceof TypeError ? "TypeError" : "other " + e) }
//// javascript-file-types/checked.ts
export function half(n: number) { return n / 2; }
export class Meter {
  level: number = 0;
  raise(by: number) { this.level += by; return this.level; }
}
export function label(p: { name: string }) { return p.name; }
//// javascript-file-types/inferred.js
/** @param {number} n */
export function half(n) { return n / 2; }
export class Meter {
  /** @type {number} */
  level = 0;
  /** @param {number} by */
  raise(by) { this.level += by; return this.level; }
}
/** @param {{ name: string }} p */
export function label(p) { return p.name; }
/** @param {(n: any) => unknown} f */
export function callWithText(f) { return f("8"); }
//// javascript-file-types/main.ts
// The same functions and class, written in a `.ts` file with annotations and in a `.js` file with JSDoc types. Only the `.ts` file's types are tested, whoever calls.
import * as checked from "./checked";
import * as inferred from "./inferred.js";

const eight: any = "8";
const seven: any = 7;
const numbered: any = { name: 5 };
////= attempt-2

attempt("a parameter, .ts", () => checked.half(eight));
attempt("a parameter, .js", () => inferred.half(eight));
attempt("a parameter of a method, .ts", () => new checked.Meter().raise(eight));
attempt("a parameter of a method, .js", () => new inferred.Meter().raise(eight));
attempt("an object type given a number, .ts", () => checked.label(seven));
attempt("an object type given a number, .js", () => inferred.label(seven));
attempt("a field of another kind, .ts", () => checked.label(numbered));
attempt("a field of another kind, .js", () => inferred.label(numbered));
attempt("the .js file calls the .ts function", () => inferred.callWithText(checked.half));
attempt("the .js file calls the .js function", () => inferred.callWithText(inferred.half));
