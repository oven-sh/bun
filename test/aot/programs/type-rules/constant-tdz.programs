  later().then(v => v + 1),
  later().then(v => { let n = 0; n += v; return n; }),
  later().then(async v => v + 1),
  (async () => (await later()) + 1)(),
]).then(all => all.map(v => typeof v + " " + String(v)), e => ["throws " + (e as Error).constructor.name]);
