//// hidden-errors-of-null-checks-leave-undefined-in-a-number.ts
// `@ts-ignore` hides the three errors that `strictNullChecks` only reports. The declared `number` holds `undefined` at run time, as in plain Bun.
function half(n: number): number {
  // @ts-ignore
  if (n < 0) return;
  return n / 2;
}
class Point {
  // @ts-ignore
  x: number;
}
class Early {
  y: number;
  seen: string;
  constructor() {
    // @ts-ignore
    this.seen = typeof this.y + " " + (this.y + 1);
    this.y = 1;
  }
}
function describe(n: number): string {
  return `${typeof n} ${n} ${n + 1} ${n | 0} ${n * 2 > 1}`;
}
console.log(describe(half(4)), "|", describe(half(-4)));
console.log(describe(new Point().x));
const early = new Early();
console.log(early.seen, "|", describe(early.y));
let total = 0;
for (let i = -3; i < 4; i++) total += half(i) | 0;
console.log(total);
//// homomorphic-mapped-type-of-primitive.ts
// `Readonly<string>` is `string`: a mapped type over `keyof T` applied to a primitive type is that primitive type. So a generic function's
// `Readonly<T>`, `Partial<T>` or `{ [K in keyof T]: .. }` holds primitives whenever T can be one.
declare const console: { log(...a: unknown[]): void };
class Point { constructor(public x: number, public y: number) {} norm() { return this.x + this.y; } }
interface Named { name: string }
type Same<T> = { [K in keyof T]: T[K] };
type Mutable<T> = { -readonly [K in keyof T]: T[K] };
type Boxes<T> = { [K in keyof T]: { value: T[K] } };
const show = (v: unknown): string => typeof v === "function" ? "function" : typeof v === "symbol" ? "symbol" : typeof v === "bigint" ? v + "n" : v instanceof Point ? "Point " + v.norm() : JSON.stringify(v) ?? "undefined";

function parameter<T>(first: T, value: Readonly<T>): unknown { return value; }
function orNull<T>(first: T, value: Readonly<T> | null): unknown { return value; }
function optional<T>(first: T, value?: Partial<T>): unknown { return value; }
function orArray<T>(first: T, value: Required<T> | symbol[]): unknown { return value; }
function inArray<T>(first: T, values: Same<T>[]): unknown { return values[0]; }
function inField<T>(first: T, holder: { held: Mutable<T> }): unknown { return holder.held; }
function returned<T>(first: T, value: unknown): Readonly<T> { return value as Readonly<T>; }
function local<T>(first: T, value: Readonly<T>): unknown { let kept: Readonly<T> | undefined; kept = value; const list: Readonly<T>[] = []; list.push(kept); return list[0]; }
function callback<T>(first: T, make: () => Boxes<T>): unknown { const made: Boxes<T> = make(); return made; }
function nested<T>(first: T, value: Readonly<Partial<T>>): unknown { return value; }
function constrained<T extends string | number | Named>(first: T, value: Readonly<T>): unknown { return value; }
function indexed<T, K extends keyof T>(first: T, key: K, value: Readonly<T[K]>): unknown { return value; }
function kind<T>(first: T, value: Readonly<T>): string { return typeof value; }
function objectsOnly<T extends Named>(first: T, value: Readonly<T>): string { return value.name; }
class Holder<T> { held: Readonly<T>; constructor(first: T, held: Readonly<T>) { this.held = held; } get(): Readonly<T> { return this.held; } }

const text = "s" as string, count = 1 as number, flag = true as boolean, big = 1n as bigint, unique = Symbol.iterator as symbol;
console.log(show(parameter(text, "t")), show(parameter(count, 2)), show(parameter(flag, false)), show(parameter(big, 2n)), show(parameter(unique, Symbol.iterator)), show(parameter(null, null)), show(parameter(undefined, undefined)));
console.log(show(parameter(() => 1, () => 2)), show(parameter(new Point(1, 2), new Point(3, 4))), show(parameter([1], [2])), show(parameter({ a: 1 }, { a: 2 })), show(parameter(text as string | Point, "t")), show(parameter(text as string | Point, new Point(5, 6))));
console.log(show(orNull(text, "t")), show(orNull(count, null)), show(optional(text, "t")), show(optional(count)), show(optional({ a: 1 }, {})), show(orArray(text, "t")), show(orArray(count, 2)), show(orArray(count, [])));
console.log(show(inArray(text, ["t"])), show(inArray(count, [2])), show(inField(text, { held: "t" })), show(inField(count, { held: 2 })), show(returned(text, "t")), show(returned(count, 2)), show(local(text, "t")), show(local(count, 2)));
console.log(show(callback(text, () => "t")), show(callback(count, () => 2)), show(callback({ a: 1 }, () => ({ a: { value: 2 } }))), show(nested(text, "t")), show(nested({ a: 1 }, {})), show(constrained(text, "t")), show(constrained(count, 2)), show(constrained({ name: "n" }, { name: "m" })));
console.log(show(indexed({ a: count, b: text }, "a", 2)), show(indexed({ a: count, b: text }, "b", "t")), show(indexed({ a: { c: 1 } }, "a", { c: 2 })), kind(text, "t"), kind(count, 2), kind({ a: 1 }, { a: 2 }), objectsOnly({ name: "n" }, { name: "m" }));
console.log(show(new Holder(text, "t").get()), show(new Holder(count, 2).get()), show(new Holder(new Point(1, 2), new Point(7, 8)).get()));
//// index-getter-side-effects.ts
// A typed read of an array element that is an accessor runs the getter, whatever the representation of the index and the element type. Each getter here changes something the reading function read just before and reads again just after: a stale second value means a load was reused across the element read. The last getter is inherited through a hole. Array.prototype is locked (type-rules/builtin-mutation-forms), so the array gets a prototype of its own.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name + ": " + e.message.split("\n")[0].split(" (bun compile")[0] : String(e))) } }
function hide(v: unknown): any { return v }
interface Box { x: number; list: number[] }
function fieldAcross(a: unknown[], o: Box, i: number): string { const before = o.x; const v = a[i]; const after = o.x; return before + " " + String(v) + " " + after }
function lengthAcross(a: unknown[], o: Box, i: number): string { const before = o.list.length; const v = a[i]; const after = o.list.length; return before + " " + String(v) + " " + after }
function ownLengthAcross(a: unknown[], i: number): string { const before = a.length; const v = a[i]; const after = a.length; return before + " " + String(v) + " " + after }
function elementAcross(a: unknown[], o: Box, i: number): string { const before = o.list[0]; const v = a[i]; const after = o.list[0]; return before + " " + String(v) + " " + after }
function ownElementAcross(a: unknown[], i: number): string { const before = a[0]; const v = a[i]; const after = a[0]; return String(before) + " " + String(v) + " " + String(after) }
function anyAcross(a: any[], o: Box, i: number): string { const before = o.x; const v = a[i]; const after = o.x; return before + " " + String(v) + " " + after }
function mixedOwnLength(a: (number | string)[], i: number): string { const before = a.length; const v = a[i]; const after = a.length; return before + " " + String(v) + " " + after }
function mixedOwnLengthAtInteger(a: (number | string)[], n: number): string { const i = n | 0; const before = a.length; const v = a[i]; const after = a.length; return before + " " + String(v) + " " + after }
function numbersOwnLength(a: number[], i: number): string { const before = a.length; const v = a[i]; const after = a.length; return before + " " + String(v) + " " + after }
function unknownOwnLengthAtInteger(a: unknown[], n: number): string { const i = n | 0; const before = a.length; const v = a[i]; const after = a.length; return before + " " + String(v) + " " + after }
function calls(a: unknown[], i: number): unknown { return a[i] }
function lengthAcrossCall(a: unknown[], i: number): string { const before = a.length; const v = calls(a, i); const after = a.length; return before + " " + String(v) + " " + after }
const F: { mixedOwnLength: typeof mixedOwnLength; mixedOwnLengthAtInteger: typeof mixedOwnLengthAtInteger; numbersOwnLength: typeof numbersOwnLength; unknownOwnLengthAtInteger: typeof unknownOwnLengthAtInteger; lengthAcrossCall: typeof lengthAcrossCall; fieldAcross: typeof fieldAcross; lengthAcross: typeof lengthAcross; ownLengthAcross: typeof ownLengthAcross; elementAcross: typeof elementAcross; ownElementAcross: typeof ownElementAcross; anyAcross: typeof anyAcross } = hide({ mixedOwnLength, mixedOwnLengthAtInteger, numbersOwnLength, unknownOwnLengthAtInteger, lengthAcrossCall, fieldAcross, lengthAcross, ownLengthAcross, elementAcross, ownElementAcross, anyAcross });
function box(): Box { return { x: 1, list: [10, 20] } }
function withGetter(run: () => unknown): unknown[] { const a: unknown[] = [1.5, 2.5, 3.5]; Object.defineProperty(a, 1, { get: run, configurable: true, enumerable: true }); return a }
for (let turn = 0; turn < 3; turn++) {
  row(turn + " plain arrays: a field", () => F.fieldAcross([1.5, 2.5, 3.5], box(), 1));
  row(turn + " a getter that stores a field", () => { const o = box(); return F.fieldAcross(withGetter(() => { o.x = 2; return "got" }), o, 1) });
  row(turn + " a getter that pushes onto another array", () => { const o = box(); return F.lengthAcross(withGetter(() => { o.list.push(30); return "got" }), o, 1) });
  row(turn + " a getter that pushes onto the array itself", () => { const a: unknown[] = withGetter(() => { a.push(9); return "got" }); return F.ownLengthAcross(a, 1) });
  row(turn + " a getter that stores an element of another array", () => { const o = box(); return F.elementAcross(withGetter(() => { o.list[0] = 11; return "got" }), o, 1) });
  row(turn + " a getter that stores an element of the array itself", () => { const a: unknown[] = withGetter(() => { a[0] = "changed"; return "got" }); return F.ownElementAcross(a, 1) });
  row(turn + " (number | string)[], a number for the index: pushes onto itself", () => { const a: any[] = withGetter(() => { a.push(9); return "got" }); return F.mixedOwnLength(a, 1) });
  row(turn + " (number | string)[], an integer for the index: pushes onto itself", () => { const a: any[] = withGetter(() => { a.push(9); return "got" }); return F.mixedOwnLengthAtInteger(a, 1) });
  row(turn + " number[], a number for the index: pushes onto itself", () => { const a: any[] = withGetter(() => { a.push(9); return 7 }); return F.numbersOwnLength(a, 1) });
  row(turn + " unknown[], an integer for the index: pushes onto itself", () => { const a: unknown[] = withGetter(() => { a.push(9); return "got" }); return F.unknownOwnLengthAtInteger(a, 1) });
  row(turn + " unknown[], the read is in a function that is called: pushes onto itself", () => { const a: unknown[] = withGetter(() => { a.push(9); return "got" }); return F.lengthAcrossCall(a, 1) });
  row(turn + " any[]: a getter that stores a field", () => { const o = box(); return F.anyAcross(withGetter(() => { o.x = 2; return "got" }), o, 1) });
  row(turn + " a getter on the array's own prototype behind a hole", () => { const o = box(); const a: unknown[] = [1.5, , 3.5]; const parent = Object.create(Array.prototype); Object.defineProperty(parent, 1, { get() { o.x = 2; return "inherited" } }); Object.setPrototypeOf(a, parent); return F.fieldAcross(a, o, 1) });
}
//// inferred-beside-written-types.ts
// A type that the checker only inferred tests nothing. Below each case stands the same code with the type written, and that one throws.
const text: any = "text";
////= attempt-2
class Inferred { level = 0; }
class Written { level: number = 0; }
function inferredResult() { let n = 0; n = text; return n; }
function writtenResult(): number { let n = 0; n = text; return n; }
function inferredDefault(n = 0) { return typeof n; }
function writtenDefault(n: number = 0) { return typeof n; }
const callWithText = (f: (n: number) => string): string => (f as any)(text);

attempt("a variable typed by its initializer", () => { let n = 0; n = text; return typeof n; });
attempt("a variable, written", () => { let n: number = 0; n = text; return typeof n; });
attempt("a class field typed by its initializer", () => { const m = new Inferred(); m.level = text; return typeof m.level; });
attempt("a class field, written", () => { const m = new Written(); m.level = text; return typeof m.level; });
attempt("a property of a literal", () => { const o = { n: 0 }; o.n = text; return typeof o.n; });
attempt("a property of a literal, written", () => { const o: { n: number } = { n: 0 }; o.n = text; return typeof o.n; });
attempt("an element of a literal", () => { const list = [1, 2]; list[0] = text; return typeof list[0]; });
attempt("an element of a literal, written", () => { const list: number[] = [1, 2]; list[0] = text; return typeof list[0]; });
attempt("a result", () => typeof inferredResult());
attempt("a result, written", () => typeof writtenResult());
attempt("a parameter typed by its default", () => inferredDefault(text));
attempt("a parameter with a default, written", () => writtenDefault(text));
attempt("a callback parameter typed by its context", () => callWithText(n => typeof n));
attempt("a callback parameter, written", () => callWithText((n: number) => typeof n));
//// inferred-containers-external-data.ts
// An array whose element type is only inferred may end up holding external data that does not match the inferred type.
// Reading such an element and using it must behave as in plain JavaScript instead of asserting the inferred type.
const data = JSON.parse('{"t":"abc","u":"d","l":["x","y"]}') as { t: number; u: number; l: number[] };
const say = (label: string, f: () => unknown): void => { let r: string; try { const v = f(); r = typeof v + " " + (typeof v === "object" ? JSON.stringify(v) : String(v)); } catch (e) { r = "throws " + (e as Error).constructor.name; } console.log(label + " ==> " + r); };
say("array literal", () => { const c = [data.t]; return c[0] + 1; });
say("array literal, used directly", () => [data.t][0] + 1);
say("array literal, second element", () => { const c = [1, data.t]; return c[0] + c[1]; });
say("array literal of a sum", () => { const c = [data.t + 1]; return c[0] + 1; });
say("spread", () => { const c = [...data.l]; return c[0] + 1; });
say("spread after a number", () => { const c = [1, ...data.l]; return c[1] + 1; });
say("nested literal", () => { const c = [[data.t]]; return c[0][0] + 1; });
say("array in an object literal", () => { const c = { l: [data.t] }; return c.l[0] + 1; });
say("push", () => { const c = [1]; c.push(data.t); return c[1] + 1; });
say("push onto an empty array", () => { const c = []; c.push(data.t); return c[0] + 1; });
say("unshift", () => { const c = [1]; c.unshift(data.t); return c[0] + 1; });
say("splice", () => { const c = [1]; c.splice(0, 0, data.t); return c[0] + 1; });
say("fill", () => { const c = [1, 2]; c.fill(data.t); return c[0] + 1; });
say("element assignment", () => { const c = [1]; c[1] = data.t; return c[1] + 1; });
say("compound element assignment", () => { const c = [1]; c[0] += data.t; return c[0] + 1; });
say("push of a spread", () => { const c = [1]; c.push(...data.l); return c[1] + 1; });
say("let reassigned", () => { let c = [1]; c = [data.t]; return c[0] + 1; });
say("copied to a local", () => { const c = [data.t]; const v = c[0]; return v + 1; });
say("for-of", () => { const c = [data.t]; let s = ""; for (const v of c) s += v + 1; return s; });
say("destructured", () => { const [v] = [data.t]; return v + 1; });
say("map", () => { const c = [data.t]; return c.map(v => v + 1); });
say("reduce", () => { const c = [1]; c.push(data.t); return c.reduce((a, v) => a + v, 0); });
say("pop", () => { const c = [1]; c.push(data.t); return c.pop()! + 1; });
say("at", () => { const c = [data.t]; return c.at(0)! + 1; });
say("returned from a function", () => { const f = () => [data.t]; return f()[0] + 1; });
say("trusted array stays exact", () => { const c = [1, 2]; c.push(3); return c[0] + c[2]; });
say("trusted Map stays exact", () => { const m = new Map([[1, 2]]); m.set(2, 3); return m.get(2)! + 1; });
//// inferred-fields-external-data.ts
// A class field or object-literal property whose type is only inferred may be assigned external data that does not match the inferred type.
// The assignment and later uses must behave as in plain JavaScript instead of asserting the inferred type.
const data = JSON.parse('{"t":"abc","u":"d"}') as { t: number; u: number };
const say = (label: string, f: () => unknown): void => { let r: string; try { const v = f(); r = typeof v + " " + (typeof v === "object" ? JSON.stringify(v) : String(v)); } catch (e) { r = "throws " + (e as Error).constructor.name; } console.log(label + " ==> " + r); };
class Initialized { v = data.t; }
class AssignedInConstructor { v = 0; constructor() { this.v = data.t; } }
class AssignedLater { v = 0; }
class AssignedInMethod { v = 0; load() { this.v = data.t; return this; } }
class Compound { v = 0; add() { this.v += data.t; return this; } }
class Static { static v = data.t; static w = 0; }
class Base { v = 0; }
class Derived extends Base { load() { this.v = data.t; return this; } }
class ParameterProperty { constructor(public v = data.t) {} }
class Trusted { v = 0; bump() { this.v += 1; return this; } }
class Written { v: number = 0; }
say("field initializer", () => new Initialized().v + 1);
say("field assigned in the constructor", () => new AssignedInConstructor().v + 1);
say("field assigned from outside", () => { const c = new AssignedLater(); c.v = data.t; return c.v + 1; });
say("field assigned in a method", () => new AssignedInMethod().load().v + 1);
say("field, compound assignment", () => new Compound().add().v + 1);
say("static field initializer", () => Static.v + 1);
say("static field assigned", () => { Static.w = data.t; return Static.w + 1; });
say("inherited field assigned in a subclass", () => new Derived().load().v + 1);
say("inherited field read through the base class", () => { const b: Base = new Derived().load(); return b.v + 1; });
say("parameter property default", () => new ParameterProperty().v + 1);
say("literal property assigned", () => { const o = { v: 0 }; o.v = data.t; return o.v + 1; });
say("literal property, compound assignment", () => { const o = { v: 0 }; o.v += data.t; return o.v + 1; });
say("literal property assigned in a helper", () => { const o = { v: 0 }; const set = (x: typeof o) => { x.v = data.t; }; set(o); return o.v + 1; });
say("nested literal property assigned", () => { const o = { inner: { v: 0 } }; o.inner.v = data.t; return o.inner.v + 1; });
say("literal returned by a function", () => { const make = () => ({ v: 0 }); const o = make(); o.v = data.t; return o.v + 1; });
say("literals in an array", () => { const l = [{ v: 0 }]; l[0].v = data.t; return l[0].v + 1; });
say("string property", () => { const o = { s: "" }; o.s = data.t as unknown as string; return o.s + 1; });
say("JSON of the object", () => { const o = { v: 0, w: 1 }; o.v = data.t; return o; });
say("keys stay in order", () => { const o = { a: 0, v: 0, z: 0 }; o.v = data.t; return Object.keys(o).join(); });
say("trusted field stays exact", () => new Trusted().bump().v + 1);
say("trusted literal stays exact", () => { const o = { v: 0 }; o.v = 2; return o.v + 1; });
//// inferred-map-and-set-external-data.ts
// A Map or Set whose key or value type is only inferred may end up holding external data that does not match the inferred type.
// Adding it and reading it back must behave as in plain JavaScript instead of asserting the inferred type. The container itself stays a Map or Set.
const data = JSON.parse('{"t":"abc","u":"d","l":["x","y"]}') as { t: number; u: number; l: number[] };
const say = (label: string, f: () => unknown): void => { let r: string; try { const v = f(); r = typeof v + " " + (typeof v === "object" ? JSON.stringify(v) : String(v)); } catch (e) { r = "throws " + (e as Error).constructor.name; } console.log(label + " ==> " + r); };
say("Map.set", () => { const m = new Map([[1, 2]]); m.set(2, data.t); return m.get(2)! + 1; });
say("Map constructor", () => { const m = new Map([[1, data.t]]); return m.get(1)! + 1; });
say("Map key", () => { const m = new Map([[1, 2]]); m.set(data.t, 3); return [...m.keys()].map(k => k + 1); });
say("Map values", () => { const m = new Map([[1, 2]]); m.set(2, data.t); let s = ""; for (const v of m.values()) s += v + 1; return s; });
say("Map forEach", () => { const m = new Map([[1, data.t]]); let s = ""; m.forEach(v => { s += v + 1; }); return s; });
say("Set.add", () => { const s = new Set([1]); s.add(data.t); return [...s].map(v => v + 1); });
say("Set constructor", () => { const s = new Set([data.t]); let r = ""; for (const v of s) r += v + 1; return r; });
say("a variable assigned from Map.get", () => { const m = new Map([[1, 2]]); m.set(2, data.t); let n = 0; n = m.get(2)!; return n + 1; });
say("a variable that adds up Map values", () => { const m = new Map([[1, 2]]); m.set(2, data.t); let n = 0; for (const v of m.values()) n += v; return n; });
say("entries destructured", () => { const m = new Map([[1, 2]]); m.set(2, data.t); let r = ""; for (const [k, v] of m) r += k + v + 1; return r; });
say("size, has and delete stay exact", () => { const m = new Map([[1, 2]]); m.set(2, data.t); return [m.size, m.has(2), m.delete(2), m.size].join(); });
say("WeakMap.set", () => { const key = {}; const w = new WeakMap([[key, 1]]); w.set(key, data.t); return w.get(key)! + 1; });
say("the iterator taken by hand", () => { const s = new Set([1]); s.add(data.t); let last = 0; const it = s[Symbol.iterator](); for (let step = it.next(); !step.done; step = it.next()) last = step.value; return last + 1; });
//// inferred-return-type-external-data.ts
// A function whose return type is inferred may return external data that does not match the inferred type.
// Using the call as an operand must behave as in plain JavaScript instead of asserting the inferred type.
const data = JSON.parse('{"t":"abc","u":"d","l":["x","y"]}') as { t: number; u: number; l: number[] };
const say = (label: string, f: () => unknown): void => { let r: string; try { const v = f(); r = typeof v + " " + String(v); } catch (e) { r = "throws " + (e as Error).constructor.name; } console.log(label + " ==> " + r); };
const arrow = () => data.t;
function declared() { return data.t; }
function conditional(c: boolean) { return c ? data.t : 1; }
function viaLocal() { const v = data.t; return v; }
function nested() { return arrow(); }
function element(i: number) { return data.l[i]; }
function sum() { return data.t + data.u; }
const holder = { method() { return data.t; } };
class Reader { read() { return data.t; } static read() { return data.u; } }
async function later() { return data.t; }
const identity = <T,>(x: T) => x;
say("arrow() + 1", () => arrow() + 1);
say("1 + arrow()", () => 1 + arrow());
say("declared() + 1", () => declared() + 1);
say("conditional(true) + 1", () => conditional(true) + 1);
say("conditional(false) + 1", () => conditional(false) + 1);
say("viaLocal() + 1", () => viaLocal() + 1);
say("nested() + 1", () => nested() + 1);
say("element(0) + 1", () => element(0) + 1);
say("sum() + 1", () => sum() + 1);
say("arrow() + declared()", () => arrow() + declared());
say("arrow() * 2", () => arrow() * 2);
say("-arrow()", () => -arrow());
say("holder.method() + 1", () => holder.method() + 1);
say("new Reader().read() + 1", () => new Reader().read() + 1);
say("Reader.read() + 1", () => Reader.read() + 1);
say("identity(data.t) + 1", () => identity(data.t) + 1);
say("(() => data.t)() + 1", () => (() => data.t)() + 1);
(async () => { let w: unknown; try { w = (await later()) + 1; } catch (e) { w = "throws " + (e as Error).constructor.name; } say("(await later()) + 1", () => w); })();
//// inferred-type-not-enforced-on-external-data.ts
// `JSON.parse(text) as Rec` passes any object, and a field that holds another kind than `Rec` writes throws a TypeError at its first typed read: a read through the value of the cast, in the function where the cast stands, wherever the result would go. A type that the checker has only inferred decides nothing: a closure that captures the unannotated `r`, a default of a parameter, a class field and a spread copy read what is there, and the places they fill hold whatever the language makes of it.
type Rec = { a: number; b: string };
const one = (x: unknown): string => x === undefined ? "<undefined>" : x === null ? "<null>" : typeof x === "number" ? (x !== x ? "<NaN>" : String(x)) + ":number" : typeof x === "string" ? JSON.stringify(x) : typeof x === "object" ? JSON.stringify(x) : String(x);
const say = (label: string, f: () => unknown): void => { let r: string; try { r = one(f()); } catch (e) { r = "throws " + (e as Error).constructor.name; } console.log(label + " ==> " + r); };
const text = '{"a":"1","b":"x"}';
say("read", () => { const r = JSON.parse(text) as Rec; return r.a; });
say("a const", () => { const r = JSON.parse(text) as Rec; const v = r.a; return v; });
say("a let", () => { const r = JSON.parse(text) as Rec; let v = r.a; return v; });
say("a let stored to later", () => { const r = JSON.parse(text) as Rec; let v = 0; v = r.a; return v; });
say("a sum", () => { const r = JSON.parse(text) as Rec; return r.a + 1; });
say("a sum in a const", () => { const r = JSON.parse(text) as Rec; const v = r.a + 1; return v; });
say("s += in a let that begins at 0", () => { const r = JSON.parse(text) as Rec; let s = 0; s += r.a; return s; });
say("s = s + in a let that begins at 0", () => { const r = JSON.parse(text) as Rec; let s = 0; s = s + r.a; return s; });
say("s += in a loop", () => { const r = JSON.parse(text) as Rec; let s = 0; for (let i = 0; i < 3; i++) s += r.a; return s; });
say("s -= (a number whatever comes)", () => { const r = JSON.parse(text) as Rec; let s = 0; s -= r.a; return s; });
say("a pattern", () => { const { a } = JSON.parse(text) as Rec; return a; });
say("a pattern, then a sum", () => { const { a } = JSON.parse(text) as Rec; return a + 1; });
say("a literal's field", () => { const r = JSON.parse(text) as Rec; const o = { v: r.a }; return o.v; });
say("a literal's field, listed", () => { const r = JSON.parse(text) as Rec; const o = { v: r.a }; return JSON.stringify(o); });
say("an array literal", () => { const r = JSON.parse(text) as Rec; const l = [r.a]; return l[0]; });
say("an array literal beside a number", () => { const r = JSON.parse(text) as Rec; const l = [1, r.a]; return l[1]; });
say("pushed on an inferred number[]", () => { const r = JSON.parse(text) as Rec; const l = [1]; l.push(r.a); return l[1]; });
say("the result of an arrow without a written type", () => { const r = JSON.parse(text) as Rec; const f = () => r.a; return f(); });
say("the result of a function without a written type", () => { const r = JSON.parse(text) as Rec; function f() { return r.a; } return f(); });
say("an argument of a generic function", () => { const r = JSON.parse(text) as Rec; const same = <T,>(x: T): T => x; return same(r.a); });
say("a default of a parameter", () => { const r = JSON.parse(text) as Rec; const f = (x = r.a) => x; return f(); });
say("a conditional", () => { const r = JSON.parse(text) as Rec; const v = r.b ? r.a : 0; return v; });
say("??", () => { const r = JSON.parse(text) as Rec; const v = r.a ?? 0; return v; });
say("a spread copy", () => { const r = JSON.parse(text) as Rec; const c = { ...r }; return c.a; });
say("a class field without a written type", () => { const r = JSON.parse(text) as Rec; class C { v = r.a; } return new C().v; });
say("a Map's value, inferred", () => { const r = JSON.parse(text) as Rec; const m = new Map([["k", r.a]]); return m.get("k"); });
say("captured and stored by a closure", () => { const r = JSON.parse(text) as Rec; let v = 0; const set = () => { v = r.a; }; set(); return v; });
say("a template", () => { const r = JSON.parse(text) as Rec; return `${r.a}!`; });
say("compared", () => { const r = JSON.parse(text) as Rec; return [r.a === 1, r.a == 1, r.a < 2]; });
say("Math.max", () => { const r = JSON.parse(text) as Rec; return Math.max(r.a, 0); });
say("toFixed", () => { const r = JSON.parse(text) as Rec; return r.a.toFixed(1); });
say("a loop in a function that is called where it is written", () => { const r = JSON.parse(text) as Rec; return (() => { let s = 0; for (let i = 0; i < 3; i++) s += r.a; return s; })(); });
say("s = r.a + s", () => { const r = JSON.parse(text) as Rec; let s = 0; s = r.a + s; return s; });
say("s = s * 1 + r.a", () => { const r = JSON.parse(text) as Rec; let s = 0; s = s * 1 + r.a; return s; });
say("a let stored to in a branch", () => { const r = JSON.parse(text) as Rec; let v = 0; if (r.b) v = r.a; return v; });
say("a var", () => { const r = JSON.parse(text) as Rec; var v = 0; v = r.a; return v; });
say("two lets in a chain", () => { const r = JSON.parse(text) as Rec; let v = 0, w = 0; v = r.a; w = v; return w; });
say("a let of strings given a number", () => { const r = JSON.parse('{"a":1,"b":2}') as Rec; let t = ""; t = r.b; return t; });
say("a let of booleans", () => { const r = JSON.parse('{"ok":"no"}') as { ok: boolean }; let ok = false; ok = r.ok; return ok; });
say("a default that is a sum", () => { const r = JSON.parse(text) as Rec; const f = (x = r.a + 1) => x; return f(); });
say("a counter that stays a number", () => { const r = JSON.parse(text) as Rec; let n = 0; for (let i = 0; i < 3; i++) n += i; return [n, r.a]; });
const later: [string, () => Promise<unknown>][] = [
  ["a function called where it is written, under a written Promise<unknown>", async (): Promise<unknown> => { const r = JSON.parse(text) as Rec; return (() => r.a)(); }],
  ["the same with a sum in a let", async (): Promise<unknown> => { const r = JSON.parse(text) as Rec; return (() => { let s = 0; s += r.a; return s; })(); }],
  ["the same with a loop", async (): Promise<unknown> => { const r = JSON.parse(text) as Rec; return (() => { let s = 0; for (let i = 0; i < 3; i++) s += r.a; return s; })(); }],
];
for (const [label, f] of later) { let r: string; try { r = one(await f()); } catch (e) { r = "throws " + (e as Error).constructor.name; } console.log(label + " ==> " + r); }
//// instances-start-with-all-fields.ts
// An instance has room for all its declared fields from the start, including those of the subclass. What the program sees is as in plain JavaScript: its keys are those of the fields that are defined or stored to so far, in that order, and it has no other property.
class B { s = "s"; constructor() { console.log(Object.keys(this).join(), "x" in this, JSON.stringify(this)); this.hook() } hook() {} }
class D extends B { x = 1; y?: number; z: string | undefined; hook() { this.y = 5; this.z = "hook"; console.log(Object.keys(this).join()) } }
const d = new D()
console.log(Object.keys(d).join(), JSON.stringify(d), d.y, d.z)
class E { a = this.init(); b?: number; c = 2; init() { this.b = 7; this.c = 9; return 1 } }
const e = new E()
console.log(Object.keys(e).join(), JSON.stringify(e), e.b)
//// int32-advice-grouping.ts
// What the message says to write keeps the grouping of the operand it is built from: `kept - (a + b)`, not `kept - a + b`.
import type { int32 } from "bun";

const given: number[] = JSON.parse("[3, 1.5]");
const a: number = given[0];
const b: number = given[1];
let kept: int32 = 0;
kept -= a + b;
console.log(kept);
//// int32-alias-is-number.ts
// What a program calls its types decides nothing: an alias of `number` is `number`, whatever its name.
type int32 = number;
type uint8 = number;
type Count = int32;
interface Box { held: int32; counted: Count; small: uint8 }
class Meter { level: int32 = 0; raise(by: int32): int32 { this.level += by; return this.level; } }
function half(n: int32): int32 { return n / 2; }
function far(n: Count): Count { return n * 4294967296; }
const box: Box = { held: 1.5, counted: 2 ** 40, small: -0.25 };
let kept: int32 = 0.5;
kept += half(3);
const meter = new Meter();
console.log(half(3), half(-1), far(3), 1 / half(-0), half(NaN), half(Infinity));
console.log(box.held, box.counted, box.small, kept, meter.raise(0.1), meter.raise(2 ** 33));
//// int32-assertion-on-target.ts
// `as int32` on a target that is only written is no flow into an `int32`: the build accepts it, nothing is tested there, and the program prints what plain Bun prints.
import type { int32 } from "bun";

const given: number[] = JSON.parse("[1.5, 2.5]");
let kept: int32 = 7;
let n: number = 0;
(n as int32) = 2;
console.log(n, kept);
(n as int32) = given[0];
kept = n | 0;
console.log(n, kept);
((n as int32) as number) = given[1];
console.log(n, kept);
//// int32-beside-number-asks-for-no-proof.ts
// Only who writes `int32` asks the build for the proof. A union that has `number` beside it holds every number, so there is nothing to prove: a variable that a minifier uses for a status and then for a time takes both.
import type { int32 } from "bun";

type Status = int32;
type Milliseconds = number;
const given: number[] = JSON.parse("[1.5, 3]");
function either(first: boolean): number {
  var status: Status | Milliseconds | null = first ? 1 : null;
  status = given[0] + 0 - given[1];
  return status;
}
function counter(): number {
  var tag: Status | number = 2;
  var sum = 0;
  while (tag < 5) sum += given[1] * tag++;
  return sum;
}
function alone(value: Status | null): int32 {
  return value === null ? -1 : value;
}

console.log(either(true), counter(), alone(7), alone(null));
//// int32-cast-unproven.ts
// `value as int32` promises an `int32`, as an annotation does, and converts nothing: the build stops at a cast of a value that it cannot prove to be one. A cast proves nothing either: what it is stored into is reported too. `| 0` converts, in plain Bun as well, and is what the messages ask for. typed-objects/int32-proven-stores has the casts that the build accepts.
import type { int32 } from "bun";

type Lane = int32;
interface Update { lane: Lane }
const loose: any = JSON.parse('[7.9, "12"]');
const numbers: number[] = JSON.parse("[7.9, 5]");
function cast(n: number): number { return n as int32; }
function sum(a: int32, b: int32): number { return (a + b) as int32; }
function update(lane: unknown): Update { return { lane: lane as Lane }; }
function truthy(level: number): string { return (level as int32) ? "yes" : "no"; }
const list: unknown[] = [loose[0] as int32, 1.5 as int32, (numbers[0] as int32) as number];
let count: number = numbers[1];
(count as int32) += 1;
console.log(cast(numbers[0]), sum(1, 2), update(loose[1]).lane, truthy(0.5), list.join(" "), count);
//// int32-checked-at-run-time.ts
// An `int32` is a promise that the build proves, and nothing tests it when the program runs. A value that reaches an `int32` by a way the build does not follow (a call through a function value, a store through an untyped reference, a wider type) goes on as it is, as in plain Bun. type-rules/int32-unproven-stores has the flows that stop the build, and type-rules/int32-members-of-objects-that-came-in-with-a-number the objects that are made with a number, as by a spread.
import type { int32 } from "bun";

class Cursor { line: int32 = 0; }
interface Spot { kind: "spot"; at: int32 }
interface Mark { kind: "mark"; at: number }
const given: number[] = JSON.parse("[3, 1.5, 2147483648]");
function hide(value: unknown): any { return value; }
function half(n: int32): int32 { return n >> 1; }
function lineOf(cursor: Cursor): int32 { return cursor.line; }
function atOf(spot: Spot): int32 { return spot.at; }
function place(target: Spot | Mark, at: number): void { target.at = at; }
function attempt(name: string, f: () => unknown): void {
  try { console.log(name, String(f())); } catch (e) { const message = (e as Error).message, note = message.indexOf(" (bun compile checks types"); console.log(name, (e as Error).name + (note < 0 ? "" : ": " + message.slice(0, note))); }
}

attempt("an untyped call with an int32:", () => hide(half)(given[0]));
attempt("an untyped call with a fraction:", () => hide(half)(given[1]));
attempt("an untyped call with a number out of range:", () => hide(half)(given[2]));
attempt("an untyped call with nothing:", () => hide(half)());
attempt("a callback of map, int32 only:", () => given.slice(0, 1).map(half).join());
attempt("a callback of map:", () => given.map(half).join());
attempt("a bound argument:", () => half.bind(null, given[1])());
attempt("a store through an untyped reference:", () => { const cursor = new Cursor(); hide(cursor).line = given[1]; return hide(cursor).line; });
attempt("a typed read after it:", () => { const cursor = new Cursor(); hide(cursor).line = given[1]; return lineOf(cursor); });
attempt("a typed read after an untyped store of an int32:", () => { const cursor = new Cursor(); hide(cursor).line = given[0]; return lineOf(cursor); });
attempt("a typed read after a store through a wider type:", () => { const spot: Spot = { kind: "spot", at: 1 }; place(spot, given[1]); return atOf(spot); });
attempt("a read through the wider type:", () => { const mark: Mark = { kind: "mark", at: 1 }; place(mark, given[1]); return mark.at; });
//// int32-constants-out-of-range.ts
// A constant that is not an int32 cannot be stored into one: a fraction, a number out of range, -0, NaN.
import type { int32 } from "bun";

const LIMIT = 2147483647;
class Cursor {
  line: int32 = 0.5;
  constructor(public start: int32 = 1e10) {}
}
function take(n: int32): int32 { return n; }
function none(): int32 { return NaN; }
const over: int32 = LIMIT + 1;
const under: int32 = -2147483649;
const zero: int32 = -0;
const point: { x: int32 } = { x: 2 ** 31 };
console.log(new Cursor(), take(4294967296), none(), over, under, zero, point);
//// int32-from-enums-and-literal-types-that-hold-other-numbers.ts
// An enum or a union of literals is an `int32` by proof only if every member is one: not with a fraction, -0 or 2 ** 31 among the members, with members computed when the program runs, or for an enum that is only declared. Arithmetic on an enum value is held to the range of an int32, not to that of the members, because TypeScript lets any number into a numeric enum. structural-types/an-enum-that-holds-any-number-is-taken-for-an-int32 has the enums that are accepted, with other numbers in them.
import type { int32 } from "bun";

const given: number[] = JSON.parse("[1.5]");
function compute(): number { return given[0]; }
enum Color { Red, Green, Blue }
enum Odd { Half = 0.5, One = 1 }
enum Big { Huge = 2147483648, One = 1 }
enum Made { First = compute(), Second = "abc".length, Third = Color.Blue }
enum Minus { Zero = -0, One = 1 }
declare enum Ambient { A, B }
function withAFraction(value: Odd): int32 { return value; }
function withAHugeMember(value: Big): int32 { return value; }
function computed(value: Made): int32 { return value; }
function withNegativeZero(value: Minus): int32 { return value; }
function oneComputedMember(value: Made.First): int32 { return value; }
function theComputedMember(): int32 { return Made.First; }
function theLength(): int32 { return Made.Second; }
function theFraction(): int32 { return Odd.Half; }
function theNegativeZero(): int32 { return Minus.Zero; }
function onlyDeclared(value: Ambient): int32 { return value; }
function negated(color: Color): int32 { return -color; }
function doubled(color: Color): int32 { return color * 2; }
function next(color: Color): int32 { return color + 1; }
function distance(color: Color): int32 { return Math.abs(color); }
function fractionOrTwo(value: 1.5 | 2): int32 { return value; }
const holder: { digit: 0 | 1 | 2 } = { digit: 1 };
const member: int32 = holder.digit;

console.log(withAFraction(1), withAHugeMember(1), computed(given[0]), withNegativeZero(1), oneComputedMember(given[0]), theComputedMember(), theLength(), theFraction(), theNegativeZero(), onlyDeclared(given[0]), negated(1), doubled(1), next(1), distance(1), fractionOrTwo(2), member);
//// int32-functions-used-as-values.ts
// A function with an `int32` parameter can be used as a value: stored, bound, passed as a callback. The build accepts that, although it does not see every call of such a value, and nothing tests the argument when the program runs. Every argument here is an int32, and `boundToFraction` is never called. type-rules/int32-checked-at-run-time has the calls with other numbers.
import type { int32 } from "bun";

function half(n: int32): number { return n / 2; }
const twice = (n: int32): number => n * 2;
class Cursor {
  constructor(public line: int32) {}
}
const table = { half };
const other = twice;
const made = Cursor;
const bound = half.bind(null);
const boundToFraction = half.bind(null, [1.5][0]);
const mapped = [1, 2].map(half);
const inline = [1, 2].map((n: int32) => n + 1);
const methods = { third(n: int32): number { return n / 3; } };
let replaced = (n: int32): number => n;
console.log(table, other, made, bound, boundToFraction, mapped, inline, methods, replaced, half.call(null, 1), half(2), twice(2), new Cursor(1) instanceof Cursor);
console.log(table.half(4), other(3), new made(2).line, bound(6), methods.third(9), replaced(5), half.apply(null, [8]));
//// int32-in-only-one-of-two-types.ts
// An object is used as two types, and a member is an `int32` in only one of them. The build accepts a store, a call and a result through either type: each function is proven by itself, and a number that came in through the type that says `number` goes on as it is, as in plain Bun. A read of a field through the type that says `int32` stops the build once an object that holds a number there is taken for that type: type-rules/an-object-with-a-number-member-is-taken-for-a-type-with-an-int32-member.
import type { int32 } from "bun";

const given: number[] = JSON.parse("[1.5, 3]");
interface Movable {
  line: number;
  column: int32;
  move(by: number): void;
  width(): int32;
}
class Cursor implements Movable {
  line: int32 = 0;
  column: number = 0;
  move(by: int32): void { this.line = by; }
  width(): number { return 1.5; }
}
class Base {
  at: int32 = 0;
  skip(by: int32): int32 { return by; }
}
class Derived extends Base {
  at: number = 0.5;
  skip(by: int32): number { return by / 2; }
}
class Agreeing extends Base {
  at: int32 = 1;
  skip(by: number): int32 { return by | 0; }
}
function setLine(movable: Movable, line: number): number { movable.line = line; return movable.line; }
function lineOf(cursor: Cursor): int32 { return cursor.line; }
function move(movable: Movable, by: number): void { movable.move(by); }
function widthOf(movable: Movable): int32 { return movable.width(); }
function skip(base: Base, by: int32): int32 { return base.skip(by); }
function attempt(name: string, f: () => unknown): void {
  try { console.log(name, String(f())); } catch (e) { const message = (e as Error).message, note = message.indexOf(" (bun compile checks types"); console.log(name, (e as Error).name + (note < 0 ? "" : ": " + message.slice(0, note))); }
}

attempt("a store through the interface, which says number:", () => setLine(new Cursor(), given[0]));
attempt("a read through the class after it:", () => { const cursor = new Cursor(); setLine(cursor, given[0]); return lineOf(cursor); });
attempt("a read through the class after a store of an int32:", () => { const cursor = new Cursor(); setLine(cursor, given[1]); return lineOf(cursor); });
attempt("a call through the interface, which says number:", () => move(new Cursor(), given[0]));
attempt("the same call with an int32:", () => { const cursor = new Cursor(); move(cursor, given[1]); return lineOf(cursor); });
attempt("a result through the interface, which says int32:", () => widthOf(new Cursor()));
attempt("a result that the subclass declares number:", () => skip(new Derived(), 1));
attempt("a subclass that agrees:", () => skip(new Agreeing(), 2));
//// int32-members-of-objects-that-came-in-with-a-number.ts
// A member that is declared `int32` is one by proof only if every object that is taken as that type was made with an int32 there. An object literal, a getter and an instance that hold a `number` are assignable to the type, so a read of the member is no int32 any more. structural-types/int32-members-are-stored-to-through-a-type-that-says-number has the stores that the build does not follow.
import type { int32 } from "bun";

const given: number[] = JSON.parse("[1.5]");
const n: number = given[0];
interface FromALiteral { x: int32 }
interface FromAGetter { x: int32 }
interface FromAnInstance { x: int32 }
interface Optional { y?: int32 }
function ofLiteral(point: FromALiteral): int32 { return point.x; }
function ofGetter(point: FromAGetter): int32 { return point.x; }
function ofInstance(point: FromAnInstance): int32 { return point.x; }
function ofOptional(holder: Optional): int32 { return holder.y ?? -1; }
class Pixel { x: number = n; }
const literal = { x: n };
const getter = { get x(): number { return n; } };
const optional = { y: n };

console.log(ofLiteral(literal), ofGetter(getter), ofInstance(new Pixel()), ofOptional(optional));
//// int32-range-tests-that-a-call-an-alias-or-an-await-could-undo.ts
// `i++` behind `i < limit` is proven only for a local variable that nothing else can store to. A captured variable, a variable of the module, a field, and a test that says too little (`<=` the largest int32, `!==`, a bound that is a `number`, one arm of `||`, a test kept in a constant, a catch clause) prove nothing. typed-objects/int32-range-after-tests has what is proven.
import type { int32 } from "bun";

const MAX: int32 = 2147483647;
function capturedInALoop(to: int32): int32 { let i: int32 = 0; const jump = () => { i = MAX; }; for (; i < to; i++) { if (i === 2) jump(); } return i; }
function capturedWithItsLimit(to: int32): int32 { let i: int32 = 0; let limit: int32 = to; const raise = () => { limit = MAX; i = MAX; }; while (i < limit) { raise(); i++; } return i; }
class Cell {
  n: int32 = 0;
  reset(): void { this.n = MAX; }
  bump(): void { if (this.n < 100) { this.reset(); this.n++; } }
}
function twoNames(a: Cell, b: Cell): int32 { if (a.n < 100) { b.n = MAX; a.n++; } return a.n; }
function aCallBetween(a: Cell, touch: () => void): int32 { if (a.n < 100) { touch(); a.n++; } return a.n; }
function aFieldAlone(a: Cell): int32 { if (a.n < 100) a.n++; return a.n; }
let shared: int32 = 0;
function poke(): void { shared = MAX; }
function moduleVariable(): int32 { if (shared < 100) { poke(); shared++; } return shared; }
function moduleVariableInALoop(): int32 { for (shared = 0; shared < 10; shared++) poke(); return shared; }
async function acrossAnAwait(wait: Promise<void>): Promise<int32> { if (shared < 100) { await wait; shared++; } return shared; }
function* acrossAYield(): Generator<void, int32, void> { if (shared < 100) { yield; shared++; } return shared; }
function inACatch(i: int32): int32 { try { if (i < 100) { throw 1; } } catch { i++; } return i; }
function atMostTheLargest(i: int32): int32 { const limit: int32 = MAX; if (i <= limit) i++; return i; }
function notTheLargest(i: int32): int32 { if (i !== MAX) i++; return i; }
function belowAFraction(i: int32): int32 { if (i < 2147483647.5) i++; return i; }
function belowANumber(i: int32, f: number): int32 { if (i < f) i++; return i; }
