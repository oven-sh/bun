    this.line += by;
    return this.line + by;
  }
}
interface Point {
  x: int32;
  y?: int32;
}

function add(a: int32, b: int32): int32 { return a + b; }
function subtract(a: int32, b: int32): int32 { return a - b; }
function times(a: int32, b: int32): int32 { return a * b; }
