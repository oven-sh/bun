//// nullish-stays-after-cast.ts
// `undefined` or `null` that passed through an `as` cast stays what it is where it enters a variable, a parameter, a result or a field of a primitive type. An object passes the cast too, and the place behind it takes it.
declare const console: { log(...args: unknown[]): void }
function hide(x: unknown): unknown { return x }
function anyOf(x: unknown): any { return x }
function row(name: string, f: () => unknown) { try { console.log(name + ":", String(f())) } catch (e) { console.log(name + ":", e instanceof TypeError ? "TypeError" : "other") } }
function takes(n: number): string { return typeof n + " " + n }
function flag(b: boolean): string { return typeof b + " " + b }
class Holder { size: number = 0 }
row("DECLARED PLACE: unknown undefined, an annotated const", () => { const n: number = hide(undefined) as number; return n })
row("DECLARED PLACE: any undefined, a parameter", () => takes(anyOf(undefined) as number))
row("DECLARED PLACE: any null, a parameter", () => takes(anyOf(null) as number))
row("DECLARED PLACE: a missing property of any, a parameter", () => takes(anyOf({}).count as number))
row("DECLARED PLACE: unknown undefined, a boolean parameter", () => flag(hide(undefined) as boolean))
row("DECLARED PLACE: unknown undefined, a declared result", () => ((x: unknown): number => x as number)(undefined))
row("DECLARED PLACE: unknown undefined, a field", () => { const h = new Holder(); h.size = hide(undefined) as number; return h.size })
row("USE: an object, a parameter", () => takes(hide({}) as number))
row("USE: an object, an annotated const", () => { const n: number = hide([1]) as number; return n })
row("honest, a parameter", () => takes(hide(3) as number))
row("honest, through a local", () => { const n = hide(4) as number; return takes(n) })
row("nil through a local", () => { const n = hide(undefined) as number; return takes(n) })
//// nullish-stores-through-wider-types.ts
// Stores of `undefined` or `null` into a property whose declared type excludes both, made through a wider type of the same object.
// Everything here type-checks, and each store must behave as it does in plain JavaScript.
// Each case declares its own types, told apart by a marker property, so that one case cannot change how another's objects are stored.
function report(label: string, run: () => string): void {
  try {
    console.log(label + ":", run());
  } catch (e) {
    console.log(label + ":", "throws", (e as Error).name);
  }
}

report("index signature, computed key", () => {
  type Leaf = { n: number; case1: true };
  type Holder = { leaf: Leaf; name: string; case1: true };
  const h: Holder = { leaf: { n: 1, case1: true }, name: "holder", case1: true };
  const dictionary: { [key: string]: unknown } = h;
  for (const key of Object.keys(dictionary)) if (key === "leaf") dictionary[key] = undefined;
  return h.leaf === undefined ? "undefined" : h.leaf === null ? "null" : String(h.leaf.n);
});

report("generic key of the type", () => {
  type Leaf = { n: number; case2: true };
  type Holder = { leaf: Leaf; name: string; case2: true };
  function setByKey<K extends keyof Holder>(target: Holder, key: K, value: Holder[K]): void {
    target[key] = value;
  }
  const noLeaves: Leaf[] = [];
  const h: Holder = { leaf: { n: 2, case2: true }, name: "holder", case2: true };
  setByKey(h, "leaf", noLeaves[3]);
  return h.leaf === undefined ? "undefined" : h.leaf === null ? "null" : String(h.leaf.n);
});

report("nested object through a wider outer type", () => {
  type Leaf = { n: number; case3: true };
  type Holder = { leaf: Leaf; name: string; case3: true };
  type Outer = { inner: Holder };
  type WideOuter = { inner: { leaf?: Leaf } };
  const h: Holder = { leaf: { n: 3, case3: true }, name: "holder", case3: true };
  const outer: Outer = { inner: h };
  const wide: WideOuter = outer;
  wide.inner.leaf = undefined;
  return h.leaf === undefined ? "undefined" : h.leaf === null ? "null" : String(h.leaf.n);
});

report("callback whose parameter is any", () => {
  type Leaf = { n: number; case4: true };
  type Holder = { leaf: Leaf; name: string; case4: true };
  const clear: (target: Holder) => void = (target: any) => {
    target.leaf = undefined;
  };
  const h: Holder = { leaf: { n: 4, case4: true }, name: "holder", case4: true };
  clear(h);
  return h.leaf === undefined ? "undefined" : h.leaf === null ? "null" : String(h.leaf.n);
});

report("callback whose parameter is any, computed key", () => {
  type Leaf = { n: number; case5: true };
  type Holder = { leaf: Leaf; name: string; case5: true };
  const clear: (target: Holder, key: string) => void = (target: any, key: string) => {
    target[key] = null;
  };
  const h: Holder = { leaf: { n: 5, case5: true }, name: "holder", case5: true };
  clear(h, "leaf");
  return h.leaf === undefined ? "undefined" : h.leaf === null ? "null" : String(h.leaf.n);
});

report("Reflect.set through object", () => {
  type Leaf = { n: number; case6: true };
  type Holder = { leaf: Leaf; name: string; case6: true };
  function clearLeaf(target: object): void {
    for (const key of Object.keys(target)) if (key === "leaf") Reflect.set(target, key, undefined);
  }
  const h: Holder = { leaf: { n: 6, case6: true }, name: "holder", case6: true };
  clearLeaf(h);
  return h.leaf === undefined ? "undefined" : h.leaf === null ? "null" : String(h.leaf.n);
});

report("Object.assign from a partial", () => {
  type Leaf = { n: number; case7: true };
  type Holder = { leaf: Leaf; name: string; case7: true };
  const h: Holder = { leaf: { n: 7, case7: true }, name: "holder", case7: true };
  const patch: Partial<Holder> = { leaf: undefined };
  Object.assign(h, patch);
  return h.leaf === undefined ? "undefined" : h.leaf === null ? "null" : String(h.leaf.n);
});

report("element of a wider array", () => {
  type Leaf = { n: number; case8: true };
  type Holder = { leaf: Leaf; name: string; case8: true };
  const h: Holder = { leaf: { n: 8, case8: true }, name: "holder", case8: true };
  const holders: Holder[] = [h];
  const wide: { leaf?: Leaf }[] = holders;
  wide[0].leaf = undefined;
  return h.leaf === undefined ? "undefined" : h.leaf === null ? "null" : String(h.leaf.n);
});

report("value of a wider map", () => {
  type Leaf = { n: number; case9: true };
  type Holder = { leaf: Leaf; name: string; case9: true };
  const h: Holder = { leaf: { n: 9, case9: true }, name: "holder", case9: true };
  const holders = new Map<string, Holder>([["a", h]]);
  const wide: Map<string, { leaf?: Leaf }> = holders;
  wide.get("a")!.leaf = undefined;
  return h.leaf === undefined ? "undefined" : h.leaf === null ? "null" : String(h.leaf.n);
});

report("result of a function seen through a wider type", () => {
  type Leaf = { n: number; case10: true };
  type Holder = { leaf: Leaf; name: string; case10: true };
  const h: Holder = { leaf: { n: 10, case10: true }, name: "holder", case10: true };
  const get: () => Holder = () => h;
  const wideGet: () => { leaf?: Leaf } = get;
  wideGet().leaf = undefined;
  return h.leaf === undefined ? "undefined" : h.leaf === null ? "null" : String(h.leaf.n);
});

report("property of a class instance through a wider interface", () => {
  type Leaf = { n: number; case11: true };
  type Holder = { leaf: Leaf; name: string; case11: true };
  class Box {
    constructor(public held: Holder) {}
  }
  interface WideBox {
    held: { leaf?: Leaf };
  }
  const h: Holder = { leaf: { n: 11, case11: true }, name: "holder", case11: true };
  const wide: WideBox = new Box(h);
  wide.held.leaf = undefined;
  return h.leaf === undefined ? "undefined" : h.leaf === null ? "null" : String(h.leaf.n);
});

report("promise of a wider type", () => {
  type Leaf = { n: number; case12: true };
  type Holder = { leaf: Leaf; name: string; case12: true };
  const h: Holder = { leaf: { n: 12, case12: true }, name: "holder", case12: true };
  const wide: Promise<{ leaf?: Leaf }> = Promise.resolve(h);
  wide.then(value => {
    value.leaf = undefined;
    console.log("promise of a wider type, later:", h.leaf === undefined ? "undefined" : "kept");
  });
  return h.leaf === undefined ? "undefined" : h.leaf === null ? "null" : String(h.leaf.n);
});
//// number-parameter-passed-on-in-tail-position.ts
// Number parameters passed on in tail position, called through `any`: a number arrives unboxed, nullish passes the test, any other value throws.
function scale(x: number, y: number) { return x * y; }
function twice(a: number, b: number) { return scale(b, a); }
const untyped: any = twice;
function attempt(a: any, b: any) {
  try {
    console.log(untyped(a, b));
  } catch (error) {
    console.log((error as Error).name);
  }
}
attempt(1, 2);
attempt(1.5, -0);
attempt(2 ** 31, NaN);
attempt("1", 2);
attempt(1, undefined);
attempt({}, 1);
//// number-plus-any-mismatch.ts
// An operator on a number and `any` that gives no number breaks the written type `number` of its result.
function onLeft(n: number, v: any): number {
  const r: number = n + v;
  return r;
}
function onRight(n: number, v: any): number {
  const r: number = v + n;
  return r;
}
function attempt(name: string, f: () => number): void {
  try {
    console.log(name, f());
  } catch (e) {
    console.log(name, e instanceof TypeError ? "TypeError" : "other " + e);
  }
}
attempt("number", () => onLeft(1, 2));
attempt("number on the right", () => onRight(1, 2));
attempt("double", () => onLeft(1, 0.5));
attempt("undefined", () => onLeft(1, undefined));
attempt("null", () => onLeft(1, null));
attempt("object with a number", () => onLeft(1, { valueOf() { console.log("valueOf ran"); return 2; } }));
attempt("string", () => onLeft(1, "2"));
attempt("string on the right", () => onRight(1, "2"));
attempt("object with a string", () => onLeft(1, { valueOf() { console.log("valueOf ran"); return "2"; } }));
attempt("BigInt", () => onLeft(1, 2n));
//// number-plus-equals-any.ts
// `number += any`: the sum has type `any` for TypeScript; if it is not a number, the assignment throws and nothing is stored.
const hide = (v: unknown): any => v
interface R { n: number; s: string; e: number | string }
const r: R = { n: 1, s: "a", e: 1 }
let total: number = 1
const nums: number[] = [1]
try { r.n += hide("x"); console.log("field: no error") } catch (e) { console.log("field:", e instanceof TypeError ? "TypeError" : "other " + e, r.n) }
try { total += hide("x"); console.log("variable: no error") } catch (e) { console.log("variable:", e instanceof TypeError ? "TypeError" : "other " + e, total) }
try { let local: number = 1; local += hide("x"); console.log("local: no error", local) } catch (e) { console.log("local:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { nums[0] += hide("x"); console.log("element: no error") } catch (e) { console.log("element:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { const n: number = nums[0]; console.log("read of the element: no error", n) } catch (e) { console.log("read of the element:", e instanceof TypeError ? "TypeError" : "other " + e) }
r.n += hide(2); total += hide(2); r.s += hide("b"); r.e += hide("x")
console.log("right", r.n, total, r.s, r.e)
// Declared number | string: the store fits. To the checker (tsc too) the variable is still narrowed to `number` by its initializer
// after `+= any`. That narrowing is a prediction, so the read tests nothing.
let wide: number | string = 1
try { wide += hide("s"); console.log("store to number | string: no error") } catch (e) { console.log("store to number | string:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { console.log(wide); console.log("read narrowed to number: no error") } catch (e) { console.log("read narrowed to number:", e instanceof TypeError ? "TypeError" : "other " + e) }
//// numbers-behind-an-assertion.ts
// `x!` tests nothing, and undefined and null pass every place written `number`: operators, built-ins, parameters, results, fields and typed arrays get them as they are.
////= say
let maybe: number | undefined;
let nothing: number | null = null;
const ints = new Int32Array(2);
const floats = new Float64Array(2);
const list: number[] = [1, 2, 3];
const holder: { size: number; count: number } = { size: 1, count: 2 };
class Counter { total = 0; add(n: number): number { this.total += n; return this.total; } }
function plusOne(n: number): number { return n + 1; }
function given(): number { return maybe!; }
function which(n: number): string { switch (n) { case 3: return "three"; case 0: return "zero"; default: return "other"; } }
function loop(limit: number): number { let turns = 0; for (let i = 0; i < limit; i++) turns++; return turns; }

say("remainder", () => maybe! % 2);
say("divided", () => maybe! / 2);
say("to a power", () => maybe! ** 2);
say("unary plus", () => +maybe!);
say("bitwise not", () => ~maybe!);
say("and", () => maybe! & 7);
say("unsigned shift", () => maybe! >>> 0);
say("strictly equal", () => maybe! === 3);
say("loosely equal to null", () => maybe! == null);
say("at least", () => maybe! >= 0);
say("switch, in place", () => { switch (maybe!) { case 3: return "three"; case 0: return "zero"; default: return "other"; } });
say("switch, in a function", () => which(maybe!));
say("Math.max", () => Math.max(maybe!, 1));
say("Math.floor", () => Math.floor(maybe!));
say("Math.abs", () => Math.abs(maybe!));
say("isNaN", () => isNaN(maybe!));
say("Number.isInteger", () => Number.isInteger(maybe!));
say("String", () => String(maybe!));
say("a method of it", () => maybe!.toFixed(1));
say("passed to a parameter, added there", () => plusOne(maybe!));
say("returned, then added", () => given() + 1);
say("added to a field", () => new Counter().add(maybe!));
say("stored to a number field", () => { holder.size = maybe!; return holder.size + 1; });
say("compound store to a field", () => { holder.count += maybe!; return holder.count; });
say("stored to an Int32Array", () => { ints[0] = maybe!; return ints[0]; });
say("stored to a Float64Array", () => { floats[0] = maybe!; return floats[0]; });
say("pushed to a number array", () => { list.push(maybe!); return list[3] + "," + (list[3]! + 1); });
say("as a limit of a loop", () => loop(maybe!));
say("as a length", () => "ab".slice(0, maybe!));
say("as a count", () => "ab".repeat(nothing!));
say("a conditional", () => (maybe! ? 1 : 2) + 1);
say("or a default", () => (maybe! || 7) + 1);
say("nullish default", () => (maybe! ?? 7) + 1);
say("null, remainder", () => nothing! % 2);
say("null, negated", () => -nothing!);
say("null, strictly equal to zero", () => nothing! === 0);
say("null, switch", () => which(nothing!));
maybe = 3;
nothing = 0;
say("set: remainder", () => maybe! % 2);
say("set: switch", () => which(maybe!));
say("set: returned, then added", () => given() + 1);
say("set: null, switch", () => which(nothing!));
//// numbers-computed-from-a-narrowing-that-a-call-undoes.ts
// TypeScript narrows `current` to number at an assignment or a test and does not see that a call resets it. What is computed from it must be what JavaScript computes from undefined.
let current: number | undefined = 3;
function clear(): void { current = undefined; }
function reset(): number { current = 3; clear(); return current; }
function show(label: string, make: () => unknown): void {
  let text: string;
  try { const value = make(); text = typeof value + " " + String(value); } catch (error) { text = "throws " + (error as Error).constructor.name; }
  console.log(label + ": " + text);
}
function plusOne(n: number): number { return n + 1; }
function product(n: number): number { return n * 2; }
function remainder(n: number): number { return n % 2; }
function negated(n: number): number { return -n; }
function inText(n: number): string { return `<${n + 1}>`; }
function element(n: number): number | undefined { return [10, 20, 30][n + 1]; }
function arm(n: number): string { switch (n + 1) { case 0: return "zero"; case 1: return "one"; case 4: return "four"; default: return "other"; } }
function counted(n: number): number { let total = n; total++; total += 2; return total; }
function orZero(n: number): number { return (n + 1) | 0; }
let kept = 4;
show("a let, in place", () => { current = 3; clear(); let moved = 4; moved = current; return moved + 1; });
show("a let, times", () => { current = 3; clear(); let moved = 4; moved = current; return moved * 2; });
show("a let, incremented", () => { current = 3; clear(); let moved = 4; moved = current; moved++; return moved; });
show("a let, added to", () => { current = 3; clear(); let moved = 4; moved = current; moved += 2; return moved; });
show("a let, a sum as an index", () => { current = 3; clear(); let moved = 4; moved = current; return [10, 20, 30][moved + 1]; });
show("a let, a sum of sums", () => { current = 3; clear(); let moved = 4; moved = current; return (moved + 1) + (moved + 2); });
show("a let, in a template", () => { current = 3; clear(); let moved = 4; moved = current; return `${moved + 1}`; });
show("a module variable", () => { current = 3; clear(); kept = current; return kept + 1; });
show("a loop variable", () => { current = 3; clear(); let sum = 0; for (let i = current; sum < 1; sum++) { return i + 1; } return sum; });
show("inside try", () => { current = 3; clear(); let moved = 4; try { moved = current; } finally { kept = 4; } return moved - 1; });
show("a constant, a call", () => { current = 3; clear(); const held = current; return plusOne(held); });
show("a closure, a call", () => { current = 3; clear(); const held = current; return (() => plusOne(held))(); });
show("a conditional, a call", () => { current = 3; clear(); return plusOne(kept > 0 ? current : 5); });
show("after a test", () => { current = 3; if (current !== undefined) { clear(); return current + 1; } return 0; });
show("a result", () => reset() + 1);
show("a call: plus one", () => { current = 3; clear(); return plusOne(current); });
show("a call: product", () => { current = 3; clear(); return product(current); });
show("a call: remainder", () => { current = 3; clear(); return remainder(current); });
show("a call: negated", () => { current = 3; clear(); return negated(current); });
show("a call: in a template", () => { current = 3; clear(); return inText(current); });
show("a call: an element", () => { current = 3; clear(); return element(current); });
show("a call: a switch", () => { current = 3; clear(); return arm(current); });
show("a call: counted", () => { current = 3; clear(); return counted(current); });
show("a call: or zero", () => { current = 3; clear(); return orZero(current); });
show("honest: a let", () => { current = 3; let moved = 4; moved = current; return moved + 1; });
show("honest: a call", () => { current = 3; return plusOne(current) + product(current) + counted(current); });
show("honest: a switch", () => { current = 3; return arm(current) + inText(current) + String(element(current - 3)); });
//// numbers-passed-via-function-value.ts
// A function with parameters of type number that is called through a value: every number arrives as it is, whichever way it is kept, undefined and null pass, and anything else is turned away with a TypeError that names what was expected and what came. The parameter of the arrow function that `makeAdder` returns has no annotation of its own, so it is not tested.
////= lines-9	oneNumber	a	number	number	a	1
function threeNumbers(a: number, b: number, c: number): number {
  return a + b * 2 + c * 4;
}
function fourNumbers(a: number, b: number, c: number, d: number): number {
  return a + b * 2 + c * 4 + d * 8;
}
function fiveNumbers(a: number, b: number, c: number, d: number, e: number): number {
  return a + b * 2 + c * 4 + d * 8 + e * 16;
}
function amongOthers(s: string, a: number, flag: boolean, b: number): string {
  return s + (flag ? a : b);
}
function behindAnObject(point: { x: number }, a: number): number {
  return point.x * a;
}
function calledInPlaceToo(a: number, b: number): number {
  return a / b;
}
function makeAdder(amount: number): (a: number) => number {
  return a => a + amount;
}
class Scale {
  factor = 3;
  apply(a: number): number {
    return a * this.factor;
  }
}
const table: Record<string, Function> = { oneNumber, threeNumbers, fourNumbers, fiveNumbers, amongOthers, behindAnObject, calledInPlaceToo, adder: makeAdder(0.5), apply: Scale.prototype.apply.bind(new Scale()) };
const values: unknown[] = [0, -0, 1, -1, 2147483647, -2147483648, 2147483648, 0.5, NaN, Infinity, 1e300, "1", "", null, undefined, true, false, {}, [], [1], () => 1, 1n, Symbol.iterator, new Number(1)];
const show = (value: unknown) => (Object.is(value, -0) ? "-0" : typeof value === "symbol" || typeof value === "bigint" || typeof value === "function" ? typeof value : typeof value === "object" && value ? value.constructor.name : String(value));
function attempt(name: string, ...given: unknown[]) {
  try {
    console.log(name, given.map(show).join(" "), "->", show(table[name](...given)));
  } catch (error) {
    console.log(name, given.map(show).join(" "), "throws", (error as Error).constructor.name + ":", (error as Error).message.split("\n")[0]);
  }
}
for (const value of values) {
  attempt("oneNumber", value);
  attempt("adder", value);
  attempt("apply", value);
  for (let place = 0; place < 3; place++) attempt("threeNumbers", ...[1, 2, 3].map((other, index) => (index === place ? value : other)));
  for (let place = 0; place < 4; place++) attempt("fourNumbers", ...[1, 2, 3, 4].map((other, index) => (index === place ? value : other)));
  for (let place = 0; place < 5; place++) attempt("fiveNumbers", ...[1, 2, 3, 4, 5].map((other, index) => (index === place ? value : other)));
  attempt("amongOthers", "s", value, true, 2);
  attempt("amongOthers", "s", 1, false, value);
  attempt("behindAnObject", { x: 2 }, value);
  attempt("calledInPlaceToo", value, 2);
  attempt("calledInPlaceToo", 1, value);
}
attempt("oneNumber");
attempt("threeNumbers", 1, 2);
attempt("threeNumbers", 1, 2, 3, "more");
console.log(calledInPlaceToo(1, 4), calledInPlaceToo(6, 3));
function nested(name: string, value: unknown): string {
  try {
    return String(table[name](value));
  } catch (error) {
    return (error as Error).stack!.split("\n").length > 1 ? "has a stack" : "has no stack";
  }
}
console.log(nested("oneNumber", "x"), nested("oneNumber", 1));
//// numeric-discriminant-unions.ts
// Unions whose discriminant is a bit-flag number that says which fields an object has.
const enum Has { None = 0, Label = 1, Count = 2, Child = 4, Deep = 1 << 20, Top = 1 << 30 }
interface Flagged { flags: Has }
interface WithLabel extends Flagged { label: string }
interface WithCount extends Flagged { count: number }
interface WithChild extends Flagged { child: Flagged }
function make(flags: Has): Flagged {
  const made: Flagged & Partial<WithLabel & WithCount & WithChild> = { flags }
  if (flags & Has.Label) made.label = "l" + flags
  if (flags & Has.Count) made.count = flags * 0.5
  if (flags & Has.Child) made.child = make(flags & ~Has.Child)
  return made
}
const all = make(Has.Label | Has.Count | Has.Child), none = make(Has.None)
// An object created as a type in which the fields are optional is cast to a type in which a field is required. Any object passes the cast.
// The field is read where it is present, and is undefined where it is not. As in ECMAScript.
try { console.log((all as WithLabel).label); console.log("cast to the interface the flags promise: no error") } catch (e) { console.log("cast to the interface the flags promise:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { console.log((all as WithCount).count); console.log("to the second: no error") } catch (e) { console.log("to the second:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { console.log((all as WithChild).child.flags); console.log("to the third: no error") } catch (e) { console.log("to the third:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { console.log((none as WithLabel).label); console.log("where the field is absent: no error") } catch (e) { console.log("where the field is absent:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(JSON.stringify(all), JSON.stringify(none))
// A numeric enum is tested as `number`: flags combine, and a larger number or a fraction is stored as in plain Bun.
all.flags = Has.Top | Has.Deep | 7
console.log(all.flags)
try { all.flags = all.flags * 4096; console.log("beyond 32 bits: no error") } catch (e) { console.log("beyond 32 bits:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { all.flags = all.flags / 8192; console.log("a fraction: no error") } catch (e) { console.log("a fraction:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(all.flags)
//// numeric-index-signature-holds-string.ts
// A string is assignable to `{ [index: number]: string }`: its apparent type `String` has that index signature.
declare const console: { log(...a: unknown[]): void };
type Characters = { [index: number]: string };
function parameter(value: Characters): unknown { return value; }
function first(value: Characters): string { return value[0]; }
function orNull(value: Characters | null): unknown { return value; }
function optional(value?: { readonly [index: number]: string }): unknown { return value; }
function inField(holder: { held: Characters }): unknown { return holder.held; }
function returned(): Characters { return "returned"; }
function local(value: Characters): unknown { let kept: Characters | undefined; kept = value; const list: Characters[] = []; list.push(kept); return list[0]; }
function callback(make: () => Characters): unknown { const made: Characters = make(); return made; }
class Holder { held: Characters; constructor(held: Characters) { this.held = held; } get(): Characters { return this.held; } }
let kept: Characters = "kept";
const table = new Map<string, Characters>();
const given: any = "given";
console.log(parameter("str"), first("str"), first(["a"]), first({ 0: "zero" }), orNull("str"), orNull(null), optional("str"), optional(), inField({ held: "str" }));
console.log(returned(), local("str"), callback(() => "str"), new Holder("str").get(), kept, table.set("k", "str").get("k"), parameter(given), JSON.stringify([parameter(["a"]), parameter({ 0: "a" }), parameter({})]));
//// object-cast-to-primitive-passes-the-cast.ts
// An object that goes through `as string` or `as number` passes: a cast refuses no object, and the code behind it does with the object what JavaScript does. undefined and null pass. Any object passes a cast to an object type, and a field of another kind throws a TypeError at its typed read.
declare const console: { log(...args: unknown[]): void }
function hide(x: unknown): unknown { return x }
function attempt(label: string, f: () => unknown) { try { console.log(label + ":", String(f())) } catch (e) { console.log(label + ":", e instanceof TypeError ? "TypeError" : "other " + e) } }
interface Host { text: string; size: number }
// CODE THAT ONLY INSPECTS
attempt("typeof", () => typeof (hide({}) as string))
attempt("===", () => { const o = hide({}); return (o as string) === o })
attempt("truthiness", () => (hide({}) as string) ? "yes" : "no")
attempt("??", () => typeof ((hide({}) as string) ?? "d"))
attempt("handed on to unknown", () => typeof hide(hide({}) as number))
attempt("an unannotated local, returned", () => { const s = hide([1]) as string; return typeof s })
attempt("?. on nil", () => (hide(undefined) as string)?.length)
// A USE THAT NEEDS THE PRIMITIVE
attempt("USE member", () => (hide({ length: 3 }) as string).length)
attempt("USE member, through a local", () => { const s = hide({ length: 3 }) as string; return s.length })
attempt("USE method", () => (hide({ trim() { return "t" } }) as string).trim())
attempt("USE index", () => (hide(["a"]) as string)[0])
attempt("USE +", () => (hide({}) as number) + 1)
attempt("USE + through a local", () => { const n = hide({}) as number; const m = n + 1; return typeof m })
attempt("USE -x", () => -(hide({ valueOf() { return 2 } }) as number))
attempt("USE <", () => (hide({ valueOf() { return 0 } }) as number) < 1)
attempt("USE template", () => `${hide([1, 2]) as string}!`)
attempt("USE +=", () => { let sum = 0; sum += hide({ valueOf() { return 2 } }) as number; return sum })
attempt("USE ++", () => { let n = hide({ valueOf() { return 2 } }) as number; n++; return n })
attempt("USE a read through a cast object", () => (hide({ text: { length: 7 } }) as Host).text.length)
// HONEST
attempt("honest member", () => (hide("abc") as string).length)
attempt("honest +", () => (hide(2) as number) + 1)
attempt("honest read", () => (hide({ text: "abcd", size: 1 }) as Host).text.length)
attempt("honest nil +", () => (hide(undefined) as number) + 1)
attempt("honest nil member", () => (hide(undefined) as string).length)
attempt("honest template", () => `${hide("x") as string}!`)
//// object-create-class-prototype-passes-for-the-class.ts
// An object created with `Object.create(C.prototype)` and filled with `Object.assign` passes wherever the class `C` is the declared type, and the methods of the class take it for `this`.
class Order { id: number; lines: number[] = []; constructor(id: number) { this.id = id } total() { return this.lines.reduce((x, y) => x + y, 0) } }
function clone<T extends object>(o: T): T { return Object.assign(Object.create(Object.getPrototypeOf(o)), o) }
const order = new Order(4)
order.lines.push(1, 2.5)
try { const cloned = clone(order); console.log("clone of an instance: no error", cloned.id) } catch (e) { console.log("clone of an instance:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { const cloned: Order = Object.assign(Object.create(Order.prototype), order); console.log("the same to a variable: no error", cloned.id) } catch (e) { console.log("the same to a variable:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { const cloned = Object.assign(Object.create(Order.prototype), order) as Order; console.log("the same with as: no error", cloned.id) } catch (e) { console.log("the same with as:", e instanceof TypeError ? "TypeError" : "other " + e) }
// Through `any`: it is an instance by `instanceof`, and a method of the class runs on it.
const loose: any = Object.assign(Object.create(Order.prototype), order)
console.log(loose instanceof Order, loose.id, Object.keys(loose).join(), order.total())
try { console.log("a method on it: no error", loose.total()) } catch (e) { console.log("a method on it:", e instanceof TypeError ? "TypeError" : "other " + e) }
//// object-create-through-interfaces.ts
// Objects made with `Object.create` are used through declared interface types.
interface Conf { host: string; port: number; secure?: boolean; nested: { depth: number } }
function rule(label: string, f: () => unknown) { try { console.log(label + ": no error", f()) } catch (e) { console.log(label + ":", e instanceof TypeError ? "TypeError" : "other " + e) } }
const defaults: Conf = { host: "localhost", port: 80, nested: { depth: 1 } }
rule("heir of an object of the type", () => { const derived: Conf = Object.create(defaults); return derived.port })
rule("accessor and read-only properties", () => {
  const described: Conf = Object.create(Object.prototype, { host: { value: "fixed", enumerable: true }, port: { get: () => 8080, enumerable: false, configurable: true }, nested: { value: { depth: 5 }, writable: true } } as any)
  return described.port
})
rule("heir of a frozen literal", () => { const locked: Conf = Object.create(Object.freeze({ host: "frozen", port: 1, nested: { depth: 2 } })); return locked.port })
// Plain data without a prototype is taken as it is: identity is kept, and a change through one reference is seen through the other,
// whether an untyped object or a variable alone holds the original.
const box: any = { held: Object.assign(Object.create(null), JSON.parse('{"host":"h","port":1,"nested":{"depth":0}}')) }
const bare: Conf = box.held
bare.port++
console.log(bare === box.held, bare.port, box.held.port, Object.getPrototypeOf(bare) === null, bare.nested === box.held.nested, JSON.stringify(bare))
const source: any = Object.assign(Object.create(null), JSON.parse('{"host":"h","port":1,"nested":{"depth":0}}'))
const local: Conf = source
local.port++
console.log(local === source, local.port, source.port, local.nested === source.nested)
// Accessors on the prototype, with an inheriting object for `this`.
const guardedPrototype = {
  held: 10,
  get port() { return this.held },
  set port(p: number) { this.held = p * 2 },
}
const guarded: any = Object.create(guardedPrototype)
rule("setter of a literal with an heir for this", () => { guarded.port = 4; return "stored" })
rule("getter of a literal with an heir for this", () => guarded.port)
console.log(guardedPrototype.port, Object.keys(guarded).length)
class Service implements Conf {
  host = "svc"; port = 443; nested = { depth: 3 }
  url(): string { return this.host + ":" + this.port + (this.secure ? "s" : "") }
  secure?: boolean
}
const service = new Service()
rule("heir of an instance as the class", () => { const overlay: Service = Object.create(service); return overlay.port })
const overlay: any = Object.create(service)
overlay.port = 8443
rule("method of the class with an heir for this", () => overlay.url())
rule("field of an instance made an accessor", () => { Object.defineProperty(service, "host", { get() { return "dynamic" }, enumerable: true, configurable: true }); return service.host })
console.log(service.url(), overlay.host, overlay.port)
//// object-missing-required-properties.ts
// An object that is missing required properties reaches an annotated variable through `any`, or a result through `as`: it passes unchanged.
interface Whole { a: number; b: { x: number }; c: string; d?: number }
try { const partial: Whole = ((): any => ({}))(); console.log("{} from any into a Whole: no error", Object.keys(partial).length) } catch (e) { console.log("{} from any into a Whole:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { const narrowed = ((): Whole => ({ c: "only" } as Whole))(); console.log("{ c } as Whole: no error", Object.keys(narrowed).join()) } catch (e) { console.log("{ c } as Whole:", e instanceof TypeError ? "TypeError" : "other " + e) }
//// object-prototype-not-extensible.ts
// `Object.defineProperty` on `Object.prototype` throws because it is not extensible.
try { Object.defineProperty(Object.prototype, "tag", { value: "polluted", configurable: true, writable: true }); console.log("a property defined on Object.prototype: no error") } catch (e) { console.log("a property defined on Object.prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(({} as any).tag)
//// object-rest-patterns.ts
// Object rest patterns (`const { id, ...rest } = props`) on typed objects and on proxies of them.
interface Props { id: number; title: string; hidden?: boolean; size?: number; style: { color: string; width?: number } }
function show(o: object): string { return Object.keys(o).join() + " " + JSON.stringify(o) }
const props: Props = { title: "t", id: 1, style: { color: "red" }, size: 0 }
// No cast, no any.
const which: "id" | "title" = props.id > 0 ? "title" : "id"
const { [which]: chosen, ...others } = props
console.log(String(chosen), show(others))
const log: string[] = []
try {
  const proxied: Props = new Proxy(props, { get(t, k, r) { log.push("get:" + String(k)); return Reflect.get(t, k, r) }, ownKeys(t) { log.push("keys"); return Reflect.ownKeys(t) } })
  const { title: proxiedTitle, ...proxiedRest } = proxied
  console.log("a proxy as Props: no error", proxiedTitle, show(proxiedRest))
} catch (e) { console.log("a proxy as Props:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(log.length)
//// object-with-another-prototype-as-declared-type.ts
// A value that satisfies its type is never rejected for how it is represented. An heir made by Object.create, an instance of a class of untyped code, plain data, a frozen heir and an object without a prototype pass as `this` and as a parameter, stay what they are, and typed code reads and stores through them as plain JavaScript does.
interface Small { weight: number; run(this: Small, x: number): number }
interface Large { weight: number; inner: { a: number }; list: number[]; run(this: Large, x: number): number; grow(this: Large): Large }
function makeSmall(weight: number): Small { return { weight, run(x: number): number { return x + this.weight; } }; }
function makeLarge(weight: number): Large {
  return { weight, inner: { a: weight }, list: [weight], run(x: number): number { return x + this.weight + this.inner.a + this.list.length; }, grow(): Large { this.weight += 1; this.inner.a += 10; this.list.push(0); return this; } };
}
function total(of: Large): number { return of.weight + of.inner.a + of.list.length; }
function rename(of: Large, weight: number): Large { of.weight = weight; return of; }
const smalls: Small[] = [makeSmall(1), makeSmall(2)];
const larges: Large[] = [makeLarge(1), makeLarge(2)];
let sum = 0;
for (const s of smalls) sum += s.run(1);
for (const l of larges) sum += l.run(1) + total(l);
console.log(sum);
const attempt = function (what: string, run: () => any): void { try { console.log(what + ":", run()); } catch (error: any) { console.log(what + ":", error.constructor.name); } };
const loose: any = { smalls, larges, total, rename };
attempt("an heir as this, flat type", function (): any { return Object.create(loose.smalls[0]).run(5); });
attempt("an heir as this", function (): any { return Object.create(loose.larges[0]).run(5); });
attempt("an heir as a parameter", function (): any { return loose.total(Object.create(loose.larges[1])); });
attempt("an heir of an heir", function (): any { return Object.create(Object.create(loose.larges[0])).run(5); });
attempt("this is the heir itself", function (): any { const heir = Object.create(loose.larges[0]); return heir.grow() === heir; });
attempt("a store through this lands on the heir", function (): any { const heir = Object.create(loose.larges[1]); heir.grow(); return [Object.keys(heir).join(), heir.weight, loose.larges[1].weight, loose.larges[1].inner.a, loose.larges[1].list.length].join(" "); });
attempt("a store through a parameter lands on the heir", function (): any { const heir = Object.create(loose.larges[1]); return [loose.rename(heir, 50) === heir, Object.keys(heir).join(), heir.weight, loose.larges[1].weight].join(" "); });
const Untyped: any = (function (): any { function Made(this: any, w: any): void { this.weight = w; this.inner = { a: w }; this.list = [w, w]; } Made.prototype.run = loose.larges[0].run; Made.prototype.grow = loose.larges[0].grow; Made.prototype.extra = function (this: any): any { return "extra " + this.weight; }; return Made; })();
attempt("an instance of a class of untyped code as this", function (): any { return new Untyped(3).run(5); });
attempt("the same as a parameter", function (): any { return loose.total(new Untyped(4)); });
attempt("it stays what it is", function (): any { const made = new Untyped(5); const back = loose.rename(made, 6); return [back === made, back instanceof Untyped, back.extra(), Object.getPrototypeOf(back) === Untyped.prototype].join(" "); });
attempt("plain data as this", function (): any { return ({ weight: 3, inner: { a: 1 }, list: [], run: loose.larges[0].run, grow: loose.larges[0].grow }).run(5); });
attempt("plain data as a parameter", function (): any { return loose.total({ weight: 3, inner: { a: 1 }, list: [1, 2, 3], run: loose.larges[0].run, grow: loose.larges[0].grow }); });
attempt("a frozen heir", function (): any { return Object.freeze(Object.create(loose.larges[0])).run(5); });
attempt("a null prototype", function (): any { const bare = Object.assign(Object.create(null), { weight: 1, inner: { a: 2 }, list: [], run: loose.larges[0].run, grow: loose.larges[0].grow }); return loose.total(bare); });
attempt("the typed objects still work", function (): any { return [larges[0]!.run(1), total(larges[1]!), smalls[0]!.run(1)].join(" "); });
//// objects-with-extra-properties.ts
// Objects with more properties than the type through which they are used.
interface Narrow { id: number }
function keysOf(x: Narrow): string { return Object.keys(x).join() }
function copy(x: Narrow): Narrow { return { ...x } }
function json(x: Narrow): string { return JSON.stringify(x) }
class Row { id = 2; cells = ["a"]; hidden?: string; constructor(public owner: string) {} width() { return this.cells.length } }
const row = new Row("r")
// ECMAScript: z,id,a / owner,id,cells,hidden / {"owner":"r","id":-1,"cells":["a"]} / id,secret,at,extra.
const foreign: Narrow = JSON.parse('{"z":0,"id":5,"a":[{"id":6}]}')
console.log(keysOf(foreign), json(foreign))
console.log(keysOf(row), keysOf(copy(row)), json({ ...(row as Narrow), id: -1 }))
function build(id: number): Narrow { const made = { id, secret: "s" + id, at: [id] }; return made }
const more = { ...build(1), extra: 1 }
console.log(keysOf(more), json(more))
// The copy is a plain object. A cast to the class lets it through unchanged, and `owner` is read from it as in ECMAScript.
const copiedRow = copy(row)
try { console.log((copiedRow as Row).owner); console.log("a copy cast to the class: no error") } catch (e) { console.log("a copy cast to the class:", e instanceof TypeError ? "TypeError" : "other " + e) }
// `Object.assign({}, x)` under a written result type keeps the key order of ECMAScript: {"owner":"r","id":2,"cells":["a"]}.
function assign(x: Narrow): Narrow { return Object.assign({}, x) }
try { console.log(json(assign(row))); console.log("Object.assign({}, x): no error") } catch (e) { console.log("Object.assign({}, x):", e instanceof TypeError ? "TypeError" : "other " + e) }
//// odd-class-uses.ts
// Classes called without `new`, constructors that return other objects, subclasses of built-ins, methods taken off, brands.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name + ": " + e.message.split("\n")[0] : String(e))) } }
function hide(v: unknown): any { return v }
function parse(t: string): any { return JSON.parse(t) }
class Point { x: number; y: number; constructor(x: number, y: number) { this.x = x; this.y = y } sum(): number { return this.x + this.y } static origin(): Point { return new Point(0, 0) } }
class Returns { v = 1; constructor(other?: object) { if (other) return other as Returns } }
class List extends Array<number> { total(): number { let s = 0; for (const x of this) s += x; return s } }
class Fault extends Error { code = 7; constructor(m: string) { super(m); this.name = "Fault" } }
class Table extends Map<string, number> { sum(): number { let s = 0; for (const v of this.values()) s += v; return s } }
row("a class called without new", () => hide(Point)(1, 2));
row("a constructor that returns another object", () => { const o = { v: 9 }; const r = new Returns(o); return r.v + " " + ((r as unknown) === o) + " " + (r instanceof Returns) });
row("Reflect.construct with another new.target", () => { class Other { } const p = Reflect.construct(Point, [1, 2], Other); return hide(p).x + " " + (p instanceof Point) + " " + (p instanceof Other) });
row("a method taken off and called on plain data", () => Point.prototype.sum.call(hide({ x: 3, y: 4 })));
row("a method taken off and called on nothing", () => hide(Point.prototype.sum)());
row("extends Array", () => { const l = new List(); l.push(1, 2, 3); return l.total() + " " + l.length + " " + (l.map(x => x) instanceof List) + " " + Array.isArray(l) });
row("extends Error", () => { const f = new Fault("m"); return f.name + " " + f.message + " " + f.code + " " + (f instanceof Error) + " " + String(f) + " " + typeof f.stack });
row("extends Map", () => { const t = new Table([["a", 1], ["b", 2]]); return t.sum() + " " + t.size + " " + (t instanceof Map) });
row("Symbol.hasInstance", () => { class Even { static [Symbol.hasInstance](n: unknown): boolean { return typeof n === "number" && n % 2 === 0 } } return (hide(2) instanceof Even) + " " + (hide(3) instanceof Even) });
row("an extra property on an instance", () => { const p = new Point(1, 2); hide(p).z = 3; return Object.keys(p).join() + " " + JSON.stringify(p) });
row("a field deleted from an instance", () => { const p = new Point(1, 2); const was = delete hide(p).x; return was + " " + Object.keys(p).join() + " " + p.sum() });
row("private names and brands", () => { class Safe { #v = 1; static has(o: unknown): boolean { return typeof o === "object" && o !== null && #v in o } get(): number { return this.#v } } return Safe.has(new Safe()) + " " + Safe.has({}) + " " + (() => { try { return Safe.prototype.get.call(hide({})) } catch (e) { return (e as Error).name } })() });
row("the class as a value", () => { const C: any = hide(Point); return typeof C + " " + C.name + " " + C.length + " " + Object.getOwnPropertyNames(C.prototype).join() + " " + new C(1, 2).sum() + " " + C.origin().sum() });
row("toString of a class and of a function", () => { function f(a: number): number { return a } return String(f).replace(/\s+/g, " ").slice(0, 12) + " " + String(Point).slice(0, 11) });
//// only-a-false-value-arrives.ts
// Each written type here is reached by one value only, and that value does not fit. The analysis of the whole program finds that nothing passes the test, so the code behind it is dead; the test itself still runs and throws a TypeError at the place that wrote the type. A type parameter tests nothing, an object type is satisfied by any object, and a literal type by any primitive of its kind.
function describe(error: unknown): string {
  if (!(error instanceof Error)) return "thrown: " + String(error);
  const e = error;
  const message = e.message.split("\n")[0].replace(/ \(bun compile[^)]*\)/, "");
  // The text of an error of the language is not the subject here.
  if (!/(^|: )expected |^Expected /.test(message)) return e.name;
  const position = message.includes(", got ") ? /:(\d+):(\d+)\)?\s*$/m.exec(e.stack ?? "") : null;
  return e.name + ": " + message + (position ? " | " + position[1] + ":" + position[2] : "");
}
async function attempt(name: string, f: () => unknown): Promise<void> {
  try { console.log(name, "|", "no error:", String(await f())); } catch (error) { console.log(name, "|", describe(error)); }
}
{
  function double(n: number) { return n * 2; }
  await attempt("argument", () => double("4" as any));
}
{
  function double(n: number) { return n * 2; }
  const untyped: any = double;
  await attempt("argument-by-value", () => untyped("x"));
}
{
  function ignore(n: number) { return 1; }
  await attempt("argument-unused", () => ignore("4" as any));
}
{
  function second(a: string, n: number) { return a + n; }
  await attempt("argument-second", () => second("a", "4" as any));
}
{
  function double(n: number) { return n * 2; }
  await attempt("argument-object-for-number", () => double({} as any));
}
