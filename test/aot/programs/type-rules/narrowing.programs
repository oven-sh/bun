//// narrowing.ts
// A type guard or an assertion function tests nothing: what it claims about a value is a prediction, and a value of another kind goes on as in plain Bun. A type argument written at a call is tested at the call; an inferred one is a prediction.
////= attempt
const hide = (v: unknown): unknown => v
// Guards and assertion functions that lie.
function isNumber(v: unknown): v is number { return v !== null }
attempt("guard, a string as a number", () => { const v = hide("s"); if (isNumber(v)) return v + 1; return "no" })
attempt("guard, a boolean as a number", () => { const v = hide(true); if (isNumber(v)) return v * 2; return "no" })
attempt("guard, an object as a number", () => { const v = hide({}); if (isNumber(v)) return typeof v + v.toFixed; return "no" })
function assertString(v: unknown): asserts v is string {}
attempt("assertion function, a number as a string, length", () => { const v = hide(5); assertString(v); return v.length })
attempt("assertion function, a number as a string, +", () => { const v = hide(5); assertString(v); return v + "!" })
// A generic function of the program: inside it `T` names no kind. A type argument written at the call is tested at the call, and so is an annotated variable that takes the result. An inferred type argument tests nothing.
function cast<T>(v: unknown): T { return v as T }
function first<T>(items: T[]): T { return items[0] }
attempt("generic cast", () => cast<number>("s") + 1)
attempt("generic cast to a variable", () => { const n: number = cast("s"); return n + 1 })
attempt("generic element", () => first<number>(JSON.parse('["s"]')) + 1)
function prop<T, K extends keyof T>(o: T, k: K): T[K] { return o[k] }
attempt("plain data with a field of another kind", () => prop(JSON.parse('{"x":"s"}') as { x: number }, "x") + 1)
//// nested-conditional-type-in-union.ts
// TypeScript's base constraint of `NoUndefined<Output<T>>` is `never`, although the type has values once T is known (zod's `.default(value)`).
// A deferred type whose constraint is `never` says nothing about the values a generic function is given.
type NoUndefined<T> = T extends undefined ? never : T;
interface Schema<Output = unknown> { _output: Output }
type Output<T> = T extends { _output: any } ? T["_output"] : never;
const text: Schema<string> = { _output: "" };
const count: Schema<number | undefined> = { _output: 1 };
const point: Schema<{ x: number }> = { _output: { x: 1 } };

function alone<T extends Schema>(inner: T, value: NoUndefined<Output<T>>): unknown { return value; }
function inUnion<T extends Schema>(inner: T, value: NoUndefined<Output<T>> | number[]): unknown { return value; }
function orUndefined<T extends Schema>(inner: T, value: NoUndefined<Output<T>> | undefined): unknown { return value; }
function optional<T extends Schema>(inner: T, value?: NoUndefined<Output<T>>): unknown { return value; }
function excluded<T extends Schema>(inner: T, value: Exclude<Output<T>, undefined> | number[]): unknown { return value; }
function twice<T extends Schema>(inner: T, value: NoUndefined<NoUndefined<Output<T>>> | null): unknown { return value; }
function intersected<T extends Schema>(inner: T, value: (NoUndefined<Output<T>> & {}) | number[]): unknown { return value; }
function inField<T extends Schema>(inner: T, holder: { held: NoUndefined<Output<T>> | number[] }): unknown { return holder.held; }
function inArray<T extends Schema>(inner: T, values: (NoUndefined<Output<T>> | null)[]): unknown { return values[0]; }
function returned<T extends Schema>(inner: T): NoUndefined<Output<T>> | undefined { return inner._output as NoUndefined<Output<T>>; }
function orFactory<T extends Schema>(inner: T, value: NoUndefined<Output<T>> | (() => NoUndefined<Output<T>>)): unknown { return typeof value === "function" ? (value as () => unknown)() : value; }
class Defaulted<T extends Schema> {
  constructor(public inner: T, public value: NoUndefined<Output<T>> | undefined) {}
  get(): NoUndefined<Output<T>> | undefined { return this.value; }
}

console.log(alone(text, "a"), inUnion(text, "a"), String(inUnion(text, [1])), orUndefined(text, "a"), orUndefined(text, undefined), optional(text, "a"), optional(text));
console.log(excluded(text, "a"), twice(text, "a"), twice(text, null), intersected(text, "a"), inField(text, { held: "a" }), inArray(text, ["a", null]), returned(text));
console.log(inUnion(count, 2), optional(count, 2), excluded(count, 2), new Defaulted(count, 2).get(), new Defaulted(text, "a").get(), new Defaulted(text, undefined).get());
console.log(JSON.stringify([inUnion(point, { x: 2 }), optional(point, { x: 3 }), inField(point, { held: { x: 4 } }), new Defaulted(point, { x: 5 }).get()]));
console.log(orFactory(text, "a"), orFactory(text, () => "made"), orFactory(count, 3), orFactory(count, () => 4));

interface Parser<Out> { parse(value: unknown): Out }
type Infer<S> = S extends Parser<infer Out> ? Out : never;
interface Tool { inputSchema?: Parser<unknown> }
function validate<T extends Tool, Args extends T["inputSchema"] extends infer S ? (S extends Parser<unknown> ? Infer<S> : undefined) : undefined>(tool: T, args: Args): Args {
  return tool.inputSchema ? args : (undefined as Args);
}
const tool = { inputSchema: { parse: (value: unknown) => value as { a: number } } };
console.log(JSON.stringify(validate(tool, { a: 1 })), validate({}, undefined));

type Procedure = (input: number) => number;
interface RouterRecord { [key: string]: Procedure | RouterRecord }
type Decorated<P> = P extends (input: infer I) => infer O ? (input: I) => O : never;
type DecorateRecord<R extends RouterRecord> = { [K in keyof R]: R[K] extends infer V ? (V extends Procedure ? Decorated<V> : V extends RouterRecord ? DecorateRecord<V> : never) : never };
function pick<R extends RouterRecord, K extends keyof R>(record: DecorateRecord<R>, key: K): DecorateRecord<R>[K] { return record[key]; }
function kindOf<R extends RouterRecord, K extends keyof R>(value: DecorateRecord<R>[K]): string { return typeof value; }
const routes = { double: (n: number) => n * 2, nested: { triple: (n: number) => n * 3 } };
console.log(pick<typeof routes, "double">(routes, "double")(2), pick<typeof routes, "nested">(routes, "nested").triple(2), kindOf<typeof routes, "double">(routes.double), kindOf<typeof routes, "nested">(routes.nested));

type Unwrapped<T> = T extends readonly (infer E)[] ? Unwrapped<E> : T;
function innermost<T>(value: T, fallback: Unwrapped<T> | null): unknown { return fallback; }
type Picked<T> = T extends { kind: "text" } ? string : T extends { kind: "count" } ? number : boolean;
function picked<T extends { kind: string }>(tag: T, value: Picked<T> | undefined): unknown { return value; }
console.log(innermost([[1]], 2), innermost("a", "b"), innermost([["x"]], null), picked({ kind: "text" as const }, "t"), picked({ kind: "count" as const }, 3), picked({ kind: "other" }, true));
//// never-returned-from-exhaustive-switch.ts
type Read = { kind: "miss"; reason: "absent" | "expired" | "disabled" } | { kind: "hit"; value: number };
function isMiss(read: Extract<Read, { kind: "miss" }>): boolean {
  switch (read.reason) {
    case "absent":
    case "expired":
      return true;
    case "disabled":
      return false;
    default:
      return read.reason satisfies never;
  }
}
const label = (read: Extract<Read, { kind: "miss" }>): string => (read.reason === "absent" ? "a" : read.reason === "expired" ? "e" : read.reason === "disabled" ? "d" : (read.reason satisfies never));
const reads: Extract<Read, { kind: "miss" }>[] = [{ kind: "miss", reason: "absent" }, { kind: "miss", reason: "disabled" }, { kind: "miss", reason: "expired" }];
for (const read of reads) console.log(isMiss(read), label(read));
//// new-mispredicted-constructor.ts
// `new` calls another constructor function at run time than the source suggests, one that does not initialize a required field. Any object passes the type `Item`, so the program goes on as in plain Bun.
enum Kind { Unknown, One, Two }
interface Item { o: number[]; kind: Kind; pos: number; end: number }
interface Span { o: number[]; pos: number; end: number }
const list = [1]
function ItemCtor(this: Item, o: number[], kind: Kind, pos: number, end: number) { this.o = o; this.pos = pos; this.end = end; this.kind = kind }
function SpanCtor(this: Span, o: number[], kind: Kind, pos: number, end: number) { this.o = o; this.pos = pos; this.end = end }
// One that stores all of it, in another order.
function OtherCtor(this: Item, o: number[], kind: Kind, pos: number, end: number) { this.kind = kind; this.o = o; this.end = end; this.pos = pos }
const allocator = { get: () => ItemCtor as any }
let ItemConstructor: new (o: number[], kind: Kind, pos: number, end: number) => Item
const start = () => { ItemConstructor = allocator.get() }
const make = (kind: Kind, pos: number, end: number) => new ItemConstructor(list, kind, pos, end)
const length = (span: Span) => span.end - span.pos + span.o.length
const attempt = () => {
    try { const item = make(Kind.Two, 1, 4); console.log("made", JSON.stringify(Object.keys(item).filter(key => key !== "o"))); console.log(length(item)) }
    catch (e) { console.log("refused", (e as Error).constructor.name) }
}
start(); attempt()
const replace = (holder: any, name: string, f: unknown) => { holder[name] = () => f }
replace(allocator, "get", SpanCtor); start(); attempt()
replace(allocator, "get", OtherCtor); start(); attempt()
replace(allocator, "get", ItemCtor); start(); attempt()
console.log(length(new (SpanCtor as any)(list, Kind.One, 2, 9)))
//// new-properties-on-array-object-prototype.ts
// `Array.prototype` takes a new ordinary name, as in plain Bun, and stays extensible; adding an index to it throws. `Object.prototype` takes neither.
const protoAny: any = Array.prototype
try { protoAny.foo = 1; console.log("Array.prototype.foo: no error") } catch (e) { console.log("Array.prototype.foo:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { protoAny["1"] = 1; console.log("Array.prototype['1']: no error") } catch (e) { console.log("Array.prototype['1']:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { protoAny[2] = 1; console.log("Array.prototype[2]: no error") } catch (e) { console.log("Array.prototype[2]:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(Object.isExtensible(protoAny), protoAny.foo, protoAny[1], protoAny[2])
const o: any = Object.prototype
try { o[2] = 1; console.log("Object.prototype[2]: no error") } catch (e) { console.log("Object.prototype[2]:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { o.foo = 1; console.log("Object.prototype.foo: no error") } catch (e) { console.log("Object.prototype.foo:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(Object.isExtensible(o), Object.hasOwn(o, "foo"), o[2])
// Objects of the program are not concerned.
const q: any = {}
q[2] = 1
const r: any = []
r[2] = 1
console.log(q[2], r[2], r.length)
//// new-properties-on-builtin-prototypes.ts
// Adding a name to `Promise.prototype`, `Function.prototype` or `Object.prototype` throws: the first and the last are closed entirely, and `Function.prototype`, though it stays extensible, takes no name but a few that are listed. `String.prototype` and `Map.prototype` keep their members and take a name that neither they nor `Object.prototype` have.
try { (String.prototype as any).poop = 1; console.log("String.prototype: no error") } catch (e) { console.log("String.prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { (Map.prototype as any).poop = 1; console.log("Map.prototype: no error") } catch (e) { console.log("Map.prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { (Promise.prototype as any).poop = 1; console.log("Promise.prototype: no error") } catch (e) { console.log("Promise.prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { (Function.prototype as any).poop = 1; console.log("Function.prototype: no error") } catch (e) { console.log("Function.prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { (Object.prototype as any).poop = 1; console.log("Object.prototype: no error") } catch (e) { console.log("Object.prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { Object.defineProperty(Object.prototype, "poop2", { value: 1, configurable: true }); console.log("Object.prototype, defineProperty: no error") } catch (e) { console.log("Object.prototype, defineProperty:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(("" as any).poop, (new Map() as any).poop, (Promise.resolve() as any).poop, (Math.floor as any).poop, ({} as any).poop, ({} as any).poop2)
console.log([Array.prototype, Object.prototype, Function.prototype, String.prototype, Map.prototype, Promise.prototype].map(o => Object.isExtensible(o)).join())
//// new-via-any-typed-this-function/main.ts
// `new`, through `any`, on plain functions whose `this` parameter is typed.
import { type Node, type Token } from "./req/shapes.js"
function Node(this: { kind: number }, kind: number) { this.kind = kind }
function Token(this: { text: string }, text: string) { this.text = text }
const allocator = { node: () => Node as any, token: () => Token as any }
try { const n: Node = new (allocator.node())(4); console.log("new Node: no error") } catch (e) { console.log("new Node:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { const t: Token = new (allocator.token())("t"); console.log("new Token: no error") } catch (e) { console.log("new Token:", e instanceof TypeError ? "TypeError" : "other " + e) }
//// new-via-any-typed-this-function/req/shapes.ts
export interface Node { kind: number }
export interface Token { text: string }
export const other = 1
//// no-inherited-array-prototype-elements.ts
// `Array.prototype` takes no index, so holes and out-of-bounds reads never find an inherited element. An ordinary new name can be added to it and deleted again, as in plain Bun.
const protoAny: any = Array.prototype
try { protoAny[1] = "inherited"; console.log("an element added to Array.prototype: no error") } catch (e) { console.log("an element added to Array.prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(String(([0, , 2] as unknown[])[1]), String(([0] as unknown[])[1]), 1 in [0])
console.log(delete protoAny[1], 1 in [0])
try { protoAny.extra = "added"; console.log("a name added to Array.prototype: no error", ([] as any).extra) } catch (e) { console.log("a name added to Array.prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(delete protoAny.extra, "extra" in [])
//// non-null-assertions-check-nothing.ts
interface Row { id: number; name: string; next: Row | null }

////= say
function shout(text: string): string { return text + "!"; }
function twice(n: number): number { return n + n; }
function first(rows: Row[]): Row { return rows[0]!; }
function nameOf(row: Row | null): string { return row!.name; }
function keep(row: Row | undefined): Row { const kept: Row = row!; return kept; }

const names: string[] = ["a", "b"];
const counts: number[] = [1, 2];
const rows: Row[] = [{ id: 1, name: "one", next: null }];
const byName = new Map<string, Row>([["one", rows[0]!]]);
const maybe: { held?: string; row?: Row } = {};
let later: string | undefined;
let nothing: Row | null = null;
class Holder { row: Row | null = null; take(): Row { return this.row!; } }

say("an element that is there", () => shout(names[1]!));
say("a missing element", () => typeof names[3]!);
say("a missing element, passed on", () => shout(names[3]!));
say("a missing number, added", () => twice(counts[5]!));
say("a missing property", () => typeof maybe.held!);
say("a missing property, passed on", () => shout(maybe.held!));
say("an unset variable", () => typeof later!);
say("a Map entry that is there", () => byName.get("one")!.name);
say("a missing Map entry", () => typeof byName.get("two")!);
say("a missing Map entry, read", () => byName.get("two")!.name);
say("a missing result", () => typeof first([]));
say("a missing result, read", () => first([]).id);
say("null, read", () => nameOf(null));
say("null, tested afterwards", () => (nothing! ? "some" : "none"));
say("undefined into an annotated variable", () => typeof keep(undefined));
say("undefined into an annotated variable, read", () => keep(undefined).id);
say("null out of a field", () => String(new Holder().take()));
say("null out of a field, read", () => new Holder().take().name);
say("twice", () => typeof maybe.row!.next!);
say("in a template", () => `${names[9]!}`);
say("compared", () => names[9]! === undefined);
say("stored and read back", () => { const list: string[] = []; list.push(names[9]!); return list.length + String(list[0]); });
say("after it, the value is still there", () => { const row = rows[0]!; return row.id + row.name; });
//// non-null-element-before-fallback.ts
// `a[i]! || fallback`: the left side is a test. Where the element is missing it is falsy, and the result is the fallback.
const numbers = [10, 0, 30]
const doubles = [1.5, 0, NaN]
const words = ["a", "", "c"]
const boxes = [{ v: 1 }]
const bytes = new Uint8Array([7, 0])
function takes(n: number) { return n + 1 }
function orZero(list: number[], i: number): number { return list[i]! || 0 }
for (const i of [0, 1, 2, 3, -1, 0.5]) {
  console.log(i, numbers[i]! || "none", doubles[i]! || -1, words[i]! || "?", bytes[i]! || 9, (boxes[i]! || { v: -1 }).v)
  const kept: number = numbers[i]! || 5
  console.log(kept, takes(numbers[i]! || 5), (numbers[i]! || 1) + 1, orZero(numbers, i), [numbers[i]! || 2].length, `${words[i]! || "empty"}`)
  console.log(numbers[i]! || doubles[i]! || 4, numbers[i + 1]! || numbers[i]! || "neither")
}
//// non-null-element-in-constant.ts
// `const x = a[i]!` whose every use is a comparison, arithmetic on numbers or a test asserts nothing, like `a[i]!` written
// in those places. The same goes for `switch (a[i]!)`, and for any other use.
function lastDue(offsets: number[], end: number) {
  let last = -1
  for (;;) {
    const next = offsets[last + 1]!
    if (!(next <= end)) break
    last++
  }
  return last
}
console.log(lastDue([1, 2, 3], 10), lastDue([1, 2, 30], 10), lastDue([], 10))

function describe(list: number[], i: number) {
  const value = list[i]!
  const other = list[i + 1]!
  let total = 100
  total += value
  return [value < 15, value >= 15, value < other, value + 1, value * other, -value, value | 0, value === 10, value !== other, !value, typeof value, value ? "truthy" : "falsy", value || "none", total].join(" ")
}
function tests(list: number[], i: number) {
  const value = list[i]!
  let seen = ""
  if (value) seen += "if "
  if (value && i >= 0) seen += "and "
  if (!value || i < 0) seen += "or "
  while (value > 100) seen += "never "
  switch (value) { case 10: seen += "ten"; break; case 20: seen += "twenty"; break; default: seen += "other" }
  return seen
}
function words(list: string[], i: number) {
  const word = list[i]!
  return [word < "b", word >= "b", word === "a", !word, typeof word, word || "none"].join(" ")
}
function inAClosure(list: number[], i: number) {
  const value = list[i]!
  return [1, 2].map(k => (value < 15 ? k : -k)).join()
}
function kind(text: string, i: number) {
  switch (text[i]!) { case "a": return 1; case "b": return 2; default: return 0 }
}
function count(list: number[], i: number) {
  switch (list[i]!) { case 10: return "ten"; case 20: return "twenty" }
  return "none"
}
function scan(text: string) {
  let i = 0, letters = 0
  for (;;) {
    const c = text[i]!
    if (c === " ") { i++; continue }
    if (!(c >= "a" && c <= "z")) return letters
    letters++
    i++
  }
}
for (const i of [0, 1, 2, 7, -1, 0.5]) {
  console.log(i, describe([10, 20], i), "|", describe([1.5, 2.5], i))
  console.log(tests([10, 20, 0], i), "|", words(["a", "b"], i), "|", inAClosure([10, 20], i), kind("ab", i), count([10, 20], i))
}
console.log(scan("ab cd"), scan(""), scan("a1"))

// One other use.
////= attempt
function takes(n: number) { return n }
const list = [10, 20]
attempt("also passed", () => { const value = list[5]!; return value < 1 ? takes(value) : 0 })
attempt("also returned", () => { const value = list[5]!; if (value < 1) return 1; return value })
attempt("also in a template", () => { const value = list[5]!; return value < 1 ? "" : `${value}` })
attempt("also stored", () => { const value = list[5]!; const kept = { value }; return value < 1 ? kept : 0 })
attempt("also the value of &&", () => { const value = list[5]!; return value && 1 })
attempt("also a member read", () => { const value = list[5]!; return value < 1 ? 0 : value.toFixed(1) })
attempt("annotated", () => { const value: number = list[5]!; return value < 1 })
attempt("a variable that is assigned", () => { let value = list[5]!; value = 1; return value < 1 })
//// non-null-element-record-default.ts
// `a[i]! || fallback` where the whole goes to a place of a record type: a missing element is falsy, as in JavaScript.
type Box = { v: number }
type Pair = { left: Box; right: Box }
class Crate { constructor(readonly v: number) {} }
const boxes: Box[] = [{ v: 1 }, { v: 2 }]
const crates: Crate[] = [new Crate(5)]
const lists: number[][] = [[1, 2]]
const spare: Box = { v: -1 }
function takesBox(box: Box) { return box.v }
function annotated(i: number) { const kept: Box = boxes[i]! || { v: -1 }; return kept.v }
function passed(i: number) { return takesBox(boxes[i]! || { v: -1 }) }
function returned(i: number): Box { return boxes[i]! || { v: -1 } }
function named(i: number): Box { return boxes[i]! || spare }
function stored(i: number) { const pair: Pair = { left: boxes[i]! || { v: -2 }, right: boxes[i + 1]! || spare }; return pair.left.v + "," + pair.right.v }
function chained(i: number): Box { return boxes[i]! || boxes[i - 1]! || { v: -3 } }
function assigned(i: number) { let kept: Box = spare; kept = boxes[i]! || { v: -4 }; return kept.v }
function ofAClass(i: number): Crate { return crates[i]! || new Crate(-5) }
function ofArrays(i: number): number[] { return lists[i]! || [] }
function inAnArray(i: number): Box[] { return [boxes[i]! || { v: -6 }] }
const arrow = (i: number): Box => boxes[i]! || { v: -7 }
for (const i of [0, 1, 2, 7, -1]) {
  console.log(i, annotated(i), passed(i), returned(i).v, named(i).v, stored(i), chained(i).v, assigned(i), ofAClass(i).v, ofArrays(i).length, inAnArray(i)[0]!.v, arrow(i).v)
}
//// non-null-element-tested-before-use.ts
// `const x = a[i]!` that is tested before it is used: the test handles the missing element, as in JavaScript.
// Every use of `x` follows such a test, or is itself a test, a comparison or arithmetic on numbers.
type Box = { v: number }
const boxes: Box[] = [{ v: 1 }, { v: 2 }]
const numbers = [10, 0, 30]
const words = ["a", "", "c"]
function takes(n: number) { return n + 1 }
function early(i: number) { const box = boxes[i]!; if (!box) return "none"; return box.v }
function inside(i: number) { const box = boxes[i]!; if (box) { return box.v } return "none" }
function conditional(i: number) { const box = boxes[i]!; return box ? box.v : "none" }
function strict(i: number) { const n = numbers[i]!; if (n === undefined) return "none"; return takes(n) }
function strictOther(i: number) { const n = numbers[i]!; if (n !== undefined) return [n].length + takes(n); return "none" }
function loose(i: number) { const word = words[i]!; if (word == null) return "none"; return word.length + `<${word}>` }
function thrown(i: number) { const box = boxes[i]!; if (!box) throw new RangeError("no box " + i); return box.v }
function skipped(from: number) {
  let total = 0
  for (let i = from; i < from + 3; i++) {
    const box = boxes[i]!
    if (!box) continue
    total += box.v
    const kept = box
    total += kept.v
  }
  return total
}
function stops(from: number) {
  const seen: number[] = []
  for (let i = from; ; i++) {
    const n = numbers[i]!
    if (n === undefined) break
    seen.push(n)
  }
  return seen.join()
}
function overAJoin(i: number, flag: boolean) {
  const box = boxes[i]!
  if (!box) return "none"
  let extra = 0
  if (flag) extra = 1; else extra = 2
  return box.v + extra
}
function inALoop(i: number) {
  const box = boxes[i]!
  if (!box) return "none"
  let total = 0
  for (let k = 0; k < 3; k++) total += box.v
  return total
}
function both(i: number) { const a = boxes[i]!, b = boxes[i + 1]!; if (!a || !b) return "none"; return a.v + b.v }
function attempt(label: string, f: () => unknown) {
  try { console.log(label + ":", String(f())) } catch (e) { console.log(label + ":", e instanceof TypeError ? "TypeError" : e instanceof RangeError ? "RangeError" : "other " + e) }
}
for (const i of [0, 1, 2, 5, -1]) {
  console.log(i, early(i), inside(i), conditional(i), strict(i), strictOther(i), loose(i), skipped(i), stops(i), overAJoin(i, i > 0), inALoop(i), both(i))
  attempt("thrown", () => thrown(i))
}

// One use that no test stands ahead of.
attempt("ahead of the test", () => { const box = boxes[5]!; const kept = [box]; if (!box) return "none"; return kept.length })
attempt("on the other side of the test", () => { const box = boxes[5]!; if (!box) return [box].length; return box.v })
attempt("in a closure behind the test", () => { const box = boxes[5]!; if (!box) return "none"; const later = () => box.v; return later() })
attempt("behind a test of something else", () => { const box = boxes[5]!, other = boxes[0]!; if (!other) return "none"; return box.v + other.v })
attempt("behind one way into a join", () => { const box = boxes[5]!; if (numbers.length > 9) { if (!box) return "none" } return [box].length })
attempt("null is not undefined", () => { const n = numbers[5]!; if (n === null) return "none"; return takes(n) })
//// non-null-element-under-operators.ts
// `a[i]!` as an operand of `<`, `<=`, `>`, `>=` or of arithmetic on numbers asserts nothing: where the element
// is missing the operator does what it does with `undefined`. A loop may end by reading one past the end.
function lastDue(offsets: number[], end: number) {
  let last = -1
  while (offsets[last + 1]! <= end) last++
  return last
}
console.log(lastDue([1, 2, 3], 10), lastDue([1, 2, 30], 10), lastDue([], 10), lastDue([1.5, 2.5], 2))

function count(parts: number[], end: number): number {
  let last = -1
  let seen = 0
  for (; parts[last + 1]! <= end;) {
    const part = parts[++last]!
    seen += part >= 0 ? 1 : 0
  }
  return seen
}
console.log(count([0, 3, 5], 9), count([0, 3, 50], 9), count([], 9))

const integers = [10, 20, 30]
const doubles = [1.5, 2.5, 3.5]
const holes: (number | undefined)[] = [1, , 3]
const words = ["a", "b", "c"]
const floats = new Float64Array([1.5, 2.5])
const pair: [number, number] = [1, 2]
const byName: Record<string, number> = { one: 1 }
for (const i of [0, 1, 2, 3, 7, -1, 0.5, 4294967295, NaN]) {
  console.log("index", i)
  for (const list of [integers, doubles, holes]) {
    console.log(list[i]! < 15, list[i]! <= 15, list[i]! > 15, list[i]! >= 15, 15 < list[i]!, 15 >= list[i]!, list[i]! < list[i + 1]!)
    console.log(list[i]! + 1, 1 + list[i]!, list[i]! - 1, list[i]! * 2, list[i]! / 2, list[i]! % 2, list[i]! ** 2, -list[i]!, +list[i]!)
    console.log(list[i]! | 0, list[i]! & 7, list[i]! ^ 1, list[i]! << 1, list[i]! >> 1, list[i]! >>> 1, ~list[i]!)
    let total = 100
    total += list[i]!
    console.log(total)
    total = 100
    total -= list[i]!
    total *= list[i]!
    console.log(total)
    total = 100
    total |= list[i]!
    console.log(total)
  }
  console.log(words[i]! < "b", words[i]! >= "b", "b" > words[i]!, words[i]! < words[i + 1]!)
  console.log("abc"[i]! < "b", "abc"[i]! >= "b")
  console.log(floats[i]! < 2, floats[i]! + 1, floats[i]! * floats[i + 1]!)
  console.log(pair[i]! < 2, pair[i]! + 1)
}
console.log(byName["one"]! < 2, byName["two"]! < 2, byName["two"]! + 1)
const few: (1 | 2 | 3)[] = [1, 2]
console.log(few[0]! < 2, few[5]! < 2, few[5]! + 1)

// A test only asks.
function tests(list: number[], i: number) {
  return [list[i]! ? "truthy" : "falsy", !list[i]!, list[i]! === 10, list[i]! !== 10, typeof list[i]!].join(" ")
}
console.log(tests(integers, 0), tests(integers, 3))
if (integers[3]! && integers[0]!) console.log("not reached")

function sorted(list: number[]) {
  for (let i = 0; i < list.length; i++) {
    if (list[i]! > list[i + 1]!) return false
  }
  return true
}
console.log(sorted([1, 2, 3]), sorted([1, 3, 2]), sorted([]))
