function assertNear(o: Near | null | undefined) { return o!.x; }
// @ts-expect-error
function readNearInTry(o: Near | null | undefined) { try { return o.x; } catch (error) { return "caught " + (error as Error).message; } }
// @ts-expect-error
function storeNearInTry(o: Near | null | undefined) { try { o.x = 1; return o.x; } catch (error) { return "caught " + (error as Error).message; } }
// @ts-expect-error
function callNearInTry(o: Near | null | undefined) { try { return o.m(); } catch (error) { return "caught " + (error as Error).message; } }
// @ts-expect-error
function iterateNearInTry(o: Near | null | undefined) { try { let sum = 0; for (const v of o) sum += v; return sum; } catch (error) { return "caught " + (error as Error).message; } }
function assertNearInTry(o: Near | null | undefined) { try { return o!.x; } catch (error) { return "caught " + (error as Error).message; } }

// @ts-expect-error
function readFar(o: Far | null | undefined) { return o.last; }
// @ts-expect-error
function storeFar(o: Far | null | undefined) { o.last = 1; return o.last; }
// @ts-expect-error
function callFar(o: Far | null | undefined) { return o.m(); }
// @ts-expect-error
function iterateFar(o: Far | null | undefined) { let sum = 0; for (const v of o) sum += v; return sum; }
function assertFar(o: Far | null | undefined) { return o!.last; }
// @ts-expect-error
function readFarInTry(o: Far | null | undefined) { try { return o.last; } catch (error) { return "caught " + (error as Error).message; } }
// @ts-expect-error
function storeFarInTry(o: Far | null | undefined) { try { o.last = 1; return o.last; } catch (error) { return "caught " + (error as Error).message; } }
// @ts-expect-error
function callFarInTry(o: Far | null | undefined) { try { return o.m(); } catch (error) { return "caught " + (error as Error).message; } }
// @ts-expect-error
function iterateFarInTry(o: Far | null | undefined) { try { let sum = 0; for (const v of o) sum += v; return sum; } catch (error) { return "caught " + (error as Error).message; } }
function assertFarInTry(o: Far | null | undefined) { try { return o!.last; } catch (error) { return "caught " + (error as Error).message; } }

function outcomeNear(run: (o: Near | null | undefined) => unknown, value: Near | null | undefined): string {
  try { return "ok " + run(value); } catch (error) { return (error as Error).name + ": " + (error as Error).message; }
}

function outcomeFar(run: (o: Far | null | undefined) => unknown, value: Far | null | undefined): string {
  try { return "ok " + run(value); } catch (error) { return (error as Error).name + ": " + (error as Error).message; }
}

function printOutcomes(label: string, cold: string, hot: string) {
  console.log(label + ": " + cold);
  if (hot !== cold) console.log(label + " in a hot loop: " + hot);
}

function reportNear(label: string, run: (o: Near | null | undefined) => unknown, value: Near | null | undefined) {
  const cold = outcomeNear(run, value);
  let hot = cold;
  for (let i = 0; i < 2000; i++) hot = outcomeNear(run, value);
  printOutcomes(label, cold, hot);
}

function reportFar(label: string, run: (o: Far | null | undefined) => unknown, value: Far | null | undefined) {
  const cold = outcomeFar(run, value);
  let hot = cold;
  for (let i = 0; i < 2000; i++) hot = outcomeFar(run, value);
  printOutcomes(label, cold, hot);
}

const near: [string, (o: Near | null | undefined) => unknown][] = [["read", readNear], ["store", storeNear], ["call", callNear], ["iterate", iterateNear], ["assert", assertNear], ["read in try", readNearInTry], ["store in try", storeNearInTry], ["call in try", callNearInTry], ["iterate in try", iterateNearInTry], ["assert in try", assertNearInTry]];
const far: [string, (o: Far | null | undefined) => unknown][] = [["read", readFar], ["store", storeFar], ["call", callFar], ["iterate", iterateFar], ["assert", assertFar], ["read in try", readFarInTry], ["store in try", storeFarInTry], ["call in try", callFarInTry], ["iterate in try", iterateFarInTry], ["assert in try", assertFarInTry]];

for (const [name, run] of near) for (const value of [new Near(), null, undefined]) reportNear("near " + name + " of " + (value && "object"), run, value);
for (const [name, run] of far) for (const value of [new Far(), null, undefined]) reportFar("far " + name + " of " + (value && "object"), run, value);
console.log("far fields: " + new Far().sumOfFields());

const emptyNear = new Near();
(emptyNear as any).x = undefined;
const emptyFar = new Far();
(emptyFar as any).last = undefined;
reportNear("near read of undefined field", readNear, emptyNear);
reportNear("near assert of undefined field", assertNear, emptyNear);
reportNear("near read in try of undefined field", readNearInTry, emptyNear);
reportFar("far read of undefined field", readFar, emptyFar);
reportFar("far assert of undefined field", assertFar, emptyFar);
reportFar("far read in try of undefined field", readFarInTry, emptyFar);
//// nullable-numbers-arrive-boxed.ts
// A parameter, a result, a property of type `number | undefined`, `number | null` or all three, given by code that says nothing about types: integers, doubles, NaN, -0, the infinities, undefined, null.

const lines: string[] = [];
function show(n: number | undefined | null): string { return n === undefined ? "undefined" : n === null ? "null" : Object.is(n, -0) ? "-0" : String(n); }
function optional(n?: number): string { return show(n); }
function orNull(n: number | null): string { return show(n); }
function either(n: number | undefined | null): string { return show(n); }
function sum(a: number | undefined, b: number | null, c?: number): number { return (a ?? 1) + (b ?? 2) + (c ?? 3); }
function handedOn(n: number | undefined): number | undefined { return n; }
function doubled(n: number | null): number | null { return n === null ? null : n * 2; }
function kept(n: number | undefined): { n: number | undefined } { return { n }; }

const numbers: unknown[] = [0, -0, 1, -1, 0.5, -2.75, 2147483647, -2147483648, 2147483648, 4294967296.5, 1e300, NaN, Infinity, -Infinity, Number.MIN_VALUE];
const byValue: Record<string, (...given: any[]) => unknown> = { optional, orNull, either, sum, handedOn, doubled, kept };
for (const n of numbers) {
    lines.push([byValue.optional(n), byValue.orNull(n), byValue.either(n), show(byValue.handedOn(n) as number), show(byValue.doubled(n) as number), show((byValue.kept(n) as { n: number }).n), show(byValue.sum(n, n, n) as number)].join(" "));
}
lines.push([byValue.optional(undefined), byValue.optional(), byValue.orNull(null), byValue.either(undefined), byValue.either(null), byValue.either()].join(" "));
lines.push([byValue.sum(undefined, null), byValue.sum(undefined, null, undefined), byValue.sum(1.5, null, 2), byValue.sum(undefined, 4, 0.25), show(byValue.handedOn(undefined) as undefined), show(byValue.doubled(null) as null)].join(" "));

const outside: any = JSON.parse('{"a":1,"b":2.5,"c":null,"e":-0.0,"f":1e21}');
function read(o: any, key: string): string { const n: number | undefined | null = o[key]; return show(n); }
lines.push(["a", "b", "c", "d", "e", "f"].map(key => read(outside, key)).join(" "));

let total = 0;
for (let i = 0; i < 3000; i++) total += byValue.sum(i & 1 ? i : undefined, i & 2 ? i + 0.5 : null, i & 4 ? -i : undefined) as number;
lines.push(String(total));
console.log(lines.join("\n"));
//// nullish-and-assignment-messages.ts
// The TypeError messages for reads and stores on null and undefined name the property. `x!` tests nothing. A store of another type to a typed field through `any` succeeds, and the next typed read of the field reports the value.
export {};
const box: any[] = JSON.parse("[0]");
function hidden(value: unknown): any { box[0] = value; return box[0]; }
function shown(value: unknown): string { return typeof value === "string" ? JSON.stringify(value) : String(value); }
function outcome(run: () => unknown): string {
  try { return "no error, " + shown(run()); } catch (error) { return (error as Error).name + ": " + (error as Error).message.replace(/ \(bun compile [^)]*\)/, ""); }
}

const key = Symbol("key");
for (const nothing of [null, undefined]) {
  console.log(nothing + ".p: " + outcome(() => hidden(nothing).p));
  console.log(nothing + "[0]: " + outcome(() => hidden(nothing)[0]));
  console.log(nothing + '["k"]: ' + outcome(() => hidden(nothing)["k"]));
  console.log(nothing + "[key]: " + outcome(() => hidden(nothing)[key]));
  console.log(nothing + ".p = 1: " + outcome(() => { hidden(nothing).p = 1; }));
  console.log(nothing + "?.p: " + outcome(() => hidden(nothing)?.p));
  console.log(nothing + "?.[0]: " + outcome(() => hidden(nothing)?.[0]));
}

function pick(index: number): number | string | null | undefined { return hidden([null, undefined, 0, ""])[index]; }
function assertedVariable(value: number | string | null | undefined): unknown { return value!; }
function assertedCall(index: number): unknown { return pick(index)!; }
for (const value of [null, undefined, 0, ""]) console.log(shown(value) + "!: " + outcome(() => assertedVariable(value)));
for (let index = 0; index < 4; index++) console.log("pick(" + index + ")!: " + outcome(() => assertedCall(index)));

class Counter { count: number = 0; label: string = "none"; }
function readCount(counter: Counter): number { return counter.count; }
function readLabel(counter: Counter): string { return counter.label; }

const byName = new Counter();
console.log("count = 5 by name: " + outcome(() => { hidden(byName).count = 5; }));
console.log("typed read of count: " + outcome(() => readCount(byName)));
console.log('count = "many" by name: ' + outcome(() => { hidden(byName).count = "many"; }));
console.log("typed read of count: " + outcome(() => readCount(byName)));
console.log("untyped read of count: " + outcome(() => hidden(byName).count));

const byKey = new Counter();
const labelKey: string = hidden("label");
console.log('label = "some" by key: ' + outcome(() => { hidden(byKey)[labelKey] = "some"; }));
console.log("typed read of label: " + outcome(() => readLabel(byKey)));
console.log("label = 7 by key: " + outcome(() => { hidden(byKey)[labelKey] = 7; }));
console.log("typed read of label: " + outcome(() => readLabel(byKey)));
console.log("untyped read of label: " + outcome(() => hidden(byKey)[labelKey]));
//// nullish-at-declared-types.ts
// Null and undefined pass the check of every declared type and stay what they are: a variable, cast, field, element, parameter or result declared `number`, `boolean` or `string` holds them as in plain Bun.
////= attempt
const hide = (v: unknown): any => v
attempt("variable, undefined as number", () => { const n: number = hide(undefined); return n + 1 })
attempt("variable, null as number", () => { const n: number = hide(null); return n + 1 })
attempt("variable, undefined as boolean", () => { const b: boolean = hide(undefined); return b ? "yes" : "no" })
attempt("variable, null as boolean", () => { const b: boolean = hide(null); return b === false })
attempt("as, undefined as number", () => (hide(undefined) as number) * 2)
attempt("as, null as number", () => (hide(null) as number) * 2)
attempt("as, undefined as boolean", () => (hide(undefined) as boolean) === undefined)
attempt("variable, null as number | undefined", () => { const u: number | undefined = hide(null); return u })
attempt("variable, undefined as boolean | null", () => { const x: boolean | null = hide(undefined); return x })
interface Rec { n: number; s: string; b: boolean }
const rec: Rec = { n: 1, s: "s", b: true }
function show(o: object): string { return Object.keys(o).join() + " " + JSON.stringify(o) }
attempt("field, undefined as number", () => { rec.n = hide(undefined) })
attempt("field, null as number", () => { rec.n = hide(null) })
attempt("field, null as boolean", () => { rec.b = hide(null) })
console.log(show(rec))
attempt("field of a literal, undefined as number", () => { const made: Rec = { n: hide(undefined), s: hide(null), b: true }; return show(made) })
// The elements of an array: the read is checked, and null and undefined pass that check too. In arithmetic undefined is NaN and null is 0.
const nums: number[] = [1.5, 2.5]
attempt("element, store of undefined", () => { nums[1] = hide(undefined) })
attempt("element, store of null", () => { nums[2] = hide(null) })
console.log(nums.length, JSON.stringify(nums))
attempt("element, undefined read in arithmetic", () => nums[1] + 1)
attempt("element, undefined read to a variable", () => { const n: number = nums[1]; return n })
attempt("element, null read", () => nums[2] + 1)
attempt("element, for of", () => { let s = 0; for (const n of nums) s += n; return s })
function plusOne(n: number): number { return n + 1 }
function withDefault(n: number = 10): number { return n + 1 }
function back(v: any): number { return v }
attempt("parameter, undefined", () => plusOne(hide(undefined)))
attempt("parameter, null", () => plusOne(hide(null)))
attempt("parameter with a default, undefined", () => withDefault(hide(undefined)))
attempt("parameter with a default, null", () => withDefault(hide(null)))
attempt("result, undefined", () => back(undefined))
attempt("result, null", () => back(null))
attempt("called through any, argument left out", () => (plusOne as any)())
attempt("called through any, null", () => (plusOne as any)(null))
attempt("called through any, parameter with a default, left out", () => (withDefault as any)())
attempt("called through any, parameter with a default, null", () => (withDefault as any)(null))
class Temp { constructor(public degrees: number, public unit: string = "C") {} text() { return this.degrees + this.unit } }
attempt("constructed through any, argument left out", () => new (Temp as any)().text())
attempt("constructed through any, null", () => new (Temp as any)(null, null).text())
attempt("captured variable", () => { let acc: number = 0; const set = (v: any) => { acc = v }; set(undefined); return acc })
attempt("variable in a loop", () => { let out = ""; for (const v of [1, undefined, 2] as any[]) { const n: number = v; out += (n + 1) + "," } return out })
// A string can be null or undefined. `+` of it and a number is a number then, where the type of the sum is string.
attempt("null as string, + 1", () => { const s: string = hide(null); return s + 1 })
attempt("undefined as string, + 1", () => { const s: string = hide(undefined); return s + 1 })
attempt("null as string, + null as string", () => { const s: string = hide(null), t: string = hide(null); return s + t })
//// nullish-in-non-nullable-types.ts
// Every way for `undefined` or `null` to get into a variable, property, parameter or result whose type is an object, string, array or function type that includes neither.
// Each behaves as in plain JavaScript. Each has its own types, with a property that no other has, so that one case does not change how the objects of another are stored.
function say(what: string, make: () => string): void { try { console.log(what + ":", make()); } catch (e) { console.log(what + ":", "throws", (e as Error).name); } }
const nothing: unknown = undefined;
const nullish: unknown = null;
interface Leaf1 { text: string; l1: number }
function leaf1(text: string): Leaf1 { return { text, l1: 1 }; }
interface Holder1 { h1: number; leaf: Leaf1; name: string; list: Leaf1[]; run: () => string }
function fresh1(): Holder1 { return { h1: 1, leaf: leaf1("t"), name: "n", list: [leaf1("l")], run: () => "r" }; }
function textOf1(h: Holder1): string { return h.leaf === undefined ? "no leaf" : h.leaf === null ? "null leaf" : h.leaf.text; }
function nameOf1(h: Holder1): string { return h.name === undefined ? "no name" : h.name === null ? "null name" : h.name; }
say("as made", () => { return textOf1(fresh1()) + nameOf1(fresh1()); });
interface Leaf2 { text: string; l2: number }
function leaf2(text: string): Leaf2 { return { text, l2: 2 }; }
interface Holder2 { h2: number; leaf: Leaf2; name: string; list: Leaf2[]; run: () => string }
function fresh2(): Holder2 { return { h2: 2, leaf: leaf2("t"), name: "n", list: [leaf2("l")], run: () => "r" }; }
function textOf2(h: Holder2): string { return h.leaf === undefined ? "no leaf" : h.leaf === null ? "null leaf" : h.leaf.text; }
function nameOf2(h: Holder2): string { return h.name === undefined ? "no name" : h.name === null ? "null name" : h.name; }
const leaves2: Leaf2[] = [leaf2("a")];
const names2: string[] = ["x"];
say("an element past the end", () => { const h = fresh2(); h.leaf = leaves2[5]; h.name = names2[7]; return textOf2(h) + nameOf2(h); });
interface Leaf3 { text: string; l3: number }
function leaf3(text: string): Leaf3 { return { text, l3: 3 }; }
interface Holder3 { h3: number; leaf: Leaf3; name: string; list: Leaf3[]; run: () => string }
function fresh3(): Holder3 { return { h3: 3, leaf: leaf3("t"), name: "n", list: [leaf3("l")], run: () => "r" }; }
function textOf3(h: Holder3): string { return h.leaf === undefined ? "no leaf" : h.leaf === null ? "null leaf" : h.leaf.text; }
function nameOf3(h: Holder3): string { return h.name === undefined ? "no name" : h.name === null ? "null name" : h.name; }
say("`as` on undefined", () => { const h = fresh3(); h.leaf = nothing as Leaf3; h.name = nothing as string; return textOf3(h) + nameOf3(h); });
interface Leaf4 { text: string; l4: number }
function leaf4(text: string): Leaf4 { return { text, l4: 4 }; }
interface Holder4 { h4: number; leaf: Leaf4; name: string; list: Leaf4[]; run: () => string }
function fresh4(): Holder4 { return { h4: 4, leaf: leaf4("t"), name: "n", list: [leaf4("l")], run: () => "r" }; }
function textOf4(h: Holder4): string { return h.leaf === undefined ? "no leaf" : h.leaf === null ? "null leaf" : h.leaf.text; }
function nameOf4(h: Holder4): string { return h.name === undefined ? "no name" : h.name === null ? "null name" : h.name; }
say("`as` on null", () => { const h = fresh4(); h.leaf = nullish as Leaf4; h.name = nullish as string; return textOf4(h) + nameOf4(h); });
interface Leaf5 { text: string; l5: number }
function leaf5(text: string): Leaf5 { return { text, l5: 5 }; }
interface Holder5 { h5: number; leaf: Leaf5; name: string; list: Leaf5[]; run: () => string }
function fresh5(): Holder5 { return { h5: 5, leaf: leaf5("t"), name: "n", list: [leaf5("l")], run: () => "r" }; }
function textOf5(h: Holder5): string { return h.leaf === undefined ? "no leaf" : h.leaf === null ? "null leaf" : h.leaf.text; }
function nameOf5(h: Holder5): string { return h.name === undefined ? "no name" : h.name === null ? "null name" : h.name; }
say("a store through any", () => { const h = fresh5(); const loose: any = h; loose.leaf = undefined; loose.name = null; return textOf5(h) + nameOf5(h); });
interface Leaf6 { text: string; l6: number }
function leaf6(text: string): Leaf6 { return { text, l6: 6 }; }
interface Holder6 { h6: number; leaf: Leaf6; name: string; list: Leaf6[]; run: () => string }
function fresh6(): Holder6 { return { h6: 6, leaf: leaf6("t"), name: "n", list: [leaf6("l")], run: () => "r" }; }
function textOf6(h: Holder6): string { return h.leaf === undefined ? "no leaf" : h.leaf === null ? "null leaf" : h.leaf.text; }
function nameOf6(h: Holder6): string { return h.name === undefined ? "no name" : h.name === null ? "null name" : h.name; }
say("a store by a computed key", () => { const h = fresh6(); const loose: any = h; loose[["le", "af"].join("")] = undefined; return textOf6(h); });
interface Leaf7 { text: string; l7: number }
function leaf7(text: string): Leaf7 { return { text, l7: 7 }; }
interface Holder7 { h7: number; leaf: Leaf7; name: string; list: Leaf7[]; run: () => string }
function fresh7(): Holder7 { return { h7: 7, leaf: leaf7("t"), name: "n", list: [leaf7("l")], run: () => "r" }; }
function textOf7(h: Holder7): string { return h.leaf === undefined ? "no leaf" : h.leaf === null ? "null leaf" : h.leaf.text; }
function nameOf7(h: Holder7): string { return h.name === undefined ? "no name" : h.name === null ? "null name" : h.name; }
interface Outer7 { inner: Holder7 }
say("a store to what an object holds, through any", () => { const o: Outer7 = { inner: fresh7() }; const loose: any = o; loose.inner.leaf = null; return textOf7(o.inner); });
interface Leaf8 { text: string; l8: number }
function leaf8(text: string): Leaf8 { return { text, l8: 8 }; }
interface Holder8 { h8: number; leaf: Leaf8; name: string; list: Leaf8[]; run: () => string }
function fresh8(): Holder8 { return { h8: 8, leaf: leaf8("t"), name: "n", list: [leaf8("l")], run: () => "r" }; }
function textOf8(h: Holder8): string { return h.leaf === undefined ? "no leaf" : h.leaf === null ? "null leaf" : h.leaf.text; }
function nameOf8(h: Holder8): string { return h.name === undefined ? "no name" : h.name === null ? "null name" : h.name; }
say("Object.assign", () => { const h = fresh8(); Object.assign(h, { leaf: undefined }); return textOf8(h); });
interface Leaf9 { text: string; l9: number }
function leaf9(text: string): Leaf9 { return { text, l9: 9 }; }
interface Holder9 { h9: number; leaf: Leaf9; name: string; list: Leaf9[]; run: () => string }
function fresh9(): Holder9 { return { h9: 9, leaf: leaf9("t"), name: "n", list: [leaf9("l")], run: () => "r" }; }
function textOf9(h: Holder9): string { return h.leaf === undefined ? "no leaf" : h.leaf === null ? "null leaf" : h.leaf.text; }
