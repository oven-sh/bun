//// optional-chain-in-try.ts
// The read at the end of an optional chain is held to its type. The chain as a whole may yield undefined, also in a try, where every operation that may throw ends a block.
declare const console: { log(...values: unknown[]): void };
class Inner { id: number; constructor(id: number) { this.id = id; } }
interface Outer { inner: Inner | null; list: number[] | null; call: (() => number) | null }
function hide(v: unknown): any { return v; }
const outside: Inner = hide({ id: 5 });
function inATry(p: Outer): string {
  try { return [p.inner?.id, p.inner?.id ?? -1, p.list?.[0], p.list?.length, p.call?.()].join(); } catch (e) { return "caught " + (e as Error).name + ": " + (e as Error).message.replace(/ \(bun compile[^]*$/, ""); }
}
function outsideOfOne(p: Outer): string { return [p.inner?.id, p.inner?.id ?? -1, p.list?.[0], p.list?.length, p.call?.()].join(); }
function kept(p: Outer): unknown { try { const id = p.inner?.id; return id; } catch (e) { return "caught " + (e as Error).name; } }
function inAFinally(p: Outer): unknown { try { return 0; } finally { console.log("finally", p.inner?.id); } }
for (const p of [{ inner: null, list: null, call: null }, { inner: new Inner(1), list: [7], call: () => 3 }, { inner: outside, list: [], call: null }] as Outer[]) {
  console.log(inATry(p)); console.log(outsideOfOne(p)); console.log(kept(p)); inAFinally(p);
}
//// optional-method-on-prototype-chain.ts
// An optional method such as `toString?` that is absent on the object is found on `Object.prototype`.
interface Printable { id: number; toString?: () => string }
const plain: Printable = { id: 1 }
console.log(typeof plain.toString, plain.toString === Object.prototype.toString, plain.toString?.())
try { console.log(plain.toString!()); console.log("the absent field called: no error") } catch (e) { console.log("the absent field called:", e instanceof TypeError ? "TypeError" : "other " + e) }
// Generic code asks the chain.
function untyped(o: any): string { return typeof o.toString }
console.log(untyped(plain), String(plain), `${plain}`)
// Present, it is the field.
plain.toString = () => "own"
console.log(typeof plain.toString, plain.toString(), String(plain))
//// overlapping-object-types.ts
// Objects of two unrelated types are read through a third type in which all their fields are optional.
type AB = { a: number; b: boolean }
type CD = { c: string; d: number[] }
interface MaybeAll { a?: number; b?: boolean; c?: string; d?: number[]; e?: number }
const ab: AB = { a: 1, b: true }
const cd: CD = { c: "cd", d: [3] }
const none: MaybeAll = {}
const maybes: MaybeAll[] = [ab, cd, none]
for (const m of maybes) { m.e ??= 5; m.c ??= "late"; m.a ??= 0.5 }
try { console.log(maybes.map(m => Object.keys(m).join("")).join()) } catch (e) { console.log("line 10:", e instanceof TypeError ? "TypeError" : "other " + e) }
for (const m of maybes) {
  try { delete m.c; console.log("delete c: no error") } catch (e) { console.log("delete c:", e instanceof TypeError ? "TypeError" : "other " + e) }
  try { delete m.a; console.log("delete a: no error") } catch (e) { console.log("delete a:", e instanceof TypeError ? "TypeError" : "other " + e) }
}
try { console.log(maybes.map(m => Object.keys(m).join("")).join(), ab.a + 1, cd.c.length) } catch (e) { console.log("line 15:", e instanceof TypeError ? "TypeError" : "other " + e) }
//// overload-results-of-invariant-generic-records.ts
// A generic overload over an implementation that is typed with `unknown`. The record type is invariant in its type parameter: the parameter
// stands in a parameter of a function-typed property. So the record that the implementation makes is neither a subtype nor a supertype of
// the record type that the call expects, and it cannot become that type in place: its method reads `this`.
const say = (label: string, f: () => unknown): void => { let r: string; try { r = String(f()); } catch (e) { r = "throws " + (e as Error).name; } console.log(label + " ==> " + r); };

interface Counter<T> { value: T; readonly set: (next: T) => void }
function counter<T>(value: T): Counter<T>;
function counter(value: unknown): Counter<unknown> { return { value, set(next) { this.value = next; } }; }
const writtenCounter: Counter<number> = { value: 1, set: next => {} };
say("a primitive parameter, and no other use of the type", () => { const count = counter(0); count.set(41); return count.value + 1 + writtenCounter.value; });

interface Store<T> { value: T; readonly set: (next: T) => void }
function store<T>(value: T): Store<T>;
function store(value: unknown): Store<unknown> { return { value, set(next) { this.value = next; } }; }
const written: Store<number> = { value: 1, set: next => {} };
const writtenText: Store<string> = { value: "w", set: next => {} };
const read = (from: Store<number>) => from.value + 1;
class Holder { held: Store<number> = written; }

say("a primitive parameter", () => { const count = store(0); count.set(41); return count.value + 1 + written.value; });
say("type arguments are written", () => { const count = store<number>(0); count.set(41); return count.value + 1; });
say("two instantiations", () => { const count = store(1); const text = store("a"); text.set("b"); return count.value + 1 + text.value + writtenText.value; });
say("it stays one object", () => { const count = store(0); const same: Store<number> = count; same.set(5); return (count === same) + " " + count.value; });
say("passed to a function", () => read(store(1)) + read(written));
say("each store keeps its own method", () => { const all: Store<number>[] = [store(1), written, store(2)]; for (const each of all) each.set(9); return all.map(each => each.value).join(); });
say("in an array", () => { const all: Store<number>[] = [store(1), written, store(2)]; let sum = 0; for (const each of all) sum += each.value; return sum; });
say("in a field", () => { const holder = new Holder(); holder.held = store(6); holder.held.set(7); return holder.held.value + 1; });
say("its keys", () => Object.keys(store(0)).join());

interface Fold<Out> { readonly run: (box: { value: Out }) => boolean; readonly initial: Out }
function fold<Out>(initial: Out): Fold<Out>;
function fold(initial: unknown): Fold<unknown> { return { initial, run(box) { return box.value === this.initial; } }; }
const other = { initial: 0, run: box => box.value === 100 } satisfies Fold<number>;

say("a record parameter", () => { const step = fold<number>(0); return step.initial + 1 + " " + other.run({ value: 1 }); });
say("the method is called with a record", () => { const step = fold<number>(0); return step.run({ value: 0 }) + " " + step.run({ value: 1 }); });
say("each record keeps its own method", () => { const both: Fold<number>[] = [fold<number>(0), other, fold<number>(100)]; return both.map(each => each.run({ value: 0 }) + "" + each.run({ value: 100 })).join(); });

interface Cell<T> { value: T; readonly set: (next: T) => void }
function cell<T>(value: T): Cell<T> { return { value, set(next) { this.value = next; } }; }
const writtenCell: Cell<number> = { value: 1, set: next => {} };
say("one signature, nothing unverified", () => { const count = cell(0); count.set(41); return count.value + 1 + writtenCell.value; });

interface Rule<T, M extends string | undefined> { value: T; readonly message: M; readonly set: (next: T) => void }
function rule<T>(value: T): Rule<T, undefined>;
function rule<T, const M extends string | undefined>(value: T, message: M): Rule<T, M>;
function rule(value: unknown, message?: string): Rule<unknown, string | undefined> { return { value, message, set(next) { this.value = next; } }; }
const writtenRule: Rule<number, undefined> = { value: 1, message: undefined, set: next => {} };
say("the overload promises undefined where the implementation says string or undefined", () => { const count = rule(0); count.set(41); return count.value + 1 + " " + count.message + " " + writtenRule.value; });
say("the overload promises a literal where the implementation says string or undefined", () => { const count = rule(0, "m"); count.set(41); return count.value + 1 + count.message; });
//// own-property-shadows-method-computed-key.ts
// An own property with the name of a method of the object's class, stored by a computed key, shadows the method.
interface Speaker { id: number; speak(greeting: string): string }
class ClassSpeaker implements Speaker {
  constructor(public id: number) {}
  speak(greeting: string): string { return greeting + " class " + this.id }
}
const c = new ClassSpeaker(21)
const names: string[] = ["speak"]
try { (c as any)[names[0]] = () => "replaced"; console.log("own property named like a method: no error") } catch (e) { console.log("own property named like a method:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(c.speak("still"), Object.keys(c).join())
// What the name holds, bound to the object, is stored through the typed reference.
try { c.speak = c.speak.bind(c); console.log("the method bound to the object: no error") } catch (e) { console.log("the method bound to the object:", e instanceof TypeError ? "TypeError" : "other " + e) }
const free = c.speak
console.log(free("bound"))
//// parameter-typed-by-default-external-data.ts
// A parameter without an annotation takes its type from its default value. That type is inferred, so an argument that is external data of another type must behave as in plain JavaScript.
const data = JSON.parse('{"t":"abc","s":5}') as { t: number; s: string };
const say = (label: string, f: () => unknown): void => { let r: string; try { const v = f(); r = typeof v + " " + String(v); } catch (e) { r = "throws " + (e as Error).constructor.name; } console.log(label + " ==> " + r); };
const arrow = (p = 1) => p + 1;
function declared(p = 1, q = 2) { return p + q; }
const text = (p = "z") => p + p;
class Holder { method(p = 1) { return p * 2; } static fixed(p = 1) { return p + 1; } }
class Built { v; constructor(p = 1) { this.v = p; } }
class Kept { constructor(public v = 1) {} }
say("an arrow function", () => arrow(data.t));
say("called at once", () => ((p = 1) => p + 1)(data.t));
say("a declaration, the first parameter", () => declared(data.t));
say("a declaration, the second parameter", () => declared(1, data.t));
say("a string default", () => text(data.s));
say("a method", () => new Holder().method(data.t));
say("a static method", () => Holder.fixed(data.t));
say("a constructor parameter", () => new Built(data.t).v + 1);
say("a parameter property", () => new Kept(data.t).v + 1);
say("through a variable", () => { const v = data.t; return arrow(v); });
say("the default itself", () => arrow() + declared());
say("trusted arguments stay exact", () => arrow(2) + declared(3, 4) + new Holder().method(5));
//// parsed-json-missing-or-null-fields.ts
// Parsed JSON is cast to a type although required fields are missing or hold null: a missing field reads undefined, and undefined and null pass every written type, so nothing throws.
////= attempt
interface P { x: number; label: string; ok: boolean; opt?: number; child: { v: number } }
attempt("nothing", () => (JSON.parse("{}") as P).x)
attempt("a required number is missing", () => (JSON.parse('{"label":"l","ok":true,"child":{"v":1}}') as P).label)
attempt("a required string is missing", () => (JSON.parse('{"x":1,"ok":true,"child":{"v":1}}') as P).x)
attempt("a required object is missing", () => (JSON.parse('{"x":1,"label":"l","ok":true}') as P).x)
attempt("null for a number", () => (JSON.parse('{"x":null,"label":"l","ok":true,"child":{"v":1}}') as P).label)
attempt("null for a boolean", () => (JSON.parse('{"x":1,"label":"l","ok":null,"child":{"v":1}}') as P).label)
attempt("null for an optional number", () => (JSON.parse('{"x":1,"label":"l","ok":true,"opt":null,"child":{"v":1}}') as P).label)
attempt("null for a number, one level down", () => (JSON.parse('{"x":1,"label":"l","ok":true,"child":{"v":null}}') as P).label)
attempt("null for a string and an object", () => { const p = JSON.parse('{"x":1,"label":null,"ok":true,"child":null}') as P; return p.label + "/" + p.child })
// The type of `child` does not include null, so `child?.v` is a number according to its type. An optional chain may still produce undefined, which passes every written type.
attempt("optional chain on a reference that is null against its type", () => (JSON.parse('{"x":1,"label":null,"ok":true,"child":null}') as P).child?.v)
attempt("the same into a number", () => { const v: number = (JSON.parse('{"x":1,"label":null,"ok":true,"child":null}') as P).child?.v; return v })
attempt("over null, empty", () => (Object.create(null) as P).x)
attempt("inherits the fields", () => (Object.create({ x: 1, label: "l", ok: true, child: { v: 1 } }) as P).x)
attempt("getters", () => (Object.defineProperty(JSON.parse('{"label":"l","ok":true,"child":{"v":1}}'), "x", { get() { return 1 }, enumerable: true, configurable: true }) as P).x)
attempt("an empty literal", () => ({} as P).x)
attempt("a proxy", () => new Proxy(JSON.parse('{"x":1,"label":"l","ok":true,"child":{"v":1}}') as P, {}).x)
// Arrays, tuples and maps: their contents are not guaranteed, the read is tested, and null and undefined pass the test.
const withNull = JSON.parse("[1,null,3]") as number[]
attempt("element, a number", () => withNull[0])
attempt("element, null for a number", () => withNull[1])
attempt("element, null for a number, into a number", () => { const n: number = withNull[1]; return n })
attempt("element, out of bounds, by itself", () => String(withNull[3]))
attempt("element, out of bounds, returned", () => withNull[3])
attempt("element, out of bounds, into a number", () => { const n: number = withNull[3]; return n })
attempt("for of", () => { let s = 0; for (const n of withNull) s += n; return s })
attempt("tuple, null for a number", () => { const t = JSON.parse("[null,2]") as [number, number]; return t[0] + t[1] })
const byKey = new Map<string, number>()
;(byKey as Map<string, any>).set("n", null).set("u", undefined)
attempt("Map.get, null for number | undefined", () => byKey.get("n"))
attempt("Map.get, null for number | undefined, into such a place", () => { const n: number | undefined = byKey.get("n"); return n })
attempt("Map.get, undefined", () => byKey.get("u"))
// Results of functions from outside.
const parse = JSON.parse as (text: string) => number
attempt("result, null for a number", () => parse("null"))
attempt("result, null for a number, into a number", () => { const n: number = parse("null"); return n })
attempt("result, a number", () => parse("1") + 1)
//// parsed-json-through-interfaces.ts
// Objects made by `JSON.parse` are used through declared interface types, with missing, extra and wrongly typed properties.
interface Address { city: string; zip?: string }
interface Person { id: number; nick: string; active: boolean; address: Address; tags: string[]; boss?: Person | null; score?: number }
const source = '{"nick":"ann","id":1,"extra":[1,2],"active":true,"address":{"zip":"123","city":"Oslo"},"tags":["a","b"],"boss":null}'
const raw = JSON.parse(source)
const parsed = raw as Person
console.log(parsed === raw, parsed.address === raw.address, parsed.tags === raw.tags, Object.keys(raw).join(), Object.keys(parsed).join())
parsed.score = 5; parsed.id++
console.log(JSON.stringify(parsed), raw.id, "score" in raw)
const tricky = JSON.parse('{"__proto__":{"id":9},"id":3,"nick":"t","active":false,"address":{"city":"c"},"tags":[]}') as Person
console.log(Object.keys(tricky).join(), tricky.id, Object.getPrototypeOf(tricky) === Object.prototype)
const rawList = JSON.parse("[" + source + "]"), first = rawList[0]
const list = rawList as Person[]
console.log(list === rawList, list[0] === first, rawList[0] === list[0])
const { address, extra, ...others } = list[0] as Person & { extra: number[] }
console.log(address.city, extra.length, JSON.stringify(others), JSON.stringify({ ...list[0], id: 50 }))
//// primitive-read-after-object-cast.ts
// `x as T` on an object tests only that `x` is an object. A property that holds another kind than T declares is found at the first typed read of that property, which throws a TypeError. null and undefined pass, a read through `any` and JSON.stringify test nothing, an element of a tuple is tested for the element types of the tuple together, which both values here fit, and nothing is ever converted: a cast that is written on a primitive of another kind throws too.
const own = (o: any): any => o;
const one = (x: unknown): string => x === undefined ? "<undefined>" : x === null ? "<null>" : typeof x === "number" ? (x !== x ? "<NaN>" : Object.is(x, -0) ? "<-0>" : String(x)) + ":number" : typeof x === "string" ? JSON.stringify(x) : typeof x === "bigint" ? x + "n" : typeof x === "object" ? JSON.stringify(x) : String(x) + ":" + typeof x;
const say = (label: string, f: () => unknown[]): void => { let r: string; try { r = f().map(one).join(" | "); } catch (e) { r = "throws " + (e as Error).constructor.name; } console.log(label + " ==> " + r); };
type N = { a: number }; type S = { a: string }; type B = { a: boolean }; type I = { a: bigint }; type O = { a?: number }; type U = { a: number | string }; type NU = { a: number | undefined }; type L = { a: 1 | 2 }; type A = { a: number[] }; type D = { a: { b: number } }; type T = { a: [number, string] };
say('number <- "1"', () => { const o = own({ a: "1" }); const r = o as N; return [r.a, o.a]; });
say('number <- "1", read twice', () => { const o = own({ a: "1" }); const r = o as N; return [r.a, r.a, r === o]; });
say('number <- "abc"', () => { const o = own({ a: "abc" }); const r = o as N; return [r.a, o.a]; });
say('number <- ""', () => { const o = own({ a: "" }); const r = o as N; return [r.a, o.a]; });
say('number <- " 12 "', () => { const o = own({ a: " 12 " }); const r = o as N; return [r.a, o.a]; });
say('number <- "0x10"', () => { const o = own({ a: "0x10" }); const r = o as N; return [r.a, o.a]; });
say("number <- true", () => { const o = own({ a: true }); const r = o as N; return [r.a, o.a]; });
say("number <- null", () => { const o = own({ a: null }); const r = o as N; return [r.a, o.a]; });
say("number <- undefined", () => { const o = own({ a: undefined }); const r = o as N; return [r.a, o.a]; });
say("number <- 5n", () => { const o = own({ a: 5n }); const r = o as N; return [r.a, o.a]; });
say("number <- [7]", () => { const o = own({ a: [7] }); const r = o as N; return [r.a, o.a]; });
say("number <- an object with valueOf", () => { const o = own({ a: { valueOf() { return 7; } } }); const r = o as N; return [r.a, typeof o.a]; });
say("number <- a Date", () => { const o = own({ a: new Date(5) }); const r = o as N; return [r.a, typeof o.a]; });
say("string <- 5", () => { const o = own({ a: 5 }); const r = o as S; return [r.a, o.a]; });
say("string <- true", () => { const o = own({ a: true }); const r = o as S; return [r.a, o.a]; });
say("string <- null", () => { const o = own({ a: null }); const r = o as S; return [r.a, o.a]; });
say("string <- [1, 2]", () => { const o = own({ a: [1, 2] }); const r = o as S; return [r.a, o.a]; });
say("boolean <- 0", () => { const o = own({ a: 0 }); const r = o as B; return [r.a, o.a]; });
say('boolean <- "x"', () => { const o = own({ a: "x" }); const r = o as B; return [r.a, o.a]; });
say('boolean <- "false"', () => { const o = own({ a: "false" }); const r = o as B; return [r.a, o.a]; });
say("bigint <- 5", () => { const o = own({ a: 5 }); const r = o as I; return [r.a, o.a]; });
say('bigint <- "5"', () => { const o = own({ a: "5" }); const r = o as I; return [r.a, o.a]; });
say('number? <- "1"', () => { const o = own({ a: "1" }); const r = o as O; return [r.a, o.a]; });
say('number | string <- "1"', () => { const o = own({ a: "1" }); const r = o as U; return [r.a, o.a]; });
say("number | string <- true", () => { const o = own({ a: true }); const r = o as U; return [r.a, o.a]; });
say('number | undefined <- "1"', () => { const o = own({ a: "1" }); const r = o as NU; return [r.a, o.a]; });
say('1 | 2 <- "1"', () => { const o = own({ a: "1" }); const r = o as L; return [r.a, o.a]; });
say("1 | 2 <- 3", () => { const o = own({ a: 3 }); const r = o as L; return [r.a, o.a]; });
say('number[] <- ["1", 2]', () => { const o = own({ a: ["1", 2] }); const r = o as A; return [r.a[0], r.a[1], o.a]; });
say('{ b: number } <- { b: "1" }', () => { const o = own({ a: { b: "1" } }); const r = o as D; return [r.a.b, o.a]; });
say('[number, string] <- ["1", 2]', () => { const o = own({ a: ["1", 2] }); const r = o as T; return [r.a[0], r.a[1], o.a]; });
say('number <- "1", frozen', () => { const o = own(Object.freeze({ a: "1" })); const r = o as N; return [r.a, o.a]; });
say('number <- "1", by a getter', () => { let n = 0; const o = own({ get a() { n++; return "1"; } }); const r = o as N; return [r.a, o.a, n]; });
say('number <- "1", by a getter and a setter', () => { const seen: unknown[] = []; let v: unknown = "1"; const o = own({ get a() { return v; }, set a(x) { seen.push(x); v = x; } }); const r = o as N; return [r.a, o.a, seen.length]; });
say('number <- "1", on the prototype', () => { const o = own(Object.create({ a: "1" })); const r = o as N; return [r.a, o.a, Object.keys(o).length]; });
say('number <- "1", a proxy', () => { const log: string[] = []; const o = own(new Proxy({ a: "1" }, { get(t, k, x) { log.push("get " + String(k)); return Reflect.get(t, k, x); }, set(t, k, v, x) { log.push("set " + String(k)); return Reflect.set(t, k, v, x); } })); const r = o as N; return [r.a, log.join()]; });
say('number <- "1", as unknown as', () => { const o = own({ a: "1" }); const r = o as unknown as N; return [r.a, o.a]; });
say('number <- "1", an annotated variable', () => { const o = own({ a: "1" }); const r: N = o; return [r.a, o.a]; });
say('number <- "1", an argument', () => { const o = own({ a: "1" }); const take = (r: N) => r.a; return [take(o), o.a]; });
say('number <- "1", satisfies behind as', () => { const o = own({ a: "1" }); const r = (o as N) satisfies N; return [r.a, o.a]; });
say('number <- "1", the cast not kept', () => { const o = own({ a: "1" }); void (o as N); return [o.a]; });
say('number <- "1", JSON afterwards', () => { const o = own({ a: "1" }); const r = o as N; return [JSON.stringify(r), JSON.stringify(o)]; });
say('the primitive itself: "1" as number', () => { const v = own("1"); return [v as number]; });
//// primitives-through-object-types-and-any.ts
// A primitive is passed through `any` as an object type that it does not satisfy: a number has no `length`.
////= attempt
const hide = (v: unknown): any => v
interface HasLength { length: number }
interface Fixable { toFixed(digits: number): string }
function lengthOf(x: HasLength): number { return x.length }
attempt("a number as { length }", () => { const h: HasLength = hide(5); return h.length })
attempt("a boolean as { toFixed }, typeof", () => { const h: Fixable = hide(true); return typeof h })
attempt("a boolean as { toFixed }, called", () => { const h: Fixable = hide(true); return h.toFixed(1) })
attempt("a number as an argument", () => (lengthOf as any)(5))
// What has the member passes.
attempt("a string as { length }", () => { const h: HasLength = hide("abc"); return h.length })
attempt("a number as { toFixed }", () => { const h: Fixable = hide(2); return h.toFixed(1) })
//// private-field-with-inferred-type-takes-any-value.ts
// A private field without a written type takes a value of any kind through `any`: an inferred type tests nothing. The field stays writable on a frozen object.
class P {
  #f = 1
  #m() { return "m" + this.#f }
  callM() { return this.#m() }
  static poke(o: any, v: number) { o.#f = v; return o.#f }
  static pokeString(o: any) { o.#f = "str"; return o.#f }
}
const p = new P()
try { console.log(P.pokeString(p)); console.log("a string stored to a private number field: no error") } catch (e) { console.log("a string stored to a private number field:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(p.callM(), P.poke(p, 7), p.callM())
// `#f` stays writable on a frozen object.
Object.freeze(p)
try { console.log(P.pokeString(p)); console.log("the same, frozen: no error") } catch (e) { console.log("the same, frozen:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(P.poke(p, 9), p.callM())
//// private-fields-external-data.ts
// A private field with an inferred type that holds external data of another type: reading it must behave as in plain JavaScript.
const data = JSON.parse('{"t":"abc"}') as { t: number };
const say = (label: string, f: () => unknown): void => { let r: string; try { const v = f(); r = typeof v + " " + String(v); } catch (e) { r = "throws " + (e as Error).constructor.name; } console.log(label + " ==> " + r); };
class Private { #v = data.t; sum() { return this.#v + 1; } read() { return this.#v; } }
class PrivateAssigned { #v = 0; load() { this.#v = data.t; return this; } sum() { return this.#v + 1; } }
class List { #all = [1]; add() { this.#all.push(data.t); return this; } last() { return this.#all[1] + 1; } }
say("a private field, used inside", () => new Private().sum());
say("a private field, returned", () => new Private().read() + 1);
say("a private field assigned in a method", () => new PrivateAssigned().load().sum());
say("a static private field", () => { class PrivateStatic { static #v = data.t; static sum() { return PrivateStatic.#v + 1; } } return PrivateStatic.sum(); });
say("a private array", () => new List().add().last());
//// private-members-via-another-type.ts
// `private` and `protected` are words for the type checker: at run time the object has the member. A test reaches it with
// `x as unknown as Internals`, also where the function that casts knows the object only as `object`.
class Base {
  protected id = 1
  describe() { return "base " + this.id }
}
class Screen extends Base {
  private frames = 0
  private log: string[] = []
  private size = { columns: 80, rows: 24 }
  private last?: { text: string }
  readonly name: string
  constructor(name: string, private readonly options: { debug: boolean }) { super(); this.name = name }
  private flush() { return ++this.frames }
  render(text: string) { this.log.push(text); this.last = { text }; return this.flush() }
}
function attempt(label: string, f: () => unknown) {
  try { console.log(label + ":", String(f())) } catch (e) { console.log(label + ":", e instanceof TypeError ? "TypeError" : "other " + e) }
}
const screen = new Screen("main", { debug: true })
screen.render("a")

type SameType = { frames: number }
type Wider = { frames: unknown }
type Union = { frames: number | string }
type Readonly = { readonly frames: number }
type Part = { size: { columns: number } }
type Whole = { size: unknown }
type Optional = { last?: { text: string } }
type Parameter = { options: { debug: boolean } }
type Method = { flush(): number }
type Inherited = { id: unknown }
type Several = { frames: unknown; log: unknown; id: unknown; name: unknown }
type ScreenInternals = { frames: number; log: string[]; readonly name: string; render(text: string): number }
function sameType(thing: object): SameType { return thing as unknown as SameType }
function wider(thing: object): Wider { return thing as unknown as Wider }
function union(thing: object): Union { return thing as unknown as Union }
function readonly(thing: object): Readonly { return thing as unknown as Readonly }
function part(thing: object): Part { return thing as unknown as Part }
function whole(thing: object): Whole { return thing as unknown as Whole }
function optional(thing: object): Optional { return thing as unknown as Optional }
function parameter(thing: object): Parameter { return thing as unknown as Parameter }
function method(thing: object): Method { return thing as unknown as Method }
function inherited(thing: object): Inherited { return thing as unknown as Inherited }
function several(thing: object): Several { return thing as unknown as Several }
function internals(thing: object): ScreenInternals { return thing as unknown as ScreenInternals }
attempt("by its own type", () => sameType(screen).frames)
attempt("by a wider type", () => wider(screen).frames)
attempt("by a union", () => union(screen).frames)
attempt("readonly", () => readonly(screen).frames)
attempt("a part of an object", () => part(screen).size.columns)
attempt("an object as unknown", () => typeof whole(screen).size)
attempt("optional", () => optional(screen).last?.text)
attempt("a parameter property", () => parameter(screen).options.debug)
attempt("a private method", () => method(screen).flush())
attempt("protected, inherited", () => inherited(screen).id)
attempt("several", () => { const all = several(screen); return [all.frames, all.log, all.id, all.name] })
attempt("private and public", () => { const inner = internals(screen); return [inner.frames, inner.log, inner.name, inner.render("b"), inner.frames] })

// A store through the other type is seen by the class.
attempt("a store", () => { internals(screen).frames = 10; return screen.render("c") })
attempt("a store through the wider type", () => { wider(screen).frames = 20; return screen.render("d") })

// Where the class is known.
class Panel {
  private rows = 3
  private title = "panel"
  grow() { return ++this.rows }
}
type PanelInternals = { rows: number; title: unknown }
function ofPanel(panel: Panel): PanelInternals { return panel as unknown as PanelInternals }
attempt("the class is known", () => { const panel = new Panel(); const inner = ofPanel(panel); inner.rows = 7; return [panel.grow(), inner.rows, inner.title] })

// A member of another type is still refused.
type Wrong = { frames: string }
function wrong(thing: object): Wrong { return thing as unknown as Wrong }
attempt("a private member of another type", () => wrong(screen).frames.length)
//// private-name-in-interface-after-ts-ignore.ts
// Plain Bun rejects a private name in an interface while parsing, so `@ts-ignore` does not suppress the error in a compiled file.
interface Shape {
  // @ts-ignore
  #name: number;
}
console.log("never printed");
export {};
//// private-name-in-operator.js
// `#a in o` inside the class that declares `#a` is valid JavaScript. The build accepts it, and it answers without throwing.
class A {
  #a = 1;
  static has(o) { return #a in o; }
}
console.log(A.has(new A()));
console.log(A.has({}));
//// private-name-outside-class.js
// A private name outside every class body is an ECMAScript early error, so it stops the build in a JavaScript file too.
const o = {};
console.log(#a in o);
