//// structural-class-types.ts
// A method is borrowed for object literals that have only the fields the method reads.
class Vec {
  x: number; y: number
  constructor(x: number, y: number) { this.x = x; this.y = y }
  len2(): number { return this.x * this.x + this.y * this.y }
  get sum(): number { return this.x + this.y }
}
const real = new Vec(1, 2)
try { const made: Vec = Object.create(Vec.prototype); made.x = 5; console.log("Object.create(C.prototype) as a C: no error") } catch (e) { console.log("Object.create(C.prototype) as a C:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { const heir: Vec = Object.create(real); console.log("heir of an instance as a C: no error", heir.x) } catch (e) { console.log("heir of an instance as a C:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { const parsed = JSON.parse('{"y":9,"x":8}') as Vec; console.log("parsed text without the methods as a C: no error", parsed.x) } catch (e) { console.log("parsed text without the methods as a C:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { const copied: Vec = Object.assign({}, real); console.log("copy of the own properties as a C: no error", copied.x) } catch (e) { console.log("copy of the own properties as a C:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { console.log(Vec.prototype.len2.call({ x: 2, y: 3 })); console.log("method on a literal with the fields it reads: no error") } catch (e) { console.log("method on a literal with the fields it reads:", e instanceof TypeError ? "TypeError" : "other " + e) }
const getSum = Object.getOwnPropertyDescriptor(Vec.prototype, "sum")!.get!
try { console.log(getSum.call({ x: 1, y: 1 })); console.log("getter on a literal with the fields it reads: no error") } catch (e) { console.log("getter on a literal with the fields it reads:", e instanceof TypeError ? "TypeError" : "other " + e) }
const borrowed = { x: 0.5, y: 0.25, len2: Vec.prototype.len2 }
try { console.log(borrowed.len2()); console.log("method borrowed by a literal: no error") } catch (e) { console.log("method borrowed by a literal:", e instanceof TypeError ? "TypeError" : "other " + e) }
try { (real as any).len2 = () => 999; console.log("own property in place of a method: no error") } catch (e) { console.log("own property in place of a method:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(real.len2(), real.sum, getSum.call(real), Object.keys(real).join())
//// subclass-checked-against-interface.ts
// An object made with `Object.create` from an object of an interface type is held to that type: it finds every field on its prototype chain, so it satisfies the type. It stays the object it is and is read by name. An own property of another kind that shadows a field throws where typed code reads the field.
interface Conf { host: string; port: number; secure?: boolean; nested: { depth: number } }
function rule(label: string, f: () => unknown) { try { console.log(label + ": no error", String(f())) } catch (e) { console.log(label + ":", e instanceof TypeError ? "TypeError" : "other " + e) } }
function next(c: Conf): number { return c.port + 1 + c.nested.depth }
const defaults: Conf = { host: "localhost", port: 80, nested: { depth: 1 } }
rule("heir of an object of the type", () => { const derived: Conf = Object.create(defaults); return derived.port })
rule("then: typed code reads it", () => { const derived: Conf = Object.create(defaults); return next(derived) })
rule("then: a store makes an own property", () => { const derived: Conf = Object.create(defaults); derived.port = 81; return [derived.port, defaults.port, Object.keys(derived).join(), next(derived)] })
rule("then: the parent changes", () => { const derived: Conf = Object.create(defaults); defaults.port = 90; const seen = derived.port; defaults.port = 80; return seen })
rule("then: an ill-typed own property shadows", () => { const raw = Object.create(defaults); raw.port = "text"; const derived: Conf = raw; return [typeof derived.port, next(derived)] })
rule("heir of a frozen literal", () => { const locked: Conf = Object.create(Object.freeze({ host: "frozen", port: 1, nested: { depth: 2 } })); return next(locked) })
//// sum-of-two-missing-strings.ts
// `a + b` where TypeScript says both are strings and both are missing at run time is NaN, or 0 for two nulls, as in plain Bun: it does not throw.
const none: string[] = [];
const some: string[] = ["a", "b"];
function show(name: string, f: () => unknown) { try { console.log(name, String(f())); } catch (e) { console.log(name, "threw", (e as Error).constructor.name); } }

function inOneExpression(list: string[], i: number) { return list[i] + list[i + 1]; }
function constants(list: string[], i: number) { const a = list[i], b = list[i + 1]; return a + b; }
function parameters(a: string, b: string) { return a + b; }
function passed(list: string[], i: number) { return parameters(list[i], list[i + 1]); }
function fields(list: string[], i: number) { const o = { a: list[i], b: list[i + 1] }; return o.a + o.b; }
function dictionary(map: Record<string, string>) { return map.a + map.b; }
function pattern(list: string[]) { const [a, b] = list; return a + b; }
function popped(list: string[]) { return list.pop()! + list.pop()!; }
function nulls(a: string, b: string) { return a + b; }
function three(list: string[], i: number) { return list[i] + list[i + 1] + list[i + 2]; }
function thenText(list: string[], i: number) { return list[i] + list[i + 1] + "!"; }
function textFirst(list: string[], i: number) { return "!" + list[i] + list[i + 1]; }
function withNumber(list: string[], i: number) { const a = list[i]; return a + 1; }
class Pair { constructor(public first: string, public second: string) {} joined() { return this.first + this.second; } }

for (const list of [none, some]) {
  show("in one expression", () => inOneExpression(list, 0));
  show("constants", () => constants(list, 0));
  show("parameters", () => passed(list, 0));
  show("fields", () => fields(list, 0));
  show("pattern", () => pattern(list));
  show("three", () => three(list, 0));
  show("then text", () => thenText(list, 0));
  show("text first", () => textFirst(list, 0));
  show("with a number", () => withNumber(list, 0));
  show("members of a class", () => new Pair(list[0], list[1]).joined());
}
show("dictionary", () => dictionary({}));
show("dictionary", () => dictionary({ a: "a", b: "b" }));
show("popped", () => popped([]));
show("popped", () => popped(["a", "b"]));
show("nulls", () => nulls(null as unknown as string, null as unknown as string));
show("null and undefined", () => nulls(null as unknown as string, undefined as unknown as string));
//// test-positions.ts
// A typed read is tested wherever it stands: under `typeof`, against `undefined` or a literal, in a condition, as a binding, an argument or an operand. A field that holds another kind throws a TypeError; one that is undefined, null or missing passes and goes on as it is.
interface Clock { origin: number; name: string; on: boolean; next: Clock; list: number[]; tick: () => number; big: bigint }
declare function fromHost(which: number): Clock;
const raws: any[] = [0, 1].map(() => JSON.parse('{"origin":1,"name":"n","on":true,"next":null,"list":[1],"tick":null,"big":null}'));
for (const raw of raws) { raw.next = raw; raw.tick = () => 7; raw.big = 5n; }
(globalThis as any).fromHost = (which: number) => raws[which];
const kept: Clock = fromHost(0), broken: Clock = fromHost(1);
{ const raw = raws[1]; raw.origin = undefined; raw.name = 5; raw.on = "yes"; raw.next = 0; delete raw.list; raw.tick = null; raw.big = ""; }
// The object under test. It goes from one place of type `Clock` to another, which asks only for an object.
let c: Clock = kept;
function attempt(label: string, f: () => unknown): void {
    const out: string[] = [];
    for (let which = 0; which < 2; which++) {
        c = which === 0 ? kept : broken;
        try { out.push(show(f())); } catch (e) { out.push((e as Error).constructor.name); }
    }
    console.log(label, out.join(" | "));
}
function show(v: unknown): string {
    return typeof v === "bigint" ? v + "n" : typeof v === "function" ? "fn" : typeof v === "object" && v !== null ? "obj" : typeof v === "string" ? JSON.stringify(v) : String(v);
}

// typeof
attempt("t typeof", () => [typeof c.origin, typeof c.name, typeof c.on, typeof c.next, typeof c.list, typeof c.tick, typeof c.big].join());
attempt("t typeof ===", () => typeof c.origin === "number" && typeof c.tick === "function");
attempt("t typeof through", () => [typeof (c.origin), typeof c.origin!, typeof (c.origin satisfies number), typeof (c.name)!].join());
attempt("a typeof as", () => [typeof (c.origin as number), typeof ((c.name as string)!), (c.on as boolean) === true].join());
// equality against undefined, null, a literal
attempt("t === undefined", () => [c.origin === undefined, c.list === undefined, undefined !== c.name, c.tick === undefined].join());
attempt("t === null", () => [c.tick === null, null === c.next, c.origin !== null].join());
attempt("t == null", () => [c.origin == null, c.tick == null, c.list != null, null == c.name, c.on == undefined].join());
attempt("t === literal", () => [c.origin === 1, c.name === "n", c.on === true, 5 === c.name as unknown, c.big === 5n, c.origin === -1, c.name !== "x", c.on === false].join());
attempt("t == literal", () => [c.origin == 1, c.name == "5", "" == c.big as unknown, c.on != true].join());
// conditions
attempt("t if", () => { if (c.origin) return "T"; return "F"; });
attempt("t if string", () => { if (c.name) return "T"; return "F"; });
attempt("t if boolean", () => { if (c.on) return "T"; return "F"; });
attempt("t if object", () => { if (c.next) return "T"; return "F"; });
attempt("t if through", () => { if ((c.list as number[])!) return "T"; return "F"; });
attempt("t ?:", () => (c.next ? "T" : "F") + (c.big ? "T" : "F"));
attempt("t while", () => { let n = 0; while (c.list && n < 2) n++; return n; });
attempt("t do", () => { let n = 0; do n++; while (c.origin && n < 2); return n; });
attempt("t for", () => { let n = 0; for (; c.next && n < 2; n++); return n; });
// !
attempt("t !", () => [!c.origin, !c.name, !c.on, !c.next, !c.list, !c.tick, !c.big].join());
attempt("t !!", () => [!!c.origin, !!c.list, Boolean(c.tick)].join());
// in, instanceof
attempt("t in", () => ["length" in (c.list ?? []), (c.name as unknown as string) in { n: 1, 5: 1 }].join());
attempt("t instanceof", () => [c.list instanceof Array, c.next instanceof Object, c.tick instanceof Function, (c.origin as unknown) instanceof Number].join());
// the left side of && and ||, in a condition and for its value
attempt("t && condition", () => { if (c.origin && c.on) return "T"; return "F"; });
attempt("t || condition", () => { if (c.list || c.next) return "T"; return "F"; });
attempt("t && falls through", () => c.list && "there");
attempt("t || falls through", () => c.origin || "none");
// the left side of ??, the receiver of ?.
attempt("t ??", () => [c.origin ?? "none", c.list ?? "none", c.tick ?? "none"].map(show).join());
attempt("t ?.", () => [c.list?.length, c.tick?.(), c.list?.[0]].join());
attempt("t ?. ??", () => c.list?.length ?? "none");
// an expression that forwards its operand
attempt("t ?: within typeof", () => typeof (c.on ? c.origin : c.name));
attempt("t || within typeof", () => [typeof (c.name || c.origin), typeof (c.big && c.on), typeof (c.name ?? c.on)].join());
attempt("t || within ===", () => (c.name || "x") === "n");
attempt("t , within if", () => { let n = 0; if ((n++, c.list)) return "T" + n; return "F" + n; });

// bindings, arguments, operands, results, receivers
attempt("h binding", () => { const t = c.origin; return typeof t === "number"; });
attempt("h argument", () => show(c.name));
attempt("h arithmetic", () => c.origin + 1);
attempt("h operand of an operand", () => { if (c.origin + 1) return "T"; return "F"; });
attempt("h === not a literal", () => c.origin === kept.origin);
attempt("h relational", () => c.origin < 2);
attempt("h return", () => c.on);
attempt("h receiver", () => c.list.length);
attempt("h call", () => c.tick());
attempt("h template", () => `${c.name}`);
// the left side of &&, || and ?? for its value
attempt("t && lets through", () => c.name && "x");
attempt("h && kept", () => c.big && "x");
attempt("h || kept", () => c.name || "none");
attempt("t || falls through, object", () => c.next || "none");
attempt("h ?? kept", () => c.name ?? "none");
attempt("h ?. receiver that is no object", () => c.next?.origin);
export {};
//// this-checked-on-entry.ts
// A method of an object literal is called, with `call`, on an object that does not match the type of its `this`.
type Box = { inner?: { value: number, get(): number } }
const full: Box = { inner: { value: 4, get() { return this.value + 1 } } }
try { (full.inner?.get)?.call({ value: 9 }); console.log("call on another object: no error") } catch (e) { console.log("call on another object:", e instanceof TypeError ? "TypeError" : "other " + e) }
//// throw-site-value-and-position.ts
// What a throw site reports, the value and the position, in a hot loop, in cold code and inside try. Values that fit print results.
interface Point { x: number }
function hide(v: unknown): any { return v }
function describeError(error: unknown): string {
  const e = error as Error
  const position = /:(\d+):(\d+)\)?\s*$/m.exec(e.stack ?? "")
  return e.name + ": " + e.message.split("\n")[0].replace(/ \(bun compile[^)]*\)/, "").replace(" | undefined", "") + " | " + (position ? position[1] + ":" + position[2] : "no position")
}
function describeErrorLine(error: unknown): string { return describeError(error).replace(/:\d+$/, "") }
function printResult(name: string, f: () => unknown): void { try { console.log(name, "|", String(f())) } catch (error) { console.log(name, "|", describeError(error)) } }
function printResultLine(name: string, f: () => unknown): void { try { console.log(name, "|", String(f())) } catch (error) { console.log(name, "|", describeErrorLine(error)) } }
function coldText(v: any): string { const t: string = v; return t }
function hotText(v: any, count: number): number { let total = 0; for (let i = 0; i < count; i++) { const t: string = v; total += t.length } return total }
function guardedText(v: any): unknown { try { const t: string = v; return t } catch (error) { return describeError(error) } }
function coldNumber(v: any): number { const n: number = v; return n }
function hotNumber(v: any, count: number): number { let total = 0; for (let i = 0; i < count; i++) { const n: number = v; total += n } return total }
function guardedNumber(v: any): unknown { try { const n: number = v; return n } catch (error) { return describeError(error) } }
function coldDouble(n: number): string { const hidden: any = n * 0.5; const t: string = hidden; return t }
function hotDouble(n: number, count: number): number { let total = 0; for (let i = 0; i < count; i++) { const hidden: any = n * 0.5; const t: string = hidden; total += t.length } return total }
function guardedDouble(n: number): unknown { try { const hidden: any = n * 0.5; const t: string = hidden; return t } catch (error) { return describeError(error) } }
function coldInteger(n: number): string { const hidden: any = n | 0; const t: string = hidden; return t }
function hotInteger(n: number, count: number): number { let total = 0; for (let i = 0; i < count; i++) { const hidden: any = n | 0; const t: string = hidden; total += t.length } return total }
function guardedInteger(n: number): unknown { try { const hidden: any = n | 0; const t: string = hidden; return t } catch (error) { return describeError(error) } }
function coldRead(p: Point): number { return p.x }
function hotRead(p: Point, count: number): number { let total = 0; for (let i = 0; i < count; i++) { total += p.x } return total }
function guardedRead(p: Point): unknown { try { return p.x } catch (error) { return describeError(error) } }
function coldStore(p: Point): number { p.x = 1; return p.x }
function hotStore(p: Point, count: number): number { let total = 0; for (let i = 0; i < count; i++) { p.x = i; total += p.x } return total }
function guardedStore(p: Point): unknown { try { p.x = 1; return p.x } catch (error) { return describeError(error) } }
function coldIterate(list: number[]): number { let total = 0; for (const x of list) total += x; return total }
function hotIterate(list: number[], count: number): number { let total = 0; for (let i = 0; i < count; i++) { for (const x of list) total += x } return total }
function guardedIterate(list: number[]): unknown { try { let total = 0; for (const x of list) total += x; return total } catch (error) { return describeErrorLine(error) } }
function coldDeadZone(early: boolean): number { const read = () => late; if (early) return read(); const late = 1; return read() }
function hotDeadZone(early: boolean, count: number): number { const read = () => late; let total = 0; for (let i = 0; i < count; i++) { if (early) total += read() } const late = 1; return total + read() }
function guardedDeadZone(early: boolean): unknown { try { const read = () => late; if (early) return read(); const late = 1; return read() } catch (error) { return describeErrorLine(error) } }
function coldError(bad: boolean): string { if (bad) throw new RangeError("too far"); return "fine" }
function hotError(bad: boolean, count: number): number { let total = 0; for (let i = 0; i < count; i++) { if (bad) throw new RangeError("too far"); total += 1 } return total }
function guardedError(bad: boolean): unknown { try { if (bad) throw new RangeError("too far"); return "fine" } catch (error) { return describeError(error) } }
printResult("number as string cold", () => coldText(hide(5)))
printResult("number as string hot", () => hotText(hide(5), 1000))
printResult("number as string try", () => guardedText(hide(5)))
printResult("string as number cold", () => coldNumber(hide("wrong")))
printResult("string as number hot", () => hotNumber(hide("wrong"), 1000))
printResult("string as number try", () => guardedNumber(hide("wrong")))
printResult("object as string cold", () => coldText(JSON.parse("{}")))
printResult("object as string hot", () => hotText(JSON.parse("{}"), 1000))
printResult("object as string try", () => guardedText(JSON.parse("{}")))
printResult("unboxed double cold", () => coldDouble(3))
printResult("unboxed double hot", () => hotDouble(3, 1000))
printResult("unboxed double try", () => guardedDouble(3))
printResult("unboxed integer cold", () => coldInteger(3))
printResult("unboxed integer hot", () => hotInteger(3, 1000))
printResult("unboxed integer try", () => guardedInteger(3))
printResult("read of null cold", () => coldRead(hide(null)))
printResult("read of null hot", () => hotRead(hide(null), 1000))
printResult("read of null try", () => guardedRead(hide(null)))
printResult("store to undefined cold", () => coldStore(hide(undefined)))
printResult("store to undefined hot", () => hotStore(hide(undefined), 1000))
printResult("store to undefined try", () => guardedStore(hide(undefined)))
printResultLine("iteration of null cold", () => coldIterate(hide(null)))
printResultLine("iteration of null hot", () => hotIterate(hide(null), 1000))
printResultLine("iteration of null try", () => guardedIterate(hide(null)))
printResultLine("dead zone cold", () => coldDeadZone(true))
printResultLine("dead zone hot", () => hotDeadZone(true, 1000))
printResultLine("dead zone try", () => guardedDeadZone(true))
printResult("thrown error cold", () => coldError(true))
printResult("thrown error hot", () => hotError(true, 1000))
printResult("thrown error try", () => guardedError(true))
printResult("undefined passes cold", () => coldNumber(hide(undefined)))
printResult("undefined passes hot", () => hotNumber(hide(undefined), 2))
printResult("undefined passes try", () => guardedNumber(hide(undefined)))
printResult("string fits cold", () => coldText(hide("ok")))
printResult("string fits hot", () => hotText(hide("ok"), 2))
printResult("string fits try", () => guardedText(hide("ok")))
printResult("number fits cold", () => coldNumber(hide(2.5)))
printResult("number fits hot", () => hotNumber(hide(2.5), 2))
printResult("number fits try", () => guardedNumber(hide(2.5)))
printResult("read fits cold", () => coldRead({ x: 4 }))
printResult("read fits hot", () => hotRead({ x: 4 }, 2))
printResult("read fits try", () => guardedRead({ x: 4 }))
printResult("store fits cold", () => coldStore({ x: 0 }))
printResult("store fits hot", () => hotStore({ x: 0 }, 2))
printResult("store fits try", () => guardedStore({ x: 0 }))
printResult("iteration fits cold", () => coldIterate([1, 2]))
printResult("iteration fits hot", () => hotIterate([1, 2], 2))
printResult("iteration fits try", () => guardedIterate([1, 2]))
printResult("initialized cold", () => coldDeadZone(false))
printResult("initialized hot", () => hotDeadZone(false, 2))
printResult("initialized try", () => guardedDeadZone(false))
printResult("no error cold", () => coldError(false))
printResult("no error hot", () => hotError(false, 2))
printResult("no error try", () => guardedError(false))
//// throwing-lines-alone/lines.ts
export interface Point { x: number; y: number }
export function sum(p: Point): number { return p.x + p.y; }
export function scale(n: number): number { return n * 2; }
export function report(label: string, f: () => unknown) {
  try { console.log(label + ":", String(f())); } catch (e) { console.log(label + ":", (e as Error).constructor.name); }
}
////= run
//// throwing-lines-alone/main.ts
// Which lines can throw is decided function by function, from the types as written. type-rules/throwing-lines-beside-another-file has the same `lines.ts` and one more file that uses its functions in other ways: the lines of `lines.ts` print the same in both programs.
import { run } from "./lines";
run(JSON.parse('{"x":"1","y":2}'), "text");
//// throwing-lines-beside-another-file/lines.ts
export interface Point { x: number; y: number }
export function sum(p: Point): number { return p.x + p.y; }
export function scale(n: number): number { return n * 2; }
export function report(label: string, f: () => unknown) {
  try { console.log(label + ":", String(f())); } catch (e) { console.log(label + ":", (e as Error).constructor.name); }
}
////= run
//// throwing-lines-beside-another-file/main.ts
// Adding a file never changes whether a line throws. `lines.ts` is that of type-rules/throwing-lines-alone, and its lines print the same here, where `other.ts` also calls its functions: as values, through `any`, with a proxy, an instance of a class and an object that inherits its fields.
import { run } from "./lines";
import { useOtherwise } from "./other";
useOtherwise();
run(JSON.parse('{"x":"1","y":2}'), "text");
useOtherwise();
//// throwing-lines-beside-another-file/other.ts
import { type Point, report, scale, sum } from "./lines";

class Pixel implements Point { constructor(public x: number, public y: number) {} }
const table: Record<string, Function> = { sum, scale };
export function useOtherwise() {
  report("other.ts, an instance of a class", () => sum(new Pixel(1, 2)));
  report("other.ts, a proxy", () => sum(new Proxy({ x: 2, y: 3 }, {})));
  report("other.ts, inherited fields", () => sum(Object.create({ x: 3, y: 4 })));
  report("other.ts, as a value", () => table.sum({ x: 4, y: 5 }) + table.scale(1));
  report("other.ts, as a value with a boolean", () => table.scale(true));
}
//// truncation-keeps-fraction.ts
// A truncated number is a new value: the fraction and the sign of zero stay with the original.
declare const console: { log(...values: unknown[]): void };
function show(value: number): string {
  return Object.is(value, -0) ? "-0" : String(value);
}
function f(x: number): number[] {
  const i = Math.trunc(x);
  return [i, i + 0.5, x, 1 / i];
}
function int32Forms(x: number): number[] {
  return [x | 0, x >>> 0, ~~x];
}
function line(values: number[]): string {
  return values.map(show).join(" ");
}
const inputs = [1.5, -0.5, -0, NaN, 2 ** 40 + 0.5, 2 ** 62, Infinity];
for (const x of inputs) console.log("once", show(x), line(f(x)), line(int32Forms(x)));
for (const x of inputs) {
  let truncated: number[] = [];
  let forms: number[] = [];
  for (let n = 0; n < 20000; n++) {
    truncated = f(x);
    forms = int32Forms(x);
  }
  console.log("hot", show(x), line(truncated), line(forms));
}
for (const x of [0, 1, 7, 2147483647, 2 ** 40]) {
  const i = Math.trunc(x);
  console.log("integral", x, i === x, f(x)[2] === x, (x | 0) === x, (x >>> 0) === x, ~~x === x);
}
for (const x of [-1, -2147483648]) console.log("negative integral", x, Math.trunc(x) === x, (x | 0) === x, ~~x === x);
//// type-error-in-initializer-at-load/a-class-field-written-through-an-interface.ts
interface Loose { size: number | null }
class Strict { size: number = 1; }
function clear(it: Loose): void { it.size = null; }
function make(): { next: number } { const strict = new Strict(); clear(strict); return { next: strict.size + 1 }; }
export const made = make();
//// type-error-in-initializer-at-load/a-field-written-through-a-wider-view.ts
type Base = { a: number };
type Derived = { a: number; b: number };
type Box<Held> = { it: Held };
function make(): { next: number } { const derived: Box<Derived> = { it: { a: 1, b: 2 } }; const base: Box<Base> = derived; base.it = { a: 1 }; return { next: derived.it.b + 1 }; }
export const made = make();
//// type-error-in-initializer-at-load/a-method-parameter-that-varies-both-ways.ts
type Base = { a: number };
type Derived = { a: number; b: number };
type Taker<Taken> = { take(it: Taken): number };
function make(): { next: number } { const derived: Taker<Derived> = { take(it: Derived): number { return it.b + 1; } }; const base: Taker<Base> = derived; return { next: base.take({ a: 1 }) }; }
export const made = make();
//// type-error-in-initializer-at-load/a-number-written-as-a-string-through-a-union.ts
type Narrow = { size: number };
type Wide = { size: number | string };
function make(): { twice: number } { const narrow: Narrow = { size: 1 }; const wide: Wide = narrow; wide.size = "s"; return { twice: narrow.size * 2 }; }
export const made = make();
//// type-error-in-initializer-at-load/an-optional-member-cleared-through-a-parameter.ts
type Loose = { size?: number };
type Strict = { size: number };
function clear(it: Loose): void { it.size = undefined; }
function make(): { next: number } { const strict: Strict = { size: 1 }; clear(strict); return { next: strict.size + 1 }; }
export const made = make();
//// type-error-in-initializer-at-load/main.ts
// TypeScript lets a program break a type in a few known ways. Where a field then holds another kind, --aot throws a TypeError at the typed read; null, undefined and a missing member pass. Where it throws in the initializer of a top-level constant, the error is thrown while the module is loaded, not when the constant is first read.
////= load	JSON.stringify(module.made)
await load("a class field written through an interface", () => import("./a-class-field-written-through-an-interface"));
await load("a field written through a wider view", () => import("./a-field-written-through-a-wider-view"));
await load("a number written as a string through a union", () => import("./a-number-written-as-a-string-through-a-union"));
await load("an optional member cleared through a parameter", () => import("./an-optional-member-cleared-through-a-parameter"));
await load("a method parameter that varies both ways", () => import("./a-method-parameter-that-varies-both-ways"));
//// type-error-in-legacy-static-decorator/main.ts
// The decorators of a method are evaluated with the class, also where nobody calls the method: a type error in one stops the build.
const made = (option: unknown) => (target: unknown, key: unknown, descriptor?: unknown) => {};
class Decorated {
  @made((1 as number).first) static fixed() {}
  @made((1 as number).second) method() {}
}
console.log(typeof Decorated);
//// type-error-in-legacy-static-decorator/tsconfig.json
////= lines-2	"../../tsconfig.json"	"experimentalDecorators"	true
//// type-error-in-removed-code.ts
// A type error in code that folding removes does not stop the build, and a `@ts-expect-error` there is not reported as unused.
if (false) {
  const a: number = "one";
  // @ts-expect-error
  const b: number = "two";
  missing(a, b);
}
console.log("printed");
//// type-error-in-uncalled-method-decorator.ts
// A type error stops the build wherever it stands in code that runs. The decorators of a method are evaluated with the class, also where nobody calls the method.
const plain = (value: unknown, context: unknown) => {};
const made = (option: unknown) => (value: unknown, context: unknown) => {};
class Decorated {
  @made((1 as number).first) method() {}
  @((1 as number).second, plain) static fixed() {}
  @made((1 as number).third) get read() { return 1; }
  @made((1 as number).fourth) set written(value: number) {}
  @made((1 as number).fifth) async *steps() {}
}
console.log(typeof Decorated);
//// type-error-with-decorators.ts
// A type error stops the build in a file that has decorators as in any other: inside a function that runs, inside a method, in an argument.
const plain = (value: unknown, context: unknown) => {};
class Decorated {
  @plain method() {
    const inAMethod: number = "a method";
    return inAMethod;
  }
}
function called() {
  const inAFunction: boolean = "a function";
  return inAFunction;
}
const arrow = () => {
  const inAnArrow: bigint = "an arrow";
  return inAnArrow;
};
function takes(given: symbol) {
  return given;
}
console.log(new Decorated().method(), called(), arrow(), takes("an argument"));
//// type-names-pass-early-errors/main.ts
// The early errors of ECMAScript are looked for in checked TypeScript too. An exported interface has no binding, and a constant may share its name with an imported type: both are valid TypeScript, and plain Bun drops the export and the import.
import { Shape } from "./types";
interface Point { x: number }
export { Point };
const Shape = { side: 2 };
const held: Shape = { side: 3 };
const point: Point = { x: 1 };
console.log(point.x, Shape.side, held.side);
//// type-names-pass-early-errors/types.ts
export interface Shape { side: number }
//// typed-functions-via-any-missing-arguments.ts
// Typed functions are called through `any` with an argument missing, and a method is called with a `this` that is not an instance of its class: undefined passes every written type and `this` of a method is not tested, so nothing throws.
class K { v = 1; constructor(public w = 2) {} m(a?: number, b?: number) { return [this?.v, a, b].join() } static s(x: number) { return x + 1 } }
function usesThis(this: unknown, a: number) { return typeof this + a }
function withProps(a: number) { return a * 2 }
const table: any[] = [usesThis, withProps, K.s], names = ["usesThis()", "withProps()", "K.s()"]
for (let i = 0; i < table.length; i++) {
  const f = table[i]
  try { f(); console.log(names[i] + ": no error") } catch (e) { console.log(names[i] + ":", e instanceof TypeError ? "TypeError" : "other " + e) }
}
const holder: any = { f: usesThis, g: new K().m, v: 9 }
try { holder.g(1); console.log("another this: no error") } catch (e) { console.log("another this:", e instanceof TypeError ? "TypeError" : "other " + e) }
//// typed-object-prototype-changes.ts
// Typed code may change the prototype of a record.
interface Plain { a: number }
const plain: Plain = { a: 1 }
const parent = { inherited: "yes", hello() { return "hi " + (this as any).a } }
try { Object.setPrototypeOf(plain, parent); console.log("another prototype: no error") } catch (e) { console.log("another prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log((plain as any).inherited, typeof (plain as any).hello, plain.a, Object.getPrototypeOf(plain) === parent, Object.keys(plain).join())
try { Object.setPrototypeOf(plain, null); console.log("no prototype: no error") } catch (e) { console.log("no prototype:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(Object.getPrototypeOf(plain) === Object.prototype, plain.a, "toString" in plain)
//// typeof-json-parse-types-the-parameters.ts
// A function expression under `typeof globalThis.JSON.parse` gets its parameter types from it.
export const parse: typeof globalThis.JSON.parse = (text, reviver) => globalThis.JSON.parse(text, reviver);

console.log(parse("[1]"));
console.log(parse('{"a":1,"b":2}', (key, value) => (key === "a" ? undefined : value)));
console.log((JSON.parse("[1,2]") as number[]).length);
//// types-with-the-same-names-say-int32-in-one-file-and-number-in-another/fractions.ts
type Point = { x: number; y: number };
type Solid = { x: number; y: number; z: number };
type Depth = { x?: number };
type Named = { x: number; y: number; name: string };
type Line = { from: Point; to?: Point };
interface Box<Value> { value: Value }
function sum(point: Point, solid: Solid, depth: Depth, named: Named, line: Line, box: Box<number>): number {
  return point.x + point.y + solid.z + (depth.x ?? 0.25) + named.y + line.from.x + (line.to?.y ?? 0) + box.value;
}
export function fractions() {
  let step = 0.5;
  const counted: Depth = { get x() { return (step += 1); } };
  return [sum({ x: 0.5, y: 1.5 }, { x: 1, y: 2, z: 2.5 }, { x: 0.125 }, { x: 1, y: 1e12, name: "n" }, { from: { x: -0, y: NaN } }, { value: 0.0625 }), counted.x, counted.x].join(" ");
}
//// types-with-the-same-names-say-int32-in-one-file-and-number-in-another/main.ts
// Two files have types with the same names: in one the members are int32, in the other numbers. No object of the one is taken for the other, and each file reads what its own types say.
import { fractions } from "./fractions.ts";
import { wholeNumbers } from "./whole-numbers.ts";
console.log(await wholeNumbers(), fractions());
//// types-with-the-same-names-say-int32-in-one-file-and-number-in-another/whole-numbers.ts
import type { int32 } from "bun";
interface Point { x: int32; y: int32 }
type Alias = { x: int32; y: int32 };
interface Solid extends Point { z: int32 }
interface Depth { x?: int32 }
interface Line { from: Point; to?: Point }
interface Fixed { readonly x: int32; readonly y: int32 }
interface Nullable { x: int32 | undefined; y: int32 | null }
interface Box<Value> { value: Value }
interface Whole { value: int32 }
class Holder { n: int32 = 0; constructor(point: Point) { this.n = point.x; } }
function take(value: int32): int32 { return value; }
function annotatedPattern(point: Point): int32 { const { x }: Point = point; return x; }
function renamed(point: Point): int32 { const { y: other } = point; return other; }
function parameterPattern({ x, y }: Point): int32 { return x > y ? x : y; }
function withDefault(depth: Depth): int32 { const { x = 4 } = depth; return x; }
function inLoop(list: Point[]): int32 { let last: int32 = 0; for (const { x } of list) last = x; return last; }
function loopMember(list: Point[]): int32 { let last: int32 = 0; for (const point of list) last = point.y; return last; }
function byKey(point: Point): int32 { return point["x"]; }
function chained(point: Point | undefined): int32 { return point?.x ?? -1; }
function asserted(point: Point | null): int32 { return point!.x; }
function cast(point: unknown): int32 { return (point as Point).x; }
function variable(point: Point): int32 { const value: int32 = point.x; return value; }
function argument(point: Point): int32 { return take(point.y); }
function defaulted(point: Point, value: int32 = point.x): int32 { return value; }
function either(first: boolean, point: Point, other: Point): int32 { return first ? point.x : other.y; }
function largest(point: Point): int32 { return Math.max(point.x, point.y); }
function captured(point: Point): int32 { const read = (): int32 => point.x; return read(); }
function alias(point: Alias): int32 { return point.x; }
function heir(solid: Solid): int32 { return solid.x > 0 ? solid.z : solid.y; }
function fixed(point: Fixed): int32 { return point.x; }
function mapped(point: Readonly<Point>): int32 { return point.x; }
function part(point: Partial<Point>): int32 { return point.x ?? 0; }
function picked(point: Pick<Point, "x">): int32 { return point.x; }
function both(point: Point & { name: string }): int32 { return point.y; }
function deep(line: Line): int32 { return line.to?.x ?? line.from.y; }
function nullable(point: Nullable): int32 { return point.x === undefined ? (point.y ?? -2) : point.x; }
function keyed<Key extends keyof Point>(point: Point, key: Key): Point[Key] { return point[key]; }
function open(box: Box<int32>): int32 { return box.value; }
function whole(box: Whole): int32 { return box.value; }
function inMap(points: Map<string, Point>): int32 { const point = points.get("k"); return point ? point.y : -1; }
