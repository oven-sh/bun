declare const console: { log(...values: unknown[]): void };
type Options = { mode?: { strict: boolean }; depth?: number };

const NAMES: Record<string, string> = {
  first: "First",
  mode: "Mode",
  last: "Last",
};

function depthOf(options: Options): number {
  return options.depth ?? 0;
}

console.log(depthOf(NAMES), NAMES.first, NAMES.mode, NAMES.last, Object.keys(NAMES).join());
//// record-key-named-like-object-prototype-member.ts
// `table["toString"]` on a type that has a string index signature and nothing else has the type of that signature; `table.toString` has the type of Object.prototype's method.
// A dictionary may hold a value under any key, also under the names that Object.prototype has.
interface Entry { result: string }
function attempt(label: string, run: () => unknown): void {
  try { console.log(label + ": " + JSON.stringify(run())); } catch (error) { console.log(label + ": threw " + (error as Error).name); }
}
const cast = { toString: { result: "first" }, plain: { result: "second" } } as Record<string, Entry>;
const made: Record<string, Entry> = {};
made["toString"] = { result: "stored" }; made["valueOf"] = { result: "v" }; made["constructor"] = { result: "c" }; made["hasOwnProperty"] = { result: "h" };
const indexed: { [key: string]: Entry } = {};
indexed["toString"] = { result: "i" };
const parsed: Record<string, Entry> = JSON.parse('{"toString":{"result":"p"},"constructor":{"result":"pc"}}');
const numbers: Record<string, number> = {};
numbers["toString"] = 5; numbers["valueOf"] = 6;
const texts: Record<string, string> = { isPrototypeOf: "text" };
const key: string = "toString";
function read(table: Record<string, Entry>): string { return table["toString"].result; }
function readBy(table: Record<string, Entry>, name: string): string { return table[name].result; }
function sum(): number { return numbers["toString"] + 1; }
function whole(): number { return numbers["toString"]; }

console.log(cast["plain"].result, cast["toString"].result, made["toString"].result, numbers["toString"] + numbers["valueOf"], texts["isPrototypeOf"].length);
attempt("a cast literal", () => cast["toString"].result);
attempt("by a variable", () => cast[key].result);
attempt("stored", () => [made["toString"].result, made["valueOf"].result, made["constructor"].result, made["hasOwnProperty"].result]);
attempt("an index signature", () => indexed["toString"].result);
attempt("parsed", () => parsed["toString"].result + parsed["constructor"].result);
attempt("a parameter", () => read(made) + read(cast) + read(parsed));
attempt("a parameter, by name", () => readBy(made, "toString") + readBy(cast, "toString"));
attempt("numbers", () => [numbers["toString"] + numbers["valueOf"], sum(), whole(), numbers["toString"] * 2, -numbers["valueOf"]]);
attempt("texts", () => [texts["isPrototypeOf"] + "!", texts["isPrototypeOf"].toUpperCase()]);
attempt("the value itself", () => made["toString"]);
attempt("nothing stored", () => typeof ({} as Record<string, Entry>)["toString"]);
attempt("optional chain", () => made["toString"]?.result);
attempt("keys", () => Object.keys(made).join());
attempt("in", () => "toString" in made);
attempt("stored again", () => { made["toString"] = { result: "again" }; return made["toString"].result; });
attempt("compound", () => { numbers["toString"] += 2; numbers["valueOf"]++; return [numbers["toString"], numbers["valueOf"]]; });
//// redefine-or-delete-field.ts
// Turning a field of a typed object into an accessor, making it non-enumerable, or deleting a required field succeeds, as every change JavaScript allows does, and typed code sees the change.
interface Command { name: string; description: string; hidden: boolean; count: number }
function lazy(target: object, key: string, make: () => unknown) {
  Object.defineProperty(target, key, { get: make, enumerable: true, configurable: true })
}
let calls = 0
function command(name: string, dynamic: boolean): Command {
  const made: Command = { name, description: dynamic ? "" : "static " + name, hidden: false, count: 1 }
  if (dynamic) try { lazy(made, "description", () => "made " + name + " " + ++calls); console.log("getter: no error") } catch (e) { console.log("getter:", e instanceof TypeError ? "TypeError" : "other " + e) }
  return made
}
const a = command("a", true), b = command("b", false)
console.log(JSON.stringify(a.description), b.description, calls, Object.keys(a).join(), JSON.stringify(a))
try { Object.defineProperty(b, "hidden", { enumerable: false }); console.log("not enumerable: no error") } catch (e) { console.log("not enumerable:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(Object.keys(b).join(), b.hidden, JSON.stringify(b))
let stored = 0
try { Object.defineProperty(a, "count", { get: () => stored, set: v => { stored = v * 10 }, enumerable: true, configurable: true }); console.log("getter and setter: no error") } catch (e) { console.log("getter and setter:", e instanceof TypeError ? "TypeError" : "other " + e) }
a.count = 4
console.log(a.count, stored, typeof Object.getOwnPropertyDescriptor(a, "count")!.get)
try { delete (a as any).count; console.log("delete of a required field: no error") } catch (e) { console.log("delete of a required field:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log("count" in a, Object.keys(a).join())
class Point { x = 1; y = 2; sum() { return this.x + this.y } }
const p = new Point()
try { Object.defineProperty(p, "x", { get: () => 40, configurable: true }); console.log("getter on an instance: no error") } catch (e) { console.log("getter on an instance:", e instanceof TypeError ? "TypeError" : "other " + e) }
console.log(p.sum(), p.x, Object.keys(p).join())
//// reference-to-parameter-bound-by-conditional-type.ts
// Where a reference's type is a type parameter whose base constraint is a union, `undefined` or `null`, TypeScript gives the reference the base constraint as its type.
// Through a conditional type that constraint is not a bound on the values: here it is `undefined` or `number[] | null`, and the calls below are all well typed.
interface Schema<Out> { parse(value: unknown): Out }
type Infer<S> = S extends Schema<infer Out> ? Out : never;
interface Tool { inputSchema?: Schema<unknown> }
type ArgumentsOf<T extends Tool> = T["inputSchema"] extends infer S ? (S extends Schema<unknown> ? Infer<S> : undefined) : undefined;
function isObject(value: unknown): boolean { return typeof value === "object" && value !== null; }
function show(value: unknown): string { return typeof value + " " + JSON.stringify(value); }
function attempt(label: string, ...runs: (() => unknown)[]): void {
  console.log(label + ": " + runs.map(run => { try { return show(run()); } catch (error) { return "threw " + (error as Error).name; } }).join(" | "));
}

function passedOn<T extends Tool, A extends ArgumentsOf<T>>(tool: T, given: A): boolean { return isObject(given); }
function stored<T extends Tool, A extends ArgumentsOf<T>>(tool: T, given: A): unknown { const held: unknown = given; return held; }
function returned<T extends Tool, A extends ArgumentsOf<T>>(tool: T, given: A): unknown { return given; }
function compared<T extends Tool, A extends ArgumentsOf<T>>(tool: T, given: A): boolean { return given === undefined; }
function inArray<T extends Tool, A extends ArgumentsOf<T>>(tool: T, given: A): unknown[] { return [given]; }
function inObject<T extends Tool, A extends ArgumentsOf<T>>(tool: T, given: A): { held: unknown } { return { held: given }; }
function kindOf<T extends Tool, A extends ArgumentsOf<T>>(tool: T, given: A): string { return typeof given; }
function asText<T extends Tool, A extends ArgumentsOf<T>>(tool: T, given: A): string { return String(given); }
function serialized<T extends Tool, A extends ArgumentsOf<T>>(tool: T, given: A): string { return JSON.stringify(given) ?? "nothing"; }
function fromField<T extends Tool, A extends ArgumentsOf<T>>(tool: T, box: { held: A }): boolean { return isObject(box.held); }
function fromArray<T extends Tool, A extends ArgumentsOf<T>>(tool: T, list: A[]): boolean { return isObject(list[0]); }
function captured<T extends Tool, A extends ArgumentsOf<T>>(tool: T, given: A): unknown { const read = (): unknown => given; return read(); }
function orElse<T extends Tool, A extends ArgumentsOf<T>>(tool: T, given: A): unknown { return given ?? "none"; }
function tested<T extends Tool, A extends ArgumentsOf<T>>(tool: T, given: A): string { return given ? "truthy" : "falsy"; }
function assigned<T extends Tool, A extends ArgumentsOf<T>>(tool: T, given: A): unknown { let held: unknown; held = given; return held; }
function narrowed<T extends Tool, A extends ArgumentsOf<T>>(tool: T, given: A): string { if (given === undefined) return "undefined"; return show(given); }
class Call<T extends Tool, A extends ArgumentsOf<T>> {
  constructor(public tool: T, public given: A) {}
  check(): boolean { return isObject(this.given); }
  text(): string { return show(this.given); }
}

const tool: Tool = { inputSchema: { parse: (value: unknown) => value } };
const exact = { inputSchema: { parse: (value: unknown) => value as { a: number } } };
const given: Record<string, unknown> | undefined = { a: 1 };
attempt("passedOn", () => passedOn(tool, given), () => passedOn(tool, undefined), () => passedOn(tool, 5), () => passedOn(exact, { a: 2 }), () => passedOn({}, undefined));
attempt("stored", () => stored(tool, given));
attempt("returned", () => returned(tool, given));
attempt("compared", () => compared(tool, given), () => compared(tool, undefined));
attempt("inArray", () => inArray(tool, given));
attempt("inObject", () => inObject(tool, given));
attempt("kindOf", () => kindOf(tool, given), () => kindOf(tool, "s"), () => kindOf(tool, undefined));
attempt("asText", () => asText(tool, 5));
attempt("serialized", () => serialized(tool, given), () => serialized(tool, undefined));
attempt("fromField", () => fromField(tool, { held: given }));
attempt("fromArray", () => fromArray(tool, [given]));
attempt("captured", () => captured(tool, given));
attempt("orElse", () => orElse(tool, given), () => orElse(tool, undefined));
attempt("tested", () => tested(tool, given), () => tested(tool, 0));
attempt("assigned", () => assigned(tool, given));
attempt("narrowed", () => narrowed(tool, given), () => narrowed(tool, undefined), () => narrowed(exact, { a: 3 }));
attempt("check of a class", () => new Call(tool, given).check());
attempt("text of a class", () => new Call(tool, given).text(), () => new Call(tool, undefined).text(), () => new Call(exact, { a: 4 }).text());

type NoUndefined<T> = T extends undefined ? never : T;
interface Holder<Output = unknown> { _output: Output }
type Output<T> = T extends { _output: any } ? T["_output"] : never;
const text: Holder<string> = { _output: "" };
const point: Holder<{ x: number }> = { _output: { x: 1 } };
function unionBound<T extends Holder, V extends NoUndefined<Output<T>> | number[] | null>(inner: T, value: V): string { return show(value); }
function unionBoundStored<T extends Holder, V extends NoUndefined<Output<T>> | number[] | null>(inner: T, value: V): unknown { const held: unknown = value; return held; }
function unionBoundLength<T extends Holder, V extends NoUndefined<Output<T>> | number[]>(inner: T, value: V): unknown { return Array.isArray(value) ? value.length : value; }
function nullBound<T extends Holder, V extends NoUndefined<Output<T>> | null>(inner: T, value: V): string { return show(value); }
attempt("unionBound", () => unionBound(text, "a"), () => unionBound(text, [1]), () => unionBound(text, null), () => unionBound(point, { x: 2 }));
attempt("unionBoundStored", () => unionBoundStored(text, "b"), () => unionBoundStored(point, { x: 3 }));
attempt("unionBoundLength", () => unionBoundLength(text, "c"), () => unionBoundLength(text, [1, 2]), () => unionBoundLength(point, { x: 4 }));
attempt("nullBound", () => nullBound(text, "d"), () => nullBound(text, null), () => nullBound(point, { x: 5 }));
//// regexp-early-errors.js
// Regular expression literals that JavaScript rejects stop the build of a JavaScript file too, also in a function that is never called.
function unused() {
  return [
    /\1/u,
    /a**/,
    /(?<a>.)\k<b>/,
    /[b-a]/,
  ];
}
console.log(typeof unused);
//// repeated-proto-setter.js
// `__proto__: v` twice in one object literal is an ECMAScript early error, so it stops the build in a JavaScript file too.
console.log({ __proto__: null, "__proto__": null });
//// results-of-functions-that-return-what-an-inner-check-turned-away.ts
// A function whose parameter is tested at its head and whose body tests something else too: what a call answers. Where the second test fails, the function goes on with the value as it is
// and returns it, so its callers may not take the declared result for proven. The first three are cut from programs that did not build; the last two do return what their types deny.
declare const console: { log(...values: unknown[]): void };

const LINE_SCRUB = /[\x00-\x1f]+/gu;
const SHORT_LINE_LENGTH = 12;
const ELLIPSIS = "...";

function head(text: string, count: number): string {
    let result = "";
    let taken = 0;
    for (const point of text) {
        if (taken++ >= count)
            break;
        result += point;
    }
    return result;
}

function shortLine(text: string): string {
    const line = (text.split(/\r?\n/u)[0] ?? "").replace(LINE_SCRUB, " ").trim();
    return line.length <= SHORT_LINE_LENGTH ? line : head(line, SHORT_LINE_LENGTH - ELLIPSIS.length) + ELLIPSIS;
}

function truncate(text: string, width: number): string {
    const flat = text.replace(/\s+/g, " ");
    return flat.length <= width ? flat : head(flat, width - 1) + "…";
}

function hasMark(text: string): boolean {
    return text.split(";").some(part => part.startsWith("<") && part.endsWith("M"));
}

const answers: unknown[] = ["text", 7, null, { length: 3 }, undefined, "longer than twelve characters"];
function pick(index: number): string {
    return answers[index % answers.length] as string;
}

function picked(prefix: string, index: number): string {
    const value = pick(index);
    return prefix.length > 100 ? prefix : value;
}

function pickedOrShort(prefix: string, index: number): string {
    const value = pick(index);
    return value != null && value.length <= SHORT_LINE_LENGTH ? value : prefix + ELLIPSIS;
}

function describe(value: string): string {
    return typeof value + ":" + (typeof value === "object" && value !== null ? "length " + (value as { length: number }).length : String(value));
}

function report(lines: string[]): string[] {
    return lines.map(line => JSON.stringify(shortLine(line)) + " " + JSON.stringify(truncate(line, 10)) + " " + hasMark(line));
}

const given: string[] = JSON.parse(JSON.stringify(["one\ntwo", "x".repeat(20), "<12M;a", "  a\tb  ", "\u{1f600}".repeat(14)]));
for (const line of report(given))
    console.log(line);
let total = 0;
for (let i = 0; i < 1000; i++)
    total += shortLine(given[i % given.length]).length + truncate(given[i % given.length], 10).length;
console.log(total);
for (let round = 0; round < 3; round++) {
    for (let index = 0; index < answers.length; index++)
        console.log(describe(picked(given[index % given.length], index)), describe(pickedOrShort(given[index % given.length], index)));
}
//// return-in-static-block.js
// `return` in a class static block is an early error, also in JavaScript, where nothing else is checked.
class A { static { return; } }
//// same-errors-in-tagged-template.ts
// Built-in and user-defined methods called as template tags, after attempts to replace them.
const log: string[] = []
function note<T>(what: string, value: T): T { log.push(what); return value }
function flush(): string { return log.splice(0).join() }
function pushTo(a: unknown[]): unknown { return a.push`${note("arg", 7)}` }
try { const fake = { get push() { log.push("get push"); return (s: unknown, x: number) => 100 + x } } as unknown as unknown[]; console.log(pushTo(fake)); console.log("an object as an array: no error") } catch (e) { console.log("an object as an array:", e instanceof TypeError ? "TypeError" : "other " + e, "[" + flush() + "]") }
abstract class Shape { abstract area(s: TemplateStringsArray, scale: number): string }
class Square extends Shape { area(s: TemplateStringsArray, scale: number): string { return "square" + scale } }
class Circle extends Shape { area(s: TemplateStringsArray, scale: number): string { return "circle" + scale } }
function retarget(s: Shape): number { (s as any).area = () => "own"; return 2 }
const shapes: Shape[] = [new Square(), new Circle(), new Square()]
for (const s of shapes) {
  try { console.log(s.area`${retarget(s)}`); console.log("own property named like a method: no error") } catch (e) { console.log("own property named like a method:", e instanceof TypeError ? "TypeError" : "other " + e, s.area`${3}`) }
}
//// same-value-annotated-twice.ts
// One value enters two places annotated with the same type. The second test may be dropped only where the first one has already passed on every path. The test asks for an object; a field of another kind throws where it is read, a missing field reads undefined.
type Point = { x: number; y: number };
type Named = { name: string };

////= attempt-3

function twice(value: any): number {
    const a: Point = value;
    const b: Point = value;
    return a.x + b.y;
}

function onlyOneBranchChecks(value: any, flag: boolean): number {
    let n = 0;
    if (flag) {
        const a: Point = value;
        n = a.x;
    }
    const b: Point = value;
    return n + b.y;
}

function bothBranchesCheck(value: any, flag: boolean): number {
    let n = 0;
    if (flag) {
        const a: Point = value;
        n = a.x;
    } else {
        const c: Point = value;
        n = c.y;
    }
    const b: Point = value;
    return n + b.y;
}

function firstFailureIsCaught(value: any): string {
    try {
        const a: Point = value;
        return "first passed " + a.x;
    } catch {}
    try {
        const b: Point = value;
        return "second passed " + b.x;
    } catch {
        return "second failed too";
    }
}

function reassignedBetween(good: any, bad: any): number {
    let value = good;
    const a: Point = value;
    value = bad;
    const b: Point = value;
    return a.x + b.y;
}

function reassignedByClosure(good: any, bad: any): number {
    let value = good;
    const replace = () => {
        value = bad;
    };
    const a: Point = value;
    replace();
    const b: Point = value;
    return a.x + b.y;
}

function twoTypes(value: any): string {
    const a: Point = value;
    const b: Named = value;
    return a.x + b.name;
}

function changedBetween(value: any, change: (value: any) => void): string {
    const a: Point = value;
    change(value);
    const b: Point = value;
    return typeof a.y + " " + typeof b.y + " " + (a === b);
}

function inLoop(values: any[], fixed: any): number {
    let sum = 0;
    for (const value of values) {
        const a: Point = value;
        const b: Point = fixed;
        const c: Point = value;
        sum += a.x + b.y + c.y;
    }
    return sum;
}

async function acrossAwait(value: any): Promise<number> {
    const a: Point = value;
    await null;
    const b: Point = value;
    return a.x + b.y;
}

function takesPoint(point: Point): number {
    return point.x * 10 + point.y;
}

function passedTwice(value: any): number {
    return takesPoint(value) + takesPoint(value);
}

function sameObject(value: any): boolean {
    const a: Point = value;
    const b: Point = value;
    return a === b && a === value;
}

const point: Point = { x: 1, y: 2 };
attempt("twice, a point", () => twice(point));
attempt("twice, a literal through any", () => twice({ x: 3, y: 4 }));
attempt("twice, parsed data", () => twice(JSON.parse('{"x":5,"y":6}')));
attempt("twice, y is missing", () => twice({ x: 1 }));
attempt("twice, a string", () => twice("point"));
attempt("twice, undefined", () => twice(undefined));
attempt("one branch, taken, a point", () => onlyOneBranchChecks(point, true));
attempt("one branch, not taken, a point", () => onlyOneBranchChecks(point, false));
attempt("one branch, taken, wrong", () => onlyOneBranchChecks({ x: "1" }, true));
attempt("one branch, not taken, wrong", () => onlyOneBranchChecks({ x: "1" }, false));
attempt("both branches, a point", () => bothBranchesCheck(point, true) + bothBranchesCheck(point, false));
attempt("both branches, wrong", () => bothBranchesCheck({ y: 2 }, false));
attempt("caught, a point", () => firstFailureIsCaught(point));
attempt("caught, wrong", () => firstFailureIsCaught({ x: 1, y: "2" }));
attempt("reassigned, good then good", () => reassignedBetween(point, { x: 7, y: 8 }));
attempt("reassigned, good then bad", () => reassignedBetween(point, { x: 7 }));
attempt("closure, good then good", () => reassignedByClosure(point, { x: 7, y: 8 }));
attempt("closure, good then bad", () => reassignedByClosure(point, null));
attempt("two types, both", () => twoTypes({ x: 1, y: 2, name: "n" }));
attempt("two types, only a point", () => twoTypes({ x: 1, y: 2 }));
attempt("changed, not at all", () => changedBetween({ x: 1, y: 2 }, () => {}));
attempt("changed, y is another number", () => changedBetween({ x: 1, y: 2 }, value => { value.y = 9; }));
attempt("changed, y is a string", () => changedBetween({ x: 1, y: 2 }, value => { value.y = "nine"; }));
attempt("changed, y is deleted", () => changedBetween({ x: 1, y: 2 }, value => { delete value.y; }));
attempt("changed, a property more", () => changedBetween({ x: 1, y: 2 }, value => { value.z = 3; }));
attempt("loop, all points", () => inLoop([point, { x: 3, y: 4 }], point));
attempt("loop, the second is wrong", () => inLoop([point, { x: 3 }], point));
attempt("loop, the fixed one is wrong", () => inLoop([point], 5));
attempt("loop, nothing to do", () => inLoop([], 5));
attempt("passed twice, a point", () => passedTwice(point));
attempt("passed twice, wrong", () => passedTwice({ x: 1, z: 2 }));
attempt("same object, a point", () => sameObject(point));
attempt("same object, a literal through any", () => sameObject({ x: 1, y: 2 }));
attempt("same object, parsed data", () => sameObject(JSON.parse('{"x":1,"y":2}')));
acrossAwait(point).then(
    value => console.log("across await, a point", value),
    error => console.log("across await, a point", String(error)),
);
acrossAwait({ y: 2 }).then(
    value => console.log("across await, wrong", value),
    error => console.log("across await, wrong", error instanceof TypeError ? "TypeError" : String(error)),
);
//// shared-array-buffer-is-not-an-array-buffer.ts
// A SharedArrayBuffer is not an ArrayBuffer, nor the other way round: the runtime type check of a parameter, of a field and of a result tells them apart, and a type that names both classes takes both.
class Holder {
  unshared: ArrayBuffer = new ArrayBuffer(1);
  shared: SharedArrayBuffer = new SharedArrayBuffer(2);
}
function takesUnshared(buffer: ArrayBuffer): number { return buffer.byteLength; }
function takesShared(buffer: SharedArrayBuffer): number { return buffer.byteLength; }
function takesEither(buffer: ArrayBuffer | SharedArrayBuffer): number { return buffer.byteLength; }
function storesUnshared(buffer: any): number { const holder = new Holder(); holder.unshared = buffer; return holder.unshared.byteLength; }
function storesShared(buffer: any): number { const holder = new Holder(); holder.shared = buffer; return holder.shared.byteLength; }
function returnsUnshared(buffer: any): ArrayBuffer { return buffer; }
function returnsShared(buffer: any): SharedArrayBuffer { return buffer; }
function sizeOfUnsharedResult(buffer: any): number { return returnsUnshared(buffer).byteLength; }
function sizeOfSharedResult(buffer: any): number { return returnsShared(buffer).byteLength; }
const untyped: any[] = [takesUnshared, takesShared, takesEither, storesUnshared, storesShared, sizeOfUnsharedResult, sizeOfSharedResult];
const given: any[] = [new ArrayBuffer(8), new SharedArrayBuffer(16), new Uint8Array(4), { byteLength: 32 }];
for (const f of untyped) {
  for (const value of given) {
    const tag = Object.prototype.toString.call(value);
    try { console.log(f.name, tag, f(value)); } catch (error) { console.log(f.name, tag, (error as Error).name); }
  }
}
//// static-constructor-name-after-ts-ignore.ts
// A static generator or accessor named `constructor` is valid JavaScript. TypeScript's errors (1368, 1341) are its own there: below a `@ts-ignore` the program builds and runs as in plain Bun.
class A {
  // @ts-ignore
  static *constructor() { yield 1; }
}
class B {
  // @ts-ignore
  static get constructor() { return 2; }
}
console.log([...A.constructor()], B.constructor);
//// static-method-named-constructor.js
// A static generator or accessor named `constructor` is valid JavaScript. TypeScript reports it (1368, 1341), and the build accepts it.
class A { static *constructor() { yield 1; } }
class B { static get constructor() { return 2; } }
class C {
  static stored = 0;
  static set constructor(value) { C.stored = value; }
}
console.log([...A.constructor()], B.constructor);
C.constructor = 3;
console.log(C.stored, C.constructor);
console.log(new A().constructor === A, new B().constructor === B, new C().constructor === C);
//// stores-of-a-sum-of-two-missing-strings.ts
// A sum that TypeScript calls a string and that is NaN at run time is stored into a field of a literal or an element of an array that no annotation types.
const none: string[] = [];
const some: string[] = ["a", "b"];
function show(name: string, f: () => unknown) { try { console.log(name, String(f())); } catch (e) { console.log(name, "threw", (e as Error).constructor.name); } }

function inLiteral(list: string[], i: number) { const o = { key: list[i] + list[i + 1] }; return o.key; }
function inArray(list: string[], i: number) { const all = [list[i] + list[i + 1]]; return all[0]; }
function pushed(list: string[], i: number) { const all = ["x"]; all.push(list[i] + list[i + 1]); return all[1]; }

for (const list of [none, some]) {
  show("in a literal", () => inLiteral(list, 0));
  show("in an array", () => inArray(list, 0));
  show("pushed", () => pushed(list, 0));
}
//// stores-through-interfaces.ts
// Stores through declared interface types into untyped objects with accessors, read-only properties, or that are frozen.
interface Settings { volume: number; theme: string; muted?: boolean; limits: { max: number } }
const heard: string[] = []
function rule(label: string, f: () => unknown) { try { console.log(label + ": no error", f()) } catch (e) { console.log(label + ":", e instanceof TypeError ? "TypeError" : "other " + e) } }
function withSetters(): Settings {
  const hidden = { volume: 0 }
  const o: any = { theme: "", limits: { max: 0 } }
  Object.defineProperty(o, "volume", { get() { return hidden.volume }, set(x: number) { heard.push("volume=" + x); hidden.volume = x * 10 }, enumerable: true })
  return o
}
rule("own setter", () => { withSetters().volume = 3; return "stored" })
const chainedPrototype: any = { theme: "inherited", limits: { max: 7 }, volume: 1 }
rule("heir", () => { const chained: Settings = Object.create(chainedPrototype); chained.volume = 4; return "stored" })
const text = '{"volume":1,"theme":"j","limits":{"max":1}}'
rule("frozen parsed text", () => { const frozen: Settings = Object.freeze(JSON.parse(text)); return frozen.volume })
rule("sealed parsed text", () => { const sealed: Settings = Object.seal(JSON.parse(text)); return sealed.volume })
rule("parsed text that may not grow", () => { const closedUp: Settings = Object.preventExtensions(JSON.parse(text)); return closedUp.volume })
rule("proxy", () => { const doubling: Settings = new Proxy<Settings>({ volume: 0, theme: "", limits: { max: 0 } }, { set: (t, k, x) => Reflect.set(t, k, typeof x === "number" ? x * 2 : x) }); doubling.volume = 10; return doubling.volume })
rule("array", () => { const list = [1, 2] as unknown as Settings; list.limits = { max: 0 }; return "stored" })
rule("function", () => { const callable = (() => 1) as unknown as Settings; callable.limits = { max: 0 }; return "stored" })
console.log(heard.length)
//// stores-to-error-and-function-prototype.ts
// A store to `Error.prototype.name` takes effect: a built-in that is not always locked and that the program writes stays writable. `Function.prototype` takes no new name in a compiled program: every string key of it is fixed, present or absent.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.constructor.name : String(e))) } }
function hide(v: unknown): any { return v }
row("Error.prototype.name", () => { (Error.prototype as any).name = "X"; return new Error("m").name + " " + String(new Error("m")) });
row("Function.prototype.mine", () => { (Function.prototype as any).mine = 1; return (row as any).mine });
//// strict-null-checks-are-predictions/main.ts
// With `strictNullChecks` a type such as `number` excludes undefined and null for the checker only. At run time both pass every written type and stay what they are, and a test for them that the checker considers needless still answers. A value of another kind throws as without the option.
const nothing: any = undefined;
const empty: any = null;
const text: any = "text";
interface Row { id: number; name: string }
////= attempt-2
function kind(n: number): string { return n === undefined ? "undefined" : n === null ? "null" : typeof n; }
function nameOf(row: Row): string { return row === null ? "no row" : row.name ?? "no name"; }
function result(): string { return nothing; }

attempt("undefined for a parameter of type number", () => kind(nothing));
attempt("null for a parameter of type number", () => kind(empty));
attempt("a string for a parameter of type number", () => kind(text));
attempt("null for an object type", () => nameOf(empty));
attempt("a field of type string that is missing", () => nameOf({ id: 1 } as any));
attempt("null in a variable of type number", () => { const n: number = empty; return n; });
attempt("undefined as a result of type string", () => result());
attempt("undefined in a variable of type number | null", () => { const n: number | null = nothing; return n; });
attempt("null in an element of number[]", () => { const list: number[] = [1]; list[0] = empty; return list[0]; });
//// strict-null-checks-are-predictions/tsconfig.json
