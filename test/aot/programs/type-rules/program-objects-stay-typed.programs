////: attempt-3
function attempt(label: string, run: () => unknown) {
    try {
        console.log(label, run());
    } catch (error) {
        console.log(label, error instanceof TypeError ? "TypeError" : String(error));
    }
}
////: run
export function run(odd: any, text: any) {
  report("a Point", () => sum({ x: 1, y: 2 }));
  report("a field of another kind", () => sum(odd));
  report("a field that is missing", () => sum({ x: 1 } as any));
  report("a number", () => scale(4));
  report("a string for a number", () => scale(text));
}
//// program-objects-stay-typed-beside-external-data.ts
// Objects the program makes itself stay typed when external data is nearby: a table of functions, and a Map or Set, are not external data. The read of `data.t`, a text under a written `number`, throws a TypeError, which changes nothing for them.
const data = JSON.parse('{"t":"abc","name":"n"}') as { t: number; name: string };
const table = { first() { return 1; }, second: () => 2, label: "table" };
const other: { first?: unknown; label?: unknown } = {};
try {
  other.first = data.t;
} catch (error) {
  other.first = (error as Error).constructor.name;
}
other.label = data.name;
export const one = table.first();
export const two = table.second();
const names = new Set<string>();
const byName = new Map<string, { count: number }>();
function remember(name: string): number {
  names.add(name);
  const known = byName.get(name);
  if (known) return ++known.count;
  byName.set(name, { count: 1 });
  return 1;
}
console.log(one + two, table.label, remember(data.name), remember(data.name), names.size, byName.size, names.has("n"), [...byName.keys()].join());
//// property-of-a-sum-that-is-not-a-string.ts
// `list[i] + list[j]` of a `string[]` is NaN where both elements are missing. TypeScript calls the sum a string; what is read from it must be what a number gives.
declare const console: { log(...values: unknown[]): void };
const none: string[] = [];
const some: string[] = ["ab", "cde"];
function lengthOf(list: string[], i: number, j: number) { return (list[i] + list[j]).length; }
function added(list: string[], i: number, j: number) { let total = 0; total += (list[i] + list[j]).length; return total; }
function kept(list: string[], i: number, j: number) { const sum = list[i] + list[j]; return sum.length; }
function compared(list: string[], i: number, j: number) { return (list[i] + list[j]).length > 2 ? "long" : "short"; }
function shown(list: string[], i: number, j: number) { return (list[i] + list[j]).toString(); }
function looped(list: string[]) { let total = 0; for (let i = 0; i <= list.length; i++) total += (list[i] + list[i + 1]).length; return total; }
function show(name: string, f: () => unknown) { try { console.log(name, String(f())); } catch (e) { console.log(name, "threw", (e as Error).constructor.name); } }
for (const [name, list] of [["none", none], ["some", some]] as [string, string[]][]) {
  for (const [i, j] of [[0, 1], [0, 5], [5, 6]]) {
    show(name + " length " + i + j, () => lengthOf(list, i, j));
    show(name + " added " + i + j, () => added(list, i, j));
    show(name + " kept " + i + j, () => kept(list, i, j));
    show(name + " compared " + i + j, () => compared(list, i, j));
    show(name + " shown " + i + j, () => shown(list, i, j));
  }
  show(name + " looped", () => looped(list));
}
//// property-read-into-untyped-call/feed.js
export function feed(print) {
  print({ id: "seven", name: null });
  print({ id: 8 });
}
//// property-read-into-untyped-call/main.ts
// A property read through a declared type is a typed read whatever the value is used for: read straight into a call of something untyped, or into a parameter declared `any`, a field of another kind throws. A missing field is undefined, and null passes. The objects here do not fit the type they are looked at as: untyped code hands one in, a cast lets one through, and a function that returns `any` makes one.
import { feed } from "./feed.js";

export interface Line {
  id: number;
  name: string;
}

const show: any = (...values: unknown[]) => console.log(values.join(" | "));
function showDeclared(...values: any[]) {
  console.log(values.join(" | "));
}

export function print(line: Line) {
  try { showDeclared(line.id, line.name); } catch (e) { console.log("into a parameter declared any:", (e as Error).constructor.name); }
  try { show(line.id, line.name); } catch (e) { console.log("into a call of something untyped:", (e as Error).constructor.name); }
}

feed(print);
print({ id: 1, name: "fits" });

const plain: any = { id: "seven", name: null };
const odd: Line = plain as Line;
try { showDeclared(odd.id, odd.name); } catch (e) { console.log("into a parameter declared any:", (e as Error).constructor.name); }
try { show(odd.id, odd.name); } catch (e) { console.log("into a call of something untyped:", (e as Error).constructor.name); }

function made(): any {
  return { id: "nine", name: 9 };
}
const other: Line = made();
try { showDeclared(other.id, other.name); } catch (e) { console.log("into a parameter declared any:", (e as Error).constructor.name); }
try { show(other.id, other.name); } catch (e) { console.log("into a call of something untyped:", (e as Error).constructor.name); }
//// proxies-through-interfaces.ts
// Proxies are used through declared interface types, and the traps they see are listed.
interface Point3 { x: number; y: number; z?: number; tag: string }
const traps: string[] = []
function flush(): string { return traps.splice(0).join(" ") }
function rule(label: string, f: () => unknown) { try { console.log(label + ": no error", f()) } catch (e) { console.log(label + ":", e instanceof TypeError ? "TypeError" : "other " + e) } }
const handler: ProxyHandler<any> = {
  get(t, k, r) { traps.push("get:" + String(k)); return Reflect.get(t, k, r) },
  set(t, k, x, r) { traps.push("set:" + String(k)); return Reflect.set(t, k, x, r) },
  deleteProperty(t, k) { traps.push("delete:" + String(k)); return Reflect.deleteProperty(t, k) },
}
function spy<T extends object>(target: T): T { return new Proxy(target, handler) }
function norm1(q: Point3): number { return q.x + q.y + (q.z ?? 0) }
const target: Point3 = { x: 1, y: 2, tag: "t" }
rule("proxy from a generic function, as its target's type", () => norm1(spy(target)))
rule("new Proxy<Point3>", () => new Proxy<Point3>({ x: 0, y: 0, tag: "s" }, {}).x)
rule("Proxy.revocable<Point3>", () => Proxy.revocable<Point3>({ x: 1, y: 1, tag: "r" }, {}).proxy.x)
rule("an empty literal cast to the type, for a proxy that exists only in its traps", () => new Proxy({} as Point3, { get: () => 7 }).x)
const untyped: any = new Proxy<object>(target, handler)
rule("proxy as an argument", () => norm1(untyped))
rule("proxy into an annotated variable", () => { const q: Point3 = untyped; return q.x })
rule("proxy cast", () => (untyped as Point3).x)
rule("proxy into a field", () => { const pair: { first: Point3 } = { first: untyped }; return pair.first.x })
rule("heir of a proxy", () => { const child: Point3 = Object.create(untyped); return child.x })
console.log(flush() === "")
class Acc { total = 0; steps?: number; add(n: number): this { this.total += n; this.steps = (this.steps ?? 0) + 1; return this } get mean(): number { return this.total / (this.steps ?? 1) } }
const acc = new Acc()
const pa: any = new Proxy<object>(acc, handler)
rule("method of a class with a proxy for this", () => pa.add(2))
rule("getter of a class with a proxy for this", () => pa.mean)
console.log(flush(), acc.total, acc.mean)
rule("store through the traps that does not fit the field", () => { untyped.x = "ten"; return "stored" })
rule("required field deleted through the traps", () => delete untyped.tag)
console.log(flush(), JSON.stringify(target))
//// quoted-constructor-as-accessor.ts
// A quoted `"constructor"` names the constructor too. TypeScript accepts an accessor of that name, plain Bun rejects it while parsing, so the build stops.
class A { get "constructor"() { return 1; } }
console.log(new A().constructor);
