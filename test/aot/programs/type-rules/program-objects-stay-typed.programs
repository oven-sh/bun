//// unused-parameter-tested-on-entry.ts
// A parameter with a written type is tested on entry, whether or not the body uses it. Each function is called as a function value with a string for `a: number`: every call throws a TypeError, also where the parameter is never read, only assigned, or has a default. The neighbors below have no written type to test: a parameter typed by its context, `any`, `unknown`, a type parameter, a type taken from a default. They return as in plain Bun.
const wrong: any = "wrong";
const row = (name: string, f: () => unknown) => { try { const result = f(); console.log(name, typeof result === "function" ? "function" : String(result)); } catch (e) { console.log(name, "throws", (e as Error).constructor.name); } };
function ignores(a: number): number { return 1; }
function reads(a: number): number { return a; }
function passesOn(a: number): number { return ignores(a); }
function usesArguments(a: number): number { return arguments.length; }
function readsArguments(a: number): unknown { return arguments[0]; }
function hasRest(a: number, ...rest: number[]): number { return rest.length; }
function defaultReadsIt(a: number, b: number = a): number { return 2; }
function hasDefault(a: number = 5): number { return 3; }
function destructures({ x }: { x: number }): number { return 4; }
function captures(a: number): () => number { return () => a; }
function capturesUnused(a: number): () => number { return () => 5; }
function typeofOnly(a: number): string { return typeof a; }
function assignsOnly(a: number): number { a = 6; return a; }
const typedByContext: (a: number) => number = a => 7;
function declaredAny(a: any): number { return 8; }
function declaredUnknown(a: unknown): number { return 9; }
function generic<T>(a: T): number { return 10; }
function constrained<T extends number>(a: T): number { return 11; }
function typedByDefault(a = 5): number { return 12; }
const table: Record<string, Function> = { ignores, reads, passesOn, usesArguments, readsArguments, hasRest, defaultReadsIt, hasDefault, destructures, captures, capturesUnused, typeofOnly, assignsOnly, typedByContext, declaredAny, declaredUnknown, generic, constrained, typedByDefault };
for (const name of Object.keys(table)) row(name, () => table[name](wrong));
//// uses-of-a-sum-of-two-missing-strings.ts
// What is done with a sum that TypeScript calls a string and that is NaN at run time does what it does in plain Bun, wherever no annotation says string.
const none: string[] = [];
const some: string[] = ["a", "b"];
function show(name: string, f: () => unknown) { try { console.log(name, String(f())); } catch (e) { console.log(name, "threw", (e as Error).constructor.name); } }

function lengthOf(list: string[], i: number) { return (list[i] + list[i + 1]).length; }
function lengthOfEither(list: string[], i: number, c: boolean) { return (c ? list[i] + list[i + 1] : "x").length; }
function lengthOfConstant(list: string[], i: number) { const s = list[i] + list[i + 1]; return s.length; }
function lengthOfVariable(list: string[], i: number, c: boolean) { let s = "x"; if (c) s = list[i] + list[i + 1]; return s.length; }
function lengthAfterAppend(list: string[], i: number) { let s = list[i]; s += list[i + 1]; return s.length; }
function lengthOrElse(list: string[], i: number) { return (list[i] + list[i + 1] || "x").length; }
function appendedInLoop(list: string[]) { let s = list[0]; for (let i = 1; i < 3; i++) s += list[i]; return s; }
function accumulated(list: string[]) { let s = ""; for (let i = 0; i < 3; i++) s += list[i]; return s; }
function typeOf(list: string[], i: number) { const s = list[i] + list[i + 1]; return typeof s; }
function compared(list: string[], i: number) { const s = list[i] + list[i + 1]; return s === s; }
function inTemplate(list: string[], i: number) { return `<${list[i] + list[i + 1]}>`; }
function asKey(list: string[], i: number) { const seen: Record<string, number> = {}; seen[list[i] + list[i + 1]] = 1; return Object.keys(seen).join(); }
function returnedTwice(list: string[], i: number) { const inner = () => list[i] + list[i + 1]; return inner(); }
function calledOn(list: string[], i: number) { return (list[i] + list[i + 1]).toString(); }
function throwsInBoth(list: string[], i: number) { return (list[i] + list[i + 1]).toUpperCase(); }

for (const list of [none, some]) {
  show("length", () => lengthOf(list, 0));
  show("length of either", () => lengthOfEither(list, 0, true));
  show("length of a constant", () => lengthOfConstant(list, 0));
  show("length of a variable", () => lengthOfVariable(list, 0, true));
  show("length after an append", () => lengthAfterAppend(list, 0));
  show("length or else", () => lengthOrElse(list, 0));
  show("appended in a loop", () => appendedInLoop(list));
  show("accumulated", () => accumulated(list));
  show("typeof", () => typeOf(list, 0));
  show("compared", () => compared(list, 0));
  show("in a template", () => inTemplate(list, 0));
  show("as a key", () => asKey(list, 0));
  show("returned twice", () => returnedTwice(list, 0));
  show("called on", () => calledOn(list, 0));
  show("throws in both", () => throwsInBoth(list, 0));
}
//// uses-of-variable-bound-by-conditional-type.ts
// More places where a variable whose type parameter is bound through a conditional type is read: TypeScript's base constraint of V is `number[] | null`, and the calls below are all well typed.
function show(value: unknown): string { return typeof value + " " + JSON.stringify(value); }
function attempt(label: string, ...runs: (() => unknown)[]): void {
  console.log(label + ": " + runs.map(run => { try { return show(run()); } catch (error) { return "threw " + (error as Error).name; } }).join(" | "));
}
type NoUndefined<T> = T extends undefined ? never : T;
interface Holder<Output = unknown> { _output: Output }
type Output<T> = T extends { _output: any } ? T["_output"] : never;
type Bound<T> = NoUndefined<Output<T>> | number[] | null;
const text: Holder<string> = { _output: "" };
const point: Holder<{ x: number }> = { _output: { x: 1 } };
function field<T extends Holder, V extends Bound<T>>(inner: T, box: { held: V }): string { return show(box.held); }
function element<T extends Holder, V extends Bound<T>>(inner: T, list: V[]): string { return show(list[0]); }
function destructured<T extends Holder, V extends Bound<T>>(inner: T, { held }: { held: V }): string { return show(held); }
function fromTuple<T extends Holder, V extends Bound<T>>(inner: T, [first]: [V]): string { return show(first); }
function iterated<T extends Holder, V extends Bound<T>>(inner: T, list: V[]): string { let out = ""; for (const each of list) out += show(each); return out; }
function local<T extends Holder, V extends Bound<T>>(inner: T, value: V): string { const copy = value; return show(copy); }
function reassigned<T extends Holder, V extends Bound<T>>(inner: T, value: V, other: V): string { let held = value; held = other; return show(held); }
function nonNull<T extends Holder, V extends Bound<T>>(inner: T, value: V): string { return show(value!); }
function chained<T extends Holder, V extends Bound<T>>(inner: T, value: V): string { return show(value?.length); }
function lengthOf<T extends Holder, V extends Bound<T>>(inner: T, value: V): string { return value === null ? "null" : show(value.length); }
function conditional<T extends Holder, V extends Bound<T>>(inner: T, value: V, flag: boolean): string { return show(flag ? value : 0); }
function logical<T extends Holder, V extends Bound<T>>(inner: T, value: V): string { return show(value || "empty"); }
function template<T extends Holder, V extends Bound<T>>(inner: T, value: V): string { return `${value}`; }
function added<T extends Holder, V extends Bound<T>>(inner: T, value: V): string { return "<" + value + ">"; }
function mapped<T extends Holder, V extends Bound<T>>(inner: T, list: V[]): string { return list.map(each => show(each)).join(); }
function callback<T extends Holder, V extends Bound<T>>(inner: T, value: V, use: (given: unknown) => string): string { return use(value); }
function rest<T extends Holder, V extends Bound<T>>(inner: T, ...values: V[]): string { return show(values[0]); }
function defaulted<T extends Holder, V extends Bound<T>>(inner: T, value: V | undefined = undefined): string { return show(value); }
function isArray<T extends Holder, V extends Bound<T>>(inner: T, value: V): string { return Array.isArray(value) ? "array " + value.length : show(value); }
function switched<T extends Holder, V extends Bound<T>>(inner: T, value: V): string { switch (typeof value) { case "string": return "a string"; case "object": return show(value); default: return "other"; } }
async function awaited<T extends Holder, V extends Bound<T>>(inner: T, value: V): Promise<string> { await null; return show(value); }
function* yielded<T extends Holder, V extends Bound<T>>(inner: T, value: V): Generator<unknown> { yield value; }
class Keeper<T extends Holder, V extends Bound<T>> { constructor(public inner: T, public value: V) {} text(): string { return show(this.value); } get held(): unknown { return this.value; } }
attempt("field", () => field(text, { held: "a" }), () => field(text, { held: [1] }), () => field(point, { held: { x: 2 } }));
attempt("element", () => element(text, ["a"]), () => element(point, [{ x: 2 }]));
attempt("destructured", () => destructured(text, { held: "a" }), () => destructured(point, { held: { x: 2 } }));
attempt("fromTuple", () => fromTuple(text, ["a"]), () => fromTuple(point, [{ x: 2 }]));
attempt("iterated", () => iterated(text, ["a"]), () => iterated(point, [{ x: 2 }]));
attempt("local", () => local(text, "a"), () => local(point, { x: 2 }));
attempt("reassigned", () => reassigned(text, "a", "b"), () => reassigned(point, { x: 2 }, null));
attempt("nonNull", () => nonNull(text, "a"), () => nonNull(point, { x: 2 }));
attempt("chained", () => chained(text, "abc"), () => chained(text, [1]), () => chained(text, null), () => chained(point, { x: 2 }));
attempt("lengthOf", () => lengthOf(text, "abc"), () => lengthOf(text, [1]), () => lengthOf(point, { x: 2 }));
attempt("conditional", () => conditional(text, "a", true), () => conditional(point, { x: 2 }, true));
attempt("logical", () => logical(text, "a"), () => logical(text, ""), () => logical(point, { x: 2 }));
attempt("template", () => template(text, "a"), () => template(text, [1, 2]));
attempt("added", () => added(text, "a"), () => added(text, null));
attempt("mapped", () => mapped(text, ["a"]), () => mapped(point, [{ x: 2 }]));
attempt("callback", () => callback(text, "a", show), () => callback(point, { x: 2 }, show));
attempt("rest", () => rest(text, "a"), () => rest(point, { x: 2 }));
attempt("defaulted", () => defaulted(text, "a"), () => defaulted(text), () => defaulted(point, { x: 2 }));
attempt("isArray", () => isArray(text, "a"), () => isArray(text, [1]), () => isArray(point, { x: 2 }));
attempt("switched", () => switched(text, "a"), () => switched(text, [1]), () => switched(point, { x: 2 }));
attempt("yielded", () => [...yielded(text, "a")], () => [...yielded(point, { x: 2 })]);
attempt("class", () => new Keeper(text, "a").text(), () => new Keeper(point, { x: 2 }).text(), () => new Keeper(text, "a").held);
awaited(text, "a").then(got => console.log("awaited: " + got), error => console.log("awaited: threw " + error.name));
awaited(point, { x: 2 }).then(got => console.log("awaited: " + got), error => console.log("awaited: threw " + error.name));
//// values-outside-literal-and-enum-types.ts
// Values of the right kind that are not among the constants their literal or enum type allows: a literal type promises the kind, so nothing throws.
////= attempt
const hide = (v: unknown): any => v
enum Level { Low, Mid, High }
// A numeric enum is tested as `number`: TypeScript lets any number into it.
attempt("enum, 0.5", () => { const l: Level = hide(0.5); return l })
attempt("enum, 2 ** 32", () => { const l: Level = hide(4294967296); return l })
attempt("enum, NaN", () => { const l: Level = hide(NaN); return l })
attempt("enum, 9", () => { const l: Level = hide(9); return l })
// `true` and `false` are separate types.
attempt("false as true", () => { const t: true = hide(false); return t ? "true" : "false" })
attempt("true as false", () => { const f: false = hide(true); return f === false })
interface Pixel { level: Level; on: true }
const pixel: Pixel = { level: Level.Low, on: true }
attempt("field, false as true", () => { hide(pixel).on = false })
attempt("field, enum, 0.5", () => { hide(pixel).level = 0.5 })
console.log(JSON.stringify(pixel))
// Plain data that does not match passes `as` unchanged: the cast asks only for an object. The typed read of a field is tested against the field's type: `true` takes only true, a numeric enum any number.
attempt("plain data, false as true", () => (JSON.parse('{"level":12,"on":false}') as Pixel).on)
attempt("plain data, enum, 0.5", () => (JSON.parse('{"level":0.5,"on":true}') as Pixel).level)
// A string literal type takes exactly its own strings, so the typed read of a discriminant outside the union throws. A discriminant of the other part passes, and the field that part declares is missing: it reads undefined.
type Shape = { kind: "circle"; r: number } | { kind: "square"; side: number }
function area(s: Shape): string {
  if (s.kind === "circle") return "circle " + s.r
  if (s.kind === "square") return "square " + s.side
  return "neither " + (s as any).kind
}
attempt("discriminant of plain data outside the union", () => area(JSON.parse('{"kind":"triangle","r":1}')))
attempt("discriminant stored from outside the union", () => { const s: Shape = { kind: "circle", r: 3 }; hide(s).kind = "blob"; return area(s) })
attempt("discriminant of the other part", () => area(JSON.parse('{"kind":"square","r":1}')))
//// values-outside-literal-types.ts
// A literal type says which values the compiler may expect, not which values arrive: a value of the right kind outside the list goes on as it is. Everything that could be specialized for the list is tried here with values from parsed text, which no analysis knows: switches, comparisons, tables, indexes, arithmetic, conditions, fields, elements, discriminants. Every line is what plain Bun prints.
const given: { strings: any[]; numbers: any[]; booleans: any[] } = JSON.parse(
  '{"strings":["a","b","c","ab","","A","__proto__","constructor","0","reference"],"numbers":[1,2,3,0,-1,1.5,-0,4294967297,2147483648,-2147483649,1e300,300],"booleans":[true,false]}',
);
given.numbers.push(NaN, Infinity);
// The same texts as cells that no literal of the program stands for.
const built: any[] = given.strings.map(text => (text + "!").slice(0, -1));
function line(label: string, values: unknown[]): void { console.log(label, values.map(value => (Object.is(value, -0) ? "-0" : String(value))).join(" ")); }

type Name = "a" | "b";
type Level = 1 | 2;
enum Color { Red = "a", Blue = "b" }
enum Step { Low = 1, High = 2 }
enum Flag { None = 0, Read = 1, Write = 2 }
interface Specs { reference: number; "amd-module": number }
const specs: Specs = { reference: 1, "amd-module": 2 };

function switchedName(name: Name): string { switch (name) { case "a": return "first"; case "b": return "second"; } }
function switchedNameWithDefault(name: Name): string { switch (name) { case "a": return "first"; default: return "rest"; } }
function switchedLevel(level: Level): string { switch (level) { case 1: return "one"; case 2: return "two"; } }
function switchedColor(color: Color): string { switch (color) { case Color.Red: return "red"; case Color.Blue: return "blue"; } }
function switchedStep(step: Step): string { switch (step) { case Step.Low: return "low"; case Step.High: return "high"; } }
function chained(name: Name): string { if (name === "a") return "first"; else if (name === "b") return "second"; return "neither"; }
function otherwise(name: Name): string { return name === "a" ? "first" : "must be b: " + name; }
function notEqual(name: Name): boolean { return name !== "a" && name !== "b"; }
function loose(level: Level): boolean { return level == 1 || level == 2; }
for (const [label, texts] of [["literals", given.strings], ["built", built]] as const) {
  line("switch on strings, " + label, texts.map(switchedName));
  line("switch with default, " + label, texts.map(switchedNameWithDefault));
  line("switch on a string enum, " + label, texts.map(switchedColor));
  line("chain of comparisons, " + label, texts.map(chained));
  line("else of one comparison, " + label, texts.map(otherwise));
  line("unequal to every literal, " + label, texts.map(notEqual));
}
line("switch on numbers", given.numbers.map(switchedLevel));
line("switch on a numeric enum", given.numbers.map(switchedStep));
line("loosely equal", given.numbers.map(loose));

const words = ["zero", "one", "two"];
const bytes = new Uint8Array([10, 11, 12]);
function indexed(level: Level): unknown { return words[level]; }
function indexedBelow(level: Level): unknown { return words[level - 1]; }
function indexedBytes(level: Level): unknown { return bytes[level]; }
function character(level: Level): unknown { return "xyz"[level]; }
function characterAt(level: Level): unknown { return "xyz".charCodeAt(level); }
function reverse(step: Step): unknown { return Step[step]; }
function keyed(name: keyof Specs): unknown { return typeof specs[name]; }
function has(name: keyof Specs): boolean { return name in specs; }
line("index", given.numbers.map(indexed));
line("index minus one", given.numbers.map(indexedBelow));
line("index of a typed array", given.numbers.map(indexedBytes));
line("index of a string", given.numbers.map(character));
line("charCodeAt", given.numbers.map(characterAt));
line("reverse mapping", given.numbers.map(reverse));
line("keyof read", given.strings.map(keyed));
line("keyof read, built", built.map(keyed));
line("keyof in", given.strings.map(has));

function doubled(level: Level): number { return level * 2; }
function added(level: Level): number { return level + 2147483647; }
function shifted(level: Level): number { return 1 << level; }
function masked(flag: Flag): number { return flag & Flag.Write; }
function joined(flag: Flag): number { return flag | Flag.Read; }
function divided(level: Level): number { return 6 / level; }
function remainder(level: Level): number { return 7 % level; }
function negated(level: Level): number { return -level; }
function compared(level: Level): boolean { return level < 3 && level > 0; }
function counted(level: Level): number { let turns = 0; for (let i = 0; i < level && turns < 5; i++) turns++; return turns; }
function concatenated(name: Name): string { return name + name; }
function measured(name: Name): number { return name.length; }
function templated(name: Name, level: Level): string { return `${name}:${level}`; }
line("times two", given.numbers.map(doubled));
line("plus the largest int32", given.numbers.map(added));
line("shift", given.numbers.map(shifted));
line("and", given.numbers.map(masked));
line("or", given.numbers.map(joined));
line("divide", given.numbers.map(divided));
line("remainder", given.numbers.map(remainder));
line("negate", given.numbers.map(negated));
line("inside the list's range", given.numbers.map(compared));
line("loop bound", given.numbers.map(counted));
line("concatenate", given.strings.map(concatenated));
line("length", given.strings.map(measured));
line("template", given.strings.map((text, index) => templated(text, given.numbers[index])));

function whenTrue(on: true): string { return on ? "yes" : "no"; }
function whenFalse(off: false): string { if (off) return "yes"; return "no"; }
function inverted(on: true): boolean { return !on; }
function truthyName(name: Name): string { return name ? "text" : "empty"; }
function truthyLevel(level: Level): string { return level ? "some" : "none"; }
line("a condition on true", given.booleans.map(whenTrue));
line("a condition on false", given.booleans.map(whenFalse));
line("not true", given.booleans.map(inverted));
line("a string that is never empty", given.strings.map(truthyName));
line("a number that is never zero", given.numbers.map(truthyLevel));

class Holder { name: Name = "a"; level: Level = 1; on: true = true; step: Step = Step.Low; }
function throughFields(name: any, level: any, on: any): string {
  const holder = new Holder();
  holder.name = name; holder.level = level; holder.on = on; holder.step = level;
  return [switchedName(holder.name), holder.level * 2, holder.on ? "yes" : "no", Step[holder.step], holder.level === 1 || holder.level === 2].join("/");
}
line("fields", given.numbers.map((level, index) => throughFields(given.strings[index % given.strings.length], level, given.booleans[index % 2])));
const levels: Level[] = [];
for (const level of given.numbers) levels.push(level);
line("elements", levels.map(level => level * 2));
line("elements again", [levels.indexOf(1.5 as any), levels.includes(300 as any), levels.length, levels[5], Math.max(...levels.slice(0, 4))]);
const names: Name[] = [...built];
line("string elements", names.map(switchedName));
const byName = new Map<Name, Level>();
given.strings.forEach((text, index) => byName.set(text, given.numbers[index]));
line("map", [byName.size, byName.get("c" as any), byName.get("ab" as any), [...byName.keys()].join("")]);
const record: Record<Name, Level> = { a: 1, b: 2 };
for (const text of built) if (text !== "__proto__") record[text as Name] = given.numbers[5];
line("record", [Object.keys(record).join(), record.a, (record as any).c]);

type Shape = { kind: "circle"; radius: number } | { kind: "square"; side: number };
function area(shape: Shape): unknown { return shape.kind === "circle" ? shape.radius * 3 : shape.side * shape.side; }
function areaBySwitch(shape: Shape): unknown { switch (shape.kind) { case "circle": return shape.radius * 3; case "square": return shape.side * shape.side; } }
const shapes: any[] = JSON.parse('[{"kind":"circle","radius":1},{"kind":"square","side":2},{"kind":"line","radius":3,"side":4},{"kind":"circle","side":5},{"kind":"square","radius":6}]');
line("discriminant, parsed", shapes.map(area));
line("discriminant by switch, parsed", shapes.map(areaBySwitch));
function circleOf(kind: any): Shape { return { kind, radius: 2 }; }
function squareOf(kind: any): Shape { return { kind, side: 3 }; }
line("discriminant, created here", given.strings.slice(0, 3).concat("circle", "square").flatMap(kind => [area(circleOf(kind)), area(squareOf(kind)), areaBySwitch(circleOf(kind)), areaBySwitch(squareOf(kind))]));

function gives(value: any): Name { return value; }
function givesLevel(value: any): Level { return value; }
line("results", built.map(text => switchedName(gives(text))));
line("number results", given.numbers.map(level => givesLevel(level) * 2));
function optional(name?: Name): string { return name === undefined ? "none" : switchedName(name) + ""; }
line("optional", [optional(), optional(built[0]), optional(built[2])]);
function either(value: Name | Level): string { return typeof value === "string" ? switchedName(value) + "" : switchedLevel(value) + ""; }
line("strings or numbers", [...built.slice(0, 4), ...given.numbers.slice(0, 6)].map(either));

interface Item { name: Name; level: Level; on: true; step: Step; color: Color }
const itemsText = '[{"name":"a","level":1,"on":true,"step":1,"color":"a"},{"name":"c","level":7.5,"on":false,"step":9,"color":"green"},{"name":"","level":-0,"on":true,"step":4294967297,"color":"b"}]';
function showItem(item: Item): string { return [switchedName(item.name), item.level * 2, item.on ? "yes" : "no", Step[item.step], switchedColor(item.color), JSON.stringify(item)].join("/"); }
line("parsed and cast", (JSON.parse(itemsText) as Item[]).map(showItem));
const annotated: Item[] = JSON.parse(itemsText);
line("parsed into an annotation", annotated.map(showItem));
const shapesText = '[{"kind":"circle","radius":1},{"kind":"square","side":2},{"kind":"line","radius":3,"side":4},{"kind":"circle","side":5},{"kind":"","radius":6}]';
line("a parsed union", (JSON.parse(shapesText) as Shape[]).map(shape => area(shape) + "/" + areaBySwitch(shape) + "/" + JSON.stringify(shape)));
line("one parsed literal", [JSON.parse('"c"') as Name, JSON.parse("7.5") as Level, JSON.parse("false") as true].map(value => typeof value + ":" + value));
line("copies", annotated.map(item => showItem({ ...item })).concat(annotated.map(item => showItem(structuredClone(item)))));

interface Tagged { tag: "only"; zero: 0; yes: true; none: null; big: 1n }
function readTagged(t: Tagged): string { return [t.tag, t.zero, t.yes, t.none, t.big, t.tag === "only", t.zero === 0, t.zero + 1, t.tag.length, `${t.tag}${t.zero}`, JSON.stringify({ tag: t.tag, zero: t.zero, yes: t.yes })].join("/"); }
function makeTagged(tag: any, zero: any, yes: any, big: any): Tagged { return { tag, zero, yes, none: null, big }; }
line("one literal each", [makeTagged("only", 0, true, 1n), makeTagged(built[2], given.numbers[5], given.booleans[1], 7n), makeTagged("", -0, false, 0n)].map(readTagged));
line("serialized", [circleOf(built[2]), squareOf("line"), circleOf("circle")].map(shape => JSON.stringify(shape)).concat(annotated.map(item => JSON.stringify(item))));
function onlyTag(tag: "only"): string { return tag; }
function onlyZero(zero: 0): number { return zero; }
line("one literal as a parameter", [onlyTag(built[2]), onlyTag(built[0]), onlyZero(given.numbers[5]), onlyZero(given.numbers[6]), onlyZero(given.numbers[7])]);
const constant: "only" = built[3];
let counter: 0 = given.numbers[0];
line("one literal as a variable", [constant, constant === "only", counter, counter === 0, counter + 1]);
//// variable-assigned-from-call-external-data.ts
// A variable whose type is only inferred is assigned the result of a function whose return type is only inferred, and the function returns external data of another type.
// The assignment and later uses must behave as in plain JavaScript instead of asserting the inferred type.
const data = JSON.parse('{"t":"abc"}') as { t: number };
const say = (label: string, f: () => unknown): void => { let r: string; try { const v = f(); r = typeof v + " " + String(v); } catch (e) { r = "throws " + (e as Error).constructor.name; } console.log(label + " ==> " + r); };
const arrow = () => data.t;
function declared() { return data.t; }
const twice = () => arrow();
const holder = { method() { return data.t; } };
say("n += f()", () => { let n = 0; n += arrow(); return n; });
say("n = f()", () => { let n = 0; n = arrow(); return n + 1; });
say("n = f() of a declaration", () => { let n = 0; n = declared(); return n + 1; });
say("n = f() through another function", () => { let n = 0; n = twice(); return n + 1; });
say("n = o.m()", () => { let n = 0; n = holder.method(); return n + 1; });
say("n -= f()", () => { let n = 0; n -= arrow(); return n; });
say("in a loop", () => { let n = 0; for (let i = 0; i < 2; i++) n += arrow(); return n; });
say("n = (() => ..)()", () => { let n = 0; n = (() => data.t)(); return n + 1; });
say("n += (function () { .. })()", () => { let n = 0; n += (function () { return data.t; })(); return n; });
say("n = (() => { a variable assigned in a callback })()", () => { const list = [data.t]; let n = 0; n = (() => { let last = 0; list.forEach(v => { last = v; }); return last; })(); n++; return n; });
say("trusted stays exact", () => { const one = () => 1; let n = 0; n += one(); return n + 1; });
//// variables-declared-with-an-assertion.ts
// `let x!: T` and a field `x!: T` test nothing: until something is stored, a read gives undefined, whatever T is.
interface Row { id: number; name: string }

////= say
function shout(text: string): string { return text + "!"; }
function twice(n: number): number { return n + n; }

let size!: number;
let title!: string;
let row!: Row;
let flag!: boolean;
let list!: number[];
let later!: string;
class Holder { held!: Row; count!: number; read(): number { return this.count + 1; } }
function local(): string { let text!: string; return typeof text; }
function captured(): () => string { let text!: string; return () => typeof text; }
function setThenRead(): number { let n!: number; n = 4; return n + 1; }

say("a number, its type", () => typeof size);
say("a number, added", () => size + 1);
say("a number, passed on", () => twice(size));
say("a string, passed on", () => shout(title));
say("a string, in a template", () => `${title}`);
say("an object, its type", () => typeof row);
say("an object, read", () => row.id);
say("an object, tested", () => (row ? "some" : "none"));
say("a boolean, tested", () => (flag ? "yes" : "no"));
say("an array, read", () => list.length);
say("compared", () => size === undefined);
say("a local", () => local());
say("a captured local", () => captured()());
say("set, then read", () => setThenRead());
say("a field, its type", () => typeof new Holder().held);
say("a field, added", () => new Holder().read());
say("a field, read", () => new Holder().held.name);
later = "now";
say("set at last", () => shout(later));
size = 3;
say("the number, set at last", () => twice(size));
let count!: number;
let total!: number;
function bump(): number { count++; return count; }
say("minus", () => 10 - total);
say("times", () => total * 2);
say("negated", () => -total);
say("remainder", () => total % 2);
say("or zero", () => total | 0);
say("in a template, added", () => `${total + 1}`);
say("incremented in place", () => bump());
say("copied, then incremented", () => { let n = total; n++; return n; });
say("switch", () => { switch (total) { case 5: return "five"; case 0: return "zero"; default: return "other"; } });
say("as an index", () => [1, 2][total]);
say("Math.max", () => Math.max(total, 1));
total = 5;
say("set: minus", () => 10 - total);
say("set: switch", () => { switch (total) { case 5: return "five"; case 0: return "zero"; default: return "other"; } });
//// variables-wider-than-values.ts
// A variable is declared with a wide type and holds narrower values on every path, or on all paths but one. What it holds must come out unchanged either way.
enum Flags {
    None = 0,
    A = 1,
    B = 2,
    C = 4,
    High = 1 << 30,
}
type Shape = { kind: string; size: number | string };
type Square = { kind: string; size: number; side: number };
type Circle = { kind: string; size: number; radius: number };

////= attempt-3

function flagsOf(n: number): Flags {
    return n & 1 ? Flags.A : n & 2 ? Flags.B : Flags.None;
}

function combine(from: number, read: (n: number) => number): number {
    let flags = read(from);
    if (from > 1) flags |= read(from >> 1);
    if (from > 3) flags |= read(from >> 2);
    return flags;
}

function combinedFlags(from: number): Flags {
    return combine(from, flagsOf);
}

function half(n: number): number {
    return n / 2;
}

function combinedHalves(from: number): number {
    return combine(from, half);
}

function sometimesFraction(flag: boolean, n: number): Flags {
    let value: number = Flags.A;
    if (flag) value = n;
    return value;
}

function alwaysInteger(flag: boolean): Flags {
    let value: number = Flags.A;
    if (flag) value = Flags.C;
    return value;
}

function growsInLoop(rounds: number): number {
    let value: number = 1;
    for (let i = 0; i < rounds; i++) value = value * 4;
    return value;
}

function orsInLoop(rounds: number): Flags {
    let value: number = 0;
    for (let i = 0; i < rounds; i++) value |= 1 << i;
    return value;
}

function swapsInLoop(rounds: number, start: number): string {
    let a: number = 1;
    let b: number = start;
    for (let i = 0; i < rounds; i++) {
        const t = a;
        a = b;
        b = t;
    }
    return a + " " + b;
}

function negativeZero(flag: boolean): string {
    let value: number = 0;
    if (flag) value = -0;
    return Object.is(value, -0) ? "-0" : "0";
}

function assignedInTry(fail: boolean): number | string {
    let value: number | string = 1;
    try {
        value = 2;
        if (fail) throw new Error("stop");
        value = 3;
    } catch {
        return "caught with " + value;
    } finally {
        value = typeof value === "number" ? value + 10 : value;
    }
    return value;
}

function bySwitch(n: number): number | string | undefined {
    let value: number | string | undefined;
    switch (n) {
        case 0:
            value = 1;
        case 1:
            value = (value ?? 0) as number | string;
            break;
        case 2:
            value = "two";
            break;
    }
    return value;
}

function pickShape(flag: boolean, a: Square, b: Square): number {
    let shape: Shape = a;
    if (flag) shape = b;
    return (shape as Square).side;
}

function pickEither(flag: boolean, a: Square, b: Circle): string {
    let shape: Shape = a;
    if (flag) shape = b;
    return shape.kind + " " + shape.size;
}

function storeThroughWideType(flag: boolean, a: Square, b: Square, size: number | string): string {
    let shape: Shape = a;
    if (flag) shape = b;
    shape.size = size;
    return typeof a.size + " " + typeof b.size;
}

function maybeMissing(flag: boolean, a: Square): string {
    let shape: Shape | undefined = a;
    if (flag) shape = undefined;
    return shape ? shape.kind : "nothing";
}

function fromAny(flag: boolean, a: Square, other: any): number {
    let shape: Shape = a;
    if (flag) shape = other;
    return (shape as Square).side;
}

function lastOfChain(first: Square, hops: number): string {
    let current: Shape = first;
    let seen = 0;
    while (seen < hops) {
        current = seen & 1 ? first : { kind: "made " + seen, size: seen, side: seen * 2 };
        seen++;
    }
    return current.kind;
}

function textOrNumber(flag: boolean): string {
    let value: string | number = "text";
    if (flag) value = "other";
    return value.toString().toUpperCase();
}

const spare: unknown[] = [];
function opaque<T>(value: T): T {
    return spare.length > 0 ? (spare[0] as T) : value;
}

const square: Square = { kind: "square", size: 4, side: 2 };
const bigger: Square = { kind: "bigger", size: 9, side: 3 };
const circle: Circle = { kind: "circle", size: 3, radius: 1 };
for (let n = 0; n < 9; n++) attempt("combined flags " + n, () => combinedFlags(n));
for (let n = 0; n < 9; n += 3) attempt("combined halves " + n, () => combinedHalves(n));
attempt("sometimes a fraction: no", () => sometimesFraction(false, 0.5));
attempt("sometimes a fraction: an integer", () => sometimesFraction(true, 2));
attempt("sometimes a fraction: a fraction", () => sometimesFraction(true, 0.5));
attempt("sometimes a fraction: NaN", () => sometimesFraction(true, NaN));
attempt("sometimes a fraction: too large", () => sometimesFraction(true, 2 ** 40));
attempt("always an integer", () => alwaysInteger(false) + alwaysInteger(true));
attempt("grows in a loop", () => [growsInLoop(0), growsInLoop(3), growsInLoop(15), growsInLoop(16), growsInLoop(40)].join(" "));
attempt("ors in a loop", () => [orsInLoop(0), orsInLoop(3), orsInLoop(31), orsInLoop(32), orsInLoop(33)].join(" "));
attempt("swaps in a loop", () => [swapsInLoop(0, 2), swapsInLoop(1, 2), swapsInLoop(2, 0.5), swapsInLoop(3, 0.5), swapsInLoop(1, NaN)].join(" | "));
attempt("negative zero", () => negativeZero(false) + " " + negativeZero(true));
attempt("assigned in try", () => assignedInTry(false) + " | " + assignedInTry(true));
attempt("by switch", () => [bySwitch(0), bySwitch(1), bySwitch(2), bySwitch(3)].join(" | "));
attempt("pick a shape", () => pickShape(false, square, bigger) + pickShape(true, square, bigger));
attempt("pick either", () => pickEither(false, square, circle) + " | " + pickEither(true, square, circle));
attempt("store a number through the wide type", () => storeThroughWideType(true, { ...square }, { ...bigger }, 5));
attempt("store a string through the wide type", () => storeThroughWideType(true, { ...square }, { ...bigger }, "five"));
attempt("maybe missing", () => maybeMissing(false, square) + " " + maybeMissing(true, square));
attempt("from any: not taken", () => fromAny(false, square, 5));
attempt("from any: a square", () => fromAny(true, square, bigger));
attempt("from any: a literal", () => fromAny(true, square, { kind: "k", size: 1, side: 7 }));
attempt("from any: a number", () => fromAny(true, square, 5));
attempt("last of a chain", () => [lastOfChain(square, 0), lastOfChain(square, 1), lastOfChain(square, 2), lastOfChain(square, 3)].join(" | "));
attempt("text or number", () => textOrNumber(false) + textOrNumber(true));
for (const flag of [false, true]) {
    attempt("not known ahead: always an integer " + flag, () => alwaysInteger(opaque(flag)));
    attempt("not known ahead: a fraction " + flag, () => sometimesFraction(opaque(flag), opaque(1.5)));
    attempt("not known ahead: an integer " + flag, () => sometimesFraction(opaque(flag), opaque(4)));
    attempt("not known ahead: negative zero " + flag, () => negativeZero(opaque(flag)));
    attempt("not known ahead: pick a shape " + flag, () => pickShape(opaque(flag), opaque(square), opaque(bigger)));
    attempt("not known ahead: pick either " + flag, () => pickEither(opaque(flag), opaque(square), opaque(circle)));
    attempt("not known ahead: store a string " + flag, () => storeThroughWideType(opaque(flag), { ...square }, { ...bigger }, opaque("text")));
    attempt("not known ahead: maybe missing " + flag, () => maybeMissing(opaque(flag), opaque(square)));
    attempt("not known ahead: from any, a number " + flag, () => fromAny(opaque(flag), opaque(square), opaque(5)));
    attempt("not known ahead: text or number " + flag, () => textOrNumber(opaque(flag)));
    attempt("not known ahead: assigned in try " + flag, () => assignedInTry(opaque(flag)));
}
for (const rounds of [0, 1, 2, 3, 31, 32]) {
    attempt("not known ahead: ors in a loop " + rounds, () => orsInLoop(opaque(rounds)));
    attempt("not known ahead: grows in a loop " + rounds, () => growsInLoop(opaque(rounds)));
    attempt("not known ahead: swaps integers " + rounds, () => swapsInLoop(opaque(rounds), 2));
    attempt("not known ahead: swaps a fraction " + rounds, () => swapsInLoop(opaque(rounds), opaque(0.25)));
    attempt("not known ahead: last of a chain " + rounds, () => lastOfChain(opaque(square), opaque(rounds)));
    attempt("not known ahead: by switch " + rounds, () => bySwitch(opaque(rounds)));
}
//// wrong-casts-and-method-shadowing.ts
// Casts to the wrong type, and an own property with the name of a method.
const log: string[] = []
function note<T>(what: string, value: T): T { log.push(what); return value }
function flush(): string { return log.splice(0).join() }
try { const notCallable = { f: 1 as unknown as (x: number) => number }; console.log(notCallable.f(note("d", 1))); console.log("a number as a function: no error") } catch (e) { console.log("a number as a function:", e instanceof TypeError ? "TypeError" : "other " + e, "[" + flush() + "]") }
function pushTo(a: number[]): unknown { return a.push(note("arg", 7)) }
function getFrom(m: Map<string, string>): unknown { return m.get(((m as any).get = () => "new", "k")) }
try { const fakeArray = { get push() { log.push("get push"); return (x: number) => 100 + x } } as unknown as number[]; console.log(pushTo(fakeArray)); console.log("an object as an array: no error") } catch (e) { console.log("an object as an array:", e instanceof TypeError ? "TypeError" : "other " + e, "[" + flush() + "]") }
try { const fakeMap = { get: (k: string) => "old " + k } as unknown as Map<string, string>; console.log(getFrom(fakeMap)); console.log("an object as a Map: no error") } catch (e) { console.log("an object as a Map:", e instanceof TypeError ? "TypeError" : "other " + e) }
// The receiver is tested in front of a resolved built-in method, so an own property shadows the method, as in ECMAScript.
// A receiver that comes out of an `any[]` is untyped: by name.
const real = new Map([["k", "real"]])
const untyped: any[] = []; untyped.push(real)
console.log(getFrom(real), real.get("k"), untyped[0].get("k"))
abstract class Shape { abstract area(scale: number): string }
class Square extends Shape { area(scale: number): string { return "square" + scale } }
class Circle extends Shape { area(scale: number): string { return "circle" + scale } }
function retarget(s: Shape): number { (s as any).area = () => "own"; return 2 }
const shapes: Shape[] = [new Square(), new Circle(), new Square()]
for (const s of shapes) {
  try { console.log(s.area(retarget(s))); console.log("own property named like a method: no error") } catch (e) { console.log("own property named like a method:", e instanceof TypeError ? "TypeError" : "other " + e, s.area(3)) }
}
//// wrong-kind-stored-via-untyped-ref.ts
// Untyped code stores a string to a field of type number of parsed JSON that typed code holds too. The store succeeds, and the next typed read of the field throws.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name + ": " + e.message.split("\n")[0] : String(e))) } }
function hide(v: unknown): any { return v }
function parse(t: string): any { return JSON.parse(t) }
interface Sub { v: number }
interface Item { id: string; n: number; sub: Sub | null }
const made: Item[] = [{ id: "m", n: 0.5, sub: { v: 1 } }, { id: "m", n: 1, sub: null }];
function bump(x: Item): number { x.n += 1; return x.n }
function kind(x: Item): string { return typeof x.n }
row("(made by typed code)", () => bump(made[0]) + bump(made[1]));
const text = '{"id":"s","n":7,"sub":null}';
row("another kind stored by the untyped holder", () => { const held = parse(text); const t: Item = held; held.n = "seven"; return kind(t) + " " + held.n });
//// wrong-object-kind-argument.ts
// A function of TypeScript that untyped code gets hold of in an object, and that has one body only, holds what it is called with to the types of its parameters: where an array, a function or a built-in class is declared, an object of another kind is refused, as a number is.
export {};
function list(value: string[]): unknown { return value; }
function pair(value: [number, string]): unknown { return value; }
function optionalList(value?: readonly number[]): unknown { return value; }
function callback(value: (x: number) => number): unknown { return value; }
function anyFunction(value: Function): unknown { return value; }
function map(value: Map<string, number>): unknown { return value; }
function listOrSet(value: string[] | Set<string>): unknown { return value; }
function listOrFunction(value: string[] | (() => void)): unknown { return value; }
const arrow = (value: string[]): unknown => value;
async function later(value: string[]): Promise<unknown> { return [value]; }
function second(first: number, value: string[]): unknown { return value; }
function used(value: string[]): string { return "length " + value.length; }
class Heir extends Array<string> {}
const untyped: any = { list, pair, optionalList, callback, anyFunction, map, listOrSet, listOrFunction, arrow, later, used, second: (value: unknown) => untyped.inner.second(1, value), inner: { second } };
const byName: Record<string, (...given: any[]) => unknown> = { list, callback, map };
const values: [string, () => any][] = [
  ["an array", () => ["a"]], ["an empty array", () => []], ["an array of numbers", () => [1, 2]], ["an heir of Array", () => new Heir()], ["a frozen array", () => Object.freeze(["a"])],
  ["an object", () => ({})], ["an object with a length", () => ({ length: 1, 0: "a" })], ["a function", () => () => 1], ["a class", () => Heir], ["a bound function", () => list.bind(null)],
  ["a Map", () => new Map()], ["a Set", () => new Set()], ["a Date", () => new Date(0)], ["bytes", () => new Uint8Array(2)], ["a proxy of an array", () => new Proxy([], {})], ["a proxy of a function", () => new Proxy(() => 1, {})],
  ["a number", () => 5], ["a string", () => "text"], ["null", () => null], ["undefined", () => undefined],
];
async function tell(name: string, f: () => unknown): Promise<void> { let said: string; try { await f(); said = "taken"; } catch (e) { said = (e as Error).name; } console.log(name + ": " + said); }
for (const name of ["list", "pair", "optionalList", "callback", "anyFunction", "map", "listOrSet", "listOrFunction", "arrow", "later", "second", "used"]) for (const [what, make] of values) await tell(name + " | " + what, () => untyped[name](make()));
for (const name of ["list", "callback", "map"]) for (const [what, make] of values) await tell("through a record of functions | " + name + " | " + what, () => byName[name]!(make()));
const own: string[] = ["a"];
console.log(String(list(own)), String(list(new Heir())), typeof callback(x => x + 1), String(used(own)), (map(new Map([["a", 1]])) as Map<string, number>).size);
//// wrong-type-objects.ts
// `x as unknown as T` never throws for an object: `x` may be a typed object of an unrelated type, a built-in object, or data that lacks what `T` requires.
interface Engine { power: number; parts: string[] }
interface Car { wheels: number; engine: Engine; trailer?: Car; paint?: string; honk?(): string }
interface Fish { fins: number; habitat: { salt: boolean }; paint?: string }
interface Boat { paint?: string; engine: Engine; sails: number }
function rule(label: string, f: () => unknown) { try { console.log(label + ": no error", f()) } catch (e) { console.log(label + ":", e instanceof TypeError ? "TypeError" : "other " + e) } }
const fish: Fish = { fins: 2, habitat: { salt: true }, paint: "silver" }
const boat: Boat = { sails: 2, engine: { power: 7, parts: ["mast"] }, paint: "white" }
class Alpha { a = 1; run() { return "alpha" + this.a } }
class Beta { b = "two"; run() { return "beta" + this.b } }
class Goose { honk() { return "goose" } }
rule("a record of an unrelated type", () => (fish as unknown as Car).paint)
rule("a record that shares names", () => (boat as unknown as Car).engine.power)
rule("an instance of an unrelated class", () => (new Alpha() as unknown as Beta).run())
rule("an instance that has an optional member of the type only", () => (new Goose() as unknown as Car).honk?.())
const strangers: [string, unknown][] = [["array", [1, 2]], ["Map", new Map()], ["function", () => 1], ["RegExp", /re/], ["object without prototype", Object.create(null)], ["empty object", JSON.parse("{}")], ["proxy", new Proxy({}, {})]]
for (const [label, x] of strangers) rule(label, () => (x as Car).paint)
console.log(JSON.stringify(fish), JSON.stringify(boat))
//// yield-in-parameter-initializer.js
// `yield` in a parameter initializer of a generator is an ECMAScript early error, so it stops the build in a JavaScript file too.
function* g(a = yield) {}
console.log(typeof g);
