////: load
async function load(name: string, importing: () => Promise<{ made: unknown }>): Promise<void> {
  let loaded = false;
  try {
    const module = await importing();
    loaded = true;
    console.log(name + ":", «1»);
  } catch (error) {
    console.log(name + ":", (error as Error).name, loaded ? "when it was read" : "while it was loaded");
  }
}
////: say
function say(label: string, make: () => unknown): void {
  try { console.log(label, String(make())); } catch (error) { console.log(label, "THROWS", (error as Error).constructor.name); }
}
