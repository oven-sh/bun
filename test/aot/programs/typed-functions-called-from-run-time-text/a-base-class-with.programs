//// a-base-class-with-heirs.ts
// A typed function is handed to text that becomes code at run time, and called from there: a parameter of a base class that gets its heirs.
function open<F>(f: F): F { (globalThis as any).held = f; return (0, eval)("globalThis.held"); }
abstract class Shape { constructor(public id: number) {} abstract area(): number; }
class Square extends Shape { constructor(id: number, public side: number) { super(id); } area() { return this.side ** 2; } }
class Circle extends Shape { constructor(id: number, public r: number) { super(id); } area() { return this.r * 3; } }
function probe(shapes: Shape[], square: Square): number {
  let sum = square.id + square.side;
  for (const s of shapes) sum += s.area() + s.id;
  return sum;
}
console.log(open(probe)([new Square(1, 2), new Circle(2, 3)], new Square(3, 4)));
//// a-callback-whose-parameter-is-typed-by-its-context.ts
// A typed function is handed to text that becomes code at run time, and called from there: a callback whose parameter gets its type from the context.
interface Point { x: number; y: number }
function open<F>(f: F): F { (globalThis as any).held = f; return (0, eval)("globalThis.held"); }
function pointAt(i: number): Point { return { x: i, y: i * 2 }; }
function probe(points: Point[]): number {
  let sum = 0;
  points.forEach(p => { sum += p.x; });
  return sum + points.map(p => p.y).reduce((a, b) => a + b, 0);
}
console.log(open(probe)([pointAt(1), pointAt(2)]));
//// a-field-read-through-keyof.ts
// A typed function is handed to text that becomes code at run time, and called from there: a field read through a key of type keyof and a result of an indexed access type.
interface Point { x: number; y: number }
function open<F>(f: F): F { (globalThis as any).held = f; return (0, eval)("globalThis.held"); }
function pointAt(i: number): Point { return { x: i, y: i * 2 }; }
function get<T, K extends keyof T>(o: T, k: K): T[K] { return o[k]; }
function probe(p: Point): number {
  const x = get(p, "x");
  return x + 1;
}
console.log(open(probe)(pointAt(1)));
//// a-function-type-and-an-interface-method.ts
// A typed function is handed to text that becomes code at run time, and called from there: a parameter of a function type and a method of an interface.
interface Point { x: number; y: number }
function open<F>(f: F): F { (globalThis as any).held = f; return (0, eval)("globalThis.held"); }
function pointAt(i: number): Point { return { x: i, y: i * 2 }; }
type Measure = (p: Point) => number;
interface Maker { make(i: number): Point }
function probe(f: Measure, m: Maker, p: Point): number {
  return f(p) + 1 + m.make(1).x;
}
console.log(open(probe)(p => p.x, { make: pointAt }, pointAt(1)));
//// a-literal-in-run-time-text-has-the-names-of-a-type-that-the-text-was-handed.ts
// An object literal in text that becomes code at run time has the names of a declared type, one of whose objects the text was handed, and reaches a function that takes the type.
interface Payload { value: unknown; issues: string[]; aborted?: boolean }
function check(p: Payload): number { return p.issues.length + (p.aborted ? 1 : 0) + (typeof p.value === "number" ? p.value : 0); }
const text = process.env.OTHER_TEXT ?? "return check(i & 1 ? { value: i & 2 ? i : 'text', issues: [] } : given)";
const made = new Function("check", "given", "i", text) as (c: typeof check, given: Payload, i: number) => number;
const turns = 1000;
const given: Payload = { value: turns > 1 ? String(turns) : turns, issues: [] };
let sum = 0;
for (let i = 0; i < turns; i++) sum += made(check, given, i | 1);
console.log(sum);
//// a-literal-in-run-time-text-holds-undefined-and-null.ts
// Object literals in run-time text reach typed code with undefined, null, arrays of every storage and things like arrays in their fields: where the field's type has them, and where it has not.
interface Payload { value: unknown; issues: string[]; aborted?: boolean }
interface Row { name: string | null; count: number | undefined; next: Row | null; tags: string[] }
function describe(v: unknown): string { return v === undefined ? "undefined" : v === null ? "null" : typeof v === "object" ? JSON.stringify(v) : typeof v + ":" + String(v); }
function check(p: Payload): string { return describe(p.value) + "," + describe(p.issues) + "," + describe(p.aborted) + "," + ("value" in p) + "," + Object.keys(p).join("+") + "," + JSON.stringify(p); }
function read(r: Row): string { return describe(r.name) + "," + describe(r.count) + "," + describe(r.next) + "," + describe(r.tags) + "," + Object.keys(r).join("+") + "," + JSON.stringify(r); }
function own(i: number): string { return check({ value: i, issues: [] }) + read({ name: "n", count: i, next: null, tags: [] }); }
const payload = new Function("check", "v", "w", "return check({ value: v, issues: w })") as (c: typeof check, v: unknown, w: unknown) => string;
const whole = new Function("check", "v", "w", "a", "return check({ value: v, issues: w, aborted: a })") as (c: typeof check, v: unknown, w: unknown, a: unknown) => string;
const row = new Function("read", "a", "b", "c", "d", "return read({ name: a, count: b, next: c, tags: d })") as (r: typeof read, a: unknown, b: unknown, c: unknown, d: unknown) => string;
class List extends Array<string> {}
const values: unknown[] = [undefined, null, 0, 1.5, "text", true, false, [], ["a"], {}, { name: null, count: undefined, next: null, tags: [] }, Symbol.iterator, 10n, () => 1,
  [1], [1.5], [, "hole"], List.of("l"), new Uint8Array(2), Object.freeze(["f"]), new Proxy(["p"], {}), Object.assign(["e"], { extra: 1 }), { length: 1, 0: "like" }, new Set(["s"])];
const seen = new Map<string, number>();
function note(line: string) { seen.set(line, (seen.get(line) ?? 0) + 1); }
note(own(1));
for (let turn = 0; turn < 40; turn++) {
  for (const v of values) {
    const s = typeof v === "symbol" || typeof v === "bigint" || typeof v === "function";
    if (s) {
      note(new Function("p", "v", "const o = { value: v, issues: [] }; return typeof p(o)")((p: Payload) => p.value, v));
      continue;
    }
    note(payload(check, v, []));
    note(payload(check, 1, v));
    note(whole(check, v, [], v));
    note(row(read, v, 1, null, []));
    note(row(read, "n", v, null, []));
    note(row(read, "n", 1, v, []));
    note(row(read, "n", 1, null, v));
    note(row(read, v, v, v, v));
  }
}
for (const [line, count] of seen) console.log(count, line);
//// a-literal-in-run-time-text-reaches-a-type-whose-fields-are-any.ts
// An object literal in run-time text reaches typed code. The fields of the type are any.
interface Payload { value: unknown; issues: any; aborted?: any }
function check(p: Payload): number { return p.issues.length + (p.aborted ? 1 : 0) + (typeof p.value === "number" ? p.value : 0); }
function own(i: number): number { return check({ value: i, issues: [] }); }
const text = "return check({ value: i, issues: [] })";
const made = new Function("check", "i", text) as (c: typeof check, i: number) => number;
const turns = 1000;
let sum = own(1);
for (let i = 0; i < turns; i++) sum += made(check, i & 7);
console.log(sum);
