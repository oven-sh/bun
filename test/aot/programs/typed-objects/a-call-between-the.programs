//// arrays-of-plain-objects-read-as-records.ts
type Item = { sku: string; quantity: number };
type Line = { item: Item; price: number; note: string | null };
const makeItem = (sku: string, quantity: number): Item => ({ sku, quantity });
const makeLine = (item: Item, price: number): Line => ({ item, price, note: null });
const plain = (text: string): any => JSON.parse(text);
function sumItems(items: Item[]): number {
  let sum = 0;
  for (let i = 0; i < items.length; i++) sum += items[i].sku.length + items[i].quantity;
  return sum;
}
function sumItemsInTurn(items: Item[]): number {
  let sum = 0;
  for (const item of items) sum += item.sku.length + item.quantity;
  return sum;
}
function sumLines(lines: Line[]): number {
  let sum = 0;
  for (const line of lines) sum += line.item.quantity * line.price + (line.note === null ? 0 : line.note.length);
  return sum;
}
const hand: (value: any) => any = [(value: any) => value, (value: any) => [value]][JSON.parse("0")];
////= lines-20	sumItemsInLoop	sumItems
////= lines-20	sumItemsInTurnInLoop	sumItemsInTurn
////= lines-20	sumLinesInLoop	sumLines
////= show
console.log(sumItemsInLoop([makeItem("a", 1)]), sumItemsInTurnInLoop([makeItem("b", 2)]), sumLinesInLoop([makeLine(makeItem("c", 3), 2)]));
for (let turn = 0; turn < 3; turn++) {
  const text = `[{"sku":"x${turn}","quantity":${turn}},{"sku":"yy","quantity":2.5},{"sku":"","quantity":-0}]`;
  const parsed = plain(text);
  const held = [...parsed];
  show("parsed", () => sumItemsInLoop(parsed) + " " + JSON.stringify(parsed));
  show("parsed again", () => sumItemsInTurnInLoop(parsed) + " " + parsed.every((item: any, i: number) => item === held[i]) + " " + Object.keys(parsed[0]).join());
  const inTurn = plain(text);
  show("in turn first", () => sumItemsInTurnInLoop(inTurn) + " " + sumItemsInLoop(inTurn) + " " + JSON.stringify(inTurn));
  const mixed = plain('[0,{"sku":"plain","quantity":2},{"quantity":3,"sku":"other order"},{"sku":"more","quantity":4,"more":true}]');
  mixed[0] = makeItem("typed", 1);
  show("mixed", () => sumItemsInLoop(mixed) + " " + JSON.stringify(mixed));
  mixed[1].quantity = 20;
  mixed[3].late = 1;
  show("mixed after stores", () => sumItemsInTurnInLoop(mixed) + " " + JSON.stringify(mixed));
  const twice = plain('{"sku":"twice","quantity":1}');
  const several: any[] = [twice, twice, twice];
  show("one object three times", () => sumItemsInLoop(several) + " " + sumItemsInTurnInLoop(several) + " " + (several[0] === several[2]));
  const lines = plain('[{"item":{"sku":"n","quantity":2},"price":3,"note":null},{"item":{"sku":"m","quantity":1},"price":0.5,"note":"note"}]');
  const child = lines[0].item;
  show("nested", () => sumLinesInLoop(lines) + " " + JSON.stringify(lines) + " " + (lines[0].item === child));
  show("nested again", () => sumLinesInLoop(lines));
  const withTypedChild = plain('[{"item":null,"price":2,"note":null}]');
  withTypedChild[0].item = makeItem("t", 2);
  show("a typed child", () => sumLinesInLoop(withTypedChild) + " " + JSON.stringify(withTypedChild));
  const shared = plain('[{"item":null,"price":2,"note":null},{"item":null,"price":3,"note":"n"}]');
  shared[0].item = shared[1].item = plain('{"sku":"shared","quantity":5}');
  show("a shared child", () => sumLinesInLoop(shared) + " " + (shared[0].item === shared[1].item));
  const withHole = plain('[{"sku":"a","quantity":1},0,{"sku":"b","quantity":2}]');
  delete withHole[1];
  show("a hole", () => sumItemsInLoop(withHole));
  show("null", () => sumItemsInLoop(plain('[{"sku":"a","quantity":1},null]')));
  show("a number", () => sumItemsInLoop(plain('[{"sku":"a","quantity":1},7]')));
  show("a wrong field", () => sumItemsInLoop(plain('[{"sku":"a","quantity":1},{"sku":1,"quantity":1}]')));
  show("a wrong field in turn", () => sumItemsInTurnInLoop(plain('[{"sku":"a","quantity":1},{"sku":"b","quantity":"1"}]')));
  show("a missing field", () => sumItemsInLoop(plain('[{"sku":"a"}]')));
  show("a wrong child", () => sumLinesInLoop(plain('[{"item":{"sku":"n","quantity":"2"},"price":3,"note":null}]')));
  const wrongLater = plain('[{"item":{"sku":"n","quantity":2},"price":"3","note":null}]');
  show("a good child of a wrong parent", () => sumLinesInLoop(wrongLater));
  show("and what is left of it", () => JSON.stringify(wrongLater) + " " + Object.keys(wrongLater[0].item).join());
  const withGetter = plain('[{"quantity":1}]');
  Object.defineProperty(withGetter[0], "sku", { get: () => "got", enumerable: true, configurable: true });
  show("a getter", () => sumItemsInLoop(withGetter));
  const frozen = plain('[{"sku":"f","quantity":1}]');
  Object.freeze(frozen[0]);
  show("frozen elements", () => sumItemsInLoop(frozen) + " " + Object.isFrozen(frozen[0]));
  show("a frozen array", () => sumItemsInLoop(Object.freeze(plain('[{"sku":"fa","quantity":1}]'))));
  const sealed = plain('[{"sku":"s","quantity":1}]');
  Object.seal(sealed[0]);
  show("sealed elements", () => sumItemsInLoop(sealed) + " " + Object.isSealed(sealed[0]));
  const inherits = plain('[{"quantity":1}]');
  Object.setPrototypeOf(inherits[0], plain('{"sku":"inherited"}'));
  show("an inherited field", () => sumItemsInLoop(inherits));
  show("empty", () => sumItemsInLoop(plain("[]")) + sumItemsInTurnInLoop(plain("[]")) + sumLinesInLoop(plain("[]")));
  const many: any[] = [];
  for (let i = 0; i < 50; i++) many.push(plain(i % 3 ? `{"sku":"s${i}","quantity":${i}}` : `{"quantity":${i},"sku":"r${i}"}`));
  show("many", () => sumItemsInLoop(many) + " " + sumItemsInTurnInLoop(many));
  const large = plain('[{"sku":"big","quantity":4294967296},{"sku":"small","quantity":-2147483648},{"sku":"tiny","quantity":1e-7}]');
  show("numbers", () => sumItemsInLoop(large) + " " + JSON.stringify(large));
  if (turn === 1 && typeof Bun !== "undefined") Bun.gc(true);
  show("held", () => sumItemsInLoop(held));
}
//// as-const-satisfies.ts
// `as const satisfies T`: the object has the type of the expression, not the type it is only checked against.
type Key = "first" | "second"
export const FILES = { first: "one.json", second: "two.json" } as const satisfies Record<Key, string>
const IDS = ["first", "second"] as const satisfies readonly Key[]
function pick(key: Key): string { return FILES[key] }
console.log(FILES.first, pick("second"), IDS.join(), Object.keys(FILES).join())
const plain = { first: 1, second: 2 } satisfies Record<Key, number>
console.log(plain.first + plain.second)
const nested = { inner: { first: "a", second: "b" } } as const satisfies { inner: Record<Key, string> }
console.log(nested.inner.second)
//// auxiliary-evacuation-compiled-cells.ts
// Evacuating Auxiliary blocks after each full collection must move only real butterflies: offset 8 of a compiled object or a slim closure is not a butterfly pointer.
const count = 2000;
const rounds = 3;
const bagSize = 12;

class Leaf {
  weight: number;
  constructor(weight: number) {
    this.weight = weight;
  }
}

class Wide {
  seed: number;
  n0?: number; n1?: number; n2?: number; n3?: number; n4?: number; n5?: number; n6?: number; n7?: number;
  s0?: string; s1?: string; s2?: string; s3?: string; s4?: string; s5?: string; s6?: string; s7?: string;
  l0?: Leaf; l1?: Leaf; l2?: Leaf; l3?: Leaf; l4?: Leaf; l5?: Leaf; l6?: Leaf; l7?: Leaf;
  constructor(seed: number) {
    this.seed = seed;
  }
  fill() {
    const seed = this.seed;
    this.n0 = seed + 0.5; this.n1 = seed + 1.5; this.n2 = seed + 2.5; this.n3 = seed + 3.5;
    this.n4 = seed + 4.5; this.n5 = seed + 5.5; this.n6 = seed + 6.5; this.n7 = seed + 7.5;
    this.s0 = String(seed); this.s1 = String(seed + 1); this.s2 = String(seed + 2); this.s3 = String(seed + 3);
    this.s4 = String(seed + 4); this.s5 = String(seed + 5); this.s6 = String(seed + 6); this.s7 = String(seed + 7);
    this.l0 = new Leaf(seed); this.l1 = new Leaf(seed + 1); this.l2 = new Leaf(seed + 2); this.l3 = new Leaf(seed + 3);
    this.l4 = new Leaf(seed + 4); this.l5 = new Leaf(seed + 5); this.l6 = new Leaf(seed + 6); this.l7 = new Leaf(seed + 7);
  }
  checksum(): number {
    if (this.n0 === undefined) return this.seed;
    const numbers = this.n0 + this.n1! + this.n2! + this.n3! + this.n4! + this.n5! + this.n6! + this.n7!;
    const strings = Number(this.s0) + Number(this.s1) + Number(this.s2) + Number(this.s3) + Number(this.s4) + Number(this.s5) + Number(this.s6) + Number(this.s7);
    const leaves = this.l0!.weight + this.l1!.weight + this.l2!.weight + this.l3!.weight + this.l4!.weight + this.l5!.weight + this.l6!.weight + this.l7!.weight;
    return numbers + strings + leaves;
  }
}

function createWide(seed: number): Wide {
  const wide = new Wide(seed);
  if (seed % 8) wide.fill();
  return wide;
}

function createReader(seed: number): () => number {
  const leaf = new Leaf(seed);
  return () => leaf.weight;
}

function createTaggedReader(seed: number): any {
  const leaf = new Leaf(seed);
  const reader: any = () => leaf.weight;
  reader.tag = seed;
  reader.label = String(seed + 1);
  return reader;
}

function createBag(seed: number): any {
  const bag: any = {};
  for (let i = 0; i < bagSize; i++) bag["p" + i] = seed + i;
  return bag;
}

function bagChecksum(bag: any): number {
  let total = 0;
  for (let i = 0; i < bagSize; i++) total += bag["p" + i];
  return total;
}

function createList(seed: number): any {
  const list: any = [seed, seed + 1, seed + 2];
  list.label = String(seed + 3);
  list.total = 3 * seed + 3;
  return list;
}

function populate<T>(values: T[], create: (seed: number) => T, firstSeed: number) {
  for (let i = 0; i < count; i++) values.push(create(firstSeed + i));
}

function keepEveryTenth<T>(values: T[]): T[] {
  return values.filter((_, index) => index % 10 === 0);
}

function sum<T>(values: T[], checksum: (value: T) => number): number {
  let total = 0;
  for (const value of values) total += checksum(value);
  return total;
}

let wides: Wide[] = [];
let readers: (() => number)[] = [];
let taggedReaders: any[] = [];
let bags: any[] = [];
let lists: any[] = [];

for (let round = 0; round <= rounds; round++) {
  if (round > 0) {
    wides = keepEveryTenth(wides);
    readers = keepEveryTenth(readers);
    taggedReaders = keepEveryTenth(taggedReaders);
    bags = keepEveryTenth(bags);
    lists = keepEveryTenth(lists);
    Bun.gc(true);
  }
  const firstSeed = round * count;
  populate(wides, createWide, firstSeed);
  populate(readers, createReader, firstSeed);
  populate(taggedReaders, createTaggedReader, firstSeed);
  populate(bags, createBag, firstSeed);
  populate(lists, createList, firstSeed);
}

console.log("class instances", wides.length, sum(wides, wide => wide.checksum()));
console.log("called closures", readers.length, sum(readers, reader => reader()));
console.log("closures with properties", taggedReaders.length, sum(taggedReaders, reader => reader() + reader.tag + Number(reader.label)));
console.log("plain objects", bags.length, sum(bags, bagChecksum));
console.log("arrays with named properties", lists.length, sum(lists, list => list[0] + list[1] + list[2] + list.total + Number(list.label)));
//// base-constructor-additions-before-subclass-fields.ts
// The fields of a class that extends another are defined when `super()` has returned: whatever the constructor of the other class has created by then comes before them among the keys, for good.
const keysOf = (object: object): string => {
  const inherited: string[] = [];
  for (const key in object) inherited.push(key);
  return [Object.keys(object), Object.getOwnPropertyNames(object), Reflect.ownKeys(object), Object.entries(object).map(entry => entry[0]), Object.keys({ ...object }), Object.keys(Object.assign({}, object)), inherited].map(keys => keys.join()).join(" ");
};
class Model { id = 1; declare createdAt?: string; constructor() { this.createdAt = "today"; } }
class User extends Model { name = "u"; }
console.log(JSON.stringify(new User()), keysOf(new User()));
class Bound { n = 1; label: string; constructor(label: string) { this.label = label; this.who = this.who.bind(this); } who(): string { return this.label; } }
class HeirOfBound extends Bound { more = 2; }
console.log(keysOf(new Bound("b")), "|", keysOf(new HeirOfBound("h")), new HeirOfBound("h").who());
class Extra { n = 1; constructor() { (this as any).x = 1; } }
class HeirOfExtra extends Extra { more = 2; }
console.log(keysOf(new HeirOfExtra()), JSON.stringify(new HeirOfExtra()));
class Declared { n = 1; declare opt?: number; constructor() { this.opt = 1; } }
class HeirOfDeclared extends Declared { more = 2; }
console.log(keysOf(new HeirOfDeclared()), JSON.stringify(new HeirOfDeclared()));
class Arrow { n = 1; constructor() { this.m = () => 1; } m(): number { return 0; } }
class HeirOfArrow extends Arrow { more = 2; }
console.log(keysOf(new HeirOfArrow()), new HeirOfArrow().m());
class First { n = 1; constructor() { this.m = this.m.bind(this); } m(): number { return 0; } }
class Second extends First { more = 2; constructor() { super(); this.k = this.k.bind(this); } k(): number { return 1; } }
class Third extends Second { last = 3; }
console.log(keysOf(new Second()), "|", keysOf(new Third()));
class FieldsBehind { constructor() { this.m = this.m.bind(this); } m(): number { return 0; } n = 1; }
class HeirOfFieldsBehind extends FieldsBehind { more = 2; }
console.log(keysOf(new HeirOfFieldsBehind()));
class Optional { n = 1; opt?: number; constructor() { this.opt = 1; } }
class HeirOfOptional extends Optional { more = 2; }
console.log(keysOf(new HeirOfOptional()), JSON.stringify(new HeirOfOptional()));
let last = "";
for (let i = 0; i < 300; i++) last = keysOf(new Third()) + keysOf(new User()) + keysOf(new HeirOfExtra());
console.log(last);
//// behavior-differs-with-enforced-types.ts
// Code that type-checks and in which a written type is false at run time, or that writes to a built-in: a store to a locked built-in throws, and everything else is as in plain Bun: a value of another kind gets where it is put and is read as what it is, and the program's own objects and classes and the built-ins that are not locked change as they are told.
function show(label: string, f: () => unknown) { try { const v = f(); console.log(label + " => " + (typeof v === "string" ? JSON.stringify(v) : String(v))) } catch (e) { console.log(label + " => throws " + (e as Error).constructor.name) } }
interface User { name: string; age: number }
interface Point { x: number; y: number }
class Account { constructor(public owner: string, public balance: number) {} deposit(n: number) { this.balance += n; return this.balance } }

show("01 a field of another kind in annotated JSON", () => { const u: User = JSON.parse('{"name":"ada","age":"36"}'); return u.age + 1 });
show("02 good JSON passes", () => { const u: User = JSON.parse('{"name":"ada","age":36}'); return u.age + 1 });
show("03 missing field", () => { const u: User = JSON.parse('{"name":"ada"}'); return u.age });
show("04 bang on a missing element", () => { function first(xs: number[]) { return xs[0]! } return first([]) });
show("05 bang on optional", () => { function f(o: { n?: number }) { const n = o.n!; return n } return f({}) });
show("06 as number on a string", () => { const raw: any = "5"; return (raw as number) + 1 });
show("07 as string on a number", () => { const raw: any = 5; return (raw as string) + 1 });
show("08 any into a typed parameter", () => { function area(p: Point) { return p.x + p.y } const bad: any = { x: "2", y: 3 }; return area(bad) });
show("09 wrong store through any", () => { const p: Point = { x: 1, y: 2 }; (p as any).x = "one"; return typeof p.x });
show("10 delete a required field", () => { const p: Point = { x: 1, y: 2 }; delete (p as any).x; return p.x });
show("11 extra property is fine", () => { const p: Point = { x: 1, y: 2 }; (p as any).z = 3; return Object.keys(p).join() });
show("12 patch Array.prototype.map", () => { (Array.prototype as any).map = function () { return ["hijacked"] }; return [1, 2].map(x => x * 2).join() });
show("13 prototype pollution", () => { (Object.prototype as any).isAdmin = true; return ({} as any).isAdmin });
show("14 pollution by __proto__", () => { const o: any = {}; o.__proto__.polluted = "yes"; return ({} as any).polluted });
show("15 replace Math.max", () => { (Math as any).max = () => 42; return Math.max(1, 2) });
show("16 add to Math", () => { (Math as any).tau = 6.28; return (Math as any).tau });
show("17 replace JSON.parse", () => { const parse = JSON.parse; (JSON as any).parse = () => "pwned"; try { return JSON.parse("1") } finally { (JSON as any).parse = parse } });
show("18 replace a method of a class", () => { (Account.prototype as any).deposit = function () { return -1 }; return new Account("a", 1).deposit(5) });
show("19 wrong element in a typed array", () => { const xs: number[] = JSON.parse('[1,"2",3]'); let s = 0; for (const x of xs) s += x; return s });
show("20 wrong type returned by any", () => { function parse(s: string): number { const v: any = s; return v } return parse("7") + 1 });
show("21 null into a non-null parameter", () => { function len(s: string) { return s.length } const n: any = null; return len(n) });
show("22 undefined into number", () => { function twice(n: number) { return n * 2 } const u: any = undefined; return twice(u) });
show("23 class instance faked by a literal", () => { function pay(a: Account) { return a.deposit(1) } const fake: any = { owner: "x", balance: 0, deposit() { return 999 } }; return pay(fake) });
show("24 union discriminant lie", () => { type S = { kind: "circle"; r: number } | { kind: "square"; w: number }; const s: S = JSON.parse('{"kind":"triangle","w":1}'); return s.kind });
show("25 enum out of range", () => { enum Color { Red, Green } const c: Color = JSON.parse("7"); return c });
show("26 literal type lie", () => { const mode: "on" | "off" = JSON.parse('"maybe"'); return mode });
show("27 readonly store through any", () => { const p: { readonly id: number } = { id: 1 }; (p as any).id = 2; return p.id });
show("28 freeze still works", () => { const p: Point = Object.freeze({ x: 1, y: 2 }); try { (p as any).x = 5 } catch {} return p.x });
show("29 function text", () => { function secret() { return "s3cr3t" } return String(secret).includes("s3cr3t") });
show("30 Symbol.iterator of arrays replaced", () => { (Array.prototype as any)[Symbol.iterator] = function* () { yield "hijacked" }; return [...[1, 2]].join() });
