//// a-returned-literal-lists-a-field-read-again-behind-a-test-for-null.ts
declare const console: { log(...values: any[]): void };

const sources: Record<string, string> = { first: "remote", second: "default", third: "override" };
const thisProcess: { lastServed: boolean | null } = { lastServed: null };

function read(name: string): { isOn: boolean; source: string } {
  const source = sources[name];
  const isOn = name !== "third";
  if (source === "remote") {
    thisProcess.lastServed = isOn;
    return { isOn, source };
  }
  return thisProcess.lastServed === null ? { isOn, source: "disabled" } : { isOn: thisProcess.lastServed, source: "kept" };
}

for (const name of ["second", "constructor", "third", "first", "second", "constructor", "missing"]) {
  const { isOn, source } = read(name);
  console.log(name, isOn, source);
}
//// a-store-through-a-union-of-which-one-member-never-gets-the-field.ts
// A function that callers from outside reach has a version whose parameter is only expected to have the layouts of its written type.
// Objects of one of them never get to a store of the optional fields, so they have no room for them, and somebody reads the fields of such an object.
interface Filled { id: number; late?: string; count?: number }
interface Bare { id: number; late?: string; count?: number }
type Entry = Filled | Bare

function filled(id: number): Filled {
  const entry: Filled = { id }
  entry.late = "first" + id
  entry.count = id
  return entry
}
function bare(id: number): Bare { return { id } }

function replace(entry: Entry, value: string | undefined): number {
  if (entry.late !== undefined) entry.late = value
  return entry.id
}
function bump(entry: Entry, by: number): number {
  const id = entry.id
  entry.count = (entry.count ?? 0) + by
  return id
}
function show(entry: Filled): string { return entry.id + ":" + entry.late + ":" + entry.count + ":" + Object.keys(entry).join("") }

const kept = bare(7)
const registry: Record<string, unknown> = structuredClone({})
registry.replace = replace
registry.bump = bump

const list: Filled[] = [filled(1), filled(2), filled(3)]
let sum = 0
for (const entry of list) sum += replace(entry, "x" + entry.id) + bump(entry, 10)
console.log(sum, list.map(show).join(" "))

const copies: Filled[] = structuredClone(list)
copies.push(structuredClone({ id: 4 }))
for (const entry of copies) sum += (registry.replace as typeof replace)(entry, "y" + entry.id) + (registry.bump as typeof bump)(entry, 100)
console.log(sum, copies.map(show).join(" "))

for (const entry of list) sum += replace(entry, undefined) + bump(entry, 1000)
console.log(sum, list.map(show).join(" "))
for (const entry of list) sum += replace(entry, "z" + entry.id)
console.log(sum, list.map(show).join(" "), kept.id, kept.late, kept.count)
//// a-test-of-a-kind-narrows-its-object.ts
// switch (n.kind) and n.kind === K say which objects n can be: what one case stores lands on that kind alone, and the keys of the others stay as they were.
const enum Kind { A = 1, B = 2, C = 3 }
interface Base { kind: Kind; pos: number }
interface NodeA extends Base { kind: Kind.A; a: number }
interface NodeB extends Base { kind: Kind.B; b: string }
interface NodeC extends Base { kind: Kind.C; c: Node | undefined }
type Node = NodeA | NodeB | NodeC;
function NodeObject(this: Base, kind: Kind, pos: number) { this.kind = kind; this.pos = pos }
const NodeConstructor = NodeObject as any as new (kind: Kind, pos: number) => Base;
function createA(a: number): NodeA { const n = new NodeConstructor(Kind.A, 0) as NodeA; n.a = a; return n }
function createB(b: string): NodeB { const n = new NodeConstructor(Kind.B, 0) as NodeB; n.b = b; return n }
function createC(c: Node | undefined): NodeC { const n = new NodeConstructor(Kind.C, 0) as NodeC; n.c = c; return n }
function weigh(n: Node): number {
  switch (n.kind) {
    case Kind.A: return n.a;
    case Kind.B: return n.b.length;
    case Kind.C: return n.c ? weigh(n.c) + 1 : 0;
  }
}
function mark(n: Node) {
  if (n.kind === Kind.A) (n as any).markedA = true;
  else if (n.kind === Kind.B) (n as any).markedB = true;
}
const all: Node[] = [];
for (let i = 0; i < 30; i++) all.push(i % 3 === 0 ? createA(i) : i % 3 === 1 ? createB("s" + i) : createC(all[i - 1]));
let total = 0;
for (const n of all) { mark(n); total += weigh(n) }
console.log(total, Object.keys(all[0]!).join(), Object.keys(all[1]!).join(), Object.keys(all[2]!).join());
//// a-typed-object-is-reached-through-every-form-of-the-language.ts
// One interface, read and written through patterns, defaults, optional chains, loops, callbacks, Maps, Sets, records, awaits, generators, spreads, mapped and intersection types, type parameters, assertions, closures, conditionals, tuples, rest parameters and a declared this.
const launder: <T>(x: T) => T = (globalThis as any).launder ?? ((x: any) => x);
interface Q { r: number; s: string }
interface P { a: number; b: string; q: Q; list: Q[]; opt?: Q; cb: (x: number) => number; m(x: number): number }
const mk = (i: number): P => ({ a: i, b: "b" + i, q: { r: i, s: "s" }, list: [{ r: 1, s: "x" }], cb: x => x + i, m(x) { return x * i; } });
let out = 0; const use = (x: number | string | undefined | boolean) => { out += typeof x === "number" ? x : typeof x === "string" ? x.length : 1; };

function paramPattern({ a, q: { r }, list: [first] }: P) { use(a); use(r); use(first.r); }
function paramDefault(p: P = mk(1)) { use(p.a); use(p.q.r); }
function localPattern(p: P) { const { a, b, q } = p; use(a); use(b); use(q.r); const { r, s } = q; use(r); use(s); }
function restPattern(p: P) { const { a, ...rest } = p; use(a); use(rest.b); use(rest.q.r); }
function chain(p: P | undefined) { use(p?.a); use(p?.q.r); use(p?.opt?.r); use(p?.m(1)); use(p?.cb(1)); use(p?.list[0]?.r); }
function forOfPattern(ps: P[]) { for (const { a, q } of ps) { use(a); use(q.r); } for (const p of ps) { use(p.b); } }
function forIndex(ps: P[]) { for (let i = 0; i < ps.length; i++) { const p = ps[i]; use(p.a); use(ps[i].q.r); } }
function callbacks(ps: P[]) { use(ps.map(p => p.a).length); ps.forEach(p => use(p.q.r)); use(ps.reduce((t, p) => t + p.a, 0)); const f = ps.find(p => p.a > 0); use(f?.a); use(ps.filter(p => p.a > 0)[0].b); use(ps.some(p => p.q.r > 0)); }
function maps(m: Map<string, P>, s: Set<P>) { const p = m.get("k"); if (p) { use(p.a); use(p.q.r); } for (const [k, v] of m) { use(k); use(v.a); } for (const v of m.values()) use(v.b); for (const v of s) use(v.a); m.forEach(v => use(v.a)); }
function records(r: Record<string, P>, k: string) { const p = r[k]; if (p) use(p.a); for (const key in r) use(r[key].a); for (const v of Object.values(r)) use(v.a); for (const [key, v] of Object.entries(r)) { use(key); use(v.a); } }
async function awaits(pp: Promise<P>, f: () => Promise<P>) { const p = await pp; use(p.a); use((await f()).q.r); const [x, y] = await Promise.all([pp, f()]); use(x.a); use(y.b); }
function* gen(ps: P[]): Generator<P, void, Q | undefined> { for (const p of ps) { const sent = yield p; if (sent) use(sent.r); } }
function useGen(ps: P[]) { for (const p of gen(ps)) use(p.a); const g = gen(ps); const n = g.next(); if (!n.done) use(n.value.a); }
function spreads(p: P) { const c = { ...p, c: 1 }; use(c.a); use(c.c); use(c.q.r); const d = { ...p }; use(d.b); const e = Object.assign({}, p); use(e.a); const l = [...p.list]; use(l[0].r); }
type AB = { a: number } & { b: string }; type Part = Partial<P>; type RO = Readonly<P>; type Pk = Pick<P, "a" | "q">; type Om = Omit<P, "list">; type Req = Required<P>;
function aliases(ab: AB, pa: Part, ro: RO, pk: Pk, om: Om, rq: Req, qq: P["q"]) { use(ab.a); use(ab.b); use(pa.a); use(pa.q?.r); use(ro.a); use(ro.q.r); use(pk.a); use(pk.q.r); use(om.a); use(om.q.r); use(rq.opt.r); use(qq.r); }
function keyed<K extends keyof P>(p: P, k: K, k2: "a" | "b") { const v = p[k]; use(typeof v); use(p[k2]); use(p["a"]); }
function generic<T extends P>(t: T, ts: T[]) { use(t.a); use(t.q.r); use(ts[0].a); for (const x of ts) use(x.b); }
function generic2<T extends { q: Q }>(t: T) { use(t.q.r); }
function asserted(x: unknown, y: any, z: P | null) { use((x as P).a); use((y as P).q.r); use(z!.a); const w = y as P; use(w.b); const v: P = y; use(v.a); use((<P>x).b); use((x as P satisfies P).a); }
function caught() { try { throw mk(1); } catch (e) { use((e as P).a); } }
