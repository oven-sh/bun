//// a-call-between-the-birth-of-a-plain-object-and-its-cast.ts
type Message = { id: number; tags: string[] };
const makeMessage = (id: number, tags: string[]): Message => ({ id, tags });
const read = (message: Message) => message.id + message.tags.length;
const tags = ["x", "y"];
let kept: any;
let depth = 0;
function walk(n: number): number {
  depth++;
  if (kept && n === 0) kept.id += 100;
  return n > 0 ? walk(n - 1) + walk(n - 2) : 1;
}
async function later(n: number): Promise<number> {
  const message: any = { id: n, tags };
  kept = message;
  await null;
  return read(message);
}
function* steps(n: number) {
  const message: any = { id: n, tags };
  kept = message;
  yield 1;
  yield read(message);
}
console.log(read(makeMessage(1, tags)));
for (let i = 0; i < 3; i++) {
  const message: any = { id: i, tags };
  kept = message;
  const walked = walk(3);
  console.log(walked, read(message));
}
console.log(await later(5), [...steps(6)].join(), depth);
//// a-declared-method-that-no-code-stores-by-name-gets-there-by-seven-other-roads.ts
// A type declares a method that no code stores by name. It gets there by a key put together at run time, by Object.assign, by a definition, by run-time text, by a parse.
const lines: string[] = [];
const say = (text: string): void => { lines.push(text); };
function spell(text: string): string {
  let result = "";
  for (let i = 0; i < text.length; i++) result += text[i];
  return result;
}
class Plugin {
  name = "plugin";
  run?(): string;
  stop?(): string;
}
interface Hooks {
  name: string;
  before?(): string;
  after?(): string;
}
function callAll(p: Plugin): string {
  return p.name + " " + (p.run ? p.run() : "no run") + " " + (p.stop?.() ?? "no stop") + " " + typeof p.run + " " + ("run" in p) + " " + Object.keys(p).join("+");
}
function callHooks(h: Hooks): string {
  return h.name + " " + (h.before ? h.before() : "no before") + " " + (h.after?.() ?? "no after") + " " + typeof h.before + " " + ("before" in h);
}
const roads: [string, (o: object, key: string) => void][] = [
  ["by key", (o, key) => { (o as Record<string, unknown>)[spell(key)] = () => "ran " + key; }],
  ["assign", (o, key) => { Object.assign(o, { [spell(key)]: () => "assigned " + key }); }],
  ["define", (o, key) => { Object.defineProperty(o, spell(key), { value: () => "defined " + key, enumerable: true, configurable: true, writable: true }); }],
  ["getter", (o, key) => { Object.defineProperty(o, spell(key), { get: () => () => "got " + key, enumerable: true, configurable: true }); }],
  ["reflect", (o, key) => { Reflect.set(o, spell(key), () => "reflected " + key); }],
  ["text", (o, key) => { new Function("o", "k", "o[k] = () => 'text ' + k")(o, key); }],
  ["entries", (o, key) => { for (const [k, v] of Object.entries({ [spell(key)]: () => "entry " + key })) (o as Record<string, unknown>)[k] = v; }],
];
for (const [name, road] of roads) {
  const p = new Plugin();
  say(name + " new: " + callAll(p));
  road(p, "run");
  say(name + " run: " + callAll(p));
  road(p, "stop");
  say(name + " stop: " + callAll(p));
  const h: Hooks = { name: "hooks" };
  say(name + " new: " + callHooks(h));
  road(h, "after");
  say(name + " after: " + callHooks(h));
  road(h, "before");
  say(name + " before: " + callHooks(h));
}
console.log(lines.join("\n"));
//// a-filled-slot-test-through-a-union-that-holds-the-field-in-two-forms.ts
// Three types hold an optional field of one name in two forms, a number and a reference, and a store of another type may move it out of its slot.
// So a read through their union first tests that the slot is filled, and both the test and the read ask for the shape to find the slot.
interface Text { id: number; value?: string }
interface Count { id: number; value?: number }
interface Label { id: number; extra: number; value?: string }
type Item = Text | Count | Label

function text(id: number, value?: string): Text { const item: Text = { id }; if (value !== undefined) item.value = value; return item }
function count(id: number, value?: number): Count { const item: Count = { id }; if (value !== undefined) item.value = value; return item }
function label(id: number, value?: string): Label { const item: Label = { id, extra: id * 2 }; if (value !== undefined) item.value = value; return item }
function spoil(item: Item, value: unknown): Item { (item as { value?: unknown }).value = value; return item }

let reads = 0
function read(item: Item): unknown { return item.value }
function readTwice(item: Item): string {
  const first = item.value
  reads++
  const second = item.value
  return first + "|" + second
}
function readInLoop(item: Item, times: number): string {
  let result = ""
  for (let i = 0; i < times; i++) { result += item.value; reads++ }
  return result
}

const items: Item[] = [text(1, "a"), text(2), count(3, 1.5), count(4), label(5, "b"), label(6), count(7, 0), text(8, "")]
const spoiled: Item[] = [spoil(text(9, "c"), 9), spoil(count(10, 2), "ten"), spoil(label(11), true)]
const out: string[] = []
for (const item of items) out.push(String(read(item)), readTwice(item), readInLoop(item, 2))
console.log(out.join(" "), reads, spoiled.map(item => String((item as { value?: unknown }).value)).join())

function replace(item: Item, text: string, number: number): void {
  if (item.value === undefined) return
  if (typeof item.value === "number") item.value = number
  else item.value = text
}
for (const item of items) replace(item, "t" + item.id, item.id + 0.5)
console.log(items.map(item => item.id + ":" + item.value + ":" + Object.keys(item).join("")).join(" "))
//// a-function-asks-a-record-of-options-which-of-them-it-has.ts
// `"padding" in style`: a function asks a record of options which of them it has.
declare const process: { argv: string[] };
declare const console: { log(...values: any[]): void };
type Styles = { padding?: number; paddingX?: number; paddingY?: number; paddingLeft?: number; paddingRight?: number; margin?: number; gap?: number };
class Target { total = 0; set(edge: number, value: number | undefined): void { this.total += edge * (value ?? 1); } }
function applyPadding(target: Target, style: Styles): void {
  if ("padding" in style) target.set(1, style.padding);
  if ("paddingX" in style) target.set(2, style.paddingX);
  if ("paddingY" in style) target.set(3, style.paddingY);
  if ("paddingLeft" in style) target.set(4, style.paddingLeft);
  if ("paddingRight" in style) target.set(5, style.paddingRight);
}
const given: Styles[] = [{}, { padding: 1 }, { paddingX: 2, margin: 1 }, { gap: 1, paddingRight: undefined }];
{ (globalThis as any).kept = [applyPadding, given]; const somebody: any = (globalThis as any)[JSON.parse('"somebody"')] ?? {}; somebody[JSON.parse('"something"')] = 1; Object.defineProperty(somebody, JSON.parse('"other"'), { get() { return 1; }, configurable: true }); }
const target = new Target();
const rounds = Number(process.argv[2] ?? 1000);
for (let i = 0; i < rounds; i++) applyPadding(target, given[i & 3]!);
const inherits: Styles = Object.create({ paddingY: 7 });
applyPadding(target, inherits);
console.log(target.total);
//// a-function-field-declared-and-never-stored-is-applied-in-a-callback.ts
// A field of a function type that is declared and never stored is applied inside a callback, by two calls that each stand under a handler of their own. The build aborted: behind an edge that it had split, allocation sinking took up again an object that its second look had left out, and removed the object under a call that still named it.
function describe(value: unknown): string {
  const text = String(value);
  return typeof value + " " + (text.includes("=>") ? "a function" : text);
}
type Step = (step: number) => number;
class Planet {
  declare run: Step;
}
function probe(v: Planet): string {
  let out = "";
  const bag = { held: v };
  [0].forEach(() => {
    out += describe(bag.held.run.apply(undefined, [4]));
  });
  return out;
}
function both(): void {
  try {
    console.log(probe(new Planet()));
  } catch (error) {
    console.log("first threw");
  }
  try {
    console.log(probe(new Planet()));
  } catch (error) {
    console.log("second threw");
  }
}
both();
//// a-function-that-closes-over-the-object-is-stored-right-behind-the-literal.ts
// A literal leaves an optional field out, and the next statement stores a function into it that closes over the object: two steps, so that the function can name the object.
declare const process: { argv: string[] };
declare const console: { log(...values: any[]): void };
type Context = { cwd: string; depth: number; verbose?: boolean; root?: string; file?: () => number; parent?: Context };
function load(context: Context): number { return context.cwd.length + context.depth; }
function makeContext(cwd: string, depth: number): Context {
  const context: Context = { cwd, depth, verbose: depth > 2 };
  context.file = () => load(context);
  return context;
}
{ (globalThis as any).kept = [makeContext, load]; const somebody: any = (globalThis as any)[JSON.parse('"somebody"')] ?? {}; somebody[JSON.parse('"something"')] = 1; Object.defineProperty(somebody, JSON.parse('"other"'), { get() { return 1; }, configurable: true }); }
const rounds = Number(process.argv[2]);
let sum = 0;
for (let i = 0; i < rounds; i++) {
  const context = makeContext(i & 1 ? "/a" : "/home", i & 3);
  sum += context.file!() + (context.verbose ? 1 : 0);
}
console.log(sum);
