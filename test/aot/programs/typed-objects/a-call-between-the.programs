//// a-typed-object-is-the-global-object-of-a-context.ts
// A typed object is made the global object of a node:vm context, and text that runs there reads it, stores to it, declares variables and deletes a property: its keys keep their order, and a delete takes one key away.
declare const console: { log(...v: unknown[]): void }; declare const require: any; declare const ShadowRealm: any;
const vm = require("node:vm");
const show = (v: unknown): string => { try { return typeof v === "string" ? v : typeof v === "function" ? "function" : typeof v === "symbol" ? v.toString() : JSON.stringify(v) ?? String(v); } catch (e) { return "unshowable " + (e as Error).name; } };
const row = (name: string, f: () => unknown): void => { let t: string; try { t = show(f()); } catch (e) { t = "THROWS " + ((e as any)?.name ?? typeof e) + ": " + String((e as any)?.message).split("\n")[0].slice(0, 70); } console.log(name + ": " + t); };
const ctx = vm.createContext({});
const there = (code: string): any => vm.runInContext(code, ctx);
interface G { count: number; name: string; extra?: number }
const g: G = { count: 1, name: "g" };
row("make", () => { vm.createContext(g); return vm.isContext(g); });
for (const code of ["count + name", "count = 5; count", "var made = 1; made", "extra = 2; extra", `count = "wrong"; typeof count`, "typeof globalThis.count", "Object.keys(globalThis).join()", "delete globalThis.extra; typeof extra"]) row(code, () => vm.runInContext(code, g));
row("seen here", () => [g.count, g.name, g.extra, Object.keys(g).join()].join("|"));
//// a-value-a-check-turned-away-is-listed-in-a-literal-whose-field-flow-has-proven/main.ts
import { FIRST_TITLE, SECOND_TITLE, FIRST_ANSWER, SECOND_ANSWER } from "./texts.ts";

function pickText({ title, answer }: { title: string; answer: string }): string {
  return `${title}: ${answer}`;
}

function build({ title, answer, pickAnswer }: { title: string; answer: string; pickAnswer?: (count: number) => string | undefined }) {
  const texts = { title, answer };
  return {
    show() {
      return pickText(texts);
    },
    call(count: number) {
      const picked = pickAnswer?.(count);
      return pickText({ ...texts, answer: picked ?? answer });
    },
  };
}

const first = build({
  title: FIRST_TITLE,
  answer: FIRST_ANSWER,
  pickAnswer(count) {
    return count > 1 ? "picked" : undefined;
  },
});
const second = build({ title: SECOND_TITLE, answer: SECOND_ANSWER });

for (const gadget of [first, second]) console.log(gadget.show(), "|", gadget.call(1), "|", gadget.call(2));
//// a-value-a-check-turned-away-is-listed-in-a-literal-whose-field-flow-has-proven/names.ts
export const SEARCH_NAME = "Search";
//// a-value-a-check-turned-away-is-listed-in-a-literal-whose-field-flow-has-proven/texts.ts
import { SEARCH_NAME } from "./names.ts";

export const FIRST_TITLE = "the first";
export const SECOND_TITLE = "the second";
export const FIRST_ANSWER = `Load the first with ${SEARCH_NAME}.`;
export const SECOND_ANSWER = `Load the second with ${SEARCH_NAME}.`;
//// absent-fields-and-prototypes.ts
// An absent optional field reads through the prototype chain, which can gain the name after the field was first read.
// `bun run` tests no types, so only the compiled program throws in the last case: its answer is in the .expected.txt.
interface Entry {
  a: number
  size?: number
  label?: string
}
const chain: any = {}
function make(): Entry {
  const entry: Entry = { a: 1 }
  Object.setPrototypeOf(entry, chain)
  return entry
}
////= lines-15	readSize	entry	Entry	entry.size
////= lines-15	readLabel	entry	Entry	entry.label
function report(label: string) {
  for (let round = 0; round < 3; round++) {
    const entry = make()
    const size = readSize(entry)
    const text = readLabel(entry)
    if (round === 2) console.log(label, size, text)
  }
}

report("names absent from the chain")

chain.size = 4
chain.label = "inherited"
report("values on the chain")

let reads = 0
Object.defineProperty(chain, "size", {
  get() {
    reads++
    return 8
  },
  configurable: true,
})
report("a getter on the chain")
console.log("getter reads", reads)

delete chain.size
delete chain.label
report("the names are gone")

chain.size = null
report("null on the chain")
delete chain.size

const entries = [make(), make(), make()]
chain.size = "wrong"
for (const entry of entries) {
  try {
    console.log("wrong type", readSize(entry))
  } catch (error) {
    console.log("wrong type", (error as Error).constructor.name)
  }
}
//// absent-nullish-and-falsy-fields.ts
// Absent, undefined, null and every falsy value are distinct states of a field, for each kind of field: boolean, string, number, object, function, union.
interface Inner { id: number }
interface All {
  b?: boolean; s?: string; n?: number; o?: Inner; f?: () => string
  bn: boolean | null; sn: string | null; nn: number | null; on: Inner | null
  bu: boolean | undefined; su: string | undefined; nu: number | undefined; ou: Inner | undefined
  mix?: number | string | boolean | null
}
function text(v: unknown): string { return v === undefined ? "undefined" : v === null ? "null" : typeof v === "string" ? JSON.stringify(v) : typeof v === "object" ? "object" : typeof v === "function" ? "function" : Object.is(v, -0) ? "-0" : String(v) }
function st(o: All, k: keyof All): string { return (k in o ? "" : "~") + text(o[k]) }
function fresh(): All { return { bn: null, sn: null, nn: null, on: null, bu: undefined, su: undefined, nu: undefined, ou: undefined } }
const optionalKeys: ("b" | "s" | "n" | "o" | "f" | "mix")[] = ["b", "s", "n", "o", "f", "mix"]
const allKeys: (keyof All)[] = ["b", "s", "n", "o", "f", "bn", "sn", "nn", "on", "bu", "su", "nu", "ou", "mix"]
function dump(o: All): string { return allKeys.map(k => st(o, k)).join() + " [" + Object.keys(o).join() + "] " + JSON.stringify(o) }

const a = fresh()
console.log(dump(a))
console.log(a.b, a.s, a.n, text(a.o), text(a.f), a.bn, a.sn, a.nn, a.on, a.bu, a.su, a.nu, a.ou, a.mix)

// Falsy values.
a.b = false; a.s = ""; a.n = 0; a.bn = false; a.sn = ""; a.nn = 0; a.bu = false; a.su = ""; a.nu = 0; a.mix = 0
console.log(dump(a))
console.log(a.b === false, a.s === "", a.n === 0, a.b ?? "d", a.s ?? "d", a.n ?? "d", a.b || "d", a.s || "d", a.n || "d", a.bn ?? "d", a.sn ?? "d", a.nn ?? "d", !a.b, !a.s, !a.n)

// An explicit undefined is a key.
a.b = undefined; a.s = undefined; a.n = undefined; a.o = undefined; a.f = undefined; a.mix = undefined
console.log(dump(a))
for (const k of optionalKeys) delete a[k]
console.log(dump(a))

// Truthy values, then null where the type has it.
a.b = true; a.s = "s"; a.n = -0; a.o = { id: 1 }; a.f = () => "f"; a.bn = true; a.sn = "null"; a.nn = NaN; a.on = { id: 2 }; a.bu = true; a.su = "undefined"; a.nu = NaN; a.ou = { id: 3 }; a.mix = null
console.log(dump(a), a.o.id, a.f(), a.on.id, a.ou.id)
a.bn = null; a.sn = null; a.nn = null; a.on = null; a.bu = undefined; a.su = undefined; a.nu = undefined; a.ou = undefined
console.log(dump(a))

// The union field goes through every kind.
const seen: string[] = []
for (const v of [0, "", false, null, undefined, 1.5, "x", true, NaN, -0, 2 ** 40] as (number | string | boolean | null | undefined)[]) { a.mix = v; seen.push(st(a, "mix") + typeof a.mix) }
delete a.mix; seen.push(st(a, "mix"))
console.log(seen.join())

// null and undefined compare, add and convert differently.
const z = fresh()
console.log(z.nn == undefined, z.nn === undefined, z.nu == null, z.nu === null, (z.nn ?? 0) + 1, Number(z.nn), Number(z.nu), String(z.sn) + String(z.su), `${z.bn}${z.bu}`, typeof z.on, typeof z.ou, z.on?.id, z.ou?.id)

// Optional chaining and calls on each state.
function call(o: All): string { return [o.f?.(), o.o?.id, o.on?.id, o.s?.length, o.n?.toFixed(1), o.b?.toString()].map(text).join() }
console.log(call(fresh()), call({ ...fresh(), f: () => "called", o: { id: 7 }, on: { id: 8 }, s: "", n: 0, b: false }), call({ ...fresh(), f: undefined, o: undefined, s: undefined }))

// Literals that spell out undefined against literals that leave the field out, read at one site.
const list: All[] = [fresh(), { ...fresh(), n: undefined }, { ...fresh(), n: 0 }, { ...fresh(), n: NaN }, { n: 5, ...fresh() }]
console.log(list.map(o => st(o, "n") + ":" + Object.keys(o).indexOf("n") + ":" + Object.hasOwn(o, "n") + ":" + (o.n === undefined) + ":" + ((o.n ?? 1) + 1)).join(" "))

// Classes.
class Node0 { left: Node0 | null = null; right?: Node0; weight: number | undefined = undefined; tag?: string; live?: boolean }
const n0 = new Node0()
const show0 = () => [text(n0.left), ("right" in n0) + text(n0.right), ("weight" in n0) + text(n0.weight), text(n0.tag), text(n0.live), JSON.stringify(n0)].join()
console.log(show0())
n0.right = new Node0(); n0.left = n0.right; n0.weight = 0; n0.tag = ""; n0.live = false
console.log(show0().length, n0.left === n0.right, n0.weight, text(n0.tag), n0.live)
delete n0.right; n0.left = null; n0.weight = undefined; delete n0.tag; n0.live = undefined
console.log(show0(), "live" in n0, "tag" in n0)
//// accessor-literal-inspected-externally.ts
// An object literal with a getter, known to the rest of the program through an interface, is looked at from outside: keys, descriptors, a spread, Object.assign, for..in.
////= memoizeOne-2
let built = 0;
////= rulesOf
////= describe
const described = memoizeOne(describe);

function withGetter(): Factory {
  const made: Factory = {
    count: 0,
    get rules() {
      return rulesOf();
    },
    make(kind) {
      made.count++;
      return kind + made.rules.depth;
    },
  };
  return made;
}
const one = withGetter();
console.log(described(one));
console.log(Object.keys(one).join(), JSON.stringify(one), Object.entries(one).length);
const descriptor = Object.getOwnPropertyDescriptor(one, "rules")!;
console.log(
  typeof descriptor.get,
  descriptor.set,
  descriptor.enumerable,
  descriptor.configurable,
  "value" in descriptor,
);
const spread: Factory = { ...one };
console.log(Object.getOwnPropertyDescriptor(spread, "rules")!.value.depth, described(spread));
const assigned = Object.assign({}, one) as Factory;
console.log(typeof Object.getOwnPropertyDescriptor(assigned, "rules")!.get, assigned.rules.depth, described(assigned));
for (const key in one) console.log(key);
console.log("rules" in one, Object.hasOwn(one, "rules"), built);
//// accessor-literals-for-interface.ts
// An object literal that mixes data properties and accessors, known to the rest of the program only through an interface.
interface Place { readonly start: string; readonly top: string }
interface Root { readonly owner: Owner; readonly id: string; readonly place: Place | null; readonly notes: string[]; level: number }
class Owner { readonly name = "owner"; count = 0; bump(): number { return ++this.count; } }

let reads = 0;
function makeRoot(owner: Owner, id: string): Root {
  const held: { place: { start: string; top: string } | null; level: number } = { place: { start: "/a", top: "/a/b" }, level: 1 };
  const place: Place = { get start() { reads++; return held.place!.start; }, get top() { return held.place!.top; } };
  const root: Root = {
    owner,
    get id() { reads++; return id; },
    get place() { return held.place === null ? null : place; },
    notes: [],
    get level() { return held.level; },
    set level(value: number) { held.level = value * 2; },
  };
  return root;
}
let binding: Root = makeRoot(new Owner(), "r1");
function current(): Root { return binding; }
function idOf(root: Root): string { return root.id; }
function startOf(root: Root): string | null { return root.place === null ? null : root.place.start; }
function raise(root: Root, by: number): number { root.level = root.level + by; return root.level; }

let sum = 0;
for (let i = 0; i < 1000; i++) { sum += idOf(current()).length + (startOf(current()) ?? "").length + current().owner.bump(); }
console.log("read in a loop", sum, reads, current().owner.count);
console.log("a setter", raise(current(), 1), raise(current(), 1), current().level);
console.log("keys", Object.keys(current()).join(), JSON.stringify(current()));
console.log("descriptors", typeof Object.getOwnPropertyDescriptor(current(), "id")!.get, Object.getOwnPropertyDescriptor(current(), "id")!.set, Object.getOwnPropertyDescriptor(current(), "owner")!.writable, Object.getOwnPropertyDescriptor(current(), "level")!.enumerable);
const copy: Root = { ...current() };
console.log("a copy holds values", typeof Object.getOwnPropertyDescriptor(copy, "id")!.get, copy.id, copy.level, copy.owner === current().owner, copy.place === current().place);
copy.level = 100;
console.log("a store to the copy", copy.level, current().level);
const heir: Root = Object.create(current());
console.log("inherited", heir.id, heir.level, Object.keys(heir).length, "id" in heir, Object.hasOwn(heir, "id"));
heir.level = 3;
console.log("the setter through an heir", heir.level, current().level, Object.hasOwn(heir, "level"));
const self = { base: 5, get twice() { return this.base * 2; }, get self() { return this; } };
const seen: { readonly base: number; readonly twice: number } = self;
console.log("this in a getter", seen.twice, self.self === self, Object.create(self, { base: { value: 7 } }).twice);
Object.defineProperty(current(), "id", { get() { return "redefined"; }, configurable: true, enumerable: true });
console.log("redefined", idOf(current()), current().id);
Object.defineProperty(current(), "id", { value: "plain", writable: true, configurable: true, enumerable: true });
console.log("made a data property", idOf(current()), Object.keys(current()).join());
delete (current() as { id?: string }).id;
console.log("deleted", idOf(current()), "id" in current(), Object.keys(current()).join());
const thrower: { readonly value: number } = { get value(): number { throw new RangeError("no value"); } };
try { console.log(thrower.value); } catch (error) { console.log("a getter that throws", (error as Error).name, (error as Error).message); }
const two: Root[] = [makeRoot(new Owner(), "a"), { owner: new Owner(), id: "b", place: null, notes: ["n"], level: 9 }];
console.log("beside a literal of data alone", two.map(idOf).join(), two.map(startOf).join(), two.map(root => raise(root, 1)).join(), two.map(root => root.notes.length).join());
binding = two[1]!;
console.log("the binding holds the other", idOf(current()), startOf(current()), current().level);
Object.freeze(two[0]);
console.log("frozen", Object.isFrozen(two[0]), two[0]!.id, raise(two[0]!, 1));
//// accessor-literals-one-type-via-callback.ts
////= memoizeOne-2
let built = 0;
////= rulesOf
////= describe
const described = memoizeOne(describe);

function withGetter(): Factory {
  const made: Factory = {
    get rules() {
      return rulesOf();
    },
    make(kind) {
      made.count++;
      return kind + made.rules.depth;
    },
    count: 0,
  };
  return made;
}
function withValue(): Factory {
  const made: Factory = {
    rules: rulesOf(),
    make(kind) {
      made.count++;
      return kind + made.rules.depth;
    },
    count: 0,
  };
  return made;
}
function withBoth(): Factory {
  let kept: Rules = { depth: 100 };
  const made: Factory = {
    get rules() {
      return kept;
    },
    set rules(value) {
      kept = { depth: value.depth * 2 };
    },
    make(kind) {
      made.count++;
      return kind + made.rules.depth;
    },
    count: 0,
  };
  return made;
}
const all = [withGetter(), withValue(), withBoth(), withGetter()];
for (const one of all) console.log(described(one));
for (const one of all) {
  try {
    one.rules = { depth: 7 };
    console.log("stored", one.rules.depth);
  } catch (error) {
    console.log((error as Error).constructor.name);
  }
}
for (const one of all) console.log(describe(one));
//// aliased-nested-cast-literal-from-function.ts
// An object that is also referenced elsewhere is stored in an object literal, and the literal is cast with `as`.
// The declared type of the inner object is looser than the type the cast gives it, but the object has everything
// that type requires. It stays the same object: a change made through one reference is visible through the other.
interface Compile { outfile: string; target?: string }
interface Loose { outfile?: string; target?: string }
interface Build { entrypoints: string[]; compile: Compile; fold?: boolean }
const madeCompile: Compile = { outfile: "made" }
const madeBuild: Build = { entrypoints: ["made"], compile: madeCompile }
const madeLoose: Loose = { target: "made" }
function out(build: Build): string { return build.entrypoints.join() + " " + build.compile.outfile + " " + build.compile.target + " " + build.fold }
console.log(out(madeBuild), madeLoose.target)
function make(): Loose { return { outfile: "first" } }
console.log(out({ entrypoints: ["a"], compile: make() } as Build))
//// aliased-nested-cast-literal-in-place.ts
// An object that is also referenced elsewhere is stored in an object literal, and the literal is cast with `as`.
// The declared type of the inner object is looser than the type the cast gives it, but the object has everything
// that type requires. It stays the same object: a change made through one reference is visible through the other.
interface Compile { outfile: string; target?: string }
interface Loose { outfile?: string; target?: string }
interface Build { entrypoints: string[]; compile: Compile; fold?: boolean }
const madeCompile: Compile = { outfile: "made" }
const madeBuild: Build = { entrypoints: ["made"], compile: madeCompile }
const madeLoose: Loose = { target: "made" }
function out(build: Build): string { return build.entrypoints.join() + " " + build.compile.outfile + " " + build.compile.target + " " + build.fold }
console.log(out(madeBuild), madeLoose.target)
const inner: Loose = { outfile: "first" }
const build = { entrypoints: ["a"], compile: inner } as Build
console.log(out(build))
inner.outfile = "second"
console.log(out(build), (build.compile as unknown) === (inner as unknown))
build.compile.outfile = "third"
console.log(inner.outfile)
//// aliased-nested-cast-literal-in-two-literals.ts
// An object that is also referenced elsewhere is stored in an object literal, and the literal is cast with `as`.
// The declared type of the inner object is looser than the type the cast gives it, but the object has everything
// that type requires. It stays the same object: a change made through one reference is visible through the other.
interface Compile { outfile: string; target?: string }
interface Loose { outfile?: string; target?: string }
interface Build { entrypoints: string[]; compile: Compile; fold?: boolean }
const madeCompile: Compile = { outfile: "made" }
const madeBuild: Build = { entrypoints: ["made"], compile: madeCompile }
const madeLoose: Loose = { target: "made" }
function out(build: Build): string { return build.entrypoints.join() + " " + build.compile.outfile + " " + build.compile.target + " " + build.fold }
console.log(out(madeBuild), madeLoose.target)
const inner: Loose = { outfile: "first" }
const one = { entrypoints: ["a"], compile: inner } as Build
const two = { entrypoints: ["b"], compile: inner } as Build
console.log(out(one), out(two))
one.compile.outfile = "second"
console.log(out(two), inner.outfile, (one.compile as unknown) === (two.compile as unknown))
//// aliased-nested-cast-literal-keys-after.ts
// An object that is also referenced elsewhere is stored in an object literal, and the literal is cast with `as`.
// The declared type of the inner object is looser than the type the cast gives it, but the object has everything
// that type requires. It stays the same object: a change made through one reference is visible through the other.
interface Compile { outfile: string; target?: string }
interface Loose { outfile?: string; target?: string }
interface Build { entrypoints: string[]; compile: Compile; fold?: boolean }
const madeCompile: Compile = { outfile: "made" }
const madeBuild: Build = { entrypoints: ["made"], compile: madeCompile }
const madeLoose: Loose = { target: "made" }
