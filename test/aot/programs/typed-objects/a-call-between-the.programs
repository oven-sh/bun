//// any-into-primitive-types-2.ts
// Further places where an expression of type `any` reaches a declared primitive type. A field initializer, a default and a `return` are tested there. An element that an array literal or `push` put in is tested where it is read. A tuple is an array whose contents are its element types together, so the string in the place of the number of `[number, string]` passes the read and is found where it enters a written type, as what `Map.get` returns is.
/* expected
field TypeError
dynamic field TypeError
default TypeError
pattern default TypeError
object pattern default TypeError
array literal made TypeError
tuple made x
push pushed TypeError
map set set x
array literal, typed read made TypeError
tuple, typed read made TypeError
push, typed read pushed TypeError
map set, typed read set TypeError
async return called
async return rejects TypeError
*/
////= attempt
function tried(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
const hide = (v: unknown): any => v
class K { n: number = hide("x"); tag = "k" }
attempt("field", () => new K().tag)
attempt("dynamic field", () => { class L { n: number = hide("x"); tag = "l" } return new L().tag })
function dflt(n: number = hide("x")): string { return "entered" }
attempt("default", () => dflt())
attempt("pattern default", () => { const [a = hide("x")]: number[] = []; return "bound" })
attempt("object pattern default", () => { const { a = hide("x") }: { a?: number } = {}; return "bound" })
attempt("array literal", () => { const list: number[] = [hide("x")]; return "made " + tried(() => list[0]) })
attempt("tuple", () => { const pair: [number, string] = [hide("x"), "s"]; return "made " + tried(() => pair[0]) })
attempt("push", () => { const list: number[] = []; list.push(hide("x")); return "pushed " + tried(() => list[0]) })
attempt("map set", () => { const m = new Map<string, number>(); m.set("k", hide("x")); return "set " + tried(() => m.get("k")) })
attempt("array literal, typed read", () => { const list: number[] = [hide("x")]; return "made " + tried(() => { const n: number = list[0]; return n }) })
attempt("tuple, typed read", () => { const pair: [number, string] = [hide("x"), "s"]; return "made " + tried(() => { const n: number = pair[0]; return n }) })
attempt("push, typed read", () => { const list: number[] = []; list.push(hide("x")); return "pushed " + tried(() => { const n: number = list[0]; return n }) })
attempt("map set, typed read", () => { const m = new Map<string, number>(); m.set("k", hide("x")); return "set " + tried(() => { const n: number | undefined = m.get("k"); return n }) })
attempt("async return", () => { async function f(): Promise<number> { return hide("x") } f().catch(e => console.log("async return rejects", (e as Error).constructor.name)); return "called" })
//// any-object-passes-an-object-type.ts
// Any object passes an object type: at a cast, a variable, a parameter, a result, a field, an element and `this`. It stays the same object, and what it lacks reads as undefined, so every line is plain Bun's.
////= attempt
const hide = (v: unknown): any => v
interface A { a: number; shared?: string }
interface B { b: string; shared?: string }
interface Wide { a: number; shared?: string; more: boolean }
class K { k = 1; who() { return "K" } }
class L { l = "l"; read() { return this.l } }
const makeA = (): A => ({ a: 1 })
const makeB = (): B => ({ b: "b" })
const makeWide = (): Wide => ({ a: 2, more: true })
// Cast.
attempt("w1", () => (makeB() as unknown as A).a)
attempt("r1", () => (makeWide() as unknown as A).a)
// Binding whose type is written down.
attempt("w2", () => { const x: A = hide(makeB()); return x.a })
attempt("r2", () => { const x: A = hide(makeWide()); return x.a })
// Parameter, entered by a caller that knows nothing of it.
function readA(x: A): number { return x.a }
attempt("w3", () => (readA as any)(makeB()))
attempt("r3", () => (readA as any)(makeWide()))
// Result.
function result(v: unknown): A { return hide(v) }
attempt("w4", () => result(makeB()).a)
attempt("r4", () => result(makeWide()).a)
// Field, stored to by typed code and by untyped code.
interface Holder { item: A }
attempt("w5", () => { const h: Holder = { item: makeA() }; h.item = hide(makeB()); return h.item.a })
attempt("r5", () => { const h: Holder = { item: makeA() }; h.item = hide(makeWide()); return h.item.a })
attempt("w6", () => { const h: Holder = { item: makeA() }; try { (h as any).item = makeB(); return "stored" } catch (e) { return (e as Error).constructor.name + " " + h.item.a } })
attempt("r6", () => { const h: Holder = { item: makeA() }; (h as any).item = makeWide(); return h.item.a })
// Element: of an array that is cast, and of an array that received it through `any`.
attempt("w7", () => ([makeB()] as unknown as A[])[0].a)
attempt("r7", () => ([makeWide()] as unknown as A[])[0].a)
attempt("w8", () => { const list: A[] = []; (list as unknown[]).push(makeB()); return list[0].a })
attempt("r8", () => { const list: A[] = []; (list as unknown[]).push(makeWide()); return list[0].a })
// `this`.
attempt("w9", () => K.prototype.who.call(hide(makeB())))
attempt("r9", () => K.prototype.who.call(hide(new K())))
// A class type is tested like an interface: any object passes. `this` of a method is never tested.
attempt("w10", () => (makeB() as unknown as K) instanceof K)
attempt("w11", () => L.prototype.read.call({ l: "plain" } as L))
attempt("w12", () => (new K() as unknown as A).shared)
// Objects of JavaScriptCore.
attempt("w13", () => (new Map() as unknown as A).shared)
attempt("w14", () => (JSON.parse("[]") as A).shared)
// Plain data passes as it is: a cast neither copies nor converts.
attempt("w15", () => typeof (JSON.parse("{}") as A))
attempt("r15", () => { const source = JSON.parse('{"a":1}'); const x = source as A; return x.a + " " + (x === source) })
attempt("w16", () => (Object.create(null) as A).shared)
attempt("r16", () => { const x = Object.assign(Object.create(null), { a: 1 }) as A; return x.a + " " + Object.getPrototypeOf(x) })
attempt("w17", () => Object.prototype.toString.call(hide(new Map()) as A))
attempt("w18", () => Object.entries(makeA() as unknown as B).length)
// `{ a?: number }` has nothing in common with B and K. Both are objects, so they pass.
attempt("w19", () => ([makeB(), makeA(), new K()] as unknown as { a?: number }[]).map(o => String(o.a)).join())
// The right kind through any, and sound narrowing of unknown.
attempt("s1", () => { const n: number = hide(1); const s: string = hide("2"); const b: boolean = hide(true); return b ? n + Number(s) : 0 })
attempt("s2", () => [1, "s", true].map((v: unknown) => typeof v === "number" ? typeof (v + 1) : typeof v === "string" ? typeof v.length === "number" ? "string" : "" : typeof v).join(" "))
attempt("s3", () => { const u: A | number = hide(2); return typeof u === "number" ? u : u.a })
// An optional field that the object's own layout lacks: read as undefined, stored as an extra property.
interface Both { a: number; z?: number }
attempt("s4", () => { const x = makeA() as unknown as Both; return x.a + " " + x.z })
attempt("s5", () => { const x = makeA() as unknown as Both; x.z = 4; return (x.a + x.z) + " " + Object.keys(x).join() })
//// arguments-evaluated-after-callee-read.ts
// The callee of a method call is read before the arguments are evaluated, so an argument that replaces the method has no effect on the call.
interface Speaker { id: number; speak(greeting: string): string }
function sharedSpeak(this: Speaker, greeting: string): string { return greeting + " shared " + this.id }
////= ClassSpeaker
class FieldSpeaker implements Speaker {
  id = 6
  speak = (greeting: string): string => greeting + " field " + this.id
}
const literalMethod: Speaker = { id: 1, speak(greeting) { return greeting + " method " + this.id } }
function replacing(s: Speaker): string { return s.speak?.((s.speak = () => "replaced " + s.id, "old")) + " then " + s.speak("new") }
function speaking(s: Speaker): string { return s.speak?.("old") + " then " + s.speak("new") }
// What gives an object another prototype, or passes an object that inherits from a compiled one: type-rules/any-into-annotated-parameter.
console.log(replacing({ id: 20, speak: sharedSpeak }), "|", speaking(new ClassSpeaker(21)), "|", replacing(new FieldSpeaker()), "|", replacing(literalMethod), "|", replacing(new ClassSpeaker(22)))
class Runner { n = 1; go(x: number): string { return "orig" + x + this.n } get size(): number { return this.n } }
function bump(r: Runner): number { r.n++; return 5 }
const r1 = new Runner(), r2 = new Runner()
console.log(r1.go?.(bump(r1)), r1.go(0), r2.go?.(bump(r1)), r2.size, r1.size)
// The arguments are evaluated after the callee is read. The checker sees both stores, so `go` is a replaced method.
function patchOwn(r: Runner): number { (r as any).go = () => "own"; return 5 }
function patchClass(): number { Runner.prototype.go = function () { return "class" }; return 6 }
const r4 = new Runner(), r5 = new Runner()
console.log(r4.go?.(patchOwn(r4)), r5.go?.(patchClass()), r4.go(0), r5.go(0), new Runner().go(0), Object.keys(r4).join())
//// arithmetic-on-unassigned-typed-variable.ts
enum Color { Red = 1, Green = 2 }

function literals(): void {
    let v: 1 | 2;
    const get = (): 1 | 2 => v;
    const take = (p: 1 | 2) => p + 1;
    const less = (p: 1 | 2) => p - 1;
    const plus = (p: 1 | 2) => +p;
    console.log(take(get()), less(get()), plus(get()));
    v = 1;
    console.log(take(get()), less(get()), plus(get()));
}

function enums(): void {
    let v: Color;
    const get = (): Color => v;
    const take = (p: Color) => p + 1;
    console.log(take(get()));
    v = Color.Green;
    console.log(take(get()));
}

literals();
enums();
