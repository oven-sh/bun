const build = { entrypoints: ["a"], compile: inner } as Build
console.log(out(build))
inner.target = "later"
console.log(out(build), Object.keys(inner).join(), JSON.stringify(build))
//// aliased-nested-cast-literal-options-copy.ts
// Options are normalized the way many build tools do it: an optional nested object is copied with one member filled in, assigned back to the
// parameter it came from, and stored in a literal that is cast to the full type.
interface Compile { target?: string; outfile: string; icon?: string }
interface Minify { whitespace?: boolean; syntax?: boolean }
interface Config { entrypoints: string[]; external?: string[]; compile?: boolean | Compile; minify?: boolean | Minify; fold?: boolean; target?: string; define?: Record<string, string> }
const madeCompile: Compile = { outfile: "made" }
const madeConfig: Config = { entrypoints: ["made"] }
function use(config: Config): string {
  const compile = config.compile
  return config.entrypoints.join() + " " + (typeof compile === "object" ? compile.outfile + " " + compile.target : String(compile)) + " " + config.fold + " " + config.target
}
console.log(use(madeConfig), madeCompile.outfile)
function build(compile: boolean | { target?: string; outfile?: string } | undefined, outfile: string, fold: boolean | undefined, external: string[] | undefined): string {
  if (compile && typeof compile === "object") compile = { ...compile, outfile: outfile }
  const config: Config = {
    entrypoints: ["a", ...(external ?? [])],
    external,
    minify: { whitespace: true, syntax: false },
    ...(fold === undefined ? {} : { fold: fold }),
    target: "bun",
    define: {},
    compile,
  } as Config
  return use(config)
}
console.log(build({ target: "t" }, "out", true, ["x"]))
console.log(build({ target: "t" }, "out", undefined, undefined))
console.log(build(true, "out", true, undefined))
console.log(build(undefined, "out", false, []))
//// aliased-nested-cast-literal-variable-first.ts
// An object that is also referenced elsewhere is stored in an object literal, and the literal is cast with `as`.
// The declared type of the inner object is looser than the type the cast gives it, but the object has everything
// that type requires. It stays the same object: a change made through one reference is visible through the other.
interface Compile { outfile: string; target?: string }
interface Loose { outfile?: string; target?: string }
interface Build { entrypoints: string[]; compile: Compile; fold?: boolean }
const madeCompile: Compile = { outfile: "made" }
const madeBuild: Build = { entrypoints: ["made"], compile: madeCompile }
const madeLoose: Loose = { target: "made" }
function out(build: Build): string { return build.entrypoints.join() + " " + build.compile.outfile + " " + build.compile.target + " " + build.fold }
console.log(out(madeBuild), madeLoose.target)
const inner: Loose = { outfile: "first" }
const outer = { entrypoints: ["a"], compile: inner }
const build = outer as Build
console.log(out(build))
inner.outfile = "second"
console.log(out(build), (outer as unknown) === (build as unknown), (build.compile as unknown) === (inner as unknown))
//// aliased-nested-cast-literal-with-spread.ts
// An object that is also referenced elsewhere is stored in an object literal, and the literal is cast with `as`.
// The declared type of the inner object is looser than the type the cast gives it, but the object has everything
// that type requires. It stays the same object: a change made through one reference is visible through the other.
interface Compile { outfile: string; target?: string }
interface Loose { outfile?: string; target?: string }
interface Build { entrypoints: string[]; compile: Compile; fold?: boolean }
const madeCompile: Compile = { outfile: "made" }
const madeBuild: Build = { entrypoints: ["made"], compile: madeCompile }
const madeLoose: Loose = { target: "made" }
function out(build: Build): string { return build.entrypoints.join() + " " + build.compile.outfile + " " + build.compile.target + " " + build.fold }
console.log(out(madeBuild), madeLoose.target)
function make(inner: Loose, fold: boolean | undefined): Build {
  return { entrypoints: ["a"], ...(fold === undefined ? {} : { fold }), compile: inner } as Build
}
for (const fold of [true, undefined]) {
  const inner: Loose = { outfile: "first" }
  const build = make(inner, fold)
  console.log(out(build))
  inner.outfile = "second"
  console.log(out(build), (build.compile as unknown) === (inner as unknown))
}
//// allocated-small-cast-then-filled.ts
// Made as less, cast, then filled: a factory makes the common part, the caller stores the rest. The object is born with the room that its `kind` calls for: a smaller type lists the 3.
type Mutable<T> = { -readonly [K in keyof T]: T[K] };
interface Node { readonly kind: number; readonly parent: Node | undefined }
interface Small extends Node { readonly kind: 3 | 6; readonly name: string }
interface Big extends Node { readonly name: string; readonly a: Node; readonly b: Node; readonly c: Node; readonly d: Node; readonly e: Node; readonly f: Node; readonly g: Node; readonly h: Node }
interface Big3 extends Big { readonly kind: 3 }
interface Big4 extends Big { readonly kind: 4 }
function NodeObject(this: Mutable<Node>, kind: number) { this.kind = kind; this.parent = undefined; }
const Make = NodeObject as any as new (kind: number) => Node;
function base<T extends Node>(kind: T["kind"]) { return new Make(kind) as Mutable<T>; }
function small(name: string): Small { const node = base<Small>(6); node.name = name; return node; }
function fill(node: Mutable<Big>, name: string, x: Node) { node.name = name; node.a = x; node.b = x; node.c = x; node.d = x; node.e = x; node.f = x; node.g = x; node.h = x; }
function big3(name: string, x: Node): Big3 { const node = base<Big3>(3); fill(node, name, x); return node; }
function big4(name: string, x: Node): Big4 { const node = base<Big4>(4); fill(node, name, x); return node; }
function show(big: Big): string { return big.kind + big.name + big.a.kind + big.h.kind; }
const s = small("s");
console.log(s.name, show(big4("four", s)), show(big3("three", s)));
//// ambient-function-result-as-class-promise/main.ts
// A plain object that has the members of a class arrives inside a Promise, alone and in an array, from a function that the program knows by a declaration alone and that stands in for a method or a field. It is read through the class type as in plain Bun.
import "./setup.js";
declare const functionWithoutCode: (kind: string) => (...args: any[]) => any;
class ByMethod { field: string = "made" }
class ByField { field: string = "made" }
class InAList { field: string = "made" }
class Service {
  async promise(): Promise<ByMethod> { return new ByMethod() }
  async list(): Promise<InAList[]> { return [new InAList()] }
}
const standIn: Service = { promise: functionWithoutCode("a method"), list: functionWithoutCode("a list") };
for (const service of [new Service(), standIn]) console.log((await service.promise()).field, (await service.list())[0].field);
interface Makers { make: () => Promise<ByField> }
const makers: Makers = { make: functionWithoutCode("a field") };
console.log((await makers.make()).field, new ByField().field);
//// ambient-function-result-as-class-promise/setup.js
globalThis.functionWithoutCode = kind => () => Promise.resolve(kind === "a list" ? [{ field: "given " + kind }] : { field: "given " + kind });
//// ambient-interfaces-for-host-objects.ts
// Interfaces written under `declare global` describe host objects. A host object that does not have a declared member passes every place of that type, and the member reads undefined, as in plain Bun.
declare global {
  namespace NodeJS { interface ProcessEnv { APP_REQUIRED_KEY: string; APP_OPTIONAL_KEY?: string } }
  interface HostThing { id: number; label: string }
  var hostThing: HostThing;
}
(globalThis as any).hostThing = { id: 1 };
(globalThis as any).process ??= { env: { HOME: "/home" } };
const copy: NodeJS.ProcessEnv = { ...process.env };
const same: NodeJS.ProcessEnv = process.env;
function keysOf(env: NodeJS.ProcessEnv): number { return Object.keys(env).length; }
console.log(typeof copy.APP_REQUIRED_KEY, typeof same.APP_REQUIRED_KEY, copy.APP_OPTIONAL_KEY, keysOf(copy) === keysOf(process.env), keysOf({ ...process.env, EXTRA: "1" }) - keysOf(copy));
const thing: HostThing = hostThing;
const spread: HostThing = { ...hostThing };
const made: HostThing = { id: 2, label: "made" };
function labelOf(t: HostThing): string { return String(t.label); }
console.log(thing.id, labelOf(thing), labelOf(spread), labelOf(made), thing === hostThing, JSON.stringify(spread), JSON.stringify(made));
export {};
//// an-object-stored-into-its-own-field-where-its-type-is-only-predicted.ts
interface Clock { origin: number; next: Clock | null }
class Link {
  value = 1;
  after: Link | null = null;
}
declare function fromHost(which: number): Clock;
const raws: any[] = [0, 1].map(() => JSON.parse('{"origin":1,"next":null}'));
for (const raw of raws) { raw.next = raw; }
(globalThis as any).fromHost = (which: number) => raws[which];
const kept: Clock = fromHost(0);
console.log(kept.next === kept, kept.origin, raws[1].next === raws[1]);
const bag = new Map<string, any>();
bag.set("link", new Link());
bag.set("plain", { value: 2, after: null });
bag.set("frozen", Object.freeze(new Link()));
const tie = (link: any) => {
  link.after = link;
  return link.value;
};
for (let turn = 0; turn < 3; turn++) {
  for (const name of ["link", "plain", "frozen", "nothing"]) {
    try {
      console.log(name, tie(bag.get(name)), bag.get(name).after === bag.get(name));
    } catch (error) {
      console.log(name, error instanceof TypeError ? "TypeError" : String(error));
    }
  }
}
//// an-option-is-read-off-the-rest-of-some-props-where-a-class-has-the-name-too.ts
// `child.style.corner`: nobody follows `child.style`. What is stored under `style` is the rest of some props, which mostly leaves `corner` out. A class has a `corner` too, and always fills it.
declare const process: { argv: string[] };
declare const console: { log(...values: any[]): void };
type Styles = { corner?: "sharp" | "round"; color?: string; margin?: number; padding?: number };
type Props = Styles & { children: string; key?: string };
class Cursor {
  corner: "sharp" | "round";
  column: number;
  constructor(corner: "sharp" | "round", column: number) { this.corner = corner; this.column = column; }
}
type Element = { style: Styles; name: string };
const elements: Element[] = [];
function box(props: Props): Element {
  const { children, key, ...style } = props;
  return { style, name: children + (key ?? "") };
}
function countSharp(children: any[]): number {
  let n = 0;
  for (const child of children) {
    const isSharp = child.style.corner === "sharp";
    if (isSharp) n += 2;
    n += child.name.length;
  }
  return n;
}
elements.push(box({ children: "a" }), box({ children: "bc", color: "red" }), box({ children: "d", corner: "sharp" }), box({ children: "e", margin: 1, padding: 2 }));
const cursors = [new Cursor("round", 1), new Cursor("sharp", 2)];
{ (globalThis as any).kept = [box, countSharp, elements, cursors]; const somebody: any = (globalThis as any)[JSON.parse('"somebody"')] ?? {}; somebody[JSON.parse('"something"')] = 1; Object.defineProperty(somebody, JSON.parse('"other"'), { get() { return 1; }, configurable: true }); }
const rounds = Number(process.argv[2]);
let sum = 0;
for (let i = 0; i < rounds; i++) sum += countSharp(elements) + cursors[i & 1]!.column;
console.log(sum);
//// any-into-checked-literal-property.ts
// A value of type `any` becomes a property of an object literal that is checked against a type.
/* expected
plain TypeError
spread TypeError
shorthand TypeError
pushed 0
nested TypeError
right l3 undefined null
untyped x
*/
////= attempt
const hide = (v: unknown): any => v
interface Counter { count: number; label: string; extra?: number | null }
attempt("plain", () => { const made: Counter = { count: hide("x"), label: "l" }; return made.label })
attempt("spread", () => { const made: Counter = { ...{ label: "l" }, count: hide("x") }; return made.label })
attempt("shorthand", () => { const count = hide("x"); const made: Counter = { count, label: "l" }; return made.label })
const list: Counter[] = []
try { list.push({ count: hide("x"), label: "t" }) } catch {}
console.log("pushed", list.length)
attempt("nested", () => { const made: { inner: Counter } = { inner: { count: 1, label: hide(2) } }; return typeof made })
attempt("right", () => { const a: Counter = { count: hide(3), label: hide("l"), extra: hide(undefined) }; const b: Counter = { count: 1, label: "", extra: hide(null) }; return a.label + a.count + " " + a.extra + " " + b.extra })
attempt("untyped", () => { const made = { count: hide("x") }; return made.count })
