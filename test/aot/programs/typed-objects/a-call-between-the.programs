// An interface with a read-only member: one object computes it by a getter, five hundred come out of JSON.parse() under the same type.
interface Holder { readonly size: number; name: string }
const live: Holder = { get size() { return this.name.length; }, name: "four" };
const held: Holder[] = [live];
for (let n = 0; n < 500; n++) { const next: Holder = JSON.parse('{"size":' + n + ',"name":"n' + n + '"}'); held.push(next); }
let total = 0;
for (const one of held) total += one.size;
live.name = "longer";
console.log(total, live.size, held[3].size, JSON.stringify(held[0]), JSON.stringify(held[4]));
//// a-literal-kept-in-a-field-is-changed-by-a-call-before-the-constructor-stores-into-it-in-hot-code.ts
// A constructor keeps a literal in a field, hands it to a function that changes it in eleven ways, and stores one of the fields that the literal lists.
type Flat = { x: number; y: number };
function show(o: unknown): string {
  if (o === null || typeof o !== "object") return String(o);
  const above = Object.getPrototypeOf(o);
  let all = above === Object.prototype ? "{" : (above?.constructor?.name ?? "none") + "{";
  for (const key of Object.keys(o)) all += key + ":" + show((o as Record<string, unknown>)[key]) + ";";
  return all + "}";
}
////= Point-2
class Point3 extends Point {
  z: number;
  constructor(x: number, y: number, z: number) {
    super(x, y);
    this.z = z;
  }
}
const log: string[] = [];
const names: string[] = JSON.parse('["y","x"]');
function change(o: any, kind: number): void {
  const y = names[0];
  switch (kind) {
    case 1:
      delete o[y];
      break;
    case 2:
      delete o[y];
      Reflect.setPrototypeOf(o, {
        set y(v: number) {
          log.push("set y " + v);
        },
        get y() {
          return 5;
        },
      });
      break;
    case 3:
      Object.freeze(o);
      break;
    case 4:
      Reflect.defineProperty(o, y, {
        get() {
          return 9;
        },
        set(v: number) {
          log.push("own set y " + v);
        },
        configurable: true,
        enumerable: true,
      });
      break;
    case 5:
      Reflect.defineProperty(o, y, { value: 3, writable: false });
      break;
    case 6:
      delete o[y];
      Reflect.setPrototypeOf(o, Object.create(null, { y: { value: 7, writable: false } }));
      break;
    case 7:
      delete o[names[1]];
      o[names[1]] = 1;
      break;
    case 8:
      delete o[y];
      Object.preventExtensions(o);
      break;
    case 9:
      delete o[y];
      Reflect.setPrototypeOf(o, new Point(1, 2));
      break;
    case 10:
      delete o[y];
      o.w = 1;
      break;
    case 11:
      Object.seal(o);
      break;
  }
}
function three(x: number): [Flat, Flat, Flat] {
  return [{ x, y: x + 1 }, new Point(x + 2, x + 3), new Point3(x, x, x)];
}
class Holder {
  inner: Flat;
  tag = "t";
  constructor(x: number, kind: number) {
    this.inner = { x, y: x };
    change(this.inner, kind);
    this.inner.y = x + 1;
  }
  total(): number {
    return this.inner.x + this.inner.y;
  }
}
function run(p: number, kind: number): string {
  const o = three(p)[p % 3];
  o.y += 1;
  const box = new Holder(p * 2, kind);
  return show(o) + show(box) + box.total();
}
for (let round = 0; round < 3; round++) console.log(run(round, 0));
for (let kind = 0; kind < 12; kind++) {
  let line = "";
  try {
    line = run(kind, kind);
  } catch (error) {
    line = "threw " + (error as Error).constructor.name;
  }
  console.log(kind + ": " + line + " | " + log.join());
}
//// a-literal-with-a-getter-and-a-parsed-object-come-to-one-typed-parameter.ts
// A function takes { a; b }: a literal whose a is a getter and an object out of JSON.parse() both come to it, and each keeps the kind of property that it was made with.
type T = { a: number; b: number };
function sum(v: T): number { return v.a + v.b; }
function made(n: number): T { return { get a() { return n + 7; }, b: 2 }; }
let total = 0;
for (let n = 0; n < 2000; n++) {
  const parsed = JSON.parse('{"a":' + n + ',"b":2}');
  total += sum(parsed) + sum(made(n));
  if (n < 3) console.log(JSON.stringify(parsed), JSON.stringify(made(n)), Object.getOwnPropertyDescriptor(parsed, "a"), typeof Object.getOwnPropertyDescriptor(made(n), "a")!.get);
}
console.log(total);
//// a-literal-with-a-getter-and-parsed-objects-are-held-under-one-type-in-two-functions.ts
// Two functions hold objects under one type, { readonly a; b } | { a; b }: in one a closure reads a parsed object through any, in the other a literal with a getter and a parsed object come to one variable of a loop.
function remade(n: number) {
  let held: { readonly a: number; b: number } | { a: number; b: number } | undefined = undefined;
  const look = () => {
    const v = held;
    if (v === undefined) return "nothing";
    return (v as any).ok ? { ok: true, value: (v as any).value + 1 } : { ok: false, error: (v as any).error + "!" };
  };
  if (n % 10 !== 3) held = JSON.parse('{"a":' + n + ',"b":2}');
  return look();
}
for (let n = 0; n < 1000; n++) { const last = remade(n); if (n < 5) console.log(JSON.stringify(last)); }
function aroundTheLoop(n: number) {
  const answers: unknown[] = [];
  let v: { readonly a: number; b: number } | { a: number; b: number } | null = null;
  for (let i = 0; i < 7; i++) {
    if (v !== null) answers.push(v.a + v.b);
    v = i % 3 === 0 ? { get a() { return n + 7; }, b: 2 } : i % 3 === 1 ? JSON.parse('{"a":' + n + ',"b":2}') : null;
  }
  return answers;
}
for (let n = 0; n < 300; n++) { const last = aroundTheLoop(n); if (n < 5) console.log(JSON.stringify(last)); }
//// a-literal-writes-names-that-only-the-index-signature-of-its-type-allows.ts
// A literal under a type with fields and an index signature writes names of both kinds. Every road to those names answers as in plain Bun.
interface Bag {
  size: number;
  [key: string]: number | string;
}
interface Options {
  name?: string;
  depth?: number;
  [key: string]: unknown;
}

const lines: string[] = [];
function show(label: string, value: unknown) {
  lines.push(label + " " + JSON.stringify(value));
}

function make(i: number): Bag {
  return { size: i, a: i + 1, b: "b" + i };
}
function sum(bag: Bag): number {
  return bag.size + (typeof bag.a === "number" ? bag.a : -1);
}
function readBy(bag: Bag, key: string): number | string {
  return bag[key];
}
function storeBy(bag: Bag, key: string, value: number | string) {
  bag[key] = value;
}

const constant: Bag = { size: 4, a: 1, b: 2 };
show("constant", [constant.size, constant.a, constant.b, constant.c, Object.keys(constant)]);

let total = 0;
for (let i = 0; i < 2000; i++) total += sum(make(i));
show("total", total);

const bag = make(1);
bag.a = "text";
show("another type by name", [bag.a, sum(bag), typeof bag.a]);
storeBy(bag, "a", 2.5);
show("a fraction by key", [bag.a, readBy(bag, "a"), sum(bag)]);
storeBy(bag, "size", 9);
show("a field by key", [bag.size, readBy(bag, "size")]);
storeBy(bag, "later", "added");
show("a new name", [bag.later, Object.keys(bag), JSON.stringify(bag)]);
delete bag.a;
show("deleted", [bag.a, "a" in bag, Object.keys(bag), sum(bag)]);
bag.a = 7;
show("back again", [bag.a, Object.keys(bag), sum(bag)]);

const plain: Bag = { size: 1 };
const mixed: Bag[] = [plain, make(2), constant, { size: 3, z: "z" }, { size: 5, a: "a", ["c" + (total % 2)]: 1 }];
show(
  "mixed",
  mixed.map(each => [each.size, each.a, each.z, sum(each), Object.keys(each).join()]),
);
for (const each of mixed) each.a = each.size;
show(
  "mixed stored",
  mixed.map(each => [each.a, sum(each), Object.keys(each).join()]),
);

const copy: Bag = { ...make(3), size: 8, d: 4 };
show("copy", [copy, Object.entries(copy)]);
const { size, ...rest } = make(4);
show("rest", [size, rest]);

function describe(options: Options): string {
  return [options.name, options.depth, options.extra, Object.keys(options).length].join("|");
}
show("options", [
  describe({}),
  describe({ name: "n" }),
  describe({ extra: [1], depth: 2 }),
  describe({ name: "n", extra: null, other: {} }),
]);

const frozen: Bag = Object.freeze({ size: 1, a: 2 });
try {
  ("use strict");
  frozen.a = 3;
} catch (error) {
  show("frozen throws", (error as Error).constructor.name);
}
show("frozen", [frozen.a, Object.isFrozen(frozen)]);

const withAccessor: Bag = {
  size: 1,
  get a() {
    return this.size + 1;
  },
  b: 3,
};
withAccessor.size = 10;
show("accessor", [withAccessor.a, withAccessor.b, sum(withAccessor)]);

Object.defineProperty(constant, "a", { value: 100, enumerable: false, configurable: true, writable: true });
show("redefined", [constant.a, Object.keys(constant), sum(constant)]);

console.log(lines.join("\n"));
//// a-maker-leaves-declared-fields-out.ts
// A maker leaves out fields that the type declares, required and optional, objects, numbers and flags; another function could store them, and one field nobody stores at all.
// The property cannot be elsewhere in the object and nothing lies above the object under these names, so the state of the slot is the whole answer:
// no read is tested, none goes by name, and an object that was born without the fields costs what a full one costs.
// STATISTIC: AccessesGuarded = 0
// STATISTIC: AccessesUnknown = 0
type Project = { cwd: string };
////= Session
const home: Project = { cwd: "/home" };
function make(id: number): Session {
  return { id } as Session;
}
////= attach
function weigh(session: Session): number {
  let weight = session.id;
  const project = session.project;
  if (project) weight += project.cwd.length;
  const other = session.optionalProject;
  if (other) weight += other.cwd.length;
  if (session.count !== undefined) weight += session.count;
  if (session.optionalCount !== undefined) weight += session.optionalCount;
  if (session.flag) weight += 100;
  if (session.neverStored !== undefined) weight += 1000;
  return weight;
}
function run(session: Session, turns: number): number {
  let sum = 0;
  for (let i = 0; i < turns; i++) sum += weigh(session);
  return sum;
}
const bare = make(1);
const full = make(2);
attach(full);
console.log(run(bare, 10), run(full, 10), run(bare, 3000), run(full, 3000));
attach(bare);
console.log(run(bare, 3000));
//// a-parsed-record-is-a-thenable-only-where-the-program-makes-it-one.ts
interface Row { port: number; host: string; tag?: string }
interface Inner { deep: number; label: string }
interface Holder { id: number; inner?: Inner }

const out: string[] = [];
function show(name: string, value: unknown): void { out.push(name + " " + JSON.stringify(value)); }
function weigh(row: Row): number { return row.port + row.host.length + (row.tag ? row.tag.length : 0); }

async function load(text: string): Promise<Row> { return JSON.parse(text); }
async function loadAs(text: string): Promise<Row> { return JSON.parse(text) as Row; }
async function loadBound(text: string): Promise<Row> { const row: Row = JSON.parse(text); return row; }

show("plain", weigh(await load('{"port":1,"host":"a"}')));
show("as", weigh(await loadAs('{"port":2,"host":"bb","tag":"t"}')));
show("bound", weigh(await loadBound('{"port":3,"host":"ccc"}')));

const withData = await load('{"port":4,"host":"d","then":5}');
show("then is a number", [weigh(withData), (withData as any).then]);
const withObject = await load('{"port":5,"host":"e","then":{"port":6,"host":"f"}}');
show("then is an object", [weigh(withObject), weigh((withObject as any).then)]);
const withList = await load('{"port":6,"host":"f","then":[1,2,3],"extra":{"deep":1,"label":"x"}}');
show("then is a list", [weigh(withList), (withList as any).then.length, (withList as any).extra.label]);

async function settleWith(row: Row): Promise<unknown> { return row; }
const made: Row = JSON.parse('{"port":7,"host":"g"}');
(made as any).then = function (this: Row, resolve: (value: unknown) => void) {
  this.port = this.port + 100;
  (this as any).host = 12;
  delete (this as any).then;
  resolve("called on " + this.port);
};
show("a function stored under then", await settleWith(made));
show("what it did to the record", [made.port, made.host, "then" in made]);

const second: Row = JSON.parse('{"port":8,"host":"h"}');
Object.defineProperty(second, "then", {
  configurable: true,
  get(this: Row) { this.port = -1; return undefined; },
});
show("a getter under then", weigh((await settleWith(second)) as Row));

class Later {
  constructor(public value: number) {}
  then(resolve: (value: number) => void): void { resolve(this.value * 2); }
}
async function either(index: number): Promise<unknown> {
  const row: Row = JSON.parse('{"port":9,"host":"i"}');
  const choices: unknown[] = [row, new Later(21), { then(resolve: (value: string) => void) { resolve("literal"); } }, [1, 2], "text", 3];
  return choices[index];
}
for (let index = 0; index < 6; index++) show("one of several " + index, await either(index));

async function oneOfMany(index: number): Promise<unknown> {
  const rows: unknown[] = [
    JSON.parse('{"port":1,"host":"a"}') as Row, { a: 1 }, { b: 2 }, { c: 3 }, { d: 4 }, { e: 5 }, { f: 6 }, { g: 7 }, { h: 8 }, { i: 9 },
    new Later(5),
  ];
  return rows[index];
}
show("one of many, the record", await oneOfMany(0));
show("one of many, the thenable", await oneOfMany(10));

const holder: Holder = JSON.parse('{"id":1,"inner":{"deep":2,"label":"in"},"other":{"deep":3,"label":"out"}}');
show("a record inside", [holder.inner!.deep, holder.inner!.label, ((holder as any).other as Inner).deep]);
show("resolved", weigh(await Promise.resolve(JSON.parse('{"port":10,"host":"j"}') as Row)));
show("executor", weigh(await new Promise<Row>(resolve => resolve(JSON.parse('{"port":11,"host":"k"}')))));
show("reaction", weigh(await Promise.resolve(0).then((): Row => JSON.parse('{"port":12,"host":"l"}'))));
show("all", (await Promise.all([load('{"port":13,"host":"m"}'), loadAs('{"port":14,"host":"n"}')])).map(weigh));

async function* rows(): AsyncGenerator<Row> { yield JSON.parse('{"port":15,"host":"o"}'); yield JSON.parse('{"port":16,"host":"p","tag":"q"}') as Row; }
for await (const row of rows()) show("yielded", weigh(row));

console.log(out.join("\n"));
//// a-record-or-an-object-of-a-built-in-class-arrives-at-one-access.ts
// One access, two kinds of receiver, both as declared: a record of the program and an object of a built-in class or of the host. Whichever arrives, the rest of the function answers the same.
interface State { count: number; last: string; seen: number[] }
type Sized = { size: number; label: string } | Map<string, number> | Set<number>;
type Linked = { href: string; hash: string } | URL;
type Timed = { getTime(): number; tag?: string } | Date;
type Lengthy = { length: number; kind: string } | Uint8Array | string[];

function sizeOf(value: Sized, state: State): number {
  const size = value.size;
  state.count += size;
  state.last = "size " + size;
  state.seen.push(size);
  return state.count;
}
function linkOf(value: Linked, state: State): string {
  const href = value.href;
  state.count++;
  state.last = href + value.hash;
  return state.last + state.count;
}
function timeOf(value: Timed, state: State): number {
  const time = value.getTime();
  state.count += time % 7;
  state.last = String(time);
  return state.count;
}
function lengthOf(value: Lengthy, state: State): number {
  const length = value.length;
  state.count += length;
  state.seen.push(length);
  return state.seen.length + state.count;
}
function mark(value: Sized & { mark?: number }, state: State, n: number): number {
  value.mark = n;
  state.count += value.mark;
  return state.count;
}
function maybe(value: Sized | null | undefined, state: State): string {
  try {
    const size = value!.size;
    state.count += size;
    return "size " + size + " count " + state.count;
  } catch (error) {
    state.count--;
    return (error as Error).constructor.name + " count " + state.count;
  }
}

const state: State = { count: 0, last: "", seen: [] };
const sized: Sized[] = [{ size: 3, label: "record" }, new Map([["a", 1], ["b", 2]]), new Set([1, 2, 3, 4]), { size: 5, label: "other" }];
const linked: Linked[] = [{ href: "record:", hash: "#r" }, new URL("https://example.com/path#u")];
const timed: Timed[] = [{ getTime: () => 11 }, new Date(86400000), { getTime: () => 13, tag: "t" }];
const lengthy: Lengthy[] = [{ length: 2, kind: "record" }, new Uint8Array(6), ["a", "b", "c"]];
const lines: string[] = [];
for (let round = 0; round < 400; round++) {
  const a = sizeOf(sized[round % sized.length], state);
  const b = linkOf(linked[round % linked.length], state);
  const c = timeOf(timed[round % timed.length], state);
  const d = lengthOf(lengthy[round % lengthy.length], state);
  const e = mark(sized[(round + 1) % sized.length], state, round & 3);
  const f = maybe(round % 5 === 0 ? null : round % 7 === 0 ? undefined : sized[round % sized.length], state);
  if (round < 8 || round > 395) lines.push([a, b, c, d, e, f, state.last].join(" | "));
}
// Only objects of built-in classes for a while, then only records.
for (let round = 0; round < 300; round++) sizeOf(sized[1 + (round & 1)], state);
for (let round = 0; round < 300; round++) sizeOf(sized[(round & 1) * 3], state);
console.log(lines.join("\n"));
console.log(state.count, state.last, state.seen.length, (sized[1] as any).mark, (sized[0] as any).mark, Object.keys(sized[0]).join());
//// a-record-that-is-a-prototype-is-changed/main.ts
import { makeOver, store } from "./sloppy.cjs";

const log: string[] = [];
const show = (title: string, said: unknown) => log.push(title + ": " + said);
const attempt = (run: () => unknown): string => {
  try {
    return String(run());
  } catch (error) {
    return (error as Error).constructor.name;
  }
};
const describe = (object: object) => Object.keys(object).join() + " " + JSON.stringify(object);

////= lines	Pair	a	number	b	number
type Held = { a?: number; note?: string };
const rounds = 40;

function heirs(title: string, prototype: Held, change: (prototype: Held) => void, undo?: (prototype: Held) => void) {
  const typed = (a: number, b: number): Pair => {
    const self = Object.create(prototype);
    self.a = a;
    self.b = b;
    return self;
  };
  const untyped = (a: number, b: number): any => {
    const self: any = Object.create(prototype);
    self.a = a;
    self.b = b;
    return self;
  };
  const assigned = (a: number, b: number): Pair => Object.assign(Object.create(prototype), { a, b });
  const kept: any = Object.create(prototype);
  const ways: [string, () => unknown][] = [
    ["typed", () => describe(typed(1, 2))],
    ["untyped", () => describe(untyped(1, 2))],
    ["assigned", () => describe(assigned(1, 2))],
    ["sloppy", () => describe(makeOver(prototype, 1, 2))],
    ["Reflect.set", () => Reflect.set(Object.create(prototype), "a", 1)],
    ["an heir from before, sloppy", () => store(Object.create(kept), "a", 1)],
    ["read", () => typed(1, 2).a + " " + (Object.create(prototype) as Held).a + " " + (Object.create(prototype) as Held).note],
  ];
  for (let i = 0; i < rounds; i++) for (const way of ways) attempt(way[1]);
  for (const [name, run] of ways) show(title + ", before, " + name, attempt(run));
  change(prototype);
  for (const [name, run] of ways) show(title + ", after, " + name, attempt(run));
  for (let i = 0; i < rounds; i++) for (const way of ways) attempt(way[1]);
  for (const [name, run] of ways) show(title + ", later, " + name, attempt(run));
  if (undo) {
    undo(prototype);
    for (const [name, run] of ways) show(title + ", undone, " + name, attempt(run));
  }
}

const seen: string[] = [];
heirs("frozen", { a: 1 }, prototype => Object.freeze(prototype));
heirs("frozen without the name", {}, prototype => Object.freeze(prototype));
heirs("sealed", { a: 1 }, prototype => Object.seal(prototype));
heirs("no longer extensible", { a: 1 }, prototype => Object.preventExtensions(prototype));
heirs(
  "a setter",
  {},
  prototype => Object.defineProperty(prototype, "a", { set(value: number) { seen.push("a<-" + value); }, configurable: true }),
  prototype => delete (prototype as any).a,
);
heirs(
  "a setter over a value",
  { a: 1 },
  prototype => Object.defineProperty(prototype, "a", { set(value: number) { seen.push("A<-" + value); }, configurable: true }),
  prototype => Object.defineProperty(prototype, "a", { value: 3, writable: true, enumerable: true, configurable: true }),
);
heirs(
  "a getter alone",
  {},
  prototype => Object.defineProperty(prototype, "a", { get() { return 7; }, configurable: true }),
  prototype => delete (prototype as any).a,
);
heirs(
  "read-only",
  {},
  prototype => Object.defineProperty(prototype, "a", { value: 5, writable: false, configurable: true }),
  prototype => Object.defineProperty(prototype, "a", { writable: true }),
);
heirs(
  "read-only over a value",
  { a: 1 },
  prototype => Object.defineProperty(prototype, "a", { writable: false }),
  prototype => Object.defineProperty(prototype, "a", { writable: true }),
);
heirs(
  "a name the type does not declare",
  {},
  prototype => ((prototype as any).b = 9),
  prototype => delete (prototype as any).b,
);
heirs(
  "a declared name stored by typed code",
  {},
  prototype => (prototype.note = "late"),
  prototype => delete prototype.note,
);
heirs(
  "another prototype above",
  {},
  prototype => Object.setPrototypeOf(prototype, { set a(value: number) { seen.push("above<-" + value); } }),
  prototype => Object.setPrototypeOf(prototype, Object.prototype),
);
const Frozen: { a?: number } = { a: 1 };
////= lines-10	overFrozen	Frozen
////= lines-9	anyOverFrozen	Frozen
const assignedOverFrozen = (a: number, b: number): Pair => Object.assign(Object.create(Frozen), { a, b });
for (let i = 0; i < rounds; i++) overFrozen(i, i).a + anyOverFrozen(i, i).a + assignedOverFrozen(i, i).a + makeOver(Frozen, i, i).a;
show("a constant, before it is frozen", [describe(overFrozen(1, 2)), describe(anyOverFrozen(1, 2)), describe(assignedOverFrozen(1, 2)), describe(makeOver(Frozen, 1, 2))].join(" / "));
Object.freeze(Frozen);
show("a constant that is frozen, typed", attempt(() => describe(overFrozen(1, 2))));
show("a constant that is frozen, untyped", attempt(() => describe(anyOverFrozen(1, 2))));
show("a constant that is frozen, assigned", attempt(() => describe(assignedOverFrozen(1, 2))));
show("a constant that is frozen, sloppy", attempt(() => describe(makeOver(Frozen, 1, 2))));
show("a constant that is frozen, Reflect.set", attempt(() => Reflect.set(Object.create(Frozen), "a", 1)));

const Sealed: { a?: number } = { a: 1 };
////= lines-10	overSealed	Sealed
