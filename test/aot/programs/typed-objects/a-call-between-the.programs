a1 2
a2 a
a2t TypeError
a3 undefined
a3b undefined
a4 0ab
a5 a,b
a6 a
a7 a
b1 1
b2 b
b2t TypeError
b3 3
c1 2
c2 TypeError
c2t TypeError
c3 three
c4 3
c5 1,2,three
d1 v
d1t TypeError
d2 undefined
d3 true
d4 v
e1 a
e2 2
e3 b
f1 1
f2 x
f2t TypeError
g1 TypeError
g1t TypeError
g2 TypeError
g3 undefined
g4 TypeError
h1 z
h1t TypeError
h2 9
h3 z
h3t TypeError
i1 TypeError
i2 1
*/
