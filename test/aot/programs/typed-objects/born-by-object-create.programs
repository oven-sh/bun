//// computed-key-store-wider-than-field.ts
// A store under a key that is a union of names is accepted by TypeScript for any value when one of the named properties is `any`. The store does not throw. A read of the field by its name through the written type finds a value of another kind and throws a TypeError.
type Body = { json: any; text: string; bytes: Uint8Array };
interface Raw {
  json(): Promise<any>;
  text(): Promise<string>;
  bytes(): Promise<Uint8Array>;
}

class CachingRequest {
  raw: Raw;
  bodyCache: Partial<Body> = {};
  constructor(raw: Raw) {
    this.raw = raw;
  }
  #cachedBody = (key: keyof Body) => {
    const { bodyCache, raw } = this;
    const cached = bodyCache[key];
    if (cached) return cached;
    return (bodyCache[key] = raw[key]());
  };
  text(): Promise<string> {
    return this.#cachedBody("text");
  }
  json<T = any>(): Promise<T> {
    return this.#cachedBody("text").then((text: string) => JSON.parse(text));
  }
  bytes(): Promise<Uint8Array> {
    return this.#cachedBody("bytes");
  }
}

let reads = 0;
const raw: Raw = {
  json: async () => ({ a: ++reads }),
  text: async () => `{"a":${++reads}}`,
  bytes: async () => new Uint8Array([++reads]),
};

const request = new CachingRequest(raw);
console.log(JSON.stringify(await request.json()), await request.text(), (await request.bytes())[0], reads);
console.log(Object.keys(request.bodyCache).join(), (request.bodyCache as any).text instanceof Promise, typeof request.bodyCache.json);

interface Settings {
  extra: any;
  name: string;
  size: number;
}
function set(settings: Settings, key: "extra" | "name", value: number[]) {
  settings[key] = value;
}
const settings: Settings = { extra: 1, name: "a", size: 2 };
set(settings, "name", [1, 2]);
try { console.log(JSON.stringify(settings), Array.isArray(settings.name), settings.size + 1); } catch (e) { console.log("a read of settings.name:", (e as Error).constructor.name); }
set(settings, "extra", [3]);
console.log(JSON.stringify(settings));
//// conditional-types-one-union-several-generics/main.ts
import { toolA, toolB, toolC, type AnyTool, type InputOf, type OutputOf } from "./tools";

function first<T extends AnyTool>(tool: T, input: InputOf<T>): OutputOf<T> {
  const given: InputOf<T> = input;
  return (tool.run as (input: InputOf<T>, note: string) => OutputOf<T>)(given, "!");
}

function second<U extends AnyTool>(tool: U, inputs: InputOf<U>[]): OutputOf<U>[] {
  const made: OutputOf<U>[] = [];
  for (const input of inputs) made.push(first(tool, input));
  return made;
}

function third<V extends AnyTool>(tool: V, input: InputOf<V>): { name: V["name"]; made: OutputOf<V> } {
  return { name: tool.name, made: second(tool, [input])[0] };
}

console.log(JSON.stringify(first(toolA, { kind: "a", size: 4 })));
console.log(JSON.stringify(second(toolB, [{ kind: "b", text: "x" }, { kind: "b", text: "yz" }])));
console.log(JSON.stringify(third(toolC, { kind: "c", flag: false })));
//// conditional-types-one-union-several-generics/tools.ts
export interface InA { kind: "a"; size: number }
export interface InB { kind: "b"; text: string }
export interface InC { kind: "c"; flag: boolean }
export interface OutA { doubled: number }
export interface OutB { shouted: string }
export interface OutC { negated: boolean }
export interface ToolA { name: "A"; run(input: InA, note: string): OutA }
export interface ToolB { name: "B"; run(input: InB, note: string): OutB }
export interface ToolC { name: "C"; run(input: InC, note: string): OutC }
export type AnyTool = ToolA | ToolB | ToolC;
export type InputOf<T> = T extends { run(input: infer I, note: string): unknown } ? I : never;
export type OutputOf<T> = T extends { run(input: never, note: string): infer O } ? O : never;

export const toolA: ToolA = { name: "A", run(input, note) { return { doubled: input.size * 2 + note.length }; } };
export const toolB: ToolB = { name: "B", run(input, note) { return { shouted: (input.text + note).toUpperCase() }; } };
export const toolC: ToolC = { name: "C", run(input) { return { negated: !input.flag }; } };
//// const-literal-proxy-via-object-assign.ts
// A Proxy of an object of a type is of that type, by whatever door it enters a field: here by Object.assign.
type Sub = { k: number };
type State = { n: number; sub: Sub };
const holder: { s: State } = { s: { n: 1, sub: { k: 1 } } };
for (let round = 0; round < 3; round++) {
  const source = { s: new Proxy({ n: round, sub: { k: 2 } }, {}) };
  Object.assign(holder, source);
  console.log(holder.s.n, holder.s.sub.k, holder.s === source.s);
}
//// const-proxy-via-object-assign.ts
// A Proxy of an object of a type is of that type, by whatever door it enters a field: here by Object.assign. One form a program: another form in the same program may open the types to it.
type Sub = { k: number };
type State = { n: number; sub: Sub };
const holder: { s: State } = { s: { n: 1, sub: { k: 1 } } };
for (let round = 0; round < 3; round++) {
  const proxy = new Proxy({ n: round, sub: { k: 2 } }, {});
  Object.assign(holder, { s: proxy });
  console.log(holder.s.n, holder.s.sub.k, (holder.s as object) === proxy);
}
//// constant-literal-member-breaks-its-declared-type.ts
// An object literal of constants has a member that can never match its field's declared type, and the type error is suppressed.
// The field's type is widened at build time, so nothing throws and the output matches plain Bun. Built with --aot-check=verify-each-pass.
function configure(options: { verbose?: boolean; depth?: number }): number {
  return (options.verbose ? 1 : 0) + (options.depth ?? 0)
}

const steps: string[] = []

function run(): number {
  steps.push('before')
  let total = configure({ verbose: true, depth: 2 })
  // @ts-expect-error
  total += configure({ verbose: 1, depth: 3 })
  steps.push('after')
  return total
}

function runNested(): number {
  steps.push('before nested')
  // @ts-expect-error
  const nested: { name: string; options: { verbose?: boolean } } = { name: 'n', options: { verbose: 'yes' } }
  steps.push('after nested')
  return nested.name.length
}

for (const attempt of [run, runNested]) {
  try {
    console.log(attempt())
  } catch (error) {
    console.log(error instanceof TypeError ? 'TypeError' : 'another error')
  }
}
console.log(steps.join(', '))
//// constructor-function-allocates-by-its-tag.ts
// The interfaces below the declared `this` of a constructor function declare one literal each for `kind`, and the function stores a parameter there.
// Whatever layout an object is made with, every way to make, call, subclass, alter and list such an object answers as in plain JavaScript.
const enum Kind { Unknown, Num, Add, Neg, Name }
interface Node { kind: Kind; pos: number; end: number; parent: Node | undefined }
interface Num extends Node { kind: Kind.Num; value: number }
interface Add extends Node { kind: Kind.Add; left: Node; right: Node }
interface Neg extends Node { kind: Kind.Neg; operand: Node; note?: string }
interface Name extends Node { kind: Kind.Name; text: string }
interface NodeConstructor { new (kind: Kind, pos: number, end: number): Node; (this: Node, kind: Kind, pos: number, end: number): void; prototype: any }
function NodeObject(this: Node, kind: Kind, pos: number, end: number) { this.pos = pos; this.end = end; this.kind = kind; this.parent = undefined }
const Maker = NodeObject as NodeConstructor
Maker.prototype.describe = function (this: Node) { return this.kind + "@" + this.pos }

function base<T extends Node>(kind: T["kind"]): T { return new Maker(kind, -1, -1) as T }
function num(value: number): Num { const node = base<Num>(Kind.Num); node.value = value; return node }
function add(left: Node, right: Node): Add { const node = base<Add>(Kind.Add); node.left = left; node.right = right; left.parent = node; right.parent = node; return node }
function neg(operand: Node): Neg { const node = base<Neg>(Kind.Neg); node.operand = operand; operand.parent = node; return node }
function name(text: string): Name { const node = base<Name>(Kind.Name); node.text = text; return node }
function evaluate(node: Node): number {
  switch (node.kind) {
    case Kind.Num: return (node as Num).value
    case Kind.Add: return evaluate((node as Add).left) + evaluate((node as Add).right)
    case Kind.Neg: return -evaluate((node as Neg).operand)
    case Kind.Name: return (node as Name).text.length
    default: return 0
  }
}
function show(label: string, value: any) {
  console.log(label, Object.keys(value).join(), JSON.stringify(value, (key, held) => (key === "parent" ? undefined : held)), Object.getPrototypeOf(value) === Maker.prototype, value instanceof Maker)
}

const tree = add(neg(num(4)), add(name("abc"), num(10)))
console.log(evaluate(tree), (tree as any).describe(), (tree.left as any).describe(), tree.left.parent === tree)
show("num", num(1)); show("add", tree.right); show("neg", tree.left); show("name", name("n"))

show("outside the table", new Maker(Kind.Unknown, 1, 2))
show("larger than any", new Maker(77 as Kind, 1, 2))
for (const tag of [NaN, -0, 1.5, null, undefined, 2 ** 40, -1, 4.000000001] as any[]) {
  const made: any = new Maker(tag, 0, 0)
  console.log(typeof tag, Object.is(made.kind, tag), Object.keys(made).join(), evaluate(made))
}

const given: any = { already: 1 }
console.log(Maker.call(given, Kind.Add, 5, 6), Object.keys(given).join(), given.kind)
const again = num(3)
console.log((Maker as any).call(again, Kind.Neg, 7, 8), Object.keys(again).join(), again.kind, again.value, again.pos)
const applied: any = Reflect.apply(Maker, Object.create(null), [Kind.Name, 1, 1])
console.log(applied)

class Other { static marker = 1 }
const reflected: any = Reflect.construct(Maker, [Kind.Num, 1, 2], Other)
console.log(reflected instanceof Other, reflected instanceof Maker, Object.keys(reflected).join(), reflected.kind)
const own: any = Reflect.construct(Maker, [Kind.Num, 1, 2], Maker)
show("own new.target", own)
const bound: any = new ((Maker as any).bind(null, Kind.Add))(3, 4)
show("bound", bound)
class Sub extends (Maker as any) { extra = 1; constructor(kind: Kind) { super(kind, 9, 9) } }
const sub: any = new Sub(Kind.Neg)
console.log(sub instanceof Sub, sub instanceof Maker, Object.keys(sub).join(), sub.describe())

const changed = num(5)
;(changed as any).kind = Kind.Add
;(changed as any).left = num(1); (changed as any).right = num(2)
console.log(evaluate(changed), Object.keys(changed).join())
const late = neg(num(2))
late.note = "late"; (late as any).unknownName = 1
delete (late as any).operand
console.log(Object.keys(late).join(), "operand" in late, late.note)
const reordered = base<Add>(Kind.Add)
reordered.right = num(1); reordered.left = num(2)
console.log(Object.keys(reordered).join(), evaluate(reordered))
Object.defineProperty(reordered, "left", { get() { return num(40) }, enumerable: false, configurable: true })
console.log(Object.keys(reordered).join(), evaluate(reordered))
const frozen = Object.freeze(name("ice"))
try { (frozen as any).text = "water"; console.log("stored") } catch (error) { console.log((error as Error).constructor.name) }
console.log(frozen.text, Object.isFrozen(frozen))

const before = Maker.prototype
Maker.prototype = { describe() { return "replaced" } }
const afterwards: any = new Maker(Kind.Num, 0, 0)
console.log(afterwards.describe(), Object.getPrototypeOf(afterwards) === before, afterwards instanceof Maker, (tree as any).describe())
Maker.prototype = 5
const plain: any = new Maker(Kind.Num, 0, 0)
console.log(Object.getPrototypeOf(plain) === Object.prototype, Object.keys(plain).join())
Maker.prototype = before

let sum = 0
for (let round = 0; round < 2000; round++) sum += evaluate(add(neg(num(round)), add(name("xy"), num(round + 1))))
console.log(sum)
//// constructor-function-field-init.ts
// The first stores of a constructor function count as initialization even when objects created by untyped code can have the same type as `this`.
const show = (what: string, o: object) => console.log(what, JSON.stringify(Object.keys(o)), JSON.stringify(o), "pos" in o, "value" in o)
enum Kind { Unknown, Leaf, File }
interface Base { kind: Kind; pos: number; end: number; flags: number }
interface Leaf extends Base { kind: Kind.Leaf; value: string }
function BaseCtor(this: Base, kind: Kind, pos: number, end: number) { this.pos = pos; this.end = end; this.kind = kind; this.flags = 0 }
const allocator = { getBase: () => BaseCtor as any }
let BaseConstructor: new (kind: Kind, pos: number, end: number) => Base
function start() { BaseConstructor = allocator.getBase() }
start()
function forge<T extends object>(seed: number): T { const d: Record<string, unknown> = { flags: seed, extra: "x", end: 1, kind: 0, pos: 0.5 }; return d as T }
function makeLeaf(value: string, pos: number): Leaf { const leaf = new BaseConstructor(Kind.Leaf, pos, pos + value.length) as Leaf; leaf.value = value; return leaf }
const width = (node: Base) => node.end - node.pos + node.flags + node.kind * 100
const makeBase = (kind: Kind, pos: number, end: number) => new BaseConstructor(kind, pos, end)
const plain = makeBase(Kind.File, 1.5, 4), leaf = makeLeaf("let", 2)
show("fresh:", plain); show("leaf:", leaf)
console.log(width(plain), width(leaf))
const stranger: Base = forge<Base>(7)
show("a stranger before:", stranger)
const call: any = BaseCtor
call.call(stranger, Kind.Leaf, 10, 20.5)
show("a stranger after:", stranger)
console.log(width(stranger), stranger.pos, stranger.flags)
call.call(leaf, Kind.Leaf, 30, 40)
show("one of ours again:", leaf)
console.log(width(leaf), leaf.value)
const nodes: Base[] = [plain, leaf, stranger]
console.log(nodes.map(width).join(), nodes.map(n => n.pos).join())
//// constructor-function-fields-of-the-declared-this.ts
// The fields of a constructor function have the types that the type it declares for `this` gives their names, and so have the names that are stored later through the types below it.
// Whatever else arrives in such a field, from untyped code, through a cast or by name, is read back by untyped code as it was stored.
declare const console: { log(...values: unknown[]): void };

const enum Kind { Unknown = 0, Leaf = 1, Branch = 2, Root = 300 }
const enum Flags { None = 0, Seen = 1 << 0, Marked = 1 << 3, Last = 1 << 30, All = -1 }

interface Item { kind: Kind; flags: Flags; pos: number; end: number; id: number; parent: Item; original: Item | undefined; label: string; ready: boolean; }
interface LeafItem extends Item { text: string; count: number; next: LeafItem | undefined; closed: boolean; }
interface BranchItem extends Item { children: Item[]; depth: number; }
type Mutable<T extends object> = { -readonly [K in keyof T]: T[K] };

function ItemObject(this: Mutable<Item>, kind: Kind, pos: number, end: number) {
    this.pos = pos;
    this.end = end;
    this.kind = kind;
    this.id = 0;
    this.flags = Flags.None;
    this.parent = undefined!;
    this.original = undefined;
    this.label = "";
    this.ready = false;
}
const ItemConstructor = ItemObject as unknown as new (kind: Kind, pos: number, end: number) => Item;

let nextId = 0;
function create(kind: Kind, pos: number, end: number): Item { const item = new ItemConstructor(kind, pos, end); (item as Mutable<Item>).id = ++nextId; return item; }
function createLeaf(text: string, pos: number): LeafItem {
    const leaf = create(Kind.Leaf, pos, pos + text.length) as Mutable<LeafItem>;
    leaf.text = text; leaf.count = text.length; leaf.next = undefined; leaf.closed = false;
    return leaf;
}
function createBranch(children: Item[]): BranchItem {
    const branch = create(Kind.Branch, children.length ? children[0].pos : -1, children.length ? children[children.length - 1].end : -1) as Mutable<BranchItem>;
    branch.children = children; branch.depth = 1;
    for (const child of children) (child as Mutable<Item>).parent = branch;
    return branch;
}

function show(value: unknown): string {
    if (typeof value === "number") return Object.is(value, -0) ? "-0" : String(value);
    if (typeof value === "string") return JSON.stringify(value);
    if (typeof value === "object" && value !== null) return Array.isArray(value) ? "[" + value.length + "]" : "{" + Object.keys(value).join() + "}";
    return String(value);
}
function describe(item: Item): string {
    return [item.kind, item.flags, item.pos, item.end, item.id, item.parent, item.original, item.label, item.ready].map(show).join(" ");
}
function isMarked(item: Item): boolean { return (item.flags & Flags.Marked) !== 0; }
function mark(item: Item): void { (item as Mutable<Item>).flags |= Flags.Marked; }
function width(item: Item): number { return item.end - item.pos; }
function isLeaf(item: Item): item is LeafItem { return item.kind === Kind.Leaf; }
function kindName(item: Item): string { switch (item.kind) { case Kind.Leaf: return "leaf"; case Kind.Branch: return "branch"; case Kind.Root: return "root"; default: return "other"; } }
function total(item: Item): number { return isLeaf(item) ? item.count : (item as BranchItem).children.reduce((sum, child) => sum + total(child), 0); }

const a = createLeaf("one", 0), b = createLeaf("three", 4);
(a as Mutable<LeafItem>).next = b;
const root = createBranch([a, b]);
console.log(describe(a)); console.log(describe(b)); console.log(describe(root));
console.log(isMarked(a), width(a), kindName(a), kindName(root), total(root), a.next === b, b.next, a.parent === root, Object.keys(a).join());
mark(a); console.log(isMarked(a), a.flags, isMarked(b), b.flags);

const numbers: number[] = [0, -0, 1, -1, 0.5, NaN, Infinity, -Infinity, 2147483647, 2147483648, -2147483648, -2147483647, -2147483646, -2147483645, -2147483644, -2147483643, -2147483649, 4294967296, 9007199254740991, 1e300, 5e-324];
for (const n of numbers) {
    const item = create(n as Kind, n, n) as Mutable<Item>;
    item.flags = n as Flags; item.id = n;
    console.log(describe(item), isMarked(item), show(width(item)), kindName(item), show(item.flags | 0), show(item.pos + 1), show(-item.pos), item.pos === n, Object.is(item.end, n));
    item.flags |= Flags.Last; item.pos++; item.end -= 1;
    console.log(show(item.flags), show(item.pos), show(item.end));
}

const strangers: unknown[] = [undefined, null, true, "text", 10n, Symbol.iterator, {}, [1], () => 1, -0, 1.5];
const names = ["kind", "flags", "pos", "end", "id", "parent", "original", "label", "ready", "text", "count", "next", "closed"];
function storeByName(target: any, name: string, value: unknown): void { target[name] = value; }
function readByName(target: any, name: string): unknown { return target[name]; }
for (const value of strangers) {
    const leaf = createLeaf("leaf", 2);
    for (const name of names) storeByName(leaf, name, value);
    console.log(names.map(name => typeof readByName(leaf, name)).join(), names.every(name => Object.is(readByName(leaf, name), value)), Object.keys(leaf).length);
    const cast = createLeaf("cast", 3) as any;
    cast.kind = value; cast.flags = value; cast.pos = value; cast.parent = value; cast.label = value; cast.ready = value; cast.text = value; cast.count = value;
    console.log(Object.is(cast.kind, value), Object.is(cast.flags, value), Object.is(cast.pos, value), Object.is(cast.parent, value), Object.is(cast.label, value), Object.is(cast.ready, value), Object.is(cast.text, value), Object.is(cast.count, value));
    cast.kind = Kind.Leaf; cast.pos = 7; cast.flags = Flags.Seen; cast.parent = root; cast.label = "again"; cast.ready = true; cast.text = "back"; cast.count = 4;
    console.log(describe(cast), total(cast), (cast as LeafItem).text, Object.keys(cast).join());
}

const removed = createLeaf("removed", 1) as any;
delete removed.flags; delete removed.pos; delete removed.count; delete removed.parent;
console.log("flags" in removed, removed.flags, removed.pos, removed.count, removed.parent, Object.keys(removed).join());
removed.flags = 5; removed.count = 6; console.log(removed.flags, removed.count, Object.keys(removed).join());

const watched = createLeaf("watched", 1) as any; let reads = 0;
Object.defineProperty(watched, "flags", { get() { reads++; return 9; }, configurable: true, enumerable: true });
Object.defineProperty(watched, "count", { value: 1.5, writable: false, configurable: true, enumerable: false });
console.log(isMarked(watched), (watched as LeafItem).flags, reads, total(watched), Object.keys(watched).join());
try { "use strict"; (watched as Mutable<LeafItem>).count = 2; } catch (error) { console.log((error as Error).constructor.name); }
console.log(watched.count);

const frozen = Object.freeze(createLeaf("frozen", 1));
try { mark(frozen); } catch (error) { console.log((error as Error).constructor.name); }
try { (frozen as Mutable<LeafItem>).count = 99; } catch (error) { console.log((error as Error).constructor.name); }
console.log(frozen.flags, frozen.count, Object.isFrozen(frozen));

const bare = Object.create(ItemObject.prototype) as Mutable<Item>;
console.log(bare.kind, bare.flags, bare.parent, Object.keys(bare).length, bare instanceof ItemObject);
ItemObject.call(bare, Kind.Root, 1, 2); console.log(describe(bare), kindName(bare));
const plain = {} as Mutable<Item>; ItemObject.call(plain, Kind.Leaf, 3, 4); console.log(describe(plain), plain instanceof ItemObject);
console.log(JSON.stringify(a, (key, value) => key === "parent" || key === "next" ? undefined : value));
//// constructor-function-plain-call-with-a-foreign-this.ts
// A constructor function is called without `new`, with a `this` that it has not made: its stores go to that object by the rules of any store, nothing is allocated, and `new` of the same function goes on making objects of its own.
const show = (o: object): string => Object.keys(o).join() + " " + JSON.stringify(o)
const attempt = (label: string, run: () => unknown) => { try { console.log(label, String(run())) } catch (error) { console.log(label, "throws", (error as Error).constructor.name) } }

interface Point { x: number; y: number }
function Point(this: Point, x: number, y: number) { this.x = x; this.y = y }
Point.prototype.sum = function (this: Point) { return this.x + this.y }
const PointClass = Point as unknown as new (x: number, y: number) => Point
const untyped: any = Point
const sumOf = (point: Point) => point.x + point.y

const first = new PointClass(1, 2)
console.log(show(first), sumOf(first), (first as any).sum(), first instanceof PointClass)

const otherShape: any = { y: "old", extra: 1 }
console.log(untyped.call(otherShape, 3, 4), show(otherShape), "sum" in otherShape, otherShape instanceof PointClass)
const literal: Point = { x: 0, y: 0 }
console.log(Point.call(literal, 5, 6), show(literal), sumOf(literal), Object.getPrototypeOf(literal) === Object.prototype)
console.log(untyped.call(first, 7, 8), show(first), sumOf(first), (first as any).sum())
const bare: any = Object.create(null)
console.log(untyped.call(bare, 9, 10), Object.keys(bare).join(), bare.x + bare.y, Object.getPrototypeOf(bare))

const calls: string[] = []
const inheritsAccessors: any = Object.create({ set x(value: number) { calls.push("set x " + value) }, get x() { return -1 }, get y() { return -2 } })
attempt("a setter and a getter alone above it:", () => untyped.call(inheritsAccessors, 11, 12))
console.log(calls.join(), show(inheritsAccessors), inheritsAccessors.x, inheritsAccessors.y)
const ownAccessor: any = { set y(value: number) { calls.push("own set y " + value) }, x: "x" }
console.log(untyped.call(ownAccessor, 13, 14), calls.join(), Object.keys(ownAccessor).join(), ownAccessor.x, ownAccessor.y)

const frozen = Object.freeze({ x: 0, y: 0 }), sealed: any = Object.seal({ y: 0 }), unextended: any = Object.preventExtensions({ x: 0 })
attempt("frozen:", () => untyped.call(frozen, 1, 2))
attempt("sealed:", () => untyped.call(sealed, 1, 2))
attempt("not extensible:", () => untyped.call(unextended, 1, 2))
console.log(show(frozen), show(sealed), show(unextended))
const readOnly: any = Object.defineProperty({ x: 0 }, "y", { value: "fixed", writable: false, enumerable: true, configurable: true })
attempt("read-only:", () => untyped.call(readOnly, 15, 16))
console.log(show(readOnly))

const trapped: string[] = []
const proxy: any = new Proxy({ kept: true }, {
  set(target: any, key, value, receiver) { trapped.push("set " + String(key) + " " + value); return Reflect.set(target, key, value, receiver) },
  defineProperty(target, key, descriptor) { trapped.push("define " + String(key)); return Reflect.defineProperty(target, key, descriptor) },
  getPrototypeOf(target) { trapped.push("prototype"); return Reflect.getPrototypeOf(target) },
})
console.log(untyped.call(proxy, 17, 18), trapped.join(), show(proxy))

for (const primitive of [5, "text", true, 10n, Symbol.iterator, undefined, null]) attempt("this is " + typeof primitive + ":", () => untyped.call(primitive, 1, 2))
attempt("no this:", () => untyped(1, 2))
attempt("no this, read out of a variable:", () => { const f = untyped; return f(1, 2) })

class Labels { x = "a"; y = "b"; z = "c"; join() { return this.x + this.y + this.z } }
const labels = new Labels()
console.log(untyped.call(labels, 19, 20), show(labels), typeof labels.x, labels.join(), labels instanceof Labels)
const list: any = [1, 2, 3]
console.log(untyped.call(list, 21, 22), list.length, Object.keys(list).join(), list.x, Array.isArray(list))
const callable: any = function named() {}
console.log(untyped.call(callable, 23, 24), Object.keys(callable).join(), callable.x + callable.y, callable.name)
console.log(untyped.call(Point, 25, 26), Object.keys(Point).join(), untyped.x, new PointClass(27, 28).x, delete untyped.x, delete untyped.y)
console.log(untyped.call(Point.prototype, 29, 30), Object.keys(Point.prototype).join(), show(new PointClass(31, 32)), (Object.create(Point.prototype) as Point).x, delete Point.prototype.x, delete Point.prototype.y)

const applied: any = {}, reflected: any = {}, bound: any = {}, holder: any = { tag: "holder", init: Point }
console.log(untyped.apply(applied, [33, 34]), Reflect.apply(Point, reflected, [35, 36]), untyped.bind(bound)(37, 38), untyped.bind(bound, 39).call(first, 40), holder.init(41, 42))
