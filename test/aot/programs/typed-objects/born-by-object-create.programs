//// borrowed-prototype-is-one-object.ts
// A plain object that is the prototype of another object enters a typed place. It stays as it is, and typed code, untyped code and the heir all see one object.
interface Compile { outfile: string; target?: string }
interface Build { entrypoints: string[]; compile: Compile }
function describeBuild(build: Build): string { return build.entrypoints.join() + " " + build.compile.outfile + " " + build.compile.target }
function rename(build: Build, name: string): void { build.compile.outfile = name }
function retarget(build: Build, target: string): void { build.compile.target = target }
function same(build: Build, other: unknown): boolean { return build.compile === other }
function untypedOptions(): any { const options: any = {}; options.outfile = "out.js"; return options }
function tell(name: string, f: () => unknown): void { let text: string; try { text = String(f()) } catch (e) { text = e instanceof Error ? e.name + ": " + e.message.split("\n")[0].replace(/ \(bun compile[^)]*\)/, "") : String(e) } console.log(name + ": " + text) }
function make(): { options: any; heir: any; build: any } { const options = untypedOptions(); const heir = Object.create(options); return { options, heir, build: { entrypoints: ["a.ts"], compile: options } } }
tell("read", () => { const { heir, build } = make(); return describeBuild(build) + " | heir " + heir.outfile });
tell("identity", () => { const { options, heir, build } = make(); describeBuild(build); return same(build, options) + " " + (build.compile === options) + " " + (Object.getPrototypeOf(heir) === options) + " " + (Object.getPrototypeOf(heir) === build.compile) });
tell("an untyped store is seen by typed code and the heir", () => { const { options, heir, build } = make(); describeBuild(build); options.outfile = "untyped.js"; return describeBuild(build) + " | heir " + heir.outfile + " | options " + options.outfile });
tell("a typed store is seen by untyped code and the heir", () => { const { options, heir, build } = make(); describeBuild(build); rename(build, "typed.js"); return describeBuild(build) + " | heir " + heir.outfile + " | options " + options.outfile });
tell("a typed store of an absent member", () => { const { options, heir, build } = make(); describeBuild(build); retarget(build, "bun"); return describeBuild(build) + " | heir " + heir.target + " | options " + options.target + " | keys " + Object.keys(options) });
tell("an untyped store of an absent member", () => { const { options, heir, build } = make(); describeBuild(build); options.target = "node"; return describeBuild(build) + " | heir " + heir.target + " | keys " + Object.keys(options) });
tell("an extra member added later", () => { const { options, heir, build } = make(); describeBuild(build); options.extra = 1; return describeBuild(build) + " | heir " + heir.extra + " | keys " + Object.keys(options) + " | for-in of the heir " + (() => { const names: string[] = []; for (const name in heir) names.push(name); return names })() });
tell("a member deleted later", () => { const { options, heir, build } = make(); describeBuild(build); delete options.outfile; return "heir " + heir.outfile + " | in " + ("outfile" in heir) + " | " + describeBuild(build) });
tell("the heir shadows", () => { const { options, heir, build } = make(); describeBuild(build); heir.outfile = "own.js"; return describeBuild(build) + " | heir " + heir.outfile + " | options " + options.outfile });
tell("an heir made after", () => { const { options, build } = make(); describeBuild(build); const late = Object.create(options); rename(build, "typed.js"); return late.outfile + " " + Object.getPrototypeOf(late).outfile });
tell("the heir itself is given", () => { const { heir } = make(); const build: any = { entrypoints: ["h.ts"], compile: heir }; return describeBuild(build) });
tell("hot", () => { const { options, heir, build } = make(); let s = ""; for (let i = 0; i < 20000; i++) { rename(build, "n" + (i & 3)); s = heir.outfile + options.outfile } return s + " " + describeBuild(build) });
//// borrowed-prototype-mismatch-rejected.ts
// The other side of borrowed-prototype-unchanged.ts: an object that is the prototype of another object and does NOT satisfy the record type enters it like any object. A member of the wrong kind throws where typed code reads it, and a missing member reads undefined.
type Inner = { p: number; q?: string; deep: number[] };
type Outer = { inner: Inner; n?: number };
function own(): Outer { return { inner: { p: 7, deep: [1], q: "q" }, n: 2 }; }
const kept: unknown[] = [];
function enters(source: any): unknown { const o: Outer = source; return [o.inner.p, o.inner.q, o.n === undefined ? "none" : o.n + 1]; }
function attempt(name: string, f: () => unknown): void { try { console.log(name, JSON.stringify(f())); } catch (e) { console.log(name, (e as Error).name); } }
const built = (entries: [string, unknown][], onto: any = {}): any => { for (const [name, value] of entries) onto[name] = value; return onto; };
const heirOf = (made: any): any => { kept.push(Object.create(made)); return made; };
attempt("one of its own:", () => enters(own()));
attempt("one that matches:", () => enters(heirOf(built([["inner", built([["p", 1], ["deep", [1]]])]]))));
attempt("without the member:", () => enters(heirOf(built([["other", 1]]))));
attempt("a number under the name:", () => enters(heirOf(built([["inner", 5]]))));
attempt("a string under the optional name:", () => enters(heirOf(built([["inner", built([["p", 1], ["deep", [1]]])], ["n", "no"]]))));
attempt("below, without a member:", () => enters(built([["inner", heirOf(built([["deep", [1]]]))]])));
attempt("below, a string for the number:", () => enters(built([["inner", heirOf(built([["p", "no"], ["deep", [1]]]))]])));
//// borrowed-prototype-unchanged.ts
// A plain object from untyped code that satisfies a record type, and that is the prototype of another object, stays as it is where it enters a typed place: at the top, below plain data, and where a read by name yields it. Its heir sees every later store. All data is built by stores, never written as a literal that looks like the type.
type Inner = { p: number; q?: string; deep: number[] };
type Outer = { inner: Inner; n?: number };
function own(): Outer { return { inner: { p: 7, deep: [1] } }; }
const kept: any[] = [];
function read(o: Outer): unknown { const i = o.inner; return [i.p, i.q, i.deep.length, o.inner.p, o.n]; }
function store(o: Outer): unknown { o.inner.q = "set"; o.n = 3; return [o.inner.q, o.n]; }
function attempt(name: string, f: () => unknown): void { try { console.log(name, JSON.stringify(f())); } catch (e) { console.log(name, (e as Error).name + ": " + (e as Error).message.split("\n").slice(0, 2).join(" | ").replace(/ \(bun compile[^)]*\)/, "").slice(0, 150)); } }
const built = (entries: [string, unknown][], onto: any = {}): any => { for (const [name, value] of entries) onto[name] = value; return onto; };
const inner = (): any => built([["p", 1], ["deep", [1, 2]]]);
const heirOf = (made: any): any => { kept.push(Object.create(made)); return made; };
const makers: [string, () => any][] = [
  ["one of its own", () => own()],
  ["plain data", () => built([["inner", inner()]])],
  ["the prototype of another", () => heirOf(built([["inner", inner()]]))],
  ["the prototype of another, parsed", () => heirOf(JSON.parse('{"inner": {"p": 1, "deep": [1, 2]}}'))],
  ["plain data that holds the prototype of another", () => built([["inner", heirOf(inner())]])],
  ["prototypes of others on both levels", () => heirOf(built([["inner", heirOf(inner())]]))],
  ["a proxy that holds the prototype of another", () => new Proxy(built([["inner", heirOf(inner())]]), {})],
  ["an accessor that yields the prototype of another", () => { const below = heirOf(inner()); return Object.defineProperty({}, "inner", { get() { return below; }, enumerable: true, configurable: true }); }],
];
for (const [name, make] of makers) {
  attempt(name + ":", () => { const source = make(); kept.push(source); const o: Outer = source; return [read(o), o === source, Object.keys(o).join()]; });
  attempt(name + ", stores:", () => { const source = make(); kept.push(source); const o: Outer = source; return [store(o), source.inner.q, source.n]; });
  attempt(name + ", its heir sees a later store:", () => { const before = kept.length; const source = make(); const o: Outer = source; o.n = 9; const heir = kept[before]; return heir === undefined ? "no heir" : [heir.n, heir.p, heir.inner === undefined]; });
}
//// boxes-of-nothing-beside-a-box-of-a-function-are-read-at-one-site.ts
// One site reads `value` from boxes of undefined, null, a function, a bigint, an array, a string and a number. The box of a function may keep its closure unmade until it is read,
// and such a slot holds neither undefined nor null. The slots of the other boxes are ordinary ones: what they hold has to come out as it is.
interface Box<T> {
  value: T;
}
const nothing: Box<undefined> = { value: undefined };
const nil: Box<null> = { value: null };
const thunk: Box<() => number> = { value: () => 42 };
const other: Box<() => number> = { value: () => 7 };
const big: Box<bigint> = { value: 12345678901234567890n };
const list: Box<number[]> = { value: [1, 2] };
const word: Box<string> = { value: "word" };
const count: Box<number> = { value: 1.5 };
const all: Box<unknown>[] = [nothing, nil, thunk, big, list, word, count, other, nil, nothing];

console.log(all.map(b => typeof b.value).join());
console.log(all.map(b => (typeof b.value === "function" ? (b.value as () => number)() : String(b.value))).join("|"));
console.log(all.map(b => b.value === undefined).join(), all.map(b => b.value === null).join());
console.log(all.map(b => b.value == null).join(), all.map(b => !!b.value).join());
console.log(all.map(b => (Array.isArray(b.value) ? b.value.length : typeof b.value === "bigint" ? "big" : -1)).join());
console.log(all.map(b => "value" in b).join(), all.map(b => Object.keys(b).join()).join());

function describe(b: Box<unknown>): string {
  const v = b.value;
  if (v === undefined) return "undefined";
  if (v === null) return "null";
  if (typeof v === "function") return "function " + v();
  if (typeof v === "object") return "object " + JSON.stringify(v);
  return typeof v + " " + String(v);
}
let text = "";
for (let round = 0; round < 300; round++) text = all.map(describe).join(";");
console.log(text);

// Only boxes of nothing and of functions.
const few: Box<(() => number) | undefined | null>[] = [{ value: undefined }, { value: () => 1 }, { value: null }, { value: () => 2 }];
console.log(few.map(b => (b.value ? b.value() : String(b.value))).join(), few.map(b => typeof b.value).join());
few[0].value = () => 3;
few[1].value = undefined;
few[3].value = null;
console.log(few.map(b => (b.value ? b.value() : String(b.value))).join(), few.map(b => typeof b.value).join());

// The same with objects of different shapes, which have a layout each whatever the type of `value` is.
////= lines-16	HasValue	value	unknown
const shapedNothing = { value: undefined, a: 1 };
const shapedNil = { value: null, b: 2 };
const shapedThunk = { value: () => 42, c: 3 };
const shapedBig = { value: 12345678901234567890n, d: 4 };
const shapedList = { value: [1, 2], e: 5 };
const shapedWord = { value: "word", f: 6 };
const shaped: HasValue[] = [shapedNothing, shapedNil, shapedThunk, shapedBig, shapedList, shapedWord, shapedNil, shapedNothing];
console.log(shaped.map(b => typeof b.value).join());
console.log(shaped.map(b => (typeof b.value === "function" ? (b.value as () => number)() : String(b.value))).join("|"));
function describeShaped(b: HasValue): string {
  const v = b.value;
  if (typeof v === "bigint") return "big";
  if (typeof v === "function") return "function " + v();
  if (typeof v === "string") return "string " + v.length;
  if (Array.isArray(v)) return "array " + v.length;
  return String(v);
}
for (let round = 0; round < 300; round++) text = shaped.map(describeShaped).join(";");
console.log(text);
//// brand-fields-stored-by-unseen-code.ts
// Fields that an interface requires and no compiled code ever stores, like the brands of the TypeScript compiler's own nodes, take no room in the cell. Text that is evaluated at run time stores, reads, tests, lists, deletes and redefines them, and typed code sees what it sees in plain Bun.
// STATISTIC: FieldsOutOfLine >= 3
interface Branded { kind: number; _firstBrand: any; _secondBrand: any }
interface AstNode { kind: number; pos: number }
interface Identifier extends AstNode { kind: 1; text: string; _expressionBrand: any; _declarationBrand: any }
interface NumericLiteral extends AstNode { kind: 2; value: number; _expressionBrand: any }
type Expression = Identifier | NumericLiteral;

// Always the empty string, which the compiler cannot know: it never sees the text that is evaluated, so it sees no store of a brand.
const nothing = String(Date.now()).slice(64);
function evaluated(parameters: string, body: string) {
  return new Function(parameters, body + nothing) as (...values: any[]) => any;
}
const store = evaluated("o, key, value", "o[key] = value");
const storeFirst = evaluated("o, value", "o._firstBrand = value");
const storeSecond = evaluated("o, value", "o._secondBrand = value");
const storeFirstStrictly = evaluated("o, value", "'use strict'; o._firstBrand = value");
const removeFirst = evaluated("o", "return delete o._firstBrand");
const define = evaluated("o, key, descriptor", "Object.defineProperty(o, key, descriptor)");
const reparent = evaluated("o, prototype", "Object.setPrototypeOf(o, prototype)");
const told = evaluated("o", `
  const listed = [];
  for (const key in o) listed.push(key);
  return [o.kind, String(o._firstBrand), String(o._secondBrand), "_firstBrand" in o, "_secondBrand" in o, Object.hasOwn(o, "_firstBrand"), Object.keys(o).join(), listed.join(), JSON.stringify(o)].join(" ");
`);
const toldOfNode = evaluated("o", `
  return [String(o._expressionBrand), String(o._declarationBrand), "_expressionBrand" in o, "_declarationBrand" in o, Object.keys(o).join(), JSON.stringify(o)].join(" ");
`);

function seen(o: Branded): string {
  const listed: string[] = [];
  for (const key in o) listed.push(key);
  return [o.kind, String(o._firstBrand), String(o._secondBrand), "_firstBrand" in o, "_secondBrand" in o, Object.hasOwn(o, "_firstBrand"), Object.keys(o).join(), listed.join(), JSON.stringify(o)].join(" ");
}
function seenOfIdentifier(n: Identifier): string {
  return [String(n._expressionBrand), String(n._declarationBrand), "_expressionBrand" in n, "_declarationBrand" in n, Object.keys(n).join(), JSON.stringify(n)].join(" ");
}
function seenOfLiteral(n: NumericLiteral): string {
  return [n.kind, n.pos, n.value, String(n._expressionBrand), "_expressionBrand" in n, Object.keys(n).join(), JSON.stringify(n)].join(" ");
}
function brandOf(n: Expression): unknown { return n._expressionBrand; }
// Typed code and evaluated text say the same of an object.
function both(o: Branded): string {
  const typed = seen(o), untyped = told(o);
  return typed === untyped ? typed : typed + " BUT EVALUATED TEXT SEES " + untyped;
}
function bothOfIdentifier(n: Identifier): string {
  const typed = seenOfIdentifier(n), untyped = toldOfNode(n);
  return n.kind + " " + n.pos + " " + n.text + " " + (typed === untyped ? typed : typed + " BUT EVALUATED TEXT SEES " + untyped);
}
function thrownBy(run: () => unknown): string {
  try { run(); return "nothing thrown"; } catch (error) { return (error as Error).name; }
}

let count = 0;
function show(name: string, make: () => unknown): void {
  let out: string;
  try { out = String(make()); } catch (error) { out = "THROWN " + (error as Error).name + ": " + (error as Error).message; }
  console.log(String(++count).padStart(2, "0"), name + ":", out);
}

const record = (kind: number) => ({ kind }) as Branded;
function NodeObject(this: AstNode, kind: number, pos: number) { this.kind = kind; this.pos = pos; }
const NodeConstructor = NodeObject as any as new (kind: number, pos: number) => AstNode;
function createIdentifier(text: string, pos: number): Identifier { const node = new NodeConstructor(1, pos) as Identifier; node.text = text; return node; }
function createNumericLiteral(value: number, pos: number): NumericLiteral { const node = new NodeConstructor(2, pos) as NumericLiteral; node.value = value; return node; }
class Token implements Branded {
  kind: number;
  declare _firstBrand: any;
  declare _secondBrand: any;
  constructor(kind: number) { this.kind = kind; }
}

show("nothing is stored", () => both(record(1)));
show("the second field, then the first", () => { const o = record(2); storeSecond(o, "s"); storeFirst(o, 1.5); return both(o); });
show("undefined is a value", () => { const o = record(3); storeFirst(o, undefined); return both(o); });
show("undefined, then a value, then undefined", () => { const o = record(4); storeFirst(o, undefined); storeFirst(o, 7); const filled = both(o); storeFirst(o, undefined); return filled + " ; " + both(o); });
show("values of every kind", () => [0, -0, 2 ** 31, -(2 ** 31) - 1, 0.5, NaN, "", "text", true, false, null, undefined].map(value => { const o = record(5); storeFirst(o, value); return both(o); }).join(" ; "));
show("an object and an array", () => { const o = record(6); storeFirst(o, record(7)); storeSecond(o, [1, record(8)]); return both(o) + " " + o._firstBrand.kind + " " + o._secondBrand[1].kind; });
show("the object itself", () => { const o = record(9); storeSecond(o, o); return (o._secondBrand === o) + " " + Object.keys(o._secondBrand._secondBrand).join(); });
show("under a computed key", () => { const o = record(10); store(o, "_second" + "Brand", 2); store(o, "_firstBrand", 1); store(o, "other", 3); return both(o); });
show("deleted, then stored again", () => { const o = record(11); storeFirst(o, 1); storeSecond(o, 2); const removed = removeFirst(o), without = both(o); storeFirst(o, 3); return removed + " " + without + " ; " + both(o); });
show("deleted by compiled code", () => { const o = record(12); storeFirst(o, 1); storeSecond(o, 2); const removed = delete (o as any)._firstBrand; return removed + " " + both(o); });
show("deleted though it was never stored", () => { const o = record(13); return removeFirst(o) + " " + delete (o as any)._secondBrand + " " + both(o); });
show("a getter that is not listed", () => {
  const o = record(14);
  let calls = 0;
  define(o, "_firstBrand", { get() { calls++; return "got"; }, enumerable: false, configurable: true });
  return both(o) + " " + calls + " " + thrownBy(() => storeFirstStrictly(o, 1)) + " " + removeFirst(o) + " " + both(o);
});
show("a getter and a setter", () => {
  const o = record(15);
  const log: string[] = [];
  define(o, "_secondBrand", { get() { return "got"; }, set(value: any) { log.push("set " + value); }, enumerable: true, configurable: true });
  storeSecond(o, 1);
  return both(o) + " " + log.join();
});
show("read-only", () => {
  const o = record(16);
  define(o, "_firstBrand", { value: "fixed", writable: false, enumerable: true, configurable: false });
  storeFirst(o, "other");
  return thrownBy(() => storeFirstStrictly(o, "other")) + " " + removeFirst(o) + " " + both(o);
});
show("redefined after a store", () => { const o = record(17); storeFirst(o, 1); define(o, "_firstBrand", { enumerable: false }); storeFirst(o, 2); return both(o); });
show("frozen before the store", () => { const o = record(18); Object.freeze(o); storeFirst(o, 1); return thrownBy(() => storeFirstStrictly(o, 1)) + " " + Object.isFrozen(o) + " " + both(o); });
show("frozen after the store", () => { const o = record(19); storeFirst(o, 1); Object.freeze(o); storeFirst(o, 2); storeSecond(o, 3); return removeFirst(o) + " " + Object.isFrozen(o) + " " + both(o); });
show("not extensible before the store", () => { const o = record(20); Object.preventExtensions(o); storeFirst(o, 1); return thrownBy(() => storeFirstStrictly(o, 1)) + " " + Object.isExtensible(o) + " " + both(o); });
show("sealed after the store", () => { const o = record(21); storeFirst(o, 1); Object.seal(o); storeFirst(o, 2); storeSecond(o, 3); return removeFirst(o) + " " + Object.isSealed(o) + " " + both(o); });
show("inherited, then own, then inherited again", () => {
  const o = record(22);
  reparent(o, { _firstBrand: "inherited" });
  const inherited = both(o);
  storeFirst(o, "own");
  const own = both(o);
  return inherited + " ; " + own + " ; " + removeFirst(o) + " " + both(o);
});
show("an accessor on the prototype", () => {
  const o = record(23);
  const log: string[] = [];
  reparent(o, { get _firstBrand(): any { return "from the getter"; }, set _firstBrand(value: any) { log.push("set " + value); } });
  storeFirst(o, 1);
  return both(o) + " " + log.join();
});
show("read-only on the prototype", () => { const o = record(24); reparent(o, Object.freeze({ _firstBrand: "fixed" })); storeFirst(o, 1); return thrownBy(() => storeFirstStrictly(o, 1)) + " " + both(o); });
show("no prototype", () => { const o = record(25); reparent(o, null); storeSecond(o, 2); return both(o); });
// An allocation that copies lists what it copies, so no typed read sees a copy made by spread: the fields of the records would count as stored with those of the copy.
show("copies", () => {
  const o = record(26);
  storeSecond(o, "s");
  const spread = { ...o }, bare = { ...record(27) }, assigned = Object.assign(record(28), o);
  storeFirst(spread, "f");
  return [told(spread), told(bare), both(assigned), Object.entries(o).join(";"), Object.values(o).join(), Object.getOwnPropertyNames(o).join(), Reflect.ownKeys(o).join()].join(" | ");
});
show("the descriptor", () => { const o = record(29); storeFirst(o, 1); return JSON.stringify(Object.getOwnPropertyDescriptor(o, "_firstBrand")) + " " + JSON.stringify(Object.getOwnPropertyDescriptor(o, "_secondBrand")); });

show("nodes without brands", () => bothOfIdentifier(createIdentifier("a", 1)) + " | " + seenOfLiteral(createNumericLiteral(2.5, 3)));
show("nodes with brands", () => {
  const name = createIdentifier("b", 4), number = createNumericLiteral(5, 6);
  store(name, "_declarationBrand", "d");
  store(name, "_expressionBrand", "e");
  store(number, "_expressionBrand", 7);
  return [bothOfIdentifier(name), seenOfLiteral(number), brandOf(name), brandOf(number), brandOf(createIdentifier("c", 8))].join(" | ");
});
show("a brand before the field of the node's own kind", () => { const node = new NodeConstructor(1, 9) as Identifier; store(node, "_expressionBrand", "early"); node.text = "late"; return bothOfIdentifier(node); });
show("a brand on a node of a kind that has none", () => { const node = new NodeConstructor(3, 10); store(node, "_expressionBrand", "stray"); return node.kind + " " + node.pos + " " + toldOfNode(node); });
show("a brand of the other kind", () => { const number = createNumericLiteral(11, 12); store(number, "_declarationBrand", "stray"); store(number, "text", "stray too"); return seenOfLiteral(number) + " " + toldOfNode(number); });
show("a frozen node", () => { const name = Object.freeze(createIdentifier("d", 13)); store(name, "_expressionBrand", 1); return bothOfIdentifier(name); });

show("instances of a class", () => { const token = new Token(30), fresh = both(token); storeSecond(token, 2); storeFirst(token, 1); return fresh + " ; " + both(token) + " " + (token instanceof Token); });
show("instances and records at one read", () => {
  const all: Branded[] = [record(31), new Token(32), record(33), new Token(34)];
  all.forEach((o, index) => { if (index & 1) storeFirst(o, index); else storeSecond(o, index); });
  return all.map(o => String(o._firstBrand) + "/" + String(o._secondBrand)).join();
});

show("many nodes, some of them branded", () => {
  const nodes: Identifier[] = [];
  for (let i = 0; i < 20000; i++) {
    const node = createIdentifier("n" + i, i);
    if (i % 3 === 0) store(node, "_expressionBrand", i);
    if (i % 7 === 0) store(node, "_declarationBrand", createIdentifier("held by " + i, -i));
    nodes.push(node);
  }
  let sum = 0, branded = 0, held = 0, length = 0;
  for (const node of nodes) {
    if ("_expressionBrand" in node) { branded++; sum += node._expressionBrand; }
    const other: Identifier | undefined = node._declarationBrand;
    if (other) { held += other.pos; length += other.text.length; }
  }
  return [sum, branded, held, length, Object.keys(nodes[0]).join(), Object.keys(nodes[1]).join(), Object.keys(nodes[3]).join(), Object.keys(nodes[7]).join()].join(" ");
});
