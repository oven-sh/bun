  const point = c.createInterfaceType("Point", [px, py, c.createProperty("self", anonymous, true)], [anonymous])
  console.log(debugging, keysOf(c.anyType), "|", keysOf(a), "|", keysOf(fresh), "|", keysOf(two), "|", keysOf(union), "|", keysOf(anonymous), "|", keysOf(point), "|", keysOf(call))
  console.log(keysOf(px), "|", keysOf(py), "|", keysOf((py as TransientSymbol).links), "|", keysOf(c.getSymbolLinks(px)), (px as any).links, px.id, py.id, (py as TransientSymbol).links.checkFlags, px.parent === point.symbol)
  console.log(c.checker.typeToString(point), "||", c.checker.typeToString(union), c.checker.getTypeCount(), union.objectFlags, point.objectFlags, point.flags, a.id, fresh.id, two.value, a.value)
  console.log(fresh.regularType === a, a.freshType === fresh, fresh.freshType === fresh, a.regularType === a, two.freshType === undefined, "freshType" in two, c.getStringLiteralType("a") === a, c.getUnionType([a, c.stringType, two]) === union)
  console.log("checker" in a, a.checker === (debugging ? c.checker : undefined), "symbol" in c.anyType, c.anyType.symbol, "symbol" in a, a.symbol, c.numberType.debugIntrinsicName, c.anyType.debugIntrinsicName, "aliasSymbol" in point, point.aliasSymbol, point.typeParameters)
}
//// checks-from-narrowed-types.ts
// A type that comes from narrowing, from a type guard or from context rather than from an annotation is a prediction: nothing is tested and nothing throws. A type argument that the program wrote is tested.
/* expected
e1 a1
e2 2
e3 1a
e4 number,string,bigint
e5 number,number
f1 text1
f2 2
f3 text
f4 object
f5 number
f6 number
g1 TypeError
g2 ab
g3 number
*/
////= attempt
// The parameter of a callback has the type its context gives it, and is entered by a caller that knows nothing of it: whatever arrives goes on as it is.
attempt("e1", () => (JSON.parse('["a"]') as number[]).map(n => n + 1).join())
attempt("e2", () => (JSON.parse("[1]") as number[]).map(n => n + 1).join())
attempt("e3", () => (JSON.parse('[1,"a"]') as number[]).reduce((sum, n) => sum + n, 0))
function isNumber(v: unknown): v is number { return v !== null }
attempt("e4", () => [1, "two", 3n].filter(isNumber).map(n => typeof n).join())
attempt("e5", () => [1, null, 3].filter(isNumber).map(n => typeof n).join())
// The receiver is narrowed to a member of a union, or by a guard: the property is tested against what the written type of the receiver declares, not against the narrowed type.
type S = { kind: "n"; v: number } | { kind: "s"; v: string }
function read(s: S): number | string { return s.kind === "n" ? s.v + 1 : s.v }
attempt("f1", () => read(JSON.parse('{"kind":"n","v":"text"}')))
attempt("f2", () => read(JSON.parse('{"kind":"n","v":1}')))
attempt("f3", () => read(JSON.parse('{"kind":"s","v":"text"}')))
class Holder { value: unknown = 5; isText(): this is { value: string } { return true } }
attempt("f4", () => { const h = new Holder(); return h.isText() ? typeof h : "no" })
attempt("f5", () => { const h = new Holder(); return h.isText() ? typeof h.value : "no" })
attempt("f6", () => { const h = new Holder(); return typeof h.value })
class Wrapper<T> { constructor(public inner: T) {} get(): T { return this.inner } }
attempt("g1", () => (new Wrapper<unknown>(5) as Wrapper<string>).get().length)
attempt("g2", () => (new Wrapper<unknown>("ab") as Wrapper<string>).get())
attempt("g3", () => typeof (new Wrapper<unknown>(5) as Wrapper<string> as Wrapper<unknown>).get())
//// class-accessors.ts
// Getters and setters of classes: read through interface types, and overridden only in part by subclasses.
interface Sized { size: number }
interface Titled { title: string; size?: number }
const seen: string[] = []
function flush(): string { return seen.splice(0).join(",") }
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
class Bag implements Sized {
  items: number[] = []
  get size(): number { seen.push("get"); return this.items.length }
  set size(n: number) { seen.push("set" + n); this.items.length = n }
}
class Fixed implements Sized { size = 3 }
class GetOnly implements Sized { get size(): number { return 42 } }
class Half extends Bag { override get size(): number { return super.size + 100 } }
class Both extends Bag {
  override get size(): number { return super.size * 2 }
  override set size(n: number) { super.size = n + 1 }
}
function grow(s: Sized): number { s.size += 2; return s.size }
console.log(attempt(() => grow(new Bag())), flush())
console.log(attempt(() => grow(new Fixed())), attempt(() => grow({ size: 1 })), attempt(() => grow(new GetOnly())), flush() === "")
console.log(attempt(() => grow(new Half())), flush())
console.log(attempt(() => grow(new Both())), flush())
const bag = new Bag()
bag.size = (seen.push("rhs"), 1)
console.log(flush(), "size" in bag, Object.hasOwn(bag, "size"), JSON.stringify(bag), Object.keys(bag).join(), bag.size++, bag.size, flush())
const sizes: Sized[] = [new Fixed(), new GetOnly(), { size: 1 }, new Both(), bag]
let total = 0
for (let i = 0; i < 50; i++) total += sizes[i % sizes.length].size
console.log(total, flush().length)
// An optional field of an interface that one class answers with a getter on its prototype.
class Paper implements Titled { title = "paper"; get size(): number { seen.push("paper"); return 9 } }
class Blank implements Titled { title = "blank" }
function sizeOr(t: Titled): string { return t.title + ":" + String(t.size) + ":" + ("size" in t) + ":" + Object.hasOwn(t, "size") }
const titled: Titled[] = [new Paper(), new Blank(), { title: "lit" }, { title: "lit2", size: 1 }]
console.log(titled.map(t => sizeOr(t)).join(" "), flush())
console.log(titled.map(t => attempt(() => { t.size = 5; return t.size })).join(), Object.keys(titled[1]).join(), flush())
// A getter that throws, static ones, a setter alone.
class Moody { mood = 0; get risky(): number { if (this.mood++ % 2 === 0) throw new RangeError("even"); return this.mood } }
const moody = new Moody()
console.log(attempt(() => moody.risky), attempt(() => moody.risky), attempt(() => moody.risky + moody.risky), moody.mood)
class Tally { static #n = 0; static get next(): number { return ++Tally.#n } static set next(x: number) { Tally.#n = x } }
console.log(Tally.next, Tally.next, (Tally.next = 10), Tally.next, Tally.next++, Tally.next)
class Sink { last = 0; set value(x: number) { this.last = x * 2 } }
const sink = new Sink()
sink.value = 4
console.log(sink.last, (sink as any).value, "value" in sink, JSON.stringify(sink))
//// class-fields-seen-before-the-constructor-stores-them.ts
const seen: string[] = [];
function note(label: string, value: unknown): void {
  seen.push(label + "=" + (value === undefined ? "undefined" : JSON.stringify(value)));
}
function keysOf(value: object): string {
  return Object.keys(value).join(",");
}

class Filled {
  count: number;
  ratio: number;
  flag: boolean;
  label: string;
  link: Filled | null;
  next: Filled;
  constructor(seed: number) {
    this.next = this;
    this.link = null;
    this.label = "l" + seed;
    this.flag = seed > 1;
    this.ratio = seed + 0.5;
    this.count = seed | 0;
  }
}

class ReadsFirst {
  count: number;
  constructor(seed: number) {
    note("ReadsFirst.count", (this as any).count);
    note("ReadsFirst has count", "count" in this);
    this.count = seed;
  }
}

class CallsMethod {
  first: number;
  second: number;
  constructor(seed: number) {
    this.first = seed;
    this.show();
    this.second = seed;
  }
  show(): void {
    note("CallsMethod.first", this.first);
    note("CallsMethod.second", this.second);
  }
}

class CapturesThis {
  count: number;
  read: () => number;
  constructor(seed: number) {
    this.read = () => this.count;
    note("CapturesThis.count", this.read());
    this.count = seed;
  }
}

class InitializerReads {
  count: number;
  early = (this as any).count as unknown;
  constructor(seed: number) {
    this.count = seed;
  }
}

class StoresOnOnePath {
  count!: number;
  constructor(seed: number) {
    if (seed > 1) this.count = seed;
  }
}

class ReadsItselfBack {
  self: ReadsItselfBack;
  count: number;
  constructor(seed: number) {
    this.self = this;
    note("ReadsItselfBack.count", this.self.count);
    this.count = seed;
  }
}

class ListsKeys {
  first: number;
  second: number;
  constructor(seed: number) {
    this.second = seed;
    note("ListsKeys", keysOf(this) + ":" + JSON.stringify(this));
    this.first = seed;
  }
}

const registry: object[] = [];
class Registers {
  constructor() {
    registry.push(this);
  }
}
class BelowRegisters extends Registers {
  early: number;
  late: number;
  constructor(seed: number) {
    super();
    this.early = seed;
    note("BelowRegisters.late", (registry[registry.length - 1] as BelowRegisters).late);
    this.late = seed;
  }
}

class Below extends Filled {
  extra: number;
  other: Filled;
  constructor(seed: number, other: Filled) {
    super(seed);
    this.extra = seed + 1;
    this.other = other;
  }
}

class Redeclares extends Filled {
  count: number;
  constructor(seed: number) {
    super(seed);
    note("Redeclares.count", (this as any).count);
    this.count = seed + 100;
  }
}

class ReverseOrder {
  z: number;
  y: number;
  x: number;
  constructor() {
    this.x = 1;
    this.y = 2;
    this.z = 3;
  }
}

let halfMade: ThrowsHalfway | undefined;
class ThrowsHalfway {
  first: number;
  second: number;
  constructor(seed: number, leak: boolean) {
    this.first = seed;
    if (leak) halfMade = this;
    if (seed > 5) throw new RangeError("too large");
    this.second = seed;
  }
}

class SetterBelow extends Filled {}
Object.defineProperty(SetterBelow.prototype, "count", {
  set(value: number) {
    note("SetterBelow.set count", value);
  },
  get() {
    return -1;
  },
  configurable: true,
});

function sum(head: Filled, steps: number): number {
  let total = 0;
  let at = head;
  for (let i = 0; i < steps; i++) {
    total = (total + at.count) | 0;
    total += at.ratio;
    if (at.flag) total += at.label.length;
    if (at.link !== null) total += at.link.count;
    at = at.next;
  }
  return total;
}

const a = new Filled(1), b = new Filled(2);
