interface Small { a: number; b: string; c: Leaf }
interface Large { a: number; b: string; c: Leaf; d: number; e: string; f: Leaf; g: number; h: string; i: Leaf; j: number; k: string; l: Leaf; m: number }
interface Sparse { a: number; b?: string; c?: Leaf; d?: number; e?: string; f?: Leaf; g?: number; h?: string }

const createSmall = (i: number): Small => ({ a: n(i, 0), b: s(i, 1), c: r(i, 2) });
const createLarge = (i: number): Large => ({ a: n(i, 0), b: s(i, 1), c: r(i, 2), d: n(i, 3), e: s(i, 4), f: r(i, 5), g: n(i, 6), h: s(i, 7), i: r(i, 8), j: n(i, 9), k: s(i, 10), l: r(i, 11), m: n(i, 12) });
const copySmall = (o: Small): Small => ({ ...o });
const copyLarge = (o: Large): Large => ({ ...o });
const copySparse = (o: Sparse): Sparse => ({ ...o });
const changeSmall = (o: Small, i: number): void => { o.a = n(i, 20); o.b = s(i, 21); o.c = r(i, 22); };
const changeLarge = (o: Large, i: number): void => { o.a = n(i, 20); o.b = s(i, 21); o.f = r(i, 22); o.g = n(i, 23); o.k = s(i, 24); o.l = r(i, 25); o.m = n(i, 26); };

// A store to a frozen object throws here, so a copy that is still frozen ends the program.
function checkIndependence<T extends object>(name: string, freezesSource: boolean, create: (i: number) => T, copy: (o: T) => T, change: (o: T, i: number) => void): void {
  let wrong = 0;
  for (let i = 0; i < 1000; i++) {
    const source = create(i);
    if (freezesSource) Object.freeze(source);
    const result = copy(source);
    if (Object.isFrozen(result) || Object.isSealed(result) || !Object.isExtensible(result)) wrong++;
    change(result, i);
    (result as any).added = i;
    const expected = create(i);
    if (JSON.stringify(source) !== JSON.stringify(expected) || Object.isFrozen(source) !== freezesSource) wrong++;
    change(expected, i);
    (expected as any).added = i;
    if (JSON.stringify(result) !== JSON.stringify(expected)) wrong++;
    if (i % 250 === 249) edenGC();
  }
  console.log(name, freezesSource ? "copy of a frozen source:" : "copy that is changed:", wrong, "wrong");
}

checkIndependence("small", false, createSmall, copySmall, changeSmall);
checkIndependence("large", false, createLarge, copyLarge, changeLarge);
checkIndependence("small", true, createSmall, copySmall, changeSmall);
checkIndependence("large", true, createLarge, copyLarge, changeLarge);

function checkAddedProperties<T extends object>(name: string, create: (i: number) => T, copy: (o: T) => T): void {
  let wrong = 0;
  let keys = "";
  for (let i = 0; i < 1000; i++) {
    const source = create(i);
    (source as any).extra = s(i, 30);
    (source as any).more = r(i, 31);
    const result = copy(source);
    wrong += countDifferences(source, result);
    keys = Object.keys(result).join();
    if (i % 250 === 249) edenGC();
  }
  console.log(name, "source with added properties:", wrong, "wrong,", keys);
}

checkAddedProperties("small", createSmall, copySmall);
checkAddedProperties("large", createLarge, copyLarge);

function checkFieldsStoredLater(): void {
  let wrong = 0;
  let keys = "";
  for (let i = 0; i < 1000; i++) {
    const source: Sparse = { a: n(i, 0) };
    wrong += countDifferences(source, copySparse(source));
    source.h = s(i, 7);
    wrong += countDifferences(source, copySparse(source));
    source.c = r(i, 2);
    source.d = n(i, 3);
    wrong += countDifferences(source, copySparse(source));
    source.b = s(i, 1);
    source.e = s(i, 4);
    source.f = r(i, 5);
    source.g = n(i, 6);
    const result = copySparse(source);
    wrong += countDifferences(source, result);
    keys = Object.keys(result).join();
    if (i % 250 === 249) edenGC();
  }
  console.log("source with fields stored later:", wrong, "wrong,", keys);
}

checkFieldsStoredLater();
//// copies-of-thousands-of-kinds-of-typed-object.ts
// Typed objects with undeclared keys of thousands of kinds are cloned, spread, assigned, frozen, listed and compared: every road that copies or lists a typed object, past the caps of what those roads remember.
interface Item { id: number }
interface Holder { first: number; items: Item[]; last: string }
let serial = 0;
function holderText(count: number): string {
  const items: string[] = [];
  for (let at = 0; at < count; at++) items.push(at % 2 ? '{"id":' + at + ',"k' + ++serial + '":' + at + "}" : '{"p' + ++serial + '":[' + at + '],"id":' + at + ',"q":"s"}');
  return '{"a":"before","first":1,"items":[' + items.join(",") + '],"c":"behind","last":"l","d":{"e":null}}';
}
const roads: [string, (holder: Holder) => unknown][] = [
  ["structuredClone", holder => structuredClone(holder)],
  ["structuredClone of each item", holder => ({ ...holder, items: holder.items.map(item => structuredClone(item)) })],
  ["spread", holder => ({ ...holder, items: holder.items.map(item => ({ ...item })) })],
  ["Object.assign", holder => Object.assign({}, holder, { items: holder.items.map(item => Object.assign({}, item)) })],
  ["Object.entries", holder => Object.fromEntries(Object.entries(holder).map(([key, value]) => [key, key === "items" ? (value as Item[]).map(item => Object.fromEntries(Object.entries(item))) : value]))],
  ["for in", holder => {
    const copy: any = {};
    for (const key in holder) copy[key] = (holder as any)[key];
    copy.items = holder.items.map(item => {
      const made: any = {};
      for (const key in item) made[key] = (item as any)[key];
      return made;
    });
    return copy;
  }],
  ["own property descriptors", holder => Object.defineProperties({}, Object.getOwnPropertyDescriptors({ ...holder, items: holder.items.map(item => Object.defineProperties({}, Object.getOwnPropertyDescriptors(item))) }))],
  ["frozen, then spread", holder => ({ ...Object.freeze(holder), items: holder.items.map(item => ({ ...Object.freeze(item) })) })],
  ["rest", holder => {
    const { first, ...rest } = holder;
    return { a: (rest as any).a, first, items: holder.items.map(({ ...all }) => all), c: (rest as any).c, last: rest.last, d: (rest as any).d };
  }],
];
for (const [label, copy] of roads) {
  const wrong: number[] = [];
  for (const count of [10, 4095, 4096, 4097, 8200, 16385, 20000]) {
    const text = holderText(count);
    const holder = JSON.parse(text) as Holder;
    if (JSON.stringify(copy(holder)) !== text || JSON.stringify(copy(holder)) !== text || JSON.stringify(holder) !== text) wrong.push(count);
  }
  console.log(label + ": " + wrong.length + " differ" + (wrong.length ? " (" + wrong.join() + ")" : ""));
}
//// copies-with-private-fields.ts
// Object spread, `Object.assign` and `JSON.stringify` on instances with private fields.
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
class Model { id = 1; #secret = 2; reveal() { return this.#secret } hide(v: number) { this.#secret = v } }
const model = new Model()
const flat = { ...model }
console.log(attempt(() => Model.prototype.reveal.call(flat as Model)), model.reveal(), attempt(() => Model.prototype.hide.call(flat as Model, 1)), Reflect.ownKeys(flat).length)
//// copy-accepts-what-annotation-accepts.ts
// `{ ...source, name: value }` under a written type, where the object that is copied was created as a narrower type than the one the copy is written as: the copy takes whatever its own written type takes.
const row = (name: string, f: () => unknown) => { let r: unknown; try { r = JSON.stringify(f()); } catch (e) { r = "THROWS " + (e as Error).message.split(" (bun")[0]; } console.log(name + ": " + r); };

type Failures = { last: number | null; count: number; name: string };
type Fresh = { last: null; count: number; name: string };
type FreshAndMore = { last: null; count: number; name: string; extra: boolean };
type Counts = { last: number; count: number };

const fresh: Fresh = { last: null, count: 0, name: "fresh" };
const freshAndMore: FreshAndMore = { last: null, count: 0, name: "more", extra: true };
const wide: Failures = { last: null, count: 0, name: "wide" };
const constant = { last: null, count: 0, name: "constant" } as const;

function stamp(failures: Failures, now: number): Failures {
  if (failures.last === null) return { ...failures, last: now };
  return failures;
}
function merge(failures: Failures, counts: Counts): Failures {
  if (failures.last === null) return { ...failures, ...counts };
  return failures;
}
function stampInsideTry(failures: Failures, now: number): Failures {
  try {
    return { ...failures, last: now };
  } catch {
    return failures;
  }
}
function stampAndCount(failures: Failures, now: number): Failures {
  return { ...failures, last: now, count: failures.count + 1 };
}
function stampWithWorkBetween(failures: Failures, now: number): Failures {
  return { ...failures, name: failures.name.toUpperCase(), last: Math.max(now, failures.count) };
}
function stampIf(failures: Failures, now: number): Failures {
  return { ...failures, ...(now > 0 ? { last: now } : {}) };
}
function stampAnd(failures: Failures, now: number): Failures {
  return { ...failures, ...(now > 0 && { last: now }) };
}
function clear(failures: Failures): Failures {
  return { ...failures, last: null };
}

const sources: [string, Failures][] = [["a narrower written type", fresh], ["a narrower type with one member more", freshAndMore], ["the written type itself", wide], ["an `as const` literal", constant]];
for (const [name, source] of sources) {
  row(name + ": one member written behind the spread", () => stamp(source, 7));
  row(name + ": a second spread of a typed object", () => merge(source, { last: 8, count: 1 }));
  row(name + ": inside try", () => stampInsideTry(source, 10));
  row(name + ": two members", () => stampAndCount(source, 11));
  row(name + ": with calls between the members", () => stampWithWorkBetween(source, 12));
  row(name + ": a conditional literal spread", () => [stampIf(source, 13), stampIf(source, 0)]);
  row(name + ": a literal spread behind &&", () => [stampAnd(source, 14), stampAnd(source, 0)]);
  row(name + ": a value the narrower type takes too", () => clear(source));
  row(name + ": the keys of the copy", () => Object.keys(stamp(source, 15)));
  row(name + ": the copy is stored to again", () => { const copy = stamp(source, 16); copy.last = null; copy.count = 3; const again = stamp(copy, 17); return [copy, again]; });
  row(name + ": the source is left as it was", () => source);
}
row("the member more is read from the copy", () => { const copy = stamp(freshAndMore, 18); return ["extra" in copy, (copy as FreshAndMore).extra]; });

let sum = 0;
for (let i = 0; i < 20000; i++) {
  const source = i % 3 === 0 ? fresh : i % 3 === 1 ? wide : freshAndMore;
  sum += stamp(source, i).last! + merge(source, { last: i, count: 1 }).count + stampAndCount(source, i).count;
}
row("many times, the types taking turns", () => sum);

type Inner = { a: number };
type Outer = { inner: Inner | undefined; label: string | number; on: boolean; list: number[] | null };
type Bare = { inner: undefined; label: string; on: false; list: null };
const bare: Bare = { inner: undefined, label: "x", on: false, list: null };
const fill = (outer: Outer): Outer => ({ ...outer, inner: { a: 1 }, label: 5, on: true, list: [1, 2] });
row("undefined to an object, a string to a number, false to true, null to an array", () => [fill(bare), bare]);
row("what was filled is read", () => { const filled = fill(bare); return [filled.inner!.a + 1, typeof filled.label, filled.on === true, filled.list!.length]; });

type Optional = { last?: number; count: number };
type Without = { count: number };
type NeverSet = { last?: undefined; count: number };
const without: Without = { count: 0 };
const neverSet: NeverSet = { count: 1 };
const setLast = (given: Optional, now: number): Optional => ({ ...given, last: now });
row("an optional member the source has no room for", () => [setLast(without, 19), setLast(neverSet, 20), without, neverSet]);

type State = { failures: Failures; name: string };
const nested = (state: State, counts: Counts): State => (state.failures.last === null ? { ...state, failures: { ...state.failures, ...counts } } : state);

let held: Failures = fresh;
const update = (f: (previous: Failures) => Failures) => { held = f(held); };
update(previous => (previous.last === null ? { ...previous, last: 22 } : previous));
row("through an updater", () => held);
update(previous => ({ ...previous, last: null }));
row("through an updater, back to null", () => held);

type Flagged = { readonly on: boolean; readonly text: string | undefined };
type Off = { readonly on: false; readonly text: undefined };
const off: Off = { on: false, text: undefined };
const turnOn = (flagged: Flagged): Flagged => ({ ...flagged, on: true, text: "t" });
row("readonly members", () => [turnOn(off), off]);

type Tally = { readonly tries: number } & { readonly saved: number | null; readonly waited: boolean };
const noTally: Tally = Object.freeze({ tries: 0, saved: null, waited: false });
const save = (tally: Tally, more: { tries: number } | null): Tally => (tally.saved !== null ? tally : { ...tally, ...more, saved: Object.values(more ?? {}).reduce((sum, n) => sum + n, 0) });
row("a literal created inside Object.freeze()", () => [save(noTally, { tries: 2 }), save(noTally, null), Object.isFrozen(save(noTally, null)), noTally]);
//// declared-fields-under-other-prototype/core.ts
export class Core {
  declare first: unknown;
  declare second: Function | undefined;
  declare third?: number;
  declare fourth?: string;
  always = "always";
  constructor(options: any) {
    this.first = options;
    this.second = () => options;
    if (options !== 0) this.third = 3;
  }
  later(value: string) {
    this.fourth = value;
  }
  describe(): string {
    return [String(this.first), typeof this.second, String(this.third), String(this.fourth), this.always].join();
  }
}
export var Valued = class {
  declare one: unknown;
  declare two?: unknown;
  constructor(options: any) {
    this.one = options;
    this.fill = (value: unknown) => {
      this.two = value;
    };
  }
  declare fill: (value: unknown) => void;
};
//// declared-fields-under-other-prototype/heirs.js
import { Core, Valued } from "./core.ts";
export class Plain extends Core {
  constructor(options) {
    super(options);
  }
}
export class WithOwn extends Core {
  constructor(options) {
    super(options);
    this.own = "own " + options;
    this.fourth = "by the heir";
  }
}
export class WithSetter extends Core {
  constructor(options) {
    super(options);
  }
  set first(value) {
    this.caught = "caught " + value;
  }
  get first() {
    return "from the getter";
  }
}
export class WithSetterLater extends Core {}
