console.log(lines.join("\n"));
//// define-property-on-fields.ts
// `Object.defineProperty` on fields of typed objects, as long as the field stays a writable, enumerable and configurable data property.
interface Item { id: number; title: string; price: number; stock?: number; tags: string[] }
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
function make(id: number): Item { return { id, title: "item" + id, price: id * 1.5, tags: ["t" + id] } }
function flagsOf(o: object, k: string): string {
  const d = Object.getOwnPropertyDescriptor(o, k)
  if (d === undefined) return "-"
  return ("value" in d ? "v" : (d.get ? "g" : "") + (d.set ? "s" : "")) + (d.writable ? "W" : "") + (d.enumerable ? "E" : "") + (d.configurable ? "C" : "")
}
function show(i: Item): string {
  return [i.id, i.title, i.price, String(i.stock), i.tags.join("+"), Object.keys(i).join(""), ["id", "title", "price", "stock", "tags"].map(k => flagsOf(i, k)).join(".")].join("/")
}
function raise(i: Item, by: number): number { i.price += by; return i.price }
// A new value, with all attributes, with those that are true already, with none.
const plain = make(1)
Object.defineProperty(plain, "price", { value: 5, writable: true, enumerable: true, configurable: true })
console.log(show(plain), raise(plain, 1))
Object.defineProperty(plain, "price", { value: 99 })
Object.defineProperty(plain, "title", { enumerable: true })
Object.defineProperty(plain, "tags", { writable: true, value: ["new"] })
Object.defineProperty(plain, "id", {})
console.log(show(plain), raise(plain, 0.5), flagsOf(plain, "price"), JSON.stringify(plain))
// An absent optional field is defined: it comes last among the keys.
const stocked = make(2)
Object.defineProperty(stocked, "stock", { value: 1, writable: true, enumerable: true, configurable: true })
stocked.stock = 2
console.log(show(stocked), (stocked.stock ?? 0) + 1, delete stocked.stock, show(stocked), stocked.stock ?? "none")
console.log(Reflect.defineProperty(stocked, "stock", { value: 7, writable: true, enumerable: true, configurable: true }), show(stocked))
// Several at once, through a helper that only knows `object`, and on an object inside a typed field.
function reset(o: object, values: Record<string, unknown>): void { for (const k of Object.keys(values)) Object.defineProperty(o, k, { value: values[k], writable: true, enumerable: true, configurable: true }) }
interface Basket { first: Item; rest: Item[] }
const basket: Basket = { first: make(8), rest: [make(9), make(10)] }
reset(basket.first, { id: 80, tags: [] }); reset(basket.rest[1], { price: 0.25 }); reset(basket, { first: basket.rest[0] })
console.log(basket.first === basket.rest[0], basket.first.id++, basket.first.tags.push("more"), raise(basket.rest[0], 1), raise(basket.rest[1], 1), show(basket.first), show(basket.rest[1]))
Object.defineProperty(basket.rest[0], "id", { value: 900 }); Object.defineProperty(basket.rest[0], "stock", { value: 0, writable: true, enumerable: true, configurable: true }); Object.defineProperty(basket.rest[0], "extra", { value: "x", enumerable: true })
console.log(show(basket.rest[0]), (basket.rest[0].stock ?? -5) + 1, flagsOf(basket.rest[0], "extra"), attempt(() => { (basket.rest[0] as any).extra = "y" }))
// Classes.
class Priced { net = 100; rate = 0.5; gross() { return this.net * (1 + this.rate) } }
const priced = new Priced()
Object.defineProperty(priced, "rate", { value: 0.1 })
console.log(priced.gross(), new Priced().gross(), Object.keys(priced).join(), flagsOf(priced, "rate"), flagsOf(priced, "gross"))
const items: Item[] = [plain, stocked, basket.first, basket.rest[1], make(11)]
let sum = 0
for (let i = 0; i < 100; i++) { const it = items[i % items.length]; sum += it.id + it.price + it.title.length + (it.stock ?? 0) + it.tags.length }
console.log(sum)
//// definition-and-store-under-the-same-key.ts
// A store `made[key] = value` of a property that a typed object's layout does not have is remembered in a table by the object's Structure and the key. A definition `{ .., [key]: value }` on an object of the same Structure under the same key looks into the same table: it must read such an entry as what it is.
interface Named { id: number; label: string }
function defined(key: string, id: number): Named { return { id, label: "x", [key]: id }; }
function stored(key: string, id: number): Named { const made: Named = { id, label: "x" }; (made as unknown as Record<string, number>)[key] = id; return made; }
function definedTwice(key: string, other: string, id: number): Named { return { id, label: "y", [key]: id, [other]: id + 1 }; }
const makers: ((key: string, id: number) => Named)[] = [stored, defined];
const twice: ((key: string, other: string, id: number) => Named)[] = [definedTwice];
const names = ["k0", "k1", "k2", "k3", "k4", "k5", "k6", "k7", "k8"];
function weigh(made: Named, key: string): number {
  return made.id + made.label.length + ((made as unknown as Record<string, number>)[key] ?? -1000000) + Object.keys(made).length;
}
let total = 0;
for (const order of [[0, 1], [1, 0], [0, 0], [1, 1]]) {
  for (const which of order) {
    for (let i = 0; i < 400; i++) total += weigh(makers[which]!(names[i & 3]!, i), names[i & 3]!);
  }
  console.log(order.join(), total);
}
for (let i = 0; i < 800; i++) total += weigh(makers[i & 1]!(names[(i >> 1) & 3]!, i), names[(i >> 1) & 3]!);
console.log(total);
for (let i = 0; i < 800; i++) {
  const made = twice[0]!(names[i % 9]!, names[(i + 1 + (i % 7)) % 9]!, i);
  total += weigh(made, names[i % 9]!);
  if (i % 100 === 0) console.log(JSON.stringify(made), Object.keys(made).join());
}
console.log(total);
const last = makers[1]!("k0", 1);
console.log(JSON.stringify(Object.getOwnPropertyDescriptor(last, "k0")), JSON.stringify(last), Object.getPrototypeOf(last) === Object.prototype);
//// delete-in-vm-context.ts
// `delete` inside a node:vm context removes the property from the object that is the context's global object. The object may be a typed object.
import vm from "node:vm";
type Sandbox = { alpha?: number; beta: string };
class Box {
  alpha?: number = 3;
  beta = "box";
}
const record: Sandbox = { alpha: 1, beta: "record" };
for (const sandbox of [record, new Box()]) {
  const context = vm.createContext(sandbox);
  console.log(vm.runInContext("delete globalThis.alpha", context), vm.runInContext("typeof alpha", context), vm.runInContext("'alpha' in globalThis", context));
  console.log("alpha" in sandbox, sandbox.alpha, JSON.stringify(sandbox));
}
//// delete-on-typed-objects.ts
// `delete` on typed objects: through the type, `any`, `Reflect` and computed keys; absent is not the same as undefined; a field that is added again moves to the end of the keys.
interface Author { toLocaleString?: () => string; nick: string; age?: number }
interface Doc { toLocaleString?: () => string; id: number; title?: string; pages?: number; draft?: boolean; author: Author; editor?: Author | null; refs: number[] }
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
function make(id: number): Doc { return { id, title: "t" + id, pages: id * 10, draft: false, author: { nick: "a" + id }, editor: null, refs: [id] } }
function show(d: Doc): string {
  return [String(d.title), String(d.pages), String(d.draft), d.author ? d.author.nick : String(d.author), d.editor ? d.editor.nick : String(d.editor), d.refs ? d.refs.length : "no refs",
    ["title", "pages", "draft", "author", "editor"].map(k => k in d ? "1" : "0").join(""), Object.keys(d).join(",")].join("/")
}
const one = make(1)
console.log(show(one))
console.log(delete one.pages, delete one.pages, show(one), (one.pages ?? 0) + 1, one.pages === undefined, Object.hasOwn(one, "pages"))
one.pages = 7
console.log(show(one), JSON.stringify(one))
// Absent, undefined and null are three states.
const states = [make(2), make(2), make(2), make(2)]
states[0].editor = undefined; states[1].editor = null; delete states[2].editor; states[3].editor = { nick: "ed" }
states[0].draft = undefined; delete states[2].draft; states[0].title = undefined; states[1].title = ""; delete states[2].title
console.log(states.map(d => show(d)).join(" "))
console.log(states.map(d => JSON.stringify(d)).join(" "))
console.log(states.map(d => [d.editor === null, d.editor === undefined, d.editor == null, "editor" in d, d.draft === false, d.title ?? "?", d.title || "!"].join("")).join(" "))
// The same through `any`, Reflect, a computed key and a narrower view.
function dropAny(o: any, k: string): boolean { return delete o[k] }
function dropTitle(o: { title?: string }): boolean { return delete o.title }
const two = make(3)
console.log(dropAny(two, "draft"), Reflect.deleteProperty(two, "pages"), dropTitle(two), dropAny(two, "nothing"), show(two))
two.title = "back"; two.draft = true; two.pages = 1
console.log(show(two), two.title.length + two.pages)
// An optional field of an object in a field.
const three = make(4)
three.author = { nick: "again", age: 3 }
three.refs = []
console.log(show(three), three.author.age, delete three.author.age, String(three.author.age), Object.keys(three.author).join())
// An absent property is looked up on the prototype chain.
const five = make(6)
delete five.title; delete five.pages
console.log(String(five.title), String(five.pages), make(7).title, "title" in five, Object.hasOwn(five, "title"), (five.pages ?? 0) + 1, Object.keys(five).join())
five.title = "own"
console.log(five.title, String(five.pages), "pages" in five)
// Every optional property is deleted and added back in a different order.
const six = make(8)
for (const k of ["title", "pages", "draft", "editor"]) dropAny(six, k)
console.log(JSON.stringify(six), Object.keys(six).length, String(six.title), String(six.editor))
six.refs = [1]; six.editor = null; six.author = { nick: "z" }; six.draft = true; six.pages = 2; six.title = "s"; six.id = 9
console.log(show(six), six.id, JSON.stringify(six))
// Classes: an own field.
class Page { num = 1; note?: string = "n"; next: Page | null = null; label() { return "p" + this.num + (this.note ?? "") } }
const page = new Page()
delete page.note
console.log(page.label(), delete (page as any).label, page.label(), Object.keys(page).join(), new Page().label())
page.note = "late"
console.log(page.label(), Object.keys(page).join())
// Delete and store in a loop over objects of one layout; only some lose the field.
const many: Doc[] = []
for (let i = 0; i < 30; i++) many.push(make(i))
let sum = 0
for (let round = 0; round < 6; round++) for (let i = 0; i < many.length; i++) {
  const d = many[i]
  if ((i + round) % 3 === 0) delete d.pages; else if ((i + round) % 3 === 1) d.pages = (d.pages ?? 100) + round
  if ((i + round) % 5 === 0) delete d.title; else if (d.title === undefined) d.title = "r" + round
  sum += (d.pages ?? -1) + (d.title ? d.title.length : 0) + d.id
}
console.log(sum, many.map(d => Object.keys(d).indexOf("pages")).join(""), many.filter(d => "title" in d).length)
//// detached-method-as-callback.ts
// A method taken off its object and handed to a callback is called without `this`: it throws a TypeError and stores nothing anywhere.
class Counter { count = 0; step = 1; bump(): number { this.count += this.step; return this.count } }
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
const c = new Counter();
const handlers: (() => number)[] = [c.bump];
console.log(handlers.map(h => attempt(h)).join(), c.count);
//// detached-method-ignores-object.ts
// A method taken off its object is called without `this`, directly and from an arrow function: a TypeError each time, and the object it came from is as it was.
class Counter { count = 0; step = 1; bump(): number { this.count += this.step; return this.count } }
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
const c = new Counter()
const bump = c.bump
console.log(attempt(bump), attempt(() => bump()), c.count)
//// dictionary-reaches-store.ts
// A record enters a type with an index signature that takes more than its field holds. Each row: another way for that dictionary to get to a store.
// Every store is legal TypeScript without a cast of the record, so none is refused.
function attempt(f: () => unknown): string { try { return String(f()); } catch (e) { return (e as Error).constructor.name; } }

type A = { v: number; a: number };
type WideA = { [key: string]: number | string | A };
function storeA(into: WideA): void { into.v = "a"; }
function handOnA(into: WideA): void { storeA(into); }
const a: A = { v: 1, a: 1 };
console.log("handed on", attempt(() => { handOnA(a); return JSON.stringify(a); }));

type B = { v: number; b: number };
type WideB = { [key: string]: number | string | B };
function giveBackB(what: WideB): WideB { return what; }
const b: B = { v: 1, b: 1 };
console.log("returned", attempt(() => { giveBackB(b).v = "b"; return JSON.stringify(b); }));

type C = { v: number; c: number };
type WideC = { [key: string]: number | string | C };
class Keeper { kept: WideC; constructor(kept: WideC) { this.kept = kept; } store(): void { this.kept.v = "c"; } }
const c: C = { v: 1, c: 1 };
console.log("kept in a field", attempt(() => { new Keeper(c).store(); return JSON.stringify(c); }));

type D = { v: number; d: number };
type WideD = { [key: string]: number | string | D };
function later(what: WideD): () => void { return () => { what["v"] = "d"; }; }
const d: D = { v: 1, d: 1 };
console.log("kept in a closure", attempt(() => { later(d)(); return JSON.stringify(d); }));

type E = { v: number; e: number };
type WideE = { [key: string]: number | string | boolean };
function toAny(what: WideE): void { const loose: any = what; loose.v = "e"; }
const e: E = { v: 1, e: 1 };
console.log("a variable of any", attempt(() => { toAny(e); return JSON.stringify(e); }));

type F = { v: number; f: number };
type WideF = { [key: string]: number | string | null };
function storesIntoAnything(what: any): void { what.v = "f"; }
function toParameter(what: WideF): void { storesIntoAnything(what); }
const f: F = { v: 1, f: 1 };
console.log("a parameter of any", attempt(() => { toParameter(f); return JSON.stringify(f); }));

type G = { v: number; g: number };
type WideG = { [key: string]: number | string | undefined };
function assigns(what: WideG): void { Object.assign(what, { v: "g" }); }
const g: G = { v: 1, g: 1 };
console.log("Object.assign", attempt(() => { assigns(g); return JSON.stringify(g); }));

type H = { v: number; h: number };
type WideH = { [key: string]: number | string | symbol };
function reflects(what: WideH): void { Reflect.set(what, "v", "h"); }
const h: H = { v: 1, h: 1 };
console.log("Reflect.set", attempt(() => { reflects(h); return JSON.stringify(h); }));

type I = { v: number; i: number };
type WideI = { [key: string]: number | string | bigint };
function defines(what: WideI): void { Object.defineProperty(what, "v", { value: "i", writable: true, enumerable: true, configurable: true }); }
const i: I = { v: 1, i: 1 };
console.log("Object.defineProperty", attempt(() => { defines(i); return JSON.stringify(i); }));

type J = { v: number; j: number };
type WideJ = { [key: string]: number | string | number[] };
type WiderJ = { [key: string]: unknown };
function storeJ(into: WiderJ): void { into.v = "j"; }
function widenJ(into: WideJ): void { storeJ(into); }
const j: J = { v: 1, j: 1 };
console.log("a wider dictionary", attempt(() => { widenJ(j); return JSON.stringify(j); }));

type K = { v: number; k: number };
type WideK = { [key: string]: number | string | string[] };
const held: WideK[] = [];
const k: K = { v: 1, k: 1 };
console.log("kept in an array", attempt(() => { held.push(k); held[0].v = "k"; return JSON.stringify(k); }));

type L = { v: number; l: number };
type WideL = { [key: string]: number | string | boolean[] };
function each<T extends WideL>(what: T): void { const seen: WideL = what; seen.v = "l"; }
const l: L = { v: 1, l: 1 };
console.log("a type parameter", attempt(() => { each(l); return JSON.stringify(l); }));

type M = { v: number; m: number };
type WideM = { [key: string]: number | string | Date };
function compound(what: WideM): void { what.v += "m"; }
const m: M = { v: 1, m: 1 };
console.log("a compound store", attempt(() => { compound(m); return JSON.stringify(m); }));

type N = { v: number; n: number };
type WideN = { [key: string]: number | string | N };
const n: N = { v: 1, n: 1 };
console.log("a variable", attempt(() => { const seen: WideN = n; seen.v = "n"; return JSON.stringify(n); }));

type O = { v: number; o: number };
type WideO = { [key: string]: number | string | O };
const o: O = { v: 1, o: 1 };
console.log("a key that is computed", attempt(() => { const seen: WideO = o; for (const key of ["v"]) seen[key] = "o"; return JSON.stringify(o); }));

type Q = { v: number; q: number };
type WideQ = { [key: string]: number | string | Q };
function pick(first: WideQ, second: WideQ, isFirst: boolean): WideQ { return isFirst ? first : second; }
const q: Q = { v: 1, q: 1 };
console.log("one of two", attempt(() => { pick(q, { w: 2 }, q.q === 1).v = "q"; return JSON.stringify(q); }));
//// edge-case-numbers-in-fields.ts
// Numbers in typed fields in edge cases: NaNs with unusual bit patterns, -0, integer overflow.
interface Req { v: number }
interface Opt { v?: number; w?: number }
function sign(x: number): string { return Object.is(x, -0) ? "-0" : String(x) }
function state(o: Opt): string { return ("v" in o ? "own" : "absent") + ":" + (o.v === undefined ? "undefined" : sign(o.v)) }

// NaNs of many bit patterns, made in memory. Each must stay a NaN: never undefined, never absent, never a pointer or an integer.
const bits = new Uint32Array(2), asDouble = new Float64Array(bits.buffer)
function fromBits(hi: number, lo: number): number { bits[0] = lo; bits[1] = hi; return asDouble[0] }
const patterns: [number, number][] = [[0x7ff80000, 0], [0x7ff80000, 1], [0xfff80000, 0], [0xffffffff, 0xffffffff], [0x7fffffff, 0xffffffff], [0x7ff00000, 1], [0xfff00000, 1],
  [0x7ff40000, 0], [0xfffe0000, 0], [0xfffe0000, 2], [0xfffe0000, 10], [0xffff0000, 7], [0x7ffc0000, 0], [0x7ff8dead, 0xbeef0000], [0xfff80000, 0x0000000a], [0x7ff80000, 0x00000002], [0x7ff80000, 0x00000006]]
const out: string[] = []
const kept: number[] = [0.5]
const optionals: Opt[] = []
for (const [hi, lo] of patterns) {
  const x = fromBits(hi, lo)
  const r: Req = { v: x }
  const o: Opt = { v: x }
  const late: Opt = {}
  late.w = x
  kept.push(x)
  optionals.push(o)
  out.push([String(r.v), state(o), String(late.w), "w" in late, "v" in late, r.v === r.v, (r.v as unknown) === undefined, o.v === undefined, o.v ?? "nullish", typeof o.v, Number.isNaN(r.v), r.v + 1, JSON.stringify(o)].join("/"))
}
console.log([...new Set(out)].join(" ; "), out.length)
console.log(kept.map(String).join(), kept.filter(x => x === undefined).length, kept.length, optionals.filter(o => o.v === undefined).length, optionals.filter(o => "v" in o).length)
console.log(fromBits(0x7ff00000, 0), fromBits(0xfff00000, 0), sign(fromBits(0x80000000, 0)), fromBits(0, 1), fromBits(0x3ff00000, 0), fromBits(0x7fefffff, 0xffffffff))

// undefined, absent and NaN are three states of one optional field.
const tri: Opt = {}
const states: string[] = [state(tri)]
tri.v = NaN; states.push(state(tri))
tri.v = undefined; states.push(state(tri))
tri.v = 0; states.push(state(tri))
delete tri.v; states.push(state(tri))
tri.v = -0; states.push(state(tri))
console.log(states.join())

// -0 survives fields, arrays, arithmetic and copies, also where every other value is a small integer.
const zeros: Req[] = [{ v: 0 }, { v: -0 }, { v: 0 * -1 }, { v: -1 * 0 }, { v: Math.round(-0.4) }, { v: -5 % 5 }, { v: 0 / -3 }, { v: -(0) }, { v: 1 - 1 }, { v: Math.min(0, -0) }]
console.log(zeros.map(z => sign(z.v)).join(), zeros.map(z => 1 / z.v).join(), zeros.map(z => sign({ ...z }.v)).join(), JSON.stringify(zeros[1]), sign(zeros[1].v + 0), sign(zeros[1].v * 1), sign(-zeros[0].v))
const counter: Req = { v: 3 }
for (let i = 0; i < 3; i++) counter.v--
console.log(sign(counter.v), sign(counter.v * -1), sign(counter.v * -1 + 0))

// Overflow of 32 bits and of 53 bits by ++, --, += and *= on fields.
const up: Req = { v: 2147483646 }, down: Req = { v: -2147483647 }, wide: Req = { v: 9007199254740990 }, mul: Req = { v: 65536 }, uns: Req = { v: 4294967294 }
const steps: string[] = []
for (let i = 0; i < 4; i++) { up.v++; down.v--; wide.v += 1; mul.v *= 65536; uns.v++; steps.push([up.v, down.v, wide.v, mul.v, uns.v].join("/")) }
