//// extra-properties-before-prototype-change/shapes.ts
export class Extended {
  declare host?: string;
  declare port?: number;
  declare path?: string;
  declare secure?: boolean;
  always = 1;
  readHost(): string | undefined {
    return this.host;
  }
  readPort(): number | undefined {
    return this.port;
  }
  hasHost(): boolean {
    return "host" in this;
  }
  hasPort(): boolean {
    return "port" in this;
  }
  setHost(host: string): void {
    this.host = host;
  }
  fill(port: number): void {
    this.host = "localhost";
    this.port = port;
    this.path = "/";
    this.secure = false;
  }
}
export class Second {
  declare host?: string;
  declare port?: number;
  always = 2;
  readHost(): string | undefined {
    return this.host;
  }
  readPort(): number | undefined {
    return this.port;
  }
  hasHost(): boolean {
    return "host" in this;
  }
  hasPort(): boolean {
    return "port" in this;
  }
  setHost(host: string): void {
    this.host = host;
  }
  fill(port: number): void {
    this.host = "localhost";
    this.port = port;
  }
}
export type Settings = { id: number; host?: string; port?: number };
////= makeSettings
export function readHostOf(settings: Settings): string | undefined {
  return settings.host;
}
export function hasHostIn(settings: Settings): boolean {
  return "host" in settings;
}
////= lines-4	setHostOf	settings	Settings	host	string	settings.host
//// extra-properties-before-prototype-change/untyped.js
import { Extended, Second, makeSettings, readHostOf, hasHostIn, setHostOf } from "./shapes.ts";

class Heir extends Extended {}
class HeirOfHeir extends Heir {}
class Untouched extends Extended {}

function look(label, o) {
  const before = [o.readHost(), o.readPort(), o.hasHost(), o.hasPort()].join();
  o.fill(7);
  console.log(label, before, "|", [o.readHost(), o.readPort(), o.hasHost(), o.hasPort()].join(), "|", Object.keys(o).join(), "|", JSON.stringify(o));
}

function tagged(make, give) {
  const o = make();
  give(o);
  return o;
}

const givers = {
  none(o) {},
  byName(o) { o.tag = 1; },
  twoByName(o) { o.tag = 1; o.more = 2; },
  byKey(o) { o["key" + 1] = 1; },
};
const makers = {
  Extended: () => new Extended(),
  Heir: () => new Heir(),
  HeirOfHeir: () => new HeirOfHeir(),
  Untouched: () => new Untouched(),
};

function lookAtAll(stage, kept) {
  for (const maker in makers) {
    for (const giver in givers) {
      for (let i = 0; i < 3; i++) look(stage + " fresh " + maker + " " + giver, tagged(makers[maker], givers[giver]));
    }
  }
  for (const [label, o] of kept.splice(0, 16)) look(stage + " kept " + label, o);
}

export function run() {
  const kept = [];
  for (let stage = 0; stage < 4; stage++) {
    for (const maker in makers) {
      for (const giver in givers) kept.push([maker + " " + giver, tagged(makers[maker], givers[giver])]);
    }
  }
  for (let i = 0; i < 50; i++) tagged(makers.Heir, o => { o.dropped = i; }).readHost();
  lookAtAll("as made", kept);

  Heir.prototype.harmless = function () { return 1; };
  lookAtAll("a harmless method", kept);

  Object.defineProperty(Heir.prototype, "host", {
    get() { return "inherited"; },
    set(value) { this.seenHost = value; },
    configurable: true,
  });
  lookAtAll("an accessor named like a field", kept);
  look("a shape that had died", tagged(makers.Heir, o => { o.dropped = 1; }));

  delete Heir.prototype.host;
  Heir.prototype.port = 99;
  lookAtAll("the accessor gone, a value named like a field", kept);

  for (let i = 0; i < 3; i++) {
    const other = Reflect.construct(Second, [], function () {});
    other.tag = i;
    console.log("constructed for another", other.always, Second.prototype.readHost.call(other), Second.prototype.hasHost.call(other));
    Second.prototype.fill.call(other, 1);
    console.log("constructed for another, filled", Object.keys(other).join());
  }

  for (let i = 0; i < 3; i++) {
    const settings = makeSettings(i);
    settings.tag = i;
    console.log("record", readHostOf(settings), hasHostIn(settings));
    Object.setPrototypeOf(settings, { get host() { return "inherited by a record"; }, set host(value) { this.seenHost = value; } });
    console.log("record under another prototype", readHostOf(settings), hasHostIn(settings));
    setHostOf(settings, "stored");
    console.log("record stored to", readHostOf(settings), Object.keys(settings).join());
  }
}
//// extra-properties-by-key-and-name.ts
// Objects of declared types get properties beyond their types under computed keys, by definition, by name, in turns: each road sees what the others did, also at sites that have served other objects before.
const show = (label: string, value: unknown) => console.log(label + ": " + JSON.stringify(value));

////= Request
////= lines-26	Full	first	unknown	second	unknown	2
////= Point
const makers: [string, (key: string, v: number) => any][] = [
  ["Request", (key, v) => { const o: any = new Request(); o[key] = v; return o; }],
  ["Full", (key, v) => { const o: any = new Full(); o[key] = v; return o; }],
  ["Point", (key, v): Point => ({ x: 1, y: 2, [key]: v })],
  ["plain", (key, v) => ({ plain: true, [key]: v })],
];
const readNamed = (o: any) => o.named;
const readFirstKey = (o: any) => o.k0;
const readMissing = (o: any) => o.missing;
const storeNamed = (o: any, v: unknown) => { o.named = v; };
const storeFirstKey = (o: any, v: unknown) => { o.k0 = v; };
const storeOther = (o: any, v: unknown) => { o.other = v; };
const storeByKey = (o: any, key: string, v: unknown) => { o[key] = v; };
const attempt = (store: () => void) => {
  try {
    store();
    return "stored";
  } catch (error) {
    return (error as Error).constructor.name;
  }
};
const describe = (o: any) => [Object.keys(o).join(), JSON.stringify(o), readNamed(o), readFirstKey(o), readMissing(o)];

for (const [label, make] of makers) {
  for (let round = 0; round < 6; round++) {
    const key = "k" + (round % 3);
    const o = make(key, round);
    show(label + " born " + round, describe(o));
    storeNamed(o, round + 10);
    show(label + " named " + round, describe(o));
    storeByKey(o, "late" + (round % 2), round + 20);
    show(label + " by key " + round, describe(o));
    storeOther(o, round + 30);
    storeFirstKey(o, round + 40);
    show(label + " both " + round, describe(o));
    storeNamed(o, "again");
    storeByKey(o, "named", "by key");
    show(label + " replaced " + round, describe(o));
  }
}

for (const [label, make] of makers) {
  for (let round = 0; round < 4; round++) {
    const o = make("k0", round);
    storeNamed(o, 1);
    delete o.k0;
    show(label + " deleted " + round, describe(o));
    storeFirstKey(o, 2);
    show(label + " given again " + round, describe(o));
    Object.defineProperty(o, "named", { value: 3, writable: false, enumerable: true, configurable: true });
    show(label + " read only " + round, [attempt(() => storeNamed(o, 4)), describe(o)]);
    Object.defineProperty(o, "named", { get() { return "got " + this.k0; }, set(v) { this.k0 = "set " + v; }, enumerable: false, configurable: true });
    storeNamed(o, 5);
    show(label + " accessor " + round, describe(o));
    delete o.named;
    storeNamed(o, 6);
    show(label + " data again " + round, describe(o));
  }
}

for (const [label, make] of makers) {
  for (let round = 0; round < 4; round++) {
    const sealed = make("k0", round);
    storeNamed(sealed, 1);
    Object.seal(sealed);
    const onSealed = [attempt(() => storeNamed(sealed, 2)), attempt(() => storeOther(sealed, 3)), attempt(() => storeByKey(sealed, "late0", 4))];
    show(label + " sealed " + round, [onSealed, describe(sealed), Object.isSealed(sealed), Object.isFrozen(sealed)]);
    const frozen = make("k0", round);
    storeNamed(frozen, 1);
    Object.freeze(frozen);
    const onFrozen = [attempt(() => storeNamed(frozen, 2)), attempt(() => storeFirstKey(frozen, 3)), attempt(() => storeByKey(frozen, "k0", 4))];
    show(label + " frozen " + round, [onFrozen, describe(frozen), Object.isSealed(frozen), Object.isFrozen(frozen)]);
    const closed = make("k0", round);
    Object.preventExtensions(closed);
    const onClosed = [attempt(() => storeNamed(closed, 1)), attempt(() => storeFirstKey(closed, 2))];
    show(label + " closed " + round, [onClosed, describe(closed), Object.isExtensible(closed)]);
  }
}

for (const [label, make] of makers) {
  const kept: any[] = [];
  for (let i = 0; i < 300; i++) {
    const o = make("k" + (i % 40), i);
    if (i % 3 === 0) storeNamed(o, i);
    if (i % 5 === 0) storeByKey(o, "w" + i, i);
    if (i % 7 === 0) storeOther(o, i);
    kept.push(o);
  }
  let sum = 0, keys = 0;
  for (const o of kept) {
    sum += (readNamed(o) ?? 0) + (readFirstKey(o) ?? 0) + (o.other ?? 0);
    keys += Object.keys(o).length;
  }
  show(label + " many", [sum, keys, Object.keys(kept[105]).join(), { ...kept[210] }, structuredClone(kept[0])]);
}
//// extra-properties-in-workers/main.ts
// Workers give objects of declared types properties that the types do not declare, each in its own heap, and send such objects to the main thread. start.ts is the program; this file is what each Worker runs.
import { parentPort, workerData } from "node:worker_threads";
import { make, work } from "./work";

const request: any = make(workerData);
request.self = request;
parentPort!.postMessage({ digest: work(20 + workerData), request, copy: structuredClone(request).query });
//// extra-properties-in-workers/start.ts
import { Worker } from "node:worker_threads";
import { make, work } from "./work";

console.log("main: " + work(20));
const answers: string[] = [];
let waiting = 3;
for (let number = 0; number < 3; number++) {
  const worker = new Worker("./main.ts", { workerData: number });
  worker.on("message", (message: any) => {
    const { request } = message;
    answers[number] = [message.digest, Object.keys(request).join(), request.params, request.query.of, request.route[0], request.self === request, JSON.stringify(message.copy), typeof request.describe].join(" | ");
    if (--waiting) return;
    for (const answer of answers) console.log("worker: " + answer);
    const cloned: any = structuredClone(make(7));
    console.log("clone: " + JSON.stringify(cloned) + " " + Object.keys(cloned).join());
    console.log("main again: " + work(10));
  });
}
//// extra-properties-in-workers/work.ts
export class Request {
  url: unknown = "/";
  method: unknown = "GET";
  next: Request | null = null;
  describe(): string {
    return "Request " + this.url;
  }
}
export interface Point {
  x: number;
  y: number;
}
function decorate(object: any, value: unknown) {
  object.params = value;
  object.query = { of: value };
  object.route = [value];
}
export function make(value: number): Request {
  const request = new Request();
  decorate(request, value);
  return request;
}
export function work(rounds: number): string {
  const kept: any[] = [];
  let sum = 0;
  for (let round = 0; round < rounds; round++) {
    for (let i = 0; i < 500; i++) {
      const object: any = i % 2 ? make(i) : ({ x: i, y: round } as Point);
      if (!(i % 2)) decorate(object, i);
      sum += object.params + object.query.of + object.route[0];
      if (i % 125 === 3) kept.push(object);
    }
    if (round % 5 === 4) Bun.gc(round % 10 === 9);
  }
  for (const object of kept) sum += object.query.of + Object.keys(object).length;
  return kept.length + " " + sum;
}
