//// elements-and-many-extra-names/untyped.js
import { Options, Packed, makeSettings } from "./shapes.ts";

const names = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l"];
function byName(o, i) {
  o.a = i; o.b = i; o.c = i; o.d = i; o.e = i; o.f = i;
  o.g = i;
  o.h = i; o.i = i; o.j = i;
  o.k = i;
  o.l = i;
}
function underKeys(o, i) {
  for (let n = 0; n < names.length; n++) o[names[n]] = i;
}
function byDefinition(o, i) {
  for (let n = 0; n < names.length; n++) Object.defineProperty(o, names[n], { value: i, writable: true, enumerable: true, configurable: true });
}
const makers = {
  Options: () => new Options(),
  Packed: () => new Packed(),
  record: () => makeSettings(1),
  plain: () => ({}),
};
const elements = {
  "none": () => {},
  "one before": (o, i) => { o[7] = i; },
  "the first before": (o, i) => { o[0] = i; },
  "several before": (o, i) => { for (let n = 0; n < 5; n++) o[n] = i; },
  "a far one before": (o, i) => { o[100000] = i; },
  "a double before": (o, i) => { o[3] = i + 0.5; },
  "an object before": (o, i) => { o[3] = { i }; },
};
const look = o => JSON.stringify(o) + " " + Object.keys(o).join();

export function run() {
  for (const maker in makers) {
    for (const element in elements) {
      for (const [how, give] of [["by name", byName], ["under keys", underKeys], ["by definition", byDefinition]]) {
        const kept = [];
        for (let round = 0; round < 24; round++) {
          const o = makers[maker]();
          elements[element](o, round);
          give(o, round);
          kept.push(o);
        }
        const wrong = [];
        for (let round = 0; round < 24; round++) {
          const expected = makers.plain();
          if (maker === "Options") expected.always = 1;
          if (maker === "record") expected.id = 1;
          elements[element](expected, round);
          for (const name of names) expected[name] = round;
          if (look(kept[round]) !== look(expected)) wrong.push(round + ": " + look(kept[round]));
        }
        console.log(maker, element, how, wrong.length, wrong.slice(0, 2).join(" ; "), look(kept[23]));
      }
    }
  }
  for (const maker in makers) {
    const kept = [];
    for (let round = 0; round < 24; round++) {
      const o = makers[maker]();
      o.a = round; o.b = round; o.c = round;
      o[2] = round;
      o.d = round; o.e = round; o.f = round; o.g = round;
      o[9] = round;
      o.h = round; o.i = round; o.j = round; o.k = round; o.l = round;
      kept.push(o);
    }
    console.log(maker, "elements in between", new Set(kept.map((o, round) => look(o).replaceAll(String(round), "n"))).size, look(kept[11]));
  }
}
//// elements-and-names-on-any-object.ts
// Every kind of object of ours gets elements of every kind of storage, then names, in turns; everything is read back.
type Rec = { a: number; b: string };
class Inst { p = 1; q = "q"; m() { return this.p; } }
class Wide { f0 = 0; f1 = 1; f2 = 2; f3 = 3; f4 = 4; f5 = 5; f6 = 6; f7 = 7; f8 = 8; f9 = 9; }
function plainFunction() { return 1; }
const kinds: Array<[string, () => any]> = [
  ["record", () => { const r: Rec = { a: 1, b: "b" }; return r; }],
  ["instance", () => new Inst()],
  ["wide instance", () => new Wide()],
  ["function", () => function () { return 2; }],
  ["arrow", () => () => 3],
  ["bound", () => plainFunction.bind(null)],
  ["class", () => class Local { static s = 1; }],
  ["prototype of a class", () => (class Local2 { m() { return 1; } }).prototype],
  ["prototype of a function", () => (function F() {}).prototype],
  ["untyped literal", () => JSON.parse('{"a":1,"b":"b"}')],
  ["method", () => ({ m() { return 4; } }).m],
  ["async function", () => async function () {}],
  ["generator function", () => function* () {}],
];
const elements: Array<[string, (o: any) => void]> = [
  ["none", () => {}],
  ["int32", o => { o[7] = 7; }],
  ["double", o => { o[0] = 0.5; o[1] = 1.5; }],
  ["values", o => { o[0] = "s"; o[2] = {}; }],
  ["sparse", o => { o[100000] = "far"; o[3] = 3; }],
  ["largest index", o => { o[4294967294] = "last"; o[4294967295] = "a name"; }],
  ["deleted", o => { o[5] = 5; delete o[5]; }],
  ["defined", o => { try { Object.defineProperty(o, "4", { value: "d", writable: true, enumerable: true, configurable: true }); } catch (e) { o[4] = "d"; } }],
];
function check(o: any, count: number): string {
  let sum = 0;
  for (let i = 0; i < count; i++) sum += o["n" + i] === i * 3 ? 1 : 0;
  const indices = Object.keys(o).filter(key => /^\d+$/.test(key)).map(key => key + "=" + String(o[key] && typeof o[key] === "object" ? "o" : o[key])).join();
  return sum + "/" + count + " " + indices;
}
let lines = 0, digest = 0;
const kept: any[] = [];
for (const [kind, make] of kinds) {
  for (const [how, store] of elements) {
    for (const order of [0, 1, 2]) {
      const o = make();
      if (order === 0) store(o);
      let said = "";
      try {
        for (let i = 0; i < 40; i++) {
          if (order === 1 && i === 6) store(o);
          if (order === 2 && i === 33) store(o);
          if (i % 3 === 0) o["n" + i] = i * 3;
          else if (i % 3 === 1) Object.defineProperty(o, "n" + i, { value: i * 3, writable: true, enumerable: true, configurable: true });
          else Object.assign(o, { ["n" + i]: i * 3 });
        }
        said = check(o, 40);
      } catch (e) { said = (e as Error).constructor.name; }
      kept.push(o);
      const copy = (() => { try { return check({ ...o }, 40); } catch (e) { return (e as Error).constructor.name; } })();
      const line = kind + " | " + how + " | " + order + ": " + said + " ; " + copy;
      for (let i = 0; i < line.length; i++) digest = (digest * 31 + line.charCodeAt(i)) | 0;
      lines++;
      if (said !== "40/40 " + said.slice(6) || order === 0) console.log(line);
    }
  }
}
let again = 0;
for (const o of kept) again += check(o, 40).startsWith("40/40") ? 1 : 0;
console.log(lines, digest, again);
//// empty-cell-slot-in-padding.ts
// Only one of two classes has the fields `big` and `inner`, which hold only cells, and hot loops read them through an interface that both classes implement. `Bare` can keep the bytes of those slots empty in its padding, so the read and the `in` test must recognize an empty slot whose representation has no marker for absent. `Taken` has another field in those bytes, which must never be read as `big`.
interface Shape { y: number; big?: bigint; inner?: { n: number } }
class Full implements Shape { y = 1; big = 5n; inner = { n: 7 }; }
class Bare implements Shape { y = 2; }
interface Packed { y: number; big?: bigint }
class PackedFull implements Packed { y = 1; big = 6n; }
class Taken implements Packed { y = 2; other = "s"; }
function sumBig(list: Shape[]): bigint { let sum = 0n; for (const item of list) if (item.big !== undefined) sum += item.big; return sum; }
function sumInner(list: Shape[]): number { let sum = 0; for (const item of list) sum += item.inner ? item.inner.n : -1; return sum; }
function countOwn(list: Shape[]): number { let count = 0; for (const item of list) { if ("big" in item) count++; if ("inner" in item) count++; } return count; }
function sumPackedBig(list: Packed[]): bigint { let sum = 0n; for (const item of list) if (item.big !== undefined) sum += item.big; return sum; }
const shapes: Shape[] = [], packed: Packed[] = [];
for (let i = 0; i < 3000; i++) { shapes.push(i % 3 ? new Full() : new Bare()); packed.push(i % 3 ? new PackedFull() : new Taken()); }
console.log(String(sumBig(shapes)), sumInner(shapes), countOwn(shapes), String(sumPackedBig(packed)));
console.log(String(shapes[0].big), String(shapes[1].big), shapes[0].inner?.n, shapes[1].inner?.n, String(packed[0].big), String(packed[1].big));
