//// extra-properties-added-by-key/shapes.ts
export class Options {
  declare host?: string;
  declare port?: number;
  always = 1;
  set watched(value: unknown) {
    (this as any).caughtByTheClass = value;
  }
  get watched(): unknown {
    return "of the class";
  }
  fill(port: number): void {
    this.host = "localhost";
    this.port = port;
  }
}
