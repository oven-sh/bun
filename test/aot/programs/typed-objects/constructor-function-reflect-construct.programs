  const object = make();
  const before = Object.keys(object);
  object.one = 1;
  object.two = 2;
  delete object.one;
  delete object.two;
  const between = Object.keys(object);
  object.three = 3;
  show(label, [before.length === between.length, Object.keys(object).slice(before.length), String(object.one), object.three]);
}

