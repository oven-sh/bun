//// constructor-function-reflect-construct-with-another-new-target.ts
// This must fail to build: `Swapped.prototype` is read in front of the store to it, which TypeScript 7 reports (TS2565). The same program with that one read
// through `any`, which builds and runs: reflect-construct-of-a-constructor-function-with-another-new-target.ts.
// Reflect.construct() of a constructor function with another new.target: the object inherits from what new.target has as its `prototype` and has what the function stores. Only where the function is its own new.target is the object one of its own.
const attempt = (label: string, run: () => unknown) => { try { console.log(label, String(run())) } catch (error) { console.log(label, "throws", (error as Error).constructor.name) } }

interface Pair { first: number; second: string }
function Pair(this: Pair, first: number, second: string) { this.first = first; this.second = second }
Pair.prototype.describe = function (this: Pair) { return "pair " + this.first + this.second }
const PairClass = Pair as unknown as new (first: number, second: string) => Pair
const read = (pair: Pair) => pair.second + pair.first
const tell = (made: any, target: any): string =>
  [Object.keys(made).join(), read(made), Object.getPrototypeOf(made) === target.prototype, made instanceof PairClass, typeof made.describe === "function" ? made.describe() : "nothing to call"].join(" ")

function Other(this: any) { this.never = "the body of new.target does not run" }
Other.prototype.describe = function (this: Pair) { return "other " + this.second }
class Modern { extra = 1; describe() { return "modern " + Object.keys(this).length } }
class Heir extends (Pair as any) { own = true }

console.log("new:", tell(new PairClass(1, "a"), Pair))
console.log("no new.target given:", tell(Reflect.construct(Pair, [2, "b"]), Pair))
console.log("itself:", tell(Reflect.construct(Pair, [3, "c"], Pair), Pair))
console.log("another function:", tell(Reflect.construct(Pair, [4, "d"], Other), Other))
console.log("a class:", tell(Reflect.construct(Pair, [5, "e"], Modern), Modern))
console.log("a class that extends it:", tell(Reflect.construct(Pair, [6, "f"], Heir), Heir))
console.log("Object:", tell(Reflect.construct(Pair, [7, "g"], Object), Object))
for (const builtin of [Array, Map, Date, Error, Promise, Function, Uint8Array]) {
  const made = Reflect.construct(Pair, [8, builtin.name], builtin)
  console.log(tell(made, builtin), made instanceof builtin, Array.isArray(made), Object.prototype.toString.call(made))
}
attempt("what needs a real map:", () => Reflect.construct(Pair, [9, "h"], Map).size)

const boundTarget = Other.bind(null), boundPair = (Pair as any).bind(null, 10)
console.log("a bound function, which has no prototype property:", tell(Reflect.construct(Pair, [11, "i"], boundTarget), Object))
console.log("the function when bound:", tell(Reflect.construct(boundPair, ["j"]), Pair), tell(Reflect.construct(boundPair, ["k"], boundPair), Pair), tell(Reflect.construct(boundPair, ["l"], Other), Other), tell(new (boundPair as any)("m"), Pair))

const asked: string[] = []
const watched = new Proxy(Other, { get(target, key, receiver) { asked.push("get " + String(key)); return Reflect.get(target, key, receiver) }, construct() { asked.push("construct"); return {} }, apply() { asked.push("apply") } })
console.log("a proxy:", tell(Reflect.construct(Pair, [(asked.push("first argument"), 12), (asked.push("second argument"), "n")], watched), Other), asked.join())
const watchedPair: any = new Proxy(Pair, { get(target, key, receiver) { asked.push("get " + String(key)); return Reflect.get(target, key, receiver) } })
asked.length = 0
console.log("a proxy of itself:", tell(new watchedPair(13, "o"), Pair), tell(Reflect.construct(Pair, [14, "p"], watchedPair), Pair), tell(Reflect.construct(watchedPair, [15, "q"], Pair), Pair), asked.join())
attempt("a prototype that throws when it is read:", () => Reflect.construct(Pair, [16, "r"], new Proxy(Other, { get() { throw new RangeError("read") } })))

for (const notAnObject of [5, "text", null, undefined, false, Symbol.for("s"), 1n]) {
  function Loose(this: any) {}
  Loose.prototype = notAnObject
  console.log("a prototype that is", typeof notAnObject + ":", tell(Reflect.construct(Pair, [17, "s"], Loose), Object))
}
function Swapped(this: any) {}
const before = Reflect.construct(Pair, [18, "t"], Swapped), earlier = Swapped.prototype
Swapped.prototype = { describe() { return "swapped" } }
const after = Reflect.construct(Pair, [19, "u"], Swapped)
console.log("a prototype that is replaced:", tell(before, { prototype: earlier }), tell(after, Swapped), before instanceof (Swapped as any), after instanceof (Swapped as any))

attempt("an arrow function:", () => Reflect.construct(Pair, [1, "a"], (() => 0) as any))
attempt("a method:", () => Reflect.construct(Pair, [1, "a"], ({ m() {} }).m as any))
attempt("an async function:", () => Reflect.construct(Pair, [1, "a"], (async function () {}) as any))
attempt("no function:", () => Reflect.construct(Pair, [1, "a"], {} as any))
attempt("undefined, written out:", () => Reflect.construct(Pair, [1, "a"], undefined as any))
attempt("no list:", () => (Reflect.construct as any)(Pair))
console.log("a list that is no array:", tell(Reflect.construct(Pair, { length: 2, 0: 20, 1: "v", 2: "ignored" } as any, Other), Other))
console.log("too few:", Object.keys(Reflect.construct(Pair, [], Other)).join(), JSON.stringify(Reflect.construct(Pair, [21], Modern)))

function Trapped(this: any) {}
const stores: string[] = []
Object.defineProperty(Trapped.prototype, "first", { set(value: number) { stores.push("first is set to " + value) }, get() { return "from the getter" } })
Object.defineProperty(Trapped.prototype, "second", { value: "read-only", writable: false })
attempt("new.target's prototype has a setter and a property that is read-only:", () => Reflect.construct(Pair, [22, "w"], Trapped))
console.log(stores.join())

interface Answer { value: number }
function Answer(this: Answer, value: number) { this.value = value; if (value > 100) return [value]; return undefined }
console.log("what the function returns:", JSON.stringify(Reflect.construct(Answer, [101], Other)), Array.isArray(Reflect.construct(Answer, [102], Answer)), JSON.stringify(Reflect.construct(Answer, [1], Other)), Reflect.construct(Answer, [2], Other) instanceof (Other as any))

const targets: Function[] = [Pair, Other, Modern, Pair, Heir, Pair]
let total = 0, ownObjects = 0
for (let round = 0; round < 12000; round++) {
  const made: Pair = Reflect.construct(Pair, [round, "z"], targets[round % targets.length])
  total += made.first + made.second.length + Object.keys(made).length
  if (Object.getPrototypeOf(made) === Pair.prototype) ownObjects++
}
console.log(total, ownObjects, tell(new PairClass(23, "x"), Pair))
//// constructor-function-subclass.ts
// Classes that extend a constructor function: `super(..)` hands the function an object of the class, new.target is the class, the stores of the function go by what the class defines, and the fields of the class follow them.
const show = (o: object): string => Object.keys(o).join() + " " + JSON.stringify(o)
const attempt = (label: string, run: () => unknown) => { try { console.log(label, String(run())) } catch (error) { console.log(label, "throws", (error as Error).constructor.name) } }

interface Base { id: number; name: string }
interface Labeled extends Base { label(): string }
interface BaseConstructor { new (id: number, name: string): Labeled; prototype: any }
function Base(this: Base, id: number, name: string) { this.id = id; this.name = name }
Base.prototype.label = function (this: Base) { return this.name + "#" + this.id }
const BaseClass = Base as unknown as BaseConstructor
const idOf = (base: Base) => base.id * 2 + base.name.length

class Derived extends BaseClass { extra = "e"; constructor(id: number) { super(id, "derived") } label() { return "<" + super.label() + this.extra + ">" } }
class Implicit extends BaseClass { tail = 1 }
class Deeper extends Derived { depth: number; constructor() { super(3); this.depth = 2 } }
class Empty extends BaseClass {}

const plain = new BaseClass(1, "plain"), derived = new Derived(2), implicit = new Implicit(4, "implicit"), deeper = new Deeper(), empty = new Empty(5, "empty")
for (const each of [plain, derived, implicit, deeper, empty])
  console.log(show(each), each.label(), idOf(each), each instanceof BaseClass, each instanceof Derived, each.constructor.name, Object.getPrototypeOf(Object.getPrototypeOf(each)) === Base.prototype)
console.log(Object.getPrototypeOf(Derived) === Base, Object.getPrototypeOf(Derived.prototype) === Base.prototype, Derived.length, Implicit.length, Derived.name)

interface Seen { target: string; isOwn: boolean }
function Seen(this: Seen) { this.target = new.target === undefined ? "none" : (new.target as any).name; this.isOwn = (new.target as any) === Seen }
class SeesItself extends (Seen as any) {}
class SeesDeeper extends SeesItself { constructor() { super() } }
console.log(show(new (Seen as any)()), show(new SeesItself()), show(new SeesDeeper()), show(Reflect.construct(SeesItself, [], Seen)), show(Reflect.construct(Seen, [], SeesDeeper)))

const stores: string[] = []
class Guarded extends (Base as any) {
  set name(value: string) { stores.push("name is set to " + value) }
  get name() { return "guarded" }
  get id() { return stores.length }
  set id(value: number) { stores.push("id is set to " + value) }
}
const guarded = new (Guarded as any)(6, "hidden")
console.log(show(guarded), guarded.label(), stores.join(), idOf(guarded))
class ReadOnly extends (Base as any) { get name() { return "no setter" } }
attempt("a getter alone:", () => new (ReadOnly as any)(7, "x"))
class Redeclares extends (Base as any) { id = "mine"; name = "also mine" }
console.log(show(new (Redeclares as any)(8, "theirs")), idOf(new BaseClass(8, "theirs")))
class FieldsReadBase extends (Base as any) { copy = this.id + ":" + this.name; count = Object.keys(this).length }
console.log(show(new (FieldsReadBase as any)(9, "read")))

function Swaps(this: any, value: number) { this.lost = value; return { swapped: value } }
function ReturnsNumber(this: any, value: number) { this.kept = value; return value }
function ReturnsFunction(this: any) { this.lost = true; return function made() {} }
class OverSwaps extends (Swaps as any) { own = 1; method() { return "unreachable" } }
class OverNumber extends (ReturnsNumber as any) { own = 2 }
class OverFunction extends (ReturnsFunction as any) { own = 3 }
const swapped = new (OverSwaps as any)(10), numbered = new (OverNumber as any)(11), made: any = new OverFunction()
console.log(show(swapped), swapped instanceof OverSwaps, "method" in swapped, show(numbered), numbered instanceof OverNumber, typeof made, Object.keys(made).join(), made.name, made instanceof OverFunction)

class BeforeSuper extends BaseClass {
  constructor(early: boolean) {
    if (early) attempt("this before super:", () => this)
    super(12, "late")
    try { super(13, "again"); console.log("super twice") } catch (error) { console.log("super twice throws", (error as Error).constructor.name) }
  }
}
console.log(show(new BeforeSuper(true)))
class NoSuper extends BaseClass { constructor() { if (stores.length < 0) super(0, "") } }
attempt("no super call:", () => new NoSuper())
class ThrowsInArgument extends BaseClass { after = "never"; constructor() { super(14, (() => { throw new RangeError("argument") })()) } }
attempt("an argument of super throws:", () => new ThrowsInArgument())
attempt("a class is called:", () => (Derived as any)(1))
attempt("the function is called with an instance of the class:", () => { const target = new Derived(15); return String(Base.call(target, 16, "again")) + " " + show(target) + " " + target.label() })

function Replacement(this: any, id: number) { this.replaced = id }
Replacement.prototype.label = function () { return "replacement" }
class Moves extends BaseClass { constructor() { super(17, "moves") } }
const unmoved = new Moves()
Object.setPrototypeOf(Moves, Replacement)
const moved = new Moves()
console.log(show(unmoved), show(moved), moved.label(), moved instanceof BaseClass, moved instanceof (Replacement as any))
Object.setPrototypeOf(Moves, null)
attempt("nothing above the class:", () => new Moves())
Object.setPrototypeOf(Moves, Base)
console.log(show(new Moves()))

;(Base as any).create = function (this: any, id: number) { return new this(id, "created") }
console.log(show((Base as any).create(18)), show((Implicit as any).create(19)), show((Derived as any).create(20)), Object.hasOwn(Derived, "create"))

const firstPrototype = (Base as Function).prototype
Base.prototype = { label() { return "a later prototype" } }
const afterwards = new Derived(21), direct = new BaseClass(22, "direct")
console.log(afterwards.label(), afterwards instanceof BaseClass, afterwards instanceof Derived, direct.label(), direct instanceof BaseClass, derived instanceof BaseClass)
class DefinedLater extends BaseClass {}
console.log(new DefinedLater(23, "later").label(), Object.getPrototypeOf(DefinedLater.prototype) === Base.prototype)
Base.prototype = null
attempt("extends a function whose prototype is null:", () => { class OverNull extends BaseClass {} return Object.getPrototypeOf(OverNull.prototype) + " " + show(new OverNull(24, "null")) })
Base.prototype = 5
attempt("extends a function whose prototype is a number:", () => { class OverNumberPrototype extends BaseClass {} return new OverNumberPrototype(25, "five") })
Base.prototype = firstPrototype

let total = 0
for (let round = 0; round < 15000; round++) {
  const each: Labeled = round % 3 === 0 ? new BaseClass(round, "b") : round % 3 === 1 ? new Derived(round) : new Implicit(round, "imp")
  total += idOf(each) + Object.keys(each).length + each.label().length
}
console.log(total)
//// constructor-function-throwing-argument.ts
// `new F(a(), b())` where an argument throws: the function is read first, the arguments run from left to right, and nothing of the construction happens, neither the read of `prototype` nor the body. What an argument changes on its way is seen by the construction that follows.
const log: string[] = []
const note = <T>(label: string, value: T): T => { log.push(label); return value }
const fail = (label: string): never => { log.push(label + " throws"); throw new RangeError(label) }
const flush = (label: string, result?: unknown) => { console.log(label + ":", log.join(", "), "|", String(result)); log.length = 0 }
const attempt = (label: string, run: () => unknown) => { try { flush(label, run()) } catch (error) { flush(label, "threw " + (error as Error).constructor.name + (error instanceof RangeError ? " " + error.message : "")) } }
const show = (o: object): string => Object.keys(o).join() + " " + JSON.stringify(o)

interface Triple { a: number; b: number; c: number }
function Triple(this: Triple, a: number, b: number, c: number) { log.push("body"); this.a = a; this.b = b; this.c = c }
Triple.prototype.sum = function (this: Triple) { return this.a + this.b + this.c }
const TripleClass = Triple as unknown as new (a: number, b: number, c: number) => Triple
const sumOf = (triple: Triple) => triple.a + triple.b + triple.c

attempt("nothing throws", () => show(new TripleClass(note("a", 1), note("b", 2), note("c", 3))))
attempt("the first", () => new TripleClass(fail("a"), note("b", 2), note("c", 3)))
attempt("the second", () => new TripleClass(note("a", 1), fail("b"), note("c", 3)))
attempt("the last", () => new TripleClass(note("a", 1), note("b", 2), fail("c")))
attempt("one more than the function takes", () => new (TripleClass as any)(note("a", 1), note("b", 2), note("c", 3), fail("d")))
attempt("in a spread", () => new (TripleClass as any)(note("a", 1), ...[note("b", 2), fail("c")]))
attempt("an iterator that throws", () => new (TripleClass as any)(note("a", 1), ...(function* () { yield note("b", 2); fail("the iterator") })()))
attempt("a getter", () => new TripleClass(note("a", 1), ({ get b(): number { return fail("the getter") } }).b, note("c", 3)))
attempt("a conversion", () => new TripleClass(note("a", 1), +({ valueOf() { return fail("valueOf") } } as any), note("c", 3)))
attempt("a construction inside", () => new TripleClass(note("a", 1), sumOf(new TripleClass(note("inner a", 4), fail("inner b"), 6)), note("c", 3)))
attempt("a construction inside that succeeds", () => show(new TripleClass(note("a", 1), sumOf(new TripleClass(note("inner a", 4), note("inner b", 5), 6)), note("c", 3))))

// The function is read before its arguments run.
const holder: { make: any } = { make: TripleClass }
function Single(this: any, only: number) { log.push("the other body"); this.only = only }
attempt("the callee is replaced by an argument", () => show(new holder.make(note("a", 1), (holder.make = Single, note("b", 2)), 3)))
attempt("and the next construction", () => show(new holder.make(note("a", 1))))
holder.make = undefined
attempt("no constructor, and an argument that throws", () => new holder.make(fail("a")))
attempt("no constructor", () => new holder.make(note("a", 1)))
holder.make = () => 0
attempt("an arrow function", () => new holder.make(note("a", 1), note("b", 2)))
attempt("a variable in its dead zone", () => new notYet(note("a", 1)))
const notYet: any = TripleClass

// `prototype` is read after the arguments, once, and not at all if one throws.
const born = (Triple as Function).prototype, replacement = { sum() { return "replaced" } }
attempt("an argument replaces the prototype", () => { const made: any = new TripleClass(note("a", 1), (Triple.prototype = replacement, note("b", 2)), 3); return made.sum() + " " + (Object.getPrototypeOf(made) === replacement) })
Triple.prototype = born
attempt("an argument replaces the prototype and the next one throws", () => new TripleClass(note("a", 1), (Triple.prototype = replacement, note("b", 2)), fail("c")))
console.log(Triple.prototype === replacement, (new TripleClass(1, 2, 3) as any).sum())
Triple.prototype = born
log.length = 0
const watched: any = new Proxy(Triple, { get(target, key, receiver) { log.push("get " + String(key)); return Reflect.get(target, key, receiver) } })
attempt("a watched function", () => show(new watched(note("a", 1), note("b", 2), note("c", 3))))
attempt("a watched function, and an argument throws", () => new watched(note("a", 1), fail("b"), note("c", 3)))
attempt("a watched new.target", () => show(Reflect.construct(Triple, [note("a", 1), note("b", 2), note("c", 3)], watched)))
attempt("a watched new.target, and an argument throws", () => Reflect.construct(Triple, [note("a", 1), fail("b")], watched))
attempt("the read of prototype throws", () => Reflect.construct(Triple, [note("a", 1)], new Proxy(Triple, { get(target, key) { return fail("get " + String(key)) } })))

// A default value runs in the function: the object is there, and `prototype` has been read.
interface Defaults { a: number; b: number }
function Defaults(this: Defaults, a: number = note("default a", 10), b: number = fail("default b")) { log.push("body"); this.a = a; this.b = b }
const DefaultsClass = Defaults as unknown as new (a?: number, b?: number) => Defaults
const watchedDefaults: any = new Proxy(Defaults, { get(target, key, receiver) { log.push("get " + String(key)); return Reflect.get(target, key, receiver) } })
attempt("both given", () => show(new DefaultsClass(note("a", 1), note("b", 2))))
attempt("the second default throws", () => new DefaultsClass())
attempt("undefined takes the default", () => new DefaultsClass(note("a", 1), note("b", undefined)))
attempt("watched", () => new watchedDefaults())
interface Unpacks { x: number }
function Unpacks(this: Unpacks, { x }: { x: number }) { log.push("body"); this.x = x }
attempt("a pattern that has nothing to unpack", () => new (Unpacks as any)(note("a", undefined)))
attempt("a pattern whose getter throws", () => new (Unpacks as any)({ get x() { return fail("get x") } }))

// The body throws halfway: what it has stored so far is there for whoever holds the object.
const kept: any[] = []
interface Half { first: number; second: number; third: number }
function Half(this: Half, stop: number) { kept.push(this); this.first = 1; if (stop === 1) fail("after the first"); this.second = 2; if (stop === 2) fail("after the second"); this.third = 3 }
const HalfClass = Half as unknown as new (stop: number) => Half
for (const stop of [1, 2, 3]) attempt("stops at " + stop, () => show(new HalfClass(stop)))
console.log(kept.map(show).join(" | "), kept.every(each => each instanceof HalfClass))

let total = 0, thrown = 0
const sometimes = (round: number): number => { if (round % 7 === 3) throw new RangeError("round " + round); return round & 3 }
for (let round = 0; round < 21000; round++) {
  try { total += sumOf(new TripleClass(round & 1, sometimes(round), sometimes(round + 1))) } catch { thrown++ }
  log.length = 0
}
console.log(total, thrown, notYet === TripleClass)
//// copies-of-every-size.ts
// { ...o } of a typed object copies every field at once, whatever the size: 1 to 24 number, string and object fields. Collections between the copies make the allocator refill its free list and fall back to the runtime. A copy is a new, unfrozen object that shares only what its fields refer to.
import { edenGC } from "bun:jsc";

interface Leaf { id: number }
interface F1 { n0: number }
interface F2 extends F1 { s1: string }
interface F3 extends F2 { r2: Leaf }
interface F4 extends F3 { n3: number }
interface F5 extends F4 { s4: string }
interface F6 extends F5 { r5: Leaf }
interface F7 extends F6 { n6: number }
interface F8 extends F7 { s7: string }
interface F9 extends F8 { r8: Leaf }
interface F10 extends F9 { n9: number }
interface F11 extends F10 { s10: string }
interface F12 extends F11 { r11: Leaf }
interface F13 extends F12 { n12: number }
interface F14 extends F13 { s13: string }
interface F15 extends F14 { r14: Leaf }
interface F16 extends F15 { n15: number }
interface F17 extends F16 { s16: string }
interface F18 extends F17 { r17: Leaf }
interface F19 extends F18 { n18: number }
interface F20 extends F19 { s19: string }
interface F21 extends F20 { r20: Leaf }
interface F22 extends F21 { n21: number }
interface F23 extends F22 { s22: string }
interface F24 extends F23 { r23: Leaf }

const n = (i: number, field: number): number => i * 32 + field + (field % 2 ? 0.5 : 0);
const s = (i: number, field: number): string => "s" + field + "-" + i;
const r = (i: number, field: number): Leaf => ({ id: i * 32 + field });

function countDifferences(expected: object, actual: object): number {
  const keys = Object.keys(expected);
  let differences = Object.keys(actual).join() === keys.join() ? 0 : 1;
  for (const key of keys) if (!Object.is((expected as any)[key], (actual as any)[key])) differences++;
  return differences;
}

// Every second copy and every source die, so the free list has gaps between the copies that stay.
function check<T extends object>(fields: number, create: (i: number) => T, copy: (o: T) => T): void {
  const retained: T[] = [];
  let differences = 0;
  for (let i = 0; i < 3000; i++) {
    const source = create(i);
    const result = copy(source);
    if (result === source) differences++;
    differences += countDifferences(source, result);
    if (i % 2 === 0) retained.push(result);
    if (i % 250 === 249) edenGC();
  }
  let changed = 0;
  retained.forEach((result, index) => { if (JSON.stringify(result) !== JSON.stringify(create(index * 2))) changed++; });
  console.log(fields, "fields:", differences, "differences,", changed, "changed later,", Object.keys(retained[0]).length, "keys");
}

check(1, (i): F1 => ({ n0: n(i, 0) }), (o: F1): F1 => ({ ...o }));
check(2, (i): F2 => ({ n0: n(i, 0), s1: s(i, 1) }), (o: F2): F2 => ({ ...o }));
check(3, (i): F3 => ({ n0: n(i, 0), s1: s(i, 1), r2: r(i, 2) }), (o: F3): F3 => ({ ...o }));
check(4, (i): F4 => ({ n0: n(i, 0), s1: s(i, 1), r2: r(i, 2), n3: n(i, 3) }), (o: F4): F4 => ({ ...o }));
check(5, (i): F5 => ({ n0: n(i, 0), s1: s(i, 1), r2: r(i, 2), n3: n(i, 3), s4: s(i, 4) }), (o: F5): F5 => ({ ...o }));
check(6, (i): F6 => ({ n0: n(i, 0), s1: s(i, 1), r2: r(i, 2), n3: n(i, 3), s4: s(i, 4), r5: r(i, 5) }), (o: F6): F6 => ({ ...o }));
