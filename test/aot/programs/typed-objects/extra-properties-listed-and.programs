export class Message {
  declare note?: string;
  declare code?: number;
  url = "/";
  status = 200;
  #hidden = 1;
  setNote(note: string): void {
    this.note = note;
  }
  setCode(code: number): void {
    this.code = code;
  }
  hidden(): number {
    return this.#hidden;
  }
}
export type Props = { id: number; label: string; note?: string; code?: number };
export function makeProps(id: number): Props {
  return { id, label: "x" };
}
////= lines-4	setNote	props	Props	note	string	props.note
