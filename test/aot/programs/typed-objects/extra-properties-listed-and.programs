export type Narrow = { id: number };
export type Wider = { id: number; later?: number; other?: string };
export function makeNarrow(id: number): Narrow {
  return { id };
}
export function asWider(narrow: Narrow): Wider {
  return narrow as Wider;
}
export function laterOf(wider: Wider): number | undefined {
  return wider.later;
}
//// extra-property-positions-among-keys/untyped.js
import { Options, Packed, makeSettings, makeSettingsWithKeys, setHostOf, setPortOf, setPathOf, setSecureOf, makeNarrow, asWider, laterOf } from "./shapes.ts";

let seed = 12345;
function random(below) {
  seed = (Math.imul(seed, 1103515245) + 12345) & 0x7fffffff;
  return (seed >>> 8) % below;
}

function listings(o) {
  const inLoop = [];
  for (const key in o) inLoop.push(key);
  return [Object.keys(o).join(), inLoop.join(), JSON.stringify(o), Object.keys({ ...o }).join(), Object.entries(o).join(";"), Reflect.ownKeys(o).map(String).join(), Object.getOwnPropertyNames(o).join()].join(" | ");
}

function hashOf(text, hash) {
  for (let i = 0; i < text.length; i++) hash = Math.imul(hash ^ text.charCodeAt(i), 16777619);
  return hash;
}

const names = ["a", "b", "c", "d", "e", "f", "g", "h2", "i", "j", "k", "l"];
const symbols = [Symbol("s0"), Symbol("s1"), Symbol("s2")];
const fields = ["host", "port", "path", "secure"];
const valuesOfFields = { host: "h", port: 1, path: "p", secure: true };

const typedSetters = {
  class: { host: o => o.setHost("h"), port: o => o.setPort(1), path: o => o.setPath("p"), secure: o => o.setSecure(true) },
  record: { host: o => setHostOf(o, "h"), port: o => setPortOf(o, 1), path: o => setPathOf(o, "p"), secure: o => setSecureOf(o, true) },
};

function step(o, kind, said) {
  const what = random(16);
  const name = names[random(names.length)];
  const field = fields[random(fields.length)];
  switch (what) {
    case 0: case 1: case 2: o[name] = said.length; return "add " + name;
    case 3: switch (name) { case "a": o.a = 1; break; case "b": o.b = 1; break; case "c": o.c = 1; break; default: o.d = 1; } return "add by name";
    case 4: case 5: case 6: typedSetters[kind][field](o); return "typed " + field;
    case 7: o[field] = valuesOfFields[field]; return "untyped " + field;
    case 8: case 9: delete o[name]; return "delete " + name;
    case 10: delete o[field]; return "delete " + field;
    case 11: o[symbols[random(3)]] = 1; return "symbol";
    case 12: o[random(5)] = 1; return "index";
    case 13: Object.defineProperty(o, name, { get() { return 7; }, set(value) {}, enumerable: true, configurable: true }); return "accessor " + name;
    case 14: Object.defineProperty(o, name, { value: 8, enumerable: random(2) === 0, configurable: true, writable: true }); return "define " + name;
    default: delete o[symbols[random(3)]]; delete o[random(5)]; return "delete symbol and index";
  }
}

export function run() {
  const makers = [["class", () => new Options()], ["class", () => new Packed()], ["record", () => makeSettings(1)]];
  for (let round = 0; round < 240; round++) {
    const [kind, make] = makers[round % 3];
    const o = make();
    const said = [];
    let hash = 2166136261;
    for (let i = 0; i < 40; i++) {
      said.push(step(o, kind, said));
      hash = hashOf(listings(o), hash);
    }
    console.log(round, (hash >>> 0).toString(16), round % 20 === 0 ? said.join(", ") + " => " + listings(o) : Reflect.ownKeys(o).map(String).join());
  }

  for (const [first, second] of [["x", "y"], ["y", "x"], ["x", "x"], ["y", "id"], ["x", "host"], ["5", "y"], ["x", "7"]]) {
    for (let i = 0; i < 3; i++) {
      const o = makeSettingsWithKeys(first, second);
      const made = listings(o);
      setPortOf(o, 1);
      o.z = 1;
      delete o[first];
      setPathOf(o, "p");
      console.log("literal", first, second, made, "=>", listings(o));
    }
  }

  for (let i = 0; i < 4; i++) {
    const o = makeNarrow(i);
    o.before = 1;
    o.later = 2;
    o.after = 3;
    if (i & 1) o.other = "o";
    o.last = 4;
    const wider = asWider(o);
    console.log("cast", laterOf(wider), listings(wider), wider === o);
    delete wider.before;
    wider.more = 5;
    console.log("cast, then changed", listings(wider));
  }

  const big = new Options();
  for (let i = 0; i < 5000; i++) big["n" + i] = i;
  big.setHost("h");
  for (let i = 0; i < 5000; i += 2) delete big["n" + i];
  big.setPort(1);
  big.tail = 1;
  const keysOfBig = Object.keys(big);
  console.log("big", keysOfBig.length, keysOfBig.slice(0, 4).join(), keysOfBig.slice(-4).join(), keysOfBig.indexOf("host"), keysOfBig.indexOf("port"));
}
//// factory-builds-common-part-first.ts
// A factory of syntax nodes: a base factory makes the common part, the factory of each kind of node stores the rest. Two kinds share one type that names no kind, and a smaller type names one of the two.
type Mutable<T> = { -readonly [K in keyof T]: T[K] };
interface Sym { name: string }
interface Node { readonly kind: number; readonly pos: number; readonly end: number; readonly flags: number; readonly parent: Node }
interface Identifier extends Node { readonly kind: 1; readonly text: string }
interface Declaration extends Node { symbol: Sym; localSymbol?: Sym }
interface Tag extends Node { readonly parent: Node; readonly tagName: Identifier; readonly comment?: string }
interface PropertyLikeTag extends Tag, Declaration { readonly name: Identifier; readonly typeExpression?: Node; readonly isNameFirst: boolean; readonly isBracketed: boolean }
interface PropertyTag extends PropertyLikeTag { readonly kind: 2 }
interface ParameterTag extends PropertyLikeTag { readonly kind: 3 }
interface TemplateTag extends Tag { readonly kind: 4; readonly constraint: Node | undefined }
function NodeObject(this: Mutable<Node>, kind: number, pos: number, end: number) { this.pos = pos; this.end = end; this.kind = kind; this.flags = 0; this.parent = undefined!; }
const allocator = { getNodeConstructor: () => NodeObject as any as new (kind: number, pos: number, end: number) => Node };
let NodeConstructor: new (kind: number, pos: number, end: number) => Node;
const baseFactory = { createBaseNode(kind: number): Node { return new (NodeConstructor || (NodeConstructor = allocator.getNodeConstructor()))(kind, -1, -1); } };
function createBaseNode<T extends Node>(kind: T["kind"]) { return baseFactory.createBaseNode(kind) as Mutable<T>; }
function createBaseDeclaration<T extends Declaration>(kind: T["kind"]) { const node = createBaseNode(kind); node.symbol = undefined!; node.localSymbol = undefined; return node; }
function createBaseTag<T extends Tag>(kind: T["kind"], tagName: Identifier, comment: string | undefined) { const node = createBaseNode<T>(kind); node.tagName = tagName; node.comment = comment; return node; }
function createBaseTagDeclaration<T extends Tag & Declaration>(kind: T["kind"], tagName: Identifier, comment: string | undefined) { const node = createBaseDeclaration<T>(kind); node.tagName = tagName; node.comment = comment; return node; }
function createIdentifier(text: string): Identifier { const node = createBaseNode<Identifier>(1); node.text = text; return node; }
function createParameterTag(tagName: Identifier | undefined, name: Identifier, isBracketed: boolean, typeExpression?: Node, isNameFirst?: boolean, comment?: string): ParameterTag {
  const node = createBaseTagDeclaration<ParameterTag>(3, tagName ?? createIdentifier("param"), comment);
  node.typeExpression = typeExpression; node.name = name; node.isNameFirst = !!isNameFirst; node.isBracketed = isBracketed; return node;
}
function createPropertyTag(tagName: Identifier | undefined, name: Identifier, isBracketed: boolean): PropertyTag {
  const node = createBaseTagDeclaration<PropertyTag>(2, tagName ?? createIdentifier("prop"), undefined);
  node.typeExpression = undefined; node.name = name; node.isNameFirst = false; node.isBracketed = isBracketed; return node;
}
function createTemplateTag(constraint: Node | undefined): TemplateTag { const node = createBaseTag<TemplateTag>(4, createIdentifier("template"), undefined); node.constraint = constraint; return node; }
interface Named extends Node { readonly kind: 3 | 6; readonly name: Identifier }
interface Other extends Named { readonly kind: 6 }
function createBaseNamed<T extends Named>(kind: T["kind"], name: Identifier) { const node = createBaseNode<T>(kind); node.name = name; return node; }
function createOther(name: Identifier): Other { return createBaseNamed<Other>(6, name); }
function nameOf(named: Named): string { return named.kind + named.name.text; }
function describe(tag: PropertyLikeTag): string { return tag.kind + ":" + tag.tagName.text + ":" + tag.name.text + ":" + tag.isBracketed + ":" + tag.isNameFirst + ":" + (tag.comment ?? "-"); }
const tags: Tag[] = [];
for (let i = 0; i < 3; i++) {
  const p = createParameterTag(undefined, createIdentifier("x" + i), i === 1, undefined, true, "c" + i);
  const q = createPropertyTag(createIdentifier("property"), createIdentifier("y" + i), false);
  tags.push(p, q, createTemplateTag(p));
  console.log(describe(p), describe(q));
}
console.log(nameOf(createOther(createIdentifier("o"))));
console.log(tags.map(t => t.kind + t.tagName.text).join());
//// field-covariance.ts
// Field covariance: a `{ pet: Dog }` is used as a `{ pet: Animal }`, written through the wider type and read through the narrower one.
interface Animal { species: string; legs: number }
interface Dog extends Animal { bark(): string; collar?: string }
interface Cat extends Animal { meow(): string }
interface DogOwner { who: string; pet: Dog }
interface AnimalOwner { who: string; pet: Animal }
const rex: Dog = { species: "dog", legs: 4, bark() { return "woof" } }
const tom: Cat = { species: "cat", legs: 4, meow() { return "meow" } }

const owner: DogOwner = { who: "ann", pet: rex }
const wide: AnimalOwner = owner
console.log(owner.pet.bark(), wide.pet.species, owner.pet === wide.pet)
wide.pet = tom
console.log(wide.pet.species, wide.pet.legs, "bark" in wide.pet, wide.pet === tom, JSON.stringify(owner), owner.who)
wide.pet = { species: "snake", legs: 0 }
console.log(wide.pet.species, wide.pet.legs, Object.keys(wide.pet).join(), JSON.stringify(owner))
owner.pet = rex
owner.pet.collar = "red"
console.log(wide.pet.species, owner.pet.bark(), JSON.stringify(wide.pet), owner.pet.collar)

// The same through a function that only knows the wide type, in a loop over owners of both kinds.
function adopt(o: AnimalOwner, a: Animal) { o.pet = a }
function petOf(o: AnimalOwner): Animal { return o.pet }
const owners: DogOwner[] = []
for (let i = 0; i < 6; i++) owners.push({ who: "o" + i, pet: rex })
for (let i = 0; i < 6; i += 2) adopt(owners[i], i % 4 ? tom : { species: "bird", legs: 2 })
console.log(owners.map(o => o.who + ":" + petOf(o).species + ":" + ("bark" in petOf(o) ? o.pet.bark() : "-")).join())

// Classes: a field declared with a narrower type in the subclass.
class Shelter { resident: Animal = tom; swap(a: Animal) { this.resident = a } legs() { return this.resident.legs } species() { return this.resident.species } }
class Kennel extends Shelter { declare resident: Dog; noise() { return this.resident.bark() } }
const kennel = new Kennel()
console.log(kennel.legs(), kennel.species())
kennel.swap(rex)
console.log(kennel.noise(), kennel.resident.collar, kennel.species())
kennel.swap({ species: "ant", legs: 6 })
console.log(kennel.legs(), kennel.species(), JSON.stringify(kennel))

// Methods are bivariant in their parameters: a handler for dogs, seen as a handler for animals, is given a dog.
interface Handler<T> { handle(x: T): string }
const dogHandler: Handler<Dog> = { handle(d) { return d.species + "/" + d.bark() } }
const anyHandler: Handler<Animal> = dogHandler
console.log(anyHandler.handle(rex))

// Optional and union-typed fields.
interface MaybeDog { pet?: Dog; spare: Dog | null }
interface MaybeAnimal { pet?: Animal; spare: Animal | null }
const maybe: MaybeDog = { spare: null }
const maybeWide: MaybeAnimal = maybe
maybeWide.pet = tom; maybeWide.spare = tom
console.log(maybeWide.pet?.species, maybeWide.spare?.legs, Object.keys(maybe).join())
delete maybeWide.pet; maybeWide.spare = null
console.log(maybe.pet, maybe.spare, "pet" in maybe, maybe.pet?.bark())

// Two levels down, generics, and a function-typed field whose result is covariant.
interface Boxed<T> { value: T }
const inner: Boxed<Boxed<Dog>> = { value: { value: rex } }
const outer: Boxed<Boxed<Animal>> = inner
console.log(inner.value.value.bark())
outer.value.value = tom
console.log(outer.value.value.species, inner.value === outer.value)
outer.value = { value: { species: "eel", legs: 0 } }
console.log(outer.value.value.species, JSON.stringify(inner))
interface DogMaker { make: () => Dog }
interface AnimalMaker { make: () => Animal }
const maker: DogMaker = { make: () => rex }
const wideMaker: AnimalMaker = maker
console.log(maker.make().bark())
wideMaker.make = () => tom
console.log(wideMaker.make().species, maker.make === wideMaker.make)
//// field-initializers-that-name-function-declarations/core.ts
import { imported, constant, reassigned } from "./helpers.ts";
import { probe } from "./probes.js";

function local(value: number): number {
  return value * 2;
}

////= lines-23	Names
export function sumOfNames(value: Names): number {
  return value.a + value.z + value.f() + value.viaImport(1) + value.viaLocal(2);
}
export function makeNames(): Names {
  return new Names();
}

////= lines-23	OnlyExtended
export function sumOfOnlyExtended(value: OnlyExtended): number {
  return value.a + value.z + value.f() + value.viaImport(1) + value.viaLocal(2);
}

export class StillRunsCode {
  a = 1;
  f = (): number => this.a;
  viaConstant = constant;
  viaVariable = reassigned;
  seen: string = probe(this);
  viaImport = imported;
  z = 2;
}
export function sumOfStillRunsCode(value: StillRunsCode): number {
  return value.a + value.z + value.viaConstant(1) + value.viaVariable(1) + value.viaImport(1);
}
export function makeStillRunsCode(): StillRunsCode {
  return new StillRunsCode();
}
//// field-initializers-that-name-function-declarations/helpers.ts
export function imported(value: number): number {
  return value + 1;
}
export const constant = (value: number): number => value + 2;
export let reassigned = (value: number): number => value + 3;
export function reassign(): void {
  reassigned = value => value + 30;
}
//// field-initializers-that-name-function-declarations/main.ts
import * as typed from "./core.ts";
import { imported, reassign } from "./helpers.ts";
import { HeirOfNames, HeirOfOnlyExtended } from "./untyped.js";

for (const made of [typed.makeNames(), new HeirOfNames()]) console.log(Object.keys(made).join(), typed.sumOfNames(made), made.viaImport === imported, JSON.stringify(made));
const heir = new HeirOfOnlyExtended();
console.log(Object.keys(heir).join(), typed.sumOfOnlyExtended(heir), heir.viaImport === imported, JSON.stringify(heir));
const first = typed.makeStillRunsCode();
reassign();
const second = typed.makeStillRunsCode();
console.log(Object.keys(first).join(), first.seen, typed.sumOfStillRunsCode(first), typed.sumOfStillRunsCode(second));
//// field-initializers-that-name-function-declarations/probes.js
export function probe(seen) {
  return Object.keys(seen).join() + "|" + ("z" in seen) + "|" + typeof seen.viaImport;
}
//// field-initializers-that-name-function-declarations/untyped.js
import { Names, OnlyExtended } from "./core.ts";
export class HeirOfNames extends Names {}
export class HeirOfOnlyExtended extends OnlyExtended {}
//// field-stored-before-definition-keeps-slot.ts
// A key is made where a property is first stored. The definition of a field whose key is there already gives it a new value and leaves it where it is. So what the constructor of the class that is
// extended, or an initializer, stores under the name of a field that is yet to be defined comes first among the keys. Until then the object has no such property.
const keysOf = (object: object): string => Object.keys(object).join() + " " + JSON.stringify(object);
class StoresTwo { n = 0; constructor() { (this as any).more = 5; (this as any).x = 1; } }
class HeirOfStoresTwo extends StoresTwo { more = 2; }
class StoresOne { n = 0; constructor() { (this as any).more = 5; } }
class HeirOfStoresOne extends StoresOne { first = 0; more = 2; }
class CallsInit { n = 0; constructor() { this.init(); } init(): void {} }
class HeirOfCallsInit extends CallsInit { a = 1; b = 2; override init(): void { this.b = 9; } }
class BackToFront extends CallsInit { a = 1; b = 2; c = 3; override init(): void { this.c = 9; this.a = 8; } }
class Assigns { n = 0; constructor(given: object) { Object.assign(this, given); } }
class HeirOfAssigns extends Assigns { a = 1; b = 2; }
class Model { constructor(init?: object) { Object.assign(this, init); } }
class User extends Model { id = 0; name = ""; constructor(init?: Partial<User>) { super(init); Object.assign(this, init); } }
class Hooked { s = "s"; constructor() { console.log(Object.keys(this).join(), "x" in this, Object.hasOwn(this, "x"), Object.getOwnPropertyDescriptor(this, "x") === undefined, JSON.stringify(this)); this.hook(); } hook(): void {} }
class HeirOfHooked extends Hooked { x = 1; y?: number; z: string | undefined; override hook(): void { this.y = 5; this.z = "hook"; console.log(Object.keys(this).join(), "y" in this, "x" in this); } }
class ByItsOwnInitializer { a = this.init(); b?: number; c = 2; init(): number { this.b = 7; this.c = 9; return 1; } }
class RunsCode extends CallsInit { p = keysOf(this).length; q = 1; override init(): void { this.q = 4; } }
class StoresUndefined extends CallsInit { a = 1; b: number | undefined = 2; override init(): void { (this as any).b = undefined; } }
for (let round = 0; round < 3; round++) {
  const made = [new HeirOfStoresTwo(), new HeirOfStoresOne(), new HeirOfCallsInit(), new BackToFront(), new HeirOfAssigns({ b: 7, z: 1 }), new User({ name: "n", id: 5 }), new User({ id: 5, name: "n" }), new User(), new HeirOfHooked(), new ByItsOwnInitializer(), new RunsCode(), new StoresUndefined()];
  for (const object of made) console.log(round, object.constructor.name, keysOf(object));
}
let last = "";
for (let i = 0; i < 300; i++) last = keysOf(new User({ name: "n", id: i })) + keysOf(new HeirOfCallsInit()) + keysOf(new BackToFront());
console.log(last);
//// field-that-shares-its-slot-with-another-type.ts
// `context.options.model`: two record types have a field `options` of different types, and a function that takes either reads it, so both fields may stand in one slot. Reads and stores through each type and through the common supertype answer as in plain Bun.
interface Options { model: string; depth: number }
interface Legend { label: string; wide: boolean }
interface Holder { id: number; options: Options | Legend }
interface Context extends Holder { options: Options }
interface Panel extends Holder { options: Legend }
function makeContext(id: number): Context { return { id, options: { model: "m" + id, depth: id } }; }
function makePanel(id: number): Panel { return { id, options: { label: "l" + id, wide: id > 1 } }; }
function keysOfOptions(holder: Holder): string { return Object.keys(holder.options).join(); }
function modelOf(context: Context): string { return context.options.model; }
function depthOf(context: Context): number { return context.options.depth + 1; }
function labelOf(panel: Panel): string { return panel.options.label; }
function replace(context: Context, model: string): void { context.options = { model, depth: 0 }; }
const contexts = [makeContext(1), makeContext(2)];
const panels = [makePanel(1), makePanel(2)];
console.log(contexts.map(modelOf).join(), contexts.map(depthOf).join(), panels.map(labelOf).join());
console.log(keysOfOptions(contexts[0]), keysOfOptions(panels[1]));
replace(contexts[1], "other");
console.log(modelOf(contexts[1]), depthOf(contexts[1]));
function swap(holder: Holder, options: Options | Legend): void { holder.options = options; }
swap(panels[0], { label: "swapped", wide: false });
console.log(labelOf(panels[0]), keysOfOptions(panels[0]));
//// fields-a-maker-left-out-whatever-is-done-to-the-object.ts
// A maker leaves fields out that the type declares; another function could store them. A read of such a field finds what JavaScript says it finds, whatever is done to the object or above it.
type Project = { cwd: string };
////= Session
const home: Project = { cwd: "/home" };
function make(id: number): Session {
  return { id } as Session;
}
////= attach
function describe(session: Session): string {
  return [session.project, session.optionalProject, session.count, session.optionalCount, session.flag, session.neverStored]
    .map(value => (typeof value === "object" && value !== null ? "object " + (value as Project).cwd : String(value)))
    .join(" | ");
}
function hot(session: Session): string {
  let last = "";
  for (let i = 0; i < 2000; i++) last = describe(session);
  return last;
}
const unknown: any = (globalThis as any).Function("return this")();

console.log("left out:", hot(make(1)));
const attached = make(2);
attach(attached);
console.log("attached:", hot(attached));

const deleted = make(3);
attach(deleted);
delete (deleted as any).project;
delete deleted.optionalCount;
console.log("deleted:", hot(deleted));

const withPrototype = make(4);
unknown.Object.setPrototypeOf(withPrototype, { project: { cwd: "/inherited" }, optionalCount: 40, neverStored: "inherited", flag: false });
console.log("another prototype:", hot(withPrototype));

const withGetter = make(5);
unknown.Object.defineProperty(withGetter, "optionalProject", { get() { return { cwd: "/getter" }; }, configurable: true });
unknown.Object.defineProperty(withGetter, "neverStored", { value: "defined", configurable: true });
unknown.Object.defineProperty(withGetter, "count", { value: 50, writable: false });
console.log("defined:", hot(withGetter));

const assigned = make(6);
unknown.Object.assign(assigned, { project: { cwd: "/assigned" }, flag: false, neverStored: "assigned", optionalCount: 1.5 });
console.log("assigned:", hot(assigned));

const reflected = make(7);
unknown.Reflect.set(reflected, "count", "text");
unknown.Reflect.set(reflected, "neverStored", 7);
console.log("reflected:", hot(reflected));

const storedUndefined = make(8);
(storedUndefined as any).project = undefined;
(storedUndefined as any).count = undefined;
(storedUndefined as any).flag = null;
console.log("undefined stored:", hot(storedUndefined));

const base = { project: { cwd: "/base" }, neverStored: "base" };
const heir: Session = unknown.Object.create(base);
console.log("an heir of another object:", hot(heir));
const frozen = make(9);
unknown.Object.freeze(frozen);
console.log("frozen:", hot(frozen));
console.log("left out again:", hot(make(10)));
//// fields-added-by-later-cast.ts
// Fields that a later cast to a subtype adds to an object can be observed as missing until they are stored.
const show = (what: string, o: object) => console.log(what, JSON.stringify(Object.keys(o)), JSON.stringify(o))
const read = (o: any, name: string) => o[name]
interface Sym { flags: number; name: string }
interface Transient extends Sym { links: { check: number }; depth: number }
function SymCtor(this: Sym, flags: number, name: string) { this.flags = flags; this.name = name }
const Sym = SymCtor as unknown as new (flags: number, name: string) => Sym
function transient(flags: number, name: string): Transient {
  const made = new Sym(flags, name) as Transient
  made.links = { check: flags * 2 }
  made.depth = 1
  return made
}
show("fresh", transient(1, "a"))
// The cast comes long after the allocation, and the added fields are seen absent.
const kept: Sym[] = [new Sym(2, "b"), transient(3, "c")]
for (const sym of kept) {
  const late = sym as Transient
  console.log(late.flags, late.name, "depth" in late, read(late, "depth"), read(late, "links")?.check, JSON.stringify(Object.keys(late)))
}
const late = kept[0] as Transient
late.depth = 5; show("late", late); console.log(late.depth + late.flags)
// A literal that becomes more.
interface Range { pos: number; end: number }
interface Item extends Range { kind: number; flags: number }
function ItemCtor(this: Item, kind: number, pos: number, end: number) { this.pos = pos; this.end = end; this.kind = kind; this.flags = 0 }
const Item = ItemCtor as unknown as new (kind: number, pos: number, end: number) => Item
const ranges: Range[] = [{ pos: 1, end: 2 }, new Item(7, 3, 4)]
for (const range of ranges) {
  const item = range as Item
  console.log(item.pos, item.end, read(item, "kind"), "kind" in item, read(item, "flags"), JSON.stringify(Object.keys(item)))
}
function setRange<T extends Range>(range: T, from: Range | undefined): T { if (from) { range.pos = from.pos; range.end = from.end } return range }
const moved = setRange(new Item(8, 0, 0), ranges[0]); show("moved", moved); console.log(moved.kind + moved.flags + moved.pos + moved.end)
//// fields-added-by-later-passes.ts
// Nodes created by a factory get further properties from later passes, as in a compiler's binder and checker.
enum SyntaxKind { SourceFile, FunctionDeclaration, VariableDeclaration, Block, Identifier, NumericLiteral }
enum SymbolFlags { None = 0, Variable = 1 << 0, Function = 1 << 1, Redeclared = 1 << 2 }
enum FlowFlags { Start = 1 << 0, Assignment = 1 << 1, Container = 1 << 2 }
type Mutable<T extends object> = { -readonly [K in keyof T]: T[K] }
interface Sym { flags: SymbolFlags; escapedName: string; declarations: Declaration[] | undefined; valueDeclaration: Declaration | undefined; id: number; parent?: Sym; isReferenced?: boolean }
interface FlowNode { flags: FlowFlags; id: number; node: AstNode | undefined; antecedent: FlowNode | undefined } interface Ty { id: number; intrinsicName: string }
interface AstNode { readonly kind: SyntaxKind; readonly pos: number; readonly end: number; id: number; readonly parent: AstNode }
interface Declaration extends AstNode { symbol: Sym; localSymbol?: Sym }
interface LocalsContainer extends AstNode { locals?: Map<string, Sym>; nextContainer?: LocalsContainer } interface FlowContainer extends AstNode { flowNode?: FlowNode }
interface Identifier extends FlowContainer { readonly kind: SyntaxKind.Identifier; readonly text: string; resolvedSymbol?: Sym }
interface NumericLiteral extends AstNode { readonly kind: SyntaxKind.NumericLiteral; readonly value: number }
interface VariableDeclaration extends Declaration { readonly kind: SyntaxKind.VariableDeclaration; readonly name: Identifier; readonly initializer: AstNode | undefined; resolvedType?: Ty }
interface Block extends LocalsContainer { readonly kind: SyntaxKind.Block; readonly statements: AstNode[] }
interface FunctionDeclaration extends Declaration, LocalsContainer, FlowContainer { readonly kind: SyntaxKind.FunctionDeclaration; readonly name: Identifier; readonly body: Block; returnFlowNode?: FlowNode }
interface SourceFile extends LocalsContainer { readonly kind: SyntaxKind.SourceFile; readonly fileName: string; readonly statements: AstNode[]; symbolCount: number }
function AstNode(this: Mutable<AstNode>, kind: SyntaxKind, pos: number, end: number) { this.pos = pos; this.end = end; this.kind = kind; this.id = 0 }
function Sym(this: Sym, flags: SymbolFlags, escapedName: string) { this.flags = flags; this.escapedName = escapedName; this.declarations = undefined; this.valueDeclaration = undefined; this.id = 0 }
const objectAllocator = { getNodeConstructor: () => AstNode as any as new (kind: SyntaxKind, pos: number, end: number) => AstNode, getSymbolConstructor: () => Sym as any as new (flags: SymbolFlags, escapedName: string) => Sym }
let cursor = 0
function createNode<T extends AstNode>(kind: T["kind"], width: number) { const node = new (objectAllocator.getNodeConstructor())(kind, cursor, cursor + width) as Mutable<T>; cursor += width; return node }
function identifier(text: string): Identifier { const node = createNode<Identifier>(SyntaxKind.Identifier, text.length); node.text = text; return node }
function numeric(value: number): NumericLiteral { const node = createNode<NumericLiteral>(SyntaxKind.NumericLiteral, 1); node.value = value; return node }
function variable(text: string, initializer?: AstNode): VariableDeclaration { const node = createNode<VariableDeclaration>(SyntaxKind.VariableDeclaration, 4); node.name = identifier(text); node.initializer = initializer; return node }
function block(statements: AstNode[]): Block { const node = createNode<Block>(SyntaxKind.Block, 2); node.statements = statements; return node }
function func(text: string, statements: AstNode[]): FunctionDeclaration { const node = createNode<FunctionDeclaration>(SyntaxKind.FunctionDeclaration, 9); node.name = identifier(text); node.body = block(statements); return node }
function sourceFile(fileName: string, statements: AstNode[]): SourceFile { const node = createNode<SourceFile>(SyntaxKind.SourceFile, 0); node.fileName = fileName; node.statements = statements; return node }
function bindSourceFile(file: SourceFile) {
  let container: LocalsContainer = file, lastContainer: LocalsContainer = file, symbolCount = 0, flowCount = 0
  let currentFlow: FlowNode = { flags: FlowFlags.Start, id: ++flowCount, node: undefined, antecedent: undefined }
  function declareSymbol(node: Declaration, text: string, flags: SymbolFlags) {
    const locals = container.locals ||= new Map<string, Sym>()
    let symbol = locals.get(text)
    if (symbol) symbol.flags |= SymbolFlags.Redeclared
