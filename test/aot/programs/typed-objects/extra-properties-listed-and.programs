////= make
class Options {
  declare host?: string;
  declare port?: number;
  always = 1;
}
let depth = 0;
function read(reply: any): string {
  if (depth > 0) { depth--; return read(reply) + read(reply); }
  return [reply.statusCode, reply.statusMessage, reply.timeout, reply.chunked, reply.size, reply.upgrade, reply.fourth].map(String).join();
}
function readOdd(reply: any): string {
  if (depth > 0) { depth--; return readOdd(reply) + readOdd(reply); }
  return [reply.statusCode, reply.statusMessage, reply.timeout, reply.chunked, reply.size, reply.upgrade, reply.fourth].map(String).join();
}
function readOptions(options: any): string {
  if (depth > 0) { depth--; return readOptions(options) + readOptions(options); }
  return [options.host, options.port, options.always].map(String).join();
}
////= show
const odd: any[] = JSON.parse("[0,0,0,0]");
odd[0] = { statusCode: 1, size: 2, fourth: "f" };
odd[1] = Object.freeze(make("/"));
odd[2] = undefined;
odd[3] = "text";
for (let turn = 0; turn < 3; turn++) {
  const untouched = make("/");
  show("never stored", () => read(untouched) + " " + Object.keys(untouched).length + " " + ("fourth" in untouched));
  const stored = make("/");
  stored.size = turn;
  show("one stored", () => read(stored));
  stored.fourth = "4";
  stored.statusMessage = "OK";
  stored.chunked = true;
  stored.upgrade = untouched;
  stored.timeout = 1.5;
  show("more stored", () => read(stored));
  stored.size = undefined;
  stored.fourth = undefined;
  show("undefined again", () => read(stored) + " " + Object.keys(stored).length);
  const cut: any = make("/");
  delete cut.fourth;
  delete cut.size;
  show("two deleted", () => readOdd(cut) + " " + Object.keys(cut).length + " " + ("fourth" in cut));
  cut.fourth = "back";
  show("one back", () => readOdd(cut) + " " + Object.keys(cut).join().length);
  const more: any = make("/");
  more.further = 1;
  show("one key more", () => readOdd(more) + " " + Object.keys(more).length);
  const heir: any = Object.create(stored);
  show("an heir", () => readOdd(heir));
  heir.size = 9;
  show("an heir with a property of its own", () => readOdd(heir) + " " + read(stored));
  show("a plain object", () => readOdd(odd[0]));
  show("a frozen one", () => readOdd(odd[1]));
  show("undefined", () => readOdd(odd[2]));
  show("a string", () => readOdd(odd[3]));
  const options = new Options();
  show("optional fields, absent", () => readOptions(options) + " " + Object.keys(options).join());
  options.port = turn;
  show("optional fields, one created", () => readOptions(options) + " " + Object.keys(options).join());
  show("an heir of an instance with absent fields", () => readOptions(Object.create(options)));
}
console.log(read(make("/x")), readOptions(new Options()));
//// fields-born-undefined-stored-where-the-type-is-only-predicted.ts
////= Reply
////= make
let depth = 0;
function finish(reply: any, message: any, size: any, chunked: any, upgrade: any): void {
  if (depth > 0) { depth--; finish(reply, message, size, chunked, upgrade); finish(reply, message, size, chunked, upgrade); }
  reply.statusMessage = message;
  reply.size = size;
  reply.chunked = chunked;
  reply.upgrade = upgrade;
  reply.fourth = "4";
}
const bag = new Map<string, any>();
const held = (value: unknown) => (bag.set("held", value), bag.get("held"));
const describe = (reply: any) => JSON.stringify(reply) + " " + Object.keys(reply).length + " " + [reply.statusMessage, reply.size, reply.chunked, typeof reply.upgrade, reply.fourth, reply.third].map(String).join();
////= show
for (let turn = 0; turn < 3; turn++) {
  const reply = make("/" + turn);
  show("the first stores", () => (finish(reply, "OK", turn, true, reply), [reply.statusMessage, reply.size, reply.chunked, reply.upgrade === reply, reply.fourth, reply.third, Object.keys(reply).length].map(String).join()));
  show("stored again", () => (finish(reply, "Again", turn + 0.5, false, bag), [reply.statusMessage, reply.size, reply.chunked, reply.upgrade === bag, reply.fourth].map(String).join()));
  show("undefined again", () => (finish(reply, undefined, undefined, undefined, undefined), describe(reply)));
  show("large numbers", () => (finish(reply, "n", 2 ** 40, true, undefined), finish(reply, "n", -(2 ** 31), true, undefined), describe(reply)));
  const cut: any = make("/cut");
  delete cut.size;
  delete cut.fourth;
  show("deleted before", () => (finish(held(cut), "OK", 1, true, undefined), describe(cut) + " " + Object.keys(cut).slice(-3).join()));
  const more: any = make("/more");
  more.further = 1;
  show("one key more", () => (finish(held(more), "OK", 1, true, undefined), describe(more)));
  show("a number for the message", () => (finish(held(make("/w")), 1, 1, true, undefined), describe(bag.get("held"))));
  show("a string for the size", () => (finish(held(make("/w")), "OK", "1", true, undefined), describe(bag.get("held"))));
  show("a number for the flag", () => (finish(held(make("/w")), "OK", 1, 1, undefined), describe(bag.get("held"))));
  show("a string for the object", () => (finish(held(make("/w")), "OK", 1, true, "u"), describe(bag.get("held"))));
  show("null for the message", () => (finish(held(make("/w")), null, 1, true, undefined), describe(bag.get("held"))));
  show("frozen", () => (finish(held(Object.freeze(make("/f"))), "OK", 1, true, undefined), describe(bag.get("held"))));
  show("sealed", () => (finish(held(Object.seal(make("/s"))), "OK", 1, true, undefined), describe(bag.get("held"))));
  show("not extensible", () => (finish(held(Object.preventExtensions(make("/p"))), "OK", 1, true, undefined), describe(bag.get("held"))));
  show("a plain object", () => (finish(held({ statusCode: 1 }), "OK", 1, true, undefined), describe(bag.get("held"))));
  const base = make("/base");
  show("an heir", () => (finish(held(Object.create(base)), "OK", 1, true, undefined), describe(bag.get("held")) + " | " + describe(base)));
  show("undefined", () => finish(held(undefined), "OK", 1, true, undefined));
  show("a string", () => finish(held("text"), "OK", 1, true, undefined));
}
//// fields-initialized-after-allocation.ts
// Required fields that are stored right after an object's allocation can never be observed as missing; frozen objects, reflection and untyped callers see the same as in plain Bun.
const show = (what: string, o: object) => console.log(what, JSON.stringify(Object.keys(o)), JSON.stringify(o))
enum Flags { None = 0, One = 1, All = -1 }
// Through `any`, by a computed name: no written type is involved in the read.
const read = (o: any, name: string) => o[name]
const list = [1]

interface A { o: number[]; x: number; y: Flags; z: number; w?: number }
function ACtor(this: A, o: number[], x: number, extra: boolean) { this.o = o; this.x = x; this.y = Flags.All; if (extra) this.w = 7; this.z = x + 1 }
const A = ACtor as unknown as new (o: number[], x: number, extra: boolean) => A
show("A", new A(list, 1, false)); show("A", new A(list, 2, true))
let sum = 0
for (let i = 0; i < 3; i++) { const a = new A(list, i, i == 1); sum += a.x + a.y + a.z + (a.w ?? 0) + a.o.length }
console.log("A sum", sum)

// Two functions for one type, in different orders: the keys follow the function that ran.
interface B { o: number[]; p: number; q: number; r: number }
function B1(this: B, o: number[], n: number, m: number) { this.p = n; this.q = m; this.r = 12; this.o = o }
function B2(this: B, o: number[], n: number, m: number) { this.o = o; this.p = n; this.r = 12; this.q = m }
const makers = [B1, B2, B1] as unknown as (new (o: number[], n: number, m: number) => B)[]
for (const Maker of makers) { const b = new Maker(list, 10, 11); show("B", b); console.log(b.p + b.q * 2 + b.r * 3 + b.o.length) }
const frozen = Object.freeze(new makers[0](list, 1, 2))
try { B2.call(frozen, list, 3, 4) } catch (e) { console.log("B frozen", (e as Error).constructor.name) }
show("B frozen", frozen)

// A default runs before the body and sees the object.
interface C { o: number[]; m: number; n: number }
const seen: string[] = []
function CCtor(this: C, m = (seen.push(JSON.stringify(Object.keys(this)), String("m" in this), String(read(this, "m"))), 5)) { this.o = list; this.m = m; this.n = 1 }
const C = CCtor as unknown as new (m?: number) => C
show("C", new C()); console.log(seen.join(" "))

// A value that contains a call may throw, and nothing references the object then.
interface D { o: number[]; u: number; v: number }
let fail = true
const next = () => { if (fail) throw new Error("no"); return 3 }
function DCtor(this: D, o: number[]) { this.u = next(); this.v = 4; this.o = o }
const D = DCtor as unknown as new (o: number[]) => D
try { new D(list) } catch (e) { console.log("D", (e as Error).message) }
fail = false; show("D", new D(list))

// `this` escapes after the second store.
interface E { o: number[]; a: number; b: number }
const peek = (e: E) => console.log("peek", JSON.stringify(Object.keys(e)), e.a, e.o.length, read(e, "b"), "b" in e, Object.hasOwn(e, "b"))
function ECtor(this: E, o: number[]) { this.o = o; this.a = 1; peek(this); this.b = 2 }
const E = ECtor as unknown as new (o: number[]) => E
show("E", new E(list))

// A type that admits untyped objects.
interface F { f: number; g: number }
function FCtor(this: F, f: number) { this.f = f; this.g = 2 }
const F = FCtor as unknown as new (f: number) => F
const parsed: F = JSON.parse('{"g":5,"f":6}')
for (const it of [new F(1), parsed]) { show("F", it); console.log(it.f + it.g * 2) }
FCtor.call(parsed, 7); show("F call", parsed)

// A setter under the name of a field takes the store.
interface G { o: number[]; v: number; t: number }
function GCtor(this: G, o: number[], v: number) { this.o = o; this.v = v; this.t = 1 }
let taken = 0
Object.defineProperty(GCtor.prototype, "v", { set(value: number) { taken = value }, get() { return -taken }, configurable: true })
const G = GCtor as unknown as new (o: number[], v: number) => G
const g = new G(list, 9); show("G", g); console.log(g.v, taken, Object.hasOwn(g, "v"))

// Every kind of caller: typed, untyped, `Reflect.construct`, and a call on an existing object.
interface H { o: number[]; k: Flags; n: number; s?: string }
function HCtor(this: H, o: number[], k: Flags, n: number) { this.k = k; this.n = n; this.o = o }
const H = HCtor as unknown as new (o: number[], k: Flags, n: number) => H
const h = new H(list, Flags.One, 2); h.s = "s"; show("H", h)
show("H any", new (HCtor as any)(list, Flags.All, 3))
show("H reflect", Reflect.construct(HCtor as any, [list, Flags.None, 4]))
HCtor.call(h, list, Flags.All, 5); show("H call", h)
const literal: H = { n: 6, o: list, k: Flags.One }; show("H literal", literal); HCtor.call(literal, list, Flags.None, 7); show("H literal", literal)
console.log(h.k & 3, h.n | 0, literal.k + literal.n, h.o.length)

// `this` of two types.
interface U1 { o: number[]; ua: number }
interface U2 { o: number[]; ua: number; ub: number }
function UCtor(this: U1 | U2, o: number[], ua: number) { this.ua = ua; this.o = o }
const U = UCtor as unknown as new (o: number[], ua: number) => U1
const u = new U(list, 3); show("U", u); console.log(u.ua + u.o.length)
const u2: U2 = { ub: 1, o: list, ua: 2 }; UCtor.call(u2, list, 4); show("U2", u2)

// A name that every object inherits.
interface T { o: number[]; tn: number; valueOf: () => number; tm: number }
function TCtor(this: T, o: number[], tn: number, valueOf: () => number) { this.o = o; this.tn = tn; this.valueOf = valueOf; this.tm = 1 }
const T = TCtor as unknown as new (o: number[], tn: number, valueOf: () => number) => T
const t = new T(list, 2, () => 40); show("T", t); console.log(+t + t.tn + t.tm, Object.hasOwn(t, "valueOf"))

// Two functions for one type, and the `prototype` of one escapes: nothing guards that of the other.
interface M { o: number[]; ma: number; mb: number }
function MCtor(this: M, o: number[], ma: number, mb: number) { this.o = o; this.ma = ma; this.mb = mb }
const escaped: any = MCtor.prototype; escaped.sum = function (this: M) { return this.ma + this.mb }
function MHalf(this: M, o: number[], ma: number) { this.o = o; this.ma = ma }
const M = MCtor as unknown as new (o: number[], ma: number, mb: number) => M
const Half = MHalf as unknown as new (o: number[], ma: number) => M
const m = new M(list, 1, 2); show("M", m); console.log((m as any).sum())
const half = new Half(list, 3); show("M half", half); console.log(read(half, "ma"), read(half, "mb"))
let kept = 0
Object.defineProperty(Object.getPrototypeOf(half), "ma", { set(value: number) { kept = value }, configurable: true })
const later = new Half(list, 5); show("M half, a setter", later); console.log(kept, read(later, "ma"), Object.hasOwn(later, "ma"))

// A callee that is not a constructor function of the type: it declares no `this`, so it does not receive the allocated object, whether
// or not the compiler knows the callee. Any function fits a constructor type, and what it creates is no `H` but an object, which passes an object type, so nothing is thrown: as in plain Bun.
const Other = function (this: any) { this.other = 1 } as unknown as new (o: number[], k: Flags, n: number) => H
try { const o = new Other(list, Flags.One, 1); console.log("Other", JSON.stringify(o), read(o, "k")) } catch (e) { console.log("Other", (e as Error).constructor.name) }
//// fields-on-most-family-members.ts
// A family of record types. Most members have `marks`, `owner`, `label`, `ratio` and `done`; two members have none of them.
// Code reads them behind written casts from every member, whatever the object really is.

interface Item { kind: number; id: number; }
interface Owner { name: string; }
interface Box extends Item { marks: number; owner: Owner | undefined; label: string; ratio: number; done: boolean; width: number; }
interface Bag extends Item { marks: number; owner: Owner | undefined; label: string; ratio: number; done: boolean; depth: number; }
interface Jar extends Item { marks: number; owner: Owner | undefined; label: string; ratio: number; done: boolean; lid?: string; }
interface Tin extends Item { marks: number; owner: Owner | undefined; label: string; ratio: number; done: boolean; }
interface Peg extends Item { length: number; }
interface Pin extends Item { sharp: boolean; }
type Marked = Box | Bag | Jar | Tin;

const lines: string[] = [];
function say(...parts: unknown[]) { lines.push(parts.map(part => typeof part === "object" && part !== null ? JSON.stringify(part) : Object.is(part, -0) ? "-0" : String(part)).join(" ")); }

let nextId = 1;
const ann: Owner = { name: "ann" };
function makeItem(kind: number): Item { const item: Item = { kind, id: nextId++ }; return item; }
function fill(item: Marked, marks: number) { item.marks = marks; item.owner = marks % 2 ? ann : undefined; item.label = "l" + marks; item.ratio = marks / 4; item.done = marks % 3 === 0; }
function makeBox(marks: number): Box { const box = makeItem(1) as Box; fill(box, marks); box.width = 2; return box; }
function makeBag(marks: number): Bag { const bag = makeItem(2) as Bag; fill(bag, marks); bag.depth = 3; return bag; }
function makeJar(marks: number): Jar { const jar = makeItem(3) as Jar; fill(jar, marks); return jar; }
function makeTin(marks: number): Tin { const tin: Tin = { kind: 4, id: nextId++, marks, owner: ann, label: "tin", ratio: 0.5, done: true }; return tin; }
function makePeg(length: number): Peg { const peg = makeItem(5) as Peg; peg.length = length; return peg; }
function makePin(sharp: boolean): Pin { const pin = makeItem(6) as Pin; pin.sharp = sharp; return pin; }

function marksOf(item: Item): number { return item.kind <= 4 ? (item as Marked).marks : 0; }
function marksWhatever(item: Item): number | undefined { return (item as Marked).marks; }
function ownerWhatever(item: Item): Owner | undefined { return (item as Marked).owner; }
function labelWhatever(item: Item): string | undefined { return (item as Marked).label; }
function ratioWhatever(item: Item): number | undefined { return (item as Marked).ratio; }
function doneWhatever(item: Item): boolean | undefined { return (item as Marked).done; }
function show(what: string, item: Item) {
    say(what, item.kind, marksOf(item), marksWhatever(item), ownerWhatever(item)?.name, labelWhatever(item), ratioWhatever(item), doneWhatever(item));
}

const items: Item[] = [makeBox(1), makeBag(2), makeJar(3), makeTin(4), makePeg(5), makePin(true), makeItem(7), makeBox(-1073741825), makeBag(2147483647), makeJar(0)];
for (const item of items) show("made", item);

let sum = 0;
for (let round = 0; round < 300; round++) for (let i = 0; i < items.length; i++) sum += marksOf(items[i]) & 0xff;
say("sum", sum);

// A bare item that has not become anything yet, then becomes a member that has the fields, one by one.
const late = makeItem(7);
show("bare", late);
const lateBox = late as Box;
show("cast", late);
lateBox.marks = 9;
show("marks", late);
lateBox.owner = ann; lateBox.label = "late"; lateBox.ratio = -0; lateBox.done = false;
show("filled", late);
say("keys", Object.keys(late).join(), JSON.stringify(late));

// Numbers of every form.
for (const value of [0, -0, 1.5, NaN, Infinity, -1073741824, -1073741825, 1073741824, 2147483648, -2147483649, 1e300]) {
    const box = makeBox(1);
    box.marks = value; box.ratio = value;
    say("number", marksWhatever(box), ratioWhatever(box), marksOf(box) | 0);
}

// Members without the fields are given properties of those names by code that knows nothing of their types.
function poke(target: object, key: string, value: unknown) { (target as Record<string, unknown>)[key] = value; }
function peek(target: object, key: string): unknown { return (target as Record<string, unknown>)[key]; }
function drop(target: object, key: string) { return Reflect.deleteProperty(target, key); }
const peg = makePeg(1);
show("peg", peg);
say("in", "marks" in peg, Object.hasOwn(peg, "marks"), peek(peg, "marks"));
poke(peg, "marks", 77);
show("peg number", peg);
say("in", "marks" in peg, Object.hasOwn(peg, "marks"), Object.keys(peg).join());
poke(peg, "label", "named"); poke(peg, "owner", ann); poke(peg, "ratio", 2.5); poke(peg, "done", true);
show("peg all", peg);
say("keys", Object.keys(peg).join(), JSON.stringify(peg));
say("dropped", drop(peg, "marks"));
show("peg deleted", peg);
say("in", "marks" in peg, Object.keys(peg).join());
const pin = makePin(false);
Object.defineProperty(pin, "marks", { value: 5, writable: true, enumerable: false, configurable: true });
show("pin hidden", pin);
say("keys", Object.keys(pin).join(), JSON.stringify(pin));
const copy = { ...makePeg(3) };
say("copy", Object.keys(copy).join(), JSON.stringify(copy), JSON.stringify({ ...makeBox(3) }));
const assigned = makePin(true);
Object.assign(assigned, { marks: 12 });
show("assigned", assigned);
say("entries", JSON.stringify(Object.entries(makePeg(2))), JSON.stringify(Object.entries(makeTin(2))));
for (const key in makePin(true)) say("for in", key);
const jar = makeJar(5);
jar.lid = "tight";
say("dropped", drop(jar, "lid"), jar.lid, Object.keys(jar).join());
show("jar without lid", jar);

// Stores through the cast.
const target = makeItem(3);
(target as Jar).marks = 4;
(target as Jar).lid = "on";
show("stored", target);
say("keys", Object.keys(target).join());
const pegSeenAsJar = makePeg(6) as Item as Jar;
pegSeenAsJar.marks = 31;
show("stored to a peg", pegSeenAsJar);
say("keys", Object.keys(pegSeenAsJar).join(), (pegSeenAsJar as Item as Peg).length);

// A second family. One member without the field is written out as it is, so its objects have no room to spare.
interface Leaf { tag: number; }
interface Oak extends Leaf { rings: number; bark: string; }
interface Elm extends Leaf { rings: number; bark: string; }
interface Ash extends Leaf { rings: number; bark: string; }
interface Fir extends Leaf { cones: number; }
function makeLeaf(tag: number): Leaf { const leaf: Leaf = { tag }; return leaf; }
function makeOak(rings: number): Oak { const oak = makeLeaf(1) as Oak; oak.rings = rings; oak.bark = "rough"; return oak; }
function makeElm(rings: number): Elm { const elm = makeLeaf(2) as Elm; elm.rings = rings; elm.bark = "grey"; return elm; }
function makeAsh(rings: number): Ash { const ash = makeLeaf(3) as Ash; ash.rings = rings; ash.bark = "pale"; return ash; }
function makeFir(cones: number): Fir { const fir: Fir = { tag: 4, cones }; return fir; }
function ringsWhatever(leaf: Leaf): number | undefined { return (leaf as Oak | Elm | Ash).rings; }
function barkWhatever(leaf: Leaf): string | undefined { return (leaf as Oak | Elm | Ash).bark; }
const leaves: Leaf[] = [makeOak(10), makeElm(20.5), makeAsh(-3), makeFir(7), makeLeaf(5)];
for (const leaf of leaves) say("leaf", leaf.tag, ringsWhatever(leaf), barkWhatever(leaf), Object.keys(leaf).join());
const fir = makeFir(1);
poke(fir, "rings", 99);
say("fir", ringsWhatever(fir), barkWhatever(fir), Object.keys(fir).join());

console.log(lines.join("\n"));
//// fields-stored-through-wider-views-are-read-back.ts
// TypeScript's fields are covariant: an object with `pet: Dog` is also a `{ pet: Animal }`, and through that view any Animal is stored. No cast, no any in the stores.
// Every later look, typed or not, finds the value that was stored.
class Animal {
  title: string = "animal";
}
////= lines-14	Dog	Animal	legs	number	4
////= lines-14	Cat	Animal	lives	string	"nine"
////= lines-14	Puppy	Dog	age	number	1
class Home {
  pet: Dog = new Dog();
}
////= lines-14	Kennel	Home	size	number	2
class Shelter {
  pet: Animal = new Dog();
}
////= lines-16	Keeper	pet	Animal
const unseen = eval;

function look(home: Home): string {
  const pet = home.pet;
  return [pet.legs, pet.title, pet instanceof Dog, pet instanceof Cat, Object.keys(pet).join(), Object.keys(home).join(), typeof home.pet.legs].join(" ");
}
function put(keeper: Keeper, animal: Animal): void {
  keeper.pet = animal;
}
function sumOfLegs(homes: Home[]): string {
  let sum = 0;
  let missing = 0;
  for (const home of homes) {
    const legs = home.pet.legs;
    if (legs === undefined) missing++;
    else sum += legs;
  }
  return sum + " " + missing;
}

const first = new Home();
console.log("fresh", look(first));
const wide: { pet: Animal } = first;
wide.pet = new Cat();
console.log("a cat through a literal type", look(first));
first.pet = new Dog();
console.log("a dog again", look(first));
wide.pet = new Puppy();
console.log("a puppy through the view", look(first));
wide.pet = new Animal();
console.log("the base class through the view", look(first));

const second = new Home();
put(second, new Dog());
console.log("a dog through a parameter", look(second));
put(second, new Cat());
console.log("a cat through a parameter", look(second));

const homes: Home[] = [];
for (let i = 0; i < 20; i++) homes.push(new Home());
console.log("twenty homes", sumOfLegs(homes));
for (let i = 0; i < 20; i++) put(homes[i], i === 13 ? new Cat() : new Dog());
console.log("one cat among them", sumOfLegs(homes));

const third = new Home();
const returned: Animal = unseen("x => x")(new Cat());
put(third, returned);
console.log("a cat that unseen code handed back", look(third));

const fourth = new Kennel();
put(fourth, new Cat());
console.log("a subclass of the holder", look(fourth), fourth.size);

const fifth = new Shelter();
put(fifth, new Cat());
console.log("a field of the base class", fifth.pet.title, fifth.pet instanceof Cat, Object.keys(fifth.pet).join());

const sixth = new Home();
unseen("(home, cat) => { home.pet = cat; }")(sixth, new Cat());
console.log("stored by unseen code", look(sixth));

////= lines-26	Box	count	number	label	string	"one"
const box = new Box();
const loose: { count: number | string; label: string | undefined } = box;
loose.count = "two";
loose.label = undefined;
console.log("primitives through a view", box.count + 1, typeof box.count, box.label, typeof box.label, Object.keys(box).join());
box.count = 3;
box.label = "three";
console.log("and back", box.count + 1, typeof box.count, box.label.length);

const literal = { pet: new Dog(), name: "literal" };
const looser: { pet: Animal; name: string } = literal;
looser.pet = new Cat();
console.log("a literal holder", literal.pet.legs, literal.pet.title, literal.name, Object.keys(literal).join());
//// fields-that-nothing-reads-by-name-show-wherever-the-whole-object-is-looked-at.ts
// Fields that no code reads by name show wherever the whole object is looked at: console.log, JSON.stringify, Object.keys and its kin, `in`, hasOwn, for-in, spread, rest, Object.assign, structuredClone, Bun.inspect, deep equality, a computed key.
class P { a: number; hidden: string; other = 3; constructor(a: number) { this.a = a; this.hidden = "h" + a; } }
const p = new P(1);
console.log(p.a);
console.log(p);
console.log(JSON.stringify(p), Object.keys(p).join(), Object.entries(p).length, "hidden" in p, Object.hasOwn(p, "hidden"), p.hasOwnProperty("other"));
class Q { a = 1; secret = { deep: [1, 2] }; }
const q = new Q(); console.log(q.a, Bun.inspect(q), structuredClone(q), { ...q }, Object.assign({}, q));
class R { a = 1; z = 2; }
const r = new R(); let n = 0; for (const k in r) n++; console.log(r.a, n, Reflect.ownKeys(r), Object.getOwnPropertyNames(r), Object.getOwnPropertyDescriptors(r));
class S { a = 1; w = 5; }
const s: any = new S(); const key = ["w", "a"][Date.now() > 0 ? 0 : 1]; console.log(s.a, s[key]);
class T { a = 1; v = 6; }
const { a, ...rest } = new T(); console.log(a, rest);
class U { a = 1; u = 7; }
console.log(Bun.deepEquals(new U(), { a: 1 }), Bun.deepEquals(new U(), { a: 1, u: 7 }), require("util").isDeepStrictEqual({ ...new U() }, { a: 1, u: 7 }));
const lit = { used: 1, unused: 2 }; console.log(lit.used, Object.values(lit));
//// for-in-typed-objects.ts
// `for..in` over typed objects: own then inherited keys, shadowing, non-enumerable keys, deletion during the loop, and absent fields.
interface Rec { a: number; b?: string; c?: boolean; d: number }
function keysOf(o: object): string { const out: string[] = []; for (const k in o) out.push(k); return out.join("") }
function keysOfAny(o: any): string { const out: string[] = []; for (const k in o) out.push(k); return out.join("") }
function at(o: Rec, k: string): string { return String((o as unknown as Record<string, unknown>)[k]) }
function pairs(o: Rec): string { const out: string[] = []; for (const k in o) out.push(k + "=" + at(o, k)); return out.join("&") }

const full: Rec = { a: 1, b: "b", c: true, d: 4 }
const sparse: Rec = { d: 4, a: 1 }
console.log(keysOf(full), keysOf(sparse), pairs(full), pairs(sparse), keysOf({}), keysOf([5, 6]), keysOfAny(full))

// Absent fields are not visited; explicit undefined is; late fields come last.
const explicit: Rec = { a: 1, b: undefined, d: 2 }
sparse.c = false
console.log(keysOf(explicit), pairs(explicit), keysOf(sparse), pairs(sparse))

// A key deleted before it is reached is not visited.
function deleting(o: Rec, victim: "b" | "c"): string { const out: string[] = []; for (const k in o) { out.push(k); delete o[victim] } return out.join("") + "/" + Object.keys(o).join("") }
console.log(deleting({ a: 1, b: "x", c: true, d: 2 }, "c"), deleting({ a: 1, b: "x", c: true, d: 2 }, "b"), deleting({ b: "x", a: 1, d: 2 }, "b"), deleting({ a: 1, d: 2 }, "c"))

// Values stored during the loop are seen when their key is reached.
function storing(o: Rec): string { const out: string[] = []; for (const k in o) { out.push(k + at(o, k)); o.d = 99; o.a = -1 } return out.join() }
console.log(storing({ a: 1, b: "x", d: 2 }), storing({ d: 2, a: 1 }))

// Inherited keys follow the own ones; an own key hides an inherited one, even when the own one is not enumerable.
const proto: Rec = { a: 10, b: "proto", d: 40 }
const child: any = Object.create(proto)
child.own = 1; child.b = "child"
console.log(keysOf(child), child.a, child.b, child.d, Object.keys(child).join(""))
Object.defineProperty(child, "d", { value: 5, enumerable: false, configurable: true, writable: true })
console.log(keysOf(child), child.d)
const grand: any = Object.create(child)
console.log(keysOf(grand), grand.a + grand.d)

// Class instances: fields of base and derived, no methods, no accessors.
class Base2 { p = 1; method() { return 0 } get acc() { return 0 } }
class Derived2 extends Base2 { q = 2; r?: number }
const inst = new Derived2()
console.log(keysOf(inst).replace("r", ""), keysOf(full), keysOf(sparse), keysOf({}))

// Indices first, symbols never, extras after the fields.
const dressed: Rec = { a: 1, d: 2 }
const anyDressed: any = dressed
dressed.b = "late"; anyDressed.x = 1; anyDressed[5] = 1; anyDressed[Symbol("s")] = 1; anyDressed[0] = 1
console.log(keysOf(dressed))

// Frozen.
const frozen: Rec = Object.freeze({ a: 1, b: "f", d: 2 })
console.log(keysOf(frozen), pairs(frozen))

// Objects from untyped code used as the type.
const parsed: Rec = JSON.parse('{"d":1,"a":2,"z":0,"1":3}')
console.log(keysOf(parsed), pairs(parsed), keysOf(Object.assign(Object.create(null), full)))

// null and undefined are looped over zero times; break, continue and a loop variable that is a field.
console.log(keysOfAny(null), keysOfAny(undefined))
const cursor: { key: string } = { key: "" }
let visited = ""
for (cursor.key in full) { if (cursor.key === "b") continue; if (cursor.key === "d") break; visited += cursor.key }
console.log(visited, cursor.key)

// Nested loops over the same object, and over many objects of several creation orders.
let nested = ""
for (const i in sparse) for (const j in sparse) nested += i + j + " "
const many: Rec[] = [full, sparse, explicit, { d: 0, c: true, a: 0 }, { a: 0, d: 0, b: "" }]
console.log(nested, many.map(keysOf).join())
//// for-in-via-any.ts
// `for..in` over values of type `any`: strings, numbers, objects, null, undefined and booleans.
function keysOfAny(o: any): string { const out: string[] = []; for (const k in o) out.push(k); return out.join("") }
console.log(keysOfAny("ab"), keysOfAny(5), keysOfAny({ x: 1 }), keysOfAny(null), keysOfAny(undefined), keysOfAny(true), keysOfAny(Symbol("s")), keysOfAny(10n))
//// forty-property-literals.ts
interface Wide {
  f0: number;
  f1: number;
  f2: number;
  f3?: number;
  f4: number;
  f5: number;
  f6: number;
  f7: number;
  f8: number;
  f9: number;
  f10?: number;
  f11: number;
  f12: number;
  f13: number;
  f14: number;
  f15: number;
  f16: number;
  f17?: number;
  f18: number;
  f19: number;
  f20: number;
  f21: number;
  f22: number;
  f23: number;
  f24?: number;
  f25: number;
  f26: number;
  f27: number;
  f28: number;
  f29: number;
  f30: number;
  f31?: number;
  f32: number;
  f33: number;
  f34: number;
  f35: number;
  f36: number;
  f37: number;
  f38?: number;
  f39: number;
