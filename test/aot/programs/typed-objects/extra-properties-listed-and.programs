// How the prototypes of generator functions and generator objects are reached.
const above = Object.getPrototypeOf
function keys(o: any): string { return o === null ? "null" : o === undefined ? "undefined" : o === Object.prototype ? "Object.prototype" : o === Function.prototype ? "Function.prototype" : "{" + Reflect.ownKeys(o).map(String).join() + "}" }
function chain(o: any): string { const out: string[] = []; for (let p = above(o); p !== null; p = above(p)) out.push(keys(p)); return out.join(" > ") }
function* generator() { yield 1 }
async function* asyncGenerator() { yield 1 }
async function asyncFunction() {}
console.log("generator()", chain(generator()))
console.log("generator", chain(generator), keys(generator))
console.log("generator.prototype", keys(generator.prototype), above(generator()) === generator.prototype)
console.log("asyncGenerator()", chain(asyncGenerator()))
console.log("asyncGenerator", chain(asyncGenerator), keys(asyncGenerator))
console.log("asyncGenerator.prototype", keys(asyncGenerator.prototype), above(asyncGenerator()) === asyncGenerator.prototype)
console.log("asyncFunction", chain(asyncFunction), keys(asyncFunction), keys((asyncFunction as any).prototype))
console.log("instanceof", generator() instanceof generator, asyncGenerator() instanceof asyncGenerator)
//// generic-builder.ts
// A generic builder merges defaults with a definition and casts the result to a type that depends on the type parameter.
const DEFAULTS = { isActive: () => true, isSafe: (_input?: unknown) => false, isPassive: (_input?: unknown) => false, label: (_input?: unknown) => "" };
type Defaults = typeof DEFAULTS;
type Keys = keyof Defaults;
interface AnyDef { name: string; create(deps: number): { run(): string }; isActive?(): boolean; isSafe?(input: unknown): boolean; isPassive?(input: unknown): boolean; label?(input: unknown): string }
type Built<D> = Omit<D, Keys | "create"> & { [K in Keys]-?: K extends keyof D ? (undefined extends D[K] ? Defaults[K] : D[K]) : Defaults[K] } & { run(): string };
interface Plugin { name: string; isActive(): boolean; isSafe(input: unknown): boolean; isPassive(input: unknown): boolean; label(input: unknown): string; run(): string }
function build<D extends AnyDef>(def: D): Built<D> {
  const create = def.create;
  const facing = { run: () => create.call(def, 1).run() };
  const built: Plugin = Object.assign(Object.defineProperties({ ...DEFAULTS, label: () => def.name }, Object.getOwnPropertyDescriptors(def)), facing) as unknown as Plugin;
  return built as unknown as Built<D>;
}
export const first = build({ name: "first", create: () => ({ run: () => "ran first" }), isSafe: () => true as const });
export const second = build({ name: "second", create: () => ({ run: () => "ran second" }), label: (input: unknown) => String(input) });
export const third = build({ name: "third", create: () => ({ run: () => "ran third" }) });
console.log(first.name, first.isSafe(), first.isActive(), first.run(), second.label(7), second.isSafe(1), third.isPassive(), third.run());
//// generic-class-with-objects-and-numbers.ts
// One generic class holds objects in some instances and numbers, strings, functions, arrays or nothing in others. Each instance gives back exactly what was stored in it, whatever the other instances hold, and a generic class beside it that only ever holds objects is not disturbed.
////= Item

////= lines-3	Special	Item	extra	true

class Box<T> {
  value: T;

  constructor(value: T) {
    this.value = value;
  }

  get(): T {
    return this.value;
  }

  replace(value: T): T {
    const previous = this.value;
    this.value = value;
    return previous;
  }

  map<U>(change: (value: T) => U): Box<U> {
    return new Box(change(this.value));
  }
}

class Shelf<T extends Item> {
  top: T;
  below: T | undefined;

  constructor(top: T) {
    this.top = top;
    this.below = undefined;
  }

  push(item: T): void {
    this.below = this.top;
    this.top = item;
  }

  names(): string {
    return this.top.name + "/" + (this.below === undefined ? "-" : this.below.name);
  }
}

function wrap<T>(value: T): Box<T> {
  return new Box(value);
}

function unwrap<T>(box: Box<T>): T {
  return box.value;
}

function pick<A, B>(useFirst: boolean, first: A, second: B): A | B {
  return useFirst ? first : second;
}

function one(): number {
  return 1;
}

function show(value: unknown): string {
  if (typeof value === "number") return Object.is(value, -0) ? "-0" : String(value);
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "bigint") return value + "n";
  if (typeof value === "symbol") return "symbol " + value.description;
  if (typeof value === "function") return "function " + value.name;
  if (value instanceof Item) return (value instanceof Special ? "Special " : "Item ") + value.name + " " + value.count;
  if (value instanceof Box) return "Box(" + show(value.value) + ")";
  if (Array.isArray(value)) return "[" + value.map(element => show(element)).join() + "]";
  return String(value);
}

function nameOf(box: Box<Item>): string {
  return box.value.name;
}

function double(box: Box<number>): number {
  return box.value * 2;
}

function shout(box: Box<string>): string {
  return box.value + "!";
}

function call(box: Box<() => number>): number {
  return box.value() + box.get()();
}

function lengthOf(box: Box<number[]>): number {
  return box.value.length;
}

function weigh(box: Box<Item | number>): number {
  const value = box.value;
  return typeof value === "number" ? value : value.count;
}

const item = new Item("item", 3);
const special = new Special("special", 4);
const ofItem = new Box(item);
const ofNumber = new Box(1.5);
const ofString = new Box("text");
const ofFunction = new Box(one);
const ofArray = new Box([1, 2, 3]);
console.log(nameOf(ofItem), double(ofNumber), shout(ofString), call(ofFunction), lengthOf(ofArray));
console.log(nameOf(wrap(item)), double(wrap(-3)), shout(wrap("")), call(wrap(one)), lengthOf(wrap<number[]>([])));

const numbers = [0, -0, 1, -1, 0.5, 2147483647, 2147483648, -2147483648, -2147483649, 4294967296, 1e21, Infinity, -Infinity, NaN];
console.log(numbers.map(n => show(new Box(n).value)).join());
console.log(numbers.map(n => show(wrap(n).get())).join());
console.log(numbers.map(n => show(ofNumber.replace(n))).join(), show(ofNumber.value));
console.log(numbers.map(n => show(double(wrap(n)))).join());

const everything: unknown[] = [item, 7, "seven", special, undefined, null, true, false, 10n, Symbol("s"), one, [item, 1], ofItem, -0];
const boxes: Box<unknown>[] = everything.map(value => wrap(value));
console.log(boxes.map(box => show(unwrap(box))).join(" | "));
console.log(boxes.map(box => show(box.get())).join(" | "));
console.log(boxes.map(box => Object.keys(box).join() + ":" + typeof box.value).join(" "));
console.log(boxes.every((box, index) => Object.is(box.value, everything[index])), boxes.every(box => box instanceof Box));

const reused = new Box<unknown>(item);
console.log(everything.map(value => show(reused.replace(value))).join(" | "), "|", show(reused.value));

const either = new Box<Item | number>(item);
let weight = 0;
for (let i = 0; i < 1000; i++) {
  weight += weigh(either);
  either.value = i % 3 === 0 ? i + 0.5 : i % 3 === 1 ? special : item;
}
console.log(weight, show(either.value), show(either.replace(2 ** 31)), show(either.get()));

console.log(show(ofItem.map(value => value.count)), show(ofItem.map(value => value.count).map(count => "n" + count)));
console.log(show(ofNumber.map(n => new Item("made", n))), show(ofString.map(text => text.length).map(length => new Special("long", length)).map(made => made)));
console.log(nameOf(ofNumber.map(n => new Item("from a number", n))), double(ofItem.map(value => value.count)));

const nested = new Box(new Box(2.5));
const nestedItem = wrap(wrap(special));
console.log(show(nested), double(nested.value), show(nestedItem), nameOf(nestedItem.get()), nested.value.replace(-0), show(nested));

console.log(show(pick(true, item, 1)), show(pick(false, item, 1)), show(pick(true, 2, special)), show(pick(false, "a", undefined)));

const shelf = new Shelf(item);
const specials = new Shelf<Special>(special);
console.log(shelf.names(), specials.names());
shelf.push(special);
specials.push(new Special("another", 5));
console.log(shelf.names(), specials.names(), shelf.top === special, shelf.below === item, specials.top.extra, Object.keys(shelf).join());

console.log(JSON.stringify([ofItem, ofNumber, ofString, ofArray, nested, either, new Box(undefined), new Box(null)]));
console.log(nameOf(ofItem), item.name, item.count, special.count, ofItem.value === item, show(ofFunction.value), show(ofArray.value));
//// generic-constraints.ts
// Type parameters with constraints, `keyof` and indexed access types: the function body knows only the constraint, and the objects have many types.
interface HasId { id: number }
interface User extends HasId { login: string; admin?: boolean }
type Product = { price: number; id: number; title: string }
class Order implements HasId { id: number; lines: number[] = []; constructor(id: number) { this.id = id } total() { return this.lines.reduce((x, y) => x + y, 0) } }
function show(o: object): string { return Object.keys(o).join() + " " + JSON.stringify(o) }
function idOf<T extends HasId>(x: T): number { return x.id }
function maxById<T extends HasId>(xs: T[]): T | undefined { let best: T | undefined; for (const x of xs) if (best === undefined || x.id > best.id) best = x; return best }
function renumber<T extends HasId>(x: T, id: number): T { x.id = id; return x }
function get<T, K extends keyof T>(o: T, k: K): T[K] { return o[k] }
function set<T, K extends keyof T>(o: T, k: K, v: T[K]): void { o[k] = v }
function pluck<T, K extends keyof T>(xs: T[], k: K): T[K][] { return xs.map(x => x[k]) }
function pick<T extends object, K extends keyof T>(o: T, ...ks: K[]): Pick<T, K> { const out = {} as Pick<T, K>; for (const k of ks) out[k] = o[k]; return out }
function withDefaults<T extends object>(given: Partial<T>, defaults: T): T { return { ...defaults, ...given } }
function update<T extends HasId>(x: T, patch: Partial<T>): T { return Object.assign(x, patch) }
function clone<T extends object>(o: T): T { return Object.assign(Object.create(Object.getPrototypeOf(o)), o) }
function keysOf<T extends object>(o: T): (keyof T)[] { return Object.keys(o) as (keyof T)[] }
function create<T extends HasId>(make: (id: number) => T, id: number): T { const made = make(id); made.id += 1000; return made }
const user: User = { id: 1, login: "u" }
const admin: User = { admin: true, login: "a", id: 2 }
const product: Product = { price: 9.5, id: 3, title: "p" }
const order = new Order(4)
order.lines.push(1, 2.5)
const bare: HasId = { id: 5 }
const parsed: User = JSON.parse('{"login":"j","id":6}')
console.log(idOf(user), idOf(admin), idOf(product), idOf(order), idOf(bare), idOf(parsed), idOf({ id: -0, more: 1 }))
console.log(maxById([user, admin, parsed])?.login, maxById([product])?.title, maxById<HasId>([order, bare, user])?.id, maxById<User>([]), maxById([order, new Order(0)])?.total())
console.log(renumber(user, 10) === user, user.id, renumber(order, 40).total(), order.id, renumber(parsed, 60).login, show(parsed))

// Keys as constants.
console.log(get(user, "login") + "!", get(user, "id") + 1, get(user, "admin"), get(admin, "admin"), get(product, "price") * 2, get(order, "lines").length, get(order, "total").call(order), get([7, 8], 1), get("str", "length"), get({ "a b": 1 }, "a b"))
set(user, "login", "changed"); set(user, "admin", false); set(product, "price", -0); set(order, "id", 41); set(parsed, "admin", true)
console.log(show(user), Object.is(product.price, -0), order.id, show(parsed))

// Keys as values.
const userKeys: (keyof User)[] = ["admin", "id", "login"]
console.log(userKeys.map(k => String(get(user, k))).join(), userKeys.map(k => String(get(admin, k))).join(), userKeys.map(k => String(get(parsed, k))).join(), userKeys.map(k => k in bare).join())
console.log(keysOf(product).map(k => k + "=" + get(product, k)).join("&"), keysOf(order).join(), keysOf(admin).join())
console.log(pluck([user, admin, parsed], "login").join(), pluck([user, admin, parsed], "admin").map(String).join(), pluck([product], "price").map(p => p + 1).join(), pluck<HasId, "id">([user, product, order, bare], "id").join())
function copyField<T, K extends keyof T>(from: T, to: T, k: K): void { to[k] = from[k] }
for (const k of userKeys) copyField(admin, user, k)
console.log(show(user), show(admin))

// Objects that are created empty and filled by key.
const picked = pick(product, "title", "id")
const pickedUser = pick(admin, "admin")
const pickedOrder = pick(order, "lines", "total", "id")
console.log(show(picked), picked.title.length, picked.id + 1, show(pickedUser), pickedUser.admin, show(pickedOrder), pickedOrder.lines === order.lines, pickedOrder.total.call(order), show(pick(bare)))

console.log(show(withDefaults<User>({ login: "given" }, { id: 0, login: "default", admin: false })), show(withDefaults<Product>({}, product)), show(withDefaults<User>(pick(admin, "admin", "id"), user)))
console.log(show(update(bare, { id: 50 })), bare.id, show(update(user, { admin: undefined, login: "patched" })), "admin" in user, update(order, { lines: [9] }).total(), update(product, {}) === product)
// clone(order): see type-rules/object-create-class-prototype-passes-for-the-class.
console.log(show(clone(admin)), clone(admin) === admin, show(clone(parsed)))
console.log(show(create(id => ({ id, fresh: true }), 1)), create(id => new Order(id), 2).id, create<User>(id => ({ login: "made", id }), 3).login)

// A constraint with an optional field and one with a method.
function tagOf<T extends { tag?: string }>(x: T): string { return x.tag ?? "untagged" }
function run<T extends { run(): number }>(x: T): number { return x.run() + 1 }
class Runner { base = 1; run() { return this.base * 10 } }
console.log(tagOf({}), tagOf({ tag: "t" }), tagOf({ tag: undefined }), tagOf({ tag: "", other: 1 }), run(new Runner()), run({ run: () => 1 }), run({ base: 5, run(this: { base: number }) { return this.base } }))

let total = 0
const everyone: HasId[] = [user, admin, product, order, bare, parsed]
for (let i = 0; i < 5000; i++) { const x = everyone[i % everyone.length]; total += idOf(x) + get(x, "id") + (maxById([x, bare])?.id ?? 0) }
console.log(total)
//// generic-deep-merge-via-variables.ts
// A deep merge written once for all types, step by step: what it makes has every member its result type names.
interface Inner { n: number; tags: string[] }
interface R { a: number; b: string; inner: Inner }
function merge<T extends { inner: object }, U extends { inner: object }>(x: T, y: U): T & U { const inner = { ...x.inner, ...y.inner }; const merged = { ...x, ...y, inner }; return merged as T & U }
for (let round = 0; round < 3; round++) {
  const r: R = { a: round, b: "x", inner: { n: 1, tags: ["t"] } };
  const w = merge(r, { inner: { n: 100 + round } });
  console.log(w.a, w.b, w.inner.n, w.inner.tags.join(), r.inner.n);
}
//// generic-factory-helpers.ts
// A chain of generic factory helpers, each storing through `Mutable<T>`, in the style of the TypeScript compiler's node factory.
enum SyntaxKind { Identifier, StringLiteral, Parameter, Block, PropertyDeclaration, MethodDeclaration, FunctionDeclaration, ClassDeclaration, QuestionToken, ExclamationToken }
enum ModifierFlags { None = 0, Export = 1 << 0, Static = 1 << 1, Readonly = 1 << 2, Async = 1 << 3 }
type Mutable<T extends object> = { -readonly [K in keyof T]: T[K] }
interface AstNode { readonly kind: SyntaxKind; readonly pos: number; readonly end: number; transformFlags: number }
interface Token<K extends SyntaxKind> extends AstNode { readonly kind: K }
interface Identifier extends AstNode { readonly kind: SyntaxKind.Identifier; readonly text: string }
interface StringLiteral extends AstNode { readonly kind: SyntaxKind.StringLiteral; readonly text: string; readonly singleQuote?: boolean }
type PropertyName = Identifier | StringLiteral
interface Block extends AstNode { readonly kind: SyntaxKind.Block; readonly statements: readonly AstNode[] }
interface Declaration extends AstNode { symbol: object | undefined; localSymbol: object | undefined }
interface NamedDeclaration extends Declaration { readonly name?: PropertyName; readonly modifiers: ModifierFlags }
interface ParameterDeclaration extends NamedDeclaration { readonly kind: SyntaxKind.Parameter; readonly name: Identifier }
interface FunctionLikeDeclaration extends NamedDeclaration { readonly parameters: readonly ParameterDeclaration[]; readonly body?: Block; readonly typeArguments?: readonly string[] }
interface PropertyDeclaration extends NamedDeclaration { readonly kind: SyntaxKind.PropertyDeclaration; readonly name: PropertyName; readonly questionToken?: Token<SyntaxKind.QuestionToken>; readonly exclamationToken?: Token<SyntaxKind.ExclamationToken>; readonly initializer?: AstNode }
interface MethodDeclaration extends FunctionLikeDeclaration { readonly kind: SyntaxKind.MethodDeclaration; readonly name: PropertyName; readonly questionToken?: Token<SyntaxKind.QuestionToken> }
interface FunctionDeclaration extends FunctionLikeDeclaration { readonly kind: SyntaxKind.FunctionDeclaration; readonly name?: Identifier }
type ClassMember = PropertyDeclaration | MethodDeclaration
interface ClassDeclaration extends NamedDeclaration { readonly kind: SyntaxKind.ClassDeclaration; readonly name?: Identifier; readonly members: readonly ClassMember[] }

function AstNode(this: Mutable<AstNode>, kind: SyntaxKind, pos: number, end: number) { this.pos = pos; this.end = end; this.kind = kind; this.transformFlags = 0 }
const objectAllocator = { getNodeConstructor: () => AstNode as any as new (kind: SyntaxKind, pos: number, end: number) => AstNode }
function createBaseNode<T extends AstNode>(kind: T["kind"]) { return new (objectAllocator.getNodeConstructor())(kind, -1, -1) as Mutable<T> }
function createBaseDeclaration<T extends Declaration>(kind: T["kind"]) {
  const node = createBaseNode(kind) as Mutable<T>
  node.symbol = undefined
  node.localSymbol = undefined
  return node
}
function createBaseNamedDeclaration<T extends NamedDeclaration>(kind: T["kind"], modifiers: ModifierFlags, name: PropertyName | string | undefined) {
  const node = createBaseDeclaration<T>(kind), resolved = asName(name)
  node.modifiers = modifiers
  node.name = resolved
  if (resolved) node.transformFlags |= resolved.transformFlags
  if (modifiers & ModifierFlags.Async) node.transformFlags |= 32
  return node
}
function createBaseFunctionLike<T extends FunctionLikeDeclaration>(kind: T["kind"], modifiers: ModifierFlags, name: PropertyName | string | undefined, parameters: readonly ParameterDeclaration[], body: Block | undefined) {
  const node = createBaseNamedDeclaration<T>(kind, modifiers, name)
  node.parameters = parameters
  node.body = body
  for (const p of parameters) node.transformFlags |= p.transformFlags
  if (!body) node.transformFlags |= 64
  node.typeArguments = undefined
  return node
}
function finishNode<T extends AstNode>(node: Mutable<T>, pos: number, end: number): T { node.pos = pos; node.end = end; return node }
function cloneNode<T extends AstNode>(node: T): T {
  const clone = createBaseNode<T>(node.kind)
  for (const key in node) { if (Object.hasOwn(clone, key) || !Object.hasOwn(node, key)) continue; clone[key] = node[key] }
  clone.transformFlags = node.transformFlags
  return clone
}
function createToken<K extends SyntaxKind>(kind: K): Token<K> { return createBaseNode<Token<K>>(kind) }
function createIdentifier(text: string): Identifier { const node = createBaseNode<Identifier>(SyntaxKind.Identifier); node.text = text; node.transformFlags = 1; return node }
function createStringLiteral(text: string, singleQuote?: boolean): StringLiteral { const node = createBaseNode<StringLiteral>(SyntaxKind.StringLiteral); node.text = text; node.singleQuote = singleQuote; node.transformFlags = 2; return node }
function asName(name: PropertyName | string | undefined): PropertyName | undefined { return typeof name === "string" ? createIdentifier(name) : name }
function createBlock(statements: readonly AstNode[]): Block { const node = createBaseNode<Block>(SyntaxKind.Block); node.statements = statements; return node }
function createParameter(name: string): ParameterDeclaration { const node = createBaseNamedDeclaration<ParameterDeclaration>(SyntaxKind.Parameter, ModifierFlags.None, name); node.transformFlags |= 4; return node }
function createProperty(modifiers: ModifierFlags, name: PropertyName | string, mark?: Token<SyntaxKind.QuestionToken> | Token<SyntaxKind.ExclamationToken>, initializer?: AstNode): PropertyDeclaration {
  const node = createBaseNamedDeclaration<PropertyDeclaration>(SyntaxKind.PropertyDeclaration, modifiers, name)
  node.questionToken = mark && mark.kind === SyntaxKind.QuestionToken ? mark : undefined
  node.exclamationToken = mark && mark.kind === SyntaxKind.ExclamationToken ? mark : undefined
  node.initializer = initializer
  return node
}
function createMethod(modifiers: ModifierFlags, name: PropertyName | string, isOptional: boolean, parameters: readonly ParameterDeclaration[], body?: Block): MethodDeclaration {
  const node = createBaseFunctionLike<MethodDeclaration>(SyntaxKind.MethodDeclaration, modifiers, name, parameters, body)
  if (isOptional) node.questionToken = createToken(SyntaxKind.QuestionToken)
  return node
}
function createFunction(modifiers: ModifierFlags, name: string | undefined, parameters: readonly ParameterDeclaration[], body?: Block): FunctionDeclaration {
  return createBaseFunctionLike<FunctionDeclaration>(SyntaxKind.FunctionDeclaration, modifiers, name, parameters, body)
}
// T is a union here: which member the object is comes out only after the helper has returned.
function createMember(isMethod: boolean, name: string): ClassMember {
  const node = createBaseNamedDeclaration<ClassMember>(isMethod ? SyntaxKind.MethodDeclaration : SyntaxKind.PropertyDeclaration, ModifierFlags.Static, name)
  if (node.kind === SyntaxKind.MethodDeclaration) { node.parameters = []; node.body = createBlock([]) } else node.initializer = createStringLiteral(name, true)
  return node
}
function createClass(name: string | undefined, members: readonly ClassMember[]): ClassDeclaration {
  const node = createBaseNamedDeclaration<ClassDeclaration>(SyntaxKind.ClassDeclaration, ModifierFlags.Export, name)
  node.members = members
  for (const m of members) node.transformFlags |= m.transformFlags
  return node
}
function keysOf(o: object): string { return SyntaxKind[(o as AstNode).kind] + ":" + Object.keys(o).join() }
function nameOf(d: NamedDeclaration): string { return d.name ? d.name.text + (d.name.kind === SyntaxKind.StringLiteral ? "'" + d.name.singleQuote : "") : "(anonymous)" }
function arity(f: FunctionLikeDeclaration): string { return nameOf(f) + "/" + f.parameters.length + (f.body ? "{" + f.body.statements.length + "}" : ";") + f.modifiers + ("typeArguments" in f) + f.typeArguments }
function isFunctionLike(n: AstNode): n is FunctionLikeDeclaration { return n.kind === SyntaxKind.MethodDeclaration || n.kind === SyntaxKind.FunctionDeclaration }

const members = [
  createProperty(ModifierFlags.Readonly, "a", createToken(SyntaxKind.QuestionToken)), createProperty(ModifierFlags.None, createStringLiteral("b c"), createToken(SyntaxKind.ExclamationToken), createIdentifier("init")),
  createMethod(ModifierFlags.Async | ModifierFlags.Static, "m", true, [createParameter("p"), createParameter("q")], createBlock([createIdentifier("s")])), createMethod(ModifierFlags.None, createStringLiteral("n", true), false, []),
  createMember(true, "um"), createMember(false, "up"),
]
const klass = finishNode(createClass("K", members) as Mutable<ClassDeclaration>, 10, 90), anonymous = createClass(undefined, [])
const fns = [createFunction(ModifierFlags.Export, "f", [createParameter("x")], createBlock([])), createFunction(ModifierFlags.None, undefined, [])]
console.log(members.map(keysOf).join("\n"))
console.log(keysOf(klass), keysOf(anonymous), fns.map(keysOf).join(" "), keysOf(createParameter("z")), keysOf(createToken(SyntaxKind.QuestionToken)), keysOf(createStringLiteral("s")))
console.log([klass, anonymous, ...members, ...fns].map(nameOf).join(), ([...members, ...fns] as AstNode[]).filter(isFunctionLike).map(arity).join(" "), klass.pos, klass.end, anonymous.pos, klass.transformFlags, members.map(m => m.transformFlags).join())
console.log(members.map(m => (m.questionToken ? "?" : "") + ("questionToken" in m) + (m.kind === SyntaxKind.PropertyDeclaration ? (m.exclamationToken ? "!" : "") + (m.initializer ? SyntaxKind[m.initializer.kind] : "-") : "")).join(), "name" in anonymous, anonymous.name, "name" in fns[1], fns[1].symbol, "localSymbol" in fns[1])
const copies = [...members, ...fns, klass].map(n => cloneNode<NamedDeclaration>(n))
console.log(copies.map(keysOf).join("\n"))
console.log(copies.map((c, i) => c !== [...members, ...fns, klass][i] && c.name === [...members, ...fns, klass][i].name).join(), copies.map(c => c.pos + ":" + c.transformFlags + ":" + c.modifiers).join(), (copies[8] as ClassDeclaration).members === members)
let bits = 0, chars = 0
for (let i = 0; i < 8000; i++) {
  const d: NamedDeclaration = i % 4 === 0 ? createMember((i & 4) !== 0, "k" + (i & 15)) : i % 4 === 1 ? createFunction(i & 15, i & 16 ? "g" : undefined, []) : i % 4 === 2 ? createParameter("p" + i) : cloneNode(members[i % members.length])
  bits += d.transformFlags + d.modifiers; chars += nameOf(d).length + (isFunctionLike(d) ? d.parameters.length + 1 : 0)
}
console.log(bits, chars)
//// generic-forwarder-record-to-callback.ts
// A generic forwarder builds `{ ...opts, context, may } as P` (P extends Base) and passes it to a function it received as an
// argument. The function's parameter is a wider record type, named or written in place and destructured.
type Ctx = { id: number; round?: number };
type Base = { context: Ctx; may?: (name: string) => boolean };
type ResumeArgs = { context: Ctx; may?: (name: string) => boolean; agent: string; reply: string };
let last: unknown = null;
function inner<P extends Base, R>(engine: (opts: P) => R, all: P): R {
  last = all;
  return engine(all);
}
function run<P extends Base, R>(context: Ctx, engine: (opts: P) => R, opts: Omit<P, keyof Base>): R {
  return inner(engine, { ...opts, context, may: (n: string) => n !== "no" } as P);
}
function launch({ input, context, may, message, timing, parent, depth }: { context: Ctx; may?: (name: string) => boolean; input: string; message: string; timing?: number; parent?: string; depth: number }): string {
  return [input, context.id, may?.("x"), message, timing ?? "-", parent ?? "-", depth].join(" ");
}
function resume(args: ResumeArgs): string {
  args.reply += "!";
  return [args.agent, args.context.id, args.may?.("no"), args.reply, (args as unknown) === last].join(" ");
}
async function later({ input, context }: { context: Ctx; may?: (name: string) => boolean; input: string }): Promise<string> {
  await null;
  return input + context.id;
}
console.log(run({ id: 1 }, launch, { input: "i", message: "m", timing: 3, depth: 1 }));
console.log(run({ id: 2, round: 4 }, launch, { input: "j", message: "n", depth: 2 }));
console.log(run({ id: 3 }, resume, { agent: "a", reply: "r" }), (last as ResumeArgs).reply);
console.log(await run({ id: 4 }, later, { input: "k" }));
