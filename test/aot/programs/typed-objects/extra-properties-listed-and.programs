        declareSymbol(f, f.name.text, SymbolFlags.Function); bind(f.name, f); enter(f); f.flowNode = savedFlow
        currentFlow = { flags: FlowFlags.Start | FlowFlags.Container, id: ++flowCount, node: f, antecedent: undefined }
        bind(f.body, f)
