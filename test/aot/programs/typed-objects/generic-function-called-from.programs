function inLoop(values: any[]) {
  let known = 0, «1» = 0;
  for (let i = 0; i < values.length; i++) {
    if (values[i] instanceof Known) known++;
    if (values[i] instanceof «2») «1»++;
  }
  return known + "/" + «1»;
}
