//// generic-helper-returns-as-t.ts
// A generic helper fills an object key by key and returns it with a single `as T`; the caller stores the result in a typed field.
type WrapMethod = (f: (...args: never[]) => unknown) => (...args: never[]) => unknown;
function seal<T extends object>(x: T): T { return Object.freeze(x); }
function wrapAll<T extends object>(noun: T, wrapMethod: WrapMethod): T {
  const wrapped: Record<string, unknown> = {};
  for (const key of Object.keys(noun)) {
    const member: unknown = (noun as Record<string, unknown>)[key];
    wrapped[key] = typeof member === "function" ? wrapMethod(member as (...args: never[]) => unknown) : member;
  }
  return seal(wrapped) as T;
}
function uiOf(name: string) { return seal({ notice(text: string) { return name + ":" + text; }, size: 3, resolve(n: number) { return n * 2; } }); }
function modelOf() { return seal({ ask(q: string) { return q.length; } }); }
interface Nouns { ui: ReturnType<typeof uiOf>; model: ReturnType<typeof modelOf> }
function nouns(name: string, wrapMethod: WrapMethod): Nouns {
  const wrap = <T extends object>(noun: T): T => wrapAll(noun, wrapMethod);
  return { ui: wrap(uiOf(name)), model: wrap(modelOf()) };
}
let calls = 0;
const n = nouns("p", f => (...a: never[]) => { calls++; return f(...a); });
console.log(n.ui.notice("hi"), n.ui.size, n.ui.resolve(4), n.model.ask("abc"), calls, Object.isFrozen(n.ui), Object.keys(n.ui).join());
//// generic-mapped-type-table.ts
// A table typed by a mapped type over a union of names is filled by spreading the results of a generic helper.
type Name = "a.one" | "a.two" | "b.one" | "b.two" | "c.one";
interface Arguments { "a.one": { n: number }; "a.two": { s: string }; "b.one": { n: number; s: string }; "b.two": {}; "c.one": { flag: boolean } }
interface Entry<E extends Name> { readonly key: E; readonly kind: "plain" | "checked" | "own"; check(args: Arguments[E]): boolean }
function plainEntry<E extends Name>(key: E): Entry<E> { return { key, kind: "plain", check: () => true }; }
function checkedEntry<E extends Name>(key: E): Entry<E> { return { key, kind: "checked", check: args => args !== undefined }; }
function tableOf<K extends Name>(names: readonly K[], make: <E extends K>(key: E) => Entry<E>): { readonly [E in K]: Entry<E> } {
  const table: { [name: string]: Entry<K> } = {};
  for (const name of names) table[name] = make(name);
  return table as { readonly [E in K]: Entry<E> };
}
const PLAIN = ["a.one", "a.two"] as const;
const CHECKED = ["b.one", "b.two"] as const;
const OWN: Entry<"c.one"> = { key: "c.one", kind: "own", check: args => args.flag };
export const TABLE: { readonly [E in Name]: Entry<E> } = {
  ...tableOf(PLAIN, plainEntry),
  ...tableOf(CHECKED, checkedEntry),
  "c.one": OWN,
};
function entryOf<E extends Name>(key: E): Entry<E> { return TABLE[key]; }
console.log(Object.keys(TABLE).join(), TABLE["a.two"].key, TABLE["b.one"].kind, entryOf("c.one").check({ flag: true }), entryOf("a.one").check({ n: 1 }));
//// generic-record-unrelated-instantiations.ts
// One object made by generic code is read through two instantiations of the same generic record, neither of which is narrower than the other.
// The value fits both, so both reads are accepted, in either order.
////= row-2

type Served<Cause, Result> = { cause: Cause; result: Result; number: number };
type ByCause = Served<"poll", string>;
type ByResult = Served<string, "status">;

function nested<C, R>(cause: C, result: R): { served: Served<C, R>; n: number } {
  return { served: { cause, result, number: 2 }, n: 0 };
}
const useCause = (s: ByCause): string => s.cause + ":" + s.result.length + s.number;
const useResult = (s: ByResult): string => s.cause.length + ":" + s.result + s.number;

row("by cause, then by result", () => {
  const u = nested<"poll", "status">("poll", "status");
  const a: { served: ByCause } = u, b: { served: ByResult } = u;
  return [useCause(a.served), useResult(b.served)];
});
row("by result, then by cause", () => {
  const u = nested<"poll", "status">("poll", "status");
  const a: { served: ByCause } = u, b: { served: ByResult } = u;
  return [useResult(b.served), useCause(a.served)];
});
row("back and forth on the same object", () => {
  const u = nested<"poll", "status">("poll", "status");
  const a: { served: ByCause } = u, b: { served: ByResult } = u;
  return [useCause(a.served), useResult(b.served), useCause(a.served), useResult(b.served), a.served === (b.served as unknown), Object.keys(u.served).join()];
});
row("a store through one is seen through the other", () => {
  const u = nested<"poll", "status">("poll", "status");
  const a: { served: ByCause } = u, b: { served: ByResult } = u;
  a.served.number = 7;
  b.served.number += 1;
  return [useCause(a.served), useResult(b.served), u.served.number];
});
row("in a loop", () => {
  const out: string[] = [];
  for (let i = 0; i < 4; i++) {
    const u = nested<"poll", "status">("poll", "status");
    const a: { served: ByCause } = u, b: { served: ByResult } = u;
    out.push(i % 2 ? useCause(a.served) + useResult(b.served) : useResult(b.served) + useCause(a.served));
  }
  return out;
});
row("only by cause", () => {
  const u = nested<"poll", string>("poll", "anything");
  const a: { served: ByCause } = u;
  return [useCause(a.served), useCause(a.served)];
});
//// generic-record-wider-then-narrower.ts
// One object made by generic code is read through several instantiations of the same generic record.
// Whatever order the reads come in, a value that fits every one of those types is accepted by all of them.
////= row-2

type Served<Cause, Result> = { cause: Cause; result: Result; number: number };
type NearCause = "send" | "poll";
type NearResult = "status" | "not_found";
type NearServed = Served<NearCause, NearResult>;
type One = Served<"poll", "status">;
type Wide = Served<string, string>;

function nested<C, R>(cause: C, result: R): { served: Served<C, R>; n: number } {
  return { served: { cause, result, number: 2 }, n: 0 };
}
const useOne = (s: One): string => s.cause + s.result + s.number;
const useNear = (s: NearServed): string => s.cause.toUpperCase() + s.result.length + s.number;
const useWide = (s: Wide): string => s.cause + "/" + s.result + "/" + s.number;

row("narrowest first", () => {
  const u = nested<"poll", "status">("poll", "status");
  const one: { served: One } = u, near: { served: NearServed } = u, wide: { served: Wide } = u;
  return [useOne(one.served), useNear(near.served), useWide(wide.served)];
});
row("widest first", () => {
  const u = nested<"poll", "status">("poll", "status");
  const one: { served: One } = u, near: { served: NearServed } = u, wide: { served: Wide } = u;
  return [useWide(wide.served), useNear(near.served), useOne(one.served)];
});
row("middle, then narrowest", () => {
  const u = nested<"poll", "status">("poll", "status");
  const one: { served: One } = u, near: { served: NearServed } = u;
  return [useNear(near.served), useOne(one.served)];
});
row("middle, narrowest, middle, widest", () => {
  const u = nested<"poll", "status">("poll", "status");
  const one: { served: One } = u, near: { served: NearServed } = u, wide: { served: Wide } = u;
  return [useNear(near.served), useOne(one.served), useNear(near.served), useWide(wide.served)];
});
row("it is the same object every time", () => {
  const u = nested<"poll", "status">("poll", "status");
  const one: { served: One } = u, near: { served: NearServed } = u, wide: { served: Wide } = u;
  const first = wide.served, second = near.served, third = one.served;
  return [first === second, second === third, u.served === third, Object.keys(third).join()];
});
row("a store through the middle type is seen through the others", () => {
  const u = nested<"poll", "status">("poll", "status");
  const one: { served: One } = u, near: { served: NearServed } = u, wide: { served: Wide } = u;
  near.served.number = 5;
  one.served.number += 1;
  return [useWide(wide.served), useNear(near.served), useOne(one.served)];
});
row("in a loop", () => {
  const out: string[] = [];
  for (let i = 0; i < 3; i++) {
    const u = nested<"poll", "status">("poll", "status");
    const one: { served: One } = u, near: { served: NearServed } = u, wide: { served: Wide } = u;
    out.push(i % 2 ? useNear(near.served) + useOne(one.served) : useWide(wide.served) + useNear(near.served) + useOne(one.served));
  }
  return out;
});
row("another value stays the middle type", () => {
  const u = nested<NearCause, NearResult>("send", "not_found");
  const near: { served: NearServed } = u, wide: { served: Wide } = u;
  return [useWide(wide.served), useNear(near.served), useWide(wide.served)];
});
//// generic-spread-after-named-property.ts
// What a generic function makes with a spread of its parameter is one object, wherever the literal stands: a store through one name is seen through the other. One place a program: another place in the same program may open the types to it.
interface R { a: number; b: string }
const kept: { g: number }[] = [];
function id<U>(u: U): U { return u }
function wide<T extends object>(r: T, i: number): T & { g: number } { const made = id({ g: i, ...r }); kept.push(made); return made }
