const three = (): Three => ({ accept: "*/*", "content-type": "text/plain", "x-id": "1" });
show("new Headers(typed)", () => list(new Headers(three())));
show("new Headers(a named constant)", () => { const headers = { "x-b": "2", "x-a": "1" }; return list(new Headers(headers)); });
show("new Response(body, { headers })", () => { const headers = { "content-type": "application/json", "cache-control": "no-store" }; return list(new Response("b", { headers }).headers); });
show("new Request(url, { headers })", () => { const headers = { authorization: "t", "x-n": "1" }; return list(new Request("http://localhost/", { headers }).headers); });
show("new URLSearchParams(typed)", () => { const params = { q: "a b", page: "1", "ключ": "значение" }; return new URLSearchParams(params).toString(); });
show("values that are no strings", () => { const m: Mixed = { a: "s", b: 1.5, c: true, d: null, e: undefined }; return [list(new Headers(hide(m))), new URLSearchParams(hide(m)).toString()]; });
show("an optional field absent, then set", () => { const m: Mixed = { a: "s", b: 1, c: false, d: null, e: undefined }; const first = new URLSearchParams(hide(m)).toString(); m.f = "set"; return [first, new URLSearchParams(hide(m)).toString()]; });
show("a value with toString, which changes a later field", () => { const o: { a: unknown; b: string } = { a: null, b: "before" }; o.a = { toString() { o.b = "after"; return "ran"; } }; return [new URLSearchParams(hide(o)).toString(), list(new Headers(hide({ ...o, a: "x" })))]; });
show("a value with toString, which deletes a later field", () => { const o: { a: unknown; b?: string } = { a: null, b: "before" }; o.a = { toString() { delete o.b; return "ran"; } }; return new URLSearchParams(hide(o)).toString(); });
show("a symbol value", () => { const o: { a: unknown } = { a: Symbol("s") }; return new URLSearchParams(hide(o)).toString(); });
show("an invalid header name, value", () => { const bad = { "a b": "1" }, worse = { a: "x\ny" }; const out: string[] = []; for (const o of [bad, worse]) { try { out.push(JSON.stringify(list(new Headers(o)))); } catch (e) { out.push((e as Error).name + ": " + (e as Error).message); } } return out; });
show("names that differ in case", () => { const o = { "X-A": "1", "x-a": "2", "x-B": "3" }; return list(new Headers(o)); });
show("lone surrogates in a key", () => { const o = { "\ud800": "1", "�": "2", plain: "3" }; return new URLSearchParams(o).toString(); });
show("extras", () => { const o = three(); hide(o)["x-extra"] = "e"; hide(o)[Symbol.for("s")] = "sym"; const out: unknown[] = []; try { out.push(list(new Headers(o))); } catch (e) { out.push((e as Error).name); } return out; });
show("a non-enumerable extra", () => { const o = three(); Object.defineProperty(hide(o), "x-hidden", { value: "h", enumerable: false }); return list(new Headers(o)); });
show("a class instance", () => { class H { accept = "*/*"; #secret = "s"; get computed() { return this.#secret; } } return list(new Headers(hide(new H()))); });
show("frozen", () => list(new Headers(Object.freeze(three()))));
show("an iterable typed object", () => { const o: { a: string; [Symbol.iterator]?: () => Iterator<[string, string]> } = { a: "1" }; const first = list(new Headers(hide(o))); hide(o)[Symbol.iterator] = function* () { yield ["x-it", "yes"]; }; return [first, list(new Headers(hide(o)))]; });
show("empty", () => [list(new Headers({} as { o?: string })), new URLSearchParams({} as { o?: string }).toString()]);
show("many", () => { const o = { a01: "1", a02: "2", a03: "3", a04: "4", a05: "5", a06: "6", a07: "7", a08: "8", a09: "9", a10: "10", a11: "11", a12: "12" }; return new URLSearchParams(o).toString(); });
//// hook-stores-before-initializers.ts
// Fields that a method called from the base constructor assigns before their own initializers run.
class B { s = "s"; constructor() { console.log(JSON.stringify(this)); this.hook() } hook() {} }
class D extends B { x = 1; y?: number; z: string | undefined; hook() { this.y = 5; this.z = "hook"; console.log(this.y, this.z, JSON.stringify(this)) } }
const d = new D()
console.log(Object.keys(d).sort().join(), JSON.stringify(d), d.y, d.z)
class E { a = this.init(); b?: number; c = 2; init() { this.b = 7; this.c = 9; return 1 } }
const e = new E()
console.log(Object.keys(e).sort().join(), e.a, e.b, e.c)
// A field read before its initializer has run (a hook called by the base constructor) is undefined, whatever it is declared to hold.
class Base { constructor() { this.hook() } hook() {} }
class Early extends Base { n = 1; done = false; name = "name"
  hook() { console.log(this.n, this.done ? "done" : "not done", this.done, this.name, typeof this.n, this.n === undefined) }
}
const early = new Early()
console.log(early.n, early.done, early.name)
//// host-object-from-any-slot-into-interface.ts
// What comes out of a place for an Error, a Promise or an ArrayBuffer is a host object as before, and an interface of the program that it enters admits it: by a parameter, a field, an element.
interface HasMessage { message: string }
interface Thenable { then(done: (n: number) => void): unknown }
interface HasTime { getTime(): number }
interface HasBytes { byteLength: number }
class Own implements HasMessage { extra = 0; message = "own" }
class OwnThen implements Thenable { extra = 0; then(done: (n: number) => void): unknown { done(1); return 0 } }
class OwnTime implements HasTime { extra = 0; getTime(): number { return -1 } }
class OwnBytes implements HasBytes { extra = 0; byteLength = -1 }
function show(m: HasMessage): string { return m.message }
function wait(t: Thenable): string { return typeof t.then }
function time(t: HasTime): number { return t.getTime() }
function bytes(b: HasBytes): number { return b.byteLength }
function viaError(e: Error): string { return show(e) }
function viaPromise(p: Promise<number>): string { return wait(p) }
function viaDate(d: Date): number { return time(d) }
function viaBuffer(b: ArrayBuffer): number { return bytes(b) }
class Holder { e: Error; p: Promise<number>; d: Date; b: ArrayBuffer; constructor(e: Error, p: Promise<number>, d: Date, b: ArrayBuffer) { this.e = e; this.p = p; this.d = d; this.b = b } }
const h = new Holder(new RangeError("held"), Promise.resolve(2), new Date(9), new ArrayBuffer(3));
console.log(show(new Own()), wait(new OwnThen()), time(new OwnTime()), bytes(new OwnBytes()));
console.log(viaError(new Error("x")), viaError(new TypeError("y")), viaPromise(Promise.resolve(1)), viaDate(new Date(5)), viaBuffer(new ArrayBuffer(7)));
console.log(show(h.e), wait(h.p), time(h.d), bytes(h.b));
const list: HasMessage[] = [h.e, new Own()]; const times: HasTime[] = [h.d, new OwnTime()];
console.log(list.map(show).join(), times.map(time).join());
//// ill-typed-field-value-paths.ts
// Every known way by which a field or an element comes to hold a value that its type does not allow: whether the store succeeds, and what later reads see.
// A store that enters no written type succeeds. The next read through a written type throws, whatever is done with the value. A read through an unannotated variable (5) or through a type that allows the value (17) does not throw, and neither does a missing field (6, 10, 11, 12) or undefined (13).
function attempt(label: string, f: () => unknown): void { try { console.log(label, String(f())) } catch (e) { console.log(label, (e as Error).constructor.name) } }
function plusOne(n: number): number { return n + 1 }
function hide<T>(value: unknown): T { return value as T }
function key(name: string): string { return name.split("").join("") }

// 1. A field is covariant: the object is looked at through a type whose field takes more.
interface Narrow { v: number }
interface Wide { v: number | string }
const n1: Narrow = { v: 1 }
const w1: Wide = n1
attempt("1 store", () => { w1.v = "text"; return "taken" })
attempt("1 looked at", () => n1.v)
attempt("1 held", () => plusOne(n1.v))

// 2. The same by a type argument.
interface Box<T> { value: T }
const n2: Box<number> = { value: 1 }
const w2: Box<number | string> = n2
attempt("2 store", () => { w2.value = "text"; return "taken" })
attempt("2 looked at", () => n2.value)
attempt("2 held", () => plusOne(n2.value))

// 3. The same by the constraint of a type parameter.
function put<T extends { v: unknown }>(o: T, v: unknown): void { o.v = v }
const n3: Narrow = { v: 1 }
attempt("3 store", () => { put(n3, "text"); return "taken" })
attempt("3 looked at", () => n3.v)
attempt("3 held", () => plusOne(n3.v))

// 4. An index signature: a type literal is assignable to a dictionary.
type Lit = { v: number }
const n4: Lit = { v: 1 }
const w4: { [k: string]: number | string } = n4
attempt("4 store", () => { w4["v"] = "text"; return "taken" })
attempt("4 looked at", () => n4.v)
attempt("4 held", () => plusOne(n4.v))

// 5. A subclass declares the field narrower.
class Loose { v: number | string = 1 }
class Strict extends Loose { declare v: number }
const n5 = new Strict()
const w5: Loose = n5
attempt("5 store", () => { w5.v = "text"; return "taken" })
attempt("5 looked at", () => n5.v)
attempt("5 held", () => plusOne(n5.v))

// 6. A forced cast somewhere: an object of another type is admitted to the view, and then stands in a field of that type.
interface A { a: number; shared?: string }
interface B { b: string; shared?: string }
interface Holder { item: A }
const makeB = (): B => ({ b: "b", shared: "s" })
const h6: Holder = { item: { a: 1 } }
attempt("6 the cast", () => (makeB() as unknown as A).shared)
attempt("6 store", () => { h6.item = makeB() as unknown as A; return "taken" })
attempt("6 looked at", () => h6.item.a)
attempt("6 held", () => plusOne(h6.item.a))

// 7. Untyped code stores to the field by name.
const n7: Narrow = { v: 1 }
attempt("7 store", () => { (n7 as any).v = "text"; return "taken" })
attempt("7 looked at", () => n7.v)
attempt("7 held", () => plusOne(n7.v))

// 8. Untyped code stores by a computed key, by Object.assign, by Reflect.set, by defineProperty with a value.
const n8a: Narrow = { v: 1 }, n8b: Narrow = { v: 1 }, n8c: Narrow = { v: 1 }, n8d: Narrow = { v: 1 }
attempt("8 by key", () => { (n8a as any)[key("v")] = "text"; return "taken" })
attempt("8 by key, looked at", () => n8a.v)
attempt("8 assign", () => { Object.assign(n8b, hide<Narrow>({ v: "text" })); return "taken" })
attempt("8 assign, looked at", () => n8b.v)
attempt("8 Reflect.set", () => Reflect.set(n8c, key("v"), "text"))
attempt("8 Reflect.set, looked at", () => n8c.v)
attempt("8 define", () => { Object.defineProperty(n8d, key("v"), { value: "text", writable: true, enumerable: true, configurable: true }); return "taken" })
attempt("8 define, looked at", () => n8d.v)

// 9. An accessor in the field's place.
const n9: Narrow = { v: 1 }
attempt("9 define", () => { Object.defineProperty(n9, key("v"), { get() { return "got" }, configurable: true }); return "taken" })
attempt("9 looked at", () => n9.v)
attempt("9 held", () => plusOne(n9.v))

// 10. The field is deleted.
const n10: Narrow = { v: 1 }
attempt("10 delete", () => delete (n10 as Partial<Narrow>).v)
attempt("10 looked at", () => n10.v)
attempt("10 held", () => plusOne(n10.v))

// 11. The object was made as less: a cast gives it a type that has more, and nothing has stored that yet.
interface More extends Narrow { late: number; ref: Narrow }
const n11 = { v: 1 } as Narrow as More
attempt("11 looked at", () => n11.late)
attempt("11 held", () => plusOne(n11.late))
attempt("11 a reference", () => n11.ref)
attempt("11 through it", () => n11.ref.v)

// 12. A class field that no constructor stores.
class Unset { n!: number; r!: Narrow }
const n12 = new Unset()
attempt("12 looked at", () => n12.n)
attempt("12 held", () => plusOne(n12.n))
attempt("12 a reference", () => n12.r)

// 13. null or undefined by `!` and by `as`.
interface Ref { r: Narrow; n: number }
const n13: Ref = { r: { v: 1 }, n: 1 }
const nothing: Narrow | undefined = hide<Narrow | undefined>(undefined)
attempt("13 store !", () => { n13.r = nothing!; return "taken" })
attempt("13 store as", () => { n13.r = nothing as Narrow; return "taken" })
attempt("13 looked at", () => n13.r)
attempt("13 a number as", () => { n13.n = hide<number | undefined>(undefined) as number; return "taken" })
attempt("13 a number looked at", () => n13.n)

// 14. A member of the view lacks the field, and untyped code has given it a property of that name.
interface Base14 { a: number }
interface With14 extends Base14 { extra?: number }
const n14: Base14 = { a: 1 }
attempt("14 store", () => { (n14 as any).extra = "text"; return "taken" })
attempt("14 looked at", () => (n14 as With14).extra)
attempt("14 held", () => plusOne((n14 as With14).extra ?? 0))

// 15. An optional field that is absent is read from the prototype chain.
interface Chain15 { a: number; zz15?: number }
const n15: Chain15 = { a: 1 }
attempt("15 a name of Object.prototype", () => typeof (n15 as { valueOf?: unknown }).valueOf)
attempt("15 given a prototype", () => { Object.setPrototypeOf(n15, { zz15: "inherited" }); return "taken" })
attempt("15 looked at", () => n15.zz15)

// 16. Data from outside under a written type, and under a cast.
attempt("16 written", () => { const o: Narrow = JSON.parse('{"v":"text"}'); return o.v })
attempt("16 cast", () => (JSON.parse('{"v":"text"}') as Narrow).v)
attempt("16 held", () => plusOne((JSON.parse('{"v":"text"}') as Narrow).v))
attempt("16 within", () => { const o: Holder = JSON.parse('{"item":{"a":"text"}}'); return o.item.a })

// 17. A type guard that lies, and an assertion function.
function isNarrow(o: Wide): o is Narrow { return true }
const w17: Wide = { v: "text" }
attempt("17 looked at", () => isNarrow(w17) ? w17.v : "no")
attempt("17 held", () => isNarrow(w17) ? plusOne(w17.v) : "no")

// 18. Elements: an array is covariant, a read past the end, a hole.
const n18: number[] = [1, 2]
const w18: (number | string)[] = n18
attempt("18 store", () => { w18.push("text"); return "taken" })
attempt("18 looked at", () => n18[2])
attempt("18 held", () => plusOne(n18[2]!))
attempt("18 past the end", () => n18[9])
attempt("18 past the end, held", () => plusOne(n18[9]!))

// 19. A literal type, an enum: the field promises the kind, so another number is taken.
interface Kind19 { kind: 1 | 2 }
const n19: Kind19 = { kind: 1 }
attempt("19 store", () => { n19.kind = 3 as 1; return "taken" })
attempt("19 looked at", () => n19.kind)

// 20. A method's parameter is bivariant: a place, not a field, and from there a field.
interface Sink { put(v: number | string): void }
class NumberSink { last = 0; put(v: number): void { this.last = v } }
const n20 = new NumberSink()
const w20: Sink = n20
attempt("20 store", () => { w20.put("text"); return "taken" })
attempt("20 looked at", () => n20.last)
//// inherited-interface-keys.ts
// Object literals with `__proto__`, written plainly and as a computed key.
interface Base1 { inherited: string }
const base1: Base1 = { inherited: "yes" }
const computedProto = { own: 1, ["__proto__"]: base1 }
console.log(Object.keys(computedProto).join(), Object.getPrototypeOf(computedProto) === Object.prototype, (computedProto as any).inherited)
const __proto__ = base1
const shorthand = { own: 1, __proto__ }
console.log(Object.keys(shorthand).join(), Object.getPrototypeOf(shorthand) === Object.prototype, (shorthand as any).inherited)
const k: string = "__proto__"
const dynamic = { own: 1, [k]: base1 }
console.log(Object.keys(dynamic).join(), Object.getPrototypeOf(dynamic) === Object.prototype, (dynamic as any).inherited)
const method = { own: 1, __proto__() { return 1 } }
console.log(Object.keys(method).join(), Object.getPrototypeOf(method) === Object.prototype)
const quoted = { own: 1, "__proto__": base1 }
console.log(Object.keys(quoted).join(), Object.getPrototypeOf(quoted) === base1, (quoted as any).inherited)
const nul = { own: 1, __proto__: null }
console.log(Object.keys(nul).join(), Object.getPrototypeOf(nul) === null)
const num = { own: 1, __proto__: 5 }
console.log(Object.keys(num).join(), Object.getPrototypeOf(num) === Object.prototype)
class P { __proto__ = 1; x = 2 }
const p = new P()
console.log(Object.keys(p).join(), Object.getPrototypeOf(p) === P.prototype)
//// inspect-typed-objects.ts
import { inspect, format } from "node:util";
interface T { a?: number; b: number; c?: string; d?: unknown }
class Base { constructor(public v: number) {} method() { return 1; } get twice() { return this.v * 2; } set twice(x: number) { this.v = x / 2; } static made = 1; }
class Heir extends Base { w = "w"; #secret = 1; get secret() { return this.#secret; } own() { return 2; } }
class Deep3 extends Heir { z = 3; get third() { return 3; } }
class Tagged { v = 1; get [Symbol.toStringTag]() { return "MyTag"; } }
class Custom { v = 1; [Symbol.for("nodejs.util.inspect.custom")]() { return "custom!"; } }
class Empty {}
function hide(value: unknown): any { return value; }
let count = 0;
function show(name: string, make: () => unknown) {
  let v: unknown;
  try { v = make(); } catch (e) { console.log(String(++count).padStart(2, "0"), name + ": THROWN", (e as Error).name); return; }
  const flat = (s: string) => s.replace(/\s+/g, " ");
  console.log(String(++count).padStart(2, "0"), name + ":", flat(Bun.inspect(v)), "|", flat(inspect(v)), "|", flat(inspect(v, { showHidden: true, depth: 4 })), "|", flat(format("%o %O %j", v, v, typeof v === "object" ? 0 : v)), "|", flat(Bun.inspect(v, { sorted: true, compact: true } as any)));
  console.log(v);
}
const plain = (...entries: [string | symbol, unknown][]): any => { const o = JSON.parse("{}"); for (const [k, w] of entries) o[k] = w; return o; };
show("a record", () => ({ b: 1 }) as T);
show("undefined first, in the middle, last", () => [{ a: undefined, b: 1 } as T, { b: 1, c: undefined, d: 2 } as T, { b: 1, d: undefined } as T]);
show("orders differ", () => { const x: T = { b: 1 }; x.c = "c"; x.a = 1; return x; });
show("every kind of value", () => ({ b: 1.5, c: "s", d: [null, true, 10n, Symbol("s"), () => 1, new Date(0), /x/g, new Map([[1, { b: 2 } as T]]), new Set([{ b: 3 } as T])] }) as T);
show("nested four deep", () => ({ b: 1, d: { b: 2, d: { b: 3, d: { b: 4, d: { b: 5 } } } } }) as T);
show("empty", () => [{} as { o?: number }, { o: undefined } as { o?: number }, new Empty()]);
show("an instance", () => new Base(1));
show("an heir: a private field, accessors, methods", () => new Heir(2));
show("three classes deep", () => new Deep3(3));
show("a class with a tag", () => new Tagged());
show("a class with a custom inspector", () => [new Custom(), { b: 1, d: new Custom() } as T]);
show("the classes themselves", () => [Base, Heir]);
show("a prototype with an enumerable name", () => Object.setPrototypeOf({ b: 1 } as T, plain(["zz", 1])));
show("a prototype with an accessor", () => Object.setPrototypeOf({ b: 1 } as T, Object.defineProperty(plain(), "got", { get() { return 1; }, enumerable: true })));
show("a prototype chain of three plain objects", () => Object.setPrototypeOf({ b: 1 } as T, Object.setPrototypeOf(plain(["p1", 1]), Object.setPrototypeOf(plain(["p2", 2]), plain(["p3", 3])))));
show("a prototype that owns a name the object has", () => Object.setPrototypeOf({ b: 1 } as T, plain(["b", 2], ["a", 3])));
show("a typed object as a prototype", () => [Object.create({ b: 1 } as T), Object.setPrototypeOf({ b: 2 } as T, { a: 1, b: 1 } as T)]);
show("a null prototype", () => Object.setPrototypeOf({ b: 1 } as T, null));
show("extras: a string, a symbol, an index", () => { const x: T = { b: 1 }; hide(x).zz = 1; hide(x)[Symbol.for("s")] = 2; hide(x)[0] = "zero"; return x; });
show("extras: non-enumerable, an accessor", () => { const x: T = { b: 1 }; Object.defineProperty(hide(x), "hidden", { value: 1, enumerable: false }); Object.defineProperty(hide(x), "got", { get() { return 1; }, enumerable: true }); return x; });
show("names: constructor, __proto__, toString as fields", () => ({ constructor: 1, toString: 2, valueOf: 3 }) as { constructor: number; toString: number; valueOf: number });
show("names that need quotes", () => ({ "a-b": 1, "1x": 2, "": 3, "ключ": 4, "with space": 5 }));
show("frozen, sealed, closed", () => [Object.freeze({ b: 1 } as T), Object.seal({ b: 2 } as T), Object.preventExtensions({ b: 3 } as T)]);
show("a cycle", () => { const x: T = { b: 1 }; x.d = x; return x; });
show("one object twice", () => { const x: T = { b: 1 }; return [x, x, { b: 2, d: x } as T]; });
show("many fields", () => ({ f01: 1, f02: 2, f03: 3, f04: 4, f05: 5, f06: 6, f07: 7, f08: 8, f09: 9, f10: 10, f11: 11, f12: 12, f13: 13, f14: 14, f15: 15, f16: 16, f17: 17, f18: 18, f19: 19, f20: 20, f21: 21, f22: 22, f23: 23, f24: 24, f25: 25, f26: 26, f27: 27, f28: 28 }));
show("an array of a hundred and five", () => Array.from({ length: 105 }, (_, i) => ({ b: i }) as T));
show("console.table's data", () => { console.table([{ b: 1, c: "x" } as T, { a: 2, b: 3 } as T]); return 0; });
show("an error with typed fields", () => Object.assign(new Error("boom"), { info: { b: 1 } as T }).info);
//// instanceof-known-class-and-replaced-prototypes.ts
// Records whose prototype is replaced, some by the prototype of a class: `v instanceof Known` follows the prototype, not the layout. Objects of classes are answered as ever.
////= Known
////= lines-3	Heir	Known	y	2
////= Other
////= lines-16	Row	lonely	number
////= lines	Pair	left	number	right	string
const makeRow = (n: number): Row => ({ lonely: n });
const makePair = (n: number): Pair => ({ left: n, right: "r" + n });
const makeKept = (n: number) => ({ kept: n, also: n + 1 });
function alter(row: Row | Pair, parent: object | null) {
  Object.setPrototypeOf(row, parent);
}
const isKnown = [(v: any) => v instanceof Known][0]!;
const isHeir = [(v: any) => v instanceof Heir][0]!;
const isOther = [(v: any) => v instanceof Other][0]!;
const typedIsKnown = (v: Row | Pair | Known | Other) => v instanceof Known;
function inLoop(values: any[]) {
  let known = 0, heir = 0, other = 0;
  for (let i = 0; i < values.length; i++) {
    if (values[i] instanceof Known) known++;
    if (values[i] instanceof Heir) heir++;
    if (values[i] instanceof Other) other++;
  }
  return known + "/" + heir + "/" + other;
}
const parents: [string, object | null][] = [
  ["Known.prototype", Known.prototype],
  ["Heir.prototype", Heir.prototype],
  ["Other.prototype", Other.prototype],
  ["an object of Heir", new Heir()],
  ["an object under Known.prototype", Object.create(Known.prototype)],
  ["a plain object", { inherited: 1 }],
  ["Object.prototype", Object.prototype],
  ["null", null],
];
const all: any[] = [];
for (const [name, parent] of parents) {
  const row = makeRow(1), pair = makePair(2);
  console.log("before " + name + ": " + [isKnown(row), isHeir(row), isOther(row), isKnown(pair), typedIsKnown(row), typedIsKnown(pair)].join(" "));
  alter(row, parent);
  alter(pair, parent);
  console.log("under " + name + ": " + [isKnown(row), isHeir(row), isOther(row), isKnown(pair), isHeir(pair), isOther(pair), typedIsKnown(row), typedIsKnown(pair)].join(" "), row.lonely, pair.right);
  all.push(row, pair);
}
all.push(makeRow(3), makePair(4), makeKept(5), new Known(), new Heir(), new Other(), JSON.parse("{}"), "text", 7, null);
console.log("in a loop", inLoop(all));
let yes = 0;
for (let turn = 0; turn < 200; turn++) {
  for (let i = 0; i < all.length; i++) {
    if (isKnown(all[i])) yes++;
    if (isHeir(all[i])) yes += 100;
    if (isOther(all[i])) yes += 10000;
  }
}
console.log("many", yes);
const moved = makeRow(9);
const answers: boolean[] = [];
for (const [, parent] of [...parents, ...parents.slice().reverse()]) {
  alter(moved, parent);
  answers.push(isKnown(moved), isOther(moved));
}
console.log("moved", answers.map(Number).join(""));
alter(all[0], Other.prototype);
console.log("at last", isKnown(all[0]), isOther(all[0]), inLoop(all));
//// instanceof-known-class-and-scattered-replaced-prototypes.ts
// The records whose prototype may be replaced cannot get consecutive shape numbers here: First and Third are marked, and Second must lie between them, because First | Second and Second | Third are both tested often. `v instanceof Known` still follows the prototype of each. The guard reads `kind` through `as Second`, where it is written "second": for a Third, Fourth or Fifth that typed read gives their own text.
////= Known
////= Other
////= lines	First	kind	"first"	a	number
////= lines	Second	kind	"second"	b	number
////= lines	Third	kind	"third"	c	number
////= lines	Fourth	kind	"fourth"	d	number
////= lines	Fifth	kind	"fifth"	e	number
const first = (n: number): First => ({ kind: "first", a: n });
const second = (n: number): Second => ({ kind: "second", b: n });
const third = (n: number): Third => ({ kind: "third", c: n });
const fourth = (n: number): Fourth => ({ kind: "fourth", d: n });
const fifth = (n: number): Fifth => ({ kind: "fifth", e: n });
function alter(record: First | Third | Fifth, parent: object | null) {
  Object.setPrototypeOf(record, parent);
}
const isFirstOrSecond = (v: unknown): v is First | Second => (v as First | Second | Third | Fourth | Fifth).kind === "first" || (v as Second).kind === "second";
////= lines-31	low	First	Second	"first"	a	b
////= lines-31	middle	Second	Third	"second"	b	c
////= lines-31	high	Third	Fourth	"third"	c	d
////= lines-31	top	Fourth	Fifth	"fourth"	d	e
const pairs: any[] = [first(1), second(2), third(3), fourth(4), fifth(5)];
let sum = 0;
for (let turn = 0; turn < 50; turn++) {
  sum += low(pairs[turn & 1] as First | Second) + middle(pairs[1 + (turn & 1)] as Second | Third) + high(pairs[2 + (turn & 1)] as Third | Fourth) + top(pairs[3 + (turn & 1)] as Fourth | Fifth);
  try { if (isFirstOrSecond(pairs[turn % 5])) sum++; } catch (e) { console.log("guard", turn % 5, (e as Error).constructor.name); }
}
console.log("sum", sum);
const isKnown = [(v: any) => v instanceof Known][0]!;
const isOther = [(v: any) => v instanceof Other][0]!;
////= inLoop	other	Other
const show = (values: any[]) => values.map(v => (isKnown(v) ? "K" : isOther(v) ? "O" : "-")).join("");
const made = () => [first(1), second(2), third(3), fourth(4), fifth(5), new Known(), new Other(), JSON.parse("{}"), "text", 7, null] as any[];
let values = made();
console.log("as made", show(values), inLoop(values));
alter(values[0], Known.prototype);
console.log("first", show(values), inLoop(values));
alter(values[2], Other.prototype);
console.log("third", show(values), inLoop(values));
alter(values[4], Object.create(Known.prototype));
console.log("fifth", show(values), inLoop(values));
alter(values[0], null);
alter(values[2], Known.prototype);
console.log("again", show(values), inLoop(values), low(values[0]), middle(values[2]), top(values[4]));
values = made();
console.log("fresh", show(values), inLoop(values));
let yes = 0;
const mixed = [...made(), ...made()];
alter(mixed[0], Known.prototype);
alter(mixed[13], Known.prototype);
alter(mixed[15], Other.prototype);
for (let turn = 0; turn < 300; turn++) for (let i = 0; i < mixed.length; i++) yes += (isKnown(mixed[i]) ? 1 : 0) + (isOther(mixed[i]) ? 100 : 0);
console.log("many", yes, inLoop(mixed));
//// instanceof-known-class-on-any-value.ts
// `v instanceof Known`, where Known is a class the compiler knows and v is anything: objects of the class, of its heirs, of other classes, objects that no typed code made, and values that are no objects.
const count = (globalThis as any).aotOperationCount ?? (() => 0);
////= Known
////= lines-3	Heir	Known	y	2
////= lines-3	Leaf	Heir	w	4
////= Other
const isKnown = [(v: any) => v instanceof Known][0]!;
const isHeir = [(v: any) => v instanceof Heir][0]!;
const isLeaf = [(v: any) => v instanceof Leaf][0]!;
const isOther = [(v: any) => v instanceof Other][0]!;
////= inLoop	leaf	Leaf
let traps = 0;
const named: [string, any][] = [
  ["Known", new Known()],
  ["Heir", new Heir()],
  ["Leaf", new Leaf()],
  ["Other", new Other()],
  ["parsed", JSON.parse('{"x":1}')],
  ["made from Known.prototype", Object.create(Known.prototype)],
  ["made from Heir.prototype", Object.create(Heir.prototype)],
  ["made from Leaf.prototype", Object.create(Leaf.prototype)],
  ["two levels under Leaf.prototype", Object.create(Object.create(Leaf.prototype))],
  ["made from an object of Heir", Object.create(new Heir())],
  ["without a prototype", Object.create(null)],
  ["under one without a prototype", Object.create(Object.create(null))],
  ["Known.prototype", Known.prototype],
  ["Heir.prototype", Heir.prototype],
  ["the class Known", Known],
  ["an array", [1]],
  ["a function", () => 1],
  ["a map", new Map()],
  ["an error", new Error("e")],
  ["a date", new Date(0)],
  ["a proxy of a Heir", new Proxy(new Heir(), {})],
  ["a proxy that answers Leaf.prototype", new Proxy({}, { getPrototypeOf() { traps++; return Leaf.prototype; } })],
  ["under a proxy of a Heir", Object.create(new Proxy(new Heir(), { getPrototypeOf(target) { traps++; return Reflect.getPrototypeOf(target); } }))],
  ["a string", "text"],
  ["an empty string", ""],
  ["a long string", "x".repeat(300) + 1],
  ["a symbol", Symbol.iterator],
  ["a big integer", 12345678901234567890n],
  ["a number", 1.5],
  ["an integer", 7],
  ["true", true],
  ["null", null],
  ["undefined", undefined],
];
for (const [name, value] of named) console.log(name + ": " + [isKnown(value), isHeir(value), isLeaf(value), isOther(value)].join(" "));
console.log("traps", traps);
const values = named.map(pair => pair[1]);
console.log("in a loop", inLoop(values), traps);
const quiet = values.filter((_, i) => !named[i]![0].includes("proxy"));
let yes = 0;
const turn = () => {
  for (let i = 0; i < quiet.length; i++) {
    if (isKnown(quiet[i])) yes++;
    if (isLeaf(quiet[i])) yes++;
    if (isOther(quiet[i])) yes++;
  }
};
turn();
const before = count("operationAOTInstanceOfClass");
for (let i = 0; i < 300; i++) turn();
for (let i = 0; i < 300; i++) inLoop(quiet);
console.log("many", yes, count("operationAOTInstanceOfClass") - before < 100);
const changed: any = Object.create(Leaf.prototype);
console.log("before", isKnown(changed), isLeaf(changed));
Object.setPrototypeOf(changed, Other.prototype);
console.log("after", isKnown(changed), isLeaf(changed), isOther(changed));
Object.setPrototypeOf(changed, null);
console.log("at last", isKnown(changed), isLeaf(changed), isOther(changed));
//// instanceof-known-class-replaced-prototypes-and-extra-properties.ts
// Records and objects of classes that get another prototype and properties their type does not name, in either order: `v instanceof Known` follows the prototype.
////= Known
////= lines-3	Heir	Known	y	2
////= Other
////= lines-11	Moved	w	4
////= lines-16	Row	lonely	number
const makeRow = (n: number): Row => ({ lonely: n });
function alter(value: object, parent: object | null) {
  Object.setPrototypeOf(value, parent);
}
function extend(value: any, name: string, stored: number) {
  value[name] = stored;
}
function shrink(value: any, name: string) {
  delete value[name];
}
const isKnown = [(v: any) => v instanceof Known][0]!;
const isHeir = [(v: any) => v instanceof Heir][0]!;
const isOther = [(v: any) => v instanceof Other][0]!;
const isMoved = [(v: any) => v instanceof Moved][0]!;
const typedIsKnown = (v: Row | Known | Other) => v instanceof Known;
function narrow(v: Row | Known | Other): string {
  if (v instanceof Heir) return "heir";
  if (v instanceof Known) return "known";
  if (v instanceof Other) return "other";
  return "row " + v.lonely;
}
function inLoop(values: any[]) {
  let known = 0, heir = 0, other = 0, moved = 0;
  for (let i = 0; i < values.length; i++) {
    if (values[i] instanceof Known) known++;
    if (values[i] instanceof Heir) heir++;
    if (values[i] instanceof Other) other++;
    if (values[i] instanceof Moved) moved++;
  }
  return [known, heir, other, moved].join("/");
}
const say = (label: string, v: Row | Known | Other) => console.log(label, [isKnown(v), isHeir(v), isOther(v), isMoved(v), typedIsKnown(v)].map(Number).join(""), narrow(v), inLoop([v, v]));
const sayOfMoved = (label: string, v: Moved) => console.log(label, [isKnown(v), isHeir(v), isOther(v), isMoved(v)].map(Number).join(""), inLoop([v, v]));
const parents: [string, object | null][] = [
  ["Known.prototype", Known.prototype],
  ["Heir.prototype", Heir.prototype],
  ["an object of Other", new Other()],
  ["a plain object", { inherited: 1 }],
  ["Object.prototype", Object.prototype],
  ["null", null],
];
const all: any[] = [];
for (const [name, parent] of parents) {
  const first = makeRow(1);
  alter(first, parent);
  say("altered: " + name, first);
  extend(first, "extra", 5);
  say("altered, extended: " + name, first);
  const second = makeRow(2);
  extend(second, "extra", 6);
  say("extended", second);
  alter(second, parent);
  say("extended, altered: " + name, second);
  const third = makeRow(3);
  alter(third, parent);
  for (let i = 0; i < 100; i++) extend(third, "p" + i, i);
  say("altered, a hundred more: " + name, third);
  for (let i = 0; i < 100; i++) shrink(third, "p" + i);
  say("and none again: " + name, third);
  alter(third, Object.prototype);
  say("and back under Object.prototype", third);
  console.log(first.lonely, (first as any).extra, second.lonely, (second as any).extra, third.lonely);
  all.push(first, second, third);
}
const kept = makeRow(7);
say("kept", kept);
extend(kept, "extra", 1);
say("kept, extended", kept);
const moved = new Moved();
sayOfMoved("an object of Moved", moved);
extend(moved, "extra", 1);
sayOfMoved("extended", moved);
alter(moved, Known.prototype);
sayOfMoved("under Known.prototype", moved);
alter(moved, Moved.prototype);
sayOfMoved("back under Moved.prototype", moved);
sayOfMoved("another object of Moved", new Moved());
all.push(kept, moved, new Moved(), new Known(), new Heir(), new Other(), makeRow(8));
console.log("in a loop", inLoop(all));
let yes = 0;
for (let turn = 0; turn < 300; turn++) {
  for (let i = 0; i < all.length; i++) {
    if (isKnown(all[i])) yes++;
    if (isOther(all[i])) yes += 1000;
    if (!isMoved(all[i]) && all[i] !== moved && narrow(all[i]) === "known") yes += 1000000;
  }
}
console.log("many", yes);
//// instanceof-object-constructed-for-another-class.ts
// An object that Reflect.construct makes with the constructor of one class for another class has the fields of the first and the prototype of the second: `instanceof` follows the prototype.
class Journal {
  lines: string[] = [];
  size(): number {
    return this.lines.length;
  }
}
class Quiet {
  lines: string[] = [];
  size(): number {
    return -1;
  }
}
function louder(Base: any): any {
  return class extends Base {};
}
let current: Journal | null = new Journal();
function attempt(what: string, run: () => unknown): void {
  console.log(what, run());
}
attempt("a subclass made by value", () => {
  const Louder = louder(Journal);
  current = new Louder() as Journal;
  return current instanceof Journal;
});
attempt("constructed for another class", () => {
  current = Reflect.construct(Journal, [], Quiet) as Journal;
  return current.size() + " " + (current instanceof Journal);
});
//// int32-fields-any-number.ts
// Number fields that the program only shows small integers for, so that they are kept in four bytes, read and used right away, with every kind of number in them: the odd ones come out of JSON.
declare const console: { log(...values: unknown[]): void };
class Span {
    kind!: number; pos!: number; end!: number; id!: number; next!: number; line!: number; column!: number; depth!: number;
}
function makeSpan(kind: number, pos: number, end: number): Span { const n = new Span(); n.kind = kind; n.pos = pos; n.end = end; n.id = 0; n.next = 0; n.line = pos >> 2; n.column = pos & 3; n.depth = kind + 1; return n; }
const names: string[] = [];
for (let i = 0; i < 40; i++) names.push("n" + i);
(names as unknown as Record<string, string>)["1.5"] = "one and a half";
(names as unknown as Record<string, string>)["-1"] = "minus one";
(names as unknown as Record<string, string>)["NaN"] = "not a number";
(names as unknown as Record<string, string>)["Infinity"] = "infinity";
(names as unknown as Record<string, string>)["4294967296"] = "two to the 32";
const text = "the quick brown fox jumps over the lazy dog";
let counter = 100;

function truthy(n: Span): string { return n.pos ? "yes" : "no"; }
function falsy(n: Span): boolean { return !n.pos; }
function both(n: Span): number { return n.pos && n.end; }
function either(n: Span): number { return n.pos || n.end; }
function nameAt(n: Span): string | undefined { return names[n.pos]; }
function nameAfter(n: Span): string | undefined { return names[n.pos + 1]; }
function nameBefore(n: Span): string | undefined { return names[n.pos - 1]; }
function nameBetween(n: Span): string | undefined { return names[n.end - n.pos]; }
function nameTwice(n: Span): string | undefined { return names[n.pos * 2]; }
function width(n: Span): number { return n.end - n.pos; }
function sum(n: Span): number { return n.end + n.pos; }
function product(n: Span): number { return n.end * n.pos; }
function sign(n: Span): number { return 1 / (n.pos * n.kind); }
function signOfSum(n: Span): number { return 1 / (n.pos + n.end); }
function signOfDifference(n: Span): number { return 1 / (n.pos - n.end); }
function isSame(n: Span): boolean { return Object.is(n.pos, n.end); }
function less(n: Span): boolean { return n.pos < n.end; }
function lessOrEqual(n: Span): boolean { return n.pos <= n.end; }
function greater(n: Span): boolean { return n.pos > n.end; }
function greaterOrEqual(n: Span): boolean { return n.pos >= n.end; }
function equal(n: Span): boolean { return n.pos === n.end; }
function unequal(n: Span): boolean { return n.pos !== n.end; }
function isZero(n: Span): boolean { return n.pos === 0; }
function isNegative(n: Span): boolean { return n.pos < 0; }
function atLeastTen(n: Span): boolean { return n.pos >= 10; }
function notBelowTen(n: Span): boolean { return !(n.pos < 10); }
function inText(n: Span): boolean { return n.pos < text.length; }
function contains(n: Span, at: number): boolean { return at >= n.pos && at < n.end; }
function code(n: Span): number { return text.charCodeAt(n.pos); }
function codeAfter(n: Span): number { return text.charCodeAt(n.pos + 1); }
function piece(n: Span): string { return text.substring(n.pos, n.end); }
function slice(n: Span): string { return text.slice(n.pos, n.end); }
function masked(n: Span): number { return n.pos & 0xff; }
function ored(n: Span): number { return n.pos | 0; }
function unsigned(n: Span): number { return n.pos >>> 0; }
function shifted(n: Span): number { return n.pos << n.kind; }
function shiftedBy(n: Span): number { return 1 << n.pos; }
function inverted(n: Span): number { return ~n.pos; }
function negated(n: Span): number { return -n.pos; }
function remainder(n: Span): number { return n.pos % 7; }
function quotient(n: Span): number { return n.pos / 2; }
function floored(n: Span): number { return Math.floor(n.pos / 2); }
function larger(n: Span): number { return Math.max(n.pos, n.end); }
function smaller(n: Span): number { return Math.min(n.pos, n.end); }
function asText(n: Span): string { return "" + n.pos; }
function inTemplate(n: Span): string { return `${n.pos}:${n.end}`; }
function copy(n: Span): number { n.next = n.pos; return n.next; }
function copyPlusOne(n: Span): number { n.next = n.pos + 1; return n.next; }
function copyWidth(n: Span): number { n.next = n.end - n.pos; return n.next; }
function bump(n: Span): number { n.next = n.pos; n.next++; return n.next; }
function drop(n: Span): number { n.next = n.pos; --n.next; return n.next; }
function addTo(n: Span): number { n.next = n.pos; n.next += n.end; return n.next; }
function idOf(n: Span): number { if (!n.id) { n.id = counter; counter++; } return n.id; }
function nameOfId(n: Span): string | undefined { n.id = n.pos; const id = idOf(n); return names[id] || (id + "?"); }
function chosen(n: Span): number { switch (n.pos) { case 0: return 10; case 1: return 11; case -1: return 9; case 2147483647: return 12; default: return -5; } }
function typeName(n: Span): string { return typeof n.pos; }
function isWhole(n: Span): boolean { return Number.isInteger(n.pos); }
function isSafe(n: Span): boolean { return Number.isSafeInteger(n.pos + 1); }
function keyed(n: Span): string { const m = new Map<number, string>([[0, "zero"], [1, "one"], [1.5, "half"], [NaN, "nan"]]); return m.get(n.pos) ?? "none"; }
function count(n: Span): number { let t = 0; for (let i = n.pos; i < n.end && t < 5; i++) t++; return t; }
function countDown(n: Span): number { let t = 0; for (let i = n.end; i > n.pos && t < 5; i--) t++; return t; }

const all: [string, (n: Span) => unknown][] = [
    ["truthy", truthy], ["falsy", falsy], ["both", both], ["either", either], ["nameAt", nameAt], ["nameAfter", nameAfter], ["nameBefore", nameBefore], ["nameBetween", nameBetween],
    ["nameTwice", nameTwice], ["width", width], ["sum", sum], ["product", product], ["sign", sign], ["signOfSum", signOfSum], ["signOfDifference", signOfDifference], ["isSame", isSame],
    ["less", less], ["lessOrEqual", lessOrEqual], ["greater", greater], ["greaterOrEqual", greaterOrEqual], ["equal", equal], ["unequal", unequal], ["isZero", isZero],
    ["isNegative", isNegative], ["atLeastTen", atLeastTen], ["notBelowTen", notBelowTen], ["inText", inText], ["contains", n => contains(n, 3)], ["containsHalf", n => contains(n, 1.5)],
    ["code", code], ["codeAfter", codeAfter], ["piece", piece], ["slice", slice], ["masked", masked], ["ored", ored], ["unsigned", unsigned], ["shifted", shifted], ["shiftedBy", shiftedBy],
    ["inverted", inverted], ["negated", negated], ["remainder", remainder], ["quotient", quotient], ["floored", floored], ["larger", larger], ["smaller", smaller], ["asText", asText],
    ["inTemplate", inTemplate], ["copy", copy], ["copyPlusOne", copyPlusOne], ["copyWidth", copyWidth], ["bump", bump], ["drop", drop], ["addTo", addTo], ["nameOfId", nameOfId],
    ["chosen", chosen], ["typeName", typeName], ["isWhole", isWhole], ["isSafe", isSafe], ["keyed", keyed], ["count", count], ["countDown", countDown],
];
const numbers: number[] = JSON.parse("[0,1,-1,2,7,39,40,1073741823,1073741824,-1073741823,-1073741824,-1073741825,2147483646,2147483647,2147483648,-2147483647,-2147483648,-2147483649,4294967295,4294967296,9007199254740991,9007199254740992,-9007199254740992,1.5,-1.5,0.5,-0.5,-0,5e-324,1e21,1.7976931348623157e308]");
for (const name of JSON.parse('["NaN","Infinity","-Infinity"]') as string[]) numbers.push(Number(name));
function show(value: unknown): string { return typeof value === "number" && Object.is(value, -0) ? "-0" : String(value); }
const spans: Span[] = [];
for (let i = 0; i < 64; i++) spans.push(makeSpan(i & 3, i, i + 3));
for (const [name, f] of all) { let t = ""; for (const n of spans) t = show(f(n)); console.log(name, "warm", t); }
for (const [name, f] of all) {
    const row: string[] = [];
    for (const pos of numbers) {
        const n = spans[row.length % spans.length];
        n.kind = row.length % 5 - 1; n.pos = pos; n.end = 5; row.push(show(f(n)));
        n.pos = 5; n.end = pos; row.push(show(f(n)));
        n.pos = pos; n.end = pos; row.push(show(f(n)));
        n.pos = 3; n.end = 8; n.next = 0; n.id = 0;
    }
    console.log(name, row.join(" "));
}
const through = spans[0] as unknown as Record<string, unknown>;
for (const odd of JSON.parse("[1.25,-0,1099511627776,0.1]") as number[]) { through["pos"] = odd; through.end = odd; console.log(show(width(spans[0])), truthy(spans[0]), show(nameAt(spans[0])), show(copyPlusOne(spans[0])), less(spans[0]), show(sign(spans[0]))); }
console.log(spans.map(n => n.line + n.column * 2 + n.depth).join(" "));
//// int32-fields-at-limits.ts
// Numbers kept as integers where they can be, taken over every edge: 2^31, 2^32, 2^53, -0, NaN, fractions out of `any`, division, remainders of negatives, shifts by 32 and more, parseInt, Number(), dates, typed arrays, loops that cross 2^31.
declare const console: { log(...values: unknown[]): void };
function show(value: unknown): string { return typeof value === "number" && Object.is(value, -0) ? "-0" : String(value); }
class Cell { a!: number; b!: number; c!: number; d!: number; e!: number; f!: number; g!: number; h!: number; }
function cell(a: number, b: number): Cell { const x = new Cell(); x.a = a; x.b = b; x.c = 0; x.d = 1; x.e = 2; x.f = 3; x.g = 4; x.h = 5; return x; }
function arithmetic(x: Cell): string { return [x.a + x.b, x.a - x.b, x.a * x.b, x.a / x.b, x.a % x.b, -x.a, +x.a, x.a ** 2, x.a + 1, x.a - 1, x.a * 2, x.a / 2, x.a % 2, x.a % -3, 1 / x.a].map(show).join(" "); }
function bits(x: Cell): string { return [x.a | 0, x.a >>> 0, x.a & x.b, x.a | x.b, x.a ^ x.b, ~x.a, x.a << 1, x.a << 31, x.a << 32, x.a << 33, x.a >> 32, x.a >> 63, x.a >>> 32, x.a >>> 31, x.a << x.b, x.a >> x.b, x.a >>> x.b, 1 << x.a].map(show).join(" "); }
function compared(x: Cell): string { return [x.a < x.b, x.a <= x.b, x.a > x.b, x.a >= x.b, x.a == x.b, x.a === x.b, x.a != x.b, x.a !== x.b, x.a < 0, x.a <= 0, x.a > 0, x.a >= 0, x.a === 0, x.a === x.a, !x.a, !!x.a, x.a < 2147483648, x.a >= -2147483648].map(v => v ? "1" : "0").join(""); }
