//// int32-math-results.ts
// What `Math.min`, `Math.max`, `Math.abs`, `Math.sign` and a rounded quotient return is an `int32` by proof where the operands limit it, and so is a counter that several cases of a `switch` advance under the test of a loop. type-rules/int32-unproven-stores has what is not.
import type { int32 } from "bun";

function least(a: int32, b: int32): int32 { return Math.min(a, b); }
function greatest(a: int32, b: int32): int32 { return Math.max(a, b, 0); }
function below(a: int32): int32 { return Math.min(a, 7) + 1; }
function size(a: int32): int32 { return Math.abs((a & 255) - 128); }
function sign(a: int32): int32 { return Math.sign(a); }
function half(a: int32): int32 { return Math.floor(a / 2); }
function third(a: int32): int32 { return Math.trunc((a & 1023) / 3); }
function thirdUp(a: int32): int32 { return Math.ceil((a & 1023) / 3); }
function quarter(a: int32): int32 { return Math.round((a & 1023) / 4); }
function negativeThird(a: int32): int32 { return Math.trunc(-((a & 1023) + 3) / 3); }
function middle(a: int32, b: int32): int32 { const sum = (a & 65535) + (b & 65535); return Math.floor(sum / 2); }
function eitherHalf(a: int32, b: int32): int32 { return Math.floor(a > 0 ? a / 2 : b / 3); }
function scaled(a: int32): int32 { return ((a & 255) - 128) * 3; }
function lastBelowHalf(to: int32): int32 { let last: int32 = -1; for (let i: int32 = 0; i < to / 2; i++) last = i; return last; }
function steps(from: int32, to: int32): int32 {
  let turns: int32 = 0;
  let i: int32 = from;
  while (i < to) {
    switch (i & 3) {
      case 0: i++; break;
      case 1: if (turns > 100) return turns;
      case 2: i++; break;
      default: i = (i + 5) | 0; break;
    }
    turns = (turns + 1) | 0;
  }
  return turns;
}

const given: number[] = JSON.parse("[-2147483648, -1025, -7, -1, 0, 1, 7, 1026, 2147483647]");
for (const n of given) {
  console.log(least(n | 0, 5), greatest(n | 0, -5), below(n | 0), size(n | 0), sign(n | 0), half(n | 0), scaled(n | 0));
  console.log(third(n | 0), thirdUp(n | 0), quarter(n | 0), negativeThird(n | 0), middle(n | 0, 9), eitherHalf(n | 0, -n | 0));
}
console.log(lastBelowHalf(7), lastBelowHalf(8), lastBelowHalf(0), lastBelowHalf(-3), steps(0, 40), steps(-9, 9), steps(5, 5), steps(2147483644, 2147483645));
//// integers-counted-up-and-down-past-the-ends-of-int32.ts
// `p.count++`, `p.count -= 3`, `total += 5` on a number that has only ever been a small integer: it is kept in 32 bits and added to where it lies.
// At either end of int32 the sum no longer fits: it is the same number as in plain Bun, in the field, in the variable, as the value of the expression, and whatever is read next.
class Counter {
  count: number;
  other: number;
  constructor(count: number) {
    this.count = count | 0;
    this.other = 7;
  }
}
function up(p: Counter): Counter {
  p.count++;
  return p;
}
function down(p: Counter): Counter {
  p.count--;
  return p;
}
function upBy(p: Counter): Counter {
  p.count += 1000;
  p.other += 1;
  return p;
}
function downBy(p: Counter): Counter {
  p.count -= 1000;
  p.other -= 1;
  return p;
}
function twice(p: Counter): Counter {
  p.count++;
  p.count++;
  return p;
}
function valueBefore(p: Counter): number {
  return p.count++;
}
function valueBehind(p: Counter): number {
  return ++p.count;
}
function both(p: Counter, q: Counter): number {
  p.count++;
  q.count--;
  return p.count + q.count;
}
let total = 0;
function addToTotal(): number {
  total += 5;
  return total;
}
function counterFrom(start: number) {
  let n = start | 0;
  return { next: () => ++n, previous: () => --n, read: () => n };
}

const ends = [2147483647, 2147483646, 2147482647, 2147482648, 0, -1, -2147483648, -2147483647, -2147483643, -2147483642, -2147483644, -2147482648, -2147482649];
for (let round = 0; round < 3; round++) {
  for (const end of ends) {
    const line: unknown[] = [end];
    for (const act of [up, down, upBy, downBy, twice]) {
      const p = act(new Counter(end));
      line.push(p.count, p.other);
      act(p);
      line.push(p.count);
    }
    const p = new Counter(end);
    line.push(valueBefore(p), p.count, valueBehind(p), p.count);
    const same = new Counter(end);
    line.push(both(same, same), both(new Counter(end), new Counter(end)));
    const counter = counterFrom(end);
    line.push(counter.next(), counter.next(), counter.previous(), counter.previous(), counter.previous(), counter.read());
    console.log(line.join(" "));
  }
}
total = 2147483640;
console.log(addToTotal(), addToTotal(), addToTotal(), total);
total = 1.5;
console.log(addToTotal(), total);

// What is no longer a small integer, is frozen, or is no field any more is counted as ECMAScript says.
const fraction = new Counter(1);
fraction.count = 0.5;
console.log(up(fraction).count, down(down(fraction)).count, upBy(fraction).count);
const text = new Counter(1);
(text as any).count = "9";
console.log(up(text).count, typeof text.count);
const nothing = new Counter(1);
(nothing as any).count = undefined;
console.log(up(nothing).count);
const frozen = Object.freeze(new Counter(5));
try {
  up(frozen);
} catch (error) {
  console.log((error as Error).constructor.name);
}
console.log(frozen.count);
const watched = new Counter(5);
let reads = 0;
Object.defineProperty(watched, "count", { get: () => (reads++, 2147483647), set: value => console.log("set", value), configurable: true });
console.log(up(watched).count, valueBefore(watched), reads);
const deleted = new Counter(5);
delete (deleted as any).count;
console.log(up(deleted).count, "count" in deleted);
//// interface-optional-fields.ts
// Optional and nullable fields of interfaces are added, set to null, deleted and read.
interface Author { nick: string; age?: number }
interface Doc { id: number; title?: string; author: Author; editor?: Author | null; refs: number[] }
function make(id: number): Doc { return { id, title: "t" + id, author: { nick: "a" + id }, editor: null, refs: [id] } }
const states = [make(2), make(2), make(2), make(2)]
console.log(Object.keys(states[1]).join())
states[0].editor = undefined; states[1].editor = null; delete states[2].editor; states[3].editor = { nick: "ed" }
console.log(states.map(d => Object.keys(d).join()).join(" "))
//// intersection-of-four-unions.ts
type A = { a: 0; a0?: string } | { a: 1; a1?: string } | { a: 2; a2?: string } | { a: 3; a3?: string };
type B = { b: 0; b0?: string } | { b: 1; b1?: string } | { b: 2; b2?: string } | { b: 3; b3?: string };
type C = { c: 0; c0?: string } | { c: 1; c1?: string } | { c: 2; c2?: string } | { c: 3; c3?: string };
type D = { d: 0; d0?: string } | { d: 1; d1?: string } | { d: 2; d2?: string } | { d: 3; d3?: string };
type All = A & B & C & D;
function weigh(it: All): number {
  return it.a * 64 + it.b * 16 + it.c * 4 + it.d;
}
function label(it: All): string {
  if (it.a === 2 && it.d === 3) return "two and three" + (it.a2 ?? "") + (it.d3 ?? "");
  return it.b === 1 ? "one" + (it.b1 ?? "") : "other";
}
const made: All[] = [
  { a: 0, b: 0, c: 0, d: 0 },
  { a: 3, b: 3, c: 3, d: 3, a3: "x" },
  { a: 2, b: 1, c: 0, d: 3, a2: "!", d3: "?" },
  { a: 1, b: 1, c: 2, d: 0, b1: "+" },
];
const either: All | undefined = made.length > 2 ? made[2] : undefined;
console.log(made.map(weigh).join(" "), made.map(label).join(" "), either ? weigh(either) : -1);
//// intersection-types.ts
// Intersection types: an object created as `A & B` is read and written as `A`, as `B` and as the intersection.
type HasId = { id: number }
type HasLabel = { label: string; note?: string }
type Stamps = { created: number; updated?: number }
type Entity = HasId & HasLabel
type Stored = Entity & Stamps
type Overlap = { id: number; shared: number | string } & { shared: number; extra: boolean }
interface Walker { legs: number; walk(): string }
interface Swimmer { fins: number; swim(): string }
type Amphibian = Walker & Swimmer
function show(o: object): string { return Object.keys(o).join() + " " + JSON.stringify(o) }
function idOf(h: HasId): number { return h.id }
function labelOf(h: HasLabel): string { return h.label + (h.note === undefined ? "" : "/" + h.note) }
function age(t: Stamps): number { return (t.updated ?? t.created) - t.created }
const entity: Entity = { label: "e", id: 1 }
const stored: Stored = { created: 100, id: 2, label: "s" }
const both: Stored = { updated: 5, note: "n", label: "b", created: 6, id: 3 }
const ids: HasId[] = [entity, stored, both, { id: 4 }]
const labels: HasLabel[] = [entity, stored, both, { label: "only" }]
const stamps: Stamps[] = [stored, both, { created: 1 }]
console.log(ids.map(idOf).join(), labels.map(labelOf).join(), stamps.map(age).join())
console.log([entity, stored, both].map(show).join(" ; "))
const storedAsLabel: HasLabel = stored
const storedAsStamps: Stamps = stored
storedAsStamps.updated = 150
storedAsLabel.note = "late"
ids[1].id = 20
console.log(show(stored), stored.id, stored.note, stored.updated, age(stored), labelOf(stored))
delete storedAsStamps.updated
storedAsStamps.updated = 101
console.log(show(stored), "updated" in entity, (entity as Partial<Stored>).updated)

const overlap: Overlap = { shared: 2, id: 1, extra: true }
const leftHalf: { id: number; shared: number | string } = overlap
const rightHalf: { shared: number; extra: boolean } = overlap
rightHalf.shared += 0.5
console.log(leftHalf.shared, overlap.shared * 2, typeof leftHalf.shared, show(overlap))

const frog: Amphibian = { legs: 4, fins: 0, walk() { return "walk " + this.legs }, swim() { return "swim " + this.fins + "/" + this.legs } }
const walker: Walker = frog
const swimmer: Swimmer = frog
walker.legs = 2
swimmer.fins = 1
console.log(frog.walk(), frog.swim(), walker.walk(), swimmer.swim(), Object.keys(swimmer).join())

// The two halves are put together by a generic function.
function merge<A extends object, B extends object>(x: A, y: B): A & B { return { ...x, ...y } }
const merged = merge(stored, { extra: [1], id: 77 })
console.log(show(merged), merged.id, merged.extra.length, merged.created, stored.id, idOf(merged), age(merged))
// The second half arrives after creation, by Object.assign. (Such an object seen as that half alone, or cast from any: type-rules/intersection-types.)
function withId<T extends object>(value: T, id: number): T & HasId { return Object.assign(value, { id }) }
const labelled: HasLabel = { label: "grown" }, direct: HasLabel = { label: "direct" }
const grown = withId(labelled, 9), grownDirectly: HasLabel & HasId = Object.assign(direct, { id: 8 })
console.log(grown.id, grown.label, show(labelled), (grown as object) === labelled, grownDirectly.id, show(direct))

// An intersection distributes over a union.
type Painted = ({ kind: "c"; r: number } | { kind: "s"; side: number }) & { colour: string }
function paint(p: Painted): string { return p.colour + (p.kind === "c" ? " circle " + p.r : " square " + p.side) }
const painted: Painted[] = [{ kind: "c", r: 1, colour: "red" }, { colour: "blue", side: 2, kind: "s" }]
const colours: { colour: string }[] = painted
colours[0].colour = "green"
console.log(painted.map(paint).join(), painted.map(show).join(" ; "))

// A branded primitive is a primitive: the object half of the intersection exists in the checker only.
type Brand<T, B extends string> = T & { readonly __brand: B }
type UserId = Brand<number, "user">
type Slug = Brand<string, "slug">
function userId(n: number): UserId { return n as UserId }
function slug(s: string): Slug { return s as Slug }
const users: UserId[] = [userId(5), userId(2.5), userId(-0), userId(NaN)]
const account: { owner: UserId; path: Slug; previous?: UserId } = { owner: users[0], path: slug("a-b") }
console.log(users.map(u => typeof u + (u + 1)).join(), account.owner * 2, account.path.length, account.path.toUpperCase(), account.path + "!", show(account), Object.is(users[2], -0))
account.previous = account.owner
account.owner = userId(account.owner + 1)
console.log(account.owner, account.previous, account.owner > account.previous, new Map<UserId, Slug>([[account.owner, account.path]]).get(userId(6)), `${account.path}/${account.owner}`)

let total = 0
for (let i = 0; i < 3000; i++) total += idOf(ids[i & 3]) + labelOf(labels[i & 3]).length + age(stamps[i % 3])
console.log(total)
//// intersections-type-variable-and-empty-member.ts
interface P0 { p0: number }
interface P1 { p1: number }
interface P2 { p2: number }
interface P3 { p3: number }
interface P4 { p4: number }
interface P5 { p5: number }
interface P6 { p6: number }
interface P7 { p7: number }
interface P8 { p8: number }
interface P9 { p9: number }
interface P10 { p10: number }
interface P11 { p11: number }
interface P12 { p12: number }
interface P13 { p13: number }
interface P14 { p14: number }
interface P15 { p15: number }
interface P16 { p16: number }
interface P17 { p17: number }
type Wide = P0 & P1 & P2 & P3 & P4 & P5 & P6 & P7 & P8 & P9 & P10 & P11 & P12 & P13 & P14 & P15 & P16 & P17;
type WideAndEmpty = Wide & {};
function sure<T>(value: T): T & {} { if (value === null || value === undefined) throw new Error("nothing"); return value; }
function field<T, K extends keyof T>(from: Partial<T>, key: K): Partial<T>[K] & {} { return sure(from[key]); }
function both<T extends Wide>(value: T & {}): T { return value; }
function widen(value: Wide): WideAndEmpty { return value; }
function narrow(value: WideAndEmpty): Wide { return value; }
const wide: Wide = { p0: 0, p1: 1, p2: 2, p3: 3, p4: 4, p5: 5, p6: 6, p7: 7, p8: 8, p9: 9, p10: 10, p11: 11, p12: 12, p13: 13, p14: 14, p15: 15, p16: 16, p17: 17 };
console.log(sure(3), sure("s"), field<Wide, "p5">({ p5: 5 }, "p5"), both(wide).p7, narrow(widen(wide)).p17);
try { sure(undefined); } catch (error) { console.log((error as Error).message); }
//// json-stringify-after-untyped-code-changed-the-objects/deeds.js
export const deeds = {
  nothing: (o) => o,
  addProperty: (o) => { o.added = "later"; return o; },
  addNumberedProperty: (o) => { o[3] = "indexed"; return o; },
  addSymbol: (o) => { o[Symbol("s")] = 1; return o; },
  removeFirst: (o) => { delete o.id; return o; },
  removeMiddle: (o) => { delete o.text; return o; },
  removeAndAddAgain: (o) => { delete o.text; o.text = "after the others"; return o; },
  getter: (o) => Object.defineProperty(o, "text", { get() { return "from a getter"; }, enumerable: true, configurable: true }),
  getterWithEffect: (o) => Object.defineProperty(o, "text", { get() { o.id = -1; return "changes id"; }, enumerable: true, configurable: true }),
  getterFirstChangesLater: (o) => Object.defineProperty(o, "id", { get() { o.text = "changed by the getter of id"; return 0; }, enumerable: true, configurable: true }),
  extraGetter: (o) => Object.defineProperty(o, "extra", { get() { return "from a getter"; }, enumerable: true, configurable: true }),
  extraGetterWithEffect: (o) => Object.defineProperty(o, "extra", { get() { o.text = "changed while it was written"; return 1; }, enumerable: true, configurable: true }),
  extraGetterThatThrows: (o) => Object.defineProperty(o, "extra", { get() { throw new RangeError("thrown by a getter"); }, enumerable: true, configurable: true }),
  extraHidden: (o) => Object.defineProperty(o, "extra", { value: 1, enumerable: false }),
  hide: (o) => Object.defineProperty(o, "text", { enumerable: false }),
  readOnly: (o) => Object.defineProperty(o, "text", { writable: false }),
  ownToJSON: (o) => { o.toJSON = function () { return { replaced: this.id }; }; return o; },
  hiddenToJSON: (o) => Object.defineProperty(o, "toJSON", { value() { return "hidden toJSON"; }, enumerable: false }),
  toJSONThatIsNoFunction: (o) => { o.toJSON = 5; return o; },
  prototypeWithToJSON: (o) => Object.setPrototypeOf(o, { toJSON() { return "by the prototype"; } }),
  prototypeTwoUp: (o) => Object.setPrototypeOf(o, Object.create({ toJSON() { return "two steps up"; } })),
  prototypeWithoutToJSON: (o) => Object.setPrototypeOf(o, { other: 1 }),
  nullPrototype: (o) => Object.setPrototypeOf(o, null),
  proxyPrototype: (o) => Object.setPrototypeOf(o, new Proxy({}, { get(target, key) { return key === "toJSON" ? () => "through a proxy" : undefined; } })),
  freeze: (o) => Object.freeze(o),
  seal: (o) => Object.seal(o),
  preventExtensions: (o) => Object.preventExtensions(o),
  otherKinds: (o) => { o.id = "a text"; o.text = 7; o.on = null; o.ratio = { object: 1 }; return o; },
  undefinedEverywhere: (o) => { o.id = undefined; o.text = undefined; o.on = undefined; return o; },
  functionsAndSymbols: (o) => { o.id = () => 1; o.text = Symbol("t"); return o; },
  bigint: (o) => { o.id = 10n; return o; },
  itself: (o) => { o.next = o; return o; },
  itselfInAList: (o) => { o.list = [o]; return o; },
  wideText: (o) => { o.text = "wide 日本語 😀"; return o; },
  loneSurrogate: (o) => { o.text = "lone \ud800"; return o; },
  escapes: (o) => { o.text = "q \" b \\ n \n u \u0001"; return o; },
  rope: (o) => { let t = "r"; for (let i = 0; i < 9; i++) t = t + "o" + i; o.text = t; return o; },
  boxed: (o) => { o.id = new Number(5); o.text = new String("boxed"); o.on = new Boolean(false); return o; },
  date: (o) => { o.next = new Date(0); return o; },
  listWithHole: (o) => { o.list = [1, , 3]; return o; },
  listWithToJSON: (o) => { o.list = [1]; o.list.toJSON = () => "list toJSON"; return o; },
  listOfPlain: (o) => { o.list = [{ p: 1 }, { p: 2 }]; return o; },
  plainInside: (o) => { o.next = { plain: true, deep: { a: [1, { b: 2 }] } }; return o; },
  plainWithToJSONInside: (o) => { o.next = { toJSON() { return "inner toJSON"; } }; return o; },
  numbers: (o) => { o.id = -0; o.ratio = NaN; return o; },
  moreNumbers: (o) => { o.id = 2147483648.5; o.ratio = -Infinity; return o; },
  edgeNumbers: (o) => { o.id = -2147483648; o.ratio = 5e-324; return o; },
};
//// json-stringify-after-untyped-code-changed-the-objects/main.ts
// Untyped code changes objects that have a layout (adds, deletes, hides, freezes, gives them toJSON, other prototypes, cycles),
// and code that does not know their type writes them as JSON. Every change succeeds as in plain Bun, and what is written must be exact.
// ENV JSC_aotCountsPath=/dev/null
declare const aotRuntimeCounters: undefined | (() => string);
const writersFailed = () => (typeof aotRuntimeCounters === "function" ? Number(/(\d+)\tJSONWriterFailed/.exec(aotRuntimeCounters())![1]) : 0);
import { deeds } from "./deeds.js";
declare const aotOperationCount: undefined | ((name: string) => number);
const count = (name: string) => (typeof aotOperationCount === "function" ? aotOperationCount(name) : 0);
const writers: Record<string, (value: unknown) => string> = {
  write: (value) => { try { return JSON.stringify(value) as string; } catch (error) { return (error as Error).constructor.name; } },
};
let coverage = "";
function write(value: unknown): string {
  const entered = count("operationAOTJSONAppendValue"), finished = (count("operationAOTJSONWriterFinish") - writersFailed());
  const text = writers["write"]!(value);
  coverage += (count("operationAOTJSONWriterFinish") - writersFailed()) > finished ? "W" : count("operationAOTJSONAppendValue") > entered ? "f" : "-";
  return text;
}
interface Row { id: number; text: string; on: boolean; ratio: number; next: Row | null; list: number[]; maybe?: string }
interface Holds { value: unknown }
class Point { x: number; text: string; id: number; constructor(x: number) { this.x = x; this.text = "p" + x; this.id = x; } }
function row(id: number): Row { return { id, text: "t" + id, on: id % 2 === 0, ratio: id / 8, next: null, list: [id, id + 1] }; }
function holds(value: unknown): Holds { return { value }; }
interface Open { id: unknown; text: unknown; on: unknown; ratio: unknown; next: unknown; list: unknown }
function open(id: number): Open { return { id, text: "t" + id, on: true, ratio: id / 8, next: null, list: [id] }; }
function attempt(label: string, make: () => unknown): void {
  let value: unknown;
  try { value = make(); } catch (error) { coverage += "x"; console.log(label, "the deed is refused:", (error as Error).constructor.name); return; }
  console.log(label, write(value));
}
let turn = 0;
for (const [name, deed] of Object.entries(deeds as Record<string, (o: unknown) => unknown>)) {
  const id = ++turn * 10;
  attempt(name, () => deed(row(id)));
  attempt(name + " in a list", () => [row(id + 1), deed(row(id + 2)), row(id + 3)]);
  attempt(name + " held", () => holds(deed(row(id + 4))));
  attempt(name + " held in a list", () => holds([deed(row(id + 5))]));
  attempt(name + " of a class", () => deed(new Point(id + 6)));
  attempt(name + " in an open field", () => deed(open(id + 7)));
  attempt(name + " afterwards", () => row(id + 8));
}
if (typeof aotOperationCount === "function") {
  const written = coverage.split("W").length - 1;
  if (written < 100) throw new Error("only " + written + " values were written by compiled code");
}
//// json-stringify-any-field.ts
interface A { i: number; d: number; s: string; t: boolean; n: null; o?: string; p?: number; child?: A | null; list?: A[] }
interface B { kind: "b"; x: number; y: number }
interface C { kind: "c"; label: string }
interface Odd { "quo\"te": number; "back\\slash": number; "tab\there": number; plain: number }
interface Wide { "ключ": number; plain: string }
interface Big { f00: number; f01: number; f02: number; f03: number; f04: number; f05: number; f06: number; f07: number; f08: number; f09: number; f10: string; f11: string; f12: string; f13: string; f14: string; f15: string; f16: boolean; f17: boolean; f18: null; f19: number; f20?: number; f21?: string; f22?: number; f23?: string }
class Point { #hidden = 5; constructor(public x: number, public y: number) {} get sum() { return this.x + this.y + this.#hidden; } norm() { return 0; } static made = 1; }
class Point3 extends Point { z = 3; }
class Jsonable { v = 1; toJSON() { return { from: "toJSON", v: this.v }; } }
class OwnToJSON { toJSON: unknown; v = 2; constructor(f: unknown) { this.toJSON = f; } }
let count = 0;
////= show-3	out = String(JSON.stringify(make(), rest[0] as any, rest[1] as any)
const a = (i: number): A => ({ i, d: i + 0.5, s: "s" + i, t: (i & 1) === 1, n: null });
show("every kind of field", () => a(1));
show("negative, zero, large, not an int32", () => [{ ...a(0), i: -1 }, { ...a(0), i: 0 }, { ...a(0), i: 2147483647 }, { ...a(0), i: 2147483648 }, { ...a(0), i: -2147483648 }, { ...a(0), i: 1e21 }] as A[]);
show("-0, NaN, Infinity in a number field", () => [{ ...a(0), d: -0 }, { ...a(0), d: NaN }, { ...a(0), d: Infinity }, { ...a(0), i: -0 }, { ...a(0), i: NaN }] as A[]);
show("optional fields absent, one, both, in either order", () => { const w = a(1), x = a(2), y = a(3), z = a(4); x.o = "o"; y.o = "o"; y.p = 1; z.p = 1; z.o = "o"; return [w, x, y, z]; });
show("optional field set to undefined", () => { const x = a(1); x.o = undefined; x.p = 2; return x; });
show("optional field deleted", () => { const x = a(1); x.o = "o"; x.p = 2; delete x.o; return x; });
show("nested", () => { const x = a(1); x.child = a(2); x.child.child = a(3); x.child.child.child = null; return x; });
show("a list of one shape", () => { const x = a(0); x.list = [a(1), a(2), a(3), a(4)]; return x; });
show("shapes in turn", () => [{ kind: "b", x: 1, y: 2 } as B, { kind: "c", label: "l" } as C, { kind: "b", x: 3, y: 4 } as B, { kind: "c", label: "m" } as C, a(1), { kind: "b", x: 5, y: 6 } as B]);
show("one shape, orders in turn", () => { const out: A[] = []; for (let i = 0; i < 6; i++) { const x = a(i); if (i & 1) { x.o = "o"; x.p = i; } else { x.p = i; x.o = "o"; } out.push(x); } return out; });
show("typed and plain in turn", () => [a(1), JSON.parse('{"i":1,"z":2}'), a(2), {}, a(3), [], a(4)]);
show("strings that need escaping", () => [{ ...a(0), s: 'q"uote' }, { ...a(0), s: "back\\slash" }, { ...a(0), s: "new\nline" }, { ...a(0), s: "\u0001" }, { ...a(0), s: "\u007f" }, { ...a(0), s: "é" }] as A[]);
show("16-bit strings, lone surrogates", () => [{ ...a(0), s: "значение" }, { ...a(0), s: "\ud800" }, { ...a(0), s: "😀" }] as A[]);
show("a long string, a rope, an empty string", () => [{ ...a(0), s: "x".repeat(200) }, { ...a(0), s: "left".repeat(10) + String(count) + "right".repeat(10) }, { ...a(0), s: "" }] as A[]);
show("field names that need escaping", () => ({ 'quo"te': 1, "back\\slash": 2, "tab\there": 3, plain: 4 }) as Odd);
show("a 16-bit field name", () => ({ "ключ": 1, plain: "p" }) as Wide);
show("many fields", () => ({ f00: 0, f01: 1, f02: 2, f03: 3, f04: 4, f05: 5, f06: 6, f07: 7, f08: 8, f09: 9, f10: "a", f11: "b", f12: "c", f13: "d", f14: "e", f15: "f", f16: true, f17: false, f18: null, f19: 19.5 }) as Big);
show("many fields, the optional ones in another order", () => { const b: Big = { f00: 0, f01: 1, f02: 2, f03: 3, f04: 4, f05: 5, f06: 6, f07: 7, f08: 8, f09: 9, f10: "a", f11: "b", f12: "c", f13: "d", f14: "e", f15: "f", f16: true, f17: false, f18: null, f19: 19.5 }; b.f23 = "z"; b.f20 = 20; b.f22 = 22; b.f21 = "y"; return b; });
show("a class instance: private field, accessor, method, static", () => new Point(1, 2));
show("instances of a class and its heir in turn", () => [new Point(1, 2), new Point3(3, 4), new Point(5, 6), new Point3(7, 8)]);
show("a class with toJSON among others", () => [new Point(1, 2), new Jsonable(), new Point(3, 4)]);
show("an own field toJSON: callable, not callable", () => [new OwnToJSON(() => "called"), new OwnToJSON(5), new OwnToJSON(undefined)]);
show("a field that holds a function, a symbol", () => [{ v: 1, f: () => 1 }, { v: 2, f: Symbol("s") }] as { v: number; f: unknown }[]);
show("a field that holds a bigint", () => ({ v: 1, f: 1n }) as { v: number; f: unknown });
show("frozen, sealed, not extensible", () => [Object.freeze(a(1)), Object.seal(a(2)), Object.preventExtensions(a(3))]);
show("the same object twice", () => { const x = a(1); return [x, x, { x }]; });
show("a cycle", () => { const x = a(1); x.child = x; return x; });
show("indent 2", () => { const x = a(1); x.list = [a(2)]; return x; }, undefined, 2);
show("replacer list", () => a(1), ["s", "i"]);
show("replacer function", () => a(1), (k: string, v: unknown) => (k === "d" ? undefined : v));
show("longer than the first buffer", () => { const x = a(0); x.list = []; for (let i = 0; i < 300; i++) x.list.push(a(i)); const text = JSON.stringify(x); return text.length + " " + text.slice(8180, 8210) + " " + text.slice(-40); });
show("longer than the first buffer, 16-bit at the end", () => { const x = a(0); x.list = []; for (let i = 0; i < 300; i++) x.list.push(a(i)); x.list[299]!.s = "конец"; const text = JSON.stringify(x); return text.length + " " + text.slice(-60); });
show("exactly at the buffer's edge", () => { const out: number[] = []; for (let n = 8150; n < 8200; n++) { const x = a(1); x.s = "y".repeat(n - 50); out.push(JSON.stringify([x, a(2)]).length); } return out.join(); });
//// json-stringify-arrays-that-unseen-code-has-held.ts
// Records whose arrays went once through text that is evaluated at run time: nothing is proven of what the arrays hold, and the declared types are all that is known.
interface Rec { id: number; name: string; ok: boolean; tags: string[] }
interface Grid { rows: string[][]; sizes: number[]; flags: boolean[] }
interface Holder { list: Rec[]; last: string }
interface Mixed { values: (string | number | null)[]; end: number }

const word: string = process.argv[2] ?? "w";
const launder = new Function("v", "return v" + word.slice(word.length)) as <V>(v: V) => V;
const change = new Function("v", "f", "f(v); return v" + word.slice(word.length)) as <V>(v: V, f: (v: any) => void) => V;

let count = 0;
////= show-2	out = String(make()

const rec = (i: number, tags: string[]): Rec => launder({ id: i, name: word + i, ok: (i & 1) === 1, tags });
function writeRec(r: Rec): string { return JSON.stringify(r); }
function writeGrid(g: Grid): string { return JSON.stringify(g); }
function writeHolder(h: Holder): string { return JSON.stringify(h); }
function writeMixed(m: Mixed): string { return JSON.stringify(m); }

show("two strings", () => writeRec(rec(1, [word, "b"])));
show("no element", () => writeRec(rec(2, [])));
show("one element", () => writeRec(rec(3, ["only"])));
show("strings that need escaping, wide strings, ropes", () => writeRec(rec(4, ['q"', "\\", "\n", "é", "значение", "\ud800", word.repeat(20) + count + word.repeat(20), ""])));
show("a hole in the middle", () => writeRec(rec(5, change(["a", "b", "c"], v => { delete v[1]; }))));
show("a hole at the end, by length", () => writeRec(rec(6, change(["a"], v => { v.length = 3; }))));
show("undefined, a function, a symbol among the elements", () => writeRec(rec(9, change(["a", "b", "c", "d"], v => { v[0] = undefined; v[1] = () => 1; v[2] = Symbol("s"); }))));
show("numbers, booleans, null in place of strings", () => writeRec(rec(10, change(["a", "b", "c", "d", "e"], v => { v[0] = 1; v[1] = 1.5; v[2] = true; v[3] = null; v[4] = -0; }))));
show("only integers in place of strings", () => writeRec(rec(11, launder([1, 2, 3] as unknown as string[]))));
show("only fractions in place of strings", () => writeRec(rec(12, launder([1.5, NaN, Infinity] as unknown as string[]))));
show("a bigint element", () => writeRec(rec(13, change(["a"], v => { v[0] = 1n; }))));
show("an element with toJSON, which gets its index", () => writeRec(rec(14, change(["a", "b"], v => { v[1] = { toJSON(k: string) { return typeof k + ":" + k; } }; }))));
show("an element whose toJSON answers undefined", () => writeRec(rec(15, change(["a", "b"], v => { v[0] = { toJSON() { return undefined; } }; }))));
show("an element whose toJSON shortens the array", () => {
  const tags = ["a", "b", "c", "d"];
  return writeRec(rec(16, change(tags, v => { v[1] = { toJSON() { tags.length = 2; return "cut"; } }; })));
});
show("an element whose toJSON lengthens the array", () => {
  const tags = ["a", "b"];
  return writeRec(rec(17, change(tags, v => { v[0] = { toJSON() { tags.push("late"); return "grown"; } }; })));
});
show("an element whose toJSON turns the strings into numbers", () => {
  const tags = ["a", "b", "c"];
  return writeRec(rec(18, change(tags, v => { v[0] = { toJSON() { v[1] = 1.5; v[2] = 7; return "first"; } }; })));
});
show("an element whose toJSON changes the record", () => {
  const r = rec(19, ["a", "b"]);
  change(r.tags, v => { v[0] = { toJSON() { (r as any).added = 1; delete (r as any).ok; return "x"; } }; });
  return writeRec(r) + " " + writeRec(r);
});
show("String objects among the strings", () => writeRec(rec(20, change(["a", "b"], v => { v[0] = new String("boxed"); v[1] = Object.assign(new String("own"), { toString() { return "by toString"; } }); }))));
show("a toJSON on String.prototype", () => {
  (String.prototype as any).toJSON = function () { return "T(" + this + ")"; };
  try { return writeRec(rec(21, ["a", "b"])); } finally { delete (String.prototype as any).toJSON; }
});
show("an own toJSON on the array", () => writeRec(rec(23, change(["a"], v => { v.toJSON = (k: string) => "own " + k; }))));
show("an own named property on the array", () => writeRec(rec(24, change(["a"], v => { v.extra = 1; }))));
show("a getter for an index", () => writeRec(rec(25, change(["a", "b"], v => { Object.defineProperty(v, 0, { get() { return "got"; }, enumerable: true, configurable: true }); }))));
show("a frozen array", () => writeRec(rec(26, Object.freeze(["a", "b"]) as string[])));
show("a sparse array", () => writeRec(rec(27, change(["a"], v => { v[5000] = "far"; })) ).length);
class Tags extends Array<string> { label = "l"; }
show("an instance of a class that extends Array", () => writeRec(rec(28, Tags.from(["a", "b"]) as string[])));
class TagsWithToJSON extends Array<string> { toJSON() { return "tags:" + this.join("+"); } }
show("an instance of a class that extends Array and has toJSON", () => writeRec(rec(29, TagsWithToJSON.from(["a", "b"]) as string[])));
show("a proxy of an array", () => {
  const seen: string[] = [];
  const text = writeRec(rec(30, new Proxy(["a", "b"], { get(t, k, r) { seen.push(String(k)); return Reflect.get(t, k, r); } })));
  return text + " " + seen.join();
});
show("a revoked proxy of an array", () => { const p = Proxy.revocable(["a"], {}); p.revoke(); return writeRec(rec(31, p.proxy)); });
show("an array of another realm's look: arguments, a typed array, an array-like", () => [
  writeRec(rec(32, (function (..._: string[]) { return arguments; })("a", "b") as unknown as string[])),
  writeRec(rec(33, new Uint8Array([1, 2]) as unknown as string[])),
  writeRec(rec(34, { length: 1, 0: "a" } as unknown as string[])),
].join(" "));
show("not an array at all", () => [null, undefined, () => 1, new Date(0), new Map([[1, 2]]), /x/, {}].map(v => writeRec(rec(35, v as unknown as string[]))).join(" "));
show("the array holds itself", () => { const tags: string[] = ["a"]; change(tags, v => { v.push(v); }); return writeRec(rec(36, tags)); });
show("the array holds the record", () => { const r = rec(37, ["a"]); change(r.tags, v => { v.push(r); }); return writeRec(r); });
show("the same array in two records", () => { const tags = launder(["s"]); return writeRec(rec(38, tags)) + writeRec(rec(39, tags)); });

show("nested arrays", () => writeGrid(launder({ rows: [[word, "b"], [], ["c"]], sizes: [1, 2.5, -0], flags: [true, false] })));
show("nested arrays with holes, strangers and arrays in place of strings", () => writeGrid(launder({
  rows: change([["a", "b"], ["c"], ["d"]], v => { delete v[0][0]; v[1] = "flat"; v[2][0] = ["deeper", [1]]; v.push(undefined, null, {}); }),
  sizes: change([1, 2, 3], v => { v[0] = "one"; delete v[1]; }),
  flags: change([true], v => { v[0] = 0; v.push("yes"); }),
})));
show("numbers of every storage", () => [[1, 2], [1.5, 2], [1, "x"], [], [2 ** 31], [-(2 ** 31) - 1], [1e21, 1e-7]].map(sizes => writeGrid(launder({ rows: [], sizes: sizes as number[], flags: [] }))).join(" "));

show("records in a list", () => writeHolder(launder({ list: [rec(40, ["a"]), rec(41, [])], last: "z" })));
show("strangers in a list of records", () => writeHolder(launder({
  list: change([rec(42, ["a"]), rec(43, ["b"]), rec(44, ["c"])], v => { v[0] = { id: 1 }; v[1] = JSON.parse('{"tags":["p"],"id":2,"z":[{}]}'); delete v[2].name; v.push(7, "s", [rec(45, [])]); }),
  last: "z",
})));
show("a record of the list has toJSON", () => writeHolder(launder({ list: change([rec(46, ["a"]), rec(47, ["b"])], v => { v[0].toJSON = function (k: string) { return [k, this.id]; }; }), last: "z" })));

show("a union of primitives", () => writeMixed(launder({ values: ["a", 1, null, 1.5, "b"], end: 1 })));
show("a union of primitives with strangers", () => writeMixed(launder({ values: change(["a", 1, null], v => { v.push(true, undefined, {}, [], 2n ** 0n === 1n ? "big" : "small"); }), end: 2 })));

show("many times over", () => {
  const r = rec(48, [word, "DELETE"]);
  let total = 0;
  for (let i = 0; i < 20000; i++) total += writeRec(r).length;
  r.tags.push("more");
  for (let i = 0; i < 20000; i++) total += writeRec(r).length;
  return total;
});
//// json-stringify-code-that-runs-inside-a-write.ts
// While a typed object with undeclared keys is being written, a toJSON method or an accessor of a value below it runs code that writes tens of thousands of other kinds of object, parses, collects, and changes the object that is being written.
interface Item { id: number }
interface Holder { first: number; items: Item[]; last: string }
const host: any = globalThis;
const collect: () => void = host.Bun ? () => host.Bun.gc(true) : host.gc;
let serial = 0;

function crowd(count: number): Item[] {
  const items: string[] = [];
  for (let at = 0; at < count; at++) items.push('{"id":' + at + ',"k' + ++serial + '":' + at + "}");
  return JSON.parse("[" + items.join(",") + "]") as Item[];
}
const text = '{"a":"before","first":1,"b":{"inner":1},"items":[{"id":1,"x":1}],"c":"behind","last":"l","d":{"e":null},"f":"' + "x".repeat(40) + '"}';
const expected = (b: string) => text.replace('{"inner":1}', b);

const deeds: [string, (holder: any) => void][] = [
  ["writes 20,000 kinds", () => { for (const item of crowd(20000)) JSON.stringify(item); }],
  ["writes 40,000 kinds in one list", () => { JSON.stringify(crowd(40000)); }],
  ["writes 16,384 kinds, one by one, twice", () => { const items = crowd(16384); for (let round = 0; round < 2; round++) for (const item of items) JSON.stringify(item); }],
  ["writes the holder itself", holder => { if (depth++ < 3) JSON.stringify(holder); depth--; }],
  ["parses 20,000 kinds", () => { crowd(20000); }],
  ["collects", () => { collect(); collect(); }],
  ["writes, drops and collects", () => { for (const item of crowd(20000)) JSON.stringify(item); collect(); }],
];
let depth = 0;
for (const [label, deed] of deeds) {
  const answers: string[] = [];
  {
    const holder: any = JSON.parse(text) as Holder;
    for (let round = 0; round < 3; round++) JSON.stringify(holder);
    holder.b.toJSON = () => { deed(holder); return 7; };
    answers.push(JSON.stringify(holder) === expected("7") ? "same" : "DIFFERENT");
    answers.push(JSON.stringify([holder, holder]) === "[" + expected("7") + "," + expected("7") + "]" ? "same" : "DIFFERENT");
  }
  {
    const holder: any = JSON.parse(text) as Holder;
    for (let round = 0; round < 3; round++) JSON.stringify(holder);
    Object.defineProperty(holder.b, "inner", { get() { deed(holder); return 8; }, enumerable: true });
    answers.push(JSON.stringify(holder) === expected('{"inner":8}') ? "same" : "DIFFERENT");
  }
  {
    const holder: any = JSON.parse(text) as Holder;
    for (let round = 0; round < 3; round++) JSON.stringify(holder);
    holder.items[0].x = { toJSON() { deed(holder); return 9; } };
    answers.push(JSON.stringify(holder) === text.replace('"x":1', '"x":9') ? "same" : "DIFFERENT");
  }
  console.log("code that " + label + ": " + answers.join(", "));
}

const changes: [string, (holder: any) => void][] = [
  ["adds a key", holder => { holder.z = 1; }],
  ["adds a hundred keys", holder => { for (let at = 0; at < 100; at++) holder["z" + at] = at; }],
  ["deletes the keys behind", holder => { delete holder.c; delete holder.d; delete holder.f; }],
  ["deletes a declared member", holder => { delete holder.last; }],
  ["deletes all undeclared keys", holder => { for (const key of ["a", "b", "c", "d", "f"]) delete holder[key]; }],
  ["stores another kind of value", holder => { holder.c = { deep: [1] }; holder.f = 5; }],
  ["empties the list", holder => { holder.items.length = 0; }],
  ["makes a key an accessor", holder => { Object.defineProperty(holder, "f", { get: () => "got", enumerable: true, configurable: true }); }],
  ["freezes it", holder => { Object.freeze(holder); }],
];
for (const [label, change] of changes) {
  const make = (parse: (text: string) => any) => {
    const holder = parse(text);
    for (let round = 0; round < 3; round++) JSON.stringify(holder);
    holder.b.toJSON = () => { change(holder); return 7; };
    return holder;
  };
  const typed = JSON.stringify(make(text => JSON.parse(text) as Holder));
  const plain = JSON.stringify(make(host.JSON.parse));
  console.log("code that " + label + ": " + (typed === plain ? "same" : "DIFFERENT: " + typed + " | " + plain));
}
//// json-stringify-date-fields.ts
declare const aotRuntimeCounters: () => string;
const writersFailed = () => Number(/(\d+)\tJSONWriterFailed/.exec(aotRuntimeCounters())![1]);
declare const aotOperationCount: (name: string) => number;
interface Post { id: number; createdAt: Date; updatedAt: Date | null; deletedAt?: Date }
interface Log { name: string; at: Date[] }
class Stamp extends Date { }
class Loud extends Date { toJSON(): string { return "loud"; } }
function measure(label: string, run: () => string): void {
    const finished = (aotOperationCount("operationAOTJSONWriterFinish") - writersFailed());
    let text = "";
    for (let i = 0; i < 100; i++) text = run();
    console.log(label + ": " + text + ": " + ((aotOperationCount("operationAOTJSONWriterFinish") - writersFailed()) - finished) + " texts finished by compiled code");
}
function post(createdAt: Date, updatedAt: Date | null): Post {
    return { id: 1, createdAt, updatedAt };
}
const usual = post(new Date(1700000000123), new Date(1700000086400));
const withNull = post(new Date(0), null);
const invalid = post(new Date(NaN), new Date(Infinity));
const early = post(new Date(-1), new Date(-62167219200000));
const beforeYearZero = post(new Date(-62167219200001), new Date(-8640000000000000));
const late = post(new Date(253402300799999), new Date(253402300800000));
const last = post(new Date(8640000000000000), new Date(8640000000000001));
const leap = post(new Date(Date.UTC(2024, 1, 29, 23, 59, 59, 999)), new Date(Date.UTC(1900, 1, 28, 12)));
const fraction = post(new Date(1.9), new Date(-1.9));
const deleted: Post = { id: 2, createdAt: new Date(1), updatedAt: null, deletedAt: new Date(2) };
const log: Log = { name: "log", at: [new Date(1), new Date(2), new Date(NaN)] };
const ownToJSON = post(new Date(5), null);
(ownToJSON.createdAt as any).toJSON = () => "mine";
const ownToISOString = post(new Date(5), null);
(ownToISOString.createdAt as any).toISOString = () => "mine too";
const ownOther = post(new Date(5), null);
(ownOther.createdAt as any).other = 1;
const subclass = post(new Stamp(6), new Loud(7));
const changed = post(new Date(8), null);
changed.createdAt.setTime(9);

measure("two dates", () => JSON.stringify(usual));
measure("a date and null", () => JSON.stringify(withNull));
measure("invalid dates", () => JSON.stringify(invalid));
measure("before 1970 and the first of the year 0", () => JSON.stringify(early));
measure("before the year 0 and the first date there is", () => JSON.stringify(beforeYearZero));
measure("the last of the year 9999 and the one behind it", () => JSON.stringify(late));
measure("the last date there is and one too late", () => JSON.stringify(last));
measure("a leap day and a year that has none", () => JSON.stringify(leap));
measure("fractions of a millisecond", () => JSON.stringify(fraction));
measure("an optional date", () => JSON.stringify(deleted));
measure("a list of dates", () => JSON.stringify(log));
measure("set to another time", () => JSON.stringify(changed));
measure("in a plain literal", () => JSON.stringify({ at: usual.createdAt, none: invalid.createdAt } as any));
measure("with a toJSON of its own", () => JSON.stringify(ownToJSON));
measure("with a toISOString of its own", () => JSON.stringify(ownToISOString));
measure("with another property of its own", () => JSON.stringify(ownOther));
measure("of classes that extend Date", () => JSON.stringify(subclass));
measure("a date by itself", () => JSON.stringify(usual.createdAt));
//// json-stringify-deep-values-that-were-parsed-by-a-type.ts
// Deep values that `JSON.parse(text) as T` made are written, cloned and compared with what plain objects give.
type Tree = { kids: Tree[] };
type Chain = { next: Chain | null; name: string };
type Deep = Deep[];
const plainParse: (text: string) => any = globalThis.JSON.parse;
function say(run: () => unknown): string {
  try {
    const value = run();
    return typeof value === "string" ? "text of " + value.length : typeof value;
  } catch (error: any) {
    return error.name + ": " + error.message;
  }
}
const roads: [string, (text: string) => unknown, (levels: number) => string][] = [
  ["Tree", text => JSON.parse(text) as Tree, levels => '{"kids":['.repeat(levels) + "]}".repeat(levels)],
  ["Tree with undeclared keys", text => JSON.parse(text) as Tree, levels => '{"u":1,"kids":['.repeat(levels) + '],"v":"w"}'.repeat(levels)],
  ["Chain", text => JSON.parse(text) as Chain, levels => '{"next":'.repeat(levels) + "null" + ',"name":"n"}'.repeat(levels)],
  ["Deep", text => JSON.parse(text) as Deep, levels => "[".repeat(levels) + "]".repeat(levels)],
];
for (const [label, parse, text] of roads) {
  for (const levels of [10, 47, 48, 49, 50, 100, 1000]) {
    const given = text(levels);
    const typed = parse(given);
    const plain = plainParse(given);
    const answers = [
      [say(() => JSON.stringify(typed)), say(() => JSON.stringify(plain))],
      [say(() => JSON.stringify(typed, null, 1)), say(() => JSON.stringify(plain, null, 1))],
      [say(() => JSON.stringify([typed, { a: typed }])), say(() => JSON.stringify([plain, { a: plain }]))],
      [say(() => JSON.stringify(structuredClone(typed))), say(() => JSON.stringify(structuredClone(plain)))],
    ];
    console.log(label + ", " + levels + " levels: " + answers.map(([one, other]) => (one === other ? "same" : "DIFFERENT: " + one + " | " + other)).join(", "));
  }
  const deep = text(400);
  const typed = parse(deep);
  const expected = say(() => JSON.stringify(plainParse(deep)));
  let frames = 0;
  let wrong = 0;
  let written = 0;
  const dive = (level: number): void => {
    try {
      dive(level + 1);
    } catch {
      if (frames === 0) frames = level;
    }
    if (frames - level > 600) return;
    const said = say(() => JSON.stringify(typed));
    if (said === expected) written++;
    else if (said !== "RangeError: Maximum call stack size exceeded.") wrong++;
  };
  dive(0);
  console.log(label + ", written near the end of the stack: " + wrong + " answers are neither the text nor a RangeError, " + (written ? "some" : "NO") + " texts");
}
//// json-stringify-dispatch-by-object.ts
declare const aotRuntimeCounters: () => string;
const writersFailed = () => Number(/(\d+)\tJSONWriterFailed/.exec(aotRuntimeCounters())![1]);
declare const aotOperationCount: (name: string) => number;
interface Address { street: string; city: string }
interface User { id: number; name: string; address: Address; tags: string[] }
interface Link { value: number; next: Link | null }
interface Tree { name: string; children: Tree[] }
class Point {
    constructor(public x: number, public y: number) {}
}

////= hide-2

function send(value: any): string {
    return JSON.stringify(value);
}

const reply = {
    json(value: any): string {
        return JSON.stringify(value);
    },
};

class Context {
    sent = 0;
    json = (value: any): string => {
        this.sent++;
        return JSON.stringify(value);
    };
}
const context = new Context();

let finished = 0;
let handedOver = 0;

function begin(): void {
    finished = (aotOperationCount("operationAOTJSONWriterFinish") - writersFailed());
    handedOver = aotOperationCount("operationAOTJSONAppendValue");
}

function report(label: string, text: string): void {
    console.log(label + ": " + text.length + " characters, " + ((aotOperationCount("operationAOTJSONWriterFinish") - writersFailed()) - finished) + " texts finished by compiled code, " + (aotOperationCount("operationAOTJSONAppendValue") - handedOver) + " values handed to the runtime");
}

function measure(label: string, value: unknown): void {
    let text = "";
    begin();
    for (let i = 0; i < 100; i++) text = send(value);
    report(label + ", through a function", text);
    begin();
    for (let i = 0; i < 100; i++) text = reply.json(value);
    report(label + ", through a method", text);
    begin();
    for (let i = 0; i < 100; i++) text = context.json(value);
    report(label + ", through an arrow function in a field", text);
}

function user(i: number): User {
    return { id: i, name: "user " + i, address: { street: i + " Main Street", city: "Springfield" }, tags: ["a" + i, "b"] };
}

function tree(depth: number): Tree {
    const made: Tree = { name: "d" + depth, children: [] };
    for (let i = 0; depth && i < 2; i++) made.children.push(tree(depth - 1));
    return made;
}

measure("a record", user(1));
let chain: Link | null = null;
for (let i = 0; i < 40; i++) chain = { value: i, next: chain };
measure("forty records in a chain", chain);
measure("a tree five levels deep", tree(5));
const withExtra = user(2);
hide(withExtra).extra = 1;
measure("a property that the type does not name", withExtra);
const withExtraInside = user(3);
hide(withExtraInside.address).extra = 1;
measure("such a property one level down", withExtraInside);
measure("an object without a type", JSON.parse('{"id":7,"name":"seven"}'));
measure("an object of a class", new Point(1, 2));
measure("a string", "text");
//// json-stringify-early-fallback.ts
// A JSON.stringify call that falls back to the generic writer before it has written anything has no output to discard.
declare const aotRuntimeCounters: undefined | (() => string);
const isCounted = typeof aotRuntimeCounters === "function";
const discards = () =>
  typeof aotRuntimeCounters === "function" ? Number(/(\d+)\tJSONWriterFailed/.exec(aotRuntimeCounters())![1]) : 0;

type Circle = { kind: "circle"; radius: number };
type Square = { kind: "square"; side: number };
type Rectangle = { kind: "rectangle"; width: number; height: number };
type Triangle = { kind: "triangle"; base: number; height: number };
type Line = { kind: "line"; length: number };
type Label = { kind: "label"; text: string };
type Shape = Circle | Square | Rectangle | Triangle | Line | Label;
type Drawing = { name: string; shapes: Shape[] };
const rounds = 10;

////= lines-35	stringifyShape	shape	Shape	string	JSON.stringify
function stringifyUnknown(value: unknown): string | undefined {
  return JSON.stringify(value);
}
////= lines-35	stringifyDrawing	drawing	Drawing	string	JSON.stringify

function count(name: string, expected: number, run: () => string | undefined) {
  const before = discards();
  let text: string | undefined;
  for (let round = 0; round < rounds; round++) text = run();
  const counted = discards() - before;
  console.log(
    name,
    text,
    !isCounted || counted === expected ? "as expected" : `${counted} discards, expected ${expected}`,
  );
}

const shapes: Shape[] = [
  { kind: "circle", radius: 1 },
  { kind: "square", side: 2 },
  { kind: "rectangle", width: 3, height: 4 },
  { kind: "triangle", base: 5, height: 6 },
  { kind: "line", length: 7 },
  { kind: "label", text: "a dash —" },
];
for (const shape of shapes) {
  count("shape", 0, () => stringifyShape(shape));
  count("unknown, a shape", 0, () => stringifyUnknown(shape));
}

const values: unknown[] = [
  "a string",
  "a dash —",
  1,
  1.5,
  null,
  true,
  undefined,
  10n ** 2n > 1n,
  Symbol.iterator,
  [1, "two"],
  new Map(),
  new Date(0),
];
for (const value of values) count("unknown", 0, () => stringifyUnknown(value));

const replaced: Label = { kind: "label", text: "short" };
Object.defineProperty(replaced, "toJSON", { value: () => "replaced" });
const drawing: Drawing = { name: "a dash —", shapes: [shapes[0]!, shapes[5]!, replaced] };
count("fallback after writing", rounds, () => stringifyDrawing(drawing));
count("shape, after a fallback", 0, () => stringifyShape(shapes[0]!));
count("16-bit, after a fallback", 0, () => stringifyDrawing({ name: "n", shapes: [shapes[5]!] }));
count("unknown, after a fallback", 0, () => stringifyUnknown("a string"));
//// json-stringify-extra-properties.ts
function hide(value: unknown): any { return value; }
function set(o: unknown, k: PropertyKey, v: unknown): any { hide(o)[k] = v; return o; }
function del(o: unknown, k: PropertyKey): any { delete hide(o)[k]; return o; }
function define(o: unknown, k: PropertyKey, d: PropertyDescriptor): any { Object.defineProperty(hide(o), k, d); return o; }
function freeze(o: unknown): any { return Object.freeze(hide(o)); }
function seal(o: unknown): any { return Object.seal(hide(o)); }
function keys(o: unknown): string { return Object.keys(hide(o)).join(); }
interface P { a: number; b?: string; c?: P | null; list?: P[] }
class K { x = 1; y?: string; constructor(public z: number) {} }
class WithToJSON { v = 1; toJSON() { return "from toJSON " + this.v; } }
const mk = (a = 1): P => ({ a });
let count = 0;
////= show-3	const value = make(); out = String(JSON.stringify(value, rest[0] as any, rest[1] as any)) + (value && typeof value === "object" ? " | " + keys(value) : ""
show("one extra", () => set(mk(), "z", 1));
show("an extra, then an optional field", () => { const o = set(mk(), "z", 1) as P; o.b = "later"; return o; });
show("an optional field, an extra, another field", () => { const o = mk(); o.b = "first"; set(o, "z", 1); o.c = null; return o; });
show("three extras in order", () => set(set(set(mk(), "z", 1), "m", 2), "aa", 3));
show("an extra deleted and added again", () => set(del(set(set(mk(), "z", 1), "m", 2), "z"), "z", 3));
show("every extra deleted", () => del(set(mk(), "z", 1), "z"));
show("an optional field deleted and set again behind an extra", () => { const o = mk(); o.b = "x"; set(o, "z", 1); del(o, "b"); o.b = "y"; return o; });
show("extra undefined", () => set(set(mk(), "u", undefined), "z", 1));
show("extra function", () => set(set(mk(), "f", () => 1), "z", 1));
show("extra symbol value", () => set(set(mk(), "s", Symbol("s")), "z", 1));
show("extra symbol key", () => set(set(mk(), Symbol("k"), 1), "z", 1));
show("extra null, boolean, double, negative zero, NaN", () => set(set(set(set(set(mk(), "n", null), "t", true), "d", 1.5), "nz", -0), "nan", NaN));
show("extra non-enumerable", () => set(define(mk(), "hidden", { value: 1, enumerable: false, writable: true, configurable: true }), "z", 1));
show("extra read-only", () => set(define(mk(), "ro", { value: 1, enumerable: true, writable: false, configurable: true }), "z", 1));
show("extra getter", () => set(define(mk(), "g", { get() { return "got"; }, enumerable: true, configurable: true }), "z", 1));
show("extra getter that adds a property", () => { const o = mk(); return set(define(o, "g", { get() { set(o, "late", 1); return "got"; }, enumerable: true, configurable: true }), "z", 1); });
show("extra toJSON, callable", () => set(mk(), "toJSON", () => "own toJSON"));
show("extra toJSON, not callable", () => set(mk(), "toJSON", 5));
show("extra toJSON, callable, non-enumerable", () => define(mk(), "toJSON", { value: () => "hidden toJSON", enumerable: false, configurable: true, writable: true }));
show("extra index keys", () => set(set(set(mk(), "10", "ten"), "z", 1), "2", "two"));
show("extra __proto__ by define", () => define(mk(), "__proto__", { value: 1, enumerable: true, writable: true, configurable: true }));
show("extra name that needs escaping", () => set(set(mk(), 'q"uote', 1), "back\\slash", 2));
show("extra name with a control character", () => set(mk(), "tab\there", 1));
show("extra 16-bit name", () => set(mk(), "ключ", 1));
show("extra 16-bit value", () => set(mk(), "z", "значение"));
show("extra empty name", () => set(mk(), "", 1));
show("extra bigint", () => set(mk(), "big", 1n));
show("extra holds a plain object", () => set(mk(), "z", { q: 1, r: [1, 2, { s: 3 }] }));
show("extra holds a typed object with extras", () => set(mk(1), "z", set(mk(2), "y", set(mk(3), "x", 4))));
show("extra holds the object itself", () => { const o = mk(); return set(o, "self", o); });
show("extra holds an object with toJSON", () => set(mk(), "z", new WithToJSON()));
show("extra holds a Date, a Map, a boxed number", () => set(set(set(mk(), "d", new Date(0)), "m", new Map([[1, 2]])), "n", new Number(5)));
show("typed field holds a typed object with extras", () => { const o = mk(1); o.c = set(mk(2), "z", 1) as P; return o; });
show("a list of typed objects, some with extras", () => { const o = mk(0); o.list = [mk(1), set(mk(2), "z", 1) as P, mk(3), set(set(mk(4), "y", 1), "x", 2) as P]; return o; });
show("in a plain array", () => [set(mk(), "z", 1), mk(), set(mk(), "y", 2)]);
show("in a plain object", () => ({ first: set(mk(), "z", 1), second: mk() }));
show("a class instance with extras", () => set(set(new K(3), "extra", 1), "more", "m"));
show("a class instance, optional field behind an extra", () => { const k = set(new K(3), "extra", 1) as K; k.y = "late"; return k; });
show("an instance of a class with toJSON, with extras", () => set(new WithToJSON(), "z", 1));
show("frozen with extras", () => freeze(set(mk(), "z", 1)));
show("sealed with extras", () => seal(set(mk(), "z", 1)));
show("indent 2", () => set(set(mk(), "z", { q: [1, set(mk(2), "y", 1)] }), "e", {}), undefined, 2);
show("indent tab", () => set(mk(), "z", [set(mk(2), "y", 1)]), undefined, "\t");
show("indent, every extra skipped", () => set(set({ } as P, "u", undefined), "f", () => 1), undefined, 2);
show("replacer list", () => set(set(mk(), "z", 1), "y", 2), ["z", "a"]);
show("replacer function", () => set(set(mk(), "z", 1), "y", 2), (k: string, v: unknown) => (k === "y" ? undefined : v));
show("longer than the first buffer", () => { const o = mk(0); o.list = []; for (let i = 0; i < 400; i++) o.list.push(set(mk(i), "extra" + (i % 7), "value " + i) as P); return JSON.stringify(o).length + " " + JSON.stringify(o).slice(-60); });
show("longer than the first buffer, 16-bit at the end", () => { const o = mk(0); o.list = []; for (let i = 0; i < 400; i++) o.list.push(set(mk(i), "extra" + (i % 7), i === 399 ? "конец" : "value " + i) as P); return JSON.stringify(o).length + " " + JSON.stringify(o).slice(-60); });
show("longer than the first buffer, a getter at the end", () => { const o = mk(0); o.list = []; for (let i = 0; i < 400; i++) o.list.push((i === 399 ? define(mk(i), "g", { get() { return "got"; }, enumerable: true }) : set(mk(i), "e", i)) as P); return JSON.stringify(o).length + " " + JSON.stringify(o).slice(-60); });
show("many extras", () => { const o = mk(); for (let i = 0; i < 40; i++) set(o, "k" + i, i); return o; });
show("many extras between fields", () => { const o = mk(); for (let i = 0; i < 12; i++) set(o, "k" + i, i); o.b = "b"; for (let i = 12; i < 24; i++) set(o, "k" + i, i); o.c = null; return o; });
//// json-stringify-generated-records-1.ts
function parsed(text: string): any { return JSON.parse(text); }
function nothing(): void {}
function viaUnknown(value: unknown): string | undefined { return JSON.stringify(value); }
function viaAny(value: any): string | undefined { return JSON.stringify(value); }
function show(number: number, run: () => string | undefined): void { let text: string | undefined; try { text = run(); } catch (error) { text = "threw " + (error as Error).constructor.name; } console.log(number + " " + text); }
