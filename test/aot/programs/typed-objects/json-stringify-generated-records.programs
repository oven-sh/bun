//// json-stringify-gives-up-on-the-first-call.ts
// The first JSON.stringify of a process, and the first after a large result, start without an output buffer. One that gives up
// then, with 16-bit text already taken, must leave nothing behind for the results that follow.
const writers: Record<string, (value: unknown) => string> = { write: (value) => JSON.stringify(value) as string };
const write = (value: unknown) => writers["write"]!(value);
interface Row { id: number; text: string; list: number[] }
interface Holds { value: unknown }
interface Pair { text: string; next: unknown }
function row(id: number): Row { return { id, text: "t" + id, list: [id, id + 1] }; }
function holds(value: unknown): Holds { return { value }; }
function pair(text: string, next: unknown): Pair { return { text, next }; }
const plain: unknown = JSON.parse('{"p":1}');
const replaced: unknown = JSON.parse('{"q":2}');
Object.defineProperty(replaced, "toJSON", { value: () => "replaced" });
const large = () => console.log(write("x".repeat(70000)).length, write(["x".repeat(70000)]).length);

console.log(write(["first 日", plain]));
console.log(write(row(1)));
console.log(write(holds([row(2), plain])));
large();
console.log(write(["after a large result 日", plain]));
console.log(write(row(3)));
large();
console.log(write(pair("in a typed object 日", replaced)));
console.log(write(row(4)));
large();
console.log(write([pair("in a list 日", replaced)]));
console.log(write("a string"));
large();
console.log(write(holds(["nested 日", replaced])));
console.log(write([5]));
large();
console.log(write(["long 日" + "z".repeat(70000), "y".repeat(70000), plain]).length);
console.log(write(row(6)));
console.log(write([row(7), "s", plain]));
console.log(write(holds([row(8), plain])));
large();
console.log(write(undefined), write(() => 1), write(Symbol("s")));
console.log(write(row(9)));
console.log(write(["wide that is finished 日"]));
console.log(write(row(10)));
//// json-stringify-instances-of-array-subclasses.ts
// JSON.stringify meets instances of classes that extend Array, alone and inside typed records: with and without toJSON, whoever defines it and whenever.
interface Label { id: number; name: string }
interface Issue { id: number; title: string; labels: Label[]; numbers: number[]; made: Date | null }
class Rows<T> extends Array<T> {
  count = 0;
  command = "SELECT";
}
class MoreRows<T> extends Rows<T> {
  more = true;
}
class Told<T> extends Array<T> {
  toJSON() {
    return "told " + this.length;
  }
}
class LaterTold<T> extends Array<T> {}
class LaterToldAbove<T> extends LaterTold<T> {}
////= lines-37	hide	unknown
function fill<T, L extends T[]>(list: L, ...items: T[]): L {
  for (const item of items) list.push(item);
  return list;
}
const label = (id: number, name = "label " + id): Label => ({ id, name });
const issue = (id: number, labels: Label[], numbers: number[] = []): Issue => ({ id, title: "issue " + id, labels, numbers, made: id % 2 ? new Date(86400000 * id) : null });
function show(name: string, make: () => unknown) {
  for (let turn = 0; turn < 2; turn++) {
    try {
      console.log(name, String(make()));
    } catch (error) {
      console.log(name, "throws", (error as Error).constructor.name, (error as Error).message);
    }
  }
}
const rows = () => fill(new Rows<Label>(), label(1), label(2, 'quoted "two"'), label(3, "wide 東京 😀"));
show("alone", () => JSON.stringify(rows()));
show("alone, indented", () => JSON.stringify(rows(), null, 2));
show("alone, with a replacer", () => JSON.stringify(rows(), (key, value) => (key === "id" ? undefined : value)));
show("alone, with a list of keys", () => JSON.stringify(rows(), ["name"]));
show("empty", () => JSON.stringify(new Rows<Label>()));
show("in a record", () => JSON.stringify(issue(1, rows())));
show("in records in a list", () => JSON.stringify([issue(1, rows()), issue(2, new Rows<Label>()), issue(3, [label(4)])]));
show("in records in an instance", () => JSON.stringify(fill(new Rows<Issue>(), issue(1, rows()), issue(2, rows()))));
show("a subclass of the subclass", () => JSON.stringify(issue(4, fill(new MoreRows<Label>(), label(5)))));
show("numbers", () => JSON.stringify(issue(5, [], fill(new Rows<number>(), 1, 2, 3))));
show("numbers that are not whole", () => JSON.stringify(issue(5, [], fill(new Rows<number>(), 1.5, -0, NaN, Infinity, 1e21))));
show("strings", () => JSON.stringify({ list: fill(new Rows<string>(), "a", "é", "東", "\ud800", "\n") }));
show("instances in an instance", () => JSON.stringify(fill(new Rows<Rows<number>>(), fill(new Rows<number>(), 1), new Rows<number>(), fill(new Rows<number>(), 2, 3))));
show("objects without a type", () => JSON.stringify(fill(new Rows<unknown>(), JSON.parse('{"a":1,"b":[true,null]}'), JSON.parse('{"c":"東"}'))));
show("objects without a type, in a record", () => JSON.stringify({ id: 1, held: fill(new Rows<unknown>(), JSON.parse('{"a":1}'), label(6), "text", 7, null, undefined, () => 1, Symbol("s")) }));
show("the result of map", () => JSON.stringify(issue(6, rows().map(each => label(each.id + 10)))));
show("the result of filter and slice", () => JSON.stringify([rows().filter(each => each.id > 1), rows().slice(1)]));
show("toJSON of the class", () => JSON.stringify(issue(7, fill(new Told<Label>(), label(8)))));
show("toJSON of the class, alone", () => JSON.stringify(fill(new Told<Label>(), label(8))));
show("toJSON of its own", () => {
  const list = rows();
  hide(list).toJSON = () => "own";
  return JSON.stringify(issue(8, list));
});
show("toJSON of its own that is no function", () => {
  const list = rows();
  hide(list).toJSON = 1;
  return JSON.stringify(issue(8, list));
});
show("a getter named toJSON", () => {
  const list = rows();
  Object.defineProperty(list, "toJSON", { get: () => () => "got" });
  return JSON.stringify(issue(8, list));
});
const later = () => fill(new LaterToldAbove<Label>(), label(9));
show("before the class is told", () => JSON.stringify(issue(9, later())));
hide(LaterTold.prototype).toJSON = function (this: unknown[]) {
  return "told later " + this.length;
};
show("after the class above is told", () => JSON.stringify(issue(9, later())));
delete hide(LaterTold.prototype).toJSON;
show("after that is taken back", () => JSON.stringify(issue(9, later())));
show("a hole", () => {
  const list = rows();
  delete hide(list)[1];
  return JSON.stringify(issue(10, list));
});
show("a hole over an inherited element", () => {
  const list = rows();
  delete hide(list)[1];
  hide(Rows.prototype)[1] = label(99);
  try {
    return JSON.stringify(issue(10, list));
  } finally {
    delete hide(Rows.prototype)[1];
  }
});
show("a longer length", () => {
  const list = rows();
  list.length = 5;
  return JSON.stringify(issue(11, list));
});
show("an element with a getter", () => {
  const list = rows();
  Object.defineProperty(list, 1, { get: () => label(77), enumerable: true });
  return JSON.stringify(issue(12, list));
});
show("frozen", () => JSON.stringify(issue(13, Object.freeze(rows()) as Label[])));
show("another prototype", () => JSON.stringify(issue(14, Object.setPrototypeOf([label(1)], Rows.prototype))));
show("no prototype", () => JSON.stringify(issue(14, Object.setPrototypeOf([label(1)], null))));
show("a prototype with toJSON", () => JSON.stringify(issue(14, Object.setPrototypeOf([label(1)], { toJSON: () => "from the prototype" }))));
show("a proxy as the prototype", () => JSON.stringify(issue(14, Object.setPrototypeOf([label(1)], new Proxy(Array.prototype, { get: (target, key, receiver) => (key === "toJSON" ? () => "through the proxy" : Reflect.get(target, key, receiver)) })))));
show("a proxy of an instance", () => JSON.stringify({ id: 15, held: hide(new Proxy(rows(), {})) }));
show("an instance that holds itself", () => {
  const list = new Rows<unknown>();
  list.push(list);
  return JSON.stringify({ list });
});
show("a record that holds itself through an instance", () => {
  const one = issue(16, []);
  one.labels = fill(new Rows<Label>(), hide(one));
  return JSON.stringify(one);
});
let deep: unknown[] = new Rows<unknown>();
for (let i = 0; i < 100; i++) deep = fill<unknown, Rows<unknown>>(new Rows<unknown>(), deep, i);
show("a hundred levels", () => JSON.stringify({ deep })!.length);
let length = 0;
for (let i = 0; i < 20000; i++) length += JSON.stringify(issue(i, fill(new Rows<Label>(), label(i), label(i + 1)), fill(new Rows<number>(), i)))!.length;
console.log("many", length);
//// json-stringify-instances-of-array-subclasses-stay-compiled.ts
declare const aotRuntimeCounters: () => string;
const writersFailed = () => Number(/(\d+)\tJSONWriterFailed/.exec(aotRuntimeCounters())![1]);
declare const aotOperationCount: (name: string) => number;
interface Label { id: number; name: string }
interface Issue { id: number; title: string; labels: Label[] }
interface Holder { id: number; held: unknown }
class Rows<T> extends Array<T> {
  count = 0;
}
class Told<T> extends Array<T> {
  toJSON() {
    return this.length;
  }
}
function fill<T, L extends T[]>(list: L, ...items: T[]): L {
  for (const item of items) list.push(item);
  return list;
}
function measure(label: string, run: () => string | undefined): void {
  for (let i = 0; i < 10; i++) run();
  const finished = (aotOperationCount("operationAOTJSONWriterFinish") - writersFailed());
  let length = 0;
  for (let i = 0; i < 100; i++) length += run()!.length;
  console.log(label + ": " + length + " characters, " + ((aotOperationCount("operationAOTJSONWriterFinish") - writersFailed()) - finished) + " texts finished by compiled code");
}
const label = (id: number): Label => ({ id, name: "label " + id });
const inARecord: Issue = { id: 1, title: "one", labels: fill(new Rows<Label>(), label(1), label(2)) };
measure("an instance in a record", () => JSON.stringify(inARecord));
const alone = fill(new Rows<Label>(), label(3), label(4));
measure("an instance alone", () => JSON.stringify(alone));
const unknownMember: Holder = { id: 2, held: fill(new Rows<Label>(), label(5)) };
measure("an instance as a member of unknown type", () => JSON.stringify(unknownMember));
const plainObjects: Holder = { id: 3, held: fill(new Rows<unknown>(), JSON.parse('{"a":1}'), JSON.parse('{"b":"two"}')) };
measure("an instance that holds objects without a type", () => JSON.stringify(plainObjects));
const told: Issue = { id: 4, title: "four", labels: fill(new Told<Label>(), label(6)) };
measure("an instance of a class with toJSON", () => JSON.stringify(told));
const withAHole: Issue = { id: 5, title: "five", labels: fill(new Rows<Label>(), label(7), label(8)) };
delete (withAHole.labels as any)[0];
measure("an instance with a hole", () => JSON.stringify(withAHole));
//// json-stringify-keys-and-separators.ts
// Keys that need escaping, separators around members that write nothing, and objects that must take the generic answer.
// One function per type, so each JSON.stringify call site has a static type. The call is in a loop, so the site is not cold.
interface EscapedKeys {
  'a"b': number;
  "c\\d": number;
  "e\tf": number;
  "é": number;
  "g\x7fh": number;
}
////= lines	WideKey	"日本"	number	plain	number
interface Three {
  a?: number;
  b?: string;
  c?: boolean;
}
////= lines-13	UnknownFirst	value	unknown	next	number
interface UnknownAfterMember {
  first: number;
  value: unknown;
  last?: number;
}
interface Scalars {
  yes: boolean;
  no: boolean;
  negativeZero: number;
  large: number;
  notANumber: number;
  exact: number;
  when: Date;
}
////= Point
////= lines-12	Pair	left	1	right	2

////= lines-37	hide	unknown

function writeByShape(label: string, values: unknown[]): void {
  for (const value of values) console.log(label + ", by shape: " + JSON.stringify(value));
}

////= lines-5	writeEscapedKeys	EscapedKeys

////= lines-5	writeWideKeys	WideKey

////= lines-5	writeThrees	Three

////= lines-5	writeUnknownFirst	UnknownFirst

////= lines-5	writeUnknownAfterMember	UnknownAfterMember

////= lines-5	writeScalars	Scalars

////= lines-5	writePoints	Point

////= lines-5	writePairs	Pair

writeEscapedKeys("escaped keys", [{ 'a"b': 1, "c\\d": 2, "e\tf": 3, "é": 4, "g\x7fh": 5 }]);
writeWideKeys("wide key", [{ "日本": 1, plain: 2 }]);

for (let bits = 0; bits < 8; bits++) {
  const absent: Three = {};
  if (bits & 1) absent.a = bits;
  if (bits & 2) absent.b = "b" + bits;
  if (bits & 4) absent.c = true;
  writeThrees("absent members " + bits, [absent]);
  const undefinedMembers: Three = {
    a: bits & 1 ? bits : undefined,
    b: bits & 2 ? "b" + bits : undefined,
    c: bits & 4 ? false : undefined,
  };
  writeThrees("undefined members " + bits, [undefinedMembers]);
}

const unknownValues: unknown[] = [undefined, () => 1, 7, Symbol("left out"), null, "text"];
for (const value of unknownValues) {
  writeUnknownFirst("unknown first", [{ value }]);
  writeUnknownFirst("unknown first, then a member", [{ value, next: 2 }]);
  writeUnknownAfterMember("unknown after a member", [{ first: 1, value }]);
  writeUnknownAfterMember("unknown between members", [{ first: 1, value, last: 3 }]);
}

writeScalars("scalars", [
  {
    yes: true,
    no: false,
    negativeZero: -0,
    large: 1e21,
    notANumber: NaN,
    exact: 2 ** 53,
    when: new Date(NaN),
  },
]);

const point = (): Point => ({ x: 1, y: 2 });
writePoints("point", [point()]);
const frozen = point();
Object.freeze(frozen);
writePoints("frozen", [frozen]);
const sealed = point();
Object.seal(sealed);
writePoints("sealed", [sealed]);
const notExtensible = point();
Object.preventExtensions(notExtensible);
writePoints("not extensible", [notExtensible]);
const extended = point();
hide(extended).z = 3;
writePoints("added property", [extended]);
const withToJSON = point();
Object.setPrototypeOf(withToJSON, {
  toJSON() {
    return 1;
  },
});
writePoints("prototype with toJSON", [withToJSON]);
writePoints("point after the generic answers", [point()]);

writePairs("class instance", [new Pair()]);
const replaced = new Pair();
Object.setPrototypeOf(replaced, {
  toJSON() {
    return "replaced";
  },
});
writePairs("class instance with another prototype", [replaced]);
//// json-stringify-large-integers.ts
// Above 2 ** 53 a number prints the shortest digits that identify the double, not every digit of the integer.
interface Row { id: number }
const literal = (): string => JSON.stringify({ a: 2 ** 53, b: 2 ** 53 + 2, c: 2 ** 60, d: 1234567890123456789, e: -(2 ** 60), f: -1234567890123456789 });
const field = (row: Row): string => JSON.stringify(row);
const elements = (list: number[]): string => JSON.stringify(list);
const constantElements = (): string => JSON.stringify([2 ** 53, 2 ** 53 + 2, 2 ** 60, 1234567890123456789]);
const truncated = (value: number): string => JSON.stringify({ id: Math.trunc(value) });
const values = [2 ** 31, 2 ** 53 - 1, 2 ** 53, 2 ** 53 + 2, 2 ** 60, 2 ** 62 - 512, 2 ** 62, 1234567890123456789, 1e21];
let length = 0;
for (let round = 0; round < 2000; round++) {
  for (const value of values) length += field({ id: value }).length + field({ id: -value }).length + truncated(value).length;
  length += literal().length + elements(values).length + constantElements().length;
}
console.log(length);
console.log(literal());
console.log(elements(values));
console.log(constantElements());
for (const value of values) console.log(field({ id: value }), field({ id: -value }), truncated(value), truncated(-value));
//// json-stringify-large-output.ts
// After one large JSON.stringify output, the next large output allocates its buffer once instead of doubling it from 4 KB.
// ENV JSC_aotCountsPath=/dev/null
declare const aotOperationCount: undefined | ((name: string) => number);
const isCounted = typeof aotOperationCount === "function";
const bufferGrowths = () => (typeof aotOperationCount === "function" ? aotOperationCount("operationAOTJSONWriterReserve") : 0);

type Message = { role: string; content: string };
const sentence = "the quick brown fox jumps over the lazy dog. ";
const rounds = 10;

function conversation(messageCount: number, last: Message[]): Message[] {
  const messages: Message[] = [];
  for (let i = 0; i < messageCount; i++)
    messages.push({ role: i % 2 ? "assistant" : "user", content: sentence.repeat(100) });
  return messages.concat(last);
}

function checksum(text: string): number {
  let sum = 0;
  for (let i = 0; i < text.length; i++) sum = (Math.imul(sum, 31) + text.charCodeAt(i)) | 0;
  return sum;
}

function send(messages: Message[]): string {
  return JSON.stringify({ model: "m", messages });
}

function log(index: number): number {
  return JSON.stringify({ level: "info", index, text: "a short line" }).length;
}

function measure(name: string, messages: Message[], betweenOutputs: (round: number) => void, expectedGrowths = rounds) {
  let sum = checksum(send(messages));
  const before = bufferGrowths();
  for (let round = 0; round < rounds; round++) {
    betweenOutputs(round);
    sum = (sum + checksum(send(messages))) | 0;
  }
  const growths = bufferGrowths() - before;
  const verdict =
    !isCounted || growths === expectedGrowths ? "as expected" : `${growths} allocations, expected ${expectedGrowths}`;
  console.log(name, messages.length, sum, verdict);
}

const nothing = () => {};
measure("8-bit", conversation(40, []), nothing);
measure("16-bit", conversation(40, [{ role: "user", content: "one dash \u2014 and no escapes" }]), nothing);
measure(
  "16-bit, escaped",
  conversation(40, [{ role: "user", content: 'a dash \u2014,\na "quote", a lone \ud800 surrogate' }]),
  nothing,
);
measure(
  "16-bit, mostly escaped",
  conversation(2, []).concat(
    conversation(40, []).map(({ role }) => ({ role, content: 'a\tdash \u2014\n"quoted"\\ '.repeat(200) })),
  ),
  nothing,
  0,
);

const replaced: Message = { role: "user", content: "short" };
Object.defineProperty(replaced, "toJSON", { value: () => "replaced" });
measure("fallback", conversation(40, [replaced]), nothing);

measure("small outputs in between", conversation(40, [{ role: "user", content: "\u2014" }]), () => {
  for (let i = 0; i < 20; i++) log(i);
});

const growing = conversation(40, [{ role: "user", content: "\u2014" }]);
measure("a growing conversation", growing, round => {
  growing.push({ role: "user", content: sentence.repeat(20) + round });
});

send(conversation(400, []));
measure("smaller than the last large output", conversation(40, []), nothing);
//// json-stringify-list-tail-at-once.ts
declare const aotRuntimeCounters: () => string;
const writersFailed = () => Number(/(\d+)\tJSONWriterFailed/.exec(aotRuntimeCounters())![1]);
declare const aotOperationCount: (name: string) => number;
interface Item { id: number; title?: string; price?: number }
interface Page { total: number; rows: Item[] }
interface Pair { id: number; name: string }
function whole(i: number): Item {
    return { id: i, title: "item " + i, price: i + 0.25 };
}
function builtUp(i: number): Item {
    const made: Item = { id: i };
    if (i & 1) made.price = i + 0.25;
    made.title = "item " + i;
    return made;
}
function sum(text: string): number {
    let value = 0;
    for (let i = 0; i < text.length; i++) value = (value * 31 + text.charCodeAt(i)) | 0;
    return value;
}
function measure(label: string, run: () => string): void {
    const finished = (aotOperationCount("operationAOTJSONWriterFinish") - writersFailed());
    const values = aotOperationCount("operationAOTJSONAppendValue");
    const rests = aotOperationCount("operationAOTJSONAppendElements");
    let text = "";
    for (let i = 0; i < 100; i++) text = run();
    console.log(label + ": " + (text.length < 150 ? text : text.length + " characters, " + sum(text)) + ": " + ((aotOperationCount("operationAOTJSONWriterFinish") - writersFailed()) - finished) + " texts finished by compiled code, " + (aotOperationCount("operationAOTJSONAppendValue") - values) + " values and " + (aotOperationCount("operationAOTJSONAppendElements") - rests) + " rests of lists handed to the runtime");
}
function list(count: number, make: (i: number) => Item): Item[] {
    const made: Item[] = [];
    for (let i = 0; i < count; i++) made.push(make(i));
    return made;
}
const allWhole = list(3, whole);
const allBuiltUp = list(3, builtUp);
const lastBuiltUp = list(3, i => i === 2 ? builtUp(i) : whole(i));
const firstBuiltUp = list(3, i => i === 0 ? builtUp(i) : whole(i));
const one = list(1, builtUp);
const none: Item[] = [];
const long = list(400, builtUp);
const longBehindWhole = list(400, i => i < 200 ? whole(i) : builtUp(i));
const wide = list(3, builtUp);
wide[2].title = "中文";
const withNull: (Item | null)[] = [whole(0), null, builtUp(2), null];
const extra = list(3, whole);
(extra[1] as any).more = true;
const pairs: Pair[] = [{ id: 0, name: "zero" }, { id: 1, name: "one" }, { id: 2, name: "two" }, { id: 3, name: "three" }];
(pairs[1] as any).more = true;
const manyPairs: Pair[] = [];
for (let i = 0; i < 400; i++) manyPairs.push({ id: i, name: "pair " + i });
(manyPairs[200] as any).more = true;
const widePairs: Pair[] = [{ id: 0, name: "zero" }, { id: 1, name: "one" }, { id: 2, name: "\u4e2d\u6587" }];
(widePairs[1] as any).more = true;
const page: Page = { total: 3, rows: allBuiltUp };
const pages: Page[] = [{ total: 3, rows: allBuiltUp }, { total: 3, rows: allWhole }, { total: 3, rows: lastBuiltUp }];
const lists: Item[][] = [allWhole, allBuiltUp, lastBuiltUp];

measure("every element as it was born", () => JSON.stringify(allWhole));
measure("every element built up", () => JSON.stringify(allBuiltUp));
measure("the last built up", () => JSON.stringify(lastBuiltUp));
measure("the first built up", () => JSON.stringify(firstBuiltUp));
measure("one element", () => JSON.stringify(one));
measure("no element", () => JSON.stringify(none));
measure("four hundred built up", () => JSON.stringify(long));
measure("two hundred built up behind two hundred", () => JSON.stringify(longBehindWhole));
measure("a 16-bit string in the rest", () => JSON.stringify(wide));
measure("nulls among them", () => JSON.stringify(withNull));
measure("one with an extra property", () => JSON.stringify(extra));
measure("no optional members, one with an extra property", () => JSON.stringify(pairs));
measure("the same among four hundred", () => JSON.stringify(manyPairs));
measure("the same with a 16-bit string behind it", () => JSON.stringify(widePairs));
measure("in a record", () => JSON.stringify(page));
measure("in records in a list", () => JSON.stringify(pages));
measure("lists in a list", () => JSON.stringify(lists));
//// json-stringify-long-names-after-short-ones.ts
// Objects with undeclared keys whose names and values are long are written after short ones of the same fields, alone, under a holder and in arrays: the writer's plans and its buffer.
type Point = { x: number; y: number };
type Named = { id: number; name: string; tags: string[] };
let different = 0;
let texts = 0;
const lengths = [1, 7, 8, 9, 15, 16, 17, 31, 32, 33, 55, 56, 57, 62, 63, 64, 65, 66, 127, 128, 129, 255, 256, 257, 1000, 1023, 1024, 1025, 4095, 4096, 4097, 16384, 65535, 65536, 65537, 100000, 1000000];
function check(value: unknown, text: string): void {
  texts++;
  if (JSON.stringify(value) !== text) different++;
}
for (const character of ["k", "\u00e9", "\u65e5", "\\n", '\\"']) {
  const raw = globalThis.JSON.parse('"' + character + '"');
  const short = '{"x":1,"y":2,"s":1}';
  const shortValue = JSON.parse(short) as Point;
  for (const length of lengths) {
    if (character.length > 1 && length > 70000) continue;
    const name = character.repeat(length);
    for (const text of ['{"x":1,"y":2,"' + name + '":1}', '{"' + name + '":"' + name + '","x":1,"y":2}', '{"x":1,"' + name + '":[1],"y":2,"' + name + 'b":{"' + name + '":null}}']) {
      const value = JSON.parse(text) as Point;
      const written = JSON.stringify(globalThis.JSON.parse(text));
      for (let round = 0; round < 4; round++) {
        check(shortValue, short);
        check(value, written);
        check({ held: value, other: shortValue }, '{"held":' + written + ',"other":' + short + "}");
        check([shortValue, value, shortValue, value], "[" + short + "," + written + "," + short + "," + written + "]");
      }
    }
    const named = '{"id":' + length + ',"name":"' + name + '","tags":["' + name + '","t"],"' + name + '":"' + name + '"}';
    const value = JSON.parse(named) as Named;
    const written = JSON.stringify(globalThis.JSON.parse(named));
    for (let round = 0; round < 4; round++) check(value, written);
    if (value.name.length !== raw.length * length) different++;
  }
  console.log("names and values of " + JSON.stringify(raw) + ": " + texts + " texts: " + different + " differ");
  texts = 0;
}
//// json-stringify-members-without-text.ts
// `JSON.stringify` leaves out a member that holds a function, `undefined` or a symbol, writes `null` for one in an array and answers `undefined` for one at the top, in objects whose serializer is compiled.
// STATISTIC: OwnKeyWalksExpanded >= 10
// STATISTIC: SerializersCreated >= 10
function report(label: string, run: () => unknown) {
  let result: unknown;
  try {
    result = run();
  } catch (error) {
    result = "threw " + (error as Error).name;
  }
  console.log(label, typeof result, String(result));
}

class BoundFirst { onClick = () => 1; id = 1 }
class BoundLast { id = 1; onClick = () => 1 }
class BoundBetween { id = 1; onClick = () => this.id; name = "n"; onHover = (x: number) => x + this.id; price = 9.5 }
class OnlyBound { onClick = () => 1; onHover = () => 2 }
class BoundInConstructor { self: () => BoundInConstructor; id: number; constructor() { this.self = () => this; this.id = 1 } }
class WithMethods { id = 1; method() { return 1 } static helper() { return 2 } get computed() { return 3 } }
class FunctionExpression { run = function () { return 1 }; later = async () => 1; many = function* () { yield 1 }; id = 1 }
function textOfBoundFirst(value: BoundFirst) { return JSON.stringify(value) }
function textOfBoundLast(value: BoundLast) { return JSON.stringify(value) }
function textOfBoundBetween(value: BoundBetween) { return JSON.stringify(value) }
function textOfOnlyBound(value: OnlyBound) { return JSON.stringify(value) }
function textOfBoundInConstructor(value: BoundInConstructor) { return JSON.stringify(value) }
function textOfWithMethods(value: WithMethods) { return JSON.stringify(value) }
function textOfFunctionExpression(value: FunctionExpression) { return JSON.stringify(value) }

interface Handlers { before?: () => void; name: string; after?: (x: number) => number }
class FunctionOrNumber { value: (() => number) | number; id = 1; constructor(round: number) { this.value = round % 2 ? round : () => round } }
class FunctionOrNothing { id = 1; value: (() => number) | undefined | null; constructor(round: number) { this.value = round === 0 ? () => round : round === 1 ? undefined : null } }
class FunctionOrRecord { value: (() => number) | { inner: number; skip: () => void }; constructor(round: number) { this.value = round % 2 ? { inner: round, skip() {} } : () => round } }
class SymbolOrText { tag: symbol | string; id = 1; constructor(round: number) { this.tag = round % 2 ? "text" : Symbol("tag") } }
class Undefineds { a: undefined = undefined; b?: number; c: number | undefined; d = 1; constructor(round: number) { this.c = round % 2 ? round : undefined } }
class Symbols { tag = Symbol("tag"); [Symbol.toStringTag] = "Symbols"; id = 1; last = Symbol.iterator }
class OptionalAbsent { id = 1; note?: string; run?: () => void; constructor(round: number) { if (round === 1) this.note = "n"; if (round === 2) this.run = () => {} } }
function textOfHandlers(value: Handlers) { return JSON.stringify(value) }
function textOfFunctionOrNumber(value: FunctionOrNumber) { return JSON.stringify(value) }
function textOfFunctionOrNothing(value: FunctionOrNothing) { return JSON.stringify(value) }
function textOfFunctionOrRecord(value: FunctionOrRecord) { return JSON.stringify(value) }
function textOfSymbolOrText(value: SymbolOrText) { return JSON.stringify(value) }
function textOfUndefineds(value: Undefineds) { return JSON.stringify(value) }
function textOfSymbols(value: Symbols) { return JSON.stringify(value) }
function textOfOptionalAbsent(value: OptionalAbsent) { return JSON.stringify(value) }

class Base { base = 1; onBase = () => this.base }
class Derived extends Base { derived = 2; onDerived = () => this.derived }
class Holder { inner = new BoundBetween(); empty = new OnlyBound(); list = [new BoundFirst(), new BoundLast()]; id = 1 }
class Lists { handlers: Array<() => number> = [() => 1, () => 2]; mixed: Array<number | (() => number) | undefined | symbol | null> = [1, () => 1, undefined, Symbol("s"), null]; nested = [[() => 1], [2, () => 3]]; id = 1 }
function textOfBaseOrDerived(value: Base) { return JSON.stringify(value) }
function textOfHolder(value: Holder) { return JSON.stringify(value) }
function textOfLists(value: Lists) { return JSON.stringify(value) }
function textOfHandlerList(value: Array<() => number>) { return JSON.stringify(value) }

function withOwnToJSON() { const run = () => 1; (run as unknown as { toJSON: (key: string) => string }).toJSON = key => "function under " + key; return run }
class FunctionWithToJSON { run = withOwnToJSON(); id = 1 }
class ClassWithStaticToJSON { static toJSON(key: string) { return "class under " + key } }
class HoldsClass { type = ClassWithStaticToJSON; plain = Base; id = 1 }
class ToJSONGivesFunction { toJSON() { return () => 1 } }
class ToJSONGivesNothing { toJSON() {} }
class HoldsToJSON { first = new ToJSONGivesFunction(); id = 1; last = new ToJSONGivesNothing() }
class Big { id = 1; big = 1n }
class Boxed { n = new Number(1.5); s = new String("s"); b = new Boolean(false); id = 1 }
class Numbers { nan = NaN; up = Infinity; down = -Infinity; zero = -0; quotient: number; constructor(round: number) { this.quotient = 1 / round } }
function textOfFunctionWithToJSON(value: FunctionWithToJSON) { return JSON.stringify(value) }
function textOfHoldsClass(value: HoldsClass) { return JSON.stringify(value) }
function textOfHoldsToJSON(value: HoldsToJSON) { return JSON.stringify(value) }
function textOfToJSONRoot(value: ToJSONGivesFunction | ToJSONGivesNothing) { return JSON.stringify(value) }
function textOfBig(value: Big) { return JSON.stringify(value) }
function textOfBoxed(value: Boxed) { return JSON.stringify(value) }
function textOfNumbers(value: Numbers) { return JSON.stringify(value) }

function textOfFunction(value: () => number): string { return JSON.stringify(value) }
function textOfFunctionOrInstance(value: (() => number) | BoundFirst | undefined): string { return JSON.stringify(value) }
function textOfSymbol(value: symbol): string { return JSON.stringify(value) }
function textOfNothing(value: undefined): string { return JSON.stringify(value) }
function textOfUnknown(value: unknown): string { return JSON.stringify(value) }

function textWithReplacer(value: BoundBetween) { return JSON.stringify(value, (key, member) => (typeof member === "function" ? "function " + key : member)) }
function textWithList(value: BoundBetween) { return JSON.stringify(value, ["price", "onClick", "id"]) }
function textWithIndent(value: Holder) { return JSON.stringify(value, null, 2) }
function textWithNulls(value: BoundBetween) { return JSON.stringify(value, null, undefined) }

for (let round = 0; round < 3; round++) {
  report("bound first", () => textOfBoundFirst(new BoundFirst()));
  report("bound last", () => textOfBoundLast(new BoundLast()));
  report("bound between", () => textOfBoundBetween(new BoundBetween()));
  report("only bound", () => textOfOnlyBound(new OnlyBound()));
  report("bound in the constructor", () => textOfBoundInConstructor(new BoundInConstructor()));
  report("methods", () => textOfWithMethods(new WithMethods()));
  report("function expressions", () => textOfFunctionExpression(new FunctionExpression()));

  report("interface", () => textOfHandlers(round === 0 ? { name: "none" } : round === 1 ? { before() {}, name: "before" } : { name: "after", after: x => x }));
  report("function or number", () => textOfFunctionOrNumber(new FunctionOrNumber(round)));
  report("function or nothing", () => textOfFunctionOrNothing(new FunctionOrNothing(round)));
  report("function or record", () => textOfFunctionOrRecord(new FunctionOrRecord(round)));
  report("symbol or text", () => textOfSymbolOrText(new SymbolOrText(round)));
  report("undefined", () => textOfUndefineds(new Undefineds(round)));
  report("symbols", () => textOfSymbols(new Symbols()));
  report("optional members", () => textOfOptionalAbsent(new OptionalAbsent(round)));

  report("base or derived", () => textOfBaseOrDerived(round % 2 ? new Base() : new Derived()));
  report("holder", () => textOfHolder(new Holder()));
  report("lists", () => textOfLists(new Lists()));
  report("list of handlers", () => textOfHandlerList([() => 1, () => round]));

  report("function with toJSON", () => textOfFunctionWithToJSON(new FunctionWithToJSON()));
  report("class with static toJSON", () => textOfHoldsClass(new HoldsClass()));
  report("toJSON gives no text", () => textOfHoldsToJSON(new HoldsToJSON()));
  report("toJSON gives no text at the top", () => textOfToJSONRoot(round % 2 ? new ToJSONGivesFunction() : new ToJSONGivesNothing()));
  report("bigint", () => textOfBig(new Big()));
  report("boxed", () => textOfBoxed(new Boxed()));
  report("numbers", () => textOfNumbers(new Numbers(round)));

  report("function at the top", () => textOfFunction(() => round));
  report("function or instance at the top", () => textOfFunctionOrInstance(round === 0 ? () => 1 : round === 1 ? new BoundFirst() : undefined));
  report("symbol at the top", () => textOfSymbol(Symbol("top")));
  report("undefined at the top", () => textOfNothing(undefined));
  report("unknown at the top", () => textOfUnknown(round === 0 ? () => 1 : round === 1 ? new BoundLast() : Symbol("s")));
  report("joined", () => "text: " + textOfFunction(() => 1));

  report("replacer", () => textWithReplacer(new BoundBetween()));
  report("list of keys", () => textWithList(new BoundBetween()));
  report("indent", () => textWithIndent(new Holder()));
  report("null replacer", () => textWithNulls(new BoundBetween()));
}

const responses = [Response.json(new BoundBetween()), Response.json(new Holder()), Response.json([() => 1, new OnlyBound()])];
for (const response of responses) console.log("response", await response.text());
//// json-stringify-more-kinds-of-objects-than-the-writer-remembers.ts
// The typed writer remembers how to write each kind of object with undeclared keys, up to a number of kinds. An object is being written while the objects below it bring more kinds than that: what the writer stands on may not be thrown away under it.
interface Item { id: number }
interface Holder { first: number; items: Item[]; last: string }
function textOf(count: number, from: number): string {
  const items: string[] = [];
  for (let i = 0; i < count; i++) items.push(`{"id":${i},"k${from + i}":${i}}`);
  return `{"a":"before","first":1,"b":[1,2],"items":[${items.join(",")}],"c":"behind","last":"l","d":{"e":null},"f":"${"x".repeat(40)}"}`;
}
for (const count of [10, 16000, 16383, 16384, 16385, 17000, 40000]) {
  const text = textOf(count, count * 7);
  const holder = JSON.parse(text) as Holder;
  console.log(count, JSON.stringify(holder) === text, JSON.stringify(holder) === text, JSON.stringify([holder, holder]) === `[${text},${text}]`, JSON.stringify(holder.items[count - 1]));
}
//// json-stringify-of-integers.ts
// Integers around every digit count, written by the compiled writers at a known and an unknown type.
interface Row { a: number; b: number }
const write = (row: Row): string => JSON.stringify(row);
const writers: Record<string, (value: unknown) => string> = { write: (value) => JSON.stringify(value) as string };
const total: number[] = [];
for (let i = 0; i <= 10100; i++) {
  const row: Row = { a: i, b: -i };
  const text = write(row);
  if (text !== `{"a":${i},"b":${i === 0 ? 0 : "-" + i}}` || writers["write"]!(row) !== text) console.log("wrong", text);
  total.push(text.length);
}
for (const i of [99999, 100000, 2147483647, -2147483648]) console.log(write({ a: i, b: i }));
console.log(total.reduce((sum, length) => sum + length, 0));
//// json-stringify-of-unknown-values.ts
// Typed values written by code that does not know their type: every line must read as plain Bun.
// ENV JSC_aotCountsPath=/dev/null
declare const aotRuntimeCounters: () => string;
const writersFailed = () => Number(/(\d+)\tJSONWriterFailed/.exec(aotRuntimeCounters())![1]);
declare const aotOperationCount: undefined | ((name: string) => number);
const writers: Record<string, (value: unknown) => string> = {
  write: (value) => JSON.stringify(value) as string,
  attempt: (value) => { try { return JSON.stringify(value) as string; } catch (error) { return (error as Error).constructor.name; } },
};
const write = (value: unknown) => writers["write"]!(value);
const attempt = (value: unknown) => writers["attempt"]!(value);
const say = (value: unknown) => console.log(String(value));

class Point { x: number; y: number; constructor(x: number, y: number) { this.x = x; this.y = y; } }
class Named { name: string; at: Point; constructor(name: string, at: Point) { this.name = name; this.at = at; } }
class Later { id: number; constructor(id: number) { this.id = id; } }
class WithMethod { id: number; constructor(id: number) { this.id = id; } toJSON() { return { byMethod: this.id }; } }
class Heir extends Later { more: string; constructor(id: number, more: string) { super(id); this.more = more; } }
interface Carrier { toJSON: () => string; kept: number }
interface Row { id: number; text: string; on: boolean; ratio: number; next: Row | null; list: number[]; maybe?: string; nothing: undefined; nil: null }
interface Deep { depth: number; inner: Deep | null }
interface Holds { value: unknown }

function row(id: number): Row { return { id, text: "t" + id, on: id % 2 === 0, ratio: id / 8, next: null, list: [id, id + 1], nothing: undefined, nil: null }; }
function holds(value: unknown): Holds { return { value }; }

say(write(new Point(1, 2)));
say(write(new Named("n", new Point(3, 4))));
say(write(new Heir(5, "more")));
say(write(new WithMethod(6)));
say(write([new WithMethod(7), new Point(8, 9)]));
say(write(holds(new WithMethod(10))));

const laterBase: Record<string, unknown> = Object.create(Later.prototype);
const later = new Later(11);
Object.setPrototypeOf(later, laterBase);
say(write(later));
laterBase["toJSON"] = function (this: Later) { return "added to the prototype " + this.id; };
say(write(later));
say(write([later]));
say(write(holds(later)));
delete laterBase["toJSON"];
say(write(later));
say(write(new Heir(17, "heir")));

const carrier: Carrier = { toJSON: () => "from the field", kept: 1 };
say(write(carrier));
say(write([carrier]));
say(write(holds(carrier)));

const custom = row(18);
Object.setPrototypeOf(custom, { toJSON() { return "through another prototype"; } });
say(write(custom));
say(write([row(19), custom]));
const bare = row(20);
Object.setPrototypeOf(bare, null);
say(write(bare));

const chained = Object.create({ toJSON() { return "two steps up"; } });
const lifted = row(21);
Object.setPrototypeOf(lifted, chained);
say(write(lifted));
say(write([lifted]));
Object.setPrototypeOf(lifted, Object.prototype);
say(write(lifted));

const listWithToJSON: number[] = [1, 2];
(listWithToJSON as unknown as Record<string, unknown>)["toJSON"] = () => "own toJSON of a list";
say(write(listWithToJSON));
say(write(holds(listWithToJSON)));
say(write([listWithToJSON]));
class List extends Array<number> { toJSON() { return "a subclass"; } }
say(write(List.from([1, 2])));
say(write(holds(List.from([3]))));
const otherList = [1, 2];
Object.setPrototypeOf(otherList, { toJSON() { return "a list with another prototype"; } });
say(write(otherList));
say(write(holds(otherList)));

say(write([1, , 3]));
say(write(holds([1, , 3])));
say(write(holds([1.5, , 3.5])));
say(write(holds(["a", , "c"])));
say(write(holds([undefined, null, () => 1, Symbol("s"), true, false, 0, -0, NaN, Infinity, 1e21, 0.1])));
say(write(holds(new Array(3))));
say(write(holds([])));
say(write([[], [[]], [[], [1]]]));
say(write(holds([NaN, 1.5])));
const inherited = [1, , 3];
Object.setPrototypeOf(inherited, Object.create(Array.prototype, { 1: { value: "inherited element" } }));
say(write(holds(inherited)));
const sparse: number[] = [];
sparse[100000] = 1;
say(write(holds(sparse)).length);
const accessor: number[] = [1, 2];
Object.defineProperty(accessor, 0, { get() { return "a getter in a list"; } });
say(write(holds(accessor)));

say(write(holds({ plain: true, nested: { a: [1, { b: 2 }] } })));
say(write([{ a: 1 }, { b: 2 }, row(23)]));
say(write([row(24), { a: 1 }, [{ b: 2 }]]));
say(write(holds(new Map([[1, 2]]))));
say(write(holds(new Set([1]))));
say(write(holds(new Date(0))));
say(write(holds(new Date(NaN))));
say(write(holds(new Number(5))));
say(write(holds(new String("boxed"))));
say(write(holds(new Boolean(false))));
say(write(holds(new Uint8Array([1, 2]))));
say(write(holds(/x/)));
say(write(holds(new Proxy({ through: 1 }, {}))));
say(write(holds(new Proxy([1], {}))));
say(attempt(holds(10n)));
say(attempt([10n]));
say(attempt(holds(Object(10n))));

say(write(undefined));
say(write(() => 1));
say(write(Symbol("s")));
say(write(null));
say(write(true));
say(write(1.5));
say(write("top \"level\""));
say(write("top 日本"));
say(write(holds(undefined)));
say(write(holds(() => 1)));
say(write(holds(Symbol("s"))));

const loop = row(25);
loop.next = loop;
say(attempt(loop));
say(attempt([loop]));
const ring: unknown[] = [];
ring.push(holds(ring));
say(attempt(ring));

let deep: Deep = { depth: 0, inner: null };
for (let i = 1; i <= 47; i++) deep = { depth: i, inner: deep };
say(write(deep));
for (let i = 48; i <= 60; i++) deep = { depth: i, inner: deep };
say(write(deep));
for (let i = 61; i <= 6000; i++) deep = { depth: i, inner: deep };
say(write(deep).length);
let lists: unknown[] = [];
for (let i = 0; i < 5000; i++) lists = [lists];
say(write(lists).length);

const text = (id: string): Row => ({ ...row(1), text: id });
say(write(text("quote \" back \\ line \n tab \t bell \u0007")));
say(write(text("wide 日本語 😀")));
say(write(text("lone \ud800 surrogate")));
say(write(text("latin é ÿ")));
say(write([text("a日"), text("b"), text("c😀")]));
say(write(holds(["日", "b", "😀"])));
let rope = "x";
for (let i = 0; i < 12; i++) rope = rope + "y" + i;
say(write(text(rope)));
say(write(text("rope " + rope + "日")));
for (const length of [60, 61, 62, 63, 64, 65, 127, 128, 129, 4000, 4030, 4096, 5000, 70000]) {
  const filler = "z".repeat(length);
  say(write(text(filler)).length);
  say(write([text(filler), text(filler), 1, true, null]).length);
  say(write([text(filler + "\n"), text(filler + "日"), 1]).length);
  say(write(holds([filler, filler + "\""])).length);
}

const frozen = Object.freeze(row(26));
say(write(frozen));
say(write(holds(frozen)));
const sealed = Object.seal(row(27));
say(write(sealed));
const stiff = Object.preventExtensions(row(28));
say(write(stiff));
const extra = row(29);
(extra as unknown as Record<string, unknown>)["added"] = "later";
say(write(extra));
say(write([extra, row(30)]));
const gone = row(31);
delete (gone as unknown as Record<string, unknown>)["text"];
say(write(gone));
const again = row(32);
delete (again as unknown as Record<string, unknown>)["text"];
(again as unknown as Record<string, unknown>)["text"] = "after the others";
say(write(again));
const getter = row(33);
Object.defineProperty(getter, "text", { get() { return "from a getter"; }, enumerable: true });
say(write(getter));
const hidden = row(34);
Object.defineProperty(hidden, "text", { enumerable: false });
say(write(hidden));
const optional = row(35);
optional.maybe = "there";
say(write(optional));
say(write([row(36), optional, row(37)]));
const reorder = { ...row(38), maybe: "spread" };
say(write(reorder));
const wrongKind = row(39);
(wrongKind as unknown as Record<string, unknown>)["id"] = "a text where a number goes";
(wrongKind as unknown as Record<string, unknown>)["ratio"] = { object: 1 };
(wrongKind as unknown as Record<string, unknown>)["on"] = undefined;
say(write(wrongKind));
const numbers = row(40);
numbers.id = 2147483647; numbers.ratio = -0;
say(write(numbers));
numbers.id = -2147483648; numbers.ratio = NaN;
say(write(numbers));
numbers.id = 2147483648.5; numbers.ratio = Infinity;
say(write(numbers));
numbers.id = 1e300; numbers.ratio = 5e-324;
say(write(numbers));


const plain: unknown = JSON.parse('{"p":1,"q":[2,{"r":"s"}]}');
say(write([plain]));
say(write([plain, row(50)]));
say(write([row(51), plain]));
say(write([1, plain]));
say(write([[plain]]));
say(write([[row(52)], [plain]]));
say(write(["wide 日本", plain]));
say(write("after a list with wide text that was given up"));
say(write(["narrow"]));
say(write(["wide again 日本"]));
say(write(["z".repeat(70000), plain]).length);
say(write(row(53)));
say(write(["z".repeat(70000) + "日", "y".repeat(70000), plain]).length);
say(write(row(54)));
say(write([row(55), "quote \" in a list", plain]));
say(write(holds([row(56), plain])));
say(write(holds([plain, row(57)])));
say(write([new Map([[1, 2]]), row(58)]));
say(write([row(59), new Date(0), /x/, new Set([1])]));

say(write([[plain]]));
say(write([[row(60)], [[plain]]]));
say(write([[["deep 日"]], [[plain]]]));
say(write(row(61)));
say(write(holds([[row(62)], [plain]])));
say(write(holds([["nested 日", [plain]]])));
say(write(row(63)));

if (typeof aotOperationCount === "function") {
  const list = [holds(45), holds(46)];
  const before = (aotOperationCount("operationAOTJSONWriterFinish") - writersFailed());
  for (let i = 0; i < 10; i++) {
    write(holds(i));
    write(list);
  }
  if ((aotOperationCount("operationAOTJSONWriterFinish") - writersFailed()) - before < 20) throw new Error("a value of unknown type was not written by the compiled writer");
}
//// json-stringify-records-in-plain-literal.ts
declare const aotRuntimeCounters: () => string;
const writersFailed = () => Number(/(\d+)\tJSONWriterFailed/.exec(aotRuntimeCounters())![1]);
declare const aotOperationCount: (name: string) => number;
interface Address { city: string; zip: string }
interface User { id: number; name: string; address: Address }
interface Team { name: string; lead: User; members: User[] }
function measure(label: string, run: () => string): void {
    const finished = (aotOperationCount("operationAOTJSONWriterFinish") - writersFailed());
    const values = aotOperationCount("operationAOTJSONAppendValue");
    let text = "";
    for (let i = 0; i < 100; i++) text = run();
    console.log(label + ": " + text + ": " + ((aotOperationCount("operationAOTJSONWriterFinish") - writersFailed()) - finished) + " texts finished by compiled code, " + (aotOperationCount("operationAOTJSONAppendValue") - values) + " values handed to the runtime");
}
const users: User[] = [];
for (let i = 0; i < 2; i++) users.push({ id: i, name: "user " + i, address: { city: "Springfield", zip: "0" + i } });
const team: Team = { name: "team", lead: users[0], members: users };

measure("a record", () => JSON.stringify({ ok: true, data: users[1] } as any));
measure("a list of records", () => JSON.stringify({ total: users.length, rows: users } as any));
measure("a record that holds records and a list", () => JSON.stringify({ team } as any));
measure("a list one literal further down", () => JSON.stringify({ ok: true, page: { total: users.length, rows: users } } as any));
measure("a record two literals further down", () => JSON.stringify({ a: { b: { user: users[1] } } } as any));
//// json-stringify-shared-key-order-arms.ts
// Six key orders of one type, each a prefix of the next, so that some share an arm of the serializer, and a toJSON that adds, deletes or replaces trailing members during the write. Every line prints what plain Bun prints.
// STATISTIC: SerializersCreated >= 1
declare const console: { log(...values: unknown[]): void };
interface Inner { x: number }
interface Deep { inner: Inner; a?: number; b?: number; c?: number; d?: string; e?: Inner }

function make(kind: number, i: number): Deep {
    switch (kind) {
    case 0: return { inner: { x: i } };
    case 1: return { inner: { x: i }, a: 1 };
    case 2: return { inner: { x: i }, a: 1, b: 2 };
    case 3: return { inner: { x: i }, a: 1, b: 2, c: 3 };
    case 4: return { inner: { x: i }, a: 1, b: 2, c: 3, d: "d" };
    default: return { inner: { x: i }, a: 1, b: 2, c: 3, d: "d", e: { x: -i } };
    }
}
function write(value: Deep): string { return JSON.stringify(value); }

const seen = new Set<string>();
for (let i = 0; i < 6000; i++) seen.add(write(make(i % 6, i & 1)));
const out: unknown[] = [...seen].sort();

for (let kind = 0; kind < 6; kind++) {
    const grows = make(kind, 7);
    (grows.inner as any).toJSON = function () {
        if (grows.a === undefined) grows.a = 10; else if (grows.b === undefined) grows.b = 20; else if (grows.c === undefined) grows.c = 30; else if (grows.d === undefined) grows.d = "grown"; else if (grows.e === undefined) grows.e = { x: 50 };
        return "grows";
    };
    out.push(write(grows), write(grows));

    const shrinks = make(kind, 8);
    (shrinks.inner as any).toJSON = function () {
        if (shrinks.e !== undefined) delete shrinks.e; else if (shrinks.d !== undefined) delete shrinks.d; else if (shrinks.c !== undefined) delete shrinks.c; else if (shrinks.b !== undefined) delete shrinks.b; else delete shrinks.a;
        return "shrinks";
    };
    out.push(write(shrinks), write(shrinks));

    const replaced = make(kind, 9);
    (replaced.inner as any).toJSON = function () { replaced.a = 100; replaced.d = undefined; return "replaced"; };
    out.push(write(replaced), write(replaced));

    const deletedAndAdded = make(kind, 6);
    (deletedAndAdded.inner as any).toJSON = function () {
        const keys = Object.keys(deletedAndAdded);
        const last = keys[keys.length - 1] as keyof Deep;
        if (last !== "inner") { const value = deletedAndAdded[last]; delete deletedAndAdded[last]; (deletedAndAdded as any)[last] = value; }
        return "same order";
    };
    out.push(write(deletedAndAdded));

    const holdsUndefined = make(kind, 5);
    if (kind >= 3) holdsUndefined.c = undefined;
    if (kind >= 4) holdsUndefined.d = undefined;
    out.push(write(holdsUndefined));

    const inherits = make(kind, 4);
    Object.setPrototypeOf(inherits, { d: "inherited", e: { x: 1 } });
    out.push(write(inherits));
}
console.log(out.map(String).join("\n"));
