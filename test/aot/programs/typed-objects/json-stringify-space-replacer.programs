//// keys-limited-by-type.ts
// `object[key]` where the type of the key is a union of a few names, some of which no code of the program writes: every key reads and stores what it does in plain Bun.
const shift = Date.now() < 1 ? 1 : 0;
function spell(reversed: string): string {
  let text = "";
  for (let i = reversed.length - 1; i >= 0; i--) text += String.fromCharCode(reversed.charCodeAt(i) + shift);
  return text;
}
interface Options {
  limit: number;
  depth: number;
  neverWritten?: number;
  alsoNeverWritten?: string;
}
type Key = keyof Options;
function read(options: Options, key: Key): unknown {
  return options[key];
}
function write(options: Options, key: "limit" | "depth" | "neverWritten", value: number): void {
  options[key] = value;
}
const options: Options = { limit: 1, depth: 2 };
const first = spell("nettirWreven") as "neverWritten";
const second = spell("nettirWreveNosla") as Key;
console.log(read(options, "limit"), read(options, "depth"), read(options, first), read(options, second));
write(options, "limit", 3);
write(options, spell("htped") as "depth", 4);
console.log(read(options, "limit"), read(options, "depth"), Object.keys(options).join());
write(options, first, 5);
console.log(read(options, first), Object.keys(options).length, JSON.stringify(options).length, first in options, second in options);
(options as any)[second] = "text";
console.log(read(options, second), Object.keys(options).length, Object.values(options).join());
delete (options as any)[first];
console.log(read(options, first), Object.keys(options).length);
const parsed = JSON.parse('{"limit":6,"depth":7,"' + first + '":8}') as Options;
console.log(read(parsed, first), read(parsed, "limit"), Object.keys(parsed).length);
class Counter {
  hits = 0;
  misses = 0;
  bump(which: "hits" | "misses"): number {
    return ++this[which];
  }
}
const counter = new Counter();
console.log(counter.bump("hits"), counter.bump("hits"), counter.bump(spell("sessim") as "misses"), counter.hits, counter.misses);
//// keys-listed-during-construction.ts
// The fields of a class come into being one by one, each when its initializer has run, and those of a class that extends another when `super()` has returned. Whoever lists the keys of the object in between finds those that are there by then.
const seen: string[] = [];
const look = (label: string, object: object): number => {
  seen.push(label + ": " + Object.keys(object).join() + " " + JSON.stringify(object) + " " + Object.entries(object).length + " " + Object.getOwnPropertyNames(object).join());
  return seen.length;
};
class Fields {
  a = 1;
  b = look("b of Fields", this);
  c = "c";
  d = Object.keys(this).join("");
  e?: string;
  f = look("f of Fields", this);
}
class Base {
  first = 1;
  constructor() {
    look("Base", this);
    this.hook();
  }
  hook(): void {}
}
class Derived extends Base {
  second = 2;
  third: number;
  early = "";
  constructor() {
    super();
    look("Derived", this);
    this.third = 3;
  }
  override hook(): void {
    look("hook", this);
  }
}
class Further extends Derived {
  fourth = look("fourth of Further", this);
  fifth = 5;
}
class Handlers {
  count = 0;
  up = () => { look("up", this); return ++this.count; };
  down = () => --this.count;
  started = this.up();
  last = "last";
}
class Parameters extends Base {
  constructor(public x: number, readonly y: string) {
    super();
    look("Parameters", this);
  }
  z = look("z of Parameters", this);
}
class Creates {
  first = 1;
  late?: number;
  step(): number { return 0; }
  constructor(sets: boolean) {
    if (sets) {
      delete this.late;
      this.late = 2;
      this.step = () => 3;
    }
  }
}
////= lines-3	AfterCreates	Creates	last	4
class Adds extends Base {
  own = 1;
  override hook(): void {
    (this as any).extra = "extra";
  }
}
class Throws extends Base {
  value = 1;
  override hook(): void {
    kept = this;
    throw new RangeError("in the hook");
  }
}
let kept: object | undefined;
const made: object[] = [new Fields(), new Derived(), new Further(), new Handlers(), new Parameters(1, "y"), new AfterCreates(false), new AfterCreates(true), new Adds()];
try {
  new Throws();
} catch (error) {
  look("left half made by " + (error as Error).name, kept!);
}
console.log(seen.join("\n"));
for (const object of made) {
  const inherited: string[] = [];
  for (const key in object) inherited.push(key);
  console.log(object.constructor.name, Object.keys(object).join(), JSON.stringify(object), inherited.join(), Object.keys({ ...object }).join());
}
for (let i = 0; i < 300; i++) {
  seen.length = 0;
  new Further();
  new Fields();
}
console.log(seen.join("\n"));
//// keys-named-by-constant-strings.ts
// A computed key that a constant string names is a name like any other: the literal is what it would be with the name written out.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name + ": " + e.message.split("\n")[0] : String(e))) } }
const TypeId = "~scope/TypeId";
const Kind = "kind" as const;
const Zero = "0";
const Proto = "__proto__";
interface Scope { readonly [TypeId]: typeof TypeId; readonly [Kind]: string; size: number; parent: Scope | undefined }
const make = (size: number, parent: Scope | undefined): Scope => ({ [TypeId]: TypeId, [Kind]: "scope", size, parent });
const show = (value: object): string => JSON.stringify(value) + " " + Object.keys(value).join();
row("made", () => show(make(1, undefined)));
row("read by the constant", () => make(1, undefined)[TypeId] + " " + make(2, undefined)[Kind]);
row("read by the name", () => make(1, undefined).kind + " " + make(3, make(4, undefined)).parent!.size);
row("in", () => (TypeId in make(1, undefined)) + " " + ("kind" in make(1, undefined)));
row("a string written in brackets", () => show({ ["written"]: 1, after: 2 }));
row("the order of keys", () => show({ last: 1, [Kind]: 2, [TypeId]: 3, first: 4 }));
row("a numeric string", () => show({ b: 1, [Zero]: 2, a: 3 }));
row("__proto__ in brackets is a property", () => { const made = { [Proto]: { inherited: 1 }, own: 2 }; return show(made) + " " + (Object.getPrototypeOf(made) === Object.prototype) + " " + ("inherited" in made) });
row("a function takes the name", () => { const made = { [Kind]: function () {}, [TypeId]: () => 1 }; return made[Kind].name + " | " + made[TypeId].name });
row("a constant read before it is set", () => { const made = { [Later]: 1 }; return show(made) });
const Later = "later";
row("and after", () => show({ [Later]: 1 }));
row("values are evaluated in order", () => { const seen: string[] = []; const note = (text: string): string => { seen.push(text); return text }; const made = { a: note("a"), [Kind]: note("kind"), z: note("z") }; return seen.join() + " " + show(made) });
row("with a spread", () => show({ ...make(1, undefined), [Kind]: "other" }));
row("a let is no constant", () => { let key = "one"; const made = { [key]: 1 }; key = "two"; return show(made) + " " + show({ [key]: 2 }) });
//// keys-of-instances-that-have-further-properties.ts
// Object.keys at one typed place, of instances that were given properties their class does not declare: every set of further keys, every order, and every change in between has its own list; a list handed out is the caller's to change.
class Options {
  host = "localhost";
  port = 80;
  path?: string;
  secure?: boolean;
}
const lines: string[] = [];
const collect: () => void = (globalThis as any).gc ?? (() => (globalThis as any).Bun.gc(true));
function keysOf(options: Options): string[] {
  return Object.keys(options);
}
function say(label: string, options: Options) {
  const first = keysOf(options);
  const second = keysOf(options);
  first.push("pushed");
  first[0] = "changed";
  lines.push(label + ": " + second.join() + " | " + keysOf(options).join() + " | " + (first !== second) + " | " + Object.getOwnPropertyNames(options).join() + " | " + Reflect.ownKeys(options).map(String).join());
}
const given = (more: [PropertyKey, unknown][]): Options => {
  const options = new Options();
  for (const [key, value] of more) (options as any)[key] = value;
  return options;
};
for (let round = 0; round < 4; round++) {
  say("none " + round, given([]));
  say("one " + round, given([["tag", round]]));
  say("another " + round, given([["label", round]]));
  say("two " + round, given([["tag", 1], ["label", 2]]));
  say("two the other way round " + round, given([["label", 2], ["tag", 1]]));
  const late = given([["tag", 1]]);
  say("before the optional fields " + round, late);
  late.path = "/";
  say("an optional field behind the further key " + round, late);
  late.secure = true;
  (late as any).more = 1;
  say("and more " + round, late);
  delete (late as any).tag;
  say("the first further key deleted " + round, late);
  delete late.path;
  say("an optional field deleted " + round, late);
  (late as any).tag = 2;
  say("the further key again " + round, late);
  const early = new Options();
  early.secure = false;
  (early as any).tag = 1;
  early.path = "x";
  say("optional fields on both sides " + round, early);
  const hidden = given([["tag", 1]]);
  Object.defineProperty(hidden, "hidden", { value: 1, enumerable: false, configurable: true });
  say("a key that is not listed " + round, hidden);
  const marked = given([["tag", 1], [Symbol.for("mark"), 2]]);
  say("a symbol " + round, marked);
  const indexed = given([["tag", 1], [1, "one"], [0, "zero"]]);
  say("index keys " + round, indexed);
  const computed = given([["tag", 1]]);
  Object.defineProperty(computed, "got", { get: () => 1, enumerable: true, configurable: true });
  say("a getter " + round, computed);
  say("frozen " + round, Object.freeze(given([["tag", 1]])));
  say("sealed " + round, Object.seal(given([["tag", 1]])));
  const many = given(Array.from({ length: 70 }, (_, i): [string, number] => ["k" + i, i]));
  lines.push("seventy " + round + ": " + keysOf(many).length + " " + keysOf(many)[71]);
  if (round === 1) collect();
}
const kept: Options[] = [];
for (let i = 0; i < 300; i++) kept.push(given([["tag" + (i % 5), i]]));
collect();
let total = 0;
for (let round = 0; round < 3; round++) for (const options of kept) total += keysOf(options)[2].length + keysOf(options).length;
lines.push("three hundred of five kinds: " + total);
console.log(lines.join("\n"));
//// kinds-made-behind-a-chain-of-helpers.ts
// The object comes up a chain of helpers: factory, base declaration, base node, a method of an object that was passed in, new. Only the factory says what kind it is.
enum SyntaxKind { Unknown, K0, K1, K2, K3, K4, K5, K6, K7, K8, K9, K10, K11 }
type Mutable<T> = { -readonly [K in keyof T]: T[K] };
interface Node { readonly kind: SyntaxKind; readonly pos: number; readonly end: number; readonly parent: Node; flags: number; id?: number }
interface Declaration extends Node { symbol: object | undefined; localSymbol: object | undefined }
interface N0 extends Node { readonly kind: SyntaxKind.K0; readonly a0: Node | undefined; readonly b0: number; readonly c0: string }
interface N1 extends Declaration { readonly kind: SyntaxKind.K1; readonly a1: Node | undefined; readonly b1: number; readonly c1: string }
interface N2 extends Node { readonly kind: SyntaxKind.K2; readonly a2: Node | undefined; readonly b2: number; readonly c2: string }
interface N3 extends Declaration { readonly kind: SyntaxKind.K3; readonly a3: Node | undefined; readonly b3: number; readonly c3: string }
interface N4 extends Node { readonly kind: SyntaxKind.K4; readonly a4: Node | undefined; readonly b4: number; readonly c4: string }
interface N5 extends Declaration { readonly kind: SyntaxKind.K5; readonly a5: Node | undefined; readonly b5: number; readonly c5: string }
interface N6 extends Node { readonly kind: SyntaxKind.K6; readonly a6: Node | undefined; readonly b6: number; readonly c6: string }
interface N7 extends Declaration { readonly kind: SyntaxKind.K7; readonly a7: Node | undefined; readonly b7: number; readonly c7: string }
interface N8 extends Node { readonly kind: SyntaxKind.K8; readonly a8: Node | undefined; readonly b8: number; readonly c8: string }
interface N9 extends Declaration { readonly kind: SyntaxKind.K9; readonly a9: Node | undefined; readonly b9: number; readonly c9: string }
interface N10 extends Node { readonly kind: SyntaxKind.K10; readonly a10: Node | undefined; readonly b10: number; readonly c10: string }
interface N11 extends Declaration { readonly kind: SyntaxKind.K11; readonly a11: Node | undefined; readonly b11: number; readonly c11: string }
