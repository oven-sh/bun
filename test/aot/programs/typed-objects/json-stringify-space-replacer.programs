//// literal-fields-filled-with-any-number.ts
// An object literal, a spread with an override and a class field fill enum fields with numbers that are no int32. The object has its keys in the written order and every value as it was given,
// whether or not the field has a narrow slot, also when it is frozen at once.
declare const console: { log(...values: unknown[]): void };

enum Kind { A, B, C }
interface Item { kind: Kind; flags: Kind; name: string; next?: Item | null }
function make(k: Kind, f: Kind): Item { return { kind: k, flags: f, name: "n" }; }
function makeInOtherOrder(k: Kind, f: Kind): Item { return { name: "o", flags: f, kind: k }; }
function makeLinked(k: Kind, next: Item | null): Item { return { kind: k, flags: Kind.B, name: "l", next }; }
function override(base: Item, k: Kind): Item { return { ...base, kind: k }; }
function overrideFirst(base: Partial<Item>, k: Kind): Item { return { kind: k, name: "p", ...base, flags: k }; }
function makeFrozen(k: Kind): Readonly<Item> { return Object.freeze({ kind: k, flags: k, name: "f" }); }
class Holder { item: Item; own: Kind; constructor(k: Kind) { this.own = k; this.item = { kind: k, flags: this.own, name: "h" }; } }

function show(value: unknown): string { return typeof value === "number" && Object.is(value, -0) ? "-0" : String(value); }
function typed(i: Item): string { return [i.kind, i.flags, i.kind === Kind.B, i.flags & 3, i.kind + 1, 1 / i.flags, i.name].map(show).join(" "); }
function untyped(u: any): string {
    const d = Object.getOwnPropertyDescriptor(u, "kind")!;
    return [Object.keys(u).join(), JSON.stringify(u), show(u.kind), show(u["fl" + "ags"]), d.writable, d.enumerable, d.configurable, Object.isFrozen(u)].join(" ");
}
function poke(target: any, name: string, value: unknown): void { target[name] = value; }

const names: string[] = JSON.parse('["kind","flags"]');
const numbers: number[] = JSON.parse("[0,-0,1,2,0.5,2147483647,2147483648,-2147483643,-2147483644,-2147483648,-2147483649,1e21,1e400]");
numbers.push(Number("x"));
let previous: Item | null = null;
for (const n of numbers) {
    const all: Item[] = [make(n, n), make(Kind.C, n), make(n, Kind.A), makeInOtherOrder(n, n), makeLinked(n, previous), override(make(1, 2), n), override(make(n, n), Kind.B), overrideFirst(make(n, 1), n), makeFrozen(n), new Holder(n).item];
    for (const each of all) console.log(typed(each), "|", untyped(each));
    previous = all[4];
    const changed = make(n, n);
    for (const name of names) poke(changed, name, 7);
    console.log(typed(changed), "|", untyped(changed));
    for (const name of names) poke(changed, name, n);
    console.log(typed(changed), "|", untyped(changed), show(new Holder(n).own), previous.next === null ? "first" : typed(previous.next!));
}
//// literal-fields-that-hold-strings-outlive-collections.ts
// A field of a literal type holds a small number for a text that the program spells in code, and a reference to an ordinary string for a text that stands in the type alone ("auto" and "manual" here) and comes from outside. Such a string, held by a local alone once the field is overwritten, must outlive a collection: to be measured, joined, stored into another object, compared.
// The functions are called through a table, so that nothing is inlined and no object is dissolved. The program asks for its collections itself and fills the freed cells anew.
type Mode = "on" | "off" | "auto" | "manual";
interface H { mode: Mode; maybe: Mode | null; n: number }
function collect(): void { const g: any = globalThis; if (g.Bun) g.Bun.gc(true); else g.gc() }
function fresh(text: string): string { return text.split("").join("") }
function churn(): number { let s = 0; for (let i = 0; i < 400; i++) s += F.fresh("junk" + i).length; return s }
function again(): void { F.collect(); F.churn() }
function made(i: number): H { return { mode: i & 1 ? "on" : "off", maybe: null, n: i } }
function grow(mode: unknown, maybe: unknown, n: number): any { const o: any = { mode }; o.maybe = maybe; o.n = n; return o }
function cast(o: any): H { return o as H }
function given(i: number): H { return F.cast(F.grow(F.fresh(i & 1 ? "auto" : "manual"), F.fresh("auto"), i)) }
function lengthLater(x: H): number { const a = x.mode; x.mode = "on"; F.again(); return a.length }
function textLater(x: H): string { const a = x.mode, b = x.maybe; x.mode = "on"; x.maybe = null; F.again(); return a + "," + b }
function copyLater(x: H, to: H): void { const a = x.mode, b = x.maybe; x.mode = "off"; x.maybe = null; F.again(); to.mode = a; to.maybe = b }
function sameLater(x: H, y: H): boolean { const a = x.mode; x.mode = "on"; F.again(); return a === y.mode }
function dropped(i: number): number { const a = F.given(i).mode; F.again(); return a.length }
const F = { collect, fresh, churn, again, made, grow, cast, given, lengthLater, textLater, copyLater, sameLater, dropped };
const lines: string[] = [];
for (let i = 0; i < 10; i++) {
  const to = F.made(i);
  F.copyLater(F.given(i), to); F.again();
  lines.push([F.lengthLater(F.given(i)), F.textLater(F.given(i)), to.mode, to.maybe, F.sameLater(F.given(i), F.given(i)), F.sameLater(F.given(i), F.given(i + 1)), F.dropped(i), F.lengthLater(F.made(i))].join());
}
console.log(lines.join("\n"));
//// literal-getter-redefines-itself.ts
////= memoizeOne-2
let built = 0;
////= rulesOf
////= describe
const described = memoizeOne(describe);

function lazy(): Factory {
  const made: Factory = {
    count: 5,
    get rules(): Rules {
      const value = { depth: this.count * 10 };
      Object.defineProperty(this, "rules", { value, writable: true, enumerable: true, configurable: true });
      return value;
    },
    make(kind) {
      this.count++;
      return kind + this.rules.depth;
    },
  };
  return made;
}
const one = lazy();
console.log(described(one), describe(one));
console.log(typeof Object.getOwnPropertyDescriptor(one, "rules")!.get, one.rules === one.rules, one.rules.depth);
one.rules = { depth: 3 };
console.log(describe(one), Object.keys(one).join());
const other = lazy();
console.log(other.rules === other.rules, described(other));
//// literal-getters-return-functions.ts
////= memoizeOne-2
let built = 0;
////= rulesOf
////= describe
const described = memoizeOne(describe);

interface Tools {
  add(a: number, b: number): number;
  twice(a: number): number;
  name: string;
}
let created = 0;
function binary(by: number): (a: number, b: number) => number {
  created++;
  return (a, b) => (a + b) * by;
}
function createTools(): Tools {
  const tools: Tools = {
    get add() {
      return binary(1);
    },
    get twice() {
      const add = tools.add;
      return (a: number) => add(a, a);
    },
    name: "tools",
  };
  return tools;
}
function useTools(tools: Tools): number {
  return tools.add(1, 2) + tools.twice(5);
}
const used = memoizeOne(useTools);
const tools = createTools();
console.log(used(tools), useTools(tools), created, tools.name, tools.add === tools.add);
const { add, twice } = tools;
console.log(add(2, 3), twice(4), created);
//// literal-union-field-widened-then-compared.ts
// A field whose type is a union of string literals, read into a place of a wider type (`string`, `unknown`, the result of `?.`) and then compared with a string.
// The functions are called through an array so that each is compiled by itself.
interface Entry { label: string; gender: "m" | "f" }
interface Holder { kind: "first" | "second" | "third"; other?: "first" | "second" }
const names: Record<string, Entry> = { array: { label: "array", gender: "m" }, map: { label: "map", gender: "f" }, set: { label: "set", gender: "f" } };
function entry(name?: string | null): Entry | undefined { return name ? names[name] : undefined; }

function toString(e: Entry): unknown { const g: string = e.gender; return g === "f"; }
function toStringReversed(e: Entry): unknown { const g: string = e.gender; return "f" === g; }
function toStringNot(e: Entry): unknown { const g: string = e.gender; return g !== "f"; }
function toStringLoose(e: Entry): unknown { const g: string = e.gender; return g == "f"; }
function toStringBranch(e: Entry): unknown { const g: string = e.gender; if (g === "f") return "she"; return "he"; }
function toStringOther(e: Entry): unknown { const g: string = e.gender; return g === "x"; }
function toStringTwice(e: Entry): unknown { const g: string = e.gender; return [g === "f", g === "m", g].join(); }
function toUnknown(e: Entry): unknown { const g: unknown = e.gender; return g === "f"; }
function toOptional(e: Entry): unknown { const g: string | undefined = e.gender; return g === "f"; }
function toVariable(e: Entry, wanted: string): unknown { const g: string = e.gender; return g === wanted; }
function twoWidened(e: Entry, other: Entry): unknown { const g: string = e.gender; const h: string = other.gender; return g === h; }
function oneWidened(e: Entry, other: Entry): unknown { const g: string = e.gender; return g === other.gender; }
function argument(e: Entry): unknown { return isF(e.gender); }
function isF(g: string): boolean { return g === "f"; }
function switched(e: Entry): unknown { const g: string = e.gender; switch (g) { case "f": return "she"; case "m": return "he"; default: return "it"; } }
function conditional(e: Entry): unknown { const g: string = e.gender; return `${e.label} ${g === "f" ? "she" : "he"}`; }
const onEntries: ((e: Entry, other: Entry) => unknown)[] = [toString, toStringReversed, toStringNot, toStringLoose, toStringBranch, toStringOther, toStringTwice, toUnknown, toOptional, e => toVariable(e, "f"), twoWidened, oneWidened, argument, switched, conditional];
for (const name of ["array", "map", "set"]) console.log(name, onEntries.map(f => String(f(names[name], names.map))).join(" "));

function chained(name: string): unknown { return entry(name)?.gender === "f"; }
function chainedBranch(name: string): unknown { return entry(name)?.gender === "f" ? "she" : "he"; }
function chainedStored(name: string): unknown { const verb = entry(name)?.gender === "f" ? "she" : "he"; return `${name} ${verb} is`.trim(); }
function defaulted(name: string): unknown { const g = entry(name)?.gender ?? "m"; return g === "f"; }
const onNames: ((name: string) => unknown)[] = [chained, chainedBranch, chainedStored, defaulted];
for (const name of ["array", "map", "set", "none"]) console.log(name, onNames.map(f => String(f(name))).join(" "));

function longer(h: Holder): unknown { const k: string = h.kind; return [k === "first", k === "second", k === "third", k === "fourth"].join(); }
function missing(h: Holder): unknown { const o: string | undefined = h.other; return [o === "first", o === undefined, o === "second"].join(); }
const onHolders: ((h: Holder) => unknown)[] = [longer, missing];
for (const h of [{ kind: "first" }, { kind: "second", other: "first" }, { kind: "third", other: "second" }] as Holder[]) console.log(h.kind, onHolders.map(f => String(f(h))).join(" "));
//// literals-at-fixed-layout-limit.ts
interface Key { key: number }
type F<T> = { value: T; more?: number };
interface G<T> { value: T; more?: number }
type Nine = F<F<F<F<F<F<F<F<F<Key>>>>>>>>>;
type Eight = F<F<F<F<F<F<F<F<Key>>>>>>>>;
type Ten = G<G<G<G<G<G<G<G<G<G<Key>>>>>>>>>>;

const eight: Eight = { value: { value: { value: { value: { value: { value: { value: { value: { key: 8 } } } } } } } } };
const nine: Nine = { value: { value: { value: { value: { value: { value: { value: { value: { value: { key: 9 } } } } } } } } } };
const ten: Ten = { value: { value: { value: { value: { value: { value: { value: { value: { value: { value: { key: 10 } } } } } } } } } } };
const around: Nine = { value: eight, more: 1 };

const readEight = () => eight.value.value.value.value.value.value.value.value.key;
const readNine = () => nine.value.value.value.value.value.value.value.value.value.key;
const readTen = () => ten.value.value.value.value.value.value.value.value.value.value.key;
////= lines-32	inner	from	Nine	Eight	from.value

console.log(readEight(), readNine(), readTen(), around.more, around.value === eight);
console.log(inner(nine).value.value.value.value.value.value.value.value.key, inner(around) === eight, nine.more, Object.keys(nine).join());
nine.more = 2;
nine.value = eight;
console.log(nine.more, readNine(), JSON.stringify(ten).length);
//// literals-typed-any-that-only-a-typed-function-gets.ts
// Object literals that are declared any and handed to a typed function at once: nothing else holds them, so they may be born as the record; and the neighbours that may not: held before or after, with a key more or fewer, in another order.
type Inner = { n: number };
type Message = { id: number; inner: Inner; tags: string[]; note?: string };

const lines: string[] = [];
const say = (label: string, ...values: unknown[]) => lines.push(label + ": " + values.map(value => JSON.stringify(value) ?? "undefined").join(" "));
let last: unknown;
function read(message: Message): number {
  last = message;
  return message.id + message.inner.n + message.tags.length + (message.note === undefined ? 0 : message.note.length);
}
function keysOf(message: Message): string {
  return Object.keys(message).join();
}
const inner: Inner = { n: 7 };
const tags = ["x", "y"];
const text = (n: number): any => "text" + n;
const anything = (value: unknown): any => value;

for (let i = 0; i < 4; i++) {
  const only: any = { id: i, inner, tags };
  say("only the function gets it " + i, read(only), last, Object.keys(last as object));

  const withNote: any = { id: i, inner, tags, note: "note" };
  say("with the optional field " + i, read(withNote), keysOf(last as Message));

  const otherOrder: any = { tags, note: "n", id: i, inner };
  say("in another order " + i, read(otherOrder), keysOf(last as Message), JSON.stringify(last));

  const heldAfter: any = { id: i, inner, tags };
  const sum = read(heldAfter);
  heldAfter.id = 100;
  say("held afterwards " + i, sum, heldAfter === last, (last as Message).id);

  const heldBefore: any = { id: i, inner, tags };
  const alias = heldBefore;
  say("held before " + i, read(heldBefore), alias === last);

  const surplus: any = { id: i, inner, tags, surplus: true };
  say("a key more " + i, read(surplus), keysOf(last as Message), (last as any).surplus);

  const unknownValues: any = { id: anything(i), inner: anything(inner), tags: anything(tags), note: text(i) };
  say("values of unknown type " + i, read(unknownValues), last);

  const plainInner: any = { id: i, inner: { n: i }, tags: ["only"] };
  say("a literal inside " + i, read(plainInner), last);

  const computed: any = { id: i, inner, tags, get note() { return "got"; } };
  say("a getter " + i, read(computed), keysOf(last as Message));

  const spread: any = { ...{ id: i, inner }, tags };
  say("a spread " + i, read(spread), keysOf(last as Message));

  const fraction: any = { id: i + 0.5, inner, tags };
  say("a fraction " + i, read(fraction), (last as Message).id);

  say("straight in the call " + i, read({ id: i, inner, tags } as any), keysOf(last as Message));
  const stored = last as any;
  stored.late = i;
  delete stored.id;
  say("changed from outside afterwards " + i, Object.keys(stored), stored.late, stored.id);
}
console.log(lines.join("\n"));
//// literals-under-record-types-used-as-records-and-as-maps.ts
// A literal that is written under `Record<string, T>` or an index signature has the names that are written, and the type allows any other. Some of these are only read, some grow, some lose names,
// some are handed to code that nobody knows, and one site makes objects of both sorts. Each line must read as it does without a compiler.
type Numbers = Record<string, number>;
interface ByName {
  [name: string]: number;
}

const lines: string[] = [];
function say(label: string, ...values: unknown[]) {
  lines.push(label + ": " + values.map(value => (typeof value === "string" ? value : JSON.stringify(value))).join(" | "));
}
function key(text: string): string {
  return text.split("").reverse().reverse().join("");
}
function namesByForIn(object: object): string {
  let names = "";
  for (const name in object) names += name + ",";
  return names;
}

// Only read.
const read: Numbers = { alpha: 1, bravo: 2, charlie: 3 };
say("read by name", read.alpha, read.bravo, read.charlie, read.delta);
say("read by key", read[key("alpha")], read[key("charlie")], read[key("delta")], read[key("toString")] === (Object.prototype.toString as unknown));
say("read has", "alpha" in read, key("bravo") in read, "delta" in read, Object.hasOwn(read, key("charlie")), read.hasOwnProperty("delta"), "constructor" in read);
say("read listed", Object.keys(read), Object.values(read), Object.entries(read), namesByForIn(read), read);
say("read copied", { ...read }, Object.assign({}, read), { ...read, bravo: 20, echo: 5 });

// Grows under keys that only the run knows, also under names that it has.
const grown: Numbers = { alpha: 1, bravo: 2 };
for (const name of ["zulu", "2", "alpha", "1", "yankee"]) grown[key(name)] = name.length;
say("grown", grown, Object.keys(grown), namesByForIn(grown), grown.alpha, grown.zulu, grown[1], grown["2"]);

// Loses names, by key and by name, and gets them back: they come last.
const shrunk: ByName = { alpha: 1, bravo: 2, charlie: 3 };
say("deleted", delete shrunk[key("alpha")], delete shrunk.charlie, delete shrunk[key("nothing")], shrunk, "alpha" in shrunk, shrunk.alpha);
shrunk.alpha = 10;
shrunk[key("charlie")] = 30;
say("put back", shrunk, Object.keys(shrunk));

// One site, many objects: every other one grows.
function make(i: number): Numbers {
  return { first: i, second: i * 2 };
}
let sum = 0;
const made: Numbers[] = [];
for (let i = 0; i < 2000; i++) {
  const one = make(i);
  if (i & 1) one[key("third") + (i % 3)] = i;
  sum += one.first + one.second + (one.third0 ?? 0) + (one[key("third1")] ?? 0);
  if (i % 500 === 1) made.push(one);
}
say("one site", sum, made);

// One site whose objects are only read, in a loop.
function pair(i: number): Numbers {
  return { low: i, high: i + 1 };
}
let total = 0;
for (let i = 0; i < 5000; i++) {
  const one = pair(i);
  total += one.low * one.high;
}
say("pairs", total);

// Names that built-in objects have, an empty name, names that look like numbers, and an own property named __proto__.
const __proto__ = 7;
const odd: Numbers = { constructor: 1, toString: 2, "": 3, "01": 4, "1": 5, "0": 6, "-1": 8, "1.5": 9, __proto__ };
say("odd names", Object.keys(odd), odd.constructor, odd[key("toString")], odd[""], odd["01"], odd[1], odd[0], odd["-1"], odd[1.5], Object.hasOwn(odd, "__proto__"), Object.getPrototypeOf(odd) === Object.prototype);
const below: Record<string, unknown> = { __proto__: read, own: 1 };
say("below another", below.alpha, below.own, Object.keys(below), namesByForIn(below), Object.getPrototypeOf(below) === read);

// Changed through built-ins.
const defined: Numbers = { alpha: 1, bravo: 2 };
Object.defineProperty(defined, "alpha", { get: () => 100, enumerable: false, configurable: true });
Object.defineProperty(defined, key("hidden"), { value: 5, enumerable: false });
say("defined", defined.alpha, defined[key("alpha")], defined.hidden, Object.keys(defined), defined, Object.getOwnPropertyNames(defined));
const frozen: Numbers = Object.freeze({ alpha: 1, bravo: 2 } as Numbers);
let refused = "";
try {
  frozen[key("charlie")] = 3;
} catch (error) {
  refused += (error as Error).constructor.name;
}
try {
  frozen.alpha = 3;
} catch (error) {
  refused += " " + (error as Error).constructor.name;
}
try {
  delete frozen[key("bravo")];
} catch (error) {
  refused += " " + (error as Error).constructor.name;
}
say("frozen", refused, frozen, Object.isFrozen(frozen));
const linked: Numbers = { alpha: 1 };
Object.setPrototypeOf(linked, { inherited: 9 });
say("linked", linked.inherited, linked[key("inherited")], Object.keys(linked), namesByForIn(linked));
const assigned: Numbers = { alpha: 1, bravo: 2 };
Object.assign(assigned, JSON.parse('{"bravo":20,"charlie":30}'));
say("assigned", assigned, assigned.bravo, assigned.charlie);

// Handed to code that nobody knows.
const handed: Numbers = { alpha: 1, bravo: 2 };
(globalThis as Record<string, unknown>)[key("holder")] = handed;
new Function("holder.charlie = 3; delete holder.alpha; holder.bravo = 'text'")();
say("handed out", handed, handed.alpha, handed.bravo, handed.charlie, typeof handed.bravo);

// Methods, which see the object they are called on.
const methods: Record<string, (this: Record<string, unknown>, by: number) => number> = {
  twice(by) {
    return by * 2 + Object.keys(this).length;
  },
  thrice: function (by) {
    return by * 3 + Object.keys(this).length;
  },
};
say("methods", methods.twice(1), methods[key("thrice")](1), methods.twice.name, methods.thrice.name);

// In other literals, under an assertion, under `satisfies`, as an argument, as a default, and as what a function returns.
const nested: { byName: Numbers; list: Numbers[] } = { byName: { alpha: 1 }, list: [{ alpha: 1 }, {}, { bravo: 2 }] };
nested.byName[key("bravo")] = 2;
nested.list[1][key("charlie")] = 3;
say("nested", nested, nested.byName.alpha, nested.list[0].alpha, nested.list[1].charlie, nested.list[2].alpha);
const asserted = { alpha: 1 } as Numbers;
asserted[key("bravo")] = 2;
const satisfied = { alpha: 1, bravo: 2 } satisfies Numbers;
function count(numbers: Numbers = { none: 0 }): number {
  let counted = 0;
  for (const name in numbers) counted += numbers[name] + name.length;
  return counted;
}
say("places", asserted, satisfied.alpha + satisfied.bravo, count({ alpha: 1, bravo: 2 }), count(), count(grown));

// It has the names of a type with members, and is tested for where that type is asked for.
////= Point
function isPoint(value: unknown): value is Point {
  return typeof value === "object" && value !== null && "x" in value && "y" in value;
}
const likePoint: Numbers = { x: 1, y: 2 };
likePoint[key("z")] = 3;
const points: unknown[] = [likePoint, { x: 3, y: 4 } as Point, { x: 5 }];
say("like a point", points.filter(isPoint).map(point => point.x + point.y), likePoint);

// Values of other types than the type says.
const loose: Numbers = { alpha: JSON.parse('"text"'), bravo: JSON.parse("null"), charlie: 1 };
say("loose", loose, typeof loose.alpha, loose.bravo, loose.charlie + 1);

// A table of constants that is read by words from outside.
const codes: Record<string, string> = { ok: "200", created: "201", missing: "404", broken: "500" };
let answered = "";
for (const word of "ok missing nothing broken created toString".split(" ")) answered += (Object.hasOwn(codes, word) ? codes[word] : "-") + " ";
say("table", answered);

console.log(lines.join("\n"));
//// literals-with-extra-keys.ts
// Object literals of declared types with keys that the types do not have, computed or spread in, ahead of the declared ones, between them and behind them: the keys keep their order, the values their places.
const show = (label: string, value: unknown) => console.log(label + ": " + JSON.stringify(value));

////= Point
////= lines-13	Named	id	number	label	string
const behind = (key: string, v: unknown): Point => ({ x: 1, y: 2, [key]: v });
const ahead = (key: string, v: unknown): Point => ({ [key]: v, x: 1, y: 2 });
const between = (key: string, v: unknown): Point => ({ x: 1, [key]: v, y: 2 });
const twice = (first: string, second: string, v: unknown): Point => ({ [first]: v, x: 1, y: 2, [second]: v });
const spreadIn = (more: object): Point => ({ x: 1, ...more, y: 2 });
const withoutOptional = (key: string, v: unknown): Named => ({ id: 1, [key]: v });
const withOptional = (key: string, v: unknown): Named => ({ id: 1, [key]: v, label: "l" });
const bySymbol = (key: symbol, v: unknown): Point => ({ x: 1, [key]: v, y: 2 });
const byIndex = (key: number, v: unknown): Point => ({ x: 1, y: 2, [key]: v });
const cast = (o: object): Point => o as Point;
const describe = (o: any) => [Object.keys(o).join(), JSON.stringify(o), Reflect.ownKeys(o).length, o.x ?? o.id, o.extra, o.k0];
const mark = Symbol("mark");

for (let round = 0; round < 5; round++) {
  const key = "k" + (round % 2);
  show("behind " + round, describe(behind(key, round)));
  show("ahead " + round, describe(ahead(key, round)));
  show("between " + round, describe(between(key, round)));
  show("twice " + round, describe(twice(key, "extra", round)));
  show("the same key twice " + round, describe(twice(key, key, round)));
  show("a declared name by key " + round, [describe(behind("x", round + 10)), describe(ahead("y", round + 10)), describe(between("y", round + 10))]);
  show("spread " + round, describe(spreadIn({ [key]: round, extra: [round] })));
  show("spread over " + round, describe(spreadIn({ x: round + 20, y: round + 30, extra: null })));
  show("without the optional " + round, describe(withoutOptional(key, round)));
  show("the optional by key " + round, describe(withoutOptional("label", "by key")));
  show("with the optional " + round, describe(withOptional(key, round)));
  show("symbol " + round, [describe(bySymbol(mark, round)), (bySymbol(mark, round) as any)[mark]]);
  show("index " + round, describe(byIndex(round, "at " + round)));
  show("held values " + round, describe(behind(key, { held: [round, { deep: key }] })));
  show("undefined and null " + round, [describe(behind(key, undefined)), describe(behind(key, null))]);
  const plain: any = { x: 1, y: 2 };
  plain[key] = round;
  plain.extra = "e";
  const same = cast(plain);
  show("cast " + round, [describe(same), same === plain]);
  const first: any = {};
  first[key] = round;
  first.y = 2;
  first.x = 1;
  show("cast in another order " + round, [describe(cast(first)), cast(first) === first]);
}

const kept: any[] = [];
for (let i = 0; i < 400; i++) kept.push(i % 3 === 0 ? behind("k" + (i % 50), i) : i % 3 === 1 ? ahead("k" + (i % 50), i) : between("w" + i, i));
let sum = 0, keys = "";
for (const o of kept) {
  for (const key in o) sum += typeof o[key] === "number" ? o[key] : 0;
  keys = Object.keys(o).join();
}
show("many", [sum, keys, Object.keys(kept[300]).join(), Object.keys(kept[301]).join(), { ...kept[302] }, structuredClone(kept[303])]);
for (const o of kept) {
  o.extra = 1;
  delete o.x;
}
show("changed", [Object.keys(kept[300]).join(), Object.keys(kept[301]).join(), Object.keys(kept[302]).join(), kept.reduce((n, o) => n + o.extra + o.y, 0)]);
//// literals-with-several-accessors/main.ts
import { run } from "./untyped.js";
run();
//// literals-with-several-accessors/shapes.ts
export type Counter = { start: number; readonly next: number; label: string; twice: number; readonly third: string; last: boolean; only: number };
export function makeCounter(start: number): Counter {
  return {
    start,
    get next() {
      return this.start + 1;
    },
    label: "c",
    get twice() {
      return this.start * 2;
    },
    set twice(value: number) {
      this.start = value / 2;
    },
    get third() {
      return this.label + this.start;
    },
    last: true,
    set only(value: number) {
      this.start = value;
    },
  };
}
export type One = { start: number; readonly next: number };
export function makeOne(start: number): One {
  return {
    start,
    get next() {
      return this.start + 1;
    },
  };
}
export type Many = { readonly a: number; readonly b: number; readonly c: number; readonly d: number; readonly e: number; readonly f: number; readonly g: number; readonly h: number; readonly i: number; readonly j: number; start: number };
export function makeMany(start: number): Many {
  return {
    get a() { return start; },
    get b() { return start + 1; },
    get c() { return start + 2; },
    get d() { return start + 3; },
    get e() { return start + 4; },
    get f() { return start + 5; },
    get g() { return start + 6; },
    get h() { return start + 7; },
    get i() { return start + 8; },
    get j() { return start + 9; },
    start,
  };
}
export function sumOfCounter(counter: Counter): number {
  return counter.next + counter.twice + counter.third.length;
}
export function sumOfMany(many: Many): number {
  return many.a + many.b + many.c + many.d + many.e + many.f + many.g + many.h + many.i + many.j + many.start;
}
//// literals-with-several-accessors/untyped.js
import { makeCounter, makeOne, makeMany, sumOfCounter, sumOfMany } from "./shapes.ts";

function describe(o) {
  const descriptors = Object.getOwnPropertyDescriptors(o);
  return Reflect.ownKeys(o).map(key => {
    const d = descriptors[key];
    return String(key) + ":" + ("value" in d ? JSON.stringify(d.value) : (d.get ? "get" : "") + (d.set ? "set" : "")) + (d.enumerable ? "" : "!e") + (d.configurable ? "" : "!c");
  }).join();
}

export function run() {
  const said = new Set();
  let sum = 0;
  for (let i = 0; i < 300; i++) {
    const counter = makeCounter(i);
    sum += sumOfCounter(counter) + counter.next + counter["twice"];
    counter.twice = 10;
    counter.only = counter.start + i;
    counter.more = i;
    said.add(describe(counter).replace(/\d+/g, "n") + " | " + Object.keys(counter) + " | " + JSON.stringify(counter).replace(/\d+/g, "n") + " | " + Object.keys({ ...counter }));
    const one = makeOne(i);
    sum += one.next;
    said.add(describe(one).replace(/\d+/g, "n"));
    const many = makeMany(i);
    sum += sumOfMany(many) + many.j;
    if (i % 50 === 49) delete many.c;
    if (i % 70 === 69) Object.defineProperty(many, "k", { get() { return 1; }, enumerable: true, configurable: true });
    said.add(describe(many).replace(/\d+/g, "n"));
    if (typeof Bun !== "undefined" && i % 100 === 99) Bun.gc(true);
  }
  for (const line of said) console.log(line);
  console.log(sum);
}
//// local-object-alive-until-reference-compare-on-the-right.ts
// local-object-alive-until-reference-compare with the local on the right of the comparison, and with !==: two references out of narrow slots may be compared as their 32-bit words, and the object that a local alone holds must stay alive up to the comparison, or its place is given to a new object and the two words are equal.
interface N { v: number; w: number }
interface R { a: N; b: N | null }
function n(i: number): N { return { v: i, w: i } }
function make(i: number): R { return { a: n(i), b: n(i) } }
function putA(y: R, i: number): void { y.a = n(i) }
function putB(y: R, i: number): void { y.b = n(i) }
function collect(): void { const g: any = globalThis; if (g.Bun) g.Bun.gc(true); else g.gc() }
function heldOnTheRight(x: R, y: R, turns: number): number { const p = x.a; x.a = y.a; let hits = 0; for (let i = 0; i < turns; i++) { if ((i & 255) === 0) F.collect(); F.putA(y, i); if (y.a === p) hits++ } return hits }
function heldOptionalOnTheRight(x: R, y: R, turns: number): number { const p = x.b; x.b = null; let hits = 0; for (let i = 0; i < turns; i++) { if ((i & 255) === 0) F.collect(); F.putB(y, i); if (y.b === p) hits++ } return hits }
function differs(x: R, y: R, turns: number): number { const p = x.a; x.a = y.a; let misses = 0; for (let i = 0; i < turns; i++) { if ((i & 255) === 0) F.collect(); F.putA(y, i); if (y.a !== p) misses++ } return misses }
const F = { putA, putB, collect, heldOnTheRight, heldOptionalOnTheRight, differs };
let a = 0, b = 0, c = 0;
for (let i = 0; i < 20; i++) { a += F.heldOnTheRight(make(i), make(i), 2048); b += F.heldOptionalOnTheRight(make(i), make(i), 2048); c += F.differs(make(i), make(i), 2048) }
console.log(a, b, c);
