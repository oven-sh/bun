////: NodeObject
function NodeObject(this: Mutable<Node>, kind: SyntaxKind, pos: number, end: number) {
  this.pos = pos;
  this.end = end;
  this.kind = kind;
  this.id = 0;
  this.flags = 0;
  this.parent = undefined!;
}
