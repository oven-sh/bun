//// json-stringify-string-stays-compiled.ts
declare const aotRuntimeCounters: () => string;
const writersFailed = () => Number(/(\d+)\tJSONWriterFailed/.exec(aotRuntimeCounters())![1]);
declare const aotOperationCount: (name: string) => number;

////= hide-2

function measure(label: string, run: () => string | undefined): void {
    const finished = (aotOperationCount("operationAOTJSONWriterFinish") - writersFailed());
    let length = 0;
    for (let i = 0; i < 100; i++) length += run()!.length;
    console.log(label + ": " + length + " characters, " + ((aotOperationCount("operationAOTJSONWriterFinish") - writersFailed()) - finished) + " texts finished by compiled code");
}

function quote(text: string): string {
    return JSON.stringify(text);
}

function quoteOrNothing(text: string | undefined): string | undefined {
    return JSON.stringify(text);
}

function quoteAnything(value: any): string | undefined {
    return JSON.stringify(value);
}

const made = ["made", "at", "run", "time"].join(" ");
measure("a string", () => quote(made));
measure("a string with quotes", () => quote(made + '"'));
measure("16-bit text", () => quote(made + "\u4e2d"));
measure("a string or undefined", () => quoteOrNothing(made));
measure("a value without a type", () => quoteAnything(made));
measure("a String object without a type", () => quoteAnything(hide(new String(made))));
//// json-stringify-trailing-optional-members.ts
// Objects of one type that were created with the first two to six of its members, in a hot loop: every one is written like plain Bun writes it.
declare const console: { log(...values: unknown[]): void };
interface Inner { x: number }
interface Sparse { id: number; name: string; note?: string; tag?: string; more?: string; last?: string }
interface Nested { inner: Inner; after?: number; end?: string }

function make(kind: number, i: number): Sparse {
    switch (kind) {
    case 0: return { id: i, name: "n" };
    case 1: return { id: i, name: "n", note: "o" };
    case 2: return { id: i, name: "n", note: "o", tag: "t" };
    case 3: return { id: i, name: "n", note: "o", tag: "t", more: "m" };
    case 4: return { id: i, name: "n", note: "o", tag: "t", more: "m", last: "l" };
    case 5: return { id: i, name: "n", note: undefined, tag: "t" };
    default: return { id: i, name: "n", note: "o", tag: undefined, more: undefined };
    }
}
function makeNested(kind: number, i: number): Nested {
    if (kind === 0) return { inner: { x: i } };
    if (kind === 1) return { inner: { x: i }, after: i + 1 };
    return { inner: { x: i }, after: i + 1, end: "e" };
}
function write(value: Sparse): string { return JSON.stringify(value); }
function writeNested(value: Nested): string { return JSON.stringify(value); }

const seen = new Set<string>();
let length = 0;
for (let i = 0; i < 4000; i++) {
    const text = write(make(i % 7, i & 1));
    length += text.length;
    seen.add(text);
    seen.add(writeNested(makeNested(i % 3, i & 1)));
}
const out: unknown[] = [length, ...[...seen].sort()];

const storedLater: Sparse = { id: 1, name: "n" };
storedLater.note = "later";
out.push(write(storedLater));
storedLater.more = "out of order";
out.push(write(storedLater));
delete storedLater.note;
out.push(write(storedLater));

const inherits: Sparse = Object.create({ note: "inherited", last: "inherited" }, {});
inherits.id = 2;
inherits.name = "own";
out.push(write(inherits));
const withPrototype: Sparse = { id: 3, name: "n" };
Object.setPrototypeOf(withPrototype, { note: "inherited" });
out.push(write(withPrototype));

const grows: Nested = { inner: { x: 1 } };
(grows.inner as any).toJSON = function () { grows.after = 5; return "grown"; };
out.push(writeNested(grows), writeNested(grows));
const shrinks: Nested = { inner: { x: 1 }, after: 2, end: "e" };
(shrinks.inner as any).toJSON = function () { delete shrinks.end; return "shrunk"; };
out.push(writeNested(shrinks), writeNested(shrinks));
const reordered: Nested = { inner: { x: 1 }, after: 2 };
(reordered.inner as any).toJSON = function () { delete reordered.after; reordered.end = "e"; reordered.after = 3; return "reordered"; };
out.push(writeNested(reordered), writeNested(reordered));
console.log(out.map(String).join("\n"));
//// json-stringify-typed-objects-with-undeclared-keys.ts
// A typed object that carries undeclared keys is written as a plain object of the same content is.
interface Point { x: number; y: number; label?: string }
interface Segment { id: number; from: Point; to: Point; points: Point[]; note: string | null }

let different = 0;
let total = 0;
function check(label: string, typed: unknown, plain: unknown): void {
  const writers: ((value: unknown) => string | undefined)[] = [
    value => JSON.stringify(value),
    value => JSON.stringify({ held: value, list: [value, value] }),
    value => JSON.stringify(value, null, 2),
    value => JSON.stringify(value, ["x", "o", "from", "id"]),
    value => JSON.stringify(value, (key, held) => (key === "o" ? "replaced" : held)),
  ];
  for (const write of writers) {
    total++;
    let [first, second] = ["", ""];
    try {
      first = String(write(typed));
    } catch (error) {
      first = "throws " + (error as Error).name;
    }
    try {
      second = String(write(plain));
    } catch (error) {
      second = "throws " + (error as Error).name;
    }
    if (first !== second && different++ < 5) console.log(label + " DIFFERS\n  " + first + "\n  " + second);
  }
}

const points = ['{"x":1,"y":2}', '{"x":1,"y":2,"o":3}', '{"o":"first","x":1,"p":[1,{"q":null}],"y":2,"label":"l","r":{"s":{"t":true}}}', '{"x":1.5,"y":-0,"o":1e21,"p":-1e-7,"q":123456789012}', '{"x":1,"y":2,"a\\"b":1,"c\\nd":2,"é":3,"日本":4,"":5,"😀":"😀"}', '{"x":1,"y":2,"o":"a\\"b\\n\\u0001é日本"}', '{"x":1,"y":2,"0":"zero","7":"seven","o":1}', '{"x":1,"y":2,"__proto__":{"a":1},"constructor":1}', '{"x":1,"y":2,"toJSON":1}', '{"x":1,"y":2,"o":{"toJSON":2}}', "{" + Array.from({ length: 90 }, (_, at) => `"k${at}":${at}`).join(",") + ',"x":1,"y":2}'];
for (const text of points) {
  for (let round = 0; round < 3; round++) check(text, JSON.parse(text) as Point, globalThis.JSON.parse(text));
}
for (const from of points.slice(0, 6)) {
  for (const to of points.slice(0, 6)) {
    const text = `{"a":1,"id":1,"from":${from},"b":${to},"to":${to},"points":[${from},${to}],"note":null,"c":[${from}]}`;
    check(text, JSON.parse(text) as Segment, globalThis.JSON.parse(text));
  }
}

const changes: [string, (value: any) => void][] = [
  ["undefined", value => { value.o = undefined; }],
  ["a function", value => { value.o = () => 1; }],
  ["a symbol", value => { value.o = Symbol("s"); }],
  ["a bigint", value => { value.o = 1n; }],
  ["a date", value => { value.o = new Date(0); }],
  ["a map", value => { value.o = new Map([[1, 2]]); }],
  ["an object with toJSON", value => { value.o = { toJSON: () => "told" }; }],
  ["toJSON of its own", value => { value.toJSON = () => "told"; }],
  ["toJSON that is no function", value => { value.toJSON = 5; }],
  ["a getter", value => { Object.defineProperty(value, "o", { get: () => "got", enumerable: true, configurable: true }); }],
  ["a hidden key", value => { Object.defineProperty(value, "o", { value: 1, enumerable: false, configurable: true }); }],
  ["a symbol key", value => { value[Symbol.for("k")] = 1; }],
  ["itself", value => { value.o = value; }],
  ["a boxed string", value => { value.o = new String("boxed"); }],
  ["NaN", value => { value.o = NaN; value.p = Infinity; }],
  ["a rope", value => { value.o = "left ".repeat(5) + value.x + " right"; }],
  ["gone", value => { delete value.o; }],
  ["a member gone", value => { delete value.label; delete value.o; }],
  ["frozen", value => { Object.freeze(value); }],
  ["another prototype", value => { Object.setPrototypeOf(value, { toJSON: () => "inherited" }); }],
];
for (const [label, change] of changes) {
  for (const text of ['{"x":1,"y":2,"o":3}', '{"n":0,"x":1,"o":3,"label":"l","y":2,"p":4}']) {
    const [typed, plain] = [JSON.parse(text) as Point, globalThis.JSON.parse(text)];
    change(typed);
    change(plain);
    check(label, typed, plain);
  }
}
console.log(total + " texts, " + different + " differ");
//// json-stringify-typed-objects-with-undeclared-keys-stay-compiled.ts
// The typed writer writes a typed object's undeclared keys itself, below another object and at the top: the engine's own writer is not asked.
declare const aotRuntimeCounters: () => string;
const writersFailed = () => Number(/(\d+)\tJSONWriterFailed/.exec(aotRuntimeCounters())![1]);
declare const aotOperationCount: undefined | ((name: string) => number);
interface Point { x: number; y: number; label?: string }
interface Segment { id: number; from: Point; to: Point }
const counted = typeof aotOperationCount === "function" ? aotOperationCount : null;
const finished = () => (counted ? (counted("operationAOTJSONWriterFinish") - writersFailed()) : 0);
function measure(label: string, run: () => string, isWrittenByTypedWriter: boolean): void {
  for (let i = 0; i < 10; i++) run();
  const before = finished();
  let length = 0;
  for (let i = 0; i < 100; i++) length += run().length;
  console.log(label + ": " + length + " characters", counted ? finished() - before === (isWrittenByTypedWriter ? 100 : 0) : true);
}
const plainPoint = JSON.parse('{"x":1,"y":2}') as Point;
measure("no undeclared key", () => JSON.stringify(plainPoint), true);
const one = JSON.parse('{"x":1,"y":2,"o":3}') as Point;
measure("one undeclared key", () => JSON.stringify(one), true);
const several = JSON.parse('{"a":[1,2],"x":1,"b":{"c":"d"},"y":2,"label":"l","e":null,"f":"g"}') as Point;
measure("undeclared keys in three places", () => JSON.stringify(several), true);
const below = JSON.parse('{"id":1,"from":{"x":1,"y":2,"o":3},"to":{"p":4,"x":1,"y":2}}') as Segment;
measure("undeclared keys below", () => JSON.stringify(below), true);
const told = JSON.parse('{"x":1,"y":2,"o":3}') as Point;
(told as any).toJSON = () => "told";
measure("toJSON of its own", () => JSON.stringify(told), false);
//// json-stringify-values-that-the-declared-types-do-not-name.ts
// Members and elements of which the declared type says nothing, or the wrong thing: each such value is written by the general code, in its place in the text, and the members around it are not.
interface Envelope { id: number; data: unknown; name: string; more: unknown; ok: boolean }
interface First { data: unknown; id: number }
interface Last { id: number; data: unknown }
interface Only { data: unknown }
interface List { id: number; items: unknown[]; end: string }
interface Wrong { id: number; name: string; tags: string[]; at: Date }

const word: string = process.argv[2] ?? "w";
const launder = new Function("v", "return v" + word.slice(word.length)) as <V>(v: V) => V;

let count = 0;
////= show-2	out = String(make()

function writeEnvelope(e: Envelope): string { return JSON.stringify(e); }
function writeFirst(e: First): string { return JSON.stringify(e); }
function writeLast(e: Last): string { return JSON.stringify(e); }
function writeOnly(e: Only): string { return JSON.stringify(e); }
function writeList(e: List): string { return JSON.stringify(e); }
function writeWrong(e: Wrong): string { return JSON.stringify(e); }
const envelope = (data: unknown, more: unknown = 1): Envelope => ({ id: 7, data, name: word, more, ok: true });

const values: [string, () => unknown][] = [
  ["undefined", () => undefined],
  ["null", () => null],
  ["a number", () => 1.5],
  ["a string", () => 'q"' + word],
  ["a wide string", () => "значение"],
  ["a boolean", () => false],
  ["a symbol", () => Symbol("s")],
  ["a function", () => () => 1],
  ["an empty object", () => ({})],
  ["an empty array", () => []],
  ["a plain object", () => JSON.parse('{"b":[1,{"c":null}],"a":"x","":0}')],
  ["an object with members that have no text", () => ({ a: undefined, b: () => 1, c: Symbol("s"), d: 1 })],
  ["an array with elements that have no text", () => [undefined, () => 1, Symbol("s"), 1]],
  ["an object with wide text", () => ({ ключ: "значение", plain: "p" })],
  ["a typed object", () => envelope(1)],
  ["a typed object that unseen code has held", () => launder(envelope(launder([word]), launder({ deep: [envelope(null)] })))],
  ["a date", () => new Date(86400000)],
  ["an invalid date", () => new Date(NaN)],
  ["a map, a set, a regular expression", () => [new Map([[1, 2]]), new Set([1]), /x/g]],
  ["boxed primitives", () => [new String("s"), new Number(2), new Boolean(false), Object(Symbol("s"))]],
  ["a typed array", () => new Uint8Array([1, 2, 3])],
  ["an error", () => new Error("message")],
  ["a class instance with an accessor and a private field", () => new (class P { #h = 1; x = 2; get y() { return this.#h; } })()],
  ["an object without a prototype", () => Object.assign(Object.create(null), { a: 1 })],
  ["a getter", () => ({ get a() { return "got"; }, b: 2 })],
  ["a proxy of an object", () => new Proxy({ a: 1, b: 2 }, { ownKeys: () => ["b", "a"] })],
  ["a proxy of an array", () => new Proxy([1, 2], {})],
  ["toJSON, which is told the key", () => ({ toJSON(key: string) { return typeof key + " " + key; } })],
  ["toJSON that answers undefined", () => ({ toJSON() { return undefined; } })],
  ["toJSON that answers a function", () => ({ toJSON() { return () => 1; } })],
  ["toJSON that answers an object with toJSON", () => ({ toJSON() { return { toJSON() { return "not called"; }, kept: 1 }; } })],
  ["toJSON below the value, which is told its own key", () => ({ inner: { toJSON(key: string) { return key; } }, list: [0, { toJSON(key: string) { return key; } }] })],
  ["toJSON that is not callable", () => ({ toJSON: 5, a: 1 })],
  ["a function with toJSON", () => Object.assign(() => 1, { toJSON() { return "from a function"; } })],
  ["more text than the first buffer holds", () => Array.from({ length: 2500 }, (_, i) => ({ i }))],
  ["one long string", () => word.repeat(20000)],
  ["long text that turns wide at the end", () => [word.repeat(9000), "конец"]],
  ["an own toJSON behind a long member, which is told the key", () => ({ long: word.repeat(9000), toJSON(key: string) { return key; } })],
  ["an own toJSON behind a wide member, which is told the key", () => ({ wide: "значение", toJSON(key: string) { return key; } })],
  ["an own toJSON behind a wide and a long member", () => ({ wide: "значение", long: word.repeat(9000), toJSON(key: string) { return key; } })],
  ["long text under toJSON", () => Object.assign([word.repeat(9000)], { toJSON(key: string) { return [key, word.repeat(9000)]; } })],
];

const brief = (text: string) => (text.length <= 220 ? text : text.length + " " + text.slice(0, 60) + " .. " + text.slice(-60));
for (const [name, make] of values) {
  show(name, () => [
    writeEnvelope(envelope(make())),
    writeEnvelope(envelope(make(), make())),
    writeFirst({ data: make(), id: 1 }),
    writeLast({ id: 1, data: make() }),
    writeOnly({ data: make() }),
    writeList({ id: 1, items: [make()], end: "e" }),
    writeList({ id: 1, items: [0, make(), "s", make()], end: "e" }),
  ].map(brief).join(" | "));
}

show("a bigint", () => writeEnvelope(envelope(1n)));
show("a bigint with toJSON", () => {
  (BigInt.prototype as any).toJSON = function (key: string) { return key + "=" + this; };
  try { return writeEnvelope(envelope(1n, [2n])); } finally { delete (BigInt.prototype as any).toJSON; }
});
show("a cycle through the value", () => { const e = envelope(null); e.data = { back: e }; return writeEnvelope(e); });
show("a cycle inside the value", () => { const o: any = {}; o.self = [o]; return writeEnvelope(envelope(o)); });
show("the same object twice", () => { const o = { a: 1 }; return writeEnvelope(envelope(o, o)); });

show("toJSON throws, and the next write starts clean", () => {
  const thrower = { toJSON() { throw new RangeError("from toJSON"); } };
  const out: string[] = [];
  for (const e of [envelope(thrower), envelope(1, thrower), envelope([0, thrower])]) {
    try { out.push(writeEnvelope(e)); } catch (error) { out.push((error as Error).message); }
    out.push(writeEnvelope(envelope(2)));
  }
  return out.join(" | ");
});
show("a getter throws below the value", () => writeEnvelope(envelope({ a: 1, get b(): number { throw new TypeError("from a getter"); } })));
show("toJSON writes the same kind of record", () => writeEnvelope(envelope({ toJSON() { return writeEnvelope(envelope(1)); } }, { toJSON() { return [writeLast({ id: 2, data: { toJSON() { return writeOnly({ data: 3 }); } } })]; } })));
show("toJSON changes the record it is in", () => {
  const e = envelope(null);
  e.data = { toJSON() { e.name = "changed"; (e as any).added = 1; delete (e as any).ok; return "x"; } };
  return writeEnvelope(e) + " " + writeEnvelope(e);
});
show("toJSON replaces a later member by a value of another kind", () => {
  const e = envelope(null);
  e.data = { toJSON() { (e as any).name = { now: "an object" }; (e as any).ok = "yes"; return 0; } };
  return writeEnvelope(e);
});
show("toJSON redefines a later member as a getter", () => {
  const e = envelope(null);
  e.data = { toJSON() { Object.defineProperty(e, "name", { get() { return "by getter"; }, enumerable: true }); return 0; } };
  return writeEnvelope(e);
});
show("toJSON hides a later member", () => {
  const e = envelope(null);
  e.data = { toJSON() { Object.defineProperty(e, "name", { enumerable: false }); return 0; } };
  return writeEnvelope(e);
});
show("toJSON gives the record a toJSON", () => {
  const e = envelope(null);
  e.data = { toJSON() { (e as any).toJSON = () => "too late for this write"; return 0; } };
  return writeEnvelope(e) + " " + writeEnvelope(e);
});
show("an element changes the list it is in", () => {
  const items: unknown[] = [1, null, 3, 4];
  items[1] = { toJSON() { items[2] = { swapped: true }; items.length = 3; return "x"; } };
  return writeList({ id: 1, items, end: "e" });
});
show("an element changes the record around the list", () => {
  const l: List = { id: 1, items: [], end: "e" };
  l.items.push({ toJSON() { l.end = "changed"; (l as any).added = true; return 0; } });
  return writeList(l) + " " + writeList(l);
});

show("values of other kinds than declared", () => [
  writeWrong(launder({ id: "one", name: 2, tags: { not: "an array" }, at: "a string" } as unknown as Wrong)),
  writeWrong(launder({ id: null, name: undefined, tags: null, at: undefined } as unknown as Wrong)),
  writeWrong(launder({ id: [1], name: ["n"], tags: [["deep"]], at: [new Date(0)] } as unknown as Wrong)),
  writeWrong(launder({ id: 1, name: "n", tags: ["t"], at: new Date(0) })),
  writeWrong(launder({ id: 1, name: "n", tags: ["t"], at: Object.assign(new Date(0), { toJSON() { return "own toJSON"; } }) })),
].join(" | "));

show("beside other text", () => "<" + writeEnvelope(envelope({ a: 1 })) + ">" + `[${JSON.stringify(envelope([{ b: 2 }]))}]` + JSON.stringify({ data: undefined } as Only) + String(JSON.stringify(launder(undefined))));

show("many times over", () => {
  const plain = JSON.parse('{"x":1,"y":[true,"s"]}');
  const e = launder(envelope(plain, [plain, 2]));
  let total = 0;
  for (let i = 0; i < 20000; i++) total += writeEnvelope(e).length;
  return total + " " + writeEnvelope(e);
});
//// json-stringify-wide-string-under-any-member.ts
interface Top {
  held: unknown;
  count?: number;
  list: number[];
}
interface Two {
  first?: unknown;
  second?: unknown;
  third?: unknown;
}
function top(held: unknown, count?: number): Top {
  return { held, count, list: [] };
}
function two(first?: unknown, second?: unknown, third?: unknown): Two {
  return { first, second, third };
}
const held: unknown[] = [
  { text: "plain" },
  { text: "\u00e9" },
  { text: "\u4e2d" },
  { text: "\ud83d\ude00" },
  { text: "\ud800" },
  ["\u4e2d"],
  [{ text: "\u4e2d" }],
  { "\u4e2d": 1 },
  { inner: { text: "\u4e2d" }, after: 1 },
  "\u4e2d",
  {},
  [],
];
for (const value of held) {
  console.log(JSON.stringify(top(value, 127)));
  console.log(JSON.stringify(top(value)));
  console.log(JSON.stringify([top(value, 1), top(value)]));
  console.log(JSON.stringify(two(value, value, value)));
  console.log(JSON.stringify(two(undefined, value, value)));
  console.log(JSON.stringify(two(value, undefined, value)));
  console.log(JSON.stringify(two(undefined, undefined, value)));
  console.log(JSON.stringify(two(top(value), top(value, 2))));
  console.log(JSON.stringify(top(value, 127), null, 2));
  console.log(JSON.parse(JSON.stringify(top(value, 127))).count);
}
//// json-stringify-wide-strings-in-handed-over-parts.ts
// JSON.stringify of a typed value hands the parts it has no code for (objects made by a spread, untyped data) to the runtime's
// writer. A string there that does not fit in 8 bits is written in place like one in a typed field.
interface Comment {
  id: number;
  body: string;
  at: Date;
}
interface CommentNode extends Comment {
  replies: CommentNode[];
}
interface Thread {
  title: string;
  nodes: CommentNode[];
  extra: unknown;
}

const bodies = [
  "plain",
  "café",
  "arrow → here",
  "\u{1f600}",
  'quote " backslash \\ newline \n tab \t →',
  "\ud800 alone",
  "alone \udc00",
  "  ",
  "",
  "\u0001\u001f\u007f\u0080ÿĀ",
  "→".repeat(70),
  "x".repeat(70) + "→",
  "→".repeat(3000),
];

const comments: Comment[] = bodies.map((body, id) => ({ id, body, at: new Date(1_700_000_000_000 + id * 86_400_123) }));

function nodesOf(from: number, depth: number): CommentNode[] {
  const nodes: CommentNode[] = [];
  for (let i = from; i < comments.length; i += 3) nodes.push({ ...comments[i], replies: depth ? nodesOf(from + 1, depth - 1) : [] });
  return nodes;
}

export function write(thread: Thread): string {
  return JSON.stringify(thread);
}
export function writeNodes(nodes: CommentNode[]): string {
  return JSON.stringify(nodes);
}

function describe(text: string): string {
  let sum = 0;
  for (let i = 0; i < text.length; i++) sum = (sum * 31 + text.charCodeAt(i)) | 0;
  return text.length + " " + sum + " " + text.slice(0, 60).replace(/[^ -~]/g, c => "\\u" + c.charCodeAt(0).toString(16).padStart(4, "0"));
}

for (let from = 0; from < 3; from++) {
  for (let depth = 0; depth < 3; depth++) {
    const thread: Thread = { title: from ? "t→" : "t", nodes: nodesOf(from, depth), extra: JSON.parse(JSON.stringify({ list: bodies, ["k" + from]: bodies[from + 2] })) };
    const text = write(thread);
    console.log(from, depth, describe(text), text === JSON.stringify(thread, (key, value) => value), JSON.stringify(JSON.parse(text)) === text);
    console.log(from, depth, describe(writeNodes(thread.nodes)));
  }
}

const wideKey: Thread = { title: "t", nodes: [], extra: JSON.parse('{"\\u2192":"\\u2192","a":1}') };
console.log(describe(write(wideKey)));
const cyclic: Thread = { title: "→", nodes: nodesOf(0, 1), extra: null };
const loop: Record<string, unknown> = { text: "→" };
loop.self = loop;
cyclic.extra = loop;
try {
  write(cyclic);
} catch (error) {
  console.log((error as Error).name);
}
cyclic.extra = { toJSON: () => "→ from toJSON" };
console.log(describe(write(cyclic)));
(globalThis as any).kept = [write, writeNodes];
//// json-stringify-writes-whole-numbers-of-number-fields.ts
// JSON.stringify of objects whose type is known writes a field declared `number` by code made for the type. Most such numbers are whole and short; every other one has to come out as the language says: negative ones, negative zero, the first number with nine digits, what lies outside 32 and 53 bits, fractions, exponents, NaN and the infinities
interface Reading {
  id: number;
  value: number;
  label: string;
  ok: boolean;
  more?: number;
}
interface Page {
  total: number;
  readings: Reading[];
  raw: number[];
}

const values: number[] = [
  0, -0, 1, 9, 10, 42, 99, 100, 999, 1000, 9999, 10000, 65535, 99999, 100000, 1234567, 9999999, 10000000, 99999999, 100000000, 100000001, 2147483647, 2147483648, 4294967295, 4294967296,
  -1, -9, -10, -99999999, -100000000, -2147483648, -2147483649, 9007199254740991, 9007199254740992, -9007199254740991, 1e21, 1e20, 123456789012345680000, 0.5, -0.5, 0.1, 1.5, 99999999.5, 1e-7, 5e-324,
  1.7976931348623157e308, NaN, Infinity, -Infinity, 0.1 + 0.2, 100 / 3, 7 / 7, 1e3, 2 ** 26, 2 ** 27,
];

function makePage(scale: number): Page {
  const readings: Reading[] = [];
  for (let i = 0; i < values.length; i++) {
    const reading: Reading = { id: i * scale, value: values[i]! * scale, label: "r" + i, ok: i % 2 === 0 };
    if (i % 3 === 0) reading.more = values[values.length - 1 - i]!;
    readings.push(reading);
  }
  return { total: readings.length / scale, readings, raw: values.map((value) => value / scale) };
}

const lines: string[] = [];
for (const scale of [1, 2, 0.5, -1, 1000]) lines.push(JSON.stringify(makePage(scale)));
let length = 0;
for (let round = 0; round < 300; round++) length += JSON.stringify(makePage(1 + (round % 4))).length;
lines.push("length " + length);
lines.push(JSON.stringify({ id: -0, value: 1e8, label: "", ok: false } satisfies Reading));
console.log(lines.join("\n"));
//// key-and-name-caches-after-eden-gc.ts
// Reads, stores and `in` by computed keys and by names on objects of many short-lived shapes, with collections of the young in between: what the engine remembers about a shape or a key that has died is never taken for a new one.
const shell = globalThis as any;
const collect: (full: boolean) => void = shell.Bun ? (full: boolean) => shell.Bun.gc(full) : (full: boolean) => (full ? shell.fullGC() : shell.edenGC());
type Bag = Record<string, unknown>;
function shape(seed: number, width: number): Bag {
  const o: Bag = {};
  for (let i = 0; i < width; i++) o["p" + ((seed + i) % 23) + "_" + (seed % 5)] = seed + i;
  return o;
}
function readAll(o: Bag, keys: string[]): number {
  let t = 0;
  for (const k of keys) {
    const v = o[k];
    if (typeof v === "number") t += v;
    if (k in o) t += 1;
    if (Object.hasOwn(o, k)) t += 2;
  }
  return t;
}
const symbols = [Symbol("a"), Symbol("b"), Symbol("c")];
class Base {
  get viaGetter(): number {
    return 5;
  }
  inherited = 3;
}
const longLived: Bag[] = [];
for (let i = 0; i < 40; i++) longLived.push(shape(i, 1 + (i % 9)));
let total = 0;
const lines: string[] = [];
for (let round = 0; round < 30; round++) {
  const keys: string[] = [];
  for (let i = 0; i < 23; i++) keys.push("p" + i + "_" + (round % 5));
  for (let i = 0; i < 300; i++) {
    const o = shape(round * 31 + i, 1 + (i % 12));
    total += readAll(o, keys);
    o["extra" + (i % 7)] = i;
    (o as Record<symbol, unknown>)[symbols[i % 3]] = i;
    total += (o as Record<symbol, number>)[symbols[i % 3]];
    const b = new Base() as unknown as Bag;
    b["own" + (i % 4)] = i;
    total += (b["viaGetter"] as number) + (b["inherited"] as number) + ("missing" + (i % 3) in b ? 100 : 0);
    if (i % 50 === 0) delete o[keys[i % keys.length]];
  }
  for (const o of longLived) total += readAll(o, keys);
  collect(round % 9 === 8);
  for (const o of longLived) total += readAll(o, keys);
  if (round % 3 === 0) collect(false);
  lines.push(round + " " + total);
}
console.log(lines.join("\n"));
//// key-order-literals.ts
// Each object literal keeps its own key order, whatever the order of the fields in its declared type.
interface Rec { a: number; b: string; c?: boolean; d?: number; e: number }
function show(o: object): string { return Object.keys(o).join("") + " " + JSON.stringify(o) }
const declared: Rec = { a: 1, b: "b", c: true, d: 4, e: 5 }
const reversed: Rec = { e: 5, d: 4, c: true, b: "b", a: 1 }
const shuffled: Rec = { c: false, a: 1, e: 5, b: "b" }
const least: Rec = { e: 0, a: 0, b: "" }
console.log(show(declared), show(reversed), show(shuffled), show(least))

function pick(n: number): Rec {
  switch (n % 6) {
    case 0: return { a: n, b: "0", e: n }
    case 1: return { b: "1", a: n, e: n }
    case 2: return { e: n, b: "2", a: n }
    case 3: return { d: n, a: n, b: "3", e: n }
    case 4: return { a: n, d: n, c: true, b: "4", e: n }
    default: return { c: false, e: n, d: n, b: "5", a: n }
  }
}
const picked: string[] = []
for (let i = 0; i < 12; i++) picked.push(Object.keys(pick(i)).join(""))
console.log(picked.join())

// One access site over all orders: the values do not follow the order.
function total(list: Rec[]): string { let s = 0, t = ""; for (const r of list) { s += r.a * 100 + r.e + (r.d ?? 0.5); t += r.b + (r.c === undefined ? "-" : r.c ? "T" : "F") } return s + t }
const all: Rec[] = []
for (let i = 0; i < 12; i++) all.push(pick(i))
console.log(total(all), total([declared, reversed, shuffled, least]))

// An explicit undefined is a key; a field left out is not.
const explicit: Rec = { a: 1, c: undefined, b: "x", d: undefined, e: 2 }
console.log(Object.keys(explicit).join(""), JSON.stringify(explicit), "c" in explicit, "c" in least, Object.hasOwn(explicit, "d"), Object.hasOwn(least, "d"), explicit.c, least.c)

// A name written twice keeps its first place and its last value; the values are evaluated in the order written.
const trace: string[] = []
function step<T>(label: string, v: T): T { trace.push(label); return v }
const evaluated: Rec = { e: step("e", 1), a: step("a", 2), b: step("b", "s"), d: step("d", 3) }
console.log(trace.join(), show(evaluated))
const source: { a?: number; b: string } = { a: 7, b: "src" }
const twice: Rec = { e: 1, ...source, a: 9, d: 2 }
const before: Rec = { a: 0, ...source, e: 3 }
console.log(show(twice), show(before))

// Computed names that are constants, shorthand, methods and quoted names take part in the same order.
const keyD = "d" as const
const a = 11, e = 12
const mixed: Rec = { [keyD]: 1, e, "b": "q", a }
console.log(show(mixed), Object.entries(mixed).map(p => p.join("=")).join("&"))

// Nested literals: each level has its own order.
interface Outer { first: Rec; second?: Rec; tag: string }
const nested: Outer = { tag: "t", second: { e: 1, a: 2, b: "n" }, first: { b: "m", e: 3, a: 4, c: true } }
console.log(show(nested), Object.keys(nested.first).join(""), Object.keys(nested.second ?? {}).join(""))

// The conditional operator, a logical operator and a function result between literals of several orders.
function choose(x: boolean, y: boolean): Rec { return x ? (y ? { a: 1, e: 2, b: "xy" } : { e: 2, a: 1, b: "x" }) : (y && { b: "y", e: 2, a: 1 }) || { b: "", a: 1, c: true, e: 2 } }
console.log([choose(true, true), choose(true, false), choose(false, true), choose(false, false)].map(o => Object.keys(o).join("")).join())

// Every way of listing agrees.
function listings(o: Rec): string {
  const forIn: string[] = []
  for (const k in o) forIn.push(k)
  return [Object.keys(o).join(""), forIn.join(""), Reflect.ownKeys(o).join(""), Object.getOwnPropertyNames(o).join(""), Object.entries(o).map(p => p[0]).join(""),
    Object.keys({ ...o }).join(""), Object.keys(Object.assign({}, o)).join(""), Object.keys(JSON.parse(JSON.stringify(o))).join(""), Object.keys(Object.getOwnPropertyDescriptors(o)).join("")].join("|")
}
console.log(listings(reversed), listings(shuffled), listings(pick(5)), listings(explicit))
//// key-order-of-class-instances.ts
// The key order of class instances: initializers, parameter properties, stores in constructors, base class before subclass, and fields added late.
function keys(o: object): string { return Object.keys(o).join() }
function show(o: object): string { return keys(o) + " " + JSON.stringify(o) }

class Plain { c = 3; a = 1; b = 2 }
console.log(show(new Plain()))

// The constructor stores in an order that is not the declared one.
class Stored {
  first: number; second: string; third: boolean
  constructor(n: number) { this.third = n > 0; this.first = n; this.second = "s" + n }
}
console.log(show(new Stored(1)))

// Initializers run before the body of the constructor; parameter properties before initializers.
class Params {
  own = "own"
  constructor(public x: number, readonly y: string, private z = 5) { this.late = x + z }
  late: number
  sum() { return this.x + this.z + this.late }
}
console.log(show(new Params(1, "y")), new Params(2, "y", 1).sum())

// Base fields come first, then the derived ones, also when the base constructor stores late.
class Base0 { b1 = 1; b2: number; constructor() { this.b2 = 2 } }
class Mid0 extends Base0 { m1 = "m"; constructor() { super(); this.b1 = 10 } }
class Leaf0 extends Mid0 { l1 = true; b2 = 20; l2: number; constructor() { super(); this.l2 = 5; this.m1 = "changed" } }
console.log(show(new Base0()), show(new Mid0()), show(new Leaf0()))

// Branches in the constructor: the same class, several orders.
class Branchy {
  p?: number; q?: string; r = 0
  constructor(mode: number) {
    if (mode === 1) { this.q = "q"; this.p = 1 } else if (mode === 2) { this.p = 2 } else if (mode === 3) { this.p = 3; this.q = "q3" }
  }
}
const modes: string[] = []
for (let m = 0; m < 4; m++) modes.push(JSON.stringify(new Branchy(m)))
console.log(modes.join(" "))
const lateBranch = new Branchy(2)
lateBranch.q = "late"
console.log(JSON.stringify(lateBranch), lateBranch.p, lateBranch.q, lateBranch.r)

// A helper called by the constructor stores fields; so does a method of the derived class called by the base constructor.
class Helped {
  a = 1; viaHelper?: number; z?: number
  constructor() { fill(this); this.z = 26 }
}
function fill(h: Helped) { h.viaHelper = 7 }
console.log(JSON.stringify(new Helped()))
class Hooked { start = "s"; constructor() { this.hook() } hook() {} }
class Hooking extends Hooked { extra?: string; own = "o"; hook() { this.extra = "from hook" } }
console.log(JSON.stringify(new Hooking()), new Hooking().extra, new Hooking().own)

// Extra properties, deletes and late fields on instances. A field that is created again while there are extra properties: see type-rules/key-order-of-class-instances.
class Opt { a = 1; b?: number; c = 3 }
const o1 = new Opt()
const anyO1: any = o1
anyO1.extra = "x"; o1.b = 2; anyO1.more = "y"
console.log(JSON.stringify(o1))
delete anyO1.extra; delete anyO1.more; delete o1.b; o1.b = 22; anyO1.more = "y"
console.log(JSON.stringify(o1), o1.a + o1.b + o1.c)

// Accessors, methods, statics and private names are not keys.
class Rich {
  static count = 0
  #hidden = 1
  shown = 2
  get twice() { return this.shown * 2 }
  set twice(v: number) { this.shown = v / 2 }
  method() { return this.#hidden }
}
const rich = new Rich()
rich.twice = 10
console.log(show(rich), rich.twice, rich.method(), Object.getOwnPropertyNames(rich).join(), Object.getOwnPropertyNames(Rich.prototype).join())

// Instances beside literals of the same interface: each keeps its own order, one site reads both.
interface HasAB { a: number; b?: number }
const list: HasAB[] = [new Opt(), { b: 1, a: 2 }, o1, { a: 3 }, new Plain()]
console.log(list.map(x => Object.keys(x).join("") + ":" + (x.a + (x.b ?? 0))).join())

// Copies of instances are plain objects in the same order.
console.log(show({ ...new Leaf0() }), show(Object.assign({}, new Params(1, "y"))), Object.entries(new Stored(0)).map(e => e.join("=")).join("&"))
//// key-order-traced.ts
// Object spread, `Object.assign` and destructuring over getters and setters, with the order of all accesses recorded.
const trace: string[] = []
const getterSource = { get port() { trace.push("get port"); return 7 }, get host() { trace.push("get host"); return "g" } }
class Watched { #port = 0; host = "w"; get port() { return this.#port } set port(v: number) { trace.push("set port " + v); this.#port = v * 2 } }
const watched = new Watched()
console.log(Object.keys(watched).join(), JSON.stringify(watched))
Object.assign(watched, getterSource, { port: 1 })
console.log(watched.port, Object.keys(watched).join(), JSON.stringify(watched))
//// keyed-stores-to-typed-fields.ts
// `x[key] = value` where x is an object of a type of the program and key names a field: in code that knows the type and in code that knows nothing. Each store is made several times over with one key, so that what is remembered for the key is used. The last line counts: once a key is known, a store that fits does not leave compiled code.
declare const aotOperationCount: undefined | ((name: string) => number);
interface Inner { v: number }
interface Kinds { whole: number; fraction: number; flag: boolean; text: string; textOrNull: string | null; textOrUndefined: string | undefined; both: number | string; anything: unknown; inner: Inner; list: number[]; call: () => number; big: bigint; sym: symbol; maybeNumber?: number; maybeText?: string; maybeFlag?: boolean; maybeInner?: Inner }
type Shape = { kind: "circle"; r: number } | { kind: "square"; side: number };
class Point { constructor(public x: number, public y: number, public label?: string) {} get sum() { return this.x + this.y; } set sum(v: number) { this.x = v; this.y = 0; } }
class Point3 extends Point { z = 3; readonly fixed = 1; }
function hide(value: unknown): any { return value; }
let count = 0;
const say = (v: unknown): unknown => v === undefined ? "undefined" : typeof v === "number" ? (v !== v ? "NaN" : Object.is(v, -0) ? "-0" : !isFinite(v) ? String(v) : v) : typeof v === "bigint" ? "bigint " + v : typeof v === "symbol" ? "symbol" : typeof v === "function" ? "function" : v;
function show(name: string, make: () => unknown) {
  let out: string;
  try { out = JSON.stringify(make(), (_k, v) => say(v)); } catch (e) { out = "throws " + (e as Error).name; }
  console.log(String(++count).padStart(2, "0"), name + ":", out);
}
function put(x: any, key: any, value: any) { x[key] = value; return x[key]; }
function putTyped<K extends keyof Kinds>(x: Kinds, key: K, value: Kinds[K]) { x[key] = value; return x[key]; }
function sloppy(x: any, key: any, value: any) { return new Function("x", "key", "value", "x[key] = value; return x[key];")(x, key, value); }
const make = (): Kinds => ({ whole: 1, fraction: 1.5, flag: true, text: "t", textOrNull: null, textOrUndefined: undefined, both: 1, anything: 1, inner: { v: 1 }, list: [1], call: () => 1, big: 1n, sym: Symbol.for("s") });
const times = <R>(f: (i: number) => R): R[] => { const out: R[] = []; for (let i = 0; i < 6; i++) out.push(f(i)); return out; };
const plain = (...list: [string | symbol, unknown][]): any => { const o = JSON.parse("{}"); for (const [k, v] of list) o[k] = v; return o; };
show("numbers into a whole number", () => { const x = make(); return [0, 1, -1, 1073741823, 1073741824, -1073741824, -1073741825, 2147483647, 2147483648, -2147483648, -2147483649, 4294967296, 1.5, -0, NaN, Infinity, 1e21, 5e-324].map(v => [put(x, "whole", v), x.whole]); });
show("numbers into a fraction", () => { const x = make(); return [0, 1, -1, 2147483648, 1.5, -0, NaN, -Infinity, 1e21, 5e-324].map(v => [put(x, "fraction", v), x.fraction]); });
show("each kind, what fits, through any", () => { const x = make(), inner: Inner = { v: 2 }, f = () => 2; return times(i => [put(x, "flag", !(i & 1)), put(x, "text", "t" + i), put(x, "textOrNull", i & 1 ? null : "n" + i), put(x, "textOrUndefined", i & 1 ? undefined : "u" + i), put(x, "both", i & 1 ? i : "b" + i), put(x, "anything", [i, "a", null, undefined, inner, true][i]), put(x, "inner", inner) === inner, put(x, "call", f) === f, put(x, "big", BigInt(i)), put(x, "sym", Symbol.iterator) === Symbol.iterator, x]); });
show("each kind, by its type", () => { const x = make(), inner: Inner = { v: 2 }; return times(i => [putTyped(x, "whole", i), putTyped(x, "fraction", i + 0.5), putTyped(x, "flag", !(i & 1)), putTyped(x, "text", "t" + i), putTyped(x, "textOrNull", i & 1 ? null : "n"), putTyped(x, "both", i & 1 ? i : "b"), putTyped(x, "inner", inner) === inner, putTyped(x, "maybeNumber", i & 1 ? undefined : i), x.whole + x.fraction, x.text.length]); });
show("optional fields: made, replaced, undefined, deleted, made again", () => { const x = make(); return times(i => { if (i === 3) { delete x.maybeNumber; delete x.maybeText; delete x.maybeFlag; delete x.maybeInner; } return [put(x, "maybeNumber", i), put(x, "maybeText", i & 1 ? undefined : "m" + i), put(x, "maybeFlag", !!(i & 1)), put(x, "maybeInner", { v: i } as Inner), Object.keys(x).slice(-4)]; }); });
show("many objects, one key", () => { let sum = 0; for (let i = 0; i < 3000; i++) { const x = make(); put(x, "whole", i); put(x, "text", "t" + (i & 7)); put(x, "maybeNumber", i); sum += x.whole + x.text.length + x.maybeNumber!; } return sum; });
show("typed and plain in turn, one site", () => { const list: any[] = [make(), plain(["whole", 0]), new Point(1, 2), make(), plain(), [1], make()]; return list.map((x, i) => [put(x, "whole", i), Object.keys(x).length]); });
show("keys from a list, from a loop, put together, a symbol, a number", () => { const x = make(), out: unknown[] = []; for (const key of Object.keys(x).slice(0, 2)) out.push(put(x, key, 7)); for (const key in hide(x)) if (key === "both") out.push(put(x, key, "looped")); out.push(times(i => put(x, "wh" + ["ole"][0], i)), put(x, Symbol.for("extra"), 1), put(x, 0, "zero"), put(x, "0", "zero again"), Object.keys(x).length); return out; });
