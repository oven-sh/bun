    { a: 9007199254740991, b: -9007199254740991, c: 1.7976931348623157e308, d: 4294967295 },
    { a: 0.5, b: 1073741823, c: -1073741824, d: -1073741825 },
    { a: 1 / 3, b: 100, c: 1e3, d: 12345.678 },
];
