  tree = factory.create4(tree, 4 + round, "s4");
  tree = factory.create5(tree, 5 + round, "s5");
  tree = factory.create6(tree, 6 + round, "s6");
  tree = factory.create7(tree, 7 + round, "s7");
  tree = factory.create8(tree, 8 + round, "s8");
  tree = factory.create9(tree, 9 + round, "s9");
  tree = factory.create10(tree, 10 + round, "s10");
  tree = factory.create11(tree, 11 + round, "s11");
}
console.log(weigh(tree), Object.keys(tree!).join(","));
//// kinds-of-one-class.ts
// Eight factories construct one class and store names of their own on the instance, beside a subclass and plain instances.
class Base { kind: number; pos: number; parent: Base | undefined; constructor(kind: number, pos: number) { this.kind = kind; this.pos = pos; this.parent = undefined; } describe() { return 'base ' + this.kind; } }
class Special extends Base { extra: number; constructor(pos: number) { super(-2, pos); this.extra = pos * 2; } }
interface K0 extends Base { a0?: Base | undefined; b0?: number; c0?: string }
interface K1 extends Base { a1?: Base | undefined; b1?: number; c1?: string }
interface K2 extends Base { a2?: Base | undefined; b2?: number; c2?: string }
interface K3 extends Base { a3?: Base | undefined; b3?: number; c3?: string }
interface K4 extends Base { a4?: Base | undefined; b4?: number; c4?: string }
interface K5 extends Base { a5?: Base | undefined; b5?: number; c5?: string }
interface K6 extends Base { a6?: Base | undefined; b6?: number; c6?: string }
interface K7 extends Base { a7?: Base | undefined; b7?: number; c7?: string }
function make0(i: number, p: Base | undefined): K0 { const n = new Base(0, i) as K0; n.parent = p; n.a0 = p; n.b0 = i; n.c0 = 'w'; return n; }
function read0(n: K0): number { return (n.a0 === undefined ? 0 : 1) + (n.b0 ?? 0) + (n.c0 ?? '').length; }
function make1(i: number, p: Base | undefined): K1 { const n = new Base(1, i) as K1; n.parent = p; n.a1 = p; n.b1 = i; n.c1 = 'w'; return n; }
function read1(n: K1): number { return (n.a1 === undefined ? 0 : 1) + (n.b1 ?? 0) + (n.c1 ?? '').length; }
function make2(i: number, p: Base | undefined): K2 { const n = new Base(2, i) as K2; n.parent = p; n.a2 = p; n.b2 = i; n.c2 = 'w'; return n; }
function read2(n: K2): number { return (n.a2 === undefined ? 0 : 1) + (n.b2 ?? 0) + (n.c2 ?? '').length; }
function make3(i: number, p: Base | undefined): K3 { const n = new Base(3, i) as K3; n.parent = p; n.a3 = p; n.b3 = i; n.c3 = 'w'; return n; }
function read3(n: K3): number { return (n.a3 === undefined ? 0 : 1) + (n.b3 ?? 0) + (n.c3 ?? '').length; }
function make4(i: number, p: Base | undefined): K4 { const n = new Base(4, i) as K4; n.parent = p; n.a4 = p; n.b4 = i; n.c4 = 'w'; return n; }
function read4(n: K4): number { return (n.a4 === undefined ? 0 : 1) + (n.b4 ?? 0) + (n.c4 ?? '').length; }
function make5(i: number, p: Base | undefined): K5 { const n = new Base(5, i) as K5; n.parent = p; n.a5 = p; n.b5 = i; n.c5 = 'w'; return n; }
function read5(n: K5): number { return (n.a5 === undefined ? 0 : 1) + (n.b5 ?? 0) + (n.c5 ?? '').length; }
function make6(i: number, p: Base | undefined): K6 { const n = new Base(6, i) as K6; n.parent = p; n.a6 = p; n.b6 = i; n.c6 = 'w'; return n; }
function read6(n: K6): number { return (n.a6 === undefined ? 0 : 1) + (n.b6 ?? 0) + (n.c6 ?? '').length; }
function make7(i: number, p: Base | undefined): K7 { const n = new Base(7, i) as K7; n.parent = p; n.a7 = p; n.b7 = i; n.c7 = 'w'; return n; }
function read7(n: K7): number { return (n.a7 === undefined ? 0 : 1) + (n.b7 ?? 0) + (n.c7 ?? '').length; }
const keep: Base[] = []; let last: Base | undefined = undefined;
for (let i = 0; i < 40; ++i) { let n: Base; switch (i % 10) {
  case 0: n = make0(i, last); break;
  case 1: n = make1(i, last); break;
  case 2: n = make2(i, last); break;
  case 3: n = make3(i, last); break;
  case 4: n = make4(i, last); break;
  case 5: n = make5(i, last); break;
  case 6: n = make6(i, last); break;
  case 7: n = make7(i, last); break;
  case 8: n = new Special(i); break;
  default: n = new Base(-1, i); } keep.push(n); last = n; }
function total(): number { let sum = 0; for (const n of keep) { sum = (sum + n.pos) | 0; switch (n.kind) {
  case 0: sum = (sum + read0(n as K0)) | 0; break;
  case 1: sum = (sum + read1(n as K1)) | 0; break;
  case 2: sum = (sum + read2(n as K2)) | 0; break;
  case 3: sum = (sum + read3(n as K3)) | 0; break;
  case 4: sum = (sum + read4(n as K4)) | 0; break;
  case 5: sum = (sum + read5(n as K5)) | 0; break;
  case 6: sum = (sum + read6(n as K6)) | 0; break;
  case 7: sum = (sum + read7(n as K7)) | 0; break;
} } return sum; }
console.log('late', keep.length, total(), keep[3]!.describe(), keep[8]! instanceof Special, keep[8]! instanceof Base, keep[3]! instanceof Base, Object.keys(keep[3]!).join(','), Object.keys(keep[8]!).join(','), JSON.stringify({ ...keep[9]!, parent: 0 }));
//// kinds-of-one-constructor-function.ts
// Four factories construct one constructor function and store names of their own on the object. Each kind has its own size, and nothing else tells it from its siblings:
// prototype, instanceof, key order, in, delete, a late name, freeze, spread, JSON.stringify and structuredClone answer as for any object.
enum SyntaxKind { Unknown, K0, K1, K2, K3 }
type Mutable<T> = { -readonly [K in keyof T]: T[K] };
interface Node { readonly kind: SyntaxKind; readonly pos: number; readonly end: number; readonly parent: Node; flags: number; id?: number }
interface N0 extends Node { readonly kind: SyntaxKind.K0; readonly a0: Node | undefined; readonly b0: number; readonly c0: string }
interface N1 extends Node { readonly kind: SyntaxKind.K1; readonly a1: Node | undefined; readonly b1: number; readonly c1: string }
interface N2 extends Node { readonly kind: SyntaxKind.K2; readonly a2: Node | undefined; readonly b2: number; readonly c2: string }
interface N3 extends Node { readonly kind: SyntaxKind.K3; readonly a3: Node | undefined; readonly b3: number; readonly c3: string }
////= NodeObject
NodeObject.prototype.describe = function (this: Node) { return "node " + this.kind; };
const NodeConstructor = NodeObject as any as new (kind: SyntaxKind, pos: number, end: number) => Node;
////= lines-8	create0	N0	K0	a0	b0	c0
////= lines-8	create1	N1	K1	a1	b1	c1
////= lines-8	create2	N2	K2	a2	b2	c2
////= lines-8	create3	N3	K3	a3	b3	c3
function weigh(node: Node | undefined): number {
  if (!node) return 0;
  switch (node.kind) {
    case SyntaxKind.K0: { const n = node as N0; return n.b0 + n.c0.length + weigh(n.a0); }
    case SyntaxKind.K1: { const n = node as N1; return n.b1 + n.c1.length + weigh(n.a1); }
    case SyntaxKind.K2: { const n = node as N2; return n.b2 + n.c2.length + weigh(n.a2); }
    case SyntaxKind.K3: { const n = node as N3; return n.b3 + n.c3.length + weigh(n.a3); }
  }
  return -1;
}
let tree: Node | undefined = undefined;
for (let round = 0; round < 3; round++) {
  tree = create0(tree, 0 + round, "s0");
  tree = create1(tree, 1 + round, "s1");
  tree = create2(tree, 2 + round, "s2");
  tree = create3(tree, 3 + round, "s3");
}
console.log(weigh(tree));
const last = tree!;
console.log(Object.keys(last).join(","));
console.log(JSON.stringify({ ...last, a3: undefined }));
console.log(last instanceof (NodeObject as any), Object.getPrototypeOf(last) === NodeObject.prototype, (last as any).describe());
console.log((last as any).a0, "b0" in last, "b3" in last, Object.prototype.hasOwnProperty.call(last, "c3"));
(last as any).late = 7;
delete (last as any).b3;
console.log(Object.keys(last).join(","), (last as any).late, (last as any).b3);
Object.freeze(last);
console.log(Object.isFrozen(last), structuredClone({ ...last, a3: undefined, parent: undefined }).kind);
//// kinds-with-integer-fields-in-places-of-their-own.ts
// A constructor function makes objects of many kinds. Each kind declares integer fields of its own, none, one, two or three of them, between fields that hold objects and strings,
// so an empty object of one kind differs from an empty object of another in more than its size. A field that nothing has stored is absent, whatever the kind.
const enum Kind { Unknown, Plain, Count, CountLate, Pair, PairApart, Triple, Text, Flagged, Wide }
interface Node { kind: Kind; pos: number; end: number; flags: number; id: number; parent: Node | undefined }
interface Plain extends Node { kind: Kind.Plain; child?: Node }
interface Count extends Node { kind: Kind.Count; count?: number; child?: Node }
interface CountLate extends Node { kind: Kind.CountLate; first?: Node; second?: Node; third?: Node; count?: number }
interface Pair extends Node { kind: Kind.Pair; low?: number; high?: number; child?: Node }
interface PairApart extends Node { kind: Kind.PairApart; low?: number; first?: Node; name?: string; second?: Node; high?: number }
interface Triple extends Node { kind: Kind.Triple; a?: number; child?: Node; b?: number; name?: string; c?: number }
interface Text extends Node { kind: Kind.Text; text?: string; length?: number }
interface Flagged extends Node { kind: Kind.Flagged; isOpen?: boolean; depth?: number; isLast?: boolean }
interface Wide extends Node { kind: Kind.Wide; f0?: Node; f1?: Node; f2?: Node; f3?: Node; f4?: Node; f5?: Node; f6?: Node; f7?: Node; f8?: Node; f9?: Node; last?: number }
interface NodeConstructor { new (kind: Kind, pos: number, end: number): Node }
function NodeObject(this: Node, kind: Kind, pos: number, end: number) { this.pos = pos; this.end = end; this.kind = kind; this.id = 0; this.flags = 0; this.parent = undefined }
const Maker = NodeObject as unknown as NodeConstructor
function make<T extends Node>(kind: T["kind"], pos: number): T { return new Maker(kind, pos, pos + 1) as T }

const integerFields = ["count", "low", "high", "a", "b", "c", "length", "depth", "last"]
const otherFields = ["child", "first", "second", "third", "name", "text", "isOpen", "isLast", "f0", "f9"]
function show(label: string, node: any) {
  const held = integerFields.concat(otherFields).filter(name => name in node || node[name] !== undefined || Object.hasOwn(node, name))
  console.log(label, Object.keys(node).join(), JSON.stringify(node), "holds:", held.join() || "nothing more")
}

const kinds = [Kind.Unknown, Kind.Plain, Kind.Count, Kind.CountLate, Kind.Pair, Kind.PairApart, Kind.Triple, Kind.Text, Kind.Flagged, Kind.Wide, 10 as Kind, -1 as Kind]
for (let round = 0; round < 3; round++) {
  for (const kind of kinds)
    show("empty " + kind, make<Node>(kind, round))
}

function fillCount(node: Count, value: number) { node.count = value; return node }
function fillLate(node: CountLate, value: number) { node.count = value; node.second = node; return node }
function fillPair(node: Pair, low: number, high: number) { node.high = high; node.low = low; return node }
function fillApart(node: PairApart, low: number, high: number) { node.low = low; node.name = "apart"; node.high = high; return node }
function fillTriple(node: Triple, value: number) { node.c = value; node.a = value + 1; return node }
function fillText(node: Text, text: string) { node.text = text; node.length = text.length; return node }
function fillFlagged(node: Flagged, depth: number) { node.isLast = false; node.depth = depth; return node }
function fillWide(node: Wide, value: number) { node.last = value; node.f9 = node; return node }
function sum(node: any) { let total = 0; for (const name of integerFields) total += node[name] ?? 0; return total }

let total = 0
for (let i = 0; i < 2000; i++) {
  const made: Node[] = [
    fillCount(make<Count>(Kind.Count, i), i), fillLate(make<CountLate>(Kind.CountLate, i), i * 2), fillPair(make<Pair>(Kind.Pair, i), -i, i), fillApart(make<PairApart>(Kind.PairApart, i), i, 1),
    fillTriple(make<Triple>(Kind.Triple, i), i), fillText(make<Text>(Kind.Text, i), "x".repeat(i % 5)), fillFlagged(make<Flagged>(Kind.Flagged, i), i % 7), fillWide(make<Wide>(Kind.Wide, i), 3), make<Plain>(Kind.Plain, i),
  ]
  for (const node of made) total += sum(node) + node.pos + node.end + node.id + node.flags + node.kind
}
console.log(total)

const triple = fillTriple(make<Triple>(Kind.Triple, 5), 40)
console.log(Object.keys(triple).join(), triple.a, triple.b, triple.c, "b" in triple, JSON.stringify(triple))
triple.b = 2 ** 31; triple.a = 0.5; (triple as any).c = "text"
console.log(Object.keys(triple).join(), triple.a, triple.b, triple.c)
const pair = make<Pair>(Kind.Pair, 1)
console.log(pair.low, pair.high, pair.low === undefined, Object.getOwnPropertyDescriptor(pair, "low"))
pair.low = -2147483648; pair.high = 2147483647
console.log(pair.low, pair.high, Object.keys(pair).join())
pair.low = -2147483647; console.log(pair.low, delete (pair as any).low, pair.low, "low" in pair, Object.keys(pair).join())
const flagged = make<Flagged>(Kind.Flagged, 2)
console.log(flagged.isOpen, flagged.depth, flagged.isLast, Object.keys(flagged).length)
flagged.isOpen = true; console.log(flagged.isOpen, flagged.depth, flagged.isLast, Object.keys(flagged).join())
//// kitchen-sink-function.ts
// One function allocates, upcasts, casts, forces a cast, guards, takes plain data and `any` into declared types, fills containers, stores callbacks, freezes an object and makes an array with a property. A second function does the same things again in another order, and a third one is never called. The output must match plain Bun.
interface Shape { kind: string; area(): number }
interface Named { name: string }
class Circle implements Shape { kind = "circle"; constructor(public r: number) {} area() { return 3 * this.r * this.r; } }
class Square implements Shape, Named { kind = "square"; name = "sq"; constructor(public s: number) {} area() { return this.s * this.s; } }
type Tagged = Named & { tag: number };
function isNamed(value: unknown): value is Named { return typeof value === "object" && value !== null && "name" in value; }

function everything(input: any, text: string): string[] {
  const out: string[] = [];
  const shapes: Shape[] = [new Circle(1), new Square(2)];
  for (const shape of shapes) out.push(shape.kind + shape.area());
  const named = shapes[1] as Square;
  out.push(named.name);
  const forced = { name: "forced", tag: 1 } as unknown as Tagged;
  out.push(forced.name + forced.tag);
  const parsed: Named = JSON.parse(text);
  out.push(parsed.name);
  const given: Named = input;
  out.push(given.name);
  if (isNamed(input)) out.push("guard " + input.name);
  const list: Named[] = [parsed, given, named];
  out.push(list.map(item => item.name).join());
  const table = new Map<string, Shape>([["c", shapes[0]]]);
  out.push(String(table.get("c")!.area()));
  const callbacks = { run: (shape: Shape) => shape.area() };
  out.push(String(callbacks.run(shapes[0])));
  const frozen = Object.freeze({ name: "frozen" });
  out.push(frozen.name + Object.isFrozen(frozen));
  const array: number[] & { tag?: string } = Object.assign([1, 2], { tag: "t" });
  out.push(array.length + array.tag!);
  return out;
}

function everythingAgain(text: string, input: any): string[] {
  const out: string[] = [];
  const array: number[] & { tag?: string } = Object.assign([3], { tag: "u" });
  out.push(array.length + array.tag!);
  const frozen = Object.freeze({ name: "frozen again" });
  out.push(frozen.name + Object.isFrozen(frozen));
  const callbacks = { run: (shape: Shape) => shape.kind };
  const given: Named = input;
  const parsed: Named = JSON.parse(text);
  const shapes: Shape[] = [new Square(3), new Circle(2)];
  out.push(callbacks.run(shapes[1]));
  const table = new Map<string, Shape>([["s", shapes[0]]]);
  out.push(String(table.get("s")!.area()));
  const named = shapes[0] as Square;
  const list: Named[] = [named, given, parsed];
  out.push(list.map(item => item.name).join());
  if (isNamed(parsed)) out.push("guard " + parsed.name);
  const forced = { name: "forced again", tag: 2 } as unknown as Tagged;
  out.push(forced.name + forced.tag);
  for (const shape of shapes) out.push(shape.kind + shape.area());
  return out;
}

function neverCalled(input: any): Named[] {
  const given: Named = input;
  const forced = input as unknown as Tagged;
  return [given, forced, new Square(9)];
}

console.log(everything({ name: "any", extra: 1 }, '{"name":"parsed"}').join("\n"));
console.log(everythingAgain('{"name":"parsed again"}', { name: "any again" }).join("\n"));
//// large-intersection-depth-three.ts
interface Tree<T> { value: T; children?: Tree<T>[] }
interface K0 { k0: number }
interface K1 { k1: number }
interface K2 { k2: number }
interface K3 { k3: number }
interface K4 { k4: number }
interface K5 { k5: number }
interface K6 { k6: number }
interface K7 { k7: number }
interface K8 { k8: number }
interface K9 { k9: number }
interface K10 { k10: number }
interface K11 { k11: number }
interface K12 { k12: number }
interface K13 { k13: number }
interface K14 { k14: number }
interface K15 { k15: number }
interface K16 { k16: number }
interface K17 { k17: number }
type All = { g0: Tree<K0> } & { g1: Tree<K1> } & { g2: Tree<K2> } & { g3: Tree<K3> } & { g4: Tree<K4> } & { g5: Tree<K5> } & { g6: Tree<K6> } & { g7: Tree<K7> } & { g8: Tree<K8> } & { g9: Tree<K9> } & { g10: Tree<K10> } & { g11: Tree<K11> } & { g12: Tree<K12> } & { g13: Tree<K13> } & { g14: Tree<K14> } & { g15: Tree<K15> } & { g16: Tree<K16> } & { g17: Tree<K17> };
type Same = { g17: Tree<K17> } & { g16: Tree<K16> } & { g15: Tree<K15> } & { g14: Tree<K14> } & { g13: Tree<K13> } & { g12: Tree<K12> } & { g11: Tree<K11> } & { g10: Tree<K10> } & { g9: Tree<K9> } & { g8: Tree<K8> } & { g7: Tree<K7> } & { g6: Tree<K6> } & { g5: Tree<K5> } & { g4: Tree<K4> } & { g3: Tree<K3> } & { g2: Tree<K2> } & { g1: Tree<K1> } & { g0: Tree<K0> };
type Few = { g0: Tree<K0> } & { g1: Tree<K1> };
interface Outer<T> { a: { b: { c: T; again?: Outer<T> } } }
interface Other<T> { a: { b: { c: T; again?: Other<T> } } }
function make(): All { return { g0: { value: { k0: 0 }, children: [{ value: { k0: 100 } }] }, g1: { value: { k1: 1 }, children: [{ value: { k1: 101 } }] }, g2: { value: { k2: 2 }, children: [{ value: { k2: 102 } }] }, g3: { value: { k3: 3 }, children: [{ value: { k3: 103 } }] }, g4: { value: { k4: 4 }, children: [{ value: { k4: 104 } }] }, g5: { value: { k5: 5 }, children: [{ value: { k5: 105 } }] }, g6: { value: { k6: 6 }, children: [{ value: { k6: 106 } }] }, g7: { value: { k7: 7 }, children: [{ value: { k7: 107 } }] }, g8: { value: { k8: 8 }, children: [{ value: { k8: 108 } }] }, g9: { value: { k9: 9 }, children: [{ value: { k9: 109 } }] }, g10: { value: { k10: 10 }, children: [{ value: { k10: 110 } }] }, g11: { value: { k11: 11 }, children: [{ value: { k11: 111 } }] }, g12: { value: { k12: 12 }, children: [{ value: { k12: 112 } }] }, g13: { value: { k13: 13 }, children: [{ value: { k13: 113 } }] }, g14: { value: { k14: 14 }, children: [{ value: { k14: 114 } }] }, g15: { value: { k15: 15 }, children: [{ value: { k15: 115 } }] }, g16: { value: { k16: 16 }, children: [{ value: { k16: 116 } }] }, g17: { value: { k17: 17 }, children: [{ value: { k17: 117 } }] } }; }
function pass(from: Outer<All>): Other<Same> { return from; }
function few(from: Outer<All>): Other<Few> { return from; }
const all = make();
const outer: Outer<All> = { a: { b: { c: all, again: { a: { b: { c: all } } } } } };
const other = pass(outer);
let sum = 0;
sum += other.a.b.c.g0.value.k0 + (other.a.b.again?.a.b.c.g0.children?.[0].value.k0 ?? 0);
sum += other.a.b.c.g1.value.k1 + (other.a.b.again?.a.b.c.g1.children?.[0].value.k1 ?? 0);
sum += other.a.b.c.g2.value.k2 + (other.a.b.again?.a.b.c.g2.children?.[0].value.k2 ?? 0);
sum += other.a.b.c.g3.value.k3 + (other.a.b.again?.a.b.c.g3.children?.[0].value.k3 ?? 0);
sum += other.a.b.c.g4.value.k4 + (other.a.b.again?.a.b.c.g4.children?.[0].value.k4 ?? 0);
sum += other.a.b.c.g5.value.k5 + (other.a.b.again?.a.b.c.g5.children?.[0].value.k5 ?? 0);
sum += other.a.b.c.g6.value.k6 + (other.a.b.again?.a.b.c.g6.children?.[0].value.k6 ?? 0);
sum += other.a.b.c.g7.value.k7 + (other.a.b.again?.a.b.c.g7.children?.[0].value.k7 ?? 0);
sum += other.a.b.c.g8.value.k8 + (other.a.b.again?.a.b.c.g8.children?.[0].value.k8 ?? 0);
sum += other.a.b.c.g9.value.k9 + (other.a.b.again?.a.b.c.g9.children?.[0].value.k9 ?? 0);
sum += other.a.b.c.g10.value.k10 + (other.a.b.again?.a.b.c.g10.children?.[0].value.k10 ?? 0);
