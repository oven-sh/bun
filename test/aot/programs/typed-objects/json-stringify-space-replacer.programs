  }
  function create1(a: Node | undefined, b: number, c: string): N1 {
    const node = createBaseDeclaration<N1>(SyntaxKind.K1);
    node.a1 = a;
    node.b1 = b;
    node.c1 = c;
    return node;
  }
  function create2(a: Node | undefined, b: number, c: string): N2 {
    const node = createBaseNode<N2>(SyntaxKind.K2);
