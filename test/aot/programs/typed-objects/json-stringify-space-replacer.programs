show("frozen between two stores", () => { const x = make(); return times(i => { if (i === 3) Object.freeze(x); try { return put(x, "whole", i); } catch (e) { return [(e as Error).name, x.whole]; } }); });
show("frozen, in code that is not strict", () => { const x = make(); put(x, "whole", 5); Object.freeze(x); return [sloppy(x, "whole", 6), x.whole]; });
show("made read-only between two stores: refused, and stores go on; or done, and stores are refused", () => { const x = make(); let isReadOnly = false; return times(i => { if (i === 3) { try { Object.defineProperty(hide(x), "whole", { writable: false }); isReadOnly = true; } catch {} } try { put(x, "whole", i); return !isReadOnly && x.whole === i; } catch (e) { return isReadOnly && x.whole === 2 && (e as Error).name; } }).map(v => !!v); });
show("an extra, another prototype, a null prototype, between two stores", () => { const x = make(), y = make(), z = make(); const seen: unknown[] = []; return [times(i => { if (i === 2) hide(x).extra = 1; if (i === 4) delete hide(x).extra; return [put(x, "whole", i), put(x, "extra2", i)]; }), times(i => { if (i === 3) Object.setPrototypeOf(hide(y), Object.defineProperty(plain(), "maybeNumber", { set(v) { seen.push(v); }, get() { return "inherited"; } })); return [put(y, "whole", i), put(y, "maybeNumber", i)]; }), seen, times(i => { if (i === 3) Object.setPrototypeOf(hide(z), null); return put(z, "whole", i); })]; });
show("an absent field whose name a given prototype takes for itself", () => { const x = make(), other = make(), seen: unknown[] = []; put(other, "maybeText", "known"); put(other, "maybeText", "known again"); Object.setPrototypeOf(hide(x), Object.defineProperty(plain(), "maybeText", { set(v) { seen.push(v); }, get() { return "inherited"; } })); return [times(i => put(x, "maybeText", "m" + i)), seen, Object.keys(x).includes("maybeText"), other.maybeText]; });
show("what tells the members of a union apart", () => { const list: Shape[] = [{ kind: "circle", r: 1 }, { kind: "square", side: 2 }]; return list.map(s => times(i => [put(s, "kind", s.kind), put(s, s.kind === "circle" ? "r" : "side", i), s])); });
show("values that are not of the field's type: stored, or refused and the field is as it was", () => times(i => { const x = make(); const tries: [string, unknown][] = [["whole", "text" + i], ["flag", i], ["text", i], ["inner", i & 1 ? null : 5], ["list", "no list"], ["big", i], ["sym", "s"], ["call", null], ["fraction", "f"], ["textOrNull", i]]; return tries.map(([key, value]) => { const was = hide(x)[key]; put(x, key, was); try { return put(x, key, value) === value && hide(x)[key] === value; } catch (e) { return (e as Error).name === "TypeError" && hide(x)[key] === was; } }); }));
