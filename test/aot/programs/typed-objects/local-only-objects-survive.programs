function report(label: string, narrowed: WithPath | undefined, original: Built) {
  if (narrowed === undefined) { console.log(label, "nothing"); return }
  narrowed.path += "!"
  narrowed.item.name += "?"
  console.log(label, narrowed === original, original.path, original.item?.name, narrowed.path, narrowed.item.name, made().path)
}
//// local-only-objects-survive-gc.ts
// An object that nothing but a local variable of a running function refers to stays alive through collections that run far below that function, whatever else lies on the stack: numbers, strings, large arrays, pointers into the middle of nothing.
const shell = globalThis as any;
const collect: (full: boolean) => void = shell.Bun ? (full: boolean) => shell.Bun.gc(full) : (full: boolean) => (full ? shell.fullGC() : shell.edenGC());
type Leaf = { id: number; text: string; list: number[] };
function leaf(i: number): Leaf {
  return { id: i, text: "leaf" + i, list: [i, i * 2, i * 3] };
}
function churn(n: number): number {
  let sum = 0;
  for (let i = 0; i < n; i++) sum += leaf(i).text.length;
  return sum;
}
function descend(depth: number, salt: number): number {
  const mine = leaf(depth * 1000 + salt);
  const big = new Array<number>(depth % 7 === 0 ? 40000 : 3).fill(depth);
  const text = "d" + depth + "s" + salt;
  const fraction = depth / 3 + salt;
  const large = depth * 4294967296 + salt * 16384 + 8;
  let below = 0;
  if (depth > 0) below = descend(depth - 1, salt);
  else {
    churn(3000);
    collect(false);
    churn(3000);
    collect(salt % 3 === 0);
  }
  return below + mine.id + mine.text.length + mine.list[2] + big.length + big[big.length - 1] + text.length + Math.floor(fraction) + (large % 1000);
}
for (let salt = 0; salt < 9; salt++) console.log("depth", 20 + salt * 35, descend(20 + salt * 35, salt));

function* walk(n: number): Generator<Leaf> {
  for (let i = 0; i < n; i++) {
    const held = leaf(i);
    if (i % 50 === 0) collect(false);
    yield held;
  }
}
let total = 0;
for (const item of walk(1000)) total += item.list[1] + item.text.length;
console.log("generator", total);

async function later(i: number): Promise<number> {
  const held = leaf(i);
  await null;
  if (i % 40 === 0) collect(i % 80 === 0);
  await null;
  return held.id + held.list[2];
}
const results = await Promise.all(Array.from({ length: 400 }, (_, i) => later(i)));
console.log("async", results.reduce((a, b) => a + b, 0));

function manyArguments(a: Leaf, b: Leaf, c: Leaf, d: Leaf, e: Leaf, f: Leaf, g: Leaf, h: Leaf, i: Leaf, j: Leaf): number {
  churn(2000);
  collect(false);
  return a.id + b.id + c.id + d.id + e.id + f.id + g.id + h.id + i.id + j.list[2];
}
let sum = 0;
for (let i = 0; i < 30; i++) sum += manyArguments(leaf(i), leaf(i + 1), leaf(i + 2), leaf(i + 3), leaf(i + 4), leaf(i + 5), leaf(i + 6), leaf(i + 7), leaf(i + 8), leaf(i + 9));
console.log("arguments", sum);
//// locals-outlive-collections-by-kind.ts
// A typed object keeps most references in 32 bits, and the collector's scan of the stack knows 64-bit pointers alone. Here a reference of every kind is read from a field into a local, the field is overwritten, a collection runs and the freed cells are filled anew. What the local alone holds must be as it was, whether it is then read, or stored into another object and read from there behind one more collection.
// Everything is called through a table, so that nothing is inlined and no object is dissolved. The program asks for its collections itself.
interface Leaf { n: number; m: number }
class Node { constructor(public n: number, public next: Node | null) {} }
interface Holder {
  leaf: Leaf; maybe: Leaf | null; opt?: Leaf; text: string; word: "on" | "off" | string; fn: () => number; list: number[]; leaves: Leaf[]; node: Node; table: Map<string, number>; set: Set<string>; either: Leaf | Node; date: Date; big: bigint
}
////= Wide	Wide; e7?: boolean
const junk: unknown[] = [];
function leaf(i: number): Leaf { return { n: i, m: i + 1 } }
function text(i: number): string { return "t" + i + "x" + (i * 7) }
function fn(i: number): () => number { return () => i * 3 }
function list(i: number): number[] { return [i, i + 1, i + 2] }
function leaves(i: number): Leaf[] { return [F.leaf(i), F.leaf(i + 5)] }
function node(i: number): Node { return new Node(i, null) }
function table(i: number): Map<string, number> { const t = new Map<string, number>(); t.set("k", i); return t }
function set(i: number): Set<string> { const s = new Set<string>(); s.add("s" + i); return s }
function big(i: number): bigint { return BigInt(i) * 10000000000000000000n }
function holder(i: number): Holder {
  return { leaf: leaf(i), maybe: leaf(i + 1), opt: leaf(i + 2), text: text(i), word: text(i + 1), fn: fn(i), list: list(i), leaves: leaves(i), node: node(i), table: table(i), set: set(i), either: i & 1 ? leaf(i + 3) : node(i + 3), date: new Date(i * 1000), big: big(i) };
}
function wide(i: number): Wide { const w: Wide = { id: i }; w.e5 = F.text(i); w.e6 = { id: i + 1 }; return w }
function collect(): void { const g: any = globalThis; if (g.Bun) g.Bun.gc(true); else g.gc() }
function churn(): void { junk.length = 0; for (let i = 1; i <= 200; i++) junk.push(F.holder(-i), F.wide(-i)) }
function again(): void { F.collect(); F.churn() }

function readLeaf(h: Holder, fresh: Holder): number { const kept = h.leaf; h.leaf = fresh.leaf; F.again(); return kept.n + kept.m }
function readMaybe(h: Holder): number { const kept = h.maybe; h.maybe = null; F.again(); return kept === null ? -1 : kept.n + kept.m }
function readOpt(h: Holder): number { const kept = h.opt; h.opt = undefined; F.again(); return kept === undefined ? -1 : kept.n + kept.m }
function readText(h: Holder, fresh: Holder): string { const kept = h.text; h.text = fresh.text; F.again(); return kept }
function readWord(h: Holder): string { const kept = h.word; h.word = "on"; F.again(); return kept }
function readFn(h: Holder, fresh: Holder): number { const kept = h.fn; h.fn = fresh.fn; F.again(); return kept() }
function readList(h: Holder, fresh: Holder): number { const kept = h.list; h.list = fresh.list; F.again(); return kept[0] + kept[2] + kept.length }
function readLeaves(h: Holder, fresh: Holder): number { const kept = h.leaves; h.leaves = fresh.leaves; F.again(); return kept[0].n + kept[1].m }
function readNode(h: Holder, fresh: Holder): number { const kept = h.node; h.node = fresh.node; F.again(); return kept.n }
function readTable(h: Holder, fresh: Holder): number { const kept = h.table; h.table = fresh.table; F.again(); return kept.get("k")! + kept.size }
function readSet(h: Holder, fresh: Holder): string { const kept = h.set; h.set = fresh.set; F.again(); return [...kept].join() }
function readEither(h: Holder, fresh: Holder): number { const kept = h.either; h.either = fresh.either; F.again(); return kept.n }
function readDate(h: Holder, fresh: Holder): number { const kept = h.date; h.date = fresh.date; F.again(); return kept.getTime() }
function readBig(h: Holder, fresh: Holder): string { const kept = h.big; h.big = fresh.big; F.again(); return String(kept) }
function readFar(w: Wide): number { const kept = w.e6; w.e6 = undefined; F.again(); return kept === undefined ? -1 : kept.id }
function readFarText(w: Wide): string { const kept = w.e5; w.e5 = undefined; F.again(); return kept === undefined ? "none" : kept }
function readOfDropped(i: number): number { const kept = F.holder(i).leaf; F.again(); return kept.n + kept.m }
function readFarOfDropped(i: number): number { const kept = F.wide(i).e6; F.again(); return kept === undefined ? -1 : kept.id }

function copy(h: Holder, to: Holder, fresh: Holder): void {
  const a = h.leaf, b = h.maybe, c = h.opt, d = h.text, e = h.word, f = h.fn, g = h.list, i = h.leaves, j = h.node, k = h.table, l = h.set, m = h.either, n = h.date, o = h.big;
  h.leaf = fresh.leaf; h.maybe = null; h.opt = undefined; h.text = fresh.text; h.word = "off"; h.fn = fresh.fn; h.list = fresh.list; h.leaves = fresh.leaves; h.node = fresh.node; h.table = fresh.table; h.set = fresh.set; h.either = fresh.either; h.date = fresh.date; h.big = fresh.big;
  F.again();
  to.leaf = a; to.maybe = b; to.opt = c; to.text = d; to.word = e; to.fn = f; to.list = g; to.leaves = i; to.node = j; to.table = k; to.set = l; to.either = m; to.date = n; to.big = o;
}
function copyFar(w: Wide, to: Wide): void { const a = w.e5, b = w.e6; w.e5 = undefined; w.e6 = undefined; F.again(); to.e5 = a; to.e6 = b }
function show(h: Holder): string {
  return [h.leaf.n, h.maybe === null ? "null" : h.maybe.m, h.opt === undefined ? "none" : h.opt.n, h.text, h.word, h.fn(), h.list.join("/"), h.leaves[1].n, h.node.n, h.table.get("k"), [...h.set].join(), h.either.n, h.date.getTime(), h.big].join(",");
}
const F = { leaf, text, fn, list, leaves, node, table, set, big, holder, wide, collect, churn, again, readLeaf, readMaybe, readOpt, readText, readWord, readFn, readList, readLeaves, readNode, readTable, readSet, readEither, readDate, readBig, readFar, readFarText, readOfDropped, readFarOfDropped, copy, copyFar };
function row(name: string, f: (i: number) => unknown): void { const seen: string[] = []; for (let i = 1; i <= 6; i++) seen.push(String(f(i * 1000 + i))); console.log(name + ": " + seen.join(" ")) }
row("a record", i => F.readLeaf(F.holder(i), F.holder(1)));
row("a record or null", i => F.readMaybe(F.holder(i)));
row("an optional record", i => F.readOpt(F.holder(i)));
row("a string", i => F.readText(F.holder(i), F.holder(1)));
row("a string where literals are expected", i => F.readWord(F.holder(i)));
row("a function", i => F.readFn(F.holder(i), F.holder(1)));
row("an array of numbers", i => F.readList(F.holder(i), F.holder(1)));
row("an array of records", i => F.readLeaves(F.holder(i), F.holder(1)));
row("an instance", i => F.readNode(F.holder(i), F.holder(1)));
row("a map", i => F.readTable(F.holder(i), F.holder(1)));
row("a set", i => F.readSet(F.holder(i), F.holder(1)));
row("one of two", i => F.readEither(F.holder(i), F.holder(1)));
row("a date", i => F.readDate(F.holder(i), F.holder(1)));
row("a bigint", i => F.readBig(F.holder(i), F.holder(1)));
row("a record out of line", i => F.readFar(F.wide(i)));
row("a string out of line", i => F.readFarText(F.wide(i)));
row("a record whose holder is dropped", i => F.readOfDropped(i));
row("a record out of line whose holder is dropped", i => F.readFarOfDropped(i));
row("all of them stored into another object", i => { const to = F.holder(5); F.copy(F.holder(i), to, F.holder(1)); F.again(); return show(to) });
row("those out of line stored into another object", i => { const to = F.wide(5); F.copyFar(F.wide(i), to); F.again(); return to.e5 + "," + (to.e6 === undefined ? "none" : to.e6.id) });
//// locals-outlive-collections-by-place.ts
// A typed object keeps most references in 32 bits, and the collector's scan of the stack knows 64-bit pointers alone. What a local alone holds, read from a field that is then overwritten, must outlive collections in every place where a local can wait: a loop, an await, a generator, a closure, a handler, an inlined callee, a store that a loop repeats, a comparison.
// Everything but the two functions that are meant to be inlined is called through a table. The program asks for its collections itself and fills the freed cells anew.
interface Leaf { n: number; m: number }
class Node { constructor(public n: number, public next: Node | null) {} }
interface Holder { leaf: Leaf; maybe: Leaf | null; text: string; node: Node | null }
interface Callers { call: () => number }
function known(): number { return 1 }
function callers(i: number): Callers { return { call: () => i } }
const junk: unknown[] = [];
function leaf(i: number): Leaf { return { n: i, m: i + 1 } }
function text(i: number): string { return "t" + i + "x" + (i * 7) }
function chain(i: number, length: number): Node | null { let head: Node | null = null; for (let k = length; k > 0; k--) head = new Node(i + k, head); return head }
function holder(i: number): Holder { return { leaf: leaf(i), maybe: leaf(i + 1), text: text(i), node: chain(i, 5) } }
function collect(): void { const g: any = globalThis; if (g.Bun) g.Bun.gc(true); else g.gc() }
function churn(): void { junk.length = 0; for (let i = 0; i < 300; i++) junk.push(F.leaf(-i), F.text(-i), F.chain(-i, 1)) }
function again(): void { F.collect(); F.churn() }
function fail(): void { F.again(); throw new Error("thrown") }
function tick(): Promise<number> { return Promise.resolve(1) }
async function slow(): Promise<number> { await F.tick(); F.again(); return 1 }

function copy(h: Holder, to: Holder, fresh: Holder): void { const a = h.leaf, b = h.maybe, c = h.text; h.leaf = fresh.leaf; h.maybe = null; h.text = fresh.text; F.again(); to.leaf = a; to.maybe = b; to.text = c }
function inLoop(h: Holder, fresh: Holder): number { const a = h.leaf; h.leaf = fresh.leaf; let sum = 0; for (let i = 0; i < 3; i++) { F.again(); sum += a.n } return sum }
function walk(h: Holder): number { let sum = 0; let at = h.node; h.node = null; while (at !== null) { const next = at.next; at.next = null; sum += at.n; at = next; F.again() } return sum }
function walkThenRead(h: Holder): number { let sum = 0; let at = h.node; h.node = null; while (at !== null) { const next = at.next; at.next = null; F.again(); sum += at.n; at = next } return sum }
function caught(h: Holder, fresh: Holder): number { const a = h.leaf, b = h.maybe; h.leaf = fresh.leaf; h.maybe = null; try { F.fail(); return 0 } catch { return a.n + (b === null ? -1 : b.m) } }
function atLast(h: Holder, to: Holder, fresh: Holder): number { const a = h.leaf; h.leaf = fresh.leaf; try { F.again(); return 1 } finally { to.leaf = a } }
function take(h: Holder, fresh: Holder): Leaf { const a = h.leaf; h.leaf = fresh.leaf; return a }
function takeMaybe(h: Holder): Leaf | null { const a = h.maybe; h.maybe = null; return a }
function inlined(h: Holder, fresh: Holder): number { const a = take(h, fresh), b = takeMaybe(h); F.again(); return a.n + (b === null ? -1 : b.m) }
function later(h: Holder, fresh: Holder): () => number { const a = h.leaf, c = h.text; h.leaf = fresh.leaf; h.text = fresh.text; return () => a.n + c.length }
function callAfter(f: () => number): number { F.again(); return f() }
function passed(h: Holder, fresh: Holder): number { const a = h.leaf, c = h.text; h.leaf = fresh.leaf; h.text = fresh.text; return F.callAfter(() => a.n + c.length) }
function storeInLoop(all: Holder[], a: Leaf, c: string): void { for (let i = 0; i < all.length; i++) { F.again(); all[i].leaf = a; all[i].maybe = a; all[i].text = c } }
function storeReadInLoop(all: Holder[], h: Holder, fresh: Holder): void { const a = h.leaf, b = h.maybe, c = h.text; h.leaf = fresh.leaf; h.maybe = null; h.text = fresh.text; for (let i = 0; i < all.length; i++) { F.again(); all[i].leaf = a; all[i].maybe = b; all[i].text = c } }
function sameFunction(h: Callers, fresh: Callers): string { const a = h.call; h.call = fresh.call; F.again(); return (a === known) + "," + (a === h.call) + "," + (a === fresh.call) }
function rarely(h: Holder, fresh: Holder, i: number): number { const a = h.leaf, b = h.maybe; h.leaf = fresh.leaf; h.maybe = null; F.again(); if (i % 3000 === 0) return a.n + (b === null ? -1 : b.m); return i }
function twoWays(h: Holder, other: Holder, fresh: Holder, i: number): number { let a: Leaf, b: Leaf | null; if (i & 1024) { a = h.leaf; b = h.maybe; h.leaf = fresh.leaf; h.maybe = null } else { a = other.leaf; b = other.maybe; other.leaf = fresh.leaf; other.maybe = null } F.again(); fresh.maybe = b; return a.n + (b === null ? -1 : b.m) }
function* steps(h: Holder, fresh: Holder): Generator<number> { const a = h.leaf, b = h.maybe; h.leaf = fresh.leaf; h.maybe = null; yield 1; F.again(); yield a.n; F.again(); yield b === null ? -1 : b.m }
async function awaited(h: Holder, to: Holder, fresh: Holder): Promise<number> { const a = h.leaf, b = h.maybe, c = h.text; h.leaf = fresh.leaf; h.maybe = null; h.text = fresh.text; await F.tick(); F.again(); to.maybe = b; return a.n + c.length }
async function awaitedCall(h: Holder, to: Holder, fresh: Holder): Promise<number> { const a = h.leaf, b = h.maybe; h.leaf = fresh.leaf; h.maybe = null; const one = await slow(); to.leaf = a; to.maybe = b; return a.n + one }
async function awaitedInLoop(h: Holder): Promise<number> { let sum = 0; let at = h.node; h.node = null; while (at !== null) { const next = at.next; at.next = null; await F.slow(); sum += at.n; at = next } return sum }
const F = { leaf, text, chain, holder, collect, churn, again, fail, tick, slow, copy, inLoop, walk, walkThenRead, caught, atLast, inlined, later, callAfter, passed, storeInLoop, storeReadInLoop, sameFunction, callers, rarely, twoWays, steps, awaited, awaitedCall, awaitedInLoop };
function show(h: Holder): string { return h.leaf.n + "," + (h.maybe === null ? "null" : String(h.maybe.m)) + "," + h.text }
function row(name: string, f: (i: number) => unknown): void { const seen: string[] = []; for (let i = 1; i <= 8; i++) seen.push(String(f(i * 1000))); console.log(name + ": " + seen.join(" ")) }
async function rowLater(name: string, f: (i: number) => Promise<unknown>): Promise<void> { const seen: string[] = []; for (let i = 1; i <= 8; i++) seen.push(String(await f(i * 1000))); console.log(name + ": " + seen.join(" ")) }
row("copied into another object", i => { const to = F.holder(5); F.copy(F.holder(i), to, F.holder(1)); F.again(); return show(to) });
row("read in a loop", i => F.inLoop(F.holder(i), F.holder(1)));
row("a list taken apart", i => F.walk(F.holder(i)));
row("a list taken apart, read behind the collection", i => F.walkThenRead(F.holder(i)));
row("read in a handler", i => F.caught(F.holder(i), F.holder(1)));
row("stored in a finally block", i => { const to = F.holder(5); F.atLast(F.holder(i), to, F.holder(1)); F.again(); return show(to) });
row("read by an inlined function", i => F.inlined(F.holder(i), F.holder(1)));
row("captured", i => { const f = F.later(F.holder(i), F.holder(1)); F.again(); return f() });
row("captured by a function that is only passed down", i => F.passed(F.holder(i), F.holder(1)));
row("an argument stored by every turn of a loop", i => { const all = [F.holder(5), F.holder(6)]; F.storeInLoop(all, F.leaf(i), F.text(i)); F.again(); return all.map(show).join(";") });
row("what was read stored by every turn of a loop", i => { const all = [F.holder(5), F.holder(6)]; F.storeReadInLoop(all, F.holder(i), F.holder(1)); F.again(); return all.map(show).join(";") });
row("a function compared", i => F.sameFunction(F.callers(i), F.callers(1)));
row("read on a rare path", i => F.rarely(F.holder(i), F.holder(1), i));
row("read on one of two paths", i => F.twoWays(F.holder(i), F.holder(i + 1), F.holder(1), i));
row("across yields", i => [...F.steps(F.holder(i), F.holder(1))].join("+"));
await rowLater("across an await", async i => { const to = F.holder(5); const n = await F.awaited(F.holder(i), to, F.holder(1)); F.again(); return n + ":" + show(to) });
await rowLater("across the await of a call", async i => { const to = F.holder(5); const n = await F.awaitedCall(F.holder(i), to, F.holder(1)); F.again(); return n + ":" + show(to) });
await rowLater("a list taken apart across awaits", i => F.awaitedInLoop(F.holder(i)));
//// lookalike-nested-in-lookalike.ts
// A record type that `any` is held to also admits objects that were not created as that type: a record of another type that was given the properties later, a Proxy, an object that inherits
// them. Such an object is read by name, and what the read yields is held to the type of the property. That may again be such an object, of any of these kinds.
interface Item { id: number; weight: number; label: string; next: Item | null }
interface Crate { id: number; depth: number }
function hide(value: unknown): any { return value }
function make(i: number, next: Item | null = null): Item { return { id: i + 0.5, weight: i + 1.5, label: "item" + i, next } }
function makeCrate(i: number): Crate { return { id: i + 0.25, depth: i + 2.25 } }
function depthOf(crate: Crate): number { return crate.id + crate.depth }
// What the text does not show to be a Proxy or an heir leaves the type as it is.
const HiddenProxy: any = hide(Proxy), hiddenObject: any = hide(Object);
function grown(i: number, next: Item | null = null): Item {
  const crate = makeCrate(i);
  depthOf(crate);
  const open = hide(crate);
  open.weight = i + 3.25; open.label = "crate" + i; open.next = null;
  const item: Item = open;
  item.next = next;
  return item;
}
function proxied(i: number, next: Item | null = null): Item { return new HiddenProxy(make(i, next), {}) }
function heir(i: number, next: Item | null = null): Item { return hiddenObject.create(make(i, next)) }
function labelOfNext(item: Item): string { const next = item.next; return next === null ? "end" : next.label + " " + next.id }
function labelAt(items: Item[], index: number): string { const item = items[index]; return item.label + " " + item.weight }
function isNext(item: Item, next: Item): boolean { return item.next === next }
const kept = { labelOfNext, labelAt, isNext };
(globalThis as { kept?: unknown }).kept = kept;
const makers = [make, grown, proxied, heir];
const lines: string[] = [];
function say(what: string, run: () => unknown): void {
  let said: string;
  try { said = String(run()) } catch (error) { said = "throws " + (error as Error).name }
  lines.push(what + ": " + said);
}
for (let turn = 0; turn < 3; turn++) {
  for (const outer of makers) {
    for (const inner of makers) {
      if (outer === grown && inner === proxied)
        continue;
      say(turn + " " + outer.name + " holds " + inner.name, () => labelOfNext(outer(turn, inner(turn + 1))));
      say(turn + " " + outer.name + " holds the very " + inner.name, () => { const next = inner(turn + 1); return isNext(outer(turn, next), next) });
    }
    say(turn + " an array from elsewhere holds " + outer.name, () => labelAt(hide([outer(turn)]), 0));
    say(turn + " an array holds " + outer.name, () => labelAt([outer(turn)], 0));
  }
}
console.log(lines.join("\n"));
//// lookalike-result-stays-one-object.ts
// An object that was not created as the record type it is used as is read by name, and what the read yields is held to the type of the property. Whatever that is, a record, nothing, a plain
// object from elsewhere, a frozen one, one with accessors, another such object, two reads yield one and the same object, and a store through it is seen by whoever else holds it.
interface Item { id: number; weight: number; label: string; next: Item | null }
interface Crate { id: number; depth: number }
function hide(value: unknown): any { return value }
function make(i: number, next: Item | null = null): Item { return { id: i + 0.5, weight: i + 1.5, label: "item" + i, next } }
function makeCrate(i: number): Crate { return { id: i + 0.25, depth: i + 2.25 } }
function depthOf(crate: Crate): number { return crate.id + crate.depth }
const HiddenProxy: any = hide(Proxy), hiddenObject: any = hide(Object), hiddenJSON: any = hide(JSON);

const holders: { [name: string]: (next: any) => any } = {
  grown(next) { const crate = makeCrate(1); depthOf(crate); const open = hide(crate); open.weight = 3.25; open.label = "crate"; open.next = next; return open },
  proxied(next) { const target = hide(make(2)); target.next = next; return new HiddenProxy(target, {}) },
  heir(next) { const parent = hide(make(3)); parent.next = next; return hiddenObject.create(parent) },
  withAccessor(next) { return hiddenObject.defineProperty(hiddenJSON.parse('{"id":4.5,"weight":5.5,"label":"accessor"}'), "next", { get() { return next }, enumerable: true, configurable: true }) },
};
const yields: { [name: string]: () => any } = {
  nothing: () => null,
  record: () => make(10),
  parsed: () => hiddenJSON.parse('{"id":11.5,"weight":12.5,"label":"parsed","next":null}'),
  parsedInAnotherOrder: () => hiddenJSON.parse('{"next":null,"label":"other order","extra":true,"weight":13.5,"id":14.5}'),
  frozen: () => hiddenObject.freeze(hiddenJSON.parse('{"id":15.5,"weight":16.5,"label":"frozen","next":null}')),
  heirOfRecord: () => hiddenObject.create(make(17)),
  crate: () => { const crate = makeCrate(18); depthOf(crate); const open = hide(crate); open.weight = 19.25; open.label = "inner crate"; open.next = null; return open },
};

function describe(item: Item): string {
  const first = item.next, second = item.next;
  if (first === null || second === null)
    return "nothing " + (first === second);
  let stored: string;
  try { first.weight = 99.5; stored = "stored" } catch (error) { stored = (error as Error).name }
  return (first === second) + " " + stored + " " + second.weight + " " + second.label + " " + second.id;
}
function labels(item: Item): string { let text = ""; for (let at: Item | null = item; at !== null; at = at.next) text += at.label + ";"; return text }
const kept = { describe, labels };
(globalThis as { kept?: unknown }).kept = kept;

const lines: string[] = [];
for (let turn = 0; turn < 3; turn++) {
  for (const holderName in holders) {
    for (const yieldName in yields) {
      const yielded = yields[yieldName](), holder = holders[holderName](yielded);
      let said: string;
      try { said = describe(holder) + " | " + labels(holder) + " | " + (holder.next === yielded) + " " + (yielded === null ? "-" : yielded.weight) } catch (error) { said = "throws " + (error as Error).name }
      lines.push(turn + " " + holderName + " yields " + yieldName + ": " + said);
    }
  }
}
console.log(lines.join("\n"));
//// made-by-a-function-with-an-assigned-prototype.ts
const log: string[] = []
const show = (label: string, value: unknown) => log.push(label + ": " + String(value))
const args = "~made/args"
interface Primitive {
  readonly _tag: string
  readonly value: unknown
  describe(): string
}
type PrimitiveClass = new (value: unknown) => Primitive
function makeExit(tag: string) {
  const Proto = {
    _tag: tag,
    get value(): unknown {
      return (this as any)[args]
    },
    describe(this: Primitive) {
      return this._tag + "(" + String(this.value) + ")"
    },
  }
  const ExitPrimitive = function (this: any, value: unknown) {
    this[args] = value
  } as unknown as PrimitiveClass
  ExitPrimitive.prototype = Proto
  return { Proto: Proto as any, make: (value: unknown): Primitive => new ExitPrimitive(value) }
}
const success = makeExit("Success")
const failure = makeExit("Failure")
const tell = (made: Primitive) => [made._tag, made.value, made.describe(), "_tag" in made, Object.keys(made).join()].join(" ")
let length = 0
for (let i = 0; i < 400; i++) length += tell((i & 1 ? success : failure).make(i)).length
show("warm", length + " " + tell(success.make(1)) + " / " + tell(failure.make("x")))
success.Proto._tag = "Done"
show("the prototype's value is another string", tell(success.make(2)) + " / " + tell(failure.make(2)))
success.Proto.extra = 1
show("the prototype gets one more property", tell(success.make(3)))
Object.defineProperty(success.Proto, "_tag", { get() { return "Got" }, configurable: true, enumerable: true })
show("a value becomes a getter", tell(success.make(4)))
delete success.Proto._tag
Object.setPrototypeOf(success.Proto, { _tag: "Above" })
show("the name moves one prototype up", tell(success.make(5)))
const shadowed = success.make(6)
;(shadowed as any)._tag = "Own"
show("an own property shadows it", tell(shadowed) + " / " + tell(success.make(6)))
success.Proto.describe = function (this: Primitive) { return "<" + this._tag + ">" }
show("the method is replaced", tell(success.make(7)))
for (let i = 0; i < 400; i++) length += tell((i & 1 ? success : failure).make(i)).length
show("warm again", length)
console.log(log.join("\n"))
//// many-empty-maps.ts
// `new Map()` many times over: each is a Map of its own, empty, ordinary in every way, and survives collections.
const host = globalThis as any
const collect: () => void = host.Bun ? () => host.Bun.gc(true) : host.gc
function table(): Map<string, number> { return new Map() }
function tableOfObjects(): Map<object, string> { return new Map<object, string>() }
const kept: Map<string, number>[] = []
let sizes = 0
for (let i = 0; i < 60000; i++) {
  const made = table()
  sizes += made.size
  if (i % 3 === 0) made.set("k" + (i % 7), i)
  if (i % 1000 === 0) kept.push(made)
  if (i % 20000 === 19999) collect()
}
console.log(sizes, kept.length, kept.map(map => [...map].join()).join(";"))
const one = table(), other = table()
console.log(one === other, one.size, one.get("a"), one.has("a"), one.delete("a"), [...one.keys()].length, one instanceof Map, Object.getPrototypeOf(one) === Map.prototype, Object.prototype.toString.call(one), Object.keys(one).length)
one.set("a", 1).set("b", 2)
console.log(other.size, one.size, JSON.stringify([...one]))
;(one as any).extra = "property"
console.log(Object.keys(one).join(), (other as any).extra, Object.isExtensible(other), Object.isFrozen(Object.freeze(other)))
const key = {}
const byObject = tableOfObjects().set(key, "found").set(one, "a map")
console.log(byObject.get(key), byObject.get(one), byObject.get({}), byObject.size)
class Registry { readonly entries = new Map<string, Registry>(); readonly names = new Map<number, string>() }
const registries: Registry[] = []
for (let i = 0; i < 5000; i++) { const registry = new Registry(); if (i) registry.entries.set("previous", registries[i - 1]); registry.names.set(i, "r" + i); registries.push(registry) }
collect()
let depth = 0
for (let at: Registry | undefined = registries[4999]; at; at = at.entries.get("previous")) depth += at.names.size
console.log(depth, registries[17].names.get(17))
//// many-extra-properties.ts
// Objects of declared types get more properties beyond their types than lie in line in what holds them: the seventh and later ones are stored, read, replaced and deleted like the first six.
const show = (label: string, value: unknown) => console.log(label + ": " + JSON.stringify(value));

////= Request
////= lines-26	Full	first	unknown	second	unknown	2
////= Point
const makers: [string, () => any][] = [
  ["Request", () => new Request()],
  ["Full", () => new Full()],
  ["Point", (): Point => ({ x: 1, y: 2 })],
  ["plain", () => ({ plain: true })],
];
function addAll(o: any, v: number) {
  o.a = v; o.b = v + 1; o.c = v + 2; o.d = v + 3; o.e = v + 4; o.f = v + 5; o.g = v + 6;
  o.h = { held: v }; o.i = "i" + v; o.j = [v]; o.k = v + 10; o.l = null; o.m = undefined; o.n = v + 13;
}
function addOne(o: any, name: number, v: unknown) {
  switch (name) {
    case 0: o.p0 = v; break;
    case 1: o.p1 = v; break;
    case 2: o.p2 = v; break;
    case 3: o.p3 = v; break;
    case 4: o.p4 = v; break;
    case 5: o.p5 = v; break;
    case 6: o.p6 = v; break;
    case 7: o.p7 = v; break;
    case 8: o.p8 = v; break;
    default: o.p9 = v;
  }
}
function readAll(o: any): unknown[] {
  return [o.a, o.b, o.c, o.d, o.e, o.f, o.g, o.h, o.i, o.j, o.k, o.l, String(o.m), o.n, String(o.missing)];
}
function readSome(o: any): unknown[] {
  return [o.p0, o.p5, o.p6, o.p7, o.p8, o.p9].map(String);
}
for (const [label, make] of makers) {
  console.log("== " + label);
  const kept: any[] = [];
  for (let round = 0; round < 5; round++) {
    const o = make();
    addAll(o, round);
    kept.push(o);
    show("added " + round, [readAll(o), Object.keys(o).join()]);
    addAll(o, round + 100);
    show("replaced " + round, readAll(o));
  }
  for (let round = 0; round < 4; round++) {
    const o = make();
    for (let name = 0; name < 10; name++) {
      addOne(o, (name + round * 3) % 10, name);
      if (name === 6 + (round % 2)) show("partly " + round, [readSome(o), Object.keys(o).join()]);
    }
    delete o.p6;
    delete o.p0;
    show("deleted " + round, [readSome(o), Object.keys(o).join()]);
    addOne(o, 6, "again");
    addOne(o, 0, "again");
    show("added again " + round, [readSome(o), Object.keys(o).join(), JSON.stringify(o).length]);
    kept.push(o);
  }
  const many: any[] = [];
  for (let i = 0; i < 3000; i++) {
    const o = make();
    addAll(o, i);
    if (i % 3 === 0) for (let name = 0; name < 10; name++) addOne(o, name, { of: i });
    if (i % 100 === 7) many.push(o);
  }
  let sum = 0;
  for (const o of many) sum += o.a + o.g + o.h.held + o.n + Object.keys(o).length + (o.p9 ? o.p9.of : 0);
  show("many", sum);
  show("kept", kept.map(o => Object.keys(o).length));
  const frozen = make();
  addAll(frozen, 1);
  Object.freeze(frozen);
  let threw = 0;
  for (let i = 0; i < 3; i++) {
    try {
      addAll(frozen, 2);
    } catch {
      threw++;
    }
  }
  show("frozen", [threw, readAll(frozen)]);
}
//// map-tables-leave-the-image-and-grow-old.ts
// A Map or Set made from a literal of constants lies in the read-only image until the first write moves its table to the heap; a table that has grown old is given young keys and values, is replaced by a young, larger one, and is still walked by an old iterator. What such a table alone holds must outlive full and young collections: across the move, also under a loop that began on the table in the image; in old entries; in new entries; behind the iterator.
// The functions are called through a table, so that nothing is inlined and no object is dissolved. The program asks for its collections itself and fills the freed cells anew.
interface Inner { n: number; label: string }
const TEXTS = new Map<string, string>([["one", "uno"], ["two", "dos"], ["three", "tres"], ["four", "cuatro"], ["five", "cinco"]]);
const MIXED = new Map<string, unknown>([["a", 1], ["b", "two"], ["c", true], ["d", null]]);
const NAMES = new Set<string>(["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota"]);
const shell: any = globalThis;
const collect: (full: boolean) => void = shell.Bun ? (full: boolean) => shell.Bun.gc(full) : (full: boolean) => (full ? shell.fullGC() : shell.edenGC());
const junk: unknown[] = [];
function inner(i: number): Inner { return { n: i, label: "l" + i } }
function key(i: number): string { return "key" + i }
function text(i: number): string { return ["t", i].join("") }
function churn(): void { junk.length = 0; for (let i = 1; i <= 5; i++) junk.push(F.inner(-i), F.key(-i), F.text(-i)) }
function again(): void { collect(true); F.churn() }
function young(): void { collect(false); F.churn() }
function list(m: Map<string, unknown>): string { let out = ""; for (const [k, v] of m) out += k + "=" + (typeof v === "object" && v !== null ? (v as Inner).n + (v as Inner).label : String(v)) + " "; return out }
function firstWrite(m: Map<string, string>): string { m.set(F.key(1), F.text(1)); F.again(); m.set("two", F.text(2)); F.again(); m.delete("one"); F.again(); return F.list(m) }
function walkedAcrossTheMove(m: Map<string, unknown>): string { let out = "", turn = 0; for (const [k, v] of m) { if (turn++ === 1) { m.set(F.key(9), F.inner(9)); m.set(F.key(10), F.text(10)) } F.again(); out += k + ":" + typeof v + " " } return out + F.list(m) }
function namesAcrossTheMove(s: Set<string>): string { let out = "", turn = 0; for (const k of s) { if (turn < 6) s.add(F.key(turn)); if (turn === 2) s.delete("beta"); turn++; F.again(); out += k + " " } return out + s.size }
function made(): Map<string, unknown> { return new Map<string, unknown>([["x", 1], ["y", "why"], ["z", false]]) }
function eachItsOwn(count: number): string { const all: Map<string, unknown>[] = []; for (let i = 0; i < count; i++) { const m = F.made(); if (i & 1) m.set(F.key(i), F.inner(i)); all.push(m); F.again() } return all.map(m => F.list(m)).join("| ") }
function grownOld(count: number): Map<string, Inner> { const m = new Map<string, Inner>(); for (let i = 0; i < count; i++) m.set(F.key(i), F.inner(i)); collect(true); collect(true); return m }
function sum(m: Map<string, Inner>): string { let s = 0, k = 0; for (const [name, v] of m) { s += v.n + v.label.length; k += name.length } return m.size + ":" + s + ":" + k }
function youngValuesInOldEntries(m: Map<string, Inner>, count: number): string { for (let i = 0; i < count; i += 2) m.set(F.key(i), F.inner(1000 + i)); F.young(); F.young(); return F.sum(m) }
function youngEntriesInAnOldTable(m: Map<string, Inner>, from: number, to: number): string { for (let i = from; i < to; i++) { m.set(F.key(i), F.inner(i)); F.young() } return F.sum(m) }
function oldWalkerOfAReplacedTable(m: Map<string, Inner>, more: number): string { const walker = m.entries(); walker.next(); collect(true); collect(true); for (let i = 0; i < more; i++) m.set(F.key(5000 + i), F.inner(i)); F.young(); F.young(); let s = 0, seen = 0; for (const [, v] of walker) { s += v.n; seen++ } return seen + ":" + s }
const F = { inner, key, text, churn, again, young, list, firstWrite, walkedAcrossTheMove, namesAcrossTheMove, made, eachItsOwn, grownOld, sum, youngValuesInOldEntries, youngEntriesInAnOldTable, oldWalkerOfAReplacedTable };
console.log("the first write:", F.firstWrite(TEXTS));
console.log("walked across the move:", F.walkedAcrossTheMove(MIXED));
console.log("a set across the move:", F.namesAcrossTheMove(NAMES));
console.log("each its own:", F.eachItsOwn(6));
for (const count of [3, 8, 20, 70]) {
  const m = F.grownOld(count);
  console.log(count, "young values in old entries:", F.youngValuesInOldEntries(m, count), "| young entries, the table grows:", F.youngEntriesInAnOldTable(m, count, count * 2 + 3), "| an old walker:", F.oldWalkerOfAReplacedTable(m, count + 5));
}
//// maps-alone-hold-their-keys-and-values.ts
// A Map or Set with string keys keeps keys and values as 32-bit references in a table of its own. Here the Map alone holds what is in it: typed objects, strings, arrays and functions that nothing else refers to. It is filled through every step of its growth, read, emptied in part, filled again, iterated while it grows and shrinks, cleared and copied, with a collection and new cells in the freed places between the steps. A key that is an object sends the Map to the engine's ordinary table: the same is asked of that. Every value says who it is.
// The functions are called through a table, so that nothing is inlined and no object is dissolved. The program asks for its collections itself.
interface Inner { n: number; label: string }
interface Outer { id: number; b: Inner }
const junk: unknown[] = [];
function inner(i: number): Inner { return { n: i, label: "l" + i } }
function outer(i: number): Outer { return { id: i, b: F.inner(i * 2) } }
function key(i: number): string { return "key" + i }
function collect(): void { const g: any = globalThis; if (g.Bun) g.Bun.gc(true); else g.gc() }
function churn(): void { junk.length = 0; for (let i = 1; i <= 5; i++) junk.push(F.outer(-i), F.key(-i), [F.inner(-i)], () => -i) }
function again(): void { F.collect(); F.churn() }

function fill(m: Map<string, Inner>, from: number, to: number, every: number): void { for (let i = from; i < to; i++) { m.set(F.key(i), F.outer(i).b); if (i % every === 0) F.again() } }
function sum(m: Map<string, Inner>, from: number, to: number): number { let s = 0; for (let i = from; i < to; i++) { const v = m.get(F.key(i)); if (v !== undefined) s += v.n + v.label.length } return s }
function walk(m: Map<string, Inner>): string { let s = 0, k = 0; for (const [name, v] of m) { s += v.n; k += name.length; if ((s & 127) === 0) F.again() } return s + "/" + k }
function drop(m: Map<string, Inner>, from: number, to: number, step: number): number { let n = 0; for (let i = from; i < to; i += step) if (m.delete(F.key(i))) n++; F.again(); return n }
function growWhileWalking(m: Map<string, Inner>, limit: number): string { let s = 0, seen = 0; for (const [name, v] of m) { seen++; s += v.n; if (m.size < limit) { m.set(name + "+", F.inner(v.n + 1)); if ((seen & 3) === 0) F.again() } } return seen + ":" + s }
function shrinkWhileWalking(m: Map<string, Inner>): string { let s = 0, seen = 0; for (const [name, v] of m) { seen++; s += v.n; m.delete(name); if ((seen & 3) === 0) F.again() } return seen + ":" + s + ":" + m.size }
function clearWhileWalking(m: Map<string, Inner>): string { let seen = 0; for (const [, v] of m) { seen += v.n; m.clear(); F.again(); m.set("after", F.inner(5)) ; if (seen > 100000) break } return seen + ":" + m.size }
function takeOut(m: Map<string, Inner>, i: number): number { const v = m.get(F.key(i)); m.delete(F.key(i)); F.again(); return v === undefined ? -1 : v.n + v.label.length }
function replace(m: Map<string, Inner>, i: number): number { const v = m.get(F.key(i)); m.set(F.key(i), F.inner(-7)); F.again(); return v === undefined ? -1 : v.n + v.label.length }
function keysOnly(s: Set<string>, from: number, to: number): void { for (let i = from; i < to; i++) { s.add(F.key(i)); if (i % 11 === 0) F.again() } }
function lengths(s: Set<string>): number { let n = 0; for (const k of s) { n += k.length; if ((n & 63) === 0) F.again() } return n }
function mixed(m: Map<string, unknown>, k: number): string { for (let i = 0; i < k; i++) { m.set(F.key(i), i % 4 === 0 ? F.inner(i) : i % 4 === 1 ? F.key(i * 3) : i % 4 === 2 ? [F.inner(i)] : i + 0.5); if (i % 6 === 0) F.again() } let out = ""; for (const [, v] of m) out += typeof v === "object" ? (Array.isArray(v) ? "a" + (v[0] as Inner).n : "o" + (v as Inner).n) : String(v); return out }
function byObject(m: Map<Inner, Outer>, held: Inner[], k: number): number { for (let i = 0; i < k; i++) { const o = F.outer(i); held.push(o.b); m.set(o.b, o); if (i % 5 === 0) F.again() } let s = 0; for (const b of held) s += m.get(b)!.id + b.n; return s }
function turned(m: Map<unknown, Inner>, k: number): number { for (let i = 0; i < k; i++) m.set(F.key(i), F.inner(i)); F.again(); const odd = F.inner(1000); m.set(odd, F.inner(2000)); F.again(); let s = m.get(odd)!.n; for (let i = 0; i < k; i++) s += m.get(F.key(i))!.n; return s }
function copied(m: Map<string, Inner>): number { const c = new Map(m); m.clear(); F.again(); let s = 0; for (const v of c.values()) s += v.n; return s }
function functions(m: Map<string, () => number>, k: number): number { for (let i = 0; i < k; i++) { m.set(F.key(i), () => i * 2); if (i % 7 === 0) F.again() } let s = 0; for (const f of m.values()) s += f(); return s }
const F = { inner, outer, key, collect, churn, again, fill, sum, walk, drop, growWhileWalking, shrinkWhileWalking, clearWhileWalking, takeOut, replace, keysOnly, lengths, mixed, byObject, turned, copied, functions };

const m = new Map<string, Inner>();
for (const size of [1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 33, 64, 65, 129, 300]) { F.fill(m, m.size, size, 13); F.again(); console.log(size, m.size, F.sum(m, 0, size), F.walk(m)) }
console.log("deleted", F.drop(m, 0, 300, 3), m.size, F.sum(m, 0, 300), F.walk(m));
F.fill(m, 300, 420, 17); console.log("filled again", m.size, F.sum(m, 0, 420), F.walk(m));
console.log("taken out", F.takeOut(m, 1), F.takeOut(m, 400), F.takeOut(m, 3), "replaced", F.replace(m, 2), F.replace(m, 401), m.size, F.sum(m, 0, 420));
{ const w = new Map<string, Inner>(); F.fill(w, 0, 6, 2); console.log("grows while walked", F.growWhileWalking(w, 60), w.size, F.walk(w)) }
{ const w = new Map<string, Inner>(); F.fill(w, 0, 40, 7); console.log("shrinks while walked", F.shrinkWhileWalking(w)) }
{ const w = new Map<string, Inner>(); F.fill(w, 0, 20, 7); console.log("cleared while walked", F.clearWhileWalking(w)) }
{ const s = new Set<string>(); F.keysOnly(s, 0, 130); F.again(); console.log("a set", s.size, F.lengths(s), s.has(F.key(77)), s.has(F.key(130))) }
console.log("values of many kinds", F.mixed(new Map<string, unknown>(), 40));
console.log("objects as keys", F.byObject(new Map<Inner, Outer>(), [], 70));
console.log("a key that is no string arrives late", F.turned(new Map<unknown, Inner>(), 30));
console.log("copied, the first one cleared", F.copied(m), m.size);
console.log("functions", F.functions(new Map<string, () => number>(), 50));
//// maps-and-sets-filled-in-counted-loops.ts
// A Map or Set that a loop over an array fills with one entry per turn behaves like any other: order, size, duplicates, deletions, growth after the loop and iteration during it.
const shell = globalThis as any;
const collect: (full: boolean) => void = shell.Bun ? (full: boolean) => shell.Bun.gc(full) : (full: boolean) => (full ? shell.fullGC() : shell.edenGC());
type Item = { name: string; rank: number };

function items(count: number, distinct: number): Item[] {
  const list: Item[] = [];
  for (let i = 0; i < count; i++) list.push({ name: "n" + (i % distinct), rank: i });
  return list;
}

function byName(list: Item[]): Map<string, Item> {
  const table = new Map<string, Item>();
  for (const item of list) table.set(item.name, item);
  return table;
}

function ranks(list: Item[]): Map<string, number> {
  const table = new Map<string, number>();
  for (let i = 0; i < list.length; i++) table.set(list[i].name, list[i].rank / 2);
  return table;
}

function names(list: Item[]): Set<string> {
  const set = new Set<string>();
  for (const item of list) set.add(item.name);
  return set;
}

function mixed(list: Item[]): Map<string, Item | number | undefined> {
  const table = new Map<string, Item | number | undefined>();
  for (const item of list) table.set(item.name, item.rank % 3 === 0 ? item : item.rank % 3 === 1 ? item.rank : undefined);
  return table;
}

function describe(table: Map<string, unknown>): string {
  let text = table.size + ":";
  let sum = 0;
  for (const [key, value] of table) {
    sum = (sum * 31 + key.length + (typeof value === "number" ? value * 2 : value ? (value as Item).rank : 7)) % 1000003;
    if (table.size <= 6) text += key + ",";
  }
  return text + sum;
}

for (const count of [0, 1, 2, 3, 4, 5, 7, 8, 9, 12, 13, 16, 17, 31, 32, 33, 63, 64, 65, 100, 255, 256, 257, 1000, 5000]) {
  for (const distinct of [1, 3, 8, 9, 1 << 20]) {
    const list = items(count, distinct);
    const table = byName(list);
    const set = names(list);
    let joined = 0;
    for (const name of set) joined = (joined * 7 + name.length) % 10007;
    console.log(count, distinct, describe(table), describe(ranks(list)), describe(mixed(list)), set.size, joined);
  }
}

function filledTwice(first: Item[], second: Item[]): Map<string, Item> {
  const table = new Map<string, Item>();
  for (const item of first) table.set(item.name, item);
  for (const item of second) table.set("second " + item.name, item);
  table.set("last", first[0] ?? second[0]);
  return table;
}
console.log(describe(filledTwice(items(10, 100), items(30, 100))), describe(filledTwice(items(0, 1), items(5, 2))), describe(filledTwice(items(40, 7), items(1, 1))));

function deletingOnTheWay(list: Item[]): Map<string, Item> {
  const table = new Map<string, Item>();
  for (let i = 0; i < list.length; i++) {
    table.set(list[i].name, list[i]);
    if (i % 3 === 2) table.delete(list[i - 1].name);
    if (i === 20) table.clear();
  }
  return table;
}
console.log(describe(deletingOnTheWay(items(19, 1000))), describe(deletingOnTheWay(items(50, 1000))), describe(deletingOnTheWay(items(50, 4))));

function growingList(list: Item[]): Map<string, Item> {
  const table = new Map<string, Item>();
  for (const item of list) {
    table.set(item.name, item);
    if (list.length < 40) list.push({ name: "pushed " + list.length, rank: list.length });
  }
  return table;
}
console.log(describe(growingList(items(3, 100))), describe(growingList(items(39, 100))));

function shrinkingList(list: Item[]): Map<string, Item> {
  const table = new Map<string, Item>();
  for (let i = 0; i < list.length; i++) {
    table.set(list[i].name, list[i]);
    if (i % 2) list.pop();
  }
  return table;
}
console.log(describe(shrinkingList(items(30, 100))));

function iteratedWhileFilled(list: Item[]): string {
  const table = new Map<string, Item>();
  table.set("first", { name: "first", rank: -1 });
  const walk = table.entries();
  let seen = "";
  for (const item of list) {
    table.set(item.name, item);
    const step = walk.next();
    if (!step.done) seen += step.value[0] + ";";
  }
  for (const [key] of walk) seen += "(" + key + ")";
  return seen.length + " " + seen.slice(0, 60);
}
console.log(iteratedWhileFilled(items(4, 100)), iteratedWhileFilled(items(25, 100)), iteratedWhileFilled(items(25, 3)));

function otherKeys(list: Item[]): number {
  const table = new Map<string, Item>();
  (table as Map<unknown, Item>).set(42, list[0]);
  for (const item of list) table.set(item.name, item);
  return table.size;
}
console.log(otherKeys(items(30, 100)), otherKeys(items(3, 100)));

function sharedTable(table: Map<string, Item>, list: Item[]) {
  for (const item of list) table.set(item.name + "!", item);
}
const shared = byName(items(6, 100));
for (let round = 0; round < 5; round++) sharedTable(shared, items(round * 9, 1000));
console.log(describe(shared));

const kept: Map<string, Item>[] = [];
for (let round = 0; round < 3000; round++) kept.push(byName(items(round % 37, 1000)));
collect(true);
let total = 0;
for (const table of kept) for (const [key, value] of table) total += key.length + value.rank;
console.log(total);
//// members-redefined-as-accessors.ts
// A declared member of an object that typed code made is turned into a getter with Object.defineProperty. Reads of the member run the getter from then on, as in JavaScript.
function row(name: string, f: () => unknown) { try { console.log(name + ": " + f()) } catch (e) { console.log(name + ": threw " + (e instanceof TypeError ? "TypeError" : String(e))) } }
type Item = { title: string; hint?: string; note?: string; size: number; on: boolean; tags: string[] }
type Given = { title: string | (() => string); hint?: string | (() => string); note?: string | (() => string) }
function wire(item: Item, key: "title" | "hint" | "note", given: string | (() => string) | undefined) {
  if (typeof given !== "function") return
  Object.defineProperty(item, key, { get: given, enumerable: true, configurable: true })
}
function make(d: Given): Item {
  const item: Item = { title: typeof d.title === "function" ? "" : d.title, hint: typeof d.hint === "function" ? undefined : d.hint, note: typeof d.note === "function" ? undefined : d.note, size: 1.5, on: true, tags: ["t"] }
  wire(item, "title", d.title); wire(item, "hint", d.hint); wire(item, "note", d.note)
  return item
}
function titleOf(item: Item): string { return item.title + "/" + (item.hint ?? "-") + "/" + (item.note ?? "-") + "/" + item.size + item.on + item.tags.join() }
let count = 0
row("plain values", () => titleOf(make({ title: "t", hint: "h" })))
row("a required member computed on each read", () => { const item = make({ title: () => "computed " + ++count }); return titleOf(item) + " " + titleOf(item) })
row("optional members too", () => titleOf(make({ title: () => "T", hint: () => "H", note: () => "N" })))
row("the keys and the order", () => { const item = make({ title: () => "T", note: () => "N" }); return Object.keys(item).join() + " " + JSON.stringify(item) + " " + typeof Object.getOwnPropertyDescriptor(item, "title")?.get })
row("a store to a member without a setter", () => { const item = make({ title: () => "T" }); let threw = "stored"; try { item.title = "x" } catch (e) { threw = (e as Error).name } return threw + " " + item.title })
row("the other members still store", () => { const item = make({ title: () => "T" }); item.size = 2.5; item.on = false; item.tags.push("u"); return titleOf(item) })
row("both kinds in one array", () => [make({ title: "a" }), make({ title: () => "b" }), make({ title: "c" })].map(titleOf).join(" "))
row("a copy holds the value", () => { const copy = { ...make({ title: () => "once " + ++count }) }; return copy.title + " " + copy.title })
row("with a setter", () => { const item = make({ title: "t" }); let kept = "k"; Object.defineProperty(item, "title", { get: () => kept, set: (v: string) => { kept = v + "!" }, enumerable: true, configurable: true }); item.title = "set"; return item.title })
row("made a value again", () => { const item = make({ title: () => "T" }); Object.defineProperty(item, "title", { value: "plain again", writable: true, enumerable: true, configurable: true }); item.title += "."; return titleOf(item) })
let total = 0
for (let i = 0; i < 2000; i++) total += titleOf(make({ title: "n" + i })).length
console.log("objects that stay as they were made: " + total)
//// members-redefined-as-accessors-generic.ts
// A generic helper turns a declared member of whatever object it is handed into a getter with Object.defineProperty. Reads of the member run the getter from then on, as in JavaScript.
function row(name: string, f: () => unknown) { try { console.log(name + ": " + f()) } catch (e) { console.log(name + ": threw " + (e instanceof TypeError ? "TypeError" : String(e))) } }
type Item = { title: string; hint?: string; note?: string; size: number; on: boolean; tags: string[] }
type Given = { title: string | (() => string); hint?: string | (() => string); note?: string | (() => string) }
function wire<T extends object>(item: T, key: keyof T & string, given: unknown) {
  if (typeof given !== "function") return
  Object.defineProperty(item, key, { get: given as () => unknown, enumerable: true, configurable: true })
}
function make(d: Given): Item {
  const item: Item = { title: typeof d.title === "function" ? "" : d.title, hint: typeof d.hint === "function" ? undefined : d.hint, note: typeof d.note === "function" ? undefined : d.note, size: 1.5, on: true, tags: ["t"] }
  wire(item, "title", d.title); wire(item, "hint", d.hint); wire(item, "note", d.note)
  return item
}
function titleOf(item: Item): string { return item.title + "/" + (item.hint ?? "-") + "/" + (item.note ?? "-") + "/" + item.size + item.on + item.tags.join() }
let count = 0
row("plain values", () => titleOf(make({ title: "t", hint: "h" })))
row("a required member computed on each read", () => { const item = make({ title: () => "computed " + ++count }); return titleOf(item) + " " + titleOf(item) })
row("optional members too", () => titleOf(make({ title: () => "T", hint: () => "H", note: () => "N" })))
row("the keys and the order", () => { const item = make({ title: () => "T", note: () => "N" }); return Object.keys(item).join() + " " + JSON.stringify(item) + " " + typeof Object.getOwnPropertyDescriptor(item, "title")?.get })
row("a store to a member without a setter", () => { const item = make({ title: () => "T" }); let threw = "stored"; try { item.title = "x" } catch (e) { threw = (e as Error).name } return threw + " " + item.title })
row("the other members still store", () => { const item = make({ title: () => "T" }); item.size = 2.5; item.on = false; item.tags.push("u"); return titleOf(item) })
row("both kinds in one array", () => [make({ title: "a" }), make({ title: () => "b" }), make({ title: "c" })].map(titleOf).join(" "))
row("a copy holds the value", () => { const copy = { ...make({ title: () => "once " + ++count }) }; return copy.title + " " + copy.title })
let total = 0
for (let i = 0; i < 2000; i++) total += titleOf(make({ title: "n" + i })).length
console.log("objects that stay as they were made: " + total)
//// members-redefined-with-other-attributes.ts
// Object.defineProperty, Object.defineProperties and Reflect.defineProperty give a declared member of an object that typed code made other attributes: read-only, hidden, fixed. Everything afterwards is as in JavaScript.
function row(name: string, f: () => unknown) { try { console.log(name + ": " + f()) } catch (e) { console.log(name + ": threw " + (e instanceof TypeError ? "TypeError" : String(e))) } }
interface Entry { id: number; label: string; secret: string; on: boolean }
function entry(): Entry { return { id: 1.5, label: "l", secret: "s", on: true } }
const look = (e: Entry) => Object.keys(e).join() + " " + JSON.stringify(e) + " " + e.id + e.label + e.secret + e.on
row("the same attributes, another value", () => { const e = entry(); Object.defineProperty(e, "label", { value: "other", writable: true, enumerable: true, configurable: true }); return look(e) })
row("only a value", () => { const e = entry(); Object.defineProperty(e, "label", { value: "valued" }); e.label += "!"; return look(e) })
row("hidden", () => { const e = entry(); Object.defineProperty(e, "secret", { enumerable: false }); return look(e) + " " + ("secret" in e) + " " + Object.getOwnPropertyNames(e).join() + " " + JSON.stringify({ ...e }) })
row("hidden, then stored to", () => { const e = entry(); Object.defineProperty(e, "secret", { enumerable: false }); e.secret = "again"; return look(e) + " " + JSON.stringify(Object.getOwnPropertyDescriptor(e, "secret")) })
row("read-only", () => { const e = entry(); Object.defineProperty(e, "id", { writable: false }); let threw = "stored"; try { e.id = 9.5 } catch (error) { threw = (error as Error).name } return threw + " " + look(e) })
row("fixed", () => { const e = entry(); Object.defineProperty(e, "on", { configurable: false }); let threw = "deleted"; try { delete (e as Partial<Entry>).on } catch (error) { threw = (error as Error).name } return threw + " " + look(e) + " " + JSON.stringify(Object.getOwnPropertyDescriptor(e, "on")) })
row("a hidden value in one step", () => { const e = entry(); Object.defineProperty(e, "secret", { value: "new", enumerable: false, writable: true, configurable: true }); return look(e) })
row("Object.defineProperties", () => { const e = entry(); Object.defineProperties(e, { secret: { enumerable: false }, id: { writable: false, value: 2.5 } }); return look(e) })
row("Reflect.defineProperty", () => { const e = entry(); return Reflect.defineProperty(e, "secret", { enumerable: false }) + " " + look(e) })
row("made visible again", () => { const e = entry(); Object.defineProperty(e, "secret", { enumerable: false }); Object.defineProperty(e, "secret", { enumerable: true }); return look(e) })
row("others of the type are untouched", () => { const first = entry(), second = entry(); Object.defineProperty(first, "secret", { enumerable: false }); Object.defineProperty(first, "id", { writable: false }); second.id = 7.5; return look(first) + " | " + look(second) })
row("a member that is not declared", () => { const e = entry(); Object.defineProperty(e, "extra", { value: 1, enumerable: false }); return look(e) + " " + (e as Entry & { extra: number }).extra })
function hideSecret<T extends { secret: string }>(value: T): T { return Object.defineProperty(value, "secret", { enumerable: false }) }
row("through a generic helper", () => look(hideSecret(entry())))
let total = 0
for (let i = 0; i < 2000; i++) { const e = entry(); e.id = i; e.label = "n" + i; total += e.id + e.label.length + e.secret.length }
console.log("objects that nobody redefines: " + total)
//// method-member-narrower-parameters/main.ts
// A member declared with method syntax may be given a function whose parameter asks for more than the member promises: TypeScript compares the parameters of methods both ways. The function is then handed an object that lacks a member its parameter requires, as in plain JavaScript.
import { aConstantByItsName, aFunctionExpression, aMethod, assigned, byItsName, calledByTheirNames, neverReads, reads, reuses } from "./policies";
import type { Policy } from "./trust";

type Deps = { policy: Policy; dir: string };
function run(deps: Deps, tool: string, facts: { attested: boolean }): string {
  const c = deps.policy.constraints(tool, deps.dir, { attested: facts.attested });
  return deps.policy.name + ": " + c.allowed + " " + c.dir + " " + c.said;
}

const first = neverReads("never reads it");
for (const policy of [first, reuses("reuses it", first), reads("reads it"), aFunctionExpression("a function expression"), aMethod("a method"), byItsName("by its name"), aConstantByItsName("a constant by its name"), assigned]) {
  console.log(run({ policy, dir: "/a" }, "ls", { attested: true }));
  console.log(run({ policy, dir: "/b" }, "rm", { attested: false }));
  const left = policy.constraints("ls", "/c");
  console.log(policy.name + ", left out: " + left.allowed + " " + left.said);
  const whole = policy.constraints("ls", "/d", { attested: true, decidedByHost: true } as { attested: boolean });
  console.log(policy.name + ", whole: " + whole.allowed + " " + whole.said);
}
console.log(calledByTheirNames());
//// method-member-narrower-parameters/policies.ts
import { NONE, type Constraints, type Policy, type Trust } from "./trust";

export function neverReads(name: string): Policy {
  return {
    name,
    constraints: (tool: string, dir: string, _call: Trust = NONE): Constraints => ({ allowed: tool !== "rm", dir, said: "-" }),
  };
}
export function reads(name: string): Policy {
  return {
    name,
    constraints: (tool: string, dir: string, call: Trust = NONE): Constraints => ({ allowed: call.attested, dir, said: tool + " " + call.decidedByHost + " " + ("decidedByHost" in call) }),
  };
}
export function aFunctionExpression(name: string): Policy {
  return {
    name,
    constraints: function (tool: string, dir: string, call: Trust = NONE): Constraints {
      return { allowed: call.attested, dir, said: tool + " " + (call.decidedByHost ?? "not decided") };
    },
  };
}
export function aMethod(name: string): Policy {
  return {
    name,
    constraints(tool: string, dir: string, call: Trust = NONE): Constraints {
      return { allowed: call.attested, dir, said: this.name.length + " " + tool + " " + call.decidedByHost };
    },
  };
}
function declared(tool: string, dir: string, call: Trust = NONE): Constraints {
  return { allowed: call.attested, dir, said: tool + " " + String(call.decidedByHost) };
}
export function byItsName(name: string): Policy {
  return { name, constraints: declared };
}
const constraints = (tool: string, dir: string, call: Trust = NONE): Constraints => ({ allowed: call.attested, dir, said: tool + " " + JSON.stringify(call) });
export function aConstantByItsName(name: string): Policy {
  return { name, constraints };
}
export function calledByTheirNames(): string {
  return declared("ls", "/e", { attested: true, decidedByHost: true }).said + " " + constraints("ls", "/e").said;
}
export function reuses(name: string, other: Policy): Policy {
  return { name, constraints: other.constraints };
}
const assigned: Policy = neverReads("assigned");
assigned.constraints = (tool: string, dir: string, call: Trust = NONE): Constraints => ({ allowed: call.attested, dir, said: tool + " " + Object.keys(call).join() });
export { assigned };
//// method-member-narrower-parameters/trust.ts
export type Trust = { readonly attested: boolean; readonly decidedByHost: boolean };
export const NONE: Trust = { attested: false, decidedByHost: false };
export type Constraints = { allowed: boolean; dir: string; said: string };
export type Policy = {
  name: string;
  constraints(tool: string, dir: string, call?: Pick<Trust, "attested">): Constraints;
};
//// method-replaced-by-assignment.ts
// A method that the program replaces with a plain assignment (`s.speak = ..`) is called through its interface and its class.
interface Speaker { id: number; speak(greeting: string): string }
function sharedSpeak(this: Speaker, greeting: string): string { return greeting + " shared " + this.id }
////= ClassSpeaker
function replacing(s: Speaker): string { return s.speak((s.speak = () => "replaced " + s.id, "old")) + " then " + s.speak("new") }
function speaking(s: Speaker): string { return s.speak("old") + " then " + s.speak("new") }
// `s.speak = ..` is seen by the checker: `speak` is a replaced method, also of the class. (A store that it does not see: type-rules/own-property-shadows-method-computed-key.)
console.log(replacing({ id: 20, speak: sharedSpeak }), "|", speaking(new ClassSpeaker(21)))
const c = new ClassSpeaker(21)
console.log(replacing(c), "|", c.speak("still"), Object.keys(c).join())
c.speak = c.speak.bind(c)
const free = c.speak
console.log(free("bound"), new ClassSpeaker(22).speak("other"))
//// methods-reassigned-by-some-subclasses.ts
// Only some classes of a hierarchy store to a method, `this.name = ..`: a call through the type of the class above them finds each object's own function or the method of its class.
function said(f: () => unknown): string { try { return String(f()); } catch (e) { return "threw " + (e as Error).name; } }
function row(label: string, f: () => unknown) { console.log(label + ": " + said(f)); }
const keys = (o: object) => Object.keys(o).join();

class Source {
  name = "source";
  lift(): string { return "lifted by " + this.name; }
  run(): string { return this.lift(); }
}
////= lines-3	Plain	Source	name	"plain"
class Overriding extends Source {
  name = "overriding";
  lift(): string { return "overridden in " + this.name; }
}
class Patched extends Source {
  name = "patched";
  extra = 1;
  constructor(from?: Source) {
    super();
    if (from) this.lift = from.lift;
  }
}
class Deeper extends Patched {
  describe(): string { return "deeper " + this.extra; }
}
class Wide extends Source {
  name = "wide";
  a = 1;
  b = 2;
  c = 3;
  constructor(own: boolean) {
    super();
    if (own) this.lift = () => "its own in " + this.name;
  }
}
class OverridingBelow extends Wide {
  name = "below";
  lift(): string { return "overridden below in " + this.name; }
}

const all: Source[] = [
  new Source(), new Plain(), new Overriding(),
  new Patched(), new Patched(new Overriding()), new Deeper(), new Deeper(new Source()),
  new Wide(false), new Wide(true), new OverridingBelow(false), new OverridingBelow(true),
];
for (let round = 0; round < 3; round++) row("through the class above, round " + round, () => all.map(one => one.run()).join(" | "));
row("called directly", () => all.map(one => one.lift()).join(" | "));
row("own keys", () => all.map(keys).join(" | "));
row("has its own", () => all.map(one => Object.prototype.hasOwnProperty.call(one, "lift")).join());
function hasLift(source: any): boolean { return typeof source?.lift === "function"; }
row("read through any", () => all.map(hasLift).join());
row("read as a value", () => all.map(one => { const lift = one.lift; return lift.call(one); }).join(" | "));
row("the same function as the prototype's", () => all.map(one => one.lift === Object.getPrototypeOf(one).lift).join());
interface Lifts { lift(): string; }
const lifting: Lifts[] = [...all, { lift() { return "a literal"; } }];
row("through an interface", () => lifting.map(one => one.lift()).join(" | "));
//// methods-reassigned-on-instances.ts
// A class stores to one of its own methods, `this.name = ..`: the object has the property as its own from then on, and any other object of the class finds the method.
function said(f: () => unknown): string { try { return String(f()); } catch (e) { return "threw " + (e as Error).name; } }
function row(label: string, f: () => unknown) { console.log(label + ": " + said(f)); }
const keys = (o: object) => Object.keys(o).join();

class Base<T> {
  total = 0;
  next(value: T): void { this._next(value); }
  protected _next(value: T): void { this.total++; }
  seen(): string { return keys(this) + "|" + Object.prototype.hasOwnProperty.call(this, "_next") + "|" + ("_next" in this); }
}
class Derived<T> extends Base<T> {
  last = "none";
  constructor(onNext?: (value: T) => void) {
    super();
    this._next = onNext ? function (this: Derived<T>, value: T) { onNext(value); this.total += 2; } : super._next;
  }
}
class Plain<T> extends Base<T> {
  more = 1;
}
class Overriding<T> extends Base<T> {
  protected _next(value: T): void { this.total += 10; }
}
class Late<T> extends Base<T> {
  swap(): void { this._next = () => { this.total += 100; }; }
}

let sink = 0;
const derived = new Derived<number>(value => { sink += value; });
const inherits = new Derived<number>();
const plain = new Plain<number>();
const base = new Base<number>();
const overriding = new Overriding<number>();
const late = new Late<number>();
for (const one of [derived, inherits, plain, base, overriding, late] as Base<number>[]) { one.next(5); one.next(6); }
row("totals", () => [derived.total, inherits.total, plain.total, base.total, overriding.total, late.total, sink].join());
row("an object that stored a function", () => derived.seen());
row("an object that stored the method it inherits", () => inherits.seen());
row("an object of a class that stores nothing", () => plain.seen());
row("an object of the class that declares the method", () => base.seen());
row("an object of a class that overrides it", () => overriding.seen());
row("before the store", () => late.seen());
late.swap();
late.next(1);
row("after the store", () => late.seen() + "|" + late.total);
row("JSON", () => JSON.stringify([derived, inherits, plain, late]));
row("entries", () => Object.entries(derived).map(([key, value]) => key + ":" + typeof value).join());
row("spread", () => keys({ ...derived }) + "|" + keys({ ...plain }));
row("for in", () => { const found: string[] = []; for (const key in late) found.push(key); return found.join(); });
row("own names", () => Object.getOwnPropertyNames(inherits).join() + "|" + Object.getOwnPropertyNames(base).join());
row("the descriptor", () => JSON.stringify(Object.getOwnPropertyDescriptor(derived, "_next")) + "|" + Object.getOwnPropertyDescriptor(plain, "_next"));
row("the prototype keeps the method", () => Object.getOwnPropertyNames(Base.prototype).join() + "|" + ((inherits as any)._next === (Base.prototype as any)._next) + "|" + ((derived as any)._next === (Base.prototype as any)._next));
row("the method of the class, read from an object that has none of its own", () => ((plain as any)._next === (Base.prototype as any)._next) + "|" + ((overriding as any)._next === (Overriding.prototype as any)._next));
row("deleted", () => { delete (late as any)._next; late.next(1); return late.seen() + "|" + late.total; });
row("stored again", () => { late.swap(); late.next(1); return late.seen() + "|" + late.total; });
row("stored by untyped code", () => { (plain as any)._next = function (this: any) { this.total += 1000; }; plain.next(1); return plain.seen() + "|" + plain.total; });
row("stored by a computed key", () => { const key: string = ["_", "next"].join(""); (base as any)[key] = function (this: any) { this.total += 7; }; base.next(1); return base.seen() + "|" + base.total; });
row("frozen", () => { const frozen = Object.freeze(new Late<number>()); return said(() => frozen.swap()) + "|" + frozen.seen(); });

class Counter {
  total = 0;
  constructor() {
    this.add = this.add.bind(this);
  }
  add(value: number): void { this.total += value; }
}
class Unbound {
  total = 0;
  add(value: number): void { this.total += value; }
}
const counter = new Counter();
const add = counter.add;
add(2);
counter.add(3);
row("bound to its object", () => counter.total + "|" + keys(counter) + "|" + (counter.add === Counter.prototype.add) + "|" + counter.add.name + "|" + counter.add.length);
row("taken off an object that binds nothing", () => { const unbound = new Unbound(); const taken = unbound.add; return said(() => taken(1)) + "|" + (taken === Unbound.prototype.add) + "|" + keys(unbound); });

interface Sink { push(value: number): void; }
class Collector implements Sink {
  held: number[] = [];
  constructor(doubles: boolean) {
    if (doubles) this.push = value => { this.held.push(value * 2); };
  }
  push(value: number): void { this.held.push(value); }
}
const literal = { held: [] as number[], push(value: number) { this.held.push(-value); } };
const sinks: Sink[] = [new Collector(false), new Collector(true), literal];
for (const one of sinks) one.push(4);
row("through an interface", () => sinks.map(one => (one as Collector).held.join() + ":" + keys(one)).join("|"));
row("an optional call", () => { const maybe: Collector | undefined = sinks[1] as Collector; maybe?.push?.(1); return maybe.held.join(); });
row("read as a value and called", () => { const first = sinks[0] as Collector; const push = first.push; push.call(first, 9); return first.held.join(); });

class Patched {
  value(): number { return 1; }
  own(): void { this.value = () => 2; }
}
const patched = new Patched();
const other = new Patched();
other.value = () => 3;
row("a store through a variable besides", () => [patched.value(), other.value()].join());
patched.own();
row("and through this", () => [patched.value(), other.value(), new Patched().value(), keys(patched), keys(other)].join());

class Shared {
  static make(): string { return "static"; }
  make(): string { return "method"; }
  remake(): void { this.make = () => "own"; }
}
const shared = new Shared();
shared.remake();
row("a static method of the same name", () => [Shared.make(), shared.make(), new Shared().make()].join());
//// methods-through-interfaces.ts
// Method calls through an interface that is implemented by object literals with methods.
interface Speaker { id: number; speak(greeting: string): string; shout?(): string }
function sharedSpeak(this: Speaker, greeting: string): string { return greeting + " shared " + this.id }
////= ClassSpeaker
class LoudSpeaker extends ClassSpeaker {
  override speak(greeting: string): string { return super.speak(greeting).toUpperCase() }
  shout(): string { return "LOUD" + this.id }
}
class FieldSpeaker implements Speaker {
  id = 6
  speak = (greeting: string): string => greeting + " field " + this.id
  shout?: () => string
}
let getterCalls = 0
class GetterSpeaker implements Speaker {
  id = 7
  get speak(): (greeting: string) => string { getterCalls++; return greeting => greeting + " getter " + this.id }
}
const literalMethod: Speaker = { id: 1, speak(greeting) { return greeting + " method " + this.id } }
const literalArrow: Speaker = { id: 2, speak: greeting => greeting + " arrow", shout: () => "arrow shout" }
const literalFunction: Speaker = { speak: function (this: Speaker, greeting: string) { return greeting + " function " + this.id }, id: 3 }
const literalShared: Speaker = { id: 8, speak: sharedSpeak, shout: undefined }
const literalBound: Speaker = { id: 9, speak: sharedSpeak.bind(literalMethod) }
const literalGetter: Speaker = { id: 10, get speak() { getterCalls++; return sharedSpeak } }
const callable: Speaker = Object.assign(function () { return 0 }, { id: 12, speak: sharedSpeak })
const speakers: Speaker[] = [literalMethod, literalArrow, literalFunction, new ClassSpeaker(4), new LoudSpeaker(5), new FieldSpeaker(), new GetterSpeaker(), literalShared, literalBound, literalGetter, callable]
function talk(s: Speaker): string { return s.speak("hi") + "|" + (s.shout?.() ?? "-") + "|" + ("shout" in s) + "|" + Object.keys(s).join("") }
console.log(speakers.map(talk).join("\n"))
console.log(getterCalls)

// The same calls by a constant key, by a key that is computed, and on the function taken out first.
const key = ["sp", "eak"].join("") as "speak"
console.log(speakers.map(s => s["speak"]("a") + "/" + s[key]("b")).join(), getterCalls)
console.log(speakers.map(s => { const f = s.speak; return f.call(s, "c") }).join(), getterCalls)

// The function is read before the arguments are evaluated, and the arguments of an absent optional method are not evaluated.
let evaluated = 0
function replacing(s: Speaker): string { return s.speak((s.speak = () => "replaced " + s.id, "old")) + " then " + s.speak("new") }
function optional(s: Speaker): string { return String(s.shout?.call(s, ...(evaluated++, [] as []))) }
console.log(replacing({ id: 20, speak: sharedSpeak }), "|", replacing(new FieldSpeaker()))
// The checker sees the stores: `speak` is a replaced method, also of the classes.
const stored = new ClassSpeaker(30)
stored.speak = literalArrow.speak
console.log(replacing(new ClassSpeaker(21)), "|", stored.speak("hi"), Object.keys(stored).join(), Object.hasOwn(stored, "speak"), new ClassSpeaker(31).speak("x"), new ClassSpeaker(4).speak.call(literalArrow, "d"))
console.log(speakers.map(optional).join(), evaluated)

// Methods are stored through the interface: from one member to another, one that the class lacks, then removed again.
const target = new ClassSpeaker(30)
const asSpeaker: Speaker = target
asSpeaker.shout = function (this: Speaker) { return "late shout " + this.id }
console.log(talk(asSpeaker), talk(target))
delete asSpeaker.shout
console.log(talk(target))
literalMethod.speak = literalArrow.speak; literalArrow.speak = sharedSpeak; literalArrow.shout = undefined
console.log(talk(literalMethod), talk(literalArrow), talk(literalBound))
try { (new GetterSpeaker() as Speaker).speak = sharedSpeak; console.log("stored") } catch (e) { console.log((e as Error).constructor.name) }

// A property that holds a function, declared as a property; parameters that are optional, defaulted and rest.
interface Calculator { base: number; apply: (x: number, y?: number) => number; many(...values: number[]): number; scaled?(factor?: number): number }
class ClassCalculator implements Calculator {
  base = 100
  apply(x: number, y = 10): number { return this.base + x * y }
  many(...values: number[]): number { return values.reduce((a, b) => a + b, this.base) }
  scaled(factor = 2): number { return this.base * factor }
}
const calculators: Calculator[] = [
  new ClassCalculator(),
  { base: 1, apply(x, y) { return this.base + x + (y === undefined ? 0.5 : y) }, many() { return arguments.length + this.base } },
  { base: 2, apply: x => x * 2, many: (...values) => values.length, scaled: factor => (factor ?? -1) * 3 },
  { base: 3, apply: Math.max as Calculator["apply"], many: Math.min },
]
console.log(calculators.map(c => [c.apply(1), c.apply(1, 2), c.apply(1, undefined), c.many(), c.many(5), c.many(5, 6, 7), c.scaled?.(), c.scaled?.(4), c.scaled?.(undefined)].join()).join(" | "))

// A generic function over members, and one call site that sees all of them many times.
function longest<T extends Speaker>(list: readonly T[]): T { let best = list[0]; for (const s of list) if (s.speak("").length > best.speak("").length) best = s; return best }
console.log(longest(speakers).id, longest([new ClassSpeaker(1), new LoudSpeaker(22222)]).id, longest([literalShared, literalBound]).id)
let chars = 0
for (let i = 0; i < 39000; i++) { const s = speakers[i % speakers.length]; chars += s.speak("x").length + (s.shout ? s.shout().length : 0) + s.id }
console.log(chars, getterCalls)
