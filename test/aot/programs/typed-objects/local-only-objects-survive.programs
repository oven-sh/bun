const tests: Record<string, (r: Built) => r is WithPath> = { item: (r): r is WithPath => r.item !== undefined }
report("table", built.filter(tests.item!)[0], built[0]!)
//// narrowed-identity-recursive-types.ts
// Narrowing a record from one closed record type to another must not copy it.
type Item = { kind: "prompt" | "other"; name: string }
type Built = { item: Item | undefined; path: string }
type WithPath = { item: Item; path: string }
function build(names: string[]): Built[] { return names.map((n): Built => ({ item: n === "" ? undefined : { kind: "prompt", name: n }, path: "/p/" + n })) }
function made(): WithPath { return { item: { kind: "other", name: "made" }, path: "/made" } }
////= report
const built = build(["a", "", "b"])
type B = { v: number | null; next: B | null }
type W = { v: number; next: W | null }
function isW(r: B): r is W { return r.v !== null && (r.next === null || isW(r.next)) }
const chain: B = { v: 1.5, next: { v: 2.5, next: { v: 3.5, next: null } } }
if (isW(chain)) { let sum = 0; for (let at: W | null = chain; at; at = at.next) sum += at.v; console.log(sum, chain.next === (chain as B).next, chain.next!.next!.v) }
//// narrowed-identity-write-back-wider.ts
// Narrowing a record from one closed record type to another must not copy it.
type Item = { kind: "prompt" | "other"; name: string }
type Built = { item: Item | undefined; path: string }
type WithPath = { item: Item; path: string }
function build(names: string[]): Built[] { return names.map((n): Built => ({ item: n === "" ? undefined : { kind: "prompt", name: n }, path: "/p/" + n })) }
function made(): WithPath { return { item: { kind: "other", name: "made" }, path: "/made" } }
////= report
const built = build(["a", "", "b"])
const kept = built.filter((r): r is WithPath => r.item !== undefined)
report("before", kept[0], built[0]!)
built[0]!.item = undefined
console.log("after", (kept[0] as Built).item, built[0]!.item, kept[0] === built[0])
//// narrowed-identity-write-narrow-read-wide.ts
// Narrowing a record from one closed record type to another must not copy it.
type Item = { kind: "prompt" | "other"; name: string }
type Built = { item: Item | undefined; path: string }
type WithPath = { item: Item; path: string }
function build(names: string[]): Built[] { return names.map((n): Built => ({ item: n === "" ? undefined : { kind: "prompt", name: n }, path: "/p/" + n })) }
function made(): WithPath { return { item: { kind: "other", name: "made" }, path: "/made" } }
////= report
const built = build(["a", "", "b"])
type B = { id: number; inner: { n: number; t: string | null } }
type W = { id: number; inner: { n: number; t: string } }
const all: B[] = [{ id: 2, inner: { n: 2, t: "t" } }]
const kept = all.filter((r): r is W => r.inner.t !== null)
kept[0]!.inner.t += "!"
kept[0]!.inner = { n: 3, t: "new" }
all[0]!.inner.t = null
console.log(all[0]!.inner.n, all[0]!.inner.t, (kept[0] as B).inner.t, kept[0]!.inner === all[0]!.inner)
//// narrowed-receiver-cell-slot.ts
// `tree` does not change in the loops, and `tree.child.value` is read only after a test narrows `tree` to `Branch`. A `Leaf` has a number in the bytes where a `Branch` has `child`, so hoisting the two loads out of a loop must not make the second one run on a `Leaf`.
class Inner { value: number; constructor(value: number) { this.value = value; } }
class Branch { kind: 1 = 1; child: Inner; constructor(value: number) { this.child = new Inner(value); } }
class Leaf { kind: 2 = 2; weight: number; constructor(weight: number) { this.weight = weight; } }
type Tree = Branch | Leaf;
function sumByClass(tree: Tree, rounds: number): number { let sum = 0; for (let i = 0; i < rounds; i++) sum += tree instanceof Branch ? tree.child.value : 1; return sum; }
function sumByKind(tree: Tree, rounds: number): number { let sum = 0; for (let i = 0; i < rounds; i++) sum += tree.kind === 1 ? tree.child.value : tree.weight > 0 ? 2 : 3; return sum; }
const trees: Tree[] = [new Branch(5), new Leaf(1.5e300), new Leaf(-7), new Branch(-2), new Leaf(0.1)];
let total = 0;
for (let round = 0; round < 2000; round++) for (const tree of trees) total += sumByClass(tree, 3) + sumByKind(tree, 3);
console.log(total, trees.map(tree => sumByClass(tree, 4)).join(), trees.map(tree => sumByKind(tree, 4)).join());
export {};
//// narrowing.ts
// What a type guard, an assertion function, `typeof`, a comparison, an assignment or `delete` narrows a variable or property to.
////= attempt
const hide = (v: unknown): unknown => v
// Guards and assertion functions.
function isNumber(v: unknown): v is number { return v !== null }
attempt("a2", () => { const v = hide(1); if (isNumber(v)) return v + 1; return "no" })
attempt("a3", () => { const v = hide(null); if (isNumber(v)) return v + 1; return "no" })
attempt("a6", () => [1, "two", 3n].filter(isNumber).length)
function assertString(v: unknown): asserts v is string {}
attempt("b2", () => { const v = hide("abc"); assertString(v); return v.length })
attempt("b4", () => { const v = hide(5); assertString(v); return v.toUpperCase() })
// A generic function of the program.
function cast<T>(v: unknown): T { return v as T }
function first<T>(items: T[]): T { return items[0] }
attempt("c2", () => cast<number>(1) + 1)
attempt("c3", () => typeof cast<unknown>("s"))
attempt("c5", () => first<number>(JSON.parse("[1]")) + 1)
function prop<T, K extends keyof T>(o: T, k: K): T[K] { return o[k] }
attempt("d2", () => prop(JSON.parse('{"x":1}') as { x: number }, "x") + 1)
// A narrowing that a call or an alias undoes: the checker keeps it, the value has moved on. No cast, no any.
interface Slot { v: number | string; w?: number | string }
const slot: Slot = { v: 1 }
function spoil() { slot.v = "spoiled"; slot.w = "w" }
attempt("e1", () => { slot.v = 1; if (typeof slot.v === "number") { spoil(); return slot.v + 1 } return "no" })
attempt("e2", () => { slot.v = 1; slot.w = 2; if (typeof slot.w === "number") { spoil(); return slot.w * 2 } return "no" })
attempt("e3", () => { slot.v = 5; spoil(); return slot.v + 1 })
attempt("e4", () => { const alias: Slot = slot; slot.v = 5; alias.v = "aliased"; return slot.v + 1 })
attempt("e5", () => { slot.v = 5; spoil(); slot.v += 1; return slot.v })
let captured: number | string = 1
function recapture() { captured = "late" }
attempt("f1", () => { captured = 1; if (typeof captured === "number") { recapture(); return captured + 1 } return "no" })
attempt("f2", () => { captured = 2; recapture(); return captured + 1 })
attempt("f3", () => { let local: number | string = 1; const set = () => { local = "set" }; set(); return local + 1 })
attempt("f4", () => { let local: number | string | boolean = true; const set = () => { local = "set" }; if (local === true) { set(); return !local } return "no" })
attempt("f5", () => { captured = 2; recapture(); captured += 1; return captured })
// delete, and stores through `any`.
interface Opt { n?: number; s?: string }
attempt("g1", () => { const o: Opt = { n: 1 }; o.n = 2; delete o.n; return o.n })
attempt("g2", () => { const o: Opt = { n: 1 }; if (o.n !== undefined) { delete o.n; return String(o.n) + typeof o.n } return "no" })
attempt("g3", () => { const o: Opt = {}; o.s = "x"; Object.assign(o, { s: undefined }); return o.s })
attempt("g4", () => { const o: Opt = {}; if (o.n === undefined) { o.n = 3; return o.n + 1 } return "no" })
// `in`, equality, truthiness, typeof in a switch, a loop that widens again.
type NorS = { tag: "n"; n: number } | { tag: "s"; s: string }
function pickOne(x: NorS): unknown { return "n" in x ? x.n : x.s }
attempt("h1", () => pickOne(JSON.parse('{"tag":"s","n":4}')))
attempt("h2", () => pickOne(JSON.parse('{"tag":"n","s":"t"}')))
attempt("h3", () => { const v = hide("0"); if (v === 0 || v === "0") return v + "!"; return "no" })
attempt("h4", () => { const v = hide(0) as number | string; if (!v) return typeof v; return "truthy" })
attempt("h5", () => { const v = hide("") as number | string; return v || "empty" })
attempt("i1", () => { const v = hide(7n); switch (typeof v) { case "number": return v + 1; case "bigint": return v + 1n; default: return "other" } })
attempt("i2", () => { let v: number | string = 0; for (let i = 0; i < 3; i++) { v = typeof v === "number" ? v + 1 : v + "!"; if (i === 1) v = String(v) } return v })
//// nested-field-mismatch-throws-at-read.ts
// An object from untyped code holds another one, and both are used through declared types. Any object passes the check at a parameter and stays as it is, also one that is the prototype of another object. A nested field of another type throws at the first typed read of that field, a nested object that is missing reads as undefined, and a field that is never read is never checked.
interface Gadget { serial: string; vendor?: string }
interface Crate { labels: string[]; gadget: Gadget }
interface Shipment { id: number; crate: Crate }

function describeCrate(crate: Crate): string { return crate.labels.join() + " " + crate.gadget.serial }
function describeShipment(shipment: Shipment): string { return shipment.id + " " + describeCrate(shipment.crate) }
const gadgets: any[] = [];
function untypedGadget(): any { const gadget: any = {}; gadget.serial = "s-1"; gadgets.push(gadget); return gadget }
function attempt(name: string, f: () => string): void {
  try { console.log(name, f()) } catch (e) { const message = (e as Error).message, note = message.indexOf(" (bun compile checks types"); console.log(name, (e as Error).name + (note < 0 ? "" : ": " + message.slice(0, note))) }
}

const known: Shipment = { id: 1, crate: { labels: ["known"], gadget: { serial: "s-0", vendor: "v" } } };
attempt("created by typed code:", () => describeShipment(known));

attempt("a prototype, one level down:", () => {
  const gadget = untypedGadget();
  const heir = Object.create(gadget);
  const crate: any = { labels: ["a"], gadget };
  return describeCrate(crate) + " " + heir.serial;
});

attempt("a prototype, two levels down:", () => {
  const gadget = untypedGadget();
  const heir = Object.create(gadget);
  const shipment: any = { id: 2, crate: { labels: ["b"], gadget } };
  return describeShipment(shipment) + " " + heir.serial;
});

attempt("a field of another type, one level down:", () => {
  const gadget = untypedGadget();
  gadget.serial = 7;
  const crate: any = { labels: ["c"], gadget };
  return describeCrate(crate);
});

attempt("a field of another type, two levels down:", () => {
  const gadget = untypedGadget();
  gadget.serial = 7;
  const shipment: any = { id: 3, crate: { labels: ["d"], gadget } };
  return describeShipment(shipment);
});

attempt("a nested object is missing:", () => {
  const shipment: any = { id: 4, crate: { labels: ["e"] } };
  return describeShipment(shipment);
});

attempt("a field of another type, not read:", () => {
  const gadget = untypedGadget();
  gadget.vendor = 9;
  const crate: any = { labels: ["f"], gadget };
  return describeCrate(crate);
});

console.log("the objects afterwards:", gadgets.map(gadget => Object.keys(gadget).join() + " " + typeof gadget.serial).join(", "));
//// nested-literal-after-spread-in-cast.ts
// An object literal with a spread is cast with `as`. A property written after the spread holds another object literal in one arm of a
// conditional. The inner literal is created once, and the cast copies nothing: a reference to it that was kept
// while it was created is the same object as the one the outer literal holds.
interface Jsx { runtime?: "automatic" | "classic"; factory?: string; fragment?: string }
interface Config { entrypoints: string[]; target?: string; jsx?: Jsx }
interface Options { entry: string; fold?: boolean; jsx?: Jsx }

let created: object | undefined
function remember<T extends object>(value: T): T { created = value; return value }
function describe(config: Config): string { return config.entrypoints.join() + " " + config.target + " " + (config.jsx ? config.jsx.runtime + " " + config.jsx.factory : "none") + " " + JSON.stringify(config) }
////= lines-40	build	{ runtime: jsx.runtime, factory: jsx.factory, fragment: jsx.fragment }
////= lines-40	buildAndRemember	remember({ runtime: jsx.runtime, factory: jsx.factory, fragment: jsx.fragment })
function buildInAVariable(options: Options): Config {
  const jsx = options.jsx
  const config: Config = {
    entrypoints: [options.entry],
    ...(options.fold === undefined ? {} : { foldForTesting: options.fold }),
    target: "bun",
    jsx: jsx ? { runtime: jsx.runtime, factory: jsx.factory, fragment: jsx.fragment } : undefined,
  } as Config
  if (options.fold) config.target = "node"
  return config
}

console.log(describe(build({ entry: "a.ts" })))
console.log(describe(build({ entry: "b.ts", fold: true, jsx: { runtime: "classic", factory: "h" } })))
const config = buildAndRemember({ entry: "c.ts", jsx: { runtime: "automatic" } })
console.log(describe(config), config.jsx === created)
console.log(describe(buildInAVariable({ entry: "e.ts", fold: true, jsx: { runtime: "classic", factory: "h" } })))
//// nested-literal-wider-member-under-cast.ts
// A nested object literal has a member whose type is wider than the type the outer `as` cast gives it (`string | undefined` for `string`)
// and lacks an optional member of that type, but the values it holds fit. Reading the nested object through the cast's type gives the
// object as it is, and nothing throws.
interface Compile { outfile: string; target?: string }
interface Build { entrypoints: string[]; compile: Compile; fold?: boolean }
interface Task { name: string; run: () => string; retries?: number }
interface Job { id: number; task: Task }

const knownBuild: Build = { entrypoints: ["known"], compile: { outfile: "known.js", target: "bun" } }
const knownJob: Job = { id: 1, task: { name: "known", run: () => "ran", retries: 2 } }
function describeBuild(build: Build): string { return build.entrypoints.join() + " " + build.compile.outfile + " " + build.compile.target + " " + build.fold }
function describeJob(job: Job): string { return job.id + " " + job.task.name + " " + job.task.run() + " " + job.task.retries }
function maybe(text: string): string | undefined { return knownBuild.entrypoints.length ? text : undefined }

console.log(describeBuild(knownBuild), describeJob(knownJob))
console.log(describeBuild({ entrypoints: ["a"], compile: { outfile: maybe("first.js") } } as Build))
console.log(describeJob({ id: 2, task: { name: maybe("second"), run: () => "ran too" } } as Job))
//// new-of-a-constructor-that-is-handed-over.ts
// The function reaches `new` as an argument: nothing at the `new` says which function it is.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name : String(e))) } }
interface Bare { held: unknown }
interface BareClass { new (value: unknown): Bare }
const plain = function (this: any, value: unknown) { this.held = value } as unknown as BareClass;
const build = (constructor: BareClass, value: unknown): Bare => new constructor(value);
row("handed over", () => build(plain, 1).held);
row("out of a list", () => [plain].map(each => new each(2).held).join());
//// new-of-a-function-cast-to-a-class-type.ts
// `new` of a function that a constant holds under a cast to a type with a construct signature: what plain JavaScript does, whatever the function is expected to be.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name : String(e))) } }
interface Held { held: unknown; describe(): string }
interface HeldClass { new (value: unknown): Held; prototype: object }
interface Bare { held: unknown }
interface BareClass { new (value: unknown): Bare; prototype: object }
const make = (label: string): ((value: unknown) => Held) => {
  const Proto = { describe(this: Held): string { return label + "(" + String(this.held) + ")" } };
  const Impl = function (this: any, value: unknown) { this.held = value } as unknown as HeldClass;
  Impl.prototype = Proto;
  return function (value: unknown) { return new Impl(value) };
};
const first = make("first"), second = make("second");
row("made", () => first(1).describe() + " " + second("two").describe());
row("own and inherited", () => { const made = first(1); return Object.keys(made).join() + " " + ("describe" in made) + " " + Object.prototype.hasOwnProperty.call(made, "describe") });
row("each has its own prototype", () => Object.getPrototypeOf(first(1)) !== Object.getPrototypeOf(second(1)));
row("many", () => { let text = ""; for (let i = 0; i < 5; i++) text += first(i).describe(); return text });
const returning = function (this: any, value: unknown) { this.held = value; return { held: "another", describe: () => "returned" } } as unknown as HeldClass;
row("a constructor that returns an object", () => new returning(1).describe());
const primitive = function (this: any, value: unknown) { this.held = value; return 5 } as unknown as HeldClass;
primitive.prototype = { describe(this: Held) { return "kept " + String(this.held) } };
row("a constructor that returns a number", () => new primitive(1).describe());
const arrow = ((value: unknown) => ({ held: value })) as unknown as BareClass;
row("an arrow function is no constructor", () => new arrow(1).held);
const late = function (this: any, value: unknown) { this.held = value } as unknown as HeldClass;
row("the prototype is read at each call", () => { late.prototype = { describe: () => "one" }; const one = new late(0).describe(); late.prototype = { describe: () => "two" }; return one + " " + new late(0).describe() });
const bare = function (this: any, value: unknown) { this.held = value } as unknown as BareClass;
row("a prototype that is no object", () => { (bare as { prototype: unknown }).prototype = 5; return Object.getPrototypeOf(new bare(0)) === Object.prototype });
//// new-of-a-function-whose-this-names-no-record.ts
// `new` of a plain function that a constant holds under a cast to a type with a construct signature. What it makes has the function's own prototype object and satisfies the type the signature names: it is not refused.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name : String(e))) } }
interface Bare { held: number }
interface BareClass { new (value: number): Bare; prototype: object }
const plain = function (this: any, value: number) { this.held = value } as unknown as BareClass;
row("read at once", () => new plain(1).held + 1);
row("held by a constant", () => { const made: Bare = new plain(2); return made.held + 1 });
row("handed on", () => { const twice = (bare: Bare): number => bare.held * 2; return twice(new plain(3)) });
row("its prototype is the function's", () => Object.getPrototypeOf(new plain(4)) === plain.prototype);
row("instanceof", () => (new plain(5) as object) instanceof (plain as unknown as Function));
row("constructor", () => (new plain(6) as unknown as { constructor: unknown }).constructor === plain);
row("keys", () => Object.keys(new plain(7)).join());
row("beside a literal of the same type", () => { const list: Bare[] = [new plain(8), { held: 9 }]; return list.map(each => each.held).join() });
row("stored to", () => { const made = new plain(10); made.held += 1; return made.held });
row("copied", () => { const copy: Bare = { ...new plain(11) }; return copy.held + " " + (Object.getPrototypeOf(copy) === Object.prototype) });
const untyped = function (this: any) { this.other = 1 } as unknown as { new (): object };
row("a signature that names object", () => Object.keys(new untyped()).join());
interface Typed { held: number }
const typed = function (this: Typed, value: number) { this.held = value } as unknown as { new (value: number): Typed };
row("a function whose this names the record", () => new typed(12).held + 1);
row("and its prototype", () => Object.getPrototypeOf(new typed(13)) === (typed as unknown as { prototype: object }).prototype);
