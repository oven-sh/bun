const counts = [0, -0, 1, -1, 2 ** 29, 2 ** 30 - 1, 2 ** 30, -(2 ** 30), -(2 ** 30) - 1, 2 ** 31 - 1, -(2 ** 31), 2 ** 31, 2 ** 32, 0.5, -1.5, NaN, Infinity, 1e300];
