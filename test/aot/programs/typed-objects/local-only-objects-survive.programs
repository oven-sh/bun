// `new` of a plain function that a constant holds under a cast to a type with a construct signature. What it makes has the function's own prototype object and satisfies the type the signature names: it is not refused.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name : String(e))) } }
interface Bare { held: unknown }
interface BareClass { new (value: unknown): Bare; prototype: object }
const plain = function (this: any, value: unknown) { this.held = value } as unknown as BareClass;
row("read at once", () => new plain(1).held);
row("held by a constant", () => { const made: Bare = new plain(2); return made.held });
//// new-of-functions-with-their-own-prototype-objects.ts
// `new` of plain functions, cast to a type with a construct signature, that keep the prototype object they were born with: new.target, and a variable that holds one function and then another.
declare const console: { log(...values: unknown[]): void };
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name : String(e))) } }
interface Bare { held: unknown }
interface BareClass { new (value: unknown): Bare; prototype: object }
const target = function (this: any) { this.held = (new.target as unknown) === target } as unknown as BareClass;
row("new.target", () => new target(0).held);
let changing = function (this: any, value: unknown) { this.held = "before" } as unknown as BareClass;
row("a variable that changes, before", () => new changing(0).held);
changing = function (this: any, value: unknown) { this.held = "after" } as unknown as BareClass;
row("and after", () => new changing(0).held);
//// new-properties-on-builtins-and-functions.ts
// Adding properties to `Math`, to `Object` and to a built-in function is allowed: none of them is always locked, and a program that writes them sees its write.
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name + ":" + (e as Error).message } }
console.log(attempt(() => { (Math as any).poop = 1; return (Math as any).poop }))
console.log(attempt(() => { (Math.floor as any).poop = 1; return (Math.floor as any).poop }))
console.log(attempt(() => { (Object as any).poop = 1; return (Object as any).poop }))
console.log(["Math", "Math.floor", "Object"].join(), [Math, Math.floor, Object].map(o => Object.isExtensible(o)).join())
//// new-property-on-builtin.ts
// `Math` accepts a new property: it is not always locked, and a program that writes it sees its write.
interface Rec { n: number; o?: number }
function fresh(): Rec { return { n: 1 } }
function show(label: string, f: () => unknown) {
  try { console.log(label, String(f())) } catch (e) { console.log(label, (e as Error).message) }
}
show("e5", () => fresh().o)
show("math", () => { (Math as any).o7 = 12; return (Math as any).o7 })
//// new-target-prototype-changes-between-constructions/core.ts
export class Core {
  declare late?: unknown;
  declare more?: number;
  count = 0;
  label: string | undefined = undefined;
  list: number[] | undefined;
  constructor(count?: number) {
    if (count !== undefined) this.count = count;
  }
  describe(): string {
    return this.count + " " + String(this.label) + " " + String(this.list) + " " + String(this.late) + " " + String(this.more);
  }
  ownLate(): unknown {
    return this.late;
  }
  hasLate(): boolean {
    return "late" in this;
  }
  setLate(value: unknown): void {
    this.late = value;
  }
}
export class OtherBase {
  declare late?: unknown;
  other = "of the other base";
  count = -1;
  constructor(count?: number) {
    if (count !== undefined) this.count = -count;
  }
  describe(): string {
    return "other " + this.count + " " + String(this.late);
  }
  ownLate(): unknown {
    return this.late;
  }
  hasLate(): boolean {
    return "late" in this;
  }
  setLate(value: unknown): void {
    this.late = value;
  }
}
export class Small {
  declare late?: unknown;
  count = 0;
  constructor(count?: number) {
    if (count !== undefined) this.count = count;
  }
  describe(): string {
    return "small " + this.count + " " + String(this.late);
  }
  ownLate(): unknown {
    return this.late;
  }
  hasLate(): boolean {
    return "late" in this;
  }
  setLate(value: unknown): void {
    this.late = value;
  }
}
