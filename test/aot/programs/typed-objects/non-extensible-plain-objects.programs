//// object-assign-goes-through-a-misfit.ts
// `Object.assign(this, given)` goes through all of `given`, as in plain Bun: any object is stored into a field of a class type, whatever its own fields hold, and what comes after it is stored too.
////= Tree
class Holder {
  first = "f";
  held!: Tree;
  name!: string;
  last?: Tree;
  takeAny(given: any) {
    Object.assign(this, given);
  }
}
const misfits: [string, any][] = [
  ["an object whose depth is a string, between two texts", { first: "stored", held: { depth: "deep" }, name: "stored too" }],
  ["a native object, before a text", { held: new Map(), name: "stored too" }],
  ["an object that fits, then one whose depth is null", { held: { depth: 5 }, last: { depth: null }, name: "stored too" }],
  ["two that fit", { held: { depth: 6 }, last: { depth: 7 }, name: "stored" }],
];
for (const [name, given] of misfits) {
  const holder = new Holder();
  for (let i = 0; i < 3; i++) holder.takeAny({ held: new Tree(i), name: "n" });
  let thrown = "nothing";
  try {
    holder.takeAny(given);
  } catch (error) {
    thrown = (error as Error).constructor.name;
  }
  console.log(name + ": " + JSON.stringify([thrown, holder.first, holder.held, holder.name, holder.last, Object.keys(holder).join()]));
}
//// object-assign-of-misfits-onto-this.ts
// `Object.assign(this, given)` stores whatever it is given, as in plain Bun. A field that holds a primitive of another kind afterwards throws a TypeError at its next typed read; any object passes for a field of a class type.
////= Tree
////= Holder
////= say
const misfits: [string, any][] = [
  ["a number for a Tree", { held: 5 }],
  ["a number for a string", { name: 7 }],
  ["an object whose depth is a string", { held: { depth: "deep" } }],
  ["an object that has what a Tree has", { held: { depth: 3 } }],
  ["a Map", { held: new Map() }],
  ["an array", { held: [1] }],
  ["a function", { held: () => 1 }],
  ["a fit before a misfit", { name: "stored", held: 5 }],
];
for (const [name, given] of misfits) {
  say(name, () => {
    const holder: Holder = new Holder();
    for (let i = 0; i < 3; i++) holder.takeAny({ held: new Tree(i), name: "n" });
    try {
      holder.takeAny(given);
    } catch (error) {
      return [(error as Error).constructor.name, holder.held, holder.name, Object.keys(holder).join()];
    }
    return [holder.held, holder.name, Object.keys(holder).join()];
  });
}
//// object-assign-of-nothing-and-booleans-onto-optional-fields.ts
function say(name: string, f: () => unknown) {
  let text: string;
  try {
    text = JSON.stringify(f(), (_, value) => (value === undefined ? "<undefined>" : value)) ?? "undefined";
  } catch (error) {
    text = "throws " + (error as Error).constructor.name;
  }
  console.log(name + ": " + text);
}

type Options = { a: number; text?: string | null; flag?: boolean | null; list?: number[] | null; on?: boolean; name?: string };

////= merge	Options
function show(options: Options) {
  return [Object.keys(options).join(), options.text, options.flag, options.list, options.on, options.name, "flag" in options, "text" in options];
}

const nothings: any[] = [
  { text: undefined, flag: undefined, list: undefined },
  { text: null, flag: null, list: null },
  { flag: true, on: false },
  { flag: false, on: true, text: "t" },
  { on: undefined, name: undefined },
  { list: [1], flag: null, text: undefined },
];
for (const from of nothings) {
  say("onto an object without them " + JSON.stringify(Object.keys(from)), () => show(merge({ a: 1 }, from)));
  say("onto an object that has them", () => show(merge({ a: 1, text: "old", flag: true, list: [9], on: true, name: "n" }, from)));
  say("onto an object that holds nothing in them", () => show(merge({ a: 1, text: null, flag: null, list: undefined, on: undefined, name: undefined }, from)));
}
say("one after another onto one object", () => {
  const made: Options = { a: 1 };
  return nothings.map(from => show(merge(made, from)));
});
say("many, in turn", () => {
  const seen: Record<string, number> = {};
  for (let i = 0; i < 6000; i++) {
    const made = merge(i & 8 ? { a: i, flag: false, text: "x" } : { a: i }, nothings[i % nothings.length]);
    const key = Object.keys(made).join() + "|" + made.flag + "|" + made.text + "|" + made.on;
    seen[key] = (seen[key] ?? 0) + 1;
  }
  return seen;
});
say("deleted, then given nothing", () => {
  const made = merge({ a: 1, flag: true, text: "x" }, {});
  delete made.flag;
  delete made.text;
  return [show(made), show(merge(made, { flag: undefined, text: null }))];
});
say("kept over collections", () => {
  const kept: Options[] = [];
  for (let i = 0; i < 30000; i++) {
    const made = merge({ a: i }, i & 1 ? { text: "s" + i, flag: null } : { text: null, flag: true, list: [i] });
    if (i % 5000 < 2) kept.push(made);
  }
  return kept.map(show);
});
//// object-assign-of-numbers-onto-optional-fields.ts
function say(name: string, f: () => unknown) {
  let text: string;
  try {
    text = JSON.stringify(f(), (_, value) => (value === undefined ? "<undefined>" : typeof value === "number" && !Number.isFinite(value) ? String(value) : Object.is(value, -0) ? "-0" : value)) ?? "undefined";
  } catch (error) {
    text = "throws " + (error as Error).constructor.name;
  }
  console.log(name + ": " + text);
}

type Sizes = { a: number; width?: number; ratio?: number | null; count?: number };

////= merge	Sizes
function area(sizes: Sizes): number {
  return (sizes.width ?? 1) * 0.5 + (sizes.ratio ?? 2) * 1.5 + sizes.a;
}
function nameOf(sizes: Sizes): string {
  return ["zero", "one", "two", "three"][sizes.count ?? 0] ?? "many";
}
function show(sizes: Sizes) {
  return [Object.keys(sizes).join(), sizes.width, sizes.ratio, sizes.count, area(sizes), nameOf(sizes)];
}

const numbers = [0, 1, -1, 0.5, -0, NaN, Infinity, -Infinity, 2 ** 31, -(2 ** 31) - 1, 2 ** 53, 1e300, 5e-324];
say("every kind of number into absent fields", () => numbers.map(n => show(merge({ a: 1 }, { width: n, ratio: n, count: 2 }))));
say("every kind of number over numbers", () => numbers.map(n => show(merge({ a: 1, width: 3, ratio: 4, count: 1 }, { ratio: n, width: n }))));
say("nothing into absent fields", () => [show(merge({ a: 1 }, { width: undefined, ratio: null })), show(merge({ a: 1 }, { ratio: undefined, count: undefined }))]);
say("nothing over numbers, numbers over nothing", () => {
  const made = merge({ a: 1, width: 3, ratio: 4 }, { width: undefined, ratio: null });
  return [show(made), show(merge(made, { width: 7.5, ratio: 8 }))];
});
say("the order of the keys is the order of creation", () => [show(merge({ a: 1 }, { ratio: 1, width: 2 })), show(merge({ a: 1 }, { count: 1, width: 2, ratio: 3 }))]);
say("deleted, then assigned", () => {
  const made = merge({ a: 1, width: 3, ratio: 4 }, {});
  delete made.width;
  return [show(made), show(merge(made, { width: 9.25 }))];
});
say("what is no number", () => {
  const results: unknown[] = [];
  for (const width of ["3", true, {}, 3n]) {
    try {
      results.push(typeof merge({ a: 1 }, { width }).width);
    } catch (error) {
      results.push((error as Error).constructor.name);
    }
  }
  return results.length;
});
say("many, in turn", () => {
  let total = 0;
  const sources: any[] = [{ width: 1.5 }, { ratio: 2, width: 3 }, { count: 3, ratio: 0.25 }, { width: undefined }, { a: 4.5, ratio: null }];
  for (let i = 0; i < 5000; i++) {
    const made = merge(i & 8 ? { a: i, width: i } : { a: i }, sources[i % sources.length]);
    total += area(made) + Object.keys(made).length + nameOf(made).length;
  }
  return total;
});
//// object-assign-of-objects-onto-this.ts
////= say

////= Tree
////= lines-3	TallTree	Tree	height	100
type Caches = { byId: Record<string, number>; byPath: Record<string, number>; tree: Tree; paths: Map<string, string> };

class Router {
  key: string | undefined = "k";
  count = 0;
  options!: { a: number };
  origin!: string;
  byId!: Record<string, number>;
  byPath!: Record<string, number>;
  tree!: Tree;
  paths!: Map<string, string>;
  light!: WeakMap<object, number>;
  rewrite?: { from: string };
  list?: string[];
  run?: () => number;
  constructor(options: { a: number }) {
    this.options = options;
    this.origin = "x";
  }
  setRoutes(caches: Caches) {
    Object.assign(this, caches);
  }
  take(given: Partial<Router>) {
    Object.assign(this, given);
  }
  takeAny(given: any) {
    Object.assign(this, given);
  }
  takeTwo(first: Partial<Router>, second: Partial<Router>) {
    return Object.assign(this, first, second) === this;
  }
}

function show(router: Router) {
  return [Object.keys(router).join(), router.byId, router.byPath, router.tree, router.paths instanceof Map ? [...router.paths] : router.paths, router.origin, router.count];
}

const caches: Caches = { byId: { a: 1 }, byPath: { b: 2 }, tree: new Tree(3), paths: new Map([["p", "q"]]) };

say("a record of objects", () => {
  const router = new Router({ a: 1 });
  router.setRoutes(caches);
  return [show(router), router.tree === caches.tree, router.paths === caches.paths, router.byId === caches.byId];
});
say("many times, with trees of two classes", () => {
  let total = 0;
  const tall: Caches = { byId: { a: 2 }, byPath: {}, tree: new TallTree(5), paths: new Map() };
  for (let i = 0; i < 2000; i++) {
    const router = new Router({ a: i });
    router.setRoutes(i % 3 ? caches : tall);
    total += router.tree.depth + router.byId.a + (router.tree instanceof TallTree ? router.tree.height : 0);
  }
  return total;
});
say("over values that are there", () => {
  const router = new Router({ a: 1 });
  router.setRoutes(caches);
  router.setRoutes({ byId: { z: 26 }, byPath: { y: 25 }, tree: new TallTree(9), paths: new Map() });
  return show(router);
});
say("data from outside", () => {
  const router = new Router({ a: 1 });
  router.takeAny(JSON.parse('{"byId":{"a":1},"byPath":{"b":2},"origin":"o","count":7}'));
  return show(router);
});
say("optional fields come to be in the order of the source", () => {
  const router = new Router({ a: 1 });
  router.take({ run: () => 4, list: ["l"], rewrite: { from: "f" } });
  return [Object.keys(router).join(), router.run!(), router.list, router.rewrite];
});
say("two sources", () => {
  const router = new Router({ a: 1 });
  return [router.takeTwo({ origin: "first", list: ["a"] }, { origin: "second", tree: new Tree(1) }), show(router), router.list];
});
say("undefined and null for objects", () => {
  const router = new Router({ a: 1 });
  router.setRoutes(caches);
  router.takeAny({ tree: undefined, paths: null, rewrite: undefined });
  return [Object.keys(router).join(), router.tree === undefined, router.paths === null, "rewrite" in router];
});
say("names that are not declared", () => {
  const router = new Router({ a: 1 });
  router.takeAny({ extra: { e: 1 }, tree: new Tree(2), another: [1, 2] });
  return [Object.keys(router).join(), (router as any).extra, (router as any).another, router.tree];
});
say("a getter of the source runs once, in its turn, and may change the target", () => {
  const router = new Router({ a: 1 });
  const seen: string[] = [];
  const source = {
    get byId() {
      seen.push("byId:" + router.origin);
      router.origin = "changed";
      return { g: 1 };
    },
    origin: "from the source",
    get tree() {
      seen.push("tree:" + router.origin);
      return new Tree(8);
    },
  };
  router.takeAny(source);
  return [seen, router.byId, router.origin, router.tree];
});
say("what is not enumerable, inherited, or keyed by a symbol", () => {
  const router = new Router({ a: 1 });
  const mark = Symbol("mark");
  const source = Object.create({ origin: "inherited" });
  Object.defineProperty(source, "tree", { value: new Tree(1), enumerable: false });
  source.byId = { own: 1 };
  source[mark] = { s: 1 };
  router.takeAny(source);
  return [router.origin, router.tree === undefined, router.byId, (router as any)[mark], Object.getOwnPropertySymbols(router).length];
});
say("a Proxy as the source", () => {
  const router = new Router({ a: 1 });
  const seen: string[] = [];
  router.takeAny(
    new Proxy(
      { tree: new Tree(6), origin: "p" },
      {
        ownKeys(target) {
          seen.push("ownKeys");
          return Reflect.ownKeys(target);
        },
        getOwnPropertyDescriptor(target, key) {
          seen.push("describe " + String(key));
          return Reflect.getOwnPropertyDescriptor(target, key);
        },
        get(target, key, receiver) {
          seen.push("get " + String(key));
          return Reflect.get(target, key, receiver);
        },
      },
    ),
  );
  return [seen, router.tree, router.origin];
});
say("a frozen target", () => {
  const router = new Router({ a: 1 });
  router.setRoutes(caches);
  Object.freeze(router);
  try {
    router.setRoutes({ byId: {}, byPath: {}, tree: new Tree(0), paths: new Map() });
  } catch (error) {
    return [(error as Error).constructor.name, show(router)];
  }
  return "no error";
});
say("a sealed target takes what it has and refuses what it lacks", () => {
  const router = new Router({ a: 1 });
  Object.seal(router);
  router.setRoutes(caches);
  try {
    router.take({ tree: new Tree(7), rewrite: { from: "r" } });
  } catch (error) {
    return [(error as Error).constructor.name, show(router)];
  }
  return ["no error", show(router)];
});
say("the target itself, nothing, and primitives", () => {
  const router = new Router({ a: 1 });
  router.setRoutes(caches);
  router.takeAny(router);
  router.takeAny(undefined);
  router.takeAny(null);
  router.takeAny(5);
  router.takeAny("ab");
  return [Object.keys(router).join(), (router as any)[0], (router as any)[1], router.tree];
});

class WithSetter {
  seen: string[] = [];
  plain!: Tree;
  set tree(value: Tree) {
    this.seen.push("set " + value.depth);
  }
  get tree(): Tree {
    return new Tree(-1);
  }
  take(given: { tree: Tree; plain: Tree }) {
    Object.assign(this, given);
  }
}
say("a setter of the class is called", () => {
  const target = new WithSetter();
  target.take({ tree: new Tree(4), plain: new Tree(5) });
  return [target.seen, target.plain, Object.keys(target).join(), target.tree];
});

////= Holder
say("after many that fit, some that are of another kind", () => {
  const holder = new Holder();
  const results: unknown[] = [];
  for (let i = 0; i < 50; i++) holder.takeAny({ held: new Tree(i), name: "n" + i });
  results.push(holder.held.depth, holder.name);
  for (const other of [{ held: new TallTree(1), name: "tall" }, { held: new Tree(2), name: "again" }]) {
    holder.takeAny(other);
    results.push(holder.held.depth, holder.held instanceof TallTree, holder.name);
  }
  return results;
});
say("kept over collections", () => {
  const kept: Router[] = [];
  for (let i = 0; i < 30000; i++) {
    const router = new Router({ a: i });
    router.setRoutes({ byId: { i }, byPath: { i }, tree: i & 1 ? new Tree(i) : new TallTree(i), paths: new Map([["i", String(i)]]) });
    if (i % 5000 === 0) kept.push(router);
  }
  return kept.map((router) => [router.byId.i, router.tree.depth, router.paths.get("i"), router.options.a]);
});
//// object-assign-of-outside-objects-that-are-converted.ts
////= say

type Point = { x: number; y: number };
type Options = { a: number; at: Point; name: string; to?: Point; list: Point[] };

////= merge	Options
function fresh(): Options {
  return { a: 1, at: { x: 0, y: 0 }, name: "n", list: [] };
}
function length(point: Point): number {
  return point.x * point.x + point.y * point.y;
}

say("an object from outside among plain values", () => {
  const made = merge(fresh(), JSON.parse('{"a":2,"at":{"x":3,"y":4},"name":"m"}'));
  return [made, length(made.at), Object.keys(made).join()];
});
say("it is the same object afterwards", () => {
  const given: any = { at: { x: 1, y: 2 }, name: "same" };
  const made = merge(fresh(), given);
  given.at.x = 10;
  return [made.at === given.at, made.at.x, length(made.at)];
});
say("the keys of the object from outside keep their order", () => {
  const made = merge(fresh(), { at: { y: 2, x: 1 } });
  return [Object.keys(made.at).join(), length(made.at)];
});
say("more than its type names", () => {
  const made = merge(fresh(), { at: { x: 1, y: 2, z: 3 }, a: 9 });
  return [made, Object.keys(made.at).join(), (made.at as any).z];
});
say("an optional field that is absent", () => {
  const made = merge(fresh(), { to: { x: 5, y: 6 }, a: 3 });
  return [Object.keys(made).join(), made.to, length(made.to!)];
});
say("arrays of objects from outside", () => {
  const made = merge(fresh(), JSON.parse('{"list":[{"x":1,"y":1},{"x":2,"y":2}],"a":4}'));
  return [made.list, made.list.map(length), made.a];
});
say("many, in turn with objects of the program", () => {
  let total = 0;
  for (let i = 0; i < 3000; i++) {
    const at: Point = { x: i, y: 1 };
    const made = merge(fresh(), i & 1 ? { a: i, at, name: "t" } : JSON.parse('{"a":1,"at":{"x":2,"y":3},"name":"outside"}'));
    total += length(made.at) + made.a + made.name.length;
  }
  return total;
});
say("what stands behind it is stored too", () => {
  const made = merge(fresh(), { at: { x: 7, y: 8 }, name: "behind", a: 11 });
  return made;
});
//// object-assign-onto-records-and-from-literals.ts
// Object.assign where the target is a record (an object literal of a declared type), which may have become an ordinary object or have come from outside, and where the source is a literal whose fields are kept otherwise than the target's: small integers, fractions, constant strings, booleans, undefined and null.
const lines: string[] = [];
////= say-2
const own = (object: object) => Reflect.ownKeys(object).map(String).join();

type Settings = { port: number; host: string; secure: boolean; ratio: number; name: string | undefined; limit: number | null };
const defaults = (): Settings => ({ port: 80, host: "localhost", secure: false, ratio: 0.5, name: undefined, limit: null });
class Server {
  port = 80;
  host = "localhost";
  secure = false;
  ratio = 0.5;
  name: string | undefined = undefined;
  limit: number | null = null;
}

function configure(settings: Settings, values: { port: number; host: string }) {
  return Object.assign(settings, values);
}
function show(settings: Settings | Server) {
  return [own(settings), settings.port, settings.host, settings.secure, settings.ratio, settings.name === undefined ? "undefined" : settings.name, settings.limit];
}

for (let turn = 0; turn < 4; turn++) {
  say("a record from a record " + turn, () => show(configure(defaults(), { port: 8000 + turn, host: "h" + turn })));
  say("a record from a literal of constants " + turn, () => show(Object.assign(defaults(), { port: 443, host: "example.com", secure: true, ratio: 2, name: "n", limit: 7 })));
  say("an instance from a literal of constants " + turn, () => show(Object.assign(new Server(), { port: 443, host: "example.com", secure: true, ratio: 2, name: "n", limit: 7 })));
  say("an instance from a literal of values " + turn, () => show(Object.assign(new Server(), { port: turn, host: "host" + turn, secure: turn % 2 === 0, ratio: turn / 4, name: turn ? "n" + turn : undefined, limit: turn ? turn : null })));
  say("fractions and large numbers into a number field " + turn, () => show(Object.assign(new Server(), { port: turn + 0.5, ratio: 2 ** 40 + turn, limit: -(2 ** 31) - turn })));
  say("undefined and null " + turn, () => {
    const server = Object.assign(new Server(), { name: "set", limit: 1 });
    return show(Object.assign(server, { name: undefined, limit: null }));
  });
}
say("a record that came from outside", () => {
  const seen: unknown[] = [];
  for (let turn = 0; turn < 3; turn++) {
    const parsed: Settings = JSON.parse(`{"port":1,"host":"outside","secure":true,"ratio":1,"limit":null,"more":${turn}}`);
    seen.push(show(configure(parsed, { port: 2 + turn, host: "assigned" })));
  }
  return seen;
});
say("a record that lost a property, got an accessor, was frozen", () => {
  const seen: unknown[] = [];
  const lost = defaults();
  delete (lost as any).host;
  seen.push(show(configure(lost, { port: 1, host: "back" })));
  const watched = defaults();
  let log = "";
  Object.defineProperty(watched, "port", { set(value) { log += "port=" + value + ";"; }, get() { return -1; }, enumerable: true, configurable: true });
  seen.push(show(configure(watched, { port: 2, host: "watched" })), log);
  const frozen = Object.freeze(defaults());
  try {
    configure(frozen, { port: 3, host: "frozen" });
  } catch (error) {
    seen.push((error as Error).constructor.name);
  }
  seen.push(show(frozen));
  return seen;
});
say("a record with one property more, as target and as source", () => {
  const wide = Object.assign(defaults(), { extra: "kept" });
  configure(wide, { port: 5, host: "wide" });
  const target = defaults();
  Object.assign(target, wide);
  return [show(wide), show(target), (target as any).extra];
});
say("a record under another prototype", () => {
  const seen: unknown[] = [];
  let log = "";
  const base = { set host(value: string) { log += "host=" + value + ";"; }, get host() { return "from the prototype"; } };
  for (let turn = 0; turn < 2; turn++) {
    const settings = defaults();
    Object.setPrototypeOf(settings, base);
    seen.push(show(configure(settings, { port: turn, host: "own" })));
    delete (settings as any).host;
    seen.push(show(configure(settings, { port: turn, host: "through the setter" })));
  }
  return [seen, log];
});
say("one place, instances and records in turn", () => {
  const seen: unknown[] = [];
  const set = (target: { port: number; host: string }, port: number) => Object.assign(target, { port, host: "p" + port });
  for (let turn = 0; turn < 6; turn++) seen.push(own(set(turn % 3 === 0 ? new Server() : turn % 3 === 1 ? defaults() : { port: 0, host: "" }, turn)) + ":" + turn);
  return seen;
});
say("many objects, so that collections fall between the calls", () => {
  let sum = 0;
  for (let i = 0; i < 30000; i++) {
    const settings = Object.assign(defaults(), { port: i, host: "h" + (i & 7), secure: (i & 1) === 0, ratio: i / 3, name: i & 3 ? "n" + i : undefined, limit: i & 1 ? i : null });
    const server = Object.assign(new Server(), settings);
    sum += server.port + server.host.length + (server.secure ? 1 : 0) + Math.floor(server.ratio) + (server.name ? server.name.length : 0) + (server.limit ?? 0);
  }
  return sum;
});

console.log(lines.join("\n"));
//// object-assign-onto-typed-instances.ts
// Object.assign onto an instance of a typed class: its declared fields and names the class does not declare, from typed literals and from data that came from outside. Every store is a [[Set]]: a setter on the prototype chain runs, a frozen target throws, key order is the order of creation, and the chain may change between two calls.
const lines: string[] = [];
////= say-2
const own = (object: object) => Reflect.ownKeys(object).map(String).join();
const outside = (text: string): any => JSON.parse(text);

class Holder {
  a = 0;
  b = 0.5;
  c = "c";
  d = false;
  e: string | undefined = undefined;
  f: number | null = null;
  get doubled() {
    return this.a * 2;
  }
  method() {
    return "method of " + this.c;
  }
}
////= lines-3	Derived	Holder	g	7
class WithSetter {
  first = 1;
  seen = "";
  set watched(value: number) {
    this.seen += "<" + value + ":" + own(this) + ">";
  }
}
class WithObjects {
  list: number[] = [];
  inner: { x: number } = { x: 0 };
  call: () => string = () => "original";
  any: unknown = 0;
}
////= lines-11	Changing	first	1
class Optional {
  always = 1;
  sometimes?: number;
  later?: string;
}

const typedSources = [
  { a: 1, b: 2, c: "x", d: true },
  { a: 5, b: 6.25, c: "y", d: false },
];
const otherSources = [
  { p: 1, q: "two", r: [3], s: null },
  { p: 5, q: "six", r: [7], s: null },
];

for (let turn = 0; turn < 5; turn++) {
  say("declared fields from a typed literal " + turn, () => {
    const h = new Holder();
    const result = Object.assign(h, typedSources[turn & 1]);
    return [result === h, own(h), h.a, h.b, h.c, h.d, h.e, h.f, h.doubled, h.method()];
  });
  say("declared fields from outside " + turn, () => {
    const h = new Holder();
    Object.assign(h, outside(`{"d":true,"c":"from outside ${turn}","b":${turn}.5,"a":${turn}}`));
    return [own(h), h.a, h.b, h.c, h.d, h.doubled];
  });
  say("on a derived class " + turn, () => {
    const h = new Derived();
    Object.assign(h, typedSources[turn & 1], { g: turn });
    return [own(h), h.a, h.g, h.doubled];
  });
  say("other names from a typed literal " + turn, () => {
    const h = Object.assign(new Holder(), otherSources[turn & 1]);
    return [own(h), h.p, h.q, h.r, h.s, h.a, JSON.stringify(h)];
  });
  say("other names from outside " + turn, () => {
    const h: any = Object.assign(new Holder(), outside(`{"z":${turn},"y":"y","x":{"deep":[${turn}]}}`));
    return [own(h), h.z, h.y, h.x, h.a];
  });
  say("both kinds, interleaved " + turn, () => {
    const h: any = Object.assign(new Holder(), outside(`{"z":1,"a":${turn},"y":2,"c":"both","x":3}`));
    return [own(h), h.z, h.a, h.y, h.c, h.x];
  });
  say("twice: the second replaces and adds " + turn, () => {
    const h: any = new Holder();
    Object.assign(h, otherSources[0]);
    Object.assign(h, otherSources[1], outside(`{"q":"again","t":${turn},"a":9}`));
    return [own(h), h.p, h.q, h.r, h.t, h.a];
  });
  say("many other names " + turn, () => {
    const source: Record<string, number> = {};
    for (let i = 0; i < 14; i++) source["n" + i] = i * (turn + 1);
    const h: any = Object.assign(new Holder(), source);
    Object.assign(h, { n3: -3, more: turn });
    return [own(h), h.n0, h.n3, h.n7, h.n13, h.more];
  });
}

say("numbers that do not fit 31 bits", () => {
  const h = new Holder();
  const seen: unknown[] = [];
  for (const a of [1073741823, 1073741824, -1073741824, -1073741825, 2147483648, 1e21, 0.1, -0, NaN, Infinity, 3]) {
    Object.assign(h, { a });
    seen.push(Object.is(h.a, -0) ? "-0" : String(h.a));
    Object.assign(h, outside(`{"b":${Number.isFinite(a) ? a : 0}}`));
    seen.push(String(h.b));
  }
  return seen;
});
say("undefined and null where the type allows them", () => {
  const h = new Holder();
  Object.assign(h, { e: "set", f: 4 });
  const before = [h.e, h.f];
  Object.assign(h, { e: undefined, f: null });
  return [before, h.e === undefined, h.f, own(h)];
});
say("objects into fields", () => {
  const w = new WithObjects();
  const list = [1, 2];
  const inner = { x: 5 };
  const call = () => "replaced";
  Object.assign(w, { list, inner, call, any: { free: true } });
  return [w.list === list, w.inner.x, w.call(), w.any, own(w)];
});
say("objects into fields, from outside", () => {
  const w = new WithObjects();
  Object.assign(w, outside(`{"list":[4,5],"inner":{"x":6},"any":[1]}`));
  return [w.list, w.inner.x, w.call(), w.any, own(w)];
});
say("from one instance to another", () => {
  const from = new WithObjects();
  from.list = [9];
  from.inner = { x: 9 };
  from.any = "any";
  const to = new WithObjects();
  Object.assign(to, from);
  return [to.list === from.list, to.inner === from.inner, to.call === from.call, to.any];
});
say("optional fields: absent in the source, absent in the target", () => {
  const seen: unknown[] = [];
  const sources: Partial<Optional>[] = [{}, { sometimes: 1 }, { later: "l", sometimes: 2 }, { always: 3 }];
  for (const source of sources) {
    const o = new Optional();
    Object.assign(o, source);
    seen.push([own(o), o.always, o.sometimes, o.later]);
    Object.assign(o, source, { later: "last" });
    seen.push([own(o), o.later]);
  }
  return seen;
});
say("a setter of the class runs in its turn", () => {
  const seen: unknown[] = [];
  for (let turn = 0; turn < 3; turn++) {
    const w: any = new WithSetter();
    Object.assign(w, outside(`{"before":1,"first":${turn},"watched":${turn},"after":2}`));
    seen.push([own(w), w.first, w.seen]);
  }
  return seen;
});
say("a getter of the source runs in its turn and may change the source", () => {
  const h: any = new Holder();
  const source: any = { a: 1, get c() { delete this.z; this.d = true; return "got"; }, z: 1, d: false };
  Object.assign(h, source);
  return [own(h), h.a, h.c, h.d, "z" in h];
});
say("what is not enumerable, and symbols", () => {
  const tag = Symbol("tag");
  const source: any = { a: 3, [tag]: "tagged", k: 1 };
  Object.defineProperty(source, "hidden", { value: 1, enumerable: false });
  Object.defineProperty(source, "c", { value: "hidden too", enumerable: false });
  const h: any = Object.assign(new Holder(), source);
  return [own(h), h.a, h.c, h[tag], h.k, h.hidden];
});
say("index keys, Symbol.isConcatSpreadable", () => {
  const h: any = Object.assign(new Holder(), outside(`{"1":"one","x":1,"0":"zero"}`));
  const spread: any = Object.assign(new Holder(), { [Symbol.isConcatSpreadable]: true, length: 1, 0: "spread" });
  return [own(h), h[0], h[1], h.x, [0].concat(spread)];
});
say("__proto__ as an own key of the source", () => {
  const h: any = Object.assign(new Changing(), outside(`{"x":1,"__proto__":{"stolen":true}}`));
  return [own(h), h.x, h.stolen, h instanceof Changing];
});
say("a getter without a setter throws, and what came before stays", () => {
  const h: any = new Holder();
  let thrown = "";
  try {
    Object.assign(h, outside(`{"a":4,"early":1,"doubled":1,"late":1,"c":"never"}`));
  } catch (error) {
    thrown = (error as Error).constructor.name;
  }
  return [thrown, own(h), h.a, h.c];
});
const closings: [string, <T>(object: T) => T][] = [["frozen", object => Object.freeze(object)], ["sealed", object => Object.seal(object)], ["not extensible", object => Object.preventExtensions(object)]];
for (const [name, close] of closings) {
  say(name + ": declared fields", () => {
    const h = close(new Holder());
    Object.assign(h, typedSources[0]);
    return [own(h), h.a];
  });
  say(name + ": other names", () => {
    const h: any = close(new Holder());
    let thrown = "";
    try {
      Object.assign(h, outside(`{"a":2,"other":1}`));
    } catch (error) {
      thrown = (error as Error).constructor.name;
    }
    return [thrown, own(h), h.a];
  });
}
say("an own accessor and a read-only property among the other names", () => {
  const h: any = new Holder();
  let log = "";
  Object.defineProperty(h, "viaSetter", { set(value) { log += value; }, get() { return "got"; }, enumerable: true, configurable: true });
  Object.defineProperty(h, "fixed", { value: "fixed", writable: false, enumerable: true, configurable: true });
  Object.assign(h, { viaSetter: "set", plain: 1 });
  let thrown = "";
  try {
    Object.assign(h, { plain: 2, fixed: "changed", never: 1 });
  } catch (error) {
    thrown = (error as Error).constructor.name;
  }
  return [log, thrown, own(h), h.plain, h.fixed];
});
say("the source is the target; sources that are no objects", () => {
  const h: any = Object.assign(new Holder(), { k: 1 });
  Object.assign(h, h, null, undefined, 5, true, "st");
  return [own(h), h[0], h[1], h.k];
});
say("deleted and assigned again: the order of keys", () => {
  const h: any = Object.assign(new Holder(), { x: 1, y: 2, z: 3 });
  delete h.y;
  Object.assign(h, { z: 4, y: 5 });
  const o: any = new Optional();
  Object.assign(o, { extra: 1, sometimes: 2, more: 3, later: "l" });
  return [own(h), h.y, h.z, own(o)];
});

say("the prototype chain changes between two calls", () => {
  const seen: unknown[] = [];
  const source = { first: 2, tracked: 3, free: 4 };
  const run = () => {
    const c: any = new Changing();
    Object.assign(c, source);
    return [own(c), c.first, c.tracked, c.free];
  };
  seen.push(run(), run());
  let log = "";
  Object.defineProperty(Changing.prototype, "tracked", { set(value) { log += "tracked=" + value + ";"; }, get() { return "from the prototype"; }, configurable: true });
  seen.push(run(), run(), log);
  delete (Changing.prototype as any).tracked;
  seen.push(run());
  return seen;
});
say("many objects, so that collections fall between the calls", () => {
  let sum = 0;
  const kept: any[] = [];
  for (let i = 0; i < 20000; i++) {
    const h: any = Object.assign(new Holder(), typedSources[i & 1], otherSources[i & 1], { text: "t" + i, i });
    sum += h.a + h.p + h.i + h.text.length + h.r[0];
    if (i % 1000 === 0) kept.push(h);
  }
  return [sum, kept.map(h => h.text + h.q + h.c).join()];
});

console.log(lines.join("\n"));
//// object-create-through-interfaces.ts
// Objects made with `Object.create`, used as `any`: fields inherited from typed objects, property descriptors, and read-only properties on the chain.
interface Conf { host: string; port: number; secure?: boolean; nested: { depth: number } }
const said: string[] = []
function flush(): string { return said.splice(0).join(",") }
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
function show(c: any): string {
  return [c.host, c.port, String(c.secure), c.nested.depth, "port" in c, Object.hasOwn(c, "port"), "secure" in c, Object.keys(c).join("")].join("/")
}
function allKeys(o: object): string { const out: string[] = []; for (const k in o) out.push(k); return out.join("") }
const defaults: Conf = { host: "localhost", port: 80, nested: { depth: 1 } }
const derived: any = Object.create(defaults)
console.log(show(defaults), show(derived), allKeys(derived))
derived.port++
derived.nested.depth++
console.log(show(defaults), show(derived), allKeys(derived))
defaults.secure = true
defaults.host = "example"
console.log(show(derived), derived.secure === defaults.secure)
derived.secure = false
delete defaults.secure
console.log(show(defaults), show(derived), allKeys(derived))
delete derived.secure
delete derived.port
console.log(show(derived), derived.port + 1)
// No prototype at all: plain data, which a declared type takes.
const bare: Conf = Object.assign(Object.create(null), { host: "h", port: 1, nested: { depth: 0 } })
console.log(show(bare), "toString" in bare, attempt(() => String(bare)), attempt(() => bare + ""), Object.getPrototypeOf(bare) === null, JSON.stringify(bare))
bare.secure = true; bare.port += 0.5
console.log(show(bare), JSON.stringify({ ...bare }))
// Made with descriptors: not writable, an accessor, not enumerable.
const described: any = Object.create(Object.prototype, {
  host: { value: "fixed", enumerable: true },
  port: { get() { said.push("port?"); return 8080 }, enumerable: false, configurable: true },
  nested: { value: { depth: 5 }, writable: true },
})
console.log(show(described), flush(), attempt(() => { described.host = "x" }), attempt(() => { described.port = 1 }), attempt(() => { described.port++ }), flush())
described.nested = { depth: 6 }
described.secure = false
console.log(show(described), JSON.stringify(described), Object.getOwnPropertyNames(described).join())
// Read-only properties on the prototype decide what a store does.
const locked: any = Object.create(Object.freeze({ host: "frozen", port: 1, nested: { depth: 2 } }))
console.log(attempt(() => { locked.host = "mine" }), attempt(() => { locked.port++ }), attempt(() => { locked.secure = true }), show(locked), ++locked.nested.depth)
// A chain of three: a literal, an instance of a class, Object.create on top.
class Service implements Conf {
  host = "svc"; port = 443; nested = { depth: 3 }
  url(): string { return this.host + ":" + this.port + (this.secure ? "s" : "") }
  secure?: boolean
}
const service = new Service()
const overlay: any = Object.create(service)
overlay.port = 8443
console.log(service.url(), overlay instanceof Service, show(overlay), typeof overlay.url)
service.secure = true
console.log(service.url(), overlay.secure, Object.keys(overlay).join(), allKeys(overlay))
const confs: any[] = [defaults, derived, bare, described, locked, service, overlay]
let sum = 0
for (let i = 0; i < 160; i++) { const c = confs[i % confs.length]; sum += c.port + c.nested.depth + c.host.length + (c.secure ? 1 : 0) }
console.log(sum, flush().length)
//// object-literal-indexed-accessor.ts
// An object literal may have a getter and a setter under an index. Such an object is an ordinary one.
const both = { _0: 2, get 0() { return this._0; }, set 0(x: number) { this._0 = x; } };
both[0] **= both[0];
console.log(both[0], both._0, Object.keys(both).join());

const getterAlone = { held: "a", get 1() { return this.held + "!"; } };
console.log(getterAlone[1], getterAlone.held, Object.keys(getterAlone).join(), typeof Object.getOwnPropertyDescriptor(getterAlone, 1)!.get);

const seen: number[] = [];
const setterAlone = { n: 1, set 2(x: number) { seen.push(x); } };
setterAlone[2] = 5;
console.log(seen.join(), setterAlone[2], setterAlone.n);

function make(start: number) { return { count: start, get 0() { return ++this.count; }, name: "made" }; }
const made = [make(1), make(10)];
console.log(made.map(one => one[0] + one[0]).join(), made.map(one => one.count + one.name).join());

interface Pair { first: number; readonly 0: number; }
const typed: Pair = { first: 7, get 0() { return this.first * 2; } };
function read(pair: Pair) { return pair.first + pair[0]; }
console.log(read(typed), read({ first: 1, 0: 1 }));

const named = { _x: 1, get x() { return this._x; }, set x(v: number) { this._x = v; } };
named.x += 4;
console.log(named.x, named._x, Object.keys(named).join());
//// object-rest-patterns.ts
// Destructuring of typed objects: rest objects, defaults, renames, nested patterns, computed keys, parameters, and assignment patterns into fields.
interface Props { id: number; title: string; hidden?: boolean; size?: number; style: { color: string; width?: number } }
function show(o: object): string { return Object.keys(o).join() + " " + JSON.stringify(o) }
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
const props: Props = { title: "t", id: 1, style: { color: "red" }, size: 0 }

// The rest object has the remaining properties, in source order, and is a new plain object.
const { id, ...withoutId } = props
const { style, title, ...small } = props
const { ...everything } = props
console.log(id, show(withoutId), title, style === props.style, show(small), show(everything), everything !== props)
const { hidden, ...noHidden } = props
console.log(hidden, show(noHidden), "hidden" in noHidden)

// Defaults apply to undefined and to absent, not to other falsy values or null.
function defaults({ id, hidden = true, size = 10, title = "none" }: Partial<Props>): string { return [id, hidden, size, title].join() }
console.log(defaults(props), defaults({}), defaults({ hidden: false, size: undefined, title: "" }), defaults({ size: NaN }))
const effects: string[] = []
function note<T>(label: string, v: T): T { effects.push(label); return v }
const { size: sz = note("size default", 5), hidden: hd = note("hidden default", false) } = props
console.log(sz, hd, effects.join())

// Nested patterns and renames.
const { style: { color, width = 3, ...styleRest }, id: renamed } = props
console.log(color, width, show(styleRest), renamed)
function nestedDefault({ style: { color = "none" } = { color: "fallback" } }: { style?: { color?: string } }): string { return color }
console.log(nestedDefault({}), nestedDefault({ style: {} }), nestedDefault({ style: { color: "blue" } }))

// Computed keys: evaluated in order, left out of the rest.
const which = "title"
const { [which]: chosen, ...others } = props
console.log(String(chosen), show(others))

// Extra properties, symbols and indices added through `any` end up in the rest object; non-enumerable ones do not.
const sym = Symbol("s")
const dressed: Props = { id: 2, title: "d", style: { color: "c" } }
const anyDressed: any = dressed
anyDressed.extra = 1; anyDressed[sym] = 2; anyDressed[0] = 3
Object.defineProperty(dressed, "secret", { value: 4, enumerable: false })
const { title: dressedTitle, ...dressedRest } = dressed
console.log(dressedTitle, show(dressedRest), (dressedRest as any)[sym], "secret" in dressedRest, Reflect.ownKeys(dressedRest).length)

// Getters run in the order of the pattern, then the rest in the order of the keys.
const trace: string[] = []
const live = { get a() { trace.push("a"); return 1 }, get b() { trace.push("b"); return 2 }, get c() { trace.push("c"); return 3 }, get d() { trace.push("d"); return 4 } }
const { c: liveC, a: liveA, ...liveRest } = live
console.log(liveC, liveA, show(liveRest), trace.join())

// Class instances: inherited members can be picked, the rest has own fields only.
class Widget { x = 1; y = 2; get area() { return this.x * this.y } grow() { return ++this.x } }
const { area, grow, x: wx, ...widgetRest } = new Widget()
console.log(area, typeof grow, wx, show(widgetRest), attempt(() => grow()))

// Plain data used as the type.
const parsed: Props = JSON.parse('{"style":{"color":"j","width":1},"title":"json","more":[1],"id":9}')
const { id: parsedId, style: { width: parsedWidth }, ...parsedRest } = parsed
console.log(parsedId + 1, parsedWidth, show(parsedRest))

// Nothing to destructure.
console.log(attempt(() => { const { id } = undefined as unknown as Props; return id }), attempt(() => { const { ...r } = null as unknown as Props; return r }), attempt(() => { const { style: { color } } = { id: 1 } as unknown as Props; return color }))

// Assignment patterns store into typed fields and swap them.
interface Pt { x: number; y: number; tag?: string }
const pt: Pt = { x: 1, y: 2 }
;({ x: pt.y, y: pt.x } = pt)
console.log(show(pt))
;[pt.x, pt.y] = [pt.y, pt.x]
;({ title: pt.tag, id: pt.x = 50 } = props)
console.log(show(pt))
const bucket: { rest?: object; first?: number } = {}
;({ id: bucket.first, ...bucket.rest } = props)
console.log(bucket.first, show(bucket.rest ?? {}), Object.keys(bucket).join())

// In loops and callbacks.
const items: Props[] = [props, dressed, parsed]
const seen: string[] = []
for (const { id, title, size = -1, ...more } of items) seen.push(id + title + size + Object.keys(more).length)
console.log(seen.join(), items.map(({ style: { color }, hidden = false }) => color + hidden).join())
//// object-stops-matching-between-reads.ts
// An object of the program is read through its type, then stops fitting that type (a value of another type is stored by name, a property is
// deleted, made an accessor, or left to another prototype), then is read again. The second read answers as the language says, by whichever
// way the object got from the first read to the second. The field that is read again holds a number throughout; the field that holds another kind is not read.
declare const console: { log(...values: unknown[]): void };
declare const globalThis: { kept?: unknown };
declare const JSON: { parse(s: string): any };
declare const Object: { defineProperty(o: any, k: string, d: any): any; setPrototypeOf(o: any, p: any): any };
interface Inner { v: number; w: number }
interface T { a: number; b: number; c: number; d: number; kind: number; ref: Inner; next: T | null; opt?: Inner; flag: boolean; text: string }
function make(i: number): T { return { a: i + 0.5, b: i + 1.5, c: i + 2.5, d: i + 3.5, kind: i, ref: { v: i, w: i + 1 }, next: null, flag: (i & 1) === 0, text: "t" + i } }
const door: T[] = JSON.parse('[{"a":1,"b":2,"c":3,"d":4,"kind":1,"ref":{"v":1,"w":2},"next":null,"flag":true,"text":"s"}]') as T[];
const pool: T[] = [];
for (let i = 0; i < 600; i++) pool.push(make(i));
for (let i = 0; i + 1 < 600; i++) pool[i].next = pool[i + 1];
let taken = 0;
function fresh(): T { taken += 2; return pool[taken]; }
type Spoiler = (x: any) => void;
const nothing: Spoiler = (x) => { };
const misfit: Spoiler = (x) => { x.text = 5; x.a = 55.5; };
const removes: Spoiler = (x) => { delete x.a; x.a = 66.5; };
const accessor: Spoiler = (x) => { const y: any = x; Object.defineProperty(y, "a", { get() { return 77.5; }, configurable: true }); };
const parent: Spoiler = (x) => { delete x.a; Object.setPrototypeOf(x, { a: 88.5 }); };
const spoilers: Spoiler[] = [nothing, misfit, removes, accessor, parent];
const names = ["nothing", "misfit", "removes", "accessor", "parent"];

function straight(o: T, f: Spoiler): string { const before = o.a; f(o); return before + " then " + o.a; }
function inner(p: T, f: Spoiler): unknown { f(p); return p.a; }
function throughCall(o: T, f: Spoiler): string { const before = o.a; return before + " then " + inner(o, f); }
function throughJump(o: T, f: Spoiler): string { const q = o.next!; const before = o.a + q.a; let p = o; if (o.kind & 4) p = q; f(p); return before + " then " + p.a; }
function inLoop(o: T, f: Spoiler): string { let s = ""; for (let i = 0; i < 3; i++) { s += o.a + ","; if (i === 1) f(o); } return s; }
function pick(o: T): T { return o; }
function throughResult(o: T, f: Spoiler): string { const p = pick(o); const before = p.a; f(o); return before + " then " + p.a + " " + pick(o).a; }
function otherName(o: T, f: Spoiler): string { const before = o.b; f(o); return before + " then " + o.b + " " + o.a; }
function store(o: T, f: Spoiler): string { o.b = 7; f(o); o.b = 8; return o.b + " " + o.a; }
function chain(o: T, f: Spoiler): string { const before = o.next!.a; f(o.next); return before + " then " + o.next!.a; }
function sums(o: T, f: Spoiler): string { const before = o.a + o.b + o.c + o.d; f(o); return before + " then " + (o.a + o.b + o.c + o.d); }
const table: ((o: T, f: Spoiler) => string)[] = [straight, throughCall, throughJump, inLoop, throughResult, otherName, store, chain, sums];
const roads = ["straight", "through a call", "through a jump", "in a loop", "through a result", "another name", "a store", "a chain", "sums"];
globalThis.kept = [table, inner, pick];
let said = "";
for (let k = 0; k < spoilers.length; k++) {
    const f = spoilers[k];
    try { said = straight(fresh(), f); } catch (e) { said = "THROWS " + (e as any).name; }
    console.log(names[k] + " " + roads[0] + ": " + said);
    try { said = throughCall(fresh(), f); } catch (e) { said = "THROWS " + (e as any).name; }
    console.log(names[k] + " " + roads[1] + ": " + said);
    try { said = throughJump(fresh(), f); } catch (e) { said = "THROWS " + (e as any).name; }
    console.log(names[k] + " " + roads[2] + ": " + said);
    try { said = inLoop(fresh(), f); } catch (e) { said = "THROWS " + (e as any).name; }
    console.log(names[k] + " " + roads[3] + ": " + said);
    try { said = throughResult(fresh(), f); } catch (e) { said = "THROWS " + (e as any).name; }
    console.log(names[k] + " " + roads[4] + ": " + said);
    try { said = otherName(fresh(), f); } catch (e) { said = "THROWS " + (e as any).name; }
    console.log(names[k] + " " + roads[5] + ": " + said);
    try { said = store(fresh(), f); } catch (e) { said = "THROWS " + (e as any).name; }
    console.log(names[k] + " " + roads[6] + ": " + said);
    try { said = chain(fresh(), f); } catch (e) { said = "THROWS " + (e as any).name; }
    console.log(names[k] + " " + roads[7] + ": " + said);
    try { said = sums(fresh(), f); } catch (e) { said = "THROWS " + (e as any).name; }
    console.log(names[k] + " " + roads[8] + ": " + said);
    for (let j = 0; j < table.length; j++) {
        try { said = table[j](fresh(), f); } catch (e) { said = "THROWS " + (e as any).name; }
        console.log(names[k] + " " + roads[j] + ", by the table: " + said);
    }
}
console.log(door.length, taken);
//// object-stops-matching-during-other-code.ts
// As object-stops-matching-between-reads.ts, but the code that changes the object runs out of sight: in toString() and
// valueOf(), in an accessor of another object, behind a throw, in a finally block, across an await and a yield, or it is a store to a
// discriminant through a wider type. The fields that are read again hold numbers throughout, so each read answers as the language says. The discriminant ends up with a string outside its literal type, and its next typed read gives that string.
declare const console: { log(...values: unknown[]): void };
declare const globalThis: { kept?: unknown };
declare const JSON: { parse(s: string): any };
declare const Object: { defineProperty(o: any, k: string, d: any): any; setPrototypeOf(o: any, p: any): any };
interface Inner { v: number; w: number }
interface T { a: number; b: number; c: number; d: number; kind: number; ref: Inner; next: T | null; opt?: Inner; flag: boolean; text: string }
function make(i: number): T { return { a: i + 0.5, b: i + 1.5, c: i + 2.5, d: i + 3.5, kind: i, ref: { v: i, w: i + 1 }, next: null, flag: (i & 1) === 0, text: "t" + i } }
const door: T[] = JSON.parse('[{"a":1,"b":2,"c":3,"d":4,"kind":1,"ref":{"v":1,"w":2},"next":null,"flag":true,"text":"s"}]') as T[];
const pool: T[] = [];
for (let i = 0; i < 400; i++) pool.push(make(i));
let taken = 0;
function fresh(): T { taken += 2; return pool[taken]; }
let victim: any = null;
let how = 0;
function spoil(): void {
    const x = victim;
    if (how === 1) { x.text = 5; x.a = 55.5; }
    else if (how === 2) { delete x.a; x.a = 66.5; }
    else if (how === 3) Object.defineProperty(x, "a", { get() { return 77.5; }, configurable: true });
    else if (how === 4) { delete x.a; Object.setPrototypeOf(x, { a: 88.5 }); }
}
const names = ["nothing", "misfit", "removes", "accessor", "parent"];
interface Speaks { toString(): string }
interface Weighs { valueOf(): number }
const speaks: Speaks = { toString() { spoil(); return "said"; } };
const weighs: Weighs = { valueOf() { spoil(); return 1; } };
function strangerThatSpoils(): T { const s: any = JSON.parse('{"a":1,"c":3,"d":4,"kind":1,"ref":{"v":1,"w":2},"next":null,"flag":true,"text":"s"}'); let held = 2; Object.defineProperty(s, "b", { get() { spoil(); return held; }, set(v: number) { spoil(); held = v; }, configurable: true, enumerable: true }); return s as T; }

function byTemplate(o: T, x: Speaks): string { const before = o.a; const s = `${x}`; return before + " " + s + " then " + o.a; }
function byConcatenation(o: T, x: Speaks): string { const before = o.a; const s = "" + x; return before + " " + s + " then " + o.a; }
function byPlus(o: T, x: Weighs): string { const before = o.a; const n = +(x as any); return before + " " + n + " then " + o.a; }
function byTimes(o: T, x: Weighs): string { const before = o.a; const n = (x as any) * 2; return before + " " + n + " then " + o.a; }
function byLess(o: T, x: Weighs): string { const before = o.a; const n = (x as any) < 5; return before + " " + n + " then " + o.a; }
function byGetterOfStranger(o: T, q: T): string { const before = o.a + q.a; const n = q.b; return before + " " + n + " then " + o.a + " " + q.a; }
function bySetterOfStranger(o: T, q: T): string { const before = o.a + q.a; q.b = 9; return before + " then " + o.a + " " + q.a; }
function byThrow(o: T): string { const before = o.a; try { spoil(); throw new Error("x"); } catch (e) { } return before + " then " + o.a; }
function byFinally(o: T): string { const before = o.a; try { if (before < 0) return "never"; } finally { spoil(); } return before + " then " + o.a; }
function byKey(o: T, x: Speaks): string { const before = o.a; const bag: any = {}; bag[x as any] = 1; return before + " then " + o.a; }
function bySecondTurn(o: T): string { let s = ""; for (let i = 0; i < 3; i++) { s += o.a + o.b + ","; if (i === 0) spoil(); } return s; }
function byBranch(o: T, yes: boolean): string { const before = o.a; if (yes) spoil(); else victim = victim; return before + " then " + o.a + " " + o.b; }
async function byAwait(o: T): Promise<string> { const before = o.a; await null; return before + " then " + o.a; }
function* byYield(o: T): Generator<number, string, unknown> { const before = o.a; yield 1; return before + " then " + o.a; }
const table: unknown[] = [byTemplate, byConcatenation, byPlus, byTimes, byLess, byGetterOfStranger, bySetterOfStranger, byThrow, byFinally, byKey, bySecondTurn, byBranch, byAwait, byYield];
globalThis.kept = table;
function attempt(f: () => string): string { try { return f(); } catch (e) { return "THROWS " + (e as any).name; } }
function next(): T { const o = fresh(); victim = o; return o; }
const later: string[] = [];
for (how = 0; how < 5; how++) {
    const n = names[how];
    console.log(n + " a template: " + attempt(() => byTemplate(next(), speaks)));
    console.log(n + " a concatenation: " + attempt(() => byConcatenation(next(), speaks)));
    console.log(n + " a unary plus: " + attempt(() => byPlus(next(), weighs)));
    console.log(n + " a product: " + attempt(() => byTimes(next(), weighs)));
    console.log(n + " a comparison: " + attempt(() => byLess(next(), weighs)));
    console.log(n + " a getter of an object from outside: " + attempt(() => byGetterOfStranger(next(), strangerThatSpoils())));
    console.log(n + " a setter of an object from outside: " + attempt(() => bySetterOfStranger(next(), strangerThatSpoils())));
    console.log(n + " a throw: " + attempt(() => byThrow(next())));
    console.log(n + " a finally: " + attempt(() => byFinally(next())));
    console.log(n + " a key: " + attempt(() => byKey(next(), speaks)));
    console.log(n + " the second turn: " + attempt(() => bySecondTurn(next())));
    console.log(n + " a branch: " + attempt(() => byBranch(next(), true)) + " | " + attempt(() => byBranch(next(), false)));
    const g = byYield(next()); g.next(); spoil(); console.log(n + " a yield: " + attempt(() => g.next().value as string));
}
how = 1;
const awaited = next();
byAwait(awaited).then((s) => console.log("misfit an await: " + s));
spoil();

interface Circle { kind: "circle"; r: number; x: number; y: number; name: string; tag: number; e: number; f: number }
interface Square { kind: "square"; s: number; x: number; y: number; name: string; tag: number; e: number; f: number }
type Shape = Circle | Square;
interface Named { kind: string; x: number; y: number; name: string; tag: number; e: number; f: number }
const shapesFromOutside: Shape[] = JSON.parse('[{"kind":"circle","r":1,"x":0,"y":0,"name":"n","tag":1,"e":1,"f":2}]') as Shape[];
function circle(i: number): Circle { return { kind: "circle", r: i + 0.25, x: i, y: i + 1, name: "c" + i, tag: i, e: i, f: i } }
function rename(o: Circle, w: Named): string { const before = o.r + o.x; w.kind = "oval"; return before + " then " + (o.r + o.x) + " " + o.kind; }
function renameAlike(o: Circle, w: Named): string { const before = o.r + o.x; w.kind = "circle"; return before + " then " + (o.r + o.x) + " " + o.kind; }
globalThis.kept = [table, rename, renameAlike, shapesFromOutside];
for (let i = 0; i < 3; i++) { const c = circle(i); console.log("another discriminant: " + attempt(() => rename(c, c)) + " | " + attempt(() => renameAlike(circle(i + 10), circle(i + 20)))); }
//// object-stops-matching-during-other-read.ts
// Two objects are read through one type in one stretch of code. The second is an object made by untyped code whose
// accessor changes the first: stores, deletes, redefines, gives it another parent, always so that it still has what its type says. What is read of the first behind that is
// what the language says, however many tests of its shape the stretch shares.
declare const console: { log(...values: unknown[]): void };
declare const globalThis: { kept?: unknown };
declare const JSON: { parse(text: string): any };
declare const Object: { defineProperty(o: any, k: string, d: any): any; setPrototypeOf(o: any, p: any): any };
interface Item { count: number; total: number; name?: string; n?: number; a1?: number; a2?: number; a3?: number; a4?: number; a5?: number; a6?: number }
let victim: any;
let deed = 0;
function doDeed(): void {
  switch (deed) {
    case 1: victim.total = 4.5; break;
    case 2: Object.defineProperty(victim, "total", { get() { return 777 }, configurable: true }); break;
    case 3: delete victim.total; Object.setPrototypeOf(victim, { total: 555 }); break;
    case 4: delete victim.name; break;
    case 5: victim.name = "changed"; victim.count = victim.count + 100; break;
    case 6: Object.defineProperty(victim, "count", { value: 99, writable: true, enumerable: false, configurable: true }); break;
    case 7: victim.extra = 1; victim.total = -1; break;
  }
}
function member(i: number): Item { return { count: i, total: i * 10, name: "m" + i, n: i + 0.5 } }
function parsed(i: number): Item { return JSON.parse('{"count":' + i + ',"total":' + i * 10 + ',"name":"p' + i + '"}') as Item }
function meddler(i: number): Item {
  const o: any = { total: i * 10, name: "g" + i };
  Object.defineProperty(o, "count", { get() { doDeed(); return i }, set(v: number) { doDeed() }, enumerable: true, configurable: true });
  return o as Item;
}
function around(a: Item, b: Item): string {
  const first = a.total;
  const between = b.count;
  return first + " " + between + " " + a.total + " " + a.name + " " + a.count;
}
function aroundStore(a: Item, b: Item): string {
  const first = a.total + a.count;
  b.count = 3;
  return first + " " + a.total + " " + a.name + " " + a.count;
}
function three(a: Item, b: Item, c: Item): string {
  const sum = a.total + c.total + a.count + c.count;
  const between = b.count;
  return sum + " " + between + " " + a.total + " " + c.total + " " + a.count + " " + c.count;
}
function inLoop(a: Item, b: Item): string {
  let said = "";
  for (let i = 0; i < 3; i++) {
    const before = a.total;
    const between = i === 1 ? b.count : b.total;
    said += before + ":" + between + ":" + a.total + ":" + a.count + " ";
  }
  return said;
}
function twice(a: Item, b: Item): string {
  return a.total + " " + a.count + " " + b.count + " " + b.total + " " + a.total + " " + a.count + " " + b.count + " " + a.total;
}
globalThis.kept = [around, aroundStore, three, inLoop, twice];
for (deed = 0; deed <= 7; deed++) {
  for (const make of [member, parsed]) {
    victim = make(1); console.log(deed, "around", around(victim, meddler(2)));
    victim = make(2); console.log(deed, "store", aroundStore(victim, meddler(3)));
    victim = make(3); console.log(deed, "three", three(victim, meddler(4), member(5)));
    victim = make(4); console.log(deed, "third", three(member(6), meddler(7), victim));
    victim = make(5); console.log(deed, "loop", inLoop(victim, meddler(8)));
    victim = make(6); console.log(deed, "twice", twice(victim, meddler(9)));
    victim = make(7); console.log(deed, "members", around(victim, member(8)), three(victim, member(9), member(10)));
  }
}
//// objects-allocated-repeatedly-same-new-target/core.ts
// A class with fields it is born with and fields it is born without, constructed many times for the same new.target and for many.
export class Core {
  declare late?: unknown;
  count = 0;
  label: string | undefined = undefined;
  list: number[] | undefined;
  constructor(count?: number) {
    if (count !== undefined) this.count = count;
  }
  describe(): string {
    return this.count + " " + String(this.label) + " " + String(this.list) + " " + String(this.late);
  }
}
export const readLate = (core: Core): unknown => core.late;
export const fill = (core: Core, value: number): void => {
  core.label = "l" + value;
  core.list = [value];
  core.late = value;
};
//// objects-allocated-repeatedly-same-new-target/heirs.js
import { Core } from "./core.ts";
////= lines-27	Heir	Core	helper	"helper"
export class Other extends Core {
  get label() { return "inherited from Other"; }
  set label(value) {}
}
export function Old(count) { return Reflect.construct(Core, [count], Old); }
Old.prototype = Object.create(Core.prototype, { kind: { value: "first", configurable: true } });
export const second = Object.create(Core.prototype, { kind: { value: "second", configurable: true } });
export const many = [];
for (let i = 0; i < 40; i++) many.push(class extends Core { which() { return i; } });
export const bound = Heir.bind(null);
export const proxied = new Proxy(Heir, {});
export function make(C, count) {
  return new C(count);
}
export function addGetter(object, name, value) {
  Object.defineProperty(object, name, { get() { return value; }, configurable: true });
}
//// objects-allocated-repeatedly-same-new-target/main.ts
import * as core from "./core.ts";
import * as heirs from "./heirs.js";
const show = (label: string, value: unknown) => console.log(label + ": " + JSON.stringify(value));
const look = (o: any) => [o.describe(), Object.keys(o).join(), core.readLate(o), o instanceof core.Core, o.kind, typeof o.helper];

const first = heirs.make(heirs.Heir, 1);
core.fill(first, 7);
(first as any).extra = "of the first alone";
for (let i = 0; i < 6; i++) show("Heir " + i, look(heirs.make(heirs.Heir, i)));
show("the first", [look(first), (first as any).extra]);

for (let i = 0; i < 4; i++) show("Old " + i, [look(heirs.make(heirs.Old, i)), Object.getPrototypeOf(heirs.make(heirs.Old, i)) === heirs.Old.prototype]);
(heirs.Old as any).prototype = heirs.second;
for (let i = 0; i < 4; i++) show("Old with another prototype " + i, [look(heirs.make(heirs.Old, i)), Object.getPrototypeOf(heirs.make(heirs.Old, i)) === heirs.second]);
(heirs.Old as any).prototype = 5;
show("Old with no prototype object", Object.getPrototypeOf(heirs.make(heirs.Old, 1)) === Object.prototype);

let sum = 0;
for (let round = 0; round < 5; round++) {
  for (const C of heirs.many) {
    const o: any = heirs.make(C, round);
    sum += o.which() + o.count + (Object.getPrototypeOf(o) === C.prototype ? 1000 : 0);
  }
}
show("forty heirs in turn", sum);

for (let i = 0; i < 3; i++) {
  show("for one and for another " + i, [look(Reflect.construct(core.Core, [i], heirs.Heir)), look(Reflect.construct(core.Core, [i], heirs.Other)), look(Reflect.construct(heirs.Heir, [i], heirs.Other)), look(Reflect.construct(heirs.Other, [i], heirs.Heir))]);
  show("bound and proxied " + i, [look(heirs.make(heirs.bound, i)), look(heirs.make(heirs.proxied, i)), look(Reflect.construct(core.Core, [i], heirs.bound)), look(Reflect.construct(core.Core, [i], heirs.proxied))]);
}

const nameOfLate = ["la", "te"].join("");
heirs.addGetter(heirs.Heir.prototype, nameOfLate, "added later");
for (let i = 0; i < 3; i++) show("Heir with a getter " + i, look(heirs.make(heirs.Heir, i)));
delete (heirs.Heir.prototype as any)[nameOfLate];
for (let i = 0; i < 3; i++) show("Heir without it " + i, look(heirs.make(heirs.Heir, i)));
Object.setPrototypeOf(heirs.Heir.prototype, heirs.Other.prototype);
for (let i = 0; i < 3; i++) show("Heir below Other " + i, look(heirs.make(heirs.Heir, i)));
Object.setPrototypeOf(heirs.Heir.prototype, core.Core.prototype);
for (let i = 0; i < 3; i++) show("Heir below Core again " + i, look(heirs.make(heirs.Heir, i)));

const kept: any[] = [];
for (let i = 0; i < 3000; i++) {
  const o = heirs.make(heirs.Heir, i);
  if (i % 3 === 0) core.fill(o, i);
  if (i % 100 === 0) kept.push(o);
}
show("many", kept.map(o => o.describe()).join(" | "));
//// objects-become-subtypes-and-siblings.ts
// Objects are made as a base type, kept in arrays of it, and cast to one of many subtypes later, when the program knows more about them, and then to a sibling of that subtype. A cast changes nothing: the object stays the same object, gets a property of the subtype or of the sibling when it is stored, keeps its keys in the order they were created in, and reads and writes like any other, however often that happens and while the collector runs.
interface Base { id: number; flags: number }
interface Sub0 extends Base { a0: number | undefined; b0: string | undefined; c0: Base | undefined; d0: boolean | undefined }
interface Sub1 extends Base { a1: number | undefined; b1: string | undefined; c1: Base | undefined; d1: boolean | undefined }
interface Sub2 extends Base { a2: number | undefined; b2: string | undefined; c2: Base | undefined; d2: boolean | undefined }
interface Sub3 extends Base { a3: number | undefined; b3: string | undefined; c3: Base | undefined; d3: boolean | undefined }
interface Sub4 extends Base { a4: number | undefined; b4: string | undefined; c4: Base | undefined; d4: boolean | undefined }
interface Sub5 extends Base { a5: number | undefined; b5: string | undefined; c5: Base | undefined; d5: boolean | undefined }
interface Sub6 extends Base { a6: number | undefined; b6: string | undefined; c6: Base | undefined; d6: boolean | undefined }
interface Sub7 extends Base { a7: number | undefined; b7: string | undefined; c7: Base | undefined; d7: boolean | undefined }
interface Sub8 extends Base { a8: number | undefined; b8: string | undefined; c8: Base | undefined; d8: boolean | undefined }
interface Sub9 extends Base { a9: number | undefined; b9: string | undefined; c9: Base | undefined; d9: boolean | undefined }
interface Sub10 extends Base { a10: number | undefined; b10: string | undefined; c10: Base | undefined; d10: boolean | undefined }
interface Sub11 extends Base { a11: number | undefined; b11: string | undefined; c11: Base | undefined; d11: boolean | undefined }
interface Deep extends Sub0 { deep: number[] | undefined }

function fill(all: Base[], count: number): void {
    for (let i = 0; i < count; i++) {
        if (i % 3 === 0) all.push({ id: i, flags: 1 });
        else if (i % 3 === 1) all.push({ flags: 2, id: i });
        else all.push({ id: i, flags: 3 });
