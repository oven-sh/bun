//// non-extensible-plain-objects-enter-typed-code.ts
// Plain objects that were frozen, sealed or made non-extensible enter typed code again and again: each time they read, refuse and accept what they do in plain JavaScript, the first time and every later time.
type Reading = { id: number; unit: string; note?: string };
type Holder = { name: string; reading: Reading };
type Choice = { kind: "left"; x: number } | { kind: "right"; y: string };

const levels: [string, (value: any) => any][] = [
  ["open", value => value],
  ["not extensible", value => Object.preventExtensions(value)],
  ["sealed", value => Object.seal(value)],
  ["frozen", value => Object.freeze(value)],
];
function attempt(f: () => unknown): string {
  try {
    return String(f());
  } catch (error) {
    return (error as Error).name;
  }
}
function state(value: object): string {
  return (Object.isFrozen(value) ? "F" : "-") + (Object.isSealed(value) ? "S" : "-") + (Object.isExtensible(value) ? "E" : "-");
}
function use(reading: Reading): string {
  return [
    state(reading),
    reading.id + reading.unit,
    attempt(() => (reading.id += 10)),
    attempt(() => (reading.note = "n")),
    attempt(() => delete reading.note),
    reading.id,
    Object.keys(reading).join(),
  ].join(" ");
}
function useHolder(holder: Holder): string {
  return [state(holder), state(holder.reading), attempt(() => (holder.name += "!")), attempt(() => ++holder.reading.id), holder.name, holder.reading.id].join(" ");
}
function useChoice(choice: Choice): string {
  return state(choice) + " " + (choice.kind === "left" ? attempt(() => ++choice.x) : attempt(() => (choice.y += "y")));
}
const grow = (id: number): any => {
  const reading: any = { id };
  reading.unit = "mm";
  return reading;
};

for (const [name, level] of levels) {
  console.log(name);
  for (let turn = 0; turn < 4; turn++) {
    const reading = level(grow(turn));
    console.log("  reading", use(reading), "| outside", reading.id, reading.note, state(reading));
  }
  for (let turn = 0; turn < 4; turn++) {
    const reading = grow(turn);
    reading.note = "had";
    console.log("  with the optional key", use(level(reading)), "| outside", reading.id, reading.note);
  }
  for (let turn = 0; turn < 4; turn++) {
    const reading = grow(turn);
    reading.extra = turn;
    console.log("  with a key of its own", use(level(reading)), "| outside", reading.id, reading.extra);
  }
  for (let turn = 0; turn < 4; turn++) {
    const holder: any = level({ name: "h" + turn, reading: turn % 2 ? level(grow(turn)) : grow(turn) });
    console.log("  holder", useHolder(holder), "| outside", holder.name, holder.reading.id);
  }
  for (let turn = 0; turn < 6; turn++) {
    const choice: any = level(turn % 2 ? { kind: "left", x: turn } : { kind: "right", y: "t" + turn });
    console.log("  choice", useChoice(choice), "| outside", choice.x, choice.y);
  }
  for (let turn = 0; turn < 4; turn++) {
    const reading = grow(turn);
    Object.defineProperty(reading, "unit", { writable: false });
    console.log("  one read-only key", use(level(reading)), attempt(() => ((reading as Reading).unit = "cm")));
  }
  const same = level(grow(100));
  console.log("  the same object twice", use(same), "|", use(same), "| outside", same.id);
}

let total = 0;
let refused = 0;
function bump(reading: Reading): number {
  try {
    reading.id++;
  } catch {
    refused++;
  }
  return reading.id;
}
for (let i = 0; i < 40000; i++) total += bump(levels[i & 3][1](grow(i)));
console.log(total, refused);
//// non-object-as-promise.ts
// `await` takes what is no promise. A place written `Promise<T>` (a variable, a parameter, a field, a result) is tested like any object type: undefined, null and every object, a thenable or not, pass and stay what they are. A number or a string is no object: `v as Promise<unknown>` throws a TypeError.
class Job { pending: Promise<unknown>; constructor(pending: Promise<unknown>) { this.pending = pending } }
async function wait(p: Promise<unknown>): Promise<unknown> { return await p }
function asPromise(v: unknown): Promise<unknown> { return v as Promise<unknown> }
const values: [string, unknown][] = [["a number", 7], ["a string", "text"], ["undefined", undefined], ["null", null], ["a thenable", { then(done: (n: number) => void) { done(9) } }], ["a plain object", { n: 1 }], ["a promise", Promise.resolve(3)]];
for (const [name, v] of values) {
  try {
    const held: Promise<unknown> = v as Promise<unknown>;
    console.log("a variable, " + name + ": " + typeof held + " " + String(await held).slice(0, 15));
  } catch (e) { console.log("a variable, " + name + ": " + (e as Error).constructor.name); }
  try { console.log("a parameter, " + name + ": " + String(await wait(v as Promise<unknown>)).slice(0, 15)); } catch (e) { console.log("a parameter, " + name + ": " + (e as Error).constructor.name); }
  try {
    const record: { pending: Promise<unknown> } = { pending: v as Promise<unknown> };
    console.log("a field, " + name + ": " + typeof record.pending);
  } catch (e) { console.log("a field, " + name + ": " + (e as Error).constructor.name); }
  try { console.log("a field of a class, " + name + ": " + typeof new Job(v as Promise<unknown>).pending); } catch (e) { console.log("a field of a class, " + name + ": " + (e as Error).constructor.name); }
  try { console.log("a result, " + name + ": " + typeof asPromise(v)); } catch (e) { console.log("a result, " + name + ": " + (e as Error).constructor.name); }
}
//// non-object-thrown-as-error.ts
// What a program throws need be no object. `Error` is tested like any object type: undefined, null and every object, an Error or not, pass `e as Error` and every place written `Error` (a variable, a parameter, a field, a field of a class, a result, an element) and stay what they are. A thrown string, number, boolean or bigint is no object: `e as Error` throws a TypeError.
class Report { cause: Error; constructor(cause: Error) { this.cause = cause } }
function thrown(v: unknown): unknown { try { throw v } catch (e) { return e } }
function kindOf(e: Error): string { return typeof e }
function messageOf(e: Error): unknown { return e instanceof Error ? e.message : String(e) }
function asError(v: unknown): Error { return thrown(v) as Error }
////= say-3
const values: [string, unknown][] = [["a string", "boom"], ["a number", 7], ["a boolean", false], ["a bigint", 5n], ["undefined", undefined], ["null", null], ["a plain object", { message: "plain" }], ["an error", new Error("real")], ["a range error", new RangeError("far")]];
for (const [name, v] of values) {
  say("a variable, " + name, () => { const err: Error = thrown(v) as Error; return typeof err });
  say("a parameter, " + name, () => kindOf(thrown(v) as Error));
  say("a parameter that is looked at, " + name, () => messageOf(thrown(v) as Error));
  say("a field, " + name, () => { const held: { cause: Error } = { cause: thrown(v) as Error }; return typeof held.cause });
  say("a field of a class, " + name, () => typeof new Report(thrown(v) as Error).cause);
  say("a result, " + name, () => typeof asError(v));
  say("an element, " + name, () => { const all: Error[] = [thrown(v) as Error]; return typeof all[0] });
  say("its message, " + name, () => { const err: Error = thrown(v) as Error; return err.message });
  say("the same value, " + name, () => { const err: Error = thrown(v) as Error; return (err as unknown) === v });
}
//// null-checks-before-each-kind-of-access.ts
// A read, store, update, comparison or test of a field of `o!` throws a TypeError that names the same property, value and position as in plain Bun when `o` is null or undefined, whatever instruction the access becomes.
// STATISTIC: NullChecksFoldedIntoAccesses >= 20
class Item {
  next: Item | null = null;
  count = 0;
  ratio = 0.5;
  isOpen = false;
  label = "none";
  constructor(count: number, next: Item | null) {
    this.count = count;
    this.ratio = count + 0.25;
    this.isOpen = count % 2 === 1;
    this.label = "item " + count;
    this.next = next;
  }
}
type Maybe = Item | null | undefined;

function readReference(o: Maybe) { return o!.next === null ? "end" : "more"; }
function readCount(o: Maybe) { return o!.count; }
function readRatio(o: Maybe) { return o!.ratio; }
function readLabel(o: Maybe) { return o!.label; }
function addCount(o: Maybe, n: number) { return (n + o!.count) | 0; }
function subtractCount(o: Maybe, n: number) { return (n - o!.count) | 0; }
function addRatio(o: Maybe, n: number) { return n + o!.ratio; }
function multiplyRatio(o: Maybe, n: number) { return n * o!.ratio; }
function subtractRatio(o: Maybe, n: number) { return n - o!.ratio; }
function compareCount(o: Maybe) { return o!.count === 7 ? "seven" : "other"; }
function compareCounts(o: Maybe, n: number) { return o!.count < n ? "less" : "not less"; }
function testFlag(o: Maybe) { return o!.isOpen ? "open" : "closed"; }
function testBit(o: Maybe) { return o!.count & 4 ? "set" : "clear"; }
function storeCount(o: Maybe, n: number) { o!.count = n | 0; return "stored"; }
function storeConstant(o: Maybe) { o!.count = 7; return "stored"; }
function storeRatio(o: Maybe, n: number) { o!.ratio = n * 0.5; return "stored"; }
function storeFlag(o: Maybe, n: number) { o!.isOpen = n > 2; return "stored"; }
function storeReference(o: Maybe, other: Item) { o!.next = other; return "stored"; }
function storeNull(o: Maybe) { o!.next = null; return "stored"; }
function incrementCount(o: Maybe) { o!.count++; return "updated"; }
function addToCount(o: Maybe, n: number) { o!.count += n | 0; return "updated"; }
function addToRatio(o: Maybe, n: number) { o!.ratio += n; return "updated"; }
function readSecond(o: Maybe) { return o!.next!.count; }
function readThird(o: Maybe) { return o!.next!.next!.ratio; }
function readTwoFields(o: Maybe) { return o!.count + o!.ratio; }
function readAfterArithmetic(o: Maybe, n: number) { const scaled = n * 3 + 1; return scaled + o!.count; }
function sumList(o: Maybe) { let sum = 0; for (let item = o!; ; item = item.next!) { sum += item.count; if (sum > 100) return sum; } }

function describe(error: unknown): string {
  const e = error as Error;
  const position = /:(\d+):(\d+)\)?\s*$/m.exec(e.stack ?? "");
  const value = /\b(null|undefined)\b/.exec(e.message);
  const evaluated = /evaluating '([^']*)'/.exec(e.message);
  const property = evaluated ? /\.(\w+)\b(?!\.)/.exec(evaluated[1]) : /(?:reading|setting) '(\w+)'/.exec(e.message);
  return e.name + ": " + (property ? property[1] : "no property") + " of " + (value ? value[1] : "no value") + " at " + (position ? position[1] + ":" + position[2] : "no position");
}

function stateOf(o: Maybe): string {
  return o ? [o.count, o.ratio, o.isOpen, o.label, o.next ? o.next.count : "end"].join(" ") : String(o);
}

function makeList(length: number): Item | null {
  let list: Item | null = null;
  for (let i = length; i > 0; i--) list = new Item(i + 4, list);
  return list;
}

const other = new Item(40, null);
const cases: [string, (o: Maybe) => unknown][] = [
  ["readReference", readReference], ["readCount", readCount], ["readRatio", readRatio], ["readLabel", readLabel],
  ["addCount", o => addCount(o, 3)], ["subtractCount", o => subtractCount(o, 3)], ["addRatio", o => addRatio(o, 3)],
  ["multiplyRatio", o => multiplyRatio(o, 3)], ["subtractRatio", o => subtractRatio(o, 3)],
  ["compareCount", compareCount], ["compareCounts", o => compareCounts(o, 6)], ["testFlag", testFlag], ["testBit", testBit],
  ["storeCount", o => storeCount(o, 3)], ["storeConstant", storeConstant], ["storeRatio", o => storeRatio(o, 3)],
  ["storeFlag", o => storeFlag(o, 3)], ["storeReference", o => storeReference(o, other)], ["storeNull", storeNull],
  ["incrementCount", incrementCount], ["addToCount", o => addToCount(o, 3)], ["addToRatio", o => addToRatio(o, 3)],
  ["readSecond", readSecond], ["readThird", readThird], ["readTwoFields", readTwoFields],
  ["readAfterArithmetic", o => readAfterArithmetic(o, 3)], ["sumList", sumList],
];

for (const [name, run] of cases) {
  for (const length of [3, 2, 1, 0, -1]) {
    const o: Maybe = length < 0 ? undefined : makeList(length);
    let outcome = "";
    for (let round = 0; round < 300; round++) {
      const fresh: Maybe = round ? (length < 0 ? undefined : makeList(length)) : o;
      try { outcome = String(run(fresh)) + " | " + stateOf(fresh); } catch (error) { outcome = describe(error) + " | " + stateOf(fresh); }
    }
    console.log(name, length, "|", outcome);
  }
}
//// null-checks-of-narrow-references.ts
class Node {
    next: Node | null = null;
    other: Node | undefined = undefined;
    either: Node | null | undefined = null;
    value = 0;
    wide = 0.5;
    name = "n";
    constructor(value: number) { this.value = value; }
    bump(): number { return ++this.value; }
}

let current: Node | undefined;
let last: Node | null = null;

function withoutSourceText(text: string): string {
    const start = text.indexOf(" (evaluating ");
    return start < 0 ? text : text.slice(0, start);
}

function message(run: () => unknown): string {
    try {
        return "returned " + String(run());
    } catch (error) {
        return (error as Error).constructor.name + ": " + withoutSourceText((error as Error).message);
    }
}

function readNext(node: Node): number { return node.next!.value; }
function readOther(node: Node): number { return node.other!.value; }
function readEither(node: Node): number { return node.either!.value; }
function readWide(node: Node): number { return node.next!.wide; }
function readName(node: Node): string { return node.other!.name; }
function writeNext(node: Node): number { node.next!.value = 7; return node.next!.value; }
function writeOther(node: Node): number { node.other!.wide = 7.5; return node.other!.wide; }
function callNext(node: Node): number { return node.next!.bump(); }
function callOther(node: Node): number { return node.other!.bump(); }
function twoLinks(node: Node): number { return node.next!.next!.value; }
function threeLinks(node: Node): number { return node.next!.other!.either!.value; }
function readCurrent(): number { return current!.value; }
function readLast(): number { return last!.value; }
function compareThenRead(node: Node, other: Node | null): number { return node.next === other ? node.next!.value : -1; }
function keepThenRead(node: Node, sink: (Node | null)[]): number { const next = node.next; sink.push(next); return next!.value; }
function readInTry(node: Node): string { try { return "read " + node.next!.value; } catch (error) { return "caught " + withoutSourceText((error as Error).message); } finally { node.value++; } }
function walk(node: Node | null): number { let sum = 0; while (node !== null) { sum += node.value; node = node.next; } return sum; }
function walkEither(node: Node | null | undefined): number { let sum = 0; while (node !== null) { sum += node!.value; node = node!.either; } return sum; }
function walkOther(node: Node | undefined): number { let sum = 0; for (; node !== undefined; node = node.other) sum += node.value; return sum; }
function walkUnchecked(node: Node): number { let sum = 0; for (let count = 0; count < 5; count++) { sum += node.value; node = node.next!; } return sum; }
function deleteThrough(node: Node): boolean { return delete (node.next as unknown as Record<string, unknown>).nothing; }
function destructure(node: Node): number { const { value } = node.other!; return value; }
function optional(node: Node): number | undefined { return node.next?.value; }
function optionalThenRead(node: Node): number { return node.next?.next!.value ?? -2; }

function chain(length: number): Node {
    const head = new Node(1);
    let tail = head;
    for (let index = 2; index <= length; index++) {
        const node = new Node(index);
        tail.next = node; tail.other = node; tail.either = node;
        tail = node;
    }
    return head;
}

const functions: [string, (node: Node) => unknown][] = [
    ["readNext", readNext], ["readOther", readOther], ["readEither", readEither], ["readWide", readWide], ["readName", readName], ["writeNext", writeNext], ["writeOther", writeOther],
    ["callNext", callNext], ["callOther", callOther], ["twoLinks", twoLinks], ["threeLinks", threeLinks], ["readInTry", readInTry], ["deleteThrough", deleteThrough],
    ["destructure", destructure], ["optional", optional], ["optionalThenRead", optionalThenRead], ["walkUnchecked", walkUnchecked],
    ["compareThenRead null", node => compareThenRead(node, null)], ["compareThenRead itself", node => compareThenRead(node, node.next)], ["keepThenRead", node => { const sink: (Node | null)[] = []; const text = message(() => keepThenRead(node, sink)); return text + " kept " + (sink[0] === null ? "null" : typeof sink[0]); }],
];

for (let round = 0; round < 3; round++) {
    for (const length of [1, 2, 3, 4, 7]) {
        for (const [name, run] of functions)
            console.log(round, length, name, message(() => run(chain(length))));
        const head = chain(length);
        console.log(round, length, "walk", walk(head), walkOther(head), message(() => walkEither(head)));
        let tail = head;
        while (tail.next !== null) tail = tail.next;
        tail.either = undefined;
        console.log(round, length, "walkEither to undefined", message(() => walkEither(head)));
    }
    console.log(round, "current", message(readCurrent), "last", message(readLast));
    current = new Node(40 + round); last = new Node(50 + round);
    console.log(round, "current", message(readCurrent), "last", message(readLast));
    current = undefined; last = null;
}
//// nullable-number-field-stores.ts
// Stores into `number | null`, `number | undefined` and optional number fields: every kind of number, at and around the limits of the compact encoding, over every kind of previous value. Output must match plain Bun.
type Nullable = { a: string; n: number | null; b: string; c: string };
type Undefinable = { a: string; u: number | undefined; b: string; c: string };
type Optional = { a: string; o?: number; b: string; c: string };
type Point = { x: number; y: number; label: string };
type Holder = { p: Point; n: number | null; list: number[] };
////= lines-28	storeIntoHolder	Holder	null	n
////= lines-28	storeNullable	Nullable	null	n
////= lines-28	storeUndefinable	Undefinable	undefined	u
////= lines-28	storeOptional	Optional	undefined	o
export function storeNumber(x: Nullable, y: Undefinable, z: Optional, n: number) {
  x.n = n;
  y.u = n;
  z.o = n;
}
const show = (value: number | null | undefined) => (Object.is(value, -0) ? "-0" : String(value));
const parsed = JSON.parse('["0", "-0", "1", "-1", "0.5", "-0.5", "NaN", "Infinity", "-Infinity", "1073741823", "1073741824", "1073741825", "-1073741823", "-1073741824", "-1073741825", "-1073741826", "-1073741827", "2147483647", "2147483648", "-2147483648", "-2147483647", "-2147483646", "-2147483645", "-2147483649", "4294967296", "9007199254740992", "1e300", "5e-324"]') as string[];
const numbers = parsed.map(Number);
const before: (number | null | undefined)[] = [null, undefined, numbers[2], numbers[4], numbers[19], numbers[24]];
const untyped: Record<string, Function> = { storeNullable, storeUndefinable, storeOptional, storeNumber };
let lines = 0;
for (const first of before) {
  for (const second of [...numbers, null, undefined]) {
    const x: Nullable = { a: "a", n: null, b: "b", c: "c" };
    const y: Undefinable = { a: "a", u: undefined, b: "b", c: "c" };
    const z: Optional = { a: "a", b: "b", c: "c" };
    storeNumber(x, y, z, 7);
    storeNullable(x, null);
    storeUndefinable(y, undefined);
    if (first !== undefined) untyped.storeNullable(x, first);
    if (first !== null) untyped.storeUndefinable(y, first);
    if (first !== null) untyped.storeOptional(z, first);
    if (second !== undefined) untyped.storeNullable(x, second);
    if (second !== null) untyped.storeUndefinable(y, second);
    if (second !== null) untyped.storeOptional(z, second);
    console.log(show(first), show(second), "->", show(x.n), show(y.u), show(z.o), "o" in z, Object.keys(z).join());
    if (typeof second === "number") {
      untyped.storeNumber(x, y, z, second);
      console.log("  all", show(x.n), show(y.u), show(z.o), JSON.stringify([x, y, z]));
    }
    lines++;
  }
}
const holder: Holder = { p: { x: 1, y: 2, label: "a" }, n: null, list: [] };
storeIntoHolder(holder, 1);
function feed(n: number | null) {
  storeIntoHolder(holder, n);
}
untyped.feed = feed;
for (const value of [...numbers, null]) {
  untyped.feed(value);
  console.log("holder", show(holder.n));
}
console.log(lines);
//// nullish-at-declared-types.ts
// Null and undefined can enter variables declared `string`, object, function or array through `any`, `unknown` and casts, and flow on as in plain JavaScript.
////= attempt
const hide = (v: unknown): any => v
attempt("a3", () => { const s: string = hide(undefined); return s + "!" })
attempt("a4", () => { const s: string = hide(null); return s + "!" })
attempt("a7", () => { const s: string = hide(undefined); return [typeof s, s === undefined, s == null, s ?? "default", s === s].join() })
attempt("a8", () => { const s: string = hide(null); return [typeof s, s === null, s == undefined, s ?? "default", s > "a", `${s}`].map(String).join() })
attempt("a9", () => { const s: string = hide(undefined); return s.length })
attempt("b3", () => `${hide(null) as string}/${hide(undefined) as string}`)
attempt("b4", () => (hide(undefined) as string) === undefined)
attempt("b5", () => { const o: { x: number } = hide(null); const f: () => void = hide(undefined); const a: number[] = hide(null); return [o, f, a].map(String).join() })
attempt("b6", () => { const o: { x: number } = hide(null); return o.x })
attempt("b7", () => { const f: () => void = hide(undefined); return f() })
attempt("b8", () => { const a: number[] = hide(null); return a.length })
// On into fields, elements, parameters, results.
interface Rec { n: number; s: string; o: { x: number }; m?: number; u: number | undefined; l: boolean | null }
const rec: Rec = { n: 1, s: "s", o: { x: 1 }, u: 1, l: true }
function show(o: object): string { return Object.keys(o).join() + " " + JSON.stringify(o) }
attempt("c1", () => { rec.s = hide(undefined); return show(rec) + " " + rec.s + " " + ("s" in rec) })
attempt("c2", () => { rec.s = hide(null); return show(rec) + " " + rec.s + " " + (rec.s + "1") })
attempt("c3", () => { rec.o = hide(undefined); return show(rec) + " " + rec.o })
attempt("c4", () => { rec.m = hide(undefined); rec.u = hide(undefined); rec.l = hide(null); return show(rec) + " " + rec.m + rec.u + rec.l })
attempt("c5", () => { rec.n = 2; rec.s = "t"; rec.o = { x: 2 }; return show(rec) + " " + (rec.n + 1) + rec.s + rec.o.x })
attempt("c6", () => { const made: Rec = { n: 0, s: hide(null), o: hide(undefined), u: hide(undefined), l: hide(null) }; return show(made) + " " + made.s + made.o + made.u + made.l })
const texts: string[] = ["a", "b"]
attempt("d1", () => { texts[1] = hide(undefined); texts[2] = hide(null); return texts.length + " " + JSON.stringify(texts) + " " + (texts[1] + "1") + " " + (texts[2] + "1") })
attempt("d2", () => { let s = ""; for (const t of texts) s += t; return s })
function exclaim(s: string): string { return s + "!" }
function withDefault(s: string = "d", n: number = 10): string { return s + "/" + n }
function back(v: any): string { return v }
attempt("e1", () => [exclaim(hide(undefined)), exclaim(hide(null)), withDefault(hide(undefined), hide(undefined)), withDefault(hide(null))].join())
attempt("e2", () => [back(undefined), back(null), back(undefined) + "1", back(null) + "1"].map(String).join())
attempt("e3", () => [(exclaim as any)(), (exclaim as any)(null), (withDefault as any)(), (withDefault as any)(null)].join())
class Label { constructor(public text: string, public unit: string = "C") {} all() { return this.text + "/" + this.unit } }
attempt("e4", () => new (Label as any)().all() + " " + show(new (Label as any)()) + " " + new (Label as any)(null, null).all())
// Captured variables and loops.
attempt("f1", () => { let acc: string = ""; const set = (v: any) => { acc = v }; set(undefined); const seen = String(acc); set("3"); return seen + acc })
attempt("f2", () => { let out = ""; for (const v of ["1", undefined, "2", null, "3"] as any[]) { const s: string = v; out += (s + "1") + "," } return out })
attempt("f3", () => { const u: number | undefined = hide(undefined); const w: string | null = hide(undefined); const x: boolean | null = hide(null); return String(u) + String(w) + String(x) })
//// number-fields-stored-only-int32s.ts
// Every store to these `number` fields that the program shows puts an int32 into them: constants, bit operations, sums, copies, parameters and results that hold nothing else. So they are kept in four bytes.
// Stores under computed names, which show nothing, then bring every kind of number, and each is read back as it was stored.
declare const console: { log(...values: unknown[]): void };

type Flags = number;
const NoFlags: Flags = 0b0; const Placement: Flags = 0b10; const Update: Flags = 0b100; const StaticMask: Flags = 0b1100000;
interface Fiber { tag: number; flags: Flags; subtreeFlags: Flags; lanes: number; childLanes: number; index: number; ratio: number; child: Fiber | null; sibling: Fiber | null }
function FiberNode(this: Fiber, tag: number) {
    this.tag = tag; this.flags = NoFlags; this.subtreeFlags = NoFlags; this.lanes = 0; this.childLanes = 0; this.index = 0; this.ratio = 1; this.child = null; this.sibling = null;
}
function create(tag: number): Fiber { return new (FiberNode as any)(tag); }
function mergeLanes(a: number, b: number): number { return a | b; }
function bubble(f: Fiber): void {
    let subtreeFlags = NoFlags; let lanes = 0;
    for (let child = f.child; child !== null; child = child.sibling) {
        lanes = mergeLanes(lanes, mergeLanes(child.lanes, child.childLanes));
        subtreeFlags |= child.subtreeFlags & StaticMask; subtreeFlags |= child.flags;
    }
    f.subtreeFlags |= subtreeFlags; f.childLanes = lanes;
}
function mark(f: Fiber): void { f.flags |= Update; f.flags &= ~Placement; f.index++; f.ratio = f.ratio / 3; }
function copy(to: Fiber, from: Fiber): void { to.flags = from.flags & StaticMask; to.lanes = from.lanes; to.index = from.index; to.tag = from.tag; }

class Counter {
    hits = 0; mask = 0; total = 0; last: number | undefined = undefined;
    constructor(public step: number) {}
    bump(): void { this.last = this.hits; this.hits++; this.mask |= 1 << (this.hits & 7); this.total = this.total + this.step; }
}

function show(value: unknown): string { return typeof value === "number" && Object.is(value, -0) ? "-0" : String(value); }
function ofFiber(f: Fiber): string {
    return [f.tag, f.flags, f.subtreeFlags, f.lanes, f.childLanes, f.index, f.ratio, f.flags & Update, f.flags | 1, ~f.lanes, f.lanes >>> 1, f.index + 1, f.index * 2, f.tag === 3, f.tag < 2, -f.index, 1 / f.flags, [7, 8, 9][f.index], f.lanes ? 1 : 0].map(show).join(" ");
}
function ofCounter(c: Counter): string { return [c.hits, c.mask, c.total, c.last, c.step, c.hits & 3, c.total - 1, c.mask ^ 5, c.last === undefined].map(show).join(" "); }
function poke(target: any, name: string, value: unknown): void { target[name] = value; }
function peek(target: any, name: string): unknown { return target[name]; }

const root = create(3); let last: Fiber | null = null;
for (let i = 0; i < 5; i++) { const c = create(i); c.sibling = last; c.lanes = 1 << i; mark(c); last = c; }
root.child = last; bubble(root); const twin = create(1); copy(twin, root.child!);
console.log(ofFiber(root)); console.log(ofFiber(twin)); console.log(ofFiber(root.child!));
const counter = new Counter(2); for (let i = 0; i < 10; i++) counter.bump(); console.log(ofCounter(counter));

const fiberNames: string[] = JSON.parse('["tag","flags","subtreeFlags","lanes","childLanes","index"]');
const counterNames: string[] = JSON.parse('["hits","mask","total","last","step"]');
const numbers: number[] = JSON.parse("[0,-0,1,-1,0.5,-0.5,2147483646,2147483647,2147483648,-2147483642,-2147483643,-2147483644,-2147483645,-2147483646,-2147483647,-2147483648,-2147483649,4294967295,4294967296,9007199254740992,1e21,5e-324,1e400,-1e400]");
numbers.push(Number("x"));
for (const n of numbers) {
    const f = create(2); const c = new Counter(1); c.bump();
    for (const name of fiberNames) poke(f, name, n);
    for (const name of counterNames) poke(c, name, n);
    console.log(ofFiber(f), fiberNames.every(name => Object.is(peek(f, name), n)), Object.keys(f).join());
    console.log(ofCounter(c), counterNames.every(name => Object.is(peek(c, name), n)), Object.keys(c).join());
    mark(f); c.bump(); const g = create(0); copy(g, f); f.child = g; bubble(f);
    console.log(ofFiber(f)); console.log(ofFiber(g)); console.log(ofCounter(c));
    f.flags = NoFlags; f.lanes = 1; f.index = 0; f.tag = 3; console.log(ofFiber(f), JSON.stringify(f.child), Object.keys(f).join());
}
//// number-fields-that-held-integers-are-stored-by-name-by-key-and-by-built-ins.ts
// Fields declared `number` that have held integers alone get fractions, 2 ** 40, -0, NaN, 1e300, a text and null: by a constant key through `any`, by a computed key, Object.assign, Reflect.set, defineProperty, a walk over the keys, `++` past the largest int32, and a product.
class C { n: number = 0; m: number = 1; constructor(public k: number) {} }
const c = new C(3);
c.n = 5; console.log(c.n + c.m + c.k);
const any: any = c;
any["n"] = 1.5; console.log(c.n, c.n * 2);
Object.assign(c, { m: 2 ** 40 }); console.log(c.m, c.m + 1);
Reflect.set(c, "k", -0); console.log(Object.is(c.k, -0), 1 / c.k);
const key = ["n", "m"][Date.now() > 0 ? 0 : 1]; any[key] = NaN; console.log(c.n, c.n === c.n);
Object.defineProperty(c, "m", { value: 0.25, writable: true, enumerable: true, configurable: true }); console.log(c.m * 4);
for (const k of Object.keys(c)) any[k] = 1e300; console.log(c.n, c.m, c.k);
const d = new C(2147483647); d.k++; console.log(d.k); d.k += 0.5; console.log(d.k);
const e = Object.assign(new C(1), JSON.parse('{"n":1.25,"m":"str","k":null}')); console.log(e.n, e.m, e.k, typeof e.m);
function bump(o: C) { o.n = o.n * 1000000; return o.n; } const f = new C(0); f.n = 2000000; console.log(bump(f), bump(f));
//// number-parameters-of-functions-that-are-only-called.ts
// A `number` parameter of a function that is only called, never handed on. Where every call passes an int32 by its type, a counter that runs up to the parameter
// is an int32 and fills an int32 field. A sum of two int32s only looks like one: here it leaves int32 at run time, in both directions, and has to arrive whole.
interface Link {
  value: number;
  next: Link | null;
}
function makeList(n: number): Link | null {
  let head: Link | null = null;
  for (let i = 0; i < n; i++) head = { value: i, next: head };
  return head;
}
function sumList(head: Link | null): number {
  let total = 0;
  for (let p = head; p !== null; p = p.next) total += p.value;
  return total;
}
console.log(sumList(makeList(1000)), sumList(makeList(0)), sumList(makeList(3)));

const one = process.argv.length > 100 ? 5 : 1;
const most = 2147483647;
const least = -2147483648;

////= lines-16	Kept	kept	number
function keep(value: number): Kept {
  return { kept: value };
}
const keptValues = [keep(7), keep(most + one), keep(least - one), keep(most), keep(least)];
console.log(keptValues.map(entry => entry.kept).join(" "));

function makeListFrom(start: number, n: number): Link | null {
  let head: Link | null = null;
  for (let i = 0; i < n; i++) head = { value: start + i, next: head };
  return head;
}
console.log(sumList(makeListFrom(most - 2, 6)), sumList(makeListFrom(5, 4)));

function countTo(limit: number): number {
  let last = -1;
  for (let i = 0; i < limit; i++) last = i;
  return last;
}
console.log(countTo(10), countTo(0), countTo(-3));

function countToMaybeFraction(limit: number): number {
  let steps = 0;
  for (let i = 0; i < limit; i++) steps++;
  return steps;
}
console.log(countToMaybeFraction(4), countToMaybeFraction(4.5), countToMaybeFraction(NaN));

function outer(n: number): number {
  return sumList(makeListThroughOuter(n));
}
function makeListThroughOuter(n: number): Link | null {
  let head: Link | null = null;
  for (let i = 0; i < n; i++) head = { value: i * 2, next: head };
  return head;
}
console.log(outer(100), outer(1));

function leftOut(n?: number): string {
  return typeof n + " " + n;
}
function sometimesLeftOut(n: number): string {
  return typeof n + " " + n;
}
console.log(leftOut(), leftOut(3), sometimesLeftOut(3), (sometimesLeftOut as () => string)());
//// number-parameters-that-callers-fill-with-int32s.ts
// Every call the program shows passes an int32 for these parameters of type number, so the compiler may test for one.
// Whatever else arrives, from a caller it doesn't see or through `any`, gives what plain Bun gives.

let limit = (process.argv.length + 1000000) | 0;

function makeAdder(k: number): (a: number) => number {
  return (a: number): number => {
    if (limit < 0) limit = (limit + 1) | 0;
    return (a + k) | 0;
  };
}

function sum(a: number, b: number): number {
  return a + b;
}

function half(a: number): number {
  return a / 2;
}

function index(list: number[], at: number): number | undefined {
  return list[at];
}

function twice(f: (a: number) => number, r: number): number {
  r = f(r);
  r = f(r);
  return r;
}

const launder = new Function("v", "return v") as <V>(v: V) => V;
const addTwo = launder(makeAdder(2));
const addThree = launder(makeAdder(3));
const list = [10, 20, 30];

let total = 0;
for (let i = 0; i < 1000; i++) {
  total = (total + twice((i & 1) === 0 ? addTwo : addThree, i) + sum(i, 1) + half(i * 2) + (index(list, i % 3) ?? 0)) | 0;
}
console.log("int32s only", total);

function show(value: unknown): string {
  return `${typeof value} ${Object.is(value, -0) ? "-0" : String(value)}`;
}

const impostors: unknown[] = [0.5, NaN, -0, 2 ** 31, -(2 ** 31) - 1, 2 ** 53, Infinity, -Infinity, 1e-300, "7", "", null, undefined, true, { valueOf: () => 4 }, [5], 6n];

for (const impostor of impostors) {
  const lines: string[] = [];
  const attempt = (label: string, run: () => unknown): void => {
    try {
      lines.push(`${label} ${show(run())}`);
    } catch (error) {
      lines.push(`${label} threw ${(error as Error).constructor.name}`);
    }
  };
  attempt("adder", () => addTwo(impostor as number));
  attempt("made with", () => makeAdder(impostor as number)(1));
  attempt("sum left", () => sum(impostor as number, 1));
  attempt("sum right", () => sum(1, impostor as number));
  attempt("half", () => half(impostor as number));
  attempt("index", () => index(list, impostor as number));
  attempt("twice", () => twice(addThree, impostor as number));
  console.log(`${show(impostor)}: ${lines.join("; ")}`);
}

const evaluated = new Function("adder", "sum", "half", "return [adder('1'), adder(1.5), sum('a', 'b'), sum(0.1, 0.2), half('9'), adder(), sum()].map(String).join()");
console.log("from evaluated text", evaluated(addTwo, sum, half));

total = 0;
for (let i = 0; i < 1000; i++) total = (total + twice(addTwo, i) + sum(i, 1)) | 0;
console.log("int32s again", total);
//// number-strings-survive-gc.ts
// The engine keeps the strings of numbers it has converted. Whatever it hands out again after any number of collections is still the right text.
const shell = globalThis as any;
const collect: (full: boolean) => void = shell.Bun ? (full: boolean) => shell.Bun.gc(full) : (full: boolean) => (full ? shell.fullGC() : shell.edenGC());
const kept: string[] = [];
const keptOf: number[] = [];
let checked = 0;
let wrong = 0;
let length = 0;

function text(n: number): string {
  return String(n);
}

function check(n: number): void {
  const s = text(n);
  checked++;
  length += s.length;
  if (Number(s) !== n) wrong++;
}

for (let round = 0; round < 40; round++) {
  for (let i = 0; i < 1500; i++) {
    check(i);
    check(1024 + ((i * 7 + round) % 5000));
    check(100000 + i * 1024 + round);
    check(i + round / 4 + 0.125);
    check(-i - round);
  }
  for (let i = 0; i < 20; i++) {
    const n = round * 1000 + i * 37;
    kept.push(text(n));
    keptOf.push(n);
    const d = n + 0.5;
    kept.push(text(d));
    keptOf.push(d);
  }
  collect(round % 7 === 6);
  for (let i = 0; i < 300; i++) {
    check(i * 3);
    check(2000 + i + round);
    check(i / 8);
  }
  collect(false);
  collect(false);
}
let keptWrong = 0;
for (let i = 0; i < kept.length; i++) if (Number(kept[i]) !== keptOf[i] || kept[i] !== text(keptOf[i])) keptWrong++;
let many = 0;
for (let i = 0; i < 30000; i++) many += text(i * 13 + 5000).length + text(i * 0.75).length;
collect(false);
for (let i = 0; i < 30000; i += 97) check(i * 13 + 5000);
console.log(checked, wrong, length, kept.length, keptWrong, many);
//// numeric-discriminant-unions.ts
// Unions discriminated by numbers, enum members, booleans, null and undefined, and bit flags that say which fields an object has.
function show(o: object): string { return Object.keys(o).join() + " " + JSON.stringify(o) }
enum Tag { Leaf, Pair, Triple = 5, Neg = -1 }
type Leaf = { tag: Tag.Leaf; v: number }
type Pair = { tag: Tag.Pair; l: Term; r: Term }
type Triple = { tag: Tag.Triple; a: Term; b: Term; c: Term }
type Neg = { tag: Tag.Neg; of: Term }
type Term = Leaf | Pair | Triple | Neg
function evaluate(t: Term): number {
  switch (t.tag) {
    case Tag.Leaf: return t.v
    case Tag.Pair: return evaluate(t.l) + evaluate(t.r)
    case Tag.Triple: return evaluate(t.a) * evaluate(t.b) - evaluate(t.c)
    case Tag.Neg: return -evaluate(t.of)
  }
}
const leaf = (v: number): Leaf => ({ tag: Tag.Leaf, v })
const term: Term = { tag: Tag.Triple, a: { l: leaf(1), r: leaf(2.5), tag: Tag.Pair }, b: { of: leaf(2), tag: Tag.Neg }, c: leaf(0) }
console.log(evaluate(term), Object.is(evaluate({ tag: Tag.Neg, of: leaf(0) }), -0), show(term), Tag[term.tag], Tag[-1], Tag.Neg, typeof term.tag)
const parsedTerm: Term = JSON.parse('{"tag":1,"l":{"tag":0,"v":4},"r":{"tag":-1,"of":{"v":1,"tag":0}}}')
console.log(evaluate(parsedTerm), evaluate({ tag: Tag.Pair, l: parsedTerm, r: term }))

// Number literals, among them a fraction, a negative and zero.
type Versioned = { version: 0; raw: string } | { version: 1; label: string } | { version: 2; label: string; extra: number } | { version: 2.5; label: string; extras: number[] } | { version: -1; broken: true }
function upgrade(v: Versioned): string {
  switch (v.version) {
    case 0: return "raw " + v.raw
    case 1: return "one " + v.label
    case 2: return "two " + v.label + v.extra
    case 2.5: return "two and a half " + v.label + v.extras.length
    case -1: return "broken " + v.broken
  }
}
const versions: Versioned[] = [{ version: 0, raw: "r" }, { label: "a", version: 1 }, { version: 2, extra: 9, label: "b" }, { extras: [1, 2], version: 2.5, label: "c" }, { version: -1, broken: true }, JSON.parse('{"version":2.5,"label":"j","extras":[]}')]
console.log(versions.map(upgrade).join(" ; "), versions.map(v => v.version).join())

// true and false.
type Outcome<T> = { ok: true; value: T } | { ok: false; error: string }
function divide(x: number, y: number): Outcome<number> { return y === 0 ? { ok: false, error: "by zero" } : { value: x / y, ok: true } }
function unwrap<T>(o: Outcome<T>, otherwise: T): T { return o.ok ? o.value : otherwise }
function explain(o: Outcome<unknown>): string { return o.ok === true ? "ok " + typeof o.value : !o.ok ? "error " + o.error.length : "never" }
const outcomes = [divide(1, 2), divide(1, 0), divide(-1, Infinity), divide(0, 5)]
console.log(outcomes.map(o => unwrap(o, -1)).map(n => Object.is(n, -0) ? "-0" : String(n)).join(), outcomes.map(explain).join(), outcomes.map(show).join(" ; "))
const words: Outcome<string>[] = [{ ok: true, value: "" }, { ok: false, error: "" }, { value: "w", ok: true }]
console.log(words.map(o => unwrap(o, "otherwise")).join("|"), words.map(explain).join())

// null and undefined, and a field that is there in one branch only.
type Loaded = { error: null; data: number[] } | { error: string; data?: undefined }
type Perhaps = { present: undefined; fallback: string } | { present: { n: number } }
function dataOf(l: Loaded): string { return l.error === null ? l.data.join("+") : l.error + String(l.data) + ("data" in l) }
function nOf(p: Perhaps): string { return p.present === undefined ? p.fallback : String(p.present.n) }
console.log(([{ error: null, data: [1, 2] }, { error: "bad" }, { error: "", data: undefined }] as Loaded[]).map(dataOf).join(),([{ present: undefined, fallback: "f" }, { present: { n: 3 } }] as Perhaps[]).map(nOf).join())

// Bit flags: the value of a flags field is often not a member of the enum, and larger than all of them. (Casts to the interface that the flags imply, and a value beyond 32 bits: type-rules/numeric-discriminant-unions.)
const enum Has { None = 0, Label = 1, Count = 2, Child = 4, Deep = 1 << 20, Top = 1 << 30 }
interface Flagged { flags: Has }
interface WithLabel extends Flagged { label: string }
interface WithCount extends Flagged { count: number }
interface WithChild extends Flagged { child: Flagged }
type Whatever = Flagged & Partial<WithLabel & WithCount> & { child?: Whatever }
function make(flags: Has): Whatever {
  const made: Whatever = { flags }
  if (flags & Has.Label) made.label = "l" + flags
  if (flags & Has.Count) made.count = flags * 0.5
  if (flags & Has.Child) made.child = make(flags & ~Has.Child)
  return made
}
function inspect(f: Whatever): string {
  let out = String(f.flags)
  if (f.flags & Has.Label) out += " " + f.label
  if (f.flags & Has.Count) out += " " + f.count
  if (f.flags & Has.Child) out += " <" + inspect(f.child!) + ">"
  if (f.flags & (Has.Deep | Has.Top)) out += " high"
  return out
}
const flagged = [Has.None, Has.Label, Has.Label | Has.Count, Has.Label | Has.Count | Has.Child, Has.Child | Has.Deep, Has.Top | Has.Count, Has.Top | Has.Deep | 7].map(make)
console.log(flagged.map(inspect).join(" ; "))
console.log(flagged.map(show).join(" ; "))
for (const f of flagged) { f.flags |= Has.Deep; f.flags &= ~Has.Label }
console.log(flagged.map(inspect).join(" ; "), flagged.map(f => f.flags).join())
flagged[0].flags = ~0
flagged[1].flags = (Has.Top << 1) | Has.Count
flagged[2].flags = flagged[2].flags * 1024
console.log(flagged[0].flags, flagged[1].flags, flagged[2].flags, flagged[0].flags >>> 0, flagged[2].flags & Has.Count)

let total = 0
for (let i = 0; i < 4000; i++) total += evaluate(i & 1 ? term : parsedTerm) + upgrade(versions[i % 6]).length + unwrap(outcomes[i & 3], 1) + (flagged[3 + (i & 3)].flags & 7)
console.log(total)
//// object-assign-between-objects-of-known-types.ts
// Object.assign where the compiler knows the types of both sides: the fields are copied in line when the source has one of the key orders that its type foresees. Everything that the copy in line does not serve must come out the same: another key order, an extra property on the source, numbers kept in boxes, a frozen target, a field that is not there yet, an heir of the target's class, a setter.
const lines: string[] = [];
////= say-2
const own = (object: object) => Reflect.ownKeys(object).map(String).join();

class Point {
  x = 0;
  y = 0;
  label = "origin";
  visible = true;
  weight = 0.5;
  tag: string | null = null;
  next: Point | undefined = undefined;
}
////= lines-3	Point3	Point	z	0
type Patch = { x: number; y: number; label: string; visible: boolean };

function patch(point: Point, values: Patch) {
  return Object.assign(point, values);
}
function move(point: Point, values: { x: number; y: number }) {
  Object.assign(point, values);
  return point.x + point.y;
}
function weigh(point: Point, values: { weight: number }) {
  Object.assign(point, values);
  return point.weight;
}
function link(point: Point, values: { next: Point | undefined; tag: string | null }) {
  Object.assign(point, values);
  return [point.next === undefined ? "none" : point.next.label, point.tag];
}
function extend(point: Point, values: { color: string; size: number; x: number }) {
  const extended = Object.assign(point, values);
  return [own(extended), extended.color, extended.size, extended.x];
}
function both(point: Point, first: { x: number }, second: { y: number; x: number }) {
  Object.assign(point, first, second);
  return [point.x, point.y];
}

for (let turn = 0; turn < 4; turn++) {
  say("four fields " + turn, () => {
    const p = patch(new Point(), { x: turn, y: -turn, label: "p" + turn, visible: turn % 2 === 0 });
    return [own(p), p.x, p.y, p.label, p.visible, p.weight];
  });
  say("the other key order " + turn, () => {
    const p = patch(new Point(), { visible: false, label: "reversed", y: turn, x: 2 * turn });
    return [own(p), p.x, p.y, p.label, p.visible];
  });
  say("an heir of the class " + turn, () => {
    const p = new Point3();
    patch(p, { x: turn, y: 1, label: "heir", visible: false });
    return [own(p), p.x, p.label, p.z];
  });
  say("names beyond the class " + turn, () => extend(new Point(), { color: "red", size: turn + 0.5, x: turn }));
  say("names beyond the class, twice " + turn, () => {
    const p = new Point();
    extend(p, { color: "red", size: 1, x: 1 });
    return extend(p, { color: "blue", size: turn, x: 2 });
  });
  say("two sources " + turn, () => both(new Point(), { x: turn }, { y: turn + 1, x: turn + 2 }));
}
say("a source with one property more than its type says", () => {
  const wide = { x: 1, y: 2, label: "wide", visible: false, surplus: "kept" };
  const p: any = patch(new Point(), wide);
  return [own(p), p.surplus, p.x];
});
say("a source that got a property later, lost one, has an accessor", () => {
  const seen: unknown[] = [];
  const later: Patch = { x: 1, y: 2, label: "later", visible: true };
  (later as any).added = 1;
  seen.push(own(patch(new Point(), later)));
  const fewer: { x: number; y?: number } = { x: 5, y: 6 };
  delete fewer.y;
  seen.push(move(new Point(), fewer as { x: number; y: number }));
  let reads = 0;
  const computed = { x: 1, get y() { return ++reads; } };
  seen.push(move(new Point(), computed), move(new Point(), computed), reads);
  return seen;
});
say("numbers of every size", () => {
  const seen: unknown[] = [];
  const p = new Point();
  for (const n of [1, 1073741823, 1073741824, -1073741824, -1073741825, 4294967296, 0.25, -0, NaN, 2]) {
    seen.push(String(move(p, { x: n, y: 0 })), Object.is(p.x, -0));
    seen.push(String(weigh(p, { weight: n })));
  }
  return seen;
});
say("cells, undefined and null", () => {
  const seen: unknown[] = [];
  const p = new Point();
  const other = new Point();
  other.label = "other";
  seen.push(link(p, { next: other, tag: "tagged" }), link(p, { next: undefined, tag: null }), link(p, { next: p, tag: "" }));
  return seen;
});
say("a frozen, a sealed target", () => {
  const seen: unknown[] = [];
  for (const close of [(p: Point) => Object.freeze(p), (p: Point) => Object.seal(p), (p: Point) => Object.preventExtensions(p)]) {
    for (const work of [(p: Point) => move(p, { x: 1, y: 2 }), (p: Point) => extend(p, { color: "c", size: 1, x: 3 })]) {
      const p = close(new Point());
      try {
        seen.push(work(p));
      } catch (error) {
        seen.push((error as Error).constructor.name, p.x, own(p));
      }
    }
  }
  return seen;
});
class Late {
  first = 1;
  second?: number;
  third?: string;
}
say("fields that are not there yet", () => {
  const seen: unknown[] = [];
  const fill = (late: Late, values: { third: string; second: number }) => Object.assign(late, values);
  for (let turn = 0; turn < 3; turn++) {
    const late = fill(new Late(), { third: "t" + turn, second: turn });
    seen.push([own(late), late.second, late.third]);
    fill(late, { third: "again", second: -turn });
    seen.push([own(late), late.second, late.third]);
  }
  return seen;
});
class Watched {
  plain = 1;
  log = "";
  set seen(value: number) {
    this.log += value + ":" + this.plain + ";";
  }
  get seen() {
    return -1;
  }
}
say("a setter of the class, between two fields", () => {
  const fill = (watched: Watched, values: { seen: number; plain: number }) => Object.assign(watched, values);
  const after = (watched: Watched, values: { plain: number; seen: number }) => Object.assign(watched, values);
  return [fill(new Watched(), { seen: 5, plain: 2 }).log, after(new Watched(), { plain: 3, seen: 6 }).log];
});
say("the target is the source; the target is null", () => {
  const p = new Point();
  p.x = 4;
  const same = Object.assign(p, p);
  let thrown = "";
  try {
    patch(null as unknown as Point, { x: 1, y: 1, label: "", visible: true });
  } catch (error) {
    thrown = (error as Error).constructor.name;
  }
  return [same === p, p.x, thrown];
});
say("many objects, so that collections fall between the calls", () => {
  let sum = 0;
  let previous: Point | undefined = undefined;
  for (let i = 0; i < 30000; i++) {
    const p = patch(new Point(), { x: i, y: i & 7, label: "l" + (i & 15), visible: (i & 1) === 0 });
    link(p, { next: i & 3 ? previous : undefined, tag: i & 1 ? "t" + i : null });
    const extended = Object.assign(p, { color: "c" + (i & 3), size: i / 2, x: i + 1 });
    sum += extended.x + p.y + p.label.length + extended.color.length + extended.size + (p.next ? p.next.x : 0) + (p.tag ? p.tag.length : 0);
    previous = p;
  }
  return sum;
});

