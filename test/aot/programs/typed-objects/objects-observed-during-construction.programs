import * as typed from "./core.ts";
import * as untyped from "./untyped.js";
import { kept, probe } from "./probes.js";

function say(name: string, f: () => unknown) {
  let text: string;
  try {
    text = JSON.stringify(f()) ?? "undefined";
  } catch (error) {
    text = "throws " + (error as Error).constructor.name + ": " + (error as Error).message;
  }
  console.log(name + ": " + text);
}
const whole = (made: object) => [Object.keys(made).join(), JSON.stringify(made)];

say("seen by untyped code", () => {
  const made = new untyped.HeirOfCore(5);
  return [whole(made), typed.sumOfCore(made)];
});
////= say-7	"seen by typed code"	HeirOfSeenByTypedCode	sumOfSeenByTypedCode
////= say-7	"a typed heir between"	HeirOfMiddle	sumOfMiddle
say("a throw in the middle", () => {
  try {
    new untyped.HeirOfThrows();
  } catch (error) {
    const half = kept[kept.length - 1];
    return [(error as Error).message, whole(half), "c" in half, "d" in half, typed.sumOfThrows(half)];
  }
});
////= say-7	"seen in the constructor's body"	HeirOfInTheConstructor	sumOfInTheConstructor
say("initializers that name functions", () => {
  const made = new untyped.HeirOfNamesAFunction();
  return [Object.keys(made).join(), typed.sumOfNamesAFunction(made), made.named === typed.probeTyped, made.imported === probe];
});
say("fields are defined, not set", () => {
  const made = new untyped.HeirOfDefinedNotSet();
  return [whole(made), untyped.calls, typed.sumOfDefinedNotSet(made), Object.getOwnPropertyDescriptor(made, "bare")];
});
say("made by typed code and extended by untyped code", () => {
  const made = new untyped.HeirOfBoth();
  return [whole(typed.makeBoth()), whole(made), typed.sumOfBoth(made), typed.sumOfBoth(typed.makeBoth())];
});
say("seventy-four fields", () => {
  const made = new untyped.HeirOfWide();
  return [Object.keys(made).length, made.f30, made.f70, typed.sumOfWide(made), Object.keys(made).slice(28, 33).join()];
});
say("many", () => {
  let length = 0;
  for (let i = 0; i < 2000; ++i) length += new untyped.HeirOfCore(i).g.length + new untyped.HeirOfMiddle().n.length;
  return length;
});
//// open-classes-seen-in-the-middle-of-construction/probes.js
export function probe(seen) {
  const names = [];
  for (const name in seen) names.push(name);
  return [Object.keys(seen).join(), names.length, "h" in seen, Object.hasOwn(seen, "h"), typeof seen.f, JSON.stringify(seen), Object.keys({ ...seen }).length, Object.getOwnPropertyNames(seen).length].join("|");
}
export const kept = [];
export function keep(seen) {
  kept.push(seen);
  return kept.length;
}
export function fail(why) {
  if (why) throw new Error(why);
  return 0;
}
//// open-classes-seen-in-the-middle-of-construction/untyped.js
import { Core, SeenByTypedCode, Middle, Throws, InTheConstructor, NamesAFunction, DefinedNotSet, Both, Wide } from "./core.ts";
import { probe } from "./probes.js";

export class HeirOfCore extends Core {
  constructor(seed) {
    super(seed);
    this.own = 1;
  }
}
export class HeirOfSeenByTypedCode extends SeenByTypedCode {}
export class HeirOfMiddle extends Middle {
  own = probe(this);
}
export class HeirOfThrows extends Throws {}
export class HeirOfInTheConstructor extends InTheConstructor {}
export class HeirOfNamesAFunction extends NamesAFunction {}
export const calls = [];
export class HeirOfDefinedNotSet extends DefinedNotSet {
  set guarded(value) {
    calls.push("the setter of guarded ran");
  }
  get guarded() {
    return -1;
  }
  set alsoGuarded(value) {
    calls.push("the setter of alsoGuarded ran");
  }
  set bare(value) {
    calls.push("the setter of bare ran");
  }
}
export class HeirOfWide extends Wide {}
export class HeirOfBoth extends Both {}
//// open-classes-that-only-untyped-code-extends/core.ts
export interface Settings {
  name: string;
  base?: string;
  limit?: number;
}

export class Core {
  key: string | undefined = "k";
  marks: { n: boolean; h?: boolean } = { n: true };
  listeners = new Set<string>();
  committed: Array<number> = [];
  settings!: Settings;
  origin!: string;
  base!: string;
  limit!: number;
  later?: string;
  count = 0;
  #secret = 7;
  constructor(settings: Settings) {
    this.update({ limit: 5, ...settings });
  }
  update = (next: Settings) => {
    this.settings = { ...this.settings, ...next };
    this.base = this.settings.base ?? "/";
    this.origin = "http://" + this.settings.name;
    this.limit = this.settings.limit ?? 1;
  };
  step(n: number): number {
    this.count += n;
    this.committed.push(n);
    return this.count + this.limit + this.base.length + this.origin.length;
  }
  secret(): number {
    return this.#secret++;
  }
  #hidden(): string {
    return "hidden " + this.base;
  }
  reveal(): string {
    return this.#hidden();
  }
  static is(value: unknown): boolean {
    return value instanceof Core;
  }
}

export function describe(core: Core): string {
  return core.origin + core.base + " " + core.count + " " + core.limit + " " + core.key + " " + core.later;
}

export function rename(core: Core, name: string): void {
  core.update({ name });
  core.later = name;
}

export class Made {
  width: number;
  constructor(width: number) {
    this.width = width;
  }
  twice(): number {
    return this.width * 2;
  }
}

export function widthOf(made: Made): number {
  return made.width + made.twice();
}

export function makeOne(width: number): Made {
  return new Made(width);
}

export class OnlyExtended {
  label: string = "only";
  size!: number;
  seen: Array<string> = [];
  late?: string;
  constructor(size: number) {
    this.size = size;
  }
  grow(by: number): number {
    this.size += by;
    this.seen.push(this.label + this.size);
    return this.size;
  }
}

export function sizeOf(one: OnlyExtended): string {
  return one.label + " " + one.size + " " + one.seen.length + " " + one.late;
}
//// open-classes-that-only-untyped-code-extends/main.ts
import { Core, describe, rename, Made, widthOf, makeOne } from "./core.ts";
import { Heir, Further, anything, viaUnknownValue, look, Small, Smaller, isOne } from "./untyped.js";
import { sizeOf, type OnlyExtended } from "./core.ts";

////= say

say("an heir", () => look(new Heir({ name: "a" })));
say("an heir of the heir", () => look(new Further({ name: "bb", base: "/x", limit: 9 })));
say("its own field comes last", () => Object.keys(new Further({ name: "c" })).slice(-2));
say("steps", () => {
  const heir = new Heir({ name: "d" });
  return [heir.step(1), heir.step(2), heir.count, heir.committed];
});
say("typed functions take it", () => {
  const heir: Core = anything(new Heir({ name: "e" }));
  rename(heir, "renamed");
  return [describe(heir), heir.later, Object.keys(heir).includes("later")];
});
say("private members", () => {
  const heir = new Heir({ name: "f" });
  return [heir.secret(), heir.secret(), heir.reveal(), Core.is(heir), Core.is({})];
});
say("a private member of a stranger", () => Core.prototype.secret.call({}));
say("a method on a stranger", () => Core.prototype.step.call({ count: 1, committed: [], limit: 2, base: "ab", origin: "c" }, 3));
say("by a value nobody knows", () => {
  const made = viaUnknownValue([Heir, Core, Further], 1, { name: "g" });
  return [look(made), made.step(4), made.secret(), made.reveal(), Object.getPrototypeOf(made) === Core.prototype];
});
say("Reflect.construct, itself", () => look(Reflect.construct(Core, [{ name: "h" }])));
say("Reflect.construct, a function for target", () => {
  function Target() {}
  Target.prototype = { tag: "target" };
  const first = Reflect.construct(Core, [{ name: "i" }], Target);
  Target.prototype = { tag: "another" };
  const second = Reflect.construct(Core, [{ name: "j" }], Target);
  return [first.tag, second.tag, first.origin, second.origin, first instanceof Core];
});
say("many, each its own", () => {
  let total = 0;
  const all: Core[] = [];
  for (let i = 0; i < 3000; i++) {
    const heir: Core = i % 3 ? new Heir({ name: "n" + (i & 7) }) : new Further({ name: "m", limit: i });
    total += heir.step(i & 3);
    if (i % 500 === 0) all.push(heir);
  }
  all[0].marks.h = true;
  all[0].listeners.add("x");
  return [total, all.map((heir) => describe(heir)), all[1].marks, all[1].listeners.size, all[0].listeners.size];
});
say("fields are there before the constructor's stores", () => {
  class Early extends (anything(Core) as typeof Core) {
    constructor() {
      super({ name: "early" });
    }
  }
  return Object.keys(new Early());
});
say("deleted", () => {
  const heir = new Heir({ name: "k" }) as any;
  delete heir.key;
  return [describe(heir), Object.keys(heir).join(), heir.step(1)];
});
say("frozen", () => {
  const heir = Object.freeze(new Heir({ name: "l" }));
  return [Object.isFrozen(heir), (() => { try { heir.step(1); return "stored"; } catch (error) { return (error as Error).constructor.name; } })(), heir.count];
});
say("a class that typed code makes keeps its layout", () => {
  let total = 0;
  for (let i = 0; i < 100; i++) total += widthOf(anything(makeOne(i))) + widthOf(anything(new Made(1)));
  return total;
});
say("a class that is only extended", () => {
  const small: OnlyExtended = anything(new Small(3));
  const smaller: OnlyExtended = anything(new Smaller(5));
  small.late = "late";
  return [small.grow(1), smaller.grow(2), sizeOf(small), sizeOf(smaller), Object.keys(small).join(), Object.keys(smaller).join(), isOne(small), isOne({}), sizeOf(anything({ label: "plain", size: 1, seen: [] }))];
});
say("many of them", () => {
  let total = 0;
  for (let i = 0; i < 3000; i++) {
    const one: OnlyExtended = i & 1 ? new Small(i) : new Smaller(i);
    total += one.grow(i & 3) + one.seen.length;
  }
  return total;
});
//// open-classes-that-only-untyped-code-extends/untyped.js
import { Core, Made, describe, rename, widthOf, makeOne } from "./core.ts";

export class Heir extends Core {
  constructor(settings) {
    super(settings);
    this.extra = settings.name.length;
  }
  step(n) {
    return super.step(n) + 1000;
  }
}

export class Further extends Heir {
  own = "further";
}

export function anything(value) {
  return value;
}

export function viaUnknownValue(classes, index, settings) {
  const Chosen = classes[index];
  return new Chosen(settings);
}

export function look(core) {
  return [describe(core), Object.keys(core).join(), JSON.stringify(core.settings), core instanceof Core, core.constructor.name];
}

export { Core, Made, describe, rename, widthOf, makeOne };

import { OnlyExtended, sizeOf } from "./core.ts";

export class Small extends OnlyExtended {
  constructor(size) {
    super(size);
    this.more = size * 2;
  }
}

export class Smaller extends Small {}

export function isOne(value) {
  return value instanceof OnlyExtended;
}

export { sizeOf };
//// optional-fields-absent.ts
// Optional fields of a type are read, tested, written and deleted on objects that were created as other types without them.
interface Core { id: number }
interface Rich extends Core { count?: number; text?: string; flag?: boolean; child?: Core; run?: () => string; either?: number | string }
type Lean = { id: number; own: string }
class Instance { id = 3; own = "class" }
const optionalNames = ["count", "text", "flag", "child", "run", "either"]
function show(o: object): string { return Object.keys(o).join() + " " + JSON.stringify(o) }
function probe(r: Rich): string {
  return [r.count, r.text, r.flag, r.child === undefined ? "none" : r.child.id, r.run?.(), r.either].map(String).join("|") + " " +
    optionalNames.map(k => (k in r ? "1" : "0") + (Object.hasOwn(r, k) ? "1" : "0")).join("")
}
const core: Core = { id: 1 }
const lean: Lean = { id: 2, own: "lean" }
const instance = new Instance()
const bare: Rich = { id: 4 }
const explicit: Rich = { id: 5, count: undefined, text: undefined, flag: undefined, child: undefined, run: undefined, either: undefined }
const some: Rich = { flag: false, id: 6, count: 0, text: "" }
const views: Rich[] = [core, lean, instance, bare, explicit, some]
console.log(views.map(probe).join(" ; "))
console.log(views.map(show).join(" ; "))

function fill(r: Rich, n: number): void { r.count = n; r.flag = n > 2; if (n % 2) r.text = "t" + n; else r.either = n }
views.forEach((r, i) => fill(r, i))
console.log(views.map(probe).join(" ; "))
console.log(views.map(show).join(" ; "))
console.log(lean.own, instance.own, Object.keys(lean).join(), Object.keys(instance).join(), (lean as any).count, (instance as any).flag, instance instanceof Instance)

// Objects, functions and a union, late.
const leanAsRich: Rich = lean
leanAsRich.child = core
leanAsRich.run = () => "ran " + lean.own
leanAsRich.either = "str"
console.log(probe(lean), show(lean), leanAsRich.child === core)
leanAsRich.either = 2.5
leanAsRich.child = leanAsRich
console.log(leanAsRich.either, leanAsRich.child === lean, leanAsRich.child.id, Object.keys(lean).join())

// Deleted, then stored again: the key moves to the end. A store of undefined keeps the key.
function cycle(r: Rich): string {
  const steps: string[] = []
  steps.push(String(delete r.count), String(r.count), String("count" in r), Object.keys(r).join(""))
  r.count = 8
  steps.push(String(r.count), Object.keys(r).join(""))
  r.count = undefined
  steps.push(String(r.count), String("count" in r), Object.keys(r).join(""), JSON.stringify(r, (k, v) => k === "child" ? undefined : v))
  return steps.join(",")
}
console.log(views.map(cycle).join(" ; "))

// Operators that read before they store.
function operators(r: Rich): string {
  delete r.count; delete r.text; delete r.flag
  r.count ??= 7
  r.count ??= 8
  r.text ||= "filled"
  r.flag &&= false
  const before = "flag" in r
  r.flag ||= true
  r.count = (r.count ?? 0) + 1
  return [r.count, r.text, r.flag, before, Object.keys(r).join("")].join("/")
}
console.log(views.map(operators).join(" ; "))

// Values a compiler might have set aside to mean "absent".
const edges = [0, -0, -1, NaN, 2147483647, -2147483648, 4294967295, 2147483648, -2147483649, 9007199254740991, Infinity, 5e-324]
console.log(edges.map(v => { const r: Rich = { id: 0 }; const c: Core = r; (c as Rich).count = v; return (r.count === undefined ? "LOST" : Object.is(r.count, v)) + ("count" in r ? "" : "ABSENT") }).join())
console.log(["", "undefined", "null", "\0"].map(v => { const r: Rich = { id: 0 }; r.text = v; return (r.text === undefined ? "LOST" : r.text === v) + String("text" in r) }).join())

// No room is taken where the object does not allow a new property.
const sealedCore: Core = Object.preventExtensions({ id: 9 })
try { (sealedCore as Rich).count = 1; console.log("stored") } catch (e) { console.log((e as Error).constructor.name) }
console.log(show(sealedCore), probe(sealedCore))
const sealedRich: Rich = Object.seal<Rich>({ id: 10, text: "kept" })
try { sealedRich.count = 1; console.log("stored") } catch (e) { console.log((e as Error).constructor.name) }
sealedRich.text = "changed"
try { delete sealedRich.text; console.log("deleted") } catch (e) { console.log((e as Error).constructor.name) }
console.log(show(sealedRich), probe(sealedRich))

let total = 0
for (let i = 0; i < 3000; i++) { const r = views[i % views.length]; total += (r.count ?? 1) + (r.text ?? "").length + (r.flag ? 1 : 0) + (r.child?.id ?? 0) }
console.log(total)
//// optional-fields-come-late-in-every-order.ts
