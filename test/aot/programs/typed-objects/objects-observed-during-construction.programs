//// objects-observed-during-construction.ts
// Objects that are observed before their constructor has finished: registered, passed to a callback, or left half-initialized by an exception.
enum Kind { Leaf, Pair, Named }
type Mutable<T extends object> = { -readonly [K in keyof T]: T[K] }
interface Nd { readonly kind: Kind; serial: number; note?: string }
interface Leaf extends Nd { readonly kind: Kind.Leaf; readonly value: number }
interface Pair extends Nd { readonly kind: Kind.Pair; readonly first: Nd; readonly second: Nd; readonly weight: number }
interface Named extends Nd { readonly kind: Kind.Named; readonly label: string; readonly target?: Nd }
const registry: Nd[] = []
let onCreate: ((node: Nd) => void) | undefined
function Nd(this: Mutable<Nd>, kind: Kind) {
  this.kind = kind
  this.serial = registry.length
  registry.push(this)
  if (onCreate) onCreate(this)
}
const NdCtor = Nd as any as new (kind: Kind) => Nd
function base<T extends Nd>(kind: T["kind"]) { return new NdCtor(kind) as Mutable<T> }
function leaf(value: number): Leaf { const node = base<Leaf>(Kind.Leaf); node.value = value; return node }
function pair(first: () => Nd, second: () => Nd): Pair {
  const node = base<Pair>(Kind.Pair)
  node.first = first()
  node.weight = registry.length
  node.second = second()
  return node
}
function named(label: string, target?: Nd): Named {
  const node = base<Named>(Kind.Named)
  if (target) node.target = target
  node.label = label
  return node
}
function keys(o: object): string { return Object.keys(o).join() }
function last(): Nd { return registry[registry.length - 1] }
function attempt(label: string, f: () => string) { try { console.log(label, f()) } catch (e) { console.log(label, (e as Error).constructor.name, keys(last())) } }
function withHook<T>(hook: (node: Nd) => void, f: () => T): T { onCreate = hook; try { return f() } finally { onCreate = undefined } }

const seen: string[] = []
const p0 = withHook(n => seen.push(Kind[n.kind] + ":" + keys(n) + ":" + ("value" in n) + ("first" in n) + n.note), () => pair(() => leaf(1), () => named("n", leaf(2))))
console.log(seen.join(" "), keys(p0), keys(p0.first), keys(p0.second), p0.weight, registry.length)

// The thunks run while the pair is half made and find it in the registry.
function halfMade(): string { const half = registry.filter(n => n.kind === Kind.Pair).pop() as Pair; return keys(half) + " " + half.serial + " " + ("weight" in half) + " " + (half.first === undefined) + " " + (half.second === undefined) + " " + half.note }
const notes: string[] = []
const p1 = pair(() => { notes.push(halfMade()); return leaf(3) }, () => { notes.push(halfMade()); return leaf(4) })
notes.push(halfMade())
console.log(notes.join(" | "), (p1.first as Leaf).value + (p1.second as Leaf).value)

attempt("field first", () => { const l = withHook(n => { (n as any).value = 100 }, () => leaf(6)); const m = withHook(n => { (n as any).label = "pre"; (n as any).target = undefined }, () => named("post", l)); return keys(l) + " " + l.value + " " + keys(m) + " " + m.label + (m.target === l) })
attempt("not extensible", () => keys(withHook(n => { Object.preventExtensions(n) }, () => leaf(7))))
attempt("frozen", () => keys(withHook(n => { Object.freeze(n) }, () => named("f"))))
attempt("thrown in the middle", () => keys(pair(() => leaf(14), () => { throw new RangeError("second") })))
const broken = registry.filter(n => n.kind === Kind.Pair).pop() as Pair
console.log(keys(broken), broken.weight, (broken.first as Leaf).value, broken.second === undefined, "second" in broken, JSON.stringify(broken))
;(broken as Mutable<Pair>).second = broken.first
console.log(keys(broken), broken.second === broken.first)
attempt("thrown by the hook", () => keys(withHook(() => { throw new EvalError("hook") }, () => leaf(15))))

// The hook creates its own nodes, and stores the one being created in a typed field of another object.
const holder: { current?: Nd; all: Nd[] } = { all: [] }
let depth = 0
const nested = withHook(n => { holder.current = n; holder.all.push(n); if (depth++ < 2) named("inner" + depth, n) }, () => leaf(16))
console.log(holder.all.map(n => Kind[n.kind] + n.serial + ":" + keys(n)).join(" "), holder.current === nested, holder.all[0] === nested, (holder.all[1] as Named).target === nested, (holder.all[2] as Named).label)

let total = 0, orders = new Set<string>()
for (let i = 0; i < 9000; i++) {
  const hook = i % 3 === 0 ? (n: Nd) => { n.note = "n" + (i & 3) } : i % 3 === 1 ? (n: Nd) => { (n as any)["x" + (i & 1)] = i } : undefined
  onCreate = hook
  const l = i & 4 ? leaf(i) : named("l" + (i & 7))
  onCreate = undefined
  // The fields and the extra property are listed apart.
  orders.add(Object.keys(l).filter(k => k[0] !== "x").join() + "+" + Object.keys(l).filter(k => k[0] === "x").join())
  total += l.kind === Kind.Leaf ? l.value : l.label.length + (l.note ? l.note.length : 0)
}
console.log(total, [...orders].sort().join(" "), registry.length)
//// objects-of-every-maker-read-through-one-structural-type.ts
// A declared type is read through whatever fits it: a literal of the type, a literal with more names, a class instance, an instance of a subclass and what a constructor function makes all arrive at `TextRange`, none of them by a conversion that names both types.
type Mutable<T> = { -readonly [K in keyof T]: T[K] };
////= lines	TextRange	pos	number	end	number
interface Node {
  readonly kind: number;
  readonly pos: number;
  readonly end: number;
}
function NodeObject(this: Mutable<Node>, kind: number, pos: number, end: number) {
  this.pos = pos;
  this.end = end;
  this.kind = kind;
}
class Token {
  kind = 7;
  constructor(
    public end: number,
    public pos: number,
  ) {}
}
////= lines-3	Comment	Token	text	"note"
const width = (range: TextRange): number => range.end - range.pos;
const move = (range: TextRange, by: number): void => {
  range.pos += by;
  range.end += by;
};
const kindOf = (node: Node): number => node.kind;

const makers: (() => unknown)[] = [
  (): TextRange => ({ pos: 1, end: 4 }),
  () => ({ text: "wide", end: 9, pos: 2 }),
  () => new Token(30, 10),
  () => new Comment(8, 5),
  () => new (NodeObject as any)(3, 100, 250),
];

let total = 0;
for (let round = 0; round < 3; round++) {
  for (const make of makers) {
    const range = make() as TextRange;
    move(range, round);
    const measured = width(range);
    console.log(round, measured, range.pos, range.end, Object.keys(range).join());
    total += measured;
  }
}
console.log(total);
console.log(kindOf(new (NodeObject as any)(11, 0, 0)), kindOf(new Token(1, 0)), kindOf(new Comment(1, 0)));
//// objects-with-extra-properties.ts
// Structural subtyping: objects with more properties than the type through which they are used.
interface Narrow { id: number }
function keysOf(x: Narrow): string { return Object.keys(x).join() }
function copy(x: Narrow): Narrow { return { ...x } }
function json(x: Narrow): string { return JSON.stringify(x) }
function forIn(x: Narrow): string { const out: string[] = []; for (const k in x) out.push(k); return out.join() }
function rest(x: Narrow): string { const { id, ...others } = x; return id + JSON.stringify(others) + Object.keys(others).length }
function entries(x: Narrow): string { return Object.entries(x).map(([k, v]) => k + "=" + JSON.stringify(v)).join("&") }
function override(x: Narrow): string { return JSON.stringify({ ...x, id: -1 }) + JSON.stringify({ id: -1, ...(x as Partial<Narrow>) }) }
function idOnly({ id }: Narrow): number { return id }
class Row { cells = ["a"]; hidden?: string; constructor(public id: number, public owner: string) {} width() { return this.cells.length } }
class WideRow extends Row { more = true }
const wide = { id: 1, label: "w", nested: { deep: true }, list: [1, 2] }
const row = new Row(2, "r")
const wideRow = new WideRow(2, "wr")
const grown: Narrow = { id: 4 }
;(grown as any).added = "later"
;(grown as any)[7] = "seven"
;(grown as any)[Symbol.for("extra")] = "symbol"
const foreign: Narrow = JSON.parse('{"id":5,"z":0,"a":[{"id":6}]}')
const exact: Narrow = { id: 7 }
const all: Narrow[] = [wide, row, wideRow, grown, foreign, exact]
for (const f of [keysOf, json, forIn, rest, entries, override]) console.log(all.map(f).join(" ; "))
console.log(all.map(idOnly).join(), all.map(x => keysOf(copy(x))).join(" ; "))

// A copy is a plain object with the same own properties, and shares what they refer to.
const copied = copy(wide) as typeof wide
console.log(copied.label, copied.nested === wide.nested, copied.list === wide.list, copied === wide, copied.id)
const copiedRow = copy(row)
console.log(copiedRow instanceof Row, "width" in copiedRow, Reflect.get(copiedRow, "owner"), Reflect.get(copiedRow, "cells") === row.cells, Object.getPrototypeOf(copiedRow) === Object.prototype)
console.log(Object.getOwnPropertySymbols(copy(grown)).length, (copy(grown) as any)[7], Reflect.ownKeys(copy(grown)).map(String).join())

// A store through the narrow type leaves the rest alone; one through the wide type is seen by the narrow one.
function bump(x: Narrow): void { x.id += 10 }
all.forEach(bump)
console.log(all.map(json).join(" ; "))
wide.id = 0.5
row.id = -0
console.log(idOnly(wide), Object.is(idOnly(row), -0), wide.label, row.width(), wideRow.more, wideRow.id)

// An optional field of the class that was never set is not there; set, it comes last.
console.log(keysOf(row), "hidden" in row, row.hidden)
row.hidden = "shown"
console.log(keysOf(row), rest(row), json(copy(row)))

// Narrow types of narrow types, down to the empty one.
interface Narrower { }
function count(x: Narrower): number { return Object.keys(x).length }
function spreadCount(x: Narrower): number { return Object.keys({ ...x }).length }
console.log(all.map(count).join(), all.map(spreadCount).join(), count("str"), spreadCount("str"), count(5), spreadCount([1, 2]))

// Sorting, finding and grouping by the narrow type move whole objects.
const sorted = [...all].sort((x, y) => y.id - x.id)
console.log(sorted.map(json).join(" ; "))
const found = all.find(x => x.id === 15)
console.log(found === foreign, found === undefined ? "none" : keysOf(found), all.indexOf(wideRow), all.includes(exact))
const byParity: Record<string, Narrow[]> = {}
for (const x of all) (byParity[String(Math.floor(x.id) % 2 === 0)] ??= []).push(x)
console.log(Object.keys(byParity).join(), JSON.stringify(byParity))

// The result of a function that promises the narrow type and returns a literal with more, through a variable.
function build(id: number): Narrow { const made = { id, secret: "s" + id, at: [id] }; return made }
const built = [build(1), build(2)]
console.log(built.map(json).join(), built.map(rest).join(), built.map(x => { const more = { ...x, id: 0 }; return keysOf(more) }).join(" ; "))

let total = 0
for (let i = 0; i < 3000; i++) { const x = all[i % all.length]; total += idOnly(x) + count(x) }
console.log(total)
//// objects-without-fields-chosen-by-a-switch.ts
// The cases of a switch that each make an object of a class without fields, and meet again. Such an object is the smallest cell there is, and making one leaves the object made before it as it was.
class A {}
class B {}
class C {}
function make(kind: number): object | null {
  let made: object | null;
  switch (kind) {
    case 0:
      made = new A();
      break;
    case 1:
      made = new B();
      break;
    case 2:
      made = new C();
      break;
    default:
      made = null;
  }
  return made;
}
const all: (object | null)[] = [];
for (let i = 0; i < 300; i++) all.push(make(i % 4));
const classes = [A, B, C];
let right = 0;
for (let i = 0; i < all.length; i++) {
  const made = all[i];
  if (i % 4 === 3 ? made === null : made instanceof classes[i % 4]!) right++;
}
console.log(right + " of " + all.length + " are of the class that made them");
//// old-objects-keep-stored-values.ts
// Old objects are stored to between collections, from one of them to thousands: each keeps what was stored into it, however many the engine has to remember.
const shell = globalThis as any;
const collect: (full: boolean) => void = shell.Bun ? (full: boolean) => shell.Bun.gc(full) : (full: boolean) => (full ? shell.fullGC() : shell.edenGC());
class Item {
  constructor(
    public id: number,
    public text: string,
  ) {}
}
class Holder {
  value: Item | null = null;
  other: Item | null = null;
  constructor(public id: number) {}
}

const holders: Holder[] = [];
for (let i = 0; i < 5000; i++) holders.push(new Holder(i));
collect(true);

function store(holder: Holder, id: number): void {
  holder.value = new Item(id, "t" + (id % 13));
  if (id % 3 === 0) holder.other = new Item(id + 1, "o" + (id % 7));
}

const counts = [1, 2, 509, 510, 511, 1019, 1020, 1021, 1531, 3000, 5000];
let wrong = 0;
let checked = 0;
let junk = 0;
for (let round = 0; round < 66; round++) {
  const count = counts[round % counts.length];
  const base = (round + 1) * 100000;
  for (let i = 0; i < count; i++) store(holders[(i * 7 + round) % holders.length], base + i);
  if (round % 4 === 1) {
    collect(false);
    for (let i = 0; i < count; i += 2) store(holders[(i * 7 + round) % holders.length], base + i);
  }
  for (let i = 0; i < 4000; i++) junk += new Item(i, "junk" + (i % 11)).text.length;
  collect(round % 6 === 5);
  for (let i = 0; i < 4000; i++) junk += new Item(i, "more" + (i % 5)).text.length;
  if (round % 5 === 2) collect(false);
  for (let i = 0; i < count; i++) {
    const holder = holders[(i * 7 + round) % holders.length];
    const id = base + i;
    checked++;
    if (holder.value === null || holder.value.id !== id || holder.value.text !== "t" + (id % 13)) wrong++;
    if (id % 3 === 0 && (holder.other === null || holder.other.id !== id + 1 || holder.other.text !== "o" + (id % 7))) wrong++;
  }
}
let kept = 0;
for (const holder of holders) if (holder.value !== null) kept += holder.value.id % 1000;
console.log(checked, wrong, kept, junk);
//// old-style-inheritance-spares-arrays.ts
// Constructors chained with Object.setPrototypeOf, as transpiled classes, util.inherits and Babel's helpers chain them, and objects whose prototype is
// stored to: none of it concerns an index. The arrays of the program go on keeping their elements in place. `describe` is the jsc shell's.
const describe: ((value: unknown) => string) | undefined = (globalThis as any).describe;
function arraysAreSlow(): boolean { const made = [1, 2, 3]; made.push(4); return describe !== undefined && /SlowPut/.test(describe(made)); }
console.log("at the start", arraysAreSlow());

function f1() { return 1; }
function g1() { return 2; }
const h1 = Object.create(f1);
Object.setPrototypeOf(f1, g1);
console.log("created from it, then chained", typeof h1, f1(), g1(), arraysAreSlow());

function f2() { return 1; }
function g2() { return 2; }
Object.setPrototypeOf(f2, g2);
const h2 = Object.create(f2);
console.log("chained, then created from it", typeof h2, f2(), g2(), arraysAreSlow());

function Base(this: any) { this.a = 1; }
function Mid(this: any) { this.b = 2; }
function Leaf(this: any) { this.c = 3; }
Object.setPrototypeOf(Leaf, Mid);
Object.setPrototypeOf(Mid, Base);
console.log("three in a chain", Object.getPrototypeOf(Leaf) === Mid, Object.getPrototypeOf(Mid) === Base, arraysAreSlow());

let extendStatics = function (d: any, b: any): any {
  extendStatics = Object.setPrototypeOf || function (d: any, b: any) { for (const p in b) if (Object.prototype.hasOwnProperty.call(b, p)) d[p] = b[p]; };
  return extendStatics(d, b);
};
function __extends(d: any, b: any): void {
  extendStatics(d, b);
  function __(this: any) { this.constructor = d; }
  d.prototype = b === null ? Object.create(b) : (((__ as any).prototype = b.prototype), new (__ as any)());
}
const Animal: any = (function () { function Animal(this: any, name: string) { this.name = name; } Animal.prototype.speak = function () { return this.name + " speaks"; }; (Animal as any).kinds = 2; return Animal; })();
const Dog: any = (function (_super: any) { __extends(Dog, _super); function Dog(this: any, name: string) { return _super.call(this, name) || this; } Dog.prototype.fetch = function () { return this.name + " fetches"; }; return Dog; })(Animal);
const Puppy: any = (function (_super: any) { __extends(Puppy, _super); function Puppy(this: any) { return (_super !== null && _super.apply(this, arguments)) || this; } return Puppy; })(Dog);
const puppy = new Puppy("rex");
console.log("__extends", puppy.speak(), puppy.fetch(), Puppy.kinds, puppy instanceof Animal, arraysAreSlow());

function inherits(ctor: any, superCtor: any): void { Object.defineProperty(ctor, "super_", { value: superCtor, writable: true, configurable: true }); Object.setPrototypeOf(ctor.prototype, superCtor.prototype); }
function Emitter(this: any) { this.listeners = []; }
Emitter.prototype.on = function (this: any, listener: () => void) { this.listeners.push(listener); return this.listeners.length; };
function Stream(this: any) { (Emitter as any).call(this); }
inherits(Stream, Emitter);
function Socket(this: any) { (Stream as any).call(this); }
inherits(Socket, Stream);
console.log("util.inherits", new (Socket as any)().on(() => {}), (Socket as any).super_ === Stream, arraysAreSlow());

function _setPrototypeOf(o: any, p: any): any { return Object.setPrototypeOf(o, p); }
function _inherits(subClass: any, superClass: any): void {
  subClass.prototype = Object.create(superClass && superClass.prototype, { constructor: { value: subClass, writable: true, configurable: true } });
  Object.defineProperty(subClass, "prototype", { writable: false });
  if (superClass) _setPrototypeOf(subClass, superClass);
}
function Shape(this: any) { this.sides = 0; }
(Shape as any).count = 7;
function Square(this: any) { (Shape as any).call(this); this.sides = 4; }
_inherits(Square, Shape);
function Tile(this: any) { (Square as any).call(this); }
_inherits(Tile, Square);
console.log("_inherits", new (Tile as any)().sides, (Tile as any).count, arraysAreSlow());

const methods = { first() { return "a"; }, second() { return "b"; } };
(methods as any).__proto__ = { third() { return "c"; } };
console.log("a store to __proto__ of a literal", (methods as any).third(), arraysAreSlow());

type Point = { x: number; y: number };
const origin: Point = { x: 0, y: 0 };
const moved: Point = { x: 1, y: 2 };
const heir = Object.create(origin);
const chain = (object: object, prototype: object): void => { Object.setPrototypeOf(object, prototype); };
chain(origin, moved);
chain(moved, { z: 3 });
console.log("records in a chain", heir.x, (heir as any).z, arraysAreSlow());

class Counter { count = 0; add(): number { return ++this.count; } }
const counter = new Counter();
const onTop = Object.create(counter);
Object.setPrototypeOf(onTop, Object.create(counter));
console.log("an instance as a prototype", onTop.add(), counter.count, arraysAreSlow());

const arrow = () => 1;
const bound = f1.bind(null);
Object.setPrototypeOf(arrow, bound);
Object.setPrototypeOf(bound, g1);
console.log("an arrow function and a bound one", Object.getPrototypeOf(arrow) === bound, Object.create(arrow) !== null, arraysAreSlow());

class Parent { static made = 1; }
class Child extends Parent {}
class Grandchild extends Child {}
const fromClass = Object.create(Grandchild);
console.log("classes", Grandchild.made, fromClass.made, Object.getPrototypeOf(Grandchild) === Child, arraysAreSlow());

type Table = { 1: string; 2: string; name: string };
const tables: Table[] = [];
for (let i = 0; i < 3; i++) tables.push({ 1: "a" + i, 2: "b" + i, name: "t" + i });
type Pair = { left: number; right: number };
const keyed: Pair = { left: 7, right: 8 };
(keyed as any)[5] = "five";
function numbered() { return 0; }
(numbered as any)[3] = "three";
console.log("indices on what nothing inherits from", tables[2][1], Object.keys(tables[0]).join(), (keyed as any)[5], (numbered as any)[3], arraysAreSlow());

const above: Pair = { left: 1, right: 2 };
Object.setPrototypeOf(above, Array.prototype);
const sparse: any = [0, , 2];
Object.setPrototypeOf(sparse, above);
(above as any)[1] = "one";
console.log("an element of a record that an array inherits from", sparse[1], sparse.indexOf("one"), sparse.join(), sparse.slice(0).join(), 1 in sparse, arraysAreSlow());

const middle: any = Object.create(null);
const lowest = Object.create(middle);
Object.setPrototypeOf(middle, counter);
console.log("an instance above what others inherit from", lowest.add(), lowest.count, arraysAreSlow());

class Sealed { readonly kind = "sealed"; constructor(public size: number) {} area(): number { return this.size * this.size; } }
function Wrapper(this: any) { this.own = 1; }
new (Wrapper as any)();
Object.setPrototypeOf(Wrapper.prototype, new Sealed(3));
console.log("an instance above the prototype of a function", new (Wrapper as any)().area(), arraysAreSlow());
//// old-typed-objects-gain-fields.ts
// Typed objects that have grown OLD are given optional fields with values that are no cells: records, members of a union, instances of classes, of subclasses and of a class that every round makes anew, records under a prototype that every round makes anew, and records that were parsed. What such a store gives the object besides the value (another shape, storage) is young, and a collection of the young looks at an old object only if it has been told of it.
declare const edenGC: undefined | (() => void);
let kept = 0;
const garbage = typeof edenGC === "function" ? 3000 : 150000;
function churn() { for (let i = 0; i < garbage; i++) kept += JSON.parse('{"a":1,"b":2,"c":3}').c + [i, i + 1, i + 2, i + 3].length; if (typeof edenGC === "function") edenGC(); }
type Opt = { a: number; b?: number; c?: boolean; d?: number | null };
type Circle = { kind: "circle"; r: number; area?: number };
type Square = { kind: "square"; s: number; area?: number };
type Shape = Circle | Square;
interface Node1 { id: number; next?: Node1; weight?: number }
class Base { x = 1; y?: number; z?: boolean; }
class Derived extends Base { w = 2; v?: number; }
function classOf(round: number) { return class Local { p = round; q?: number; r?: boolean; get twice() { return this.p * 2; } }; }
const makeOpt = (i: number): Opt => ({ a: i });
const makeShape = (i: number): Shape => (i & 1 ? { kind: "circle", r: i } : { kind: "square", s: i });
const makeNode = (i: number): Node1 => ({ id: i });
function setB(o: Opt, v: number) { o.b = v; }
function setCD(o: Opt, v: number) { o.c = v > 1; o.d = v & 1 ? null : v; }
function setArea(s: Shape) { s.area = s.kind === "circle" ? s.r * 3 : s.s * s.s; }
function setWeight(n: Node1, v: number) { n.weight = v; }
function setY(o: Base, v: number) { o.y = v; o.z = v > 2; }
function setV(o: Derived, v: number) { o.v = v; o.y = v + 1; }
const rounds = 24, each = 40;
let wrong = 0;
const all: (() => boolean)[] = [];
for (let round = 0; round < rounds; round++) {
  const Local = classOf(round);
  const proto = { from: round };
  const opts: Opt[] = [], opts2: Opt[] = [], shapes: Shape[] = [], nodes: Node1[] = [], bases: Base[] = [], deriveds: Derived[] = [], locals: InstanceType<typeof Local>[] = [], adopted: Opt[] = [], parsed: Opt[] = [];
  for (let i = 0; i < each; i++) {
    opts.push(makeOpt(i)); opts2.push(makeOpt(i)); shapes.push(makeShape(i)); nodes.push(makeNode(i)); bases.push(new Base()); deriveds.push(new Derived()); locals.push(new Local());
    const a = makeOpt(i); Object.setPrototypeOf(a, proto); adopted.push(a);
    parsed.push(JSON.parse('{"a":' + i + "}") as Opt);
  }
  churn();
  for (let turn = 0; turn < 6; turn++) {
    setB(makeOpt(turn), turn); setCD(makeOpt(turn), turn); setArea(makeShape(turn)); setWeight(makeNode(turn), turn); setY(new Base(), turn); setV(new Derived(), turn);
    const l = new Local(); l.q = turn; l.r = true;
    const a = makeOpt(turn); Object.setPrototypeOf(a, proto); setB(a, turn); setCD(a, turn);
    setB(JSON.parse('{"a":' + turn + "}") as Opt, turn);
  }
  for (let i = 0; i < each; i++) {
    setB(opts[i], i); setCD(opts2[i], i); setArea(shapes[i]); setWeight(nodes[i], i); setY(bases[i], i); setV(deriveds[i], i);
    locals[i].q = i; locals[i].r = false;
    setB(adopted[i], i); setCD(adopted[i], i);
    setB(parsed[i], i);
    const o = opts[i], o2 = opts2[i], s = shapes[i], n = nodes[i], b = bases[i], d = deriveds[i], l = locals[i], a = adopted[i], p = parsed[i];
    all.push(() => o.b === i && o.a === i && o2.c === i > 1 && o2.d === (i & 1 ? null : i) && s.area === (s.kind === "circle" ? s.r * 3 : s.s * s.s) && n.weight === i && b.y === i && b.z === i > 2 && d.v === i && d.y === i + 1 && d.w === 2
      && l.q === i && l.r === false && l.twice === round * 2 && a.b === i && (a as any).from === round && a.c === i > 1 && p.b === i && p.a === i && Object.keys(a).join() === "a,b,c,d" && Object.keys(l).join() === "p,q,r");
  }
  churn();
}
for (const right of all) { let ok = false; try { ok = right(); } catch { ok = false; } if (!ok) wrong++; }
console.log(wrong, kept > 0);
//// old-weak-maps-written-between-gcs.ts
// A weak map or set that has survived collections and is then written to, or is left alone for many collections, answers as it should.
const shell = globalThis as any;
const collect: (full: boolean) => void = shell.Bun ? (full: boolean) => shell.Bun.gc(full) : (full: boolean) => (full ? shell.fullGC() : shell.edenGC());
type Key = { id: number };
type Value = { of: number; text: string };
const keys: Key[] = [];
for (let i = 0; i < 400; i++) keys.push({ id: i });
const quiet = new WeakMap<Key, Value>();
const busy = new WeakMap<Key, Value>();
const members = new WeakSet<Key>();
for (const key of keys) {
  quiet.set(key, { of: key.id, text: "q" + key.id });
  if (key.id % 2) members.add(key);
}
function churn(n: number): number {
  let t = 0;
  for (let i = 0; i < n; i++) t += ("c" + i).length + [i, i].length;
  return t;
}
function sumOf(map: WeakMap<Key, Value>): string {
  let count = 0;
  let sum = 0;
  let text = 0;
  for (const key of keys) {
    const value = map.get(key);
    if (!value) continue;
    count++;
    sum += value.of;
    text += value.text.length;
  }
  return count + ":" + sum + ":" + text;
}
collect(true);
collect(false);
const lines: string[] = [];
for (let round = 0; round < 16; round++) {
  const t = churn(2000);
  if (round % 4 !== 3) {
    for (let i = round; i < keys.length; i += 16) busy.set(keys[i], { of: i + round, text: "b" + round + "_" + i });
    const fresh: Key = { id: 1000 + round };
    busy.set(fresh, { of: -1, text: "gone" });
    members.add(fresh);
  }
  if (round === 5) for (let i = 0; i < keys.length; i += 3) busy.delete(keys[i]);
  if (round === 9) for (let i = 0; i < 40; i++) busy.set(keys[i], { of: 7, text: "again" + i });
  if (round === 11) {
    quiet.set(keys[3], { of: 3000, text: "late" });
    members.delete(keys[1]);
    members.add(keys[2]);
  }
  collect(round % 6 === 5);
  if (round % 2) collect(false);
  let inSet = 0;
  for (const key of keys) if (members.has(key)) inSet++;
  lines.push(round + " " + t + " " + sumOf(quiet) + " " + sumOf(busy) + " " + inSet);
}
keys.length = 200;
collect(true);
collect(false);
lines.push("half " + sumOf(quiet) + " " + sumOf(busy));
console.log(lines.join("\n"));
//// one-member-of-a-long-union-is-replaced-by-a-copy-and-joined-with-the-rest.ts
// current => (current.state === "s3" ? { ...current, saving: true } : current): one arm brings the copy, one member of the union; the other brings the rest of the union.
// Their join lists more layouts than either arm. Past the limit on the layouts in a type, which the flags beside this file lower, the join is only "object",
// and the cast to the declared result, which had been found to change nothing while the second arm still listed the whole union, has to go on holding.
// The function is handed to code that nobody sees, so its parameter and its result are tested.
type Status =
  | { state: "s0"; value0: number; saving?: boolean }
  | { state: "s1"; value1: number; saving?: boolean }
  | { state: "s2"; value2: number; saving?: boolean }
  | { state: "s3"; value3: number; saving?: boolean }
  | { state: "s4"; value4: number; saving?: boolean }
  | { state: "s5"; value5: number; saving?: boolean }
  | { state: "s6"; value6: number; saving?: boolean }
  | { state: "s7"; value7: number; saving?: boolean }
  | { state: "s8"; value8: number; saving?: boolean }
  | { state: "s9"; value9: number; saving?: boolean }
  | { state: "s10"; value10: number; saving?: boolean }
  | { state: "s11"; value11: number; saving?: boolean }
  | { state: "s12"; value12: number; saving?: boolean }
  | { state: "s13"; value13: number; saving?: boolean };
let status: Status = { state: "s0", value0: 0 };
const setStatus: (update: (current: Status) => Status) => void =
  (globalThis as any).hookFromOutside ??
  (update => {
    status = update(status);
  });
const all: Status[] = [
  { state: "s0", value0: 0 },
  { state: "s1", value1: 1 },
  { state: "s2", value2: 2 },
  { state: "s3", value3: 3 },
  { state: "s4", value4: 4 },
  { state: "s5", value5: 5 },
  { state: "s6", value6: 6 },
  { state: "s7", value7: 7 },
  { state: "s8", value8: 8 },
  { state: "s9", value9: 9 },
  { state: "s10", value10: 10 },
  { state: "s11", value11: 11 },
  { state: "s12", value12: 12 },
  { state: "s13", value13: 13 },
];
for (const next of all) {
  status = next;
  setStatus(current => (current.state === "s3" ? { ...current, saving: true } : current));
  console.log(status.state, status.saving);
}
//// one-name-in-slots-of-several-forms.ts
// One property name is a string in three classes with different fields in front of it, a number in a fourth, never stored in a fifth and added late to a literal; it is read, tested, stored and deleted through unions of them. The output is that of plain Bun.
class First { value?: string; constructor(value?: string) { if (value !== undefined) this.value = value; } }
class Second { a = 1; value?: string; constructor(value?: string) { if (value !== undefined) this.value = value; } }
class Third { a = 1; b = 2; value?: string; constructor(value?: string) { if (value !== undefined) this.value = value; } }
class Count { value?: number; constructor(value?: number) { if (value !== undefined) this.value = value; } }
class NeverStored { a = 1; value?: string; }
interface Late { a: number; value?: string | number }
type Any = First | Second | Third | Count | NeverStored | Late;

function makeLate(value: string | number | undefined): Late { const o: Late = { a: 1 }; if (value !== undefined) o.value = value; return o; }
function read(o: Any): string { const v = o.value; return v === undefined ? "none" : typeof v + ":" + v; }
function has(o: Any): boolean { return o.value !== undefined; }
function owns(o: Any): boolean { return "value" in o; }
function readTexts(o: First | Second | Third): string { return o.value ?? "none"; }
function storeText(o: First | Second | Third, text: string | undefined): void { o.value = text; }
function storeAny(o: First | Second | Third | Count, index: number): void { if (o instanceof Count) o.value = index; else o.value = "s" + index; }

function make(): Any[] {
  return [
    new First("f"), new First(), new Second("s"), new Second(), new Third("t"), new Third(), new Count(7), new Count(0.5), new Count(), new NeverStored(),
    makeLate("l"), makeLate(3), makeLate(undefined),
  ];
}

let lines: string[] = [];
for (let round = 0; round < 300; round++) {
  lines = [];
  const objects = make();
  for (const o of objects) lines.push(read(o) + " " + has(o) + " " + owns(o));
  for (let i = 0; i < 6; i++) storeText(objects[i] as First | Second | Third, i % 3 === 0 ? undefined : "x" + i);
  for (let i = 0; i < 6; i++) lines.push(readTexts(objects[i] as First | Second | Third) + " " + Object.keys(objects[i]!).join());
  for (let i = 0; i < 9; i++) storeAny(objects[i] as First | Second | Third | Count, i);
  delete (objects[2] as Second).value;
  delete (objects[6] as Count).value;
  Object.freeze(objects[4]);
  try { storeText(objects[4] as Third, "frozen"); } catch (error) { lines.push((error as Error).constructor.name); }
  for (const o of objects) lines.push(read(o) + " " + owns(o) + " " + JSON.stringify(o));
}
console.log(lines.join("\n"));
//// one-object-asked-for-its-fields-and-its-prototype.ts
// One function asks one object both for its fields (are they where its layout puts them?) and for its prototype (is it still the one of its class?).
// Each question has its own answer: an object that has lost one of the two keeps the other, before, between and behind the two accesses.
class Point {
  x: number;
  y: number;
  label?: string;
  constructor(x: number, y: number) { this.x = x; this.y = y; }
  norm(): number { return this.x * this.x + this.y * this.y; }
  get sum(): number { return this.x + this.y; }
}
interface Options { depth: number; width?: number; name?: string }
const launder = new Function("v", process.env.LAUNDER_TEXT ?? "return v") as <V>(v: V) => V;
const show = (label: string, value: unknown) => console.log(label, typeof value === "number" ? value : JSON.stringify(value) ?? String(value));

function fieldThenMethod(p: Point): number { return p.x + p.norm(); }
function methodThenField(p: Point): number { return p.norm() + p.y; }
function fieldAbsentField(p: Point): string { return p.x + ":" + p.label + ":" + p.y; }
function fieldGetterField(p: Point): number { return p.x * 100 + p.sum * 10 + p.y; }
function optionsAll(o: Options): string { return o.depth + "|" + o.width + "|" + o.name; }
function between(p: Point, change: (p: Point) => void): string { const before = p.x; change(p); return before + "," + p.norm() + "," + p.x + "," + p.label; }
function inLoop(list: Point[], change: (p: Point, i: number) => void): number { let total = 0; for (let i = 0; i < list.length; i++) { const p = list[i]; total += p.x; change(p, i); total += p.norm() + p.y; } return total; }
function branches(p: Point, which: number): number { let r = p.x; if (which & 1) r += p.norm(); else r += p.y; if (which & 2) r += p.sum; return r; }

function all(label: string, make: () => Point) {
  show(label + " fieldThenMethod", fieldThenMethod(make()));
  show(label + " methodThenField", methodThenField(make()));
  show(label + " fieldAbsentField", fieldAbsentField(make()));
  show(label + " fieldGetterField", fieldGetterField(make()));
  for (let which = 0; which < 4; which++) show(label + " branches " + which, branches(make(), which));
}

const other = { norm(this: Point) { return -1; }, get sum() { return -2; }, label: "inherited" };
all("as born", () => new Point(3, 4));
all("seen by others", () => launder(new Point(3, 4)));
all("another prototype", () => { const p = new Point(3, 4); Object.setPrototypeOf(p, other); return p; });
all("no prototype but own members", () => { const p = new Point(3, 4); Object.setPrototypeOf(p, null); (p as any).norm = () => 9; return p; });
all("a field deleted", () => { const p = new Point(3, 4); delete (p as any).x; return p; });
all("a field deleted and another prototype", () => { const p = new Point(3, 4); delete (p as any).y; Object.setPrototypeOf(p, other); return p; });
all("a field is an accessor", () => { const p = new Point(3, 4); Object.defineProperty(p, "x", { get() { return 30; }, configurable: true }); return p; });
all("a field holds a string", () => { const p = new Point(3, 4); (p as any).y = "four"; return p; });
all("an own method", () => { const p = new Point(3, 4); (p as any).norm = function () { return 1000; }; return p; });
all("an own label", () => { const p = new Point(3, 4); p.label = "own"; return p; });
all("frozen", () => Object.freeze(new Point(3, 4)));
all("made by Object.create", () => { const p = Object.create(Point.prototype) as Point; p.y = 4; p.x = 3; return p; });
all("below the class", () => new (class Deeper extends Point { norm() { return 77; } })(3, 4));

const changes: [string, (p: Point) => void][] = [
  ["nothing", () => {}],
  ["prototype", (p) => { Object.setPrototypeOf(p, other); }],
  ["delete x", (p) => { delete (p as any).x; }],
  ["x becomes text", (p) => { (p as any).x = "text"; }],
  ["own norm", (p) => { (p as any).norm = () => 5; }],
  ["label", (p) => { p.label = "late"; }],
  ["both", (p) => { delete (p as any).x; Object.setPrototypeOf(p, other); }],
];
for (const [label, change] of changes) {
  show("between: " + label, between(new Point(3, 4), change));
  show("between, unseen: " + label, between(new Point(3, 4), launder(change)));
  show("in a loop: " + label, inLoop([new Point(1, 2), new Point(3, 4), new Point(5, 6)], (p, i) => { if (i === 1) change(p); }));
}

show("options", optionsAll({ depth: 1 }));
show("options", optionsAll({ depth: 1, width: 2 }));
show("options", optionsAll(launder({ depth: 1, name: "n" })));
show("options under a prototype", optionsAll(Object.setPrototypeOf({ depth: 1 }, { width: 7, name: "from above" })));
show("options by Object.create", optionsAll(Object.assign(Object.create({ name: "above" }), { depth: 2 })));
(Point.prototype as any).label = "on the class";
all("a name arrives on the class", () => new Point(3, 4));
//// one-object-class-and-interface.ts
// The same two-field object is read through a class type and through an interface type.
class A { b: number; c: string; constructor(b: number, c: string) { this.b = b; this.c = c; } }
interface R { b: number; c: string }
function viaClass(a: A): boolean { return a.b === 123; }
function viaRecord(a: R): boolean { return a.b === 123; }
function viaOptional(a: { b?: number }): boolean { return a.b === 123; }
function viaNullable(a: A | null): boolean { return a !== null && a.b === 123; }
const keep: any = globalThis; keep.fs = [viaClass, viaRecord, viaOptional, viaNullable];
let n = 0; const as: A[] = [], rs: R[] = [];
for (let i = 0; i < 300; i++) { as.push(new A(i, "x")); rs.push({ b: i, c: "y" }); }
for (let i = 0; i < 300; i++) { if (viaClass(as[i]!)) n++; if (viaRecord(rs[i]!)) n++; if (viaOptional(rs[i]!)) n++; if (viaNullable(as[i]!)) n++; }
console.log(n);
//// one-object-many-types.ts
// One object is used through many types at once: a store through any of them is visible through all the others.
interface V1 { x: number }
interface V2 { x: number; y: string }
interface V3 { y: string; z?: boolean }
type V4 = { readonly x: number; readonly y: string }
type V5 = Partial<V2>
type V6 = V1 & V3
type V7 = { x: number | string; y: string | null }
interface V8 { w: number[]; bump?: () => number }
class Impl { x = 1; y = "one"; z?: boolean; w = [0]; bump() { return ++this.x } }
interface Held { v1: V1; v2: V2; v3: V3; v4: V4; v5: V5; v6: V6; v7: V7; v8: V8 }
type Born = { y: string; w: number[]; x: number }
function hold(o: V2 & V8): Held { return { v1: o, v2: o, v3: o, v4: o, v5: o, v6: o, v7: o, v8: o } }
function readAll(h: Held): string {
  return [h.v1.x, h.v2.x, h.v4.x, h.v5.x, h.v6.x, h.v7.x].join() + " " + [h.v2.y, h.v3.y, h.v4.y, h.v5.y, h.v6.y, h.v7.y].join() + " " +
    [h.v3.z, h.v6.z].map(String).join() + " " + h.v8.w.join("") + " " + Object.keys(h.v1).join("")
}
function same(...objects: object[]): boolean { return objects.every(o => o === objects[0]) }
const born: Born = { y: "lit", w: [9], x: 5 }
const impl = new Impl()
for (const h of [hold(born), hold(impl)]) {
  console.log(readAll(h))
  h.v1.x = 2; console.log(readAll(h))
  h.v2.y = "two"; console.log(readAll(h))
  h.v3.z = true; console.log(readAll(h))
  h.v5.x = 2.5; console.log(readAll(h))
  h.v6.y += "!"; h.v6.x *= -1; console.log(readAll(h))
  h.v7.x = 1e10; h.v7.y = "seven"; console.log(readAll(h))
  h.v8.w = [1, 2]; h.v8.w.push(3); console.log(readAll(h))
  delete h.v3.z; console.log(readAll(h), "z" in h.v6)
  h.v6.z = false; console.log(readAll(h), "z" in h.v3)
  console.log(same(h.v1, h.v2, h.v3, h.v4, h.v5, h.v6, h.v7, h.v8), new Set<object>(Object.values(h)).size, h.v8.bump?.(), h.v1.x)
}
console.log(JSON.stringify(born), JSON.stringify(impl), impl.bump(), impl instanceof Impl, born.x + impl.x)

// As a key: whatever type it is looked up by, it is the same key.
const weak = new WeakMap<object, string>()
const strong = new Map<V1, number>()
const held = hold(born)
weak.set(held.v3, "by v3")
strong.set(held.v1, 1)
strong.set(held.v6, 2)
strong.set(born, 3)
console.log(weak.get(held.v8), weak.get(born), weak.has(impl), strong.size, strong.get(held.v2), [held.v1, held.v2].indexOf(born))

// Closures and arrays, each with its own type of the object.
const getX: (() => number | string | undefined)[] = [() => held.v1.x, () => held.v4.x, () => held.v5.x, () => held.v7.x, () => born.x]
const setX: ((n: number) => void)[] = [n => { held.v1.x = n }, n => { held.v5.x = n }, n => { held.v6.x = n }, n => { held.v7.x = n }, n => { born.x = n }]
const matrix: string[] = []
setX.forEach((set, i) => { set(i + 0.5); matrix.push(getX.map(get => get()).join("")) })
console.log(matrix.join())
const list1: V1[] = [born, impl, born]
const list3: V3[] = [impl, born, impl]
for (let i = 0; i < 3; i++) { list1[i].x += 100; list3[i].y += i }
console.log(born.x, born.y, impl.x, impl.y)

// Passed as several arguments of one call.
function three(a: V1, b: V5, c: V7): string { a.x = 1; const first = b.x; b.x = 2; const second = c.x; c.x = 3; return [first, second, a.x, b.x, c.x].join() }
console.log(three(born, born, born), three(impl, impl, impl), three(born, impl, { x: "s", y: null }), three({ x: 0 }, {}, born), born.x, impl.x)

// A field holds the object under one type while a variable has it under another.
const owner: { item: V3; again: V1 | null } = { item: born, again: null }
owner.again = born
owner.item.y = "through the owner"
owner.again.x = 42
console.log(born.y, born.x, same(owner.item, owner.again), JSON.stringify(owner))

let total = 0
for (let i = 0; i < 3000; i++) { const h = i & 1 ? held : hold(impl); h.v1.x += 1; total += h.v2.x + h.v6.x + h.v4.y.length }
console.log(total, born.x, impl.x)
//// one-off-structures-read-between-gcs.ts
// Objects whose keys come out of the data have shapes that never come again. They pass the same sites as objects whose shapes come again at every round, and collections run in between. Every read must see the object it was given.
const shell = globalThis as any;
const collect: (full: boolean) => void = shell.Bun ? (full: boolean) => shell.Bun.gc(full) : (full: boolean) => (full ? shell.fullGC() : shell.edenGC());

function describe(value: any): number {
  let n = 0;
  if (value.then) n += 1;
  if (value.length) n += value.length;
  if (value.kind) n += value.kind.length;
  if (value.id) n += value.id & 7;
  if (value.extra) n += value.extra.id & 3;
  return n;
}
function unique(id: number): Record<string, unknown> {
  const bag: Record<string, unknown> = {};
  bag["a" + id] = id;
  bag["b" + id] = id + 1;
  if (id % 3 === 0) bag["c" + id] = id + 2;
  bag.kind = "bag";
  bag.id = id;
  return bag;
}
function recurring(id: number): Record<string, unknown> {
  const record: Record<string, unknown> = { kind: "record", id };
  if (id % 2) record.length = id % 5;
  if (id % 4 === 0) record.extra = { id: id + 1, kind: "extra" };
  return record;
}
function withoutPrototype(id: number): Record<string, unknown> {
  const bare: Record<string, unknown> = Object.create(null);
  bare.kind = "bare";
  bare.id = id;
  if (id % 2) bare["k" + (id % 3)] = id;
  return bare;
}

const kept: Record<string, unknown>[] = [];
let total = 0;
let wrong = 0;
for (let round = 0; round < 120; round++) {
  for (let i = 0; i < 150; i++) {
    const id = round * 150 + i + 1;
    const bag = unique(id);
    const record = recurring(id);
    const bare = withoutPrototype(id);
    total += describe(bag) + describe(record) + describe(bare);
    if (bag["a" + id] !== id || bag["b" + id] !== id + 1 || Object.keys(bag).length !== (id % 3 === 0 ? 5 : 4)) wrong++;
    if (record.id !== id || bare.id !== id) wrong++;
    if (i === round) kept.push(bag, record, bare);
  }
  collect(round % 40 === 39);
  for (let i = 0; i < kept.length; i += 3) {
    const id = kept[i].id as number;
    if (kept[i]["a" + id] !== id || kept[i + 1].id !== id || kept[i + 2].kind !== "bare") wrong++;
    total += describe(kept[i]) + describe(kept[i + 1]) + describe(kept[i + 2]);
  }
}
console.log(total, wrong, kept.length);
//// one-structure-check-covers-later-accesses.ts
// A read or a store through a type that also admits objects from elsewhere tests the shape of the receiver. One test covers the accesses to that receiver that follow it, until something
// runs that could change what the object is: a call, a conversion that runs valueOf or toString, a getter of another object, a store that changes a discriminant.
// An object from elsewhere, `undefined` and `null` fail the test and are served as they always were.
interface Point { x: number; y: number; z: number; w: number }
function make(i: number): Point { return { x: i + 0.5, y: i + 1.5, z: i + 2.5, w: i + 3.5 } }
let log: string[] = [];
let onRead: (name: string) => void = () => {};
function elsewhere(i: number): Point {
  const made: any = {};
  for (const name of ["x", "y", "z", "w"]) {
    let held = i + name.charCodeAt(0) + 0.25;
