for (let turn = 0; turn < 3; turn++) {
  // Records alone.
  lines.push("records " + fourReads(make(turn)) + " " + twoReceivers(make(turn), make(turn + 1)) + " " + inBranches(make(turn), turn === 1) + " " + inLoop(make(turn), 4));
