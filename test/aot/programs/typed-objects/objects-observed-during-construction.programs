//// optional-fields-created-in-many-orders.ts
// Eight optional fields, two past the inline capacity, created in 24 orders through one store site each: the key order advances without the run time, and locked objects, extra properties and repeated stores keep their keys.
"use strict";
declare const aotOperationCount: undefined | ((name: string) => number);
const counted = typeof aotOperationCount === "function" ? aotOperationCount : null;
const creationRows = () => counted ? counted("operationAOTDidCreateFieldAt") + counted("operationAOTDidCreateFieldOutOfLineAt") + counted("operationAOTDidCreateFieldsAt") : 0;

interface Tag { tag: number }
interface Sparse { a?: string; b?: string; c?: Tag; d?: Tag; e?: string; f?: Tag; g?: any; h?: any }
interface Field { name: string; store: (target: Sparse, k: number) => void; text: (k: number) => string }

const shared: Tag = { tag: 1 };
const mixed = (k: number): any => (k & 1 ? k : "m" + k);
const fields: Field[] = [
  { name: "a", store: (target, k) => { target.a = "a" + k; }, text: k => `"a":"a${k}"` },
  { name: "b", store: (target, k) => { target.b = "b" + k; }, text: k => `"b":"b${k}"` },
  { name: "c", store: target => { target.c = shared; }, text: () => `"c":{"tag":1}` },
  { name: "d", store: target => { target.d = shared; }, text: () => `"d":{"tag":1}` },
  { name: "e", store: (target, k) => { target.e = "e" + k; }, text: k => `"e":"e${k}"` },
  { name: "f", store: target => { target.f = shared; }, text: () => `"f":{"tag":1}` },
  { name: "g", store: (target, k) => { target.g = mixed(k); }, text: k => `"g":${JSON.stringify(mixed(k))}` },
  { name: "h", store: (target, k) => { target.h = mixed(k + 1); }, text: k => `"h":${JSON.stringify(mixed(k + 1))}` },
];

const blocks = [[0, 4], [1, 5], [2, 6], [3, 7]];
function orderAt(index: number): number[] {
  const remaining = [0, 1, 2, 3];
  const order: number[] = [];
  let rest = index;
  for (let radix = 4; radix >= 1; radix--) {
    const pick = rest % radix;
    rest = (rest - pick) / radix;
    order.push(...blocks[remaining.splice(pick, 1)[0]!]!);
  }
  return order;
}
const orders = Array.from({ length: 24 }, (_, index) => orderAt(index));

function createObjects(first: number, end: number): number {
  let mismatches = 0;
  for (let k = first; k < end; k++) {
    const target: Sparse = {};
    let names = "";
    const parts: string[] = [];
    for (const index of orders[k % orders.length]!) {
      const field = fields[index]!;
      field.store(target, k);
      names += field.name;
      parts.push(field.text(k));
    }
    let listed = "";
    for (const key in target) listed += key;
    if (Object.keys(target).join("") !== names) mismatches++;
    if (JSON.stringify(target) !== "{" + parts.join() + "}") mismatches++;
    if (listed !== names) mismatches++;
  }
  return mismatches;
}

console.log("first", createObjects(0, 10000));
const before = creationRows();
console.log("second", createObjects(10000, 20000));
console.log("level", creationRows() - before <= 500);

function tryStore(target: Sparse, index: number): string {
  try {
    fields[index]!.store(target, 1);
    return "stored";
  } catch (error) {
    return error instanceof TypeError ? "TypeError" : "other";
  }
}
const locks: [string, (target: Sparse) => void][] = [
  ["frozen", target => { Object.freeze(target); }],
  ["sealed", target => { Object.seal(target); }],
  ["not extensible", target => { Object.preventExtensions(target); }],
];
for (const [name, lock] of locks) {
  const target: Sparse = {};
  fields[0]!.store(target, 1);
  fields[6]!.store(target, 1);
  lock(target);
  console.log(name, tryStore(target, 2), tryStore(target, 7), Object.keys(target).join(), JSON.stringify(target), "c" in target, "h" in target);
}

const loose: Sparse = {};
fields[0]!.store(loose, 1);
(loose as any).outside = 1;
fields[2]!.store(loose, 1);
fields[7]!.store(loose, 1);
console.log(Object.keys(loose).join(), JSON.stringify(loose));

const twice: Sparse = {};
fields[1]!.store(twice, 1);
fields[7]!.store(twice, 1);
fields[1]!.store(twice, 2);
fields[7]!.store(twice, 2);
console.log(Object.keys(twice).join(), JSON.stringify(twice));
//// optional-fields-of-a-class-whose-prototype-gains-members.ts
////= say

function chunk(x: number): number {
  return x + 1;
}
const seen: string[] = [];
function look(at: object): number {
  seen.push(Object.keys(at).join());
  return seen.length;
}

interface Core {
  view?: boolean;
  refresh?: () => number;
}
class Core {
  key = "k";
  count = 0;
  origin!: string;
  rewrite?: { from: string };
  decoder?: (text: string) => string;
  update = (rewrite: { from: string } | undefined, origin: string) => {
    this.rewrite = rewrite;
    this.origin = origin;
  };
  arrow = (x: number) => x + this.count;
  loadChunk = chunk;
  later = (x: number) => x - this.count;
  ssr?: { m: number };
  serverSsr?: { m: number };
  looked = look(this);
  lifecycle?: { m: number };
  last?: string;
  constructor(rewrite: { from: string } | undefined) {
    this.update(rewrite, "o");
  }
  setSsr(value: { m: number } | undefined) {
    this.ssr = value;
  }
  setLast(value: string | undefined) {
    this.last = value;
  }
  setView(value: boolean | undefined) {
    this.view = value;
  }
}
Core.prototype.refresh = function () {
  return 7;
};
class Router extends Core {
  own = 1;
  more?: { m: number };
  constructor(rewrite: { from: string } | undefined) {
    super(rewrite);
  }
  setMore(value: { m: number } | undefined) {
    this.more = value;
  }
}

function show(core: Core) {
  return [Object.keys(core).join(), core.rewrite, core.ssr, core.serverSsr, core.lifecycle, core.last, core.view, core.origin];
}

say("born with nothing", () => show(new Core(undefined)));
say("born with a value", () => show(new Core({ from: "f" })));
say("an heir", () => show(new Router(undefined)));
say("an heir born with a value", () => show(new Router({ from: "g" })));
say("what an initializer saw", () => seen);
say("undefined, then a value, then undefined", () => {
  const core = new Core(undefined);
  const steps: unknown[] = [];
  core.setSsr(undefined);
  steps.push(show(core), "ssr" in core, Object.getOwnPropertyDescriptor(core, "ssr"));
  core.setSsr({ m: 1 });
  steps.push(show(core));
  core.setSsr(undefined);
  steps.push(show(core), core.hasOwnProperty("ssr"));
  return steps;
});
say("a text, and the field of the interface", () => {
  const core = new Router(undefined);
  core.setLast("l");
  core.setView(undefined);
  const first = show(core);
  core.setView(true);
  core.setMore(undefined);
  core.setMore({ m: 2 });
  return [first, show(core), core.more, core.refresh!()];
});
say("many", () => {
  let total = 0;
  for (let i = 0; i < 3000; i++) {
    const core = i & 1 ? new Core(i & 2 ? { from: "x" } : undefined) : new Router(i & 4 ? { from: "yy" } : undefined);
    core.setSsr(i % 3 ? undefined : { m: i });
    core.setLast(i % 5 ? undefined : "t");
    total += Object.keys(core).length + (core.ssr?.m ?? 0) + (core.rewrite?.from.length ?? 0) + (core.last?.length ?? 0);
  }
  return total;
});
say("deleted, then stored", () => {
  const core = new Core(undefined);
  delete core.ssr;
  const without = Object.keys(core).join();
  core.setSsr(undefined);
  const again = [Object.keys(core).join(), "ssr" in core];
  delete core.last;
  core.setLast("z");
  return [without, again, Object.keys(core).join(), core.last];
});
say("frozen", () => {
  const core = new Core(undefined);
  Object.freeze(core);
  const results: unknown[] = [];
  for (const store of [() => core.setSsr(undefined), () => core.setSsr({ m: 1 }), () => core.setLast("x")]) {
    try {
      store();
      results.push("stored");
    } catch (error) {
      results.push((error as Error).constructor.name);
    }
  }
  return [results, show(core)];
});
say("sealed, and not extensible", () => {
  const sealed = new Core(undefined);
  Object.seal(sealed);
  sealed.setSsr({ m: 3 });
  sealed.setLast(undefined);
  const closed = new Router(undefined);
  Object.preventExtensions(closed);
  closed.setSsr({ m: 4 });
  let refused = "no";
  try {
    closed.setView(true);
  } catch (error) {
    refused = (error as Error).constructor.name;
  }
  return [show(sealed), show(closed), refused];
});
say("a setter that comes onto the prototype later", () => {
  const log: string[] = [];
  const before = new Core(undefined);
  Object.defineProperty(Core.prototype, "ssr", {
    set(value) {
      log.push("set " + JSON.stringify(value));
    },
    get() {
      return undefined;
    },
    configurable: true,
  });
  before.setSsr({ m: 1 });
  before.setSsr(undefined);
  const after = new Core(undefined);
  after.setSsr({ m: 2 });
  const deleted = new Router(undefined);
  delete deleted.ssr;
  deleted.setSsr({ m: 3 });
  deleted.setSsr(undefined);
  const result = [log, show(before), show(after), show(deleted), "ssr" in deleted, deleted.hasOwnProperty("ssr")];
  delete (Core.prototype as any).ssr;
  deleted.setSsr({ m: 4 });
  return [result, show(deleted)];
});
//// optional-fields-restored-after-extra-properties/main.ts
import { run } from "./untyped.js";
run();
//// optional-fields-restored-after-extra-properties/shapes.ts
export class Inner {
  value = 1;
}
export class Other {
  name = "other";
}
export class Options {
  declare host?: string;
  declare port?: number;
  declare secure?: boolean;
  declare path?: string | null;
  declare inner?: Inner;
  declare whatever?: unknown;
  declare big?: bigint;
  declare mode?: "a" | "b";
  declare either?: number | string;
  declare mark?: symbol;
  always = 1;
  fill(round: number): void {
    this.host = "localhost";
    this.port = round;
    this.secure = true;
    this.path = "/";
    this.inner = new Inner();
    this.whatever = round;
    this.big = 1n;
    this.mode = "a";
    this.either = round;
    this.mark = Symbol.iterator;
  }
  describe(): string {
    return [this.host, this.port, this.secure, this.path, this.inner === undefined ? "none" : this.inner.value, String(this.whatever), this.big, this.mode, this.either, String(this.mark)].join("|");
  }
}
export type Settings = { id: number; host?: string; port?: number; secure?: boolean; inner?: Inner };
////= makeSettings
export function fillSettings(settings: Settings, round: number): void {
  settings.host = "localhost";
  settings.port = round;
  settings.secure = false;
  settings.inner = new Inner();
}
export function describeSettings(settings: Settings): string {
  return [settings.id, settings.host, settings.port, settings.secure, settings.inner === undefined ? "none" : settings.inner.value].join("|");
}
//// optional-fields-restored-after-extra-properties/untyped.js
import { Options, Inner, Other, makeSettings, fillSettings, describeSettings } from "./shapes.ts";

function storeAll(o, v) {
  o.host = v.host;
  o.port = v.port;
  o.secure = v.secure;
  o.path = v.path;
  o.inner = v.inner;
  o.whatever = v.whatever;
  o.big = v.big;
  o.mode = v.mode;
  o.either = v.either;
  o.mark = v.mark;
}
function storeSome(o, v) {
  o.host = v.host;
  o.port = v.port;
  o.secure = v.secure;
  o.inner = v.inner;
}
function storeUnderKeys(o, v) {
  for (const key in v) o[key] = v[key];
}
function attempt(f) {
  try {
    f();
    return "";
  } catch (error) {
    return " threw " + error.constructor.name;
  }
}
const show = o => JSON.stringify(o, (key, value) => (typeof value === "bigint" ? value + "n" : typeof value === "symbol" ? String(value) : value)) + " " + Object.keys(o).join();

const fitting = round => [
  { host: "h" + round, port: round + 0.5, secure: false, path: null, inner: new Inner(), whatever: { round }, big: 5n, mode: "b", either: "text", mark: Symbol.hasInstance },
  { host: "", port: -0, secure: true, path: "p", inner: new Inner(), whatever: undefined, big: 2n ** 70n, mode: "a", either: 2 ** 40, mark: Symbol.iterator },
  { host: "x".repeat(round), port: 2 ** 31, secure: false, path: "", inner: new Inner(), whatever: null, big: 0n, mode: "b", either: NaN, mark: Symbol.for("m") },
  { host: undefined, port: undefined, secure: undefined, path: undefined, inner: undefined, whatever: undefined, big: undefined, mode: undefined, either: undefined, mark: undefined },
];

const states = {
  bare: () => {},
  tagged: (o, round) => { o.tag = round; },
  taggedUnderAKey: (o, round) => { o[["t", "ag"].join("")] = round; },
  twoTags: (o, round) => { o.tag = round; o.more = round; },
};
const after = {
  nothing: () => {},
  frozen: o => { Object.freeze(o); },
  sealed: o => { Object.seal(o); },
  notExtensible: o => { Object.preventExtensions(o); },
  hostDeleted: o => { delete o.host; },
  portReadOnly: o => { Object.defineProperty(o, "port", { writable: false }); },
};

export function run() {
  for (const state in states) {
    for (const then in after) {
      for (const [how, store] of [["by name", storeAll], ["under keys", storeUnderKeys]]) {
        const said = new Set();
        for (let round = 0; round < 12; round++) {
          const o = new Options();
          states[state](o, 1);
          o.fill(1);
          after[then](o);
          let line = "";
          for (const values of fitting(3)) {
            line += attempt(() => store(o, values)) + " " + o.describe() + " " + show(o) + " ;";
          }
          said.add(line);
        }
        console.log(state, then, how, said.size, [...said][0]);
      }
    }
  }
  for (const state in states) {
    const said = new Set();
    for (let round = 0; round < 12; round++) {
      const o = new Options();
      states[state](o, 1);
      let line = "";
      for (const values of fitting(2)) {
        line += attempt(() => storeAll(o, values)) + " " + o.describe() + " " + show(o) + " ;";
      }
      said.add(line);
    }
    console.log(state, "never filled", said.size, [...said][0]);
  }
  for (const state in states) {
    const said = new Set();
    for (let round = 0; round < 12; round++) {
      const o = makeSettings(1);
      states[state](o, 1);
      fillSettings(o, 1);
      let line = "";
      for (const values of fitting(2)) {
        line += attempt(() => storeSome(o, values)) + " " + describeSettings(o) + " " + show(o) + " ;";
      }
      said.add(line);
    }
    console.log(state, "a record", said.size, [...said][0]);
  }
  const kept = [];
  for (let i = 0; i < 300; i++) {
    const o = new Options();
    o.tag = i;
    o.fill(i);
    kept.push(o);
  }
  for (let round = 0; round < 40; round++) {
    for (const o of kept) storeAll(o, { host: "h" + round, port: round, secure: round % 2 === 0, path: "/" + round, inner: new Inner(), whatever: [round], big: BigInt(round), mode: "a", either: "e" + round, mark: Symbol.iterator });
  }
  console.log("kept", new Set(kept.map(o => o.describe())).size, kept[299].describe(), kept[0].whatever[0], kept[150].tag);
}
//// optional-properties-that-most-callers-leave-out.ts
// A component reads four optional properties; each caller gives some of them, as callers of components and of functions with an options object do.
type TextProps = { children?: unknown; color?: string; bold?: boolean; dim?: boolean };

const word = process.argv[3] ?? "";
const open = new Function("value", "return value" + word.slice(word.length)) as <V>(value: V) => V;

function weigh(props: TextProps): number {
  let weight = 0;
  if (props.color !== undefined) weight += props.color.length;
  if (props.bold) weight += 10;
  if (props.dim) weight += 100;
  if (props.children !== undefined) weight += 1000;
  return weight;
}

const muted: TextProps = { color: "245", dim: true, children: "a" };
const accent: TextProps = { color: "213", bold: true, children: "b" };
const plain: TextProps = { children: "c" };
const empty: TextProps = {};
const full: TextProps = { children: "d", color: "1", bold: false, dim: false };
const all = open([muted, accent, plain, empty, full, plain, muted, plain]);

const rounds = Number(process.argv[2] ?? 200000);
let sum = 0;
for (let i = 0; i < rounds; i++) sum += weigh(all[i & 7]);
console.log(sum);
//// other-new-target-from-js/main.js
// Reflect.construct() with another new.target, written in a JavaScript file, of a class that a TypeScript file declares.
import { Shape, total } from "./shapes.ts";
function Target() {}
Target.prototype.hi = function () { return "Target.hi"; };
class Below extends Shape { hi() { return "Below.hi " + this.sides; } }
const attempt = run => { try { return String(run()); } catch (error) { return "throws " + error.name + ": " + error.message.slice(0, 60); } };
const tell = (made, target) => [Object.getPrototypeOf(made) === target.prototype, made.hi(), JSON.stringify(made), Object.keys(made).join()].join(" ");
console.log("a function:", attempt(() => tell(Reflect.construct(Shape, [3], Target), Target)));
console.log("a class of this file that extends it:", attempt(() => tell(Reflect.construct(Shape, [4], Below), Below)));
console.log("Object:", attempt(() => JSON.stringify(Reflect.construct(Shape, [5], Object))));
console.log(total([new Shape(3), new Shape(4), new Below(5)]), new Shape(6).hi(), new Below(7).hi());
//// other-new-target-from-js/shapes.ts
export class Shape { sides: number; label = "shape"; constructor(sides: number) { this.sides = sides; } hi(): string { return "Shape.hi " + this.label + this.sides; } }
export function total(list: Shape[]): number { let sides = 0; for (const each of list) sides += each.sides; return sides; }
//// other-new-target-vs-same-field-class.ts
// Reflect.construct() with a new.target that does not extend the class, where another class of the program has the same fields.
class Point { constructor(public first: number, public second: number) {} }
class Probed { constructor(public first: number, public second: number) {} }
class Other { third = 2; fourth = 3 }
const made = Reflect.construct(Probed, [4, 5], Other);
console.log(new Point(1, 2).first, Object.getPrototypeOf(made) === Other.prototype, made instanceof Probed, made instanceof Other);
console.log(made.first, made.second, Object.keys(made).join(), new Probed(6, 7).second);
//// out-of-line-initial-field-after-collection.ts
// A record with more fields than its cell has room for stores the later ones out of line. One literal lists them all as undefined, which needs no storage. Another gives some of them objects, strings and numbers at creation, so the allocation itself creates the storage, and what it stored there must survive a collection.
// The functions are called through a table, so that nothing is inlined and no allocation is removed.
interface Leaf { n: number }
interface Wide {
  a0?: Leaf; a1?: Leaf; a2?: Leaf; a3?: Leaf; a4?: Leaf; a5?: Leaf; a6?: Leaf; a7?: Leaf
  b0?: Leaf; b1?: Leaf; b2?: Leaf; b3?: Leaf; b4?: Leaf; b5?: Leaf; b6?: Leaf; b7?: Leaf
  c0?: Leaf; c1?: Leaf; c2?: Leaf; c3?: Leaf; c4?: Leaf; c5?: Leaf; c6?: Leaf; c7?: Leaf
  d0?: Leaf; d1?: Leaf; d2?: Leaf; d3?: Leaf; d4?: Leaf; d5?: Leaf; d6?: Leaf; d7?: Leaf
  e0?: Leaf; e1?: Leaf; e2?: Leaf; e3?: Leaf; e4?: Leaf; e5?: string; e6?: number; e7?: Leaf
}

function leaf(n: number): Leaf { return { n } }
function text(n: number): string { return ["t", n].join("") }
function empty(): Wide {
  return {
    a0: undefined, a1: undefined, a2: undefined, a3: undefined, a4: undefined, a5: undefined, a6: undefined, a7: undefined,
    b0: undefined, b1: undefined, b2: undefined, b3: undefined, b4: undefined, b5: undefined, b6: undefined, b7: undefined,
    c0: undefined, c1: undefined, c2: undefined, c3: undefined, c4: undefined, c5: undefined, c6: undefined, c7: undefined,
    d0: undefined, d1: undefined, d2: undefined, d3: undefined, d4: undefined, d5: undefined, d6: undefined, d7: undefined,
    e0: undefined, e1: undefined, e2: undefined, e3: undefined, e4: undefined, e5: undefined, e6: undefined, e7: undefined,
  };
}
function filledAtEnd(n: number): Wide {
  return {
    a0: undefined, a1: undefined, a2: undefined, a3: undefined, a4: undefined, a5: undefined, a6: undefined, a7: undefined,
    b0: undefined, b1: undefined, b2: undefined, b3: undefined, b4: undefined, b5: undefined, b6: undefined, b7: undefined,
    c0: undefined, c1: undefined, c2: undefined, c3: undefined, c4: undefined, c5: undefined, c6: undefined, c7: undefined,
    d0: undefined, d1: undefined, d2: undefined, d3: F.leaf(n + 1), d4: undefined, d5: undefined, d6: undefined, d7: undefined,
    e0: undefined, e1: undefined, e2: F.leaf(n + 2), e3: undefined, e4: undefined, e5: F.text(n), e6: n + 0.5, e7: F.leaf(n + 3),
  };
}
function churn(): number {
  let sum = 0;
  for (let i = 0; i < 400; i++) sum += F.leaf(9000 + i).n + F.text(i).length;
  return sum;
}
function describe(wide: Wide): string {
  return [wide.a0, wide.d3?.n, wide.d4, wide.e2?.n, wide.e5, wide.e6, wide.e7?.n, Object.keys(wide).length].join();
}
const F = { leaf, text, empty, filledAtEnd, churn, describe };

const live: Wide[] = [];
for (let i = 0; i < 300; i++) {
  live.push(F.filledAtEnd(i * 10), F.empty());
  if (i % 50 === 49) {
    Bun.gc(true);
    F.churn();
  }
}
Bun.gc(true);
F.churn();
for (const i of [0, 1, 2, 3, 298, 299, 598, 599]) console.log(i, F.describe(live[i]));
let sum = 0;
for (const wide of live) sum += (wide.d3?.n ?? 0) + (wide.e2?.n ?? 0) + (wide.e7?.n ?? 0) + (wide.e6 ?? 0) + (wide.e5?.length ?? 0);
console.log(sum);
//// out-of-line-property-reads.ts
// An object of one subtype is used as a sibling subtype: the sibling's fields have no room in it. They are read over and over at the same sites while they are stored, changed, deleted and redefined.
interface Type { flags: number; id: number }
interface InterfaceType extends Type { typeParameters: string[]; thisType?: Type }
interface WithDeclaredMembers extends InterfaceType { declaredProperties: string[]; declaredCalls: number[]; declaredCount: number; declaredName?: string }
interface GenericType extends InterfaceType { instantiations: Map<string, Type>; variances?: number[] }
interface Cached extends Type { iterationTypes?: string; awaited?: Type; a1?: number; a2?: number; a3?: number; a4?: number; a5?: number; a6?: number; a7?: number; a8?: number }
let nextId = 0
function TypeCtor(this: Type, flags: number) { this.flags = flags; this.id = ++nextId }
const Type = TypeCtor as unknown as new (flags: number) => Type
function createInterface(name: string): InterfaceType { const type = new Type(2) as InterfaceType; type.typeParameters = [name]; return type }
function createGeneric(name: string): GenericType { const type = createInterface(name) as GenericType; type.flags = 1; type.instantiations = new Map(); return type }
function resolveDeclaredMembers(type: InterfaceType): WithDeclaredMembers {
  if (!(type as WithDeclaredMembers).declaredProperties) {
    (type as WithDeclaredMembers).declaredProperties = ["p" + type.id];
    (type as WithDeclaredMembers).declaredCalls = [type.id];
    (type as WithDeclaredMembers).declaredCount = type.id * 2
  }
  return type as WithDeclaredMembers
}
function weigh(type: InterfaceType): number {
  const resolved = resolveDeclaredMembers(type)
  return resolved.declaredProperties.length + resolved.declaredCalls[0] + resolved.declaredCount + (resolved.declaredName ? resolved.declaredName.length : 0)
}
const types: InterfaceType[] = []
for (let i = 0; i < 300; i++) types.push(i % 3 ? createGeneric("T" + i) : createInterface("U" + i))
let total = 0
for (let round = 0; round < 60; round++) for (const type of types) total += weigh(type)
console.log("weighed", total)
const generic = types[1] as GenericType
console.log(Object.keys(generic).join(), JSON.stringify((generic as InterfaceType as WithDeclaredMembers).declaredProperties), generic.instantiations.size)
console.log(Object.keys(types[0]).join())

// What is read changes between the reads.
const seen: string[] = []
const subject = resolveDeclaredMembers(types[4])
for (let i = 0; i < 12; i++) {
  if (i === 2) subject.declaredCount = -1
  if (i === 4) subject.declaredName = "named"
  if (i === 6) delete subject.declaredName
  if (i === 8) (subject as any).declaredCount = 0.5
  if (i === 10) subject.declaredProperties = []
  seen.push(String(weigh(subject)))
}
console.log(seen.join())

// One site, many objects, absent and present by turns.
function iterationTypesOf(type: Type): string | undefined { return (type as Cached).iterationTypes }
function awaitedOf(type: Type): Type | undefined { return (type as Cached).awaited }
let found = 0, missing = 0
for (let round = 0; round < 40; round++) {
  for (let i = 0; i < types.length; i++) {
    if (round === 10 && i % 2) (types[i] as Type as Cached).iterationTypes = "it" + i
    if (round === 20 && i % 4 === 1) delete (types[i] as Type as Cached).iterationTypes
    if (round === 30 && i % 5 === 0) (types[i] as Type as Cached).awaited = types[(i + 1) % types.length]
    iterationTypesOf(types[i]) ? found++ : missing++
    if (awaitedOf(types[i])) found += awaitedOf(types[i])!.id
  }
}
console.log("found", found, "missing", missing)

// More of them than fit in the object that keeps them.
function sumOfCached(type: Type): number { const c = type as Cached; return (c.a1 ?? 0) + (c.a2 ?? 0) + (c.a3 ?? 0) + (c.a4 ?? 0) + (c.a5 ?? 0) + (c.a6 ?? 0) + (c.a7 ?? 0) + (c.a8 ?? 0) }
const crowded = createGeneric("crowded") as Type as Cached
const sums: number[] = []
for (let i = 1; i <= 8; i++) { (crowded as any)["a" + i] = i * 10 ** (i - 1); for (let again = 0; again < 50; again++) sumOfCached(crowded); sums.push(sumOfCached(crowded)) }
console.log(sums.join())
for (let i = 1; i <= 8; i += 2) delete (crowded as any)["a" + i]
console.log(sumOfCached(crowded), Object.keys(crowded).join())

// Hundreds of properties, then a read of a declared name among them.
const dictionary = createGeneric("dictionary") as Type as Cached
for (let i = 0; i < 300; i++) (dictionary as any)["x" + i] = i
dictionary.a3 = 3
for (let i = 0; i < 300; i += 2) delete (dictionary as any)["x" + i]
const reads: (number | undefined)[] = []
for (let i = 0; i < 6; i++) { if (i === 2) delete dictionary.a3; if (i === 4) dictionary.a3 = 33; reads.push((dictionary as Cached).a3, sumOfCached(dictionary)) }
console.log(reads.join())

// Redefined: hidden, read only, then an own data property again.
const redefined = createGeneric("redefined") as Type as Cached
redefined.a1 = 1
const states: string[] = []
const state = () => states.push(sumOfCached(redefined) + ":" + Object.keys(redefined).includes("a1"))
for (let i = 0; i < 30; i++) sumOfCached(redefined)
state()
Object.defineProperty(redefined, "a1", { value: 2, enumerable: false, writable: false, configurable: true }); state()
Object.defineProperty(redefined, "a1", { value: 3, enumerable: true, writable: true, configurable: true }); state()
console.log(states.join())

// The objects die and others take their places.
const host = globalThis as any
const collect: () => void = host.Bun ? () => host.Bun.gc(true) : host.gc
let survivors = 0
for (let generation = 0; generation < 6; generation++) {
  const young: InterfaceType[] = []
  for (let i = 0; i < 2000; i++) young.push(createGeneric("y" + i))
  for (let round = 0; round < 3; round++) for (const type of young) survivors += weigh(type) - type.id * 3
  collect()
}
console.log("survivors", survivors)
for (let round = 0; round < 3; round++) { collect(); total = 0; for (const type of types) total += weigh(type); console.log("after a collection", total) }
//// out-of-line-references-outlive-collections.ts
// A record with more optional fields than a cell has room for keeps the later ones out of line, references among them in 32 bits. What a local alone holds, read from such a field that is then overwritten, must outlive a collection: to be read, to be stored into another record, to be compared.
// The functions are called through a table, so that nothing is inlined and no object is dissolved. The program asks for its collections itself and fills the freed cells anew.
type Leaf = { n: number; m: number };
////= Wide	Leaf; e7?: boolean; e8?: "on" | "off" | "auto"
function collect(): void { const g: any = globalThis; if (g.Bun) g.Bun.gc(true); else g.gc() }
function leaf(n: number): Leaf { return { n, m: n * 2 } }
function text(n: number): string { return ["t", n].join("") }
function churn(): number { let s = 0; for (let i = 0; i < 300; i++) s += F.leaf(9000 + i).m + F.text(i).length; return s }
function again(): void { F.collect(); F.churn() }
function wide(n: number): Wide { const w: Wide = { id: n }; w.e6 = F.leaf(n); w.e5 = F.text(n); w.e8 = n & 1 ? "on" : "off"; return w }
function readFar(w: Wide, fresh: Leaf): number { const a = w.e6; w.e6 = fresh; F.again(); return a ? a.n + a.m : -1 }
function copyFar(w: Wide, to: Wide, fresh: Leaf): void { const a = w.e6; w.e6 = fresh; F.again(); to.e6 = a }
function textFar(w: Wide): number { const a = w.e5; w.e5 = "x"; F.again(); return a ? a.length : -1 }
function copyText(w: Wide, to: Wide): void { const a = w.e5; w.e5 = "x"; F.again(); to.e5 = a }
function copyMode(w: Wide, to: Wide): void { const a = w.e8; w.e8 = "auto"; F.again(); to.e8 = a }
function sameFar(w: Wide, other: Wide, fresh: Leaf): boolean { const a = w.e6; w.e6 = fresh; F.again(); other.e6 = F.leaf(5); return a === other.e6 }
function dropped(n: number): number { const a = F.wide(n).e6; F.again(); return a ? a.m : -1 }
const F = { collect, leaf, text, churn, again, wide, readFar, copyFar, textFar, copyText, copyMode, sameFar, dropped };
const lines: string[] = [];
for (let i = 1; i <= 12; i++) {
  const w = F.wide(i * 10), to = F.wide(i * 10 + 1);
  const read = F.readFar(w, F.leaf(1));
  F.copyFar(F.wide(i * 10 + 2), to, F.leaf(2)); F.again();
  const length = F.textFar(F.wide(i * 10 + 3));
  F.copyText(F.wide(i * 10 + 4), to); F.copyMode(F.wide(i * 10 + 5), to); F.again();
  lines.push([read, to.e6!.n, to.e6!.m, length, to.e5, to.e8, F.sameFar(F.wide(i), F.wide(i + 1), F.leaf(3)), F.dropped(i * 10 + 6)].join());
}
console.log(lines.join("\n"));
//// out-of-line-storage-allocated-once.ts
// A function that stores to many fields which lie out of line takes their storage once. Nobody sees room that no field uses yet.
class Options {
  declare o0?: any; declare o1?: any; declare o2?: any; declare o3?: any; declare o4?: any; declare o5?: any; declare o6?: any; declare o7?: any; declare o8?: any; declare o9?: any; declare o10?: any; declare o11?: any; declare o12?: any; declare o13?: any; declare o14?: any; declare o15?: any; declare o16?: any; declare o17?: any; declare o18?: any; declare o19?: any; declare o20?: any; declare o21?: any; declare o22?: any; declare o23?: any;
  declare update: (given: any) => void;
  constructor(given: any) {
    this.update = (given: any) => {
      this.o0 = given.o0;
      this.o1 = given.o1;
      this.o2 = given.o2;
      this.o3 = given.o3;
      this.o4 = given.o4;
      this.o5 = given.o5;
      this.o6 = given.o6;
      this.o7 = given.o7;
      this.o8 = given.o8;
      this.o9 = given.o9;
      this.o10 = given.o10;
      this.o11 = given.o11;
      this.o12 = given.o12;
      this.o13 = given.o13;
      this.o14 = given.o14;
      this.o15 = given.o15;
      this.o16 = given.o16;
      this.o17 = given.o17;
      this.o18 = given.o18;
      this.o19 = given.o19;
      this.o20 = given.o20;
      this.o21 = given.o21;
      this.o22 = given.o22;
      this.o23 = given.o23;
    };
    this.update(given);
  }
}
function look(options: Options): string { return Object.keys(options).filter(key => key !== "update").join("") + ":" + Object.values(options).filter(value => typeof value !== "function").join(""); }
const full: Record<string, number> = {};
for (let i = 0; i < 24; i++) full["o" + i] = i % 10;
const kept: Options[] = [];
for (let i = 0; i < 20; i++) kept.push(new Options(full));
console.log(look(kept[0]));
const failing: Record<string, unknown> = { ...full };
Object.defineProperty(failing, "o9", { get() { throw new RangeError("nine"); }, enumerable: true });
let half: Options | undefined;
class Watched extends Options { constructor(given: any) { try { super(given); } catch (error) { console.log((error as Error).message); throw error; } } }
try { new Watched(failing); } catch (error) { console.log(error instanceof RangeError); }
const later = new Options({});
console.log(look(later), "o3" in later, later.o3, Object.keys(later).length);
try { later.update(failing); } catch (error) { console.log((error as Error).message, look(later), "o9" in later, "o23" in later, later.o23); }
later.update({ o20: 5 });
console.log(look(later), later.o20, later.o9, Object.keys(later).length);
delete (later as any).o4; later.update(full);
console.log(look(later));
let garbage: Options[] = [];
for (let round = 0; round < 60; round++) { garbage = []; for (let i = 0; i < 300; i++) garbage.push(new Options(full)); }
console.log(look(garbage[299]) === look(kept[0]), look(kept[19]) === look(kept[0]), JSON.stringify(later).length, half);
class Bare {
  declare o0?: any; declare o1?: any; declare o2?: any; declare o3?: any; declare o4?: any; declare o5?: any; declare o6?: any; declare o7?: any; declare o8?: any; declare o9?: any; declare o10?: any; declare o11?: any; declare o12?: any; declare o13?: any; declare o14?: any; declare o15?: any; declare o16?: any; declare o17?: any; declare o18?: any; declare o19?: any; declare o20?: any; declare o21?: any; declare o22?: any; declare o23?: any;
  fill(given: any): void {
    this.o0 = given.o0;
    this.o1 = given.o1;
    this.o2 = given.o2;
    this.o3 = given.o3;
    this.o4 = given.o4;
    this.o5 = given.o5;
    this.o6 = given.o6;
    this.o7 = given.o7;
    this.o8 = given.o8;
    this.o9 = given.o9;
    this.o10 = given.o10;
    this.o11 = given.o11;
    this.o12 = given.o12;
    this.o13 = given.o13;
    this.o14 = given.o14;
    this.o15 = given.o15;
    this.o16 = given.o16;
    this.o17 = given.o17;
    this.o18 = given.o18;
    this.o19 = given.o19;
    this.o20 = given.o20;
    this.o21 = given.o21;
    this.o22 = given.o22;
    this.o23 = given.o23;
  }
}
const bare = new Bare();
console.log(Object.keys(bare).length, "o0" in bare);
try { bare.fill(failing); } catch (error) { console.log((error as Error).message, Object.keys(bare).join(""), Object.values(bare).join(""), "o9" in bare, "o23" in bare, bare.o9, bare.o23, JSON.stringify(bare)); }
const copy = { ...bare };
console.log(Object.keys(copy).join(""), Object.getOwnPropertyNames(bare).length);
bare.o23 = "last"; bare.o12 = "middle";
console.log(Object.keys(bare).join(""), bare.o23, bare.o12, bare.o13, "o13" in bare);
bare.fill(full);
console.log(Object.keys(bare).join(""), Object.values(bare).join(""));
//// overlapping-object-types.ts
// Object types that overlap pairwise in a ring, with fields of different sizes: a store through one type never touches another field.
interface HasA { a: number }
interface HasB { b: boolean }
interface HasC { c: string }
interface HasD { d: number[] }
interface HasE { e: number }
type AB = { a: number; b: boolean }
type BC = { b: boolean; c: string }
type CD = { c: string; d: number[] }
type DE = { d: number[]; e: number }
type EA = { e: number; a: number }
type ACE = { a: number; c: string; e: number }
type BD = { d: number[]; b: boolean }
type All = { e: number; d: number[]; c: string; b: boolean; a: number }
interface MaybeAll { a?: number; b?: boolean; c?: string; d?: number[]; e?: number }
const ab: AB = { a: 1, b: true }
const bc: BC = { b: false, c: "bc" }
const cd: CD = { c: "cd", d: [3] }
const de: DE = { d: [4], e: 4.5 }
const ea: EA = { e: 5, a: 5.5 }
const ace: ACE = { a: 6, c: "ace", e: 6.5 }
const bd: BD = { d: [7], b: true }
const whole: All = { e: 8, d: [8], c: "all", b: false, a: 8.5 }
const objects: object[] = [ab, bc, cd, de, ea, ace, bd, whole]
const withA: HasA[] = [ab, ea, ace, whole]
const withB: HasB[] = [ab, bc, bd, whole]
const withC: HasC[] = [bc, cd, ace, whole]
const withD: HasD[] = [cd, de, bd, whole]
const withE: HasE[] = [de, ea, ace, whole]
function dump(): string { return objects.map(o => JSON.stringify(o)).join("") }
function getA(h: HasA): number { return h.a }
function getB(h: HasB): boolean { return h.b }
function getC(h: HasC): string { return h.c }
function getD(h: HasD): number[] { return h.d }
function getE(h: HasE): number { return h.e }
function setA(h: HasA, v: number): void { h.a = v }
function setB(h: HasB, v: boolean): void { h.b = v }
function setC(h: HasC, v: string): void { h.c = v }
function setD(h: HasD, v: number[]): void { h.d = v }
function setE(h: HasE, v: number): void { h.e = v }
console.log(dump())
console.log(withA.map(getA).join(), withB.map(getB).join(), withC.map(getC).join(), withD.map(h => getD(h).join("+")).join(), withE.map(getE).join())
withA.forEach((h, i) => setA(h, -i - 0.25)); console.log(dump())
withB.forEach((h, i) => setB(h, i % 2 === 0)); console.log(dump())
withC.forEach((h, i) => setC(h, "c" + i)); console.log(dump())
withD.forEach((h, i) => setD(h, [i, i])); console.log(dump())
withE.forEach((h, i) => setE(h, 2 ** (31 + i))); console.log(dump())

// Pairs of fields through the pair types, on the objects that have both.
function pairAB(p: AB): string { p.a += 1; p.b = !p.b; return p.a + "" + p.b }
function pairEA(p: EA): string { const t = p.e; p.e = p.a; p.a = t; return p.e + "/" + p.a }
function pairCD(p: CD): string { p.d.push(p.c.length); p.c += p.d.length; return p.c }
function pairBD(p: BD): string { p.d = p.b ? [] : [1]; return String(p.d.length) }
console.log([ab, whole].map(pairAB).join(), [ea, ace, whole].map(pairEA).join(), [cd, whole].map(pairCD).join(), [bd, whole].map(pairBD).join())
console.log(dump())

// Every object through one type in which everything is optional.
const maybes: MaybeAll[] = [ab, bc, cd, de, ea, ace, bd, whole, {}]
function digest(m: MaybeAll): string { return [m.a, m.b, m.c, m.d === undefined ? undefined : m.d.length, m.e].map(v => v === undefined ? "-" : String(v)).join("|") + ("a" in m ? "A" : "") + ("e" in m ? "E" : "") }
console.log(maybes.map(digest).join(" ; "))
function complete(m: MaybeAll, n: number): void { m.e ??= n; m.d ??= [n]; m.c ??= "n" + n; m.b ??= n % 2 === 0; m.a ??= n + 0.5 }
maybes.forEach(complete)
console.log(maybes.map(digest).join(" ; "))
console.log(maybes.map(m => Object.keys(m).join("")).join())
console.log(dump())
// A property that an object was not created with can be removed again. (One that it was created with cannot: type-rules/overlapping-object-types.)
const madeWith = ["ab", "bc", "cd", "de", "ea", "ace", "bd", "abcde", ""]
maybes.forEach((m, i) => { if (!madeWith[i].includes("c")) delete m.c; if (!madeWith[i].includes("a")) delete m.a })
for (const m of [cd, bc, ace, whole]) setC(m, "back")
for (const m of [ab, ea, ace, whole]) setA(m, 0)
console.log(maybes.map(m => Object.keys(m).join("")).join(), maybes.map(digest).join(" ; "))

let total = 0
for (let i = 0; i < 4000; i++) {
  const k = i & 3
  total += getA(withA[k]) + (getB(withB[k]) ? 1 : 0) + getC(withC[k]).length + getD(withD[k]).length + getE(withE[k]) % 7
  if (i % 1000 === 0) { setA(withA[k], i); setE(withE[k], i + 0.5) }
}
console.log(total, dump())
