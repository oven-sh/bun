//// record-copies-with-extra-properties/shapes.ts
export type Props = { id: number; label: string; size?: number; on?: boolean };
export function makeProps(id: number): Props {
  return { id, label: "x" };
}
export function copyOf(props: Props): Props {
  return { ...props };
}
export function copyWithSize(props: Props): Props {
  return { ...props, size: 4 };
}
export function copyBehindSize(props: Props): Props {
  return { size: -1, ...props };
}
////= lines-4	setSize	props	Props	size	number	props.size
////= lines-4	setOn	props	Props	on	boolean	props.on
export type Pair = { first: unknown; second: unknown };
export function makePair(first: unknown, second: unknown): Pair {
  return { first, second };
}
export function copyOfPair(pair: Pair): Pair {
  return { ...pair };
}
//// record-copies-with-extra-properties/untyped.js
import { makeProps, copyOf, copyWithSize, copyBehindSize, setSize, setOn, makePair, copyOfPair } from "./shapes.ts";

const mark = Symbol("mark");

function describe(o) {
  const descriptors = Object.getOwnPropertyDescriptors(o);
  return Reflect.ownKeys(o).map(key => {
    const d = descriptors[key];
    return String(key) + ":" + ("value" in d ? JSON.stringify(d.value) : "accessor") + (d.writable === false ? "!w" : "") + (d.enumerable ? "" : "!e") + (d.configurable ? "" : "!c");
  }).join() + (Object.isExtensible(o) ? "" : " not extensible");
}

const givers = {
  nothing(o) {},
  one(o) { o.tag = 1; },
  three(o) { o.a = 1; o.b = { deep: true }; o.c = "c"; },
  ten(o) { for (let i = 0; i < 10; i++) o["n" + i] = i; },
  betweenFields(o) { o.before = 1; setSize(o, 2); o.between = 3; setOn(o, true); o.after = 4; },
  symbol(o) { o.tag = 1; o[mark] = 2; },
  index(o) { o[3] = "three"; o.tag = 1; o[1] = "one"; },
  hidden(o) { o.tag = 1; Object.defineProperty(o, "hidden", { value: 2, enumerable: false, configurable: true, writable: true }); o.last = 3; },
  getter(o) { o.tag = 1; Object.defineProperty(o, "computed", { get() { return this.tag + 100; }, enumerable: true, configurable: true }); },
  readOnly(o) { Object.defineProperty(o, "fixed", { value: 1, enumerable: true, configurable: true, writable: false }); o.tag = 2; },
  notConfigurable(o) { Object.defineProperty(o, "stuck", { value: 1, enumerable: true, configurable: false, writable: true }); },
  deleted(o) { o.a = 1; o.b = 2; o.c = 3; delete o.b; },
  frozen(o) { o.tag = 1; Object.freeze(o); },
  sealed(o) { o.tag = 1; Object.seal(o); },
  notExtensible(o) { o.tag = 1; Object.preventExtensions(o); },
  proto(o) { Object.defineProperty(o, "__proto__", { value: 5, enumerable: true, configurable: true, writable: true }); },
};

export function run() {
  for (const giver in givers) {
    for (const [name, copy] of [["copyOf", copyOf], ["copyWithSize", copyWithSize], ["copyBehindSize", copyBehindSize]]) {
      const said = new Set();
      for (let i = 0; i < 5; i++) {
        const source = makeProps(7);
        givers[giver](source);
        const before = describe(source);
        const made = copy(source);
        const first = describe(made);
        made.tag = "changed";
        made.added = true;
        made.label = "changed";
        if (made.b && typeof made.b === "object") made.b.deep = "shared";
        said.add(first + " || the source afterwards " + (describe(source) === before ? "as before" : describe(source)) + " || again " + describe(copy(made)) + " || " + (made === source));
      }
      console.log(giver, name, said.size, [...said][0]);
    }
  }
  for (let i = 0; i < 4; i++) {
    const pair = makePair(i, "s");
    pair.tag = i;
    pair.more = [i];
    const made = copyOfPair(pair);
    const again = copyOfPair(made);
    again.tag = -1;
    console.log("pair", describe(pair), "|", describe(made), "|", describe(again), made.more === pair.more);
  }
  const kept = [];
  for (let i = 0; i < 20000; i++) {
    const source = makeProps(i);
    source.tag = { i };
    source["k" + (i & 7)] = i;
    kept.push(copyOf(source));
    if (kept.length > 500) kept.shift();
  }
  let sum = 0;
  for (const o of kept) sum += o.tag.i + Object.keys(o).length;
  console.log("many", sum);
}
//// record-given-a-prototype-where-it-is-sure-to-run.ts
////= lines-16	Row	id	number
const parent = {
  hello(this: Row): string {
    return "hi " + this.id;
  },
};
const row: Row = { id: 1 };
Object.setPrototypeOf(row, parent);
console.log(row.id, (row as any).hello(), Object.getPrototypeOf(row) === parent, Object.keys(row).join());
Object.setPrototypeOf(row, null);
console.log(row.id, Object.getPrototypeOf(row), "hello" in row);
function adopt(): Row {
  const made: Row = { id: 2 };
  Object.setPrototypeOf(made, parent);
  return made;
}
console.log((adopt() as any).hello(), adopt().id);
//// record-inside-generic-result.ts
// A generic function returns a record that holds another record, both created at the function's own type parameters. The caller reads the inner record through the result's type at the caller's type arguments: it fits, so it is accepted.
const row = (name: string, f: () => unknown) => { let r: unknown; try { r = JSON.stringify(f()); } catch (e) { r = "THROWS " + (e as Error).message.split(" (bun")[0].split("\n")[0]; } console.log(name + ": " + r); };
const throws = (name: string, f: () => unknown) => { let r = "returns"; try { f(); } catch { r = "throws"; } console.log(name + ": " + r); };

type Served<Cause, Result> = { readonly cause: Cause; readonly result: Result; readonly number: number };
type NearCause = "send" | "poll";
type NearResult = "status" | "not_found";
type NearServed = Served<NearCause, NearResult>;
type FarServed = Served<"turn" | "timer", number>;

function direct<C, R>(cause: C, result: R): Served<C, R> { return { cause, result, number: 1 }; }
function nested<C, R>(cause: C, result: R): { served: Served<C, R>; n: number } { return { served: { cause, result, number: 2 }, n: 0 }; }
function twice<C, R>(cause: C, result: R): { outer: { served: Served<C, R> } } { return { outer: { served: { cause, result, number: 3 } } }; }
function optional<C, R>(cause: C, result: R): { served?: Served<C, R> | null } { return { served: { cause, result, number: 4 } }; }
function both<C, R>(cause: C, result: R): { first: Served<C, R>; second: Served<R, C> } { return { first: { cause, result, number: 5 }, second: { cause: result, result: cause, number: 6 } }; }
function kept<C, R>(cause: C, result: R) { const served: Served<C, R> = { cause, result, number: 7 }; return { served, again: () => served.cause, same: (other: unknown) => other === served }; }
function listed<C, R>(cause: C, result: R): { all: Served<C, R>[] } { return { all: [{ cause, result, number: 8 }] }; }

const arrow = <C, R>(cause: C, result: R): { served: Served<C, R> } => ({ served: { cause, result, number: 9 } });
function bounded<C extends string, R extends string>(cause: C, result: R): { served: Served<C, R> } { return { served: { cause, result, number: 10 } }; }
function called<C, R>(cause: C, result: R, then: (u: { served: Served<C, R> }) => string): string { return then({ served: { cause, result, number: 11 } }); }
function inElements<C, R>(cause: C, result: R): { all: { served: Served<C, R> }[] } { return { all: [{ served: { cause, result, number: 12 } }] }; }
function* each<C, R>(cause: C, result: R): Generator<{ served: Served<C, R> }> { yield { served: { cause, result, number: 13 } }; }
function fill<C, R>(into: { served: Served<C, R> | null }, cause: C, result: R) { into.served = { cause, result, number: 14 }; }
async function later<C, R>(cause: C, result: R): Promise<{ served: Served<C, R> }> { await 0; return { served: { cause, result, number: 15 } }; }
class Keeper { kept: { served: NearServed; n: number } | null = null; }
const use = (s: NearServed) => s.cause.toUpperCase() + s.result.length + s.number;
const useFar = (s: FarServed) => s.cause.length + s.result + s.number;
const hold = (s: NearServed): { read: NearServed } => ({ read: s });
const handedOn = (u: { served: NearServed; n: number }) => use(u.served) + u.n;

row("the result itself", () => use(direct<NearCause, NearResult>("poll", "status")));
row("a member of the result", () => use(nested<NearCause, NearResult>("poll", "status").served));
row("laid into a literal under a written type", () => { const u = nested<NearCause, NearResult>("poll", "status"); const made: { read: NearServed; n: number } = { read: u.served, n: u.n }; return made; });
row("destructured", () => { const { served } = nested<NearCause, NearResult>("send", "not_found"); return hold(served); });
row("two members deep", () => use(twice<NearCause, NearResult>("poll", "status").outer.served));
row("an optional member", () => use(optional<NearCause, NearResult>("poll", "status").served!));
row("type arguments that are inferred", () => { const cause: NearCause = "send"; const result: NearResult = "status"; return use(nested(cause, result).served); });
row("the same function at other type arguments", () => useFar(nested<"turn" | "timer", number>("timer", 40).served));
row("two members at swapped type arguments", () => { const b = both<NearCause, NearResult>("poll", "status"); return [use(b.first), b.second.cause.length + b.second.result.length]; });
row("the result is handed on first", () => handedOn(nested<NearCause, NearResult>("send", "status")));
row("read twice: one object", () => { const u = nested<NearCause, NearResult>("poll", "status"); const a: NearServed = u.served; const b: NearServed = u.served; return a === b; });
row("the generic function still reads it", () => { const k = kept<NearCause, NearResult>("poll", "status"); const s: NearServed = k.served; return [use(s), k.again(), k.same(s)]; });
row("an element of a member", () => use(listed<NearCause, NearResult>("poll", "status").all[0]));
row("inside try", () => { try { return use(nested<NearCause, NearResult>("poll", "status").served); } catch { return "caught"; } });
row("a generic arrow function", () => use(arrow<NearCause, NearResult>("poll", "status").served));
row("type parameters with bounds", () => use(bounded<NearCause, NearResult>("poll", "status").served));
row("handed to a callback", () => called<NearCause, NearResult>("poll", "status", u => use(u.served)));
row("inside an element of an array", () => use(inElements<NearCause, NearResult>("poll", "status").all[0].served));
row("the result is spread", () => { const u = { ...nested<NearCause, NearResult>("poll", "status"), n: 1 }; return use(u.served); });
row("the result is stored in a field", () => { const k = new Keeper(); k.kept = nested<NearCause, NearResult>("poll", "status"); return use(k.kept.served); });
row("yielded by a generator", () => { for (const u of each<NearCause, NearResult>("poll", "status")) return use(u.served); });
row("stored into an object of the caller", () => { const into: { served: NearServed | null } = { served: null }; fill(into, "poll" as NearCause, "status" as NearResult); return use(into.served!); });
const awaited = await later<NearCause, NearResult>("poll", "status");
row("awaited", () => use(awaited.served));
throws("a cause of another kind, through any", () => use(nested<NearCause, NearResult>(5 as any, "status").served));

let sum = 0;
for (let i = 0; i < 20000; i++) {
  sum += i % 2 ? use(nested<NearCause, NearResult>(i % 4 === 1 ? "poll" : "send", "status").served).length : useFar(nested<"turn" | "timer", number>("turn", i).served);
}
row("many times, the type arguments taking turns", () => sum);
//// record-proxy-from-generic-function.ts
// A Proxy of an object of a type is of that type. A generic function that wraps its argument in one hands it out as whatever type is put in for the type parameter. One form a program: another form in the same program may open the types to it.
type Sub = { k: number };
type State = { n: number; sub: Sub };
const seen: string[] = [];
const holder: { s: State } = { s: { n: 1, sub: { k: 1 } } };
function wrap<T extends object>(t: T): T { return new Proxy(t, { get(target, key, receiver) { seen.push(String(key)); return Reflect.get(target, key, receiver) } }) }
for (let round = 0; round < 3; round++) {
  const state: State = { n: round, sub: { k: 2 } };
  const wrapped = wrap(state);
  wrapped.n += 10;
  holder.s = wrapped;
  console.log(holder.s.n, state.n, holder.s.sub === state.sub, (wrapped as object) === state);
}
console.log(seen.join());
//// record-types-differ-in-optional-fields.ts
// Objects of record types that differ only in their optional fields are read and written through one of the types.
type L = { a: number; n?: string };
type V = { a: number; m?: string };
type W = { a: number; k?: string; m?: string };
function makeL(i: number): L { return { a: i, n: "the value of n" }; }
function makeV(i: number): V { return { a: i, m: "the value of m" }; }
function makeW(i: number): W { return { a: i, k: "the value of k" }; }
function readM(v: V): string | undefined { return v.m; }
function readN(l: L): string | undefined { return l.n; }
function hasM(v: V): boolean { return v.m !== undefined; }
function writeM(v: V, s: string): void { v.m = s; }
const say = (what: string, got: unknown) => console.log(what + ": " + String(got));
const l = makeL(1), v = makeV(2), w = makeW(3);
say("m of an L", readM(l));
say("m of a V", readM(v));
say("m of a W", readM(w));
say("n of an L", readN(l));
say("an L has m", hasM(l));
say("keys of an L", Object.keys(l).join());
writeM(l, "written as m");
say("n of an L that m was written to", readN(l));
say("m of an L that m was written to", readM(l));
say("keys of it", Object.keys(l).join());
say("as JSON", JSON.stringify(l));
const all: V[] = [];
for (let i = 0; i < 6; i++) all.push(i % 3 === 0 ? makeL(i) : i % 3 === 1 ? makeV(i) : makeW(i));
let seen = "";
for (const x of all) seen += (x.m === undefined ? "-" : "m");
say("which of the mixture have m", seen);
type Wide = { f0: number; f1?: string; f2?: number; f3?: string; f4?: number; f5?: string; f6?: number; f7?: string; f8?: number; f9?: string; f10?: number; f11?: string; f12?: number; f13?: string };
function makeWide(i: number): Wide { return { f0: i, f1: "one", f2: 2, f3: "three", f4: 4, f5: "five", f6: 6, f7: "seven", f8: 8, f9: "nine", f10: 10, f11: "eleven", f12: 12, f13: "thirteen" }; }
function makeSparse(i: number): Wide { return { f0: i, f9: "only nine", f12: 120 }; }
function readWide(w: Wide): string { return [w.f0, w.f1, w.f2, w.f3, w.f4, w.f5, w.f6, w.f7, w.f8, w.f9, w.f10, w.f11, w.f12, w.f13].map(String).join(); }
function writeWide(w: Wide): void { w.f8 = 88; w.f13 = "written"; w.f11 = undefined; }
const wideFromOutside = JSON.parse('{"f13":"thirteen from outside","f0":5,"f8":80,"f3":"three from outside","f11":"eleven from outside"}') as Wide;
const wides: Wide[] = [makeWide(1), makeSparse(2), wideFromOutside, makeWide(3), makeSparse(4)];
for (const w of wides) say("a wide object", readWide(w));
let sum = 0, text = "";
for (const w of wides) { sum += (w.f8 ?? 0) + (w.f12 ?? 0) + (w.f10 ?? 0); text += (w.f9 ?? "-") + (w.f13 ?? "-") + ";"; }
say("sum over the wide objects", sum);
say("text over the wide objects", text);
for (const w of wides) writeWide(w);
for (const w of wides) say("after writing", readWide(w) + " " + Object.keys(w).join());
delete wides[0]!.f9;
say("after deleting f9", readWide(wides[0]!) + " " + JSON.stringify(wides[0]));
export {};
//// record-via-index-signature.ts
// A record is assignable to a type with an index signature that allows more: a store through that type of a value the field does not allow is taken, and every typed read of the field afterwards throws a TypeError, whatever is done with the value.
function attempt(label: string, f: () => unknown): void { try { console.log(label, String(f())) } catch (e) { console.log(label, (e as Error).constructor.name) } }
function plusOne(n: number): number { return n + 1 }
type Lit = { v: number }
const n4: Lit = { v: 1 }
const w4: { [k: string]: number | string } = n4
attempt("store", () => { w4["v"] = "text"; return "taken" })
attempt("looked at", () => n4.v)
attempt("typeof", () => typeof n4.v)
attempt("arithmetic", () => n4.v * 2)
attempt("held", () => plusOne(n4.v))
//// records-spread-after-another-source.ts
// `{ ...defaults, ...record }`, `Object.assign({}, defaults, record)` and `Object.assign(target, record)` where the record is an object of a written type and the code that copies knows nothing of it. The copy has what plain Bun gives it, in that order, whatever the record has been through; and copying records of one type onto targets of one shape takes a plan that is made once.
declare const aotOperationCount: undefined | ((name: string) => number);
const counted = typeof aotOperationCount === "function" ? aotOperationCount : null;
const byPlan = () => counted ? counted("operationAOTCopyDataProperties") + counted("operationAOTNewObjectWithSpreads") + counted("operationAOTObjectAssignFrom") : 0;
interface Inner { v: number }
interface Row { count: number; ratio: number; ok: boolean; name: string; inner: Inner; any: unknown; maybe?: number; other?: string; nothing: number | undefined; none: Inner | null }
const make = (i: number): Row => ({ count: i, ratio: i + 0.5, ok: i % 2 === 0, name: "n" + i, inner: { v: i }, any: i, nothing: undefined, none: null });
const withOptional = (i: number): Row => ({ ...make(i), maybe: i, other: "o" });
const otherOrder = (i: number): Row => ({ none: null, nothing: 1, any: "a", inner: { v: i }, name: "n", ok: true, ratio: 1, count: i });
const show = (o: any): string => Reflect.ownKeys(o).map(k => { const d = Object.getOwnPropertyDescriptor(o, k)!; return String(k) + ":" + ("value" in d ? JSON.stringify(d.value) ?? "undefined" : "accessor") + (d.writable ? "w" : "") + (d.enumerable ? "e" : "") + (d.configurable ? "c" : ""); }).join(",");
const attempt = (f: () => unknown): string => { try { return String(f()); } catch (e: any) { return e.constructor.name; } };
function spreadSecond(first: any, second: any): any { return { ...first, ...second }; }
function spreadBetween(first: any, second: any): any { return { a: 1, ...first, b: 2, ...second, c: 3 }; }
function assignSecond(first: any, second: any): any { return Object.assign({}, first, second); }
function assignOnto(target: any, source: any): any { return Object.assign(target, source); }
const calls: string[] = [];
const firsts: [string, () => any][] = [
  ["two others", () => JSON.parse('{"d0":0,"d1":1}')],
  ["nothing", () => ({})],
  ["the same names", () => JSON.parse('{"name":"first","count":-1,"zz":9}')],
  ["a record", () => make(7)],
  ["many", () => { const o: any = {}; for (let i = 0; i < 12; i++) o["m" + i] = i; return o; }],
];
const records: [string, () => any][] = [
  ["as made", () => make(1)],
  ["with the optional ones", () => withOptional(2)],
  ["in another order", () => otherOrder(3)],
  ["frozen", () => Object.freeze(make(4))],
  ["with an extra", () => { const r: any = make(5); r.extra = "e"; return r; }],
  ["with a symbol", () => { const r: any = make(6); r[Symbol.for("s")] = "s"; return r; }],
  ["one deleted", () => { const r: any = withOptional(7); delete r.maybe; return r; }],
  ["one deleted and added", () => { const r: any = withOptional(8); delete r.maybe; r.maybe = 80; return r; }],
  ["stored to", () => { const r = make(9); r.count = 90; r.ratio = 9; r.nothing = 5; r.none = { v: 1 }; r.any = { deep: [1] }; return r; }],
];
for (let turn = 0; turn < 2; turn++) for (const [f, first] of firsts) for (const [r, record] of records) {
  console.log(turn, f, "<-", r, "|", show(spreadSecond(first(), record())), "|", show(spreadBetween(first(), record())), "|", show(assignSecond(first(), record())), "|", show(assignOnto(first(), record())));
}
const targets: [string, () => any][] = [
  ["a setter", () => ({ p: 0, set count(v: number) { calls.push("set count " + v); } })],
  ["inherits a setter", () => Object.create({ set name(v: string) { calls.push("inherited set name " + v); } })],
  ["read-only", () => Object.defineProperty({ p: 0 }, "ok", { value: "fixed", writable: false, enumerable: true, configurable: true })],
  ["frozen", () => Object.freeze({ p: 0 })],
  ["closed", () => Object.preventExtensions({ p: 0, count: 0 })],
  ["a record", () => make(20)],
  ["an array", () => [1]],
];
for (let turn = 0; turn < 2; turn++) for (const [t, target] of targets) { const before = calls.length, into = target(); console.log(turn, t, attempt(() => assignOnto(into, make(3)) === into), show(into), calls.slice(before).join()); }
const same = make(1), copy = spreadSecond({}, same);
console.log(copy.inner === same.inner, copy !== same, Object.getPrototypeOf(copy) === Object.prototype);
const start = byPlan();
let sum = 0;
for (let i = 0; i < 2000; i++) { const r = make(i); sum += spreadSecond(firsts[0][1](), r).count + assignSecond(firsts[0][1](), r).count + assignOnto(JSON.parse('{"p":1}'), r).count; }
console.log(sum, counted ? byPlan() - start >= 5900 : true);
//// recursive-types.ts
// Types that refer to themselves and to each other: lists, trees, cycles, a narrower recursive type over wider nodes, and nodes from `JSON.parse` in between.
interface ListItem { value: number; next: ListItem | null }
interface Linked { next: Linked | null }
interface TwoWay { value: number; next: TwoWay | null; prev: TwoWay | null }
interface Tree { value: number; left?: Tree; right?: Tree }
interface Owner { label: string; pets: Pet[]; partner?: Owner }
interface Pet { label: string; owner: Owner; friend?: Pet }
function nameOf(e: unknown): string { return (e as Error).constructor.name }
function fromArray(values: number[]): ListItem | null { let head: ListItem | null = null; for (let i = values.length - 1; i >= 0; i--) head = { value: values[i], next: head }; return head }
function toText(head: ListItem | null): string { const out: number[] = []; for (let n = head; n !== null; n = n.next) out.push(n.value); return out.join() }
function count(head: Linked | null): number { let n = 0; for (let l = head; l !== null; l = l.next) n++; return n }
function reverse(head: ListItem | null): ListItem | null { let done: ListItem | null = null; while (head !== null) { const next: ListItem | null = head.next; head.next = done; done = head; head = next } return done }
function linkOf(item: ListItem): ListItem | null { return item.next }
function hasCycle(head: Linked | null): boolean {
  let slow = head, fast = head
  while (fast !== null && fast.next !== null) { slow = slow!.next; fast = fast.next.next; if (slow === fast) return true }
  return false
}
let list = fromArray([1, 2.5, -0, 4, 5])
console.log(toText(list), count(list), hasCycle(list), JSON.stringify(list))
list = reverse(list)
console.log(toText(list), count(list), Object.keys(list!).join())

// Nodes of a wider type, and nodes from untyped code, in one chain. (The link of a wider node, read with the wider type once it holds a narrower node: type-rules/field-covariance-linked-list.)
const first: TwoWay = { prev: null, value: 10, next: null }
const second: TwoWay = { value: 20, next: null, prev: first }
first.next = second
const parsed: ListItem = JSON.parse('{"next":null,"value":30,"stray":true}')
const mixedHead: ListItem = { value: 0, next: first }
;(second as ListItem).next = parsed
parsed.next = { value: 40, next: null }
console.log(toText(mixedHead), count(mixedHead), count(first), second.prev === first, second.next === (parsed as object), JSON.stringify(parsed))
console.log(toText(reverse(mixedHead)), first.prev, linkOf(first) === mixedHead, second.prev === first, Object.keys(second).join(), Object.keys(parsed).join())

// Cycles.
const ring = fromArray([1, 2, 3])!
ring.next!.next!.next = ring
console.log(hasCycle(ring), ring.next!.next!.next!.value, ring.next!.next!.next === ring)
try { console.log(JSON.stringify(ring)) } catch (e) { console.log(nameOf(e)) }
const selfish: Tree = { value: 1 }
selfish.left = selfish
console.log(selfish.left.left?.left?.value, selfish.right?.left?.value, "right" in selfish, selfish.left === selfish)

// A search tree: optional children are created as they are needed.
function insert(t: Tree | undefined, value: number): Tree {
  if (t === undefined) return { value }
  if (value < t.value) t.left = insert(t.left, value); else t.right = insert(t.right, value)
  return t
}
function walk(t: Tree | undefined, out: number[]): number[] { if (t) { walk(t.left, out); out.push(t.value); walk(t.right, out) } return out }
function depth(t: Tree | undefined): number { return t === undefined ? 0 : 1 + Math.max(depth(t.left), depth(t.right)) }
function shape(t: Tree | undefined): string { return t === undefined ? "." : "(" + Object.keys(t).map(k => k[0]).join("") + shape(t.left) + shape(t.right) + ")" }
function mirror(t: Tree | undefined): void { if (t) { const l = t.left; t.left = t.right; t.right = l; mirror(t.left); mirror(t.right) } }
let root: Tree | undefined
for (const v of [50, 30, 70, 20, 40, 60, 80, 35, 65.5, -0]) root = insert(root, v)
console.log(walk(root, []).join(), depth(root), shape(root), JSON.stringify(root))
mirror(root)
console.log(walk(root, []).join(), depth(root), shape(root), JSON.stringify(root))
function prune(t: Tree): void { if (t.left === undefined) delete t.left; else prune(t.left); if (t.right === undefined) delete t.right; else prune(t.right) }
prune(root!)
console.log(shape(root), "left" in root!.left!.left!, root!.left!.left!.left)

// Two types that refer to each other.
const ann: Owner = { label: "ann", pets: [] }
const bob: Owner = { pets: [], label: "bob", partner: ann }
ann.partner = bob
const rex: Pet = { label: "rex", owner: ann }
const tom: Pet = { owner: bob, label: "tom", friend: rex }
rex.friend = tom
ann.pets.push(rex); bob.pets.push(tom, rex)
console.log(rex.owner.partner?.pets.map(p => p.label).join(), tom.friend?.friend?.owner.label, ann.partner.partner === ann, bob.pets[1].owner.pets[0] === rex, Object.keys(ann).join(), Object.keys(rex).join())
rex.owner = bob
delete ann.partner
console.log(ann.pets[0].owner.label, bob.partner?.partner?.label, tom.friend?.owner.partner?.label, "partner" in ann)

// Long and deep.
let chain: ListItem | null = null
for (let i = 0; i < 20000; i++) {
  if (i % 1000 === 999) { const p: ListItem = JSON.parse('{"value":' + i + ',"next":null}'); p.next = chain; chain = p }
  else chain = { value: i, next: chain }
}
let sum = 0
for (let n = chain; n !== null; n = n.next) sum += n.value
console.log(count(chain), sum, toText(reverse(chain)).length)
let deep: Tree = { value: 0 }
for (let i = 1; i < 500; i++) deep = i & 1 ? { value: i, left: deep } : { right: deep, value: i }
console.log(depth(deep), walk(deep, []).length, shape(deep).length)
//// reference-fields-set-nullish.ts
// A field of a reference type gets null or undefined and is then read through its type.
////= attempt
interface Rec { toLocaleString?: () => string; n: number; s: string; b: boolean; tail: number }
function fresh(): Rec { return { n: 1, s: "s", b: true, tail: 9 } }
function show(o: object): string { return Object.keys(o).join() + " " + JSON.stringify(o) }
function poke(o: any, k: string, v: unknown) { o[k] = v }
attempt("b3", () => { const r = fresh(); poke(r, "s", null); return [r.s, r.s + "!", show(r)].map(String).join(" ") })
attempt("b4", () => { const r = fresh(); Object.assign(r, { s: null }); return [r.s, show(r)].map(String).join(" ") })
// No any and no cast: a view in which the field is optional.
interface Looser { n?: number; s?: string | null }
attempt("c3", () => { const r = fresh(); const l: Looser = r; l.s = null; return [r.s, r.s + "!", show(r)].map(String).join(" ") })
attempt("c5", () => { const patch: Partial<Rec> = { s: undefined, n: 5 }; const merged = { ...fresh(), ...patch }; return [merged.s, merged.s + "!", merged.n + 1, show(merged)].map(String).join(" ") })
class Acc { total = 0; label = "acc"; add(n: number) { this.total += n; return this.total } }
attempt("e3", () => { const a = new Acc(); poke(a, "label", undefined); return [a.label, a.label + "!", show(a)].map(String).join(" ") })
// One access site, objects in every state.
function totalOf(list: Rec[]): string { let t = 0, text = ""; for (const r of list) { t += r.n; text += r.s } return t + text }
attempt("f1", () => { const a = fresh(), b = fresh(), c = fresh(), d = fresh(); poke(b, "s", undefined); poke(c, "s", null); return totalOf([a, b, c, d]) })
//// references-carried-across-awaits.ts
// An async function that waits keeps its frame in the heap, where the collector visits a list of places, not every word. A reference that was read from a field before an await and is used behind it must be on that list, whatever it is used for: read, stored into a new object, captured by a closure, copied by a spread, kept by a loop. The field is overwritten before the await, and every tick collects and fills the freed cells anew.
// The functions are called through a table, so that nothing is inlined and no object is dissolved.
type Leaf = { n: number; m: number };
type Holder = { leaf: Leaf; other: Leaf; maybe: Leaf | null; opt?: Leaf; text: string; mode: "on" | "off" | "auto" };
type Kept = { tag: number; leaf: Leaf };
function collect(): void { const g: any = globalThis; if (g.Bun) g.Bun.gc(true); else g.gc() }
function leaf(n: number): Leaf { return { n, m: n * 2 } }
function holder(n: number): Holder { return { leaf: F.leaf(n), other: F.leaf(n + 1), maybe: F.leaf(n + 2), opt: F.leaf(n + 3), text: "t" + n, mode: n & 1 ? "on" : "off" } }
function churn(): number { let s = 0; for (let i = 0; i < 200; i++) s += F.leaf(7000 + i).m; return s }
async function tick(): Promise<number> { await null; F.collect(); F.churn(); return 1 }
class Runner {
  leaf: Leaf; other: Leaf; list: Kept[] = [];
  constructor(n: number) { this.leaf = F.leaf(n); this.other = F.leaf(n + 1) }
  async swap(): Promise<number> { const a = this.leaf; this.leaf = this.other; await F.tick(); this.other = a; return this.other.n }
  async fill(k: number): Promise<number> { for (let i = 0; i < k; i++) { this.list.push({ tag: i, leaf: this.leaf }); await F.tick() } return this.list.length }
}
async function loopOverParameter(p: Leaf, k: number, out: Kept[]): Promise<number> { for (let i = 0; i < k; i++) { out.push({ tag: i, leaf: p }); await F.tick() } return out.length }
async function loopOverField(h: Holder, k: number, out: Kept[]): Promise<number> { for (let i = 0; i < k; i++) { out.push({ tag: i, leaf: h.leaf }); await F.tick() } return out.length }
async function closureBehind(h: Holder): Promise<() => number> { const a = h.leaf; h.leaf = h.other; await F.tick(); return () => a.n + a.m }
async function spreadBehind(h: Holder): Promise<Holder> { const copy = { ...h }; h.leaf = h.other; h.maybe = null; h.opt = undefined; h.text = ""; await F.tick(); return copy }
async function spreadLater(h: Holder): Promise<Holder> { await F.tick(); const copy = { ...h }; await F.tick(); return copy }
async function allKinds(h: Holder): Promise<Holder> { const a = h.leaf, b = h.other, c = h.maybe, d = h.opt, e = h.text, f = h.mode; h.leaf = b; h.other = a; h.maybe = null; h.opt = undefined; h.text = "x"; await F.tick(); await F.tick(); return { leaf: a, other: b, maybe: c, opt: d, text: e, mode: f } }
async function caught(h: Holder): Promise<Kept> { const a = h.leaf; h.leaf = h.other; try { await F.tick(); if (a.n < 0) throw new Error("no") } catch { return { tag: -1, leaf: a } } finally { await F.tick() } return { tag: 1, leaf: a } }
async function twoPaths(h: Holder, which: boolean): Promise<Kept> { const a = which ? h.leaf : h.other; h.leaf = F.leaf(1); h.other = F.leaf(2); await F.tick(); return { tag: 0, leaf: a } }
const F = { collect, leaf, holder, churn, tick, loopOverParameter, loopOverField, closureBehind, spreadBehind, spreadLater, allKinds, caught, twoPaths };
function show(h: Holder): string { return [h.leaf.n, h.other.m, h.maybe ? h.maybe.n : "null", h.opt ? h.opt.m : "none", h.text, h.mode].join() }
async function main(): Promise<void> {
  const lines: string[] = [];
  for (let i = 0; i < 6; i++) {
    const r = new Runner(i * 100);
    lines.push("swap " + await r.swap() + " fill " + await r.fill(3) + " " + r.list.map(k => k.leaf.n).join());
    const out: Kept[] = [];
    lines.push("parameter " + await F.loopOverParameter(F.leaf(i), 3, out) + " " + out.map(k => k.leaf.m).join());
    const out2: Kept[] = [];
    lines.push("field " + await F.loopOverField(F.holder(i), 3, out2) + " " + out2.map(k => k.leaf.m).join());
    lines.push("closure " + (await F.closureBehind(F.holder(i)))());
    lines.push("spread " + show(await F.spreadBehind(F.holder(i))) + " | " + show(await F.spreadLater(F.holder(i))));
    lines.push("kinds " + show(await F.allKinds(F.holder(i))));
    lines.push("caught " + (await F.caught(F.holder(i))).leaf.m + " paths " + (await F.twoPaths(F.holder(i), (i & 1) === 0)).leaf.n);
  }
  console.log(lines.join("\n"));
}
main();
//// references-from-two-fields-compared.ts
// `x.a === y.a` of two references that are read out of fields: one object or two, null, undefined, absent, a field that is never nil against one that may be, in a branch; and texts, which are compared by what they say.
function row(name: string, f: () => unknown): void { try { console.log(name + ": " + String(f())) } catch (e) { console.log(name + ": THROWS " + (e instanceof Error ? e.name + ": " + e.message.split("\n")[0].split(" (bun compile")[0] : String(e))) } }
function hide(v: unknown): any { return v }
interface N { v: number; w: number }
interface R { a: N; b: N | null; c: N | undefined; d?: N; s: string; t: string | null }
function n(i: number): N { return { v: i, w: i } }
function make(i: number): R { return { a: n(i), b: null, c: undefined, s: "s" + i, t: null } }
function same(x: R, y: R): boolean { return x.a === y.a }
function differ(x: R, y: R): boolean { return x.a !== y.a }
function sameB(x: R, y: R): boolean { return x.b === y.b }
function sameC(x: R, y: R): boolean { return x.c === y.c }
function sameD(x: R, y: R): boolean { return x.d === y.d }
function sameAB(x: R, y: R): boolean { return x.a === y.b }
function sameBC(x: R, y: R): boolean { return hide(x.b) === hide(y.c) }
function sameCD(x: R, y: R): boolean { return x.c === y.d }
function branch(x: R, y: R): number { if (x.a === y.a) return 1; if (x.b === y.b) return 2; return 3 }
function texts(x: R, y: R): boolean { return x.s === y.s }
function textsT(x: R, y: R): boolean { return x.t === y.t }
const F: { same: typeof same; differ: typeof differ; sameB: typeof sameB; sameC: typeof sameC; sameD: typeof sameD; sameAB: typeof sameAB; sameBC: typeof sameBC; sameCD: typeof sameCD; branch: typeof branch; texts: typeof texts; textsT: typeof textsT } = { same, differ, sameB, sameC, sameD, sameAB, sameBC, sameCD, branch, texts, textsT };
row("01 one object in two slots, two objects", () => { const x = make(1), y = make(2); const a = [F.same(x, y), F.differ(x, y)]; y.a = x.a; return a.concat([F.same(x, y), F.differ(x, y), F.same(x, x)]).join() });
row("02 null and null, null and an object, one object, two", () => { const x = make(1), y = make(2); const out = [F.sameB(x, y)]; x.b = n(1); out.push(F.sameB(x, y)); y.b = x.b; out.push(F.sameB(x, y)); y.b = n(1); out.push(F.sameB(x, y)); return out.join() });
row("03 undefined likewise", () => { const x = make(1), y = make(2); const out = [F.sameC(x, y)]; x.c = n(1); out.push(F.sameC(x, y)); y.c = x.c; out.push(F.sameC(x, y)); x.c = undefined; out.push(F.sameC(x, y)); return out.join() });
row("04 absent and absent, absent and undefined, absent and an object", () => { const x = make(1), y = make(2); const out = [F.sameD(x, y)]; y.d = undefined; out.push(F.sameD(x, y)); out.push(F.sameCD(x, y), F.sameCD(y, x)); y.d = n(1); out.push(F.sameD(x, y), F.sameCD(x, y)); x.d = y.d; out.push(F.sameD(x, y)); x.c = y.d; out.push(F.sameCD(x, y)); return out.join() });
row("05 a slot that is never nil and one that may be", () => { const x = make(1), y = make(2); const out = [F.sameAB(x, y)]; y.b = x.a; out.push(F.sameAB(x, y)); y.b = n(1); out.push(F.sameAB(x, y)); return out.join() });
row("06 null is not undefined", () => { const x = make(1), y = make(2); return F.sameBC(x, y) });
row("07 in a branch", () => { const x = make(1), y = make(2); const out = [F.branch(x, y)]; x.b = n(1); out.push(F.branch(x, y)); y.a = x.a; out.push(F.branch(x, y)); return out.join() });
row("08 texts are compared by what they say, not by where they lie", () => { const x = make(1), y = make(1); const out = [F.texts(x, y)]; y.s = "s" + hide(1); out.push(F.texts(x, y)); y.s = ["s", "1"].join(""); out.push(F.texts(x, y)); y.s = "s2"; out.push(F.texts(x, y)); out.push(F.textsT(x, y)); x.t = "a" + hide("b"); y.t = hide("a") + "b"; out.push(F.textsT(x, y)); y.t = null; out.push(F.textsT(x, y)); return out.join() });
//// reflect-construct-of-a-constructor-function-with-another-new-target.ts
// Reflect.construct() of a constructor function with another new.target: the object inherits from what new.target has as its `prototype` and has what the function stores. Only where the function is its own new.target is the object one of its own.
const attempt = (label: string, run: () => unknown) => { try { console.log(label, String(run())) } catch (error) { console.log(label, "throws", (error as Error).constructor.name) } }

interface Pair { first: number; second: string }
function Pair(this: Pair, first: number, second: string) { this.first = first; this.second = second }
Pair.prototype.describe = function (this: Pair) { return "pair " + this.first + this.second }
const PairClass = Pair as unknown as new (first: number, second: string) => Pair
const read = (pair: Pair) => pair.second + pair.first
const tell = (made: any, target: any): string =>
  [Object.keys(made).join(), read(made), Object.getPrototypeOf(made) === target.prototype, made instanceof PairClass, typeof made.describe === "function" ? made.describe() : "nothing to call"].join(" ")

function Other(this: any) { this.never = "the body of new.target does not run" }
Other.prototype.describe = function (this: Pair) { return "other " + this.second }
class Modern { extra = 1; describe() { return "modern " + Object.keys(this).length } }
class Heir extends (Pair as any) { own = true }

console.log("new:", tell(new PairClass(1, "a"), Pair))
console.log("no new.target given:", tell(Reflect.construct(Pair, [2, "b"]), Pair))
console.log("itself:", tell(Reflect.construct(Pair, [3, "c"], Pair), Pair))
console.log("another function:", tell(Reflect.construct(Pair, [4, "d"], Other), Other))
console.log("a class:", tell(Reflect.construct(Pair, [5, "e"], Modern), Modern))
console.log("a class that extends it:", tell(Reflect.construct(Pair, [6, "f"], Heir), Heir))
console.log("Object:", tell(Reflect.construct(Pair, [7, "g"], Object), Object))
for (const builtin of [Array, Map, Date, Error, Promise, Function, Uint8Array]) {
  const made = Reflect.construct(Pair, [8, builtin.name], builtin)
  console.log(tell(made, builtin), made instanceof builtin, Array.isArray(made), Object.prototype.toString.call(made))
}
attempt("what needs a real map:", () => Reflect.construct(Pair, [9, "h"], Map).size)

const boundTarget = Other.bind(null), boundPair = (Pair as any).bind(null, 10)
console.log("a bound function, which has no prototype property:", tell(Reflect.construct(Pair, [11, "i"], boundTarget), Object))
console.log("the function when bound:", tell(Reflect.construct(boundPair, ["j"]), Pair), tell(Reflect.construct(boundPair, ["k"], boundPair), Pair), tell(Reflect.construct(boundPair, ["l"], Other), Other), tell(new (boundPair as any)("m"), Pair))

const asked: string[] = []
const watched = new Proxy(Other, { get(target, key, receiver) { asked.push("get " + String(key)); return Reflect.get(target, key, receiver) }, construct() { asked.push("construct"); return {} }, apply() { asked.push("apply") } })
console.log("a proxy:", tell(Reflect.construct(Pair, [(asked.push("first argument"), 12), (asked.push("second argument"), "n")], watched), Other), asked.join())
const watchedPair: any = new Proxy(Pair, { get(target, key, receiver) { asked.push("get " + String(key)); return Reflect.get(target, key, receiver) } })
asked.length = 0
console.log("a proxy of itself:", tell(new watchedPair(13, "o"), Pair), tell(Reflect.construct(Pair, [14, "p"], watchedPair), Pair), tell(Reflect.construct(watchedPair, [15, "q"], Pair), Pair), asked.join())
attempt("a prototype that throws when it is read:", () => Reflect.construct(Pair, [16, "r"], new Proxy(Other, { get() { throw new RangeError("read") } })))

for (const notAnObject of [5, "text", null, undefined, false, Symbol.for("s"), 1n]) {
  function Loose(this: any) {}
  Loose.prototype = notAnObject
  console.log("a prototype that is", typeof notAnObject + ":", tell(Reflect.construct(Pair, [17, "s"], Loose), Object))
}
function Swapped(this: any) {}
const before = Reflect.construct(Pair, [18, "t"], Swapped), earlier = (Swapped as any).prototype
Swapped.prototype = { describe() { return "swapped" } }
const after = Reflect.construct(Pair, [19, "u"], Swapped)
console.log("a prototype that is replaced:", tell(before, { prototype: earlier }), tell(after, Swapped), before instanceof (Swapped as any), after instanceof (Swapped as any))

attempt("an arrow function:", () => Reflect.construct(Pair, [1, "a"], (() => 0) as any))
attempt("a method:", () => Reflect.construct(Pair, [1, "a"], ({ m() {} }).m as any))
attempt("an async function:", () => Reflect.construct(Pair, [1, "a"], (async function () {}) as any))
attempt("no function:", () => Reflect.construct(Pair, [1, "a"], {} as any))
attempt("undefined, written out:", () => Reflect.construct(Pair, [1, "a"], undefined as any))
attempt("no list:", () => (Reflect.construct as any)(Pair))
console.log("a list that is no array:", tell(Reflect.construct(Pair, { length: 2, 0: 20, 1: "v", 2: "ignored" } as any, Other), Other))
console.log("too few:", Object.keys(Reflect.construct(Pair, [], Other)).join(), JSON.stringify(Reflect.construct(Pair, [21], Modern)))

function Trapped(this: any) {}
const stores: string[] = []
Object.defineProperty(Trapped.prototype, "first", { set(value: number) { stores.push("first is set to " + value) }, get() { return "from the getter" } })
Object.defineProperty(Trapped.prototype, "second", { value: "read-only", writable: false })
attempt("new.target's prototype has a setter and a property that is read-only:", () => Reflect.construct(Pair, [22, "w"], Trapped))
console.log(stores.join())

interface Answer { value: number }
function Answer(this: Answer, value: number) { this.value = value; if (value > 100) return [value]; return undefined }
console.log("what the function returns:", JSON.stringify(Reflect.construct(Answer, [101], Other)), Array.isArray(Reflect.construct(Answer, [102], Answer)), JSON.stringify(Reflect.construct(Answer, [1], Other)), Reflect.construct(Answer, [2], Other) instanceof (Other as any))

const targets: Function[] = [Pair, Other, Modern, Pair, Heir, Pair]
let total = 0, ownObjects = 0
for (let round = 0; round < 12000; round++) {
  const made: Pair = Reflect.construct(Pair, [round, "z"], targets[round % targets.length])
  total += made.first + made.second.length + Object.keys(made).length
  if (Object.getPrototypeOf(made) === Pair.prototype) ownObjects++
}
console.log(total, ownObjects, tell(new PairClass(23, "x"), Pair))
//// reparented-object-spares-arrays-1.ts
// An object of the program is given another object of the program for its prototype, by a store to __proto__. That is nobody's business but theirs: the arrays of the program keep their storage. (`describe` is the shell's; without it the lines say false.)
const describe = (globalThis as any).describe as undefined | ((value: unknown) => string);
const arraysAreSlow = (): boolean => typeof describe === "function" && describe([1, 2, 3].concat([4])).includes("SlowPut");
const t = { a() { return "a"; }, b() { return "b"; } };
const heir: any = Object.create(t);
console.log("before:", arraysAreSlow(), heir.a(), typeof heir.extra);
(t as any).__proto__ = { extra() { return "x"; } };
console.log("behind:", arraysAreSlow(), (t as any).extra(), t.a(), t.b(), heir.a(), heir.extra(), Object.keys(t).join(), "extra" in t, Object.hasOwn(t, "extra"));
const list = [1, 2, 3]; list.push(4); list[6] = 7;
console.log(list.join(), list.length, arraysAreSlow());
//// reparented-object-spares-arrays-2.ts
// An object of the program is given another object of the program for its prototype, by Object.setPrototypeOf. That is nobody's business but theirs: the arrays of the program keep their storage. (`describe` is the shell's; without it the lines say false.)
const describe = (globalThis as any).describe as undefined | ((value: unknown) => string);
const arraysAreSlow = (): boolean => typeof describe === "function" && describe([1, 2, 3].concat([4])).includes("SlowPut");
function attempt(name: string, f: () => unknown): void { try { console.log(name, String(f()), arraysAreSlow()); } catch (e) { console.log(name, "throws", (e as Error).constructor.name, arraysAreSlow()); } }
const proto = { hello() { return "h"; } };
const a = { x: 1, y: "y" };
const heir: any = Object.create(a);
attempt("before:", () => [heir.x, typeof heir.hello].join());
attempt("another object of the program:", () => { Object.setPrototypeOf(a, proto); return [(a as any).hello(), a.x, a.y, heir.hello(), Object.getPrototypeOf(a) === proto, Object.keys(a).join()].join(); });
attempt("the same again:", () => { Object.setPrototypeOf(a, proto); return Object.getPrototypeOf(a) === proto; });
attempt("a cycle:", () => Object.setPrototypeOf(proto, heir));
attempt("null:", () => { const b = { z: 2 }; Object.setPrototypeOf(b, null); return [Object.getPrototypeOf(b), b.z, "toString" in b].join(); });
attempt("one that is not extensible:", () => { const c = Object.preventExtensions({ w: 3 }); return Object.setPrototypeOf(c, proto); });
attempt("Reflect.setPrototypeOf of one that is not extensible:", () => Reflect.setPrototypeOf(Object.preventExtensions({ v: 4 }), proto));
attempt("with properties that were added:", () => { const d: any = { u: 5 }; d.added = 6; d[0] = "zero"; Object.setPrototypeOf(d, proto); return [d.hello(), d.u, d.added, d[0], Object.keys(d).join()].join(); });
const list = [1, 2, 3]; list.push(4); list[6] = 7;
console.log(list.join(), list.length, arraysAreSlow());
//// replaced-methods.ts
// Methods, accessors and statics that the program replaces, redefines or deletes, on the prototype, on an instance, by `Reflect`, or from inside the method itself.
class Base {
  n = 1
  who(): string { return "base" + this.n }
  twice(): string { return this.who() + this.who() }
  get size(): number { return this.n * 10 }
  set size(v: number) { this.n = v / 10 }
  static make(): Base { return new Base() }
}
class Derived extends Base {
  override who(): string { return "derived(" + super.who() + ")" }
  only(): string { return "only" + this.n }
  override get size(): number { return super.size + 1 }
  override set size(v: number) { super.size = v * 2 }
}
function use(o: Base): string { return o.who() + " " + o.twice() + " " + o.size }
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
const b = new Base(), d = new Derived()
function all(label: string) { console.log(label, "|", attempt(() => use(b)), "|", attempt(() => use(d)), "|", attempt(() => use(new Derived())), "|", attempt(() => d.only()), "|", Object.keys(b).join(), Object.keys(d).join()) }
function patch(target: any, key: string, value: unknown) { target[key] = value }
all("start")
Base.prototype.who = function (this: Base) { return "patched" + this.n }
all("a method replaced")
Derived.prototype.who = function (this: Derived) { return "again" + this.n }
all("in the extending class")
patch(Base.prototype, ["t", "wice"].join(""), function (this: Base) { return "<" + this.who() + ">" })
all("by a name that is computed")
console.log(delete (Derived.prototype as any).who, Object.hasOwn(Derived.prototype, "who"), "who" in d)
all("deleted in the extending class")
console.log(Reflect.set(Base.prototype, "who", function (this: Base) { return "r" + this.n }), Reflect.defineProperty(Base.prototype, "who", { value(this: Base) { return "rd" + this.n }, writable: true, configurable: true }))
all("by Reflect")
console.log(attempt(() => { Object.defineProperty(Derived.prototype, "only", { value(this: Derived) { return "defined" + this.n }, writable: false, configurable: true }) }))
all("a method redefined")
console.log(attempt(() => { Object.defineProperty(Base.prototype, "size", { get(this: Base) { return -this.n }, configurable: true }) }), attempt(() => { b.size = 3 }))
all("a getter redefined")
console.log(attempt(() => { Object.defineProperty(Base.prototype, "size", { value: 7, writable: true, configurable: true }) }))
all("an accessor made a value")
b.who = () => "own"
d.who = function (this: Derived) { return "own" + this.n }
d.twice = () => "own twice"
all("own properties")
patch(d, "who", () => "mine")
console.log(attempt(() => { Object.defineProperty(b, "who", { value: () => "own defined", writable: true, enumerable: false, configurable: true }) }), attempt(() => { Object.defineProperty(b, "size", { value: 8, writable: true, enumerable: true, configurable: true }) }))
all("own properties, computed and defined")
console.log(delete (b as any).who, delete (d as any).who, delete (d as any).twice, delete (b as any).size)
all("own properties deleted")
Base.make = () => new Derived()
console.log(Base.make().who(), Derived.make().who(), Base.make() instanceof Derived)
const who = Object.getOwnPropertyDescriptor(Base.prototype, "who")!
console.log(who.writable, who.enumerable, who.configurable)
// A method that replaces itself: on the object, and on the prototype.
class Lazy {
  computed = 0
  value(): number { const v = ++this.computed * 100; this.value = () => v; return v }
  shared(): string { Lazy.prototype.shared = function (this: Lazy) { return "fast" + this.computed }; return "slow" + this.computed }
}
const lazy = new Lazy()
console.log(lazy.value(), lazy.value(), new Lazy().value(), lazy.shared(), lazy.shared(), new Lazy().shared(), lazy.computed, Object.keys(lazy).join())
//// required-field-hidden-through-untyped-code.ts
// A required field of a typed object is made not enumerable through an untyped function. The definition succeeds, and keys, loops, JSON, spreads and copies leave the field out as in plain Bun.
class Point {
  x = 1;
  y = 2;
  label?: string;
  sum(): number {
    return this.x + this.y;
  }
}
interface Row {
  id: number;
  name: string;
  note?: string;
}
function makeRow(id: number): Row {
  return { id, name: "row" + id };
}
function attempt(name: string, run: () => unknown): void {
  try {
    console.log(name + ":", run());
  } catch (error) {
    console.log(name + ":", "throws", (error as Error).name);
  }
}
function define(target: any, key: string, descriptor: PropertyDescriptor): void {
  Object.defineProperty(target, key, descriptor);
}
function describe(target: any, key: string): string {
  const found = Object.getOwnPropertyDescriptor(target, key);
  return found ? [found.value, found.writable, found.enumerable, found.configurable].join("|") : "none";
}
function keysByLoop(target: object): string {
  const keys: string[] = [];
  for (const key in target) keys.push(key);
  return keys.join();
}
function seen(target: Point | Row): string {
  return [
    Object.keys(target).join(),
    keysByLoop(target),
    JSON.stringify(target),
    Object.keys({ ...target }).join(),
    Object.keys(Object.assign({}, target)).join(),
    Object.entries(target).join(";"),
    Object.values(target).join(),
    Object.getOwnPropertyNames(target).join(),
    Reflect.ownKeys(target).join(),
  ].join(" / ");
}

attempt("a hidden field of a class", () => {
  const point = new Point();
  define(point, "x", { enumerable: false });
  return seen(point) + " / " + describe(point, "x") + " / " + point.sum() + " / " + Object.prototype.propertyIsEnumerable.call(point, "x") + " / " + ("x" in point);
});
attempt("a hidden field of a literal", () => {
  const row = makeRow(1);
  define(row, "name", { enumerable: false });
  return seen(row) + " / " + describe(row, "name") + " / " + row.name;
});
attempt("a hidden field is stored to", () => {
  const point = new Point();
  define(point, "y", { enumerable: false });
  point.y = 9;
  return seen(point) + " / " + describe(point, "y") + " / " + point.sum();
});
attempt("a hidden field is shown again", () => {
  const point = new Point();
  define(point, "x", { enumerable: false });
  define(point, "x", { enumerable: true });
  return seen(point) + " / " + describe(point, "x");
});
attempt("hidden and not configurable", () => {
  const point = new Point();
  define(point, "x", { enumerable: false, configurable: false });
  point.x = 3;
  return seen(point) + " / " + describe(point, "x") + " / " + point.sum();
});
attempt("a copy does not inherit the attributes", () => {
  const row = makeRow(6);
  define(row, "id", { enumerable: false, configurable: false });
  const copy = { ...row, id: row.id };
  return seen(copy) + " / " + describe(copy, "id") + " / " + structuredClone(row).name;
});
attempt("one object of many", () => {
  const points = [new Point(), new Point(), new Point()];
  define(points[1], "y", { enumerable: false });
  return points.map((point) => Object.keys(point).join("") + JSON.stringify(point) + point.sum()).join(" ");
});
attempt("in a loop that is hot", () => {
  const point = new Point();
  let total = 0;
  for (let i = 0; i < 2000; i++) {
    if (i === 1000) define(point, "x", { enumerable: false });
    total += Object.keys(point).length + point.x;
  }
  return total;
});
attempt("a copy by spread lacks the field", () => {
  const row = makeRow(10);
  define(row, "id", { enumerable: false });
  const copy: Row = { ...row };
  return seen(copy) + " / " + describe(copy, "id") + " / " + copy.id + " / " + copy.name;
});
