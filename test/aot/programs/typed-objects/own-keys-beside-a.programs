//// plain-literal-becomes-record-via-any.ts
// A plain object literal that something else also holds is handed, as `any`, to a place of a record type with optional fields that the literal does not give. It satisfies the type and stays the object it is: both holders go on seeing one object.
interface Host { a: number[]; b: string; o1?: number; o2?: number; o3?: number; o4?: number }
interface Pair { list: string[]; x?: number; y?: number; z?: number }
function show(h: Host): string { return h.a.length + h.b + (h.o4 ?? "-"); }
function fill(h: Host): void { h.o1 = 1.5; h.o4 = 4.5; }
function showPair(p: Pair): string { return p.list.join() + (p.z ?? "-"); }
function attempt(name: string, f: () => string): void { try { console.log(name, f()); } catch (e) { console.log(name, (e as Error).name + ": " + (e as Error).message.split("\n")[1]?.trim().slice(0, 110)); } }
const known: Host = { a: [1], b: "k", o1: 1.5, o2: 2.5, o3: 3.5, o4: 4.5 };
const knownPair: Pair = { list: ["l"], x: 0.5, y: 1.5, z: 2.5 };
console.log(show(known), showPair(knownPair));
const kept: any[] = [];
attempt("two names:", () => { const h: any = { a: [1, 2], b: "s" }; kept.push(h); return show(h); });
attempt("later stores are seen:", () => { const h: any = { a: [1, 2], b: "s" }; kept.push(h); const before = show(h); h.b = "t"; return before + " " + show(h); });
attempt("filled by typed code:", () => { const h: any = { a: [], b: "u" }; kept.push(h); fill(h); return show(h) + " " + Object.keys(h).join() + " " + h.o1; });
attempt("in another order:", () => { const h: any = { b: "v", a: [1, 2, 3] }; kept.push(h); return show(h) + " " + Object.keys(h).join(); });
attempt("with an optional one:", () => { const h: any = { a: [1], b: "w", o4: 9.5 }; kept.push(h); return show(h); });
attempt("one name:", () => { const p: any = { list: ["x", "y"] }; kept.push(p); return showPair(p); });
attempt("many:", () => { let out = 0; for (let i = 0; i < 1000; i++) { const h: any = { a: [i], b: "m" }; kept[0] = h; out += show(h).length; } return String(out); });
attempt("the same object:", () => { const h: any = { a: [1], b: "i" }; kept.push(h); const held: Host = h; return String((held as unknown) === kept[kept.length - 1]); });
//// plain-objects-built-and-read-in-one-function.ts
type Inner = { n: number };
type Message = { id: number; inner: Inner; tags: string[]; note?: string };
const makeInner = (n: number): Inner => ({ n });
const makeMessage = (id: number, inner: Inner, tags: string[]): Message => ({ id, inner, tags, note: "n" });
const read = (message: Message) => message.id + message.inner.n + message.tags.length + (message.note === undefined ? 100 : message.note.length);
const inner = makeInner(7);
const tags = ["x", "y"];
let kept: any;
let touched = 0;
const touch = () => {
  touched++;
  if (kept) kept.id = 1000 + touched;
};
const anything = (value: unknown): any => value;
////= say-4

console.log(read(makeMessage(1, inner, tags)));
say("built here", () => {
  const message: any = { id: 1 };
  message.inner = inner;
  message.tags = tags;
  message.note = "note";
  kept = message;
  return read(message);
});
console.log(Object.keys(kept).join(), kept.id, kept.note);
say("lacks the optional key", () => {
  const message: any = { id: 2, inner, tags };
  kept = message;
  return read(message);
});
console.log(Object.keys(kept).join(), "note" in kept);
say("stored twice", () => {
  const message: any = { id: 3, inner, tags };
  message.id = 30;
  kept = message;
  return read(message);
});
say("one key more", () => {
  const message: any = { id: 4, inner, tags, more: "more" };
  kept = message;
  return read(message);
});
console.log(Object.keys(kept).join(), kept.more);
say("changed by a call between", () => {
  const message: any = { id: 5, inner, tags };
  kept = message;
  touch();
  return read(message);
});
say("a value whose type is not known, which fits", () => {
  const message: any = { id: anything(6), inner, tags };
  kept = message;
  return read(message);
});
say("a value whose type is not known, which does not fit", () => {
  const message: any = { id: anything("six"), inner, tags };
  kept = message;
  return read(message);
});
say("a string for the number", () => {
  const message: any = { id: "seven", inner, tags };
  kept = message;
  return read(message);
});
say("a plain child", () => {
  const message: any = { id: 8, inner: { n: 80 }, tags };
  kept = message;
  return read(message);
});
say("another prototype by name", () => {
  const message: any = { id: 9, inner, tags };
  message.__proto__ = { note: "inherited" };
  kept = message;
  return read(message);
});
say("a getter laid over the number", () => {
  const message: any = { id: 10, inner, tags };
  Object.defineProperty(message, "id", { get: () => 11, enumerable: true, configurable: true });
  kept = message;
  return read(message);
});
say("deleted again", () => {
  const message: any = { id: 12, inner, tags, note: "gone" };
  delete message.note;
  kept = message;
  return read(message);
});
say("the number deleted", () => {
  const message: any = { id: 13, inner, tags };
  delete message.id;
  kept = message;
  return read(message);
});
say("frozen", () => {
  const message: any = { id: 14, inner, tags };
  Object.freeze(message);
  kept = message;
  return read(message) + (Object.isFrozen(message) ? 1000 : 0);
});
say("built in one arm only", () => {
  const message: any = { id: 15, inner };
  if (touched & 1) message.tags = tags;
  else message.tags = ["z"];
  touched++;
  kept = message;
  return read(message);
});
say("read twice", () => {
  const message: any = { id: 16, inner, tags };
  kept = message;
  return read(message) + read(message);
});
say("stored to after the read", () => {
  const message: any = { id: 17, inner, tags };
  kept = message;
  const first = read(message);
  message.id = 170;
  return first + read(message);
});
console.log(touched, typeof kept.id);
//// plain-objects-built-here-that-hold-objects-which-stay-as-they-are.ts
type Inner = { n: number };
type Message = { id: number; inner: Inner; tags: string[] };
const makeInner = (n: number): Inner => ({ n });
const makeMessage = (id: number, inner: Inner, tags: string[]): Message => ({ id, inner, tags });
const read = (message: Message) => message.id + message.inner.n + message.tags.length;
const tags = ["x", "y"];
const anything = (value: unknown): any => value;
let asked = 0;
const withGetter: Inner = anything(Object.defineProperty({}, "n", { get() { asked++; return 5; }, enumerable: true }));
const inheriting: Inner = anything(Object.create({ n: 6 }));
const frozen: Inner = anything(Object.freeze({ n: 7 }));
const typed = makeInner(8);
let kept: any;
console.log(read(makeMessage(1, typed, tags)));
for (const [label, inner] of [["a getter", withGetter], ["inherits", inheriting], ["frozen", frozen], ["typed", typed]] as [string, Inner][]) {
  for (let i = 0; i < 3; i++) {
    const message: any = { id: i, inner, tags };
    kept = message;
    console.log(label, i, read(message), asked, Object.keys(kept).join(), kept.inner === inner);
  }
}
const nothing: Inner = anything(null);
for (let i = 0; i < 2; i++) {
  try {
    const message: any = { id: i, inner: nothing, tags };
    kept = message;
    console.log("null", i, read(message));
  } catch (error) {
    console.log("null", i, error instanceof TypeError ? "TypeError" : String(error));
  }
}
//// plain-objects-that-a-typed-function-only-reads.ts
type Inner = { n: number };
type Message = { id: number; inner: Inner; tags: string[]; title: string; done: boolean; note?: string };
const makeInner = (n: number): Inner => ({ n });
const makeMessage = (id: number, inner: Inner, tags: string[]): Message => ({ id, inner, tags, title: "typed", done: false, note: "n" });
const grow = (id: unknown, inner: unknown, tags: unknown, title: unknown, done: unknown, note: unknown): any => {
  const message: any = { id };
  message.inner = inner;
  message.tags = tags;
  message.title = title;
  message.done = done;
  message.note = note;
  return message;
};
const growInAnotherOrder = (id: unknown, inner: unknown, tags: unknown): any => {
  const message: any = { note: "last first" };
  message.done = true;
  message.title = "other order";
  message.tags = tags;
  message.inner = inner;
  message.id = id;
  return message;
};
const read = (message: Message) => message.id + message.inner.n + message.tags.length + message.title.length + (message.done ? 1 : 0) + (message.note === undefined ? 100 : message.note.length);
const inner = makeInner(7);
const tags = ["x", "y"];
const kept: unknown[] = [];
const attempt = (label: string, make: () => any) => {
  for (let i = 0; i < 4; i++) {
    try {
      const message = make();
      kept.push(message);
      console.log(label, i, read(message));
    } catch (error) {
      console.log(label, i, error instanceof TypeError ? "TypeError" : String(error));
    }
  }
};

console.log(read(makeMessage(1, inner, tags)));
attempt("fits", () => grow(1, inner, tags, "grown", true, "note"));
attempt("a fraction", () => grow(1.5, inner, tags, "grown", false, "note"));
attempt("another order", () => growInAnotherOrder(2, inner, tags));
attempt("note undefined", () => grow(1, inner, tags, "grown", true, undefined));
attempt("id is a string", () => grow("one", inner, tags, "grown", true, "note"));
attempt("inner is a number", () => grow(1, 5, tags, "grown", true, "note"));
attempt("inner is plain", () => grow(1, { n: 9 }, tags, "grown", true, "note"));
attempt("inner is plain and wrong", () => grow(1, { n: "nine" }, tags, "grown", true, "note"));
attempt("tags is a string", () => grow(1, inner, "xy", "grown", true, "note"));
attempt("title is a number", () => grow(1, inner, tags, 5, true, "note"));
attempt("done is a number", () => grow(1, inner, tags, "grown", 1, "note"));
attempt("note is a number, which nothing reads as one", () => grow(1, inner, tags, "grown", true, 5));
attempt("fits again", () => grow(3, inner, tags, "grown", true, "note"));

let turn = 0;
attempt("fits and does not, in turn", () => grow(turn++ & 1 ? "odd" : 4, inner, tags, "grown", true, "note"));

const same = grow(5, inner, tags, "same", false, "note");
for (let i = 0; i < 4; i++) {
  console.log("the same object", i, read(same));
  same.id++;
}
console.log(Object.keys(same).join(), JSON.stringify(same));

const withGetter = grow(6, inner, tags, "getter", true, "note");
let asked = 0;
Object.defineProperty(withGetter, "id", { get() { asked++; return 6; }, enumerable: true, configurable: true });
for (let i = 0; i < 3; i++) console.log("a getter", i, read(withGetter), asked);

const frozen = Object.freeze(grow(7, inner, tags, "frozen", true, "note"));
for (let i = 0; i < 3; i++) console.log("frozen", i, read(frozen), Object.isFrozen(frozen));

const inherits = Object.create(grow(8, inner, tags, "inherited", true, "note"));
for (let i = 0; i < 3; i++) console.log("inherits everything", i, read(inherits), Object.keys(inherits).length);

const surplus = () => {
  const message = grow(9, inner, tags, "surplus", true, "note");
  message.more = "more";
  return message;
};
attempt("one key more", surplus);
const last = surplus();
console.log(read(last), last.more, Object.keys(last).join());

const lacking = (): any => {
  const message: any = { id: 10 };
  message.inner = inner;
  message.tags = tags;
  message.title = "lacks note";
  message.done = true;
  return message;
};
attempt("lacks the optional key", lacking);
const holder = { note: "from the prototype" };
attempt("lacks the optional key, which its prototype has", () => Object.assign(Object.create(holder), lacking()));
attempt("lacks the optional key again", lacking);

let old: any[] = [];
for (let i = 0; i < 20; i++) old.push(grow(i, inner, tags, "old", true, "note"));
let garbage: unknown[] = [];
for (let i = 0; i < 200000; i++) garbage = [garbage.length, i];
let sum = 0;
for (let round = 0; round < 3; round++) for (const message of old) sum += read(message);
console.log(sum, kept.length, garbage.length);
for (const message of kept as any[]) sum += typeof message.id === "number" ? message.id : 0;
console.log(sum);
//// plain-objects-that-go-on-into-calls.ts
type Inner = { n: number };
type Message = { id: number; inner: Inner; tags: string[] };
type Loose = { count: number; label: string; flag: boolean; extra: any; thing: object | null; note?: string };
type Outer = { first: Message; second: Inner | null; weight: number };
type Chain = { value: number; next: Chain | null };
type Left = { peer: Right | null; size: number };
type Right = { peer: Left | null; size: number };

const makeInner = (n: number): Inner => ({ n });
const makeMessage = (id: number, inner: Inner, tags: string[]): Message => ({ id, inner, tags });
const makeLoose = (count: number): Loose => ({ count, label: "made", flag: true, extra: 1, thing: null });
const makeOuter = (weight: number): Outer => ({ first: makeMessage(1, makeInner(2), []), second: null, weight });
const makeChain = (value: number): Chain => ({ value, next: null });
const makeLeft = (size: number): Left => ({ peer: null, size });
const makeRight = (size: number): Right => ({ peer: null, size });

let depth = 0;
function readMessage(message: Message): number {
  if (depth > 0) { depth--; return readMessage(message) + readMessage(message); }
  return message.id + message.inner.n + message.tags.length;
}
function readLoose(loose: Loose): string {
  if (depth > 0) { depth--; return readLoose(loose) + readLoose(loose); }
  return [loose.count, loose.label, loose.flag, typeof loose.extra, loose.thing === null ? "null" : typeof loose.thing, loose.note].join();
}
function readOuter(outer: Outer): number {
  if (depth > 0) { depth--; return readOuter(outer) + readOuter(outer); }
  return readMessage(outer.first) + (outer.second === null ? 0 : outer.second.n) + outer.weight;
}
function readChain(chain: Chain): number {
  let sum = 0;
  for (let at: Chain | null = chain, steps = 0; at !== null && steps < 5; at = at.next, steps++) sum += at.value;
  return sum;
}
function readLeft(left: Left): number {
  if (depth > 0) { depth--; return readLeft(left) + readLeft(left); }
  return left.size + (left.peer === null ? 0 : left.peer.size);
}
function readRight(right: Right): number {
  if (depth > 0) { depth--; return readRight(right) + readRight(right); }
  return right.size * 2 + (right.peer === null ? 0 : right.peer.size);
}

////= lines-7	readMessageInLoop	number	0	readMessage	Message
////= lines-7	readLooseInLoop	string	""	readLoose	Loose
////= lines-7	readOuterInLoop	number	0	readOuter	Outer
////= lines-7	readChainInLoop	number	0	readChain	Chain
////= lines-7	readLeftInLoop	number	0	readLeft	Left
////= lines-7	readRightInLoop	number	0	readRight	Right
const plain = (...pairs: any[]): any => {
  const made = JSON.parse("{}");
  for (let i = 0; i < pairs.length; i += 2) made[pairs[i]] = pairs[i + 1];
  return made;
};
////= show
const describe = (value: any) => Object.keys(value).join() + " " + JSON.stringify(value);

console.log(readMessageInLoop(makeMessage(1, makeInner(2), ["a"])), readLooseInLoop(makeLoose(1)), readOuterInLoop(makeOuter(1)), readChainInLoop(makeChain(1)), readLeftInLoop(makeLeft(1)), readRightInLoop(makeRight(1)));

const typedInner = makeInner(7);
const tags = ["x", "y"];
const kept: any[] = [];
for (let turn = 0; turn < 4; turn++) {
  const inOrder = plain("id", turn, "inner", typedInner, "tags", tags);
  const otherOrder = plain("tags", tags, "id", turn + 0.5, "inner", typedInner);
  const parsed = JSON.parse(`{"id":${turn},"inner":null,"tags":["p"]}`);
  parsed.inner = typedInner;
  const withPlainChild = plain("id", turn, "inner", plain("n", turn), "tags", tags);
  const withMore = plain("id", turn, "inner", typedInner, "tags", tags, "more", "m");
  const wholly = JSON.parse(`{"id":${turn},"inner":{"n":${turn}},"tags":["a","b","c"]}`);
  for (const [label, message] of [["in order", inOrder], ["other order", otherOrder], ["parsed", parsed], ["plain child", withPlainChild], ["more keys", withMore], ["wholly parsed", wholly]] as [string, any][]) {
    kept.push(message);
    const child = message.inner;
    show(label, () => readMessageInLoop(message));
    show(label + " again", () => readMessageInLoop(message));
    show(label + " is itself", () => kept[kept.length - 1] === message && message.inner === child && describe(message));
    message.late = turn;
    message.id = -turn;
    show(label + " after stores", () => readMessageInLoop(message) + " " + describe(message));
    delete message.late;
    show(label + " after a delete", () => readMessageInLoop(message) + " " + describe(message));
  }
  for (const id of [0, -0, 1.5, NaN, Infinity, 2147483647, 2147483648, -2147483648, -1073741825, 1e300]) {
    const message = plain("id", id, "inner", typedInner, "tags", tags);
    show("id " + id, () => Object.is(message.id, id) && readMessageInLoop(message) + " " + Object.is(message.id, id));
  }
  const things: [string, any, any][] = [
    ["numbers", 1, null],
    ["plain objects", plain("a", 1), plain("b", 2)],
    ["typed objects", typedInner, makeMessage(1, typedInner, tags)],
    ["an array and a function", [1], () => 1],
    ["a date and a map", new Date(0), new Map()],
    ["an error and a promise", new Error("e"), Promise.resolve(1)],
    ["a string and a regular expression", "s", /r/],
    ["undefined and a symbol's wrapper", undefined, Object(Symbol.iterator)],
    ["a big integer and a typed array", 1n, new Uint8Array(1)],
  ];
  for (const [label, extra, thing] of things) {
    const loose = plain("count", turn, "label", "l", "flag", turn % 2 === 0, "extra", extra, "thing", thing);
    show(label, () => readLooseInLoop(loose) + " " + (loose.extra === extra) + " " + (loose.thing === thing) + " " + Object.keys(loose).join());
    const noted = plain("count", turn, "label", "l", "flag", false, "extra", extra, "thing", thing, "note", "n");
    show(label + " with a note", () => readLooseInLoop(noted) + " " + (noted.extra === extra) + " " + Object.keys(noted).join());
  }
  const outer = plain("first", plain("id", 1, "inner", plain("n", 2), "tags", ["t"]), "second", plain("n", 3), "weight", turn);
  show("three levels", () => readOuterInLoop(outer) + " " + describe(outer));
  show("three levels again", () => readOuterInLoop(outer));
  const halfTyped = plain("first", makeMessage(1, typedInner, tags), "second", null, "weight", turn);
  show("typed children", () => readOuterInLoop(halfTyped) + " " + describe(halfTyped));
  const spoiled = plain("first", plain("id", 1, "inner", plain("n", 2), "tags", ["t"]), "second", plain("n", 3), "weight", "heavy");
  show("good children of a wrong parent", () => readOuterInLoop(spoiled));
  show("and what is left of them", () => describe(spoiled) + " " + readMessageInLoop(spoiled.first));
  const chain = plain("value", 1, "next", plain("value", 2, "next", plain("value", 3, "next", plain("value", 4, "next", plain("value", 5, "next", plain("value", 6, "next", null))))));
  show("a chain", () => readChainInLoop(chain) + " " + describe(chain));
  const ring = plain("value", 1, "next", null);
  ring.next = ring;
  show("a ring", () => readChainInLoop(ring) + " " + (ring.next === ring));
  const longRing = plain("value", 1, "next", plain("value", 2, "next", null));
  longRing.next.next = longRing;
  show("a ring of two", () => readChainInLoop(longRing) + " " + (longRing.next.next === longRing));
  const pair = plain("peer", null, "size", 1);
  pair.peer = pair;
  show("its own peer, as the left", () => readLeftInLoop(pair) + " " + (pair.peer === pair));
  show("its own peer, as the right", () => readRightInLoop(pair) + " " + (pair.peer === pair));
  const one = plain("peer", null, "size", 1);
  const two = plain("peer", one, "size", 2);
  one.peer = two;
  show("two peers", () => readLeftInLoop(one) + " " + readRightInLoop(two) + " " + (one.peer === two) + " " + (two.peer === one));
  let asked = 0;
  const withGetter = plain("inner", typedInner, "tags", tags);
  Object.defineProperty(withGetter, "id", { get: () => { asked++; return 5; }, enumerable: true, configurable: true });
  show("a getter", () => readMessageInLoop(withGetter) + " " + asked);
  const readOnly = plain("id", 1, "inner", typedInner, "tags", tags);
  Object.defineProperty(readOnly, "id", { writable: false });
  show("a field that may not be written", () => readMessageInLoop(readOnly) + " " + Object.getOwnPropertyDescriptor(readOnly, "id")!.writable);
  const hidden = plain("id", 1, "inner", typedInner, "tags", tags);
  Object.defineProperty(hidden, "tags", { enumerable: false });
  show("a field that is not listed", () => readMessageInLoop(hidden) + " " + Object.keys(hidden).join());
  show("inherits", () => readMessageInLoop(Object.create(plain("id", 1, "inner", typedInner, "tags", tags))));
  show("frozen", () => readMessageInLoop(Object.freeze(plain("id", 1, "inner", typedInner, "tags", tags))));
  show("sealed", () => readMessageInLoop(Object.seal(plain("id", 1, "inner", typedInner, "tags", tags))));
  show("not extensible", () => readMessageInLoop(Object.preventExtensions(plain("id", 1, "inner", typedInner, "tags", tags))));
  show("another prototype", () => readMessageInLoop(Object.setPrototypeOf(plain("id", 1, "inner", typedInner, "tags", tags), plain("more", 1))));
  show("no prototype", () => readMessageInLoop(Object.assign(Object.create(null), plain("id", 1, "inner", typedInner, "tags", tags))));
  show("indexed too", () => readMessageInLoop(plain("id", 1, "inner", typedInner, "tags", tags, 0, "zero")));
  show("many keys", () => readMessageInLoop(plain("a", 1, "b", 2, "c", 3, "d", 4, "e", 5, "f", 6, "g", 7, "id", 1, "inner", typedInner, "tags", tags)));
  const shrunk = plain("gone", 1, "id", 1, "inner", typedInner, "tags", tags);
  delete shrunk.gone;
  show("after a delete", () => readMessageInLoop(shrunk) + " " + describe(shrunk));
  show("a string for the number", () => readMessageInLoop(plain("id", "1", "inner", typedInner, "tags", tags)));
  show("a number for the record", () => readMessageInLoop(plain("id", 1, "inner", 2, "tags", tags)));
  show("an object for the array", () => readMessageInLoop(plain("id", 1, "inner", typedInner, "tags", plain())));
  show("a wrong child", () => readMessageInLoop(plain("id", 1, "inner", plain("n", "n"), "tags", tags)));
  show("a missing key", () => readMessageInLoop(plain("id", 1, "inner", typedInner)));
  show("null", () => readMessageInLoop(plain("it", null).it));
  show("a number", () => readMessageInLoop(plain("it", 1).it));
  show("an array", () => readMessageInLoop(plain("it", [1]).it));
  if (turn === 1 && typeof Bun !== "undefined") Bun.gc(true);
  show("kept", () => kept.map(message => readMessageInLoop(message)).join());
}
//// plain-objects-that-hold-plain-objects-built-and-read-in-one-function.ts
type Leaf = { v: number };
type Inner = { n: number; next: Inner | null; leaf?: Leaf };
type Message = { id: number; inner: Inner; tags: string[] };
const makeInner = (n: number): Inner => ({ n, next: null, leaf: { v: 1 } });
const makeMessage = (id: number, inner: Inner, tags: string[]): Message => ({ id, inner, tags });
const read = (message: Message) => message.id + message.inner.n + message.tags.length;
const readDeep = (message: Message) => message.id + message.inner.n + (message.inner.leaf === undefined ? 50 : message.inner.leaf.v);
const readNext = (message: Message) => message.id + (message.inner.next === null ? 7 : message.inner.next.n);
const tags = ["x", "y"];
let kept: any;
const anything = (value: unknown): any => value;
////= say-4

console.log(read(makeMessage(1, makeInner(7), tags)), readDeep(makeMessage(1, makeInner(7), tags)), readNext(makeMessage(1, makeInner(7), tags)));
say("a child built here", () => {
  const inner: any = { n: 10, next: null };
  const message: any = { id: 1, inner, tags };
  kept = message;
  return read(message);
});
console.log(Object.keys(kept).join(), Object.keys(kept.inner).join(), kept.inner.n);
////= say-5	"a child written in the literal"	2	20	read
say("the child is stored to after it was laid into the parent", () => {
  const inner: any = { n: 30, next: null };
  const message: any = { id: 3, inner, tags };
  inner.n = 31;
  kept = message;
  return read(message);
});
////= say-5	"the child does not fit"	4	"forty"	read
say("the child holds a value whose type is not known", () => {
  const message: any = { id: 5, inner: { n: anything(50), next: null }, tags };
  kept = message;
  return read(message);
});
say("the child lacks a key", () => {
  const message: any = { id: 6, inner: { n: 60 }, tags };
  kept = message;
  return read(message);
});
say("a grandchild", () => {
  const message: any = { id: 7, inner: { n: 70, next: null, leaf: { v: 700 } }, tags };
  kept = message;
  return readDeep(message);
});
////= say-5	"no grandchild"	8	80	readDeep
say("a grandchild that does not fit", () => {
  const message: any = { id: 9, inner: { n: 90, next: null, leaf: { v: "nine" } }, tags };
  kept = message;
  return readDeep(message);
});
say("a chain of two", () => {
  const message: any = { id: 10, inner: { n: 100, next: { n: 101, next: null } }, tags };
  kept = message;
  return readNext(message);
});
say("a child that refers to itself", () => {
  const inner: any = { n: 110, next: null };
  inner.next = inner;
  const message: any = { id: 11, inner, tags };
  kept = message;
  return readNext(message);
});
say("one child in two parents", () => {
  const inner: any = { n: 120, next: null };
  const first: any = { id: 12, inner, tags };
  const second: any = { id: 13, inner, tags };
  kept = [first, second];
  return read(first) + read(second);
});
say("the child is kept and changed by a call between", () => {
  const inner: any = { n: 130, next: null };
  kept = inner;
  const message: any = { id: 14, inner, tags };
  (() => { if (tags.length) kept.n++; })();
  return read(message);
});
say("the child is frozen", () => {
  const inner: any = Object.freeze({ n: 140, next: null });
  const message: any = { id: 15, inner, tags };
  kept = message;
  return read(message) + (Object.isFrozen(message.inner) ? 1000 : 0);
});
console.log(typeof kept);
//// plain-objects-that-hold-plain-objects-enter-typed-code.ts
// Plain objects that untyped code made, holding further plain objects, enter typed functions, typed variables and typed arrays: every one keeps its identity, its keys and its values, however deep, shared or cyclic the graph is.
type Leaf = { n: number; label: string };
type Branch = { id: number; leaf: Leaf; other: Leaf | null; more?: Leaf };
type Chain = { depth: number; next: Chain | null };
type Ring = { name: string; partner: Ring | null; leaf: Leaf };
type Circle = { kind: "circle"; radius: number };
type Square = { kind: "square"; side: number };
type Drawing = { title: string; shape: Circle | Square; spare: Circle | Square | null };
type Basket = { owner: string; items: Leaf[]; nested: Branch[] };

const lines: string[] = [];
const say = (label: string, ...values: unknown[]) => lines.push(label + ": " + values.map(value => JSON.stringify(value) ?? "undefined").join(" "));
const outside = (text: string): any => JSON.parse(text);
const grown = (pairs: [string, unknown][]): any => {
  const object: any = {};
  for (const [key, value] of pairs) object[key] = value;
  return object;
};
const leafOf = (n: number): any => {
  const leaf: any = { n };
  leaf.label = "leaf" + n;
  return leaf;
};
const branchOf = (id: number, leaf: unknown, other: unknown): any => {
  const branch: any = { id };
  branch.leaf = leaf;
  branch.other = other;
  return branch;
};

function sumBranch(branch: Branch): number {
  return branch.id + branch.leaf.n + (branch.other === null ? 0 : branch.other.n) + (branch.more === undefined ? 0 : branch.more.n) + branch.leaf.label.length;
}
function lengthOf(chain: Chain): number {
  let length = 0;
  for (let at: Chain | null = chain; at !== null && length < 40; at = at.next) length += 1 + at.depth * 0;
  return length;
}
function ringText(ring: Ring): string {
  return ring.name + ">" + (ring.partner === null ? "nobody" : ring.partner.name) + ":" + ring.leaf.label;
}
function area(shape: Circle | Square): number {
  return shape.kind === "circle" ? shape.radius * shape.radius * 3 : shape.side * shape.side;
}
function describeDrawing(drawing: Drawing): string {
  return drawing.title + "=" + area(drawing.shape) + "/" + (drawing.spare === null ? "none" : area(drawing.spare));
}
function totalOf(basket: Basket): number {
  let total = basket.owner.length;
  for (let i = 0; i < basket.items.length; i++) total += basket.items[i].n;
  for (let i = 0; i < basket.nested.length; i++) total += sumBranch(basket.nested[i]);
  return total;
}

for (let round = 0; round < 6; round++) {
  const leaf = leafOf(round);
  const other = round % 2 ? leafOf(round + 10) : null;
  const branch = branchOf(round, leaf, other);
  const sum = sumBranch(branch);
  say("branch " + round, sum, branch.leaf === leaf, branch.other === other, Object.keys(branch), Object.keys(leaf), branch);
  leaf.n = 100;
  say("after a store from outside " + round, sumBranch(branch), leaf.n);
  (branch as Branch).leaf.n = 7;
  say("after a typed store " + round, leaf.n, sumBranch(branch));
}

for (let round = 0; round < 4; round++) {
  const shared = leafOf(round);
  const first = branchOf(1, shared, shared);
  const second = branchOf(2, shared, null);
  say("a shared leaf " + round, sumBranch(first), sumBranch(second), first.leaf === second.leaf, first.leaf === first.other);
  const withMore = branchOf(3, leafOf(1), null);
  withMore.more = round % 2 ? shared : leafOf(50);
  say("an optional leaf " + round, sumBranch(withMore), Object.keys(withMore));
}

for (const depth of [1, 2, 3, 4, 5, 6, 7, 12]) {
  for (let round = 0; round < 3; round++) {
    let chain: any = null;
    const all: any[] = [];
    for (let i = 0; i < depth; i++) {
      const link: any = { depth: i };
      link.next = chain;
      chain = link;
      all.push(link);
    }
    const length = lengthOf(chain);
    let same = true;
    for (let at = chain, i = depth - 1; at !== null; at = at.next, i--) same = same && at === all[i];
    if (round === 2) say("a chain of " + depth, length, same, JSON.stringify(chain).length);
  }
}

for (let round = 0; round < 4; round++) {
  const alone: any = { name: "alone" };
  alone.partner = alone;
  alone.leaf = leafOf(1);
  say("its own partner " + round, ringText(alone), alone.partner === alone, alone.partner.partner.leaf === alone.leaf);
  const left: any = { name: "left" };
  const right: any = { name: "right" };
  left.partner = right;
  left.leaf = leafOf(2);
  right.partner = left;
  right.leaf = left.leaf;
  say("two partners " + round, ringText(left), ringText(right), left.partner.partner === left, right.leaf === left.leaf);
}

for (let round = 0; round < 6; round++) {
  const shape = round % 2 ? grown([["kind", "circle"], ["radius", round]]) : grown([["kind", "square"], ["side", round]]);
  const spare = round % 3 === 0 ? null : round % 3 === 1 ? grown([["kind", "square"], ["side", 2]]) : shape;
  const drawing = grown([["title", "drawing" + round], ["shape", shape], ["spare", spare]]);
  say("a drawing " + round, describeDrawing(drawing), drawing.shape === shape, drawing.spare === spare, drawing);
}

for (let round = 0; round < 4; round++) {
  const basket = outside(`{"owner":"somebody","items":[{"n":1,"label":"a"},{"n":2,"label":"b"},{"n":${round},"label":"c"}],"nested":[{"id":1,"leaf":{"n":5,"label":"x"},"other":null},{"id":2,"leaf":{"n":6,"label":"y"},"other":{"n":7,"label":"z"}}]}`);
  const items = basket.items;
  const first = items[0];
  const deep = basket.nested[1].other;
  say("a parsed basket " + round, totalOf(basket), basket.items === items, items[0] === first, basket.nested[1].other === deep, basket);
  items.push(leafOf(40));
  items[1] = leafOf(41);
  say("the basket after stores from outside " + round, totalOf(basket), items.length);
}

for (let round = 0; round < 4; round++) {
  const surplus = leafOf(round);
  surplus.surplus = "kept";
  const frozen = Object.freeze(leafOf(round + 1));
  const computed: any = { n: round };
  Object.defineProperty(computed, "label", { get: () => "computed", enumerable: true, configurable: true });
  const inherits = Object.assign(Object.create({ inherited: true }), { n: round, label: "heir" });
  say("a leaf with a key more " + round, sumBranch(branchOf(1, surplus, null)), Object.keys(surplus), surplus.surplus);
  say("a frozen leaf " + round, sumBranch(branchOf(1, frozen, frozen)), Object.isFrozen(frozen));
  say("a computed label " + round, sumBranch(branchOf(1, computed, null)), Object.getOwnPropertyDescriptor(computed, "label")!.get !== undefined);
  say("a leaf with a prototype " + round, sumBranch(branchOf(1, inherits, null)), inherits.inherited, Object.getPrototypeOf(inherits).inherited);
  const fraction = leafOf(0);
  fraction.n = round + 0.5;
  say("a fraction " + round, sumBranch(branchOf(1, fraction, null)), fraction.n);
}

const typedLeaf: Leaf = { n: 3, label: "typed" };
for (let round = 0; round < 4; round++) {
  const mixed = branchOf(round, typedLeaf, leafOf(round));
  say("a typed and a plain leaf " + round, sumBranch(mixed), mixed.leaf === typedLeaf);
  const list: any[] = [typedLeaf, leafOf(1), typedLeaf, leafOf(2)];
  say("a mixed array " + round, totalOf(grown([["owner", "x"], ["items", list], ["nested", []]])), list[0] === typedLeaf, list.length);
}
console.log(lines.join("\n"));
//// plain-objects-that-refer-to-themselves-enter-typed-code.ts
// Plain objects that untyped code made and that refer to themselves, directly or through another, enter typed functions again and again.
type Ring = { name: string; partner: Ring | null };
type Pair = { id: number; first: Ring; second: Ring | null };

function ringText(ring: Ring): string {
  return ring.name + ">" + (ring.partner === null ? "nobody" : ring.partner.name);
}
function pairText(pair: Pair): string {
  return pair.id + ":" + ringText(pair.first) + "," + (pair.second === null ? "none" : ringText(pair.second));
}
const ringOf = (name: string): any => {
  const ring: any = { name };
  ring.partner = null;
  return ring;
};
const pairOf = (id: number, first: unknown, second: unknown): any => {
  const pair: any = { id };
  pair.first = first;
  pair.second = second;
  return pair;
};

for (let round = 0; round < 5; round++) {
  const alone = ringOf("alone");
  alone.partner = alone;
  console.log("its own partner", round, ringText(alone), alone.partner === alone, alone.partner.partner.partner === alone);

  const left = ringOf("left");
  const right = ringOf("right");
  left.partner = right;
  right.partner = left;
  console.log("two partners", round, ringText(left), ringText(right), left.partner.partner === left, right.partner === left);

  const one = ringOf("one");
  const two = ringOf("two");
  const three = ringOf("three");
  one.partner = two;
  two.partner = three;
  three.partner = one;
  console.log("three in a ring", round, ringText(two), ringText(one), ringText(three), one.partner.partner.partner === one);

  const shared = ringOf("shared");
  const pair = pairOf(round, shared, shared);
  console.log("one ring held twice", round, pairText(pair), pair.first === pair.second, pair.first === shared);

  const tail = ringOf("tail");
  const head = ringOf("head");
  head.partner = tail;
  console.log("a ring and what it points to", round, pairText(pairOf(round, head, tail)), head.partner === tail);

  const looped = ringOf("looped");
  looped.partner = looped;
  console.log("a pair of one that refers to itself", round, pairText(pairOf(round, looped, looped)), pairText(pairOf(round, ringOf("fresh"), looped)));
}
//// plain-objects-with-literal-fields-built-and-read-in-one-function.ts
// Plain objects with a field written as a union of string literals are built and read in one function. Any string is taken and read back, a constant or not, of the union or outside it: a literal type promises the kind. A number in that field throws a TypeError at the typed read.
type Author = { login: string };
type Hit = { id: number; state: "open" | "closed"; author: Author };
const makeAuthor = (login: string): Author => ({ login });
const makeHit = (id: number, author: Author): Hit => ({ id, state: "open", author });
const read = (hit: Hit) => hit.id + (hit.state === "closed" ? 1 : 2) + hit.state.length + hit.author.login.length;
const author = makeAuthor("u");
let kept: any;
let turn = 0;
const anything = (value: unknown): any => value;
const say = (label: string, run: () => number) => {
  for (let i = 0; i < 4; i++) {
    try {
      console.log(label, i, run());
    } catch (error) {
      console.log(label, i, error instanceof TypeError ? "TypeError" : String(error));
    }
  }
};

console.log(read(makeHit(1, author)));
////= say-6	"a constant of the union"	1	"closed"
console.log(kept.state, Object.keys(kept).join());
say("one of two constants", () => {
  const hit: any = { id: 2, state: turn++ & 1 ? "open" : "closed", author };
  kept = hit;
  return read(hit);
});
say("one of two constants, nothing else holds it", () => {
  const hit: any = { id: 3, state: turn++ & 1 ? "open" : "closed", author };
  return read(hit);
});
////= say-6	"a constant outside the union"	4	"merged"
say("one of two constants, one outside the union", () => {
  const hit: any = { id: 5, state: turn++ & 1 ? "open" : "merged", author };
  kept = hit;
  return read(hit);
});
say("a string that is not a constant, which fits", () => {
  const hit: any = { id: 6, state: anything("clo" + "sed".slice(turn & 0)), author };
  kept = hit;
  return read(hit);
});
say("a string that is not a constant, which does not fit", () => {
  const hit: any = { id: 7, state: anything("mer" + "ged".slice(turn & 0)), author };
  kept = hit;
  return read(hit);
});
////= say-6	"a number"	8	1
say("lacks it", () => {
  const hit: any = { id: 9, author };
  kept = hit;
  return read(hit);
});
say("stored twice, the second outside the union", () => {
  const hit: any = { id: 10, state: "open", author };
  hit.state = "merged";
  kept = hit;
  return read(hit);
});
say("stored twice, the second inside the union", () => {
  const hit: any = { id: 11, state: "merged", author };
  hit.state = "open";
  kept = hit;
  return read(hit);
});
console.log(turn, kept.state);
//// plain-objects-with-more-keys-than-the-type-enter-typed-code.ts
// Plain objects that have more keys than the record type declares enter typed functions: the further keys stay, in their order, with their values; young and old objects, alone and inside others.
type Inner = { n: number };
type Message = { id: number; inner: Inner; tags: string[] };
type Envelope = { to: string; message: Message; copy: Message | null };

const lines: string[] = [];
const say = (label: string, ...values: unknown[]) => lines.push(label + ": " + values.map(value => JSON.stringify(value) ?? "undefined").join(" "));
const collect: () => void = (globalThis as any).gc ?? (() => (globalThis as any).Bun.gc(true));
function read(message: Message): number {
  return message.id + message.inner.n + message.tags.length;
}
function open(envelope: Envelope): number {
  return envelope.to.length + read(envelope.message) + (envelope.copy === null ? 0 : read(envelope.copy));
}
const inner: Inner = { n: 7 };
const tags = ["x", "y"];
const grow = (id: number, more: [string, unknown][], first = false): any => {
  const message: any = first ? { early: "early" } : {};
  message.id = id;
  message.inner = inner;
  message.tags = tags;
  for (const [key, value] of more) message[key] = value;
  return message;
};

for (let round = 0; round < 5; round++) {
  const one = grow(round, [["surplus", round]]);
  say("one key more " + round, read(one), Object.keys(one), one.surplus, one);
  one.surplus = "stored";
  one.later = true;
  say("stores from outside " + round, read(one), Object.keys(one), one.surplus, one.later);
  delete one.surplus;
  say("deleted " + round, read(one), Object.keys(one), "surplus" in one);

  const two = grow(round, [["a", { deep: round }], ["b", [round]]]);
  const held = two.a;
  say("two keys more " + round, read(two), Object.keys(two), two.a === held, two.b);

  const five = grow(round, [["a", 1], ["b", "two"], ["c", null], ["d", undefined], ["e", 5.5]]);
  say("five keys more " + round, read(five), Object.keys(five), five);

  const many = grow(round, Array.from({ length: 12 }, (_, i): [string, unknown] => ["k" + i, i]));
  say("twelve keys more " + round, read(many), Object.keys(many).length, many.k11);

  const early = grow(round, [["late", "late"]], true);
  say("a further key ahead of the declared ones " + round, read(early), Object.keys(early), early.early, early.late);

  const inside: any = { to: "somebody" };
  inside.message = grow(round, [["surplus", "inside"]]);
  inside.copy = round % 2 ? grow(round + 1, [["surplus", "copy"], ["second", 2]]) : null;
  inside.stamp = "stamp" + round;
  const message = inside.message;
  say("inside another " + round, open(inside), inside.message === message, Object.keys(inside), Object.keys(message), inside);
}

const old: any[] = [];
for (let i = 0; i < 40; i++) old.push(grow(i, [["surplus", "kept" + i]]));
collect();
collect();
let sum = 0;
for (const message of old) sum += read(message);
collect();
say("old objects", sum, old.every((message, i) => message.surplus === "kept" + i), Object.keys(old[39]));
const fresh: any[] = [];
for (let i = 0; i < 2000; i++) {
  const message = grow(i, [["surplus", { i }]]);
  sum += read(message);
  if (i % 100 === 0) fresh.push(message);
}
collect();
say("many young objects", sum, fresh.map(message => message.surplus.i));
console.log(lines.join("\n"));
//// polymorphic-method-call-wrong-receiver.ts
// A method call through an interface or a base class with several possible targets, on a receiver of the wrong type.
/* expected
view TypeError 0 TypeError 0
base TypeError 0 TypeError 0
exact TypeError 0
right 3 4 3 4
*/
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
interface Sink { put(v: number | string): void }
class A { last = 0; put(v: number) { this.last = v } }
class B { last = 0; put(v: number) { this.last = v + 1 } }
const a = new A(), b = new B()
const sinks: Sink[] = [a, b]
console.log("view", sinks.map(s => attempt(() => { s.put("s"); return "stored" })).map((r, i) => r + " " + [a, b][i].last).join(" "))
class Base { last = 0; put(v: number | string) {} }
class C extends Base { put(v: number) { this.last = v } }
class D extends Base { put(v: number) { this.last = v + 1 } }
const c = new C(), d = new D()
const bases: Base[] = [c, d]
console.log("base", bases.map(s => attempt(() => { s.put("s"); return "stored" })).map((r, i) => r + " " + [c, d][i].last).join(" "))
const e = new A()
console.log("exact", attempt(() => { (e as Sink).put("s"); return "stored" }), e.last)
for (const s of sinks) s.put(3)
for (const s of bases) s.put(3)
console.log("right", a.last, b.last, c.last, d.last)
//// primitive-parameter-via-unchecked-call.ts
// A parameter declared with primitive types only receives a value from a call that TypeScript did not check.
/* expected
seen TypeError
unseen TypeError
default TypeError
optional TypeError
union TypeError
setter TypeError 1
closure TypeError
method TypeError
caught TypeError finally
right 8 11 number string 5 6 3
*/
////= attempt
function twice(n: number): number { return n * 2 }
const loose: any = { twice }
attempt("seen", () => (twice as any)("4"))
attempt("unseen", () => loose.twice("4"))
function withDefault(n: number = 10): number { return n + 1 }
function optional(n?: number): string { return typeof n }
function either(v: number | string): string { return typeof v }
attempt("default", () => (withDefault as any)("1"))
attempt("optional", () => (optional as any)("x"))
attempt("union", () => (either as any)(true))
class Dial { private at = 1; set value(n: number) { this.at = n } get value(): number { return this.at } add(n: number) { return this.at + n } }
const dial = new Dial()
try { (dial as any).value = "x"; console.log("setter stored", dial.value) } catch (e) { console.log("setter", (e as Error).constructor.name, dial.value) }
