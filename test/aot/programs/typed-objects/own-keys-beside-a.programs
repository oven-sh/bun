for (let round = 0; round < 2000; round++) for (let i = 0; i < parts.length; i++) sum += (read_head7(parts[i]) ?? 1) + (read_tail4(parts[i]) ?? 2) + (read_odd(parts[i]) ?? 3) + (read_middle6(parts[i]) ?? 4);
