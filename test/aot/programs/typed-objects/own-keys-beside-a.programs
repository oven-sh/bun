//// own-keys-beside-a-type-with-a-symbol-keyed-field.ts
// One type with a symbol-keyed field in the program costs the other types nothing: Reflect.ownKeys and Object.getOwnPropertySymbols on their objects do not enter the runtime. Objects of the type that has the field list it, after the strings.
const count: (name: string) => number = (globalThis as any).aotOperationCount ?? (() => 0)
const kTag = Symbol("tag")
interface Tagged { n: number; [kTag]: string }
interface Plain { a: number; b: string }
function sizeOf(plain: Plain) { return Reflect.ownKeys(plain).length * 10 + Object.getOwnPropertySymbols(plain).length }
function sizeOfAny(value: any) { return Reflect.ownKeys(value).length * 10 + Object.getOwnPropertySymbols(value).length }
function listOf(tagged: Tagged) { return Reflect.ownKeys(tagged).map(String).join() + " | " + Object.getOwnPropertySymbols(tagged).map(String).join() + " | " + Object.keys(tagged).join() }
let total = 0
for (let i = 0; i < 100; i++) total += sizeOf({ a: i, b: "x" }) + sizeOfAny({ a: i, b: "y" } as Plain)
const before = count("operationAOTOwnPropertyKeys")
for (let i = 0; i < 20000; i++) total += sizeOf({ a: i, b: "x" }) + sizeOfAny({ a: i, b: "y" } as Plain)
console.log(total, count("operationAOTOwnPropertyKeys") - before < 100)
const tagged: Tagged = { n: 1, [kTag]: "t" }
console.log(listOf(tagged), sizeOfAny(tagged), tagged[kTag])
const other = Symbol("other")
const extended: any = { a: 1, b: "z" } as Plain
extended[other] = 2
extended[Symbol.iterator] = undefined
console.log(sizeOfAny(extended), Reflect.ownKeys(extended).map(String).join(), extended[other], other in extended, kTag in extended, Symbol.toPrimitive in extended)
const marked: any = tagged
marked[other] = 3
console.log(listOf(tagged), marked[other], delete marked[other], listOf(tagged))
console.log(JSON.stringify({ ...tagged }), Object.getOwnPropertySymbols({ ...tagged }).length, Object.getOwnPropertySymbols(Object.assign({}, tagged)).length, Object.getOwnPropertySymbols({ ...(extended as Plain) }).length)
//// own-property-questions-in-the-middle-of-construction/main.ts
const names = ["a", "asked", "f", "h", "late", "none"];
const nameAt = (index: number): string => names[index % names.length];

function ask(object: object): string {
  const answers: unknown[] = [];
  for (let i = 0; i < names.length; ++i) {
    const name = nameAt(i);
    answers.push(
      name,
      Object.hasOwn(object, name),
      Object.prototype.hasOwnProperty.call(object, name),
      name in object,
      Reflect.has(object, name),
      Object.prototype.propertyIsEnumerable.call(object, name),
      Object.getOwnPropertyDescriptor(object, name) !== undefined,
    );
  }
  return answers.map(answer => (answer === true ? "+" : answer === false ? "-" : " " + answer + " ")).join("");
}

class Laid {
  a = 1;
  asked: string = [
    Object.hasOwn(this, "a"),
    Object.hasOwn(this, "asked"),
    Object.hasOwn(this, "f"),
    Object.hasOwn(this, "h"),
    Object.hasOwn(this, "late"),
    Object.hasOwn(this, "none"),
    this.hasOwnProperty("a"),
    this.hasOwnProperty("h"),
    Object.prototype.hasOwnProperty.call(this, "h"),
    "h" in this,
    Reflect.has(this, "h"),
    this.propertyIsEnumerable("h"),
    Object.getOwnPropertyDescriptor(this, "h") === undefined,
    Object.keys(this).join(),
    Object.getOwnPropertyNames(this).join(),
    Reflect.ownKeys(this).join(),
    Object.entries(this).length,
    JSON.stringify(this),
    Object.keys({ ...this }).join(),
  ].join(" ");
  byKey: string = ask(this);
  f = (): number => this.a;
  again: string = [Object.hasOwn(this, "f"), Object.hasOwn(this, "h"), Object.hasOwn(this, "again"), this.hasOwnProperty("h"), ask(this)].join(" ");
  h = 3;
  late?: number;
  behind: string = [Object.hasOwn(this, "h"), Object.hasOwn(this, "late"), Object.hasOwn(this, "behind"), ask(this)].join(" ");
}

class Heir extends Laid {
  own = 5;
  heirAsked: string = [Object.hasOwn(this, "h"), Object.hasOwn(this, "own"), Object.hasOwn(this, "heirAsked"), Object.hasOwn(this, "last"), this.hasOwnProperty("last"), ask(this)].join(" ");
  last = 6;
}

class Quiet {
  a = 1;
  h = 3;
  late?: number;
}

function whole(object: Laid | Quiet): string {
  return [Object.hasOwn(object, "a"), Object.hasOwn(object, "h"), Object.hasOwn(object, "late"), Object.hasOwn(object, "none"), object.hasOwnProperty("h"), object.hasOwnProperty("late")].join();
}

for (let round = 0; round < 3; ++round) {
  const laid = new Laid();
  console.log(laid.asked);
  console.log(laid.byKey);
  console.log(laid.again);
  console.log(laid.behind);
  console.log(whole(laid), ask(laid));
  const heir = new Heir();
  console.log(heir.asked === laid.asked, heir.again === laid.again, heir.heirAsked);
  console.log(whole(heir), Object.hasOwn(heir, "last"), Object.hasOwn(heir, "own"));
  const quiet = new Quiet();
  console.log(whole(quiet), ask(quiet));
  quiet.late = 1;
  laid.late = 2;
  console.log(whole(quiet), whole(laid));
  delete quiet.late;
  console.log(whole(quiet));
}
//// parsed-data-spread-into-class-argument.ts
// TypeScript's classes are structural: a literal with all the members of a class is of its type, also one that takes some of them from parsed data by a spread. Here the literal is an argument. The programs named like this one have it as an array element, a field and a result.
class Vec { x: number; y: number; constructor(x: number, y: number) { this.x = x; this.y = y } len2(): number { return this.x * this.x + this.y * this.y } }
function takes(v: Vec): string { return v.x + "," + v.y + "," + v.len2() + "," + (v instanceof Vec) }
const real = new Vec(3, 4);
for (let round = 0; round < 3; round++) {
  const parsed: { x: number; y: number } = JSON.parse(`{"x":${round},"y":8}`);
  console.log(takes(real), takes({ ...parsed, len2: real.len2 }));
}
//// parsed-data-spread-into-class-array-element.ts
// TypeScript's classes are structural: a literal with all the members of a class is of its type, also one that takes some of them from parsed data by a spread. Here the literal is an array element. The programs named like this one have it as an argument, a field and a result.
class Vec { x: number; y: number; constructor(x: number, y: number) { this.x = x; this.y = y } len2(): number { return this.x * this.x + this.y * this.y } }
function takes(v: Vec): string { return v.x + "," + v.y + "," + v.len2() + "," + (v instanceof Vec) }
const real = new Vec(3, 4);
for (let round = 0; round < 3; round++) {
  const parsed: { x: number; y: number } = JSON.parse(`{"x":${round},"y":8}`);
  const all: Vec[] = [real, { ...parsed, len2: real.len2 }];
  console.log(all.map(takes).join(" "));
}
//// parsed-data-spread-into-class-field.ts
// TypeScript's classes are structural: a literal with all the members of a class is of its type, also one that takes some of them from parsed data by a spread. Here the literal is stored into a field. The programs named like this one have it as an argument, an array element and a result.
class Vec { x: number; y: number; constructor(x: number, y: number) { this.x = x; this.y = y } len2(): number { return this.x * this.x + this.y * this.y } }
function takes(v: Vec): string { return v.x + "," + v.y + "," + v.len2() + "," + (v instanceof Vec) }
const real = new Vec(3, 4);
class Box { v: Vec; constructor(v: Vec) { this.v = v } }
const box = new Box(real);
for (let round = 0; round < 3; round++) {
  const parsed: { x: number; y: number } = JSON.parse(`{"x":${round},"y":8}`);
  console.log(takes(box.v));
  box.v = { ...parsed, len2: real.len2 };
  console.log(takes(box.v));
}
//// parsed-data-spread-into-class-result.ts
// TypeScript's classes are structural: a literal with all the members of a class is of its type, also one that takes some of them from parsed data by a spread. Here the literal is a result. The programs named like this one have it as an argument, an array element and a field.
class Vec { x: number; y: number; constructor(x: number, y: number) { this.x = x; this.y = y } len2(): number { return this.x * this.x + this.y * this.y } }
function takes(v: Vec): string { return v.x + "," + v.y + "," + v.len2() + "," + (v instanceof Vec) }
const real = new Vec(3, 4);
function make(text: string): Vec { const parsed: { x: number; y: number } = JSON.parse(text); return { ...parsed, len2: real.len2 } }
for (let round = 0; round < 3; round++) console.log(takes(real), takes(make(`{"x":${round},"y":8}`)));
//// parsed-json-into-declared-types.ts
// Parsed JSON enters a declared type by `as`, an annotated variable, a parameter or a result. Any object passes and stays the object it is. A field of another kind throws a TypeError at its first typed read, a missing field reads undefined.
////= attempt
interface P { x: number; label: string; ok: boolean; opt?: number; child: { v: number } }
const text = '{"x":1,"label":"l","ok":true,"child":{"v":2}}'
const source = JSON.parse(text)
const good = source as P
attempt("a1", () => good.x + 1)
attempt("a2", () => good.label + "!")
attempt("a3", () => good.ok === true)
attempt("a4", () => good.opt)
attempt("a5", () => good.child.v + 1)
// The same object: what happens to the one is seen in the other.
attempt("a6", () => (good === source) + " " + (good.child === source.child))
attempt("a7", () => { source.x = 50; source.child.v = 50; return good.x + " " + good.child.v })
attempt("a8", () => JSON.stringify(good) === text)
// The keys keep the order of the text, those that the type does not name included.
attempt("a9", () => JSON.stringify(JSON.parse('{"zeta":1,"label":"l","x":1,"extra":[1],"ok":false,"child":{"v":2,"w":3}}') as P))
// A value of another kind than the field, at any depth; a required property that is missing. Nothing is converted. The reads are made on the result of a call of `cast`, whose written result type is P, so each is a typed read; b6t holds the field in an annotated variable.
const cast = (json: string): P => JSON.parse(json) as P
attempt("b1", () => cast('{"x":"1","label":"l","ok":true,"child":{"v":2}}').x)
attempt("b2", () => cast('{"x":1,"label":2,"ok":true,"child":{"v":2}}').label)
attempt("b3", () => cast('{"x":1,"label":"l","ok":"yes","child":{"v":2}}').ok)
attempt("b4", () => cast('{"x":1,"label":"l","ok":true,"opt":"o","child":{"v":2}}').opt)
attempt("b5", () => cast('{"x":1,"label":"l","ok":true,"child":{"v":"two"}}').child.v)
attempt("b6", () => typeof cast('{"x":1,"label":"l","ok":true,"child":5}').child)
attempt("b6t", () => { const c: { v: number } = cast('{"x":1,"label":"l","ok":true,"child":5}').child; return typeof c })
attempt("b7", () => typeof cast('{"x":{},"label":"l","ok":true,"child":{"v":2}}').x)
attempt("b8", () => typeof cast('{"x":1,"label":[],"ok":true,"child":{"v":2}}').label)
attempt("b9", () => Array.isArray(cast('{"x":1,"label":"l","ok":true,"child":[]}').child))
attempt("b10", () => cast('{"label":"l","ok":true,"child":{"v":2}}').x)
attempt("b11", () => cast('{"x":1,"label":"l","ok":true}').child)
// null and undefined pass every written type.
attempt("b12", () => cast('{"x":null,"label":"l","ok":true,"child":{"v":2}}').x)
attempt("b13", () => cast('{"x":1,"label":null,"ok":true,"child":{"v":2}}').label)
attempt("b14", () => cast('{"x":1,"label":"l","ok":true,"child":null}').child)
attempt("b15", () => cast('{"x":1,"label":"l","ok":true,"opt":null,"child":{"v":2}}').opt)
attempt("b16", () => { const bad = JSON.parse('{"x":"1","label":"l","ok":true,"child":{"v":2}}'); try { bad as P } catch {} return JSON.stringify(bad) })
// Any object passes `as`, and no code of the program runs to find that out. A read through it is the generic read (getter, trap, chain), and what it gives is tested against the type of the field: c1 finds a string.
let ran = 0
attempt("c1", () => (Object.create({ x: "proto" }) as P).x)
attempt("c2", () => { try { return (Object.defineProperty(JSON.parse(text), "x", { get() { ran++; return 1 }, enumerable: true, configurable: true }) as P).x } catch (e) { return (e as Error).constructor.name + " " + ran } })
attempt("c3", () => { try { return (new Proxy(JSON.parse(text), { get(t, k) { ran++; return t[k] }, ownKeys(t) { ran++; return Reflect.ownKeys(t) }, getOwnPropertyDescriptor(t, k) { ran++; return Reflect.getOwnPropertyDescriptor(t, k) } }) as P).x } catch (e) { return (e as Error).constructor.name + " " + ran } })
attempt("c4", () => (Object.freeze(JSON.parse(text)) as P).x)
attempt("c5", () => (new Date(0) as unknown as P).x)
attempt("c6", () => ((() => 1) as unknown as P).x)
attempt("d1", () => { const { x }: P = JSON.parse('{"x":"1","label":"l","ok":true,"child":{"v":2}}'); return x })
attempt("d2", () => { const { child: { v } }: P = JSON.parse('{"x":1,"label":"l","ok":true,"child":{"v":"two"}}'); return v })
attempt("d3", () => { const { x, ...others }: P = JSON.parse(text); return x + Object.keys(others).join() })
// One access site sees objects that a literal made and parsed objects.
function sum(items: P[]): number { let s = 0; for (const item of items) s += item.x; return s }
const own: P = { x: 5, label: "own", ok: false, child: { v: 1 } }
attempt("e1", () => sum([own, good, own]))
attempt("e2", () => sum([good, own, own]))
// A field of function type takes what can be called, and null. The typed read finds anything else.
interface H { run: () => number }
attempt("g1", () => typeof (JSON.parse('{"run":5}') as H).run)
attempt("g2", () => typeof ({ run: Math.random } as H).run)
attempt("g3", () => typeof (JSON.parse('{"run":{}}') as H).run)
attempt("g4", () => typeof (JSON.parse('{"run":null}') as H).run)
// The places whose type is written down test as `as` does: variable, parameter (also for a caller that knows nothing of it), result, field.
function viaParameter(p: P): number { return p.x }
function viaResult(): P { return JSON.parse(text) }
interface Holder { p: P }
attempt("h1", () => { const p: P = JSON.parse(text); return p.x })
attempt("h2", () => viaParameter(JSON.parse(text)) + " " + (viaParameter as any)(JSON.parse(text)))
attempt("h3", () => viaResult().x)
attempt("h4", () => { const holder: Holder = { p: own }; holder.p = JSON.parse(text); return holder.p.x })
// A store by code that does not know the object is not tested. The typed read after it is.
function store(target: any, value: unknown): void { target.p = value }
attempt("h5", () => { const holder: Holder = { p: own }; store(holder, JSON.parse(text)); return holder.p.x })
// A parameter that has its type from its default only is not tested.
function viaDefault(o = { a: 1 }): number { return o.a }
attempt("h6", () => (viaDefault as any)(JSON.parse('{"a":2}')))
// What a function does to its parameter it does to the caller's object.
function fill(p: P): void { p.x = 1 }
attempt("h7", () => { const plain = JSON.parse('{"x":0,"label":"l","ok":true,"child":{"v":2}}'); (fill as any)(plain); return plain.x })
// An element read gives the object that was pushed. `!` tests nothing.
attempt("h8", () => { const list: P[] = []; (list as unknown[]).push(JSON.parse(text)); return list[0].x })
attempt("h9", () => { const list: P[] = []; (list as unknown[]).push(JSON.parse(text)); return list[0]!.x })
// An array stays the array it is, and so do its elements.
attempt("i1", () => { const array = JSON.parse("[" + text + "," + text + "]"), first = array[0]; const items = array as P[]; return (items === array) + " " + (array[0] === first) + " " + (sum(items) + 1) })
attempt("i2", () => { const array = JSON.parse("[" + text + ',{"x":"1"}]'), first = array[0]; try { return sum(array as P[]) } catch (e) { return (e as Error).constructor.name + " " + (array[0] === first) } })
//// parsed-json-missing-or-null-fields.ts
// Parsed JSON that has every required field is cast to a declared type.
////= attempt
interface P { x: number; label: string; ok: boolean; opt?: number; child: { v: number } }
const nulls = JSON.parse('{"x":0,"label":null,"ok":false,"child":null}') as P
const whole = JSON.parse('{"child":{"v":2},"opt":7,"ok":true,"label":"whole","x":-0.5}') as P
const own: P = { x: 5, label: "own", ok: true, child: { v: 1 } }
attempt("a1", () => [whole.x, whole.label, whole.ok, whole.opt, whole.child.v, Object.keys(whole).join("")].map(String).join())
attempt("a3", () => [nulls.x, nulls.label, nulls.ok, nulls.opt, nulls.child].map(String).join())
attempt("a4", () => [nulls.x + 1, nulls.label + "!", nulls.ok ? 1 : 0, typeof nulls.label, nulls.label === null, "label" in nulls, "opt" in nulls, JSON.stringify(nulls)].join())
attempt("a5", () => nulls.label.length)
attempt("a6", () => nulls.child.v)
attempt("a7", () => whole.child?.v)
function sum(items: P[]): number { let s = 0; for (const item of items) s += item.x; return s }
function labels(items: P[]): string { let s = ""; for (const item of items) s += item.label + (item.ok ? "+" : "-"); return s }
attempt("b1", () => [sum([own, own]), sum([own, whole]), sum([own, nulls, own]), sum([nulls])].join())
attempt("b2", () => [labels([own]), labels([whole, own]), labels([own, nulls])].join())
attempt("c1", () => { const { x, label = "dflt", opt = 9 } = whole; return [x, label, opt].map(String).join() })
attempt("c2", () => { const { x, label = "dflt", opt = 9 } = nulls; return [String(x), String(label), String(opt)].join() })
// The value goes on into compiled places.
interface Copy { x: number; label: string }
attempt("d1", () => { const c: Copy = { x: whole.x, label: nulls.label }; return JSON.stringify(c) + Object.keys(c).join() + (c.x + 1) + c.label })
attempt("d2", () => { const c: Copy = { x: 1, label: "l" }; c.x = nulls.x; c.label = nulls.label; return JSON.stringify(c) + (c.x + 1) + c.label })
attempt("d3", () => { const list: string[] = [whole.label, nulls.label, own.label]; return JSON.stringify(list) + list.map(n => n + "1").join() })
// Over null.
attempt("e1", () => { const bare = Object.assign(Object.create(null), JSON.parse('{"x":1,"label":"bare","ok":true,"child":{"v":3}}')) as P; return [bare.x, bare.label, bare.ok, bare.opt, bare.child.v, Object.getPrototypeOf(bare)].map(String).join() })
attempt("e2", () => { const bare = Object.assign(Object.create(null), { x: 1, label: "bare", ok: true, child: { v: 3 } }) as P; return [bare.x, bare.label, bare.ok, bare.opt, bare.child.v, Object.getPrototypeOf(bare)].map(String).join() })
// Arrays, tuples and maps.
const withNull = JSON.parse('["a",null,"c"]') as string[]
attempt("f1", () => [withNull[0], withNull[1], withNull[2], withNull[3]].map(String).join())
attempt("f2", () => { let s = ""; for (const n of withNull) s += n; return s })
attempt("f3", () => { let s = ""; for (let i = 0; i <= withNull.length; i++) s += withNull[i]; return s })
attempt("f4", () => (JSON.parse("[null]") as string[])[0] + "!")
attempt("f5", () => { const t = JSON.parse('[null,2]') as [string, number]; return t[0] + "/" + t[1] })
attempt("f6", () => { const n = JSON.parse("[1,2.5]") as number[]; return n[0] + n[1] + "/" + n[2] })
const byKey = new Map<string, string>()
;(byKey as Map<string, any>).set("n", null).set("u", undefined)
attempt("g1", () => [byKey.get("n"), byKey.get("u"), byKey.get("none")].map(String).join())
// Results of functions from outside.
const parse = JSON.parse as (text: string) => string
attempt("h1", () => [parse("null"), parse("null") + "1", parse('"s"')].map(String).join())
//// parsed-json-through-interfaces.ts
// Objects made by `JSON.parse` are used through declared types at the same sites as typed objects: reads, stores, optional fields, nesting, key order.
interface Address { city: string; zip?: string }
interface Person { id: number; nick: string; active: boolean; address: Address; tags: string[]; boss?: Person | null; score?: number }
const source = '{"nick":"ann","id":1,"active":true,"address":{"zip":"123","city":"Oslo"},"tags":["a","b"],"boss":null}'
const parsed = JSON.parse(source) as Person
const native: Person = { id: 2, nick: "bob", active: false, address: { city: "Rome" }, tags: [], boss: parsed }
function card(p: Person): string {
  return [p.id, p.nick, p.active, p.address.city, String(p.address.zip), p.tags.length, p.tags.join("+"), p.boss ? p.boss.nick : String(p.boss), String(p.score), "score" in p].join("|")
}
console.log(card(parsed))
console.log(card(native))
parsed.score = 5; parsed.id++; parsed.nick += "!"; parsed.active = !parsed.active
parsed.address = { city: "Bern" }
parsed.tags.push("c")
native.address = JSON.parse('{"city":"Kyiv","zip":"01001"}')
native.boss = JSON.parse(source)
native.tags = JSON.parse('["x","y","z"]')
console.log(card(parsed))
console.log(card(native))
console.log(JSON.stringify(parsed))
console.log(JSON.stringify(native))
delete parsed.score; delete native.boss; delete native.address.zip
parsed.boss = native
console.log(card(parsed), Object.keys(parsed).join(), Object.keys(native).join(), Object.keys(native.address).join())
parsed.score = 1.5; native.score = 2; native.address.zip = "z"
console.log(Object.keys(parsed).join(), Object.keys(native).join(), (parsed.score ?? 0) + (native.score ?? 0), native.address.zip)
// Numbers of every storage class.
interface Num { n: number; m?: number }
const nums = JSON.parse('[{"n":1},{"n":1.5},{"n":-0},{"n":1e21},{"n":2147483648,"m":-2147483648},{"n":9007199254740993},{"m":0,"n":1e-7}]') as Num[]
function totalOf(list: Num[]): number { let t = 0; for (const x of list) t += x.n + (x.m ?? 0); return t }
console.log(nums.map(x => Object.is(x.n, -0) ? "-0" : String(x.n)).join(), totalOf(nums), nums.map(x => x.n | 0).join())
nums.push({ n: 3 }, { m: 1, n: 4 })
for (const x of nums) { x.n *= 2; x.m ??= 7 }
