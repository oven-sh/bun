//// properties-read-by-host.ts
import { inspect, isDeepStrictEqual } from "node:util";
interface Row { id: number; name: string; note?: string; score?: number }
type Init = { status?: number; statusText?: string; headers?: Record<string, string> };
type Format = { minimumFractionDigits?: number; maximumFractionDigits?: number; style?: "decimal" | "percent"; useGrouping?: boolean };
type DateFormat = { year?: "numeric"; month?: "long" | "short"; day?: "numeric"; timeZone?: string };
type Descriptor = { value?: unknown; writable?: boolean; enumerable?: boolean; configurable?: boolean; get?: () => unknown };
type Handler = { get?: (target: object, key: string | symbol) => unknown; has?: (target: object, key: string | symbol) => boolean };
type ArrayLike3 = { length: number };
type InspectOptions = { depth?: number; compact?: boolean; sorted?: boolean };
class Base { constructor(public v: number) {} method() { return "method " + this.v; } get twice() { return this.v * 2; } static made = 1; }
class Heir extends Base { w = 5; own() { return "own"; } }
function hide(value: unknown): any { return value; }
let count = 0;
////= show-2	out = JSON.stringify(make(), (_k, v) => v === undefined ? "undefined" : typeof v === "function" ? "function" : typeof v === "symbol" ? "symbol" : v
const row = (id: number): Row => ({ id, name: "n" + id });
const names: (string | symbol | number)[] = ["id", "name", "note", "score", "nope", "toString", "constructor", "__proto__", "0", "1.5", "-1", "4294967295", "", "length", 0, 7, Symbol.iterator, Symbol.toStringTag, Symbol("mine")];
const reads = (x: unknown) => names.map(n => { const v = hide(x); return [Reflect.get(v, n), Reflect.has(v, n), Object.hasOwn(v, n), v.hasOwnProperty(n), v.propertyIsEnumerable(n), Reflect.getOwnPropertyDescriptor(v, n)]; });
show("every name on a record", () => reads(row(1)));
show("with the optional fields set", () => { const x = row(1); x.note = "note"; x.score = 1.5; return reads(x); });
show("an optional field undefined, deleted", () => { const x = row(1), y = row(2); x.note = undefined; y.note = "n"; delete y.note; return [reads(x), reads(y)]; });
show("with extras", () => { const x = row(1); hide(x).nope = "extra"; hide(x)[0] = "zero"; hide(x)[Symbol.toStringTag] = "Tag"; return reads(x); });
show("an extra accessor", () => { const x = row(1); Object.defineProperty(hide(x), "nope", { get() { return "got " + this.id; }, configurable: true }); return reads(x); });
show("instances", () => [reads(new Base(1)), reads(new Heir(2))]);
show("inherited: a method, an accessor with its receiver, a static", () => { const h = hide(new Heir(3)); return [Reflect.get(h, "method").call(h), Reflect.get(h, "twice"), Reflect.get(h, "twice", { v: 50 }), Reflect.get(h, "own").call(h), Reflect.get(h, "made"), Reflect.has(h, "method"), Reflect.has(h, "twice"), Object.hasOwn(h, "twice")]; });
show("an absent optional field whose name the prototype has", () => { const proto = JSON.parse('{"note":"from the prototype","nope":"also"}'); const x = row(1), y = row(2); Object.setPrototypeOf(x, proto); Object.setPrototypeOf(y, proto); y.note = "own"; return [reads(x), reads(y)]; });
show("a prototype with an index and a symbol", () => { const proto = JSON.parse('{"0":"zero","7":"seven"}'); proto[Symbol.toStringTag] = "P"; const x = row(1); Object.setPrototypeOf(x, proto); return reads(x); });
show("a null prototype", () => { const x = row(1); Object.setPrototypeOf(x, null); return names.map(n => [Reflect.get(x, n), Reflect.has(x, n), Object.hasOwn(x, n)]); });
show("a typed object as a prototype", () => { const proto = row(1); proto.note = "typed above"; const child = Object.create(proto), typedChild = row(2); Object.setPrototypeOf(typedChild, proto); return [reads(child), reads(typedChild)]; });
show("a proxy over a typed object", () => { const p = new Proxy(row(1), {}); return names.map(n => [Reflect.get(p, n), Reflect.has(p, n)]); });
show("frozen, sealed, closed", () => [Object.freeze(row(1)), Object.seal(row(2)), Object.preventExtensions(row(3))].map(reads));
show("isFrozen, isSealed, isExtensible", () => { const e: { o?: number } = {}; const withExtra = row(9); hide(withExtra).extra = 1; const list: unknown[] = [row(1), Object.preventExtensions(row(2)), Object.seal(row(3)), Object.freeze(row(4)), e, Object.preventExtensions({} as { o?: number }), Object.seal({} as { o?: number }), withExtra, Object.freeze(withExtra), new Base(1), Object.freeze(new Heir(2))]; return list.map(x => [Object.isFrozen(x), Object.isSealed(x), Object.isExtensible(x)]); });
show("closed, then its only field deleted", () => { const x: { o?: number } = { o: 1 }; Object.preventExtensions(x); const before = [Object.isFrozen(x), Object.isSealed(x)]; delete x.o; return [before, Object.isFrozen(x), Object.isSealed(x)]; });
show("new Response(body, typed)", () => { const a: Init = { status: 201, statusText: "made" }, b: Init = {}, c: Init = { headers: { "x-a": "1" } }; return [a, b, c].map(i => { const r = new Response("b", i); return [r.status, r.statusText, r.headers.get("x-a")]; }); });
show("Intl.NumberFormat(locale, typed)", () => { const a: Format = { minimumFractionDigits: 2 }, b: Format = { style: "percent", maximumFractionDigits: 1 }, c: Format = { useGrouping: false }; return [a, b, c, {} as Format].map(o => new Intl.NumberFormat("en-US", o).format(1234.5678)); });
show("toLocaleDateString(locale, typed)", () => { const a: DateFormat = { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }, b: DateFormat = { month: "short", timeZone: "UTC" }; return [a, b].map(o => new Date(86400000).toLocaleDateString("en-US", o)); });
show("Object.defineProperty(o, k, typed)", () => { const a: Descriptor = { value: 1, enumerable: true }, b: Descriptor = { get: () => "got", configurable: true }, c: Descriptor = {}; return [a, b, c].map(d => Object.getOwnPropertyDescriptor(Object.defineProperty({}, "k", d), "k")); });
show("Object.defineProperties(o, typed)", () => { const all: { a: Descriptor; b: Descriptor } = { a: { value: 1, enumerable: true }, b: { value: 2 } }; return Object.getOwnPropertyDescriptors(Object.defineProperties({}, all)); });
show("new Proxy(target, typed)", () => { const h: Handler = { get: (_t, k) => "trapped " + String(k) }, none: Handler = {}, has: Handler = { has: () => true }; const t = { a: 1 }; return [hide(new Proxy(t, h)).a, hide(new Proxy(t, none)).a, "zz" in new Proxy(t, has), "zz" in new Proxy(t, none)]; });
show("a typed handler that gets a trap late", () => { const h: Handler = {}; const p = hide(new Proxy({ a: 1 }, h)); const out = [p.a, p.a]; h.get = () => "late"; out.push(p.a); delete h.get; out.push(p.a); return out; });
show("Array.from(typed array-like)", () => { const a: ArrayLike3 = { length: 2 }; hide(a)[0] = "x"; hide(a)[1] = "y"; return [Array.from(hide(a)), Array.prototype.slice.call(a, 1), Array.prototype.join.call(a, "-")]; });
show("inspect(value, typed)", () => { const o: InspectOptions = { depth: 0, compact: true }, s: InspectOptions = { sorted: true }; return [inspect({ b: { c: 1 }, a: 1 }, o), inspect({ b: 1, a: 2 }, s)]; });
show("isDeepStrictEqual", () => [isDeepStrictEqual(row(1), row(1)), isDeepStrictEqual(row(1), row(2)), isDeepStrictEqual(row(1), { id: 1, name: "n1" }), isDeepStrictEqual(new Base(1), new Base(1)), isDeepStrictEqual(new Base(1), new Heir(1))]);
show("instanceof, isPrototypeOf, getPrototypeOf", () => { const h = new Heir(1); return [hide(h) instanceof Base, Base.prototype.isPrototypeOf(h), Object.getPrototypeOf(h) === Heir.prototype, Object.getPrototypeOf(row(1)) === Object.prototype]; });
show("with (typed) in sloppy code", () => new Function("o", "with (o) { return [id, name, typeof note, typeof nope]; }")(row(1)));
show("destructuring in code the build cannot see", () => new Function("o", "const { id, name, note = 'default', nope = 'none', ...rest } = o; return [id, name, note, nope, rest];")(row(1)));
//// properties-through-object-chain.ts
// `a.b.c.d`: each object on the way is only looked through. It may also be kept and used later, after the property it came from
// has been overwritten and much has been allocated. A link that is undefined or null throws, and the message says which.
interface Leaf { v: number; w: number; name: string }
interface Mid { leaf: Leaf; other: Leaf; k: number }
interface Top { mid: Mid; n: number; next?: Top }

function one(t: Top): number { return t.mid.k; }
function two(t: Top): number { return t.mid.leaf.v; }
function both(t: Top): number { return t.mid.leaf.v + t.mid.leaf.w; }
function pair(t: Top): number { const l = t.mid.leaf; return l.v * l.w; }
function length(t: Top): number { return t.mid.leaf.name.length; }
function list(t: Top): number { let s = 0; for (let p: Top | undefined = t; p; p = p.next) s += p.mid.k; return s; }
function same(t: Top): number { return t.mid.leaf === t.mid.other ? 1 : 0; }
function storeThrough(t: Top, x: number): void { t.mid.leaf.v = x; }
function storeLink(t: Top, x: number): void { t.mid.other = t.mid.leaf; }

let kept: Leaf[] = [];
function garbage(k: number): number {
  let s = 0;
  for (let i = 0; i < 400; i++) { const made = { v: i, w: k, name: "g" + i }; if (i % 97 === 0) kept.push(made); s += made.v; }
  if (kept.length > 50) kept = [];
  return s;
}
// The only reference to the leaf is the local one while the garbage is made.
function keptAcross(t: Top, k: number): number {
  const l = t.mid.leaf;
  t.mid.leaf = { v: -1, w: -1, name: "new" };
  const s = garbage(k);
  return l.v + l.w + l.name.length + (s & 1);
}
function readAfter(t: Top, k: number): number {
  const m = t.mid;
  t.mid = { leaf: { v: 1, w: 1, name: "" }, other: { v: 2, w: 2, name: "" }, k: 0 };
  garbage(k);
  return m.leaf.v + m.other.w + m.k;
}

function make(k: number, next?: Top): Top {
  const leaf = { v: k, w: k + 0.5, name: "n" + k };
  return { mid: { leaf, other: k & 1 ? leaf : { v: 0, w: 0, name: "" }, k: k * 2 }, n: k, next };
}
const readers: Array<(t: Top) => number> = [one, two, both, pair, length, list, same];
const stores: Array<(t: Top, x: number) => void> = [storeThrough, storeLink];
const across: Array<(t: Top, k: number) => number> = [keptAcross, readAfter];

let total = 0;
let chain: Top | undefined = undefined;
for (let k = 0; k < 600; k++) {
  const top = make(k, k % 10 ? chain : undefined);
  chain = top;
  for (const f of readers) total += f(top);
  for (const g of stores) g(top, total % 7);
  for (const f of readers) total += f(top);
  for (const f of across) total += f(top, k);
  for (const f of readers) total += f(top);
}
console.log(total);

function attempt(run: () => unknown): void {
  try { console.log(run()); } catch (e) { console.log(e instanceof TypeError, /undefined/.test(String(e)) ? "undefined" : /null/.test(String(e)) ? "null" : "neither"); }
}
attempt(() => two({ mid: undefined!, n: 1 }));
attempt(() => two({ mid: { leaf: null!, other: null!, k: 1 }, n: 1 }));
attempt(() => storeThrough({ mid: { leaf: undefined!, other: null!, k: 1 }, n: 1 }, 2));
attempt(() => length({ mid: { leaf: { v: 1, w: 2, name: undefined! }, other: null!, k: 1 }, n: 1 }));
attempt(() => same({ mid: { leaf: undefined!, other: null!, k: 1 }, n: 1 }));
attempt(() => same({ mid: { leaf: null!, other: null!, k: 1 }, n: 1 }));
//// property-descriptors-over-defaults.ts
// An object literal of defaults is overlaid with property descriptors (so that accessors survive), then with `Object.assign`, and cast to a wider type.
const UNSUPPORTED = { supported: false } as const;
const DEFAULTS = { isActive: () => true, isPassive: () => false, remote: UNSUPPORTED, limit: 10 };
interface Spec { supported: boolean; fields?: string[] }
interface Plugin { name: string; isActive(): boolean; isPassive(): boolean; remote: Spec; limit: number; label(): string; run(): string; readonly schema: string }
type Def = { name: string; remote?: Spec; limit?: number; readonly schema: string };
function build<D extends Def>(def: D): Plugin {
  const actions = { run: () => "ran " + def.name };
  const built: Plugin = Object.assign(Object.defineProperties({ ...DEFAULTS, label: () => def.name }, Object.getOwnPropertyDescriptors(def)), actions) as unknown as Plugin;
  return built;
}
let made = 0;
const a = build({ name: "read", remote: { supported: true, fields: ["path"] }, get schema() { made++; return "s" + made } });
const b = build({ name: "plain", limit: 3, schema: "fixed" });
console.log(a.name, a.remote.supported, a.remote.fields?.join(), a.limit, a.isActive(), a.label(), a.run(), made, a.schema, a.schema, made);
console.log(b.name, b.remote.supported, b.limit, b.schema, Object.keys(b).join());
//// property-descriptors-over-defaults-data-only.ts
// The same overlay with property descriptors as in property-descriptors-over-defaults, without an accessor in the definition.
const UNSUPPORTED = { supported: false } as const;
const DEFAULTS = { isActive: () => true, isPassive: () => false, remote: UNSUPPORTED, limit: 10 };
interface Spec { supported: boolean; fields?: string[] }
interface Plugin { name: string; isActive(): boolean; isPassive(): boolean; remote: Spec; limit: number; label(): string; run(): string; readonly schema: string }
type Def = { name: string; remote?: Spec; limit?: number; readonly schema: string };
function build<D extends Def>(def: D): Plugin {
  const actions = { run: () => "ran " + def.name };
  const built: Plugin = Object.assign(Object.defineProperties({ ...DEFAULTS, label: () => def.name }, Object.getOwnPropertyDescriptors(def)), actions) as unknown as Plugin;
  return built;
}
let made = 0;
const a = build({ name: "read", remote: { supported: true, fields: ["path"] }, schema: "s0" });
const b = build({ name: "plain", limit: 3, schema: "fixed" });
console.log(a.name, a.remote.supported, a.remote.fields?.join(), a.limit, a.isActive(), a.label(), a.run(), made, a.schema, a.schema, made);
console.log(b.name, b.remote.supported, b.limit, b.schema, Object.keys(b).join());
//// property-on-some-interface-classes.ts
declare const console: { log(...values: unknown[]): void };
export { };
// Five classes behind one interface. Three of them have `value`, two of those have `unit`: the classes that have a property are a part of
// the classes of the interface, and reading it asks which part an object belongs to.
interface Item { name: string; value?: number; unit?: string; note?: string }
class Length implements Item { name = "length"; value?: number = 1; unit?: string = "m"; }
class Weight implements Item { name = "weight"; value?: number = 2; unit?: string = "kg"; }
class Count implements Item { name = "count"; value?: number = 3; }
class Label implements Item { name = "label"; note?: string = "n"; }
class Gap implements Item { name = "gap"; }
function valueOf(item: Item): number { return item.value === undefined ? -1 : item.value; }
function unitOf(item: Item): string { return item.unit === undefined ? "-" : item.unit; }
function noteOf(item: Item): string { return item.note === undefined ? "-" : item.note; }
function double(item: Item): void { if (item.value !== undefined) item.value = item.value * 2; }
function rename(item: Item, unit: string): void { if (item.unit !== undefined) item.unit = unit; }
function describe(item: Item): string { return item.name + ":" + valueOf(item) + unitOf(item) + noteOf(item); }
function total(items: Item[]): number { let sum = 0; for (const item of items) sum += valueOf(item) + unitOf(item).length + noteOf(item).length; return sum; }
const items: Item[] = [new Length(), new Weight(), new Count(), new Label(), new Gap()];
// Objects that typed code has not made, and that have all an Item must have.
const strangers: Item[] = [
    Object.assign(Object.create({ more: 1 }), { name: "made", value: 7, unit: "s" }) as Item,
    Object.assign(Object.create({ inherited: true }), { name: "heir", value: 8 }) as Item,
    Object.freeze({ name: "frozen", note: "kept" }) as Item,
    Object.assign((): number => 1, { value: 9 }) as unknown as Item,
    Object.assign([1, 2], { name: "list", unit: "u" }) as unknown as Item,
    Object.assign(new Map<string, number>(), { name: "map" }) as unknown as Item,
];
const all = items.concat(strangers);
let out = "";
for (let round = 0; round < 3; round++) {
    for (const item of all) {
        out += describe(item) + " ";
        try { double(item); rename(item, "r" + round); } catch (error) { out += "(" + (error as Error).constructor.name + ") "; }
    }
    out += total(all) + "\n";
}
console.log(out);
//// property-redefined-via-helper.ts
// A helper function redefines or deletes a property of a typed object that was created by a literal elsewhere.
function defineLazy<T extends object>(target: T, key: keyof T, make: () => T[keyof T]): void {
  let made = false, value: T[keyof T];
  Object.defineProperty(target, key, { get() { if (!made) { value = make(); made = true; } return value; }, configurable: true, enumerable: true });
}
function defineLazyAndStorable<T extends object>(target: T, key: keyof T, make: () => T[keyof T]): void {
  Object.defineProperty(target, key, {
    get() { const value = make(); Object.defineProperty(target, key, { value, writable: true, configurable: true, enumerable: true }); return value; },
    set(value) { Object.defineProperty(target, key, { value, writable: true, configurable: true, enumerable: true }); },
    configurable: true, enumerable: true,
  });
}
function drop<T extends object>(target: T, key: keyof T): boolean { return delete target[key]; }
function hideIt<T extends object>(target: T, key: keyof T): void { Object.defineProperty(target, key, { enumerable: false }); }
function lockIt<T extends object>(target: T, key: keyof T): void { Object.defineProperty(target, key, { writable: false }); }

interface Settings { name: string; limit: number; schema: string; tags: string[]; note?: string; extra?: { deep: number } }
function makeSettings(name: string): Settings { return { name, limit: 10, schema: "eager", tags: ["a"] }; }
function typedReads(s: Settings): string { return [s.name, s.limit, s.schema, s.tags.join("+"), s.note, s.extra?.deep].map(String).join("|"); }
function peek(o: any, key: string): unknown { return o[key]; }
function byName(o: any): string { return [o.name, o.limit, o.schema, o.tags, o.note, o.extra && o.extra.deep].map(String).join("|"); }
function everyWay(label: string, s: Settings): void {
  console.log(label, "typed:", typedReads(s));
  console.log(label, "by name:", byName(s));
  console.log(label, "spread:", JSON.stringify({ ...s }));
  console.log(label, "JSON:", JSON.stringify(s));
  console.log(label, "keys:", Object.keys(s).join(), "| names:", Object.getOwnPropertyNames(s).join());
  console.log(label, "in:", "name" in s, "limit" in s, "schema" in s, "tags" in s, "note" in s, "extra" in s);
  const parts: string[] = []; for (const k in s) parts.push(k); console.log(label, "for in:", parts.join());
}
let calls = 0;

// A getter over a REQUIRED field, the key handed on as a parameter.
const a = makeSettings("a");
for (const key of ["schema"] as (keyof Settings)[]) defineLazy(a, key, () => { calls++; return "lazy " + calls; });
console.log("not made yet:", calls);
everyWay("a", a);
console.log("made once:", calls, typeof Object.getOwnPropertyDescriptor(a, "schema")!.get);

// Several times on one record: a required string, a required number, a required reference, an optional one that is absent, an optional reference.
const b = makeSettings("b");
defineLazy(b, "schema", () => "lazy schema");
defineLazy(b, "limit", () => 42);
defineLazy(b, "tags", () => ["x", "y"]);
defineLazy(b, "note", () => "lazy note");
defineLazy(b, "extra", () => ({ deep: 7 }));
everyWay("b", b);

// The accessor replaces itself by data at the first read, or at the first store.
const c = makeSettings("c");
defineLazyAndStorable(c, "schema", () => "resolved");
defineLazyAndStorable(c, "limit", () => 5);
console.log("c first:", c.schema, typeof Object.getOwnPropertyDescriptor(c, "schema")!.get, Object.getOwnPropertyDescriptor(c, "schema")!.value);
c.limit = 99;
console.log("c stored:", c.limit, typeof Object.getOwnPropertyDescriptor(c, "limit")!.get);
everyWay("c", c);

// A store to a property that has only a getter: strict code throws the language's own TypeError.
const d = makeSettings("d");
defineLazy(d, "schema", () => "only a getter");
try { d.schema = "stored"; console.log("d: no error", d.schema); } catch (e) { console.log("d:", e instanceof TypeError ? "TypeError" : "other", d.schema); }

const e = makeSettings("e");
console.log("deleted:", drop(e, "schema"), drop(e, "limit"), drop(e, "note"));
console.log("e typed:", String(e.schema), e.name, "schema" in e, "limit" in e, "| by name:", String(peek(e, "schema")), String(peek(e, "limit")));
console.log("e keys:", Object.keys(e).join(), JSON.stringify(e), JSON.stringify({ ...e }));
e.schema = "again"; e.limit = 3;
console.log("e again:", e.schema, e.limit, Object.keys(e).join(), JSON.stringify(e));
const f = makeSettings("f");
console.log("deleted:", drop(f, "tags"), String(peek(f, "tags")), "tags" in f, Object.keys(f).join());

// Attributes alone.
const g = makeSettings("g");
hideIt(g, "schema"); lockIt(g, "limit");
everyWay("g", g);
try { g.limit = 1; console.log("g: no error", g.limit); } catch (x) { console.log("g:", x instanceof TypeError ? "TypeError" : "other", g.limit); }
g.name = "still stored"; console.log("g other field:", g.name);

// A record that no helper has touched is as it was.
everyWay("h", makeSettings("h"));
//// prototype-chain-of-kinds-changes-late.ts
// Objects of several kinds come from one constructor. Hot code walks their prototype chain, then the chain changes.
type Mutable<T> = { -readonly [K in keyof T]: T[K] };
interface Tree { readonly kind: number; readonly pos: number }
interface Name extends Tree { readonly kind: 1; readonly text: string }
interface Pair extends Tree { readonly kind: 2; readonly left: Name }
function TreeObject(this: Mutable<Tree>, kind: number, pos: number) {
  this.kind = kind;
  this.pos = pos;
}
const TreeConstructor = TreeObject as any as new (kind: number, pos: number) => Tree;
function makeName(text: string): Name {
  const n = new TreeConstructor(1, 0) as Mutable<Name>;
  n.text = text;
  return n;
}
function makePair(left: Name): Pair {
  const n = new TreeConstructor(2, 0) as Mutable<Pair>;
  n.left = left;
  return n;
}

class Leaf {
  constructor(public kind: number, public pos: number) {}
}
interface Word extends Leaf { kind: 1; text: string }
interface Digit extends Leaf { kind: 2; value: number }
function makeWord(text: string): Word {
  const n = new Leaf(1, 0) as Word;
  n.text = text;
  return n;
}
function makeDigit(value: number): Digit {
  const n = new Leaf(2, 0) as Digit;
  n.value = value;
  return n;
}

let traps = 0;
function keysOfName(n: Name): string {
  const before = traps;
  let keys = "";
  for (const key in n) keys += key + ",";
  return keys + (traps - before);
}
function keysOfWord(n: Word): string {
  const before = traps;
  let keys = "";
  for (const key in n) keys += key + ",";
  return keys + (traps - before);
}
////= lines-19	isTree	Pair	n	instanceof	TreeConstructor
////= lines-19	isLeaf	Digit	n	instanceof	Leaf
////= lines-19	hasAbove	Name	"above"	in	n

const names = [makeName("a"), makeName("b")];
const pairs = [makePair(names[0]), makePair(names[1])];
const words = [makeWord("a"), makeWord("b")];
const digits = [makeDigit(1), makeDigit(2)];
function show(label: string): void {
  console.log(label, keysOfName(names[0]), keysOfWord(words[0]), isTree(pairs[0]), isLeaf(digits[0]), hasAbove(names[0]), keysOfName(names[1]), keysOfWord(words[1]));
}

let length = 0;
for (let r = 0; r < 20000; r++) length += keysOfName(names[r & 1]).length + keysOfWord(words[r & 1]).length + isTree(pairs[r & 1]).length + isLeaf(digits[r & 1]).length + hasAbove(names[r & 1]).length;
console.log(length);
show("untouched");

(TreeObject.prototype as any).above = 1;
(Leaf.prototype as any).above = 1;
show("a name on the prototype objects");

const counting = (target: object): object =>
  new Proxy(target, {
    ownKeys(t) { traps++; return Reflect.ownKeys(t); },
    getOwnPropertyDescriptor(t, key) { traps++; return Reflect.getOwnPropertyDescriptor(t, key); },
    getPrototypeOf(t) { traps++; return Reflect.getPrototypeOf(t); },
    has(t, key) { traps++; return Reflect.has(t, key); },
  });
delete (TreeObject.prototype as any).above;
delete (Leaf.prototype as any).above;
Object.setPrototypeOf(TreeObject.prototype, counting({ deep: 1 }));
Object.setPrototypeOf(Leaf.prototype, counting({ deep: 1 }));
show("a proxy above the prototype objects");

Object.setPrototypeOf(names[0], counting({ own: 1 }));
Object.setPrototypeOf(words[0], counting({ own: 1 }));
Object.setPrototypeOf(pairs[0], null);
Object.setPrototypeOf(digits[0], null);
show("another prototype for one object of each kind");

function Other() {}
(Other as any).prototype = counting({ foreign: 1 });
const foreignName = Reflect.construct(TreeConstructor, [1, 0], Other) as Mutable<Name>;
foreignName.text = "f";
const foreignPair = Reflect.construct(TreeConstructor, [2, 0], Other) as Mutable<Pair>;
foreignPair.left = foreignName;
const foreignWord = Reflect.construct(Leaf, [1, 0], Other) as Word;
foreignWord.text = "f";
const foreignDigit = Reflect.construct(Leaf, [2, 0], Other) as Digit;
foreignDigit.value = 3;
console.log("another new.target", keysOfName(foreignName), keysOfWord(foreignWord), isTree(foreignPair), isLeaf(foreignDigit), hasAbove(foreignName));
//// proxies-through-interfaces.ts
// Proxies of typed objects, used as `any`: every read, store, `in`, `delete` and copy reaches the traps in order, and the traps reach the object.
interface Point3 { x: number; y: number; z?: number; tag: string }
const traps: string[] = []
function flush(): string { return traps.splice(0).join(" ") }
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
function spy(target: object): any {
  return new Proxy(target, {
    get(t, k, r) { traps.push("get:" + String(k)); return Reflect.get(t, k, r) },
