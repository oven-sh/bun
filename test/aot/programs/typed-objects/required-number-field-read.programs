//// response-json-typed-objects.ts
interface Address { street: string; city: string }
interface Order { id: number; total: number; paid: boolean }
interface Customer { id: number; name: string; address: Address; tags: string[]; orders: Order[]; note: string | null }
interface Link { value: number; next: Link | null }

////= hide-2

async function show(label: string, make: () => Response) {
    try {
        const response = make();
        console.log(label, response.status, response.headers.get("content-type"), response.headers.get("x-more"), await response.text());
    } catch (error) {
        console.log(label, "throws", (error as Error).constructor.name, (error as Error).message);
    }
}

function customer(i: number): Customer {
    return { id: i, name: "customer " + i, address: { street: i + " Main Street", city: "Springfield" }, tags: ["a" + i, "b"], orders: [{ id: i * 2, total: 10.5 + i, paid: true }, { id: i * 2 + 1, total: 99 + i, paid: false }], note: i & 1 ? null : "note " + i };
}

const first = customer(1);
await show("a record", () => Response.json(first));
await show("the same record again", () => Response.json(first));
first.name = "changed";
await show("after a store", () => Response.json(first));
await show("a status", () => Response.json(customer(2), { status: 201 }));
await show("a number for the status", () => Response.json(customer(2), hide(202)));
await show("headers", () => Response.json(customer(3), { headers: { "x-more": "yes" } }));
await show("another content type", () => Response.json(customer(3), { headers: { "content-type": "text/plain" } }));
await show("a list", () => Response.json([customer(4), customer(5)]));
await show("an empty list", () => Response.json(((): Customer[] => [])()));
const wide = customer(6);
wide.name = "Ж中 😀 \ud800";
await show("16-bit text", () => Response.json(wide));
const withExtra = customer(7);
hide(withExtra).extra = 1;
await show("an extra property", () => Response.json(withExtra));
const withToJSON = customer(8);
hide(withToJSON.address).toJSON = () => "address";
await show("toJSON inside", () => Response.json(withToJSON));
const cycle: Link = { value: 1, next: null };
cycle.next = cycle;
await show("a cycle", () => Response.json(cycle));
const perhaps: (Customer | undefined | null)[] = [undefined, null, customer(9)];
for (const each of perhaps) await show("perhaps", () => Response.json(each));
await show("init that throws", () => Response.json(customer(10), { get status(): number { throw new RangeError("no status"); } }));
await show("behind a throw", () => Response.json(customer(11)));
await show("init that changes the record", () => {
    const changed = customer(12);
    return Response.json(changed, { get status() { changed.name = "changed while init was read"; return 200; } });
});
await show("JSON.stringify behind Response.json", () => {
    const value = customer(13);
    const response = Response.json(value);
    value.id = 14;
    return new Response(JSON.stringify(value) + (await0(response) ? "" : ""));
});
function await0(_: Response): boolean {
    return true;
}
const original = Response.json;
hide(Response).json = (value: unknown) => new Response("replaced " + typeof value);
await show("replaced", () => Response.json(customer(17)));
hide(Response).json = original;
await show("put back", () => Response.json(customer(18)));
let length = 0;
for (let i = 0; i < 2000; i++) length += (await Response.json(customer(i)).text()).length;
console.log("two thousand", length);
//// results-in-registers-behind-a-structure-check.ts
// A function that returns a fresh object hands its fields back in registers, and its caller reads them from the call. Where one test of a receiver's shape splits the caller into a fast and a slow copy, the call stands in both, and what follows the last access to the receiver is shared: the fields are then read behind the place where the two copies meet.
interface Item { id: number; weight: number; label: string; next: Item | null }
interface Crate { id: number; depth: number }
type Found = { x: number; y: number };
function hide(value: unknown): any { return value }
function make(i: number): Item { return { id: i + 0.5, weight: i + 1.5, label: "item" + i, next: null } }
function makeCrate(i: number): Crate { return { id: i + 0.25, depth: i + 2.25 } }
function grown(i: number): Item { const open = hide(makeCrate(i)); open.weight = i + 3.25; open.label = "crate" + i; open.next = null; return open }
let noise = 0;
function pad(k: number): void { for (let i = 0; i < 3; i++) noise = (noise * 31 + k + i) % 1000003 }
function pads(): void { pad(1); pad(2); pad(3); pad(4); pad(5); pad(6); pad(7); pad(8); pad(9); pad(10); pad(11); pad(12) }
function maybe(i: number): Found | undefined { pads(); pads(); if (Math.floor(i) % 3 === 0) return undefined; return { x: i, y: noise } }
function always(i: number): Found { pads(); pads(); return { x: i * 2, y: noise } }
function readsAtOnce(item: Item): number {
  const found = maybe(item.id);
  if (found) return found.x + found.y;
  return item.weight + item.label.length;
}
function readsBehindALoop(item: Item): number {
  const found = maybe(item.id);
  if (found) {
    for (let i = 0; i < 4; i++) pad(i);
    return found.y - found.x + noise;
  }
  return item.weight + item.label.length;
}
function readsWhatIsAlwaysThere(item: Item): number {
  const found = always(item.id);
  if (found.x > 7) return found.x + found.y;
  return item.weight + item.label.length + found.y;
}
function storesBefore(item: Item): number {
  item.weight = item.id + 1;
  const found = maybe(item.weight);
  if (found) return found.x * 2 + found.y;
  return item.weight + item.label.length;
}
const kept: { [name: string]: (item: Item) => number } = { readsAtOnce, readsBehindALoop, readsWhatIsAlwaysThere, storesBefore };
for (const name in kept) {
  for (const create of [make, grown]) {
    const results: number[] = [];
    for (let i = 0; i < 7; i++) results.push(kept[name]!(create(i)));
    console.log(name, create.name, results.join(" "));
  }
}
//// runtime-created-object-has-fields/base.ts
export class Base {
  link?: Base; other?: Base | null; word?: string; any: unknown; flag?: boolean; count?: number; big?: bigint;
  declare run: (x: number) => number; declare twice: (x: number) => number; declare name: string | undefined;
  constructor(name?: string) { this.run = x => x + 1; this.twice = x => x * 2; this.name = name; }
}
//// runtime-created-object-has-fields/heir.js
import { Base } from "./base.ts";
export class Heir extends Base {
  constructor(name) { super(name); }
}
export function viaValue(some, name) { return new some(name); }
//// runtime-created-object-has-fields/main.ts
// A class whose object is made by the run time (an heir in untyped text, `new` of a value, Reflect.construct) has the fields it is born with, each `undefined` until it is stored to.
import { Base } from "./base.ts";
import { Heir, viaValue } from "./heir.js";
function look(base: Base): string {
  return [base.link, base.other, base.word, base.any, base.flag, base.count, base.big, base.name].map(value => value === undefined ? "u" : String(value instanceof Base ? "B" : value)).join(",") + " " + base.run(1) + " " + base.twice(2) + " " + Object.keys(base).join("");
}
const made: Base[] = [new Heir("a") as Base, viaValue(Base, "b") as Base, Reflect.construct(Base, ["c"], Heir) as Base, Reflect.construct(Base, []) as Base, new Base("e")];
for (const base of made) console.log(look(base), base instanceof Heir, Object.getPrototypeOf(base) === Heir.prototype || Object.getPrototypeOf(base) === Base.prototype);
made[0].link = made[1]; made[0].any = 5; made[0].word = "w"; made[1].other = null; made[1].flag = false; made[1].count = 0; made[2].big = 7n; made[2].any = made[0];
for (const base of made) console.log(look(base));
let garbage: unknown[] = [];
for (let round = 0; round < 60; round++) { garbage = []; for (let i = 0; i < 400; i++) garbage.push(new Heir("g" + i)); }
console.log(look(garbage[399] as Base), look(made[0]), made[0].run === made[0].run, made[0].run === made[1].run);
//// same-structure-aliases.ts
// Type aliases, anonymous object types and `typeof` types with the same or overlapping structure: an object created as one is used as the others.
type PointA = { x: number; y: number }
type PointB = { x: number; y: number }
type PointC = { y: number; x: number }
type Point3 = { x: number; y: number; z: number }
type MaybeZ = { x: number; y: number; z?: number }
type Renamed = PointA
function show(o: object): string { return Object.keys(o).join() + " " + JSON.stringify(o) }
function sumA(p: PointA): number { return p.x + p.y }
function sumB(p: PointB): number { return p.x + p.y }
function sumC(p: PointC): number { return p.x * 10 + p.y }
function sumInline(p: { y: number }): number { return p.y + 1 }
function zOf(p: MaybeZ): number | undefined { return p.z }
const a: PointA = { x: 1, y: 2 }
const b: PointB = { y: 4, x: 3 }
const c: PointC = { y: 6, x: 5 }
const d: Point3 = { z: 9, x: 7, y: 8 }
const e: Renamed = { x: 10, y: 11 }
const inferred = { x: 12, y: 13 }
const template = { x: 0, y: 0, note: "t" }
type FromValue = typeof template
const f: FromValue = { note: "f", y: 15, x: 14 }
const points: PointA[] = [a, b, c, d, e, inferred, f, template]
console.log(points.map(sumA).join(), points.map(sumB).join(), points.map(sumC).join(), points.map(sumInline).join())
console.log(points.map(show).join(" ; "))

const maybes: MaybeZ[] = [a, b, c, d, e]
console.log(maybes.map(zOf).map(String).join(), maybes.map(p => "z" in p).join())
const viaMaybe: MaybeZ = a
viaMaybe.z = 3
console.log(show(a), zOf(a), (a as MaybeZ).z, sumA(a), viaMaybe === a)

function moveB(p: PointB, by: number): void { p.x += by; p.y -= by }
for (const p of points) moveB(p, 0.5)
console.log(a.x, b.y, c.x, d.z, e.y, inferred.x, f.note, template.y, points.map(sumC).join())

type Segment = { from: PointA; to: PointB }
type Route = { segments: Segment[]; isLoop: boolean }
const segment: Segment = { from: c, to: d }
const route: Route = { segments: [segment, { from: a, to: a }], isLoop: false }
console.log(route.segments.map(s => sumA(s.from) + ":" + sumB(s.to)).join(), route.segments[1].from === route.segments[1].to, segment.to === d, (segment.to as Point3).z)
segment.to = { x: -1, y: -2 }
console.log(show(segment.to), "z" in segment.to, zOf(segment.to), d.z)

// One alias name, two types, with the kinds of the fields the other way round.
function first(): string { type Local = { v: number; w: string }; const l: Local = { v: 1, w: "a" }; return show(l) + (l.v + 1) + (l.w + 1) }
function second(): string { type Local = { w: number; v: string }; const l: Local = { w: 2, v: "b" }; return show(l) + (l.v + 1) + (l.w + 1) }
console.log(first(), second())

// A field name that is a number in one type and a string in another; both are read through a third type.
type NumV = { v: number }
type StrV = { v: string }
type AnyV = { v: unknown }
const numV: NumV = { v: 1.5 }
const strV: StrV = { v: "s" }
const anyVs: AnyV[] = [numV, strV, { v: null }, { v: [1] }, { v: undefined }, { v: numV }]
console.log(anyVs.map(o => typeof o.v).join(), numV.v + 1, strV.v + 1, anyVs[5].v === numV)
numV.v = -0
strV.v = ""
console.log(anyVs.map(o => Object.is(o.v, -0) ? "-0" : JSON.stringify(o.v)).map(String).join("|"))

// The type of a parameter written in place, with the fields in another order and one more optional field each time.
function inPlace1(p: { y: number; x: number; tag?: string }): string { return p.x + "/" + p.y + "/" + p.tag }
function inPlace2(p: { tag?: string; weight?: number; x: number }): string { return p.x + "/" + p.tag + "/" + p.weight }
console.log(points.map(inPlace1).join(), points.map(inPlace2).join())
const tagged: { x: number; y: number; tag?: string } = b
tagged.tag = "late"
console.log(inPlace1(b), inPlace2(b), show(b), inPlace1(a), inPlace2(d))

let total = 0
for (let i = 0; i < 4000; i++) { const p = points[i & 7]; total += sumA(p) + sumC(p) + sumInline(p) + (zOf(maybes[i % 5]) ?? 0) }
console.log(total)
//// self-expanding-types.ts
interface Grow<T> { value: T; more?: Grow<Grow<T>> }
interface Key { key: number }
interface Holder<T> { held: T; inner?: Holder<Holder<T> & Key> }
interface Left<T> { item: T; right?: Right<T[]> }
interface Right<T> { item: T; left?: Left<T[]> }
type Pair<T> = { first: T; rest?: Pair<[T, T]> };
interface WithCall<T> { value: T; run?: () => number; more?: WithCall<WithCall<T>> }
class Made { size = 2 }
interface WithInstance<T> { value: T; made?: Made; more?: WithInstance<WithInstance<T>> }

function grow(): Grow<Key> {
  return { value: { key: 1 }, more: { value: { value: { key: 2 } } } };
}
function hold(h: Holder<Key>): Holder<Key> {
  return h;
}
function parsed<T>(text: string): T {
  return JSON.parse(text);
}

const grown = grow();
const key: Key = { key: 3 };
const held = hold({ held: key, inner: { held: Object.assign({ held: key }, key) } });
const left: Left<number> = { item: 4, right: { item: [5], left: { item: [[6]] } } };
const pair: Pair<number> = { first: 7, rest: { first: [8, 9] } };
const called: WithCall<Key> = { value: key, run: () => 10, more: { value: { value: key } } };
const instance: WithInstance<Key> = { value: key, made: new Made(), more: { value: { value: key, made: new Made() } } };
const far = parsed<Grow<Key>>('{"value":{"key":11},"more":{"value":{"value":{"key":12}},"more":{"value":{"value":{"value":{"key":13}}}}}}');

console.log(grown.value.key, grown.more?.value.value.key, held.held.key, held.inner?.held.key, held.inner?.held.held.key);
console.log(left.item, left.right?.item[0], left.right?.left?.item[0][0], pair.first, pair.rest?.first[1]);
console.log(called.run?.(), called.more?.value.value.key, instance.made?.size, instance.more?.value.made?.size);
console.log(far.value.key, far.more?.value.value.key, far.more?.more?.value.value.value.key);
//// self-referential-mapped-constraint.ts
// A type parameter can be constrained by a mapped type over itself: `F extends Selectors<F>`, as in reselect and Redux Toolkit.
type Same<T> = { [K in keyof T]: T[K] };
function count<F extends Same<F>>(table: F): number { return Object.keys(table).length; }
console.log(count({ a: 1, b: "x" }));

type Selectors<T extends Record<string, (...args: never[]) => unknown>> = { [K in keyof T]: T[K] };
function names<F extends Selectors<F>>(table: F): (keyof F)[] { return Object.keys(table) as (keyof F)[]; }
console.log(names({ one: () => 1, two: () => "2" }).join());

class Registry<F extends Same<F>> {
  constructor(public table: F) {}
  get<K extends keyof F>(key: K): F[K] { return this.table[key]; }
}
console.log(new Registry({ x: 1, y: "why" }).get("y"));

type ReadonlySame<T> = { readonly [K in keyof T]: T[K] };
function freeze<F extends ReadonlySame<F>>(table: F): F { return Object.freeze(table); }
console.log(freeze({ a: 1 }).a);

type Optional<T> = { [K in keyof T]?: T[K] };
function merge<F extends Optional<F>>(into: F, from: Optional<F>): F { return Object.assign(into, from); }
console.log(JSON.stringify(merge({ a: 1, b: 2 }, { b: 3 })));

function nested<F extends Readonly<Same<F>>>(table: F): number { return Object.keys(table).length; }
console.log(nested({ a: 1, b: 2, c: 3 }));

declare const declaredOnly: { pick: <F extends Same<F>>(table: F) => number };
console.log(typeof declaredOnly);
//// setter-only-literal.ts
////= memoizeOne-2
let built = 0;
////= rulesOf
////= describe
const described = memoizeOne(describe);

interface Sink {
  value?: number;
  seen: number;
}
function createSink(): Sink {
  const sink: Sink = {
    set value(given: number | undefined) {
      sink.seen += given ?? 0;
    },
    seen: 0,
  };
  return sink;
}
function feed(sink: Sink): number {
  sink.value = 4;
  sink.value = 5;
  return sink.seen;
}
const fed = memoizeOne(feed);
const sink = createSink();
console.log(fed(sink), sink.value, sink.seen, Object.keys(sink).join());
delete sink.value;
sink.value = 11;
console.log(sink.value, sink.seen, feed(sink), Object.keys(sink).join());
//// shadowing-builtin-property-name.ts
// An own property with the name of a built-in method (`toString`, `valueOf` ..) on an object that the program created.
function attempt(label: string, f: () => unknown) { try { console.log(label, String(f())) } catch (e) { console.log(label, (e as Error).constructor.name) } }
function anySet(o: any, k: PropertyKey, v: unknown) { o[k] = v }
interface Rec { e?: number }
interface View { e?: number; toString?: () => string }
function make(flag: boolean): Rec { return flag ? { e: 1 } : { e: 2 } }
attempt("1", () => { const o = make(true); const v: View = o; v.toString = undefined; return Object.keys(o) })
attempt("2", () => { const o = make(true); const v: View = o; v.toString = () => "own"; return String(o) + Object.keys(o) })
attempt("3", () => { const o = make(true); const v: View = o; delete v.toString; v.toString = () => "own"; return String(o) + Object.keys(o) })
attempt("4", () => { const o = make(true); return Reflect.set(o, "constructor", true, Object.create(o)) })
attempt("5", () => { const o = make(true); const d = Object.create(o); d.constructor = true; d.toString = () => "d"; return String(d) + Object.keys(d) })
attempt("6", () => { const p: any = new Proxy<Rec>({ e: 1 }, {}); p.toString = 1; return Object.keys(p) })
attempt("7", () => { const o = make(true); anySet(o, "toString", 1); anySet(o, "valueOf", o); return Object.keys(o) })
attempt("8", () => { const o = make(true); return Reflect.set(o, "toString", 1) + " " + Object.keys(o) })
attempt("9", () => { const o = make(true); return Reflect.set(o, "toString", 1, {}) })
attempt("10", () => { const o: any = { plain: 1 }; return Reflect.set(o, "constructor", true, Object.create(o)) })
attempt("11", () => { const p: any = new Proxy({ plain: 1 } as any, {}); p.toString = 1; return Object.keys(p) })
attempt("12", () => { const o = make(true); Object.defineProperty(o, "toString", { value: () => "defined", configurable: true }); return String(o) })
class K { e = 1 }
attempt("13", () => { const o = new K(); const v: View = o; v.toString = () => "own"; return String(o) + Object.keys(o) })
attempt("14", () => { const o = new K(); return Reflect.set(o, "constructor", true, Object.create(o)) })
attempt("15", () => { const o = new K(); anySet(o, "hasOwnProperty", 1); return Object.keys(o) })
//// shared-nested-built-by-assignments.ts
// An object that typed code holds is stored in an object that travels as `any` or `unknown` before a typed function first holds it. The declared
// type of the inner object is looser than the type it is read as there, but the object has everything that type requires. It stays the same
// object: a change made through one reference is seen through the other.
interface Compile { outfile: string; target?: string }
interface Loose { outfile?: string; target?: string }
interface Build { entrypoints: string[]; compile: Compile; fold?: boolean }
const madeCompile: Compile = { outfile: "made" }
const madeBuild: Build = { entrypoints: ["made"], compile: madeCompile }
const madeLoose: Loose = { target: "made" }
function hide(value: unknown): any { return value }
function out(build: Build): string { return build.entrypoints.join() + " " + build.compile.outfile + " " + build.compile.target + " " + build.fold }
console.log(out(madeBuild), madeLoose.target)
const inner: Loose = { outfile: "first" }
const outer: any = {}
outer.entrypoints = ["a"]
outer.compile = inner
const build = outer as Build
console.log(out(build))
inner.outfile = "second"
console.log(out(build), outer.compile === inner, outer === build)
//// shared-nested-depth-two.ts
// An object that typed code holds is stored in an object that travels as `any` or `unknown` before a typed function first holds it. The declared
// type of the inner object is looser than the type it is read as there, but the object has everything that type requires. It stays the same
// object: a change made through one reference is seen through the other.
interface Compile { outfile: string; target?: string }
interface Loose { outfile?: string; target?: string }
interface Build { entrypoints: string[]; compile: Compile; fold?: boolean }
const madeCompile: Compile = { outfile: "made" }
const madeBuild: Build = { entrypoints: ["made"], compile: madeCompile }
const madeLoose: Loose = { target: "made" }
function hide(value: unknown): any { return value }
function out(build: Build): string { return build.entrypoints.join() + " " + build.compile.outfile + " " + build.compile.target + " " + build.fold }
console.log(out(madeBuild), madeLoose.target)
interface Deep { above: { build: Build } }
const madeDeep: Deep = { above: { build: madeBuild } }
function deep(value: Deep): string { return out(value.above.build) }
console.log(deep(madeDeep))
const inner: Loose = { outfile: "first" }
const outer: any = { above: { build: { entrypoints: ["a"], compile: inner } } }
console.log(deep(outer))
inner.outfile = "second"
console.log(deep(outer), outer.above.build.compile === inner)
//// shared-nested-extra-and-wider-members.ts
// An object that typed code holds is stored in an object that travels as `any` before a typed function first holds it. The inner object has a
// member more than the type it is read as there, and another member is declared wider than that type allows, but holds a value that fits.
// It stays the same object.
interface Compile { outfile: string; target?: string }
interface Build { entrypoints: string[]; compile: Compile }
const madeCompile: Compile = { outfile: "made" }
const madeBuild: Build = { entrypoints: ["made"], compile: madeCompile }
function out(build: Build): string { return build.entrypoints.join() + " " + build.compile.outfile + " " + build.compile.target }
function pick(): string | undefined { return madeBuild.entrypoints.length ? "first" : undefined }
console.log(out(madeBuild))
const inner = { outfile: pick() ?? 1, extra: 1 }
const outer: any = { entrypoints: ["a"], compile: inner }
console.log(out(outer))
inner.outfile = "second"
console.log(out(outer), outer.compile === inner, inner.extra)
console.log(out({ entrypoints: ["b"], compile: { outfile: pick() ?? 1, extra: 2 } } as Build))
