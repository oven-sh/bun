//// shared-nested-with-function-member.ts
// An object that typed code holds is stored in an object that travels as `any` before a typed function first holds it. The declared type of
// the inner object is looser than the type it is read as there, and one of its members is a function. It stays the same object.
interface Task { name: string; run: () => string }
interface LooseTask { name?: string; run: () => string }
interface Job { id: number; task: Task }
const madeTask: Task = { name: "made", run: () => "ran" }
const madeJob: Job = { id: 1, task: madeTask }
const madeLoose: LooseTask = { run: () => "loose" }
function use(job: Job): string { return job.id + " " + job.task.name + " " + job.task.run() }
console.log(use(madeJob), madeLoose.run())
const inner: LooseTask = { name: "first", run: () => "inner" }
const outer: any = { id: 2, task: inner }
console.log(use(outer))
inner.name = "second"
console.log(use(outer), outer.task === inner)
//// shared-nested-with-many-members.ts
// An object that typed code holds is stored in an object literal that passes through a function returning `any` before a typed function first
// holds it. The inner object has eight or nine members, one of them a function. Its declared type is looser than the type it is read as
// there, but it has everything that type requires. It stays the same object: a change made through one reference is seen through the other.
interface Step { name: string; first: number; second: number; third: number; fourth: number; fifth: number; sixth: number; run: () => string }
interface LooseStep { name?: string; first: number; second: number; third: number; fourth: number; fifth: number; sixth: number; run: () => string }
interface Plan { id: number; step: Step }

const knownPlan: Plan = { id: 1, step: { name: "known", first: 1, second: 2, third: 3, fourth: 4, fifth: 5, sixth: 6, run: () => "ran" } }
const knownLoose: LooseStep = { first: 1, second: 2, third: 3, fourth: 4, fifth: 5, sixth: 6, run: () => "loose" }
function hide(value: unknown): any { return value }
function maybe(text: string): string | undefined { return knownPlan.id ? text : undefined }
function describe(plan: Plan): string {
  const step = plan.step
  return plan.id + " " + step.name + " " + (step.first + step.second + step.third + step.fourth + step.fifth + step.sixth) + " " + step.run()
}
console.log(describe(knownPlan), knownLoose.name, knownLoose.run())

const inner: LooseStep = { name: "first", first: 1, second: 1, third: 1, fourth: 1, fifth: 1, sixth: 1, run: () => "ran too" }
const outer = hide({ id: 2, step: inner })
console.log(describe(outer))
inner.name = "second"
console.log(describe(outer), outer.step === inner)

const wider = { name: maybe("third"), first: 1, second: 1, third: 1, fourth: 1, fifth: 1, sixth: 1, seventh: 7, run: () => "ran again" }
const other = hide({ id: 3, step: wider })
console.log(describe(other))
wider.name = "fourth"
console.log(describe(other), other.step === wider, wider.seventh)
//// shared-object-in-dictionary-cast-literal.ts
// An object that typed code holds is a property of an object literal that is cast with `as` to a type whose member is a dictionary
// (`Record<string, Compile>`). The declared type of the object is looser than the dictionary's value type, but the object has everything
// that type requires. Reading it out of the dictionary does not throw, and it stays the same object.
interface Compile { outfile: string; target?: string }
interface Loose { outfile?: string; target?: string }
interface Targets { byName: Record<string, Compile> }

const known: Targets = { byName: { first: { outfile: "known.js", target: "bun" } } }
const knownLoose: Loose = { target: "node" }
function outfileOf(targets: Targets, name: string): string { return targets.byName[name].outfile }
console.log(outfileOf(known, "first"), knownLoose.target)

const held: Loose = { outfile: "a.js" }
const targets = { byName: { held } } as Targets
console.log(outfileOf(targets, "held"))
held.outfile = "b.js"
console.log(outfileOf(targets, "held"), (targets.byName.held as unknown) === (held as unknown))
//// some-props-are-taken-by-name-and-many-optional-fields-of-the-rest-are-read.ts
// A component takes some of its props by name and the rest as one object, and reads many optional fields of that object. Most callers leave most of them out.
declare const process: { argv: string[] };
declare const console: { log(...values: any[]): void };
type Props = { children: string; onClick?: () => void; onFocus?: () => void; onBlur?: () => void; tabIndex?: number; autoFocus?: boolean; margin?: number; marginX?: number; marginY?: number; padding?: number; paddingX?: number; paddingY?: number; gap?: number; rowGap?: number; wrap?: "wrap" | "nowrap" };
let warnings = 0;
function ifNotInteger(value: number | undefined, name: string): void { if (value !== undefined && !Number.isInteger(value)) warnings += name.length; }
function box(props: Props): number {
  const { children, onClick, onFocus, onBlur, tabIndex, autoFocus, ...style } = props;
  ifNotInteger(style.margin, "margin");
  ifNotInteger(style.marginX, "marginX");
  ifNotInteger(style.marginY, "marginY");
  ifNotInteger(style.padding, "padding");
  ifNotInteger(style.paddingX, "paddingX");
  ifNotInteger(style.paddingY, "paddingY");
  ifNotInteger(style.gap, "gap");
  ifNotInteger(style.rowGap, "rowGap");
  style.wrap ??= "nowrap";
  return children.length + (onClick ? 1 : 0) + (onFocus ? 2 : 0) + (onBlur ? 4 : 0) + (tabIndex ?? 0) + (autoFocus ? 8 : 0) + style.wrap.length + (style.margin ?? 0);
}
const given: Props[] = [{ children: "a" }, { children: "bc", margin: 1 }, { padding: 2, children: "d" }, { children: "e", gap: 3, wrap: "wrap" }];
{ (globalThis as any).kept = [box, given]; const somebody: any = (globalThis as any)[JSON.parse('"somebody"')] ?? {}; somebody[JSON.parse('"something"')] = 1; Object.defineProperty(somebody, JSON.parse('"other"'), { get() { return 1; }, configurable: true }); }
const rounds = Number(process.argv[2]);
let sum = 0;
for (let i = 0; i < rounds; i++) sum += box(given[i & 3]!);
console.log(sum, warnings);
//// special-properties-read-by-host.ts
interface Row { id: number; name: string }
interface MayPrint { id: number; toString?: () => string; valueOf?: () => unknown; toJSON?: () => unknown }
class Plain { constructor(public v: number) {} }
class Printed { constructor(public v: number) {} toString() { return "Printed " + this.v; } }
class PrintedHeir extends Printed { w = 1; }
class Valued { constructor(public v: number) {} valueOf() { return this.v * 2; } }
class Both { constructor(public v: number) {} toString() { return "s" + this.v; } valueOf() { return this.v; } }
class Primitive { constructor(public v: number) {} [Symbol.toPrimitive](hint: string) { return hint + this.v; } }
class Tagged { constructor(public v: number) {} get [Symbol.toStringTag]() { return "Tagged" + this.v; } }
class OwnPrinter { toString: () => string; constructor(public v: number) { this.toString = () => "own " + this.v; } }
function hide(value: unknown): any { return value; }
let count = 0;
////= show-2	out = JSON.stringify(make()
const tag = (v: unknown) => Object.prototype.toString.call(v);
const every = (v: unknown): unknown[] => { const x = hide(v); const out: unknown[] = []; for (const f of [() => String(x), () => `${x}`, () => x + "", () => +x, () => x * 1, () => x == "1", () => x < 5, () => tag(x), () => [x].join(), () => [x, x].sort().length, () => JSON.stringify([x]), () => JSON.stringify([new Date(0), x])]) { try { out.push(f()); } catch (e) { out.push((e as Error).name); } } return out.map(o => typeof o === "number" && o !== o ? "NaN" : o); };
const row = (id: number): Row => ({ id, name: "n" + id });
show("a record", () => every(row(1)));
show("a record, again, and another", () => [every(row(1)), every(row(2))]);
show("instances", () => [new Plain(1), new Printed(2), new PrintedHeir(3), new Valued(4), new Both(5), new Primitive(6), new Tagged(7), new OwnPrinter(8)].map(every));
show("instances, again", () => [new Plain(1), new Printed(2), new PrintedHeir(3), new Valued(4), new Both(5), new Primitive(6), new Tagged(7), new OwnPrinter(8)].map(every));
show("an optional toString: absent, there, absent", () => { const a: MayPrint = { id: 1 }, b: MayPrint = { id: 2 }, c: MayPrint = { id: 3 }; b.toString = () => "field " + b.id; return [every(a), every(b), every(c), every(b), every(a)]; });
show("an optional valueOf: absent, there, absent", () => { const a: MayPrint = { id: 1 }, b: MayPrint = { id: 2 }; b.valueOf = () => 42; return [every(a), every(b), every(a)]; });
show("an optional toJSON: absent, there, absent", () => { const a: MayPrint = { id: 1 }, b: MayPrint = { id: 2 }; b.toJSON = () => "field"; return [every(a), every(b), every(a)]; });
show("an optional toString set, then deleted", () => { const a: MayPrint = { id: 1 }; const out = [every(a)]; a.toString = () => "set"; out.push(every(a)); delete a.toString; out.push(every(a)); return out; });
show("an optional toString that is undefined", () => { const a: MayPrint = { id: 1 }, b: MayPrint = { id: 2 }; a.toString = undefined; return [every(a), every(b)]; });
for (const name of ["toString", "valueOf", "toJSON"]) show("an extra " + name + ": without, with, without", () => { const a = row(1), b = row(2), c = row(3); const first = every(a); hide(b)[name] = () => "extra " + name; return [first, every(b), every(c), every(a), every(b)]; });
show("an extra Symbol.toPrimitive", () => { const a = row(1), b = row(2); const first = every(a); hide(b)[Symbol.toPrimitive] = () => "primitive"; return [first, every(b), every(a)]; });
show("an extra Symbol.toStringTag", () => { const a = row(1), b = row(2); const first = every(a); hide(b)[Symbol.toStringTag] = "Mine"; return [first, every(b), every(a)]; });
show("an extra that is deleted again", () => { const a = row(1); const out = [every(a)]; hide(a).toString = () => "extra"; out.push(every(a)); delete hide(a).toString; out.push(every(a)); return out; });
show("a prototype that gets each late and loses it", () => { const proto = JSON.parse("{}"); const a = row(1), b = row(2); Object.setPrototypeOf(a, proto); Object.setPrototypeOf(b, proto); const out = [every(a), every(b)]; proto.toString = function (this: Row) { return "late " + this.id; }; out.push(every(a), every(b)); proto.valueOf = () => 7; out.push(every(a)); proto[Symbol.toPrimitive] = () => "p"; out.push(every(b)); proto[Symbol.toStringTag] = "T"; out.push(every(a)); proto.toJSON = () => "j"; out.push(every(b)); delete proto.toString; delete proto.valueOf; delete proto[Symbol.toPrimitive]; delete proto[Symbol.toStringTag]; delete proto.toJSON; out.push(every(a), every(b)); return out; });
show("a prototype whose method is replaced", () => { const proto = JSON.parse("{}"); proto.toString = () => "first"; const a = row(1); Object.setPrototypeOf(a, proto); const out = [every(a), every(a)]; proto.toString = () => "second"; out.push(every(a)); return out; });
show("a prototype's prototype gets one late", () => { const top = JSON.parse("{}"), proto = Object.create(top); const a = row(1); Object.setPrototypeOf(a, proto); const out = [every(a)]; top.toString = () => "top"; out.push(every(a)); proto.toString = () => "nearer"; out.push(every(a)); return out; });
show("the prototype is changed", () => { const one = JSON.parse("{}"), two = JSON.parse("{}"); one.toString = () => "one"; two.toString = () => "two"; const a = row(1); const out = [every(a)]; Object.setPrototypeOf(a, one); out.push(every(a)); Object.setPrototypeOf(a, two); out.push(every(a)); Object.setPrototypeOf(a, Object.prototype); out.push(every(a)); return out; });
show("a null prototype", () => { const a = row(1); Object.setPrototypeOf(a, null); return [every(a), every(row(2))]; });
show("a typed object as the prototype of a plain one", () => { const proto: MayPrint = { id: 1 }; const child = Object.create(proto); const out = [every(child)]; proto.toString = () => "from a typed prototype"; out.push(every(child)); delete proto.toString; out.push(every(child)); return out; });
show("a typed object as the prototype of a typed one", () => { const proto: MayPrint = { id: 1 }; const a = row(1); Object.setPrototypeOf(a, proto); const out = [every(a)]; proto.toString = () => "typed above typed"; out.push(every(a)); delete proto.toString; out.push(every(a)); return out; });
show("an accessor on the prototype", () => { let n = 0; const proto = Object.defineProperty(JSON.parse("{}"), "toString", { get() { const k = ++n; return () => "got " + k; } }); const a = row(1); Object.setPrototypeOf(a, proto); return [String(a), String(a), `${hide(a)}`]; });
show("frozen, sealed, closed", () => [Object.freeze(row(1)), Object.seal(row(2)), Object.preventExtensions(row(3))].map(every));
show("many of one shape", () => { const out: string[] = []; for (let i = 0; i < 30; i++) out.push(String(row(i)) + tag(row(i)) + String(new Printed(i))); return out.join(); });
//// spread-copies-to-plain-objects.ts
// The spread of a typed object whose keys are in an expected order is copied field by field into a plain object. Every other source takes the generic path, and both give what plain Bun gives.
type Point = { x: number; y: number }
type Named = { name: string; tag?: string; point: Point }

class Vector {
  x: number
  y: number
  #secret = 7
  constructor(x: number, y: number) {
    this.x = x
    this.y = y
  }
  get length(): number {
    return Math.hypot(this.x, this.y)
  }
  secret(): number {
    return this.#secret
  }
}

function describe(label: string, copy: object): void {
  console.log(label, JSON.stringify(copy), Object.keys(copy).join(","), Object.getPrototypeOf(copy) === Object.prototype, Object.isFrozen(copy), Object.isExtensible(copy))
}

function copyPoint(point: Point): object {
  return { ...point }
}

function copyPointWithStores(point: Point, y: number, z: number): object {
  return { ...point, y, z }
}

function copyPointAfterStores(point: Point, v: number, w: number): object {
  return { v, w, ...point }
}

function copyNamed(named: Named): object {
  return { ...named, tag: "copied" }
}

function copyVector(vector: Vector): object {
  return { ...vector }
}

function copyVectorWithStore(vector: Vector, length: number): object {
  return { ...vector, length }
}

function copyNullable(point: Point | null | undefined): object {
  return { ...point }
}

const points: Point[] = []
for (let i = 0; i < 4; i++) points.push({ x: i, y: -i })
for (const point of points) {
  describe("point", copyPoint(point))
  describe("stores", copyPointWithStores(point, 10, 20))
  describe("stores first", copyPointAfterStores(point, 30, 40))
  describe("nullable", copyNullable(point))
}
describe("null", copyNullable(null))
describe("undefined", copyNullable(undefined))

const copy = copyPoint(points[1]) as Point
copy.x = 100
console.log(points[1].x, copy.x)
describe("copy of a copy", copyPoint(copy))

describe("named", copyNamed({ name: "a", point: points[0] }))
describe("named with tag", copyNamed({ name: "b", tag: "t", point: points[1] }))
describe("named in another order", copyNamed({ point: points[2], tag: "u", name: "c" }))
const shared = copyNamed({ name: "d", point: points[3] }) as Named
console.log(shared.point === points[3])

const vector = new Vector(3, 4)
describe("vector", copyVector(vector))
describe("vector with store", copyVectorWithStore(vector, -1))
console.log("length" in copyVector(vector), copyVector(vector) instanceof Vector, vector.secret())

describe("frozen", copyPoint(Object.freeze({ x: 1, y: 2 })))
describe("sealed", copyPoint(Object.seal({ x: 3, y: 4 })))
describe("not extensible", copyPoint(Object.preventExtensions({ x: 5, y: 6 })))

const extended: Point = { x: 7, y: 8 }
;(extended as any).z = 9
;(extended as any)[Symbol.for("s")] = 10
const extendedCopy = copyPoint(extended)
describe("extended", extendedCopy)
console.log((extendedCopy as any)[Symbol.for("s")])

const shortened: Point = { x: 11, y: 12 }
delete (shortened as any).x
describe("shortened", copyPoint(shortened))
;(shortened as any).x = 13
describe("restored in another order", copyPoint(shortened))

const hidden: Point = { x: 14, y: 15 }
Object.defineProperty(hidden, "x", { enumerable: false })
describe("hidden", copyPoint(hidden))

let reads = 0
const computed: Point = { x: 16, y: 17 }
Object.defineProperty(computed, "y", { get() { return ++reads }, enumerable: true })
describe("computed", copyPoint(computed))
describe("computed", copyPoint(computed))
console.log(reads)

describe("from outside", copyPoint(JSON.parse('{"y":1,"x":2,"extra":3}')))
//// spread-of-a-record-with-extra-properties.ts
// `{ ...p }` where p is a typed record that was given properties its type does not have: the copy has them too, in the same order, and shares nothing with p. Every kind of extra property that cannot be copied word by word is here as well.
interface Point {
  x: number;
  y: number;
  name: string;
  weight?: number;
}

function make(i: number): Point {
  return { x: i, y: i + 0.5, name: "p" + i };
}

function mark(p: Point, names: string[], from: number): Point {
  const open = p as unknown as Record<string, unknown>;
  for (let i = 0; i < names.length; i++) open[names[i]!] = from + i;
  return p;
}

function copy(p: Point): Point {
  return { ...p };
}

function copyAndSet(p: Point, x: number): Point {
  return { ...p, x };
}

function show(p: Point): string {
  return Object.keys(p).join() + " " + JSON.stringify(p);
}

const one = mark(make(1), ["mark"], 10);
let kept: Point = one;
let sum = 0;
for (let i = 0; i < 300; i++) {
  kept = copy(one);
  sum += kept.x + (kept as unknown as { mark: number }).mark;
}
console.log(sum, show(kept), kept === one);

(kept as unknown as { mark: number }).mark = 99;
kept.x = 7;
console.log(show(one), show(kept));
(one as unknown as { mark: number }).mark = 11;
console.log(show(one), show(kept), show(copy(kept)), show(copy(copy(one))));

for (const count of [2, 3, 5, 6, 7, 9, 20]) {
  const names: string[] = [];
  for (let i = 0; i < count; i++) names.push("extra" + i);
  const many = mark(make(count), names, 100);
  let last = many;
  for (let i = 0; i < 40; i++) last = copy(many);
  console.log(count, show(last) === show(many), Object.keys(last).length, (last as unknown as Record<string, number>)["extra" + (count - 1)]);
}

const changed = mark(make(2), ["mark"], 20);
for (let i = 0; i < 40; i++) kept = copyAndSet(changed, i);
console.log(show(kept), show(changed));

const large = mark(make(3), ["mark"], 30);
large.x = 2 ** 31 + 0.25;
large.y = -(2 ** 30) - 5;
for (let i = 0; i < 40; i++) kept = copy(large);
large.x = 1;
console.log(show(kept), show(large));

const optional = mark(make(4), ["mark"], 40);
optional.weight = 3;
for (let i = 0; i < 40; i++) kept = copy(optional);
console.log(show(kept));
const optionalFirst = make(5);
optionalFirst.weight = 4;
mark(optionalFirst, ["mark"], 50);
for (let i = 0; i < 40; i++) kept = copy(optionalFirst);
console.log(show(kept));

const symbol = Symbol("tag");
const tagged = mark(make(6), ["mark"], 60);
(tagged as unknown as Record<symbol, unknown>)[symbol] = "s";
for (let i = 0; i < 40; i++) kept = copy(tagged);
console.log(show(kept), (kept as unknown as Record<symbol, unknown>)[symbol], Object.getOwnPropertySymbols(kept).length);

const hidden = mark(make(7), ["mark"], 70);
Object.defineProperty(hidden, "secret", { value: 1, enumerable: false, writable: true, configurable: true });
for (let i = 0; i < 40; i++) kept = copy(hidden);
console.log(show(kept), "secret" in kept, "secret" in hidden);

let reads = 0;
const computed = mark(make(8), ["mark"], 80);
Object.defineProperty(computed, "now", { get() { return ++reads; }, enumerable: true, configurable: true });
for (let i = 0; i < 40; i++) kept = copy(computed);
console.log(show(kept), reads, Object.getOwnPropertyDescriptor(kept, "now")!.writable);

const indexed = mark(make(9), ["mark", "0", "7"], 90);
for (let i = 0; i < 40; i++) kept = copy(indexed);
console.log(show(kept));

const shrunk = mark(make(10), ["first", "second", "third"], 100);
delete (shrunk as unknown as Record<string, unknown>).second;
for (let i = 0; i < 40; i++) kept = copy(shrunk);
console.log(show(kept));
delete (shrunk as unknown as Record<string, unknown>).first;
delete (shrunk as unknown as Record<string, unknown>).third;
for (let i = 0; i < 40; i++) kept = copy(shrunk);
console.log(show(kept));

for (const close of [Object.freeze, Object.seal, Object.preventExtensions]) {
  const closed = mark(make(11), ["mark"], 110);
  for (let i = 0; i < 40; i++) kept = copy(closed);
  close(closed);
  for (let i = 0; i < 40; i++) kept = copy(closed);
  (kept as unknown as Record<string, unknown>).late = 1;
  kept.x = 5;
  console.log(show(kept), Object.isFrozen(kept), Object.isSealed(kept), Object.isExtensible(kept));
}

const holder = mark(make(12), ["mark"], 120);
(holder as unknown as Record<string, unknown>).inner = { deep: [1, 2] };
(holder as unknown as Record<string, unknown>).text = "t".repeat(3);
const copies: Point[] = [];
for (let i = 0; i < 5000; i++) {
  copies.push(copy(holder));
  if (i % 1000 === 999) copies.length = 10;
}
console.log(copies.length, show(copies[9]!), (copies[3] as unknown as { inner: unknown }).inner === (holder as unknown as { inner: unknown }).inner);

const bare = Object.setPrototypeOf(mark(make(13), ["mark"], 130), null) as Point;
for (let i = 0; i < 40; i++) kept = copy(bare);
console.log(show(kept), Object.getPrototypeOf(kept) === Object.prototype);
//// spread-of-wider-object-assign-result.ts
// Object.assign() returns its first argument typed as an intersection, so an object reaches a wider type
// without its own type ever being assigned to it. A spread of it followed by a property of the wider type must still work.
function show(o: unknown): string {
  return JSON.stringify(o) + " [" + Object.keys(o as object).join() + "]";
}
function row(name: string, f: () => unknown): void {
  let said: string;
  try {
    said = String(f());
  } catch (e) {
    said = "threw " + (e as Error).name;
  }
  console.log(name + ": " + said);
}

type Failures = { last: number | null; count: number };
type Fresh = { last: null; count: number };
function fresh(): Fresh {
  return { last: null, count: 0 };
}
function bump(f: Failures, n: number): Failures {
  return { ...f, last: n };
}
function merge(f: Failures, more: { last: number }): Failures {
  return { ...f, ...more };
}
const tag = Symbol("tag");

row("with a symbol key", () => {
  const copy = bump(Object.assign(fresh(), { [tag]: 1 }), 7);
  return show(copy) + " " + Object.getOwnPropertySymbols(copy).length + " " + String((copy as any)[tag]);
});
row("two spreads", () => show(merge(Object.assign(fresh(), { [tag]: 1 }), { last: 8 })));
row("the source is unchanged", () => {
  const source = Object.assign(fresh(), { [tag]: 1 });
  bump(source, 9);
  return show(source);
});
row("a copy of the copy", () => show(bump(bump(Object.assign(fresh(), { [tag]: 1 }), 1), 2)));
row("stored again later", () => {
  const copy = bump(Object.assign(fresh(), { [tag]: 1 }), 3);
  copy.last = null;
  copy.last = 4;
  return show(copy);
});
row("many times", () => {
  let sum = 0;
  for (let i = 0; i < 20000; i++) sum += bump(Object.assign(fresh(), { [tag]: i }), i).last!;
  return sum;
});
//// spread-untyped-source.ts
declare const aotOperationCount: (name: string) => number;
type Span = { start: number; end: number; label: string };
type Mark = { at: number; note: string };
type Message = { content: string; spans?: Span[] };

function measure(label: string, run: () => unknown): void {
  const before = aotOperationCount("operationAOTEnforceType");
  const result = run();
  console.log(label + ": " + JSON.stringify(result) + ": " + (aotOperationCount("operationAOTEnforceType") - before) + " conversions by the runtime");
}

function append(message: Message, added: readonly Span[]): void {
  const base = message.content.length;
  message.spans = [...(message.spans ?? []), ...added.map(span => ({ ...span, start: span.start + base }))];
}

function totalOfMovedMarks(marks: readonly Mark[]): number {
  const moved = marks.map(mark => ({ ...mark, at: mark.at + 1 }));
  let sum = 0;
  for (const mark of moved) sum += mark.at + mark.note.length;
  return sum;
}

function keysOf(value: unknown): string {
  return Object.keys(value as object).join();
}

const spanTexts = [
  '[{"start":1,"end":2,"label":"a"},{"start":3,"end":4,"label":"b"}]',
  '[{"label":"a","end":2,"start":1}]',
  '[{"start":1,"label":"a"}]',
  '[{"start":1,"end":"two","label":"a"}]',
  '[{"label":"a","end":2,"start":1,"extra":true}]',
  '[{"start":1,"end":2,"label":7}]',
  '[{"end":2,"label":"a"}]',
  '[]',
];
for (const text of spanTexts) {
  measure("copies that nothing reads by field, of " + text, () => {
    const message: Message = { content: "abc" };
    const spans: Span[] = JSON.parse(text);
    append(message, spans);
    append(message, spans);
    return [message.spans, message.spans!.map(keysOf)];
  });
}
measure("copies of objects allocated here", () => {
  const message: Message = { content: "abcd" };
  const spans: Span[] = [{ start: 1, end: 2, label: "here" }];
  append(message, spans);
  return [message.spans, message.spans!.map(keysOf)];
});
measure("copies whose fields are read", () => {
  const marks: Mark[] = JSON.parse('[{"at":1,"note":"one"},{"at":2,"note":"three"},{"note":"x","at":3}]');
  return totalOfMovedMarks(marks);
});
//// spread-untyped-source-read-by-field.ts
declare const aotOperationCount: (name: string) => number;
type Mark = { pos: number; size: number; note: string; done: boolean; extra: unknown };

function sampleMark(): Mark {
  return { pos: 0, size: 1.5, note: "sample", done: false, extra: null };
}

function totalOfMoved(marks: readonly Mark[], by: number, kept: unknown[]): number {
  const moved = marks.map(mark => ({ ...mark, pos: mark.pos + by }));
  let total = 0;
  for (const mark of moved) {
    total += mark.pos + mark.size + mark.note.length + (mark.done ? 1 : 0) + (mark.extra === null ? 1 : 0);
    kept.push(mark);
  }
  return total;
}

function totalOfMovedAndResized(marks: readonly Mark[], by: number, size: number, kept: unknown[]): number {
  const moved = marks.map(mark => ({ ...mark, size, pos: mark.pos + by }));
  let total = 0;
  for (const mark of moved) {
    total += mark.pos + mark.size + mark.note.length + (mark.done ? 1 : 0);
    kept.push(mark);
  }
  return total;
}

function totalOfPositions(marks: readonly Mark[], by: number, kept: unknown[]): number {
  const moved = marks.map(mark => ({ ...mark, pos: mark.pos + by }));
  let total = 0;
  for (const mark of moved) {
    total += mark.pos;
    kept.push(mark);
  }
  return total;
}

function show(label: string, marks: Mark[], conversions: number, totals: string, kept: unknown[]): void {
  console.log(label + ": " + totals + ": " + conversions + " conversions by the runtime");
  for (let i = 0; i < kept.length; i++) {
    const copy = kept[i] as Record<string, unknown>;
    const source = marks[i % marks.length] as unknown as Record<string, unknown>;
    console.log("  " + JSON.stringify(copy) + " | " + Object.keys(copy).join() + " | " + Object.is(copy.pos, -0) + " " + Object.is(copy.size, -0) + " " + (Object.getPrototypeOf(copy) === Object.prototype) + " " + (copy !== source) + " " + (copy.extra === source.extra) + " " + Object.isFrozen(copy) + " " + Object.getOwnPropertySymbols(copy).length);
    copy.note = "written";
    copy.added = 1;
    console.log("  " + JSON.stringify(copy));
  }
  console.log("  " + JSON.stringify(marks));
}

function reportRead(label: string, text: string): void {
  const marks: Mark[] = JSON.parse(text);
  const kept: unknown[] = [];
  const before = aotOperationCount("operationAOTEnforceType");
  const totals = totalOfMoved(marks, 1, kept) + " " + totalOfMovedAndResized(marks, 2, 7, kept);
  show(label, marks, aotOperationCount("operationAOTEnforceType") - before, totals, kept);
}

function showPositionsOnly(label: string, marks: Mark[]): void {
  const kept: unknown[] = [];
  const before = aotOperationCount("operationAOTEnforceType");
  const total = totalOfPositions(marks, 1, kept);
  show(label, marks, aotOperationCount("operationAOTEnforceType") - before, String(total), kept);
}

const parsed = (text: string): Mark[] => {
  const marks: Mark[] = JSON.parse(text);
  return marks;
};
const changed = (change: (mark: any) => void): Mark[] => {
  const marks = parsed('[{"pos":1,"size":2,"note":"n","done":true,"extra":0}]');
  change(marks[0]);
  return marks;
};

console.log(JSON.stringify(sampleMark()));
reportRead("matching data", '[{"pos":1,"size":2,"note":"one","done":true,"extra":[1]},{"pos":2,"size":2.5,"note":"two","done":false,"extra":{"a":1}}]');
reportRead("matching data in another key order", '[{"extra":"x","done":true,"note":"one","size":2,"pos":1}]');
reportRead("numbers at the edges", '[{"pos":-1,"size":-0,"note":"","done":false,"extra":-0},{"pos":1073741822,"size":1073741824,"note":"n","done":true,"extra":1e300},{"pos":-1073741825,"size":-1073741825,"note":"n","done":true,"extra":2147483648},{"pos":2147483646,"size":-2147483648,"note":"n","done":true,"extra":null}]');
reportRead("a property the type does not have", '[{"pos":1,"size":2,"note":"n","done":true,"extra":0,"more":1}]');
reportRead("an index among the properties", '[{"pos":1,"size":2,"note":"n","done":true,"extra":0,"0":1}]');
reportRead("more properties than fit in the object", '[{"pos":1,"size":2,"note":"n","done":true,"extra":0,"a":1,"b":2,"c":3,"d":4,"e":5,"f":6,"g":7,"h":8,"i":9,"j":10}]');
showPositionsOnly("the stored field is missing in the source", parsed('[{"size":2,"note":"one","done":true,"extra":0}]'));
showPositionsOnly("a required field is missing", parsed('[{"pos":1,"size":2,"done":true,"extra":0}]'));
showPositionsOnly("a number where a string belongs", parsed('[{"pos":1,"size":2,"note":3,"done":true,"extra":0}]'));
showPositionsOnly("a string where a number belongs", parsed('[{"pos":1,"size":"2","note":"n","done":true,"extra":0}]'));
showPositionsOnly("a number where a boolean belongs", parsed('[{"pos":1,"size":2,"note":"n","done":1,"extra":0}]'));
showPositionsOnly("null where a string, a number and a boolean belong", parsed('[{"pos":1,"size":null,"note":null,"done":null,"extra":null}]'));
let reads = 0;
showPositionsOnly("a getter", changed(mark => Object.defineProperty(mark, "size", { get() { return ++reads; }, enumerable: true, configurable: true })));
showPositionsOnly("a property that is not enumerable", changed(mark => Object.defineProperty(mark, "note", { enumerable: false })));
showPositionsOnly("a property that is not writable", changed(mark => Object.defineProperty(mark, "note", { writable: false })));
showPositionsOnly("a frozen source", changed(mark => Object.freeze(mark)));
showPositionsOnly("a source that cannot be extended", changed(mark => Object.preventExtensions(mark)));
showPositionsOnly("a source with another prototype", changed(mark => Object.setPrototypeOf(mark, { inherited: 1 })));
showPositionsOnly("a source without a prototype", changed(mark => Object.setPrototypeOf(mark, null)));
showPositionsOnly("a symbol among the keys", changed(mark => { mark[Symbol.iterator] = 1; }));
showPositionsOnly("a property deleted and added again", changed(mark => { delete mark.size; mark.size = 3; }));
console.log(reads);

const many = parsed("[" + Array.from({ length: 300 }, (_, i) => '{"pos":' + i + ',"size":' + (i + 0.5) + ',"note":"n' + i + '","done":' + (i % 2 === 0) + ',"extra":[' + i + "]}").join() + "]");
let total = 0;
const beforeMany = aotOperationCount("operationAOTEnforceType");
for (let round = 0; round < 40; round++) total += totalOfMoved(many, round, []);
console.log("12,000 copies: " + total + ": " + (aotOperationCount("operationAOTEnforceType") - beforeMany) + " conversions by the runtime");
