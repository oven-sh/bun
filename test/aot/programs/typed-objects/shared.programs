////: overHeld
function overHeld(a: number, b: number): Seen {
  const self = Object.create(Held)
  self.a = a
  self.b = b
  return self
}
////: rulesOf
function rulesOf(): Rules {
  built++;
  return { depth: built };
}
////: say
function say(name: string, f: () => unknown) {
  let text: string;
  try {
    text = JSON.stringify(f()) ?? "undefined";
  } catch (error) {
    text = "throws " + (error as Error).constructor.name;
  }
  console.log(name + ": " + text);
}
////: say-2
function say(label: string, work: () => unknown) {
  let text: string;
  try {
    text = JSON.stringify(work()) ?? "undefined";
  } catch (error) {
    text = "throws " + (error as Error).constructor.name;
  }
  lines.push(label + ": " + text);
}
////: say-3
function say(name: string, f: () => unknown): void {
  let said: string;
  try { said = String(f()) } catch (e) { said = "throws " + (e as Error).name }
  console.log(name + ": " + said);
}
////: show
const show = (label: string, run: () => unknown) => {
  try {
    console.log(label, run());
  } catch (error) {
    console.log(label, error instanceof TypeError ? "TypeError" : String(error));
  }
};
