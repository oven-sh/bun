////: attempt
function attempt(label: string, f: () => unknown) {
  try { console.log(label, String(f())) } catch (e) { console.log(label, (e as Error).constructor.name) }
}
////: attempt-2
const attempt = (action: () => unknown): unknown => {
  try {
    return action();
  } catch (error) {
    return "throws " + (error as Error).constructor.name;
  }
};
