row("untyped literal cast twice", () => {
  const raw = hide({ id: "s", n: 7, k: 9, sub: null }); const a = raw as Left; const b = raw as Right; a.n += 1; b.k += 1; return raw.n + " " + raw.k + " " + ((a as unknown) === (b as unknown));
});
//// type-escapes-from-several-functions.ts
// Several functions hand values of one type to a place whose type says nothing. Each function has to say so for itself: the first one of each pair is never called, so nothing it says counts. Untyped code then calls the members with plain data that fits the parameter types, and freezes two of the objects. The output must match plain Bun.
interface Point { x: number; y: number }
interface Options { origin: Point; label: string; scale?: number }
interface Handler { on(point: Point): number | string; configure(options: Options): string; name: string }
class Counter {
  count = 0;
  add(point: Point): number | string { this.count++; return point.x + point.y; }
}
type Listener = (point: Point, options: Options) => string;

const held: any[] = [];
function keep(value: any): void { held.push(value); }

function handlerNeverHandedOver(handler: Handler): void { keep(handler); }
function handlerHandedOver(handler: Handler): void { keep(handler); }
function counterNeverHandedOver(counter: Counter): void { keep(counter); }
function counterHandedOver(counter: Counter): void { keep(counter); }
function listenerNeverHandedOver(listener: Listener): void { keep(listener); }
function listenerHandedOver(listener: Listener): void { keep(listener); }
function listNeverHandedOver(list: Handler[]): void { keep(list); }
function listHandedOver(list: Handler[]): void { keep(list); }
function literalNeverHandedOver(point: Point): void { keep({ point, tags: [point] }); }
function literalHandedOver(point: Point): void { keep({ point, tags: [point] }); }

const handler: Handler = {
  on(point) { return point.x + point.y; },
  configure(options) { return options.label + ":" + options.origin.x + ":" + (options.scale ?? "none"); },
  name: "first",
};
const other: Handler = {
  on(point) { return point.y; },
  configure(options) { return String(options.origin.y); },
  name: "second",
};
const counter = new Counter();
const listener: Listener = (point, options) => point.x + "/" + options.label + "/" + options.origin.y;
const corner: Point = { x: 3, y: 4 };

handlerHandedOver(handler);
counterHandedOver(counter);
listenerHandedOver(listener);
listHandedOver([other]);
literalHandedOver(corner);

const [anyHandler, anyCounter, anyListener, anyList, anyLiteral] = held;
const parsed = (text: string): any => JSON.parse(text);
console.log(anyHandler.on(parsed('{"x":1,"y":2}')), anyHandler.on({ x: 1.5, y: 2, z: "more" }), anyHandler.name);
console.log(anyHandler.configure(parsed('{"origin":{"x":5,"y":6},"label":"parsed"}')), anyHandler.configure({ origin: { x: 8, y: 9 }, label: "literal", scale: 2 }));
console.log(anyCounter.add(parsed('{"x":1,"y":10}')), anyCounter.add({ x: 2, y: 3 }), anyCounter.count, counter.count);
console.log(anyListener(parsed('{"x":4,"y":0}'), parsed('{"label":"both","origin":{"x":0,"y":11}}')));
console.log(anyList[0].on(parsed('{"x":0,"y":12}')), anyList[0].configure({ origin: parsed('{"x":0,"y":13}'), label: "" }));
Object.freeze(anyLiteral.point);
try { corner.x = 10; } catch (error) { console.log((error as Error).constructor.name); }
console.log(corner.x, corner.y, Object.isFrozen(corner), anyLiteral.tags[0] === corner);
Object.freeze(anyCounter);
try { counter.add({ x: 1, y: 1 }); } catch (error) { console.log((error as Error).constructor.name); }
console.log(counter instanceof Counter, counter.count, Object.isFrozen(counter));
console.log(handler.on({ x: 1, y: 2 }), other.on(corner), listener(corner, { origin: corner, label: "typed" }));
//// type-only-literals-distinguish-objects.ts
// Objects are made as the parts of a union whose string literal types no expression of the program spells: the texts are put together while the program runs. Plain data and wider records that hold such a text are told apart by it. A text that is none of the union's is read as it is.
const shift = Date.now() < 1 ? 1 : 0;
function spell(reversed: string): string {
  let text = "";
  for (let i = reversed.length - 1; i >= 0; i--) text += String.fromCharCode(reversed.charCodeAt(i) + shift);
  return text;
}
const square = spell("erauqs-delaes");
const triangle = spell("elgnairt-delaes");
const accented = spell("éfac-delaes");
const arrow = spell("→-delaes");

type Circle = { kind: "circle"; size: number };
type Square = { kind: "sealed-square"; size: number; side: number };
type Triangle = { kind: "sealed-triangle"; size: number; side: number; height: number };
type Accented = { kind: "sealed-café"; size: number; side: number };
type Arrow = { kind: "sealed-→"; size: number; side: number };
type Shape = Circle | Square | Triangle | Accented | Arrow;

function describe(shape: Shape): string {
  if (shape.kind === "circle") return "circle " + shape.size;
  const rest = "height" in shape ? "height " + shape.height : "flat";
  return shape.kind + " " + shape.size + " " + shape.side + " " + rest;
}
const circle: Circle = { kind: "circle", size: 1 };
const madeHere: Shape[] = [
  circle,
  { kind: square as "sealed-square", size: 2, side: 3 },
  { kind: triangle as "sealed-triangle", size: 4, side: 5, height: 6 },
  { kind: accented as "sealed-café", size: 7, side: 8 },
  { kind: arrow as "sealed-→", size: 10, side: 11 },
];
for (const shape of madeHere) console.log(describe(shape));

const parsed: any[] = JSON.parse(
  JSON.stringify([
    { kind: square, size: 1, side: 2 },
    { kind: "circle", size: 3 },
    { kind: triangle, size: 4, side: 5, height: 6 },
    { size: 7, side: 8, kind: square },
    { kind: accented, size: 9, side: 10 },
    { kind: arrow, size: 12, side: 13 },
  ]),
);
for (const one of parsed) console.log(describe(one), Object.keys(one).join());

class Holder {
  shape: Shape = circle;
}
const holder = new Holder();
const forms: string[] = [square, square.slice(0, 3) + square.slice(3), (arrow + square).slice(arrow.length), ("<" + square + ">").slice(1, -1)];
for (const kind of forms) {
  const typedStore: any = { kind, size: 1, side: 2 };
  holder.shape = typedStore;
  console.log(describe(holder.shape), holder.shape.kind === square);
  (holder as any).shape = { kind, size: 3, side: 4 };
  console.log(describe(holder.shape));
}
for (const kind of [accented, arrow, accented.slice(0, 2) + accented.slice(2), (arrow + accented).slice(arrow.length), arrow.slice(0, 2) + arrow.slice(2)]) {
  const data: any = { kind, size: 5, side: 6 };
  holder.shape = data;
  console.log(describe(holder.shape), JSON.stringify(holder.shape).length);
  console.log(describe(loose(kind, 7) as Shape));
}
const withHeight: any = { kind: triangle, size: 5, side: 6, height: 7 };
holder.shape = withHeight;
console.log(describe(holder.shape));

function loose(kind: string, size: number) {
  return { kind, size, side: size + 1 };
}
console.log(describe(loose(square, 3) as Shape));
console.log(describe(loose(forms[1], 4) as Shape));
try { console.log((loose(spell("erauqs-delaet"), 5) as Shape).kind.length); } catch (e) { console.log("a kind with another first letter:", (e as Error).constructor.name); }
try { console.log((loose(spell("erauqs-delae"), 6) as Shape).kind.length); } catch (e) { console.log("a kind without its first letter:", (e as Error).constructor.name); }

////= lines	Tagged	tag	"sealed-tag"	count	number
const tag = spell("gat-delaes");
function show(tagged: Tagged): string {
  return tagged.tag + " " + tagged.count + " " + (tagged.tag === tag);
}
const tagged: Tagged = { tag: tag as "sealed-tag", count: 1 };
console.log(show(tagged));
(tagged as any).tag = tag.slice(0, 4) + tag.slice(4);
console.log(show(tagged));
(tagged as any).tag = spell("gat-delaet");
try { console.log(show(tagged)); } catch (e) { console.log("a tag with another first letter:", (e as Error).constructor.name); }

const stored = madeHere[1];
(stored as any).kind = forms[1];
console.log(describe(stored), describe({ ...stored }), describe(Object.assign({}, stored) as Shape));
