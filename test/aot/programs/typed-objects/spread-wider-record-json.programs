console.log("hidden", show(Reflect.ownKeys(ordered)), show(Reflect.ownKeys({ ...ordered })), ordered[kLabel], Object.prototype.propertyIsEnumerable.call(ordered, kLabel));
//// symbol-keyed-methods.ts
// Methods, accessors and static methods keyed by a constant symbol are found on receivers of a known type, through subclasses, super and interfaces.
const kRun = Symbol("run");
const kSize = Symbol("size");
const kMake = Symbol("make");
const kOnly = Symbol("only");
class Task {
  n = 2;
  label?: string;
  [kRun](by: number): number {
    return this.n * by;
  }
  get [kSize](): number {
    return this.n + 100;
  }
  set [kSize](value: number) {
    this.n = value;
  }
  static [kMake](): Task {
    return new Task();
  }
}
class Slow extends Task {
  [kRun](by: number): number {
    return super[kRun](by) + 1;
  }
  [kOnly](): string {
    return "only";
  }
}
function run(task: Task): number {
  return task[kRun](3);
}
function size(task: Task): number {
  task[kSize] = task[kSize] - 99;
  return task[kSize];
}
function has(task: Task): string {
  return [kRun in task, kSize in task, kOnly in task, Object.hasOwn(task, kRun), typeof task[kRun], task[kRun].name].join();
}
function detached(task: Task): number {
  const method = task[kRun];
  return method.call({ n: 5 } as Task, 2);
}
interface Runner {
  [kRun](by: number): number;
}
function viaInterface(runner: Runner): number {
  return runner[kRun](4);
}
(globalThis as { kept?: unknown }).kept = [run, size, has, detached, viaInterface];
const task = Task[kMake]();
const slow = new Slow();
console.log(run(task), run(slow), size(task), size(slow), has(task), has(slow), detached(task));
console.log(viaInterface(task), viaInterface(slow), viaInterface({ [kRun]: by => by * 10 }), viaInterface({ [kRun](by) { return by * 11; } }));
console.log(slow[kOnly](), Reflect.ownKeys(Task.prototype).map(String).join(), Reflect.ownKeys(Slow.prototype).map(String).join(), Reflect.ownKeys(Task).map(String).join(), Reflect.ownKeys(slow).join());
const loose: any = slow;
console.log(loose[kRun](1), loose[kSize], loose[kOnly](), delete loose[kRun], loose[kRun](1));
//// symbol-keys-that-are-not-constants.ts
// Symbols that are no constants of the program keep working as keys: made in a function or a loop, Symbol.for, a key whose type is a union of two unique symbols, well-known symbols.
function make(text: string) {
  const local = Symbol(text);
  class Tagged {
    [local]: number = 1;
    get(): number {
      return this[local];
    }
  }
  return { local, Tagged };
}
const one = make("x");
const two = make("x");
const a = new one.Tagged();
const b = new two.Tagged();
console.log(a.get(), b.get(), one.local === two.local, (a as any)[two.local], (b as any)[two.local]);
console.log(Object.getOwnPropertySymbols(a)[0] === one.local, Object.getOwnPropertySymbols(b)[0] === two.local);

const kFor = Symbol.for("shared");
const kForAgain = Symbol.for("shared");
class Registered {
  [kFor]: number = 3;
}
const registered = new Registered();
console.log(registered[kFor], (registered as any)[kForAgain], (registered as any)[Symbol.for("shared")], Symbol.keyFor(Object.getOwnPropertySymbols(registered)[0]));

const kOne = Symbol("one");
const kTwo = Symbol("two");
interface Pair {
  [kOne]: number;
  [kTwo]: number;
}
function pick(pair: Pair, key: typeof kOne | typeof kTwo): number {
  return pair[key];
}
function put(pair: Pair, key: typeof kOne | typeof kTwo, value: number) {
  pair[key] = value;
}
const pair: Pair = { [kOne]: 1, [kTwo]: 2 };
put(pair, kTwo, 20);
console.log(pick(pair, kOne), pick(pair, kTwo));

for (let i = 0; i < 2; i++) {
  const looped = Symbol("looped");
  const holder = { [looped]: i };
  console.log(holder[looped], Object.getOwnPropertySymbols(holder)[0] === looped);
}

class Iterable {
  items = [1, 2, 3];
  *[Symbol.iterator]() {
    yield* this.items;
