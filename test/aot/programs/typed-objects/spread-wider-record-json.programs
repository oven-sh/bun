}
const bump = (comment: Comment): Versioned => ({ ...comment, id: comment.id + 100, version: 2 });
console.log(JSON.stringify(comments.map(bump).slice(0, 2)), Object.keys(bump(comments[0]!)).join());
//// spread-wider-type-constant-values.ts
// Spread into a wider type where the extra members are string constants, written before and after the spread. The names are only needed on the slow path; the constant values are stored into the fresh copy.
type Shape = { name: string; sides: number; label?: string };
type Tagged = { kind: string; name: string; sides: number; label?: string; note: string };
function tagAfter(shape: Shape): Tagged { return { ...shape, kind: "after", note: "n" }; }
function tagBefore(shape: Shape): Tagged { return { kind: "before", note: "name", ...shape }; }
function tagAround(shape: Shape): Tagged { return { kind: "kind", ...shape, note: "note" }; }
const taggers: ((shape: Shape) => Tagged)[] = [tagAfter, tagBefore, tagAround];
const plain: Shape = { name: "plain", sides: 3 };
const labeled: Shape = { name: "labeled", sides: 4, label: "l" };
const backwards: Shape = { label: "b", sides: 5, name: "backwards" };
const flagged: Shape = { name: "flagged", sides: 6 };
(flagged as Shape & { extra?: number }).extra = 1;
const shapes = [plain, labeled, backwards, flagged];
for (let round = 0; round < 3; round++) {
  for (const tag of taggers) {
    for (const shape of shapes) {
      const tagged = tag(shape);
      console.log(Object.keys(tagged).join(), JSON.stringify(tagged), tagged.kind.length + tagged.note.length);
    }
  }
}
let total = 0;
for (let round = 0; round < 60000; round++) {
  const tag = taggers[round % 3];
  const shape = shapes[round & 3];
  if (tag === undefined || shape === undefined) continue;
  const tagged = tag(shape);
  total += tagged.kind.length + tagged.note.length + tagged.sides + (tagged.label?.length ?? 0);
}
console.log(total);
//// spreads-of-an-object-under-its-own-type.ts
// `{ ...state, count }` written under the type of `state` copies whatever `state` is at run time: its own enumerable properties in their order, getters read once, nothing of its prototype, and the source stays as it was.
interface State { count: number; label: string; note?: string }
class Counter { count = 1; label = "class"; step() { return this.count; } }
function describe(value: object) {
  return JSON.stringify(value) + " " + Object.keys(value).join() + " " + (Object.getPrototypeOf(value) === Object.prototype);
}
function increment(state: State): State { return { ...state, count: state.count + 1 }; }
function relabel(state: State, label: string): State { return { ...state, label }; }
function both(state: State): State { return { ...state, label: "both", count: 0 }; }
function withNote(state: State): State { return { ...state, note: "noted" }; }
function copyOnly(state: State): State { return { ...state }; }
function twoSpreads(first: State, second: State): State { return { ...first, ...second }; }
function spreadThenSpread(first: State, second: State): State { return { ...first, note: "between", ...second }; }
function unannotated(state: State) { const next = { ...state, count: 5 }; return next; }
function computedBehind(state: State, key: string): State { return { ...state, [key]: 7 }; }
function maybe(state?: State): Partial<State> { return { ...state, count: 3 }; }

const plain: State = { count: 1, label: "plain" };
console.log(describe(increment(plain)), describe(plain));
console.log(describe(relabel(plain, "new")), describe(both(plain)), describe(withNote(plain)), describe(copyOnly(plain)));
console.log(copyOnly(plain) === plain, increment(plain) === plain);

const otherOrder: State = { label: "first", count: 2 };
console.log(describe(increment(otherOrder)), describe(both(otherOrder)));

const noted: State = { count: 3, label: "noted", note: "n" };
console.log(describe(increment(noted)), describe(withNote(noted)));

const wider = { count: 4, label: "wider", extra: true };
console.log(describe(increment(wider)), describe(relabel(wider, "w")));

let reads = 0;
const computed: State = { get count() { reads++; return 10; }, label: "getter" };
const fromGetter = increment(computed);
console.log(describe(fromGetter), reads, Object.getOwnPropertyDescriptor(fromGetter, "count")!.writable, typeof Object.getOwnPropertyDescriptor(copyOnly(computed), "count")!.get);

console.log(describe(increment(new Counter())), "step" in increment(new Counter()));

const hidden: State = { count: 5, label: "hidden" };
Object.defineProperty(hidden, "label", { enumerable: false });
console.log(describe(increment(hidden)));

const frozen: State = Object.freeze({ count: 6, label: "frozen" });
const thawed = increment(frozen);
thawed.label = "thawed";
console.log(describe(thawed), Object.isFrozen(thawed), describe(frozen));

const grown: State = { count: 7, label: "grown" };
(grown as any).late = 1;
delete (grown as any).label;
console.log(describe(increment(grown)), describe(relabel(grown, "back")));

const symbol = Symbol("s");
const withSymbol: State = { count: 8, label: "symbol" };
(withSymbol as any)[symbol] = "held";
console.log((increment(withSymbol) as any)[symbol], describe(increment(withSymbol)));

const inherits: State = Object.create({ count: 1, label: "inherited" });
console.log(describe(increment(inherits)));

const parsed: State = JSON.parse('{"label":"parsed","count":9,"more":[1]}');
console.log(describe(increment(parsed)));

console.log(describe(twoSpreads(plain, noted)), describe(spreadThenSpread(plain, otherOrder)), describe(unannotated(plain)));
console.log(describe(computedBehind(plain, "count")), describe(computedBehind(plain, "other")), describe(maybe()), describe(maybe(plain)));

let state: State = { count: 0, label: "loop" };
for (let i = 0; i < 5000; i++) state = i & 1 ? increment(state) : relabel(state, i & 2 ? "a" : "bc");
console.log(describe(state));
//// state-after-failed-type-check.ts
// A failed runtime type check: what the error is and what state the program is in afterwards (nothing half done, `finally` blocks run, loops continue).
////= attempt
const hide = (v: unknown): any => v
let trace: string[] = []
function note<T>(tag: string, v: T): T { trace.push(tag); return v }
interface R { n: number; s: string }
const r: R = { n: 1, s: "s" }
attempt("a1", () => { r.n = note("rhs", hide("x")); return "stored" })
attempt("a2", () => trace.join() + " " + r.n)
function body(a: number, b: number, c: number): number { trace.push("body"); return a + b + c }
attempt("b1", () => body(1, hide("x"), 3))
attempt("b2", () => trace.includes("body"))
attempt("c1", () => {
  try { const n: number = hide("x"); return n } catch (e) {
    const error = e as Error
    return [e instanceof TypeError, e instanceof Error, e instanceof RangeError, typeof error.message, error.message.length > 0].join(" ")
  }
})
attempt("d1", () => {
  let sum = 0, failed = 0
  for (const v of [1, "2", 3, true, 5] as any[]) { try { const n: number = v; sum += n } catch { failed++ } }
  return sum + " " + failed
})
const made: R[] = []
attempt("e1", () => { try { made.push({ n: hide("x"), s: "t" }) } catch {} return made.length })
attempt("e2", () => { made.push({ n: hide(2), s: "t" }); return made.length })
attempt("f1", () => { r.n += hide("x"); return r.n })
attempt("f2", () => r.n)
class Counted { static made = 0; constructor(public n: number) { Counted.made++ } }
attempt("g1", () => new (Counted as any)("x").n)
attempt("g2", () => Counted.made)
attempt("h1", () => { trace = []; try { trace.push("try"); const s: string = hide(1); trace.push(s) } finally { trace.push("finally") } return "end" })
attempt("h2", () => trace.join())
// The failing read is in the middle of an expression that has effects on both sides.
const foreign: number[] = JSON.parse('["x"]')
let state = "before"
attempt("i1", () => { const got = (state = "left") + foreign[0] + (state = "right"); return got })
attempt("i2", () => state)
// A cast of an array looks at no element and copies nothing. The typed read of the field that does not fit throws, and nothing is changed.
const source = JSON.parse('[{"n":1,"s":"s"},{"n":"x","s":"s"}]')
const first = source[0]
attempt("i3", () => (source as R[]).length)
attempt("i3t", () => { const r: R = (source as R[])[1]; return r.n })
attempt("i4", () => source[0] === first)
attempt("j1", () => {
  let text = ""
  try { try { text += "inner "; const b: boolean = hide("x"); text += b } catch (e) { text += (e as Error).constructor.name; const n: number = hide(5); text += " outer " + n } } catch { text += " lost" }
  return text
})
// A generator and its consumer.
function* numbersOf(source: any[]): Generator<number> { for (const v of source) { const n: number = v; yield n } }
const seen: number[] = []
attempt("k1", () => { for (const n of numbersOf([1, 2, "3", 4])) seen.push(n); return "done" })
attempt("k2", () => seen.join())
async function later(v: any): Promise<string> { const n: number = v; return String(n + 1) }
Promise.allSettled([later(1), later("1")]).then(all => console.log("l1", all.map(x => x.status === "fulfilled" ? x.value : (x.reason as Error).constructor.name).join(" ")))
//// static-variables-stored-between-gcs.ts
// Variables of a module that are stored to one after the other, with collections in between, hold what was stored: the collector looks again at the neighborhood of each store.
const shell = globalThis as any;
const collect: (full: boolean) => void = shell.Bun ? (full: boolean) => shell.Bun.gc(full) : (full: boolean) => (full ? shell.fullGC() : shell.edenGC());
type Box = { id: number; label: string; inner: { n: number[] } };
function make(id: number): Box {
  return { id, label: "box" + id, inner: { n: [id, id + 1, id + 2] } };
}
function churn(n: number): number {
  let t = 0;
  for (let i = 0; i < n; i++) t += make(i).label.length;
  return t;
}
const a0 = make(0);
collect(false);
const a1 = make(1);
const a2 = make(2);
collect(false);
const t0 = churn(4000);
const a3 = make(3);
collect(true);
const a4 = make(4);
collect(false);
const a5 = make(5);
const a6 = make(6);
const a7 = make(7);
collect(false);
const t1 = churn(4000);
const a8 = make(8);
collect(false);
collect(false);
const a9 = make(9);
const b0 = [make(10), make(11)];
collect(false);
const b1 = new Map<string, Box>([["k", make(12)]]);
collect(true);
const b2 = () => make(13).id + a9.id;
collect(false);
const b3 = "text " + a8.label + churn(10);
collect(false);
let later: Box = make(14);
let laterList: Box[] = [];
function replace(round: number): void {
  later = make(100 + round);
  laterList = [later, make(200 + round)];
}
const lines: string[] = [];
for (let round = 0; round < 10; round++) {
  replace(round);
  const t = churn(3000);
  collect(round % 4 === 3);
  lines.push(round + " " + t + " " + later.label + " " + laterList.map((b) => b.inner.n.join("+")).join(","));
}
const all = [a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, ...b0, b1.get("k")!];
console.log(all.map((b) => b.label + ":" + b.inner.n.join("+")).join(" "));
console.log(t0, t1, b2(), b3);
console.log(lines.join("\n"));
//// store-after-extension-allocation.ts
// Creating an object can collect after its cell exists: a double in a number field predicted int32 needs storage in the Extension. The store to the new object that follows at once still needs its write barrier. link is the control: a field that a literal fills stays inline, however many optional fields the type has.
// The functions are called through a table, so that nothing is inlined and no allocation is removed.
interface Leaf { n: number }
interface Wide {
  first: Leaf | null
  a0?: Leaf; a1?: Leaf; a2?: Leaf; a3?: Leaf; a4?: Leaf; a5?: Leaf; a6?: Leaf; a7?: Leaf
  b0?: Leaf; b1?: Leaf; b2?: Leaf; b3?: Leaf; b4?: Leaf; b5?: Leaf; b6?: Leaf; b7?: Leaf
  c0?: Leaf; c1?: Leaf; c2?: Leaf; c3?: Leaf; c4?: Leaf; c5?: Leaf; c6?: Leaf; c7?: Leaf
  d0?: Leaf; d1?: Leaf; d2?: Leaf; d3?: Leaf; d4?: Leaf; d5?: Leaf; d6?: Leaf; d7?: Leaf
  e0?: Leaf; e1?: Leaf; e2?: Leaf; e3?: Leaf; e4?: Leaf; e5?: Leaf; e6?: Leaf; e7?: Leaf
}
interface Item { weight: number; next: Item | null }

function leaf(n: number): Leaf { return { n } }
function link(first: Leaf, last: Leaf): Wide {
  const wide: Wide = { first: null, e7: last }
  wide.first = first
  return wide
}
function unit(): Item { return { weight: 1, next: null } }
function push(head: Item | null, weight: number): Item {
  const item: Item = { weight, next: null }
  item.next = head
  return item
}
const F = { leaf, link, unit, push }

const weights: number[] = JSON.parse("[0.5,1,2.25,3,1073741824.5]")
const wides: Wide[] = []
let head: Item | null = F.unit()
for (let i = 0; i < 300; i++) {
  head = F.push(head, weights[i % weights.length] + i)
  wides.push(F.link(F.leaf(i), F.leaf(-i)))
  if (i % 50 === 49) Bun.gc(true)
}
Bun.gc(true)

let count = 0, weight = 0
for (let item: Item | null = head; item; item = item.next) {
  count++
  weight += item.weight
}
console.log(count, weight)

let first = 0, last = 0
for (const wide of wides) {
  first += wide.first!.n
  last += wide.e7!.n
}
console.log(first, last, Object.keys(wides[299]).join())
//// stored-fields-listed-in-store-order/main.ts
// With "useDefineForClassFields": false a field with an initializer is a store in the constructor, and one without is no code at all. The keys of an object come in the order of the stores, also of
// those that the constructor of the class that is extended makes first.
const seen: string[] = [];
class Base {
  n = 0;
  constructor() {
    (this as unknown as Heir).y = 5;
    seen.push(Object.keys(this).join());
    this.hook();
    seen.push(Object.keys(this).join());
  }
  hook(): void {}
}
class Heir extends Base {
  y: number | undefined;
  z = 1;
  w: string | undefined;
  v = "v";
  override hook(): void { this.w = "early"; }
}
class WithParameters extends Base {
  first = 1;
  y: number | undefined;
  constructor(public given: string, readonly other: number) { super(); seen.push(Object.keys(this).join()); }
  last = seen.length;
}
class Quiet { a = 1; b: number | undefined; c = "c"; }
class QuietHeir extends Quiet { b = 2; d = 4; }
for (const made of [new Heir(), new WithParameters("g", 7), new Quiet(), new QuietHeir()]) {
  console.log(made.constructor.name, Object.keys(made).join(), JSON.stringify(made));
}
console.log(seen.join(" | "));
