interface In15 { v15: number }
interface Tool15 { name: "t15"; run(input: In15, context: Context): number; make(): In15 }
interface In16 { v16: number }
interface Tool16 { name: "t16"; run(input: In16, context: Context): number; make(): In16 }
interface In17 { v17: number }
interface Tool17 { name: "t17"; run(input: In17, context: Context): number; make(): In17 }
type AnyTool = Tool0 | Tool1 | Tool2 | Tool3 | Tool4 | Tool5 | Tool6 | Tool7 | Tool8 | Tool9 | Tool10 | Tool11 | Tool12 | Tool13 | Tool14 | Tool15 | Tool16 | Tool17;
const tool0: Tool0 = { name: "t0", run: (input, context) => input.v0 + context.depth, make: () => ({ v0: 0 }) };
const tool1: Tool1 = { name: "t1", run: (input, context) => input.v1 + context.depth, make: () => ({ v1: 1 }) };
const tool2: Tool2 = { name: "t2", run: (input, context) => input.v2 + context.depth, make: () => ({ v2: 2 }) };
const tool3: Tool3 = { name: "t3", run: (input, context) => input.v3 + context.depth, make: () => ({ v3: 3 }) };
const tool4: Tool4 = { name: "t4", run: (input, context) => input.v4 + context.depth, make: () => ({ v4: 4 }) };
const tool5: Tool5 = { name: "t5", run: (input, context) => input.v5 + context.depth, make: () => ({ v5: 5 }) };
const tool6: Tool6 = { name: "t6", run: (input, context) => input.v6 + context.depth, make: () => ({ v6: 6 }) };
const tool7: Tool7 = { name: "t7", run: (input, context) => input.v7 + context.depth, make: () => ({ v7: 7 }) };
const tool8: Tool8 = { name: "t8", run: (input, context) => input.v8 + context.depth, make: () => ({ v8: 8 }) };
const tool9: Tool9 = { name: "t9", run: (input, context) => input.v9 + context.depth, make: () => ({ v9: 9 }) };
const tool10: Tool10 = { name: "t10", run: (input, context) => input.v10 + context.depth, make: () => ({ v10: 10 }) };
const tool11: Tool11 = { name: "t11", run: (input, context) => input.v11 + context.depth, make: () => ({ v11: 11 }) };
const tool12: Tool12 = { name: "t12", run: (input, context) => input.v12 + context.depth, make: () => ({ v12: 12 }) };
const tool13: Tool13 = { name: "t13", run: (input, context) => input.v13 + context.depth, make: () => ({ v13: 13 }) };
const tool14: Tool14 = { name: "t14", run: (input, context) => input.v14 + context.depth, make: () => ({ v14: 14 }) };
const tool15: Tool15 = { name: "t15", run: (input, context) => input.v15 + context.depth, make: () => ({ v15: 15 }) };
const tool16: Tool16 = { name: "t16", run: (input, context) => input.v16 + context.depth, make: () => ({ v16: 16 }) };
const tool17: Tool17 = { name: "t17", run: (input, context) => input.v17 + context.depth, make: () => ({ v17: 17 }) };
const all: AnyTool[] = [tool0, tool1, tool2, tool3, tool4, tool5, tool6, tool7, tool8, tool9, tool10, tool11, tool12, tool13, tool14, tool15, tool16, tool17];
function runOne(tool: AnyTool, context: Context): number {
  switch (tool.name) {
    case "t0": return tool.run(tool.make(), context);
    case "t1": return tool.run(tool.make(), context);
    case "t2": return tool.run(tool.make(), context);
    case "t3": return tool.run(tool.make(), context);
    case "t4": return tool.run(tool.make(), context);
    case "t5": return tool.run(tool.make(), context);
    case "t6": return tool.run(tool.make(), context);
    case "t7": return tool.run(tool.make(), context);
    case "t8": return tool.run(tool.make(), context);
    case "t9": return tool.run(tool.make(), context);
    case "t10": return tool.run(tool.make(), context);
    case "t11": return tool.run(tool.make(), context);
    case "t12": return tool.run(tool.make(), context);
    case "t13": return tool.run(tool.make(), context);
    case "t14": return tool.run(tool.make(), context);
    case "t15": return tool.run(tool.make(), context);
    case "t16": return tool.run(tool.make(), context);
    case "t17": return tool.run(tool.make(), context);
  }
}
interface Plain { run(input: In0, context: Context): number }
interface Other { run(input: { v0: number; more?: string }, context: Context): number }
const untagged: (Plain | Other)[] = [tool0, { run: (input: { v0: number; more?: string }, context: Context) => input.v0 * 2 + context.depth }];
type Numbered = { kind: 1; get(): string } | { kind: 2; get(): number } | { kind: 1 | 3; get(): boolean };
const numbered: Numbered[] = [{ kind: 1, get: () => "one" }, { kind: 2, get: () => 2 }, { kind: 3, get: () => true }];
const byName = new Map<string, AnyTool>(all.map(tool => [tool.name, tool]));
console.log(all.map(tool => runOne(tool, { depth: 1 })).join());
console.log(untagged.map(one => one.run({ v0: 5 }, { depth: 2 })).join(), numbered.map(one => String(one.get())).join(), runOne(byName.get("t7")!, { depth: 0 }));
//// truthiness-of-external-object-field.ts
// As truthiness-of-field-via-cast.ts, with objects from outside among the nodes. `if ((node as Declaration).symbol)`: any object passes the cast, and the read behind it is a typed read, also under `if`, `!`, `&&`, `||` and `while`. A field that the object lacks reads undefined, a getter and an inherited field answer as in plain Bun, and every falsy value of the declared kind takes the same side as in plain Bun. A field that holds another kind than `Decl` or `Other` declares throws a TypeError.
interface Sym { name: string; flags: number }
interface Base { kind: number; parent: Base | undefined }
interface Decl extends Base { symbol: Sym | undefined; locals: Map<string, Sym> | undefined; count: number; label: string; done: boolean; big: bigint; maybe: Sym | null; mixed: string | number | undefined }
interface Other extends Base { text: string }
function hasSymbol(n: Base): number { if ((n as Decl).symbol) return 1; return 2; }
function hasLocals(n: Base): number { if ((n as Decl).locals) return 1; return 2; }
function lacksSymbol(n: Base): number { if (!(n as Decl).symbol) return 1; return 2; }
function hasCount(n: Base): number { return (n as Decl).count ? 1 : 2; }
function hasLabel(n: Base): number { return (n as Decl).label ? 1 : 2; }
function isDone(n: Base): number { return (n as Decl).done ? 1 : 2; }
function hasBig(n: Base): number { return (n as Decl).big ? 1 : 2; }
function hasMaybe(n: Base): number { return (n as Decl).maybe ? 1 : 2; }
function hasMixed(n: Base): number { return (n as Decl).mixed ? 1 : 2; }
function hasText(n: Base): number { return (n as Other).text ? 1 : 2; }
function both(n: Base): number { return (n as Decl).symbol && (n as Decl).locals ? 1 : 2; }
function either(n: Base): number { return (n as Decl).symbol || (n as Other).text ? 1 : 2; }
function climbs(n: Base): number { let steps = 0; let at: Base | undefined = n; while ((at as Decl).symbol) { steps++; at = at!.parent; if (!at) break; } return steps; }
function inLoop(list: Base[]): number { let n = 0; for (let i = 0; i < list.length; i++) if ((list[i] as Decl).symbol) n++; return n; }
const sym: Sym = { name: "s", flags: 1 };
function decl(parent: Base | undefined, symbol: Sym | undefined, count: number, label: string, done: boolean, big: bigint, maybe: Sym | null, mixed: string | number | undefined): Decl {
  return { kind: 1, parent, symbol, locals: symbol ? new Map() : undefined, count, label, done, big, maybe, mixed };
}
const a = decl(undefined, sym, 1, "x", true, 1n, sym, "m");
const b = decl(a, undefined, 0, "", false, 0n, null, undefined);
const c = decl(a, sym, NaN, " ", true, -1n, sym, 0);
const d = decl(c, sym, -0, "0", false, 2n, null, "");
const e = decl(d, sym, 0.5, "false", true, 0n, sym, NaN);
const other: Other = { kind: 2, parent: a, text: "t" };
const empty: Other = { kind: 2, parent: b, text: "" };
let reads = 0;
const outside = JSON.parse('[{"kind":3,"symbol":{"name":"o","flags":0},"count":"0","label":0,"done":"no","maybe":[],"mixed":{},"text":1},{"kind":3,"symbol":0,"locals":null,"count":null,"label":[],"done":0,"big":"","text":null},{"kind":3}]') as Base[];
const withGetter = { kind: 4, parent: undefined, get symbol() { reads++; return reads % 2 ? sym : undefined; } } as Base;
const inherits = Object.create({ symbol: sym, count: 7, label: "proto" }) as Base;
const extended = decl(undefined, undefined, 0, "", false, 0n, null, undefined) as Base;
(other as any).symbol = sym;
(empty as any).count = 3;
const nodes: Base[] = [a, b, c, d, e, other, empty, ...outside, withGetter, withGetter, inherits, extended];
function tried(f: (n: Base) => number, n: Base): number | string { try { return f(n); } catch (error) { return "<" + (error as Error).constructor.name + ">"; } }
for (const f of [hasSymbol, hasLocals, lacksSymbol, hasCount, hasLabel, isDone, hasBig, hasMaybe, hasMixed, hasText, both, either, climbs])
  console.log(f.name, nodes.map(n => tried(f, n)).join(""));
try { console.log(inLoop(nodes), reads); } catch (error) { console.log("inLoop:", (error as Error).constructor.name, reads); }
//// two-int32-fields-in-one-operation.ts
// Two number fields that are kept in four bytes, read one behind the other and compared, subtracted, added or tested for equality, with every kind of number in either.
declare const console: { log(...values: unknown[]): void };
function show(value: unknown): string { return typeof value === "number" && Object.is(value, -0) ? "-0" : String(value); }
class Span { kind!: number; pos!: number; end!: number; id!: number; next!: number; line!: number; column!: number; depth!: number; }
function makeSpan(kind: number, pos: number, end: number): Span { const n = new Span(); n.kind = kind; n.pos = pos; n.end = end; n.id = 0; n.next = 0; n.line = pos >> 2; n.column = pos & 3; n.depth = kind + 1; return n; }
function less(a: Span, b: Span): boolean { return a.pos < b.pos; }
function lessOrEqual(a: Span, b: Span): boolean { return a.pos <= b.end; }
function greater(a: Span, b: Span): boolean { return a.end > b.pos; }
function same(a: Span, b: Span): boolean { return a.pos === b.pos; }
function differs(a: Span, b: Span): boolean { return a.end !== b.end; }
function looselySame(a: Span, b: Span): boolean { return a.pos == b.end; }
function isEmpty(n: Span): boolean { return n.pos === n.end; }
function width(n: Span): number { return n.end - n.pos; }
function sum(a: Span, b: Span): number { return a.pos + b.pos; }
function product(a: Span, b: Span): number { return a.pos * b.end; }
function within(a: Span, b: Span): boolean { return a.pos >= b.pos && a.end <= b.end; }
function overlap(a: Span, b: Span): number { return Math.min(a.end, b.end) - Math.max(a.pos, b.pos); }
function bits(a: Span, b: Span): number { return (a.pos & b.end) | (a.end ^ b.pos); }
function which(a: Span, b: Span): string { return a.pos < b.pos ? "before" : a.pos > b.pos ? "after" : a.pos === b.pos ? "at" : "neither"; }
const spans: Span[] = []; for (let i = 0; i < 4; i++) spans.push(makeSpan(i, i * 3 - 2, i * 5));
const odd = JSON.parse("[0, -0, 0.5, -1.5, 1073741823, 1073741824, -1073741824, -1073741825, 2147483647, 2147483648, -2147483648, -2147483649, 4294967296, 9007199254740992, 1e21, -1e300]") as number[];
odd.push(NaN, Infinity, -Infinity);
for (let i = 0; i < odd.length; i++) { const n = makeSpan(1, 1, 2); n.pos = odd[i]; n.end = odd[(i * 7 + 3) % odd.length]; spans.push(n); }
const bare = new Span(); bare.kind = 1; spans.push(bare);
const pairs: [string, (a: Span, b: Span) => unknown][] = [["less", less], ["lessOrEqual", lessOrEqual], ["greater", greater], ["same", same], ["differs", differs], ["looselySame", looselySame], ["sum", sum], ["product", product], ["within", within], ["overlap", overlap], ["bits", bits], ["which", which]];
const singles: [string, (n: Span) => unknown][] = [["isEmpty", isEmpty], ["width", width]];
for (const [name, f] of singles) console.log(name, spans.map(n => show(f(n))).join(" "));
for (const [name, f] of pairs) { let hash = 0; const row: string[] = []; for (const a of spans) { let line = ""; for (const b of spans) { const text = show(f(a, b)); line += text[0] + text[text.length - 1]; for (let i = 0; i < text.length; i++) hash = (hash * 31 + text.charCodeAt(i)) | 0; } row.push(line.slice(0, 12)); } console.log(name, hash, row.slice(0, 9).join(" ")); }
