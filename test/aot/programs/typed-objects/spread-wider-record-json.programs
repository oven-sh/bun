////= attempt
function twice(n: number): number { return n * 2 }
function shout(s: string): string { return s.toUpperCase() }
function flip(b: boolean): boolean { return !b }
const loose: any = { twice, shout, flip }
attempt("a1", () => loose.twice(4))
attempt("a2", () => loose.twice("4"))
attempt("a3", () => loose.shout("a"))
attempt("a4", () => loose.shout(5))
attempt("a5", () => loose.flip(0))
attempt("a6", () => loose.flip(false))
attempt("a7", () => loose.twice(2, "extra", {}))
// It makes no difference that the compiler can see which function is called.
attempt("a8", () => (twice as any)("4"))
attempt("a9", () => (twice as any)(4))
attempt("b1", () => twice.call(null, "4" as any))
attempt("b2", () => twice.apply(null, ["4"] as any))
attempt("b3", () => Reflect.apply(twice, null, ["4"]))
attempt("b4", () => Reflect.apply(twice, null, [4]))
attempt("b5", () => (twice.bind(null) as any)("4"))
attempt("b6", () => (twice.bind(null) as any)(4))
attempt("c1", () => (["1", "2"] as any[]).map(twice).join())
attempt("c2", () => [1, 2].map(twice).join())
class Temp {
  static made = 0
  constructor(public degrees: number) { Temp.made++ }
  add(n: number) { return this.degrees + n }
}
attempt("d1", () => new (Temp as any)("hot").degrees)
attempt("d2", () => Temp.made)
attempt("d3", () => new (Temp as any)(20).degrees)
attempt("d4", () => (new Temp(1) as any).add("2"))
attempt("d5", () => (new Temp(1) as any).add(2))
function sumAll(...ns: number[]): number { let s = 0; for (const n of ns) s += n; return s }
function withDefault(n: number = 10): number { return n + 1 }
function optional(n?: number): string { return typeof n }
attempt("e1", () => (sumAll as any)(1, 2))
attempt("e2", () => (sumAll as any)(1, "2"))
attempt("e3", () => (withDefault as any)())
attempt("e4", () => (withDefault as any)(undefined))
attempt("e5", () => (withDefault as any)("1"))
attempt("e6", () => (optional as any)())
attempt("e7", () => (optional as any)("x"))
attempt("e8", () => (optional as any)(1))
class Dial { private at = 1; set value(n: number) { this.at = n } get value(): number { return this.at } }
const dial = new Dial()
attempt("f1", () => { (dial as any).value = "x"; return "stored" })
attempt("f2", () => dial.value)
attempt("f3", () => { (dial as any).value = 5; return dial.value })
function either(v: number | string): string { return typeof v }
attempt("g1", () => (either as any)("s"))
attempt("g2", () => (either as any)(1))
attempt("g3", () => (either as any)(true))
// A closure handed out as a callback.
function adder(base: number): (n: number) => number { return (n: number) => base + n }
const handed: any = adder(1)
attempt("h1", () => handed("5"))
attempt("h2", () => handed(5))
//// typed-object-as-vm-context.ts
// node:vm makes an object the global object of a context. The object may be a typed object: its properties are listed, read and written from inside.
import vm from "node:vm";
type Sandbox = { alpha: number; beta: string };
////= lines-12	Box	alpha	3	beta	"box"
const record: Sandbox = { alpha: 1, beta: "record" };
for (const sandbox of [record, new Box()]) {
  const context = vm.createContext(sandbox);
  console.log(vm.runInContext("Object.keys(globalThis).join()", context));
  console.log(vm.runInContext("Object.getOwnPropertyNames(globalThis).filter(name => name === 'alpha' || name === 'beta').join()", context));
  console.log(vm.runInContext("let names = []; for (const name in globalThis) names.push(name); names.join()", context));
  console.log(vm.runInContext("alpha + beta", context), vm.runInContext("'alpha' in globalThis", context));
  vm.runInContext("alpha = alpha + 1; beta = beta + '!'", context);
  console.log(sandbox.alpha, sandbox.beta);
}
//// typed-reads-of-further-keys-from-objects-of-many-shapes.ts
// A typed read of a name beyond the declared type, at one place, from objects that share their declared part and differ in their further keys.
interface Named {
  id: number;
  [key: string]: unknown;
}

////= lines-32	labelOf	named	Named	unknown	named.label

function describe(value: unknown): string {
  return typeof value + ":" + String(value);
}

const made: Named[] = [];
for (let i = 0; i < 24; i++) made.push({ id: i, ["key" + (i % 6)]: i, label: i % 3 === 0 ? "text" + i : i });

function readAll(title: string): void {
  const seen: string[] = [];
  for (let round = 0; round < 3; round++) for (const named of made) if (round === 2) seen.push(describe(labelOf(named)));
  console.log(title, seen.join(" "));
}

readAll("as made");

for (let i = 0; i < made.length; i += 4) delete made[i].label;
readAll("every fourth deleted");

for (let i = 0; i < made.length; i += 4) made[i].label = i * 0.5;
readAll("put back behind the other keys");

for (let i = 1; i < made.length; i += 4) Object.defineProperty(made[i], "label", { get: () => "computed" + i, configurable: true, enumerable: true });
readAll("every fourth computed");

for (let i = 2; i < made.length; i += 4) made[i]["more" + i] = true;
readAll("a key more on every fourth");

for (let i = 3; i < made.length; i += 4) made[i].label = { toString: () => "object" + i };
readAll("objects");

for (let i = 3; i < made.length; i += 4) made[i].label = null;
readAll("null");

for (const named of made) for (let k = 0; k < 70; k++) named["many" + k] = k;
readAll("seventy keys more");

for (const named of made) Object.freeze(named);
readAll("frozen");

////= lines-11	Holder	id	0
type Labelled = Holder & { label: number };
function numberOf(holder: Labelled): number {
  return holder.label + 1;
}
const holders: Labelled[] = [];
for (let i = 0; i < 12; i++) {
  const holder = new Holder() as Labelled & Record<string, number>;
  holder["before" + (i % 4)] = i;
  holder.label = i;
  holders.push(holder);
}
let sum = 0;
for (let round = 0; round < 4; round++) for (const holder of holders) sum += numberOf(holder);
console.log("instances", sum);
for (let i = 0; i < holders.length; i += 3) holders[i].label = i + 0.25;
sum = 0;
for (let round = 0; round < 4; round++) for (const holder of holders) sum += numberOf(holder);
console.log("instances, fractions", sum);
//// typed-reads-of-properties-the-class-does-not-declare.ts
// A typed read of a name that the class does not declare, through an intersection type (the result type of Object.assign) or a cast. One place in the code sees numbers, strings, booleans, undefined, null and objects, properties kept in line and out of line, an accessor where a value was, a deleted property, a property that only the prototype has, and two classes of which one declares the name.
const lines: string[] = [];
////= say-2

////= lines-11	Holder	first	1
////= lines-12	Other	first	2	n	40
type Extended = Holder & { n: number; s: string; b: boolean; u: number | undefined; z: string | null; o: { x: number }; l: number[]; f: () => string };

function numberOf(h: Holder & { n: number }) {
  return h.n + 1;
}
function textOf(h: Holder & { s: string }) {
  return h.s + "!";
}
function flagOf(h: Holder & { b: boolean }) {
  return h.b ? "yes" : "no";
}
function maybeNumberOf(h: Holder & { u: number | undefined }) {
  return h.u === undefined ? "none" : h.u * 2;
}
function maybeTextOf(h: Holder & { z: string | null }) {
  return h.z === null ? "null" : h.z.length;
}
function innerOf(h: Holder & { o: { x: number } }) {
  return h.o.x;
}
function listOf(h: Holder & { l: number[] }) {
  return h.l.length;
}
function callOf(h: Holder & { f: () => string }) {
  return h.f();
}
function mixedOf(h: Holder & { m: number | string | boolean | null | undefined }) {
  return typeof h.m + ":" + String(h.m);
}
function numberOfEither(h: (Holder | Other) & { n: number }) {
  return h.n;
}

const make = (i: number): Extended =>
  Object.assign(new Holder(), {
    n: i % 3 ? i : i + 0.5,
    s: "s" + i,
    b: i % 2 === 0,
    u: i % 4 ? i : undefined,
    z: i % 5 ? "z".repeat(i % 7) : null,
    o: { x: i },
    l: [i, i],
    f: () => "f" + i,
  });

say("every kind, at one place each", () => {
  const seen: unknown[] = [];
  for (let i = 0; i < 12; i++) {
    const h = make(i);
    seen.push([numberOf(h), textOf(h), flagOf(h), maybeNumberOf(h), maybeTextOf(h), innerOf(h), listOf(h), callOf(h)]);
  }
  return seen;
});
say("one place, many kinds of value", () => {
  const seen: unknown[] = [];
  for (const m of [1, "two", true, null, undefined, 2.5, false, -0, "", 1e300, 7]) seen.push(mixedOf(Object.assign(new Holder(), { m })));
  return seen;
});
say("in line and out of line", () => {
  const seen: unknown[] = [];
  for (let count = 0; count < 12; count++) {
    const before: Record<string, number> = {};
    for (let i = 0; i < count; i++) before["k" + i] = i;
    const h = Object.assign(new Holder(), before, { n: count * 10 });
    seen.push(numberOf(h));
  }
  return seen;
});
say("stored again, deleted, made an accessor, made again", () => {
  const seen: unknown[] = [];
  const h = Object.assign(new Holder(), { n: 1, s: "s" });
  seen.push(numberOf(h), numberOf(h));
  h.n = 5;
  seen.push(numberOf(h));
  (h as any).n = 6.5;
  seen.push(numberOf(h));
  let reads = 0;
  Object.defineProperty(h, "n", { get() { return ++reads * 100; }, configurable: true, enumerable: true });
  seen.push(numberOf(h), numberOf(h), reads);
  Object.defineProperty(h, "n", { value: 9, writable: true, configurable: true, enumerable: true });
  seen.push(numberOf(h), textOf(h));
  delete (h as any).s;
  Object.assign(h, { s: "again" });
  seen.push(textOf(h), numberOf(h), Object.keys(h).join());
  return seen;
});
say("the prototype has it where the object does not", () => {
  const seen: unknown[] = [];
  class Based {
    first = 1;
  }
  const read = (b: Based & { n: number }) => b.n;
  (Based.prototype as any).n = 70;
  const plain = new Based() as Based & { n: number };
  const tagged = Object.assign(new Based(), { other: 1 }) as unknown as Based & { n: number };
  const own = Object.assign(new Based(), { other: 1, n: 71 });
  for (let turn = 0; turn < 3; turn++) seen.push(read(plain), read(tagged), read(own));
  (Based.prototype as any).n = 80;
  seen.push(read(plain), read(tagged), read(own));
  delete (own as any).n;
  seen.push(read(own));
  return seen;
});
say("two classes, one of which declares the name", () => {
  const seen: unknown[] = [];
  for (let turn = 0; turn < 4; turn++) {
    seen.push(numberOfEither(Object.assign(new Holder(), { n: turn, extra: 1 })));
    seen.push(numberOfEither(Object.assign(new Other(), { extra: 1 })));
    seen.push(numberOfEither(Object.assign(new Other(), { n: turn + 100, extra: 1 })));
  }
  return seen;
});
say("many objects, so that collections fall between the reads", () => {
  let sum = 0;
  let text = 0;
  for (let i = 0; i < 30000; i++) {
    const h = make(i);
    sum += numberOf(h) + innerOf(h) + listOf(h);
    text += textOf(h).length + callOf(h).length;
  }
  return [sum, text];
});

console.log(lines.join("\n"));
//// typed-record-given-another-prototype.ts
// Object.setPrototypeOf(o, p) where o is a typed record that has been seen since it was made, as Express does with a request and a response when node:http's own objects have layouts. It went to the runtime every time. What the change does to a typed record follows from the Structure before and the prototype alone (the Structure after; whether reads of absent fields must ask the chain), so the stub that calls the host function remembers it, for layouts no object of which has ever been anybody's prototype. Every case below where more decides is tried AFTER the pair has been remembered.
const attempt = function (what: string, run: () => any): void { try { console.log(what + ":", run()); } catch (error: any) { console.log(what + ":", error.constructor.name); } };
interface Message { url: string; size: number; inner: { a: number }; note?: string; code?: number }
function makeMessage(size: number): Message { return { url: "/" + size, size, inner: { a: size } }; }
const kept: Message[] = [];
for (let i = 0; i < 400; i++) kept.push(makeMessage(i));
let typedSum = 0;
for (const m of kept) typedSum += m.size + m.url.length + m.inner.a + (m.note ?? "").length + (m.code ?? 0);
console.log(typedSum);
const loose: any[] = (function (list: any): any { return list; })(kept);
const parent: any = { kind: "parent", note: "inherited", greet(this: any): string { return "hello " + this.url; } };
const other: any = { kind: "other", code: 7, greet(this: any): string { return "bye " + this.url; } };
const adopt = function (o: any, p: any): any { return Object.setPrototypeOf(o, p); };
const look = function (o: any): string { return [o.url, o.size, o.inner.a, o.note, o.code, o.kind, typeof o.greet === "function" ? o.greet() : "-", Object.keys(o).join()].join(" "); };
let sum = 0;
for (let i = 0; i < 200; i++) { const o = loose[i]; sum += (adopt(o, parent) === o ? 1 : 0) + (Object.getPrototypeOf(o) === parent ? 1 : 0) + o.greet().length + String(o.note).length; }
console.log(sum);
console.log(look(loose[0]), "|", look(loose[199]), "|", look(loose[200]));
let typedAgain = 0;
for (const m of kept) typedAgain += m.size + (m.note ?? "none").length + (m.code ?? 1);
console.log(typedAgain);
attempt("another prototype", function (): any { return look(adopt(loose[201], other)); });
attempt("there and back", function (): any { const o = loose[202]; adopt(o, parent); adopt(o, other); adopt(o, parent); return look(o); });
attempt("back to Object.prototype", function (): any { const o = loose[203]; adopt(o, parent); adopt(o, Object.prototype); return look(o); });
attempt("the same twice", function (): any { const o = loose[204]; adopt(o, parent); adopt(o, parent); return look(o); });
attempt("null", function (): any { const o = adopt(loose[205], null); return [o.url, o.note, Object.getPrototypeOf(o)].join(" "); });
attempt("its optional field is set first", function (): any { const o = loose[206]; o.note = "own"; adopt(o, parent); return look(o); });
attempt("and deleted afterwards", function (): any { const o = loose[206]; delete o.note; return look(o); });
attempt("a property beyond the layout first", function (): any { const o = loose[207]; o.extra = 1; adopt(o, parent); return look(o); });
attempt("again with that property", function (): any { let out = ""; for (let i = 208; i < 212; i++) { const o = loose[i]; o.extra = i; adopt(o, parent); out += o.extra + o.kind + " "; } return out; });
attempt("a property beyond the layout afterwards", function (): any { const o = loose[212]; adopt(o, parent); o.late = 2; return look(o); });
attempt("not extensible", function (): any { return look(adopt(Object.preventExtensions(loose[213]), parent)); });
attempt("sealed", function (): any { return look(adopt(Object.seal(loose[214]), parent)); });
attempt("frozen", function (): any { return look(adopt(Object.freeze(loose[215]), parent)); });
attempt("through a value", function (): any { const set: any = (function (f: any): any { return f; })(Object.setPrototypeOf); let out = 0; for (let i = 216; i < 240; i++) out += set(loose[i], parent).greet().length; return out; });
attempt("the prototype gets a name later", function (): any { parent.added = "yes"; return [loose[0].added, loose[216].added, loose[300].added].join(" "); });
attempt("the prototype loses the inherited name", function (): any { delete parent.note; const o = adopt(loose[240], parent); return [o.note, loose[0].note].join(" "); });
attempt("a proxy as the prototype", function (): any { const seen: string[] = []; const p = new Proxy(other, { get(target: any, key: any, receiver: any): any { seen.push(String(key)); return Reflect.get(target, key, receiver); } }); const o = adopt(loose[241], p); return [o.kind, o.url, seen.join()].join(" "); });
attempt("many prototypes", function (): any { const all: any[] = []; for (let i = 0; i < 40; i++) all.push({ id: i }); let total = 0; for (let round = 0; round < 3; round++) for (let i = 0; i < 40; i++) total += adopt(loose[250 + i], all[i]).id; return total; });
