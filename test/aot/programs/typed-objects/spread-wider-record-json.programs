//// stores-into-an-environment-that-is-copied-out-of-the-frame-and-every-pass-is-verified.ts
// The scope of `counts` lies in the frame, and is copied to the heap only where `attempt` is no longer the function it was: a direct eval could have replaced it. The stores behind that go to the scope or to its copy, and both are objects that `counts` has made.
function attempt(f: () => unknown): string {
  try {
    return String(f());
  } catch (e) {
    return (e as Error).constructor.name;
  }
}
function evaluates(text: string): unknown {
  return eval(text);
}
function counts(mode: number): string {
  const out: string[] = [];
  const get = () => count + ":" + flag + ":" + ratio;
  const set = () => {
    count = 7;
  };
  if (mode === 0) out.push(attempt(get), attempt(set));
  let count = 1,
    flag = true,
    ratio = 1.5;
  out.push(get());
  set();
  out.push(get());
  return out.join();
}
console.log(counts(0), counts(1), evaluates("1 + 1"));
//// stores-through-interfaces.ts
// Typed stores to objects that cannot take them because they are frozen, sealed or non-extensible, and the order of receiver, right-hand side and store.
interface Settings { volume: number; theme: string; muted?: boolean; limits: { max: number } }
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
function show(s: Settings): string { return [s.volume, s.theme, String(s.muted), s.limits.max, Object.keys(s).join("")].join("/") }
function applyTo(s: Settings, v: number): string {
  return [attempt(() => (s.volume = v)), attempt(() => (s.theme = "t" + v)), attempt(() => (s.muted = v > 1)), attempt(() => (s.limits.max += v)), attempt(() => (s.limits = { max: v }))].join()
}
function fresh(theme: string): Settings { return { volume: 1, theme, limits: { max: 1 } } }
const compiled: Settings = { volume: 1, theme: "c", limits: { max: 1 } }
console.log(applyTo(compiled, 2), show(compiled))
const frozen: Settings = Object.freeze(fresh("f"))
const sealed: Settings = Object.seal(fresh("s"))
const closedUp: Settings = Object.preventExtensions(fresh("p"))
console.log(applyTo(frozen, 7), show(frozen))
console.log(applyTo(sealed, 8), show(sealed))
console.log(applyTo(closedUp, 9), show(closedUp), attempt(() => delete closedUp.muted), Object.isFrozen(frozen), Object.isSealed(sealed), Object.isExtensible(closedUp))
// Parsed JSON used as the type.
const text = '{"volume":1,"theme":"j","limits":{"max":1}}'
const parsed: Settings = JSON.parse(text)
console.log(applyTo(parsed, 3), show(parsed))
// The receiver is evaluated before the right-hand side, the store happens after it.
let current: Settings = compiled
function swap(): number { current = parsed; return 21 }
current.volume = swap()
console.log(compiled.volume, parsed.volume, current === parsed)
const late: Settings = { volume: 0, theme: "late", limits: { max: 0 } }
console.log(attempt(() => { late.volume = (Object.freeze(late), 5) }), late.volume, attempt(() => { late.limits.max = (Object.freeze(late.limits), 5) }), late.limits.max)
const all: Settings[] = [compiled, parsed, sealed, closedUp, fresh("x")]
let sum = 0
for (let i = 0; i < 100; i++) { const s = all[i % all.length]; s.volume = i; s.limits.max = i; sum += s.volume + s.limits.max }
console.log(sum)
//// stores-to-frozen-and-readonly.ts
// Stores to fields of class instances and records that some other part of the program may have frozen, sealed, or given single read-only properties: a store to a read-only
// property throws a TypeError and leaves the value as it was; a store to a property that is still writable goes through, whatever else has been done to the object; numbers,
// integers, booleans, strings, objects and null are stored alike. What freezes takes a value of no type, so nothing in the types says which objects it may reach.
const lines: string[] = [];
class Point { x: number; y: number; count: number; label: string; on: boolean; next: Point | null; tags: string[];
  constructor(x: number, y: number) { this.x = x; this.y = y; this.count = 0; this.label = "p"; this.on = false; this.next = null; this.tags = []; } }
interface Entry { key: string; weight: number; hits: number; live: boolean; owner: Point | null }
function freezeAnything(value: any): void { Object.freeze(value); }
function sealAnything(value: any): void { Object.seal(value); }
function closeAnything(value: any): void { Object.preventExtensions(value); }
function lockOne(value: any, name: string): void { Object.defineProperty(value, name, { writable: false }); }
function setX(p: Point, v: number): void { p.x = v; }
function setY(p: Point, v: number): void { p.y = v * 1.5; }
function setCount(p: Point, v: number): void { p.count = v | 0; }
function setLabel(p: Point, v: string): void { p.label = v; }
function setOn(p: Point, v: boolean): void { p.on = v; }
function setNext(p: Point, v: Point | null): void { p.next = v; }
function setTags(p: Point, v: string[]): void { p.tags = v; }
function setAll(p: Point, n: number, other: Point): void { p.x = n + 0.25; p.y = n / 3; p.count = n | 0; p.label = "all" + n; p.on = n > 2; p.next = other; }
function setWeight(e: Entry, v: number): void { e.weight = v; }
function setHits(e: Entry, v: number): void { e.hits = (e.hits + v) | 0; }
function setKey(e: Entry, v: string): void { e.key = v; }
function setLive(e: Entry, v: boolean): void { e.live = v; }
function setOwner(e: Entry, v: Point | null): void { e.owner = v; }
function show(p: Point): string { return [p.x, p.y, p.count, p.label, p.on, p.next === null ? "null" : p.next.label, p.tags.length].join(","); }
function showEntry(e: Entry): string { return [e.key, e.weight, e.hits, e.live, e.owner === null ? "null" : e.owner.label].join(","); }
function attempt(what: string, act: () => void): void { try { act(); lines.push(what + ": stored"); } catch (error) { lines.push(what + ": " + (error instanceof TypeError ? "TypeError " + (error as Error).message : "another error")); } }
const other = new Point(9, 9); other.label = "other";
const kinds: [string, (value: any) => void][] = [["plain", () => {}], ["frozen", freezeAnything], ["sealed", sealAnything], ["closed", closeAnything],
  ["x locked", value => lockOne(value, "x")], ["label locked", value => lockOne(value, "label")], ["next locked", value => lockOne(value, "next")],
  ["count locked, then sealed", value => { lockOne(value, "count"); sealAnything(value); }]];
for (const [kind, alter] of kinds) {
  const p = new Point(1, 2);
  for (let warm = 0; warm < 3; warm++) { setX(p, warm); setY(p, warm); setCount(p, warm); setLabel(p, "w" + warm); setOn(p, warm === 1); setNext(p, warm === 1 ? other : null); }
  alter(p);
  attempt(kind + " x", () => setX(p, 10.5)); attempt(kind + " y", () => setY(p, 4)); attempt(kind + " count", () => setCount(p, 7)); attempt(kind + " label", () => setLabel(p, "new"));
  attempt(kind + " on", () => setOn(p, true)); attempt(kind + " next", () => setNext(p, other)); attempt(kind + " tags", () => setTags(p, ["a", "b"])); attempt(kind + " all", () => setAll(p, 5, other));
  lines.push(kind + " = " + show(p) + " | " + Object.keys(p).join(" ") + " | " + Object.isFrozen(p) + " " + Object.isSealed(p) + " " + Object.isExtensible(p));
}
for (const [kind, alter] of [["plain", () => {}], ["frozen", freezeAnything], ["weight locked", (value: any) => lockOne(value, "weight")], ["owner locked", (value: any) => lockOne(value, "owner")]] as [string, (value: any) => void][]) {
  const e: Entry = { key: "k", weight: 1.5, hits: 0, live: false, owner: null };
  setWeight(e, 2.5); setHits(e, 1); alter(e);
  attempt(kind + " weight", () => setWeight(e, 3.75)); attempt(kind + " hits", () => setHits(e, 2)); attempt(kind + " key", () => setKey(e, "k2")); attempt(kind + " live", () => setLive(e, true)); attempt(kind + " owner", () => setOwner(e, other));
  lines.push(kind + " = " + showEntry(e));
}
let total = 0; const many: Point[] = []; for (let i = 0; i < 200; i++) { const p = new Point(i, i); if (i % 7 === 3) freezeAnything(p); many.push(p); }
for (let round = 0; round < 5; round++) for (const p of many) { try { setX(p, p.x + 1); setCount(p, p.count + 1); total++; } catch { total += 1000; } }
lines.push("total " + total + " " + many.reduce((sum, p) => sum + p.x + p.count, 0));
console.log(lines.join("\n"));
//// stores-under-read-only-properties-of-every-kind/main.ts
// Stores onto instances of typed classes under a read-only property of every kind of value, on the class's own prototype and on the one above; a method made read-only; a frozen and a sealed prototype above;
// by name, by key, by Object.assign, Reflect.set, spread and definition; from strict and from sloppy code.
import * as sloppy from "./sloppy.cjs";

const lines: string[] = [];
function show(value: unknown): string {
  if (typeof value === "function") return "function";
  if (typeof value === "symbol") return String(value);
  return JSON.stringify(value) ?? "undefined";
}
function say(label: string, work: () => unknown) {
  let text: string;
  try {
    text = show(work());
  } catch (error) {
    text = "throws " + (error as Error).constructor.name + ": " + (error as Error).message;
  }
  lines.push(label + ": " + text);
}
const own = (object: object) => Reflect.ownKeys(object).map(String).join();
const key = (text: string) => text.split("").join("");
let log = "";

type Loose = { free: unknown; method: unknown; [key: string]: unknown };

function everyStore(title: string, make: () => object) {
  for (let round = 0; round < 2; round++) {
    const at = title + " " + round + " ";
    say(at + "any", () => { const c: any = make(); c.free = 4; return [own(c), c.free]; });
    say(at + "cast", () => { const c = make() as Loose; c.free = 4; return [own(c), c.free]; });
    say(at + "number", () => { const c = make() as { free: number }; c.free = 4.5; return [own(c), c.free]; });
    say(at + "keyed", () => { const c: any = make(); c[key("free")] = 4; return [own(c), c.free]; });
    say(at + "assign", () => { const c: any = make(); Object.assign(c, { free: 4 }); return [own(c), c.free]; });
    say(at + "assign two", () => { const c: any = make(); try { Object.assign(c, { before: 1, free: 4, after: 2 }); } catch (error) { return ["threw", own(c)]; } return [own(c), c.free]; });
    say(at + "assign parsed", () => { const c: any = make(); Object.assign(c, JSON.parse('{"free":4}')); return [own(c), c.free]; });
    say(at + "reflect", () => { const c: any = make(); return [Reflect.set(c, "free", 4), own(c), c.free]; });
    say(at + "spread", () => { const c: any = { ...make(), free: 4 }; return [own(c), c.free]; });
    say(at + "define", () => { const c: any = make(); Object.defineProperty(c, "free", { value: 4, writable: true, enumerable: true, configurable: true }); return [own(c), c.free]; });
    say(at + "add", () => { const c: any = make(); c.free += 1; return [own(c), c.free]; });
    say(at + "default", () => { const c: any = make(); c.free ??= 4; return [own(c), c.free]; });
    say(at + "pattern", () => { const c: any = make(); ({ free: c.free } = { free: 4 }); return [own(c), c.free]; });
    say(at + "method", () => { const c: any = make(); c.method = () => "own"; return [own(c), c.method()]; });
    say(at + "method cast", () => { const c = make() as Loose; c.method = 5; return [own(c), c.method]; });
    say(at + "method assign", () => { const c: any = make(); Object.assign(c, { method: 5 }); return [own(c), c.method]; });
    say(at + "sloppy", () => { const c = make(); return [sloppy.storeByName(c, 4), own(c)]; });
    say(at + "sloppy keyed", () => { const c = make(); return [sloppy.storeByKey(c, key("free"), 4), own(c)]; });
    say(at + "sloppy method", () => { const c = make(); return [sloppy.storeMethod(c, 4), own(c)]; });
    say(at + "sloppy assign", () => { const c = make(); return [sloppy.assign(c, { free: 4 }), own(c)]; });
    say(at + "sloppy add", () => { const c = make(); return [sloppy.add(c), own(c)]; });
  }
}

const everyKind: [string, unknown][] = [["text", "read only"], ["number", 7], ["function", () => 1], ["object", { a: 1 }], ["null", null], ["undefined", undefined], ["true", true]];
class KindsAbove { zero = 0; method() { return "declared"; } }
class Kinds extends KindsAbove { first = 1; other() { return "other"; } }
for (const [kind, value] of everyKind) {
  Object.defineProperty(Kinds.prototype, "free", { value, writable: false, configurable: true });
  everyStore("read-only " + kind, () => new Kinds());
  delete (Kinds.prototype as any).free;
  Object.defineProperty(KindsAbove.prototype, "free", { value, writable: false, configurable: true });
  everyStore("read-only above " + kind, () => new Kinds());
  delete (KindsAbove.prototype as any).free;
}
everyStore("every kind deleted", () => new Kinds());
say("writable again", () => { Object.defineProperty(KindsAbove.prototype, "free", { value: 1, writable: false, configurable: true }); Object.defineProperty(KindsAbove.prototype, "free", { writable: true }); return 1; });
everyStore("writable again", () => new Kinds());
say("the method above made read-only", () => { Object.defineProperty(KindsAbove.prototype, "method", { writable: false }); return 1; });
everyStore("the method above made read-only", () => new Kinds());

class FrozenAbove { zero = 0; method() { return "declared"; } }
class FrozenBelow extends FrozenAbove { first = 1; }
everyStore("before the class above is frozen", () => new FrozenBelow());
say("freeze the class above", () => Object.isFrozen(Object.freeze(FrozenAbove.prototype)));
everyStore("only the class above is frozen", () => new FrozenBelow());
say("what the frozen prototype shows", () => [own(FrozenAbove.prototype), Object.getOwnPropertySymbols(FrozenAbove.prototype).length, Object.isSealed(FrozenAbove.prototype), JSON.stringify(Object.getOwnPropertyDescriptors(FrozenAbove.prototype))]);
everyStore("a plain heir of the frozen prototype", () => Object.create(FrozenAbove.prototype));

class SealedAbove { zero = 0; method() { return "declared"; } }
class SealedBelow extends SealedAbove { first = 1; }
say("seal the class above", () => [Object.isSealed(Object.seal(SealedAbove.prototype)), Object.isFrozen(SealedAbove.prototype)]);
everyStore("the class above is sealed", () => new SealedBelow());

say("the log", () => log);
console.log(lines.join("\n"));
//// stores-under-read-only-properties-of-every-kind/sloppy.cjs
////= lines-30	storeByName	free
exports.storeMethod = function (object, value) {
  object.method = value;
  return typeof object.method;
};
exports.storeByKey = function (object, key, value) {
  object[key] = value;
  return object[key];
};
exports.assign = function (object, source) {
  Object.assign(object, source);
  return object.free;
};
exports.add = function (object) {
  object.free += 1;
  return object.free;
};
//// string-and-mixed-enums.ts
// String enums, unions of literals, const enums, mixed enums, and numeric enums used as discriminants.
enum Color { Red = "red", Green = "green", Blue = "BLUE", Empty = "" }
enum Level { Debug, Info, Warn = 10, Error, Off = -1 }
enum Mixed { No = 0, Yes = "YES", Maybe = 2 }
const enum Dir { Up = "up", Down = "down" }
type Align = "left" | "right" | "center"
type Digit = 0 | 1 | 2
interface Styled { color: Color; level: Level; align: Align; digit: Digit; mixed: Mixed; dir?: Dir; on: true | "auto" | 0 }
function show(o: object): string { return Object.keys(o).join() + " " + JSON.stringify(o) }

const st: Styled = { color: Color.Blue, level: Level.Warn, align: "center", digit: 2, mixed: Mixed.Yes, on: "auto" }
console.log(show(st), st.color, st.level, st.align, st.digit, st.mixed, st.dir, st.on)

// They are real strings and numbers as soon as anyone looks.
console.log(typeof st.color, st.color.length, st.color.toLowerCase(), st.color + "!", st.color[0], st.color === "BLUE" as Color, st.color > Color.Green, `${st.color}/${st.align}`, st.align.toUpperCase(), st.align.charCodeAt(0), [st.color, st.align].join("-"))
console.log(typeof st.level, st.level + 1, st.level * 0.5, st.level.toFixed(1), st.digit + st.digit, -st.digit, st.digit / 4, Level[st.level], String(st.mixed) + typeof st.mixed, Color.Empty.length, !Color.Empty, Color.Empty || "fallback")

// Every member through one field.
const seen: string[] = []
for (const c of [Color.Red, Color.Green, Color.Blue, Color.Empty]) { st.color = c; seen.push(st.color + ":" + st.color.length) }
for (const l of [Level.Debug, Level.Info, Level.Warn, Level.Error, Level.Off]) { st.level = l; seen.push(l + "=" + Level[st.level]) }
for (const m of [Mixed.No, Mixed.Yes, Mixed.Maybe]) { st.mixed = m; seen.push(typeof st.mixed + st.mixed) }
for (const v of [true, "auto", 0] as const) { st.on = v; seen.push(typeof st.on + String(st.on) + (st.on ? "T" : "F")) }
for (const d of [0, 1, 2] as const) { st.digit = d; seen.push(String(st.digit * 2)) }
console.log(seen.join())

// A string built at run time is the same value as the literal.
function build(parts: string[]): string { return parts.join("") }
const built = build(["ri", "ght"])
if (built === "left" || built === "right" || built === "center") st.align = built
const parsedColor: string = JSON.parse('"green"')
if (parsedColor === Color.Green) st.color = parsedColor
console.log(st.align, st.align === "right", st.color, st.color === Color.Green, st.color === build(["gre", "en"]), new Set<string>([st.align, "right", build(["right"])]).size)

// switch, with fall-through and default.
function paint(c: Color): number { switch (c) { case Color.Red: return 1; case Color.Green: case Color.Blue: return 2; case Color.Empty: return 3 } }
function side(a: Align): string { switch (a) { case "left": return "L"; case "right": return "R"; default: return "C" } }
function severity(l: Level): string { switch (l) { case Level.Off: return "off"; case Level.Debug: case Level.Info: return "low"; case Level.Warn: return "mid"; default: return "high" } }
console.log([Color.Red, Color.Green, Color.Blue, Color.Empty].map(paint).join(), (["left", "right", "center"] as Align[]).map(side).join(""), [Level.Debug, Level.Info, Level.Warn, Level.Error, Level.Off].map(severity).join())

// As keys of records (laid out: the keys are known) and of dictionaries and maps.
const perColor: Record<Color, number> = { [Color.Red]: 1, [Color.Green]: 2, [Color.Blue]: 3, [Color.Empty]: 4 }
const perAlign: { [K in Align]?: number } = { right: 1 }
perAlign[st.align] = (perAlign[st.align] ?? 0) + 1; perAlign.left = 5
perColor[st.color] += 10
console.log(show(perColor), show(perAlign), perColor[Color.Empty], perColor[""], perAlign.center, "center" in perAlign)
const perLevel: Record<Level, string> = { [Level.Debug]: "d", [Level.Info]: "i", [Level.Warn]: "w", [Level.Error]: "e", [Level.Off]: "o" }
console.log(show(perLevel), perLevel[Level.Off], perLevel[st.level], perLevel[11])
const tally = new Map<Color | Align, number>([[Color.Red, 1], ["left", 2]])
console.log(tally.get(Color.Red), tally.get("left"), tally.get(st.align), tally.has("red" as Color))

// The enum objects.
console.log(show(Color), show(Level), show(Mixed), Level[10], Level[-1], Level[5], Level.Error, Color["Red"], Object.values(Color).join(), Object.entries(Mixed).map(e => e.join("=")).join())
const anyLevel: any = Level
anyLevel.Extra = 99
console.log(anyLevel.Extra, Object.keys(Level).length, Level.Warn)

// const enums leave only their values.
const going: { dir: Dir; back?: Dir } = { dir: Dir.Up }
going.back = going.dir === Dir.Up ? Dir.Down : Dir.Up
console.log(show(going), going.dir.length, Dir.Down + Dir.Up)

// Leaving through any, JSON, spread, and coming back by a checked path.
const away: any = st
console.log(away.color, away.align, away.level + 1, JSON.stringify({ ...st }), Object.values(st).map(v => typeof v).join())
away.color = Color.Red; away.align = "left"; away.level = Level.Info; away.digit = 1
console.log(st.color, st.align, st.level, st.digit, paint(st.color), side(st.align), severity(st.level), show(st))

// Many objects, one site, all members.
const colors = [Color.Red, Color.Green, Color.Blue, Color.Empty], aligns: Align[] = ["left", "right", "center"]
const grid: Styled[] = []
for (let i = 0; i < 12; i++) grid.push({ ...st, color: colors[i % 4], align: aligns[i % 3], digit: (i % 3) as Digit, level: i % 2 ? Level.Off : Level.Error })
console.log(grid.map(g => paint(g.color) + side(g.align) + g.digit + severity(g.level)[0]).join())
//// string-discriminant-unions.ts
// Unions discriminated by a string field: `switch`, `if` chains, destructuring, filters.
type Circle = { kind: "circle"; radius: number }
type Square = { kind: "square"; side: number }
type Rect = { kind: "rect"; width: number; height: number }
type Empty = { kind: "empty" }
type Shape = Circle | Square | Rect | Empty
function show(o: object): string { return Object.keys(o).join() + " " + JSON.stringify(o) }
function area(s: Shape): number {
  switch (s.kind) {
    case "circle": return 3 * s.radius ** 2
    case "square": return s.side * s.side
    case "rect": return s.width * s.height
    case "empty": return 0
  }
}
function sides(s: Shape): number { if (s.kind === "circle" || s.kind === "empty") return 0; return s.kind === "square" ? s.side * 4 : 2 * (s.width + s.height) }
function viaLocal(s: Shape): string { const { kind } = s; const k = s.kind; return kind === k ? kind.length + kind[0] : "differs" }
const shapes: Shape[] = [{ kind: "circle", radius: 1 }, { side: 2, kind: "square" }, { width: 2, kind: "rect", height: 3.5 }, { kind: "empty" }, { radius: 0.5, kind: "circle" }]
console.log(shapes.map(area).join(), shapes.map(sides).join(), shapes.map(viaLocal).join(), shapes.map(show).join(" ; "))

// The same text, made at run time: a rope, a slice, a parsed string.
const pieces = ["cir", "cle", "squ", "are"]
const joined = (pieces[0] + pieces[1]) as "circle"
const sliced = "xxsquarexx".slice(2, 8) as "square"
const made: Shape[] = [{ kind: joined, radius: 2 }, { kind: sliced, side: 3 }, JSON.parse('{"kind":"rect","width":1,"height":2}'), JSON.parse('{"radius":3,"kind":"circle"}'), { kind: String(["empty"]) as "empty" }]
console.log(made.map(area).join(), made.map(sides).join(), made.map(viaLocal).join(), made.map(s => s.kind === shapes[0].kind).join())

const circles = [...shapes, ...made].filter((s): s is Circle => s.kind === "circle")
console.log(circles.map(c => c.radius).join(), circles.length)
const tally: Record<Shape["kind"], number> = { circle: 0, square: 0, rect: 0, empty: 0 }
for (const s of [...shapes, ...made]) tally[s.kind]++
console.log(show(tally))

// One payload name, another kind in each branch.
type Lit = { kind: "num"; value: number } | { kind: "str"; value: string } | { kind: "bool"; value: boolean } | { kind: "obj"; value: { inner: number } } | { kind: "list"; value: Lit[] } | { kind: "nil"; value: null }
function render(l: Lit): string {
  switch (l.kind) {
    case "num": return Object.is(l.value, -0) ? "-0" : String(l.value + 0)
    case "str": return '"' + l.value.toUpperCase() + '"'
    case "bool": return l.value ? "yes" : "no"
    case "obj": return "{" + l.value.inner + "}"
    case "list": return "[" + l.value.map(render).join() + "]"
    case "nil": return String(l.value)
  }
}
const lits: Lit[] = [{ kind: "num", value: 1.5 }, { value: "s", kind: "str" }, { kind: "bool", value: false }, { kind: "obj", value: { inner: 4 } }, { kind: "nil", value: null }, { kind: "num", value: -0 }, { kind: "num", value: NaN }]
lits.push({ kind: "list", value: lits.slice(0, 3) }, { kind: "list", value: [] })
console.log(lits.map(render).join(" "), lits.map(l => typeof l.value).join())

// A reducer: every action is an branch, the state is copied by spread.
type Item = { id: number; label: string; done?: boolean }
type State = { items: Item[]; nextId: number; last?: Action["type"] }
type Action = { type: "add"; label: string } | { type: "remove"; id: number } | { type: "toggle"; id: number } | { type: "rename"; id: number; label: string } | { type: "clear" }
function reduce(state: State, action: Action): State {
  switch (action.type) {
    case "add": return { ...state, items: [...state.items, { id: state.nextId, label: action.label }], nextId: state.nextId + 1, last: action.type }
    case "remove": return { ...state, items: state.items.filter(i => i.id !== action.id), last: "remove" }
    case "toggle": return { ...state, last: action.type, items: state.items.map(i => i.id === action.id ? { ...i, done: !i.done } : i) }
    case "rename": return { last: action.type, ...state, items: state.items.map(i => i.id === action.id ? { ...i, label: action.label } : i) }
    default: return { items: [], nextId: state.nextId }
  }
}
const actions: Action[] = [{ type: "add", label: "a" }, { type: "add", label: "b" }, { type: "toggle", id: 1 }, { label: "B", type: "rename", id: 2 }, { type: "toggle", id: 1 }, { type: "remove", id: 1 }, { type: "add", label: "c" }, { type: "clear" }, { type: "add", label: "d" }]
let state: State = { items: [], nextId: 1 }
for (const action of actions) { state = reduce(state, action); console.log(action.type, show(state)) }

// Nested unions, narrowed two levels deep.
type Reply = { status: "ok"; body: Shape } | { status: "error"; reason: { code: number; kind: "fatal" | "retry" } } | { status: "pending" }
function summarize(r: Reply): string {
  if (r.status === "ok") return r.body.kind === "circle" ? "circle of " + r.body.radius : r.body.kind + " of area " + area(r.body)
  if (r.status === "error") return r.reason.kind === "fatal" ? "fatal " + r.reason.code : "retry"
  return r.status
}
console.log(([{ status: "ok", body: shapes[0] }, { body: made[1], status: "ok" }, { status: "error", reason: { code: 5, kind: "fatal" } }, { status: "error", reason: { kind: "retry", code: 0 } }, { status: "pending" }] as Reply[]).map(summarize).join(" ; "))

let total = 0
const everything = [...shapes, ...made]
for (let i = 0; i < 5000; i++) total += area(everything[i % everything.length]) + render(lits[i % lits.length]).length
console.log(total)
//// structured-clone-typed-objects.ts
// structuredClone and postMessage of typed objects: object literals, class instances, class prototypes, and what their fields hold. A copy is a plain object with the enumerable own properties that plain Bun copies, and what plain Bun cannot clone throws the same DataCloneError.
interface Flat { id: number; name: string; ok: boolean; none: null; missing: undefined; opt?: string }
interface Deep { id: number; inner: Flat; list: Flat[]; at?: Date }
class P { #hidden = 1; constructor(public x: number, public y: string) {} get sum() { return this.x + this.#hidden; } method() { return 1; } }
class Untouched { constructor(public v: number) {} method() { return this.v; } get twice() { return this.v * 2; } }
class OfInstance { method() { return 1; } }
class Base { inherited() { return 1; } }
class Derived extends Base { own() { return 2; } }
class Extended { method() { return 1; } }
class Repeated { method() { return 1; } }
class Posted { method() { return 1; } }
class Whole { method() { return 1; } }
class InField { method() { return 1; } }
class WithMethod { method() { return 1; } }
function* numbers() { yield 1; }
function hide(value: unknown): any { return value; }
let count = 0;
////= show-2	const v = make(); out = Bun.inspect(v, { depth: 6, sorted: false }).replace(/\s+/g, " "
const flat = (id: number): Flat => ({ id, name: "n" + id, ok: true, none: null, missing: undefined });
const facts = (v: any) => [v, Object.keys(v), Object.getPrototypeOf(v) === Object.prototype, Object.isExtensible(v)];
show("flat", () => facts(structuredClone(flat(1))));
show("flat, the optional field set", () => { const x = flat(1); x.opt = "o"; return facts(structuredClone(x)); });
show("flat, orders differ", () => { const x: { a?: number; b?: number } = {}; x.b = 2; x.a = 1; return facts(structuredClone(x)); });
show("the copy is another object", () => { const x = flat(1); const c = structuredClone(x); c.name = "changed"; return [x.name, c.name, c !== x]; });
show("numbers", () => structuredClone({ a: 1, b: 1.5, c: -0, d: NaN, e: Infinity, f: 2147483648, g: -2147483649 }));
show("strings: empty, a rope, 16-bit", () => structuredClone({ a: "", b: "left".repeat(5) + String(count), c: "значение", d: "\ud800" }));
show("deep", () => { const d: Deep = { id: 1, inner: flat(2), list: [flat(3), flat(4)] }; return structuredClone(d); });
show("deep with a Date", () => { const d: Deep = { id: 1, inner: flat(2), list: [], at: new Date(0) }; return structuredClone(d); });
show("an array of flat ones", () => structuredClone([flat(1), flat(2), flat(3)]));
show("an array of flat and plain and primitives", () => structuredClone([flat(1), JSON.parse('{"p":1}'), 1, "s", null, undefined, flat(2)]));
show("an array with one object twice", () => { const x = flat(1); const c = structuredClone([x, x]); return [c, c[0] === c[1]]; });
show("an array of deep ones", () => structuredClone([{ id: 1, inner: flat(2), list: [] } as Deep]));
show("an instance", () => facts(structuredClone(new P(1, "y"))));
show("an array of instances", () => structuredClone([new P(1, "a"), new P(2, "b")]).map(facts));
show("a cycle", () => { const x: { self?: unknown; v: number } = { v: 1 }; x.self = x; const c = structuredClone(x); return [c.self === c, c.v]; });
show("a function in a field", () => structuredClone({ f: () => 1, v: 1 }));
show("a symbol in a field", () => structuredClone({ s: Symbol("s"), v: 1 }));
show("a bigint in a field", () => structuredClone({ b: 10n, v: 1 }));
show("a map, a set, a typed array in fields", () => structuredClone({ m: new Map([[1, flat(1)]]), s: new Set([flat(2)]), t: new Uint8Array([1, 2]) }));
show("extras", () => { const x = flat(1); hide(x).extra = "e"; hide(x)[0] = "zero"; hide(x)[Symbol.for("s")] = 1; return facts(structuredClone(x)); });
show("an extra accessor", () => { const x = flat(1); Object.defineProperty(hide(x), "got", { get() { return "got " + this.id; }, enumerable: true }); return facts(structuredClone(x)); });
show("frozen, sealed", () => [structuredClone(Object.freeze(flat(1))), structuredClone(Object.seal(flat(2)))].map(facts));
show("another prototype, a null prototype", () => { const a = flat(1), b = flat(2); Object.setPrototypeOf(a, JSON.parse('{"inherited":1}')); Object.setPrototypeOf(b, null); return [structuredClone(a), structuredClone(b)].map(facts); });
show("empty", () => facts(structuredClone({} as { o?: number })));
show("a class's prototype that nothing has listed or written", () => facts(structuredClone(Untouched.prototype)));
show("the class afterwards", () => { const u = new Untouched(2); return [u.method(), u.twice, Object.getOwnPropertyNames(Untouched.prototype), Object.getPrototypeOf(u) === Untouched.prototype]; });
show("the same prototype again", () => facts(structuredClone(Untouched.prototype)));
show("the prototype of an instance, in a field", () => structuredClone({ p: Object.getPrototypeOf(new OfInstance()) }));
show("a derived class's prototype", () => facts(structuredClone(Derived.prototype)));
show("a class's prototype with an added property", () => { hide(Extended.prototype).extra = "e"; return facts(structuredClone(Extended.prototype)); });
show("an array with one class's prototype twice", () => { const c = structuredClone([Repeated.prototype, Repeated.prototype]); return [c, c[0] === c[1]]; });
show("a class", () => structuredClone(Whole));
show("a class in a field", () => structuredClone({ c: InField, v: 1 }));
show("a method of a class's prototype", () => structuredClone(WithMethod.prototype.method));
show("a generator", () => structuredClone(numbers()));
show("through a MessageChannel's serializer", () => { const { port1, port2 } = new MessageChannel(); port1.postMessage(flat(1)); port1.postMessage([flat(2), new P(1, "p")]); port1.postMessage(Posted.prototype); port1.close(); port2.close(); return "posted"; });
//// structures-dead-at-every-gc.ts
// A server's collections come between requests: the objects of a request are all dead by then, and their shapes with them or not, as the engine pleases. Whatever it keeps, the next request reads and stores the same.
const shell = globalThis as any;
const collect: (full: boolean) => void = shell.Bun ? (full: boolean) => shell.Bun.gc(full) : (full: boolean) => (full ? shell.fullGC() : shell.edenGC());
interface Request {
  method: string;
  url: string;
  headers: Record<string, string>;
  params?: Record<string, string>;
  body?: unknown;
  user?: { id: number; name: string };
}
interface Reply {
  status: number;
  headers: Record<string, string>;
  sent: boolean;
  text?: string;
  length?: number;
}

function makeRequest(i: number): Request {
  const request: Request = { method: i % 3 ? "GET" : "POST", url: "/items/" + (i % 7), headers: {} };
  request.headers.host = "localhost";
  request.headers.accept = "*/*";
  if (i % 2) request.headers["content-type"] = "application/json";
  if (i % 3 === 0) request.body = { id: i, tags: ["a", "b"], nested: { deep: i % 5 } };
  if (i % 4 === 0) request.params = { id: String(i % 7) };
  if (i % 5 === 0) request.user = { id: i, name: "user" + (i % 3) };
  return request;
}

function handle(request: Request): Reply {
  const reply: Reply = { status: 200, headers: {}, sent: false };
  reply.headers["x-powered-by"] = "test";
  if (request.user) reply.headers["x-user"] = request.user.name;
  if (request.params) reply.text = "item " + request.params.id;
  else if (request.body) reply.text = JSON.stringify(request.body);
  else reply.text = request.method + " " + request.url;
  reply.length = reply.text.length;
  reply.sent = true;
  return reply;
}

function makeKind(round: number) {
  return class Kind {
    first = round;
    second = "s" + (round % 4);
    get both(): string {
      return this.first + this.second;
    }
  };
}

let total = 0;
let wrong = 0;
for (let round = 0; round < 240; round++) {
  const Kind = makeKind(round);
  for (let i = 0; i < 60; i++) {
    const request = makeRequest(round * 60 + i);
    const reply = handle(request);
    total += reply.length! + Object.keys(reply.headers).length + Object.keys(request).length;
    if (!reply.sent || reply.status !== 200) wrong++;
    const kind = new Kind();
    if (kind.both !== round + "s" + (round % 4)) wrong++;
    const bag: Record<string, number> = {};
    bag.alpha = i;
    bag.beta = round;
    if (i % 2) bag.gamma = 1;
    else bag.delta = 2;
    total += Object.keys(bag).join("").length + bag.alpha + bag.beta;
  }
  collect(round % 50 === 49);
  if (round % 7 === 3) collect(false);
}
console.log(total, wrong);
//// symbol-keyed-fields-dead-zone.ts
// The dead zone of the constant that holds the symbol is kept, and an object of the layout can be made before the symbol exists.
function tryRead(): string {
  try {
    return String(holder[kLate]);
  } catch (error) {
    return (error as Error).constructor.name;
  }
}
function tryMake(): string {
  try {
    const made: Holder = { a: 1, [kLate]: 2 };
    return String(made[kLate]);
  } catch (error) {
    return (error as Error).constructor.name;
  }
}
function tryDefine(): string {
  try {
    class Early {
      [kLate]: number = 1;
    }
    return String(new Early()[kLate]);
  } catch (error) {
    return (error as Error).constructor.name;
  }
}
interface Holder {
  a: number;
  [kLate]?: number;
}
const holder: Holder = { a: 1 };
console.log(Reflect.ownKeys(holder).map(String).join());
console.log(tryRead(), tryMake(), tryDefine());
const kLate = Symbol("late");
console.log(tryRead(), tryMake(), tryDefine());
holder[kLate] = 5;
console.log(tryRead(), Reflect.ownKeys(holder).map(String).join(), Object.getOwnPropertySymbols(holder)[0] === kLate);
