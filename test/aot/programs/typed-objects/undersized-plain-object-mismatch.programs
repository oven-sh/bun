}
const all: S[] = [{ kind: "s0", a0: 0 }, { kind: "s1", a1: 1 }, { kind: "s2", a2: 2 }, { kind: "s3", a3: 3 }, { kind: "s4", a4: 4 }, { kind: "s5", a5: 5 }, { kind: "s6", a6: 6 }, { kind: "s7", a7: 7 }, { kind: "s8", a8: 8 }, { kind: "s9", a9: 9 }, { kind: "s10", a10: 10 }, { kind: "s11", a11: 11 }, { kind: "s12", a12: 12 }, { kind: "s13", a13: 13 }, { kind: "s14", a14: 14 }, { kind: "s15", a15: 15 }, { kind: "s16", a16: 16 }, { kind: "s17", a17: 17 }, { kind: "s18", a18: 18 }, { kind: "s19", a19: 19 }];
const big: Big = { id: 7, more: "m" };
const boxed: Box<Big> = { held: big };
const byKey: { [key: string]: Big } = { one: big };
const handler: H3 = { kind: "h3", on3: from => ({ id: from.id + 1 }) };
const plain = (from: Small): Big => ({ id: from.id + 2, more: "f" });
const taken: H[] = [boxed, byKey, handler, plain];
function idOf(h: H): number {
  if (typeof h === "function") return h(big).id;
  if ("held" in h) return (h as Box<Small>).held.id;
  if ("kind" in h && typeof h.kind === "string") return (h as H3).on3(big).id;
  return (h as { [key: string]: Small }).one.id;
}
console.log(all.map(pick).join(), taken.map(idOf).join());
//// values-nobody-has-proven-stored-into-fields-of-every-kind.ts
// Fields of every kind get values of which nothing is proven, through receivers whose class is known and through receivers of which nothing is known: values that the type of the field takes and values that it
// does not, into fields that are there and into fields that are not there yet, into objects that are frozen, sealed or closed, below prototypes that get and lose a setter. As any engine answers.
const hide: (value: any) => any = (0, eval)("(value) => value");
const lines: string[] = [];
const calls: string[] = [];
type Level = "low" | "middle" | "high";
class Other { tag = "other"; }
class Record {
    whole = 1;
    wholeOrNone?: number;
    real = 1.5;
    realOrNone?: number;
    flag = true;
    flagOrNone?: boolean;
    text = "t";
    textOrNone?: string;
    level: Level = "low";
    other = new Other();
    otherOrNone?: Other;
    list: number[] = [];
    anything: unknown = null;
    late?: unknown;
}
class Heir extends Record { own = 0; ownOrNone?: string; }
const names = ["whole", "wholeOrNone", "real", "realOrNone", "flag", "flagOrNone", "text", "textOrNone", "level", "other", "otherOrNone", "list", "anything", "late", "own", "ownOrNone"] as const;
const values: unknown[] = [0, -1, 7, 2147483647, 2147483648, -2147483649, 0.5, -0, NaN, Infinity, true, false, "", "s", "low", "high", "none of them", null, undefined, new Other(), new Record(), [], [1], {}, () => 1, Symbol.for("s"), 10n];
function show(value: unknown): string {
    if (typeof value === "function") return "function";
    if (typeof value === "symbol" || typeof value === "bigint") return String(value);
    if (Object.is(value, -0)) return "-0";
    if (value instanceof Other) return "Other";
    if (value instanceof Record) return "Record";
    return typeof value === "object" && value !== null ? JSON.stringify(value) : String(value);
}
// The receiver's class is known and the value is not.
function storeKnown(target: Record, which: number, value: any): void {
    switch (which) {
    case 0: target.whole = value; break;
    case 1: target.wholeOrNone = value; break;
    case 2: target.real = value; break;
    case 3: target.realOrNone = value; break;
    case 4: target.flag = value; break;
    case 5: target.flagOrNone = value; break;
    case 6: target.text = value; break;
    case 7: target.textOrNone = value; break;
    case 8: target.level = value; break;
    case 9: target.other = value; break;
    case 10: target.otherOrNone = value; break;
    case 11: target.list = value; break;
    case 12: target.anything = value; break;
    case 13: target.late = value; break;
    }
}
function storeKnownInHeir(target: Heir, which: number, value: any): void {
    if (which === 14) target.own = value;
    else if (which === 15) target.ownOrNone = value;
    else storeKnown(target, which, value);
}
// Nothing is known of either.
function storeUnknown(target: any, which: number, value: any): void {
    switch (which) {
    case 0: target.whole = value; break;
    case 1: target.wholeOrNone = value; break;
    case 2: target.real = value; break;
    case 3: target.realOrNone = value; break;
    case 4: target.flag = value; break;
    case 5: target.flagOrNone = value; break;
    case 6: target.text = value; break;
    case 7: target.textOrNone = value; break;
    case 8: target.level = value; break;
    case 9: target.other = value; break;
    case 10: target.otherOrNone = value; break;
    case 11: target.list = value; break;
    case 12: target.anything = value; break;
    case 13: target.late = value; break;
    case 14: target.own = value; break;
    case 15: target.ownOrNone = value; break;
    }
}
function attempt(store: () => void): string {
    try {
        store();
        return "";
    } catch (error) {
        return " " + (error as Error).constructor.name;
    }
}
function round(title: string, prepare: (made: Record) => Record): void {
    lines.push(title);
    for (const [wayName, way] of [["known", storeKnownInHeir], ["unknown", storeUnknown]] as const) {
        for (let which = 0; which < names.length; which++) {
            const seen: string[] = [];
            for (const value of values) {
                for (const make of [() => new Record(), () => new Heir()]) {
                    if (which >= 14 && make === undefined) continue;
                    const made = prepare(make());
                    if (which >= 14 && !(made instanceof Heir) && wayName === "known") continue;
                    calls.length = 0;
                    const thrown = attempt(() => way(hide(made), which, hide(value)));
                    const again = attempt(() => way(hide(made), which, hide(value)));
                    seen.push(show((made as any)[names[which]]) + thrown + again + (calls.length ? " {" + calls.join() + "}" : "") + " " + Object.keys(made).length);
                }
            }
            lines.push("  " + wayName + " " + names[which] + ": " + seen.join(" | "));
        }
    }
}
round("as made", (made) => made);
round("again", (made) => made);
round("frozen", (made) => Object.freeze(made));
round("sealed", (made) => Object.seal(made));
round("closed", (made) => Object.preventExtensions(made));
round("a field deleted", (made) => { delete (made as any).real; delete (made as any).text; delete (made as any).anything; return made; });
round("a field redefined", (made) => Object.defineProperty(made, "whole", { value: 5, writable: false, configurable: true, enumerable: true }));
round("an extra property", (made) => { (made as any).extra = 1; return made; });
for (const name of ["late", "wholeOrNone", "ownOrNone"]) {
    Object.defineProperty(Record.prototype, name, { set(value) { calls.push("set " + name + " " + show(value)); }, get() { return "got"; }, configurable: true });
    round("a setter for " + name + " above", (made) => made);
    delete (Record.prototype as any)[name];
    round("and gone", (made) => made);
}
Object.defineProperty(Heir.prototype, "textOrNone", { value: "fixed", writable: false, configurable: true });
round("textOrNone cannot be written below one class", (made) => made);
delete (Heir.prototype as any).textOrNone;
Object.setPrototypeOf(Heir.prototype, { set flagOrNone(value: unknown) { calls.push("moved " + show(value)); } });
round("the class moved below another object", (made) => made);
Object.setPrototypeOf(Heir.prototype, Record.prototype);
round("and back", (made) => made);
let hash = 0;
const text = lines.join("\n");
for (let i = 0; i < text.length; i++) hash = (hash * 31 + text.charCodeAt(i)) | 0;
console.log(lines.length, text.length, hash);
console.log(lines.filter((_, i) => i % 23 === 0).map((line) => line.slice(0, 400)).join("\n"));
//// values-of-type-any-used-as-one-declared-type.ts
class Message {
  url = "/";
  status = 200;
  sent = false;
  next: Message | null = null;
}
////= lines-3	Urgent	Message	level	1
interface Reply {
  statusCode: number;
  statusMessage: string | undefined;
  size: number | undefined;
}
type Point = { across: number; down: number };
type Spot = { across: number; down: number; label: string };
const makeReply = (statusCode: number): Reply => ({ statusCode, statusMessage: undefined, size: undefined });
const makePoint = (across: number, down: number): Point => ({ across, down });
const makeSpot = (across: number, down: number): Spot => ({ across, down, label: "spot" });

const write = (message: any, url: any, status: any, sent: any, next: any) => {
  message.url = url;
  message.status = status;
  message.sent = sent;
  message.next = next;
};
const read = (message: any) => [message.url, message.status, message.sent, message.next === null].join();
const raise = (message: any) => message.level + message.status;
const finish = (reply: any, size: any) => {
  reply.statusMessage = "OK";
  reply.size = size;
  return reply.statusCode;
};
const sum = (point: any) => point.across + point.down;
const name = (spot: any) => spot.label + spot.across;

////= show

const typed = new Message();
const urgent = new Urgent();
const plain = { url: "p", status: 1, sent: true, next: null, level: 5 };
const heir = Object.create(typed);
let asked = 0;
const withAccessors = {
  get url() { asked++; return "g"; },
  set url(value) { asked += 10; },
  status: 2,
  sent: false,
  next: null,
};
const frozen = Object.freeze(new Message());
const bag = new Map<string, any>();
const put = (label: string, value: unknown) => (bag.set(label, value), label);

for (let turn = 0; turn < 3; turn++) {
  for (const label of [put("typed", typed), put("urgent", urgent), put("plain", plain), put("heir", heir), put("accessors", withAccessors), put("frozen", frozen)]) {
    const message = bag.get(label);
    show(label + " read", () => read(message));
    show(label + " write", () => write(message, "/" + turn, 300 + turn, turn % 2 === 0, null));
    show(label + " read again", () => read(message));
    show(label + " raise", () => raise(message));
  }
  show("asked", () => asked);
  show("own keys of the heir", () => Object.keys(heir).join());
  show("a number for the url", () => (write(bag.get("typed"), turn, 1, true, null), read(bag.get("typed"))));
  show("a string for the status", () => (write(bag.get("urgent"), "u", "s" + turn, true, null), read(bag.get("urgent"))));
  show("a plain object for next", () => (write(bag.get("typed"), "n", 1, true, bag.get("plain")), typed.next === (plain as any)));
  show("undefined", () => read(bag.get("nothing")));
  show("null", () => write(bag.get(put("null", null)), 1, 2, 3, 4));
  show("a string", () => read(bag.get(put("text", "text"))));
  show("a number", () => write(bag.get(put("seven", 7)), 1, 2, 3, 4));
  const reply = makeReply(200 + turn);
  show("reply", () => [finish(bag.get(put("reply", reply)), turn), reply.statusMessage, reply.size, Object.keys(reply).join()].join());
  show("plain reply", () => finish(bag.get(put("plain reply", { statusCode: 1 })), turn));
  show("a string for the size", () => [finish(bag.get("reply"), "big"), (reply as any).size].join());
  show("point", () => sum(bag.get(put("point", makePoint(turn, 2)))) + sum(bag.get(put("spot", makeSpot(turn, 3)))) + sum(bag.get(put("plain point", { across: 1, down: 1 }))));
  show("spot", () => name(bag.get("spot")) + name(bag.get(put("plain spot", { label: "l", across: 2 }))));
}
//// values-outside-literal-and-enum-types.ts
// A union of string literals and a string enum are tested as `string`, a union of number literals and a numeric enum as `number`, wherever the value enters or is read: a variable, a cast, a parameter, a field, an element. So any value of the kind passes, and nothing here throws.
////= attempt
const hide = (v: unknown): any => v
type Colour = "red" | "green" | "blue"
type Digit = 0 | 1 | 2
enum Level { Low, Mid, High }
enum Word { Yes = "yes", No = "no" }
function nameOfColour(c: Colour): string {
  switch (c) { case "red": return "R"; case "green": return "G"; case "blue": return "B" }
  return "other:" + c
}
function nameOfLevel(l: Level): string {
  switch (l) { case Level.Low: return "low"; case Level.Mid: return "mid"; case Level.High: return "high" }
  return "other:" + l
}
attempt("a1", () => { const c: Colour = hide("purple"); return c + "/" + c.length + "/" + nameOfColour(c) })
attempt("a2", () => { const c: Colour = hide("green"); return c + "/" + nameOfColour(c) })
attempt("a3", () => { const c: Colour = hide("gre" + "en"); return [c === "green", c === "red", nameOfColour(c)].join() })
attempt("a4", () => { const c = hide("") as Colour; return "<" + c + ">" + nameOfColour(c) })
attempt("b1", () => { const d: Digit = hide(7); return d + 1 })
attempt("b2", () => { const d: Digit = hide(1.5); return d * 2 })
attempt("b3", () => { const d: Digit = hide(-0); return 1 / d })
attempt("b4", () => { const d: Digit = hide(NaN); return [d === 0, d === 1, d !== d].join() })
attempt("c1", () => { const l: Level = hide(9); return l + "/" + nameOfLevel(l) + "/" + Level[l] })
attempt("c2", () => { const l: Level = hide(-1); return l + "/" + nameOfLevel(l) })
attempt("c3", () => { const l: Level = hide(2147483647); return l + "/" + nameOfLevel(l) })
attempt("c4", () => { const l: Level = hide(-2147483648); return l + "/" + nameOfLevel(l) })
attempt("c5", () => { const l: Level = hide(2); return l + "/" + nameOfLevel(l) + "/" + Level[l] })
attempt("d1", () => { const w: Word = hide("maybe"); return w + "/" + (w === Word.Yes) + "/" + (w === Word.No) })
attempt("d2", () => { const w: Word = hide("no"); return w + "/" + (w === Word.Yes) + "/" + (w === Word.No) })
attempt("e1", () => { const t: true = hide(true); return t ? "true" : "false" })
attempt("e2", () => { const f: false = hide(false); return f === false })
// In fields, which would like to be a byte.
interface Pixel { colour: Colour; level: Level; digit: Digit; on: true; word?: Word }
function show(o: object): string { return Object.keys(o).join() + JSON.stringify(o) }
const pixel: Pixel = { colour: "red", level: Level.Low, digit: 0, on: true }
attempt("f1", () => { pixel.colour = hide("ultraviolet"); pixel.level = hide(300); pixel.digit = hide(70000); return show(pixel) })
attempt("f2", () => [pixel.colour, pixel.level, pixel.digit, nameOfColour(pixel.colour), nameOfLevel(pixel.level), pixel.digit + 1].join())
attempt("f3", () => { (pixel as any).colour = "infrared"; (pixel as any).level = -5; (pixel as any).word = "perhaps"; return show(pixel) })
attempt("f4", () => [pixel.colour, pixel.level, pixel.on, pixel.word, nameOfColour(pixel.colour), nameOfLevel(pixel.level)].join())
attempt("f5", () => { pixel.colour = "blue"; pixel.level = Level.High; pixel.digit = 2; return show(pixel) + nameOfColour(pixel.colour) + nameOfLevel(pixel.level) })
const foreign = JSON.parse('{"colour":"mauve","level":12,"digit":3,"on":true,"word":"so"}') as Pixel
attempt("g1", () => [foreign.colour, foreign.level, foreign.digit, foreign.on, foreign.word, nameOfColour(foreign.colour), nameOfLevel(foreign.level)].join())
// A discriminant of plain data. One outside the union: see type-rules/values-outside-literal-and-enum-types.
type Shape = { kind: "circle"; r: number } | { kind: "square"; side: number }
function area(s: Shape): string {
  if (s.kind === "circle") return "circle " + s.r
  if (s.kind === "square") return "square " + s.side
  return "neither " + (s as any).kind
}
attempt("h1", () => [area(JSON.parse('{"kind":"circle","r":1}')), area(JSON.parse('{"side":1.5,"kind":"square"}')), area({ kind: "square", side: 2 })].join())
attempt("h2", () => { const s: Shape = { kind: "circle", r: 3 }; (s as any).kind = "cir" + "cle"; return area(s) + show(s) })
const colours: Colour[] = ["red"]
attempt("i1", () => { colours.push(hide("teal")); colours[2] = hide("pink"); return colours.map(nameOfColour).join() + colours.join() })
//// values-taken-from-maps-outlive-their-entries.ts
// A Map or Set with string keys keeps keys and values as 32-bit references in a table of its own. A loop takes a key or a value out of the table, the entry is deleted (or the whole Map cleared), a collection runs and the freed cells are filled anew: what the loop variable alone holds must be as it was, also where it is used on one path only, and where it is stored into an object.
// The functions are called through a table, so that nothing is inlined and no object is dissolved. The program asks for its collections itself.
interface Inner { n: number; label: string }
function collect(): void { const g: any = globalThis; if (g.Bun) g.Bun.gc(true); else g.gc() }
function inner(i: number): Inner { return { n: i, label: "l" + i } }
function key(i: number): string { return "key" + i }
function churn(): number { let s = 0; for (let i = 0; i < 60; i++) s += F.inner(9000 + i).n + F.key(i).length; return s }
function again(): void { F.collect(); F.churn() }
function filled(count: number): Map<string, Inner> { const m = new Map<string, Inner>(); for (let i = 0; i < count; i++) m.set(F.key(i), F.inner(i)); return m }
function names(count: number): Set<string> { const s = new Set<string>(); for (let i = 0; i < count; i++) s.add(F.key(i)); return s }
function valueBehindItsEntry(m: Map<string, Inner>): number { let s = 0; for (const [k, v] of m) { m.delete(k); F.again(); s += v.n } return s }
function valueOnOnePath(m: Map<string, Inner>, which: number): number { let s = 0, i = 0; for (const [k, v] of m) { m.delete(k); F.again(); if ((i++ & 1) === which) s += v.n } return s }
function keyOnOnePath(m: Map<string, Inner>, which: number): number { let s = 0, i = 0; for (const [k] of m) { m.delete(k); F.again(); if ((i++ & 1) === which) s += k.length } return s }
function valuesOnly(m: Map<string, Inner>, which: number): number { let s = 0, i = 0; for (const v of m.values()) { if (i === 0) m.clear(); F.again(); if ((i++ & 1) === which) s += v.n } return s }
function nameOnOnePath(set: Set<string>, which: number): number { let s = 0, i = 0; for (const k of set) { set.delete(k); F.again(); if ((i++ & 1) === which) s += k.length } return s }
function storedBehind(m: Map<string, Inner>, out: { held: Inner | null }): number { let s = 0; for (const [k, v] of m) { m.delete(k); F.again(); out.held = v; F.again(); s += out.held.n } return s }
const F = { collect, inner, key, churn, again, filled, names, valueBehindItsEntry, valueOnOnePath, keyOnOnePath, valuesOnly, nameOnOnePath, storedBehind };
for (const count of [3, 9, 20]) console.log(count, F.valueBehindItsEntry(F.filled(count)), F.valueOnOnePath(F.filled(count), 0), F.valueOnOnePath(F.filled(count), 1), F.keyOnOnePath(F.filled(count), 1), F.valuesOnly(F.filled(count), 0), F.nameOnOnePath(F.names(count), 0), F.storedBehind(F.filled(count), { held: null }));
//// weak-map-chains-survive-marking.ts
// What is reachable only through several rounds of marking constraints (a weak map's value is alive once its key is, and may itself be the next key), and what hangs on roots that change between collections, is all there afterwards.
const shell = globalThis as any;
const collect: (full: boolean) => void = shell.Bun ? (full: boolean) => shell.Bun.gc(full) : (full: boolean) => (full ? shell.fullGC() : shell.edenGC());
type Link = { id: number; tag: string };
type Holder = { first: Link; note: string };

const chain = new WeakMap<Link, Link>();
const crossA = new WeakMap<Link, Link>();
const crossB = new WeakMap<Link, Link>();
let latest: Link = { id: -1, tag: "none" };
let latestList: Link[] = [];
let latestText = "";
const holders: Holder[] = [];

function makeChain(length: number, seed: number): Link {
  const first: Link = { id: seed, tag: "c" + seed };
  let last = first;
  for (let i = 1; i < length; i++) {
    const next: Link = { id: seed + i, tag: "c" + (seed + i) };
    chain.set(last, next);
    last = next;
  }
  return first;
}

function makeCrossed(length: number, seed: number): Link {
  const first: Link = { id: seed, tag: "x" + seed };
  let last = first;
  for (let i = 1; i < length; i++) {
    const next: Link = { id: seed + i, tag: "x" + (seed + i) };
    (i % 2 ? crossA : crossB).set(last, next);
    last = next;
  }
  return first;
}

function walk(first: Link, ...maps: WeakMap<Link, Link>[]): string {
  let count = 0;
  let sum = 0;
  let text = 0;
  for (let at: Link | undefined = first; at; ) {
    count++;
    sum += at.id;
    text += at.tag.length;
    let next: Link | undefined;
    for (const map of maps) next ??= map.get(at);
    at = next;
  }
  return count + ":" + sum + ":" + text;
}

function garbage(n: number): number {
  let total = 0;
  for (let i = 0; i < n; i++) {
    const o = { a: i, b: "g" + i, c: [i, i + 1] };
    total += o.b.length + o.c.length + String(i * 1.5).length + String(i + 2000).length;
  }
  return total;
}

const lines: string[] = [];
for (let round = 0; round < 12; round++) {
  const a = makeChain(3 + round * 5, round * 1000);
  const b = makeCrossed(4 + round * 3, round * 1000 + 500);
  holders.push({ first: a, note: "chain " + round }, { first: b, note: "crossed " + round });
  latest = { id: round, tag: "latest" + round };
  latestList = [latest, { id: round + 1, tag: "list" + round }];
  latestText = "text " + round + " " + (round * 0.25);
  const made = garbage(3000);
  collect(round % 3 === 2);
  chain.set(latest, latestList[1]);
  collect(false);
  lines.push(round + " " + made + " " + latest.tag + " " + latestList.map((l) => l.tag).join(",") + " " + latestText + " " + walk(latest, chain));
}
for (const holder of holders) lines.push(holder.note + " " + walk(holder.first, chain, crossA, crossB));

let resolved = 0;
async function later(n: number): Promise<number> {
  const kept: Link = { id: n, tag: "kept" + n };
  await null;
  collect(n % 2 === 0);
  await null;
  resolved++;
  return kept.id + kept.tag.length;
}
const results = await Promise.all([later(1), later(2), later(3), later(4)]);
lines.push("later " + results.join(",") + " " + resolved);
console.log(lines.join("\n"));
//// wrong-kind-where-class-union-expected.ts
const lines: string[] = [];
function say(name: string, ...values: unknown[]): void { lines.push(name + " " + values.map(value => String(value)).join(" ")); }

interface Shape { name: string; sides: number; area?: number; label?: string }
class Circle implements Shape { name = "circle"; sides = 0; area?: number; radius: number; constructor(radius: number) { this.radius = radius; } }
class Square implements Shape { name = "square"; sides = 4; area?: number; label?: string; side: number; constructor(side: number) { this.side = side; } }
class Triangle implements Shape { name = "triangle"; sides = 3; label?: string; constructor(public base: number, public height: number) {} }
interface Tool { kind: string; weight: number; owner?: string }
class Hammer implements Tool { kind = "hammer"; weight = 3; owner?: string }
class Saw implements Tool { kind = "saw"; weight = 2; teeth = 40 }

function nameOf(shape: Shape): string { return shape.name; }
function sidesOf(shape: Shape): number { return shape.sides; }
function areaOf(shape: Shape): number | undefined { return shape.area; }
function labelOf(shape: Shape): string | undefined { return shape.label; }
function setArea(shape: Shape, area: number): void { shape.area = area; }
function setLabel(shape: Shape, label: string): void { shape.label = label; }
function describe(shape: Shape): string { return shape.name + ":" + shape.sides + ":" + shape.area + ":" + shape.label; }
function rename(shape: Shape, name: string): void { shape.name = name; shape.sides = shape.sides + 1; }
function kindOf(tool: Tool): string { return tool.kind + tool.weight + tool.owner; }
function lend(tool: Tool, owner: string): void { tool.owner = owner; }
function summary(shape: Shape): string { return [shape.name, shape.sides, shape.area, shape.label].join("/"); }
function isLabelled(shape: Shape): boolean { return shape.label !== undefined && shape.label.length > 0 && shape.name !== shape.label; }
function isMeasured(shape: Shape): boolean { return shape.area !== undefined && shape.area > 0 && shape.sides >= 0; }
function compare(a: Shape, b: Shape): number { return a.sides - b.sides || (a.area ?? 0) - (b.area ?? 0) || a.name.length - b.name.length; }
function copyInto(from: Shape, to: Shape): void { to.area = from.area; to.label = from.label; to.sides = from.sides; }
function swapNames(a: Shape, b: Shape): void { const name = a.name; a.name = b.name; b.name = name; }
function grow(shape: Shape): number { shape.sides += 1; shape.area = (shape.area ?? 0) + shape.sides; return shape.area; }
function title(shape: Shape): string { return (shape.label ?? shape.name).toUpperCase() + shape.sides; }
function same(a: Shape, b: Shape): boolean { return a.name === b.name && a.sides === b.sides && a.area === b.area && a.label === b.label; }
function reset(shape: Shape): void { shape.area = undefined; shape.label = undefined; shape.sides = 0; shape.name = "none"; }
function either(thing: Shape | Tool): string { return "name" in thing ? nameOf(thing) : kindOf(thing); }

const shapes: Shape[] = [new Circle(1), new Square(2), new Triangle(3, 4)];
const tools: Tool[] = [new Hammer(), new Saw()];
for (const shape of shapes) { say("own", nameOf(shape), sidesOf(shape), areaOf(shape), labelOf(shape), describe(shape)); }
for (const shape of shapes) { setArea(shape, 7); setLabel(shape, "l"); rename(shape, shape.name + "!"); say("stored", describe(shape), Object.keys(shape).join()); }
for (const tool of tools) { say("tool", kindOf(tool)); lend(tool, "me"); say("lent", kindOf(tool), Object.keys(tool).join()); }
say("either", either(shapes[0]), either(tools[1]));
for (const shape of shapes) say("more", summary(shape), isLabelled(shape), isMeasured(shape), compare(shape, shapes[1]), grow(shape), title(shape), same(shape, shapes[2]));
copyInto(shapes[0], shapes[1]); swapNames(shapes[1], shapes[2]);
for (const shape of shapes) say("moved", summary(shape));

const many: Record<string, unknown> = { name: "many", sides: 9 };
for (let i = 0; i < 40; i++) many["extra" + i] = i;
const withGetter = { get name() { return "getter"; }, sides: 1, get area() { return 5; } };
const frozen = Object.freeze({ name: "frozen", sides: 2 });
const inherits = Object.create({ name: "inherited", sides: 6, area: 8, label: "proto" });
const proxy = new Proxy({ name: "target", sides: 5 }, { get: (target, key) => (key === "sides" ? 55 : Reflect.get(target, key)) });
const list = Object.assign([1, 2, 3], { name: "array", sides: 3 });
const callable = Object.assign(function () {}, { sides: 8, label: "function" });
const map = Object.assign(new Map(), { name: "map", sides: 10 });
const date = Object.assign(new Date(0), { name: "date", sides: 11 });
const strangers: unknown[] = [many, withGetter, frozen, inherits, proxy, list, callable, map, date, { name: "plain", sides: 12 }];
for (const stranger of strangers) {
    const shape = stranger as Shape;
    say("stranger", nameOf(shape), sidesOf(shape), areaOf(shape), labelOf(shape), describe(shape));
    try { setLabel(shape, "set"); say("labelled", labelOf(shape)); } catch (error) { say("refused", (error as Error).constructor.name); }
    try { setArea(shape, 1); say("measured", areaOf(shape)); } catch (error) { say("refused", (error as Error).constructor.name); }
    say("looked at", summary(shape), isLabelled(shape), isMeasured(shape), compare(shape, shapes[0]), title(shape), same(shape, shape), same(shape, shapes[0]));
    try { say("grown", grow(shape)); copyInto(shapes[0], shape); swapNames(shape, shapes[1]); swapNames(shape, shapes[1]); say("after", summary(shape)); } catch (error) { say("refused", (error as Error).constructor.name); }
}
for (const nothing of [undefined, null] as unknown[]) {
    try { say("nothing", nameOf(nothing as Shape)); } catch (error) { say("threw", (error as Error).constructor.name); }
    try { setArea(nothing as Shape, 1); } catch (error) { say("threw", (error as Error).constructor.name); }
}
let total = 0;
for (let round = 0; round < 2000; round++) {
    for (const shape of shapes) total += sidesOf(shape) + (areaOf(shape) ?? 0) + nameOf(shape).length;
    total += sidesOf(strangers[round % strangers.length] as Shape) | 0;
}
say("total", total);
for (const shape of shapes) { reset(shape); say("reset", summary(shape)); }
console.log(lines.join("\n"));
//// wrong-type-objects.ts
// Objects travel through `unknown`, typed fields, arrays, Maps, results and generics, and are used again under their own type.
interface Engine { power: number; parts: string[] }
interface Owner { nick: string }
interface Car { wheels: number; engine: Engine; trailer?: Car; owner: Owner | null; paint?: string; honk?(): string }
interface Fish { fins: number; school?: Fish[]; habitat: { salt: boolean }; paint?: string }
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
function nickOf(o: Owner): string { return o.nick }
const fish: Fish = { fins: 2, habitat: { salt: true }, paint: "silver" }
const car: Car = { wheels: 4, engine: { power: 90, parts: ["p"] }, owner: null }
const towed: Car = { wheels: 2, engine: { power: 0, parts: [] }, owner: { nick: "o" }, paint: "blue", honk() { return "beep " + this.wheels } }
car.trailer = towed
console.log(String(car.trailer?.engine.power), car.owner?.nick ?? "nobody", car.honk?.() ?? "silent", towed.honk?.(), attempt(() => nickOf(car.owner as Owner)), nickOf(towed.owner as Owner))
const nothing = null as unknown as Car, missing = undefined as unknown as Car
console.log(nothing === null, missing === undefined, attempt(() => nothing.engine), attempt(() => missing.paint), nothing?.paint ?? "none", attempt(() => { missing.paint = "x" }))
// Classes and a literal of the class's type.
class Beta { b = "two"; run() { return "beta" + this.b } onlyBeta() { return "B" } }
const runners: Beta[] = [new Beta(), { b: "lit", run() { return "literal" + this.b }, onlyBeta: () => "L" }]
console.log(runners.map(r => r.run()).join(), runners.map(r => r.onlyBeta()).join(), runners.map(r => r instanceof Beta).join())
interface Garage { main: Car; others: Car[]; byPlate: Map<string, Car> }
const garage: Garage = { main: towed, others: [towed, car], byPlate: new Map([["x", towed]]) }
function pickCar(g: Garage, i: number): Car { return i < 0 ? g.main : g.others[i] }
function same<T>(x: T): T { return x }
console.log(pickCar(garage, -1) === towed, pickCar(garage, 0).paint, String(pickCar(garage, 5)), garage.byPlate.get("x") === towed, same<Car>(garage.main).engine.power)
const back = same(pickCar(garage, 0)) as unknown as Car, swum = same<unknown>(fish) as Fish
console.log(back === towed, back.wheels + 1, back.paint, swum === fish, swum.fins + 1, swum.habitat.salt, String(swum.school))
function classify(x: Car | Fish): string { return "habitat" in x ? "fish:" + x.habitat.salt : "car:" + typeof x.engine }
console.log(classify(car), classify(fish), classify(back), classify(swum))
const lot: Car[] = [car, towed, back]
let n = 0
for (let i = 0; i < 132; i++) { const c = lot[i % lot.length]; if (c.engine) n += c.engine.power; if (c.paint) n += c.paint.length; if (c.trailer) n++; if (c.owner) n += c.owner.nick.length }
console.log(n)
