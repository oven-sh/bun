//// uninitialized-variables/main.ts
// Variables that are read before their first assignment: `let x: T` through closures, hoisted `var`, `let x!: T`, and the temporal dead zone.
function kind(v: unknown): string { return v === undefined ? "undefined" : v === null ? "null" : typeof v }
function attempt(f: () => unknown): string { try { return String(f()) } catch (e) { return (e as Error).constructor.name } }
function double(n: number): number { return n * 2 }
function orTen(n: number = 10): number { return n }

// A closure reads the variable before the assignment, and after.
function closures(): string {
  let n: number, s: string, b: boolean, o: { v: number }
  const references = () => [kind(s), kind(o), s + "!", s === undefined, o == null].join()
  const read = () => [kind(n), kind(s), kind(b), kind(o), double(n), s + "!", b ? 1 : 0, orTen(n), n + 1, n === undefined].join()
  const before = references()
  n = 2; s = "s"; b = true; o = { v: 1 }
  return before + " | " + references() + " | " + read() + " | " + o.v
}
console.log(closures())

// `let x!: T`.
let moduleCount!: number
let moduleLabel!: string
console.log(moduleLabel, moduleLabel + "x", kind(moduleLabel), moduleLabel ?? "none")
moduleCount = 3; moduleLabel = "set"
console.log(moduleCount + 1, moduleLabel.length, kind(moduleCount), orTen(moduleCount), moduleCount ?? "none")

// A module variable read by a function that is called before the declaration has run its initializer-less `let`.
function readLater(): string { return kind(later) + ":" + (later + "!") }
let later: string
console.log(readLater())
later = "now"
console.log(readLater())

// The dead zone is a ReferenceError, not undefined.
function readConst(): number { return tooEarly }
console.log(attempt(readConst), attempt(() => tooEarlyLet))
// An initializer that the compiler cannot fold. type-rules/constant-tdz has the ones it folds: their dead zone is the same.
const tooEarly: number = Math.abs(-5)
let tooEarlyLet: string = "x"
console.log(readConst(), tooEarlyLet)
////= innerZone
console.log(innerZone(true), innerZone(false))

// `var` is undefined from the start of its function.
function hoisted(flag: boolean): string {
  const get = () => v
  const first = kind(get()) + ":" + (get() + "!")
  if (flag) { var v: string = "six" }
  return first + "," + kind(get()) + "," + get()
}
console.log(hoisted(true), hoisted(false))
function hoistedNumber(): string {
  const get = () => v
  var v: number = 6
  return kind(get()) + "," + double(get())
}
console.log(hoistedNumber())

// Each turn of a loop starts a fresh, unassigned variable; the one captured in the turn before keeps its value.
function loop(): string {
  const readers: (() => string)[] = []
  for (let i = 0; i < 4; i++) {
    let seen: string
    readers.push(() => kind(seen) + (seen + "/" + i))
    if (i % 2) seen = "s" + i * 10
  }
  return readers.map(r => r()).join()
}
console.log(loop())

// Only some paths assign; the value goes on into typed fields, arrays and concatenation.
interface Acc { total: number; text: string }
function paths(mode: number): string {
  let n: number, s: string
  const get = (): Acc => ({ total: n, text: s })
  n = mode
  if (mode > 1) s = "m" + mode
  const acc = get()
  const list: string[] = [acc.text, "1"]
  return JSON.stringify(acc) + Object.keys(acc).join("") + (acc.total + 1) + (acc.text + "") + JSON.stringify(list) + kind(list[0]) + (list[0] + list[1])
}
console.log(paths(0), paths(1), paths(2))

// switch cases share one scope; try and finally; a destructuring that finds nothing.
function cases(x: number): string {
  switch (x) {
    case 0: let c: string; const r = () => kind(c); return r()
    case 1: return attempt(() => c)
    default: c = "c" + x; return String(c)
  }
}
console.log(cases(0), cases(1), attempt(() => cases(2)))
function tried(fail: boolean): string {
  let got: string
  const read = () => kind(got) + got
  try { if (fail) throw new RangeError("x"); got = "one" } catch { return "caught " + read() } finally { trail.push(read()) }
  return read()
}
const trail: string[] = []
console.log(tried(false), tried(true), trail.join())
const [d0, d1]: string[] = ["1"]
const [e0]: number[] = [1]
const { missing }: { missing?: number } = {}
console.log(d0, d1, d0 + d1, kind(d1), e0, missing, orTen(e0), orTen(missing))
//// union-member-without-field-in-recycled-cell.ts
// Only one member of the union has `payload`. A read through the union may load the slot without a shape test, so an object of the other member must read as undefined even when its cell held a payload before the collection.
// The functions are called through a table, so that nothing is inlined and no allocation is removed.
interface WithPayload { first: number; payload: object }
interface WithoutPayload { first: number }
type Either = WithPayload | WithoutPayload;

function withPayload(i: number): WithPayload { return { first: i, payload: { i } } }
function withoutPayload(i: number): WithoutPayload { return { first: i } }
function payloadOf(value: Either): unknown { return (value as any).payload }
function fill(count: number, create: (i: number) => Either): Either[] {
  const list: Either[] = [];
  for (let i = 0; i < count; i++) list.push(create(i));
  return list;
}
function countPayloads(list: Either[]): number {
  let count = 0;
  for (const value of list) if (F.payloadOf(value) !== undefined) count++;
  return count;
}
function countOwnPayloads(list: Either[]): number {
  let count = 0;
  for (const value of list) if ("payload" in value) count++;
  return count;
}
function sumOfFirst(list: Either[]): number {
  let sum = 0;
  for (const value of list) sum += value.first;
  return sum;
}
const F = { withPayload, withoutPayload, payloadOf, fill, countPayloads, countOwnPayloads, sumOfFirst };

for (let round = 0; round < 4; round++) {
  let list = F.fill(4000, F.withPayload);
  console.log(round, "with", F.countPayloads(list), F.countOwnPayloads(list), F.sumOfFirst(list));
  list = [];
  Bun.gc(true);
  list = F.fill(4000, F.withoutPayload);
  console.log(round, "without", F.countPayloads(list), F.countOwnPayloads(list), F.sumOfFirst(list), Object.keys(list[3999]).join());
  list = [];
  Bun.gc(true);
}
//// union-of-twenty-functions/main.ts
import { visitors, type Visitors } from "./visitors";
type Everything = Parameters<Visitors[keyof Visitors]>[0] extends infer P ? P : never;
const all = { shared: { value: 100, children: [{ value: 1 }] }, own0: { value: { k0: 0 } }, own1: { value: { k1: 1 } }, own2: { value: { k2: 2 } }, own3: { value: { k3: 3 } }, own4: { value: { k4: 4 } }, own5: { value: { k5: 5 } }, own6: { value: { k6: 6 } }, own7: { value: { k7: 7 } }, own8: { value: { k8: 8 } }, own9: { value: { k9: 9 } }, own10: { value: { k10: 10 } }, own11: { value: { k11: 11 } }, own12: { value: { k12: 12 } }, own13: { value: { k13: 13 } }, own14: { value: { k14: 14 } }, own15: { value: { k15: 15 } }, own16: { value: { k16: 16 } }, own17: { value: { k17: 17 } }, own18: { value: { k18: 18 } }, own19: { value: { k19: 19 } } };
function visit(name: keyof Visitors): number {
  const visitor = visitors[name];
  return visitor(all);
}
let sum = 0;
for (const name of Object.keys(visitors) as (keyof Visitors)[]) sum += visit(name);
const one: Everything = all;
console.log(sum, visit("v7"), one.shared.children?.length);
//// union-of-twenty-functions/visitors.ts
export interface Tree<T> { value: T; children?: Tree<T>[]; up?: Tree<T> }
export interface Q0 { shared: Tree<number>; own0: Tree<{ k0: number; next?: Q0 }> }
export interface Q1 { shared: Tree<number>; own1: Tree<{ k1: number; next?: Q1 }> }
export interface Q2 { shared: Tree<number>; own2: Tree<{ k2: number; next?: Q2 }> }
export interface Q3 { shared: Tree<number>; own3: Tree<{ k3: number; next?: Q3 }> }
export interface Q4 { shared: Tree<number>; own4: Tree<{ k4: number; next?: Q4 }> }
export interface Q5 { shared: Tree<number>; own5: Tree<{ k5: number; next?: Q5 }> }
export interface Q6 { shared: Tree<number>; own6: Tree<{ k6: number; next?: Q6 }> }
export interface Q7 { shared: Tree<number>; own7: Tree<{ k7: number; next?: Q7 }> }
export interface Q8 { shared: Tree<number>; own8: Tree<{ k8: number; next?: Q8 }> }
export interface Q9 { shared: Tree<number>; own9: Tree<{ k9: number; next?: Q9 }> }
export interface Q10 { shared: Tree<number>; own10: Tree<{ k10: number; next?: Q10 }> }
export interface Q11 { shared: Tree<number>; own11: Tree<{ k11: number; next?: Q11 }> }
export interface Q12 { shared: Tree<number>; own12: Tree<{ k12: number; next?: Q12 }> }
export interface Q13 { shared: Tree<number>; own13: Tree<{ k13: number; next?: Q13 }> }
export interface Q14 { shared: Tree<number>; own14: Tree<{ k14: number; next?: Q14 }> }
export interface Q15 { shared: Tree<number>; own15: Tree<{ k15: number; next?: Q15 }> }
export interface Q16 { shared: Tree<number>; own16: Tree<{ k16: number; next?: Q16 }> }
export interface Q17 { shared: Tree<number>; own17: Tree<{ k17: number; next?: Q17 }> }
export interface Q18 { shared: Tree<number>; own18: Tree<{ k18: number; next?: Q18 }> }
export interface Q19 { shared: Tree<number>; own19: Tree<{ k19: number; next?: Q19 }> }
export type Visitors = {
  v0: (q: Q0) => number;
  v1: (q: Q1) => number;
  v2: (q: Q2) => number;
  v3: (q: Q3) => number;
  v4: (q: Q4) => number;
  v5: (q: Q5) => number;
  v6: (q: Q6) => number;
  v7: (q: Q7) => number;
  v8: (q: Q8) => number;
  v9: (q: Q9) => number;
  v10: (q: Q10) => number;
  v11: (q: Q11) => number;
  v12: (q: Q12) => number;
  v13: (q: Q13) => number;
  v14: (q: Q14) => number;
  v15: (q: Q15) => number;
  v16: (q: Q16) => number;
  v17: (q: Q17) => number;
  v18: (q: Q18) => number;
  v19: (q: Q19) => number;
};
export const visitors: Visitors = {
  v0: q => q.shared.value + q.own0.value.k0,
  v1: q => q.shared.value + q.own1.value.k1,
  v2: q => q.shared.value + q.own2.value.k2,
  v3: q => q.shared.value + q.own3.value.k3,
  v4: q => q.shared.value + q.own4.value.k4,
  v5: q => q.shared.value + q.own5.value.k5,
  v6: q => q.shared.value + q.own6.value.k6,
  v7: q => q.shared.value + q.own7.value.k7,
  v8: q => q.shared.value + q.own8.value.k8,
  v9: q => q.shared.value + q.own9.value.k9,
  v10: q => q.shared.value + q.own10.value.k10,
  v11: q => q.shared.value + q.own11.value.k11,
  v12: q => q.shared.value + q.own12.value.k12,
  v13: q => q.shared.value + q.own13.value.k13,
  v14: q => q.shared.value + q.own14.value.k14,
  v15: q => q.shared.value + q.own15.value.k15,
  v16: q => q.shared.value + q.own16.value.k16,
  v17: q => q.shared.value + q.own17.value.k17,
  v18: q => q.shared.value + q.own18.value.k18,
  v19: q => q.shared.value + q.own19.value.k19,
};
//// union-optional-fields-changed-by-untyped-code.ts
// Objects of a union of record types with optional fields are changed by untyped code: fields added, deleted, redefined, frozen, inherited, parsed from JSON.
type A = { kind: "a"; x?: string; y?: string; z?: number };
type B = { kind: "b"; p?: string; q?: string; r?: number };
type C = { kind: "c"; x?: string; p?: string; w?: string; v?: string; u?: string; t?: string; s?: string; o?: string; n?: string; m?: string };
type U = A | B | C;
const say = (what: string, got: unknown) => console.log(what + ": " + (typeof got === "string" ? got : JSON.stringify(got) ?? String(got)));
const mkA = (): A => ({ kind: "a" }); const mkAx = (): A => ({ kind: "a", x: "x" }); const mkB = (): B => ({ kind: "b", p: "p" });
const mkC = (): C => ({ kind: "c", x: "cx", p: "cp", w: "w", v: "v", u: "u", t: "t", s: "s", o: "o", n: "n", m: "m" });
function all(o: U): string {
  if (o.kind === "a") return "a " + o.x + " " + o.y + " " + o.z;
  if (o.kind === "b") return "b " + o.p + " " + o.q + " " + o.r;
  return "c " + o.x + " " + o.p + " " + o.w + " " + o.v + " " + o.u + " " + o.t + " " + o.s + " " + o.o + " " + o.n + " " + o.m;
}
const asA = (o: A): string => o.x + " " + o.y + " " + o.z; const asB = (o: B): string => o.p + " " + o.q + " " + o.r;
const set = (o: any, k: string, v: unknown) => { o[k] = v; }; const del = (o: any, k: string) => { delete o[k]; };
const through = <T,>(o: unknown): T => o as T;
const outside = <T,>(text: string): T => JSON.parse(text) as T;

say("born", [all(mkA()), all(mkAx()), all(mkB()), all(mkC())]);
{ const o = mkA(); const before = asA(o); set(o, "y", "later"); set(o, "x", "later still"); set(o, "z", 3); say("given what there was no room for", [before, asA(o), Object.keys(o).join()]); }
{ const o = mkAx(); del(o, "x"); const gone = asA(o); set(o, "x", "again"); say("taken out and put back", [gone, asA(o), o]); }
{ const o = mkAx(); del(o, "x"); set(o, "p", "a name of another type with the same slot, maybe"); say("another name where one was", [asA(o), asB(through<B>(o)), o]); }
{ const o = mkAx(); set(o, "p", "P"); set(o, "q", "Q"); say("names of both", [asA(o), asB(through<B>(o)), o]); }
{ const o = mkB(); say("seen as the other", [asA(through<A>(o)), asB(o)]); }
{ const o = mkAx(); let got = 0; try { Object.defineProperty(o, "x", { get() { got++; return "from a getter"; }, configurable: true, enumerable: true }); } catch (e) { say("an accessor is refused", (e as Error).constructor.name); } say("an accessor", [asA(o), got > 0]); }
{ const o = mkAx(); Object.freeze(o); let threw = "no"; try { o.x = "written"; } catch (e) { threw = (e as Error).constructor.name; } say("frozen", [asA(o), threw]); }
{ const o = mkAx(); Object.seal(o); o.x = "written"; let threw = "no"; try { o.y = "added"; } catch (e) { threw = (e as Error).constructor.name; } say("sealed", [asA(o), threw]); }
{ const o = mkAx(); Object.preventExtensions(o); o.x = "written"; say("not extensible", asA(o)); }
{ const o = mkA(); Object.setPrototypeOf(o, { x: "inherited x", y: "inherited y" }); say("inherits what it lacks", asA(o)); set(o, "x", "own"); say("and then has one", asA(o)); }
{ const o = mkA(); Object.setPrototypeOf(o, null); say("inherits from nothing", asA(o)); }
say("from outside", [all(outside<U>('{"kind":"a","x":"ox","z":1}')), all(outside<U>('{"z":2,"y":"oy","kind":"a"}')), all(outside<U>('{"more":1,"kind":"b","and":2,"r":3,"more2":4,"q":"oq","more3":5,"more4":6,"p":"op"}'))]);
say("wide, from outside", all(outside<U>('{"m":"M","n":"N","o":"O","s":"S","t":"T","u":"U","v":"V","w":"W","p":"P","x":"X","kind":"c"}')));
{ const o = outside<A>('{"kind":"a","x":"ox"}'); const first = asA(o); const second = asA(o); o.y = "typed store"; say("looked at twice, then written", [first, second, asA(o), o]); }
{ const o = outside<A>('{"kind":"a","0":"index","x":"ox"}'); say("with an element", [asA(o), o]); }
{ class K { kind = "a" as const; x?: string = "of a class"; get y() { return "a getter of the class"; } } say("an instance of a class", asA(new K())); }
{ const p = new Proxy<A>({ kind: "a", x: "target" }, { get: (t, k) => (k === "y" ? "trapped" : (t as any)[k]) }); say("a proxy", asA(p)); }
{ const o = Object.create({ kind: "a", x: "all inherited" }) as A; say("has nothing of its own", asA(o)); }
{ const o: any = { kind: "a" }; for (let i = 0; i < 200; i++) o["k" + i] = i; for (let i = 0; i < 200; i++) delete o["k" + i]; o.x = "of a dictionary"; say("a dictionary", [asA(o as A), Object.keys(o).join()]); del(o, "x"); say("and without", asA(o as A)); }
{ const o = mkAx(); const copy = { ...o }; const more: A = { ...o, y: "added in the copy" }; const assigned: A = Object.assign({ kind: "a" as const }, o); say("copies", [asA(copy), asA(more), asA(assigned), asA(structuredClone(o))]); }
{ const o: any = { kind: "a", x: "plain x" }; Object.defineProperty(o, "hidden", { value: 1, enumerable: false }); say("with one that is not enumerable", [asA(o as A), asA(o as A), Object.keys(o).join(), JSON.stringify(o), o.hidden]); }
{ const o: any = { kind: "a", z: 4 }; let got = 0; Object.defineProperty(o, "x", { get() { got++; return "got " + got; }, enumerable: true, configurable: true }); say("with a getter for a field", [asA(o as A), asA(o as A), got, Object.keys(o).join(), JSON.stringify(o)]); }
{ const o: any = { kind: "a", x: "plain x" }; let got = 0; Object.defineProperty(o, "other", { get() { got++; return "other"; }, set(_v: unknown) { got += 10; }, enumerable: true }); say("with a getter for something else", [asA(o as A), asA(o as A), o.other, got, (o.other = 1, got), JSON.stringify(o)]); }
{ const o: any = { kind: "a" }; Object.defineProperty(o, "x", { value: "read-only x", writable: false, enumerable: true, configurable: true }); let threw = "no"; const a = o as A; const first = asA(a); try { a.x = "written"; } catch (e) { threw = (e as Error).constructor.name; } say("with a field that is read-only", [first, asA(a), threw, Object.getOwnPropertyDescriptor(o, "x")]); }
{ const proto: any = { kind: "a", x: "of the prototype" }; const child = Object.create(proto); say("what is a prototype", [asA(proto as A), asA(child as A)]); proto.x = "changed"; proto.y = "added"; say("and is changed", [asA(proto as A), asA(child as A)]); }
{ const o: any = { get kind() { return "a"; }, x: "x", get y() { return "y of a getter"; } }; say("a literal with getters", [asA(o as A), asA(o as A), all(o as U), Object.keys(o).join()]); }
const thrice = (o: A): string => (o.x === "1" || o.x === "2" || o.x === "3" ? "yes " : "no ") + o.x + " " + o.x;
const both = (o: A): string => o.x + " " + o.y + " " + o.x + " " + o.y;
say("just read, before anything else has been", [thrice(mkAx()), thrice(mkA()), thrice(outside<A>('{"kind":"a","x":"2"}')), both(mkAx())]);
