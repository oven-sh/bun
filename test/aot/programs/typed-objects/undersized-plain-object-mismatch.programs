//// unions-told-apart-by-a-tag-that-starts-at-zero.ts
// The literal type 0 is the integer: a union of objects whose tags are 0, 1 and 2 is told apart by the tag alone, as one whose tags are 1, 2 and 3. A -0 where TypeScript lets it pass for 0 behaves as in plain Bun
type Circle = { shape: 0; radius: number };
type Square = { shape: 1; side: number };
type Box = { shape: 2; width: number; height: number };
function area(s: Circle | Square | Box): number { return s.shape === 0 ? s.radius * s.radius * 3 : s.shape === 1 ? s.side * s.side : s.width * s.height; }
const shapes: (Circle | Square | Box)[] = [{ shape: 0, radius: 1 }, { shape: 1, side: 2 }, { shape: 2, width: 3, height: 4 }];

class Light { state: 0 | 1 | 2 = 0; next(): 0 | 1 | 2 { this.state = this.state === 2 ? 0 : this.state === 1 ? 2 : 1; return this.state; } }
function compare(a: number, b: number): -1 | 0 | 1 { return a < b ? -1 : a > b ? 1 : 0; }

// TypeScript has one type for 0 and -0.
const negative: 0 = -0;
let held: 0 | 1 = -0;
function pass(zero: 0): 0 { return zero; }
function comparedWithZero(x: number): number { return x === 0 ? 1 / x : 2; }
function keptAfterComparison(x: number): number { const kept: 0 | 1 = x === 0 ? x : 1; return 1 / kept; }
function switched(x: number): number { switch (x) { case 0: return 1 / x; default: return 3; } }
function ofUnknown(x: unknown): number { return x === 0 ? 1 / x : 4; }
const tagged: Circle = { shape: -0, radius: 2 };

let total = 0;
const light = new Light();
for (let i = 0; i < 3000; i++) total += area(shapes[i % 3]) + light.next() + compare(i & 3, 2);

// A stranger reaches the function, so that its parameter is not known from its callers alone.
const stranger: any = JSON.parse(process.argv[2] ?? "null");
if (stranger !== null) total += (area as any)(stranger);
console.log(total, 1 / negative, 1 / held, 1 / pass(-0), 1 / pass(0), Object.is(pass(-0), -0));
held = 1;
console.log(held, comparedWithZero(-0), comparedWithZero(0), keptAfterComparison(-0), keptAfterComparison(0), switched(-0), switched(0), ofUnknown(-0), ofUnknown(0));
console.log(1 / tagged.shape, area(tagged), Object.is(tagged.shape, -0));
//// untyped-code-tampers-with-typed-objects.ts
// Untyped code gives a typed object a value of another kind, an accessor or another prototype. Every change succeeds as in plain Bun, and the next typed read of a field that holds another kind throws a TypeError.
////= attempt
function outcome(f: () => unknown): string { try { f(); return "stored" } catch (e) { return (e as Error).constructor.name } }
interface Rec { n: number; s: string; b: boolean; o?: number }
function fresh(): Rec { return { n: 1, s: "s", b: true } }
function poke(target: any, key: string, value: unknown) { target[key] = value }
attempt("a1", () => { const r: Rec = fresh(); return outcome(() => poke(r, "n", "text")) + " " + r.n })
attempt("a2", () => { const r: Rec = fresh(); return outcome(() => poke(r, "n", "text")) + " " + JSON.stringify(r) })
attempt("a3", () => { const r: Rec = fresh(); return outcome(() => poke(r, "n", 5)) + " " + (r.n + 1) })
attempt("a4", () => { const r: Rec = fresh(); return outcome(() => poke(r, "s", 5)) + " " + r.s })
attempt("a5", () => { const r: Rec = fresh(); return outcome(() => poke(r, "b", 0)) + " " + r.b })
attempt("a6", () => { const r: Rec = fresh(); return outcome(() => poke(r, "o", "opt")) + " " + r.o + " " + ("o" in r) })
attempt("a7", () => { const r: Rec = fresh(); return outcome(() => poke(r, "o", 3)) + " " + r.o + " " + Object.keys(r).join() })
attempt("a8", () => { const r: Rec = fresh(); return outcome(() => poke(r, "n", 2.5)) + " " + r.n })
// `undefined` and `null` pass every written type. An optional field that is stored `undefined` is there.
attempt("a9", () => { const r: Rec = fresh(); return outcome(() => poke(r, "n", undefined)) + " " + r.n })
attempt("a10", () => { const r: Rec = fresh(); return outcome(() => poke(r, "n", null)) + " " + r.n })
attempt("a11", () => { const r: Rec = fresh(); return outcome(() => poke(r, "s", undefined)) + " " + r.s + " " + Object.keys(r).join() })
attempt("a12", () => { const r: Rec = fresh(); return outcome(() => poke(r, "s", null)) + " " + r.s })
attempt("a13", () => { const r: Rec = fresh(); return outcome(() => poke(r, "o", undefined)) + " " + r.o + " " + ("o" in r) })
attempt("a14", () => { const r: Rec = fresh(); return outcome(() => poke(r, "extra", "anything")) + " " + Object.keys(r).join() })
// The other ways to write a field.
attempt("b1", () => { const r: Rec = fresh(); return outcome(() => Reflect.set(r, "n", {})) + " " + r.n })
attempt("b2", () => { const r: Rec = fresh(); return outcome(() => (Object.assign as any)(r, { n: "assigned" })) + " " + r.n })
attempt("b3", () => { const r: Rec = fresh(); return outcome(() => Object.defineProperty(r, "n", { value: "defined" })) + " " + r.n })
attempt("b4", () => { const r: Rec = fresh(); return outcome(() => Object.defineProperty(r, "n", { get: () => "got", configurable: true })) + " " + r.n })
attempt("b5", () => { const r: Rec = fresh(); return outcome(() => Object.defineProperty(r, "n", { get: () => 9, configurable: true })) + " " + r.n })
attempt("b6", () => { const r: Rec = fresh(); Object.defineProperty(r, "n", { value: 9 }); return r.n + 1 })
attempt("b7", () => { const r: Rec = fresh(); return Reflect.set(r, "n", 5) + " " + r.n })
attempt("b8", () => { const r: Rec = fresh(); (Object.assign as any)(r, { n: 5 }); return r.n + 1 })
// An update of the field begins with a typed read.
attempt("c1", () => { const r: Rec = fresh(); const tried = outcome(() => poke(r, "n", "5")); r.n++; return tried + " " + r.n })
attempt("c2", () => { const r: Rec = fresh(); const tried = outcome(() => poke(r, "n", "5")); r.n += 1; return tried + " " + (r as any).n })
class Acc { total = 0; add(n: number) { this.total += n; return this.total } get half() { return this.total / 2 } }
attempt("d1", () => { const a = new Acc(); return outcome(() => poke(a, "total", "0")) + " " + a.add(1) })
attempt("d2", () => { const a = new Acc(); return outcome(() => poke(a, "total", 10)) + " " + a.add(1) })
attempt("d3", () => { const a = new Acc(); return outcome(() => poke(a, "total", "8")) + " " + a.half })
// Another prototype: an absent optional field is inherited from it, and what the typed read finds there is tested like an own field.
attempt("e1", () => { const r: Rec = fresh(); return outcome(() => Object.setPrototypeOf(r, { o: "inherited" })) + " " + r.o })
attempt("e2", () => { const r: Rec = fresh(); return outcome(() => Object.setPrototypeOf(r, { o: 4 })) + " " + r.o })
attempt("e3", () => { const r: Rec = fresh(); return Reflect.setPrototypeOf(r, { o: 4 }) + " " + r.o })
attempt("e4", () => { const r: Rec = fresh(); return Object.setPrototypeOf(r, Object.prototype) === r })
attempt("e5", () => fresh().o)
// The prototype object of a class takes a property like any other object.
class Made { n = 1; s = "s"; b = true }
attempt("e6", () => { const r: Rec = new Made(); return outcome(() => { (Made.prototype as any).o = "polluted" }) + " " + r.o })
attempt("e7", () => { const r: Rec = new Made(); return outcome(() => { (Made.prototype as any).o = 12 }) + " " + (r as any).o })
attempt("e8", () => { const r: Rec = new Made(); return r.o })
function Old(this: Rec) { this.n = 1; this.s = "s"; this.b = true }
attempt("e9", () => { const r: Rec = new (Old as any)(); return r.o })
// One of three objects at one access site.
attempt("f1", () => {
  const all = [fresh(), fresh(), fresh()]
  all[2].n = 3
  return outcome(() => poke(all[1], "n", "two")) + " " + all.map(r => r.n).join()
})
//// untyped-function-results-checked.ts
// The result of an untyped function that is called through a type promising a primitive is checked where the call returns.
/* expected
a1 6
a2 TypeError
a3 TypeError
b1 s!
b2 TypeError
c1 true
c2 TypeError
c3 TypeError
d1 TypeError
d2 1,2
e1 TypeError
e2 3
f1 TypeError
f2 4
f3 TypeError
f4 big
f5 TypeError
f6 4
f7 object
f8 4
g1 TypeError
g2 ab
h1 TypeError
h2 10
i1 TypeError
i2 2
j1 51
j2 string
*/
////= attempt
const parse: (text: string) => number = JSON.parse
attempt("a1", () => parse("5") + 1)
attempt("a2", () => parse('"5"') + 1)
attempt("a3", () => parse("[5]") + 1)
const identity: (v: unknown) => string = (v: any) => v
attempt("b1", () => identity("s") + "!")
attempt("b2", () => identity(5) + "!")
function untyped(v: any) { return v }
function typed(v: any): boolean { return untyped(v) }
attempt("c1", () => typed(true))
attempt("c2", () => { const b: boolean = typed("true"); return b })
attempt("c3", () => { const b: boolean = typed(1); return b })
attempt("d1", () => ["a"].map((x: any): number => x).join())
attempt("d2", () => [1, 2].map((x: any): number => x).join())
const loose: any = (v: unknown) => v
attempt("e1", () => { const n: number = loose("3"); return n })
attempt("e2", () => { const n: number = loose(3); return n })
// Methods of objects of the program.
interface Api { size(): number }
const wrong: Api = { size: (): any => "big" }
const right: Api = { size: () => 3 }
attempt("f1", () => wrong.size() + 1)
attempt("f2", () => right.size() + 1)
attempt("f3", () => { const apis: Api[] = [right, wrong]; let s = 0; for (const a of apis) s += a.size(); return s })
attempt("f4", () => (wrong as any).size())
// An ordinary object (a literal checked against `any` is one) passes the cast as it is. Its function is called as the type says.
const plainWrong: any = { size: () => "big" }, plainRight: any = { size: () => 3 }
attempt("f5", () => (plainWrong as Api).size() + 1)
attempt("f6", () => (plainRight as Api).size() + 1)
// An object of the program that was created as another type passes the cast as it is.
attempt("f7", () => typeof ({ size: () => "big" } as unknown as Api))
attempt("f8", () => ({ size: () => 3 } as unknown as Api).size() + 1)
// A function value that travels through a field of function type.
interface Holder { make: (a: string, b: string) => string }
const holder: Holder = { make: (a, b) => a + b }
attempt("g1", () => { (holder as any).make = () => 7; return holder.make("a", "b").length })
attempt("g2", () => { (holder as any).make = (a: string, b: string) => a + b; return holder.make("a", "b") })
// Callbacks: the caller was promised a number.
function apply(f: (n: number) => number, n: number): number { return f(n) * 2 }
attempt("h1", () => apply(untyped.bind(null, "x"), 5))
attempt("h2", () => apply(untyped, 5))
// Accessors count as functions.
class Gauge { raw: any = 1; get level(): number { return this.raw } }
attempt("i1", () => { const g = new Gauge(); g.raw = "high"; return g.level + 1 })
attempt("i2", () => new Gauge().level + 1)
// Nothing was promised: nothing is checked.
attempt("j1", () => untyped("5") + 1)
attempt("j2", () => typeof loose("3"))
//// untyped-handler-proxies-into-annotated-slots.ts
// `new Proxy(target, handler)` is of type `any` where the handler is a `ProxyHandler<any>`. Such a proxy may go wherever a type is written down: what it
// answers is looked at when it is read. Each case has an object type of its own, which the program also makes objects of, so that no case opens the type for another.
function tell(name: string, f: () => unknown): void {
  try {
    console.log(name + ": " + JSON.stringify(f()));
  } catch (e) {
    console.log(name + ": " + String(e).split("\n")[0]);
  }
}

const handler: ProxyHandler<any> = {
  get(target, property) {
    return property === "color" ? "trapped" : property === "inner" ? { n: 7 } : property === "grow" ? () => 8 : Reflect.get(target, property);
  },
};

type InnerOfParameter = { n: number };
type ToParameter = { color: string; inner: InnerOfParameter; grow(): number; parameter?: true };
const makeForParameter = (n: number): ToParameter => ({ color: "red", inner: { n }, grow() { return this.inner.n + 1; } });
const readParameter = (style: ToParameter) => [style.color, style.inner.n, style.grow()];
tell("made by the program, to a parameter", () => readParameter(makeForParameter(1)));
tell("a proxy, to a parameter", () => readParameter(new Proxy({}, handler)));

type InnerOfResult = { n: number };
type AsResult = { color: string; inner: InnerOfResult; grow(): number; result?: true };
const makeForResult = (n: number): AsResult => ({ color: "red", inner: { n }, grow() { return this.inner.n + 1; } });
function proxyAsResult(): AsResult {
  return new Proxy({}, handler);
}
const readResult = (style: AsResult) => [style.color, style.inner.n, style.grow()];
tell("made by the program, returned", () => readResult(makeForResult(1)));
tell("a proxy, returned", () => readResult(proxyAsResult()));

type InnerOfMethod = { n: number };
type FromMethod = { color: string; inner: InnerOfMethod; grow(): number; method?: true };
class Client {
  made(n: number): FromMethod {
    return { color: "red", inner: { n }, grow() { return this.inner.n + 1; } };
  }
  style(selector: string): FromMethod {
    return new Proxy({ selector }, handler);
  }
}
const readMethod = (style: FromMethod) => [style.color, style.inner.n, style.grow()];
tell("made by the program, returned by a method", () => readMethod(new Client().made(1)));
tell("a proxy, returned by a method", () => readMethod(new Client().style("body")));

type InnerOfTarget = { n: number };
type OverTarget = { color: string; inner: InnerOfTarget; grow(): number; target?: true };
const makeTarget = (n: number): OverTarget => ({ color: "red", inner: { n }, grow() { return this.inner.n + 1; } });
const readTarget = (style: OverTarget) => [style.color, style.inner.n, style.grow()];
tell("a proxy over an object of the type", () => readTarget(new Proxy(makeTarget(4), handler)));

type InnerOfChoice = { n: number };
type ByChoice = { color: string; inner: InnerOfChoice; grow(): number; choice?: true };
const makeChoice = (n: number): ByChoice => ({ color: "red", inner: { n }, grow() { return this.inner.n + 1; } });
const readChoice = (style: ByChoice) => [style.color, style.inner.n, style.grow()];
const choose = (proxied: boolean): ByChoice => (proxied ? new Proxy({}, handler) : makeChoice(2));
tell("one arm of a conditional is a proxy", () => [readChoice(choose(true)), readChoice(choose(false))]);
//// untyped-holder-into-union-1.ts
// The parts of the union differ only in what hangs below them. An untyped object that holds an object of the program passes as the union, and both stay the objects they were. Each program of this family has one way into the type.
type Cat = { name: string; lives: number }; type Dog = { name: string; tricks: string }; type Bird = { name: string; wings: number }; type Fish = { name: string; fins: number }; type Ant = { name: string; legs: number };
type CatBox = { pet: Cat }; type DogBox = { pet: Dog }; type BirdBox = { pet: Bird }; type FishBox = { pet: Fish }; type AntBox = { pet: Ant };
type Box = CatBox | DogBox | BirdBox | FishBox | AntBox;
const made: unknown[] = [((): CatBox => ({ pet: { name: "c", lives: 9 } }))(), ((): DogBox => ({ pet: { name: "d", tricks: "t" } }))(), ((): BirdBox => ({ pet: { name: "b", wings: 2 } }))(), ((): FishBox => ({ pet: { name: "f", fins: 3 } }))(), ((): AntBox => ({ pet: { name: "a", legs: 6 } }))()];
function hide(v: unknown): any { return v }
function nameOf(b: Box): string { return b.pet.name }
for (let round = 0; round < 3; round++) { const d: Dog = { name: "rex", tricks: "sit" }; const raw: any = {}; raw.pet = d; const b: Box = raw; console.log(nameOf(b), (b.pet as unknown) === d, (b as unknown) === raw, hide(b.pet).tricks, made.length); }
//// untyped-holder-into-union-2.ts
