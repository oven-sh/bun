////= lines-4	Reading	n	number

import { JSON } from "bun"; function uses(reading: Reading): unknown[] {
  const n = reading.n;
  return [n, typeof n, n + 1, n * 2, n | 0, n >>> 0, 1 / n, n === Math.floor(n), Number.isSafeInteger(n), String(n), JSON.stringify(reading)];
}
function sumOf(list: number[]): number {
  let sum = 0;
  for (const n of list) sum += n;
  return sum;
}

const spellings = ["0", "-0", "0.0", "-0.0", "0e0", "-0e-0", "1.0", "1.50", "1e0", "1E2", "1e+2", "1e-2", "100e-2", "2147483647", "2147483648", "-2147483648", "-2147483649", "4294967295", "4294967296", "9007199254740991", "9007199254740992", "9007199254740993", "12345678901234567890", "1e21", "1e308", "1.7976931348623157e308", "5e-324", "1e-400", "-1e-400", "0.1", "0.30000000000000004", "123456789.123456789", "1.0000000000000000000000000000001", "0.000001", "0.0000001"];

let warm = 0;
for (let i = 0; i < 2000; i++) warm += uses({ n: i }).length;
console.log("2000 honest literals with integers", warm);

for (const spelling of spellings) attempt(spelling, () => uses(JSON.parse<Reading>('{"n":' + spelling + "}")));
attempt("alone", () => spellings.map(spelling => JSON.parse<number>(spelling)));
attempt("in one list", () => {
  const list = JSON.parse<number[]>("[" + spellings.join(",") + "]");
  return [list.length, list, sumOf(list.slice(0, 12))];
});
attempt("integers and then a fraction", () => {
  const list = JSON.parse<number[]>("[1,2,3,4,5,6,7,8,0.5]");
  return [list, sumOf(list)];
});
attempt("integers and then negative zero", () => {
  const list = JSON.parse<number[]>("[1,2,-0]");
  return [list, 1 / list[2], list.indexOf(0), list.includes(-0), Object.is(list.at(-1), -0)];
});
//// parsed-by-type-optional-null-and-absent-members.ts
////= show-2

import { JSON } from "bun"; interface Profile {
  name: string;
  age?: number;
  nick: string | null;
  tags?: string[] | null;
  inner?: { deep?: number };
}

function describe(profile: Profile): unknown[] {
  return [
    profile.name,
    profile.age,
    profile.age === undefined ? "no age" : profile.age + 1,
    profile.nick,
    profile.nick === null ? "no nick" : profile.nick.length,
    profile.tags,
    profile.tags?.length ?? "no tags",
    profile.inner?.deep ?? "not deep",
    "age" in profile,
    "tags" in profile,
    "inner" in profile,
    Object.keys(profile),
    JSON.stringify(profile),
  ];
}

const texts = [
  '{"name":"a","nick":null}',
  '{"name":"b","nick":"bee","age":1}',
  '{"name":"c","nick":"","age":0,"tags":[]}',
  '{"name":"d","nick":null,"tags":null}',
  '{"name":"e","nick":null,"inner":{}}',
  '{"name":"f","nick":null,"inner":{"deep":-0}}',
  '{"inner":{"deep":1,"deeper":2},"tags":["x"],"age":1.5,"nick":"n","name":"g"}',
];

let warm = 0;
for (let i = 0; i < 2000; i++) warm += describe(i % 2 ? { name: "n", nick: null } : { name: "n", nick: "k", age: i, tags: ["t"], inner: { deep: i } }).length;
console.log("2000 honest literals", warm);

for (const text of texts) attempt(text, () => describe(JSON.parse<Profile>(text)));
attempt("optional members are added later", () => {
  const profile = JSON.parse<Profile>('{"name":"a","nick":null}');
  profile.age = 3;
  profile.inner = { deep: 4 };
  profile.tags = null;
  return describe(profile);
});
attempt("optional members are deleted later", () => {
  const profile = JSON.parse<Profile>('{"name":"b","age":1,"nick":"n","tags":["x"],"inner":{"deep":2}}');
  delete profile.age;
  delete profile.inner;
  profile.tags = undefined;
  return describe(profile);
});
attempt("mapped types", () => {
  const part = JSON.parse<Partial<Profile>>("{}");
  const picked = JSON.parse<Pick<Profile, "name" | "age">>('{"name":"p","nick":5}');
  const whole = JSON.parse<Required<Pick<Profile, "age">>>('{"age":2}');
  return [part, Object.keys(part), part.name, picked, picked.name.length, whole.age + 1];
});
//// parsed-by-type-results-and-literals-go-through-one-function.ts
////= show-2

////= Point
import { JSON } from "bun"; class Dot implements Point {
  constructor(
    public x: number,
    public y: number,
  ) {}
}

////= norm
function move(point: Point, by: number): Point {
  point.x += by;
  point.y -= by;
  return point;
}
function keys(point: Point): string {
  return Object.keys(point).join();
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += norm({ x: i, y: 1 }) + norm(new Dot(1, i)) + move({ x: i, y: i }, 1).x;
console.log("2000 honest literals and instances", warm);

const texts = ['{"x":3,"y":4}', '{"y":4,"x":3}', '{"x":0.5,"y":-0}', '{"w":0,"x":3,"y":4}', '{"x":3,"w":0,"y":4}', '{"x":3,"y":4,"z":5}', '{"y":1e21,"z":{},"x":1e-7}', '{"0":1,"x":3,"y":4}'];
for (const text of texts) {
  attempt(text, () => {
    const point = JSON.parse<Point>(text);
    return [norm(point), keys(point), move(point, 1), keys(point), JSON.stringify(point)];
  });
}
attempt("in one list with literals and instances", () => {
  const points: Point[] = [{ x: 1, y: 2 }, JSON.parse<Point>('{"y":2,"x":1}'), new Dot(1, 2), JSON.parse<Point>('{"z":0,"x":1,"y":2}'), { y: 2, x: 1 }];
  return [points.map(norm), points.map(keys), points.map(point => move(point, 0.5).x)];
});
attempt("a list that was parsed, then pushed to", () => {
  const points = JSON.parse<Point[]>('[{"x":1,"y":1},{"y":2,"x":2}]');
  points.push({ x: 3, y: 3 }, new Dot(4, 4));
  return [points.map(norm), points.map(keys)];
});
attempt("parsed 2000 times, each third with other keys", () => {
  let sum = 0;
  for (let i = 0; i < 2000; i++) sum += norm(JSON.parse<Point>(i % 3 === 0 ? '{"x":1,"y":2}' : i % 3 === 1 ? '{"y":2,"x":1}' : '{"k' + i + '":0,"x":1,"y":2}'));
  return sum;
});
attempt("honest again", () => [norm({ x: 3, y: 4 }), norm(new Dot(3, 4)), keys(new Dot(0, 0))]);
//// parsed-by-type-results-are-changed-afterwards.ts
////= show-2

import { JSON } from "bun"; interface Account {
  id: number;
  owner: string;
  limits: { daily: number };
}

////= lines-3	idOf	account	Account	number	account.id
function ownerLength(account: Account): number {
  return account.owner.length;
}
function daily(account: Account): number {
  return account.limits.daily * 2;
}
function look(account: Account): unknown[] {
  return [idOf(account), account.owner, daily(account), Object.keys(account), JSON.stringify(account)];
}
function fresh(): Account {
  return JSON.parse<Account>('{"id":1,"owner":"ann","limits":{"daily":10}}');
}

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const account = fresh();
  warm += idOf(account) + ownerLength(account) + daily(account);
}
console.log("2000 honest rounds", warm);

attempt("typed stores", () => {
  const account = fresh();
  account.id = 2.5;
  account.owner = "bob";
  account.limits = { daily: -0 };
  return look(account);
});
attempt("a member is added", () => {
  const account = fresh();
  Object.assign(account, { extra: true, another: [1] });
  return look(account);
});
attempt("a member is deleted by reflection", () => {
  const account = fresh();
  Reflect.deleteProperty(account, "id");
  return [idOf(account), idOf(account) + 1, Object.keys(account), "id" in account];
});
attempt("a deleted member is used", () => {
  const account = fresh();
  Reflect.deleteProperty(account, "owner");
  return ownerLength(account);
});
attempt("a member gets another kind of value by reflection", () => {
  const account = fresh();
  Reflect.set(account, "id", "seven");
  Reflect.set(account, "limits", null);
  return [idOf(account), typeof idOf(account), idOf(account) + 1, JSON.stringify(account)];
});
attempt("the member that is now null is used", () => {
  const account = fresh();
  Reflect.set(account, "limits", null);
  return daily(account);
});
attempt("a member becomes an accessor", () => {
  const account = fresh();
  let reads = 0;
  Object.defineProperty(account, "id", { get: () => ++reads * 100, enumerable: true, configurable: true });
  return [idOf(account), idOf(account), reads, JSON.stringify(account)];
});
attempt("frozen", () => {
  const account = Object.freeze(fresh());
  const open: Account = account;
  let threw = "no";
  try {
    open.id = 5;
  } catch (error) {
    threw = error instanceof Error ? error.constructor.name : typeof error;
  }
  open.limits.daily = 50;
  return [threw, look(account)];
});
attempt("given another prototype", () => {
  const account = fresh();
  Object.setPrototypeOf(account, { inherited: 1, id: 99 });
  Reflect.deleteProperty(account, "id");
  return [idOf(account), Object.keys(account), "inherited" in account, JSON.stringify(account)];
});
attempt("given no prototype", () => {
  const account = fresh();
  Object.setPrototypeOf(account, null);
  return [idOf(account), daily(account), Object.keys(account), JSON.stringify(account)];
});
attempt("very many members are added", () => {
  const account = fresh();
  const open: Record<string, unknown> = { ...account };
  for (let i = 0; i < 200; i++) Reflect.set(account, "k" + i, i);
  return [idOf(account), daily(account), Object.keys(account).length, Object.keys(open).length];
});
attempt("honest again", () => look(fresh()));
//// parsed-by-type-strings-with-escapes-and-lone-surrogates.ts
////= show-2

////= lines	Note	title	string	body	string

import { JSON } from "bun"; function codes(text: string): string {
  const parts: string[] = [];
  for (let i = 0; i < text.length; i++) parts.push(text.charCodeAt(i).toString(16));
  return parts.join(" ");
}
function uses(note: Note): unknown[] {
  return [codes(note.title), note.title.length, codes(note.body), note.title + note.body === note.title.concat(note.body), note.title === note.body, codes(JSON.stringify(note.title)), note.title.isWellFormed()];
}

const values = ['""', '"a"', '"\\""', '"\\\\"', '"\\/"', '"\\b\\f\\n\\r\\t"', '"\\u0000"', '"\\u0041"', '"\\u00e9"', '"é"', '"\\u65e5"', '"日"', '"\\ud83d\\ude00"', '"😀"', '"\\ud800"', '"\\udc00"', '"\\ude00\\ud83d"', '"a\\ud800b"', '"\\uD83D"', '"\\u2028\\u2029"', '"\u007f"', '"\\uFFFF"', '"\\ufeff"'];
for (const value of values) {
  attempt(codes(value), () => uses(JSON.parse<Note>('{"title":' + value + ',"body":"a"}')));
}
attempt("declared keys written with escapes", () => {
  const note = JSON.parse<Note>('{"\\u0074itle":"t","bod\\u0079":"b"}');
  return [note, Object.keys(note), note.title, note.body];
});
attempt("declared keys written with every letter escaped", () => {
  const note = JSON.parse<Note>('{"\\u0074\\u0069\\u0074\\u006c\\u0065":"t","\\u0062\\u006F\\u0064\\u0079":"b"}');
  return [note, Object.keys(note), note.title, note.body];
});
attempt("keys that only look like the declared ones", () => {
  const note = JSON.parse<Note>('{"title":"t","body":"b","tіtle":"cyrillic","title\\u0000":"nul","Title":"upper","title ":"space"}');
  return [Object.keys(note).map(codes), note.title, note.body];
});
attempt("keys that are lone surrogates", () => {
  const table = JSON.parse<Record<string, number>>('{"\\ud800":1,"\\udc00":2,"\\ud800\\udc00":3,"":4}');
  return [Object.keys(table).map(codes), table["\ud800"], table["\udc00"], table["𐀀"], table[""]];
});
attempt("a text in 16 bits", () => {
  const note = JSON.parse<Note>('{"title":"日本","body":"語","日":"本"}');
  return [note, uses(note)];
});
