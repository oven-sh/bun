for (const tail of tails) attempt("followed by " + JSON.stringify(tail), () => classOf(() => JSON.parse<Item>(whole + tail)));
for (const head of [",", "﻿", " ", "\v", "+", "(", "'"]) attempt("after " + JSON.stringify(head), () => classOf(() => JSON.parse<Item>(head + whole)));

