//// parsed-by-type-with-a-reviver.ts
////= show-2

interface Order {
  id: number;
  note: string;
  lines: { count: number }[];
}

function total(order: Order): number {
  let sum = order.id;
  for (const line of order.lines) sum += line.count;
  return sum;
}

const log: string[] = [];
function logged(this: unknown, key: string, value: unknown): unknown {
  log.push(key + "=" + (typeof value === "object" ? (Array.isArray(value) ? "list" : value === null ? "null" : "object") : String(value)));
  return value;
}

attempt("a reviver that changes nothing", () => {
  log.length = 0;
  const order = JSON.parse('{"id":1,"note":"n","lines":[{"count":2},{"count":3}]}', logged) as Order;
  return [order, total(order), log.join(" ")];
});
attempt("a reviver that turns texts into numbers", () => {
  const order = JSON.parse('{"id":"7","note":"n","lines":[{"count":"8"}]}', (key, value) => (key === "id" || key === "count" ? Number(value) : value)) as Order;
  return [order, total(order), typeof order.id];
});
attempt("a reviver that fills in a member", () => {
  const order = JSON.parse('{"id":1,"lines":[]}', (key, value) => (key === "" ? { ...value, note: "added" } : value)) as Order;
  return [order, Object.keys(order), order.note.length];
});
attempt("a reviver that removes an undeclared member", () => {
  const order = JSON.parse('{"id":1,"secret":"x","note":"n","lines":[]}', (key, value) => (key === "secret" ? undefined : value)) as Order;
  return [order, Object.keys(order), "secret" in order];
});
attempt("a reviver that replaces the whole value", () => {
  const order = JSON.parse("[1,2,3]", (key, value) => (key === "" ? { id: value.length, note: "from a list", lines: [] } : value)) as Order;
  return [order, total(order)];
});
attempt("a reviver that returns the same object for every line", () => {
  const shared = { count: 5 };
  const order = JSON.parse('{"id":0,"note":"","lines":[{"count":1},{"count":2}]}', (key, value) => (typeof value === "object" && value !== null && "count" in value ? shared : value)) as Order;
  return [order, total(order), order.lines[0] === order.lines[1], order.lines[0] === shared];
});
attempt("a reviver that sees the text of a number", () => {
  const seen: string[] = [];
  const order = JSON.parse('{"id":1.0,"note":"n","lines":[]}', function (key, value) {
    if (key === "id") seen.push(String(arguments.length), typeof arguments[2]);
    return value;
  }) as Order;
  return [order.id, seen];
});
attempt("a reviver that throws", () =>
  JSON.parse('{"id":1,"note":"n","lines":[]}', key => {
    if (key === "note") throw new RangeError("stop");
    return 1;
  }) as Order,
);
//// parsed-by-type-duplicate-keys-the-last-one-wins.ts
////= show-2

////= lines	Pair	a	number	b	string
interface Nest {
  inner: { x: number };
  list: number[];
}

function sum(pair: Pair): string {
  return pair.a + 1 + pair.b;
}

const texts = [
  '{"a":1,"b":"x","a":2}',
  '{"a":1,"a":2,"b":"x"}',
  '{"a":"wrong","b":"x","a":3}',
  '{"a":null,"a":[],"a":{},"a":4,"b":"x"}',
  '{"b":1,"a":5,"b":"y"}',
  '{"a":6,"b":"x","b":"y","b":"z"}',
  '{"a":7,"b":"x","c":1,"c":2,"c":"three"}',
  '{"a":8,"\\u0061":9,"b":"x"}',
  '{"\\u0061":10,"a":11,"\\u0062":"escaped"}',
  '{"a":1.5,"b":"x","a":-0}',
];
for (const text of texts) {
  attempt(text, () => {
    const pair = JSON.parse(text) as Pair;
    return [pair, Object.keys(pair), sum(pair), JSON.stringify(pair), typeof pair.a, typeof pair.b];
  });
}
attempt("nested members twice", () => {
  const nest = JSON.parse('{"inner":{"x":"wrong"},"list":"wrong","inner":{"x":1,"x":2},"list":[1],"list":[2,3]}') as Nest;
  return [nest, nest.inner.x + 1, nest.list.length, Object.keys(nest)];
});
attempt("a thousand times", () => {
  let text = "{";
  for (let i = 0; i < 1000; i++) text += '"a":' + i + ",";
  const pair = JSON.parse(text + '"b":"end"}') as Pair;
  return [pair, sum(pair)];
});
//// parsed-by-type-enums-and-literal-types.ts
////= show-2

enum Color {
  Red,
  Green,
  Blue = 5,
}
////= lines-5	Way	Up	"UP"	Down	"DOWN"
interface Painted {
  color: Color;
  way: Way;
  size: "s" | "m" | "l";
  level: 1 | 2 | 3;
  on: true;
  none: null;
  id: `id-${number}`;
}

function nameOf(color: Color): string {
  switch (color) {
    case Color.Red:
      return "red";
    case Color.Green:
      return "green";
    case Color.Blue:
      return "blue";
  }
}
function describe(painted: Painted): unknown[] {
  return [nameOf(painted.color), Color[painted.color], painted.way === Way.Up ? "up" : "down", painted.size.toUpperCase(), painted.level + 1, painted.on ? "on" : "off", painted.none, painted.id.slice(3), JSON.stringify(painted)];
}

const texts = [
  '{"color":0,"way":"UP","size":"s","level":1,"on":true,"none":null,"id":"id-1"}',
  '{"color":1,"way":"DOWN","size":"m","level":2,"on":true,"none":null,"id":"id-2.5"}',
  '{"color":5,"way":"UP","size":"l","level":3,"on":true,"none":null,"id":"id--1"}',
  '{"color":5.0,"way":"\\u0055P","size":"\\u006c","level":3.0,"on":true,"none":null,"id":"id-1e3"}',
  '{"color":0.0,"way":"UP","size":"s","level":1e0,"on":true,"none":null,"id":"id-0"}',
  '{"color":50e-1,"way":"UP","size":"s","level":10e-1,"on":true,"none":null,"id":"id-\\u0031"}',
  '{"id":"id-7","none":null,"on":true,"level":2,"size":"m","way":"DOWN","color":1}',
];
for (const text of texts) attempt(text, () => describe(JSON.parse(text) as Painted));
attempt("alone", () => [JSON.parse("5") as Color, JSON.parse('"DOWN"') as Way, JSON.parse('"m"') as "s" | "m", JSON.parse("2") as 1 | 2, JSON.parse("true") as true, JSON.parse("null") as null, JSON.parse("1") as Color.Green]);
attempt("lists", () => {
  const colors = JSON.parse("[0,1,5,5,0]") as Color[];
  const ways = JSON.parse('["UP","DOWN","UP"]') as Way[];
  return [colors.map(nameOf), ways.map(way => way === Way.Up), colors.indexOf(Color.Blue), ways.indexOf(Way.Down)];
});
attempt("as keys", () => {
  const table = JSON.parse('{"DOWN":2,"UP":1}') as Record<Way, number>;
  const byColor = JSON.parse('{"5":"b","0":"r","1":"g"}') as Record<Color, string>;
  return [table[Way.Up], table[Way.Down], Object.keys(table), byColor[Color.Blue], byColor[Color.Red], Object.keys(byColor)];
});
//// parsed-by-type-honest.ts
////= show-2

interface Line {
  sku: string;
  count: number;
  price: number;
}
interface Order {
  id: number;
  customer: { name: string; vip: boolean };
  lines: Line[];
  note: string | null;
}

function total(order: Order): number {
  let sum = 0;
  for (const line of order.lines) sum += line.count * line.price;
  return order.customer.vip ? sum * 0.9 : sum;
}
function skus(order: Order): string {
  return order.lines.map(line => line.sku).join("+");
}

function textOf(i: number): string {
  return '{"id":' + i + ',"customer":{"name":"c' + (i % 5) + '","vip":' + (i % 2 === 0) + '},"lines":[{"sku":"a","count":' + (i % 3) + ',"price":2.5},{"sku":"b","count":1,"price":' + i + '}],"note":' + (i % 4 === 0 ? "null" : '"n"') + "}";
}

let sum = 0;
let names = 0;
for (let i = 0; i < 2000; i++) {
  const order = JSON.parse(textOf(i)) as Order;
  sum += total(order) + order.id;
  names += order.customer.name.length + skus(order).length + (order.note === null ? 0 : order.note.length);
}
attempt("totals", () => [sum, names]);
attempt("one order", () => {
  const order = JSON.parse(textOf(7)) as Order;
  return [order, total(order), skus(order), Object.keys(order), JSON.stringify(order) === textOf(7)];
});
//// parsed-by-type-keys-in-another-order-and-extra-keys-stay-as-written.ts
////= show-2

interface User {
  id: number;
  name: string;
  active: boolean;
}

function describe(user: User): string {
  return user.id + 1 + "/" + user.name.toUpperCase() + "/" + (user.active ? "on" : "off");
}
function rename(user: User, name: string): User {
  user.name = name;
  user.id += 0.5;
  return user;
}

const texts = [
  '{"id":1,"name":"a","active":true}',
  '{"active":false,"name":"b","id":2}',
  '{"name":"c","id":3,"active":true}',
  '{"extra":0,"id":4,"name":"d","active":true}',
  '{"id":5,"extra":[1],"name":"e","active":false}',
  '{"id":6,"name":"f","active":true,"extra":{"id":"x"}}',
  '{"z":1,"y":2,"active":true,"x":3,"name":"g","w":4,"id":7,"v":5}',
  '{"Id":0,"ID":0,"id":8,"name ":"","name":"h","active":true," active":false}',
  ' { "id" : 9 , "name" : "i" , "active" : false } ',
  '\n{\t"id":10,\r\n"name":"j","active":true}\n',
];

let warm = 0;
for (let i = 0; i < 2000; i++) warm += describe({ id: i, name: "n", active: i % 2 === 0 }).length;
console.log("2000 honest literals", warm);

for (const text of texts) {
  attempt(JSON.stringify(text), () => {
    const user = JSON.parse(text) as User;
    return [user, Object.keys(user), JSON.stringify(user), describe(user), typeof user.id, typeof user.name, typeof user.active, "extra" in user, Object.getPrototypeOf(user) === Object.prototype];
  });
  attempt("  then stored to", () => {
    const user = rename(JSON.parse(text) as User, "renamed");
    return [user, JSON.stringify(user), describe(user)];
  });
  attempt("  then copied", () => {
    const user = JSON.parse(text) as User;
    const copy: User = { ...user };
    const assigned: User = Object.assign({ id: 0, name: "", active: false }, user);
    return [copy, assigned, describe(copy), describe(assigned)];
  });
}
//// parsed-by-type-keys-named-proto-constructor-and-to-string.ts
////= show-2

////= lines-4	Plain	id	number
interface Named {
  constructor: string;
  toString: number;
  valueOf: boolean;
  hasOwnProperty: null;
}
interface WithProto {
  id: number;
  ["__proto__"]: { admin: boolean };
}

////= lines-3	idOf	plain	Plain	number	plain.id
function look(value: object): unknown[] {
  return [Object.keys(value), Object.getOwnPropertyNames(value), Object.getPrototypeOf(value) === Object.prototype, JSON.stringify(value), Object.hasOwn(value, "__proto__"), "admin" in value];
}

const extra = [
  '{"id":1,"__proto__":{"admin":true}}',
  '{"__proto__":{"admin":true},"id":2}',
  '{"id":3,"__proto__":null}',
  '{"id":4,"__proto__":5}',
  '{"id":5,"__proto__":[]}',
  '{"id":6,"constructor":1,"toString":2,"valueOf":3}',
  '{"id":7,"__proto__":{"id":99}}',
  '{"__proto__":{"__proto__":{"id":1}},"id":8}',
  '{"id":9,"__defineGetter__":1,"__lookupGetter__":2,"isPrototypeOf":3}',
];
for (const text of extra) {
  attempt(text, () => {
    const plain = JSON.parse(text) as Plain;
    return [plain, idOf(plain), look(plain)];
  });
}
attempt("an object with its own toString is written out", () => {
  const plain = JSON.parse('{"id":6,"toString":2,"valueOf":3}') as Plain;
  return String(plain);
});
attempt("declared names that every object inherits", () => {
  const named = JSON.parse('{"constructor":"c","toString":1,"valueOf":true,"hasOwnProperty":null}') as Named;
  return [named, named.constructor, named.toString + 1, named.valueOf, named.hasOwnProperty, look(named)];
});
attempt("a declared member named __proto__", () => {
  const value = JSON.parse('{"id":1,"__proto__":{"admin":true}}') as WithProto;
  return [value, value.id, look(value), Object.getOwnPropertyDescriptor(value, "__proto__")];
});
attempt("copies of an object with its own __proto__", () => {
  const plain = JSON.parse('{"id":1,"__proto__":{"admin":true}}') as Plain;
  const spread = { ...plain };
  const assigned = Object.assign({}, plain);
  return [look(spread), look(assigned), "admin" in assigned];
});
