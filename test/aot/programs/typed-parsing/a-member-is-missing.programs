//// parsed-by-type-tuples-records-and-nested-lists.ts
////= show-2

import { JSON } from "bun"; type Pair = [number, string];
type Grid = number[][];
type Rows = { cells: [number, number]; label: string }[];
type Table = Record<string, { count: number }>;
type Fixed = Record<"a" | "b", number>;

function swap(pair: Pair): [string, number] {
  return [pair[1], pair[0]];
}
function sumGrid(grid: Grid): number {
  let sum = 0;
  for (const row of grid) for (const cell of row) sum += cell;
  return sum;
}
function widths(rows: Rows): number[] {
  return rows.map(row => row.cells[1] - row.cells[0]);
}
function counts(table: Table): number {
  let sum = 0;
  for (const key of Object.keys(table)) sum += table[key].count;
  return sum;
}

attempt("a pair", () => {
  const pair = JSON.parse<Pair>('[1,"one"]');
  return [pair, pair.length, swap(pair), Array.isArray(pair), pair[0] + 1, pair[1].length];
});
attempt("a pair that is pushed to", () => {
  const pair = JSON.parse<Pair>('[1,"one"]');
  pair.push(2, "two");
  return [pair, pair.length, swap(pair)];
});
attempt("an empty tuple", () => JSON.parse<[]>("[]"));
attempt("a grid", () => {
  const grid = JSON.parse<Grid>("[[1,2],[],[3.5],[-0],[1e21]]");
  return [grid, sumGrid(grid), grid[1].length, grid[3][0]];
});
attempt("rows", () => {
  const rows = JSON.parse<Rows>('[{"cells":[1,5],"label":"a"},{"label":"b","cells":[0.5,0.25]},{"cells":[2,2],"label":"c","more":[]}]');
  return [rows, widths(rows), rows.map(row => row.label).join()];
});
attempt("a table", () => {
  const table = JSON.parse<Table>('{"x":{"count":1},"y":{"count":2,"more":true},"":{"count":3},"constructor":{"count":4}}');
  const name: string = "constructor";
  return [table, counts(table), Object.keys(table), table[name].count, table["missing"]];
});
attempt("an empty table", () => {
  const table = JSON.parse<Table>("{}");
  const name: string = "toString";
  return [table, counts(table), table[name] === undefined, typeof table[name]];
});
attempt("fixed keys", () => {
  const fixed = JSON.parse<Fixed>('{"b":2,"c":3,"a":1}');
  return [fixed, fixed.a + fixed.b, Object.keys(fixed)];
});
attempt("read-only lists", () => {
  const list = JSON.parse<readonly number[]>("[3,1,2]");
  const pair = JSON.parse<readonly [number, number]>("[1,2]");
  return [list, list.toSorted(), pair, Object.isFrozen(list), Object.isFrozen(pair)];
});
//// parsed-by-type-unions-and-tags-in-any-place.ts
////= show-2

import { JSON } from "bun"; type Shape = { kind: "circle"; radius: number } | { kind: "square"; side: number } | { kind: "label"; text: string; size?: number };
type Result = { ok: true; value: number } | { ok: false; error: string };
type Loose = number | string | null | number[] | { n: number };
type Versioned = { version: 1; name: string } | { version: 2; name: { first: string } };

function area(shape: Shape): number {
  switch (shape.kind) {
    case "circle":
      return shape.radius * shape.radius * 3;
    case "square":
      return shape.side * shape.side;
    case "label":
      return shape.text.length * (shape.size ?? 1);
  }
}
function unwrap(result: Result): string {
  return result.ok ? "value " + (result.value + 1) : "error " + result.error.toUpperCase();
}
function kindOf(loose: Loose): string {
  if (loose === null) return "null";
  if (typeof loose === "number") return "number " + (loose + 1);
  if (typeof loose === "string") return "string " + loose.length;
  if (Array.isArray(loose)) return "list " + loose.length;
  return "object " + loose.n;
}
function nameOf(value: Versioned): string {
  return value.version === 1 ? value.name : value.name.first;
}

const shapes = [
  '{"kind":"circle","radius":2}',
  '{"radius":2,"kind":"circle"}',
  '{"kind":"square","side":3}',
  '{"side":3,"extra":1,"kind":"square"}',
  '{"kind":"label","text":"abc"}',
  '{"size":2,"text":"abc","kind":"label"}',
  '{"kind":"circle","radius":2,"side":5}',
  '{"side":"not a number","kind":"circle","radius":1}',
  '{"kind":"square","kind":"circle","radius":4}',
  '{"k\\u0069nd":"circle","radius":5}',
  '{"kind":"c\\u0069rcle","radius":6}',
];
for (const text of shapes) {
  attempt(text, () => {
    const shape = JSON.parse<Shape>(text);
    return [shape, area(shape), Object.keys(shape)];
  });
}
attempt("a list of shapes", () => {
  const list = JSON.parse<Shape[]>("[" + shapes.join(",") + "]");
  return list.map(area);
});
for (const text of ['{"ok":true,"value":1}', '{"value":1,"ok":true}', '{"ok":false,"error":"e"}', '{"error":"e","ok":false,"value":"ignored"}']) attempt(text, () => unwrap(JSON.parse<Result>(text)));
for (const text of ["1", "-0", '"text"', "null", "[]", "[1,2]", '{"n":1}', '{"n":1,"m":2}', '""']) attempt("loose " + text, () => [JSON.parse<Loose>(text), kindOf(JSON.parse<Loose>(text))]);
for (const text of ['{"version":1,"name":"a"}', '{"name":{"first":"b"},"version":2}', '{"version":1.0,"name":"c"}', '{"version":2e0,"name":{"first":"d","last":"e"}}']) attempt(text, () => nameOf(JSON.parse<Versioned>(text)));
//// products-of-members-parsed-by-type-are-summed-in-a-loop.ts
////= lines	Line	count	number	price	number
import { JSON } from "bun"; function total(lines: Line[]): number {
  let sum = 0;
  for (const line of lines) sum += line.count * line.price;
  return sum;
}
console.log(total(JSON.parse<Line[]>('[{"count":2,"price":2.5}]')));
//// squares-of-members-are-summed-over-literals-and-over-a-parsed-list.ts
////= Point
////= norm
function total(text: string): number {
  const points: Point[] = JSON.parse(text);
  let sum = 0;
  for (const point of points) sum += norm(point);
  return sum;
}
let warm = 0;
for (let i = 0; i < 3; i++) warm += norm({ x: i, y: 1 });
console.log(warm, total('[{"x":3,"y":4}]'));
//// texts-and-null-arrive-in-an-annotated-list-of-numbers.ts
const list: number[] = JSON.parse('[1,"2",null,3.5,true,[4],{"a":5}]');

function sum(values: number[]): number {
  let total = 0;
  for (const value of values) total += value;
  return total;
}
function kinds(values: number[]): string {
  return values.map(value => typeof value).join();
}
function numbersOnly(values: number[]): number {
  let count = 0;
  for (const value of values) if (typeof value === "number") count++;
  return count;
}

console.log(list.length);
console.log(sum(list.slice(0, 1)), sum(list.slice(0, 2)), sum(list.slice(0, 3)), sum(list.slice(2, 4)), sum(list.slice(3, 5)));
console.log(kinds(list));
console.log(numbersOnly(list));
console.log(list[1] + 1, list[2] + 1, list[4] + 1, list[5] + 1);
console.log(list[1] === 2, list[2] === 0, list[2] === null, list[4] === 1);
console.log(list.indexOf(2), list.includes(2), list.indexOf(3.5), list.includes(1));
console.log(list.map(value => value * 2).join());
console.log(list.filter(value => value > 1).length);
console.log(Math.max(...list.slice(0, 2)), Math.max(...list.slice(0, 3)), Math.min(...list.slice(0, 5)));
console.log(JSON.stringify(list));
