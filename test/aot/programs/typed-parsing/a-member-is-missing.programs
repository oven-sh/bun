//// parsed-by-type-nested-a-few-hundred-levels-deep.ts
////= show-2

interface Tree {
  value: number;
  children: Tree[];
}
interface Chain {
  next: Chain | null;
}
type Nest = Nest[];

function depthOf(tree: Tree): number {
  let depth = 1;
  let at = tree;
  while (at.children.length > 0) {
    at = at.children[0];
    depth++;
  }
  return depth;
}
function sumOf(tree: Tree): number {
  let sum = tree.value;
  for (const child of tree.children) sum += sumOf(child);
  return sum;
}
function lengthOf(chain: Chain): number {
  let length = 0;
  for (let at: Chain | null = chain; at !== null; at = at.next) length++;
  return length;
}
function levels(nest: Nest): number {
  let count = 1;
  let at = nest;
  while (at.length > 0) {
    at = at[0];
    count++;
  }
  return count;
}

for (const depth of [1, 2, 10, 100, 400]) {
  attempt("a tree of depth " + depth, () => {
    const tree = JSON.parse('{"value":1,"children":['.repeat(depth).slice(0, -1) + "[]" + "}]".repeat(depth).slice(0, -1)) as Tree;
    return [depthOf(tree), sumOf(tree)];
  });
  attempt("a chain of length " + depth, () => lengthOf(JSON.parse('{"next":'.repeat(depth) + "null" + "}".repeat(depth)) as Chain));
  attempt("lists in lists, " + depth + " levels", () => levels(JSON.parse("[".repeat(depth) + "]".repeat(depth)) as Nest));
}
attempt("a wide tree", () => {
  const leaf = '{"value":1,"children":[]}';
  const branch = '{"value":10,"children":[' + Array.from({ length: 20 }, () => leaf).join(",") + "]}";
  const tree = JSON.parse('{"value":100,"children":[' + Array.from({ length: 20 }, () => branch).join(",") + "]}") as Tree;
  return [depthOf(tree), sumOf(tree), tree.children[19].children[19]];
});
//// parsed-by-type-nesting-of-a-million-levels-gives-the-value-or-a-range-error.ts
////= show-2

type Nest = Nest[];
interface Chain {
  next: Chain | null;
}

function levels(nest: Nest): number {
  let count = 1;
  for (let at = nest; at.length > 0; at = at[0]) count++;
  return count;
}
function links(chain: Chain): number {
  let count = 0;
  for (let at: Chain | null = chain; at !== null; at = at.next) count++;
  return count;
}
function either(label: string, wanted: number, run: () => number): void {
  let got: string;
  try {
    const value = run();
    got = value === wanted ? "the value or a RangeError" : "another value: " + value;
  } catch (error) {
    got = error instanceof RangeError ? "the value or a RangeError" : error instanceof Error ? error.constructor.name : typeof error;
  }
  console.log(label, "->", got);
}

for (const depth of [10_000, 100_000, 1_000_000]) {
  either(depth + " lists", depth, () => levels(JSON.parse("[".repeat(depth) + "]".repeat(depth)) as Nest));
  either(depth + " objects", depth, () => links(JSON.parse('{"next":'.repeat(depth) + "null" + "}".repeat(depth)) as Chain));
  attempt(depth + " lists that are never closed", () => JSON.parse("[".repeat(depth)) as Nest);
  attempt("afterwards", () => [levels(JSON.parse("[[[]]]") as Nest), links(JSON.parse('{"next":{"next":null}}') as Chain)]);
}
