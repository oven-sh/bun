////= Point

////= norm
function parsePoint(text: string): Point {
  return JSON.parse(text);
}
class Holder {
  point: Point;
  constructor(text: string) {
    this.point = JSON.parse(text);
  }
  norm(): number {
    return norm(this.point);
  }
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += norm({ x: i, y: 1 }) + norm(parsePoint('{"x":1,"y":2}')) + new Holder('{"x":2,"y":1}').norm();
console.log("2000 honest rounds", warm);

const texts = ['{"x":"3","y":4}', '{"x":3}', "{}", '{"y":4,"x":null}', "[3,4]", '"xy"', "7", "null", "true", '{"x":{"valueOf":1},"y":1}', '{"x":[2],"y":[3]}', '{"x":1e400,"y":-0}', '{"X":3,"Y":4}'];
for (const text of texts) {
  attempt(text + " as an argument", () => norm(JSON.parse(text)));
  attempt(text + " as a result", () => norm(parsePoint(text)));
  attempt(text + " in a field", () => new Holder(text).norm());
  attempt(text + " in an element", () => {
    const points: Point[] = [{ x: 1, y: 1 }, JSON.parse(text)];
    return points.map(norm);
  });
  attempt(text + " in a captured variable", () => {
    const point: Point = JSON.parse(text);
    const later = (): number => norm(point);
    return later();
  });
  attempt(text + " the whole list is parsed", () => {
    const points: Point[] = JSON.parse("[" + text + "]");
    let sum = 0;
    for (const point of points) sum += norm(point);
    return sum;
  });
}
const fromResponse: Point = await new Response('{"x":"3","y":4}').json();
attempt("out of a response", () => [norm(fromResponse), fromResponse]);
const fromRequest: Point = await new Request("http://localhost/", { method: "POST", body: "[1,2]" }).json();
attempt("out of a request", () => [norm(fromRequest), fromRequest]);
const fromBlob: Point = await new Blob(['{"y":2}']).json();
attempt("out of a blob", () => [norm(fromBlob), fromBlob]);
attempt("honest again", () => [norm(parsePoint('{"x":3,"y":4}')), new Holder('{"y":4,"x":3}').norm()]);

export {};
//// json-into-an-annotated-union-with-an-unknown-tag.ts
////= show-2

type Shape = { kind: "circle"; radius: number } | { kind: "square"; side: number } | { kind: "label"; text: string };

function area(shape: Shape): number {
  switch (shape.kind) {
    case "circle":
      return shape.radius * shape.radius * 3;
    case "square":
      return shape.side * shape.side;
    case "label":
      return shape.text.length;
  }
}
function describe(shape: Shape): string {
  if (shape.kind === "circle") return "circle " + shape.radius;
  if (shape.kind === "square") return "square " + shape.side;
  if (shape.kind === "label") return "label " + shape.text;
  const rest: never = shape;
  return "never " + show(rest);
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += area(i % 3 === 0 ? { kind: "circle", radius: i } : i % 3 === 1 ? { kind: "square", side: i } : { kind: "label", text: "t" });
console.log("2000 honest literals", warm);

const texts = [
  '{"kind":"circle","radius":2}',
  '{"kind":"triangle","base":1}',
  '{"radius":2}',
  '{"kind":"circle"}',
  '{"kind":"circle","side":2}',
  '{"kind":"square","radius":2}',
  '{"kind":"label"}',
  '{"kind":"label","text":5}',
  '{"kind":"label","text":null}',
  '{"kind":"circle","radius":"2"}',
  '{"kind":null}',
  '{"kind":0}',
  '{"kind":["circle"],"radius":2}',
  '{"kind":"circle","kind":"square","radius":2,"side":3}',
  '{"kind":"CIRCLE","radius":2}',
  "[]",
  "null",
  '"circle"',
  "0",
];
for (const text of texts) {
  attempt(text + " area", () => {
    const shape: Shape = JSON.parse(text);
    return [area(shape), typeof area(shape)];
  });
  attempt(text + " described", () => {
    const shape: Shape = JSON.parse(text);
    return describe(shape);
  });
}
attempt("in one list", () => {
  const shapes: Shape[] = JSON.parse("[" + texts.slice(0, 6).join(",") + "]");
  return [shapes.map(area), shapes.map(describe)];
});
//// json-into-an-annotated-variable-with-a-wrong-kind-for-each-member.ts
////= show-2

interface Record1 {
  count: number;
  name: string;
  on: boolean;
  list: number[];
  inner: { x: number };
  maybe?: number;
}

function countPlus(r: Record1): number {
  return r.count + 1;
}
function nameLength(r: Record1): number {
  return r.name.length;
}
function onText(r: Record1): string {
  return r.on ? "on" : "off";
}
function listSum(r: Record1): number {
  let sum = 0;
  for (const n of r.list) sum += n;
  return sum;
}
function innerX(r: Record1): number {
  return r.inner.x * 2;
}
function maybeOr(r: Record1): number {
  return r.maybe ?? -1;
}

const good = { count: "1", name: '"n"', on: "true", list: "[1,2]", inner: '{"x":3}', maybe: "4" };
const values = ["1.5", '"text"', "false", "null", "[]", '["a"]', "{}", '{"x":"y"}', '{"length":2}'];
function textWith(key: string, value: string | undefined): string {
  const parts: string[] = [];
  for (const [name, held] of Object.entries(good)) {
    if (name !== key) parts.push(JSON.stringify(name) + ":" + held);
    else if (value !== undefined) parts.push(JSON.stringify(name) + ":" + value);
  }
  return "{" + parts.join(",") + "}";
}

let warm = 0;
for (let i = 0; i < 2000; i++) {
  const r: Record1 = { count: i, name: "n", on: true, list: [i], inner: { x: i } };
  warm += countPlus(r) + nameLength(r) + onText(r).length + listSum(r) + innerX(r) + maybeOr(r);
}
console.log("2000 honest literals", warm);

const uses: [string, (r: Record1) => unknown][] = [
  ["count", countPlus],
  ["name", nameLength],
  ["on", onText],
  ["list", listSum],
  ["inner", innerX],
  ["maybe", maybeOr],
];
for (const [key, use] of uses) {
  for (const value of [...values, undefined]) {
    attempt(key + " is " + (value ?? "missing"), () => {
      const r: Record1 = JSON.parse(textWith(key, value));
      return [use(r), Object.keys(r).length];
    });
  }
}
attempt("direct calls with a text for the count", () => {
  const r: Record1 = JSON.parse(textWith("count", '"7"'));
  return [countPlus(r), r.count, typeof r.count, r.count + 1, r.count * 2, nameLength(r), listSum(r)];
});
attempt("honest text", () => {
  const r: Record1 = JSON.parse(textWith("", undefined));
  return [countPlus(r), nameLength(r), onText(r), listSum(r), innerX(r), maybeOr(r), JSON.stringify(r)];
});
//// json-into-annotated-arrays-tuples-records-and-enums.ts
////= show-2

enum Color {
  Red,
  Green,
}

function sum(list: number[]): number {
  let total = 0;
  for (let i = 0; i < list.length; i++) total += list[i];
  return total;
}
function joined(list: string[]): string {
  let text = "";
  for (const part of list) text += part.toUpperCase();
  return text;
}
function swap(pair: [number, string]): string {
  return pair[1].length + ":" + (pair[0] + 1) + ":" + pair.length;
}
function count(table: Record<string, number>): number {
  let total = 0;
  for (const key in table) total += table[key];
  return total;
}
function nameOf(color: Color): string {
  switch (color) {
    case Color.Red:
      return "red";
    case Color.Green:
      return "green";
  }
}

let warm = 0;
for (let i = 0; i < 2000; i++) warm += sum([i, 1]) + joined(["a"]).length + swap([i, "s"]).length + count({ a: i }) + nameOf(i % 2).length;
console.log("2000 honest rounds", warm);

for (const text of ["[1,2,3]", "[1,2.5,-0]", '[1,"2",3]', "[1,null,3]", "[1,[2],3]", "[true,false]", '[{"valueOf":1}]', "[]", "{}", '{"length":2,"0":5,"1":6}', '"123"', "5", "null"]) {
  attempt(text + " as numbers", () => {
    const list: number[] = JSON.parse(text);
    return sum(list);
  });
}
for (const text of ['["a","b"]', '["a",1]', '["a",null]', '[["a"]]', '"ab"', "{}", "null"]) {
  attempt(text + " as texts", () => {
    const list: string[] = JSON.parse(text);
    return joined(list);
  });
}
for (const text of ['[1,"a"]', '["a",1]', "[1]", "[]", '[1,"a",2,"b"]', '[null,"a"]', '[1,null]', '{"0":1,"1":"a","length":2}', "null"]) {
  attempt(text + " as a pair", () => {
    const pair: [number, string] = JSON.parse(text);
    return swap(pair);
  });
}
for (const text of ['{"a":1,"b":2}', '{"a":"1","b":2}', '{"a":null}', '{"a":[1]}', '{"__proto__":{"c":3},"a":1}', "[1,2]", '"ab"', "3", "null"]) {
  attempt(text + " as a table", () => {
    const table: Record<string, number> = JSON.parse(text);
    return count(table);
  });
}
for (const text of ["0", "1", "2", "-0", "0.5", '"0"', '"Red"', "null", "[0]", "true"]) {
  attempt(text + " as a color", () => {
    const color: Color = JSON.parse(text);
    return [nameOf(color), typeof nameOf(color), Color[color], color === Color.Red];
  });
}
//// json-parse-by-type-fills-in-defaults-for-missing-members.ts
import { JSON } from "bun"; import type { Schema } from "bun";

////= show-2

interface Server {
  host: string & Schema.Default<"localhost">;
  port: number & Schema.Default<8080>;
  secure: boolean & Schema.Default<false>;
  name: string;
}

function address(server: Server): string {
  return (server.secure ? "https://" : "http://") + server.host.toUpperCase() + ":" + (server.port + 1) + "/" + server.name;
}

const filled = JSON.parse<{ port: number & Schema.Default<8080> }>("{}").port === 8080;
console.log("filled in by the parser:", filled);
function withDefaults(text: string): Server {
  const server = JSON.parse<Server>(text);
  if (filled) return server;
  const whole: Server = { ...server };
  whole.host ??= "localhost";
  whole.port ??= 8080;
  whole.secure ??= false;
  return whole;
}

for (const text of ['{"name":"a"}', '{"name":"b","port":1}', '{"host":"h","name":"c"}', '{"name":"d","secure":true}', '{"port":0,"host":"","secure":false,"name":"e"}', '{"name":"f","port":-0}']) {
  attempt(text, () => {
    const server = withDefaults(text);
    return [address(server), server.host, server.port, server.secure, typeof server.port, Object.keys(server).sort(), "port" in server, Object.hasOwn(server, "host")];
  });
}
//// json-parse-by-type-refuses-a-wrong-kind-for-each-kind-of-member.ts
////= show-3

import { JSON } from "bun"; enum Color {
  Red,
  Green,
}

const values = ["1", '"text"', "true", "null", "[]", "{}", "[1]", '{"a":1}'];
const rows: [string, string[], (text: string) => unknown][] = [
  ["number", ["1"], text => JSON.parse<{ m: number }>(text)],
  ["string", ['"text"'], text => JSON.parse<{ m: string }>(text)],
  ["boolean", ["true"], text => JSON.parse<{ m: boolean }>(text)],
  ["null", ["null"], text => JSON.parse<{ m: null }>(text)],
  ["a list of numbers", ["[]", "[1]"], text => JSON.parse<{ m: number[] }>(text)],
  ["a list of strings", ["[]"], text => JSON.parse<{ m: string[] }>(text)],
  ["an object with a", ['{"a":1}'], text => JSON.parse<{ m: { a: number } }>(text)],
  ["an object with an optional a", ["{}", '{"a":1}'], text => JSON.parse<{ m: { a?: number } }>(text)],
  ["an empty object type", ["{}", '{"a":1}'], text => JSON.parse<{ m: {} }>(text)],
  ["object", ["[]", "{}", "[1]", '{"a":1}'], text => JSON.parse<{ m: object }>(text)],
  ["a table of numbers", ["{}", '{"a":1}'], text => JSON.parse<{ m: Record<string, number> }>(text)],
  ["a pair", [], text => JSON.parse<{ m: [number, number] }>(text)],
  ["a tuple of one", ["[1]"], text => JSON.parse<{ m: [number] }>(text)],
  ["an enum", ["1"], text => JSON.parse<{ m: Color }>(text)],
  ["the literal 1", ["1"], text => JSON.parse<{ m: 1 }>(text)],
  ["the literal text", ['"text"'], text => JSON.parse<{ m: "text" }>(text)],
  ["the literal true", ["true"], text => JSON.parse<{ m: true }>(text)],
  ["number or null", ["1", "null"], text => JSON.parse<{ m: number | null }>(text)],
  ["string or a list of numbers", ['"text"', "[]", "[1]"], text => JSON.parse<{ m: string | number[] }>(text)],
  ["an optional number", ["1"], text => JSON.parse<{ m?: number }>(text)],
  ["unknown", values, text => JSON.parse<{ m: unknown }>(text)],
];

for (const [label, accepted, parse] of rows) {
  for (const value of values) expect(accepted.includes(value) ? "value" : "TypeError", label + " given " + value, () => parse('{"m":' + value + "}"));
}
//// json-parse-by-type-refuses-arrays-for-objects-and-objects-for-arrays.ts
////= show-3

////= lines-4	Sized	length	number
////= lines-4	First	0	number
import { JSON } from "bun"; type Table = Record<string, number>;

expect("value", "an object with a length", () => JSON.parse<Sized>('{"length":2}'));
expect("TypeError", "a list where a length is declared", () => JSON.parse<Sized>("[1,2]"));
expect("TypeError", "a text where a length is declared", () => JSON.parse<Sized>('"ab"'));
expect("value", "an object with an index", () => JSON.parse<First>('{"0":1}'));
expect("TypeError", "a list where an index is declared", () => JSON.parse<First>("[1]"));
expect("value", "a table", () => JSON.parse<Table>('{"0":1,"1":2}'));
expect("TypeError", "a list for a table", () => JSON.parse<Table>("[1,2]"));
expect("TypeError", "an empty list for a table", () => JSON.parse<Table>("[]"));
expect("TypeError", "an empty list for an empty object type", () => JSON.parse<{}>("[]"));
expect("TypeError", "a number for an empty object type", () => JSON.parse<{}>("1"));
expect("value", "an empty object for an empty object type", () => JSON.parse<{}>("{}"));
expect("value", "a list for object", () => JSON.parse<object>("[1]"));
expect("TypeError", "null for object", () => JSON.parse<object>("null"));
expect("TypeError", "a text for object", () => JSON.parse<object>('"o"'));
expect("TypeError", "an object with indexes and a length for a list", () => JSON.parse<number[]>('{"0":1,"1":2,"length":2}'));
expect("TypeError", "an empty object for a list", () => JSON.parse<number[]>("{}"));
expect("TypeError", "an object for a pair", () => JSON.parse<[number, number]>('{"0":1,"1":2,"length":2}'));
expect("TypeError", "null for a list", () => JSON.parse<number[]>("null"));
expect("TypeError", "a text for a list of texts", () => JSON.parse<string[]>('"ab"'));
expect("TypeError", "a list in a list of numbers", () => JSON.parse<number[]>("[1,[2]]"));
expect("TypeError", "a number in a list of lists", () => JSON.parse<number[][]>("[[1],2]"));
expect("TypeError", "null in a list of numbers", () => JSON.parse<number[]>("[1,null,3]"));
expect("TypeError", "the last of many is a text", () => JSON.parse<number[]>("[" + "1,".repeat(5000) + '"2"]'));
expect("TypeError", "a list of objects holds a list", () => JSON.parse<{ a: number }[]>('[{"a":1},[]]'));
expect("TypeError", "a list of objects holds null", () => JSON.parse<{ a: number }[]>('[{"a":1},null]'));
//// json-parse-by-type-refuses-missing-members-and-values-that-are-no-objects.ts
////= show-3

import { JSON } from "bun"; interface User {
  id: number;
  name: string;
  extra?: boolean;
  anything: unknown;
  maybe: number | undefined;
}

const whole = '{"id":1,"name":"n","anything":0,"maybe":2}';
expect("value", "whole", () => JSON.parse<User>(whole));
expect("TypeError", "without id", () => JSON.parse<User>('{"name":"n","anything":0,"maybe":2}'));
expect("TypeError", "without name", () => JSON.parse<User>('{"id":1,"anything":0,"maybe":2}'));
expect("TypeError", "without the member of type unknown", () => JSON.parse<User>('{"id":1,"name":"n","maybe":2}'));
expect("TypeError", "without the member that may be undefined", () => JSON.parse<User>('{"id":1,"name":"n","anything":0}'));
expect("TypeError", "empty", () => JSON.parse<User>("{}"));
expect("TypeError", "only undeclared members", () => JSON.parse<User>('{"ID":1,"Name":"n","id ":1}'));
expect("TypeError", "the members one level too deep", () => JSON.parse<User>('{"user":' + whole + "}"));
expect("TypeError", "the members in __proto__", () => JSON.parse<User>('{"__proto__":' + whole + "}"));
expect("TypeError", "some of the members in __proto__", () => JSON.parse<User>('{"id":1,"__proto__":{"name":"n","anything":0,"maybe":2}}'));
expect("TypeError", "null for the optional member", () => JSON.parse<User>('{"id":1,"name":"n","anything":0,"maybe":2,"extra":null}'));
expect("TypeError", "null for the member that may be undefined", () => JSON.parse<User>('{"id":1,"name":"n","anything":0,"maybe":null}'));
expect("value", "null for the member of type unknown", () => JSON.parse<User>('{"id":1,"name":"n","anything":null,"maybe":2}'));
for (const text of ["null", "1", '"text"', "true", "[]", "[" + whole + "]", '"' + whole.replaceAll('"', '\\"') + '"']) expect("TypeError", "instead of the object: " + text, () => JSON.parse<User>(text));

////= lines	Named	toString	string	constructor	number
expect("value", "members named like inherited ones", () => JSON.parse<Named>('{"toString":"s","constructor":1}'));
expect("TypeError", "members named like inherited ones are missing", () => JSON.parse<Named>("{}"));
expect("TypeError", "one of them is missing", () => JSON.parse<Named>('{"toString":"s"}'));
//// json-parse-by-type-refuses-numbers-at-the-edge-of-schema-bounds.ts
import { JSON } from "bun"; import type { Schema } from "bun";

////= show-3

type Whole = number & Schema.Int;
type AtLeastOne = number & Schema.Min<1>;
type AtMostTen = number & Schema.Max<10>;
type AboveZero = number & Schema.Above<0>;
type BelowOne = number & Schema.Below<1>;
type AtLeastZero = number & Schema.Min<0>;
type ByFive = number & Schema.MultipleOf<5>;
type Quantity = number & Schema.Int & Schema.Min<1> & Schema.Max<1000>;

function rows(label: string, parse: (text: string) => unknown, accepted: string[], refused: string[]): void {
  for (const text of accepted) expect("value", label + " given " + text, () => parse(text));
  for (const text of refused) expect("TypeError", label + " given " + text, () => parse(text));
}

rows("a whole number", text => JSON.parse<Whole>(text), ["0", "-0", "1", "-1", "1.0", "1e3", "1e21", "9007199254740993", "2147483648", "100e-2"], ["0.5", "-0.5", "1e-7", "5e-324", "1.0000000001", "1e400", '"1"', "null"]);
rows("at least 1", text => JSON.parse<AtLeastOne>(text), ["1", "1.0", "1.0000000000000002", "2", "1e308"], ["0.9999999999999999", "0", "-1", "-0", "1e400", "-1e400"]);
rows("at most 10", text => JSON.parse<AtMostTen>(text), ["10", "10.0", "9.999999999999998", "-1e308", "0"], ["10.000000000000002", "11", "1e400", "-1e400"]);
rows("above 0", text => JSON.parse<AboveZero>(text), ["5e-324", "1", "0.1"], ["0", "-0", "0.0", "1e-400", "-5e-324", "-1"]);
rows("below 1", text => JSON.parse<BelowOne>(text), ["0.9999999999999999", "0", "-5"], ["1", "1.0", "1.0000000000000002", "2"]);
rows("at least 0", text => JSON.parse<AtLeastZero>(text), ["0", "-0", "-1e-400", "5e-324"], ["-5e-324", "-1"]);
rows("a multiple of 5", text => JSON.parse<ByFive>(text), ["0", "-0", "5", "-5", "10", "1e21", "5.0"], ["1", "4.999999999999999", "5.000000000000001", "2.5", "-3"]);
rows("a quantity", text => JSON.parse<Quantity>(text), ["1", "1000", "1e3", "999"], ["0", "1001", "1.5", "999.5", "-1", "1e400"]);
rows("a quantity in a member", text => JSON.parse<{ q: Quantity }>('{"q":' + text + "}"), ["1", "1000"], ["0", "1001", "1.5", "null", '"1"']);
rows("quantities in a list", text => JSON.parse<Quantity[]>("[1," + text + ",1000]"), ["2"], ["0", "1001", "2.5"]);
//// json-parse-by-type-refuses-numbers-that-are-not-finite-and-int32-out-of-range.ts
import { JSON } from "bun"; import type { int32 } from "bun";

////= show-3

////= lines-4	Reading	n	number
////= lines-4	Cell	v	int32

for (const spelling of ["1e400", "-1e400", "1e309", "1.7976931348623159e308", "9".repeat(400)]) {
  expect("TypeError", "number given " + spelling.slice(0, 30), () => JSON.parse<Reading>('{"n":' + spelling + "}"));
  expect("TypeError", "number alone given " + spelling.slice(0, 30), () => JSON.parse<number>(spelling));
  expect("TypeError", "in a list " + spelling.slice(0, 30), () => JSON.parse<number[]>("[1," + spelling + "]"));
  expect("value", "unknown given " + spelling.slice(0, 30), () => JSON.parse<{ n: unknown }>('{"n":' + spelling + "}"));
}
expect("value", "the largest number", () => JSON.parse<Reading>('{"n":1.7976931348623157e308}'));

for (const spelling of ["0", "1", "-1", "2147483647", "-2147483648", "1.0", "1e9", "2147483647.0"]) expect("value", "int32 given " + spelling, () => JSON.parse<Cell>('{"v":' + spelling + "}"));
for (const spelling of ["0.5", "-0.5", "1.5", "2147483648", "-2147483649", "2147483647.5", "1e10", "1e21", "1e400", "4294967296", "9007199254740993", "1e-7", "5e-324", '"1"', "null", "true", "[1]"]) {
  expect("TypeError", "int32 given " + spelling, () => JSON.parse<Cell>('{"v":' + spelling + "}"));
  expect("TypeError", "int32 in a list given " + spelling, () => JSON.parse<int32[]>("[1," + spelling + "]"));
}
expect("TypeError", "int32 is missing", () => JSON.parse<Cell>("{}"));
//// json-parse-by-type-refuses-texts-and-lists-at-the-edge-of-schema-bounds.ts
import { JSON } from "bun"; import type { Schema } from "bun";

////= show-3

type NotEmpty = string & Schema.MinLength<1>;
type Short = string & Schema.MaxLength<3>;
type AtLeastThree = string & Schema.MinLength<3>;
type Lower = string & Schema.Pattern<"^[a-z]+$">;
type SomeItems = number[] & Schema.MinItems<1>;
type FewItems = number[] & Schema.MaxItems<2>;

function rows(label: string, parse: (text: string) => unknown, accepted: string[], refused: string[]): void {
  for (const text of accepted) expect("value", label + " given " + text, () => parse(text));
  for (const text of refused) expect("TypeError", label + " given " + text, () => parse(text));
}

rows("not empty", text => JSON.parse<NotEmpty>(text), ['"a"', '" "', '"\\u0000"', '"\\ud800"'], ['""', "null", "1", "[]"]);
rows("at most 3", text => JSON.parse<Short>(text), ['""', '"abc"', '"\\u0061\\u0062\\u0063"', '"日本語"', '"\\n\\n\\n"'], ['"abcd"', '"\\u0061\\u0062\\u0063\\u0064"', '"日本語語"', '"    "']);
rows("at most 3, in code points", text => JSON.parse<Short>(text), ['"🍞🍞🍞"', '"a🍞b"', '"\\ud83c\\udf5e\\ud83c\\udf5e\\ud83c\\udf5e"', '"\\ud800\\ud800\\ud800"', '"\\udf5e\\ud83c\\udf5e\\ud83c"'], ['"🍞🍞🍞🍞"', '"ab🍞c"', '"\\ud800\\ud800\\ud800\\ud800"', '"\\udf5e\\ud83c\\ud83c\\udf5e\\ud83c"']);
rows("at least 3, in code points", text => JSON.parse<AtLeastThree>(text), ['"abc"', '"abcd"', '"abcde"', '"🍞🍞🍞"', '"a🍞b"', '"\\ud800\\ud800\\ud800"', '"\\udf5e\\ud83c\\udf5e\\ud83c"'], ['""', '"ab"', '"🍞"', '"🍞🍞"', '"a🍞"', '"\\ud83c\\udf5e\\ud83c\\udf5e"']);
rows("at least 3 in a member", text => JSON.parse<{ name: AtLeastThree & Schema.MaxLength<4> }>('{"name":' + text + "}"), ['"abc"', '"🍞🍞🍞🍞"'], ['"🍞🍞"', '"🍞🍞🍞🍞🍞"', '"abcde"']);
rows("lower case", text => JSON.parse<Lower>(text), ['"a"', '"abc"', '"\\u0061"'], ['""', '"A"', '"a1"', '"a b"', '"a\\nb"', '"é"', '"a\\u0000"', '" a"']);
rows("some items", text => JSON.parse<SomeItems>(text), ["[1]", "[1,2,3]"], ["[]", "null", "{}", '["a"]']);
rows("few items", text => JSON.parse<FewItems>(text), ["[]", "[1]", "[1,2]"], ["[1,2,3]", "[1,2,null]"]);
rows("an email", text => JSON.parse<string & Schema.Format<"email">>(text), ['"a@example.com"'], ['""', '"a"', '"a@"', '"@example.com"', '"a b@example.com"', "1"]);
rows("a uuid", text => JSON.parse<string & Schema.Format<"uuid">>(text), ['"123e4567-e89b-42d3-a456-426614174000"'], ['""', '"123e4567-e89b-42d3-a456-42661417400"', '"123e4567e89b42d3a456426614174000"', '"123e4567-e89b-42d3-a456-42661417400g"']);
rows("an ipv4 address", text => JSON.parse<string & Schema.Format<"ipv4">>(text), ['"1.2.3.4"', '"255.255.255.255"'], ['""', '"1.2.3"', '"1.2.3.256"', '"1.2.3.4.5"', '"a.b.c.d"', '" 1.2.3.4"']);
rows("a date", text => JSON.parse<string & Schema.Format<"date">>(text), ['"2026-01-31"', '"2024-02-29"'], ['""', '"2026-1-31"', '"2026-13-01"', '"2026-02-30"', '"2026-01-31T00:00:00Z"', '"31-01-2026"']);
rows("a date and time", text => JSON.parse<string & Schema.Format<"date-time">>(text), ['"2026-01-31T10:20:30Z"'], ['""', '"2026-01-31"', '"2026-01-31 10:20:30"', '"2026-01-31T25:00:00Z"', '"yesterday"']);
rows("a date in a member", text => JSON.parse<{ at: string & Schema.Format<"date"> }>('{"at":' + text + "}"), ['"2026-01-31"'], ["1769817600000", "null", '"now"']);
//// json-parse-by-type-refuses-tuples-of-another-length.ts
////= show-3

import { JSON } from "bun"; type Pair = [number, string];

expect("value", "a pair", () => JSON.parse<Pair>('[1,"a"]'));
expect("TypeError", "empty", () => JSON.parse<Pair>("[]"));
expect("TypeError", "too short", () => JSON.parse<Pair>("[1]"));
expect("TypeError", "too long", () => JSON.parse<Pair>('[1,"a",2]'));
expect("TypeError", "too long by null", () => JSON.parse<Pair>('[1,"a",null]'));
expect("TypeError", "the other way round", () => JSON.parse<Pair>('["a",1]'));
expect("TypeError", "null for the first", () => JSON.parse<Pair>('[null,"a"]'));
expect("TypeError", "a pair in a list", () => JSON.parse<Pair>('[[1,"a"]]'));
expect("value", "the empty tuple", () => JSON.parse<[]>("[]"));
expect("TypeError", "one element for the empty tuple", () => JSON.parse<[]>("[1]"));
expect("TypeError", "a short pair among pairs", () => JSON.parse<Pair[]>('[[1,"a"],[2],[3,"c"]]'));
expect("TypeError", "a long pair in a member", () => JSON.parse<{ at: [number, number] }>('{"at":[1,2,3]}'));
expect("TypeError", "a read-only pair that is too long", () => JSON.parse<readonly [number, number]>("[1,2,3]"));
expect("TypeError", "very long", () => JSON.parse<[number, number]>("[" + "1,".repeat(10000) + "1]"));
//// json-parse-by-type-refuses-unknown-tags-and-mixed-variants.ts
////= show-3

import { JSON } from "bun"; type Shape = { kind: "circle"; radius: number } | { kind: "square"; side: number };
type Result = { ok: true; value: number } | { ok: false; error: string };
type Level = { level: 1; a: string } | { level: 2; b: string };

expect("value", "a circle", () => JSON.parse<Shape>('{"kind":"circle","radius":1}'));
expect("TypeError", "an unknown tag", () => JSON.parse<Shape>('{"kind":"triangle","radius":1,"side":1}'));
expect("TypeError", "no tag", () => JSON.parse<Shape>('{"radius":1,"side":1}'));
expect("TypeError", "a tag in other letters", () => JSON.parse<Shape>('{"kind":"Circle","radius":1}'));
expect("TypeError", "a tag with a space", () => JSON.parse<Shape>('{"kind":"circle ","radius":1}'));
expect("TypeError", "an empty tag", () => JSON.parse<Shape>('{"kind":"","radius":1}'));
expect("TypeError", "null as the tag", () => JSON.parse<Shape>('{"kind":null,"radius":1}'));
expect("TypeError", "a list as the tag", () => JSON.parse<Shape>('{"kind":["circle"],"radius":1}'));
expect("TypeError", "a circle with the members of a square", () => JSON.parse<Shape>('{"kind":"circle","side":1}'));
expect("TypeError", "a square with the members of a circle", () => JSON.parse<Shape>('{"radius":1,"kind":"square"}'));
expect("TypeError", "two tags, the last one decides", () => JSON.parse<Shape>('{"kind":"circle","radius":1,"kind":"square"}'));
expect("value", "two tags, the last one fits", () => JSON.parse<Shape>('{"kind":"square","radius":1,"kind":"circle"}'));
expect("TypeError", "the member is of another kind", () => JSON.parse<Shape>('{"kind":"circle","radius":"1"}'));
expect("TypeError", "the tag is in __proto__", () => JSON.parse<Shape>('{"__proto__":{"kind":"circle"},"radius":1}'));
expect("TypeError", "one bad shape among many", () => JSON.parse<Shape[]>("[" + '{"kind":"circle","radius":1},'.repeat(500) + '{"kind":"square","radius":1}]'));
expect("TypeError", "ok is true and there is only an error", () => JSON.parse<Result>('{"ok":true,"error":"e"}'));
expect("TypeError", "ok is 1", () => JSON.parse<Result>('{"ok":1,"value":1}'));
expect("TypeError", "ok is a text", () => JSON.parse<Result>('{"ok":"true","value":1}'));
expect("TypeError", "ok is null", () => JSON.parse<Result>('{"ok":null,"error":"e"}'));
expect("TypeError", "level 3", () => JSON.parse<Level>('{"level":3,"a":"a","b":"b"}'));
expect("TypeError", "level 1.5", () => JSON.parse<Level>('{"level":1.5,"a":"a","b":"b"}'));
expect("TypeError", "level as a text", () => JSON.parse<Level>('{"level":"1","a":"a"}'));
expect("TypeError", "level 1 with the member of level 2", () => JSON.parse<Level>('{"level":1,"b":"b"}'));
expect("value", "level 2", () => JSON.parse<Level>('{"b":"b","level":2}'));
//// json-parse-by-type-refuses-values-outside-enums-and-literals.ts
////= show-3

import { JSON } from "bun"; enum Color {
  Red,
  Green,
  Blue = 5,
}
////= lines-5	Way	Up	"UP"	Down	"DOWN"
////= lines-5	Mixed	No	0	Yes	"YES"

for (const text of ["0", "1", "5", "5.0", "50e-1"]) expect("value", "a color given " + text, () => JSON.parse<Color>(text));
for (const text of ["2", "3", "4", "6", "-1", "0.5", "999", "1e400", '"Red"', '"0"', "null", "true", "[0]"]) expect("TypeError", "a color given " + text, () => JSON.parse<Color>(text));
for (const text of ['"UP"', '"DOWN"', '"\\u0055P"']) expect("value", "a way given " + text, () => JSON.parse<Way>(text));
for (const text of ['"Up"', '"up"', '"UP "', '""', "0", "null", '["UP"]']) expect("TypeError", "a way given " + text, () => JSON.parse<Way>(text));
for (const text of ["0", '"YES"']) expect("value", "mixed given " + text, () => JSON.parse<Mixed>(text));
for (const text of ["1", '"No"', '"0"', '"yes"', "false"]) expect("TypeError", "mixed given " + text, () => JSON.parse<Mixed>(text));
expect("TypeError", "one member given another", () => JSON.parse<Color.Red>("1"));
expect("TypeError", "a flag that is no member", () => JSON.parse<{ color: Color }>('{"color":3}'));
for (const text of ['"a"', '"b"']) expect("value", "a or b given " + text, () => JSON.parse<"a" | "b">(text));
for (const text of ['"c"', '"A"', '"ab"', '""', "null", "1"]) expect("TypeError", "a or b given " + text, () => JSON.parse<"a" | "b">(text));
for (const text of ["3", "1.5", '"1"', "true", "null"]) expect("TypeError", "1 or 2 given " + text, () => JSON.parse<1 | 2>(text));
expect("TypeError", "true given false", () => JSON.parse<true>("false"));
expect("TypeError", "false given null", () => JSON.parse<false>("null"));
expect("TypeError", "null given false", () => JSON.parse<null>("false"));
expect("TypeError", "null given 0", () => JSON.parse<null>("0"));
expect("TypeError", "null given an empty text", () => JSON.parse<null>('""'));
for (const text of ['"id-"', '"id-x"', '"ID-1"', '" id-1"', '"id-1x"', '"id-Infinity"', '"id-NaN"', '"1"', "1", "null"]) expect("TypeError", "an id given " + text, () => JSON.parse<`id-${number}`>(text));
for (const text of ['"id-15"', '"id--1.5"', '"id-1e3"', '"id-0x10"']) expect("value", "an id given " + text, () => JSON.parse<`id-${number}`>(text));
//// json-parse-by-type-refuses-what-a-reviver-returns.ts
////= show-3

////= lines	Item	id	number	name	string
import { JSON } from "bun"; const good = '{"id":1,"name":"n"}';

expect("value", "a reviver that changes nothing", () => JSON.parse<Item>(good, (_, value) => value));
expect("TypeError", "a number becomes a text", () => JSON.parse<Item>(good, (key, value) => (key === "id" ? String(value) : value)));
expect("TypeError", "a member is removed", () => JSON.parse<Item>(good, (key, value) => (key === "name" ? undefined : value)));
expect("TypeError", "the whole value becomes undefined", () => JSON.parse<Item>(good, (key, value) => (key === "" ? undefined : value)));
expect("TypeError", "the whole value becomes null", () => JSON.parse<Item>(good, (key, value) => (key === "" ? null : value)));
expect("TypeError", "the whole value becomes a list", () => JSON.parse<Item>(good, (key, value) => (key === "" ? [value] : value)));
expect("TypeError", "a number becomes NaN", () => JSON.parse<Item>(good, (key, value) => (key === "id" ? NaN : value)));
expect("TypeError", "a number becomes infinite", () => JSON.parse<Item>(good, (key, value) => (key === "id" ? Infinity : value)));
expect("TypeError", "a number becomes a bigint", () => JSON.parse<Item>(good, (key, value) => (key === "id" ? 1n : value)));
expect("TypeError", "a text becomes a symbol", () => JSON.parse<Item>(good, (key, value) => (key === "name" ? Symbol("n") : value)));
expect("TypeError", "a text becomes a function", () => JSON.parse<Item>(good, (key, value) => (key === "name" ? () => "n" : value)));
expect("TypeError", "a number becomes a Number object", () => JSON.parse<Item>(good, (key, value) => (key === "id" ? new Number(1) : value)));
expect("TypeError", "a text becomes a String object", () => JSON.parse<Item>(good, (key, value) => (key === "name" ? new String("n") : value)));
expect("value", "a wrong text is put right", () => JSON.parse<Item>('{"id":"1","name":2}', (key, value) => (key === "id" ? 1 : key === "name" ? "n" : value)));
expect("RangeError", "the error of the reviver goes through", () =>
  JSON.parse<Item>(good, () => {
    throw new RangeError("stop");
  }),
);
expect("SyntaxError", "broken text never reaches the reviver", () => JSON.parse<Item>(good + "}", () => 1));
//// json-parse-by-type-refuses-when-the-last-of-two-equal-keys-is-wrong.ts
////= show-3

////= lines	Pair	a	number	b	string

import { JSON } from "bun"; expect("value", "the last one fits", () => JSON.parse<Pair>('{"a":"x","b":"b","a":1}'));
expect("TypeError", "the last one is a text", () => JSON.parse<Pair>('{"a":1,"b":"b","a":"x"}'));
expect("TypeError", "the last one is null", () => JSON.parse<Pair>('{"a":1,"a":null,"b":"b"}'));
expect("TypeError", "the last one is an object", () => JSON.parse<Pair>('{"a":1,"b":"b","a":{"a":1}}'));
expect("TypeError", "the last one is written with an escape", () => JSON.parse<Pair>('{"a":1,"b":"b","\\u0061":"x"}'));
expect("TypeError", "both members, both wrong at last", () => JSON.parse<Pair>('{"a":1,"b":"b","b":2,"a":"x"}'));
expect("TypeError", "after a thousand that fit", () => JSON.parse<Pair>('{"b":"b",' + '"a":1,'.repeat(1000) + '"a":true}'));
expect("TypeError", "in a nested object", () => JSON.parse<{ p: Pair }>('{"p":{"a":1,"b":"b"},"p":{"a":1}}'));
expect("TypeError", "in an element", () => JSON.parse<Pair[]>('[{"a":1,"b":"b"},{"a":1,"b":"b","b":null}]'));
expect("TypeError", "an optional member", () => JSON.parse<{ o?: number }>('{"o":1,"o":"x"}'));
expect("TypeError", "in a table", () => JSON.parse<Record<string, number>>('{"k":1,"k":"x"}'));
expect("value", "in a table, the last one fits", () => JSON.parse<Record<string, number>>('{"k":"x","k":1}'));
//// json-parse-by-type-strict-types-refuse-undeclared-keys.ts
import { JSON } from "bun"; import type { Schema } from "bun";

////= show-3

type Closed = { id: number; name?: string } & Schema.Strict;
type Outer = { inner: { x: number }; list: { y: number }[] } & Schema.Strict;
type Deep = { inner: { x: number }; list: { y: number }[] } & Schema.DeepStrict;

expect("value", "only declared keys", () => JSON.parse<Closed>('{"id":1,"name":"n"}'));
expect("value", "without the optional key", () => JSON.parse<Closed>('{"id":1}'));
expect("value", "a declared key twice", () => JSON.parse<Closed>('{"id":0,"id":1}'));
expect("value", "a declared key written with an escape", () => JSON.parse<Closed>('{"\\u0069d":1}'));
expect("TypeError", "one more key", () => JSON.parse<Closed>('{"id":1,"more":0}'));
expect("TypeError", "one more key first", () => JSON.parse<Closed>('{"more":0,"id":1}'));
expect("TypeError", "a key named __proto__", () => JSON.parse<Closed>('{"id":1,"__proto__":{}}'));
expect("TypeError", "a key named __proto__ that is null", () => JSON.parse<Closed>('{"id":1,"__proto__":null}'));
expect("TypeError", "a key named constructor", () => JSON.parse<Closed>('{"id":1,"constructor":1}'));
expect("TypeError", "a key named toString", () => JSON.parse<Closed>('{"id":1,"toString":1}'));
expect("TypeError", "an empty key", () => JSON.parse<Closed>('{"id":1,"":1}'));
expect("TypeError", "an index", () => JSON.parse<Closed>('{"id":1,"0":1}'));
expect("TypeError", "a key in other letters", () => JSON.parse<Closed>('{"id":1,"Id":1}'));
expect("TypeError", "a key with a space", () => JSON.parse<Closed>('{"id":1,"id ":1}'));
expect("TypeError", "a key whose value is null", () => JSON.parse<Closed>('{"id":1,"more":null}'));
expect("value", "strict outside only: more keys inside", () => JSON.parse<Outer>('{"inner":{"x":1,"more":0},"list":[{"y":1,"more":0}]}'));
expect("TypeError", "strict outside only: more keys outside", () => JSON.parse<Outer>('{"inner":{"x":1},"list":[],"more":0}'));
expect("value", "strict throughout: only declared keys", () => JSON.parse<Deep>('{"inner":{"x":1},"list":[{"y":1}]}'));
expect("TypeError", "strict throughout: more keys in a member", () => JSON.parse<Deep>('{"inner":{"x":1,"more":0},"list":[]}'));
expect("TypeError", "strict throughout: more keys in an element", () => JSON.parse<Deep>('{"inner":{"x":1},"list":[{"y":1},{"y":2,"more":0}]}'));
expect("TypeError", "strict throughout: more keys outside", () => JSON.parse<Deep>('{"inner":{"x":1},"list":[],"more":0}'));
//// json-parse-by-type-takes-its-arguments-from-a-list.ts
////= Point

import { JSON } from "bun"; function outcome(run: () => Point): string {
  try {
    const p = run();
    return "value " + (p.x + p.y);
  } catch (error) {
    return error instanceof Error ? error.constructor.name : typeof error;
  }
}

const texts = ['{"x":1,"y":2}', '{"x":1}', '{"x":1,"y":"2"}', "null"];
function textAt(i: number): string {
  return texts[i];
}

for (let i = 0; i < texts.length; i++) {
  console.log(texts[i], "as an argument:", outcome(() => JSON.parse<Point>(textAt(i))));
  console.log(texts[i], "in a list:", outcome(() => JSON.parse<Point>(...([textAt(i)] as [string]))));
  console.log(texts[i], "in a list with a reviver:", outcome(() => JSON.parse<Point>(...([textAt(i), (_key: string, value: unknown) => value] as [string, (key: string, value: unknown) => unknown]))));
}
//// json-parse-by-type-through-the-json-that-bun-exports.ts
// `import { JSON } from "bun"` and `Bun.JSON` are one object, which is not the global `JSON`, and a parse by type through them validates. The installed types give the `JSON` that "bun" exports signatures of its own.
import { JSON as Typed } from "bun";

////= lines	User	id	number	name	string
const text = '{"id":7,"name":"Ada"}';
const wrong = '{"id":"7"}';
function attempt(label: string, run: () => unknown): void {
  try {
    console.log(label, JSON.stringify(run()));
  } catch (error) {
    console.log(label, (error as Error).constructor.name);
  }
}
console.log("one object", Typed === Bun.JSON, "the global", Typed === JSON, Bun.JSON === JSON);
attempt("global, right", () => JSON.parse(text) as User);
attempt("global, wrong", () => JSON.parse(wrong) as User);
attempt("imported, right", () => Typed.parse<User>(text));
attempt("imported, wrong", () => Typed.parse<User>(wrong));
attempt("Bun.JSON, right", () => Bun.JSON.parse<User>(text));
attempt("Bun.JSON, wrong", () => Bun.JSON.parse<User>(wrong));
attempt("imported, taken off", () => {
  const { parse } = Typed;
  return parse<User>(wrong);
});
attempt("no type argument", () => JSON.parse(wrong));
attempt("imported, any", () => Typed.parse<any>(wrong));
//// keys-in-another-order-and-more-keys-arrive-for-an-annotated-variable.ts
////= Point

////= norm
function move(point: Point): void {
  point.x += 1;
  point.y -= 1;
}

const written: Point = { x: 3, y: 4 };
const turned: Point = JSON.parse('{"y":4,"x":3}');
const wider: Point = JSON.parse('{"a":0,"x":3,"b":0,"y":4,"c":0}');
const indexed: Point = JSON.parse('{"x":3,"1":0,"y":4,"0":0}');
const twice: Point = JSON.parse('{"x":0,"y":4,"x":3}');
for (const point of [written, turned, wider, indexed, twice]) {
  console.log(norm(point), Object.keys(point).join(), JSON.stringify(point));
  move(point);
  console.log(norm(point), Object.keys(point).join(), JSON.stringify(point));
}
