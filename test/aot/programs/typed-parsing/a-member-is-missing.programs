//// parsed-by-type-negative-zero-in-an-int32-member.ts
import { JSON } from "bun"; import type { int32 } from "bun";

////= show-2

////= lines	Point	x	int32	y	int32

function uses(v: int32): unknown[] {
  return [v, 1 / v, Object.is(v, -0), Object.is(v, 0), v === 0, String(v), v + 0, v * 1, -v, v | 0, Math.sign(v), Math.max(v, -0), Math.atan2(v, -1) > 0, [v], JSON.stringify(v)];
}
////= lines-3	xOf	point	Point	int32	point.x
class Kept {
  held: int32 = 1;
}

attempt("an honest zero", () => uses(xOf(JSON.parse<Point>('{"x":0,"y":1}'))));
for (const spelling of ["-0", "-0.0", "-0e0", "-0E+5", "-0.000e-3"]) {
  attempt(spelling, () => {
    const point = JSON.parse<Point>('{"x":' + spelling + ',"y":1}');
    return [point, uses(xOf(point)), uses(point.x)];
  });
  attempt(spelling + " kept in a field", () => {
    const kept = new Kept();
    kept.held = JSON.parse<Point>('{"x":' + spelling + ',"y":1}').x;
    return [kept.held, 1 / kept.held];
  });
  attempt(spelling + " alone", () => uses(JSON.parse<int32>(spelling)));
  attempt(spelling + " in a list", () => {
    const list = JSON.parse<int32[]>("[1," + spelling + "]");
    return [list, uses(list[1])];
  });
}
attempt("other spellings of integers", () => ["1.0", "1e2", "100e-2", "2147483647.0", "-2147483648", "2.147483647e9", "0.0"].map(spelling => JSON.parse<Point>('{"x":' + spelling + ',"y":0}').x));
//// parsed-by-type-nested-a-few-hundred-levels-deep.ts
////= show-2

import { JSON } from "bun"; interface Tree {
  value: number;
  children: Tree[];
}
interface Chain {
  next: Chain | null;
}
type Nest = Nest[];

function depthOf(tree: Tree): number {
  let depth = 1;
  let at = tree;
  while (at.children.length > 0) {
    at = at.children[0];
    depth++;
  }
  return depth;
}
function sumOf(tree: Tree): number {
  let sum = tree.value;
  for (const child of tree.children) sum += sumOf(child);
  return sum;
}
function lengthOf(chain: Chain): number {
  let length = 0;
  for (let at: Chain | null = chain; at !== null; at = at.next) length++;
  return length;
}
function levels(nest: Nest): number {
  let count = 1;
  let at = nest;
  while (at.length > 0) {
    at = at[0];
    count++;
  }
  return count;
}

for (const depth of [1, 2, 10, 100, 400]) {
  attempt("a tree of depth " + depth, () => {
    const tree = JSON.parse<Tree>('{"value":1,"children":['.repeat(depth).slice(0, -1) + "[]" + "}]".repeat(depth).slice(0, -1));
    return [depthOf(tree), sumOf(tree)];
  });
  attempt("a chain of length " + depth, () => lengthOf(JSON.parse<Chain>('{"next":'.repeat(depth) + "null" + "}".repeat(depth))));
  attempt("lists in lists, " + depth + " levels", () => levels(JSON.parse<Nest>("[".repeat(depth) + "]".repeat(depth))));
}
attempt("a wide tree", () => {
  const leaf = '{"value":1,"children":[]}';
  const branch = '{"value":10,"children":[' + Array.from({ length: 20 }, () => leaf).join(",") + "]}";
  const tree = JSON.parse<Tree>('{"value":100,"children":[' + Array.from({ length: 20 }, () => branch).join(",") + "]}");
  return [depthOf(tree), sumOf(tree), tree.children[19].children[19]];
});
//// parsed-by-type-nesting-of-a-million-levels-gives-the-value-or-a-range-error.ts
////= show-2

import { JSON } from "bun"; type Nest = Nest[];
interface Chain {
  next: Chain | null;
}

function levels(nest: Nest): number {
  let count = 1;
  for (let at = nest; at.length > 0; at = at[0]) count++;
  return count;
}
function links(chain: Chain): number {
  let count = 0;
  for (let at: Chain | null = chain; at !== null; at = at.next) count++;
  return count;
}
function either(label: string, wanted: number, run: () => number): void {
  let got: string;
  try {
    const value = run();
    got = value === wanted ? "the value or a RangeError" : "another value: " + value;
  } catch (error) {
    got = error instanceof RangeError ? "the value or a RangeError" : error instanceof Error ? error.constructor.name : typeof error;
  }
  console.log(label, "->", got);
}

for (const depth of [10_000, 100_000, 1_000_000]) {
  either(depth + " lists", depth, () => levels(JSON.parse<Nest>("[".repeat(depth) + "]".repeat(depth))));
  either(depth + " objects", depth, () => links(JSON.parse<Chain>('{"next":'.repeat(depth) + "null" + "}".repeat(depth))));
  attempt(depth + " lists that are never closed", () => JSON.parse<Nest>("[".repeat(depth)));
  attempt("afterwards", () => [levels(JSON.parse<Nest>("[[[]]]")), links(JSON.parse<Chain>('{"next":{"next":null}}'))]);
}
//// parsed-by-type-numbers-in-odd-spellings.ts
