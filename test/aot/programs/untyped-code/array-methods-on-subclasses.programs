// ---- a97: the element read may throw
const boom = (a, at) => Object.defineProperty(a, at, { get() { throw "boom" + at; }, configurable: true });
row("for of in a try", () => { function f(a) { try { for (const x of a) boom(a, 1); } catch (e) { return "caught " + e; } return "none"; } try { return f([1, 2]); } catch (e) { return "THE CALLER caught " + e; } });
row("the first element", () => { function f(a) { try { for (const x of a) return "ran"; } catch (e) { return "caught " + e; } return "none"; } try { return f(boom([1, 2], 0)); } catch (e) { return "THE CALLER caught " + e; } });
row("an assignment head", () => { function f(a) { let x; try { for (x of a); } catch (e) { return "caught " + e + " x " + x; } return "none"; } try { return f(boom([1, 2, 3], 1)); } catch (e) { return "THE CALLER caught " + e; } });
row("a pattern head", () => { function f(a) { try { for (const [x] of a); } catch (e) { return "caught " + e; } return "none"; } try { return f(boom([[1], [2]], 1)); } catch (e) { return "THE CALLER caught " + e; } });
row("a member head", () => { function f(a) { const o = {}; try { for (o.x of a); } catch (e) { return "caught " + e + " " + o.x; } return "none"; } try { return f(boom([1, 2], 1)); } catch (e) { return "THE CALLER caught " + e; } });
row("finally runs, then the outer catch", () => { const log = []; function f(a) { try { try { for (const x of a) log.push(x); } finally { log.push("finally"); } } catch (e) { log.push("caught " + e); } return log.join(); } try { return f(boom([1, 2, 3], 2)); } catch (e) { return "THE CALLER caught " + e + " " + log.join(); } });
row("the try stands in the loop's body only", () => { function f(a) { for (const x of a) { try { boom(a, 1); } catch (e) { return "the body's try caught " + e; } } return "none"; } try { return f([1, 2]); } catch (e) { return "the caller caught " + e; } });
row("two loops, the inner one throws", () => { function f(a, b) { try { for (const x of a) { try { for (const y of b); } catch (e) { return "inner caught " + e; } } } catch (e) { return "outer caught " + e; } return "none"; } try { return f([1], boom([1, 2], 1)); } catch (e) { return "THE CALLER caught " + e; } });
row("in a generator", () => { function* g(a) { try { for (const x of a) yield x; } catch (e) { yield "caught " + e; } } try { return [...g(boom([1, 2, 3], 1))].join(); } catch (e) { return "THE CALLER caught " + e; } });
row("in an arrow", () => { const f = a => { try { for (const x of a); } catch (e) { return "caught " + e; } return "none"; }; try { return f(boom([1, 2], 1)); } catch (e) { return "THE CALLER caught " + e; } });
row("in a method", () => { class K { f(a) { try { for (const x of a); } catch (e) { return "caught " + e; } return "none"; } } try { return new K().f(boom([1, 2], 1)); } catch (e) { return "THE CALLER caught " + e; } });
row("the iterator is not closed by what a step throws", () => { const log = []; const it = { [Symbol.iterator]() { return { next() { log.push("next"); throw "from next"; }, return() { log.push("return"); return {}; } }; } }; try { for (const x of it); } catch (e) { log.push("caught " + e); } return log.join(); });
row("a value getter of a hand-made iterator throws", () => { const log = []; const it = { [Symbol.iterator]() { return { next() { return { done: false, get value() { throw "from value"; } }; }, return() { log.push("return"); return {}; } }; } }; function f() { try { for (const x of it); } catch (e) { return "caught " + e; } } try { return f() + " " + log.join(); } catch (e) { return "THE CALLER caught " + e; } });
row("a spread in a try", () => { function f(a) { try { return [...a].length; } catch (e) { return "caught " + e; } } try { return f(boom([1, 2], 1)); } catch (e) { return "THE CALLER caught " + e; } });
row("a pattern in a try", () => { function f(a) { try { const [x, y] = a; return x + y; } catch (e) { return "caught " + e; } } try { return f(boom([1, 2], 1)); } catch (e) { return "THE CALLER caught " + e; } });
row("an elision in a try", () => { function f(a) { try { const [, y] = a; return "y " + y; } catch (e) { return "caught " + e; } } try { return f(boom([1, 2], 0)); } catch (e) { return "THE CALLER caught " + e; } });
row("hot, then it throws", () => { function f(a) { let s = 0; try { for (const x of a) s += x; } catch (e) { return "caught " + e + " at " + s; } return s; } let t = 0; for (let i = 0; i < 300; i++) t += f([1, 2, 3]); try { return t + " " + f(boom([1, 2, 3], 2)); } catch (e) { return "THE CALLER caught " + e; } });
(async () => { async function f(a) { try { for (const x of a) await 0; } catch (e) { return "caught " + e; } return "none"; } try { console.log("in an async function: " + await f(boom([1, 2], 1))); } catch (e) { console.log("in an async function: THE CALLER caught " + e); }
  async function h(a) { try { for await (const x of a); } catch (e) { return "caught " + e; } return "none"; } try { console.log("for await over an array: " + await h(boom([1, 2], 1))); } catch (e) { console.log("for await over an array: THE CALLER caught " + e); } })();
//// array-slice-of-unknown-receiver.js
// `x.slice(..)` where nothing is known of `x`: arrays of every kind, what only looks like one, and other receivers at the same site.
const lines = [];
////= say-3
////= lines-23	two	x	from	to	x.slice
////= lines-16	one	x	from	x.slice
////= lines-21	none	x	x.slice
function three(x, from, to, more) {
  return x.slice(from, to, more);
}
const describe = part => [Array.isArray(part), part.length, Object.keys(part).join(), part];

const integers = [10, 11, 12, 13, 14, 15];
const fractions = [0.5, 1.5, 2.5, 3.5];
const values = ["a", { b: 1 }, null, undefined, 4, 5.5];
const made = [];
for (let i = 0; i < 9; i++) made.push({ id: i });
const holes = [1, , 3, , 5];
const fractionsWithHoles = [0.5, , 2.5];
const long = Array.from({ length: 200 }, (_, i) => i);
const sparse = [];
sparse[5000] = "far";
sparse[1] = "near";

for (let turn = 0; turn < 3; turn++) {
  for (const [name, array] of Object.entries({ integers, fractions, values, made, holes, fractionsWithHoles })) {
    say(name + " 1..3 " + turn, () => describe(two(array, 1, 3)));
    say(name + " from 2 " + turn, () => describe(one(array, 2)));
    say(name + " whole " + turn, () => describe(none(array)));
  }
}
for (const [from, to] of [[0, 0], [0, 1], [0, 100], [3, 1], [-2, 100], [-100, -1], [-1, -3], [5, 6], [6, 7], [100, 200], [-2147483648, 2147483647], [2147483647, -2147483648]])
  say("integers " + from + ".." + to, () => [two(integers, from, to), two(fractions, from, to), one(values, from).length]);
for (const [name, from, to] of [["fractions", 1.9, 3.1], ["undefined", undefined, undefined], ["an end that is undefined", 1, undefined], ["null", null, null], ["strings", "1", "3"], ["NaN", NaN, NaN], ["infinities", -Infinity, Infinity], ["minus zero", -0, 2], ["booleans", true, false], ["large numbers", 1, 4294967297]])
  say("bounds that are " + name, () => [two(integers, from, to), one(integers, from)]);
say("bounds with valueOf, in order", () => { const order = []; const bound = (name, value) => ({ valueOf() { order.push(name); return value; } }); return [two(integers, bound("from", 1), bound("to", 4)), order]; });
say("a bound that shortens the array", () => { const array = [1, 2, 3, 4, 5]; return describe(two(array, 1, { valueOf() { array.length = 2; return 4; } })); });
say("a bound that is a symbol", () => two(integers, Symbol(), 1));
say("a bound that is a bigint", () => one(integers, 1n));
say("more arguments", () => three(integers, 1, 3, "ignored"));
say("a long array", () => [two(long, 10, 150).length, two(long, 10, 150)[139], two(long, 190, 500), one(long, 100).length, two(long, 0, 64).length, two(long, 0, 65).length]);
say("a sparse array", () => [describe(two(sparse, 0, 3)), two(sparse, 4999, 5002).length, Object.keys(one(sparse, 1)).join()]);
say("the part is a copy", () => { const array = [1, 2, 3]; const part = two(array, 0, 2); part[0] = "changed"; part.push("more"); array[1] = "later"; return [array, part]; });
say("the elements are shared", () => two(made, 2, 3)[0] === made[2]);
say("the part of a literal can be written", () => { const part = two([1, 2, 3, 4], 1, 3); part[0] = 0.5; part[1] = "x"; return part; });
say("empty arrays", () => [describe(two([], 0, 1)), describe(one([], 0)), describe(two(new Array(3), 0, 2)), describe(two(new Array(0), 0, 2))]);
say("a frozen array", () => { const part = two(Object.freeze([1, 2, 3]), 0, 2); part.push(9); return [part, Object.isFrozen(part)]; });
say("an array with a name on it", () => { const array = Object.assign([1, 2, 3], { extra: true }); return describe(two(array, 0, 2)); });

class Stack extends Array {}
say("a subclass", () => { const part = two(Stack.from([1, 2, 3]), 0, 2); return [part instanceof Stack, part.length, [...part]]; });
say("its own constructor", () => { const array = [1, 2, 3]; array.constructor = Stack; const part = two(array, 1, 3); return [part instanceof Stack, [...part]]; });
say("a constructor without a species", () => { const array = [1, 2, 3]; array.constructor = { [Symbol.species]: null }; return describe(two(array, 1, 3)); });
say("a constructor that is no object", () => { const array = [1, 2, 3]; array.constructor = 1; return two(array, 1, 3); });
say("another prototype", () => { const array = Object.setPrototypeOf([1, 2, 3], { slice: () => "mine" }); return two(array, 0, 1); });
say("an own slice", () => { const array = [1, 2, 3]; array.slice = function (from) { return "own " + from + " of " + this.length; }; return two(array, 1, 2); });
say("an accessor at an index", () => { const array = [1, 2, 3]; Object.defineProperty(array, 1, { get() { return "got"; }, enumerable: true, configurable: true }); return two(array, 0, 3); });

const slice = Array.prototype.slice;
say("called on what is like an array", () => describe(slice.call({ length: 3, 0: "a", 2: "c" }, 0, 3)));
say("called on arguments", () => (function () { return slice.call(arguments, 1, 3); })(1, 2, 3, 4));
say("called on a string", () => slice.call("hello", 1, 3));
say("called on a number", () => slice.call(5, 0, 1));
say("called on undefined", () => slice.call(undefined, 0, 1));
say("called on an array", () => [slice.call(integers, 1, 3), slice.apply(fractions, [1, 3]), Reflect.apply(slice, values, [0, 1])]);
say("held in a variable", () => { const held = integers.slice; return held.call(made, 7, 9); });
say("bound", () => slice.bind(integers)(4, 6));

say("strings at the same site", () => [two("hello world", 1, 4), one("hello", -2), none("whole"), two("", 0, 1), two("é漢字", 1, 2)]);
say("typed arrays at the same site", () => [Array.from(two(new Uint8Array([1, 2, 3, 4]), 1, 3)), two(new Float64Array([0.5, 1.5]), 0, 1) instanceof Float64Array]);
say("buffers at the same site", () => two(new ArrayBuffer(8), 2, 6).byteLength);
say("an object's own method at the same site", () => two({ slice: (from, to) => from + to }, 1, 2));
say("no method", () => two({}, 1, 2));
say("null", () => two(null, 1, 2));

console.log(lines.join("\n"));
//// array-subclasses-as-array-types.ts
// A subclass of Array, or an array with another prototype, that overrides nothing works at type `T[]` as in plain Bun: every method and what it returns.
declare const console: { log(...values: unknown[]): void };
const out: string[] = [];
const hide = (v: unknown): any => v;
const show = (v: unknown): string => Array.isArray(v) ? (v as object).constructor.name + "[" + v.length + "]" + v.map(x => String(x)).join() : typeof v === "object" && v !== null && typeof hide(v).next === "function" ? "iterator " + [...hide(v)].join(";") : String(v);
const f = (x: string): boolean => x === "b";
const calls: [string, (xs: string[]) => unknown][] = [
    ["push", xs => xs.push("z")], ["pop", xs => xs.pop()], ["shift", xs => xs.shift()], ["unshift", xs => xs.unshift("z")],
    ["slice", xs => xs.slice(1)], ["splice", xs => xs.splice(0, 1)], ["concat", xs => xs.concat(["z"])], ["join", xs => xs.join("-")],
    ["indexOf", xs => xs.indexOf("b")], ["lastIndexOf", xs => xs.lastIndexOf("b")], ["includes", xs => xs.includes("b")],
    ["sort", xs => xs.sort()], ["reverse", xs => xs.reverse()], ["fill", xs => xs.fill("z")], ["at", xs => xs.at(0)],
    ["flat", xs => xs.flat()], ["flatMap", xs => xs.flatMap(x => [x])], ["map", xs => xs.map(x => x + "!")], ["filter", xs => xs.filter(f)],
    ["forEach", xs => { let s = ""; xs.forEach(x => { s += x; }); return s; }], ["some", xs => xs.some(f)], ["every", xs => xs.every(f)],
    ["find", xs => xs.find(f)], ["findIndex", xs => xs.findIndex(f)], ["findLast", xs => xs.findLast(f)], ["findLastIndex", xs => xs.findLastIndex(f)],
    ["reduce", xs => xs.reduce((a, x) => a + x, "")], ["reduceRight", xs => xs.reduceRight((a, x) => a + x, "")],
    ["keys", xs => xs.keys()], ["values", xs => xs.values()], ["entries", xs => xs.entries()], ["toString", xs => xs.toString()],
    ["copyWithin", xs => xs.copyWithin(0, 1)], ["toSorted", xs => xs.toSorted()], ["toReversed", xs => xs.toReversed()], ["toSpliced", xs => xs.toSpliced(0, 1)], ["with", xs => xs.with(0, "z")],
];
class Stack extends Array<string> { top(): string | undefined { return this[this.length - 1]; } }
class Result extends Array<string> { count = 0; static get [Symbol.species](): ArrayConstructor { return Array; } }
class ZeroArray extends Array<number> { constructor(size: number) { super(size); this.fill(0); } }
class Items extends Array<string> { add(x: string): void { this.push(x); } remove(i: number): void { this.splice(i, 1); } clear(): void { while (this.length) this.pop(); } }
const makers: [string, () => string[]][] = [
    ["plain", () => ["a", "b", "c"]],
    ["heir", () => hide(Stack.of("a", "b", "c"))],
    ["species", () => { const r = new Result(); r.push("a", "b", "c"); return hide(r); }],
    ["other prototype", () => hide(Object.setPrototypeOf(["a", "b", "c"], Object.create(Array.prototype)))],
    ["own property", () => hide(Object.assign(["a", "b", "c"], { extra: 1 }))],
    ["frozen", () => hide(Object.freeze(["a", "b", "c"]))],
];
for (const [name, call] of calls) out.push(name + ": " + makers.map(([how, make]) => { const xs = make(); let r: string; try { r = show(call(xs)); } catch (e) { r = (e as Error).name; } return how + " " + r + " -> " + show(xs); }).join(" | "));
{ const z = new ZeroArray(3); const items = new Items(); items.add("a"); items.add("b"); items.remove(0); const held = show(items); items.clear(); out.push("as the packages do: " + show(z) + " " + held + " " + show(items) + " " + new Stack("a", "b").top()); }
console.log(out.join("\n"));
//// arrays-made-from-maps-sets-and-their-iterators.js
function show(label, value) {
  console.log(label, JSON.stringify(value));
}

function filled(count, make) {
  const set = new Set();
  for (let i = 0; i < count; ++i) set.add(make(i));
  return set;
}

for (const count of [0, 1, 4, 9, 300]) {
  const integers = filled(count, i => i * 3);
  const doubles = filled(count, i => i + 0.5);
  const strings = filled(count, i => "s" + i);
  const mixed = filled(count, i => (i % 3 === 0 ? i : i % 3 === 1 ? "m" + i : i / 4));
  for (const set of [integers, doubles, strings, mixed]) {
    const list = Array.from(set);
    const spread = [...set];
    show("set " + count, [list.length, list.slice(0, 3), list.slice(-2), spread.length, spread.join() === list.join()]);
    show("set iterators " + count, [Array.from(set.values()).join() === list.join(), Array.from(set.keys()).join() === list.join(), Array.from(set.entries()).length]);
  }

  const map = new Map();
  for (let i = 0; i < count; ++i) map.set("k" + i, i % 2 ? i : i + 0.25);
  show("map " + count, [Array.from(map.keys()).slice(-2), Array.from(map.values()).slice(-2), Array.from(map).slice(-1), [...map.values()].length]);
}

{
  const set = new Set([1, 2, 3, 4, 5]);
  const started = set.values();
  started.next();
  started.next();
  set.delete(1);
  set.delete(4);
  for (let i = 10; i < 80; ++i) set.add(i);
  const rest = Array.from(started);
  show("started", [rest.length, rest.slice(0, 4), started.next().done]);
  set.add("later");
  show("finished stays finished", [Array.from(started), started.next().done, [...started]]);
}

{
  const map = new Map([["a", 1], ["b", 2], ["c", 3]]);
  const keys = map.keys();
  const values = map.values();
  keys.next();
  values.next();
  map.clear();
  map.set("x", 1.5);
  map.set("y", 2.5);
  show("cleared", [Array.from(keys), Array.from(values), map.size]);
  const empty = new Map().keys();
  show("empty", [Array.from(empty), Array.from(new Set().values()), Array.from(new Set())]);
}

{
  const a = filled(40, i => i);
  const b = filled(40, i => i * 2);
  const methods = ["union", "intersection", "difference", "symmetricDifference"];
  for (const name of methods) show(name, [...a[name](b)].slice(-5).concat(a[name](b).size));
  show("relations", [a.isSubsetOf(b), a.isSupersetOf(new Set([1, 39])), a.isDisjointFrom(new Set([40, 41])), new Set([2, 4]).isSubsetOf(b)]);

  const growing = new Set([1, 2, 3]);
  const setLike = {
    size: 100,
    has(value) {
      if (value < 40) growing.add(value + 10);
      return value % 2 === 0;
    },
    keys() {
      return [][Symbol.iterator]();
    },
  };
  show("changes in a callback", [[...growing.intersection(setLike)], growing.size, growing.isSubsetOf(setLike)]);
}

{
  const set = filled(12, i => "v" + i);
  const map = new Map([...set].map((value, index) => [value, index]));
  const setCopy = new Set(set);
  const mapCopy = new Map(map);
  set.delete("v0");
  map.delete("v0");
  show("copies", [setCopy.size, mapCopy.size, set.size, map.size, setCopy.has("v0"), mapCopy.get("v0")]);
  show("from iterators", [new Set(map.keys()).size, new Set(map.values()).has(11), new Map(map.entries()).get("v11"), new Set(set.values()).size]);
  show("grouped", [...Map.groupBy(setCopy, value => value.length)].map(([key, list]) => [key, list.length]));
}

{
  const map = new Map();
  const seen = [map.getOrInsert("a", 1), map.getOrInsert("a", 2)];
  seen.push(
    map.getOrInsertComputed("b", key => {
      for (let i = 0; i < 50; ++i) map.set(key + i, i);
      return "computed";
    }),
  );
  seen.push(map.getOrInsertComputed("b", () => "never"), map.size, map.get("b49"));
  try {
    map.getOrInsertComputed("c", () => {
      throw new Error("from the callback");
    });
  } catch (error) {
    seen.push(error.message, map.has("c"));
  }
  show("getOrInsert", seen);
}

{
  const set = new Set(["a", "b", "c"]);
  const seen = [];
  set.forEach(value => {
    seen.push(value);
    if (value === "a") set.delete("b");
    if (seen.length < 30) set.add(value + seen.length);
  });
  show("forEach", [seen.length, seen.slice(0, 5), set.size]);
