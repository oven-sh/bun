  await row("a then getter of what is awaited", async log => { let g; async function* ag() { await { get then() { (async () => log("other:", show(await g)))(); return undefined; } }; yield 1; } for await (const v of g = ag()) log("loop", show(v)); });
  await row("a thenable that awaits it", async log => { let g; async function* ag() { log("got", await { then(ok) { (async () => ok(show(await g)))(); } }); yield 1; } for await (const v of g = ag()) log("loop", show(v)); });
  await row("a constructor getter of a promise that is awaited", async log => { let g; async function* ag() { const p = Promise.resolve(5); Object.defineProperty(p, "constructor", { get() { (async () => log("other:", show(await g)))(); return Promise; } }); log("got", await p); yield 1; } for await (const v of g = ag()) log("loop", show(v)); });
  await row("finally on break awaits it", async log => { let g; async function* ag() { try { yield 1; yield 2; } finally { log("finally:", show(await g)); } } for await (const v of g = ag()) { log("loop", show(v)); break; } });
  await row("finally on a throw in the loop awaits it", async log => { let g; async function* ag() { try { yield 1; } finally { log("finally:", show(await g)); } } try { for await (const v of g = ag()) { log("loop", show(v)); throw new RangeError("out"); } } catch (e) { log("caught", String(e)); } });
  await row("finally spawns another that awaits it", async log => { let g; async function* ag() { try { yield 1; } finally { (async () => log("other:", show(await g)))(); } } for await (const v of g = ag()) { log("loop", show(v)); break; } });
  await row("Promise.all and race of it", async log => { let g; async function* ag() { Promise.all([g, 1]).then(v => log("all:", show(v[0]), v[1])); Promise.race([g]).then(v => log("race:", show(v))); yield 1; } for await (const v of g = ag()) log("loop", show(v)); });
  await row("two generators drained inside each other", async log => { let a, b; async function* inner() { log("inner sees a:", show(await a) , "b:", show(await b)); yield "i1"; } async function* outer() { for await (const w of b = inner()) { log("outer got", w); yield w; } log("outer sees a:", show(await a)); yield "o2"; } for await (const v of a = outer()) log("loop", show(v)); });
  await row("the inner one spawns awaiters of both", async log => { let a, b; async function* inner() { (async () => log("x:", show(await a)))(); (async () => log("y:", show(await b)))(); yield "i1"; } async function* outer() { for await (const w of b = inner()) yield w; } for await (const v of a = outer()) log("loop", show(v)); });
  await row("requests queued from the body", async log => { let g; async function* ag() { g.next("q1").then(r => log("queued 1:", JSON.stringify(r))); g.next("q2").then(r => log("queued 2:", JSON.stringify(r))); log("self:", show(await g)); log("y1 got", yield 1); log("y2 got", yield 2); log("y3 got", yield 3); } for await (const v of g = ag()) log("loop", show(v)); });
  await row("return queued from the body", async log => { let g; async function* ag() { g.return("r").then(r => log("returned:", JSON.stringify(r))); (async () => log("other:", show(await g)))(); yield 1; yield 2; } for await (const v of g = ag()) log("loop", show(v)); });
  await row("throw queued from the body", async log => { let g; async function* ag() { g.throw(new RangeError("t")).then(r => log("thrown:", JSON.stringify(r)), e => log("thrown rejected:", String(e))); (async () => log("other:", show(await g)))(); try { yield 1; } catch (e) { log("body caught", String(e)); } yield 2; } for await (const v of g = ag()) log("loop", show(v)); });
