//// bigint-arithmetic-and-comparisons-of-unknown-values.js
// + - * / % < <= > >= where nothing is known about either side and both turn out to be BigInts, beside every mix with numbers, strings, objects and nullish values (which throw, convert or compare as the language says).
const print = (s) => console.log(s);
const values = [
  0n,
  -0n,
  1n,
  -1n,
  7n,
  -7n,
  1000000n,
  4294967296n,
  -4294967296n,
  9007199254740993n,
  18446744073709551615n,
  18446744073709551616n,
  -18446744073709551617n,
  123456789012345678901234567890123456789n,
  BigInt(Date.UTC(2020, 0, 1)) * 1000000n,
  0,
  -0,
  1,
  7.5,
  NaN,
  Infinity,
  "7",
  "7n",
  "",
  "x",
  null,
  undefined,
  true,
  { valueOf() { return 7n; } },
  { valueOf() { return 7; } },
  [7],
  Symbol.iterator,
];
const operations = {
  add: (a, b) => a + b,
  subtract: (a, b) => a - b,
  multiply: (a, b) => a * b,
  divide: (a, b) => a / b,
  remainder: (a, b) => a % b,
  less: (a, b) => a < b,
  lessOrEqual: (a, b) => a <= b,
  greater: (a, b) => a > b,
  greaterOrEqual: (a, b) => a >= b,
};
function show(x) {
  return typeof x === "bigint" ? x + "n" : Object.is(x, -0) ? "-0" : typeof x === "string" ? JSON.stringify(x) : String(x);
}
for (const name in operations) {
  const operation = operations[name];
  let hash = 0;
  const samples = [];
  for (let i = 0; i < values.length; i++) {
    for (let j = 0; j < values.length; j++) {
      let text;
      try {
        text = show(operation(values[i], values[j]));
      } catch (e) {
        text = e.name;
      }
      for (let k = 0; k < text.length; k++)
        hash = (hash * 31 + text.charCodeAt(k)) | 0;
      if ((i * values.length + j) % 37 === 0)
        samples.push(text);
    }
  }
  print(name + " " + hash + " " + samples.join(" "));
}
function clock(ticks) {
  const scale = BigInt(1000000);
  let previous = BigInt(0);
  let origin;
  let steps = 0;
  for (const tick of ticks) {
    const current = BigInt(tick) * scale;
    if (origin === undefined)
      origin = current - previous;
    if (current > previous) {
      previous = current;
      steps++;
    }
    if (current + origin >= previous + previous)
      steps += 100;
  }
  return previous + "n " + origin + "n " + steps;
}
print(clock([5, 3, 9, 9, 12, 1700000000000, 2, 1700000000001]));
//// binary-operators-on-every-pair.js
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;

function add(a, b) { return a + b; }
function sub(a, b) { return a - b; }
function mul(a, b) { return a * b; }
function div(a, b) { return a / b; }
function mod(a, b) { return a % b; }
function bitAnd(a, b) { return a & b; }
function bitOr(a, b) { return a | b; }
function bitXor(a, b) { return a ^ b; }
function leftShift(a, b) { return a << b; }
function rightShift(a, b) { return a >> b; }
function unsignedRightShift(a, b) { return a >>> b; }
function less(a, b) { return a < b; }
function lessEq(a, b) { return a <= b; }
function greater(a, b) { return a > b; }
function greaterEq(a, b) { return a >= b; }

function show(value) {
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "bigint") return value + "n";
  return Object.is(value, -0) ? "-0" : String(value);
}

function attempt(operator, left, right) {
  try {
    return show(operator(left, right));
  } catch (error) {
    return error.name;
  }
}

const makeOperands = [
  () => 0, () => -0, () => 1, () => -1, () => 2 ** 31 - 1, () => -(2 ** 31), () => 2 ** 32, () => 1.5, () => NaN, () => Infinity,
  () => true, () => false, () => null, () => undefined,
  () => "", () => "a", () => "b", () => "ab", () => "10", () => "ā",
  () => add("left half of ", "a rope string"),
  () => 1n, () => ({}), () => [], () => ({ valueOf() { return 2; } }),
];

const isInt32 = value => Object.is(value | 0, value);
const bothInt32 = (a, b) => isInt32(a) && isInt32(b);
const always = () => true;
const staysInt32 = operator => (a, b) => !bothInt32(a, b) || isInt32(operator(a, b));
const hasNonzeroInt32Product = (a, b) => !bothInt32(a, b) || (isInt32(a * b) && a * b !== 0);
const hasPositiveOperands = (a, b) => bothInt32(a, b) && a >= 0 && b > 0;
const fitsInt32 = (a, b) => a >>> b <= 2 ** 31 - 1;

const numbers = [0, -0, 1, -1, 2 ** 31 - 1, -(2 ** 31), 2 ** 32, 1.5, NaN, Infinity];
const truncatedOperands = [0, -0, 1, -1, 2 ** 31 - 1, -(2 ** 31), 2 ** 32, 1.5, true, false, null, undefined];
const nonemptyStrings = ["a", "b", "ab", "10"];
const flatStrings = ["", ...nonemptyStrings];

const operators = [
  ["add", add, "operationAOTValueAdd", numbers, staysInt32(add)],
  ["sub", sub, "operationAOTValueSub", numbers, staysInt32(sub)],
  ["mul", mul, "operationAOTValueMul", numbers, hasNonzeroInt32Product],
  ["div", div, "operationAOTValueDiv", numbers, always],
  ["mod", mod, "operationAOTValueMod", numbers, hasPositiveOperands],
  ["bitAnd", bitAnd, "operationAOTValueBitAnd", truncatedOperands, always],
  ["bitOr", bitOr, "operationAOTValueBitOr", truncatedOperands, always],
  ["bitXor", bitXor, "operationAOTValueBitXor", truncatedOperands, always],
  ["leftShift", leftShift, "operationAOTValueLShift", truncatedOperands, always],
  ["rightShift", rightShift, "operationAOTValueRShift", truncatedOperands, always],
  ["unsignedRightShift", unsignedRightShift, "operationAOTValueURShift", truncatedOperands, fitsInt32],
  ["less", less, "operationAOTCompareLess", numbers, always],
  ["lessEq", lessEq, "operationAOTCompareLessEq", numbers, always],
  ["greater", greater, "operationAOTCompareGreater", numbers, always],
  ["greaterEq", greaterEq, "operationAOTCompareGreaterEq", numbers, always],
];

for (const [name, operator] of operators) {
  makeOperands.forEach((makeLeft, index) => {
    const results = makeOperands.map(makeRight => attempt(operator, makeLeft(), makeRight()));
    console.log(name, index, results.join(" "));
  });
}

function pairsOf(lefts, rights, isIncluded) {
  const pairs = [];
  for (const left of lefts) {
    for (const right of rights) {
      if (isIncluded(left, right)) pairs.push([left, right]);
    }
  }
  return pairs;
}

const rounds = 1000;

function countRowCalls(operator, row, pairs) {
  const before = count(row);
  for (let round = 0; round < rounds; round++) {
    for (const [left, right] of pairs) operator(left, right);
  }
  return count(row) - before;
}

for (const [name, operator, row, operands, isIncluded] of operators) {
  console.log(name, "row calls on primitives", countRowCalls(operator, row, pairsOf(operands, operands, isIncluded)));
}

for (const [name, operator, row] of operators.slice(-4)) {
  console.log(name, "row calls on flat strings", countRowCalls(operator, row, pairsOf(flatStrings, flatStrings, always)));
}

console.log("add row calls with an empty string", countRowCalls(add, "operationAOTValueAdd", [["", "a"], ["a", ""], ["", ""]]));
const ropePairs = pairsOf(nonemptyStrings, nonemptyStrings, always);
const ropeRowCalls = countRowCalls(add, "operationAOTValueAdd", ropePairs);
console.log("add enters the row only to refill allocation", ropeRowCalls * 64 <= rounds * ropePairs.length);

console.log(show(add(2 ** 31 - 1, 1)));
console.log(show(sub(-(2 ** 31), 1)));
console.log(show(mul(65536, 65536)));
console.log(show(mul(0, -1)));
console.log(show(unsignedRightShift(-1, 0)));
console.log(show(mod(-1, 2)));
console.log(show(mod(1, 0)));
console.log(show(mod(5, -2)));
console.log(show(less("a", "ab")));
console.log(show(less("b", "ab")));
console.log(show(less("a", "ā")));
console.log(attempt(add, 1n, 1));
//// bit-operators-on-doubles-outside-int32.js
// & | ^ << >> >>> from untyped code on doubles outside int32: ToInt32 wraps modulo 2 ** 32. A double within int64 is converted without a call of the engine.
// Only the jsc shell can count. Elsewhere the count is zero.
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;

function bitAnd(a, b) { return a & b; }
function bitOr(a, b) { return a | b; }
function bitXor(a, b) { return a ^ b; }
function leftShift(a, b) { return a << b; }
function rightShift(a, b) { return a >> b; }
function unsignedRightShift(a, b) { return a >>> b; }

const withinInt64 = [
  2 ** 31, -(2 ** 31) - 1, 2 ** 32 - 1, 2 ** 32, 2 ** 32 + 5, -(2 ** 32) - 5, 2 ** 33 + 2 ** 31, 4294967296.75, -4294967296.75,
  2 ** 53 - 1, -(2 ** 53) + 1, 1e18, -1e18, 2 ** 62, -(2 ** 62), 2 ** 63 - 1024, -(2 ** 63) + 1024,
];
const outsideInt64 = [2 ** 63, -(2 ** 63), 2 ** 63 + 2048, 2 ** 64, 2 ** 64 + 2 ** 33, -(2 ** 64) - 2 ** 33, 2 ** 84 + 2 ** 32, 1e300, -1e300, Infinity, -Infinity, NaN];
const smallOperands = [0, 1, -1, 31, 32, 33, 1.5, 2 ** 31 - 1, -(2 ** 31)];
// These keep the operand types of the six functions unknown.
const otherOperands = ["7", "4294967301", null, undefined, true, { valueOf() { return 2 ** 32 + 9; } }];

const always = () => true;
const fitsInt32 = (a, b) => a >>> b <= 2 ** 31 - 1;
const operators = [
  ["bitAnd", bitAnd, "operationAOTValueBitAnd", always],
  ["bitOr", bitOr, "operationAOTValueBitOr", always],
  ["bitXor", bitXor, "operationAOTValueBitXor", always],
  ["leftShift", leftShift, "operationAOTValueLShift", always],
  ["rightShift", rightShift, "operationAOTValueRShift", always],
  ["unsignedRightShift", unsignedRightShift, "operationAOTValueURShift", fitsInt32],
];

const large = [...withinInt64, ...outsideInt64];
const all = [...large, ...smallOperands, ...otherOperands];
for (const [name, operator] of operators) {
  large.forEach((operand, index) => {
    console.log(name, index, "left", all.map(other => operator(operand, other)).join(" "));
    console.log(name, index, "right", all.map(other => operator(other, operand)).join(" "));
  });
}

const counted = [...withinInt64, ...smallOperands];
for (const [name, operator, row, isIncluded] of operators) {
  const pairs = [];
  for (const left of counted) {
    for (const right of counted) {
      if (isIncluded(left, right)) pairs.push([left, right]);
    }
  }
  const before = count(row);
  for (let round = 0; round < 100; round++) {
    for (const [left, right] of pairs) operator(left, right);
  }
  console.log(name, "row calls within int64", count(row) - before);
}
//// boolean-tagged-result-from-untyped-code/main.ts
// An object whose `ok` is a boolean computed at run time is returned from untyped code where a union
// discriminated by `ok: true | false` is declared. Each row has its own union, so that no row affects another.
import { later, pass } from "./untyped.js";

type R1 = { ok: true; status: number; d1: string } | { ok: false; status: number; d1: string };
async function f1(ok: boolean): Promise<R1> {
  return later({ ok, status: ok ? 200 : 500, d1: ok ? "body" : "reason" });
}
type R2 = { ok: true; status: number; d2: string } | { ok: false; status: number; d2: string };
async function f2(ok: boolean): Promise<R2> {
  return await later({ ok, status: ok ? 200 : 500, d2: ok ? "body" : "reason" });
}
type R3 = { ok: true; status: number; d3: string } | { ok: false; status: number; d3: string };
async function f3(ok: boolean): Promise<R3> {
  const result = await later({ ok, status: ok ? 200 : 500, d3: ok ? "body" : "reason" });
  return result;
}
type R4 = { ok: true; status: number; d4: string } | { ok: false; status: number; d4: string };
function f4(ok: boolean): Promise<R4> {
  return later({ ok, status: ok ? 200 : 500, d4: ok ? "body" : "reason" });
}
type R5 = { ok: true; status: number; d5: string } | { ok: false; status: number; d5: string };
const f5 = async (ok: boolean): Promise<R5> => later({ ok, status: ok ? 200 : 500, d5: ok ? "body" : "reason" });
type R6 = { ok: true; status: number; d6: string } | { ok: false; status: number; d6: string };
async function f6<T>(ok: boolean): Promise<T> {
  return later({ ok, status: ok ? 200 : 500, d6: ok ? "body" : "reason" });
}
type R7 = { ok: true; status: number; d7: string } | { ok: false; status: number; d7: string };
function f7(ok: boolean): Promise<R7> {
  return new Promise(resolve => {
    later({ ok, status: ok ? 200 : 500, d7: ok ? "body" : "reason" }).then(resolve);
  });
}
type R8 = { ok: true; status: number; d8: string } | { ok: false; status: number; d8: string };
class C8 {
  async get(ok: boolean): Promise<R8> {
    return later({ ok, status: ok ? 200 : 500, d8: ok ? "body" : "reason" });
  }
}
type R9 = { ok: true; status: number; d9: string } | { ok: false; status: number; d9: string };
async function f9(ok: boolean): Promise<R9> {
  return later({ ok, status: ok ? 200 : 500, d9: ok ? "body" : "reason" });
}
type R10 = { ok: true; status: number; d10: string } | { ok: false; status: number; d10: string };
async function f10(ok: boolean): Promise<R10[]> {
  return later([{ ok, status: ok ? 200 : 500, d10: ok ? "body" : "reason" }]);
}
type R11 = { ok: true; status: number; d11: string } | { ok: false; status: number; d11: string };
function f11(ok: boolean): R11 {
  return pass({ ok, status: ok ? 200 : 500, d11: ok ? "body" : "reason" });
}
type R12 = { ok: true; status: number; d12: string } | { ok: false; status: number; d12: string };
async function f12(ok: boolean): Promise<R12 | { ok: false; status: number; d12: string; retryAfter?: number }> {
  return later({ ok, status: ok ? 200 : 500, d12: ok ? "body" : "reason" });
}

type G = { ok: true; status: number; g: string } | { ok: false; status: number; g: string };
async function* each(): AsyncGenerator<G> {
  for (const ok of [true, false]) yield later({ ok, status: ok ? 200 : 500, g: ok ? "body" : "reason" });
}

for (const ok of [true, false]) {
  const r1 = await f1(ok);
  console.log("returns the promise:", r1.ok ? "ok" : "failed", r1.status, r1.d1);
  const r2 = await f2(ok);
  console.log("awaits first:", r2.ok ? "ok" : "failed", r2.status, r2.d2);
  const r3 = await f3(ok);
  console.log("through a local:", r3.ok ? "ok" : "failed", r3.status, r3.d3);
  const r4 = await f4(ok);
  console.log("not async:", r4.ok ? "ok" : "failed", r4.status, r4.d4);
  const r5 = await f5(ok);
  console.log("an arrow function:", r5.ok ? "ok" : "failed", r5.status, r5.d5);
  const r6 = await f6<R6>(ok);
  console.log("a type argument:", r6.ok ? "ok" : "failed", r6.status, r6.d6);
  const r7 = await f7(ok);
  console.log("a promise's resolve:", r7.ok ? "ok" : "failed", r7.status, r7.d7);
  const r8 = await new C8().get(ok);
  console.log("a method:", r8.ok ? "ok" : "failed", r8.status, r8.d8);
  const r9 = (await Promise.all([f9(ok)]))[0];
  console.log("Promise.all:", r9.ok ? "ok" : "failed", r9.status, r9.d9);
  const r10 = (await f10(ok))[0];
  console.log("in an array:", r10.ok ? "ok" : "failed", r10.status, r10.d10);
  const r11 = f11(ok);
  console.log("at once:", r11.ok ? "ok" : "failed", r11.status, r11.d11);
  const r12 = await f12(ok);
  console.log("an optional member in one part:", r12.ok ? "ok" : "failed", r12.status, r12.d12);
}
for await (const r of each()) console.log("an async generator:", r.ok ? "ok" : "failed", r.status, r.g);
//// boolean-tagged-result-from-untyped-code/untyped.js
export function pass(x) {
  return x;
}
export async function later(x) {
  await null;
  return x;
}
//// branches-on-untyped-values.js
// if, else, while, &&, ||, !, ?: on values of no type, with either arm empty, returning, looping or falling through; and comparisons of strings of no type with short texts: in every
// shape the code can be laid out in: what is truthy takes the one road, what is falsy the other.
const lines = [];
const values = [undefined, null, false, true, 0, -0, 1, NaN, 0.5, "", "a", "0", 0n, 1n, {}, [], () => 0, Symbol.iterator];
function thenOnly(v) { let n = 1; if (v) n = 2; return n; }
function elseOnly(v) { let n = 1; if (v) { } else n = 3; return n; }
function both(v) { if (v) return 4; else return 5; }
function early(v) { if (!v) return 6; return 7; }
function chain(a, b, c) { return a && b || c ? 8 : 9; }
function loop(list) { let i = 0; while (list[i]) i++; return i; }
function nested(a, b) { if (a) { if (b) return 10; return 11; } if (b) return 12; return 13; }
function throwing(v) { if (v) throw new Error("truthy"); return 14; }
function kind(s) { if (s === "one") return 1; if (s === "two") return 2; if (s !== "three") return s === "" ? 0 : -1; return 3; }
function word(s) { return s === "a" ? "A" : s === "ab" ? "AB" : s === "abcd" ? "ABCD" : s === "abcdef" ? "ABCDEF" : "?"; }
for (let round = 0; round < 3; round++) {
  const rows = values.map((v, i) => [thenOnly(v), elseOnly(v), both(v), early(v), chain(v, values[(i + 3) % values.length], values[(i + 7) % values.length]), nested(v, values[(i + 5) % values.length])].join(""));
  if (round === 2) lines.push(rows.join(" "));
}
lines.push("loop " + loop([1, "a", {}, 0, 1]) + " " + loop([]) + " " + loop([true, true]));
for (const v of values) { try { lines.push(String(throwing(v))); } catch (error) { lines.push(error.message); } }
lines.push(["one", "two", "three", "", "four", "on", "onee", 1, null, undefined, {}].map(kind).join(), ["a", "ab", "abcd", "abcdef", "", "b", "abc", "abcde", "abcdeg", 5].map(word).join());
lines.push([("o" + "ne"), ["t", "wo"].join(""), "xthree".slice(1)].map(kind).join());
console.log(lines.join("\n"));
//// buffer-contents-survive-added-properties.js
// Twenty properties added to a Buffer: by fields with written names, with computed names and with symbols, by private fields and private
// methods, and by stores: at code that has done it before. It keeps its ArrayBuffer, its place in it and its bytes, and every property
// reads back.
// Every value that is added is made by step(), which looks at what the object holds as it stands behind the additions so far.
var holds = null, lostAt = [];
function step(i) { if (holds && !holds()) lostAt.push(i); return i; }
class Stamp { constructor(o) { return o; } }
var texts = [], symbols = [];
for (var i = 0; i < 20; i++) { texts.push("key" + i); symbols.push(Symbol("s" + i)); }
class ByName extends Stamp { a = step(0); b = step(1); c = step(2); d = step(3); e = step(4); f = step(5); g = step(6); h = step(7); i = step(8); j = step(9); k = step(10); l = step(11); m = step(12); n = step(13); o = step(14); p = step(15); q = step(16); r = step(17); s = step(18); t = step(19); }
class ByText extends Stamp { [texts[0]] = step(0); [texts[1]] = step(1); [texts[2]] = step(2); [texts[3]] = step(3); [texts[4]] = step(4); [texts[5]] = step(5); [texts[6]] = step(6); [texts[7]] = step(7); [texts[8]] = step(8); [texts[9]] = step(9); [texts[10]] = step(10); [texts[11]] = step(11); [texts[12]] = step(12); [texts[13]] = step(13); [texts[14]] = step(14); [texts[15]] = step(15); [texts[16]] = step(16); [texts[17]] = step(17); [texts[18]] = step(18); [texts[19]] = step(19); }
class BySymbol extends Stamp { [symbols[0]] = step(0); [symbols[1]] = step(1); [symbols[2]] = step(2); [symbols[3]] = step(3); [symbols[4]] = step(4); [symbols[5]] = step(5); [symbols[6]] = step(6); [symbols[7]] = step(7); [symbols[8]] = step(8); [symbols[9]] = step(9); [symbols[10]] = step(10); [symbols[11]] = step(11); [symbols[12]] = step(12); [symbols[13]] = step(13); [symbols[14]] = step(14); [symbols[15]] = step(15); [symbols[16]] = step(16); [symbols[17]] = step(17); [symbols[18]] = step(18); [symbols[19]] = step(19); }
class Private extends Stamp { #a = step(0); #b = step(1); #c = step(2); #d = step(3); #e = step(4); #f = step(5); #g = step(6); #h = step(7); #i = step(8); #j = step(9); #k = step(10); #l = step(11); #m = step(12); #n = step(13); #o = step(14); #p = step(15); #q = step(16); #r = step(17); #s = step(18); #t = step(19); static read(o) { return [o.#a, o.#b, o.#c, o.#d, o.#e, o.#f, o.#g, o.#h, o.#i, o.#j, o.#k, o.#l, o.#m, o.#n, o.#o, o.#p, o.#q, o.#r, o.#s, o.#t]; } }
class PrivateMethods extends Stamp { #a() { return 0; } #b() { return 1; } #c() { return 2; } #d() { return 3; } #e() { return 4; } #f() { return 5; } #g() { return 6; } #h() { return 7; } #i() { return 8; } static read(o) { return [o.#a(), o.#b(), o.#c(), o.#d(), o.#e(), o.#f(), o.#g(), o.#h(), o.#i()]; } }
