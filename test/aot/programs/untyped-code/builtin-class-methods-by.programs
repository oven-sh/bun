//// class-accessors-resolved-once.js
// A getter of a class that is read by name is asked of the run time once for each shape of receiver, and the prototype need not make its members for that. What was learnt ends when the prototype changes.
// Only the jsc shell can count. Elsewhere the program checks the answers alone.
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;
const attempt = f => { try { return f(); } catch (error) { return error.constructor.name + ": " + error.message; } };
class Temperature {
  celsius = 20;
  get fahrenheit() { return this.celsius * 9 / 5 + 32; }
  set fahrenheit(value) { this.celsius = (value - 32) * 5 / 9; }
  get label() { return this.celsius + " C"; }
  set only(value) { this.celsius = value; }
  get failing() { throw new RangeError("too hot at " + this.celsius); }
  describe() { return this.label + " = " + this.fahrenheit + " F"; }
  reset() { this.celsius = 20; return this; }
}
class Kelvin extends Temperature {
  offset = 273;
  get label() { return this.celsius + this.offset + " K"; }
  get base() { return super.label; }
}
////= lines-15	Lab	Kelvin	room	"lab"
function fahrenheits(t, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += t.fahrenheit; return sum; }
function labels(t, turns) { let text = ""; for (let i = 0; i < turns; i++) text = t.label; return text; }
function onlys(t, turns) { let seen; for (let i = 0; i < turns; i++) seen = t.only; return seen; }
const asked = () => count("operationAOTGetByIdAndCache");
const receivers = [new Temperature(), new Kelvin(), new Lab()];
let most = 0;
const results = [];
////= for-7	fahrenheits, labels, only
console.log(results.join());
console.log(most <= 3 ? "no getter was asked of the run time more than three times" : "the run time was asked " + most + " times for one getter of one class");
const [plain, kelvin, lab] = receivers;
console.log(plain.describe(), "|", kelvin.describe(), "|", lab.describe(), "|", lab.base);
for (let i = 0; i < 20; i++) plain.fahrenheit = 212;
for (let i = 0; i < 20; i++) lab.only = 5;
console.log(plain.celsius, lab.celsius, labels(plain, 5), labels(lab, 5), fahrenheits(lab, 2));
let failures = "";
for (let i = 0; i < 8; i++) failures = attempt(() => kelvin.failing);
console.log(failures);

// A getter is redefined, shadowed, deleted, and made a value.
Object.defineProperty(Kelvin.prototype, "label", { get() { return "about " + (this.celsius + 273); }, configurable: true });
console.log(labels(plain.reset(), 5), labels(kelvin, 5), labels(lab.reset(), 5));
Object.defineProperty(Lab.prototype, "label", { value: "a value", writable: true, configurable: true });
console.log(labels(plain, 5), labels(kelvin, 5), labels(lab, 5));
delete Lab.prototype.label;
delete Kelvin.prototype.label;
console.log(labels(plain, 5), labels(kelvin, 5), labels(lab, 5));
Object.defineProperty(lab, "label", { get() { return "its own"; }, configurable: true });
console.log(labels(lab, 5), labels(new Lab(), 5));
delete Temperature.prototype.label;
console.log(labels(plain, 5), labels(new Lab(), 5), attempt(() => plain.describe()));
console.log(Object.getOwnPropertyNames(Temperature.prototype).join(), typeof Object.getOwnPropertyDescriptor(Temperature.prototype, "fahrenheit").set, fahrenheits(plain, 3), onlys(kelvin, 3));
if (typeof gc === "function") gc(); else if (typeof Bun !== "undefined") Bun.gc(true);
console.log(fahrenheits(new Lab(), 100), onlys(new Temperature(), 3));
//// class-caches-hold-after-prototype-created.js
// What compiled code has learnt about the members of a class while its prototype was unmade goes on holding when something makes the prototype make its members: nothing is asked of the run time again. And from then on the members are read where they now lie.
// Only the jsc shell can count. Elsewhere the program checks the answers alone.
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;
const asked = () => count("operationAOTGetByIdAndCache");
class Gauge {
  level = 1;
  read() { return this.level; }
  reset() { this.level = 0; return this; }
  label() { return "gauge"; }
  get double() { return this.level * 2; }
}
class Meter extends Gauge { unit = "m"; label() { return "meter in " + this.unit; } }
function reads(o, turns) { let s = 0; for (let i = 0; i < turns; i++) s += o.read(); return s; }
function labels(o, turns) { let s = ""; for (let i = 0; i < turns; i++) s = o.label(); return s; }
function doubles(o, turns) { let s = 0; for (let i = 0; i < turns; i++) s += o.double; return s; }
function makers(o, turns) { let s; for (let i = 0; i < turns; i++) s = o.constructor; return s === Gauge ? "Gauge" : s === Meter ? "Meter" : "another"; }
const gauge = new Gauge(), meter = new Meter();
const all = () => [reads(gauge, 50), reads(meter, 50), labels(gauge, 50), labels(meter, 50), doubles(gauge, 50), doubles(meter, 50), makers(gauge, 50), makers(meter, 50)].join();
console.log(all());
const names = [Object.getOwnPropertyNames(Gauge.prototype).join(), Object.getOwnPropertyNames(Meter.prototype).join()];
const before = asked();
console.log(all());
const after = asked();
console.log(names.join(" | "));
console.log(after === before ? "nothing was asked again" : (after - before) + " names were asked again");

// They are read where they lie now.
Gauge.prototype.read = function () { return 100; };
Meter.prototype.label = () => "another label";
console.log(all());
Object.defineProperty(Gauge.prototype, "double", { get() { return -1; } });
Meter.prototype.constructor = Gauge;
console.log(all());
delete Meter.prototype.label;
delete Gauge.prototype.read;
console.log(labels(meter, 50), typeof gauge.read, typeof meter.read);
//// class-member-materializing-read-stays-fast.js
// The prototype of a class makes its members once they have been asked for often enough. The method whose read makes them is read like every other inherited value from then on.
// Only the jsc shell can count. Elsewhere the program checks the answers alone.
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;
class Counter {
  n = 0;
  add(k) { this.n += k; return this; }
  get twice() { return this.n * 2; }
  reset() { this.n = 0; return this; }
  name() { return "counter"; }
  toJSON() { return { n: this.n }; }
}
class Stepper extends Counter {
  step = 3;
  advance() { return this.add(this.step); }
}
function addMany(counter, turns) { for (let i = 0; i < turns; i++) counter.add(1); return counter.n; }
function advanceMany(stepper, turns) { for (let i = 0; i < turns; i++) stepper.advance(); return stepper.n; }
function readTwice(counter, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += counter.twice; return sum; }
const asked = () => count("operationAOTGetById") + count("operationAOTGetByIdAndCache");
const before = asked();
const counter = new Counter();
const stepper = new Stepper();
console.log(addMany(counter, 1000), advanceMany(stepper, 1000), addMany(stepper, 1000), readTwice(counter, 1000), readTwice(stepper, 1000));
const entered = asked() - before;
console.log(entered <= 100 ? "the run time was asked for a member at most 100 times" : "the run time was asked for a member " + entered + " times");

// What was learnt ends when it should.
Counter.prototype.add = function (k) { this.n += 2 * k; return this; };
console.log(addMany(counter.reset(), 10), advanceMany(stepper.reset(), 10));
Stepper.prototype.add = function (k) { this.n -= k; return this; };
console.log(addMany(counter.reset(), 10), advanceMany(stepper.reset(), 10), addMany(stepper.reset(), 10));
delete Stepper.prototype.add;
console.log(advanceMany(stepper.reset(), 10));
Object.defineProperty(Counter.prototype, "twice", { get() { return this.n * 3; }, configurable: true });
console.log(readTwice(counter.reset().add(1), 10), readTwice(stepper.reset().add(1), 10));
counter.add = function (k) { this.n += 100 * k; return this; };
console.log(addMany(counter.reset(), 10), Object.keys(counter).join(), JSON.stringify(counter), counter.name());
Object.setPrototypeOf(Stepper.prototype, { add(k) { this.n += 7 * k; return this; }, reset() { this.n = 0; return this; } });
console.log(advanceMany(stepper.reset(), 10), stepper.twice, typeof stepper.name);
delete Counter.prototype.add;
try { addMany(new Counter(), 1); } catch (error) { console.log(error.constructor.name); }
//// class-methods-resolved-once.js
// A method of a class that is called by name is asked of the run time once for each shape of receiver, and the prototype need not make its members for that. What was learnt ends when the prototype changes.
// Only the jsc shell can count. Elsewhere the program checks the answers alone.
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;
const attempt = f => { try { return f(); } catch (error) { return error.constructor.name; } };
class Shape {
  sides = 0;
  area() { return 0; }
  name() { return "shape"; }
  describe() { return this.name() + " of " + this.sides + " sides and area " + this.area(); }
  scale(k) { return this; }
  get kind() { return "a " + this.name(); }
  toJSON() { return { sides: this.sides }; }
}
class Square extends Shape {
  sides = 4;
  side = 2;
  area() { return this.side * this.side; }
  name() { return "square"; }
  scale(k) { this.side *= k; return this; }
}
class Tile extends Square {
  color = "red";
  paint(color) { this.color = color; return this; }
}
function areas(shape, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += shape.area(); return sum; }
function names(shape, turns) { let text = ""; for (let i = 0; i < turns; i++) text = shape.name(); return text; }
function describes(shape, turns) { let text = ""; for (let i = 0; i < turns; i++) text = shape.describe(); return text; }
const all = () => [new Shape(), new Square(), new Tile()];
const asked = () => count("operationAOTGetByIdAndCache");
const [shape, square, tile] = all();
let most = 0;
const results = [];
for (const call of [areas, names]) {
  for (const receiver of [shape, square, tile]) {
    const before = asked();
    results.push(call(receiver, 500));
    most = Math.max(most, asked() - before);
  }
}
console.log(results.join());
console.log(most <= 3 ? "no method was asked of the run time more than three times" : "the run time was asked " + most + " times for one method of one class");
console.log(describes(shape, 50), "|", describes(square, 50), "|", describes(tile, 50));
console.log(shape.area === Shape.prototype.area, square.area === Square.prototype.area, tile.area === square.area, tile.describe === shape.describe, square.area !== shape.area);

// A method is replaced, shadowed, deleted and redefined.
Square.prototype.area = function () { return -1; };
console.log(areas(shape, 5), areas(square, 5), areas(tile, 5));
Tile.prototype.area = function () { return 7; };
console.log(areas(shape, 5), areas(square, 5), areas(tile, 5));
delete Tile.prototype.area;
delete Square.prototype.area;
console.log(areas(shape, 5), areas(square, 5), areas(tile, 5));
Object.defineProperty(Shape.prototype, "area", { get() { return () => this.sides; }, configurable: true });
console.log(areas(shape, 5), areas(square, 5), areas(tile, 5));
delete Shape.prototype.area;
console.log(attempt(() => areas(shape, 1)), attempt(() => areas(tile, 1)));

// One object gets a property of its own. The others go on as before.
class Meter { value = 1; read() { return this.value; } twice() { return 2 * this.read(); } }
function reads(meter, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += meter.read(); return sum; }
const first = new Meter();
const second = new Meter();
console.log(reads(first, 100), reads(second, 100));
first.read = () => 10;
console.log(reads(first, 100), reads(second, 100), first.twice(), second.twice());
delete first.read;
console.log(reads(first, 100), Object.keys(first).join());

// Two classes have a method of one name. What happens to one leaves the other alone.
class Left { go() { return "left"; } stay() { return "stays left"; } }
class Right { go() { return "right"; } stay() { return "stays right"; } }
function goes(walker, turns) { let text = ""; for (let i = 0; i < turns; i++) text = walker.go(); return text; }
const left = new Left();
const right = new Right();
console.log(goes(left, 100), goes(right, 100));
console.log(Object.getOwnPropertyNames(Left.prototype).join(), goes(left, 100), goes(right, 100));
Left.prototype.go = () => "left again";
console.log(goes(left, 100), goes(right, 100));
Right.prototype.go = () => "right again";
console.log(goes(left, 100), goes(right, 100), left.stay(), right.stay());

// The chain changes above and between.
class Base { who() { return "base"; } }
class Middle extends Base { }
class Leaf extends Middle { }
function whos(object, turns) { let text = ""; for (let i = 0; i < turns; i++) text = object.who(); return text; }
const leaf = new Leaf();
console.log(whos(leaf, 100));
Middle.prototype.who = function () { return "middle"; };
console.log(whos(leaf, 100), whos(new Base(), 100));
Object.setPrototypeOf(Leaf.prototype, { who() { return "stranger"; } });
console.log(whos(leaf, 100), leaf instanceof Middle);
Object.setPrototypeOf(leaf, Base.prototype);
console.log(whos(leaf, 100), leaf instanceof Base);
class Sealed { only() { return "only"; } }
function onlys(object, turns) { let text = ""; for (let i = 0; i < turns; i++) text = object.only(); return text; }
const sealed = new Sealed();
console.log(onlys(sealed, 100));
Object.freeze(Sealed.prototype);
console.log(attempt(() => { "use strict"; Sealed.prototype.only = 1; }), onlys(sealed, 100), attempt(() => { sealed.only = () => "own"; return onlys(sealed, 3); }));

// Objects of many shapes of one class.
class Bag { size() { return Object.keys(this).length; } }
function sizes(bag, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += bag.size(); return sum; }
let total = 0;
for (let i = 0; i < 40; i++) { const bag = new Bag(); for (let j = 0; j <= i % 8; j++) bag["k" + j] = j; total += sizes(bag, 10); }
console.log(total);
if (typeof gc === "function") gc(); else if (typeof Bun !== "undefined") Bun.gc(true);
console.log(names(new Tile(), 100), goes(new Right(), 100), whos(new Leaf(), 100), reads(new Meter(), 100));
//// closure-on-object-variable-rebound.js
// `h.f = () => h`-style stores where the variable holding the object is rebound by a loop, a conditional, a labelled `continue` or a `switch`.
function row(name, f) { try { console.log(name + ": " + f()); } catch (e) { console.log(name + ": threw " + e.name); } }
const who = (...os) => os.map(o => o === null || o === undefined ? "nil" : typeof o.f === "function" ? "f->" + (o.f().n) : "none").join(" ");
row("the hunt's while with a comma", () => { const a = { n: "a" }, b = { n: "b" }; let h = a, g = () => a; while ((h.f = g, h != b)) { const k = h; h = b; g = () => k; } return who(a, b); });
row("for, the holder steps", () => { const os = [{ n: 0 }, { n: 1 }, { n: 2 }]; let g = null; for (let i = 0, h = os[0]; i < 3; h = os[++i]) { if (g) h.f = g; const k = h; g = () => k; } return who(...os); });
row("do while", () => { const a = { n: "a" }, b = { n: "b" }; let h = a, g = () => a, t = 0; do { h.f = g; const k = h; h = b; g = () => k; } while (++t < 2); return who(a, b); });
row("a conditional holder", () => { const a = { n: "a" }, b = { n: "b" }; const f = c => { let h = a; const k = h, g = () => k; if (c) h = b; h.f = g; return who(a, b); }; const r = f(true); delete a.f; delete b.f; return r + " | " + f(false); });
row("a ternary holder", () => { const a = { n: "a" }, b = { n: "b" }; const f = c => { const k = a, g = () => k; (c ? b : a).f = g; return who(a, b); }; const r = f(true); delete a.f; delete b.f; return r + " | " + f(false); });
row("a labelled continue", () => { const os = [{ n: 0 }, { n: 1 }, { n: 2 }]; let h = os[0], g = () => os[0], i = 0; outer: while (i < 3) { h.f = g; const k = h; g = () => k; h = os[++i]; if (i < 3) continue outer; break; } return who(...os); });
row("a switch that falls through", () => { const a = { n: "a" }, b = { n: "b" }; let h = a, g; switch (1) { case 1: { const k = h; g = () => k; h = b; } case 2: h.f = g; } return who(a, b); });
row("try and finally", () => { const a = { n: "a" }, b = { n: "b" }; let h = a, g; try { const k = h; g = () => k; h = b; } finally { h.f = g; } return who(a, b); });
row("a throw caught", () => { const a = { n: "a" }, b = { n: "b" }; let h = a, g; try { const k = h; g = () => k; h = b; throw 1; } catch (e) { h.f = g; } return who(a, b); });
row("the holder becomes null: the TypeError is kept", () => { const a = { n: "a" }; let h = a, g, t = 0; while (t++ < 2) { if (g) h.f = g; const k = h; g = () => k; h = null; } return "no throw"; });
row("the holder becomes a number", () => { const a = { n: "a" }; let h = a, g, t = 0; while (t++ < 2) { if (g) h.f = g; const k = h; g = () => k; h = 5; } return who(a); });
row("the holder is frozen in between", () => { "use strict"; const a = { n: "a" }, b = Object.freeze({ n: "b" }); let h = a, g = () => a, t = 0; while (t++ < 2) { h.f = g; const k = h; g = () => k; h = b; } return who(a, b); });
row("the holder has a setter", () => { const log = []; const a = { n: "a" }, b = { n: "b", set f(v) { log.push("set " + v().n); } }; let h = a, g = () => a, t = 0; while (t++ < 2) { h.f = g; const k = h; g = () => k; h = b; } return who(a) + " " + log.join(); });
row("one function, stored twice", () => { const a = { n: "a" }, b = { n: "b" }; let h = a, g = null, t = 0; while (t++ < 3) { if (g) { h.f = g; h.e = g; } const k = a; if (!g) g = () => k; h = t === 1 ? a : b; } return (a.f === a.e) + " " + (a.f === b.f) + " " + who(a, b); });
row("identity over the turns", () => { const os = [{ n: 0 }, { n: 1 }, { n: 2 }]; const made = []; let h = os[0], g = null; for (let i = 0; i < 3; i++) { if (g) h.f = g; const k = h; g = () => k; made.push(g); h = os[i + 1] || os[0]; } return [os[1].f === made[0], os[2].f === made[1], os[0].f === undefined, who(...os)].join(" "); });
row("the first form stays: o.f = () => o", () => { const o = { n: "o" }; o.f = () => o; const p = { n: "p" }; p.f = () => p; return who(o, p) + " " + (o.f() === o) + " " + (o.f === o.f); });
row("the first form in a loop", () => { const os = []; for (let i = 0; i < 3; i++) { const o = { n: i }; o.f = () => o; os.push(o); } return who(...os) + " " + (os[0].f !== os[1].f); });
row("the first form, read behind a jump", () => { const o = { n: "o" }; o.f = () => o; let r = ""; for (let i = 0; i < 2; i++) r += o.f().n + (o.f === o.f); return r; });
row("two captures: no lazy closure", () => { const a = { n: "a" }, b = { n: "b" }; let h = a, g = () => a, t = 0; while (t++ < 2) { h.f = g; const k = h, j = t; g = () => ({ n: k.n + j }); h = b; } return who(a, b); });
row("hot", () => { let s = ""; for (let q = 0; q < 300; q++) { const a = { n: "a" }, b = { n: "b" }; let h = a, g = () => a; while ((h.f = g, h != b)) { const k = h; h = b; g = () => k; } s = who(a, b); } return s; });
//// closure-type-in-jsdoc-typedef.js
// A JSDoc comment that TypeScript cannot parse (Closure's `function(): T` in a @typedef, as in webpack's sources) is a comment: the file is valid JavaScript and is built.
/** @template T @typedef {function(): T} FunctionReturning */
/** @typedef {function(string, number=): void} Callback */
/**
 * @template T
 * @param {FunctionReturning<T>} fn memorized function
 * @returns {FunctionReturning<T>} new function
 */
const memoize = fn => {
  let cache = false;
  /** @type {T | undefined} */
  let result = undefined;
  return () => {
    if (cache) return /** @type {T} */ (result);
    result = fn();
    cache = true;
    fn = undefined;
    return /** @type {T} */ (result);
  };
};
let calls = 0;
const five = memoize(() => (calls++, 5));
console.log(five(), five(), calls);
//// closures-capture-their-holder-typed.ts
// An object built by untyped code, with closures that capture only that object, is used through declared types.
interface Api { a: number; plus: (x: number) => number; self: () => unknown }
interface Loose { a: number; [key: string]: unknown }
const lines: string[] = [];
const show = (title: string, f: () => unknown) => { let text: string; try { text = String(f()); } catch (e: any) { text = "throws " + e.constructor.name; } lines.push(title + ": " + text); };
const make = (a: number): any => { const o: any = { a }; o.plus = (x: number) => o.a + x; o.self = () => o; return o; };
const use = (api: Api, x: number): number => api.plus(x) + api.a;
const keys = (o: Loose): string => Object.keys(o).join();
function run() {
    show("as a parameter", () => use(make(1), 2));
    show("as a variable", () => { const api: Api = make(3); return api.plus(4) + " " + (api.plus === api.plus); });
    show("asserted", () => { const o = make(5); const api = o as Api; return [api.plus(1), api.self() === o || api.self() === api, typeof api.plus].join(); });
    show("in an array", () => { const all: Api[] = [make(1), make(2), make(3)]; let sum = 0; for (const api of all) sum += api.plus(1); return sum; });
    show("loose", () => keys(make(6)));
    show("many", () => { let sum = 0; for (let i = 0; i < 500; i++) sum += use(make(i), 1); return sum; });
    show("the same function behind the type", () => { const o = make(7); const f = o.plus; const api: Api = o; return api.plus(1) === f(1); });
    show("read first", () => { const o = make(8); o.plus(1); const api: Api = o; return api.plus(2); });
}
run();
console.log(lines.join("\n"));
//// collection-methods-unknown-receivers.js
// x.get(k), x.has(k), x.set(k, v), x.add(k) where nothing says what x is: a Map, a Set, a WeakMap, a WeakSet, an heir of one, one with a method of its own or another prototype, a frozen one,
// and objects of the program's own that have methods of these names. Keys: objects, symbols, primitives; there, not there, deleted, put back; enough of them that the tables grow.
const lines = [];
function get(x, k) { return x.get(k); }
function has(x, k) { return x.has(k); }
function set(x, k, v) { return x.set(k, v); }
function add(x, k) { return x.add(k); }
function attempt(f, ...rest) { try { return show(f(...rest)); } catch (error) { return error.constructor.name; } }
const names = new Map;
function show(v) {
    if (names.has(v)) return names.get(v);
    if (typeof v === "symbol") return v.toString();
    if (typeof v === "function") return "a function";
    if (typeof v === "object" && v) return "{" + Object.keys(v).join() + "}";
    return String(v);
}
const a = { a: 1 }, b = { b: 1 }, c = function () {}, lone = Symbol("lone"), registered = Symbol.for("registered");
class OwnTable { constructor() { this.held = []; } get(k) { return "own get " + show(k); } has(k) { return this.held.includes(k); } set(k, v) { this.held.push(k); return v; } add(k) { this.held.push(k); return this.held.length; } }
class HeirOfWeakMap extends WeakMap { get(k) { return "heir: " + show(super.get(k)); } }
class PlainHeirOfWeakMap extends WeakMap {}
class HeirOfMap extends Map {}
const withOwnMethod = new WeakMap; withOwnMethod.get = function (k) { return "own property"; };
const withOtherPrototype = Object.setPrototypeOf(new WeakMap, { get() { return "other prototype"; }, has() { return "other has"; }, set() { return "other set"; } });
const withNoPrototype = Object.setPrototypeOf(new WeakMap, null);
const frozen = Object.freeze(new WeakMap);
const tables = { map: new Map, set: new Set, weakMap: new WeakMap, weakSet: new WeakSet, own: new OwnTable, heir: new HeirOfWeakMap, plainHeir: new PlainHeirOfWeakMap, heirOfMap: new HeirOfMap,
    withOwnMethod, withOtherPrototype, withNoPrototype, frozen, plain: {}, array: [], text: "text", number: 5, nothing: undefined };
for (const [name, table] of Object.entries(tables)) if (typeof table === "object" && table) names.set(table, "<" + name + ">");
const keys = [a, b, c, lone, registered, "a", 1, 1.5, NaN, -0, null, undefined, true, 10n];
for (const [name, table] of Object.entries(tables)) {
    const row = [name];
    for (let round = 0; round < 2; round++) {
        for (const k of keys) row.push(attempt(get, table, k) + "/" + attempt(has, table, k));
        for (const k of keys) row.push(attempt(set, table, k, round + ":" + show(k)) + "/" + attempt(add, table, k));
    }
    for (const k of keys) row.push(attempt(get, table, k) + "/" + attempt(has, table, k));
    lines.push(row.join(" "));
}
const weak = new WeakMap, weakSet = new WeakSet, strong = new Map, many = [];
for (let i = 0; i < 3000; i++) many.push({ i });
let sum = 0;
for (let i = 0; i < many.length; i++) { if (set(weak, many[i], i) !== weak || add(weakSet, many[i]) !== weakSet || set(strong, many[i], -i) !== strong) sum += 1e9; }
for (let i = 0; i < many.length; i += 3) { weak.delete(many[i]); weakSet.delete(many[i]); strong.delete(many[i]); }
for (let i = 0; i < many.length; i++) sum += (get(weak, many[i]) ?? 7) + (has(weak, many[i]) ? 1 : 0) + (has(weakSet, many[i]) ? 2 : 0) + (get(strong, many[i]) ?? 11) + (has(strong, many[i]) ? 4 : 0);
for (let i = 0; i < many.length; i += 6) { set(weak, many[i], "back"); add(weakSet, many[i]); }
let back = 0;
for (let i = 0; i < many.length; i++) back += (get(weak, many[i]) === "back" ? 1 : 0) + (has(weakSet, many[i]) ? 1 : 0);
lines.push(sum + " " + back);
for (let round = 0; round < 40; round++) { const young = []; for (let i = 0; i < 200; i++) { const o = { round, i }; young.push(o); set(weak, o, o); } for (const o of young) if (get(weak, o) !== o) sum = -1; }
lines.push(String(sum), String(get(weak, many[1])), String(get(weak, {})), String(has(weakSet, {})));
console.log(lines.join("\n"));
