for (let round = 0; round < 3; round++) {
    const rows = values.map(value => indexes.map(index => show(at(value, index))).join(" ") + " | " + indexes.slice(0, 20).map(index => show(atWhole(value, index))).join(" ") + " | " + show(first(value)) + " " + show(third(value)));
    if (round === 2)
        lines.push(...rows);
