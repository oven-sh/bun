//// constructor-function-imported-by-typed-code/main.ts
// A typed module imports untyped JavaScript that builds objects with a constructor function and reads their fields.
import "./impl.js";
//// constructor-property-resolved-once.js
// `object.constructor` is asked of the run time once for each shape of receiver, and the prototype of the class need not make its members for that. What was learnt ends when the property is replaced.
// Only the jsc shell can count. Elsewhere the program checks the answers alone.
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;
class Animal { legs = 4; speak() { return "..."; } walk() { return this.legs; } sleep() { return "zzz"; } eat() { return "yum"; } }
class Dog extends Animal { name = "rex"; speak() { return "woof"; } }
class Puppy extends Dog { age = 1; }
function makers(value, turns) { let maker; for (let i = 0; i < turns; i++) maker = value.constructor; return maker; }
function kinds(value, turns) { let text = ""; for (let i = 0; i < turns; i++) text = value.constructor.name; return text; }
function copies(value, turns) { let copy; for (let i = 0; i < turns; i++) copy = new value.constructor(); return copy; }
const asked = () => count("operationAOTGetByIdAndCache");
const receivers = [new Animal(), new Dog(), new Puppy()];
let most = 0;
const results = [];
for (const receiver of receivers) {
  const before = asked();
  results.push(makers(receiver, 500).name);
  most = Math.max(most, asked() - before);
}
console.log(results.join());
console.log(most <= 3 ? "the constructor was not asked of the run time more than three times" : "the run time was asked " + most + " times for the constructor of one class");
const [animal, dog, puppy] = receivers;
console.log(makers(animal, 5) === Animal, makers(dog, 5) === Dog, makers(puppy, 5) === Puppy, kinds(puppy, 5), copies(puppy, 5) instanceof Puppy, copies(dog, 5).speak());
console.log(Object.getOwnPropertyDescriptor(Dog.prototype, "constructor").enumerable, Object.keys(dog).join(), makers(dog, 5) === Dog);
Puppy.prototype.constructor = Animal;
console.log(kinds(animal, 5), kinds(dog, 5), kinds(puppy, 5), copies(puppy, 5) instanceof Puppy);
delete Puppy.prototype.constructor;
console.log(kinds(puppy, 5));
delete Dog.prototype.constructor;
console.log(kinds(dog, 5), kinds(puppy, 5));
puppy.constructor = Dog;
console.log(kinds(puppy, 5), kinds(new Puppy(), 5));
class Odd { ["constructor"]() { return "a method"; } other() { return 1; } }
function calls(value, turns) { let text = ""; for (let i = 0; i < turns; i++) text = value.constructor(); return text; }
console.log(calls(new Odd(), 100), new Odd().other());
if (typeof gc === "function") gc(); else if (typeof Bun !== "undefined") Bun.gc(true);
console.log(kinds(new Animal(), 100), kinds(new Dog(), 100));
//// constructor-stores-meet-subclass-setters.js
// A constructor fills `this` one store after the other, and a class that inherits from it has setters for some of the names, as Node's ServerResponse has for three names that OutgoingMessage stores to.
// What the objects have, in which order things happen, and that the stores on either side of a setter are still learnt together. Only the jsc shell can count. Elsewhere the program checks the answers alone.
const counts = typeof aotOperationCount === "function";
const count = counts ? aotOperationCount : () => 0;
const log = [];
function note(text, object) { if (log.length < 12) log.push(text + " behind " + Object.keys(object).join()); }
function heirsInheritFrom(constructor) { return Object.getPrototypeOf(Object.create(constructor.prototype)); }
function describe(object) { return Object.keys(object).map(key => key + "=" + JSON.stringify(object[key])).join() + " | " + object.writable + " " + object.keepAlive; }

function Message(options) {
  this.outputData = [];
  this.outputSize = 0;
  this.first = 1;
  this.writable = true;
  this.destroyed = false;
  this.last = false;
  this.sendDate = false;
  this.keepAlive = options;
  this.contentLength = null;
  this.hasBody = true;
  this.trailer = "";
  this.finished = false;
  this.header = null;
}
function Response(options) { Message.call(this, options); }
Object.setPrototypeOf(Response.prototype, Message.prototype);
Object.defineProperty(heirsInheritFrom(Response), "writable", { get() { return "always"; }, set(value) { note("writable " + value, this); } });
Object.defineProperty(heirsInheritFrom(Response), "keepAlive", { get() { return this.kept; }, set(value) { this.kept = value; } });
function Request(options) { Message.call(this, options); }
Object.setPrototypeOf(Request.prototype, Message.prototype);

// The same, but nothing in the text says which names have setters.
function Hidden(options) {
  this.outputData = [];
  this.outputSize = 0;
  this.first = 1;
  this.secret = true;
  this.destroyed = false;
  this.last = false;
  this.sendDate = false;
  this.contentLength = null;
}
Object.defineProperty(heirsInheritFrom(Hidden), ["sec", "ret"].join(""), { get() { return "hidden"; }, set(value) { note("secret " + value, this); } });

////= asked	make(i
const withNames = asked(i => describe(new Response(i & 1)));
const withoutNames = asked(i => Object.keys(new Hidden()).join() + " " + new Hidden().secret);
console.log(!counts || withNames !== withoutNames ? "the stores on either side of a setter were learnt together" : "the run time was asked " + withNames + " times, and " + withoutNames + " times where no name is known");
console.log(log.splice(0, 2).join("\n"));
log.length = 0;
asked(i => describe(new Request(i & 1)));
asked(i => describe(new Response("again")) + " / " + describe(new Request("again")));
console.log(log.length);
log.length = 0;

// Accessors of a class, of an object literal, of Object.defineProperties, of Object.create.
class Heir extends Message {
  get destroyed() { return "by class"; }
  set destroyed(value) { note("destroyed " + value, this); }
}
console.log(describe(new Heir(1)), new Heir(2).destroyed);
function Literal(options) { Message.call(this, options); }
Literal.prototype = { __proto__: Message.prototype, get last() { return "by literal"; }, set last(value) { note("last " + value, this); } };
console.log(describe(new Literal(1)), new Literal(2).last);
function Several(options) { Message.call(this, options); }
Several.prototype = Object.create(Message.prototype, { sendDate: { get() { return "by create"; }, set(value) { note("sendDate " + value, this); } } });
Object.defineProperties(heirsInheritFrom(Several), { hasBody: { value: "fixed", writable: false }, trailer: { set(value) { note("trailer " + JSON.stringify(value), this); } } });
////= lines-27	Several(1	constructor.nam
console.log(log.splice(0).join("\n"));

// A setter that changes the object under the stores that follow.
function Changes(options) { Message.call(this, options); }
Object.setPrototypeOf(Changes.prototype, Message.prototype);
Object.defineProperty(heirsInheritFrom(Changes), "writable", { set(value) { this.contentLength = "early"; this.extra = 1; delete this.first; } });
for (let i = 0; i < 40; i++) new Changes(i);
console.log(describe(new Changes(0)));
function Throws(options) { Message.call(this, options); }
Object.setPrototypeOf(Throws.prototype, Message.prototype);
Object.defineProperty(heirsInheritFrom(Throws), "keepAlive", { set(value) { Throws.seen = Object.keys(this).join(); throw new RangeError("from the setter"); } });
try {
  new Throws(1);
} catch (error) {
