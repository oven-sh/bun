//// collections-made-of-anything-and-never-used.js
// A Map, Set, WeakMap or WeakSet is made of something and never used. Where that something cannot be iterated, or hands out what the collection does not take, the TypeError is owed all the same.
{ function scene(i) { ({ made() { new Map(i); } }).made(); } let answer = "no error"; try { scene(7); } catch (error) { answer = error.name; } console.log("new Map(7) in the method of a literal:", answer); }
