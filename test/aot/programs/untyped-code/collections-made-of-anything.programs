    for (const index of [0, 1.5, "a"]) {
        try { lines.push(show(at(nothing, index))); } catch (error) { lines.push(error.constructor.name); }
        try { lines.push(show(atWhole(nothing, index))); } catch (error) { lines.push(error.constructor.name); }
