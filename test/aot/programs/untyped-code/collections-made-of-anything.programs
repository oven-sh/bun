// An object with constant property additions and deletions (dictionary mode) behaves like any other object, whatever was cached in between.
const lines = [];
const say = (...parts) => lines.push(parts.join(" "));
const store = (object, value) => {
  object.count = value;
};
const read = object => object.count;
const readMissing = object => object.missing;
const has = object => "count" in object;
const storeByKey = (object, key, value) => {
  object[key] = value;
};
const readByKey = (object, key) => object[key];
const callIt = object => object.act();
const attempt = action => {
  try {
    return action();
  } catch (error) {
    return error.constructor.name;
  }
};
const use = (object, from, to) => {
  for (let i = from; i < to; i++) object["k" + i] = i;
  for (let i = from; i < to - 10; i++) delete object["k" + i];
};

const registry = { count: 0, act: () => 1 };
let sum = 0;
for (let round = 0; round < 6; round++) {
  use(registry, round * 100, round * 100 + 200);
  for (let i = 0; i < 300; i++) {
    store(registry, i + round);
    sum += read(registry) + callIt(registry) + (has(registry) ? 1 : 0) + (readMissing(registry) === undefined ? 1 : 0);
    storeByKey(registry, i & 1 ? "count" : "other", i);
    sum += readByKey(registry, "count") + readByKey(registry, "other");
  }
  say("round", round, sum, Object.keys(registry).length);
}
delete registry.count;
say("deleted", read(registry), has(registry), readByKey(registry, "count"));
store(registry, 5);
say("stored again", read(registry), has(registry), Object.keys(registry).at(-1));
let seen = 0;
Object.defineProperty(registry, "count", {
  get() {
    return 7;
  },
  set(value) {
    seen = value;
  },
  configurable: true,
});
store(registry, 8);
storeByKey(registry, "count", 9);
say("an accessor", read(registry), readByKey(registry, "count"), seen);
Object.defineProperty(registry, "count", { value: 1, writable: false, configurable: true });
say("read-only", attempt(() => store(registry, 2)), attempt(() => storeByKey(registry, "count", 3)), read(registry));
Object.defineProperty(registry, "count", { value: 4, writable: true });
const heir = Object.create(registry);
store(registry, 6);
say("an heir", read(heir), has(heir), callIt(heir), readMissing(heir));
store(heir, 10);
say("shadowed", read(heir), read(registry));
use(registry, 1000, 1200);
store(registry, 11);
delete heir.count;
say("used again", read(heir), read(registry), Object.keys(registry).length);
Object.setPrototypeOf(registry, { missing: "found" });
say("another prototype", readMissing(registry), readMissing(heir));
Object.freeze(registry);
say("frozen", attempt(() => store(registry, 12)), read(registry), attempt(() => storeByKey(registry, "fresh", 1)));
console.log(lines.join("\n"));
//// dictionary-objects-read-and-stored-by-key.js
// Objects with more names than a chain of shapes holds, read, stored and tested by computed keys while their properties are added, deleted and redefined.
function fill(count, step) {
  var table = {};
  for (var i = 0; i < count; i++) table["k" + ((i * step) % count)] = i;
  return table;
}

function sum(table, names) {
  var total = 0;
  for (var i = 0; i < names.length; i++) {
    var value = table[names[i]];
    total += value === undefined ? -1000 : value;
  }
  return total;
}

function bump(table, names, by) {
  for (var i = 0; i < names.length; i++) table[names[i]] = table[names[i]] + by;
}

function present(table, names) {
  var own = 0;
  var found = 0;
  for (var i = 0; i < names.length; i++) {
    if (Object.prototype.hasOwnProperty.call(table, names[i])) own++;
    if (names[i] in table) found++;
  }
  return own + ":" + found;
}

function strictStore(table, name, value) {
  try {
    table[name] = value;
    return "stored";
  } catch (error) {
    return error instanceof TypeError ? "TypeError" : "other";
  }
}

var names = [];
for (var n = 0; n < 120; n++) names.push("k" + n);

var first = fill(120, 1);
var second = fill(120, 7);
for (var round = 0; round < 3; round++) console.log(sum(first, names), sum(second, names), present(first, names));
bump(first, names, 2);
bump(second, names, 3);
console.log(sum(first, names), sum(second, names));

console.log(first["later"], "later" in first, present(first, ["later"]));
first["later"] = 5;
console.log(first["later"], "later" in first, present(first, ["later"]));

var parent = { inherited: 11 };
var child = Object.create(parent);
for (var c = 0; c < 100; c++) child["c" + c] = c;
var inheritedName = ["inherited"];
console.log(sum(child, inheritedName), present(child, inheritedName));
console.log(sum(child, inheritedName), present(child, inheritedName));
child["inherited"] = 12;
console.log(sum(child, inheritedName), present(child, inheritedName), parent.inherited);
parent.inherited = 13;
console.log(sum(child, inheritedName));

delete first["k10"];
console.log(sum(first, names), present(first, names), first["k10"], first["k11"], first["k119"]);
first["k10"] = 77;
console.log(sum(first, names), present(first, names), Object.keys(first).slice(-2).join());
bump(first, names, 1);
console.log(sum(first, names));

var reads = 0;
Object.defineProperty(second, "k20", {
  get: function () {
    reads++;
    return 1000;
  },
  set: function (value) {
    reads += value;
  },
  enumerable: true,
  configurable: true,
});
console.log(sum(second, names), reads);
bump(second, names, 1);
console.log(sum(second, names), reads);

Object.defineProperty(second, "k30", { value: 9, writable: false });
console.log(second["k30"], strictStore(second, "k30", 10), strictStore(second, "k30", 11), strictStore(second, "k31", 12), second["k31"]);

var third = fill(90, 1);
console.log(sum(third, names), third.k5, third.k89, third.missing);
console.log(sum(third, names), third.k5, third.k89, third.missing);
third["k95"] = 1;
console.log(sum(third, names), third.k95);
Object.freeze(third);
console.log(sum(third, names), strictStore(third, "k5", 1), strictStore(third, "k97", 1), present(third, names));

var total = 0;
for (var repeat = 0; repeat < 200; repeat++) {
  var scratch = fill(70 + (repeat % 5), 1);
  bump(scratch, names.slice(0, 70), repeat);
  if (repeat % 3 === 0) delete scratch["k" + (repeat % 70)];
  total += sum(scratch, names);
}
console.log(total);
