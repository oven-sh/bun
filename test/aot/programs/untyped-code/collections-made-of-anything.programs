//// container-operations-register-pressure.ts
// Generated: container operations with as many values live across them as there are registers.
declare const console: { log(...values: unknown[]): void };
interface Item { id: number }
const it: Item = { id: 1 }; const text: string = ["te", "xt"].join("");
const hide = (v: unknown): any => v;
function given(xs: number[]): number[] { return hide(xs.slice === undefined ? xs : Object.assign(xs.slice(), hide(xs).extra === undefined ? {} : { extra: 1 })); }
function sum(xs: number[]): number { let s = 0; for (let i = 0; i < xs.length; i++) s += xs[i]!; return s; }
