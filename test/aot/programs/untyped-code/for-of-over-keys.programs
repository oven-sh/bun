//// inherited-setter-stores-add-properties.js
"use strict";
// A store by name finds a setter on the prototype chain, and the setter gives the receiver a new property.
// Constructor functions in the style of node:http do this for every object they make.
const kChunked = Symbol("chunked");
const log = [];

function Message() {
  this.size = 0;
  this.chunked = false;
  this.keepAlive = true;
  this.finished = false;
}
Object.defineProperty(Message.prototype, "chunked", {
  get() { return this[kChunked]; },
  set(value) { this[kChunked] = value; },
  configurable: true,
});
Object.defineProperty(Message.prototype, "keepAlive", {
  get() { return this._keepAlive; },
  set(value) { this._keepAlive = value; },
  configurable: true,
});

function Response() {
  Message.call(this);
  this.status = 200;
}
Object.setPrototypeOf(Response.prototype, Message.prototype);

////= lines-10	assign	message	socket	message.socket
Object.defineProperty(Response.prototype, "socket", {
  get() { return this._socket; },
  set(value) {
    this._socket = value;
    this.assigned = (this.assigned || 0) + 1;
  },
  configurable: true,
});

function describe(object) {
  return Reflect.ownKeys(object).map(key => String(key) + "=" + String(object[key])).join(",");
}

let seen = new Set();
for (let i = 0; i < 300; i++) {
  const response = new Response();
  assign(response, i & 1 ? "odd" : "even");
  if (i % 50 === 0) assign(response, "again");
  seen.add(describe(response));
}
log.push([...seen].sort().join(" | "));

// The setter is replaced: the next store must call the new one.
Object.defineProperty(Message.prototype, "chunked", {
  get() { return "replaced"; },
  set(value) { this.replacedWith = value; },
  configurable: true,
});
seen = new Set();
for (let i = 0; i < 300; i++) seen.add(describe(new Response()));
log.push([...seen].join(" | "));

// A prototype in between gets a data property of the name: the store now makes an own property.
Object.defineProperty(Response.prototype, "keepAlive", { value: "shadow", writable: true, configurable: true });
seen = new Set();
for (let i = 0; i < 300; i++) seen.add(describe(new Response()));
log.push([...seen].join(" | "));

// The property in between is read-only: the store throws in strict code.
Object.defineProperty(Response.prototype, "keepAlive", { value: "fixed", writable: false, configurable: true });
////= lines
delete Response.prototype.keepAlive;

// The accessor goes away: the store makes an own property.
delete Message.prototype.chunked;
seen = new Set();
for (let i = 0; i < 300; i++) seen.add(describe(new Response()));
log.push([...seen].join(" | "));

// An accessor without a setter: the store throws in strict code.
Object.defineProperty(Message.prototype, "chunked", { get() { return 1; }, configurable: true });
////= lines
delete Message.prototype.chunked;

// A setter that changes the prototype of the receiver, one that throws now and then, and one that stores to the same name on another object.
const other = { __proto__: null };
const plainPrototype = { kind: "plain" };
function Odd(i) {
  this.index = i;
  this.moves = i;
  this.fails = i;
  this.forwards = i;
}
Object.defineProperties(Odd.prototype, {
  moves: { set(value) { this.moved = value; if (value % 7 === 0) Object.setPrototypeOf(this, plainPrototype); }, configurable: true },
  fails: { set(value) { if (value % 11 === 0) throw new RangeError("eleven"); this.passed = value; }, configurable: true },
  forwards: { set(value) { other.forwards = value; this.forwarded = true; }, configurable: true },
});
let digest = 0;
let errors = 0;
for (let i = 1; i <= 500; i++) {
  try {
    const odd = new Odd(i);
    digest = (digest * 31 + Reflect.ownKeys(odd).length * 7 + (Object.getPrototypeOf(odd) === plainPrototype ? 3 : 1) + other.forwards) | 0;
  } catch (error) {
    errors += error instanceof RangeError ? 1 : 1000;
  }
}
log.push(digest + " " + errors);

// Receivers of several shapes at one site, and receivers that already have the property the setter adds.
////= lines-10	mark	object	value	object.mark
const base = { set mark(value) { this.marked = value; } };
let shapes = 0;
for (let i = 0; i < 400; i++) {
  const object = Object.create(base);
  if (i & 1) object.a = 1;
  if (i & 2) object.b = 2;
  if (i & 4) object.marked = "before";
  mark(object, i);
  mark(object, i + 1);
  shapes = (shapes * 17 + Object.keys(object).join("").length + object.marked) | 0;
}
log.push(String(shapes));

// A primitive receiver and a frozen one.
try {
  mark(5, "five");
  log.push("no error");
} catch (error) {
  log.push(error.constructor.name);
}
const frozen = Object.freeze(Object.create(base));
try {
  mark(frozen, 1);
  log.push("no error");
} catch (error) {
  log.push(error.constructor.name);
}

console.log(log.join("\n"));
//// inherited-setters-of-many-classes-stored-in-turn.js
// Setters that hundreds of classes inherit, stored to in turn at one place: every store reaches its setter, also behind changes to the classes.
let log = 0;
class Base {
  #first = 0;
  #second = 0;
  set first(value) {
    this.#first = value;
    log += 1;
  }
  get first() {
    return this.#first;
  }
  set second(value) {
    this.#second = value * 2;
    log += 2;
  }
  get second() {
    return this.#second;
  }
}
function write(object, value) {
  object.first = value;
  object.second = value;
}
for (const shapes of [1, 3, 40, 70, 130, 300, 700, 2500]) {
  const made = [];
  const classes = [];
  for (let i = 0; i < shapes; i++) {
    const heir = class extends Base {};
    classes.push(heir);
    made.push(new heir());
  }
  log = 0;
  for (let round = 0; round < 4; round++) for (let i = 0; i < made.length; i++) write(made[i], round * 1000 + i);
  let sum = 0;
  for (const object of made) sum += object.first + object.second;
  console.log(shapes, "classes:", log, sum);
  let own = 0;
  for (let i = 0; i < shapes; i += 7) Object.defineProperty(classes[i].prototype, "first", { set(value) { own += value; }, configurable: true });
  for (let i = 3; i < shapes; i += 7) Object.defineProperty(made[i], "second", { value: -1, writable: true, configurable: true });
  log = 0;
  for (let round = 0; round < 3; round++) for (let i = 0; i < made.length; i++) write(made[i], i);
  sum = 0;
  for (const object of made) sum += (object.first ?? 0) + object.second;
  console.log(shapes, "classes, every seventh with a setter of its own, every seventh object with a property of its own:", log, own, sum);
}
//// inline-literal-spreads.js
// `{ ...base, ...(c ? { x: 1 } : {}) }`, `{ ...{ a, b } }`, `{ a, ...(c && { b }) }`: a literal that is written only to be spread: the keys in their order, later ones over earlier ones, and every case in which the literal is more than its written fields.
const show = value => JSON.stringify(value, (key, held) => held === undefined ? "undefined" : typeof held === "function" ? "function" : held) + " " + Object.keys(value).join();
const log = [];
const note = x => (log.push(x), x);
const base = { p: 1, q: 2 };
const cases = {
  only: (c, i) => ({ ...{ a: i, b: 2 } }),
  behindFields: (c, i) => ({ first: 0, ...{ a: i, b: 2 }, last: 9 }),
  conditional: (c, i) => ({ first: 0, ...(c ? { x: i } : {}) }),
  conditionalOrUndefined: (c, i) => ({ first: 0, ...(c ? { x: i, y: 2 } : undefined), last: 9 }),
  and: (c, i) => ({ first: 0, ...(c && { x: i }) }),
  behindObject: (c, i) => ({ ...base, ...(c ? { q: "over", r: i } : {}) }),
  aheadOfObject: (c, i) => ({ ...{ q: "under", r: i }, ...base }),
  overrides: (c, i) => ({ a: 1, b: 2, ...{ b: "over", c: i }, a: "last" }),
  twiceInLiteral: (c, i) => ({ ...{ a: 1, b: 2, a: i } }),
  two: (c, i) => ({ ...{ a: i }, ...{ b: 2 }, ...{ a: "again" } }),
  nested: (c, i) => ({ ...{ a: { ...{ b: i } } } }),
  spreadInSpread: (c, i) => ({ ...{ a: 1, ...{ b: i } } }),
  empty: (c, i) => ({ ...{} , a: i }),
  undefinedValue: (c, i) => ({ a: 1, ...{ a: undefined, b: i } }),
  order: (c, i) => ({ a: note("a"), ...{ b: note("b"), c: note("c") }, d: note("d") }),
  index: (c, i) => ({ z: 0, ...{ b: 1, 2: "two", a: 2, 1: "one" } }),
  indexInTarget: (c, i) => ({ 5: "five", ...{ b: 1 }, 3: "three" }),
  proto: (c, i) => ({ ...{ ["__proto__"]: i, a: 1 } }),
  protoSyntax: (c, i) => ({ ...{ __proto__: { inherited: 1 }, own: i } }),
  getter: (c, i) => ({ ...{ get a() { return note("got") + i; }, b: 2 } }),
  method: (c, i) => ({ ...{ m() { return i; }, a: 1 } }),
  computed: (c, i) => ({ ...{ [c ? "x" : "y"]: i, a: 1 } }),
  symbol: (c, i) => Object.getOwnPropertySymbols({ ...{ [Symbol.iterator]: i, a: 1 } }).length,
  keptToo: (c, i) => { const lit = { a: i }; const out = { ...lit, b: 2 }; lit.a = "changed"; return [out, lit]; },
  readToo: (c, i) => { const lit = { a: i, b: 2 }; return { ...lit, sum: lit.a + lit.b }; },
  storedBefore: (c, i) => { const lit = { a: i }; lit.b = 2; return { ...lit }; },
  deletedBefore: (c, i) => { const lit = { a: i, b: 2 }; delete lit.a; return { ...lit }; },
  intoItself: (c, i) => { const lit = { a: i }; return { lit, ...lit }; },
  inTry: (c, i) => { try { return { first: 0, ...(c ? { x: fails(i) } : { y: i }) }; } catch (e) { return { caught: e.message }; } },
  inLoop: (c, i) => { let out = {}; for (let j = 0; j < 3; j++) out = { ...out, ...{ ["k" + j]: j }, ...{ last: j } }; return out; },
  assign: (c, i) => Object.assign({ first: 0 }, { a: i }, c ? { b: 2 } : null),
  frozenTarget: (c, i) => { const t = Object.freeze({ a: 1 }); return { ...t, ...{ a: i } }; },
};
function fails(i) { if (i % 2) throw new Error("failed " + i); return i; }
for (const [name, f] of Object.entries(cases)) for (const c of [true, false]) console.log(name, c, show(f(c, 1)), show(f(c, 2)), log.splice(0).join());
let sum = 0; for (let i = 0; i < 150000; i++) { const o = { first: i, ...(i & 1 ? { x: i } : {}), ...(i & 2 && { y: 1, z: 2 }) }; sum += Object.keys(o).length + (o.x ?? 0); } console.log(sum);
//// instanceof-built-in-classes.js
function classify(value) {
    if (value instanceof Map) return "Map";
    else if (value instanceof Set) return "Set";
    else if (value instanceof Array) return "Array";
    else if (value instanceof Date) return "Date";
    else if (value instanceof RegExp) return "RegExp";
    else if (value instanceof Promise) return "Promise";
    else if (value instanceof Error) return "Error";
    return "none";
}

class SubMap extends Map {}
class SubSet extends Set {}
class SubArray extends Array {}
class SubDate extends Date {}
class SubRegExp extends RegExp {}
class SubPromise extends Promise {}
class SubError extends Error {}

const expected = [
    ["Map", new Map(), "Map"],
    ["Set", new Set(), "Set"],
    ["Array", [], "Array"],
    ["Date", new Date(0), "Date"],
    ["RegExp", /a/, "RegExp"],
    ["Promise", Promise.resolve(1), "Promise"],
    ["Error", new Error("e"), "Error"],
    ["TypeError", new TypeError("e"), "Error"],
    ["SubMap", new SubMap(), "Map"],
    ["SubSet", new SubSet(), "Set"],
    ["SubArray", new SubArray(), "Array"],
    ["SubDate", new SubDate(0), "Date"],
    ["SubRegExp", new SubRegExp("a"), "RegExp"],
    ["SubPromise", new SubPromise(() => {}), "Promise"],
    ["SubError", new SubError("e"), "Error"],
    ["Object.create(Map.prototype)", Object.create(Map.prototype), "Map"],
    ["Object.create(Set.prototype)", Object.create(Set.prototype), "Set"],
    ["Object.create(Date.prototype)", Object.create(Date.prototype), "Date"],
    ["array with the prototype of Map", Object.setPrototypeOf([], Map.prototype), "Map"],
    ["array with the prototype of Object", Object.setPrototypeOf([], Object.prototype), "none"],
    ["array without a prototype", Object.setPrototypeOf([], null), "none"],
    ["Map with the prototype of Set", Object.setPrototypeOf(new Map(), Set.prototype), "Set"],
    ["proxy of Map", new Proxy(new Map(), {}), "Map"],
    ["proxy that answers Date", new Proxy({}, { getPrototypeOf: () => Date.prototype }), "Date"],
    ["plain object", {}, "none"],
    ["Object.create(null)", Object.create(null), "none"],
    ["function", function () {}, "none"],
    ["number", 1, "none"],
    ["double", 1.5, "none"],
    ["string", "Map", "none"],
    ["boolean", false, "none"],
    ["symbol", Symbol("Map"), "none"],
    ["bigint", 1n, "none"],
    ["undefined", undefined, "none"],
    ["null", null, "none"],
];

for (const [label, value, answer] of expected) {
    const found = classify(value);
    console.log(label, found);
    if (found !== answer) throw new Error(`${label}: expected ${answer}, found ${found}`);
}

let matches = 0;
for (let round = 0; round < 20000; round++) {
    const [label, value, answer] = expected[round % expected.length];
    if (classify(value) !== answer) throw new Error(`round ${round}: ${label}`);
    if (answer !== "none") matches++;
}
console.log(matches);

const negatives = [{}, 1];
for (const value of negatives) {
    const isInstance = [Map, Set, Array, Date, RegExp, Promise, Error].some(builtinClass => value instanceof builtinClass);
    console.log(isInstance);
}
console.log(new SubMap() instanceof Map, new SubError("e") instanceof Error, new SubArray() instanceof Array);
//// instanceof-built-in-classes-that-have-subclasses.js
// `value instanceof Promise` and its like in a program that also extends these classes and makes code from text: what counts is the prototype chain.
class OwnPromise extends Promise {}
