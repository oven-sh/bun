//// has-own-property-typed-objects.ts
interface T { a?: number; b: number; c?: string; d?: unknown }
class Base { constructor(public v: number) {} method() { return 1; } get twice() { return this.v * 2; } }
class Heir extends Base { w = "w"; #secret = 1; peek() { return this.#secret; } }
function hide(value: unknown): any { return value; }
let count = 0;
////= show
const hasOwn = Object.prototype.hasOwnProperty;
const bits = (list: boolean[]) => list.map(b => (b ? "1" : "0")).join("");
const keys: any[] = ["a", "b", "c", "d", "zz", "toString", "constructor", "__proto__", "v", "w", "twice", "method", "#secret", "secret", "length", "0", 0, 1.5, "", Symbol.iterator, Symbol.for("s"), "a" + "", ["b"].join(""), { toString() { return "b"; } }, null, undefined];
function byCall(x: any) { return bits(keys.map(k => hasOwn.call(x, k))); }
function byMethod(x: any) { return typeof x.hasOwnProperty === "function" ? bits(keys.map(k => x.hasOwnProperty(k))) : "no method"; }
function byHasOwn(x: any) { return bits(keys.map(k => Object.hasOwn(x, k))); }
function enumerable(x: any) { return bits(keys.map(k => Object.prototype.propertyIsEnumerable.call(x, k))); }
function looped(x: any) { let n = 0; for (let i = 0; i < 50; i++) for (const k of keys) n += hasOwn.call(x, k) ? 1 : 0; return n; }
function owned(x: any) { const out: string[] = []; for (const k in x) if (hasOwn.call(x, k)) out.push(k); return out.join(); }
const every = (x: unknown) => [byCall(x), byMethod(x), byHasOwn(x), enumerable(x), looped(x), owned(x)];
const plain = (...list: [string | symbol, unknown][]): any => { const o = JSON.parse("{}"); for (const [k, v] of list) o[k] = v; return o; };
const make: () => T = () => ({ b: 1 });
show("a record", () => every(make()));
show("optional fields: set, undefined, deleted", () => { const x: T = { a: 1, b: 1 }, y: T = { a: undefined, b: 1 }, z: T = { a: 1, b: 1 }; delete z.a; return [every(x), every(y), every(z)]; });
show("objects of one shape in turn, one site", () => { const list: T[] = [{ b: 1 }, { a: 1, b: 1 }, { b: 1 }, { b: 1, c: "c" }, { a: 1, b: 1, c: "c" }, { b: 1 }]; return list.map(byCall); });
show("set and deleted between looks", () => { const x = make(); const out = [every(x)]; x.a = 1; out.push(every(x)); delete x.a; out.push(every(x)); x.a = undefined; out.push(every(x)); return out; });
show("another prototype that has the names", () => { const proto = plain(["a", 9], ["zz", 9]); const x = Object.setPrototypeOf(hide(make()), proto); const out = [every(x)]; delete proto.a; out.push(every(x)); x.a = 1; out.push(every(x)); return out; });
show("a null prototype", () => every(Object.setPrototypeOf(hide(make()), null)));
show("instances", () => [every(new Base(1)), every(new Heir(2))]);
show("extras: a string, an index, a symbol, hidden, an accessor; then gone", () => { const x = make(); const out = [every(x)]; hide(x).zz = 1; out.push(every(x)); hide(x)[0] = 1; hide(x)[Symbol.for("s")] = 1; Object.defineProperty(hide(x), "length", { value: 1, enumerable: false }); Object.defineProperty(hide(x), "", { get() { return 1; }, enumerable: true, configurable: true }); out.push(every(x)); delete hide(x).zz; delete hide(x)[0]; delete hide(x)[""]; out.push(every(x)); return out; });
show("an extra that comes and goes", () => { const x = make(); hide(x).zz = 1; const a = byCall(x); delete hide(x).zz; return [a, byCall(x), every(x)]; });
show("frozen, sealed, closed", () => [Object.freeze({ a: 1, b: 1 } as T), Object.seal({ b: 2 } as T), Object.preventExtensions({ b: 3 } as T)].map(every));
show("typed and plain in turn, one site", () => [make(), plain(["b", 1]), { a: 1, b: 2 } as T, plain(["a", 1]), new Base(1), [1], make(), () => 1, "ab"].map(byCall));
show("a typed object as a prototype", () => { const proto = make(); const child = Object.create(proto); return [every(child), every(proto)]; });
show("a proxy over a typed object", () => byCall(new Proxy({ a: 1, b: 1 } as T, {})));
show("null and undefined", () => [null, undefined].map(x => { try { return byCall(x); } catch (e) { return (e as Error).name; } }));
//// host-accessors-by-name.js
// Getters and setters of Bun's host classes reached by name from untyped code: Buffer's typed array properties, URL, Blob.
const lines = [];
const show = (label, value) => lines.push(label + ": " + String(value));

////= readRepeatedly

////= errorOf

const readByteLength = o => o.byteLength;
const readByteOffset = o => o.byteOffset;
const readLength = o => o.length;
const readHref = o => o.href;
const readSize = o => o.size;
const writeHash = (o, value) => {
  o.hash = value;
};

const buffer = Buffer.from(new ArrayBuffer(16), 2, 5);
show("Buffer", [readRepeatedly(readByteLength, buffer), readRepeatedly(readByteOffset, buffer), readRepeatedly(readLength, buffer)].join(" "));

const url = new URL("https://example.com/path?query#start");
show("host getter", readRepeatedly(readHref, url));
show("host getter of Blob", readRepeatedly(readSize, new Blob([])));
for (let i = 0; i < 1000; i++) writeHash(url, "#a");
show("host setter", url.href);

show("host getter on another class", errorOf(() => Reflect.get(URL.prototype, "href", {})));
show("host getter on an object inheriting its class", errorOf(() => readHref(Object.create(URL.prototype))));

console.log(lines.join("\n"));
//// host-accessors-cached-across-gc.js
// What the engine knows of a host object's accessor outlives a collection.
// Only the jsc shell can count. Elsewhere the program checks the answers alone.
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;
const collect = typeof gc === "function" ? gc : () => Bun.gc(true);
function lastMatch() { return RegExp.lastMatch; }
function firstGroup() { return RegExp.$1; }
function input() { return RegExp.input; }
const read = () => lastMatch() + "|" + firstGroup() + "|" + input();
/(b+)c/.exec("aabbbcd");
const seen = new Set();
for (let i = 0; i < 100; i++) seen.add(read());
const before = count("operationAOTGetById");
for (let turn = 0; turn < 40; turn++) {
  collect();
  for (let i = 0; i < 20; i++) seen.add(read());
}
const times = count("operationAOTGetById") - before;
console.log([...seen].join(" "), times < 40 ? "and the operation was entered under 40 times" : "and the operation was entered " + times + " times");
/(x)y/.exec("wxyz");
console.log(read());
collect();
/(q+)/.exec("ppqqq");
console.log(read());
//// host-accessors-from-runtime-code.ts
// Evaluated text reads, 10,000 times at one site, what the interpreter's own cache cannot hold: accessors that the host implements natively (url, method, headers and signal of a Request, byteLength of a Buffer, size of a Blob), getters of classes, absent names and what a compiled object above the receiver has. Then what was read changes.
const lines: string[] = [];
const turns = 10_000;
////= lines-22	hide	value	any
const show = (value: unknown): string =>
  typeof value === "string" ? JSON.stringify(value) : typeof value === "function" ? "function" : typeof value === "object" && value !== null ? Object.prototype.toString.call(value) : String(value);
function say(label: string, ...values: (string | number)[]) {
  lines.push(label + ": " + values.join(" | "));
}
function attempt(run: () => string | number): string {
  try {
    return String(run());
  } catch (error) {
    return "throws " + (error as Error).constructor.name;
  }
}

type Site<Result> = (value: unknown, turns: number) => Result;
function sitesOf<Result>(body: (name: string) => string) {
  const sites = new Map<string, Site<Result>>();
  return (name: string): Site<Result> => {
    let site = sites.get(name);
    if (!site) sites.set(name, (site = new Function("value", "turns", body(name)) as Site<Result>));
    return site;
  };
}
const readerOf = sitesOf<unknown[]>(name => `const seen = []; for (let i = 0; i < turns; i++) { const v = value.${name}; if (!i || !Object.is(v, seen[seen.length - 1])) seen.push(v); } return seen;`);
const adderOf = sitesOf<number>(name => `let total = 0; for (let i = 0; i < turns; i++) total += value.${name}; return total;`);
const read = (name: string, value: unknown, times = turns) => attempt(() => readerOf(name)(value, times).map(show).join(" then "));
const add = (name: string, value: unknown, times = turns) => attempt(() => adderOf(name)(value, times));

type Handler = (request: unknown, buffer: unknown, blob: unknown, turns: number) => string;
const handler = new Function(
  "request",
  "buffer",
  "blob",
  "turns",
  `let total = 0;
  const headers = request.headers, signal = request.signal;
  for (let i = 0; i < turns; i++) {
    total += request.url.length + request.method.length + buffer.byteLength + blob.size;
    if (request.headers !== headers || request.signal !== signal) total += 1000000;
  }
  return [total, request.url, request.method, headers.get("x-name"), signal.aborted, buffer.byteLength, blob.size].join(" ");`,
) as Handler;
const handle = (request: unknown, buffer: unknown, blob: unknown) => attempt(() => handler(request, buffer, blob, turns));

const get = new Request("http://localhost/one", { headers: { "x-name": "get" } });
const post = new Request("http://localhost/two?x=1", { method: "POST", body: "text", headers: { "x-name": "post" } });
const aborted = new Request("http://localhost/aborted", { signal: AbortSignal.abort(), headers: { "x-name": "aborted" } });
const buffer = Buffer.from("some bytes"), longer = Buffer.alloc(300);
const blob = new Blob(["abc"]), larger = new Blob(["abcdef", "ghi"]);

function everyRequest(label: string) {
  say(label, handle(get, buffer, blob), handle(post, longer, larger), handle(aborted, buffer, larger), handle(get, longer, blob));
  say(label + ", one name at a site", read("url", get), read("url", post), read("method", get), read("method", post), read("headers", get), read("signal", get), read("signal.aborted", aborted), read("bodyUsed", post));
}
everyRequest("requests");

function tryToReplace(prototype: object, name: string) {
  const original = Object.getOwnPropertyDescriptor(prototype, name)!;
  try {
    Object.defineProperty(prototype, name, { get: () => "replaced", configurable: true });
  } catch {
    return;
  }
  Object.defineProperty(prototype, name, original);
}
for (const name of ["url", "method", "headers", "signal"]) tryToReplace(Request.prototype, name);
tryToReplace(Blob.prototype, "size");
everyRequest("after an attempt to replace the accessors");

class Heir extends Request {}
class Overriding extends Request {
  override get url() {
    return "overridden " + super.url;
  }
}
const heir = new Heir("http://localhost/heir", { headers: { "x-name": "heir" } });
const overriding = new Overriding("http://localhost/overriding", { method: "PUT", headers: { "x-name": "overriding" } });
say("a subclass", handle(heir, buffer, blob), read("url", heir), read("method", heir));
say("a subclass that overrides url", handle(overriding, buffer, blob), read("url", overriding), read("method", overriding));
everyRequest("requests after them");
Object.defineProperty(Heir.prototype, "url", {
  get(this: Request) {
    return "defined later for " + this.method;
  },
  configurable: true,
});
say("the subclass gets a getter", handle(heir, buffer, blob), read("url", heir), read("url", get));
delete hide(Heir.prototype).url;
say("and loses it", handle(heir, buffer, blob), read("url", heir));
Object.defineProperty(Heir.prototype, "method", { value: "A VALUE", configurable: true });
say("the subclass gets a value", handle(heir, buffer, blob), read("method", heir), read("method", get));
delete hide(Heir.prototype).method;
say("and loses it", handle(heir, buffer, blob), read("method", heir));

const changed = new Request("http://localhost/changed");
say("before an own property", read("url", changed));
Object.defineProperty(changed, "url", { value: "own", configurable: true });
say("an own property", read("url", changed), read("url", get));
delete hide(changed).url;
say("it is gone", read("url", changed));
hide(changed).extra = 1;
say("an own property of another name", read("url", changed), read("extra", changed), read("extra", get));
Object.setPrototypeOf(changed, { url: "of another chain" });
say("another chain", read("url", changed), read("method", changed));
Object.setPrototypeOf(changed, Request.prototype);
say("the first chain again", read("url", changed), read("method", changed));
say("what inherits from a request", read("url", Object.create(get)), read("method", Object.create(get)), read("headers", Object.create(get)));
say("the prototype itself", read("url", Request.prototype), read("method", Request.prototype));
say("a response where a request was", read("url", new Response("x")), read("method", new Response("x")), read("headers", new Response("x")));
say("no object", read("url", "text"), read("url", 5), read("url", undefined), read("url", null));

class Sized extends Blob {
  override get size() {
    return super.size + 1000;
  }
}
say("buffers", read("byteLength", buffer), read("byteLength", longer), read("length", buffer), read("byteLength", buffer.subarray(2, 5)), read("byteLength", new Uint8Array(7)), read("byteLength", new ArrayBuffer(9)), read("byteLength", new DataView(new ArrayBuffer(11))), read("byteLength", {}));
say("blobs", read("size", blob), read("size", larger), read("size", blob.slice(1)), read("size", new File(["abcd"], "name.txt")), read("size", new Sized(["ab"])), read("type", new Blob(["x"], { type: "text/plain" })), read("size", new Map([[1, 2]])), read("size", new Set([1, 2, 3])), read("size", {}));

const inTurn = new Function("values", "turns", "let total = 0; for (let i = 0; i < turns; i++) { let url; try { url = values[i % values.length].url; } catch (error) { url = error.constructor.name; } total += url === undefined ? 1 : url.length; } return total;") as Site<number>;
say("many receivers at one site", inTurn([get, post, heir, overriding, changed, { url: "plain" }, blob, Object.create(get), new Response("x"), [], aborted], turns));

let calls = 0;
class Compiled {
  get one() {
    calls++;
    return 1;
  }
  get self() {
    return this;
  }
}
const Ordinary = new Function("count", "return class Ordinary { get one() { count(); return 1; } get self() { return this; } };")(() => {
  calls++;
}) as new () => object;
const countSelf = new Function("value", "turns", "let same = 0; for (let i = 0; i < turns; i++) if (value.self === value) same++; return same;") as Site<number>;
const classes: [string, new () => object][] = [
  ["a compiled class", Compiled],
  ["a class of the text", Ordinary],
];
for (const [kind, Class] of classes) {
  const instance = new Class(), below = Object.create(instance);
  calls = 0;
  say("a getter of " + kind, add("one", instance), calls, add("one", below), calls, add("one", new Class()), calls);
  say("its receiver", countSelf(instance, turns), countSelf(below, turns));
  Object.defineProperty(Class.prototype, "one", {
    get() {
      calls += 2;
      return 2;
    },
    configurable: true,
  });
  calls = 0;
  say("another getter", add("one", instance), calls, add("one", below), calls);
  Object.defineProperty(Class.prototype, "one", { value: 3, writable: true, configurable: true });
  calls = 0;
  say("a value", add("one", instance), add("one", below), calls);
  delete hide(Class.prototype).one;
  say("nothing", add("one", instance), add("one", below), read("one", instance));
  Object.defineProperty(instance, "one", { get: () => 4, configurable: true });
  say("a getter of its own", add("one", instance), add("one", below), add("one", new Class()));
  delete hide(instance).one;
  hide(Class.prototype).one = 5;
  say("a value again", add("one", instance), add("one", below));
}

let left = 0;
class Throwing {
  get risky() {
    if (!left--) throw new RangeError("enough");
    return 1;
  }
}
const ThrowingInText = new Function("check", "return class { get risky() { check(); return 1; } };")(() => {
  if (!left--) throw new RangeError("enough");
}) as new () => object;
const untilThrown = new Function("value", "turns", "let i = 0; try { for (; i < turns; i++) value.risky; } catch (error) { return i + ' ' + error.message; } return i + ' none';") as Site<string>;
for (const Class of [Throwing, ThrowingInText] as (new () => object)[]) {
  const instance = new Class();
  left = 5000;
  const first = untilThrown(instance, turns);
  left = 20_000;
  const second = untilThrown(instance, turns);
  left = 0;
  say("a getter that throws", first, second, untilThrown(instance, turns), add("risky", instance));
}

const parsed = JSON.parse('{"a":1,"b":"two"}');
const root: Record<string, unknown> = {};
const child = Object.create(root);
const closure = () => 1;
const list = [1, 2];
const ofCompiled = new Compiled(), ofOrdinary = new Ordinary();
const everyMissing = (label: string) =>
  say(label, ...[parsed, child, get, heir, list, buffer, blob, closure, ofCompiled, ofOrdinary].map(value => read("missing", value)));
everyMissing("an absent name");
root.missing = "of the root";
parsed.missing = "own";
hide(get).missing = "own";
hide(Heir.prototype).missing = "of the subclass";
hide(list).missing = "own";
hide(buffer).missing = "own";
hide(blob).missing = "own";
hide(closure).missing = "own";
hide(Compiled.prototype).missing = "of the class";
hide(Ordinary.prototype).missing = "of the class";
everyMissing("the name is there");
for (const holder of [root, parsed, get, Heir.prototype, list, buffer, blob, closure, Compiled.prototype, Ordinary.prototype]) delete hide(holder).missing;
everyMissing("the name is absent again");
for (const holder of [root, Heir.prototype, Compiled.prototype, Ordinary.prototype]) Object.defineProperty(holder, "missing", { get: () => "got", configurable: true });
everyMissing("a getter above");
for (const holder of [root, Heir.prototype, Compiled.prototype, Ordinary.prototype]) delete hide(holder).missing;
everyMissing("absent once more");

class Item {
  whole = 1;
  text = "text";
  maybe?: number;
  method() {
    return "method";
  }
  get computed() {
    return "computed " + this.whole;
  }
}
const item = new Item(), below = Object.create(item), belowPrototype = Object.create(Item.prototype);
const everyMember = (label: string) =>
  say(label, ...["whole", "text", "maybe", "method", "computed", "extra", "missing"].map(name => read(name, below)), read("whole", belowPrototype), read("method", belowPrototype), read("computed", belowPrototype));
everyMember("a compiled object above");
item.whole = 2;
item.text = "changed";
item.maybe = 3;
everyMember("its fields change");
hide(item).extra = "extra";
everyMember("it gets another property");
delete hide(item).whole;
delete item.maybe;
delete hide(item).extra;
everyMember("it loses properties");
hide(item).whole = "a string";
hide(Item.prototype).maybe = "of the class";
everyMember("a value of another type, and a name above");
delete hide(Item.prototype).maybe;
hide(below).whole = "own";
everyMember("an own property in front");
delete hide(below).whole;
Object.setPrototypeOf(below, new Item());
everyMember("another compiled object above");
Object.setPrototypeOf(below, null);
everyMember("nothing above");

const lengthAtFirstSite = new Function("value", "turns", "let total = 0; for (let i = 0; i < turns; i++) total += value.length; return total;") as Site<number>;
const lengthAtSecondSite = new Function("value", "turns", "let total = 0; for (let i = 0; i < turns; i++) total += value.length; return total;") as Site<number>;
const lengthByPattern = new Function("value", "turns", "let total = 0; for (let i = 0; i < turns; i++) { const { length } = value; total += length; } return total;") as Site<number>;
const arrays: unknown[] = [[1, 2, 3], [], [1.5], ["a", "b"], new Array(5), [1, , 3, 4]];
say("the length of arrays at one site", ...arrays.map(array => lengthAtFirstSite(array, turns)));
say("at a second site", ...arrays.map(array => lengthAtSecondSite(array, turns)));
say("in a pattern", ...arrays.map(array => lengthByPattern(array, turns)));
const grown = [1, 2, 3];
say("an array grows", lengthAtFirstSite(grown, turns), (grown.push(4), lengthAtSecondSite(grown, turns)), ((grown.length = 1), lengthAtFirstSite(grown, turns)), lengthByPattern(grown, turns));
say("what is no array", ...["text", { length: 7 }, buffer, closure, new Uint8Array(2)].map(value => [lengthAtFirstSite(value, turns), lengthAtSecondSite(value, turns), lengthByPattern(value, turns)].join()));

const countAbsent = new Function("value", "turns", "let absent = 0; for (let i = 0; i < turns; i++) if (value.seldom === undefined) absent++; return absent;") as Site<number>;
let total = 0;
for (let round = 0; round < 300; round++) {
  const parent: Record<string, unknown> = { ["own" + round]: round };
  const heirOfParent = Object.create(parent);
  total += countAbsent(heirOfParent, 20);
  parent.seldom = round;
  total += countAbsent(heirOfParent, 20) * 1000;
  delete parent.seldom;
  total += countAbsent(heirOfParent, 20);
  const request = new Request("http://localhost/" + round);
  hide(request)["own" + round] = round;
  total += Number(add("url.length", request, 20));
  if (round % 100 === 99) Bun.gc(true);
}
say("shapes that die", total);
everyRequest("requests at the end");
console.log(lines.join("\n"));
//// in-below-typed-prototype.ts
// `name in heir`, where heir is a plain object whose prototype is a typed object: Object.create(typed). The heir's entry in the table of `in` says only "not mine: ask my prototype", and the stub looks the prototype up in the same table, so what a typed object answers for itself (always there; read this optional field; ask above) is asked anew each time, without entering the runtime. Every change below is made AFTER the entries are there.
declare const aotOperationCount: undefined | ((name: string) => number);
interface Step { op: string; weight: number; inner: { a: number }; run(this: any, x: number): number; note?: string; size?: number }
function makeStep(op: string, weight: number): Step { return { op, weight, inner: { a: weight }, run(this: any, x: number): number { return x + this.weight; } }; }
const steps: Step[] = [makeStep("add", 1.5), makeStep("sub", 2.5), makeStep("mul", 3.5)];
let typedSum = 0;
for (const step of steps) typedSum += step.weight + step.op.length + step.inner.a + step.run(1) + (step.note ?? "").length + (step.size ?? 0);
console.log(typedSum);
class Shape { sides: number; label?: string; constructor(sides: number) { this.sides = sides; } area(): number { return this.sides * 2; } }
const shapes: Shape[] = [new Shape(3), new Shape(4)];
let shapeSum = 0;
for (const shape of shapes) shapeSum += shape.area() + (shape.label ?? "").length;
console.log(shapeSum);
const entered = (): number => typeof aotOperationCount === "function" ? aotOperationCount("operationAOTInByValAndCache") : 0;
const has = function (o: any, key: any): any { return key in o; };
const mark = Symbol("mark");
const names: any[] = ["op", "weight", "inner", "run", "note", "size", "missing", "toString", "value", "later", "0", mark];
const all = (o: any): string => names.map(name => String(name) + "=" + (has(o, name) ? 1 : 0)).join(" ");
const base: any = (function (x: any): any { return x; })(steps[0]);
const heir: any = Object.create(base);
heir.value = 1;
const below: any = Object.create(heir);
const deeper: any = Object.create(below);
console.log("heir  ", all(heir));
console.log("below ", all(below));
console.log("deeper", all(deeper));
for (const [what, o] of [["heir", heir], ["below", below], ["deeper", deeper]] as [string, any][]) {
  for (const name of ["op", "run", "note", "missing", "toString", mark]) {
    const first = has(o, name);
    const before = entered();
    let same = 0;
    for (let i = 0; i < 2000; i++) same += has(o, name) === first ? 1 : 0;
    console.log(what, String(name), first, same, entered() - before < 20);
  }
}
base.note = "now";
console.log("an optional field is set on the prototype:", all(heir), "|", has(below, "note"), has(deeper, "note"));
delete base.note;
console.log("and deleted:", all(heir), "|", has(below, "note"), has(deeper, "note"));
base.size = 3;
console.log("another is set:", has(heir, "size"), has(below, "size"), has(deeper, "size"));
base.later = 1;
console.log("a property beyond the layout:", all(heir), "|", has(below, "later"), has(deeper, "later"));
delete base.later;
console.log("and deleted:", has(heir, "later"), has(below, "later"), has(deeper, "later"));
base[mark] = 1;
console.log("a symbol:", has(heir, mark), has(below, mark), has(deeper, mark));
delete base[mark];
console.log("and deleted:", has(heir, mark), has(below, mark), has(deeper, mark));
heir.missing = 1;
console.log("the heir gets it itself:", has(heir, "missing"), has(below, "missing"), has(deeper, "missing"));
delete heir.missing;
console.log("and loses it:", has(heir, "missing"), has(below, "missing"), has(deeper, "missing"));
below.missing = undefined;
console.log("the one below gets it:", has(heir, "missing"), has(below, "missing"), has(deeper, "missing"));
const above: any = { far: 1 };
console.log("before the prototype gets another prototype:", has(heir, "far"), has(deeper, "far"), has(heir, "toString"));
try { Object.setPrototypeOf(base, above); console.log("after:", has(heir, "far"), has(deeper, "far"), has(heir, "toString")); above.farther = 1; console.log("and a name added there:", has(heir, "farther"), has(deeper, "farther")); } catch (error: any) { console.log("after:", error.constructor.name); }
const second: any = (function (x: any): any { return x; })(steps[1]);
const moved: any = Object.create(second);
console.log("another heir:", all(moved));
Object.setPrototypeOf(moved, { only: 1 });
console.log("moved under a plain object:", all(moved), has(moved, "only"));
Object.setPrototypeOf(moved, second);
console.log("and back:", all(moved), has(moved, "only"));
Object.setPrototypeOf(moved, null);
console.log("and under nothing:", all(moved));
const instance: any = (function (x: any): any { return x; })(shapes[0]);
const ofInstance: any = Object.create(instance);
const shapeNames = ["sides", "label", "area", "constructor", "missing"];
const allOfShape = (o: any): string => shapeNames.map(name => name + "=" + (has(o, name) ? 1 : 0)).join(" ");
console.log("heir of an instance:", allOfShape(ofInstance));
for (const name of shapeNames) { const first = has(ofInstance, name); const before = entered(); let same = 0; for (let i = 0; i < 2000; i++) same += has(ofInstance, name) === first ? 1 : 0; console.log("heir of an instance", name, first, same, entered() - before < 20); }
instance.label = "three";
console.log("its optional field is set:", allOfShape(ofInstance));
delete instance.label;
console.log("and deleted:", allOfShape(ofInstance));
const frozen: any = Object.freeze((function (x: any): any { return x; })(steps[2]));
const ofFrozen: any = Object.create(frozen);
console.log("heir of a frozen one:", all(ofFrozen));
const many: any[] = [];
for (let i = 0; i < 60; i++) { const o = Object.create(i % 2 ? base : second); o["k" + (i % 7)] = i; many.push(o); }
let count = 0;
for (let round = 0; round < 20; round++) for (const o of many) count += (has(o, "op") ? 1 : 0) + (has(o, "k3") ? 2 : 0) + (has(o, "nowhere") ? 4 : 0);
console.log(count);
for (const bad of [1, "text", undefined, null]) { try { console.log(has(bad, "op")); } catch (error: any) { console.log(error.constructor.name); } }
if (typeof (globalThis as any).gc === "function") (globalThis as any).gc();
console.log("after a collection:", all(heir), "|", all(deeper));
//// in-from-runtime-code.ts
// Functions made at run time ask `"name" in value` of plain objects and of objects of the program's own types, over and over, while names come and go.
interface Address { city: string; zip?: string }
interface User { id: number; name: string; ok: boolean; score: number; count: number; nick?: string; age?: number; flag?: boolean; address?: Address; anything?: unknown; nothing: null; missing: undefined }
class Point { x = 1; y = 2.5; label?: string; constructor(label?: string) { if (label !== undefined) this.label = label; } get length() { return 2; } method() {} }
const lines: string[] = [];
const collect: () => void = typeof (globalThis as any).gc === "function" ? (globalThis as any).gc : () => Bun.gc(true);
const askers: Record<string, (value: unknown) => boolean> = Object.create(null);
const has = (name: string) => (askers[name] ??= new Function("value", "return " + JSON.stringify(name) + " in value;") as (value: unknown) => boolean);
const say = (label: string, run: () => unknown) => {
  const seen: string[] = [];
  for (let turn = 0; turn < 5; turn++) {
    try {
      seen.push(String(run()));
    } catch (error) {
      seen.push("throws " + (error as Error).constructor.name);
    }
  }
  lines.push(label + ": " + seen.join(" "));
};
const names = ["id", "name", "ok", "score", "count", "nick", "age", "flag", "address", "anything", "nothing", "missing", "absent", "toString", "__proto__", "constructor"];
const full: User = { id: 1, name: "n", ok: false, score: 0.5, count: 0, nick: "k", age: 3, flag: false, address: { city: "c", zip: "z" }, anything: undefined, nothing: null, missing: undefined };
const bare: User = { id: NaN, name: "", ok: true, score: NaN, count: -1, nothing: null, missing: undefined };
const asked = (value: unknown) => names.map(name => (has(name)(value) ? "1" : "0")).join("");
say("every field", () => asked(full));
say("the optional ones absent", () => asked(bare));
say("in turn", () => asked(full) + " " + asked(bare));
say("the same data as a plain object", () => asked(JSON.parse(JSON.stringify(full))) + " " + asked({ ...bare }));
bare.nick = "later";
bare.age = 0;
bare.flag = true;
say("optional fields are stored", () => asked(bare));
bare.nick = undefined;
say("undefined is stored", () => asked(bare));
delete bare.nick;
delete bare.age;
say("two are deleted", () => asked(bare));
(bare as any).absent = 1;
say("a name that is no field is added", () => asked(bare));
delete (bare as any).absent;
say("and deleted", () => asked(bare));
say("an address", () => has("city")(full.address) + " " + has("zip")(full.address) + " " + has("zip")({ city: "c" } as Address));
say("an instance", () => ["x", "y", "label", "length", "method", "absent"].map(name => has(name)(new Point())).join(" "));
say("an instance with its label", () => ["x", "y", "label"].map(name => has(name)(new Point("l"))).join(" "));

const plain: Record<string, unknown> = { a: 1 };
say("before", () => has("later")(plain));
plain.later = undefined;
say("added", () => has("later")(plain));
delete plain.later;
say("deleted", () => has("later")(plain));
const base: Record<string, unknown> = {}, child = Object.create(base);
say("the parent lacks it", () => has("inherited")(child));
base.inherited = 1;
say("the parent has it", () => has("inherited")(child));
delete base.inherited;
say("the parent lost it", () => has("inherited")(child));
say("a proxy", () => has("anything")(new Proxy({}, { has: () => true })) + " " + has("anything")(new Proxy({}, {})));
say("a proxy in the chain", () => has("anything")(Object.create(new Proxy({}, { has: () => true }))));
say("an array", () => has("length")([]) + " " + has("absent")([]));
say("a function", () => has("name")(() => 1) + " " + has("prototype")(function () {}) + " " + has("prototype")(() => 1));
say("a string object", () => has("length")(new String("s")));
say("a typed array", () => has("length")(new Uint8Array(1)) + " " + has("byteLength")(new Uint8Array(1)));
say("no prototype", () => has("toString")(Object.create(null)));
say("a getter", () => has("got")({ get got() { throw new Error("not run"); } }));
for (const value of ["text", 5, true, undefined, null, Symbol.iterator, 5n]) say(typeof value, () => has("length")(value));
const dictionary: Record<string, number> = {};
for (let i = 0; i < 200; i++) dictionary["key" + i] = i;
for (let i = 0; i < 200; i += 2) delete dictionary["key" + i];
say("a dictionary", () => has("key2")(dictionary) + " " + has("key3")(dictionary));
delete dictionary.key3;
say("a dictionary loses a name", () => has("key3")(dictionary));

let count = 0;
for (let turn = 0; turn < 40000; turn++) {
  const value: User = turn % 3 ? full : turn % 2 ? bare : { id: turn, name: "t", ok: true, score: 1, count: 1, nothing: null, missing: undefined, nick: "n" };
  if (has("id")(value)) count += 1;
  if (has("nick")(value)) count += 10;
  if (has("absent")(value)) count += 100000000;
  if (turn % 10000 === 9999) collect();
}
lines.push("count " + count);
console.log(lines.join("\n"));
export {};
//// in-missing-names.ts
// `key in object` where no object of the program has ever had a property of that name, asked over and over with the same string. The answer is remembered, and it follows as soon as the object, or an object it inherits from, gets such a property.
declare const aotOperationCount: undefined | ((name: string) => number);
const counted = typeof aotOperationCount === "function" ? aotOperationCount : null;
const entered = () => counted ? counted("operationAOTInByValGeneric") + counted("operationAOTInByValAndCache") : 0;
const join = (...parts: string[]) => parts.join("");
function asks(o: any, k: any): boolean { return k in o; }
function asksWritten(o: any): number { return ("nobodyHasThisOne" in o ? 1 : 0) + ("norThisOne" in o ? 1 : 0); }
const parent: any = JSON.parse('{"inherited":1}');
const child: any = Object.create(parent); child.own = 1;
const plain: any = JSON.parse('{"a":1,"b":2}');
const keys = [join("first", "Unknown"), join("second", "Unknown"), join("third", "Unknown")];
const row = () => [plain, child, parent].map(o => keys.map(k => asks(o, k) ? "1" : "0").join("")).join(" ");
for (let i = 0; i < 4; i++) console.log(row(), asksWritten(plain), asksWritten(child));
const before = entered();
let yes = 0;
for (let i = 0; i < 3000; i++) yes += (asks(plain, keys[i % 3]) ? 1 : 0) + (asks(child, keys[(i + 1) % 3]) ? 1 : 0) + asksWritten(plain) + asksWritten(child);
console.log(yes, counted ? entered() - before < 100 : true);
parent[join("first", "Unknown")] = 1;
console.log(row());
child[join("second", "Unknown")] = 1;
console.log(row());
plain[join("third", "Unknown")] = 1;
console.log(row());
delete parent[keys[0]]; delete child[keys[1]]; delete plain[keys[2]];
console.log(row());
parent[join("nobody", "HasThisOne")] = 1; plain[join("nor", "ThisOne")] = 1;
console.log(asksWritten(plain), asksWritten(child), asksWritten(parent));
Object.setPrototypeOf(child, JSON.parse('{"firstUnknown":1}'));
console.log(row(), asksWritten(child));
let fresh = 0;
for (let i = 0; i < 300; i++) fresh += asks(plain, join("made", "Anew", String(i % 7))) ? 1 : 0;
console.log(fresh);
//// in-name-length-prototype-fields.ts
interface Named { name: string; length: number; prototype?: string; id: number }
interface Maybe { name?: string; length?: number; id: number }
class Thing { name = "thing"; length = 3; static label = "s"; method() { return 1; } }
function hide(value: unknown): any { return value; }
let count = 0;
////= show
const bits = (list: boolean[]) => list.map(b => (b ? "1" : "0")).join("");
function literal(x: any) { return bits(["name" in x, "length" in x, "prototype" in x, "__proto__" in x, "id" in x]); }
const keys = ["name", "length", "prototype", "__proto__", "id", "na" + "me", ["len", "gth"].join("")];
function computed(x: any) { return bits(keys.map(k => k in x)); }
function looped(x: any) { let n = 0; for (let i = 0; i < 50; i++) for (const k of keys) n += k in x ? 1 : 0; return n; }
function reflected(x: any) { return bits(keys.map(k => Reflect.has(x, k))); }
const every = (x: unknown) => [literal(x), computed(x), looped(x), reflected(x)];
const named = (): Named => ({ name: "n", length: 2, id: 1 });
const maybe = (): Maybe => ({ id: 1 });
show("fields called name and length", () => every(named()));
show("an optional field called prototype: absent, set, deleted", () => { const x = named(); const out = [every(x)]; x.prototype = "p"; out.push(every(x)); delete x.prototype; out.push(every(x)); return out; });
show("optional name and length: absent, set, undefined, deleted", () => { const x = maybe(); const out = [every(x)]; x.name = "n"; x.length = 1; out.push(every(x)); x.name = undefined; out.push(every(x)); delete x.name; delete x.length; out.push(every(x)); return out; });
show("objects of one shape in turn, one site", () => { const list: Maybe[] = [{ id: 1 }, { name: "n", id: 1 }, { id: 1 }, { length: 1, id: 1 }, { name: "n", length: 1, id: 1 }, { id: 1 }]; return list.map(every); });
show("an instance, its class, a method", () => { const x = new Thing(); return [every(x), every(Thing), every(x.method)]; });
show("typed objects, functions, arrays and strings' wrappers in turn, one site", () => [named(), function f(a: number, b: number) { return a + b; }, maybe(), [1, 2], named(), () => 1, Object("ab"), class K {}, maybe(), JSON.parse('{"name":1}'), JSON.parse("{}"), new Map(), named()].map(every));
show("a function that has lost its name and length", () => { const f = function g(a: number) { return a; }; const out = [every(f)]; delete hide(f).name; delete hide(f).length; out.push(every(f)); return out; });
show("absent here, the prototype has them", () => { const proto = JSON.parse('{"name":1,"length":2}'); const x = Object.setPrototypeOf(hide(maybe()), proto); const out = [every(x)]; delete proto.name; out.push(every(x)); x.name = "own"; out.push(every(x)); return out; });
show("a null prototype", () => [every(Object.setPrototypeOf(hide(named()), null)), every(Object.setPrototypeOf(hide(maybe()), null))]);
show("extras called name and length on a type without them", () => { const x: { id: number } = { id: 1 }; const out = [every(x)]; hide(x).name = 1; hide(x).length = 2; out.push(every(x)); delete hide(x).name; out.push(every(x)); return out; });
show("frozen", () => [every(Object.freeze(named())), every(Object.freeze(maybe()))]);
show("a typed object as the prototype", () => [every(Object.create(named())), every(Object.create(maybe()))]);
//// in-on-record-with-extra-property.ts
// `in`, Object.hasOwn and hasOwnProperty, asked by untyped code of typed records, without and with a property that the type does not have. Where the answer follows from the object's Structure it is cached: the question does not enter the runtime every time.
declare const aotOperationCount: undefined | ((name: string) => number);
interface Point { x: number; y: number; name: string; note?: string }
function makeTyped(i: number): Point { return { x: i, y: i + 1, name: "p" }; }
function makeMarked(i: number): Point { const made: Point = { x: i, y: i + 1, name: "p" }; (made as unknown as Record<string, number>).mark = i; return made; }
const hasMark: (p: any) => any = function (p: any): any { return "mark" in p ? 1 : 0; };
const hasX: (p: any) => any = function (p: any): any { return "x" in p ? 1 : 0; };
const hasNote: (p: any) => any = function (p: any): any { return "note" in p ? 1 : 0; };
const hasOther: (p: any) => any = function (p: any): any { return "other" in p ? 1 : 0; };
const hasByKey: (p: any, k: any) => any = function (p: any, k: any): any { return k in p ? 1 : 0; };
const ownMark: (p: any) => any = function (p: any): any { return Object.hasOwn(p, "mark") ? 1 : 0; };
const ownX: (p: any) => any = function (p: any): any { return Object.hasOwn(p, "x") ? 1 : 0; };
const ownByMethod: (p: any) => any = function (p: any): any { return p.hasOwnProperty("mark") ? 1 : 0; };
const operations = ["operationAOTInByValAndCache", "operationAOTInByVal", "operationAOTInById", "operationAOTHasOwnProperty"];
const entered = (): number => { let n = 0; if (typeof aotOperationCount === "function") for (const name of operations) n += aotOperationCount(name); return n; };
const keys: string[] = JSON.parse('["mark","x","note","other"]');
for (const [kind, make] of [["typed", makeTyped], ["marked", makeMarked]] as const) {
  const objects: Point[] = [];
  for (let i = 0; i < 100; i++) objects.push(make(i));
  const tests: [string, (p: Point) => number][] = [["mark", hasMark], ["x", hasX], ["note", hasNote], ["other", hasOther], ["key mark", p => hasByKey(p, keys[0])], ["key x", p => hasByKey(p, keys[1])], ["key other", p => hasByKey(p, keys[3])], ["own mark", ownMark], ["own x", ownX], ["method", ownByMethod]];
  for (const [name, test] of tests) {
    let total = 0;
    for (const p of objects) total += test(p);
    const before = entered();
    for (let round = 0; round < 20; round++) for (const p of objects) total += test(p);
    console.log(kind, name, total, entered() - before < 50);
  }
}
interface Changing { x: number; y: number; name: string; memo?: string }
const hasMemo: (p: any) => any = function (p: any): any { return "memo" in p ? 1 : 0; };
function makeChanging(i: number): Changing { const made: Changing = { x: i, y: i + 1, name: "c" }; (made as unknown as Record<string, number>).mark = i; return made; }
function makeUnmarked(i: number): Changing { return { x: i, y: i + 1, name: "c" }; }
const changing = makeChanging(1), other = makeChanging(2), loose: any = changing;
const answers = (p: Changing): string => [hasMark(p), hasByKey(p, keys[0]), ownMark(p), ownByMethod(p), hasX(p), hasMemo(p)].join("");
for (let i = 0; i < 5; i++) answers(changing), answers(other);
console.log(answers(changing), answers(other));
delete loose.mark;
console.log(answers(changing), answers(other));
loose.second = 1;
console.log(answers(changing), answers(other));
loose.mark = 3;
console.log(answers(changing), answers(other), Object.keys(changing).join());
loose.memo = "n";
console.log(answers(changing), answers(other));
delete loose.memo;
console.log(answers(changing), answers(other));
Object.defineProperty(other, "mark", { get() { return 1; }, configurable: true });
console.log(answers(changing), answers(other));
delete (other as any).mark;
console.log(answers(changing), answers(other), answers(makeChanging(3)), answers(makeUnmarked(4)));
//// in-typed-objects.ts
interface T { a?: number; b: number; c?: string; d?: unknown }
class Base { constructor(public v: number) {} method() { return 1; } get twice() { return this.v * 2; } }
class Heir extends Base { w = "w"; #secret = 1; static has(x: object) { return #secret in x; } }
function hide(value: unknown): any { return value; }
let count = 0;
////= show
const bits = (list: boolean[]) => list.map(b => (b ? "1" : "0")).join("");
function literal(x: any) { return bits(["a" in x, "b" in x, "c" in x, "d" in x, "zz" in x, "toString" in x, "constructor" in x, "__proto__" in x, "v" in x, "w" in x, "twice" in x, "method" in x, "length" in x, "0" in x, 0 in x, Symbol.iterator in x, Symbol.toStringTag in x]); }
const keys: (string | number | symbol)[] = ["a", "b", "c", "d", "zz", "toString", "constructor", "__proto__", "v", "w", "twice", "method", "length", "0", 0, Symbol.iterator, Symbol.toStringTag, "a" + "", ["b"].join(""), "x".repeat(3)];
function computed(x: any) { return bits(keys.map(k => k in x)); }
function looped(x: any) { let n = 0; for (let i = 0; i < 50; i++) for (const k of keys) n += k in x ? 1 : 0; return n; }
const every = (x: unknown) => [literal(x), computed(x), looped(x)];
const plain = (...list: [string | symbol, unknown][]): any => { const o = JSON.parse("{}"); for (const [k, v] of list) o[k] = v; return o; };
show("a record", () => every({ b: 1 } as T));
show("optional fields: set, undefined, deleted", () => { const x: T = { a: 1, b: 1 }, y: T = { a: undefined, b: 1 }, z: T = { a: 1, b: 1 }; delete z.a; return [every(x), every(y), every(z)]; });
show("a required field deleted by untyped code", () => { const x: T = { b: 1 }; const first = every(x); try { delete hide(x).b; } catch (e) { return [first, (e as Error).name]; } return [first, every(x)]; });
show("objects of one shape in turn, one site", () => { const list: T[] = [{ b: 1 }, { a: 1, b: 1 }, { b: 1 }, { b: 1, c: "c" }, { a: 1, b: 1, c: "c" }, { b: 1 }]; return list.map(every); });
show("set and deleted between looks", () => { const x: T = { b: 1 }; const out = [every(x)]; x.a = 1; out.push(every(x)); delete x.a; out.push(every(x)); x.a = undefined; out.push(every(x)); return out; });
show("an absent field whose name the prototype has", () => { const x: T = { b: 1 }, y: T = { a: 1, b: 1 }; const proto = plain(["a", 9], ["zz", 9]); Object.setPrototypeOf(x, proto); Object.setPrototypeOf(y, proto); const out = [every(x), every(y)]; delete proto.a; delete proto.zz; out.push(every(x), every(y)); proto.c = 1; out.push(every(x)); return out; });
show("instances", () => [every(new Base(1)), every(new Heir(2)), Heir.has(new Heir(3)), Heir.has(new Base(4))]);
show("extras", () => { const x: T = { b: 1 }; const out = [every(x)]; hide(x).zz = 1; out.push(every(x)); hide(x)[0] = 1; hide(x)[Symbol.iterator] = 1; out.push(every(x)); delete hide(x).zz; out.push(every(x)); return out; });
show("frozen, sealed, closed", () => [Object.freeze({ a: 1, b: 1 } as T), Object.seal({ b: 2 } as T), Object.preventExtensions({ b: 3 } as T)].map(every));
show("a null prototype", () => every(Object.setPrototypeOf({ b: 1 } as T, null)));
show("a typed object as a prototype", () => { const proto: T = { b: 1 }; const child = Object.create(proto), typedChild: { zz: number } = { zz: 1 }; Object.setPrototypeOf(typedChild, proto); const out = [every(child), every(typedChild)]; proto.a = 1; out.push(every(child), every(typedChild)); delete proto.a; out.push(every(child), every(typedChild)); return out; });
show("typed and plain in turn, one site", () => [{ b: 1 } as T, plain(["b", 1]), { a: 1, b: 2 } as T, plain(["a", 1]), new Base(1), [1], { b: 3 } as T, () => 1].map(every));
show("a proxy over a typed object", () => every(new Proxy({ a: 1, b: 1 } as T, {})));
show("not objects", () => [1, "ab", null, undefined].map(x => { try { return literal(x); } catch (e) { return (e as Error).name; } }));
//// index-accessor-on-builtin-prototypes-2.ts
// Another realm gets accessors for indices on its built-in prototypes while prototype objects of this realm inherit from it. What inherits from that realm changes its storage; the arrays of this realm inherit nothing from it and keep theirs (part 2).
// ENV JSC_useDollarVM=1
const vm = (globalThis as any).$vm;
const other = vm.createGlobalObject();
// An object of this realm with indexed storage, that is itself a prototype, and whose chain leaves this realm.
const held = Object.create(other.Object.prototype);
function theirsHaveABadTime(): void {
    held[0] = 1;
    (globalThis as any).child = Object.create(held);
    // And a prototype object of this realm that gets one of theirs for its own.
    const holder: any = {};
    (globalThis as any).heir = Object.create(holder);
    Object.setPrototypeOf(holder, other.Object.prototype);
    vm.haveABadTime(other);
}
type Mixed = number | string | null;
const source: number[] = [4.5, 5.5, 6.5, 7.5];
function rest(...xs: number[]): number[] { return xs; }
const kinds: [string, (n: number) => unknown[]][] = [
    ["doubles", n => { const a: number[] = [n + 0.5, n + 1.5, n + 2.5]; return a; }],
    ["constants", _ => { const a: number[] = [1, 2, 3]; return a; }],
    ["constant doubles", _ => { const a: number[] = [1.5, 2.5]; return a; }],
    ["constant values", _ => { const a: Mixed[] = ["a", null, "b"]; return a; }],
    ["empty of numbers, pushed to", n => { const a: number[] = []; a.push(n + 0.5); a.push(n); return a; }],
    ["empty of numbers, pushed to often", n => { const a: number[] = []; for (let i = 0; i < 9; i++) a.push(n + i); return a; }],
    ["values", n => { const a: Mixed[] = [n, "s", null]; return a; }],
    ["empty of values, pushed to", n => { const a: Mixed[] = []; a.push(n); a.push("s"); return a; }],
    ["empty of values, pushed to often", n => { const a: Mixed[] = []; for (let i = 0; i < 9; i++) a.push(i & 1 ? "s" : n); return a; }],
    ["empty of anything", n => { const a: any[] = []; a.push(n); return a; }],
    ["one", n => [n]], ["four", n => [n, n, n, n]], ["five", n => [n, n, n, n, n]],
    ["spread", n => [n, ...source]], ["copy by spread", _ => [...source]],
    ["slice", _ => source.slice(1)], ["map", n => source.map(x => x + n)], ["filter", _ => source.filter(x => x > 5)], ["concat", n => source.concat([n])],
    ["Array.of", n => Array.of(n, n + 1)], ["Array.from", _ => Array.from(source)], ["new Array(3)", _ => new Array(3)], ["new Array(1, 2)", n => new Array(n, 2)],
    ["rest", n => rest(n, n + 1, n + 2)], ["keys", _ => Object.keys({ a: 1, b: 2 })], ["split", _ => "a,b,c".split(",")],
    ["match", _ => "xaby".match(/a(b)/) as unknown[]], ["match with indices", _ => "xaby".match(/a(b)/d) as unknown[]],
];
function show(when: string): void {
    for (const [name, make] of kinds) console.log(when, name + ":", vm.indexingMode(make(1)).includes("SlowPut") ? "asks its prototypes at every store" : "stores at once", JSON.stringify(make(2)));
}
function many(k: number): number {
    let s = 0;
    for (const [, make] of kinds) for (let i = 0; i < k; i++) s += make(i).length;
    return s;
}
console.log("bad time:", vm.isHavingABadTime(globalThis), vm.isHavingABadTime(other), many(300));
theirsHaveABadTime();
console.log("bad time:", vm.isHavingABadTime(globalThis), vm.isHavingABadTime(other), vm.indexingMode(held));
show("made behind it,");
// Until every free list has run out several times, so that the slow-path operations of the stubs run too.
console.log(many(60000));
show("and still,");
console.log("done");
//// inferred-literal-type-overwritten/main.ts
// `open: false` in a literal without `as const` keeps the type `false` where the literal is checked against a type that names literal types. That type is inferred, not annotated, so untyped code may store `true`.
import { open, store } from "./untyped.js";

type State = { open: boolean; items: string[] };
function describe(s: State): string {
  return (s.open ? "open" : "closed") + " " + s.items.length;
}

function create<T extends State>(init: T): T {
  return init;
}
const created = create({ open: false, items: [] });
console.log("a bound that names it:", open(created), created.open, describe(created));

function keep<T extends { [name: string]: U | object }, U extends boolean | string | number>(init: T): T {
  return init;
}
const kept = keep({ open: false, mode: "a", count: 0, items: [] as string[] });
console.log("an index signature of primitives:", open(kept), store(kept, "mode", "b"), store(kept, "count", 2), kept.open, kept.mode, kept.count);

const INITIAL = Object.freeze({ open: false, items: [] as string[] });
function fresh() {
  return { ...INITIAL };
}
const copy = fresh();
console.log("a copy of a frozen literal:", open(copy), copy.open, describe(copy), INITIAL.open);

const again = { ...fresh(), items: ["x"] };
console.log("a copy of the copy:", open(again), again.open, describe(again));

function holder<T extends { open: boolean | null }>(init: T): { current: T } {
  return { current: init };
}
const held = holder({ open: null });
console.log("null alone:", open(held.current), held.current.open);

const list = [create({ open: false, items: [] }), create({ open: false, items: ["y"] })];
for (const each of list) console.log("in an array:", open(each), each.open ? "open" : "closed", describe(each));

const read = create({ open: false, items: [] });
open(read);
const { open: taken } = read;
const chosen = read.open || "closed";
console.log("read by typed code:", taken, chosen, `${read.open}`, [read.open].join(), read.open === false, read.open ?? "none");
//// inferred-literal-type-overwritten/untyped.js
export function store(object, name, value) {
  object[name] = value;
  return object[name];
}
export function open(object) {
  object.open = true;
  return object.open;
}
//// inferred-type-objects-passed-to-js/library.js
export function alter(target) { target.more = { n: 2 }; target.count = "many"; return target; }
export function spoil(point) { point.x = "text"; return point; }
export function fill(list) { list.push({ x: "pushed" }); list[0] = { y: 1 }; return list; }
export function call(callback) { return callback({ x: "given", y: [1] }); }
export function put(map) { map.set("k", { x: null }); return map; }
export class Holder { constructor(held) { this.held = held; } change() { this.held.x = { deep: true }; return this; } }
