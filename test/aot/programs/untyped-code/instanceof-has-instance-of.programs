//// json-stringify-fresh-literal.js
// JSON.stringify of a fresh plain object literal is serialized from the values it was created with, and the object is only created on the slow path. Any other use of the object, and any mutation before the call, must still be observed.
function direct(name, sides) { return JSON.stringify({ name, sides }); }
function named(name, sides) { const row = { name, sides }; return JSON.stringify(row); }
function nested(name, sides) { return JSON.stringify({ first: { name, sides }, second: null, list: [sides, name] }); }
function changed(name, sides) { const row = { name, sides }; row.sides = sides + 1; return JSON.stringify(row); }
function grown(name, sides) { const row = { name, sides }; row.label = "late"; return JSON.stringify(row); }
function shrunk(name, sides) { const row = { name, sides, label: "early" }; delete row.label; return JSON.stringify(row); }
function touch(row) { row.name = row.name + "!"; }
function handedOn(name, sides) { const row = { name, sides }; touch(row); return JSON.stringify(row); }
function twice(name, sides) { const row = { name, sides }; return JSON.stringify(row) + JSON.stringify(row); }
function usedAfter(name, sides) { const row = { name, sides }; const text = JSON.stringify(row); return text + Object.keys(row).length; }
function usedInAnotherBlock(name, sides) { const row = { name, sides }; const text = JSON.stringify(row); if (sides > 2) return text + row.name; return text; }
function returned(name, sides) { const row = { name, sides }; kept = JSON.stringify(row); return row; }
function undefinedMember(name, sides) { return JSON.stringify({ name, next: undefined, sides, label: undefined }); }
function withGetter(name, sides) { return JSON.stringify({ name, get sides() { return sides * 2; } }); }
function withToJSON(name, sides) { return JSON.stringify({ name, sides, toJSON() { return "by toJSON " + name; } }); }
function withFunction(name, sides) { return JSON.stringify({ name, sides, call() { return 1; } }); }
function withSymbol(name, sides) { return JSON.stringify({ name, sides, mark: Symbol.iterator }); }
function withBigInt(name, sides) { try { return JSON.stringify({ name, sides, big: 1n }); } catch (error) { return error.constructor.name; } }
function indented(name, sides) { return JSON.stringify({ name, sides }, null, 1); }
function inTry(name, sides) { try { return JSON.stringify({ name, sides }); } catch { return "caught"; } }
function sharedInner(name, sides) { const inner = { name, sides }; return JSON.stringify({ first: inner, second: inner }); }
let escaped;
function innerEscapes(name, sides) { const inner = { name, sides }; escaped = inner; return JSON.stringify({ inner }) + (escaped === inner); }
function innerReadLater(name, sides) { const inner = { name, sides }; const text = JSON.stringify({ inner }); return text + inner.name; }
function threeLevels(name, sides) { return JSON.stringify({ a: { b: { name, sides }, sides }, name }); }
function fourLevels(name, sides) { return JSON.stringify({ a: { b: { c: { name, sides }, sides }, name }, sides }); }
function outerEscapes(name, sides) { const outer = { inner: { name, sides } }; const text = JSON.stringify(outer); return text + outer.inner.sides; }
function siblings(name, sides) { return JSON.stringify({ first: { name, sides }, second: { name: name + "2", sides: sides + 1 }, third: { label: name } }); }
let kept = "";
const writers = [direct, named, nested, changed, grown, shrunk, handedOn, twice, usedAfter, usedInAnotherBlock, undefinedMember, withGetter, withToJSON, withFunction, withSymbol, withBigInt, indented, inTry, sharedInner, innerEscapes, innerReadLater, threeLevels, fourLevels, outerEscapes, siblings];
const names = ["plain", "", 'quo"te', "line\nbreak", "é世😀", "\ud800", "a".repeat(300), 7, null, undefined, true, { inner: 1 }, [1, 2]];
const numbers = [0, -0, 1, 3, 2.5, -7, 1e21, 1e-7, NaN, Infinity, 2147483648, "text", null, undefined];
for (const write of writers) {
  for (const name of names) console.log(write(name, 3));
  for (const sides of numbers) console.log(write("n", sides));
}
const row = returned("r", 1);
console.log(kept, row.name, row.sides);
let total = 0;
for (let round = 0; round < 30000; round++) total += writers[round % writers.length]("r" + (round & 15), round / 4).length;
console.log(total);
//// json-stringify-nested-literals.js
const writersFailed = () => Number(/(\d+)\tJSONWriterFailed/.exec(aotRuntimeCounters())[1]);
function measure(label, run) {
    const finished = (aotOperationCount("operationAOTJSONWriterFinish") - writersFailed());
    const handedOver = aotOperationCount("operationAOTJSONAppendValue");
    let text = "";
    for (let i = 0; i < 100; i++) text = run(i);
    console.log(label + ": " + text + ": " + ((aotOperationCount("operationAOTJSONWriterFinish") - writersFailed()) - finished) + " texts finished by compiled code, " + (aotOperationCount("operationAOTJSONAppendValue") - handedOver) + " values handed to the runtime");
}
let held;
function hold(value) { held = value; return value; }

measure("one within", i => JSON.stringify({ ok: true, data: { id: i | 0, on: (i & 1) === 0 } }));
measure("two within", i => JSON.stringify({ a: { x: i | 0 }, b: { y: (i | 0) + 1 } }));
measure("two levels down", i => JSON.stringify({ a: { b: { c: i | 0 } } }));
measure("three levels down", i => JSON.stringify({ a: { b: { c: { d: i | 0 } } } }));
measure("none within has members", () => JSON.stringify({ a: {}, b: {} }));
measure("undefined within", i => JSON.stringify({ a: { x: undefined, y: i | 0 }, b: { z: undefined } }));
measure("in constants", i => { const inner = { x: i | 0 }; const outer = { inner }; return JSON.stringify(outer); });
measure("stored to before it is held", i => { const inner = { x: i | 0 }; inner.y = 2; return JSON.stringify({ inner }); });

measure("stored to after it is held", i => { const inner = { x: i | 0 }; const outer = { inner }; inner.y = 2; return JSON.stringify(outer); });
measure("changed after it is held", i => { const inner = { x: i | 0 }; const outer = { inner }; inner.x = -1; return JSON.stringify(outer); });
measure("changed through what holds it", i => { const outer = { inner: { x: i | 0 } }; outer.inner.x = -1; return JSON.stringify(outer); });
measure("held twice", i => { const inner = { x: i | 0 }; return JSON.stringify({ a: inner, b: inner }); });
measure("kept elsewhere and changed there", i => { const inner = hold({ x: i | 0 }); held.late = 1; return JSON.stringify({ inner }); });
measure("kept elsewhere afterwards", i => { const inner = { x: i | 0 }; const text = JSON.stringify({ inner }); hold(inner); return text; });
measure("with toJSON within", i => JSON.stringify({ a: { x: i | 0, toJSON() { return "mine"; } } }));
measure("with an index within", i => JSON.stringify({ a: { b: 1, 0: i | 0 } }));
measure("with a getter within", i => JSON.stringify({ a: { get x() { return i | 0; } } }));
measure("one of two within", i => JSON.stringify({ a: i & 1 ? { odd: i | 0 } : { even: i | 0 } }));
measure("holds itself", i => { const inner = { x: i | 0 }; inner.self = inner; try { return JSON.stringify({ inner }); } catch (error) { return error.constructor.name; } });
//// keyed-definition-then-put-with-setter.js
// Definitions and stores by a key cell share one table: an entry filled by one must stay right for the other.
class Base {
  constructor(target) {
    if (target) return target;
  }
}

const store = (object, key, value) => {
  object[key] = value;
};
const hasOwn = (object, key) => Object.prototype.hasOwnProperty.call(object, key);

function run(label, key, setterInstalled) {
  const setterCalls = [];
  class Keyed extends Base {
    [key] = 1;
  }
  const installSetter = () =>
    Object.defineProperty(Keyed.prototype, key, {
      configurable: true,
      get() {
        return "from the getter";
      },
      set(value) {
        setterCalls.push(value);
      },
    });
  const createBare = () => Reflect.construct(Base, [], Keyed);

  if (setterInstalled === "before") installSetter();
  let ownAfterDefinition = 0;
  for (let i = 0; i < 100; i++) if (hasOwn(new Keyed(), key)) ownAfterDefinition++;
  if (setterInstalled === "after") installSetter();

  let ownAfterStore = 0;
  let lastRead;
  for (let i = 0; i < 100; i++) {
    const object = createBare();
    store(object, key, 2);
    if (hasOwn(object, key)) ownAfterStore++;
    lastRead = object[key];
  }
  console.log(label, "definitions", ownAfterDefinition, "own after store", ownAfterStore, "setter calls", setterCalls.length, "read", lastRead);

  const owner = new Keyed();
  for (let i = 0; i < 100; i++) store(owner, key, 1);
  new Keyed(owner);
  console.log(label, "replaced", owner[key], "setter calls", setterCalls.length);

  const hidden = createBare();
  Object.defineProperty(hidden, key, { value: 0, writable: true, enumerable: false, configurable: true });
  for (let i = 0; i < 100; i++) store(hidden, key, 5);
  const beforeDefinition = Object.getOwnPropertyDescriptor(hidden, key);
  new Keyed(hidden);
  const afterDefinition = Object.getOwnPropertyDescriptor(hidden, key);
  console.log(label, "hidden", beforeDefinition.enumerable, beforeDefinition.value, afterDefinition.enumerable, afterDefinition.value);
}

for (const setterInstalled of ["before", "after", "never"]) {
  run("symbol " + setterInstalled, Symbol("k"), setterInstalled);
  run("string " + setterInstalled, ["built", setterInstalled].join("-"), setterInstalled);
}
