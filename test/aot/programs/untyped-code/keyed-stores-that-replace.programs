//// large-objects-spread-into-literal.js
// Object literals that spread large objects: hundreds of properties, duplicate names, and fields between and after the spreads.
const lines = [];
const digest = o => { let h = 0, n = 0; for (const k in o) { const t = k + "=" + o[k] + ";"; for (let i = 0; i < t.length; i++) h = (h * 31 + t.charCodeAt(i)) | 0; n++; } return n + ":" + h; };
const make = (prefix, count, from = 0) => { const o = {}; for (let i = from; i < from + count; i++) o[prefix + i] = prefix + i; return o; };
const a10 = { a0: 0, a1: 1, a2: 2, a3: 3, a4: 4, a5: 5, a6: 6, a7: 7, a8: 8, a9: 9 }, b10 = { a5: 5, a6: 6, a7: 7, a8: 8, a9: 9, a10: 10, a11: 11, a12: 12, a13: 13, a14: 14 };
lines.push("10 " + digest({ ...a10 }) + " " + digest({ ...a10, ...b10 }) + " " + digest({ first: 1, ...a10, a3: "over", ...b10, last: 2 }) + " " + Object.keys({ ...b10, ...a10 }).slice(0, 3).join() + " " + Object.keys({ z: 0, ...a10, z: 1 })[0]);
