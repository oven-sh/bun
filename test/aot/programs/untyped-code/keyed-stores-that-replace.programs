//// method-lookup-by-holder.js
// o.m() at one untyped call site, by where the method is stored: own or inherited, inline or out of line, near or far up the prototype chain.
// Then receivers that need the slow path at the same site, and methods that change between two calls.
const lines = [];

function callWithTwo(o, a, b) { return o.m(a, b); }
function callWithEight(o, a, b, c, d, e, f, g, h) { return o.m(a, b, c, d, e, f, g, h); }
const sites = [callWithTwo, callWithEight];

function attempt(call, receiver) {
  try {
    return call(receiver, 1, 2, 3, 4, 5, 6, 7, 8);
  } catch (error) {
    return error.constructor.name;
  }
}

function method(label) {
  return function (...values) { return `${label}, this ${this.id}, arguments ${values.join("")}`; };
}

// Object.create and computed property names produce ordinary objects with out-of-line storage, whatever layout the compiler picks for literals.
function create(prototype, id, fillers = 0) {
  const object = Object.create(prototype);
  object.id = id;
  for (let i = 0; i < fillers; i++) object["filler" + i] = i;
  return object;
}

function createOwn() {
  const inline = create(Object.prototype, "a");
  inline.m = method("own inline");
  const outOfLine = create(Object.prototype, "b", 20);
  outOfLine.m = method("own out of line");
  return [
    { name: "own inline", receiver: inline },
    { name: "own out of line", receiver: outOfLine },
  ];
}

function createInherited() {
  const cases = [];
  for (const [name, fillers] of [["prototype inline", 0], ["prototype out of line", 20], ["prototype far out of line", 160]]) {
    const holder = create(Object.prototype, "holder", fillers);
    holder.m = method(name);
    cases.push({ name, holder, receiver: create(holder, "c" + fillers) });
  }
  const holder = create(Object.prototype, "holder");
  holder.m = method("two levels up");
  const middle = create(holder, "middle");
  cases.push({ name: "two levels up", holder, middle, receiver: create(middle, "d") });
  return cases;
}

let getterReads = 0;
const trapped = [];

function createOthers() {
  const ownGetter = create(Object.prototype, "e");
  Object.defineProperty(ownGetter, "m", { get() { getterReads++; return method("own getter"); } });
  const getterHolder = create(Object.prototype, "holder");
  Object.defineProperty(getterHolder, "m", { get() { getterReads++; return method("inherited getter"); } });
  const number = create(Object.prototype, "g");
  number.m = 1;
  const proxy = new Proxy(create(Object.prototype, "h"), {
    get(target, key, receiver) {
      trapped.push(key);
      return key === "m" ? method("proxy") : Reflect.get(target, key, receiver);
    },
  });
  return [
    { name: "own getter", receiver: ownGetter },
    { name: "inherited getter", receiver: create(getterHolder, "f") },
    { name: "absent", receiver: create(Object.prototype, "i") },
    { name: "the number 1", receiver: number },
    { name: "string receiver", receiver: "text" },
    { name: "proxy receiver", receiver: proxy },
    { name: "null receiver", receiver: null },
  ];
}

const found = [...createOwn(), ...createInherited()];
const all = [...found, ...createOthers()];
const outcomes = all.map(() => new Set());
for (let round = 0; round < 6; round++) {
  for (let i = 0; i < all.length; i++) {
    for (const call of sites) outcomes[i].add(attempt(call, all[i].receiver));
  }
}
all.forEach(({ name }, i) => lines.push(`${name}: ${[...outcomes[i]].join(" | ")}`));
lines.push(`getters read ${getterReads} times, ${trapped.length} traps for ${[...new Set(trapped)].join()}`);

function summarize(results) {
  const runs = [];
  for (const result of results) {
    const last = runs[runs.length - 1];
    if (last && last.result === result) last.count++;
    else runs.push({ result, count: 1 });
  }
  return runs.map(run => `${run.count} x ${run.result}`).join(", then ");
}

// The other receivers go through the site between two calls, so that it never settles on one structure.
function callAcrossChange(name, receiver, change) {
  const results = [];
  for (let round = 0; round < 6; round++) {
    if (round === 3) change();
    for (const other of found) attempt(callWithTwo, other.receiver);
    results.push(attempt(callWithTwo, receiver));
  }
  lines.push(`${name}: ${summarize(results)}`);
}

for (const { name, holder, receiver } of createInherited())
  callAcrossChange(`${name}, replaced`, receiver, () => { holder.m = method("replacement"); });
for (const { name, holder, receiver } of createInherited())
  callAcrossChange(`${name}, deleted`, receiver, () => { delete holder.m; });
for (const { name, holder, receiver } of createInherited())
  callAcrossChange(`${name}, redefined as a getter`, receiver, () => { Object.defineProperty(holder, "m", { get() { return method("getter"); } }); });
for (const { name, receiver } of createInherited())
  callAcrossChange(`${name}, shadowed by an own method`, receiver, () => { receiver.m = method("own"); });
for (const { name, holder, receiver } of createInherited())
  callAcrossChange(`${name}, holder grows`, receiver, () => { for (let i = 0; i < 40; i++) holder["late" + i] = i; });
{
  const { middle, receiver } = createInherited()[3];
  callAcrossChange("two levels up, shadowed one level up", receiver, () => { middle.m = method("one level up"); });
}
{
  const [first, second] = createInherited();
  callAcrossChange("prototype inline, receiver gets another prototype", first.receiver, () => { Object.setPrototypeOf(first.receiver, second.holder); });
}

console.log(lines.join("\n"));
//// method-read-before-arguments.ts
// In `a.m(f())` the method is read before the arguments are evaluated, so a call to `f` that replaces `a.m` does not change what is called.
declare const console: { log(...values: unknown[]): void };
const out: string[] = [];
const hide = (v: unknown): any => v;
let entered = 0;
function replacement(this: unknown): unknown { entered++; return "replaced"; }
type Change = (a: any, name: string) => void;
const changes: [string, Change][] = [
    ["own property", (a, name) => { a[name] = replacement; }],
    ["another prototype", (a, name) => { const p = Object.create(Array.prototype); p[name] = replacement; Object.setPrototypeOf(a, p); }],
    ["a property that overrides nothing", a => { a.extra = 1; }],
];
let change: Change = () => {}; let changedName = "";
function during<T>(a: unknown, value: T): T { change(a, changedName); return value; }
const show = (v: unknown): string => Array.isArray(v) ? "[" + Array.prototype.join.call(v) + "]" : typeof v === "object" && v !== null ? "object" : String(v);
////= on	Any: [string, (a: any
////= on	Typed: [string, (a: number[]
function run(call: (a: any) => unknown, name: string, how: Change): string {
    const a = [1, 2, 3]; change = how; changedName = name; entered = 0;
    let r: string; try { r = show(call(a)); } catch (e) { r = (e as Error).name; }
    change = () => {};
    return r + " " + show(a) + " " + entered;
}
for (const [name, call] of onAny) out.push("any " + name + ": " + changes.map(([how, c]) => how + ": " + run(call, name, c)).join(" | "));
for (const [name, call] of onTyped) out.push("number[] " + name + ": " + changes.map(([how, c]) => how + ": " + run(hide(call), name, c)).join(" | "));
// A receiver typed `any`: an override that is there from the start runs.
for (const [name, call] of onAny) out.push("any, overridden from the start, " + name + ": " + changes.slice(0, 2).map(([how, c]) => { const a = [1, 2, 3]; c(a, name); entered = 0; change = () => {}; let r: string; try { r = show(call(a)); } catch (e) { r = (e as Error).name; } return how + ": " + r + " " + entered; }).join(" | "));
{ const a: any = [1, 2, 3, 4]; a.length = 1; a.push = replacement; entered = 0; out.push("any, room and its own push: " + show(a.push(3)) + " " + show(a) + " " + entered); }
// The arguments take an override away again: what was read is called.
for (const [name, call] of onAny) { const a: any = [1, 2, 3]; a[name] = replacement; change = (x, n) => { delete x[n]; }; changedName = name; entered = 0; let r: string; try { r = show(call(a)); } catch (e) { r = (e as Error).name; } change = () => {}; out.push("any, the override deleted by the arguments, " + name + ": " + r + " " + entered); }
console.log(out.join("\n"));
//// method-read-before-suspension.ts
// `x.m(await y)` and `x.m(yield y)`: the method is read before the function is suspended, and the receiver may be altered while it is.
const notes: string[] = [];
function wrapper(said: string, m: string, home: any): any { return function (this: any, ...all: any[]) { notes.push(said + " " + m); return home[m].apply(this, all); }; }
function later(v: any): Promise<any> { notes.push("awaits"); return new Promise(resolve => setTimeout(() => resolve(v), 0)); }
function pressure(): number { let n = 0; for (let i = 0; i < 2000; i++) n += [i, i + 1, { i }].length; return n; }
async function joinAwaited(x: any, sep: any): Promise<any> { const r = x.join(await later(sep)); return [r]; }
async function fillAwaited(x: any, v: any): Promise<any> { const r = x.fill(await later(v)); return [r]; }
async function startsWithAwaited(x: any, v: any): Promise<any> { const r = x.startsWith(await later(v)); return [r]; }
async function padStartAwaited(x: any, v: any): Promise<any> { const r = x.padStart(await later(v), "*"); return [r]; }
async function joinAwaitedInLoop(x: any, sep: any): Promise<any> { let r: any; for (let i = 0; i < 2; i++) r = x.join(await later(sep)); return [r]; }
async function joinAwaitedWatched(x: any, sep: any): Promise<any> { try { const r = x.join(await later(sep)); return [r]; } catch (e) { return "caught " + (e as Error).constructor.name; } }
async function typedSliceAwaited(x: number[], v: number): Promise<number> { const r = x.slice(await later(v)); return r.length; }
async function typedGetAwaited(x: Map<string, number>, v: string): Promise<number | undefined> { const r = x.get(await later(v)); return r; }
function* joinYielded(x: any): Generator<any, any, any> { const r = x.join(yield "wants a separator"); return [r]; }
function* fillYielded(x: any): Generator<any, any, any> { const r = x.fill(yield "wants a value"); return [r]; }
const lines: string[] = [];
const show = (v: unknown): string => JSON.stringify(v, (k, x) => x === undefined ? "undefined" : x instanceof Map ? [...Map.prototype.entries.call(x)] : x);
async function attempt(label: string, make: () => any, run: (x: any) => Promise<any>, alter: (x: any) => void): Promise<void> {
    notes.length = 0;
    const x = make();
    let said: string;
    try { const pending = run(x); alter(x); pressure(); said = show(await pending); } catch (e) { said = "THROWS " + (e as Error).constructor.name; }
    lines.push(label + " | " + said + " | " + notes.join(", ") + " | " + show(x));
}
const nothing = (x: any) => { };
const own = (m: string) => (x: any) => { notes.push("alters"); if (typeof x === "object" && x) x[m] = wrapper("its own", m, Object.getPrototypeOf(x)); };
const prototype = (m: string) => (x: any) => { notes.push("alters"); if (typeof x === "object" && x) { const home = Object.getPrototypeOf(x); const p = Object.create(home); p[m] = wrapper("inherited", m, home); Object.setPrototypeOf(x, p); } };
const withOwn = (make: () => any, m: string) => () => { const x = make(); x[m] = wrapper("its own from the start", m, Object.getPrototypeOf(x)); return x; };
const array = () => [1, 2, 3];
for (const [name, alter] of [["left alone", nothing], ["given its own", own("join")], ["given another prototype", prototype("join")]] as Array<[string, (x: any) => void]>) {
    await attempt("join awaited, " + name, array, x => joinAwaited(x, "-"), alter);
    await attempt("join awaited, its own from the start, " + name, withOwn(array, "join"), x => joinAwaited(x, "-"), alter);
    await attempt("join awaited in a loop, " + name, array, x => joinAwaitedInLoop(x, "-"), alter);
    await attempt("join awaited, watched, " + name, array, x => joinAwaitedWatched(x, "-"), alter);
    await attempt("join awaited, watched, undefined, " + name, () => undefined, x => joinAwaitedWatched(x, "-"), alter);
    await attempt("join awaited, another object, " + name, () => ({ join(s: string) { notes.push("another's join"); return "joined by " + s; } }), x => joinAwaited(x, "-"), alter);
}
for (const [name, alter] of [["left alone", nothing], ["given its own", own("fill")], ["given another prototype", prototype("fill")]] as Array<[string, (x: any) => void]>)
    await attempt("fill awaited, " + name, array, x => fillAwaited(x, 7), alter);
await attempt("startsWith awaited", () => "abc", x => startsWithAwaited(x, "a"), nothing);
await attempt("padStart awaited", () => "abc", x => padStartAwaited(x, 6), nothing);
await attempt("startsWith awaited, null", () => null, x => startsWithAwaited(x, "a"), nothing);
for (const [name, alter] of [["left alone", nothing], ["given its own", own("slice")], ["given another prototype", prototype("slice")]] as Array<[string, (x: any) => void]>)
    await attempt("typed slice awaited, " + name, array, x => typedSliceAwaited(x, 1), alter);
for (const [name, alter] of [["left alone", nothing], ["given its own", own("get")], ["given another prototype", prototype("get")]] as Array<[string, (x: any) => void]>)
    await attempt("typed get awaited, " + name, () => new Map([["a", 1]]), x => typedGetAwaited(x, "a"), alter);
////= for-6	join")], ["given another prototype", prototype("join	joinYielded	"join yielded, "	"+"
////= for-6	fill	fillYielded	"fill yielded, "	9
console.log(lines.join("\n"));
//// method-resolved-once-any-class.js
// The first call of a method by name asks the run time for it, and no later call does, whatever the class looks like: the prototype of the class need not make its members for that.
// Only the jsc shell can count. Elsewhere the program checks the answers alone.
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;
const asked = () => count("operationAOTGetByIdAndCache");
class Plain { f = 0; m1() { return 1; } m2() { return 2; } m3() { return 3; } m4() { return 4; } m5() { return 5; } m6() { return 6; } }
class WithGetter { f = 0; m1() { return 1; } m2() { return 2; } m3() { return 3; } m4() { return 4; } m5() { return 5; } get g() { return 6; } }
class Parent { f = 0; m1() { return 1; } m2() { return 2; } m3() { return 3; } m4() { return 4; } m5() { return 5; } m6() { return 6; } }
class Child extends Parent { h = 1; c1() { return 10; } c2() { return 2; } c3() { return 3; } c4() { return 4; } c5() { return 5; } }
class CallsAnother { f = 0; m1() { return this.m2(); } m2() { return 2; } m3() { return 3; } m4() { return 4; } m5() { return 5; } m6() { return 6; } }
class Few { f = 0; m1() { return 1; } m2() { return 2; } }
function calls(object, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += object.m1(); return sum; }
function callsOfChild(object, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += object.c1(); return sum; }
const lines = [];
let most = 0;
function measure(label, run) {
  const before = asked();
  const result = run();
  most = Math.max(most, asked() - before);
  lines[lines.length] = label + " " + result;
}
const plain = new Plain(), withGetter = new WithGetter(), parent = new Parent(), child = new Child(), callsAnother = new CallsAnother(), few = new Few();
measure("plain", () => calls(plain, 500));
measure("with a getter", () => calls(withGetter, 500));
measure("own of a child", () => callsOfChild(child, 500));
measure("inherited by a child", () => calls(child, 500));
measure("of the parent", () => calls(parent, 500));
measure("that calls another", () => calls(callsAnother, 500));
measure("of a class of two", () => calls(few, 500));
console.log(lines.join(" | "));
console.log(most <= 3 ? "no 500 calls asked the run time more than three times" : "500 calls asked the run time " + most + " times");
console.log(plain.m6(), withGetter.g, child.m6(), child.c5(), few.m2(), Object.getOwnPropertyNames(Plain.prototype).join(), plain.m1 === Plain.prototype.m1, calls(plain, 10));
//// method-tail-calls.js
"use strict";
// `return o.m(..)` on receivers of no type: own methods, inherited ones, methods out of line, getters that yield functions, primitives as receivers, bound and host functions, proxies,
// callable and not; what is no function throws a TypeError from a frame that is still there; a chain of a million such calls does not use up the stack.
const lines = [];
function call0(o) { return o.run(); }
function call1(o, a) { return o.run(a); }
function call2(o, a, b) { return o.run(a, b); }
function call4(o, a, b, c, d) { return o.run(a, b, c, d); }
function callOther(o, a) { return o.other(a); }
function callToString(o) { return o.toString(); }
function callLength(o, a) { return o.slice(a); }
class Base { run(...all) { return "Base.run(" + all.join() + ") of " + this.tag; } other(a) { return "Base.other " + a; } }
class Derived extends Base { constructor(tag) { super(); this.tag = tag; } }
const own = { tag: "own", run(...all) { return "own.run(" + all.join() + ") of " + this.tag; } };
const wide = { tag: "wide" }; for (let i = 0; i < 40; i++) wide["p" + i] = i; wide.run = function (...all) { return "wide.run(" + all.join() + ") of " + this.tag; };
const byGetter = { tag: "getter", get run() { lines.push("the getter runs"); return function (...all) { return "got.run(" + all.join() + ") of " + this.tag; }; } };
const bound = { tag: "unused", run: function (...all) { return "bound.run(" + all.join() + ") of " + this.tag; }.bind({ tag: "bound" }) };
const host = { run: Math.max };
const proxied = { tag: "proxied", run: new Proxy(function (...all) { return "target(" + all.join() + ") of " + this.tag; }, {}) };
const throwing = { get run() { throw new RangeError("the getter throws"); } };
const receivers = [new Derived("derived"), own, wide, byGetter, bound, host, proxied];
for (let round = 0; round < 3; round++) for (const o of receivers) { const line = [call0(o), call1(o, 1), call2(o, 1, 2), call4(o, 1, 2, 3, 4)].join(" | "); if (round === 2) lines.push(line); }
function attempt(what, act) { try { lines.push(what + ": " + act()); } catch (error) { lines.push(what + ": " + error.constructor.name + " | seen in the trace: " + /call[0-9A-Z]/.test(String(error.stack))); } }
for (const [what, o] of [["no method", {}], ["a number for a method", { run: 5 }], ["an object for a method", { run: {} }], ["null for a method", { run: null }], ["a string for a method", { run: "text" }], ["a throwing getter", throwing], ["undefined", undefined], ["null", null], ["a number", 5], ["a string", "text"]]) {
  attempt(what + ", no argument", () => call0(o)); attempt(what + ", two", () => call2(o, 1, 2)); }
function tail0(o) { return o.run(); }
function tail1(o, a) { return o.run(a); }
function tail2(o, a, b) { return o.run(a, b); }
function tailNumber(o, a) { return o.run(a * 0.5); }
const byTable = [tail0, tail1, tail2, tailNumber];
for (let round = 0; round < 3; round++) for (const o of receivers) { const line = [byTable[0](o), byTable[1](o, 1), byTable[2](o, 1, 2), byTable[3](o, 3)].join(" | "); if (round === 2) lines.push("by table: " + line); }
for (const o of [{}, { run: 5 }, { run: {} }, undefined, 5]) for (const f of byTable) attempt("by table", () => f(o, 1, 2));
attempt("other", () => callOther(new Derived("d"), 7)); attempt("other of own", () => callOther(own, 7));
for (const v of [5, "text", true, 10n, Symbol.iterator, [1, 2], { a: 1 }]) attempt("toString of " + typeof v, () => callToString(v));
attempt("slice of a string", () => callLength("abcdef", 2)); attempt("slice of an array", () => callLength([1, 2, 3], 1).join());
const counter = { down(n, sum) { if (n === 0) return sum; return this.down(n - 1, sum + n); } };
function start(o, n) { return o.down(n, 0); }
attempt("a million deep", () => start(counter, 1000000));
const pair = { even(n) { if (n === 0) return "even"; return this.odd(n - 1); }, odd(n) { if (n === 0) return "odd"; return this.even(n - 1); } };
attempt("two methods in turn", () => pair.even(300001));
console.log(lines.join("\n"));
//// methods-as-out-of-line-own-properties.js
// Calls `object.method(..)` where the method is an own property kept outside the object's cell, next to methods that are inherited, kept in the cell, absent, accessors or no functions, under names used at many places.
const lines = [];
function say(...parts) {
  lines.push(parts.map(part => (typeof part === "string" ? part : JSON.stringify(part))).join(" "));
}
////= attempt

function makeWide(tag) {
  const wide = {};
  for (let i = 0; i < 12; ++i) wide["filler" + i] = i;
  wide.write = function (chunk) { return tag + ":" + chunk + ":" + this.filler3; };
  wide.end = function (a, b) { return tag + "/" + a + "/" + b; };
  wide.flush = () => tag;
  wide.three = function (a, b, c) { return [tag, a, b, c, this === wide]; };
  return wide;
}
class Base {
  write(chunk) { return "base:" + chunk; }
  end(a, b) { return "base/" + a + "/" + b; }
  flush() { return "base"; }
  three(a, b, c) { return ["base", a, b, c]; }
}
class Derived extends Base {}
const narrow = { write(chunk) { return "narrow:" + chunk; }, end(a, b) { return "narrow/" + a + "/" + b; }, flush() { return "narrow"; }, three(a, b, c) { return ["narrow", a, b, c]; } };
const bound = makeWide("unbound");
bound.write = bound.write.bind({ filler3: "bound this" });
bound.end = Math.max;
const withGetter = makeWide("getter");
Object.defineProperty(withGetter, "write", { get() { return chunk => "got:" + chunk; } });
const replaced = makeWide("first");

const w01 = o => o.write(1), w02 = o => o.write(2), w03 = o => o.write(3), w04 = o => o.write(4), w05 = o => o.write(5), w06 = o => o.write(6), w07 = o => o.write(7), w08 = o => o.write(8);
const w09 = o => o.write(9), w10 = o => o.write(10), w11 = o => o.write(11), w12 = o => o.write(12), w13 = o => o.write(13), w14 = o => o.write(14), w15 = o => o.write(15), w16 = o => o.write(16);
const writers = [w01, w02, w03, w04, w05, w06, w07, w08, w09, w10, w11, w12, w13, w14, w15, w16];
function useAll(o) {
  return [o.write("a"), o.write("b"), o.write("c"), o.write("d"), o.end(1, 2), o.end(3, 4), o.end(5, 6), o.flush(), o.flush(), o.flush(), o.three(1, 2, 3), o.three(4, 5, 6),
    o.write("e"), o.write("f"), o.write("g"), o.write("h"), o.end(7, 8), o.end(9, 10), o.flush(), o.three(7, 8, 9), o.write("i"), o.write("j"), o.write("k"), o.write("l"),
    o.write("m"), o.write("n"), o.write("o"), o.write("p"), o.write("q"), o.write("r"), o.write("s"), o.write("t"), o.write("u"), o.write("v"), o.write("w"), o.write("x"),
    o.write("y"), o.write("z"), o.write("A"), o.write("B"), o.write("C"), o.write("D"), o.write("E"), o.write("F"), o.write("G"), o.write("H"), o.write("I"), o.write("J"),
    o.write("K"), o.write("L"), o.write("M"), o.write("N"), o.write("O"), o.write("P"), o.write("Q"), o.write("R"), o.write("S"), o.write("T"), o.write("U"), o.write("V")].join("|").length;
}

const receivers = [makeWide("one"), new Base(), new Derived(), narrow, bound, withGetter, makeWide("two")];
for (const receiver of receivers) say(useAll(receiver), writers.map(writer => writer(receiver)).join());
let sum = 0;
for (let i = 0; i < 3000; ++i) {
  const receiver = receivers[i % receivers.length];
  sum += writers[i % writers.length](receiver).length + receiver.end(i, 1).toString().length + receiver.flush().length + receiver.three(i, 2, 3).length;
}
say("sum", sum);

say(replaced.write("x"));
replaced.write = chunk => "second:" + chunk;
say(replaced.write("y"), w01(replaced));
delete replaced.write;
attempt("deleted", () => replaced.write("z"));
attempt("deleted, elsewhere", () => w02(replaced));
replaced.write = 5;
attempt("a number", () => w03(replaced));
replaced.write = null;
attempt("null", () => w04(replaced));
replaced.write = { call() {} };
attempt("an object", () => w05(replaced));
attempt("of undefined", () => w06(undefined));
attempt("of a number", () => w07(7));
attempt("of a string", () => w08("text"));
Object.setPrototypeOf(replaced, Base.prototype);
delete replaced.write;
say("inherited behind the deletion", w09(replaced), replaced.end(1, 2));
console.log(lines.join("\n"));
//// methods-of-built-in-classes-called-in-cold-code.js
// Built as if all code were cold. A method of a built-in class is called on values that come out of a list of all sorts: instances of the class, of a class below it, objects that have the name
// themselves, an instance that hides the method with a property of its own, a proxy, primitives, and nothing at all. Each call must find what a read of the name finds.
class Chunks extends Array {
  push(...items) {
    return "Chunks " + super.push(...items.map(item => "<" + item + ">"));
  }
}
const hidden = ["hidden"];
hidden.push = function (item) {
  return "own " + item + " " + this.length;
};
const impostor = {
  items: [],
  push(item) {
    this.items.push(item);
    return "impostor " + this.items.length;
  },
  charCodeAt(index) {
    return "impostor " + index;
  },
  get(key) {
    return "impostor " + key;
  },
};
const watched = [];
const proxy = new Proxy(["proxy"], {
  get(target, key, receiver) {
    watched.push(String(key));
    return Reflect.get(target, key, receiver);
  },
});
const belowNothing = Object.create(null);
const receivers = [[], ["a"], new Chunks(), hidden, impostor, proxy, "text", new String("object"), 7, true, Symbol.iterator, belowNothing, new Map([["k", "map"]]), new WeakMap(), null, undefined];
function describe(value) {
  return Array.isArray(value) ? "[" + value.join() + "]" : typeof value === "symbol" ? "symbol" : value === belowNothing ? "below nothing" : value instanceof Map ? "map" : value instanceof WeakMap ? "weak map" : value === impostor ? "impostor" : String(value);
}
function attempt(label, receiver, action) {
  try {
    return label + " " + describe(receiver) + ": " + String(action(receiver));
  } catch (error) {
    return label + " " + describe(receiver) + ": " + error.constructor.name;
  }
}
function pushTwice(target) {
  target.push("x");
  return target.push("y", "z");
}
function codeAt(text) {
  return text.charCodeAt(1);
}
function lookUp(holder) {
  return holder.get("k");
}
const lines = [];
for (let round = 0; round < 3; round++) {
  for (const receiver of receivers) {
    lines.push(attempt("push", receiver, pushTwice));
    lines.push(attempt("charCodeAt", receiver, codeAt));
    lines.push(attempt("get", receiver, lookUp));
  }
}
console.log(lines.join("\n"));
console.log(watched.join());
