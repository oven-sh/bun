  say("32 bits " + bits.toString(16) + " straight", () => { const q = new Q(); q.a = f32[0]; q.b = f32[0]; q.c = view.getFloat32(0); return [opt(q.a), nul(q.b), opt(q.c), opt(f32[0]), dflt(f32[0]), opt(f32.at(0))].join(); });
