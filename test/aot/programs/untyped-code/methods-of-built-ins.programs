//// named-reads-run-once.js
// Reads `x.name` at the top level of a module and in functions that run once: of literals, class instances, classes, functions, arrays, strings, numbers, proxies, getters that throw, undefined and null, inside and outside try blocks.
const lines = [];
////= say-2

const literal = { alpha: 1, beta: "two", gamma: [3], delta: { deep: 4 }, epsilon: undefined, zeta: null };
say(literal.alpha, literal.beta, literal.gamma, literal.delta, literal.epsilon, literal.zeta, literal.missing, literal.toString === Object.prototype.toString);
say(literal.delta.deep, literal.gamma.length, literal.beta.length, literal.alpha.toFixed, literal.hasOwnProperty === Object.prototype.hasOwnProperty);

class Shape {
  static kind = "shape";
  static get computed() { return "computed " + this.kind; }
  sides = 0;
  get doubled() { return this.sides * 2; }
  describe() { return "a shape of " + this.sides; }
}
////= lines-15	Square	Shape	sides	4
const square = new Square();
say(square.sides, square.doubled, square.describe(), square.missing, Square.kind, Square.computed, Square.name, Square.length, typeof Square.prototype, Shape.missing);

function legacy(a, b) { this.a = a; this.b = b; }
legacy.prototype.sum = function () { return this.a + this.b; };
legacy.marker = "on the function";
const made = new legacy(1, 2);
say(made.a, made.b, made.sum(), made.c, legacy.marker, legacy.name, legacy.length, legacy.missing, made.constructor === legacy);

const grown = {};
grown.first = 1;
grown.second = 2;
for (let i = 0; i < 20; ++i) grown["more" + i] = i;
say(grown.first, grown.second, grown.more7, grown.more19, grown.more20);

const trapped = new Proxy({ real: 1 }, { get(target, key) { return key in target ? target[key] : "trapped " + String(key); } });
say(trapped.real, trapped.imagined, trapped.alpha);

const throwing = { get bad() { throw new RangeError("from the getter"); }, good: 1 };
try {
  say(throwing.good);
  say(throwing.bad);
  say("not reached");
} catch (error) {
  say("caught", error.name, error.message, error.missing);
}

let nothing;
const none = null;
for (const attempt of [() => nothing.alpha, () => none.beta, () => literal.epsilon.gamma, () => literal.zeta.delta, () => literal.missing.deeper]) {
  try {
    say(attempt());
  } catch (error) {
    say(error.constructor.name);
  }
}
try {
  say(nothing.alpha);
} catch (error) {
  say("at the top level", error.constructor.name, typeof error.stack);
} finally {
  say("finally", literal.alpha);
}

say((5).alpha, "text".alpha, true.alpha, Symbol.iterator.description, (10n).alpha, "text".length, [1, 2, 3].length, (() => 0).length);
const frozen = Object.freeze({ alpha: "frozen" });
const inherited = Object.create(literal);
const bare = Object.create(null);
bare.alpha = "bare";
say(frozen.alpha, inherited.alpha, inherited.beta, inherited.missing, bare.alpha, bare.toString);
const map = new Map([["k", 1]]);
say(map.size, map.alpha, new Set([1, 2]).size, new Date(0).alpha, /x/g.flags, /x/g.lastIndex, new Error("e").message, new Uint8Array(3).length, new Uint8Array(3).byteLength);

function once() {
  const local = { alpha: "local", nested: { beta: "nested" } };
  return [local.alpha, local.nested.beta, local.gamma, literal.alpha, square.sides, Square.kind, trapped.other, globalThis.undefined, Math.PI > 3, JSON.stringify.name];
}
say(once());
(function () {
  say(this === undefined, literal.beta, arguments.length, arguments.alpha);
})();
console.log(lines.join("\n"));
//// named-stores-reach-setter/main.js
// A store `x.name = v` in code without types, where the name is an accessor: on the prototype, on the object itself, with and
// without a setter, replaced, deleted and shadowed while the same site goes on storing.
import storeSloppily from "./sloppy.cjs";
const lines = [];
function show(...parts) { lines.push(parts.join(" ")); }
function store(object, value) { object.value = value; return object; }
function read(object) { return object.value; }
function attempt(label, action) { try { show(label, String(action())); } catch (error) { show(label, "THROWN", error instanceof TypeError ? "TypeError" : String(error)); } }

class K { x = 0; seen = 0; get value() { return this.x; } set value(v) { this.x = v; this.seen++; } }
class Sub extends K { extra = 1; }
class Deep extends Sub { more = 2; }
const k = new K, sub = new Sub, deep = new Deep;
for (let i = 0; i < 40; i++) { store(k, i); store(sub, i * 2); store(deep, i * 3); }
show("inherited", k.x, k.seen, sub.x, sub.seen, deep.x, deep.seen, read(k), read(sub), read(deep));

const own = { kept: 0, get value() { return this.kept; }, set value(v) { this.kept = v + 1; } };
for (let i = 0; i < 40; i++) store(own, i);
show("own", own.kept, read(own));

const onlySetter = Object.create({ set value(v) { this.got = v; } });
for (let i = 0; i < 40; i++) store(onlySetter, i);
show("only a setter", onlySetter.got, String(read(onlySetter)), Object.keys(onlySetter).join());

const onlyGetter = Object.create({ get value() { return 7; } });
for (let i = 0; i < 6; i++) attempt("only a getter, strict " + i, () => { "use strict"; return (function (o, v) { "use strict"; o.value = v; return o.value; })(onlyGetter, i); });
for (let i = 0; i < 6; i++) attempt("only a getter, sloppy " + i, () => storeSloppily(onlyGetter, i).value);
show("only a getter", Object.keys(onlyGetter).length);

const thrower = Object.create({ set value(v) { if (v === 33) throw new RangeError("thirty-three"); this.last = v; } });
for (let i = 30; i < 36; i++) attempt("a setter that throws " + i, () => store(thrower, i).last);

// The setter is replaced while the site is warm.
const proto = { set value(v) { this.by = "first " + v; } };
const heir = Object.create(proto);
for (let i = 0; i < 40; i++) store(heir, i);
show("before", heir.by);
Object.defineProperty(proto, "value", { set(v) { this.by = "second " + v; }, configurable: true });
store(heir, 40); show("replaced", heir.by);
Object.defineProperty(proto, "value", { value: "plain", writable: true, configurable: true });
store(heir, 41); show("a value now", heir.by, heir.value, proto.value, Object.keys(heir).join());
delete heir.value;
Object.defineProperty(proto, "value", { value: "fixed", writable: false, configurable: true });
attempt("read-only on the prototype, sloppy", () => storeSloppily(heir, 42).value);
attempt("read-only on the prototype, strict", () => (function (o, v) { "use strict"; o.value = v; return o.value; })(heir, 43));
delete proto.value;
store(heir, 44); show("deleted", heir.value, Object.keys(heir).join());

// Another prototype is put between, and the prototype is changed.
const base = { set value(v) { this.by = "base " + v; } };
const middle = Object.create(base);
const leaf = Object.create(middle);
for (let i = 0; i < 40; i++) store(leaf, i);
show("through two", leaf.by);
Object.defineProperty(middle, "value", { set(v) { this.by = "middle " + v; }, configurable: true });
store(leaf, 40); show("shadowed", leaf.by);
Object.setPrototypeOf(leaf, { set value(v) { this.by = "other " + v; } });
store(leaf, 41); show("another prototype", leaf.by);
Object.setPrototypeOf(leaf, null);
store(leaf, 42); show("no prototype", leaf.by, leaf.value);

// The setter adds a property to the receiver, deletes one, freezes it.
const grower = Object.create({ set value(v) { this["p" + (v & 3)] = v; } });
for (let i = 0; i < 12; i++) store(grower, i);
show("grows", Object.keys(grower).join(), grower.p0, grower.p3);
const freezer = Object.create({ set value(v) { if (v === 5) Object.freeze(this); else this.n = v; } });
for (let i = 0; i < 9; i++) attempt("freezes " + i, () => store(freezer, i).n);

// Many structures at one site; a proxy on the way.
const shapes = [];
for (let i = 0; i < 24; i++) { const o = new K; o["s" + i] = i; shapes.push(o); }
for (let round = 0; round < 6; round++) for (let i = 0; i < shapes.length; i++) store(shapes[i], round * 100 + i);
show("many structures", shapes.map(o => o.x).join(), shapes.reduce((n, o) => n + o.seen, 0));
const log = [];
const behindProxy = Object.create(new Proxy({}, { set(target, key, v, receiver) { log.push(String(key) + "=" + v); return true; } }));
for (let i = 0; i < 5; i++) store(behindProxy, i);
show("a proxy on the way", log.join(), Object.keys(behindProxy).length);

// The getter of the same name goes on working beside the setter, whichever is asked first.
class Both { #n = 1; get value() { return this.#n * 2; } set value(v) { this.#n = v; } }
const first = new Both, second = new Both;
let sum = 0;
for (let i = 0; i < 30; i++) { store(first, i); sum += read(first); }
for (let i = 0; i < 30; i++) { sum += read(second); store(second, i); }
show("both", sum, read(first), read(second));
console.log(lines.join("\n"));
//// named-stores-reach-setter/sloppy.cjs
module.exports = function storeSloppily(object, value) {
  object.value = value;
  return object;
};
//// named-stores-run-once/main.js
// Stores `x.name = v` at the top level of a module and in functions that run once: to literals, instances, classes, functions, prototypes, arrays, proxies, setters that throw, frozen objects, primitives, undefined and null; strict and sloppy.
import sloppy from "./sloppy.cjs";
const lines = [];
////= say-2
////= attempt

const literal = { alpha: 1, beta: 2 };
literal.alpha = "replaced";
say(literal);
literal.gamma = "added";
say(literal, Object.keys(literal).join());

class Shape {
  static kind = "shape";
  static set tuned(value) { Shape.kind = "tuned " + value; }
  sides = 0;
  set doubled(value) { this.sides = value / 2; }
}
const shape = new Shape();
shape.sides = 3;
say(shape.sides);
shape.doubled = 10;
say(shape.sides);
shape.extra = "beside the fields";
say(shape.extra, Object.keys(shape).join());
Shape.kind = "changed";
say(Shape.kind);
Shape.tuned = "up";
say(Shape.kind);
Shape.fresh = "new static";
say(Shape.fresh, Object.keys(Shape).join());

function legacy() {}
legacy.prototype.greet = function () { return "hello"; };
say(new legacy().greet());
legacy.helper = 1;
say(legacy.helper);
const list = [1, 2, 3];
list.label = "named";
say(list.label, list.length);
list.length = 1;
say(list);

const seen = [];
const trapped = new Proxy({}, { set(target, key, value) { seen.push(String(key) + "=" + value); target[key] = value; return true; } });
trapped.alpha = 1;
say(seen, trapped.alpha);
const refusing = new Proxy({}, { set() { return false; } });
attempt("a proxy that refuses", () => { refusing.alpha = 1; return "stored"; });

const throwing = { set bad(value) { throw new RangeError("from the setter " + value); } };
try {
  throwing.bad = 7;
  say("not reached");
} catch (error) {
  say("caught", error.message);
}
const onlyGetter = { get fixed() { return 1; } };
attempt("only a getter", () => { onlyGetter.fixed = 2; return onlyGetter.fixed; });
const frozen = Object.freeze({ alpha: 1 });
attempt("frozen, replaced", () => { frozen.alpha = 2; return frozen.alpha; });
attempt("frozen, added", () => { frozen.beta = 2; return frozen.beta; });
let nothing;
attempt("of undefined", () => { nothing.alpha = 1; });
attempt("of null", () => { null.alpha = 1; });
attempt("of a number", () => { (5).alpha = 1; return "stored"; });
attempt("of a string", () => { "text".alpha = 1; return "stored"; });
try {
  nothing.alpha = 1;
} catch (error) {
  say("at the top level", error.constructor.name);
}
const above = { set inherited(value) { this.landed = value; } };
const below = Object.create(above);
below.inherited = "through the chain";
say(below.landed, Object.keys(below).join());
const bare = Object.create(null);
bare.alpha = 1;
