  charCodeAt: index => index * 2,
  charAt: () => "mine",
  length: 3,
  toLowerCase: () => "mine",
  toUpperCase: () => "MINE",
  startsWith: () => true,
  trim: () => "trimmed",
  indexOf: () => 1,
  lastIndexOf: () => 7,
  includes: () => "perhaps",
  slice: (from, to) => "slice " + from + " " + to,
  at: () => "at",
  concat: () => "concat",
