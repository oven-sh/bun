for (const bits of [0x7E80, 0x7EC0, 0x7F00, 0x7F40, 0x7FFF, 0xFE80, 0xFEC0, 0xFF00, 0x7E00, 0x7C80, 0x7CC0, 0x7D00, 0xFF80, 0xFFFF]) {
