const receivers = ["Text/Plain; A=b", "", "É€ ok ", "a" + String(1) + ",b", ["x", "Y", 3], [], 12.5, -0, 7, true, null, undefined, {}, own, Symbol("s"), 10n, new String("Boxed"), Object.create(null)];
