//// missing-name-looked-up-from-prototype.js
// A name that is not among the own names of an object is looked for from its prototype on. Objects of several shapes under one prototype are asked for the same names.
function Vehicle() { }
Vehicle.prototype.wheels = function () { return 4; };
Vehicle.prototype.kind = "vehicle";
function Car(i) { this.seats = i; } Car.prototype = Object.create(Vehicle.prototype);
function Van(i) { this.load = i; this.doors = 2; } Van.prototype = Car.prototype;
function Bus(i) { this.lines = i; this.stops = 3; this.fare = 1; } Bus.prototype = Car.prototype;
function wheelsOf(o, turns) { let s = 0; for (let i = 0; i < turns; i++) s += o.wheels(); return s; }
function kindOf(o, turns) { let s = ""; for (let i = 0; i < turns; i++) s = o.kind; return s; }
function colorOf(o, turns) { let s; for (let i = 0; i < turns; i++) s = o.color; return s; }
function textOf(o, turns) { let s = ""; for (let i = 0; i < turns; i++) s = o.toString(); return s; }
function ownsOf(o, turns) { let n = 0; for (let i = 0; i < turns; i++) n += o.hasOwnProperty("a") ? 1 : 0; return n; }
function valueOf(o, turns) { let s; for (let i = 0; i < turns; i++) s = o.valueOf(); return s === o; }
console.log(textOf({ a: 1 }, 100), ownsOf({ a: 1 }, 100), valueOf({ a: 1 }, 100));
console.log(textOf({ a: 1, b: 2 }, 100), ownsOf({ a: 1, b: 2 }, 100), valueOf({ a: 1, b: 2 }, 100));
console.log(textOf({ b: 1, c: 2, d: 3 }, 100), ownsOf({ b: 1, c: 2, d: 3 }, 100), valueOf({ b: 1, c: 2, d: 3 }, 100));
console.log(wheelsOf(new Car(1), 100), kindOf(new Car(1), 100), colorOf(new Car(1), 100), textOf(new Car(1), 100));
console.log(wheelsOf(new Van(1), 100), kindOf(new Van(1), 100), colorOf(new Van(1), 100), textOf(new Van(1), 100));
console.log(wheelsOf(new Bus(1), 100), kindOf(new Bus(1), 100), colorOf(new Bus(1), 100), textOf(new Bus(1), 100));
console.log(textOf({ a: 1 }, 100), textOf({ a: 1, b: 2 }, 100), typeof kindOf({ a: 1 }, 100));

// What was learnt ends when the name arrives nearer by or changes.
Car.prototype.kind = "car";
console.log(kindOf(new Car(1), 50), kindOf(new Van(1), 50), kindOf(new Bus(1), 50));
Vehicle.prototype.color = "grey";
console.log(colorOf(new Car(1), 50), colorOf(new Van(1), 50), colorOf(new Bus(1), 50));
Vehicle.prototype.wheels = function () { return 6; };
console.log(wheelsOf(new Car(1), 50), wheelsOf(new Van(1), 50));
Object.defineProperty(Car.prototype, "color", { get() { return "the color of " + Object.keys(this).join(); }, configurable: true });
console.log(colorOf(new Car(1), 50), colorOf(new Van(1), 50), colorOf(new Bus(1), 50));
delete Car.prototype.color;
delete Car.prototype.kind;
console.log(colorOf(new Van(1), 50), kindOf(new Van(1), 50));
const own = new Van(1);
own.kind = "my own";
console.log(kindOf(own, 50), kindOf(new Van(1), 50));
Object.setPrototypeOf(Car.prototype, { wheels() { return 3; }, kind: "tricycle" });
console.log(wheelsOf(new Bus(1), 50), kindOf(new Bus(1), 50), colorOf(new Bus(1), 50));
//// missing-namespace-names/both.js
export const universal = { ssr: true, csr: false };
export const server = { ssr: "server of both", csr: "never seen" };
//// missing-namespace-names/main.js
// Code that does not know what it is handed asks namespace objects for names that some of them export and some do not (`node?.universal?.[option] ?? node?.server?.[option]`). A namespace never gains an export, so a name it
// lacks is answered without asking the run time every time; a store to it still throws, `in` says false, and what an object in its place has is still found.
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;
const lines = [];
function attempt(run) { try { return String(run()); } catch (error) { return error.constructor.name; } }
const option = (node, name) => node?.universal?.[name] ?? node?.server?.[name];
const readUniversal = (node) => node.universal;
const readServer = (node) => node.server;
const readNowhere = (node) => node.nowhere;
const both = await import("./both.js");
const universalOnly = await import("./universal.js");
const serverOnly = await import("./server.js");
const neither = await import("./neither.js");
const starred = await import("./starred.js");
const nodes = [both, universalOnly, serverOnly, neither, starred];
const names = ["both", "universal", "server", "neither", "starred"];
function tell(tag) {
  lines.push(tag + ": " + nodes.map((node, i) => names[i] + " " + [typeof readUniversal(node), typeof readServer(node), typeof readNowhere(node), option(node, "ssr"), option(node, "csr"), option(node, "missing")].join()).join(" | "));
}
tell("at first");
{
  for (let i = 0; i < 100; i++) for (const node of nodes) option(node, "ssr");
  const before = count("operationAOTGetByIdAndCache");
  let seen = 0;
  for (let i = 0; i < 3000; i++) for (const node of nodes) seen += option(node, "ssr") === undefined ? 0 : 1;
  const asked = count("operationAOTGetByIdAndCache") - before;
  lines.push("rounds " + seen);
  lines.push(asked <= 200 ? "the reads asked the run time at most 200 times" : "the reads asked the run time " + asked + " times");
}
tell("behind the rounds");
lines.push("stored to: " + nodes.map((node) => attempt(() => { node.server = 1; return "stored"; })).join());
lines.push("a name nobody has stored to: " + nodes.map((node) => attempt(() => { node.nowhere = 1; return "stored"; })).join());
lines.push("in: " + nodes.map((node) => ["universal" in node, "server" in node, "nowhere" in node].join()).join(" | "));
lines.push("own: " + nodes.map((node) => [Object.hasOwn(node, "universal"), Object.hasOwn(node, "server"), Object.hasOwn(node, "nowhere")].join()).join(" | "));
lines.push("deleted: " + nodes.map((node) => attempt(() => delete node.nowhere) + " " + attempt(() => delete node.server)).join(" | "));
lines.push("defined: " + nodes.map((node) => attempt(() => Object.defineProperty(node, "nowhere", { value: 1 }) && "defined")).join());
lines.push("marker: " + nodes.map((node) => [typeof node.__esModule, typeof node.then, typeof node.toString, typeof node.constructor, node[Symbol.toStringTag]].join()).join(" | "));
tell("behind the attempts");
const plain = [{ universal: { ssr: "plain" } }, { server: { ssr: "of the server" } }, {}, Object.create({ server: { ssr: "inherited" } })];
lines.push("objects at the same places: " + plain.map((node) => [typeof readUniversal(node), typeof readServer(node), typeof readNowhere(node), option(node, "ssr")].join()).join(" | "));
tell("at last");
console.log(lines.join("\n"));
//// missing-namespace-names/neither.js
export const index = 3;
export function component() { return "component"; }
//// missing-namespace-names/server.js
export const server = { ssr: false, csr: 0 };
export default "the default";
//// missing-namespace-names/starred.js
export * from "./server.js";
export const own = 1;
//// missing-namespace-names/universal.js
export const universal = { csr: true };
export const index = 1;
//// missing-properties-runtime-code.js
// Functions made at run time read properties that are not there, over and over, while the objects and their prototype chains change under them.
const lines = [];
const collect = typeof gc === "function" ? gc : () => Bun.gc(true);
const readers = Object.create(null);
const reader = name => (readers[name] ??= new Function("value", "return value." + name + ";"));
const numeric = new Function("value", "return value['0.5'];"), negativeZero = new Function("value", "return value['-0'];");
const defaults = new Function("{ first = 'one', second, third = second } = {}", "return first + ' ' + second + ' ' + third;");
const show = value => (typeof value === "function" ? "function" : typeof value === "object" && value !== null ? JSON.stringify(value) : String(value));
////= say

say("an empty object", () => reader("absent")({}));
say("defaults", () => defaults());
say("defaults of an empty object", () => defaults({}));
say("defaults given", () => defaults({ second: 2 }));

const plain = { a: 1 };
say("before it is added", () => reader("later")(plain));
plain.later = "added";
say("after it is added", () => reader("later")(plain));
delete plain.later;
say("after it is deleted", () => reader("later")(plain));

const root = {}, make = () => Object.create(root);
say("before the root has it", () => reader("onTheRoot")(make()));
root.onTheRoot = "inherited";
say("while it has it", () => reader("onTheRoot")(make()));
delete root.onTheRoot;
say("after it lost it", () => reader("onTheRoot")(make()));
Object.defineProperty(root, "onTheRoot", { get() { return "got by " + typeof this; }, configurable: true });
say("while it has a getter", () => reader("onTheRoot")(make()));
delete root.onTheRoot;
say("after the getter went", () => reader("onTheRoot")(make()));

class Base {}
class Derived extends Base {}
const instance = new Derived();
say("an instance", () => reader("method")(instance));
Base.prototype.method = "of the base";
say("the base class has it", () => reader("method")(instance));
Derived.prototype.method = "of the derived";
say("the derived class has it", () => reader("method")(instance));
delete Derived.prototype.method;
delete Base.prototype.method;
say("neither has it", () => reader("method")(instance));
Object.setPrototypeOf(Derived.prototype, { method: "of a new parent" });
say("the chain is another", () => reader("method")(instance));
Object.setPrototypeOf(instance, null);
say("no chain at all", () => reader("method")(instance));

const bare = Object.create(null);
say("no prototype", () => reader("toString")(bare));
const behindProxy = Object.create(new Proxy({}, { get: (target, key) => "trapped " + String(key), has: () => true }));
say("a proxy in the chain", () => reader("anything")(behindProxy));
let traps = 0;
const counting = Object.create(new Proxy({}, { get() { traps++; return undefined; } }));
say("a proxy that answers undefined", () => reader("counted")(counting));
lines.push("traps " + traps);
say("a proxy itself", () => reader("absent")(new Proxy({}, {})));

say("a string", () => reader("absent")("text"));
say("a number", () => reader("absent")(5));
say("a boolean", () => reader("absent")(true));
say("a symbol", () => reader("absent")(Symbol.iterator));
say("a bigint", () => reader("absent")(5n));
say("undefined", () => reader("absent")(undefined));
say("null", () => reader("absent")(null));

say("an array", () => reader("absent")([1, 2]));
say("a function", () => reader("absent")(() => 1));
say("arguments", () => reader("absent")((function () { return arguments; })(1)));
say("a typed array", () => reader("absent")(new Uint8Array(2)));
say("a typed array and a number as a name", () => numeric(new Uint8Array(2)));
class Bytes extends Uint8Array {}
Bytes.prototype["0.5"] = "half";
Bytes.prototype["-0"] = "negative zero";
Bytes.prototype.named = "a name";
say("a typed array stops the search for a number", () => numeric(new Bytes(2)) + " " + negativeZero(new Bytes(2)) + " " + reader("named")(new Bytes(2)));
say("an object does not", () => numeric(Object.create(Bytes.prototype)) + " " + negativeZero(Object.create(Bytes.prototype)));
say("a map", () => reader("absent")(new Map()));
say("a regular expression", () => reader("absent")(/x/));
say("a date", () => reader("absent")(new Date(0)));
say("the global object", () => reader("absentFromTheGlobalObject")(globalThis));
globalThis.absentFromTheGlobalObject = "now a global";
say("the global object has it", () => reader("absentFromTheGlobalObject")(globalThis));
delete globalThis.absentFromTheGlobalObject;
say("the global object lost it", () => reader("absentFromTheGlobalObject")(globalThis));

const dictionary = {};
for (let i = 0; i < 200; i++) dictionary["key" + i] = i;
for (let i = 0; i < 200; i += 2) delete dictionary["key" + i];
say("a dictionary", () => reader("key2")(dictionary) + " " + reader("key3")(dictionary));
dictionary.key2 = "back";
say("a dictionary gets it back", () => reader("key2")(dictionary));
const dictionaryParent = {};
for (let i = 0; i < 200; i++) dictionaryParent["key" + i] = i;
for (let i = 0; i < 200; i++) delete dictionaryParent["key" + i];
const child = Object.create(dictionaryParent);
say("a dictionary in the chain", () => reader("inParent")(child));
dictionaryParent.inParent = "found";
say("it gets the name", () => reader("inParent")(child));
