const values = [makeValues(1), makeValues(1000)];
const tools = [makeTools(1), makeTools(50)];
const accessors = [makeAccessors(2), makeAccessors(70)];
let sum = 0;
const mix = n => { sum = Math.imul(sum, 31) + n | 0; };
const round = (i, withSetters = true) => {
  for (const o of values) { mix(readValues(o)); storeValues(o, i); mix(readValues(o)); }
  for (const o of tools) { mix(callTools(o, i)); mix(readTools(o)); }
  for (const o of accessors) { mix(readAccessors(o)); if (withSetters) mix(storeAccessors(o, i)); mix(readAccessors(o)); }
};
round(1);
console.log("the first round:", sum, values[0].p399, values[1].p130, tools[1].f299(1), accessors[0].g299, accessors[1].kept);
for (let i = 0; i < 30; i++) round(i);
let before = visits();
for (let i = 0; i < 300; i++) round(i, false);
console.log("300 rounds:", sum, "the run time is asked at most fifty times:", typeof aotOperationCount !== "function" || visits() - before <= 50);

const hidden = makeValues(5);
Object.defineProperty(hidden, "quiet", { value: 1, writable: true, enumerable: false, configurable: true });
Object.defineProperty(hidden, "fixed", { value: 2, writable: false, enumerable: true, configurable: true });
function bump(o, by) { const was = o.quiet; o.quiet = was + by; return was * 3 + o.quiet + o.fixed + o.p398; }
for (let i = 0; i < 30; i++) mix(bump(hidden, i));
before = visits();
for (let i = 0; i < 300; i++) mix(bump(hidden, i));
console.log("a property far out of line that is not enumerable:", sum, hidden.quiet, Object.keys(hidden).length, "asked at most fifty times:", typeof aotOperationCount !== "function" || visits() - before <= 50);
let refused = "";
try { (o => { o.fixed = 3; })(hidden); } catch (error) { refused = error instanceof TypeError ? "a TypeError" : String(error); }
console.log("a store to one that is read-only:", refused, hidden.fixed);

const parent = makeValues(9);
const child = Object.create(parent);
child.p131 = -1;
mix(readValues(child)); mix(readValues(child)); mix(readValues(parent));
parent.p399 = 77; parent.p131 = 78;
mix(readValues(child)); mix(readValues(parent));
delete values[0].p200;
Object.defineProperty(values[1], "p256", { get() { return -256; }, configurable: true });
Object.defineProperty(accessors[0], "g128", { value: 4, writable: true, configurable: true });
tools[0].f250 = function (x) { return -x; };
delete tools[1].f135;
let thrown = "";
try { round(7); } catch (error) { thrown = error instanceof TypeError ? "a TypeError" : String(error); }
console.log("after changes:", sum, thrown, readValues(values[0]), readValues(values[1]), readAccessors(accessors[0]), callTools(tools[0], 2), child.p399, child.p131);
//// own-properties-that-hide-members-of-prototypes.js
// An object may or may not have a property of its own under a name that its prototypes have too: a default value, a method, a getter.
// Each read has to find the own property where there is one and what the prototypes have at that moment where there is none.
const lines = [];
function show(label, value) {
  lines.push(label + ": " + String(value));
}

function Widget(size) {
  this.size = size;
}
Widget.prototype.enabled = false;
Widget.prototype.weight = 2;
Widget.prototype.label = undefined;
Widget.prototype.render = function () {
  return "widget " + this.size;
};
Object.defineProperty(Widget.prototype, "area", {
  get: function () {
    return this.size * this.size;
  },
  configurable: true,
});
Object.defineProperty(Widget.prototype, "writeOnly", {
  set: function (value) {
    this.written = value;
  },
  configurable: true,
});

const widgets = [new Widget(1), new Widget(2), new Widget(3), new Widget(4)];
widgets[1].enabled = true;
widgets[2].weight = 5;
widgets[2].label = "third";
widgets[3].render = function () {
  return "custom " + this.size;
};
Object.defineProperty(widgets[3], "area", { value: -1, writable: true, enumerable: true, configurable: true });
Object.defineProperty(widgets[0], "writeOnly", { value: "own", writable: true, enumerable: true, configurable: true });

function describe(widget) {
  return [widget.enabled, widget.weight, widget.label, widget.render(), widget.area, widget.writeOnly, widget.written].join(" ");
}
function describeAll(when) {
  for (let i = 0; i < widgets.length; i++) show(when + " " + i, describe(widgets[i]));
}

describeAll("at first");

Widget.prototype.enabled = "by default";
Widget.prototype.weight = 7;
describeAll("other defaults");

delete widgets[1].enabled;
delete widgets[2].weight;
delete widgets[3].render;
delete widgets[3].area;
describeAll("own properties deleted");

widgets[1].enabled = 0;
try {
  widgets[3].area = 12;
} catch (error) {
  show("store that finds a getter alone", error instanceof TypeError);
}
widgets[2].writeOnly = "through the setter";
describeAll("stored again");

delete Widget.prototype.weight;
delete Widget.prototype.area;
describeAll("defaults deleted");

Object.setPrototypeOf(Widget.prototype, { weight: "one step further" });
describeAll("found one step further");
Object.setPrototypeOf(Widget.prototype, Object.prototype);
describeAll("and gone again");

function Gadget(size) {
  Widget.call(this, size);
}
Gadget.prototype = Object.create(Widget.prototype);
Gadget.prototype.constructor = Gadget;
Gadget.prototype.render = function () {
  return "gadget " + this.size + " (" + Widget.prototype.render.call(this) + ")";
};
const gadgets = [new Gadget(5), new Gadget(6)];
gadgets[1].enabled = "own";
gadgets[1].render = null;
for (const gadget of gadgets) show("gadget", [gadget.enabled, gadget.label, typeof gadget.render, gadget.render ? gadget.render() : "no method"].join(" "));

function Bare(value) {
  if (value !== undefined) this.value = value;
}
Bare.prototype = Object.create(null);
Bare.prototype.value = "inherited";
const bare = [new Bare(1), new Bare()];
show("prototype without a prototype", bare[0].value + " " + bare[1].value + " " + String(bare[1].missing));
delete Bare.prototype.value;
show("nothing left to find", bare[0].value + " " + String(bare[1].value));

function Loose(value) {
  if (value !== undefined) this.value = value;
}
Loose.prototype.value = "inherited";
const loose = [new Loose(1), new Loose()];
Object.setPrototypeOf(loose[1], null);
show("no prototype at all", loose[0].value + " " + String(loose[1].value));
Object.setPrototypeOf(loose[1], { value: "another prototype" });
show("another prototype", loose[0].value + " " + String(loose[1].value));

const seen = [];
function Watched(value) {
  if (value !== undefined) this.value = value;
}
Watched.prototype = new Proxy(
  { value: "behind the proxy" },
  {
    get(target, key, receiver) {
      seen.push(String(key) + (receiver instanceof Object ? " for an object" : ""));
      return Reflect.get(target, key, receiver);
    },
  },
);
const watched = [new Watched(1), new Watched()];
show("proxy as prototype", watched[0].value + " " + watched[1].value + " | " + seen.filter((entry) => entry.startsWith("value")).join(", "));

class Base {
  get kind() {
    return "base of " + this.name;
  }
  describe() {
    return "described " + this.name;
  }
}
class Derived extends Base {
  constructor(name, hides) {
    super();
    this.name = name;
    if (hides) {
      Object.defineProperty(this, "kind", { value: "own kind", configurable: true });
      this.describe = () => "own description of " + this.name;
    }
  }
}
for (const instance of [new Derived("a", false), new Derived("b", true)]) show("class", instance.kind + " | " + instance.describe());

function total(count) {
  let sum = 0;
  for (let i = 0; i < count; i++) {
    const widget = widgets[i & 3];
    sum += (widget.enabled ? 1 : 0) + (widget.weight === undefined ? 3 : 1) + widget.render().length + (widget.area === undefined ? 1 : 2);
  }
  return sum;
}
show("in a loop", total(10000));

console.log(lines.join("\n"));
//// own-property-by-key-new-structures.ts
// `Object.hasOwn(o, key)` over thirty-two shapes and four keys in turn, sixty times over with new shapes each time, as a server meets them. What is remembered about shapes that are no longer asked about does not stand in the way of those that are: each question (shape, key) is worked out once, and nearly all after that are answered from what is remembered.
declare const aotOperationCount: undefined | ((name: string) => number);
const counted = typeof aotOperationCount === "function" ? aotOperationCount : null;
const entered = () => counted ? counted("operationAOTHasOwnProperty") : 0;
const keys: any[] = ["alpha", "beta", "gamma", "delta"];
function ask(o: any, key: any): number { return Object.hasOwn(o, key) ? 1 : 0; }
const turns = 40, shapes = 32;
let yes = 0, asked = 0, workedOut = 0;
////= for-5	for (const key of keys) ask(o, key	for (const key of keys) yes += ask(o, key	keys.length
console.log(yes, asked, counted ? workedOut * 20 < asked : true);
//// own-property-few-structures-alternating.ts
// A few objects of different shapes are asked for the same names over and over, as a comparison of two objects or a copy of a list of them does. Each question (shape, name) is worked out once; after that nearly all are answered from what is remembered, whichever shapes and names they are.
declare const aotOperationCount: undefined | ((name: string) => number);
const has = (o: any, k: any): boolean => Object.prototype.hasOwnProperty.call(o, k);
const counted = typeof aotOperationCount === "function" ? aotOperationCount : null;
const entered = () => counted ? counted("operationAOTHasOwnProperty") : 0;
const turns = 50;
let yes = 0, asked = 0, workedOut = 0;
function ask(shapes: number, width: number, tag: string) {
  const objects: any[] = [];
  for (let shape = 0; shape < shapes; shape++) {
    let text = "";
    for (let n = 0; n < width; n++) text += `${n ? "," : ""}"${tag}${n}":${shape}`;
    objects.push(JSON.parse(`{${text}${shape ? `,"${tag}more${shape}":1` : ""}}`));
  }
  const names = Object.keys(objects[0]);
  for (const o of objects) for (const k of names) has(o, k);
  const before = entered();
  for (let turn = 0; turn < turns; turn++) for (const o of objects) for (const k of names) yes += +has(o, k);
  asked += turns * shapes * width;
  workedOut += entered() - before;
}
for (let round = 0; round < 12; round++)
