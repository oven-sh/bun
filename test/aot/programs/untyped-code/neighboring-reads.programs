//// parsed-data-type-mismatch.ts
// Data that `JSON.parse` read from a file is cast to a type although some entries do not match the type. The cast takes any object, and reads through a dictionary or a variable without an annotation give what is there. A value of the wrong kind throws a TypeError where it enters an annotated variable, a primitive of the wrong kind also under a cast, and where a function reads it from a field of its annotated parameter.
type P = { tools: string[]; n?: number }
type Q = { count: number; name: string }
type G = { projects?: Record<string, P>; counters?: Record<string, Q>; version: number }
const DEFAULT: P = { tools: [], n: 0 }
const text = JSON.stringify({ version: 2, projects: { good: { tools: ["a", "b"], n: 1 }, lacks: { n: 5 }, nothing: null, word: "corrupted", wrong: { tools: "one,two" }, more: { tools: ["c"], extra: true }, list: [1, 2], digit: 7 }, counters: { good: { count: 1, name: "x" }, lacks: { name: "y" }, wrong: { count: "3", name: 4 } } })
const row = (what: string, f: () => unknown) => { let said: string; try { said = String(f()) } catch (e) { said = "THROWS " + (e as Error).constructor.name } console.log(what + ": " + said) }
const parse = () => JSON.parse(text) as G
const use = (p: P) => (Array.isArray(p.tools) ? p.tools.join("+") : typeof p.tools) + "/" + (p.n ?? "-")
const keys = ["good", "lacks", "nothing", "word", "wrong", "more", "list", "digit", "absent"]
row("the cast", () => parse().version)
for (const key of keys) row("by key, defensive, " + key, () => { const p = parse().projects![key] ?? DEFAULT; if (!p || typeof p !== "object") return "skipped " + typeof p; if (typeof p.tools === "string") return "a string of " + (p.tools as string).length; if (!p.tools) return "none"; return p.tools.length })
for (const key of keys) row("to a function, " + key, () => { const p = parse().projects![key]; return !p || typeof p !== "object" ? "skipped " + typeof p : use(p) })
for (const key of keys) row("to an annotated const, " + key, () => { const kept: P = parse().projects![key]; return typeof kept })
row("entries", () => { const seen: string[] = []; for (const [k, p] of Object.entries(parse().projects!)) { if (!p || typeof p !== "object") { seen.push(k + " skipped"); continue } seen.push(k + " " + use(p)) } return seen.join() })
row("values, filtered", () => { const all: P[] = Object.values(parse().projects!).filter(p => p && typeof p === "object" && !Array.isArray(p)); return all.length + " " + all.map(use).join() })
row("written through", () => { const g = parse(); const kept: P = g.projects!["lacks"]; kept.tools = ["late"]; kept.n = (kept.n ?? 0) + 1; return JSON.stringify(g.projects!["lacks"]) + " " + (kept === g.projects!["lacks"]) + " " + Object.keys(kept).join() })
for (const key of ["good", "lacks", "wrong"]) row("a required number, " + key, () => { const q = parse().counters![key]; return typeof q.count + " " + (typeof q.count === "number" ? q.count + 1 : "no number") + " " + typeof q.name })
const isText = (v: unknown): v is string => typeof v === "string"
const describeValue = (v: unknown) => typeof v + ":" + String(v)
for (const key of keys) row("as a dictionary, " + key, () => { const x = parse().projects![key]; if (!x || typeof x !== "object") return "skipped"; const r = x as Record<string, unknown>; return typeof r.tools === "string" && describeValue(r.tools) })
for (const key of keys) row("a dictionary's field, " + key, () => { const x = parse().projects![key]; if (!x) return "nil"; const tools = (x as Record<string, unknown>).tools; const n = (x as Record<string, unknown>)["n"]; return describeValue(tools) + " " + describeValue(n) })
row("a dictionary or nothing", () => { const x = parse().projects!["wrong"]; const r = typeof x === "object" ? (x as Record<string, unknown>) : undefined; const v = r ? (r as Record<string, unknown>)["tools"] : undefined; return describeValue(v) })
row("a field by itself", () => { const x = parse().projects!["more"]; const tools = x.tools; const first = tools[0]; return describeValue(first) })
row("a field tested", () => { const x = parse().projects!["wrong"]; return typeof x.tools === "string" && isText(x.tools) && (x as Record<string, unknown>).tools !== undefined })
row("a field handed on", () => { const x = parse().projects!["good"]; const made = { a: x.tools, b: describeValue(x.n), ...x }; return JSON.stringify(made) })
row("assigned later", () => { let v: unknown; const x = parse().projects!["lacks"]; v = (x as Record<string, unknown>)["n"]; return describeValue(v) })
row("a loop over what it holds", () => { const seen: string[] = []; const x = parse().projects!["more"]; for (const e of Object.entries(x)) { seen.push(e[0] + "=" + describeValue(e[1])) } for (const t of x.tools) seen.push(t); return seen.join() })
row("deleted", () => { const g = parse(); const x = g.projects!["good"]; delete x.n; delete (x as Record<string, unknown>).tools; return JSON.stringify(x) })
row("handed to a function as a dictionary", () => { const x = parse().projects!["wrong"]; const count = (r: Record<string, unknown>) => Object.keys(r).length; return count(x as Record<string, unknown>) })
row("the door itself as a dictionary", () => { const r = JSON.parse(text) as Record<string, unknown>; const version = r.version; return typeof version === "number" ? version + 1 : "no number" })
row("awaited and chained", () => { const g = parse(); return g.projects?.["good"]?.tools?.length })
type Mine = { a: number; b?: string }
const narrowed = (x: unknown) => { if (typeof x !== "object" || x === null) return "no object"; const r = x as Record<string, unknown>; return describeValue(r.a) }
const narrowedByIn = (x: unknown) => { if (!x || typeof x !== "object" || !("a" in x)) return "no a"; const r = x as Record<string, unknown>; return describeValue(r.a) }
const makeMine = (): Mine => ({ a: 1 })
const mines: Mine[] = [{ a: 2, b: "two" }]
row("narrowed, then cast", () => [narrowed(parse().projects!["good"]), narrowed({ a: 5 }), narrowed(makeMine()), narrowed("text"), narrowed(null)].join())
row("narrowed by `in`, then cast", () => [narrowedByIn(parse().counters), narrowedByIn({ a: 6 }), narrowedByIn(mines[0]), narrowedByIn(7)].join())
row("what a call yields, cast", () => { const r = makeMine() as Record<string, unknown>; return describeValue(r.a) + describeValue(r.b) })
row("an element, cast", () => { const r = mines[0] as Record<string, unknown>; return describeValue(r.a) + describeValue(r.b) })
const awaited = (await Promise.resolve(makeMine())) as Record<string, unknown>
row("what is awaited, cast", () => describeValue(awaited.a))
// JavaScriptCore's generic functions on external data: awaited and iterated afterwards.
const settled = await Promise.all([parse().projects!["wrong"], parse().projects!["more"]])
row("Promise.all of what is given", () => settled.map(p => typeof p.tools).join())
row("Array.from of what is given", () => Array.from(Object.values(parse().projects!)).map(p => (p && typeof p === "object" ? typeof p.tools : typeof p)).join())
// A FIELD THAT LIES ABOUT ITS KIND, USED AS THE PRIMITIVE IT IS DECLARED TO BE.
type Named = { name: string; size: number; on: boolean; label?: string }
const liars = JSON.parse('{"object":{"name":{"first":"a"},"size":{"n":1},"on":{}},"array":{"name":["x","y"],"size":[7],"on":[]},"swapped":{"name":5,"size":"12","on":"yes"},"nil":{"name":null,"size":null,"on":null},"honest":{"name":"abc","size":3,"on":true}}') as Record<string, Named>
for (const key of ["object", "array", "swapped", "nil", "honest"]) {
  row("a lying string, " + key, () => { const x = liars[key]; return [String(x.name?.length), x.name + "!", `<${x.name}>`, String(x.name < "b"), String(x.name === "abc"), typeof x.name].join("|") })
  row("a lying number, " + key, () => { const x = liars[key]; return [String(x.size + 1), String(x.size * 2), String(x.size < 5), String(-x.size), String(x.size | 0), `${x.size}`, typeof x.size].join("|") })
  row("a lying boolean, " + key, () => { const x = liars[key]; return [x.on ? "truthy" : "falsy", String(!x.on), String(x.on === true), String(x.on && 1), typeof x.on].join("|") })
  row("a lying field cast to its kind, " + key, () => { const r = liars[key] as Record<string, unknown>; const name = r.name as string, size = r.size as number; return [String(name + "?"), String(size + 1), typeof name, typeof size].join("|") })
}
// AN ANNOTATED VARIABLE tests what enters it, also when its type is as common as `string[]` or `number`.
for (const key of ["good", "lacks", "wrong"]) row("a common type written, " + key, () => { const x = parse().projects![key]; const t: string[] = x.tools; const n: number | undefined = x.n; return typeof t + " " + (Array.isArray(t) ? t.length : String(t)) + " " + typeof n })
for (const key of ["good", "lacks", "wrong"]) row("a number written, " + key, () => { const q = parse().counters![key]; const c: number = q.count; const name: string = q.name; return typeof c + " " + typeof name + " " + (typeof c === "number" ? c * 2 : "no number") })
row("round trip", () => { const g = parse(); return JSON.stringify(g) === text })
export {}
//// parsed-data-type-mismatch-open-cases.ts
// Data from `JSON.parse` is cast to a type that it does not match. A string where `string[]` is written throws a TypeError where it enters a parameter or an annotated variable and where typed code reads the field, also after the data has passed through an `any` of the program's own.
type P = { tools: string[]; n?: number }
type G = { projects: Record<string, P> }
const text = JSON.stringify({ projects: { good: { tools: ["a"] }, wrong: { tools: "one,two" }, word: "corrupted" } })
const row = (what: string, f: () => unknown) => { let said: string; try { said = String(f()) } catch (e) { said = "THROWS " + (e as Error).constructor.name } console.log(what + ": " + said) }
const parse = () => JSON.parse(text) as G
// a parameter, a result, a field of a type that is everybody's
const count = (tools: string[]) => (typeof tools === "string" ? -1 : tools.length)
const first = <T,>(xs: T[]): T => xs[0]
const toolsOf = (p: P): string[] => p.tools
class Keeper { tools: string[] = []; keep(p: P) { this.tools = p.tools; return typeof this.tools } }
row("a parameter of a common type", () => count(parse().projects["wrong"].tools))
row("a generic function of the program", () => { const t = first(parse().projects["wrong"].tools); return typeof t + ":" + String(t) })
row("a result of a common type", () => typeof toolsOf(parse().projects["wrong"]))
row("a field of a common type", () => new Keeper().keep(parse().projects["wrong"]))
row("assigned later to an annotated variable", () => { let t: string[] = []; t = parse().projects["wrong"].tools; return typeof t })
// data that passes an `any` of the program's own before it meets a type
type Late = { late: string[] }
const through = (raw: any): Late => raw as Late
const holder: { raw: any } = { raw: JSON.parse('{"late":"text"}') }
row("through a parameter of type any", () => { const late: Late = through(JSON.parse('{"late":"text"}')); return typeof late.late })
row("through a field of type any", () => typeof (holder.raw as Late).late)
// an object made as one record type enters a field of another record type as an argument: any object passes
type Wide = { value: number; next: Wide | null }
type Narrow = { value: number; next: Narrow | null; back: Narrow | null }
const given: Wide = JSON.parse('{"value":1,"next":null}')
const link = (w: Wide, to: Wide) => { w.next = to; return w }
const narrow: Narrow = { value: 2, next: null, back: null }
row("a layout handed in as an argument", () => { link(narrow, given); return narrow.next === (given as object) })
//// plain-object-fast-path-miss.js
// A property lookup table miss for an own data property, or for an absent name, of an ordinary object is answered from the object's Structure alone. Each of the 1000 objects has its own shape, so every read is a miss.
// The Structure alone cannot answer for a name on another prototype, an own accessor or a name on Object.prototype: those misses take the slow path and get the same answers as in plain Bun.
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;
const misses = () => count("operationAOTGetByIdAndCache");
function make(i) {
  const o = {};
  o["kind" + i] = i;
  o["alpha" + (i % 3)] = 1;
  o.value = i;
  return o;
}
const readValue = o => o.value;
const readMissing = o => (o.missing === undefined ? 1 : 0);
const objects = [];
for (let i = 0; i < 1000; i++) objects.push(make(i));
const before = misses();
let sum = 0;
for (const o of objects) sum += readValue(o);
for (const o of objects) sum += readMissing(o);
const asked = misses() - before;
console.log("1000 shapes, an own and an absent name:", sum, "the reads miss:", typeof aotOperationCount !== "function" || asked >= 1000);

const parent = { missing: 7 };
function makeChild(i) {
  const o = Object.create(parent);
  o["kind" + i] = i;
  return o;
}
function makeWithGetter(i) {
  const o = { get missing() { return i; } };
  o["kind" + i] = i;
  return o;
}
const readName = o => o.missing;
const readToString = o => o.toString;
let others = 0;
for (let i = 0; i < 1000; i++) others += readName(makeChild(i)) + readName(makeWithGetter(i)) + (readToString(objects[i]) === Object.prototype.toString ? 1 : 0);
console.log("1000 shapes, a name on another prototype, an own accessor and a name on Object.prototype:", others);
//// plain-object-presence-cached-in-table.js
// The first read by name, and the later ones, of what an ordinary object has itself and of what neither it nor Object.prototype has, whatever gave the object its shape.
function grown(k) { const o = {}; o["p" + k] = k; o.alpha = 1; o.beta = 2; return o; }
function Made(i) { this.alpha = i; this.beta = i + 1; }
const parsed = text => JSON.parse(text);
const assigned = k => Object.assign({}, { alpha: k, beta: k + 1, ["q" + k]: 0 });
function alphaOf(o, turns) { let s = 0; for (let i = 0; i < turns; i++) s += o.alpha; return s; }
function betaOf(o, turns) { let s = 0; for (let i = 0; i < turns; i++) s += o.beta; return s; }
const sum = (o, turns) => alphaOf(o, turns) + betaOf(o, turns);
function lacksGamma(o, turns) { let n = 0; for (let i = 0; i < turns; i++) n += o.gamma === undefined ? 1 : 0; return n; }
function lacksThen(o, turns) { let n = 0; for (let i = 0; i < turns; i++) n += o.then === undefined ? 1 : 0; return n; }
const absent = (o, turns) => Math.min(lacksGamma(o, turns), lacksThen(o, turns));
const objects = [grown(1), grown(2), parsed('{"alpha":3,"beta":4}'), parsed('{"beta":5,"alpha":6,"more":7}'), assigned(1), assigned(2)];
console.log(objects.map(o => sum(o, 50)).join(), objects.map(o => absent(o, 50)).join());
function sumOfMade(o, turns) { let s = 0; for (let i = 0; i < turns; i++) s += o.alpha + o.beta; return s; }
function absentOfMade(o, turns) { let n = 0; for (let i = 0; i < turns; i++) n += o.gamma === undefined && o.then === undefined ? 1 : 0; return n; }
console.log(sumOfMade(new Made(1), 50), absentOfMade(new Made(1), 50));

// Keyed reads of the same pairs, and what changes afterwards.
function keyed(o, key, turns) { let s; for (let i = 0; i < turns; i++) s = o[key]; return s; }
console.log(objects.map(o => keyed(o, "al" + "pha", 20)).join(), objects.map(o => String(keyed(o, "gam" + "ma", 20))).join());
objects[0].gamma = "added";
delete objects[1].alpha;
Object.defineProperty(objects[2], "alpha", { get() { return 100; } });
Object.setPrototypeOf(objects[3], { gamma: "inherited", then: 1 });
Object.freeze(objects[4]);
console.log(objects.map(o => String(sum(o, 20))).join(), objects.map(o => absent(o, 20)).join(), objects.map(o => String(o.gamma)).join());
//// primitive-names-after-second-realm.js
// Once a second realm exists, whose prototype a string, a number, a boolean or a symbol has hangs on the realm of the code that asks. Names asked of such values by code that does not know what it is handed must still be
// answered rightly, and without asking the run time every time.
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;
const lines = [];
const cases = [
  ["string.startsWith", (v) => v.startsWith("a"), "abc"], ["string.indexOf", (v) => v.indexOf("c"), "abc"], ["string.slice", (v) => v.slice(1), "abc"], ["string.nowhere", (v) => v.nowhere, "abc"], ["string.constructor", (v) => v.constructor.name, "abc"],
  ["string.hasOwnProperty", (v) => v.hasOwnProperty("length"), "abc"], ["string.length", (v) => v.length, "abc"], ["number.toString", (v) => v.toString(), 5], ["number.toFixed", (v) => v.toFixed(1), 2.5], ["number.nowhere", (v) => v.nowhere, 7],
  ["boolean.toString", (v) => v.toString(), true], ["boolean.valueOf", (v) => v.valueOf(), false], ["symbol.toString", (v) => v.toString(), Symbol.for("made")], ["symbol.nowhere", (v) => v.nowhere, Symbol.iterator], ["symbol.constructor", (v) => v.constructor.name, Symbol.iterator],
  ["symbol.description", (v) => v.description, Symbol.for("made")],
];
function round(tag, most) {
  for (const [what, f, value] of cases) {
    let last;
    for (let i = 0; i < 50; i++) last = f(value);
    const before = count("operationAOTGetByIdAndCache");
    for (let i = 0; i < 1000; i++) last = f(value);
    const asked = count("operationAOTGetByIdAndCache") - before;
    lines.push(tag + " " + what + ": " + String(last) + (asked <= most(what) ? "" : ": THE RUN TIME WAS ASKED " + asked + " TIMES"));
  }
}
const accessors = new Set(["symbol.description"]);
round("one realm", (what) => (accessors.has(what) ? 1000 : 20));
if (typeof createGlobalObject === "function") lines.push("another realm: " + typeof createGlobalObject());
else lines.push("another realm: " + typeof require("node:vm").createContext({}));
round("two realms", (what) => (accessors.has(what) ? 1000 : 20));
console.log(lines.join("\n"));
//// private-fields-grow-storage.js
// Private fields added to objects that have no room left in line: the first storage out of line, and storage doubled (4, 8, 16, 32 places); objects born elsewhere and stamped by a constructor that
// returns them; arrays and objects with elements, functions, objects with a null prototype, frozen and sealed objects, proxies; adding twice (TypeError); values kept across collections.
const lines = [];
const attempt = f => { try { return f(); } catch (error) { return error.constructor.name; } };
function Returns(x) { return x; }
class Stamp extends Returns {
    #a = 1; #b = 2; #c = 3; #d = 4; #e = 5; #f = 6; #g = 7; #h = 8; #i = 9; #j = 10; #k = 11; #l = 12; #m = 13; #n = 14; #o = 15; #p = 16; #q = 17; #r = 18; #s = 19; #t = 20;
    #u = [21]; #v = { v: 22 }; #w = "23"; #x = 24.5; #y = null; #z = undefined;
    static sum(x) { return x.#a + x.#b + x.#c + x.#d + x.#e + x.#f + x.#g + x.#h + x.#i + x.#j + x.#k + x.#l + x.#m + x.#n + x.#o + x.#p + x.#q + x.#r + x.#s + x.#t + x.#u[0] + x.#v.v + x.#w + x.#x + x.#y + x.#z; }
    static has(x) { return [#a in x, #j in x, #z in x].join(); }
    static bump(x) { x.#a++; x.#t += 100; x.#z = "z"; return x.#a + "," + x.#t + "," + x.#z; }
}
function plain(n) { const o = {}; for (let i = 0; i < n; i++) o["p" + i] = i; return o; }
for (const n of [0, 1, 3, 5, 6, 7, 9, 10, 13, 14, 21, 22, 40, 70]) {
    const o = plain(n);
    new Stamp(o);
    o.after = "after";
    lines.push(n + " " + Stamp.sum(o) + " " + Stamp.has(o) + " " + Object.keys(o).length + " " + o["p" + (n - 1)] + " " + o.after + " " + Stamp.bump(o) + " " + attempt(() => new Stamp(o)));
}
const others = { array: [1, 2, 3], holey: [1, , 3], doubles: [1.5, 2.5], empty: [], withElements: { 0: "a", 1: "b", length: 2 }, func: function () {}, arrow: () => {}, nullProto: Object.create(null), map: new Map([[1, 2]]),
    date: new Date(0), typed: new Uint8Array(3), frozen: Object.freeze({ f: 1 }), sealed: Object.seal({ s: 1 }), notExtensible: Object.preventExtensions({ n: 1 }), proxy: new Proxy({}, {}), args: (function () { return arguments; })(1, 2), regexp: /x/g, error: new Error("e"), boxed: new String("abc") };
for (const [name, o] of Object.entries(others)) lines.push(name + " " + attempt(() => { new Stamp(o); return Stamp.sum(o) + " " + Stamp.has(o) + " " + JSON.stringify(Object.keys(o)) + " " + (Array.isArray(o) ? o.join() + " " + o.push(9) + " " + o.join() : "") + " " + Stamp.bump(o); }));
class Grows {
    pub0 = 0; #p0 = "a"; pub1 = 1; #p1 = "b"; pub2 = 2; #p2 = "c"; pub3 = 3; #p3 = "d"; pub4 = 4; #p4 = "e"; pub5 = 5; #p5 = "f"; pub6 = 6; #p6 = "g"; pub7 = 7; #p7 = "h"; pub8 = 8; #p8 = "i"; pub9 = 9; #p9 = "j";
    all() { return this.#p0 + this.#p1 + this.#p2 + this.#p3 + this.#p4 + this.#p5 + this.#p6 + this.#p7 + this.#p8 + this.#p9 + Object.values(this).join(""); }
}
class GrowsMore extends Grows { #q0 = 0; #q1 = 1; #q2 = 2; #q3 = 3; #q4 = 4; #q5 = 5; #q6 = 6; #q7 = 7; more() { return this.all() + this.#q0 + this.#q1 + this.#q2 + this.#q3 + this.#q4 + this.#q5 + this.#q6 + this.#q7; } }
lines.push(new Grows().all(), new GrowsMore().more());
const kept = [];
let check = 0;
for (let i = 0; i < 3000; i++) {
    const o = plain(i % 12);
    new Stamp(o);
    if (i % 100 === 0) kept.push(o);
    check = (check + Stamp.sum(o).length + new GrowsMore().more().length) % 100003;
}
lines.push(check + " " + kept.map(o => Stamp.sum(o).length + Object.keys(o).length).join());
console.log(lines.join("\n"));
