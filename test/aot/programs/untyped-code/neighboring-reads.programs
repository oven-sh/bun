const values = [
  0, -0, 1, -1, 2147483647, -2147483648, 2147483648, -2147483649, 4294967296, 9007199254740991, -9007199254740991, 9007199254740992, -9007199254740992,
  0.5, -0.5, 1.0000000000000002, 1e21, -1e21, 1e308, 5e-324, Number.MAX_VALUE, Number.MIN_VALUE, Number.EPSILON,
  NaN, -NaN, Infinity, -Infinity,
  undefined, null, true, false, "", "1", "NaN", "Infinity", " 12 ", 1n, 0n, Symbol.iterator,
  {}, [], [1], [NaN], () => 1, new Number(1), new Number(NaN), new Date(0), /x/,
  { valueOf() { throw new Error("valueOf must not run"); } },
  { [Symbol.toPrimitive]() { throw new Error("toPrimitive must not run"); } },
];

function describe(value) {
  if (typeof value === "symbol") return "symbol";
  if (typeof value === "bigint") return value + "n";
  if (typeof value === "function") return "function";
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "object" && value !== null) return Object.prototype.toString.call(value);
  return Object.is(value, -0) ? "-0" : String(value);
}

function ask(value) {
  return [Number.isNaN(value), Number.isFinite(value), Number.isInteger(value), Number.isSafeInteger(value)].map(answer => (answer ? "T" : "f")).join("");
}

for (const value of values) console.log(describe(value), ask(value));

function countSafe(list) {
  let count = 0;
  for (let i = 0; i < list.length; i++) {
    if (Number.isSafeInteger(list[i])) count++;
    if (!Number.isNaN(list[i]) && Number.isFinite(list[i]) && !Number.isInteger(list[i])) count += 100;
  }
  return count;
}
console.log(countSafe(values));

const parsed = JSON.parse('{"a":1,"b":1.5,"c":"1","d":null,"e":1e400,"f":-0,"g":9007199254740993,"h":[2]}');
for (const key in parsed) console.log(key, ask(parsed[key]));

console.log(Number.isNaN(), Number.isFinite(), Number.isInteger(), Number.isSafeInteger());
console.log(Number.isNaN(NaN, 1), Number.isFinite(1, "x"), Number.isInteger(1.5, 1), Number.isSafeInteger(2 ** 53, 1));

function viaBranch(value) {
  if (Number.isInteger(value)) return "integer";
  if (Number.isFinite(value)) return "finite";
  if (Number.isNaN(value)) return "nan";
  return typeof value;
}
console.log(values.map(viaBranch).join(" "));
//// numbers-boxed-and-reread.js
// Numbers of plain JavaScript that are made and looked at again at once: lengths, character codes and counters in loops over strings and arrays of unknown type, at the edges of int32 too.
const scan = (text, from) => {
  let i = from, sum = 0;
  for (; i < text.length; i++) {
    const code = text.charCodeAt(i);
    if (code === 37) return "percent at " + i;
    if (code === 63) break;
    sum += code;
  }
  return i + ":" + sum;
};
const countDown = (list) => {
  let n = 0;
  for (let i = list.length - 1; i >= 0; i--) n += list[i].length;
  return n;
};
const step = (start, by, turns) => {
  let i = start;
  for (let k = 0; k < turns; k++) i += by;
  return i;
};
const holder = { scan, countDown, step };
const texts = JSON.parse('["http://localhost/user","/a?b","100%","","\\u20ac\\u20ac?","plain"]');
for (const text of texts) console.log(holder.scan(text, 0), holder.scan(text, 2), holder.scan(text, 100), holder.scan(text, -0), holder.scan(text, 1.5), holder.scan(text, "1"), holder.scan(text, undefined));
console.log(holder.scan({ length: 3, charCodeAt: (i) => 60 + i }, 0), holder.scan({ length: 2.5, charCodeAt: (i) => i / 2 }, 0), holder.scan({ length: "2", charCodeAt: () => "7" }, 0));
console.log(holder.countDown(texts), holder.countDown([[1, 2], "abc", { length: 0.5 }]), holder.countDown([]));
console.log(holder.step(2147483640, 1, 10), holder.step(-2147483640, -1, 10), holder.step(2147483647, 2147483647, 3), holder.step(0, 0.5, 3), holder.step("a", 1, 2), holder.step(0, -0, 1), Object.is(holder.step(-0, -0, 1), -0), String(holder.step(1n, 2n, 3)));
let total = 0;
for (let turn = 0; turn < 20000; turn++) total += holder.scan(texts[turn % 6], turn & 3).length + holder.step(turn, 3, 4);
console.log(total);
