//// object-values-typed-objects.ts
interface T { a?: number; b: number; c?: string; d?: unknown }
interface Numbers { i: number; f: number; z: number; n: number; big: number; neg: number }
class Base { constructor(public v: number) {} method() { return 1; } get twice() { return this.v * 2; } }
class Heir extends Base { w = "w"; #secret = 1; get secret() { return this.#secret; } }
function hide(value: unknown): any { return value; }
let count = 0;
function show(name: string, make: () => unknown) {
  let out: string;
  try { out = JSON.stringify(make(), (_k, v) => v === undefined ? "undefined" : typeof v === "number" && (v !== v || Object.is(v, -0) || !isFinite(v)) ? "number " + (Object.is(v, -0) ? "-0" : String(v)) : typeof v === "symbol" ? "symbol" : typeof v === "function" ? "function" : v); } catch (e) { out = "THROWN " + (e as Error).name + ": " + (e as Error).message; }
  console.log(String(++count).padStart(2, "0"), name + ":", out);
}
function values(x: any) { return Object.values(x); }
function looped(x: any) { const out: unknown[] = []; for (const v of Object.values(x)) out.push(v); return out; }
function counted(x: any) { return Object.values(x).length; }
const every = (x: unknown) => [values(x), looped(x), counted(x), Object.keys(x as object)];
const plain = (...list: [string | symbol, unknown][]): any => { const o = JSON.parse("{}"); for (const [k, v] of list) o[k] = v; return o; };
show("a record", () => every({ b: 1 } as T));
show("optional fields: set, undefined, deleted", () => { const x: T = { a: 1, b: 1 }, y: T = { a: undefined, b: 1 }, z: T = { a: 1, b: 1 }; delete z.a; return [every(x), every(y), every(z)]; });
show("objects of one shape in turn, one site", () => { const list: T[] = [{ b: 1 }, { a: 1, b: 1 }, { b: 1 }, { b: 1, c: "c" }, { a: 1, b: 1, c: "c" }, { b: 1 }]; return list.map(values); });
show("orders differ", () => { const x: T = { b: 1 }, y: T = { b: 1 }; x.a = 1; x.c = "c"; y.c = "c"; y.a = 1; return [every(x), every(y)]; });
show("a field set after the first look", () => { const x: T = { b: 1 }; const first = every(x); x.a = 5; const second = every(x); delete x.a; return [first, second, every(x)]; });
show("numbers", () => every({ i: 1, f: 1.5, z: -0, n: NaN, big: 2147483648, neg: -2147483649 } as Numbers));
show("values of every kind, and they are the same things", () => { const inner: T = { b: 2 }, f = () => 1, s = Symbol("s"), list = [1]; const x: T = { b: 1, d: inner }; const y = { p: null, q: true, r: "s", s: f, t: s, u: list, v: 10 }; const got = values(y); return [every(x), values(x)[1] === inner, got[3] === f, got[4] === s, got[5] === list, got.length]; });
show("instances", () => [every(new Base(1)), every(new Heir(2))]);
show("extras: a string, an index, a symbol, hidden, an accessor", () => { const x: T = { b: 1 }; hide(x).zz = 1; const one = every(x); hide(x)[0] = "zero"; const two = every(x); hide(x)[Symbol.for("s")] = 2; Object.defineProperty(hide(x), "hidden", { value: 1, enumerable: false }); Object.defineProperty(hide(x), "got", { get() { return "got " + this.b; }, enumerable: true }); return [one, two, every(x)]; });
show("an extra that is deleted again", () => { const x: T = { b: 1 }; hide(x).zz = 1; delete hide(x).zz; return every(x); });
show("frozen, sealed, closed", () => [Object.freeze({ a: 1, b: 1 } as T), Object.seal({ b: 2 } as T), Object.preventExtensions({ b: 3 } as T)].map(every));
show("another prototype, a null prototype", () => [Object.setPrototypeOf(hide({ b: 1 } as T), plain(["zz", 1], ["a", 2])), Object.setPrototypeOf(hide({ b: 2 } as T), null)].map(x => [values(x), looped(x)]));
show("empty", () => [every({} as { o?: number }), every({ o: undefined } as { o?: number })]);
show("typed and plain in turn, one site", () => [{ b: 1 } as T, plain(["b", 1]), { a: 1, b: 2 } as T, plain(["zz", 1]), new Base(1), [1, 2], "ab", { b: 3 } as T, 5, true].map(values));
show("what comes back is fresh and ordinary", () => { const x: T = { a: 1, b: 2 }; const e = values(x), f = values(x); e[0] = "changed"; e.push("more"); return [e, f, x, e !== f, Array.isArray(e), Object.getPrototypeOf(f) === Array.prototype, Object.isFrozen(f)]; });
show("null and undefined", () => [null, undefined].map(x => { try { return values(x); } catch (e) { return (e as Error).name; } }));
show("many fields", () => every({ f01: 1, f02: 2, f03: 3, f04: 4, f05: 5, f06: 6, f07: 7, f08: 8, f09: 9, f10: 10, f11: 11, f12: 12, f13: 13, f14: 14, f15: 15, f16: 16, f17: 17, f18: 18, f19: 19, f20: 20 }));
show("many objects", () => { let n = 0; for (let i = 0; i < 3000; i++) { const x: T = i & 1 ? { a: i, b: i, c: "c" + i } : { b: i }; n += counted(x) + (values(x)[0] as number); } return n; });
//// objects-crossing-typed-untyped-boundary/lib.ts
export interface Options { id: string; width?: number; tags?: string[] }
export interface Item { id: number; label: string; done: boolean; meta?: { seen: number } }
export interface State { user: { name: string }; items: Item[]; winner: Item | null; label: string | null }
let state: State = { user: { name: "u" }, items: [], winner: null, label: null }
export function getState(): State { return state }
export function setState(next: State): void { state = next }
export function isCurrent(s: State): boolean { return s === state }
export function isCurrentUser(u: { name: string }): boolean { return u === state.user }
export function echo(o: Options): Options { return o }
export function same(a: Options, b: Options): boolean { return a === b }
export function touch(item: Item): void { item.done = true; item.label += "!"; (item.meta ??= { seen: 0 }).seen++ }
export function addTag(o: Options, tag: string): void { (o.tags ??= []).push(tag) }
export function sortById(list: Item[]): Item[] { return list.sort((a, b) => b.id - a.id) }
const registry = new Set<Options>()
export function register(o: Options): number { registry.add(o); return registry.size }
export function unregister(o: Options): boolean { return registry.delete(o) }
export function adder(): [Item[], (item: Item) => number] { const kept: Item[] = []; return [kept, item => kept.push(item)] }
export class Tank { last?: Item; count = 0; take(item: Item): number { this.last = item; return ++this.count } holds(item: Item): boolean { return this.last === item } }
export const kept = { id: 9, label: "kept", inner: { n: 1 } }
export function keptText(): string { return kept.label + kept.id + kept.inner.n }
export function isKeptInner(inner: { n: number }): boolean { return inner === kept.inner }
// Not imported by untyped code, and with unique property names: its types stay facts.
export interface Private { secretNumber: number; secretText: string }
export function makePrivate(n: number): Private { return { secretNumber: n, secretText: "s" + n } }
export function sumPrivate(list: Private[]): number { let sum = 0; for (const p of list) sum += p.secretNumber; return sum }
//// objects-crossing-typed-untyped-boundary/main.ts
// Objects cross between typed and untyped code: nothing is copied, no store is lost, and identity is preserved.
import { rows, offer, heldText, isHeld, makeItem, pour } from "./text.js"
import { makePrivate, sumPrivate, Tank, type Item } from "./lib"
for (const row of rows()) console.log(row.join(" | "))
// The other direction: typed code is handed objects of untyped text.
interface Mine { id: number; label: string; done: boolean }
offer((item: Mine) => { item.label = "changed" }); console.log("a callback with an annotated parameter stores |", heldText())
let got: Mine | undefined; offer((item: Mine) => { got = item }); got!.id = 10; console.log("what a callback keeps |", heldText(), isHeld(got!))
function rename(item: Item): void { item.label = "renamed" } offer(rename); console.log("a declared function as a callback |", heldText())
const made: Item = makeItem(3); made.done = true; console.log("a result in an annotated variable |", JSON.stringify(made), isHeld(made))
const tank = new Tank(); console.log("objects with methods |", pour([tank, { take(item: Mine) { item.id++; return item.id } }]), heldText(), isHeld(tank.last!))
// What does not cross.
console.log("what stays in typed code |", sumPrivate([makePrivate(1), makePrivate(2)]))
//// objects-crossing-typed-untyped-boundary/text.js
import { getState, setState, isCurrent, isCurrentUser, echo, same, touch, addTag, sortById, register, unregister, adder, Tank, kept, keptText, isKeptInner } from "./lib"
export function rows() {
  const out = []
  const o = { id: "o", width: 2 }
  out.push(["echo is the same object", echo(o) === o, same(o, echo(o))])
  addTag(o, "t"); out.push(["a store in typed code is seen here", JSON.stringify(o)])
  const item = { id: 1, label: "one", done: false }
  touch(item); touch(item); out.push(["stores to what is handed in", JSON.stringify(item)])
  out.push(["a registry by object", register(o), register(o), unregister(o), unregister(o)])
  const list = [{ id: 1, label: "a", done: false }, { id: 3, label: "c", done: true }, { id: 2, label: "b", done: false }]
  out.push(["an array is sorted where it is", sortById(list) === list, list.map(i => i.id).join()])
  const user = { name: "n" }, next = { user, items: list, winner: null, label: null }
  setState(next); out.push(["what is kept is what was handed in", getState() === next, isCurrent(next), getState().user === user, isCurrentUser(user)])
  const s = getState(); s.winner = list[0]; s.label = "w"; s.user = { name: "other" }
  out.push(["stores to a state object that is handed out", JSON.stringify(getState().winner), getState().label, isCurrentUser(s.user), getState().winner === list[0]])
  const [all, add] = adder(); const first = { id: 7, label: "f", done: false }
  out.push(["a closure of typed code", add(first), all[0] === first, all.length])
  const tank = new Tank(); out.push(["a method of a class", tank.take(first), tank.holds(first), tank.last === first, tank.count])
  kept.label = "changed"; kept.inner = { n: 5 }; out.push(["an exported object is stored to", keptText(), isKeptInner(kept.inner)])
  out.push(["more than the type says", JSON.stringify(echo({ id: "x", extra: [1, { deep: true }] }))])
  out.push(["less than the type says", JSON.stringify(echo({})), same(o, {})])
  return out
}
const held = { id: 4, label: "held", done: false }
export function offer(f) { return f(held) }
export function heldText() { return JSON.stringify(held) }
export function isHeld(x) { return x === held }
export function makeItem(id) { return { id, label: "made" + id, done: false } }
export function pour(sinks) { let sum = 0; for (const sink of sinks) sum += sink.take(held); return sum }
//// objects-filled-by-key-settle-on-shapes.js
// Objects that start empty and are filled by computed keys: where the same keys come again and again in the same order, however many such orders a program has going at once, the objects settle on shared shapes and none stays a dictionary.
import { describe } from "bun:jsc";
const build = (keys, first) => { const out = {}; for (const key of keys) out[key] = first++; return out; };
const orders = [];
for (let i = 0; i < 48; i++) orders.push(["a" + i, "b" + i, "c" + (i % 7), "d" + i]);
const kept = [], before = [];
let sum = 0;
for (let round = 0; round < 200; round++)
  for (let i = 0; i < orders.length; i++) { before[i] = kept[i]; kept[i] = build(orders[i], round); sum += kept[i][orders[i][3]] - kept[i][orders[i][0]]; }
const shape = made => describe(made).match(/Structure 0x[0-9a-f]+/)?.[0];
console.log("sum", sum);
console.log("dictionaries after two hundred rounds:", kept.filter(made => describe(made).includes("ictionary")).length);
console.log("keys", Object.keys(kept[5]).join(), Object.values(kept[47]).join());
console.log("two of one order share a shape:", kept.every((made, i) => shape(made) === shape(before[i])));
//// objects-leave-initial-structure/main.js
// An object that untyped code makes is expected to keep the shape it was made with. Whatever JavaScript lets a program do to such an object only makes the access slower: every answer is plain Bun's.
import { literal, Thing, Kind, Heir, Guarded, Sometimes, Listening, Fields, Derived, Quiet, Keyed } from "./make.js";
import { read, store, strictStore } from "./use.js";
const makers = { literal: () => literal(null, 1, "n"), Thing: () => new Thing(null, 1, "n"), Kind: () => new Kind(null, 1, "n"), Heir: () => new Heir(null, 1, "n", 2), Guarded: () => Guarded(null, 1, "n"), SometimesEarly: () => new Sometimes(null, 1, "n", 9), SometimesNot: () => new Sometimes(null, 1, "n", 0), Listening: () => new Listening(null, 1, "n"), Fields: () => new Fields(null, 1, "n"), Derived: () => new Derived(null, 1, "n"), Quiet: () => new Quiet(null, 1, "n"), KeyedApart: () => new Keyed(null, 1, "n", "apart"), KeyedOver: () => new Keyed(null, 1, "n", "id") };
const log = [];
const alterations = {
  nothing(o) { return o; },
  added(o) { o.extra = 1; return o; },
  addedMany(o) { for (let i = 0; i < 40; i++) o["k" + i] = i; return o; },
  deletedFirst(o) { delete o.raw; return o; },
  deletedRead(o) { delete o.id; return o; },
  deletedAndAddedAgain(o) { delete o.id; o.id = "again"; return o; },
  deletedLastAndAnotherAdded(o) { delete o.name; o.other = "other"; return o; },
  deletedAllAndFilledInAnotherOrder(o) { for (const key of Object.keys(o)) delete o[key]; o.name = "N"; o.id = "I"; o.sent = "S"; o.raw = "R"; return o; },
