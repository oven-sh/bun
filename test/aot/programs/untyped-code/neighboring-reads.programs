  lines.push(width + ", the longest string: " + [() => o.lengthOf(longest), () => o.ifTruthy(longest), () => o.lengthOf(o.sum(longest, "")), () => o.lengthOf(o.sum("", longest)), () => o.lengthOf(o.sum(longest, "x")), () => o.lengthOf(o.sum("x", longest)), () => o.lengthOf(o.sum(powers[30], powers[30])), () => o.lengthOf(o.sum(longest, longest))].map(attempt).join(" "));
}

const callees = [arrow, withProperties, declared, fewer, more, rest, defaults, Legacy, Constructed, Base.prototype.method, Base.make, bound, boundArrow, boundTwice, inText, String];
let total = 0;
for (let turn = 0; turn < 60000; turn++) {
  total += narrow.call(callees[turn % callees.length], turn).length;
  if (turn % 100 === 0) total += narrow.call((a, b) => "closure of turn " + turn + " " + a + b, turn).length;
  if (turn % 20000 === 19999) collect();
}
lines.push("calls: " + total);

narrow.call(later, "awaited").then(value => {
  lines.push("an async function: " + value);
  console.log(lines.join("\n"));
});
//// optional-primitives-read-by-runtime-code.ts
// Objects of the program's own types have numbers and booleans that may be absent, undefined or null. Functions made at run time read them and ask for them with `in`.
interface User { id: number; name: string; ok: boolean; score: number }
interface Loose { fraction?: number; whole?: number; flag?: boolean; orNull: number | null; orUndefined: number | undefined; flagOrNull: boolean | null; name: string }
const make = (i: number): User => ({ id: i, name: "name " + i, ok: true, score: 1.5 });
const patch: Partial<User> = { name: "other", score: 2.5 };
const lines: string[] = [];
const readers: Record<string, (o: unknown) => unknown> = Object.create(null);
const reader = (name: string) => (readers[name] ??= new Function("o", "const v = o." + name + "; return [Object.is(v, -0) ? '-0' : String(v), typeof v, '" + name + "' in o, v === undefined, v === null, v === 1, v == null, v ? 't' : 'f'].join('/');") as (o: unknown) => unknown);
const say = (label: string, names: string[], values: unknown[]) => {
  for (const name of names) {
    let first = "";
    for (let turn = 0; turn < 300; turn++) {
      const seen = values.map(value => reader(name)(value)).join(" ");
      if (!turn) first = seen;
      else if (seen !== first) { lines.push(label + " " + name + " DIFFERS at " + turn + ": " + seen); break; }
    }
    lines.push(label + " " + name + ": " + first);
  }
};
say("users", ["id", "name", "ok", "score"], [make(1), make(2.5), make(-0), make(NaN), make(Infinity), make(4294967296), patch, { ...patch }, {}]);
const loose: Loose[] = [
  { orNull: 1, orUndefined: 1, flagOrNull: true, name: "bare" },
  { fraction: 0.5, whole: 1, flag: true, orNull: null, orUndefined: undefined, flagOrNull: null, name: "full" },
  { fraction: NaN, whole: 0, flag: false, orNull: NaN, orUndefined: -0, flagOrNull: false, name: "edges" },
  { fraction: undefined, whole: undefined, flag: undefined, orNull: 1e300, orUndefined: -1e300, flagOrNull: true, name: "undefined but there" },
];
say("loose", ["fraction", "whole", "flag", "orNull", "orUndefined", "flagOrNull", "name", "missing"], loose);
const changing: Loose = { orNull: 1, orUndefined: 2, flagOrNull: null, name: "changing" };
const steps: Array<() => void> = [
  () => { changing.fraction = 1.25; }, () => { changing.whole = 7; }, () => { changing.flag = false; }, () => { changing.fraction = undefined; }, () => { delete changing.whole; },
  () => { delete changing.flag; }, () => { changing.orNull = null; }, () => { changing.orUndefined = undefined; }, () => { changing.flagOrNull = true; }, () => { changing.whole = 2147483648; }, () => { changing.fraction = -0; },
];
for (const step of steps) {
  step();
  lines.push("changing: " + ["fraction", "whole", "flag", "orNull", "orUndefined", "flagOrNull"].map(name => reader(name)(changing)).join(" "));
}
const sum = new Function("o", "return (o.id ?? 0) + (o.score ?? 0) + (o.ok ? 1 : 0);") as (o: unknown) => number;
let total = 0;
const both = [make(3), patch, make(0.25)];
for (let turn = 0; turn < 150000; turn++) total += sum(both[turn % 3]);
lines.push("sums: " + total);
console.log(lines.join("\n"));
//// other-realm-code.ts
// Code that runs in another realm (node:vm contexts, ShadowRealm) has built-ins of its own and works beside the compiled program. One row differs from plain Bun: a ShadowRealm cannot import a module that was compiled, and Bun's own modules are: importValue throws a TypeError.
import vm from "node:vm";
import path from "node:path";
const out: string[] = [];
out.push("vm " + vm.runInNewContext("[1,2,3].map(x => x * k).join()", { k: 3 }));
const ctx = vm.createContext({ n: 2, log: (s: string) => out.push("fromctx " + s) });
vm.runInContext("function f(a) { return a * n } log(String(f(21))); class C { m() { return 'm' + n } } log(new C().m())", ctx);
out.push("script " + new vm.Script("n + 1").runInContext(ctx));
try { const r = new (globalThis as any).ShadowRealm(); out.push("shadow " + r.evaluate("[1,2,3].reduce((a, b) => a + b, 0)")); const f = r.evaluate("(x) => x * 2"); out.push("shadowfn " + f(21)); } catch (e: any) { out.push("shadow threw " + e?.name); }
try { const r = new (globalThis as any).ShadowRealm(); const v = await r.importValue("node:path", "sep"); out.push("shadowimport " + v); } catch (e: any) { out.push("shadowimport threw " + e?.name); }
out.push("path " + path.posix.join("a", "b"));
console.log(out.join("\n"));
//// other-realm-loads-file-written-at-run-time.js
// Another realm can't import a module that was compiled into the executable: untyped-code/program-required-by-other-realm. A file that isn't in the executable, here one that is written at run time, loads there as in plain Bun. Only a build with --compile-inspector or --external loads code that isn't in the executable, so this one has --compile-inspector.
import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

const folder = mkdtempSync(join(tmpdir(), "other-realm-loads-file-"));
try {
  const path = join(folder, "outside.mjs");
  writeFileSync(path, `export const value = "loaded in the other realm";\n`);
  const realm = new ShadowRealm();
  console.log(await realm.importValue(path, "value"));
  console.log(realm.evaluate("[1, 2, 3].map(n => n * 2).join()"));
} finally {
  rmSync(folder, { recursive: true, force: true });
}
//// own-functions-out-of-line-called-at-one-place.js
// A method call by name remembers at its place where the function was found. The function may be the receiver's own property outside its in-line room (an exports object, a table of handlers): the place serves that too, and goes on being right when the function is replaced, deleted, shadowed by nothing, moved by other properties coming and going, or is no function.
function table(count, from) {
  const made = {};
  for (let i = 0; i < count; i++) made["f" + (from + i)] = function (x) { return x + from + i; };
  return made;
}
function callsF40(o, x) { const got = o.f40(x); return got; }
function callsF3(o, x) { const got = o.f3(x); return got; }
const said = [];
const say = (label, run) => {
  try {
    said.push(label + " " + run());
  } catch (error) {
    said.push(label + " " + error.constructor.name);
  }
};
const wide = table(60, 0);
for (let turn = 0; turn < 20; turn++) say("own, out of line", () => callsF40(wide, turn));
wide.f40 = function (x) { return "replaced " + x; };
for (let turn = 0; turn < 3; turn++) say("replaced", () => callsF40(wide, turn));
wide.f40 = 7;
for (let turn = 0; turn < 3; turn++) say("a number", () => callsF40(wide, turn));
wide.f40 = { not: "callable" };
for (let turn = 0; turn < 3; turn++) say("an object", () => callsF40(wide, turn));
delete wide.f40;
for (let turn = 0; turn < 3; turn++) say("deleted", () => callsF40(wide, turn));
Object.setPrototypeOf(wide, { f40(x) { return "inherited " + x; } });
for (let turn = 0; turn < 3; turn++) say("inherited", () => callsF40(wide, turn));
wide.f40 = function (x) { return "own again " + x + " " + (this === wide); };
for (let turn = 0; turn < 12; turn++) say("own again", () => callsF40(wide, turn));
const others = [table(60, 0), table(50, 10), table(45, 20), table(41, 0)];
for (let turn = 0; turn < 40; turn++) say("four shapes", () => callsF40(others[turn % 4], turn));
const grows = table(41, 0);
for (let turn = 0; turn < 30; turn++) {
  say("grows", () => callsF40(grows, turn));
  grows["more" + turn] = turn;
}
for (let turn = 0; turn < 30; turn += 2) {
  delete grows["more" + turn];
  say("shrinks", () => callsF40(grows, turn));
}
const frozen = Object.freeze(table(60, 0));
for (let turn = 0; turn < 10; turn++) say("frozen", () => callsF40(frozen, turn));
const withGetter = table(60, 0);
Object.defineProperty(withGetter, "f40", { get() { return x => "through a getter " + x; }, configurable: true });
for (let turn = 0; turn < 10; turn++) say("getter", () => callsF40(turn % 2 ? withGetter : frozen, turn));
for (let turn = 0; turn < 10; turn++) say("in line and out of line", () => callsF3(turn % 2 ? table(4, 0) : frozen, turn));
for (const value of [undefined, null, 1, "text", true]) say("no object", () => callsF40(value, 1));
console.log(said.join("\n"));
