const prefix = /^[\x00-\x20]*(?:[\\/][\t\n\r]*){2,}/;
////= lines-16	tested	pattern	text	pattern.test
////= lines-16	executed	pattern	text	pattern.exec
function testedByLiteral(text) {
  return /[\x00-\x1f\x7f]/.test(text);
}
