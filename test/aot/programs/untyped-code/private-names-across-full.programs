// A function made of run-time text adds a property to objects below a literal of the program, hundreds of times. The literal has lost a property before, so it takes a new one without changing what describes it. Then it gets the name as an accessor or read-only: the next store sees it.
const make = body => new Function("target", "value", body);
const show = made => Object.keys(made).join() + "/" + made.held;

const addUnderGetter = make("target.held = value; return target;");
const withGetter = {};
Object.defineProperty(withGetter, "held", { value: "loose", writable: true, configurable: true });
addUnderGetter(Object.create(withGetter), 1);
delete withGetter.held;
for (let turn = 0; turn < 300; turn++) addUnderGetter(Object.create(withGetter), turn);
console.log("before the getter:", show(addUnderGetter(Object.create(withGetter), 1)));
Object.defineProperty(withGetter, "held", { get() { return "got"; }, configurable: true });
console.log("a getter:", show(addUnderGetter(Object.create(withGetter), 1)));
delete withGetter.held;
console.log("the getter gone:", show(addUnderGetter(Object.create(withGetter), 1)));

const addUnderReadOnly = make("target.held = value; return target;");
const withReadOnly = {};
Object.defineProperty(withReadOnly, "held", { value: "loose", writable: true, configurable: true });
addUnderReadOnly(Object.create(withReadOnly), 1);
delete withReadOnly.held;
for (let turn = 0; turn < 300; turn++) addUnderReadOnly(Object.create(withReadOnly), turn);
Object.defineProperty(withReadOnly, "held", { value: "fixed", writable: false, configurable: true });
console.log("read-only:", show(addUnderReadOnly(Object.create(withReadOnly), 1)));

const addUnderSetter = make("'use strict'; target.held = value; return target;");
const withSetter = {};
let seen = "nothing";
Object.defineProperty(withSetter, "held", { value: "loose", writable: true, configurable: true });
addUnderSetter(Object.create(withSetter), 1);
delete withSetter.held;
for (let turn = 0; turn < 300; turn++) addUnderSetter(Object.create(withSetter), turn);
Object.defineProperty(withSetter, "held", { set(value) { seen = value; }, configurable: true });
console.log("a setter:", show(addUnderSetter(Object.create(withSetter), 7)), seen);
//// runtime-text-calls-function-objects.ts
// Functions created from text at run time call and construct compiled functions that need a full function object: a function with a property of its own, a function that is both called and constructed, a class, and static methods read from the class.
type Caller = (callee: unknown, argument?: number) => unknown;
type Describe = (this: unknown, first: unknown) => string;

const callInLoop = new Function("f", "let sum = 0; for (let i = 0; i < 100; i++) sum += f(i); return sum;") as Caller;
const constructInLoop = new Function(
  "F",
  `let sizes = 0, targets = 0, instances = 0;
  for (let i = 0; i < 100; i++) {
    const object = new F(i);
    sizes += object.size;
    if (object.isNewTarget) targets++;
    if (object instanceof F) instances++;
  }
  return sizes + " " + targets + " " + instances;`,
) as Caller;
const callWithReceiver = new Function("f", "return f.call(7) + ' | ' + f.apply(null, [1, 2, 3]);") as Caller;
const callInTry = new Function(
  "f",
  "a",
  `const doubled = a * 2;
  try {
    return "returned " + f(a);
  } catch (error) {
    return "caught " + error.constructor.name + " " + (error instanceof TypeError) + " with " + doubled;
  }`,
) as Caller;

const triple: ((value: number) => number) & { calls?: number } = function (value) {
  triple.calls!++;
  return value * 3;
};
triple.calls = 0;
const describeCall: Describe & { label?: string } = function (first) {
  return `${describeCall.label}: this ${String(this)}, first ${String(first)}, ${arguments.length} arguments`;
};
describeCall.label = "function";

function Size(this: any, size: number): any {
  if (size < 0) throw new RangeError("negative size " + size);
  if (!new.target) return size + 1;
  this.size = size;
  this.isNewTarget = new.target === Size;
}

class Box {
  size: number;
  isNewTarget: boolean;
  constructor(size: number) {
    this.size = size * 2;
    this.isNewTarget = new.target === Box;
  }
  static half(value: number): number {
    return value / 2;
  }
  static describeCall(this: unknown, first: unknown): string {
    return `static method: this ${String(this)}, first ${String(first)}, ${arguments.length} arguments`;
  }
}
const half = Box.half;

const show = (label: string, ...results: unknown[]) => console.log(label + ": " + results.join(" | "));
show("compiled callers", triple(1), Size(1), new (Size as any)(2).size, new Box(2).size, half(2));
show("call", callInLoop(triple), callInLoop(Size), callInLoop(half), callInLoop(triple), triple.calls);
show("construct", constructInLoop(Size), constructInLoop(Box), constructInLoop(Size));
show("receiver and arguments", callWithReceiver(describeCall), callWithReceiver(Box.describeCall));
show("throw", callInTry(Size, 20), callInTry(Size, -20), callInTry(Size, 21));
show("class without new", callInTry(Box, 22), callInTry(half, 22), callInTry(Box, 23), callInTry(triple, 23));

export {};
//// runtime-text-polymorphic-call.ts
// Call sites in functions created from text at run time call and construct compiled, bound, native, interpreted and proxy callees while each site goes from unlinked to monomorphic, polymorphic and virtual.
type Site = (callee: unknown, a: number) => unknown;
type Callee = (a: number) => unknown;
type Entries = [number, number][];

const createCallSite = () => new Function("f", "a", "return f(a)") as Site;
const createTailCallSite = () => new Function("f", "a", '"use strict"; return f(a)') as Site;
function createConstructSite(): Site {
  const site = new Function("C", "a", "return new C(a)") as (C: unknown, a: Entries) => unknown;
  return (C, a) => site(C, [[a, a + 1]]);
}

function double(a: number) {
  return a * 2;
}
function createCounter(): Callee {
  let calls = 0;
  return a => a + 1000 * ++calls;
}
class Scale {
  factor = 3;
  createArrow(): Callee {
    return a => a * this.factor;
  }
}
async function negate(a: number) {
  return -a;
}
function* countFrom(a: number) {
  yield a;
}
const adders: Callee[] = [];
for (let i = 0; i < 20; i++) adders.push(a => a + i * 100);
const arrow = new Scale().createArrow();
const decrement = new Function("a", "b", "return b === undefined ? a - 1 : NaN") as Callee;

class Pair {
  sum: number;
  constructor(entries: Entries) {
    this.sum = entries[0][0] + entries[0][1];
  }
}
function Product(this: { product: number }, entries: Entries) {
  this.product = entries[0][0] * entries[0][1];
}

const functions: [string, unknown][] = [
  ["function", double],
  ["closure", createCounter()],
  ["arrow", arrow],
  ["loop closure", adders[7]],
  ["bound function", double.bind(null)],
  ["Math.abs", Math.abs],
  ["String", String],
  ["async function", negate],
  ["generator function", countFrom],
  ["interpreted function", decrement],
  ["proxy", new Proxy(double, { apply: (target, _receiver, [a]) => target(a) + 0.5 })],
];
const constructors: [string, unknown][] = [
  ["class", Pair],
  ["function", Product],
  ["bound class", Pair.bind(null)],
  ["Map", Map],
];

const promises: Promise<number>[] = [];
function show(value: unknown): string {
  if (value instanceof Promise) {
    promises.push(value);
    return "Promise";
  }
  if (value instanceof Map) return "Map" + JSON.stringify([...value]);
  if (typeof value !== "object" || value === null) return String(value);
  const generator = value as Generator<number>;
  if (typeof generator.next === "function") return "Generator" + generator.next().value;
  return value.constructor.name + JSON.stringify(value);
}

function run(label: string, site: Site, callees: unknown[], calls = callees.length) {
  const results: string[] = [];
  for (let turn = 0; turn < calls; turn++) {
    try {
      results.push(show(site(callees[turn % callees.length], -1 - turn)));
    } catch (error) {
      results.push((error as Error).constructor.name);
    }
  }
  console.log(label + ": " + results.join(" "));
}

function runSequences(kind: string, createSite: () => Site, callees: [string, unknown][]) {
  callees.forEach(([name, callee], index) => {
    const [nextName, next] = callees[(index + 1) % callees.length];
    run(`${kind}, ${name}`, createSite(), [callee], 12);
    run(`${kind}, ${name} and ${nextName}`, createSite(), [callee, next], 12);
  });
  const all = callees.map(([, callee]) => callee);
  run(`${kind}, every callee`, createSite(), all, all.length * 3);
  run(`${kind}, every callee in reverse`, createSite(), [...all].reverse(), all.length * 3);
}

function runCallSequences(kind: string, createSite: () => Site) {
  const mixedClosures: unknown[] = [adders[0], String, adders[1], Math.abs, decrement];
  const warmUp: unknown[] = [Math.abs, decrement, Math.abs, decrement];
  const invalid: unknown[] = [...warmUp, undefined, Math.abs, 1, decrement, {}, Math.abs, Pair, decrement, double];
  runSequences(kind, createSite, functions);
  run(`${kind}, twenty closures of one function`, createSite(), adders, 40);
  run(`${kind}, closures of one function among others`, createSite(), mixedClosures, 15);
  run(`${kind}, invalid callees`, createSite(), invalid);
}

runCallSequences("call", createCallSite);
runCallSequences("tail call", createTailCallSite);
runSequences("construct", createConstructSite, constructors);
const invalidConstructors: unknown[] = [Map, Pair, Map, Pair, arrow, Pair, Math.abs, Product, undefined, Map, {}, Pair];
run("construct, invalid callees", createConstructSite(), invalidConstructors);
Promise.all(promises).then(values => {
  console.log(`${values.length} promises, sum ${values.reduce((sum, value) => sum + value, 0)}`);
});

export {};
//// runtime-text-typed-object.ts
// Functions created from text at run time read, store, test for and delete the properties of objects that compiled TypeScript created, whatever a field holds, and get the answers an ordinary object gives.
class Point { constructor(public x: number, public y: number) {} }
type Mode = "idle" | "busy" | "done";
enum Level { Low, Middle, High }
class Item {
  small: number = 7; wide: number = 2147483647; big: number = 9007199254740991; ratio: number = 0.5; count: number = 1;
  maybeNumber: number | undefined = undefined; nullableNumber: number | null = null;
  flag: boolean = true; maybeFlag: boolean | undefined = undefined;
  text: string = "text"; mode: Mode = "idle"; level: Level = Level.Middle;
  child: Point = new Point(1, 2); maybeChild: Point | null = null; list: number[] = [1, 2, 3];
  anything: unknown = "any"; huge: bigint = 12345678901234567890n; key: symbol = Symbol.for("key");
  handler = () => this.small; plain = function () { return 1; };
  method(): number { return this.small + 1; }
  get doubled(): number { return this.small * 2; }
  set doubled(value: number) { this.small = value / 2; }
}
interface Options { name: string; size?: number; nested?: { deep: number }; on?: boolean }
const makeOptions = (): Options => ({ name: "options" });

type Step = (o: any) => unknown;
type Store = (o: any, value: unknown) => unknown;
type Operation = string | Step;
type FieldCase = { createFittingValues: () => unknown[]; misfits: unknown[] };

const fromFunction = (parameters: string, body: string): any => new Function(...parameters.split(","), body);
const fromEval = (parameters: string, body: string): any => (0, eval)("(function (" + parameters + ") { " + body + " })");
const createNamedFunctions = (field: string) => ({
  readNamed: fromFunction("o", "return o." + field + ";"),
  storeNamed: fromFunction("o,v", "o." + field + " = v; return o." + field + ";"),
  storeStrict: fromFunction("o,v", "'use strict'; o." + field + " = v; return o." + field + ";"),
  hasNamed: fromFunction("o", "return '" + field + "' in o;"),
  deleteNamed: fromFunction("o", "return delete o." + field + ";"),
});
const readKeyed = fromEval("o,k", "return o[k];");
const storeKeyed = fromEval("o,k,v", "o[k] = v; return o[k];");
const hasKeyed = fromEval("o,k", "return k in o;");
const ownKeyed = fromEval("o,k", "return Object.prototype.hasOwnProperty.call(o, k);");
const deleteKeyed = fromEval("o,k", "return delete o[k];");
const inspect = fromEval("o,show", "return Reflect.ownKeys(o).map(function (k) { return String(k) + '=' + show(o[k]); }).join(' ');");
const makeOrdinaryCopy = fromEval("source", "var copy = Object.create(Object.getPrototypeOf(source)); Reflect.ownKeys(source).forEach(function (k) { copy[k] = source[k]; }); return copy;");

const lines: string[] = [];
let steps = 0;
let differences = 0;
let item: any;
let ordinaryCopy: any;

function show(value: unknown): string {
  if (typeof value === "number") return Object.is(value, -0) ? "-0" : String(value);
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "bigint") return value + "n";
  if (typeof value === "function") return "function " + value.name;
  if (typeof value !== "object" || value === null) return String(value);
  if (Array.isArray(value)) return "[" + value.map(show).join(",") + "]";
  const object = value as Record<string, unknown>;
  return "{" + Object.keys(object).map(key => key + ":" + show(object[key])).join(",") + "}";
}

function attempt(run: () => string): string {
  try {
    return run();
  } catch (error) {
    return "throws " + (error as Error).constructor.name;
  }
}
const outcome = (run: () => unknown): string => attempt(() => show(run()));

function reportDifference(text: string): void {
  differences++;
  lines.push("  DIFFERS " + text);
}

function checkEqual(label: string, a: string, b: string): boolean {
  if (a === b) return true;
  reportDifference(label + ": " + a + " | " + b);
  return false;
}

function createPair(typed: object = new Item()): void {
  item = typed;
  ordinaryCopy = makeOrdinaryCopy(typed);
}

function warmUp(step: Step): void {
  for (let turn = 0; turn < 4; turn++) step(new Item());
}

function both(label: string, step: Step): string {
  const a = outcome(() => step(item)), b = outcome(() => step(ordinaryCopy));
  steps++;
  if (checkEqual(label, a, b)) checkEqual(label + ", inspect", attempt(() => inspect(item, show)), attempt(() => inspect(ordinaryCopy, show)));
  return b;
}

const compiledArrow = () => 5;
const markerLikeNaNs = new Float64Array(new BigUint64Array([0x7ffa000000000000n, 0x7ffb000000000000n, 0x7ffc000000000000n, 0xfff8000000000001n]).buffer);
const numbers: unknown[] = [
  0, -0, 1, -1, 0.5, NaN, Infinity, -Infinity, 255, 256, 65535, 65536, 2147483647, 2147483648,
  -2147483648, -2147483647, -2147483646, -2147483645, -2147483644, -2147483643,
  4294967295, 4294967296, 9007199254740991, 5e-324, 1e300, null, undefined, ...markerLikeNaNs,
];
const numberField: FieldCase = { createFittingValues: () => numbers, misfits: ["string"] };
const booleanField: FieldCase = { createFittingValues: () => [true, false, null, undefined], misfits: [1] };
const pointField: FieldCase = { createFittingValues: () => [new Point(3, 4), fromFunction("", "return { x: 5, y: 6 };")(), null, undefined], misfits: [7] };
const functionField: FieldCase = { createFittingValues: () => [compiledArrow, fromFunction("", "return 6;"), null, undefined], misfits: [3] };
const fieldCases: Record<string, FieldCase> = {
  small: numberField, wide: numberField, big: numberField, ratio: numberField, count: numberField,
  maybeNumber: numberField, nullableNumber: numberField,
  flag: booleanField, maybeFlag: booleanField,
  text: { createFittingValues: () => ["", "a", "idle", "left" + String(steps), "é€", null, undefined], misfits: [5] },
  mode: { createFittingValues: () => ["busy", "done", "idle", null, undefined], misfits: ["other"] },
  level: { createFittingValues: () => [0, 2, 1, null, undefined], misfits: ["Low"] },
  child: pointField, maybeChild: pointField,
  list: { createFittingValues: () => [[], [1.5, -0], fromFunction("", "return [4, 5];")(), null, undefined], misfits: ["no list"] },
  anything: { createFittingValues: () => [1, 1.5, "s", true, null, undefined, {}, [], 1n, Symbol.for("a"), compiledArrow], misfits: [] },
  huge: { createFittingValues: () => [0n, -1n, 2n ** 64n, null, undefined], misfits: [1] },
  key: { createFittingValues: () => [Symbol.for("other"), Symbol.iterator, null, undefined], misfits: ["k"] },
  handler: functionField, plain: functionField,
};
const fields = Object.keys(fieldCases);
const namedFunctions: Record<string, ReturnType<typeof createNamedFunctions>> = {};
for (const field of fields) namedFunctions[field] = createNamedFunctions(field);

function snapshot(o: Item): string {
  return [
    o.small, o.wide, o.big, o.ratio, o.count, o.maybeNumber, o.nullableNumber, o.flag, o.maybeFlag, o.text, o.mode, o.level,
    o.child, o.maybeChild, o.list, o.anything, o.huge, o.key, o.handler, o.plain,
    o.child?.x, o.maybeChild?.y, o.list?.length, o.text?.length, o.method(), o.doubled,
    typeof o.handler === "function" ? o.handler() : "none",
    typeof o.plain === "function" ? o.plain() : "none",
  ].map(show).join(" ");
}

function checkSnapshot(label: string): void {
  try {
    checkEqual(label + ", snapshot", snapshot(item), snapshot(ordinaryCopy as Item));
  } catch (error) {
    reportDifference(label + ", snapshot throws " + (error as Error).constructor.name);
  }
}

function storeInitial(o: Item, field: string): void {
  switch (field) {
    case "small": o.small = 7; break;
    case "wide": o.wide = 2147483647; break;
    case "big": o.big = 9007199254740991; break;
    case "ratio": o.ratio = 0.5; break;
    case "count": o.count = 1; break;
    case "maybeNumber": o.maybeNumber = undefined; break;
    case "nullableNumber": o.nullableNumber = null; break;
    case "flag": o.flag = true; break;
    case "maybeFlag": o.maybeFlag = undefined; break;
    case "text": o.text = "text"; break;
    case "mode": o.mode = "idle"; break;
    case "level": o.level = Level.Middle; break;
    case "child": o.child = new Point(1, 2); break;
    case "maybeChild": o.maybeChild = null; break;
    case "list": o.list = [1, 2, 3]; break;
    case "anything": o.anything = "any"; break;
    case "huge": o.huge = 12345678901234567890n; break;
    case "key": o.key = Symbol.for("key"); break;
    case "handler": o.handler = () => o.small; break;
    case "plain": o.plain = function () { return 1; }; break;
  }
}

function checkDeleteAndAdd(field: string, label: string, remove: Step, store: Store): void {
  const { readNamed, hasNamed } = namedFunctions[field];
  createPair();
  const initial = item[field];
  both(label, remove);
  both(label + ", hasNamed", hasNamed);
  both(label + ", ownKeyed", o => ownKeyed(o, field));
  both(label + ", readNamed", readNamed);
  checkSnapshot(label);
  both(label + " again", remove);
  both(label + ", add again", o => store(o, initial));
  checkEqual(label + ", keys", Object.keys(item).join(), Object.keys(ordinaryCopy).join());
  checkSnapshot(label + ", add again");
}

function checkField(field: string): void {
  const firstStep = steps;
  const { createFittingValues, misfits } = fieldCases[field];
  const { readNamed, storeNamed, storeStrict, hasNamed, deleteNamed } = namedFunctions[field];
  const readByKey: Step = o => readKeyed(o, field);
  const storeByKey: Store = (o, value) => storeKeyed(o, field, value);
  const stores: [string, Store][] = [["storeNamed", storeNamed], ["storeStrict", storeStrict], ["storeKeyed", storeByKey]];
  const warmUpSteps: Step[] = [readNamed, hasNamed, deleteNamed, o => storeNamed(o, o[field]), o => storeStrict(o, o[field])];
  warmUpSteps.forEach(warmUp);

  createPair();
  const initial = item[field];
  both(field + " readNamed", readNamed);
  both(field + " readKeyed", readByKey);
  both(field + " hasNamed", hasNamed);
  both(field + " hasKeyed", o => hasKeyed(o, field));
  both(field + " ownKeyed", o => ownKeyed(o, field));

  for (const [name, store] of stores) {
    createFittingValues().forEach((value, index) => {
      const label = field + " " + name + " of value " + index;
      both(label, o => store(o, value));
      both(label + ", readNamed", readNamed);
      both(label + ", readKeyed", readByKey);
      checkSnapshot(label);
    });
  }

  storeInitial(item, field);
  storeInitial(ordinaryCopy, field);
  both(field + " readNamed after a compiled store", readNamed);

  for (const misfit of misfits) {
    const label = field + " misfit";
    both(label + ", storeNamed", o => storeNamed(o, misfit));
    both(label + ", readNamed", readNamed);
    both(label + ", readKeyed", readByKey);
    both(label + ", hasNamed", hasNamed);
    both(label + ", storeNamed of the initial value", o => storeNamed(o, initial));
    checkSnapshot(label);
  }

  checkDeleteAndAdd(field, field + " deleteNamed", deleteNamed, storeNamed);
  checkDeleteAndAdd(field, field + " deleteKeyed", o => deleteKeyed(o, field), storeByKey);
  lines.push(field + ": " + (steps - firstStep) + " steps, ends as " + show(readNamed(item)));
}

function createTextStep(body: string): Step {
  const run = fromFunction("o,show", body);
  const step: Step = o => run(o, show);
  warmUp(step);
  return step;
}

function checkOperations(label: string, operations: Operation[], typed: object = new Item()): void {
  createPair(typed);
  const answers = operations.map((operation, index) =>
    typeof operation === "string" ? both(label + ": " + operation, createTextStep(operation)) : both(label + ": operation " + index, operation),
  );
  lines.push(label + ": " + answers.join(" "));
}

function viaDirectEval(local: Item) {
  const before = eval("local.small + local.count");
  eval("local.small = 8; local.ratio = 2.5; delete local.maybeNumber");
  return [before, local.small, local.ratio, local.maybeNumber, eval("'maybeNumber' in local")];
}

const createIntegrityCase = (label: string, body: string): [string, Operation[]] => [label, [
  body,
  o => namedFunctions.small.storeNamed(o, 8),
  o => namedFunctions.small.storeStrict(o, 9),
  (o: Item) => (o.small = 10),
  "o.added = 1; return o.added;",
  "'use strict'; o.added = 1; return o.added;",
  (o: any) => (o.added = 1),
  namedFunctions.count.deleteNamed,
  "'use strict'; return delete o.ratio;",
  (o: Item) => delete o.maybeNumber,
  "return [Object.isFrozen(o), Object.isSealed(o), Object.isExtensible(o)];",
  (o: Item) => [Object.isFrozen(o), Object.isSealed(o), Object.isExtensible(o)],
]];

const casesWithSnapshot: [string, Operation[]][] = [
  ["extra properties", [
    'for (var i = 0; i < 20; i++) o["extra" + i] = i; o[0] = "zero"; o["1"] = "one"; o[Symbol.for("extra")] = "symbol"; return Object.keys(o).join();',
    "return [o.extra0, o.extra7, o.extra19];",
    o => ["extra7", 0, "1", Symbol.for("extra")].map(key => readKeyed(o, key)),
    "return delete o.extra3;",
    "return Object.keys(o).join();",
  ]],
  ["accessor in place of a field", [
    'Object.defineProperty(o, "small", { get: function () { return 99; }, configurable: true, enumerable: true });',
    (o: Item) => o.small,
    (o: Item) => o.method(),
  ]],
  ["read-only field", [
    'Object.defineProperty(o, "small", { value: 5, writable: false });',
    o => namedFunctions.small.storeNamed(o, 6),
    o => namedFunctions.small.storeStrict(o, 6),
    (o: Item) => (o.small = 6),
  ]],
  createIntegrityCase("freeze", "Object.freeze(o);"),
  createIntegrityCase("seal", "Object.seal(o);"),
  createIntegrityCase("preventExtensions", "Object.preventExtensions(o);"),
  ["becomes a prototype", [
    "return Object.create(o).small;",
    "var derived = Object.create(o); derived.small = 42; return [derived.small, o.small, Object.keys(derived).join()];",
    "var derived = Object.create(o); derived.doubled = 10; return [derived.small, o.small, derived.method()];",
  ]],
  ["method shadowed by an own property", [
    "o.method = function () { return -2; }; return o.method();",
    (o: Item) => o.method(),
    "return delete o.method;",
    (o: Item) => o.method(),
  ]],
  ["copies", [
    "Object.assign(o, { small: 1, extra: 2 });",
    "return show(Object.assign({}, o));",
    "return show({ ...o });",
    "return Object.entries(o).length;",
    "var seen = []; for (var k in o) seen.push(k); return seen.join();",
    'return JSON.stringify(o, function (k, v) { return typeof v === "bigint" || typeof v === "symbol" ? String(v) : v; });',
  ]],
  ["accessors and methods", ["return o.doubled;", "o.doubled = 10; return o.small;", "return o.method() + o.plain();"]],
  ["with", ["with (o) { return small + count; }", "with (o) { small = 3; } return o.small;"]],
  ["direct eval", [viaDirectEval]],
];

const sharedWarmUpSteps: Step[] = [
  o => readKeyed(o, "small"),
  o => storeKeyed(o, "small", 7),
  o => hasKeyed(o, "small"),
  o => ownKeyed(o, "small"),
  o => deleteKeyed(o, "small"),
  o => inspect(o, show),
  makeOrdinaryCopy,
];
sharedWarmUpSteps.forEach(warmUp);
fields.forEach(checkField);

for (const [label, operations] of casesWithSnapshot) {
  checkOperations(label, operations);
  checkSnapshot(label);
}
checkOperations("another prototype", [
  "Object.setPrototypeOf(o, { method: function () { return -1; } });",
  (o: Item) => o.method(),
  (o: Item) => "doubled" in o,
]);

const closureSteps: Step[] = [
  createTextStep("return o.handler() === o.small;"),
  createTextStep("var h = o.handler; return h() === o.small;"),
  createTextStep("return o.handler === o.handler;"),
  createTextStep("return ({ ...o }).handler === o.handler;"),
  (o: Item) => namedFunctions.handler.readNamed(o) === o.handler,
  (o: Item) => o.handler === namedFunctions.handler.readNamed(o),
];
lines.push("closure in a field: " + closureSteps.map(step => outcome(() => step(new Item()))).join(" "));

const optionalMembers: [string, unknown][] = [["size", 3], ["nested", { deep: 1 }], ["on", true]];
const [size, nested, on] = optionalMembers;
const createMemberStore = ([key, value]: [string, unknown]): Step => o => storeKeyed(o, key, value);
const readOptions = (o: Options) => [o.size, o.nested?.deep, o.on];
checkOperations(
  "typed literal with absent fields",
  [
    ...optionalMembers.flatMap(([key]): Step[] => [o => hasKeyed(o, key), o => readKeyed(o, key)]),
    ...optionalMembers.map(createMemberStore),
    readOptions,
    ...optionalMembers.map(([key]): Step => o => deleteKeyed(o, key)),
    readOptions,
    ...[on, size, nested].map(createMemberStore),
    o => inspect(o, show),
    readOptions,
  ],
  makeOptions(),
);

createPair();
const callees = [item.handler, item.plain, item.method, Item.prototype.method, compiledArrow, fromFunction("", "return 6;")];
const callEach = fromFunction("callees,o", "var out = []; for (var turn = 0; turn < 50; turn++) for (var i = 0; i < callees.length; i++) out.push(callees[i].call(o)); return out.length + ':' + out.slice(-callees.length).join();");
const callEveryCallee: Step = o => callEach(callees, o);
warmUp(callEveryCallee);
lines.push("one call site, many callees: " + both("one call site, many callees", callEveryCallee));

const objects: any[] = [];
for (let index = 0; index < 50; index++) {
  const typed = new Item();
  typed.small = index;
  typed.ratio = index / 4;
  typed.child = new Point(index, -index);
  if (index % 3 === 0) {
    namedFunctions.wide.deleteNamed(typed);
    namedFunctions.wide.storeNamed(typed, 2147483647);
  }
  objects.push(index % 7 === 0 ? makeOrdinaryCopy(typed) : typed);
}
let sum = 0;
let last: any[] = [];
for (const object of objects) {
  last = [namedFunctions.small.readNamed(object), namedFunctions.ratio.readNamed(object), namedFunctions.child.readNamed(object)];
  sum += last[0] + last[1] + last[2].x;
}
lines.push("many objects at one site: " + sum + " " + show(last));

lines.push(steps + " steps", differences === 0 ? "every answer agrees" : differences + " answers differ");
console.log(lines.join("\n"));

export {};
//// set-constructed-from-anything.js
// `new Set(x)`: arrays of every kind, other iterables, what is not iterable, and what can be observed of the construction.
const lines = [];
////= say-3
function make(items) {
  return new Set(items);
}
const show = set => [set instanceof Set, set.size, [...set]];

const object = { id: 1 };
const long = Array.from({ length: 500 }, (_, i) => i % 300);
const sparse = [];
sparse[2000] = "far";
for (let turn = 0; turn < 3; turn++) {
  say("strings " + turn, () => show(make(["http:", "https:", "mailto:", "tel:"])));
  say("integers " + turn, () => show(make([3, 1, 2, 3, 1, turn])));
  say("fractions " + turn, () => show(make([0.5, 1.5, 0.5, turn + 0.25])));
  say("mixed " + turn, () => show(make(["a", 1, "1", 1.0, null, undefined, null, true, object, object, { id: 1 }])));
  say("empty " + turn, () => show(make([])));
}
say("zeros and NaN", () => { const set = make([0, -0, NaN, NaN, 0 / 1]); return [set.size, Object.is([...set][0], 0), set.has(-0), set.has(NaN)]; });
say("holes", () => show(make([1, , 3, , undefined])));
say("holes among fractions", () => show(make([0.5, , 1.5])));
say("only holes", () => show(make(new Array(4))));
say("a long array", () => { const set = make(long); return [set.size, set.has(299), set.has(300), [...set].slice(-2)]; });
say("a sparse array", () => { const set = make(sparse); return [set.size, set.has("far"), set.has(undefined)]; });
say("ropes and parts of strings", () => { const left = "ab" + lines.length; return show(make([left + "c", (left + "cd").slice(0, -1), "x" + left])).slice(1, 2); });
say("big integers and symbols", () => { const symbol = Symbol("s"); const set = make([1n, 1n, 2n ** 70n, 2n ** 70n, symbol, symbol, Symbol("s")]); return set.size; });
say("the order of insertion", () => [...make(["b", "a", "c", "a", "b", "d"])]);
say("the array is not kept", () => { const array = [1, 2]; const set = make(array); array.push(3); set.add(4); return [array, [...set]]; });
say("a frozen array", () => show(make(Object.freeze([1, 2, 2]))));
say("an array with a name on it", () => show(make(Object.assign([1, 2], { extra: 3 }))));

say("nothing", () => [show(new Set()), show(make(undefined)), show(make(null))]);
say("more arguments", () => show(new Set([1, 2], [3, 4])));
say("a string", () => show(make("hello")));
say("a set", () => { const first = make([1, 2]); const second = make(first); second.add(3); return [show(first), show(second)]; });
say("a map", () => show(make(new Map([["a", 1]]))));
say("the keys of a map", () => show(make(new Map([["a", 1], ["b", 2]]).keys())));
say("a typed array", () => show(make(new Uint8Array([1, 2, 1]))));
say("arguments", () => (function () { return show(make(arguments)); })(1, 1, 2));
say("a generator", () => show(make((function* () { yield 1; yield 1; yield 2; })())));
say("an iterable of my own", () => { let left = 3; return show(make({ [Symbol.iterator]() { return { next: () => ({ done: left === 0, value: left-- }) }; } })); });
for (const [name, value] of Object.entries({ "a number": 5, "true": true, "an object": {}, "a function": () => {}, "what is like an array": { length: 2, 0: "a", 1: "b" } })) say(name, () => show(make(value)));
say("a symbol", () => make(Symbol("s")));

class Stack extends Array {}
say("a subclass of Array", () => show(make(Stack.from([1, 1, 2]))));
say("a subclass with an iterator of its own", () => { class Odd extends Array { *[Symbol.iterator]() { yield "odd"; } } return show(make(Odd.from([1, 2]))); });
say("an array with an iterator of its own", () => { const array = [1, 2]; array[Symbol.iterator] = function* () { yield "own"; }; return show(make(array)); });
say("an array under another prototype", () => { const array = Object.setPrototypeOf([1, 2], { [Symbol.iterator]: function* () { yield "other"; } }); return show(make(array)); });
say("an array that is not iterable", () => make(Object.setPrototypeOf([1, 2], null)));
say("an accessor at an index", () => { const order = []; const array = [1, 2, 3]; Object.defineProperty(array, 1, { get() { order.push("read"); array.length = 2; return "got"; } }); return [show(make(array)), order]; });
say("a proxy of an array", () => { const asked = []; const set = make(new Proxy([1, 2], { get(target, key, receiver) { asked.push(String(key)); return Reflect.get(target, key, receiver); } })); return [show(set), asked]; });

class Counted extends Set {
  constructor(items) {
    super(items);
    this.made = true;
  }
  add(item) {
    Counted.added.push(item);
    return super.add(item);
  }
}
Counted.added = [];
say("a subclass of Set with an add of its own", () => { const set = new Counted([1, 2, 2]); return [set.made, set.size, Counted.added, set instanceof Counted]; });
say("Reflect.construct", () => { const set = Reflect.construct(Set, [[1, 2]], Counted); return [set instanceof Counted, set.size, Counted.added.length]; });
say("called without new", () => Set([1]));
say("held in a variable", () => { const Held = Set; return show(new Held([1, 1, 2])); });

console.log(lines.join("\n"));
//// set-for-each-of-unknown-receiver.js
// Set.prototype.forEach on receivers whose type the compiler does not know: the order of visits, what a callback may do to the set meanwhile, this, the errors.
const said = [];
const walk = (set, f, ...rest) => set.forEach(f, ...rest);
const show = (label, set, f) => { const seen = []; walk(set, (value, key, whole) => { seen.push(String(value) + (value === key || (value !== value && key !== key) ? "" : "!") + (whole === set ? "" : "?")); if (f) f(value, whole); }); said.push(label + ": " + seen.join(" ") + " | size " + set.size); };
const filled = n => { const set = new Set(); for (let i = 0; i < n; i++) set.add("k" + i); return set; };
const number = value => +value.slice(1);
show("empty", new Set());
show("fifteen", filled(15));
show("values of every kind", new Set([1, "1", NaN, -0, null, undefined, 1.5, 10n, Symbol.for("s"), true, 1, NaN, 0]));
show("the one visited is deleted", filled(6), (value, set) => set.delete(value));
show("the next one is deleted", filled(6), (value, set) => set.delete("k" + (number(value) + 1)));
show("an earlier one is deleted", filled(6), (value, set) => { if (number(value) > 1) set.delete("k" + (number(value) - 2)); });
show("values are added while fewer than twelve", filled(3), (value, set) => { if (set.size < 12) set.add("more" + set.size); });
show("deleted and added again", filled(4), (value, set) => { if (value === "k1") { set.delete("k0"); set.add("k0"); } });
show("cleared at the second", filled(5), (value, set) => { if (value === "k1") set.clear(); });
show("cleared and filled again", filled(5), (value, set) => { if (value === "k1") { set.clear(); set.add("new"); set.add("newer"); } });
show("grows far beyond its table", filled(2), (value, set) => { if (set.size < 300) for (let i = 0; i < 40; i++) set.add("g" + set.size); });
{
  const set = filled(3); const seen = [];
  walk(set, function () { "use strict"; seen.push(this === undefined ? "undefined" : typeof this); });
  walk(set, function () { seen.push(this.tag); }, { tag: "given" });
  walk(set, function () { "use strict"; seen.push(String(this)); }, 5);
  said.push("this: " + seen.join(" "));
}
{
  class Counted extends Set { constructor(values) { super(values); this.asked = 0; } has(value) { this.asked++; return super.has(value); } }
  const set = new Counted(["a", "b"]);
  show("a subclass", set); said.push("has was not asked: " + set.asked);
}
const attempt = f => { try { return "returns " + String(f()); } catch (error) { return error.constructor.name + ": " + error.message; } };
for (const receiver of [{}, [], new Map([[1, 1]]), new WeakSet(), null, undefined, 5, "text", Object.create(Set.prototype)])
  said.push("on " + (receiver === null ? "null" : Array.isArray(receiver) ? "an array" : typeof receiver === "object" ? receiver.constructor?.name ?? "an object" : typeof receiver) + ": " + attempt(() => Set.prototype.forEach.call(receiver, () => 0)));
for (const callback of [undefined, null, 5, "f", {}, class {}])
