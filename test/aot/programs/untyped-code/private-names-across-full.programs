}
function check(o, i0) {
  const keys = Object.keys(o).filter(key => key[0] === "p");
  let bad = 0;
  for (let i = 0; i < 70; ++i) {
    if (keys[i] !== "p" + i || plain(o["p" + i]) !== i0 + i) ++bad;
