//// several-properties-of-one-object-read-in-a-loop.js
// A loop that reads or writes several properties of the object it walks over, in a function that is called once: the objects have the one shape the names suggest, then another shape with the same names, accessors, a prototype that holds a name, a proxy, a primitive; and the shape changes between two reads of one turn.
const print = (s) => console.log(s);
function add(parent, key, value) {
  return { key, value, parent };
}
////= find
function sum(list) {
  let total = 0;
  for (let entry = list; entry; entry = entry.parent) {
    total += entry.value;
    entry.value = total;
    total += entry.key.length;
  }
  return total;
}
let list;
for (let i = 0; i < 6; i++)
  list = add(list, "k" + i, i);
print(find(list, "k0") + " " + find(list, "k5") + " " + find(list, "k9"));
print(sum(list) + " " + sum(list) + " " + find(list, "k2"));

const reordered = { parent: list, value: 100, key: "reordered" };
const wider = { key: "wider", value: 200, parent: reordered, more: 1 };
const inherited = Object.create({ key: "inherited", value: 300 });
inherited.parent = wider;
let reads = 0;
const computed = {
  get key() {
    reads++;
    return "computed";
  },
  get value() {
    reads++;
    return 400;
  },
  set value(v) {
    reads += 10;
  },
  get parent() {
    reads++;
    return inherited;
  },
};
const trapped = new Proxy({ key: "trapped", value: 500, parent: computed }, {
  get(target, name) {
    reads += 100;
    return target[name];
  },
});
const head = add(trapped, "head", 600);
for (const key of ["head", "trapped", "computed", "inherited", "wider", "reordered", "k3", "none"])
  print(key + ": " + find(head, key) + " after " + reads);
print(sum(head) + " after " + reads);

function findAndChange(list, key) {
  let seen = "";
  for (let entry = list; entry; entry = entry.parent) {
    const k = entry.key;
    if (k === key) {
      delete entry.key;
      entry.extra = k;
      entry.key = k + "!";
    }
    seen += entry.key + "=" + entry.value + " ";
  }
  return seen;
}
let changing;
for (let i = 0; i < 4; i++)
  changing = add(changing, "c" + i, i);
print(findAndChange(changing, "c2"));
print(findAndChange(changing, "c2!"));
print(findAndChange(changing, "c0"));
print(Object.keys(changing.parent).join());

function lengths(items) {
  let text = "";
  for (let i = 0; i < items.length; i++) {
    const item = items[i];
    try {
      text += item.key + "/" + item.value + "/" + item.parent + " ";
    } catch (e) {
      text += e.name + " ";
    }
  }
  return text;
}
print(lengths([add(undefined, "a", 1), "text", 5, null, add(null, "b", 2), undefined, true, [], add(0, "c", 3), Symbol.iterator, 10n]));
//// sibling-structures-row-search.js
// Objects of 3000 sibling shapes, which differ in their first name, are asked for the same nine names by the same code.
////= make
function read(o) { return o.first + o.second * 2 + o.third * 3 + o.fourth * 5 + o.fifth * 7 + o.sixth * 11 + o.seventh * 13 + o.eighth * 17 + (o.ninth === undefined ? 19 : 0); }
const objects = [];
for (let i = 0; i < 3000; i++) objects.push(make(i));
let sum = 0;
for (const o of objects) sum = sum + read(o) | 0;
console.log("3000 sibling shapes, nine names each:", sum);
for (const o of objects) sum = sum + read(o) | 0;
console.log(sum);
//// sibling-structures-share-cache-entries.js
// Many shapes are read by the same code under the same names, and then their prototypes change: a method is replaced, an absent name is added, a value is deleted and added again, a getter is replaced, a value becomes a getter, objects get own properties, prototypes are replaced. Every cached result in the by-name property table has to follow.
function makePlain(i) {
  const o = {};
  o["kind" + i] = i;
  o.first = i; o.second = 2; o.third = 3; o.fourth = 4; o.fifth = 5; o.sixth = 6; o.seventh = 7; o.eighth = 8;
  if (i % 7 === 0) Object.defineProperty(o, "ninth", { get() { return 9; }, configurable: true });
  return o;
}
function readPlain(o) { return o.first + o.second * 2 + o.third * 3 + o.fourth * 5 + o.fifth * 7 + o.sixth * 11 + o.seventh * 13 + o.eighth * 17 + (o.ninth === undefined ? 19 : o.ninth) + (o.tenth === undefined ? 23 : 0); }
const plain = [];
for (let i = 0; i < 1500; i++) plain.push(makePlain(i));
let sum = 0;
for (const o of plain) sum = sum + readPlain(o) | 0;
console.log("1500 plain shapes, ten names each:", sum);
plain[5].tenth = 10; plain[6].third = -3; plain[8].fourth = 40; delete plain[9].second;
for (const o of plain) sum = sum + (readPlain(o) | 0) | 0;
console.log(sum, readPlain(plain[5]), readPlain(plain[6]), readPlain(plain[7]), readPlain(plain[8]), readPlain(plain[9]));

class Shape {
  constructor(i) { this["own" + i] = i; this.width = i; }
  area() { return this.width * 2; }
  rim() { return this.width + 4; }
  get edges() { return 4; }
}
Shape.prototype.label = "shape";
Shape.prototype.weight = 3;
function use(s) { return s.width + s.area() + s.rim() * 3 + s.edges * 5 + s.label.length * 7 + s.weight * 11 + (s.missing === undefined ? 13 : s.missing) + (s.lost === undefined ? 17 : 0); }
const shapes = [];
for (let i = 0; i < 1000; i++) shapes.push(new Shape(i));
let total = 0;
const all = () => { for (const s of shapes) total = total + use(s) | 0; return total; };
console.log("1000 shapes of instances of one class, eight names each:", all());
Shape.prototype.area = function () { return this.width * 20; };
console.log("a method is replaced:", all(), use(shapes[3]));
Shape.prototype.missing = 1;
console.log("an absent name is added to the prototype:", all(), use(shapes[3]));
delete Shape.prototype.label; Shape.prototype.label = "another";
console.log("a value is deleted and added again:", all(), use(shapes[3]));
Object.defineProperty(Shape.prototype, "edges", { get() { return this.width & 1 ? 3 : 5; }, configurable: true });
console.log("a getter is replaced:", all(), use(shapes[3]), use(shapes[4]));
Object.defineProperty(Shape.prototype, "weight", { get() { return 2; }, configurable: true });
console.log("a value becomes a getter:", all(), use(shapes[3]));
shapes[3].rim = () => 100; shapes[4].lost = 1; Object.defineProperty(shapes[5], "edges", { value: 1 });
console.log("three objects get properties of their own:", all(), use(shapes[3]), use(shapes[4]), use(shapes[5]), use(shapes[6]));
Object.setPrototypeOf(shapes[7], { area() { return 1; }, rim() { return 2; }, edges: 3, label: "x", weight: 4 });
Object.setPrototypeOf(Shape.prototype, { lost: 5 });
console.log("prototypes are replaced:", all(), use(shapes[7]), use(shapes[8]));
for (let i = 1000; i < 1100; i++) shapes.push(new Shape(i));
console.log("a hundred more shapes:", all(), use(shapes[1050]));
//// single-char-search-runtime-code.js
// Functions made at run time look for one character in strings of every kind, from every place.
const lines = [];
const find = new Function("text", "what", "from", "return text.indexOf(what, from);");
const findFromStart = new Function("text", "what", "return text.indexOf(what);");
const url = "http://localhost:3000/user/me?x=1&y=2#end", wide = "世界/été/世", latin = "café/été";
const texts = [["narrow", url], ["wide", wide], ["Latin-1", latin], ["empty", ""], ["one", "/"], ["joined", "http://" + ["local"][0] + "host/a"], ["cut", url.substring(7, 30)], ["long", "x".repeat(5000) + "/" + "y".repeat(5000) + "/"]];
const needles = ["/", "?", "#", "h", "d", "z", "é", "世", "界", "Ā", "\0", "", "//", "me", 1, null, undefined, { toString: () => "/" }];
const places = [undefined, 0, 1, 7, 11, 21, 40, 41, 42, 1000000, -1, -1000000, 1.9, -0.5, NaN, Infinity, -Infinity, "11", null, true, { valueOf: () => 11 }];
for (const [name, text] of texts) {
  const rows = [];
  for (const needle of needles) rows.push(places.map(place => find(text, needle, place)).join(","));
  lines.push(name + ": " + rows.join(" | "));
  lines.push(name + " from the start: " + needles.map(needle => findFromStart(text, needle)).join(","));
}
const onOthers = new Function("receiver", "what", "return String.prototype.indexOf.call(receiver, what);");
lines.push("other receivers: " + [[12345, "3"], [true, "u"], [[1, 2], ","], [{}, "o"], [new String("a/b"), "/"]].map(([receiver, what]) => onOthers(receiver, what)).join(","));
for (const receiver of [null, undefined]) { try { onOthers(receiver, "/"); lines.push("no error"); } catch (error) { lines.push(error.name); } }
let sum = 0;
for (let turn = 0; turn < 200000; turn++) { const s = find(url, "/", 11); sum += s + find(url, "?", s + 1) + find(wide, "/", turn & 7); }
lines.push("many: " + sum);
console.log(lines.join("\n"));
