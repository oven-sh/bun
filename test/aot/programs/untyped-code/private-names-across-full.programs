//// private-names-across-full-gcs.js
// A server that lives long: classes with private names, with fields under symbols, and copies of property descriptors, whose objects are made for a request and are all gone when a full collection comes. What the run
// time has learnt about them dies with their shapes and is learnt again; that may be done any number of times. Three hundred rounds, a full collection behind each: the objects stay what they are, and the last round
// asks the run time no more than the second did. Only the jsc shell can count; elsewhere the counts are zero.
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;
const collect = typeof gc === "function" ? gc : typeof Bun === "object" ? () => Bun.gc(true) : () => {};
class Inner { #a; #b; raw; path; index = 0; cache = {}; constructor(raw, path) { this.raw = raw; this.path = path; this.#a = 1; this.#b = 2; } sum() { return this.#a + this.#b + this.index + this.raw; } }
class Outer {
    #raw; #inner; env = {}; #vars; done = false; error; #status; #res; #path;
    constructor(raw, options) { this.#raw = raw; this.#path = options.path; this.#status = 200; }
    get inner() { return this.#inner ??= new Inner(this.#raw, this.#path); }
    status() { return this.#status + (this.#vars === undefined ? 0 : 1) + (this.#res === undefined ? 0 : 1); }
}
const kFirst = Symbol("first"), kSecond = Symbol("second"), kThird = Symbol("third");
class Marked { [kFirst] = 1; [kSecond] = 2; plain = 3; [kThird] = 4; sum() { return this[kFirst] + this[kSecond] + this.plain + this[kThird]; } }
function Stamped(n) { this[kFirst] = n; this[kSecond] = n + 1; this[kThird] = n + 2; }
const copyOf = source => Object.defineProperties({}, Object.getOwnPropertyDescriptors(source));
const sources = [{ a: 1, b: 2 }, { c: 1, d: 2, e: 3 }, { f: 1, g: 2 }, { h: 1, i: 2, j: 3, k: 4 }, { l: 1, m: 2 }, { n: 1, o: 2 }, { p: 1, q: 2, r: 3 }, { s: 1, t: 2 }];
const names = ["operationAOTTryPutProperties", "operationAOTPrivateFieldAdd", "operationAOTDefineField", "operationAOTPutByIdAndCache"];
const asked = () => names.map(count);
let check = 0, second = null, last = null;
const shown = new Set();
for (let round = 0; round < 300; round++) {
    const before = asked();
    for (let i = 0; i < 100; i++) {
        const outer = new Outer(i, { path: "/" }), marked = new Marked(), stamped = new Stamped(i);
        check = (check + outer.status() + outer.inner.sum() + marked.sum() + stamped[kFirst] + stamped[kThird]) % 1000003;
        for (const source of sources) check = (check + Object.values(copyOf(source)).length) % 1000003;
        if (i === 99) shown.add([Object.keys(outer).join(), Object.keys(outer.inner).join(), Reflect.ownKeys(marked).map(String).join(), Reflect.ownKeys(stamped).map(String).join(), sources.map(source => Object.keys(copyOf(source)).join("")).join()].join(" | "));
    }
    last = asked().map((n, k) => n - before[k]);
    if (round === 1) second = last;
    collect();
}
console.log([...shown].join("\n"));
console.log(check);
console.log("the last of 300 rounds asks the run time no more than the second: " + last.every((n, k) => n <= second[k]));
//// promises-resolved-with-class-instances.js
// Promises resolved with, and awaits of, objects of classes of the program: heirs of Array, Map, Error and Object, plain classes, classes whose prototype nobody has looked at yet. None of them is a thenable until
// somebody gives it a `then`: on the object, on the class's prototype, on a prototype further up, by a method of the class, by an accessor, by Object.setPrototypeOf: then it is called, at once and every time.
const lines = [];
class Rows extends Array { count = 0; static get [Symbol.species]() { return Array; } first() { return this[0]; } }
class Table extends Map { name() { return "table"; } }
class Failure extends Error { code() { return 7; } }
class Point { constructor(x) { this.x = x; } double() { return this.x * 2; } }
class Deep extends Point { triple() { return this.x * 3; } }
class Deeper extends Deep { }
class Thenable { then(resolve) { resolve("then of the class"); } }
class HeirOfThenable extends Thenable { }
class ByAccessor { get then() { lines.push("the accessor is asked"); return undefined; } }
class Late { value() { return "late"; } }
class LateBase { }
class LateHeir extends LateBase { }
class Moved { }
const describe = x => x === null || typeof x !== "object" ? String(x) : x.constructor.name + (Array.isArray(x) ? "[" + x.join() + "]" : "");
async function returns(x) { return x; }
async function awaits(x) { return describe(await x); }
async function all(label, make) {
    const byResolve = await Promise.resolve(make());
    const byExecutor = await new Promise(resolve => resolve(make()));
    const byReturn = await returns(make());
    const byThen = await Promise.resolve(1).then(() => make());
    lines.push(label + ": " + [describe(byResolve), describe(byExecutor), describe(byReturn), describe(byThen), await awaits(make())].join(" "));
}
async function main() {
    await all("an heir of Array", () => Rows.from([1, 2]));
    await all("an heir of Map", () => new Table());
    await all("an heir of Error", () => new Failure("f"));
    await all("a class", () => new Point(1));
    await all("an heir of an heir", () => new Deeper(2));
    await all("a method called then", () => new Thenable());
    await all("inherited from the class above", () => new HeirOfThenable());
    await all("an accessor called then", () => new ByAccessor());
    await all("late, before", () => new Late());
    Late.prototype.then = function (resolve) { resolve("then given to the prototype"); };
    await all("late, behind", () => new Late());
    delete Late.prototype.then;
    await all("late, taken away", () => new Late());
    await all("the heir, before", () => new LateHeir());
    LateBase.prototype.then = function (resolve) { resolve("then given to the prototype above"); };
    await all("the heir, behind", () => new LateHeir());
    await all("moved, before", () => new Moved());
    Object.setPrototypeOf(Moved.prototype, { then(resolve) { resolve("then under the prototype"); } });
    await all("moved, behind", () => new Moved());
    const own = new Point(5);
    own.then = resolve => resolve("then of its own");
    await all("of its own", () => own);
    const rows = new Rows();
    await all("rows, before", () => rows);
    rows.then = resolve => resolve("then on the array");
    await all("rows, behind", () => rows);
    for (let i = 0; i < 100; i++) { await returns(new Rows()); await returns(new Table()); await returns(new Deeper(i)); await new Point(i); }
    let sum = 0;
    for (let i = 0; i < 1000; i++) {
        sum += (await returns(Rows.from([i]))).first() + (await returns(new Deeper(i))).triple() + (await new Point(i)).double() + (await Promise.resolve(new Table())).size + (await new Promise(resolve => resolve(new Deep(i)))).double();
    }
    lines.push("5000 objects that cannot have a then:", sum);
    console.log(lines.join("\n"));
}
main();
//// properties-through-proxies.js
// Properties read through a Proxy, by a written name and by a computed key: the trap sees the target, the key and the receiver; a handler
// without the trap passes the read on; what the language demands of the trap's answer is demanded; and the lookup in the runtime goes
// straight to the proxy's own way of reading.
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;
function counted() { return count("operationAOTGetByIdAndCache") > 0; }
var log = [];
function note(text) { log.push(text); }
function flush(label) { console.log(label + ": " + log.join(" ")); log = []; }
function show(value) { return typeof value === "symbol" ? String(value) : typeof value === "function" ? "function " + value.name : typeof value === "object" && value !== null ? JSON.stringify(value) : typeof value === "string" ? JSON.stringify(value) : String(value); }
function byName(o) { return o.wanted; }
function byOtherName(o) { return o.other; }
function byKey(o, key) { return o[key]; }
function method(o) { return o.method(1, 2); }
function attempt(label, work) { var answer; try { answer = show(work()); } catch (error) { answer = "threw " + error.constructor.name + ": " + (/is not a function/.test(error.message) ? "it is not a function" : /class constructor/.test(error.message) ? "a class constructor is not called" : error.message); } note("=> " + answer); flush(label); }
var own = Symbol("own");
function readAll(label, make) {
  attempt(label + " .wanted", function () { return byName(make()); });
  attempt(label + " .other", function () { return byOtherName(make()); });
  attempt(label + ' ["wanted"]', function () { return byKey(make(), "wanted"); });
  attempt(label + ' ["wan" + "ted"]', function () { return byKey(make(), "wan" + String("ted")); });
  attempt(label + " [symbol]", function () { return byKey(make(), own); });
  attempt(label + " [3]", function () { return byKey(make(), 3); });
  attempt(label + ' ["3"]', function () { return byKey(make(), "3"); });
  attempt(label + " .method()", function () { return method(make()); });
}
function target() { var o = { wanted: "of the target", other: 2, method(a, b) { return "method of " + (this === o ? "the target" : "another") + " " + (a + b); }, 3: "three" }; o[own] = "by a symbol"; return o; }
function telling(extra) {
