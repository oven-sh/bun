////: make
function make(i) {
  const o = {};
  o["kind" + i] = i;
  o.first = i; o.second = 2; o.third = 3; o.fourth = 4; o.fifth = 5; o.sixth = 6; o.seventh = 7; o.eighth = 8;
  return o;
}
////: readRepeatedly
function readRepeatedly(read, receiver) {
  let last;
  for (let i = 0; i < 1000; i++) last = read(receiver);
  return last;
}
////: say
const say = (label, run) => {
  const seen = [];
  for (let turn = 0; turn < 6; turn++) {
    try {
      seen.push(show(run()));
    } catch (error) {
      seen.push("throws " + error.constructor.name);
    }
  }
  lines.push(label + ": " + seen.join(" "));
};
////: say-2
function say(...parts) {
  lines.push(parts.map(part => (typeof part === "string" ? part : JSON.stringify(part) ?? String(part))).join(" "));
}
////: say-3
function say(label, work) {
  let text;
  try {
    text = JSON.stringify(work());
  } catch (error) {
    text = "throws " + error.constructor.name;
  }
  lines.push(label + ": " + text);
}
////: show-2
function show(name: string, make: () => unknown) {
  let out: string;
  try { out = JSON.stringify(make(), (_k, v) => say(v)); } catch (e) { out = «1» + (e as Error).name; }
  console.log(String(++count).padStart(2, "0"), name + ":", out);
}
////: show-4
function show(name: string, make: () => unknown) {
  let out: string;
  try { out = JSON.stringify(make(), (_k, v) => (v === undefined ? "undefined" : typeof v === "function" ? "function" : «1»e; }
  console.log(String(++count).padStart(2, "0"), name + ":", out);
}
