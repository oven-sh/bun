////: attempt
function attempt(label, run) {
  try {
    say(label, run());
  } catch (error) {
    say(label, "threw", error.constructor.name);
  }
}
////: attempt-2
function attempt(action) {
  try {
    return action();
  } catch (error) {
    return error.constructor.name;
  }
}
