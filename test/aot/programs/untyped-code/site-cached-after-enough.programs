  if (o.n09 !== undefined) found++; if (o.n10 !== undefined) found++; if (o.n11 !== undefined) found++; if (o.n12 !== undefined) found++;
  if (o.n13 !== undefined) found++; if (o.n14 !== undefined) found++; if (o.n15 !== undefined) found++; if (o.n16 !== undefined) found++;
