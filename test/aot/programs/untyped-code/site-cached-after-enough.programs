//// string-order-at-every-position.js
// < <= > >= from untyped code on 8-bit strings of up to 20 characters: the first difference at every position, characters above 0x7f, one string a prefix of the other.
// Only the jsc shell can count. Elsewhere the count is zero.
const count = typeof aotOperationCount === "function" ? aotOperationCount : () => 0;

function less(a, b) { return a < b; }
function lessEq(a, b) { return a <= b; }
function greater(a, b) { return a > b; }
function greaterEq(a, b) { return a >= b; }

const operators = [
  [less, "operationAOTCompareLess"],
  [lessEq, "operationAOTCompareLessEq"],
  [greater, "operationAOTCompareGreater"],
  [greaterEq, "operationAOTCompareGreaterEq"],
];

// One hexadecimal digit: bit i is the answer of operator i.
function order(left, right) {
  let bits = 0;
  operators.forEach(([operator], index) => {
    if (operator(left, right)) bits |= 1 << index;
  });
  return bits.toString(16);
}

// Reading a character flattens a rope.
function flat(string) {
  if (string.length) string.charCodeAt(0);
  return string;
}

const alphabet = "mnopqrstuvwxyzmnopqr";
const replacements = ["\x01", "a", "z", "\x7f", "\x80", "\xe9", "\xff"];
for (let length = 0; length <= alphabet.length; length++) {
  const base = flat(alphabet.slice(0, length));
  const row = [order(base, flat(alphabet.slice(0, length)))];
  if (length) row.push(order(base, flat(alphabet.slice(0, length - 1))), order(flat(alphabet.slice(0, length - 1)), base));
  for (let position = 0; position < length; position++) {
    for (const replacement of replacements) {
      const changed = flat(base.slice(0, position) + replacement + base.slice(position + 1));
      const changedAndLonger = flat(changed + "m");
      row.push(order(base, changed) + order(changed, base) + order(base, changedAndLonger) + order(changedAndLonger, base));
    }
  }
  console.log(length, row.join(" "));
}

for (const first of replacements) console.log(JSON.stringify(first), replacements.map(second => order(flat("mnopqrst" + first), flat("mnopqrst" + second))).join(" "));

// These keep the operand types of the four functions unknown.
const others = [1, "10", "9", null, undefined, true, "ā", "mnopā", { toString() { return "mnop"; } }, 2n];
for (const left of others) console.log(others.map(right => order(left, right)).join(" "), order(left, "mnop"), order("mnop", left));

const literals = [
  "", "m", "mno", "mnop", "mnoq", "mnopq", "mnopqrs", "mnopqrst", "mnopqrsu", "anopqrst", "mnopqrstu", "mnopqrstuvw", "mnopqrstuvwx", "mnopqrstuvwy", "mnopqrstuvwxyzm", "mnopqrstuvwxyzmn",
  "mnopqrstuvwxyzmo", "mnopqrsuuvwxyzmn", "mnopqrstuvwxyzmno", "mnopqrstuvwxyzmnopqr", "mnopqrstuvwxyzmnopqs",
];
console.log(literals.map(left => literals.map(right => order(left, right)).join("")).join(" "));
for (const [operator, row] of operators) {
  const before = count(row);
  for (let round = 0; round < 100; round++) {
    for (const left of literals) {
      for (const right of literals) operator(left, right);
    }
  }
  console.log(operator.name, "row calls on flat strings", count(row) - before);
}
//// string-switch-runtime-code.js
// Functions made at run time switch on strings that were cut out of other strings, joined from pieces, read from arrays, or are no strings at all.
const lines = [];
const route = new Function("path", "switch (path) { case '/': return 'root'; case '/a': return 'a'; case '/json': return 'json'; case '/user/me': return 'me'; case '/\\u00e9t\\u00e9': return 'summer'; case '/\\u4e16\\u754c': return 'world'; case '': return 'empty'; case '/a/very/long/path/that/goes/on/and/on': return 'long'; default: return 'none'; }");
const url = "http://localhost:3000/json?x=1", wide = "http://localhost/世界#é", latin = "http://localhost/été?";
const cut = (text, from, to) => text.substring(from, to);
const cases = [
  ["a literal", () => "/json"],
  ["cut out", () => cut(url, 21, 26)],
  ["cut out too short", () => cut(url, 21, 25)],
  ["cut out too long", () => cut(url, 21, 27)],
  ["cut to one character", () => cut(url, 21, 22)],
  ["cut to nothing", () => cut(url, 5, 5)],
  ["cut out of a wide string", () => cut(wide, 16, 19)],
  ["narrow text cut out of a wide string", () => cut("世/json界", 1, 6)],
  ["cut out of a Latin-1 string", () => cut(latin, 16, 20)],
  ["joined", () => "/js" + ["on"][0]],
  ["joined of three", () => "/" + "user" + ["/me"][0]],
  ["joined and cut", () => cut("x/us" + ["er/mexx"][0], 1, 9)],
  ["cut of a cut", () => cut(cut(url, 10, 28), 11, 16)],
  ["sliced", () => url.slice(21, 26)],
  ["long", () => cut("##/a/very/long/path/that/goes/on/and/on##", 2, 39)],
  ["long with one character wrong", () => cut("##/a/very/long/path/that/goes/on/and/oN##", 2, 39)],
  ["a string object", () => new String("/json")],
  ["a number", () => 1],
  ["undefined", () => undefined],
  ["null", () => null],
  ["an object that says so", () => ({ toString: () => "/json" })],
  ["a symbol", () => Symbol("/json")],
];
for (const [name, make] of cases) {
  const seen = new Set();
  for (let turn = 0; turn < 300; turn++) seen.add(route(make()));
  lines.push(name + ": " + [...seen].join(" "));
}
let hits = 0;
for (let turn = 0; turn < 200000; turn++) {
  const path = cut(url, 21, 22 + (turn % 6));
  if (route(path) !== "none") hits++;
  if (turn % 3 === 0 && path.length !== 1 + (turn % 6)) hits += 1000000;
}
lines.push("many: " + hits);
const kept = cut(url, 21, 26);
lines.push("the string afterwards: " + route(kept) + " " + kept + " " + kept.length + " " + (kept === "/json") + " " + JSON.stringify({ [kept]: 1 }) + " " + route(kept));
console.log(lines.join("\n"));
//// structure-kinds-survive-gc.js
// Untyped on purpose. The shape of an object refers to its realm, its prototype, the shape it came from or its rare data, its property table if that is pinned, and in a collection of the young to the one shape that follows it. Objects of every kind of shape must read, list and grow as before after any mix of collections.
const collect = globalThis.Bun ? full => globalThis.Bun.gc(full) : full => (full ? fullGC() : edenGC());
////= churn
function describe(o) {
  let text = "";
  for (const key in o) text += key + "=" + (typeof o[key] === "object" ? "o" : typeof o[key] === "function" ? "f" : o[key]) + ",";
  return text + Object.keys(o).length + "/" + Object.getOwnPropertyNames(o).length;
}
function chain(prefix, n) {
  const o = {};
  for (let i = 0; i < n; i++) o[prefix + i] = i;
  return o;
}
const kept = [];
for (let round = 0; round < 20; round++) {
  const plain = chain("p", 3 + (round % 9));
  const branch = chain("p", 3);
  branch["branch" + round] = round;
  const dictionary = chain("d", 40);
  for (let i = 0; i < 40; i += 3) delete dictionary["d" + i];
  dictionary["late" + round] = round;
  const huge = chain("h", 90 + round);
  const frozen = Object.freeze(chain("f", 4));
  const sealed = Object.seal(chain("s", 5));
  const closed = Object.preventExtensions(chain("c", 2));
  const proto = { inherited: round, method() { return this.own + this.inherited; } };
  const heir = Object.create(proto);
  heir.own = round * 2;
  const moved = chain("m", 3);
  Object.setPrototypeOf(moved, round % 2 ? proto : null);
  const bare = Object.create(null);
  bare.x = round;
  const withSymbol = { [Symbol.for("s" + (round % 3))]: round, plain: 1 };
  const accessor = Object.defineProperty(chain("a", 2), "hidden", { value: round, enumerable: false });
  const indexed = chain("i", 2);
  indexed[0] = "zero";
  indexed[5] = "five";
  const array = Object.assign([1, 2, 3], { extra: round });
  function Made(n) {
    this.n = n;
    this.twice = n * 2;
  }
  Made.prototype.sum = function () {
    return this.n + this.twice;
  };
  const made = new Made(round);
  class Base {
    base = round;
  }
  class Derived extends Base {
    derived = round + 1;
    static count = round;
  }
  const instance = new Derived();
  const all = [plain, branch, dictionary, huge, frozen, sealed, closed, heir, moved, bare, withSymbol, accessor, indexed, array, made, instance];
  if (round % 4 === 0) kept.push(all);
  churn(3000);
  collect(round % 6 === 5);
  if (round % 3 === 0) collect(false);
  let text = "";
  for (const o of all) text += describe(o).length + ":";
  console.log("round", round, text, heir.method(), made.sum(), Derived.count, Object.isFrozen(frozen), Object.isSealed(sealed), Object.isExtensible(closed), Object.getOwnPropertySymbols(withSymbol).length, accessor.hidden);
  // Grow again along chains whose objects of the last round are gone.
  const again = chain("p", 12);
  again.tail = round;
  if (describe(again) !== "p0=0,p1=1,p2=2,p3=3,p4=4,p5=5,p6=6,p7=7,p8=8,p9=9,p10=10,p11=11,tail=" + round + ",13/13") console.log("WRONG", describe(again));
}
collect(true);
churn(20000);
collect(false);
for (const all of kept) {
  let text = "";
  for (const o of all) text += describe(o) + "|";
  console.log(text.length, text.slice(0, 120));
  all[2].more = 1;
  all[3].more = 2;
  all[0].more = 3;
