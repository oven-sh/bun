  function: v => Object.assign(function () {}, shapes.literal(v)),
  array: v => Object.assign([], shapes.literal(v)),
  nullPrototype: v => Object.assign(Object.create(null), shapes.literal(v)),
  frozen: v => Object.freeze(shapes.literal(v)),
