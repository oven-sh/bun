    const made = new Function("a", "b", text);
    for (let turn = 0; turn < 4; turn++) {
      try {
        seen.push(show(made(...given)));
      } catch (error) {
        seen.push("throws " + error.constructor.name);
      }
    }
  } catch (error) {
    seen.push("is refused: " + error.constructor.name);
  }
  lines.push(label + ": " + seen.join(" "));
};
