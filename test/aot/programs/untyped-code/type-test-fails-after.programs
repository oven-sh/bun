//// vm-script-cached-data.ts
// A node:vm Script accepts the cached data another Script of the same source made, and rejects any other bytes.
import { Script } from "node:vm";

const source = "1 + 1;";
const first = new Script(source, { produceCachedData: false });
const cachedData = first.createCachedData();
console.log("made", cachedData instanceof Buffer, cachedData.length > 0);

const second = new Script(source, { cachedData });
console.log("the same source", second.cachedDataRejected, first.runInThisContext(), second.runInThisContext());

const other = new Script("2 + 2;", { cachedData });
console.log("another source", other.cachedDataRejected, other.runInThisContext());

const none = new Script(source, { cachedData: Buffer.from("not bytecode") });
console.log("no bytecode", none.cachedDataRejected, none.runInThisContext());

const without = new Script(source);
console.log("none given", without.cachedDataRejected, without.runInThisContext());
//// what-an-object-gets-after-it-was-first-read.js
// An object is read, stored to and called through first, and only then gets an accessor, a deletion, copied properties or another prototype: whatever comes later sees it.
////= lines-6	readSize	box	return	box.size
////= lines-17	storeSize	box	box.size
////= lines-21	run	box	box.run

const withGetterLater = { size: 1 };
console.log(readSize(withGetterLater));
Object.defineProperty(withGetterLater, "size", { get: () => "out of a getter", configurable: true });
console.log(readSize(withGetterLater));

const base = {};
const heir = Object.create(base);
console.log(storeSize(Object.create(base), 2));
const taken = [];
Object.defineProperty(base, "size", {
  get() {
    return "the setter took " + taken.join();
  },
  set(value) {
    taken.push(value, this === heir);
  },
});
console.log(storeSize(heir, 3), Object.hasOwn(heir, "size"));

const above = { size: "from above" };
const below = Object.create(above);
below.size = "its own";
console.log(readSize(below));
delete below.size;
console.log(readSize(below));

const target = {};
console.log(readSize(target));
Object.assign(target, { size: "copied" });
console.log(readSize(target));
const filledBySpread = { ...{ get size() { return "read while it was copied"; } } };
console.log(readSize(filledBySpread), typeof Object.getOwnPropertyDescriptor(filledBySpread, "size").get);

const orphan = {};
console.log(readSize(orphan));
Object.setPrototypeOf(orphan, { size: "from the new prototype" });
console.log(readSize(orphan));
const adopted = { __proto__: null };
console.log(readSize(adopted));
Object.setPrototypeOf(adopted, withGetterLater);
console.log(readSize(adopted));

const worker = {
  run() {
    return "the first method";
  },
};
console.log(run(worker));
Object.defineProperty(worker, "run", { get: () => () => "a method out of a getter", configurable: true });
console.log(run(worker));
delete worker.run;
Object.setPrototypeOf(worker, {
  run() {
    return "a method of the new prototype, this is the worker: " + (this === worker);
  },
});
console.log(run(worker));

class Shape {
  static describe() {
    return "a shape";
  }
}
class Circle extends Shape {}
console.log(Circle.describe());
Object.setPrototypeOf(Circle, {
  describe() {
    return "no shape any more";
  },
});
console.log(Circle.describe());

const list = [1, 2, 3];
console.log(list.map(x => x * 2).join());
Object.defineProperty(list, "map", { get: () => () => ["its own map"] });
console.log(list.map(x => x * 2).join());
//// what-inherits-from-another-realm-follows-its-index-accessors.ts
// Objects and arrays of this realm that inherit from another realm's prototypes follow the accessors and read-only properties which that realm has for indices, whether they were made before or behind the definition. Everything else of this realm does not.
import vm from "node:vm";
const sets: string[] = [];
function attempt(f: () => unknown): string {
    try { return String(f()); } catch (e) { return "threw " + (e as any).name; }
}
function text(x: unknown): string { return attempt(() => JSON.stringify(x)); }
function fill(x: any): any {
    x[0] = 1; x[1] = 2.5; x[2] = "s"; x[8] = 9;
    if (!Array.isArray(x)) x.length = 9;
    return x;
}
function report(name: string, next: () => any): void {
    const x = next();
    const names: string[] = [];
    for (const key in x) names.push(key);
    sets.length = 0;
    const line = [
        "get " + [x[1], x[3], x[5], x[7], x[9]].map(String).join(" "),
        "in " + [1 in x, 3 in x, 5 in x, 7 in x, 9 in x].join(" "),
        "own " + [Object.hasOwn(x, 1), Object.hasOwn(x, 3), Object.hasOwn(x, 5)].join(" "),
        "for-in " + names.join(","),
        "keys " + Object.keys(x).join(","),
        "json " + text(x),
        "join " + attempt(() => Array.prototype.join.call(x, "-")),
        "indexOf " + attempt(() => Array.prototype.indexOf.call(x, "got")) + " " + attempt(() => Array.prototype.lastIndexOf.call(x, "fixed")),
