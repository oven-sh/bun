    "7", "0x10", "", "x", " 12 ", true, false, null, undefined, [], [5], [1, 2], {}, { valueOf() { return 9; } }, { valueOf() { return 2 ** 40 + 3; } }, { toString() { return "11"; } }, new Date(86400000), new Number(6)];
for (const x of values) lines.push(all(123456789, x) + " | " + all(-987654321, x));
