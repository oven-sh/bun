console.log(texts(task, 5), texts(job, 5), texts(cron, 5));
Object.defineProperty(Task.prototype, "hasOwnProperty", { get() { return () => false; }, configurable: true });
console.log(owns(task, 5), owns(cron, 5), owns({ id: 1 }, 5));

