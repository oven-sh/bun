//// field-accumulator.js
// The elements come out of JSON.parse, so that nothing about them is known before the program runs. The list itself is an array of the program.
////= make

function kernel(values) {
  var state = { total: 0, count: 0 };
  for (var i = 0; i < values.length; i++) {
    state.total += values[i];
    state.count++;
  }
  return state.total + state.count;
}

var input = make("integers", 1000);
var checksum = 0;
for (var round = 0; round < 30000; round++) checksum = (checksum + kernel(input)) % 1000000007;
console.log(checksum);
//// for-of-with-objects-altered-in-the-loop.js
// A loop over an iterable reads an object that does not change from turn to turn, until something in the loop alters the object, the array or the iteration itself.
const unknown = new Function("value", "return value" + process.argv[0].slice(process.argv[0].length));
const lines = [];

function weighted(list, scale) {
  let sum = 0;
  for (const item of list) sum += item * scale.k;
  return sum;
}

function weightedWithHook(list, scale, hook) {
  let sum = 0;
  for (const item of list) {
    sum += item * scale.k;
    if (item === 3) hook(list, scale);
    sum += scale.k;
  }
  return sum;
}

function nested(rows, scale) {
  let sum = 0;
  for (const row of rows) {
    sum += scale.k;
    for (const cell of row.cells) sum += cell * scale.k + row.bias;
  }
  return sum;
}

function overValues(map, scale) {
  let sum = 0;
  for (const value of map.values()) sum += value * scale.k;
  return sum;
}

function pairs(list, scale) {
  let sum = 0;
  for (const [left, right] of list) sum += (left + right) * scale.k;
  return sum;
}

function spreadInLoop(lists, scale) {
  const all = [];
  for (const list of lists) {
    all.push(...list);
    all.push(scale.k);
  }
  return all.join();
}

const numbers = () => unknown([1, 2, 3, 4, 5]);
const scaleOf = k => unknown({ k });

for (let warm = 0; warm < 50; warm++) {
  weighted(numbers(), scaleOf(2));
  weightedWithHook(numbers(), scaleOf(2), () => {});
  nested(unknown([{ cells: [1, 2], bias: 1 }, { cells: [3], bias: 2 }]), scaleOf(2));
  overValues(unknown(new Map([["a", 1], ["b", 2]])), scaleOf(2));
  pairs(unknown([[1, 2], [3, 4]]), scaleOf(2));
  spreadInLoop(unknown([[1], [2, 3]]), scaleOf(2));
}

lines.push("as made: " + weighted(numbers(), scaleOf(2)));
lines.push("another layout: " + weighted(numbers(), unknown({ j: 1, k: 3 })));
lines.push("an inherited name: " + weighted(numbers(), unknown(Object.create({ k: 4 }))));
lines.push("a getter: " + weighted(numbers(), unknown({ get k() { return 5; } })));
lines.push("no such name: " + weighted(numbers(), unknown({})));
lines.push("a string: " + weighted(numbers(), unknown({ k: "6" })));
lines.push("a proxy: " + weighted(numbers(), unknown(new Proxy({}, { get: () => 7 }))));
for (const nothing of [undefined, null]) {
  let answer;
  try { answer = weighted(numbers(), unknown(nothing)); } catch (error) { answer = error.constructor.name; }
  lines.push("scale " + nothing + ": " + answer);
  lines.push("scale " + nothing + ", nothing to walk: " + weighted(unknown([]), unknown(nothing)));
}

const hooks = {
  "stores another number": (list, scale) => { scale.k = 10; },
  "stores a string": (list, scale) => { scale.k = "x"; },
  "deletes the name": (list, scale) => { delete scale.k; },
  "plants a getter": (list, scale) => { let reads = 0; Object.defineProperty(scale, "k", { get: () => ++reads, configurable: true }); },
  "adds a name": (list, scale) => { scale.other = 1; },
  "freezes": (list, scale) => { Object.freeze(scale); },
  "gives another prototype": (list, scale) => { delete scale.k; Object.setPrototypeOf(scale, { k: 100 }); },
  "appends": (list, scale) => { if (list.length < 8) list.push(3); },
  "shortens": (list, scale) => { list.length = 3; },
  "makes a hole": (list, scale) => { delete list[3]; },
  "stores a fraction": (list, scale) => { list[4] = 0.5; },
  "stores an object": (list, scale) => { list[4] = { valueOf: () => 9 }; },
  "stores far outside": (list, scale) => { list[40] = 1; list.length = 6; },
  "plants an index getter": (list, scale) => { Object.defineProperty(list, 4, { get: () => 11 }); },
  "replaces the iterator method": (list, scale) => { list[Symbol.iterator] = function* () { yield 1000; }; },
  "gives the array another prototype": (list, scale) => { Object.setPrototypeOf(list, { __proto__: Array.prototype, 3: 77 }); delete list[3]; },
  "throws": () => { throw new RangeError("stop"); },
};
for (const [name, hook] of Object.entries(hooks)) {
  const list = numbers(), scale = scaleOf(2);
  let answer;
  try { answer = weightedWithHook(list, scale, unknown(hook)); } catch (error) { answer = error.constructor.name + " " + error.message; }
  lines.push(name + ": " + answer + " | " + JSON.stringify(list) + " | " + JSON.stringify(scale));
}

function* generated() { yield 1; yield 2; yield 3; yield 4; }
const closed = [];
const byHand = {
  [Symbol.iterator]() {
    let turn = 0;
    return { next: () => ({ done: ++turn > 4, value: turn }), return() { closed.push(turn); return {}; } };
  },
};
lines.push("a generator: " + weighted(unknown(generated()), scaleOf(2)));
lines.push("an iterator by hand: " + weighted(unknown(byHand), scaleOf(2)));
try { weightedWithHook(unknown(byHand), scaleOf(2), hooks.throws); } catch (error) { lines.push("closed at " + closed.join() + " by " + error.message); }
lines.push("a string: " + weighted(unknown("123"), scaleOf(2)));
lines.push("a typed array: " + weighted(unknown(new Float64Array([0.5, 1.5])), scaleOf(2)));
lines.push("a set: " + weighted(unknown(new Set([1, 1, 2])), scaleOf(2)));
class Sublist extends Array { *[Symbol.iterator]() { yield 50; } }
lines.push("a subclass with its own iterator: " + weighted(unknown(Sublist.from([1, 2])), scaleOf(2)));
for (const notIterable of [undefined, null, 1, {}]) {
  let answer;
  try { answer = weighted(unknown(notIterable), scaleOf(2)); } catch (error) { answer = error.constructor.name; }
  lines.push("walking " + String(notIterable) + ": " + answer);
}

const rows = unknown([{ cells: [1, 2], bias: 1 }, { cells: new Set([3]), bias: 2 }, { cells: "45", bias: 3 }, { bias: 4, cells: [6] }]);
lines.push("nested: " + nested(rows, scaleOf(2)));
lines.push("nested, a getter that alters the scale: " + (() => {
  const scale = scaleOf(2);
  return nested(unknown([{ cells: [1], bias: 0 }, { get cells() { scale.k = 3; return [1]; }, bias: 0 }, { cells: [1], bias: 0 }]), scale);
})());

const map = unknown(new Map([["a", 1], ["b", 2]]));
lines.push("values of a map: " + overValues(map, scaleOf(2)));
lines.push("values of an array: " + overValues(unknown([1, 2, 3]), scaleOf(2)));
lines.push("values of an object with the method: " + overValues(unknown({ values: () => [4] }), scaleOf(2)));
map.values = () => [5];
lines.push("values of a map with its own method: " + overValues(map, scaleOf(2)));

lines.push("pairs: " + pairs(unknown([[1, 2], [3, 4]]), scaleOf(2)));
lines.push("pairs of strings and sets: " + pairs(unknown(["12", new Set([1, 2]), [1]]), scaleOf(2)));
lines.push("spread: " + spreadInLoop(unknown([[1], "23", new Set([4])]), scaleOf(2)));

console.log(lines.join("\n"));
//// horner.js
// The elements come out of JSON.parse, so that nothing about them is known before the program runs. The list itself is an array of the program.
////= make

function kernel(coefficients) {
  var x = 0.5;
  var value = 0;
  for (var i = 0; i < coefficients.length; i++) value = value * x + coefficients[i];
  return value;
}

var input = make("integers", 1000);
var checksum = 0;
for (var round = 0; round < 30000; round++) checksum = (checksum + kernel(input)) % 1000000007;
console.log(checksum);
//// loops-over-the-elements-of-a-declared-union.ts
// Loops over a parameter declared as a union of arrays, views and strings, given each part, subclasses, views that are shrunk, grown or detached in the loop, and values outside the declared type.
const holder: { list: unknown[] } = JSON.parse('{"list":[]}');
function hide<T>(value: T): T {
  holder.list.push(value);
  return holder.list.pop() as T;
}
const lines: string[] = [];
function say(name: string, run: () => unknown): void {
  let text: string;
  try {
    text = String(run());
  } catch (error) {
    text = (error as Error).constructor.name;
  }
  lines.push(name + " = " + text);
}
type Numbers = number[] | Uint8Array;
type Three = Uint8Array | Float64Array | number[];
type Text = string | Buffer;

function sum(bytes: Numbers): number {
  let s = 0;
  for (let i = 0; i < bytes.length; i++) s = (s + bytes[i]!) | 0;
  return s;
}
function sumOfThree(bytes: Three): number {
  let s = 0;
  for (let i = 0; i < bytes.length; i++) s += bytes[i]!;
  return s;
}
function sumOrNothing(bytes: Numbers | null | undefined): number {
  let s = 0;
  for (let i = 0; i < bytes!.length; i++) s = (s + bytes![i]!) | 0;
  return s;
}
function spell(text: Text): string {
  let s = "";
  for (let i = 0; i < text.length; i++) s += text[i] + ",";
  return s;
}
function around(bytes: Three, from: number, to: number): string {
  let s = "";
  for (let i = from; i < to; i++) s += bytes[i] + ",";
  return s;
}
function fill(bytes: Three, value: number): string {
  for (let i = 0; i < bytes.length; i++) bytes[i] = value;
  return around(bytes, 0, bytes.length);
}
function fillPast(bytes: Numbers, from: number, to: number, value: number): string {
  for (let i = from; i < to; i++) bytes[i] = value;
  return around(bytes, 0, bytes.length) + Object.keys(bytes).length;
}
////= sumWhile	: Three, each: (i: number) => void): string
////= sumTo	: Numbers, count: number, each: (i: number) => void): string
function both(a: Numbers, b: Three): number {
  let s = 0;
  for (let i = 0; i < a.length; i++) for (let j = 0; j < b.length; j++) s += a[i]! * b[j]!;
  return s;
}

class OwnLength extends Uint8Array {
  override get length(): number {
    return 2;
  }
}
class LongLength extends Float64Array {
  override get length(): number {
    return 6;
  }
}
class List extends Array<number> {
  override get length(): number {
    return 1;
  }
  override set length(_: number) {}
}
function resizable(count: number, most: number): ArrayBuffer {
  const buffer = new ArrayBuffer(count * 8, { maxByteLength: most * 8 });
  new Uint8Array(buffer).fill(3);
  return buffer;
}
function given(): [string, any][] {
  return [
    ["array", [1, 2, 3, 250]],
    ["doubles", [1.5, -0, NaN]],
    ["holes", [1, , 3]],
    ["empty", []],
    ["bytes", new Uint8Array([1, 2, 3, 250])],
    ["buffer", Buffer.from([1, 2, 3, 250])],
    ["part of a buffer", Buffer.from([9, 1, 2, 9]).subarray(1, 3)],
    ["floats", new Float64Array([1.5, 2.5, NaN])],
    ["own length", new OwnLength([1, 2, 3])],
    ["long length", new LongLength([1, 2, 3])],
    ["list", List.from([1, 2, 3])],
    ["length on the instance", Object.defineProperty(new Uint8Array([1, 2, 3]), "length", { value: 1 })],
    ["prototype of arrays", Object.setPrototypeOf(new Uint8Array([1, 2, 3]), Array.prototype)],
    ["array below bytes", Object.setPrototypeOf([1, , 3], new Uint8Array([7, 8, 9]))],
    ["detached", (v => (v.buffer.transfer(), v))(new Uint8Array([1, 2, 3]))],
    ["words", new Int32Array([1, 2, 3])],
    ["clamped", new Uint8ClampedArray([1, 2, 3])],
    ["text", "123"],
    ["object", { length: 2, 0: 4, 1: 5 }],
    ["proxy", new Proxy(new Uint8Array([7, 8]), {})],
    ["null", null],
    ["undefined", undefined],
    ["number", 7],
  ];
}
for (let round = 0; round < 3; round++) {
  for (const [name, value] of given()) {
    say("sum " + name, () => sum(hide(value)));
    say("sum of three " + name, () => sumOfThree(hide(value)));
    say("sum or nothing " + name, () => sumOrNothing(hide(value)));
    say("spell " + name, () => spell(hide(value)));
    say("around " + name, () => around(hide(value), -2, 5));
    say("both " + name, () => both(hide(value), hide(new Float64Array([1, 2]))) + both(hide([1, 2]), hide(value)));
  }
  for (const [name, value] of given()) say("fill " + name, () => fill(hide(value), 300.5));
  for (const [name, value] of given()) say("fill past " + name, () => fillPast(hide(value), -1, 5, -1));
  for (const Kind of [Uint8Array, Float64Array]) {
    const size = Kind.BYTES_PER_ELEMENT;
    for (const [how, view] of [
      ["tracking", (b: ArrayBuffer) => new Kind(b)],
      ["tracking at an offset", (b: ArrayBuffer) => new Kind(b, 16)],
      ["fixed", (b: ArrayBuffer) => new Kind(b, 8, 3)],
    ] as const) {
      const name = Kind.name + " " + how;
      say("shrunk " + name, () => { const b = resizable(8, 16); return sumWhile(hide(view(b)), i => { if (i === 1) b.resize(3 * size); }); });
      say("emptied " + name, () => { const b = resizable(8, 16); return sumWhile(hide(view(b)), i => { if (i === 1) b.resize(0); }); });
      say("grown " + name, () => { const b = resizable(4, 16); return sumWhile(hide(view(b)), i => { if (i === 1) b.resize(48); }); });
      say("transferred " + name, () => { const b = resizable(8, 16); return sumWhile(hide(view(b)), i => { if (i === 1) b.transfer(); }); });
      say("counted " + name, () => { const b = resizable(8, 16); return sumTo(hide(view(b)) as any, 6, i => { if (i === 2) b.resize(size); }); });
    }
  }
}
console.log(lines.join("\n"));
//// loops-over-the-elements-of-whatever-is-given.js
// Loops that read and store elements under a number, given arrays, views of every kind, subclasses, strings and other objects, while the view is shrunk, grown, detached or given other members.
const holder = JSON.parse('{"list":[]}');
function hide(value) {
  holder.list.push(value);
  return holder.list.pop();
}
const lines = [];
function say(name, run) {
  let text;
  try {
    text = String(run());
  } catch (error) {
    text = error.constructor.name;
  }
  lines.push(name + " = " + text);
}

function sum(bytes) {
  let s = 0;
  for (let i = 0; i < bytes.length; i++) s = (s + bytes[i]) | 0;
  return s;
}
function join(bytes, from, to, step) {
  let s = "";
  for (let i = from; i < to; i += step) s += bytes[i] + ",";
  return s;
}
function joinUnder(bytes, keys) {
  let s = "";
  for (let k = 0; k < keys.length; k++) s += bytes[keys[k]] + ",";
  return s;
}
function fill(bytes, value) {
  for (let i = 0; i < bytes.length; i++) bytes[i] = value;
  return join(bytes, 0, bytes.length, 1);
}
function fillPast(bytes, from, to, value) {
  for (let i = from; i < to; i++) bytes[i] = value;
  return join(bytes, 0, bytes.length, 1) + Object.keys(bytes).length;
}
////= sumWhile	, each)
////= sumTo	, count, each)
function storeWhat(bytes, values) {
  for (let i = 0; i < values.length; i++) bytes[i] = values[i];
  return join(bytes, 0, bytes.length, 1);
}
function find(bytes, wanted) {
  for (let i = 0; i < bytes.length; i++) if (bytes[i] === wanted) return i;
  return -1;
}
function nested(rows, bytes) {
  let s = 0;
  for (let r = 0; r < rows; r++) for (let i = 0; i < bytes.length; i++) s = (s + bytes[i] * (r + 1)) | 0;
  return s;
}
function guarded(bytes) {
  let s = 0;
  try {
    for (let i = 0; i < bytes.length; i++) {
      try {
        s += bytes[i];
      } finally {
        s += 1;
      }
    }
  } catch (error) {
    return "caught " + error.constructor.name + " at " + s;
  }
  return s;
}
function* each(bytes) {
  for (let i = 0; i < bytes.length; i++) yield bytes[i];
}
function changing(first, second) {
  let bytes = first;
  let s = "";
  for (let i = 0; i < bytes.length; i++) {
    s += bytes[i] + ",";
    if (i === 1) bytes = second;
  }
  return s;
}

const kinds = [Int8Array, Uint8Array, Uint8ClampedArray, Int16Array, Uint16Array, Int32Array, Uint32Array, Float32Array, Float64Array];
if (typeof Float16Array === "function") kinds.push(Float16Array);
function receivers() {
  const list = [
    ["array", [1, 2, 3, 250]],
    ["array of doubles", [1.5, 2.5, -0, NaN]],
    ["array with a hole", [1, , 3]],
    ["array of anything", [1, "2", null, { valueOf: () => 4 }]],
    ["empty array", []],
    ["buffer", Buffer.from([1, 2, 3, 250])],
    ["slice of a buffer", Buffer.from([9, 1, 2, 3, 250, 9]).subarray(1, 5)],
    ["empty buffer", Buffer.alloc(0)],
    ["string", "1230"],
    ["string object", new String("12")],
    ["object with a length", { length: 3, 0: 5, 2: 7 }],
    ["arguments", (function () { return arguments; })(4, 5, 6)],
    ["proxy of a view", new Proxy(new Uint8Array([7, 8]), {})],
    ["function", function (a, b) {}],
    ["number", 5],
    ["null", null],
    ["undefined", undefined],
    ["big views", new BigInt64Array([1n, 2n])],
    ["data view", new DataView(new ArrayBuffer(4))],
    ["array buffer", new ArrayBuffer(4)],
  ];
  for (const Kind of kinds) list.push([Kind.name, new Kind([1, 2, 3, 250])], [Kind.name + " at an offset", new Kind(new Kind([9, 1, 2, 3]).buffer, Kind.BYTES_PER_ELEMENT, 2)]);
  return list;
}

for (let round = 0; round < 3; round++) {
  for (const [name, value] of receivers()) {
    say("sum " + name, () => sum(hide(value)));
    say("find " + name, () => find(hide(value), 3));
    say("nested " + name, () => nested(3, hide(value)));
    say("guarded " + name, () => guarded(hide(value)));
    say("each " + name, () => [...each(hide(value))].join());
    say("join around " + name, () => join(hide(value), -2, 6, 1));
    say("join by halves " + name, () => join(hide(value), -1, 3, 0.5));
    say("join far " + name, () => join(hide(value), 4294967294, 4294967298, 1));
    say("join under " + name, () => joinUnder(hide(value), hide([0, -0, 1.5, NaN, Infinity, -1, 4294967296, 2147483648, "1", "01", "-0", "length", 1e21, null, undefined, true])));
  }
  for (const [name, value] of receivers()) {
    say("fill " + name, () => fill(hide(value), 300.7));
  }
  for (const [name, value] of receivers()) {
    say("fill past " + name, () => fillPast(hide(value), -1, 6, -1));
  }
  for (const [name, value] of receivers()) {
    say("store " + name, () => storeWhat(hide(value), hide([1.9, -1.9, NaN, "7", null, undefined, true, { valueOf: () => 258 }, 4294967297, -0])));
  }
  for (const [name, value] of receivers()) say("changing " + name, () => changing(hide(new Uint8Array([1, 2, 3, 4])), hide(value)) + changing(hide(value), hide(new Uint8Array([1, 2, 3, 4]))));
}

function resizable(Kind, count, most) {
  const buffer = new ArrayBuffer(count * Kind.BYTES_PER_ELEMENT, { maxByteLength: most * Kind.BYTES_PER_ELEMENT });
  const tracking = new Kind(buffer);
  for (let i = 0; i < count; i++) tracking[i] = i + 1;
  return buffer;
}
for (let round = 0; round < 3; round++) {
  for (const Kind of [Uint8Array, Int32Array, Float64Array]) {
    const size = Kind.BYTES_PER_ELEMENT;
    const views = [
      ["tracking", buffer => new Kind(buffer)],
      ["tracking at an offset", buffer => new Kind(buffer, 2 * size)],
      ["fixed", buffer => new Kind(buffer, 0, 6)],
      ["fixed at an offset", buffer => new Kind(buffer, 2 * size, 4)],
    ];
    for (const [how, view] of views) {
      const name = Kind.name + " " + how;
      say("shrunk " + name, () => { const b = resizable(Kind, 8, 16); return sumWhile(hide(view(b)), i => { if (i === 2) b.resize(4 * size); }); });
      say("shrunk to nothing " + name, () => { const b = resizable(Kind, 8, 16); return sumWhile(hide(view(b)), i => { if (i === 2) b.resize(0); }); });
      say("shrunk and grown " + name, () => { const b = resizable(Kind, 8, 16); return sumWhile(hide(view(b)), i => { if (i === 1) b.resize(size); if (i === 3) b.resize(12 * size); }); });
      say("grown " + name, () => { const b = resizable(Kind, 8, 16); return sumWhile(hide(view(b)), i => { if (i === 2) b.resize(12 * size); }); });
      say("transferred " + name, () => { const b = resizable(Kind, 8, 16); return sumWhile(hide(view(b)), i => { if (i === 2) b.transfer(); }); });
      say("counted while shrunk " + name, () => { const b = resizable(Kind, 8, 16); return sumTo(hide(view(b)), 8, i => { if (i === 3) b.resize(2 * size); }); });
      say("counted while detached " + name, () => { const b = resizable(Kind, 8, 16); return sumTo(hide(view(b)), 8, i => { if (i === 3) structuredClone(b, { transfer: [b] }); }); });
      say("stored while shrunk " + name, () => { const b = resizable(Kind, 8, 16); return storeWhat(hide(view(b)), hide([1, 2, { valueOf() { b.resize(2 * size); return 3; } }, 4, 5, 6])); });
      say("stored while detached " + name, () => { const b = resizable(Kind, 8, 16); return storeWhat(hide(view(b)), hide([1, 2, { valueOf() { b.transfer(); return 3; } }, 4, 5, 6])); });
    }
    say("detached " + Kind.name, () => { const v = new Kind([1, 2, 3, 4, 5]); return sumWhile(hide(v), i => { if (i === 1) v.buffer.transfer(); }); });
    say("detached before " + Kind.name, () => { const v = new Kind([1, 2, 3, 4, 5]); v.buffer.transfer(); return sum(hide(v)) + join(hide(v), 0, 3, 1) + fillPast(hide(v), 0, 3, 1); });
    say("shared and grown " + Kind.name, () => {
      const b = new SharedArrayBuffer(4 * size, { maxByteLength: 16 * size });
      const v = new Kind(b);
      return sumWhile(hide(v), i => { v[i] = i + 1; if (i === 2) b.grow(7 * size); });
    });
  }
  say("buffer detached", () => { const v = Buffer.from(new ArrayBuffer(6)); v.fill(3); return sumWhile(hide(v), i => { if (i === 1) v.buffer.transfer(); }); });
  say("buffer over a resizable", () => { const b = resizable(Uint8Array, 8, 16); return sumWhile(hide(Buffer.from(b)), i => { if (i === 2) b.resize(3); }); });
}

////= lines	OwnLength	Uint8Array	2
////= lines	LongLength	Uint8Array	6
class CountingLength extends Uint8Array {
  reads = 0;
  get length() {
    return ++this.reads > 3 ? 0 : 4;
  }
}
class OtherSpecies extends Uint8Array {
  static get [Symbol.species]() {
    return Array;
  }
}
////= lines	BelowBuffer	Buffer	1
for (let round = 0; round < 3; round++) {
  say("own length", () => sum(hide(new OwnLength([1, 2, 3, 4]))) + join(hide(new OwnLength([1, 2, 3, 4])), 0, 5, 1));
  say("long length", () => sum(hide(new LongLength([1, 2, 3, 4]))) + fill(hide(new LongLength([1, 2, 3, 4])), 9));
  say("counting length", () => sum(hide(new CountingLength([1, 2, 3, 4]))));
  say("other species", () => sum(hide(new OtherSpecies([1, 2, 3, 4]))) + sum(hide(new OtherSpecies([1, 2, 3, 4]).subarray ? new OtherSpecies([1, 2, 3, 4]) : [])));
  say("length on the instance", () => { const v = new Uint8Array([1, 2, 3, 4]); Object.defineProperty(v, "length", { value: 2 }); return sum(hide(v)) + find(hide(v), 3); });
  say("getter on the instance", () => { const v = Buffer.from([1, 2, 3, 4]); let n = 0; Object.defineProperty(v, "length", { get: () => (n++ < 2 ? 4 : 0) }); return sum(hide(v)); });
  say("length defined in the loop", () => { const v = new Uint8Array([1, 2, 3, 4]); return sumWhile(hide(v), i => { if (i === 0) Object.defineProperty(v, "length", { value: 2, configurable: true }); }); });
  say("prototype of arrays", () => { const v = new Uint8Array([1, 2, 3, 4]); Object.setPrototypeOf(v, Array.prototype); return sum(hide(v)) + join(hide(v), 0, 5, 1); });
  say("no prototype", () => { const v = new Uint8Array([1, 2, 3, 4]); Object.setPrototypeOf(v, null); return sum(hide(v)) + join(hide(v), 0, 5, 1); });
  say("prototype with elements", () => { const v = new Uint8Array([1, 2]); Object.setPrototypeOf(v, { length: 4, 2: "two", 3: "three", "-1": "minus", 1.5: "half" }); return join(hide(v), -1, 4, 0.5); });
  say("prototype swapped in the loop", () => { const v = new Uint8Array([1, 2, 3, 4]); return sumWhile(hide(v), i => { if (i === 1) Object.setPrototypeOf(v, { length: 3 }); }); });
  say("array below a view", () => { const a = [1, , 3]; Object.setPrototypeOf(a, new Uint8Array([7, 8, 9])); return sum(hide(a)) + join(hide(a), 0, 4, 1); });
  say("object below a view", () => { const o = Object.create(new Uint8Array([7, 8, 9])); return guarded(hide(o)) + join(hide(o), 0, 4, 1) + fillPast(hide(o), 0, 4, 1); });
  say("below buffer", () => { const v = Buffer.from([1, 2, 3]); Object.setPrototypeOf(v, BelowBuffer.prototype); return sum(hide(v)); });
  say("sealed", () => fillPast(hide(Object.seal(new Uint8Array([1, 2]))), 0, 4, 5));
  say("not extensible", () => fillPast(hide(Object.preventExtensions(new Uint8Array([1, 2]))), -1, 4, 5));
  say("extra names", () => { const v = new Uint8Array([1, 2]); v.extra = 1; v["1.5"] = 2; v["-0"] = 3; v["01"] = 4; return joinUnder(hide(v), hide(["extra", "1.5", 1.5, "-0", -0, "01", 1])) + Object.keys(v); });
}
console.log(lines.join("\n"));
//// loops-that-expect-an-array-are-handed-other-iterables.js
// A loop that is predicted to walk an array is handed a string, a set, a map, a generator, built-in iterators and iterators of the program's own: what is opened, stepped and closed, how often and in which order, and which error wins, is what plain Bun does.
function sum(values, weigh) {
  let total = 0;
  for (const value of values) total += weigh(value);
  return total;
}
function first(values) {
  for (const value of values) {
    if (value) return value;
  }
  return null;
}
function pairs(values) {
  const found = [];
  outer: for (const a of values) {
    for (const b of values) {
      if (a === b) continue outer;
      found.push(`${String(a)}${String(b)}`);
      if (found.length > 5) break outer;
    }
  }
  return found.join(" ");
}
function* count() {
  try {
    yield 1;
    yield 2;
    yield 3;
  } finally {
    console.log("the generator is closed");
  }
}
class Countdown {
  constructor(from) {
    this.left = from;
    this.closed = 0;
    this.steps = 0;
  }
  [Symbol.iterator]() {
    return this;
  }
  next() {
    this.steps++;
    return this.left > 0 ? { done: false, value: this.left-- } : { done: true, value: "never read" };
  }
  return() {
    this.closed++;
    return {};
  }
}
const weigh = value => (typeof value === "number" ? value * 2 : typeof value === "string" ? value.length : 1);
const make = [() => [1, 2, 3], () => "a\u{1F600}b", () => new Set([4, 5]), () => new Map([[1, 2]]), () => count(), () => new Countdown(3), () => new Map([["k", 1]]).keys(), () => [7, 8].entries(), () => ""];
for (const one of make) console.log(sum(one(), weigh), String(first(one())), pairs(one()));

const left = new Countdown(3);
console.log(first(left), left.closed, left.steps);
const thrown = new Countdown(3);
try {
  sum(thrown, () => {
    throw new Error("out of the body");
  });
} catch (error) {
  console.log(error.message, thrown.closed, thrown.steps);
}
const throwsWhenClosed = { [Symbol.iterator]() { return this; }, next() { return { done: false, value: 1 }; }, return() { throw new Error("out of return"); } };
try {
  first(throwsWhenClosed);
} catch (error) {
  console.log(error.message);
}
try {
  sum(throwsWhenClosed, () => {
    throw new Error("the body's own");
  });
} catch (error) {
  console.log(error.message);
}
const throwsAtStep = { closed: 0, [Symbol.iterator]() { return this; }, next() { throw new Error("out of next"); }, return() { this.closed++; return {}; } };
try {
  sum(throwsAtStep, weigh);
} catch (error) {
  console.log(error.message, throwsAtStep.closed);
}
for (const wrong of [undefined, null, 5, {}, { [Symbol.iterator]: 1 }, { [Symbol.iterator]() { return 1; } }, { [Symbol.iterator]() { return { next() { return 1; } }; } }, { [Symbol.iterator]() { return {}; } }]) {
  try {
    console.log(sum(wrong, weigh));
  } catch (error) {
    console.log(error.constructor.name);
  }
}
const returnsNoObject = { [Symbol.iterator]() { return this; }, next() { return { done: false, value: 1 }; }, return() { return 1; } };
try {
  console.log(first(returnsNoObject));
} catch (error) {
  console.log(error.constructor.name);
}
const nextIsReadOnce = { reads: 0, [Symbol.iterator]() { return this; }, get next() { this.reads++; let left = 2; return () => ({ done: left-- <= 0, value: left }); } };
console.log(sum(nextIsReadOnce, weigh), nextIsReadOnce.reads);
//// maximum.js
// The elements come out of JSON.parse, so that nothing about them is known before the program runs. The list itself is an array of the program.
////= make

function kernel(values) {
  var best = -Infinity;
  for (var i = 0; i < values.length; i++) {
    if (values[i] > best) best = values[i];
  }
  return best;
}

var input = make("integers", 1000);
var checksum = 0;
for (var round = 0; round < 30000; round++) checksum = (checksum + kernel(input)) % 1000000007;
console.log(checksum);
//// pointer-chase.js
// The elements come out of JSON.parse, so that nothing about them is known before the program runs. The list itself is an array of the program.
////= make

function kernel(next) {
  var at = 0;
  for (var step = 0; step < next.length; step++) at = next[at];
  return at;
}

var input = make("permutation", 1000);
var checksum = 0;
for (var round = 0; round < 30000; round++) checksum = (checksum + kernel(input)) % 1000000007;
console.log(checksum);
//// product-and-remainder.js
// The elements come out of JSON.parse, so that nothing about them is known before the program runs. The list itself is an array of the program.
////= make

function kernel(values) {
  var hash = 7;
  for (var i = 0; i < values.length; i++) hash = (hash * 31 + values[i]) % 65521;
  return hash;
}

var input = make("integers", 1000);
var checksum = 0;
for (var round = 0; round < 30000; round++) checksum = (checksum + kernel(input)) % 1000000007;
console.log(checksum);
//// short-loops.js
// The elements come out of JSON.parse, so that nothing about them is known before the program runs. The list itself is an array of the program.
////= make

function kernel(values) {
  var total = 0;
  for (var i = 0; i < values.length; i++) total += values[i];
  return total;
}

var rows = [];
for (var r = 0; r < 300; r++) rows.push(make("integers", 1 + (r % 4)));
var checksum = 0;
for (var round = 0; round < 40000; round++) {
  for (var r = 0; r < rows.length; r++) checksum = (checksum + kernel(rows[r])) % 1000000007;
}
console.log(checksum);
//// two-carried-numbers.js
// The elements come out of JSON.parse, so that nothing about them is known before the program runs. The list itself is an array of the program.
////= make

function kernel(values) {
  var a = 0;
  var b = 1;
  for (var i = 0; i < values.length; i++) {
    var c = (a + b + values[i]) % 1000003;
    a = b;
    b = c;
  }
  return a + b;
}

var input = make("integers", 1000);
var checksum = 0;
for (var round = 0; round < 30000; round++) checksum = (checksum + kernel(input)) % 1000000007;
console.log(checksum);
//// while-with-carried-index.js
// The elements come out of JSON.parse, so that nothing about them is known before the program runs. The list itself is an array of the program.
////= make

function kernel(values) {
  var i = 0;
  var count = 0;
  while (i < values.length) {
    count++;
    i += (values[i] & 3) + 1;
  }
  return count;
}

var input = make("integers", 1000);
var checksum = 0;
for (var round = 0; round < 30000; round++) checksum = (checksum + kernel(input)) % 1000000007;
console.log(checksum);
