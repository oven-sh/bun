//// promises.js
// Promises in `then` and `catch` chains, under `await` with a rejection that is caught, ten at a time under Promise.all, and behind a callback.
function delayValue(value) {
  return new Promise(function (resolve) {
    resolve(value);
  });
}

function fetchRecord(id) {
  return delayValue({ id: id, size: id % 13 });
}

function chain(id) {
  return fetchRecord(id)
    .then(function (record) {
      return record.size + 1;
    })
    .then(function (size) {
      if (size === 5) throw new Error("five");
      return size * 2;
    })
    .catch(function (error) {
      return error.message.length;
    });
}

async function viaAwait(id) {
  var record = await fetchRecord(id);
  var extra = await record.size;
  try {
    if (extra === 7) await Promise.reject(new Error("seven"));
  } catch (error) {
    extra += error.message.length;
  }
  return record.id + extra;
}

async function batch(start, size) {
  var pending = [];
  for (var i = 0; i < size; i++) pending.push(i & 1 ? chain(start + i) : viaAwait(start + i));
  var results = await Promise.all(pending);
  var total = 0;
  for (var j = 0; j < results.length; j++) total += results[j];
  return total;
}

function callbackStyle(value, done) {
  Promise.resolve(value).then(function (result) {
    done(null, result + 1);
  });
}

async function run(rounds) {
  var total = 0;
  for (var i = 0; i < rounds; i++) {
    total += await batch(i * 10, 10);
    total += await new Promise(function (resolve) {
      callbackStyle(i & 3, function (error, result) {
        resolve(result);
      });
    });
  }
  return total;
}

run(40000).then(function (total) {
  console.log(total);
});
//// reducers.js
// A store with reducers that never change their state: for every action arrays and objects are copied with spread, map and filter, and the listeners are called.
const initial = { todos: [], filter: "all", nextId: 1, stats: { added: 0, done: 0 } };

function todos(state, action) {
  switch (action.type) {
    case "add":
      return [...state, { id: action.id, text: action.text, done: false }];
    case "toggle":
      return state.map(todo => (todo.id === action.id ? { ...todo, done: !todo.done } : todo));
    case "remove":
      return state.filter(todo => todo.id !== action.id);
    default:
      return state;
  }
}

function stats(state, action) {
  switch (action.type) {
    case "add":
      return { ...state, added: state.added + 1 };
    case "toggle":
      return { ...state, done: state.done + 1 };
    default:
      return state;
  }
}

function reducer(state = initial, action) {
  const next = {
    todos: todos(state.todos, action),
    filter: action.type === "filter" ? action.filter : state.filter,
    nextId: action.type === "add" ? state.nextId + 1 : state.nextId,
    stats: stats(state.stats, action),
  };
  return next;
}

function createStore(reduce) {
  let state = reduce(undefined, { type: "@init" });
  const listeners = [];
  return {
    getState: () => state,
    subscribe: listener => listeners.push(listener),
    dispatch(action) {
      state = reduce(state, action);
      for (const listener of listeners) listener(state);
      return action;
    },
  };
}

const visible = ({ todos, filter }) => (filter === "all" ? todos : todos.filter(todo => (filter === "done" ? todo.done : !todo.done)));

function run(rounds) {
  let total = 0;
  for (let round = 0; round < rounds; round++) {
    const store = createStore(reducer);
    let notified = 0;
    store.subscribe(() => notified++);
    for (let i = 0; i < 40; i++) {
      store.dispatch({ type: "add", id: store.getState().nextId, text: "todo " + i });
      if (i % 3 === 0) store.dispatch({ type: "toggle", id: (i >> 1) + 1 });
      if (i % 7 === 0) store.dispatch({ type: "remove", id: (i >> 2) + 1 });
      if (i % 10 === 0) store.dispatch({ type: "filter", filter: i % 20 === 0 ? "done" : "open" });
    }
    const state = store.getState();
    total += visible(state).length + state.stats.added + state.stats.done + notified;
  }
  return total;
}

