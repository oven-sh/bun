function fastestOf(runs, «1») {
  let fastest = Infinity;
  for (let «2» = 0; «2» < runs; «2»++) {
    const began = performance.now();
    if («1»(«3») !== «4») console.log("a wrong sum");
    fastest = Math.min(fastest, performance.now() - began);
  }
  return fastest;
}
////: lines
const «1» = fastestOf(5, () => {
  let sum = 0;
  for (let i = 0; i < 5_000_000; i++) sum = (sum + «2».a + «2».b + «2».c + i) | 0;
  sums = (sums + sum) | 0;
});
////: lines-2
