//// the-name-of-a-function-that-holds-six-variables-is-not-five-times-as-slow-as-the-name-of-one-that-holds-two.js
// Packages that wrap a callback ask for its name first: `fn.name || "anonymous"`. The callback is a function made for the occasion, so each one is asked once. How many variables of its surroundings it
// holds says nothing about its name: the question may cost about the same for one that holds six as for one that holds two.
function nameOf(fn) { return fn.name || "anonymous"; }
function holdingTwo(a, b) { return function two(x) { return a + b + x; }; }
function holdingSix(a, b, c, d, e, f) { return function six(x) { return a + b + c + d + e + f + x; }; }
function fastestOf(runs, make) {
  let fastest = Infinity, letters = 0;
  for (let run = 0; run < runs; run++) {
    const began = performance.now();
    for (let i = 0; i < 300000; i++) letters += nameOf(make(i, 1, 2, 3, 4, 5)).length;
    fastest = Math.min(fastest, performance.now() - began);
  }
  return { fastest, letters };
}
const two = fastestOf(5, holdingTwo), six = fastestOf(5, holdingSix);
console.log(two.letters, six.letters);
console.log(six.fastest < two.fastest * 5 ? "six variables in under five times the time of two" : "six variables took over five times the time of two");
//// the-own-keys-of-an-object-are-counted-in-no-more-than-twice-the-time-of-its-values.js
const shape = { a: 1, b: 2, c: 3, d: 4, e: 5 };
function countKeys(turns) {
  let sum = 0;
  for (let i = 0; i < turns; i++) sum += Object.keys(shape).length + (i & 1);
  return sum;
}
function countValues(turns) {
  let sum = 0;
  for (let i = 0; i < turns; i++) sum += Object.values(shape).length + (i & 1);
  return sum;
}
////= fastestOf-3	count	run	4_000_000	22_000_000
fastestOf(2, countKeys), fastestOf(2, countValues);
const keys = fastestOf(5, countKeys), values = fastestOf(5, countValues);
console.log(keys < values * 2 ? "under twice the time" : "over twice the time");
//// the-strings-of-a-tagged-template-are-not-ten-times-as-slow-to-read-as-those-of-an-array.js
// A tag function reads `strings[k]`. The strings object is frozen; a read of it may cost more than a read of an array that the program wrote itself, but not ten times as much.
function lengths(strings, ...values) {
  let sum = 0;
  for (let k = 0; k < values.length; k++) sum += strings[k].length + values[k];
  return sum;
}
const written = ["a", "bc", "d"];
function tagged(turns) {
  let sum = 0;
  for (let i = 0; i < turns; i++) sum += lengths`a${i & 7}bc${2}d`;
  return sum;
}
function called(turns) {
  let sum = 0;
  for (let i = 0; i < turns; i++) sum += lengths(written, i & 7, 2);
  return sum;
}
////= fastestOf-3	run	k	800_000	6_800_000
fastestOf(2, tagged), fastestOf(2, called);
console.log(fastestOf(5, tagged) < fastestOf(5, called) * 10 ? "under ten times the time" : "over ten times the time");
//// the-time-of-day-in-a-field-that-began-at-zero-is-not-ten-times-as-slow-a-store-as-a-small-number.cjs
// Two instances of one untyped class whose field begins at zero. One is handed small numbers, the other the time of day in milliseconds, which does not fit 32 bits. A turn with the second may cost a few times what a turn with the first costs, not ten times.
class Stamp {
  constructor() {
    this.at = 0;
    this.count = 0;
  }
  touch(at) {
    this.at = at;
    this.count++;
  }
}
////= fastestOf
const early = new Stamp(),
  late = new Stamp(),
  now = Date.now();
const small = fastestOf(5, () => {
  for (let i = 0; i < 2_000_000; i++) early.touch(i);
});
const large = fastestOf(5, () => {
  for (let i = 0; i < 2_000_000; i++) late.touch(now + i);
});
console.log(early.at, early.count, late.at - now, late.count, Object.keys(late).join());
console.log(large < small * 10 ? "under ten times the time" : "over ten times the time");
//// the-twin-of-a-node-is-asked-only-for-its-index.js
// The twin of a node is asked for one thing only, its index, a name that arrays of matches have too.
const word = process.argv[3] ?? "";
const open = new Function("value", "return value" + word.slice(word.length));
function TreeNode(index) { this.index = index; this.flags = 0; this.twin = null; this.sibling = null; }
function place(node, last, index) {
  node.index = index;
  var twin = node.twin;
  if (null !== twin) return (twin = twin.index), twin < last ? ((node.flags |= 2), last) : twin;
  node.flags |= 2;
  return last;
}
const nodes = [];
for (let i = 0; i < 8; i++) { const node = new TreeNode(i), twin = new TreeNode(7 - i); node.twin = twin; twin.twin = node; nodes.push(node); }
const rounds = Number(process.argv[2] ?? 200000);
const given = open(nodes);
let sum = 0;
for (let i = 0; i < rounds; i++) { let last = 0; for (let k = 0; k < 8; k++) last = place(given[k], last, k); sum += last; }
console.log(sum, nodes[3].flags);
//// tokenizer.js
// A tokenizer that reads character codes, switches on them and allocates one small object a token, with a `text` or with a `value`.
function isDigit(code) {
  return code >= 48 && code <= 57;
}
function isLetter(code) {
  return (code >= 97 && code <= 122) || (code >= 65 && code <= 90) || code === 95;
}

var keywords = { if: true, else: true, while: true, return: true, var: true, function: true };

function tokenize(source) {
  var tokens = [];
  var at = 0;
  var length = source.length;
  while (at < length) {
    var code = source.charCodeAt(at);
    var start = at;
    switch (code) {
      case 32:
      case 10:
      case 9:
        at++;
        continue;
      case 40:
      case 41:
      case 123:
      case 125:
      case 59:
      case 44:
        at++;
        tokens.push({ kind: "punctuation", text: source.charAt(start), at: start });
        continue;
      case 34:
        at++;
        while (at < length && source.charCodeAt(at) !== 34) at += source.charCodeAt(at) === 92 ? 2 : 1;
        at++;
        tokens.push({ kind: "string", text: source.slice(start + 1, at - 1), at: start });
        continue;
    }
    if (isDigit(code)) {
      var value = 0;
      while (at < length && isDigit((code = source.charCodeAt(at)))) {
        value = value * 10 + (code - 48);
        at++;
      }
      tokens.push({ kind: "number", value: value, at: start });
    } else if (isLetter(code)) {
      while (at < length && (isLetter((code = source.charCodeAt(at))) || isDigit(code))) at++;
      var word = source.slice(start, at);
      tokens.push({ kind: keywords[word] === true ? "keyword" : "name", text: word, at: start });
    } else {
      at++;
      if (source.charCodeAt(at) === 61) at++;
      tokens.push({ kind: "operator", text: source.slice(start, at), at: start });
    }
  }
  return tokens;
}

function checksum(tokens) {
  var total = 0;
  for (var i = 0; i < tokens.length; i++) {
    var token = tokens[i];
    total += token.kind.length + token.at;
    if (token.kind === "number") total += token.value;
    else total += token.text.length;
  }
  return total;
}

function run(rounds) {
  var line = 'function step(a, b) { var total = a * 12 + b; if (total >= 100) { return "big\\"one"; } else { while (a < 7) a += 1; } return total; }\n';
  var source = "";
  for (var i = 0; i < 40; i++) source += line;
  var total = 0;
  for (var round = 0; round < rounds; round++) total += checksum(tokenize(source));
  return total;
}

console.log(run(700));
//// trees-and-graphs.js
// A binary search tree of ES5 nodes, filled recursively, searched in a loop and walked with a callback, and a breadth-first search over a graph kept in dictionaries.
function TreeNode(key, value) {
  this.key = key;
  this.value = value;
  this.left = null;
  this.right = null;
}

function insert(node, key, value) {
  if (node === null) return new TreeNode(key, value);
  if (key < node.key) node.left = insert(node.left, key, value);
  else if (key > node.key) node.right = insert(node.right, key, value);
  else node.value = value;
  return node;
}

function find(node, key) {
  while (node !== null) {
    if (key === node.key) return node.value;
    node = key < node.key ? node.left : node.right;
  }
  return -1;
}

function height(node) {
  return node === null ? 0 : 1 + Math.max(height(node.left), height(node.right));
}

function inOrder(node, visit) {
  if (node === null) return;
  inOrder(node.left, visit);
  visit(node);
  inOrder(node.right, visit);
}

function Graph() {
  this.edges = {};
}
Graph.prototype.connect = function (from, to) {
  (this.edges[from] || (this.edges[from] = [])).push(to);
  (this.edges[to] || (this.edges[to] = [])).push(from);
};
Graph.prototype.distances = function (start) {
  var distance = {};
  distance[start] = 0;
  var queue = [start];
  for (var head = 0; head < queue.length; head++) {
    var node = queue[head];
    var neighbors = this.edges[node] || [];
    for (var i = 0; i < neighbors.length; i++) {
      var next = neighbors[i];
      if (distance[next] === undefined) {
        distance[next] = distance[node] + 1;
        queue.push(next);
      }
    }
  }
  return distance;
}

function run(rounds) {
  var total = 0;
  var graph = new Graph();
  for (var n = 0; n < 60; n++) {
    graph.connect("n" + n, "n" + ((n * 7 + 3) % 60));
    graph.connect("n" + n, "n" + ((n + 1) % 60));
  }
  for (var round = 0; round < rounds; round++) {
    var root = null;
    var seed = round + 1;
    for (var i = 0; i < 300; i++) {
      seed = (Math.imul(seed, 1103515245) + 12345) & 0x7fffffff;
      root = insert(root, seed % 1000, i);
    }
    for (var key = 0; key < 1000; key += 3) total += find(root, key) & 7;
    var sum = 0;
    inOrder(root, function (node) {
      sum = (sum * 31 + node.key) % 65521;
    });
    total += sum + height(root);
    var distance = graph.distances("n" + (round % 60));
    total += distance["n" + ((round * 13) % 60)];
  }
  return total;
}

console.log(run(2500));
//// validators.js
// A schema compiled into nested closures that check five sample objects: `typeof`, `in`, regular expressions made from strings, and messages put together from strings.
function typeOf(value) {
  if (value === null) return "null";
  if (Array.isArray(value)) return "array";
  return typeof value;
}

function compile(schema, path) {
  path = path || "$";
  var checks = [];
  if (schema.type) {
    checks.push(function (value, errors) {
      if (typeOf(value) !== schema.type) errors.push(path + ": expected " + schema.type);
    });
  }
  if (schema.minimum !== undefined) {
    checks.push(function (value, errors) {
      if (typeof value === "number" && value < schema.minimum) errors.push(path + ": below " + schema.minimum);
    });
  }
  if (schema.maxLength !== undefined) {
    checks.push(function (value, errors) {
      if (typeof value === "string" && value.length > schema.maxLength) errors.push(path + ": too long");
    });
  }
  if (schema.pattern) {
    var pattern = new RegExp(schema.pattern);
    checks.push(function (value, errors) {
      if (typeof value === "string" && !pattern.test(value)) errors.push(path + ": does not match");
    });
  }
  if (schema.enum) {
    checks.push(function (value, errors) {
      if (schema.enum.indexOf(value) < 0) errors.push(path + ": not allowed");
    });
  }
  if (schema.properties) {
    var required = schema.required || [];
    var names = Object.keys(schema.properties);
    var validators = names.map(function (name) {
      return compile(schema.properties[name], path + "." + name);
    });
    checks.push(function (value, errors) {
      if (typeOf(value) !== "object") return;
      for (var i = 0; i < required.length; i++) {
        if (!(required[i] in value)) errors.push(path + "." + required[i] + ": missing");
      }
      for (var j = 0; j < names.length; j++) {
        if (value[names[j]] !== undefined) validators[j](value[names[j]], errors);
      }
    });
  }
  if (schema.items) {
    var item = compile(schema.items, path + "[]");
    checks.push(function (value, errors) {
      if (!Array.isArray(value)) return;
      for (var i = 0; i < value.length; i++) item(value[i], errors);
    });
  }
  return function (value, errors) {
    for (var i = 0; i < checks.length; i++) checks[i](value, errors);
    return errors;
  };
}

var validate = compile({
  type: "object",
  required: ["id", "email"],
  properties: {
    id: { type: "number", minimum: 1 },
    email: { type: "string", pattern: "^[^@ ]+@[^@ ]+$", maxLength: 24 },
    role: { enum: ["admin", "user", "guest"] },
    tags: { type: "array", items: { type: "string", maxLength: 5 } },
    address: { type: "object", required: ["city"], properties: { city: { type: "string" }, zip: { type: "string", pattern: "^\\d{5}$" } } },
  },
});

function run(count) {
  var samples = [
    { id: 1, email: "ann@example.com", role: "admin", tags: ["a", "bb"], address: { city: "Paris", zip: "75001" } },
    { id: 0, email: "bob", role: "root", tags: ["toolong", 3] },
    { email: "cy@example.org", address: { zip: "12" } },
    { id: 7, email: "di@a-very-long-domain-name.example", tags: [] },
    { id: "8", email: 9, address: null },
  ];
  var total = 0;
  for (var i = 0; i < count; i++) {
    var errors = validate(samples[i % samples.length], []);
    total += errors.length;
    if (errors.length) total += errors[errors.length - 1].length;
  }
  return total;
}

console.log(run(300000));
