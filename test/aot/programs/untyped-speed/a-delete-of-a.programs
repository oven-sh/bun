// Options laid over defaults with Object.assign(), beside a literal with the same three fields. A read out of the one may cost a little more than a read out of the other, not three times as much.
const defaults = { a: 1, b: 2 };
function withDefaults(options) {
  return Object.assign({}, defaults, options);
}
const assigned = withDefaults({ c: 3 }),
  literal = { a: 1, b: 2, c: 3 };
let sums = 0;
////= fastestOf
////= lines	ofTheLiteral	literal
////= lines	ofTheAssigned	assigned
console.log(sums, JSON.stringify(assigned));
console.log(ofTheAssigned < ofTheLiteral * 3 ? "under three times the time" : "over three times the time");
//// array-callbacks.js
// Array callbacks in ES5 style over a list of 3,000 objects: filter, map, reduce, some, every, forEach, sort and find, with closures that read a property under a computed name.
function makeOrders(count) {
  var orders = [];
  for (var i = 0; i < count; i++) {
    orders.push({ id: i, customer: "c" + (i % 23), amount: (i * 37) % 500, open: i % 3 !== 0 });
  }
  return orders;
}

function pluck(name) {
  return function (item) {
    return item[name];
  };
}

function add(a, b) {
  return a + b;
}

function groupBy(list, keyOf) {
  return list.reduce(function (groups, item) {
    var key = keyOf(item);
    (groups[key] = groups[key] || []).push(item);
    return groups;
  }, {});
}

function report(orders) {
  var open = orders.filter(function (order) {
    return order.open;
  });
  var total = open.map(pluck("amount")).reduce(add, 0);
  var large = open.some(function (order) {
    return order.amount > 495;
  });
  var valid = orders.every(function (order) {
    return order.amount >= 0;
  });
  var groups = groupBy(open, pluck("customer"));
  var best = 0;
  Object.keys(groups).forEach(function (customer) {
    var spent = groups[customer].map(pluck("amount")).reduce(add, 0);
    if (spent > best) best = spent;
  });
  var sorted = open.slice(0, 200).sort(function (a, b) {
    return b.amount - a.amount || a.id - b.id;
  });
  var found = orders.find(function (order) {
    return order.id === 777;
  });
  return total + best + sorted[0].id + (large ? 1 : 0) + (valid ? 2 : 0) + found.amount + orders.indexOf(found);
}

function run(rounds) {
  var orders = makeOrders(3000);
  var total = 0;
  for (var i = 0; i < rounds; i++) total += report(orders);
  return total;
}

console.log(run(250));
//// async-pipelines.js
// Async functions, an async generator read with `for await`, a callback API wrapped into promises, and four lanes that share one index under Promise.all.
function delay(value) {
  return new Promise(function (resolve) {
    resolve(value);
  });
}

function promisify(fn) {
  return function () {
    var args = Array.prototype.slice.call(arguments);
    var self = this;
    return new Promise(function (resolve, reject) {
      args.push(function (error, value) {
        if (error) reject(error);
        else resolve(value);
      });
      fn.apply(self, args);
    });
  };
}

function readRecord(id, callback) {
  if (id % 17 === 0) callback(new Error("missing " + id));
  else callback(null, { id: id, size: (id * 7) % 13 });
}

var readRecordAsync = promisify(readRecord);

async function load(id) {
  try {
    var record = await readRecordAsync(id);
    return record.size;
  } catch (error) {
    return error.message.length;
  }
}

async function* batches(count, size) {
  for (var start = 0; start < count; start += size) {
    var ids = [];
    for (var id = start; id < start + size && id < count; id++) ids.push(id);
    yield await delay(ids);
  }
}

async function mapLimit(items, limit, worker) {
  var results = new Array(items.length);
  var next = 0;
  async function lane() {
    while (next < items.length) {
      var index = next++;
      results[index] = await worker(items[index]);
    }
  }
  var lanes = [];
  for (var i = 0; i < limit; i++) lanes.push(lane());
  await Promise.all(lanes);
  return results;
}

async function run(count) {
  var total = 0;
  for await (var ids of batches(count, 25)) {
    var sizes = await mapLimit(ids, 4, load);
    total += sizes.reduce(function (sum, size) {
      return sum + size;
    }, 0);
    total += (await Promise.all([delay(1), delay(2), 3])).length;
  }
  return total;
}

run(200000).then(function (total) {
  console.log(total);
});
//// binary-parsing.js
// Records written and read through DataView and Uint8Array: a checksum, variable-length integers, hexadecimal text, subarray, and a Buffer made from one.
function writeRecords(count) {
  const bytes = new Uint8Array(count * 12 + 4);
  const view = new DataView(bytes.buffer);
  view.setUint32(0, count, true);
  let at = 4;
  for (let i = 0; i < count; i++) {
    bytes[at] = i & 3;
    bytes[at + 1] = (i * 7) & 255;
    view.setUint16(at + 2, (i * 31) & 65535, true);
    view.setInt32(at + 4, i * 1000 - 5000, true);
    view.setFloat32(at + 8, i / 4, true);
    at += 12;
  }
  return bytes;
}

function readVarint(bytes, state) {
  let value = 0;
  let shift = 0;
  let byte;
  do {
    byte = bytes[state.at++];
    value |= (byte & 127) << shift;
    shift += 7;
  } while (byte & 128);
  return value >>> 0;
}

function checksum(bytes) {
  let a = 1;
  let b = 0;
  for (let i = 0; i < bytes.length; i++) {
    a = (a + bytes[i]) % 65521;
    b = (b + a) % 65521;
  }
  return ((b << 16) | a) >>> 0;
}

function parse(bytes) {
  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
  const count = view.getUint32(0, true);
  const out = [];
  for (let i = 0, at = 4; i < count; i++, at += 12) {
    out.push({ kind: bytes[at], flags: bytes[at + 1], port: view.getUint16(at + 2, true), offset: view.getInt32(at + 4, true), ratio: view.getFloat32(at + 8, true) });
  }
  return out;
}

function toHex(bytes) {
  let text = "";
  for (let i = 0; i < bytes.length; i++) text += (bytes[i] < 16 ? "0" : "") + bytes[i].toString(16);
  return text;
}

function run(rounds) {
  const bytes = writeRecords(400);
  const varints = new Uint8Array([1, 172, 2, 255, 255, 3, 128, 128, 128, 8]);
  let total = 0;
  for (let round = 0; round < rounds; round++) {
    for (const record of parse(bytes)) total += record.kind + record.flags + (record.port & 15) + (record.offset & 7) + record.ratio;
    total += checksum(bytes) & 1023;
    const state = { at: 0 };
    while (state.at < varints.length) total += readVarint(varints, state) & 255;
    total += toHex(bytes.subarray(0, 32)).length + Buffer.from(bytes.subarray(4, 16)).readUInt16LE(2);
  }
  return total;
}

