//// errors-and-cleanup.js
// Errors of an ES5 constructor and of classes that extend Error in two levels, thrown through `finally` and told apart with `instanceof`, beside a TypeError that the engine throws.
function HttpError(status, message) {
  var error = Error.call(this, message);
  this.name = "HttpError";
  this.message = error.message;
  this.status = status;
}
HttpError.prototype = Object.create(Error.prototype);
HttpError.prototype.constructor = HttpError;

class ValidationError extends Error {
  constructor(field, message) {
    super(message);
    this.name = "ValidationError";
    this.field = field;
  }
}

class RangeValidationError extends ValidationError {
  constructor(field, low, high) {
    super(field, field + " must be in " + low + ".." + high);
    this.low = low;
    this.high = high;
  }
}

var opened = 0;
var closed = 0;

function withResource(work) {
  opened++;
  try {
    return work();
  } finally {
    closed++;
  }
}

function check(request) {
  if (request.age < 0 || request.age > 120) throw new RangeValidationError("age", 0, 120);
  if (!request.name) throw new ValidationError("name", "name is required");
  if (request.id === 13) throw new HttpError(404, "no such id");
  if (request.id === 14) return null.missing;
  return request.id + request.age;
}

function handle(request) {
  try {
    return withResource(function () {
      return check(request);
    });
  } catch (error) {
    if (error instanceof RangeValidationError) return error.high - error.low;
    if (error instanceof ValidationError) return error.field.length;
    if (error instanceof HttpError) return error.status;
    if (error instanceof TypeError) return 1;
    throw error;
  }
}

function run(count) {
  var total = 0;
  for (var i = 0; i < count; i++) {
    total += handle({ id: i % 16, age: (i % 140) - 5, name: i % 9 ? "n" : "" });
  }
  return total + opened - closed;
}

console.log(run(400000));
//// es5-inheritance.js
// ES5 inheritance in four ways: a prototype replaced by a literal, Object.create, `new` of the parent and Object.setPrototypeOf, with methods overridden and called through `call`.
function Animal(name, legs) {
  this.name = name;
  this.legs = legs;
  this.steps = 0;
}
Animal.prototype = {
  constructor: Animal,
  walk: function (distance) {
    this.steps += distance * this.legs;
    return this;
  },
  sound: function () {
    return 1;
  },
  score: function () {
    return this.steps + this.sound() + this.name.length;
  },
};

function Dog(name) {
  Animal.call(this, name, 4);
  this.tricks = 0;
}
Dog.prototype = Object.create(Animal.prototype);
Dog.prototype.constructor = Dog;
Dog.prototype.sound = function () {
  return 7 + this.tricks;
};
Dog.prototype.learn = function () {
  this.tricks++;
  return this;
};

function Puppy(name) {
  Dog.call(this, name);
  this.age = 1;
}
Puppy.prototype = new Dog("prototype");
Puppy.prototype.constructor = Puppy;
Puppy.prototype.score = function () {
  return Dog.prototype.score.call(this) - this.age;
};

function Bird(name) {
  Animal.call(this, name, 2);
}
Object.setPrototypeOf(Bird.prototype, Animal.prototype);
Bird.prototype.sound = function () {
  return 3;
};

function make(kind, name) {
  switch (kind) {
    case 0:
      return new Dog(name);
    case 1:
      return new Puppy(name);
    case 2:
      return new Bird(name);
  }
  return new Animal(name, 6);
}

function run(count) {
  var names = ["rex", "dot", "tweety", "ant"];
  var total = 0;
  var dogs = 0;
  for (var i = 0; i < count; i++) {
    var animal = make(i & 3, names[i & 3]);
    animal.walk(i & 7).walk(1);
    if (animal instanceof Dog) {
      animal.learn();
      dogs++;
    }
    total += animal.score();
  }
  return total + dogs;
}

