//// evaluated-text-reads-a-number-that-may-be-undefined-not-three-times-as-slowly-as-a-string.ts
// Text evaluated at run time reads two fields of objects that compiled code made: a string, and a number that may be undefined. A read of the second may cost a few times a read of the first, not three times.
class Row { whole: number; fraction: number; flag: boolean; text: string; list: number[]; any: unknown; inner: { a: number }; maybe: number | undefined;
    constructor(i: number) { this.whole = i | 0; this.fraction = i + 0.5; this.flag = (i & 1) === 0; this.text = "t" + i; this.list = [i]; this.any = i & 1 ? "s" : i; this.inner = { a: i }; this.maybe = i & 1 ? undefined : i; } }
const rows = [new Row(1), new Row(2)];
const loop = (read: string) => new Function("rows", "n", `let t = 0; for (let i = 0; i < n; i++) { const r = rows[i & 1]; ${read} } return t;`);
const none = loop(""), text = loop("if (r.text === undefined) t++;"), maybe = loop("if (r.maybe === undefined) t++;");
function fastestOf(run: Function) { let fastest = Infinity; for (let turn = 0; turn < 5; turn++) { const began = performance.now(); run(rows, 400000); fastest = Math.min(fastest, performance.now() - began); } return fastest; }
const base = fastestOf(none), one = fastestOf(text) - base, other = fastestOf(maybe) - base;
console.log(other < Math.max(one, base / 20) * 3 ? "under three times a read of the string" : "over three times a read of the string");
//// exceptions.js
// Exceptions in a hot loop: an ES5 error type thrown once in 128 turns and caught at the call, behind a `finally` and above five levels of recursion, beside a TypeError that the engine throws.
function ValidationError(field, message) {
  this.name = "ValidationError";
  this.field = field;
  this.message = message;
}
ValidationError.prototype = Object.create(Error.prototype);
ValidationError.prototype.constructor = ValidationError;

function requireNumber(record, field) {
  var value = record[field];
  if (typeof value !== "number") throw new ValidationError(field, field + " must be a number");
  return value;
}

function validate(record) {
  return requireNumber(record, "id") + requireNumber(record, "size");
}

function safely(fn, argument, fallback) {
  try {
    return fn(argument);
  } catch (error) {
    if (error instanceof ValidationError) return fallback + error.field.length;
    throw error;
  }
}

function withCleanup(record, log) {
  log.opened++;
  try {
    if (record.size === 3) return -1;
    return validate(record);
  } finally {
    log.closed++;
  }
}

function deep(level, record) {
  if (level === 0) return validate(record);
  return deep(level - 1, record) + 1;
}

function run(count) {
  var records = [{ id: 1, size: 2 }, { id: 2, size: 3 }, { id: 3, size: 4 }, { id: 4, size: 5 }];
  var broken = { id: 5, size: "large" };
  var log = { opened: 0, closed: 0 };
  var total = 0;
  for (var i = 0; i < count; i++) {
    var record = (i & 127) === 0 ? broken : records[i & 3];
    total += safely(validate, record, 100);
    try {
      total += withCleanup(record, log);
    } catch (error) {
      total += error.message.length;
    }
    try {
      total += deep(4, record);
    } catch (error) {
      total += error.name.length;
    }
    if ((i & 1023) === 0) {
      try {
        null.missing;
      } catch (error) {
        total += error instanceof TypeError ? 7 : 0;
      }
    }
  }
  return total + log.opened - log.closed;
}

