// A new object gets four names by key and loses one of them by key. The deletion may cost a few times one of the stores, not three times.
const names = ["timeout", "error", "close", "end"].map(name => name + String(Date.now()).slice(99));
const listener = () => 1;
function fill() { const o = Object.create(null); for (let k = 0; k < 4; k++) o[names[k]] = listener; return o; }
function filled(n) { let t = 0; for (let i = 0; i < n; i++) t += fill()[names[3]] === listener ? 1 : 0; return t; }
function filledAndDeleted(n) { let t = 0; for (let i = 0; i < n; i++) { const o = fill(); delete o[names[i & 3]]; t += o[names[3]] === listener ? 1 : 0; } return t; }
function fastestOf(run) { let fastest = Infinity; for (let turn = 0; turn < 5; turn++) { const began = performance.now(); run(300000); fastest = Math.min(fastest, performance.now() - began); } return fastest; }
const four = fastestOf(filled), withDeletion = fastestOf(filledAndDeleted);
console.log(withDeletion - four < four / 4 * 3 ? "under three times a store" : "over three times a store");
//// a-new-object-for-every-4096-words-with-256-names-is-not-three-times-as-slow-a-word-as-one-object-for-all.js
// Words are counted by key, 256 different ones. Once into one object for the whole run, once into a new object for every 4,096 words.
const names = []; for (let i = 0; i < 256; i++) names.push("w" + i.toString(36));
const words = []; for (let i = 0; i < 4096; i++) words.push(names[(i * 7 + (i >> 3)) & 255]);
function intoOne(rounds) { const counts = {}; for (let r = 0; r < rounds; r++) for (let i = 0; i < 4096; i++) { const word = words[i]; counts[word] = (counts[word] ?? 0) + 1; } return counts[words[0]]; }
function intoNew(rounds) { let sum = 0; for (let r = 0; r < rounds; r++) { const counts = {}; for (let i = 0; i < 4096; i++) { const word = words[i]; counts[word] = (counts[word] ?? 0) + 1; } sum += counts[words[0]]; } return sum; }
function fastestOf(run) { let fastest = Infinity; for (let turn = 0; turn < 5; turn++) { const began = performance.now(); run(200); fastest = Math.min(fastest, performance.now() - began); } return fastest; }
const one = fastestOf(intoOne), fresh = fastestOf(intoNew);
console.log(intoOne(3) === intoNew(3), fresh < one * 3 ? "under three times" : "over three times");
//// a-node-and-its-twin-among-other-objects-with-the-same-field.js
// A tree of nodes made by a constructor function, each with a twin, walked from a leaf to the root as a UI library marks an update.
// Four other kinds of objects have a field of the same name as the one the walk asks the twin for, and they are made more often.
const word = process.argv[3] ?? "";
const open = new Function("value", "return value" + word.slice(word.length));

function TreeNode(tag) {
  this.tag = tag;
  this.lanes = 0;
  this.childLanes = 0;
  this.twin = null;
  this.parent = null;
  this.state = null;
}

function makeQueue() { return { pending: null, lanes: 0, dispatch: null }; }
function makeDependencies() { return { lanes: 0, first: null }; }
function makeShared() { return { interleaved: null, lanes: 0, callbacks: null, hidden: null }; }
function makeRoad() { return { name: "road", width: 3, length: 12, lanes: 2 }; }

function markFromLeaf(source, lane) {
  source.lanes |= lane;
  var twin = source.twin;
  null !== twin && (twin.lanes |= lane);
  for (var parent = source.parent; null !== parent; )
    (parent.childLanes |= lane),
      (twin = parent.twin),
      null !== twin && (twin.childLanes |= lane),
      (source = parent),
      (parent = parent.parent);
  return 3 === source.tag ? source.state : null;
}

function build(depth) {
  let parent = null, parentTwin = null, leaf = null;
  for (let i = 0; i < depth; i++) {
    const node = new TreeNode(i === 0 ? 3 : 5), twin = new TreeNode(i === 0 ? 3 : 5);
    node.twin = twin; twin.twin = node;
    node.parent = parent; twin.parent = parentTwin;
    if (i === 0) node.state = twin.state = { name: "root" };
    parent = node; parentTwin = twin; leaf = node;
  }
  return leaf;
}

let others = 0;
for (let i = 0; i < 4000; i++) others += makeQueue().lanes + makeDependencies().lanes + makeShared().lanes + makeRoad().lanes;

const rounds = Number(process.argv[2] ?? 200000);
const leaf = open(build(12));
let found = 0;
for (let i = 0; i < rounds; i++) if (markFromLeaf(open(leaf), 1 << (i & 15)) !== null) found++;
console.log(found, others, leaf.lanes, leaf.twin.lanes, leaf.parent.childLanes);
//// a-sum-in-a-field-of-a-literal-that-no-longer-fits-32-bits-is-not-ten-times-as-slow-a-turn.cjs
// An object literal with a field that starts at one and a method that adds to it. One day the sum no longer fits 32 bits. From then on a turn may cost a few times what it cost before, not ten times.
const sum = {
