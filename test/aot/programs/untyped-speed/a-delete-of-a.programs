//// from-a-node-to-the-root-by-a-field-named-return.js
// From a node to the root of its tree by the field `return`, which generators have as a method, and a look at `flags` and `tag` on the way, which regular expressions
// and a dozen other kinds of objects have.
const word = process.argv[3] ?? "";
const open = new Function("value", "return value" + word.slice(word.length));

function TreeNode(tag) {
  this.tag = tag;
  this.flags = 0;
  this.return = null;
  this.state = null;
}

const others = [];
function makeOthers(k) {
  others.push({ tag: k, text: "t" }, { sides: k, tag: k }, { body: "b", sender: "s", tag: k }, { color: k, tag: k }, { tag: k, left: null, right: null });
}
for (let i = 0; i < 64; i++) makeOthers(i);

function rootOf(source) {
  for (var parent = source.return; null !== parent; ) (source = parent), (parent = source.return);
  return 3 === source.tag ? source.state : null;
}

function countMarked(node) {
  var marked = 0;
  for (var parent = node; null !== parent; ) {
    if (0 !== (parent.flags & 4)) marked++;
    else if (10 === parent.tag) break;
    parent = parent.return;
  }
  return marked;
}

function build(depth) {
  let parent = null;
  for (let i = 0; i < depth; i++) {
    const node = new TreeNode(i === 0 ? 3 : 5);
    node.return = parent;
    node.flags = i & 7;
    if (i === 0) node.state = { name: "root" };
    parent = node;
  }
  return parent;
}

const rounds = Number(process.argv[2] ?? 200000);
const leaf = open(build(12));
let found = 0, marked = 0;
for (let i = 0; i < rounds; i++) {
  if (rootOf(open(leaf)) !== null) found++;
  marked += countMarked(open(leaf));
}
console.log(found, marked, others.length);
//// functional.js
// Functional style with arrow functions: compose, pipe, curry with rest and spread arguments, closures that return closures, and a recursive flatten.
const compose = (...fns) => value => fns.reduceRight((result, fn) => fn(result), value);
const pipe = (...fns) => value => fns.reduce((result, fn) => fn(result), value);

const curry = fn => {
  const collect = (...args) => (args.length >= fn.length ? fn(...args) : (...more) => collect(...args, ...more));
  return collect;
};

const add = curry((a, b) => a + b);
const multiply = curry((a, b) => a * b);
const clamp = curry((low, high, value) => Math.min(high, Math.max(low, value)));
const prop = name => object => object[name];
const not = test => value => !test(value);
const isEven = value => value % 2 === 0;
const tap = fn => value => (fn(value), value);

function debounceLike(fn) {
  let calls = 0;
  return (...args) => (++calls % 3 === 0 ? fn(...args) : 0);
}

function zipWith(fn, left, right) {
  const out = [];
  for (let i = 0; i < Math.min(left.length, right.length); i++) out.push(fn(left[i], right[i]));
  return out;
}

const flatten = list => list.reduce((out, item) => (Array.isArray(item) ? out.concat(flatten(item)) : (out.push(item), out)), []);

function run(count) {
  let seen = 0;
  const transform = pipe(add(3), multiply(2), clamp(0, 50), tap(() => seen++));
  const back = compose(add(1), multiply(3));
  const everyThird = debounceLike((a, b) => a + b);
  const size = prop("size");
  const items = [{ size: 1 }, { size: 4 }, { size: 9 }];
  const nested = [1, [2, [3, 4]], [5], 6];
  let total = 0;
  for (let i = 0; i < count; i++) {
    total += transform(i & 31) + back(i & 7) + everyThird(i & 3, 1);
    total += size(items[i % 3]) + (not(isEven)(i) ? 1 : 0);
    if ((i & 7) === 0) total += zipWith((a, b) => a * b, [1, 2, 3], [i & 3, 5, 6]).length + flatten(nested).length;
  }
  return total + seen;
}

