//// interpreter-loop.js
// A stack machine: an assembler that resolves labels, and a `switch` over thirteen opcodes in an endless loop that pushes to arrays and pops from them.
var PUSH = 0, ADD = 1, MUL = 2, SUB = 3, DUP = 4, JNZ = 5, LOAD = 6, STORE = 7, LT = 8, HALT = 9, CALL = 10, RET = 11, SWAP = 12;

function assemble(source) {
  var names = { push: PUSH, add: ADD, mul: MUL, sub: SUB, dup: DUP, jnz: JNZ, load: LOAD, store: STORE, lt: LT, halt: HALT, call: CALL, ret: RET, swap: SWAP };
  var code = [];
  var labels = {};
  var fixups = [];
  source.split("\n").forEach(function (line) {
    line = line.trim();
    if (!line) return;
    if (line[line.length - 1] === ":") {
      labels[line.slice(0, -1)] = code.length;
      return;
    }
    var parts = line.split(" ");
    code.push(names[parts[0]]);
    if (parts.length > 1) {
      if (/^-?\d+$/.test(parts[1])) code.push(parseInt(parts[1], 10));
      else {
        fixups.push({ at: code.length, label: parts[1] });
        code.push(0);
      }
    }
  });
  fixups.forEach(function (fixup) {
    code[fixup.at] = labels[fixup.label];
  });
  return code;
}

function execute(code, input) {
  var stack = [];
  var frames = [];
  var locals = [input, 0, 0, 0];
  var pc = 0;
  var steps = 0;
  for (;;) {
    steps++;
    switch (code[pc++]) {
      case PUSH:
        stack.push(code[pc++]);
        break;
      case ADD: {
        var b = stack.pop();
        stack.push(stack.pop() + b);
        break;
      }
      case MUL: {
        var d = stack.pop();
        stack.push((stack.pop() * d) % 1000003);
        break;
      }
      case SUB: {
        var f = stack.pop();
        stack.push(stack.pop() - f);
        break;
      }
      case DUP:
        stack.push(stack[stack.length - 1]);
        break;
      case SWAP: {
        var top = stack.pop();
        var under = stack.pop();
        stack.push(top);
        stack.push(under);
        break;
      }
      case JNZ: {
        var target = code[pc++];
        if (stack.pop() !== 0) pc = target;
        break;
      }
      case LOAD:
        stack.push(locals[code[pc++]]);
        break;
      case STORE:
        locals[code[pc++]] = stack.pop();
        break;
      case LT: {
        var h = stack.pop();
        stack.push(stack.pop() < h ? 1 : 0);
        break;
      }
      case CALL:
        frames.push(pc + 1);
        pc = code[pc];
        break;
      case RET:
        pc = frames.pop();
        break;
      case HALT:
        return stack.pop() + steps;
      default:
        throw new Error("bad opcode at " + (pc - 1));
    }
  }
}

var program = assemble(
  [
    "push 1",
    "store 1",
    "push 0",
    "store 2",
    "loop:",
    "load 1",
    "call step",
    "store 1",
    "load 2",
    "push 1",
    "add",
    "dup",
    "store 2",
    "load 0",
    "lt",
    "jnz loop",
    "load 1",
    "halt",
    "step:",
    "push 3",
    "mul",
    "load 2",
    "add",
    "ret",
  ].join("\n"),
);

function run(rounds) {
  var total = 0;
  for (var i = 0; i < rounds; i++) total = (total + execute(program, 200 + (i & 63))) % 1000000007;
  return total;
}

console.log(run(4000));
//// iterators-generators.js
// Generators chained into a pipeline, `yield*` over a tree and a class with an iterator of its own, consumed by `for of`, spread, destructuring and entries().
function* range(from, to, step = 1) {
  for (let value = from; value < to; value += step) yield value;
}

function* map(source, fn) {
  for (const value of source) yield fn(value);
}

function* filter(source, test) {
  for (const value of source) if (test(value)) yield value;
}

function* take(source, count) {
  if (count <= 0) return;
  for (const value of source) {
    yield value;
    if (--count === 0) return;
  }
}

class Ring {
  constructor(items) {
    this.items = items;
  }
  [Symbol.iterator]() {
    let at = 0;
    const items = this.items;
    return {
      next() {
        if (at < items.length) return { value: items[at++], done: false };
        return { value: undefined, done: true };
      },
    };
  }
}

function* walk(tree) {
  yield tree.value;
  for (const child of tree.children) yield* walk(child);
}

function sum(source) {
  let total = 0;
  for (const value of source) total += value;
  return total;
}

function run(rounds) {
  const ring = new Ring([1, 2, 3, 4, 5, 6, 7, 8]);
  const tree = { value: 1, children: [{ value: 2, children: [{ value: 3, children: [] }] }, { value: 4, children: [] }] };
  let total = 0;
  for (let i = 0; i < rounds; i++) {
    total += sum(take(filter(map(range(0, 100), x => x * 3), x => x % 2 === 0), 10));
    total += sum(ring) + sum(walk(tree));
    const [first, second] = range(i & 7, 100);
    total += first + second + Math.max(...ring) + [...range(0, 5)].length;
    for (const [index, value] of [10, 20, 30].entries()) total += index * value;
  }
  return total;
}

