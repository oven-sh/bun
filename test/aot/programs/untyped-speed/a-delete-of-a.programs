//// names-first-stored-on-an-instance-that-was-put-below-another-object-are-not-ten-times-as-slow-a-turn.js
// Each turn makes an instance of a class and stores four names on it that its constructor does not store. In the second loop Object.setPrototypeOf() has put the instance below an object created from the class's prototype object first, as a framework does with the requests of a server. That turn may cost a few times the other, not ten times.
class Message {
  constructor(count) {
    this.count = count;
  }
}
const above = Object.create(Message.prototype);
let sums = 0;
globalThis.held = null;
function finish(message, i) {
  message.next = i;
  message.params = i + 1;
  message.route = i + 2;
  message.body = i + 3;
  globalThis.held = message;
  return message.next + message.body;
}
////= fastestOf
const asBorn = fastestOf(5, () => {
  let sum = 0;
  for (let i = 0; i < 1_000_000; i++) sum = (sum + finish(new Message(i), i & 7)) | 0;
  sums = (sums + sum) | 0;
});
const putBelow = fastestOf(5, () => {
  let sum = 0;
  for (let i = 0; i < 1_000_000; i++) sum = (sum + finish(Object.setPrototypeOf(new Message(i), above), i & 7)) | 0;
  sums = (sums + sum) | 0;
});
console.log(sums, Object.keys(globalThis.held).join(), Object.getPrototypeOf(globalThis.held) === above);
console.log(putBelow < asBorn * 10 ? "under ten times the time" : "over ten times the time");
//// options-objects.js
// Options objects completed from defaults in four ways: field by field, with Object.assign, with object spread, and with a `for in` copy of every argument. The options may be undefined.
var defaults = { width: 80, indent: 2, tabs: false, newline: "\n", limit: 1000 };

function withDefaults(options) {
  options = options || {};
  return {
    width: options.width !== undefined ? options.width : defaults.width,
    indent: options.indent || defaults.indent,
    tabs: !!options.tabs,
    newline: options.newline || defaults.newline,
    limit: options.limit == null ? defaults.limit : options.limit,
  };
}

function merged(options) {
  return Object.assign({}, defaults, options);
}

function spreadOver(options) {
  return { ...defaults, ...options, seen: true };
}

function extend(target) {
  for (var i = 1; i < arguments.length; i++) {
    var source = arguments[i];
    for (var key in source) target[key] = source[key];
  }
  return target;
}

function measure(options) {
  return options.width + options.indent * 3 + (options.tabs ? 5 : 0) + options.newline.length + options.limit;
}

function layout(text, options) {
  var settings = withDefaults(options);
  return text.length * settings.indent + measure(settings);
}

function run(count) {
  var given = [undefined, { width: 100 }, { indent: 4, tabs: true }, { newline: "\r\n", limit: 0 }, {}];
  var total = 0;
  for (var i = 0; i < count; i++) {
    var options = given[i % 5];
    total += layout("line", options);
    if ((i & 3) === 0) total += measure(merged(options));
    if ((i & 3) === 1) total += measure(spreadOver(options));
    if ((i & 3) === 2) total += measure(extend({}, defaults, options, { limit: i & 7 }));
  }
  return total;
}

