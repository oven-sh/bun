//// json-walk.js
// A document of 500 items is parsed with JSON.parse again and again, walked recursively by `typeof`, Array.isArray and `for in`, and then read by name.
function makeDocument(count) {
  var items = [];
  for (var i = 0; i < count; i++) {
    items.push({
      id: i,
      name: "item " + i,
      tags: ["a" + (i % 5), "b" + (i % 3)],
      price: i % 4 === 0 ? null : (i * 13) % 97,
      nested: { depth: i % 6, flags: { hot: i % 2 === 0, label: i % 7 === 0 ? "sale" : undefined } },
    });
  }
  return JSON.stringify({ version: 3, items: items, meta: { count: count, source: "generated" } });
}

function walk(value, depth) {
  if (value === null) return 1;
  switch (typeof value) {
    case "number":
      return value & 255;
    case "string":
      return value.length;
    case "boolean":
      return value ? 2 : 3;
  }
  var total = depth;
  if (Array.isArray(value)) {
    for (var i = 0; i < value.length; i++) total += walk(value[i], depth + 1);
    return total;
  }
  for (var key in value) total += key.length + walk(value[key], depth + 1);
  return total;
}

function summarize(document) {
  var total = 0;
  var items = document.items;
  for (var i = 0; i < items.length; i++) {
    var item = items[i];
    total += item.price || 0;
    if (item.nested && item.nested.flags && item.nested.flags.label) total += item.nested.flags.label.length;
    total += item.tags.indexOf("a2") + item.nested.depth;
  }
  return total + document.meta.count;
}

function run(rounds) {
  var text = makeDocument(500);
  var total = 0;
  for (var i = 0; i < rounds; i++) {
    var document = JSON.parse(text);
    total += walk(document, 0) + summarize(document);
    if (i % 10 === 0) total += JSON.stringify(document.items[i % 500]).length;
  }
  return total;
}

console.log(run(250));
//// lists-of-anything-compared-with-object-is.js
// Two lists of whatever a component depends on are compared element by element with Object.is, as a UI library does on every render.
const word = process.argv[3] ?? "";
const open = new Function("value", "return value" + word.slice(word.length));
function is(x, y) {
  return (x === y && (0 !== x || 1 / x === 1 / y)) || (x !== x && y !== y);
}
var objectIs = "function" === typeof Object.is ? Object.is : is;

function areInputsEqual(next, previous) {
  if (null === previous) return !1;
  for (var i = 0; i < previous.length && i < next.length; i++)
    if (!objectIs(next[i], previous[i])) return !1;
  return !0;
}

const shared = { name: "shared" }, callback = () => 1;
const lists = open([
  [shared, callback, "text", 4],
  [shared, callback, "text", 4],
  [callback, shared],
  [callback, shared],
  ["a", "b", "c"],
  ["a", "b", "d"],
  [1, 2, 3],
  [1, 2, 3],
]);
const rounds = Number(process.argv[2] ?? 200000);
let equal = 0;
for (let i = 0; i < rounds; i++) {
  const pair = (i & 3) << 1;
  if (areInputsEqual(lists[pair], lists[pair + 1])) equal++;
}
console.log(equal, areInputsEqual(lists[0], null), areInputsEqual([rounds, 2], [rounds, 2]));
//// matrices-and-vectors.js
// Floating-point arithmetic: matrices of 12 by 12 as arrays of arrays, multiplied and transposed, and short-lived vectors of three components from an ES5 constructor.
function zeros(rows, columns) {
  var matrix = [];
  for (var i = 0; i < rows; i++) {
    var row = [];
    for (var j = 0; j < columns; j++) row.push(0);
    matrix.push(row);
  }
  return matrix;
}

function multiply(a, b) {
  var rows = a.length;
  var inner = b.length;
  var columns = b[0].length;
  var out = zeros(rows, columns);
  for (var i = 0; i < rows; i++) {
    var rowOfA = a[i];
    var rowOfOut = out[i];
    for (var k = 0; k < inner; k++) {
      var factor = rowOfA[k];
      var rowOfB = b[k];
      for (var j = 0; j < columns; j++) rowOfOut[j] += factor * rowOfB[j];
    }
  }
  return out;
}

function transpose(matrix) {
  return matrix[0].map(function (_, column) {
    return matrix.map(function (row) {
      return row[column];
    });
  });
}

function Vector(x, y, z) {
  this.x = x;
  this.y = y;
  this.z = z;
}
Vector.prototype.add = function (other) {
  return new Vector(this.x + other.x, this.y + other.y, this.z + other.z);
};
Vector.prototype.scale = function (factor) {
  return new Vector(this.x * factor, this.y * factor, this.z * factor);
};
Vector.prototype.dot = function (other) {
  return this.x * other.x + this.y * other.y + this.z * other.z;
};
Vector.prototype.cross = function (other) {
  return new Vector(this.y * other.z - this.z * other.y, this.z * other.x - this.x * other.z, this.x * other.y - this.y * other.x);
};
Vector.prototype.length = function () {
  return Math.sqrt(this.dot(this));
};

function trace(matrix) {
  var sum = 0;
  for (var i = 0; i < matrix.length; i++) sum += matrix[i][i];
  return sum;
}

function run(rounds) {
  var size = 12;
  var a = zeros(size, size);
  var b = zeros(size, size);
  for (var i = 0; i < size; i++) {
    for (var j = 0; j < size; j++) {
      a[i][j] = ((i * 7 + j * 3) % 11) / 4;
      b[i][j] = ((i + j * 5) % 13) - 6;
    }
  }
  var total = 0;
  var position = new Vector(0, 0, 0);
  var velocity = new Vector(1, 0.5, -0.25);
  var axis = new Vector(0, 0, 1);
  for (var round = 0; round < rounds; round++) {
    total += trace(multiply(a, transpose(b))) % 97;
    for (var step = 0; step < 200; step++) {
      velocity = velocity.add(velocity.cross(axis).scale(0.01));
      position = position.add(velocity.scale(0.1));
    }
    total += Math.floor(position.length()) % 31;
  }
  return Math.round(total * 100) / 100;
}

