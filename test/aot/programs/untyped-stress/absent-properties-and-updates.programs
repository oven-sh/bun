check(throughLiteral(1.5), "5050 2.5", "a double");
check(throughLiteral("a"), "5050 a1", "a string");
check(throughLiteral({ }), "5050 [object Object]1", "an object");
check(throughLiteral(undefined), "5050 NaN", "undefined");

