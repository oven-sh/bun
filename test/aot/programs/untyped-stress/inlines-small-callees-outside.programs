    }

    function sumOfSeveralArrays(a, b, c, d, e, f, g, h) {
        let s0 = 0, s1 = 0, s2 = 0, s3 = 0, s4 = 0, s5 = 0, s6 = 0, s7 = 0;
        for (let i = 0; i < a.length; ++i) {
