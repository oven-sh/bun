////: checkArray
function checkArray(f, count, round) {
    let values = [];
    for (let i = 0; i < count; ++i)
        values.push(i % 2 ? "e" + round + i : { n: round + i });
    let a = f(...values);
    check(Array.isArray(a), true, f.name + ": is an array");
    check(a.length, count, f.name + ": length");
    for (let i = 0; i < count; ++i)
        check(a[i], values[i], f.name + "[" + i + "]");
    a.length = count + 2;
    for (let i = count; i < count + 2; ++i) {
        check(a[i], undefined, f.name + ": a hole past the elements");
        check(i in a, false, f.name + ": nothing past the elements");
    }
    a.length = count;
    a.push(round);
    check(a[count], round, f.name + ": a pushed element");
    check(a.length, count + 1, f.name + ": length after a push");
}
////: checkObject
function checkObject(f, count, round) {
    let values = [];
    for (let i = 0; i < count; ++i)
        values.push(i % 3 ? "v" + round + i : i % 2 ? round + i + 0.5 : { n: round + i });
    let o = f(...values);
    check(Object.keys(o).join(), names.slice(0, count).join(), f.name + ": names in order");
    for (let i = 0; i < count; ++i)
        check(o[names[i]], values[i], f.name + "." + names[i]);
    check(Object.getPrototypeOf(o), Object.prototype, f.name + ": prototype");
    o.later = round;
    o.evenLater = values[0];
    check(o.later, round, f.name + ": a property added after birth");
    check(o.evenLater, values[0], f.name + ": a second property added after birth");
    check(Object.keys(o).length, count + 2, f.name + ": names after two additions");
    for (let i = 0; i < count; ++i)
        check(o[names[i]], values[i], f.name + "." + names[i] + " after additions");
}
////: deed
function deed() {
  const p = protos[pick(protos.length)], k = pick(NAMES.length), name = NAMES[k];
  switch (pick(17)) {
  case 0: attempt(() => write[k](p, ++serial)); break;
  case 1: attempt(() => Reflect.set(p, name, ++serial)); break;
  case 2: attempt(() => remove[k](p)); break;
  case 3: attempt(() => Reflect.deleteProperty(p, name)); break;
  case 4: { const tag = ++serial; attempt(() => Object.defineProperty(p, name, { get() { return tag; }, set(v) { log += tag; }, configurable: true, enumerable: true })); break; }
  case 5: attempt(() => Object.defineProperty(p, name, { value: ++serial, writable: false, configurable: true, enumerable: true })); break;
  case 6: attempt(() => Object.defineProperty(p, name, { value: ++serial, writable: true, configurable: true, enumerable: pick(2) === 0 })); break;
  case 7: { const q = pick(5) ? protos[pick(protos.length)] : null; if (!q || !chainHas(q, p)) attempt(() => Object.setPrototypeOf(p, q)); break; }
  case 8: { const n = 20 + pick(160); for (let i = 0; i < n; i++) { attempt(() => Reflect.set(p, "passing" + i, i)); if (i) attempt(() => Reflect.deleteProperty(p, "passing" + (i - 1))); } break; }
  case 9: { const at = pick(protos.length); if (pick(3) === 0) attempt(() => [Object.freeze, Object.seal, Object.preventExtensions][pick(3)](protos[at])); protos[at] = freshProto(); if (pick(2)) Object.setPrototypeOf(protos[at], protos[(at + 1 + pick(protos.length - 1)) % protos.length]); break; }
  case 10: for (let i = 0; i < 6; i++) heirs[pick(heirs.length)] = freshHeir(); break;
  case 11: { const o = heirs[pick(heirs.length)]; mix(show(attempt(() => write[k](o, ++serial)))); mix(Object.hasOwn(o, name) ? 1 : 0); break; }
  case 12: { for (let i = 0; i < 8; i++) { const o = freshHeir(); mix(show(attempt(() => write[k](o, i)))); mix(Object.hasOwn(o, name) ? 1 : 0); mix(show(attempt(() => read[k](o)))); } break; }
  case 13: { const o = heirs[pick(heirs.length)]; attempt(() => remove[k](o)); break; }
  case 14: { for (let i = 0; i < 6; i++) { const o = freshHeir(); mix(show(attempt(() => fill(o, i)))); mix(Object.keys(o).length); mix(show(attempt(() => o.b))); } break; }
  case 15: { for (let i = 0; i < 6; i++) { const o = freshHeir(); mix(show(attempt(() => { o[name] = i; }))); mix(Object.hasOwn(o, name) ? 1 : 0); } break; }
  case 16: { for (let i = 0; i < 4; i++) { const C = makers[pick(makers.length)]; C.prototype = protos[pick(protos.length)]; const o = attempt(() => new C(i)); mix(typeof o === "object" ? Object.keys(o).length : -5); } break; }
  }
}
////: for
for (let round = 0; round < rounds; ++round) {
    for (let i = 0; i < objects.length; ++i)
        checkObject(objects[i], i + 1, round);
    for (let i = 0; i < arrays.length; ++i)
        checkArray(arrays[i], i + 1, round);

    let ten = object10(round, "b" + round);
    check(Object.keys(ten).join(""), "pqrstuvwxy", "ten names");
    check(ten.x, round, "the ninth of ten");
    check(ten.y, "b" + round, "the tenth of ten");

    let c = constants();
    check(JSON.stringify(c), '{"p":1,"q":null,"s":true,"t":"text"}', "constants");
    check("r" in c, true, "a field that is undefined is there");

    let n = nested(round);
    check(n.first.n, round, "an object made for a field");
    check(n.second[0], round, "an array made for a field");
    check(n.second[1], "s" + round, "a string made for an element");
    check(n.third, "t" + round, "a string made for a field");
    check(n.fourth.m.k, round, "an object in an object made for a field");

    let numbers = int32Array(round, round * 3);
    check(numbers.join(), round + "," + round * 3 + ",7", "integers");
    numbers[1] = 0.5;
    check(numbers[1], 0.5, "a double stored among integers");
    numbers[0] = "text";
    check(numbers.join(), "text,0.5,7", "a string stored among numbers");

    check(emptyArray().length, 0, "no elements");
    let t = inTry(round, "x");
    check(t.q[0], round, "in a try block");
    check(t.q[1], "x", "in a try block");
}
