//// literals-with-ten-plus-members-stress-2/main.ts
// Object and array literals with up to ten and more members; run with options that stress the garbage collector (variant 2).
// ENV JSC_verifyGC=1
// ENV JSC_scribbleFreeCells=1
// ENV JSC_useZombieMode=1
// ENV JSC_slowPathAllocsBetweenGCs=10
import "./impl.js";
//// loop-reentry-after-slow-iteration/impl.js
////= check

function fromZero(objects) {
    let sum = 0;
    for (let i = 0; i < objects.length; i++)
        sum += objects[i].value;
    return sum;
}
////= lines-11	fromOne(objects	1; i < objects.length; i++
////= lines-11	downFromConstant(objects	99; i >= 0; i--
function whileLoop(objects) {
    let sum = 0, i = 0;
    while (i < objects.length) {
        sum += objects[i].value;
        i++;
    }
    return sum;
}
function doWhileLoop(objects) {
    let sum = 0, i = 0;
    do {
        sum += objects[i].value;
        i++;
    } while (i < objects.length);
    return sum;
}
function twoCounters(objects) {
    let sum = 0, seen = 0;
    for (let i = 0; i < objects.length; i++) {
        sum += objects[i].value;
        seen++;
    }
    return sum + seen;
}
function nested(rows) {
    let sum = 0;
    for (let i = 0; i < rows.length; i++) {
        let row = rows[i];
        for (let j = 0; j < row.length; j++)
            sum += row[j].value;
    }
    return sum;
}
function overHole(numbers) {
    let sum = 0;
    for (let i = 0; i < numbers.length; i++) {
        let number = numbers[i];
        if (number !== undefined)
            sum += number;
    }
    return sum;
}
////= lines-11	fromAnywhere(objects, start	start | 0; i < objects.length; i++
////= lines-11	byTwo(objects	0; i < objects.length; i += 2
function fromFraction(objects, start) {
    let sum = 0;
    for (let i = start; i < 99; i++)
        sum += objects[i + 0.5].value;
    return sum;
}

let objects = [];
for (let i = 0; i < 100; i++)
    objects.push({ value: i });
let numbers = [];
for (let i = 0; i < 100; i++)
    numbers.push(i);
delete numbers[50];
let rows = [];
for (let i = 0; i < 10; i++) {
    rows.push([]);
    for (let j = 0; j < 10; j++)
        rows[i].push({ value: j });
}

check(fromZero(objects), 4950, "a counter from zero");
check(fromOne(objects), 4950, "a counter from one");
check(downFromConstant(objects), 4950, "a counter down from a constant");
check(whileLoop(objects), 4950, "a while loop");
check(doWhileLoop(objects), 4950, "a do-while loop");
check(twoCounters(objects), 5050, "two counters");
check(nested(rows), 450, "one loop in another");
check(overHole(numbers), 4900, "an array with a hole");
check(fromAnywhere(objects, 0), 4950, "a counter from a parameter");
check(byTwo(objects), 2450, "a counter that goes up by two");
check(fromFraction(objects, 0.5), 4950, "a counter that is no integer");

console.log("passed");
