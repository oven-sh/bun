function look(count) {
  for (let i = 0; i < count; i++) {
    const o = heirs[pick(heirs.length)];
    for (let k = 0; k < NAMES.length; k++) { mix(show(attempt(() => read[k](o)))); mix(has[k](o) ? 1 : 0); }
