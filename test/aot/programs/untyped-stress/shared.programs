////: throws
function throws(f, constructor, what) {
    let result;
    try {
        result = f();
    } catch (error) {
        if (!(error instanceof constructor))
            throw new Error(what + ": threw " + String(error));
        return;
    }
    throw new Error(what + ": did not throw, " + String(result).length + " characters");
}
