+bool hasCountsOfARun() { return s_countsOfARun; }
+
+bool countsOfARunCover(const Program& program, ModuleID module)
+{
+    if (!s_countsOfARun->modules || !*s_countsOfARun->modules)
+        return true;
+    auto text = program.string(program.at(module).path);
+    std::string_view path(reinterpret_cast<const char*>(text.data()), text.size());
+    std::string_view wanted(s_countsOfARun->modules);
+    while (!wanted.empty()) {
+        size_t end = wanted.find(',');
+        if (path.find(wanted.substr(0, end)) != std::string_view::npos)
+            return true;
+        wanted = end == std::string_view::npos ? std::string_view() : wanted.substr(end + 1);
+    }
+    return false;
+}
+
+uint64_t countOfARun(FunctionID function, uint32_t ordinal, unsigned side)
+{
+    return s_countsOfARun->counts[s_countsOfARun->first[function.index()] + 2 * ordinal + side];
+}
