export const answer = () => 6 * 7;
//// near/engine-leftovers2/near.ts
import data from "./near-data.json";

const lines: string[] = [];
const say = (name: string, value: unknown) => lines.push(`${name}: ${typeof value === "string" ? value : JSON.stringify(value)}`);

say("a JSON module", data);

function shapes(count: number) {
  const made: Record<string, number>[] = [];
  for (let at = 0; at < count; at++) {
    const object: Record<string, number> = {};
    for (let key = 0; key <= at % 7; key++) object["k" + key] = at + key;
    made.push(object);
  }
  return made.reduce((sum, object) => sum + Object.values(object).reduce((a, b) => a + b, 0), 0);
}
say("objects of seven shapes", shapes(20000));

const callees = [(x: number) => x + 1, (x: number) => x * 2, (x: number) => x - 3, Math.abs, Math.floor, (x: number) => -x];
let total = 0;
for (let round = 0; round < 60000; round++) total = (total + callees[round % callees.length]!(round)) % 1000003;
say("a call site with six callees", total);

class Base {
  constructor(public value: number) {}
  get doubled() {
    return this.value * 2;
  }
  describe() {
    return `${this.constructor.name} ${this.doubled}`;
  }
}
class Derived extends Base {
  override describe() {
    return "derived " + super.describe();
  }
}
say("classes", [new Base(2).describe(), new Derived(3).describe()]);

function thrower(depth: number): number {
  if (depth === 0) throw new RangeError("the bottom");
  try {
    return thrower(depth - 1) + 1;
  } finally {
    total++;
  }
}
let caught = 0;
for (let round = 0; round < 300; round++) {
  try {
    thrower(round % 40);
  } catch (error) {
    if (error instanceof RangeError) caught++;
  }
}
say("thrown and caught", caught);

function deep(n: number): number {
  return n === 0 ? 0 : 1 + deep(n - 1);
}
try {
  deep(1e7);
  say("recursion", "no limit");
} catch (error) {
  say("recursion", (error as Error).name);
}

function* numbers(limit: number) {
  for (let at = 0; at < limit; at++) yield at;
}
say("a generator", [...numbers(5)]);
say("an async function", await (async () => (await Promise.all([1, 2, 3].map(async x => x * x))).join())());
say("the text of a native function", Math.max.toString());
say("bound", ((a: number, b: number) => a + b).bind(null, 2)(3));

const held: object[] = [];
for (let round = 0; round < 6; round++) {
  for (let at = 0; at < 30000; at++) held[at % 5000] = { at, text: "x" + at, list: [at] };
  Bun.gc(true);
}
say("six full collections", held.length);

const other = await import("./near-other.ts");
say("a module imported when asked for", other.answer());
say("a CommonJS module", require("./near-common.cjs").name);

console.log(lines.join("\n"));
//// near/engine-leftovers3/features.json
{"features": ["RuntimeTranspiler", "JIT"]}
//// near/engine-leftovers3/near.ts
const lines: string[] = [];
const say = (name: string, value: unknown) => lines.push(`${name}: ${JSON.stringify(value)}`);

function five(a?: number, b?: number, c?: number, d?: number, e?: number) {
  return [a, b, c, d, e].map(value => (value === undefined ? "-" : String(value))).join("");
}
const loose = five as (...values: number[]) => string;
say("fewer and more arguments than parameters", [loose(), loose(1), loose(1, 2, 3), loose(1, 2, 3, 4, 5, 6, 7), Reflect.apply(five, null, [9]), new (function Made(this: { n: number }, a?: number, b?: number) { this.n = (a ?? 1) + (b ?? 2); } as unknown as new (a?: number) => { n: number })(5).n]);

class Animal {
  legs() {
    return 4;
  }
  get name() {
    return "animal";
  }
}
class Dog extends Animal {}
class Puppy extends Dog {}
const puppies = Array.from({ length: 50 }, () => new Puppy());
let legs = 0;
for (let round = 0; round < 2000; round++) for (const puppy of puppies) legs += puppy.legs() + puppy.name.length;
say("read through two prototypes", legs);
(Dog.prototype as unknown as { legs(): number }).legs = () => 3;
Object.defineProperty(Animal.prototype, "name", { get: () => "beast!" });
legs = 0;
for (let round = 0; round < 2000; round++) for (const puppy of puppies) legs += puppy.legs() + puppy.name.length;
say("after the prototypes changed", legs);
Object.setPrototypeOf(Puppy.prototype, Animal.prototype);
say("after the chain changed", puppies[0]!.legs());

const lists: unknown[][] = [[1, 2, 3], [1.5, 2.5], ["a", 1, null], [], new Array(5), Array.from({ length: 3 })];
let total = 0;
for (let round = 0; round < 3000; round++) {
  const list = lists[round % lists.length]!;
  list.push(round % 3 === 0 ? round : round % 3 === 1 ? round + 0.5 : "s" + round);
  total += list.length;
  if (list.length > 40) list.length = 2;
}
say("arrays that change their kind", total);

function thrower(kind: number): never {
  if (kind === 0) throw new TypeError("zero");
  if (kind === 1) throw "a string";
  throw { kind };
}
const caught: string[] = [];
for (let round = 0; round < 900; round++) {
  try {
    thrower(round % 3);
  } catch (error) {
    if (round < 3) caught.push(typeof error === "string" ? error : error instanceof Error ? error.message : JSON.stringify(error));
  }
}
say("caught", caught);
say("host functions as values", [[3, 1, 2].map(Math.sqrt).map(Math.round), ["b", "a"].sort().map(String), [1, 2].map(Number.isInteger as (value: number) => boolean), [" x "].map(Function.prototype.call, String.prototype.trim)]);

const functions: (() => number)[] = [];
for (let round = 0; round < 8; round++) {
  for (let at = 0; at < 3000; at++) functions[at % 700] = () => at + round;
  Bun.gc(true);
  total += functions[round]!();
  Bun.gc(false);
}
say("sixteen collections with live closures", total);
console.log(lines.join("\n"));
