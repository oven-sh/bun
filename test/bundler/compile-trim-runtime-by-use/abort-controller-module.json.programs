const { promise, resolve } = Promise.withResolvers<number | null>();
const node = spawn("sh", ["-c", "cat; exit 2"], { stdio: ["pipe", "pipe", "inherit"] });
let text = "";
node.stdout.on("data", (chunk: any) => (text += chunk));
node.on("close", (code: number | null) => resolve(code));
node.stdin.end("through node");
console.log(await promise, text);
//// sql.ts
function message(type: string, body: Buffer): Buffer {
  const head = Buffer.alloc(5);
  head.write(type, 0, "latin1");
  head.writeInt32BE(body.length + 4, 1);
  return Buffer.concat([head, body]);
}

function int16(value: number): Buffer {
  const bytes = Buffer.alloc(2);
  bytes.writeInt16BE(value);
  return bytes;
}

function int32(value: number): Buffer {
  const bytes = Buffer.alloc(4);
  bytes.writeInt32BE(value);
  return bytes;
}

const readyForQuery = message("Z", Buffer.from("I"));
const textColumn = (name: string) => Buffer.concat([Buffer.from(name + "\0"), int32(0), int16(0), int32(25), int16(-1), int32(-1), int16(0)]);
const textValue = (value: string) => Buffer.concat([int32(Buffer.byteLength(value)), Buffer.from(value)]);

const server = Bun.listen<{ started: boolean }>({
  hostname: "127.0.0.1",
  port: 0,
  socket: {
    open(socket) {
      socket.data = { started: false };
    },
    data(socket, bytes) {
      if (!socket.data.started) {
        socket.data.started = true;
        socket.write(Buffer.concat([message("R", int32(0)), message("S", Buffer.from("server_version\x0016.0\0")), message("K", Buffer.concat([int32(1), int32(2)])), readyForQuery]));
        return;
      }
      for (let at = 0; at < bytes.length; at += 1 + bytes.readInt32BE(at + 1)) {
        if (String.fromCharCode(bytes[at]!) !== "Q") continue;
        const query = bytes.toString("utf8", at + 5, at + bytes.readInt32BE(at + 1));
        socket.write(
          Buffer.concat([
            message("T", Buffer.concat([int16(2), textColumn("asked"), textColumn("answer")])),
            message("D", Buffer.concat([int16(2), textValue(query), textValue("forty-two")])),
            message("C", Buffer.from("SELECT 1\0")),
            readyForQuery,
          ]),
        );
      }
    },
  },
});

const sql = new Bun.SQL({ adapter: "postgres", hostname: "127.0.0.1", port: server.port, username: "someone", database: "somewhere", tls: false, max: 1 });
console.log(JSON.stringify(await sql`select the answer`.simple()));
await sql.close();
server.stop(true);

const closedPort = Bun.listen({ hostname: "127.0.0.1", port: 0, socket: { data() {} } });
const port = closedPort.port;
closedPort.stop(true);
const mysql = new Bun.SQL({ adapter: "mysql", hostname: "127.0.0.1", port, username: "someone", database: "somewhere", tls: false, max: 1, connectionTimeout: 2 });
console.log(await mysql`select 1`.then(() => "answered", (error: Error & { code?: string }) => `${error.name} ${error.code}`));
await mysql.close();
//// sqlite.ts
import { Database } from "bun:sqlite";
import { DatabaseSync } from "node:sqlite";
import { mkdtempSync, rmSync, statSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

const memory = new Database(":memory:");
memory.run("create table numbers (n integer, word text)");
const insert = memory.prepare("insert into numbers values (?, ?)");
memory.transaction(() => {
  for (let n = 1; n <= 100; n++) insert.run(n, "w" + n);
})();
console.log("bun:sqlite", memory.query("select sum(n) as total, count(*) as rows, max(word) as last from numbers").get());
console.log("bun:sqlite json", memory.query(`select json_extract('{"a":[1,2,3]}', '$.a[1]') as second`).get());
memory.close();

const sync = new DatabaseSync(":memory:");
sync.exec("create table t (k text primary key, v real)");
sync.prepare("insert into t values (?, ?)").run("pi", 3.25);
sync.function("twice", (value: any) => value * 2);
console.log("node:sqlite", sync.prepare("select k, twice(v) as doubled from t").all());
sync.close();

const sql = new Bun.SQL("sqlite://:memory:");
await sql`create table people (name text)`;
await sql`insert into people values (${"ada"}), (${"grace"})`;
console.log("Bun.SQL", await sql`select name from people order by name desc`);
await sql.close();

const folder = mkdtempSync(join(tmpdir(), "trim-sqlite-"));
const file = new Database(join(folder, "left-open.db"));
file.run("pragma journal_mode = wal");
file.run("create table kept (n integer)");
file.run("insert into kept values (7)");
process.on("exit", () => {
  console.log("left open at exit", statSync(join(folder, "left-open.db")).size > 0);
  if (process.platform !== "win32") rmSync(folder, { recursive: true, force: true });
});
