  await new Promise<string>((resolve, reject) => {
    http
      .get(`${origin}/from-node`, response => {
        let text = "";
        response.setEncoding("utf8").on("data", piece => (text += piece)).on("end", () => resolve(`${response.statusCode} ${JSON.parse(text).path}`));
      })
      .on("error", reject);
  }),
);
