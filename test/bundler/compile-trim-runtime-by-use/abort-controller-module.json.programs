// node:fs: sync, callback and promise forms, a directory handle, cp, streams
import fs from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
const dir = fs.mkdtempSync(join(tmpdir(), "node-fs-"));
fs.mkdirSync(join(dir, "a", "b"), { recursive: true });
fs.writeFileSync(join(dir, "a", "one.txt"), "one");
fs.appendFileSync(join(dir, "a", "one.txt"), "+two");
console.log(fs.readFileSync(join(dir, "a", "one.txt"), "utf8"), fs.statSync(join(dir, "a", "one.txt")).size, fs.existsSync(join(dir, "nothing")));
console.log(fs.readdirSync(dir, { recursive: true }).sort().join(" "), fs.readdirSync(join(dir, "a"), { withFileTypes: true }).map((entry: any) => `${entry.name}:${entry.isDirectory()}`).sort().join(" "));
fs.cpSync(join(dir, "a"), join(dir, "copy"), { recursive: true });
await fs.promises.cp(join(dir, "a"), join(dir, "copy2"), { recursive: true });
console.log(await fs.promises.readFile(join(dir, "copy", "one.txt"), "utf8"), (await fs.promises.readdir(join(dir, "copy2"))).sort().join(" "));
const handle = fs.opendirSync(dir);
const names: string[] = [];
for (let entry; (entry = handle.readSync()); ) names.push(entry.name);
handle.closeSync();
console.log(names.sort().join(" "));
try { fs.readFileSync(join(dir, "nothing")); } catch (error) { console.log((error as any).code, (error as any).syscall); }
const piped = Promise.withResolvers<void>();
fs.createReadStream(join(dir, "a", "one.txt")).pipe(fs.createWriteStream(join(dir, "piped.txt"))).on("finish", () => piped.resolve());
await piped.promise;
fs.readFile(join(dir, "piped.txt"), "utf8", (_error: any, text: string) => {
  console.log(text);
  fs.rmSync(dir, { recursive: true, force: true });
  console.log(fs.existsSync(dir));
});
//// node-http.ts
// node:http on 127.0.0.1: a server and a client in one process
import http from "node:http";
const server = http.createServer((request: any, response: any) => {
  let body = "";
  request.on("data", (chunk: any) => (body += chunk));
  request.on("end", () => {
    response.writeHead(request.url === "/missing" ? 404 : 200, { "content-type": "text/plain", "x-method": request.method });
    response.write(`${request.url} `);
    response.end(body || "empty");
  });
});
const ask = (path: string, method: string, body?: string) =>
  new Promise<string>(resolve => {
    const request = http.request({ host: "127.0.0.1", port: (server.address() as { port: number }).port, path, method }, (response: any) => {
      let text = "";
      response.on("data", (chunk: any) => (text += chunk));
      response.on("end", () => resolve(`${response.statusCode} ${response.headers["x-method"]} ${text}`));
    });
    request.end(body);
  });
server.listen(0, "127.0.0.1", async () => {
  console.log(await ask("/a", "GET"));
  console.log(await ask("/b?c=1", "POST", "posted"));
  console.log(await ask("/missing", "DELETE"));
  server.close(() => console.log("closed"));
});
