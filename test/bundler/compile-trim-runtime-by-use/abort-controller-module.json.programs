class Money {
  constructor(public cents: number) {}
  toText(digits: number) {
    const whole = Math.trunc(this.cents / 100);
    return whole + "." + String(this.cents % 100 + 100).slice(1, 1 + digits);
  }
}
say("a class of one's own", new Money(123456).toText(2));
