const stream = new ReadableStream({ start(controller) { controller.enqueue("a"); controller.enqueue("b"); controller.close(); } });
const [left, right] = stream.tee();
const upper = left.pipeThrough(new TransformStream({ transform(chunk, controller) { controller.enqueue(String(chunk).toUpperCase()); } }));
const seen: string[] = [];
await upper.pipeTo(new WritableStream({ write(chunk) { seen.push(chunk); } }));
console.log(seen.join(""), await Bun.readableStreamToText(right));
