////: listener
const listener = Bun.listen({
  hostname: "127.0.0.1",
  port: 0,
  tls: { key, cert },
  socket: {
    data(socket, bytes) {
      socket.write(`echoed ${bytes}`);
    },
  },
});
////: server
const server = Bun.serve({
  hostname: "127.0.0.1",
  port: 0,
  tls: { key, cert },
  fetch(request, server) {
    if (server.upgrade(request)) return;
    return new Response(`served over ${new URL(request.url).protocol}`);
  },
  websocket: {
    message(socket, message) {
      socket.send(`echoed ${message}`);
    },
  },
});
////: socket
const socket = await Bun.connect({
  hostname: "127.0.0.1",
  port: listener.port,
  tls: { ca: cert },
  socket: {
    handshake(socket, authorized) {
      socket.write(`authorized ${authorized}`);
    },
    data(_socket, bytes) {
      answered.resolve(bytes.toString());
    },
  },
});
////: total
function total(values: «1» | «2»[]) {
  let sum = 0;
  for (const value of values) sum += Number(value);
  return sum;
}
