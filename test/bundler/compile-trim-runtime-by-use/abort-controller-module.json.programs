const plain = new Event("x", { bubbles: true }); plain.preventDefault(); plain.stopPropagation();
console.log(seen.join(), message.data.a, message.origin, error.message, error.lineno, close.code, close.reason, close.wasClean, plain.bubbles, plain.defaultPrevented, plain instanceof Event, typeof plain.timeStamp);
