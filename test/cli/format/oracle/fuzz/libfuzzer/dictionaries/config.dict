"\"overrides\":[{\"files\":[\"**/*.jsx\"],\"plugins\":[\"react\"],\"rules\":{"
"\"no-restricted-syntax/a\":[\"error\",\"Identifier[name='a']\"]"
"\"no-restricted-syntax/b\":[\"warn\",{\"selector\":\":function > BlockStatement\",\"message\":\"c\"}]"
"\"no-restricted-syntax/a\":\"off\""
