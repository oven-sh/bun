function a() {
  return Promise.all(
    entries.map((entry) =>
      registry[CONTEXT_KEY]
        .runInContext(() => prepare(entry, registry))
        .then(() => entry.commit(target)),
    ),
  );
}
registry[contextKey]
  .runInContext(() => prepare(entry, registry))
  .then(() => entry.commit(target, more));
registry.CONTEXT_KEY.runInContext(() => prepare(entry, registry)).then(() =>
  entry.commit(target, more),
);

