x = a ? b : c /* 1 */;
x = a
  ? b
  : c; // 2
f(a ? b : c /* 3 */);
f(
  a
    ? b
    : c, // 4
);
x = a ? b : (c, d) /* 5 */;
const y = a ? b : c /* 6 */;
x = a ? b /* 7 */ : c;
x = a
  ? b
  : c
    ? d
    : e; // 8
x = a
  ? b
  : (c, d);
    // 9

