export function alias<TTable extends SingleStoreTable, TAlias extends string>( // | SingleStoreViewBase
  table: TTable,
  alias: TAlias,
): X {
  return 1;
}
export function alia2(table: TTable): X { // c
  return 1;
}
class A {
  from<TFrom extends SingleStoreTable | Subquery | SQL>(source: TFrom): X {} // | SingleStoreViewBase
  fro2(
    // c
    source: TFrom,
  ): X {}
}
interface I {
  <Base, D = Draft<Base>>( // By using a default inferred D
    base: Base,
  ): Base;
  (
    // c
    base: Base,
  ): Base;
}
renderer.events["_onPointerMove"](
  // <-- v8 equivalent?
  new PointerEvent("pointermove", { clientX: 25, clientY: 25 }),
);
renderer.events.onPointerMove(
  // <-- v8 equivalent?
  new PointerEvent("pointermove", { clientX: 25, clientY: 25 }),
);

