------------------
{ printWidth: 80 }
------------------
a {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  font-family:
    ui-sans-serif,
    -apple-system,
    sans-serif;
  font-family: -apple-system, ui-sans-serif, sans-serif;
  mask-position-x:
    50px,
    25%,
    -3em;
  mask-position-x:
    50px,
    25%,
    +3em;
  transition:
    opacity 1s,
    color 2s;
  margin: 1px -2px;
}

