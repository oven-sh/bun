type A<T> =
  | string
  | (T extends (
      {
        all: false;
      }
    ) ?
      never
    : T extends (

        | {
            all: true;
          }
        | {
            all: boolean;
          }
    ) ?
      (string | File)[]
    : never);
type B<T> =
  T extends (

      | { all: true }
      | {
          all: boolean;
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa: 1;
        }
  ) ?
    1
  : 2;

