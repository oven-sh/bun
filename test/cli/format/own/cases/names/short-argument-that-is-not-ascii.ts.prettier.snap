function f() {
  it("a", async () => {
    const editor =
      await screen.findByLabelText("描述需要修改的内容或你注意到的问题…");
    const edito2 = await screen.findByLabelText(
      "描述需要修改的内容或你注意到的问题……",
    );
    const edito3 =
      await screen.findByLabelText(描述需要修改的内容或你注意到的问题描述);
  });
}

