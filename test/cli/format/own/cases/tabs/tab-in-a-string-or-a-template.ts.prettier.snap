	it("b", () => {
		expect(withoutLeadingSlashes("/	/	/some/longer/path")).toMatchSnapshot(
			`"/x"`,
		);
		expect(withoutLeadingSlashes("/ / /some/longer/path")).toMatchSnapshot(
			`"/x"`,
		);
	});
});
