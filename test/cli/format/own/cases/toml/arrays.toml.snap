---------------------------------
{ printWidth: 40, useTabs: true }
---------------------------------
empty = []
one-line = [1, 2, 3]
trailing = [1, 2, 3]
collapses = [1, 2, 3]
nested = [[1, 2], [3, [4]], []]
strings = ["a", 'b', """c""", '''d''']
too-long = [
	"aaaaaaaaaaaaaaaaaaaaaaaa",
	"bbbbbbbbbbbbbbbbbbbbbbbb",
	"cccccccccccccccccccccccc",
	"dddddddddddddddddddd",
]
too-long-nested = [
	[
		"aaaaaaaaaaaaaaaaaaaaaaaa",
		"bbbbbbbbbbbbbbbbbbbbbbbb",
	],
	[
		"cccccccccccccccccccccccc",
		"dddddddddddddddddddd",
	],
]
too-long-with-the-comment = [
	"aaaaaaaaaaaaaaaaaaaaaaaa",
	"bbbbbbbbbbbbbbbbbbbbbbbb",
] # cccccccccccccccccccccccccccccccccccccccc
comments = [ # behind the bracket
	1, # behind the comma
	2, # behind the value
	3,
	# on a line of its own


	# after two empty lines
	4, # behind a comma on a line of its own
	5,
] # behind the array
comment-only = [
	# nothing else
]
tables = [
	{ a = 1 },
	{ b = 2, c = [
		1,
		2,
	] },
]
tables-too-long = [
	{ name = "aaaaaaaaaaaaaaaaaaaaaaaa", value = "bbbbbbbbbbbbbbbbbbbbbbbb" },
	{ name = "cccccccccccccccccccccccc", value = [
		"d",
		"e",
	] },
]

