# MinIO distributes the community edition as source only. It has removed its
# images from Docker Hub and quay.io, and its binaries from dl.min.io. Alpine
# 3.23 packages the last release, RELEASE.2025-10-15T17-29-55Z, for x86_64 and
# aarch64.
#
# The base image is pinned by digest. A tag that moves misses the build cache,
# and then every test machine installs the package before it starts the service.
FROM alpine:3.23.6@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
RUN apk add --no-cache minio

# A directory in the root of the drive is a bucket. /data is a tmpfs
# (docker-compose.yml), so the bucket the tests use is made at every start.
CMD ["sh", "-c", "mkdir -p /data/buntest && exec minio server /data --console-address :9001"]
