name [name='generator', template="\ndef g(a):\n    n = 0\n    for i in range(2):\n{body8}        got = yield n\n        if got or a:\n{body12}            n = -n\n    return n\ndef h(a):\n    n = yield from g(a)\n{body4}    return n\ndef f(a):\n    it = h(a)\n    out = []\n    try:\n        out.append(next(it))\n        out.append(it.send(a))\n        out.append(next(it))\n    except StopIteration as e:\n        out.append(('returned', e.value))\n    return out\n", size=1] => generator
