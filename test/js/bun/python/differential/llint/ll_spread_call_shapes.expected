--- what is raised on the way, and what is still done then
fvk(*halfway(1, 2)) | LookupError: the iterable | ['item 1', 'item 2', 'the iterable']
fvk(note('x'), *halfway(1)) | LookupError: the iterable | ['x', 'item 1', 'the iterable']
fvk(*halfway(1), **note('k', {})) | LookupError: the iterable | ['k', 'item 1', 'the iterable']
fvk(*halfway(1), **Mapping('a')) | LookupError: the iterable | ['keys', "item of 'a'", 'item 1', 'the iterable']
fvk(note('x'), *halfway(1), **note('k', Mapping('a'))) | LookupError: the iterable | ['x', 'item 1', 'the iterable']
fvk(*note('p', (1,)), **Mapping('a', 'b', fails_at='b')) | LookupError: the mapping | ['p', 'keys', "item of 'a'", "item of 'b'"]
fvk(*halfway(1), **Mapping('a', fails_at='a')) | LookupError: the mapping | ['keys', "item of 'a'"]
fvk(note('x'), *halfway(1), **Mapping('a', fails_at='a')) | LookupError: the iterable | ['x', 'item 1', 'the iterable']
fvk(*halfway(1), **{1: 2}) | LookupError: the iterable | ['item 1', 'the iterable']
fvk(*note('p', ()), **{1: 2}) | TypeError: keywords must be strings | ['p']
fvk(*iter((1,)), **{1: 2}) | TypeError: keywords must be strings | []
fvk(*iter((1,)), **Mapping(1)) | TypeError: keywords must be strings | ['keys', 'item of 1']
fvk(**Mapping('a', 'a')) | TypeError: __main__.fvk() got multiple values for keyword argument 'a' | ['keys', "item of 'a'"]
fvk(a=1, **Mapping('a')) | TypeError: __main__.fvk() got multiple values for keyword argument 'a' | ['keys']
fvk(**{'a': 1}, **Mapping('a')) | TypeError: __main__.fvk() got multiple values for keyword argument 'a' | ['keys']
fvk(**Mapping('a'), **Mapping('b', 'a')) | TypeError: __main__.fvk() got multiple values for keyword argument 'a' | ['keys', "item of 'a'", 'keys', "item of 'b'"]
f3(*(1,), **Mapping('a')) | TypeError: f3() got multiple values for argument 'a' | ['keys', "item of 'a'"]
f3(1, *iter(()), **Mapping('a')) | TypeError: f3() got multiple values for argument 'a' | ['keys', "item of 'a'"]
f3(*halfway(), **Mapping('a')) | LookupError: the iterable | ['keys', "item of 'a'", 'the iterable']
fvk(*halfway(1), x=note('x')) | LookupError: the iterable | ['x', 'item 1', 'the iterable']
