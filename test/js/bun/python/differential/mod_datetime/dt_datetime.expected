x.time(1) !! TypeError datetime.time() takes no arguments (1 given)
x.timetz(1) !! TypeError datetime.timetz() takes no arguments (1 given)
x.toordinal(), x.weekday(), x.isoweekday(), x.isocalendar() => (738945, 3, 4, datetime.IsoCalendarDate(year=2024, week=9, weekday=4))
x.utcoffset(), x.dst(), x.tzname() => (datetime.timedelta(0), None, 'UTC')
n.utcoffset(), n.dst(), n.tzname() => (None, None, None)
x.utcoffset(1) !! TypeError datetime.utcoffset() takes no arguments (1 given)
datetime.utcoffset(1) !! TypeError descriptor 'utcoffset' for 'datetime.datetime' objects doesn't apply to a 'int' object
