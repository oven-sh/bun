---
--- constructor
datetime(2000, 1, 1) => datetime.datetime(2000, 1, 1, 0, 0)
datetime(2000, 1, 2, 3) => datetime.datetime(2000, 1, 2, 3, 0)
datetime(2000, 1, 2, 3, 4) => datetime.datetime(2000, 1, 2, 3, 4)
datetime(2000, 1, 2, 3, 4, 5) => datetime.datetime(2000, 1, 2, 3, 4, 5)
datetime(2000, 1, 2, 3, 4, 5, 6) => datetime.datetime(2000, 1, 2, 3, 4, 5, 6)
datetime(2000, 1, 2, 3, 4, 5, 6, None) => datetime.datetime(2000, 1, 2, 3, 4, 5, 6)
datetime(2000, 1, 2, 3, 4, 5, 6, utc) => datetime.datetime(2000, 1, 2, 3, 4, 5, 6, tzinfo=datetime.timezone.utc)
datetime(2000, 1, 2, 3, 4, 5, 6, utc, fold=1) => datetime.datetime(2000, 1, 2, 3, 4, 5, 6, fold=1, tzinfo=datetime.timezone.utc)
datetime(2000, 1, 2, fold=1) => datetime.datetime(2000, 1, 2, 0, 0, fold=1)
datetime(year=2000, month=1, day=2, hour=3, minute=4, second=5, microsecond=6, tzinfo=utc, fold=1) => datetime.datetime(2000, 1, 2, 3, 4, 5, 6, fold=1, tzinfo=datetime.timezone.utc)
datetime(2000, 1, 2, tzinfo=utc) => datetime.datetime(2000, 1, 2, 0, 0, tzinfo=datetime.timezone.utc)
datetime(2000, 1, 2, microsecond=6) => datetime.datetime(2000, 1, 2, 0, 0, 0, 6)
datetime(1, 1, 1), datetime(9999, 12, 31, 23, 59, 59, 999999) => (datetime.datetime(1, 1, 1, 0, 0), datetime.datetime(9999, 12, 31, 23, 59, 59, 999999))
datetime(0, 1, 1) !! ValueError year must be in 1..9999, not 0
datetime(10000, 1, 1) !! ValueError year must be in 1..9999, not 10000
datetime(2000, 0, 1) !! ValueError month must be in 1..12, not 0
datetime(2000, 13, 1) !! ValueError month must be in 1..12, not 13
datetime(2000, 1, 0) !! ValueError day 0 must be in range 1..31 for month 1 in year 2000
datetime(2000, 2, 30) !! ValueError day 30 must be in range 1..29 for month 2 in year 2000
datetime(2001, 2, 29) !! ValueError day 29 must be in range 1..28 for month 2 in year 2001
datetime(2000, 1, 1, 24) !! ValueError hour must be in 0..23, not 24
datetime(2000, 1, 1, -1) !! ValueError hour must be in 0..23, not -1
datetime(2000, 1, 1, 0, 60) !! ValueError minute must be in 0..59, not 60
datetime(2000, 1, 1, 0, 0, 60) !! ValueError second must be in 0..59, not 60
datetime(2000, 1, 1, 0, 0, 0, 1000000) !! ValueError microsecond must be in 0..999999, not 1000000
datetime(2000, 1, 1, 0, 0, 0, -1) !! ValueError microsecond must be in 0..999999, not -1
datetime(2000, 1, 1, fold=2) !! ValueError fold must be either 0 or 1, not 2
datetime(2000, 1, 1, fold=-1) !! ValueError fold must be either 0 or 1, not -1
datetime(2000, 13, 32, 25, 61, 61, -1, 5, fold=3) !! ValueError month must be in 1..12, not 13
datetime(2000, 1, 1, 25, 61, 61, -1, 5, fold=3) !! ValueError hour must be in 0..23, not 25
datetime(2000, 1, 1, 0, 0, 0, 0, 5, fold=3) !! ValueError fold must be either 0 or 1, not 3
datetime(2000, 1, 1, 0, 0, 0, 0, 5) !! TypeError tzinfo argument must be None or of a tzinfo subclass, not type 'int'
datetime(2000, 1, 1, tzinfo='x') !! TypeError tzinfo argument must be None or of a tzinfo subclass, not type 'str'
datetime(2000, 1, 1, tzinfo=tzinfo) !! TypeError tzinfo argument must be None or of a tzinfo subclass, not type 'type'
datetime(2**31, 1, 1) !! OverflowError Python int too large to convert to C int
datetime(2000, 1, 1, 2**31) !! OverflowError Python int too large to convert to C int
datetime(2000, 1, 1, 0, 0, 0, 2**64) !! OverflowError Python int too large to convert to C int
datetime(2000.0, 1, 1) !! TypeError 'float' object cannot be interpreted as an integer
datetime(2000, 1, 1, 1.0) !! TypeError 'float' object cannot be interpreted as an integer
datetime('2000', 1, 1) !! TypeError 'str' object cannot be interpreted as an integer
datetime(None, 1, 1) !! TypeError 'NoneType' object cannot be interpreted as an integer
datetime(2000, 1, 1, None) !! TypeError 'NoneType' object cannot be interpreted as an integer
datetime(True, True, True, True, True, True, True) => datetime.datetime(1, 1, 1, 1, 1, 1, 1)
datetime(Idx(2000), Idx(1), Idx(2), Idx(3), Idx(4), Idx(5), Idx(6)) => datetime.datetime(2000, 1, 2, 3, 4, 5, 6)
datetime() !! TypeError datetime() missing required argument 'year' (pos 1)
datetime(2000) !! TypeError datetime() missing required argument 'month' (pos 2)
datetime(2000, 1) !! TypeError datetime() missing required argument 'day' (pos 3)
datetime(2000, 1, 1, 0, 0, 0, 0, None, 0) !! TypeError datetime() takes at most 8 positional arguments (9 given)
datetime(2000, 1, 1, 0, 0, 0, 0, None, 0, 0) !! TypeError datetime() takes at most 9 arguments (10 given)
datetime(2000, 1, 1, foo=1) !! TypeError datetime() got an unexpected keyword argument 'foo'
datetime(2000, 1, 1, hours=1) !! TypeError datetime() got an unexpected keyword argument 'hours'. Did you mean 'hour'?
datetime(2000, 1, 1, year=2000) !! TypeError argument for datetime() given by name ('year') and position (1)
datetime(2000, 1, day=1, hour=1) => datetime.datetime(2000, 1, 1, 1, 0)
datetime(month=1, day=1) !! TypeError datetime() missing required argument 'year' (pos 1)
datetime.min, datetime.max, datetime.resolution => (datetime.datetime(1, 1, 1, 0, 0), datetime.datetime(9999, 12, 31, 23, 59, 59, 999999), datetime.timedelta(microseconds=1))
type(datetime.min), type(datetime.resolution) => (<class 'datetime.datetime'>, <class 'datetime.timedelta'>)
