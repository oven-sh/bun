x.year, x.month, x.day, x.hour, x.minute, x.second, x.microsecond, x.tzinfo, x.fold => (2024, 2, 29, 1, 2, 3, 4, datetime.timezone.utc, 1)
n.year, n.month, n.day, n.hour, n.minute, n.second, n.microsecond, n.tzinfo, n.fold => (2024, 2, 29, 12, 34, 56, 789012, None, 0)
type(datetime.hour).__name__, type(datetime.year).__name__, datetime.year is date.year => ('getset_descriptor', 'getset_descriptor', True)
