setattr(x, 'year', 1) !! AttributeError attribute 'year' of 'datetime.date' objects is not writable
setattr(x, 'foo', 1) !! AttributeError 'datetime.datetime' object has no attribute 'foo' and no __dict__ for setting new attributes
x.__dict__ !! AttributeError 'datetime.datetime' object has no attribute '__dict__'
bool(x), bool(datetime.min) => (True, True)
x.date(), x.time(), x.timetz() => (datetime.date(2024, 2, 29), datetime.time(1, 2, 3, 4, fold=1), datetime.time(1, 2, 3, 4, tzinfo=datetime.timezone.utc, fold=1))
n.date(), n.time(), n.timetz() => (datetime.date(2024, 2, 29), datetime.time(12, 34, 56, 789012), datetime.time(12, 34, 56, 789012))
type(x.date()), type(x.time()), type(x.timetz()) => (<class 'datetime.date'>, <class 'datetime.time'>, <class 'datetime.time'>)
x.time().fold, x.timetz().fold, x.timetz().tzinfo => (1, 1, datetime.timezone.utc)
