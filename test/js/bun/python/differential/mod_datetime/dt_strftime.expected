--- odd formats
d.strftime('') => ''
d.strftime('%') => '%'
d.strftime('%%') => '%'
d.strftime('abc%') => 'abc%'
d.strftime('%Q') => '%Q'
d.strftime('%1') => '%1'
d.strftime('% ') => '% '
d.strftime('%é') => '%é'
d.strftime('é%Y€%m\U0001f600%d') => 'é2024€02😀29'
d.strftime('%Z') => 'é€😀'
d.strftime('[%Z][%z][%:z][%f]') => '[é€😀][+0130][+01:30][000006]'
d.strftime('\ud800') => '\ud800'
d.strftime('%Y\ud800%m') => '2024\ud80002'
d.strftime('\0') => '\x00'
d.strftime('%Y\0%m\0') => '2024\x0002\x00'
d.strftime('%z' * 5) => '+0130+0130+0130+0130+0130'
d.strftime('%f' * 5) => '000006000006000006000006000006'
d.strftime('x' * 1000)[:10] => 'xxxxxxxxxx'
len(d.strftime('%Y' * 1000)) => 4000
d.strftime('%:') => '%:'
d.strftime('%:%z') => '%:+0130'
d.strftime('%:Z') => '%:Z'
d.strftime('%::z') => '%::z'
d.strftime('%:zz') => '+01:30z'
d.strftime('%%z%%Z%%f%%:z') => '%z%Z%f%:z'
d.strftime('%%%z') => '%+0130'
d.strftime(1) !! TypeError strftime() argument 'format' must be str, not int
d.strftime() !! TypeError strftime() missing required argument 'format' (pos 1)
d.strftime('%Y', '%m') !! TypeError strftime() takes at most 1 argument (2 given)
d.strftime(format='%Y') => '2024'
date(2024, 2, 29).strftime('%H:%M:%S.%f|%z|%Z|%:z') => '00:00:00.000000|||'
date(2024, 2, 29).strftime(format='%d') => '29'
date(2024, 2, 29).strftime(1) !! TypeError strftime() argument 'format' must be str, not int
date(2024, 2, 29).strftime() !! TypeError strftime() missing required argument 'format' (pos 1)
date.strftime(1, '%Y') !! TypeError descriptor 'strftime' for 'datetime.date' objects doesn't apply to a 'int' object
datetime.strftime is date.strftime => True
datetime.strftime(d, '%d') => '29'
date.strftime(d, '%H %f %z') => '13 000006 +0130'
format(d, '%d/%m'), f'{d:%H:%M}', f'{d:}', format(d, '') => ('29/02', '13:04', '2024-02-29 13:04:05.000006+01:30', '2024-02-29 13:04:05.000006+01:30')
format(date(2024, 2, 29), '%d/%m'), f'{date(2024, 2, 29):%j}' => ('29/02', '060')
d.__format__('%Y'), date.__format__(d, '%H') => ('2024', '13')
d.__format__(1) !! TypeError __format__() argument must be str, not int
d.__format__() !! TypeError date.__format__() takes exactly one argument (0 given)
d.strftime(S('%Y')) => '2024'
format(d, S('%Y')) => '2024'
format(OwnStrftime(2020, 1, 1), 'x') => 'own x'
format(OwnStrftime(2020, 1, 1), '') => 'own str'
f'{OwnStrftime(2020, 1, 1)}' => 'own str'
OwnTimetuple(2020, 1, 1).strftime('%Y') => '1999'
BadTimetuple(2020, 1, 1).strftime('%Y') !! TypeError 'int' object does not support indexing
BadTimetuple(20, 1, 1).strftime('%Y') !! TypeError 'int' object does not support indexing
datetime(2020, 1, 1, tzinfo=NameSub(Str2('x'))).strftime('%Z') !! NotImplementedError a tzinfo subclass must implement dst()
datetime(2020, 1, 1, tzinfo=NameSub(5)).strftime('%Z') !! NotImplementedError a tzinfo subclass must implement dst()
datetime(2020, 1, 1, tzinfo=NameSub('%Y%%')).strftime('[%Z]') !! NotImplementedError a tzinfo subclass must implement dst()
--- strptime
datetime.strptime('2020-01-02', '%Y-%m-%d') => datetime.datetime(2020, 1, 2, 0, 0)
datetime.strptime('2020-01-02 03:04:05', '%Y-%m-%d %H:%M:%S') => datetime.datetime(2020, 1, 2, 3, 4, 5)
datetime.strptime('2020-01-02 03:04:05.6', '%Y-%m-%d %H:%M:%S.%f') => datetime.datetime(2020, 1, 2, 3, 4, 5, 600000)
datetime.strptime('2020-01-02 03:04:05.678901', '%Y-%m-%d %H:%M:%S.%f') => datetime.datetime(2020, 1, 2, 3, 4, 5, 678901)
datetime.strptime('2020-01-02 +0100', '%Y-%m-%d %z') => datetime.datetime(2020, 1, 2, 0, 0, tzinfo=datetime.timezone(datetime.timedelta(seconds=3600)))
datetime.strptime('2020-01-02 -01:30', '%Y-%m-%d %z') => datetime.datetime(2020, 1, 2, 0, 0, tzinfo=datetime.timezone(datetime.timedelta(days=-1, seconds=81000)))
datetime.strptime('2020-01-02 +01:30:15', '%Y-%m-%d %z') => datetime.datetime(2020, 1, 2, 0, 0, tzinfo=datetime.timezone(datetime.timedelta(seconds=5415)))
datetime.strptime('2020-01-02 +01:30:15.123456', '%Y-%m-%d %z') => datetime.datetime(2020, 1, 2, 0, 0, tzinfo=datetime.timezone(datetime.timedelta(seconds=5415, microseconds=123456)))
datetime.strptime('2020-01-02 Z', '%Y-%m-%d %z') => datetime.datetime(2020, 1, 2, 0, 0, tzinfo=datetime.timezone.utc)
datetime.strptime('2020-01-02 +00:00', '%Y-%m-%d %z') => datetime.datetime(2020, 1, 2, 0, 0, tzinfo=datetime.timezone.utc)
datetime.strptime('2020-01-02 +00:00', '%Y-%m-%d %z').tzinfo is utc => True
datetime.strptime('2020-01-02 UTC', '%Y-%m-%d %Z') => datetime.datetime(2020, 1, 2, 0, 0)
datetime.strptime('2020-01-02 GMT', '%Y-%m-%d %Z') => datetime.datetime(2020, 1, 2, 0, 0)
datetime.strptime('2020-01-02 UTC +0000', '%Y-%m-%d %Z %z') => datetime.datetime(2020, 1, 2, 0, 0, tzinfo=datetime.timezone(datetime.timedelta(0), 'UTC'))
datetime.strptime('2020-01-02 UTC +0100', '%Y-%m-%d %Z %z') => datetime.datetime(2020, 1, 2, 0, 0, tzinfo=datetime.timezone(datetime.timedelta(seconds=3600), 'UTC'))
datetime.strptime('2020-01-02 +01:00', '%Y-%m-%d %:z') => datetime.datetime(2020, 1, 2, 0, 0, tzinfo=datetime.timezone(datetime.timedelta(seconds=3600)))
datetime.strptime('Thu Feb 29 13:04:05 2024', '%c') => datetime.datetime(2024, 2, 29, 13, 4, 5)
datetime.strptime('Thu Feb 29 13:04:05 2024', '%a %b %d %H:%M:%S %Y') => datetime.datetime(2024, 2, 29, 13, 4, 5)
datetime.strptime('2024 60', '%Y %j') => datetime.datetime(2024, 2, 29, 0, 0)
datetime.strptime('2024 9 4', '%G %V %u') => datetime.datetime(2024, 2, 29, 0, 0)
datetime.strptime('24', '%y'), datetime.strptime('69', '%y'), datetime.strptime('68', '%y') => (datetime.datetime(2024, 1, 1, 0, 0), datetime.datetime(1969, 1, 1, 0, 0), datetime.datetime(2068, 1, 1, 0, 0))
datetime.strptime('12 AM', '%I %p'), datetime.strptime('12 PM', '%I %p') => (datetime.datetime(1900, 1, 1, 0, 0), datetime.datetime(1900, 1, 1, 12, 0))
datetime.strptime('', '') => datetime.datetime(1900, 1, 1, 0, 0)
datetime.strptime('%', '%%') => datetime.datetime(1900, 1, 1, 0, 0)
datetime.strptime('2020', '%Y').tzinfo => None
datetime.strptime('2020-13-01', '%Y-%m-%d') !! ValueError time data '2020-13-01' does not match format '%Y-%m-%d'
datetime.strptime('2020-02-30', '%Y-%m-%d') !! ValueError day 30 must be in range 1..29 for month 2 in year 2020
datetime.strptime('2020-01-02x', '%Y-%m-%d') !! ValueError unconverted data remains: x
datetime.strptime('x', '%Y') !! ValueError time data 'x' does not match format '%Y'
datetime.strptime('2020', '%Q') !! ValueError 'Q' is a bad directive in format '%Q'
datetime.strptime('2020', '%') !! ValueError stray % in format '%'
datetime.strptime('0000', '%Y') !! ValueError year must be in 1..9999, not 0
datetime.strptime('10000', '%Y') !! ValueError unconverted data remains: 0
datetime.strptime('2020-01-02 +2400', '%Y-%m-%d %z') !! ValueError offset must be a timedelta strictly between -timedelta(hours=24) and timedelta(hours=24), not datetime.timedelta(days=1)
datetime.strptime('2020-01-02 +0060', '%Y-%m-%d %z') !! ValueError unconverted data remains: +0060
datetime.strptime(1, '%Y') !! TypeError strptime() argument 1 must be str, not int
datetime.strptime('2020', 1) !! TypeError strptime() argument 2 must be str, not int
datetime.strptime(b'2020', '%Y') !! TypeError strptime() argument 1 must be str, not bytes
datetime.strptime('2020') !! TypeError strptime expected 2 arguments, got 1
datetime.strptime() !! TypeError strptime expected 2 arguments, got 0
datetime.strptime('2020', '%Y', 1) !! TypeError strptime expected 2 arguments, got 3
datetime.strptime(date_string='2020', format='%Y') !! TypeError datetime.strptime() takes no keyword arguments
date.strptime('2020-01-02', '%Y-%m-%d') => datetime.date(2020, 1, 2)
date.strptime('2020-01-02 03', '%Y-%m-%d %H') => datetime.date(2020, 1, 2)
date.strptime('03', '%H') => datetime.date(1900, 1, 1)
date.strptime('2020-02-30', '%Y-%m-%d') !! ValueError day 30 must be in range 1..29 for month 2 in year 2020
date.strptime('x', '%Y') !! ValueError time data 'x' does not match format '%Y'
date.strptime(1, '%Y') !! TypeError strptime() argument 1 must be str, not int
date.strptime('2020') !! TypeError strptime expected 2 arguments, got 1
date.strptime('2020-01-02 +0100', '%Y-%m-%d %z') => datetime.date(2020, 1, 2)
time.strptime('03:04:05.000006 +0100', '%H:%M:%S.%f %z') => datetime.time(3, 4, 5, 6, tzinfo=datetime.timezone(datetime.timedelta(seconds=3600)))
%Y-%m-%d %H:%M:%S.%f 2024-02-29 13:04:05.000006 datetime.datetime(2024, 2, 29, 13, 4, 5, 6)
%Y-%m-%dT%H:%M:%S.%f%z 2024-02-29T13:04:05.000006 datetime.datetime(2024, 2, 29, 13, 4, 5, 6)
%c Thu Feb 29 13:04:05 2024 datetime.datetime(2024, 2, 29, 13, 4, 5)
%x %X 02/29/24 13:04:05 datetime.datetime(2024, 2, 29, 13, 4, 5)
%d/%m/%y %I:%M:%S %p 29/02/24 01:04:05 PM datetime.datetime(2024, 2, 29, 13, 4, 5)
