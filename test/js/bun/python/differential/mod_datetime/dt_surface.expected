---
--- the module
sorted(n for n in dir(_datetime) if n != 'datetime_CAPI') => ['MAXYEAR', 'MINYEAR', 'UTC', '__doc__', '__loader__', '__name__', '__package__', '__spec__', 'date', 'datetime', 'time', 'timedelta', 'timezone', 'tzinfo']
sorted(datetime.__all__) => ['MAXYEAR', 'MINYEAR', 'UTC', 'date', 'datetime', 'time', 'timedelta', 'timezone', 'tzinfo']
_datetime.__name__, _datetime.__doc__ => ('_datetime', 'Fast implementation of the datetime module.')
datetime.date is _datetime.date, datetime.datetime is _datetime.datetime, datetime.time is _datetime.time, datetime.timedelta is _datetime.timedelta, datetime.tzinfo is _datetime.tzinfo, datetime.timezone is _datetime.timezone, datetime.UTC is _datetime.UTC => (True, True, True, True, True, True, True)
_datetime.MINYEAR, _datetime.MAXYEAR => (1, 9999)
'_pydatetime' in sys.modules => False
type(_datetime).__name__ => 'module'
