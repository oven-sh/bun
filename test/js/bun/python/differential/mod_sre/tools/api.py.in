print([x.span() for x in C(r'[^a-c]').finditer(s)], ascii(C(r'.').search(s, 4)), ascii(C(r'.*').match(s, 1, 4)), ascii(C(r'.*').fullmatch(s, 1, 100)), len(s))
print(ascii(C(r'(?s).*').match(s).group()) , C(r'(?s).*').match(s).group() == s)
print(ascii(C(r'(.)\1').search('ab\U0001f600\U0001f600c')), ascii(C(r'(?<=\U0001f600)c').search('ab\U0001f600c')), ascii(C(r'\b').sub('|', '\U0001f600ab \U00010400c')))

