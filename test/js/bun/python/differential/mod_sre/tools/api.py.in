# str and bytes subclasses, bytearray.
class Str(str): pass
class Bytes(bytes): pass
s = Str('axxb')
m = p.search(s)
print(m, type(m.string), m.string is s, type(m.group()), type(m[0]), type(p.sub('', s)), type(p.sub('q', Str('b'))), type(p.split(s)[0]), type(p.findall(s)[0]))
m = C(r'.*').match(s)
print(type(m.group()), m.group() is s, m.group() == s)
s2 = 'axxb'
print(C(r'.*').match(s2).group() is s2, C(r'q').sub('', s2) == s2, C(r'q').split(s2)[0] == s2)
b = Bytes(b'axxb')
m = pb.search(b)
print(m, type(m.string), type(m.group()), type(pb.sub(b'', b)), type(C(rb'.*').match(b).group()))
b2 = b'axxb'
print(C(rb'.*').match(b2).group() is b2)
ba = bytearray(b'axxb')
m = pb.search(ba)
print(m, type(m.string), m.string is ba, type(m.group()), m.group(), pb.sub(b'-', ba), type(pb.sub(b'-', ba)), pb.split(ba), pb.findall(ba), pb.sub(bytearray(b'-'), ba), pb.sub(bytearray(rb'[\1]'), ba) if False else None)
del ba[2:]
print(m.group(), m.span(), m.groups(), m)
ba.clear()
print(m.group(), m.span(), m.groups(), m)
ba = bytearray(b'axxbxx')
def shrink(m):
    try:
        ba.clear()
    except BufferError as e:
        return b'<BufferError>'
    return b'<cleared>'
print(pb.sub(shrink, ba), ba)
ba.clear()
print(ba)

