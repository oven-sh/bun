// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`what Vitest wrote 1`] = `
{
  "a": 1,
}
`;

exports[`what Vitest wrote 2`] = `
[
  "b",
  2,
]
`;

exports[`an own getter 1`] = `
{
  "bad": [native code],
  "ok": 1,
}
`;

exports[`a getter in a nested object 1`] = `
{
  "nested": [
    {
      "bad": [native code],
      "ok": 1,
    },
  ],
}
`;

exports[`with property matchers 1`] = `
{
  "bad": [native code],
  "ok": Any<Number>,
}
`;

exports[`with a hint: the hint 1`] = `
{
  "bad": [native code],
  "ok": 1,
}
`;

exports[`in a describe an own getter 1`] = `
{
  "bad": [native code],
  "ok": 1,
}
`;

exports[`two calls and one that prints 1`] = `
{
  "bad": [native code],
  "ok": 1,
}
`;

exports[`two calls and one that prints 2`] = `
{
  "bad": [native code],
  "ok": 1,
}
`;

exports[`two calls and one that prints 3`] = `"the third of the test"`;

exports[`a toJSON that throws 1`] = `
{
  "a": 1,
  "toJSON": [Function: toJSON],
}
`;

exports[`a constructor getter on the prototype 1`] = `
{
  "a": 1,
}
`;

exports[`a Map whose entries() throws 1`] = `
Map {
  "k" => 1,
}
`;

exports[`a thrown object 1`] = `undefined`;

exports[`a thrown error whose name getter throws 1`] = `"message"`;

exports[`a promise 1`] = `
{
  "bad": [native code],
  "ok": 1,
}
`;

exports[`a promise 2`] = `
{
  "bad": [native code],
  "ok": 1,
}
`;
