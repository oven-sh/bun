// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`promises > rejects 1`] = `[Error: as a value]`;

exports[`promises > resolves 1`] = `
{
  "r": 1,
}
`;

exports[`toThrowErrorMatchingSnapshot > Error 1`] = `[Error: plain message]`;

exports[`toThrowErrorMatchingSnapshot > TypeError 1`] = `[TypeError: type message]`;

exports[`toThrowErrorMatchingSnapshot > a thrown number 1`] = `5`;

exports[`toThrowErrorMatchingSnapshot > a thrown object 1`] = `
{
  "code": 1,
  "message": "object message",
}
`;

exports[`toThrowErrorMatchingSnapshot > a thrown string 1`] = `"just a string"`;

exports[`toThrowErrorMatchingSnapshot > a thrown undefined 1`] = `undefined`;

exports[`toThrowErrorMatchingSnapshot > async function rejects 1`] = `[RangeError: async message]`;

exports[`toThrowErrorMatchingSnapshot > custom error 1`] = `[CustomError: custom message]`;

exports[`toThrowErrorMatchingSnapshot > empty message 1`] = `[Error]`;

exports[`toThrowErrorMatchingSnapshot > mixed with toMatchSnapshot 1`] = `1`;

exports[`toThrowErrorMatchingSnapshot > mixed with toMatchSnapshot 2`] = `[Error: in between]`;

exports[`toThrowErrorMatchingSnapshot > mixed with toMatchSnapshot 3`] = `3`;

exports[`toThrowErrorMatchingSnapshot > multi-line message 1`] = `
[Error: first
second
  third]
`;

exports[`toThrowErrorMatchingSnapshot > odd characters 1`] = `[Error: a \`b\` \${c} \\d "e" 'f']`;

exports[`toThrowErrorMatchingSnapshot > rejects 1`] = `[Error: rejected message]`;

exports[`toThrowErrorMatchingSnapshot > twice 1`] = `[Error: one]`;

exports[`toThrowErrorMatchingSnapshot > twice 2`] = `[Error: two]`;

exports[`toThrowErrorMatchingSnapshot > with a cause 1`] = `[Error: outer]`;

exports[`toThrowErrorMatchingSnapshot > with a hint > the hint 1`] = `[Error: hinted]`;
