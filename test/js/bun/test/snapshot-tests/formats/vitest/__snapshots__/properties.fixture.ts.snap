exports[`closeTo() 1`] = `
{
  "d": NumberCloseTo 1 (2 digits),
  "e": NumberCloseTo 0 (1 digit),
}
`;

exports[`instances in an array 1`] = `
{
  "items": [
    {
      "a": Any<Number>,
    },
    {
      "a": Any<Number>,
    },
  ],
}
`;

exports[`instances in arrays in arrays 1`] = `
{
  "d": [
    [
      {
        "a": Any<Number>,
      },
    ],
  ],
}
`;

exports[`instances three levels down 1`] = `
{
  "a": {
    "b": {
      "c": {
        "d": Any<Number>,
      },
    },
  },
}
`;

exports[`its own toJSON() 1`] = `"json"`;

exports[`matchers for what is no object in an array 1`] = `
{
  "d": [
    Any<Number>,
    StringMatching /b/,
    StringContaining "b",
    NumberCloseTo 1 (2 digits),
    Anything,
  ],
}
`;

exports[`no properties 1`] = `
{
  "a": 1,
}
`;

exports[`no properties, inside 1`] = `
{
  "x": {
    "a": 1,
  },
}
`;

exports[`null 1`] = `
{
  "a": null,
  "b": 1,
}
`;

exports[`objectContaining() 1`] = `
{
  "x": ObjectContaining {
    "a": 1,
  },
}
`;

exports[`one object twice 1`] = `
{
  "x": {
    "a": Any<Number>,
  },
  "y": Foo {
    "a": 1,
  },
}
`;

exports[`part of the objects of an array 1`] = `
{
  "d": [
    {
      "a": Any<Number>,
      "b": 2,
    },
  ],
}
`;

exports[`stringMatching() of a RegExp 1`] = `
{
  "s": StringMatching /B/i,
}
`;

exports[`stringMatching() of a string 1`] = `
{
  "s": StringMatching /b/,
}
`;

exports[`stringMatching() of a string that a RegExp has to escape 1`] = `
{
  "s": StringMatching /a\\.b\\\\//,
}
`;

exports[`the toJSON() of its class 1`] = `
{
  "a": Any<Number>,
}
`;

exports[`the toJSON() of its class, inside 1`] = `
{
  "x": {
    "a": Any<Number>,
  },
}
`;
