  "y": Foo {
    "b": 1,
  },
}
`;

exports[`an instance under a numeric key 1`] = `
{
  "1": {
    "a": Any<Number>,
  },
}
`;

exports[`an object that holds itself 1`] = `
{
  "a": Any<Number>,
  "self": {
    "a": 1,
    "self": [Circular],
