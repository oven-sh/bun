}
`;

exports[`an object without a prototype 1`] = `
{
  "a": Any<Number>,
}
`;

exports[`any(Date), beside an Error 1`] = `
{
  "d": Any<Date>,
  "e": [Error: x],
}
`;

exports[`arrayContaining() 1`] = `
{
  "x": ArrayContaining [
    1,
